{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":["هَلِّلُويَا. سَبِّحُوا يَا عَبِيدَ الرَّبِّ، سَبِّحَوا اسْمَ الرَّبِّ."]},{"type":"verse","number":2,"content":["لِيَكُنِ اسْمُ الرَّبِّ مُبَارَكاً مِنَ الآنَ وَإِلَى الأَبَدِ."]},{"type":"verse","number":3,"content":["لِيُسَبَّحْ بِاسْمِ الرَّبِّ مِنْ مَشْرِقِ الشَّمْسِ إِلَى مَغْرِبِهَا."]},{"type":"verse","number":4,"content":["الرَّبُّ مُتَسَامٍ عَلَى جَمِيعِ الأُمَمِ، وَمَجْدُهُ فَوْقَ السَّمَاوَاتِ."]},{"type":"verse","number":5,"content":["مَنْ هُوَ نَظِيرُ الرَّبِّ إِلَهِنَا السَّاكِنِ فِي الأَعَالِي؟"]},{"type":"verse","number":6,"content":["الْمُطِلِّ مِنْ عَلْيَائِهِ إِلَى أَسْفَلَ لِيَرَى السَّمَاوَاتِ وَالأَرْضَ."]},{"type":"verse","number":7,"content":["يُنْهِضُ الْمِسْكِينَ مِنَ التُّرَابِ، وَيَرْفَعُ الْبَائِسَ مِنْ الْمَزْبَلَةِ،"]},{"type":"verse","number":8,"content":["لِيُجْلِسَهُ مَعَ أَشْرَافِ شَعْبِهِ."]},{"type":"verse","number":9,"content":["يَرْزُقُ العَاقِرَ أَوْلاداً. يَجْعَلُهَا أُمّاً سَعِيدَةً. هَلِّلُويَا."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}