{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":["عِنْدَ خُرُوجِ بَنِي إِسْرَائِيلَ مِنْ مِصْرَ، وَآلِ يَعْقُوبَ مِنْ بَيْنِ شَعْبٍ غَرِيبِ اللِّسَانِ."]},{"type":"verse","number":2,"content":["صَارَ يَهُوذَا هَيْكَلاً مُقَدَّساً لَهُ، وَإِسْرَائِيلُ مَقَرَّ سُلْطَانِهِ."]},{"type":"verse","number":3,"content":["رَأَى الْبَحْرُ الأَحْمَرُ ذَلِكَ فَهَرَبَ، وَتَرَاجَعَ نَهْرُ الأُرْدُنِّ إِلَى الْوَرَاءِ."]},{"type":"verse","number":4,"content":["قَفَزَتِ الْجِبَالُ كَأَنَّهَا كِبَاشٌ، وَالتِّلالُ كَأَنَّهَا حُمْلانٌ."]},{"type":"verse","number":5,"content":["مَالَكَ يَا بَحْرُ قَدْ هَرَبْتَ، وَيَا أُرْدُنُّ قَدْ رَجَعْتَ إِلَى الْوَرَاءِ؟"]},{"type":"verse","number":6,"content":["مَالَكِ يَا جِبَالُ تَقْفِزِينَ كَالْكِبَاشِ، وَيَا تِلالُ كَالْحُمْلانِ؟"]},{"type":"verse","number":7,"content":["تَزَلْزَلِي يَا أَرْضُ فِي حَضْرَةِ الرَّبِّ إِلَهِ يَعْقُوبَ."]},{"type":"verse","number":8,"content":["الَّذِي حَوَّلَ الصَّخْرَةَ إِلَى جَدَاوِلَ، وَالصَّوَّانَ إِلَى يَنَابِيعِ مِيَاهٍ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}