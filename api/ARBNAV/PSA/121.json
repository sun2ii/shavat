{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["تَرْنِيمَةُ الْمَصَاعِدِ"]},{"type":"verse","number":1,"content":["أَرْفَعُ عَيْنَيَّ إِلَى الْجِبَالِ. مِنْ أَيْنَ يَأْتِي عَوْنِي؟"]},{"type":"verse","number":2,"content":["يَأْتِي عَوْنِي مِنْ عِنْدِ الرَّبِّ، صَانِعِ السَّمَاوَاتِ وَالأَرْضِ."]},{"type":"verse","number":3,"content":["لَا يَدَعُ قَدَمَكَ تَزِلُّ. لَا يَنْعَسُ حَافِظُكَ."]},{"type":"verse","number":4,"content":["لَا يَنْعَسُ وَلَا يَنَامُ حَافِظُ إِسْرَائِيلَ."]},{"type":"verse","number":5,"content":["الرَّبُّ هُوَ حَافِظُكَ، الرَّبُّ سِتْرٌ لَكَ عَنْ يَمِينِكَ."]},{"type":"verse","number":6,"content":["لَنْ تَضْرِبَكَ الشَّمْسُ بِحَرِّهَا نَهَاراً وَلَا الْقَمَرُ بِنُورِهِ لَيْلاً."]},{"type":"verse","number":7,"content":["يَقِيكَ الرَّبُّ مِنْ كُلِّ شَرٍّ. يَقِي نَفْسَكَ."]},{"type":"verse","number":8,"content":["الرَّبُّ يَحْفَظُ ذِهَابَكَ وَإِيَابَكَ مِنَ الآنَ وَإِلَى الأَبَدِ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/121.json","thisC