,{"type":"verse","number":9,"content":["مِنْ أَجْلِ الرَّبِّ إِلَهِنَا أَلْتَمِسُ لَكِ خَيْراً."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}