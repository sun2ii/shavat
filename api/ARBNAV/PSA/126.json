{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["تَرْنِيمَةُ الْمَصَاعِدِ"]},{"type":"verse","number":1,"content":["عِنْدَمَا أَرْجَعَ الرَّبُّ أَهْلَ أُورُشَلِيمَ مِنَ السَّبْيِ، صِرْنَا كَمَنْ يَرَى حُلْماً."]},{"type":"verse","number":2,"content":["عِنْدَئِذٍ امْتَلأَتْ أَفْوَاهُنَا ضِحْكاً، وَأَلْسِنَتُنَا تَرَنُّماً. عِنْدَئِذٍ قَالَتِ الأُمَمُ: إِنَّ الرَّبَّ قَدْ أَجْرَى أُمُوراً عَظِيمَةً مَعَ هَؤُلاءِ."]},{"type":"verse","number":3,"content":["نَعَمْ، إِنَّ الرَّبَّ قَدْ صَنَعَ أُمُوراً عَظِيمَةً لَنَا، فَفَرِحْنَا."]},{"type":"verse","number":4,"content":["أَرْجِعْنَا يَا رَبُّ مِنْ سَبْيِنَا، كَمَا تَرْجِعُ السُّيُولُ إِلَى النَّقَبِ."]},{"type":"verse","number":5,"content":["فَمَنْ يَزْرَعْ بِالدُّمُوعِ يَحْصُدْ غَلّاتِهِ بِالابْتِهَاجِ."]},{"type":"verse","number":6,"content":["وَمَنْ يَذْهَبْ بَاكِياً حَامِلاً بِذَارَهُ يَرْجِعْ مُتَرَنِّماً حَامِلاً حُزَمَ حَصِيدِهِ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/126.json","thisChapterAudioLinks":