{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["تَرْنِيمَةُ الْمَصَاعِدِ لِسُلَيْمَانَ"]},{"type":"verse","number":1,"content":["إِنْ لَمْ يَبْنِ الرَّبُّ الْبَيْتَ، فَبَاطِلاً يَتْعَبُ الْبَنَّاؤُونَ. وَإِنْ لَمْ يَحْرُسِ الرَّبُّ الْمَدِينَةَ فَبَاطِلاً يَسْهَرُ الْحَارِسُ."]},{"type":"verse","number":2,"content":["بَاطِلاً تَكِدُّونَ مِنَ الْفَجْرِ الْمُبَكِّرِ وَإِلَى وَقْتٍ مُتَأَخِّرٍ مِنَ اللَّيْلِ فِي سَبِيلِ لُقْمَةِ الْعَيْشِ، فَإِنَّ الرَّبَّ يَسُدُّ حَاجَةَ أَحِبَّائِهِ حَتَّى وَهُمْ نِيَامٌ."]},{"type":"verse","number":3,"content":["هُوَذَا الْبَنُونَ مِيرَاثٌ مِنْ عِنْدِ الرَّبِّ، وَالأَوْلادُ ثَوَابٌ مِنْهُ."]},{"type":"verse","number":4,"content":["أَبْنَاءُ الشَّبِيبَةِ مِثْلُ سِهَامٍ فِي يَدِ جَبَّارٍ مُتَمَرِّسٍ."]},{"type":"verse","number":5,"content":["طُوبَى لِلَّذِي مَلأَ جُعْبَتَهُ مِنْهُمْ، فَإِنَّهُمْ لَا يَخِيبُونَ حِينَ يُوَاجِهُونَ الخُصُومَ فِي مَجْلِسِ القَضَاءِ عِنْدَ بَوَّابَةِ الْمَدِينَةِ."]}],"footnotes":[]},"thisChapterLink":"/api/A