{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["تَرْنِيمَةُ الْمَصَاعِدِ"]},{"type":"verse","number":1,"content":["مَا أَكْثَرَ مَا ضَايَقُونِي فِي حَدَاثَتِي يَقُولُ إِسْرَائِيلُ."]},{"type":"verse","number":2,"content":["مَا أَكْثَرَ مَا ضَايَقُونِي فِي حَدَاثَتِي، لَكِنَّهُمْ لَمْ يَتَغَلَّبُوا عَلَيَّ."]},{"type":"verse","number":3,"content":["جَرَحُوا ظَهْرِي جُرُوحاً عَمِيقَةً، فَصَارَ كَالأَتْلامِ (خُطُوطِ الْمِحْرَاثِ) الطَّوِيلَةِ فِي حَقْلٍ مَحْرُوثٍ."]},{"type":"verse","number":4,"content":["الرَّبُّ عَادِلٌ، كَسَرَ أَغْلالَ عُبُودِيَّةِ الأَشْرَارِ."]},{"type":"verse","number":5,"content":["فَلْيَخْزَ وَلْيُدْبِرْ جَمِيعُ مُبْغِضِي صِهْيَوْنَ."]},{"type":"verse","number":6,"content":["لِيَكُونُوا كَالْعُشْبِ النَّابِتِ عَلَى السُّطُوحِ، الَّذِي يَجِفُّ قَبْلَ أَنْ يَنْمُوَ،"]},{"type":"verse","number":7,"content":["فَلَا يَمْلأُ الْحَاصِدُ مِنْهُ يَدَهُ، وَلَا الْحَازِمُ حِضْنَهُ."]},{"type":"verse","number":8,"content":["وَلَا يَقُولُ عَابِرُو السَّبِيلِ لَهُمْ: «لِتَكُنْ عَلَيْكُمْ بَرَكَةُ الرَّبِّ: نُبَارِكُكُمْ بِاسْمِ الرَّبِّ»."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}