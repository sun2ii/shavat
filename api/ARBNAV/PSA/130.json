{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["تَرْنِيمَةُ الْمَصَاعِدِ"]},{"type":"verse","number":1,"content":["أَيُّهَا الرَّبُّ إِيَّاكَ أَدْعُو مِنَ الأَعْمَاقِ."]},{"type":"verse","number":2,"content":["فَاسْمَعْ يَا رَبُّ صَوْتِي، وَلْتَكُنْ أُذُنَاكَ مُرْهَفَتَيْنِ إِلَى صَوْتِ تَضَرُّعِي."]},{"type":"verse","number":3,"content":["إِنْ كُنْتَ يَا رَبُّ تَتَرَصَّدُ الآثَامَ، فَمَنْ يَسْتَطِيعُ الْوُقُوفَ فِي مَحْضَرِكَ؟"]},{"type":"verse","number":4,"content":["وَلأَنَّكَ مَصْدَرُ الْغُفْرَانِ فَإِنَّ جَمِيعَ النَّاسِ يَهَابُونَكَ."]},{"type":"verse","number":5,"content":["انْتَظَرْتُكَ يَا رَبُّ. نَفْسِي تَنْتَظِرُكَ، وَفِي كَلِمَتِكَ رَجَائِي."]},{"type":"verse","number":6,"content":["نَفْسِي تَنْتَظِرُ الرَّبَّ بِلَهْفَةٍ أَكْثَرَ مِنْ لَهْفَةِ الْحُرَّاسِ مُتَرَقِّبِي الصُّبْحِ."]},{"type":"verse","number":7,"content":["لِيَتَرَجَّ إِسْرَائِيلُ الرَّبَّ، لأَنَّ مِنْهُ الرَّحْمَةَ وَالْفِدَاءَ الْكَثِيرَ."]},{"type":"verse","number":8,"content":["وَهُوَ يَفْدِي إِسْرَائِيلَ مِنْ جَمِيعِ آثَامِهِ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}