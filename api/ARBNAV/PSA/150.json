{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":["هَلِّلُويَا! سَبِّحُوا اللهَ فِي هَيْكَلِهِ. سَبِّحُوهُ فِي السَّمَاءِ الَّتِي صَنَعَهَا بِقُدْرَتِهِ"]},{"type":"verse","number":2,"content":["سَبِّحُوهُ مِنْ أَجْلِ أَعْمَالِهِ الْمُقْتَدِرَةِ. سَبِّحُوهُ حَسَبَ عَظَمَتِهِ الفَائِقَةِ."]},{"type":"verse","number":3,"content":["سَبِّحُوهُ بِصَوْتِ بُوقٍ. سَبِّحُوهُ بِالرَّبَابِ وَالْعُودِ."]},{"type":"verse","number":4,"content":["سَبِّحُوهُ بِالدُّفِّ وَالرَّقْصِ. سَبِّحُوهُ بِأَوْتَارٍ وَمِزْمَارٍ."]},{"type":"verse","number":5,"content":["سَبِّحُوهُ عَلَى وَقْعِ الصُّنُوجِ. سَبِّحُوهُ بالصُّنُوجِ الْمُدَوِّيَّةِ."]},{"type":"verse","number":6,"content":["لِتُسَبِّحِ الرَّبَّ كُلُّ نَسَمَةٍ. هَلِّلُويَا."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}