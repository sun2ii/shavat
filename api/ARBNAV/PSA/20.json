{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["لِقَائِدِ الْمُنْشِدِينَ. مَزْمُورٌ لِدَاوُدَ"]},{"type":"verse","number":1,"content":["لِيَسْتَجِبْ لَكَ الرَّبُّ فِي يَوْمِ ضِيقِكَ. لِيَحْرُسْكَ اسْمُ إِلَهِ يَعْقُوبَ."]},{"type":"verse","number":2,"content":["لِيُرْسِلْ لَكَ عَوْناً مِنْ مَقْدِسِهِ، وَمُسَانَدَةً مِنْ صِهْيَوْنَ."]},{"type":"verse","number":3,"content":["لِيَتَذَكَّرْ جَمِيعَ تَقْدِمَاتِكَ، وَيَتَقَبَّلْ مُحْرَقَاتِكَ."]},{"type":"verse","number":4,"content":["لِيُعْطِكَ بُغْيَةَ قَلْبِكَ، وَيُتَمِّمْ لَكَ كُلَّ مَقَاصِدِكَ."]},{"type":"verse","number":5,"content":["نَهْتِفُ مُبْتَهِجِينَ بِخَلاصِكَ، وَبِاسْمِ إِلَهِنَا نَرْفَعُ رَايَتَنَا، لِيُحَقِّقْ لَكَ الرَّبُّ كُلَّ مَا تَسْأَلُهُ."]},{"type":"verse","number":6,"content":["الآنَ أَدْرَكْتُ أَنَّ الرَّبَّ يُخَلِّصُ مَسِيحَهُ، وَيَسْتَجِيبُ مِنْ سَمَاوَاتِهِ الْمُقَدَّسَةِ، بِقُدْرَةِ يَمِينِهِ الْمُخَلِّصَةِ."]},{"type":"verse","number":7,"content":["يَتَّكِلُ هَؤُلاءِ عَلَى مَرْكَبَاتِ الْحَرْبِ، وَأُولَئِكَ عَلَى الْخَيْلِ. أَمَّا نَحْنُ فَنَتَّكِلُ عَلَى اسْمِ الرَّبِّ إِلَهِنَا."]},{"type":"verse","number":8,"content":["هُمْ خَرُّوا وَسَقَطُوا، أَمَّا نَحْنُ فَنَهَضْنَا وَانْتَصَبْنَا."]},{"type":"verse","number":9,"content":["خَلِّصْ يَا رَبُّ! لِيَسْتَجِبِ الْمَلِكُ حِينَ نَدْعُوهُ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}