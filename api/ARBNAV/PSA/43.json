{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["يَا اللهُ احْكُمْ بِبَرَاءَتِي، وَدَافِعْ عَنْ قَضِيَّتِي ضِدَّ شَعْبٍ لَا يَرْحَمُ. أَنْقِذْنِي مِنَ الْغَشَّاشِ وَالظَّالِمِ."]},{"type":"verse","number":2,"content":["لأَنَّكَ أَنْتَ حِصْنِي. لِمَاذَا رَفَضْتَنِي؟ لِمَاذَا أَطُوفُ نَائِحاً مِنْ مُضَايَقَةِ الْعَدُوِّ؟"]},{"type":"verse","number":3,"content":["أَرْسِلْ نُورَكَ وَحَقَّكَ فَيُرْشِدَانِي، وَيَأْتِيَا بِي إِلَى جَبَلِكَ الْمُقَدَّسِ وَإِلَى مَسَاكِنِكَ،"]},{"type":"verse","number":4,"content":["فَأُقْبِلَ إِلَى مَذْبَحِ اللهِ، إِلَى اللهِ فَرَحِي وَأُسَبِّحُكَ بِالعُودِ يَا إِلَهِي."]},{"type":"verse","number":5,"content":["لِمَاذَا أَنْتِ مُكْتَئِبَةٌ يَا نَفْسِي؟ لِمَاذَا أَنْتِ قَلِقَةٌ فِي دَاخِلِي؟ تَرَجَّيِ اللهَ فَإِنِّي سَأَظَلُّ أَحْمَدُهُ، لأَنَّهُ عَوْنِي وَإِلَهِي."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/44.json","nextChapterAudioLinks":{},"previousChapterAp