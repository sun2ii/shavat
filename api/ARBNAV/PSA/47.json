{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["لِقَائِدِ الْمُنْشِدِينَ لِبَنِي قُورَحَ. مَزْمُورٌ"]},{"type":"verse","number":1,"content":["يَا جَمِيعَ الأُمَمِ صَفِّقُوا بِالأَيَادِي، وَاهْتِفُوا للهِ هُتَافَ الابْتِهَاجِ."]},{"type":"verse","number":2,"content":["لأَنَّ الرَّبَّ عَلِيٌّ مَخُوفٌ، مَلِكٌ عَظِيمٌ عَلَى كُلِّ الأَرْضِ."]},{"type":"verse","number":3,"content":["يُخْضِعُ الشُّعُوبَ لَنَا، وَيَطْرَحُ الأُمَمَ تَحْتَ أَقْدَامِنَا."]},{"type":"verse","number":4,"content":["يَخْتَارُ لَنَا مِيرَاثَنَا، فَخْرَ يَعْقُوبَ الَّذِي أَحَبَّهُ."]},{"type":"verse","number":5,"content":["ارْتَفَعَ اللهُ وَسَطَ الْهُتَافِ، ارْتَفَعَ الرَّبُّ وَسَطَ دَوِيِّ نَفْخِ الْبُوقِ."]},{"type":"verse","number":6,"content":["رَنِّمُوا لِلهِ، رَنِّمُوا. رَنِّمُوا لِمَلِكِنَا، رَنِّمُوا."]},{"type":"verse","number":7,"content":["لأَنَّ اللهَ هُوَ مَلِكُ الأَرْضِ كُلِّهَا. رَنِّمُوا لَهُ قَصِيدَةَ حَمْدٍ."]},{"type":"verse","number":8,"content":["مَلَكَ اللهُ عَلَى الأُمَمِ، اللهُ جَلَسَ عَلَى عَرْشِهِ الْمُقَدَّسِ."]},{"type":"verse","number":9,"content":["رُؤَسَاءُ الأُمَمِ اجْتَمَعُوا مَعَ شَعْبِ إِلَهِ إِبْرَاهِيمَ. لأَنَّ لِلهِ حُمَاةَ الأَرْضِ وَهُوَ مُتَعَالٍ جِدّاً."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}