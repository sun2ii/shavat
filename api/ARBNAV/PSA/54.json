{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["لِقَائِدِ الْمُنْشِدِينَ عَلَى الآلاتِ الْوَتَرِيَّةِ. مَزْمُورٌ تَعْلِيمِيٌّ لِدَاوُدَ عِنْدَمَا قَالَ أَهْلُ زِيفَ لِشَاوُلَ إِنَّ دَاوُدَ مُخْتَبِئٌ عِنْدَهُمْ"]},{"type":"verse","number":1,"content":["يَا اللهُ بِاسْمِكَ خَلِّصْنِي، وَبِقُوَّتِكَ أَنْصِفْنِي."]},{"type":"verse","number":2,"content":["يَا اللهُ اسْمَعْ صَلاتِي وَأَصْغِ إِلَى كَلامِي."]},{"type":"verse","number":3,"content":["لأَنَّ غُرَبَاءَ قَامُوا عَلَيَّ، وَعُتَاةً يَسْعَوْنَ إِلَى قَتْلِي، وَلَمْ يَجْعَلُوا اللهَ نُصْبَ أَعْيُنِهِمْ"]},{"type":"verse","number":4,"content":["هُوَذَا اللهُ مُعِينِي وَالسَّيِّدُ الرَّبُّ عَاضِدِي."]},{"type":"verse","number":5,"content":["يَرُدُّ الشَّرَّ عَلَى أَعْدَائِي، وَبِحَقِّ (عَدْلِكَ) اسْتَأْصِلْهُمْ."]},{"type":"verse","number":6,"content":["طَوْعاً أَذْبَحُ لَكَ، وَأَحْمَدُ اسْمَكَ يَا رَبُّ لأَنَّهُ طَيِّبٌ."]},{"type":"verse","number":7,"content":["فَإِنَّهُ نَجَّانِي مِنْ كُلِّ ضيِقٍ وَرَأَيْتُ بِعْيَنيَّ (مَا حَلَّ) بِأَعْدَائِي."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}