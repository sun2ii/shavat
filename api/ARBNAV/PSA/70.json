{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["لِقَائِدِ الْمُنْشِدِينَ مَزْمُورٌ لِدَاوُدَ. لِلتَّذْكِيرِ"]},{"type":"verse","number":1,"content":["هَلُمَّ أَنْقِذْنِي يَا رَبُّ، وَأَسْرِعْ إِلَى مَعُونَتِي."]},{"type":"verse","number":2,"content":["لِيَخْزَ وَيَخْجَلِ السَّاعُونَ إِلَى قَتْلِي. لِيَرْتَدَّ وَيَخْجَلِ السَّاعُونَ لأَذِيَّتِي."]},{"type":"verse","number":3,"content":["لِيَرْجِعِ السَّاخِرُونَ مِنِّي مُكَلَّلِينَ بِالْعَارِ."]},{"type":"verse","number":4,"content":["لِيَفْرَحْ وَيَبْتَهِجْ بِكَ جَمِيعُ طَالِبِيكَ. وَلْيَقُلْ دَائِماً مُحِبُّو خَلاصِكَ: لِيَتَعَظَّمِ الرَّبُّ."]},{"type":"verse","number":5,"content":["إِنَّمَا أَنَا مُتَضَايِقٌ وَمُحْتَاجٌ، فَأَسْرِعِ الْلَهُمَّ إِلَيَّ. أَنْتَ عَوْنِي وَمُنْقِذِي. يَا رَبُّ لَا تَتَبَاطَأْ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/69.json",