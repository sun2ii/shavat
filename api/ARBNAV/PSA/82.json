{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["مَزْمُورٌ لآسَافَ."]},{"type":"verse","number":1,"content":["اللهُ يَتَرَأَّسُ سَاحَةَ قَضَائِهِ، وَعَلَى القُضَاةِ يُصْدِرُ حُكْماً."]},{"type":"verse","number":2,"content":["حَتَّى مَتَى تَقْضُونَ بِالظُّلْمِ وَتَنْحَازُونَ إِلَى الأَشْرَارِ؟"]},{"type":"verse","number":3,"content":["احْكُمُوا لِلذَّلِيلِ وَالْيَتِيمِ. وَأَنْصِفُوا الْمِسْكِينَ وَالْبَائِسَ."]},{"type":"verse","number":4,"content":["أَنْقِذُوا الْمِسْكِينَ وَالْفَقِيرَ؛ أَنْقِذُوهُمَا مِنْ قَبْضَةِ الأَشْرَارِ."]},{"type":"verse","number":5,"content":["هُمْ مِنْ غَيْرِ مَعْرِفَةٍ وَفَهْمٍ، يَتَمَشَّوْنَ فِي الظُّلْمَةِ وَتَتَزَعْزَعُ أُسُسُ الأَرْضِ مِنْ كَثْرَةِ الْجَوْرِ."]},{"type":"verse","number":6,"content":["أَنَا قُلْتُ: «إِنَّكُمْ آلِهَةٌ، وَجَمِيعَكُمْ بَنُو الْعَلِيِّ."]},{"type":"verse","number":7,"content":["لَكِنَّكُمْ سَتَمُوتُونَ كَالْبَشَرِ، وَتَنْتَهِي حَيَاتُكُمْ مِثْلَ كُلِّ الرُّؤَسَاءِ»."]},{"type":"verse","number":8,"content":["قُمْ يَا اللهُ قُمْ. دِنِ الأَرْضَ، لأَنَّكَ أَنْتَ تَمْتَلِكُ الأُمَمَ بِأَسْرِهَا."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}