{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["مَزْمُورٌ لِبَنِي قُورَحَ. تَسْبِيحَةٌ"]},{"type":"verse","number":1,"content":["أَسَّسَ اللهُ الْمَدِينَةَ عَلَى الْجِبَالِ الْمُقَدَّسَةِ."]},{"type":"verse","number":2,"content":["أَحَبَّ الرَّبُّ أَبْوَابَ صِهْيَوْنَ أَكْثَرَ مِنْ جَمِيعِ مَسَاكِنِ بَنِي يَعْقُوبَ."]},{"type":"verse","number":3,"content":["يَتَحَدَّثُونَ عَنْكِ بِأُمُورٍ مَجِيدَةٍ يَا مَدِينَةَ اللهِ."]},{"type":"verse","number":4,"content":["أَذْكُرُ مِصْرَ وَبَابِلَ بَيْنَ الَّذِينَ يَعْرِفُونَنِي، وَكَذَلِكَ فَلَسْطِينَ وَصُورَ مَعَ الْحَبَشَةِ، فَيَقُولُونَ: هَذَا وُلِدَ فِي صِهْيَوْنَ."]},{"type":"verse","number":5,"content":["حَقّاً عَنْ صِهْيَوْنَ يَقُولُونَ: «هَذَا الإِنْسَانُ وَهَذَا الإِنْسَانُ وُلِدَ فِيهَا، وَالْعَلِيُّ يُثَبِّتُهَا»."]},{"type":"verse","number":6,"content":["يُدَوِّنُ الرَّبُّ فِي سِجِلِّ إِحْصَاءِ الشُّعُوبِ أَنَّ هَذَا وُلِدَ هُنَاكَ."]},{"type":"verse","number":7,"content":["الْمُرَنِّمُونَ وَالْعَازِفُونَ عَلَى السَّوَاءِ يَقُولُونَ: «فِيكِ كُلُّ يَنَابِيعِ سُرُورِي»."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}