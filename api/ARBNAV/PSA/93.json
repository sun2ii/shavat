{"translation":{"id":"ARBNAV","name":"كتاب الحياة","website":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arbnav","licenseNotes":null,"shortName":"NAV","englishName":"New Arabic Version (Book of Life)","language":"arb","textDirection":"rtl","sha256":"358c9461549f8d09c7989b99e4606ae4ccf2cf8e4b22826e926e8ba3fce73fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/ARBNAV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"ARBNAV","name":"المزامير","commonName":"المَزامِير","title":"كِتَابُ الْمَزَامِيرِ","order":19,"numberOfChapters":150,"sha256":"bb99a54a86de9a349baf4419662cec524d3569bab5eac39eb63507a8be44940f","firstChapterNumber":1,"firstChapterApiLink":"/api/ARBNAV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ARBNAV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["الرَّبُّ قَدْ مَلَكَ مُرْتَدِياً الْجَلالَ. مُتَنَطِّقاً بِحِزَامِ الْقُوَّةِ. الأَرْضُ تَثَبَّتَتْ فَلَنْ تَتَزَعْزَعَ."]},{"type":"verse","number":2,"content":["عَرْشُكَ ثَابِتٌ مُنْذُ الْقَدِيمِ، لأَنَّكَ اللهُ مُنْذُ الأَزَلِ."]},{"type":"verse","number":3,"content":["يَا رَبُّ قَدْ رَفَعَتِ الأَنْهَارُ صَوْتَهَا. تَرْفَعُ الأَنْهَارُ صَوْتَ مَوْجِهَا الْهَادِرِ."]},{"type":"verse","number":4,"content":["الرَّبُّ فِي الْعَلاءِ أَعْظَمُ مِنْ صَوْتِ الْمِيَاهِ الْغَزِيرَةِ وَمِنْ أَمْوَاجِ الْبَحْرِ الْهَائِلَةِ."]},{"type":"verse","number":5,"content":["أَقْوَالُكَ ثَابِتَةٌ إِلَى الأَبَدِ، وَبِبَيْتِكَ أَيُّهَا الرَّبُّ تَلِيقُ الْقَدَاسَةُ مَدَى الدَّهْرِ."]}],"footnotes":[]},"thisChapterLink":"/api/ARBNAV/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ARBNAV/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ARBNAV/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5