{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"The LORD says to my Lord, “Sit at my right hand,","poem":1},{"text":"until I make your enemies your footstool for your feet.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD will send out the rod of your strength out of Zion.","poem":1},{"text":"Rule among your enemies.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Your people offer themselves willingly in the day of your power, in holy array.","poem":1},{"text":"Out of the womb of the morning, you have the dew of your youth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The LORD has sworn, and will not change his mind:","poem":1},{"text":"“You are a priest forever in the order of Melchizedek.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The Lord is at your right hand.","poem":1},{"text":"He will crush kings in the day of his wrath.","poem":2}]},{"type":"v