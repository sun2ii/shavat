{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign language,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah became his sanctuary,","poem":1},{"text":"Israel his dominion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled.","poem":1},{"text":"The Jordan was driven back.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains skipped like rams,","poem":1},{"text":"the little hills like lambs.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"What was it, you sea, that you fled?","poem":1},{"text":"You Jordan, that you turned back?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You mountains, that you skipped like rams?","poem":1},{"text":"You little hills, like lambs?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}