{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"In my distress, I cried to the LORD.","poem":1},{"text":"He answered me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deliver my soul, LORD, from lying lips,","poem":1},{"text":"from a deceitful tongue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"What will be given to you, and what will be done more to you,","poem":1},{"text":"you deceitful tongue?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sharp arrows of the mighty,","poem":1},{"text":"with coals of juniper.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woe is me, that I live in Meshech,","poem":1},{"text":"that I dwell among the tents of Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul has had her dwelling too long","poem":1},{"text":"with him who hates peace.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I am for peace,","poem":1},{"text":"but when I speak, they are for war.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}