{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By David."]},{"type":"verse","number":1,"content":[{"text":"I was glad when they said to me,","poem":1},{"text":"“Let’s go to the LORD’s house!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Our feet are standing within your gates, Jerusalem!","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Jerusalem is built as a city that is compact together,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"where the tribes go up, even the LORD’s tribes,","poem":1},{"text":"according to an ordinance for Israel,","poem":2},{"lineBreak":true},{"text":"to give thanks to the LORD’s name.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For there are set thrones for judgment,","poem":1},{"text":"the thrones of David’s house.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pray for the peace of Jerusalem.","poem":1},{"text":"Those who love you will prosper.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peace be within your walls,","poem":1},{"text":"and prosperity within your palaces.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For my brothers’ and companions’ sakes,","poem":1},{"text":"I will now say, “Peace be within you.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For the sake of the house of the LORD our God,","poem":1},{"text":"I will seek your good.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}