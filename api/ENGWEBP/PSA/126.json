{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"When the LORD brought back those who returned to Zion,","poem":1},{"text":"we were like those who dream.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Then our mouth was filled with laughter,","poem":1},{"text":"and our tongue with singing.","poem":2},{"text":"Then they said among the nations,","poem":1},{"text":"“The LORD has done great things for them.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The LORD has done great things for us,","poem":1},{"text":"and we are glad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Restore our fortunes again, LORD,","poem":1},{"text":"like the streams in the Negev.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Those who sow in tears will reap in joy.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"He who goes out weeping, carrying seed for sowing,","poem":2},{"lineBreak":true},{"text":"will certainly come again with joy, carrying his sheaves.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}