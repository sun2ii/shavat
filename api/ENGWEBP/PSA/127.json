{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents. By Solomon."]},{"type":"verse","number":1,"content":[{"text":"Unless the LORD builds the house,","poem":1},{"text":"they who build it labor in vain.","poem":2},{"text":"Unless the LORD watches over the city,","poem":1},{"text":"the watchman guards it in vain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It is vain for you to rise up early,","poem":1},{"text":"to stay up late,","poem":2},{"lineBreak":true},{"text":"eating the bread of toil,","poem":2},{"lineBreak":true},{"text":"for he gives sleep to his loved ones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Behold, children are a heritage of the LORD.","poem":1},{"text":"The fruit of the womb is his reward.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"As arrows in the hand of a mighty man,","poem":1},{"text":"so are the children of youth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Happy is the man who has his quiver full of them.","poem":1},{"text":"They won’t be disappointed when they speak with their enemies in the gate.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}