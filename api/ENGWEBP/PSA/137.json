{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down.","poem":1},{"text":"Yes, we wept, when we remembered Zion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"On the willows in that land,","poem":1},{"text":"we hung up our harps.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For there, those who led us captive asked us for songs.","poem":1},{"text":"Those who tormented us demanded songs of joy:","poem":2},{"lineBreak":true},{"text":"“Sing us one of the songs of Zion!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"How can we sing the LORD’s song in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, Jerusalem,","poem":1},{"text":"let my right hand forget its skill.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let my tongue stick to the roof of my mouth if I don’t remember you,","poem":1},{"text":"if I don’t prefer Jerusalem above my chief joy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Remember, LORD, against the children of Edom in the day of Jerusalem,","poem":1},{"text":"who said, “Raze it!","poem":2},{"lineBreak":true},{"text":"Raze it even to its foundation!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daughter of Babylon, doomed to destruction,","poem":1},{"text":"he will be happy who repays you,","poem":2},{"lineBreak":true},{"text":"as you have done to us.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Happy shall he be,","poem":1},{"text":"who takes and dashes your little ones against the rock.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}