{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David."]},{"type":"verse","number":1,"content":[{"text":"The fool has said in his heart, “There is no God.”","poem":1},{"text":"They are corrupt.","poem":2},{"lineBreak":true},{"text":"They have done abominable deeds.","poem":2},{"lineBreak":true},{"text":"There is no one who does good.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD looked down from heaven on the children of men,","poem":1},{"text":"to see if there were any who understood,","poem":2},{"lineBreak":true},{"text":"who sought after God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"They have all gone aside.","poem":1},{"text":"They have together become corrupt.","poem":2},{"lineBreak":true},{"text":"There is no one who does good, no, not one.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Have all the workers of iniquity no knowledge,","poem":1},{"text":"who eat up my people as they eat bread,","poem":2},{"lineBreak":true},{"text":"and don’t call on the LORD?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"There they were in great fear,","poem":1},{"text":"for God is in the generation of the righteous.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You frustrate the plan of the poor,","poem":1},{"text":"because the LORD is his refuge.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oh that the salvation of Israel would come out of Zion!","poem":1},{"text":"When the LORD restores the fortunes of his people,","poem":2},{"lineBreak":true},{"text":"then Jacob shall rejoice, and Israel shall be glad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}