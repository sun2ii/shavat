{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"The LORD is my shepherd;","poem":1},{"text":"I shall lack nothing.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He makes me lie down in green pastures.","poem":1},{"text":"He leads me beside still waters.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He restores my soul.","poem":1},{"text":"He guides me in the paths of righteousness for his name’s sake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Even though I walk through the valley of the shadow of death,","poem":1},{"text":"I will fear no evil, for you are with me.","poem":2},{"text":"Your rod and your staff,","poem":1},{"text":"they comfort me.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"You prepare a table before me","poem":1},{"text":"in the presence of my enemies.","poem":2},{"text":"You anoint my head with oil.","poem":1},{"text":"My cup runs over.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Surely goodness and loving kindness shall follow me all the days of my life,","poem":1},{"text":"and I will dwell in the LORD’s house forever.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}