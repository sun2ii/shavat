{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he fled from Absalom his son."]},{"type":"verse","number":1,"content":[{"text":"LORD, how my adversaries have increased!","poem":1},{"text":"Many are those who rise up against me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Many there are who say of my soul,","poem":1},{"text":"“There is no help for him in God.”","poem":2},{"noteId":4},{"text":"Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But you, LORD, are a shield around me,","poem":1},{"text":"my glory, and the one who lifts up my head.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I cry to the LORD with my voice,","poem":1},{"text":"and he answers me out of his holy hill. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I laid myself down and slept.","poem":1},{"text":"I awakened, for the LORD sustains me.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will not be afraid of tens of thousands of people","poem":1},{"text":"who have set themselves against me on every side.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arise, LORD!","poem":1},{"text":"Save me, my God!","poem":2},{"text":"For you have struck all of my enemies on the cheek bone.","poem":1},{"text":"You have broken the teeth of the wicked.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Salvation belongs to the LORD.","poem":1},{"text":"May your blessing be on your people. Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"The Hebrew word rendered “God” is “אֱלֹהִ֑ים” (Elohim).","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/ENGWEBP/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}