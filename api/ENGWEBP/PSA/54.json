{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. On stringed instruments. A contemplation by David, when the Ziphites came and said to Saul, “Isn’t David hiding himself among us?”"]},{"type":"verse","number":1,"content":[{"text":"Save me, God, by your name.","poem":1},{"text":"Vindicate me in your might.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear my prayer, God.","poem":1},{"text":"Listen to the words of my mouth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For strangers have risen up against me.","poem":1},{"text":"Violent men have sought after my soul.","poem":2},{"lineBreak":true},{"text":"They haven’t set God before them. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Behold, God is my helper.","poem":1},{"text":"The Lord is the one who sustains my soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He will repay the evil to my enemies.","poem":1},{"text":"Destroy them in your truth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With a free will offering, I will sacrifice to you.","poem":1},{"text":"I will give thanks to your name, LORD, for it is good.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For he has delivered me out of all trouble.","poem":1},{"text":"My eye has seen triumph over my enemies.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}