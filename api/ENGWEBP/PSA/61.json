{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. For a stringed instrument. By David."]},{"type":"verse","number":1,"content":[{"text":"Hear my cry, God.","poem":1},{"text":"Listen to my prayer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"From the end of the earth, I will call to you when my heart is overwhelmed.","poem":1},{"text":"Lead me to the rock that is higher than I.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For you have been a refuge for me,","poem":1},{"text":"a strong tower from the enemy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will dwell in your tent forever.","poem":1},{"text":"I will take refuge in the shelter of your wings. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For you, God, have heard my vows.","poem":1},{"text":"You have given me the heritage of those who fear your name.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You will prolong the king’s life.","poem":1},{"text":"His years will be for generations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shall be enthroned in God’s presence forever.","poem":1},{"text":"Appoint your loving kindness and truth, that they may preserve him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So I will sing praise to your name forever,","poem":1},{"text":"that I may fulfill my vows daily.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}