{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. By David. A reminder."]},{"type":"verse","number":1,"content":[{"text":"Hurry, God, to deliver me.","poem":1},{"text":"Come quickly to help me, LORD.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Let them be disappointed and confounded who seek my soul.","poem":1},{"text":"Let those who desire my ruin be turned back in disgrace.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Let them be turned because of their shame","poem":1},{"text":"who say, “Aha! Aha!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Let all those who seek you rejoice and be glad in you.","poem":1},{"text":"Let those who love your salvation continually say,","poem":2},{"lineBreak":true},{"text":"“Let God be exalted!”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"But I am poor and needy.","poem":1},{"text":"Come to me quickly, God.","poem":2},{"text":"You are my help and my deliverer.","poem":