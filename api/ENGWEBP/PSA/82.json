{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["A Psalm by Asaph."]},{"type":"verse","number":1,"content":[{"text":"God presides in the great assembly.","poem":1},{"text":"He judges among the gods.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“How long will you judge unjustly,","poem":1},{"text":"and show partiality to the wicked?” Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Defend the weak, the poor, and the fatherless.","poem":1},{"text":"Maintain the rights of the poor and oppressed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rescue the weak and needy.","poem":1},{"text":"Deliver them out of the hand of the wicked.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They don’t know, neither do they understand.","poem":1},{"text":"They walk back and forth in darkness.","poem":2},{"lineBreak":true},{"text":"All the foundations of the earth are shaken.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I said, “You are gods,","poem":1},{"text":"all of you are sons of the Most High.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nevertheless you shall die like men,","poem":1},{"text":"and fall like one of the rulers.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Arise, God, judge the earth,","poem":1},{"text":"for you inherit all of the nations.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}