{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["A Psalm by the sons of Korah; a Song."]},{"type":"verse","number":1,"content":[{"text":"His foundation is in the holy mountains.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"The LORD loves the gates of Zion more than all the dwellings of Jacob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Glorious things are spoken about you, city of God. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I will record Rahab","poem":1},{"noteId":33},{"text":"and Babylon among those who acknowledge me.","poem":1},{"text":"Behold, Philistia, Tyre, and also Ethiopia:","poem":2},{"lineBreak":true},{"text":"“This one was born there.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yes, of Zion it will be said, “This one and that one was born in her;”","poem":1},{"text":"the Most High himself will establish her.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The LORD will count, when he writes up the peoples,","poem":1},{"text":"“This one was born there.” Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Those who sing as well as those who dance say,","poem":1},{"text":"“All my springs are in you.”","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Rahab is a reference to Egypt.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/ENGWEBP/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}