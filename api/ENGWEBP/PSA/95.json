{"translation":{"id":"ENGWEBP","name":"World English Bible","website":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=engwebp","licenseNotes":null,"shortName":"WEB","englishName":"World English Bible","language":"eng","textDirection":"ltr","sha256":"eb5cd248facff676806b0b282f740d9bcec48e6e2ce52a82cd98a5e26fa84644","availableFormats":["json"],"listOfBooksApiLink":"/api/ENGWEBP/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PSA","translationId":"ENGWEBP","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"20c03f5dfc96f475816ad9a4c9a67c1b1a077b497f4e944a2e2943b0fa0164cf","firstChapterNumber":1,"firstChapterApiLink":"/api/ENGWEBP/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ENGWEBP/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Oh come, let’s sing to the LORD.","poem":1},{"text":"Let’s shout aloud to the rock of our salvation!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Let’s come before his presence with thanksgiving.","poem":1},{"text":"Let’s extol him with songs!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For the LORD is a great God,","poem":1},{"text":"a great King above all gods.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"In his hand are the deep places of the earth.","poem":1},{"text":"The heights of the mountains are also his.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The sea is his, and he made it.","poem":1},{"text":"His hands formed the dry land.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oh come, let’s worship and bow down.","poem":1},{"text":"Let’s kneel before the LORD, our Maker,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"for he is our God.","poem":2},{"text":"We are the people of his pasture,","poem":1},{"text":"and the sheep in his care.","poem":2},{"text":"Today, oh that you would hear his voice!","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Don’t harden your heart, as at Meribah,","poem":2},{"lineBreak":true},{"text":"as in the day of Massah in the wilderness,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"when your fathers tempted me,","poem":1},{"text":"tested me, and saw my work.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Forty long years I was grieved with that generation,","poem":1},{"text":"and said, “They are a people who err in their heart.","poem":2},{"lineBreak":true},{"text":"They have not known my ways.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Therefore I swore in my wrath,","poem":1},{"text":"“They won’t enter into my rest.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ENGWEBP/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ENGWEBP/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ENGWEBP/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}