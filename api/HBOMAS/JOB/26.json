pe":"verse","number":11,"content":["עַמּוּדֵ֣י שָׁמַ֣יִם יְרֹופָ֑פוּ וְ֝יִתְמְה֗וּ מִגַּעֲרָתֹֽו׃"]},{"type":"verse","number":12,"content":["בְּ֭כֹחֹו רָגַ֣ע הַיָּ֑ם *וּבִתוּבְנָתֹו (וּ֝בִתְבוּנָתֹ֗ו) מָ֣חַץ רָֽהַב׃"]},{"type":"verse","number":13,"content":["בְּ֭רוּחֹו שָׁמַ֣יִם שִׁפְרָ֑ה חֹֽלֲלָ֥ה יָ֝דֹ֗ו נָחָ֥שׁ בָּרִֽיחַ׃"]},{"type":"verse","number":14,"content":["הֶן־אֵ֤לֶּה ׀ קְצֹ֬ות *דַּרְכֹּו (דְּרָכָ֗יו) וּמַה־שֵּׁ֣מֶץ דָּ֭בָר נִשְׁמַע־בֹּ֑ו וְרַ֥עַם *גְּבוּרָתֹו (גְּ֝בוּרֹותָ֗יו) מִ֣י יִתְבֹּונָֽן׃ ס"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}