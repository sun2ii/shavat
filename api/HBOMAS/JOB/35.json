תֵ֖ן זְמִרֹ֣ות בַּלָּֽיְלָה׃"]},{"type":"verse","number":11,"content":["מַ֭לְּפֵנוּ מִבַּהֲמֹ֣ות אָ֑רֶץ וּמֵעֹ֖וף הַשָּׁמַ֣יִם יְחַכְּמֵֽנוּ׃"]},{"type":"verse","number":12,"content":["שָׁ֣ם יִ֭צְעֲקוּ וְלֹ֣א יַעֲנֶ֑ה מִ֝פְּנֵ֗י גְּאֹ֣ון רָעִֽים׃"]},{"type":"verse","number":13,"content":["אַךְ־שָׁ֭וְא לֹא־יִשְׁמַ֥ע ׀ אֵ֑ל וְ֝שַׁדַּ֗י לֹ֣א יְשׁוּרֶֽנָּה׃"]},{"type":"verse","number":14,"content":["אַ֣ף כִּֽי־תֹ֖אמַר לֹ֣א תְשׁוּרֶ֑נּוּ דִּ֥ין לְ֝פָנָ֗יו וּתְחֹ֥ולֵֽל לֹֽו׃"]},{"type":"verse","number":15,"content":["וְעַתָּ֗ה כִּי־אַ֭יִן פָּקַ֣ד אַפֹּ֑ו וְלֹֽא־יָדַ֖ע בַּפַּ֣שׁ מְאֹֽד׃"]},{"type":"verse","number":16,"content":["וְ֭אִיֹּוב הֶ֣בֶל יִפְצֶה־פִּ֑יהוּ בִּבְלִי־דַ֝֗עַת מִלִּ֥ין יַכְבִּֽר׃ פ"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}