ּר דָּוִ֣ד עַבְדֶּ֑ךָ אַל־תָּ֝שֵׁ֗ב פְּנֵ֣י מְשִׁיחֶֽךָ׃"]},{"type":"verse","number":11,"content":["נִשְׁבַּֽע־יְהוָ֨ה ׀ לְדָוִ֡ד אֱמֶת֮ לֹֽא־יָשׁ֪וּב מִ֫מֶּ֥נָּה מִפְּרִ֥י בִטְנְךָ֑ אָ֝שִׁ֗ית לְכִסֵּא־לָֽךְ׃"]},{"type":"verse","number":12,"content":["אִֽם־יִשְׁמְר֬וּ בָנֶ֨יךָ ׀ בְּרִיתִי֮ וְעֵדֹתִ֥י זֹ֗ו אֲלַ֫מְּדֵ֥ם גַּם־בְּנֵיהֶ֥ם עֲדֵי־עַ֑ד יֵ֝שְׁב֗וּ לְכִסֵּא־לָֽךְ׃"]},{"type":"verse","number":13,"content":["כִּֽי־בָחַ֣ר יְהוָ֣ה בְּצִיֹּ֑ון אִ֝וָּ֗הּ לְמֹושָׁ֥ב לֹֽו׃"]},{"type":"verse","number":14,"content":["זֹאת־מְנוּחָתִ֥י עֲדֵי־עַ֑ד פֹּֽה־אֵ֝שֵׁ֗ב כִּ֣י אִוִּתִֽיהָ׃"]},{"type":"verse","number":15,"content":["צֵ֭ידָהּ בָּרֵ֣ךְ אֲבָרֵ֑ךְ אֶ֝בְיֹונֶ֗יהָ אַשְׂבִּ֥יעַֽ לָֽחֶם׃"]},{"type":"verse","number":16,"content":["וְֽ֭כֹהֲנֶיהָ אַלְבִּ֣ישׁ יֶ֑שַׁע וַ֝חֲסִידֶ֗יהָ רַנֵּ֥ן יְרַנֵּֽנוּ׃"]},{"type":"verse","number":17,"content":["שָׁ֤ם אַצְמִ֣יחַ קֶ֣רֶן לְדָוִ֑ד עָרַ֥כְתִּי נֵ֝֗ר לִמְשִׁיחִֽי׃"]},{"type":"verse","number":18,"content":["אֹ֭ויְבָיו אַלְבִּ֣ישׁ בֹּ֑שֶׁת וְ֝עָלָ֗יו יָצִ֥יץ נִזְרֹֽו׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}