erse","number":9,"content":["שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם וּ֭שְׂאוּ פִּתְחֵ֣י עֹולָ֑ם וְ֝יָבֹא מֶ֣לֶךְ הַכָּבֹֽוד׃"]},{"type":"verse","number":10,"content":["מִ֤י ה֣וּא זֶה֮ מֶ֤לֶךְ הַכָּ֫בֹ֥וד יְהוָ֥ה צְבָאֹ֑ות ה֤וּא מֶ֖לֶךְ הַכָּבֹ֣וד סֶֽלָה׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}