ֻן מִדֶּ֣שֶׁן בֵּיתֶ֑ךָ וְנַ֖חַל עֲדָנֶ֣יךָ תַשְׁקֵֽם׃"]},{"type":"verse","number":10,"content":["כִּֽי־עִ֭מְּךָ מְקֹ֣ור חַיִּ֑ים בְּ֝אֹורְךָ֗ נִרְאֶה־אֹֽור׃"]},{"type":"verse","number":11,"content":["מְשֹׁ֣ךְ חַ֭סְדְּךָ לְיֹדְעֶ֑יךָ וְ֝צִדְקָֽתְךָ֗ לְיִשְׁרֵי־לֵֽב׃"]},{"type":"verse","number":12,"content":["אַל־תְּ֭בֹואֵנִי רֶ֣גֶל גַּאֲוָ֑ה וְיַד־רְ֝שָׁעִ֗ים אַל־תְּנִדֵֽנִי׃"]},{"type":"verse","number":13,"content":["שָׁ֣ם נָ֭פְלוּ פֹּ֣עֲלֵי אָ֑וֶן דֹּ֝ח֗וּ וְלֹא־יָ֥כְלוּ קֽוּם׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}