erse","number":10,"content":["דִּמִּ֣ינוּ אֱלֹהִ֣ים חַסְדֶּ֑ךָ בְּ֝קֶ֗רֶב הֵיכָלֶֽךָ׃"]},{"type":"verse","number":11,"content":["כְּשִׁמְךָ֤ אֱלֹהִ֗ים כֵּ֣ן תְּ֭הִלָּתְךָ עַל־קַצְוֵי־אֶ֑רֶץ צֶ֝֗דֶק מָלְאָ֥ה יְמִינֶֽךָ׃"]},{"type":"verse","number":12,"content":["יִשְׂמַ֤ח ׀ הַר־צִיֹּ֗ון תָּ֭גֵלְנָה בְּנֹ֣ות יְהוּדָ֑ה לְ֝מַ֗עַן מִשְׁפָּטֶֽיךָ׃"]},{"type":"verse","number":13,"content":["סֹ֣בּוּ צִ֭יֹּון וְהַקִּיפ֑וּהָ סִ֝פְר֗וּ מִגְדָּלֶֽיהָ׃"]},{"type":"verse","number":14,"content":["שִׁ֤יתוּ לִבְּכֶ֨ם ׀ לְֽחֵילָ֗ה פַּסְּג֥וּ אַרְמְנֹותֶ֑יהָ לְמַ֥עַן תְּ֝סַפְּר֗וּ לְדֹ֣ור אַחֲרֹֽון׃"]},{"type":"verse","number":15,"content":["כִּ֤י זֶ֨ה ׀ אֱלֹהִ֣ים אֱ֭לֹהֵינוּ עֹולָ֣ם וָעֶ֑ד ה֖וּא יְנַהֲגֵ֣נוּ עַל־מֽוּת׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}