ontent":["בְּקוּם־לַמִּשְׁפָּ֥ט אֱלֹהִ֑ים לְהֹושִׁ֖יעַ כָּל־עַנְוֵי־אֶ֣רֶץ סֶֽלָה׃"]},{"type":"verse","number":11,"content":["כִּֽי־חֲמַ֣ת אָדָ֣ם תֹּודֶ֑ךָּ שְׁאֵרִ֖ית חֵמֹ֣ת תַּחְגֹּֽר׃"]},{"type":"verse","number":12,"content":["נִֽדֲר֣וּ וְשַׁלְּמוּ֮ לַיהוָ֪ה אֱ‍ֽלֹהֵ֫יכֶ֥ם כָּל־סְבִיבָ֑יו יֹובִ֥ילוּ שַׁ֝֗י לַמֹּורָֽא׃"]},{"type":"verse","number":13,"content":["יִ֭בְצֹר ר֣וּחַ נְגִידִ֑ים נֹ֝ורָ֗א לְמַלְכֵי־אָֽרֶץ׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}