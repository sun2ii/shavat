{"translation":{"id":"HBOMAS","name":"כתבי הקודש","website":"https://ebible.org/Scriptures/details.php?id=hbo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hbo","licenseNotes":null,"shortName":"MAS","englishName":"Hebrew Masoretic OT","language":"hbo","textDirection":"rtl","sha256":"9d7008af21feb26c03504e2fa5cd931115c48802eefedaec2db488a63aeda613","availableFormats":["json"],"listOfBooksApiLink":"/api/HBOMAS/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"Ancient Hebrew","languageEnglishName":"Ancient Hebrew"},"book":{"id":"PSA","translationId":"HBOMAS","name":"תְּהִלִּים","commonName":"תְּהִלִּים","title":"תְּהִלִּים","order":19,"numberOfChapters":150,"sha256":"854f003cd7b199779288026f66772c39b6e5b7c3b3c85e3d081f4945510d7974","firstChapterNumber":1,"firstChapterApiLink":"/api/HBOMAS/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HBOMAS/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":["שִׁ֖יר מִזְמֹ֣ור לְאָסָֽף׃"]},{"type":"verse","number":2,"content":["אֱלֹהִ֥ים אַל־דֳּמִי־לָ֑ךְ אַל־תֶּחֱרַ֖שׁ וְאַל־תִּשְׁקֹ֣ט אֵֽל׃"]},{"type":"verse","number":3,"content":["כִּֽי־הִנֵּ֣ה אֹ֭ויְבֶיךָ יֶהֱמָי֑וּן וּ֝מְשַׂנְאֶ֗יךָ נָ֣שְׂאוּ רֹֽאשׁ׃"]},{"type":"verse","number":4,"content":["עַֽל־עַ֭מְּךָ יַעֲרִ֣ימוּ סֹ֑וד וְ֝יִתְיָעֲצ֗וּ עַל־צְפוּנֶֽיךָ׃"]},{"type":"verse","number":5,"content":["אָמְר֗וּ לְ֭כוּ וְנַכְחִידֵ֣ם מִגֹּ֑וי וְלֹֽא־יִזָּכֵ֖ר שֵֽׁם־יִשְׂרָאֵ֣ל עֹֽוד׃"]},{"type":"verse","number":6,"content":["כִּ֤י נֹועֲצ֣וּ לֵ֣ב יַחְדָּ֑ו עָ֝לֶ֗יךָ בְּרִ֣ית יִכְרֹֽתוּ׃"]},{"type":"verse","number":7,"content":["אָהֳלֵ֣י אֱ֭דֹום וְיִשְׁמְעֵאלִ֗ים מֹואָ֥ב וְהַגְרֽ͏ִים׃"]},{"type":"verse","number":8,"content":["גְּבָ֣ל וְ֭עַמֹּון וַעֲמָלֵ֑ק פְּ֝לֶ֗שֶׁת עִם־יֹ֥שְׁבֵי צֹֽור׃"]},{"type":"verse","number":9,"content":["גַּם־אַ֭שּׁוּר נִלְוָ֣ה עִמָּ֑ם הָ֤י֥וּ זְרֹ֖ועַ לִבְנֵי־לֹ֣וט סֶֽלָה׃"]},{"type":"verse","number":10,"content":["עֲשֵֽׂה־לָהֶ֥ם כְּמִדְיָ֑ן כְּֽסִֽיסְרָ֥א כְ֝יָבִ֗ין בְּנַ֣חַל קִישֹֽׁון׃"]},{"type":"verse","number":11,"content":["נִשְׁמְד֥וּ בְֽעֵין־דֹּ֑אר הָ֥יוּ דֹּ֝֗מֶן לָאֲדָמָֽה׃"]},{"type":"verse","number":12,"content":["שִׁיתֵ֣מֹו נְ֭דִיבֵמֹו כְּעֹרֵ֣ב וְכִזְאֵ֑ב וּֽכְזֶ֥בַח וּ֝כְצַלְמֻנָּ֗ע כָּל־נְסִיכֵֽמֹו׃"]},{"type":"verse","number":13,"content":["אֲשֶׁ֣ר אָ֭מְרוּ נִ֣ירֲשָׁה לָּ֑נוּ אֵ֝֗ת נְאֹ֣ות אֱלֹהִֽים׃"]},{"type":"verse","number":14,"content":["אֱ‍ֽלֹהַ֗י שִׁיתֵ֥מֹו כַגַּלְגַּ֑ל כְּ֝קַ֗שׁ לִפְנֵי־רֽוּחַ׃"]},{"type":"verse","number":15,"content":["כְּאֵ֥שׁ תִּבְעַר־יָ֑עַר וּ֝כְלֶהָבָ֗ה תְּלַהֵ֥ט הָרִֽים׃"]},{"type":"verse","number":16,"content":["כֵּ֭ן תִּרְדְּפֵ֣ם בְּסַעֲרֶ֑ךָ וּבְסוּפָתְךָ֥ תְבַהֲלֵֽם׃"]},{"type":"verse","number":17,"content":["מַלֵּ֣א פְנֵיהֶ֣ם קָלֹ֑ון וִֽיבַקְשׁ֖וּ שִׁמְךָ֣ יְהוָֽה׃"]},{"type":"verse","number":18,"content":["יֵבֹ֖שׁוּ וְיִבָּהֲל֥וּ עֲדֵי־עַ֗ד וְֽיַחְפְּר֥וּ וְיֹאבֵֽדוּ׃"]},{"type":"verse","number":19,"content":["וֽ͏ְיֵדְע֗וּ כִּֽי־אַתָּ֬ה שִׁמְךָ֣ יְהוָ֣ה לְבַדֶּ֑ךָ עֶ֝לְיֹ֗ון עַל־כָּל־הָאָֽרֶץ׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}