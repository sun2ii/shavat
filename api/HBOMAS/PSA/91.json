{"translation":{"id":"HBOMAS","name":"כתבי הקודש","website":"https://ebible.org/Scriptures/details.php?id=hbo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hbo","licenseNotes":null,"shortName":"MAS","englishName":"Hebrew Masoretic OT","language":"hbo","textDirection":"rtl","sha256":"9d7008af21feb26c03504e2fa5cd931115c48802eefedaec2db488a63aeda613","availableFormats":["json"],"listOfBooksApiLink":"/api/HBOMAS/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"Ancient Hebrew","languageEnglishName":"Ancient Hebrew"},"book":{"id":"PSA","translationId":"HBOMAS","name":"תְּהִלִּים","commonName":"תְּהִלִּים","title":"תְּהִלִּים","order":19,"numberOfChapters":150,"sha256":"854f003cd7b199779288026f66772c39b6e5b7c3b3c85e3d081f4945510d7974","firstChapterNumber":1,"firstChapterApiLink":"/api/HBOMAS/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HBOMAS/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":["יֹ֭שֵׁב בְּסֵ֣תֶר עֶלְיֹ֑ון בְּצֵ֥ל שַׁ֝דַּ֗י יִתְלֹונָֽן׃"]},{"type":"verse","number":2,"content":["אֹמַ֗ר לַֽ֭יהוָה מַחְסִ֣י וּמְצוּדָתִ֑י אֱ֝לֹהַ֗י אֶבְטַח־בֹּֽו׃"]},{"type":"verse","number":3,"content":["כִּ֤י ה֣וּא יַ֭צִּֽילְךָ מִפַּ֥ח יָק֗וּשׁ מִדֶּ֥בֶר הַוֹּֽות׃"]},{"type":"verse","number":4,"content":["בְּאֶבְרָתֹ֨ו ׀ יָ֣סֶךְ לָ֭ךְ וְתַֽחַת־כְּנָפָ֣יו תֶּחְסֶ֑ה צִנָּ֖ה וְֽסֹחֵרָ֣ה אֲמִתֹּֽו׃"]},{"type":"verse","number":5,"content":["לֹא־תִ֭ירָא מִפַּ֣חַד לָ֑יְלָה מֵ֝חֵ֗ץ יָע֥וּף יֹומָֽם׃"]},{"type":"verse","number":6,"content":["מִ֭דֶּבֶר בָּאֹ֣פֶל יַהֲלֹ֑ךְ מִ֝קֶּ֗טֶב יָשׁ֥וּד צָהֳרָֽיִם׃"]},{"type":"verse","number":7,"content":["יִפֹּ֤ל מִצִּדְּךָ֨ ׀ אֶ֗לֶף וּרְבָבָ֥ה מִימִינֶ֑ךָ אֵ֝לֶ֗יךָ לֹ֣א יִגָּֽשׁ׃"]},{"type":"verse","number":8,"content":["רַ֭ק בְּעֵינֶ֣יךָ תַבִּ֑יט וְשִׁלֻּמַ֖ת רְשָׁעִ֣ים תִּרְאֶֽה׃"]},{"type":"verse","number":9,"content":["כִּֽי־אַתָּ֣ה יְהוָ֣ה מַחְסִ֑י עֶ֝לְיֹ֗ון שַׂ֣מְתָּ מְעֹונֶֽךָ׃"]},{"type":"verse","number":10,"content":["לֹֽא־תְאֻנֶּ֣ה אֵלֶ֣יךָ רָעָ֑ה וְ֝נֶ֗גַע לֹא־יִקְרַ֥ב בְּאָהֳלֶֽךָ׃"]},{"type":"verse","number":11,"content":["כִּ֣י מַ֭לְאָכָיו יְצַוֶּה־לָּ֑ךְ לִ֝שְׁמָרְךָ֗ בְּכָל־דְּרָכֶֽיךָ׃"]},{"type":"verse","number":12,"content":["עַל־כַּפַּ֥יִם יִשָּׂא֑וּנְךָ פֶּן־תִּגֹּ֖ף בָּאֶ֣בֶן רַגְלֶֽךָ׃"]},{"type":"verse","number":13,"content":["עַל־שַׁ֣חַל וָפֶ֣תֶן תִּדְרֹ֑ךְ תִּרְמֹ֖ס כְּפִ֣יר וְתַנִּֽין׃"]},{"type":"verse","number":14,"content":["כִּ֤י בִ֣י חָ֭שַׁק וַאֲפַלְּטֵ֑הוּ אֲ֝שַׂגְּבֵ֗הוּ כִּֽי־יָדַ֥ע שְׁמִֽי׃"]},{"type":"verse","number":15,"content":["יִקְרָאֵ֨נִי ׀ וְֽאֶעֱנֵ֗הוּ עִמֹּֽו־אָנֹכִ֥י בְצָרָ֑ה אֲ֝חַלְּצֵ֗הוּ וַֽאֲכַבְּדֵֽהוּ׃"]},{"type":"verse","number":16,"content":["אֹ֣רֶךְ יָ֭מִים אַשְׂבִּיעֵ֑הוּ וְ֝אַרְאֵ֗הוּ בִּֽישׁוּעָתִֽי׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}