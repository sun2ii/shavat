ִ֤י הִנֵּ֪ה אֹיְבֶ֡יךָ ׀ יְֽהוָ֗ה כִּֽי־הִנֵּ֣ה אֹיְבֶ֣יךָ יֹאבֵ֑דוּ יִ֝תְפָּרְד֗וּ כָּל־פֹּ֥עֲלֵי אָֽוֶן׃"]},{"type":"verse","number":11,"content":["וַתָּ֣רֶם כִּרְאֵ֣ים קַרְנִ֑י בַּ֝לֹּתִ֗י בְּשֶׁ֣מֶן רַעֲנָֽן׃"]},{"type":"verse","number":12,"content":["וַתַּבֵּ֥ט עֵינִ֗י בְּשׁ֫וּרָ֥י בַּקָּמִ֖ים עָלַ֥י מְרֵעִ֗ים תִּשְׁמַ֥עְנָה אָזְנָֽי׃"]},{"type":"verse","number":13,"content":["צַ֭דִּיק כַּתָּמָ֣ר יִפְרָ֑ח כְּאֶ֖רֶז בַּלְּבָנֹ֣ון יִשְׂגֶּֽה׃"]},{"type":"verse","number":14,"content":["שְׁ֭תוּלִים בְּבֵ֣ית יְהוָ֑ה בְּחַצְרֹ֖ות אֱלֹהֵ֣ינוּ יַפְרִֽיחוּ׃"]},{"type":"verse","number":15,"content":["עֹ֖וד יְנוּב֣וּן בְּשֵׂיבָ֑ה דְּשֵׁנִ֖ים וְרַֽעֲנַנִּ֣ים יִהְיֽוּ׃"]},{"type":"verse","number":16,"content":["לְ֭הַגִּיד כִּֽי־יָשָׁ֣ר יְהוָ֑ה צ֝וּרִ֗י וְֽלֹא־*עֹלָתָה (עַוְלָ֥תָה) בֹּֽו׃"]}],"footnotes":[]},"thisChapterLink":"/api/HBOMAS/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HBOMAS/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HBOMAS/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}