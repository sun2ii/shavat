{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"JOB","translationId":"HINIRV","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूब","order":18,"numberOfChapters":42,"sha256":"dd3e73c7e4f0066d8b1cb7e04873e03c510419a8dbcab31812e07ee204560df4","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/HINIRV/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["शूही बिल्दद का वचन"]},{"type":"verse","number":1,"content":["तब शूही बिल्दद ने कहा,"]},{"type":"verse","number":2,"content":[{"text":"“प्रभुता करना और डराना यह उसी का काम है25:2 प्रभुता करना और डराना यह उसी का काम है: अर्थात् परमेश्वर को राज करने का अधिकार है और उसे श्रद्धा अर्पित करना आवश्यक है।;","poem":1},{"lineBreak":true},{"text":"वह अपने ऊँचे-ऊँचे स्थानों में शान्ति रखता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्या उसकी सेनाओं की गिनती हो सकती?","poem":1},{"lineBreak":true},{"text":"और कौन है जिस पर उसका प्रकाश नहीं पड़ता?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"फिर मनुष्य परमेश्वर की दृष्टि में धर्मी कैसे ठहर सकता है?","poem":1},{"lineBreak":true},{"text":"और जो स्त्री से उत्पन्न हुआ है वह कैसे निर्मल हो सकता है?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"देख, उसकी दृष्टि में चन्द्रमा भी अंधेरा ठहरता,","poem":1},{"lineBreak":true},{"text":"और तारे भी निर्मल नहीं ठहरते।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"फिर मनुष्य की क्या गिनती जो कीड़ा है,","poem":1},{"lineBreak":true},{"text":"और आदमी कहाँ रहा जो केंचुआ है!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}