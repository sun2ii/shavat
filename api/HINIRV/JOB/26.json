{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"JOB","translationId":"HINIRV","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूब","order":18,"numberOfChapters":42,"sha256":"dd3e73c7e4f0066d8b1cb7e04873e03c510419a8dbcab31812e07ee204560df4","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/HINIRV/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["अय्यूब का उत्तर"]},{"type":"verse","number":1,"content":["तब अय्यूब ने कहा,"]},{"type":"verse","number":2,"content":[{"text":"“निर्बल जन की तूने क्या ही बड़ी सहायता की,","poem":1},{"lineBreak":true},{"text":"और जिसकी बाँह में सामर्थ्य नहीं, उसको तूने कैसे सम्भाला है?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"निर्बुद्धि मनुष्य को तूने क्या ही अच्छी सम्मति दी,","poem":1},{"lineBreak":true},{"text":"और अपनी खरी बुद्धि कैसी भली भाँति प्रगट की है?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तूने किसके हित के लिये बातें कही?","poem":1},{"lineBreak":true},{"text":"और किसके मन की बातें तेरे मुँह से निकलीं?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“बहुत दिन के मरे हुए लोग भी","poem":1},{"lineBreak":true},{"text":"जलनिधि और उसके निवासियों के तले तड़पते हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"अधोलोक उसके सामने उघड़ा रहता है,","poem":1},{"lineBreak":true},{"text":"और विनाश का स्थान ढँप नहीं सकता। (भज. 139:8-11 नीति. 15:11, इब्रा. 4:13)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह उत्तर दिशा को निराधार फैलाए रहता है,","poem":1},{"lineBreak":true},{"text":"और बिना टेक पृथ्वी को लटकाए रखता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह जल को अपनी काली घटाओं में बाँध रखता26:8 वह जल को अपनी काली घटाओं में बाँध रखता: बादलों में पानी ऐसा रहता है जैसे बंधा है जब तक कि परमेश्वर उसे बूँदों के रूप में पृथ्वी पर न बरसाएँ।,","poem":1},{"lineBreak":true},{"text":"और बादल उसके बोझ से नहीं फटता।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वह अपने सिंहासन के सामने बादल फैलाकर","poem":1},{"lineBreak":true},{"text":"चाँद को छिपाए रखता है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"उजियाले और अंधियारे के बीच जहाँ सीमा बंधी है,","poem":1},{"lineBreak":true},{"text":"वहाँ तक उसने जलनिधि का सीमा ठहरा रखी है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"उसकी घुड़की से","poem":1},{"lineBreak":true},{"text":"आकाश के खम्भे थरथराते और चकित होते हैं।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"वह अपने बल से समुद्र को शान्त,","poem":1},{"lineBreak":true},{"text":"और अपनी बुद्धि से रहब को छेद देता है।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"उसकी आत्मा से आकाशमण्डल स्वच्छ हो जाता है,","poem":1},{"lineBreak":true},{"text":"वह अपने हाथ से वेग से भागनेवाले नाग को मार देता है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"देखो, ये तो उसकी गति के किनारे ही हैं;","poem":1},{"lineBreak":true},{"text":"और उसकी आहट फुसफुसाहट ही सी तो सुन पड़ती है,","poem":1},{"lineBreak":true},{"text":"फिर उसके पराक्रम के गरजने का भेद कौन समझ सकता है?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}