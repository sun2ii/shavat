{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["परमेश्वर की स्तुति का गीत"]},{"type":"hebrew_subtitle","content":["धन्यवाद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे सारी पृथ्वी के लोगों, यहोवा का जयजयकार करो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"आनन्द से यहोवा की आराधना करो!","poem":1},{"lineBreak":true},{"text":"जयजयकार के साथ उसके सम्मुख आओ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"निश्चय जानो कि यहोवा ही परमेश्वर है","poem":1},{"lineBreak":true},{"text":"उसी ने हमको बनाया, और हम उसी के हैं;","poem":1},{"lineBreak":true},{"text":"हम उसकी प्रजा, और उसकी चराई की भेड़ें हैं100:3 हम उसकी प्रजा, और उसकी चराई की भेड़ें हैं: जिस प्रकार एक चरवाहा अपने वृन्द का स्वामी होता है, जिस प्रकार चरवाहा अपने वृन्द की रक्षा करता है और उनके लिए प्रावधान करता है, उसी प्रकार परमेश्वर हमारी रक्षा करता है और हमारी सुधि लेता है।।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उसके फाटकों में धन्यवाद,","poem":1},{"lineBreak":true},{"text":"और उसके आँगनों में स्तुति करते हुए प्रवेश करो,","poem":1},{"lineBreak":true},{"text":"उसका धन्यवाद करो, और उसके नाम को धन्य कहो!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्योंकि यहोवा भला है, उसकी करुणा सदा के लिये,","poem":1},{"lineBreak":true},{"text":"और उसकी सच्चाई पीढ़ी से पीढ़ी तक बनी रहती है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}