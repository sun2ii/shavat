{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["परमेश्वर पर भरोसा"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"मैं यहोवा में शरण लेता हूँ;","poem":1},{"lineBreak":true},{"text":"तुम क्यों मेरे प्राण से कहते हो","poem":1},{"lineBreak":true},{"text":"“पक्षी के समान अपने पहाड़ पर उड़ जा11:1 पक्षी के समान अपने पहाड़ पर उड़ जा: इसका अभिप्राय है कि वह जहाँ था वहाँ उसकी सुरक्षा नहीं थी।”;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्योंकि देखो, दुष्ट अपना धनुष चढ़ाते हैं,","poem":1},{"lineBreak":true},{"text":"और अपने तीर धनुष की डोरी पर रखते हैं,","poem":1},{"lineBreak":true},{"text":"कि सीधे मनवालों पर अंधियारे में तीर चलाएँ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यदि नींवें ढा दी जाएँ11:3 यदि नींवें ढा दी जाएँ: यहाँ नींव का अर्थ है सत्य एवं धार्मिकता के महान सिद्धान्त जो समाज को थामे रहते हैं जैसे किसी भवन की नींव जो निर्माण को थामती है।","poem":1},{"lineBreak":true},{"text":"तो धर्मी क्या कर सकता है?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"यहोवा अपने पवित्र भवन में है;","poem":1},{"lineBreak":true},{"text":"यहोवा का सिंहासन स्वर्ग में है;","poem":1},{"lineBreak":true},{"text":"उसकी आँखें मनुष्य की सन्तान को नित देखती रहती हैं","poem":1},{"lineBreak":true},{"text":"और उसकी पलकें उनको जाँचती हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"यहोवा धर्मी और दुष्ट दोनों को परखता है,","poem":1},{"lineBreak":true},{"text":"परन्तु जो उपद्रव से प्रीति रखते हैं","poem":1},{"lineBreak":true},{"text":"उनसे वह घृणा करता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह दुष्टों पर आग और गन्धक बरसाएगा;","poem":1},{"lineBreak":true},{"text":"और प्रचण्ड लूह उनके कटोरों में बाँट दी जाएँगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्योंकि यहोवा धर्मी है,","poem":1},{"lineBreak":true},{"text":"वह धार्मिकता के ही कामों से प्रसन्न रहता है;","poem":1},{"lineBreak":true},{"text":"धर्मी जन उसका दर्शन पाएँगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}