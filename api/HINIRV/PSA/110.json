{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["मसीह के शासनकाल की घोषणा"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"मेरे प्रभु से यहोवा की वाणी यह है, “तू मेरे दाहिने ओर बैठ,","poem":1},{"lineBreak":true},{"text":"जब तक कि मैं तेरे शत्रुओं को तेरे चरणों की चौकी न कर दूँ।” (इब्रा. 10:12,13, लूका 20:42,43)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तेरे पराक्रम का राजदण्ड यहोवा सिय्योन से बढ़ाएगा।","poem":1},{"lineBreak":true},{"text":"तू अपने शत्रुओं के बीच में शासन कर।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तेरी प्रजा के लोग तेरे पराक्रम के दिन स्वेच्छाबलि बनते हैं;","poem":1},{"lineBreak":true},{"text":"तेरे जवान लोग पवित्रता से शोभायमान,","poem":1},{"lineBreak":true},{"text":"और भोर के गर्भ से जन्मी हुई ओस के समान तेरे पास हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"यहोवा ने शपथ खाई और न पछताएगा,","poem":1},{"lineBreak":true},{"text":"“तू मलिकिसिदक की रीति पर सर्वदा का याजक है110:4 तू मलिकिसिदक की रीति पर सर्वदा का याजक है: अर्थात् वह मलिकिसिदक के समान पुरोहित था जैसा वह पुरोहित था वैसा ही पुरोहित होगा।।” (इब्रा. 7:21, इब्रा. 7:17)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"प्रभु तेरी दाहिनी ओर होकर","poem":1},{"lineBreak":true},{"text":"अपने क्रोध के दिन राजाओं को चूर कर देगा। (भज. 143:5)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह जाति-जाति में न्याय चुकाएगा, रणभूमि शवों से भर जाएगी;","poem":1},{"lineBreak":true},{"text":"वह लम्बे चौड़े देशों के प्रधानों को चूर चूरकर देगा","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह मार्ग में चलता हुआ नदी का जल पीएगा","poem":1},{"lineBreak":true},{"text":"और तब वह विजय के बाद अपने सिर को ऊँचा करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}