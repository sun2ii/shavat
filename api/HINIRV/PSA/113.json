{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["स्तुति के योग्य नाम"]},{"type":"verse","number":1,"content":[{"text":"यहोवा की स्तुति करो!","poem":1},{"lineBreak":true},{"text":"हे यहोवा के दासों, स्तुति करो,","poem":1},{"lineBreak":true},{"text":"यहोवा के नाम की स्तुति करो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यहोवा का नाम","poem":1},{"lineBreak":true},{"text":"अब से लेकर सर्वदा तक धन्य कहा जाएँ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उदयाचल से लेकर अस्ताचल तक,","poem":1},{"lineBreak":true},{"text":"यहोवा का नाम स्तुति के योग्य है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"यहोवा सारी जातियों के ऊपर महान है,","poem":1},{"lineBreak":true},{"text":"और उसकी महिमा आकाश से भी ऊँची है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हमारे परमेश्वर यहोवा के तुल्य कौन है?","poem":1},{"lineBreak":true},{"text":"वह तो ऊँचे पर विराजमान है,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"और आकाश और पृथ्वी पर,","poem":1},{"lineBreak":true},{"text":"दृष्टि करने के लिये झुकता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह कंगाल को मिट्टी पर से,","poem":1},{"lineBreak":true},{"text":"और दरिद्र को घूरे पर से उठाकर ऊँचा करता है113:7 वह कंगाल को मिट्टी पर से, .... उठाकर ऊँचा करता है: जीवन की तुच्छ अवस्था से वह उन्हें धन-सम्पदा और पद-प्रतिष्ठा में ले आता है।,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"कि उसको प्रधानों के संग,","poem":1},{"lineBreak":true},{"text":"अर्थात् अपनी प्रजा के प्रधानों के संग बैठाए। (अय्यू. 36:7)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वह बाँझ को घर में बाल-बच्चों की आनन्द करनेवाली माता बनाता है।","poem":1},{"lineBreak":true},{"text":"यहोवा की स्तुति करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}