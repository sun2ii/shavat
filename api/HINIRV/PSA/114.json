{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["फसह का गीत"]},{"type":"verse","number":1,"content":[{"text":"जब इस्राएल ने मिस्र से, अर्थात् याकूब के घराने ने अन्य भाषावालों के मध्य से कूच किया,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तब यहूदा यहोवा का पवित्रस्थान","poem":1},{"lineBreak":true},{"text":"और इस्राएल उसके राज्य के लोग हो गए।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"समुद्र देखकर भागा,","poem":1},{"lineBreak":true},{"text":"यरदन नदी उलटी बही। (भज. 77:16)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पहाड़ मेढ़ों के समान उछलने लगे,","poem":1},{"lineBreak":true},{"text":"और पहाड़ियाँ भेड़-बकरियों के बच्चों के समान उछलने लगीं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे समुद्र, तुझे क्या हुआ, कि तू भागा?","poem":1},{"lineBreak":true},{"text":"और हे यरदन तुझे क्या हुआ कि तू उलटी बही?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हे पहाड़ों, तुम्हें क्या हुआ, कि तुम भेड़ों के समान,","poem":1},{"lineBreak":true},{"text":"और हे पहाड़ियों तुम्हें क्या हुआ, कि तुम भेड़-बकरियों के बच्चों के समान उछलीं?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे पृथ्वी प्रभु के सामने,","poem":1},{"lineBreak":true},{"text":"हाँ, याकूब के परमेश्वर के सामने थरथरा। (भज. 96:9)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह चट्टान को जल का ताल,","poem":1},{"lineBreak":true},{"text":"चकमक के पत्थर को जल का सोता बना डालता है114:8 वह चट्टान को जल का ताल, .... बना डालता है: संदर्भ उस समय की घटना का है जब चट्टान से पानी निकलकर वहाँ तालाब बन गया था।।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}