{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["दुष्ट द्वारा उत्पीड़न और परमेश्वर द्वारा स्थिर"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये खर्ज की राग में दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा बचा ले, क्योंकि एक भी भक्त नहीं रहा;","poem":1},{"lineBreak":true},{"text":"मनुष्यों में से विश्वासयोग्य लोग लुप्त‍ हो गए हैं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"प्रत्येक मनुष्य अपने पड़ोसी से झूठी बातें कहता है;","poem":1},{"lineBreak":true},{"text":"वे चापलूसी के होठों से दो रंगी बातें करते हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यहोवा सब चापलूस होठों को","poem":1},{"lineBreak":true},{"text":"और उस जीभ को जिससे बड़ा बोल निकलता है12:3 उस जीभ को जिससे बड़ा बोल निकलता है: बड़े बोल बोलनेवाले या आत्मस्वाभिमानी। काट डालेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वे कहते हैं, “हम अपनी जीभ ही से जीतेंगे,","poem":1},{"lineBreak":true},{"text":"हमारे होंठ हमारे ही वश में हैं; हम पर कौन शासन कर सकेगा?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"दीन लोगों के लुट जाने, और दरिद्रों के कराहने के कारण,","poem":1},{"lineBreak":true},{"text":"यहोवा कहता है, “अब मैं उठूँगा, जिस पर","poem":1},{"lineBreak":true},{"text":"वे फुँकारते हैं उसे मैं चैन विश्राम दूँगा।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यहोवा का वचन पवित्र है,","poem":1},{"lineBreak":true},{"text":"उस चाँदी के समान जो भट्ठी में मिट्टी पर ताई गई,","poem":1},{"lineBreak":true},{"text":"और सात बार निर्मल की गई हो12:6 सात बार निर्मल की गई हो: अर्थात् बार बार आग में पिघलाई गई।।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू ही हे यहोवा उनकी रक्षा करेगा,","poem":1},{"lineBreak":true},{"text":"उनको इस काल के लोगों से सर्वदा के लिये बचाए रखेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जब मनुष्यों में बुराई का आदर होता है,","poem":1},{"lineBreak":true},{"text":"तब दुष्ट लोग चारों ओर अकड़ते फिरते हैं।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}