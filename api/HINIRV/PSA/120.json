{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["परमेश्वर से मदद के लिए प्रार्थना"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"संकट के समय मैंने यहोवा को पुकारा,","poem":1},{"lineBreak":true},{"text":"और उसने मेरी सुन ली।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे यहोवा, झूठ बोलनेवाले मुँह से","poem":1},{"lineBreak":true},{"text":"और छली जीभ से मेरी रक्षा कर।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे छली जीभ,","poem":1},{"lineBreak":true},{"text":"तुझको क्या मिले? और तेरे साथ और क्या अधिक किया जाए?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वीर के नोकीले तीर","poem":1},{"lineBreak":true},{"text":"और झाऊ के अंगारे!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हाय, हाय, क्योंकि मुझे मेशेक में परदेशी होकर रहना पड़ा","poem":1},{"lineBreak":true},{"text":"और केदार के तम्बुओं में बसना पड़ा है!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"बहुत समय से मुझ को मेल के बैरियों के साथ बसना पड़ा है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मैं तो मेल चाहता हूँ;","poem":1},{"lineBreak":true},{"text":"परन्तु मेरे बोलते120:7 मेरे बोलते: जब भी इसकी चर्चा करता हूँ, में जब भी अपनी दु:खित भावनाओं को व्यक्त करता हूँ, वे अनसुना करते हैं; उन्हें किसी बात से सन्तोष नहीं होता है। ही, वे लड़ना चाहते हैं!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}