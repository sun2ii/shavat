{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["परमेश्वर हमारा रक्षक"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"मैं अपनी आँखें पर्वतों की ओर उठाऊँगा।","poem":1},{"lineBreak":true},{"text":"मुझे सहायता कहाँ से मिलेगी?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मुझे सहायता यहोवा की ओर से मिलती है,","poem":1},{"lineBreak":true},{"text":"जो आकाश और पृथ्वी का कर्ता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह तेरे पाँव को टलने न देगा121:3 वह तेरे पाँव को टलने न देगा: वह तुम्हें दृढ़ खड़ा रहने में सक्षम बनाएगा। उसकी शरण में तू सुरक्षित है।,","poem":1},{"lineBreak":true},{"text":"तेरा रक्षक कभी न ऊँघेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"सुन, इस्राएल का रक्षक,","poem":1},{"lineBreak":true},{"text":"न ऊँघेगा और न सोएगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"यहोवा तेरा रक्षक है;","poem":1},{"lineBreak":true},{"text":"यहोवा तेरी दाहिनी ओर तेरी आड़ है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"न तो दिन को धूप से,","poem":1},{"lineBreak":true},{"text":"और न रात को चाँदनी से तेरी कुछ हानि होगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"यहोवा सारी विपत्ति से तेरी रक्षा करेगा;","poem":1},{"lineBreak":true},{"text":"वह तेरे प्राण की रक्षा करेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यहोवा तेरे आने-जाने में","poem":1},{"lineBreak":true},{"text":"तेरी रक्षा अब से लेकर सदा तक करता रहेगा121:8 यहोवा .... तेरी रक्षा अब से लेकर सदा तक करता रहेगा: अर्थात् हर जगह हर समय।।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}