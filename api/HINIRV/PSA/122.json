{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["यरूशलेम की शान्ति के लिये प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाऊद की यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"जब लोगों ने मुझसे कहा, “आओ, हम यहोवा के भवन को चलें,”","poem":1},{"lineBreak":true},{"text":"तब मैं आनन्दित हुआ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे यरूशलेम, तेरे फाटकों के भीतर,","poem":1},{"lineBreak":true},{"text":"हम खड़े हो गए हैं!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे यरूशलेम, तू ऐसे नगर के समान बना है,","poem":1},{"lineBreak":true},{"text":"जिसके घर एक दूसरे से मिले हुए हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वहाँ यहोवा के गोत्र-गोत्र के लोग यहोवा के नाम का धन्यवाद करने को जाते हैं;","poem":1},{"lineBreak":true},{"text":"यह इस्राएल के लिये साक्षी है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वहाँ तो न्याय के सिंहासन122:5 न्याय के सिंहासन: जिन आसनों पर बैठकर न्याय किया जाता है। आज सिंहासन शब्द से समझा जाता है राजाओं के आसन।,","poem":1},{"lineBreak":true},{"text":"दाऊद के घराने के लिये रखे हुए हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यरूशलेम की शान्ति का वरदान माँगो,","poem":1},{"lineBreak":true},{"text":"तेरे प्रेमी कुशल से रहें!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तेरी शहरपनाह के भीतर शान्ति,","poem":1},{"lineBreak":true},{"text":"और तेरे महलों में कुशल होवे!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अपने भाइयों और संगियों के निमित्त,","poem":1},{"lineBreak":true},{"text":"मैं कहूँगा कि तुझ में शान्ति होवे!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"अपने परमेश्वर यहोवा के भवन के निमित्त,","poem":1},{"lineBreak":true},{"text":"मैं तेरी भलाई का यत्न करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}