{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["परमेश्वर अपने लोगों का रक्षक"]},{"type":"hebrew_subtitle","content":["दाऊद की यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"इस्राएल यह कहे,","poem":1},{"lineBreak":true},{"text":"कि यदि हमारी ओर यहोवा न होता,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यदि यहोवा उस समय हमारी ओर न होता","poem":1},{"lineBreak":true},{"text":"जब मनुष्यों ने हम पर चढ़ाई की,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो वे हमको उसी समय जीवित निगल जाते124:3 वे हमको उसी समय जीवित निगल जाते: अर्थात्, वे ऐसे नष्ट हो जाते जैसे निगल लिए गए हों अर्थात् सम्पूर्ण विनाश हो जाता।,","poem":1},{"lineBreak":true},{"text":"जब उनका क्रोध हम पर भड़का था,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हम उसी समय जल में डूब जाते","poem":1},{"lineBreak":true},{"text":"और धारा में बह जाते;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"उमड़ते जल में हम उसी समय ही बह जाते।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"धन्य है यहोवा,","poem":1},{"lineBreak":true},{"text":"जिसने हमको उनके दाँतों तले जाने न दिया!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हमारा जीव पक्षी के समान चिड़ीमार के जाल से छूट गया124:7 चिड़ीमार के जाल से छूट गया: ऐसा प्रतीत होता है कि शत्रु ने हमें पूर्णतः अपनी शक्ति के अधीन किया हुआ है परन्तु हम ऐसे बच गए जैसे पक्षी जाल टूटने पर बच जाता है।;","poem":1},{"lineBreak":true},{"text":"जाल फट गया और हम बच निकले!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यहोवा जो आकाश और पृथ्वी का कर्ता है,","poem":1},{"lineBreak":true},{"text":"हमारी सहायता उसी के नाम से होती है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}