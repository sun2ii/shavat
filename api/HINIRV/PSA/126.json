{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["सिय्योन की हर्षित वापसी"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"जब यहोवा सिय्योन में लौटनेवालों को लौटा ले आया,","poem":1},{"lineBreak":true},{"text":"तब हम स्वप्न देखनेवाले से हो गए126:1 हम स्वप्न देखनेवाले से हो गए: वह एक स्वप्न जैसा था कि हमें विश्वास नहीं हो रहा था कि ऐसा हो गया है। वह ऐसा आश्चर्यजनक था, ऐसा सुहावना था, ऐसा आनन्द से भरा हुआ था कि हमें विश्वास ही नहीं हो रहा था कि वह वास्तविक है।।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तब हम आनन्द से हँसने","poem":1},{"lineBreak":true},{"text":"और जयजयकार करने लगे;","poem":1},{"lineBreak":true},{"text":"तब जाति-जाति के बीच में कहा जाता था,","poem":1},{"lineBreak":true},{"text":"“यहोवा ने, इनके साथ बड़े-बड़े काम किए हैं।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यहोवा ने हमारे साथ बड़े-बड़े काम किए हैं;","poem":1},{"lineBreak":true},{"text":"और इससे हम आनन्दित हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे यहोवा, दक्षिण देश के नालों के समान,","poem":1},{"lineBreak":true},{"text":"हमारे बन्दियों को लौटा ले आ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जो आँसू बहाते हुए बोते हैं126:5 जो आँसू बहाते हुए बोते हैं: बीज बोना एक परिश्रम का काम है और किसान पर ऐसा बोझ होता है कि वह रो देता है परन्तु जब फसल तैयार हो जाती है तब वह लवनी करके आनन्दित होता है।,","poem":1},{"lineBreak":true},{"text":"वे जयजयकार करते हुए लवने पाएँगे।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"चाहे बोनेवाला बीज लेकर रोता हुआ चला जाए,","poem":1},{"lineBreak":true},{"text":"परन्तु वह फिर पूलियाँ लिए जयजयकार करता हुआ निश्चय लौट आएगा। (लूका 6:21)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}