{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["परमेश्वर का आशीर्वाद"]},{"type":"hebrew_subtitle","content":["सुलैमान की यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"यदि घर को यहोवा न बनाए,","poem":1},{"lineBreak":true},{"text":"तो उसके बनानेवालों का परिश्रम व्यर्थ होगा।","poem":1},{"lineBreak":true},{"text":"यदि नगर की रक्षा यहोवा न करे,","poem":1},{"lineBreak":true},{"text":"तो रखवाले का जागना व्यर्थ ही होगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तुम जो सवेरे उठते और देर करके विश्राम करते","poem":1},{"lineBreak":true},{"text":"और कठोर परिश्रम की रोटी खाते हो, यह सब तुम्हारे लिये व्यर्थ ही है;","poem":1},{"lineBreak":true},{"text":"क्योंकि वह अपने प्रियों को यों ही नींद प्रदान करता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"देखो, बच्चे यहोवा के दिए हुए भाग हैं127:3 बच्चे यहोवा के दिए हुए भाग हैं: वे प्रकृति की ओर से परमेश्वर की भक्ति का प्रतिफल हैं वे परमेश्वर की प्रतिज्ञा के अनुसार आशीषें हैं।,","poem":1},{"lineBreak":true},{"text":"गर्भ का फल उसकी ओर से प्रतिफल है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जैसे वीर के हाथ में तीर,","poem":1},{"lineBreak":true},{"text":"वैसे ही जवानी के बच्चे होते हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्या ही धन्य है वह पुरुष जिसने अपने तरकश को उनसे भर लिया हो!","poem":1},{"lineBreak":true},{"text":"वह फाटक के पास अपने शत्रुओं से बातें करते संकोच न करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}