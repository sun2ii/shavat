{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["परमेश्वर का भय मानने की आशीष"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"क्या ही धन्य है हर एक जो यहोवा का भय मानता है,","poem":1},{"lineBreak":true},{"text":"और उसके मार्गों पर चलता है128:1 उसके मार्गों पर चलता है: परमेश्वर की आज्ञा और आदेशों के मार्ग।!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तू अपनी कमाई को निश्चय खाने पाएगा;","poem":1},{"lineBreak":true},{"text":"तू धन्य होगा, और तेरा भला ही होगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तेरे घर के भीतर तेरी स्त्री फलवन्त दाखलता सी होगी;","poem":1},{"lineBreak":true},{"text":"तेरी मेज के चारों ओर तेरे बच्चे जैतून के पौधे के समान होंगे।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"सुन, जो पुरुष यहोवा का भय मानता हो,","poem":1},{"lineBreak":true},{"text":"वह ऐसी ही आशीष पाएगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"यहोवा तुझे सिय्योन से आशीष देवे128:5 यहोवा तुझे सिय्योन से आशीष देवे: वह तुझे खेतों में और घरों में ही आशीष नहीं देगा परन्तु तेरी आशीषें सीधी सिय्योन से आती प्रतीत होंगी।,","poem":1},{"lineBreak":true},{"text":"और तू जीवन भर यरूशलेम का कुशल देखता रहे!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वरन् तू अपने नाती-पोतों को भी देखने पाए!","poem":1},{"lineBreak":true},{"text":"इस्राएल को शान्ति मिले!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}