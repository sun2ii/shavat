{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["सिय्योन के शत्रुओं पर विजय का गीत"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"इस्राएल अब यह कहे,","poem":1},{"lineBreak":true},{"text":"“मेरे बचपन से लोग मुझे बार बार क्लेश देते आए हैं,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मेरे बचपन से वे मुझ को बार बार क्लेश देते तो आए हैं,","poem":1},{"lineBreak":true},{"text":"परन्तु मुझ पर प्रबल नहीं हुए।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हलवाहों ने मेरी पीठ के ऊपर हल चलाया129:3 हलवाहों ने मेरी पीठ के ऊपर हल चलाया: यह रूपक ही भूमि जोतने का है उसमें निहित विचार यह है कि कष्ट ऐसे हैं जैसे हल धरती का सीना चीरता है।,","poem":1},{"lineBreak":true},{"text":"और लम्बी-लम्बी रेखाएँ की।”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"यहोवा धर्मी है;","poem":1},{"lineBreak":true},{"text":"उसने दुष्टों के फंदों को काट डाला है;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जितने सिय्योन से बैर रखते हैं,","poem":1},{"lineBreak":true},{"text":"वे सब लज्जित हों, और पराजित होकर पीछे हट जाए!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वे छत पर की घास के समान हों,","poem":1},{"lineBreak":true},{"text":"जो बढ़ने से पहले सूख जाती है;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जिससे कोई लवनेवाला अपनी मुट्ठी नहीं भरता129:7 जिससे कोई लवनेवाला अपनी मुट्ठी नहीं भरता: वह एकत्र करके मवेशियों के लिए नहीं रखी जाती जैसे मैदान की घास। ऐसे किसी काम के लिए वह व्यर्थ है या वह पूर्णतः निकम्मी है।,","poem":1},{"lineBreak":true},{"text":"न पूलियों का कोई बाँधनेवाला अपनी अँकवार भर पाता है,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"और न आने-जानेवाले यह कहते हैं,","poem":1},{"lineBreak":true},{"text":"“यहोवा की आशीष तुम पर होवे!","poem":1},{"lineBreak":true},{"text":"हम तुम को यहोवा के नाम से आशीर्वाद देते हैं!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}