{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["करुणामय परमेश्वर"]},{"type":"hebrew_subtitle","content":["यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मैंने गहरे स्थानों में से तुझको पुकारा है!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे प्रभु, मेरी सुन!","poem":1},{"lineBreak":true},{"text":"तेरे कान मेरे गिड़गिड़ाने की ओर ध्यान से लगे रहें!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे यहोवा, यदि तू अधर्म के कामों का लेखा ले,","poem":1},{"lineBreak":true},{"text":"तो हे प्रभु कौन खड़ा रह सकेगा?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परन्तु तू क्षमा करनेवाला है,","poem":1},{"lineBreak":true},{"text":"जिससे तेरा भय माना जाए।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मैं यहोवा की बाट जोहता हूँ, मैं जी से उसकी बाट जोहता हूँ,","poem":1},{"lineBreak":true},{"text":"और मेरी आशा उसके वचन पर है;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पहरुए जितना भोर को चाहते हैं130:6 पहरुए जितना भोर को चाहते हैं: रात में जो चौकसी करते हैं वे सूर्योदय की प्रतिक्षा करते हैं कि वे कार्य निवृत्त हों। इसी प्रकार कष्टों में, दुःख की लम्बी, तमसपूर्ण, विशादपूर्ण रात में कष्ट भोगी प्राण के लिए शान्ति का पहला संकेत, पहली हलकी सी किरण की प्रतिक्षा करता है।, हाँ,","poem":1},{"lineBreak":true},{"text":"पहरुए जितना भोर को चाहते हैं,","poem":1},{"lineBreak":true},{"text":"उससे भी अधिक मैं यहोवा को अपने प्राणों से चाहता हूँ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"इस्राएल, यहोवा पर आशा लगाए रहे!","poem":1},{"lineBreak":true},{"text":"क्योंकि यहोवा करुणा करनेवाला","poem":1},{"lineBreak":true},{"text":"और पूरा छुटकारा देनेवाला है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"इस्राएल को उसके सारे अधर्म के कामों से वही छुटकारा देगा। (भज. 131:3)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}