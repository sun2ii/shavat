{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"heading","content":["परमेश्वर के लोगों की एकता"]},{"type":"hebrew_subtitle","content":["दाऊद की यात्रा का गीत"]},{"type":"verse","number":1,"content":[{"text":"देखो, यह क्या ही भली और मनोहर बात है","poem":1},{"lineBreak":true},{"text":"कि भाई लोग आपस में मिले रहें!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यह तो उस उत्तम तेल के समान है,","poem":1},{"lineBreak":true},{"text":"जो हारून के सिर पर डाला गया था133:2 यह तो उस उत्तम तेल के समान है, जो हारून के सिर पर डाला गया था: जब हारून को पवित्र पद के लिए समर्पित किया गया था तब उसके सिर पर तेल डाला गया था।,","poem":1},{"lineBreak":true},{"text":"और उसकी दाढ़ी से बहकर,","poem":1},{"lineBreak":true},{"text":"उसके वस्त्र की छोर तक पहुँच गया।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह हेर्मोन की उस ओस के समान है,","poem":1},{"lineBreak":true},{"text":"जो सिय्योन के पहाड़ों पर गिरती है!","poem":1},{"lineBreak":true},{"text":"यहोवा ने तो वहीं सदा के जीवन की आशीष ठहराई है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}