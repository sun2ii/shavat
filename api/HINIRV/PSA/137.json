{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["बन्धुवाई में इस्राएल का विलापगीत"]},{"type":"verse","number":1,"content":[{"text":"बाबेल की नदियों के किनारे हम लोग बैठ गए,","poem":1},{"lineBreak":true},{"text":"और सिय्योन को स्मरण करके रो पड़े!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उसके बीच के मजनू वृक्षों पर","poem":1},{"lineBreak":true},{"text":"हमने अपनी वीणाओं को टाँग दिया;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्योंकि जो हमको बन्दी बनाकर ले गए थे,","poem":1},{"lineBreak":true},{"text":"उन्होंने वहाँ हम से गीत गवाना चाहा,","poem":1},{"lineBreak":true},{"text":"और हमारे रुलाने वालों ने हम से आनन्द चाहकर कहा,","poem":1},{"lineBreak":true},{"text":"“सिय्योन के गीतों में से हमारे लिये कोई गीत गाओ!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हम यहोवा के गीत को,","poem":1},{"lineBreak":true},{"text":"पराए देश में कैसे गाएँ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे यरूशलेम, यदि मैं तुझे भूल जाऊँ,","poem":1},{"lineBreak":true},{"text":"तो मेरा दाहिना हाथ सूख जाए!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यदि मैं तुझे स्मरण न रखूँ,","poem":1},{"lineBreak":true},{"text":"यदि मैं यरूशलेम को,","poem":1},{"lineBreak":true},{"text":"अपने सब आनन्द से श्रेष्ठ न जानूँ,","poem":1},{"lineBreak":true},{"text":"तो मेरी जीभ तालू से चिपट जाए!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे यहोवा, यरूशलेम के गिराए जाने के दिन को एदोमियों के विरुद्ध स्मरण कर,","poem":1},{"lineBreak":true},{"text":"कि वे कैसे कहते थे, “ढाओ! उसको नींव से ढा दो!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे बाबेल, तू जो जल्द उजड़नेवाली है,","poem":1},{"lineBreak":true},{"text":"क्या ही धन्य वह होगा, जो तुझ से ऐसा बर्ताव करेगा137:8 क्या ही धन्य वह होगा, जो तुझ से ऐसा बर्ताव करेगा: अर्थात् जो ऐसे अपराधी एवं निर्दयी नगर को दण्ड देने का साधन बनाया जाए, वह एक सौभाग्यशाली मनुष्य होने का सम्मान पाएगा।","poem":1},{"lineBreak":true},{"text":"जैसा तूने हम से किया है! (प्रका. 18:6)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्या ही धन्य वह होगा, जो तेरे बच्चों को पकड़कर,","poem":1},{"lineBreak":true},{"text":"चट्टान पर पटक देगा! (यशा. 13:16)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}