{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"heading","content":["प्रशंसा का एक भजन"]},{"type":"verse","number":1,"content":[{"text":"यहोवा की स्तुति करो!","poem":1},{"lineBreak":true},{"text":"परमेश्वर के पवित्रस्थान में उसकी स्तुति करो;","poem":1},{"lineBreak":true},{"text":"उसकी सामर्थ्य से भरे हुए आकाशमण्डल में","poem":1},{"lineBreak":true},{"text":"उसकी स्तुति करो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उसके पराक्रम के कामों के कारण","poem":1},{"lineBreak":true},{"text":"उसकी स्तुति करो150:2 उसके पराक्रम के कामों के कारण उसकी स्तुति करो: यहाँ परमेश्वर के सामर्थ्य को और उसकी सर्वशक्ति को प्रगट करनेवाली बातों का संदर्भ दिया गया है।;","poem":1},{"lineBreak":true},{"text":"उसकी अत्यन्त बड़ाई के अनुसार उसकी स्तुति करो!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"नरसिंगा फूँकते हुए उसकी स्तुति करो;","poem":1},{"lineBreak":true},{"text":"सारंगी और वीणा बजाते हुए उसकी स्तुति करो!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"डफ बजाते और नाचते हुए उसकी स्तुति करो;","poem":1},{"lineBreak":true},{"text":"तारवाले बाजे और बाँसुरी बजाते हुए","poem":1},{"lineBreak":true},{"text":"उसकी स्तुति करो!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऊँचे शब्दवाली झाँझ बजाते हुए","poem":1},{"lineBreak":true},{"text":"उसकी स्तुति करो;","poem":1},{"lineBreak":true},{"text":"आनन्द के महाशब्दवाली झाँझ बजाते हुए","poem":1},{"lineBreak":true},{"text":"उसकी स्तुति करो!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जितने प्राणी हैं","poem":1},{"lineBreak":true},{"text":"सब के सब यहोवा की स्तुति करें150:6 जितने प्राणी हैं सब के सब यहोवा की स्तुति करें: आकाश पृथ्वी और जल के सब प्राणी। एक विश्वव्यापी स्तुति का उदगार हो केवल संगीत वाद्द्यों से ही नहीं, सब जीवित प्राणी एक साथ उसकी स्तुति करें।!","poem":1},{"lineBreak":true},{"text":"यहोवा की स्तुति करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}