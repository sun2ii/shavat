{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["परमेश्वर अपने लोगों का चरवाहा"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"यहोवा मेरा चरवाहा है,","poem":1},{"lineBreak":true},{"text":"मुझे कुछ घटी न होगी। (यशा. 40:11)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वह मुझे हरी-हरी चराइयों में बैठाता है;","poem":1},{"lineBreak":true},{"text":"वह मुझे सुखदाई जल23:2 सुखदाई जल: रुका हुआ जल नहीं, परमेश्वर के जनों के लिए काम में लेने पर इसका अभिप्राय है, नीरवता, शान्ति, और प्राण का विश्राम। के झरने के पास ले चलता है;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह मेरे जी में जी ले आता है।","poem":1},{"lineBreak":true},{"text":"धार्मिकता के मार्गों में वह अपने नाम के निमित्त","poem":1},{"lineBreak":true},{"text":"मेरी अगुआई करता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"चाहे मैं घोर अंधकार से भरी हुई तराई में होकर चलूँ,","poem":1},{"lineBreak":true},{"text":"तो भी हानि से न डरूँगा,","poem":1},{"lineBreak":true},{"text":"क्योंकि तू मेरे साथ रहता है;","poem":1},{"lineBreak":true},{"text":"तेरे सोंटे और तेरी लाठी से मुझे शान्ति मिलती है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तू मेरे सतानेवालों के सामने मेरे लिये मेज बिछाता है23:5 मेरे लिये मेज बिछाता है: परमेश्वर ने मेज लगाई, भोज का आयोजन किया जबकि उसके बैरी सामने थे।;","poem":1},{"lineBreak":true},{"text":"तूने मेरे सिर पर तेल मला है,","poem":1},{"lineBreak":true},{"text":"मेरा कटोरा उमड़ रहा है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"निश्चय भलाई और करुणा जीवन भर मेरे","poem":1},{"lineBreak":true},{"text":"साथ-साथ बनी रहेंगी;","poem":1},{"lineBreak":true},{"text":"और मैं यहोवा के धाम में सर्वदा वास करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}