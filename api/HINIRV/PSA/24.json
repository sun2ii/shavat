{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["महिमामय राजा और उसका राज्य"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"पृथ्वी और जो कुछ उसमें है यहोवा ही का है;","poem":1},{"lineBreak":true},{"text":"जगत और उसमें निवास करनेवाले भी।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्योंकि उसी ने उसकी नींव समुद्रों के ऊपर दृढ़ करके रखी24:2 उसी ने उसकी नींव समुद्रों के ऊपर दृढ़ करके रखी: जैसे पृथ्वी जल से घिरी प्रतीत होती है तो उसे जल पर नींव डालकर दृढ़ रखने की अभिव्यक्ति स्वाभाविक है।,","poem":1},{"lineBreak":true},{"text":"और महानदों के ऊपर स्थिर किया है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यहोवा के पर्वत पर कौन चढ़ सकता है?","poem":1},{"lineBreak":true},{"text":"और उसके पवित्रस्थान में कौन खड़ा हो सकता है?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जिसके काम निर्दोष24:4 जिसके काम निर्दोष: अर्थात् जो खरा है। हृदय शुद्ध है अर्थात् बाहरी आचरण ही खरा न हो उसका मन भी शुद्ध हो। और हृदय शुद्ध है,","poem":1},{"lineBreak":true},{"text":"जिसने अपने मन को व्यर्थ बात की ओर नहीं लगाया,","poem":1},{"lineBreak":true},{"text":"और न कपट से शपथ खाई है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह यहोवा की ओर से आशीष पाएगा,","poem":1},{"lineBreak":true},{"text":"और अपने उद्धार करनेवाले परमेश्वर की","poem":1},{"lineBreak":true},{"text":"ओर से धर्मी ठहरेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ऐसे ही लोग उसके खोजी है,","poem":1},{"lineBreak":true},{"text":"वे तेरे दर्शन के खोजी याकूबवंशी हैं। (सेला)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे फाटकों, अपने सिर ऊँचे करो!","poem":1},{"lineBreak":true},{"text":"हे सनातन के द्वारों, ऊँचे हो जाओ!","poem":1},{"lineBreak":true},{"text":"क्योंकि प्रतापी राजा प्रवेश करेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह प्रतापी राजा कौन है?","poem":1},{"lineBreak":true},{"text":"यहोवा जो सामर्थी और पराक्रमी है,","poem":1},{"lineBreak":true},{"text":"परमेश्वर जो युद्ध में पराक्रमी है!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे फाटकों, अपने सिर ऊँचे करो","poem":1},{"lineBreak":true},{"text":"हे सनातन के द्वारों तुम भी खुल जाओ!","poem":1},{"lineBreak":true},{"text":"क्योंकि प्रतापी राजा प्रवेश करेगा!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"वह प्रतापी राजा कौन है?","poem":1},{"lineBreak":true},{"text":"सेनाओं का यहोवा, वही प्रतापी राजा है। (सेला)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}