{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["विनती और धन्यवाद"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मैं तुझी को पुकारूँगा;","poem":1},{"lineBreak":true},{"text":"हे मेरी चट्टान, मेरी पुकार अनसुनी न कर,","poem":1},{"lineBreak":true},{"text":"ऐसा न हो कि तेरे चुप रहने से","poem":1},{"lineBreak":true},{"text":"मैं कब्र में पड़े हुओं के समान हो जाऊँ जो पाताल में चले जाते हैं28:1 जो पाताल में चले जाते हैं: मृतकों के सदृश्य तनाव और निराशा से ग्रस्त होकर मर जाऊँ।।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जब मैं तेरी दुहाई दूँ,","poem":1},{"lineBreak":true},{"text":"और तेरे पवित्रस्थान की भीतरी कोठरी","poem":1},{"lineBreak":true},{"text":"की ओर अपने हाथ उठाऊँ,","poem":1},{"lineBreak":true},{"text":"तब मेरी गिड़गिड़ाहट की बात सुन ले।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उन दुष्टों और अनर्थकारियों के संग मुझे न घसीट;","poem":1},{"lineBreak":true},{"text":"जो अपने पड़ोसियों से बातें तो मेल की बोलते हैं,","poem":1},{"lineBreak":true},{"text":"परन्तु हृदय में बुराई रखते हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उनके कामों के और उनकी करनी की बुराई","poem":1},{"lineBreak":true},{"text":"के अनुसार उनसे बर्ताव कर,","poem":1},{"lineBreak":true},{"text":"उनके हाथों के काम के अनुसार उन्हें बदला दे;","poem":1},{"lineBreak":true},{"text":"उनके कामों का पलटा उन्हें दे। (मत्ती 16:27, प्रका. 18:6,13, प्रका. 22:12)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्योंकि वे यहोवा के कामों को","poem":1},{"lineBreak":true},{"text":"और उसके हाथ के कामों को नहीं समझते,","poem":1},{"lineBreak":true},{"text":"इसलिए वह उन्हें पछाड़ेगा और फिर न उठाएगा28:5 फिर न उठाएगा: परमेश्वर उन पर अनुग्रह नहीं करेगा, वह उन्हें समृद्धि प्रदान नहीं करेगा।।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यहोवा धन्य है;","poem":1},{"lineBreak":true},{"text":"क्योंकि उसने मेरी गिड़गिड़ाहट को सुना है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"यहोवा मेरा बल और मेरी ढाल है;","poem":1},{"lineBreak":true},{"text":"उस पर भरोसा रखने से मेरे मन को सहायता मिली है;","poem":1},{"lineBreak":true},{"text":"इसलिए मेरा हृदय प्रफुल्लित है;","poem":1},{"lineBreak":true},{"text":"और मैं गीत गाकर उसका धन्यवाद करूँगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यहोवा अपने लोगों की सामर्थ्य है,","poem":1},{"lineBreak":true},{"text":"वह अपने अभिषिक्त के लिये उद्धार का दृढ़ गढ़ है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे यहोवा अपनी प्रजा का उद्धार कर,","poem":1},{"lineBreak":true},{"text":"और अपने निज भाग के लोगों को आशीष दे;","poem":1},{"lineBreak":true},{"text":"और उनकी चरवाही कर और सदैव उन्हें सम्भाले रह।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}