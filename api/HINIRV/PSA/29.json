{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["परमेश्वर की आवाज"]},{"type":"hebrew_subtitle","content":["दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर के पुत्रों, यहोवा का,","poem":1},{"lineBreak":true},{"text":"हाँ, यहोवा ही का गुणानुवाद करो,","poem":1},{"lineBreak":true},{"text":"यहोवा की महिमा और सामर्थ्य को सराहो।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यहोवा के नाम की महिमा करो;","poem":1},{"lineBreak":true},{"text":"पवित्रता से शोभायमान होकर यहोवा को दण्डवत् करो।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी मेघों के ऊपर सुनाई देती है;","poem":1},{"lineBreak":true},{"text":"प्रतापी परमेश्वर गरजता है,","poem":1},{"lineBreak":true},{"text":"यहोवा घने मेघों के ऊपर रहता है। (अय्यू. 37:4,5)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी शक्तिशाली है,","poem":1},{"lineBreak":true},{"text":"यहोवा की वाणी प्रतापमय है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी देवदारों को तोड़ डालती है;","poem":1},{"lineBreak":true},{"text":"यहोवा लबानोन के देवदारों को भी तोड़ डालता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह लबानोन को बछड़े के समान","poem":1},{"lineBreak":true},{"text":"और सिर्योन को साँड़ के समान उछालता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी आग की लपटों को चीरती है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी वन को हिला देती है,","poem":1},{"lineBreak":true},{"text":"यहोवा कादेश के वन को भी कँपाता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"यहोवा की वाणी से हिरनियों का गर्भपात हो जाता है।","poem":1},{"lineBreak":true},{"text":"और जंगल में पतझड़ होता है;","poem":1},{"lineBreak":true},{"text":"और उसके मन्दिर में सब कोई","poem":1},{"lineBreak":true},{"text":"“महिमा ही महिमा” बोलते रहते है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जल-प्रलय के समय यहोवा विराजमान था;","poem":1},{"lineBreak":true},{"text":"और यहोवा सर्वदा के लिये राजा होकर","poem":1},{"lineBreak":true},{"text":"विराजमान रहता है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"यहोवा अपनी प्रजा को बल देगा;","poem":1},{"lineBreak":true},{"text":"यहोवा अपनी प्रजा को शान्ति की आशीष देगा29:11 यहोवा अपनी प्रजा को शान्ति की आशीष देगा: उन्हें आँधी और तूफान में किसी बात का डर न होगा, वे किसी बात से नहीं डरेंगे। वह उन्हें आँधी में शान्ति की आशीष देगा।।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}