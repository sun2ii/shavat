{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["परमेश्वर पर भरोसा"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये: तारवाले बाजों के साथ। दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे मेरे धर्ममय परमेश्वर, जब मैं पुकारूँ तब तू मुझे उत्तर दे;","poem":1},{"lineBreak":true},{"text":"जब मैं संकट में पड़ा तब तूने मुझे सहारा दिया।","poem":1},{"lineBreak":true},{"text":"मुझ पर अनुग्रह कर और मेरी प्रार्थना सुन ले।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे मनुष्यों, कब तक मेरी महिमा का अनादर होता रहेगा?","poem":1},{"lineBreak":true},{"text":"तुम कब तक व्यर्थ बातों से प्रीति रखोगे और झूठी युक्ति की खोज में रहोगे? (सेला)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यह जान रखो कि यहोवा ने भक्त को अपने लिये अलग कर रखा है4:3 यहोवा ने भक्त को अपने लिये अलग कर रखा है: अपने उद्देश्यों के निमित या अपनी योजना के लिए।;","poem":1},{"lineBreak":true},{"text":"जब मैं यहोवा को पुकारूँगा तब वह सुन लेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"काँपते रहो और पाप मत करो;","poem":1},{"lineBreak":true},{"text":"अपने-अपने बिछौने पर मन ही मन में ध्यान करो और चुपचाप रहो। (सेला) (इफि. 4:26)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"धार्मिकता के बलिदान चढ़ाओ,","poem":1},{"lineBreak":true},{"text":"और यहोवा पर भरोसा रखो।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"बहुत से हैं जो कहते हैं, “कौन हमको कुछ भलाई दिखाएगा?”","poem":1},{"lineBreak":true},{"text":"हे यहोवा, तू अपने मुख का प्रकाश हम पर चमका!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तूने मेरे मन में उससे कहीं अधिक आनन्द भर दिया है,","poem":1},{"lineBreak":true},{"text":"जो उनको अन्न और दाखमधु की बढ़ती से होता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं शान्ति से लेट जाऊँगा और सो जाऊँगा;","poem":1},{"lineBreak":true},{"text":"क्योंकि, हे यहोवा, केवल तू ही मुझ को निश्चिन्त रहने देता है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}