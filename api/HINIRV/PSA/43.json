{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["संकट के समय प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर, मेरा न्याय चुका43:1 मेरा न्याय चुका: दण्ड देने की बात नहीं है, मेरा मुकद्दमा लड़।","poem":1},{"lineBreak":true},{"text":"और विधर्मी जाति से मेरा मुकद्दमा लड़;","poem":1},{"lineBreak":true},{"text":"मुझ को छली और कुटिल पुरुष से बचा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्योंकि तू मेरा सामर्थी परमेश्वर है,","poem":1},{"lineBreak":true},{"text":"तूने क्यों मुझे त्याग दिया है?","poem":1},{"lineBreak":true},{"text":"मैं शत्रु के अत्याचार के मारे शोक का","poem":1},{"lineBreak":true},{"text":"पहरावा पहने हुए क्यों फिरता रहूँ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अपने प्रकाश और अपनी सच्चाई को भेज;","poem":1},{"lineBreak":true},{"text":"वे मेरी अगुआई करें,","poem":1},{"lineBreak":true},{"text":"वे ही मुझ को तेरे पवित्र पर्वत43:3 पवित्र पर्वत: सिय्योन पर्वत, जहाँ परमेश्वर की आराधना की जाती थी।","poem":1},{"lineBreak":true},{"text":"पर और तेरे निवास-स्थान में पहुँचाए!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तब मैं परमेश्वर की वेदी के पास जाऊँगा,","poem":1},{"lineBreak":true},{"text":"उस परमेश्वर के पास जो मेरे अति","poem":1},{"lineBreak":true},{"text":"आनन्द का कुण्ड है; और हे परमेश्वर,","poem":1},{"lineBreak":true},{"text":"हे मेरे परमेश्वर, मैं वीणा बजा-बजाकर तेरा धन्यवाद करूँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे मेरे प्राण तू क्यों गिरा जाता है?","poem":1},{"lineBreak":true},{"text":"तू अन्दर ही अन्दर क्यों व्याकुल है?","poem":1},{"lineBreak":true},{"text":"परमेश्वर पर आशा रख, क्योंकि वह मेरे मुख की चमक","poem":1},{"lineBreak":true},{"text":"और मेरा परमेश्वर है; मैं फिर उसका धन्यवाद करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}