{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["परमेश्वर हमारा राजा"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये कोरहवंशियों का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे देश-देश के सब लोगों, तालियाँ बजाओ!","poem":1},{"lineBreak":true},{"text":"ऊँचे शब्द से परमेश्वर के लिये जयजयकार करो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्योंकि यहोवा परमप्रधान और भययोग्य है,","poem":1},{"lineBreak":true},{"text":"वह सारी पृथ्वी के ऊपर महाराजा है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह देश-देश के लोगों को हमारे सम्मुख","poem":1},{"lineBreak":true},{"text":"नीचा करता,","poem":1},{"lineBreak":true},{"text":"और जाति-जाति को हमारे पाँवों के नीचे कर","poem":1},{"lineBreak":true},{"text":"देता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह हमारे लिये उत्तम भाग चुन लेगा47:4 वह हमारे लिये उत्तम भाग चुन लेगा: उसने चुनकर उस भूमि को निश्चित कर लिया जिसे हम विरासत में पाएँगे। उसने संसार के सब देशों में से इसे चुना है कि वह उसके लोगों की विरासत हो।,","poem":1},{"lineBreak":true},{"text":"जो उसके प्रिय याकूब के घमण्ड का कारण है। (सेला)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वर जयजयकार सहित,","poem":1},{"lineBreak":true},{"text":"यहोवा नरसिंगे के शब्द के साथ ऊपर गया है। (लूका 24:51, यूह. 6:62, प्रेरि. 1:9, भज. 68:1,2)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वर का भजन गाओ, भजन गाओ!","poem":1},{"lineBreak":true},{"text":"हमारे महाराजा का भजन गाओ, भजन गाओ!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्योंकि परमेश्वर सारी पृथ्वी का महाराजा है;","poem":1},{"lineBreak":true},{"text":"समझ बूझकर बुद्धि से भजन गाओ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वर जाति-जाति पर राज्य करता है;","poem":1},{"lineBreak":true},{"text":"परमेश्वर अपने पवित्र सिंहासन पर","poem":1},{"lineBreak":true},{"text":"विराजमान है47:8 परमेश्वर अपने पवित्र सिंहासन पर विराजमान है: उसके पवित्र सिंहासन पर अर्थात् उसका राज्य पवित्रता और न्याय का है।। (भज. 96:10, प्रका. 19:6)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"राज्य-राज्य के रईस अब्राहम के परमेश्वर","poem":1},{"lineBreak":true},{"text":"की प्रजा होने के लिये इकट्ठे हुए हैं।","poem":1},{"lineBreak":true},{"text":"क्योंकि पृथ्वी की ढालें परमेश्वर के वश में हैं,","poem":1},{"lineBreak":true},{"text":"वह तो शिरोमणि है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}