{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["मनुष्य की मूर्खता और दुष्टता"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये महलत की राग पर दाऊद का मश्कील"]},{"type":"verse","number":1,"content":[{"text":"मूर्ख ने अपने मन में कहा, “कोई परमेश्वर है ही नहीं।”","poem":1},{"lineBreak":true},{"text":"वे बिगड़ गए, उन्होंने कुटिलता के घिनौने काम किए हैं;","poem":1},{"lineBreak":true},{"text":"कोई सुकर्मी नहीं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वर ने स्वर्ग पर से मनुष्यों के ऊपर दृष्टि की","poem":1},{"lineBreak":true},{"text":"ताकि देखे कि कोई बुद्धि से चलनेवाला","poem":1},{"lineBreak":true},{"text":"या परमेश्वर को खोजनेवाला है कि नहीं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वे सब के सब हट गए; सब एक साथ बिगड़ गए;","poem":1},{"lineBreak":true},{"text":"कोई सुकर्मी नहीं, एक भी नहीं। (भज. 14:1-3, रोम. 3:10-12)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्या उन सब अनर्थकारियों को कुछ भी ज्ञान नहीं,","poem":1},{"lineBreak":true},{"text":"जो मेरे लोगों को रोटी के समान खाते है","poem":1},{"lineBreak":true},{"text":"पर परमेश्वर का नाम नहीं लेते है?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वहाँ उन पर भय छा गया जहाँ भय का कोई कारण न था।","poem":1},{"lineBreak":true},{"text":"क्योंकि यहोवा ने उनकी हड्डियों को, जो तेरे विरुद्ध छावनी डाले पड़े थे, तितर-बितर कर दिया;","poem":1},{"lineBreak":true},{"text":"तूने तो उन्हें लज्जित कर दिया53:5 तो उन्हें लज्जित कर दिया: अर्थात्, वे पराजय के कारण, अपने प्रयासों में सफल न होने के कारण लज्जित हो गए। इसलिए कि","poem":1},{"lineBreak":true},{"text":"परमेश्वर ने उनको त्याग दिया है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"भला होता कि इस्राएल का पूरा उद्धार सिय्योन से निकलता!","poem":1},{"lineBreak":true},{"text":"जब परमेश्वर अपनी प्रजा को बन्धुवाई से लौटा ले आएगा।","poem":1},{"lineBreak":true},{"text":"तब याकूब मगन और इस्राएल आनन्दित होगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}