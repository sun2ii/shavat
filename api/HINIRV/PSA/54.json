{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["उद्धार के लिये प्रार्थना"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये, दाऊद का तारकले बाजों के साथ मश्कील जब जीपियों ने आकर शाऊल से कहा, “क्या दाऊद हमारे बीच में छिपा नहीं रहता?”"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर अपने नाम के द्वारा मेरा उद्धार कर54:1 हे परमेश्वर अपने नाम के द्वारा मेरा उद्धार कर: अर्थात् अपने सामर्थ्य द्वारा दोषमार्जन कर या मुझे बचा ले।,","poem":1},{"lineBreak":true},{"text":"और अपने पराक्रम से मेरा न्याय कर।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे परमेश्वर, मेरी प्रार्थना सुन ले;","poem":1},{"lineBreak":true},{"text":"मेरे मुँह के वचनों की ओर कान लगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्योंकि परदेशी मेरे विरुद्ध उठे हैं,","poem":1},{"lineBreak":true},{"text":"और कुकर्मी मेरे प्राण के गाहक हुए हैं;","poem":1},{"lineBreak":true},{"text":"उन्होंने परमेश्वर को अपने सम्मुख नहीं जाना। (सेला)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"देखो, परमेश्वर मेरा सहायक है;","poem":1},{"lineBreak":true},{"text":"प्रभु मेरे प्राण को सम्भालनेवाला है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह मेरे द्रोहियों की बुराई को उन्हीं पर लौटा देगा;","poem":1},{"lineBreak":true},{"text":"हे परमेश्वर, अपनी सच्चाई के कारण उनका विनाश कर।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं तुझे स्वेच्छाबलि चढ़ाऊँगा54:6 मैं तुझे स्वेच्छाबलि चढ़ाऊँगा: अर्थात् वह अपनी मुक्त इच्छा से, बिना दबाव और बिना अनिवार्यता के बलि चढ़ाएगा।;","poem":1},{"lineBreak":true},{"text":"हे यहोवा, मैं तेरे नाम का धन्यवाद करूँगा,","poem":1},{"lineBreak":true},{"text":"क्योंकि यह उत्तम है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्योंकि तूने मुझे सब दुःखों से छुड़ाया है,","poem":1},{"lineBreak":true},{"text":"और मैंने अपने शत्रुओं पर विजयपूर्ण दृष्टि डाली है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}