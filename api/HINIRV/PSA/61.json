{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["रक्षा के लिये प्रार्थना"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये तारवाले बाजे के साथ दाऊद का भजन"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर, मेरा चिल्लाना सुन,","poem":1},{"lineBreak":true},{"text":"मेरी प्रार्थना की ओर ध्यान दे।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मूर्छा खाते समय मैं पृथ्वी की छोर से भी तुझे पुकारूँगा,","poem":1},{"lineBreak":true},{"text":"जो चट्टान मेरे लिये ऊँची है, उस पर मुझ को ले चल61:2 जो चट्टान मेरे लिये ऊँची है, उस पर मुझ को ले चल: ऐसे शरणस्थान पर, किसी दृढ़ गढ़ में जहाँ मैं सुरक्षित रहूँ।;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्योंकि तू मेरा शरणस्थान है,","poem":1},{"lineBreak":true},{"text":"और शत्रु से बचने के लिये ऊँचा गढ़ है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं तेरे तम्बू में युगानुयुग बना रहूँगा।","poem":1},{"lineBreak":true},{"text":"मैं तेरे पंखों की ओट में शरण लिए रहूँगा। (सेला)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्योंकि हे परमेश्वर, तूने मेरी मन्नतें सुनीं,","poem":1},{"lineBreak":true},{"text":"जो तेरे नाम के डरवैये हैं, उनका सा भाग तूने मुझे दिया है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तू राजा की आयु को बहुत बढ़ाएगा;","poem":1},{"lineBreak":true},{"text":"उसके वर्ष पीढ़ी-पीढ़ी के बराबर होंगे।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह परमेश्वर के सम्मुख सदा बना रहेगा;","poem":1},{"lineBreak":true},{"text":"तू अपनी करुणा और सच्चाई को उसकी रक्षा के लिये ठहरा रख।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"इस प्रकार मैं सर्वदा तेरे नाम का भजन गा गाकर","poem":1},{"lineBreak":true},{"text":"अपनी मन्नतें हर दिन पूरी किया करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}