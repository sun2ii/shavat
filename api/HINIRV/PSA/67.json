{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["धन्यवाद का भजन"]},{"type":"hebrew_subtitle","content":["प्रधान बजानेवाले के लिये तारवाले बाजों के साथ भजन, गीत"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर हम पर अनुग्रह करे और हमको आशीष दे;","poem":1},{"lineBreak":true},{"text":"वह हम पर अपने मुख का प्रकाश चमकाए, (सेला)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जिससे तेरी गति पृथ्वी पर,","poem":1},{"lineBreak":true},{"text":"और तेरा किया हुआ उद्धार सारी जातियों में जाना जाए। (लूका 2:30,31, तीतु. 2:11)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वर, देश-देश के लोग तेरा धन्यवाद करें;","poem":1},{"lineBreak":true},{"text":"देश-देश के सब लोग तेरा धन्यवाद करें।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"राज्य-राज्य के लोग आनन्द करें,","poem":1},{"lineBreak":true},{"text":"और जयजयकार करें,","poem":1},{"lineBreak":true},{"text":"क्योंकि तू देश-देश के लोगों का न्याय धर्म से करेगा,","poem":1},{"lineBreak":true},{"text":"और पृथ्वी के राज्य-राज्य के लोगों की अगुआई करेगा67:4 पृथ्वी के राज्य-राज्य के लोगों की अगुआई करेगा: अर्थात् परमेश्वर उन्हें निर्देश देगा कि उन्हें क्या करना है। परमेश्वर उन्हें समृद्धि, आनन्द और उद्धार के मार्ग में लेकर चलेगा।। (सेला)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे परमेश्वर, देश-देश के लोग तेरा धन्यवाद करें;","poem":1},{"lineBreak":true},{"text":"देश-देश के सब लोग तेरा धन्यवाद करें।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"भूमि ने अपनी उपज दी है,","poem":1},{"lineBreak":true},{"text":"परमेश्वर जो हमारा परमेश्वर है, उसने हमें आशीष दी है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"परमेश्वर हमको आशीष देगा;","poem":1},{"lineBreak":true},{"text":"और पृथ्वी के दूर-दूर देशों के सब लोग उसका भय मानेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}