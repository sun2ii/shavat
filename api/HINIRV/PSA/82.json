{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["सच्चे न्याय के लिए विनती"]},{"type":"hebrew_subtitle","content":["आसाप का भजन"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर दिव्य सभा में खड़ा है:","poem":1},{"lineBreak":true},{"text":"वह ईश्वरों के बीच में न्याय करता है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“तुम लोग कब तक टेढ़ा न्याय करते","poem":1},{"lineBreak":true},{"text":"और दुष्टों का पक्ष लेते रहोगे82:2 दुष्टों का पक्ष लेते रहोगे: अर्थात् दुष्टों का साथ देना और उन्हीं का पक्ष पोषण करना। अर्थात् दुष्टों का साथ देना और उन्हीं का पक्ष पोषण करना।? (सेला)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कंगाल और अनाथों का न्याय चुकाओ,","poem":1},{"lineBreak":true},{"text":"दीन-दरिद्र का विचार धर्म से करो।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कंगाल और निर्धन को बचा लो;","poem":1},{"lineBreak":true},{"text":"दुष्टों के हाथ से उन्हें छुड़ाओ।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वे न तो कुछ समझते और न कुछ जानते हैं,","poem":1},{"lineBreak":true},{"text":"परन्तु अंधेरे में चलते फिरते रहते हैं82:5 परन्तु अंधेरे में चलते फिरते रहते हैं: विधान के अज्ञान में और वस्तु तथा स्थिति के तथ्यों से अज्ञान।;","poem":1},{"lineBreak":true},{"text":"पृथ्वी की पूरी नींव हिल जाती है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैंने कहा था “तुम ईश्वर हो,","poem":1},{"lineBreak":true},{"text":"और सब के सब परमप्रधान के पुत्र हो; (यूह. 10:34)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो भी तुम मनुष्यों के समान मरोगे,","poem":1},{"lineBreak":true},{"text":"और किसी प्रधान के समान गिर जाओगे।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे परमेश्वर उठ, पृथ्वी का न्याय कर;","poem":1},{"lineBreak":true},{"text":"क्योंकि तू ही सब जातियों को अपने भाग में लेगा!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}