{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["परमेश्वर का नगर सिय्योन की स्तुति में"]},{"type":"hebrew_subtitle","content":["कोरहवंशियों का भजन"]},{"type":"verse","number":1,"content":[{"text":"उसकी नींव पवित्र पर्वतों में है;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"और यहोवा सिय्योन के फाटकों से याकूब के सारे निवासों से बढ़कर प्रीति रखता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वर के नगर,","poem":1},{"lineBreak":true},{"text":"तेरे विषय महिमा की बातें कही गई हैं। (सेला)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं अपने जान-पहचानवालों से रहब और बाबेल की भी चर्चा करूँगा;","poem":1},{"lineBreak":true},{"text":"पलिश्त, सोर और कूश को देखो:","poem":1},{"lineBreak":true},{"text":"“यह वहाँ उत्पन्न हुआ था87:4 यह वहाँ उत्पन्न हुआ था: मनुष्यों के लिए कहा जाएगा कि वे उनमें से किसी एक स्थान में जन्मे थे और उनमें से किसी भी स्थान में जन्म लेना सम्मान की बात मानी जाएगी।।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"और सिय्योन के विषय में यह कहा जाएगा,","poem":1},{"lineBreak":true},{"text":"“इनमें से प्रत्येक का जन्म उसमें हुआ था।”","poem":1},{"lineBreak":true},{"text":"और परमप्रधान आप ही उसको स्थिर रखे।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यहोवा जब देश-देश के लोगों के नाम लिखकर गिन लेगा, तब यह कहेगा,","poem":1},{"lineBreak":true},{"text":"“यह वहाँ उत्पन्न हुआ था।” (सेला)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गवैये और नृतक दोनों कहेंगे,","poem":1},{"lineBreak":true},{"text":"“हमारे सब सोते तुझी में पाए जाते हैं।”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}