{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["परमेश्वर के राज्य की महिमा"]},{"type":"verse","number":1,"content":[{"text":"यहोवा राजा है; उसने माहात्म्य का पहरावा पहना है;","poem":1},{"lineBreak":true},{"text":"यहोवा पहरावा पहने हुए, और सामर्थ्य का फेटा बाँधे है।","poem":1},{"lineBreak":true},{"text":"इस कारण जगत स्थिर है, वह नहीं टलने का।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे यहोवा, तेरी राजगद्दी अनादिकाल से स्थिर है,","poem":1},{"lineBreak":true},{"text":"तू सर्वदा से है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे यहोवा, महानदों का कोलाहल हो रहा है93:3 महानदों का कोलाहल हो रहा है: यहाँ किसी आपदा या संकट की ओर संकेत है जो अपनी शक्ति और उग्रता सब कुछ नष्ट कर देगा। उसकी तुलना समुद्र की प्रचण्ड लहरों से की गई है।,","poem":1},{"lineBreak":true},{"text":"महानदों का बड़ा शब्द हो रहा है,","poem":1},{"lineBreak":true},{"text":"महानद गरजते हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"महासागर के शब्द से,","poem":1},{"lineBreak":true},{"text":"और समुद्र की महातरंगों से,","poem":1},{"lineBreak":true},{"text":"विराजमान यहोवा अधिक महान है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तेरी चितौनियाँ अति विश्वासयोग्य हैं;","poem":1},{"lineBreak":true},{"text":"हे यहोवा, तेरे भवन को युग-युग पवित्रता ही शोभा देती है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}