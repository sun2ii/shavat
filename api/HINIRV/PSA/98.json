{"translation":{"id":"HINIRV","name":"इंडियन रिवाइज्ड वर्जन","website":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hin2017","licenseNotes":null,"shortName":"IRV","englishName":"Hindi Indian Revised Version Bible","language":"hin","textDirection":"ltr","sha256":"2d09e486868a1e8ee040fb6eb4a6f2e54f79616ffbd54a94f251e5b717306d19","availableFormats":["json"],"listOfBooksApiLink":"/api/HINIRV/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"HINIRV","name":"भजन संहिता","commonName":"भजन संहिता","title":"भजन संहिता","order":19,"numberOfChapters":150,"sha256":"57f9c610346a9245c4a797b348cb444954e89fe79c4876ea5ef5f614b4fcc7b0","firstChapterNumber":1,"firstChapterApiLink":"/api/HINIRV/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/HINIRV/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["उद्धार और न्याय के लिये स्तुतिगान"]},{"type":"hebrew_subtitle","content":["भजन"]},{"type":"verse","number":1,"content":[{"text":"यहोवा के लिये एक नया गीत गाओ,","poem":1},{"lineBreak":true},{"text":"क्योंकि उसने आश्‍चर्यकर्म किए हैं!","poem":1},{"lineBreak":true},{"text":"उसके दाहिने हाथ और पवित्र भुजा ने उसके लिये उद्धार किया है!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यहोवा ने अपना किया हुआ उद्धार प्रकाशित किया,","poem":1},{"lineBreak":true},{"text":"उसने अन्यजातियों की दृष्टि में अपना धर्म प्रगट किया है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसने इस्राएल के घराने पर की अपनी करुणा","poem":1},{"lineBreak":true},{"text":"और सच्चाई की सुधि ली,","poem":1},{"lineBreak":true},{"text":"और पृथ्वी के सब दूर-दूर देशों ने हमारे परमेश्वर का किया हुआ उद्धार देखा है। (लूका 1:54, प्रेरि. 28:28)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे सारी पृथ्वी98:4 सारी पृथ्वी: यह घटना इतनी महत्त्वपूर्ण है कि सब जातियाँ उत्सव मनाएँ। यह विश्वव्यापी उल्लास एवं आनन्द का विषय है। के लोगों, यहोवा का जयजयकार करो;","poem":1},{"lineBreak":true},{"text":"उत्साहपूर्वक जयजयकार करो, और भजन गाओ! (यशा. 44:23)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वीणा बजाकर यहोवा का भजन गाओ,","poem":1},{"lineBreak":true},{"text":"वीणा बजाकर भजन का स्वर सुनाओ।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुरहियां और नरसिंगे फूँक फूँककर","poem":1},{"lineBreak":true},{"text":"यहोवा राजा का जयजयकार करो।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"समुद्र और उसमें की सब वस्तुएँ गरज उठें;","poem":1},{"lineBreak":true},{"text":"जगत और उसके निवासी महाशब्द करें!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"नदियाँ तालियाँ बजाएँ;","poem":1},{"lineBreak":true},{"text":"पहाड़ मिलकर जयजयकार करें।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"यह यहोवा के सामने हो, क्योंकि वह पृथ्वी का न्याय करने को आनेवाला है।","poem":1},{"lineBreak":true},{"text":"वह धर्म से जगत का,","poem":1},{"lineBreak":true},{"text":"और सच्चाई से देश-देश के लोगों का न्याय करेगा। (प्रेरि. 17:31)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/HINIRV/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/HINIRV/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/HINIRV/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}