{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"JHN","translationId":"acu_tbl","name":"Juan","commonName":"Juan","title":"Yamaram Chicham Juanku Aarmauri","order":43,"numberOfChapters":21,"sha256":"73b296c035baaa345445af924a8dba936cc8fd3133197b6140412f82101f2269","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/acu_tbl/JHN/21.json","totalNumberOfVerses":864},"chapter":{"number":17,"content":[{"type":"heading","content":["Jesús ni nuiniatiri ainaun pachis Yusen seamuri"]},{"type":"verse","number":1,"content":["Nunia Jesús chichas umis, nayaimpinmanini pangkai jiimias Yusen seak:",{"text":"“Apaachiru, yamaikia wína kintarka jeayi.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ami uchiram asan,","poem":1},{"lineBreak":true},{"text":"ami kakarmarmin inakmastasan wakerau asamtai,","poem":1},{"lineBreak":true},{"text":"amesha kakarmaram inakmasta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura wína aintsur ame surusume nuka","poem":1},{"lineBreak":true},{"text":"pujut nangkankashtinun jukiarat tusam,","poem":1},{"lineBreak":true},{"text":"ameka mash aints inarta tusam,","poem":1},{"lineBreak":true},{"text":"kakarmaram surusuitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apaachiru, ameketme Yusem.","poem":1},{"lineBreak":true},{"text":"Chikich Yuska pengké atsawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai aints ainau aminak:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tusar, tura winasha: Jesucristoka Yus akupkamuitai turutinau asar,","poem":1},{"lineBreak":true},{"text":"pujut nangkankashtinun jukiartin ainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wikia ju nungkanam pujusan,","poem":1},{"lineBreak":true},{"text":"ame turata turutmiame nunaka mash umikuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asan amin pengker awajnuyajme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura asamtai Apaachiru,","poem":1},{"lineBreak":true},{"text":"yaanchuik nungka najanchamning wi amijai pujamtai,","poem":1},{"lineBreak":true},{"text":"pengker awajtinuyame nunismek yamaisha pengker awajtusta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ame ju nungkanmaya ainau","poem":1},{"lineBreak":true},{"text":"wina surusmiame nunaka","poem":1},{"lineBreak":true},{"text":"ami naarmin pachisan","poem":1},{"lineBreak":true},{"text":"tenapkesan nekamtikiamu asar","poem":1},{"lineBreak":true},{"text":"aminu ainawai. Tura aminu asaramtai","poem":1},{"lineBreak":true},{"text":"aminu aarti tusam surusuitme.","poem":1},{"lineBreak":true},{"text":"Turamu asar ami chichamin umirtamin ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ame wína chichamur etserkata tusam akuptukmiame nunaka miatrusnak umikuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai jusha wína chichamrun antukar jukiarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura asar nekasampi Yus akupkamuitme tinawai.","poem":1},{"lineBreak":true},{"text":"Tura wína chichamrun","poem":1},{"lineBreak":true},{"text":"nekas aminuitai tusar nekainawai. Tuminau asar,","poem":1},{"lineBreak":true},{"text":"ame surusmau ainauka","poem":1},{"lineBreak":true},{"text":"mash ninu ainiaji tusar nekainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aminu asaramtai,","poem":1},{"lineBreak":true},{"text":"juna pachisan seatjame.","poem":1},{"lineBreak":true},{"text":"Ju nungkanmaya ainau aminuchu asaramtai,","poem":1},{"lineBreak":true},{"text":"nuna pachisnaka seatsjame. Antsu wína surusmiame juka aminu asaramtai,","poem":1},{"lineBreak":true},{"text":"juna pachisan seatjame.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mash aminu aa nuka winaruitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wína aintsur ainauka aminu ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asar winaka:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tusar","poem":1},{"lineBreak":true},{"text":"pengker awajtinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wikia yamaikia amin winitin asan,","poem":1},{"lineBreak":true},{"text":"ju nungkanmaka pujuschatatjai. Antsu ju ainauka juni tuke juwakartatui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Apaachiru,","poem":1},{"lineBreak":true},{"text":"nekas pengker asam,","poem":1},{"lineBreak":true},{"text":"wisha amijai kichik ajina nunisrik, jusha mash iruntrar kichkia nunisarang arti tusan,","poem":1},{"lineBreak":true},{"text":"ami kakarmarmijai ame surusmau ainauka wainkata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wikia ju nungkanam pujusan,","poem":1},{"lineBreak":true},{"text":"wína aintsur ainaunka ame surusmiame junaka ami kakarmarmijai mash pengker wainuyajai.","poem":1},{"lineBreak":true},{"text":"Tura asan, kichkisha mengkakchajai.","poem":1},{"lineBreak":true},{"text":"Antsu ami chichamim yaanchuik aarmau aa nuna umiktas,","poem":1},{"lineBreak":true},{"text":"kichik aints tuke mengkakatin asa,","poem":1},{"lineBreak":true},{"text":"ningki wakerak mengkakawaitai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yamaikia ame pujamunam winitatjai.","poem":1},{"lineBreak":true},{"text":"Tura juni pujusan","poem":1},{"lineBreak":true},{"text":"wi waraaja nunisarang","poem":1},{"lineBreak":true},{"text":"wína aintsur ainausha warasarti tusan seajme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wína aintsur ainaun","poem":1},{"lineBreak":true},{"text":"ami chichamin ujayajai. Wikia ju nungkanmayanchuitjai.","poem":1},{"lineBreak":true},{"text":"Tura jusha nunisarang ju nungkanmayanchu asaramtai,","poem":1},{"lineBreak":true},{"text":"ju nungkanmaya pasé aints ainau","poem":1},{"lineBreak":true},{"text":"junaka nakitin ainawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tura wainiatnak","poem":1},{"lineBreak":true},{"text":"yamaikia ju nungkanmaya jiikiarta tusanka seatsjame.","poem":1},{"lineBreak":true},{"text":"Antsu Satanás ju aints ainau nepetkai tusam,","poem":1},{"lineBreak":true},{"text":"ayamrukta tusan seajme.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wisha ju nungkanam","poem":1},{"lineBreak":true},{"text":"tuke pujuschatin asamtai,","poem":1},{"lineBreak":true},{"text":"jusha nunisarang ju nungkanmaka","poem":1},{"lineBreak":true},{"text":"tuke pujuschartin ainawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ami chichamim nekas aa nujai ami aintsrum pengker awajsata.","poem":1},{"lineBreak":true},{"text":"Ame chichameka nekasaintai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ame junia aints ainamunam","poem":1},{"lineBreak":true},{"text":"wína akuptukmiame nunisnak","poem":1},{"lineBreak":true},{"text":"wisha junia aints ainamunam","poem":1},{"lineBreak":true},{"text":"niincha akupinajai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aminu aintsrum asar,","poem":1},{"lineBreak":true},{"text":"tuke inaitsuk ami wakeramurmin najanawarti tusan,","poem":1},{"lineBreak":true},{"text":"nu aints ainauncha pengker awajsatasan","poem":1},{"lineBreak":true},{"text":"ami wakeramurmin tuke najanin ajai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Juni wijai iruntrar pujuina","poem":1},{"lineBreak":true},{"text":"nunak pachisnaka seatsjame.","poem":1},{"lineBreak":true},{"text":"Antsu ukunam ju aints ainau chichamen antukar:","poem":1},{"lineBreak":true},{"text":"Wína nekasampita turutiartin ainaun","poem":1},{"lineBreak":true},{"text":"nunasha pachisan amin seajme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ameka Apaachiru wína pujurtame.","poem":1},{"lineBreak":true},{"text":"Tura wisha amin pujaja nunisarang niisha iijai pujusarti tusan seajme.","poem":1},{"lineBreak":true},{"text":"Tura mash iruntrar kichkia nunisarang nintimsar pujuinamtai,","poem":1},{"lineBreak":true},{"text":"ju nungkanmaya ainau nuna wainkar,","poem":1},{"lineBreak":true},{"text":"nekasar wína pachitsar:","poem":1},{"lineBreak":true},{"text":"Nekasampi Yus akupkamuita","poem":1},{"lineBreak":true},{"text":"turutiarat tusan seajme.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ame wijai kichkia nunisrik pujaji nunisarang niisha pujusarti tusam,","poem":1},{"lineBreak":true},{"text":"wína pengker awajtusume. Tura asakmin wisha nunisnak","poem":1},{"lineBreak":true},{"text":"niincha pengker awajinajai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Amesha wini pujurtakmin,","poem":1},{"lineBreak":true},{"text":"wisha ni nintin engkemau asamtai,","poem":1},{"lineBreak":true},{"text":"pengké kichkia nunisarang pujusarti tusan seajme.","poem":1},{"lineBreak":true},{"text":"Tura tu pujuinamtai,","poem":1},{"lineBreak":true},{"text":"ju nungkanmaya ainau","poem":1},{"lineBreak":true},{"text":"nuna wainkar wína pachitsar:","poem":1},{"lineBreak":true},{"text":"Nekasampi Yus akupkamuita tusar nekaawarti.","poem":1},{"lineBreak":true},{"text":"Tura amin pachitmasar:","poem":1},{"lineBreak":true},{"text":"Ni Uchirin aneawa nunisang","poem":1},{"lineBreak":true},{"text":"ni aintsri ainauncha aneawai","poem":1},{"lineBreak":true},{"text":"tusar nekarawarti tusan seajme.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Apaachiru, ameka nungkaka najantsuk winaka tuke anentin asam,","poem":1},{"lineBreak":true},{"text":"aints wína surusmiame nuka","poem":1},{"lineBreak":true},{"text":"mash wainkata turutin asakmin,","poem":1},{"lineBreak":true},{"text":"wína kakarmarsha ame surusmiame nunaka","poem":1},{"lineBreak":true},{"text":"niisha wainkarti tusan wakerajai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apaachiru, nekasam pengkeraitme.","poem":1},{"lineBreak":true},{"text":"Ju nungkanmaya ainauka","poem":1},{"lineBreak":true},{"text":"amin nekarminachu wainiatnak","poem":1},{"lineBreak":true},{"text":"wikia wainjame. Tura ame wína surusmiame nusha","poem":1},{"lineBreak":true},{"text":"mash wína pachitsar: Ameka Yus akupkamuitme tusar nekarinawai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wikia ni nintin pujamtai,","poem":1},{"lineBreak":true},{"text":"ameka tuke wína anenme nunisarang niisha aneniarti tusan,","poem":1},{"lineBreak":true},{"text":"wína aintsur ainaun","poem":1},{"lineBreak":true},{"text":"ami naarmin pachisan nekamtiknuyaja nunaka tuke nekamtikiatatjai”,","poem":1},{"lineBreak":true},{"text":"Jesús Yusen seak timiayi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/JHN/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/JHN/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/JHN/16.json","previousChapterAudioLinks":{},"numberOfVerses":25}