{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":1,"content":[{"type":"heading","content":["Nekas Pengker Warastin"]},{"type":"verse","number":1,"content":[{"text":"Aintsti Yus nintimsar pujuinautikia","poem":1},{"lineBreak":true},{"text":"pasé aints ainau pachiachu asar,","poem":1},{"lineBreak":true},{"text":"nekasar pengker nintimsar warastinuitji.","poem":1},{"lineBreak":true},{"text":"Tura tunau aints wekajina nuni wekaichau asar,","poem":1},{"lineBreak":true},{"text":"nekasar pengker nintimsar warastinuitji.","poem":1},{"lineBreak":true},{"text":"Tura Yusen umirchau ainauka wishikiartin asaramtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainaujai iruntsuk pujuinau asar,","poem":1},{"lineBreak":true},{"text":"nekasar pengker nintimsar warastinuitji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yus nintimsar pujuinautikia","poem":1},{"lineBreak":true},{"text":"Yuse chichame aneau asar,","poem":1},{"lineBreak":true},{"text":"tsawaisha tura kashisha nuke nintimsar pujustinuitji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tu pujakrikia numi entsa yantamen araamua nunisketji.","poem":1},{"lineBreak":true},{"text":"Nu numi neretiri jeamtaikia","poem":1},{"lineBreak":true},{"text":"nukap nerektinuitai.","poem":1},{"lineBreak":true},{"text":"Tura nukésha minarchartinuitai.","poem":1},{"lineBreak":true},{"text":"Tu pujakrikia nekasar pengker aa nu turuatnuitji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antsu Yusen nintimchau ainauka tuuka pujuinatsui.","poem":1},{"lineBreak":true},{"text":"Nuka nase trigo saapen juwawa nunisarang","poem":1},{"lineBreak":true},{"text":"mengkakartin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura asar Yusen umirchau ainauka","poem":1},{"lineBreak":true},{"text":"Yuse umirin ainaujaingkia","poem":1},{"lineBreak":true},{"text":"nayaimpinmaka iruntrachartinuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Antsu ii Apuri ni umirin ainautinka mash nekarmaji.","poem":1},{"lineBreak":true},{"text":"Antsu Yusen nintimchau ainauka mengkaakartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/JOB/1.json","previousChapterAudioLinks":{},"numberOfVerses":6}