{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":10,"content":[{"type":"heading","content":["Apuru ¿waruka timiá aráksha pujame?"]},{"type":"verse","number":1,"content":[{"text":"Apuru ¿waruka timiá aráksha pujame? ¿Wi wait wajaisha waruka anumkamsha pujame?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Pasé aints ainau:","poem":1},{"lineBreak":true},{"text":"Wikia miajuitjai tusar,","poem":1},{"lineBreak":true},{"text":"mianchau ainaun kajerinak waitkinawai.","poem":1},{"lineBreak":true},{"text":"Tura ejatkan ningki puusar napinawa nunisarang ainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pasé aints ainauka ningki nintimsar:","poem":1},{"lineBreak":true},{"text":"Wi wakeraknaka wina wakeramurun pachitsuk turamnawaitjai tinawai.","poem":1},{"lineBreak":true},{"text":"Tu nintiminauka Yusen nakitinau asar,","poem":1},{"lineBreak":true},{"text":"niin pachisar pasé chichainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura meemasar pajakiar chichainak:","poem":1},{"lineBreak":true},{"text":"Yuska atsawai.","poem":1},{"lineBreak":true},{"text":"Turasha ameka waruka aitkame turutinka atsawai,","poem":1},{"lineBreak":true},{"text":"tu nintiminawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tu nintiminauka tuke ni takatrin takakminau asar yuumatsuk pujuinawai.","poem":1},{"lineBreak":true},{"text":"Tura ningki nintimsar:","poem":1},{"lineBreak":true},{"text":"Wait wajaktinnasha Yuska suruschatatui,","poem":1},{"lineBreak":true},{"text":"nangkamiar tinawai.","poem":1},{"lineBreak":true},{"text":"Nuniasha ni nemase ainaun pachisar wishikinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura ningki nintimtumasar:","poem":1},{"lineBreak":true},{"text":"“Wina nemasur ainauka ujuntrarchatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai itiurkachminumka pengké pujuschatatjai”,","poem":1},{"lineBreak":true},{"text":"tinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke inaitsuk chikich ainaun jiyainak pasé chicharin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura waitrinak chikich ainaun pasé awajsartas anangkinak chichainawai.","poem":1},{"lineBreak":true},{"text":"Tu chichainau asar chikich ainaun waitkinak pasé awajinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nu pasé aints ainauka ayamrumichun nangkamiar maawartas anumkar,","poem":1},{"lineBreak":true},{"text":"yaktanmaya jiinkiti tusar nakainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Juun yawaa kuntinun esai yuwatas waanam nakawa nunisang mangkartin anumak aints mianchaun nakawai.","poem":1},{"lineBreak":true},{"text":"Tura wainak aneachmau nu aintsun achik japiki juwawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Juun yawaa tsekengtias kaemua nunisang mangkartin aints ayamrumichun achiawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pasé aints ainauka:","poem":1},{"lineBreak":true},{"text":"Yuska iinka nintimturmatsji.","poem":1},{"lineBreak":true},{"text":"Tura ni yapiin nukuku asa pengké wainmatsui,","poem":1},{"lineBreak":true},{"text":"tu nintiminawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apuru wajakim uwejem yakí takuim ami aintsrum ainau ayamrukta.","poem":1},{"lineBreak":true},{"text":"Tura aints wait wajainauka kajinmakiip.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yusru ¿warukaya pasé aints ainau amin pachitmasar pasé chichainawa?","poem":1},{"lineBreak":true},{"text":"¿Waruka ningki nintimsar:","poem":1},{"lineBreak":true},{"text":"Yuska pachitmatsji tumaminawa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Antsu ameka nu aints ainau pasé turamuri wainkau asam,","poem":1},{"lineBreak":true},{"text":"nekasam ni wait wajaktintri suwitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin ayamrumichu ainauka aminak eatminawai.","poem":1},{"lineBreak":true},{"text":"Tura mitaik ainau yainmeka ametme.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ame pasé aints ainau kakarmari nepetkata.","poem":1},{"lineBreak":true},{"text":"Tura ni anumkar tunau turamurin pachisar mash uutsuk ujatkarti tusam chicharkata.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apuru ii Yusri asam,","poem":1},{"lineBreak":true},{"text":"aints ainautin tuke inakratnuitme.","poem":1},{"lineBreak":true},{"text":"Tura asam amin umirtamkacharu ainau tuke ninu nungkarinia jiiktinuitme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apuru mianchau ainau seamuri antu weame.","poem":1},{"lineBreak":true},{"text":"Tura ni untsumauri antukam,","poem":1},{"lineBreak":true},{"text":"pengker nintimtakum yayaame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apuru mitaik wait wajainausha ayamrukta.","poem":1},{"lineBreak":true},{"text":"Tura aints ainau nungka najanamu asaramtai,","poem":1},{"lineBreak":true},{"text":"chikich ainaun waitkawarai tusam suritkata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}