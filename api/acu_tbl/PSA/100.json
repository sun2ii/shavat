{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":100,"content":[{"type":"heading","content":["Yus iin najatmamiaji tura asamtai niinuitji"]},{"type":"verse","number":1,"content":[{"text":"Mash nungkanmaya ainautiram,","poem":1},{"lineBreak":true},{"text":"warasrum Yus nintimsaram kanta kantamataram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ii Yusri nintimsaram warasrum ni umirkataram.","poem":1},{"lineBreak":true},{"text":"Tura warasrum ii Apuri:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuska iinu Apurintai titaram.","poem":1},{"lineBreak":true},{"text":"Ni najatmamiaji.","poem":1},{"lineBreak":true},{"text":"Tura asamtai niinuitji.","poem":1},{"lineBreak":true},{"text":"Ni aintsri asakrin,","poem":1},{"lineBreak":true},{"text":"aints ni uwijarin wainua nunisang iincha waitmaji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ii Apuri pengkeraitai,","poem":1},{"lineBreak":true},{"text":"tura ni anengkratairi nangkankashtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni timiaurinka tuke umiktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Yuse jeen wayaaram Yus maaketai takuram kanta kantamataram.","poem":1},{"lineBreak":true},{"text":"Tura ameketme juuntam tusaram wayaataram.","poem":1},{"lineBreak":true},{"text":"Tura ni naari pachisrum nekas pengkeraitai tusaram,","poem":1},{"lineBreak":true},{"text":"Yus maaketai titaram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":4}