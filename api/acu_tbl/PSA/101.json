{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":101,"content":[{"type":"heading","content":["David Yusen: Wi tu pujustatjai tusa kantamamuri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wikia ami anengkratairmin tura ami pengkeerumnasha warartustasan wakerajai.","poem":1},{"lineBreak":true},{"text":"Tura asan amincha kantamruatasan wakerajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Turasha tunaarinchau pujustasan wakerajai.","poem":1},{"lineBreak":true},{"text":"¿Amesha winisha warutik winitam?","poem":1},{"lineBreak":true},{"text":"Wina jearun pujaknasha pengké tunaarinchau pujustasan wakerajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura pasé turutniunka wikia pengké nintimrashtatjai.","poem":1},{"lineBreak":true},{"text":"Yusen umirtan nakitinaunka wikia nakitajai.","poem":1},{"lineBreak":true},{"text":"Tura asan wini pengké winicharti tusan nakitratatjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura pasé nintimtancha pengké nintimrashtatjai.","poem":1},{"lineBreak":true},{"text":"Tura pasé aa nunaka turutnasha nakitajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aints anumkar ni irutkamurin pachisar pasé chichari nauncha itatmamtikiatatjai.","poem":1},{"lineBreak":true},{"text":"Tura miajuitjai tumamin ainaunka jiitnasha nakitajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Antsu aints anangmichu ainau wijai tsaniasar pujusarti titatjai.","poem":1},{"lineBreak":true},{"text":"Tura Yusen umirkaru ainau nuke wina inatir arti tusan tsangkatkatatjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anangkartin ainauka kichkisha wina jearningkia pujuschartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura wait chichamrintin ainausha kichkisha wijaingkia tsaningchartin ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kintajai metek wina nungkarun pasé aints ainaunka itatmamtikiatnuitjai.","poem":1},{"lineBreak":true},{"text":"Tura pasé takau ainaunka mash Yuse yaktarinian jiiktinuitjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}