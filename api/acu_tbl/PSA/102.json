{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":102,"content":[{"type":"heading","content":["Aints wait wajak Yusen seatin"]},{"type":"verse","number":1,"content":[{"text":"Apuru wi seamur anturtukta.","poem":1},{"lineBreak":true},{"text":"Tura wi untsummataisha,","poem":1},{"lineBreak":true},{"text":"wait aneasam anturtukta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi shamakun pujamtaisha,","poem":1},{"lineBreak":true},{"text":"winaka anturtutskeka pujusaip.","poem":1},{"lineBreak":true},{"text":"Antsu wait aneasam anturtukta.","poem":1},{"lineBreak":true},{"text":"Tura wi seamsha wári airkata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wina iwiaakmauruka mukuntinua nunisang mengkaawai.","poem":1},{"lineBreak":true},{"text":"Tura ukunchrusha kaii keenawa nunisarang kuntur awajtinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura wina nintirsha nupaa jaawa nunisang kakarchamin nekapeawai.","poem":1},{"lineBreak":true},{"text":"Tura asan yutancha nintimtsujai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wi timiá juutuj pujau asamtai,","poem":1},{"lineBreak":true},{"text":"wina nuwaprusha ukunchrun nujatinawa nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura asan ampush jea itarkanam pujawa nunisketjai.","poem":1},{"lineBreak":true},{"text":"Ampush jea yumpunkamunam pujus shinawa nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wikia kanutnasha kanatsjai.","poem":1},{"lineBreak":true},{"text":"Antsu suwich ningki jea tuntupen keemas pujawa nunisketjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka tuke jiyatinawai.","poem":1},{"lineBreak":true},{"text":"Tura wina naarun pachisar pasé chichartinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ame wina kajertuku asam,","poem":1},{"lineBreak":true},{"text":"yakí wakata turutiatum,","poem":1},{"lineBreak":true},{"text":"nungka ajuarmawa nunisnak nekapmamjai.","poem":1},{"lineBreak":true},{"text":"Tura asan wikia pangkan yuwayatun,","poem":1},{"lineBreak":true},{"text":"yukuun yuwawa nunisnak nekapmamjai.","poem":1},{"lineBreak":true},{"text":"Tura umutirun umaknasha,","poem":1},{"lineBreak":true},{"text":"neaikirjai pachimran umajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wina kintarka mukuntiua nunisang nangkaaminawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai nupaa jajatua nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Antsu Apuru ameka aints ainauka nekasam tuke inawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin amin naarminka tuke kajinmakchartin ainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apuru ame tsangkukratkatin kintaka yanchuk jeau asamtai,","poem":1},{"lineBreak":true},{"text":"wári ami aintsrum ainau wait anentrarta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ami inatiram ainauka ami jeem yumpunkaun nintimsar aneenawai.","poem":1},{"lineBreak":true},{"text":"Tura ami jeem yumpunkaun jiisar wake mesekar pujuinawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ii Apuri ataksha mura Sión tutainum wina jear jeartuktaram tusa,","poem":1},{"lineBreak":true},{"text":"ni paaniurijai nuni wantintuk,","poem":1},{"lineBreak":true},{"text":"ayamrumichu ainau seamurin antuk pachistinuitai.","poem":1},{"lineBreak":true},{"text":"Turatin asamtai mash nungkanmaya aints ainau ii Apuri naari nekas pengker aa nuna pachisar:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tiartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanmaya apu ainausha ii Apuri pengkerin wainkar:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tiartinuitai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ukunam akiinawartin ainausha ii Apurin warartusarti tusar ju chichamka aarmau atinuitai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ii Apuri kársernum achikmau pujuinau juutinamurin antuktas,","poem":1},{"lineBreak":true},{"text":"tura maawartin ainauncha angkanmamtikiatas,","poem":1},{"lineBreak":true},{"text":"nayaimpinmayang nungkan jiismayi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mash nungkanmaya aints ainau ii Apurin warartusartas iruntrarti,","poem":1},{"lineBreak":true},{"text":"tura Jerusalén yaktanam mura Sión tutainum ni naarin pachisar chichasarti tusa,","poem":1},{"lineBreak":true},{"text":"ii Apuri nayaimpinmayang nungkan jiismayi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wikia aints jinta wekaa wekaaka japening pimpirua nunisketjai.","poem":1},{"lineBreak":true},{"text":"Tura musaachrisha jumchik ati tusa Yus pujutrun jurutkinua nunisketjai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tura asan Yusrun chicharkun:","poem":1},{"lineBreak":true},{"text":"“Jumchik musaach pujusu asan,","poem":1},{"lineBreak":true},{"text":"wina pujutruka jurutkiip”, tajai.","poem":1},{"lineBreak":true},{"text":"¡Ameka tuke pujuwitme!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apuru nu nangkamtaik nungkasha tura nayaimpisha najanamiame.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nuka mai mengkaakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu ameka tuke pujustinuitme.","poem":1},{"lineBreak":true},{"text":"Nungkasha tura nayaimpisha tarach arut mamuawa nunisarang mengkaakartinuitai.","poem":1},{"lineBreak":true},{"text":"Aints wejmakan aik chikichan entsawa nunismek nayaimpisha tura nungkasha yapajiatnuitme.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Antsu ameka yapaijmiamashtinuitme.","poem":1},{"lineBreak":true},{"text":"Tura asam ami pujutrumka pengké nangkankashtinuitai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ami inatirmi weari ainausha shamtsuk pujusarti tusam,","poem":1},{"lineBreak":true},{"text":"ameka pengker awaasatnuitme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":23}