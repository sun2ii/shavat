{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":103,"content":[{"type":"heading","content":["David: Wikia tuke nintirjai Apurun maaketai titatjai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wikia tuke nintirjai Apurun maaketai titatjai.","poem":1},{"lineBreak":true},{"text":"Ni naarin pachisan tuke:","poem":1},{"lineBreak":true},{"text":"Yus pengkeraitai titatjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wikia tuke nintirjai Apurun maaketai titatjai.","poem":1},{"lineBreak":true},{"text":"Wina pengker awajtusmia nunaka pengké kajinmakchatnuitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ningki wina tunaarunka mash tsangkutrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura wina najaimiamurun mash tsuwaaratnuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura mengkakai tusa tuke uwemtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni anengkratairijai tuke pengker awajtustinuitai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura pengker aa nuna mash surustinuitai.","poem":1},{"lineBreak":true},{"text":"Tura juunmaran pujayatnak,","poem":1},{"lineBreak":true},{"text":"kukui yakí nanamina nunisnak kakaram wajastinuitjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chikich aintsun pasé awajinamtaisha,","poem":1},{"lineBreak":true},{"text":"ii Yusri nekas tunaarinchau asa,","poem":1},{"lineBreak":true},{"text":"nu wait wajainaunka ayamruktinuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moisésnasha tura Israel ainautincha ni wakeramurin tura ni turamurincha nekamtikramamiaji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii Yusri iin wait anentramji.","poem":1},{"lineBreak":true},{"text":"Tura asa wárikia kajechuitai.","poem":1},{"lineBreak":true},{"text":"Tura iincha nukap anenmaji.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yuska iinka kintajai metekka paseetme turamtsuji,","poem":1},{"lineBreak":true},{"text":"tura asa tukeka kajertamkashtinuitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iikia tunau arining,","poem":1},{"lineBreak":true},{"text":"wait anentramu asa,","poem":1},{"lineBreak":true},{"text":"iinka amutmakchamiaji.","poem":1},{"lineBreak":true},{"text":"Tura ii pasé turamurincha yapaijtamtsuk tsangkutramramiaji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yus ni umirkautinka tuke anenmaji.","poem":1},{"lineBreak":true},{"text":"Nayaim nangkatkamurisha atsau asamtai,","poem":1},{"lineBreak":true},{"text":"Yuse anengkratairingkia pengké nangkankashtinuitai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura tsaa taakmau tsaa jeamujai pengké tsaningchamin aa nunisang Yuska atumi tunaaringkia pengké wainkashtinuitrume tusa yaja japrutmamiaji.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yus iin itiur najanamiaja tusa paan nekawai.","poem":1},{"lineBreak":true},{"text":"Iinka nungka tsetseri najatmau asa,","poem":1},{"lineBreak":true},{"text":"aints ni uchirin wait anentawa nunisang Yus ni umirin ainautinka wait anentramaji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aintsu pujutri nupaaya tumawaitai.","poem":1},{"lineBreak":true},{"text":"Nupaa tsapai yangkurui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tura nase kakaram nasenmatai,","poem":1},{"lineBreak":true},{"text":"yangkurka mengkawai.","poem":1},{"lineBreak":true},{"text":"Tura tuning aya tusarsha aints kichkisha nekaacharminuitai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Antsu ni chichamen kajinmatsuk umirinauka Yuse anengkratairi tuke nangkankashtinuitai tusar nekainawai.","poem":1},{"lineBreak":true},{"text":"Tura ni weari ainauncha Yus tuke wainkatnuitai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ii Yusri keemtairi nayaimpinam pujawai.","poem":1},{"lineBreak":true},{"text":"Tura nuni keemas mash nungkanmaya ainauncha inawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yuse awemamuri timiá kakaram ainautiram Yuse chichamen tuke antukrum umirkau asaram ii Apuri ameketme juuntam titaram.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yuse awemamuri ainautiram,","poem":1},{"lineBreak":true},{"text":"ni inatiri asaram,","poem":1},{"lineBreak":true},{"text":"tura ni wakeramuri umirkau asaram,","poem":1},{"lineBreak":true},{"text":"mash ii Apuri ameketme juuntam titaram.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mash najanamu ainausha mash nungkanam pujuina nu ii Apurin ameketme pengkeram tiarti.","poem":1},{"lineBreak":true},{"text":"Wikia tuke nintirjai Apurun maaketai titatjai.","poem":1},{"lineBreak":true},{"text":"Nuke ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":20}