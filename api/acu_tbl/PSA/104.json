{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":104,"content":[{"type":"heading","content":["Yuse najanamuri pachisar maaketai titinuitji"]},{"type":"verse","number":1,"content":[{"text":"Wina nintirjai tuke Yus pengkeraitai titatjai.","poem":1},{"lineBreak":true},{"text":"Yusru ameketme juuntam.","poem":1},{"lineBreak":true},{"text":"Ameketme kakarmam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ameka paantin asam,","poem":1},{"lineBreak":true},{"text":"tarachia tumau nayaimpisha najanawaitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ameka entsa ainausha najanawaitme.","poem":1},{"lineBreak":true},{"text":"Tura mukuntiunam wekainuitme.","poem":1},{"lineBreak":true},{"text":"Tura nase najanau asam,","poem":1},{"lineBreak":true},{"text":"tuke nase akupnuitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ameka nungka pengké muchikchati tusam metamiame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura juun entsa timiá kuna asa,","poem":1},{"lineBreak":true},{"text":"nungkan netkati tusam,","poem":1},{"lineBreak":true},{"text":"ame tsangkamkamiame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin juun entsaka murancha netkamiayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura wainiatum ameka juun entsa kuyuati tusam chicharkamiame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin juun entsaka ami chichammin ipiamta tumaun antuk wári kuyuamiayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Juun entsa kuyuamtai,","poem":1},{"lineBreak":true},{"text":"mura ainau tsapuiniarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura juun entsaka ataksha nungkanka mashkia netchau ati tusam surimkau asakmin,","poem":1},{"lineBreak":true},{"text":"ataksha ni nangkaankatniurin kuyuamiayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tura muranam pukuni ainia nu entsa arti tusam,","poem":1},{"lineBreak":true},{"text":"amek akupnuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura pachim ainau yumin umurarat tusam,","poem":1},{"lineBreak":true},{"text":"entsa muranmasha tura paka nungkanmasha akupnuitme.","poem":1},{"lineBreak":true},{"text":"Pachim yupiram ainia nusha umurarmi tusam,","poem":1},{"lineBreak":true},{"text":"entsasha najanawaitme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanamtin ainau entsa yantamen pujuinauka shiniinawai.","poem":1},{"lineBreak":true},{"text":"Yumi umurarat tusam mukuntiunmaya yumi akupnuitme.","poem":1},{"lineBreak":true},{"text":"Ameka mash najanau asam,","poem":1},{"lineBreak":true},{"text":"ni yutairisha suame.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chirichri waaka ainau yuwaarat tusam najanawaitme.","poem":1},{"lineBreak":true},{"text":"Aints ainausha yutancha yuwaarti tusam,","poem":1},{"lineBreak":true},{"text":"ni yutairisha suame.","poem":1},{"lineBreak":true},{"text":"Tura yutai nereu ainau aints nungkanmaya uweniar yuwaarti tusam suame.","poem":1},{"lineBreak":true},{"text":"Nunia olivo macharijai ni namangken yakararti tusam suame.","poem":1},{"lineBreak":true},{"text":"Nunia ni yutairisha tuke suame.","poem":1},{"lineBreak":true},{"text":"Tura umutirincha umurarti tusam suame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Numi ainau juun wajasarti tusam numpesha suame.","poem":1},{"lineBreak":true},{"text":"Kanu ainausha amek araawitme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nanamtin ainauka numinam pasungminawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tura chipu yupiram ainau muranam yakí wekajinawai.","poem":1},{"lineBreak":true},{"text":"Chikich kuntin ainausha waanam matsatinawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aints ainau nantun nekaawarti tusam,","poem":1},{"lineBreak":true},{"text":"nantusha najanamiame.","poem":1},{"lineBreak":true},{"text":"Tura tsaasha ame najanamu asa,","poem":1},{"lineBreak":true},{"text":"kintajai metek jeawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ame tee ati tama tee wajawai.","poem":1},{"lineBreak":true},{"text":"Pachim ainau tura kuntin ainausha kashisha wekainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Juun yawaa ainau ni uchiri yutairincha eatinawai.","poem":1},{"lineBreak":true},{"text":"Turinamtai Yus ni yutairincha suawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tura tsawaarmatai ataksha waanam wayaawar tepeenawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aints ainau tsawaarar jeanmaya jiinkiar,","poem":1},{"lineBreak":true},{"text":"ni takatrin takakmasartas weenawai.","poem":1},{"lineBreak":true},{"text":"Nunia kiarai waketkiar,","poem":1},{"lineBreak":true},{"text":"ataksha ni jeen waketinawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yusru ami takatrum timiá untsurintai.","poem":1},{"lineBreak":true},{"text":"Ame nekamtairumjai mash najanawaitme.","poem":1},{"lineBreak":true},{"text":"Ame najanamu asar mash nungkanam yujainawai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Juun entsasha sarmaitai.","poem":1},{"lineBreak":true},{"text":"Nuni namak juuncha tura tuupchisha yujainawai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nuni kanu juunnum aints engkemawar wekainawai.","poem":1},{"lineBreak":true},{"text":"Apuupsha nuni wekainawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ame mash yujaina nuna yutairisha suame.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ame suam ni yutairincha juwinawai.","poem":1},{"lineBreak":true},{"text":"Ame uwejem yapaarakmin tutuarar pujuinawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ame yuta suachmaka wake mesekar pujuinawai.","poem":1},{"lineBreak":true},{"text":"Ame mayatairisha juramka,","poem":1},{"lineBreak":true},{"text":"aints ainausha jakar ataksha nungka tsetseri najanartin ainawai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ame ni mayatairi suamu asar,","poem":1},{"lineBreak":true},{"text":"ataksha nungkanam yujarmi tusar pujuinawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yuse kakarmari tuke nangkankashtinuitai.","poem":1},{"lineBreak":true},{"text":"Ni takatri ainaujai Yuska waraawai.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yus uurkat tama nungkaka muchiawai.","poem":1},{"lineBreak":true},{"text":"Tura muran takasamtai,","poem":1},{"lineBreak":true},{"text":"mukunit jiinui.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tura asamtai Yusen tuke nintimsan kantamatajai.","poem":1},{"lineBreak":true},{"text":"Iwiaaku pujaknaka Yusrun Salmon kantamruatatjai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Wikia Yusrun tuke pengker nintimtusan pujajai.","poem":1},{"lineBreak":true},{"text":"Tura Yusnum tuke warastinuitjai.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Tunaarintin ju nungkanam matsatinau mengkakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura Yusen umirtan nakitinausha mash mengkakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu wikia tuke nintirjai Yus pengkerapita tura Yus juuntapita titatjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":31}