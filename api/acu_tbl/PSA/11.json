{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":11,"content":[{"type":"heading","content":["David: Yuska tuke nekasaintai tusar nintimratnuitji timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wikia Apurun wina ayamrutkati tusan seajai.","poem":1},{"lineBreak":true},{"text":"Antsu chikich aints ainau wina chichartinak:","poem":1},{"lineBreak":true},{"text":"“Ame nanamtinua nunismek muranam tupikiakta”,","poem":1},{"lineBreak":true},{"text":"turutina nunaka pachiatsjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pasé aints ainau jiakuk ataram.","poem":1},{"lineBreak":true},{"text":"Nuka anumkar tishimkun achikiar,","poem":1},{"lineBreak":true},{"text":"tura wachin kunkar,","poem":1},{"lineBreak":true},{"text":"kuntinun maawartas tias akupinawa nunisarang nu pasé aints ainau anumkar pengker nintintin ainaun mainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aints ainau umirkatin chichaman umitsuk pujuinamtaikia,","poem":1},{"lineBreak":true},{"text":"¿tunaarinchau ainausha warukawartinki?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antsu Yuska ni jeen nekas pengkernum pujawai.","poem":1},{"lineBreak":true},{"text":"Ni keemtairi nayaimpinam puusamuitai.","poem":1},{"lineBreak":true},{"text":"Tura nuni keemas aints ainaun mash jiij pujurui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuska pengke aints ainauncha tura pasé aints ainauncha wainui.","poem":1},{"lineBreak":true},{"text":"Antsu mangkartutan wakerin ainaun pengké nakitawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus pasé ainaun ni tunau turamurijai metek ni wait wajaktintri tu ati tusa,","poem":1},{"lineBreak":true},{"text":"kaii azufrejai jijai pachimramun yakiiyan akuptuktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura nase tsuweran akupkamtai,","poem":1},{"lineBreak":true},{"text":"mash aints ainauncha keemaktinuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus nekas tunaarinchau asa,","poem":1},{"lineBreak":true},{"text":"tunaarinchau ainaun aneawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai pengke nintintin ainau","poem":1},{"lineBreak":true},{"text":"ni yapiin wainkartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}