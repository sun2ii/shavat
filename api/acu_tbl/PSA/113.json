{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":113,"content":[{"type":"heading","content":["Yuuminak pujuinaunka Yus wait anentawai"]},{"type":"verse","number":1,"content":[{"text":"¡Ii Apuri warartusmi!","poem":1},{"lineBreak":true},{"text":"Ii Apuri inatiri ainautiram,","poem":1},{"lineBreak":true},{"text":"ni naari pachisrum:","poem":1},{"lineBreak":true},{"text":"Yus juuntaitai titaram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yamai nangkamsaram tuke ii Apuri naari pachisrum:","poem":1},{"lineBreak":true},{"text":"Yus pengkeraitai titaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsaa taakmanumaninisha tura tsaa jeamunmaninisha ii Apuri naari pachisrum:","poem":1},{"lineBreak":true},{"text":"Yus kakarmaitai titaram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ii Apuringkia mash nungkanmaya ainaun inawaitai.","poem":1},{"lineBreak":true},{"text":"Tura asa ni kakarmaringkia nayaimpincha nangkawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ii Yusringkia yakiiyang mash aints ainaun inawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ii Apurijai metek kichkisha atsawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Turayat tsuntsuma nayaimpincha tura nungkancha mash wainui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ii Apuringkia yuuminak pujuinaunka wait anentawai.","poem":1},{"lineBreak":true},{"text":"Turasha ni yakta apuri ainaujai turasha kuikiartin ainaujai iruntrar pujusarti tusa,","poem":1},{"lineBreak":true},{"text":"Yus niin pengker awajsartinuitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuwa kaa ainausha uchin jurerarti tusa,","poem":1},{"lineBreak":true},{"text":"tura ni uchiri ainaujai pujusarti tusa Yus waramtiksartinuitai.","poem":1},{"lineBreak":true},{"text":"¡Ii Apuri warartusmi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":8}