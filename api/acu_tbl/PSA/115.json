{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":115,"content":[{"type":"heading","content":["Ii Yusringkia nayaimpinam pujawai"]},{"type":"verse","number":1,"content":[{"text":"Apuru timiá wait anengkratin asam,","poem":1},{"lineBreak":true},{"text":"tura nekas chicham nekamtikin asam,","poem":1},{"lineBreak":true},{"text":"aints ainauka iinka:","poem":1},{"lineBreak":true},{"text":"Pengkeraitme turamtsuk antsu aminak:","poem":1},{"lineBreak":true},{"text":"Pengkeraitme turamiarti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Warukaya aints ainau amin umirtamtsuk pujusarsha iincha:","poem":1},{"lineBreak":true},{"text":"Atumi Yusri tuwaita turaminaji?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ii Yusringkia nayaimpinam pujawai.","poem":1},{"lineBreak":true},{"text":"Tura ni wakera nunaka mash umiawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antsu Yusen umirkacharu ainau yusringkia kuritai nuniasha kuikaitai.","poem":1},{"lineBreak":true},{"text":"Ni yusri ainauka aints najanamu ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni yusri nakumkamuri jangkentin ainayat chichachu ainawai.","poem":1},{"lineBreak":true},{"text":"Tura jiintin ainayat wainmichu ainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura kuwishtin ainayat antutnasha antichu ainawai.","poem":1},{"lineBreak":true},{"text":"Tura nujintin ainayat mayatchau ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura uwejentin ainayat achimchau ainawai.","poem":1},{"lineBreak":true},{"text":"Tura nawentin ainayat wekaichau ainawai.","poem":1},{"lineBreak":true},{"text":"Tura chichatsuk aya takamtaik puju ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura asaramtai aints ni yusrin najaninauka tura:","poem":1},{"lineBreak":true},{"text":"Ameka wina yusruitme tinu ainauka ni yusrijai metek ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel ainautiram,","poem":1},{"lineBreak":true},{"text":"Yusek nekasampita titaram.","poem":1},{"lineBreak":true},{"text":"Ningki iin yainmaktinuitji,","poem":1},{"lineBreak":true},{"text":"tura ejarmaktinuitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sacerdote ainautiram,","poem":1},{"lineBreak":true},{"text":"Yusek nekasampita titaram.","poem":1},{"lineBreak":true},{"text":"Ningki atumin yainmaktinuitai,","poem":1},{"lineBreak":true},{"text":"tura ejarmaktinuitai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mash aints ainautiram,","poem":1},{"lineBreak":true},{"text":"ii Apuri:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tinu asaram,","poem":1},{"lineBreak":true},{"text":"nekasampita titaram.","poem":1},{"lineBreak":true},{"text":"Ningki iin yainmaktinuitji,","poem":1},{"lineBreak":true},{"text":"tura ejarmaktinuitji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ii Apuri ni aintsri ainautin kajinmatramtsuk nekas pengker awajtamsatnuitji.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tura juun ainau tura uchi ainausha niin:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tinaunka nekas pengker awajsatnuitai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ii Apuringkia atumin nukap yujtamratnuitai,","poem":1},{"lineBreak":true},{"text":"tura atumi uchirincha nunisang nukap yujratnuitai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ii Apuri nayaimpin tura nungkancha najanamia nuka atumin pengker awajtamsati.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nayaimpikia iinu Apurinuitai.","poem":1},{"lineBreak":true},{"text":"Antsu nungkanka aints ainautin suramsamiaji.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaanchuik jakaru ainauka chichakchamin asar,","poem":1},{"lineBreak":true},{"text":"iinu Apurinka maaketai tichartinuitai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Antsu iikia iinu Apuringka yamaikia tuke maaketai titatji.","poem":1},{"lineBreak":true},{"text":"¡Ii Apuri warartusmi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":18}