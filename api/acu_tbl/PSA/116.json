{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":116,"content":[{"type":"heading","content":["Maaketai tiartas Yusen seamu"]},{"type":"verse","number":1,"content":[{"text":"Wina Apurka wi seamurun anturtuku asamtai,","poem":1},{"lineBreak":true},{"text":"wikia Apurun aneajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi seamurun anturtuku asamtai,","poem":1},{"lineBreak":true},{"text":"iwiaaku pujaknaka tuke niin seatnuitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jata wina achirkamtai,","poem":1},{"lineBreak":true},{"text":"jakatatjapi tusan shamkamjai.","poem":1},{"lineBreak":true},{"text":"Tura timiá shamakun tura timiá najaimiakun achikmawa nunisnak nekapmamramjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tu nintimsan pujakun Apuru naarin pachisan uwemtikrurti tusan seamjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ii Apuringkia mash aints ainaun:","poem":1},{"lineBreak":true},{"text":"Metek ainawai tu nintimui.","poem":1},{"lineBreak":true},{"text":"Tura asa ii Yusringkia iincha tuke wait anentramak pengker awajtamji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ii Apuringkia mianchau ainauncha wainui.","poem":1},{"lineBreak":true},{"text":"Tura asa wikia pengké kakarchamin nekapeai wainiat winaka uwemtikrurmayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apurka wina pengker awajtusu asamtai,","poem":1},{"lineBreak":true},{"text":"yamaikia pengker nintimtusan pujusminuitjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus jakatniunmaya wina uwemtikruru asamtai,","poem":1},{"lineBreak":true},{"text":"tura juutmauruncha jurutrukin asamtai,","poem":1},{"lineBreak":true},{"text":"yamaikia jakashtatjapi tusan,","poem":1},{"lineBreak":true},{"text":"pengker nintimsan pujustinuitjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yamaikia iwiaaku pujaknaka:","poem":1},{"lineBreak":true},{"text":"Apurun umirkatatjapi titatjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wikia timiá wait wajayatnak Apurun nekasampita timiajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waurkamin nekapeakun:","poem":1},{"lineBreak":true},{"text":"Mash aints ainau wait chichamrintin ainawai tu nintimmiajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Apur wina timiá pengker awajtusuncha warinak susaintaj?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mash aints antinamunam:","poem":1},{"lineBreak":true},{"text":"Apurka uwemtikrurmayi titatjai.","poem":1},{"lineBreak":true},{"text":"Tura ni naarin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem titatjai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wina Apurun:","poem":1},{"lineBreak":true},{"text":"Nuna turatatjai timiaja nunaka mash aints antinamunam umiktatjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ni aneetiri ainau jakatniurinka ii Apuri nukap nintimtawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apuru wikia aminu inatirmetjai.","poem":1},{"lineBreak":true},{"text":"Wikia aminu nawantrumi uchirinjai.","poem":1},{"lineBreak":true},{"text":"Wikia jingkiamua nunisnak pujaing winaka atitamiame.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apuru amin maaketai titasan tangkurun maan epeatatjai.","poem":1},{"lineBreak":true},{"text":"Tura ami naarmin pachisan seatatjame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apuru Jerusalén yakta japen ami jeemin wayaan,","poem":1},{"lineBreak":true},{"text":"wi amincha nunaka turatatjai timiaja nunaka mash aints antinamunam umiktatjai.","poem":1},{"lineBreak":true},{"text":"¡Ii Apuri warartusmi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}