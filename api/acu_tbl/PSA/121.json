{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":121,"content":[{"type":"heading","content":["Wina ejarkatnuka Yusketai"]},{"type":"verse","number":1,"content":[{"text":"Wiki nintimsanak muran jiisan:","poem":1},{"lineBreak":true},{"text":"¿Tuniang wina yainkatnusha winitnuinta? tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Turayatun wina yainkatnuka muranmakeka pujatsui.","poem":1},{"lineBreak":true},{"text":"Antsu wina yainkatnuka nayaimpin tura nungkancha najanamia nuwaitai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuka tunaanum pujusta,","poem":1},{"lineBreak":true},{"text":"tusangka tsangkamramkashtinuitai.","poem":1},{"lineBreak":true},{"text":"Amin waitma nuka pengké kanurchatnuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nekas amin waitma nuka Israel ainaun wainin asa,","poem":1},{"lineBreak":true},{"text":"pengké kanichuitai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yusketai amin waitminka.","poem":1},{"lineBreak":true},{"text":"Tura amin ejarmaktincha nuketai.","poem":1},{"lineBreak":true},{"text":"Tura amin yainmaktincha amijai tsanias puja nuketai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsaangka tsawaingkia aminka ititka awajtamsashtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura nantusha nunisang kashisha turutmashtinuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shamrumtin amaunumiasha Apuram ejarmaktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ami pujutrumnasha pasemarai tusa waitramkatnuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ame tuni wekaame nunisha ami Apuram yamaisha ejarma nu tuke ejarmaktinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}