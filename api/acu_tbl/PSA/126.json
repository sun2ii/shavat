{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":126,"content":[{"type":"heading","content":["Achikmau ainau waketkiarmauri"]},{"type":"verse","number":1,"content":[{"text":"Achikmau ainautin Yus:","poem":1},{"lineBreak":true},{"text":"Ataksha Jerusalénnum","poem":1},{"lineBreak":true},{"text":"waketkitaram tusa,","poem":1},{"lineBreak":true},{"text":"angkanmamtikiamu asar iisha karanma nunisrik pujusmiaji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura asar wararkur wishirmiaji.","poem":1},{"lineBreak":true},{"text":"Tura wararkur kantamamiaji.","poem":1},{"lineBreak":true},{"text":"Turakrin Yusen umirchau ainau nuna wainkar chichainak:","poem":1},{"lineBreak":true},{"text":"“Ni Yusri niin nekas pengker awajsayi”, tiarmiayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nu tina nunaka nekasar tiarmiayi.","poem":1},{"lineBreak":true},{"text":"Ii Apuringkia nekas iin pengker awajtamsamiaji.","poem":1},{"lineBreak":true},{"text":"Tura asamtai iisha warasmiaji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru yumi atsamunam ataksha yumi jitamtai,","poem":1},{"lineBreak":true},{"text":"entsa wej wajainawa nunismek iincha ataksha pengker awajkartusta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aints ni arakri jumchik asamtai,","poem":1},{"lineBreak":true},{"text":"juutkamaikiak araamramia nunaka ukunam nerekamtai waras juuktinuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni arakrin araamratas jumchik asamtai juutkamaikiak ni jeenian jiinkiat,","poem":1},{"lineBreak":true},{"text":"nuniangka nukap juuku asa,","poem":1},{"lineBreak":true},{"text":"waras kantan kantamki ni jeen waketkitnuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":6}