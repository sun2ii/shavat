{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":127,"content":[{"type":"heading","content":["Iinu aa nunaka Yus mash suramji"]},{"type":"verse","number":1,"content":[{"text":"Ii Apuri yaimkechujai ii jee jeamkurkia,","poem":1},{"lineBreak":true},{"text":"jea jeamin ainautisha nangkamir takakmastinuitji.","poem":1},{"lineBreak":true},{"text":"Tura ii Yusri ii yaktarin waintsuk pujamtaikia,","poem":1},{"lineBreak":true},{"text":"yakta wainin ainausha nangkamiar ii yaktarincha wainkartinuitai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atumsha atumi yutairi wainkatasrum kashik nantakrum,","poem":1},{"lineBreak":true},{"text":"waitnasrum takaa takakmakrum tsaa jeamtai inangnakrumsha nangkamrum takakmastinuitrume.","poem":1},{"lineBreak":true},{"text":"Antsu Yus ni aneetiri ainautinka kanurarti tusa karan suramji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aints uchin untsuri yajutmaruka aints kuntinun tukutas tsentsakan untsuri takus wekaawa nunisketai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai aints uchin untsuri yajutmarunka Yuska nekas pengker awajui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai nu aintska pengker nintimias warastinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni uchiri ayamrukartinka untsuri asaramtai,","poem":1},{"lineBreak":true},{"text":"ni nemase ainau nu aintsun pachisar pasé chichainayat inatsarchartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":3}