{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":13,"content":[{"type":"heading","content":["David: Apuru ami anengkratairmin nintimsan pujajai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru ¿waruka winasha nintimrutsume? ¿Winaka tuke kajinmatruktatmek? ¿Waruka anumrutkamsha pujame?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wina nintirka kintajai metek najamrutawai.","poem":1},{"lineBreak":true},{"text":"Wina nemasur wina itit awajtamurin warutik inaitusat tusan kintajai metek wake mesekan pujajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru wina Yusur asam jiirsam airkata.","poem":1},{"lineBreak":true},{"text":"Turam jakai tusam nintir paan nintimtikrurta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wi mianchau wajamtai,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau warasarai tusam surimrukta.","poem":1},{"lineBreak":true},{"text":"Turakmin wi nepetkajai turutcharti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ami anengkratairmin nintimsan wikia pengkerapita tajame.","poem":1},{"lineBreak":true},{"text":"Wina uwemtikruru asakmin,","poem":1},{"lineBreak":true},{"text":"wina nintirjai waraajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apuru wina pengker awajtusu asakmin amin kantamruatjame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}