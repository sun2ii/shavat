{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":130,"content":[{"type":"heading","content":["Apuru ¿tunau tsangkutrachkumnisha yáki uwemtikrurat?"]},{"type":"verse","number":1,"content":[{"text":"Apuru timiá napchau nintimsan pujau asan amin seajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apuru wina chichamur anturtukta.","poem":1},{"lineBreak":true},{"text":"Tura wait anentrurta tusan seamka tenap anturtukam airkata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru ¿tunaur tsangkutrachkumnisha yáki uwemtikrurat?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antsu wina ameketme Yusem turutiarti tusam,","poem":1},{"lineBreak":true},{"text":"ii tunaaringkia tsangkukratnuitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wikia tuke wina nintirjai Apurun nintimtajai.","poem":1},{"lineBreak":true},{"text":"Tura ni chichamencha tuke nintimsan pujajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yakta wainin kashi iwiainak:","poem":1},{"lineBreak":true},{"text":"¿Warutik tsawaarat? tusar nakainawa nunisnak wikia Apurun:","poem":1},{"lineBreak":true},{"text":"¿Warutik tat? tusan nakajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ii Apuri timiá wait anengkratin asa, iinka tuke angkanmamtikramatnuitji.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Israela weari ainautiram,","poem":1},{"lineBreak":true},{"text":"atumi Apuri nintimrataram.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ningki atumi tunaarinka mash tsangkutramratnuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}