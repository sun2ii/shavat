{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":142,"content":[{"type":"heading","content":["David: Apuru ametme wina ejarkatnumka timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wikia Apurun kakaran untsuakun:","poem":1},{"lineBreak":true},{"text":"Wait anentrurta tusan seajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Napchau nintimsan pujaknaka,","poem":1},{"lineBreak":true},{"text":"Apurun wake mesekmaurun nekamtikjai.","poem":1},{"lineBreak":true},{"text":"Tura wait wajamurnasha ujaajai.","poem":1},{"lineBreak":true},{"text":"Apuru wi pujamurka nekame.","poem":1},{"lineBreak":true},{"text":"Wi wekaasatniunam ejatkan puusarmayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura pajaasan jiimkuncha,","poem":1},{"lineBreak":true},{"text":"wina yainkatnunka waintsujai.","poem":1},{"lineBreak":true},{"text":"Tura wina ayamrutkatnusha atsawai.","poem":1},{"lineBreak":true},{"text":"Tura wina nintimtursatcha kichkisha atsawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura asamtai amincha Apuru untsuajme.","poem":1},{"lineBreak":true},{"text":"Ametme wina ejarkatnumka.","poem":1},{"lineBreak":true},{"text":"Nuniangka chikich wina ayamrutkatnuka aya atsawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wina kakarmar atsau asamtai,","poem":1},{"lineBreak":true},{"text":"wina untsumaur anturtukta.","poem":1},{"lineBreak":true},{"text":"Tura wina nemasur ainau wina nangkamasang kakaram ainamunmaya angkanmamtikruata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amin waramtiksatasan wakerau asamtai,","poem":1},{"lineBreak":true},{"text":"wikia achikmawa nunisnak pujaing nuniangka jiirkita.","poem":1},{"lineBreak":true},{"text":"Ame winaka pengker awajtau asakmin,","poem":1},{"lineBreak":true},{"text":"anangmichu ainauka winaka tentatkartinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":6}