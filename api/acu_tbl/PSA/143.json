{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":143,"content":[{"type":"heading","content":["David: Apuru wi inintramur airkata timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru wi seamur anturtukta.","poem":1},{"lineBreak":true},{"text":"Turasha wi inintramur anturtukta.","poem":1},{"lineBreak":true},{"text":"Ame timiame nuka tuke umiktin asam,","poem":1},{"lineBreak":true},{"text":"wi seamur airkata.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mash aints ainau tunaarintin ainawai tusam nekame.","poem":1},{"lineBreak":true},{"text":"Antsu wikia aminu inatiram asamtai,","poem":1},{"lineBreak":true},{"text":"winaka wait wajaktinka surusaip.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka wina papeetkar nungkanam ujuarmawa nutikruwarmayi.","poem":1},{"lineBreak":true},{"text":"Tura aints jakawa nunisang teenam pujusti tusar,","poem":1},{"lineBreak":true},{"text":"wina pasé awajtusarmayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wikia timiá napchau nintimsan pujau asamtai,","poem":1},{"lineBreak":true},{"text":"nintirsha kurawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wi yaanchuik pujuyaja nuna aneakjai.","poem":1},{"lineBreak":true},{"text":"Tura ami turamurmin mash nintimjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wikia nungka mujurua tumawaitjai.","poem":1},{"lineBreak":true},{"text":"Tura asan nungka mujuramtai,","poem":1},{"lineBreak":true},{"text":"aints ainau yumi jiturti tusar,","poem":1},{"lineBreak":true},{"text":"uwejen takuiniar amin seatmina nunisnak amincha seajme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apuru wina mayatair nangkantanak jasi.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wári airkata.","poem":1},{"lineBreak":true},{"text":"Ame yaimkem suritrukaip.","poem":1},{"lineBreak":true},{"text":"Nu turakminka wikia jakawa nunisnak pujustatjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wikia amin nintimsan pujau asamtai,","poem":1},{"lineBreak":true},{"text":"kashik shintaramtai,","poem":1},{"lineBreak":true},{"text":"ami anengkratairmin tu awai tusam nekamtikruata.","poem":1},{"lineBreak":true},{"text":"Tura ame nu jinta wekaasata tusam jintim nekamtikruata.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru ameka wina ejarin asam,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainamunmaya angkanmamtikruata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tura wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"wina wakeramur najanata tusam nuiturta.","poem":1},{"lineBreak":true},{"text":"Ami Wakanim nekas pengker aa nu:","poem":1},{"lineBreak":true},{"text":"Ju jinta tupnik amakta tusa,","poem":1},{"lineBreak":true},{"text":"wina jintintruati tusan seajme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apuru pujut surusta tusan,","poem":1},{"lineBreak":true},{"text":"amin naarmin pachisan seajme.","poem":1},{"lineBreak":true},{"text":"Ame tuke pengker asam,","poem":1},{"lineBreak":true},{"text":"wi wait wajamunmayangka jiirkita.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wikia ami inatiram asamtai,","poem":1},{"lineBreak":true},{"text":"wait anentruram wina nemasur ainauka nepetkam mash mengkaakta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}