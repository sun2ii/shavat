{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":145,"content":[{"type":"heading","content":["David: Yusru ami kakarmarmin pachisan chichastatjai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina Apur asakmin,","poem":1},{"lineBreak":true},{"text":"ami kakarmarmin pachisan chichastatjai.","poem":1},{"lineBreak":true},{"text":"Tura ami naarmin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titatjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aminka kintajai metek:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram titatjai.","poem":1},{"lineBreak":true},{"text":"Tura tuke amin naarmin pachisan warartustatjame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ii Apuri asam nekasam juuntaitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin mash aints ainau:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turamiarti.","poem":1},{"lineBreak":true},{"text":"Tura timiá juun asakmin,","poem":1},{"lineBreak":true},{"text":"iikia warukuita tusar nintimratatkamar tujintaji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aints ainau ni uchiri ainaun nuininak ami turamurmin pachisar:","poem":1},{"lineBreak":true},{"text":"Nuka nekas pengker ainawai tiartinuitai.","poem":1},{"lineBreak":true},{"text":"Nunia ami kakarmarmijai najanamiame nunasha pachisar ni uchiri ainaun ujakartin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura asaramtai aints ainau mash ami paaniurmin tura ami kakarmarmincha pachisar chichasartin ainawai.","poem":1},{"lineBreak":true},{"text":"Turinamtai wisha ami wainchati takatrumin pachisan chichastatjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura ami kakarmarmijai ami nemasem ainau nepetnuyame nuna pachisar chichasartin ainawai.","poem":1},{"lineBreak":true},{"text":"Turinamtai wisha amin pachisan:","poem":1},{"lineBreak":true},{"text":"Yus juuntaitai tusan aints ainaun ujaktatjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi ujaam,","poem":1},{"lineBreak":true},{"text":"aints ainau amin pachitmasar:","poem":1},{"lineBreak":true},{"text":"Yus timiá pengkeraitai tiartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura kantan kantaminak:","poem":1},{"lineBreak":true},{"text":"Yuska pengké tunaachawaitai tiartinuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii Yusringkia jaimias aints ainautin wait anentramji.","poem":1},{"lineBreak":true},{"text":"Turasha wári kajechu asa iincha tuke anenmaji.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ii Apuringkia mash aints ainautin pengker awajtamsatas wakerutmaji.","poem":1},{"lineBreak":true},{"text":"Tura ni najanamurinka mash jaimias wainui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apuru ami najanamurmin pachisar aints ainau mash warasarti.","poem":1},{"lineBreak":true},{"text":"Tura amin umirtaminak pujuinauka mash amin warartamsarti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura aints ainau mash ami kakarmarmin pachisar chichasarti,","poem":1},{"lineBreak":true},{"text":"turasha ame aints ainau timiá pengker inamurmin","poem":1},{"lineBreak":true},{"text":"pachisar warasarti.","poem":1},{"lineBreak":true},{"text":"Tura amin pachitmasar:","poem":1},{"lineBreak":true},{"text":"Mash nungkanmaya ainaun nekas pengker inawai turamiarti.","poem":1},{"lineBreak":true},{"text":"Nunia ami paaniurmincha pachisar chichasarti.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aminu inamtairumka pengké nangkankashtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ameka aints ainauka tuke inangnatsuk inartinuitme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ii Apuringkia jakaartas wakerinauncha kiakartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura mianchawaitjai tumamin ainauncha inankitnuitai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apuru mash iwiaaku ainauka yutairin yuuminak surusat tusar amin nakarminawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tura uwejem yapaarakminka,","poem":1},{"lineBreak":true},{"text":"mash iwiaaku ainau tutuarar pujuinawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ii Apuringkia aints ainautinka tuke mash metek jiirmaji.","poem":1},{"lineBreak":true},{"text":"Turasha ni tura nunaka iin wait anentramak tuke turawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ii Apuringkia ni seau ainautinka anturtamji.","poem":1},{"lineBreak":true},{"text":"Tura anangmichu ainau seamsha anturui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tura ii Apurinka:","poem":1},{"lineBreak":true},{"text":"Ameketme Apum tinu ainau wakeramurin umiktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura Apuru yainkata tinamtaikia,","poem":1},{"lineBreak":true},{"text":"ni seamurinka anturkatnuitai tura uwemtikratnuitai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ii Apuringkia niin aneenaunka ejaktinuitai.","poem":1},{"lineBreak":true},{"text":"Antsu pasé aints ainaunka mengkaaktinuitai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wina jangkerjai wina Apurun tuke maaketai titatjai.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanmaya ainau ii Apuri naarin nekas pengker aa nuna pachisar:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tuke inangnatsuk tiartinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":20}