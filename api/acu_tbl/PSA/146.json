{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":146,"content":[{"type":"heading","content":["Tuke wina nintirjai Apurun maaketai titatjai"]},{"type":"verse","number":1,"content":[{"text":"¡Ii Apuri warartusmi!","poem":1},{"lineBreak":true},{"text":"Tuke wina nintirjai Apurun maaketai titatjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura iwiaaku pujaknaka tuke Apurun maaketai titatjai.","poem":1},{"lineBreak":true},{"text":"Tura wina Yusrun kantan kantamruatatjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atumka aints miajuitjai tumamin ainau timiá kakaram ainawai tiirap.","poem":1},{"lineBreak":true},{"text":"Nu ainauka áya aintsuk ainawai.","poem":1},{"lineBreak":true},{"text":"Tura jakaar nungka najanarar,","poem":1},{"lineBreak":true},{"text":"nu kintatik ni takaamurinka mash inaisartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura timiá kakaram ainau wina uwemtikrurartinuitai tuuka nintimsairap.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ii Yusri yayaamutirmeka warastaram.","poem":1},{"lineBreak":true},{"text":"Jacobo Yusri atumi Apuri asamtai,","poem":1},{"lineBreak":true},{"text":"niin nintimsaram pujuinautirmeka warastaram.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yuska nayaimpincha tura nungkancha tura juun entsancha tura numi mash iruna nunasha najanamiayi.","poem":1},{"lineBreak":true},{"text":"Tura asa ni chichamencha tuke umiktinuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura wait wajakartin ainaunka Yuska pengker awajsatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura tsukaminak pujuinauncha ni yutairincha susatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura achikmau ainauncha angkanmamtikiatnuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii Apuri wainmichu ainaun wainmamtikiatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura iyaaru ainauncha inankitnuitai.","poem":1},{"lineBreak":true},{"text":"Tura anangmichu ainauncha aneetnuitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura chikich nungkanmaya ainauncha wainkatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura mitaik ainauncha tura waje ainauncha ni yuumamurincha susatnuitai.","poem":1},{"lineBreak":true},{"text":"Antsu pasé aints ainaunka mengkaaktinuitai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yuse aintsri ainautirmin ii Apuri tuke inatmartinuitrume.","poem":1},{"lineBreak":true},{"text":"Tura atumi Yusri tuke inangnatsuk mash nungkanmaya ainaun inartinuitai.","poem":1},{"lineBreak":true},{"text":"¡Ii Apuri warartusmi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":9}