{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":15,"content":[{"type":"heading","content":["David: Yus aints ainau tu pujusarti tusa wakerawai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru ¿ya aints ainawa amijaisha pujusartincha ainawa? ¿Ya aints ainawa ami murarmin pengker aa nunisha matsamsartincha ainawa?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Aints amijai pujusartinka nu ainawai:","poem":1},{"lineBreak":true},{"text":"Amin miatrusarang umirtamkaru ainia nu,","poem":1},{"lineBreak":true},{"text":"tura pengkeran takau ainia nusha,","poem":1},{"lineBreak":true},{"text":"tura tuke nintijai waitrutsuk chichau ainia nu ainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura chikichan pachisar pasé chicharinachu,","poem":1},{"lineBreak":true},{"text":"tura nijai tsaniasar pujuinaun pasé awajinachu,","poem":1},{"lineBreak":true},{"text":"tura ni irutkamurin inatsarchau ainia nuka nu ainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yus nakita nuna nu aints ainauka nakitin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu Yusen umirinaunka pengker awajin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura wi turatatjai tina nunasha yuuminayat mash timiatrusarang umiinawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura kuikiarin chikich ainaun suinak:","poem":1},{"lineBreak":true},{"text":"Tumashnum akirkum nuna nangkamasmek nukap akirkata tinatsui.","poem":1},{"lineBreak":true},{"text":"Tura chikich aintsun tsanuminak,","poem":1},{"lineBreak":true},{"text":"amesha nunismek chichasta tusar,","poem":1},{"lineBreak":true},{"text":"kuikian susatasar wakerinamtaikia:","poem":1},{"lineBreak":true},{"text":"Tsa, nunaka turashtatjai tinawai.","poem":1},{"lineBreak":true},{"text":"Aints tu pujuinauka tuke pengké natsaarchatin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}