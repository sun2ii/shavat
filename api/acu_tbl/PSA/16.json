{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":16,"content":[{"type":"heading","content":["David: Apuru ameketme wina mash surus tinmeka timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina ayamrutkatin asakmin,","poem":1},{"lineBreak":true},{"text":"waitkata tusan seajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wikia amin chicharkun:","poem":1},{"lineBreak":true},{"text":"“Ametme wina Apur.","poem":1},{"lineBreak":true},{"text":"Ame timiá pengkeraitme.","poem":1},{"lineBreak":true},{"text":"Amijai metekka kichkisha atsawai”, timiajme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ame wina chichartakum:","poem":1},{"lineBreak":true},{"text":"“Wina aintsur ju nungkanam umirtukaru asar,","poem":1},{"lineBreak":true},{"text":"pengker awajtu weenawai”,","poem":1},{"lineBreak":true},{"text":"turutmiame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aints ainau Yuschau waininayat chikich yusen umirina nuka nukap wait wajakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Ni yusrin:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titasar tangkun mainamtaikia,","poem":1},{"lineBreak":true},{"text":"wikia nuningkia pengké pachinkashtatjai.","poem":1},{"lineBreak":true},{"text":"Tura ni yusri naarincha pengké inaikiashtatjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru ameketme wina mash surustinmeka.","poem":1},{"lineBreak":true},{"text":"Nekas pengker ainia nuka winaka nukap surusuitme.","poem":1},{"lineBreak":true},{"text":"Wina pujutruka aminuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus wina pujutrun nekas pengker aa nunaka surusmiayi.","poem":1},{"lineBreak":true},{"text":"Wi pujustiniun Yus surusmia nuka nekas shiirmaitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus: Tu pujusta tusa wina jintintrau asamtai,","poem":1},{"lineBreak":true},{"text":"wikia Yusrun:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram titatjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai kashisha Yus wina nintirun nintimtikrawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wina Apurun tuke wijai pujaun wainuyajai.","poem":1},{"lineBreak":true},{"text":"Niisha wina untsurunini pujurtau asamtai,","poem":1},{"lineBreak":true},{"text":"wikia pengké mengkakashtatjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura wina nintirun pujurtau asamtai waraajai.","poem":1},{"lineBreak":true},{"text":"Tura pengker nintimsan chichaaknasha warawarat chichaajai.","poem":1},{"lineBreak":true},{"text":"Nunia nantaktinuapitja tau asan,","poem":1},{"lineBreak":true},{"text":"jakancha pengker nintimsan ayamsatnuapitja tajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusru wina wakantrusha jakatniunmaka ukurtuschatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura ami inatiram nekas pengker asamtai,","poem":1},{"lineBreak":true},{"text":"ni namangkesha kaurti tusamka tsangkamrukchatnuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura jinta tuke iwiaaku pujustinnum jeatnuka inaktursatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura tuke wijai pujau asam waramtikrustinuitme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}