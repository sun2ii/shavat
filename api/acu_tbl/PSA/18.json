{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":18,"content":[{"type":"heading","content":["Apu David ni nemase ainaun nepetak kantamamuri18.0 2 Sam 22.1-51"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina kakarmarka ametme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin wikia aneajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ametme wina ayamtikrurtin.","poem":1},{"lineBreak":true},{"text":"Ametme wina uwemtikrurtin.","poem":1},{"lineBreak":true},{"text":"Ametme wina angkanmamtikruatin.","poem":1},{"lineBreak":true},{"text":"Ametme wina Yusur.","poem":1},{"lineBreak":true},{"text":"Ameka pampa muchkachminua tumawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin amin jean ayamsamnawaitjai.","poem":1},{"lineBreak":true},{"text":"Ameka tantaara tumawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asam ami kakarmarmijai wina uwemtikrurtinuitme.","poem":1},{"lineBreak":true},{"text":"Ame mash ainia nu nangkakau asam,","poem":1},{"lineBreak":true},{"text":"wina ejarkatnuitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru amin mash aints ainau:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turamiartinuitai.","poem":1},{"lineBreak":true},{"text":"Wina nemasur wininamtai,","poem":1},{"lineBreak":true},{"text":"wi amin untsuam uwemtikrame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mangkartin ainau timiá untsuri wina mantuwartas winitrinamtai,","poem":1},{"lineBreak":true},{"text":"wikia jakatatjapi tusan shamkamiajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jata achirkawa nunisnak,","poem":1},{"lineBreak":true},{"text":"tura kuntin ejatkanam achikmawa nunisnak nekapmamramiajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura timiá shamakun Apurun:","poem":1},{"lineBreak":true},{"text":"Yainkata tusan untsukmiajai.","poem":1},{"lineBreak":true},{"text":"Tura ni pujamurinia wina Yusur untsumaurun anturtukmiayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi turamtai nungka kakar uurkamiayi.","poem":1},{"lineBreak":true},{"text":"Tura uurmatai mura ainau kakarman muchitkarmiayi.","poem":1},{"lineBreak":true},{"text":"Yus pasé aints ainaun kajerkau asa nungkan muchkamiayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni nujinia mukunit shamai jiinua tumauyayi.","poem":1},{"lineBreak":true},{"text":"Tura ni jangkenia ji kairia nunisang meskartin jiinua tumauyayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nayaimpinam pujuutiat Yus kuanki mukunit shuwinnum wajawa tumauyayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tura ni awemamuri querubínnum keemas Yus nanamua tumauyayi.","poem":1},{"lineBreak":true},{"text":"Tura querubínkia nanapejai nasenam pachinak nanaamiayi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura mukunit shuwinnum yumi jiturtas kajintramunam Yus anumkawa tumauyayi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Turasha Yus ni pujutirin keemas charim kakar etsantua tumauyayi.","poem":1},{"lineBreak":true},{"text":"Turamtai mukuntiunmaya micha kaya tumau ji kairi ainaujai pachimramu kakeerarmiayi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yus nayaimpinam puja nu ipiamtajai ni chichaamurin antumtikiamiayi.","poem":1},{"lineBreak":true},{"text":"Turamtai mukuntiunmaya micha kaya tumau ji kairi keemakmau ainaujai kakeerarmiayi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tura chaarim nangkia tumau ayaararti tusa akupkamiayi.","poem":1},{"lineBreak":true},{"text":"Turamtai wina nemasur ainauka shaminak atu atu tupikiararmiayi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yus kakar chichaak nasen timiá kakarman umpumtikiam,","poem":1},{"lineBreak":true},{"text":"juun entsa kunari warukuita tusa paan wainmamtikiamiayi.","poem":1},{"lineBreak":true},{"text":"Turasha juun entsa nitkarinini nungka paan amiayi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nunia Yus nayaimpinam pujus tsuntsuma aints juun entsanam jakenaun achikiar juwina nunisang ni uwejen kutsmar wina achirak nemasur ainamunmaya uwemtikrurmiayi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tura nemasur ainauka timiá kakaram armia nuka wina kajertukar pujuinamunmaya uwemtikrurmiayi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau nepetukartas wakerinamtai,","poem":1},{"lineBreak":true},{"text":"pengké uwemrachmin pujai,","poem":1},{"lineBreak":true},{"text":"Apurka winaka yainkamiayi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tura angkanmamtikruamiayi,","poem":1},{"lineBreak":true},{"text":"tura wina anentu asa Yus uwemtikrurmiayi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wikia Yusrunka pengké ukukchamiajai.","poem":1},{"lineBreak":true},{"text":"Tura Yusnaka umirtan nakitajai pengké tichauyajai.","poem":1},{"lineBreak":true},{"text":"Wi pengker pujau asan,","poem":1},{"lineBreak":true},{"text":"tura Yuse jintin amaku asamtai,","poem":1},{"lineBreak":true},{"text":"Apur winaka pengker awajtusmiayi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ni umirkatin chichamnasha kajinmichuitjai.","poem":1},{"lineBreak":true},{"text":"Tura nu chichamnasha pengké inaisachuitjai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tura nekasan Yusen nintimsan tuke pengker pujuyajai.","poem":1},{"lineBreak":true},{"text":"Tura asan tunaunaka nakitnuyajai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wi Yusen nintimsan pengker pujau asamtai,","poem":1},{"lineBreak":true},{"text":"winaka pengker awajtusmiayi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apuru amin umirtaminauka amesha ajapamka ukuatsme.","poem":1},{"lineBreak":true},{"text":"Tura amin pengker awajtaminak pujuinauka amesha pengker awajme.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tura ame pengké anangkartichu asam,","poem":1},{"lineBreak":true},{"text":"anangkartichu ainauka tuke yayaame.","poem":1},{"lineBreak":true},{"text":"Antsu anangkartin ainau aminu nekamtairumjai nepeteame.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ameka mianchau ainau uwemtikratnuitme.","poem":1},{"lineBreak":true},{"text":"Antsu wikia miajuitjai tumamin ainau mianchau arti tusam inatsaartinuitme.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Apuru ame ji kapawa nunisketme.","poem":1},{"lineBreak":true},{"text":"Yusru wikia itiurkachminum pujamtai,","poem":1},{"lineBreak":true},{"text":"winaka paan nintimtikrurtinuitme.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tura asakmin ami yaimkemjai wina nemasur ainaun nepetkatnuitjai.","poem":1},{"lineBreak":true},{"text":"Tura ni yaktari wenurmau wainiatnak wayaatnuitjai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yuse jintingkia nekas pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Yuse chichamengka nekas waitchau ainawai.","poem":1},{"lineBreak":true},{"text":"Aints ainau niin nekasampita tusar nintiminaunka Yus ejaktinuitai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¿Chikich yus iin ayamrutmaktincha awak?","poem":1},{"lineBreak":true},{"text":"Atsa, chikich yuska ii Apurijai metekka pengké atsawai.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wina kakarmarun surustinka Yusketai.","poem":1},{"lineBreak":true},{"text":"Wina pujutru iwiasmatrukchatnuka nuketai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Japa tsekengki wekaawa nunisang wina kakamtikrurtinka Yusketai.","poem":1},{"lineBreak":true},{"text":"Tura mura wakancha ayaatsuk wekaamtikrustinka nuketai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Wi mesetnum weamtai:","poem":1},{"lineBreak":true},{"text":"Tu maaniata tusa wina jintintruatnuka Yusketai.","poem":1},{"lineBreak":true},{"text":"Tura kunturun kakamtikrurtincha nuketai.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yusru ame wina uwemtikrinuyame.","poem":1},{"lineBreak":true},{"text":"Tura untsur uwejmijai wina inantinuyame.","poem":1},{"lineBreak":true},{"text":"Tura wait anentruram wina pengker awajtinuyame.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Wi wekaamtai angkan wekaasata tusam waitkamiame.","poem":1},{"lineBreak":true},{"text":"Turasha nungkanam ayaaraim tusam nawer kakamtikrurume.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Tura asakmin wina nemasur ainaun papeekan amankiamiajai.","poem":1},{"lineBreak":true},{"text":"Tura mash amukan waketkimiajai.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Niin charukarmau asar pengké nantakcharmiayi.","poem":1},{"lineBreak":true},{"text":"Antsu wina nawerun ayaamsar ayaararmiayi.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Yusru wi mesetnum weamtai ame kakamtikrurmiame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin wina umirtutan nakitin ainau wina tsuntsumrutawarmiayi.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau winiangka tupikiakiarti tusam tsangkamkamiame.","poem":1},{"lineBreak":true},{"text":"Nu tsangkamkau asakmin,","poem":1},{"lineBreak":true},{"text":"wina kajertin ainaun amukmiajai.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ayamrutkata tinamaitiatang,","poem":1},{"lineBreak":true},{"text":"aints kichkisha ayamrukcharmiayi.","poem":1},{"lineBreak":true},{"text":"Tura Yusnasha untsuinamaitiat niisha aikchamiayi.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Tura asamtai wikia nase umpuak nungka tsetserin juwawa nunisnak nu aints ainaun nepetkan turan nungka mirachia nunisnak najarmiajai.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Tura asamtai ame Apuru nu aints amin umirtamchau ainamunmaya uwemtikrurmiame.","poem":1},{"lineBreak":true},{"text":"Tura nu nungkanmaya ainau apuri ati tusam inaitukmiame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin wainchati aints ainauka wina inatir ainawai.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Turasha wina chichamrun antukar umirtinawai.","poem":1},{"lineBreak":true},{"text":"Tura chikich nungkanmaya ainausha wina pengker awajtinawai.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Nu aints ainauka sapijminawai.","poem":1},{"lineBreak":true},{"text":"Tura kurainak ni anumkamurinia jiininawai.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Ii Apuringkia tuke pujuuwitai.","poem":1},{"lineBreak":true},{"text":"Iin Ayamtikiartin asa,","poem":1},{"lineBreak":true},{"text":"timiá pengkeraitai tajai.","poem":1},{"lineBreak":true},{"text":"Turasha wina Yusur wina uwemtikrurtin asamtai,","poem":1},{"lineBreak":true},{"text":"ameketme juuntam tajai.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Yus chikich nungkanmaya ainaun nepetkau asa,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainaunka yapaijkiamiayi.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau kajertinamunmaya Yus wina uwemtikrurmiayi.","poem":1},{"lineBreak":true},{"text":"Tura chichaman umichu ainau wina nepetukartas wakerutiarmia nu aintsnumia ayamtikrurmiayi.","poem":1},{"lineBreak":true},{"text":"Ame Apuru mangkartin ainamunmaya tuke uwemtikrame.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Tura asakmin mash nungkanmaya ainau iruntramunam amin:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tajame.","poem":1},{"lineBreak":true},{"text":"Tura amin naarmin pachisan kantan kantamruatjame.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ame apu ata tusam wina inaituku asam,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau nepetkata tusam kakamtikrinuyame.","poem":1},{"lineBreak":true},{"text":"Tura asam winasha tura wina wear ainausha tuke ami anengkratairumjai pengker awajnuyame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":49}