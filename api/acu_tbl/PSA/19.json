{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":19,"content":[{"type":"heading","content":["David: Yus najanamia nujai ni kakarmarin paan inakmawai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Nayaim jiisar Yuse kakarmari paan nekaamnawaitji.","poem":1},{"lineBreak":true},{"text":"Tura nayaim jiisar,","poem":1},{"lineBreak":true},{"text":"Yus najanamu pengkeraitai titinuitji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kashincha kashincha tsawaarkur Yus juuntaitai titinuitji.","poem":1},{"lineBreak":true},{"text":"Tura kashincha kashincha kintamkur Yus kakarmaitai titinuitji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chichamengka anturchayatrik,","poem":1},{"lineBreak":true},{"text":"Yus ni najanamuri mash nungkanam nekamtikiamu asar,","poem":1},{"lineBreak":true},{"text":"mash nungkanmaya ainausha nuna wainkar antukarminuitai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nayaimpinam Yus tsaanka puusamiayi.","poem":1},{"lineBreak":true},{"text":"Aints yamai nuwan nuwatak ni kanutirinia nantawa nunisang tsaangka kashik taakui.","poem":1},{"lineBreak":true},{"text":"Tura aints kakaram ni nemase ainaun nepetkatas ni pujutirinia jiinua nunisang tsaangka jiinui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsaangka yakí waka nunia ataksha jeawai.","poem":1},{"lineBreak":true},{"text":"Tura tsaa timiá tsuwer asamtai,","poem":1},{"lineBreak":true},{"text":"pengké anumkachminuitji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus iin nuitamramuka nekas pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Tura asa pujut yamarman suramsatnuitji.","poem":1},{"lineBreak":true},{"text":"Yus chichaman akupa nuka nekasaintai.","poem":1},{"lineBreak":true},{"text":"Tura asa nekachu ainaun nintimtikratnuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus turataram ta nuka pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai nu chichaman antukaru ainauka nuna nintimsar warainawai.","poem":1},{"lineBreak":true},{"text":"Yuse chichamengka pengker asa,","poem":1},{"lineBreak":true},{"text":"aints ainaun paan nintimtikratnuitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yus umirmauka nekas pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Tura ni chichamengka tuke nangkankashtin asamtai,","poem":1},{"lineBreak":true},{"text":"Yus umirtuktaram ta nuka nekas pengkeraitai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yuse chichamengka kuri nangkamasang timiá pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Tura wapasa nangkamasang timiá pengker asamtai nukap wakeruktinuitai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wikia ami inatiram asan,","poem":1},{"lineBreak":true},{"text":"ami chichamin nekaan,","poem":1},{"lineBreak":true},{"text":"tunaachawa nunisnak pujustasan wakerajai.","poem":1},{"lineBreak":true},{"text":"Tura nu chichaman umirkanka,","poem":1},{"lineBreak":true},{"text":"pengker pujustinuitjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aints ningki nintimsangka ni tunaarinka nekaachminuitai.","poem":1},{"lineBreak":true},{"text":"Apuru wi nekachu asan,","poem":1},{"lineBreak":true},{"text":"nuwakan tunaun turinuyaja nuka tsangkutrurta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tura ami inatiram asamtai,","poem":1},{"lineBreak":true},{"text":"wikia miajuitjai tutairuka jurutkita.","poem":1},{"lineBreak":true},{"text":"Nu tunaun wakerutsuk pujusat tusam jurutrukin asakmin,","poem":1},{"lineBreak":true},{"text":"wikia juun tunau ayatnak tunaarinchau wajastinuitjai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apuru wina ayamrutkatin asam,","poem":1},{"lineBreak":true},{"text":"tura wina uwemtikrurtin asam,","poem":1},{"lineBreak":true},{"text":"wina chichamur tura wina nintimtair nekas pengker arti tusam nintimtikrurta tajame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":13}