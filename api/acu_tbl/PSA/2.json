{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":2,"content":[{"type":"heading","content":["Ameka wina Uchiruitme"]},{"type":"verse","number":1,"content":[{"text":"¿Waruka Yusen umirchau ainau Yusen kajerkar shininawa? ¿Tura warukaya nangkamiarsha nintiminawa?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mash nungkanmaya apu ainau aintsun inau ainaujai kaunkar","poem":1},{"lineBreak":true},{"text":"Yus ni Uchirin:","poem":1},{"lineBreak":true},{"text":"Apu ati tusa akupkamu waininayat kajerinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Turasha Yusen umirtan nakitinau asar","poem":1},{"lineBreak":true},{"text":"kakarar untsuminak:","poem":1},{"lineBreak":true},{"text":"“Yus iin jirujai jingkiatmamuringkia yamaikia atimiami,","poem":1},{"lineBreak":true},{"text":"turar nuniangka angkan wajasmi”,","poem":1},{"lineBreak":true},{"text":"nangkamiar tinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tinau wainiat Apu Yus nayaimpinam pujus aints ainaun ina nuka","poem":1},{"lineBreak":true},{"text":"nuna antuk wishikiawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunia nu aints ainaunka kakarman kajerak","poem":1},{"lineBreak":true},{"text":"Yus awaakatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura chicharak:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Wikia yanchuik wina akupkamurnaka Jerusalénnum mura pengkernum aints ainau Apuri ati tusan puusamiajai”, tawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yamaikia Yus ni uchirin pachis ta nuna etserkatjai.","poem":1},{"lineBreak":true},{"text":"Ni uchirin chicharak:","poem":1},{"lineBreak":true},{"text":"“Ameka wina nekas uchiruitme.","poem":1},{"lineBreak":true},{"text":"Ju kintati wina kakarmarun suajme”.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Mash nungkanmaya ainau winar arti tusam wina seattia.","poem":1},{"lineBreak":true},{"text":"Turakminkia wikia aminka susatnuitjame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura apu wajasam","poem":1},{"lineBreak":true},{"text":"aints kajek nangkijai muitsan awati tsayawa nunismek","poem":1},{"lineBreak":true},{"text":"apu ainauka mengkaktinuitme”,","poem":1},{"lineBreak":true},{"text":"Yus ni uchirin tawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apu ainautiram,","poem":1},{"lineBreak":true},{"text":"aints inau ainautirmesha","poem":1},{"lineBreak":true},{"text":"ju chichamka antuktaram.","poem":1},{"lineBreak":true},{"text":"Tura tenapkesrum nuimiartaram.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura pengker nintimsaram Yus:","poem":1},{"lineBreak":true},{"text":"Ameketme Apum titaram.","poem":1},{"lineBreak":true},{"text":"Ni aneachmau atumnaka kajertamkatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wina kajertukai tusaram tsuntsumruataram.","poem":1},{"lineBreak":true},{"text":"Nu turachkurminkia Yus atumin kajertamkamtai,","poem":1},{"lineBreak":true},{"text":"atumka jintá wekaakuram aneachmau jakai tusaram aneartaram.","poem":1},{"lineBreak":true},{"text":"Antsu aints Yusen nintimsar:","poem":1},{"lineBreak":true},{"text":"Wina Yusruka wina uwemtikrurtinuitai tinauka warasartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}