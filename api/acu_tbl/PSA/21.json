{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":21,"content":[{"type":"heading","content":["David: Yusru amin kajertamin ainau nepetkata timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru ame apu kakamtikramu asa,","poem":1},{"lineBreak":true},{"text":"apuka pengker nintimias pujawai.","poem":1},{"lineBreak":true},{"text":"Tura ni nemase nepetkau asakmin nekas waraawai.","poem":1},{"lineBreak":true},{"text":"Tura ni wakeramuri mash umikume.","poem":1},{"lineBreak":true},{"text":"Tura amin seatmausha suritkachume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura apu nekasam pengker awajnuyame.","poem":1},{"lineBreak":true},{"text":"Tura tsengkruti kuri najanamu tsengkrukti tusam tsangkatkamiame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apu amin untsuri musach pujustasan wakerajai tusa seatmimiayi.","poem":1},{"lineBreak":true},{"text":"Turamtai untsuri musach pujusti tusam tsangakatkamiame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yusru ame apu yaingmau asa nekas kakarmaitai.","poem":1},{"lineBreak":true},{"text":"Tura niin pengker awajsamu asa,","poem":1},{"lineBreak":true},{"text":"nekas ni aintsri ainaun pengker inawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura ni tuke yaingku asam,","poem":1},{"lineBreak":true},{"text":"ame nijai pujusam waramtiknuyame.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apu amin umirtamkau asamtai,","poem":1},{"lineBreak":true},{"text":"amesha ni ajapamka ukukchatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura ame nayaimpinam pujau asakmin,","poem":1},{"lineBreak":true},{"text":"ami anengkratairmin nintimias pujawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ami nemasem ainauka ami kakarmarmijai nepetkamnawaitme.","poem":1},{"lineBreak":true},{"text":"Turasha amin kajertaminak pujuinauka ami untsur uwejmijai nepetkamnawaitme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura ami nemasem ainau nepetkam,","poem":1},{"lineBreak":true},{"text":"ni tunaarijai metek wait wajakarti tusam,","poem":1},{"lineBreak":true},{"text":"ji kapaamunam engkeatnuitme.","poem":1},{"lineBreak":true},{"text":"Ame turakmin nu aints ainauka ji timiá tsuwernum amukartin ainawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nu aints ainau uchiri tura ni weari ainausha mash amuktinuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura tupikiakiarti tusam,","poem":1},{"lineBreak":true},{"text":"ami tishimkurmijai nu aints ainau awaakau asakmin,","poem":1},{"lineBreak":true},{"text":"amin pasé awajtamsartas wakerinayat,","poem":1},{"lineBreak":true},{"text":"turasha iisha turami tusar chichaman najanawariat,","poem":1},{"lineBreak":true},{"text":"nuna turatatkamawar tujinkartinuitai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yusru wajakim amin kajertamin ainau ami kakarmarmijai nepetkau ata.","poem":1},{"lineBreak":true},{"text":"Ame nu aints ainau nepetkakminkia kanta kantamatatji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":11}