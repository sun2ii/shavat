{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":22,"content":[{"type":"heading","content":["David: Yusru Yusru ¿waruka ajapruamsha ukurme? timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru Yusru ¿waruka ajapruamsha ukurme? ¿Waruka uwemtikrurtasam winatsme? ¿Waruka wi juutmaursha pachiatsme?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yusru tsawaisha tura kashisha amin untsuamsha","poem":1},{"lineBreak":true},{"text":"airu weatsme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin ayamsatatkaman tujintajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Antsu ameka pengkeraitme.","poem":1},{"lineBreak":true},{"text":"Ameka Israel ainau inawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin Israel ainau amincha:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turaminawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ii juuntri ainauka amincha:","poem":1},{"lineBreak":true},{"text":"Nekasampitme tusar nintimturmin armiayi.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai ameka ni angkanmamtiknuyame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amincha yainkata tusar seatminamtai angkan pujusarti tusam yaingmiame.","poem":1},{"lineBreak":true},{"text":"Amin nekasampita tusar nintimraru asaramtai,","poem":1},{"lineBreak":true},{"text":"ameka ni ajapamka ukuchuyame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Antsu wikia aintsua tumauchuitjai,","poem":1},{"lineBreak":true},{"text":"antsu maachia tumau asan kakaichuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai aints ainau wina wishikrinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura wina waitkar muuken pearar etserar wishikrinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura chichainak:","poem":1},{"lineBreak":true},{"text":"“Yusnaka nekas nintimtinuyayi.","poem":1},{"lineBreak":true},{"text":"Watska Yus niin angkanmamtikiati.","poem":1},{"lineBreak":true},{"text":"Yus niin aneakka nekas uwemtikrati” tinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Antsu wina pachitsam:","poem":1},{"lineBreak":true},{"text":"Ni nukuri ampujenia akiinati,","poem":1},{"lineBreak":true},{"text":"tura ni nukuri muntsuri muntsati tusam,","poem":1},{"lineBreak":true},{"text":"nuni nangkamsamek winaka waitnuyame.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wi akiintsaing ameka winaka waitnuyame.","poem":1},{"lineBreak":true},{"text":"Tura wina nukuru ampujen pujaisha tuke wina Yusruyame.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wina waitkarawartin ainauka arakchichu wajainawai.","poem":1},{"lineBreak":true},{"text":"Tura wina yainkatnuka atsawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wait aneasam winaka ajapruamka ukurkiip.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Basan nungkanmaya waaka aishmangkri nekas kajeu ainia nunisarang wina nemasur ainau tentatkar pujuinawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Juun yawaa kajeu kuntinun yuwatas winawa nunisarang wina nemasur ainausha winitrinawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wikia yumi nungkanam ukarmawa nunisketjai.","poem":1},{"lineBreak":true},{"text":"Tura wina ukunchruka kuitkamua nunisarang ainawai.","poem":1},{"lineBreak":true},{"text":"Tura macha tseeram yumia tumau wajawa nunisang wina nintirka kakarchamin nekapeawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wina suwerka nungka tsetseria nunisang mujuawai.","poem":1},{"lineBreak":true},{"text":"Tura inairusha muchikchamin mayatairun nepeturkayi.","poem":1},{"lineBreak":true},{"text":"Tura nungka tsetserin engketamua nunisnak wikia jakamin nekapeajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pasé aints iruntrar yawaaya nunisarang wina jiinkichmin tententawaru asaramtai,","poem":1},{"lineBreak":true},{"text":"wina uwejruncha tura nawernasha chingkiarawarua nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wina ukunchur ainauncha nekapmarminuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wina kajertin ainauka tuke jiiru pujuinawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tura yáki entsatiri jukit tusar suerte nakurusar,","poem":1},{"lineBreak":true},{"text":"wina entsatirun jurutkiarmiayi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Antsu ametme wina kakamtikrurtin.","poem":1},{"lineBreak":true},{"text":"¡Yusru ukurkiip! ¡Wina yainkatin asam wári tarata!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wina kajertin ainauka ni nangkirijai maawarai tusam uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Tura yawaaya nunisarang maawarai tusam surimrukta.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nuka juun yawaaya nunisarang asaramtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainamunmaya uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Tura waaka aishmangkri kajeu ni pupuntrijai aintsun maamnawa nunisarang asaramtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainamunmaya ayamrutkata.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ame turakminkia wina yatsur ainaun amin pachisan ujaktinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura amin umirtamkaru ainaujai iruntran kantan kantamruatnuitjame.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aints mianchau ainau wait wajainau asaramtai,","poem":1},{"lineBreak":true},{"text":"Yuska ukutsuk wait anentawai.","poem":1},{"lineBreak":true},{"text":"Tura ni yainkata tusar untsumaurincha anturui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Jacobo weari ainautiram,","poem":1},{"lineBreak":true},{"text":"Yus nintimtau asaram:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titaram.","poem":1},{"lineBreak":true},{"text":"Tura ameketme Apum titaram.","poem":1},{"lineBreak":true},{"text":"Tura Israela weari asaram:","poem":1},{"lineBreak":true},{"text":"Ameketme ii Yusrim titaram.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yusru aints untsuri amin umirtaminak pujuinamunam wikia amin pachisan:","poem":1},{"lineBreak":true},{"text":"Ami chichammin nekasam umikume titatjai.","poem":1},{"lineBreak":true},{"text":"Amin ameketme juuntam turamin ainamunam wi turatatjai timiaja nunaka umiktatjai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wait wajau ainautiram,","poem":1},{"lineBreak":true},{"text":"nukap yuwaram atumsha tutuartaram.","poem":1},{"lineBreak":true},{"text":"Tura Yus eautiram Yus:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titaram.","poem":1},{"lineBreak":true},{"text":"Turaram nukap musach pujustaram.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mash nungkanmaya ainautiram,","poem":1},{"lineBreak":true},{"text":"tura niish niish chichau ainautiram,","poem":1},{"lineBreak":true},{"text":"Yus kajinmatsuk nintimraram ni seatasrum tikishmatrataram.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ii Yusri mash nungkanmaya ainau Apuri asa,","poem":1},{"lineBreak":true},{"text":"mash aints ainaun inawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yamaikia yuumatsuk pujuinautirmincha tajarme:","poem":1},{"lineBreak":true},{"text":"Atumkeka iwiaakuka pujuschamnawaitrume.","poem":1},{"lineBreak":true},{"text":"Antsu jakaram nungka tsetseri najanartinuitrume.","poem":1},{"lineBreak":true},{"text":"Tura asaram atumsha tsuntsumaram:","poem":1},{"lineBreak":true},{"text":"Yus ningki mash aints ainau Apurintai titaram.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wi wear ainau Yusen ameketme juuntam tiartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura iwiaaku pujuinauka tuke niin pachisar chichasartin ainawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tura ukunam akiinatin ainausha Yusen pachisar:","poem":1},{"lineBreak":true},{"text":"Nekas pengker asa,","poem":1},{"lineBreak":true},{"text":"ni aintsri ainaun uwemtiknuyayi tiartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}