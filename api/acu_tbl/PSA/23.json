{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":23,"content":[{"type":"heading","content":["David: Wina Apurka winaka waitui timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wina Apurka uwija wainua nunisang winaka waitui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wisha yuumakchatatjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uwijan wainin ni uwijarin chirichrin yuwarat tusa weka wekaaka ayamsarti tusa,","poem":1},{"lineBreak":true},{"text":"nunia mikinnum juwawa nunisang wina Apursha winasha ayamtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura yumin umurarat tusa,","poem":1},{"lineBreak":true},{"text":"uwija wainin ni uwijarin entsa miaakunam juwawa nunisang wina Apurka yuumamurnasha surustinuitai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura nintirnasha","poem":1},{"lineBreak":true},{"text":"kakamtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni naarin pachisar:","poem":1},{"lineBreak":true},{"text":"Yuska nekas juuntaitai tiarat tusa,","poem":1},{"lineBreak":true},{"text":"nekas pengker jintanam wekaasat tusa winaka nintimtikrurtinuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru wijai tuke puju asam,","poem":1},{"lineBreak":true},{"text":"uwijan wainin ni uwijarin ayamruktas numichin tura shukrutin takus naka wajawa nunismek winasha ayamrutkatasam waitkatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin jakatin ayatnak,","poem":1},{"lineBreak":true},{"text":"tura wait wajaktin ayatnak shamkashtinuitjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau jimia wajainai wainiatmek,","poem":1},{"lineBreak":true},{"text":"ame pengker aa nu surusuitme.","poem":1},{"lineBreak":true},{"text":"Tura apun inaikiartas olivo macharijai muuken ukatinawa nunismek winaka pengker awajtusuitme.","poem":1},{"lineBreak":true},{"text":"Tura aints piningnum umutai yaraamun wainak waraawa nunismek nukap waramtikrustinuitme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ame wina pengker awajtusu asakmin,","poem":1},{"lineBreak":true},{"text":"tura wait anengkratin asakmin,","poem":1},{"lineBreak":true},{"text":"wikia iwiaaku pujaknaka nunaka tuke nintimsan pujustinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura wina Apur asakmin, jakancha tuke ami jeemin iwiaaku pujustinuitjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}