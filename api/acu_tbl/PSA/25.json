{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":25,"content":[{"type":"heading","content":["David: Yus ni jintin inaktursat tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Apuru amin seajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yusru amin nintimtajme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wina nemasur ainau inatsturarai tura wishikrurarai tusam tsangkamrukaip.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura amin nekasampita tinu ainaun kichkisha inatsararai tusam tsangkamkaip.","poem":1},{"lineBreak":true},{"text":"Antsu amin umirtamchau ainauka natsararti tusam tsangkamkata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru ami jintim inaktursata.","poem":1},{"lineBreak":true},{"text":"Tura jintim wekaasata tusam jintintruata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"tura wina Uwemtikrurtin asam,","poem":1},{"lineBreak":true},{"text":"ami chichamim nekas aa nu nuiturta.","poem":1},{"lineBreak":true},{"text":"Kintajai metek amin nintimtajme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apuru ame tuke wait anengkratin asam,","poem":1},{"lineBreak":true},{"text":"ame iin pengker awajkartusmauka kajinmakiip.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi natsa asan,","poem":1},{"lineBreak":true},{"text":"pasé turamiaja nuka nintimtsuk asata.","poem":1},{"lineBreak":true},{"text":"Antsu nekasam wait anengkratin asam,","poem":1},{"lineBreak":true},{"text":"tura pengker asam wina kajinmatrukiip.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii Apuringkia pengkeraitai,","poem":1},{"lineBreak":true},{"text":"tura nekas tunaarinchawaitai.","poem":1},{"lineBreak":true},{"text":"Tura asa tunaarintin ainaun:","poem":1},{"lineBreak":true},{"text":"Pengker pujustaram tusa chicharui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura jampechu ainaun:","poem":1},{"lineBreak":true},{"text":"Juwaitai wina jintarka tusa inaktawai.","poem":1},{"lineBreak":true},{"text":"Tura wina wakeramurka nuwaitai tusa nuikiartawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tura ni chichamen umirin ainaun Yuska tuke aneawai,","poem":1},{"lineBreak":true},{"text":"tura nekas pengker awajui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apuru wikia nekasan juun tunaawitjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai tunaar tsangkutrurta.","poem":1},{"lineBreak":true},{"text":"Amin naarmin pachisan Apuru seajme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aints Yusen umirak pujaunaka Yus: Ju jinta wekaasata tusa inaktawai,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"tura pengker awajui.","poem":1},{"lineBreak":true},{"text":"Tura ni weari nu nungkanam pujuinauncha nu nungka ninu ati tusa suawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yus ni umirin ainautin amikrintai.","poem":1},{"lineBreak":true},{"text":"Tura nu aints ainautin","poem":1},{"lineBreak":true},{"text":"ni umiktin chichaman nintimtikramji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wikia itiurkachmin pujamtaisha,","poem":1},{"lineBreak":true},{"text":"wina Apurka tuke angkanmamtikrurtin asamtai,","poem":1},{"lineBreak":true},{"text":"tuke niin nintimtusan pujajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apuru wiki pujakun waitnasan pujaing wait aneasam jiirsata,","poem":1},{"lineBreak":true},{"text":"turam wait anentrurta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wina nintirka waurkamin nekapeawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai paan nintimrat tusam angkanmamtikruata.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi wake mesekmaurusha ame jiirsata,","poem":1},{"lineBreak":true},{"text":"tura takatruncha yainkata.","poem":1},{"lineBreak":true},{"text":"Turakum wina tunaar ainau tsangkutrurta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tura wina nemasur wina kajertinak mantuwartas wakerinau warutmak ainia tusam jiisarta.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Apuru waitkata tura uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Amin tuke nintimtajme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wina inatsararai tusam surimrukta.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Apuru aminak nintimtau asan,","poem":1},{"lineBreak":true},{"text":"wi amin umirkun tunaarinchau pujamtaikia winaka waitkata.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yusru itiurkachmin pujakrincha,","poem":1},{"lineBreak":true},{"text":"Israel ainautinka tuke uwemtikiartukta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}