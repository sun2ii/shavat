{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":27,"content":[{"type":"heading","content":["Apurka wina paantruitai, tura wina uwemtikrurtinuitai"]},{"type":"verse","number":1,"content":[{"text":"Wina Apurka wina paantruitai.","poem":1},{"lineBreak":true},{"text":"Tura wina uwemtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ¿yanak shamkataj?","poem":1},{"lineBreak":true},{"text":"Wina Apurka wina ayamrutkatin asamtai ¿warinak shamkataj?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pasé aints ainauka wina nakitruraru asar,","poem":1},{"lineBreak":true},{"text":"wina mesturartas tura mantuwartas wakerutinawai.","poem":1},{"lineBreak":true},{"text":"Turinayat tukumkar ayainawa nunisarang ainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Suntar untsuri mesetan najanawartas kaunkar,","poem":1},{"lineBreak":true},{"text":"wina tententawarun wainiatnak,","poem":1},{"lineBreak":true},{"text":"wina nintirka kurarchatnuitai.","poem":1},{"lineBreak":true},{"text":"Antsu angkan napchauka nintimtsuk pujustinuitjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wina Apurnaka kichkinak seayajai.","poem":1},{"lineBreak":true},{"text":"Tura wi seayaja nuka nuwaitai:","poem":1},{"lineBreak":true},{"text":"Iwiaaku pujaknaka wikia aints Yuse jeen pujawa nunisnak kintajai metek Yusen maaketai titasan,","poem":1},{"lineBreak":true},{"text":"tura ni pengkerin wainkatasan","poem":1},{"lineBreak":true},{"text":"tuke wakerajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Itiurkachminum pujamtaisha wina Apurka winaka ejarkatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni jeen jeamtaisha winaka pengker nintimtursatnuitai.","poem":1},{"lineBreak":true},{"text":"Wina Apurka tuke pujú asa,","poem":1},{"lineBreak":true},{"text":"pampa nunisketai.","poem":1},{"lineBreak":true},{"text":"Tumau asamtai wikia Apurun nintimsan aints pampanam yakí wajawa nunisnak uwemran angkan pujustinuitjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tu nintimsan pujaknaka,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau wina","poem":1},{"lineBreak":true},{"text":"tententawaru wainiatnak shamtsuk pangkain jiistinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asan Yuse jeen jean,","poem":1},{"lineBreak":true},{"text":"Yusen maaketai titasan","poem":1},{"lineBreak":true},{"text":"tangkun maan epeatnuitjai.","poem":1},{"lineBreak":true},{"text":"Tura warasan wina Apurun kantan kantamruatnuitjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apuru amin untsuajme.","poem":1},{"lineBreak":true},{"text":"Anturtukta.","poem":1},{"lineBreak":true},{"text":"Wait anentruram airkata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apurun eaktaj tu nintimran,","poem":1},{"lineBreak":true},{"text":"wikia nekasan wina nintirjai amin tuke eajme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru wait aneasam anumrutkaip turasha kajertukaip.","poem":1},{"lineBreak":true},{"text":"Ameketme wina yainkatnumka.","poem":1},{"lineBreak":true},{"text":"Wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"tura wina uwemtikrurtin asam,","poem":1},{"lineBreak":true},{"text":"ajapruam ukurkiip.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wina apar tura wina nukursha ukurkiaramtaisha,","poem":1},{"lineBreak":true},{"text":"ame wina Apur asam,","poem":1},{"lineBreak":true},{"text":"winaka ajapruamka pengké ukurkishtinuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apuru jintim inaktursata.","poem":1},{"lineBreak":true},{"text":"Wina nemasur ainau eatinau asaramtai,","poem":1},{"lineBreak":true},{"text":"jintim nekas pengker aa nuni wekaasata tusam nekaprutata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsanukratin ainau nangkamiar wina pachitsar wait chichaman chichartinau asaramtai,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau ni wakeramurin najaninak,","poem":1},{"lineBreak":true},{"text":"wina mesturarai tusam tsangkamrukaip.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antsu wikia iwiaaku pujaknaka,","poem":1},{"lineBreak":true},{"text":"Apuru ami pengkeerumin nekasnapi wainkatnuitja tusan nekajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tura asan mash aints ainautirmin tajarme:","poem":1},{"lineBreak":true},{"text":"Atumsha Apuram nintimtustaram.","poem":1},{"lineBreak":true},{"text":"Tura kakartaram,","poem":1},{"lineBreak":true},{"text":"turasha atsantrataram.","poem":1},{"lineBreak":true},{"text":"Nekasan tajarme:","poem":1},{"lineBreak":true},{"text":"Apuram nintimtustaram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}