{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":28,"content":[{"type":"heading","content":["David: Yus ii seamuri anturtamji timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina ayamrutkatin asakmin amin untsuajme.","poem":1},{"lineBreak":true},{"text":"Tura wi untsuam airkata.","poem":1},{"lineBreak":true},{"text":"Ame airtsuk pujakminkia,","poem":1},{"lineBreak":true},{"text":"wikia yanchuk jakawa nunisnak nintimramnawaitjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aminu jeem pengker aa nuni wina uwejrun Jerusalenumanini takuin amin:","poem":1},{"lineBreak":true},{"text":"Yainkata tusan untsumkun pujai,","poem":1},{"lineBreak":true},{"text":"wina untsummaur anturtukta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pasé takau ainauka anangminak:","poem":1},{"lineBreak":true},{"text":"Amikmami tusar pengker chichainayat,","poem":1},{"lineBreak":true},{"text":"ni ninti pasé asaramtai,","poem":1},{"lineBreak":true},{"text":"tuke pasé nintiminawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai nu aints ainaujai metek mengkaakatnunmaka akuptukaip.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ni tunau takaamurijai metek ameka yapaijkiata.","poem":1},{"lineBreak":true},{"text":"Tura ni turuwarmia nunisarang ni wait wajakartintri susarta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nu aints ainauka Yuse turamurinka pachischaru asaramtai,","poem":1},{"lineBreak":true},{"text":"ningki nu aints ainaunka mengkaktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ataksha pengké inankishtinuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus wina seamurun anturtuku asamtai:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus kakaram asa wina ejarnuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai niin tuke nintimnuyajai.","poem":1},{"lineBreak":true},{"text":"Wi turamtai winaka yainuyayi.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wina nintirjai waraakun kantan kantamatatjai.","poem":1},{"lineBreak":true},{"text":"Turasha Apurun maaketai titatjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus ni aintsri ainautin kakamtikramratnuitji.","poem":1},{"lineBreak":true},{"text":"Tura asa ii apuri ningki inaikiamia nunaka yaingtinuitai, tura uwemtikratnuitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru ami aintsrum ainautinka uwemtikiartukta,","poem":1},{"lineBreak":true},{"text":"tura pengker awajkartusta.","poem":1},{"lineBreak":true},{"text":"Uwija wainin ni uwijarin tenapkes wainua nunismek iincha waitkratkata.","poem":1},{"lineBreak":true},{"text":"Tura uwija wainin uwija uchirin minakas juwawa nunismek tuke iincha jukartukta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}