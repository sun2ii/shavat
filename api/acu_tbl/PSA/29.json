{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":29,"content":[{"type":"heading","content":["Yuse chichaamuringkia kakarmaitai"]},{"type":"verse","number":1,"content":[{"text":"Nayaimpinam pujuinautiram Yus: Ameketme juuntam","poem":1},{"lineBreak":true},{"text":"titaram.","poem":1},{"lineBreak":true},{"text":"Tura Yus nekas pengkeraitai tusaram:","poem":1},{"lineBreak":true},{"text":"Ameketme kakarmam titaram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Turasha Yuse naari pachisrum:","poem":1},{"lineBreak":true},{"text":"Yus juuntaitai titaram.","poem":1},{"lineBreak":true},{"text":"Tura ni jeen nekas pengker aa nuni jearam:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem titaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuse chichaamuringkia juun entsanmasha antuukamnawaitai.","poem":1},{"lineBreak":true},{"text":"Yus timiá kakaram asa,","poem":1},{"lineBreak":true},{"text":"ipiamtancha akupkamnawaitai,","poem":1},{"lineBreak":true},{"text":"tura juun entsancha inawaitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuse chichaamuringkia nekas kakarmaitai.","poem":1},{"lineBreak":true},{"text":"Ni chichaamuri antukrikia,","poem":1},{"lineBreak":true},{"text":"ni kakarmari tu awai tusar nekaamnawaitji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yus charpin tura nasencha akupak,","poem":1},{"lineBreak":true},{"text":"numi juun wajainauncha tsairminuitai.","poem":1},{"lineBreak":true},{"text":"Tura numi juun mura Líbanon tutainum wajainauncha tsairminuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura mura Líbanon tutaisha tura Sirión tutaisha muchitkarti tusa muchkamnawaitai.","poem":1},{"lineBreak":true},{"text":"Waaka aishmangkri tura waaka uchiri ainau tsekena nunisarang muchitkarti tusa muran peakminuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus chichaakka nayaimpinmaya ji kapaun akupkamnawaitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura nungka Cades tutai entsa atsamunmasha","poem":1},{"lineBreak":true},{"text":"muchkamnawaitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yuse chichaamuringkia numi juun ainaun wainiat pearminuitai.","poem":1},{"lineBreak":true},{"text":"Tura numi ainauncha mash kupirminuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ni jeen kaunkaru ainau mash:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tinawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yus yumincha jiturti tusa akupawai.","poem":1},{"lineBreak":true},{"text":"Tura tuke pujuu asa,","poem":1},{"lineBreak":true},{"text":"mash ainia nuna tuke inartinuitai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yus ni aintsri ainautin ni kakarmarin suramji.","poem":1},{"lineBreak":true},{"text":"Tura ni aintsri ainautin:","poem":1},{"lineBreak":true},{"text":"Tuke angkan pengker nintimsaram pujustaram tusa pengker awajtamji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}