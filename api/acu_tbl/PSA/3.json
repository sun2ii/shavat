{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":3,"content":[{"type":"heading","content":["David: Apuru yainkata tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina nemasur untsuri ainawai.","poem":1},{"lineBreak":true},{"text":"Tura wina nakitrinausha untsuri ainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aints untsuri wina pachitsar chichartinak:","poem":1},{"lineBreak":true},{"text":"“Yuska uwemtikramrashtinuitai”,","poem":1},{"lineBreak":true},{"text":"nangkamiar turutinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Antsu Apuru ameka wina tantaarua nunisketme.","poem":1},{"lineBreak":true},{"text":"Tura asam winaka tententam pujurtame.","poem":1},{"lineBreak":true},{"text":"Ameka wina kakarmaruitme.","poem":1},{"lineBreak":true},{"text":"Wikia napchau nintimsan pujaing,","poem":1},{"lineBreak":true},{"text":"ameka pengker nintimtikrurtinuitme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wikia amin untsukmaikiakun:","poem":1},{"lineBreak":true},{"text":"Yainkata tusan seam,","poem":1},{"lineBreak":true},{"text":"ami pujutiram timiá pengker aa nunia winaka airnuitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ame wina waitu asakmin,","poem":1},{"lineBreak":true},{"text":"tepesan nunia kanuran ataksha shintiaajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau untsuri wina nepetukartas tentatkar pujuinaksha winaka awaktukchartatui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apuru jiirsata.","poem":1},{"lineBreak":true},{"text":"Tura wina Yusur asam uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Wina nemasur ainau aintsu yapiin awatinawa nunismek tura nain akarinawa nunismek nepetkatnuitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru aints ainau uwemtikratnumka ametme.","poem":1},{"lineBreak":true},{"text":"Tura asam aminu aintsrum ainautin pengker awajkartusta,","poem":1},{"lineBreak":true},{"text":"tusan seajme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}