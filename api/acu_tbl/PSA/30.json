{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":30,"content":[{"type":"heading","content":["David: Yusen maaketai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina angkanmamtikruau asakmin,","poem":1},{"lineBreak":true},{"text":"maaketai tajame; tura wina nemasur ainau wishikrarai tusam surimruku asakmin maaketai tajame.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apuru wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"wi seam tsuwaramiame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru ame jakai tusam wina uwemtikrurmiame,","poem":1},{"lineBreak":true},{"text":"tura tsaarta tusam pujut surusmiame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yus umirkau ainautiram,","poem":1},{"lineBreak":true},{"text":"Yus nintimsaram kantamataram.","poem":1},{"lineBreak":true},{"text":"Tura ni naari nekas pengker aa nu pachisrum:","poem":1},{"lineBreak":true},{"text":"Yus juuntaitai titaram.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuska nukapka kajechu asamtai,","poem":1},{"lineBreak":true},{"text":"ni kajekmauri wári nangkankatnuitai.","poem":1},{"lineBreak":true},{"text":"Antsu ni wait anengkratairingkia tuke nangkankashtinuitai.","poem":1},{"lineBreak":true},{"text":"Kashi juutkur pujayatrik tsawaarkurkia warastinuitji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yusru wina pengker awajtusu asakmin,","poem":1},{"lineBreak":true},{"text":"wikia yaanchuik wiki nintimsanak:","poem":1},{"lineBreak":true},{"text":"Maj,","poem":1},{"lineBreak":true},{"text":"wikia tuke angkan pengker pujustinuapitja timiajai.","poem":1},{"lineBreak":true},{"text":"Turayatun ame yaintsuk pujakmin,","poem":1},{"lineBreak":true},{"text":"wikia sapijmiakun napchau nintimsan pujumiajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru amin seajme,","poem":1},{"lineBreak":true},{"text":"tura amin untsuajme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi jakamtaisha ¿winasha pengker awajtustinkitam? Tura wina namangkrun iwiartusaramtaikia,","poem":1},{"lineBreak":true},{"text":"¿wikia amincha maaketai titinuashitjam?","poem":1},{"lineBreak":true},{"text":"Jakaru ainauka aminka maaketai turamiarchatnuitai,","poem":1},{"lineBreak":true},{"text":"tura ameketme pengkeram turamiarchatnuitai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apuru anturtukam,","poem":1},{"lineBreak":true},{"text":"tura wait anentruram yainkata.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apuru wina juutmaur mengkatruku asakmin,","poem":1},{"lineBreak":true},{"text":"yamaikia waraajai.","poem":1},{"lineBreak":true},{"text":"Tura jakamin nintimaur yapaijturau asakmin,","poem":1},{"lineBreak":true},{"text":"yamaikia aints entsatin shiirman entsar,","poem":1},{"lineBreak":true},{"text":"fiestanam weawa nunisnak wikia waraajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura Apuru wina Yusur asakmin,","poem":1},{"lineBreak":true},{"text":"yamaikia chichatsuk pujustatkaman tujintajai.","poem":1},{"lineBreak":true},{"text":"Antsu warasan kantan kantamruatjame,","poem":1},{"lineBreak":true},{"text":"tura amin tuke maaketai titatjame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":11}