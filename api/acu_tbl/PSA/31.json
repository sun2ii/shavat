{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":31,"content":[{"type":"heading","content":["David: Yus nekasampita timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru ame ejarkata tusan seajme.","poem":1},{"lineBreak":true},{"text":"Nunia inatsturaip tusan seajme.","poem":1},{"lineBreak":true},{"text":"Ame nekas pengker asam uwemtikrurta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wait aneasam tsuntsumaam tenap anturtukam,","poem":1},{"lineBreak":true},{"text":"wári angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Aints pampanam wajas angkan wajawa nunismek wina ejarkata.","poem":1},{"lineBreak":true},{"text":"Tura aints jea wenurmaunum ni nemasen shamtsuk pujawa nunismek pujusta tusam uwemtikrurta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ameka nekasam pampa muchikchamin aa nunisketme.","poem":1},{"lineBreak":true},{"text":"Turasha wenuk yumpunkachmin aa nunisketme.","poem":1},{"lineBreak":true},{"text":"Ame tame nuka tuke umiu asam jintintruata,","poem":1},{"lineBreak":true},{"text":"tura waitkata tusan,","poem":1},{"lineBreak":true},{"text":"ami naarmin pachisan seajme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aints kuntinun achikiartas ajatinawa nunisarang aints ainau wina achirkartas wakerutinawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai ame wina ejarkatin asam angkanmamtikruata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina wakantruka ame waitrukta.","poem":1},{"lineBreak":true},{"text":"Apuru ame nekasam Yus asam wina ayamrutkata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aints ainau Yuschau waininayat ni yusrin:","poem":1},{"lineBreak":true},{"text":"Ameketme yusem tinaunka pengké nakitajai.","poem":1},{"lineBreak":true},{"text":"Antsu wikia:","poem":1},{"lineBreak":true},{"text":"Nekasampita tau asan amin nintimtusan pujajme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ame anenme nuna nekau asan,","poem":1},{"lineBreak":true},{"text":"pengker nintimsan waraajai.","poem":1},{"lineBreak":true},{"text":"Tura wi wake mesekan pujamur nekau asam,","poem":1},{"lineBreak":true},{"text":"ameka wait wajamursha waitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura wina nemasur ainau maawarti tusamka tsangkamrukchamame.","poem":1},{"lineBreak":true},{"text":"Antsu aints nungka muchkachminum pujawa nunismek pujusta tusam winaka waitnuyame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru wikia itiurkachminum pujau asamtai wait anentrurta.","poem":1},{"lineBreak":true},{"text":"Nukap juutu asamtai,","poem":1},{"lineBreak":true},{"text":"wina jiiruka najamrutak kusuri.","poem":1},{"lineBreak":true},{"text":"Turasha wina namangkruka mash pimpi pimpi nekapeajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wikia najaimiakun juutu pujau asamtai,","poem":1},{"lineBreak":true},{"text":"wina pujutruka kichik musachia nunisang wári amuawai.","poem":1},{"lineBreak":true},{"text":"Nukap wake mesekan pujau asan,","poem":1},{"lineBreak":true},{"text":"kakarchamin nekapeajai.","poem":1},{"lineBreak":true},{"text":"Tura wina namangkrusha pimpi pimpi nekapeajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka nukap wishikrinawai.","poem":1},{"lineBreak":true},{"text":"Tura wina irutkamur ainausha wishikrami tusar,","poem":1},{"lineBreak":true},{"text":"wina pachitsar pasé chichartinawai.","poem":1},{"lineBreak":true},{"text":"Tura wi jintanam wekaamtai,","poem":1},{"lineBreak":true},{"text":"wina waintair ainausha wina waitan nakitrinak ajapruwar ukurinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aints jakaun kajinmina nunisarang winasha tuke kajinmatrinawai.","poem":1},{"lineBreak":true},{"text":"Tura asan wikia jakach ajapamua nunisketjai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aints nangkamiar wina pachitsar shishkamsar chichartinaun anturmamjai:","poem":1},{"lineBreak":true},{"text":"“Atu atu yantame itiurkachmin shamrumtin awai”.","poem":1},{"lineBreak":true},{"text":"Tu tinau asar,","poem":1},{"lineBreak":true},{"text":"aints untsuri wina mantuwartas chichaman najatrinawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Antsu wikia amin nintimsan pujajme.","poem":1},{"lineBreak":true},{"text":"Apuru wikia aminka tuke:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusur tinuyajme.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wina pujutruka aminuitai.","poem":1},{"lineBreak":true},{"text":"Wina nemasur ainau wina papeetkar mantuwartas wakerutinamtaisha angkanmamtikruata.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wikia ami inatirmetjai.","poem":1},{"lineBreak":true},{"text":"Tura nekas pengker asam jiirsata.","poem":1},{"lineBreak":true},{"text":"Tura wait anentruram uwemtikrurta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apuru amin untsuajme.","poem":1},{"lineBreak":true},{"text":"Wi seamsha inatsturaip.","poem":1},{"lineBreak":true},{"text":"Antsu pasé aints ainau inatsaarta.","poem":1},{"lineBreak":true},{"text":"Tura iwiarsamu ainau chichatsuk pujuinawa nunisarang pujusarti tusam itiatmamtikiata.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Chikich wait chichaman chichau ainau anangkartichu ainaun pachisar wishikinak:","poem":1},{"lineBreak":true},{"text":"Nuka mianchawaitai tusar,","poem":1},{"lineBreak":true},{"text":"pasé chichaina nu amek itiatmamtikiata.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Antsu amin umirtamin ainauka nekasam timiá aneame.","poem":1},{"lineBreak":true},{"text":"Mash aints ainau wainminamunum amin nekasampita turamin ainau anengkratairum nekamtikiatasam inaktusume.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ame tuke pujau asam,","poem":1},{"lineBreak":true},{"text":"amin umirtamin ainaun chikich aints ainau pasé awajsarai tusam ejaktinuitme.","poem":1},{"lineBreak":true},{"text":"Ami aintsrum ainau wainkau asam,","poem":1},{"lineBreak":true},{"text":"ni nemase ainau niin pachisar pasé chicharkarai tusam surimiame.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Apuru wi wake mesekan pujai,","poem":1},{"lineBreak":true},{"text":"wina wait anentrakum pengker awajtusu asakmin,","poem":1},{"lineBreak":true},{"text":"nekasam pengkeraitme tajame.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yusru wikia itiurkachmin pujamtai,","poem":1},{"lineBreak":true},{"text":"ame winaka ajapruam ukurkimiame timiajai.","poem":1},{"lineBreak":true},{"text":"Antsu wi yainkata tusan untsummatai, wina untsummaur anturtukmame.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yus umirkautiram atumi Apuri aneetaram.","poem":1},{"lineBreak":true},{"text":"Ni umirkau ainautinka ii Apuringkia waitmaji.","poem":1},{"lineBreak":true},{"text":"Antsu miajuitjai tumamin ainaunka ni wait wajaktintrin susatnuitai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Atumi Yusri nekasampita tau asaram,","poem":1},{"lineBreak":true},{"text":"napchauka nintimtsuk antsu pengker nintimsaram pujustaram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}