{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":32,"content":[{"type":"heading","content":["David: Yus tsangkutrurta titin nekas pengkeraitai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yus aintsu tunaarin mash sakar tsangkuramu asa,","poem":1},{"lineBreak":true},{"text":"nu aintska waraawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura nu aintsu tunaarin mash sakturu asa,","poem":1},{"lineBreak":true},{"text":"Yuska ni tunaarinka nintimtatsui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai nu aintska nekas waraawai.","poem":1},{"lineBreak":true},{"text":"Tura wina tunaaruka atsawai tusa nekas pengker pujawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Antsu wina tunaarun uukan etsertsuk pujaknaka,","poem":1},{"lineBreak":true},{"text":"kintajai metek jakamin nekapeakun wake mesekan pujuyajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru tsawaisha tura kashisha napchau nintimrati tusam,","poem":1},{"lineBreak":true},{"text":"wi wait wajaktin surusu asakmin,","poem":1},{"lineBreak":true},{"text":"yangkur tsaa sukuam kaawa nunisnak nekapeakun,","poem":1},{"lineBreak":true},{"text":"wina kakarmarka pengké atsumiayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura asamtai wikia nintimran:","poem":1},{"lineBreak":true},{"text":"Apurun tunaarun ujaktajai tusan,","poem":1},{"lineBreak":true},{"text":"wina tunaarunka mash uutsuk amin ujakmiajme.","poem":1},{"lineBreak":true},{"text":"Wi turamtai wina tunaaruka mash tsangkutrurmiame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura asamtai Yus umirkau ainautikia wake mesekar nintimrar,","poem":1},{"lineBreak":true},{"text":"nujang nungkan amurmanum ujungmawa nunisrik jakatatjiapi tu nintimrar pujakrikia amek seamnawaitji.","poem":1},{"lineBreak":true},{"text":"Tura nujang aintsu pujutirin amurmawa nunisang nekapeayatrik ataksha entsa kuyuak ukukmiawa nunisrik uwemratnuitji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ameketme wina ejarkatnumka.","poem":1},{"lineBreak":true},{"text":"Itiurkachmin pujamtaisha wina ayamrutkatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura wina angkanmamtikruau asakmin, warasan kantan kantamruatnuitjame.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wina Apur chichartak:","poem":1},{"lineBreak":true},{"text":"Wikia amin wainjame,","poem":1},{"lineBreak":true},{"text":"tura amincha chicharjame,","poem":1},{"lineBreak":true},{"text":"tura amin nuiniartasan:","poem":1},{"lineBreak":true},{"text":"Juwaitai jinta tusan nekamtikiatjame turutui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kawai tura burro nintinchau asamtai,","poem":1},{"lineBreak":true},{"text":"aints jirujai jangken jingkiawar,","poem":1},{"lineBreak":true},{"text":"mai japi mai japi awajmawa nunisrumka airap.","poem":1},{"lineBreak":true},{"text":"Antsu nu tangku ainauka","poem":1},{"lineBreak":true},{"text":"jingkiatskeka atumin winichartin ainawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pasé aints ainauka nukap wait wajakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu Yus nekasampita tinu ainautinka ii Apuri tuke wait anentramak waitmaji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pengke aints ainautiram tura anangmichu ainautirmesha,","poem":1},{"lineBreak":true},{"text":"atumi Apuri turamuri nintimraram warastaram.","poem":1},{"lineBreak":true},{"text":"Tura pengker nintimu asaram,","poem":1},{"lineBreak":true},{"text":"waraakrum kanta kantamataram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}