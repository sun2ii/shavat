{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":33,"content":[{"type":"heading","content":["David Yusen: Ameketme pengkeram tusa maaketai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Pengke aints ainautiram,","poem":1},{"lineBreak":true},{"text":"ii Yusri ameketme juuntam titaram.","poem":1},{"lineBreak":true},{"text":"Pengke aints ainau Yusen:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram timiauri nekas pengkeraitai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kitarrum tuntuyakrumsha:","poem":1},{"lineBreak":true},{"text":"Yus maaketai takuram kantamataram.","poem":1},{"lineBreak":true},{"text":"Tura arpasha tuntuyakrum kantamataram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura yamaram kanta kantamkurmesha Yus juuntaitai titasrum nekasrum pengker tuntuyataram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuse chichamengka nekas waitchawaitai.","poem":1},{"lineBreak":true},{"text":"Tura ni najanamurisha mash wainu asar,","poem":1},{"lineBreak":true},{"text":"Yus nekas pengkeraitai titinuitji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuska nekas pengker aa nuna wakerawai.","poem":1},{"lineBreak":true},{"text":"Ni anengkratairi mash nungka ainamunam tinamtikui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus nayaimpincha tura nayaimpinam iruna nunasha mash ni chichamejai aya chichasang najanamiayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus juun entsan najanak nekas kuna ati tusa,","poem":1},{"lineBreak":true},{"text":"yumi mash nuni yarakmawa nunisang najanamiayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mash nungkanam pujuinautiram Yus maaketai titaram.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanam matsatutirmesha,","poem":1},{"lineBreak":true},{"text":"ii Apuri ameketme juuntam titaram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yus aya chichasang mash najankamiayi.","poem":1},{"lineBreak":true},{"text":"Yus tu ati tinu asamtai,","poem":1},{"lineBreak":true},{"text":"ni najankamuri mash nunisarang armiayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yus niin umirkacharu ainau wakeramurin jiis,","poem":1},{"lineBreak":true},{"text":"turacharti tusa surimiawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Antsu ni wakeramurin ningki mash miatrusang umiktinuitai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aints ii Apurin:","poem":1},{"lineBreak":true},{"text":"Nekas Yusketai tinu ainauka pengker nintimsar pujusartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura Yus nu aints ainaunka:","poem":1},{"lineBreak":true},{"text":"Nekasar wina aintsur ainawai timiau asar warasartin ainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yuska nayaimpinam pujus mash aints ainautin waitmaji.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ni pujutiriniang mash nungkanam pujuinaunka jiiawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ningki aintsti nintin najatramau asa,","poem":1},{"lineBreak":true},{"text":"ii takaamurincha mash nekawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ju nungkanam apu pujuinauka suntar timiá untsurin inainayat,","poem":1},{"lineBreak":true},{"text":"kichkisha ningkikia uwemrartatkamawar tujintinawai.","poem":1},{"lineBreak":true},{"text":"Tura aints kakaram ainayat,","poem":1},{"lineBreak":true},{"text":"kichkisha ningkikia uwemrachartin ainawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kawai ainauka kakaram ainayat,","poem":1},{"lineBreak":true},{"text":"aintsun kichkisha uwemtikrachartin ainawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Antsu ii Apurin:","poem":1},{"lineBreak":true},{"text":"Ameketme Apum tinu ainaunka tura ni anengkratairin nintimsar pujuinauncha tuke wainkatnuitai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nu aints ainau jakarai tusa,","poem":1},{"lineBreak":true},{"text":"tura tsukajai wait wajakarai tusa,","poem":1},{"lineBreak":true},{"text":"uwemtikratas wainkatnuitai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Iikia ii Yusri nintimsar:","poem":1},{"lineBreak":true},{"text":"Ningki iin yainmaktinuitji,","poem":1},{"lineBreak":true},{"text":"tura ningki ejarmaktinuitji taji.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Iikia ii Apuri nekas pengker aa nu nekasampita tusar,","poem":1},{"lineBreak":true},{"text":"ni naari nintimsar ii nintijai waraaji.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yusru iikia tuke ame nintimsar pujau asakrin,","poem":1},{"lineBreak":true},{"text":"ami anengkratairum tuke iin sukartusta taji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}