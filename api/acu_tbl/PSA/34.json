{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":34,"content":[{"type":"heading","content":["David: Yus pengkeraitai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wikia Yusrun kintajai metek:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram titatjai.","poem":1},{"lineBreak":true},{"text":"Wina jangkerjai tuke Yus juuntaitai titatjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wikia Yusrun nintimtusan:","poem":1},{"lineBreak":true},{"text":"Nekas kakarmaitai tajai.","poem":1},{"lineBreak":true},{"text":"Jampechu ainautirmeka nu antukrum warastaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iijai metek mash iruntrar ii Apuri naari pachisar:","poem":1},{"lineBreak":true},{"text":"Yuska nekas juuntaitai tiarmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wikia Yusrun seam ni anturtukmiayi.","poem":1},{"lineBreak":true},{"text":"Tura ni shamtsuk asata tusa angkanmamtikruamiayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina Yusrun nintimsar pujuinauka nukap warainawai.","poem":1},{"lineBreak":true},{"text":"Tura pengké natsaamtsuk pujusartin ainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wikia mianchau asan,","poem":1},{"lineBreak":true},{"text":"shamakun untsumkinij wajamiajai.","poem":1},{"lineBreak":true},{"text":"Wi turamtai wina Yusur anturtuk:","poem":1},{"lineBreak":true},{"text":"Shamtsuk pujusta tusa,","poem":1},{"lineBreak":true},{"text":"itiurkachminnum pujaing angkanmamtikruamiayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yuse awemamuri Yus nintimsar pujuinautin tuke waitmaku asamtai uwemtikramratnuitji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus pengkerashi tusaram nekaatasrum wakerakrumka,","poem":1},{"lineBreak":true},{"text":"tenap nintimsaram nekaataram.","poem":1},{"lineBreak":true},{"text":"Aints Yusen nintimsar pujuinauka nekasar pengker nintimsar pujusartin ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yus umirkautiram atumi Apuri nintimtusrum:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titaram.","poem":1},{"lineBreak":true},{"text":"Iikia tuke nintijai ni umirkarkia yuumakchatnuitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kuikiartin ainauka kuikiartichu wajasar yuumakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu ii Apuri seautikia nekasar pengker pujustinka yuumakchatnuitji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uchir ainautiram,","poem":1},{"lineBreak":true},{"text":"wini winiram anturtitaram.","poem":1},{"lineBreak":true},{"text":"Itiur ii Yusri pengker awajsatnuitji tusan,","poem":1},{"lineBreak":true},{"text":"atumin nuiniartasan wakerajrume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Atumka pengker nintimsaram wara warat pujustasrum wakerakrumka,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"pasé chichamka chichatsuk asataram.","poem":1},{"lineBreak":true},{"text":"Tura wait chichamsha etsertsuk asataram.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tura pasé aa nuka mash inaisaram,","poem":1},{"lineBreak":true},{"text":"pengker aa nuke turin ataram.","poem":1},{"lineBreak":true},{"text":"Turakrum angkan pengker nintimsar pujut wakerin ataram.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ii Apuri Yuska nekas pengke nintintin ainaun wainin asa,","poem":1},{"lineBreak":true},{"text":"ni seamuncha anturui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Antsu tunau takau ainaunka nakitawai.","poem":1},{"lineBreak":true},{"text":"Tura nu aintsu naarin chikich aints ainau nintimtsuk asarti tusa kajinmamtikui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yuska pengker nintintin ainau seamurinka anturui.","poem":1},{"lineBreak":true},{"text":"Tura itiurkachminnum pujuinamtaikia,","poem":1},{"lineBreak":true},{"text":"shamtsuk pujusarti tusa angkanmamtikui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ii Yusringkia arakchichuitai.","poem":1},{"lineBreak":true},{"text":"Tura asa aints:","poem":1},{"lineBreak":true},{"text":"Wikia mengkaakatnuapitja tusar,","poem":1},{"lineBreak":true},{"text":"napchau nintimsar pujuinaunka uwemtikratnuitai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pengke nintintin itiurkachminnum nukap wait wajainau wainiat,","poem":1},{"lineBreak":true},{"text":"ii Yusri mash angkanmamtiknuitai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ni kunchincha kupirkacharti tusa wainuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai kichkisha kupirkachartinuitai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pasé aints ainau ni tunaarijai jakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura pengke nintintin ainaun tsuutinauka wait wajakartin ainawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Antsu ii Yusri ni inatiri ainaun uwemtikratnuitai.","poem":1},{"lineBreak":true},{"text":"Tura Yusen nekasampita tinu ainaunka wait wajaktintrinka susashtinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}