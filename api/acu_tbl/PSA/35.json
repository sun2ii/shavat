{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":35,"content":[{"type":"heading","content":["David Yusen: Yainkata tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina nepetukartas wakerutina nuka amek nepeturkata.","poem":1},{"lineBreak":true},{"text":"Tura wijai maanitan wakerina nujaisha amek maanikta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aminu tantaarum jukim wina yainkatasam winita.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura nangkiram achikiam,","poem":1},{"lineBreak":true},{"text":"wina mantuwartas papeetkiar winina nuka maawarai tusam surimrukta.","poem":1},{"lineBreak":true},{"text":"Tura wiitjai amin uwemtikratnunka turuttia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusru wina mantuwartas wakerutina nuka natsaarar tupikiakiarti.","poem":1},{"lineBreak":true},{"text":"Tura wina pasé awajtusartas wakerutinausha nunisarang natsaarar waketkiarti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura nase umpuak chirichri kaarun juwawa nunisang ami awemamuram ainau nu aints ainaunka jukiar arák ajapawarti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Turinamu asar ni teenam wekaasar jinta chungkap amaunum ayaararti.","poem":1},{"lineBreak":true},{"text":"Tura ami awemamuram niin papeekarti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuntinun achikiartas ejatkan ejatinawa nunisarang nu aints ainauka nangkamiar wina achirkartas ejatkan pujtursarmayi.","poem":1},{"lineBreak":true},{"text":"Tura ayaarti tusar waan tautriniarmayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Turinau asaramtai aneachmau nu waanmaka ayaarar mengkakarti.","poem":1},{"lineBreak":true},{"text":"Tura ejatkan ningki puusarma nunisha achimkar,","poem":1},{"lineBreak":true},{"text":"wait wajakarti tusan amin seajme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Antsu wina uwemtikruru asakmin,","poem":1},{"lineBreak":true},{"text":"maaketai tusan warastatjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tura wina nintirjai warasan:","poem":1},{"lineBreak":true},{"text":"Amijai metek chikichkisha atsawai titatjai.","poem":1},{"lineBreak":true},{"text":"Nekas kakaram ainau mianchau ainaun tura yuuminauncha nangkamiar takamtikinawai.","poem":1},{"lineBreak":true},{"text":"Tura wainiatum nu aints ainamunmaya ame angkanmamtikiatnuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsanumin aints ainauka wajakiar,","poem":1},{"lineBreak":true},{"text":"wi nekachmaun pachisar inintrinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wikia niin pengker awajnuyajai.","poem":1},{"lineBreak":true},{"text":"Tura waitinayat winaka pasé awajtusarmayi.","poem":1},{"lineBreak":true},{"text":"Tura asar wina wake mesemtikrukarmayi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaanchuik nu aints ainau jaak tepeenamtai,","poem":1},{"lineBreak":true},{"text":"wikia wake mesekan yutsuk pujuyajai.","poem":1},{"lineBreak":true},{"text":"Tura amin tuke nintirjai nu aints ainaun pachisan seayajme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aints ni nukuri,","poem":1},{"lineBreak":true},{"text":"tura ni amikri tura ni nekas yachí jakamtai,","poem":1},{"lineBreak":true},{"text":"wake mesek pujawa nunisnak wisha ni jaak tepaun wainkau asan,","poem":1},{"lineBreak":true},{"text":"napchau nintimsan pujuyajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Antsu wi pasé pujau asamtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainau mash iruntrar wishikrin armayi.","poem":1},{"lineBreak":true},{"text":"Tura wainchatiya nunisarang tuke inaitutsuk winaka pasé awajtusarmayi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tura wina itit awajtusar tura wishikrinak tura kajertinak jiiru awajtiarmayi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apuru ¿nu aints ainau warutam kinta jiiame?","poem":1},{"lineBreak":true},{"text":"Nu aints ainau juun yawaaya nunisarang shiniinak,","poem":1},{"lineBreak":true},{"text":"wina mantuwartas wakerutina nuniangka uwemtikrurta.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Turakmin aminu aintsrum untsuri iruntramunam amincha maaketai titatjame.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau nangkamiar kajertina nuka warascharti tusan seajme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nu aints ainauka maanitsuk pujusartatkamawar tujintinawai.","poem":1},{"lineBreak":true},{"text":"Antsu aints angkan pengker nintimsar pujuinaun pachisar anangkinak chichaman najatinawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tura jangken awarar:","poem":1},{"lineBreak":true},{"text":"“Iisha ni turamuri wainkawaitji.","poem":1},{"lineBreak":true},{"text":"Atumsha nekaataram”,","poem":1},{"lineBreak":true},{"text":"nangkamiar waitrinak tinawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tu tinau wainiatum,","poem":1},{"lineBreak":true},{"text":"ame Apuru ni turamuringkia wainkawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asam ame takamtaikia pujusaip.","poem":1},{"lineBreak":true},{"text":"Tura wina ajapruamka ukurkiip.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yusru wina Apur asam,","poem":1},{"lineBreak":true},{"text":"anearam wajakim wina turamur nekartuam ayamrutkata.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yusru ameka wina Apuruitme.","poem":1},{"lineBreak":true},{"text":"Tura pengké tunaarinchau asam,","poem":1},{"lineBreak":true},{"text":"wina tunaar atsuash tusam jiirtusta.","poem":1},{"lineBreak":true},{"text":"Tura wishikrarai tusam amek surimrukta.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wina pachitsar:","poem":1},{"lineBreak":true},{"text":"Tu wait wajakti tusar iikia wakerukmaji.","poem":1},{"lineBreak":true},{"text":"Nuka yamaikia mesraji turutiarai tusam surimrukta.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tura wi wait wajamtai,","poem":1},{"lineBreak":true},{"text":"wina jiirsar waraina nuka inatsarta.","poem":1},{"lineBreak":true},{"text":"Tura wina pachitsar:","poem":1},{"lineBreak":true},{"text":"Nuka mianchawaitai turutinauka tuke natsaaminak pujusarti tusam inatsaarta.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Antsu wina pengker nintimtursar:","poem":1},{"lineBreak":true},{"text":"Ni nemase ainaun nepetkati turutinauka warainak untsumkarti.","poem":1},{"lineBreak":true},{"text":"Turasha tuke Yus juuntaitai,","poem":1},{"lineBreak":true},{"text":"tura ni inatiri pengker pujusti tiarti.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ni turutinamtai wikia ame pengker turamurmin pachisan chichastatjai.","poem":1},{"lineBreak":true},{"text":"Tura kintajai metek:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram titatjame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}