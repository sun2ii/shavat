{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":36,"content":[{"type":"heading","content":["David: Aints ainau pasé nintimaurin tura Yuse pengkerin pachis kantamamuri"]},{"type":"verse","number":1,"content":[{"text":"Pasé aints ainauka ni nintijai tuke pasé nintimin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu nekasar Yus umirkarmi tuuka nintiminatsui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuka ningki nintimtumasar:","poem":1},{"lineBreak":true},{"text":"Wikia miajuitjai tumamin ainauka:","poem":1},{"lineBreak":true},{"text":"Wikia juun tunaawitjai tuuka pengké nintiminatsui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni chichamengka nekasar pasé ainawai.","poem":1},{"lineBreak":true},{"text":"Tura wait chichamtin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura paanka nintiminatsui.","poem":1},{"lineBreak":true},{"text":"Tura pengker turatniuncha yanchuk ukukiarmiayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura ni peakrin tepesar,","poem":1},{"lineBreak":true},{"text":"ni pasé turatniurin nintiminawai.","poem":1},{"lineBreak":true},{"text":"Tura ni tunau takatirin inaitan nakitinau asar,","poem":1},{"lineBreak":true},{"text":"aints waak wekaayat nu jintan tuke amaktas wakerawa nunisarang ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Antsu aminu anengkratairum,","poem":1},{"lineBreak":true},{"text":"Apuru aintsu anengkratairin nangkamasketai.","poem":1},{"lineBreak":true},{"text":"Tura aminu penkeerumka aintsu pengkerin nangkamasketai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ame aints ainau tunaari nekatirmeka mura juun ainia nuna nangkamasketai.","poem":1},{"lineBreak":true},{"text":"Tura ame chicham akupamu ainauka juun entsa kunaarin nangkamasketai.","poem":1},{"lineBreak":true},{"text":"Ameka Yus asam,","poem":1},{"lineBreak":true},{"text":"aints ainau tura kuntin ainausha mash wainuitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yusru ami anengkratairumka timiá pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai aints ainau amin seatmiar ejamkartin ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura amin seatmina nuka ame suame nunaka aints yutan nukap yuwina nunisarang pengker nintimsar pujuinawai.","poem":1},{"lineBreak":true},{"text":"Tura aints umutin nukap uminak tutuarar pujuinawa nunisarang ami pengkeerumin nintimsar warainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nekasam tuke pujut sukartinmeka ametme.","poem":1},{"lineBreak":true},{"text":"Tura ame paantin najanau asakmin,","poem":1},{"lineBreak":true},{"text":"iisha paan nintimsar pujustinuitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ami aintsrum ainautikia pengke nintintin asakrin,","poem":1},{"lineBreak":true},{"text":"ami anengkratairum tura ami pengkeerumsha sukartusta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Antsu ningki nintimsar:","poem":1},{"lineBreak":true},{"text":"Miajuitjai tumaminauka wina najatrarai tusam surimrukta.","poem":1},{"lineBreak":true},{"text":"Turasha pasé aints ainauka wina achirkarai tusam ayamrutkata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nu paseen takau ainau nepeteamu asaramtai jiistaram.","poem":1},{"lineBreak":true},{"text":"Nu aints nepetkamu asar,","poem":1},{"lineBreak":true},{"text":"ataksha nantakiartatkamawar tuke tujintinawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}