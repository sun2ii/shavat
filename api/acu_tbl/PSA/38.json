{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":38,"content":[{"type":"heading","content":["David: Wina tunaar ainau waurmamtikrinau asaramtai etserkatasan wakerajai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina kajertakmesha wait aneasam jiyatkaip.","poem":1},{"lineBreak":true},{"text":"Tura wina kajertukam pujayatmek wait aneasam wait wajaktinka surusaip.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aints tishimkurijai chikich aintsun kettuk ijumua","poem":1},{"lineBreak":true},{"text":"nunisnak nekapmamjai.","poem":1},{"lineBreak":true},{"text":"Tura ami uwejem yakairun meram patatua nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wina tunaar jiisam kajertuku asakmin namangkruka mash najamrutawai.","poem":1},{"lineBreak":true},{"text":"Tura wina ukunchrusha kupinakua nunisnak nekapmamjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura wina tunaaruka piakuitai tu nekapmamu asan,","poem":1},{"lineBreak":true},{"text":"merman entsakua nunisnak tsantrachmin nekapmamjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wikia timiá nintinchau asan tunaun takau asamtai,","poem":1},{"lineBreak":true},{"text":"wina namangkruka kuchap kawaawa nunisang mejeawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura asamtai wikia kintajai metek wake mesekan tsuntsuman wekaajai.","poem":1},{"lineBreak":true},{"text":"Tura pengker nintimsan pujustatkaman tujintajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi tsuweamtai,","poem":1},{"lineBreak":true},{"text":"wina tuntupruka ji kapawa nunisnak nekapmamkun,","poem":1},{"lineBreak":true},{"text":"wina namangkruka mash najamrutawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura wina kakarmarka pengké atsau asamtai,","poem":1},{"lineBreak":true},{"text":"wikia napchau nintimsan juutmin nekapeajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru wina nintimauruka mash nekau asakmin,","poem":1},{"lineBreak":true},{"text":"wi chichaktatkaman mayairukan pujaja nusha waitme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wina nintirka kakarman teetui.","poem":1},{"lineBreak":true},{"text":"Tura wina kakarmarka atsawai.","poem":1},{"lineBreak":true},{"text":"Tura jiirusha kusuawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura wina amikur pengker ainia nu tura wina wear ainausha kuchaprun wainkar,","poem":1},{"lineBreak":true},{"text":"winaka jiirtancha nakitrinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura wina mantuwartas wakerutinauka ejatkanam kuntinun achikiartas wakerina nunisarang achirkartas wakerutinawai.","poem":1},{"lineBreak":true},{"text":"Tura wina pasé awajtusartas wakerutinauka kintajai metek mesturartas chichaman najatrinawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antsu wikia aints antichua nunisnak pasé aints ainau chichamenka antutsuk pujajai.","poem":1},{"lineBreak":true},{"text":"Turasha chichachua nunisnak takamtaik pujajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wikia aints antichua tumau asan,","poem":1},{"lineBreak":true},{"text":"ayamrumaktatkaman chichaschamin nekapeajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apuru wina Yusur asakmin,","poem":1},{"lineBreak":true},{"text":"ameketme wina ayamrutkatnumka tusan,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau amek nepetkata tusan nakajme.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Antsu wina nepetukar warasarai tura wishikrurarai tusan seajme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wikia nekasan jatanak wajasjai.","poem":1},{"lineBreak":true},{"text":"Tura asan tuke najaimiamur mijantratsui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wina tunaar ainau waurmamtikrinau asaramtai,","poem":1},{"lineBreak":true},{"text":"wikia etserkatasan wakerajai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wina nemasur nukap yujarari.","poem":1},{"lineBreak":true},{"text":"Tura nangkamiar kajertin ainausha untsurintai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Niinka wikia pengker awajinamaitiat,","poem":1},{"lineBreak":true},{"text":"winaka pasé awajtusarmayi.","poem":1},{"lineBreak":true},{"text":"Wi pengker aa nunak takastasan wakerai waitinayat,","poem":1},{"lineBreak":true},{"text":"wina nakitrinak pasé nintimtursar pujuinawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Apuru winaka ajapruamka ukurkiip.","poem":1},{"lineBreak":true},{"text":"Yusru wijai tuke pujusta.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yusru wina uwemtikrurtin asakmin,","poem":1},{"lineBreak":true},{"text":"wári yainkata tusan seajme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}