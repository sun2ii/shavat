{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":4,"content":[{"type":"heading","content":["David: Yuska kajinmatsuk nintimratnuitji timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina ayamrutkatin asam wi untsuamka airkata.","poem":1},{"lineBreak":true},{"text":"Wi wake mesekan pujamtaisha,","poem":1},{"lineBreak":true},{"text":"ameka pengker awajtusmame.","poem":1},{"lineBreak":true},{"text":"Tura asam yamaikia wait anentrurta tura wi seamur anturtukta,","poem":1},{"lineBreak":true},{"text":"tusan seajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atumin miajuitjai tumamin ainautirmin tajarme:","poem":1},{"lineBreak":true},{"text":"¿Warutia wina pasé awajtutcha inaisatatrume? ¿Warutia nangkamrum nintimtairumsha inaisatatrume?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yus aints ainaun:","poem":1},{"lineBreak":true},{"text":"Wina umirtukarti tusa wakerawai.","poem":1},{"lineBreak":true},{"text":"Nuka nekaataram.","poem":1},{"lineBreak":true},{"text":"Wi untsuam winaka anturtuktatui tusaram nekaataram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yus shamakrum kurartaram.","poem":1},{"lineBreak":true},{"text":"Tura tunaarum inaisataram.","poem":1},{"lineBreak":true},{"text":"Tura takamtaik atumi peakrin tepesrum:","poem":1},{"lineBreak":true},{"text":"Wina tunaar atsuash tusaram nintimrataram.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura Yus wina tunaarun tsangkutrurat tusaram,","poem":1},{"lineBreak":true},{"text":"tangku maaram epeataram.","poem":1},{"lineBreak":true},{"text":"Turakrum Yus kajinmatsuk nintimrataram.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aints untsuri chichainak:","poem":1},{"lineBreak":true},{"text":"¿Yáki iincha nekas pengker aa nuna inakturmastinuitai? tinawai.","poem":1},{"lineBreak":true},{"text":"Apuru iincha pengker nintimkartusam jiikratsata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aints trigon tura vinoncha nukap juukar waraina nuna nangkamasmek ame wina nintirun waramtikrusmame.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ame Apuru wina chichartakum:","poem":1},{"lineBreak":true},{"text":"Nekas shamtsuk pujusta tusam","poem":1},{"lineBreak":true},{"text":"nintimtikruru asakmin,","poem":1},{"lineBreak":true},{"text":"wikia tepesan","poem":1},{"lineBreak":true},{"text":"pengker nintimsan","poem":1},{"lineBreak":true},{"text":"wári kanurtatjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}