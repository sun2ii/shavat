{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":40,"content":[{"type":"heading","content":["David: Yusru aminu wakeramurmin turatasan wakerajai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Wikia Apurun nintimran:","poem":1},{"lineBreak":true},{"text":"Yainkata tusan untsukmiajai.","poem":1},{"lineBreak":true},{"text":"Wi tamati wina Yusur anturtukmiayi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura jakatniunmaya wina uwemtikrurmiayi.","poem":1},{"lineBreak":true},{"text":"Tura mengkaakai tusa ayamrutkamiayi.","poem":1},{"lineBreak":true},{"text":"Tura aints mura yakí ayaatsuk wajawa nunisang angkan pujusti tusa,","poem":1},{"lineBreak":true},{"text":"winaka angkanmamtikruamiayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura yamaram kanta kantamata tusa,","poem":1},{"lineBreak":true},{"text":"winaka nintimtikrurmiayi.","poem":1},{"lineBreak":true},{"text":"Turamtai nu kantajai ii Yusrin:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam timiajai.","poem":1},{"lineBreak":true},{"text":"Wi tamatai aints untsuri nuna antukar nukap nintimrar ii Apurin nekasampita tiarmiayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aints Yusen nekasampita tinauka,","poem":1},{"lineBreak":true},{"text":"tura Yusen umirtan nakitin ainaujai pachintsuk pujuinauka,","poem":1},{"lineBreak":true},{"text":"tura wait chichamtin ainaujai tsaniitsuk pujuinauka nekasar warasartin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"amijai metekka ju nungkanmaka kichkisha atsawai.","poem":1},{"lineBreak":true},{"text":"¿Ami wainchati takatrum warutmak ainia? tusanka nekaachminuitjai.","poem":1},{"lineBreak":true},{"text":"Timiá untsuri asaramtai,","poem":1},{"lineBreak":true},{"text":"ami najankamurmin pachisan chichastatkaman tujintajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aints amin chichartaminak:","poem":1},{"lineBreak":true},{"text":"Tunaar tsangkutrurta tusar,","poem":1},{"lineBreak":true},{"text":"tangku ainaun maawar,","poem":1},{"lineBreak":true},{"text":"wina surusarti tusamka ameka wakeratsme.","poem":1},{"lineBreak":true},{"text":"Antsu wina antutir kuwishur uratrukuitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura asakmin wisha amin timiajme:","poem":1},{"lineBreak":true},{"text":"Yusru wina pachitas papinum aarmawa nunisnak ami wakeramurmin umiktasan taawitjai.","poem":1},{"lineBreak":true},{"text":"Ami chichamem nintirun engkemawaitai tajame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ami aintsrum untsuri iruntramunam wikia nekas chichaman nekamtikiamiajai.","poem":1},{"lineBreak":true},{"text":"Apuru wikia ami chichammin pengké uukchamiaja nusha nekame.","poem":1},{"lineBreak":true},{"text":"Wikia amin pachisan:","poem":1},{"lineBreak":true},{"text":"Ni tímia nunaka miatrusnak umikuitjai.","poem":1},{"lineBreak":true},{"text":"Nunia iincha tuke uwemtikramratnuitji timiajai.","poem":1},{"lineBreak":true},{"text":"Ami aintsrum untsuri iruntramunam aminu anengkratairmin tu awai tusan nekamtikiamiajai.","poem":1},{"lineBreak":true},{"text":"Turasha aminu chichamem nekas chicham asamtai,","poem":1},{"lineBreak":true},{"text":"pengké uukchamiajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wina wait wajamurka untsuri asaramtai,","poem":1},{"lineBreak":true},{"text":"wikia nekapmartatkaman tujintajai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Apuru tajame:","poem":1},{"lineBreak":true},{"text":"Wait aneasam ami anengkratairum uutrukaip.","poem":1},{"lineBreak":true},{"text":"Ami anengkratairumjai tura ami chichamijai yainkata.","poem":1},{"lineBreak":true},{"text":"Wina tunaaruka wina intashru nangkamasang untsuri ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asan napchau nintimran jakamin nekapeajai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apuru wári tunaanumia angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Tura wári yainkata.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aints wina mantuwartas wakerutinauka ame inatsaarta.","poem":1},{"lineBreak":true},{"text":"Tura ame inatsaarmau asar,","poem":1},{"lineBreak":true},{"text":"wina pasé awajtukartas wakerutina nuka natsaarar tupikiakiartinuitai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wina wishikruraru ainauka natsaararu asar tupikiakiartinuitai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Antsu amin eatminauka amin nintimturmasar nukap warasartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura uwemrartas wakerin ainauka tuke amin pachitmasar:","poem":1},{"lineBreak":true},{"text":"Yus juuntaitai turamiartinuitai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Antsu wi wait wajau asamtai,","poem":1},{"lineBreak":true},{"text":"Apuru kajinmatrukiip.","poem":1},{"lineBreak":true},{"text":"Yusru wina yainkatin asam,","poem":1},{"lineBreak":true},{"text":"tura wina angkanmamtikruatin asam,","poem":1},{"lineBreak":true},{"text":"wári yainkata tajame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":14}