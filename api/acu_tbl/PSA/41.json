{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":41,"content":[{"type":"heading","content":["Aints jau Yusen seatin"]},{"type":"verse","number":1,"content":[{"text":"Aints kakaichu tura mianchau ainausha pengker awajinaunka Yuska pengker awajsatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura nisha wait wajamtaisha,","poem":1},{"lineBreak":true},{"text":"Yuska angkanmamtikiatnuitai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura niincha ejaktinuitai.","poem":1},{"lineBreak":true},{"text":"Turasha ju nungkanam pujus pengker nintimias pujusti tusa,","poem":1},{"lineBreak":true},{"text":"pujutan susatnuitai,","poem":1},{"lineBreak":true},{"text":"tura warastinnasha susatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni nemase ainau niin itit awajsarai tusa surimkatnuitai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura najaimiak tepamtaisha,","poem":1},{"lineBreak":true},{"text":"Yus kakamtikratnuitai.","poem":1},{"lineBreak":true},{"text":"Tura ataksha tsaarti tusa inankitnuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura asamtai wikia Apurun chicharkun:","poem":1},{"lineBreak":true},{"text":"“Apuru wait anentruram wikia aminka umirchamaitiatmek,","poem":1},{"lineBreak":true},{"text":"ataksha pengker wajasta tusam tsuwaarata” timiajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau wina pachitsar pasé chichartinawai.","poem":1},{"lineBreak":true},{"text":"Tura inintrinak:","poem":1},{"lineBreak":true},{"text":"“¿Warutik jaka mengkakat?” turutinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura wina jiirsartas wininayat,","poem":1},{"lineBreak":true},{"text":"pengker nintimsarka wininatsui.","poem":1},{"lineBreak":true},{"text":"Antsu pasé chichaman antukar chikich aintsnum wayaawar aujmatrinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wina kajertin ainauka iruntrar wina pachitsar chichainak:","poem":1},{"lineBreak":true},{"text":"“Ningki wiasmamak wait wajawai”,","poem":1},{"lineBreak":true},{"text":"turutinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura ataksha chichainak:","poem":1},{"lineBreak":true},{"text":"“Ni jatairingkia iwianchnumiayaintai.","poem":1},{"lineBreak":true},{"text":"Ni peakrin jaak tepa auka pengké nantakchatnuitai” tusar aujmatrinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Turutinai wina nekas amikruka wikia:","poem":1},{"lineBreak":true},{"text":"Wina nekas amikruitai tamaitiat,","poem":1},{"lineBreak":true},{"text":"wijai yuya nuka wina nemasur wajasi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Antsu Apuru ame wait anentrurta,","poem":1},{"lineBreak":true},{"text":"tura ataksha inantukta.","poem":1},{"lineBreak":true},{"text":"Ame turakmin wina kajertin ainaun yapaijkiatnuitjai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura wina nemasur ainau wina nepetukcharamtaikia,","poem":1},{"lineBreak":true},{"text":"amin pachisan Yusrun pengker awajnuyajai tusan nekaamnawaitjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura wikia tunaun takatsuk pujau asamtai,","poem":1},{"lineBreak":true},{"text":"winaka tuke pengker awajtusta.","poem":1},{"lineBreak":true},{"text":"Tura tuke wijai pujusti tusam waitkata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apuru ami aintsrum ainauti Yusri asakmin,","poem":1},{"lineBreak":true},{"text":"yamaisha tura tuke:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tajame.","poem":1},{"lineBreak":true},{"text":"Tu ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}