{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":42,"content":[{"type":"heading","content":["Wina nintimauruka Yusetai"]},{"type":"verse","number":1,"content":[{"text":"Yusru japa kitamak entsan eaawa nunisnak amincha eajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yusru ameketme pujut sukartinmeka.","poem":1},{"lineBreak":true},{"text":"Tura asakmin aints kitakjai wait wajak entsan eawa nunisnak amincha eajme.","poem":1},{"lineBreak":true},{"text":"¿Warutik ataksha ami jeemnisha wayaatnuitja? tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura asan tsawaisha,","poem":1},{"lineBreak":true},{"text":"tura kashisha yutancha yutsuk juutkun pujajai.","poem":1},{"lineBreak":true},{"text":"Wi turamtai aints wina inintinak:","poem":1},{"lineBreak":true},{"text":"¿Yusrumsha pujawak? turutinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura nuna nintimsan,","poem":1},{"lineBreak":true},{"text":"nukap wake mesekan pujakun:","poem":1},{"lineBreak":true},{"text":"Yaanchuikia aints ainau warainak,","poem":1},{"lineBreak":true},{"text":"Yusen maaketai tiartas ni jeen wearti tusan jeemiajai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai aints ainau fiestanam weenawa nunisrik Yus seati jeanam wemiaji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Warukanak napchau nintimrataj? ¿Warukanak wake meseknasha pujustaj?","poem":1},{"lineBreak":true},{"text":"Wikia Yusen nintimsan pujajai.","poem":1},{"lineBreak":true},{"text":"Tura asan: Ameketme Yusem titatjai.","poem":1},{"lineBreak":true},{"text":"Ningki wina Yusur asa uwemtikrurtinuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wikia wake mesekan napchau nintimsan pujajai.","poem":1},{"lineBreak":true},{"text":"Tura asan amincha nukap nintimtusan pujakun,","poem":1},{"lineBreak":true},{"text":"mura Hermón tutainum tura mura Mizar tutainum Yus pujatsuash,","poem":1},{"lineBreak":true},{"text":"tura entsa Jordánka nujin","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"túna uutmauri aa nuni Yus pujatsuash,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujajai.","poem":1},{"lineBreak":true},{"text":"Nu entsaka ame najanamiame nuni jakerua nunisnak wikia nekapmamjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Antsu tsawai wina Apurka ni anengkratairin nekamtikiartawai.","poem":1},{"lineBreak":true},{"text":"Tura kashisha wina Yusur pujutan sukartinua nuna nintimtusan,","poem":1},{"lineBreak":true},{"text":"tuke kantan kantamrakun,","poem":1},{"lineBreak":true},{"text":"nuniasha Yusen seakun pujajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Turayatun Yusrun chicharkun:","poem":1},{"lineBreak":true},{"text":"Wina ejarin ayatmesha,","poem":1},{"lineBreak":true},{"text":"¿warukamtaiya winasha kajinmatrukniume? Wina nemasur ainauka wina itit awajtusaru asaramtai,","poem":1},{"lineBreak":true},{"text":"¿warukanak timiá wake meseknasha pujustaj?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka wina inatsturartas kintajai metek inintinak:","poem":1},{"lineBreak":true},{"text":"¿Ami Yusrumsha pujawak? turutinawai.","poem":1},{"lineBreak":true},{"text":"Tuke turutinau asaramtai,","poem":1},{"lineBreak":true},{"text":"wina ukunchrusha najamrutinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Warukanak napchau nintimrataj? ¿Warukanak wake meseknasha pujustaj?","poem":1},{"lineBreak":true},{"text":"Wikia Yusen nintimsan pujajai.","poem":1},{"lineBreak":true},{"text":"Tura asan ameketme Yusem titatjai.","poem":1},{"lineBreak":true},{"text":"Ningki wina Yusur asa uwemtikrurtinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}