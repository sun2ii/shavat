{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":43,"content":[{"type":"heading","content":["Wina ejarin asam angkanmamtikruata timiau"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"tura wina ejarin asam,","poem":1},{"lineBreak":true},{"text":"wikia tunau takatan nakitau asamtai,","poem":1},{"lineBreak":true},{"text":"aminu chichammin umirtamkacharu ainamunmaya ayamrutkata.","poem":1},{"lineBreak":true},{"text":"Tura anangkartin ainamunmaya tura chikich pasé aints ainamunmaya angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Wina nemasur ainauka wina itit awajtusaru asaramtai,","poem":1},{"lineBreak":true},{"text":"¿warukanak timiá wake meseknasha pujustaj? ¿Warukamtaiya winasha kajinmatrukniume?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ami pujutirmin jeatnuka aminu jintim juwaitai tusam,","poem":1},{"lineBreak":true},{"text":"tura aminu chichamem nekas aa nu paan nekamtikruata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusru ame wina nukap waramtikrustin asakmin,","poem":1},{"lineBreak":true},{"text":"wikia ami jeemin jean amincha:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tusan,","poem":1},{"lineBreak":true},{"text":"kitarran tuntuyakun kantamruatjame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Warukanak napchau nintimrataj? ¿Warukanak wake meseknasha pujustaj?","poem":1},{"lineBreak":true},{"text":"Wikia Yusen nintimsan pujajai.","poem":1},{"lineBreak":true},{"text":"Tura asan ameketme Yusem titatjai.","poem":1},{"lineBreak":true},{"text":"Ningki wina Yusur asa uwemtikrurtinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":4}