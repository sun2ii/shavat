{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":46,"content":[{"type":"heading","content":["Yus iijai pujawai"]},{"type":"verse","number":1,"content":[{"text":"Yusketai iin ejarmaktinka.","poem":1},{"lineBreak":true},{"text":"Tura iin kakamtikramratnuka nuketai.","poem":1},{"lineBreak":true},{"text":"Ii shamakur pujakrincha,","poem":1},{"lineBreak":true},{"text":"iin yainmaktinka nuketai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura asamtai nungka yumpunmataisha,","poem":1},{"lineBreak":true},{"text":"tura mura ainau juun entsa kunarin ujungmau amataisha shamkashtinuitji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura juun entsa tampari timiá wej wajamtaisha,","poem":1},{"lineBreak":true},{"text":"tura mura ainau Yuse kakarmarijai muchitinamtaisha shamkashtinuitji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kichik entsa ni kanaichirijai Yus ni yaktarin pujuinaun waramtikui.","poem":1},{"lineBreak":true},{"text":"Nu yaktaka chikich yakat ainaun nangkamasang nekas Yuse yaktarintai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuska nu yakta japen pujau asa,","poem":1},{"lineBreak":true},{"text":"chikich aints ainaun yumpungkai tusa wainui.","poem":1},{"lineBreak":true},{"text":"Kintajai metek tsawaaramtai,","poem":1},{"lineBreak":true},{"text":"Yuska ni aintsri ainaun yayaawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus chichaamtai,","poem":1},{"lineBreak":true},{"text":"chikich nungkanmaya ainauka nuna antukar shiniinawai.","poem":1},{"lineBreak":true},{"text":"Tura apu ainausha kurainawai.","poem":1},{"lineBreak":true},{"text":"Tura nungkaka ningki yumpuunui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus timiá kakaram aa nuka iijai pujawai.","poem":1},{"lineBreak":true},{"text":"Jacobo Yusringkia iin ejarmaktinuitji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus wainchati takatan mash nungkanam turamia nuka jiitaram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mash nungka ainamunam meset inaisataram tusa surimrukmiayi.","poem":1},{"lineBreak":true},{"text":"Tura asa tishimuk ainaun kupikmiayi.","poem":1},{"lineBreak":true},{"text":"Tura nangki ainauncha charukmiayi.","poem":1},{"lineBreak":true},{"text":"Nuniasha mesetnum wekaatai ainauncha keemakmiayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nintimrataram.","poem":1},{"lineBreak":true},{"text":"Turasha juuwaitai Yus tusaram nekarataram.","poem":1},{"lineBreak":true},{"text":"Yus chichaak:","poem":1},{"lineBreak":true},{"text":"Wikia mash nungkanmaya ainaun inawaitjai tawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yus timiá kakaram aa nuka iijai pujawai.","poem":1},{"lineBreak":true},{"text":"Jacobo Yusringkia iin ejarmaktinuitji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":11}