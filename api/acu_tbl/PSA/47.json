{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":47,"content":[{"type":"heading","content":["Yuska mash nungka ainia nuna Apurintai"]},{"type":"verse","number":1,"content":[{"text":"Yus nayaimpinam puja nuka nekas kakarmaitai.","poem":1},{"lineBreak":true},{"text":"Mash nungka ainia nuna Apurintai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai mash yaktanmaya ainautiram atumi Yusri wararkuram uwejem awattitaram.","poem":1},{"lineBreak":true},{"text":"Turasha kakarum untsuakrum atumi Yusri warartustaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuska chikich nungkanmaya ainaun nepetak iincha:","poem":1},{"lineBreak":true},{"text":"Atum inartaram tusa tsangkatramkamiayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuska Jacobon aneau asa,","poem":1},{"lineBreak":true},{"text":"ni weari ainautinka:","poem":1},{"lineBreak":true},{"text":"Nungka nekas pengkernum pujustaram tusa suramsamiaji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuse aintsri ainau warainak tura untsuminak tura pupunan pupuntrinak pujuinai,","poem":1},{"lineBreak":true},{"text":"Yus ni keemtairin keemsamiayi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus pachisrum kanta kantamataram.","poem":1},{"lineBreak":true},{"text":"Ii Apuri pachisrum kanta kantamataram.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mash nungkanmaya ainau Apuri asamtai,","poem":1},{"lineBreak":true},{"text":"pengker nintimsaram Yus pachisrum kantamataram.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuska mash nungkanmaya ainau Apuri asa,","poem":1},{"lineBreak":true},{"text":"ni keemtairin nekas pengkernum pujawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ju nungkanmaya apu ainauka Yusnau ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai mash ainia nuna Yuska inawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai chikich nungkanmaya apu ainauka Abrahama Yusri aintsri ainaujai iruninawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":8}