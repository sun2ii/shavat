{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":48,"content":[{"type":"heading","content":["Yuse yaktari Sión tutai timiá pengkeraitai"]},{"type":"verse","number":1,"content":[{"text":"Ii Apuringkia juuntaitai.","poem":1},{"lineBreak":true},{"text":"Ni yaktarin pujuinautikia tura ni murarin nekas pengker aa nuni kaunkarutikia ii Yusri:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titinuitji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yakta pajenini mura Sión tutai timiá pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Apu nekas kakaram aa nuna yaktari asamtai,","poem":1},{"lineBreak":true},{"text":"mash nungka ainau warartutintai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuska yakat Jerusalénnumia ainau matsamtainum pujawai.","poem":1},{"lineBreak":true},{"text":"Turasha wikia atumin ejaktinuitjarme tusa,","poem":1},{"lineBreak":true},{"text":"ni aintsri ainautin nekamtikramamiaji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apu ainau Jerusalén yumpungtai tusar kaunkarmiayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Antsu nu yaktanka wainkar shaminak tupikiakiarmiayi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura sapijminak kurainiarmiayi.","poem":1},{"lineBreak":true},{"text":"Nuniasha nuwa uchin jateemawa nunisarang najaimin armiayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus tsaa taakmanumanini nasen kakarman akupak,","poem":1},{"lineBreak":true},{"text":"yakat Tarsisnumia juun kanu ainaun kupiawa nunisang nu apu ainaunka kiishmakmiayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii yaanchuik antukmiaji nunaka miatrusang umiku wainkamiaji:","poem":1},{"lineBreak":true},{"text":"Yuska timiá kakaram asa,","poem":1},{"lineBreak":true},{"text":"ni yaktarin Jerusalénnum pujuinaunka tuke inaitsuk wainkatnuitai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusru ami jeemin wayaarkia,","poem":1},{"lineBreak":true},{"text":"aminu anengkratairum tuke nintimu weaji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusru ame timiá juun asakmin,","poem":1},{"lineBreak":true},{"text":"mash nungkanmaya ainau amin naarmin pachisar:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turaminawai.","poem":1},{"lineBreak":true},{"text":"Ame timiá kakaram asam,","poem":1},{"lineBreak":true},{"text":"aints ainausha tuke inawaitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mura Sión tutainum pujuinauka warasarti.","poem":1},{"lineBreak":true},{"text":"Tura ame aints ainaun pengker inau asakmin,","poem":1},{"lineBreak":true},{"text":"Judá yaktarin pujuinauka nukap warasarti.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ii Yusringkia tuke pujawai.","poem":1},{"lineBreak":true},{"text":"Ningki iinka jintintramak pujustinuitai.","poem":1},{"lineBreak":true},{"text":"Sión mura tentakrum jea jeamkamuri ainau tura kayajai wenurmaurisha jiisrum,","poem":1},{"lineBreak":true},{"text":"ukunam akiinawartin ainauka nekaawarti tusaram etserkatnuitrume.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":12}