{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":49,"content":[{"type":"heading","content":["Kuikiaka itiurtukchatnuitai"]},{"type":"verse","number":1,"content":[{"text":"Mash nungkanam pujuinautiram,","poem":1},{"lineBreak":true},{"text":"kuikiartin ainautiram tura kuikiartichu ainautirmesha,","poem":1},{"lineBreak":true},{"text":"nunia miajuitjai tumamin ainautiram tura mianchau ainautirmesha,","poem":1},{"lineBreak":true},{"text":"ju chichamka tenapkesrum antuktaram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yamaikia Yuse nekamtairin pachisan chicham yumtin ainaun nekamtikiatjarme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kitarran tuntuikiamaikiakun chichaman nekaachminun kantamkun nekamtikiatjarme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pasé kinta jeamtaisha,","poem":1},{"lineBreak":true},{"text":"tura wina nemasur ainau tentatkaramtaisha ¿warukanak shamkataj?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nu aints ainauka ni kuikiarin nintimsar:","poem":1},{"lineBreak":true},{"text":"Wikia yuumakchatatjai tinawai.","poem":1},{"lineBreak":true},{"text":"Nuniasha wikia nukap warinchurtinuitjai tumaminawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Antsu aints kichkisha ningkikia uwemrachartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura Yus uwemtikrurti tusarka kuikianka kichkisha akiimiakchartinuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke jatsuk pujusmi tusarkia,","poem":1},{"lineBreak":true},{"text":"kuikiajaingkia pengké akiimiatmamkachminuitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aints nintip ainauka tura nintinchau ainausha mash metek jainawai.","poem":1},{"lineBreak":true},{"text":"Tura ni kuikiarinka chikichan ukurinawai tusar,","poem":1},{"lineBreak":true},{"text":"paan nekaamnawaitji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aints ni nungkarin tura ni yaktarin ni naarijai inaikiamu ainayat,","poem":1},{"lineBreak":true},{"text":"ni tuke iwiarsamurin matsamsartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura tuke mengkaakartin ainawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aints ainauka kuikiartin ainayat,","poem":1},{"lineBreak":true},{"text":"tukeka pujuschartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu kuntin jaina nunisarang jakaartin ainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aints ningki nintimtumasar:","poem":1},{"lineBreak":true},{"text":"Wikia kuikiartinuitjai tumamin ainauka tuke mengkaakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura miajuitjai tumamin ainausha nunisarang tuke amukartin ainawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aints miajuitjai tumamin ainau kakarmaringkia yaitas mengkawai.","poem":1},{"lineBreak":true},{"text":"Tura asar tuke iwiarnastinnum jeainawai.","poem":1},{"lineBreak":true},{"text":"Uwija wainin ni uwijarin achik juwawa nunisang jataka nu aints ainaunka achiktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ukunam pengke aints ainau jakamunmaya nantakiar,","poem":1},{"lineBreak":true},{"text":"nu pasé aints ainaun inarartin ainawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Antsu winaka Yus jakamunmaya uwemtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni pujamurin juruktinuitai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Chikich aints kuikiartin asa,","poem":1},{"lineBreak":true},{"text":"ni jeen warinchu untsuri itau wainkurmesha napchauka nintimrairap.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nuna turinutiat ni jaakka,","poem":1},{"lineBreak":true},{"text":"ninu aa nunaka kichkisha jukichminuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni warinchuri ainauncha ni iwiarnatniurinka jeekachminuitai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ni iwiaaku pujakka kuikiartin asa nukap waraawai.","poem":1},{"lineBreak":true},{"text":"Tura kuikiartin asamtai,","poem":1},{"lineBreak":true},{"text":"chikich aints ainau pengker nintimtuti ayat,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ni jakatniuri kintaka jeartinuitai.","poem":1},{"lineBreak":true},{"text":"Turamtai nuniangka paaniunka pengké wainkashtinuitai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aints ainauka kuikiartin ainayat,","poem":1},{"lineBreak":true},{"text":"tukeka pujuschartin ainawai.","poem":1},{"lineBreak":true},{"text":"Antsu kuntin jaina nunisarang jakaartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":18}