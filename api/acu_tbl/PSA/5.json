{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":5,"content":[{"type":"heading","content":["David: Kinta tsawaamujai metek Yus seatnuitji timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina Apur asam,","poem":1},{"lineBreak":true},{"text":"tura wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"wina chichamur anturtukta.","poem":1},{"lineBreak":true},{"text":"Wi napchau nintimsan mayairukmaikiakun seajme.","poem":1},{"lineBreak":true},{"text":"Tura amin seajme nu amesha anturtukta tajame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru kashik wina chichamur anturtuktatme.","poem":1},{"lineBreak":true},{"text":"Tura asan wisha amin airkat tusan nakastatjame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusru ameka pasé aa nuka nakitame.","poem":1},{"lineBreak":true},{"text":"Pasé aints ainauka amijai tsaniasarka pujuscharmin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aints miajuitjai tumamin ainauka ami pujutirminka pujuschartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai tunau takau ainauka ameka tsuutame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Turasha waitrin ainauka mengkaaktinuitme.","poem":1},{"lineBreak":true},{"text":"Tura tsanumin ainausha tura mangkartin ainausha nakitratnuitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Antsu wina anentu asakmin,","poem":1},{"lineBreak":true},{"text":"ami jeemin wayaamnawaitjai.","poem":1},{"lineBreak":true},{"text":"Tura nuni wayaan amin nintimtusan:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titinuitjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru wina nemasur ainau untsuri asaramtai,","poem":1},{"lineBreak":true},{"text":"ame pengker asam jintim inaktursata,","poem":1},{"lineBreak":true},{"text":"turasha nuni wekaamtikrusta tusan seajme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka nekas chichamnaka tuke chichachu ainawai.","poem":1},{"lineBreak":true},{"text":"Ni nintisha tuke paseetai.","poem":1},{"lineBreak":true},{"text":"Ni jangkengka jakau iwiarsamu urakmawa nunisarang pasé chichau ainawai.","poem":1},{"lineBreak":true},{"text":"Tura jimia chichamtin asar tuke anangminak chichainawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusru nu aints ainau ni wait wajaktintri susarta.","poem":1},{"lineBreak":true},{"text":"Turasha ni pasé nintimaurisha mengkatkarta.","poem":1},{"lineBreak":true},{"text":"Aminu nemasem asar,","poem":1},{"lineBreak":true},{"text":"aminu chichammin umirtan nakitin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai ame nu aints ainau jiikim utsangta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Antsu amin nintimsar:","poem":1},{"lineBreak":true},{"text":"Ayamtikrurta tinu ainautikia mash warastinuitji.","poem":1},{"lineBreak":true},{"text":"Ame ayamtikramu asar tuke warasar kantamatatji.","poem":1},{"lineBreak":true},{"text":"Apuru amin umirkur pujuinautin pengker awajkartusu asakmin,","poem":1},{"lineBreak":true},{"text":"ame aneau asar amek nintimsar waraaji.","poem":1},{"lineBreak":true},{"text":"Ame pengker asam,","poem":1},{"lineBreak":true},{"text":"aints tantaaran takus ni nemase ainaun shamtsuk nakawa nunismek aminu aintsrum ainau tentakam wainu weame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":10}