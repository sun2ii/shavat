{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":50,"content":[{"type":"heading","content":["Mash nungkanmaya ainau turamuri jiistinka Yusketai"]},{"type":"verse","number":1,"content":[{"text":"Ii Apuringkia mash aints ainau yusri Yusrintai.","poem":1},{"lineBreak":true},{"text":"Ni tsaa taakmanumaninisha tura tsaa jeamunmaninisha mash nungkanam pujuinaun chicharkamia nuketai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yus ni yaktari Sión tutainum timiá pengker aa nuni pujus ni paaniurincha akupawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ii Yusringkia tatinuitai.","poem":1},{"lineBreak":true},{"text":"Antsu winakka takamtaikia winishtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni tatintri jeatsaing,","poem":1},{"lineBreak":true},{"text":"ji tsuweran eemak akupkatnuitai.","poem":1},{"lineBreak":true},{"text":"Turamtai ipiamat kakaram niinka tenteatnuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuska yakiiya chichaak:","poem":1},{"lineBreak":true},{"text":"“Wina aintsur turamuri jiirmatai,","poem":1},{"lineBreak":true},{"text":"atumsha jiitaram” tusa,","poem":1},{"lineBreak":true},{"text":"nayaimpinam tura nungkanam pujuinauncha untsuktinuitai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura untsuak:","poem":1},{"lineBreak":true},{"text":"“Wina umirtukaru ainauka wina umirtukartas tangkurin main armia nuka irurtaram” titinuitai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yus tamati nayaimpinam pujuinauka:","poem":1},{"lineBreak":true},{"text":"Yus aints ainaun tunaarin nekamtikin asa,","poem":1},{"lineBreak":true},{"text":"nekas pengkeraitai tiartinuitai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus Israel ainautin chichartamak:","poem":1},{"lineBreak":true},{"text":"“Wina aintsur ainautiram anturtuktaram.","poem":1},{"lineBreak":true},{"text":"Atumjaingkia tépaan chichastatjarme:","poem":1},{"lineBreak":true},{"text":"¡Wikia Yusetjai,","poem":1},{"lineBreak":true},{"text":"atumi Yusrinjai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Atumi tangkuri maaram tuke epee wearme nuna pachisnaka:","poem":1},{"lineBreak":true},{"text":"Nuka paseetai tatsujrume.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Turasha wikia atumniaka:","poem":1},{"lineBreak":true},{"text":"Waaka uchiri maaram,","poem":1},{"lineBreak":true},{"text":"tura chipu aishmangkrisha maaram wina surustaram tatsujrume.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kuntin ainau tura tangku ainau muranam irunuka mash winar ainawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muranam nanamin ainausha tura paka nungkanam yujainausha mash winar ainawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mash nungka ainauka winar ainawai.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanam iruna nusha winar asaramtai,","poem":1},{"lineBreak":true},{"text":"wi tsukamakun pujaknasha atumniaka ujakchatnuitjarme.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Wikia waaka namangken yuukitaj? ¿Tura chipu numpen uminkitaj?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunaka pengké yuumatsjai.","poem":1},{"lineBreak":true},{"text":"Antsu winaka tuke maaketai turuttiaram tusan nunak wakerajai.","poem":1},{"lineBreak":true},{"text":"Tura wi turatatjai turutmiarume nuke umiktaram.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Shamakrum pujakrumka wina seattiaram.","poem":1},{"lineBreak":true},{"text":"Turuakrumningkia wikia atumin angkanmamtikiatatjarme.","poem":1},{"lineBreak":true},{"text":"Wi turamtai atumka wina warartursataram”,","poem":1},{"lineBreak":true},{"text":"Yus turamji.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Antsu pasé aints ainaun Yus chicharak:","poem":1},{"lineBreak":true},{"text":"“Atumi tunaari inaisataram tamaitiatrum,","poem":1},{"lineBreak":true},{"text":"nu antut nakitau asaram,","poem":1},{"lineBreak":true},{"text":"wina chichamur tuntupearam ukuarme.","poem":1},{"lineBreak":true},{"text":"Tura asaram wina chichamur etserkachmin ayatrumsha ¿warukaya wina chichamrusha etserume?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Atumka kasa ainau wainkaram nujai amikmaram,","poem":1},{"lineBreak":true},{"text":"tura kajmin ainausha wainkaram nujai iruntraram pujarme.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tura pasé chicham chichastasrum atumi jangke awaa wearme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tura atumi yachí pachisrum aujmatu wearme nunia jiyaa wearme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nunaka mash nekayatun wikia chichakchamiajai.","poem":1},{"lineBreak":true},{"text":"Atumek nintimsaram:","poem":1},{"lineBreak":true},{"text":"Yuska iijai metekaitai tarume.","poem":1},{"lineBreak":true},{"text":"Tu nintimu asakrumin atumin wiasmatkatatjarme.","poem":1},{"lineBreak":true},{"text":"Tura atumi nintimaurincha tu awai tusan nekamtikiatatjarme.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Atum wina kajinmatrukrum pujau asaram,","poem":1},{"lineBreak":true},{"text":"tenapkesrum anturtuktaram.","poem":1},{"lineBreak":true},{"text":"Antsu wina anturtutsuk pujakrumningkia,","poem":1},{"lineBreak":true},{"text":"wikia atumin tsairtinuitjarme.","poem":1},{"lineBreak":true},{"text":"Wi turamtaisha ¿yáki atumnasha uwemtikramrarat?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Antsu wina maaketai turutinauka winaka waramtikrusartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura wina jintarun wekainaunka wikia uwemtikratnuitjai”,","poem":1},{"lineBreak":true},{"text":"Yus tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":22}