{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":51,"content":[{"type":"heading","content":["David: Yusru wait anentrurta timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru ame timiá wait anengkratin asam,","poem":1},{"lineBreak":true},{"text":"wait anentrurta.","poem":1},{"lineBreak":true},{"text":"Tura timiá pengker asam,","poem":1},{"lineBreak":true},{"text":"wina tunaaruka tsangkutrurta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi tunau asamtai nintir nijatrurta.","poem":1},{"lineBreak":true},{"text":"Tura pasé aints asamtai nintir japitrurta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wikia ami chichamin umirkachuitjai tusan nekajai.","poem":1},{"lineBreak":true},{"text":"Tura wina tunaarunka tuke nintimsan pujajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ameka jiimia pujamning,","poem":1},{"lineBreak":true},{"text":"ame nakitame nuna takasmiajai.","poem":1},{"lineBreak":true},{"text":"Tura asan ame tunaawaitme turutme nunaka nekasaintai tajame.","poem":1},{"lineBreak":true},{"text":"Tura ame tunau asam wait wajaktatme turutme nunasha pengkeraitai tajame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wikia nekasan akiinamunmayang tunaawaitjai.","poem":1},{"lineBreak":true},{"text":"Tura nukuru muntsurin muntsuyaja nuning tunau ayajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tu ataing nekasam pengke nintintin ata tusam wakerutame.","poem":1},{"lineBreak":true},{"text":"Tura asam paan nintimratnusha surusuitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura asamtai wisha seajme:","poem":1},{"lineBreak":true},{"text":"Wina nintir japitrurta.","poem":1},{"lineBreak":true},{"text":"Turutakminkia tunaarinchau wajastatjai.","poem":1},{"lineBreak":true},{"text":"Turasha tunaar tsangkutrurta.","poem":1},{"lineBreak":true},{"text":"Turutakminkia angkan wajastatjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura tunaawitme turutiatmek ataksha waramtikrusta tusan seajme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wina tunaar ainauka mengkaatrukta.","poem":1},{"lineBreak":true},{"text":"Tura wina pasé turutir ainausha mash sakturata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusru nintir tunaarinchau awajtursata.","poem":1},{"lineBreak":true},{"text":"Turasha yamaram nintimau tupin nintimratin aa nu surusta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aminka jiitnaka nakitajme turutiip.","poem":1},{"lineBreak":true},{"text":"Tura ami Wakanim pengker aa nu jurutrukiip.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura nekasan uwemrawaitjai,","poem":1},{"lineBreak":true},{"text":"tu nintimsan warastinka ataksha surusta.","poem":1},{"lineBreak":true},{"text":"Tura ami pengker Wakanmijai kakamtikrurta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tura asakmin ami chichammin umirtan nakitinaunka ataksha ami jintimin wekaasarti tusan jintintawartinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai tunaarintin ainau ni tunaarincha inaisar aminak umirtamkartinuitai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yusru wina uwemtikruru asam,","poem":1},{"lineBreak":true},{"text":"aints maawaip tusam ame surimrukta.","poem":1},{"lineBreak":true},{"text":"Turakmin amin pachisan:","poem":1},{"lineBreak":true},{"text":"Aints pengker inawaitme tusan kantan kantamruatjame.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apuru wina jangker uratriniakminkia amin:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tusan kantan kantamruatjame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ame tangku maata turutkumningkia,","poem":1},{"lineBreak":true},{"text":"nunaka umiktinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura tangku epeata turutkumnisha wikia turamnawaitjai.","poem":1},{"lineBreak":true},{"text":"Turayatun nujaingkia pengkerka awajsachainjame.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Antsu Yus asam,","poem":1},{"lineBreak":true},{"text":"ame nekasam wakerame nuka juwaitai:","poem":1},{"lineBreak":true},{"text":"Aints tunau asa,","poem":1},{"lineBreak":true},{"text":"miajuitjai tumamtsuk,","poem":1},{"lineBreak":true},{"text":"antsu napchau nintimias:","poem":1},{"lineBreak":true},{"text":"Tunaawapitja tusa ni tunaarin inais,","poem":1},{"lineBreak":true},{"text":"amin nintimturmas pujauka,","poem":1},{"lineBreak":true},{"text":"Yusru nu aintsnaka tsuutajai pengké tichatatme.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ame wakerau asam,","poem":1},{"lineBreak":true},{"text":"Sión yaktaka pengker awajsata.","poem":1},{"lineBreak":true},{"text":"Tura kayajai wenukri ataksha inankiarti tusam tsangkamkata.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Turakmin tangkun maawar epee armia nuna ataksha turinamtai,","poem":1},{"lineBreak":true},{"text":"nuka pengkeraitai titatme.","poem":1},{"lineBreak":true},{"text":"Turasha amin suramsartas epeena nuka jiisam,","poem":1},{"lineBreak":true},{"text":"pengkeraitai titatme.","poem":1},{"lineBreak":true},{"text":"Nu turakminkia tangku epetinam ataksha waaka uchirin epetan nangkamawartinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}