{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":54,"content":[{"type":"heading","content":["David: Yus yainkati tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Yusru uwemtikrurta tusan,","poem":1},{"lineBreak":true},{"text":"amin naarmin pachisan seajme.","poem":1},{"lineBreak":true},{"text":"Tura ami kakarmarmijai ayamrutkata.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yusru wina seamur anturtukta.","poem":1},{"lineBreak":true},{"text":"Tura wina chichaamur tenapkesam anturtukta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mangkartin ainau:","poem":1},{"lineBreak":true},{"text":"Wikia miajuitjai tumamina nuka wina mantuwartas wakerutinak aminka nintimturminatsui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Turutinau wainiatun wiki nintimsanak:","poem":1},{"lineBreak":true},{"text":"Wina Yusur winaka yaintui.","poem":1},{"lineBreak":true},{"text":"Tura wina Apur iwiaaku pujusti tusa winaka waitui,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka timiá pasé pujuinau asaramtai,","poem":1},{"lineBreak":true},{"text":"Yusur ningki yapaijkiatnuitai,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apuru ame tuke pengker asam,","poem":1},{"lineBreak":true},{"text":"nu aints ainau mengkaakarta.","poem":1},{"lineBreak":true},{"text":"Ameka wi shamrumtinnum pujai,","poem":1},{"lineBreak":true},{"text":"angkantin awajtusmame.","poem":1},{"lineBreak":true},{"text":"Nu turau asam,","poem":1},{"lineBreak":true},{"text":"wina nemasur nepetkamame nunasha wainkamjai.","poem":1},{"lineBreak":true},{"text":"Tura ame pengker asakmin,","poem":1},{"lineBreak":true},{"text":"wiki nimtimsanak tangkurun maan amin susatasan epeatatjai.","poem":1},{"lineBreak":true},{"text":"Nunia amin naarmin pachisan warartustatjame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}