{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":55,"content":[{"type":"heading","content":["David: Wina nemasur ainaun Yus mengkatrukti tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wi seajme nu anturtukta.","poem":1},{"lineBreak":true},{"text":"Wi seamur anturtutskeka pujusaip.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Antsu pengker nintimtursam airkata.","poem":1},{"lineBreak":true},{"text":"Wi napchau nintimsan pujau asan tajame:","poem":1},{"lineBreak":true},{"text":"Wina nemasur ainau chichainamurin tura pasé aints ainau shiniinamurin antukan kuraajai.","poem":1},{"lineBreak":true},{"text":"Nu aints ainauka wait wajaktiniun untsuri surusar,","poem":1},{"lineBreak":true},{"text":"kajertukar nepetukartas wakerutinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura asamtai wina nintirka sapijmiakun nukap teetui.","poem":1},{"lineBreak":true},{"text":"Wikia jakatatjapi tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura tenukap shamau asan,","poem":1},{"lineBreak":true},{"text":"sapijmiakun kuraajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura asan yapangkam nanamina nunisnak nanamin akunka,","poem":1},{"lineBreak":true},{"text":"nanaminapi ayamsainja tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura nanamnuitkunka arák wena aints atsamunam pujusminuitjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura nase kakarman nasenmataikia,","poem":1},{"lineBreak":true},{"text":"tura ipiamtasha untsuri patinamtaisha,","poem":1},{"lineBreak":true},{"text":"nanamin akunka anumkatasan wári tupikiakminuitjai,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru wikia mangkartin ainau turamurin wainkan,","poem":1},{"lineBreak":true},{"text":"tura ni maaniamurincha wainkau asamtai,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau mengkaakarta,","poem":1},{"lineBreak":true},{"text":"tura ni chichamesha nuwamtikiarta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nu mangkartin ainau tsawaisha tura kashisha yaktanam wekajinawai.","poem":1},{"lineBreak":true},{"text":"Tura asar yaktanam tuke pasé aa nuna turinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nu yaktanmaka aya mangkartutiri tura waitrutiri nukap ainawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wina nemasruka winaka paseenaka awajtuscharmayi.","poem":1},{"lineBreak":true},{"text":"Nu pasé awajtinamtaisha wikia tsantramnauyajai.","poem":1},{"lineBreak":true},{"text":"Tura wina kajertin ainausha","poem":1},{"lineBreak":true},{"text":"winaka eatkacharmayi.","poem":1},{"lineBreak":true},{"text":"Wina eatinamtaisha wikia anumkamnauyajai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antsu nuka nekas wina tsaniakmauruketai.","poem":1},{"lineBreak":true},{"text":"Turasha wina nekas amikur ayayi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nijai pengker nintimsar chichasmi tusar,","poem":1},{"lineBreak":true},{"text":"tuke Yuse jeen irunnuyaji.","poem":1},{"lineBreak":true},{"text":"Tura nijai aints iruntramunmasha wekainuyaji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau aneachmau jakaarti.","poem":1},{"lineBreak":true},{"text":"Ni ninti tunau piaku asaramtai,","poem":1},{"lineBreak":true},{"text":"iwiaaku ainayatang jakau iwiarsamunam ayaararti.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Antsu wikia Yusen seatatjai.","poem":1},{"lineBreak":true},{"text":"Wi turamtai wina Apur uwemtikrurtatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kashiksha tura tsaa tupnisha tura kashisha Apurun untsukan seatatjai.","poem":1},{"lineBreak":true},{"text":"Wi untsuam wina chichamrun anturtuktatui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wina nemasur untsuri au wainiatang wina Apurka angkan awajtustatui.","poem":1},{"lineBreak":true},{"text":"Tura maawarai tusa uwemtikrurtatui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka Yusnasha nintimtsuk pujuinau asar,","poem":1},{"lineBreak":true},{"text":"ni pujutrinka yapajiachartin ainawai.","poem":1},{"lineBreak":true},{"text":"Turinau wainiatang Yus aints ainaun tuke ina nuka wina nemasur ainaun inatsaartatui.","poem":1},{"lineBreak":true},{"text":"Turak winasha anturtuktatui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tura amikmami tinayat,","poem":1},{"lineBreak":true},{"text":"nu chichamnaka umiinatsui.","poem":1},{"lineBreak":true},{"text":"Antsu ni amikrinak maawartin ainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ni chichamenka jaimiasar chichainayat,","poem":1},{"lineBreak":true},{"text":"mesetan nintimin ainawai.","poem":1},{"lineBreak":true},{"text":"Ni chichamenka antujamniau chichainayat,","poem":1},{"lineBreak":true},{"text":"nangki tsakamua tumau ainawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aints Yusen umirak pujaunaka ayaarti tusangka,","poem":1},{"lineBreak":true},{"text":"Yuska pengké tsangkatkashtatui.","poem":1},{"lineBreak":true},{"text":"Tura asamtai ame napchau nintimsam pujamurminka ii Apuri jurutkiti tusam tsangkatkata.","poem":1},{"lineBreak":true},{"text":"Ame turakminka ukurmakchatatui.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yusru mangkartin ainau tura wait chichaman chichau ainau chikich aints ainaujai metekka nukapka pujuschartin ainawai.","poem":1},{"lineBreak":true},{"text":"Ameka nu aints ainau jakaar iwiarsamunam ayaararti tusam akupkatnuitme.","poem":1},{"lineBreak":true},{"text":"Antsu wikia amin nintimtajme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":22}