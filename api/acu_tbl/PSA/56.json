{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":56,"content":[{"type":"heading","content":["Yusrun nekasampita tau asan ni chichamen wararjai"]},{"type":"verse","number":1,"content":[{"text":"Yusru aints ainau wina papeetinau asaramtai,","poem":1},{"lineBreak":true},{"text":"wait anentrurta.","poem":1},{"lineBreak":true},{"text":"Kintajai metek wina nepetukartas wakerutinawai.","poem":1},{"lineBreak":true},{"text":"Tura asar napchau nintimtikrinawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kintajai metek wina papeetinawai.","poem":1},{"lineBreak":true},{"text":"Untsuri aints miajuitjai tusar,","poem":1},{"lineBreak":true},{"text":"wina nepetukartas wakerutinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura asaramtai shamaknasha tuke amin nintimtajme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusrun nekasampita tau asan ni chichamen wararjai.","poem":1},{"lineBreak":true},{"text":"Yusrun nekasampita tau asan shamkartatsjai.","poem":1},{"lineBreak":true},{"text":"¿Aints ainausha winasha itiurtukarting?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wina nemasur ainauka kintajai metek ni chichamejai wina pasé nintimtikrinawai.","poem":1},{"lineBreak":true},{"text":"Nuka tuke wina pasemamtikrurartas nintiminawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura anumkar tuke wekaaturinawai.","poem":1},{"lineBreak":true},{"text":"Tura wina mantuwartas nakarinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Ni pasé turamurin inaisartimpiash?","poem":1},{"lineBreak":true},{"text":"Yusru ame kajekmaurumjai nu tunau aints ainauka mengkaakarta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wi tupikiakmiaurusha ameka mash nekaamame.","poem":1},{"lineBreak":true},{"text":"Turasha wina neaikirka mash nekapmame.","poem":1},{"lineBreak":true},{"text":"¿Wina neaikir ami papirumin mash aarchamukai?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi yainkata tusan seamtai,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainauka waketinawai.","poem":1},{"lineBreak":true},{"text":"Waketinau asaramtai Yuska wijai pujawai tusan nekajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusur wina Apur asamtai,","poem":1},{"lineBreak":true},{"text":"nekasampita tau asan ni chichamen wararjai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yusrun nekasampita tau asan shamkartatsjai.","poem":1},{"lineBreak":true},{"text":"¿Aints ainausha winasha itiurtukarting?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yusru wikia jakatniunam pujaing,","poem":1},{"lineBreak":true},{"text":"tuke ami paaniurmin iwiaaku pujustinnum pujusmi tusam uwemtikrurmame.","poem":1},{"lineBreak":true},{"text":"Turasha ayaartinnumiasha angkan awajtusmame.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wi amin turatatjai timiaja nunaka amin wararkun umiktinuitjai tajame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}