{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":59,"content":[{"type":"heading","content":["David: Iin waitmaktinka ii Apurintai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru wina nemasur ainamunmaya angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Tura wina nepetukartas wakerutina nunia uwemtikrurta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aints kakaram ainau wina mantuwartas nakarinawai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai pasé turina nunia angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Turasha mangkartin ainamunmaya uwemtikrurta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru wikia ami chichamminka umirtanka nakitchau ayajai.","poem":1},{"lineBreak":true},{"text":"Tura tunaanasha takachu ayajai.","poem":1},{"lineBreak":true},{"text":"Turai waitinayat wina nepetukartas wakerutinawai.","poem":1},{"lineBreak":true},{"text":"Apuru wajakim wina ingkiunkam jiirsata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru ameka timiá kakaram asam,","poem":1},{"lineBreak":true},{"text":"tura ii Yusri asam,","poem":1},{"lineBreak":true},{"text":"amin umirtamchau ainau ni wait wajakartintri susarta.","poem":1},{"lineBreak":true},{"text":"Nu pasé aints ainau chikich ainaun anangkawar surukartas wakerina nuka wait anentsuk asarta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kashi yawaa ainminawa nunisarang yaktan tentakar wekajinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Turasha kuchi kajeak sauran apawa nunisarang ainawai.","poem":1},{"lineBreak":true},{"text":"Turasha wishiinak:","poem":1},{"lineBreak":true},{"text":"“¿Yaachik iincha anturtamkataij?” tinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tura wainiatum Apuru ameka nu amin umirtamchau ainauka wishiku pujame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusru ameka wina kiakatratnuitme,","poem":1},{"lineBreak":true},{"text":"turasha wina ayamrutkatnuitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin wikia amin ejamkatnuitjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yusru wina anentu asam,","poem":1},{"lineBreak":true},{"text":"wijai ingkiuniktinuitme.","poem":1},{"lineBreak":true},{"text":"Turasha wina nemasur ainaun nepetkatin inaktursatnuitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wina aintsur ainau kajinmakiarai tusam,","poem":1},{"lineBreak":true},{"text":"wina nemasur ainau maatka maawaip.","poem":1},{"lineBreak":true},{"text":"Antsu niish niish tupikiakiarti tusam,","poem":1},{"lineBreak":true},{"text":"ami kakarmarmijai akupkarta,","poem":1},{"lineBreak":true},{"text":"turasha inatsaarta.","poem":1},{"lineBreak":true},{"text":"Ii Apuri asam,","poem":1},{"lineBreak":true},{"text":"iin ayamrutmaktinmeka ametme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nu pasé aints ainauka tuke tunau chichaman chichainak:","poem":1},{"lineBreak":true},{"text":"Wikia miajuitjai tumamsar wait chichaman chichainau asar,","poem":1},{"lineBreak":true},{"text":"achikmawa nunisarang arti.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yusru ame kajekmaurumjai nu aints ainauka wári amukarta.","poem":1},{"lineBreak":true},{"text":"Ame turakmin Jacobo Yusringkia ni nungkari Apurintai tusar nekaawarti.","poem":1},{"lineBreak":true},{"text":"Tura mash nungka ainau Apuringkia Yusketai tusar nekaawarti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nu pasé aints ainauka kashi yaktanam taar,","poem":1},{"lineBreak":true},{"text":"yawaa ainminawa nunisarang yaktanam yutain eainaksha wainkachar juutiartin ainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apuru ameka wina yamrutin ayame.","poem":1},{"lineBreak":true},{"text":"Tura shamakun pujamtaisha,","poem":1},{"lineBreak":true},{"text":"wina waitin ayame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin wikia kashik aminka kantan kantamruatjame.","poem":1},{"lineBreak":true},{"text":"Tura kakaran chichaakun ami anengkratairumin pachisan,","poem":1},{"lineBreak":true},{"text":"tura ami kakarmarmincha pachisan chichastatjai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yusru wina kakamtikrurtinmeka ametme.","poem":1},{"lineBreak":true},{"text":"Tura ametme ejarkatnumka.","poem":1},{"lineBreak":true},{"text":"¡Yusru ameka winaka tuke anentin asakmin,","poem":1},{"lineBreak":true},{"text":"kantan kantamruatjame!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":15}