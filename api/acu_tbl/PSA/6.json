{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":6,"content":[{"type":"heading","content":["David: Wake mesek Yusen seamuri"]},{"type":"verse","number":1,"content":[{"text":"Apuru ame kajertukam jiyatkaip.","poem":1},{"lineBreak":true},{"text":"Tura aminu suwirumjai wait wajaktinka surusaip.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apuru wikia kakarchamin nekapeau asamtai wait anentrurta.","poem":1},{"lineBreak":true},{"text":"Apuru wina namangkur kura kura wajau asamtai,","poem":1},{"lineBreak":true},{"text":"wait aneasam ataksha pengker wajasta tusam inantukta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wina nintirjai shamakun kuraajai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai Apuru ¿warutik yainkatnuitam?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru winita.","poem":1},{"lineBreak":true},{"text":"Tura jakai tusam uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Timiá wait anengkratin asam uwemtikrurta tajame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jakaru ainauka kichkisha aminka nintimturminatsui.","poem":1},{"lineBreak":true},{"text":"¿Jakaru ainausha iwiarsamurin tepesar:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turaminawak?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wikia juu juutkan pimpiran pujajai.","poem":1},{"lineBreak":true},{"text":"Kashijai metek juu juutkan neaikirjai tamrutirun chupran tepajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wina nemasur ainaun nintimtusan juutu asan,","poem":1},{"lineBreak":true},{"text":"jiirusha wainmakchamin mushatmari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Antsu Apurka wina juutmaurun anturtuku asamtai,","poem":1},{"lineBreak":true},{"text":"pasé takau ainauka wijaingkia iruntsuk yajá wearti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wina Apurka wi seamurnaka antukuitai.","poem":1},{"lineBreak":true},{"text":"Tura wi seaja nunaka mashiapi umiktatua tusan nekajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau shaminak jakaartas wakerinawai.","poem":1},{"lineBreak":true},{"text":"Turasha natsaaminak aints mitsum mitsum wajainawa nunisarang tupikiakiartinuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}