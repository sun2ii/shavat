{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":62,"content":[{"type":"heading","content":["David: Yusnau asan angkantaitjai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Yusnau asan angkantaitjai.","poem":1},{"lineBreak":true},{"text":"Iin uwemtikramratnuka nuketai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ningki wina uwemtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Ningki wina ejarkatnuitjai.","poem":1},{"lineBreak":true},{"text":"Ningkitai wina waitkatnuka.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wikia natsaamtsuk pujusminuitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Wina nemasur ainausha waruka winasha nepetukartascha wakerutinawa? Wikia wenuk pukuutanak wajasua nunisketjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke nepetukartas nintimturinawai.","poem":1},{"lineBreak":true},{"text":"Turasha wait chichaman tuke wakerinawai.","poem":1},{"lineBreak":true},{"text":"Ni jangkejaingkia pengke aintsuitme turutinayat,","poem":1},{"lineBreak":true},{"text":"ni nintimaurijaingkia pasé nintimturinawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Antsu Yus wina yainkati tusan nakajai.","poem":1},{"lineBreak":true},{"text":"Angkan pujustinka Yusnumiayaintai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ningki wina uwemtikrurtinuitai.","poem":1},{"lineBreak":true},{"text":"Ningki ejarkatnuitai.","poem":1},{"lineBreak":true},{"text":"Ningkitai wina waitkatnuka.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wikia natsaamtsuk pujusminuitjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yusketai wina uwemtikrurtinka.","poem":1},{"lineBreak":true},{"text":"Tura asa ningki wina pengker awajtustinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ningkitai wina ejarkatnuka.","poem":1},{"lineBreak":true},{"text":"Turasha ningki winaka waitkatnuitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wi wear ainautiram,","poem":1},{"lineBreak":true},{"text":"Yus tuke nintimtustaram.","poem":1},{"lineBreak":true},{"text":"Tura Yus seakrumka,","poem":1},{"lineBreak":true},{"text":"pengker nintimsaram nijai chichastaram.","poem":1},{"lineBreak":true},{"text":"¡Ningkitai iin waitmaktinka!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aints kuikiartichu ainausha tura kuikiartin ainausha mash nangkamiar pujuinawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atumka mangkartutka tura chikich ainau jeen wayaaram warinchurin kasamkaram jukitnuka nintimsairap.","poem":1},{"lineBreak":true},{"text":"Tura kuikiartin wajakrumsha,","poem":1},{"lineBreak":true},{"text":"atumi kuikiaringkia wararsairap.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yus tímia nunaka untsuri antinuyajai.","poem":1},{"lineBreak":true},{"text":"Wi anturnuyaja nuka nuwaitai:","poem":1},{"lineBreak":true},{"text":"Kakarmaka tura wait anengkrataisha Yusnumiayaintai.","poem":1},{"lineBreak":true},{"text":"Tura ningki aints ainautin ii turamurijai metek yapaijtamkiatnuitai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":11}