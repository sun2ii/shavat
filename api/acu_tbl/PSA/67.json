{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":67,"content":[{"type":"heading","content":["Mash nungkanmaya ainau Yusen: Ameketme juuntam tiartinuitai"]},{"type":"verse","number":1,"content":[{"text":"Ii Yusriya wait anengkratkata,","poem":1},{"lineBreak":true},{"text":"tura pengker awajkartusta.","poem":1},{"lineBreak":true},{"text":"Mash nungkanmaya ainau ami wakeramurmin nekaawarti tusam,","poem":1},{"lineBreak":true},{"text":"tura ame uwemtikiartutai chichaman antukarti tusam pengker awajkartusta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ii Yusri asakmin,","poem":1},{"lineBreak":true},{"text":"mash nungkanmaya ainau:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram turamiarti.","poem":1},{"lineBreak":true},{"text":"Turasha ameketme juuntam turamiarti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mash nungkanmaya ainau amek inawaitme.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanmaya ainau winak umirtukarti tusam jintinnuitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin mash nungkanmaya ainau amincha warartamsar untsurmakarti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ii Yusri asakmin mash nungkanmaya ainau:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram turamiarti.","poem":1},{"lineBreak":true},{"text":"Turasha ameketme juuntam turamiarti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ajanam árak ainau nerekarti tusa,","poem":1},{"lineBreak":true},{"text":"ii Yusri iincha pengker awajtamsamji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Yus iincha pengker awajkartamtai,","poem":1},{"lineBreak":true},{"text":"mash nungkanmaya ainau niincha:","poem":1},{"lineBreak":true},{"text":"Ameketme Yusem tiarti!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":6}