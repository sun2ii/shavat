{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":71,"content":[{"type":"heading","content":["Juuntach Yus seamu"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina ejarkat tusan amin seajme.","poem":1},{"lineBreak":true},{"text":"Wina ajapruam pengké ukurkiip.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura angkanmamtikruata.","poem":1},{"lineBreak":true},{"text":"Tura timiá pengker asam uwemtikrurta.","poem":1},{"lineBreak":true},{"text":"Tura anturtukam yainkata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wikia aints pampanam anuminawa nunismek anumkata tusam tsangkamrukta.","poem":1},{"lineBreak":true},{"text":"Ame wina uurkatin asam,","poem":1},{"lineBreak":true},{"text":"wina ejarkatin ata,","poem":1},{"lineBreak":true},{"text":"turasha wina uwemtikrurtin ata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusru wikia natsa akuncha tuke aminka eayajme.","poem":1},{"lineBreak":true},{"text":"Tura wina Yusur asakmin,","poem":1},{"lineBreak":true},{"text":"pasé aints ainau tura mangkartin ainau amin umirtamchau asaramtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainamunmaya angkanmamtikruata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nukuru ampujenia wina jiirkimiame.","poem":1},{"lineBreak":true},{"text":"Tura akiinamunmayan winaka waitnuyame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin amincha tuke:","poem":1},{"lineBreak":true},{"text":"Ameka wina Yusruitme titatjame.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aints ainau untsuri wina waitkar nukap nintiminawai.","poem":1},{"lineBreak":true},{"text":"Turinau wainiatum ame wina ejarkatin tuke ayame.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kintajai metek ami pengkeerumin nintimsan:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram tinuyajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura asamtai juuntach amatisha tuke waitkata.","poem":1},{"lineBreak":true},{"text":"Tura wina kakarmar atsamtaisha ajapruamka ukurkiip.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau mantuwartas iruntrar chichaman najatrinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuka chichainak:","poem":1},{"lineBreak":true},{"text":"“Yus niin ajapa ukukin asamtai,","poem":1},{"lineBreak":true},{"text":"aints kichkisha ayamrukchatnuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai papeekrum achiktaram”,","poem":1},{"lineBreak":true},{"text":"turutinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yusru tu tinau asaramtai,","poem":1},{"lineBreak":true},{"text":"winaka ajapruam ukurkiip,","poem":1},{"lineBreak":true},{"text":"antsu wári yainkata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wina nemasur ainau inatsaaram mengkaakta.","poem":1},{"lineBreak":true},{"text":"Wina pasé awajtusartas wakerutin ainaunka chikich aints ainau wishikrarti tusam inatsaarta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Antsu wikia amin kintajai metek ame tati tusan nakastatjame.","poem":1},{"lineBreak":true},{"text":"Turakun ameketme Yusem tuke titatjame.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kintajai metek aints ainaun ujaakun:","poem":1},{"lineBreak":true},{"text":"“Yuska iincha uwemtikramnuyaji,","poem":1},{"lineBreak":true},{"text":"turasha iincha pengker awajtamnuyaji”, titatjai.","poem":1},{"lineBreak":true},{"text":"Antsu ¿itiur uwemtikramrayajik? nunaka nintimratatkaman pengké tujintajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apuru amin pachisan:","poem":1},{"lineBreak":true},{"text":"Yus ni kakarmarijai ni nemase ainaun nepetnuyayi,","poem":1},{"lineBreak":true},{"text":"tusan aints ainaun ujaktatjai.","poem":1},{"lineBreak":true},{"text":"Turasha amin pachisan:","poem":1},{"lineBreak":true},{"text":"Ningki aints ainaun mash metek inawai,","poem":1},{"lineBreak":true},{"text":"tusan etserkatatjai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yusru wi natsa amatikia,","poem":1},{"lineBreak":true},{"text":"tuke wina unuitinuyame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin juuntach ayatun,","poem":1},{"lineBreak":true},{"text":"amin pengker turamurmin pachisan etseru weajai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yusru wikia weamran tura jemperukan pujaing waitiatum winaka ajapruam ukurkiip.","poem":1},{"lineBreak":true},{"text":"Tuke ami kakarmarmin pachisan yamai pujuinaun tura ukunam akiinatin ainauncha ujakminuitjai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yusru nayaimpinam pujau asam,","poem":1},{"lineBreak":true},{"text":"aints ainau mash metek inawaitme.","poem":1},{"lineBreak":true},{"text":"Tura ame wainchati takat timiá untsuri takaawitme.","poem":1},{"lineBreak":true},{"text":"Amijai metek kichkisha atsawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Winaka itit awajtukmaur tura wait wajaktincha wainmamtikrin ayame.","poem":1},{"lineBreak":true},{"text":"Turayatum wi jakamtai,","poem":1},{"lineBreak":true},{"text":"winaka inantukim tuke pujusti tusam, iwiarsamunmaya inantuktinuitme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tura aints ainau wina pachitsar:","poem":1},{"lineBreak":true},{"text":"Pengke aintsuitai tiarti tusam,","poem":1},{"lineBreak":true},{"text":"tura wijai pengker nintimias pujusti tusam,","poem":1},{"lineBreak":true},{"text":"winaka pengker awajtustinuitme.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tura asakmin Yusru wikia amin pachisan kantan kantamruatjame.","poem":1},{"lineBreak":true},{"text":"Turasha ameka tuke pengkeraitme titatjame.","poem":1},{"lineBreak":true},{"text":"Ameka Israela pengkerinme tusan,","poem":1},{"lineBreak":true},{"text":"amin kitarran tura arpancha tuntuikiamaikiakun kantan kantamruatjame.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tura wina uwemtikruru asakmin,","poem":1},{"lineBreak":true},{"text":"jangkerjaingkia kantan kantamkun nintirjaingkia warastatjai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wina pasé awajtusartas wakerutin ainauka pengké natsaarar pujuu armiayi.","poem":1},{"lineBreak":true},{"text":"Turinau asaramtai wikia kintajai metek aints ainaun ame pengker turamurmin pachisan chichastatjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":23}