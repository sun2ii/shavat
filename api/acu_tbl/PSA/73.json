{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":73,"content":[{"type":"heading","content":["¿Pasé aints ainausha waruka yuumatskesha pujuinawa?"]},{"type":"verse","number":1,"content":[{"text":"Yus pengke nintintin ainaun nekas pengker awajsatnuitai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Antsu wikia jampesarang pujuinaun suwirpiaku jiakun,","poem":1},{"lineBreak":true},{"text":"tura pasé aints ainauncha suwirpiaku jiakun,","poem":1},{"lineBreak":true},{"text":"aints iyaachak wajawa nunisnak tunau jurumachak wajakjai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pasé aints ainau najaimiatsuk pujuinau asar ni jakatniurinka nintiminatsui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura chikich aints wait wajaina nunisarka waitka wajainatsui.","poem":1},{"lineBreak":true},{"text":"Tura chikich aintska itiurkachminnum pujuina nunisarka pujuinatsui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura asar jampesarang pujuinawai,","poem":1},{"lineBreak":true},{"text":"tura chikich aints ainauncha pasé awajinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni namangkengka apuitai.","poem":1},{"lineBreak":true},{"text":"Turayat tuke ni nintijai tunau nintimin ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chikich aints ainaun wishikinawai.","poem":1},{"lineBreak":true},{"text":"Tura jampesarang:","poem":1},{"lineBreak":true},{"text":"Wi wakeraknaka pachitsuk pasé aa nunaka turamnawaitjai tinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusnasha pachisar pasé chichainawai,","poem":1},{"lineBreak":true},{"text":"tura aintsnasha pachisar tuke aujmatinawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tu pujuinau asaramtai,","poem":1},{"lineBreak":true},{"text":"chikich aints ainau niin pachisar:","poem":1},{"lineBreak":true},{"text":"Nekasar pengker pujuinawai tinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura nintiminak:","poem":1},{"lineBreak":true},{"text":"¿Itiur pujuinawa nuna Yus nekawash? ¿Tura Yus nayaimpinam puja nuka nu aintsu turamurinka nekawash? tinawai.","poem":1},{"lineBreak":true},{"text":"Ni inintramuri tu awai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nu pasé aints ainau jiij pujurtaram.","poem":1},{"lineBreak":true},{"text":"Pachitsuk ni kuikiarin yujinawai tinawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tu tinau wainiatnak,","poem":1},{"lineBreak":true},{"text":"wikia nangkamnak nintir tunaarinchau ati tusan wakerukmajai.","poem":1},{"lineBreak":true},{"text":"Turasha nangkamnak tunau takatsuk pujustaj timiajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Turayatnak pachitsuk kintajai metek wait wajajai,","poem":1},{"lineBreak":true},{"text":"tura kashincha kashincha wina katsumrinawai,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujumjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Antsu tu chichaaknaka Yusen umirkaru ainaun pasé nintimtiknuyajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¿Timiá tunau ainayat warukaya timiá yuumatskesha pujuinawa? tusan nuna tenapkesan nintimratatkaman pengké yumtin nintimsan pujuyajai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Antsu nuniangka Yuse jeen wayaan,","poem":1},{"lineBreak":true},{"text":"Yusen nintimran iniakun:","poem":1},{"lineBreak":true},{"text":"¿Nu pasé aints ainauka tuni pujusartinui? tu iniam,","poem":1},{"lineBreak":true},{"text":"Yus winaka nekamtikruamiayi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nu aints ainauka iyaatnak wajainawai,","poem":1},{"lineBreak":true},{"text":"tura mengkaatanak wajainawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nuka aneachmau mengkaakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Turasha sapijjai amukartin ainawai turutmiayi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Apuru ame aints shintarua nunismek nu pasé aints ainauka amuktinuitme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wikia pasé aints ainau pujutrin wainkan,","poem":1},{"lineBreak":true},{"text":"tangku nintinchawa nunisnak katsurman nintimsan pujuyajai.","poem":1},{"lineBreak":true},{"text":"Turamtai nintir najamnuyayi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Turayatnak tuke amijai pujuyajai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai tunaanum ayaaraim tusam,","poem":1},{"lineBreak":true},{"text":"untsur uwejrun achirkamiame.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wina chichamur umirtukta tusam,","poem":1},{"lineBreak":true},{"text":"chichamem akupturkamiame.","poem":1},{"lineBreak":true},{"text":"Tura wi jakamtaikia,","poem":1},{"lineBreak":true},{"text":"wina pengker awajtusam juruktinuitme.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¿Warukanak nayaimpinam winitnasha wakeraja? Nayaimpinam wininka aminak wainkatasan wakerajme.","poem":1},{"lineBreak":true},{"text":"Amijai pujaknaka ju nungkanam ainia nunaka pengké wakerukchatnuitjai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wina pujutruka amukatnuitai.","poem":1},{"lineBreak":true},{"text":"Antsu tuke Yusnum pujustin asamtai,","poem":1},{"lineBreak":true},{"text":"Yus wina nintirun kakamtikrurtinuitai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aints Yusen nintimtsuk pujuinauka tuke mengkakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai niin umirtsuk pujuinaunka Yus amuktinuitai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Antsu wikia tuke Yusen nintimsan pujusminuitjai.","poem":1},{"lineBreak":true},{"text":"Kame tu pujaknaka timiá pengker pujustinuitjai.","poem":1},{"lineBreak":true},{"text":"Apuru wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"wina ejarkatnumka ametme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin ame turamurmin wikia aints ainaun mash nekamtikiatnuitjai tajame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":26}