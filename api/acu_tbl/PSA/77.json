{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":77,"content":[{"type":"heading","content":["Yus wina anturtukat tusan kakarman untsuajai"]},{"type":"verse","number":1,"content":[{"text":"Yus wina anturtukat tusan kakarman untsuajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsawai wake mesekan pujakun,","poem":1},{"lineBreak":true},{"text":"Apurun seajai.","poem":1},{"lineBreak":true},{"text":"Tura kashisha tuke inaitsuk uwejrun takuin,","poem":1},{"lineBreak":true},{"text":"Yusnasha seajai.","poem":1},{"lineBreak":true},{"text":"Turayatun tuke napchau nintimsan pujajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wikia Yusen nintimsan pujakun juutjai.","poem":1},{"lineBreak":true},{"text":"Turasha nukap nintimsan pujaknaka katsurman nekapeajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apuru ameka kanurta tusamka tsangkamrukchamame.","poem":1},{"lineBreak":true},{"text":"Timiá wake mesekan pujau asan chichakchamin nekapeajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turayatun yaanchuik pujuyaja nuna nintimsan pujajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Turasha kashi kantamnuyaja nunasha aneakjai.","poem":1},{"lineBreak":true},{"text":"Tura nintirjai nintimsan ininmamkun:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Apurka iinka tuke kajertamkatatjik?","poem":1},{"lineBreak":true},{"text":"¿Tura iinka ataksha pengkerka awajtamkashtatjik?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¿Turasha ni anengkratairingkia amukamkia?","poem":1},{"lineBreak":true},{"text":"¿Turasha Yus yaanchuik wi turatatjai tímia nunaka tuke umitsuk pujustatuak?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Turasha Yuska ni pengkerinka kajinmarmakia?","poem":1},{"lineBreak":true},{"text":"¿Turasha iincha timiá kajertamkau asa,","poem":1},{"lineBreak":true},{"text":"wait anentramtsuk pujustatuak? tu nintimsan pujajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yus nayaimpinam puja nuka yamaikia iijaingkia pujatsui,","poem":1},{"lineBreak":true},{"text":"tu nintimsan pujakun nintir najamrutawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Antsu ii Apuri yaanchuik pengké wainchatin turinuya nunaka aneartatjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Turasha ni turinamurin mash nintimratatjai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yusru ami turamuram nekasar pengker ainawai.","poem":1},{"lineBreak":true},{"text":"Amijai metek Yuska pengké atsawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amek Yus asam,","poem":1},{"lineBreak":true},{"text":"wainchati takat untsuri turinuyame.","poem":1},{"lineBreak":true},{"text":"Tura mash nungkanmaya ainau ami kakarmaram nekamtiknuyame.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tura ami kakarmarmijai ami aintsrum ainau angkanmamtiknuyame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yusru ame nase akupkam,","poem":1},{"lineBreak":true},{"text":"juun entsaka akankamiame.","poem":1},{"lineBreak":true},{"text":"Tura asakmin entsa timiá kuna ayat kukar wajasmiayi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tura mukuntiuka yumin jitumtikramiayi.","poem":1},{"lineBreak":true},{"text":"Turasha nayaimpinam ipiamat untsuri chichaarmiayi.","poem":1},{"lineBreak":true},{"text":"Turasha chaarim untsuri ayaararmiayi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tura katurang winamtai,","poem":1},{"lineBreak":true},{"text":"ipiamtancha antukarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura chaarim ayainamtai,","poem":1},{"lineBreak":true},{"text":"nungka jiitsumir wajakmiayi.","poem":1},{"lineBreak":true},{"text":"Tura uu uurmatai,","poem":1},{"lineBreak":true},{"text":"nungkaka muchikmiayi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yusru juun entsanam ame kukarak katingtaj tusam,","poem":1},{"lineBreak":true},{"text":"entsaka akankamiame.","poem":1},{"lineBreak":true},{"text":"Antsu ami nawemjai najamamunka wainkacharmiayi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Uwija wainin ni uwijarin ayas wekaamtikua nunismek ami aintsrum ainau wekaamtiksarti tusam,","poem":1},{"lineBreak":true},{"text":"Moisés tura Aarónsha inarmiame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":20}