{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":79,"content":[{"type":"heading","content":["Jerusalénka yumpungkaramtai wake mesekmauri"]},{"type":"verse","number":1,"content":[{"text":"Yusru amin umirtamchau ainau Jerusalén yaktanam kaunkarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura ami jeemnasha pasemamtikrarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura ami yaktarmin yumpungkarmiayi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura ami inatiram ainaun chiwiang ainau yuwaarat tusar,","poem":1},{"lineBreak":true},{"text":"tura pachim ainausha yuwaarat tusar, kajengkar iwiartsuk ukukiarmiayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura aintsu numpe yumi ukaawa nunisarang Jerusalénnum ukararmiayi.","poem":1},{"lineBreak":true},{"text":"Tura ni iwiaratniurisha atsuarmiayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tura asaramtai chikich aints ainau iincha tentatmakar pujusar wishikraminaji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru ¿warutik suwirumsha inaisatam? ¿Ami suwirumka ji kapaawa nunisang tuke atatuak?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amin umirtamchau ainauka aminka nekarminatsui.","poem":1},{"lineBreak":true},{"text":"Tura amincha seatmichu ainawai.","poem":1},{"lineBreak":true},{"text":"Nu aints ainauka Jacobo weari ainaun amukarmiayi.","poem":1},{"lineBreak":true},{"text":"Tura ii yaktarin mesraru asaramtai,","poem":1},{"lineBreak":true},{"text":"nu aints ainamunam ami suwirum akupkata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii juuntri yaanchuik pasé pujusarmaunum iinka wait wajaktinka sukartusaip.","poem":1},{"lineBreak":true},{"text":"Antsu iikia timiá wake mesekar pujuinau asakrin,","poem":1},{"lineBreak":true},{"text":"ami wait anengkratairum akupkartukta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusru iin uwemtikratkatin asam yaimkartukta.","poem":1},{"lineBreak":true},{"text":"Turasha angkanmamtikiartukta.","poem":1},{"lineBreak":true},{"text":"Turasha ii tunaaringkia tsangkukratkata.","poem":1},{"lineBreak":true},{"text":"Ame pengker asakmin,","poem":1},{"lineBreak":true},{"text":"ami naarmin pachisan seajme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amin umirtamchau ainau wishikrinak:","poem":1},{"lineBreak":true},{"text":"¿Atumi Yusri tuwaita? turutiarai tusam yaimkartukta.","poem":1},{"lineBreak":true},{"text":"Ami inatiram ainau jakarmaurin ame yapaijkumin,","poem":1},{"lineBreak":true},{"text":"iisha nu wainkatasar wakeraji.","poem":1},{"lineBreak":true},{"text":"Tura amin umirtamchau ainausha Yus aitkarmaji tusar niisha nekaawarti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tura achikmau ainau juutinamurisha amesha antukta.","poem":1},{"lineBreak":true},{"text":"Tura achikmau ainaun:","poem":1},{"lineBreak":true},{"text":"Atumsha jakatatrume tinau wainiatmek nu aints ainausha ami kakarmarmijai angkanmamtikiata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apuru aints amin pasé awajtamkarmia nu nukap yapaijkiata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ame turakminkia,","poem":1},{"lineBreak":true},{"text":"iikia ami aintsrum asar,","poem":1},{"lineBreak":true},{"text":"tuke inaitsuk ameka maaketai titatji.","poem":1},{"lineBreak":true},{"text":"Tura ame warartakur kanta kantamatatji.","poem":1},{"lineBreak":true},{"text":"Tura ii uchiri ainausha tura ii tirangki ainausha tura nuna uchiri ainausha nunisarang tuke turuwartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":12}