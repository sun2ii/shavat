{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":8,"content":[{"type":"heading","content":["Yuse kakarmari pachisar kantamruami"]},{"type":"verse","number":1,"content":[{"text":"Apuru iinu Yusri asam,","poem":1},{"lineBreak":true},{"text":"mash ainia nu inawaitme.","poem":1},{"lineBreak":true},{"text":"Nayaimpinam ame najanamu ainauka mash shiiram asaramtai,","poem":1},{"lineBreak":true},{"text":"wikia ami naarmin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tajame.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ami nemasem ainau amin nakitraminak yapaijkiami tinu ainau itatmamtikiatasam,","poem":1},{"lineBreak":true},{"text":"uchi kuwirach ainausha amin nekasar pengker awajtamsartas maaketai turutiarti tusam tsangkatu weame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wikia nayaimpin ame najanamu ainaun jiisan,","poem":1},{"lineBreak":true},{"text":"nantuncha tura yaancha nuni ketinau jiisan amijai chichaakun:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aintsti mianchau arincha,","poem":1},{"lineBreak":true},{"text":"¿waruka timiá anengkratme? Aintsti jakatin arincha,","poem":1},{"lineBreak":true},{"text":"¿waruka timiatcha nintimturkartusmesha pujame?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aints ainautikia yamaik jakatin asakrin,","poem":1},{"lineBreak":true},{"text":"antsu ame awemamurmeka jakashtin asaramtai,","poem":1},{"lineBreak":true},{"text":"aintstin nangkamasmek pengker najanamiame.","poem":1},{"lineBreak":true},{"text":"Turayatum aintstinka amea tumau najakratau asam,","poem":1},{"lineBreak":true},{"text":"timiá pengker awajkartusmiame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura mash najanamuram ainaun aints ainauti inararti tusam tsangkamkamiame.","poem":1},{"lineBreak":true},{"text":"Tura mash najanamuram ainau aintsti ainautin umirkarmi tusam najanamiame.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uwija ainau tura waaka ainausha tura pachim ainausha,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"tura nanamtin yakí nanamin ainausha tura namak ainausha tura juun entsanmaya ainausha mash aints ainau inararti tusam tsangkamkamiame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru iinu Yusri asam,","poem":1},{"lineBreak":true},{"text":"mash ainia nu inawaitme.","poem":1},{"lineBreak":true},{"text":"Tura asakmin ami naarmin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tajame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}