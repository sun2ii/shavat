{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":81,"content":[{"type":"heading","content":["Yuska iin kakamtikramratnuitji tusaram warasrum kantamataram"]},{"type":"verse","number":1,"content":[{"text":"Yuska iin kakamtikramratnuitji tusaram,","poem":1},{"lineBreak":true},{"text":"warasrum kantamataram.","poem":1},{"lineBreak":true},{"text":"Tura Jacobo Yusri warartakrum kakarum chichaktaram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura tampurjai tura kitarrjai tura arpajaisha tuntuikiamaikiakrum kanta kantamataram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura nantu takaamtai pupun pupuntruataram.","poem":1},{"lineBreak":true},{"text":"Nuniasha nantu pamau yuwamtaisha,","poem":1},{"lineBreak":true},{"text":"ii fiestari kinta asamtai,","poem":1},{"lineBreak":true},{"text":"pupun pupuntruataram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ii Yusri ni aintsri ainautin nu chichamka umiktaram tusa akupturmakmiaji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura Yus Ejiptonmaya ainaun nepetkatas nu chichamnaka Josén akuptukmiayi.","poem":1},{"lineBreak":true},{"text":"Nunia wi antushtain chichaman antukmiaja nu nuwaitai:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Atum meram entsakua nunisrumek pujarmin,","poem":1},{"lineBreak":true},{"text":"takatrum uyumtin amia nunia angkan awajsamiajrume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Atumka wait wajakrum pujau asaram,","poem":1},{"lineBreak":true},{"text":"wina untsurkamiarme.","poem":1},{"lineBreak":true},{"text":"Nu turakrumin wikia uwemtikramiajrume.","poem":1},{"lineBreak":true},{"text":"Tura mukuntiunmaya ipiamat chichamia nunian wikia aikmiajrume.","poem":1},{"lineBreak":true},{"text":"Tura juun entsa kaanmatkarin Meriba tutainum atumnasha nekapsamiajrume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wina aintsur ainautiram anturtuktaram.","poem":1},{"lineBreak":true},{"text":"Wikia atumin chicharkatatjarme.","poem":1},{"lineBreak":true},{"text":"Israel ainautiram,","poem":1},{"lineBreak":true},{"text":"wina anturtuktaram tusan wakerajrume.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chikich nungkanmaya aints ainau yusringkia seairap.","poem":1},{"lineBreak":true},{"text":"Turasha chikich nungkanmaya aints ainau yusrin seatasrum tsuntsumruwairap.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wiitjai atumi Apuri.","poem":1},{"lineBreak":true},{"text":"Wiitjai atumi Yusri.","poem":1},{"lineBreak":true},{"text":"Wiki atumniaka Ejipto nungkanmaya jiikmiajrume.","poem":1},{"lineBreak":true},{"text":"Tura asamtai yamaikia atumi jangke awaartaram.","poem":1},{"lineBreak":true},{"text":"Turakrumin wi atumin yuratatjarme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wi tamaitiat wina aintsur ainau wina chichamrun antutnasha tura umirtutnasha nakitrarmiayi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuminau asaramtai tuuksha pujusarti tusan inaisamiajai.","poem":1},{"lineBreak":true},{"text":"Wi turam ni wakeramurin pujusarmiayi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wina aintsur ainau wina anturtukaruitmatikia,","poem":1},{"lineBreak":true},{"text":"aints mitsum mitsum wajawa nutiksanak ni nemase ainaunka mengkatkartinuyajai.","poem":1},{"lineBreak":true},{"text":"Tura Israela weari ainau wina jintarun amakaruitmatikia,","poem":1},{"lineBreak":true},{"text":"ni nemase ainaunka wait wajaktintrin susartinuyajai”,","poem":1},{"lineBreak":true},{"text":"Yus timiayi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ii Yus umirkawaitkurningkia,","poem":1},{"lineBreak":true},{"text":"ii Apurin nakitina nuka","poem":1},{"lineBreak":true},{"text":"shamraminak ayaararmin ainawai.","poem":1},{"lineBreak":true},{"text":"Turasha tuke mengkaakarmin ainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ii Yusri anturkamuitkungka,","poem":1},{"lineBreak":true},{"text":"ni aintsri ainautinka yuta nekas pengker aa nuna yurtamamnauyaji.","poem":1},{"lineBreak":true},{"text":"Tura kitaknasha mikturmamnauyaji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":15}