{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":84,"content":[{"type":"heading","content":["Yuse jeen pujustasan wakerajai"]},{"type":"verse","number":1,"content":[{"text":"¡Apuru ameketme kakarmam! Ami pujutirmeka nekas shiirmaitai tajame.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wikia ami jeemin tenukap pujustasan wakerajai.","poem":1},{"lineBreak":true},{"text":"Ame pujut sukartame nuna pachisan tuke nintirjai warasan kantamjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru ameketme kakarmam.","poem":1},{"lineBreak":true},{"text":"Tura wina Apur asam,","poem":1},{"lineBreak":true},{"text":"tura wina Yusur asakmin tajame:","poem":1},{"lineBreak":true},{"text":"Suwich tura shuwirpip ainau ami jeemin engkemawar pengker nintimsar pasungminawai.","poem":1},{"lineBreak":true},{"text":"Tura ni uchichirin pengker nintimsar tsakatminawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ami jeemin pujuinauka tuke inaitamtsuk amincha:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tusar nekasar warasartin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Turasha aints aminian ni kakarmarin juwina nuka nekasar warasartin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura tuke nintijai:","poem":1},{"lineBreak":true},{"text":"Wisha Yuse jintin wekaasatasan wakerajai tinu asar,","poem":1},{"lineBreak":true},{"text":"nekasar warasartin ainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aints ainau yumi jitachmatai,","poem":1},{"lineBreak":true},{"text":"ni arakri mash kaar mengkainamtai,","poem":1},{"lineBreak":true},{"text":"juutu pujuinawai.","poem":1},{"lineBreak":true},{"text":"Antsu yumi jitamtaikia,","poem":1},{"lineBreak":true},{"text":"nuniangka warainawai.","poem":1},{"lineBreak":true},{"text":"Amin umirtaminak pujuinausha juutu pujuinayat,","poem":1},{"lineBreak":true},{"text":"aminak nintimsar ataksha warasartin ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tura ami kakarmarmijai tuke kakartin ainawai.","poem":1},{"lineBreak":true},{"text":"Turasha mura Sión tutainum jear,","poem":1},{"lineBreak":true},{"text":"amincha waitmakartin ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru ameketme kakarmam.","poem":1},{"lineBreak":true},{"text":"Jacobo Yusriya,","poem":1},{"lineBreak":true},{"text":"wi seamur anturtukta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusru iin ejakratin asam,","poem":1},{"lineBreak":true},{"text":"ami aintsrumi apuri ati tusam,","poem":1},{"lineBreak":true},{"text":"aints inaikiamiame nu pengker nintimsam wainkata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kichik kintak ami jeemin wayaar nuni pujustinka timiá pengkeraitai.","poem":1},{"lineBreak":true},{"text":"Antsu warang kintasha ami jeemin waaitsuk pujustinka paseetai.","poem":1},{"lineBreak":true},{"text":"Yus ii Apuri asa,","poem":1},{"lineBreak":true},{"text":"iincha paan nintimtikramji,","poem":1},{"lineBreak":true},{"text":"turasha iincha ejarmaji.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wikia aminu jeemin wainin atasan timiá wakerajai.","poem":1},{"lineBreak":true},{"text":"Antsu pasé aints ainaujai tsaniasan pujutnaka nakitajai.","poem":1},{"lineBreak":true},{"text":"Ii Apuri timiatrusrik umirmaka iincha anenmaji turasha warartamji.","poem":1},{"lineBreak":true},{"text":"Turasha pengker aa nunaka kichkisha suritramtsuji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apuru ameketme kakarmam.","poem":1},{"lineBreak":true},{"text":"Tura asakmin aints ainau amin nintimturmasar pujuinauka nekasar warasartin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":11}