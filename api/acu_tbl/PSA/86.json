{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":86,"content":[{"type":"heading","content":["David Yusen: Wait anentrurta tusa seamuri"]},{"type":"verse","number":1,"content":[{"text":"Apuru wikia wait wajakun yuumakun pujau asamtai,","poem":1},{"lineBreak":true},{"text":"wait aneasam anturtukta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura amin nintimtakun pujau asamtai,","poem":1},{"lineBreak":true},{"text":"wina yainkata.","poem":1},{"lineBreak":true},{"text":"Ameka wina Yusruitme.","poem":1},{"lineBreak":true},{"text":"Wikia aminu inatiram asan,","poem":1},{"lineBreak":true},{"text":"amin nintimtajme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai uwemtikrurta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuru kintajai metek seajme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai wait anentrurta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yusru aminu inatiram asan,","poem":1},{"lineBreak":true},{"text":"amin tuke seajme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai nintir waramtikrusta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru ame nekas pengker asam,","poem":1},{"lineBreak":true},{"text":"aintsu tunaari tsangkuratnuitme.","poem":1},{"lineBreak":true},{"text":"Tura amin seatmin ainauka pengker awajsatnuitme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yusru wi seamur anturtukta,","poem":1},{"lineBreak":true},{"text":"tura anturtukam nekartuata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi napchau nintimsan amin untsuam anturtuktinuitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru amijai metekka Yuska atsawai.","poem":1},{"lineBreak":true},{"text":"Tura aminu turamurmijai metekka kichkisha atsawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apuru mash nungkanmaya ainau najanamiame nuka amin jear:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam turamiartinuitai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amek Yus asam,","poem":1},{"lineBreak":true},{"text":"nekas juuntaitme.","poem":1},{"lineBreak":true},{"text":"Tura asam wainchati takatcha mash najanawaitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yusru jintim nekamtikruata.","poem":1},{"lineBreak":true},{"text":"Nu turakminka tuke nemarsatnuitjame.","poem":1},{"lineBreak":true},{"text":"Tura ami naarmin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam titin nintimtikrurta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apuru wina Yusur asakmin,","poem":1},{"lineBreak":true},{"text":"tuke wina nintirjai:","poem":1},{"lineBreak":true},{"text":"Ameketme pengkeram titatjame.","poem":1},{"lineBreak":true},{"text":"Tura ami naarmin pachisan:","poem":1},{"lineBreak":true},{"text":"Ameketme kakarmam tuke titatjame.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wina nukap anentruru asam,","poem":1},{"lineBreak":true},{"text":"mengkakatnunam we tusam uwemtikrurmiame.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yusru jampesarang pujuinauka aminka nintimtsuk pujuinau asar,","poem":1},{"lineBreak":true},{"text":"wina pasé awajtinak mantuwartas winitrinawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Antsu ameka Apuru nekasam Yus asam,","poem":1},{"lineBreak":true},{"text":"jaimiasam wait anengkratnuitme.","poem":1},{"lineBreak":true},{"text":"Tura asamtai anengkratairumka nangkankashtinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ami chichamim nekas aa nuka tuke nangkankashtinuitai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wina jiirsam wait anentrurta.","poem":1},{"lineBreak":true},{"text":"Turam kakarmaram surusta.","poem":1},{"lineBreak":true},{"text":"Wikia ami inatiram asamtai uwemtikrurta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ami pengkeerum inaktursata.","poem":1},{"lineBreak":true},{"text":"Tura wina pengker awajtakmin,","poem":1},{"lineBreak":true},{"text":"wina kajertin ainauka nuna wainkar natsaarartinuitai.","poem":1},{"lineBreak":true},{"text":"Apuru ameka wina yainkau asam,","poem":1},{"lineBreak":true},{"text":"wina pengker nintimtikrurmiame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}