{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":88,"content":[{"type":"heading","content":["Apuru ¿waruka winasha nakitrame?"]},{"type":"verse","number":1,"content":[{"text":"Apuru wina Yusur asam,","poem":1},{"lineBreak":true},{"text":"turasha wina uwemtikrurtin asakmin,","poem":1},{"lineBreak":true},{"text":"tsawaisha tura kashisha yainkata tusan seajme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tura wi seajme nu anturtukam airkata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wikia timiá pasé pujau asan,","poem":1},{"lineBreak":true},{"text":"jakamin nekapeajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wina kakarmar atsau asamtai,","poem":1},{"lineBreak":true},{"text":"wina pachitsar wári jakatatui tiarminuitai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wikia aints jakau iwiarsamunam ukusmawa tumawaitjai.","poem":1},{"lineBreak":true},{"text":"Tura aints maaniamunam maamua tumawaitjai.","poem":1},{"lineBreak":true},{"text":"Turasha aints amin ejamunka waintsuk kajinminawa tumawaitjai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura wikia waa jiitamranam tee amaunum ajuarmawa tumawaitjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ame kajekmaurum akupturkau asakmin,","poem":1},{"lineBreak":true},{"text":"aints entsa tampaaramunam ujungmawa tumawaitjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Turamtai wina amikur ainau ajapruwar ukukiarti tura tsuutrarti tusam aitkaramame.","poem":1},{"lineBreak":true},{"text":"Tura asan wikia aints kársernum engkeamua tumawaitjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tura timiá juutu asan,","poem":1},{"lineBreak":true},{"text":"wainmichua nunisketjai.","poem":1},{"lineBreak":true},{"text":"Apuru kintajai metek amincha uwejrun takuin seajme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¿Jakaru ainau wainchati takat wainmamtikiatmeash?","poem":1},{"lineBreak":true},{"text":"¿Tura jakaru ainau amin maaketai turaminawak?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Jakaru ainau iwiarsamunam ami nekas chichammin pachisar,","poem":1},{"lineBreak":true},{"text":"tura ami anengkratairumin pachisar chichainawak?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Tura jakaru ainamunam aints kichkisha ami pengker turamurmin tura ami wainchati takatrumin nintiminawak?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antsu wikia Apuru amin seajme.","poem":1},{"lineBreak":true},{"text":"Kashik amincha wina seamurnaka antumtikiajme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apuru ¿waruka winasha nakitrame?","poem":1},{"lineBreak":true},{"text":"¿Waruka winasha anumrutme?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wikia natsa akunka wait wajayajai,","poem":1},{"lineBreak":true},{"text":"tura jatancha wakerin ayajai.","poem":1},{"lineBreak":true},{"text":"Tura ame wina itiurkachmin akupturkumnisha atsannuyajai.","poem":1},{"lineBreak":true},{"text":"Turayatun yamaikia atsantrachmin nekapeajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ami suwirum winaka nepetuki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tura asamtai aints nujang nujangkruamunam japen wajawa tumawaitjai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wina amikur ainau tura wina irutkamur ainausha yajá akupkamu ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai wikia teenam pujuinawa nunisketjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":18}