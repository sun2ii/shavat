{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":90,"content":[{"type":"heading","content":["Moisés: Yuska tuke pujayayi, antsu aintska jumchik musach pujustinuitai timiauri"]},{"type":"verse","number":1,"content":[{"text":"Apuru ameka tuke iin ejakratin ayame.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ameka mash najanchayatmek,","poem":1},{"lineBreak":true},{"text":"tura murasha mash najanchayatmek,","poem":1},{"lineBreak":true},{"text":"Yus asam tuke pujayame,","poem":1},{"lineBreak":true},{"text":"tura tuke pujustinuitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ame aintsti pachisam chichaakum:","poem":1},{"lineBreak":true},{"text":"Ataksha nungka ati takumningkia,","poem":1},{"lineBreak":true},{"text":"ataksha nungka wajastinuitji.","poem":1},{"lineBreak":true},{"text":"Ameka mil (1,000) musach wainiatum,","poem":1},{"lineBreak":true},{"text":"kinta yaau nangkamarua tumau nintime.","poem":1},{"lineBreak":true},{"text":"Tura mil (1,000) musach wainiatum,","poem":1},{"lineBreak":true},{"text":"jumchik hora tumau wári nangkamartin ainawai,","poem":1},{"lineBreak":true},{"text":"tu nintime.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nujang aintsun jakatniunam juwawa nunisrik aji.","poem":1},{"lineBreak":true},{"text":"Tura ii karanam nintimu weaji nunisrik mengkakatin ainiaji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura nupaaya nunisrik ainiaji.","poem":1},{"lineBreak":true},{"text":"Nupaa tsapai kashik yangkurui.","poem":1},{"lineBreak":true},{"text":"Turayat kiaraikia jajatar kakarmachu minayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ami suwirumjai aints ainautinka amukratme.","poem":1},{"lineBreak":true},{"text":"Tura kajekakminkia,","poem":1},{"lineBreak":true},{"text":"napchau nintimsar pujaji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ii tunaaringkia tura ii pasé nintimtairisha ameka paan nekame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ame kajekakminkia,","poem":1},{"lineBreak":true},{"text":"ii iwiaakmauringkia aints mayairawa nunisang wári nangkaankatnuitai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iikia setenta (70) musach pujusminuitji.","poem":1},{"lineBreak":true},{"text":"Tura kakaram akurkia ochenta (80) musach pujusminuitji.","poem":1},{"lineBreak":true},{"text":"Ii musachri wári nangkamartin asaramtai,","poem":1},{"lineBreak":true},{"text":"wári jakatnuitji.","poem":1},{"lineBreak":true},{"text":"Antsu sungkurjai wait wajayatrik,","poem":1},{"lineBreak":true},{"text":"tura najaimiayatrik jampesrik:","poem":1},{"lineBreak":true},{"text":"Miajuitjai taji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yusru ¿ame suwirumnasha yáki neka?","poem":1},{"lineBreak":true},{"text":"¿Tura ame kajekmaurumnasha yáki neka?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apuru jumchik musach iwiaaku pujarme tusam nintimtikiartukta.","poem":1},{"lineBreak":true},{"text":"Nu turakmin nekasar paan nintimratnuitji.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apuru yaimkartukta,","poem":1},{"lineBreak":true},{"text":"tura suwirum inaisata.","poem":1},{"lineBreak":true},{"text":"Iikia aminu inatiram asakrin,","poem":1},{"lineBreak":true},{"text":"ame wait anengkratairum nekamtikiartukta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ame anengkratairum kashik ii nintin piaku ati tusam wakeruku ata.","poem":1},{"lineBreak":true},{"text":"Turakmin iisha tuke warasar kantamatatji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Iikia untsuri musach wait wajayaji nuna nangkamasmek untsuri musach warastaram tusam sukartusta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Iikia ami inatiram asar,","poem":1},{"lineBreak":true},{"text":"ami kakarmaram wainkatasar wakeraji.","poem":1},{"lineBreak":true},{"text":"Tura ii wearisha ame pengkeerumin wainkarti tusam nintimtikrarta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apuru ii Yusri asam,","poem":1},{"lineBreak":true},{"text":"ame pengkeerum sukartusta.","poem":1},{"lineBreak":true},{"text":"Tura ii takatrin takakmakur pujakrincha,","poem":1},{"lineBreak":true},{"text":"nekasam pengker awajkartusta tusan seajme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":16}