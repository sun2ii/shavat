{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":91,"content":[{"type":"heading","content":["Ii Apuri iin ejarmaktinuitji"]},{"type":"verse","number":1,"content":[{"text":"Aints Yus wina ejarkati tusa,","poem":1},{"lineBreak":true},{"text":"Yusen nekas juuntan tura nekas kakarman seatas wakerakka tu seatnuitai:","poem":1},{"lineBreak":true},{"text":"“Ameketme wina ayamrutkatnumka,","poem":1},{"lineBreak":true},{"text":"tura wina ejarkatnumka.","poem":1},{"lineBreak":true},{"text":"Tura wina Yusur asakmin,","poem":1},{"lineBreak":true},{"text":"wikia amin nintimtusan pujajme”.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yusek ningki amin ayamrutmaktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura sungkur ainamunmasha ningki amin tsuwarmartinuitai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atash ni uchichirin nanapejai tektuk pujawa nunisang waitmaktinuitai.","poem":1},{"lineBreak":true},{"text":"Tura ni wait anengkratairi tantaara tumau asamtai,","poem":1},{"lineBreak":true},{"text":"nekasam wina ejarkatnuitme tusam, pengker nintimsam pujustinuitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tura kashisha mantuwarai tusam,","poem":1},{"lineBreak":true},{"text":"tura tsawaisha tsentsak wina tukuri tusam,","poem":1},{"lineBreak":true},{"text":"shamtsuk pujustinuitme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tura teetisha iwianch achirkai tusam,","poem":1},{"lineBreak":true},{"text":"tura tsawai sungkur achirkai tusam,","poem":1},{"lineBreak":true},{"text":"nuka nintimtsuk shamtsuk pujustinuitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ame menarminini untsuri aints sungkurjai jainau wainiatmek,","poem":1},{"lineBreak":true},{"text":"tura ami untsurminini untsuri aintsun maainau wainiatmek,","poem":1},{"lineBreak":true},{"text":"ameka jakashtinuitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yus pasé ainaun wait wajaktiniun susatnuitai,","poem":1},{"lineBreak":true},{"text":"antsu ameka waitka wajakchatnuitme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yus nayaimpinam puja nuka wina ejarkatnuitai tusam,","poem":1},{"lineBreak":true},{"text":"tura wina ayamrutkatnuitai tau asam,","poem":1},{"lineBreak":true},{"text":"pasé aa nuka wainkashtinuitme,","poem":1},{"lineBreak":true},{"text":"turasha sungkursha jeemningkia utuashtinuitai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ame tuni wekaame nunisha Yus ni awemamuri irunun amin waitmakarat tusa inatmartatui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tura nawemin kayan tukumkai tusar,","poem":1},{"lineBreak":true},{"text":"ni uwejejai achirmakartatui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tura asamtai juun yawaa tura napisha tura titingsha tura pachim ainamunmasha wekaasatnuitme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yus chichaak:","poem":1},{"lineBreak":true},{"text":"“Aints wina anentinak:","poem":1},{"lineBreak":true},{"text":"Ameketme Apum turutinaunka wikia uwemtikratnuitjai,","poem":1},{"lineBreak":true},{"text":"turan ayamruktinuitjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tura wina yainkata turutinamtaikia,","poem":1},{"lineBreak":true},{"text":"wikia yaingtinuitjai,","poem":1},{"lineBreak":true},{"text":"tura nijai tsaniasan pujustinuitjai.","poem":1},{"lineBreak":true},{"text":"Tura napchau nintimsar pujuinamtaikia angkanmamtikiatnuitjai.","poem":1},{"lineBreak":true},{"text":"Tura nu aintsnaka pachisan:","poem":1},{"lineBreak":true},{"text":"Nekas pengkeraitai titinuitjai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tura nukap musach pujusti tusan wainkatnuitjai,","poem":1},{"lineBreak":true},{"text":"tura pujut nangkankashtinun susatnuitjai”,","poem":1},{"lineBreak":true},{"text":"Yus tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":14}