ngkamasmek kakarmaitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apuru ame chicham akupamurmeka yapajiachmin ainawai.","poem":1},{"lineBreak":true},{"text":"Tura asaramtai aminu aintsrum ainauka ami jeemin wayaawar,","poem":1},{"lineBreak":true},{"text":"tuke tunaarinchau arti tusam wakerame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}