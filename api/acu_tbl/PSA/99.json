{"translation":{"id":"acu_tbl","name":"Achuar Peru: Yuse Chichame Aarmauri","website":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=acuNT","licenseNotes":null,"shortName":"TBL","englishName":"Achuar-shiwiar Bible","language":"acu","textDirection":"ltr","sha256":"3abbbde9e194902f383ab3118dbccc94d1a644de4d4cd8e7ff19cd3f5841d231","availableFormats":["json"],"listOfBooksApiLink":"/api/acu_tbl/books.json","numberOfBooks":59,"totalNumberOfChapters":478,"totalNumberOfVerses":11523,"languageName":"Achuar-Shiwiar","languageEnglishName":"Achuar-Shiwiar"},"book":{"id":"PSA","translationId":"acu_tbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":107,"sha256":"5d9e46a1de75143cb037f4c7e3ab33f99925bee0e50174f765b88869d3002045","firstChapterNumber":1,"firstChapterApiLink":"/api/acu_tbl/PSA/1.json","lastChapterNumber":147,"lastChapterApiLink":"/api/acu_tbl/PSA/147.json","totalNumberOfVerses":1501},"chapter":{"number":99,"content":[{"type":"heading","content":["Yuska pengké tunaarinchawaitai"]},{"type":"verse","number":1,"content":[{"text":"Ii Apuringkia mash nungkanmaya ainau inawai.","poem":1},{"lineBreak":true},{"text":"Ni keemtairingkia Yuse awemamuri yakinini puusamuitai.","poem":1},{"lineBreak":true},{"text":"Tura asamtai mash nungkanmaya ainau shaminak kurarartinuitai.","poem":1},{"lineBreak":true},{"text":"Tura nungka ainausha muchitkartinuitai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ii Apuri nekas juun aa nuka mura Sión tutainum pujuwitai.","poem":1},{"lineBreak":true},{"text":"Turasha mash nungkanmaya aints ainaun inawaitai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tura asamtai mash nungkanmaya aints ainau:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam tura ameketme timiá kakarmam tiarti.","poem":1},{"lineBreak":true},{"text":"¡Yuska pengké tunaarinchawaitai!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ame nekas kakaram inakratin asam,","poem":1},{"lineBreak":true},{"text":"aints ainausha mash metek iname.","poem":1},{"lineBreak":true},{"text":"Tura asam Jacobo weari ainau ni pengker turamurijai metek pengker awajnuyame.","poem":1},{"lineBreak":true},{"text":"Tura pasé aints ainausha ni pasé turamurijai metek wait wajaktin suyame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ii Apuri ii Yusri asamtai,","poem":1},{"lineBreak":true},{"text":"warartustasrum tikishmatrataram.","poem":1},{"lineBreak":true},{"text":"¡Yuska pengké tunaarinchawaitai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moisés tura Aarónsha Yuse chichame etserin armiayi.","poem":1},{"lineBreak":true},{"text":"Samuelsha chikich aints ainaujai Yuse naarin pachis:","poem":1},{"lineBreak":true},{"text":"Ameketme juuntam timiayi.","poem":1},{"lineBreak":true},{"text":"Tura Apuru yainkata tinamtai,","poem":1},{"lineBreak":true},{"text":"niisha anturak yainuyayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yus mukuntiunmaya niijai chichasmiayi.","poem":1},{"lineBreak":true},{"text":"Turamtai ni chicham akupkamuncha umirkarmiayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apuru ii Yusri asam,","poem":1},{"lineBreak":true},{"text":"ami chichammin etserin ainau amin seatminamtai anturnuyame.","poem":1},{"lineBreak":true},{"text":"Ame tsangkukratin asam,","poem":1},{"lineBreak":true},{"text":"ni tunaari ainausha tsangkurnuyame.","poem":1},{"lineBreak":true},{"text":"Antsu ami chichammin umirtan nakitin ainauka ni wait wajaktintrisha suyame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ii Apuri ii Yusri asamtai,","poem":1},{"lineBreak":true},{"text":"warartusrum ni murarin nekas pengker aa nuni wakaram maaketai titasrum tikishmatrataram.","poem":1},{"lineBreak":true},{"text":"¡Ii Yusri, ii Apuri aa nuka pengké tunaarinchawaitai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/acu_tbl/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/acu_tbl/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/acu_tbl/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}