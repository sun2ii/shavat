{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"2SA","translationId":"agr_wbt","name":"2 Samuel","commonName":"2 Samuel","title":"Samuel pachisa jimaja nunú agagbau 2 Samuel","order":10,"numberOfChapters":17,"sha256":"8cecfd27b34180c5f43dfac37ea23f95aafe5022b57ff2cbe3531e4278ac80b1","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/2SA/1.json","lastChapterNumber":23,"lastChapterApiLink":"/api/agr_wbt/2SA/23.json","totalNumberOfVerses":412},"chapter":{"number":22,"content":[{"type":"heading","content":["David nii depetmakbaujin pachis kantamamu"]},{"type":"verse","number":1,"content":["Saúl Davitan maatag tutai, Tuke Pujuu ayamjukui. Tuja tikich shiwag aidau maatag tiagtaishkam, Tuke Pujuu ayamjukbau asa Apajuín emematak juna aatus David kantamauwai."]},{"type":"verse","number":2,"content":["Nuniak aatus tiuwai:",{"text":"“Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme mina kuitamjaumek,","poem":1},{"lineBreak":true},{"text":"ametme mina ejamataigmek,","poem":1},{"lineBreak":true},{"text":"mina agkanmitkagnumek.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ametme mina Apajuígmek,","poem":1},{"lineBreak":true},{"text":"ametme kaya muunnum uumka ejamtayama imanmek,","poem":1},{"lineBreak":true},{"text":"ametme mina ejamaka uwemtaijuk.","poem":1},{"lineBreak":true},{"text":"Ametme senchimek, mina uwemtijinmek;","poem":1},{"lineBreak":true},{"text":"amek dekas shiig yakí,","poem":1},{"lineBreak":true},{"text":"mina uumka uwemtaijuitme.","poem":1},{"lineBreak":true},{"text":"Amek dekas shiig yakí mina ejamataijuitme,","poem":1},{"lineBreak":true},{"text":"ametme mina uwemtijin.","poem":1},{"lineBreak":true},{"text":"¡Aents magkagtin aidau mantuatag tuinakuish,","poem":1},{"lineBreak":true},{"text":"ame minak ayamjutkabiume!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwa, ametme pegkejam","poem":1},{"lineBreak":true},{"text":"ememattaimek,","poem":1},{"lineBreak":true},{"text":"wika amina emematjame,","poem":1},{"lineBreak":true},{"text":"mina shiwag mantuatag tuinakui","poem":1},{"lineBreak":true},{"text":"amina untsuagme,","poem":1},{"lineBreak":true},{"text":"tusa tai ame ayamjutme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Jamain ishamainnum jeganbaijai;","poem":1},{"lineBreak":true},{"text":"tuja magkagtin aidaunum pachiinkan,","poem":1},{"lineBreak":true},{"text":"mantuinawapi tusan senchi ishamkamiajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jamainnum egkemkamiajai.","poem":1},{"lineBreak":true},{"text":"¡Nunak shiwag aidau","poem":1},{"lineBreak":true},{"text":"maami tusag umigtukagmayi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuna ishamakun Tuke Pujuun segabiajai,","poem":1},{"lineBreak":true},{"text":"mina Apajuíjun yainkati tusan segabiajai,","poem":1},{"lineBreak":true},{"text":"tusa tai niina pujutaijin pujus antugtukmayi.","poem":1},{"lineBreak":true},{"text":"¡Wi untsubaunak nii antukmayi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Untsuka ai nugka senchi uugkabi,","poem":1},{"lineBreak":true},{"text":"muja aidaushkam buchitjabi,","poem":1},{"lineBreak":true},{"text":"nunak ¡Tuke Pujuu kajeka imatikabi!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuu nujinia bukuiti jiinmayi.","poem":1},{"lineBreak":true},{"text":"Tuja niina weninia jii keeka jiinmayi,","poem":1},{"lineBreak":true},{"text":"niina weninian jii kaiji kegaun nagkimayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayaimpik jáanchjai betek ichiinak nemaabi,","poem":1},{"lineBreak":true},{"text":"nuwiya akaikibi mina ayamjutkatatus.","poem":1},{"lineBreak":true},{"text":"¡Amek yujagkim ikiyamag","poem":1},{"lineBreak":true},{"text":"suwe wajasbaunum nuwi najamayume!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amek mina ayamjutkatasam,","poem":1},{"lineBreak":true},{"text":"ángel querubignum ekemis,","poem":1},{"lineBreak":true},{"text":"nii nanaakmatai minatai tumain,","poem":1},{"lineBreak":true},{"text":"dasenum pachitkau taabiume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yujagkim ikiyamag suwe ishamainnum,","poem":1},{"lineBreak":true},{"text":"amek pachitkau taabiume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amina senchijum","poem":1},{"lineBreak":true},{"text":"chaagpijai betek keeka jiinmayi,","poem":1},{"lineBreak":true},{"text":"nuniai jii kegau yumijai betek yutibi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imaniamunum Tuke Pujuu Apajuí múunta nunú,","poem":1},{"lineBreak":true},{"text":"chichamun ipamtajai betekan antukagmayi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Imatak akentaiji aidaun akenak","poem":1},{"lineBreak":true},{"text":"chaagpin ajuagmayi,","poem":1},{"lineBreak":true},{"text":"imatikak mina shiwag aidaunak,","poem":1},{"lineBreak":true},{"text":"uwakek ipisjabi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ame kajeka chichamin,","poem":1},{"lineBreak":true},{"text":"dase senchi dasentak,","poem":1},{"lineBreak":true},{"text":"nayantsa umpui buku emamtai,","poem":1},{"lineBreak":true},{"text":"nugka initke wantinkauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Apajuíyah,","poem":1},{"lineBreak":true},{"text":"ame minak nayaimpinum pujusam,","poem":1},{"lineBreak":true},{"text":"uwejum awentuntabiume,","poem":1},{"lineBreak":true},{"text":"dutikam nayantsa kunajinia","poem":1},{"lineBreak":true},{"text":"jiikim uwemtijugmayume.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mina shiwag aidau,","poem":1},{"lineBreak":true},{"text":"mina nagkaetasu senchigtin","poem":1},{"lineBreak":true},{"text":"aidau kajegtiagmayi.","poem":1},{"lineBreak":true},{"text":"Tujash ame ayamjutkabiume.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wi waitiakun pujai jetetkajabi,","poem":1},{"lineBreak":true},{"text":"tujash Tuke Pujuuwa, ame minak ayamjutkauwaitme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amek mina anentu asam,","poem":1},{"lineBreak":true},{"text":"uwemtijujam agkanmitkajuauwaitme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"wika ame wakegamun takau asamtai,","poem":1},{"lineBreak":true},{"text":"ame minak pegkegnum akigkabiume.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wika Tuke Pujuu tujutbaunak betek umikuitjai,","poem":1},{"lineBreak":true},{"text":"nii tujutbaun umitskek idaisachuitjai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wika niina chichame umiktina nunak,","poem":1},{"lineBreak":true},{"text":"ashí betek aneakjai,","poem":1},{"lineBreak":true},{"text":"nuadui ¡niina chichame umiktina nunak","poem":1},{"lineBreak":true},{"text":"makichkish umitskek idaisachuitjai!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wika ame diismash","poem":1},{"lineBreak":true},{"text":"pegkegchaunak takamsachuitjai,","poem":1},{"lineBreak":true},{"text":"tuja tudau aina nunak tupanjauwaitjai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuke Pujuu emtin","poem":1},{"lineBreak":true},{"text":"pegkegchaun takaschau asamtai,","poem":1},{"lineBreak":true},{"text":"nii minak pegkegnum yainkauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina betek umigtamainakuig,","poem":1},{"lineBreak":true},{"text":"ameshkam betek uminaitme.","poem":1},{"lineBreak":true},{"text":"Ya amina chichamjumin betek umiawa,","poem":1},{"lineBreak":true},{"text":"nunú amek shiig kuitamnaitme.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aents dekaskenum chichau aina duka,","poem":1},{"lineBreak":true},{"text":"ameshkam dutiksamek kuitamnaitme.","poem":1},{"lineBreak":true},{"text":"Untsu aents waitjin aina duka ameshkam dutiksamek iikuame.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Amek aents ememachu aidau uwemtiknaitme,","poem":1},{"lineBreak":true},{"text":"untsu ememau aina duka","poem":1},{"lineBreak":true},{"text":"wainka dushiktai emame.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme mina tsaaptinug,","poem":1},{"lineBreak":true},{"text":"mina Apajuíjuh, ametme wi suwenum wekagaish","poem":1},{"lineBreak":true},{"text":"tsaaptin etugtaumek.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ame yaintsamin,","poem":1},{"lineBreak":true},{"text":"mina shiwag aina nujaig maaniattajai,","poem":1},{"lineBreak":true},{"text":"nunikan depetkan amuktatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Apajuíyah, ame dutikamu","poem":1},{"lineBreak":true},{"text":"aina duka ashí pegkejai.","poem":1},{"lineBreak":true},{"text":"Ame anagkagtuamua nunak dekaskeapi tajai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk ya niyai","poem":1},{"lineBreak":true},{"text":"dekaskeapi tuinawa nuna kuitamui.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ima ameketme Apajuímek.","poem":1},{"lineBreak":true},{"text":"Ame kuitamkagtinaitam","poem":1},{"lineBreak":true},{"text":"imanuk tikichik atsawai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Apajuíyai senchigtin mina kuitamjinuk,","poem":1},{"lineBreak":true},{"text":"nii minak pujutji pegkeg ati tusa jintinjinai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Apajuí minak shiwag amaigkai tusa,","poem":1},{"lineBreak":true},{"text":"japa amaimainchau tupikaina iman etawai.","poem":1},{"lineBreak":true},{"text":"Wi shiwag amaintukai tusan,","poem":1},{"lineBreak":true},{"text":"muja titijin wakamtaish, ame minak kuitamjinaitme.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ame minak shiwagjai maanitash jintinjame,","poem":1},{"lineBreak":true},{"text":"ametme flecha ekenka","poem":1},{"lineBreak":true},{"text":"nagkimtai jiju bronce najanamun,","poem":1},{"lineBreak":true},{"text":"japiki nagkimati tusam senchimtijaumek.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ametme shiwag aidau jetetuinakuish","poem":1},{"lineBreak":true},{"text":"uwemtijinmek, ame yaintu asamin,","poem":1},{"lineBreak":true},{"text":"tikich aidaush eme anenjuinawai.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ame wi wekaebaunmak kuitamjame,","poem":1},{"lineBreak":true},{"text":"nuadui atakuinjanush iyagchabiajai.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Mina shiwag aidaun pataetukan","poem":1},{"lineBreak":true},{"text":"ashí ijinamiajai,","poem":1},{"lineBreak":true},{"text":"dutika ijinan ima wiki wakitkimiajai.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"¡Shiwagnak ashí ijinawabiajai!","poem":1},{"lineBreak":true},{"text":"¡Makichik iwakukesh juwakchabi!","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Ame senchimtijuawamin","poem":1},{"lineBreak":true},{"text":"shiwaajujai maaniawabiajai.","poem":1},{"lineBreak":true},{"text":"Wijai shiwagmagaidaush","poem":1},{"lineBreak":true},{"text":"mina nii ijinati tusam idaitugsabiume.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ame mina shiwag aidauk,","poem":1},{"lineBreak":true},{"text":"wisha wainaig ipisja ishiakuitme.","poem":1},{"lineBreak":true},{"text":"Tujash wi pataetuka amainagkan","poem":1},{"lineBreak":true},{"text":"mina kajegtuidaunak ijinawabiajai.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Dutika ijinai,","poem":1},{"lineBreak":true},{"text":"tikich aents aidaun egayanme yainkatnume tusag,","poem":1},{"lineBreak":true},{"text":"tujash makichkish yaigchajabi.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"aminash egapayanume,","poem":1},{"lineBreak":true},{"text":"tujash yaigchabiume.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"¡Nugka tsaimaina imatikan tsaikamiajai!","poem":1},{"lineBreak":true},{"text":"Tsakus wajatua najamaina imatikiajai ditanak.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Mina pataag aidauk","poem":1},{"lineBreak":true},{"text":"pempeentugkiag shiwagmatuinakuish,","poem":1},{"lineBreak":true},{"text":"ame ayamjuttsamin depetkamiajai.","poem":1},{"lineBreak":true},{"text":"Ame minak Israel aents aidau apuji,","poem":1},{"lineBreak":true},{"text":"nuigtu tikich aents aidau apujishkam etiuwaitme.","poem":1},{"lineBreak":true},{"text":"Aents wi wainajakchamu aidau","poem":1},{"lineBreak":true},{"text":"mina umigtuinak takagtuinawai.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Wi tabaunak betek umigtuinawai.","poem":1},{"lineBreak":true},{"text":"Aents tikich nugkanmaya aidau,","poem":1},{"lineBreak":true},{"text":"mina inataig waigkag emematjuinawai.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Aents tikich nugkanmaya aidauk,","poem":1},{"lineBreak":true},{"text":"wijai maaniatag takush sapigmainawai,","poem":1},{"lineBreak":true},{"text":"nuninak uumak batsatu kujaukmaikia","poem":1},{"lineBreak":true},{"text":"jiinkiag mantuawaipa tujutuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amek tuke pujuuwaitme!","poem":1},{"lineBreak":true},{"text":"¡Ameketme mina ejamataigmek!","poem":1},{"lineBreak":true},{"text":"¡Ashí aents aidautijum","poem":1},{"lineBreak":true},{"text":"mina uwemtijina nunú ememattajum!","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Apajuíyah, ame mina","poem":1},{"lineBreak":true},{"text":"shiwag aidauk ijinabiume,","poem":1},{"lineBreak":true},{"text":"ame minak kuashat tikich aents aina nunashkam","poem":1},{"lineBreak":true},{"text":"apuji etiuwaitme.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Mina shiwag kajegtuinak mantuatag","poem":1},{"lineBreak":true},{"text":"tuinakuish, ame minak uwemtijame.","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidau mantuatag tujutiagmayi,","poem":1},{"lineBreak":true},{"text":"tujash ame ayamjutkauwaitme!","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Nuadui tikich aents","poem":1},{"lineBreak":true},{"text":"ii wegantuchu aina nuna emtinish","poem":1},{"lineBreak":true},{"text":"amina emematjame,","poem":1},{"lineBreak":true},{"text":"tuja amina etsagkeakun kantamjai.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Ame apu ati tusa etegtuau asam,","poem":1},{"lineBreak":true},{"text":"depetmatak tuké sujame.","poem":1},{"lineBreak":true},{"text":"Ame minak, tuja mina uchig wegantujai","poem":1},{"lineBreak":true},{"text":"amina anenkagmin tuké kuitamjame.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/2SA/19.json","previousChapterAudioLinks":{},"numberOfVerses":51}