{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":1,"content":[{"type":"heading","content":["Apajuí kajekbau"]},{"type":"verse","number":1,"content":["Nugka uugbau atin jimag mijan ai, Ozías Judá wegantu aidaun apuji, tuja Jeroboam Joása uchiji Israel aents aidaun apuji aatus batsamajaku aina nunú tsawantin, Amós uwija kuitamin yaakat Tecoanmaya aajakua nuna Apajuí akatjauwai. Dutikam Israel aents aidaun ujakui."]},{"type":"line_break"},{"type":"verse","number":2,"content":["Nunak aatus tiuwai:",{"text":"“Tuke Pujuu kajeka Jerusalén pujus chichataik,","poem":1},{"lineBreak":true},{"text":"chijichi aidauk kagaka jinawai,","poem":1},{"lineBreak":true},{"text":"tuja muja Carmelonum ajak pegkeg wegajushkam kagaka jinawai.”","poem":1}]},{"type":"heading","content":["Ashí aents Apajuín umigchau aidau suwimkan jukiagtin pachisa etsegkamu"]},{"type":"verse","number":3,"content":["Tuke Pujuu chichaak:",{"text":"“Damasconmaya aidauk ayatak tudauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak galaadnumia aents aidaun","poem":1},{"lineBreak":true},{"text":"trigo dekegka tsaimaina imatikawajui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuadui jega apu Hazael","poem":1},{"lineBreak":true},{"text":"pujusa inamtaijiya nunak apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak niina uchiji Ben-hadad","poem":1},{"lineBreak":true},{"text":"pujusa inamtaijiya nunashkam apeattawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Damasco waitijinak tegajattajai, dutika utuan,","poem":1},{"lineBreak":true},{"text":"Bicat-avénkan apujin Bet-edénkan apujijai mai maattajai.","poem":1},{"lineBreak":true},{"text":"Dutikamtai atum aidautigminak achigmajag","poem":1},{"lineBreak":true},{"text":"Quir nugkanum yajupakagtatui”, tawai Tuke Pujuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuigtu Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Gazanmaya aents aina duka ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Nuigtush kuashat aentsun achija yajuakag","poem":1},{"lineBreak":true},{"text":"Edom aents aidaunum sujujajui,","poem":1},{"lineBreak":true},{"text":"dita inake atinme tusag.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuadui yaakat Gaza peejamua nunak ashí apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtainak ashí apeattawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja apu Ashdodnum puja nunak","poem":1},{"lineBreak":true},{"text":"Ascalónkan apujiya nujai mai tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"dutikakun wi kajekbaujui utuan","poem":1},{"lineBreak":true},{"text":"filisteo aents aidaunak ijinattajai.","poem":1},{"lineBreak":true},{"text":"Dutikakun ecrógnumianashkam wi kajekbaujui ijinattajai.","poem":1},{"lineBreak":true},{"text":"Nunak dekas uminkatnun tajai”, tawai Tuke Pujuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tuke Pujuu nuigtu chichaak:","poem":1},{"lineBreak":true},{"text":"“Tironmaya aents aidauk ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak tikich aents aidau","poem":1},{"lineBreak":true},{"text":"dita yachi yachijaig chichama umikag batsatunash","poem":1},{"lineBreak":true},{"text":"ajaantus diitsuk achija yajuakag,","poem":1},{"lineBreak":true},{"text":"Edom aents aidaun inake atinme tusag ashí sujujajui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuadui yaakat Tiro peejamua nunak apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtain ashí apeattawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tuja junashkam Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Edom aents aidauk, ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak dita yachi Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"tuke kajejin asag,","poem":1},{"lineBreak":true},{"text":"dita kajetin umiinak pempeentukiag ai aintuinakua,","poem":1},{"lineBreak":true},{"text":"makichkish wait anentsuk puyajai ijinawaju ainawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui yaakat Temágnak apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtain","poem":1},{"lineBreak":true},{"text":"Boshránum awa nunak ashí apeattawai”, tawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Junashkam Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Amón aents aidauk ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak kuashat nugkan jukitag tuidau asag,","poem":1},{"lineBreak":true},{"text":"Galaad nugkanum nuwa aidaun ejapeniag ijinau ainawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuadui yaakat Rabá peejamua nunak apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtain ashí apeattawai.","poem":1},{"lineBreak":true},{"text":"Dutikan ijinai buutuinamu","poem":1},{"lineBreak":true},{"text":"dase suwe wajas kedegtuwama imattatui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja dita apujinak, niina atuwe tikich apu aidaujai","poem":1},{"lineBreak":true},{"text":"achikag, yaja tikich nugkanum jukiagtinai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas uminkatnun tajai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}