{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Moab aents aina duka ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak Edom aents aidaun apujin","poem":1},{"lineBreak":true},{"text":"ukunchin apeawag yuku awajsajui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuadui Moab nugkanak apeattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtain","poem":1},{"lineBreak":true},{"text":"Quiriotnum awa nuna apeattawai.","poem":1},{"lineBreak":true},{"text":"Moab aents aidauk maaniaku untsubau,","poem":1},{"lineBreak":true},{"text":"cornetan umpuinamu aatus pampainamunum jinawagtatui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Dita apujinak, tikich apu eme anentsa diitai","poem":1},{"lineBreak":true},{"text":"aina nujai ashí wi ijinattajai!","poem":1},{"lineBreak":true},{"text":"Nunak Tuke Pujuu dekas uminkatnun tawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tuja junashkam Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Judá wegantu aina duka ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Nunin asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Wagki ditak Tuke Pujuu chichamen umigtsuk,","poem":1},{"lineBreak":true},{"text":"dakumka najanamu aidaun","poem":1},{"lineBreak":true},{"text":"dita apachji emematiu aina nuna ditashkam emematiaju ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuadui Judá wegantu aidaun yaaktaji aina nunak apejuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nunú kegak apu pujusa inamtai aidau","poem":1},{"lineBreak":true},{"text":"Jerusalén ayá nuna apeattawai.”","poem":1}]},{"type":"heading","content":["Israel aents aidau dita pegkegchaujin suwimkan jukiagtin"]},{"type":"verse","number":6,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aina duka ayatak pegkegchauk ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asagmatai, makichkish tsagkujachagtatjai.","poem":1},{"lineBreak":true},{"text":"Dita aidauk aents ujudauch aidaun,","poem":1},{"lineBreak":true},{"text":"tikichi inake atinun kuichkin juwinak sujuinawai,","poem":1},{"lineBreak":true},{"text":"dutikaidau asag sapatjaiyaske yapajinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja aents ujudauch aidaunak tikima shiig senchi waitkainawai,","poem":1},{"lineBreak":true},{"text":"dutikaidau asag makichkish yainatsui.","poem":1},{"lineBreak":true},{"text":"Múun aidauk, uchijijai makichik nuwanak jimagtu yujawai.","poem":1},{"lineBreak":true},{"text":"Nuninak kajetan sujuinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aents ujudauch aidau jáanchjin","poem":1},{"lineBreak":true},{"text":"diwijum akikmaku jukita tusa","poem":1},{"lineBreak":true},{"text":"emetjuamu aidaun ainak tepesag,","poem":1},{"lineBreak":true},{"text":"dita apajuímtaijin emematuinak yujumkan yuu batsatui.","poem":1},{"lineBreak":true},{"text":"Aents diwimkagtukchaunak akikmakta tusag","poem":1},{"lineBreak":true},{"text":"kuichkin atankiag,","poem":1},{"lineBreak":true},{"text":"nunú kuichkia duwi vinon sumakag,","poem":1},{"lineBreak":true},{"text":"dita apajuímtaiji jegamjukbaunum wayawag umú yujawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"wi atumnak Egipto nugkanum waitu batsatutigmin jiigmaijime,","poem":1},{"lineBreak":true},{"text":"dutika yajuakan wi kuitamsan","poem":1},{"lineBreak":true},{"text":"cuarenta mijan uwegshunum awekasuitjime.","poem":1},{"lineBreak":true},{"text":"Dutikakun atumi shiwaajum amorreo aents aidau","poem":1},{"lineBreak":true},{"text":"shiig senchigtin esajam wajatpakin aidaunak","poem":1},{"lineBreak":true},{"text":"ashí ijinan dita nugken atumin amasuitjime.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Atumi uchijum aidaunmayan profeta agtinun etegjauwaitjai,","poem":1},{"lineBreak":true},{"text":"tuja tikich aidaunak nazareo atinme tusan nunashkam akanjauwaitjai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu nunak dekas nunikua nuna tawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Tujash atum aidautijum","poem":1},{"lineBreak":true},{"text":"nunú nazareo aidau vino uwagta tusajum waitkasu ainagme.","poem":1},{"lineBreak":true},{"text":"Dutikakjum profeta aidaushkam mina chichamjun","poem":1},{"lineBreak":true},{"text":"etsegkai tusajum dakitjauwaitjume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui, carreta trigon aimak wegak","poem":1},{"lineBreak":true},{"text":"nugkan umuchiakui,","poem":1},{"lineBreak":true},{"text":"wajasa ayamainchau dekapmaina imatikattajime.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuna imatikai uwemjatag tusajum tupikakjumesh uwemjashtatjume,","poem":1},{"lineBreak":true},{"text":"aents senchigtin akush kakaumainchau dekapjattawai.","poem":1},{"lineBreak":true},{"text":"Tuja aents wajiushkam ayamjumakchattawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja flecha akentan yacha akush,","poem":1},{"lineBreak":true},{"text":"senchi tupikain akush,","poem":1},{"lineBreak":true},{"text":"caballonum tupikain akush, uwemjachagtatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nunú tsawantinig maanitan yacha akush,","poem":1},{"lineBreak":true},{"text":"maanitai aidau takakbaujinak utsag ukuinak pisajagtatui.","poem":1},{"lineBreak":true},{"text":"Nunak dekas nuniktinun Tuke Pujuu tawai”, tiuwai Amós.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}