{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":3,"content":[{"type":"heading","content":["Profetan takatji"]},{"type":"verse","number":1,"content":["Israel aents aidauwah, atum Egipto nugkanum batsamsajum waitu batsatutigmin Tuke Pujuu jiipag agkanmitkagmawa nuna chichame antuktajum:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ashí nugkanum aentsuk ayaig,","poem":1},{"lineBreak":true},{"text":"ima atumnak etegkauwaitjime.","poem":1},{"lineBreak":true},{"text":"Dutikamuitkujum pegkegchau takamsau asajum,","poem":1},{"lineBreak":true},{"text":"nunú umiakjum diwimkagtukbau akikmamaina numamtuk","poem":1},{"lineBreak":true},{"text":"suwimak jukittajume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Jimag aents tsanigka wekaga nunak,","poem":1},{"lineBreak":true},{"text":"mai antugdayas wekagu asa aniawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"León shinakug, kuntinjin maa akasmatak shinawai,","poem":1},{"lineBreak":true},{"text":"tuja leónka uchiji waanum shinakug,","poem":1},{"lineBreak":true},{"text":"kuntinjin mau asa akasmatak shinawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pishak nemak pujakug,","poem":1},{"lineBreak":true},{"text":"nemaktinji detua ukukbaunum nemawai.","poem":1},{"lineBreak":true},{"text":"Kuntin achiktasa dakamtika ukukbau","poem":1},{"lineBreak":true},{"text":"tsekea nunak achika aniawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Trompeta yaaktanum shidaun antuinakug,","poem":1},{"lineBreak":true},{"text":"aents aidauk pampainawai.","poem":1},{"lineBreak":true},{"text":"Utugchat yaaktanum nagkaema duka","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu nunikti tibau asa nuniawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke Pujuu niina aentsji profeta aidaun","poem":1},{"lineBreak":true},{"text":"dekamtiktsukek nii wakegamu ataish,","poem":1},{"lineBreak":true},{"text":"nigkik makichkish dutikatsui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"León shinaun antuinakug,","poem":1},{"lineBreak":true},{"text":"ashí ishamainak kujain ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja Tuke Pujuu profetan chichakti tamak","poem":1},{"lineBreak":true},{"text":"niina daajin chichamainai”, tawai Apajuí.","poem":1}]},{"type":"heading","content":["Yaakat Samaria tsayam atin"]},{"type":"verse","number":9,"content":[{"text":"Ashdotan apuji aidau batsatbaunum,","poem":1},{"lineBreak":true},{"text":"Egipto apuji aidau batsatbaunum","poem":1},{"lineBreak":true},{"text":"chicham etsegkujum:","poem":1},{"lineBreak":true},{"text":"“Samaria mujaji aina nuwi kaunatajum”,","poem":1},{"lineBreak":true},{"text":"tusajum ijumjatajum,","poem":1},{"lineBreak":true},{"text":"nuwi ijunas Samaria nugkanum","poem":1},{"lineBreak":true},{"text":"magkagtuinamu pegkegchau takainamujai","poem":1},{"lineBreak":true},{"text":"pachimnaga awa nuna wainkatnume.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Samarianmaya aidauk shiijak takainatsui,","poem":1},{"lineBreak":true},{"text":"aents aidaun mainak wajiji yajutkamu aidaun","poem":1},{"lineBreak":true},{"text":"dita pujusa inamtaijin ijumag batsamtawai.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Shiwag aidau yaakat Samarian jetektatus tenteawagtatui,","poem":1},{"lineBreak":true},{"text":"dutika jetekag kaya jegamkamu aidaunak tsaikag,","poem":1},{"lineBreak":true},{"text":"apu pujusa inamtaijin waji ayaunak","poem":1},{"lineBreak":true},{"text":"ashí yajuakagtatui”, tawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuja junashkam Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Uwija kuitamin uwigji yujam ayamjuktatus","poem":1},{"lineBreak":true},{"text":"maanitkush ayatak jimag nawe ampigbaun","poem":1},{"lineBreak":true},{"text":"nuniachkush kuishi ampigbaunakesh,","poem":1},{"lineBreak":true},{"text":"juwama numamtuk","poem":1},{"lineBreak":true},{"text":"atum samarianmaya aidautijum","poem":1},{"lineBreak":true},{"text":"Damasconmaya jáanch pegkeg ainkajum","poem":1},{"lineBreak":true},{"text":"kaji batsatjum duka","poem":1},{"lineBreak":true},{"text":"pisakjum piipich jukijum pisagtatjume.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu ashí senchigtina nunú ataktu chichaak:","poem":1},{"lineBreak":true},{"text":"“Antuktajum atum aidautijum,","poem":1},{"lineBreak":true},{"text":"nunikjum Jacob wegantu aidau","poem":1},{"lineBreak":true},{"text":"suwimkan jukiagtata nunú pachisjum etsegkatajum.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wika dita pegkegchau takamsamujin","poem":1},{"lineBreak":true},{"text":"suwimkan susagtatjai,","poem":1},{"lineBreak":true},{"text":"dutikakun Betelnum dita apajuímtaijin emematuinak","poem":1},{"lineBreak":true},{"text":"altar najankamu ayá nunak ashí tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai nugká batsamsattawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wiakchan jee aidau, tsetsek tepeamtai kanutai,","poem":1},{"lineBreak":true},{"text":"jega pegkeg umikbau aina nunak,","poem":1},{"lineBreak":true},{"text":"esattin kanutai aina nujai tsaiktatjai.","poem":1},{"lineBreak":true},{"text":"Tuja jega marfil jegamkamu aina nunashkam tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"tuja jega apu pujusag inamaina nunashkam","poem":1},{"lineBreak":true},{"text":"ashí tsaiktatjai”, tawai Tuke Pujuu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}