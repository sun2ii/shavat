{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Samarianmaya nuwa aidautijum antuktajum:","poem":1},{"lineBreak":true},{"text":"Atumek baságnumia baka duwejam aina iman","poem":1},{"lineBreak":true},{"text":"duwekjum batsatjume.","poem":1},{"lineBreak":true},{"text":"Atumek ujudauch aidau senchi waitkakjum dushikiagme,","poem":1},{"lineBreak":true},{"text":"nunin asajum atumi aishjum aidau vino sujusta uwajan nampektajai","poem":1},{"lineBreak":true},{"text":"tusajum inaku waitkagme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel aents aidaun Apajuíji","poem":1},{"lineBreak":true},{"text":"niina pegkegmajin nii umiktinun aatus tawai:","poem":1},{"lineBreak":true},{"text":"“Atumin tsegkenai awagtamak","poem":1},{"lineBreak":true},{"text":"japiki jujamkiagtinuk tsawan uminui,","poem":1},{"lineBreak":true},{"text":"tuja atumi uchijum aidaunak agseayai nenakag japikiagtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atumek yaakat peejamu agkaju aidaunum eteemajum maki makichik jiinjatnaitjume.","poem":1},{"lineBreak":true},{"text":"Nunikagmin muja Hermógnum utsampakagtinai.”","poem":1},{"lineBreak":true},{"text":"Nunak Tuke Pujuu dekas uminkatnun tawai.","poem":1}]},{"type":"heading","content":["Israel aents aidauk suwimkan juinakush anentaimainachu"]},{"type":"verse","number":4,"content":[{"text":"“Atumek pegkegchau takat aidau","poem":1},{"lineBreak":true},{"text":"ima wakegau asajum Betelnum shiyakjum,","poem":1},{"lineBreak":true},{"text":"tuja Guilgalnumshakam shiyakjum,","poem":1},{"lineBreak":true},{"text":"atumi apajuímtai dakumkamu najanamu aidau","poem":1},{"lineBreak":true},{"text":"emematu batsamtajume.","poem":1},{"lineBreak":true},{"text":"Atum nuniakjuminish, wika puyatjukchattajai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu, Israel aents aidaun Apajuíjinuk,","poem":1},{"lineBreak":true},{"text":"nunak dekas uminkatnun tajai.","poem":1},{"lineBreak":true},{"text":"¡Atum wakegakjumek tunamá batsamtajum!","poem":1},{"lineBreak":true},{"text":"Tuja atumi apajuímtaiji aidau emematkujum","poem":1},{"lineBreak":true},{"text":"kashikmasjum kuntin maajum apeatajum.","poem":1},{"lineBreak":true},{"text":"Dutikakjum nuigtushkam kampatum tsawan jegakui,","poem":1},{"lineBreak":true},{"text":"atum ajakmamunmaya juukjum diezmo tuké sutajum,","poem":1},{"lineBreak":true},{"text":"tuja tikich anentag aidaushkam susatajum,","poem":1},{"lineBreak":true},{"text":"ashí aents aidau anentag susatnume tusajum","poem":1},{"lineBreak":true},{"text":"etsegkatajum.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nujantai waittsatnume ti ai,","poem":1},{"lineBreak":true},{"text":"ashí yaakat aidaunum yumain atsakui,","poem":1},{"lineBreak":true},{"text":"nujantai waitbaijume.","poem":1},{"lineBreak":true},{"text":"¡Imanika waitiakjumesh atumek minak","poem":1},{"lineBreak":true},{"text":"umigtukchabiugme!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Tuja nuigtushkam ajak juut jegau aig,","poem":1},{"lineBreak":true},{"text":"kampatum nantui yumin yutumtijachmaijai.","poem":1},{"lineBreak":true},{"text":"Makichik yaaktanmak yutumtijamiajai,","poem":1},{"lineBreak":true},{"text":"untsu tikich yaaktanmak yutumtijachmaijai.","poem":1},{"lineBreak":true},{"text":"Tikich yantamnumak yumi yutuju asamtai,","poem":1},{"lineBreak":true},{"text":"nugka chupika pegkeg wajas amayi,","poem":1},{"lineBreak":true},{"text":"nuniai untsu tikich yantamnum yumi yutugchau asamtai,","poem":1},{"lineBreak":true},{"text":"ajakak kagaka amayi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nunikmatai aents aidauk yumin egainak","poem":1},{"lineBreak":true},{"text":"maki makichik yaaktanum yujabi,","poem":1},{"lineBreak":true},{"text":"imanik yujainakush kuashat uwaja kitak","poem":1},{"lineBreak":true},{"text":"amikmainnakesh wainkachagmayi,","poem":1},{"lineBreak":true},{"text":"tuja imanika waitiakjumesh minak","poem":1},{"lineBreak":true},{"text":"umigtukchabiugme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Wi atumdau ajak ajakmakbau aidaunak,","poem":1},{"lineBreak":true},{"text":"tuja numi nejen aidaunashkam ijituajime,","poem":1},{"lineBreak":true},{"text":"atumi ajagmin manchi aidaun ishitkabiajime,","poem":1},{"lineBreak":true},{"text":"nuigtushkam dase sukutnun uwegshunmayan","poem":1},{"lineBreak":true},{"text":"dasenmitkakbaijai,","poem":1},{"lineBreak":true},{"text":"tujash imanika waitiakjumesh atumek minak umigtukchabiugme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Egiptunmaya aents aidaun suwimkan susauwaitag","poem":1},{"lineBreak":true},{"text":"imatikan suwimkan amasuitjime;","poem":1},{"lineBreak":true},{"text":"tuja atumi uchijum aidau","poem":1},{"lineBreak":true},{"text":"maaniamunum jinaati ti ai jinawabi.","poem":1},{"lineBreak":true},{"text":"Nunikagmatai dita caballoji aidaun yajutkajabi,","poem":1},{"lineBreak":true},{"text":"nunú jinaa kauku mejeakjum waitiugme,","poem":1},{"lineBreak":true},{"text":"¡imaniakjumesh minak umigtukchauwaitjume!”","poem":1},{"lineBreak":true},{"text":"tawai Tuke Pujuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Apajuí ataktu chichaak:","poem":1},{"lineBreak":true},{"text":"“Sodomanmaya aents aidaun,","poem":1},{"lineBreak":true},{"text":"Gomorranmaya aents aidaujai suwimka suwakun","poem":1},{"lineBreak":true},{"text":"jii ajunjan ijinauwaitag numamtuk awajkauwaitjime atumnashkam.","poem":1},{"lineBreak":true},{"text":"Dutika ai jii kaiji ampinjau tepegama numamtuk wajakuitjume.","poem":1},{"lineBreak":true},{"text":"¡Imanika waitiakjumesh minak umigtukchau ainagme!”","poem":1},{"lineBreak":true},{"text":"tawai Tuke Pujuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Nunin asagmin, yaunchuk tikich aidaun","poem":1},{"lineBreak":true},{"text":"suwimkan susauwaitag numamtuk","poem":1},{"lineBreak":true},{"text":"awajkattajime Israel aents aidautigminak.","poem":1},{"lineBreak":true},{"text":"Apajuí suwimkeg uwemtumainchau asajum,","poem":1},{"lineBreak":true},{"text":"¡umintsajum Apajuí igkugtasajum dakastajum!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tuke Pujuuwai muja aidaun najanin,","poem":1},{"lineBreak":true},{"text":"dasenashkam najanin, tsawainash suwe emau,","poem":1},{"lineBreak":true},{"text":"niinu aidaunash aentsun paan dekamtikau","poem":1},{"lineBreak":true},{"text":"ashí nugkanum wekagu.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, Apajuí ashí senchigtin tutaya","poem":1},{"lineBreak":true},{"text":"nunuwai niina daajig.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":12}