{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":5,"content":[{"type":"heading","content":["Pegkegchau takatak idaikujum Apajuí umigkatajum tusa Israel aents aidau chichagkamu"]},{"type":"verse","number":1,"content":[{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"ishamain nagkaemaktin asamtai,","poem":1},{"lineBreak":true},{"text":"wi wake besemag dekapeakun kantamag nunú antuktajum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel aents aidau imanji,","poem":1},{"lineBreak":true},{"text":"pegkeg wajaknuwe nunú nantakchatnun iyaajaje,","poem":1},{"lineBreak":true},{"text":"nunikag nantamainchau wajasag batsatui.","poem":1},{"lineBreak":true},{"text":"Ditan inanmainuk atsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Tuke Pujuu Israel aents aidaun chichajak:",{"text":"“Makichik yaaktanmaya","poem":1},{"lineBreak":true},{"text":"mil suntag maaniamunum ishiakbauk,","poem":1},{"lineBreak":true},{"text":"ayatak cien suntajak iwaku wakitkittawai.","poem":1},{"lineBreak":true},{"text":"Tuja cien suntag ishiakbauk,","poem":1},{"lineBreak":true},{"text":"ayatak diez suntag iwaku wakitkittawai”, tawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tuke Pujuu Israel aents aidaun nuigtu chichajak:","poem":1},{"lineBreak":true},{"text":"“Iwaku pujustag takugmek, mina umigtuktajum.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dakumkamu aidau ememattasajum Betelnum wetin aigpajum.","poem":1},{"lineBreak":true},{"text":"Nunú nuniakjumek ijina utsam atatjume.","poem":1},{"lineBreak":true},{"text":"Tuja Bershebanmakesh wetin aigpajum,","poem":1},{"lineBreak":true},{"text":"nuniachkugmesh Guilgala nunigkesh nagkaemaktin aigpajum,","poem":1},{"lineBreak":true},{"text":"wagki nuwiya aents aidaunak ashí achijag yajuakagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja Betelak tsaikam uwejush wajas asatnai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu umigkatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum iwaku pujustatjume,","poem":1},{"lineBreak":true},{"text":"atum nii umigtsugminig, Israel aents aidau","poem":1},{"lineBreak":true},{"text":"kanakag ijunjajua nuna ijinattawai.","poem":1},{"lineBreak":true},{"text":"Betelnum dakumka najanamu apajuímtai aina nunak ekemaktatui,","poem":1},{"lineBreak":true},{"text":"dutikamtaig makichkish ikagnakchagtatui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents ujudauch aidau waitkam batsata nunú","poem":1},{"lineBreak":true},{"text":"shiig anentsajum kuitamchau,","poem":1},{"lineBreak":true},{"text":"nuigtush aents ayamke atsaujai","poem":1},{"lineBreak":true},{"text":"betek waitkau aidautigminak wait anentajime.","poem":1},{"lineBreak":true},{"text":"Wagki atumek pegkeja nunú pegkegchau anentagme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Apajuíyai yaya aidaun, nayaimpijai najadau,","poem":1},{"lineBreak":true},{"text":"tsaaptinnash suwe emau,","poem":1},{"lineBreak":true},{"text":"suwenash tsaaptin emau,","poem":1},{"lineBreak":true},{"text":"yuminash yutumtikau.","poem":1},{"lineBreak":true},{"text":"Apajuík yaakat peejamu aidaunash tsainai,","poem":1},{"lineBreak":true},{"text":"tuja nunú tsaikbaunmayanak jega múun aidaun kaya ekenag jegamak uminai.","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuu ashí senchigtin tutaya nunuwai niina daajig!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aents shiig takantsati tusa chichamjaun","poem":1},{"lineBreak":true},{"text":"waitjutsuk dekasken chichaujai kajeja nunak wait anentajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wagki ditak ujudauch aidaun tepejuk batsamtusag,","poem":1},{"lineBreak":true},{"text":"diwijum akikmakta tusag trigo atantuinawai.","poem":1},{"lineBreak":true},{"text":"Nunin asag, jega pegkeg aidaun","poem":1},{"lineBreak":true},{"text":"dita jegamjajua nuwig pujuschagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtush dita uva ajakbaujiya nuwiyan","poem":1},{"lineBreak":true},{"text":"vino najanawajag shiig aneasag uwagchagtatui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dita aidau shiig kuashat pegkegchaun takamaina nunak","poem":1},{"lineBreak":true},{"text":"wika shiig dekajai.","poem":1},{"lineBreak":true},{"text":"Tuja apu chichama epegkin aidau aents pegkegchau aidaun yayaak,","poem":1},{"lineBreak":true},{"text":"tikich aents utugchatji atsujunak suwimkan suwina","poem":1},{"lineBreak":true},{"text":"nunak shiig dekajai.","poem":1},{"lineBreak":true},{"text":"Nuadui chicham ataik, wiakuch aidau","poem":1},{"lineBreak":true},{"text":"ujudauch aidaunak tuke depetuinawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui kuashat pegkegchau takamu ayau asamtai,","poem":1},{"lineBreak":true},{"text":"aents yacha duka takamtak pujawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Pegkegchau takat aina duka idaikujum,","poem":1},{"lineBreak":true},{"text":"pegkeg takat aina nunú takastajum,","poem":1},{"lineBreak":true},{"text":"nunú nuniakjum dukap tsawan pujustatjume.","poem":1},{"lineBreak":true},{"text":"Nuniagmin Tuke Pujuu, ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"inak yaimpawai tajum nunú dekaskenum atumnak tuke yaimpaktatui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Pegkegchauwa duka dakitjatajum!","poem":1},{"lineBreak":true},{"text":"¡Pegkeja nunú waketajum!","poem":1},{"lineBreak":true},{"text":"Apu chichama epegkin aidautigmek,","poem":1},{"lineBreak":true},{"text":"shiig betek chicham iwajatasajum anentaimtajum.","poem":1},{"lineBreak":true},{"text":"Nuniagminig Tuke Pujuu, Apajuí ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"Israel aents aidau ujumak iwaku batsata nunash","poem":1},{"lineBreak":true},{"text":"wait anenjachajaintash.”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunú chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi atumin suwimka amastasan minitaik,","poem":1},{"lineBreak":true},{"text":"ashí yantamnum buutiagtinai.","poem":1},{"lineBreak":true},{"text":"Jinta aidaunum buutuidau,","poem":1},{"lineBreak":true},{"text":"yutai ijumja sujutai aidaunum buutuidau,","poem":1},{"lineBreak":true},{"text":"ashí plaza aidaunum buutuidau,","poem":1},{"lineBreak":true},{"text":"uva ajakmakbau aidaunum buutuidau,","poem":1},{"lineBreak":true},{"text":"aja aidaunum buutuidau,","poem":1},{"lineBreak":true},{"text":"jakamunum buutuidaushkam agtatui”,","poem":1},{"lineBreak":true},{"text":"tawai Tuke Pujuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"¡Tuke Pujuu tattawai tusajum shiig aneautigminak","poem":1},{"lineBreak":true},{"text":"wait anentajime!","poem":1},{"lineBreak":true},{"text":"Atumek waji utugchatak nagkaetamkiti nunú","poem":1},{"lineBreak":true},{"text":"dekachu asajum tuu yujagme.","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuu minamuk, tsaaptinuk achattawai,","poem":1},{"lineBreak":true},{"text":"suwe ishamain atatui!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nunú tsawantinig makichik aents","poem":1},{"lineBreak":true},{"text":"león aintam tupika wekama, chayujai igkuniak","poem":1},{"lineBreak":true},{"text":"wajuk anentaimainaita iman atatui.","poem":1},{"lineBreak":true},{"text":"Nuniachkush jegá waya tanishnum atumkama,","poem":1},{"lineBreak":true},{"text":"nuwi dapi tepau esaim anentaimaina iman atatui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Duka dekaske, Tuke Pujuu minamuk","poem":1},{"lineBreak":true},{"text":"tsaaptinuk achattawai, suwe atatui;","poem":1},{"lineBreak":true},{"text":"¡nunú tsawantinig shiig aneamuk achattawai,","poem":1},{"lineBreak":true},{"text":"ayatak wake besemag atinai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"¡Jiistamtai ati tusa tsawan etegjamu aina","poem":1},{"lineBreak":true},{"text":"nunú umiaji tusajum jiistamjum nunak shiig dakitajai!","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí emematji tusajum ijunjajum","poem":1},{"lineBreak":true},{"text":"shiig aneajum nunashkam shiig dakitajai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apajuí tudaun tsagkugtamjati tusajum","poem":1},{"lineBreak":true},{"text":"kuntin maajum nuna neje ashí apeajum","poem":1},{"lineBreak":true},{"text":"nunak wika dakitajai.","poem":1},{"lineBreak":true},{"text":"Tuja agkan pujutan amastí tusagmeshkam,","poem":1},{"lineBreak":true},{"text":"kuntin aidau, ajak juukbau aidaujai","poem":1},{"lineBreak":true},{"text":"anentag kuashat ikaunmagme,","poem":1},{"lineBreak":true},{"text":"tujash wika nunú diitnak dakitajai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Juwi wainka kantama batsamtsuk,","poem":1},{"lineBreak":true},{"text":"yaja shiyakjum kantamatajum!","poem":1},{"lineBreak":true},{"text":"¡Atum arpa awatjum nunú antutnak dakitajai!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aan batsamtsuk dekas","poem":1},{"lineBreak":true},{"text":"wi shiig kuitamkagtinaitag nunisjumek,","poem":1},{"lineBreak":true},{"text":"atumshakam tikich aidau shiig kuitamkatajum.","poem":1},{"lineBreak":true},{"text":"¡Atum shiig takamua duka namak kuyua","poem":1},{"lineBreak":true},{"text":"megkaechauwa nujai betek ati!","poem":1}]},{"type":"verse","number":25,"content":["“Israel aents aidauwah, atum cuarenta mijan uwegshunum yujasuitjum nuaduik, anentag aidauk minak sujuschauwaitjume."]},{"type":"verse","number":26,"content":["Atumek Sicut atum dakumka najanamu wainka apajuímtai atum apu tajum nunú yanasa yujayugme. Nuigtushkam Quiliún atum dakumka najanamu yaya nunin aajakua nunú yanasa yujayugme."]},{"type":"verse","number":27,"content":["Nuadui aents tikich nugkanmaya Siria nugkan nagkaiki batsamin aidau achija yajuaktinme tusan idaisattajime”, tawai Tuke Pujuu, Apajuí ashí senchigtina nunú."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}