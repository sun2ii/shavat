{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":6,"content":[{"type":"heading","content":["Apajuí Israel aents aidaun suwimak susamu"]},{"type":"verse","number":1,"content":[{"text":"Amós chichaak:","poem":1},{"lineBreak":true},{"text":"¡Jerusalégnumia aidau sapigmatsuk","poem":1},{"lineBreak":true},{"text":"puyatkas batsata nunak wait anentuinajai!","poem":1},{"lineBreak":true},{"text":"Yaakat Samaria eme anentautigminak wait anentajime.","poem":1},{"lineBreak":true},{"text":"Juju nugka múunta nuwi apu aidautijum","poem":1},{"lineBreak":true},{"text":"puyattsuk batsatutigminak wait anentajime.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaakat Calné wejum diistajum,","poem":1},{"lineBreak":true},{"text":"tuja nuwi juwakjum yaakat Hamat shiig múunta nuwi wetajum,","poem":1},{"lineBreak":true},{"text":"nunikjum nuwi nagkaemakjum filisteo aidaun yaaktaji Gat wetajum,","poem":1},{"lineBreak":true},{"text":"nunika jegajum nunú yaakat aidaunash itugkajamkiyi nunú diistajum.","poem":1},{"lineBreak":true},{"text":"Atumek dita nagkaesau ainatsjume,","poem":1},{"lineBreak":true},{"text":"tuja atumi nugkega dushakam dita nugken nagkaesauchui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atumek suwimak jukig tusajum dakitajume,","poem":1},{"lineBreak":true},{"text":"nuniayatkujum ayatak suwimak akumtagme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atumek wainka batsamsajum pegak shiig pegkeg","poem":1},{"lineBreak":true},{"text":"marfil najanamu aidaunum kaji batsatjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum kuntin pegkeg duwejam aidau yuu batsatjume.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atumek arpa wainka awatkujum kantamainchau wainka kantamjume,","poem":1},{"lineBreak":true},{"text":"tuja kantamku awattai aidau tusajum wainka najanjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum David yacha aajakua iman anenmamjume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atumek tsapa muunnum vino umakjum","poem":1},{"lineBreak":true},{"text":"shiig senchi nampeagme,","poem":1},{"lineBreak":true},{"text":"tuja dekas kugkuin pegkeg akik aina ibau nijamjume.","poem":1},{"lineBreak":true},{"text":"¡Nuniau asajum atumi yatsum aidau waituina duka pachiatsjume!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nunin ainajum duwi, aents aidaun achija yajumainakug","poem":1},{"lineBreak":true},{"text":"atumna etegtamawag jujamkiagtinai,","poem":1},{"lineBreak":true},{"text":"dutijamawagmatai atum shiig jiistama batsatjum duka","poem":1},{"lineBreak":true},{"text":"wainka juwaktatjume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Tuke Pujuu Apajuí ashí senchigtina nunú pan antumainun chichaak:",{"text":"“¡Jacob wegantu aidauk jega muuntan","poem":1},{"lineBreak":true},{"text":"jegamag batsamas ememaidau asagmatai kajejajai!","poem":1},{"lineBreak":true},{"text":"Nuadui dita yaaktaji aidaunak shiwag aidau tsaigkatnume","poem":1},{"lineBreak":true},{"text":"tusan idaisattajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["“Dutika ai makichik jeganum diez aents iwaku pujauk ashí ijinam agtatui."]},{"type":"verse","number":10,"content":["Nunú aents jinau aidaun patayi aidau dita iyashin jukiag apeawagtatus kaunawag yujattaman, tikich nuna patayi aidau nuwi yujau ditan iniinak: ‘¿Tikichish atsuak?’ tusa tama: ‘Atsa, makichkish atsawai’, tiagtinai, nuna tusa: ‘¡Takamtak wajasta!’ tiagtinai. Wagki nuna inima yujas mina daajun adaikug nuni senchi suwimkan jumain asagmatai."]},{"type":"verse","number":11,"content":["Wagki Tuke Pujuuk Israel aents aidaun suwimkan suwak, jega múun aidaun jega piipich aidaujai ashí tsaiktatui."]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Atumesh anentaimsakjuah,","poem":1},{"lineBreak":true},{"text":"¿caballosh kayanmash tupikaumainkait?","poem":1},{"lineBreak":true},{"text":"Tuja ¿kayanmash pukujaish ajakmamainkait?","poem":1},{"lineBreak":true},{"text":"Tujash atumek shiig takata duka jata awajsaugme,","poem":1},{"lineBreak":true},{"text":"dutikakjum shiig aneasa pujuta dushakam","poem":1},{"lineBreak":true},{"text":"wake besemag awajsaugme.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Atumek yaakat piipich aidau depetkajum","poem":1},{"lineBreak":true},{"text":"ememasa chichaakjum:","poem":1},{"lineBreak":true},{"text":"‘Iina senchijin depetkaji’, tusajum shiig aneajume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuniau asagmin, Tuke Pujuu Apajuí, ashí senchigtina nunú chichagtamak:","poem":1},{"lineBreak":true},{"text":"Shiwag aidau Hamatnum nagkamas jetepakag,","poem":1},{"lineBreak":true},{"text":"uwejush tsumujin awa aatus ashí depetamak","poem":1},{"lineBreak":true},{"text":"dita wagagtamkiag waitkagmastinme tusan idaisattajime”,","poem":1},{"lineBreak":true},{"text":"tujama nunú Israel aents aidautijum shiig antuktajum,","poem":1},{"lineBreak":true},{"text":"tiuwai Amós.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}