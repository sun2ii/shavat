{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"AMO","translationId":"agr_wbt","name":"Amós","commonName":"Amós","title":"Amós","order":30,"numberOfChapters":9,"sha256":"91464248cb00030b292b62a00d482c8e89a0de8a6cc61cc5227dc2bcfc78607b","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/agr_wbt/AMO/9.json","totalNumberOfVerses":142},"chapter":{"number":9,"content":[{"type":"heading","content":["Apajuí aentsu pegkegchaujin diijus suwimkan susatna nuna uwemtumainuk makichkish atsawai"]},{"type":"verse","number":1,"content":["Duwi pujusan Tuke Pujuu altaran ijus wajasa chichagtak:",{"text":"“Tuke Pujuu emematku ijuntai jegamku","poem":1},{"lineBreak":true},{"text":"shugku ajigmawa nunú awatim kupikta,","poem":1},{"lineBreak":true},{"text":"dutikam jega yumpunak aentsun yutua ijinati,","poem":1},{"lineBreak":true},{"text":"tuja tupikaki uwemjatag tuinakush makichkish uwemjachagtatui.","poem":1},{"lineBreak":true},{"text":"Tupikaki uwemjashkam maaniamunum jakattawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nugka initken uumkagmataish, imanuiyanash jiigtatjai,","poem":1},{"lineBreak":true},{"text":"tuja nayaimpin nagkaesau yakí uumkagmataish,","poem":1},{"lineBreak":true},{"text":"imanuiyanash ajuawagtatjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja muja Carmelo titijin waka uumkagmataish,","poem":1},{"lineBreak":true},{"text":"egakan achikagtatjai,","poem":1},{"lineBreak":true},{"text":"tuja nayantsa kunajin uumjutkagmataish,","poem":1},{"lineBreak":true},{"text":"kuntin múun ichiag ijinati tusan awetittajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja shiwag aidau yajuakam uwegshunum shiyakmataish,","poem":1},{"lineBreak":true},{"text":"puyajai ijinatnume tusan inamjattajai.","poem":1},{"lineBreak":true},{"text":"¡Ditanak tuké diyaku atatjai,","poem":1},{"lineBreak":true},{"text":"tujash nunak yayakdukesh dutikashtatjai,","poem":1},{"lineBreak":true},{"text":"suwimkan suwakun dutikattajai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tuke Pujuu Apajuí, ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"nugkan antiawai, dutikam nugkak yumpunui,","poem":1},{"lineBreak":true},{"text":"nunitai aents aidauk buutuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja nugkak uujak namak Nilo dujajak ikaman utuja","poem":1},{"lineBreak":true},{"text":"kuyua, ataktu utug kuyua wajama imanittawai,","poem":1},{"lineBreak":true},{"text":"imanitai aents aidauk ishamainak buutiagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu niina jenak nayaimpinum umikui,","poem":1},{"lineBreak":true},{"text":"untsu nuna ichichiagtinun nugkanum umikui,","poem":1},{"lineBreak":true},{"text":"nayantsak bukuiti yakí weawai, nunik yumi najanea","poem":1},{"lineBreak":true},{"text":"ataktu yuta nunak Apajuí dutikawai.”","poem":1},{"lineBreak":true},{"text":"Niina daajig “Tuke Pujuu” tawa nunuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi diismak Israel aents aidautigmek","poem":1},{"lineBreak":true},{"text":"etiopíanmaya aidaujai betek ainagme.","poem":1},{"lineBreak":true},{"text":"Atum Egipto nugkanum batsatutigmin","poem":1},{"lineBreak":true},{"text":"jiijan ikaunmawaitjim dutiksanuk,","poem":1},{"lineBreak":true},{"text":"filisteo aidaunashkam Creta nugkanum","poem":1},{"lineBreak":true},{"text":"batsatun jiijan ikaunmauwaitjai.","poem":1},{"lineBreak":true},{"text":"Tuja arameo aidaunashkam dutiksanuk","poem":1},{"lineBreak":true},{"text":"Quir nugkanum batsatun jiijan ikaunmauwaitjai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Juju Israel nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"pegkegchau aina nuna Tuke Pujuu diisa chichaak:","poem":1},{"lineBreak":true},{"text":"“Au aents aidaunak ashí ijinan emegkaktatjai,","poem":1},{"lineBreak":true},{"text":"dutikaknush Jacob wegantunak ashí ijintsuk","poem":1},{"lineBreak":true},{"text":"ayamjukan uwemtijattajai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas dutikattajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja Israel aents aidautigmin shiwag aidau","poem":1},{"lineBreak":true},{"text":"trigo wampuji utsankatasa pegamash jigkayi","poem":1},{"lineBreak":true},{"text":"pegkejak iyautsama imatijamatnume tusan titatjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ashí aents chichainak:","poem":1},{"lineBreak":true},{"text":"‘Duka makichkish nunikchattawai,","poem":1},{"lineBreak":true},{"text":"utugchatak atsugtamtatji’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Tujash nuna tuu chichaina duka","poem":1},{"lineBreak":true},{"text":"maaniamunum puyajai ashí jinawagtatui”, tawai.","poem":1}]},{"type":"heading","content":["Apajuí Israel aents aidaun atakea duwi yaigtin"]},{"type":"verse","number":11,"content":["“Nunú tsawan jegakui, Davita aakji tegaekau ataktu aakmamaina numamtuk, ataktu nii wegantunmaya Israel aents aidaun apuji wajas inamjatnai. Nuadui yaunchuk ayanum iman wajasagtinai."]},{"type":"verse","number":12,"content":["Nunikag edomnumia iwaku pujuidauk, tuja tikich aents mina emematjin aidaujai ataktu ashí Israel aents aidaujai awakjattajai”, tusa Tuke Pujuu nii dutikatnun tawai."]},{"type":"verse","number":13,"content":["“Kuashat trigo juwamu atin tsawan jegawai. Trigo juwamuk eke ashimchayatkujum ataktu nagkamajum ajakmattagme. Tuja uva juukbaushkam eke vino najantsuk ukuakjum ataktu uva ajaktatjume. Imatikau asagmin vino najanamu aidauk mujanmash, nain aidaunmash yumijai betek shiig kuashat aitnai."]},{"type":"verse","number":14,"content":["Nunú tsawan uminkui, mina aentsug Israel aents aidau achija yajuakam tikich nugkanum batsatun jiija yajuakan ikaunmatnaitjai. Dutika ai dita yaaktaji tsaikbau aidaun ataktu najanawag batsamas, uva ajakmakag vinon najanawag umuinak, tikich ajak aidaunashkam dita agájin ajakmawag, nuna nejen yuwinak shiig batsamsagtinai."]},{"type":"verse","number":15,"content":["Israel aents aidaunak waji ajakaitkuish wi dita nugken susauwaitag nuwi atakesh tegai ajapashtinun ajakmawagtatjai”, tusa Tuke Pujuu tawai, tiuwai Amós."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}