{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"DEU","translationId":"agr_wbt","name":"Deuteronomio","commonName":"Deuteronomio","title":"Chicham umiktin aidau agagbau aajakua nunúataktu pataka agagbau Deuteronomio","order":5,"numberOfChapters":19,"sha256":"bff26eba50550c0cb0366ddaadba9e81c7b466d281ce97f110f42050036fbfd9","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/agr_wbt/DEU/34.json","totalNumberOfVerses":419},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"“¡Nayaimpih, nugkah, wi chichaktatag","poem":1},{"lineBreak":true},{"text":"nunú shiig antuktajum!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi jintinkagtamua duka yumijai betek yutugtatui,","poem":1},{"lineBreak":true},{"text":"Mina chichamjuk yumi sajatama nujai betek atatui.","poem":1},{"lineBreak":true},{"text":"Yumi ujumak yutug chijichin uchupiama","poem":1},{"lineBreak":true},{"text":"nujai betek atatui.","poem":1},{"lineBreak":true},{"text":"Yumi senchi yutak dupan uchupiama nujai betekai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuu daaji pachisan nigka pegkejai,","poem":1},{"lineBreak":true},{"text":"múuntai tusan etsegkatjai.","poem":1},{"lineBreak":true},{"text":"¡Atumshakam, iina Apajuíjiya duka","poem":1},{"lineBreak":true},{"text":"dekas múuntai titajum!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Niyai iina kuitamjamnuk.","poem":1},{"lineBreak":true},{"text":"Nii takamujiya duka betek uminnai.","poem":1},{"lineBreak":true},{"text":"Niig Apajuí dekaskenum chichauwai.","poem":1},{"lineBreak":true},{"text":"Niig pegkegchaunak takachui.","poem":1},{"lineBreak":true},{"text":"¡Niig pegkegmai,","poem":1},{"lineBreak":true},{"text":"tuja nuigtush waitjuchui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atumek pegkegchau ainagme.","poem":1},{"lineBreak":true},{"text":"Pegkegchau takakjum Apajuí ikajin ainagme.","poem":1},{"lineBreak":true},{"text":"Nunin asajum Apajuí uchijig amaitsugme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu atumin kuitamjama duwika ¿aan iikuajum?","poem":1},{"lineBreak":true},{"text":"Atumek yachachu,","poem":1},{"lineBreak":true},{"text":"anentainkachu ainagme.","poem":1},{"lineBreak":true},{"text":"¿Apajuíchukai atumi apa","poem":1},{"lineBreak":true},{"text":"najapauwa nunú?","poem":1},{"lineBreak":true},{"text":"¡Apajuíyai amina najapa uyujtamak","poem":1},{"lineBreak":true},{"text":"senchimtijamauwa duka!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ataktu awagkijum anentaimsatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum adeagtajum","poem":1},{"lineBreak":true},{"text":"yaunchuk aajakua nunú.","poem":1},{"lineBreak":true},{"text":"Tuja atumi apaji aidau, tikich múun aidaujai","poem":1},{"lineBreak":true},{"text":"yaunchkesh pujutash wajuku ayi tusajum iniastajum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuí aents aidaunak akanag","poem":1},{"lineBreak":true},{"text":"maki makichik chichamtin,","poem":1},{"lineBreak":true},{"text":"nugkentin emak batsasui;","poem":1},{"lineBreak":true},{"text":"tujash atum Israel aents aidautigminak Apajuí","poem":1},{"lineBreak":true},{"text":"makichik nugkanmak ijupag kuitamjamui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apajuík Jacopa uchiji wegantunmaya aidautin","poem":1},{"lineBreak":true},{"text":"etegtamjauwai niinu agtinun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nuadui, uwejush nugka buku, yumi atsau,","poem":1},{"lineBreak":true},{"text":"dase umputainum","poem":1},{"lineBreak":true},{"text":"batsatjin, nii kuitamjamak jintinjamauwai.","poem":1},{"lineBreak":true},{"text":"Dutijamak makichik aents niina jiin shiig kuitamama imatikas kuitamjamkauwai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apajuík ukukui niina","poem":1},{"lineBreak":true},{"text":"nanapen uchijin dukuka","poem":1},{"lineBreak":true},{"text":"kuitamama numamtuk iinak kuitamjamnai.","poem":1},{"lineBreak":true},{"text":"Apajuík, ukukui niina uchijin kuitamak","poem":1},{"lineBreak":true},{"text":"niina nanapen pataja juwama numamtuk","poem":1},{"lineBreak":true},{"text":"kuitamjamak ishamainnumian uwemtijamjauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Tuke Pujuuwa nunuwai","poem":1},{"lineBreak":true},{"text":"iina uyuntamsauwa duka, tikichik atsawai.","poem":1},{"lineBreak":true},{"text":"¡Tikich wainka apajuímtai","poem":1},{"lineBreak":true},{"text":"aina duka makichkish yaimpakchauwai!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apajuí depetmitkagmak","poem":1},{"lineBreak":true},{"text":"jujamki nugka pegkeg ajak shiig tsapau,","poem":1},{"lineBreak":true},{"text":"nain aidaun sujamsaje.","poem":1},{"lineBreak":true},{"text":"Nuwiya dapa yumiji buchignum ayaun","poem":1},{"lineBreak":true},{"text":"amasaje uwagtinme tusa.","poem":1},{"lineBreak":true},{"text":"Nuwiya ajak aina nunashkam","poem":1},{"lineBreak":true},{"text":"amasaje yuwatnume tusa.","poem":1},{"lineBreak":true},{"text":"Tuja nugka kuashat kayagkamunum","poem":1},{"lineBreak":true},{"text":"olivo ayá nuna aceitejinchakam amasaje.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja baka aidau muntsuji","poem":1},{"lineBreak":true},{"text":"ijugbau kantemtikamu aidau,","poem":1},{"lineBreak":true},{"text":"tuja uwija muntsuji ijugbau aidau","poem":1},{"lineBreak":true},{"text":"kuashat ajutjamiugme.","poem":1},{"lineBreak":true},{"text":"Tuja uwig duwejam aidau,","poem":1},{"lineBreak":true},{"text":"uwig tsakat duwejam aidau,","poem":1},{"lineBreak":true},{"text":"nuigtu cabra shiig kuashat Basán nugkanum","poem":1},{"lineBreak":true},{"text":"aijakua nuna neje yuuyugme.","poem":1},{"lineBreak":true},{"text":"Nuigtushkam trigo shiig pegkeg yuuyugme,","poem":1},{"lineBreak":true},{"text":"niniakjum uva yumiji ijugbau","poem":1},{"lineBreak":true},{"text":"kapantu umuyugme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Tujash Jesurún","poem":1},{"noteId":1},{"text":"aidautigmek kuashat tagkugtin,","poem":1},{"lineBreak":true},{"text":"kuashat ajakjintin wajasjum nunú yuwakjum duwekugme.","poem":1},{"lineBreak":true},{"text":"Imanika duweku asajum,","poem":1},{"lineBreak":true},{"text":"kuntin uduejam niina ujen winchamtin wajas pempeentuki","poem":1},{"lineBreak":true},{"text":"niina kuitamnun tukumama numamtuk","poem":1},{"lineBreak":true},{"text":"Apajuí shiwagmauwaitjume.","poem":1},{"lineBreak":true},{"text":"Apajuíyai atumi najapauwa duka.","poem":1},{"lineBreak":true},{"text":"Nunin aig atum dakitakjum idaisauwaitjume.","poem":1},{"lineBreak":true},{"text":"Apajuíyai atumin kuitamjamak uwemtijamjauwa duka.","poem":1},{"lineBreak":true},{"text":"Nunin aig atumek kajegkauwaitjume.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Atumek dakumka najanamu","poem":1},{"lineBreak":true},{"text":"aidaun Apajuí dakita nunú","poem":1},{"lineBreak":true},{"text":"emematkujum, Apajuí senchi","poem":1},{"lineBreak":true},{"text":"ikajkauwaitjume.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nuadui Apajuí emematmaina nunú","poem":1},{"lineBreak":true},{"text":"idaikujum, wainka apajuímtai aina nunú","poem":1},{"lineBreak":true},{"text":"ememattag tusajum","poem":1},{"lineBreak":true},{"text":"kuntin maajum apejakuitjume.","poem":1},{"lineBreak":true},{"text":"Atumi apachjum aajaku aina dukesh","poem":1},{"lineBreak":true},{"text":"wainajakchamu, tuja ememattanakesh","poem":1},{"lineBreak":true},{"text":"emematchaju aina nunú,","poem":1},{"lineBreak":true},{"text":"atumek yama wainmawaik emematjume.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atumek atumi Apajuíjum kuitamjamna","poem":1},{"lineBreak":true},{"text":"duka kajimatkiugme.","poem":1},{"lineBreak":true},{"text":"Apajuí pujutan amasua nunú kajimatkiugme.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu atumnak,","poem":1},{"lineBreak":true},{"text":"niina uchiji nawanji ajuminig idaitamsaje.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nuadui Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Atumek aents pegkegchau ainagme.","poem":1},{"lineBreak":true},{"text":"Atumnak kajittsa diimainchau dekapeajime.","poem":1},{"lineBreak":true},{"text":"Nunin asagmin atumnak nuigtuk yaigchattajime.","poem":1},{"lineBreak":true},{"text":"Wajukatagmek nuna dakastajime.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Atum aidautijum wainka apajuímtai","poem":1},{"lineBreak":true},{"text":"kakakchau, dekachu aina nunú emematkujum","poem":1},{"lineBreak":true},{"text":"mina kajemtijakjum akasmau etagme.","poem":1},{"lineBreak":true},{"text":"Nuadui Israel aentschau aidau","poem":1},{"lineBreak":true},{"text":"chichagmash makichkish antakchau aina","poem":1},{"lineBreak":true},{"text":"nuna wi yayaakui, atumek","poem":1},{"lineBreak":true},{"text":"kajeakjum waittsattagme.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mina kajetjua duka jiijai betek kegawai.","poem":1},{"lineBreak":true},{"text":"Iman asa ashí nugka najatamunum kegak","poem":1},{"lineBreak":true},{"text":"nugkanak ajak aidaujai apea emegkaktatui.","poem":1},{"lineBreak":true},{"text":"Nuniak muja aidaunmashkam keettawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wi atum aidautigminak ashí pegkegchau aina","poem":1},{"lineBreak":true},{"text":"nuna ishitkattajime waittsatnume tusan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dutika ai nujantai, nuigtu tsuweakjum jinattagme.","poem":1},{"lineBreak":true},{"text":"Tuja jata ishamain iyanjamag ijipattawai.","poem":1},{"lineBreak":true},{"text":"Nuigtushkam kuntin kajen aidaun,","poem":1},{"lineBreak":true},{"text":"dapi aidaun ishitkattajime.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Atumi uchijum aidauk jintá","poem":1},{"lineBreak":true},{"text":"maa aepeam agtinai.","poem":1},{"lineBreak":true},{"text":"Tuja atumi jeminia aidaushkam","poem":1},{"lineBreak":true},{"text":"senchi sapigmagtinai.","poem":1},{"lineBreak":true},{"text":"Imaaninak uchi tsakat aidau,","poem":1},{"lineBreak":true},{"text":"nuwauch tsakat aidau, múuntuch aidau,","poem":1},{"lineBreak":true},{"text":"uchi muntsu muntsuaku aidaush jinawagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Tuja wi anentaimsan, tikich nugkanum","poem":1},{"lineBreak":true},{"text":"dapampaakan utsagtajai, dutika ai","poem":1},{"lineBreak":true},{"text":"dita wegantu aidau megkaejamtai,","poem":1},{"lineBreak":true},{"text":"pachisaish augmatchatai juwaktin ati tusan anentaimsabiajai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tujash nuna dutika ai shiwag aidau","poem":1},{"lineBreak":true},{"text":"mina pegkegchau chichagtuinakui,","poem":1},{"lineBreak":true},{"text":"antutan dakitakun dutikachmaijai.","poem":1},{"lineBreak":true},{"text":"Wi dutika ai mina shiwag aidau","poem":1},{"lineBreak":true},{"text":"ememas chichainak: ‘Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"Israel aents aidaunak jiijag utsagchabi,","poem":1},{"lineBreak":true},{"text":"jutii aidauti iina senchijijai jiija utsagmaiji’,","poem":1},{"lineBreak":true},{"text":"tumain asagmatai idaisabiajai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Israel aents aidauk pegkegchau","poem":1},{"lineBreak":true},{"text":"shiig anentainkachu ainawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Atumesh shiig anentaimkau ainakjumek,","poem":1},{"lineBreak":true},{"text":"wi suwimkan amastinaitjime","poem":1},{"lineBreak":true},{"text":"tusan tiuwaitjim nunú shiig dekau amainaitjume.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Atumesh anentaimsagmesh diyagmek,","poem":1},{"lineBreak":true},{"text":"¿atumi shiwaajum aina nuwiya suntag","poem":1},{"lineBreak":true},{"text":"ima makichkitak mil suntag","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun ipisig ishiakua dusha?","poem":1},{"lineBreak":true},{"text":"¿Tuja atumi shiwaajum jimagchik suntajaitak,","poem":1},{"lineBreak":true},{"text":"diez mil suntag Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"ipisjauwa dusha?","poem":1},{"lineBreak":true},{"text":"Nunak Tuke Pujuu atumi kuitamjamna nunú,","poem":1},{"lineBreak":true},{"text":"shiwag aidau depetuk amuktinme tusa","poem":1},{"lineBreak":true},{"text":"tiu asamtai dutijamau ainawai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Iina shiwaaji aina nuna apajuímtaiji aina duka","poem":1},{"lineBreak":true},{"text":"iina Apajuíjiya nujaig betekchauwa nunak","poem":1},{"lineBreak":true},{"text":"ditak shiig dekainawai.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Dita aidauk sodomanmaya aents,","poem":1},{"lineBreak":true},{"text":"gomorranmaya aents aajaku aina","poem":1},{"lineBreak":true},{"text":"nujai betek ainawai, nuadui dita aidauk","poem":1},{"lineBreak":true},{"text":"uva pegkegchau yapau yuwa jamainun","poem":1},{"lineBreak":true},{"text":"nejemaina nujai betek ainawai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nunú vino dita umutaiji aina dushakam","poem":1},{"lineBreak":true},{"text":"dapi tsagke magkagtina nujai betek ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":["Tuja Apajuí chichaak:",{"text":"“Wi Israel aents aidaun ayamjakun","poem":1},{"lineBreak":true},{"text":"dita shiwaaji aidaun tsaiktinaitag nunak","poem":1},{"lineBreak":true},{"text":"etsegkashtatjai.","poem":1},{"lineBreak":true},{"text":"Duka makichik waji akik uukam","poem":1},{"lineBreak":true},{"text":"egkemama numamtinai.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Witjai suwimka sukagtinnuk,","poem":1},{"lineBreak":true},{"text":"nuniau asan tsawan jegakui,","poem":1},{"lineBreak":true},{"text":"wi suwimkanak susatnaitjai,","poem":1},{"lineBreak":true},{"text":"wagki nii waittsatna duka tsawantak jegawai.","poem":1},{"lineBreak":true},{"text":"Tuja nii suwimak jukitnuji umigkamua duka","poem":1},{"lineBreak":true},{"text":"tsawantak uminui”, tiuwai Apajuí.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tuke Pujuu niina aentsji aidau kakaag","poem":1},{"lineBreak":true},{"text":"ayamjumamainchaun wainu asa ayamjuktatui.","poem":1},{"lineBreak":true},{"text":"Ditan ashí amuinak aents inaku waitkatai,","poem":1},{"lineBreak":true},{"text":"tuja agkan batsamin aina nujai","poem":1},{"lineBreak":true},{"text":"amukam kakaumainchau dekapeagtai,","poem":1},{"lineBreak":true},{"text":"Apajuí wait anentug,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"chichajak: “¿Ii apajuímtaiji aina juju","poem":1},{"lineBreak":true},{"text":"ayamjutpaktatui tusajum,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"nunú emematkujum","poem":1},{"lineBreak":true},{"text":"kuntin maa apeamua nuna wiyaji yuwakjum,","poem":1},{"lineBreak":true},{"text":"umutai vino nii anagkuamu umuyujum dusha tuwi batsatua?","poem":1},{"lineBreak":true},{"text":"¡Nunú nantajag atum waitiajum nuna ayamjutpaktinme!","poem":1},{"lineBreak":true},{"text":"¡Nunú kaunawag kuitamjamkatnume!","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ima Wikitjai Apajuínuk.","poem":1},{"lineBreak":true},{"text":"Tikich Apajuík makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Witjai pujuta sukagtinnuk,","poem":1},{"lineBreak":true},{"text":"tuja wikitjai pujuta ataínnuk.","poem":1},{"lineBreak":true},{"text":"Witjai suwimka sukagtinnuk, tuja wikitjai tsagkugkagtinnuk.","poem":1},{"lineBreak":true},{"text":"¡Mina suwimkajua nuna uwemtumainuk","poem":1},{"lineBreak":true},{"text":"makichkish atsawai!","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Mina uwejun nayaimpinum takuajai,","poem":1},{"lineBreak":true},{"text":"nunikan wika Tuke Pujuu asan,","poem":1},{"lineBreak":true},{"text":"wi dutikatnujun pachisan tajai.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Mina puyagjun winchamtinun etsaka jukin,","poem":1},{"lineBreak":true},{"text":"ya aidauwa pegkegchaun takainak","poem":1},{"lineBreak":true},{"text":"mina shiwagmatuinak kajegtuinawa nuna","poem":1},{"lineBreak":true},{"text":"ijinatasan nagkamattajai.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Dutikan kuashat aentsun ijinkun","poem":1},{"lineBreak":true},{"text":"mina puyagjunak numpeagtatjai.","poem":1},{"lineBreak":true},{"text":"¡Makichkish uwemjachagtatui!","poem":1},{"lineBreak":true},{"text":"¡Shiwag ijinku nuna apuji aidau achija yajuakbau aina nunashkam ashí ijinattajai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Nuadui ashí tikich aents","poem":1},{"lineBreak":true},{"text":"judíochu aidautigmesh Apajuí aentsji aina","poem":1},{"lineBreak":true},{"text":"nujai ijunjajum dakujustajum.","poem":1},{"lineBreak":true},{"text":"Apajuí niina takajin aidau ijituamunum","poem":1},{"lineBreak":true},{"text":"atumi shiwaajum aidaunak ijinattawai.","poem":1},{"lineBreak":true},{"text":"Dutikak niina aentsji aidaunak wait anentug","poem":1},{"lineBreak":true},{"text":"ditá tudaujinak tsagkujattawai”, tiuwai.","poem":1}]},{"type":"heading","content":["Moisés inagnaku jintinkagtuamu"]},{"type":"verse","number":44,"content":["Moisés Josuéjai Israel aents aidau batsatbaunum jeganta dita antuinamunum yama nagkamchak agagbaunum nagkama kantama amukui."]},{"type":"verse","number":45,"content":["Nuna ashí kantama inagnak,"]},{"type":"verse","number":46,"content":["nuadui Israel aents aidaun chichajak: “Wi atumin jintintuajim nunú shiig antuka jukitajum. Nunikjum atumi uchijum aidau jintintuatajum, dutikawajam ditashkam chicham umiktin agagbauwa nuna ashí betek umiktinme."]},{"type":"verse","number":47,"content":["Tuja juju chicham umiktin agagbauwa nunú wainkaya nunin diyakjum umitsuk idaisaigpajum. Juju chicham umiktina nunú atumnak pujutan amawai. Nuniau asamtai, Apajuí nugka anagtamauwa nunú namak Jordágka amain awa nuwi jegagmesh, nunú umiakjum kuashat tsawan pujustinaitjume”, tiuwai."]},{"type":"heading","content":["Apajuí Moisésan Canaán nugkan wainkati tusa iwaintukbau"]},{"type":"verse","number":48,"content":["Nunú tsawantin Tuke Pujuu Moisésan wantintuk chichajak:"]},{"type":"verse","number":49,"content":["“Muja Abarim tutaya nuwi wetá, nunikam muja Nebo tutai Moab aents aidau nugken yaakat Jericójai niinis awa nuwi wakata. Nunikam, nuwi wajasam Canaán nugkan wi Israel aents aidaun susattag nunú diista."]},{"type":"verse","number":50,"content":["“Nunú mujanum wakattam nuwi amek amina yatsum Aarón Hor nugkanum jakauwa nunismek jakattame."]},{"type":"verse","number":51,"content":["Atumek yumi pukuni jiinbau Meribá-cades tutaya nuwi Israel aents aidau yumi umumain atsutai chichamjuinakui, wi nunú dutikatajum tusan uwejush Sin tutainum tiuwaitjim nunú umikchauwaitjume. Nunú nugkanum Israel aents aidau yumin sumainakui atum mina eme anenjamu ditá emtin iwainakchau ainagme."]},{"type":"verse","number":52,"content":["Nuadui wi Israel aents aidaun nugka susattag duka amek ayatak ikaa wajasam wainkattame. Tujash amek nuwig wayashtatme”, tiuwai Apajuí."]}],"footnotes":[{"noteId":1,"caller":"+","text":"“Jesurún” tawa nunak “Israel aents aidaun shiig anentus adayak” tuu adaikau ainawai.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/agr_wbt/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}