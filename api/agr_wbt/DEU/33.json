{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"DEU","translationId":"agr_wbt","name":"Deuteronomio","commonName":"Deuteronomio","title":"Chicham umiktin aidau agagbau aajakua nunúataktu pataka agagbau Deuteronomio","order":5,"numberOfChapters":19,"sha256":"bff26eba50550c0cb0366ddaadba9e81c7b466d281ce97f110f42050036fbfd9","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/agr_wbt/DEU/34.json","totalNumberOfVerses":419},"chapter":{"number":33,"content":[{"type":"heading","content":["Moisés Israel aents aidaun pegkegnum yumigjamu"]},{"type":"verse","number":1,"content":["Apajuí inake Moisés, nii jakatnuji jegamtai pujusa, Israel aents aidaun pegkegnum yumigkiak,"]},{"type":"verse","number":2,"content":["juna aatus tiuwai:",{"lineBreak":true},{"text":"“Tuke Pujuu jutijai pujustatus","poem":1},{"lineBreak":true},{"text":"muja Sinaínum tauwai,","poem":1},{"lineBreak":true},{"text":"tuja nugka Seírnum nagkamas","poem":1},{"lineBreak":true},{"text":"niina tsaaptinjig etsanjabi.","poem":1},{"lineBreak":true},{"text":"Nunik etsantug yaakat Parágnum","poem":1},{"lineBreak":true},{"text":"nagkamas uyuuntamsabi,","poem":1},{"lineBreak":true},{"text":"tuja diez mil ángel aidaujai","poem":1},{"lineBreak":true},{"text":"weak, niina uweje untsujiya","poem":1},{"lineBreak":true},{"text":"duwi chicham umiktin agagbaun takakuyi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk niina aentsji aidaunak aneawai,","poem":1},{"lineBreak":true},{"text":"tuja niinu etegjamu aidaunak kuitamui,","poem":1},{"lineBreak":true},{"text":"nunú aidau Apajuín emematuinawai,","poem":1},{"lineBreak":true},{"text":"nuninak nii umiktajum tibaun uminawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moisés chicham umiktin","poem":1},{"lineBreak":true},{"text":"Jacob wegantunum tuke asatna nuna Apajuí susamun juki amasajui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apajuík Jesurúnkan apuji wajasui.","poem":1},{"lineBreak":true},{"text":"Apajuík Israel aents aidaun apuji aidaun apuji,","poem":1},{"lineBreak":true},{"text":"tuja Israela uchiji maki","poem":1},{"lineBreak":true},{"text":"makichik wegantu aidau","poem":1},{"lineBreak":true},{"text":"ijunjajua nuna apuji wajasui”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Tuja Rubén wegantun pachis Moisés juna aatus chichajak:",{"text":"“¡Rubén wegantu aidauk tuke batsamsatin agtinai!","poem":1},{"lineBreak":true},{"text":"¡Aishmag ujumak ataish,","poem":1},{"lineBreak":true},{"text":"jinaa megkaejashtin ainawai!” tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Tuja Judá wegantun pachis Moisés juna aatus chichajak:",{"text":"“Tuke Pujuuwah, Judá wegantu","poem":1},{"lineBreak":true},{"text":"aidau amina segapainakuig antugkata.","poem":1},{"lineBreak":true},{"text":"Ataktu awagkim tikich aents","poem":1},{"lineBreak":true},{"text":"Israel wegantu aidau batsatbaunum ijumjata.","poem":1},{"lineBreak":true},{"text":"Amina senchigmijai ayamjukta, dutikakum yaigta","poem":1},{"lineBreak":true},{"text":"niina shiwaajinish ayamjumakti tusam”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Tuja Leví wegantu aidaun pachis Moisés juna aatus chichajak:",{"text":"“Tumim Urim","poem":1},{"noteId":2},{"text":"aina duka aminu ainawai.","poem":1},{"lineBreak":true},{"text":"Nunú Leví wegantu amina","poem":1},{"lineBreak":true},{"text":"sacerdotejum aidau","poem":1},{"lineBreak":true},{"text":"ame tabaun betek umigtamin","poem":1},{"lineBreak":true},{"text":"aina nunú susauwaitme.","poem":1},{"lineBreak":true},{"text":"Tuja Masá nugkanum ame dita dekapsauwaitme,","poem":1},{"lineBreak":true},{"text":"dutikakum Meribá","poem":1},{"lineBreak":true},{"text":"nugkanmashkam amina aentsjum aidau","poem":1},{"lineBreak":true},{"text":"yumi susauwaitam nuwi senchi jiyakuitme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Leví wegantu aina duka","poem":1},{"lineBreak":true},{"text":"ame chicham umiktajum tiuwaitam nuna","poem":1},{"lineBreak":true},{"text":"puyatjus uminawai, nuninak kakanmamainawai","poem":1},{"lineBreak":true},{"text":"ame chicham tibauwa nuna betek umikagtatus.","poem":1},{"lineBreak":true},{"text":"Nuna ima senchi dita patayin nagkaesau","poem":1},{"lineBreak":true},{"text":"eme anentuinawai.","poem":1},{"lineBreak":true},{"text":"Nunidau asag ditá apaji aidaun","poem":1},{"lineBreak":true},{"text":"dukuji aidaujai chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Atumnak wika dekatsjime’ tuinawai;","poem":1},{"lineBreak":true},{"text":"tuja dita yachi iwai aidaun, umayi iwai aidaun,","poem":1},{"lineBreak":true},{"text":"tsakat aidaunashkam chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Wika atumnak dekatsjime’ tuinawai;","poem":1},{"lineBreak":true},{"text":"tuja ditá uchiji aidaun nawanji aidaujai chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Dekatsjime yatsu ainajum’ tuinawai,","poem":1},{"lineBreak":true},{"text":"wagki ditak ashí Apajuí umigtan","poem":1},{"lineBreak":true},{"text":"idaisaju asagmatai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dita ainawai amina chichamem umiktin","poem":1},{"lineBreak":true},{"text":"agagbau aina nuna Jacob wegantun","poem":1},{"lineBreak":true},{"text":"jintintuina duka.","poem":1},{"lineBreak":true},{"text":"Dita ainawai kugkuin incienson","poem":1},{"lineBreak":true},{"text":"kuntin maa apeamujai jukiag,","poem":1},{"lineBreak":true},{"text":"aak pegkejam aakmakbaunum","poem":1},{"lineBreak":true},{"text":"nunú patasa apetai puja nuwi pataina nunú.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"dita amina umigtamainak","poem":1},{"lineBreak":true},{"text":"puyatjusag takaina nunú","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigsata.","poem":1},{"lineBreak":true},{"text":"Dutikakum dita shiwaaji aina","poem":1},{"lineBreak":true},{"text":"dushakam ame ijinata,","poem":1},{"lineBreak":true},{"text":"tuja ditan kajejin aina dushakam","poem":1},{"lineBreak":true},{"text":"ataktu wakitkig waitkaschatin atinme”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Tuja Benjamín wegantun pachis Moisés juna aatus chichajak:",{"text":"“Tuke Pujuuwah, amek Benjamín","poem":1},{"lineBreak":true},{"text":"wegantu aina duka aneame.","poem":1},{"lineBreak":true},{"text":"Nuadui ditak shiig aneasag batsatui.","poem":1},{"lineBreak":true},{"text":"Amek múun ashí senchigtinaitam ibau asam","poem":1},{"lineBreak":true},{"text":"tuke kuitamtinaitme.","poem":1},{"lineBreak":true},{"text":"¡Nuadui ame kuitamsam batsamsagtinai!” tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Tuja José wegantu aidaun pachis Moisés juna aatus chichajak:",{"text":"“Tuke Pujuu niina nugkenak","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigsatin ati,","poem":1},{"lineBreak":true},{"text":"dutikamu asamtai, nayaimpinmaya yumi yutak,","poem":1},{"lineBreak":true},{"text":"tuja nugka initkeniash yumi pukuni jiinainak","poem":1},{"lineBreak":true},{"text":"niina nugkenak tuke uchupsagke atinai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"José wegantu aidauk dita ajakmamujinian","poem":1},{"lineBreak":true},{"text":"maki makichik mijantin","poem":1},{"lineBreak":true},{"text":"ajak juut nantu jegatai, shiig","poem":1},{"lineBreak":true},{"text":"kuashat juuka yuwagtinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dita wegantu aidau ajakmamujig, ikam aidau,","poem":1},{"lineBreak":true},{"text":"muja aidau ayá iman aidaun juwagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja muja makichkish megkaechauwa iman tuke atinai dita ajakmamu aina duka.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dita nugkenig yujág shiig","poem":1},{"lineBreak":true},{"text":"pegkeg aidau piyaktinai.","poem":1},{"lineBreak":true},{"text":"Nuadui nii wegantu agtina","poem":1},{"lineBreak":true},{"text":"nudaushkam imanisag ajiti tusam yaigta.","poem":1},{"lineBreak":true},{"text":"Wagki ame mina zarza kegamunmaya wantintugkam,","poem":1},{"lineBreak":true},{"text":"amina aentsjum aidaun yajuak emati tusam etegtuawaitam,","poem":1},{"lineBreak":true},{"text":"dutiksamek ame Josék niina yachi iwai aidaun,","poem":1},{"lineBreak":true},{"text":"ekeu aidaun apuji ati tusam etegkauwaitme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja Efraín wegantunmayag","poem":1},{"lineBreak":true},{"text":"suntajak shiig kuashat agtinai,","poem":1},{"lineBreak":true},{"text":"tuja Manasésnumiashkam aents maanin aidauk shiig kuashat agtinai.","poem":1},{"lineBreak":true},{"text":"Nunú aina duka toro uchiji","poem":1},{"lineBreak":true},{"text":"yama nagkamchak petsakbau pegkejama iman,","poem":1},{"lineBreak":true},{"text":"búfalo senchigtinama iman agtinai.","poem":1},{"lineBreak":true},{"text":"Iman asag ashí aents tikich","poem":1},{"lineBreak":true},{"text":"nugkanmaya aidaunash, ditá","poem":1},{"lineBreak":true},{"text":"senchijijai depetkatin ainawai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Tuja Sabulón wegantun Isacar wegantujai pachis Moisés juna aatus chichajak:",{"text":"“Sabulón wegantu aidautigmek shiig aneastajum,","poem":1},{"lineBreak":true},{"text":"atumek nayantsanum yujasjum tikich nugkanum waji sujitin asajum.","poem":1},{"lineBreak":true},{"text":"Untsu Isacar wegantu aidautigmek","poem":1},{"lineBreak":true},{"text":"aakchinmak batsamsajum,","poem":1},{"lineBreak":true},{"text":"kuntin tagkumajum shiig","poem":1},{"lineBreak":true},{"text":"kuashat uyugkajum shiig","poem":1},{"lineBreak":true},{"text":"aneasjum batsamsagtinaitjume.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nunik batsamas tikich Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"ipaa mujanum yajuak iwajagtinai.","poem":1},{"lineBreak":true},{"text":"Dutikawag nuwi batsamas,","poem":1},{"lineBreak":true},{"text":"ame dutikatajum tusa timauwa nuna uminak","poem":1},{"lineBreak":true},{"text":"kuntinun maawag apeagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja nayantsanum waji pegkeg kuashat ayá","poem":1},{"lineBreak":true},{"text":"nuna tikich nugkanum yujasag sujiagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninak nayantsanmaya","poem":1},{"lineBreak":true},{"text":"yutai aidaun yuwagtinai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Tuja Gad wegantun juna aatus Moisés chichajak:",{"text":"“¡Apajuíyah, ame Gad wegantu aidauk","poem":1},{"lineBreak":true},{"text":"nugka múun susatnaitme, nuadui","poem":1},{"lineBreak":true},{"text":"amina see tujamainak emematjamtin ainawai!","poem":1},{"lineBreak":true},{"text":"Gad wegantunmaya aidauk león dakamama","poem":1},{"lineBreak":true},{"text":"numamtuk dakamak","poem":1},{"lineBreak":true},{"text":"aentsun maakug kuntujin tsupijug,","poem":1},{"lineBreak":true},{"text":"buuken tsupijug ukutnai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Israela uchiji aidau maki makichik wegantu","poem":1},{"lineBreak":true},{"text":"aina nuna apuji aidau Canaán nugkan","poem":1},{"lineBreak":true},{"text":"tesagdayagtaish, Gad wegantu aidau","poem":1},{"lineBreak":true},{"text":"ima muuntan jukitnai apu aidau juinamujai betekak.","poem":1},{"lineBreak":true},{"text":"Dita aidauk ame dutikata","poem":1},{"lineBreak":true},{"text":"timauwa nuna umikagtin ainawai.","poem":1},{"lineBreak":true},{"text":"Dita aidauk pegkegnum","poem":1},{"lineBreak":true},{"text":"chichajam agtinai, wagki","poem":1},{"lineBreak":true},{"text":"ame Israel aents aidau","poem":1},{"lineBreak":true},{"text":"umiktajum timauwa nuna umidau asag”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":["Tuja Dan wegantun Moisés juna aatus chichajak:",{"text":"“Dan wegantu aidauk león tsakat","poem":1},{"lineBreak":true},{"text":"kuntinu tsekentama nujai betekai,","poem":1},{"lineBreak":true},{"text":"iman asa niina shiwaajin jeteakug, nugka","poem":1},{"lineBreak":true},{"text":"Basánnum nagkamas tsekenti jiintawai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["Tuja Neftalí wegantu aidaun Moisés juna aatus chichajak:",{"text":"“Neftalí wegantu aidaunak Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"shiig anentus diyawai,","poem":1},{"lineBreak":true},{"text":"Ame Apajuíyah, ditak kuashat","poem":1},{"lineBreak":true},{"text":"pegkeg aidaunum yumigsauwaitme.","poem":1},{"lineBreak":true},{"text":"¡Nuadui kucha múun Galilea tutaya duka","poem":1},{"lineBreak":true},{"text":"nujinum nagkamas tsumujiya","poem":1},{"lineBreak":true},{"text":"aatus ditanu atinai!” tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Tuja Asher wegantu aidaun Moisés juna aatus chichajak:",{"text":"“Apajuíyah, ame Aserak Jacopa uchiji","poem":1},{"lineBreak":true},{"text":"tikich aina nuna nagkaesau","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigsata.","poem":1},{"lineBreak":true},{"text":"Dutikamu asamtai, niina yachi aidau","poem":1},{"lineBreak":true},{"text":"eme anentsa diitai ati.","poem":1},{"lineBreak":true},{"text":"Tuja kuashat olivogtin asa","poem":1},{"lineBreak":true},{"text":"aceitejishkam imanisag ajitin ati.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Niina yaaktaji aidauk,","poem":1},{"lineBreak":true},{"text":"tuja jee aidaushkam kuashat waitigtin atinai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú waiti aidauk jiju hierro,","poem":1},{"lineBreak":true},{"text":"bronce aina nujai najanamu asamtai,","poem":1},{"lineBreak":true},{"text":"niina shiwaajish kakajus utumainchau atinai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Jesurúman Apajuíji atumin","poem":1},{"lineBreak":true},{"text":"yaimpaktatus niina senchijijai yujagminum","poem":1},{"lineBreak":true},{"text":"egkemak minina imanuk tikichik atsawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Apajuí Tuke Pujuuwa nunuwai","poem":1},{"lineBreak":true},{"text":"amina ayamjumataigmek.","poem":1},{"lineBreak":true},{"text":"Niig tuke senchigtina iman asa amina yaimpawai.","poem":1},{"lineBreak":true},{"text":"Ame wainminig amina shiwajumnak","poem":1},{"lineBreak":true},{"text":"uwakek ipisiak ijinata tusa amina inapawai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Israelak ishamkagtutsuk kajinas pujustinai.","poem":1},{"lineBreak":true},{"text":"Nii wegantu aidaushkam agkan","poem":1},{"lineBreak":true},{"text":"utugchat atsaunum batsamsatin ainawai.","poem":1},{"lineBreak":true},{"text":"Niina nugke aidaunmash trigo aidauk","poem":1},{"lineBreak":true},{"text":"shiig kuashat aitnai, tuja uva ajakmaushkam","poem":1},{"lineBreak":true},{"text":"imanisag aitnai, tuja yumishkam tuke","poem":1},{"lineBreak":true},{"text":"yutitnai, nuniau asamtai, yuminak atsumchatnai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¡Israel aents aidautigmek","poem":1},{"lineBreak":true},{"text":"shiig aneastajum, wagki atum","poem":1},{"lineBreak":true},{"text":"kuashat asajum eme anentai ainajum","poem":1},{"lineBreak":true},{"text":"imanuk tikich aents aidauk atsawai!","poem":1},{"lineBreak":true},{"text":"Atumnak Tuke Pujuuwa nunú uwemtijamjaugme.","poem":1},{"lineBreak":true},{"text":"Nii atumnak kuitamjamui.","poem":1},{"lineBreak":true},{"text":"Tuja nigki ayamjutpaktatui.","poem":1},{"lineBreak":true},{"text":"Atumi shiwaajum aidaujai maaniagminish,","poem":1},{"lineBreak":true},{"text":"niyai depetmitkagbauk.","poem":1},{"lineBreak":true},{"text":"Nuadui shiwag aidauk atumiin yunumjagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninakui atum wagagkijum","poem":1},{"lineBreak":true},{"text":"ijinatin ainagme”, tiuwai Moisés.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“Tumim, Urim”: Juka makichik wajich najanamu aajakui, nuna sacerdote Apajuíjai chichastatus wayak jujaku ainawai. Nujai dekajakajui Apajuí wakegamush tukita nuna.","reference":{"chapter":33,"verse":8}}]},"thisChapterLink":"/api/agr_wbt/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}