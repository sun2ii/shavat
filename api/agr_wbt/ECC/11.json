{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ECC","translationId":"agr_wbt","name":"Eclesiastés","commonName":"Eclesiastés","title":"Juninai pujutak Eclesiastés","order":21,"numberOfChapters":4,"sha256":"af3cf21779d68673c800dc74cc57d5c854f7eff6f11a2e70b8b3108134af2708","firstChapterNumber":3,"firstChapterApiLink":"/api/agr_wbt/ECC/3.json","lastChapterNumber":12,"lastChapterApiLink":"/api/agr_wbt/ECC/12.json","totalNumberOfVerses":42},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Aents yapajau wainkumek, yutai susata yuwati.","poem":1},{"lineBreak":true},{"text":"Nunú dutikau asam,","poem":1},{"lineBreak":true},{"text":"makichik tsawantai ameshkam dutiksaik iikuam atatme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aminu ajutjama duka anetu pujutsuk ajamasta,","poem":1},{"lineBreak":true},{"text":"wagki amek dekatsme","poem":1},{"lineBreak":true},{"text":"waji utugchatak juju nugka","poem":1},{"lineBreak":true},{"text":"juwish nagkaemakti duka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yujagkim bukusea weakug yumi yutak nuniawai.","poem":1},{"lineBreak":true},{"text":"Numi katugak nujinum, tuja nuniachkush","poem":1},{"lineBreak":true},{"text":"tsumunmagkesh iyakug tuwi iyaje, nuwig tepestinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ajakmatasa wakegakmek dase dii pujuipa;","poem":1},{"lineBreak":true},{"text":"tuja ajak ajakmamu juuktag takumek","poem":1},{"lineBreak":true},{"text":"nayaim dii pujuipa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Dase dasenkash itug weawaki nunú dekatsum numamtuk, tuja uchish wajuk najaneawaki dusha dekatsum numamtuk, Apajuí ashí najankauwa nunash wajuk dutikaukita duka dekatsme."]},{"type":"verse","number":6,"content":["Kashikmasam ajakmata, tuja agkushkam ajakmata, wagki yama nagkamchaku ajaamua nunuwash ima shiig nejekat, atsa, ukuunum ajamua nunuwash ima shiig nejekat, aatsa nuniachkush mai betekash nejekat duka dekamainchau asamtai."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":6}