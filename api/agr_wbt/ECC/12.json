{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ECC","translationId":"agr_wbt","name":"Eclesiastés","commonName":"Eclesiastés","title":"Juninai pujutak Eclesiastés","order":21,"numberOfChapters":4,"sha256":"af3cf21779d68673c800dc74cc57d5c854f7eff6f11a2e70b8b3108134af2708","firstChapterNumber":3,"firstChapterApiLink":"/api/agr_wbt/ECC/3.json","lastChapterNumber":12,"lastChapterApiLink":"/api/agr_wbt/ECC/12.json","totalNumberOfVerses":42},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Eke múuntuch wetsuk yamai datsauchitam duik","poem":1},{"lineBreak":true},{"text":"Apajuí amina najapauwa nunú aneaku ata.","poem":1},{"lineBreak":true},{"text":"Tuja tsawan waitiamu jegamtai,","poem":1},{"lineBreak":true},{"text":"ame chichaakum:","poem":1},{"lineBreak":true},{"text":"“Kuashat tsawan waitu pujutak shiig awajtatsui”,","poem":1},{"lineBreak":true},{"text":"titinaitme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eke etsa, nantu, yaya aidau","poem":1},{"lineBreak":true},{"text":"etsanbaujin kajinainatsaig,","poem":1},{"lineBreak":true},{"text":"amina najapauwa nunú adeagta.","poem":1},{"lineBreak":true},{"text":"Tuja yumi yutug nagkankamunum","poem":1},{"lineBreak":true},{"text":"yujagkim wajas awa duik adeagta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja tsawan jegattawai","poem":1},{"lineBreak":true},{"text":"apu pujusa inamtain kuitamin aidau","poem":1},{"lineBreak":true},{"text":"ishamkagtuinak kujainamu.","poem":1},{"lineBreak":true},{"text":"Tuja aents wajiu aidaush","poem":1},{"lineBreak":true},{"text":"ishamkagtuinak tikishmasua waigkagtatui;","poem":1},{"lineBreak":true},{"text":"tuja trigo dekeen aidaushkam ujumchik asag","poem":1},{"lineBreak":true},{"text":"dekeetnak idaisagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja jeganum niimtai ujaimunum niimin aidaushkam","poem":1},{"lineBreak":true},{"text":"wainmamainchau wajasagtatui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunú tsawan jegamtaig,","poem":1},{"lineBreak":true},{"text":"waiti aidauk ashí epenjamu atatui.","poem":1},{"lineBreak":true},{"text":"Tuja trigon dekeenak","poem":1},{"lineBreak":true},{"text":"tatagmitkamushkam itatjagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninai untsu pishak shinuinamu senchi antuetinai.","poem":1},{"lineBreak":true},{"text":"Untsu ame kantabaugmek","poem":1},{"lineBreak":true},{"text":"shiig antumainchau initak kujakjatu antuetinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunú tsawan jegakuig","poem":1},{"lineBreak":true},{"text":"nainnum wamu ishamtinaitme.","poem":1},{"lineBreak":true},{"text":"Tuja iyajaig tusamshakam ishamtinaitme.","poem":1},{"lineBreak":true},{"text":"Tuja almendro yagkujamu nagkamnattawai,","poem":1},{"lineBreak":true},{"text":"tuja amina iyashmek makichkish","poem":1},{"lineBreak":true},{"text":"atsumchattame, ayatak manchi pakaemag","poem":1},{"lineBreak":true},{"text":"nanapjug nanaak wegama numamtuk","poem":1},{"lineBreak":true},{"text":"atasam duke dakattame.","poem":1},{"lineBreak":true},{"text":"Nunú jegakuig amek ataktu wakitki","poem":1},{"lineBreak":true},{"text":"tashtinnum wetinaitme,","poem":1},{"lineBreak":true},{"text":"nunikamin aents aidau ame jakamin","poem":1},{"lineBreak":true},{"text":"buutuinak agá tuwagtamkagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui amina pujutjum","poem":1},{"lineBreak":true},{"text":"plata najanamui anaa emetuamua","poem":1},{"lineBreak":true},{"text":"numamtina nunú eke tsujintsaig,","poem":1},{"lineBreak":true},{"text":"tuja ichinak oro najanamu tsaintsu duik,","poem":1},{"lineBreak":true},{"text":"tuja nuigtushkam ichinak yumi shikitaiya","poem":1},{"lineBreak":true},{"text":"nunú eke tsainak ajapnatsaig,","poem":1},{"lineBreak":true},{"text":"yamaya juwik Apajuí amina najapauwa nunú","poem":1},{"lineBreak":true},{"text":"kajimattsuk umigkata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nunú tsawan jegamtaig,","poem":1},{"lineBreak":true},{"text":"amina iyashmek nugka yukukuntu wajastinai,","poem":1},{"lineBreak":true},{"text":"wagki amek nugka yukukuntu juki najanamu asam.","poem":1},{"lineBreak":true},{"text":"Untsu wakanik Apajuíyai wakitkittawai,","poem":1},{"lineBreak":true},{"text":"wagki nii amasbau asa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wi Apajuí chichamen etsegnun juna ataktu tajai:","poem":1},{"lineBreak":true},{"text":"“¡Juju pujuta juwig iman pegkejak","poem":1},{"lineBreak":true},{"text":"makichkish atsawai!","poem":1},{"lineBreak":true},{"text":"¡Ashí wainak ainawai!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}