{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ECC","translationId":"agr_wbt","name":"Eclesiastés","commonName":"Eclesiastés","title":"Juninai pujutak Eclesiastés","order":21,"numberOfChapters":4,"sha256":"af3cf21779d68673c800dc74cc57d5c854f7eff6f11a2e70b8b3108134af2708","firstChapterNumber":3,"firstChapterApiLink":"/api/agr_wbt/ECC/3.json","lastChapterNumber":12,"lastChapterApiLink":"/api/agr_wbt/ECC/12.json","totalNumberOfVerses":42},"chapter":{"number":3,"content":[{"type":"heading","content":["Ashí waji nagkaema nunak maki makichik tsawanji ajuinawai"]},{"type":"verse","number":1,"content":["Juju nugkanum ashí waji aidau nagkaemaina duka tsawanji mamiktuamu ainawai:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tsawan jegawai akiinbau,","poem":1},{"lineBreak":true},{"text":"tuja jamu, ajak ajakmamu,","poem":1},{"lineBreak":true},{"text":"nunú ajakmamu nejekmatai juwaamu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsawan jegawai aents maamu,","poem":1},{"lineBreak":true},{"text":"tuja aents jakui tsuwamu,","poem":1},{"lineBreak":true},{"text":"yaakat tsayamu,","poem":1},{"lineBreak":true},{"text":"tuja yaakat tsaikbau ataktu yaaktabau jegawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja buuttinush tsawan jegawai,","poem":1},{"lineBreak":true},{"text":"tuja shiig aneaku dushiamush,","poem":1},{"lineBreak":true},{"text":"jakamunum buutku wake besemag pujamush,","poem":1},{"lineBreak":true},{"text":"tuja jiistamatnush tsawan jegawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsawan jegawai kaya yajuaka utsamu,","poem":1},{"lineBreak":true},{"text":"kaya utsagbau yajuaka ijubau;","poem":1},{"lineBreak":true},{"text":"shiig anendaiku pagkuniamu,","poem":1},{"lineBreak":true},{"text":"tuja kanaamu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsawan jegawai kuichik juwamu,","poem":1},{"lineBreak":true},{"text":"tuja takatsuk wainka pujamu,","poem":1},{"lineBreak":true},{"text":"ii takasa jukimu anetamu,","poem":1},{"lineBreak":true},{"text":"tuja ii anettsamu utsamu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsawan jegawai jáanch ichiamu,","poem":1},{"lineBreak":true},{"text":"nunú ichigbau apigbau,","poem":1},{"lineBreak":true},{"text":"chichatsuk pujamu,","poem":1},{"lineBreak":true},{"text":"tuja tsawan jegawai chichaamu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsawan jegawai aneeniamu,","poem":1},{"lineBreak":true},{"text":"kajegdayamu, maaniamu,","poem":1},{"lineBreak":true},{"text":"maanitsuk agkan shiig pujamu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Aents senchi takak waitia dusha ¿waji pegkegna juwawa?"]},{"type":"verse","number":10,"content":["Tuja Apajuí aents aidaunak takainak batsamsatnume tusa, kuashat takatan susauwa nuna anentaimsan ejemaijai."]},{"type":"verse","number":11,"content":["Tuja Apajuí juju nugkan najanauwa duwi nagkamas, aentsnak shiig pegkejan najanauwai. Dutika unuimatan susauwai, atakea duish wajig nagkaemajagtinaita nuna dekatnume tusa. Tujash dutikamaitak, aents aidauk Apajuí yama nagkamchak najankauwa nunak shiig dekamainchau dekapenawai."]},{"type":"verse","number":12,"content":["Nuadui wika dekajai dekas aentsuk eke iwaku puja duik, pegkejan takak shiig aneas pujumainai."]},{"type":"verse","number":13,"content":["Tuja ii yutai aidau yuwaku, umutai umag duka ii takasa jukimunmaya dutikaji, wagki Apajuí nunak amasu asamtai."]},{"type":"verse","number":14,"content":["Tuja nuigtushkam dekajai ashí Apajuí najankamu aina duka tuke asatna nunak:",{"text":"Nii najankamua duka","poem":1},{"lineBreak":true},{"text":"nuwi ekekaik makichkish najanmaitsui,","poem":1},{"lineBreak":true},{"text":"tuja emegkautkesh emegkaumaitsui.","poem":1},{"lineBreak":true},{"text":"Nunak Apajuí dutikauwai,","poem":1},{"lineBreak":true},{"text":"wagki niina senchijin dekaatnume tau asa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ashí yamai ayá duka yaunchuk aijakua nunuwai,","poem":1},{"lineBreak":true},{"text":"tuja atakea duwi agtina dushakam","poem":1},{"lineBreak":true},{"text":"yamai ayá nunuwai.","poem":1},{"lineBreak":true},{"text":"Tuja yaunchuk nagkaemajua nunak","poem":1},{"lineBreak":true},{"text":"Apajuí ataktu nunikti tusa tima ataktu wantinui.","poem":1}]},{"type":"heading","content":["Aents jakug nugka yukukuntu najaneawai."]},{"type":"verse","number":16,"content":[{"text":"Juju nugkanmak apu aidauwap shiig takasagtatua","poem":1},{"lineBreak":true},{"text":"tusa eme anentamaitak,","poem":1},{"lineBreak":true},{"text":"ima pegkegchaunak takainak","poem":1},{"lineBreak":true},{"text":"aentsun waitkaina nuna","poem":1},{"lineBreak":true},{"text":"anentaimsan ejemaijai.","poem":1}]},{"type":"verse","number":17,"content":["Nuadui Apajuí aents aidaunak tsawan jegatna duwi pegkejan takasunash pegkegchaun takasujai mai apatuk dekajuatnai."]},{"type":"verse","number":18,"content":["Tuja nuigtushkam aentsu pujutjig kuntinu pujutijaig betekmamtina nuna Apajuí ditan dekamtikaun anentaimsan ejemaijai."]},{"type":"verse","number":19,"content":["Shiig anentaimsa diyamak, aents aidaush, tuja kuntin aidaush mayattaiji betek ajamu asag, tsawanji jakatin jegagmak betek jainawai. Wagki juju nugka juwi pujutak aajayai."]},{"type":"verse","number":20,"content":[{"text":"Ashí iwaku aina duka betek jainawai.","poem":1},{"lineBreak":true},{"text":"Nunikag nugka yukukuntui najanamu asag,","poem":1},{"lineBreak":true},{"text":"nunisag ataktu nugka yukukuntu wajasagtinai.","poem":1}]},{"type":"verse","number":21,"content":["¿Ya tumainaita, aentsu wakanig yakí nayaimpinum weawai, nuniai untsu kuntinu wakani nugka initken akaewai tusash?"]},{"type":"verse","number":22,"content":["Untsu jaka ajin inantamki, atakea duish wajig nagkaemakinta nuna iwaintugmamainuk makichkish atsawai. Nuadui ii takasa juwamua duwi ii wakegamu takaku shiig aneasa pujumainun anentaimsan ejemaijai, wagki iik nuni takas pujusti tibau ainaji."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ECC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}