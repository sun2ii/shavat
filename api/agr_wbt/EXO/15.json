{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"EXO","translationId":"agr_wbt","name":"Éxodo","commonName":"Éxodo","title":"Jiinjamu Éxodo","order":2,"numberOfChapters":25,"sha256":"f736a4aa9b0f301b6fb8188e020d77683cef3959a05dc0b23ada5af8ee6ffd0a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/agr_wbt/EXO/40.json","totalNumberOfVerses":629},"chapter":{"number":15,"content":[{"type":"heading","content":["Moisés Tuke Pujuun emematak kantamamu"]},{"type":"verse","number":1,"content":["Tuke Pujuu ayamjuka uwemtikjam, Moisés nii wegantu Israel aents aidaujai Niina emematuinak juna aatus kantamawajui:",{"lineBreak":true},{"text":"“Tuke Pujuun, eme anentsan kantamjuatjai,","poem":1},{"lineBreak":true},{"text":"wagki niina senchijin ashí depetmak,","poem":1},{"lineBreak":true},{"text":"shiwag caballojin entsatkau aidaun","poem":1},{"lineBreak":true},{"text":"nayantsanum ijinau asamtai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuke Pujuu minak senchimtijawai,","poem":1},{"lineBreak":true},{"text":"niyai mina ayamjumataijuk,","poem":1},{"lineBreak":true},{"text":"nuadui wika niina kantamjajai.","poem":1},{"lineBreak":true},{"text":"Niiyai dekas mina Apajuíjuk,","poem":1},{"lineBreak":true},{"text":"nuadui shiig aneasan ememattatjai.","poem":1},{"lineBreak":true},{"text":"Niiyai dekas mina apajun Apajuíji,","poem":1},{"lineBreak":true},{"text":"nuadui wika tuke niina etsagjatnaitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwa nunuwai dekas maanitan yachak.","poem":1},{"lineBreak":true},{"text":"Niina daajig dekas Tuke Pujuu tutayai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Faraógka carrojinak, ashí niina suntaji aidaujai,","poem":1},{"lineBreak":true},{"text":"nuigtu suntaja apuji dekas yacha etegjamu","poem":1},{"lineBreak":true},{"text":"aidaunashkam Tuke Pujuu nayantsanum aepá ijinae.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuadui ditak nayantsa kunajin","poem":1},{"lineBreak":true},{"text":"shiig initak kayajai betek tepeawaje.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina senchigmijai iina shiwaajig ijinamume,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amina senchigmijai, shiwaajum aidauk depetnaitme.","poem":1},{"lineBreak":true},{"text":"Iman asam ame kajekbaugmin chijichi kagaku","poem":1},{"lineBreak":true},{"text":"apemaina numamtuk ijina emegkagmaume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ame dase awemamu nayantsan umpui jimaituk akankae.","poem":1},{"lineBreak":true},{"text":"Dutikamu asa yaakat peejamua iman wajasmae.","poem":1},{"lineBreak":true},{"text":"Nayantsa initkenish yumik buchittsuk asae.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Iina shiwaaji anentaimas:","poem":1},{"lineBreak":true},{"text":"‘¡Pataetukagmi! Dutika amainagkaja","poem":1},{"lineBreak":true},{"text":"ijinku wajiji yajutka tinamdaekagmi’ tiaje.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tujash ame dase senchi dasenmikakam","poem":1},{"lineBreak":true},{"text":"nayantsa ejapeen aepá emegkakmaume.","poem":1},{"lineBreak":true},{"text":"Nuadui plomo ajugkam tepegama numamtuk tepeawagmae.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“¡Chah, Tuke Pujuuwah!","poem":1},{"lineBreak":true},{"text":"¡Aents aidau apajuímtaiji aina duka kuashtai!","poem":1},{"lineBreak":true},{"text":"¿Tujash amejai betek amainush tikichish aintash?","poem":1},{"lineBreak":true},{"text":"¡Ima ameketme pegkejam muunmek!","poem":1},{"lineBreak":true},{"text":"¡Ameketme ashí senchigtinmek!","poem":1},{"lineBreak":true},{"text":"¡Ameketme wainchatai aidau","poem":1},{"lineBreak":true},{"text":"ishamain iwainam ibaumek!","poem":1},{"lineBreak":true},{"text":"¡Ameketme ememattaimek!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amina senchijum iwainakume, dutikawamin","poem":1},{"lineBreak":true},{"text":"nugka ujani egiptunmaya aidaunak kujag emegkaje.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amek amina aentsjum aidau","poem":1},{"lineBreak":true},{"text":"shiig senchi aneau asam,","poem":1},{"lineBreak":true},{"text":"amina senchigmin uwemtikjaume;","poem":1},{"lineBreak":true},{"text":"nuadui amina senchigminig uyunkagtusam ekagtame","poem":1},{"lineBreak":true},{"text":"nugka pegkeg anagkagtuawaitam","poem":1},{"lineBreak":true},{"text":"nuwi jegatnume tusam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Juna aents tikich nugkanmaya aidau antukag","poem":1},{"lineBreak":true},{"text":"senchi ishamainak kujainiagtatui;","poem":1},{"lineBreak":true},{"text":"tuja filisteo aidaushkam sapigmainak najaimaku","poem":1},{"lineBreak":true},{"text":"wajukmaina numamtuk tuni tunija iyainiagtatui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja Edom nugkanmaya suntaja apuji aidauk, ishamkag wakan wajasagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja Moab nugka apuji aidaushkam","poem":1},{"lineBreak":true},{"text":"ishamainak kujainiagtatui.","poem":1},{"lineBreak":true},{"text":"Nuninai Canaán nugkanum batsamin aidaushkam","poem":1},{"lineBreak":true},{"text":"ishamkag wainkauch dekapmamiagtinai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"aatus sapigmainak anentaimjatnume!","poem":1},{"lineBreak":true},{"text":"Amina senchijum iwainam juna dekainak","poem":1},{"lineBreak":true},{"text":"kaya buchitmainchauwa nunin wajastinme,","poem":1},{"lineBreak":true},{"text":"nunikmatai amina aentsjum ame uwemtijamu","poem":1},{"lineBreak":true},{"text":"aina juka ame nugka anagkuawaitam","poem":1},{"lineBreak":true},{"text":"nuwi shiig utsaanatnume.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"jukagtukim aminu atin muja etegkamua","poem":1},{"lineBreak":true},{"text":"nuwi pujustinme tusam ejekagtuata!","poem":1},{"lineBreak":true},{"text":"¡Ame nuwi pujustinme tusam etegkauwaitme,","poem":1},{"lineBreak":true},{"text":"tuja duka amina jem ame pujustin emtikam umikuitme!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amek yamaish, kashinish, ajumaya duish","poem":1},{"lineBreak":true},{"text":"tuke inama pujutnaitme!” tiuwai.","poem":1}]},{"type":"heading","content":["María kantamamu"]},{"type":"verse","number":19,"content":["Faraógka carroji maanitai aidaunum, caballo maanitai aidaunum suntag aidau pekamiag nayants buku wajasmatai utsaanawag shimuidaun, Tuke Pujuu yumin awakeak yutua emegkajui. Tujash Israel aents aidauk bukunum shiig katiajajui."]},{"type":"verse","number":20,"content":["Nunikagmatai Tuke Pujuu chichamen etsegtin María, Aarógka umayi, panderetan juki awatak kantamtai, ashí nuwa aidauk ditashkam panderetan awaituinak nantsemaidau."]},{"type":"verse","number":21,"content":["Imaniagtai María ditajai ijunag kantamak:",{"text":"“¡Tuke Pujuu eme anentsajum kantamjuatajum,","poem":1},{"lineBreak":true},{"text":"shiwag caballonum maanin aidau entsatkau minidaun","poem":1},{"lineBreak":true},{"text":"nayantsanum aepá ijinak depetmaku asamtai!”","poem":1},{"lineBreak":true},{"text":"waja wajas kantamu.","poem":1}]},{"type":"heading","content":["Yumi yapaunum jegamu"]},{"type":"verse","number":22,"content":["Moisés nii wegantu Israel aents aidaujai nayants kajis ain tutainum batsatu juwakiag, uwejush Shur tutainum kampatum tsawan yumi atsamunum shimu batsatu."]},{"type":"verse","number":23,"content":["Nunik shima shimakua yumi aunum jegawajui, tujash nunú yumik yapau asamtai uwagchajui. Nuadui nunú nugka daajinak “Mará”",{"noteId":9},"adaikajui."]},{"type":"verse","number":24,"content":["Nuadui Israel aents aidau, Moisésa kajejuk pegkegchaun chichajuinak: “¿Yamaish iish wajig uwagtaji?” tusa imatjuinau."]},{"type":"verse","number":25,"content":["Imatjuinam Moisés Tuke Pujuu yainkati tusa segauwai. Tusa segam, Tuke Pujuu Moisésan inaktusui numi uchuchiji wajaun. Nuna Moisés tsupik juki yuminum ajugkui, dutikam yumi sakam pegkeg wajasui. Tuja nunú nugkanum Tuke Pujuu ditan dekapsauwai, dutika nuadui dita chicham umikagtinun susauwai."]},{"type":"verse","number":26,"content":["Dutika chichajak: “¡Wi Tuke Pujuu atumi Apajuígmetag nunú tabau puyatjusa antukjum wi wakegamu takakjum, chicham umiktinun wi amasuitjim nunú betek umiakjuminig, egiptunmaya aidaun jata awetiuwaitag dutikanuk atumnak makichkish awetishtatjime! ¡Witjai Tuke Pujuu atumi etsagaumainnuk!” tiuwai."]},{"type":"verse","number":27,"content":["Tusa tiajam shimui shimuinakua Elim tutainum, doce yumi pukuni jiinu, nuigtu setenta palmera aidau ijununum jegawajui, nunikag pukuni jiinainamunum ayaumas aakmajag batsamsajui."]}],"footnotes":[{"noteId":9,"caller":"+","text":"“Mará” tawa nunak hebreo chichamnumak “yapau” taku tawai.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/agr_wbt/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}