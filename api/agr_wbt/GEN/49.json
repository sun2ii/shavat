{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"GEN","translationId":"agr_wbt","name":"Génesis","commonName":"Génesis","title":"Nagkamnamu Génesis","order":1,"numberOfChapters":50,"sha256":"b81e2955cd7383d0aedfb7ec1cd801c7837ace044dfda4d9390b07b188451225","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/agr_wbt/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":49,"content":[{"type":"heading","content":["Jacob jakattak tepesa chichakbau"]},{"type":"verse","number":1,"content":["Nuna tusa ashimak niina uchiji aidaun untsuka ikaunman chichajak:",{"text":"“Juwi tantatajum, nunikagmin","poem":1},{"lineBreak":true},{"text":"atakesh wajukatnuk ainagme","poem":1},{"lineBreak":true},{"text":"nuna pachisan ujaktajime:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Jacopan uchiji aidauwah,","poem":1},{"lineBreak":true},{"text":"juwi tanta ijuntsajum","poem":1},{"lineBreak":true},{"text":"atumin apa Israel tawa nunú antuktajum!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Rubénkah, ametme mina uchig iwaimek,","poem":1},{"lineBreak":true},{"text":"wi aminak nagkamchakun datsa asan akiauwaitjame,","poem":1},{"lineBreak":true},{"text":"nuadui amek ajantusa diitai senchigtin wajasuitme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tujash imankek achatnaitme,","poem":1},{"lineBreak":true},{"text":"shiig emetja anentaimchau,","poem":1},{"lineBreak":true},{"text":"yumi tsukati waketama nujai betek asam,","poem":1},{"lineBreak":true},{"text":"tuja mina eme anenjusa diigchau asam,","poem":1},{"lineBreak":true},{"text":"mina duwagjaish ikagmakuitam nuadui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simeógkak niina yachi Levíjai","poem":1},{"lineBreak":true},{"text":"betek ajankachu ishamain ainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Ajumaish wika atumjai ijunja pujutnak dakitajai!","poem":1},{"lineBreak":true},{"text":"wagki atumi kajetinig aents aidau maakjum,","poem":1},{"lineBreak":true},{"text":"kuntinu kagkajish kupijajum uku yujau aidau asagmin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Atumek pegkegchau, dekas shiig pegkegchau!","poem":1},{"lineBreak":true},{"text":"Atumi kajetjumik kuntin ikamia kajena ibauwai.","poem":1},{"lineBreak":true},{"text":"¡Nuadui wi atumnak ashí Israel nugkanum dapampaaktinaitjime!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Untsu Judá aminak, yatsum aidauk","poem":1},{"lineBreak":true},{"text":"pempeentugmakiag emematjamtin ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui yatsumin waitkaidaush","poem":1},{"lineBreak":true},{"text":"ame depetkam ayamjuktinaitme,","poem":1},{"lineBreak":true},{"text":"tuja amina yatsum aidau","poem":1},{"lineBreak":true},{"text":"emematjamainak tikishmatjamiagtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Judá, mina uchijuh!","poem":1},{"lineBreak":true},{"text":"Amek leónka uchijijai betekaitme.","poem":1},{"lineBreak":true},{"text":"León nejen yuwa ejemag wajas","poem":1},{"lineBreak":true},{"text":"tsuntsuma ayamak múuntsukaitai tumain","poem":1},{"lineBreak":true},{"text":"nugka tepegama numamtuk atinaitme.","poem":1},{"lineBreak":true},{"text":"¿Yaki aminash imanminash waitkagmasti?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Makichkish Judá senchijinak atankichagtinai,","poem":1},{"lineBreak":true},{"text":"tuja nii apu wee inabaujinashkam.","poem":1},{"lineBreak":true},{"text":"Untsu niina nagkaesau dekas apu taamtai,","poem":1},{"lineBreak":true},{"text":"nuna ashí aents aidau niina chichamen","poem":1},{"lineBreak":true},{"text":"umijuinak wedau asagmatai ukuktinaitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niina burrojinash uva numijin","poem":1},{"lineBreak":true},{"text":"tuja uva daekjinig jigkatnai, dutikak niina jáanchjinash","poem":1},{"lineBreak":true},{"text":"¡vino uva yumiji najanamua duwik nijatnai!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niina jiig uva yumiji vino bukuseaya","poem":1},{"lineBreak":true},{"text":"aan nagkaemas bukuseayai; tuja niina naíshkam","poem":1},{"lineBreak":true},{"text":"leche pujua aan nagkaemas pujui.","poem":1},{"noteId":34}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Sabulógkak nayantsanum uwet","poem":1},{"lineBreak":true},{"text":"dekas lancha múun aidau anumtaiji aidaunum pujustinai.","poem":1},{"lineBreak":true},{"text":"Tuja niina nugke nagkatkamuk","poem":1},{"lineBreak":true},{"text":"Sidón nugka aatus atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isacarak burro senchigtin kijinun yanau,","poem":1},{"lineBreak":true},{"text":"niina wenuken waya tepesa dakimakug","poem":1},{"lineBreak":true},{"text":"inanmainchawama numamtinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Niig nugka pegkeg ayamainjin wainak","poem":1},{"lineBreak":true},{"text":"nuna tsuntsumtitnai niina tuntupen kijinun patai jukitatus,","poem":1},{"lineBreak":true},{"text":"nuniak chichamjumatsuk tikima wainka","poem":1},{"lineBreak":true},{"text":"tikichi inatai atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Dagkak Israel wegantu aidaujai betek","poem":1},{"lineBreak":true},{"text":"nii wegantu aidaun apuji atinai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dagkak dapi jintá dakamak tepes","poem":1},{"lineBreak":true},{"text":"caballo minittaman sagkannum esai","poem":1},{"lineBreak":true},{"text":"ajiyama iman atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“¡Chah Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"uwemtijugti tusan amina dakajame!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gaadnak shiwag aidau jetetnai,","poem":1},{"lineBreak":true},{"text":"tujash nii wajantak depetuk ipistinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Asera nugkeg shiig pegkeg asamtai,","poem":1},{"lineBreak":true},{"text":"yutai aidauk pegkeg shiig kuashat ajitnai,","poem":1},{"lineBreak":true},{"text":"iman asamtai nuwiyan apunashkam tuké sutinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Neftalík japa agkan wekagas","poem":1},{"lineBreak":true},{"text":"uchijin shiig pegkejuch aidaun petsama numamtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Josék numi namaka uwet wajas","poem":1},{"lineBreak":true},{"text":"shiig kagkapena kanawe múun waig","poem":1},{"lineBreak":true},{"text":"senchi nejegama imanai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nagki akenin aidau kajejuinawai,","poem":1},{"lineBreak":true},{"text":"nuniak nagki aketuinawai,","poem":1},{"lineBreak":true},{"text":"dutikainak tuké waitkainawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tujash José kuntujig senchi wajaknai,","poem":1},{"lineBreak":true},{"text":"iman asa tuke depetmawai.","poem":1},{"lineBreak":true},{"text":"¡See kuashat Jacopa Apajuíji senchigtinuh!","poem":1},{"lineBreak":true},{"text":"¡Apajuí Israelan kuitamna nuna daajin see kuashat!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¡See kuashat, Apajuí amina apa Apajuíjiya nunú yaimpakti;","poem":1},{"lineBreak":true},{"text":"Apajuí dekas ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"aminak pegkegnum yumigtamsatin ati!","poem":1},{"lineBreak":true},{"text":"¡Nayaimpinmaya pegkeg jutai aina nuwiyanash!","poem":1},{"lineBreak":true},{"text":"¡Nayantsa initkenia pegkeg jutai aina nuwiyanash!","poem":1},{"lineBreak":true},{"text":"Tuja ¡uchi akia shiig tsakapaktinnashkam,","poem":1},{"lineBreak":true},{"text":"dutiksag yaimpakti!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mina apag pegkegnum yumigtujua","poem":1},{"lineBreak":true},{"text":"nuna nagkaesan wika aminak pegkegnum yumigkiajame.","poem":1},{"lineBreak":true},{"text":"Wi yumigkiajam juka, nugka nain aidau","poem":1},{"lineBreak":true},{"text":"tuke megkaekashtina iman atinai.","poem":1},{"lineBreak":true},{"text":"Juju pegkeg yumigkia juka Josénu atinai,","poem":1},{"lineBreak":true},{"text":"wagki niyai yachi aina nuwiyan","poem":1},{"lineBreak":true},{"text":"Apajuí etegkamua duka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“¡Benjamígkak lobo kajen yukagtin","poem":1},{"lineBreak":true},{"text":"kashikmas neje yuwa ajum agkuantai","poem":1},{"lineBreak":true},{"text":"ampinjaun tinamkagtina imanai!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Juju doce aina juwai Israela uchiji aidau. Juna aatus ditá apaji maki makichik yumigjauwai."]},{"type":"heading","content":["Jacob jakamu"]},{"type":"verse","number":29,"content":["Makichik tsawantai Jacob niina uchiji aidaun juna aatus tiuwai: “Wi jakatnuk namput wajaschae. Wi jakamtaig mina apag ukusbau aina nuwi waa umikbau Efrógnum hitita aentsu nugken awa nuwi ukugsatajum."]},{"type":"verse","number":30,"content":["Canaán nugkanum waa Macpelá Mamrejai niinis awa nuna mina apachug Abraham ashí Efrógka nugken sumak, juka mina pataaju ukumatai ati tiuwa nuwi ukugsatajum."]},{"type":"verse","number":31,"content":["Nuwi ukusajui Abrahaman niina nuwe Sarajai, nuigtushkam nuwig ukusajui mina apag Isaakan niina nuwe Rebecajai, tuja wishakam nuwig Lean ukusuitjai."]},{"type":"verse","number":32,"content":["Nunú nugka duka, ashí waa aidaujai hitita aentsu nugke aajaku sumakbauwai.”"]},{"type":"verse","number":33,"content":["Juna aatus Jacob niina uchiji aidau umikagtinun ujaka ashimak, pegajin ataktu tepesui, nunik nuwig jakauwai."]}],"footnotes":[{"noteId":34,"caller":"+","text":"Juna aatus tiuwa nunak nii wegantu aidauk nugka pegkeg ajak shiig tsapaunum batsamas shiig wiakuch agtin asamtai tiuwai.","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/agr_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}