{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HAB","translationId":"agr_wbt","name":"Habacuc","commonName":"Habacuc","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"0f67214171ce8add17e7742001b5bf93c0d0d57b61c48cc40f7036243c7a5c36","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/HAB/3.json","totalNumberOfVerses":54},"chapter":{"number":1,"content":[{"type":"heading","content":["Profeta Habacuc Tuke Pujuujai chichasbau"]},{"type":"verse","number":1,"content":["Profeta Habacuc aajakua nuna Apajuí nii aentsji aidaun chichama ujakti tusa iwaintukui."]},{"type":"verse","number":2,"content":[{"text":"“Tuke Pujuuwah, yainkata tusan senchi untsuagme,","poem":1},{"lineBreak":true},{"text":"tujash amek minak antugtatsme.","poem":1},{"lineBreak":true},{"text":"¿Wajutiya minash antugtuktatme?","poem":1},{"lineBreak":true},{"text":"Pempeentuniki waitkaniamu ayá nunú","poem":1},{"lineBreak":true},{"text":"suwimak susam emegkagta tusan segamjame,","poem":1},{"lineBreak":true},{"text":"tujash amek makichkish duka dutikatsme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Wagka minash ibau pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"iwaintugkumesh waitkajame?","poem":1},{"lineBreak":true},{"text":"Pegkegchau takat aidau, utugchat aidau,","poem":1},{"lineBreak":true},{"text":"yaakat tsayamu, jiyaniamu,","poem":1},{"lineBreak":true},{"text":"maaniamu aina duka makichkish agkaatsui,","poem":1},{"lineBreak":true},{"text":"ashí yantamnum ayawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amina chichamem umiktin agagbaunak","poem":1},{"lineBreak":true},{"text":"makichkish uminatsui,","poem":1},{"lineBreak":true},{"text":"ajantunisag shiig aneas betek yainidauk","poem":1},{"lineBreak":true},{"text":"makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Aents pegkegchau aidau aents pegkeg aidaun waitkainawai.","poem":1},{"lineBreak":true},{"text":"Tsanumat, kasamat aina duka","poem":1},{"lineBreak":true},{"text":"ashí yantamnum ayawai”, tiuwai Habacuc.","poem":1}]},{"type":"heading","content":["Apajuí suwimak sukagtustin etsegkamu"]},{"type":"verse","number":5,"content":[{"text":"Tusa timatai Apajuí ayaak:","poem":1},{"lineBreak":true},{"text":"“Tikich aents aidau batsata nuwish","poem":1},{"lineBreak":true},{"text":"wajukeawa nunú shiig diistajum.","poem":1},{"lineBreak":true},{"text":"Aunak dukap tsawan atsuk wi dutikattag","poem":1},{"lineBreak":true},{"text":"nunú wainkajum anentai jegashtatjume.","poem":1},{"lineBreak":true},{"text":"Juna tikich ujapainakuig,","poem":1},{"lineBreak":true},{"text":"atumek dekaskeapi tumaitsugme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Caldeo aents pegkegchau magkagtin aidau","poem":1},{"lineBreak":true},{"text":"ashí nugkanum yujasag,","poem":1},{"lineBreak":true},{"text":"tikichi nugken atankiagtatus wakeyin aina nuna","poem":1},{"lineBreak":true},{"text":"inajagtatjai jetepaktinme tusan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ditak pegkegchau takatnum eemkau ainawai,","poem":1},{"lineBreak":true},{"text":"nunin asag, dita wakegamun takau ainawai,","poem":1},{"lineBreak":true},{"text":"nuadui makichkish tumainchau ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aents caballonum maanin aidauk shiig kuashat","poem":1},{"lineBreak":true},{"text":"caballonum entsatkau atushat minisag","poem":1},{"lineBreak":true},{"text":"tutugtuinawai.","poem":1},{"lineBreak":true},{"text":"Nunú caballo aidauk ikamyawan nagkaesau senchi tupikainawai,","poem":1},{"lineBreak":true},{"text":"tuja nuigtush uwegshunmaya lobo kajen ajankachua nuna nagkaesau ainawai.","poem":1},{"lineBreak":true},{"text":"Iman asag atushat minisag","poem":1},{"lineBreak":true},{"text":"dita shiwaajinak águila yutaijin wainak,","poem":1},{"lineBreak":true},{"text":"nanaak akaetuki achiyama iman ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dita shimuinakug ashí ijina shimawai,","poem":1},{"lineBreak":true},{"text":"imaaninak senchi uwakmakag shimawai,","poem":1},{"lineBreak":true},{"text":"tuja aentsun achijag yajumaina duka,","poem":1},{"lineBreak":true},{"text":"nayantsanum kayam dekapamainchauwa iman weakui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iman asag apu aidaunak, tuja tikich aents","poem":1},{"lineBreak":true},{"text":"eme anentsa diitai aina nunashkam dushikinawai.","poem":1},{"lineBreak":true},{"text":"Yaakat peejamu aina nunak","poem":1},{"lineBreak":true},{"text":"wainkauch diinak dushikinawai,","poem":1},{"lineBreak":true},{"text":"nuninak kamatkanum batsamas yaaktanak utuinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dase senchi dasentak kedegtuk nagkaemama iman ainawai.","poem":1},{"lineBreak":true},{"text":"Iman ainakush dita senchijiya nuna","poem":1},{"lineBreak":true},{"text":"apajuímaidau asag tunamainawai”, tiuwai.","poem":1}]},{"type":"heading","content":["Profeta kajeka ataktu chichakbau"]},{"type":"verse","number":12,"content":[{"text":"“Israel aents aidaun Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"amek pegkejam tuke pujuuwaitme;","poem":1},{"lineBreak":true},{"text":"jinatnume tusamek idaikagtusaipa.","poem":1},{"lineBreak":true},{"text":"Amek amina aentsjum aidau suwimak susam jintintuatag","poem":1},{"lineBreak":true},{"text":"tusam, caldeo aents aidau ishitkaume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amek pegkegmaitam iman asam,","poem":1},{"lineBreak":true},{"text":"pegkegchauwa duka atsane pujuchuitme,","poem":1},{"lineBreak":true},{"text":"tuja tudaushkam dakitnaitme.","poem":1},{"lineBreak":true},{"text":"Nuadui ayatkek dii pujuipa, tuja aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"aents pegkeg aidaun maatnume tusamek","poem":1},{"lineBreak":true},{"text":"agkan idaisaipa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿Wagka aents aidaush","poem":1},{"lineBreak":true},{"text":"nayantsanmaya namak aidaujai betekash,","poem":1},{"lineBreak":true},{"text":"tuja kuntin apugtuchu aina nujai betekash awajsaume?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuadui caldeo aents aidau,","poem":1},{"lineBreak":true},{"text":"aents namaka main agsean ajuntuk,","poem":1},{"lineBreak":true},{"text":"tuja retan nená yupichuch","poem":1},{"lineBreak":true},{"text":"kuashat namakan achiyama numamtuk","poem":1},{"lineBreak":true},{"text":"aents aidaun achija ijumainawai,","poem":1},{"lineBreak":true},{"text":"dutikawag nuna diisag shiig aneenawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuadui nunú aents namaka main aina duka","poem":1},{"lineBreak":true},{"text":"niina redjin, agseajijai emematuinak","poem":1},{"lineBreak":true},{"text":"kuntinun maa apeenak,","poem":1},{"lineBreak":true},{"text":"kugkuin inciensonashkam apeenawai,","poem":1},{"lineBreak":true},{"text":"wagki ditak duwi maawag","poem":1},{"lineBreak":true},{"text":"dita yuwatnujinak shiig kuashat ijumag batsatu asag,","poem":1},{"lineBreak":true},{"text":"shiig aneas batsatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Caldeo aents aidau wainak mau batsamtitnume","poem":1},{"lineBreak":true},{"text":"tusamek idaikagtusaipa”, tiabiajai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":17}