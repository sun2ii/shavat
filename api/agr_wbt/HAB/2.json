{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HAB","translationId":"agr_wbt","name":"Habacuc","commonName":"Habacuc","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"0f67214171ce8add17e7742001b5bf93c0d0d57b61c48cc40f7036243c7a5c36","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/HAB/3.json","totalNumberOfVerses":54},"chapter":{"number":2,"content":[{"type":"heading","content":["Apajuí inagnak Habacukan aikbau"]},{"type":"verse","number":1,"content":[{"text":"Nuna pachisan Apajuín segau asan,","poem":1},{"lineBreak":true},{"text":"suntag jinta niimin ekemas niimak ekemama numamtuk","poem":1},{"lineBreak":true},{"text":"Tuke Pujuush wajinjuttig tusan dakakun pujubiajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nunikan pujai Tuke Pujuu mina aijak:","poem":1},{"lineBreak":true},{"text":"“Wi amina iwaintuktatjam nunú","poem":1},{"lineBreak":true},{"text":"tablanum paan shiig wainmain agagta,","poem":1},{"lineBreak":true},{"text":"dutikamu asamtai, tikich aidaush yupichuch ausatnume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunú ame wainkattam duka","poem":1},{"lineBreak":true},{"text":"juu tamawaikik nagkaemakchattawai,","poem":1},{"lineBreak":true},{"text":"tujash amek waugtutsuk dakasta,","poem":1},{"lineBreak":true},{"text":"nunú nagkaemaktinuk eke tsawan jegatsui.","poem":1},{"lineBreak":true},{"text":"Tujash duka makichkish megkaetsuk","poem":1},{"lineBreak":true},{"text":"tuké uminkattawai”, tujutmayi.","poem":1}]},{"type":"heading","content":["Aents pegkegchau aidaush wajukatnuk ainawa"]},{"type":"verse","number":4,"content":[{"text":"“Tuja wi agagta tajam nunak juna tajai:","poem":1},{"lineBreak":true},{"text":"‘Aents pegkegchau emebau aidauk jinawagtinai,","poem":1},{"lineBreak":true},{"text":"untsu aents pegkeg ima Apajuínak umijuidauk jinachagtinai.’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents emebau aidauk apu atag tusag wakegainawai,","poem":1},{"lineBreak":true},{"text":"vino pegkejaitak enamkagtuwama nujai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Tikich aidau nagkaesau amí tuidau asag,","poem":1},{"lineBreak":true},{"text":"makichkish ayámjutsuk yujajus","poem":1},{"lineBreak":true},{"text":"aents tikich nugkanmaya aidaun amuinawai.","poem":1},{"lineBreak":true},{"text":"Dita aidauk jaka megkaetaijai betek,","poem":1},{"lineBreak":true},{"text":"tuja ukumatai aents jakaun dakitmaitsu nujai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Nunin asag ayatak wenawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tujash ditak yana waitkainawa nunú pempeentuki dushikiam agtinai.","poem":1},{"lineBreak":true},{"text":"Dutika dushikinak:","poem":1},{"lineBreak":true},{"text":"‘¡Ame tikich aents aidaun wajiiji yajutkam","poem":1},{"lineBreak":true},{"text":"wiakuch wajasum nunak wait anentagme!","poem":1},{"lineBreak":true},{"text":"¿Amesh wajutiya kasamtash idaisattame?’","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ame waitkam nunú pachiachbaunum","poem":1},{"lineBreak":true},{"text":"pempeentugmakiag waitkagmasagtinai,","poem":1},{"lineBreak":true},{"text":"imatijamainakui sapijai kujaitnaitme,","poem":1},{"lineBreak":true},{"text":"tuja amina wajijum aidaunak ashí atanjamjagtinai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tikich nugkanmaya aidau ijunag chichama umikag,","poem":1},{"lineBreak":true},{"text":"ame dita kasajauwaitam dutiksag ditashkam","poem":1},{"lineBreak":true},{"text":"ashí kasagtamjagtinai.","poem":1},{"lineBreak":true},{"text":"Dutik akikmaktatme ame juju nugka juwiya","poem":1},{"lineBreak":true},{"text":"aents ijinkum yaakat aidau tsaikuitam nuadui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Kasamkamu aidau,","poem":1},{"lineBreak":true},{"text":"tikich tsanuja yajutkamu aidaujai","poem":1},{"lineBreak":true},{"text":"amina aentsjum aina nunú wiakuch awajsaum,","poem":1},{"lineBreak":true},{"text":"nuadui aminak wait anentagme!","poem":1},{"lineBreak":true},{"text":"Ame anentaimsamek,","poem":1},{"lineBreak":true},{"text":"jutikanus shiig batsasainja tamestai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tujash ayatak datsanmain iwaintukume.","poem":1},{"lineBreak":true},{"text":"Kuashat aents tikich nugkanmaya aidau ijinatjai","poem":1},{"lineBreak":true},{"text":"tukamam, amek pempeentumakim amumakume.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaakat peejamu aidau, jega ayanke aidaujai","poem":1},{"lineBreak":true},{"text":"ame pegkegchau takamsamua nuna pachisag","poem":1},{"lineBreak":true},{"text":"aentsjai betek senchi untsumiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“¡Amek aents aidau ijinkum,","poem":1},{"lineBreak":true},{"text":"dita nugke atanjam nuwi yaakat najankaume,","poem":1},{"lineBreak":true},{"text":"nuadui aminak wait anentagme!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tujash ame waittsa umikum duka wainka imatikaume,","poem":1},{"lineBreak":true},{"text":"aunak Tuke Pujuu ashí senchigtina nunú ashí apea tsaika ajapattawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuun imanjiya duka,","poem":1},{"lineBreak":true},{"text":"yumi nayantsan ipiamna numamtuk,","poem":1},{"lineBreak":true},{"text":"ashí nugkanum piyaktatui.","poem":1},{"lineBreak":true},{"text":"Nunikmatai ashí nuna dekawagtinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Aents amejai tikiju batsatu","poem":1},{"lineBreak":true},{"text":"vino drogajai pachimja ama amakuam enamkam wisu weakui,","poem":1},{"lineBreak":true},{"text":"nunú diisam dushiki pujam nunak wait anentagme!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuke Pujuu aminak inastamjattawai,","poem":1},{"lineBreak":true},{"text":"amek makichkish emematam amaitsume.","poem":1},{"lineBreak":true},{"text":"Atum tikich aidau datsan dushikiajum dutiksag,","poem":1},{"lineBreak":true},{"text":"atumnashkam Apajuí datsanmainun iwaintamkagtatui.","poem":1},{"lineBreak":true},{"text":"Dutijamawagmatai emebau ainajum duka","poem":1},{"lineBreak":true},{"text":"ememachu wajastatjume.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Muja Líbanonmaya kuntin aidau","poem":1},{"lineBreak":true},{"text":"ijinauwaitam nunú aminak bakugmattawai.","poem":1},{"lineBreak":true},{"text":"Ame aents aidau ijinamunum,","poem":1},{"lineBreak":true},{"text":"tuja yaakat aidau tsaikbaunum, suwimak juki waitiakum","poem":1},{"lineBreak":true},{"text":"amina pegkegchaujum akikmaktatme.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Babilonianmaya aidaunak wait anentuinajai!","poem":1},{"lineBreak":true},{"text":"¿Wagka atumesh wainka apajuímtai aidaunmash","poem":1},{"lineBreak":true},{"text":"kajintsagmesh anentaimjume?","poem":1},{"lineBreak":true},{"text":"¿Wagka atumesh aannush yainkata tusagmesh","poem":1},{"lineBreak":true},{"text":"segash yujagme?","poem":1},{"lineBreak":true},{"text":"Auk numi, kaya, atum najanamu ainawai,","poem":1},{"lineBreak":true},{"text":"tujash duka wainak ainawai.","poem":1},{"lineBreak":true},{"text":"Auk jiju najana orojai, platayai ukatkamu iwakuchu asa","poem":1},{"lineBreak":true},{"text":"nigki wajamainchau, tuja chichamainchau ainawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tujash Tuke Pujuuk niina jee pegkegma nuwi pujawai.","poem":1},{"lineBreak":true},{"text":"¡Niina emtinig ashí nugkanmaya aents aidauk","poem":1},{"lineBreak":true},{"text":"takamtak pujustinme!” tajai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":19}