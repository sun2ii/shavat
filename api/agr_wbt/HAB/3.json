{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HAB","translationId":"agr_wbt","name":"Habacuc","commonName":"Habacuc","title":"Habacuc","order":35,"numberOfChapters":3,"sha256":"0f67214171ce8add17e7742001b5bf93c0d0d57b61c48cc40f7036243c7a5c36","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/HAB/3.json","totalNumberOfVerses":54},"chapter":{"number":3,"content":[{"type":"heading","content":["Habacuc Apajuí segamu"]},{"type":"verse","number":1,"content":["Profeta Habacuc Apajuín juna aatus segauwai:"]},{"type":"verse","number":2,"content":[{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ame ashí dutikaum nunak shiig dekajai,","poem":1},{"lineBreak":true},{"text":"nuadui amina ishamakun kujajai.","poem":1},{"lineBreak":true},{"text":"Wait aneasam iina apachji aidau yaigkuitam","poem":1},{"lineBreak":true},{"text":"dutiksamek yaijatkata,","poem":1},{"lineBreak":true},{"text":"kajegkagtukam idaikagtusu akumesh, wait anenkagtugta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apajuík Temán nugkanmaya minawai,","poem":1},{"lineBreak":true},{"text":"Apajuí pegkegma nunú muja Parágnumia jiinki minawai,","poem":1},{"lineBreak":true},{"text":"Apajuín imanjiya duka ashí nayaimpin jajutua awai,","poem":1},{"lineBreak":true},{"text":"tuja ashí nugkanum Apajuí emematku kantamtain kantamainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Winchamtinnum egkemak minawai,","poem":1},{"lineBreak":true},{"text":"niina uwejenia chaajip keeka jiinui,","poem":1},{"lineBreak":true},{"text":"nuniak niina senchiji uumak aunash iwainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nii minitaik kuashat aents aidau","poem":1},{"lineBreak":true},{"text":"jata ishamainun achiimakag jinuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja niina ukuujin tsuwemu ishamain minawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apajuí minau jasa wajataik, nugka uujui,","poem":1},{"lineBreak":true},{"text":"tuja ashí aents aidaun diitaik,","poem":1},{"lineBreak":true},{"text":"aents aidauk ishamainak kujainawai,","poem":1},{"lineBreak":true},{"text":"muja aidauk tsainak megkagainawai,","poem":1},{"lineBreak":true},{"text":"muja yaunchuk nagkamas aajaku aidaush yumpunainawai.","poem":1},{"lineBreak":true},{"text":"Tujash Apajuín jintiya duka yumpunagkesh megkaekashtinun tuke atinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuigtushkam Cusagnumia aents aidau","poem":1},{"lineBreak":true},{"text":"initak makichkish jiinmainchaunum egkema","poem":1},{"lineBreak":true},{"text":"waitmaina imanik senchi waituidaun wainkabiajai.","poem":1},{"lineBreak":true},{"text":"Tuja Madián nugkanmaya aidaushkam","poem":1},{"lineBreak":true},{"text":"senchi ishamainak jiintsuk ayatak kaemag","poem":1},{"lineBreak":true},{"text":"aakchinmag batsatun wainkabiajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, aents caballonum entsatkau","poem":1},{"lineBreak":true},{"text":"minimaina imanika minakum,","poem":1},{"lineBreak":true},{"text":"aents maaniamunum depetmak carro maanitainum egkemag wegama","poem":1},{"lineBreak":true},{"text":"numamtuk wajam dusha ¿wagka imanikmesh umintsaume?","poem":1},{"lineBreak":true},{"text":"¿Namak aidau, nayants aidau, wainka apajuímtai aina nunú kajegkamek imanikmesh umintsaum?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Akentaiyai aketka iju ichimaina imatikabiume nugkak,","poem":1},{"lineBreak":true},{"text":"amina senchigmin imatikamua nunú","poem":1},{"lineBreak":true},{"text":"namak najaneakmayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muja aidauk amina waipainak, ishamjamak sunatuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja nayaimpinmaya yumi senchi yutawai,","poem":1},{"lineBreak":true},{"text":"imanitai nayants kuna senchi tsukatu asa","poem":1},{"lineBreak":true},{"text":"kedegtak ishamain wajawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ame chaajip ishamain winchamtin nagkijai betek","poem":1},{"lineBreak":true},{"text":"ekemaka akupkaamin,","poem":1},{"lineBreak":true},{"text":"etsak nantujai uumak megkaekaje.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ame kajekam nugka tenteame,","poem":1},{"lineBreak":true},{"text":"dutikakum ame kajekbaugmin","poem":1},{"lineBreak":true},{"text":"aents nugka muunnumia aidauk dajaja tsaika","poem":1},{"lineBreak":true},{"text":"ajapmaina imatikame.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amina aentsjum aina duka ame apu etegkauwaitam nujai yayaakum miname.","poem":1},{"lineBreak":true},{"text":"Untsu aents pegkegchau aina nuna apujig mantuam,","poem":1},{"lineBreak":true},{"text":"inabaujiya duka ashí tsaigkam emegkatkaume.","poem":1},{"lineBreak":true},{"text":"Dutikamu asa ditak shiig wainak juwakaje.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Caballonum maanitan yacha aidau ememasag","poem":1},{"lineBreak":true},{"text":"dase senchi dasentujai betek jetepaidau asag,","poem":1},{"lineBreak":true},{"text":"amupaktag tiagmayi.","poem":1},{"lineBreak":true},{"text":"Imatijamainakui ayamjumamainchau dekapmaiji,","poem":1},{"lineBreak":true},{"text":"tujash ame dita apujig niina flechajinig depetkabiume.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amek amina caballogmin entsamkam","poem":1},{"lineBreak":true},{"text":"nayants ishamain wajamunum wekaeme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nuna antakun senchi ishamkabiajai.","poem":1},{"lineBreak":true},{"text":"Nuniai mina wenujuk sunatmayi,","poem":1},{"lineBreak":true},{"text":"imaniakun wajaschamin, ashí mina iyashjuig","poem":1},{"lineBreak":true},{"text":"kakaumainchau dekapmaijai,","poem":1},{"lineBreak":true},{"text":"nuniakun anentaijui tetegtimiajai.","poem":1},{"lineBreak":true},{"text":"Tujash wika imaniaknush,","poem":1},{"lineBreak":true},{"text":"waugtutsuk iina waitkagbau aina nuna Apajuí waitkastin tsawan jegatna nuna dakastatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tuja higuera ajakbau nejeachkuish,","poem":1},{"lineBreak":true},{"text":"uva nejeachkuish, olivo aceitunan nejeachkuish,","poem":1},{"lineBreak":true},{"text":"ajanmaya aidaush, ikamia aidaukesh nejenachkuish,","poem":1},{"lineBreak":true},{"text":"tuja baka aidaush, uwig aidaush ashí jinutjamamtaish,","poem":1},{"lineBreak":true},{"text":"minak Tuke Pujuu uwemtijuju asamtai,","poem":1},{"lineBreak":true},{"text":"wika shiig aneasan niina ememattatjai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuu minak senchimtijawai,","poem":1},{"lineBreak":true},{"text":"dutijak japa senchi tupikaina iman awajtus","poem":1},{"lineBreak":true},{"text":"muja aidaunum iwajuk tikichish maumainchau kuitamjawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ZEC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}