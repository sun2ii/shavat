{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":1,"content":[{"type":"heading","content":["Nuwa akika dutiktaijai Oseas nuwenamu"]},{"type":"verse","number":1,"content":["Beeri uchiji Oseasan Tuke Pujuu ausauwai. Nunak Ozías, Jotam, Ahaz, Ezequías aatus Judá wegantu aidaun apuji aidau, tuja Joásan uchiji Jeroboam Israel aents aidaun apuji aatus batsamajaku aina nunú tsawantin ausauwai."]},{"type":"verse","number":2,"content":["Yama nagkamchak Tuke Pujuu Oseasan ausauwa duka jujuwai:",{"lineBreak":true},{"text":"“Israel aents aina duka mina umigtutnak idaisaje,","poem":1},{"lineBreak":true},{"text":"nuninak nuwa akika dutiktaijai betek wajasaje,","poem":1},{"lineBreak":true},{"text":"nuadui ameshkam nunismek nuwa akika dutiktaijai","poem":1},{"lineBreak":true},{"text":"nuwenata, nunikam nuwi uchi akiata.","poem":1},{"lineBreak":true},{"text":"Dutikamu asag ditak nuwa akika dutiktain uchiji agtinme”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Tusa tima múun Diblaim aajakua nuna nawanji Gómeran nuwatuk pujus uchi aishmagkun akiauwai."]},{"type":"verse","number":4,"content":["Nunú uchi akiinamtai Tuke Pujuu Oseasan chichajak:",{"lineBreak":true},{"text":"“Anú uchi daajig Jezreel adaikata,","poem":1},{"lineBreak":true},{"text":"wagki ujumak tsawan asan, apu Jehú","poem":1},{"lineBreak":true},{"text":"Jezreel nugkanum kuashat amujatkawa nuna umiakun,","poem":1},{"lineBreak":true},{"text":"suntag Israelnumia aidaunak ashí ijinattajai.","poem":1},{"lineBreak":true},{"text":"Dutikan Jehú apu wajas puja nunak","poem":1},{"lineBreak":true},{"text":"atakesh tuke apu achatnun atankittajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunak nugka paka Jezreel tutaya","poem":1},{"lineBreak":true},{"text":"nuwi Israel aents aidaun shiwaaji jetekag ijinatnume,","poem":1},{"lineBreak":true},{"text":"dutikainak achija yajuaktinme titatjai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Duwi pujus Gómer ataktu ejapjuk tsawanji jegajim nuwauchin uchigmakui. Nunikmatai Apajuí Oseasan chichajak:",{"lineBreak":true},{"text":"“Israel nugkanmaya aidaunak ataktuk wait anenjashtatjai,","poem":1},{"lineBreak":true},{"text":"tuja nuigtush ditá pegkegchaujinash tsagkujashtatjai.","poem":1},{"lineBreak":true},{"text":"Dutikatin asamtai, uchi nuwauch akiina","poem":1},{"lineBreak":true},{"text":"nuna daajig Lo-ruhama","poem":1},{"noteId":0},{"text":"adaikattame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["“Untsu Judá wegantu aina nunak wi, apu Tuke Pujuunuk, wait anenjattajai. Tujash wika ditanak suntagjai ijunjanuk, nagki, puyag, flecha, caballo, aidaun yajuakan maaniankesh ayamjukchagtatjai ima wiki ayamjukagtatjai”, tiuwai."]},{"type":"verse","number":8,"content":["Tuja Gómer niina nawanji Lo-ruhama aajakua nuna amuntsuamun atsujuk pujus, ataktu ejapjuk uchi aishmagkun uchigmakui."]},{"type":"verse","number":9,"content":["Nunikmatai Tuke Pujuu Oseasan chichajak:",{"lineBreak":true},{"text":"“Anú uchik Lo-amí,","poem":1},{"noteId":1},{"text":"adaikattame,","poem":1},{"lineBreak":true},{"text":"wagki atumek mina aentsug ainatsjume,","poem":1},{"lineBreak":true},{"text":"wishakam atumi Apajuígmichuitjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Tujash Israel aents aidauk shiig kuashat yujakag,","poem":1},{"lineBreak":true},{"text":"nayantsa kamatkaji dekapamainchauwa iman wajasagtinai.","poem":1},{"lineBreak":true},{"text":"Nunú tsawantinig Apajuík ataktu chichaakug:","poem":1},{"lineBreak":true},{"text":"‘Atumek mina aentsjuchu ainagme’, tichatnai.","poem":1},{"lineBreak":true},{"text":"Ayatak dekas:","poem":1},{"lineBreak":true},{"text":"‘Atumek Apajuí tuke pujuuwa nuna uchiji ainagme’, titinai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tusa tima Judá wegantu aidau Israel aents aidaujai ijunag","poem":1},{"lineBreak":true},{"text":"dita apujin ima makichik adaikagtinai.","poem":1},{"lineBreak":true},{"text":"Dutikawagmatai tikich nugkanum achija yajuakbau","poem":1},{"lineBreak":true},{"text":"batsatushkam waketug kaunawagtinai.","poem":1},{"lineBreak":true},{"text":"Duwi nagkamas Jezreel nugkanmak","poem":1},{"lineBreak":true},{"text":"shiig aneasa pujamu atinai”, tiuwai.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Lo-ruhama” tawa nunak hebreo chichamnumak “wait anenjashbau” taku tawai.","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"+","text":"“Lo-amí” tawa nunak hebreo chichamnumak “mina aentsjuchui” taku tiuwai.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/agr_wbt/HOS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/DAN/9.json","previousChapterAudioLinks":{},"numberOfVerses":11}