{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":11,"content":[{"type":"heading","content":["Apajuík niina aentsjig intimkiu ainaig aneawai"]},{"type":"verse","number":1,"content":[{"text":"“Israel aents aidaunak tsakatuch ainaig nagkamsan aneen ayajai,","poem":1},{"lineBreak":true},{"text":"wi ditanak mina uchig asagmatai,","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum batsatun jiijuitjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dutikamaitak mina umigtutan dakituinak","poem":1},{"lineBreak":true},{"text":"nuni senchi tupanjuyanume,","poem":1},{"lineBreak":true},{"text":"nuninak wainka apajuímtai aidaun emematuinak","poem":1},{"lineBreak":true},{"text":"kuntinun maa apeenak,","poem":1},{"lineBreak":true},{"text":"kugkuin inciensonashkam apeeyanume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunin ainaig wi ditan aneau asan","poem":1},{"lineBreak":true},{"text":"uchijai betek jukin egkesan emayajai,","poem":1},{"lineBreak":true},{"text":"dutikakun wekaetanash jintintuawabiajai,","poem":1},{"lineBreak":true},{"text":"yutainash ayujiajai, utugchatnumash yaigkabiajai.","poem":1},{"lineBreak":true},{"text":"Imatiksa kuitamaitak, Apajuíyap kuitamjamua","poem":1},{"lineBreak":true},{"text":"tichau ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunidau asag mina umigtutnak dakitjau ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui egiptunmaya aents aidau inainak","poem":1},{"lineBreak":true},{"text":"waitkajaku aina nunak, yamaik asirianmaya","poem":1},{"lineBreak":true},{"text":"ditanak inainak waitkasagtatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dita yaaktaji aidaunak tsaigkagtinai,","poem":1},{"lineBreak":true},{"text":"dutikainak aents aidaunashkam ijinawagtinai,","poem":1},{"lineBreak":true},{"text":"nuna dutikainak dita anentaimjamujinak ashí idaimitkasagtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mina aentsug aidauk,","poem":1},{"lineBreak":true},{"text":"wainka apajuímtai aidaun emematuinak","poem":1},{"lineBreak":true},{"text":"mina umigtutnak dakituinawai.","poem":1},{"lineBreak":true},{"text":"Nunidau asag mina idaitusag batsata","poem":1},{"lineBreak":true},{"text":"nunisag batsamsatatus wakegainawai.","poem":1},{"lineBreak":true},{"text":"Senchi untsumainawai,","poem":1},{"lineBreak":true},{"text":"tujash makichkish ditan yayauk atsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“¡Israel aents aidauwah, wika atumi aneakun","poem":1},{"lineBreak":true},{"text":"shiig senchi waitiajai,","poem":1},{"lineBreak":true},{"text":"nuadui wika kajimatkinuk idaimaitsujime!","poem":1},{"lineBreak":true},{"text":"¡Wika Admánmaya aents aidaun,","poem":1},{"lineBreak":true},{"text":"Seboímnumia aents aidaujai dita pegkegchaujin","poem":1},{"lineBreak":true},{"text":"ijinauwaitag imatikanuk tikima ijinmaitsujime!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wika atumnak kajekbautkek suwimkanak amaschagtatjai,","poem":1},{"lineBreak":true},{"text":"Tuja Efraín wegantu aidaunak ataktuk ijinashtinaitjai,","poem":1},{"lineBreak":true},{"text":"wagki wika aentschauwaitjai, wika Apajuíyaitjai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu pegkegmanuk,","poem":1},{"lineBreak":true},{"text":"wika atumjai ijutkau pujajai,","poem":1},{"lineBreak":true},{"text":"wika atumin ijinatasanuk tachmajai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":8}