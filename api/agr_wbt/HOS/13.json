{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":13,"content":[{"type":"heading","content":["Apajuí Israel aents aidaun suwimkan susattawai tusa etsegkamu"]},{"type":"verse","number":4,"content":["Tuke Pujuu chichaak:",{"text":"“Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"witjai apu atumi Apajuígminuk,","poem":1},{"lineBreak":true},{"text":"atum Egipto nugkanum batsatutigmin wi jiijuitjim","poem":1},{"lineBreak":true},{"text":"duwi nagkamsanuk yamaikish wika atumi Apajuíjiyaitjai.","poem":1},{"lineBreak":true},{"text":"Witjai atumin uwemtiknunuk.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Uwejush yumi atsau nimpainnum batsabiujum duish","poem":1},{"lineBreak":true},{"text":"wi atumnak kuitamkauwaitjime.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tujash atumek yutai kuashat ajutjamu asamtai,","poem":1},{"lineBreak":true},{"text":"ememakjum mina kajimatjukiu ainagme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nuadui león kajeka kuntinun jetegama imatikattajime.","poem":1},{"lineBreak":true},{"text":"Jintá yantam uumka tepesan ikamyawajai","poem":1},{"lineBreak":true},{"text":"betek tepegkattajime.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chayú niina uchiji megkaetujam wainkatatus egak","poem":1},{"lineBreak":true},{"text":"ishamain wajama imanika jiintukin detsepen ichinjattajai;","poem":1},{"lineBreak":true},{"text":"dutikan nuwig leónjai betek amuktatjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidautigmek wi kuitamkam batsamnaitjume,","poem":1},{"lineBreak":true},{"text":"tujash yamaik wi ijinattajime,","poem":1},{"lineBreak":true},{"text":"dutikawaipa tujutmainuk atsawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dusha atumi apujish ¿wajukame?","poem":1},{"lineBreak":true},{"text":"¿Wagka nunú untsuatsjume ayamkagtukta tusajum?","poem":1},{"lineBreak":true},{"text":"Tuja nuigtush tikich apu aidau adaitujata tusajum","poem":1},{"lineBreak":true},{"text":"sumabiujum dusha ¿wajukawagmae?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imatkugmin atumin kajegkan apun adaitukbaijime.","poem":1},{"lineBreak":true},{"text":"Tuja yamaishkam nunisnuk atum kajemtijuku asagmin","poem":1},{"lineBreak":true},{"text":"nunak atankittajime,","poem":1},{"lineBreak":true},{"text":"dutikam apugtuchu juwaktatjume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“¡Atum pegkegchau takasbau aidaunak ashí papiinum agagjai!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Israel aents aidautigmek anentainkachu ainagme,","poem":1},{"lineBreak":true},{"text":"nunin asajum uchi akiinatnuji jegau aig,","poem":1},{"lineBreak":true},{"text":"tutupit egkemtsuk tunija egkemama nuninaitjume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunin ainayatkujum","poem":1},{"lineBreak":true},{"text":"Apajuí uwemtijamjati tusajum dakagjume.","poem":1},{"lineBreak":true},{"text":"¡Wika atumnak jatanmak uwemtikjashtatjime!","poem":1},{"lineBreak":true},{"text":"Nuadui: ‘¿Jaka megkaetaish tuwi awa?","poem":1},{"lineBreak":true},{"text":"¡Amina senchigmejai juwi taam","poem":1},{"lineBreak":true},{"text":"juju aents aidau ijinata!’ tusan untsuajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaja aneasjum chijichi tsupigbau ataktu pegkejan tsapaama numamtuk","poem":1},{"lineBreak":true},{"text":"wajakainjumtaih, nuniakjuminish dase uwegshunmaya dasentak","poem":1},{"lineBreak":true},{"text":"entsa pukuni jiinun buku emama numamtuk","poem":1},{"lineBreak":true},{"text":"wi ijinan emegkagtatjime.","poem":1},{"lineBreak":true},{"text":"Dutika ai atumi shiwaajum aidau","poem":1},{"lineBreak":true},{"text":"wajijum pegkeg akik aidaun yajutjamkagtinai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Samarianmaya aidauk Apajuín shiwagmawaju asag","poem":1},{"lineBreak":true},{"text":"suwimkan jukiagtatui.","poem":1},{"lineBreak":true},{"text":"Nuwi aents aidauk maaniamunum jinawagtatui,","poem":1},{"lineBreak":true},{"text":"uchi piipich aidaunak nugká ajiajag kajegkagtinai,","poem":1},{"lineBreak":true},{"text":"untsu nuwa ejamtin aidaunak","poem":1},{"lineBreak":true},{"text":"ejapeniag ijinawagtinai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":13}