{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":14,"content":[{"type":"heading","content":["Oseas Israel aents aidaun pegkegchau takat idaikujum Apajuí umigkatajum tibau"]},{"type":"verse","number":1,"content":["Oseas Israel aents aidaun chichajak:",{"lineBreak":true},{"text":"“Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atumi pegkegchaujum wagagtamkimtai,","poem":1},{"lineBreak":true},{"text":"kakaumainchau wajasjum batsatjum nunú idaikujum","poem":1},{"lineBreak":true},{"text":"ataktu atumi Apajuíjum, Tuke Pujuuwai minitajum.","poem":1},{"lineBreak":true},{"text":"Nuniakum juju aatsajum Apajuí segatajum:","poem":1},{"lineBreak":true},{"text":"‘Apajuíjuh, amek pegkejaitme,","poem":1},{"lineBreak":true},{"text":"nuadui wait aneasam iina tudaujish tsagkugkagtugta,","poem":1},{"lineBreak":true},{"text":"dutikawamin ii ame emematku kantabauwa nunú","poem":1},{"lineBreak":true},{"text":"amina shiig awajtamkati.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asirianmaya aidauk carrogtin ainakush,","poem":1},{"lineBreak":true},{"text":"iinak ayamjutpamainchau ainawai,","poem":1},{"lineBreak":true},{"text":"nunin asamtai ataktu awagkik ii dakumka najanamu aidauk emematchattaji.","poem":1},{"lineBreak":true},{"text":"Bitaikshakam ima aminiyanak anenkanak wainainawai’","poem":1},{"lineBreak":true},{"text":"titajum”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Tuke Pujuu Israel aents aidaun chichajak:",{"lineBreak":true},{"text":"“Wi kajekbaugnak mijaakjai,","poem":1},{"lineBreak":true},{"text":"nuniku asan dita pegkegchau ainaigkish,","poem":1},{"lineBreak":true},{"text":"mina anenkajun iwaintukagtatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai nuigtuk intimkichagtatui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israel aents aidaunmak wika jegashkijai betek atatjai.","poem":1},{"lineBreak":true},{"text":"Tuja dita aidauk Lirio yagkujuwama iman,","poem":1},{"lineBreak":true},{"text":"Líbanonmaya setug shiig kagkapenag wajama","poem":1},{"lineBreak":true},{"text":"iman agtatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja kanaweshkam olivo kanawejai betek","poem":1},{"lineBreak":true},{"text":"kadaukdauju pegkejuch,","poem":1},{"lineBreak":true},{"text":"Líbanonmaya setug pegkegchin kugkuwama","poem":1},{"lineBreak":true},{"text":"iman agtatui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel aents aidauk ataktu wi","poem":1},{"lineBreak":true},{"text":"kuitamkam batsamsagtinai;","poem":1},{"lineBreak":true},{"text":"dutikamu asa trigojai betek tsakajagtinai,","poem":1},{"lineBreak":true},{"text":"nuninak uva yagkujuwama imaniagtinai,","poem":1},{"lineBreak":true},{"text":"kugkuntishkam muja Líbanonmaya vinon","poem":1},{"lineBreak":true},{"text":"kugkuntijai betek atinai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja Efraín nugkanmaya aidau chichainak:","poem":1},{"lineBreak":true},{"text":"‘Dakumka najanamu aina duka iik makichkish puyatjatsji’, tiagtinai.","poem":1},{"lineBreak":true},{"text":"Witjai mina aentsug aidau segatuinakui antujunuk,","poem":1},{"lineBreak":true},{"text":"witjai mina aentsug aidaun kuitamunuk.","poem":1},{"lineBreak":true},{"text":"Wika pino pegkeg samekbau tuke kukachua imanaitjai,","poem":1},{"lineBreak":true},{"text":"minai pegkeg waji aidaunak jukiagtinai”, tawai.","poem":1}]},{"type":"heading","content":["Inagnaku etsegkamu"]},{"type":"verse","number":9,"content":[{"text":"Aents yacha shiig anentaimkau akug,","poem":1},{"lineBreak":true},{"text":"juna chichaman antukti:","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu dutikamu aina duka shiig pegkejai,","poem":1},{"lineBreak":true},{"text":"nuadui dita aidaun diisag tikich aidaush","poem":1},{"lineBreak":true},{"text":"pegkeg takata nunak takamain ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"pegkegchaunak takainawai,","poem":1},{"lineBreak":true},{"text":"nuadui Apajuí ditanak suwimkan suwawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":8}