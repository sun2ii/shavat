{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nunik atumi yatsum aidau waketug kaunawagmatai","poem":1},{"lineBreak":true},{"text":"atum chichagkujum:","poem":1},{"lineBreak":true},{"text":"“Apajuín aentsji aidau” titinaitjume.","poem":1},{"lineBreak":true},{"text":"Untsu nuwa aidau chichagkujum:","poem":1},{"lineBreak":true},{"text":"“Wait anenjamu aidau” titinaitjume.","poem":1}]},{"type":"heading","content":["Israel aents aidau Apajuín umigkachagbau"]},{"type":"verse","number":2,"content":[{"text":"Nuigtu Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“¡Wika Israel aents aidaunak","poem":1},{"lineBreak":true},{"text":"nuwa nuwatkamua numamtin anentiajai,","poem":1},{"lineBreak":true},{"text":"tujash ima minakek umigtukchau ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui wika yamaik pachikchagtatjai.","poem":1},{"lineBreak":true},{"text":"¡Atum dita uchiji aidautijum apu chichaman","poem":1},{"lineBreak":true},{"text":"epegkin aidaunum chicham egketuatajum.","poem":1},{"lineBreak":true},{"text":"Niig yamaik mina duwagchauwai,","poem":1},{"lineBreak":true},{"text":"tuja wishakam niina aishichuitjai!","poem":1},{"lineBreak":true},{"text":"Untsu wainak nuwa akika dutiktaijai betek wajá puja nuna idaisati!","poem":1},{"lineBreak":true},{"text":"¡Niina pakiji aidaun shiig anemtika pujutsuk idaisati!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuna nuniachkuig, jáanchjin awitkan","poem":1},{"lineBreak":true},{"text":"nii yama akiinak wisu akiinauwa nunin awajsattajai.","poem":1},{"lineBreak":true},{"text":"¡Dutikan uwejush nugka buku takasa pujumainchau awajsattajai!","poem":1},{"lineBreak":true},{"text":"Dutika ai kitakai jinattawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja niina uchiji aina duka mina uchigchau ainawai,","poem":1},{"lineBreak":true},{"text":"nunak nii pegkegchaun takamak wekagas uchigmaju asamtai,","poem":1},{"lineBreak":true},{"text":"wika ditanak wait anenjachagtatjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israel aents aidauk nuwa akika dutiktai","poem":1},{"lineBreak":true},{"text":"datsantainkachua nunin ainawai.","poem":1},{"lineBreak":true},{"text":"Nunin asag chichainak:","poem":1},{"lineBreak":true},{"text":"‘Mina pakig aidaun egaktajai,","poem":1},{"lineBreak":true},{"text":"wi atsumamu aidaunak dita:","poem":1},{"lineBreak":true},{"text":"yujumkan, yumin, jáanch lana najanamun,","poem":1},{"lineBreak":true},{"text":"lino najanamun, aceiten, vinon, kugkuin aidaun","poem":1},{"lineBreak":true},{"text":"aatus sujuinak wi wakegamun umigtin ainawai’,","poem":1},{"lineBreak":true},{"text":"tuinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuidau asagmatai, jiinki yujasag pakijin igkugkainum tusan,","poem":1},{"lineBreak":true},{"text":"jintanak jagki awajsattajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dutika ai, dita pakijin igkugtag tuinakush","poem":1},{"lineBreak":true},{"text":"igkugchagtatui, tuja nuigtush wainkachagtatui.","poem":1},{"lineBreak":true},{"text":"Nuninak: ‘Yama nagkamchakun aishinauwaitag nujai","poem":1},{"lineBreak":true},{"text":"ima shiig pujuyajai, dekas niyai wakitkitjai’, titinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Tuja wika niina kuitamu asan,","poem":1},{"lineBreak":true},{"text":"nii yuwatnunak, nii atsumamujinash","poem":1},{"lineBreak":true},{"text":"ashí suwaitag nunak niig anentaimas diyatsui.","poem":1},{"lineBreak":true},{"text":"Wika niinak oronash, platanash suwaitjai.","poem":1},{"lineBreak":true},{"text":"Dutika aish nuna yajuak nii ememattin aidaun","poem":1},{"lineBreak":true},{"text":"dakumag najanauwai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunin asamtai, wi nii yuatnun trigon, vinon,","poem":1},{"lineBreak":true},{"text":"tuja nii asepaktinun lana, lino najanamu aidaun","poem":1},{"lineBreak":true},{"text":"susauwaitag nunak imatiksanuk ashí atanjattajai,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"dutikakun niina pakiji aidau emtin wisu awikan inatsagtatjai.","poem":1},{"lineBreak":true},{"text":"¡Nuna dutikai niina ayamjumainuk makichkish atsuttawai!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja maki makichik semanatin,","poem":1},{"lineBreak":true},{"text":"maki makichik nantutin,","poem":1},{"lineBreak":true},{"text":"maki makichik mijantin jiistamtaya nunak","poem":1},{"lineBreak":true},{"text":"jiistamashti titatjai.","poem":1},{"lineBreak":true},{"text":"Nuadui nuna jiistamak dakujinuwe nunak","poem":1},{"lineBreak":true},{"text":"ataktuk nunikchattawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Higo ajakbau ayá nuna, uva ajakbau ayá nujai pachis:","poem":1},{"lineBreak":true},{"text":"Juka mina pakiig aidau sujusbau ainawai","poem":1},{"lineBreak":true},{"text":"tusa emema puja nunak unuptuktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai ikamia kuntin aidau ashí amutkatnai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja dakumkamu aidaun emematak incienson apejakui,","poem":1},{"lineBreak":true},{"text":"nuigtush mina kajimatjuki,","poem":1},{"lineBreak":true},{"text":"niina pakijin pataetak","poem":1},{"lineBreak":true},{"text":"patakumtain patakuma,","poem":1},{"lineBreak":true},{"text":"nugkutain nugku nugkus iwagmamag weawai.","poem":1},{"lineBreak":true},{"text":"Nuni wekagu asamtai wi suwimkan susattajai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuun, nunak dekas tajai.”","poem":1}]},{"type":"heading","content":["Apajuík niina aentsji Israel aents aidaunak aneawai"]},{"type":"verse","number":14,"content":[{"text":"“Aatus mina aentsug pegkegchaunum wekaekuish,","poem":1},{"lineBreak":true},{"text":"wi jukin uwegshunum emattajai,","poem":1},{"lineBreak":true},{"text":"dutikan ataktu mina anenti tusan","poem":1},{"lineBreak":true},{"text":"shiig kuitamkattajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dutika unuinakan,","poem":1},{"lineBreak":true},{"text":"niina nugken uva ajakbau ayá nunak","poem":1},{"lineBreak":true},{"text":"imatiksanuk awagtuktatjai.","poem":1},{"lineBreak":true},{"text":"Tuja muja Acoran pakaji pegkegchauwa nunak","poem":1},{"lineBreak":true},{"text":"pegkeg awajsattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai nuwiyan yuwa pujustinai.","poem":1},{"lineBreak":true},{"text":"Nuniak ataktu nagkama","poem":1},{"lineBreak":true},{"text":"yama nagkamchak aya iman atatui,","poem":1},{"lineBreak":true},{"text":"nuniak egiptunmaya jiinki shiig aneeya","poem":1},{"lineBreak":true},{"text":"imanun anentaimtatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuadui ataktu awagkig:","poem":1},{"lineBreak":true},{"text":"‘Baaldauwaitjai’ tichatnai,","poem":1},{"lineBreak":true},{"text":"dekas: ‘Wika aminuitjai’, tujuttinai.","poem":1},{"lineBreak":true},{"text":"Ataktu awagkig wainka apajuímtai aidaun daajinak","poem":1},{"lineBreak":true},{"text":"adaikashtin ati tusan idaimitkastatjai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu Israel aents aidaun Apajuíjinuk.","poem":1},{"lineBreak":true},{"text":"Nunak dekas uminkatnun tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Nunú tsawan jegamtaig,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidauk shiig agkan maaniamu atsaunum batsamsatnume tusan kuitamkagtatjai.","poem":1},{"lineBreak":true},{"text":"Tuja kuntin aidau ditan waitkamainush atsutnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Israelah, wika aminak waji nuwaitkuish","poem":1},{"lineBreak":true},{"text":"ataktu nuwatkattagme,","poem":1},{"lineBreak":true},{"text":"ajumaish amek tuke mina duwag atinaitme.","poem":1},{"lineBreak":true},{"text":"Wika aminak shiig senchi aneajame,","poem":1},{"lineBreak":true},{"text":"nuadui amek dekas mina shiig duwag","poem":1},{"lineBreak":true},{"text":"wi chicham umikbaunum nuwenin aina","poem":1},{"lineBreak":true},{"text":"nujai betek nuwatkamu atatme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wika aminak mina duwajun kuitamainaitag","poem":1},{"lineBreak":true},{"text":"imatiksan kuitamkattagme,","poem":1},{"lineBreak":true},{"text":"dutikakun ima aminak anettagme,","poem":1},{"lineBreak":true},{"text":"nunú diisam, dekas juwapita mina apujuk tujuttinaitme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah, nunú tsawan atina duwi","poem":1},{"lineBreak":true},{"text":"wi yumin yutumtijatnaitjai,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"dutika ai, trigo, aceite, vino aatus shiig kuashat aitnai.","poem":1},{"lineBreak":true},{"text":"Aatus Jezreel nugka duka shiig pegkeg","poem":1},{"lineBreak":true},{"text":"ajak tsapau wajastinai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu Israel aents aidaun Apajuíjinuk.","poem":1},{"lineBreak":true},{"text":"Juna taja nunak dekaskenum tajai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mina aentsug aidaunak Israel nugkanum","poem":1},{"lineBreak":true},{"text":"ima midauk agtinun batsastinaitjai.","poem":1},{"lineBreak":true},{"text":"Dutikan chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Atumek mina aentsjuchu ayugme,","poem":1},{"lineBreak":true},{"text":"tujash yamaik mina aentsug ainagme’, titinaitjai.","poem":1},{"lineBreak":true},{"text":"Untsu dita chichagtuinak:","poem":1},{"lineBreak":true},{"text":"‘¡Ametme iina Apajuíjig!’ tujutiagtinai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}