{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":4,"content":[{"type":"heading","content":["Apajuí Israel aents aidaun utugchatan apujtusbau"]},{"type":"verse","number":1,"content":["Israel aents aidauwah, Tuke Pujuu chichaa nunú antuktajum.",{"text":"“Juju nugkanmayag waitjutsuk chichauk atsawai,","poem":1},{"lineBreak":true},{"text":"tikichjaish aneeninatsui.","poem":1},{"lineBreak":true},{"text":"Tuja minashkam iina Apajuíjiyapi tujutuinatsui.","poem":1},{"lineBreak":true},{"text":"Nuadui juju nugka juwi batsamin aidaunak","poem":1},{"lineBreak":true},{"text":"Apajuí chichaman umigkae.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Juju nugka juwig ayatak waitjamu,","poem":1},{"lineBreak":true},{"text":"umikchatnaitak Apajuí daaji adaisa tsanumat,","poem":1},{"lineBreak":true},{"text":"magkagtut, kasamat, nuwennush, aishinnush","poem":1},{"lineBreak":true},{"text":"antugdayas batsamtsuk ikagdaibau,","poem":1},{"lineBreak":true},{"text":"aju ajumag magkagtamu aina duke piyak awai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iman wajas au asamtai, aents aidauk buutuinawai,","poem":1},{"lineBreak":true},{"text":"nuninak kakaagchamin dekapenawai,","poem":1},{"lineBreak":true},{"text":"tuja kuntin ikamia aidaush, chigki aidaush,","poem":1},{"lineBreak":true},{"text":"namak nayantsanmaya aidaush ashí jinuinawai.”","poem":1}]},{"type":"heading","content":["Sacerdote aidausuwimkan jukiagtatui tusaTuke Pujuu tiuwai"]},{"type":"verse","number":4,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“¡Sacerdote aidauk makichkikesh","poem":1},{"lineBreak":true},{"text":"tikich aidaunak jiyakchati!","poem":1},{"lineBreak":true},{"text":"Tuja utugchatnakesh apujtuschati.","poem":1},{"lineBreak":true},{"text":"Wika atum sacerdote aidautigminak kajejajime.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atumek tsawaish kashish,","poem":1},{"lineBreak":true},{"text":"tuke pegkegchau takamjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum tikich profeta aidaush,","poem":1},{"lineBreak":true},{"text":"pegkegchau takamtikagme.","poem":1},{"lineBreak":true},{"text":"Nunin asagmin amina aentsjum aidaunak ijinattajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mina aentsug aidauk dita Apajuíjichua nunin anenjuidau asagmatai ijinauwaitjai.","poem":1},{"lineBreak":true},{"text":"Untsu amek sacerdote mina umigtukchau asamin,","poem":1},{"lineBreak":true},{"text":"wi aminak ajapattagme,","poem":1},{"lineBreak":true},{"text":"wagki amek mina chichameg umikchaume,","poem":1},{"lineBreak":true},{"text":"nuadui atum wegantu aidaunashkam pachikchatnaitjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuashat sacerdote kawenakug,","poem":1},{"lineBreak":true},{"text":"imanisag pegkegchaun takainak mina shiwagmatiagmayi.","poem":1},{"lineBreak":true},{"text":"Nuadui eme anentam aina nunak,","poem":1},{"lineBreak":true},{"text":"dushiktai awajsagtatjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja mina aentsug aidau","poem":1},{"lineBreak":true},{"text":"dita tudaujin tsagkugnajagtatus","poem":1},{"lineBreak":true},{"text":"kuntinun ikaunmagtai Sacerdote aidauk nuna yusa batsatu asag,","poem":1},{"lineBreak":true},{"text":"puyatjutsuk pegkegchaun takastinme tusag idayinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunin asagmatai, ditanak mina aentsug aidaujai ijumjan","poem":1},{"lineBreak":true},{"text":"suwimkan susagtatjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mina umigtutan idaisaju asag","poem":1},{"lineBreak":true},{"text":"imanik yuwinakush shiig aneasag pujuschagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja uchi akiami tusag tuinakush","poem":1},{"lineBreak":true},{"text":"uchinash akiachagtinai”, tawai.","poem":1}]},{"type":"heading","content":["Wainka apajuímtai aidaunIsrael aents aidauemematiagbau"]},{"type":"verse","number":11,"content":[{"text":"Nuigtushkam Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aidauk nuwan yujajuinak,","poem":1},{"lineBreak":true},{"text":"vino nampe yujau asag, shiig anentaimja","poem":1},{"lineBreak":true},{"text":"pujumainjig atsujuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nunin asag numi dakumka najanamu aidaun wajinjutpatig,","poem":1},{"lineBreak":true},{"text":"tuja atakea duish wajukatnukitji tusag","poem":1},{"lineBreak":true},{"text":"nuna jegantun iini yujawai.","poem":1},{"lineBreak":true},{"text":"Pakijintanak idaimainchau dekapedau asag,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidauk nuna yujajuinak","poem":1},{"lineBreak":true},{"text":"mina umigtutan tupanjujag wagakag wainak yujawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nugka nainnum wakag imanui numi ayaunum","poem":1},{"lineBreak":true},{"text":"nuna wakentin bikintunum,","poem":1},{"lineBreak":true},{"text":"kuntinu maa apenak, kugkuin incienson apenak","poem":1},{"lineBreak":true},{"text":"dita apajuímtaijin emematuinawai.","poem":1},{"lineBreak":true},{"text":"¡Dita nawanji aidauk tuja dita uchijin nuwe aidaushkam","poem":1},{"lineBreak":true},{"text":"nuwa akika dutiktai aina nujai betek ainawai!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunik pegkegchaun takamainakuish,","poem":1},{"lineBreak":true},{"text":"wika ditanak suwimkanak susashtatjai,","poem":1},{"lineBreak":true},{"text":"wagki atumshakam nuwa wainka apajuímtai","poem":1},{"lineBreak":true},{"text":"aidaun apajuímin aina nuninjai tsanijinjume.","poem":1},{"lineBreak":true},{"text":"Aents shiig anentaimsa pujutan megkaga","poem":1},{"lineBreak":true},{"text":"duka tuke beseak nuninawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah, atum aidautijum,","poem":1},{"lineBreak":true},{"text":"wainka apajuímtai yujagjuminish,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidauk atum pegkegchau takajum nunak takaschagtatui.","poem":1},{"lineBreak":true},{"text":"¡Guilgalnum, tuja Bet-avénnumshakam","poem":1},{"lineBreak":true},{"text":"dakumka najanamu ememattai aina duka emematigpa!","poem":1},{"lineBreak":true},{"text":"¡Nuigtush Tuke Pujuu daajin umiktatjai tusagmek","poem":1},{"lineBreak":true},{"text":"tuu yujaigpajum!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Israel aents aidauk antakchau intimkiu,","poem":1},{"lineBreak":true},{"text":"burro nuwa unuinakchamujai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Nunin aina nunash itugsag Tuke Pujuush","poem":1},{"lineBreak":true},{"text":"uwig tsakatuch chijichi pegkeg samekbau ayamunum","poem":1},{"lineBreak":true},{"text":"kuitamaina ¿imatiksash kuitamkati?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"wainka apajuímtai aidau ememattasajum wakegakjumek","poem":1},{"lineBreak":true},{"text":"emematu yujatajum.","poem":1},{"lineBreak":true},{"text":"¿Atumek datsaamtak wakegajum,","poem":1},{"lineBreak":true},{"text":"atsa shiig anentam atak wakegajum?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Nampenakug nuwa akika dutiktai aina nuna yujajuinawai!","poem":1},{"lineBreak":true},{"text":"Pegkeg takatnak dakituinak,","poem":1},{"lineBreak":true},{"text":"pegkegchau datsanmainun yujajuinawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wainka apajuímtai aina nuninun","poem":1},{"lineBreak":true},{"text":"emematu yujaidau asag,","poem":1},{"lineBreak":true},{"text":"dase chijichi kagakun umpui ajapama numamtuk","poem":1},{"lineBreak":true},{"text":"ajapeam agtatui”, tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}