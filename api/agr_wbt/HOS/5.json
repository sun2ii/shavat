{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":5,"content":[{"type":"heading","content":["Israel aents aidau suwimkan jukiagtin etsegkamu"]},{"type":"verse","number":1,"content":[{"text":"¡Sacerdote aidauwah, antugtuktajum!","poem":1},{"lineBreak":true},{"text":"¡Israel aents aidauwah, antugtuktajum!","poem":1},{"lineBreak":true},{"text":"Apu patayi aidauwah, shiig antuktajum.","poem":1},{"lineBreak":true},{"text":"Atum aidautijum mina aentsug aidau tsanuakjum,","poem":1},{"lineBreak":true},{"text":"wainka apajuímtai aidau ememattajum tusajum","poem":1},{"lineBreak":true},{"text":"dita dakituinaig, waitkasjum muja Tabornum, Mizpanum","poem":1},{"lineBreak":true},{"text":"awekasjum, Sitima pakajin yumigmat taimu","poem":1},{"lineBreak":true},{"text":"ukumkimujai betek awajsauwaitjum duwi","poem":1},{"lineBreak":true},{"text":"suwimkan amastatjime.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efraín wegantu aidauwah,","poem":1},{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"wika atum wajuku ainagme nunak shiig dekajai.","poem":1},{"lineBreak":true},{"text":"Atumek nuwa akika dutiktaijai betek ainagme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nuadui ataktu Apajuí umigkatag tajuminish, atumi pegkegchau takataijum aina nunú","poem":1},{"lineBreak":true},{"text":"nunimainchau etamainawai.","poem":1},{"lineBreak":true},{"text":"Wainka apajuímtai aidau emematuidau asajum","poem":1},{"lineBreak":true},{"text":"minak iina Apajuíjiyapi tujuttsugme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atumek pegkegchau, emebau ainagme,","poem":1},{"lineBreak":true},{"text":"nunin asajum ijina utsam atatjume.","poem":1},{"lineBreak":true},{"text":"¡Judá wegantu aidaushkam dutiksaik ijinam agtatui!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu tsagkugtamjati anentag susami tusag,","poem":1},{"lineBreak":true},{"text":"uwig aidaun, baka aidaun yajuak shimiagtinai,","poem":1},{"lineBreak":true},{"text":"nuninakush Apajuí idaisamu asag, niinak wainkachagtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ditak Tuke Pujuunak umigchau ainawai,","poem":1},{"lineBreak":true},{"text":"dita uchiji aina duka mina uchigchau ainawai.","poem":1},{"lineBreak":true},{"text":"Ima Apajuínak umigchau aina duwi","poem":1},{"lineBreak":true},{"text":"dita nugkenak ditajai ijumag makichik nantuik","poem":1},{"lineBreak":true},{"text":"tsaika emegkam agtatui.","poem":1}]},{"type":"heading","content":["Israel aents aidau Judá wegantu aidaujai suwimkan jukiagtin"]},{"type":"verse","number":8,"content":[{"text":"¡Kachu Guibeánum umpuagtajum,","poem":1},{"lineBreak":true},{"text":"untsu uwija kachuji Ramánum umpuagtajum!","poem":1},{"lineBreak":true},{"text":"¡Adeagtinme tusa umputai Bet-avénnum umpuagtajum!","poem":1},{"lineBreak":true},{"text":"¡Benjamín wegantu aidau ujaktajum aneaku pujustinme!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidaun suwimkan susattajai tiuwaitag","poem":1},{"lineBreak":true},{"text":"duka imanisag uminkattawai tusan etsegjai.","poem":1},{"lineBreak":true},{"text":"Nuna dutika ai, Efraín wegantu aidaun nugkeg","poem":1},{"lineBreak":true},{"text":"yaakat aidaujaí tsaigkam bashiak asatnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Judá wegantu aidaun apuji aidauk","poem":1},{"lineBreak":true},{"text":"aents ajantsuk tikichi nugken kasajin aina","poem":1},{"lineBreak":true},{"text":"nujai betek asag Israel aents aidau nugken atantuinawai.","poem":1},{"lineBreak":true},{"text":"Nunin asagmatai wi kajekbaujui ditanak suwimkan susagtatjai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Israel aents aidauk wainka apajuímtai aina nuninun","poem":1},{"lineBreak":true},{"text":"apajuíma yujau asagmatai,","poem":1},{"lineBreak":true},{"text":"tepejus chichajuinak ajantusash diitsuk","poem":1},{"lineBreak":true},{"text":"dushiki batsamtuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui Israel aents aidaunak,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaujaí ijinattajai.","poem":1},{"lineBreak":true},{"text":"Mamuk numin amuwama numamtuk ashí amuktatjai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja Israel aents aidauk, Judá wegantu aidaujai","poem":1},{"lineBreak":true},{"text":"dita kuashat pegkegchau takamsamujin","poem":1},{"lineBreak":true},{"text":"mai suwimka jukiag waituinak,","poem":1},{"lineBreak":true},{"text":"asirianmaya apu yaimpakti tusag shimutkagtinai,","poem":1},{"lineBreak":true},{"text":"tujash niig makichkish yaigchatnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Israel aents aidaunak,","poem":1},{"lineBreak":true},{"text":"Judá wegantujai leónjai betek jetektatjai,","poem":1},{"lineBreak":true},{"text":"dutikan wiki achikan asaajan ukuktatjai,","poem":1},{"lineBreak":true},{"text":"nuna dutikai ditan ayamjumainuk","poem":1},{"lineBreak":true},{"text":"makichkish atsuttawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dutikan ujumak tsawan pachitsuk idaisan","poem":1},{"lineBreak":true},{"text":"dakastinaitjai awake anentaimjatnume tusan,","poem":1},{"lineBreak":true},{"text":"dutika ai, dita pegkegchau takamsamujin","poem":1},{"lineBreak":true},{"text":"anentaimtusag buu buuttajai egatkagtinai,","poem":1},{"lineBreak":true},{"text":"tawai Apajuí tiuwai, Oseas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}