{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"HOS","translationId":"agr_wbt","name":"Oseas","commonName":"Oseas","title":"Oseas","order":28,"numberOfChapters":9,"sha256":"ebe592d34d1b2c3acb1d6ab0c8f5bb080867d913861b256d8c406f08ab482f17","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/agr_wbt/HOS/14.json","totalNumberOfVerses":111},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel aents aidau pegkegchaun taka batsatu awake anentaimjag dekas Apajuí umigkagmi tiagbau"]},{"type":"verse","number":1,"content":[{"text":"Nuna antukag Israel aents aidau chichainak:","poem":1},{"lineBreak":true},{"text":"“Kaunatajum ataktu wakitki Tuke Pujuu umigkagmi,","poem":1},{"lineBreak":true},{"text":"nii kajegtamak suwimkan amasu akush,","poem":1},{"lineBreak":true},{"text":"nigki wait anenjamag tsagkugtamjattawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jakaujai betek batsatag nunak jimag tsawan asa,","poem":1},{"lineBreak":true},{"text":"nuniachkush kampatum tsawan asa, inantamkimtai","poem":1},{"lineBreak":true},{"text":"niijai ijutkau atatji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu umigtanum kakanmamsagmi!","poem":1},{"lineBreak":true},{"text":"Imaniajinig etsa kashi kashinig jiina numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja numi yagkujutnum yumi yutak nugka uchupiama","poem":1},{"lineBreak":true},{"text":"imanis iina yaimpaktatus tajutjamattawai”, tuidau.","poem":1}]},{"type":"heading","content":["Apajuí Israel aents aidaun aikbau"]},{"type":"verse","number":4,"content":[{"text":"Tusa tiagtai Apajuí ditan ayaak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidauwah,","poem":1},{"lineBreak":true},{"text":"¿itugkainjimki atumnash?","poem":1},{"lineBreak":true},{"text":"Atum mina aneagme tujutjum duka","poem":1},{"lineBreak":true},{"text":"yujagkim kashi kakegak, tuja jegashik kashi kakekau,","poem":1},{"lineBreak":true},{"text":"tsawak kashikmas megkagama numamtuk","poem":1},{"lineBreak":true},{"text":"atumi anenkeg megkaewai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuadui, wi mina profetag aidaun akatja ishiaka ai,","poem":1},{"lineBreak":true},{"text":"yujasag dita mina chichamjun etsejuinamu","poem":1},{"lineBreak":true},{"text":"chaajip iyaak tsaimaina imatijamawaje,","poem":1},{"lineBreak":true},{"text":"wi shiig takamua duka jii keeka tsaaptin emaama imanai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atum mina anentag sujajum nunak wika dakitajai,","poem":1},{"lineBreak":true},{"text":"tuja mina emematjakjum kuntin maajum","poem":1},{"lineBreak":true},{"text":"nuna neje ashí apeajum nunashkam dakitajai.","poem":1},{"lineBreak":true},{"text":"Wika ayatak mina anentinme, nuninak:","poem":1},{"lineBreak":true},{"text":"¡Ametme iina Apajuíjimek! tujuttinme tusan wakegajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tujash mina aentsug aidautigmek,","poem":1},{"lineBreak":true},{"text":"Adágjai betek antakchau intimkiu ainagme,","poem":1},{"lineBreak":true},{"text":"nuadui chicham umiktinun wi amasuitag","poem":1},{"lineBreak":true},{"text":"nunú umikchaugme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaakat Galaadnumak ayatak pegkegchau aidauk","poem":1},{"lineBreak":true},{"text":"magkagtin aidaujai batsatui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sacerdote aidauk jinta Siquemnum wetaya nuwi","poem":1},{"lineBreak":true},{"text":"kasajai betek uuma yujawai,","poem":1},{"lineBreak":true},{"text":"aents nuni wedaun mainak wajijin atankiagtatus.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuja Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau pegkegchau","poem":1},{"lineBreak":true},{"text":"Apajuín umigchau intimkiu aidaun wainkajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja Judá wegantu aidautigmeshkam","poem":1},{"lineBreak":true},{"text":"pegkegmauchik ainatsjume,","poem":1},{"lineBreak":true},{"text":"nuadui atumshakam suwimak jukittagme.","poem":1},{"lineBreak":true},{"text":"“Nunú ashí nagkaemagmatai,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidaunak","poem":1},{"lineBreak":true},{"text":"dita nugken waketjati titinaitjai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}