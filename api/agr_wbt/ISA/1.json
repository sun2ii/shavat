{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":1,"content":[{"type":"heading","content":["Judá wegantu aidauk pegkegchaun takau aidau"]},{"type":"verse","number":1,"content":["Judá wegantu aidaunash waji utugchatak ajitnush ayi nuna pachis Amosa uchijin Isaíasan Apajuí ujakui. Nunak Judá wegantu aidaun apuji aidau Uzías, Jotam, Acaz, Ezequías aatus aajaku aina nunú tsawantin ujakui."]},{"type":"verse","number":2,"content":["Dutikam nuna Isaías etsejak:",{"lineBreak":true},{"text":"Nayaim, nugka aidautigmesh","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu tawa nunú antuktajum.","poem":1},{"lineBreak":true},{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi Israel aents aidaunak mina uchig asagmatai,","poem":1},{"lineBreak":true},{"text":"kuitamkan tsakapakan idaisauwaitjai.","poem":1},{"lineBreak":true},{"text":"Dutikamaitak mina umigtutsuk wijai shiwagmagawaje.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja bakak, yaita niina kuitamnush","poem":1},{"lineBreak":true},{"text":"nunak shiig wainui;","poem":1},{"lineBreak":true},{"text":"tuja burro aidaushkam aents niyai entsamak","poem":1},{"lineBreak":true},{"text":"wekaena nunak shiig dekainawai,","poem":1},{"lineBreak":true},{"text":"untsu mina aentsug Israel aents aina duka","poem":1},{"lineBreak":true},{"text":"wi kuitamsam batsatiatak","poem":1},{"lineBreak":true},{"text":"mina shiwagmatuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“¡Aents ayatak pegkegchaunak takau aidauk,","poem":1},{"lineBreak":true},{"text":"pegkegchau takat aina nuna","poem":1},{"lineBreak":true},{"text":"utuatmamkag batsamin ainawai!","poem":1},{"lineBreak":true},{"text":"¡Tuja pegkegchaun takajaku aina","poem":1},{"lineBreak":true},{"text":"nuna uchiji wegantu aidaushkam,","poem":1},{"lineBreak":true},{"text":"pegkegchaunak dekainayatak,","poem":1},{"lineBreak":true},{"text":"nuninun yujaju asag","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, pegkejam,","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun Apajuíjiya nuna","poem":1},{"lineBreak":true},{"text":"kajimatkiag idaisaje!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atumek dekas intimkiu atag tusajum wakegagme,","poem":1},{"lineBreak":true},{"text":"nunin asagmin shiig kuashat suwimkan amasjime.","poem":1},{"lineBreak":true},{"text":"Imatikamu asajum atumi iyashinig","poem":1},{"lineBreak":true},{"text":"pegkeg ayautkauk atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja atumi buuken pujagbauk esamtsui,","poem":1},{"lineBreak":true},{"text":"tuke imanisag ayawai.","poem":1},{"lineBreak":true},{"text":"¡Nuadui atumek kakakchau wajasugme!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dawemin nagkamas buukmijai","poem":1},{"lineBreak":true},{"text":"ashí atumi iyashig makichkish pegkeg ayautkauk atsawai;","poem":1},{"lineBreak":true},{"text":"tuja anú ibau atumi iyashin ayá nuna","poem":1},{"lineBreak":true},{"text":"ampia pempenjamag kuitamak","poem":1},{"lineBreak":true},{"text":"etsaentamainuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja najaimagminish aceiteyai yakagtamjagkesh, imijtugmakchaje.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Atumi nugkenak yaaktajum aidaujai","poem":1},{"lineBreak":true},{"text":"shiwag aidau tsaikagmatai,","poem":1},{"lineBreak":true},{"text":"agkan shiig pujumainchau wajase.","poem":1},{"lineBreak":true},{"text":"Tuja yaakat aidau apeamu keenawai.","poem":1},{"lineBreak":true},{"text":"Tuja atum ajakmamu aidaunmayan","poem":1},{"lineBreak":true},{"text":"shiwag aidau juukag atumesh wainjuminig amuinawai.","poem":1},{"lineBreak":true},{"text":"Yaunchuk yaakat Sodoma tsaikam","poem":1},{"lineBreak":true},{"text":"atsau agkan juwakua numamtuk wajase”,","poem":1},{"lineBreak":true},{"text":"tujamui Apajuí.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Untsu ima Jerusalégkak tsaikchamu juwake,","poem":1},{"lineBreak":true},{"text":"nuniku asa melón ajakbaunum nuna ejapeen","poem":1},{"lineBreak":true},{"text":"makichik aak aakmaka pachitsuk idaisamu aama","poem":1},{"lineBreak":true},{"text":"numamtuk wajas awai.","poem":1},{"lineBreak":true},{"text":"Nuniak nuigtushkam makichik yaakat","poem":1},{"lineBreak":true},{"text":"shiwag tenteam aama numamtin wajas awai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuu ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"jutii ainag nuwiyan ujumak uwemtikchakuig,","poem":1},{"lineBreak":true},{"text":"iik sodomanmaya aents, gomorranmaya","poem":1},{"lineBreak":true},{"text":"aents aidaujai ijinauwa numamtukes wajakagtai.","poem":1}]},{"type":"heading","content":["Israel aents aidau Apajuín dekaskenum emematchagbau"]},{"type":"verse","number":10,"content":[{"text":"Israel aents aidaun apuji aidautigmek,","poem":1},{"lineBreak":true},{"text":"sodomanmaya tuja gomorranmaya aents","poem":1},{"lineBreak":true},{"text":"aidaun apuji pegkegchau aajaku aina nunin wajasugme.","poem":1},{"lineBreak":true},{"text":"Nuadui Tuke Pujuun chichamega nunú","poem":1},{"lineBreak":true},{"text":"shiig antuka jukitajum.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“¡Atum Apajuí anentag suwaji tusajum,","poem":1},{"lineBreak":true},{"text":"kuntin aidau maajum mina emematjaku","poem":1},{"lineBreak":true},{"text":"kuntin patai apetainum patagjum,","poem":1},{"lineBreak":true},{"text":"nuna neje ashí apeajum nunak wika dakitajai!","poem":1},{"lineBreak":true},{"text":"¡Ataktuk sujusaigpa!","poem":1},{"lineBreak":true},{"text":"Tuja toro aidaun wiyaji, uwig aishmag aidaun,","poem":1},{"lineBreak":true},{"text":"chivo tsakat aidaun numpen wainkunchakam","poem":1},{"lineBreak":true},{"text":"tsumajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wika mina emematjitasajum minakjum,","poem":1},{"lineBreak":true},{"text":"kuntin aidau ikaunmatajum tusanuk","poem":1},{"lineBreak":true},{"text":"makichkish atumnak segatsjime.","poem":1},{"lineBreak":true},{"text":"Atumek mina dushiktakjum,","poem":1},{"lineBreak":true},{"text":"mina jegag pegkegma nunú","poem":1},{"lineBreak":true},{"text":"pegkegchau ematasajum kaunjume.","poem":1},{"lineBreak":true},{"text":"¡Juju jega mina emamatjaku ijuntaya juwig batsamtsuk,","poem":1},{"lineBreak":true},{"text":"jiinja shiyaktajum!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ataktu awagkigmek anentag mina sujamu","poem":1},{"lineBreak":true},{"text":"pegkegchau aina juninuk itagtuawaigpa.","poem":1},{"lineBreak":true},{"text":"Nunú apeamua nunak wika tsumain diyajai.","poem":1},{"lineBreak":true},{"text":"Tuja nantu yama takamunum Apajuí emematku jiistamtai,","poem":1},{"lineBreak":true},{"text":"nuigtu tsawan ayamtain","poem":1},{"lineBreak":true},{"text":"jiistamtai ati tusa umikbauwa nunú","poem":1},{"lineBreak":true},{"text":"jiistamami tusajum aents aidau ipajum ijumjume,","poem":1},{"lineBreak":true},{"text":"tujash wika aents pegkegchaun takau aidau","poem":1},{"lineBreak":true},{"text":"jiistamaina nunak shiig dakitajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nantu yama takamunum jiistamjum nunak wika dakitajai;","poem":1},{"lineBreak":true},{"text":"¡Nunú jiistamjum nunak dakitmain diyajai,","poem":1},{"lineBreak":true},{"text":"nuniakun katsuntu pujumainchau dekapeajai!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja atum mina aujtustasajum uwejum takuajum nunak","poem":1},{"lineBreak":true},{"text":"wika makichkish diyatsjime;","poem":1},{"lineBreak":true},{"text":"tuja antugtanakesh antugtsujime.","poem":1},{"lineBreak":true},{"text":"Tuja atumek kuashat aents mainaitjum duwi,","poem":1},{"lineBreak":true},{"text":"uwejum takuajum duka ayatak numpak ainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Nijamaktajum!","poem":1},{"lineBreak":true},{"text":"¡Pegkegchaujum aidau diitan dakitajai!","poem":1},{"lineBreak":true},{"text":"¡Pegkegchau takatak idaisatajum!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Pegkeja nunú takat unuimagtajum,","poem":1},{"lineBreak":true},{"text":"kakanmamsatajum pegkeg takatnum,","poem":1},{"lineBreak":true},{"text":"nuniakjum aents waitkam batsata nunú yaigtajum,","poem":1},{"lineBreak":true},{"text":"dutikakjum uchi bitaik aidaush,","poem":1},{"lineBreak":true},{"text":"tuja waje aidaushkam ayamjuktajum!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tuke Pujuu chichagtamak:","poem":1},{"lineBreak":true},{"text":"“Yamai juju pachisa atumjai chichasmi.","poem":1},{"lineBreak":true},{"text":"Tuja atumi tudaujum numpa kapantua imanaitkuish,","poem":1},{"lineBreak":true},{"text":"wi nunak esakatjan yujagkim pujua iman awajtustatjime;","poem":1},{"lineBreak":true},{"text":"tuja jáanch numpa kapantui egkekbauwa imanaitkuish,","poem":1},{"lineBreak":true},{"text":"wi nunak esakatjan lana pujuama iman awajtustatjime.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Atum mina umigtakjumek,","poem":1},{"lineBreak":true},{"text":"atumi nugkem pegkeja nuwi ajakmajum yuwattagme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Untsu atum ayatak intimkugmek,","poem":1},{"lineBreak":true},{"text":"duka maaniamunum ijina utsam atatjume”,","poem":1},{"lineBreak":true},{"text":"tujamui Tuke Pujuu tusa, Isaías tiuwai.","poem":1}]},{"type":"heading","content":["Apajuí Jerusalégnak iwajattawai"]},{"type":"verse","number":21,"content":[{"text":"¡Jerusalégnumia aents aidauk","poem":1},{"lineBreak":true},{"text":"yaunchkek shiig anentaimkau, waitjuchu, pegkeg aajabi,","poem":1},{"lineBreak":true},{"text":"tujash yamaik nuwa wainka akika dutiktaijai betek,","poem":1},{"lineBreak":true},{"text":"magkagtin wajasu ainawai!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Atumek plata pegkejama iman ayugme,","poem":1},{"lineBreak":true},{"text":"tujash yamaik utsagbaujai betek wajasugme.","poem":1},{"lineBreak":true},{"text":"Yaunchkek vino pegkeja iman ayugme,","poem":1},{"lineBreak":true},{"text":"tujash yamaik chujuin wajasugme.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Atumi apuji aidauk aents intimkiu,","poem":1},{"lineBreak":true},{"text":"pegkegchau aina nuna kumpaji ainawai.","poem":1},{"lineBreak":true},{"text":"Kuichik akiam, tuja waji aidau suwam","poem":1},{"lineBreak":true},{"text":"nuna juwinak,","poem":1},{"lineBreak":true},{"text":"aents takamsachunak jujuwai takamsauk tuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja bitaik aidaunash, waje aidaunash waitkainawai,","poem":1},{"lineBreak":true},{"text":"dutikainau asag makichkish yainatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nuadui apu Tuke Pujuu ashí senchigtina nunú chichaak:","poem":1},{"lineBreak":true},{"text":"“¡Ditak mina shiwag ainawai,","poem":1},{"lineBreak":true},{"text":"nuadui wi ditanak suwimkan susagtatjai!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dutikakun dita tudaujinak waji pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"apetia numamtuk apean utsankattajai,","poem":1},{"lineBreak":true},{"text":"dutikan dita pegkegchau takamtaiji aina nunak esakatjattajai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dutikan yaunchuk apu chichama epegkin aidau,","poem":1},{"lineBreak":true},{"text":"chichagkagtin aidau shiig takau,","poem":1},{"lineBreak":true},{"text":"waitjuchu aajabia nujai betek emaktatjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai: ‘Jerusalégnumia aents aidauk,","poem":1},{"lineBreak":true},{"text":"pegkejan takau aidau’, nuigtu:","poem":1},{"lineBreak":true},{"text":"‘Ima Apajuínak umijin aidau’, tujamtin ainawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Wika wait anenkagtin asan,","poem":1},{"lineBreak":true},{"text":"nuigtush uwemtikagtin asan,","poem":1},{"lineBreak":true},{"text":"Jerusalégnumia aents aidau mina umigtuinakuig,","poem":1},{"lineBreak":true},{"text":"wainka waitkam yujakuish,","poem":1},{"lineBreak":true},{"text":"wi ditanak ayamjuktinaitjai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Untsu aents pegkegchaun takau aina duka","poem":1},{"lineBreak":true},{"text":"ashí jinawagtinai,","poem":1},{"lineBreak":true},{"text":"wagki mina umigtutan dakituidau asag.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tuja atum aidautijum anú yagkug aidau,","poem":1},{"lineBreak":true},{"text":"tuja numi encina aidau ayá nunú shiig wakejusjum","poem":1},{"lineBreak":true},{"text":"kuitamjum nuwi wainka apajuímtai aidau","poem":1},{"lineBreak":true},{"text":"emematjum nunú diisjum datsagtinaitjume.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Atum aidautigmek, numi encina duke kakekamtai,","poem":1},{"lineBreak":true},{"text":"wentsamtug wajama numamtin,","poem":1},{"lineBreak":true},{"text":"tuja yagkug yumi ukattsuk idaisamujai betek atinaitjume.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tuja atum ainajum anuiya senchigtina duka","poem":1},{"lineBreak":true},{"text":"chijichi kagaju apeam megkagama","poem":1},{"lineBreak":true},{"text":"numamtuk megkaejatnai.","poem":1},{"lineBreak":true},{"text":"Niina tudauji aina nunuwai jii kegaujai beteka duka.","poem":1},{"lineBreak":true},{"text":"Nuniau asa nunú chijichinak apea ajapeawai.","poem":1},{"lineBreak":true},{"text":"Nuadui niina tudaujijai esatnai,","poem":1},{"lineBreak":true},{"text":"tuja nuna ikagnamainuk makichkish atsutnai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":31}