{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":11,"content":[{"type":"heading","content":["David wegantunmaya apu wajas agkan pujutan sukagtustinai tibau"]},{"type":"verse","number":1,"content":[{"text":"David wegantuk numijai betek ajaka ajuamu atatui,","poem":1},{"lineBreak":true},{"text":"tujash nuna wajautinia yamajam jeeka tsapaitnai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunikmatai Tuke Pujuu Wakani niyai pujus","poem":1},{"lineBreak":true},{"text":"unuimatan, shiig anentaimtan, senchimetan,","poem":1},{"lineBreak":true},{"text":"tuja Apajuín shiig wainu asamtai,","poem":1},{"lineBreak":true},{"text":"puyatjus umigtan susatnai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunú apuk aentsnak ayatak diisagkek","poem":1},{"lineBreak":true},{"text":"suwimkanak susashtinai,","poem":1},{"lineBreak":true},{"text":"tuja nuigtush ayatak chichaman antamuikik,","poem":1},{"lineBreak":true},{"text":"nuni ati tusag chichamnak iwajachagtinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aents kasagtai aidau,","poem":1},{"lineBreak":true},{"text":"ujudauch aidaujai waitkam batsata nuna ayamjuktinai,","poem":1},{"lineBreak":true},{"text":"dutikak untsu aents magkagtin,","poem":1},{"lineBreak":true},{"text":"pegkegchau aidaunak suwimkan susa ijinatnai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niig pegkeg takatan","poem":1},{"lineBreak":true},{"text":"dekaskea nujai ayamjak maanitkatnai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja nunú tsawan jegamtaig,","poem":1},{"lineBreak":true},{"text":"lobo uwigjai ijunag pujuagtinai;","poem":1},{"lineBreak":true},{"text":"ikamyawa chivojai ijunag kanitnai,","poem":1},{"lineBreak":true},{"text":"untsu baka leónjai ijunag wekagas tsakagtinai,","poem":1},{"lineBreak":true},{"text":"tuja uchi aidau nuna yutaijin ayujuinak yajuak awekaidiagtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja baka nuwa, chayú nuwajai shiig kumpaji agtinai,","poem":1},{"lineBreak":true},{"text":"tuja uchiji aidaushkam nujai ijunag kajiitnai,","poem":1},{"lineBreak":true},{"text":"tuja leónshakam bueyejai ijunag chijichin yuwagtinai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja uchi piipich aidaushkam dapijai wasugkabiagtinai,","poem":1},{"lineBreak":true},{"text":"dapi pasugken pujaunash inua achiagtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunú tsawantinig Tuke Pujuu mujanum puja nuig","poem":1},{"lineBreak":true},{"text":"pegkegchau awajkagtumainuk makichkish atsutnai,","poem":1},{"lineBreak":true},{"text":"wagki yumi nayantsanum pima numamtuk,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu imanjinak ashí nugkanum dekawagtin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":9}