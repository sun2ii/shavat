{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":2,"content":[{"type":"heading","content":["Ashí nugkanmaya aents aidauk agkan batsamsagtin ainawai"]},{"type":"verse","number":1,"content":["Apajuí Judá wegantu aidaun, Jerusalégjai pachis, Amosa uchijin Isaíasan ujakua duka jujuwai:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apajuí emematku ijuntai","poem":1},{"lineBreak":true},{"text":"mujanum jegamkamu awa duka","poem":1},{"lineBreak":true},{"text":"atakea duish eme anentsa diitai atinai.","poem":1},{"lineBreak":true},{"text":"Nuna diinak kuashat aents","poem":1},{"lineBreak":true},{"text":"tikich nugkanmaya aidau kauniagtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuashat aents aidau kaunainak:","poem":1},{"lineBreak":true},{"text":"“¡Minitajum au muja Tuke Pujuu etegkamua awi wakagmi,","poem":1},{"lineBreak":true},{"text":"tuja jega Apajuí emematku ijuntai","poem":1},{"lineBreak":true},{"text":"jegamkamua awi wakagmi.","poem":1},{"lineBreak":true},{"text":"Awi Apajuí niina chichamen jintinjamamtai,","poem":1},{"lineBreak":true},{"text":"nunú antuka nii tabauwa duke umikagmi!” titinai.","poem":1},{"lineBreak":true},{"text":"Wagki nii chichame umiktin agagbauwa duka Siógnumia wantintinai.","poem":1},{"lineBreak":true},{"text":"Tuja niina chichameshkam","poem":1},{"lineBreak":true},{"text":"Jerusalégnumia jiinki antuetinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja nugka múun aidaunmayanash","poem":1},{"lineBreak":true},{"text":"Apajuí dita pegkegchaujin diijus suwimkan susatnai.","poem":1},{"lineBreak":true},{"text":"Nuadui ashí nugka múun aidaunmayag","poem":1},{"lineBreak":true},{"text":"dita maanitaiji aidaunak ajak ajakmaku nugka pukutai,","poem":1},{"lineBreak":true},{"text":"arroz tsupitain najankatin ainawai.","poem":1},{"lineBreak":true},{"text":"Dutikawagmatai maaniamuk nagkankatnai,","poem":1},{"lineBreak":true},{"text":"tuja maaniatin jintiamushkam atsustinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun chichamega nunú antuka betek umikagmi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":5}