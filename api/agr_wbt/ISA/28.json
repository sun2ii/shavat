{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":28,"content":[{"type":"heading","content":["Yaakat Samaria tsainkattawai tusa etsegkamu"]},{"type":"verse","number":1,"content":[{"text":"¡Chah, Samariayah,","poem":1},{"lineBreak":true},{"text":"amina nugkemek pegkeg","poem":1},{"lineBreak":true},{"text":"shiig tsapau wajasuitam duwi,","poem":1},{"lineBreak":true},{"text":"Efraín aents nampen aina duka aminí ememainawai!","poem":1},{"lineBreak":true},{"text":"Untsu atumi apujig yagkug pegkejuch aidau","poem":1},{"lineBreak":true},{"text":"kagaka megkagama numamtuk megkagainawai.","poem":1},{"lineBreak":true},{"text":"Samarianmak ima aents nampen aina duke piyak awai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Makichik aents senchigtin","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu etegkamu pujawai,","poem":1},{"lineBreak":true},{"text":"niina senchijig bicha kakegak ishamain wajama imanai,","poem":1},{"lineBreak":true},{"text":"tuja dase senchi dasentak magkagtina iman,","poem":1},{"lineBreak":true},{"text":"yumi senchi yutug, nujag pimak ijijatna imanai.","poem":1},{"lineBreak":true},{"text":"Iman asa samarianmaya aents","poem":1},{"lineBreak":true},{"text":"aidaunak makichkia shitamuik ajuattawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dutikak Efraín wegantu nampen wajasu aidau,","poem":1},{"lineBreak":true},{"text":"yaakat Samaria pegkeg asamtai,","poem":1},{"lineBreak":true},{"text":"emema batsata nunak nii tsaika ajapatnai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dutikamtai nunú nugka pegkegnum","poem":1},{"lineBreak":true},{"text":"yagkug kagaku ayá duka,","poem":1},{"lineBreak":true},{"text":"higo tsamajun aents ajantutsuk akaka yuwa","poem":1},{"lineBreak":true},{"text":"amuwama numamtuk awajam agtatui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Untsu nunú tsawantin aents niina umijin aidau","poem":1},{"lineBreak":true},{"text":"iwaku juwagtina nuna atsejutaiji, dekas pegkeg atina duka,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunuwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja apu chichama epegkin aidaunashkam","poem":1},{"lineBreak":true},{"text":"Apajuí shiig takau emaktinai,","poem":1},{"lineBreak":true},{"text":"tuja suntag yaaktan kuitamin aidaunash wajiumitkaktinai.","poem":1}]},{"type":"heading","content":["Jerusalégnak tsaikagtatui tusa etsegkamu"]},{"type":"verse","number":7,"content":[{"text":"Tuja profeta aidaushkam sacerdote aidaujai,","poem":1},{"lineBreak":true},{"text":"senchi vinon umuidau asag,","poem":1},{"lineBreak":true},{"text":"nampejag winchainainak tukumak iyá yujawai;","poem":1},{"lineBreak":true},{"text":"imanik nampedau asag,","poem":1},{"lineBreak":true},{"text":"Apajuí chichamenak antukchamin batsatui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuadui dita mesajinig","poem":1},{"lineBreak":true},{"text":"ayatak tsumain iyakbau ayawai,","poem":1},{"lineBreak":true},{"text":"makichkish iyaka tsuwapachbauk atsawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja mina chichagtuinak:","poem":1},{"lineBreak":true},{"text":"“¡Taata nunikam aminash Apajuísh","poem":1},{"lineBreak":true},{"text":"wajina iwaintugmake, nunú uchi piipich","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"papii augchau unuimagti","poem":1},{"lineBreak":true},{"text":"tusa a, ba, cha, da, jintinmaina numamtuk","poem":1},{"lineBreak":true},{"text":"jintinkagtuata!” tusa dushiktuinawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja atumek nampekjum","poem":1},{"lineBreak":true},{"text":"pegkegchau chichá batsatu asajum,","poem":1},{"lineBreak":true},{"text":"chicham antut dakitau asagmin,","poem":1},{"lineBreak":true},{"text":"aents tikich chichaman chichaaku aidau","poem":1},{"lineBreak":true},{"text":"amuktinme tusa Apajuí idaitamsattawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaunchuk Apajuí chichagtamainak:","poem":1},{"lineBreak":true},{"text":"“Juwig utugchatak atsawai, juwi ayamainaitjume,","poem":1},{"lineBreak":true},{"text":"aents pimpikiuk ayamsati”, tusa tujabiuwai.","poem":1},{"lineBreak":true},{"text":"Tujash atumek tusa tujamaig antugkachuitjume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu atumnak","poem":1},{"lineBreak":true},{"text":"uchi piipich papii augtan unuimagti tusa","poem":1},{"lineBreak":true},{"text":"chichagmaina numamtuk chichagtamkattawai.","poem":1},{"lineBreak":true},{"text":"Uchi piipich yama wekagama numamtin atatjume,","poem":1},{"lineBreak":true},{"text":"nunin asajum tuntupmin iyagjum,","poem":1},{"lineBreak":true},{"text":"najaimakjum nantakchamin dekaptatjume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Atum datsantainchau aidau","poem":1},{"lineBreak":true},{"text":"Jerusalégnum apu wajasjum, inamak batsatu aidautijum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu tujama nunú antuktajum.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Atum chichaakjum:","poem":1},{"lineBreak":true},{"text":"“Ii aidautik jinau aidaujai chicham umikji”, tajume.","poem":1},{"lineBreak":true},{"text":"Tuja atumek asirianmaya suntag aidau ishamakjum","poem":1},{"lineBreak":true},{"text":"iwanchnum sujumankaugme, nii kuitamjamkati tusajum.","poem":1},{"lineBreak":true},{"text":"Nuniku asajum, chichakjum:","poem":1},{"lineBreak":true},{"text":"“Iinak makichkish mantamainchau ainawai,","poem":1},{"lineBreak":true},{"text":"wagki nunú iina shiwaaji aidaunak","poem":1},{"lineBreak":true},{"text":"tsanuja dushijattawai”, tajume.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Siógnum makichik kaya etegkamu shiig pegkeg akikan apusattajai,","poem":1},{"lineBreak":true},{"text":"nunú atatui dekas ima eme anentsa diitai.","poem":1},{"lineBreak":true},{"text":"Nunú kayanum ekeni jegamnaktatui.","poem":1},{"lineBreak":true},{"text":"Nunú kayanum kajinas anentaimaidauk","poem":1},{"lineBreak":true},{"text":"shiig agkan batsamsagtinai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nunú jegamku, tunin ai tusa","poem":1},{"lineBreak":true},{"text":"plomo nená diitia numamtin","poem":1},{"lineBreak":true},{"text":"atatui shiig takamua nunú.","poem":1},{"lineBreak":true},{"text":"“Atumek egiptunmaya aidau","poem":1},{"lineBreak":true},{"text":"ayamjutpaktatui tajume,","poem":1},{"lineBreak":true},{"text":"tujash ditanak asirianmaya suntag senchigtin aidau","poem":1},{"lineBreak":true},{"text":"namak dujajak tajaka ajapama numamtuk ijinawagtinai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}