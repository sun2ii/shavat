{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":30,"content":[{"type":"heading","content":["Egiptunmaya aents aidaun emematin aidau pachisa etsegkamu"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“¡Chah, mina uchig intimkiu aina nunak,","poem":1},{"lineBreak":true},{"text":"wait anentuinajai, wijai chichatsuk,","poem":1},{"lineBreak":true},{"text":"wi inachmaitak dita wakegamun takasagtatus chichaman uminawai!","poem":1},{"lineBreak":true},{"text":"¡Nuninak aan kuashat tudaun utuatmamainawai!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuja mina inintsuk Egipto nugka apuji","poem":1},{"lineBreak":true},{"text":"ayamjutpakti tusag pisajuinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tujash Egipto nugka apujig,","poem":1},{"lineBreak":true},{"text":"wi ayamjuktajime tiuwaitak,","poem":1},{"lineBreak":true},{"text":"ditanak ayamjukchattawai,","poem":1},{"lineBreak":true},{"text":"dutikam egiptunmaya aidaunum yunumka uwemjami tukama datsajagtatui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"Soán nugkanum yaakat ayá imanui,","poem":1},{"lineBreak":true},{"text":"tuja yaakat Hanés tutaya imanuishkam","poem":1},{"lineBreak":true},{"text":"aents atumin chichamjutpaktin aidau ishiaku akugmesh,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nunú nugkanmaya aidauk atumnak tsanupajagtatui,","poem":1},{"lineBreak":true},{"text":"ditak makichkish yaimpakchagtatui,","poem":1},{"lineBreak":true},{"text":"ayatak utugchatan itagtamawagmatai,","poem":1},{"lineBreak":true},{"text":"waitiakjum datsagtatjume”, tiuwai Apajuí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuja Isaías chichaak: “Juna Apajuí aatus tawai:","poem":1},{"lineBreak":true},{"text":"‘Israel aents aidauk egiptunmaya aents aidau","poem":1},{"lineBreak":true},{"text":"ayamjutpaktinme tusag dita wajiji aidaun,","poem":1},{"lineBreak":true},{"text":"dita burrojin, camellojin aatus patag yajuakag,","poem":1},{"lineBreak":true},{"text":"Néguev nugka ishamain, león aidau,","poem":1},{"lineBreak":true},{"text":"dapi aidau, dragón nanamtin aidau","poem":1},{"lineBreak":true},{"text":"aatus ayamunum shimuinawai,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"tujash egiptunmaya aidauk","poem":1},{"lineBreak":true},{"text":"kakagmachu tikima wainkauch ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui dita daajinak:","poem":1},{"lineBreak":true},{"text":"“Kuntin múun shinakush wainak imatin”","poem":1},{"lineBreak":true},{"text":"tuu adaikauwaitjai’ tawai Apajuí”, tiuwai Isaías.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tusa inagnakmatai Apajuí Isaíasan chichajak:","poem":1},{"lineBreak":true},{"text":"“Wi timag nunú yamai numi pakama najanamunum agagta,","poem":1},{"lineBreak":true},{"text":"atakea duwish wi tibauwa nuna tuke adeagtin atinme”, tiuwai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tusa tima Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aidauk intimkiu asag,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu chichame umiktin agagbauwa","poem":1},{"lineBreak":true},{"text":"nunú umitnak dakituinawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nunidau asag Apajuí chichamen etsejin","poem":1},{"lineBreak":true},{"text":"profeta aidaun chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Yamai nagkamsagmek atum kajanum wainkamu aidauk etseju yujaigpa.","poem":1},{"lineBreak":true},{"text":"Tuja chicham pegkeg dekaskea dushakam ujajatkaigpa;","poem":1},{"lineBreak":true},{"text":"duka idaikujum dekas nugkaya waji pegkeg aidau ayá","poem":1},{"lineBreak":true},{"text":"nunú ujajatkatajum.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja jinta pegkegnum atum wegajum duka idaisatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum ataktu awagkigmek,","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun Apajuíji pegkegma nunú","poem":1},{"lineBreak":true},{"text":"pachisjumek aujkagtusaigpa’, tuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui Israelan Apajuíji pegkegma nunú chichaak:","poem":1},{"lineBreak":true},{"text":"‘Atumek ujamash dakitagme,","poem":1},{"lineBreak":true},{"text":"nuniakjum ayatak pegkegchau, magkagtut,","poem":1},{"lineBreak":true},{"text":"waitjut aina nunú takatnum eme anenmamjume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui atumek atumi tudaugmin","poem":1},{"lineBreak":true},{"text":"nugka peegmagbau pachiachbau yumpuna","poem":1},{"lineBreak":true},{"text":"iyauwama numamtin ainagme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja ichinak najanamu ashí tsainak ajapnamtai,","poem":1},{"lineBreak":true},{"text":"jii kaijigkesh chimpia jumainchau,","poem":1},{"lineBreak":true},{"text":"tuja yumikesh shikimainchau wegama numamtuk,","poem":1},{"lineBreak":true},{"text":"Apajuí ditanak ashí tsaika emegkagtatui.’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu Israel aents aidaun Apajuíji","poem":1},{"lineBreak":true},{"text":"pegkegma nunú chichaak:","poem":1},{"lineBreak":true},{"text":"‘Ataktu mina umigtuktajum,","poem":1},{"lineBreak":true},{"text":"nuniakjumin wi senchimtikattajime.","poem":1},{"lineBreak":true},{"text":"Tuja dekas minai kajintsajum anentaimkugmek,","poem":1},{"lineBreak":true},{"text":"wainkajum chichá batsamtsuk takamtak batsamsatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum uwemjattagme’, tujamui.","poem":1},{"lineBreak":true},{"text":"Tujash atumek nunú dakitau asajum,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"chichaakjum:","poem":1},{"lineBreak":true},{"text":"‘Atsa, dekas caballonum, ekemi pisajagmi’, tajume.","poem":1},{"lineBreak":true},{"text":"Kame takugmek pisagtajum.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam chichaakjum:","poem":1},{"lineBreak":true},{"text":"‘Carronum egkemja pisagmi’, tajume.","poem":1},{"lineBreak":true},{"text":"Kame takugmek nuniktajum,","poem":1},{"lineBreak":true},{"text":"tujash atumin aintamaidau ima senchi tupikainau","poem":1},{"lineBreak":true},{"text":"asag amaintamkagtatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nuadui makichik aents awanmaig,","poem":1},{"lineBreak":true},{"text":"nuna ishamainak mil aents pisajagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja cinco aents awanmakuig nunú ishamakjum,","poem":1},{"lineBreak":true},{"text":"atumek ashí pisagtinaitjume.","poem":1},{"lineBreak":true},{"text":"Nunikagmin ujumchik juwakag,","poem":1},{"lineBreak":true},{"text":"makichik numi mujanum ajiamu wajama numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja mujanum numi ajiamunum bandera jiikbau","poem":1},{"lineBreak":true},{"text":"makichik wajama numamtuk juwaktatjume.","poem":1}]},{"type":"heading","content":["Apajuí Israel aents aidaun uwemtijatin"]},{"type":"verse","number":18,"content":["“Untsu atum tsagkugnagtin tsawan jegamtai, Tuke Pujuu atumin wait anenjamag atumi tudaugmin tsagkugtamjattawai. Apajuík niina anenken iwaintugmaktatus wakegawai, wagki niig pegkegchaunak dakitin asa, ima pegkeja nunak takauwai. ¡Nuadui Apajuíyai kajinas anentaimaidauk shiig aneasagtin ainawai!” tiuwai Isaías."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":18}