{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":31,"content":[{"type":"heading","content":["Egiptunmaya suntag aidau ayamjutpakagtatui tinu aidau pachisa ujakbau"]},{"type":"verse","number":1,"content":[{"text":"Egipto nugkanmaya aidaun caballoji maanitai aidau kuashat,","poem":1},{"lineBreak":true},{"text":"tuja carrojishkam imanisag asagmatai,","poem":1},{"lineBreak":true},{"text":"Israel aents aidauk dita yaimpaktinme tusag","poem":1},{"lineBreak":true},{"text":"shimutuina nunak wait anentuinajai,","poem":1},{"lineBreak":true},{"text":"wagki Israel aents aidau ememattai","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu pegkegma nunú yaimpakti tusag,","poem":1},{"lineBreak":true},{"text":"niina segamainun idayinak wainak yujau asagmatai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tujash Apajuík makichkish tsanushtayai,","poem":1},{"lineBreak":true},{"text":"iman asa suwimkan sukagtinai,","poem":1},{"lineBreak":true},{"text":"tuja nii dutikatjai tibaun yapajiag idaichauwai,","poem":1},{"lineBreak":true},{"text":"betek uminai.","poem":1},{"lineBreak":true},{"text":"Apajuík aents pegkegchaun takau aidaun","poem":1},{"lineBreak":true},{"text":"yayaunak suwimkan susa ijinatnai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egiptunmaya aidauk Apajuíchu ainawai,","poem":1},{"lineBreak":true},{"text":"ditak aents ainawai;","poem":1},{"lineBreak":true},{"text":"tuja caballoji aidaushkam iyashtin ainawai, wakankesh ainatsui.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ditanak suwimkan susattawai.","poem":1},{"lineBreak":true},{"text":"Nuadui Israel aents aidauk ya ditan ayamjawa","poem":1},{"lineBreak":true},{"text":"nujai betek suwimkan jukiag jinawagtatui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuu chichagtak tujutmae:","poem":1},{"lineBreak":true},{"text":"“León uwijan maamtai, uwijan kuitamin aidau tuwakag,","poem":1},{"lineBreak":true},{"text":"senchi untsumkag leónkan uwakatajtakush","poem":1},{"lineBreak":true},{"text":"uwakmainchau ainawai.","poem":1},{"lineBreak":true},{"text":"Numamtuk Tuke Pujuu ashí senchigtina nunú taattawai muja Siógnum","poem":1},{"lineBreak":true},{"text":"niina aentsji aidaun ayamjuktatus.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja chigki nanaak wekagas","poem":1},{"lineBreak":true},{"text":"niina uchijin kuitamama numamtuk,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"Jerusalégnak kuitamak uwemtikattawai,","poem":1},{"lineBreak":true},{"text":"dutika ayamjuk agkanmitkattawai.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atum tudau, chicham imtimkiu akugmesh,","poem":1},{"lineBreak":true},{"text":"ataktu Apajuí umigkatajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wagki atum aidautijum,","poem":1},{"lineBreak":true},{"text":"oro, plata aidaujai atum dakumka najanamu aidau","poem":1},{"lineBreak":true},{"text":"emematjum nunú idaisagminig,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"asirianmaya aents aidauk ijina utsam agtatui,","poem":1},{"lineBreak":true},{"text":"tujash nunak aents aidauk ijinashtatui,","poem":1},{"lineBreak":true},{"text":"ayatak maaniamun ishamainak pisajagtatui,","poem":1},{"lineBreak":true},{"text":"tuja datsauch maanitan yacha aidaush","poem":1},{"lineBreak":true},{"text":"wainka inaku waitkatai wajasagtatui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja dita apujig nuna ishamak tupikaki jiinkittawai,","poem":1},{"lineBreak":true},{"text":"tuja suntaja apuji aidaushkam banderajinak ukuinak pisajagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja junashkam Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Niina shiwaaji aidaun suwimak susatnujig","poem":1},{"lineBreak":true},{"text":"Jerusalégnum umikbau awai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}