{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":32,"content":[{"type":"heading","content":["Makichik aents apu wajas pegkegnum inamjatin"]},{"type":"verse","number":1,"content":[{"text":"Makichik aents apu atinai","poem":1},{"lineBreak":true},{"text":"pegkegnak inamjatin,","poem":1},{"lineBreak":true},{"text":"tuja nuna atuwe aidaushkam","poem":1},{"lineBreak":true},{"text":"shiig takasagtin ainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aents aidauk shiwag jeteamash,","poem":1},{"lineBreak":true},{"text":"tuja utugchatnum jegainakush,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchau takainak waitkainamash,","poem":1},{"lineBreak":true},{"text":"nunú apu aidau shiig takaidau asagmatai,","poem":1},{"lineBreak":true},{"text":"ditai yunumak ayamjumaktin ainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuadui Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"wainmachu wainmamaina numamtuk","poem":1},{"lineBreak":true},{"text":"Apajuínak pan wainkagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninak Apajuí chichamesh wajintua","poem":1},{"lineBreak":true},{"text":"nuna puyatjus antuktatus wakeyagtinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuadui waugtutsuk emamkemas takasagtatui,","poem":1},{"lineBreak":true},{"text":"nuninak dekaskea nuna shiig antumainun chichagtatui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents pegkegchau, tsanumin aina duka","poem":1},{"lineBreak":true},{"text":"eme anentsa diyam achagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wagki aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"ima pegkegchaunak chichawai;","poem":1},{"lineBreak":true},{"text":"tuja niina anentainish ayatak pegkegchau takatnak anentaimui;","poem":1},{"lineBreak":true},{"text":"nuniak magkagtuta nuna wekaetawai,","poem":1},{"lineBreak":true},{"text":"tuja Apajuínash tsanumjuinak pegkegchaun","poem":1},{"lineBreak":true},{"text":"chichajuinawai;","poem":1},{"lineBreak":true},{"text":"nunidau asag aents nujantai waitiaunash,","poem":1},{"lineBreak":true},{"text":"tuja kitakai waitiaunashkam ajampenatsui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents waitjin aina nuna ayamjumataijig ishamainai;","poem":1},{"lineBreak":true},{"text":"tuja pegkegchau takastinun niina anentain umiawai;","poem":1},{"lineBreak":true},{"text":"Nunin asag ujudauch aidau chichamjumak,","poem":1},{"lineBreak":true},{"text":"ayamjumamainchaunak tsanumjug,","poem":1},{"lineBreak":true},{"text":"apunum sujuk waitkainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Untsu aents pegkeg aidauk tikichnash yaigtatus wakenai,","poem":1},{"lineBreak":true},{"text":"nuadui niina pegkegjinig shiig anentam atinai.","poem":1}]},{"type":"heading","content":["Jerusalégnumia nuwa aidau chichagkamu"]},{"type":"verse","number":9,"content":[{"text":"Atum nuwa daki batsamtin","poem":1},{"lineBreak":true},{"text":"puyatmamchau aidautijum,","poem":1},{"lineBreak":true},{"text":"wi titatjim nunú antuktajum.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atumek yamaik puyatmamtsugme,","poem":1},{"lineBreak":true},{"text":"tujash kuashat tsawan atsuk, yumain atsakui,","poem":1},{"lineBreak":true},{"text":"tuja uva juuka yumainkesh atsakui,","poem":1},{"lineBreak":true},{"text":"makichik mijan nuigtu ewaekajum waitiakjum kujaittagme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuwa aidautijum puyatmamtsuk","poem":1},{"lineBreak":true},{"text":"shiig aneasa batsatutigmek puyatakjum kujaitajum;","poem":1},{"lineBreak":true},{"text":"tuja atum pachimakas pujautigmek sapigmakjum kujaitajum.","poem":1},{"lineBreak":true},{"text":"Nuniakjum jáanch pegkeg","poem":1},{"lineBreak":true},{"text":"nugkuagjum duka awika ukuakjum,","poem":1},{"lineBreak":true},{"text":"wake besemag pujaku nugkutai nugkugtajum.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Atumdau trigo ajakbau, uva ajakbau aidaujai","poem":1},{"lineBreak":true},{"text":"shiig kuashat pegkeg ayá","poem":1},{"lineBreak":true},{"text":"duka imankek achattawai.","poem":1},{"lineBreak":true},{"text":"Nuadui wake besemag dekapeakjum","poem":1},{"lineBreak":true},{"text":"detsepem ijutajum.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mina nugkag múunta nuwig jagki aidau","poem":1},{"lineBreak":true},{"text":"ashí tsapak akijuattawai,","poem":1},{"lineBreak":true},{"text":"tuja jega pegkejuch aidau yaaktanum ayá nuwi batsamsajum,","poem":1},{"lineBreak":true},{"text":"shiig anee batsatjum duka ashí tsaikam megkaejattawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja apu pujusa inamtaijishkam ukukim","poem":1},{"lineBreak":true},{"text":"itajak juwaktatui;","poem":1},{"lineBreak":true},{"text":"yaakat muunchakam ukukim agkan juwaktatui.","poem":1},{"lineBreak":true},{"text":"Tuja kumpin jiikbau aidaushkam,","poem":1},{"lineBreak":true},{"text":"yaakat tentea peejamu aidaush, ashí ukukim agkan juwagtatui.","poem":1},{"lineBreak":true},{"text":"Nunikmatai ikamia burro aidau,","poem":1},{"lineBreak":true},{"text":"baka aidau nuwi batsamsagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tujash Apajuí ashí waji aidaun","poem":1},{"lineBreak":true},{"text":"najankauwa nuna senchiji ataktu tajutjamattawai,","poem":1},{"lineBreak":true},{"text":"nuniak uwegshunak nugka pegkeg","poem":1},{"lineBreak":true},{"text":"ajak ajakmamain awajsattawai,","poem":1},{"lineBreak":true},{"text":"untsu nugka pegkeja duka yaunchuk aajakua","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau shiig pegkeg wajastatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nunikmatai juju nugka múunta juwig","poem":1},{"lineBreak":true},{"text":"ashí yantamnum pegkeja duke takamu atatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja pegkeg takamua nunuwai atakesh maanitsuk agkan,","poem":1},{"lineBreak":true},{"text":"kajinmamsa pujutan sukagta duka.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuadui mina aentsug aidauk waitkascham","poem":1},{"lineBreak":true},{"text":"agkan dita jeen puyatkas shiig batsamsagtinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bicha kakegak ikaman ijinau akuish,","poem":1},{"lineBreak":true},{"text":"tuja yaakat tsaikbau akuish,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡atumek yumi ayaunum ajakmajum,","poem":1},{"lineBreak":true},{"text":"nunú yuwakjum pujustinaitjume,","poem":1},{"lineBreak":true},{"text":"tuja burro aidaush, baka aidaush","poem":1},{"lineBreak":true},{"text":"chijichi ayaun yuwinak agkan batsatkui,","poem":1},{"lineBreak":true},{"text":"shiig aneasjum pujustinaitjume!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}