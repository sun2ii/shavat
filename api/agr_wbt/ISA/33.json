{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":33,"content":[{"type":"heading","content":["Apajuíyai uwemtak awai"]},{"type":"verse","number":1,"content":[{"text":"Wait anentagme aminak,","poem":1},{"lineBreak":true},{"text":"wagki amek tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"tsainaitkum tsaikchamuitme,","poem":1},{"lineBreak":true},{"text":"nuigtush amek tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"tsanuwaitkum tsanugchamuitme.","poem":1},{"lineBreak":true},{"text":"Nuadui amujatut idaisa pujamin,","poem":1},{"lineBreak":true},{"text":"aminashkam tikich nugkanmaya aidau tsaipakagtinai,","poem":1},{"lineBreak":true},{"text":"tuja tsanujatut idaisa pujamin,","poem":1},{"lineBreak":true},{"text":"tikich nugkanmaya aidau tsanupajagtinai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"niimpap yaimpaktatua tusa","poem":1},{"lineBreak":true},{"text":"aminig anentaimaidautik wait anenkagtugta.","poem":1},{"lineBreak":true},{"text":"Nuniakum tuké kashikmasam yaijatta,","poem":1},{"lineBreak":true},{"text":"tuja ishamainnum jegamunmash ame uwemtikagtugta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amina chichamjumin antukag ishamainak,","poem":1},{"lineBreak":true},{"text":"tikich aents aidauk pisainawai,","poem":1},{"lineBreak":true},{"text":"tuja yaakat muunnumia aidauk","poem":1},{"lineBreak":true},{"text":"amina senchijum iwainamun wainainak,","poem":1},{"lineBreak":true},{"text":"ishamkag pampagkag megkagainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuniagtai dita shiwaaji aidau","poem":1},{"lineBreak":true},{"text":"manchijai betek yumpuntuk utsantuawag,","poem":1},{"lineBreak":true},{"text":"dita wajiji aidaunak ashí yajutuinawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwai dekas múuntak,","poem":1},{"lineBreak":true},{"text":"niig nayaimpinum pujawai;","poem":1},{"lineBreak":true},{"text":"Jerusalégnumia aidaunak pegkejan takainak,","poem":1},{"lineBreak":true},{"text":"esegag pujustinme tiuwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui shiig pujustinme tusa tuké kuitamtinai.","poem":1},{"lineBreak":true},{"text":"Unuimata duka dekata nujai uwemtan sukagtau asa,","poem":1},{"lineBreak":true},{"text":"waji pegkeg aidaun nagkaesauwai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu puyatjusa umigbauwa nunuwai","poem":1},{"lineBreak":true},{"text":"waji pegkeg akik aina nuna nagkaesau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Suntag wajiu aidau tikich yaimpaktinme tusag,","poem":1},{"lineBreak":true},{"text":"jintá yujas untsumainawai,","poem":1},{"lineBreak":true},{"text":"tuja agkan pujutan chichaman etsejin","poem":1},{"lineBreak":true},{"text":"aidaushkam kajekag buutuinawai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jinta aidauk bashiake,","poem":1},{"lineBreak":true},{"text":"makichkish jintanmak yujainatsui,","poem":1},{"lineBreak":true},{"text":"tuja jutijai chichaman umikajua nunash uminatsui;","poem":1},{"lineBreak":true},{"text":"nuadui ajantunisa niniamush atsawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidaun nugkega duka ajak aidau tsapaachu asamtai,","poem":1},{"lineBreak":true},{"text":"wake besemag wajas awai.","poem":1},{"lineBreak":true},{"text":"Líbano aidaush datsaamainak jajatuk jinawai;","poem":1},{"lineBreak":true},{"text":"tuja nugka paka Sarón tutaya dushakam","poem":1},{"lineBreak":true},{"text":"yaunchkek pegkeg ajak shiig tsapaya nunak","poem":1},{"lineBreak":true},{"text":"yamai uwegshujai betek wajase.","poem":1},{"lineBreak":true},{"text":"Tuja Basán nugka, muja Carmelo tutaya nujai","poem":1},{"lineBreak":true},{"text":"nugka pegkeg numi dukentin ayau asa,","poem":1},{"lineBreak":true},{"text":"pegkeg samekbau wajas ayá duka duke kakekamtai,","poem":1},{"lineBreak":true},{"text":"wentsamtuk ijunui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi yamai nantagkitjai;","poem":1},{"lineBreak":true},{"text":"nuniakun ashí mina senchijun iwainaktajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja atum chicham umiamua duka","poem":1},{"lineBreak":true},{"text":"dupa kagakujai betek,","poem":1},{"lineBreak":true},{"text":"nuigtush tsuwatjai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Nunin asamtai wi umpuamua nunú","poem":1},{"lineBreak":true},{"text":"nunak jiijai betek ekemak ajapattajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui aents aidauk jagki tsupigbau akaam","poem":1},{"lineBreak":true},{"text":"keegama numamtuk keeka yuku wajasagtatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Atushat pujautigmek,","poem":1},{"lineBreak":true},{"text":"wi dutikauwaitag nunú dekatajum,","poem":1},{"lineBreak":true},{"text":"tuja tikiju pujautigmeshkam, mina senchijua nunú dekaskeapi titajum.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aents pegkegchau aidau Jerusalégnum","poem":1},{"lineBreak":true},{"text":"batsata duka sapijin kujainawai,","poem":1},{"lineBreak":true},{"text":"tuja aents Apajuín umigchau aina dushakam sapigmainawai.","poem":1},{"lineBreak":true},{"text":"Nuninak: “¿Ii ainag nuwiyash yaki jii kajinchau","poem":1},{"lineBreak":true},{"text":"tuke kee auwa ibaunmash pujusainta?”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aents pegkejan takau, dekaskenum chichau,","poem":1},{"lineBreak":true},{"text":"tuja tikichin atanki yajutuk wiakchameuchu,","poem":1},{"lineBreak":true},{"text":"tuja akikam yaimchau,","poem":1},{"lineBreak":true},{"text":"magkagtuata tusa tamash dakitin,","poem":1},{"lineBreak":true},{"text":"nuigtush pegkegchaunak makichkish anentaimtuchu,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"nunú aentsuk waitkascham agkan pujustinai.","poem":1},{"lineBreak":true},{"text":"Niina jeeg utumainchau kaya jegamkamu atinai.","poem":1},{"lineBreak":true},{"text":"Tuja nii yuwatnujish uwagtinjish ashí ajitnai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja ataktu wainkatnaitme","poem":1},{"lineBreak":true},{"text":"apu niina imanjin etsantug tsaaptin wajas eketu.","poem":1},{"lineBreak":true},{"text":"Niig atushat tikich nugka aidaunmash inamjatnai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ame yaunchuk sapigmayum nunú anentaimtusa chichaakum:","poem":1},{"lineBreak":true},{"text":"“Apu kuichkiji atin akikmakbau aidaun dekapainak,","poem":1},{"lineBreak":true},{"text":"akikmaktajum tusa","poem":1},{"lineBreak":true},{"text":"waitkagmayanum dusha ¿tuwi batsatua?","poem":1},{"lineBreak":true},{"text":"¿Tuwi batsatua ajak juukbau aidaun","poem":1},{"lineBreak":true},{"text":"dekapau aajabia dusha?","poem":1},{"lineBreak":true},{"text":"Iina uchiji aidaun suntagmagatnume tusa","poem":1},{"lineBreak":true},{"text":"achija yajutjamianum dusha ¿tuwi batsatua?” titinaitjume.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aents pegkegchau tikich chichaman antumainchaun","poem":1},{"lineBreak":true},{"text":"pachimtakan chichaaku aidaujai ijunjajum","poem":1},{"lineBreak":true},{"text":"pujajum duka yamaik nunikchattagme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Jerusalégnum jega Apajuí emematku ijuntainum","poem":1},{"lineBreak":true},{"text":"ijunja jiistamnuweg nunú anentaimtusam diista;","poem":1},{"lineBreak":true},{"text":"Jerusalégkak aak shiig aakmagbau yumpumainchau","poem":1},{"lineBreak":true},{"text":"numi ajigbaush kupimainchau, tuja","poem":1},{"lineBreak":true},{"text":"daekai jigkakbaush tsujimainchauwama iman atinai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nuwi Tuke Pujuu niina imanjijai iina wantintugmawai.","poem":1},{"lineBreak":true},{"text":"Jerusalégnumak namak múun chichijam aidau ayawai.","poem":1},{"lineBreak":true},{"text":"Namak iman agtaish, shiwag aidauk","poem":1},{"lineBreak":true},{"text":"dita lanchaji wiyanka wekaetai aina duikish,","poem":1},{"lineBreak":true},{"text":"tuja lanchaji múun aina duikish kakajus utuachagtinai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuwai iina ayamjutpa duka,","poem":1},{"lineBreak":true},{"text":"tuja ii umiktinnak nii chichaman sukagtawai.","poem":1},{"lineBreak":true},{"text":"Niyai iina apujig, iina uwemtijamin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nunú lanchanum numi ajiamu aidau","poem":1},{"lineBreak":true},{"text":"jigkakbauwa duka daekak takatkae,","poem":1},{"lineBreak":true},{"text":"nuniku asamtai jáanch detuamua duka","poem":1},{"lineBreak":true},{"text":"pukugak iyaumain wajawai.","poem":1},{"lineBreak":true},{"text":"Nunitai wemainchau dekapenakui,","poem":1},{"lineBreak":true},{"text":"lanchajin utsaantua wajiji aidau yajutkagtatji,","poem":1},{"lineBreak":true},{"text":"dutikajin aents shutuu ai aidauwaske","poem":1},{"lineBreak":true},{"text":"dita wajiji aidaunak yajuakagtatui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tuja Judá wegantu aidaun tudaujinak","poem":1},{"lineBreak":true},{"text":"Apajuí tsagkujatnai,","poem":1},{"lineBreak":true},{"text":"nuadui makichik aentskesh:","poem":1},{"lineBreak":true},{"text":"“Jajai”, tusa tauk atsutnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}