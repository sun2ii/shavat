{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":35,"content":[{"type":"heading","content":["Israel aents aidau Jerusalégnum waketjamu"]},{"type":"verse","number":1,"content":[{"text":"Uwejush ajak ajakmamainchau","poem":1},{"lineBreak":true},{"text":"buku wajas awa duka","poem":1},{"lineBreak":true},{"text":"nugka pegkeg wajastatui,","poem":1},{"lineBreak":true},{"text":"nunik ajak aidau tsapatai, uwegshuk aents","poem":1},{"lineBreak":true},{"text":"shiig aneemaina numamtuk shiig aneastatui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunik ajak aidau kuashat tsapakmatai,","poem":1},{"lineBreak":true},{"text":"uwegshuk shiig aneas senchi kantamtatui.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwa nunú uwegshunak,","poem":1},{"lineBreak":true},{"text":"Líbano nugka, Carmelo nugka,","poem":1},{"lineBreak":true},{"text":"Sarón nugka pegkeg aina iman awajsattawai.","poem":1},{"lineBreak":true},{"text":"Dutikamtai ashí aents aidauk","poem":1},{"lineBreak":true},{"text":"iina Apajuíji imanjiya nuna niina senchijijai wainkagtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atum mina chichameg antautigmek,","poem":1},{"lineBreak":true},{"text":"Judá wegantu kakaakchau aina nunú ichichiagtajum,","poem":1},{"lineBreak":true},{"text":"dutikakjum pimpikiu aidaushkam yaigtajum.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja sapig aidau chichagkujum:","poem":1},{"lineBreak":true},{"text":"“¡Ishamkagtutsuk, aishmag wajastajum!","poem":1},{"lineBreak":true},{"text":"¡Amina Apajuíjum juwi pujawai uwemtijamjagtatus,","poem":1},{"lineBreak":true},{"text":"tuja iina shiwaaji aina nunak nii suwimkan susattawai!” titajum.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dutikamtai aents wainmachu aidau wainmakagtinai,","poem":1},{"lineBreak":true},{"text":"tuja empeku aidaushkam chichaman antukagtinai;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"tuja aents shutuu aidaush","poem":1},{"lineBreak":true},{"text":"japajai betek tsekeniagtatui,","poem":1},{"lineBreak":true},{"text":"nuninai chichachu aidaushkam chichainak shiig aneasag untsumiagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninai uwegshunmashkam","poem":1},{"lineBreak":true},{"text":"shiig kuashat yumi pukuni jiiniagtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imanidau asamtai,","poem":1},{"lineBreak":true},{"text":"uwegshuk yumi wajas asattawai,","poem":1},{"lineBreak":true},{"text":"tuja nugka bukunmashkam kuashat yumi pukuni jiiniagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja lobo batsamtai aina nuwig","poem":1},{"lineBreak":true},{"text":"tagkan kajis aidaujai tsapaktatui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuwi atinai makichik jinta.","poem":1},{"lineBreak":true},{"text":"Nuna daajig: “Jinta pegkejam” tutai atinai.","poem":1},{"lineBreak":true},{"text":"Aents pegkeechu aidauk","poem":1},{"lineBreak":true},{"text":"nunú jintanmak wechagtin ainawai;","poem":1},{"lineBreak":true},{"text":"tuja aents anentainkachu aidauk nunú jintanmak yujaschagtin ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuwig leónkak atsutnai,","poem":1},{"lineBreak":true},{"text":"tuja tikich kuntin yukagtin aidaukesh","poem":1},{"lineBreak":true},{"text":"nunak makichkish adijkachagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja Tuke Pujuu uwemtikjamu aidauk nunú jinta nuni waketjagtinai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuke Pujuu uwemtikjamu aidauk shiig aneas kantamkiag","poem":1},{"lineBreak":true},{"text":"Jerusalén utsanawagtinai.","poem":1},{"lineBreak":true},{"text":"Nunikag tuké shiig aneasag batsamsagtinai.","poem":1},{"lineBreak":true},{"text":"Ditaig ima shiig aneamua duke atinai.","poem":1},{"lineBreak":true},{"text":"Nuadui wake besemjak atsutnai,","poem":1},{"lineBreak":true},{"text":"tuja najaimamushkam atsutnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":10}