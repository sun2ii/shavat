{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":40,"content":[{"type":"heading","content":["Apajuí Jerusalégnumia aidaun anentain ichichtau"]},{"type":"verse","number":1,"content":[{"text":"Iina Apajuíji chichaak:","poem":1},{"lineBreak":true},{"text":"“Shiwag aidau achipag dita nugken yajupakagmatai batsamsagmesh,","poem":1},{"lineBreak":true},{"text":"¡mina aentsug aina nuna anentai ichichtugtin atajum!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jerusalégnumia aents aidauk shiig anentsajum ausatajum,","poem":1},{"lineBreak":true},{"text":"tuja achija yajuakam yujasag waituina nunú","poem":1},{"lineBreak":true},{"text":"ayamsagtinuk tsawantak jegae”, titajum.","poem":1},{"lineBreak":true},{"text":"Dita tudaujig tsagkugnaje.","poem":1},{"lineBreak":true},{"text":"Dita pegkegchau takasbaujin nagkaesau","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu suwimken jukiag waituinak umikaje.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Makichik aents uwegshunum untsumak:","poem":1},{"lineBreak":true},{"text":"“¡Tuke Pujuu wekaesatin jinta uwegshunum","poem":1},{"lineBreak":true},{"text":"shiig iwaja jintamajum, tunin aidau","poem":1},{"lineBreak":true},{"text":"dakuegjum umiktajum!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nugka ségaju aina duka","poem":1},{"lineBreak":true},{"text":"yutuka aimjajum paka awajsatajum,","poem":1},{"lineBreak":true},{"text":"tuja muja tsakakunum","poem":1},{"lineBreak":true},{"text":"nuna wakeen entsa ayá dushakam","poem":1},{"lineBreak":true},{"text":"yutukjum makichkish wagaku atsau paka awajsatajum.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dutika umikagmin","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina imanjin iwainaktinai,","poem":1},{"lineBreak":true},{"text":"nuna ashí aents aidau ijunag wainkagtinai,","poem":1},{"lineBreak":true},{"text":"tawai Tuke Pujuu”, tusa Isaías tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuna tusa nuigtushkam Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Makichik aents chichagtak:","poem":1},{"lineBreak":true},{"text":"‘¡Untsumkata!’ tujutkui, wi ayaakun:","poem":1},{"lineBreak":true},{"text":"‘¿Wajintu untsumkattaja?’ tai, nii chichagtak:","poem":1},{"lineBreak":true},{"text":"‘Ashí aents aidauk dupajai betek,","poem":1},{"lineBreak":true},{"text":"tuja yagkug ikamia niime wainak","poem":1},{"lineBreak":true},{"text":"pegkegchiama nunin ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuu dase awemamu dasentak","poem":1},{"lineBreak":true},{"text":"tukua tukuam dupa kagaka ijuname,","poem":1},{"lineBreak":true},{"text":"tuja yagkugshakam kagaka kakegame.","poem":1},{"lineBreak":true},{"text":"Numamtuk aentsuk dupajai betek ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dupag kagaka jininai,","poem":1},{"lineBreak":true},{"text":"tuja yagkugshakam kagaka kakenai.","poem":1},{"lineBreak":true},{"text":"Tujash Apajuí chichameg makichkish","poem":1},{"lineBreak":true},{"text":"megkaekashtinun tuke auwai’.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"muja titijin wakatajum,","poem":1},{"lineBreak":true},{"text":"nunikjum nuwi ijuntsajum senchi untsumkatajum,","poem":1},{"lineBreak":true},{"text":"aents ashí nugkanmaya aidau antuktinme.","poem":1},{"lineBreak":true},{"text":"Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"chicham etsegtak ishamkagtutsuk","poem":1},{"lineBreak":true},{"text":"senchi untsumkajum etsegkatajum,","poem":1},{"lineBreak":true},{"text":"ashí Judá nugkanmaya yaakta aidaush","poem":1},{"lineBreak":true},{"text":"yamajam chichaman antuktinme.","poem":1},{"lineBreak":true},{"text":"Senchi untsumkajum:","poem":1},{"lineBreak":true},{"text":"‘Iina Apajuíjiya duka jujuwai’, tusa titajum.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apu Tuke Pujuu niina senchijijai minawai,","poem":1},{"lineBreak":true},{"text":"nuniak nii ima senchigtin asa, ashí depetmak minawai.","poem":1},{"lineBreak":true},{"text":"Nunik minak niina aentsji aidau waitkam batsatun yajuak inimui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uwija kuitamnujai betek","poem":1},{"lineBreak":true},{"text":"niina aentsji aidaun kuitamak inimui.","poem":1},{"lineBreak":true},{"text":"Uwig tsakat aidaunak pagkuk juki inimak,","poem":1},{"lineBreak":true},{"text":"yama petsakbau aidaunak shiig puyatjus juki minawai.”","poem":1}]},{"type":"heading","content":["Israel aents aidau Apajuíjin nagkaesauk tikichik makichkish atsawai"]},{"type":"verse","number":12,"content":[{"text":"“Apajuík nayantsanak makichik uwejenig","poem":1},{"lineBreak":true},{"text":"achika dekapamainai.","poem":1},{"lineBreak":true},{"text":"Tuja nayaimpinashkam tsajam uwejinig","poem":1},{"lineBreak":true},{"text":"ashí achika dekapamainai.","poem":1},{"lineBreak":true},{"text":"Nugkash wajupa kijinkita nuna shiig dekauk Apajuíyai.","poem":1},{"lineBreak":true},{"text":"Apajuí dekawai muja aidaush","poem":1},{"lineBreak":true},{"text":"wajupa kijinuk ainawa nunak.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuun chichagnuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Apajuín jintinmainuk shiig atsawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apajuín jintintua unuinajuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja pegkeg takat aina nuna takasti tusa Apajuín jintintushkam atsawai.","poem":1},{"lineBreak":true},{"text":"Niig ashí yachai.","poem":1},{"lineBreak":true},{"text":"Ashí waji ayá dusha wajuk najaneakukita","poem":1},{"lineBreak":true},{"text":"nuna pachis Apajuín jintinmainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Niig ashí dekawai, wagki nii najankau asa.","poem":1},{"lineBreak":true},{"text":"Apajuí yacha ati tusa jintintua unuinajuk atsawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nugka múun aina duka nii diismak","poem":1},{"lineBreak":true},{"text":"makichik yumi dakitamua nujai betek,","poem":1},{"lineBreak":true},{"text":"nugka yukukuntunmaya","poem":1},{"lineBreak":true},{"text":"makichik nenentuch piipich juki,","poem":1},{"lineBreak":true},{"text":"balanzanum dekapam kijinji atsumaina numamtinai.","poem":1},{"lineBreak":true},{"text":"Nugka múun aidau nayantsan ijus ayá dushakam","poem":1},{"lineBreak":true},{"text":"makichik kayam piipichia nunin ainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ikam múun Líbano tutaya nuwiya kuntin","poem":1},{"lineBreak":true},{"text":"ashí yajuaka Apajuí emematku apeatin ijumjamash,","poem":1},{"lineBreak":true},{"text":"Apajuí diismak piipichi, tuja kuntin maa apeatin","poem":1},{"lineBreak":true},{"text":"nunú ikamnumia numi ashí yajuaka ijumjamash","poem":1},{"lineBreak":true},{"text":"Apajuí diismak piipichi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ashí aents maki makichik chichamtin","poem":1},{"lineBreak":true},{"text":"nugka muunnum batsamin aina dushakam","poem":1},{"lineBreak":true},{"text":"Apajuí emtinig shiig wainkauch ainawai.","poem":1},{"lineBreak":true},{"text":"Nii diismak atsaujai betek ainawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Atumek Apajuík makichkish tikichjai","poem":1},{"lineBreak":true},{"text":"apatkagmek diimaitsugme.","poem":1},{"lineBreak":true},{"text":"Dakumka najanamu aina dukesh","poem":1},{"lineBreak":true},{"text":"Apajuíjai betek amainuk makichkish atsawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aents dakumak najanna nunú dakumak najanui,","poem":1},{"lineBreak":true},{"text":"dutikamtai tikich aents patakumtai aidaun najanin","poem":1},{"lineBreak":true},{"text":"orojai ukatuk umiawai,","poem":1},{"lineBreak":true},{"text":"dutika cadenan platayai najatui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuja ujunauch aidaunu aents dakumak najanna duka","poem":1},{"lineBreak":true},{"text":"numi katsujam wamak mamumainchaun diisa najanui.","poem":1},{"lineBreak":true},{"text":"Dutika nunú iyaag tsainkai tusa","poem":1},{"lineBreak":true},{"text":"tikich aentsun ame juju chichiag asatin","poem":1},{"lineBreak":true},{"text":"najatuata tusa inawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“¿Atumek duka dekachuk ayujum?","poem":1},{"lineBreak":true},{"text":"¿Nuna pachisag chichaidauk antuchuk ainajum?","poem":1},{"lineBreak":true},{"text":"¿Yama nagkamchakush ujapaku ainatsuak?","poem":1},{"lineBreak":true},{"text":"Apajuí nugkan najanauwa duwi nagkamas","poem":1},{"lineBreak":true},{"text":"aents aidauk dekau amain ainawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apajuí pujusa inamtaijiya duka nayaimpi yakin awai.","poem":1},{"lineBreak":true},{"text":"Nuwi pujus aents aidaunak manchia nuninush diyawai.","poem":1},{"lineBreak":true},{"text":"Tuja nayaimpinak Apajuí carpajai betek ejaa,","poem":1},{"lineBreak":true},{"text":"nuna nugkaan aents aidau batsamsatnume tiuwai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Apajuík aents senchigtin aidaunak","poem":1},{"lineBreak":true},{"text":"tikima wainkauch emawai,","poem":1},{"lineBreak":true},{"text":"tuja nugkaya apu aidaunashkam ijina emegkawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuadui ditak ajak yama ajakmamu","poem":1},{"lineBreak":true},{"text":"kagkape yama achimag wegama nujai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí dasen dasenmitkataik pimpika jinawai,","poem":1},{"lineBreak":true},{"text":"tuja dase ishamain iyakug","poem":1},{"lineBreak":true},{"text":"chijichi tsupigbau kagakujai betek umpui utsawai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuja Apajuí pegkegma nunú chichaak:","poem":1},{"lineBreak":true},{"text":"‘Atumek minak makichkish tikichjai","poem":1},{"lineBreak":true},{"text":"apatukjumek diigmaitsugme.","poem":1},{"lineBreak":true},{"text":"Wijai betekak makichkish tikichik atsawai’, tawai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yakí pagkaijum diistajum:","poem":1},{"lineBreak":true},{"text":"¿Juju ayá nunash ya najanauwaita?","poem":1},{"lineBreak":true},{"text":"Yaya aidaun, nantu, etsa,","poem":1},{"lineBreak":true},{"text":"nuigtu tikich aidau ayá nuna najanak,","poem":1},{"lineBreak":true},{"text":"maki makichik akanag pekasua nunú","poem":1},{"lineBreak":true},{"text":"nigki nuna daaji aidaunash adaitug umikui.","poem":1},{"lineBreak":true},{"text":"Niig senchigtina ibau asa,","poem":1},{"lineBreak":true},{"text":"makichkikesh najantsuk ampija ukukbaujig atsawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jacopa uchiji Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"¿wagka atumesh wainkagmesh chichagme?","poem":1},{"lineBreak":true},{"text":"¿Wagka wainkagmesh:","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk wi waitiag nunak dekatsui;","poem":1},{"lineBreak":true},{"text":"tuja Apajuík minak pachittsui, tajume?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Apajuí Tuke Pujuu,","poem":1},{"lineBreak":true},{"text":"ashí nugkan, nayaimpijai najanauwa duka","poem":1},{"lineBreak":true},{"text":"makichkish yawechu, nuigtush pimpichu,","poem":1},{"lineBreak":true},{"text":"dekatish amuechauwa duka ¿amek dekatsmek,","poem":1},{"lineBreak":true},{"text":"atsa nuniachkumesh amek antuchukum?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Apajuíyai aents pimpikiunash senchimtika","poem":1},{"lineBreak":true},{"text":"wajiu emauwa duka,","poem":1},{"lineBreak":true},{"text":"tuja aents kakakchaunash senchijin ikauntinai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Datsauch aidaush pimpikiag kakaumainchau dekapenawai,","poem":1},{"lineBreak":true},{"text":"tuja aents senchigtin aidaush nugka tukumak iyainawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tujash ima Tuke Pujuuwaig kajinas anentaimaina duka","poem":1},{"lineBreak":true},{"text":"yamajam senchin jukiagtin ainawai.","poem":1},{"lineBreak":true},{"text":"Águilajai betek nanaakagtin ainawai,","poem":1},{"lineBreak":true},{"text":"wekaekush yawegchagtin ainawai,","poem":1},{"lineBreak":true},{"text":"makichkish yaweakchau shiig tupikaidiagtinai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/35.json","previousChapterAudioLinks":{},"numberOfVerses":31}