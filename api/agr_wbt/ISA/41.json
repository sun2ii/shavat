{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":41,"content":[{"type":"heading","content":["Israel aents aidaunak wi agkanmitkatnaitjai tusa Apajuí tibau"]},{"type":"verse","number":1,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Yaakat múun nayantsanum ijus ayá nuwi","poem":1},{"lineBreak":true},{"text":"batsamin aidautijum takamtak pujusjum antugtuktajum.","poem":1},{"lineBreak":true},{"text":"Tuja nugka muunnum batsamin aidautigmesh","poem":1},{"lineBreak":true},{"text":"ishamkagtutsuk kaunatajum.","poem":1},{"lineBreak":true},{"text":"Nunikagmin atumesh shiijash batsatjum nunú ijunja dekaami.","poem":1},{"lineBreak":true},{"text":"Nunika atumesh wajukatagmeki","poem":1},{"lineBreak":true},{"text":"nunú chicham umikmi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Etsa minitaiya nuwiya apu","poem":1},{"lineBreak":true},{"text":"tuke depetma nunash ¿ya dutiknaita?","poem":1},{"lineBreak":true},{"text":"Anú apu tikich nugkanmaya aidaun depetuk","poem":1},{"lineBreak":true},{"text":"ijinatnume tusan umiaunuk witjai.","poem":1},{"lineBreak":true},{"text":"Nuadui nunú apu suntaji aidau, puyagjai,","poem":1},{"lineBreak":true},{"text":"nagkijai aatus shaa dekeaja tsaitiama numamtuk","poem":1},{"lineBreak":true},{"text":"tsaikag ijinatnume,","poem":1},{"lineBreak":true},{"text":"dutikawag chijichi kagakun dase umpui dapampaak","poem":1},{"lineBreak":true},{"text":"utsauwama numamtuk emegkagtinme tusan idaijai.","poem":1},{"lineBreak":true},{"text":"Dutikakun dita apuji aidaushkam suntaji amutam","poem":1},{"lineBreak":true},{"text":"sapijin ditai yunumjatnume tusan idaijai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiwaajin pataetakush ishamain atsaunum,","poem":1},{"lineBreak":true},{"text":"agkan shiig wamak nanaakas shimatai tumain","poem":1},{"lineBreak":true},{"text":"shimitnume tusash ¿ya dutiknaita?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Witjai nuna dutikaunuk.","poem":1},{"lineBreak":true},{"text":"Yama nagkamchakun nugkan nayaimpijai","poem":1},{"lineBreak":true},{"text":"najanawaitag duwi nagkamsan,","poem":1},{"lineBreak":true},{"text":"yaunchuk waji nagkaemajua nunak,","poem":1},{"lineBreak":true},{"text":"tuja yamai nagkaema nunashkam,","poem":1},{"lineBreak":true},{"text":"wi dutiknaitjai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu dekas Apajuínuk.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wi dutikamunak yaakat nayantsanum","poem":1},{"lineBreak":true},{"text":"ijus batsamin aidauk wainin ainawai.","poem":1},{"lineBreak":true},{"text":"Nuna wainainak senchi sapigmainawai.","poem":1},{"lineBreak":true},{"text":"Nugkashkam ashí yantamnum uujui.","poem":1},{"lineBreak":true},{"text":"Aents tikich nugkanmaya aidau ijunjagtatus","poem":1},{"lineBreak":true},{"text":"ashí kaunawag mininawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Maki makichik aents dakumak najanin aidauk","poem":1},{"lineBreak":true},{"text":"niina kumpajinak ima niinakek idaitsui,","poem":1},{"lineBreak":true},{"text":"yayawai dutikak anentain ichichtawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dakumak najanin aina duka patakumtain,","poem":1},{"lineBreak":true},{"text":"nugkutain orojai najanin aina nuna chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Pegkeg najanme, idaitsuk takasta’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja martillowai takau aidauk,","poem":1},{"lineBreak":true},{"text":"jiju awatug ikag najanin aidaun chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Achija umikum duka pegkejai’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Nuna tusag dakumka najanamu iyajai tusag","poem":1},{"lineBreak":true},{"text":"clavowai achiawag ukuinawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Jacob wegantu Israel aents aidauwah, antuktajum:","poem":1},{"lineBreak":true},{"text":"Atumek mina inakeg, wi etejamu ainagme.","poem":1},{"lineBreak":true},{"text":"Atumek mina kumpag Abraham aajakua","poem":1},{"lineBreak":true},{"text":"nunú wegantu ainagme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja tikich nugkanum achija yajuakam","poem":1},{"lineBreak":true},{"text":"atushat batsatutigmin wi agkanmitkauwaitjime,","poem":1},{"lineBreak":true},{"text":"dutikan mina takagtustajum tusan chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Atumek mina inakeg ainagme’, tiuwaitjime.","poem":1},{"lineBreak":true},{"text":"Wi atumnak etegkauwaitjime,","poem":1},{"lineBreak":true},{"text":"nuadui atumnak dakitjankesh idaisachjime.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ishamkagtukaigpa, wi atumjaig pujajai.","poem":1},{"lineBreak":true},{"text":"Ishamkagtukaigpa, witjai atumi Apajuíjinuk.","poem":1},{"lineBreak":true},{"text":"Wi atumnak senchimtikajime,","poem":1},{"lineBreak":true},{"text":"wi atumnak yayajime,","poem":1},{"lineBreak":true},{"text":"mina uweg senchigtin depetmauwa duwi","poem":1},{"lineBreak":true},{"text":"ayamjukan kuitamjime.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Amina kajegtamin aidaunak, wi inatsaktinaitjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai ememamujinak kajimatkiagtinai.","poem":1},{"lineBreak":true},{"text":"Atumjai maanidaushkam ashí ijinawajam megkaejattawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nunik megkaejamtai, wainkatasajum","poem":1},{"lineBreak":true},{"text":"egakjumesh wainkashtinaitjume,","poem":1},{"lineBreak":true},{"text":"wagki amejai maaniatag tinu aidauk","poem":1},{"lineBreak":true},{"text":"ashí amukam megkaejatnai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tujash aminak wi achiakjame.","poem":1},{"lineBreak":true},{"text":"Wi atumin chichagkun: ‘Ishamkagtukaigpa,","poem":1},{"lineBreak":true},{"text":"wi atumnak yayajime’ tiuwaitjime”, tawai Apajuí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tuja Apajuí ataktu awagki chichaak:","poem":1},{"lineBreak":true},{"text":"“Jacob wegantu Israel aents aidautigmek,","poem":1},{"lineBreak":true},{"text":"piipich kakakchau ainakjumesh,","poem":1},{"lineBreak":true},{"text":"ishamkagtukaigpa, wi atumnak yayajime.","poem":1},{"lineBreak":true},{"text":"Witjai Israel aents aidau Apajuíji pegkegmanuk,","poem":1},{"lineBreak":true},{"text":"wi atumnak agkanmitkauwaitjime.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Antuktajum nijah: Atum ainajum anuiyan,","poem":1},{"lineBreak":true},{"text":"makichik trigo akatain yamagman,","poem":1},{"lineBreak":true},{"text":"naín batsatkan najanattajai.","poem":1},{"lineBreak":true},{"text":"Dutikamtai nujai muja aidau tsaikam","poem":1},{"lineBreak":true},{"text":"yukukuntu awajsattagme.","poem":1},{"lineBreak":true},{"text":"Tuja nain aina dushakam tsaiktatjume,","poem":1},{"lineBreak":true},{"text":"dutikawagmin chijichi kagaku tuwasua weaku atatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nunú yakí takui nagkimjumin, dase umpui utsagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja trigo akagbau, dukee utsankam","poem":1},{"lineBreak":true},{"text":"wampuji juwakun dase shiig senchi dasentak","poem":1},{"lineBreak":true},{"text":"utsauwama numamtuk,","poem":1},{"lineBreak":true},{"text":"atumi shiwaajum aidaun dapampaak utsagtatui.","poem":1},{"lineBreak":true},{"text":"Dutikamtai Israel aents aidaun Apajuíji","poem":1},{"lineBreak":true},{"text":"pegkegma nuwi shiig aneasam pujuttame,","poem":1},{"lineBreak":true},{"text":"nuniakum ima niyaig eme anenmamtatme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Aents ujudauch kuichkigtinchau,","poem":1},{"lineBreak":true},{"text":"wajigtuchu wekagas yumi egá egakua","poem":1},{"lineBreak":true},{"text":"wainkacha kitamak umumain atsujam,","poem":1},{"lineBreak":true},{"text":"suweuchijin jujug wekaetatui.","poem":1},{"lineBreak":true},{"text":"Tujash wi niinak yaigtinaitjai,","poem":1},{"lineBreak":true},{"text":"witjai Tuke Pujuu Israel aents aidau Apajuíjinuk,","poem":1},{"lineBreak":true},{"text":"nuadui ditanak kajimatkinuk idaisashtinaitjai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Muja uwegshunum entsa ayau awajsatnaitjai,","poem":1},{"lineBreak":true},{"text":"tuja nugka ségaju paka aidaunmashkam","poem":1},{"lineBreak":true},{"text":"yumi pukuni kuashat jiiniagtinai.","poem":1},{"lineBreak":true},{"text":"Nuadui yumi kuashat ayau asamtai,","poem":1},{"lineBreak":true},{"text":"dupa shiig tsapak aama iman uwegshunak emaktatjai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Uwegshunmak setug aidaun,","poem":1},{"lineBreak":true},{"text":"numi acacia aidaun, arrayan aidaun,","poem":1},{"lineBreak":true},{"text":"nuigtu olivo aidaun tsapapitkatnaitjai;","poem":1},{"lineBreak":true},{"text":"untsu nugka bukunum, numi pino aidaun,","poem":1},{"lineBreak":true},{"text":"abeto aidaun, nuigtu cipre aidaun tsapapitkatnaitjai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nuna ashí aents aidau wainkatnume,","poem":1},{"lineBreak":true},{"text":"nuninak puyatjus unuimagtinme,","poem":1},{"lineBreak":true},{"text":"wi Tuke Pujuun mina senchigjai dutikag nuna.","poem":1},{"lineBreak":true},{"text":"Witjai Israel aents aidaun Apajuíji pegkegmanuk,","poem":1},{"lineBreak":true},{"text":"wi nunak najanauwaitjai”, tiuwai.","poem":1}]},{"type":"heading","content":["Apajuí tikich apajuímtai aidaun atsaneamu"]},{"type":"verse","number":21,"content":[{"text":"Jacob wegantu Israel aents aidaun Apajuíji chichaak:","poem":1},{"lineBreak":true},{"text":"“Apajuímtai dakumka najanamu aidautijum kaunajum,","poem":1},{"lineBreak":true},{"text":"chichamjumaktajum, nuniakjum atumi takatjum ayamjuktajum.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kaunatajum,","poem":1},{"lineBreak":true},{"text":"nunikjum atakea duwi atin etsegkatajum,","poem":1},{"lineBreak":true},{"text":"dutikakjum yaunchuk waji nagkaemajua nunú","poem":1},{"lineBreak":true},{"text":"shiig ujajatkatajum, iish shiig antukagmi","poem":1},{"lineBreak":true},{"text":"atakea duish wajig nagkaemagtinaita nunú,","poem":1},{"lineBreak":true},{"text":"tuja dusha dekas uminkatpash nunú diismi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Atakea duish waji nagkaemagtatua nunú tukagtitajum.","poem":1},{"lineBreak":true},{"text":"Atum dekas Apajuíyaitkugmek nunú iwainaktajum.","poem":1},{"lineBreak":true},{"text":"¡Atum dutikmain pegkeg aidau,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchaukesh,","poem":1},{"lineBreak":true},{"text":"nuniachkush ishamain iina uwaktamain","poem":1},{"lineBreak":true},{"text":"aidaukesh iwainaktajum!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¡Atumek shiig wainkauch ainagme,","poem":1},{"lineBreak":true},{"text":"nuadui makichkish iwainamaitsugme!","poem":1},{"lineBreak":true},{"text":"¡Atumin kajintsa anentaimauwa duka","poem":1},{"lineBreak":true},{"text":"pegkegchau shiig wainkayai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Makichik aentsun etsa minitaiya nuwiyan jiikjai,","poem":1},{"lineBreak":true},{"text":"dutikan niina daajin untsuka ai nujinmanini minawai.","poem":1},{"lineBreak":true},{"text":"Nunú aentsua nunú tikich apu aidaunak tsakus","poem":1},{"lineBreak":true},{"text":"najamaina numamtuk najaktatui,","poem":1},{"lineBreak":true},{"text":"tuja ichinka najanin duwen nawen najama","poem":1},{"lineBreak":true},{"text":"numamtuk najak ukuktatui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Junak emtikan eke nagkaematsaig wi ashí ujajime.","poem":1},{"lineBreak":true},{"text":"Dakumka najanamu apajuímtai aina duka","poem":1},{"lineBreak":true},{"text":"wi etsejag nunak, wi taatsaigkik yaunchkek","poem":1},{"lineBreak":true},{"text":"makichkish etsegchau ainawai;","poem":1},{"lineBreak":true},{"text":"Dita chichamuk makichkish antugchatayai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Junak makichkish etsegchatain wi Jerusalégnumia aidaun ujakuitjai.","poem":1},{"lineBreak":true},{"text":"Tuja aents achija yajuakbau tikich nugkanum batsata duka,","poem":1},{"lineBreak":true},{"text":"dukap atsuk waketjattawai tusa etsegkatnun","poem":1},{"lineBreak":true},{"text":"wi makichik aentsun akatjan Jerusalén awemajai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ashí diyajai, tujash makichik apajuímtai","poem":1},{"lineBreak":true},{"text":"dakumka najanamukesh wantintsui;","poem":1},{"lineBreak":true},{"text":"chichaman etsegmainkesh makichkish wantintsui.","poem":1},{"lineBreak":true},{"text":"Tuja wi ditan iniasagmag nuna aigmainkesh","poem":1},{"lineBreak":true},{"text":"makichkish wantintsui.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¡Ditak shiig wainak ainawai!","poem":1},{"lineBreak":true},{"text":"Dita dutikmainuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Ditak dakumka najanamu waa ainawai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}