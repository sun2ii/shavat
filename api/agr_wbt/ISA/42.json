{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":42,"content":[{"type":"heading","content":["Tuke Pujuun inake"]},{"type":"verse","number":1,"content":[{"text":"“Jujuwai mina inakeg, Wi niinak achiakjai,","poem":1},{"lineBreak":true},{"text":"wi niinak etegkauwaitjai, niini shiig aneajai,","poem":1},{"lineBreak":true},{"text":"niyai mina Wakanjun apusajai;","poem":1},{"lineBreak":true},{"text":"Nii aents ashí nugkanmaya aidaun","poem":1},{"lineBreak":true},{"text":"pujut pegkejan susatnai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Niig senchi jiikag untsumchatnai,","poem":1},{"lineBreak":true},{"text":"chichaakush senchi jiikag chichashtinai,","poem":1},{"lineBreak":true},{"text":"jintá wekagas senchi untsumak chichamujish antuekashtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tagkan kupinak aunash tsujigkag ajapashtinai,","poem":1},{"lineBreak":true},{"text":"tuja lamparin ekemakbau shiig keeshtaish ikagnakchatnai.","poem":1},{"lineBreak":true},{"text":"Niig dekas pegkeg pujutan itaatnai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja ashí nugkanum pujut pegkeg ati tau asa,","poem":1},{"lineBreak":true},{"text":"nii takamujinak makichkish ayamsashtinai,","poem":1},{"lineBreak":true},{"text":"tuja pimpikigkesh idaisashtinai.","poem":1},{"lineBreak":true},{"text":"Tuja nugka múun nayantsa ijus ayá nuwi","poem":1},{"lineBreak":true},{"text":"aents batsamin aidauk,","poem":1},{"lineBreak":true},{"text":"nii jintiamun antuktatus niina dakagtinai, tawai Apajuí”, tiuwai Isaías.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu Apajuí nayaimpin najanauwa nunú,","poem":1},{"lineBreak":true},{"text":"tuja nugkanashkam najana,","poem":1},{"lineBreak":true},{"text":"nunú nugkanum tsapau aidaunashkam","poem":1},{"lineBreak":true},{"text":"najankauwa nunú,","poem":1},{"lineBreak":true},{"text":"tuja iwaku pujutan mayattanashkam aents aidaun","poem":1},{"lineBreak":true},{"text":"susauwa nunú niina inaken chichajak:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Witjai Tuke Pujuu Apajuínuk, tikichik atsawai,","poem":1},{"lineBreak":true},{"text":"wi aminak mina takagtusti, nuniak","poem":1},{"lineBreak":true},{"text":"uwemtikagtugti tusan etegkeawaitjame,","poem":1},{"lineBreak":true},{"text":"wi aminak kuitamkatnaitjame,","poem":1},{"lineBreak":true},{"text":"dutikakun achiaku atatjame,","poem":1},{"lineBreak":true},{"text":"wagki wi chichaman ditajai umikuitag nuna umiakun,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidaun amasjai.","poem":1},{"lineBreak":true},{"text":"Ame tsaaptin asam,","poem":1},{"lineBreak":true},{"text":"aents aidau yajuakam minai ikaunmatnaitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents wainmachu aidau wainmitkakta,","poem":1},{"lineBreak":true},{"text":"tuja aents achikbau aidau suwenum chimpija dushakam","poem":1},{"lineBreak":true},{"text":"jiijam agkanmitkata, tusan wakegajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Wika Tuke Pujuuwaitjai, nunuwai mina daajuk!","poem":1},{"lineBreak":true},{"text":"Mina emematjaku kantamtai aina duka","poem":1},{"lineBreak":true},{"text":"tikichik makichkish kantamjuawaigpa,","poem":1},{"lineBreak":true},{"text":"tuja mina emematjutmaina nunú idaikumek,","poem":1},{"lineBreak":true},{"text":"dakumka najanamu aina duka makichkish emematipa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi yaunchuk etsegkauwaitag nunú","poem":1},{"lineBreak":true},{"text":"uminka nunú atumesh anentaimsa diistajum,","poem":1},{"lineBreak":true},{"text":"yamai etsegkattajai yaunchkesh antukchamu yamajam aidaun.","poem":1},{"lineBreak":true},{"text":"Nunú eke wantintsaig, atumnak dekamtikajime”,","poem":1},{"lineBreak":true},{"text":"tiuwai Apajuí.","poem":1}]},{"type":"heading","content":["Tuke Pujuu uwemtikagtugbau anentaimtusa kantamtai"]},{"type":"verse","number":10,"content":[{"text":"Yamajam kantamtai Tuke Pujuu kantamjuatajum.","poem":1},{"lineBreak":true},{"text":"Ashí nugka najatamunum batsamin aidautigmesh","poem":1},{"lineBreak":true},{"text":"Apajuí emematkujum kantamatajum,","poem":1},{"lineBreak":true},{"text":"lanchanum nayants yujau aidaush,","poem":1},{"lineBreak":true},{"text":"kuntin nayantsanum batsamin aidaush,","poem":1},{"lineBreak":true},{"text":"tuja nugka múun nayantsa ijus ayá nuwi","poem":1},{"lineBreak":true},{"text":"batsamin aidaush Apajuín ememattinme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uwegshunum yaaktamak batsamin aidaush,","poem":1},{"lineBreak":true},{"text":"tuja Quedar wegantu aidaujai batsamin aidaushkam shiig aneastinme.","poem":1},{"lineBreak":true},{"text":"Yaakat Selá batsamin aidaushkam shiig aneasag","poem":1},{"lineBreak":true},{"text":"dakunkut Apajuín kantamjuatnume;","poem":1},{"lineBreak":true},{"text":"tuja aents mujanum batsamin aidaushkam","poem":1},{"lineBreak":true},{"text":"depetmaka shiig aneaku untsumaina imattinme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuke Pujuu imanjiya nunak ima niinak idaitustinme,","poem":1},{"lineBreak":true},{"text":"tuja nugka muunnum nayantsa ijus batsamin","poem":1},{"lineBreak":true},{"text":"aina dushakam Apajuín emematak kantamjuatnume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, múun, senchigtin asa, maanitan yacha,","poem":1},{"lineBreak":true},{"text":"shiwaaji aidaun kajejuk,","poem":1},{"lineBreak":true},{"text":"suntag maaniamunum untsumajama imati untsumak jiintuki,","poem":1},{"lineBreak":true},{"text":"shiwaaji aidaunak ijinattawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Apu Mesías chichaak:","poem":1},{"lineBreak":true},{"text":"“Kuashat tsawantai chichatsuk pujujai,","poem":1},{"lineBreak":true},{"text":"makichik chichamnakesh tutsuk,","poem":1},{"lineBreak":true},{"text":"tuja nuigtush kajetsuk pujujai.","poem":1},{"lineBreak":true},{"text":"Tujash yamaik nuwa uchin uchigmak,","poem":1},{"lineBreak":true},{"text":"buutak mayatama imanittajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Muja aina nunak nain aina nujai tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"tuja numi aidau, ajak aidau ayá nunashkam ashí ijinattajai.","poem":1},{"lineBreak":true},{"text":"Tuja entsa ayá nunak ukuyuan buku awajsattajai.","poem":1},{"lineBreak":true},{"text":"Dutikakun kucha aidaunashkam ukuyan buku awajsattajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wainmachu aidaunak jinta dita wainajakchamunum emattajai.","poem":1},{"lineBreak":true},{"text":"Tuja suwenum yuja nunak tsaaptin etittajai.","poem":1},{"lineBreak":true},{"text":"Tuja jintanum kaya pujutjin weaja","poem":1},{"lineBreak":true},{"text":"nunashkam utsagkan pegkeg awajtustatjai.","poem":1},{"lineBreak":true},{"text":"Wi taja nunak umitskek idaisashtatjai,","poem":1},{"lineBreak":true},{"text":"tuké dutikattajai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja wainka apajuímtai dakumka najanamu aidaun","poem":1},{"lineBreak":true},{"text":"dekaskeapi tinu aina duka","poem":1},{"lineBreak":true},{"text":"dita apajuímtaiji aidaun chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Atumetjume jutii apajuíji aidautigmek’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Nuna tinu aina duka datsagkag jiinag","poem":1},{"lineBreak":true},{"text":"megkaejagtinai”, tiuwai Apajuí.","poem":1}]},{"type":"heading","content":["Israel aents aidau Apajuí chichamen antuinakush umikchagbau"]},{"type":"verse","number":18,"content":[{"text":"Antuchu aidauwah, antuktajum,","poem":1},{"lineBreak":true},{"text":"wainmachu aidauwah, niimi wainmaktajum.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wi mina takagtustinme tusan,","poem":1},{"lineBreak":true},{"text":"atumin etegkau asan aents aidau chicham ujaktajum tusan","poem":1},{"lineBreak":true},{"text":"ishiakbau ainayatkujum aents antuchu,","poem":1},{"lineBreak":true},{"text":"wainmachu aina nujai betek ainajum,","poem":1},{"lineBreak":true},{"text":"nuninuk tikichik makichkish atsuinawai.","poem":1},{"lineBreak":true},{"text":"Atumin wi mina takagtustinme tusan","poem":1},{"lineBreak":true},{"text":"etegkamu aidautijum chicham antuchu,","poem":1},{"lineBreak":true},{"text":"wainmachujai betek ainajum annuk tikima tikichik","poem":1},{"lineBreak":true},{"text":"makichkish atsawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wi atumin yayaakun kuashat dutikawaitag","poem":1},{"lineBreak":true},{"text":"duka atumek wainkauwaitjume,","poem":1},{"lineBreak":true},{"text":"tujash umigtukchau ainagme.","poem":1},{"lineBreak":true},{"text":"Atumek chichamak antagme,","poem":1},{"lineBreak":true},{"text":"tujash wi tajim duka makichkish nunap tawa tusagmek dekatsjume.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk uwemtikagtina ibau asa,","poem":1},{"lineBreak":true},{"text":"pegkeg wakemain aina nuna","poem":1},{"lineBreak":true},{"text":"aents aidaun jintintuatjai tusa wakejukui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tujash juju aents aina nunak,","poem":1},{"lineBreak":true},{"text":"dita shiwaaji aidau kasajainak waitkainawai.","poem":1},{"lineBreak":true},{"text":"Dutikainak achijag waanum,","poem":1},{"lineBreak":true},{"text":"nuigtu aents achika chimpitainum chimpiawag batsamtawai.","poem":1},{"lineBreak":true},{"text":"Dutikawag dita wajiji aidaunak ashí yajutuinawai.","poem":1},{"lineBreak":true},{"text":"Ditan ayamjumainuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja dita patayi aidaunash achika jukiag,","poem":1},{"lineBreak":true},{"text":"akikmakui awagtukmi tusag emegkatuinawai.","poem":1},{"lineBreak":true},{"text":"Tujash ditan ayamjuk awakmainuk atsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tujash atum ainajum anuiyag","poem":1},{"lineBreak":true},{"text":"makichkish nunak puyatjusagkesh diinatsui.","poem":1},{"lineBreak":true},{"text":"Nunidau asag atakea duish wajukatnukita tusa","poem":1},{"lineBreak":true},{"text":"dekatatus wakegauk makichkish atsawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Jacob wegantu Israel aents aina nuna","poem":1},{"lineBreak":true},{"text":"shiwag aidau utsaantuawag kasajuinak waitkaina nunash,","poem":1},{"lineBreak":true},{"text":"ya dutikati tima dutikainawa duka","poem":1},{"lineBreak":true},{"text":"atumek shiig dekagme.","poem":1},{"lineBreak":true},{"text":"¿Tuke Pujuuchukait nuna dutikau?","poem":1},{"lineBreak":true},{"text":"Israel aents aidauk Apajuín pegkegchau takamjusu ainawai,","poem":1},{"lineBreak":true},{"text":"nuninak, Apajuísh ditanash wajuk pujustinme","poem":1},{"lineBreak":true},{"text":"tiyamkiyi nunash umikchau ainawai,","poem":1},{"lineBreak":true},{"text":"núnidau asag nii jintintuawa nuna umitnash dakitjajui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nuadui atumnak kajegtamak suwimkan amasmatai,","poem":1},{"lineBreak":true},{"text":"maaniamunum ijipau ainawai.","poem":1},{"lineBreak":true},{"text":"Tujash imaanika waitiakjumesh, makichkish unuimatsjume.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}