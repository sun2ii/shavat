{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":43,"content":[{"type":"heading","content":["Ima Tuke Pujuuke uwemtikagtinuk"]},{"type":"verse","number":1,"content":[{"text":"Jacob wegantu Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu atumin najapauwa nunú chichagtamak:","poem":1},{"lineBreak":true},{"text":"“Ishamkagtukaigpa,","poem":1},{"lineBreak":true},{"text":"witjai atumin agkanmitkaunuk,","poem":1},{"lineBreak":true},{"text":"wi atumnak daagmin adaisan midau atinme tusan","poem":1},{"lineBreak":true},{"text":"etegkauwaitjime, nuadui atumek midau ainagme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yumi piyajunum nagkaemakminish, wi kuitamkattagme,","poem":1},{"lineBreak":true},{"text":"tuja namak aidau katitkuminish, jakejai tusan kuitamkattagme;","poem":1},{"lineBreak":true},{"text":"tuja jii kegamunum nagkaemakmesh esashtinaitme,","poem":1},{"lineBreak":true},{"text":"jii kegak nimpaush dekapjashtinaitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Witjai Tuke Pujuu, amina Apajuígminuk,","poem":1},{"lineBreak":true},{"text":"witjai amina uwemtiknunuk,","poem":1},{"lineBreak":true},{"text":"witjai Israel aents aidaun Apajuíji pegkegmanuk.","poem":1},{"lineBreak":true},{"text":"Wi Egipto nugkan, Etiopía nugkan, Sabá nugkan aatsan sujakun","poem":1},{"lineBreak":true},{"text":"atumnak sumakuitjime.","poem":1},{"noteId":4}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atum iwaku batsamsamnujum tusa tabaunum","poem":1},{"lineBreak":true},{"text":"tikich aidau jinawajui.","poem":1},{"lineBreak":true},{"text":"Atum jinumainun yapajian dekas dita jinatnume tiuwaitjai.","poem":1},{"lineBreak":true},{"text":"Wi nunak dutikauwaitjai,","poem":1},{"lineBreak":true},{"text":"wagki atumin wait anentau asan,","poem":1},{"lineBreak":true},{"text":"atumek dekas waji pegkeg akikama iman ainagme.","poem":1},{"lineBreak":true},{"text":"Wika atumnak aneajime.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ishamkagtukaigpa, wi atumjaig pujajai.","poem":1},{"lineBreak":true},{"text":"Amina aentsjum aidau etsa minitaiya nuni,","poem":1},{"lineBreak":true},{"text":"tuja etsa akaetaiya nuni batsata nuna","poem":1},{"lineBreak":true},{"text":"ijumjatasan yajuakan ikaunmattajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja aents nujinum batsamin aidaun chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Awakjatajum’, titatjai.","poem":1},{"lineBreak":true},{"text":"Tuja tsumunum batsamin aidaun chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Makichkish emetuawaigpa’, titatjai.","poem":1},{"lineBreak":true},{"text":"‘Mina uchig aidau, mina nawantug aidaujai,","poem":1},{"lineBreak":true},{"text":"atushat nugka nagkatkamunum batstush","poem":1},{"lineBreak":true},{"text":"awakjatajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja uchi apaji daajin naamama numamtuk","poem":1},{"lineBreak":true},{"text":"mina aentsug asag, mina daajun jukiu aina nunak","poem":1},{"lineBreak":true},{"text":"mina daag ememattai atinun najanauwaitjai;","poem":1},{"lineBreak":true},{"text":"nuadui makichkish emettsuk awakjatajum.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mina aentsug aidau jiintin ainayatak","poem":1},{"lineBreak":true},{"text":"wainmachujai betek aina nunú,","poem":1},{"lineBreak":true},{"text":"tuja kuishtinaitak antuchu aina nunú dita nugken","poem":1},{"lineBreak":true},{"text":"ashí awakjatajum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ashí aents aidautijum","poem":1},{"lineBreak":true},{"text":"makichik ijunbaunmak ijunjatajum.","poem":1},{"lineBreak":true},{"text":"Nunikjum tujuttajum atum ainajum anuiyash","poem":1},{"lineBreak":true},{"text":"¿yaita atakea duwi atinun pachis, tuja yaunchuk","poem":1},{"lineBreak":true},{"text":"nagkaemajua nunash betek etsegnush?","poem":1},{"lineBreak":true},{"text":"Nunin ataik juwi itantinme,","poem":1},{"lineBreak":true},{"text":"dutikam nunú etsegtai antukag dekaskeapi titinme.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Atumek mina chichamjun etsegtugkatnume tusa","poem":1},{"lineBreak":true},{"text":"etegkamu ainagme,","poem":1},{"lineBreak":true},{"text":"wi atumnak etegkauwaitjime,","poem":1},{"lineBreak":true},{"text":"minai kajintsa anentaimkugmek,","poem":1},{"lineBreak":true},{"text":"dekas wi Tuke Pujuuwaitag nunú dekajuattagme.","poem":1},{"lineBreak":true},{"text":"Initaikia duwish tikich apajuí mina nagkaetasuk atsujakui,","poem":1},{"lineBreak":true},{"text":"tuja atakea duwish, duka makichkish atsutnai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ima wikitjai Tuke Pujuunuk;","poem":1},{"lineBreak":true},{"text":"tikichik uwemtikagtumainuk atsawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi atumin ujaakun, uwemtijatnaitjime tusan","poem":1},{"lineBreak":true},{"text":"tiuwaitjim nunak, betek uwemtijauwaitjime;","poem":1},{"lineBreak":true},{"text":"tuja wainka apajuímtai aina duka atumnak uwemtijamjachajui,","poem":1},{"lineBreak":true},{"text":"duka atumek shiig dekagme.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Witjai yaunchuk nagkamsan Apajuínuk,","poem":1},{"lineBreak":true},{"text":"tuja atakea duwish wiki atinaitjai Apajuínuk.","poem":1},{"lineBreak":true},{"text":"Makichkish mina suwimkajun uwemtumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja wi dutikamua nuna emegkaumainush","poem":1},{"lineBreak":true},{"text":"makichkish atsawai.”","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuke Pujuu pegkejam, Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"agkanmitkauwa nunú aatus tawai:","poem":1},{"lineBreak":true},{"text":"“Atumin ayamjakun suntag aidaun Babilonia nugkanum ishiaktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai dita yaaktaji waitiji aidaunak tsaikagtatui.","poem":1},{"lineBreak":true},{"text":"Dutikawagmatai, caldeo aents aidau shiig aneas","poem":1},{"lineBreak":true},{"text":"batsataina nunak wake besemag juwakagtatui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Witjai Tuke Pujuu, Israel aents aidaun najanaunuk.","poem":1},{"lineBreak":true},{"text":"Witjai atumi Apajuíjum pegkegmanuk.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nayants kuna ishamainnum","poem":1},{"lineBreak":true},{"text":"nuna ejapeen Apajuí ukuya buku awajus ikankauwai.","poem":1},{"lineBreak":true},{"text":"Aatus niina aentsji aidaun ikatiajui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja Egipto nugkanmaya suntag maanitan yacha aidau","poem":1},{"lineBreak":true},{"text":"caballo aidaujai, carro aidaujai Israel aents aidaun pataetukajui,","poem":1},{"lineBreak":true},{"text":"tujash nayantsanum tepeawag makichkish jiinkishtinun megkaejabi;","poem":1},{"lineBreak":true},{"text":"tuja lamparin ekemakbau kajinak megkagama numamtuk megkaejabi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apajuí niina aentsji aidaun yamai chichajak:","poem":1},{"lineBreak":true},{"text":"“Waji nagkaemakiuwa duka pachikaigpa,","poem":1},{"lineBreak":true},{"text":"tuja anentaimtutkesh anentaimtusaigpa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wi iwainaktatjai yamagman,","poem":1},{"lineBreak":true},{"text":"nunú ame yamaikiuchia duik wainkattame.","poem":1},{"lineBreak":true},{"text":"Uwegshunum jintan jintamattajai,","poem":1},{"lineBreak":true},{"text":"tuja nugka pegkegchau ajak tsapachua nunashkam","poem":1},{"lineBreak":true},{"text":"entsa ayau awajsattajai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kuntin ikamia kajen lobo aidau,","poem":1},{"lineBreak":true},{"text":"avestruz aidau aatus shiig anenjusagtinai,","poem":1},{"lineBreak":true},{"text":"wagki wi yumi pukuni jiinun uwegshunum kuashat jiiju asamtai.","poem":1},{"lineBreak":true},{"text":"Tuja nugka ajak tsapachunum","poem":1},{"lineBreak":true},{"text":"entsa aidaun kuashat najankattajai,","poem":1},{"lineBreak":true},{"text":"mina aentsug, wi etegkauwaitag nuna, uwajagtinun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nunú aents aidaunak wi najankauwaitjai,","poem":1},{"lineBreak":true},{"text":"mina emematjitnume tusan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tujash Israel aents","poem":1},{"lineBreak":true},{"text":"Jacob wegantu aidautigmek","poem":1},{"lineBreak":true},{"text":"mina umigtutak kajimatki idaisaugme.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja uwig aidaush anenjauchik sujatsjume,","poem":1},{"lineBreak":true},{"text":"kuntin maa nuna neje ashí apeakjumesh emematjatsjume.","poem":1},{"lineBreak":true},{"text":"Wika atumnak anentag sujustajum","poem":1},{"lineBreak":true},{"text":"tusa segaaknuk waitkatsjime, tuja kugkuin incienso","poem":1},{"lineBreak":true},{"text":"apeatajum tusankesh segaaknuk waitkatsjime.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mina anentag sujustinuk pagat kugkuin aina","poem":1},{"lineBreak":true},{"text":"duka sumagtukchabiugme,","poem":1},{"lineBreak":true},{"text":"kuntin aidau wiyajigkesh apeakjumek minak emematjishbaijume.","poem":1},{"lineBreak":true},{"text":"Ayatak pujusjum pegkegchau takamugmin dii diin yawetjajai,","poem":1},{"lineBreak":true},{"text":"nunú pegkegchaugmia nuna diitan tsuwaagjai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tujash wi amina Apajuíjum asan,","poem":1},{"lineBreak":true},{"text":"ame magkagtutaijum aidaunak esakatjattagme,","poem":1},{"lineBreak":true},{"text":"dutikan atakea duish adeagchatnun kajimatkin idaisattajai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ame mina utugchatug dekagtakmek","poem":1},{"lineBreak":true},{"text":"yamai tujutta, chichasmi.","poem":1},{"lineBreak":true},{"text":"Pai, ame waji titag tame nunú tita,","poem":1},{"lineBreak":true},{"text":"nunú tiyamin amesh dekas shiig imagnismeash","poem":1},{"lineBreak":true},{"text":"pujam nunú dekaami.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Atumi apachjum aajakua nunú,","poem":1},{"lineBreak":true},{"text":"tikich amina chichaman jintinjabianum","poem":1},{"lineBreak":true},{"text":"nujai mai pegkegchaun takainak","poem":1},{"lineBreak":true},{"text":"mina umigtukchau ainawai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tuja amina apujum aajaku aidau","poem":1},{"lineBreak":true},{"text":"jega mina emematjaku ijuntain shiig kuitamkachu ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui Jacob wegantu Israel aents aidaunak ijinatnume,","poem":1},{"lineBreak":true},{"text":"dutikawag dushiki batsamtitin atinme","poem":1},{"lineBreak":true},{"text":"tusan idaisauwaitjai”, tawai Apajuí.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"“Wi atumnak Egipto nugkan, Etiopía nugkan, Sabá nugkan aatsan sujakun sumakuitjime” tawa nunak “juju nugka aidaunmaya Israel aents aidaun waitka batsatu asamtai, Apajuí dita shiwaajin sujua idayak Israel aents aidaun ayamjuk agkanmitkauwa” nuna taku tawai.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/agr_wbt/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}