{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":45,"content":[{"type":"heading","content":["Ciro takastinun Apajuí takatan susau"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu Ciron apu adayak,","poem":1},{"lineBreak":true},{"text":"aents tikich nugka múun aidaunum","poem":1},{"lineBreak":true},{"text":"apu senchigtin batsata nuna depetuk,","poem":1},{"lineBreak":true},{"text":"maanitaiji aidaunak atanjati tusa yayaak,","poem":1},{"lineBreak":true},{"text":"egkesa awekajakui.","poem":1},{"lineBreak":true},{"text":"Tuja yaakat peeja apakbau aina nunash","poem":1},{"lineBreak":true},{"text":"tujintsuk utua shiwag aidaun ijinati tawai.","poem":1},{"lineBreak":true},{"text":"Nuadui Apajuí niina chichajak:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ame weamunmak wi emkan wetatjai,","poem":1},{"lineBreak":true},{"text":"tuja muja aidaunak yumpuajan paka emaktatjai,","poem":1},{"lineBreak":true},{"text":"waiti jiju bronce najanamu aina nunak tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"tuja jiju hierro waiti batsatkamua nunashkam tsaiktatjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja waji pegkeg aidau","poem":1},{"lineBreak":true},{"text":"makichkish wainmainchau uukbau awa nuna,","poem":1},{"lineBreak":true},{"text":"wi amastatjai.","poem":1},{"lineBreak":true},{"text":"Nunú wainkam, Tuke Pujuu Israel aents aidau","poem":1},{"lineBreak":true},{"text":"Apajuíjinuk ima wikitag nunú dekattame.","poem":1},{"lineBreak":true},{"text":"Wi aminak untsukmajame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Israel aents Jacob wegantu aidau,","poem":1},{"lineBreak":true},{"text":"mina inakeg aina nunú aneamunum,","poem":1},{"lineBreak":true},{"text":"amek minak dekagtsuminig wi aminak etegkamjame,","poem":1},{"lineBreak":true},{"text":"dutikan apu emamjame tikich apu aina nuna","poem":1},{"lineBreak":true},{"text":"nagkaesau ati tusan, nuadui aents aidaush","poem":1},{"lineBreak":true},{"text":"ame tabaun antugtamkagtatui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk,","poem":1},{"lineBreak":true},{"text":"tikich mina nagkaetasuk atsawai,","poem":1},{"lineBreak":true},{"text":"amek minak dekagtsuminig wi aminak","poem":1},{"lineBreak":true},{"text":"kuitamkattajame depetmakti tusan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ashí tikich nugkanum batsamin aidaush","poem":1},{"lineBreak":true},{"text":"tikich Apajuí mina nagkaetasuk atsa nuna","poem":1},{"lineBreak":true},{"text":"dekaatnume tau asan nunak dutikattajai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, tikich mina","poem":1},{"lineBreak":true},{"text":"nagkaetasuk makichkish atsawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Witjai tsaaptinun suwejai najanaunuk,","poem":1},{"lineBreak":true},{"text":"tsawan pegkeg atinnash,","poem":1},{"lineBreak":true},{"text":"tsawan pegkegchau atinnashkam,","poem":1},{"lineBreak":true},{"text":"ashí nunak wi dutikajai.”","poem":1}]},{"type":"heading","content":["Apajuí ashí senchigtin"]},{"type":"verse","number":8,"content":[{"text":"“Ashí nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"ima pegkeg takat aina nunak takagtatui,","poem":1},{"lineBreak":true},{"text":"duka Tuke Pujuu jegashik nayaimpinmayan","poem":1},{"lineBreak":true},{"text":"akakea numamtuk atatui.","poem":1},{"lineBreak":true},{"text":"Aatus aents aidau pegkejan takainak uwemtan jukiagtinai.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pinig duwe juki najanamua duka,","poem":1},{"lineBreak":true},{"text":"aentsjai betekak, niina najanauwa nuna chichagkug:","poem":1},{"lineBreak":true},{"text":"“Amek najantak dekatsme” tusag jiyanimaitsui,","poem":1},{"lineBreak":true},{"text":"tuja tsakusai pegkejan dakumak najannunak: “¿Waji takame?” tusag tsakusak iniatsui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuja uchi yama akiinauwa duka","poem":1},{"lineBreak":true},{"text":"niina apajinak dukujijaig: “¿Wagka minash akiintuabiugme?”","poem":1},{"lineBreak":true},{"text":"tusag jiyamaitsui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apajuí pegkejam, Tuke Pujuu, Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"najanauwa nunú chichaak:","poem":1},{"lineBreak":true},{"text":"“Atumek minak makichkish inatmain ainatsjume,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidaunash wisha itugkatnaitja","poem":1},{"lineBreak":true},{"text":"nuna ujatkati tusagmek wakemaitsugme,","poem":1},{"lineBreak":true},{"text":"tuja wi dutikamujua dushakam jutik dutikata","poem":1},{"lineBreak":true},{"text":"tusagmek jintinjumain ainatsjume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wi nugkanak najanan,","poem":1},{"lineBreak":true},{"text":"nuwi aents aidaun batsasuitjai,","poem":1},{"lineBreak":true},{"text":"tuja nayaimpinash múun agkajun najanan,","poem":1},{"lineBreak":true},{"text":"nuwi agkajunum etsanjatin aidaun najankauwaitjai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wi apu Cironak etegkajai,","poem":1},{"lineBreak":true},{"text":"dutikau asan wi niinak Jerusalén mina yaaktajua nuna","poem":1},{"lineBreak":true},{"text":"ataktu jegamag yaaktamkati tusan yaigtatjai.","poem":1},{"lineBreak":true},{"text":"Nuadui Israel aents aidau achija yajuakam","poem":1},{"lineBreak":true},{"text":"Babilonia nugkanum batsata nuna jiigtatui,","poem":1},{"lineBreak":true},{"text":"dutika jiija agkanmitkakush, akikmaktajum tusag","poem":1},{"lineBreak":true},{"text":"makichkish kuichkinak segashtatui”,","poem":1},{"lineBreak":true},{"text":"tusa Tuke Pujuu ashí senchigtina nunú juna aatus tawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuke Pujuu Israel aents aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Egiptunmaya aents ajakan ajakbau,","poem":1},{"lineBreak":true},{"text":"tuja etiopíanmaya aents waji sujin aidau,","poem":1},{"lineBreak":true},{"text":"Sabá aents esajam aina dushakam,","poem":1},{"lineBreak":true},{"text":"ashí ditak ima atum tabaunak umigtabiagtatui.","poem":1},{"lineBreak":true},{"text":"Ditak atumi wainka inaku waitkatai agtatui.","poem":1},{"lineBreak":true},{"text":"Imanik waituinak atumi emtin tikishmag pujusag","poem":1},{"lineBreak":true},{"text":"chichainak:","poem":1},{"lineBreak":true},{"text":"‘Dekas Apajuík ima atumjaig pujawai,","poem":1},{"lineBreak":true},{"text":"tikich Apajuík makichkish atsawai.’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amek dekas wainmainchauwaitme,","poem":1},{"lineBreak":true},{"text":"tuja ametme Israel aents aidau ayamjukam uwemtiknumek.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wainka apajuímtai aidaun dakumak najanin aina duka datsagkag","poem":1},{"lineBreak":true},{"text":"wainak juwakagtatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja Israel aents aina nunak","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu tuke batsamsatnun uwemtijatnai.","poem":1},{"lineBreak":true},{"text":"Nuadui ditak wainka inaku waitkatai,","poem":1},{"lineBreak":true},{"text":"dushiktaig achagtinai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tuke Pujuu Apajuí nayaimpin, nugkan najana,","poem":1},{"lineBreak":true},{"text":"juwi aents aidau batsamsatnume tusa","poem":1},{"lineBreak":true},{"text":"umikua nunú chichaak:","poem":1},{"lineBreak":true},{"text":"“Witjai Tuke Pujuunuk, tikichik makichkish atsawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wika aents aidau antachbaunum suwenum uumka","poem":1},{"lineBreak":true},{"text":"pujusnuk chichatsjai.","poem":1},{"lineBreak":true},{"text":"Tuja Israel aents aidaun susashtinaitkunuk,","poem":1},{"lineBreak":true},{"text":"segattajum amastajime tusanuk anagkuatsjai.","poem":1},{"lineBreak":true},{"text":"Wika Apajuí dekasken pegkejan chichauwaitjai.”","poem":1}]},{"type":"heading","content":["Wainka apajuímtai aidaun atsaneak Tuke Pujuu chichakbau"]},{"type":"verse","number":20,"content":[{"text":"“Ashí nugkanum batsatutijum","poem":1},{"lineBreak":true},{"text":"juwi kaunajum ijunjajum, antuktajum.","poem":1},{"lineBreak":true},{"text":"Atumek anentainkachu ainajume, wainka","poem":1},{"lineBreak":true},{"text":"apajuímtai numi dakumka najanamu makichkish","poem":1},{"lineBreak":true},{"text":"atumin uwemtijamainchau emematjume.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuja wainka apajuímtai dakumka najanamu","poem":1},{"lineBreak":true},{"text":"emematjum dusha pegkejash aniajum nunú","poem":1},{"lineBreak":true},{"text":"pempeentunikjum ininistajum.","poem":1},{"lineBreak":true},{"text":"¿Yaita juju waji aidau nagkaemagtinun pachis emtika etsegkaush?","poem":1},{"lineBreak":true},{"text":"Makichik aentskesh juju waji nagkaemaina nuna pachis etsegkauk atsawai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuuk juju waji nagkaemaina juniktinun yaunchuk emtikan etsegkaunuk.","poem":1},{"lineBreak":true},{"text":"Tikich Apajuí mina nagkaetasuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Apajuí pegkejam uwemtikagtinuk tikichik atsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tikich nugkanum atushat batsatutigmesh","poem":1},{"lineBreak":true},{"text":"minai minitajum, wi uwemtan amastajime,","poem":1},{"lineBreak":true},{"text":"witjai Apajuínuk tikich mina nagkaetasuk atsawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wika dekas umiktinjun tumamjai,","poem":1},{"lineBreak":true},{"text":"mina shiwag aina nunak ijinatnaitjai,","poem":1},{"lineBreak":true},{"text":"duka dekas imanisag uminkatnai.","poem":1},{"lineBreak":true},{"text":"Tuja mina emtijui aents aidauk","poem":1},{"lineBreak":true},{"text":"tikishmag batsamsag emematjuinak:","poem":1},{"lineBreak":true},{"text":"‘Dekas ametme jutii Apajuíjimek’, tujutiagtin ainawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tusa chichainak:","poem":1},{"lineBreak":true},{"text":"‘Pegkeg takata duka ima Tuke Pujuuwaig awai,","poem":1},{"lineBreak":true},{"text":"tuja ima nigki senchigtinuk’ tujutiagtinai.","poem":1},{"lineBreak":true},{"text":"Aents mina chichamjun umitan dakitujaku aina duka","poem":1},{"lineBreak":true},{"text":"datsagkag wainak juwakagtinai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ashí Israel aents aidauk wi yayamu asag,","poem":1},{"lineBreak":true},{"text":"minak umigtuinak ima pegkeg takata nunak takagtinai”,","poem":1},{"lineBreak":true},{"text":"tawai Tuke Pujuu, tiuwai Isaías.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}