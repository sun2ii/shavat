{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":46,"content":[{"type":"heading","content":["Babilonianmaya aidaun apajuímtaiji aina nujai diismak Apajuí ima senchigtinai"]},{"type":"verse","number":1,"content":[{"text":"Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Babilonianmaya aidaun apajuímtaiji Bel, Nebo,","poem":1},{"lineBreak":true},{"text":"aina duka winchainag, nugka iyainawai.","poem":1},{"lineBreak":true},{"text":"Tuja babilonianmaya aidauk,","poem":1},{"lineBreak":true},{"text":"kuntin waji pataja jutai aidaunum dita","poem":1},{"lineBreak":true},{"text":"apajuímtaiji aidaun patajag yajumainak,","poem":1},{"lineBreak":true},{"text":"kijin asamtai kuntinjin waitkainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunik kijimainak nugka tukumak iyaak","poem":1},{"lineBreak":true},{"text":"ajuajam ayamjumamainchau asag tsainak ajapnainawai.","poem":1},{"lineBreak":true},{"text":"Nunin asagmatai tikich nugkanum yajumainawai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tuja Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Jacob wegantu, Israel aents iwaku batsatutijum antuktajum:","poem":1},{"lineBreak":true},{"text":"Wi atumnak eke akiintsugminig uchi pagkusa","poem":1},{"lineBreak":true},{"text":"kuitamaina numamtuk kuitamkauwaitjime.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja atum múuntuch wajasjum jempejuja pujakjuminish,","poem":1},{"lineBreak":true},{"text":"wi atumin najadau asan, yamai kuitamjim dutiksanuk kuitamkan","poem":1},{"lineBreak":true},{"text":"uwemtijatnaitjime.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wijai betek tikichik makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Witjai tikich aina nuna nagkaesaunuk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja awai aents kuashat oron, platan ikaunbau.","poem":1},{"lineBreak":true},{"text":"Dutika ikaunamtai aents wainka apajuímtain","poem":1},{"lineBreak":true},{"text":"dakumak najanin najanamtai,","poem":1},{"lineBreak":true},{"text":"emematmi tusag nunú aentsun egainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja nuna najanamtai, yanaki jukiag","poem":1},{"lineBreak":true},{"text":"tuwi pujustatua nuwi ejegan apujuinawai,","poem":1},{"lineBreak":true},{"text":"dutika apujkim makichkish buchittsuk pujawai.","poem":1},{"lineBreak":true},{"text":"Nunik pujaun yaimpakti tusag,","poem":1},{"lineBreak":true},{"text":"senchi untsukag segamash makichkish ayatsui,","poem":1},{"lineBreak":true},{"text":"tuja waituinak nii ayamjutpakti tusa segamash","poem":1},{"lineBreak":true},{"text":"makichkish ayamjumaitsui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pegkegchaun takau aidauwah,","poem":1},{"lineBreak":true},{"text":"juju adeagtajum, nuniakjum shiig anentaimjatajum,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yaunchuk waji aidau nagkaemajua nunú adeagtajum,","poem":1},{"lineBreak":true},{"text":"witjai Apajuínuk tikichik atsawai;","poem":1},{"lineBreak":true},{"text":"witjai Apajuínuk, tikich wijai betekak makichkish atsawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuja tsawan nagkanbaush wajuk atinaita nunak","poem":1},{"lineBreak":true},{"text":"wika yaunchuk nagkamsan dekajai,","poem":1},{"lineBreak":true},{"text":"tuja atakea duish","poem":1},{"lineBreak":true},{"text":"waji nagkaemagtinaita nunashkam etsegjai.","poem":1},{"lineBreak":true},{"text":"Wi wajina dutikatag tusanua wakegaja nunak","poem":1},{"lineBreak":true},{"text":"wika imatiksanuk uminaitjai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Makichik aentsun tikich nugkanmayan","poem":1},{"lineBreak":true},{"text":"etsa minitaiya nuwiyan untsukmajai,","poem":1},{"lineBreak":true},{"text":"duka tuke chuwagjai betek atushtanmaya minittawai,","poem":1},{"lineBreak":true},{"text":"nigka wi tabaun umiktatui.","poem":1},{"lineBreak":true},{"text":"Tuja wi nuna dutikatin atajai tusan tiuwaitag nunak","poem":1},{"lineBreak":true},{"text":"nii imatiksag umiktatui.","poem":1},{"lineBreak":true},{"text":"Wi dutikatnujun chichaman umikuitag nunak tuke umiktatjai.","poem":1},{"lineBreak":true},{"text":"Nunak dekas uminkatnun tajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Chichaman antakchau, intimkiu aidautijum","poem":1},{"lineBreak":true},{"text":"anentaimsajum, iik wamak agkanmagashtin","poem":1},{"lineBreak":true},{"text":"ainaji tusajum tautijum, wi tajim nunú antuktajum.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wi atumnak wamak agkanmitkattajime,","poem":1},{"lineBreak":true},{"text":"nunak shiig wamak dutikattajai.","poem":1},{"lineBreak":true},{"text":"Tuja Jerusalégnum aents aidau batsata","poem":1},{"lineBreak":true},{"text":"nunak wi ayamjukan agkanmitkattajai.","poem":1},{"lineBreak":true},{"text":"Mina imanjua duka Israel aents aidaunum atatui”,","poem":1},{"lineBreak":true},{"text":"tiuwai Apajuí.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}