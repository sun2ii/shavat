{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":49,"content":[{"type":"heading","content":["Tuke Pujuu minak dukuju wakeen egketaig yaunchuk nagkamas etegtuauwai"]},{"type":"verse","number":1,"content":[{"text":"“Yaakat múun nayantsan ijus ayá","poem":1},{"lineBreak":true},{"text":"nuwi batsamin aidautijum,","poem":1},{"lineBreak":true},{"text":"tuja tikich nugka múun aidaunum atushat","poem":1},{"lineBreak":true},{"text":"batsamin aidautigmeshkam wi tajim nunú antugtuktajum:","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu minak eke akiintsaig etegtuauwai.","poem":1},{"lineBreak":true},{"text":"Tuja mina dukuju wakeen egketaig mina daajun adaitujus untsugkauwai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apajuí minak senchimtijua chichamtin,","poem":1},{"lineBreak":true},{"text":"puyag etsakamu empekama iman,","poem":1},{"lineBreak":true},{"text":"tuja flecha etsakamu tsakaskatuama iman awajtusmayi.","poem":1},{"lineBreak":true},{"text":"Dutijua makichik waji ejaka kuitamaina numamtuk kuitamjukmayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja nii chichagtak:","poem":1},{"lineBreak":true},{"text":"‘Israel aents aidauwah, atumek mina inakeg ainagme,","poem":1},{"lineBreak":true},{"text":"atumiin mina senchignak iwainaktatjai’, tujutmayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja wi anentaimsan chichaakun:","poem":1},{"lineBreak":true},{"text":"‘Pegkegnakesh jukitnunig wainka takakun waitiajai’, tibaijai.","poem":1},{"lineBreak":true},{"text":"Tujash wi takasbaunum jukitnujuk Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"senchigtina nuwi amayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Israel aents Jacob wegantu aidau","poem":1},{"lineBreak":true},{"text":"pampagka batsata nuna yajuak","poem":1},{"lineBreak":true},{"text":"atak awakeag ikaunmati,","poem":1},{"lineBreak":true},{"text":"dutikak mina takagtusti tujutu asa,","poem":1},{"lineBreak":true},{"text":"wika eke akiintsaig, Tuke Pujuu minak wait anenjug,","poem":1},{"lineBreak":true},{"text":"yaunchuk nagkamas etegtuauwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja nii chichagtak:","poem":1},{"lineBreak":true},{"text":"‘Wika aminak mina inakeg ati, nuniak","poem":1},{"lineBreak":true},{"text":"Jacob wegantu aidau achija yajuakam nugken ukukiag,","poem":1},{"lineBreak":true},{"text":"tikich nugkanum batsata nuna ataktu awakeag,","poem":1},{"lineBreak":true},{"text":"dita nugken ikaunmati tusanuk ima nunakek tatsugme.","poem":1},{"lineBreak":true},{"text":"Tuja ashí tikich aents judíochu aina nuwishkam","poem":1},{"lineBreak":true},{"text":"tsaaptinun iwainakti titatjame.","poem":1},{"lineBreak":true},{"text":"Ashí tikich nugka aidaunum mina chichamjun etsegkati,","poem":1},{"lineBreak":true},{"text":"nunitai ditashkam uwemjatnume tusa’, tujutmayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke Pujuu uwemtikagtin,","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun Apajuíji pegkegma nunú,","poem":1},{"lineBreak":true},{"text":"niina aentsji tikich nugkanmaya aidau kajejam,","poem":1},{"lineBreak":true},{"text":"wainka inaku waitkatai batsata nuna chichajak:","poem":1},{"lineBreak":true},{"text":"Wi atumnak etegkauwaitjim nuadui apu aidauk","poem":1},{"lineBreak":true},{"text":"niina atuwe aidaujai atumi waipakag,","poem":1},{"lineBreak":true},{"text":"eme anenjamsag, atumi emtimin tikishmag pujusagtinai.","poem":1},{"lineBreak":true},{"text":"Nuadui wi atumin anagkuawaitjim nunak","poem":1},{"lineBreak":true},{"text":"imatiksanuk umiktatjai.”","poem":1}]},{"type":"heading","content":["Jesuralén tsaikbauwa nunú ataktu yaaktamatin pachisa etsegkamu"]},{"type":"verse","number":8,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi wait anenkagtamu tsawan jegau asamtai,","poem":1},{"lineBreak":true},{"text":"untsugkugmin aikmaijime,","poem":1},{"lineBreak":true},{"text":"uwemain tsawan jegagtamiaju asamtai,","poem":1},{"lineBreak":true},{"text":"wi yaigbaijime.","poem":1},{"lineBreak":true},{"text":"Wi atumnak tikich aents aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau agtinme tusan etegkauwaitjime.","poem":1},{"lineBreak":true},{"text":"Nuadui atum Israel aents aidautigmek","poem":1},{"lineBreak":true},{"text":"atumi nugkemin ataktu waketjattagme,","poem":1},{"lineBreak":true},{"text":"nunika jegajum atumi shiwaajum aidau","poem":1},{"lineBreak":true},{"text":"yaaktan tsaikajua nunú ataktu yaaktamkatnaitjume.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja aents aidau achijam chimpija nunú chichagkujum:","poem":1},{"lineBreak":true},{"text":"‘Yamaik agkan wajasugme,","poem":1},{"lineBreak":true},{"text":"tuja suwenum batsatutigmeshkam tsaaptin wainkatajum,","poem":1},{"lineBreak":true},{"text":"nunikjum jinta yantamenig chijichi pegkeg ayau wainkattagme.","poem":1},{"lineBreak":true},{"text":"Tuja muja uwegshunmash baka aidaun","poem":1},{"lineBreak":true},{"text":"yumainjig kuashat aittawai’, titajum.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atumek nujantaish tuja kitakaish, etsa sukupainakuish,","poem":1},{"lineBreak":true},{"text":"seekiyaish, makichkish waittsashtin ainagme.","poem":1},{"lineBreak":true},{"text":"Wi atumnak aneau asan uyuntsattajime,","poem":1},{"lineBreak":true},{"text":"tuja nuigtushkam yumi pukuni kuashat jiinaidaun amastinaitjime.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muja aina nunak yumpuajan pakaman,","poem":1},{"lineBreak":true},{"text":"shiig iwaja jintaman esekan tutupit dakuejan umiktatjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuja Israel aents aidautigmek tikich","poem":1},{"lineBreak":true},{"text":"nugka nagkatkamunum atushat batsatutijum","poem":1},{"lineBreak":true},{"text":"juwi kaunatnaitjume.","poem":1},{"lineBreak":true},{"text":"Untsu tikich aidauk nugka Sinim","poem":1},{"noteId":6},{"text":"batsatu kaunatnai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Nayaimpih, shiig aneakjum kantamatajum!","poem":1},{"lineBreak":true},{"text":"¡Nugkah, shiig aneasta!","poem":1},{"lineBreak":true},{"text":"¡Muja aidauwah, shiig aneakjum untsumkatajum!","poem":1},{"lineBreak":true},{"text":"Wagki Tuke Pujuu niina aentsji waituinak","poem":1},{"lineBreak":true},{"text":"wake besemag batsatun,","poem":1},{"lineBreak":true},{"text":"wait anentug anentai ichichtuju asamtai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Atum Jerusalén batsamsajum chichaakjum:","poem":1},{"lineBreak":true},{"text":"‘Tuke Pujuuk jutiinak kajimatjamki idaitamsae’, tuyugme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“¿Nuwa nii jujegbaujinash wait anentsukesh kajimatkish idainukaih?","poem":1},{"lineBreak":true},{"text":"Nuwa nii jujegbaujin kajimatki idaisaintai,","poem":1},{"lineBreak":true},{"text":"tujash wika aminak makichkish kajimatkinuk idaisashtatjame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Atumek mina aentsug ainajume,","poem":1},{"lineBreak":true},{"text":"mina uwejui agaja takaku amainaitag numamtin ainajume.","poem":1},{"lineBreak":true},{"text":"Jerusalén peeja tenteamu tsaikbauwa nuna tuke anentaimtajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Shiwag aidau Jerusalégkan","poem":1},{"lineBreak":true},{"text":"wamak tsaikajua nuni senchi shiig wamkeuch","poem":1},{"lineBreak":true},{"text":"ataktu jegamjajum yaaktamkatin ainajume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Jerusalén batsatutigmek pagkaijum,","poem":1},{"lineBreak":true},{"text":"ashí yantamnum niimsatajum,","poem":1},{"lineBreak":true},{"text":"Israel aents aidau achija yajuakbau aidau","poem":1},{"lineBreak":true},{"text":"ataktu waketug Jerusalén kaunainawai.","poem":1},{"lineBreak":true},{"text":"Junak dekas uminkatnun wi Tuke Pujuun tajai.","poem":1},{"lineBreak":true},{"text":"Dita nunik waketiagtai, nuwa aishinatin tsawan jegamtai,","poem":1},{"lineBreak":true},{"text":"iwagmamak patakumtain patakumama numamtuk Jerusalégkak wajaktatui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Atumi nugkem tsaikam pegkegchau wajas amayi,","poem":1},{"lineBreak":true},{"text":"tujash nuna dutikau aina duka yamaik ukukiaje.","poem":1},{"lineBreak":true},{"text":"Nuadui nunú nugkanum kuashat aents piyakmatai,","poem":1},{"lineBreak":true},{"text":"tikich aents pujumain agkauk atsutnai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Atumi uchijum aidau megkaejamtai,","poem":1},{"lineBreak":true},{"text":"kajimatki idaisamu aidau kaunawag chichagtamainak:","poem":1},{"lineBreak":true},{"text":"‘Juju nugkak tikima piipich asa ijunja pujumaitsui.","poem":1},{"lineBreak":true},{"text":"Nunin asamtai tikich nugka sukagtusta nuwi pujusagmi’,","poem":1},{"lineBreak":true},{"text":"tujamiagtatui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tujamainakui atum chichaakjum:","poem":1},{"lineBreak":true},{"text":"‘¿Ya iinash uchinash imatikash amase?","poem":1},{"lineBreak":true},{"text":"Iik kuashat uchigtuchu ayaji,","poem":1},{"lineBreak":true},{"text":"nuigtush uchijinmainchau ayaji,","poem":1},{"lineBreak":true},{"text":"iik uchiji yajutka ukukim uchigtuchu juwakuitji.","poem":1},{"lineBreak":true},{"text":"Tujash ¿jusha tuwiya kaunae?","poem":1},{"lineBreak":true},{"text":"¿Jusha ya kuitamkam tsakakuita?’ titinaitjume”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nuadui Tuke Pujuu apu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi nugka múun aina nunak","poem":1},{"lineBreak":true},{"text":"wainchatai ishamain aidaun iwaintuktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai, nuna wainkag atumi uchijum aidaun,","poem":1},{"lineBreak":true},{"text":"nawanjum aidaun shiig kuitamas yanaki jukiag","poem":1},{"lineBreak":true},{"text":"ikaunmatnume titatjai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja atumek apu aina nunú apajimattagme,","poem":1},{"lineBreak":true},{"text":"untsu apu nawanji aidauk","poem":1},{"lineBreak":true},{"text":"atumi nawanjuchijum aidaun kuitamin agtatui.","poem":1},{"lineBreak":true},{"text":"Nuninak atumin tikishmatjamjag","poem":1},{"lineBreak":true},{"text":"dawem bika wajasun dukatjamiagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninakui anentaimsajum,","poem":1},{"lineBreak":true},{"text":"dekas Tuke Pujuuk pujawapi titatjume.","poem":1},{"lineBreak":true},{"text":"Tuja mina dekaskeapi tujutuidauk tsanuamak achagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Aents wajiu maanitan yacha asa,","poem":1},{"lineBreak":true},{"text":"maania depetmak waji jukimujia duka kakajus atanmaitsui.","poem":1},{"lineBreak":true},{"text":"Tuja aents maaniaku achikmauwa dushakam","poem":1},{"lineBreak":true},{"text":"aents wajiun tsanug ukukig tupikaumaitsui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tujash Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"Aents senchigtin maania depetmak,","poem":1},{"lineBreak":true},{"text":"waji aidaun yajuakbaujinak atanjagtinai,","poem":1},{"lineBreak":true},{"text":"tuja tikich aents wajiu aentsun achika","poem":1},{"lineBreak":true},{"text":"jukiuwa nunashkam atankiagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja atum Israel aents aidautigmin","poem":1},{"lineBreak":true},{"text":"utugchatan itagtamainakuig,","poem":1},{"lineBreak":true},{"text":"wi atumi uchijum aidaunak ayamjuktinaitjai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dutikakun ditak pempeentumakiag yumamatnume,","poem":1},{"lineBreak":true},{"text":"nuninak dita numpenak uwag vinojai betek","poem":1},{"lineBreak":true},{"text":"nampegtinme titatjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai ashí aents nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"wi Tuke Pujuu, amina uwemtikin Jacopan Apajuíji","poem":1},{"lineBreak":true},{"text":"senchigtinaitag nuna dekawagtatui.","poem":1},{"lineBreak":true},{"text":"Witjai amina ayamjukan agkanmitkaunuk”,","poem":1},{"lineBreak":true},{"text":"tiuwai Apajuí.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Nugka “Sinim” tawa nuna daajig yamaik, “Asuán” adaikamui, nuadui tikich versiónnumak Asuán agagbauwai.","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/agr_wbt/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":26}