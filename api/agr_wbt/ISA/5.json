{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":5,"content":[{"type":"heading","content":["Uva ajakbau pachisa kantamamu"]},{"type":"verse","number":1,"content":["Mina kumpaju daajin pachisan, nii uva ajakmamujiya nuna pachisan, kantamtain wi kantamatjai.",{"lineBreak":true},{"text":"Mina kumpagdau nugka pegkeg","poem":1},{"lineBreak":true},{"text":"shiig tsapaunum uva ajakbau ajuyi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuna nugkan pukuja, kaya aidaun utsantuk,","poem":1},{"lineBreak":true},{"text":"uva ajake shiig pegkeg aidaun ajakui.","poem":1},{"lineBreak":true},{"text":"Dutika peegkeg apaka,","poem":1},{"lineBreak":true},{"text":"nunú aja ejapeen kumpinan jiika,","poem":1},{"lineBreak":true},{"text":"vino najanatnunashkam umikui.","poem":1},{"lineBreak":true},{"text":"Dutika umika uva yumimitun tsamakti tusa","poem":1},{"lineBreak":true},{"text":"eke tsamachu asamtai, dakak pujau.","poem":1},{"lineBreak":true},{"text":"Tujash nunú uva aidauk chujuinun tsamakui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"Judá aents aidauwah,","poem":1},{"lineBreak":true},{"text":"nunú nunika dusha ¿yanawaita utugchatash,","poem":1},{"lineBreak":true},{"text":"midaukait, atsa uva ajakbauwa nudaukait?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Uva chujuin ai tusan wi dutikmainush awak?","poem":1},{"lineBreak":true},{"text":"Wika yumimitun nejekti tusan wakekabiajai,","poem":1},{"lineBreak":true},{"text":"tujash ¿wagkag chujuinnash nejekiawa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja midau uva ajakbauwa nunash,","poem":1},{"lineBreak":true},{"text":"wisha itugkatag tajaki nuna yamai ujaktajime.","poem":1},{"lineBreak":true},{"text":"Wika aunak ashí ijinatnume tusan","poem":1},{"lineBreak":true},{"text":"kuitamtsuk idaisattajai, tuja utsaantuawag,","poem":1},{"lineBreak":true},{"text":"najakag kupig ijinatnume tusan","poem":1},{"lineBreak":true},{"text":"peejamua nunashkam tegajattajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dutikan pachitsuk idaisattajai.","poem":1},{"lineBreak":true},{"text":"Tuja tuke nejen ati tusa,","poem":1},{"lineBreak":true},{"text":"kanawe pegkegchau aidau tsupija utsanka","poem":1},{"lineBreak":true},{"text":"pegkeg ematia nunash dutikachagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja dupanash takagsachagtatui,","poem":1},{"lineBreak":true},{"text":"dutikamu asa dupa jagki aidaujai tsapaka","poem":1},{"lineBreak":true},{"text":"akijuatnai.","poem":1},{"lineBreak":true},{"text":"Tuja nuna uchupig pegkeg ematnunash","poem":1},{"lineBreak":true},{"text":"yuminak yutumtijashtatjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtin uvan wakejus ajakua duka","poem":1},{"lineBreak":true},{"text":"Israel aents Judá wegantujai aina nunuwai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk mina chichamjun umigtuktinme","poem":1},{"lineBreak":true},{"text":"tusa wakekauwai,","poem":1},{"lineBreak":true},{"text":"tujash ditak magkagtin wajasu ainawai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk shiig pegkeg dekaskenum takau atinme","poem":1},{"lineBreak":true},{"text":"tusa wakekauwai,","poem":1},{"lineBreak":true},{"text":"tujash ditak ima pegkegchaunak takaidaun","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu wainui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":7}