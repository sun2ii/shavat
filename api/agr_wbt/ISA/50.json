{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":["Nuigtushkam Tuke Pujuu chichaak:",{"lineBreak":true},{"text":"“Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"wika atumin egaknush wainkachmaijime.","poem":1},{"lineBreak":true},{"text":"Untsukmaijime, tujash aigkashmaijume.","poem":1},{"lineBreak":true},{"text":"Wika atumnak pachitskek idaisachuitjime;","poem":1},{"lineBreak":true},{"text":"tuja mina diwig akikmaktinun kuichkin jukitag tusankesh","poem":1},{"lineBreak":true},{"text":"wainka inaku waitkatai atinme tusanuk sujukchabiajime.","poem":1},{"lineBreak":true},{"text":"Wika atumi tudaugmin idaisabiajime.","poem":1},{"lineBreak":true},{"text":"Tujash atum waitu batsatjum nuna","poem":1},{"lineBreak":true},{"text":"jiiki uwemtikmainuk mina senchijuk ajutui.","poem":1},{"lineBreak":true},{"text":"Aents patayi jakamtai, jáanch bukusean nugkuwama","poem":1},{"lineBreak":true},{"text":"numamtuk nayaimpinak wi bukuseayai dukukan idaijai.","poem":1},{"lineBreak":true},{"text":"Tuja nayants, nuigtu namak aina nunú kuyuatag takug","poem":1},{"lineBreak":true},{"text":"wi nunikti tusan machikiuch tamawaitak kuyumainai.","poem":1},{"lineBreak":true},{"text":"Nunik yumi buku wajasmatai,","poem":1},{"lineBreak":true},{"text":"namak aidau jinaa kaukti tusa nunak nunimainai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tuke Pujuu, apu, minak aents pimpiki","poem":1},{"lineBreak":true},{"text":"batsatun jintintua anentain ichichtugti tusa unuitugmae.","poem":1},{"lineBreak":true},{"text":"Tuja aents chichaman antuk betek umiauk","poem":1},{"lineBreak":true},{"text":"jintintayama duwi minak Apajuí kashi kashinig","poem":1},{"lineBreak":true},{"text":"tuké kashikmas inaantawai,","poem":1},{"lineBreak":true},{"text":"niina chichamen antuk unuimagti tujutu asa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, apu, minak chichama umin ati tusa","poem":1},{"lineBreak":true},{"text":"jintinjuauwai.","poem":1},{"lineBreak":true},{"text":"Nuadui wika niina intimjuknuk umigtsukek idaisachmaijai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mina tuntupjui asutuinakuish,","poem":1},{"lineBreak":true},{"text":"asutuatnume tusan idaisabiajai,","poem":1},{"lineBreak":true},{"text":"susujun uwegtuinakuish, idaisabiajai.","poem":1},{"lineBreak":true},{"text":"Dushiktuinak yapijui usuktuinakuish,","poem":1},{"lineBreak":true},{"text":"yapignak ejakchabiajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, apua nunuwai mina yainta duka,","poem":1},{"lineBreak":true},{"text":"nuadui pegkegchaun chichagtuina nunak","poem":1},{"lineBreak":true},{"text":"wika najaimatsjai.","poem":1},{"lineBreak":true},{"text":"Nuadui wika kaya múun umuchmainchawama iman","poem":1},{"lineBreak":true},{"text":"wajasan pujuyajai,","poem":1},{"lineBreak":true},{"text":"nuadui wika wainka inatsamak achattajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mina ayamjutna duka wijai pujawai.","poem":1},{"lineBreak":true},{"text":"Tuja ¿wi pegkegchau takamsamujun etsegtugmainush yaita?","poem":1},{"lineBreak":true},{"text":"¡Nuna dekau akuig, apu chichaman epegkin","poem":1},{"lineBreak":true},{"text":"pegkeg puja nuwi wemi!","poem":1},{"lineBreak":true},{"text":"Wi pegkegchau takamsamun dekau akug nuwi tantati.","poem":1},{"lineBreak":true},{"text":"¡Nunik mina igkuntua tujutti!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, apu, minak kuitamjawai,","poem":1},{"lineBreak":true},{"text":"mina achijuk suwimka sujumainuk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Mina shiwag aina duka jáanch mamuk yuwam","poem":1},{"lineBreak":true},{"text":"megkagama numamtuk megkaejagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":7}