{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":52,"content":[{"type":"heading","content":["Jerusalégnumia aents aidaunak agkanmitkattajai tusa Apajuí tibau"]},{"type":"verse","number":1,"content":[{"text":"Jerusalégnumia aidautijum aneaku niimkau pujustajum,","poem":1},{"lineBreak":true},{"text":"Jerusalén yaakat pegkegma nuwi batsatutigmek wajiu wajastajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum shiig iwagmamkatajum,","poem":1},{"lineBreak":true},{"text":"wagki Apajuín umigchau aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"ataktu awagkig atumnak jetepakchagtatui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jerusalégnumia aidautijum","poem":1},{"lineBreak":true},{"text":"nugká pushugkajum batsatjum duka,","poem":1},{"lineBreak":true},{"text":"datsaamtsuk wajakjum jáanchjum pegakjum yantsaptuktajum,","poem":1},{"lineBreak":true},{"text":"nunikjum apu niina inamtaijin ekemaina numamtuk ekemsatajum.","poem":1},{"lineBreak":true},{"text":"Tuja datsauch aidautigmesh, achija yajuakam","poem":1},{"lineBreak":true},{"text":"batsabaijum nunisjumek yamaikish batsamtsuk,","poem":1},{"lineBreak":true},{"text":"agkanmagatajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tuja Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Atumin achipag yajupakajua nunak minak akigkachu ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui wishakam atumin awakeaknuk makichkish akikmakchattajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaunchuk mina aentsug aidau Egipto nugkanum shiyakag","poem":1},{"lineBreak":true},{"text":"nugkenchau inaku waitkatai batsamajaku ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja tikich tsawantinchakam makichkish","poem":1},{"lineBreak":true},{"text":"utugchatji atsujunak asirianmaya aents aidau","poem":1},{"lineBreak":true},{"text":"senchi waitkasaju ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tujash yamaish ¿wagka imatikash waitkainawah?","poem":1},{"lineBreak":true},{"text":"Mina aentsug aina nunak utugchatji atsujunak","poem":1},{"lineBreak":true},{"text":"Babilonia nugkanum yajuakaje.","poem":1},{"lineBreak":true},{"text":"Dutikawag nuna apuji aidau waitkainak","poem":1},{"lineBreak":true},{"text":"ememas chichainak kashi kashinig kajemtijuinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tujash tsawan jegattawai,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidau mina shiig waitkagtina nunú.","poem":1},{"lineBreak":true},{"text":"Nunik waitkag adeajagtinai, wi ditan chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Witjai apunuk’ tiuwaitag nuna”, tiuwai Apajuí.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents mujanmaya akaiki wekagas yamajam chichaman","poem":1},{"lineBreak":true},{"text":"agkanmaetan uwemtajai pachis etsejak wekagas,","poem":1},{"lineBreak":true},{"text":"Jerusalégnumia aents aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Atumin Apajuíjiyai dekas apuk”,","poem":1},{"lineBreak":true},{"text":"tusa etseja duka shiig anentam auwai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Atumi suntajum jinta niimin aidau","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu Jerusalégnum wakitki midaun wainkag","poem":1},{"lineBreak":true},{"text":"shiig aneenak untsumaina nunú ¡antuktajum!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina aentsji aidaun wait anentug","poem":1},{"lineBreak":true},{"text":"Jerusalégnashkam agkanmitka duwi","poem":1},{"lineBreak":true},{"text":"nii eme anentsajum kantamtai shiig aneasjum","poem":1},{"lineBreak":true},{"text":"senchi kantamatajum!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ashí aents tikich nugkanmaya aidaush","poem":1},{"lineBreak":true},{"text":"wainainamunum Tuke Pujuu niina senchijin iwainake.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí iina uwemtijamja nunak ashí nugkanum dekawagtinai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Babilonia nugkanum batsatjum duka","poem":1},{"lineBreak":true},{"text":"jiinjajum ukuktajum!","poem":1},{"lineBreak":true},{"text":"¡Tuja Tuke Pujuu jeen takastin waji aidau","poem":1},{"lineBreak":true},{"text":"ikaunmatnutigmek kuitamamkatajum,","poem":1},{"lineBreak":true},{"text":"pegkegchau takasaigpa!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tujash wainkajum waugtukaigpa,","poem":1},{"lineBreak":true},{"text":"tuja uumkagmekesh tupikakigpa,","poem":1},{"lineBreak":true},{"text":"atumi aintamuk atsawai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, Israelan Apajuíjiya nunú atumnak","poem":1},{"lineBreak":true},{"text":"kuitamjamainawai.","poem":1}]},{"type":"heading","content":["Tuke Pujuun inakeg waitiakush nii yayasam depetmawai"]},{"type":"verse","number":13,"content":[{"text":"Mina inakjuk ashí depetmaktinai,","poem":1},{"lineBreak":true},{"text":"nuadui tikich aidaun nagkaesau eme anentam atinai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kuashat aents aidau niina yapin diigsag puyatkagtinai,","poem":1},{"lineBreak":true},{"text":"wagki yapi emestujam aents niimtinchau","poem":1},{"lineBreak":true},{"text":"wajasu asamtai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja aents tikich nugkanmaya aidaushkam","poem":1},{"lineBreak":true},{"text":"senchi puyatkagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja apu aidauk nuna wainkag makichkish chichakchagtinai,","poem":1},{"lineBreak":true},{"text":"wagki nunak yaunchkesh antushtain antuinak,","poem":1},{"lineBreak":true},{"text":"waintanashkam wainaidau asag.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":15}