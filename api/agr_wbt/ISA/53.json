{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":["¡Ii etsegbaunak makichik aentskesh dekaskeap tawa",{"text":"tichau ainawai!","poem":1},{"lineBreak":true},{"text":"¡Apajuí senchijinak makichik aentskesh wainkachui!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apajuí niina inakenak ajak yama tsapaak kagkape","poem":1},{"lineBreak":true},{"text":"nugka katsugmanum init akagama nunikti tiuwai.","poem":1},{"lineBreak":true},{"text":"Nunú aentsuk imanchauch, eme anentsa diimainchau,","poem":1},{"lineBreak":true},{"text":"nuigtush wait anenmainkesh atsayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ashí aents aidauk niina tsumainak dakitianume.","poem":1},{"lineBreak":true},{"text":"Niyai dekas senchi najaimak waittsauwa duka.","poem":1},{"lineBreak":true},{"text":"Niig waitiakush, waitiajai tichauwai,","poem":1},{"lineBreak":true},{"text":"wagki tuke unuimatjau asa.","poem":1},{"lineBreak":true},{"text":"Nuadui makichik aents ii dakitamu diimaitsu dutikiaji.","poem":1},{"lineBreak":true},{"text":"Tsuwaaja idaisabiaji, nuadui puyatjusaikish diischauwaitji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tujash niig dutikamaitak ii waitiamujinak nii yajuakmayi,","poem":1},{"lineBreak":true},{"text":"tuja iina najaimatai aidaunak nii yajuakmayi.","poem":1},{"lineBreak":true},{"text":"¡Iik niina pegkegchaujinis aents aidau eemtin","poem":1},{"lineBreak":true},{"text":"Apajuí suwimak susam waitiatai tuyaji!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niinak iina katseken nagki ijuajui,","poem":1},{"lineBreak":true},{"text":"tuja iina tudaujin shiig senchi waitkasaju ainawai.","poem":1},{"lineBreak":true},{"text":"Nii waittsamunum agkanmagat jukimui,","poem":1},{"lineBreak":true},{"text":"tuja nii ijunbaunum iinak etsaentamjauwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja yaunchkek iik uwig kuitamkacham wagaka","poem":1},{"lineBreak":true},{"text":"wekagama numamtuk aayaji.","poem":1},{"lineBreak":true},{"text":"Tujash yamaik Tuke Pujuu iina tudaujinak","poem":1},{"lineBreak":true},{"text":"niyai akikmatjamkauwai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niinak shiwag aidau shiig senchi suwimawagmayi,","poem":1},{"lineBreak":true},{"text":"imatikamash niig ayatak yunumkabi,","poem":1},{"lineBreak":true},{"text":"nuniak makichkish chichakchabi,","poem":1},{"lineBreak":true},{"text":"uwig maatasa juki ematia numamtuk","poem":1},{"lineBreak":true},{"text":"jukiag emagmayi maatasag.","poem":1},{"lineBreak":true},{"text":"Tuja uwig uje tsupigmash takamtak tepegama numamtuk","poem":1},{"lineBreak":true},{"text":"makichkish chichakchabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pegkegchaun takamsachunak achikag jukiagmayi,","poem":1},{"lineBreak":true},{"text":"dutika juwagtaish niina ayamjumainuk makichkish atsubi.","poem":1},{"lineBreak":true},{"text":"Tuja niinak makichkish puyatjukchagmayi,","poem":1},{"lineBreak":true},{"text":"ayatak ajak ajaamu tegai ajapmaina numamtuk,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidau tudaujin maawagmayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niig makichkish magkagtuachu aig,","poem":1},{"lineBreak":true},{"text":"tuja waitjutnakesh waitjuachu aig,","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidau jinau ukusbaunum","poem":1},{"lineBreak":true},{"text":"nuna yantamen ukusagmayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nunak Tuke Pujuu dutik waitkastajai tusa wakekauwai.","poem":1},{"lineBreak":true},{"text":"Niig aents aidau tudaujin waittsau asa,","poem":1},{"lineBreak":true},{"text":"kuashat mijan jatsuk iwaku pujus, nii wegantu aidaun","poem":1},{"lineBreak":true},{"text":"uchiji wegantu aidaunak ashí wainjatnai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu nii dutikatnujin anentaimtujua","poem":1},{"lineBreak":true},{"text":"duka nunú aents waittsamunum betek uminkatnai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imanik waitus nagkaikiu asa,","poem":1},{"lineBreak":true},{"text":"dekaattawai dekas Apajuí umigbau ima pegkeja nuna,","poem":1},{"lineBreak":true},{"text":"nunik shiig aneas juwaktinai.","poem":1},{"lineBreak":true},{"text":"Apajuín inake chichaman betek umina nunú aents aidau","poem":1},{"lineBreak":true},{"text":"tudaujinak entsaktinai, dutikak agkanmitkatnai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui Apajuí niinak senchigtin","poem":1},{"lineBreak":true},{"text":"ashí eme anentsa diitai awajsattawai.","poem":1},{"lineBreak":true},{"text":"Wagki niig pegkegchau takamsachuitak,","poem":1},{"lineBreak":true},{"text":"pegkegchaun takamsaujai betek,","poem":1},{"lineBreak":true},{"text":"aents aidau uwemjatnume tusa, dita tudaujin","poem":1},{"lineBreak":true},{"text":"dita mantamnamainun nii mantamdauwa duwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}