{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":54,"content":[{"type":"heading","content":["Tuke Pujuu anenkeg atakesh nagkankashtinai"]},{"type":"verse","number":1,"content":[{"text":"Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Nuwa uchin uchigmachu aidauwah,","poem":1},{"lineBreak":true},{"text":"shiig aneakjum kantamtai senchi kantamatajum,","poem":1},{"lineBreak":true},{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"‘Nuwa uchin uchigmachu asamtai,","poem":1},{"lineBreak":true},{"text":"idaisamua duka aishinnun nagkaesau uchigtin atatui’, tawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atumin aakjum aina nunú puyattsuk","poem":1},{"lineBreak":true},{"text":"nuni senchi múun awajsatajum,","poem":1},{"lineBreak":true},{"text":"dutikajum daek esajam yajuakjum","poem":1},{"lineBreak":true},{"text":"nunú achimtika jigkaktin numi shiig ajigtajum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ame wegantu aidauk shiig kuashat yujaktatui,","poem":1},{"lineBreak":true},{"text":"nunikag tikich nugkanum shiyakag","poem":1},{"lineBreak":true},{"text":"makichik yaaktakesh atsaunum dita yaaktamak","poem":1},{"lineBreak":true},{"text":"batsamsagtinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ishamkagtukaipa, wainka pegkegchau chichagmak","poem":1},{"lineBreak":true},{"text":"achatnaitme, dushikiamash achattame.","poem":1},{"lineBreak":true},{"text":"Datsa asam uchijum atsau asamtai,","poem":1},{"lineBreak":true},{"text":"dushikiam wekaeyum duka kajimatkita.","poem":1},{"lineBreak":true},{"text":"Ame wajemea pujamin dushiktamainakui,","poem":1},{"lineBreak":true},{"text":"datsaamin ayum duka yamaik nunikchattame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wagki Apajuí amina najapauwa nunú","poem":1},{"lineBreak":true},{"text":"nuwa nuwatkamujai betek awajtamsattawai.","poem":1},{"lineBreak":true},{"text":"Niina daajig Tuke Pujuu ashí senchigtin tutayai.","poem":1},{"lineBreak":true},{"text":"Amina ayamjutpak uwemtijamna duka","poem":1},{"lineBreak":true},{"text":"Israela Apajuíji pegkejam ashí nugkan jajutua awai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amek nuwa muntsugtaitak idaisam pujus","poem":1},{"lineBreak":true},{"text":"waitu pujuuwama numamtuk waitu pujubiume.","poem":1},{"lineBreak":true},{"text":"Tujash niina aishi ataktu awagki tsagkujug","poem":1},{"lineBreak":true},{"text":"jumaina numamtuk,","poem":1},{"lineBreak":true},{"text":"Apajuí untsugmawai midau ati tusa,","poem":1},{"lineBreak":true},{"text":"nuadui juna aatus tujamui:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"‘Ujumchik tsawantai pachitsuk idaisamjame,","poem":1},{"lineBreak":true},{"text":"tujash wika wait anenkagtinaitag iman asan,","poem":1},{"lineBreak":true},{"text":"ataktu awagkin minai itattagme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amina kajegkan, ujumak tsawan uumjukan idaisamiagme.","poem":1},{"lineBreak":true},{"text":"Tujash makichkish kajimatmainchaun aneau asan,","poem":1},{"lineBreak":true},{"text":"wait anenjabiagme’,","poem":1},{"lineBreak":true},{"text":"tusa Tuke Pujuu amina uwemtijamjauwa nunú tawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tuja junashkam Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Yumi ashí nugkanum piyajua nunú tsawantin","poem":1},{"lineBreak":true},{"text":"wi Noén chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Ataktu awagkinuk nugkanmak yuminak","poem":1},{"lineBreak":true},{"text":"pimumtijashtinaitjai’ tiuwaitag dutiksanuk yamaishkam tajai.","poem":1},{"lineBreak":true},{"text":"Ataktuk aminak kajegkashtatjame,","poem":1},{"lineBreak":true},{"text":"tuja awantanashkam awankashtatjame.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muja aidau tikich yantamnum shimakuish,","poem":1},{"lineBreak":true},{"text":"tuja yumpuna kakekuish,","poem":1},{"lineBreak":true},{"text":"wi amina aneajam nunak anentaignak yapajiashtinaitjai,","poem":1},{"lineBreak":true},{"text":"tuja utugchat akuish, epegkea pujutai atinun","poem":1},{"lineBreak":true},{"text":"chichaman umikuitag dushakam yapajinashtinai,","poem":1},{"lineBreak":true},{"text":"tusa Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"amina wait anenjamja nunú tujamui”,","poem":1},{"lineBreak":true},{"text":"tiuwai Isaías.","poem":1}]},{"type":"heading","content":["Yamajam Jerusalén"]},{"type":"verse","number":11,"content":[{"text":"Apajuí chichaak: “¡Jerusalégkah,","poem":1},{"lineBreak":true},{"text":"aminak anentaimin ichichtugmatsuk kajimatki idaitamsagmatai,","poem":1},{"lineBreak":true},{"text":"dase tukua tukuam pegkegchau wajasum nunak","poem":1},{"lineBreak":true},{"text":"ataktu nagkaman iwajattagme!","poem":1},{"lineBreak":true},{"text":"Dutikakun kaya zafiron aepkan nuwi ekenin","poem":1},{"lineBreak":true},{"text":"kaya pegkejuch akik aidauwai peejan umiktatjame.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kumpin aidaunak kaya rubí tutayai najanattajai,","poem":1},{"lineBreak":true},{"text":"tuja waiti aidauk kaya berilo tutayai najanamu agtatui.","poem":1},{"lineBreak":true},{"text":"Untsu yaaktanak kaya pegkejuch aidauwai peejattajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Amina uchijum aidaun,","poem":1},{"lineBreak":true},{"text":"nawanjum aidaujai ashí jintintuattajai,","poem":1},{"lineBreak":true},{"text":"dutika ai, ditak agkan shiig batsamsagtinai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amek shiig takauwaitam duwi senchi atatme,","poem":1},{"lineBreak":true},{"text":"nuadui makichik aentskesh inapakug waitkagmaschatnai.","poem":1},{"lineBreak":true},{"text":"Tuja sapigmamush atsugtamtinai,","poem":1},{"lineBreak":true},{"text":"ishamain antakum sapigmam duka ataktuk","poem":1},{"lineBreak":true},{"text":"sapigmakchatnaitme.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Makichik aentskesh jetepakug,","poem":1},{"lineBreak":true},{"text":"wi inagbau asagkesh jetepakchatnai,","poem":1},{"lineBreak":true},{"text":"dutijamkuish duka ame depetkatnaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Juju shiig antukta:","poem":1},{"lineBreak":true},{"text":"Aents jiju ukuiyag najanin aina nunak wi najanauwaitjai,","poem":1},{"lineBreak":true},{"text":"tuja aents magkagtak utugchatan","poem":1},{"lineBreak":true},{"text":"aepin aina nunashkam wiki najanauwaitjai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja wi najankauwaitag nuna nagkaesaun magkagtutai","poem":1},{"lineBreak":true},{"text":"amina mantamainun najanauk makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Nuadui amina mantamatag tuidauk ashí depetkam","poem":1},{"lineBreak":true},{"text":"itatmikagtinaitme.","poem":1},{"lineBreak":true},{"text":"Wika mina inakeg aidaunak:","poem":1},{"lineBreak":true},{"text":"‘Depetmatan suwajai’ ” tusa Tuke Pujuu tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}