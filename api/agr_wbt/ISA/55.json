{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":55,"content":[{"type":"heading","content":["Apajuí niina aentsji aidaun ijumjatin"]},{"type":"verse","number":1,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Aents kitamauk minai taa uwagti.","poem":1},{"lineBreak":true},{"text":"Kuichik atsugbau aidauk minai kaunawag","poem":1},{"lineBreak":true},{"text":"trigo, vino, leche aidaun akikmatsuk yuwatnume.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waittsa takasa kuichik jukimua duka","poem":1},{"lineBreak":true},{"text":"yutai sumaka yuwa yapajamu megkaekashtinaitkuik,","poem":1},{"lineBreak":true},{"text":"wainka akikmakaik ajapmaitsui.","poem":1},{"lineBreak":true},{"text":"Wi tajam nunú antukam yutai pegkeg yuwatnaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Juwi minai kaunajum wi titatjim nunú antuktajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum iwaku pujustajum.","poem":1},{"lineBreak":true},{"text":"Wi Davita aneau asan anagkuawaitag nuna","poem":1},{"lineBreak":true},{"text":"umiakun, atumjai chichaman umiktatjai","poem":1},{"lineBreak":true},{"text":"atakesh yapajinashtin tuke asatnun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Juju shiig antuktajum,","poem":1},{"lineBreak":true},{"text":"wi niinak mina chichamjun ashí tikich nugkanmaya aidaunash","poem":1},{"lineBreak":true},{"text":"jintintuati tusan apu awajsauwaitjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"aents tikich nugkanmaya aidau untsuktinaitjume.","poem":1},{"lineBreak":true},{"text":"Dutikawagmin atumin waipachu ainayatak,","poem":1},{"lineBreak":true},{"text":"tupi tupikainakua kautjamawagtinai.","poem":1},{"lineBreak":true},{"text":"Wi nunak atumin wait anenjamjatnume tusan dutikattajai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu, Israel aents aidaun Apajuíji pegkegmanuk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu wainkatag takugmek yamaikiuchia duik egaktajum,","poem":1},{"lineBreak":true},{"text":"tuja tikijuch puja duik untsutash untsuktajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pegkegchaun takau aina duka nuninun wekaetutsuk idaisati,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchaun anentaimtin aina dushakam nunak idaisatnume.","poem":1},{"lineBreak":true},{"text":"Ataktu wakitkijum Tuke Pujuu tsagkugkagtina nuwi minitajum,","poem":1},{"lineBreak":true},{"text":"nuniagmin nii wait anenjamjagtatui.”","poem":1}]},{"type":"verse","number":8,"content":["Tuke Pujuu chichaak:",{"text":"“Wika atumjai betekak anentaimtsujai.","poem":1},{"lineBreak":true},{"text":"Nuigtush wi takamua duka atum takajum nujaig betekchauwai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja mina anentaimtajuk,","poem":1},{"lineBreak":true},{"text":"atumi anentaimtajin nagkaesauwai,","poem":1},{"lineBreak":true},{"text":"mina takatjushkam atum takajum nuna nagkaesauwai”,","poem":1},{"lineBreak":true},{"text":"tusa Apajuí tujamui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yumik nayaimpinmaya yutawai,","poem":1},{"lineBreak":true},{"text":"nunikash ataktuk nayaimpinmak wakettsui,","poem":1},{"lineBreak":true},{"text":"ayatak nugkan uchupig ajak tsapamain emawai,","poem":1},{"lineBreak":true},{"text":"dutikamtai ajak aidau tsapawai,","poem":1},{"lineBreak":true},{"text":"nunik nejeku juuka yutayama","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"numamtuk mina chichamjushkam","poem":1},{"lineBreak":true},{"text":"wi tibau umintsukek,","poem":1},{"lineBreak":true},{"text":"tuja wi wakegamua nunashkam dutiktsukek","poem":1},{"lineBreak":true},{"text":"wakitkig minaig waatsui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Atum achija yajuakam batsatjum duka","poem":1},{"lineBreak":true},{"text":"jiinjajum agkan shiig aneasjum,","poem":1},{"lineBreak":true},{"text":"atumi nugkemin waketjajum kaunattagme.","poem":1},{"lineBreak":true},{"text":"Nunika kaunajum muja aidau wainkujum,","poem":1},{"lineBreak":true},{"text":"shiig aneasjum senchi kantamtinaitjume.","poem":1},{"lineBreak":true},{"text":"Atum imatjumin muja aidauk, numi aidauk,","poem":1},{"lineBreak":true},{"text":"aentsjai betek uwejen awatiagtinai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Atumi nugkemin jagki ayá nunú jinaamtai,","poem":1},{"lineBreak":true},{"text":"pino aidau tsapaktinai,","poem":1},{"lineBreak":true},{"text":"tuja naja jinutai arrayán aidau tsapaktinai.","poem":1},{"lineBreak":true},{"text":"Nuna wainainak ashí aents nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"Apajuín emematiagtinai.","poem":1},{"lineBreak":true},{"text":"Apajuí niina senchijin umikbaunak makichkish","poem":1},{"lineBreak":true},{"text":"tsaikchagtin ainawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}