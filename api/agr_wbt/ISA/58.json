{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":58,"content":[{"type":"heading","content":["Ijagma pujusa Apajuí segamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuí mina chichagtak:","poem":1},{"lineBreak":true},{"text":"“¡Ishamkagtutsuk senchi untsumkata,","poem":1},{"lineBreak":true},{"text":"uwija kachuji shinaujai betek senchi chichakta!","poem":1},{"lineBreak":true},{"text":"¡Imatkum mina aentsug Jacob wegantu aina nunú","poem":1},{"lineBreak":true},{"text":"pegkegchaun takamsamuji pachisam senchi chichagkata!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dutikakum tita:","poem":1},{"lineBreak":true},{"text":"‘Atumek minak kashi kashinig untsugjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum chichama umin najaneajum","poem":1},{"lineBreak":true},{"text":"mina umigtuktasajum wakegagme.","poem":1},{"lineBreak":true},{"text":"Nuniau asajum ii chicham uminkatna nunú","poem":1},{"lineBreak":true},{"text":"sukagtusta tusajum segatjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum shiig aneagme Apajuí umigji’ tusajum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tusa tayatkujum:","poem":1},{"lineBreak":true},{"text":"‘¿Wagkaik wainkaish Apajuí waipatsu nuniaish","poem":1},{"lineBreak":true},{"text":"ijagmash pujutji?","poem":1},{"lineBreak":true},{"text":"¿Wagkaik ijagmaish waitush wekaetaji Apajuí waipatsu","poem":1},{"lineBreak":true},{"text":"nuniaish?’ tajume.","poem":1},{"lineBreak":true},{"text":"Tau asajum atumek ijagma pujusa Apajuí segatia","poem":1},{"lineBreak":true},{"text":"nunú tsawantin waji sujakjum,","poem":1},{"lineBreak":true},{"text":"atumi takagtamin aidaushkam shiig akitsuk kasagjume.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atumek ijagma pujusa Apajuí segatia","poem":1},{"lineBreak":true},{"text":"nunú tsawantin jiyaniakjum, maaniakjum ijuni batsatjume.","poem":1},{"lineBreak":true},{"text":"Apajuí atum ijagma pujusa segamun","poem":1},{"lineBreak":true},{"text":"antugtukti takugmek, a antajaig takamaitsugme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ijagma pujusa Tuke Pujuu segaji tayatku,","poem":1},{"lineBreak":true},{"text":"imani batsatmawa duka Apajuínak shiig awagmatsui.","poem":1},{"lineBreak":true},{"text":"Atumek kajis namaka uwet kasua wajama nunikjum","poem":1},{"lineBreak":true},{"text":"tsuntsuma pujusjum, jáanch wake besemag pujaku","poem":1},{"lineBreak":true},{"text":"nugkutai nugkugjum yukunum tepajum nunú,","poem":1},{"lineBreak":true},{"text":"ijagma pujusa Apajuí segaji, tajume.","poem":1},{"lineBreak":true},{"text":"Nuniakjum juju Tuke Pujuunak shiig awagmawai, tajume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tujash duka dekaskechui.","poem":1},{"lineBreak":true},{"text":"Mina shiig awajkati tujutkugmek,","poem":1},{"lineBreak":true},{"text":"ijagma pujusam:","poem":1},{"lineBreak":true},{"text":"Aents achikam chimpija nunú agkanmitkata,","poem":1},{"lineBreak":true},{"text":"takamsachu aig jigkajam batsata nunú atiam agkanmitkata,","poem":1},{"lineBreak":true},{"text":"inaku waitkatai batsata nunú agkanmitkata.","poem":1},{"lineBreak":true},{"text":"Dutikakum shiig takashtai, pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"ashí idaisatajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuniakjum, atumdau yutai ajutjamaina nunú","poem":1},{"lineBreak":true},{"text":"tikich aents nujantai waituidau ajamsatajum;","poem":1},{"lineBreak":true},{"text":"tuja aents jenchauwa duka atumi jem jukitajum;","poem":1},{"lineBreak":true},{"text":"tuja nugkumainji atsakuishkam,","poem":1},{"lineBreak":true},{"text":"jáanch susatajum nugkugti.","poem":1},{"lineBreak":true},{"text":"Dutikakjum tikich aidaushkam tuké yaitajum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nunú dutikakjumek, kashikmas etsa jiinak","poem":1},{"lineBreak":true},{"text":"etsantama iman atatjume.","poem":1},{"lineBreak":true},{"text":"Nuniagmin mina imanjua nunú uyuntamsagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja pegkegchau takataijum aidau tsupimakbaujai betek wajas awa","poem":1},{"lineBreak":true},{"text":"duka wamak esamattawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunikmatai untsugkugminig aiktatjime;","poem":1},{"lineBreak":true},{"text":"tuja yainkata tusajum senchi untsugkugminishkam,","poem":1},{"lineBreak":true},{"text":"wi ayaakun: ‘Juwi pujajai’, titatjime.","poem":1},{"lineBreak":true},{"text":"Tikich aents aidau waitkajum nunú idaisajum","poem":1},{"lineBreak":true},{"text":"pegkegchau chichagtsuk, nuigtush wainka tsanumjutsuk,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yumainji atsujush amek anenmamsam ajampeakum,","poem":1},{"lineBreak":true},{"text":"tikich waituidau yayakjumek,","poem":1},{"lineBreak":true},{"text":"suwenum jii kegak tsaaptin emama numamtin atatjume.","poem":1},{"lineBreak":true},{"text":"Tuja amina pegkegchaujum suwe wajas awa duka,","poem":1},{"lineBreak":true},{"text":"yamai pegkeg takagmin, etsa tutupit wegak","poem":1},{"lineBreak":true},{"text":"etsantug tsaaptin emama iman wajastatui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wi aminak tuké uyuntsattagme,","poem":1},{"lineBreak":true},{"text":"dutikakun uwegshunum pujakminish,","poem":1},{"lineBreak":true},{"text":"shiig kuashat yutain amastatjame,","poem":1},{"lineBreak":true},{"text":"dutikakun senchimtikattagme,","poem":1},{"lineBreak":true},{"text":"nuadui ajak ajakbau yumi ukattai asa pegkejama iman,","poem":1},{"lineBreak":true},{"text":"nuigtu yumi pukuni jiinu tuke amuechau ama iman atatjume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Atum wegantu aidau","poem":1},{"lineBreak":true},{"text":"yaakat yaunchuk tsaikbau aidaun ataktu jegamjagtinai.","poem":1},{"lineBreak":true},{"text":"Dutikainak nunú jegamku kaya aepkamu aidau","poem":1},{"lineBreak":true},{"text":"yumpunawai tusa shiig emetug umikagtinai.","poem":1},{"lineBreak":true},{"text":"Dutikau asagmatai:","poem":1},{"lineBreak":true},{"text":"‘Yaakat peejamu tsaikbaun ataktu iwajin aidau’,","poem":1},{"lineBreak":true},{"text":"nuigtushkam: ‘Jega tsaikbaun iwajin aidau’","poem":1},{"lineBreak":true},{"text":"tuu adaikagtinai.”","poem":1}]},{"type":"heading","content":["Ayamtai tsawan pachisa jintiamu"]},{"type":"verse","number":13,"content":[{"text":"“Tsawan ayamtaya nunú ajantusjum diistajum,","poem":1},{"lineBreak":true},{"text":"tuja mina tsawantug pegkegma duik","poem":1},{"lineBreak":true},{"text":"atumi takatjumek takasaigpajum.","poem":1},{"lineBreak":true},{"text":"Nunú tsawanta duwi shiig aneasjum ima Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"pegkegma duke ememattajum, tibauwa nuwi anentaimsatajum.","poem":1},{"lineBreak":true},{"text":"Nunú tsawantin atumi takatjum,","poem":1},{"lineBreak":true},{"text":"nuniachkush atum wakegamukesh","poem":1},{"lineBreak":true},{"text":"chichamju yujatsuk ayatak ajantusa diistajum.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunú umiakjuminig,","poem":1},{"lineBreak":true},{"text":"shiig aneasa pujutan wi amastatjime.","poem":1},{"lineBreak":true},{"text":"Nuigtush nugka múun aidaun apuji awajsattajime.","poem":1},{"lineBreak":true},{"text":"Dutikakun wi atumi apachjum Jacopan","poem":1},{"lineBreak":true},{"text":"anagkuawaitag nuna nugkan amastatjime.","poem":1},{"lineBreak":true},{"text":"Junak dekas wi umiktinjun tajai”, tiuwai Tuke Pujuu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}