{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":6,"content":[{"type":"heading","content":["Apajuí Isaíasan chichaman etsegtugkati tusa etegkamu"]},{"type":"verse","number":1,"content":["Apu Ozías jakauwa nunú mijantin Apu Apajuí niina ekemsa inamtaiji shiig pegkegnum yakí eketun wainkabiajai. Tuja jega Apajuí emematku ijuntai jegamkamua nuna initkenak nii jáanch nugkuagbauwa nunú dukuka amayi."]},{"type":"verse","number":2,"content":["Apajuí eketbaunum nuna yakin serafín aidau batsamayi. Maki makichik seis nanaptin agmayi. Jimag nanapega duwi yapin dukuaku agmayi, tikich jimaja duwi nawen dukuaku agmayi, tuja tikich jimaja duwi nanamiagmayi."]},{"type":"verse","number":3,"content":["Tuja dita chichainak:",{"text":"“Tuke Pujuu ashí senchigtina duka shiig pegkegmai,","poem":1},{"lineBreak":true},{"text":"tuja niina imanjiya nunú ashí nugkan jajutua awai”, wajagmayi.","poem":1}]},{"type":"verse","number":4,"content":["Nunú Apajuín emematuinak imatuinamu, jega Apajuí emematku ijuntai waitiji aidaun senchi umuchmayi, nuniai nunú jeganum bukuituk yujagkim wajas asabi."]},{"type":"verse","number":5,"content":["Imaniakui chichaakun:",{"text":"“¡Jajapi yamaik! Wagki wika pegkegchaun chichau wajasu,","poem":1},{"lineBreak":true},{"text":"tuja aents pegkegchaun chichau aina nujai ijunjan pujag,","poem":1},{"lineBreak":true},{"text":"nuniayatkunuap Tuke Pujuu ashí senchigtina nuna pan wainkaja”, tusan tibaijai.","poem":1}]},{"type":"verse","number":6,"content":["Tusan tai makichik serafín wi wajamunum nanaak tantabi. Nunik minák altarnumian jii kaiji kapaun juki itanmayi."]},{"type":"verse","number":7,"content":["Dutika duwi mina wenujun antinjuk chichagtak:",{"text":"“Nijah, juju jii kaiji amina wenimin antinjamkae.","poem":1},{"lineBreak":true},{"text":"Juwi Apajuí amina tudaugminak esakatjamjae.","poem":1},{"lineBreak":true},{"text":"Nuadui amina tudaugmek tsagkugnaje”,","poem":1},"tujutmayi."]},{"type":"verse","number":8,"content":["Tujutmatai pujai Apajuí chichaak:",{"text":"“¿Yanak awemainja?","poem":1},{"lineBreak":true},{"text":"¿Yaki iina chichamen etsegnush ati?”","poem":1},"taun antukbaijai. Tusa takui wi ayaakun:",{"text":"“¡Mina awetita, wi amina chichamjumnak etsejin atajai!”","poem":1},"tiabiajai."]},{"type":"verse","number":9,"content":["Tusa tai nii chichagtak:",{"text":"“Wetá nunikam juju aents aidau aatsam ujakta:","poem":1},{"lineBreak":true},{"text":"‘Chichaman antuinakush","poem":1},{"lineBreak":true},{"text":"nunap tawa tusag tichagtatui,","poem":1},{"lineBreak":true},{"text":"tuja pan wainainakush dekachagtatui.’","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Juju aents aina nuna dekatig pachimjukta,","poem":1},{"lineBreak":true},{"text":"dutikakum antukchamin, wainmakchamin emakta,","poem":1},{"lineBreak":true},{"text":"dutikamu asag wainmamainchau, antutnash antumainchau,","poem":1},{"lineBreak":true},{"text":"tuja anentaimsash nunap tawa","poem":1},{"lineBreak":true},{"text":"tusa dekamainchau wajastinme,","poem":1},{"lineBreak":true},{"text":"nuninak pujutjinish yapajinmainchau atinme.","poem":1},{"lineBreak":true},{"text":"Nunidau asagmatai,","poem":1},{"lineBreak":true},{"text":"wishakam dita tudaujinak tsagkujashtatjai,","poem":1},{"lineBreak":true},{"text":"tawai tita”,","poem":1},"tujutmayi."]},{"type":"verse","number":11,"content":["Tusa tujutkui wi niina iniakun:",{"text":"“Apuh, ¿tujash dusha wajupa tsawanta atatua?”","poem":1},"tibaijai. Tusa tai nii aijak:",{"text":"“Yaakat aidaun tsainak","poem":1},{"lineBreak":true},{"text":"ashí aents aidau ijinawajam agkan wajastina duwi,","poem":1},{"lineBreak":true},{"text":"tuja jega aidaunmash makichik aents pujaukesh atsutna duwi,","poem":1},{"lineBreak":true},{"text":"aja aidaunmash atsutna duwi,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"tuja Tuke Pujuu aents aidaun dita nugkenian","poem":1},{"lineBreak":true},{"text":"jiija tikich nugkanum ishiakmatai,","poem":1},{"lineBreak":true},{"text":"dita nugkega nunú aents atsau","poem":1},{"lineBreak":true},{"text":"agkan juwaktina nunú tsawantin nagkankatnai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja cien aents aidaunmaya","poem":1},{"lineBreak":true},{"text":"diezkesh iwaku pujau akushkam ijina utsam agtatui.","poem":1},{"lineBreak":true},{"text":"Dutika ashí ijinawagmataish,","poem":1},{"lineBreak":true},{"text":"numi ajakam wajauti juwama numamtuk,","poem":1},{"lineBreak":true},{"text":"ujumchik Israel Apajuín umijin aidau juwakagtinai.","poem":1},{"lineBreak":true},{"text":"Nuwiya aidau numi ajakbaitak,","poem":1},{"lineBreak":true},{"text":"wajauti ataktu jegama numamtuk wajakagtinai”,","poem":1},"tujutmayi."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}