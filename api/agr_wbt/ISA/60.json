{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":60,"content":[{"type":"heading","content":["Yamajam Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"atumnak Tuke Pujuu imanjiya nunú","poem":1},{"lineBreak":true},{"text":"ijipaku asamtai, winchamtin wajasugme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Untsu nugkanak suwe dukuakui,","poem":1},{"lineBreak":true},{"text":"nuniai yaakat múun aidaunak suwe ijike,","poem":1},{"lineBreak":true},{"text":"untsu atumnak Tuke Pujuu etsantug wajantugmattawai,","poem":1},{"lineBreak":true},{"text":"nuniak niina imanjiya nunú wantintugmakagtatui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aents nugka muunnumia aidauk","poem":1},{"lineBreak":true},{"text":"atumin etsantug awa nuwi miniagtatui,","poem":1},{"lineBreak":true},{"text":"tuja apu aidaushkam atumin tsaaptin awa nuwi miniagtatui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Jerusalégnumia aidauwah,","poem":1},{"lineBreak":true},{"text":"ayampajum ashí niimsatajum,","poem":1},{"lineBreak":true},{"text":"ashí aents aidauk Jerusalén ijunainawai.","poem":1},{"lineBreak":true},{"text":"Atushtanmaya aidau dita patayi aidaujai ashí","poem":1},{"lineBreak":true},{"text":"yajumakag uchin pagkuaku mininawai!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunú imanik kaunainak,","poem":1},{"lineBreak":true},{"text":"nayantsanmaya waji aidaun,","poem":1},{"lineBreak":true},{"text":"tikich nugka múun aidaunmaya waji aidaun","poem":1},{"lineBreak":true},{"text":"takuinaku mininakui shiig aneastinaitjume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Madiágnumia aidau, efánmaya aidau","poem":1},{"lineBreak":true},{"text":"camellonum entsatkau minidau waintinaitjume.","poem":1},{"lineBreak":true},{"text":"Tuja Sabá nugkanmaya aidaushkam","poem":1},{"lineBreak":true},{"text":"ashí camellon yajuakag oron, kugkuin","poem":1},{"lineBreak":true},{"text":"inciensojai patajag minidau wainkujum,","poem":1},{"lineBreak":true},{"text":"mina emematjitnaitjume wi dutikau asamtai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja Quedarnumia aents aidaun","poem":1},{"lineBreak":true},{"text":"tagkuji ikaunmawagtata duka,","poem":1},{"lineBreak":true},{"text":"Nebaiotnumia uwig tsakat aidaun ikaunmawagtata nujai","poem":1},{"lineBreak":true},{"text":"ashí Apajuín shiig anemtiksatin altarnum pataijum apeattagme.","poem":1},{"lineBreak":true},{"text":"Aatus Apajuí niina jee pegkegma nunak nuni pegkeg awajsattawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“¿Aush yujagmijai betek nanaakag,","poem":1},{"lineBreak":true},{"text":"paum dita pasugken shimuwama numamtuk","poem":1},{"lineBreak":true},{"text":"minina dusha ya ainawa?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Duka lancha múun Tarsisnumia aidau,","poem":1},{"lineBreak":true},{"text":"atumi uchijum aidaun yajuakag Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"atumi Apajuíjum senchimtijamna nuna emematiagtatus","poem":1},{"lineBreak":true},{"text":"oron, plata aidaujai yajuak mininawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Apajuí atumin kajegtamak suwimkan amasajui.","poem":1},{"lineBreak":true},{"text":"Dutijamayatak yamai wait anenjamjau asamtai,","poem":1},{"lineBreak":true},{"text":"aents tikich nugkanmaya aina nunú","poem":1},{"lineBreak":true},{"text":"yaakat peejamu aidau tsaikbauwa nunak ataktu peegkeg umikagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja apu aidauk amina inakem agtatui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tikich nugkanmaya apu aidau dita aentsji aidaujai","poem":1},{"lineBreak":true},{"text":"waji aidaun ikaunmawagtin asagmatai,","poem":1},{"lineBreak":true},{"text":"Jerusalégka waitijig kashish, tsawaish tuke ujaim asatnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ashí aents tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"atumin takagtamtan dakituidauk ijinam agtinai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apajuí Jerusalégnumia aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"‘Líbanonmaya waji aina duka, numi dakaja jegamtai shiig pegkeg:","poem":1},{"lineBreak":true},{"text":"pino, abeto, cipre aina nujai","poem":1},{"lineBreak":true},{"text":"ashí wi pujusa inamjatnun etegkauwaitag nuwi","poem":1},{"lineBreak":true},{"text":"mina jegag awa,","poem":1},{"lineBreak":true},{"text":"nunú iwaja shiig pegkejuch awajsatnun ikaunmawagtinai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaunchuk atumin waitkagmajaku aina","poem":1},{"lineBreak":true},{"text":"nuna uchiji aidauk atumin inake waigtatui,","poem":1},{"lineBreak":true},{"text":"tuja atumin yaunchuk dakitjamajaku aidauk","poem":1},{"lineBreak":true},{"text":"atumin tikishmatjamag, Jerusalégkan chichajuinak:","poem":1},{"lineBreak":true},{"text":"“Tuke Pujuu, Israel aents aidaun Apajuíji","poem":1},{"lineBreak":true},{"text":"pegkegma nuna yaaktajiyai”, wajagtinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Atumek kajimatki idaisamu, kajegtai ayugme.","poem":1},{"lineBreak":true},{"text":"Tujash nunak wi yapajian","poem":1},{"lineBreak":true},{"text":"atumin imanjumek tuke atin ati titatjai.","poem":1},{"lineBreak":true},{"text":"Nuadui atumek ajumaish shiig aneasjum pujustinaitjume.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tikich nugkanmaya aidau atum yuwatnun","poem":1},{"lineBreak":true},{"text":"yutai shiig pegkeg aidaun ikautjabiagtinai,","poem":1},{"lineBreak":true},{"text":"tuja apu aidaushkam waji akik aidaun","poem":1},{"lineBreak":true},{"text":"anentag amasagtinai.","poem":1},{"lineBreak":true},{"text":"Nuna Jerusalégnumia aidau wainainak","poem":1},{"lineBreak":true},{"text":"wi Tuke Pujuu, senchigtin, Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"uwemtiknaitag nuna dekajuawagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ ‘Witjai Israel aents aidaun Apajuíjinuk,","poem":1},{"lineBreak":true},{"text":"nudiau asan, agkan shiig takainak batsamsatnume tusan agkan pujutan,","poem":1},{"lineBreak":true},{"text":"waitjutsuk shiig takatan jintintuattajime.","poem":1},{"lineBreak":true},{"text":"Dutikakun bronce amamainaitkun dekas oron amastatjime,","poem":1},{"lineBreak":true},{"text":"tuja hierro amamainun dekas platan amastatjime,","poem":1},{"lineBreak":true},{"text":"tuja numi amamainun dekas broncen amastatjime,","poem":1},{"lineBreak":true},{"text":"tuja kaya amamainun hierron amastatjime.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Atumi nugkeminig maaniamuk makichkish antuekashtinai,","poem":1},{"lineBreak":true},{"text":"tuja yaakat tsayamush atumi nugkeminig","poem":1},{"lineBreak":true},{"text":"makichkish atsutnai.","poem":1},{"lineBreak":true},{"text":"Nuadui Jerusalén peejamua duka","poem":1},{"lineBreak":true},{"text":"“Uwemtai” adaikatnaitjume.","poem":1},{"lineBreak":true},{"text":"Untsu waitiji aina nunú “Dakujutai” adaikatnaitjume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Tuja etsantug tsaaptin wajas","poem":1},{"lineBreak":true},{"text":"ajumaish tuke atina duka witjai.","poem":1},{"lineBreak":true},{"text":"Nuadui atumek etsa etsankui yujasmi,","poem":1},{"lineBreak":true},{"text":"tuja nuniachkuish nantu kashi etsantak tsaaptin","poem":1},{"lineBreak":true},{"text":"weakui yujasagmi tusagmek batsamchattagme.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Witjai Tuke Pujuu atumi Apajuíjinuk.","poem":1},{"lineBreak":true},{"text":"Nuadui etsag makichkish akaikig megkaekashtinai,","poem":1},{"lineBreak":true},{"text":"tuja nantushkam etsanbaujinak kajinkashtinai.","poem":1},{"lineBreak":true},{"text":"Wi ajumaish atumi tsaaptinjum tuke atinaitjai.","poem":1},{"lineBreak":true},{"text":"Nuadui atum wake besemag pujamuk atsugtamiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ ‘Atumi aentsjum aidauk shiig anentaimkau","poem":1},{"lineBreak":true},{"text":"eme anentsa diitai, nugkeesh atantam achatnaitjume,","poem":1},{"lineBreak":true},{"text":"tuja waji ajakaitkuish wi ajakmamu atinaitjume.","poem":1},{"lineBreak":true},{"text":"Wi nunak mina imanjun iwainaktasan dutikattajai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kuashtachu aina nunú yujaka mil aents wajastinai,","poem":1},{"lineBreak":true},{"text":"nunú yujaka nugka múun wajastinai.","poem":1},{"lineBreak":true},{"text":"Wi nunak nunú tsawan jegakui wamak dutikattajai.","poem":1},{"lineBreak":true},{"text":"Witjai dekas Tuke Pujuunuk’, tawai Apajuí”, tiuwai Isaías.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":22}