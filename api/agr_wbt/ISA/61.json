{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":61,"content":[{"type":"heading","content":["Israel aents aidaunum uwemat taatin pachisa etsegkamu"]},{"type":"verse","number":1,"content":["Tuke Pujuu inake chichaak:",{"text":"“Apajuí minak ujudauch aidaun yamajam chichaman ujakti,","poem":1},{"lineBreak":true},{"text":"dutikak waitkam batsata nuna anentain ichichtugti,","poem":1},{"lineBreak":true},{"text":"tuja achikbau aidaunash agkanmitkati,","poem":1},{"lineBreak":true},{"text":"dutikak achikam chimpija nunashkam","poem":1},{"lineBreak":true},{"text":"agkanmitkati tusa awetine.","poem":1},{"lineBreak":true},{"text":"Nuadui niina Wakani minai awai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuigtushkam Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"iina wait anenjamjatnuk tsawan jegattawai,","poem":1},{"lineBreak":true},{"text":"tuja nunú tsawantin Apajuí iina shiwaaji","poem":1},{"lineBreak":true},{"text":"waitkagmaina nuna depetuk, uwemtijamjatnuk","poem":1},{"lineBreak":true},{"text":"tsawantak jegattawai tusam etsegkata tusa awetine.","poem":1},{"lineBreak":true},{"text":"“Tuja aents wake besemag batsatunashkam","poem":1},{"lineBreak":true},{"text":"anentain ichichtugti tusa awetine.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israel aents aidau dita shiwaaji depeteam","poem":1},{"lineBreak":true},{"text":"buutu batsata nuna shiig aneastinme,","poem":1},{"lineBreak":true},{"text":"tuja yukuun ukatmama batsata nuna","poem":1},{"lineBreak":true},{"text":"dakunkut anentain susati tusa awetine.","poem":1},{"lineBreak":true},{"text":"Tuja wi agkanmitkamu asag, numi roble","poem":1},{"lineBreak":true},{"text":"Apajuí ajakbau pejkejush amain aina iman asagmatai, tikich aidau chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Roble katsujam tegamainchau’ tiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Tuja yaunchuk yaakat tsaikbau aidau","poem":1},{"lineBreak":true},{"text":"tuwasua wegaka nunú Jerusalégnumia aidautijum","poem":1},{"lineBreak":true},{"text":"ataktu jegamjajum yaaktamkatnaitjume.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dutikawagmin aents tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"kaunawag tagkuji aidaun, ajajum uva ajakbau aidaujai","poem":1},{"lineBreak":true},{"text":"kuitamjutpakagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Tuja atumnak ‘Sacerdote aidau,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun takajin’ tujamiagtinai.","poem":1},{"lineBreak":true},{"text":"Atumek yutai tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"shiig pegkeg yutinaitjume.","poem":1},{"lineBreak":true},{"text":"Tuja nugkutai aidaushkam pegkeg iwajamu aidau","poem":1},{"lineBreak":true},{"text":"tikich nugkanmaya iwagmamtinaitjume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Atumek mina aentsug ainayatkujum","poem":1},{"lineBreak":true},{"text":"shiig kuashat datsan chichajam,","poem":1},{"lineBreak":true},{"text":"busainaku dushikiam kuashat waittsau ainagme.","poem":1},{"lineBreak":true},{"text":"Nuadui nuna nagkaesau atumi nugkem","poem":1},{"lineBreak":true},{"text":"waji aidaujai shiig kuashat jukitnaitjume.","poem":1},{"lineBreak":true},{"text":"Dutikajum ajumaish tuké shiig aneasjum pujustinaitjume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuík waitjutsuk shiig takamua nuna aneawai,","poem":1},{"lineBreak":true},{"text":"nuniak kajegdayat, magkagtut aina nunak kajejawai.","poem":1},{"lineBreak":true},{"text":"Nuadui niina aentsji anagkuamunak","poem":1},{"lineBreak":true},{"text":"makichkish ewaetsuk umiktinai.","poem":1},{"lineBreak":true},{"text":"Dutikak chicham tuke atinun ditajai umiktinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dutikau asamtai, dita wegantu aidauk","poem":1},{"lineBreak":true},{"text":"tikich aents aidaun nagkaesau shiig kuashat agtinai.","poem":1},{"lineBreak":true},{"text":"Ashí aents aidauk nuna diisag:","poem":1},{"lineBreak":true},{"text":"‘¡Tuke Pujuuwap ditanak pegkegnum yumigjauwaita!’ tiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Tuke Pujuu minak shiig anemtijawai.","poem":1},{"lineBreak":true},{"text":"Apajuí minak dakunkut pujutan sujawai.","poem":1},{"lineBreak":true},{"text":"Apajuí minak uwemtijuje.","poem":1},{"lineBreak":true},{"text":"Apajuí minak shiig pegkegnum kuitamjuke.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuadui jigkai ajaamu tsapaama numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja ajak ayaunmaya tikich ajak tsapaama numamtuk,","poem":1},{"lineBreak":true},{"text":"tsanumtsuk shiig takatan","poem":1},{"lineBreak":true},{"text":"shiig aneasa pujutjai ashí aents aidaunum","poem":1},{"lineBreak":true},{"text":"waji ajakaitkuish, Tuke Pujuu tsapapitnai.","poem":1},{"lineBreak":true},{"text":"Nuadui shiig aneenak kantamiagtinai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}