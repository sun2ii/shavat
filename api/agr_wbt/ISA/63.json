{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":63,"content":[{"type":"heading","content":["Apajuí Israel aents aidaun ayamjak edomnumia aents aidaun ijinatin"]},{"type":"verse","number":1,"content":["¿Yaita aush edomnumia yaakat múun",{"text":"Boshrá tutaya nuwiya jáanch kapantui egkekbau tumainun","poem":1},{"lineBreak":true},{"text":"shiig pegkejan nugkuaju ishamain mina dusha?","poem":1},{"lineBreak":true},{"text":"Nunak wi depetmaktinun iwainajai,","poem":1},{"lineBreak":true},{"text":"wika senchigtin asan uwemtikagtumainaitjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Wagka uva naja najam jáanch kapantu wegama","poem":1},{"lineBreak":true},{"text":"imanush jáanchjumesh wajasuita?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Junak imanikjai wiki uvan najakun,","poem":1},{"lineBreak":true},{"text":"makichkish yainkachaje.","poem":1},{"lineBreak":true},{"text":"Senchi kajekmajai, nunikan mina shiwag aidaun","poem":1},{"lineBreak":true},{"text":"suwimkan susamjai.","poem":1},{"lineBreak":true},{"text":"Dutikakun senchi kajeku asan, tepegka ijinmaina imatikamjai,","poem":1},{"lineBreak":true},{"text":"dutikai nuna numpe aidau","poem":1},{"lineBreak":true},{"text":"tsakiantak jáanchjui ukatjukmae.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunak dutikamjai mina aentsug aidaun ayamjakun,","poem":1},{"lineBreak":true},{"text":"mina shiwag aidau ijinatin tsawan jegau asamtai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mina yainmainush atsuash tukaman","poem":1},{"lineBreak":true},{"text":"makichkish wainkachmaijai,","poem":1},{"lineBreak":true},{"text":"nunikan anentai jegachmaijai.","poem":1},{"lineBreak":true},{"text":"Nunikan senchi kajekbaujui mina senchigjai depetmakmaijai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiig senchi kajekbaujui","poem":1},{"lineBreak":true},{"text":"aents nugka muunnumia aidaunak","poem":1},{"lineBreak":true},{"text":"tepegka ijinmaina numamtuk ijinabiajai.","poem":1},{"lineBreak":true},{"text":"Dutika ai numpa saeki akaikibi.","poem":1}]},{"type":"heading","content":["Apajuí Israel aents aidaun wait anenjatin"]},{"type":"verse","number":7,"content":[{"text":"Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Apajuí anenken pachisan chichaakun,","poem":1},{"lineBreak":true},{"text":"nii jutiin ayamjutpak kuashat dutikauwa nuna","poem":1},{"lineBreak":true},{"text":"anentaimtusan kantamatasan wakegajai.","poem":1},{"lineBreak":true},{"text":"Apajuík Israel aents aidaun wait anentau asa","poem":1},{"lineBreak":true},{"text":"niina anenkega nuna ditan iwaintak kuashat yaigkui.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Ditak mina aentsug asag, mina uchig,","poem":1},{"lineBreak":true},{"text":"mina nawantug aina duwi","poem":1},{"lineBreak":true},{"text":"intimjutmainchau ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui dita pegkegchaujig kuashat aig,","poem":1},{"lineBreak":true},{"text":"wait anentug uwemtikjauwai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidaun waitkagtaik,","poem":1},{"lineBreak":true},{"text":"niig tikichin akupkag ayamjukchauwai,","poem":1},{"lineBreak":true},{"text":"dekas nii Apajuí taa ayamjukui.","poem":1},{"lineBreak":true},{"text":"Apajuík niina anenken, niina senchijin aatus,","poem":1},{"lineBreak":true},{"text":"Israel aents aidaunak wait anentak","poem":1},{"lineBreak":true},{"text":"tuké ayamjuk uwemtiknai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Imatika yayamash Israel aents aidauk intimjuinak,","poem":1},{"lineBreak":true},{"text":"Apajuí pegkegman ikajejaku ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui ditan pempeentuki shiwaajui","poem":1},{"lineBreak":true},{"text":"itugmaina numamtuk ditajai maaniauwai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imanik waituinak yaunchuk Moisés","poem":1},{"lineBreak":true},{"text":"dita apachji aajaku aidaun jiija yajuak","poem":1},{"lineBreak":true},{"text":"uwemtikjauwa nuna anentaimtus chichainak:","poem":1},{"lineBreak":true},{"text":"‘Moisés Israel aents aidaun apuji aajakua nunú","poem":1},{"lineBreak":true},{"text":"piipich asamtai, namak Nilonum ajugkam jakeaun","poem":1},{"lineBreak":true},{"text":"jiikiuwa dusha Apajuísh ¿tuwi pujawa?","poem":1},{"lineBreak":true},{"text":"Tuja Moisésai Niina Wakani pegkegman","poem":1},{"lineBreak":true},{"text":"apusauwa dusha Apajuísh ¿tuwi pujawa?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apajuí niina senchijijai Moisésan uyunajakua dusha,","poem":1},{"lineBreak":true},{"text":"tuja niina aentsji aidau ishamainun ukumtikak,","poem":1},{"lineBreak":true},{"text":"atakea duish kajimatkishtinun niina senchijin iwainak","poem":1},{"lineBreak":true},{"text":"nayantsan ukuyauwa dusha ¿tuwi pujawa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Caballo mujanum weakush atakuinag iyauchua numamtuk,","poem":1},{"lineBreak":true},{"text":"nayants buku wajasbaunum initak shimakush,","poem":1},{"lineBreak":true},{"text":"atakuinjashtinme tusa umikua dusha Apajuísh yamaish ¿tuwi pujawa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apajuí niina aentsji aidaun baka aidau nainnum yujau","poem":1},{"lineBreak":true},{"text":"wakeen nugka pakanum utsanawag","poem":1},{"lineBreak":true},{"text":"ayamama numamtuk ayamtikna dusha","poem":1},{"lineBreak":true},{"text":"Apajuísh ¿tuwi pujawa?’ tiagtinai”, tiuwai.","poem":1},{"lineBreak":true},{"text":"Tuja inagnamua nuna Isaías chichaak:","poem":1},{"lineBreak":true},{"text":"“Apajuín Wakani ditan uyuntsauwai.","poem":1},{"lineBreak":true},{"text":"Aatus niina imanjin ashí iwainak ekemsauwai”, tiuwai.","poem":1}]},{"type":"heading","content":["Apajuí yainkati tusa augbau"]},{"type":"verse","number":15,"content":[{"text":"Israel aents aidau Apajuín aujainak:","poem":1},{"lineBreak":true},{"text":"“Chah, Apajuíjuh, ame pujutaijum","poem":1},{"lineBreak":true},{"text":"nayaim pegkegma nuwi pujusam antukta.","poem":1},{"lineBreak":true},{"text":"Amek jikamsa anejatchau dekapeaji,","poem":1},{"lineBreak":true},{"text":"tuja ame senchigtinaitam dusha iwainkagtatsme.","poem":1},{"lineBreak":true},{"text":"¿Amesh jutiish wajuk diijatme?","poem":1},{"lineBreak":true},{"text":"Atsa amina wait anenkagtutaigmek ¿amuekaek?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Ametme jutiin apajimek,","poem":1},{"lineBreak":true},{"text":"Abraham niina uchijichu anenjamkuish,","poem":1},{"lineBreak":true},{"text":"tuja Israel pachipachkuish,","poem":1},{"lineBreak":true},{"text":"ametme iina apajimek!","poem":1},{"lineBreak":true},{"text":"¡Ametme iina tuke uwemtikagtinmek!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aminí kanaktinme tusamek tukagtipa,","poem":1},{"lineBreak":true},{"text":"tuja intimkiu atinme tusamesh tukagtipa.","poem":1},{"lineBreak":true},{"text":"Amina inakem ainag nunú,","poem":1},{"lineBreak":true},{"text":"amina aentsjum maki makichik wegantu","poem":1},{"lineBreak":true},{"text":"aina nujai aneakmek, ataktu wait anenkagtugta.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amina aentsjum ame etegkamu aina duka","poem":1},{"lineBreak":true},{"text":"dita nugkeenig ujumak tsawanchik batsatui.","poem":1},{"lineBreak":true},{"text":"Ame emematku ijuntaiya nunak","poem":1},{"lineBreak":true},{"text":"iina shiwaaji aidau pegkegchau awajainawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ii aidautik amina chichamem umitsuk,","poem":1},{"lineBreak":true},{"text":"nuigtush aminuchu amaina numamtuk batsatji.","poem":1},{"lineBreak":true},{"text":"Wait aneasam amina anenkem","poem":1},{"lineBreak":true},{"text":"ataktu iwainkagtukta”, tiajui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":19}