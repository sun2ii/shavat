{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":["Apajuíjuh, utusamek nayaim ujaim",{"text":"akaikim nugká taakum muja aidau pegakam,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"jii kegak jagki kagakun apegama numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja dutikachkush yumin ukuwama numamtuk","poem":1},{"lineBreak":true},{"text":"awajkam tusa wakegaji.","poem":1},{"lineBreak":true},{"text":"Nuna amina shiwaajum aidau wainainak,","poem":1},{"lineBreak":true},{"text":"Apajuík ima ameketam nuna dekawagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja aents nugka muunnumia aidaush ishamjamainak","poem":1},{"lineBreak":true},{"text":"kujaidiagtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuashat ishamain aidau iwainajuitam nunú","poem":1},{"lineBreak":true},{"text":"iina uwaktamkauwai.","poem":1},{"lineBreak":true},{"text":"Nuadui muja aidaush amina emtimin","poem":1},{"lineBreak":true},{"text":"senchi buchitiagmayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aminí kajinas anentaimaidau yayaakum,","poem":1},{"lineBreak":true},{"text":"ame ishamain aidau iwaintujuitam dutika","poem":1},{"lineBreak":true},{"text":"tikich apajuí niina kajitus anentaidaun yayaak,","poem":1},{"lineBreak":true},{"text":"imanun ditan iwaintukuk yaunchkesh makichkish wainkachbauwai,","poem":1},{"lineBreak":true},{"text":"tuja antutkesh antushtayai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aminak aents shiig aneas pegkejan takak,","poem":1},{"lineBreak":true},{"text":"chichamjum umiktina nuna","poem":1},{"lineBreak":true},{"text":"aneaku puja nunú shiig awajtamui.","poem":1},{"lineBreak":true},{"text":"Amek ii pegkegchau takaku yaunchuk","poem":1},{"lineBreak":true},{"text":"nagkamsaish ikaje pujag duwi kajekume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ii aidautik makichik aents tsumaina iman ainaji.","poem":1},{"lineBreak":true},{"text":"Ii pegkeg takaji taji dushakam jáanch tsuwata iman ainawai.","poem":1},{"lineBreak":true},{"text":"Ashí ii aidautik duka kagaka kakekaujai betek ainaji.","poem":1},{"lineBreak":true},{"text":"Tuja iina magkagtutaijiya nunú dasejai betek","poem":1},{"lineBreak":true},{"text":"tukugmi ajapjamainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Amina segapauk, tuja amina nii wait anenjugti tusa kakanmamukesh","poem":1},{"lineBreak":true},{"text":"makichkish atsawai!","poem":1},{"lineBreak":true},{"text":"Nuadui amek iina pegkegchaujin uumka idaikagtusume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apuh, ii nunin ainajinish, ametme iina apajimek.","poem":1},{"lineBreak":true},{"text":"Ii aidautik duwejai betek ainaji,","poem":1},{"lineBreak":true},{"text":"untsu amek aents duwen namuka najannujai betekaitme.","poem":1},{"lineBreak":true},{"text":"¡Iik ashí ame najankamu ainaji!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, imanikmek kajekaipa,","poem":1},{"lineBreak":true},{"text":"tuja iina magkagtutai aidaush pachikaipa.","poem":1},{"lineBreak":true},{"text":"¡Kame, iik amina aentsjum ainaji!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yaakat ame etegkamu aina duka","poem":1},{"lineBreak":true},{"text":"itajak wajas bashiak ainawai.","poem":1},{"lineBreak":true},{"text":"Jerusalégnak iina shiwaaji aidau tsaikam","poem":1},{"lineBreak":true},{"text":"pegkegchau wajas awai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amina jem pegkegmanum iina apachji aidau","poem":1},{"lineBreak":true},{"text":"amina emematjamajaku aina nunak","poem":1},{"lineBreak":true},{"text":"jiiyai apea ashí tsaikajui.","poem":1},{"lineBreak":true},{"text":"¡Ii ima senchi wakesa diin ayag duka","poem":1},{"lineBreak":true},{"text":"tsaikam pegkegchau wajas awai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tuke Pujuuwah, imatikau aina nuna iikmakti","poem":1},{"lineBreak":true},{"text":"tusamek amek ¿yaijatkashtatmek?","poem":1},{"lineBreak":true},{"text":"Atsa ¿ayatkek idaisattam?","poem":1},{"lineBreak":true},{"text":"Nuniakum aan senchi waitkastinme","poem":1},{"lineBreak":true},{"text":"tusamek ¿idaikagtustatam?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}