{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":65,"content":[{"type":"heading","content":["Apajuín shiwagbaunak nii suwimkan suwawai"]},{"type":"verse","number":1,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Aents makichkish mina segatchau aajabia","poem":1},{"lineBreak":true},{"text":"nunú mina kautjuinawai;","poem":1},{"lineBreak":true},{"text":"tuja aents mina egatkachu aajabia nunú","poem":1},{"lineBreak":true},{"text":"yamai mina waituinawai.","poem":1},{"lineBreak":true},{"text":"Mina emematjuchu aajabia nuna chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Juwi pujajai’, tibaijai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aents intimkiu aidau","poem":1},{"lineBreak":true},{"text":"wijai shiwagmagainak,","poem":1},{"lineBreak":true},{"text":"dita wakegamun pegkegchaun taka yujau aina","poem":1},{"lineBreak":true},{"text":"nunú segatainakui yaigtasan tuke dakabiajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunú aents aidauk mina igkuntuawag","poem":1},{"lineBreak":true},{"text":"tuke inastuinawai.","poem":1},{"lineBreak":true},{"text":"Dita aidauk apajuímtai dakumka najanamun","poem":1},{"lineBreak":true},{"text":"emematuinak,","poem":1},{"lineBreak":true},{"text":"kuntinu maawag ikam yujasag, kaya pataja","poem":1},{"lineBreak":true},{"text":"najanamunum nuwi patainiag apé yujau aajabi.","poem":1},{"lineBreak":true},{"text":"Nuigtushkam ladrillo najanamunum kugkuin incienson","poem":1},{"lineBreak":true},{"text":"apé yujau ainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunú aents aidauk ukumatainum pekamá yujayanume,","poem":1},{"lineBreak":true},{"text":"nuninak waanum uumak batsamas tsawampa","poem":1},{"lineBreak":true},{"text":"batsamianume.","poem":1},{"lineBreak":true},{"text":"Nunú aents aidauk Apajuí dakitamun","poem":1},{"lineBreak":true},{"text":"kuchi nejen yuyanume,","poem":1},{"lineBreak":true},{"text":"nuigtush dakumkamu emematku kuntin","poem":1},{"lineBreak":true},{"text":"maamu aidau painkamun yumiji ollanmak tsumain aajabi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunú aents aidau chichainak:","poem":1},{"lineBreak":true},{"text":"‘Antijatkaigpa iik Apajuí etegjamu asa","poem":1},{"lineBreak":true},{"text":"pegkejam ainaji’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Nunú aents aina duka jii tuke,","poem":1},{"lineBreak":true},{"text":"tsawantai keeka aama numamtin ainawai.","poem":1},{"lineBreak":true},{"text":"Jii bukuituji dujin amajama","poem":1},{"lineBreak":true},{"text":"numamtuk minak waitkajuinawai”, tiuwai.","poem":1}]},{"type":"heading","content":["Nayaim yamajam nugka yamagmajai"]},{"type":"verse","number":17,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Antuktajum nijah, wi yamajam nayaimpin,","poem":1},{"lineBreak":true},{"text":"nugka yamagmajai najanattajai.","poem":1},{"lineBreak":true},{"text":"Tuja yama nagkamchak nayaim","poem":1},{"lineBreak":true},{"text":"nugkajai aajakua nunak kajimatkiagtinai.","poem":1},{"lineBreak":true},{"text":"Makichkish nunak tuke adeagchagtinai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi nuna yamagman najanatin asamtai,","poem":1},{"lineBreak":true},{"text":"ajumaish tuké shiig aneastin atajum.","poem":1},{"lineBreak":true},{"text":"Wi yamajam Jerusalégkan shiig pegkejan","poem":1},{"lineBreak":true},{"text":"najanattajai;","poem":1},{"lineBreak":true},{"text":"dutikamtai nuwi aents aidauk shiig aneasag batsamsagtinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja wishakam Jerusalégkan diisan","poem":1},{"lineBreak":true},{"text":"shiig aneastatjai;","poem":1},{"lineBreak":true},{"text":"nuniakun mina aentsug aina nuwishkam","poem":1},{"lineBreak":true},{"text":"shiig aneastatjai.","poem":1},{"lineBreak":true},{"text":"Jerusalégnumak jaku buutbaush atsutnai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nunú nugkanmak uchi akiina jaka megkaguk atsutnai,","poem":1},{"lineBreak":true},{"text":"tuja múunchishkam tsawanjin shiig ejetsuk","poem":1},{"lineBreak":true},{"text":"jauk atsutnai.","poem":1},{"lineBreak":true},{"text":"Tuja makichik aentskesh cien mijan ajamu jauk","poem":1},{"lineBreak":true},{"text":"múuntuch achatnai, datsauch atinai.","poem":1},{"lineBreak":true},{"text":"Tuja cien mijanan ejetsu duka suwimak asamtai nuniktinai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents aidauk nunú yaaktanum jegamag batsamas,","poem":1},{"lineBreak":true},{"text":"trigon, uvan ajakmakag nuna nejen juukag yuwagtinai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dita jegamkamunmak tikich","poem":1},{"lineBreak":true},{"text":"akiinag batsamsachagtinai,","poem":1},{"lineBreak":true},{"text":"tuja dita ajakmamujinash atankiajag yujuachagtinai.","poem":1},{"lineBreak":true},{"text":"Mina aentsug aidauk numijai betek","poem":1},{"lineBreak":true},{"text":"kuashat tsawan iwaku pujusagtinai;","poem":1},{"lineBreak":true},{"text":"Wi etejamu aina duka dita takasbaujinian","poem":1},{"lineBreak":true},{"text":"jukiag shiig batsamsagtinai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dita aidauk Apajuí pegkegnum yumigjamu asag","poem":1},{"lineBreak":true},{"text":"wainak takainakug waittsachagtinai,","poem":1},{"lineBreak":true},{"text":"tuja dita uchiji aidaushkam","poem":1},{"lineBreak":true},{"text":"tsawan jegatsaigkik jakachagtinai.","poem":1},{"lineBreak":true},{"text":"Nunú uchi aidau wegantu aidaushkam","poem":1},{"lineBreak":true},{"text":"ditajai betek pegkegnum yumigjamu agtinai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eke dita untsujuinatsaig,","poem":1},{"lineBreak":true},{"text":"wiyá ditanak aiktinaitjai;","poem":1},{"lineBreak":true},{"text":"tuja eke chichakag ashimainatsaig,","poem":1},{"lineBreak":true},{"text":"wiyá ditanak antugkatnaitjai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lobo uwig tsakatjai jimagtuk yuwawagtinai.","poem":1},{"lineBreak":true},{"text":"Leónkak bueyejai betek chijichin yutinai.","poem":1},{"lineBreak":true},{"text":"Untsu dapi nugka yukukuntun yutinai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"‘Jerusalégnumak tikichin pegkegchau awagbauk","poem":1},{"lineBreak":true},{"text":"makichkish atsutnai’ ”, tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}