{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":7,"content":[{"type":"heading","content":["Isaías apu Acazan yama nagkamchak ujakbau"]},{"type":"verse","number":1,"content":["Jotama uchiji, Ozíasa tijaji Acaz Judá aents aidaun apuji wajas Jerusalén pujai, Siria nugkan apuji Resín, Remalíasa uchiji Pécah Israel aents aidaun apuji aajakua nujai jimagtukag Jerusalégkan jetekajui, depetka iinu emami tusag. Tujash depetkachajui."]},{"type":"verse","number":2,"content":["Dutika jeteagtai, Apu Acaz pujusa inamtaijin niina aentsji aidaujai pujuttaman jegajuawag ujainak: “Sirianmaya aents aidau Israel aents aidaujai jetepakagtatus ijunjaje”, tusa ujakajui. Nuna dekaa niina aentsji aidaujai ishamak kujainak, numi dase umpuam saatama imanidau."]},{"type":"verse","number":3,"content":["Imaniagtai Tuke Pujuu Isaíasan chichajak: “Amina uchijum Sear-iasubjai weme apu Acaz igkugta. Duka Gihonnum yumi pukuni jiina nuwiya japiki aimkatin aepá juki yaki yumi aimtainum nain iwakbauwa nuwi ayaumas jáanch nijaku wetai jinta nagkaemakua nuwi igkugtatme."]},{"type":"line_break"},{"type":"verse","number":4,"content":["“Nunika chichagkum:",{"text":"“ ‘Kuitamamkata, tujash ishamkaipa;","poem":1},{"lineBreak":true},{"text":"apu Resín, apu Pécahjai shiig senchi kajenawai,","poem":1},{"lineBreak":true},{"text":"tujash ishamkaipa,","poem":1},{"lineBreak":true},{"text":"wagki ditak jii bukuituk wamak kajinama numamtin ainawai’, tita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja sirianmaya aents aidau, Efraín aents aidau","poem":1},{"lineBreak":true},{"text":"Remalíasan uchiji aatus amina","poem":1},{"lineBreak":true},{"text":"mantamatatus chichaman umigtamkagmae.","poem":1},{"lineBreak":true},{"text":"Nunik chichainak:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"‘Judá aents aina duka uwaaka depetka utua","poem":1},{"lineBreak":true},{"text":"Tabeelan uchijiya nunú apu adaitukmi’, tuinawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tujash Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"‘¡Duka makichkish nunikchattawai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wagki Sirian yaaktaji dekas","poem":1},{"lineBreak":true},{"text":"múunta duka Damaskui,","poem":1},{"lineBreak":true},{"text":"tuja Resínkai Damascon apuji;","poem":1},{"lineBreak":true},{"text":"tuja Efraín aents aina nuna yaaktaji","poem":1},{"lineBreak":true},{"text":"dekas múunta duka Samariayai,","poem":1},{"lineBreak":true},{"text":"tuja Remalíasan uchijiya nunuwai Samarian apuji.","poem":1},{"lineBreak":true},{"text":"Tujash Efraín aents aidau ditash nugkentin aina nunak","poem":1},{"lineBreak":true},{"text":"sesenta y cinco mijan jegai, depetkag","poem":1},{"lineBreak":true},{"text":"nugke atankim nugkenchau juwakagtatui.","poem":1},{"lineBreak":true},{"text":"Tuja atumshakam minai kajintsa","poem":1},{"lineBreak":true},{"text":"anentaimkujum dekaskeapi tusajum,","poem":1},{"lineBreak":true},{"text":"mina umigtachkugmek ijina utsam atatjume’,","poem":1},{"lineBreak":true},{"text":"tawai Apajuí”, tiuwai Isaías.","poem":1}]},{"type":"verse","number":10,"content":["Tuja nuigtushkam Tuke Pujuu Acazan chichajak:"]},{"type":"verse","number":11,"content":["“Ame dutikatnujum wainchatai aidau iwaintugkata tusam Tuke Pujuu amina Apajuíjum segata, tuja ame waji wakegame nunú nayaimpinmayagkesh nuniachkumesh nugka initkeniagkesh segatta, tusa tujamui”, tau."]},{"type":"verse","number":12,"content":["Tusa tama Acaz ayaak: “Atsa make, wika Tuke Pujuun nuna segaakun pegkegchaunum dekaptanak dakitajai”, tiuwai."]},{"type":"verse","number":13,"content":["Tutai Isaías chichaak:",{"text":"“Davitan patayi aidautijum antuktajum.","poem":1},{"lineBreak":true},{"text":"¿Aents atumin chichagtamu antugtsuk intimjakjum","poem":1},{"lineBreak":true},{"text":"waitkajum duke nuniskek,","poem":1},{"lineBreak":true},{"text":"Apajuíyaske waitkastasajum wakegajum?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunin asagmin atumnak","poem":1},{"lineBreak":true},{"text":"Apajuí nii dutikatnujin iwaintugmaktatui.","poem":1},{"lineBreak":true},{"text":"Nunak: ¡Makichik nuwa muntsujut aentsu takashtai ejapjuktatui,","poem":1},{"lineBreak":true},{"text":"nunik uchi aishmagkun uchigmaktatui,","poem":1},{"lineBreak":true},{"text":"dutika uchigmakmatai, uchi daaji adaikattagme Emanuel!","poem":1},{"noteId":0}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nunú uchi muumpak ashí anentaimama nuniak","poem":1},{"lineBreak":true},{"text":"baka muntsuji kantemtikamun dapa yumijiyai yutinai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tujash nunú uchik eke jintiag anentaimtan juwatsaig,","poem":1},{"lineBreak":true},{"text":"jimag nugka múun amina uwaktamaina nuna tsaikagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Tuja duwi pujus tikich tsawantin amina,","poem":1},{"lineBreak":true},{"text":"nuigtu amina aentsjum aina nuna,","poem":1},{"lineBreak":true},{"text":"ame wegantu aina nuna aatus","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu suwimak ishamainun awetugmattawai.","poem":1},{"lineBreak":true},{"text":"Dutikamtai yaunchuk Salomón apu pujusmatai,","poem":1},{"lineBreak":true},{"text":"Israel aents aidau","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaujai kanakajua duwi nagkamsaish,","poem":1},{"lineBreak":true},{"text":"makichkish imanuk wainkachbau shiig ishamain atinai.","poem":1},{"lineBreak":true},{"text":"¡Duka asirianmaya apu niina suntaji aidaujai","poem":1},{"lineBreak":true},{"text":"waitkagmasagtina nunuwai!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nunú tsawan jegatai, egiptunmaya suntag aidaun,","poem":1},{"lineBreak":true},{"text":"kaapjai betek shiig kuashat,","poem":1},{"lineBreak":true},{"text":"tuja nuigtu asirianmaya suntag aidaun dapa ishamain","poem":1},{"lineBreak":true},{"text":"ijujatin aina imanun Tuke Pujuu ishitjamkatnai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dutikam kaunak nugka ségaju aidaunum,","poem":1},{"lineBreak":true},{"text":"uwejush aidaunum, kaya múun waa aidaunum,","poem":1},{"lineBreak":true},{"text":"jagki tepaju aidaunum,","poem":1},{"lineBreak":true},{"text":"tuja yumi baka umutai aina nuwi, aatus ashí piyaktinai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nunú tsawantin namak Eufratesa amainia","poem":1},{"lineBreak":true},{"text":"navaja ikamka itamaina numamtuk,","poem":1},{"lineBreak":true},{"text":"Apajuí asirianmaya aents aidaun apujin","poem":1},{"lineBreak":true},{"text":"niina suntaji aidaujai ikaunmatnai.","poem":1},{"lineBreak":true},{"text":"Dutikam Israel aents aidau intashin,","poem":1},{"lineBreak":true},{"text":"susujin, uje aidaunash ashí kesajug utsankagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nunú tsawantinig makichkiuch bakan,","poem":1},{"lineBreak":true},{"text":"jimagchik uwigjai apujus pujayatak,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"shiig kuashat nuna muntsujin","poem":1},{"lineBreak":true},{"text":"ijuja juwau asa, nuna kantemtika yutinai.","poem":1},{"lineBreak":true},{"text":"Tuja tikich aents maaniamunum uwemjau","poem":1},{"lineBreak":true},{"text":"aidaushkam nunú baka muntsuji kantemtikamun,","poem":1},{"lineBreak":true},{"text":"dapa yumijijai atsumkas yutin ainawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja mil uva ajakbaun akike","poem":1},{"lineBreak":true},{"text":"mil plata aajakua duka ayatak jagki tsapaka","poem":1},{"lineBreak":true},{"text":"ikam wajas asatnai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nunú nugkanmak ashí jagki tsapaka akijua","poem":1},{"lineBreak":true},{"text":"ikam wajasu asamtai,","poem":1},{"lineBreak":true},{"text":"ayatak kuntin maatasa wekaetai atatui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuja nain tepetpetu aidaunum","poem":1},{"lineBreak":true},{"text":"pegkeg takatai aajabia duka jagki wajastinai,","poem":1},{"lineBreak":true},{"text":"imanikmatai ishamainak makichkish duka wechagtinai.","poem":1},{"lineBreak":true},{"text":"Ayatak uwig aidau, baka aidau yutai wajastinai.”","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Emanuel” tawa nunak: “Apajuík jutiyai awai” taku tawai.","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/agr_wbt/ISA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/6.json","previousChapterAudioLinks":{},"numberOfVerses":24}