{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":8,"content":[{"type":"heading","content":["Isaíasan uchiji akiinatin pachisa etsegkamu"]},{"type":"verse","number":1,"content":["Tuke Pujuu chichagtak: “Sacerdote Urías, Jeberequíasa uchiji Zacaríasjai untsukta. Dutikam dita wainbaunum makichik numi dakakbau wegkajam jukim nuwi shiig pan wainmain: ‘Maher-salal-hasbaz’",{"noteId":1},"tuu agagta” tujutiabi."]},{"type":"verse","number":3,"content":["Tujutmatai nuna agajan pujusan tikich tsawantin mina duwajui uchi aishmagkun akiauwaitjai. Dutika ai Tuke Pujuu chichagtak: “Uchi daajig Maher-salal-hasbaz adaikattame."]},{"type":"verse","number":4,"content":["Nunú uchik: ‘Apauch, awach’ tusagkesh eke chichatsaig, asirianmaya aidau yaakat Damasconak Samariajai mai tsaikagtinai. Dutikawag dita wajiji aidaunak ashí yajutkagtin ainawai”, tujutmayi."]},{"type":"verse","number":5,"content":["Nuna tujuti ataktu Tuke Pujuu chichagtak:"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Wika yumi aimkamu Siloé tutai","poem":1},{"lineBreak":true},{"text":"chichigmachua nujai betek kakagchauchitag duwi","poem":1},{"lineBreak":true},{"text":"juju aents Judá wegantu aina duka","poem":1},{"lineBreak":true},{"text":"Siria apuji Rezínkan Israel aents aidaun apuji Pécahjai ishamainak,","poem":1},{"lineBreak":true},{"text":"dita ayamjutpaktinme tuidau asag","poem":1},{"lineBreak":true},{"text":"mina dakitjuinawai”, tiuwai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuadui ditanak Apajuí","poem":1},{"lineBreak":true},{"text":"asirianmaya suntag aidaun ishitkattawai,","poem":1},{"lineBreak":true},{"text":"dutikam namak Eufrates dujajak","poem":1},{"lineBreak":true},{"text":"ashí utuja nugkan yumpuag eemak,","poem":1},{"lineBreak":true},{"text":"nuwi ayaunak ashí utsauwama numamtuk ditanak utsagtatui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imatikau asa Judá wegantu aidaunashkam","poem":1},{"lineBreak":true},{"text":"waji nujagketkuish, ashí utuja suwega iman iwaktinai.","poem":1},{"lineBreak":true},{"text":"Imatikak águilajai betek nanapen ayapatug","poem":1},{"lineBreak":true},{"text":"ashí dukuk uwemainchau awajsatnai.","poem":1},{"lineBreak":true},{"text":"Tujash jutiyaig Apajuí pujawai.","poem":1},{"noteId":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ashí aents nugka muunnum","poem":1},{"lineBreak":true},{"text":"atushat batsamin aidautigmesh antuktajum,","poem":1},{"lineBreak":true},{"text":"atum maaniami tusajum uminkugmesh wainkajum nuniktatjume;","poem":1},{"lineBreak":true},{"text":"tuja maaniami tusajum","poem":1},{"lineBreak":true},{"text":"maanitai aidau umiakjumesh","poem":1},{"lineBreak":true},{"text":"ayatak sapigmaktatjume,","poem":1},{"lineBreak":true},{"text":"nuniakjum ijinam atatjume.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atum waji dutikatag tajume duka umiktajum;","poem":1},{"lineBreak":true},{"text":"tujash nunak Apajuí emegkaktatui;","poem":1},{"lineBreak":true},{"text":"tuja atum waji dutikatasajum","poem":1},{"lineBreak":true},{"text":"wakegagme dushakam chicham umiktajum,","poem":1},{"lineBreak":true},{"text":"dutikakjumesh makichkish umikchattagme,","poem":1},{"lineBreak":true},{"text":"wagki Apajuík jutijai pujawai.","poem":1},{"noteId":3}]},{"type":"heading","content":["Tuke Pujuuwai ishamainuk"]},{"type":"verse","number":11,"content":["Minak Tuke Pujuu niina uwejen senchi achijuk emetjua chichagtak: “Tikich Judá aents aidau takaina nuninuk amek takasaipa”, tusa tujutmayi. Nuna tujuti nuigtushkam chichagtak:"]},{"type":"verse","number":12,"content":["“Apajuín shiig umijin aina nunak pempeenkagtuki sujujatna nuninuk chichagmain ainatsui. Nuadui atum ishamkatnume tusa ishamainun chichaina duka makichkish ishamkaigpajum."]},{"type":"verse","number":13,"content":["Dekas Tuke Pujuu ashí senchigtina nunuwai, shiig pegkejam asamtai, ishamaku ajantusa diimaina duka."]},{"type":"verse","number":14,"content":["Atumin shiig pujutan sujamna duka Apajuíyai. Tujash Israel aents aidauk Judá wegantu aidaujai nuna dakitjaje. Nunidau asag Apajuí suwimak susam Jerusalégnumia aidauk kaya múun tukumaina numamtuk tukumkag iyaidaun nunú kaya tepegkam nantamainchau wajasag jiniagtinai."]},{"type":"verse","number":15,"content":["Kuashat aents atum ainajum anuiya kayan tukumak iyajag jinuidau agtinai. Tuja kuashat achija yajubaushkam agtinai.”"]},{"type":"heading","content":["Isaías niina jintintaiji aidaun anemtikak ujakbau"]},{"type":"verse","number":16,"content":[{"text":"Juju chicham Apajuínun wi etsejag nunú jintinkagtag nujai","poem":1},{"lineBreak":true},{"text":"ashí agagjum shiig ijiajum uuka ukuktajum.","poem":1},{"lineBreak":true},{"text":"Dutikajum tikich tsawantin jintinkagtuatatjum.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuke Pujuu Jacopan kajejuk uumjuku akuish,","poem":1},{"lineBreak":true},{"text":"wika ima niyaig kajintsan anentaimjai,","poem":1},{"lineBreak":true},{"text":"nuniakun ima niinak dakajai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mina daagnak, mina uchig aidaun","poem":1},{"lineBreak":true},{"text":"Apajuí sujusbau aina nuna daaji aidaujai","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtin muja Siógnum pujuuwa nunú","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun utugchatjin iwaintuktatus adaikamu ainaji.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja atumin chichagtamainak:","poem":1},{"lineBreak":true},{"text":"“Ashí aents aidauk dita apajuímtaiji aidaun","poem":1},{"lineBreak":true},{"text":"iniasag dekainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui atumshakam aents jakau aina nuna wakani,","poem":1},{"lineBreak":true},{"text":"tuja anentaimsa dekaji tinu aina","poem":1},{"lineBreak":true},{"text":"nujai iniasjum dekaatajum,","poem":1},{"lineBreak":true},{"text":"atakea duish waji utugchatak nagkaetamkiajat”, tusag tujabiagtatui.","poem":1},{"lineBreak":true},{"text":"Tujash atumek nuninuk antugkaigpa,","poem":1},{"lineBreak":true},{"text":"duka shiig wainkayai.","poem":1},{"lineBreak":true},{"text":"Atumek dekas Apajuí iniasjum dekaatajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tuja yumain atsutai,","poem":1},{"lineBreak":true},{"text":"tikich nugkanum yujasag waituinak","poem":1},{"lineBreak":true},{"text":"kajekag dita apujin, dita apajuímtaiji aidaujai","poem":1},{"lineBreak":true},{"text":"pegkegchaun chichajiagtinai,","poem":1},{"lineBreak":true},{"text":"nuninak ataktu yakí pagkaidiag niibiagtinai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Untsu nugká niimkama, ayatak waitut, suwe,","poem":1},{"lineBreak":true},{"text":"buutut, wake besemag ayaun wainkagtinai,","poem":1},{"lineBreak":true},{"text":"iman suwenum ditak pujusagtinai.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"-2 “Maher-salal-hasbaz” tawa juka hebreo chichamnumak, “Amujatkatnuk tsawantak ashí jegae” taku tawai.","reference":{"chapter":8,"verse":1}},{"noteId":2,"caller":"+","text":"“Jutijaig Apajuí pujawai” tawa duka hebreo chichamnumak “Emanuel” taku tawai.","reference":{"chapter":8,"verse":8}},{"noteId":3,"caller":"+","text":"Juka versículo 8num tawa nujai betekai.","reference":{"chapter":8,"verse":10}}]},"thisChapterLink":"/api/agr_wbt/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":20}