{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ISA","translationId":"agr_wbt","name":"Isaías","commonName":"Isaías","title":"Isaías","order":23,"numberOfChapters":34,"sha256":"71581a1d7cbf3b28b5a797f495d47f28072b2d876fbb6191d4426fb1ec79ac73","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/agr_wbt/ISA/66.json","totalNumberOfVerses":577},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Tujash imanik waituinak wake besemag","poem":1},{"lineBreak":true},{"text":"batsabiagtina duka tuke achatnai.","poem":1},"Agkan pujutan sukagtin akiina apu wajas inamjatin Tuja Sabulógka nugkeg Neftalí nugkejai mai Galileanum aents Apajuín nemagchau aidau batsata nuna ijus awai. Nunú nugkak, namak Jordágka amain nagkamnas nayantsanum jegaa nagkanui. Tuja yaunchuk nunú aidaun Apajuí suwimkan susa ijinauwai. Tujash duwi batsamas ataktu Apajuí anenken wainkau ainawai. Nunú nuniktinun Isaías pachis etsejak:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Aents aidau suwenum yujau agma nunú tsaaptinun wainkaje;","poem":1},{"lineBreak":true},{"text":"tuja suwenum batsatunashkam tsaaptin etsantug iyanjae.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apuh, aents aidauk kuashat uyugkaume,","poem":1},{"lineBreak":true},{"text":"tuja shiig aneamushkam múun awajsaume.","poem":1},{"lineBreak":true},{"text":"Nuadui ajak juwamunum shiig aneen aina numamtuk,","poem":1},{"lineBreak":true},{"text":"amina emtimin shiig aneasagtin ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja wiakuch wajiin akantuninak","poem":1},{"lineBreak":true},{"text":"shiig aneen aina numamtuk shiig aneasagtinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wagki aents aidau inaku waitkatai wajasag","poem":1},{"lineBreak":true},{"text":"waitu batsamaya duka ame agkanmitkaume.","poem":1},{"lineBreak":true},{"text":"Dutikakum Madián wegantu aidau tsaikuitam dutiksamek","poem":1},{"lineBreak":true},{"text":"yamaishkam ijina utsagkam agkanmitkaume.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja suntag aidau maaniatatus shimuinak","poem":1},{"lineBreak":true},{"text":"botasjin wakugtin aajabia duka,","poem":1},{"lineBreak":true},{"text":"jáanchji numpamkamu aidaujai jinum apeam utsankatnaitme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wagki iinak makichik uchi akiintugmae,","poem":1},{"lineBreak":true},{"text":"Apajuí iinak makichik uchin amase.","poem":1},{"lineBreak":true},{"text":"Nunú uchia nunuwai apu ati tusa etegkamua duka.","poem":1},{"lineBreak":true},{"text":"Nuadui niina daaji aidauk:","poem":1},{"lineBreak":true},{"text":"‘Shiig chichagkagtin’,","poem":1},{"lineBreak":true},{"text":"‘Apajuí senchigtin’,","poem":1},{"lineBreak":true},{"text":"‘Apajuí tuke Pujuu’,","poem":1},{"lineBreak":true},{"text":"‘Agkan pujutan apuji’ tutai atinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nunú uchik apu David inamaajakua nuwi pujus","poem":1},{"lineBreak":true},{"text":"ashí nugkanum inamjatnai.","poem":1},{"lineBreak":true},{"text":"Nuniau asamtai agkan pujuta duka tuke atinai.","poem":1},{"lineBreak":true},{"text":"Tuja nii inabaujig shiig emetjamu atinai,","poem":1},{"lineBreak":true},{"text":"nii inabaujinig shiig takamu, ajantunisa niiniamu atinai.","poem":1},{"lineBreak":true},{"text":"Nunak Tuke Pujuu ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"iina anempau asa dutikatnai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":7}