"lineBreak":true},{"text":"Tuke Pujuun emematin","poem":1},{"lineBreak":true},{"text":"aina nuna kantamjuattajai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Tuke Pujuuwah, Seír Edom nugkanum","poem":1},{"lineBreak":true},{"text":"aajakua nuwi ame kuitamkagtusamin","poem":1},{"lineBreak":true},{"text":"yujajin, nugka uugmayi,","poem":1},{"lineBreak":true},{"text":"tuja yumishkam senchi yutujabi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuu Israel aents","poem":1},{"lineBreak":true},{"text":"aidaun Apajuíji ememattayah,","poem":1},{"lineBreak":true},{"text":"ame wainmin muja aidau uujiagmayi.","poem":1},{"lineBreak":true},{"text":"Tuja muja Sinaíshkam","poem":1},{"lineBreak":true},{"text":"senchi uugkauwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Samgar Anatan uchiji","poem":1},{"lineBreak":true},{"text":"pujujakua nuaduik,","poem":1},{"lineBreak":true},{"text":"tuja Jael pujujakua duishkam,","poem":1},{"lineBreak":true},{"text":"jinta aidaunmak ishamain","poem":1},{"lineBreak":true},{"text":"wekaemainchau asamtai,","poem":1},{"lineBreak":true},{"text":"ditá shiwaaji aidau mantuawainum","poem":1},{"lineBreak":true},{"text":"tau asag, yaja menantag","poem":1},{"lineBreak":true},{"text":"jintachunum yujajaku ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nunidau asag Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"kanajag batsamas apugtuchu","poem":1},{"lineBreak":true},{"text":"kajimatkim batsatun,","poem":1},{"lineBreak":true},{"text":"wi Déboran ditá ayamjuktasan,","poem":1},{"lineBreak":true},{"text":"makichik nuwa uchijin ayamjuwama","poem":1},{"lineBreak":true},{"text":"numamtuk wejibiajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ashí Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"wainka apajuímtai aidaun","poem":1},{"lineBreak":true},{"text":"emematiagmayi, nuniau asamtai,","poem":1},{"lineBreak":true},{"text":"ame ditá maaniatnume tusam","poem":1},{"lineBreak":true},{"text":"dita shiwaaji aidau ishitkabiume.","poem":1},{"lineBreak":true},{"text":"Tujash ditak cuarenta mil suntag","poem":1},{"lineBreak":true},{"text":"nagkigtin, tantaajintin ainakush","poem":1},{"lineBreak":true},{"text":"sapigmaidau asag, maanimainji","poem":1},{"lineBreak":true},{"text":"atsugbau wajukmaina nuniagmayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"See tajame amina Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"tuja Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"apuji aina nunashkam","poem":1},{"lineBreak":true},{"text":"shiig anentuinajai,","poem":1},{"lineBreak":true},{"text":"wagki ujumak wajiu aina","poem":1},{"lineBreak":true},{"text":"nunú maaniawaju asagmatai.","poem":1},{"lineBreak":true},{"text":"¡Nuadui Tuke Pujuu ashí ememattajum!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atum wiakuch aidautijum","poem":1},{"lineBreak":true},{"text":"burro nuwa pujunum entsamka yujau aidautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja ujudauch dawenum yujau aidautigmesh,","poem":1},{"lineBreak":true},{"text":"Apajuí kantamjuatajum,","poem":1},{"lineBreak":true},{"text":"wagki nii depetmatan amasu asamtai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Tagku kuitamin aidautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja ujudauch yaaktanum","poem":1},{"lineBreak":true},{"text":"batsamchau aidautigmesh,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"ayamjuk agkanmitkau asamtai,","poem":1},{"lineBreak":true},{"text":"platillo aidau awatkujum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu kantamjuatajum!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“¡Débora mijaakaipa!","poem":1},{"lineBreak":true},{"text":"¡Wajiu wajasta!","poem":1},{"lineBreak":true},{"text":"¡Nuniakum kantamata!","poem":1},{"lineBreak":true},{"text":"¡Barac Abinoáma uchijiyah, ameshkam mijamtsuk,","poem":1},{"lineBreak":true},{"text":"aents maaniaku achigbau aidau","poem":1},{"lineBreak":true},{"text":"yajuakam chimpiata!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Tusa kantaman inagnai, Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"wi ipaamu asag, shiwag","poem":1},{"lineBreak":true},{"text":"maanitan yacha aidaujai,","poem":1},{"lineBreak":true},{"text":"maaniawagtatus shiyakajui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja Efraín wegantu ujumak aents","poem":1},{"lineBreak":true},{"text":"Amalec aents aidaun","poem":1},{"lineBreak":true},{"text":"nugkenia juwakiag akaejabi.","poem":1},{"lineBreak":true},{"text":"Untsu Benjamín wegantu aidau","poem":1},{"lineBreak":true},{"text":"nuna ukuujin shiyakagmayi.","poem":1},{"lineBreak":true},{"text":"Tuja Maquir wegantun-","poem":1},{"lineBreak":true},{"text":"mayashkam apu aidau shimutkabi.","poem":1},{"lineBreak":true},{"text":"Tuja Sabulón wegantu","poem":1},{"lineBreak":true},{"text":"aidaushkam apu aidau shimutkabi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuninai Déboranashkam","poem":1},{"lineBreak":true},{"text":"apu Isacar wegantu aidau uyuniagmayi.","poem":1},{"lineBreak":true},{"text":"Nuigtushkam Barakan","poem":1},{"lineBreak":true},{"text":"Isacar wegantu aidau uyuniagmayi.","poem":1},{"lineBreak":true},{"text":"Untsu Rubén wegantu aidauk","poem":1},{"lineBreak":true},{"text":"apu wajiu ainayatak,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ditá uwigji aidaun puyatjuinak","poem":1},{"lineBreak":true},{"text":"batsamas: ¿Maaniatjiash,","poem":1},{"lineBreak":true},{"text":"atsa maaniashtajiash? waja batsatui.","poem":1},{"lineBreak":true},{"text":"Rubén wegantu aidauk múun","poem":1},{"lineBreak":true},{"text":"ainayatak sapig ainawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja Galaad wegantu","poem":1},{"noteId":2},{"text":"aidauk","poem":1},{"lineBreak":true},{"text":"Jordágka amain yaaktamak batsamsaje.","poem":1},{"lineBreak":true},{"text":"Untsu Dan wegantu aidauk Asher wegantu aidaujai, nayantsa pakaji","poem":1},{"lineBreak":true},{"text":"wegajunum lanchagtin","poem":1},{"lineBreak":true},{"text":"waigkag batsamsaje.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Untsu Sabulón wegantu aidau, Neftalí wegantu aidaujai maaninak","poem":1},{"lineBreak":true},{"text":"ishamainnum yujasu ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Tuja Canaán nugkanmaya apu aidau","poem":1},{"lineBreak":true},{"text":"yaakat Meguidon ijus namak awa nuwi","poem":1},{"lineBreak":true},{"text":"yaakat Taanac kaunawajui,","poem":1},{"lineBreak":true},{"text":"nunikag nuwi maaniawajui,","poem":1},{"lineBreak":true},{"text":"tujash depetmakchajui.","poem":1},{"lineBreak":true},{"text":"Nunikaju asag makichik wajinakesh jutsuk waketkiajui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Israel aents aidau Sísarajai","poem":1},{"lineBreak":true},{"text":"maaninakug, yaya nayaimpinum","poem":1},{"lineBreak":true},{"text":"ayá nujai ijunjas maaninatai","poem":1},{"lineBreak":true},{"text":"tumainun maaniawagmayi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Iina shiwaaji aidau","poem":1},{"lineBreak":true},{"text":"entsa Quisónkan","poem":1},{"lineBreak":true},{"text":"katitkatag titatman,","poem":1},{"lineBreak":true},{"text":"yumi yutug dujajak tajaka utsagke.","poem":1},{"lineBreak":true},{"text":"¡Ame shiwag senchigtin","poem":1},{"lineBreak":true},{"text":"aidau depetkam, iikmak","poem":1},{"lineBreak":true},{"text":"chichakchamin awajsattame!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Caballo aidau ishamkagtukag","poem":1},{"lineBreak":true},{"text":"shiig senchi pisainak","poem":1},{"lineBreak":true},{"text":"tutugtau antuewai!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Apajuí ángeltsukaita","poem":1},{"lineBreak":true},{"text":"tumain chichaman etsejak:","poem":1},{"lineBreak":true},{"text":"‘¡Yaakat Meroznum","poem":1},{"lineBreak":true},{"text":"aents batsata nuwi","poem":1},{"lineBreak":true},{"text":"suwimak iyagti tajai!’ tiuwai.","poem":1},{"lineBreak":true},{"text":"Nunak tiuwai wagki dita","poem":1},{"lineBreak":true},{"text":"aidauk wajiu ainayatak,","poem":1},{"lineBreak":true},{"text":"Israel aents aidau","poem":1},{"lineBreak":true},{"text":"maaniagtai yaigchaju asagmatai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“¡Heberan nuwe Jael","poem":1},{"lineBreak":true},{"text":"quenita nuwa duka,","poem":1},{"lineBreak":true},{"text":"tikich nuwa Israel aents aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau pegkegnum","poem":1},{"lineBreak":true},{"text":"chichagtai atinai!","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam nii pujamunum","poem":1},{"lineBreak":true},{"text":"nuwa aidau pujuina nuna nagkaesau","poem":1},{"lineBreak":true},{"text":"shiig anentam atinai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sísara kitamak yumi segam,","poem":1},{"lineBreak":true},{"text":"Jael lechen juki susauwai.","poem":1},{"lineBreak":true},{"text":"¡Leche kanteku shiig pegkejan pinignum yajaa juki susauwai!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dutikam nuna uwag kanag tepesmatai,","poem":1},{"lineBreak":true},{"text":"numi etsakamun juki","poem":1},{"lineBreak":true},{"text":"martillowai kajashkinum iju","poem":1},{"lineBreak":true},{"text":"nugkajai ijumag achia maabi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dutika ijum tadae tadaekawa","poem":1},{"lineBreak":true},{"text":"nuwig jaka tepesmayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Tuja Sísara dukujig","poem":1},{"lineBreak":true},{"text":"uchiji megkaekamtai","poem":1},{"lineBreak":true},{"text":"puyatki, jeganum niimtai ujaimunum tsapui","poem":1},{"lineBreak":true},{"text":"niimas atsutai chichaak:","poem":1},{"lineBreak":true},{"text":"‘¿Wagka mina uchijush","poem":1},{"lineBreak":true},{"text":"imanikash megkaekae?","poem":1},{"lineBreak":true},{"text":"¿Wagka mina uchiju","poem":1},{"lineBreak":true},{"text":"carroji maanitai agma","poem":1},{"lineBreak":true},{"text":"dusha megkaejae?’ timayi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tuja niina inake nuwa yacha aidau chichagtai,","poem":1},{"lineBreak":true},{"text":"Sísara dukujishkam dutiksag chichaak:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‘Maaniawag depetmakajas,","poem":1},{"lineBreak":true},{"text":"nuwa inak aidau achigbaun, suntag aidau maki","poem":1},{"lineBreak":true},{"text":"makichik, atsa nuniachkush","poem":1},{"lineBreak":true},{"text":"jimagnakesh akantunikag","poem":1},{"lineBreak":true},{"text":"yajumainak megkaejatai.","poem":1},{"lineBreak":true},{"text":"Tuja Sísaranun jáanch","poem":1},{"lineBreak":true},{"text":"pegkeg agatkamu aidaun: makichik jáanchin,","poem":1},{"lineBreak":true},{"text":"tuja nuigtu jimag jáanch agatka apijamu","poem":1},{"lineBreak":true},{"text":"aents depetmakun","poem":1},{"lineBreak":true},{"text":"kuntujen anugtai aidaun","poem":1},{"lineBreak":true},{"text":"aatus yajumainakus batsatatai’, tuidau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina shiwaajum aina","poem":1},{"lineBreak":true},{"text":"duka ame ashí ijinata.","poem":1},{"lineBreak":true},{"text":"¡Untsu amina anempaina duka etsa tajiag","poem":1},{"lineBreak":true},{"text":"etsantama iman atinme!” aatus tusa Débora","poem":1},{"lineBreak":true},{"text":"Baracjai kantama inagnakui.","poem":1},{"lineBreak":true},"Nuna maaniau aina duwi nagkamas cuarenta mijan maanitsuk batsamsau ainawai."]}],"footnotes":[{"noteId":2,"caller":"+","text":"“Galaad wegantu” tawa nunak “Rubén, Gad, Manasés wegantu jimaituk aajakua” nuna taku tawai.","reference":{"chapter":5,"verse":17}}]},"thisChapterLink":"/api/agr_wbt/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}