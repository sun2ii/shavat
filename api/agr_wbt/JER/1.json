{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":1,"content":[{"type":"heading","content":["Yama nagkamchaku agagbau"]},{"type":"verse","number":1,"content":["Profeta Jeremías Hilquíasa uchiji sacerdote wegantu, Benjamígka nugken yaakat Anatot pujujakua nuna, Tuke Pujuu chicham etsegtugkata tusa ausauwai."]},{"type":"verse","number":2,"content":["Tuke Pujuu Jeremíasan ausauwa nunak, Amónka uchiji Josías Judá apuji wajas trece mijan inamai, chichaman ujakui."]},{"type":"verse","number":3,"content":["Tuja nuigtushkam Josíasa uchiji Joaquim Judá wegantu aidaun apuji aajakua duishkam Apajuík Jeremíasnak ausauwai. Tuja Josíasa uchiji tikich Sedequías Judá apuji wajasa inabaujin nantu Julion achiak, once mijanan ejeyuwa nunak, Apajuík Jeremíasjaig kuashta chichasui. Nunú tsawantin Jerusalégkan jetekag depetuk, Israel aents aidaun achijag yajuakajui."]},{"type":"heading","content":["Apajuí Jeremíasan mina takagtusta tusa inagbau"]},{"type":"verse","number":4,"content":["Tuke Pujuu mina chichagtak:"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wi aminak eke akiintsuminig,","poem":1},{"lineBreak":true},{"text":"mina chichamjun ashí nugkanum etsegtugkati tusan etegkauwaitjame”,","poem":1},{"lineBreak":true},{"text":"tujutmayi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tusa tujutkui wi ayaakun:","poem":1},{"lineBreak":true},{"text":"“Chah, apu Tuke Pujuuwah, wika tsakataitag nuniau asan","poem":1},{"lineBreak":true},{"text":"jintiaja chichatnak dekatsjai”, tibaijai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tusa tai nii chichagtak:","poem":1},{"lineBreak":true},{"text":"“Tsakataitjai tusamek tiipa.","poem":1},{"lineBreak":true},{"text":"Wi amina tuwi awemattagme nuwi amek wetatme,","poem":1},{"lineBreak":true},{"text":"nunikam wi titatjam nunú etsegkattame.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Makichkish ishamkagtukaipa","poem":1},{"lineBreak":true},{"text":"wi aminak kuitamkattagme,","poem":1},{"lineBreak":true},{"text":"wi nunak dekas umiktinjun tajai”, tujutmayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Nuna tusa Tuke Pujuu wenujun achigtuk chichagtak:"]},{"type":"verse","number":10,"content":[{"text":"“Antukta nijah, aminak yamai nagkamas","poem":1},{"lineBreak":true},{"text":"aents nugka muunnumia aidaush,","poem":1},{"lineBreak":true},{"text":"nuna apuji aidaush antugtamkagtinun, tuja tsaiktinun,","poem":1},{"lineBreak":true},{"text":"ijinatnun, tsaikbau ataktu yaaktamkatnun","poem":1},{"lineBreak":true},{"text":"ajakmatnum senchimtikajame”, tujutmayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Nuna tusa chichagtak: “¿Jusha wajimpaya?” tujutmayi. Tujutkui wi ayaakun: “Anka almendro kanawegai”, tibaijai. Tusa tai Tuke Pujuu aijak:"]},{"type":"verse","number":12,"content":["“Dekas tame, wika mina chichameg uminkati tusan antaku pujuttajai”, tujutmayi."]},{"type":"verse","number":13,"content":["Nuna tujuti ataktu chichagtak: “¿Jusha wajimpaya?” tujutkui wi ayaakun: “Ichinak ekenkamu kuwaak nujinmanini yantak ukagattak eketui”, tibaijai."]},{"type":"verse","number":14,"content":["Tusa tai Tuke Pujuu chichagtak:",{"lineBreak":true},{"text":"“Nujinmaya juwaki tsumujiya aatus aents","poem":1},{"lineBreak":true},{"text":"batsata nunak suwimkan susattajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dutikakun aents nugka muunnumia","poem":1},{"lineBreak":true},{"text":"nujinum batsata nunak ashí untsuktatjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai nuna apuji aidau kaunawag","poem":1},{"lineBreak":true},{"text":"Jerusalégnum waitaiya nuwi kaunawag,","poem":1},{"lineBreak":true},{"text":"yaakat peejamua nuna tenteawag batsamtusag,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaun jeteka depetuk","poem":1},{"lineBreak":true},{"text":"achija yajuakagtatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuni suwimkan susattajai,","poem":1},{"lineBreak":true},{"text":"aents aidau mina umigtutsuk wainka apajuímtain","poem":1},{"lineBreak":true},{"text":"tikich aents aidau emematin aina","poem":1},{"lineBreak":true},{"text":"nuna dakumak najanawag, nuna emematuinak","poem":1},{"lineBreak":true},{"text":"kugkuin incienson apenau asagmatai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Untsu amek umintsata;","poem":1},{"lineBreak":true},{"text":"nunika weme wi amina titatjam nunú ashí etsegkata.","poem":1},{"lineBreak":true},{"text":"¡Wainka ishamkagtukaipa!","poem":1},{"lineBreak":true},{"text":"Ishamkagtakminig shiwagjai igkuniak","poem":1},{"lineBreak":true},{"text":"sapijin kujaiti titatjame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi aminak yaakat peejamu utumainchawa iman,","poem":1},{"lineBreak":true},{"text":"jiju hierro ajiamu kupinchauwa iman,","poem":1},{"lineBreak":true},{"text":"tuja yaakat broncejai peejamu tsaika","poem":1},{"lineBreak":true},{"text":"utumainchawa iman awajsajame.","poem":1},{"lineBreak":true},{"text":"Judá wegantu aina nuna nugkenig,","poem":1},{"lineBreak":true},{"text":"tuja dita apuji aina nujaishkam,","poem":1},{"lineBreak":true},{"text":"sacerdote aina nujai nagkamas","poem":1},{"lineBreak":true},{"text":"ashí aents aina nuna chichagkati tusan","poem":1},{"lineBreak":true},{"text":"senchimtikajame.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Jetepakagtatui, tujash depetamkachagtinai,","poem":1},{"lineBreak":true},{"text":"wagki wi amina kuitamkatasan,","poem":1},{"lineBreak":true},{"text":"amejai pujau asamtai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuu ashí senchigtinnuk,","poem":1},{"lineBreak":true},{"text":"junak dekas uminkatnun tajai”, tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/ISA/66.json","previousChapterAudioLinks":{},"numberOfVerses":19}