{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":14,"content":[{"type":"heading","content":["Kuashat tsawantai yumi yutugchamu"]},{"type":"verse","number":1,"content":["Yumi yututsuk kuashat tsawan au asamtai, Tuke Pujuu Jeremíasan chichajak:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Judá wegantu aidauk wake besemag dekapenak buutuinawai,","poem":1},{"lineBreak":true},{"text":"dita yaaktaji aidaunmash","poem":1},{"lineBreak":true},{"text":"waji sujutaiji aidauk atsujuinawai.","poem":1},{"lineBreak":true},{"text":"Ashí aents aidauk nugká batsatui,","poem":1},{"lineBreak":true},{"text":"tuja Jerusalégnumak senchi buutuinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wiakuch aidauk dita inake aidaun yumi","poem":1},{"lineBreak":true},{"text":"egaktajum tusa ishimainawai,","poem":1},{"lineBreak":true},{"text":"tusa tima yumi aimtainum shiyakag egainawai,","poem":1},{"lineBreak":true},{"text":"tujash yumik atsawai.","poem":1},{"lineBreak":true},{"text":"Nunitai yumi shikitainak wainak takus yuja yujakua waketuinak,","poem":1},{"lineBreak":true},{"text":"puyatkiag datsantin buuken dukumakag waketuinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tagkugtin aidauk yumi yutachu asamtai,","poem":1},{"lineBreak":true},{"text":"nugka buku wajasmatai,","poem":1},{"lineBreak":true},{"text":"senchi puyatuinak buuken dukuinawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nugka buku wajasu asa chijichi jinaamtai,","poem":1},{"lineBreak":true},{"text":"japa aidauk yumainji atsujam,","poem":1},{"lineBreak":true},{"text":"uchiji yama petsakbaunak ukukiag yaja shimuinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ikamia burro unuinakchamu aidauk","poem":1},{"lineBreak":true},{"text":"chijichi yumain atsutai,","poem":1},{"lineBreak":true},{"text":"nain uwegshunum ijunas nujantai jinuinak,","poem":1},{"lineBreak":true},{"text":"ikamia yawajai betek","poem":1},{"lineBreak":true},{"text":"dase dasentai mejea mejea mejea wajainawai,","poem":1},{"lineBreak":true},{"text":"imaaninak jaka iyainawai”, tiuwai.","poem":1}]},{"type":"heading","content":["Profeta Jeremías Apajuí segamu"]},{"type":"verse","number":7,"content":[{"text":"Jeremías Apajuín segaak:","poem":1},{"lineBreak":true},{"text":"“Tuke Pujuuwah, iik dekas ame umigtsuk","poem":1},{"lineBreak":true},{"text":"amina emtimin shiig kuashat pegkegchau takamsaji.","poem":1},{"lineBreak":true},{"text":"¡Tujash wait aneasam ame tuke pujuuwaitam","poem":1},{"lineBreak":true},{"text":"nunú anentaimsam yaijatkata!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Ametme Israel aents aidau uwemtiknumek,","poem":1},{"lineBreak":true},{"text":"ametme tsawan utugchat akuish ayamkagtukam","poem":1},{"lineBreak":true},{"text":"uwemtikagtinmek!","poem":1},{"lineBreak":true},{"text":"Imanaitkumesh, ¿wagka aents tikich nugkanmaya ijaak tau asa,","poem":1},{"lineBreak":true},{"text":"ayatak diijatus kanag tsawak wegama","poem":1},{"lineBreak":true},{"text":"numamtukesh awajkagtame?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidau Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"ashí aents aidauk dekainawai amina aentsjum ainag nunak,","poem":1},{"lineBreak":true},{"text":"tuja amek jutijai pujame.","poem":1},{"lineBreak":true},{"text":"¡Kajimatkimek idaikagtusaipa!","poem":1},{"lineBreak":true},{"text":"Aents kakakchau maanitan yachachu","poem":1},{"lineBreak":true},{"text":"ayamkagtumainchauwa nunin wajasume”, tiuwai.","poem":1}]},{"type":"verse","number":10,"content":["Tuke Pujuu aents aidaun chichajak:",{"text":"“Atumek wainka apajuímtai aidau","poem":1},{"lineBreak":true},{"text":"ememattasajum ima senchi wakegagme,","poem":1},{"lineBreak":true},{"text":"nuniau asajum wainka yujagme,","poem":1},{"lineBreak":true},{"text":"anka minak shiig awajtatsui,","poem":1},{"lineBreak":true},{"text":"nuadui wi atumnak suwimkan amastatjime”,","poem":1},{"lineBreak":true},{"text":"tujamui.","poem":1}]},{"type":"verse","number":11,"content":["Nuna tusa Tuke Pujuu mina chichagtak: “Jeremíasah, anú aents aina nuna yaigti tusam segatkumek waitkagsaipa."]},{"type":"verse","number":12,"content":["Yujumak ijagma pujusam segatkuminish, wika antugkashtatjame; kuntin aidau, trigo, cebada aidau kuashat anentag sujakjuminish, wika jujukchattajime. Wika atumnak maaniamunum, nujantai, jatai ijinattajime”, tujutmayi Apajuí."]},{"type":"verse","number":13,"content":["Tujutkui wi ayaakun: “Tujash apu Tuke Pujuuwah, tikich profeta aidau aents aidaun chichajuinak, maaniamuk atsuttawai, tuja nujanchakam tepeashtatui tusa, amina au nii shiig utugchat atsaunum batsamsatnume tusa yaimpaktatui tuinawai”, tibaijai."]},{"type":"verse","number":14,"content":["Tusa tai Tuke Pujuu aijak: “Nunú profeta aidau mina daajun pachis tuina nunak waitjuinak tuinawai. Wika ditanak, atum wejum chicham etsegkatajum tusanuk makichkish inatsjai. Nuigtush wika ditanak aujuinatsjai. Nunak ditak anentaimas waitjuinak tuinawai."]},{"type":"verse","number":15,"content":["Nunú profeta aidau wi akatja awemachmaitak mina pachitus, auk maaniamuk atsuttawai, tuja nujanchakam juju nugkanmak tepeashtatui tuu yuja duka nujantai, puyajai jinawagtatui."]},{"type":"verse","number":16,"content":["Tuja tikich aents aidaun dita ujaina dushakam nunisag nuwe aidau, nawanji aidau, uchiji aidau aatus ashí nujantai, puyajai jinawagtatui. Nunik jinawagmatai, dita iyashi aidauk Jerusalén jinta ayá nuwi tepetag waigtatui, wagki ditan ukumainuk atsau asamtai. Nuni akikmakagtatui dita pegkegchau takamsamujinak."]},{"type":"verse","number":17,"content":["“Nuniktin asamtai juju aatsam aents aidau ujakta:",{"lineBreak":true},{"text":"“ ‘¡Mina aentsug aidau utugchat ishamainun","poem":1},{"lineBreak":true},{"text":"igkugkaju asamtai, nuna anentaimtusan tsawaish,","poem":1},{"lineBreak":true},{"text":"kashish mijamtsuk tuke buut pujuttajai!","poem":1},{"lineBreak":true},{"text":"Dita utugchatjiya duka tsupimakbaujai betek najamawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jiinkin ajanum wekaman,","poem":1},{"lineBreak":true},{"text":"aents aidau puyajai kajegkam batsatun wainjai,","poem":1},{"lineBreak":true},{"text":"tuja yaaktanum waikmanchakam,","poem":1},{"lineBreak":true},{"text":"nujantai jinuidaun wainjai.","poem":1},{"lineBreak":true},{"text":"Imanitaish profetakesh, sacerdotekesh,","poem":1},{"lineBreak":true},{"text":"wagkag imaniawa nunak puyatjutsuk","poem":1},{"lineBreak":true},{"text":"wainak tikich nugkanum yujawai’, tujutmayi.”","poem":1}]},{"type":"heading","content":["Profeta Jeremías Apajuín aikbau"]},{"type":"verse","number":19,"content":["Jeremías Apajuín ayaak:",{"lineBreak":true},{"text":"“Apuh, ¿Judá wegantu aidauk tuke idaikumek idaisaum?","poem":1},{"lineBreak":true},{"text":"¿Yaakat Jerusalégkak yawetjamek idaisaum?","poem":1},{"lineBreak":true},{"text":"¿Wagka waji jataitkuish ampimakuish,","poem":1},{"lineBreak":true},{"text":"tsagaumainchaush ekagtiume?","poem":1},{"lineBreak":true},{"text":"Pegkejap batsamsattaji tibaiji,","poem":1},{"lineBreak":true},{"text":"tujash pegkegchau iyanjamamtai, kuashat waituinaji.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"iina pegkegchaujiya duka dekagmamji,","poem":1},{"lineBreak":true},{"text":"tuja iina apachji pegkegchaun takasu aina","poem":1},{"lineBreak":true},{"text":"dushakam dekaji.","poem":1},{"lineBreak":true},{"text":"Iik dekas ame pegkegchau takagku tunamagji.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Amek betek uminaitam iman asam,","poem":1},{"lineBreak":true},{"text":"antugkagtuskek idaikagtusaipa,","poem":1},{"lineBreak":true},{"text":"tuja amina pujutaijum jega pegkegma nunú tsaikaipa!","poem":1},{"lineBreak":true},{"text":"Duka dutiktsuk ame jutijai chicham umikuitam nunú","poem":1},{"lineBreak":true},{"text":"adeagta nunikam betek umikta.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, iina Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"dakumkamu apajuímtai aina duka","poem":1},{"lineBreak":true},{"text":"yuminak makichkish yutumtikmaitsui,","poem":1},{"lineBreak":true},{"text":"ametme yumi nayaimpinmaya yutumtiknumek,","poem":1},{"lineBreak":true},{"text":"ametme ashí najankaumek.","poem":1},{"lineBreak":true},{"text":"¡Nuadui ima aminig kajintsa anentaimji!” tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}