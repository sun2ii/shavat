{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":15,"content":[{"type":"heading","content":["Suwimak atin etsegkamu"]},{"type":"verse","number":1,"content":["Tuke Pujuu chichagtak: “Juju aents aina nunú wait anenjata tusa Moisés, Samueljai segatainakuish, wika juju aents aina nunak wait anenmaitsujai. Jiinag shiyaktinme tujamui tusam ujakta, dutikam jiinag shiyaktinme."]},{"type":"verse","number":2,"content":["Tuja tuwi shiyaktatji tusa inimpainakuig ame ayaakum:",{"lineBreak":true},{"text":"“ ‘Nii jatai jakati tibauk nunisag jakati;","poem":1},{"lineBreak":true},{"text":"tuja nii maaniamunum jakatnuk nunisag","poem":1},{"lineBreak":true},{"text":"maaniamunum jakati;","poem":1},{"lineBreak":true},{"text":"untsu nujantai jakatnuk dushakam nunisag","poem":1},{"lineBreak":true},{"text":"nujantai jakati;","poem":1},{"lineBreak":true},{"text":"tuja achija yajuakam yujas waittsatnuk","poem":1},{"lineBreak":true},{"text":"nunisag waittsatnume’.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["“Wi ditanak ipak usumta imajin suwimkan ishitkattajai. Tuja duka juju ainawai: Maaniamunum jinawagtinai, nunikmatai yawá aidau esainiag japisa yujagtatui, chuwag amukagtinai, dutikawagmatai kuntin kajen aidau, shiig amutan amukagtinai."]},{"type":"verse","number":4,"content":["Nunak Ezequíasa uchiji Manasésa pegkegchaujin dutikattajai. Wika nunú Judá apuji wajas pujusa Jerusalégnum wajina dutikauwaita nunak kajimattsujai. Nuna antukag nugka múun aidaun apuji aidau senchi ishamkagtatui. Nunak dekas nuniktinun tajai."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“¿Jerusalégkah, aminash yaki wait anenjamjainta?","poem":1},{"lineBreak":true},{"text":"¿Yaki amina anempakush buutti?","poem":1},{"lineBreak":true},{"text":"¿Yaki aminash jamamtuchu pujusti","poem":1},{"lineBreak":true},{"text":"tusash puyatjutpakti?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atumek mina idaitusjum pegkegchau takagtusugme.","poem":1},{"lineBreak":true},{"text":"Nuniakjuminish wait anentau asan","poem":1},{"lineBreak":true},{"text":"tsawanta ewae ewaekawan yawegjai,","poem":1},{"lineBreak":true},{"text":"nuniku asan yamaik ijinattajime.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jerusalégkah, aminí aents batsata nunak","poem":1},{"lineBreak":true},{"text":"chijichin dase umpui utsauwama numamtuk","poem":1},{"lineBreak":true},{"text":"yaakta ukumtikin utsagtatjai.","poem":1},{"lineBreak":true},{"text":"Mina aentsug aidauk mina umigtukchaju asag","poem":1},{"lineBreak":true},{"text":"uchigtuchu juwakaje.","poem":1},{"lineBreak":true},{"text":"Wi ditanak mina umigtukchaju asagmatai ijinawagjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dutika ai nayantsa kamatkaji kuashta nuna nagkagas","poem":1},{"lineBreak":true},{"text":"nuwa aidauk shiig kuashat wajemeakagtinai.","poem":1},{"lineBreak":true},{"text":"¡Etsash etsantaig nuwa aidaunak","poem":1},{"lineBreak":true},{"text":"dita uchiji datsa aidaujai ijinattajai!","poem":1},{"lineBreak":true},{"text":"Makichkish nuniktatuapi tachamunum","poem":1},{"lineBreak":true},{"text":"pachiachbau ishamainun ajunjagtatjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuwa kuashat uchigtin aidauk wampainag","poem":1},{"lineBreak":true},{"text":"iyajag nunisag jagtinai.","poem":1},{"lineBreak":true},{"text":"Nunikag datsan dushikiam agtinai,","poem":1},{"lineBreak":true},{"text":"Tuja etsa pegkeg etsantug au suwe wajastinai.","poem":1},{"lineBreak":true},{"text":"Makichik aentskesh iwaku pujaunak","poem":1},{"lineBreak":true},{"text":"tikich aents aidau maatnume tusan idaisattajai.","poem":1},{"lineBreak":true},{"text":"Nunak dekas nuniktinun tajai”, tiuwai Tuke Pujuu.","poem":1}]},{"type":"heading","content":["Profeta Jeremías buutbau"]},{"type":"verse","number":10,"content":[{"text":"“¡Chah, dukuwa wika senchi anentaimkun waitiajai!","poem":1},{"lineBreak":true},{"text":"¡Wika akiinmainchaunas akiinawamiagtai!","poem":1},{"lineBreak":true},{"text":"Wika makichik aentsnakesh pegkegchauk awagmachuitjai,","poem":1},{"lineBreak":true},{"text":"tujash minak ashí pegkegchaun chichagtuinawai,","poem":1},{"lineBreak":true},{"text":"dutijuinak shiwagmatuinakui ditajai maaniajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wi ame inatjamun umikchau ataik,","poem":1},{"lineBreak":true},{"text":"tuja dita pachisnush amijai chichaschau ataik,","poem":1},{"lineBreak":true},{"text":"dita tujutuina duka betek uminkati.","poem":1},{"lineBreak":true},{"text":"¡Tujash mina shiwag aidau waituinakui,","poem":1},{"lineBreak":true},{"text":"nuna yaigti tusan","poem":1},{"lineBreak":true},{"text":"wi amina segajam duka amek dekame!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuke Pujuu aents aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"Suntag asirianmaya, babilonianmaya aina nuna","poem":1},{"lineBreak":true},{"text":"depetmainuk atsawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Israel aents aidautigmek ashí tunamakugme,","poem":1},{"lineBreak":true},{"text":"nuniku asagmin atumi tagkujum aidau, wajijum","poem":1},{"lineBreak":true},{"text":"aidau, tuja atumi nugkemin ayá nunashkam","poem":1},{"lineBreak":true},{"text":"atumi shiwajumin ashí susattajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wika shiig senchi kajekjai,","poem":1},{"lineBreak":true},{"text":"nuniku asan, jiijai betek apeattajime.","poem":1},{"lineBreak":true},{"text":"Atumi shiwaajum aidau achipag tikich nugka atumi wainchataijin yajupakag,","poem":1},{"lineBreak":true},{"text":"dita inainak waitkastinme tusan idaisattajime”,","poem":1},{"lineBreak":true},{"text":"tiuwai Tuke Pujuu.","poem":1}]},{"type":"heading","content":["Jeremías Apajuín ausamu"]},{"type":"verse","number":15,"content":["Jeremías Tuke Pujuun aujak:",{"lineBreak":true},{"text":"“Tuke Pujuuwah, amek ashí dekame,","poem":1},{"lineBreak":true},{"text":"wika amina takaju asan maatag tama ajai,","poem":1},{"lineBreak":true},{"text":"minash kajimatjutsuk yainkata.","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuuwah, mina mantuatag tuina duka","poem":1},{"lineBreak":true},{"text":"ayatak dii pujugtsuk eke mina mantuinatsaig,","poem":1},{"lineBreak":true},{"text":"suwimak susam ijinata!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"ame mina aujtuyum nunak","poem":1},{"lineBreak":true},{"text":"wika puyatjusan antuyajai.","poem":1},{"lineBreak":true},{"text":"¡Wika aminuitag duwi","poem":1},{"lineBreak":true},{"text":"amina chichamjumin antakun shiig aneyajai!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wika aents pegkegchau takatnak yujajin aina","poem":1},{"lineBreak":true},{"text":"nujai ijunja wekaetanak idaisajai.","poem":1},{"lineBreak":true},{"text":"Aminu etiuwaitam duwi nagkamsan wika wiki pujajai,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchau takat ame kajejam nunak","poem":1},{"lineBreak":true},{"text":"wishakam kajejajai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Wagka tujash imaniknush waitush pujaja?","poem":1},{"lineBreak":true},{"text":"¿Wagka wi imanikan waitiag dusha","poem":1},{"lineBreak":true},{"text":"megkaemainchauwaita?","poem":1},{"lineBreak":true},{"text":"Niimpap yainkattawa timajai, tujash idaitusume,","poem":1},{"lineBreak":true},{"text":"amek yumi pukuni jiinu kuyua","poem":1},{"lineBreak":true},{"text":"buku wegama numamtin wajasume”, tiabiajai.","poem":1}]},{"type":"heading","content":["Apajuí Jeremíasan aikbau"]},{"type":"verse","number":19,"content":["Tusa ti ai Tuke Pujuu aijak:",{"text":"“Nunú anin wainka tuu wekaetsuk,","poem":1},{"lineBreak":true},{"text":"awake anentaimjam minai minakminig,","poem":1},{"lineBreak":true},{"text":"mina chichamjun etsegtujin ati tusan yaigtatjame.","poem":1},{"lineBreak":true},{"text":"Dutika ai ame mina profetag atatme.","poem":1},{"lineBreak":true},{"text":"Amek ditaig waketmaitsume,","poem":1},{"lineBreak":true},{"text":"auk dita aminí minimain ainawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Juju aents aina nuna emtinig wi aminak","poem":1},{"lineBreak":true},{"text":"yaakat broncejai peejamua iman awajsattajame.","poem":1},{"lineBreak":true},{"text":"Amina shiwaajum aidau jetepainakush","poem":1},{"lineBreak":true},{"text":"depetamkachagtatui,","poem":1},{"lineBreak":true},{"text":"wi aminak ayamjukan uwemtijattagme.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas dutikatin asan tajai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidau mantamatag tuinakuish,","poem":1},{"lineBreak":true},{"text":"wi ayamjukan uwemtikjattagme;","poem":1},{"lineBreak":true},{"text":"tuja magkagtin aidau mantamatag tuinakuish,","poem":1},{"lineBreak":true},{"text":"wi uwemtikjattagme”, tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}