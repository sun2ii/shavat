{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel aents aidau pegkegchaun takainak Apajuíjai shiwagmagawagbau"]},{"type":"verse","number":1,"content":["Tuke Pujuu mina chichagtak:"]},{"type":"verse","number":2,"content":["“Jerusalén wetá, nunikam ashí aents aidau senchi untsumka chichagkum aatus Tuke Pujuu tawai tita:",{"text":"“ ‘Ame tsakat asam ima minak umigtin ayum nuna aneakjai.","poem":1},{"lineBreak":true},{"text":"Tuja yama nuwatkamu aishin aneemaina","poem":1},{"lineBreak":true},{"text":"imatikam anentiume, nuniau asam","poem":1},{"lineBreak":true},{"text":"uwejush ajakmamash tsapamainchaunum","poem":1},{"lineBreak":true},{"text":"juki emaish pataetugsam miniyume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israel aents aidauk midau agtin etegkamu ayi,","poem":1},{"lineBreak":true},{"text":"ditak ajak ajakmamu yama nagkamchak","poem":1},{"lineBreak":true},{"text":"shiig pegkejan nejegama iman aajabi.","poem":1},{"lineBreak":true},{"text":"Tuja ditan waitkainakuig,","poem":1},{"lineBreak":true},{"text":"wi nunak suwimkan su ayajai.","poem":1},{"lineBreak":true},{"text":"Nunak dekas dutikamujun’, tajai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["¡Israel aents aidauwah, Apajuí chichame antuktajum!"]},{"type":"verse","number":5,"content":["Tuke Pujuu chichagtamak:",{"lineBreak":true},{"text":"“Atumi apachjum aajaku aina dusha","poem":1},{"lineBreak":true},{"text":"¿waji utugchatan waitjukajaya minash","poem":1},{"lineBreak":true},{"text":"tupanjujush ainawa?","poem":1},{"lineBreak":true},{"text":"Dakumka najanamu pegkegchaun emematu yujau asag,","poem":1},{"lineBreak":true},{"text":"ditashkam nuninuk wajasajui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nunidau asag, dita apachji aidau","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum batsatun jiija yajuakan,","poem":1},{"lineBreak":true},{"text":"uwejush yumi atsau, muja yumpunjau aidau,","poem":1},{"lineBreak":true},{"text":"ishamain aents aidaush pujumainchau,","poem":1},{"lineBreak":true},{"text":"makichkish nagkaemamainchau","poem":1},{"lineBreak":true},{"text":"ishamain wegajunum wi kuitamsan","poem":1},{"lineBreak":true},{"text":"emauwaitag nunak aneetsuk pachitkachajui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi atumnak juju nugka pegkeja juwi","poem":1},{"lineBreak":true},{"text":"ajakmawag yuwatnume tusan ikaunmawaitjime.","poem":1},{"lineBreak":true},{"text":"Tujash atum kaunajum mina nugkag pegkeg ayá nunú emesjauwaitjume.","poem":1},{"lineBreak":true},{"text":"Nuadui mina nugkag pegkeg ayá duka tsumain awajsaugme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sacerdote aidaush mina pachittsag inimsachu ainawai;","poem":1},{"lineBreak":true},{"text":"tuja mina chichamjun jintinkagtin aidaush","poem":1},{"lineBreak":true},{"text":"makichkish waitkachaju ainawai,","poem":1},{"lineBreak":true},{"text":"apu aidaush pegkegchaun takamjuttsau ainawai,","poem":1},{"lineBreak":true},{"text":"tuja mina profetag aidaushkam","poem":1},{"lineBreak":true},{"text":"Baalan etsegtuinak, mina chichamjunak","poem":1},{"lineBreak":true},{"text":"etsegkachu ainawai.","poem":1},{"lineBreak":true},{"text":"Nunidau asag dakumka najanamu aidaun","poem":1},{"lineBreak":true},{"text":"wainak emematujaku ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuadui atumnak, atumi uchijum aidaun,","poem":1},{"lineBreak":true},{"text":"tijajum aidaujaí suwimkan jukitnume tusan umigkattajime.","poem":1},{"lineBreak":true},{"text":"Nunak wi Tuke Pujuun dekas umiktinjun tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Etsa akaetaiya nuni nayantsa ajuntaijin","poem":1},{"lineBreak":true},{"text":"yaakat ayá nuwi wetajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum Quedar nugkanum aents awematajum.","poem":1},{"lineBreak":true},{"text":"Dutikajum inimsatajum","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"tikich aents dakumka najanamun emematin aina dusha,","poem":1},{"lineBreak":true},{"text":"atum wajukeajum ankampash","poem":1},{"lineBreak":true},{"text":"nuna idayinak, tikichin nemaju yujau aina.","poem":1},{"lineBreak":true},{"text":"Nunú aents aidauk wainka apajuímtai dakumka","poem":1},{"lineBreak":true},{"text":"najanamun pegkegchaun emematin ainayatkush,","poem":1},{"lineBreak":true},{"text":"yapa yapajiakuag wechau ainawai.","poem":1},{"lineBreak":true},{"text":"Tujash mina aentsug aina duka dakumka","poem":1},{"lineBreak":true},{"text":"najanamu aidaun yujajak, dekas wi","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu senchigtinaitag nunak idaitusaje.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nugka múunta duka nuna antuk","poem":1},{"lineBreak":true},{"text":"puyatuk ishamak senchi kujawai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk. Nunak dekas tajai” tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Mina aentsug aidauk jimajan tudaun takamsaje:","poem":1},{"lineBreak":true},{"text":"Yumi pukuni pujutan sukagtina duka witjai,","poem":1},{"lineBreak":true},{"text":"nuniaig mina kajimatjukiag idaitusaje.","poem":1},{"lineBreak":true},{"text":"Nuninak yumi aimtain chigkaejaun tikichin umikaje.”","poem":1}]},{"type":"heading","content":["Israel aents aidauApajuín umigkachaju asagsuwimka jukiag waittsagbau"]},{"type":"verse","number":14,"content":[{"text":"“Israel aents aidauk wainka inaku waitkataig ainatsui,","poem":1},{"lineBreak":true},{"text":"Israel aents aidauk inaku waitkatai atinuk akiinachajui.","poem":1},{"lineBreak":true},{"text":"Tujash ¿wagka imatika waitkamash ainawa?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¿Wagka imatikash leónjai betek jetenakush","poem":1},{"lineBreak":true},{"text":"senchish untsumainawa?","poem":1},{"lineBreak":true},{"text":"Dita nugkega duka yaaktaji aidau apegkam","poem":1},{"lineBreak":true},{"text":"pegkegchau wajas bashiak awai.","poem":1},{"lineBreak":true},{"text":"Nuwi pujauk makichkish atsawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Menfisnumia suntag aidau,","poem":1},{"lineBreak":true},{"text":"Tafnesnumia aidaujai buukmin tsaigtamjaje.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nunak wi Tuke Pujuu atumi Apajuíjum asan,","poem":1},{"lineBreak":true},{"text":"kuitamka itamaitkujum mina kajimatjukiu asajum","poem":1},{"lineBreak":true},{"text":"dutikam asaugme.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja yamaish atumesh","poem":1},{"lineBreak":true},{"text":"¿waji wakegakjumea","poem":1},{"lineBreak":true},{"text":"egiptunmaya suntag aidau asirianmaya aidaujai","poem":1},{"lineBreak":true},{"text":"atujatkatajum tusa ditajai chicham umikmi","poem":1},{"lineBreak":true},{"text":"tusagmesh tajume?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Atumek intimkiu, pegkegchau takamin ainajum","poem":1},{"lineBreak":true},{"text":"duwi dekas nunin ainagme tama ajume.","poem":1},{"lineBreak":true},{"text":"Nuadui mina umigtichagtaish,","poem":1},{"lineBreak":true},{"text":"waji utugchatak miniawa nunú wainkajum","poem":1},{"lineBreak":true},{"text":"dekaskeapi titajum.","poem":1},{"lineBreak":true},{"text":"Witjai apu Tuke Pujuu ashí senchigtinnuk, nunak dekas tajai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaunchuk nagkamsajum wijai shiwagmagajum,","poem":1},{"lineBreak":true},{"text":"mina umigtut dakitakjum:","poem":1},{"lineBreak":true},{"text":"‘Apajuí umigtak dakitaji’, tiuwaitjume.","poem":1},{"lineBreak":true},{"text":"Tau asajum, mina umigtutsuk","poem":1},{"lineBreak":true},{"text":"dakumka najanamu aidau nain aidaunum emematkujum,","poem":1},{"lineBreak":true},{"text":"numi kampuja aidau wakentin nuwa akika dutiktaijai betek wajasjum,","poem":1},{"lineBreak":true},{"text":"pegkegchau takama yujayugme.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wi atumnak uva numiji","poem":1},{"lineBreak":true},{"text":"dekas shiig pegkeg etejamu juki ajamaina","poem":1},{"lineBreak":true},{"text":"iman amainun waji ajataitkuish ajauwaitjime.","poem":1},{"lineBreak":true},{"text":"Tujash ¿wagka imanikjumesh pegkegchaush wajasugme?","poem":1},{"lineBreak":true},{"text":"¡Imaniku asagmin wainkatag takunush waintsujime!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lejiajai nijamakjumesh, tuja jabón pegkeg aidaujai","poem":1},{"lineBreak":true},{"text":"atum wakegamu nijamakjumesh,","poem":1},{"lineBreak":true},{"text":"atumi pegkegchaujum makichkish esakaumaitsugme.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas tajai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ibau pegkegchau ainayatkugmesh","poem":1},{"lineBreak":true},{"text":"¿wajukeakjumea iik pegkegchauk takatsji,","poem":1},{"lineBreak":true},{"text":"tuja dakumka najanamu aina dushakam","poem":1},{"lineBreak":true},{"text":"emamatuinatsji tajume?","poem":1},{"lineBreak":true},{"text":"Nijah, nugka Ben-hinom aajakua nuwi","poem":1},{"lineBreak":true},{"text":"wakeen pujusjumesh wajukin ayugme nunú adeagtajum,","poem":1},{"lineBreak":true},{"text":"nunikjum dekaskeapi titajum.","poem":1},{"lineBreak":true},{"text":"Atumek camello numpajak emetnag","poem":1},{"lineBreak":true},{"text":"pujuschamin wajama nujai betek ainagme.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Atumek burro numpajak","poem":1},{"lineBreak":true},{"text":"aishmag entsamjutkati tusa egak,","poem":1},{"lineBreak":true},{"text":"dase dasentai mejea, mejea, mejea wajak","poem":1},{"lineBreak":true},{"text":"tupikaki ikam akumkuig,","poem":1},{"lineBreak":true},{"text":"makichkish emetmaitsu nujai betek wajagme.","poem":1},{"lineBreak":true},{"text":"Imaniau asamtai, aishmag egakug yupichuch igkuinai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¡Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"sapatjinchau tupika yujasjum dawem ichiajaigpa,","poem":1},{"lineBreak":true},{"text":"kitakai jinawaigpa! tusa tamash,","poem":1},{"lineBreak":true},{"text":"atum chichaakjum:","poem":1},{"lineBreak":true},{"text":"Atsa, duka makichkish nunikchattawai,","poem":1},{"lineBreak":true},{"text":"iik tikich aents aidau dakumkamun emematin aina","poem":1},{"lineBreak":true},{"text":"nunú emematmi tusa wakegau asa,","poem":1},{"lineBreak":true},{"text":"ditajai shimaji tusajum shimutjume.","poem":1}]},{"type":"heading","content":["Israel aents aidauk dita pegkegchaujin suwimak suwam atin"]},{"type":"verse","number":26,"content":[{"text":"Atumek kasa kasamkatatus wekagu wainkam","poem":1},{"lineBreak":true},{"text":"datsaamama numamtuk, atumi apujum aidaujai,","poem":1},{"lineBreak":true},{"text":"sacerdote aidaujai, profeta aidaujai ashí datsagtatjume.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Atumek numi chichagkujum:","poem":1},{"lineBreak":true},{"text":"‘Ametme iina apajimek’, tajume.","poem":1},{"lineBreak":true},{"text":"Tuja kaya chichagkujum:","poem":1},{"lineBreak":true},{"text":"‘Ametme iina dukujig’, tajume.","poem":1},{"lineBreak":true},{"text":"Tujash atumek minak diigtsuk tuntupmatjagme.","poem":1},{"lineBreak":true},{"text":"Nuniayatkujum ishamainnum jegakjumek:","poem":1},{"lineBreak":true},{"text":"‘¡Ayamkagtukta!’ tusajum segatjume.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tuja atum aidautijum atumek dakumka najanamu","poem":1},{"lineBreak":true},{"text":"apajuíma yujaujum dusha ¿wajukawaje?","poem":1},{"lineBreak":true},{"text":"Atumi apajuímtai aidauk yaakat kuashta iman ainawai.","poem":1},{"lineBreak":true},{"text":"Nunú aidau kaunawag atum ishamain igkuagminish","poem":1},{"lineBreak":true},{"text":"ayamjutpaktinme.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"¡Atumek minak tuke intimjutin ainagme!","poem":1},{"lineBreak":true},{"text":"Nunin asajum minak wainkagmek pegkegchauk chichagtumaitsugme.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas tajai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Atumi uchijum aidauk","poem":1},{"lineBreak":true},{"text":"suwimak suwakuish wainka dutikmainai,","poem":1},{"lineBreak":true},{"text":"wagki imanik suwimka juinakush makichkish unuimainatsui.","poem":1},{"lineBreak":true},{"text":"Atumek león kajeaujai betek","poem":1},{"lineBreak":true},{"text":"mina profetag aidau ijinawaitjume.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tuja atum yamai uchi aidautigmeshkam","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu chichame antuktajum.","poem":1},{"lineBreak":true},{"text":"Wika uwejush nimpain asamtai,","poem":1},{"lineBreak":true},{"text":"waittayama dutikankesh waitkachuitjime,","poem":1},{"lineBreak":true},{"text":"tuja waa suwenum pujusa waittayama","poem":1},{"lineBreak":true},{"text":"dutikankesh waitkachuitjime.","poem":1},{"lineBreak":true},{"text":"Dutika waitkashtayaitkugmesh ¿wagka iik","poem":1},{"lineBreak":true},{"text":"agkan batsatji, nuniau asa ataktuk","poem":1},{"lineBreak":true},{"text":"aminak emematchattagme tusagmesh tujutjume?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nuwa aishinatnuk jáanch aishinku nugkutainak","poem":1},{"lineBreak":true},{"text":"patakumtai aidaujaig makichkish kajimatbaitsui.","poem":1},{"lineBreak":true},{"text":"Tujash mina aentsug aidauk yaunchuk","poem":1},{"lineBreak":true},{"text":"minak kajimatjukiaje.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"¡Amek pakijintai aina nuanuig shiig yachaitme!","poem":1},{"lineBreak":true},{"text":"Iman asamin nuwa akika dutiktai aina duka","poem":1},{"lineBreak":true},{"text":"aminiyan unuimainawai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Amina jáanchjum aidauk","poem":1},{"lineBreak":true},{"text":"aents pegkegchaun takachu aina nuna numpen,","poem":1},{"lineBreak":true},{"text":"ujudauch aidau numpejai maatug numpak wajasui.","poem":1},{"lineBreak":true},{"text":"Makichkish takamsachu aig, tsagkugtsuk","poem":1},{"lineBreak":true},{"text":"tuke aneasam mainaitme.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nuninaitkum datsantainkas chichaakum:","poem":1},{"lineBreak":true},{"text":"‘Wika Apajuí kajegtukti tusanuk","poem":1},{"lineBreak":true},{"text":"pegkegchaunak takamtsujai’, tame.","poem":1},{"lineBreak":true},{"text":"Ayu kame takamtsujai tusa imatu asamin,","poem":1},{"lineBreak":true},{"text":"nuna dekajuatasan apu chichama inagdau aina","poem":1},{"lineBreak":true},{"text":"nuwi ematjame.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"¿Wagka tujash atuniktinjum egaakmesh","poem":1},{"lineBreak":true},{"text":"imanikmesh waugtame?","poem":1},{"lineBreak":true},{"text":"Auk Asiria nugkanmaya aidau idaitamsa antsag","poem":1},{"lineBreak":true},{"text":"Egipto nugkanmayashkam idaitamsattawai.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mina kumpag ainawai tame nunak","poem":1},{"lineBreak":true},{"text":"wi dakitjan idaisajai.","poem":1},{"lineBreak":true},{"text":"Nuadui amek egiptunmaya aidaujai atunikan maaniatjai","poem":1},{"lineBreak":true},{"text":"tukamam depetamkagmatai,","poem":1},{"lineBreak":true},{"text":"datsaaja wake besekam wakitkittame.","poem":1},{"lineBreak":true},{"text":"¡Amina kumpajum ainakush makichkish yaimpakchagtatui!","poem":1},{"lineBreak":true},{"text":"tujamui Tuke Pujuu”, tiuwai Jeremías.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}