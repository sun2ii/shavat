{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":20,"content":[{"type":"heading","content":["Profeta Jeremías sacerdote Pashurjai"]},{"type":"verse","number":1,"content":["Imer aajakua nuna uchiji Pashur sacerdote Apajuí emematku ijuntai jegamkamun apuji aajakua nunú Jeremías utugchat nagkaemagtinun pachis chichagkagtaun antukui."]},{"type":"verse","number":2,"content":["Nunik: “Jeremías achikjum asutiatajum, dutikajum aents achika chimpitai Apajuí emematku ijuntai jegamkamua nuwi jegantatak, Benjamígka waitiji tutaya nuwi ayaumas awa nuni egkeatajum”, tusa inamjauwai."]},{"type":"verse","number":3,"content":["Tusa inamjayatak kashinia duwi kashikmas Jeremías jiiktajum tusa tiuwai. Tusa timatai jiikiajui, dutikam Jeremías niina chichajak: “Amina daagminak Tuke Pujuu yapagtugmattawai. Dutijamamtai Pashur idaikum Magor-misabid",{"noteId":0},"namkattame."]},{"type":"verse","number":4,"content":["Wagki Tuke Pujuu chichaak: ‘Aminak senchi sapigmitkaktatjame, dutikakun amina kumpajum aidaunashkam sapigmitkaktatjai. Nuadui amesh wainminig shiwag aidau amina kumpajum aidaunak ijinawagtatui. Tuja ashí Judá wegantu aidaunak Babilonian apuji depetuk achija niina nugkeen yajuakti, tuja dutikachkush kuchiiyai kajegti tusan niina idaitustatjai."]},{"type":"verse","number":5,"content":["Tuja nuigtushkam ashí dita wajiji aidaunak apu takatai waji akik pegkeg aidaujaí nagkamsan shiwajan ashí susattajai. Dutika ai nuna ashí yajuakag Babilonia nugkanum ejegawagtinai."]},{"type":"verse","number":6,"content":["Tuja Pashura aminak amina pataim aidaujaí achipajag Babilonia nugkanum yajupakagtinai. Dutijamawagmatai nuwi pujusam jakattame, nunikamin amina kumpajum aidau Apajuí pachisam wainka tsanu ayum nujai ijumag ukupasagtinai’ tusa Apajuí tawai”, tiuwai Jeremías."]},{"type":"heading","content":["Jeremías senchi waitiak Apajuíyai chichamjumakbau"]},{"type":"verse","number":7,"content":["Jeremías chichaak:",{"lineBreak":true},{"text":"“Tuke Pujuuwah, amek minak pegkeg","poem":1},{"lineBreak":true},{"text":"chichagtukam untsugkabiume,","poem":1},{"lineBreak":true},{"text":"tusa tujutkumin ayu tusan aikmaijame.","poem":1},{"lineBreak":true},{"text":"¡Amek mina nagkaetasu senchigtinaitme,","poem":1},{"lineBreak":true},{"text":"iman asam wagagtukmayume!","poem":1},{"lineBreak":true},{"text":"“Minak aents aidauk tuké dushiktuinawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wi tuwi chichaja nuniaknuk:","poem":1},{"lineBreak":true},{"text":"‘¡Suwimak juki waittsatin tsawan jegawai!","poem":1},{"lineBreak":true},{"text":"¡Shiwag ijipatin tsawan jegawai!’","poem":1},{"lineBreak":true},{"text":"tusan tuké nuna tajai.","poem":1},{"lineBreak":true},{"text":"Nuadui amina chichamjumin etseju asan","poem":1},{"lineBreak":true},{"text":"kashi kashinig dushikiam pujajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja wi anentaimsa chichaakun:","poem":1},{"lineBreak":true},{"text":"‘Dekas yamai nagkamsanuk Apajuínak kajimatkitjai,","poem":1},{"lineBreak":true},{"text":"tuja niina daajin pachisnush etsegkashtatjai’, tajai.","poem":1},{"lineBreak":true},{"text":"¡Tujash amina chichamem mina anentaijui","poem":1},{"lineBreak":true},{"text":"jiijai betek nimpak mina ukunchjunash sukuawai!","poem":1},{"lineBreak":true},{"text":"Dekas yamaik chichakchatjai tajai,","poem":1},{"lineBreak":true},{"text":"tujash amina chichamjumnak etsegtsuk","poem":1},{"lineBreak":true},{"text":"idaimainchau dekapeajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Aents aidau tuke aneas dushiktus chichainak:","poem":1},{"lineBreak":true},{"text":"‘¡Ashí yantamnum sapigmainaji!’ tuinawai.","poem":1},{"lineBreak":true},{"text":"Tikichnashkam chichainak:","poem":1},{"lineBreak":true},{"text":"‘¡Kaunatajum tsanumjuja utugchat apujtusmi!’","poem":1},{"lineBreak":true},{"text":"tuidaunash antajai.","poem":1},{"lineBreak":true},{"text":"Mina shiig kumpauchig aidaush","poem":1},{"lineBreak":true},{"text":"itusag pegkegchaun takasa tusa utugchatan egatjuinawai.","poem":1},{"lineBreak":true},{"text":"Nuninak: ‘Tsanusa dekapsami,","poem":1},{"lineBreak":true},{"text":"dutikkama ajuaik depetka emegkaktatji’, tujutuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Tujash Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amek maanitan yacha depetmainchauwaitme,","poem":1},{"lineBreak":true},{"text":"ame wijaig tuké pujame;","poem":1},{"lineBreak":true},{"text":"nuadui mina aintuina duka minak depetukchagtatui.","poem":1},{"lineBreak":true},{"text":"Ame depetkamu asa datsagkag, ame dutikamua","poem":1},{"lineBreak":true},{"text":"nunak makichkish kajimatkishtinun","poem":1},{"lineBreak":true},{"text":"tuke augmatu yujatin atinme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Tuke Pujuu ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"amek aentsu anentaimtajig shiig wainme,","poem":1},{"lineBreak":true},{"text":"nuadui ii anentaibaujish, tuja ii dutikatasa","poem":1},{"lineBreak":true},{"text":"anentaimtamush ashí dekame.","poem":1},{"lineBreak":true},{"text":"Ame wajuk suwimak susattame nuna wainkatasan wakegajai,","poem":1},{"lineBreak":true},{"text":"wagki wika midauwa nunak amina idaitusjame.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu kantamjuatajum!","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuu ememattajum,","poem":1},{"lineBreak":true},{"text":"wagki aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"ujudauch aidaun waitkagtaish,","poem":1},{"lineBreak":true},{"text":"nii ayamjuk agkanmitkawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“¡Tsawan wi akiinamua duka","poem":1},{"lineBreak":true},{"text":"shiig pegkegchau atin ati!","poem":1},{"lineBreak":true},{"text":"¡Mina dukug uchigmatjukua nunú tsawanta duka","poem":1},{"lineBreak":true},{"text":"pegkegnum chichagtai achati!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wi akiinamtai: ¡Aishmag akiinae! tusa","poem":1},{"lineBreak":true},{"text":"mina apajun ujaka shiig anemtiksauwa duka","poem":1},{"lineBreak":true},{"text":"shiig pegkegchau atin ati.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Utusag nunú aentsuk yaakat Tuke Pujuu tsaikam,","poem":1},{"lineBreak":true},{"text":"tuke megkaena numamtuk megkaeka tusan wakegajai.","poem":1},{"lineBreak":true},{"text":"¡Nuniak imaanjaujai betek kashikmas untsumiagtai,","poem":1},{"lineBreak":true},{"text":"tuja etsa tutupit aish,","poem":1},{"lineBreak":true},{"text":"maaniamunmas imatuinawa tumainun antak sapigma wekaya tajai!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Imanikan waitu pujutnaitkunush","poem":1},{"lineBreak":true},{"text":"¿wagkanuk akiinawabiajah?","poem":1},{"lineBreak":true},{"text":"Aika datsanmain maa ajapeam atinaitkunus","poem":1},{"lineBreak":true},{"text":"dekas jakau akiinachamiagtai.","poem":1},{"lineBreak":true},{"text":"¡Akiintsuk jakauwaitkunuk","poem":1},{"lineBreak":true},{"text":"wi ukumasbaujuk mina dukuju wake amainai!” tiuwai.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Magor-misabid” tawa duka hebreo chichamnumak, “ashí yantamnum sapigmamu awai” taku tawai.","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/agr_wbt/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":17}