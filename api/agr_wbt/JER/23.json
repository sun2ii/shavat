{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":23,"content":[{"type":"heading","content":["Achija yajuakbau waketjagtin"]},{"type":"verse","number":1,"content":["Tuke Pujuu chichaak: “¡Chah, aents uwija kuitamin, mina uwijun pachitsuk ipisig ishima nunak wait anentajai!”"]},{"type":"verse","number":2,"content":["Tuke Pujuu, Israel aents aidaun Apajuíjiya nunú, niina aentsji aidaun apuji aina nuna chichajak: “Atum aidautijum mina uwig aidau dapampaakugme, dutikajum shiig kuitamtsuk ipisjaugme. Dutikau asagmin wi atumnak suwimkan amastatjime, wagki atumi pegkegchaujin achijag tikich nugkanum yajuakaju asagmatai. Witjai Tuke Pujuunuk, nunak dekas tajai."]},{"type":"verse","number":3,"content":["Tujash wi dutika yajuaktinme tibau asag dutikau ainakuish, mina uwig aidaunak wiki ataktu awakjan dita nugken ikaunmattajai, dutika ai nuwiyan chijichin yuwinak yujakag kuashat wajasagti tusan."]},{"type":"verse","number":4,"content":["“Dutika ikaunman, ditan kuitamkagtinun tikich aidaun adaitugtatjai, dutika ai ishamkagtutsuk batsamsagtinai. Witjai Tuke Pujuunuk, nunak dekas tajai”, tiuwai."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug aidaunmak","poem":1},{"lineBreak":true},{"text":"aents shiig takau, yacha nunú apu atatui.","poem":1},{"lineBreak":true},{"text":"Duka David wegantunmaya atinai.","poem":1},{"lineBreak":true},{"text":"Nunú dekaskenmak shiig takastinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nii inamjatna dui,","poem":1},{"lineBreak":true},{"text":"mina aentsug Judá wegantu aidauk ayamjumaktinai,","poem":1},{"lineBreak":true},{"text":"tuja Israel aents aidaushkam agkan shiig batsamsagtinai.","poem":1},{"lineBreak":true},{"text":"Nunidau asag, Apajuí daajinak:","poem":1},{"lineBreak":true},{"text":"‘Tuke Pujuuwai iina depetmitkagbauk’","poem":1},{"lineBreak":true},{"text":"tuu adaikagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["“Tuke Pujuu chichaak: ‘Israel aents aidau Egipto nugkanum batsatun Tuke Pujuu jiijua nuna daajin tajai’ tusa tutaiya nunú yapajinatnuk tsawan jegattawai."]},{"type":"verse","number":8,"content":["Nunikmatai nuna idayinak: ‘Israel wegantu aidau Babilonia nugkanum, tuja tikich nugka aidaunum, utsagkam batsatun Tuke Pujuu jiija yajuak ikaunmauwa nuna daajin tajai’ tiagtinai. Apajuí yajuaka ikaunmam dita nugken batsamsagtinai”, tiuwai."]},{"type":"heading","content":["Profeta waitjin aidau"]},{"type":"verse","number":9,"content":["Jeremías chichaak:",{"text":"“Profeta aidaun anentaimtusan","poem":1},{"lineBreak":true},{"text":"shiig senchi anentaimkun waitiajai,","poem":1},{"lineBreak":true},{"text":"imaniai mina iyashjuk ashí sunatui.","poem":1},{"lineBreak":true},{"text":"Tuja Tuke Pujuu niina chichame pegkegma duwi","poem":1},{"lineBreak":true},{"text":"profeta aidaun pachis ujatkau asamtai,","poem":1},{"lineBreak":true},{"text":"nuwi senchi anentaimkun,","poem":1},{"lineBreak":true},{"text":"aents vinon nampeka wajukmaina numamtuk","poem":1},{"lineBreak":true},{"text":"winchainjan iyaumain dekapeajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Juju nugkanmak,","poem":1},{"lineBreak":true},{"text":"ayatak aents pegkegchaun takau aidau,","poem":1},{"lineBreak":true},{"text":"pegkegchaun takastatus tupikatin aidau,","poem":1},{"lineBreak":true},{"text":"apu adaikam nuna anagma","poem":1},{"lineBreak":true},{"text":"tikichi waitkau aidau aatus batsatui.","poem":1},{"lineBreak":true},{"text":"Nunin asagmatai juju nugkanak Apajuí pegkegchaunum yumigjauwai.","poem":1},{"lineBreak":true},{"text":"Dutikamu asamtai chijichi kagaka megkaejamtai,","poem":1},{"lineBreak":true},{"text":"juju nugka juka uwejush wajas asae.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Profetayaske, sacerdoteyaske","poem":1},{"lineBreak":true},{"text":"pegkegchaun takainawai,","poem":1},{"lineBreak":true},{"text":"núnidau asag mina emematjaku ijuntai","poem":1},{"lineBreak":true},{"text":"jegamkamua nuwi pegkegchaun takaidaun wainkamjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui dita jintig suwe atakuinja iyaumain atinai.","poem":1},{"lineBreak":true},{"text":"Shitaki ajuatnume tusan wi inamjattajai.","poem":1},{"lineBreak":true},{"text":"Suwimak jukitnuji tsawan jegamtai,","poem":1},{"lineBreak":true},{"text":"wi ditanak suwimkan susagtatjai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Samarianum shiig pegkegchaun wainkamjai.","poem":1},{"lineBreak":true},{"text":"Wi dakitamua nuna profeta aidau","poem":1},{"lineBreak":true},{"text":"Baalan pachis etsejuinawai,","poem":1},{"lineBreak":true},{"text":"dutikainak mina aentsug aidau ima minak","poem":1},{"lineBreak":true},{"text":"umigtumainun datupainawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja profeta Jerusalégnumia aina duka dekas","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau shiig pegkegchau ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui ditak dekas Apajuí chichamen etsegtsuk","poem":1},{"lineBreak":true},{"text":"dita anentaimsa jiikbaujin waitan etsejuinawai.","poem":1},{"lineBreak":true},{"text":"Nuna aents pegkegchau aidau antuinak","poem":1},{"lineBreak":true},{"text":"ichichmamainawai.","poem":1},{"lineBreak":true},{"text":"Nunú aidauk, makichkish pujutjin yapajiatag","poem":1},{"lineBreak":true},{"text":"tusagkesh anentaimainatsui.","poem":1},{"lineBreak":true},{"text":"Ayatak pegkegchaunak takainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui ditak dekas aents sodomanmaya,","poem":1},{"lineBreak":true},{"text":"gomorranmayajai aajaku aina nuna nagkaesau ainawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuadui wi apu Tuke Pujuu ashí senchigtinun","poem":1},{"lineBreak":true},{"text":"profeta Jerusalégnumia aina dusha wajukawagtigki","poem":1},{"lineBreak":true},{"text":"nuna yamai etsegjai:","poem":1},{"lineBreak":true},{"text":"Ditanak yutai yapaun ayujawagtatjai.","poem":1},{"lineBreak":true},{"text":"Tuja umutainashkam jatain egketuan aajagtatjai,","poem":1},{"lineBreak":true},{"text":"nunak dita pegkegchauji aidau ashí Israel aents","poem":1},{"lineBreak":true},{"text":"aidau nugken yujaku asamtai, dutikawagtatjai”,","poem":1},{"lineBreak":true},{"text":"tawai Apajuí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tuja atum Israel aents aidautigmin pachipas","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunú chichagtamak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aidautigmek anú profeta aidau","poem":1},{"lineBreak":true},{"text":"tujamaina duka makichkish antugkaigpa.","poem":1},{"lineBreak":true},{"text":"Dita etsejuina nunak waitjak tuu yujawai,","poem":1},{"lineBreak":true},{"text":"wi mina chichameg etsegtugkata tichamaitak, ditak nagkabiag tuu yujawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nunidau asag mina chichamjun dakitin aidaun chichajuinak:","poem":1},{"lineBreak":true},{"text":"‘Tuke Pujuu tujamui,","poem":1},{"lineBreak":true},{"text":"utugchatak atsugtamiagtatui’, tuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja aents dita wakegamunak takaina nuna","poem":1},{"lineBreak":true},{"text":"chichajuinak: ‘Makichik suwimkakesh","poem":1},{"lineBreak":true},{"text":"jukishtatjume’, tuinawai.”","poem":1}]},{"type":"heading","content":["Jeremías senchi chichakbau"]},{"type":"verse","number":18,"content":[{"text":"¿Yaita nigki waya Tuke Pujuujai chichasush?","poem":1},{"lineBreak":true},{"text":"¿Yaita nuna wainkaush, tuja nuniashkush","poem":1},{"lineBreak":true},{"text":"chichamen antugkaush?","poem":1},{"lineBreak":true},{"text":"¿Yaita nuna antuk puyatjus umiktajai tusa","poem":1},{"lineBreak":true},{"text":"anentaimush?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuke Pujuu kajekbaujiya duka dase ishamainun","poem":1},{"lineBreak":true},{"text":"dasentama iman asa,","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidaunak ijinattawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuke Pujuu kajekbaujiya duka makichkish","poem":1},{"lineBreak":true},{"text":"mijamtsuk ashí wajina dutikatjai tawa nuna","poem":1},{"lineBreak":true},{"text":"umika nagkankattawai.","poem":1},{"lineBreak":true},{"text":"Makichik tsawantai dekatnaitjume,","poem":1},{"lineBreak":true},{"text":"wagkag dusha imaniktinaita.","poem":1}]},{"type":"heading","content":["Profeta waita etsejin aidaun pachis Apajuí etsegkamu"]},{"type":"verse","number":21,"content":[{"text":"Nunú profeta aina nunak wika makichkish awematsjai,","poem":1},{"lineBreak":true},{"text":"mina chichameg etsegtugkatajum tusanuk,","poem":1},{"lineBreak":true},{"text":"ditanak augtanakesh augtsujai,","poem":1},{"lineBreak":true},{"text":"dutikamaitak jiinki yujasag mina daajun pachisag etsejuinawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dekas mina chichamjun antuk uminakug,","poem":1},{"lineBreak":true},{"text":"mina aentsug aidaunak mina chichamjun ujakag","poem":1},{"lineBreak":true},{"text":"pegkegchau takatnak idaimitkamain ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Atushat akuish, tuja tikijuch akuish","poem":1},{"lineBreak":true},{"text":"wika nuwi pujajai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuadui minak makichkish uumjutmainchau ainawai.","poem":1},{"lineBreak":true},{"text":"Nayaimpinmash, nugkanmash wika pujajai,","poem":1},{"lineBreak":true},{"text":"wi nunak Tuke Pujuun dekaskenum tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":["“Anú profeta aidau waitjuinak mina pachitus Apajuíjai kajanum chichaji tuidaun antukjai."]},{"type":"verse","number":26,"content":["Wainak waitjuinak ditak anentaimas dita wakegamun chichá yuja nunash ¿wajutik idaisagti?"]},{"type":"verse","number":27,"content":["Kajanmayan augmatuinak mina aentsug aidaun tsanuinawai, dutikam yaunchuk dita apachji aidau Baalan emematuinak mina kajimatjuki idaitusu aina numamtuk ditashkam kajimatki idaisatnume tusa."]},{"type":"verse","number":28,"content":["Makichik profetakesh kajamkagtujag, kajanmayan tajai titi. ¡Untsu mina chichamjun antuk etsejuk, shiig betek etsegkati! Trigon dukega duka nejejaig betekchauwai."]},{"type":"verse","number":29,"content":["Mina chichamjuk jiijai betek, nuigtu martillowai kaya awati tsaitiama imanai. Witjai Tuke Pujuunuk, nunak dekas tajai."]},{"type":"verse","number":30,"content":["“Nuadui wika au profeta aidau dita ditak pempeentunikiag, witjai dekas Apajuí chichamen etsejunuk tusa tuu yuja nuna antakun kajeajai. Witjai Tuke Pujuunuk, nunak dekas tajai."]},{"type":"verse","number":31,"content":["Au profeta aidau ditak anentaimas jiikiag tsanumak mina chichamjua numamtuk etsejuina nuna antakun kajeajai."]},{"type":"verse","number":32,"content":["Au profeta aidau kajanmayan waitan etsejuinak, mina aentsug aidaun anentain yapagtuawag pegkegchau takamtikaina duwi kajeajai. Wika ditanak makichkish mina chichameg etsegtugkatajum tusanuk ishimtsujai. Nuadui ditak mina aentsug aidaunak pegkegnumkesh yaimainchau ainawai. Witjai Tuke Pujuunuk, nunak dekas tajai”, tiuwai."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/20.json","previousChapterAudioLinks":{},"numberOfVerses":32}