{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel aents aidau Apajuín intimjukiagbau"]},{"type":"verse","number":16,"content":[{"text":"Apajuí niina aentsji aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Jintanum wajasjum diistajum,","poem":1},{"lineBreak":true},{"text":"yaunchuk jinta pegkeg aajakua dusha","poem":1},{"lineBreak":true},{"text":"tuki ayi tusajum inimsatajum.","poem":1},{"lineBreak":true},{"text":"Jinta pegkeja nunú ainkujum ayamat igkugtatjume”,","poem":1},{"lineBreak":true},{"text":"tujamui.","poem":1},{"lineBreak":true},{"text":"Tujash dita chichainak:","poem":1},{"lineBreak":true},{"text":"“Atsa, iik nii tawa nunú umigtak dakitaji”, tuinawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jinta niimin aidau utugchat atai, etsegkatnun","poem":1},{"lineBreak":true},{"text":"Apajuí ishiaku asa, Israel aents aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Dita chicham atai etsejainakui antuktajum” tiuwai.","poem":1},{"lineBreak":true},{"text":"Tusa tamashkam dita chichainak:","poem":1},{"lineBreak":true},{"text":"“Iik nunú antutak dakitaji”, tuinawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tusa tiagtai Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug aidaunash itugkagtajak","poem":1},{"lineBreak":true},{"text":"nunú tikich nugkanmaya aidautigmesh dekatajum.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ashí nugkanmaya aidautigmesh antuktajum:","poem":1},{"lineBreak":true},{"text":"Mina aentsug aidau dita wakegamun","poem":1},{"lineBreak":true},{"text":"takastag tuidau asag,","poem":1},{"lineBreak":true},{"text":"wi chicham umiktajum timawa nuna","poem":1},{"lineBreak":true},{"text":"dakitug umitsuk idaisaju asagmatai,","poem":1},{"lineBreak":true},{"text":"wi ditanak suwimkan susagtatjai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¿Wagka Sabá nugkanmaya kugkuin incienso","poem":1},{"lineBreak":true},{"text":"jukigmesh itagtuaugme?","poem":1},{"lineBreak":true},{"text":"¿Wagka tikich nugka atushtanmaya","poem":1},{"lineBreak":true},{"text":"kugkuin jukigmesh itagtuaugme?","poem":1},{"lineBreak":true},{"text":"Atum anentag itaamu aidau, tuja mina emematjaku","poem":1},{"lineBreak":true},{"text":"kuntin maa nuna neje ashí apeajum duka","poem":1},{"lineBreak":true},{"text":"minak shiig awajtatsui.”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nuna tusa Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi shiwag aidaun ishitkattajime,","poem":1},{"lineBreak":true},{"text":"dutika ai jetepakag,","poem":1},{"lineBreak":true},{"text":"uchijum aidaun,","poem":1},{"lineBreak":true},{"text":"atum pujamunum nuna yantamen ijunag pujuidaunak","poem":1},{"lineBreak":true},{"text":"atumi kumpaji aidaujai ashí ijinatnume, tusan”, tiuwai.","poem":1}]},{"type":"heading","content":["Nujinmanini jeteka ijinam agtin"]},{"type":"verse","number":22,"content":[{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Aents atushat nujinum batsamin senchigtin aidau","poem":1},{"lineBreak":true},{"text":"uminainawai maaniawagtatus.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Suntag aidauk puyag aidaun akentai aidaujai","poem":1},{"lineBreak":true},{"text":"yajuakag umintsaje;","poem":1},{"lineBreak":true},{"text":"ditak magkagtin wait anenkagtuchu ainawai.","poem":1},{"lineBreak":true},{"text":"Dita untsubaujig nayants uutbaujai betekai","poem":1},{"lineBreak":true},{"text":"caballonum ekemiag mininawai","poem":1},{"lineBreak":true},{"text":"Jerusalégkan jetekagtatus”, tiuwai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuna aents aidau antukag chichainak:","poem":1},{"lineBreak":true},{"text":"“Nunú chicham dekawaja","poem":1},{"lineBreak":true},{"text":"sapigmainaku kakaumainchau dekapeaji,","poem":1},{"lineBreak":true},{"text":"nuniaku nuwa tsawanji","poem":1},{"lineBreak":true},{"text":"jegajim uchin najaimak waitama imaniaji.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nuadui makichkitigmekesh ajanmak wegpajum,","poem":1},{"lineBreak":true},{"text":"tuja jinta ainjagmesh yujasaigpajum,","poem":1},{"lineBreak":true},{"text":"¡shiwag aidau puyaja yajuakag mininawai!","poem":1},{"lineBreak":true},{"text":"¡Ashí yantamnumak sapigmainawai!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mina aentsug aidauwah,","poem":1},{"lineBreak":true},{"text":"jáanch wake besemag pujaku nugkutai nugkugjum","poem":1},{"lineBreak":true},{"text":"yuku tadaetugtajum,","poem":1},{"lineBreak":true},{"text":"nunikjum makichik uchi pujau jakamtai, wake","poem":1},{"lineBreak":true},{"text":"besemag dekapeaku buutmaina imanikjum buuttajum;","poem":1},{"lineBreak":true},{"text":"wagki iina ijipawagtinuk dukap atsuk","poem":1},{"lineBreak":true},{"text":"kautjamkagtatui”, tibaijai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuu mina chichagtak:","poem":1},{"lineBreak":true},{"text":"“Wi aminak mina aentsug aina nuna pujutish","poem":1},{"lineBreak":true},{"text":"wajukuk ainawa nuna diigsati tusan","poem":1},{"lineBreak":true},{"text":"apusabiagme”, tujutmayi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tujutkui wi ayaakun:","poem":1},{"lineBreak":true},{"text":"“Ditak intimkiu, tsanumkagtin, chichama antuchu,","poem":1},{"lineBreak":true},{"text":"pegkeja iman wantinaidau, tujash","poem":1},{"lineBreak":true},{"text":"chichamesh pegkegchau antumtikmainchau","poem":1},{"lineBreak":true},{"text":"bronce, hierro katsugma iman ainawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Jiju jinum jiyamak kuwija","poem":1},{"lineBreak":true},{"text":"pegkegchaujin utsanak pegkeg weawai,","poem":1},{"lineBreak":true},{"text":"tujash aents pegkegchau aina nuna","poem":1},{"lineBreak":true},{"text":"iwagmainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Nunú iwajatag takuish, wainka tsawan megkaemainai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nunin asagmatai ame idaisau asamin:","poem":1},{"lineBreak":true},{"text":"‘Plata pegkegchau asagmatai utsagbau’","poem":1},{"lineBreak":true},{"text":"tuu adaikagtinai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}