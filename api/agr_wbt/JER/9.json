{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JER","translationId":"agr_wbt","name":"Jeremías","commonName":"Jeremías","title":"Jeremías","order":24,"numberOfChapters":16,"sha256":"76a6cf28f89571191bfc9991c57adaf064e3fd2405c5c26aa094ae8eeb2b60ea","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/agr_wbt/JER/38.json","totalNumberOfVerses":391},"chapter":{"number":9,"content":[{"type":"verse","number":10,"content":["“Nunikmatai muja aidaunum yujasjum",{"text":"“atumi tagkujum aidaun yutaiji chijichi aidauk","poem":1},{"lineBreak":true},{"text":"ashí apekbau asamtai,","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeakjum buuttajum.","poem":1},{"lineBreak":true},{"text":"Tuja imatika apekbau asamtai,","poem":1},{"lineBreak":true},{"text":"nuni nagkaematnak dakitainawai;","poem":1},{"lineBreak":true},{"text":"tuja atumi tagkujum aidau shinaukesh","poem":1},{"lineBreak":true},{"text":"makichkish antuenatsui,","poem":1},{"lineBreak":true},{"text":"chigki aidaush, kuntin ikamia aidaush","poem":1},{"lineBreak":true},{"text":"ashí pisag megkaejaje.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Judá wegantun yaaktaji aidaunak wi ashí tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai aents atsau bashiak agkan wajas asatnai.","poem":1},{"lineBreak":true},{"text":"Jerusalégnashkam tsaiktatjai, dutika ai","poem":1},{"lineBreak":true},{"text":"ayatak kaya tuwasua weaku atatui.","poem":1},{"lineBreak":true},{"text":"Nunú nugkanmak ikamia yawá aina duke","poem":1},{"lineBreak":true},{"text":"batsamsatnai, tujamui Tuke Pujuu”, tiuwai Jeremías.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Nuigtu Jeremías chichaak: “Juju nugkanum yaakat ayá dusha ¿wagka imatikaish tsaikbauwaita? Juju nugka juni waya nagkaebauk makichkish atsawai. “¡Uwegshuchuashit tumain wajas awai! ¿Yaita nuna shiig dekamainush? Profeta Apajuí awemamu asa, ¿nuna pachis iina ujapamainush awash?” tiuwai."]},{"type":"verse","number":13,"content":["Tutai Tuke Pujuu ayaak: “Ehe, auk chicham umiktinun wi ditan susauwaitag nuna intimkiag umitsuk idaisaju asag aikam asaje."]},{"type":"verse","number":14,"content":["Nuna umitsuk dita apaji emematujakagbaun nuna, ditashkam dita anentai wakegamun Baal aidaun emematiaju ainawai."]},{"type":"verse","number":15,"content":["Nuadui wi Tuke Pujuun, Israel aents aidaun Apajuíji, ashí senchigtinun juna tajai: Wi ditanak yutai yapaun ayujawagtatjai, tuja umutai jatai egketuamun aajagtatjai."]},{"type":"verse","number":16,"content":["Tuja yaunchkesh dita apajigkesh wainajakchamunum tikich nugkanum dapampaakan utsagtatjai. Dutika ai, shiwag aidau puyaja juki yujagsag ashí amuktinme titatjai”, tiuwai."]},{"type":"heading","content":["Jerusalégnumia aidau awake anentaimjag buutiagbau"]},{"type":"verse","number":17,"content":["Tuke Pujuu ashí senchigtina nunú chichaak:",{"text":"“¡Juju shiig antugtuktajum!","poem":1},{"lineBreak":true},{"text":"Aents jakamtai buutin atinme tusa","poem":1},{"lineBreak":true},{"text":"etegjamu nuwa aina nunú untsuka ikaunmatajum.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Duka dekas buuttan yacha aina nunú","poem":1},{"lineBreak":true},{"text":"wamak kaunawag atumin egampagtinme!","poem":1},{"lineBreak":true},{"text":"¡Imatuinak dita jiinig negaikijinak bete wajastinme!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nunik Siógnum nagkamas buutuinak:","poem":1},{"lineBreak":true},{"text":"‘¡Jauchah, wagkaik imatika tsayamash asaji!","poem":1},{"lineBreak":true},{"text":"Iina jee aidaunak ashí tsaigtamkaje,","poem":1},{"lineBreak":true},{"text":"tikich nugkanum shimaku ukukiagmi’,","poem":1},{"lineBreak":true},{"text":"wajaidau antuenawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuja nuwa buuttan yacha aidauwah,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu chichame shiig jitusa antuktajum,","poem":1},{"lineBreak":true},{"text":"nunikjum atumi nawanjum aidau","poem":1},{"lineBreak":true},{"text":"kumpajum aidaujai wake besemag pujaku","poem":1},{"lineBreak":true},{"text":"buuttai, juju aatsa jintintuatajum:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Iina jee aidaunum jata wainjamae,","poem":1},{"lineBreak":true},{"text":"tuja apu pujusa inamtainish wayae,","poem":1},{"lineBreak":true},{"text":"nuniku asa, uchi piipich jintá wasugkamak yujaun,","poem":1},{"lineBreak":true},{"text":"datsauch aidau plazanum yujaunashkam ijinui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dutikamu asa aents jinau aidauk,","poem":1},{"lineBreak":true},{"text":"ajak juwaam kakegak batsamama numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja tsuwat ukaja ukukmawa numamtuk wajas awai.","poem":1},{"lineBreak":true},{"text":"Witjai Tuke Pujuunuk, nunak dekas tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Tuja aents yacha duka","poem":1},{"lineBreak":true},{"text":"niina yachajinigkik eme anenmamigka,","poem":1},{"lineBreak":true},{"text":"tuja aents senchigtina dushakam,","poem":1},{"lineBreak":true},{"text":"niina senchijinigkik eme anenmamigka,","poem":1},{"lineBreak":true},{"text":"tuja wiakchashkam niina wiakchajinig eme anenmamigka.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dekas eme anenmamsatatus wakegakug,","poem":1},{"lineBreak":true},{"text":"wi Tuke Pujuu ashí senchigtinaitag nuna shiig dekaa","poem":1},{"lineBreak":true},{"text":"umigtak eme anenmamainai.","poem":1},{"lineBreak":true},{"text":"Wika nugkag anenkajai takajai,","poem":1},{"lineBreak":true},{"text":"nuadui anenka nunú tsanumtsuk shiig takamua","poem":1},{"lineBreak":true},{"text":"nujai shiig awajtawai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}