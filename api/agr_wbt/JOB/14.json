{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Aents nuwanum akiinauwa","poem":1},{"lineBreak":true},{"text":"nuna pujutjig ujumke,","poem":1},{"lineBreak":true},{"text":"untsu waitiamuji ima múuntai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aentsu pujutjig yagkug kashikmas","poem":1},{"lineBreak":true},{"text":"pegkegchin yagkujuk ajum kagaja","poem":1},{"lineBreak":true},{"text":"megkagama numamtinai,","poem":1},{"lineBreak":true},{"text":"nuigtushkam aentsu pujutjig etsa","poem":1},{"lineBreak":true},{"text":"bikian wamak megkagama numamtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wika wainkauchitag nuniaigkiap","poem":1},{"lineBreak":true},{"text":"mina utugchatug diigtusam,","poem":1},{"lineBreak":true},{"text":"suwimak sujustasam chicham umigtame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pegkegchauwa duka pegkejak wemaitsui,","poem":1},{"lineBreak":true},{"text":"nuna dutikmainuk makichkish atsawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents aidaush wajupa tsawantak","poem":1},{"lineBreak":true},{"text":"juju nugka juwish batsamsagtinaita","poem":1},{"lineBreak":true},{"text":"duka ame dekame,","poem":1},{"lineBreak":true},{"text":"tuja ii jakatnuk tsawantak mamikiamui,","poem":1},{"lineBreak":true},{"text":"nunú inagkeakik pujumaitsuji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui idaikagtusta diijattsuk,","poem":1},{"lineBreak":true},{"text":"idaikagtusta agkan pujusagmi.","poem":1},{"lineBreak":true},{"text":"¡Idaikagtusta takasa jukimui ii atsumamua nunú sumakagmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Aents numin ajakag","poem":1},{"lineBreak":true},{"text":"nuna wajauti jeeka tsapai","poem":1},{"lineBreak":true},{"text":"muumpagti tusa dakauwai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja numi múun wajasa","poem":1},{"lineBreak":true},{"text":"kagkapeen kukaja jakattak wajaush,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yumi juki ukatjamak ataktu uchimea","poem":1},{"lineBreak":true},{"text":"yama nagkamchaku ajak ajaamu tsapai,","poem":1},{"lineBreak":true},{"text":"pegkeg samekbaun","poem":1},{"lineBreak":true},{"text":"muumpama iman weawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tujash aents aidautik wamak jaji,","poem":1},{"lineBreak":true},{"text":"nunika jaka tuke megkaeji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Tuja aents aidautik kucha aidau,","poem":1},{"lineBreak":true},{"text":"entsa aidau, kuyuka buku waiyama","poem":1},{"lineBreak":true},{"text":"numamtuk ainaji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui nayaim eke aigkik aents jakamtai,","poem":1},{"lineBreak":true},{"text":"ukusbau aidauk ataktuk nantamainchau ainawai.","poem":1},{"lineBreak":true},{"text":"Aents jakauwa duka tuke kanajujai betekai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“¡Apajuíyah, ame kajekbaujum","poem":1},{"lineBreak":true},{"text":"nagkaetamai dekas jakatjai,","poem":1},{"lineBreak":true},{"text":"nunikan aents jinau aidau","poem":1},{"lineBreak":true},{"text":"batsatbaunum pujustajai","poem":1},{"lineBreak":true},{"text":"tumain anentaimjai!","poem":1},{"lineBreak":true},{"text":"¡Nuwi pujai ame wait anenjujam","poem":1},{"lineBreak":true},{"text":"ataktu inantukminum tusan!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aents jakauwa duka","poem":1},{"lineBreak":true},{"text":"ataktu anean nantakig pujumaitsui,","poem":1},{"lineBreak":true},{"text":"wika aents jakau aidau batsatbaunum","poem":1},{"lineBreak":true},{"text":"dakamkun pujuttajai,","poem":1},{"lineBreak":true},{"text":"wait anenjug ayamtijugti tusan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ame mina najatuaum","poem":1},{"lineBreak":true},{"text":"wait anenmain diigsam untsugkuminig,","poem":1},{"lineBreak":true},{"text":"wika aminak aimainaitjame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ame mina kuitamjukta tau asam,","poem":1},{"lineBreak":true},{"text":"wi takamug aidauk ashí wainme.","poem":1},{"lineBreak":true},{"text":"Nuadui wi pegkegchaun takasmataish,","poem":1},{"lineBreak":true},{"text":"tudau takasume tusamek tujutchattame.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Duka tujuttsuk ame minak tsagkugtujam","poem":1},{"lineBreak":true},{"text":"mina tudaujuk wampachnum egkea jukim","poem":1},{"lineBreak":true},{"text":"shiig atushat ajapmainaitme.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dutikmain aminig","poem":1},{"lineBreak":true},{"text":"ayatak muja aidau,","poem":1},{"lineBreak":true},{"text":"buchig aidaujai yumpunawag","poem":1},{"lineBreak":true},{"text":"amugama nuniaji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ashí aents aidauk iwaku","poem":1},{"lineBreak":true},{"text":"batsamsagtatus wakegainawai,","poem":1},{"lineBreak":true},{"text":"tujash ame duka yumi kayan","poem":1},{"lineBreak":true},{"text":"taumama numamtuk awagme.","poem":1},{"lineBreak":true},{"text":"Dutikakum yumi yutak","poem":1},{"lineBreak":true},{"text":"nugka yukukuntun tajaka,","poem":1},{"lineBreak":true},{"text":"ajapama numamtuk","poem":1},{"lineBreak":true},{"text":"aentsu pujutjig ajapeame.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dutikam tuke emegkame,","poem":1},{"lineBreak":true},{"text":"pujutchakam atankagtame,","poem":1},{"lineBreak":true},{"text":"dutikam ukumatainum ekagtame.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents jakauwa duka,","poem":1},{"lineBreak":true},{"text":"aents iwaku aidaush","poem":1},{"lineBreak":true},{"text":"dita uchiji aishmag aidau,","poem":1},{"lineBreak":true},{"text":"nawanji aidaujai takatjin diigsash,","poem":1},{"lineBreak":true},{"text":"shiijash awagmaina nunak dekatsui,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchaun takagtaish,","poem":1},{"lineBreak":true},{"text":"itujenawaki nunashkam dekatsui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ima nii iyashin","poem":1},{"lineBreak":true},{"text":"najaimamunak dekapeawai,","poem":1},{"lineBreak":true},{"text":"nuniak buutui”, tusa Job tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":22}