{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Nuna tusa nuigtu Job chichaak:"]},{"type":"verse","number":2,"content":[{"text":"“¡Make agkan idaitustajum, ipimtagme!","poem":1},{"lineBreak":true},{"text":"¡Atum tujutjum duka","poem":1},{"lineBreak":true},{"text":"kuchiyai ijutbau najamaina imatijawai!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuashta minak pegkegchau chichagtagme.","poem":1},{"lineBreak":true},{"text":"¿Mina jutika waitkajakjumesh","poem":1},{"lineBreak":true},{"text":"datsaamatsjumek?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wi pegkegchaun takamsau","poem":1},{"lineBreak":true},{"text":"amainaitag duka,","poem":1},{"lineBreak":true},{"text":"atumnak pegkegchauk etamaitsui,","poem":1},{"lineBreak":true},{"text":"duka ima mina utugchatjuke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atumek mina nagkaetasu","poem":1},{"lineBreak":true},{"text":"pegkejam anenmamjume,","poem":1},{"lineBreak":true},{"text":"wi jakun kakaumainchau","poem":1},{"lineBreak":true},{"text":"wajasa pujag duwi","poem":1},{"lineBreak":true},{"text":"dushiktaku imatjutagme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wi waitiag junak,","poem":1},{"lineBreak":true},{"text":"Apajuí waittsati tujutmatai waitiag nunú","poem":1},{"lineBreak":true},{"text":"shiig dekatajum.","poem":1},{"lineBreak":true},{"text":"Kuntin chanua maatasa","poem":1},{"lineBreak":true},{"text":"umigtayama numamtuk","poem":1},{"lineBreak":true},{"text":"Apajuí umikbaunum pujusan waitiajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Senchi untsumkan","poem":1},{"lineBreak":true},{"text":"¡mantuinawai! tusan imattaish,","poem":1},{"lineBreak":true},{"text":"makichkish aijuinatsui.","poem":1},{"lineBreak":true},{"text":"Yainkatajum taish,","poem":1},{"lineBreak":true},{"text":"makichkish yaintuinatsui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuí minak nagkaemaki","poem":1},{"lineBreak":true},{"text":"tusa jintan akigtujue.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam","poem":1},{"lineBreak":true},{"text":"jintan suwe etugtine.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mina wajiig aidaun, tagkug aidaun,","poem":1},{"lineBreak":true},{"text":"aents inakeg aidaun ashí yajutjuke;","poem":1},{"lineBreak":true},{"text":"dutijak nuigtushkam eme anentsa","poem":1},{"lineBreak":true},{"text":"diyam amainchau etine.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Minak makichkish wajigtuchu","poem":1},{"lineBreak":true},{"text":"shiig wainak etine.","poem":1},{"lineBreak":true},{"text":"¡Numi kagkapejaí tegai ajapamu, ataktu tsapamaitsu numamtuk,","poem":1},{"lineBreak":true},{"text":"tsagagnuap pujustatja","poem":1},{"lineBreak":true},{"text":"tumainchau awajtuse!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nii kajekbaujin imatijawai,","poem":1},{"lineBreak":true},{"text":"imatijak shiwaajui","poem":1},{"lineBreak":true},{"text":"utugmaina dutijawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niina suntaji aidauk ashí nantagtujaje,","poem":1},{"lineBreak":true},{"text":"nunikag mina jegajun tentea apakag","poem":1},{"lineBreak":true},{"text":"uminas jetetuinak waitkajuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Mina yatsug aidau","poem":1},{"lineBreak":true},{"text":"mina kumpag aidaujai kajimatkitnume,","poem":1},{"lineBreak":true},{"text":"dutikainak aents tikich nugkanmaya","poem":1},{"lineBreak":true},{"text":"utugtaya dutikatnume tusa Apajuí tine.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mina pataag aidaushkam","poem":1},{"lineBreak":true},{"text":"kumpag aidaujai pachittsuk idaitusaje.","poem":1},{"lineBreak":true},{"text":"Wijai ijunag yujajaku aidaushkam pachitkachaje.","poem":1},{"lineBreak":true},{"text":"Mina inakeg aidaushkam","poem":1},{"lineBreak":true},{"text":"aents tikich nugkanmaya","poem":1},{"lineBreak":true},{"text":"wainchatai itugmaina dutijainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mina inakeg aidaun","poem":1},{"lineBreak":true},{"text":"untsuaish aijuinatsui;","poem":1},{"lineBreak":true},{"text":"kuashta untsuaish","poem":1},{"lineBreak":true},{"text":"makichkish antugtuinatsui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mina duwagshakam","poem":1},{"lineBreak":true},{"text":"wi mejeau asamtai tsuumjawai,","poem":1},{"lineBreak":true},{"text":"tuja mina yatsug aidaushkam kajegtuinawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Uchi ai aidauwaske dushiktuinawai,","poem":1},{"lineBreak":true},{"text":"eke yama wajain wekaesatag taig,","poem":1},{"lineBreak":true},{"text":"dushiktuinawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mina shiig kumpauchig aidaush","poem":1},{"lineBreak":true},{"text":"kajegtuinawai,","poem":1},{"lineBreak":true},{"text":"mina aneetaig aidau,","poem":1},{"lineBreak":true},{"text":"shiwagmatuinawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Watsajan ayatak ukunchik wajasjai,","poem":1},{"lineBreak":true},{"text":"ashí jakan piipichin iwaakjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mina kumpag aidauwah,","poem":1},{"lineBreak":true},{"text":"minash wait anenjugtajum,","poem":1},{"lineBreak":true},{"text":"minak Apajuí waittsati tujutiu asamtai,","poem":1},{"lineBreak":true},{"text":"wika senchi waitiajai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Make idaitustajum!","poem":1},{"lineBreak":true},{"text":"atumek kuashta waitkagjume.","poem":1},{"lineBreak":true},{"text":"¡Apajuí waittsati tujutmatai","poem":1},{"lineBreak":true},{"text":"waitiag duke ati!” tiuwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}