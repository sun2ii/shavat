{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":3,"content":[{"type":"heading","content":["Job senchi waitiak kajeka chichakbau"]},{"type":"verse","number":1,"content":["Jopak imanik waitiakush, chichatsuk pujau tikima atsanmainchau dekapeak chichakui. Nuniak:",{"text":"“Wika akiinmainchaunas","poem":1},{"lineBreak":true},{"text":"akiinawabiagtai tajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Tsawan wi akiinamua","poem":1},{"lineBreak":true},{"text":"duka pegkegchau atin ati!","poem":1},{"lineBreak":true},{"text":"Tuja wi akiinamtai kashi chichainak:","poem":1},{"lineBreak":true},{"text":"Aishmag akiinae tujutiu aina dushakam","poem":1},{"lineBreak":true},{"text":"pegkegchau atin ati.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Wi akiinawaitag nunú tsawannak","poem":1},{"lineBreak":true},{"text":"Apajuí suwe emamainnas aikachamiatai,","poem":1},{"lineBreak":true},{"text":"Apajuí nunú tsawantan kajimatkiu ataik,","poem":1},{"lineBreak":true},{"text":"tsawaumainchaun tsawajui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Wagkag nunú tsawantinish","poem":1},{"lineBreak":true},{"text":"makichik suwe dupajam iyagchabi!","poem":1},{"lineBreak":true},{"text":"¡Nunú tsawannak yujagkim suwe ijia","poem":1},{"lineBreak":true},{"text":"emegkaumainnas aikachamiatai!","poem":1},{"lineBreak":true},{"text":"¡Etsa etsantun epenak suwe ishamain","poem":1},{"lineBreak":true},{"text":"emama imatika emegkaumainnas aikachamiatai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Wagkag nunú kashia duwi mina dukug","poem":1},{"lineBreak":true},{"text":"ejapjukua dusha, suwe wajas megkaekachabi?","poem":1},{"lineBreak":true},{"text":"¡Nunú tsawantin kashi mina dukug","poem":1},{"lineBreak":true},{"text":"mina ejapjutkauwa duwi nagkamsag","poem":1},{"lineBreak":true},{"text":"tsawan aidauk, nantu aidauk, mijan aidauk","poem":1},{"lineBreak":true},{"text":"dekapamainchaus ayatai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“¡Mina dukujuk nunú kashia duwik","poem":1},{"lineBreak":true},{"text":"ejapjuchu wemainnas nunikchamiatai,","poem":1},{"lineBreak":true},{"text":"nunikuitkuig makichik aentskesh","poem":1},{"lineBreak":true},{"text":"aishmag akiinae tusag tumainchau wajakajui!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Tunchi aidau, makichik kuntin múun","poem":1},{"lineBreak":true},{"text":"nayants puju Leviatán tutaya nuna iwishtug","poem":1},{"lineBreak":true},{"text":"nii wakegamu dutikati","poem":1},{"lineBreak":true},{"text":"tumainnas dutikachajabiatai!","poem":1},{"lineBreak":true},{"text":"Nunú tunchi aidaush","poem":1},{"lineBreak":true},{"text":"¿wagkag nunú kashi aajakua nunash emesjachajabi?","poem":1},{"lineBreak":true},{"text":"dutikau agtaik mina","poem":1},{"lineBreak":true},{"text":"dukujuk ejapjumainchau wajakui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Yaya tsawagtatak etsantin aidau,","poem":1},{"lineBreak":true},{"text":"mina dukug ejapjutkamtai,","poem":1},{"lineBreak":true},{"text":"ejampek etsanjau aina","poem":1},{"lineBreak":true},{"text":"nunak etsanmainchaus ayatai.","poem":1},{"lineBreak":true},{"text":"Tsawan tsawagmatai, etsa jiinu","poem":1},{"lineBreak":true},{"text":"wainna duka wainnamainchau wajakui!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Mina dukug kashi ejapjutkauwa nunú","poem":1},{"lineBreak":true},{"text":"kashia duka pegkegchau atin ati!","poem":1},{"lineBreak":true},{"text":"wagki jakati tutsuk","poem":1},{"lineBreak":true},{"text":"akiinati tusa tujutiu asamtai,","poem":1},{"lineBreak":true},{"text":"nunú kashi aajakua duwi akiina pujusan,","poem":1},{"lineBreak":true},{"text":"senchi waitiag ankatin asamtai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Wagkanuk mina dukujui","poem":1},{"lineBreak":true},{"text":"egkemsanuk jakachamiaja?","poem":1},{"lineBreak":true},{"text":"Nuniachkunush ¿wagkanuk","poem":1},{"lineBreak":true},{"text":"yama akiinmawaik jakachamiaja?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Wagkag wi akiinamtaish,","poem":1},{"lineBreak":true},{"text":"mina dukujush kuitamjukabi?","poem":1},{"lineBreak":true},{"text":"¿Wagkag muntsujinash amunstuawabi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yama akiinmawaik jakauwaitkunuk,","poem":1},{"lineBreak":true},{"text":"utugchatji atsugbau shiig kanak tepemaina","poem":1},{"lineBreak":true},{"text":"numamtuk, yamai ayamkun tepemainaitjai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaunchuk jakauwaitkunuk apu aidau,","poem":1},{"lineBreak":true},{"text":"dita atuwe aidaujai,","poem":1},{"lineBreak":true},{"text":"jega múun aidaun jegamjau aidau","poem":1},{"lineBreak":true},{"text":"jinawajua nujai ijunja pujumain wajajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuniachkunush maki makichik nugka apuji","poem":1},{"lineBreak":true},{"text":"aajaku aidau, dita pujusa","poem":1},{"lineBreak":true},{"text":"inamtaiji aajakunum oro","poem":1},{"lineBreak":true},{"text":"aidaun, jiju plata aidaun","poem":1},{"lineBreak":true},{"text":"utuamajaku aina nujai","poem":1},{"lineBreak":true},{"text":"ijunjan pujumain wajajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¿Wagkag uchi jakau akiidaun","poem":1},{"lineBreak":true},{"text":"ukusa ajapin aina dutika ajapjuachajabi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aents pegkegchau jakauk,","poem":1},{"lineBreak":true},{"text":"pegkegchaunak taka pujumaitsui,","poem":1},{"lineBreak":true},{"text":"tuja tikich aentsnashkam","poem":1},{"lineBreak":true},{"text":"pegkegchaunum inakug waitkamaitsui.","poem":1},{"lineBreak":true},{"text":"Tuja aents pimpiki yaweja","poem":1},{"lineBreak":true},{"text":"pujaushkam jakug ayamui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuwi batsamas achikbau","poem":1},{"lineBreak":true},{"text":"aajaku aidauk agkan batsatui,","poem":1},{"lineBreak":true},{"text":"wagki takata apuji senchi takatsjume,","poem":1},{"lineBreak":true},{"text":"tusa jiyaku suwimchamu asag.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nuwig batsatui aents","poem":1},{"lineBreak":true},{"text":"eme anentsa diitai aidau,","poem":1},{"lineBreak":true},{"text":"imanchaush aidaushkam betekmas batsatui.","poem":1},{"lineBreak":true},{"text":"Inaku waitkatai jinau aidaush","poem":1},{"lineBreak":true},{"text":"apuji waitkascham agkan batsatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“¿Wagkag Apajuísh aents","poem":1},{"lineBreak":true},{"text":"waittsatnunash akiinati tawa?","poem":1},{"lineBreak":true},{"text":"¿Wagkag aents kuashat waitiaunash","poem":1},{"lineBreak":true},{"text":"iwaku pujusti tawa?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents jakatatus egauk wamak jatsui,","poem":1},{"lineBreak":true},{"text":"waji pegkeg akik uukbaun wainkatatus","poem":1},{"lineBreak":true},{"text":"egama imatika jakatatus egakush jatsui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nunú aents shiig aneamujiya duka","poem":1},{"lineBreak":true},{"text":"jakamtai ukusam megkaga nunuwai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Niinash waji utugchatak ajiti nunak","poem":1},{"lineBreak":true},{"text":"Apajuík dekamtiktsui.","poem":1},{"lineBreak":true},{"text":"Nuadui aents wainmachujai betek,","poem":1},{"lineBreak":true},{"text":"jinta wetai epenbaunum","poem":1},{"lineBreak":true},{"text":"wetakama tujimaina numamtuk wajawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Yujumak yumainun idaikun,","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeakun buutjai,","poem":1},{"lineBreak":true},{"text":"umutain umakun pujumainun","poem":1},{"lineBreak":true},{"text":"senchi waitiakun kajeajai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ashí mina ishamtaig ayá nunú,","poem":1},{"lineBreak":true},{"text":"dekas mina uwaktin ayá nunú","poem":1},{"lineBreak":true},{"text":"yamai waitkajawai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Makichkish ayamainchau dekapeajai,","poem":1},{"lineBreak":true},{"text":"mina anentaijun ichichtujug","poem":1},{"lineBreak":true},{"text":"shiig anemtijumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Shiig aneasan agkan pujumainchau,","poem":1},{"lineBreak":true},{"text":"ayatak waugkamin dekapeajai”, tiuwai Job.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}