{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":38,"content":[{"type":"heading","content":["Job chichaka ashimkamtai Tuke Pujuu aikbau"]},{"type":"verse","number":1,"content":["Job chichaka inagnakmatai, dase senchi dasenbaunum Tuke Pujuu Jopan chichajak aatus tiuwai:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“¿Amesh ya asamea","poem":1},{"lineBreak":true},{"text":"mina dekatjua nunú","poem":1},{"lineBreak":true},{"text":"dekaskechua nunin anentakmesh","poem":1},{"lineBreak":true},{"text":"pegkegchaush chichame?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diik minash amina","poem":1},{"lineBreak":true},{"text":"wajiujum iwaintugkakiah,","poem":1},{"lineBreak":true},{"text":"nunikam wi yamai","poem":1},{"lineBreak":true},{"text":"iniastatjam nunú aigkata:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amek wi nugka najanauwaitag,","poem":1},{"lineBreak":true},{"text":"nunú tsawantaik atsuyume,","poem":1},{"lineBreak":true},{"text":"untsu dekaskenum dekakmek,","poem":1},{"lineBreak":true},{"text":"wi nugka najadiag duwish ¿amesh tuwi pujuyume? nunú kame tujutta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Yaki nugkanash múun ati tusash tiyabi?","poem":1},{"lineBreak":true},{"text":"tuja ¿yaki najanawabi?","poem":1},{"lineBreak":true},{"text":"duka amek dekatsme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Wajinum chichiajaya nugkash awa?","poem":1},{"lineBreak":true},{"text":"¿Nugka patami asatnunash","poem":1},{"lineBreak":true},{"text":"ya kayanash apujtuawaita?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kashikmas pegkejan","poem":1},{"lineBreak":true},{"text":"etsantug jiinama nuniai,","poem":1},{"lineBreak":true},{"text":"yaya aidau aents ijunag","poem":1},{"lineBreak":true},{"text":"kantamaina numamtuk kantamiagtai,","poem":1},{"lineBreak":true},{"text":"ángel aidau nantsemianum","poem":1},{"lineBreak":true},{"text":"nuaduik amek atsuyume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja nayants nugka","poem":1},{"lineBreak":true},{"text":"ejapeen jiiniuwa nunú","poem":1},{"lineBreak":true},{"text":"piyag betsakai tusash","poem":1},{"lineBreak":true},{"text":"¿ya epetkauwaita?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi nunak makichik nuwa uchijin jáanchi","poem":1},{"lineBreak":true},{"text":"pempegama numamtuk,","poem":1},{"lineBreak":true},{"text":"yujagkim pujui dukukan epetkauwaitjai,","poem":1},{"lineBreak":true},{"text":"dutikan yujagkim","poem":1},{"lineBreak":true},{"text":"suwé ijikan idaisauwaitjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuja nayantsak pimu amain aig,","poem":1},{"lineBreak":true},{"text":"yumi initak jiinaidaun","poem":1},{"lineBreak":true},{"text":"epenjan idaisauwaitjai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dutikan chichagkun:","poem":1},{"lineBreak":true},{"text":"‘Juwig nagkankata, nuigtu","poem":1},{"lineBreak":true},{"text":"nagkaemakmek piyajaipa;","poem":1},{"lineBreak":true},{"text":"tuja tsukatbaujum","poem":1},{"lineBreak":true},{"text":"ishamain waja dushakam","poem":1},{"lineBreak":true},{"text":"nuigtuk wee pujushtatui’, tiuwaitjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Amek tsawan pegkejan etsantug","poem":1},{"lineBreak":true},{"text":"tsawagti tusamek makichkish inachuitme.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amek nuigtush etsa ashí nugkanum etsanjati,","poem":1},{"lineBreak":true},{"text":"nunitai aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"suwenum uumjatnume","poem":1},{"lineBreak":true},{"text":"tusamek inachuitme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunú etsa etsantug jiinak","poem":1},{"lineBreak":true},{"text":"nugkanak jáanch kapantuama iman emawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nunitai aents pegkegchau takau aidauk","poem":1},{"lineBreak":true},{"text":"kashi uumak takamin asag,","poem":1},{"lineBreak":true},{"text":"nunikchamin dekapenak idayinawai,","poem":1},{"lineBreak":true},{"text":"wagki tsawai nuniagtaik,","poem":1},{"lineBreak":true},{"text":"achika suwimak suwam amain asag.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¿Tuja yumish tuwiyag jiinua","poem":1},{"lineBreak":true},{"text":"nunú wainkatasamesh,","poem":1},{"lineBreak":true},{"text":"amesh nayantsa initkenish jegamkayum?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¿Amesh aents jakau aidau","poem":1},{"lineBreak":true},{"text":"batsamtain jegamesh wainkaukaitam?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¿Tuja nugkash wajupa múuntaita","poem":1},{"lineBreak":true},{"text":"dusha dekamek?","poem":1},{"lineBreak":true},{"text":"¡Nunú ame dekakmek minash ujatkata!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¿Tuja tsaaptinush","poem":1},{"lineBreak":true},{"text":"suwejaish tuwi awa?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amek duka dekachu asam","poem":1},{"lineBreak":true},{"text":"tsaaptinuk emamaitsume,","poem":1},{"lineBreak":true},{"text":"tuja suweshkam emamaitsume.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Nunú aidaun wi najanauwaitag,","poem":1},{"lineBreak":true},{"text":"nunú tsawantinig eke","poem":1},{"lineBreak":true},{"text":"akiinchau asam atsuyume!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“¡Tuja wisha yujagminash bicha aidaujaish","poem":1},{"lineBreak":true},{"text":"tuwig ukuaja duka amek waintsume!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nunak maaninamunum","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidau suwimak suwaku,","poem":1},{"lineBreak":true},{"text":"yutumtijatnun ukusan pujugjai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¿Tuja peem peetish itug weawaki?","poem":1},{"lineBreak":true},{"text":"duka amek dekatsme.","poem":1},{"lineBreak":true},{"text":"¿Tuja dasesh etsa","poem":1},{"lineBreak":true},{"text":"minitaiya nuni dasenkash,","poem":1},{"lineBreak":true},{"text":"itusaya ashí nugkanash jajutuaki?","poem":1},{"lineBreak":true},{"text":"duka amek dekatsme.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¿Nugka taimunum","poem":1},{"lineBreak":true},{"text":"yumi saagama numamtuk","poem":1},{"lineBreak":true},{"text":"yumin yutumtikna dusha yaita?","poem":1},{"lineBreak":true},{"text":"tuja ¿yaita aents jintan inaktumaina numamtuk,","poem":1},{"lineBreak":true},{"text":"ipamat pati wetai jinta inaktinush? duka amek dekatsme.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Witjai nuna dutikaunuk,","poem":1},{"lineBreak":true},{"text":"tuja witjai uwejush aents makichkish atsamunum yutumtikaunuk,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"wagki nunú yutak nugka tutuptinnash","poem":1},{"lineBreak":true},{"text":"uchupjati, dutikam chijichig tsapaiti tusan dutikajai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yumi, nuigtu jegashik aina duka","poem":1},{"lineBreak":true},{"text":"aents apagtin aina nuninchau ainawai. ¡Witjai nuna najanaunuk!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bicha aidauk, tuja jegashik aidauk","poem":1},{"lineBreak":true},{"text":"aents dukugtin aina nuninchau ainawai.","poem":1},{"lineBreak":true},{"text":"¡Witjai nuna najankaunuk!","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"¡Witjai yuminak bichatin","poem":1},{"lineBreak":true},{"text":"kaya katsugma iman emaunuk,","poem":1},{"lineBreak":true},{"text":"tuja nayantsa awankenishkam bichatbikajan katsujam emauwaitjai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“¡Yaya aidau ijumnag ayá duka","poem":1},{"lineBreak":true},{"text":"ame dutikachuitme!","poem":1},{"lineBreak":true},{"text":"¡Tuja amechuitme yaya","poem":1},{"lineBreak":true},{"text":"ijumnaju aidau sutu tutai,","poem":1},{"lineBreak":true},{"text":"tunim tutai ditash","poem":1},{"lineBreak":true},{"text":"kanakag aina nunú umikumek!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuja ¿amekaitam","poem":1},{"lineBreak":true},{"text":"makichik yaya múun tsawak","poem":1},{"lineBreak":true},{"text":"etsanjati timawa nunú etsanmitkaum?","poem":1},{"lineBreak":true},{"text":"Tuja ¿amekaitam yaya ijumnaju aidau","poem":1},{"lineBreak":true},{"text":"Osa múun tutaya nunú,","poem":1},{"lineBreak":true},{"text":"Osa yaijuch tutaya nunujai","poem":1},{"lineBreak":true},{"text":"wantinkatnume tusam iwaidaum?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tuja yaya aidau, nantu aidau,","poem":1},{"lineBreak":true},{"text":"tikich aidau nayaimpinum ayá dusha ¿wajuk buchitainawaki?","poem":1},{"lineBreak":true},{"text":"duka amek anentaimsamek ejemaitsume.","poem":1},{"lineBreak":true},{"text":"¡Nuadui amek nunú aidau etsantug","poem":1},{"lineBreak":true},{"text":"nugkan tsaaptin ematnume","poem":1},{"lineBreak":true},{"text":"tusamek tumaitsume!","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"¿Amesh yumi yujagminmaya","poem":1},{"lineBreak":true},{"text":"yutak piyagti tusamesh tumainkaitam?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"¡Amek chaajip, peem aina duka,","poem":1},{"lineBreak":true},{"text":"amina inakmejai betek","poem":1},{"lineBreak":true},{"text":"umigtuktinme tusamek,","poem":1},{"lineBreak":true},{"text":"tikich yantamnum wetajum","poem":1},{"lineBreak":true},{"text":"tusamek tumaitsume!","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"¿Yaita atash ayumpan,","poem":1},{"lineBreak":true},{"text":"chigki aina nujai tsawantan dekapeak","poem":1},{"lineBreak":true},{"text":"shinin atinme tusa tiuwa dusha?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Wika yachaitag iman asan,","poem":1},{"lineBreak":true},{"text":"yujagmish wajupa ayawa nunak dekajai.","poem":1},{"lineBreak":true},{"text":"Tuja witjai yumi yutumtiknunuk.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Wi yumi yutumtikag nunak","poem":1},{"lineBreak":true},{"text":"nugka yukukuntua nunú chupija","poem":1},{"lineBreak":true},{"text":"achinig katsujam wajasti tusan dutikajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“¿Amekaitam león aidau","poem":1},{"lineBreak":true},{"text":"dita uchijin ayuja ututuakti tusam","poem":1},{"lineBreak":true},{"text":"yutaiji egatka suum?","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"¡León niina waajin uumak tepes,","poem":1},{"lineBreak":true},{"text":"nuniachkush dupanum","poem":1},{"lineBreak":true},{"text":"uumak tepesa, kuntinjin tsekenti","poem":1},{"lineBreak":true},{"text":"tepejuk maina duka ame dutikatsme!","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"¡Chuwagka uchiji aidau","poem":1},{"lineBreak":true},{"text":"yapajainak buutiagtai,","poem":1},{"lineBreak":true},{"text":"yutaijin mina segatuina","poem":1},{"lineBreak":true},{"text":"duka amek sumaitsume!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":41}