{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“¿Amesh dekamek cabra ikamia aina dusha","poem":1},{"lineBreak":true},{"text":"ejapjukajash, wajupa asag petsajawa?","poem":1},{"lineBreak":true},{"text":"Tuja ¿japa petsaidaush wainnukum?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Amek wajupa nantu asag","poem":1},{"lineBreak":true},{"text":"petsajawa duka dekatsme!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Japak petsaktinji tsawan jegajim,","poem":1},{"lineBreak":true},{"text":"uchijin najaimakug","poem":1},{"lineBreak":true},{"text":"nugká tepes petsauwai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dutika petsakam chichiag","poem":1},{"lineBreak":true},{"text":"ikam pujus muumpawai.","poem":1},{"lineBreak":true},{"text":"Nunik dukujin ukuak","poem":1},{"lineBreak":true},{"text":"kanaka yaja wenawai,","poem":1},{"lineBreak":true},{"text":"nunika ataktu wakitkig dukujinig tainatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“¿Ya burro ikamia aina nunash","poem":1},{"lineBreak":true},{"text":"waitkaschamu agtinme tusash tiuwaita?","poem":1},{"lineBreak":true},{"text":"¿Ya ditanash agkan","poem":1},{"lineBreak":true},{"text":"yujatnash susauwaita?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wi ditak uwegshunum,","poem":1},{"lineBreak":true},{"text":"nuigtu nugka paka","poem":1},{"lineBreak":true},{"text":"kachi tepaju asamtai,","poem":1},{"lineBreak":true},{"text":"dupa tsapachu aina nuwi","poem":1},{"lineBreak":true},{"text":"batsamsatnume tusan etegtuawaitjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja yaaktanmaya aidauk senchi pampainak dakitmain wajaidau asagmatai,","poem":1},{"lineBreak":true},{"text":"nuna dakituinak atushat batsatui,","poem":1},{"lineBreak":true},{"text":"nunidau asag aents aidau","poem":1},{"lineBreak":true},{"text":"burro tagkumamu aidaun inainak","poem":1},{"lineBreak":true},{"text":"jiyainamunashkam antuinatsui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nunik batsamas dita yuwatnujin","poem":1},{"lineBreak":true},{"text":"dupan egainak mujanum yujainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“¡Amek toro ikamia aina nunuwap","poem":1},{"lineBreak":true},{"text":"wi takatai yainkag, kiitai","poem":1},{"lineBreak":true},{"text":"mina tagkuju batsamtain","poem":1},{"lineBreak":true},{"text":"kajigkagtatua tusamek tumaitsume!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Tuja nugka pukugti tusamek","poem":1},{"lineBreak":true},{"text":"jigkaja emetuamek waitkamaitsume!","poem":1},{"lineBreak":true},{"text":"¡Nuigtush nugka pukugbaun","poem":1},{"lineBreak":true},{"text":"tsaikti tusamesh tumaitsume!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Nunú senchigtin ainakuishkam,","poem":1},{"lineBreak":true},{"text":"amek dita takagtustinme","poem":1},{"lineBreak":true},{"text":"tusamek ditakek idaimaitsume!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Ame ajakmamu aina","poem":1},{"lineBreak":true},{"text":"nunak ditaap juuka","poem":1},{"lineBreak":true},{"text":"ikaunma ijumjutjattawa","poem":1},{"lineBreak":true},{"text":"tusamek tumaitsume!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Avestruzak shiig aneak,","poem":1},{"lineBreak":true},{"text":"nanapen awagtumawai,","poem":1},{"lineBreak":true},{"text":"tujash avestruzak shiijak awajkagtuchui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja avestruzak kamatkan tai,","poem":1},{"lineBreak":true},{"text":"nuwi petsaka etsa sukuam, nimpak takiagti tusa pachitsuk idainai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja niig makichik aentskesh,","poem":1},{"lineBreak":true},{"text":"nuniachkush kuntinkesh dajag","poem":1},{"lineBreak":true},{"text":"tsaikchaintash tusag anentaimtsui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Avestruzak uchijinash","poem":1},{"lineBreak":true},{"text":"niina uchijichu itugmaina","poem":1},{"lineBreak":true},{"text":"numamtuk awagnai,","poem":1},{"lineBreak":true},{"text":"tuja megkaekachaintash","poem":1},{"lineBreak":true},{"text":"tusagkesh puyatjuchui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nunak nuniawai, wagki","poem":1},{"lineBreak":true},{"text":"wi unuimatan susachuitag nuadui,","poem":1},{"lineBreak":true},{"text":"tuja shiig jintiaja","poem":1},{"lineBreak":true},{"text":"anentaimtanashkam susachuitjai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Untsu nantaki tupikakug caballo aidaunak","poem":1},{"lineBreak":true},{"text":"aents nuwi entsatkau aidaujaí","poem":1},{"lineBreak":true},{"text":"juwiachu asamtai dushikiawai,","poem":1},{"lineBreak":true},{"text":"wagki nii ima senchi tupikau asa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“¿Amekaitam caballo","poem":1},{"lineBreak":true},{"text":"aidau senchimtikaum?","poem":1},{"lineBreak":true},{"text":"tuja ¿amekaitam caballo kuntujen","poem":1},{"lineBreak":true},{"text":"intash tumain pegkeg","poem":1},{"lineBreak":true},{"text":"ajuwama nunú najatuaum?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¿Manchi tsekegama imanik tsekeak,","poem":1},{"lineBreak":true},{"text":"senchi mayatak aentsun uwakna","poem":1},{"lineBreak":true},{"text":"nunú ameka dutikam?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Caballo aidauk maaniatasa ijumjamak","poem":1},{"lineBreak":true},{"text":"sapigmakas ejapkabiag,","poem":1},{"lineBreak":true},{"text":"aents niini entsatkau","poem":1},{"lineBreak":true},{"text":"aidau shiwagjai igkunia","poem":1},{"lineBreak":true},{"text":"maaniati tusa tupikauwame.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tuja suntag aidau maanitain yajuakag uminas ijunun wainkush,","poem":1},{"lineBreak":true},{"text":"ishamtsuk tupikatki jetegame.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja suntag aidau flecha chimpia jutain","poem":1},{"lineBreak":true},{"text":"caballo aenskam tupikainak","poem":1},{"lineBreak":true},{"text":"tatagtutaish, ishamchauwai.","poem":1},{"lineBreak":true},{"text":"Tuja nagki aidau, flecha aidau akenbau","poem":1},{"lineBreak":true},{"text":"winchantutaish, ishamchauwai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Maaniatatus uwija kachujin umpuiniagtaish,","poem":1},{"lineBreak":true},{"text":"caballo aidauk jasa ijunmainchau dekapenak,","poem":1},{"lineBreak":true},{"text":"tupikatiagtai, suntag nuwi entsatkau aidaushkam","poem":1},{"lineBreak":true},{"text":"kakajus emetmainchau dekapajame.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Maaniatnume tusa","poem":1},{"lineBreak":true},{"text":"uwija kachuji umpuamun","poem":1},{"lineBreak":true},{"text":"caballo aidau antuinakug,","poem":1},{"lineBreak":true},{"text":"aentsjai betek pampauwame,","poem":1},{"lineBreak":true},{"text":"tuja atushat ijuntsag","poem":1},{"lineBreak":true},{"text":"maaniamu ataik dekapeajame.","poem":1},{"lineBreak":true},{"text":"Tuja suntaja apuji aidau","poem":1},{"lineBreak":true},{"text":"dita suntajin chichajuinamunak,","poem":1},{"lineBreak":true},{"text":"suntag aidau pampaidaujai","poem":1},{"lineBreak":true},{"text":"atushat wajasag antinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Tuja pinchu aidau","poem":1},{"lineBreak":true},{"text":"yakí nanaak yujas","poem":1},{"lineBreak":true},{"text":"etsa minitaiya nuni yuja nunú","poem":1},{"lineBreak":true},{"text":"¿ameka amina yachagmin","poem":1},{"lineBreak":true},{"text":"nuniktinme tusam tiuwaitam?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuja ¿ameka ukukui aidau","poem":1},{"lineBreak":true},{"text":"yakí nanaak yujau atinme,","poem":1},{"lineBreak":true},{"text":"nuninak yakí kayanum pasugmakag","poem":1},{"lineBreak":true},{"text":"nuwi petsau atinme tusam tiuwaitam?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ukukuik yakí kayanum pujuuwai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú kaya yakí jiitkauwa nunuwai","poem":1},{"lineBreak":true},{"text":"nii pujusa ayamjumatai,","poem":1},{"lineBreak":true},{"text":"jega peejamua numamtina duka.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Imanui yakí pujus","poem":1},{"lineBreak":true},{"text":"yutaijin wainak akaetuki maa yuwame.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ukukuik tuwi jakau","poem":1},{"lineBreak":true},{"text":"tepawa nuna tuwajui,","poem":1},{"lineBreak":true},{"text":"tuja uchiji aidauk","poem":1},{"lineBreak":true},{"text":"nuna neje uduun yuwinak","poem":1},{"lineBreak":true},{"text":"shiig aneen ainawai”,","poem":1},"tiuwai Apajuí."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}