{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifaz Jopan ayaak chichakbau"]},{"type":"verse","number":1,"content":["Job chichaka inagnakmatai, Elifaz yama nagkamchak Jopan ayaak aatus tiuwai:"]},{"type":"verse","number":2,"content":[{"text":"“Makichik aentskesh aujtamsatag takuig,","poem":1},{"lineBreak":true},{"text":"kajegmainaitme.","poem":1},{"lineBreak":true},{"text":"Tujash chichatskek idaimainchau dekapeajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wika ame tikich aents aidau","poem":1},{"lineBreak":true},{"text":"jintintin aayum nunak dekajai.","poem":1},{"lineBreak":true},{"text":"Tuja aents kakaakchau aidaush","poem":1},{"lineBreak":true},{"text":"anentai ichichtin aayume.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aents wake besemag pujaush","poem":1},{"lineBreak":true},{"text":"ame niina anentai ichichtuyume.","poem":1},{"lineBreak":true},{"text":"Tuja aents jakatag taushkam","poem":1},{"lineBreak":true},{"text":"ame jakai tusam yaiyume.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amek sapigmamaitsume,","poem":1},{"lineBreak":true},{"text":"tuja yamai waitiam dushakam ishamaitsume.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Amek Apajuík tuké shiig umignaitme,","poem":1},{"lineBreak":true},{"text":"amek aents pujutji shiig pegkejaitme.","poem":1},{"lineBreak":true},{"text":"Imanmesh ¿wagka Apajuíyaish dekaskeapi tumaitsume?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents pegkeja takaun,","poem":1},{"lineBreak":true},{"text":"Apajuí kajejuk mauwai tabaush","poem":1},{"lineBreak":true},{"text":"antukuashitam, nunú anentaimsa diista.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuashat mijan pujau asan,","poem":1},{"lineBreak":true},{"text":"utugchatan wainka weakun dekajai,","poem":1},{"lineBreak":true},{"text":"aents magkagtak pegkegchaun takauk,","poem":1},{"lineBreak":true},{"text":"dutiksaik iikuam auwai.","poem":1},{"lineBreak":true},{"text":"Wagki duka aents nii ajakmamujinia","poem":1},{"lineBreak":true},{"text":"nejekun juuwama numamtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dita pegkegchaun takaidau asamtai,","poem":1},{"lineBreak":true},{"text":"Apajuí kajejuk dasejai betek umpui ijinui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidauk","poem":1},{"lineBreak":true},{"text":"ikamyawajai betek,","poem":1},{"lineBreak":true},{"text":"kajeak senchi shinak","poem":1},{"lineBreak":true},{"text":"tikich aentsun maatag tutaish,","poem":1},{"lineBreak":true},{"text":"Apajuí nunak ikamyawa nai kupijam itatama","poem":1},{"lineBreak":true},{"text":"numamtuk itatmitkaktatui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"León nii yuwatnujin","poem":1},{"lineBreak":true},{"text":"wainkacha jamaina numamtuk,","poem":1},{"lineBreak":true},{"text":"nunú aents aidauk jakagtatui.","poem":1},{"lineBreak":true},{"text":"Nunikagmatai dita uchiji aidauk","poem":1},{"lineBreak":true},{"text":"pampagkag megkaejagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Tikichish antuinatsaig","poem":1},{"lineBreak":true},{"text":"takamtak chicham tajutuae,","poem":1},{"lineBreak":true},{"text":"nuna takatkamat","poem":1},{"lineBreak":true},{"text":"shiig pegkejan antukjai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aents aidau kashi","poem":1},{"lineBreak":true},{"text":"kaja achiam kanuinai,","poem":1},{"lineBreak":true},{"text":"wika kanumainchau dekapjamjai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sapigmamu achigkame,","poem":1},{"lineBreak":true},{"text":"mina iyashjuk ashí kujaime.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mina yapijui dase","poem":1},{"lineBreak":true},{"text":"umpuntun dekapjamjai,","poem":1},{"lineBreak":true},{"text":"dutijakui iyashjui anchiajua nunin dekapmajai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Makichik aents nuwi wajame.","poem":1},{"lineBreak":true},{"text":"Nuna wi wainkamjai.","poem":1},{"lineBreak":true},{"text":"Tujash niimesh dekas wajukuki","poem":1},{"lineBreak":true},{"text":"nunak wainkachmajai;","poem":1},{"lineBreak":true},{"text":"ashí itatjamunum untsujak,","poem":1},{"lineBreak":true},{"text":"aatus tujutmae:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"‘Aents aidauk ashí jau ainawai.","poem":1},{"lineBreak":true},{"text":"Apajuík makichik aentsnakesh,","poem":1},{"lineBreak":true},{"text":"ametme chicham betek umiumek,","poem":1},{"lineBreak":true},{"text":"tusa tama amainuk shiig atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja ametme dekas","poem":1},{"lineBreak":true},{"text":"pegkegchau takamchaumek,","poem":1},{"lineBreak":true},{"text":"tama amainchakam shiig atsawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apajuík niina aentsji ángel aidaunakesh,","poem":1},{"lineBreak":true},{"text":"tikima shiig kajittsag diyatsui.","poem":1},{"lineBreak":true},{"text":"Apajuí diismak ditashkam","poem":1},{"lineBreak":true},{"text":"tikima pegkegmak ainatsui.’","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nuadui aents aidauk","poem":1},{"lineBreak":true},{"text":"ima pegkegnakek takainatsui.","poem":1},{"lineBreak":true},{"text":"Maki makichik aents aina duka,","poem":1},{"lineBreak":true},{"text":"nugka jegamkamua numamtin ainawai.","poem":1},{"lineBreak":true},{"text":"Jega jegamin aidau","poem":1},{"lineBreak":true},{"text":"nugka yukukuntunum apuja,","poem":1},{"lineBreak":true},{"text":"jegamaina numamtin ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui dase dasentai yumpunak,","poem":1},{"lineBreak":true},{"text":"nuwi mamuk ayaun","poem":1},{"lineBreak":true},{"text":"yutua emegkauwama numamtuk emegkam amainai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Aentsuk kashikmasagkesh,","poem":1},{"lineBreak":true},{"text":"nuniachkush agkugkesh jaka megkaewai.","poem":1},{"lineBreak":true},{"text":"Nunikmataish makichkish pachinatsui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Niina pujutig hilo yupichu tsujimaina numamtuk","poem":1},{"lineBreak":true},{"text":"tsujigkam megkaewai.","poem":1},{"lineBreak":true},{"text":"Aentsuk ashí unuimajag jatsui”, tiuwai Elifaz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}