{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Nuigtushkam Tuke Pujuu Jopan chichajak:"]},{"type":"verse","number":2,"content":[{"text":"“Witjai Apajuí ashí senchigtinun,","poem":1},{"lineBreak":true},{"text":"amek mina chicham patatjukume,","poem":1},{"lineBreak":true},{"text":"nuniakum umikchamna nunin diigsaume.","poem":1},{"lineBreak":true},{"text":"¿Dusha yamaish nunismekek anentaimam?","poem":1},{"lineBreak":true},{"text":"nunú yamai tujutta”, tiuwai.","poem":1}]},{"type":"verse","number":3,"content":["Tuke Pujuu nuna tusa inagnakmatai, Job ayaak:"]},{"type":"verse","number":4,"content":[{"text":"“¡Wisha wainkauchitag juninnush,","poem":1},{"lineBreak":true},{"text":"wajintuk aiktajame aminash!","poem":1},{"lineBreak":true},{"text":"Wi tumainuk makichkish atsugtawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wika kuashat chichakjai,","poem":1},{"lineBreak":true},{"text":"nuigtu tikich tumainuk atsugtawai”, tiuwai.","poem":1}]},{"type":"heading","content":["Apajuí Jopan ataktu awagki tibau"]},{"type":"verse","number":6,"content":["Tusa tama Tuke Pujuu dase senchi dasenbaunmaya ataktu Jopan chichajak:"]},{"type":"verse","number":7,"content":[{"text":"“¡Diik ibau wajiuwaitkumek,","poem":1},{"lineBreak":true},{"text":"sapigmatsuk wi amina","poem":1},{"lineBreak":true},{"text":"iniastatjam nunú aigkata!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Ame pegkeg jumamkum","poem":1},{"lineBreak":true},{"text":"mina pegkegchauwa nunin jujukiume!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Amekaitam mina nagkaetasu ima senchigtinum?","poem":1},{"lineBreak":true},{"text":"¿Ame chichamugmish","poem":1},{"lineBreak":true},{"text":"wi chichamu chaagpijai beteka ibaukai?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Nunú dekasketkuig, amina imanjum","poem":1},{"lineBreak":true},{"text":"senchigmejai iwainmamkata!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja imanika kajeakmek","poem":1},{"lineBreak":true},{"text":"katsuntu pujutsuk, aents","poem":1},{"lineBreak":true},{"text":"emebau aina nunú","poem":1},{"lineBreak":true},{"text":"suwimak susam inatsakta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kame ame ima pegkeg takau asam,","poem":1},{"lineBreak":true},{"text":"apu emebau aina duka diyamuik","poem":1},{"lineBreak":true},{"text":"dita inamtaiji aina nunú emegkatjata.","poem":1},{"lineBreak":true},{"text":"Tuja aents pegkegchau aina","poem":1},{"lineBreak":true},{"text":"duka tuwi ame waintatme,","poem":1},{"lineBreak":true},{"text":"dutikakum ijina utsagta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dutikam nugka taim ashí yutuata.","poem":1},{"lineBreak":true},{"text":"Dutikawamin magkagtin aidau","poem":1},{"lineBreak":true},{"text":"achikam chimpimama numamtuk,","poem":1},{"lineBreak":true},{"text":"aents jinau aidau","poem":1},{"lineBreak":true},{"text":"batsatbaunum batsamsatnume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nunú dutikawamin,","poem":1},{"lineBreak":true},{"text":"niina senchijiniap imanik depetmake titajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Amesh kuntin múun","poem":1},{"lineBreak":true},{"text":"Behemot tutaiya nunú","poem":1},{"lineBreak":true},{"text":"anentaimtusa diista.","poem":1},{"lineBreak":true},{"text":"Wi nunú kuntinun najanauwaitag","poem":1},{"lineBreak":true},{"text":"dutiksanuk aminashkam najanawaitjame.","poem":1},{"lineBreak":true},{"text":"Nunú kuntinuk bueyejai betek dupan yuwai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Niina senchiji aina duka","poem":1},{"lineBreak":true},{"text":"tuntupega nuwi ashí ajawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Untsu ujekeg setug katsugma imanai.","poem":1},{"lineBreak":true},{"text":"Tuja yaape nawen achitjau aidaushkam,","poem":1},{"lineBreak":true},{"text":"daek chapikmagbaujai","poem":1},{"lineBreak":true},{"text":"betek kampujam ainawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja ukunchi aidauk,","poem":1},{"lineBreak":true},{"text":"tubo jiju bronce tutai najanamua imanai.","poem":1},{"lineBreak":true},{"text":"Untsu bakui aidauk jiju hierro tutai","poem":1},{"lineBreak":true},{"text":"katsugma iman ainawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wi kuntin aidaun najankauwaitag","poem":1},{"lineBreak":true},{"text":"nujai ijumja diismash,","poem":1},{"lineBreak":true},{"text":"nunú kuntinun nagkaesauk","poem":1},{"lineBreak":true},{"text":"tikichik atsawai.","poem":1},{"lineBreak":true},{"text":"Nunú kuntinu maumainuk makichkish atsawai,","poem":1},{"lineBreak":true},{"text":"ima wiki maumainaitjai,","poem":1},{"lineBreak":true},{"text":"wagki wi niinak najadau asan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nunú kuntinuk chijichin yusa pujuuwai,","poem":1},{"lineBreak":true},{"text":"nuadui ibau múun senchigtin ataish,","poem":1},{"lineBreak":true},{"text":"tikich kuntin aina duka ishamainatsui.","poem":1},{"lineBreak":true},{"text":"Tuja nii chijichin yuwak tepetai,","poem":1},{"lineBreak":true},{"text":"tikich kuntin aidauk nuna tentea","poem":1},{"lineBreak":true},{"text":"batsamas wasugkamin ainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuja ayamsatag takug","poem":1},{"lineBreak":true},{"text":"numi jagkigtin loto tutai aina","poem":1},{"lineBreak":true},{"text":"nuna wakentin tepenai,","poem":1},{"lineBreak":true},{"text":"nuniachkush kuchanum tagkan ayaunum","poem":1},{"lineBreak":true},{"text":"waigka uumak tepenai bichatjatatus.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Numi loto tutai aina","poem":1},{"lineBreak":true},{"text":"nuna kanawe bikintu emamunum,","poem":1},{"lineBreak":true},{"text":"tuja numi álamo tutai","poem":1},{"lineBreak":true},{"text":"entsa akaebaunum tsapaka bikintu emamunum nuwi waig tepenai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nujag senchi dujajutaish ishamchauwai.","poem":1},{"lineBreak":true},{"text":"Tuja nujag dujajua utugmashkam","poem":1},{"lineBreak":true},{"text":"ishamtsuk tepenai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nunú kuntinun makichik aentskesh achika,","poem":1},{"lineBreak":true},{"text":"jii ukuituk wainmachu emamainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Nuigtush nujiin tigkajua daekai wegak anaa","poem":1},{"lineBreak":true},{"text":"emetmainuk atsawai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}