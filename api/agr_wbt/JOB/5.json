{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOB","translationId":"agr_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":13,"sha256":"4bbabe51c1f22d102d7bde199c20223a582e03c3b7dce2a858da650c2c014b86","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/agr_wbt/JOB/42.json","totalNumberOfVerses":334},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“¡Senchi untsumkata Jopah!","poem":1},{"lineBreak":true},{"text":"¡Makichik aentskesh aipakchatpash,","poem":1},{"lineBreak":true},{"text":"nunú antukmi!","poem":1},{"lineBreak":true},{"text":"Ame yainkati tusa","poem":1},{"lineBreak":true},{"text":"segamainuk ángelak atsawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aents pegkegchauwa duka,","poem":1},{"lineBreak":true},{"text":"Apajuíjai shiwagmagau asa jawai,","poem":1},{"lineBreak":true},{"text":"aents shiig anentaimkachunak,","poem":1},{"lineBreak":true},{"text":"kajegkagtutaijiya nunú maawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wi wainjai aents pegkegchau aidau,","poem":1},{"lineBreak":true},{"text":"kuashat wajiigtin wedaun,","poem":1},{"lineBreak":true},{"text":"tujash machik asag","poem":1},{"lineBreak":true},{"text":"wamak niina jeen atantuinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Niina uchiji aidaun, nawanji aidaun,","poem":1},{"lineBreak":true},{"text":"kuitamjumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Apu chichama epegkin aidaush","poem":1},{"lineBreak":true},{"text":"tuke aneas waitkainawai,","poem":1},{"lineBreak":true},{"text":"ditá ayamjumainuk atsawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ajakmamujinash kuitamjuinatsui,","poem":1},{"lineBreak":true},{"text":"nuadui aents nujantai jinuidau nuna yujuinawai,","poem":1},{"lineBreak":true},{"text":"dutikainak jagkinmayanash","poem":1},{"lineBreak":true},{"text":"akuumtuk yujajus yajutuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja wajiji aidaun diigsag,","poem":1},{"lineBreak":true},{"text":"imanun jukitag tinu aidau","poem":1},{"lineBreak":true},{"text":"kasajuk yajutuinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wake besemag dekapeamua duka","poem":1},{"lineBreak":true},{"text":"ajakjai betekak nugkayag tsapatsui.","poem":1},{"lineBreak":true},{"text":"Tuja waitiamua dushakam","poem":1},{"lineBreak":true},{"text":"nugkanmayag tsapatsui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jii kegaunmaya kaiji","poem":1},{"lineBreak":true},{"text":"tsachigtuk shimuwama","poem":1},{"lineBreak":true},{"text":"numamtuk aentsuk","poem":1},{"lineBreak":true},{"text":"waittsatatus akiinainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Wika ametkunuk","poem":1},{"lineBreak":true},{"text":"Apajuí yainkati tusan segamainaitjai,","poem":1},{"lineBreak":true},{"text":"tuja wi waitiamua nunak","poem":1},{"lineBreak":true},{"text":"Apajuín idaitumainaitjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Apajuí iwainawai kuashat waji wainchatai ishamain aidaun,","poem":1},{"lineBreak":true},{"text":"tuja nunash wajuk dutikawaki nuna","poem":1},{"lineBreak":true},{"text":"dekaa ejemainuk makichkish atsawai!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apajuí yuminak nugká yutumtikawai,","poem":1},{"lineBreak":true},{"text":"nunú yumi yutak ajak aidaun ukatui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apajuík aents kakagchauch aidaun","poem":1},{"lineBreak":true},{"text":"eme anentai emawai.","poem":1},{"lineBreak":true},{"text":"Tuja aents patayi jajukam","poem":1},{"lineBreak":true},{"text":"wake besemag pujaunashkam","poem":1},{"lineBreak":true},{"text":"anentain ichishtawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aents pegkegchaun dutikatasa","poem":1},{"lineBreak":true},{"text":"anentaimas umiaunash Apajuí yapagtinai.","poem":1},{"lineBreak":true},{"text":"Dutika yapagtuam wainak nagkaanui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aents niina yachajin pegkegchaun","poem":1},{"lineBreak":true},{"text":"dutikatatus umiaunash","poem":1},{"lineBreak":true},{"text":"nii umiamujinig pempegki ajua emegkainai,","poem":1},{"lineBreak":true},{"text":"dutikak nii anentaimtugbaun yapagtuam wainak nagkanui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tikichin pegkegchaun","poem":1},{"lineBreak":true},{"text":"takamtiksatatus yuja duka,","poem":1},{"lineBreak":true},{"text":"kashi numi tukumka iyaumaina","poem":1},{"lineBreak":true},{"text":"numamtuk wajainawai.","poem":1},{"lineBreak":true},{"text":"Tsawai aentsun tsanuina dushakam,","poem":1},{"lineBreak":true},{"text":"wainmachujai betek ainawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Untsu Apajuík aents kakaakchau","poem":1},{"lineBreak":true},{"text":"niina shiwaaji waitkam pujaunash,","poem":1},{"lineBreak":true},{"text":"nii ayamjuk uwemtikawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja aents kakaakchau aina duka,","poem":1},{"lineBreak":true},{"text":"Apajuí ayamjutuk","poem":1},{"lineBreak":true},{"text":"uwemtijugti tusa dakainawai.","poem":1},{"lineBreak":true},{"text":"Apajuík aents pegkegchau aina nunú,","poem":1},{"lineBreak":true},{"text":"tikich aents kakaakchau aina nuna,","poem":1},{"lineBreak":true},{"text":"kuntin yutaijin, yuwa amuwama","poem":1},{"lineBreak":true},{"text":"numamtuk amukti tusag idaitsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Nuadui aminak Apajuí","poem":1},{"lineBreak":true},{"text":"suwimkan amasmatai waitiau asam,","poem":1},{"lineBreak":true},{"text":"¡amek shiig aneasta!","poem":1},{"lineBreak":true},{"text":"Apajuí ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"jintinjamak aikagma nunú dakitjaipa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja nii jata amasmatai jam nunashkam,","poem":1},{"lineBreak":true},{"text":"nigki etsaentamjattawai.","poem":1},{"lineBreak":true},{"text":"Tuja nii waittsati tujamatai","poem":1},{"lineBreak":true},{"text":"waitiaminchakam, nigki yaimpaktatui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ame ishamainnum pujutaish,","poem":1},{"lineBreak":true},{"text":"nigka kuashta aminak","poem":1},{"lineBreak":true},{"text":"agkanmitkagmattawai.","poem":1},{"lineBreak":true},{"text":"Tuja pegkegchauwa nunú","poem":1},{"lineBreak":true},{"text":"waitkasti tusag idaitamsashtatui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nujan tepeamtaish","poem":1},{"lineBreak":true},{"text":"nujantai jakai tusa yaimpaktatui,","poem":1},{"lineBreak":true},{"text":"tuja maaniamunmash","poem":1},{"lineBreak":true},{"text":"nii ayamjutpaktatui mantamawainum tusa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Amina pegkegchaun","poem":1},{"lineBreak":true},{"text":"chichagtamainakuish ishamkagtukaipa,","poem":1},{"lineBreak":true},{"text":"duka makichkish uminkashtatui,","poem":1},{"lineBreak":true},{"text":"wagki aminak Apajuí kuitamjamui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nujantaikish, nuniachkumesh","poem":1},{"lineBreak":true},{"text":"senchi waitiakmesh,","poem":1},{"lineBreak":true},{"text":"amek duka dushiksam diitnaitme.","poem":1},{"lineBreak":true},{"text":"Tuja kuntin ikamia kajen aina dushakam ishamkashtinaitme.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ame ajagminig utugchat atsaunum","poem":1},{"lineBreak":true},{"text":"agkan shiig takastatme,","poem":1},{"lineBreak":true},{"text":"wagki ajagminig kaya awatmainkesh","poem":1},{"lineBreak":true},{"text":"atsau pegkeg atinai.","poem":1},{"lineBreak":true},{"text":"Tuja kuntin kajen ikamia aina duka","poem":1},{"lineBreak":true},{"text":"makichkish jetepakchagtinai,","poem":1},{"lineBreak":true},{"text":"duka ayatak amina kumpajum agtatui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuadui amina jeminig","poem":1},{"lineBreak":true},{"text":"utugchat atsau pujustinaitme,","poem":1},{"lineBreak":true},{"text":"tuja amina tagkujum aidauk","poem":1},{"lineBreak":true},{"text":"makichkish megkaekashtinai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuja amina uchijum","poem":1},{"lineBreak":true},{"text":"wegantu aidauk shiig kuashat dupa ikam ayá iman agtinai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Trigo ajakbau tsawanji jegamtai,","poem":1},{"lineBreak":true},{"text":"pegkejan tsamaka uminas aama","poem":1},{"lineBreak":true},{"text":"numamtuk amek múuntuch wajasam","poem":1},{"lineBreak":true},{"text":"jatanum jegamesh","poem":1},{"lineBreak":true},{"text":"senchigtin, pegkeg pujutnaitme.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kuashat mijan pujau asan,","poem":1},{"lineBreak":true},{"text":"utugchat nagkaetujua","poem":1},{"lineBreak":true},{"text":"nunak shiig dekajai.","poem":1},{"lineBreak":true},{"text":"Nuadui atak nagkaemagtinun tajam","poem":1},{"lineBreak":true},{"text":"nunak dekaskenum tajai.","poem":1},{"lineBreak":true},{"text":"Nijah, juju wi tajam nunú","poem":1},{"lineBreak":true},{"text":"dekaskeapi takumek dekapsata”,","poem":1},"tusa Elifaz Jopan tiuwai. Elifaz, Bildad, Sofar, aatus Jopan ausajui. Dutikam Job inagnak ditan ayaak aatus tiuwai:"]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}