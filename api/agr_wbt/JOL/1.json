{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOL","translationId":"agr_wbt","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"da38e427f75678286eb08c0ba1a8d1d69805f51ac31a8f3e03f8ef609242c076","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/JOL/3.json","totalNumberOfVerses":62},"chapter":{"number":1,"content":[{"type":"heading","content":["Manchi ajakan amukbau"]},{"type":"verse","number":1,"content":["Joel Petuelan uchiji aajakua nuna Apajuí Israel aents aidaun ujakti tusa akateak aatus tiuwai:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Atum chichaman jintinkagtin múun aidautijum","poem":1},{"lineBreak":true},{"text":"juju shiig antuktajum,","poem":1},{"lineBreak":true},{"text":"tuja ashí aents aidautigmeshkam antuktajum.","poem":1},{"lineBreak":true},{"text":"¡Ipak usumta imajin manchi maki makichik niimtin","poem":1},{"lineBreak":true},{"text":"aidau kakegak iina ajake aidaunak","poem":1},{"lineBreak":true},{"text":"tikich manchi aidau amuak ukubaun ashí amutjamkaji!","poem":1},{"lineBreak":true},{"text":"Tuja ¿atumesh wajutiya junin wantinush wainkauwaitjume?","poem":1},{"lineBreak":true},{"text":"Yaunchuk atumi muunjum aidau","poem":1},{"lineBreak":true},{"text":"batsamajaku aina duka makichkish","poem":1},{"lineBreak":true},{"text":"junin wantinunak wainkachu ainawai.","poem":1},{"lineBreak":true},{"text":"¡Nuadui atumi uchijum aidau nunú pachisjum ujaktajum,","poem":1},{"lineBreak":true},{"text":"tuja dita ujaktinme dita uchiji aidaun,","poem":1},{"lineBreak":true},{"text":"nuna uchiji aidau ujaktinme dita uchiji aidaun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Nampen aidauwah, nantagtajum,","poem":1},{"lineBreak":true},{"text":"vino umin aidautigmek buuttajum,","poem":1},{"lineBreak":true},{"text":"atum vino umumainuk atsuttawai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manchi shiig kuashat,","poem":1},{"lineBreak":true},{"text":"suntag maaniatatus shimaujai betek","poem":1},{"lineBreak":true},{"text":"iina nugkeen untsaantugmae.","poem":1},{"lineBreak":true},{"text":"Nuna nai aidauk shiig empek asag,","poem":1},{"lineBreak":true},{"text":"león kajenun naíya iman ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iman asag uva ajakbau aidaunak higo ajakbau aidaujai ashí tsupije.","poem":1},{"lineBreak":true},{"text":"Imatikau asa kanawe aidaunak ashí pakajug saeptuchu emake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imatikau asamtai, nuwa nii aishinatag tibau jakamtai,","poem":1},{"lineBreak":true},{"text":"wake besemag pujaku nugkutain nugkuja","poem":1},{"lineBreak":true},{"text":"buutama imanikag,","poem":1},{"lineBreak":true},{"text":"aents aidauk makichkish etsagmainchau buutuinak","poem":1},{"lineBreak":true},{"text":"jakamunum nugkutain nugkuinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja Apajuí anentag suwaku vino, trigo,","poem":1},{"lineBreak":true},{"text":"cebada ejemainuk atsutai,","poem":1},{"lineBreak":true},{"text":"jega Apajuí emematku ijuntainmag","poem":1},{"lineBreak":true},{"text":"ejegainachu asamtai, sacerdote aidaushkam buutuinawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ajanum ajak ayauk kagaka asae,","poem":1},{"lineBreak":true},{"text":"imaniku asamtai trigok, vinok, aceitek makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Tuja nugkak uwejush tutuptina nunin","poem":1},{"lineBreak":true},{"text":"wake besemag wajas asae.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Atum ajanum takau aidautigmek,","poem":1},{"lineBreak":true},{"text":"uva ajakbaunum takau aidautigmek,","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeakjum buuttajum.","poem":1},{"lineBreak":true},{"text":"Atumek trigo cebadajai ashí jinaamtai,","poem":1},{"lineBreak":true},{"text":"shiig wainka juwakugme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uva aidau, higo aidau, munchi aidau, palmera aidau,","poem":1},{"lineBreak":true},{"text":"manzana aidau, tikich numi aidau aatus","poem":1},{"lineBreak":true},{"text":"ashí jinaamtai, aents aidauk buutuinawai.","poem":1},{"lineBreak":true},{"text":"Nuninak shiig aneamunak idayinak","poem":1},{"lineBreak":true},{"text":"wake besemag batsatui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vino, trigo, cebada aina duka atsau asamtai,","poem":1},{"lineBreak":true},{"text":"aents aidauk Apajuínak anentag ejetuinatsui.","poem":1},{"lineBreak":true},{"text":"Nuadui Apajuí emematku ijuntainmak makichkish atsawai.","poem":1},{"lineBreak":true},{"text":"Nunú diisjum atum sacerdote Apajuí altarjin","poem":1},{"lineBreak":true},{"text":"takau aidautigmek wake besemag pujaku nugkutai","poem":1},{"lineBreak":true},{"text":"jáanch nugkugjum kashi buu buutkawajum tsawaitajum.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuniakjum Apajuí emematku ijuntainum","poem":1},{"lineBreak":true},{"text":"apu múun aidau ashí Israel aents aidaujai ijumjatajum.","poem":1},{"lineBreak":true},{"text":"Dutikajum, ijagma pujusjum Apajuí ausatajum.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Apajuí taatnuk namput wajaschae!","poem":1},{"lineBreak":true},{"text":"¡Tsawan ishamain atina duka ashí jegawai!","poem":1},{"lineBreak":true},{"text":"¡Pegkegchau takat idaiku Apajuí umigtsujinig,","poem":1},{"lineBreak":true},{"text":"Apajuí ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"suwimak ishamainun amastatui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ii yuwatin agmaya nunak manchi aidau","poem":1},{"lineBreak":true},{"text":"iish wainjinig dukeen amutuk ijinae.","poem":1},{"lineBreak":true},{"text":"Nuadui Apajuí emematku ijuntainum","poem":1},{"lineBreak":true},{"text":"shiig aneasa takau ayag duka nunimainchau wajasji.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Trigo ajakbau aidauk, yumi yutushtai ashí jinae,","poem":1},{"lineBreak":true},{"text":"nuadui juuka yumain shiig atsau asamtai,","poem":1},{"lineBreak":true},{"text":"trigo chimpitai aidauk","poem":1},{"lineBreak":true},{"text":"wainak batsamas mamuka utsanui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Iina bakaji aidauk buutuinawai!","poem":1},{"lineBreak":true},{"text":"¡Uwig aidaushkam buutuinawai!","poem":1},{"lineBreak":true},{"text":"¡Tagku aidauk yumainji chijichi atsutai,","poem":1},{"lineBreak":true},{"text":"nujantai jinuinawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tuja jii kegak dupa aidaunak, numi aidaunashkam apea ijinae.","poem":1},{"lineBreak":true},{"text":"¡Apajuíjuh, wait aneasam yaijatkata!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Entsa aidauk kuyuka buku waigke,","poem":1},{"lineBreak":true},{"text":"tuja jii kegak dupanak ashí ijinae.","poem":1},{"lineBreak":true},{"text":"¡Imanikmatai kuntin ikamia aidaushkam","poem":1},{"lineBreak":true},{"text":"Apajuí yaimpakti tusag ima aminak segapainawai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":18}