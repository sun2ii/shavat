{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOL","translationId":"agr_wbt","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"da38e427f75678286eb08c0ba1a8d1d69805f51ac31a8f3e03f8ef609242c076","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/JOL/3.json","totalNumberOfVerses":62},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"¡Jerusalégnum uwija kachuji umpuagtajum!","poem":1},{"lineBreak":true},{"text":"¡Adeagtinme tusa umputai Tuke Pujuu emematku","poem":1},{"lineBreak":true},{"text":"ijuntainum umpuagtajum!","poem":1},{"lineBreak":true},{"text":"Nuna antuinak ashí aents aidau","poem":1},{"lineBreak":true},{"text":"Judá nugken batsamin aidauk sapigmainak kujaitnume,","poem":1},{"lineBreak":true},{"text":"wagki Tuke Pujuu taatin tsawan ashí jegae.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunú tsawanta duka suwe atinai,","poem":1},{"lineBreak":true},{"text":"nunú tsawantinig yujagkim suwe wajastinai.","poem":1},{"lineBreak":true},{"text":"Suntag aidau shiig kuashat depetmainchau","poem":1},{"lineBreak":true},{"text":"muja aidaunum shiyaktatui,","poem":1},{"lineBreak":true},{"text":"nunikag etsa kashikmas yama jiinak etsantug,","poem":1},{"lineBreak":true},{"text":"ashí mujan patamtuwama numamtuk","poem":1},{"lineBreak":true},{"text":"ashí nugkan pampankattawai.","poem":1},{"lineBreak":true},{"text":"Duka yaunchkesh imanuk wainkachbauwai,","poem":1},{"lineBreak":true},{"text":"tuja atakea duish imanuk wainnakchatnai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunú iman aina duka jii kegaujai betek asa,","poem":1},{"lineBreak":true},{"text":"nii juwi taatatus minakug ashí apea nagkaemawai.","poem":1},{"lineBreak":true},{"text":"Nunú tatsaigkik nugkak shiig pegkeg ayi,","poem":1},{"lineBreak":true},{"text":"nunú taamtai nagkamas nugkak uwegshujai betek wajase.","poem":1},{"lineBreak":true},{"text":"¡Nuna uwemtumainuk makichkish atsawai!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunú manchi aina duka","poem":1},{"lineBreak":true},{"text":"aents caballonum maanitan yacha aidau","poem":1},{"lineBreak":true},{"text":"maaniamunum jetejatmaina imanik utsantawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikam utsaana tsekeamuji antamak","poem":1},{"lineBreak":true},{"text":"carro maanitai shimak wajukama imatui,","poem":1},{"lineBreak":true},{"text":"duka kagaku apeam tsachigtuwama imatui,","poem":1},{"lineBreak":true},{"text":"suntag shiig kuashat ijunag uminas","poem":1},{"lineBreak":true},{"text":"shiwaajin jetektatus ijunama imanai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nunú manchi aina duka kasajai betek","poem":1},{"lineBreak":true},{"text":"jeganum wakag niimtai ujaimua nuni utsanui.","poem":1},{"lineBreak":true},{"text":"Suntag aidaujai betek yaakat peejamunash","poem":1},{"lineBreak":true},{"text":"tujintsuk pachiachbaunum yaaktan utsantawai.","poem":1},{"lineBreak":true},{"text":"Nunidau asag dita shimamunak nunisag","poem":1},{"lineBreak":true},{"text":"makichkish tunitsuk, shitanitnash shitanitsuk,","poem":1},{"lineBreak":true},{"text":"ukunmakesh wakettsuk shimutui.","poem":1},{"lineBreak":true},{"text":"Tuja akentai aidaun shiig kuashat aketmash","poem":1},{"lineBreak":true},{"text":"ditak nunisag shimawai.","poem":1},{"lineBreak":true},{"text":"Imanik manchi minidaun wainkag","poem":1},{"lineBreak":true},{"text":"aents aidauk senchi ishamainak yapinig puju wajasag kujainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tuja nugkak nayaimpijai senchi uujui,","poem":1},{"lineBreak":true},{"text":"nunitai etsa, nantu kajinag suwe wajase.","poem":1},{"lineBreak":true},{"text":"Tuja yaya aidaushkam etsantainatsui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuke Pujuu niina suntaji aidaujai minak","poem":1},{"lineBreak":true},{"text":"chichamujig ipamtajai betek wajawai,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu suntajig senchigtin ainawai,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu tabaun umin aidauk","poem":1},{"lineBreak":true},{"text":"shiig kuashat dekapamainchau ainawai.","poem":1},{"lineBreak":true},{"text":"¡Tsawan Apajuí minamuk ishamain atatui!","poem":1},{"lineBreak":true},{"text":"¡Imanun atsaneg pujumainuk makichkish atsawai!","poem":1}]},{"type":"heading","content":["Tuke Pujuu niina aentsji aidaun wait anentamu"]},{"type":"verse","number":12,"content":[{"text":"Tujash Tuke Pujuu yamai juna aatus tawai:","poem":1},{"lineBreak":true},{"text":"“Atum pegkegchau takajum duka","poem":1},{"lineBreak":true},{"text":"idaisajum atumi anentaimijai umigtuktajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum ijagma pujusjum buutkujum Apajuí ausatajum.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Pegkegchau takatak idaikujum","poem":1},{"lineBreak":true},{"text":"mina umigtuktajum!","poem":1},{"lineBreak":true},{"text":"Wake besemag dekapeakjum,","poem":1},{"lineBreak":true},{"text":"jáanchjum japiki ichí yujatsuk","poem":1},{"lineBreak":true},{"text":"atumek pempeentumakjum kajegmamkatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum dekas dewakjapi tumamtajum.","poem":1},{"lineBreak":true},{"text":"Wika kakagchauch wait anenkagtinaitjai.","poem":1},{"lineBreak":true},{"text":"Wika wamak kajechuitjai, nuadui wika","poem":1},{"lineBreak":true},{"text":"tsagkugkagtugtasan pujajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuniagminish nii suwimkan amastag tiu akush tsagkugtamag","poem":1},{"lineBreak":true},{"text":"trigon, vinon nii anentag susatnun shiig kuashat amaschajaintash.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“¡Jerusalégnum uwija kachuji umpuagtajum!","poem":1},{"lineBreak":true},{"text":"¡Ashí aents aidau ijumjatajum!","poem":1},{"lineBreak":true},{"text":"¡Múuntuch aidau, uchi aidau,","poem":1},{"lineBreak":true},{"text":"uchi muntsu muntsuaku aidaushkam,","poem":1},{"lineBreak":true},{"text":"tuja yama nuwedau aidaushkam jegá batsataidauk ashí kaunatnume!","poem":1},{"lineBreak":true},{"text":"Nunikagmatai ijagma pujusjum pegkegchau takat","poem":1},{"lineBreak":true},{"text":"idaisajum umintsatajum Apajuí ememattasajum.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sacerdote aidaushkam kaunatnume,","poem":1},{"lineBreak":true},{"text":"nunikag altarnum jeganta wajasag","poem":1},{"lineBreak":true},{"text":"buutuinak aatus Apajuín segatnume:","poem":1},{"lineBreak":true},{"text":"“¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina aentsjum aidau tsagkujata,","poem":1},{"lineBreak":true},{"text":"makichik aentskesh ditan dushijati tusamek idaisaipa!","poem":1},{"lineBreak":true},{"text":"¡Tuja tikich aents aidau depetkatnume tusamesh idaisaipa!","poem":1},{"lineBreak":true},{"text":"Aents tudau aidau tuke aneasag inimpainak:","poem":1},{"lineBreak":true},{"text":"‘¿Atumi Apajuíjish wajukame?’ tusag dushiki","poem":1},{"lineBreak":true},{"text":"batsamtinme tusamek idaisaipa”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tusa imatjumin Apajuí juju nugka juna aneau asa,","poem":1},{"lineBreak":true},{"text":"wait anenjamag chichagtamak:","poem":1},{"lineBreak":true},{"text":"“Juju shiig antuktajum:","poem":1},{"lineBreak":true},{"text":"Trigon, vinon, aceiten shiig kuashat amastatjime,","poem":1},{"lineBreak":true},{"text":"dutikamtai nunú yuwakjum","poem":1},{"lineBreak":true},{"text":"shiig aneasjum pujustatjume.","poem":1},{"lineBreak":true},{"text":"Ataktu awagkinuk tikich aents aidau","poem":1},{"lineBreak":true},{"text":"dushiktai atinme tusanuk idaisashtatjime.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nujinmaya aidau manchijai betek","poem":1},{"lineBreak":true},{"text":"atumin ajaantugmatsuk jetepakaja nunak","poem":1},{"lineBreak":true},{"text":"uwegshunum utsagtatjai.","poem":1},{"lineBreak":true},{"text":"Untsu igku jetepaktata nunak,","poem":1},{"lineBreak":true},{"text":"nayants jakau tutaya nuwi utsaan ijinattajai.","poem":1},{"lineBreak":true},{"text":"Tuja ukuunum jetepaktata nunak","poem":1},{"lineBreak":true},{"text":"nayants mediterraneonum utsaan ijinattajai.","poem":1},{"lineBreak":true},{"text":"¡Dutika ai nunú kauja senchi mejettawai!","poem":1},{"lineBreak":true},{"text":"“Mina aentsug juju nugkanum batsatutigmek","poem":1},{"lineBreak":true},{"text":"ishamkagtukaigpa, ayatak shiig aneastajum,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu atumin ayamjutpak, yaunchkesh","poem":1},{"lineBreak":true},{"text":"wainkachbau aidaun iwainaktatui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kuntin ikamia aidautigmesh,","poem":1},{"lineBreak":true},{"text":"¡ishamkagtukaigpajum!","poem":1},{"lineBreak":true},{"text":"¡Ataktu chijichi tsapaktatui!","poem":1},{"lineBreak":true},{"text":"Numi aidaushkam kuashat nejeagtatui,","poem":1},{"lineBreak":true},{"text":"tuja uva aidaush, higo aidaush shiig kuashat aittawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Atum Jerusalégnumia aidautigmek","poem":1},{"lineBreak":true},{"text":"shiig aneasjum Tuke Pujuu atumi Apajuíjum emematkujum","poem":1},{"lineBreak":true},{"text":"kuntin maajum apeatajum!","poem":1},{"lineBreak":true},{"text":"Apajuí yaunchuk yumin yutumtikjauwa dutiksag","poem":1},{"lineBreak":true},{"text":"yamaishkam yumi yutugtin jegamtai yutumtijattawai.","poem":1},{"lineBreak":true},{"text":"Niina anenken iwaintugmak yagkug yagkujut aig","poem":1},{"lineBreak":true},{"text":"yumi yutut tepeamtai yutuwama nujai betek yutumtijattawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuadui trigo, vino, aceite, shiig kuashat aittawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Atumi ajaji aidaun manchi amukmatai,","poem":1},{"lineBreak":true},{"text":"tuja shiwag aidau tsaigtamkamtai, ajakjinchau","poem":1},{"lineBreak":true},{"text":"wajasujum nunak Apajuí yaunchuk aajakua imanuk awajtugmastatui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Atumek shiig yuwajum pujusjum","poem":1},{"lineBreak":true},{"text":"Apajuí ememattinaitjume,","poem":1},{"lineBreak":true},{"text":"wagki nii atumin ayamjutpak","poem":1},{"lineBreak":true},{"text":"wainchatai ishamain aidaun kuashat iwainajui.","poem":1},{"lineBreak":true},{"text":"Nuadui niina aentsji aidauk wainka inatsamak yujashtinai.","poem":1},{"lineBreak":true},{"text":"“Witjai Israel aents aidaun Apajuíjinuk,","poem":1},{"lineBreak":true},{"text":"wika mina aentsug aidaujai pujajai.","poem":1},{"lineBreak":true},{"text":"Nuadui ima wiki dita Apajuíjig atinaitjai.","poem":1}]},{"type":"heading","content":["Apajuí Wakani taamu"]},{"type":"verse","number":28,"content":[{"text":"Nunú uminkamtai,","poem":1},{"lineBreak":true},{"text":"mina Wakanjun ashí susagtinaitjai,","poem":1},{"lineBreak":true},{"text":"dutika ai nuwa aidau, aishmag aidau ashí mina pachitus etsejiagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja múuntuch aidaujaig","poem":1},{"lineBreak":true},{"text":"kajanum chichatnaitjai,","poem":1},{"lineBreak":true},{"text":"untsu datsauch aidaunak pan wantintukan augtinaitjai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tuja nunú tsawantaik, inak nuwa aidaunash,","poem":1},{"lineBreak":true},{"text":"aishmag aidaunashkam mina Wakanjun susagtinaitjai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yaunchkesh wainkachbaun ishamain aidaun nayaimpinum iwainagtinaitjai,","poem":1},{"lineBreak":true},{"text":"dutikakun nugkanmashkam,","poem":1},{"lineBreak":true},{"text":"numpan, jiin, senchi bukuitaun iwainagtinaitjai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Etsag etsanjashtinai,","poem":1},{"lineBreak":true},{"text":"tuja nantushkam numpa iman wajastinai,","poem":1},{"lineBreak":true},{"text":"juka eke Tuke Pujuu iina apuji Apajuí minitin","poem":1},{"lineBreak":true},{"text":"tsawan ishamain atina nunú jegatsaig nagkaemaktinai.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Imanitaish ima Tuke Pujuunak kajitus umijuinak","poem":1},{"lineBreak":true},{"text":"segaidauk uwemjagtinai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu anagkagtuauwa duka imanisag","poem":1},{"lineBreak":true},{"text":"muja Sión yaakat Jerusalégnum uwemtak atinai,","poem":1},{"lineBreak":true},{"text":"Apajuí etejamu aidauk jatsuk uwemjagtinai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}