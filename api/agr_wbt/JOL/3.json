{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JOL","translationId":"agr_wbt","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"da38e427f75678286eb08c0ba1a8d1d69805f51ac31a8f3e03f8ef609242c076","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/agr_wbt/JOL/3.json","totalNumberOfVerses":62},"chapter":{"number":3,"content":[{"type":"heading","content":["Apajuí aents aidau pegkegchaujin diijus suwimkan susatin"]},{"type":"verse","number":1,"content":[{"text":"Nunú tsawan jegakuig,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidau Jerusalégnumia aidaujai","poem":1},{"lineBreak":true},{"text":"achija yajuakbau batsatunak awakjatnaitjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Untsu aents tikich nugkanmaya aidaunak","poem":1},{"lineBreak":true},{"text":"Josafat nugka pakajin ashí ijumjatnaitjai,","poem":1},{"lineBreak":true},{"text":"dutika ijumjan, dita mina aentsug Israel aents aidaun","poem":1},{"lineBreak":true},{"text":"achija yajuakag tikich nugkanum dapampaak","poem":1},{"lineBreak":true},{"text":"emegkajag, dita nugke aidaunashkam atanjag,","poem":1},{"lineBreak":true},{"text":"dita uchiji, nawanji aidaunash kuichkin juwinak,","poem":1},{"lineBreak":true},{"text":"tikich nugkanum sujujag nunú kuichkia duwi","poem":1},{"lineBreak":true},{"text":"vinon sumak umuinak nampenak,","poem":1},{"lineBreak":true},{"text":"nuigtushkam nunú kuichkia duik","poem":1},{"lineBreak":true},{"text":"nuwa akika dutiktai aidaun yujaju asagmatai, suwimkan susagtinaitjai.","poem":1}]},{"type":"heading","content":["Tuke Pujuu aents tikich nugkanmaya aidau pegkegchaujin diijus suwimka susatin"]},{"type":"verse","number":4,"content":["Atum Tiro nugkanum, Sidón nugkanum, filisteo nugkanum batsamin aidautijum mina aentsug Israel aents aidau jeteajum dusha ¿wisha itugkamu asagmea jeteajume? Atsa ¿iikmakmi tusagmek aikajum? Nunú atum eke jeteatsjuminig, wiyá atumnak suwimkan amasan ijinattajime."]},{"type":"verse","number":5,"content":["Atumek oro, plata, tuja ashí tikich waji pegkeg akik midau aidau yajuakjum, atumi apajuímtaijum emematku ijuntai jegamkamunum ashí utsauwaitjume."]},{"type":"verse","number":6,"content":["Atum Tironmaya, Sidógnumia aidautijum Judá wegantu aidau Jerusalégnumia aents aidaujai achija yajuakjum, griego aidaun inataiji atinme tusajum Grecia nugkanum sujujuitjume."]},{"type":"verse","number":7,"content":["Dutikam nuwi batsatun wi ditanak jiija yajuakan ikaunmattajai. Untsu atumnak mina aentsug waitkasuitjum dutiksanuk wishakam iikattajime."]},{"type":"verse","number":8,"content":["Dutikakun, atumi uchijum aidaun, nawanjum aidaujaí, Judá wegantu aidaunum sujutjattajime. Dutika ai dita yajuakag Sabá aents aidaunum sujujagtinai. Witjai Tuke Pujuunuk, nunak dekas uminkatnun tajai."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Juju chicham tikich aents aidaunum etsegkatajum,","poem":1},{"lineBreak":true},{"text":"dutikajum ¡suntag maanitan yacha aidau ijumjajum","poem":1},{"lineBreak":true},{"text":"shiig umintsatajum!","poem":1},{"lineBreak":true},{"text":"¡Nunikjum Apajuín aentsji aidaujai maaniatajum!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atumi takataijum aidau maaniaku jukitin,","poem":1},{"lineBreak":true},{"text":"nagki, puyagjai najankatajum.","poem":1},{"lineBreak":true},{"text":"Tuja aents sapig aina nunú, wajiu wajastinme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashí atum Judá wegantu aidaun","poem":1},{"lineBreak":true},{"text":"shiwaaji aidautijum","poem":1},{"lineBreak":true},{"text":"Josafat nugkanum wamak kaunajum ijunjatajum.","poem":1},{"lineBreak":true},{"text":"Tuja aents kakagchauch maanitan dakitin akush,","poem":1},{"lineBreak":true},{"text":"maanitan yacha wajasag ashí ijunjatnume.","poem":1},{"lineBreak":true},{"text":"Nunikagmin ashí aents jutii aidauti nugken ijus","poem":1},{"lineBreak":true},{"text":"batsamin aidaunak Tuke Pujuu suwimkan susattawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wagki nunú aents aidauk shiig pegkegchau ainawai,","poem":1},{"lineBreak":true},{"text":"nunin asagmatai,","poem":1},{"lineBreak":true},{"text":"trigo tsamaku tsupija juutiama numamtuk tsupigta;","poem":1},{"lineBreak":true},{"text":"tuja ajak juutak tsawantak uminkae,","poem":1},{"lineBreak":true},{"text":"nuadui uva tsamakmatai juuka","poem":1},{"lineBreak":true},{"text":"vino najanatasa najatiama numamtuk awajkata.","poem":1},{"lineBreak":true},{"text":"¡Dita tudauji aidauk dekas shiig múuntai!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuke Pujuu taatin tsawan uminu asamtai,","poem":1},{"lineBreak":true},{"text":"Josafat nugkanum aents aidau shiig kuashat ijunjaje.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja nantuk etsajai mai kajinak suwe wajastatui.","poem":1},{"lineBreak":true},{"text":"Yaya aidaushkam etsanjachagtatui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuke Pujuu kajeka muja Siógnum pujusa chichaak","poem":1},{"lineBreak":true},{"text":"ipamtajai betek wajatai, nuna antukag","poem":1},{"lineBreak":true},{"text":"nugkak nayaimpijai uugtatui.","poem":1},{"lineBreak":true},{"text":"Imanitaish Israel aents aidaunak","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina aentsji asagmatai kuitamkattawai.","poem":1}]},{"type":"heading","content":["Judá wegantu aidauk atakea duish shiig batsamsagtin"]},{"type":"verse","number":17,"content":[{"text":"Tuja Tuke Pujuu niina aentsji aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Atumek nunú tsawan uminkui,","poem":1},{"lineBreak":true},{"text":"mina pachittsajum dekas iina Apajuíjiyapi tujuttinaitjume.","poem":1},{"lineBreak":true},{"text":"Wika muja Sión wi etegkamua nuwi pujajai.","poem":1},{"lineBreak":true},{"text":"Jerusalégkak pegkejam mina aneetaijui,","poem":1},{"lineBreak":true},{"text":"nuadui shiwag tikich nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"ataktu utuawajag makichkish dajagchagtinai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apajuí shiwag aidaun suwimkan susa ijinamtai nagkamas,","poem":1},{"lineBreak":true},{"text":"shiig kuashat uva ayau asamtai,","poem":1},{"lineBreak":true},{"text":"vino najanamu aidauk shiig kuashat aittawai,","poem":1},{"lineBreak":true},{"text":"tuja baka aidaushkam shiig kuashat ayau asamtai,","poem":1},{"lineBreak":true},{"text":"nuna muntsuji ijugbauk shiig kuashat","poem":1},{"lineBreak":true},{"text":"mujanmaya yumi betsaka akagama iman atinai.","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaun nugkenig yumi shiig kuashat aitnai.","poem":1},{"lineBreak":true},{"text":"Mina jegajuiya yumi pukuni jiinki","poem":1},{"lineBreak":true},{"text":"Sitim nugka pakajin ashí ukattinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Untsu Egipto nugkanmaya aidau,","poem":1},{"lineBreak":true},{"text":"Edom nugkanmaya aidaujai","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaun utugchatji atsaunak,","poem":1},{"lineBreak":true},{"text":"tuke aneas jetekag dita nugkenig","poem":1},{"lineBreak":true},{"text":"aents utugchatjinchaunak ijinawaju asagmatai,","poem":1},{"lineBreak":true},{"text":"suwimkan susagtatjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai, dita nugkega duka aents atsau","poem":1},{"lineBreak":true},{"text":"bashiak pegkegchau wajas asattawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Judá wegantu aidau jinauwa nunak wi iikmatkattajai.","poem":1},{"lineBreak":true},{"text":"Nuna dutikau aidauk suwimkan jutsukek pujuschagtatui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Untsu Judá wegantu aidau nugkeg","poem":1},{"lineBreak":true},{"text":"agkan bashiakag asashtinai,","poem":1},{"lineBreak":true},{"text":"Jerusalégchakam agkantak aents atsauk achatnai.","poem":1},{"lineBreak":true},{"text":"Tuja wika Jerusalégnum","poem":1},{"lineBreak":true},{"text":"muja Sión wi etegkamua nuwi pujuttajai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}