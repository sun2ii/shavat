{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"JON","translationId":"agr_wbt","name":"Jonás","commonName":"Jonás","title":"Jonás","order":32,"numberOfChapters":4,"sha256":"56e44c52170d6df6ce0e5d6feafc23e69f17ae2b82f77680600342ae7e7184ab","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/agr_wbt/JON/4.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonás Apajuín ausamu"]},{"type":"verse","number":1,"content":["Nunik Jonásak namaka ampujin egkemas Tuke Pujuu niina Apajuíjin aujak,"]},{"type":"verse","number":2,"content":["aatus tiuwai:",{"lineBreak":true},{"text":"“Tuke Pujuuwah, namaka initken tepeakun jajapi tibaijai.","poem":1},{"lineBreak":true},{"text":"Ashí jakan amina untsukmaijame,","poem":1},{"lineBreak":true},{"text":"dutika ai ame minak yainkabiume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dekas nayantsa kunajin ajunkabiume,","poem":1},{"lineBreak":true},{"text":"ayatak yuminum egkemkan wekaebaijai.","poem":1},{"lineBreak":true},{"text":"Wainchi ishamain ame awemamu","poem":1},{"lineBreak":true},{"text":"tuku tukuji nagkaetibi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Minak dekas ajapjuaumeapi tibaijai,","poem":1},{"lineBreak":true},{"text":"tuja amina jem pegkegma nunak","poem":1},{"lineBreak":true},{"text":"ataktu awagkinuk wainkashtinapitja tibaijai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shiig initak tepeabiajai,","poem":1},{"lineBreak":true},{"text":"nayants ijitua emegkatkabi,","poem":1},{"lineBreak":true},{"text":"initkanmaya dupa aidau buukjun pempenjibi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiig initak tepean nugkanum jegabiajai,","poem":1},{"lineBreak":true},{"text":"tuke jiinkishtinapitja tibaijai.","poem":1},{"lineBreak":true},{"text":"Tujash Tuke Pujuuwah, mina Apajuíjuh, ame minak uwemtijugmayume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tikima jakun aminí anentaimjan,","poem":1},{"lineBreak":true},{"text":"untsukmaijame. Tusa untsumai","poem":1},{"lineBreak":true},{"text":"ame amina jem pegkegma nuwi pujusam antugtukmayume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wainka apajuímtai aidaun emematuinak","poem":1},{"lineBreak":true},{"text":"ima aminak umigtamainun idayinawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tujash wika kuntinun maa apeakun amina ememattatjame,","poem":1},{"lineBreak":true},{"text":"nuniakun wi amina ememattatjame tusan","poem":1},{"lineBreak":true},{"text":"tiuwaitjam nunak imatiksanuk umiktatjai.","poem":1},{"lineBreak":true},{"text":"¡Wagki ameketme uwemtikagtinmek!” tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Tusa aatus timatai, Tuke Pujuu nunú namak Jonásan kukag iyakti tiuwai. Tusa tima Jonásan kukag iyakui."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}