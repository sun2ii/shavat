{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":1,"content":[{"type":"heading","content":["Apajuí yaakat Samaria pegkegchaujin diijus tsaiktin pachisa etsegkamu"]},{"type":"verse","number":1,"content":["Tuke Pujuu Samarian Jerusalégjai dita pegkegchaujin diijus tsaiktinjin pachis Miqueas Moréset nugkanmaya aajakua nuna ujakui. Nunak Judá wegantu aidaun apuji aidau Jotam, Acaz, Ezequías aatus takasu aina nunú tsawantin ujaak aatus tiuwai:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“¡Ashí aents aidautijum wi taja nunú antuktajum!","poem":1},{"lineBreak":true},{"text":"¡Juju nugkanmaya aidautijum shiig antukjum jukitajum!","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk niina jee pegkegma nuwi pujusag,","poem":1},{"lineBreak":true},{"text":"atum suwimak jukitnun pachis etsegkattawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuu niina pujusa inamtaijin pujau ukuak,","poem":1},{"lineBreak":true},{"text":"muja titijin taa nuwi wekagas tattawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja nii taa mujan najataik,","poem":1},{"lineBreak":true},{"text":"muja aidauk wiya jinum sukuam yumimegama","poem":1},{"lineBreak":true},{"text":"numamtuk wajaktinai,","poem":1},{"lineBreak":true},{"text":"tuja muja najatamu paka aidauk","poem":1},{"lineBreak":true},{"text":"yumi senchi yutak nugkan yumpuwama imanik","poem":1},{"lineBreak":true},{"text":"yumpunag kanaktinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Duka Israel aents aidau intimtaijin,","poem":1},{"lineBreak":true},{"text":"tuja dita tudaujin nuniktinai.","poem":1},{"lineBreak":true},{"text":"Israel aents aidauk Samaria nugkanum pegkegchaun takamsau ainawai,","poem":1},{"lineBreak":true},{"text":"untsu Judá wegantu aidauk wainka apajuímtai dakumka najanamu aidaun","poem":1},{"lineBreak":true},{"text":"Jerusalégnum jegamjujag nuna emematujaku ainawai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuadui Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Yaakat Samarianak tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"dutika ai ayatak kaya tuwasua weaku,","poem":1},{"lineBreak":true},{"text":"jega atsau ayatak uva ajakmamain awajsattajai.","poem":1},{"lineBreak":true},{"text":"Tuja muja najatamu paka aina nuwishkam,","poem":1},{"lineBreak":true},{"text":"nunú kaya aidaun nagkimkattajai.","poem":1},{"lineBreak":true},{"text":"Dutikan yaakat najanku kaya aepkamunash ipaantujan pan awajsattajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja dita apajuímtaiji dakumka najanamu","poem":1},{"lineBreak":true},{"text":"Samaria nugkanum ayá duka ashí tsainkattawai.","poem":1},{"lineBreak":true},{"text":"Tuja dita ememattai numi aina dushakam ashí apenkattawai.","poem":1},{"lineBreak":true},{"text":"Nunú dita apajuímtaiji aina duka","poem":1},{"lineBreak":true},{"text":"nuwa akika dutiktai aidaun kuichkiji juki","poem":1},{"lineBreak":true},{"text":"najanamu asagmatai, jinum jiya ukuijan ataktu","poem":1},{"lineBreak":true},{"text":"nuwa akika dutiktai aina nuna kuichkiji awajsattajai”,","poem":1},{"lineBreak":true},{"text":"tujutmayi Apajuí.","poem":1}]},{"type":"heading","content":["Miqueas buutbau"]},{"type":"verse","number":8,"content":[{"text":"Nuna antukan shiig senchi wake besemag dekapeakun senchi buutjai,","poem":1},{"lineBreak":true},{"text":"nuniakun wisu sapatjinchau wekaesan,","poem":1},{"lineBreak":true},{"text":"bakantau shinau wajakun, lobo buutu wajajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Samarianmaya aents aidaun tudaujig tsagkugnamainchau,","poem":1},{"lineBreak":true},{"text":"Judá wegantu aidaun tudaujinash amaigkae,","poem":1},{"lineBreak":true},{"text":"imaniak mina aentsug aidau Jerusalén batsata","poem":1},{"lineBreak":true},{"text":"imanuishkam jegae.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tujash Gadnumia aents aidauk juju pachisjumek ujakaigpajum,","poem":1},{"lineBreak":true},{"text":"buuttakesh buutigpajum,","poem":1},{"lineBreak":true},{"text":"ayatak wake besemag dekapeamunum","poem":1},{"lineBreak":true},{"text":"Bet-le-afránmaya nugka yukukuntua nuwi tadaejatajum.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bellavistanmaya aents aidautigminak achipajag jujamkiagtinai,","poem":1},{"lineBreak":true},{"text":"dutijamawagmatai wainka inataijai betek,","poem":1},{"lineBreak":true},{"text":"wisu datsan shiyaktinaitjume.","poem":1},{"lineBreak":true},{"text":"Atum pujamun ijus tikich yaaktanum batsamin aidau buutiagtinai.","poem":1},{"lineBreak":true},{"text":"Tujash dutika jujabiagtaish, Zaanágnumia","poem":1},{"lineBreak":true},{"text":"aents aidaush atumnak ayamjutpakchagtinai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuja yaakat Amargura batsamin aidauk","poem":1},{"lineBreak":true},{"text":"ayamjutpaktinme tusa dakamainak waitiagtinai.","poem":1},{"lineBreak":true},{"text":"Tujash Tuke Pujuuk Jerusalén waitainum nagkamas suwimkanak susatnai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Atum Laquishnumia aidautigmek,","poem":1},{"lineBreak":true},{"text":"caballo senchi tupikain","poem":1},{"lineBreak":true},{"text":"carro maanitainum jigkajum umintsatajum.","poem":1},{"lineBreak":true},{"text":"Siógnumia aents aidauk Laquishnum","poem":1},{"lineBreak":true},{"text":"pegkegchau takatnak unuimaju ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja nuwi Israel aents aidaushkam","poem":1},{"lineBreak":true},{"text":"Apajuín intimjukiag pegkegchaun takasu ainawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Atumi nugkem Moréset-gat tutaya duka","poem":1},{"lineBreak":true},{"text":"tuke ukuakjum ukuktajum.","poem":1},{"lineBreak":true},{"text":"Tuja Israel aidaun apuji aidaunak","poem":1},{"lineBreak":true},{"text":"yaakat Aczibnumia yaigchagtinaitak","poem":1},{"lineBreak":true},{"text":"wi yaigtatjime tusag tsanujaje.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Maresánmaya aents aidautigmin depetamak amupaktinme tusan","poem":1},{"lineBreak":true},{"text":"aents maanita yachan ataktu awetittajime.","poem":1},{"lineBreak":true},{"text":"Nunú minitaik Israel aents dekas wajiu aidaush,","poem":1},{"lineBreak":true},{"text":"nuna ishamak pisajag waa Adulam tutaya","poem":1},{"lineBreak":true},{"text":"nuwi akumjagtinai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jerusalégnumia aidautigmek buuttajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum susujum awagtajum,","poem":1},{"lineBreak":true},{"text":"buuttajum nuniakjum awamagjum,","poem":1},{"lineBreak":true},{"text":"chuagka buukejai betek pinui wajastajum.","poem":1},{"lineBreak":true},{"text":"Atumi uchijum aneetaijum aidaunak,","poem":1},{"lineBreak":true},{"text":"achijag tikich nugkanum yajuakagtinai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}