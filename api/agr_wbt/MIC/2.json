{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":2,"content":[{"type":"heading","content":["Aents ujudauch aidaun waitkaidauk suwimkan jukiagtin"]},{"type":"verse","number":1,"content":[{"text":"Aents pegkegchau aina nunak wait anentuinajai,","poem":1},{"lineBreak":true},{"text":"wagki ditak depetmak batsatu asag, ememainak","poem":1},{"lineBreak":true},{"text":"wajina pegkegchaun takastag tuinawa nunak","poem":1},{"lineBreak":true},{"text":"kaja kajanmaske uminawai.","poem":1},{"lineBreak":true},{"text":"Nuadui nantaamuik nunak betek dutikainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuja nugkan wakegainakug","poem":1},{"lineBreak":true},{"text":"tikichi nugken atantuinawai,","poem":1},{"lineBreak":true},{"text":"tuja jega aidaun wakegainakushkam,","poem":1},{"lineBreak":true},{"text":"tikichdaun atainiag juwinawai.","poem":1},{"lineBreak":true},{"text":"Dutikainak jennunak niina nuwe, uchiji aidaujai","poem":1},{"lineBreak":true},{"text":"tsanujag jiiki ajapawag waitkainawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuadui Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Wishakam atum suwimak jukitnunak chichaman umikjai.","poem":1},{"lineBreak":true},{"text":"Suwimak katsunmainchaun amastatjime,","poem":1},{"lineBreak":true},{"text":"nuna uwemtumainuk makichkish atsuttawai.","poem":1},{"lineBreak":true},{"text":"Suwimak ishamain katsunmainchau asamtai,","poem":1},{"lineBreak":true},{"text":"emema yuja nunak nunikchagtatui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunú tsawantin aents aidau dushiktamiagtinai,","poem":1},{"lineBreak":true},{"text":"nuninak juna aatus kantamjutpainak:","poem":1},{"lineBreak":true},{"text":"‘¡Ashí depetkam wainak juwakaje!","poem":1},{"lineBreak":true},{"text":"¡Yaunchkek Apajuí aentsji ayanume,","poem":1},{"lineBreak":true},{"text":"tujash nunak idaisaje!","poem":1},{"lineBreak":true},{"text":"¡Iina suntaji aidau depetkagmatai,","poem":1},{"lineBreak":true},{"text":"dita nugke aidauk ii akandaija yajuakji!’ tiagtinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Israel aents aidautijum antuktajum!","poem":1},{"lineBreak":true},{"text":"Atumek mina aentsug ayugme,","poem":1},{"lineBreak":true},{"text":"tujash wika nugkanak ataktuk amaschagtatjai”, tujamui.","poem":1}]},{"type":"heading","content":["Profeta waita etsejin aidau"]},{"type":"verse","number":6,"content":[{"text":"“¡Atum waita etsejin aidautigmek","poem":1},{"lineBreak":true},{"text":"Apajuí profetaji chicham pegkegchaun ujatkai!”","poem":1},{"lineBreak":true},{"text":"tusajum dakitagme.","poem":1},{"lineBreak":true},{"text":"Atumek utugchat ajutjamu dekakjumesh,","poem":1},{"lineBreak":true},{"text":"dekaskeapi tatsugme.","poem":1},{"lineBreak":true},{"text":"Nuadui profeta etsegbau antutak dakitagme.","poem":1},{"lineBreak":true},{"text":"Nuniakjum: “Apajuík jutijaig shiwagchauwai,","poem":1},{"lineBreak":true},{"text":"Apajuík jutiinak kajegtamkash idaitamtsuk atsane pujuttawai,","poem":1},{"lineBreak":true},{"text":"nuigtush Apajuík aajag dutikchauwai,","poem":1},{"lineBreak":true},{"text":"Apajuík ashí aents aidau pegkejan takaidaunak","poem":1},{"lineBreak":true},{"text":"shiig kuitamnai”, tajume.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Atumek mina aentsug aidaujai shiwagmaejume.","poem":1},{"lineBreak":true},{"text":"Tuja maaniamunum shiyaku aidau","poem":1},{"lineBreak":true},{"text":"uwemjajiapi tusag shiig aneas waketug minidaushkam,","poem":1},{"lineBreak":true},{"text":"jáanch akik aidaun yajuak minidau atanjume.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dutikakjum dita jee aneetaiji aidaushkam","poem":1},{"lineBreak":true},{"text":"atum atankujum nuwa aidau jiiki ajapeagme.","poem":1},{"lineBreak":true},{"text":"Dita uchiji aidaun wi susauwaitag dushakam","poem":1},{"lineBreak":true},{"text":"tuke jujuki emegkatjume.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuadui atumek ¡juwi batsamtsuk, jiinja shiyaktajum!","poem":1},{"lineBreak":true},{"text":"Juwig dita wakegamun takainak batsamsatnume tichamui,","poem":1},{"lineBreak":true},{"text":"tuja atum pegkegchau awajsau asagmin,","poem":1},{"lineBreak":true},{"text":"juka ashí tsainkattawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Makichik aents nigki nagkami waitjak:","poem":1},{"lineBreak":true},{"text":"“Vino senchi kajiau umamuk pegkejai,","poem":1},{"lineBreak":true},{"text":"tuja tikich uwaja nampetai aina dushakam pegkejai”,","poem":1},{"lineBreak":true},{"text":"tawa nunú atumek dekas profeta pegkejai tajume.","poem":1}]},{"type":"heading","content":["Apajuí niina aentsji aidaun uwemtikjatin"]},{"type":"verse","number":12,"content":[{"text":"Israel aents aidau ujumchik iwaku batsatunak yajuakan,","poem":1},{"lineBreak":true},{"text":"uwig makichik wenuknumak ijumaina numamtuk ijumjattajai.","poem":1},{"lineBreak":true},{"text":"Dutika ai shiig aneenak, kuashtachuitak,","poem":1},{"lineBreak":true},{"text":"kuashat pampaumaina imatiagtinai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apajuí eemak jinta jintama wetinai,","poem":1},{"lineBreak":true},{"text":"nunitai dita pataekagtinai,","poem":1},{"lineBreak":true},{"text":"yaakta waitijiya nuni jiinjagtinai.","poem":1},{"lineBreak":true},{"text":"Nunikagmatai dita apuji Tuke Pujuu eemak wetinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}