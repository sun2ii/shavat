{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":3,"content":[{"type":"heading","content":["Israel aents aidaun apuji pegkegchau aidau chicham akuptukbau"]},{"type":"verse","number":1,"content":[{"text":"¡Israel aents aidaun apuji aidautijum","poem":1},{"lineBreak":true},{"text":"juju yamai antuktajum!","poem":1},{"lineBreak":true},{"text":"¿Atumchaukaitjum shiig takastinme tusa","poem":1},{"lineBreak":true},{"text":"etegkamu aidautijum?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tujash atumek pegkeja nunú kajejakjum,","poem":1},{"lineBreak":true},{"text":"pegkegchauwa nunú takagme.","poem":1},{"lineBreak":true},{"text":"Nuniau asajum mina aentsug aina nuna neje","poem":1},{"lineBreak":true},{"text":"ichiaja yajutkajum ayatak ukunchik emajum ukuajume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja atumek mina aentsug aidauk iwakuk yuwagme,","poem":1},{"lineBreak":true},{"text":"dutikakjum duwape ichinjajum,","poem":1},{"lineBreak":true},{"text":"neje ollanum painkatasa akaaja ukunchi tsupigtayama imatikagme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Makichik tsawantai Tuke Pujuu untsuktinaitjume,","poem":1},{"lineBreak":true},{"text":"tujash niig aigmakchagtinai.","poem":1},{"lineBreak":true},{"text":"Atumek tikima pegkegchau ainajum duwi","poem":1},{"lineBreak":true},{"text":"Apajuí atumnak uumjutpakagtinai.","poem":1}]},{"type":"heading","content":["Profeta waitan etsejin aidau"]},{"type":"verse","number":5,"content":[{"text":"Mina aentsug aidauk profeta waita etsejin aidau","poem":1},{"lineBreak":true},{"text":"tsanumainak, utugchatak atsuttawai tuina","poem":1},{"lineBreak":true},{"text":"nuna antujuinak pegkegchaunum yujawai,","poem":1},{"lineBreak":true},{"text":"nunú profeta aidauk ya ditan yujumkan ajampeawa","poem":1},{"lineBreak":true},{"text":"nuna shiig anentuinak,","poem":1},{"lineBreak":true},{"text":"yujumkan ajampenatsu nunak kajejuinawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui wi wajina dutikatag taja nunak","poem":1},{"lineBreak":true},{"text":"ataktuk ditanak ujakchagtinaitjai.","poem":1},{"lineBreak":true},{"text":"Ajumaish ditanak makichkish dekamtikashtinaitjai,","poem":1},{"lineBreak":true},{"text":"nuadui ditak wajig nagkaemaktinaita","poem":1},{"lineBreak":true},{"text":"nunak makichkish etsegkashtin ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuadui nunú profeta aidauk,","poem":1},{"lineBreak":true},{"text":"anentaimas dekamin aidaujai shiig datsantan juwakagtinai.","poem":1},{"lineBreak":true},{"text":"Wagki Apajuí jintinchamush wajinak etsegkatnume nuninak","poem":1},{"lineBreak":true},{"text":"wainak chichá yuja nunak itatjatnai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Untsu minaig Tuke Pujuu Wakani pujau asa,","poem":1},{"lineBreak":true},{"text":"nunú minak senchimtijawai.","poem":1},{"lineBreak":true},{"text":"Nuadui wika Apajuík dekas","poem":1},{"lineBreak":true},{"text":"shiig betek imatikas takawai tajai.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"pegkegchau intimkiu ainawai tajai.","poem":1}]},{"type":"heading","content":["Jerusalén tsaikbau"]},{"type":"verse","number":9,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Israel aents aidaun apuji aidautijum antuktajum.","poem":1},{"lineBreak":true},{"text":"Atumek tsanumtsuk shiig takata duka dakitajume,","poem":1},{"lineBreak":true},{"text":"tuja chicham umiktina dushakam yapajiajum takagme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jerusalégnumak,","poem":1},{"lineBreak":true},{"text":"tuja mina jegag pegkegma nuwishkam,","poem":1},{"lineBreak":true},{"text":"pegkegchau takat, tuja magkagtut aina duka","poem":1},{"lineBreak":true},{"text":"makichkish mijamtsuk tuke imani awai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apu chichama epegkin aidauk ya kuichkin akikmawa nuna yainawai,","poem":1},{"lineBreak":true},{"text":"tuja sacerdote aidaushkam kuichkin akigkatnume tusa jintinkagtuinawai.","poem":1},{"lineBreak":true},{"text":"Profeta aidaushkam kuichik akiam chichaman etsejuinawai,","poem":1},{"lineBreak":true},{"text":"nuninak: ‘Tuke Pujuu jutijaig pujawai,","poem":1},{"lineBreak":true},{"text":"nuadui suwimkanak amaschattawai’, tuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Atumi pegkegchaujin mina jegag pegkegma duka tsainkattawai,","poem":1},{"lineBreak":true},{"text":"tuja atumi pegkegchaujin Jerusalégkak tsaikam aents atsau bashiak asattawai.","poem":1},{"lineBreak":true},{"text":"Tuja muja pegkejam Siógkak dupa ijiam asattawai”, tawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}