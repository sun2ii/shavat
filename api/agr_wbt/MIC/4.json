{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":4,"content":[{"type":"heading","content":["Tuke Pujuu ashí nugkanum inamjatin"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu jee pegkejam awa nunú mujak,","poem":1},{"lineBreak":true},{"text":"tikich muja aidaun nagkaesau dekas muja shiig múun atinai.","poem":1},{"lineBreak":true},{"text":"Nunú mujanum ashí aents tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"shiig kuashat kauniagtinai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuashat aents nugka muunnumia aidau kaunainak:","poem":1},{"lineBreak":true},{"text":"“¡Minitajum muja Tuke Pujuunua nuwi wakagmi,","poem":1},{"lineBreak":true},{"text":"nunika Jacopa Apajuíjiya nuna jeen jegawagmi,","poem":1},{"lineBreak":true},{"text":"awi Tuke Pujuu niina chichame umiktin agagbauwa nuna","poem":1},{"lineBreak":true},{"text":"jintinjamamtai, iish nunú antuka umikagmi!” tiagtinai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuu aents nugka muunnumia aidaunak,","poem":1},{"lineBreak":true},{"text":"tuja atushtanmaya aidaunashkam suwimkan susattawai.","poem":1},{"lineBreak":true},{"text":"Tuja utugchat ataishkam nii epegkeatnai.","poem":1},{"lineBreak":true},{"text":"Nuadui dita aidauk puyagjinak","poem":1},{"lineBreak":true},{"text":"ajak ajakmaku takatain najankagtinai,","poem":1},{"lineBreak":true},{"text":"untsu nagki aidaunak trigo tsupitain najankagtinai.","poem":1},{"lineBreak":true},{"text":"Dutikawaju asag nugka muunnumiagkesh","poem":1},{"lineBreak":true},{"text":"tikichjai maaniauk makichkish atsutnai.","poem":1},{"lineBreak":true},{"text":"Tuja maaniatag tusa uminku","poem":1},{"lineBreak":true},{"text":"suntagmaebaushkam atsustinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuadui ashí aents aidauk ishamkagtutsuk","poem":1},{"lineBreak":true},{"text":"maki makichik dita uva ajakbaujin, higo ajakbaujin","poem":1},{"lineBreak":true},{"text":"nuna wakentin bikintunum shiig agkan","poem":1},{"lineBreak":true},{"text":"ayamainak batsamsatnai.","poem":1},{"lineBreak":true},{"text":"¡Nunak dekas Tuke Pujuu ashí senchigtina nunú aatus tawai!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja tikich aents aidauk","poem":1},{"lineBreak":true},{"text":"dita apajuímtaiji aidaun umijuinawai;","poem":1},{"lineBreak":true},{"text":"dita núninakuish, iik Tuke Pujuu iina Apajuíjiya nunú","poem":1},{"lineBreak":true},{"text":"atakea duish tuke umigkatin ainaji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuja junashkam Tuke Pujuu chichaak:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug aidauk","poem":1},{"lineBreak":true},{"text":"wi suwimak susam waituidau asag,","poem":1},{"lineBreak":true},{"text":"uwigjai betek yawekag, shutusag wainak yujawai.","poem":1},{"lineBreak":true},{"text":"Tujash dukap atsuk ataktu yajuakan ijumjattajai.","poem":1},{"lineBreak":true},{"text":"Nunú tsawan jegamtai,","poem":1},{"lineBreak":true},{"text":"ujumak iwaku batsatun yajuaka ijumjan,","poem":1},{"lineBreak":true},{"text":"ataktu shiig kuashat senchigtin awajsatnaitjai.","poem":1},{"lineBreak":true},{"text":"Dutikan wi dita apuji wajasan","poem":1},{"lineBreak":true},{"text":"mina jegag pegkegma nuwi pujusan inamjatnaitjai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Muja Siógkah, ame yaakat Jerusalén mina","poem":1},{"lineBreak":true},{"text":"aneetaijua nunú ejakam kuitamin ayume,","poem":1},{"lineBreak":true},{"text":"nuadui ataktu yaunchuk aayum iman wajastatme.","poem":1},{"lineBreak":true},{"text":"¡Ame atatme mina aentsug aina nuna","poem":1},{"lineBreak":true},{"text":"dekas yaaktaji shiig múun!”","poem":1},{"noteId":0},{"text":"tawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“¿Wagka tujash Jerusalégka amesh","poem":1},{"lineBreak":true},{"text":"nuwa uchin najaimak buutama imanikmesh buutme?","poem":1},{"lineBreak":true},{"text":"Amek wainkamek buutmaitsume,","poem":1},{"lineBreak":true},{"text":"amina apugmik pujawai,","poem":1},{"lineBreak":true},{"text":"tuja apu chichagkagtin aidaushkam batsatui.","poem":1},{"lineBreak":true},{"text":"Dekas buuttag takumek, amina aentsjum aidau","poem":1},{"lineBreak":true},{"text":"ukugmakiag ikam ajanum batsatun,","poem":1},{"lineBreak":true},{"text":"babilonianmaya aidau achijag yajuakagtina nunú","poem":1},{"lineBreak":true},{"text":"anentaimsam buutta.","poem":1},{"lineBreak":true},{"text":"Dutikawagmataish, wi ditanak ayamjukan","poem":1},{"lineBreak":true},{"text":"uwemtikjan agkanmitkawagtinaitjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kuashat aents nugka muunnumia aidau","poem":1},{"lineBreak":true},{"text":"amina shiwagmatjamainau asag chichainak:","poem":1},{"lineBreak":true},{"text":"‘¡Utusag Jerusalégkan tsaikanum tusa wakegaji!’ tuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tujash nunú aents aidauk Apajuísh wajinak dutikatag tawa nunak shiig dekainatsui,","poem":1},{"lineBreak":true},{"text":"Apajuí ditanak trigo tsupija ijumja jigkatiama","poem":1},{"lineBreak":true},{"text":"numamtuk awajkatta nuna","poem":1},{"lineBreak":true},{"text":"ditak dekainachu asa tuu yujawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Pai Jerusalégkah!","poem":1},{"lineBreak":true},{"text":"¡Nantakta, nunikam dekegka tsaikta!","poem":1},{"lineBreak":true},{"text":"Wagki Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"‘Wi aminak depetmakti tusan toro senchia iman,","poem":1},{"lineBreak":true},{"text":"kachuji jiju hierro katsugma ibau,","poem":1},{"lineBreak":true},{"text":"nuigtush nanchiki bronce katsugma iman awajsattagme.","poem":1},{"lineBreak":true},{"text":"Dutika ai depetkam dita wajiji kasamka ijumtai aina nunú","poem":1},{"lineBreak":true},{"text":"ashí yajutkam mina sujustinaitme,","poem":1},{"lineBreak":true},{"text":"wagki ashí nugka duka midau ainawai’, tawai Apajuí”,","poem":1},{"lineBreak":true},{"text":"tiuwai Miqueas.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yaakat shiig múun” tawa nunak apach chichamnum “capital” tawa nunú taku taji.","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/agr_wbt/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":11}