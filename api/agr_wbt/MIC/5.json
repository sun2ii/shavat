{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":5,"content":[{"type":"heading","content":["David wegantunmaya apu wajas inamjatin"]},{"type":"verse","number":1,"content":[{"text":"Jerusalégnumia aidautigminak tentempawaje,","poem":1},{"lineBreak":true},{"text":"atum ayamjumaktinjum umintsatajum.","poem":1},{"lineBreak":true},{"text":"Apajuí atumi shiwaajum aina nuna ishituk,","poem":1},{"lineBreak":true},{"text":"Israel aents aidau apujin senchi suwimkan susattawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Untsu Belén Efrata tuuta awagmatia,","poem":1},{"lineBreak":true},{"text":"nuwiya aidautigmek, tikich Judá wegantu aina nujai","poem":1},{"lineBreak":true},{"text":"diismash ujumchik ainagme.","poem":1},{"lineBreak":true},{"text":"Nuninuch ainayatkujum,","poem":1},{"lineBreak":true},{"text":"eme anentsa chichagtai atinaitjume.","poem":1},{"lineBreak":true},{"text":"Wagki atumi patayi aajakua nuwiya","poem":1},{"lineBreak":true},{"text":"apu atin akiina Judá wegantunum inamjattawai.","poem":1},{"noteId":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuuk","poem":1},{"lineBreak":true},{"text":"nuwa uchin uchigmaktin ejapjuk puja","poem":1},{"lineBreak":true},{"text":"nunú uchigmakmatai,","poem":1},{"lineBreak":true},{"text":"niina aentsji aidaunak ataktu yaigtin asa,","poem":1},{"lineBreak":true},{"text":"yamai nagkamas ima ditanak idaiwai.","poem":1},{"lineBreak":true},{"text":"Nunú uchi akiinamtai, tikich Israel aents aidau","poem":1},{"lineBreak":true},{"text":"shiwag amuam iwaku juwaku aidau","poem":1},{"lineBreak":true},{"text":"dita patayi aidaujai ijunjagtinai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunikagmatai aents uwija kuitamnujai betek","poem":1},{"lineBreak":true},{"text":"nunú apu Apajuí senchijijai ditan kuitamkatnai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú apuk ashí nugka nagkatkamunmash inamjatnai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuniak nii agkan pujutan amastinai.","poem":1},{"lineBreak":true},{"text":"Tuja asirianmaya aidau iina nugken utsanawag","poem":1},{"lineBreak":true},{"text":"jega múun aidaun atanjamjatag tuinakuig,","poem":1},{"lineBreak":true},{"text":"siete apu aidau ocho suntaja apuji aidaujai","poem":1},{"lineBreak":true},{"text":"ditan jetektinme tusa ishiaktatji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dutika depetka Asiria, Nimrotan nugkega nunú utsaantua ii jukitnaitji.","poem":1}]},{"type":"heading","content":["Shiwag aidau ijinatin"]},{"type":"verse","number":7,"content":[{"text":"Tuja maaniamunum jinachaju aidauk","poem":1},{"lineBreak":true},{"text":"tikich aents aidaujai apatka diismash,","poem":1},{"lineBreak":true},{"text":"chijichi yumi ukatchamaitak,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu yumi yutumtijamu yutak uchupjam","poem":1},{"lineBreak":true},{"text":"pegkegchin iwagnama iman agtinai.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam león tagku wenuken waya,","poem":1},{"lineBreak":true},{"text":"uwig aidaun ashí ijinama iman agtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, amek amina shiwaajum aidauk","poem":1},{"lineBreak":true},{"text":"imatika jetekam ashí ijinatnaitme.","poem":1}]},{"type":"heading","content":["Ashí tsaikbau"]},{"type":"verse","number":10,"content":["Tuke Pujuu chichaak:",{"text":"“Nunú tsawan jegatna duwi,","poem":1},{"lineBreak":true},{"text":"amina caballojum maanitai aidaunak","poem":1},{"lineBreak":true},{"text":"ashí ijituattagme,","poem":1},{"lineBreak":true},{"text":"dutikakun carrojum aidaunashkam tsaigkattagme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja yaaktajum aidaunashkam kumpin jiigbau ayá nujai ashí tsaiktinaitjai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tunchijum aidaunak,","poem":1},{"lineBreak":true},{"text":"anentaimas dekamin aidaujaí ashí ijituattagme.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amina apajuímtaijum aidaunak,","poem":1},{"lineBreak":true},{"text":"tuja dakumka kaya najanamu aina nujai ashí tsaiktatjai.","poem":1},{"lineBreak":true},{"text":"Dutika ai ame najanamu emematu pujam duka","poem":1},{"lineBreak":true},{"text":"ataktuk emematchatnaitme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaaktajum aidaunak ashí tsaiktatjai,","poem":1},{"lineBreak":true},{"text":"tuja amina apajuímtaijum Astarté,","poem":1},{"lineBreak":true},{"text":"dakumka najanamua nunashkam,","poem":1},{"lineBreak":true},{"text":"numi aidau emematam nujai tsaiktatjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ashí aents tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"mina umigtutan dakitjau aina nunak","poem":1},{"lineBreak":true},{"text":"mina umigtukchagbaunum iikmakun","poem":1},{"lineBreak":true},{"text":"shiig senchi suwimkan susagtatjai”, tawai.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Juju versículonum chichá duka Mt. 2.6numshakam augmatui.","reference":{"chapter":5,"verse":2}}]},"thisChapterLink":"/api/agr_wbt/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}