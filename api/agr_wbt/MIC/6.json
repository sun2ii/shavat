{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"MIC","translationId":"agr_wbt","name":"Miqueas","commonName":"Miqueas","title":"Miqueas","order":33,"numberOfChapters":7,"sha256":"e500fc47fed0662d4f47c6b577b973f735fa91e7ccc93dcb95a23400cfcf95c6","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/agr_wbt/MIC/7.json","totalNumberOfVerses":75},"chapter":{"number":6,"content":[{"type":"heading","content":["Apajuí Israel aents aidaun kajegkamu"]},{"type":"verse","number":1,"content":[{"text":"Israel aents aidauwah, shiig antuktajum.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu atumin kajegtamak chichaak:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug aidauwah,","poem":1},{"lineBreak":true},{"text":"atumi utugchatjumin dekajuajime,","poem":1},{"lineBreak":true},{"text":"nuniku asan, yamai ayamjumaktajum tajime.","poem":1},{"lineBreak":true},{"text":"Atum ayamjumaku chichamun antukag,","poem":1},{"lineBreak":true},{"text":"nunak dekas tawai tusa amina yaimpakagtina nunú,","poem":1},{"lineBreak":true},{"text":"muja aidau, nain aidau untsuka ijumjam,","poem":1},{"lineBreak":true},{"text":"atum antugtagmin chichamjumaktajai titajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Tujash nunú ame eke chichaktin aminig wi tajame:","poem":1},{"lineBreak":true},{"text":"¿Wisha aminash itugkamjame? Atsa dutikachkunush","poem":1},{"lineBreak":true},{"text":"¿wajinma pegkegchaush awajkajame? Nunú tujutta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atumek Egipto nugkanum inaku waitkatai batsatutigmin","poem":1},{"lineBreak":true},{"text":"wi jiijan agkanmitkauwaitjime;","poem":1},{"lineBreak":true},{"text":"atumin yaimpakag jiipagtinme tusan","poem":1},{"lineBreak":true},{"text":"Moisésan, Aarógkan, Marían ishiakamiajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mina aentsug aidauwah,","poem":1},{"lineBreak":true},{"text":"Moab nugkan apuji Balac","poem":1},{"lineBreak":true},{"text":"atumin pegkegchaunum yumigtamjatag tuyi,","poem":1},{"lineBreak":true},{"text":"tujash Balaam mina daajui atumin","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigtamjabia nunú adeagtajum.","poem":1},{"lineBreak":true},{"text":"Tuja nuigtushkam Sitim nugkanum juwaki,","poem":1},{"lineBreak":true},{"text":"Guilgal shimamunmash waji utugchat igkugkabiugme","poem":1},{"lineBreak":true},{"text":"nunú kajimattsuk aneaku atajum. Nuniakjum,","poem":1},{"lineBreak":true},{"text":"dekas Tuke Pujuuwap yaimpakuita titajum”, tiuwai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tusa timatai dita chichainak:","poem":1},{"lineBreak":true},{"text":"“Tuke Pujuuwah, amek múuntaitme.","poem":1},{"lineBreak":true},{"text":"¿Ame emematkuish, iish waji jukiya aminish tamainaitji?","poem":1},{"lineBreak":true},{"text":"¿Toro tsakat makichik mijanji ajamu maa","poem":1},{"lineBreak":true},{"text":"nuna neje ashí apeakuika emematmainaitag?","poem":1},{"lineBreak":true},{"text":"Tujash amek duka wakegatsme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dutikachkuish mil carnerok,","poem":1},{"lineBreak":true},{"text":"atsa diez mil namak amaina ibau kuashtak","poem":1},{"lineBreak":true},{"text":"aceite anentag amamainaitag.","poem":1},{"lineBreak":true},{"text":"Tuja dushakam aminak shiig awajtamtsui;","poem":1},{"lineBreak":true},{"text":"amek iina tudaujinig iina uchiji iwai aina nuna","poem":1},{"lineBreak":true},{"text":"sujustinme tusamkesh tatsume”, tuidau.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk atumnak tuwita pegkejash,","poem":1},{"lineBreak":true},{"text":"tuja aminunash wajina wakegawa nunak","poem":1},{"lineBreak":true},{"text":"yaunchuk ujapakagmae.","poem":1},{"lineBreak":true},{"text":"Duka utugchatchauwai shiig yupichuchi,","poem":1},{"lineBreak":true},{"text":"tuja duka juju ainawai:","poem":1},{"lineBreak":true},{"text":"Shiig takata nunú aneetajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum aents imanchauch aidaush wait anenjatajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum emematsuk ima minak emematjitajum","poem":1},{"lineBreak":true},{"text":"tusa Apajuík wakegawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":7}