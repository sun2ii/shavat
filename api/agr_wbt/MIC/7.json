:"anagkuawaitam duka,","poem":1},{"lineBreak":true},{"text":"dutiksamek wait aneasam amina anenkagmin","poem":1},{"lineBreak":true},{"text":"tuke kuitamkagtuktin ata!” tiajui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":3}