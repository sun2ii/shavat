{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"NUM","translationId":"agr_wbt","name":"Números","commonName":"Números","title":"Israel aents aidauuwegshunum yujasbau Números","order":4,"numberOfChapters":13,"sha256":"a99e4e885149805d86cd97a6f3cae0ae5a5216eb8b68ffd40f55700ae8692aa6","firstChapterNumber":6,"firstChapterApiLink":"/api/agr_wbt/NUM/6.json","lastChapterNumber":27,"lastChapterApiLink":"/api/agr_wbt/NUM/27.json","totalNumberOfVerses":267},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Balaamak Apajuí Israel aents aidaun pegkegnum yumigkiau asamtai, nuigtu awagkig Israel aents aidau pegkegchaunum yumigmainun dekaatasag wakekachui. Tuja yaunchuk Tuke Pujuu segajakbaujinak idayak uwegshunum Israel aents aidau batsatbaunmanini ayampa niimsauwai."]},{"type":"verse","number":2,"content":["Nuniak Israel aents aidau maki makichik wegantu doce aajakua nunú batsatun diittaman Apajuí Wakani",{"noteId":5},"ekemtujui."]},{"type":"verse","number":3,"content":["Dutika egkemtujam atakea duwi atinun juna aatus tiuwai:",{"lineBreak":true},{"text":"“Witjai Balaam Beoran uchiji,","poem":1},{"lineBreak":true},{"text":"wika Apajuí wakega nunak shiig dekajai.","poem":1},{"lineBreak":true},{"text":"Wi chicham etsegbau antuktajum.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wika Apajuí Wakani egkemjutjamtai","poem":1},{"lineBreak":true},{"text":"tikishmaja pujusan, paan wainjai.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"mina nii wakegamujin iwaintujak,","poem":1},{"lineBreak":true},{"text":"chicham etsegkatnun suja nuna ima shiig paan dekajai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Jacopa uchiji wegantu aidauwah,","poem":1},{"lineBreak":true},{"text":"atumi aakjum aidauk shiig pegkeg ainawai!","poem":1},{"lineBreak":true},{"text":"¡Israel aents aidauwah,","poem":1},{"lineBreak":true},{"text":"atum batsatjum duka shiig pegkejai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Palmera shiig kuashat tepajua imanai,","poem":1},{"lineBreak":true},{"text":"ajak ajakbau namaka uwet aiyama imanai,","poem":1},{"lineBreak":true},{"text":"ajak Apajuí ajakbau aiyama iman,","poem":1},{"lineBreak":true},{"text":"¡setug namaka uwet ayau","poem":1},{"lineBreak":true},{"text":"shiig pegkejama imanaitme!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel aents aidau uwagtinuk","poem":1},{"lineBreak":true},{"text":"yumi shiig kuashat aitnai.","poem":1},{"lineBreak":true},{"text":"Tuja dita ajak ajakma ukatkatnushkam","poem":1},{"lineBreak":true},{"text":"imanisag aittawai.","poem":1},{"lineBreak":true},{"text":"Ditá apujig tikich apu Agag daagtinun depetkatnai.","poem":1},{"lineBreak":true},{"text":"Tuja ditá senchijig shiig múun atinai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuí Israel aents aidau","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum batsatun jiijua nunuwai","poem":1},{"lineBreak":true},{"text":"búfalo ayamjumatai kachujiya numamtin.","poem":1},{"lineBreak":true},{"text":"Nuadui Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"ditá shiwaaji aidaunash amuktinai.","poem":1},{"lineBreak":true},{"text":"Dutikak nagkí iju mainak,","poem":1},{"lineBreak":true},{"text":"ukunchin kupijagtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Israel aents aidau ayamak tepakug,","poem":1},{"lineBreak":true},{"text":"león tepegama nujai betek tepenawai.","poem":1},{"lineBreak":true},{"text":"Iman asamtai, jegaantag ishintaumainchaudekapenawai.","poem":1},{"lineBreak":true},{"text":"¡Amina pegkegchaunum yumigtamaidauk,","poem":1},{"lineBreak":true},{"text":"ditashkam dutiksaik","poem":1},{"lineBreak":true},{"text":"pegkegchaunum yumigkiam agtinai,","poem":1},{"lineBreak":true},{"text":"untsu amina pegkegnum yumigtamaidauk,","poem":1},{"lineBreak":true},{"text":"ditashkam dutiksaik","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigkiam agtinai!” tiuwai.","poem":1}]},{"type":"heading","content":["Balaam Israel aents aidaun pachis etsegkamu"]},{"type":"verse","number":10,"content":["Nuna antuk Balac Balaaman senchi kajegkauwai. Nunik uwejen awati chichaak: “Wika aminak mina shiwag aina nunú pegkegchaunum yumigjata tusa untsukmagme, dutikamaitkum amek au aents aina nunú kampatuma imania pegkegnum yumigkiame."]},{"type":"verse","number":11,"content":["Nuniau asam ¡dekas jemin wakitkita! Wika aminak shiig kuashat akiktagme timajai. Tujash Tuke Pujuu dakittin, amek wainka juwakume”, tiuwai."]},{"type":"verse","number":12,"content":["Tusa tama Balaam Balakan ayaak: “Wika amina aentsjum chichama etsejin aidaun ujaakun,"]},{"type":"verse","number":13,"content":["ame pujusa inamtaigmin oro aidau, plata aidau piyak atsuash nunú mina ashí sujakminish, wika Apajuí tujutbaun intimjuknuk makichkish imannak tuja imanchaunakesh mina senchigjaig dutikmaitsujai. Ayatak Tuke Pujuu tujutbaunak tumainaitjai, tibaijai."]},{"type":"verse","number":14,"content":["Untsu dekas mina nugkajui wakitkitjai. Tujash eke wetsuk, au aents aina dusha amina aentsjum aidaunash atakea duwish itugkatnuk ainawa nuna ujaktajame”, tiuwai."]},{"type":"verse","number":15,"content":["Nuna tusa Balaam juna atak atinun etsejak aatus tiuwai:",{"lineBreak":true},{"text":"“Witjai Balaam Beoran uchijinuk,","poem":1},{"lineBreak":true},{"text":"wika shiig dekajai Apajuí wakegamua nunak.","poem":1},{"lineBreak":true},{"text":"Tuja wi chicham etsegbau antuktajum.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wika Apajuí Wakani egkemjutjamtai","poem":1},{"lineBreak":true},{"text":"tikishmaja pujusan, shiig paan wainjai","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunú nii wakegamujin mina iwaintujak,","poem":1},{"lineBreak":true},{"text":"chichaman etsegkatnun sujawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Makichik aentsun atushat wainjai.","poem":1},{"lineBreak":true},{"text":"Tuja makichik waji atushat aun wainjai:","poem":1},{"lineBreak":true},{"text":"Duka Jacob wegantunmaya makichik yaya wantinui,","poem":1},{"lineBreak":true},{"text":"nunuwai Israel aents aidaun apujig.","poem":1},{"lineBreak":true},{"text":"Nunú apua duka Moab aents aidaun depetuk amuka,","poem":1},{"lineBreak":true},{"text":"nuigtushkam Set wegantu aidaunash","poem":1},{"lineBreak":true},{"text":"dutiksag amuktinai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja Edom aents aidaunashkam depetkatnai.","poem":1},{"lineBreak":true},{"text":"Seír nugkanum ditá shiwaaji batsata nunash depetuk, nugken atankiag dita jukiagtinai.","poem":1},{"lineBreak":true},{"text":"Israel aents aidauk Edom aents aidaun depetuk dita senchijin iwainmamkagtinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Jacob wegantunmaya makichik senchigtin depetbau atinai,","poem":1},{"lineBreak":true},{"text":"nunú yaakat aidaunum","poem":1},{"lineBreak":true},{"text":"ujumak juwakag pujuidaun amuktinai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Nuna tusa Balaam Amalec aents aidau nugken ayampa wajas chichaak:",{"text":"“Amalec aents aidauk senchigtin","poem":1},{"lineBreak":true},{"text":"ajantusa diitai ainawai.","poem":1},{"lineBreak":true},{"text":"Tujash ashí tsaika emegkam atinai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Nuna tusa idayak Balaam quenita aents aidau nugken diisa chichaak:",{"text":"“Atum Caín wegantu aidautigmek ayamjumataijum shiig umikbau akuish,","poem":1},{"lineBreak":true},{"text":"tuja kaya múun aidaunum pishak pasugken","poem":1},{"lineBreak":true},{"text":"ekenag kuitamama numamtuk umikuitkugmesh,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"suntag asirianmaya aidau,","poem":1},{"lineBreak":true},{"text":"achigmajag yajupainak nunú pasugkem aina nunak","poem":1},{"lineBreak":true},{"text":"tsaika jiiyai apeawag utsagkagtinai”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["Tuja inagnak Balaam atak tikich tsawantai nagkaemagtinun pachis juna aatus tiuwai:",{"text":"“¡Chah! ¿Apajuí nuna dutiktata duwish, yaki eke","poem":1},{"lineBreak":true},{"text":"iwakush pujustinaita?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Chiprenmaya lancha nayantsanum suntajan yajuak minawai.","poem":1},{"lineBreak":true},{"text":"Nunú asirianmaya aidaun,","poem":1},{"lineBreak":true},{"text":"Hebernumia aidaujai amukagtinai,","poem":1},{"lineBreak":true},{"text":"dutikawag ditashkam jinawagtinai”, tiuwai.","poem":1}]},{"type":"verse","number":25,"content":["Nuna tusa ashí etsejuk Balaam jiinki weuwai niina jeen waketak. Nunikmatai Balakshakam niina pujusa inamtaijin wakitkiuwai."]}],"footnotes":[{"noteId":5,"caller":"+","text":"Apajuín Wakani egkemtujui tawa nunak Wakani Pegkejin taku tawai.","reference":{"chapter":24,"verse":2}}]},"thisChapterLink":"/api/agr_wbt/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/NUM/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}