":1},{"lineBreak":true},{"text":"pishakak nuna wainu asa","poem":1},{"lineBreak":true},{"text":"duka nagkaemamaitsui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tujash nunú aents aidauk","poem":1},{"lineBreak":true},{"text":"dita jamainnak dekainayatak","poem":1},{"lineBreak":true},{"text":"pempeentumakiag umigmamainawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nuadui aents magkagtin aina","poem":1},{"lineBreak":true},{"text":"duka wiakuch wetajai tukama,","poem":1},{"lineBreak":true},{"text":"dita pegkegchau takamtin","poem":1},{"lineBreak":true},{"text":"¡ditashkam dutiksaik maam ainawai!","poem":1}]},{"type":"heading","content":["Unuimat Apajuínmaya jukitajum tusa ipaamamu"]},{"type":"verse","number":20,"content":[{"text":"Unuimatak antugtuktinme tusa","poem":1},{"lineBreak":true},{"text":"jinta aidaunum untsumainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Unuimata duka yaakta waitijin,","poem":1},{"lineBreak":true},{"text":"tuja tuwig ima senchi aents aidaush","poem":1},{"lineBreak":true},{"text":"tuwawa nuwi aatus untsumainak:","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Datsauch imanis jintiag","poem":1},{"lineBreak":true},{"text":"anentaimchau aidauwah,","poem":1},{"lineBreak":true},{"text":"atumesh ¿wajutiya dushikagtutash,","poem":1},{"lineBreak":true},{"text":"kajegkagtutash idaisattagme?","poem":1},{"lineBreak":true},{"text":"Tuja unuimat dakitajum dusha","poem":1},{"lineBreak":true},{"text":"¿wajutiya idaisattagme?","poem":1},{"lineBreak":true},{"text":"¿Wajutiya unuimagtatjume?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wi tajim nunú antuktajum,","poem":1},{"lineBreak":true},{"text":"nuniakjumin wi atumnak","poem":1},{"lineBreak":true},{"text":"mina wakanjun amastatjime,","poem":1},{"lineBreak":true},{"text":"dutikakun mina anentaimtajun","poem":1},{"lineBreak":true},{"text":"dekamtikattajime.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wi atumnak untsuajime,","poem":1},{"lineBreak":true},{"text":"tuja wi ipaajime kaunatajum tusan,","poem":1},{"lineBreak":true},{"text":"tujash atumek mina antugtutak dakitagme.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nuniau asajum, mina chichamjuk","poem":1},{"lineBreak":true},{"text":"kajimatkijum idaisaugme,","poem":1},{"lineBreak":true},{"text":"tuja wi atumin jintinbau","poem":1},{"lineBreak":true},{"text":"antuka unuimatchakam dakitagme.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Nuadui wishakam","poem":1},{"lineBreak":true},{"text":"atum waitiakjuminish,","poem":1},{"lineBreak":true},{"text":"tuja sapigmakjuminish","poem":1},{"lineBreak":true},{"text":"ayatak dushittajai!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuja sapigmamu, waitut,","poem":1},{"lineBreak":true},{"text":"wake besemag pujamu,","poem":1},{"lineBreak":true},{"text":"waugkamin anentaibau aatus,","poem":1},{"lineBreak":true},{"text":"dase wainchijai betek","poem":1},{"lineBreak":true},{"text":"iyaak nugká ayaunak","poem":1},{"lineBreak":true},{"text":"ashí tsaiyama imanik minitjamkui,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"waitiakjum untsugkugminish,","poem":1},{"lineBreak":true},{"text":"wika aikchatnaitjime.","poem":1},{"lineBreak":true},{"text":"Egatkugmesh waitkashtinaitjume,","poem":1},{"lineBreak":true},{"text":"untsugkugmesh ayam achattagme.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wagki atumek unuimat","poem":1},{"lineBreak":true},{"text":"pegkeja duka dakitau asajum,","poem":1},{"lineBreak":true},{"text":"Apajuí umigtashkam dakitagme.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nuniau asajum, mina chichameg","poem":1},{"lineBreak":true},{"text":"a