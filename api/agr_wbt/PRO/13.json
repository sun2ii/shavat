{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Uchi shiig anentaimkauwa duka","poem":1},{"lineBreak":true},{"text":"niina apaji chichamen umignai,","poem":1},{"lineBreak":true},{"text":"untsu uchi anentainkachua duka","poem":1},{"lineBreak":true},{"text":"apaji chichamenak antugtsui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maki makichik aentsuk nii pegkeg chichakbaujinian pegkejan juwawai,","poem":1},{"lineBreak":true},{"text":"untsu aents chichaman betek umichu aina duka","poem":1},{"lineBreak":true},{"text":"dita pegkegchaujin suwimkan juwinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiig anentaimag chichauk","poem":1},{"lineBreak":true},{"text":"niina pujutjin kuitamak nuniawai,","poem":1},{"lineBreak":true},{"text":"untsu wainak chichá wekaguk kuashat utugchatan igkuawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aents dakia duka","poem":1},{"lineBreak":true},{"text":"nii wakegamujin jukitag takush juwatsui,","poem":1},{"lineBreak":true},{"text":"untsu aents takauwa nudauk","poem":1},{"lineBreak":true},{"text":"kuashat waji ajawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents pegkegchau takatan","poem":1},{"lineBreak":true},{"text":"tupanjauk waitjutnak dakitawai.","poem":1},{"lineBreak":true},{"text":"Untsu aents pegkegchaun takauk","poem":1},{"lineBreak":true},{"text":"eme anentsa diishtai,","poem":1},{"lineBreak":true},{"text":"datsan chichajam auwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Shiig anentaimsa pujamua nunú","poem":1},{"lineBreak":true},{"text":"aentsnak pegkeg emawai,","poem":1},{"lineBreak":true},{"text":"untsu aents pegkegchaun takau aina","poem":1},{"lineBreak":true},{"text":"nunak niina pegkegchaujig bakuawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Awai aents makichkish wajigtuchuitak","poem":1},{"lineBreak":true},{"text":"wiakuch atajai tusa wakegau,","poem":1},{"lineBreak":true},{"text":"tuja antsag kuashat wajigtin aidaushkam","poem":1},{"lineBreak":true},{"text":"wajigtuchuapi tujuttinme tusa uumush ainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aents wiakcha duka achikmak,","poem":1},{"lineBreak":true},{"text":"mantuawainum tusa ishamkagtak","poem":1},{"lineBreak":true},{"text":"niina kuichkijin ashí akikmak uwemainai,","poem":1},{"lineBreak":true},{"text":"untsu ujunauchik achigkachagtimpash","poem":1},{"lineBreak":true},{"text":"tusa anentaimkug waitiatsui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aents pegkegchau takatan","poem":1},{"lineBreak":true},{"text":"tupanjau aina duka tsaaptin pegkeg winchamtinama iman ainawai,","poem":1},{"lineBreak":true},{"text":"untsu aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"jii kajinkaujai betekai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ememata duka ima maanitnak inimui;","poem":1},{"lineBreak":true},{"text":"untsu unuimata nunú","poem":1},{"lineBreak":true},{"text":"aents chichama antuk umin aina nuwi awai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yupichuch wiakchameamua duka","poem":1},{"lineBreak":true},{"text":"wamak amugak megkaewai;","poem":1},{"lineBreak":true},{"text":"tuja aents shiig takak,","poem":1},{"lineBreak":true},{"text":"diipas wiakchamea duka kuashat ikauwai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuja ii wakegamu uminchakuig,","poem":1},{"lineBreak":true},{"text":"wake besemag dekapnawai.","poem":1},{"lineBreak":true},{"text":"Untsu ii atsumamu betek uminkuig,","poem":1},{"lineBreak":true},{"text":"shiig aneamu ajutkagtawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aents chichaman umiachuk","poem":1},{"lineBreak":true},{"text":"suwimkan jukitnai;","poem":1},{"lineBreak":true},{"text":"untsu chichaman umiauk akiam atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aents shiig anentaimkau","poem":1},{"lineBreak":true},{"text":"jintinkagtamua duka pujutan sukagtawai,","poem":1},{"lineBreak":true},{"text":"nuadui jamainun uwemtikagtawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Shiig jintinkagtauk shiig anentam auwai,","poem":1},{"lineBreak":true},{"text":"untsu shiig jintinkagtachuk","poem":1},{"lineBreak":true},{"text":"pegkegchaunum jegantinai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aents yacha shiig anentaimkauwa duka","poem":1},{"lineBreak":true},{"text":"shiig anentaimag takawai,","poem":1},{"lineBreak":true},{"text":"untsu aents anentainkachua duka","poem":1},{"lineBreak":true},{"text":"nii dekachbaujiya nuna iwaintumawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aents chichaman betek etsegchauwa","poem":1},{"lineBreak":true},{"text":"duka utugchatan apujui,","poem":1},{"lineBreak":true},{"text":"untsu chichaman shiig","poem":1},{"lineBreak":true},{"text":"betek etsegna nunú","poem":1},{"lineBreak":true},{"text":"aentsnak shiig anemtikawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Aents chichagkatatama dakitauk,","poem":1},{"lineBreak":true},{"text":"waittanum, datsannum pujutnai;","poem":1},{"lineBreak":true},{"text":"untsu chichaman antuk umiauk,","poem":1},{"lineBreak":true},{"text":"eme anentam atinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ii wakegamu uminkuig shiig aneenui;","poem":1},{"lineBreak":true},{"text":"tuja aents anentainkachu aina duka","poem":1},{"lineBreak":true},{"text":"pegkegchau takat idaitanak atsanenatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aents yacha aidaujai tsaniauk,","poem":1},{"lineBreak":true},{"text":"niishkam yacha atinai,","poem":1},{"lineBreak":true},{"text":"untsu aents shiig anentainkachu aina nujai tsaniauk, pegkegchaunum jegatnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}