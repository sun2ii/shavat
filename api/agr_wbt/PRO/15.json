u chichamua nunú aentsu pujutin emestawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aents anentainkachua duka","poem":1},{"lineBreak":true},{"text":"niina apaji jintinmash dakitawai,","poem":1},{"lineBreak":true},{"text":"untsu yacha shiig anentaimkauwa duka niina apaji chichamen antujui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aents Apajuí umigna duka","poem":1},{"lineBreak":true},{"text":"shiig kuashat wajigtinai,","poem":1},{"lineBreak":true},{"text":"untsu aents pegkegchauwa nunak","poem":1},{"lineBreak":true},{"text":"niina wajijiya duke utugchatan itajui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aents yacha shiig anentaimkauwa duka","poem":1},{"lineBreak":true},{"text":"nii dekamujin tikich aentsnash","poem":1},{"lineBreak":true},{"text":"pegkejan jintintui.","poem":1},{"lineBreak":true},{"text":"Untsu aents anentainkachu aina duka","poem":1},{"lineBreak":true},{"text":"pegkegchauwa nuna jintintui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"Apajuí anentag suwaji tusag,","poem":1},{"lineBreak":true},{"text":"kuntinun maa apeena duka","poem":1},{"lineBreak":true},{"text":"Tuke Pujuunak shiig awagmatsui.","poem":1},{"lineBreak":true},{"text":"Untsu aents pegkegchau takatan tupanjau aina","poem":1},{"lineBreak":true},{"text":"nunú segamak Apajuík shiig antujui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tuke Pujuuk aents pegkegchau aina","poem":1},{"lineBreak":true},{"text":"nuna pujutjinak dakitawai,","poem":1},{"lineBreak":true},{"text":"untsu ya tudaun tupantug","poem":1},{"lineBreak":true},{"text":"pegkejan takak pujawa nuna aneawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/20.json","nextChapterAudioLin