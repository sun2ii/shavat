{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Vino nampeamua nunú","poem":1},{"lineBreak":true},{"text":"aentsun pegkegchau chichamtin emawai;","poem":1},{"lineBreak":true},{"text":"uwaja nampetai aina duka utugchatan inimui;","poem":1},{"lineBreak":true},{"text":"nuna uwag nampeauk shiig anentaimag chichatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apu kajena duka","poem":1},{"lineBreak":true},{"text":"león kajeak shinuwama imanai;","poem":1},{"lineBreak":true},{"text":"tuja nuna apun ikajeauk nigki bakumawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aents pegkegchau takatan","poem":1},{"lineBreak":true},{"text":"tupanjauk jiyanitnak dakitawai;","poem":1},{"lineBreak":true},{"text":"untsu anentainkachua duka jiyanitan wekaetawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aents dakia duka aja takamain esat tepeau aig,","poem":1},{"lineBreak":true},{"text":"takatsuk pujau asa,","poem":1},{"lineBreak":true},{"text":"yumi tepeamtai nii yumainjig atsugtinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aentsu anentaimtajig","poem":1},{"lineBreak":true},{"text":"nayantsa kunajinia wainmaitsu numamtinai.","poem":1},{"lineBreak":true},{"text":"Untsu aents yacha duka","poem":1},{"lineBreak":true},{"text":"nuna takumpap tawa tusa shiig dekawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuashat aents aidau,","poem":1},{"lineBreak":true},{"text":"amina kumpauchijum atajai tuinawai;","poem":1},{"lineBreak":true},{"text":"¿tujash dekas aents imanush igkumainashit?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Aents pegkegchau takatan","poem":1},{"lineBreak":true},{"text":"tupanjau aidaun uchiji aidauk,","poem":1},{"lineBreak":true},{"text":"dita apaji pegkejan takajaku aina nujai betek","poem":1},{"lineBreak":true},{"text":"pegkejan takainak,","poem":1},{"lineBreak":true},{"text":"Apajuí yayamu asag shiig aneasagtinai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":7}