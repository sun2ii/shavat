"text":"eme anentam atan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aina nuna","poem":1},{"lineBreak":true},{"text":"tsanumtaiji aidauk ishamain ainawai.","poem":1},{"lineBreak":true},{"text":"Untsu aents niina pujutjin","poem":1},{"lineBreak":true},{"text":"kuitama duka nunak tupantawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amina uchigmek piipichia duik shiig jintintuata,","poem":1},{"lineBreak":true},{"text":"dutikamu asa múun wajasash kajimatkishtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":6}