{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":23,"content":[{"type":"verse","number":4,"content":[{"text":"Wiakuch atajai tusam","poem":1},{"lineBreak":true},{"text":"anentaimkum waittsaipa,","poem":1},{"lineBreak":true},{"text":"duka puyatjutsuk idaisata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ame shiig anentaimsa diyakmek,","poem":1},{"lineBreak":true},{"text":"wiakuch wetak wainkaya nunú dekaattame,","poem":1},{"lineBreak":true},{"text":"wagki duka águila uchiji aidau","poem":1},{"lineBreak":true},{"text":"nanapjuk nanaak shimak megkagama","poem":1},{"lineBreak":true},{"text":"numamtuk megkaewai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uchuchih, wi tajam nunú","poem":1},{"lineBreak":true},{"text":"shiig antukam unuimagta,","poem":1},{"lineBreak":true},{"text":"nuniakum shiig anentaimsam pegkeg takata duke takasta.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aents nampeku aidaujai","poem":1},{"lineBreak":true},{"text":"ijunjamek wekaesaipa,","poem":1},{"lineBreak":true},{"text":"tuja ushu aina nujaishkam kumpajinawaipa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wagki nampen aidauk,","poem":1},{"lineBreak":true},{"text":"ushu aidauk, ujuuna wenawai,","poem":1},{"lineBreak":true},{"text":"tuja daki aidauk jáanch pegkegchau","poem":1},{"lineBreak":true},{"text":"ampinkau mamuku aidaun apajag nugkuinawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apa amina akimpawa","poem":1},{"lineBreak":true},{"text":"nuna chichame antugkata;","poem":1},{"lineBreak":true},{"text":"tuja amina duku múuntuch","poem":1},{"lineBreak":true},{"text":"wajasmataish dakitjaipa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dekaskea nunú, yachameta nunú,","poem":1},{"lineBreak":true},{"text":"jintinjamamu aina nunú,","poem":1},{"lineBreak":true},{"text":"unuimata nunú aatsam sumakta.","poem":1},{"lineBreak":true},{"text":"¡Dutikamek duka sujukaipa!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Uchi pegkeg, yacha,","poem":1},{"lineBreak":true},{"text":"shiig anentaimkauwa nuna apajig","poem":1},{"lineBreak":true},{"text":"shiig aneak ememas anentaimui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¡Yajauwajah, uchi yacha shiig anentaimkau aidaunmak!","poem":1},{"lineBreak":true},{"text":"Nuadui uchita atumek atumi apa dukujai","poem":1},{"lineBreak":true},{"text":"shiig anemtiksatajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Uchuchih,","poem":1},{"lineBreak":true},{"text":"wi tajam nunú shiig antukta,","poem":1},{"lineBreak":true},{"text":"nuniakum wi jintintuawaitjam nunú kajimatkipa;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"wagki nuwa akika dutiktai aina duka","poem":1},{"lineBreak":true},{"text":"waa múun suwe ishamainama imanai;","poem":1},{"lineBreak":true},{"text":"tuja nuwa aishintin tikichjai","poem":1},{"lineBreak":true},{"text":"tsanijinna dushakam waa tsejegkush,","poem":1},{"lineBreak":true},{"text":"init akagama numamtinai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nuadui kasajai betek","poem":1},{"lineBreak":true},{"text":"kuashat aishmag aidaun achiawai,","poem":1},{"lineBreak":true},{"text":"dutika aents nuna yujajin aina","poem":1},{"lineBreak":true},{"text":"nujai betek emawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"¿Yaita waitiaush?","poem":1},{"lineBreak":true},{"text":"¿Ya waitiakush ejetua?","poem":1},{"lineBreak":true},{"text":"¿Yaita utugchatan apujus","poem":1},{"lineBreak":true},{"text":"anentaimak waitu wekagush?","poem":1},{"lineBreak":true},{"text":"¿Yaita nigki suwimkan sumamas waitiaush?","poem":1},{"lineBreak":true},{"text":"¿Yaita bushapajun niim wekagush?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nunak vino uwaja,","poem":1},{"lineBreak":true},{"text":"nampetan makichkish idaitsuk,","poem":1},{"lineBreak":true},{"text":"tikich umutai aidaunashkam umú yujau aina nunú","poem":1},{"lineBreak":true},{"text":"nunak núninawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¡Datsauchih, uwaja nampetai aidau","poem":1},{"lineBreak":true},{"text":"kajiak niime pegkeg wega duka","poem":1},{"lineBreak":true},{"text":"makichkish anentaimtusmek diisaipa!","poem":1},{"lineBreak":true},{"text":"¡Nunú diyakmek wakejukam uwagtatme!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuja niimeg pegkejaitak,","poem":1},{"lineBreak":true},{"text":"dapi esajatbau tsaagke najamama imanai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Iman asamtai nunú umakmek,","poem":1},{"lineBreak":true},{"text":"pegkegchau wainchatai aidau waintatme,","poem":1},{"lineBreak":true},{"text":"tuja pegkegchau anentaimkum","poem":1},{"lineBreak":true},{"text":"ima pegkegchauk chichattame.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nuniakum lanchanum egkemjanus","poem":1},{"lineBreak":true},{"text":"yakí jiitkaunum ekemsan nayantsanum","poem":1},{"lineBreak":true},{"text":"wegagtai dekaptatme.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nuniakum: “Awatujagmae,","poem":1},{"lineBreak":true},{"text":"tujash dekapjachmajai;","poem":1},{"lineBreak":true},{"text":"asutuinakuish dekapjachmajai;","poem":1},{"lineBreak":true},{"text":"tujash nunak puyatjatsjai,","poem":1},{"lineBreak":true},{"text":"juna sakapagnuk nantakin vino egakan,","poem":1},{"lineBreak":true},{"text":"nuni kuashat uwagtatjai”, titatme.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":19}