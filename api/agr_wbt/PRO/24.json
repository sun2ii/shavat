{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":24,"content":[{"type":"verse","number":3,"content":[{"text":"Jegak shiig anentaimsa jegamtayai,","poem":1},{"lineBreak":true},{"text":"tuja shugkushkam","poem":1},{"lineBreak":true},{"text":"shiig anentaimsa ajitayai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waji pegkejuch wakejumain aidau","poem":1},{"lineBreak":true},{"text":"ijumaina numamtuk, unuimata nuna","poem":1},{"lineBreak":true},{"text":"niina kanutaiji aidaunum ijumui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents yacha nunuwai tikich aents","poem":1},{"lineBreak":true},{"text":"senchigtina nuna nagkaesauk.","poem":1},{"lineBreak":true},{"text":"Unuimata nunuwai dekas","poem":1},{"lineBreak":true},{"text":"senchigtin ata nuna nagkaesauk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wagki maaniatag takuik, shiig anentaimsa","poem":1},{"lineBreak":true},{"text":"chicham umika maanitayai,","poem":1},{"lineBreak":true},{"text":"tuja depetmaktatus wakegauk","poem":1},{"lineBreak":true},{"text":"tikichi chichamenash shiig antuku amainai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Amina shiwaajum waituinakuish,","poem":1},{"lineBreak":true},{"text":"shiig aneakjum dushikjaigpajum,","poem":1},{"lineBreak":true},{"text":"tuja utugchatji ajakuish dushikjaigpa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wagki duka Tuke Pujuunak shiig awagmatsui,","poem":1},{"lineBreak":true},{"text":"nuniau asa amina kajegtamak suwimkan amamainai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidau diisam kajekaipa,","poem":1},{"lineBreak":true},{"text":"tuja niina wajiji aidau","poem":1},{"lineBreak":true},{"text":"diigsamesh kajegkaipa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wagki aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"pegkeg pujutnakesh jukishtinai.","poem":1},{"lineBreak":true},{"text":"¡Aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"lampara ikagnakbaujai betek agtinai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":8}