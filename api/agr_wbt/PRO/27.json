{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Kashin nuna imatikan takastatjai","poem":1},{"lineBreak":true},{"text":"tusamek emtikamek tumamipa,","poem":1},{"lineBreak":true},{"text":"wagki amek dekatsme","poem":1},{"lineBreak":true},{"text":"kashinish wajukatamki duka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Duka amekek imatipa,","poem":1},{"lineBreak":true},{"text":"idaisata nunak tikich aidau tujamtinme,","poem":1},{"lineBreak":true},{"text":"iik eme anenmamku","poem":1},{"lineBreak":true},{"text":"imatbauk pegkegchauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kaya, kamatak aina duka","poem":1},{"lineBreak":true},{"text":"senchi kijin ainawai,","poem":1},{"lineBreak":true},{"text":"tujash nuna nagkaesau kijinai","poem":1},{"lineBreak":true},{"text":"aents anentainkachu nii wakegamun","poem":1},{"lineBreak":true},{"text":"umiktakama kajeamujiya nunú.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kajeamua duka pegkegchauwai, tutitjan itawai,","poem":1},{"lineBreak":true},{"text":"tujash nuna nagkaesau","poem":1},{"lineBreak":true},{"text":"kakajus depetmainchauwa duka,","poem":1},{"lineBreak":true},{"text":"tikich takakui diisa kajegkagtamua nunuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aents amina anempa duka","poem":1},{"lineBreak":true},{"text":"uuka chichá wekaetsuk,","poem":1},{"lineBreak":true},{"text":"paan igkumpa tujamtatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiwag kajegtamiatak tsanupak kumpamjama nunú kajittsa diitsuk,","poem":1},{"lineBreak":true},{"text":"dekas iina kumpaji igkujatua tukagta nuwi","poem":1},{"lineBreak":true},{"text":"kajintsa anentaimainai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":6}