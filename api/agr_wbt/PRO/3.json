{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":3,"content":[{"type":"heading","content":["Unuimat pachisa ujaniamu"]},{"type":"verse","number":1,"content":[{"text":"Uchuchih, wi jintinkagtamua nunú kajimatkipa,","poem":1},{"lineBreak":true},{"text":"tuja mina chichameg umiktin agagbauwa nunú","poem":1},{"lineBreak":true},{"text":"amina anentaimin jukita.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunú umiakum, kuashat tsawan iwaku shiig aneasam pujustinaitme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja anenka duka, dekaskea nujai","poem":1},{"lineBreak":true},{"text":"makichkish idaisatin aipa;","poem":1},{"lineBreak":true},{"text":"duka nugkutaijai betek nugkuaju ata.","poem":1},{"lineBreak":true},{"text":"Amina anentaimtagmin","poem":1},{"lineBreak":true},{"text":"kajimatmainchau aneaku ata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuniakum Apajuí wait anentam atatme,","poem":1},{"lineBreak":true},{"text":"tuja aents aidaushkam wait anenjamjagtatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amina dekatjumin kajinmamsa anentaimtsuk,","poem":1},{"lineBreak":true},{"text":"ima Tuke Pujuuwaig ashí","poem":1},{"lineBreak":true},{"text":"kajinmamsam anentaimta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ashí ame takattam duka","poem":1},{"lineBreak":true},{"text":"Apajuí anentaimtusam takasta,","poem":1},{"lineBreak":true},{"text":"nuniamin nii pujut pegkegnum etamtatui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ame ima yacha jumamipa,","poem":1},{"lineBreak":true},{"text":"duka nunitsuk Tuke Pujuu umigkata,","poem":1},{"lineBreak":true},{"text":"nuniakum pegkegchau aina nunú tupanjata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuniakum jamamtuchu,","poem":1},{"lineBreak":true},{"text":"wajiu pegkeg pujuttame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amina tagkujum aidau, wajijum aidau","poem":1},{"lineBreak":true},{"text":"akanka Tuke Pujuu suwakum emematta;","poem":1},{"lineBreak":true},{"text":"dutikakum ajak ajakmamu aina","poem":1},{"lineBreak":true},{"text":"nuwiyashkam yama nagkamchaku","poem":1},{"lineBreak":true},{"text":"juukbau Tuke Pujuu susata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dutikakum yutanmash,","poem":1},{"lineBreak":true},{"text":"tuja umutnumash atsumkas pujuttame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uchuchih,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu esetamatatus","poem":1},{"lineBreak":true},{"text":"suwimkan amaakuig dakitjaipa,","poem":1},{"lineBreak":true},{"text":"tuja nii chichagtamkuish kajekaipa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuk","poem":1},{"lineBreak":true},{"text":"makichik múun uchijin jintintak,","poem":1},{"lineBreak":true},{"text":"suwimkan suwama numamtuk,","poem":1},{"lineBreak":true},{"text":"nii aneamu aidaun","poem":1},{"lineBreak":true},{"text":"jintintak suwimkan suwawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Datsauch unuimaju,","poem":1},{"lineBreak":true},{"text":"shiig anentaimkauwa nunak","poem":1},{"lineBreak":true},{"text":"Apajuí pegkegnum yumigkiawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Nunú unuimata nunuwai oron nagkaesau,","poem":1},{"lineBreak":true},{"text":"plata nagkaesau pegkeja duka!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Unuimat shiig anentaimja","poem":1},{"lineBreak":true},{"text":"pujutan sukagta duka,","poem":1},{"lineBreak":true},{"text":"kaya shiig pegkejuch akik aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesauwai.","poem":1},{"lineBreak":true},{"text":"¡Iman asa tikich waji pegkeg","poem":1},{"lineBreak":true},{"text":"wakejumain aina nujaigkish betekchauwai!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aents unuimaju, yacha duka","poem":1},{"lineBreak":true},{"text":"kuashat mijan pujustinai,","poem":1},{"lineBreak":true},{"text":"nunik wiakuch wajas eme anentam atinai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apajuín chichame umiamua","poem":1},{"lineBreak":true},{"text":"nunú ima pegkejai,","poem":1},{"lineBreak":true},{"text":"tuja nii jintinkagtamu","poem":1},{"lineBreak":true},{"text":"betek umiamua nunú","poem":1},{"lineBreak":true},{"text":"agkan pujutan sukagtawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Shiig anentaimja pujutan unuimaina","poem":1},{"lineBreak":true},{"text":"nunú pujutan juwinawai.","poem":1},{"lineBreak":true},{"text":"Shiig anentaimja pujutan juidauk,","poem":1},{"lineBreak":true},{"text":"numi pujuta sukagtinjai betek ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú unuimatan jukiaju aidauk","poem":1},{"lineBreak":true},{"text":"shiig aneasagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":18}