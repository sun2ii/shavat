{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":31,"content":[{"type":"heading","content":["Nuwa pegkegeme anentsa diitai"]},{"type":"verse","number":10,"content":[{"text":"Nuwa shiig anentaimkauk","poem":1},{"lineBreak":true},{"text":"kakajus igkumaitsui,","poem":1},{"lineBreak":true},{"text":"¡kaya pegkejuch akik aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesauwai!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niina aishig shiig kajitus diyawai,","poem":1},{"lineBreak":true},{"text":"tuja kuichkinash atsumchagtinai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niina aishig, nuwe utugchatan apujtus","poem":1},{"lineBreak":true},{"text":"waitkachbau asa,","poem":1},{"lineBreak":true},{"text":"tuké shiig aneas pujawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lanan ujuchjai egaka sumak,","poem":1},{"lineBreak":true},{"text":"nuna wakejus shiig aneas jáanchi apijug najanak pujawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lancha wajiin atushtanmayan ikaunmama numamtuk,","poem":1},{"lineBreak":true},{"text":"nunú nuwa dita yuwatnujinak atushtanmayan ikaunmawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dutika eke tsawatsaig nantaki,","poem":1},{"lineBreak":true},{"text":"yutain inajuk uchiji aidaun","poem":1},{"lineBreak":true},{"text":"inake aidaujai ayujuk,","poem":1},{"lineBreak":true},{"text":"inake aidaunak takatnum ishimui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja nugka pegkejan diisa,","poem":1},{"lineBreak":true},{"text":"nuna akikenak nii takasa jukimui","poem":1},{"lineBreak":true},{"text":"betek akikmak sumawai.","poem":1},{"lineBreak":true},{"text":"Dutika nuwi uvan ajakmawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aatus kakaag senchi takau asa,","poem":1},{"lineBreak":true},{"text":"shiig aneas kashikmas nagkama taka takakua etsa akapak ukuawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wajiji kuashat kawegti tau asa nii kuitamui,","poem":1},{"lineBreak":true},{"text":"tuja kashish takau asamtai, jii tuké keeka awai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja niina jáanchjinash","poem":1},{"lineBreak":true},{"text":"nigki apaja nugkuawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuja ujudauch aidau","poem":1},{"lineBreak":true},{"text":"atsumiagtaish, yayawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsetsek tepetaish,","poem":1},{"lineBreak":true},{"text":"niina uchiji aidaunak puyatjatsui,","poem":1},{"lineBreak":true},{"text":"wagki ditak jáanchin shiig nugkujag yujaidau asagmatai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Colchajinash nigki najanui,","poem":1},{"lineBreak":true},{"text":"tuja niig jáanch shiig pegkeg","poem":1},{"lineBreak":true},{"text":"apagbau aidaun nugkuawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja niina aishinashkam","poem":1},{"lineBreak":true},{"text":"yaaktanmaya aidauk ashí wainainawai,","poem":1},{"lineBreak":true},{"text":"wagki apu eme anentsa diitai aina nuwi niishkam","poem":1},{"lineBreak":true},{"text":"pachitkau asamtai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nunú nuwak jáanch aidaun","poem":1},{"lineBreak":true},{"text":"akachumtai aidaujai najanak,","poem":1},{"lineBreak":true},{"text":"waji sujin aidaunum sujawai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Eme anentsa diitai asa,","poem":1},{"lineBreak":true},{"text":"nuna megkaekaig tusa kuitamamui.","poem":1},{"lineBreak":true},{"text":"Tuja atakea duish wajukatnukitja","poem":1},{"lineBreak":true},{"text":"tusagkesh puyatmamtsui.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Chichaakush shiig anentaimas chichawai,","poem":1},{"lineBreak":true},{"text":"tuja niina uchijinash shiig anentus jintintui.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Niina jeen utugchat ai tusa aneaku pujawai,","poem":1},{"lineBreak":true},{"text":"tuja nii takasa jukichbaujinianak yuwatsui.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nuadui niina uchiji aidau","poem":1},{"lineBreak":true},{"text":"niina aishijai emematus chichajuinak:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"“¡Nuwa pegkeg aidauk kuashat ayawai,","poem":1},{"lineBreak":true},{"text":"tujash ametme ashí tikich nuwa aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesaumek!” tuinawai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nuwa shigmaji diisa wakejamua duka wainkayai,","poem":1},{"lineBreak":true},{"text":"tuja shiig awajkagtamujia","poem":1},{"lineBreak":true},{"text":"dushakam wainkayai,","poem":1},{"lineBreak":true},{"text":"dekas nuwa Tuke Pujuun umigna","poem":1},{"lineBreak":true},{"text":"nunuwai ememattsa diyam auwa duka.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¡Niina takatji pegkeja nunú anentaimtusjum,","poem":1},{"lineBreak":true},{"text":"ashí aents aidau emtin eme anentsajum","poem":1},{"lineBreak":true},{"text":"pegkegnum chichagtajum!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ECC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":22}