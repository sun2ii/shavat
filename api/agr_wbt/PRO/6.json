{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":6,"content":[{"type":"heading","content":["Daki aipa"]},{"type":"verse","number":6,"content":[{"text":"Dakih, week wajuk takawa","poem":1},{"lineBreak":true},{"text":"nunú weme diisam unuimagta:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Weeka inauk atsawai,","poem":1},{"lineBreak":true},{"text":"tuja nunú dutikata tusa","poem":1},{"lineBreak":true},{"text":"tumainchakam atsawai,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nuniaig nii yuwatnujinak esattin","poem":1},{"lineBreak":true},{"text":"ajak juut jegamtai, juuka ijumui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Dakih, yamai kanaschaum jamah!","poem":1},{"lineBreak":true},{"text":"¿Wajupa asamea nantaktatme?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ame kanú tepamin,","poem":1},{"lineBreak":true},{"text":"tuja kajim mantamkui pukuga eketmin,","poem":1},{"lineBreak":true},{"text":"tuja shiig kanagtasam","poem":1},{"lineBreak":true},{"text":"pagku pagkumasa tepamin,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"waitut, kasajai betek pachiachbau iyanjama","poem":1},{"lineBreak":true},{"text":"shiig ujuuna awajtamsattawai.","poem":1}]},{"type":"heading","content":["Apajuí dakitamua nunú"]},{"type":"verse","number":16,"content":[{"text":"Awai seisa imajin, tuja nuigtu","poem":1},{"lineBreak":true},{"text":"makichik, nujai ijumjamak sieteya imani","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu shiig dakita nunú:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Emebau aidaun, waitjin aidaun,","poem":1},{"lineBreak":true},{"text":"aents utugchatji atsujunak main aidaun,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"aents anentaimtaji pegkegchau aidaun,","poem":1},{"lineBreak":true},{"text":"pegkegchau takatan wakejus wekaetaun,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"tikichin tsanumjin,","poem":1},{"lineBreak":true},{"text":"tuja waitjin, chichama tsanumjug","poem":1},{"lineBreak":true},{"text":"niina yachijaig maanimitkau aidaun","poem":1},{"lineBreak":true},{"text":"aatus Apajuík dakitawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}