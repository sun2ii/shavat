{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PRO","translationId":"agr_wbt","name":"Proverbios","commonName":"Proverbios","title":"Pujutan wakannumiajai pachis jintiamu Proverbios","order":20,"numberOfChapters":15,"sha256":"ebfa53460b31e6b8f7beb1dfc70a57dcabffc93fef60eeaa6601a8b0d5be67be","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/agr_wbt/PRO/31.json","totalNumberOfVerses":225},"chapter":{"number":7,"content":[{"type":"heading","content":["Nuwa aishin pegkegchau takajin aidau ujaamu"]},{"type":"verse","number":1,"content":[{"text":"¡Uchuchih, mina chichameg umikta,","poem":1},{"lineBreak":true},{"text":"mina chichameg umiktin agagbauwa nunú","poem":1},{"lineBreak":true},{"text":"shiig aneaku ata!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mina chichameg umiktin","poem":1},{"lineBreak":true},{"text":"agagbau aina nunú umikta;","poem":1},{"lineBreak":true},{"text":"dutikakum amina jiim kuitamainaitam imatiksam kuitamkata,","poem":1},{"lineBreak":true},{"text":"nuniakum iwaku pujuttame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amina tsajam uwegmin jigka nenau ata,","poem":1},{"lineBreak":true},{"text":"anentaimin kajimatmainchau, aneaku ata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unuimata duka amina umaimijai betek emata,","poem":1},{"lineBreak":true},{"text":"tuja yachameta nunú amina kumpajum emata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja nuwa aishin pegkegchaun takamjin,","poem":1},{"lineBreak":true},{"text":"pegkegchin chichagtamak,","poem":1},{"lineBreak":true},{"text":"tsanuja pegkegchaun takamtiksai tusa,","poem":1},{"lineBreak":true},{"text":"unuimata nunú ayamjutpaktatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Makichik tsawantai jeganum","poem":1},{"lineBreak":true},{"text":"niimtai ujaimunum wi niimkun wajayajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nunika niimku wajai,","poem":1},{"lineBreak":true},{"text":"uchi datsa imanik jintiag","poem":1},{"lineBreak":true},{"text":"anentaimkachu aidau yujainamunum,","poem":1},{"lineBreak":true},{"text":"nuwi makichik datsauch nuni nagkaemas","poem":1},{"lineBreak":true},{"text":"shiig esegag anentaimkachun wainkabiajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nunú uchik jinta aintug juwaki,","poem":1},{"lineBreak":true},{"text":"jinta tuniakbaunum jeganta","poem":1},{"lineBreak":true},{"text":"nunú nuwa jeega nuni wemayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuniaig etsa akaemayi,","poem":1},{"lineBreak":true},{"text":"nuniak suwe wemayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuniai nuwa akika dutiktai iwagmamin","poem":1},{"lineBreak":true},{"text":"aina nujai betek, makichik nuwa iwagmamjau,","poem":1},{"lineBreak":true},{"text":"pegkegchaun takamin asa","poem":1},{"lineBreak":true},{"text":"nunú anentaiyai jiinkibi uchin igkugtatus.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nunú nuwak setakchau datsantainkachu,","poem":1},{"lineBreak":true},{"text":"tuja emetnag jeen titu pujuchu,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"jinta ain wekayin, tuja plazanum,","poem":1},{"lineBreak":true},{"text":"jinta tuniakunum aents nagkaebaun igkug,","poem":1},{"lineBreak":true},{"text":"pegkegchau takamtiksatatus wekayin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nunin asa nunú uchi wetatman","poem":1},{"lineBreak":true},{"text":"pagkuk saukua ajantsuk chichajak:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Wi mina apajuímtaiju","poem":1},{"lineBreak":true},{"text":"emematkun kuntinun maamua","poem":1},{"lineBreak":true},{"text":"nuna nejen ajamsatjame.","poem":1},{"lineBreak":true},{"text":"Wi dutikatjai tibaugnak yamai betek umikjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuadui amina igkugtasan jiinkijai,","poem":1},{"lineBreak":true},{"text":"amina wainkatasan shiig senchi","poem":1},{"lineBreak":true},{"text":"egamjam nuna yamai igkugjame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mina pegakjui,","poem":1},{"lineBreak":true},{"text":"colcha egiptunmaya lino","poem":1},{"lineBreak":true},{"text":"pegkeg najanamun ainkamjai,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"dutikan kugkuin pegkeg mirra,","poem":1},{"lineBreak":true},{"text":"áloe, canela aidauwai ukatkamjai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wayata nunikamin ii wakegamu a aniakua tuke tsawampagmi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mina aishjuk atsawai;","poem":1},{"lineBreak":true},{"text":"tikich nugkanum wemayi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kuichkin aimak juki wemayi,","poem":1},{"lineBreak":true},{"text":"nuadui wamkek tashtatui,","poem":1},{"lineBreak":true},{"text":"nantu antumai taattawai”, tau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tusa pegkegchin ima","poem":1},{"lineBreak":true},{"text":"imatjakua wakemitkakmayi,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"dutikam buey maatasa","poem":1},{"lineBreak":true},{"text":"juki ematiama numamtuk,","poem":1},{"lineBreak":true},{"text":"tuja kuntin maatasa dakamtikamunum","poem":1},{"lineBreak":true},{"text":"japa egkemkamtai,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"flechayai anentai ijutim","poem":1},{"lineBreak":true},{"text":"jama numamtuk wajaktatus,","poem":1},{"lineBreak":true},{"text":"tuja pishak achiktasa","poem":1},{"lineBreak":true},{"text":"detua ukukbaunum awimpap","poem":1},{"lineBreak":true},{"text":"jakattaja tusa dekachu asa,","poem":1},{"lineBreak":true},{"text":"wemaina numamtuk nuwan pataetuk megkaekabi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nunika megkaekatag tachakmek","poem":1},{"lineBreak":true},{"text":"uchuchih, mina chichameg antukam umikta.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amek nunú nuwa duka","poem":1},{"lineBreak":true},{"text":"anentaimtusmek diisaipa.","poem":1},{"lineBreak":true},{"text":"Wagki nunú wekaetakum,","poem":1},{"lineBreak":true},{"text":"amina pujutjumin megkaekaim.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nunú nuwa duka kuashat aentsun","poem":1},{"lineBreak":true},{"text":"pegkegchaun takamtikas emegkawai.","poem":1},{"lineBreak":true},{"text":"¡Nii emegkagbau aidauk shiig kuashtai!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuja niina jeen wayamua duka","poem":1},{"lineBreak":true},{"text":"jaka megkaemaina nujai betekai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}