aidautigmek,","poem":1},{"lineBreak":true},{"text":"eseja anentaimat unuimagtajum.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pegkeg unuimamainun","poem":1},{"lineBreak":true},{"text":"wi titatjim nunú shiig antuka jukitajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi titatag duka dekaske;","poem":1},{"lineBreak":true},{"text":"minak waitjutak shiig awajtuchui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mina chichamjuk ashí pegkejai;","poem":1},{"lineBreak":true},{"text":"wika jimag weninnuchuitjai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aents shiig anentaimkauwa","poem":1},{"lineBreak":true},{"text":"nunú diismak mina chichamjuk dakitmainchau","poem":1},{"lineBreak":true},{"text":"paan antumainai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Plata jumain idaikujum,","poem":1},{"lineBreak":true},{"text":"dekas wi jintiamua nunú jukitajum,","poem":1},{"lineBreak":true},{"text":"tuja oro shiig pegkeg jumain idaikujum,","poem":1},{"lineBreak":true},{"text":"dekas unuimata nunú jukitajum.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unuimata duka kaya pegkejuch aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesauwai.","poem":1},{"lineBreak":true},{"text":"Tuja waji pegkeg wakemain ainakush,","poem":1},{"lineBreak":true},{"text":"makichkish unuimatjaig betekchauwai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Witjai dekatnuk,","poem":1},{"lineBreak":true},{"text":"witjai chicham pegkejan sukagtinnuk,","poem":1},{"lineBreak":true},{"text":"tuja wi dutikatag takunuk","poem":1},{"lineBreak":true},{"text":"shiig anentaimsan dutikajai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuun umija duka","poem":1},{"lineBreak":true},{"text":"pegkegchau takat aina nunak kajejawai.","poem":1},{"lineBreak":true},{"text":"Tuja ememamu,","poem":1},{"lineBreak":true},{"text":"tikich wagagkau anentaimat, pegkegchau takat,","poem":1},{"lineBreak":true},{"text":"waitjut aina nunak wika kajejajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Chichagkagtut, pegkegnum anentaimat,","poem":1},{"lineBreak":true},{"text":"yachamet, unuimat aina duka midau ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja senchia dushakam midauwai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wi nunikti tibau asag apu wenawai,","poem":1},{"lineBreak":true},{"text":"nuninak chicham umiktin","poem":1},{"lineBreak":true},{"text":"dekas pegkeg aidaun najanainawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ashí apu nugkanum inamin aina duka,","poem":1},{"lineBreak":true},{"text":"wi nunikti tibau asag inamainawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja mina anentuidaunak","poem":1},{"lineBreak":true},{"text":"wishakam dutiksanuk aneajai,","poem":1},{"lineBreak":true},{"text":"tuja mina egatuidaunashkam wantintajai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wiakchamet, eme anentam ata,","poem":1},{"lineBreak":true},{"text":"shiig pujut, waji wamak megkaejashtin","poem":1},{"lineBreak":true},{"text":"aina nunashkam wi suwajai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wi sukagtamua duka","poem":1},{"lineBreak":true},{"text":"oro pegkeja nuna nagkaesauwai,","poem":1},{"lineBreak":true},{"text":"tuja wi sukagtamua duka","poem":1},{"lineBreak":true},{"text":"plata akiken nagkaesauwai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wika tuke pegkejan takauwaitjai,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"nuniau asan mina anentuidaunak,","poem":1},{"lineBreak":true},{"text":"kuashat wajigtin wiakuch emajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tuke Pujuu minak najatuawai.","poem":1},{"lineBreak":true},{"text":"Nii najankamu aina nunak","poem":1},{"lineBreak":true},{"text":"eke najantsuk miná najatuawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tuja nugkanak eke","poem":1},{"lineBreak":true},{"text":"najantsuk miná najatuawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mina najatuawa nuaduik","poem":1},{"lineBreak":true},{"text":"nayantsak atsujakui,","poem":1},{"lineBreak":true},{"text":"tuja yumi pukuni jiinaidaush,","poem":1},{"lineBreak":true},{"text":"namak aidaush atsujakui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk muja aidaun, nain aidaun","poem":1},{"lineBreak":true},{"text":"eke najantsuk miná najatuauwai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tuja nugkanak ikam aidaunash,","poem":1},{"lineBreak":true},{"text":"nuigtu nugka yukukuntujai nugkan najankauwa","poem":1},{"lineBreak":true},{"text":"nunakesh najantsuk miná najatuauwai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Apajuí nayaimpin yumi","poem":1},{"lineBreak":true},{"text":"piyajunum eneknak najanauwa","poem":1},{"lineBreak":true},{"text":"nuaduik wika pujuyajai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tuja yakí agkajunum yujagmin najana umika,","poem":1},{"lineBreak":true},{"text":"nayantsan initken yumi pukuni jiinaidaun epetug,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"nayantsanum yumi piyag betsakai tusa emetug idayak,","poem":1},{"lineBreak":true},{"text":"tuja nugka buchitmainchau","poem":1},{"lineBreak":true},{"text":"atinun umikua nuadui nagkamsan,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"wika Apajuí takakui,","poem":1},{"lineBreak":true},{"text":"niijai takakun pujuyajai.","poem":1},{"lineBreak":true},{"text":"Wi ayajai niina shiig anemtikin,","poem":1},{"lineBreak":true},{"text":"tuja niina emtinig shiig aneasan","poem":1},{"lineBreak":true},{"text":"wasugkamkun pujuyajai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Apajuí nugka najanamun","poem":1},{"lineBreak":true},{"text":"diisan shiig aneyajai,","poem":1},{"lineBreak":true},{"text":"tuja nii aentsun najanauwa nuna","poem":1},{"lineBreak":true},{"text":"diisan shiig aneamu ajuti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Nuadui uchig aidauwah,","poem":1},{"lineBreak":true},{"text":"wi tajim nunú antugtuktajum:","poem":1},{"lineBreak":true},{"text":"Wi tajim nunú umiakjumek,","poem":1},{"lineBreak":true},{"text":"Apajuí yayaam atinaitjume.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wi jintinjim nunú dakittsuk","poem":1},{"lineBreak":true},{"text":"shiig unuimagtajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum shiig anentaimkau atajum.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Aents kashi kashinig mina jegajui taa","poem":1},{"lineBreak":true},{"text":"mina chichamjun antugtauk shiig aneastinai,","poem":1},{"lineBreak":true},{"text":"wagki Apajuí yayamu asa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Mina igkuntuk pujutan juwawai,","poem":1},{"lineBreak":true},{"text":"nunik Tuke Pujuu wait anentam awai.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tuja mina pegkegchaun chichagtauk","poem":1},{"lineBreak":true},{"text":"jaka megkaetanum pujawai.","poem":1},{"lineBreak":true},{"text":"¡Tuja mina kajegtuina duka","poem":1},{"lineBreak":true},{"text":"jaka megkaetan aneenak núninawai!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}