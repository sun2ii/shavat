er":3,"content":[{"lineBreak":true},{"text":"Nuadui nunú aentsuk makichik numi","poem":1},{"lineBreak":true},{"text":"yuminum ijusa ajaamu,","poem":1},{"lineBreak":true},{"text":"pegkeg, senchi nejen,","poem":1},{"lineBreak":true},{"text":"dukesh kaketsama imanai.","poem":1},{"lineBreak":true},{"text":"¡Iman asa ashí nii takamuji aidauk","poem":1},{"lineBreak":true},{"text":"shiig pegkeg ainawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Untsu aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"nunú aentsjaig betekchau ainawai,","poem":1},{"lineBreak":true},{"text":"nuadui ditak ajusa wampujin dase umpui ajapama numamtin ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidaunak","poem":1},{"lineBreak":true},{"text":"Apajuí dita takasbaujin","poem":1},{"lineBreak":true},{"text":"diijus suwimkan susatnai.","poem":1},{"lineBreak":true},{"text":"Tuja aents pegkejan takau aidau","poem":1},{"lineBreak":true},{"text":"Apajuí pujutain ijunjagtina","poem":1},{"lineBreak":true},{"text":"nuwig ditak wayachagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk aents","poem":1},{"lineBreak":true},{"text":"pegkeg aidaun kuitamui.","poem":1},{"lineBreak":true},{"text":"Untsu aents pegkegchau aidauk","poem":1},{"lineBreak":true},{"text":"dita pegkegchaujinig waittsagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}