uk;","poem":1},{"lineBreak":true},{"text":"nigki wi jaaku pujaish etsaentinuk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuja jamainnum jeganta aish,","poem":1},{"lineBreak":true},{"text":"niyai mina uwemtijinuk.","poem":1},{"lineBreak":true},{"text":"Tuja nigki niina anejattaijiya nuna","poem":1},{"lineBreak":true},{"text":"mina anentaijui suja duka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niig ashí pegkeg aina nuna sujawai.","poem":1},{"lineBreak":true},{"text":"Tuja wi múuntuch wajasan pujaish,","poem":1},{"lineBreak":true},{"text":"nii minak ataktu senchimtijua","poem":1},{"lineBreak":true},{"text":"ukukui yakí nanamama iman etawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk, pegkegma iman asa,","poem":1},{"lineBreak":true},{"text":"aents waituidaunash yaigka","poem":1},{"lineBreak":true},{"text":"agkanmitkawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moisés Israel aents aidaujai","poem":1},{"lineBreak":true},{"text":"dutikatnun, tuja dita umikagtinun","poem":1},{"lineBreak":true},{"text":"aatus Apajuí jintintuauwai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk kakagchauch","poem":1},{"lineBreak":true},{"text":"wait anenkagtinai;","poem":1},{"lineBreak":true},{"text":"wamak kajechui,","poem":1},{"lineBreak":true},{"text":"tuja anentak wajasui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apajuík jiyajatu pujuchui;","poem":1},{"lineBreak":true},{"text":"tuja kajegkagtukbaujish tukek achauwai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ii pegkegchau takamtaijin","poem":1},{"lineBreak":true},{"text":"shiig kuashat suwimak jumain ajinig,","poem":1},{"lineBreak":true},{"text":"imatikagkesh amaschauwai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niina umijin aidaunak Apajuík","poem":1},{"lineBreak":true},{"text":"nayaim múun nagkatkachua nuni","poem":1},{"lineBreak":true},{"text":"nagkaemas aneawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Etsa jiintaijiya nuna","poem":1},{"lineBreak":true},{"text":"etsa akaetaijiya nujai","poem":1},{"lineBreak":true},{"text":"atushat akankauwa numamtuk,","poem":1},{"lineBreak":true},{"text":"iina tudaujinak atushat datupajui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk niina umijuina nunak,","poem":1},{"lineBreak":true},{"text":"makichik múun uchijin shiig anentus","poem":1},{"lineBreak":true},{"text":"kuitamama imatikas kuitamui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wagki iish wajiyai najanamuitji","poem":1},{"lineBreak":true},{"text":"nunak nii dekawai;","poem":1},{"lineBreak":true},{"text":"iik nugka yukukuntujai najanamuitji,","poem":1},{"lineBreak":true},{"text":"nuna nii shiig dekawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aentsu pujutjiya duka","poem":1},{"lineBreak":true},{"text":"dupajai betekmamtinai;","poem":1},{"lineBreak":true},{"text":"dupa tsapai yagkujuwama numamtuk wajawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja yagkugnak dase dasentak umpui utsauwame,","poem":1},{"lineBreak":true},{"text":"dutikamu asamtai, ataktu awagkik wainchataiyai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Untsu Tuke Pujuu anenkega duka","poem":1},{"lineBreak":true},{"text":"niina umijin aidaunmak","poem":1},{"lineBreak":true},{"text":"megkaekashtinun tuke atinai.","poem":1},{"lineBreak":true},{"text":"Nuadui, nuna uchiji wegantu aidaunash,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tuja ditajai chicham umikbauwa nuna","poem":1},{"lineBreak":true},{"text":"betek umidaun, nuigtu diez chicham umiktin","poem":1},{"lineBreak":true},{"text":"agagbaun kajimattsuk umidaun","poem":1},{"lineBreak":true},{"text":"aatus tuke yaigtinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuke Pujuun pujusa inamtaijiya duka","poem":1},{"lineBreak":true},{"text":"nayaimpinum awai;","poem":1},{"lineBreak":true},{"text":"nuwi ekemas ashí nugkanum inamui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¡Nayaimpinmaya aents ángel senchigtin,","poem":1},{"lineBreak":true},{"text":"Apajuí chichame umijin,","poem":1},{"lineBreak":true},{"text":"tuja nii inapakui umiktasajum","poem":1},{"lineBreak":true},{"text":"batsamin aidautijum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ememattajum!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Atum niina suntaji aidautijum nii takajin,","poem":1},{"lineBreak":true},{"text":"tuja nii inapamu betek umijin aidautijum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ememattajum!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Tuja Apajuí najankamu","poem":1},{"lineBreak":true},{"text":"ashí nugkanum batsamin aidautijum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ememattajum!","poem":1},{"lineBreak":true},{"text":"Tuja wishakam ashí mina wakanjujai","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun ememattajai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":22}