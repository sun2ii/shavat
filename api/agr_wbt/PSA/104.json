,{"lineBreak":true},{"text":"¡Amina nanapjumin","poem":1},{"lineBreak":true},{"text":"dasenum nanaakam wekaeme!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dase aina duka ame iname,","poem":1},{"lineBreak":true},{"text":"ame nunikti tama jiishkam kegawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apajuík nugkanak nigki","poem":1},{"lineBreak":true},{"text":"buchitmainchaun najanauwai;","poem":1},{"lineBreak":true},{"text":"nuadui makichkish umuchmainchau atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ame nayants pimumtikjam","poem":1},{"lineBreak":true},{"text":"nugka yutuabiume,","poem":1},{"lineBreak":true},{"text":"dutikakum ashí muja","poem":1},{"lineBreak":true},{"text":"múun tsakaku aidaush yutuabiume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imanikmataish,","poem":1},{"lineBreak":true},{"text":"kuyua buku wajasti timayume,","poem":1},{"lineBreak":true},{"text":"tusa tabaugmin amina chichamjumin","poem":1},{"lineBreak":true},{"text":"ipamtajai betek antuk wamak kuyuabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuadui, yumi piyag","poem":1},{"lineBreak":true},{"text":"muja aidaun amuja auk,","poem":1},{"lineBreak":true},{"text":"wake aidaunum akaiki,","poem":1},{"lineBreak":true},{"text":"ame nuwi ijumnagti tibaunak imanisag","poem":1},{"lineBreak":true},{"text":"nuwi ijumnajui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunikmatai ataktu pimak","poem":1},{"lineBreak":true},{"text":"nugkan utujai tusam,","poem":1},{"lineBreak":true},{"text":"juwig nagkankati, nuwi nagkama","poem":1},{"lineBreak":true},{"text":"pima pimakuag wechati tiuwaitme.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Untsu yumi mujanum pukuni jiinki,","poem":1},{"lineBreak":true},{"text":"entsa najanea pakajin jegak,","poem":1},{"lineBreak":true},{"text":"namak múun wajasti tusam idaime.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nunú yumin kuntin ikamia aidau","poem":1},{"lineBreak":true},{"text":"burro ikamia aidaujai kitamainak","poem":1},{"lineBreak":true},{"text":"umin ainawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nunú namaka yantamen numi ayaunum,","poem":1},{"lineBreak":true},{"text":"nuna kanawen chigki aidau pasugmak petsainak,","poem":1},{"lineBreak":true},{"text":"shinuinamu antunawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, amek","poem":1},{"lineBreak":true},{"text":"nayaimpinum pujusam yumi yutumtijam,","poem":1},{"lineBreak":true},{"text":"ikam ukatkam pegkeg emame;","poem":1},{"lineBreak":true},{"text":"tuja amina anenkagmea nunú","poem":1},{"lineBreak":true},{"text":"nugkanak shiig anemtikui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apajuí dupanak tsapapitkawai,","poem":1},{"lineBreak":true},{"text":"kuntin nuna yuu aidau","poem":1},{"lineBreak":true},{"text":"yuwatnume tusa,","poem":1},{"lineBreak":true},{"text":"tuja ajak aidaunashkam","poem":1},{"lineBreak":true},{"text":"tsapapitkawai, nunú nejekmatai","poem":1},{"lineBreak":true},{"text":"aents aidau yuwatnume tusa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja pagkan yuwa ichichmamtain,","poem":1},{"lineBreak":true},{"text":"tuja vino uwaja shiig aneastinun,","poem":1},{"lineBreak":true},{"text":"nuigtu aceite kugkuin yapinum","poem":1},{"lineBreak":true},{"text":"nijamtain aatus ashí umikui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuke Pujuu numi najankamua duka","poem":1},{"lineBreak":true},{"text":"yumi uchupiam shiig ijunui,","poem":1},{"lineBreak":true},{"text":"tuja Líbanonmaya setug aidaun","poem":1},{"lineBreak":true},{"text":"nii tsapapitkakua dushakam,","poem":1},{"lineBreak":true},{"text":"yumi yutak nugkan uchupiau asamtai","poem":1},{"lineBreak":true},{"text":"shiig ijunui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nuna kanawe aidaunum","poem":1},{"lineBreak":true},{"text":"chigki aidau pasugmak petsainawai;","poem":1},{"lineBreak":true},{"text":"nuwi pishak cigueñashkam pujawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja muja tsakaku aina duka","poem":1},{"lineBreak":true},{"text":"cabra ikamia aidau batsamtai ainawai;","poem":1},{"lineBreak":true},{"text":"untsu kaya múun aina duka","poem":1},{"lineBreak":true},{"text":"wapujushan uumka batsamtai ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Apajuí nantunak najanauwai,","poem":1},{"lineBreak":true},{"text":"wajupa nantuk weawa tusa dekatnun;","poem":1},{"lineBreak":true},{"text":"tuja tsawan dekapa dekatain etsan najanauwai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Etsa akaetaik kiyawai,","poem":1},{"lineBreak":true},{"text":"nunikmatai kashi kuntin","poem":1},{"lineBreak":true},{"text":"ikamia aidau jiinag yujawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuja león aidaushkam kashi jiinag,","poem":1},{"lineBreak":true},{"text":"dita yumainji atsutai shinuinawai,","poem":1},{"lineBreak":true},{"text":"Apajuín segainak.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Untsu tsawak etsa jiintai,","poem":1},{"lineBreak":true},{"text":"dita waajin akuumag megkagainawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsawan tsawagmatai,","poem":1},{"lineBreak":true},{"text":"aents aidau takatjin jiintukiag,","poem":1},{"lineBreak":true},{"text":"takai takainakua agkutai ukuinawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amek shiig kuashat najankauwaitme!","poem":1},{"lineBreak":true},{"text":"Tuja ashí duka","poem":1},{"lineBreak":true},{"text":"amina yachagmijai umikuitme.","poem":1},{"lineBreak":true},{"text":"¡Nugka ame najanamua","poem":1},{"lineBreak":true},{"text":"nuwig ashí ame najankamu aina nunú batsatui!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Diisia ame najanamu","poem":1},{"lineBreak":true},{"text":"nayants shiig múun,","poem":1},{"lineBreak":true},{"text":"nuwig kuntin múun aidau,","poem":1},{"lineBreak":true},{"text":"kuntin piipich aidau shiig kuashat","poem":1},{"lineBreak":true},{"text":"makichkish dekapamainchau ayawai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nuwi yujawai lancha múun aidau;","poem":1},{"lineBreak":true},{"text":"tuja nuwi semagkau múun","poem":1},{"lineBreak":true},{"text":"najanawaitam nunú","poem":1},{"lineBreak":true},{"text":"shiig aneak wasugkamui.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nunú aidauk ashí","poem":1},{"lineBreak":true},{"text":"amina dakagmainawai,","poem":1},{"lineBreak":true},{"text":"wajutik yutainash amasat tusag.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nuadui ame dita yuwatnuk suwame,","poem":1},{"lineBreak":true},{"text":"dutikam jukiag shiig yuwinawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Untsu ame uumjukmak,","poem":1},{"lineBreak":true},{"text":"senchi ishamainawai;","poem":1},{"lineBreak":true},{"text":"tuja ame mayatut jujamshakam jawai,","poem":1},{"lineBreak":true},{"text":"nunik iyashig yukukuntu najaneawai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tujash ame Wakanim suwamak","poem":1},{"lineBreak":true},{"text":"ashí nugkanmaya aents aidauk","poem":1},{"lineBreak":true},{"text":"yamajam pujutan juwinawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu imanjiya duka tuke auwai!","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuuk nii najankamujin diisa shiig aneawai!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuja Apajuí diyamak nugkak kujawai,","poem":1},{"lineBreak":true},{"text":"untsu muja aidauk","poem":1},{"lineBreak":true},{"text":"Apajuí antiamak bukuituinawai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wi eke iwaku pujuttag nuaduik","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun, mina Apajuíjun emematkun","poem":1},{"lineBreak":true},{"text":"kantamtain kantamjuattajai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tuja Tuke Pujuu wi anentaibaujua","poem":1},{"lineBreak":true},{"text":"nuna shiig aneas diigtusti,","poem":1},{"lineBreak":true},{"text":"wagki minak niyai shiig aneamujuk ajutui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"¡Aents pegkegchaun takau aidau","poem":1},{"lineBreak":true},{"text":"Apajuí ememattan dakituidauk","poem":1},{"lineBreak":true},{"text":"ashí jinawag megkaejatnume!","poem":1},{"lineBreak":true},{"text":"¡Ashí mina wakanjujai Tuke Pujuun emematkun","poem":1},{"lineBreak":true},{"text":"pegkegnum chichagtinaitjai!","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah! Tuke Pujuun daaji ememattai ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}