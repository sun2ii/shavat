k":true},{"text":"Ashí tsawantai Tuke Pujuu egaktajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum niina senchijiya nunú segatajum.","poem":1},{"lineBreak":true},{"text":"¡Tuké Apajuí egaktajum!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apajuí ii aidautin, tuja niina inake Abraham, Jacob aajaku aina","poem":1},{"lineBreak":true},{"text":"nunú wegantu aidaun etegjauwa nuna,","poem":1},{"lineBreak":true},{"text":"ayamjak wainchatai ishamain aidaun","poem":1},{"lineBreak":true},{"text":"iwainajua nunú anentaimtustajum.","poem":1},{"lineBreak":true},{"text":"Tuja chicham umiktin agagbauwa","poem":1},{"lineBreak":true},{"text":"dushakam adeagtajum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niyai Tuke Pujuu, iina Apajuíjiya nunú;","poem":1},{"lineBreak":true},{"text":"niyai ashí aents aina nuna apujig.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuashat mijan nagkaemataish,","poem":1},{"lineBreak":true},{"text":"nuna dutikatjai tusa anagkagtuamujinak","poem":1},{"lineBreak":true},{"text":"Apajuík tuke kajimatkishtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nunak Abrahamjai umikua nuna,","poem":1},{"lineBreak":true},{"text":"Isaakjaishkam ataktu umikui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuna Jacobjaishkam umikui,","poem":1},{"lineBreak":true},{"text":"tuja nunú tuke asatin","poem":1},{"lineBreak":true},{"text":"Israel aents aidaunum juwakui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuadui Apajuí niina chichajak:","poem":1},{"lineBreak":true},{"text":"“Wi nugka Canaágnak amastajai,","poem":1},{"lineBreak":true},{"text":"aminu tuke atina nuna”, tiuwai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Israel wegantu aidauk","poem":1},{"lineBreak":true},{"text":"ujumchik aajaku aina duwik","poem":1},{"lineBreak":true},{"text":"nugkenchau asag,","poem":1},{"lineBreak":true},{"text":"Canaán nugkanmak ijagjai betek","poem":1},{"lineBreak":true},{"text":"wainak yujajaku ainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nunidau asag,","poem":1},{"lineBreak":true},{"text":"tikich nugkanum shiyakag,","poem":1},{"lineBreak":true},{"text":"nuwi batsamas, nuna ukuinak","poem":1},{"lineBreak":true},{"text":"tikich apu aidau batsatbaunum jegawag,","poem":1},{"lineBreak":true},{"text":"nuwi ujumchik tsawan pujusag,","poem":1},{"lineBreak":true},{"text":"waja yujayanume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tujash Apajuík","poem":1},{"lineBreak":true},{"text":"waitkastinme tusag idaisachmayi,","poem":1},{"lineBreak":true},{"text":"nuadui ditan ayamjak","poem":1},{"lineBreak":true},{"text":"apu aidaun suwimkan susabi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuadui apu aidaun chichajak:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug wi etegjamu aina duka,","poem":1},{"lineBreak":true},{"text":"tuja mina chichamjun etsejin aidaushkam","poem":1},{"lineBreak":true},{"text":"makichkish waitkasaigpajum”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tuja Canaán nugkanum","poem":1},{"lineBreak":true},{"text":"Apajuí ajak aidaun ashí ijinabi,","poem":1},{"lineBreak":true},{"text":"dutikamu asa nujan tepeabi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tujash eke nujan tepeatsaig,","poem":1},{"lineBreak":true},{"text":"Apajuí Josén emtika Egipto nugkanum","poem":1},{"lineBreak":true},{"text":"awemauwai, dita yachi aidau","poem":1},{"lineBreak":true},{"text":"wainka inataijai betek sujukajua nuna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dutikam Egipto nugkanum jegamtai,","poem":1},{"lineBreak":true},{"text":"Josénak jijui dawenum jigkajag","poem":1},{"lineBreak":true},{"text":"jukiag aents achika egketainum","poem":1},{"lineBreak":true},{"text":"egkeawagmayi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja José kajamjamuji uminkati tusa,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina dekapeak","poem":1},{"lineBreak":true},{"text":"kuashat tsawan waitkastinme tiuwai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nunik waitu pujaun,","poem":1},{"lineBreak":true},{"text":"Egipto nugkan apuji José jiiktajum tusa","poem":1},{"lineBreak":true},{"text":"inamjamtai jiikiagmayi,","poem":1},{"lineBreak":true},{"text":"dutika agkanmitkabi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dutika jiiki niina jeen apuji ema,","poem":1},{"lineBreak":true},{"text":"nuigtu niinu aidau Egipto nugkanum ayaunak ashí diisti tusa niina idaitusui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tuja nuigtushkam apu atuwe aidaun,","poem":1},{"lineBreak":true},{"text":"tuja tikich apu aidaunashkam","poem":1},{"lineBreak":true},{"text":"nigki jintintua unuinakti tusa idaitusui.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nunikbaunum Jacob Israel daagtin","poem":1},{"lineBreak":true},{"text":"aajakua nunú Egipto nugkanum jegauwai.","poem":1},{"lineBreak":true},{"text":"Nunik jegaa tikich nugkanmayayaitak","poem":1},{"lineBreak":true},{"text":"Cam nugkanum pujusui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nunik pujusmatai, Apajuí","poem":1},{"lineBreak":true},{"text":"nii aentsji aidaun kuashat uyujkauwai,","poem":1},{"lineBreak":true},{"text":"dutika niina shiwaaji aidaun","poem":1},{"lineBreak":true},{"text":"nagkaesau senchigtin emauwai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tujash egiptunmaya aidau","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun kajejiagti,","poem":1},{"lineBreak":true},{"text":"dutikainak tsanujagtinme tusa","poem":1},{"lineBreak":true},{"text":"Apajuí tsagkamkauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Tuja kuashat waitkagtai,","poem":1},{"lineBreak":true},{"text":"Apajuí niina inake etegkamujin Moisésan Aarógjai","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum awemauwai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nuadui Apajuí senchijin","poem":1},{"lineBreak":true},{"text":"wainchatai ishamain aidaun Egipto nugkanum, Cam nugkanum iwainakajui.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tuja Egipto nungkak ashí suwe wajasti tusa","poem":1},{"lineBreak":true},{"text":"Apajuí suwe emabi.","poem":1},{"lineBreak":true},{"text":"Nuna wainainayatak","poem":1},{"lineBreak":true},{"text":"egiptunmaya aents aidauk,","poem":1},{"lineBreak":true},{"text":"Apajuí chichamenak","poem":1},{"lineBreak":true},{"text":"antugkachaju ainawai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tuja yumi aidaunak ashí numpa awajtusui;","poem":1},{"lineBreak":true},{"text":"imanikmatai, namak aidaushkam jinawajui.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Takash aidaunashkam,","poem":1},{"lineBreak":true},{"text":"ashí yaaktanum piyakti,","poem":1},{"lineBreak":true},{"text":"nuniak apu pegajinish","poem":1},{"lineBreak":true},{"text":"tuja nii ekemtaijinish utsaniag","poem":1},{"lineBreak":true},{"text":"waitkasti tusa ishitkabi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Apajuí nunikti timatai,","poem":1},{"lineBreak":true},{"text":"anchi teteejai pachimnag,","poem":1},{"lineBreak":true},{"text":"yujagkim wajukama imanik","poem":1},{"lineBreak":true},{"text":"Egipto nugkanak akijuawabi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuja yumin yutumtiktsuk,","poem":1},{"lineBreak":true},{"text":"bicha kaya iman najaneaku","poem":1},{"lineBreak":true},{"text":"jiijai pachimag nayaimpinmayan","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum yutumtikjabi.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nunú yutak uva ajakbau aidaun,","poem":1},{"lineBreak":true},{"text":"higo aidaunash ijinabi.","poem":1},{"lineBreak":true},{"text":"Dutikak numi kanawe","poem":1},{"lineBreak":true},{"text":"aidaunashkam ashí kupijabi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tuja Apajuí ataktushkam nunikti tusa timatai,","poem":1},{"lineBreak":true},{"text":"manchi aidau shiig kuashat kaketukmayi.","poem":1},{"lineBreak":true},{"text":"¡Shiig kuashat asa dekapatash dekapamaichabi!","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"¡Imaniau asa ajak ajanum ayaunak,","poem":1},{"lineBreak":true},{"text":"tuja dupa aidaunak ashí amukagmayi!","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"¡Dutiksag egiptunmaya aents aidaun","poem":1},{"lineBreak":true},{"text":"uchiji iwai aidaunashkam ijituabi!","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Dutika nuadui,","poem":1},{"lineBreak":true},{"text":"iina muunji aidaunak Apajuí","poem":1},{"lineBreak":true},{"text":"oro aidaun, tuja plata aidaun","poem":1},{"lineBreak":true},{"text":"aatus uyumitkak jiigmayi.","poem":1},{"lineBreak":true},{"text":"Nunik shimakush Israel aents aidauk","poem":1},{"lineBreak":true},{"text":"makichik kayanakesh tukumkachagmayi.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Nunik shimiagtai, egiptunmaya aidauk","poem":1},{"lineBreak":true},{"text":"ishamkagtu batsatu asag,","poem":1},{"lineBreak":true},{"text":"shiig aneasaju ainawai.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Dutika jiija yujagmin awetiuwai,","poem":1},{"lineBreak":true},{"text":"niina aentsji aidaun ejakti tusa;","poem":1},{"lineBreak":true},{"text":"tuja dutiksag kashi diisag","poem":1},{"lineBreak":true},{"text":"shiyaktinnashkam jii kegaun awetiuwai.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Tuja yumainji atsujam yapajuinak sumagtaish,","poem":1},{"lineBreak":true},{"text":"codornisan ishitkabi;","poem":1},{"lineBreak":true},{"text":"tuja nayaimpinmaya yutai susam","poem":1},{"lineBreak":true},{"text":"nuna yuwawag ejemajag","poem":1},{"lineBreak":true},{"text":"shiig aneasagmayi.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Tuja Moisés kayan awatmatai,","poem":1},{"lineBreak":true},{"text":"kayanmaya yumi jiinkibi,","poem":1},{"lineBreak":true},{"text":"nunik entsajai betek wajas","poem":1},{"lineBreak":true},{"text":"uwegshunum akaikibi.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Apajuí yaunchuk Abrahaman","poem":1},{"lineBreak":true},{"text":"anagkuamunak betek umikmayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Aatus Apajuí niina aentsji aidau","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum batsatun jiigmayi.","poem":1},{"lineBreak":true},{"text":"Dutikam aents aidauk","poem":1},{"lineBreak":true},{"text":"shiig aneenak untsumiagmayi.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Dutika yajuak nugka","poem":1},{"lineBreak":true},{"text":"tikich aents aidau batsamtain susabi,","poem":1},{"lineBreak":true},{"text":"dutikak ajak tikich aents aidau","poem":1},{"lineBreak":true},{"text":"ajakbau aidaunashkam susabi.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Nunak Apajuí dutikauwai,","poem":1},{"lineBreak":true},{"text":"juwi batsamas chicham umiktin agagbauwa nuna umiktinme tau asa.","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah! Apajuí emematiagmi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/P