1},{"lineBreak":true},{"text":"Tuja amek kashikmas","poem":1},{"lineBreak":true},{"text":"jegashjuk tsawauwama numamtuk,","poem":1},{"lineBreak":true},{"text":"kashi kashinig yamajam senchi jutatme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke Pujuu nii umiktinjin","poem":1},{"lineBreak":true},{"text":"yapajinashtinun chichaak:","poem":1},{"lineBreak":true},{"text":"“Ametme sacerdote Melquisedec aajakua","poem":1},{"lineBreak":true},{"text":"nujai betek tuke sacerdote atinmek”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apajuík amejaig pujawai amina yaimpaktatus.","poem":1},{"lineBreak":true},{"text":"Makichik tsawantai nii kajeka","poem":1},{"lineBreak":true},{"text":"apu aidaunak ijinattawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aents aidaun suwimkan susa ijinatnai,","poem":1},{"lineBreak":true},{"text":"dutikam ashí nugkanmak","poem":1},{"lineBreak":true},{"text":"aents jinauk tuwasua weaku atinai.","poem":1},{"lineBreak":true},{"text":"¡Nugka múun aidaun","poem":1},{"lineBreak":true},{"text":"apuji aidaunash ashí ijinatnai!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Depetmak jintá minis","poem":1},{"lineBreak":true},{"text":"yumi entsanmayan uwagtinai;","poem":1},{"lineBreak":true},{"text":"nunik ataktu ichichmamjatnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":7}