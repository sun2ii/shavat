{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":115,"content":[{"type":"heading","content":["Iina Apajuíjig nayaimpinum pujawai"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuuwah, jutiik eme anenkagtusaipa,","poem":1},{"lineBreak":true},{"text":"dekas ima amek eme anenmamta,","poem":1},{"lineBreak":true},{"text":"amina anenkagmin,","poem":1},{"lineBreak":true},{"text":"tuja dekaskegmijai eme anenmamta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wagkag aents pegkegchau aidaush","poem":1},{"lineBreak":true},{"text":"jutiin chichagtamainakush ¿tuwi pujawa","poem":1},{"lineBreak":true},{"text":"atumi Apajuígmesh, tusash tujamiajainta?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iina Apajuíjig nayaimpinum pujawai,","poem":1},{"lineBreak":true},{"text":"tuja nii wakegamu aidaun ashí najankauwai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"apajuímtaijig oro, plata ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja duka aents najankamu ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dita apajuímtaijig weni ajamaitak","poem":1},{"lineBreak":true},{"text":"chichachu ainawai;","poem":1},{"lineBreak":true},{"text":"jiishkam ajamaitak wainmachu ainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuwishish ajuidau, tujash antuchu;","poem":1},{"lineBreak":true},{"text":"nujintin, tujash mayatchau;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"uwegtin aidau, tujash achimchau;","poem":1},{"lineBreak":true},{"text":"nawentin aidau, tujash wekaechau;","poem":1},{"lineBreak":true},{"text":"¡makichik chichamujigkesh","poem":1},{"lineBreak":true},{"text":"antugchatai ainawai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuniau asamtai aents nuna najanin,","poem":1},{"lineBreak":true},{"text":"tuja nunú dakumka najanamua","poem":1},{"lineBreak":true},{"text":"nuna emematin aina duka","poem":1},{"lineBreak":true},{"text":"dita apajuímtaijijai betek ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Israel aents aidautigmek,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwaig kajinmamsa anentaimsatajum!","poem":1},{"lineBreak":true},{"text":"Wagki nii jutiinak yaimpawai,","poem":1},{"lineBreak":true},{"text":"tuja nigki kuitamjamui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sacerdote aidautigmesh","poem":1},{"lineBreak":true},{"text":"ima Tuke Pujuuwaig kajinmamsa","poem":1},{"lineBreak":true},{"text":"anentaimtajum.","poem":1},{"lineBreak":true},{"text":"Wagki nii jutiinak yaimpawai,","poem":1},{"lineBreak":true},{"text":"tuja nigki kuitamjamui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashí aents Tuke Pujuu umijin aidautigmek,","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuuwaig kajinmamsa anentaimsatajum!","poem":1},{"lineBreak":true},{"text":"Wagki nii jutiinak yaimpawai,","poem":1},{"lineBreak":true},{"text":"tuja nigki kuitamjamui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu iinak kajimatjamtsuk","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigtamjatnai!","poem":1},{"lineBreak":true},{"text":"¡Israel aents aidaunashkam","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigjatnai!","poem":1},{"lineBreak":true},{"text":"¡Sacerdote aidaunashkam","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigjatnai!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aents Tuke Pujuun eme anentus","poem":1},{"lineBreak":true},{"text":"umijin aidaun:","poem":1},{"lineBreak":true},{"text":"aents eme anentsa diishtai,","poem":1},{"lineBreak":true},{"text":"eme anentsa diitai aidaujai","poem":1},{"lineBreak":true},{"text":"Apajuí ashí ditanak pegkegnum yumigjatnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tuke Pujuu atumi uchijum aidaunash,","poem":1},{"lineBreak":true},{"text":"tuja nuna uchiji aidaunash uyujtugmaktinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu nayaimpin, nugkajai najanauwa nunú","poem":1},{"lineBreak":true},{"text":"aminak pegkegnum yumigtamsattawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nayaimpia auk Tuke Pujuunui,","poem":1},{"lineBreak":true},{"text":"tuja nugka nuna aents aidaun susauwai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jakau aidauk chichamainchau asag,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuunak emematmainchau ainawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Untsu ii iwaku aidautik","poem":1},{"lineBreak":true},{"text":"tuke ememattinaitji.","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah!","poem":1},{"lineBreak":true},{"text":"Iina Apajuíji ememattai ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":18}