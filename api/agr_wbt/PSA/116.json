{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":116,"content":[{"type":"heading","content":["Apajuí see tabau"]},{"type":"verse","number":1,"content":[{"text":"Wika Tuke Pujuunak aneajai,","poem":1},{"lineBreak":true},{"text":"wagki wi segamun antugtuku asamtai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wagki wi segamun antugtuku asamtai,","poem":1},{"lineBreak":true},{"text":"wi iwaku pujaknuk,","poem":1},{"lineBreak":true},{"text":"niina tuke segatnaitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jata achigkamtaimpap","poem":1},{"lineBreak":true},{"text":"jakattaja tusan ishamkabiajai,","poem":1},{"lineBreak":true},{"text":"nuniakun wake besemag pujubiajai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuniakun Tuke Pujuun segabiajai","poem":1},{"lineBreak":true},{"text":"uwemtijugta tusan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk pegkejam, wait anenkagtinai,","poem":1},{"lineBreak":true},{"text":"iina Apajuíjiya duka","poem":1},{"lineBreak":true},{"text":"kakagchauch anejatin wajasui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk aents kakakchau","poem":1},{"lineBreak":true},{"text":"aidaunash kuitamui.","poem":1},{"lineBreak":true},{"text":"Wi kakaumainchau wajasan pujaishkam,","poem":1},{"lineBreak":true},{"text":"nii minak uwemtijugmayi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Yamaik shiig aneasan pujumainaitjai,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu pegkeg etiu asamtai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wagki Apajuí jamainun uwemtijug","poem":1},{"lineBreak":true},{"text":"wi wake besemag buutku","poem":1},{"lineBreak":true},{"text":"pujamugnash yaintuk uwemtijuja nuadui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja iwaku juju nugka juwi pujag nuaduik,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuunak tuke umigkatnaitjai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wika senchi waitiaknushkam, Apajuínak dekaskeapi tibaijai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja wi waugtukan chichaakun:","poem":1},{"lineBreak":true},{"text":"“Ashí aents aidauk waitjin ainawai”,","poem":1},{"lineBreak":true},{"text":"tibaijai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Tuke Pujuu mina pegkegnum","poem":1},{"lineBreak":true},{"text":"yainkamunmash,","poem":1},{"lineBreak":true},{"text":"wisha wajuk akimainaitja?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja nii mina uwemtijugbaunum","poem":1},{"lineBreak":true},{"text":"vinon anentag Tuke Pujuun suwakun,","poem":1},{"lineBreak":true},{"text":"niina daajin pachisan ememattajai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wi umiktajai tusan","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun tiuwaitag nunak,","poem":1},{"lineBreak":true},{"text":"yamai ashí niina aentsji aidau","poem":1},{"lineBreak":true},{"text":"wainainamunum umiktatjai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk niina umijin aina","poem":1},{"lineBreak":true},{"text":"nunú jakamtaig,","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuuwah, wika amina inakmetjai!","poem":1},{"lineBreak":true},{"text":"¡Wika nuwa amina inakmea","poem":1},{"lineBreak":true},{"text":"nuna uchijiyaitjai!","poem":1},{"lineBreak":true},{"text":"¡Ame minak achikbaujai betek","poem":1},{"lineBreak":true},{"text":"ashí jakan pujai uwemtijugmayume!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tuke Pujuuwah, ame uwemtijugbaunum","poem":1},{"lineBreak":true},{"text":"see takun uwija maan apeakun ememattatjame,","poem":1},{"lineBreak":true},{"text":"dutikakun daagmin pachisan segattajame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi umiktajai tusan","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun tiuwaitag nunak,","poem":1},{"lineBreak":true},{"text":"yamai ashí niina aentsji aidau","poem":1},{"lineBreak":true},{"text":"wainainamunum umiktatjai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaakat Jerusalégkan ejapeen,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu jee pegkegma","poem":1},{"lineBreak":true},{"text":"nuna waitijin jegantatak agkaju","poem":1},{"lineBreak":true},{"text":"ayatak shugkuk ajigmauwa nuwi nunak dutikattajai.","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah!","poem":1},{"lineBreak":true},{"text":"Apajuí daaji ememattai ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/118.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}