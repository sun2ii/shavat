{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":118,"content":[{"type":"heading","content":["Tuke Pujuu uwemtikagtugbaunum see tabau"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu see titajum,","poem":1},{"lineBreak":true},{"text":"wagki niyai pegkejak;","poem":1},{"lineBreak":true},{"text":"niina anenkajig tuke auwai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel aents aidauk yamaikiuch:","poem":1},{"lineBreak":true},{"text":"“Apajuí anenkeg tuke auwai”, titinme.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sacerdote aidaushkam:","poem":1},{"lineBreak":true},{"text":"“Apajuí anenkeg tuke auwai”, titinme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke Pujuun eme anentus diin aidaushkam:","poem":1},{"lineBreak":true},{"text":"“Apajuí anenkeg tuke auwai”, titinme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waittanum pujusan","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun untsukbaijai,","poem":1},{"lineBreak":true},{"text":"dutika ai, aijuk uwemtijugmayi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu wijaig pujawai;","poem":1},{"lineBreak":true},{"text":"nuadui wika ishamkagtatsjai;","poem":1},{"lineBreak":true},{"text":"minak makichkish pegkegchauk","poem":1},{"lineBreak":true},{"text":"awajtumain ainatsui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuke Pujuu wijaig pujawai;","poem":1},{"lineBreak":true},{"text":"nuniau asa minak nii yaintui.","poem":1},{"lineBreak":true},{"text":"¡Nuadui mina shiwag aidau","poem":1},{"lineBreak":true},{"text":"mina kajegtuina nuna nii ijinamun wainkattajai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aentsnum kajintsa anentaima wekaetsuk,","poem":1},{"lineBreak":true},{"text":"dekas Tuke Pujuuwaig kajintsa anentaimainaitji.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apu aidaunum kajintsa anentaima wekaetsuk,","poem":1},{"lineBreak":true},{"text":"dekas Tuke Pujuuwaig kajintsa anentaimainaitji.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tikich nugkanmaya aents aidau","poem":1},{"lineBreak":true},{"text":"tuwagtukagmayi;","poem":1},{"lineBreak":true},{"text":"tujash Tuke Pujuu daajin depetkamiajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashí tententuawagmayi;","poem":1},{"lineBreak":true},{"text":"tujash Tuke Pujuu daajin depetkabiajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Etejai betek tuwagtukagmayi;","poem":1},{"lineBreak":true},{"text":"tujash jagki ijumjamun jii apea","poem":1},{"lineBreak":true},{"text":"emegkauwama imatikan ajapabiajai;","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuu daajin depetkabiajai!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ajua maami tusag shitatkiagmayi;","poem":1},{"lineBreak":true},{"text":"tujash minak Tuke Pujuu ayamjutkabi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wika Tuke Pujuu mina senchimtija","poem":1},{"lineBreak":true},{"text":"nuna kantamjajai.","poem":1},{"lineBreak":true},{"text":"¡Niiyai mina uwemtijinuk!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aents Apajuín umijin aina nuna jenig","poem":1},{"lineBreak":true},{"text":"shiig aneas untsumainak:","poem":1},{"lineBreak":true},{"text":"“Tuke Pujuun senchijiya nunú depetmake”,","poem":1},{"lineBreak":true},{"text":"titinme.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuun senchijiya duka","poem":1},{"lineBreak":true},{"text":"augmatkuish, makichkish ejemaitsui!","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuun senchijiya nunú depetmakui!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Jakashtatjai, iwaku pujuttajai,","poem":1},{"lineBreak":true},{"text":"wagki Tuke Pujuu iina ayamjutpak","poem":1},{"lineBreak":true},{"text":"dutikauwa nuna etsegkatasan!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuke Pujuu minak shiig senchi","poem":1},{"lineBreak":true},{"text":"suwimkan sujusmayi;","poem":1},{"lineBreak":true},{"text":"tujash jakati tusag idaituschabi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Apajuí jee pegkegma nuna","poem":1},{"lineBreak":true},{"text":"waitiji ujatjitajum;","poem":1},{"lineBreak":true},{"text":"nuwi wayan Tuke Pujuun see titag tajai!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Juju waitiya duka","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu pujamunum waitaiyai;","poem":1},{"lineBreak":true},{"text":"aents Apajuín nemajin aidauk","poem":1},{"lineBreak":true},{"text":"nunú waitiya nuni wayawagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tuke Pujuuwah, see tajame","poem":1},{"lineBreak":true},{"text":"wagki ame antugtukam uwemtijuju asamin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kaya ekenag jegamin aidau","poem":1},{"lineBreak":true},{"text":"kaya pegkegchauwai tusag,","poem":1},{"lineBreak":true},{"text":"dakitjajua nunú yamai","poem":1},{"lineBreak":true},{"text":"dekas kaya ima pegkeg atsumtai wajase.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nunak Tuke Pujuu dutikae,","poem":1},{"lineBreak":true},{"text":"duka yamaik puyattsa diimainai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Juju tsawanta juwai,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu iina ayamjutpakua nunú;","poem":1},{"lineBreak":true},{"text":"nuadui ¡yamai shiig anenaku jiistamawagmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tuke Pujuuwah, ¡wait aneasam uwemtikagtugta!","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwah, ¡wait aneasam yaijatkata,","poem":1},{"lineBreak":true},{"text":"shiig batsamsagmi!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuu awemamu mina nunú","poem":1},{"lineBreak":true},{"text":"dekas ememattai ati!","poem":1},{"lineBreak":true},{"text":"¡Tuja Tuke Pujuu jee pegkegma nuwi pujusan atumin pegkegnum yumigkiajime!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk Apajuíyai.","poem":1},{"lineBreak":true},{"text":"¡Apajuíyai tsaaptinun sujamsauk!","poem":1},{"lineBreak":true},{"text":"Yagkug aidau yajuaka altarnum","poem":1},{"lineBreak":true},{"text":"ejegawagmi, dutikawaja Apajuí","poem":1},{"lineBreak":true},{"text":"aentsji aidau nuwi batsata nunú uyuntsagmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Amek mina Apajuíg asamin see tajame,","poem":1},{"lineBreak":true},{"text":"nuniakun amina imanjumin emematjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tuke Pujuu see titajum,","poem":1},{"lineBreak":true},{"text":"wagki niyai pegkejak;","poem":1},{"lineBreak":true},{"text":"niina anenkajig tuke auwai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/116.json","previousChapterAudioLinks":{},"numberOfVerses":29}