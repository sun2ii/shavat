,{"text":"shiig dekamtikawai.","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"Amina chichamjum umiktin sukagtusuitam","poem":1},{"lineBreak":true},{"text":"nuna dekatasan wakegajai,","poem":1},{"lineBreak":true},{"text":"nuniakun itugkanuk shiig dekawag","poem":1},{"lineBreak":true},{"text":"tusa anentaimkun waitiajai.","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, amina anempau aidau","poem":1},{"lineBreak":true},{"text":"wait anentam dutiksamek,","poem":1},{"lineBreak":true},{"text":"minash diigsam wait anenjugta.","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"Amina chichamjum wajintua dutiksamek awekattsata;","poem":1},{"lineBreak":true},{"text":"pegkegchau wagagkiti tusamek idaitusaipa.","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"mantuawainum ayamjutkata,","poem":1},{"lineBreak":true},{"text":"wika amina chichamjum umiktin","poem":1},{"lineBreak":true},{"text":"sukagtusuitam nuna umiktasan wakegajai.","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"Wi amina inakmetag dusha","poem":1},{"lineBreak":true},{"text":"shiig aneasam diigsata,","poem":1},{"lineBreak":true},{"text":"nuniakum nunú chichamem jintinjuata.","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"Amina chichamjumin","poem":1},{"lineBreak":true},{"text":"eme anentus uminachu asamtai,","poem":1},{"lineBreak":true},{"text":"shiig senchi buutjai.","poem":1}]},{"type":"verse","number":137,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, amek pegkegmaitme;","poem":1},{"lineBreak":true},{"text":"tuja ame suwimak sukagtam","poem":1},{"lineBreak":true},{"text":"dushakam pegkegnum jintinkagtawai.","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"Chicham umiktin ame sukagtusuitam","poem":1},{"lineBreak":true},{"text":"duka waitchauwai, betek uminnai.","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"Mina shiwag aidau","poem":1},{"lineBreak":true},{"text":"amina chichamjumin uminachkui,","poem":1},{"lineBreak":true},{"text":"kajeakun shiig senchi waitiajai.","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"Amina chichamjumik","poem":1},{"lineBreak":true},{"text":"ashí dekapsamu dekas pegkegmai,","poem":1},{"lineBreak":true},{"text":"nuadui wika amina","poem":1},{"lineBreak":true},{"text":"inakminuk nuna wakegajai.","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"Wika dushiktai, wainkauchitjai,","poem":1},{"lineBreak":true},{"text":"tujash amina chichamjum umiktin","poem":1},{"lineBreak":true},{"text":"sukagtusuitam nunak kajimattsujai.","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"Amina takatjum pegkeja duka","poem":1},{"lineBreak":true},{"text":"tuké imanisag auwai,","poem":1},{"lineBreak":true},{"text":"tuja amina chichamjum umiktin","poem":1},{"lineBreak":true},{"text":"agagbauwa duka dekas shiig pegkegmai.","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"Waitiakun wake besemag pujubiajai;","poem":1},{"lineBreak":true},{"text":"tujash amina chichamjum umiktin sukagtusuitam","poem":1},{"lineBreak":true},{"text":"nunak minak shiig anemtijusmayi.","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"Ame chicham umikuitam","poem":1},{"lineBreak":true},{"text":"duka makichkish yapajinchauwai.","poem":1},{"lineBreak":true},{"text":"¡Yainkata wisha nuna shiig antukan umiktajai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":32}