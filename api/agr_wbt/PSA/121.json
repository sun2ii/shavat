{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":121,"content":[{"type":"heading","content":["Tuke Pujuuwai amina kuitamjamnuk"]},{"type":"hebrew_subtitle","content":["Atushat wekaeku Apajuíyai anentaimsa kantabau"]},{"type":"verse","number":1,"content":[{"text":"Muja aidaun pagkain diyakun:","poem":1},{"lineBreak":true},{"text":"¿Tuwiya taag minash ayamjutkainta? tajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Minak Tuke Pujuu nayaimpin nugkajai najanauwa nunú yainkattawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Apajuík waitkastinme tusag","poem":1},{"lineBreak":true},{"text":"makichkish idaituschattawai!","poem":1},{"lineBreak":true},{"text":"¡Amina kuitamjamna duka makichkish kanatsui!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nigka makichkish kanuchui;","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun kuitamna duka","poem":1},{"lineBreak":true},{"text":"makichkish kanuchui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu aminak kuitamjamui;","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu aminak ejaka kuitamjamui.","poem":1},{"lineBreak":true},{"text":"Niig amina yaimpaktatus amejai ijutkawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja tsawaishkam etsag senchi sukupakug","poem":1},{"lineBreak":true},{"text":"waitkagmaschattawai,","poem":1},{"lineBreak":true},{"text":"antsag nantushkam waitkagmaschattawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ishamain ataish,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ejapak kuitamjamui;","poem":1},{"lineBreak":true},{"text":"tuja nii amina pujutjumnash kuitamjutpawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk yamaya juwish, tuja ajumaish","poem":1},{"lineBreak":true},{"text":"ame tuwi wetatme nuniaminish,","poem":1},{"lineBreak":true},{"text":"tuja wakitki minaminish,","poem":1},{"lineBreak":true},{"text":"nigki tuké kuitamjamkatnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}