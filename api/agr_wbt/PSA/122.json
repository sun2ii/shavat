{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusalén kantamjuamu"]},{"type":"hebrew_subtitle","content":["David Jerusalén wakatatus wesa shiig aneak kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu jee pegkegma nuwi wemi","poem":1},{"lineBreak":true},{"text":"tujutuinakui, wika shiig anebiajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jerusalégkah, yamai juwi waitinum kaunaji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalén yaaktamamua nuwi","poem":1},{"lineBreak":true},{"text":"ashí tikich yaakat aidaushkam ijutkau ainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ashí Israel aents Tuke Pujuun aentsji aidauk","poem":1},{"lineBreak":true},{"text":"Jerusalén tuwainawai, Apajuín emematuinak,","poem":1},{"lineBreak":true},{"text":"wagki nuwi Apajuí ememattajum","poem":1},{"lineBreak":true},{"text":"tibau asag, nuna umiinak.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuwi awai chicham inagnatai,","poem":1},{"lineBreak":true},{"text":"tuja Davitan pujusa inamtaijishkam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuadui: “Jerusalégkah,","poem":1},{"lineBreak":true},{"text":"aminak utugchatak atsugtamti;","poem":1},{"lineBreak":true},{"text":"tuja amina anempaina dushakam","poem":1},{"lineBreak":true},{"text":"agkan pujustinme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaakat peeja apakbauwa nuna initken","poem":1},{"lineBreak":true},{"text":"aents batsata dushakam agkan,","poem":1},{"lineBreak":true},{"text":"tuja jega apu pujusa inamtaijiya","poem":1},{"lineBreak":true},{"text":"dushakam waitkaschamu ati”, titajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuja mina yatsug aidaun","poem":1},{"lineBreak":true},{"text":"kumpag aidaujai chichagkun:","poem":1},{"lineBreak":true},{"text":"“Atumnash utugchatak atsugtamtinme”, tajai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Untsu Jerusalégkah,","poem":1},{"lineBreak":true},{"text":"aminig pujut pegkeg ati tusa wakegajai,","poem":1},{"lineBreak":true},{"text":"wagki Tuke Pujuu amina Apajuígmi","poem":1},{"lineBreak":true},{"text":"jee pegkegma nunú au asamtai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}