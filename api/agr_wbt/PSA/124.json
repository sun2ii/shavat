{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":124,"content":[{"type":"heading","content":["Apajuík tuke yaijatui"]},{"type":"hebrew_subtitle","content":["David Jerusalén wakatatus wesa shiig aneak kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Ashí Israel aents aidautigmek,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu iina yaimpakchau akuish,","poem":1},{"lineBreak":true},{"text":"wajukauk ainji, tumamtajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tuke Pujuu iina yaimpakchau ataik,","poem":1},{"lineBreak":true},{"text":"aents aidau jetepagmaya nuaduik,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ashí ijipamain awajtamkajui,","poem":1},{"lineBreak":true},{"text":"senchi kajegtamkaju asag.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dutijamawagmatai namak dujajak tajaka","poem":1},{"lineBreak":true},{"text":"ajapama numamtuk ajapeam amain wajakuitji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Namak chichijam tajaka ajapama","poem":1},{"lineBreak":true},{"text":"numamtuk ajapjamain awajtamkajui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Tuke Pujuuk tuke pegkegnum chichagtai ati,","poem":1},{"lineBreak":true},{"text":"wagki shiwaaji ijinatnume","poem":1},{"lineBreak":true},{"text":"tusa idaitamsachu asamtai!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aents chigkin achiktatus detuamunum","poem":1},{"lineBreak":true},{"text":"chigki nemak tsujimak wegama numamtuk,","poem":1},{"lineBreak":true},{"text":"iishkam shiwag achigmak","poem":1},{"lineBreak":true},{"text":"mantamatag tujamainakui, pisaja uwemjabiaji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuu nayaimpin nugkajai","poem":1},{"lineBreak":true},{"text":"najanauwa nunuwai ayamkagtinuk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}