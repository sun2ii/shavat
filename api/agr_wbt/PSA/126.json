{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":126,"content":[{"type":"heading","content":["Achija yajuakbau waketjagbau"]},{"type":"hebrew_subtitle","content":["Jerusalén wakatatus wesag shiig aneenak kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"Achija yajupakagmatai, waitu batsatutin","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu awagtamag Jerusalén ikaupamtai,","poem":1},{"lineBreak":true},{"text":"kajanmatskait dekapin ayaji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuniaku senchi dushimiaji,","poem":1},{"lineBreak":true},{"text":"imaniaku shiig aneasa senchi kantamaiji.","poem":1},{"lineBreak":true},{"text":"Nuniajin tikich nugkanmaya aents","poem":1},{"lineBreak":true},{"text":"pegkegchau aidau chichainak:","poem":1},{"lineBreak":true},{"text":"“¡Tuke Pujuu ditanak","poem":1},{"lineBreak":true},{"text":"shiig pegkegnum yaigke!” tuyanume.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Duka dekaske, ¡Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"iinak yaimpak agkanmitkagmabi!","poem":1},{"lineBreak":true},{"text":"¡Nuadui iishkam shiig anebiaji!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuuwah, yumi uwegshunum yututai,","poem":1},{"lineBreak":true},{"text":"entsa najanea akagama numamtuk,","poem":1},{"lineBreak":true},{"text":"ataktu awagkim Jerusalén itajatuata!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents buu buuttajai ajakmaku aidauk,","poem":1},{"lineBreak":true},{"text":"atakea duwi shiig aneas juukagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja aents aidau ajak pegkejan juki","poem":1},{"lineBreak":true},{"text":"ajakmatatus buutkabaikia shiyakaju aidauk,","poem":1},{"lineBreak":true},{"text":"dita ajakmamunmayan juukag,","poem":1},{"lineBreak":true},{"text":"shiig aneas kantamkiag","poem":1},{"lineBreak":true},{"text":"dita jeen wakitkiagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":6}