{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":127,"content":[{"type":"heading","content":["Ashí Tuke Pujuunmaya junawai"]},{"type":"hebrew_subtitle","content":["Salomón Jerusalén wakatatus wesa shiig aneak kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuu jegan jegamchataik,","poem":1},{"lineBreak":true},{"text":"jegá jegamin aidauk wainak takak waituinawai;","poem":1},{"lineBreak":true},{"text":"tuja Tuke Pujuu yaakta kuitamchataik,","poem":1},{"lineBreak":true},{"text":"yaaktan kuitamin aidauk","poem":1},{"lineBreak":true},{"text":"wainak kuitamak waituinawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ajakma yuwatatus takak,","poem":1},{"lineBreak":true},{"text":"kashikmas nantaki tuke etsan akapakush,","poem":1},{"lineBreak":true},{"text":"kuashat juuka yuwatnunig","poem":1},{"lineBreak":true},{"text":"wainak imanik waituinawai.","poem":1},{"lineBreak":true},{"text":"Nuninai Apajuík niina kumpajinak kanak tepetaish,","poem":1},{"lineBreak":true},{"text":"nii yuwatnujinak ashí suwawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iina uchiji aina duka,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu anentag pegkejuch amasbau ainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ii datsa ajin iina uchiji akiinaina duka,","poem":1},{"lineBreak":true},{"text":"aents maanitan yacha nuna","poem":1},{"lineBreak":true},{"text":"flechajijai betek ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuadui aents kuashat uchigtina duka","poem":1},{"lineBreak":true},{"text":"shiig aneasagtin ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja niina shiwaaji aidaujai igkuniakush dushikiam achatnai,","poem":1},{"lineBreak":true},{"text":"niina uchiji kuashat asa, apajin ayamjukagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}