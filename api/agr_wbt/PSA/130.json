{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":130,"content":[{"type":"heading","content":["Tuke Pujuuwai kajintsa anentaibau"]},{"type":"hebrew_subtitle","content":["Jerusalén wakatatus wesag shiig anenaku kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuuwah, waanum initak","poem":1},{"lineBreak":true},{"text":"egkema pujusan amina untsuagme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Apuh, wi untsuajam nunú antugtukta!","poem":1},{"lineBreak":true},{"text":"¡Wi amina egakun untsumag","poem":1},{"lineBreak":true},{"text":"nunú antugtukam yainkata!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ame tsagkugkagtugchawaitkuminig,","poem":1},{"lineBreak":true},{"text":"iwakuk batsamaitsuji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tujash ame tsagkugkagtau asam,","poem":1},{"lineBreak":true},{"text":"eme anentsa umijam atatme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wika Tuke Pujuuwai ashí mina anentaigjai,","poem":1},{"lineBreak":true},{"text":"kajintsan pujajai.","poem":1},{"lineBreak":true},{"text":"Tuja nii anagkagtuawa nunashkam","poem":1},{"lineBreak":true},{"text":"dekaskeapi tajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wika yaakta kuitamin","poem":1},{"lineBreak":true},{"text":"wajupa asag tsawajat tusa,","poem":1},{"lineBreak":true},{"text":"tsawantan dakajama numamtuk","poem":1},{"lineBreak":true},{"text":"mina Apajuíjun dakajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel aents aidautigmek","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu taatnuji dakastajum;","poem":1},{"lineBreak":true},{"text":"wagki niyai awai anentak, tuja ashí agkanmaetashkam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuí Israel aents aidaun tudaujinak","poem":1},{"lineBreak":true},{"text":"ashí tsagkujug agkanmitkattawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}