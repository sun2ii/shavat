{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":137,"content":[{"type":"heading","content":["Achija Babilonia nugkanum yajuakbau"]},{"type":"verse","number":1,"content":[{"text":"Babilonia namak aidaunum","poem":1},{"lineBreak":true},{"text":"uwet pekaamsaja,","poem":1},{"lineBreak":true},{"text":"Jerusalén anentaimtusa buutiaji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuwi numi ayaunum nuna kanawen","poem":1},{"lineBreak":true},{"text":"iina arpaji aidau nenayaji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nunika nuwi batsatjin","poem":1},{"lineBreak":true},{"text":"suntag iina achipag yajupaku aidau","poem":1},{"lineBreak":true},{"text":"chichagtamainak:","poem":1},{"lineBreak":true},{"text":"“¡Shiig aneasjum kantamatajum,","poem":1},{"lineBreak":true},{"text":"tuja atumi nugkem Sión pachisjumshakam","poem":1},{"lineBreak":true},{"text":"kantamatajum!” tusa waitkagmayanume.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iik makichkish iina Apajuíji kantamjutaig","poem":1},{"lineBreak":true},{"text":"tikich nugkanmak kantamaitsuji, tuyaji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Jerusalégkah,","poem":1},{"lineBreak":true},{"text":"wi amina kajimatkin idaitaik,","poem":1},{"lineBreak":true},{"text":"mina uweg untsujua duka makichkish achika","poem":1},{"lineBreak":true},{"text":"takamainchau wajasti!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Tuja wi amina eme anentsuk,","poem":1},{"lineBreak":true},{"text":"kajimatkin idaikun shiig aneasan pujutaik,","poem":1},{"lineBreak":true},{"text":"mina idaijuk kayakmataijui nujamak asati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"babilonianmaya aents aidau","poem":1},{"lineBreak":true},{"text":"Jerusalégkan tsaikajua duwi,","poem":1},{"lineBreak":true},{"text":"Edom aents aidau chichainak:","poem":1},{"lineBreak":true},{"text":"“¡Ashí tsaiktajum!” tusa imatianum","poem":1},{"lineBreak":true},{"text":"nunú kajimatki idaisaipa!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Babiloniah, ameshkam tsayam atatme!","poem":1},{"lineBreak":true},{"text":"¡Ame jutii aidauti waitkagkagtam","poem":1},{"lineBreak":true},{"text":"nuna iiktamainak tsaipaidauk","poem":1},{"lineBreak":true},{"text":"shiig aneasagtin atinme!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Amina uchijum aidaun achika yajuakag","poem":1},{"lineBreak":true},{"text":"kayanum anugkag tsupig ijinawagtina nunak","poem":1},{"lineBreak":true},{"text":"Apajuí pegkegnum yumigjatin ati!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":9}