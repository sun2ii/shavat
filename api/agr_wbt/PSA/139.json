{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":139,"content":[{"type":"heading","content":["Apajuík ashí wainui"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuuwah, ame minak shiig dekagme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ame wi dutikamu aina duka ashí dekame,","poem":1},{"lineBreak":true},{"text":"amek atushat pujusmesh,","poem":1},{"lineBreak":true},{"text":"wi wajuk anentaimja dushakam dekame.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wi wajuk wekaeja duka amek ashí dekame,","poem":1},{"lineBreak":true},{"text":"¡wi wajina takaja dushakam ashí dekame!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wika eke chichatsaig,","poem":1},{"lineBreak":true},{"text":"wi wajina titag taja duka amek","poem":1},{"lineBreak":true},{"text":"emtikam dekame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ame minak ashí tententuam,","poem":1},{"lineBreak":true},{"text":"amina uwegmin achigsam pujame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wika amina yachajum imana nunak","poem":1},{"lineBreak":true},{"text":"kakajus dekamainchau dekapeajai.","poem":1},{"lineBreak":true},{"text":"Mina dekatjuk nuwig makichkish jegatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amina Wakanmin ukuknush ¿tuki wetaja?","poem":1},{"lineBreak":true},{"text":"Ame ashí nugkanum dekam nuniaish,","poem":1},{"lineBreak":true},{"text":"¿wisha itug tupikaknuk uumjuktagme?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wi nayaimpinum wakamtaish,","poem":1},{"lineBreak":true},{"text":"amek nuwi pujuttame,","poem":1},{"lineBreak":true},{"text":"tuja wi nugka initken akaikimtaish,","poem":1},{"lineBreak":true},{"text":"amek nuwishkam pujuttame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi nanaakan etsa minitaiya nuni wemataish,","poem":1},{"lineBreak":true},{"text":"ame minak achigkau atatme,","poem":1},{"lineBreak":true},{"text":"tuja etsa akaetaiya nuni nayantsa amain wenu","poem":1},{"lineBreak":true},{"text":"pujusmataishkam, ame minak yainkattame.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wi suwenum uumkatjai tumainaitjai,","poem":1},{"lineBreak":true},{"text":"tuja nuniachkush tsawaiya nunú suwe wajasmataish,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"suwea duka minak aminig ugmaitsui;","poem":1},{"lineBreak":true},{"text":"ame diismak kashia duka tsaaptinai.","poem":1},{"lineBreak":true},{"text":"¡Ame diismak suwea duka tsaaptinjai betekai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ame mina iyashjuk najatjuawaitme,","poem":1},{"lineBreak":true},{"text":"ame minak, mina dukuju wakeen najatuawaitme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wika ame imatiksa najanamu asan see tajame,","poem":1},{"lineBreak":true},{"text":"ame najanamu aina duka ashí pegkejai.","poem":1},{"lineBreak":true},{"text":"¡Wika nunak shiig dekajai!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wi initak wainkachbau","poem":1},{"lineBreak":true},{"text":"mina dukuju wakeen najaneauwaitag duka ame waitmayume,","poem":1},{"lineBreak":true},{"text":"eke najaneaig wajupa tsawan pujustinaitja duka","poem":1},{"lineBreak":true},{"text":"ame umigtukuitme.","poem":1},{"lineBreak":true},{"text":"¡Nunú amina papiigmin agagbauwai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Chah Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"amina anentaimtagmia nunak","poem":1},{"lineBreak":true},{"text":"shiig anentaimja ejeyin","poem":1},{"lineBreak":true},{"text":"dekamainchau dekapeajai.","poem":1},{"lineBreak":true},{"text":"¡Untsu nuna pachisan augmattsatag takun","poem":1},{"lineBreak":true},{"text":"ima utugchat dekapmainaitjai!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuna dekapagtajai takunush,","poem":1},{"lineBreak":true},{"text":"kamatak kuashta iman asamtai,","poem":1},{"lineBreak":true},{"text":"kakajus dekapamaitsujai.","poem":1},{"lineBreak":true},{"text":"¡Tuja kanaja shintaish amek wijaig pujame!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Apajuíyah, aents pegkegchau aina duka ijinata,","poem":1},{"lineBreak":true},{"text":"dutikakum magkagtin aidaushkam datupatjukta.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nunú aents aidauk amina daagmin pachisag","poem":1},{"lineBreak":true},{"text":"pegkegchaun chichainawai.","poem":1},{"lineBreak":true},{"text":"Nuninak amijai wainak shiwagmagainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina kajegtamaidaunak wishakam kajejajai,","poem":1},{"lineBreak":true},{"text":"tuja amina dakitjamaidaunashkam","poem":1},{"lineBreak":true},{"text":"dutiksanuk dakitajai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Nunú aents aidaunak shiig senchi kajejajai!","poem":1},{"lineBreak":true},{"text":"Amina shiwaajum aina duka","poem":1},{"lineBreak":true},{"text":"mina shiwag ainawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Chah Apajuíyah,","poem":1},{"lineBreak":true},{"text":"mina anentaijush shiig diigtusta,","poem":1},{"lineBreak":true},{"text":"dutikam mina anentaimtajush shiig dekapjuttsata.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tudau jintan aintsujash nunú diigtusta,","poem":1},{"lineBreak":true},{"text":"nuniakum jinta pujut nagkankashtinnum","poem":1},{"lineBreak":true},{"text":"ekagtina nuni etita.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":22}