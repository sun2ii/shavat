{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":145,"content":[{"type":"heading","content":["Ashí aents aidauk Apajuín ememattinme"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Mina apug Apajuíyah,","poem":1},{"lineBreak":true},{"text":"amina daajum ajumaish tuke atina","poem":1},{"lineBreak":true},{"text":"nuna pachisan etsegkatjai.","poem":1},{"lineBreak":true},{"text":"Tuja amina daagminak tuké pegkegnum","poem":1},{"lineBreak":true},{"text":"chichagtinaitjai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashí tsawantai aminak pegkegnum chichagtatjame,","poem":1},{"lineBreak":true},{"text":"nuniakun amina daagmin tuke ememattinaitjai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk dekas múuntai,","poem":1},{"lineBreak":true},{"text":"iman asa ima nigki emematam amainai,","poem":1},{"lineBreak":true},{"text":"iman asamtai anentaimsaish, kakajus dekamaitsui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Uchi akiinak wegagtina duka","poem":1},{"lineBreak":true},{"text":"ame pegkeg iwainajuitam nuna emematiagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja amina senchigmejai","poem":1},{"lineBreak":true},{"text":"wainchatai ishamain aidau","poem":1},{"lineBreak":true},{"text":"iwainajuitam nunú etsegnaktinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amina imanjumin tsaaptinjumjai pachisag","poem":1},{"lineBreak":true},{"text":"etsejiagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninakui wishakam","poem":1},{"lineBreak":true},{"text":"ame iwainajuitam nuna pachisan chichattajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amina senchigmin shiwaajum aidau","poem":1},{"lineBreak":true},{"text":"depetnaitam nuna pachisag chichagtinai.","poem":1},{"lineBreak":true},{"text":"Nuninakui wishakam ame múuntaitam","poem":1},{"lineBreak":true},{"text":"nuna pachisan chichattajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amina wait anenkagtutaigmin","poem":1},{"lineBreak":true},{"text":"pachisag etsejiagtinai;","poem":1},{"lineBreak":true},{"text":"nuninak shiig aneas kantamainak:","poem":1},{"lineBreak":true},{"text":"¡Apajuíyai pegkegmak! tujamiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuke Pujuuk kakagchauch, wait anenkagtin;","poem":1},{"lineBreak":true},{"text":"wamak kajechu anentak wajasui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk ashí aents aidaun kuitamui;","poem":1},{"lineBreak":true},{"text":"tuja tikich nii najankamu aina nunashkam puyatjus kuitamui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ashí ame najankamu aidau emematjamtinme!","poem":1},{"lineBreak":true},{"text":"¡Tuja amina umigtamin aidaushkam","poem":1},{"lineBreak":true},{"text":"pegkegnum chichagtamtinme!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Amina inamtaijum pegkegma nuna","poem":1},{"lineBreak":true},{"text":"pachisag chichatnume!","poem":1},{"lineBreak":true},{"text":"¡Tuja amina senchigmejai","poem":1},{"lineBreak":true},{"text":"wainchatai ishamain aidau","poem":1},{"lineBreak":true},{"text":"iwainajuitam nuna pachisag chichagtatui!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Tuja amina senchigmea nuna,","poem":1},{"lineBreak":true},{"text":"ame inamtaijum pegkegma nujai","poem":1},{"lineBreak":true},{"text":"ashí aents aidau dekaatnume!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amina inamtaigmea duka","poem":1},{"lineBreak":true},{"text":"ajumaish tuke atinai,","poem":1},{"lineBreak":true},{"text":"nuadui ajumaish amek tuke inamtinaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tuke Pujuu aents wake besemag pujaunash yayawai,","poem":1},{"lineBreak":true},{"text":"tuja kakakchau wajas pujaunash senchimtikawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apujuh, ashí aents aidauk","poem":1},{"lineBreak":true},{"text":"amina dakagmainawai, yutain sujamsati tusa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuninakui ame shiig aneasam suwame,","poem":1},{"lineBreak":true},{"text":"nuna ashí iwaku aidauk","poem":1},{"lineBreak":true},{"text":"yuwawag ejemakag shiig anenawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk ashí","poem":1},{"lineBreak":true},{"text":"nii anagkagtuamunak betek uminai,","poem":1},{"lineBreak":true},{"text":"tuja nii najankamu aina nunak","poem":1},{"lineBreak":true},{"text":"shiig anentawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk aents niina dekaskenum","poem":1},{"lineBreak":true},{"text":"segau aina nujai ijutkawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja niina eme anentus umijin aina nunú","poem":1},{"lineBreak":true},{"text":"segamak antujuk yaigka uwemtikui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk niina aneen aidaun kuitamui;","poem":1},{"lineBreak":true},{"text":"untsu aents pegkegchau aidaunak ijina utsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"¡Wika kantamkun Tuke Pujuun ememattatjai!","poem":1},{"lineBreak":true},{"text":"¡Ashí aents nugkanum batsamin aidauk","poem":1},{"lineBreak":true},{"text":"Apajuí daaji pegkegma nuna pachisag","poem":1},{"lineBreak":true},{"text":"tuké ajumaish ememattin atinme!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":21}