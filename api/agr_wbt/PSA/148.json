{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":148,"content":[{"type":"heading","content":["Apajuí najankamu aidautigmek nii ememattajum"]},{"type":"verse","number":1,"content":[{"text":"¡Iina Apajuíji emematiagmi!","poem":1},{"lineBreak":true},{"text":"¡Nayaim aidautijum Tuke Pujuu ememattajum!","poem":1},{"lineBreak":true},{"text":"¡Yakí agkajunum Apajuí ememattajum!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Atum Apajuí aentsji ángel aidautijum","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum!","poem":1},{"lineBreak":true},{"text":"¡Nayaimpinmaya suntag aidauwah,","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Etsa, nantu aidauwah,","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum!","poem":1},{"lineBreak":true},{"text":"¡Yaya aidautigmesh Apajuí ememattajum!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Yumi yakiya aidautigmesh","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum!","poem":1},{"lineBreak":true},{"text":"¡Nayaim shiig múunta","poem":1},{"lineBreak":true},{"text":"dushakam Apajuín emematti!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu daaji ememattajum,","poem":1},{"lineBreak":true},{"text":"wagki nii chichakmatai,","poem":1},{"lineBreak":true},{"text":"ashí najaneakua nuadui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nii ashí umikui tuke asatnun;","poem":1},{"lineBreak":true},{"text":"dutika chichaman umikui atakesh yapajinashtinun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Nugkaya aidautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja nayantsanum batsamin","poem":1},{"lineBreak":true},{"text":"kuntin múun aidautigmesh,","poem":1},{"lineBreak":true},{"text":"nayantsa initken batsamin aidaujaí","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu ememattajum!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Chaajip, bicha, nieve, yujagkim aidautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja dase Apajuí dasenkati tima","poem":1},{"lineBreak":true},{"text":"ishamain dasentin aidautigmesh,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"muja aidautigmesh, nain aidautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja ashí setug aidautigmesh,","poem":1},{"lineBreak":true},{"text":"numi neje yujutai aidautigmesh","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Kuntin tagkumtai, kuntin tagkumchatai,","poem":1},{"lineBreak":true},{"text":"chigki aidau, kuntin japiinas yujau aidautigmesh,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"tuja ashí nugka múun aidaun","poem":1},{"lineBreak":true},{"text":"apuji aidautigmesh, atumi aentsjum aidaujai,","poem":1},{"lineBreak":true},{"text":"apu ashí nugkanmaya aidautigmesh,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"aishmag, nuwa,","poem":1},{"lineBreak":true},{"text":"datsa, múuntuch aidautigmesh,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ashí Tuke Pujuun daaji ememattajum,","poem":1},{"lineBreak":true},{"text":"wagki ima niina daajiya duke múuntak!","poem":1},{"lineBreak":true},{"text":"¡Niina imanjiya duka nayaimpin","poem":1},{"lineBreak":true},{"text":"nugkajai nagkaesau múuntai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"¡Apajuí niina aentsji aidaunak senchimtikawai!","poem":1},{"lineBreak":true},{"text":"Nuadui niina aentsji Israel wegantu aidautik","poem":1},{"lineBreak":true},{"text":"nii emematuinaji.","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah!","poem":1},{"lineBreak":true},{"text":"Apajuí ememattai ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":14}