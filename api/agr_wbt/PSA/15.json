achu,","poem":1},{"lineBreak":true},{"text":"tuja nii ijutkamu aidaunash inatsauchu;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"aents Apajuín dakitaujaig","poem":1},{"lineBreak":true},{"text":"makichkish ijunchau,","poem":1},{"lineBreak":true},{"text":"untsu Tuke Pujuun eme anentaunak","poem":1},{"lineBreak":true},{"text":"niishkam eme anentus diin,","poem":1},{"lineBreak":true},{"text":"tuja waitiakush","poem":1},{"lineBreak":true},{"text":"nii anagkagtuamunak betek umin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuichkin tsagkatkagtukash","poem":1},{"lineBreak":true},{"text":"ewaekam akigkata tusa waitkagkagtuchu,","poem":1},{"lineBreak":true},{"text":"tuja aents takamsachu aig,","poem":1},{"lineBreak":true},{"text":"tsanumjugta akiktagme tamash dakitin.","poem":1},{"lineBreak":true},{"text":"Nunú aents imanis puja duka shiig aneas tajimat pujustinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}