{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":16,"content":[{"type":"heading","content":["Apajuí mina sujusua nuna nagkaesau pegkejak atsawai"]},{"type":"hebrew_subtitle","content":["David agagbau"]},{"type":"verse","number":1,"content":[{"text":"Chah, Tuke Pujuuwah, kuitamjukta,","poem":1},{"lineBreak":true},{"text":"wika aminí ejamatnak egajai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi amina chichagkun:","poem":1},{"lineBreak":true},{"text":"“Ametme mina apug","poem":1},{"lineBreak":true},{"text":"pegkegnum yainnumek,","poem":1},{"lineBreak":true},{"text":"tikich amea ibauk atsawai.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ame chichagtakum:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug nugka batsata nunú","poem":1},{"lineBreak":true},{"text":"minak umigtuidau asag","poem":1},{"lineBreak":true},{"text":"shiig awajtuinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Untsu tikich aents aidau apajuíchun apajuímainak niina umijuina duka","poem":1},{"lineBreak":true},{"text":"senchi waittsagtinai”, tame.","poem":1},{"lineBreak":true},{"text":"Nuadui wika nunak","poem":1},{"lineBreak":true},{"text":"tuké etsagjashtinaitjai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú apajuímtai aina","poem":1},{"lineBreak":true},{"text":"nunak makichkish emematchattajai.","poem":1},{"lineBreak":true},{"text":"Nuna daajinakesh makichkish adaikashtinaitjai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme mina ashí sujinmek.","poem":1},{"lineBreak":true},{"text":"Ame sujame kuashat pegkeg aidau,","poem":1},{"lineBreak":true},{"text":"mina pujutjua duka aminí awai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nugka shiig pegkeg aidau","poem":1},{"lineBreak":true},{"text":"makichkish wi anentaimtujakchamu ajutui,","poem":1},{"lineBreak":true},{"text":"Apajuí anagtuamu wi jukitin ajuta duka","poem":1},{"lineBreak":true},{"text":"dekas shiig pegkejai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuke Pujuunak shiig pegkegnum chichagtinaitjai,","poem":1},{"lineBreak":true},{"text":"nii minak pegkegnum jintinjau asamtai.","poem":1},{"lineBreak":true},{"text":"Dekas mina iyashjunash jintinjutui,","poem":1},{"lineBreak":true},{"text":"dutijak kashishkam esetawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuu mina Apajuíjua duka","poem":1},{"lineBreak":true},{"text":"tuke wijai ijutkau pujawai.","poem":1},{"lineBreak":true},{"text":"Wika niini emetuman wajau asamtai, makichkish ajunjashtin ainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wika shiig aneasan dakunkut pujajai,","poem":1},{"lineBreak":true},{"text":"ima niyaig kajintsa anentaimsan pujuttajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apajuíjuh, amek minak","poem":1},{"lineBreak":true},{"text":"jakati tusamek idaituschattame,","poem":1},{"lineBreak":true},{"text":"tuja ¡pegkegmaitak ukumatainum ukusam","poem":1},{"lineBreak":true},{"text":"kaugti tusamesh idaituschattame!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jinta pujutnum ekagtina nunú","poem":1},{"lineBreak":true},{"text":"ame iwaintugkattame.","poem":1},{"lineBreak":true},{"text":"Ame pujamugmia nuwig","poem":1},{"lineBreak":true},{"text":"shiig dakujamu awai.","poem":1},{"lineBreak":true},{"text":"Aminí awai dakujut tuke atina nunú.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}