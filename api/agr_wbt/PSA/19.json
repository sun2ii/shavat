{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":19,"content":[{"type":"heading","content":["Apajuí imanjiya duka nii najankamu aina duwi dekanui"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuí imanjiya nunak","poem":1},{"lineBreak":true},{"text":"nayaimpia nunú ujajatui,","poem":1},{"lineBreak":true},{"text":"nayaim wigkaya nunú wainku,","poem":1},{"lineBreak":true},{"text":"dekas Apajuíyap najanauwaita taji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsawaiya nunú, kashia nujai,","poem":1},{"lineBreak":true},{"text":"Apajuí imanjinak tuke etsejuinawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chichainachiatak,","poem":1},{"lineBreak":true},{"text":"makichik chichamnakesh tuinachiatak,","poem":1},{"lineBreak":true},{"text":"tuja chichamujigkesh antugchatayaitak,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ashí nugka nagkatkamunum","poem":1},{"lineBreak":true},{"text":"dita chichainamuk antugainawai.","poem":1},{"lineBreak":true},{"text":"Tuja nayaimpinum etsa ekemsatnunak","poem":1},{"lineBreak":true},{"text":"Apajuí umikui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Etsag nuwi eketu makichik aents","poem":1},{"lineBreak":true},{"text":"yama nuwan nuwatuk","poem":1},{"lineBreak":true},{"text":"nii kanutaijin pujau","poem":1},{"lineBreak":true},{"text":"jiinama numamtuk kashikmas jiinui.","poem":1},{"lineBreak":true},{"text":"Nunik jiinki aents","poem":1},{"lineBreak":true},{"text":"tupikain uminas shiig aneas","poem":1},{"lineBreak":true},{"text":"wemaina numamtuk weawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nunik nayaim tikich yantamnumia etsa jiinki,","poem":1},{"lineBreak":true},{"text":"tentea wea weakua,","poem":1},{"lineBreak":true},{"text":"yaja tikich yantamnum jegaa kintamui.","poem":1},{"lineBreak":true},{"text":"Nuadui etsa etsantun uwemtumainuk makichkish atsawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuke Pujuun chichamega duka","poem":1},{"lineBreak":true},{"text":"yamajam pujutan sukagtau asa, shiig pegkejai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun chichamega duka","poem":1},{"lineBreak":true},{"text":"waitchauwai, shiig dekaske,","poem":1},{"lineBreak":true},{"text":"wagki nunú aents","poem":1},{"lineBreak":true},{"text":"kakagchauchin unuidau asa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuun chichame","poem":1},{"lineBreak":true},{"text":"umiktina duka pegkejai,","poem":1},{"lineBreak":true},{"text":"anentainum dakujutan sukagtau asa.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun chichame umiktina duka","poem":1},{"lineBreak":true},{"text":"dekas shiig pegkeg tsaaptinun anentaimtikagtinai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuke Pujuu puyatjusa","poem":1},{"lineBreak":true},{"text":"umigbauwa duka shiig pegkejai,","poem":1},{"lineBreak":true},{"text":"tuja nii chichamega dusha","poem":1},{"lineBreak":true},{"text":"tuke megkaekashtinai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun chichame umiktina duka waitchauwai,","poem":1},{"lineBreak":true},{"text":"dekaskenum ashí pegkejai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Nunú chichamak oro tsuwatjinchau","poem":1},{"lineBreak":true},{"text":"shiig pegkeg akika nuna nagkaesauwai,","poem":1},{"lineBreak":true},{"text":"tuja dapa yumiji yumimitu pegkejama","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau shiig pegkejai!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wika amina inakmetag duwi pegkegchaun takasai tujutu asa,","poem":1},{"lineBreak":true},{"text":"amina chichamjumea nunú jintinjawai.","poem":1},{"lineBreak":true},{"text":"Nunú chichaman umiauk shiig pujustinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Makichik aentsuk niina tudaujinak","poem":1},{"lineBreak":true},{"text":"nigki anentaimsag dekagmamaitsui.","poem":1},{"lineBreak":true},{"text":"Nuadui, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"¡wi pegkegchaun takamsatjai tusan","poem":1},{"lineBreak":true},{"text":"wakegachiatkun takamsamug aidaush tsagkugtugta!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja mina ememataijush emegkatjukta.","poem":1},{"lineBreak":true},{"text":"Mina emematug wagagtuki, idaitusaipa.","poem":1},{"lineBreak":true},{"text":"Aatsan wisha ibau tudau ajuta","poem":1},{"lineBreak":true},{"text":"nuna agkanmagatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tuke Pujuuwah, mina chichamjush","poem":1},{"lineBreak":true},{"text":"mina anentaimtagjai,","poem":1},{"lineBreak":true},{"text":"ame diismash pegkeg, wakemain ati.","poem":1},{"lineBreak":true},{"text":"Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme mina ayamjutkam uwemtijinmek.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}