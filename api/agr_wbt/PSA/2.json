{"lineBreak":true},{"text":"duka ankanmagawagmi!","poem":1},{"lineBreak":true},{"text":"¡Tuja jigkaja emetuamujai betek","poem":1},{"lineBreak":true},{"text":"batsatag dushakam","poem":1},{"lineBreak":true},{"text":"agkanmagawagmi!” wajainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imatiagtai Apajuík niina pujusa inamtaijin","poem":1},{"lineBreak":true},{"text":"nayaimpinum pujus dushikiawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dutikak kajejuk uwakeawai,","poem":1},{"lineBreak":true},{"text":"untsu nuni senchi kajejuk chichajak:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Wi etegkan apu emamugnak","poem":1},{"lineBreak":true},{"text":"muja etegkamua nuwi Jerusalén","poem":1},{"lineBreak":true},{"text":"pujus inamjati tusan","poem":1},{"lineBreak":true},{"text":"wi apusajai”, tawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuja Tuke Pujuu mina tujutma","poem":1},{"lineBreak":true},{"text":"nuna etsegkatjai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu chichagtak:","poem":1},{"lineBreak":true},{"text":"“Ametme mina uchigmek,","poem":1},{"lineBreak":true},{"text":"amek wi akiinati tima akiinauwaitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ame wakegamu segatta,","poem":1},{"lineBreak":true},{"text":"Wi nunak imatiksanuk ashí nugkanmaya","poem":1},{"lineBreak":true},{"text":"aents aidaun amastatjame aminu atinun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ichinak najanamu shigki basegbauwai","poem":1},{"lineBreak":true},{"text":"awati tsaimaina numamtuk,","poem":1},{"lineBreak":true},{"text":"apu pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"ame tsaika utsagtatme”, tujutmae.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Apu nugkanum inamin aidauwah,","poem":1},{"lineBreak":true},{"text":"shiig antuktajum, nunikjum","poem":1},{"lineBreak":true},{"text":"juju chicham shiig unuimagtajum!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuniakjum Apajuí","poem":1},{"lineBreak":true},{"text":"eme anentsajum umigkujum","poem":1},{"lineBreak":true},{"text":"shiig aneasjum ememattajum.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Apajuí eme anentsajum ememattajum","poem":1},{"lineBreak":true},{"text":"kajegtamkainum, nii kajegtamkamtaig","poem":1},{"lineBreak":true},{"text":"jinumain ainagme, wagki nii kajeamujig","poem":1},{"lineBreak":true},{"text":"makichkish imijtumaitsui.","poem":1},{"lineBreak":true},{"text":"Aents Apajuíyai kajinas anentaimaidauk","poem":1},{"lineBreak":true},{"text":"nii kuitamsam pujuidau asag,","poem":1},{"lineBreak":true},{"text":"shiig aneas pujusagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}