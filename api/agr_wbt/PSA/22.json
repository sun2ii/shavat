{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":22,"content":[{"type":"heading","content":["Waitiamunum pujusa Apajuí emematku kantabau"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"¡Apajuíjuh, Apajuíjuh!","poem":1},{"lineBreak":true},{"text":"¿Wagka minash idaitusume?","poem":1},{"lineBreak":true},{"text":"¿Wagka taamesh uwemtijatsme?","poem":1},{"lineBreak":true},{"text":"¿Wagka wi imanikan amina segaakun","poem":1},{"lineBreak":true},{"text":"buutaish pachittsume?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mina Apajuíjuh, tsawaish,","poem":1},{"lineBreak":true},{"text":"kashish untsuajame,","poem":1},{"lineBreak":true},{"text":"imatjamash aigtsume.","poem":1},{"lineBreak":true},{"text":"¡Wi ayabaujuk atsugtawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tujash ametme pegkegmamek,","poem":1},{"lineBreak":true},{"text":"ametme apumek, iman asamin","poem":1},{"lineBreak":true},{"text":"Israel wegantu aidau emematjamainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iina apachji aajaku aina duka","poem":1},{"lineBreak":true},{"text":"aminí kajinmamsag","poem":1},{"lineBreak":true},{"text":"anentaimajaku ainawai;","poem":1},{"lineBreak":true},{"text":"aminí kajinmamsag","poem":1},{"lineBreak":true},{"text":"anentaimaidau asamtai,","poem":1},{"lineBreak":true},{"text":"agkanmitkauwaitme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yainkata tusa segapainakuish,","poem":1},{"lineBreak":true},{"text":"ame agkanmitkauwaitme,","poem":1},{"lineBreak":true},{"text":"tuja aminí kajitmamsag","poem":1},{"lineBreak":true},{"text":"anentaimaidau asagmatai,","poem":1},{"lineBreak":true},{"text":"tsanugmek idaisachuitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuja wika aents tamak amaitsujai,","poem":1},{"lineBreak":true},{"text":"wika bagajai betekaitjai.","poem":1},{"lineBreak":true},{"text":"¡Wika aents aidaun dushiktaiyaitjai!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mina waituidauk dushijuinawai,","poem":1},{"lineBreak":true},{"text":"nuninak buuken pegainawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuninak: “¡Tuke Pujuuwai","poem":1},{"lineBreak":true},{"text":"kajinmamas anentaima pujuuwe","poem":1},{"lineBreak":true},{"text":"nuadui, nii taa uwemtikjati!","poem":1},{"lineBreak":true},{"text":"¡Imatika aneau asa, nii uwemtijati!” tuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tuu yujatnume:","poem":1},{"lineBreak":true},{"text":"Ame minak akiinati tujutiu asamin,","poem":1},{"lineBreak":true},{"text":"mina dukuju waken","poem":1},{"lineBreak":true},{"text":"egkemkan akiinawaitjai.","poem":1},{"lineBreak":true},{"text":"Tuja ame minak mina dukuju kuntujin","poem":1},{"lineBreak":true},{"text":"patattsam kuitamjukmayume.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Duwik nagkamsam wi akiintsaig,","poem":1},{"lineBreak":true},{"text":"ame minak kuitamjukuitme.","poem":1},{"lineBreak":true},{"text":"Tuja mina dukuju wakeen pujubiag","poem":1},{"lineBreak":true},{"text":"duwi nagkamsamek","poem":1},{"lineBreak":true},{"text":"mina Apajuíg aayume.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ima minakek idaitusaipa,","poem":1},{"lineBreak":true},{"text":"wika waittanum jegantan pujajai.","poem":1},{"lineBreak":true},{"text":"Tuja mina yainmainuk atsugtawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mina shiwag aidauk,","poem":1},{"lineBreak":true},{"text":"baságnumia toro kajen aina","poem":1},{"lineBreak":true},{"text":"iman tententuawaje.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dutijuawag ikamyawa kajen","poem":1},{"lineBreak":true},{"text":"shinuwama imatuinak","poem":1},{"lineBreak":true},{"text":"esattatus tsekenjuinawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuja wika yumi ukagag","poem":1},{"lineBreak":true},{"text":"megkagama numamtinaitjai;","poem":1},{"lineBreak":true},{"text":"mina ukunchig aidauk","poem":1},{"lineBreak":true},{"text":"akaejaujai betek wajase.","poem":1},{"lineBreak":true},{"text":"Tuja mina anentaijuk","poem":1},{"lineBreak":true},{"text":"wiya yumimeaujai betek wajase.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mina wenujuk ichinak yama inajuamu","poem":1},{"lineBreak":true},{"text":"bukuama nunin wajase.","poem":1},{"lineBreak":true},{"text":"Mina idaijush kayakmataijui nujamjutkae.","poem":1},{"lineBreak":true},{"text":"¡Jakaujai betek minak","poem":1},{"lineBreak":true},{"text":"nugka yukukuntunum aepjukiume!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aents pegkegchaun takau aidau","poem":1},{"lineBreak":true},{"text":"yawajai betek tuwagtukaje;","poem":1},{"lineBreak":true},{"text":"tuja mina dawegnak,","poem":1},{"lineBreak":true},{"text":"mina uwejujai ichinjujaje.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mina ukunchig aidaunash","poem":1},{"lineBreak":true},{"text":"pan wainmain dekapeajai;","poem":1},{"lineBreak":true},{"text":"tuja mina shiwag aidauk","poem":1},{"lineBreak":true},{"text":"ayatak diiju batsatui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mina jáanchjun jujutkiag, yana daajig jiinkiti,","poem":1},{"lineBreak":true},{"text":"nunú jukiti tusag,","poem":1},{"lineBreak":true},{"text":"nunú dutika dekatain","poem":1},{"lineBreak":true},{"text":"wasugkamainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tujash Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme mina senchimtijinmek.","poem":1},{"lineBreak":true},{"text":"¡Tupanjutsuk, wamak taam yainkata!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Puyajai ijutiag mantuawainum","poem":1},{"lineBreak":true},{"text":"minash agkanmitkajuata.","poem":1},{"lineBreak":true},{"text":"Yawajai betek aina nunú","poem":1},{"lineBreak":true},{"text":"maatnume tusamek idaitusaipa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Leónjai betek kajen aina nunú mantuawainum ayamjutkata.","poem":1},{"lineBreak":true},{"text":"¡Toro kajen kachujin","poem":1},{"lineBreak":true},{"text":"magkagtina iman aina nunú","poem":1},{"lineBreak":true},{"text":"mantuawainum ayamjutkata!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ame ayamjutkamin, wi amina pachisan","poem":1},{"lineBreak":true},{"text":"mina yatsug aidaun ujaktajai;","poem":1},{"lineBreak":true},{"text":"dutikan ditajai ijunjan","poem":1},{"lineBreak":true},{"text":"amina emematkun kantamatjai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Atum Israel aents aidautijum,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu eme anentin aidautigmek,","poem":1},{"lineBreak":true},{"text":"Niina senchiji anentaimtusjum ememattajum!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Apajuík ujudauch aidau waitiamun","poem":1},{"lineBreak":true},{"text":"wainiatkug waittsatnume tusag","poem":1},{"lineBreak":true},{"text":"pachitskek idaitsui.","poem":1},{"lineBreak":true},{"text":"Tuja uumjutnakesh uumjuchui.","poem":1},{"lineBreak":true},{"text":"Yainkata tusa segamak antujui,","poem":1},{"lineBreak":true},{"text":"nunik betek yayawai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"ima aminak ememattagme,","poem":1},{"lineBreak":true},{"text":"amina aentsjum eme anenjamin aidau","poem":1},{"lineBreak":true},{"text":"kuashat tuwakbaunum nunak umiktatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ujunauch aidautigmek","poem":1},{"lineBreak":true},{"text":"yutai yuwajum shiig ejemagtajum.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí wainkatasa","poem":1},{"lineBreak":true},{"text":"egautigmek nii ememattajum,","poem":1},{"lineBreak":true},{"text":"nuniakjum kuashat mijan pujustajum.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ashí aents tikich nugkanmaya","poem":1},{"lineBreak":true},{"text":"ditash niimtin aidau,","poem":1},{"lineBreak":true},{"text":"chichamnash tikich","poem":1},{"lineBreak":true},{"text":"chichaman chichaaku aidauwah,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu kajimatkigpajum.","poem":1},{"lineBreak":true},{"text":"Niiyai jeganjum,","poem":1},{"lineBreak":true},{"text":"¡tikishmaja pujusjum ememattajum!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwai apua duka,","poem":1},{"lineBreak":true},{"text":"iman asa ashí nugkanum inamui.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Shiig atsumkas pujautigmesh,","poem":1},{"lineBreak":true},{"text":"tuja ashí jaka pujautigmeshkam,","poem":1},{"lineBreak":true},{"text":"ima Apajuíya duke tsuntsumjuajum etsagjatajum,","poem":1},{"lineBreak":true},{"text":"wagki ima atumkek","poem":1},{"lineBreak":true},{"text":"pujutak jukichu asajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Wi wegantu aidauk","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun emematuinak,","poem":1},{"lineBreak":true},{"text":"tuké niina pachisag etsejiagtin ainawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nuninak atakea duwi","poem":1},{"lineBreak":true},{"text":"akiinawagtina nunashkam","poem":1},{"lineBreak":true},{"text":"Apajuín takatji pegkeja nuna,","poem":1},{"lineBreak":true},{"text":"kuashat wainchatai aidaun","poem":1},{"lineBreak":true},{"text":"iwainajua nujai pachisag ujakagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":31}