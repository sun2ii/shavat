k":true},{"text":"wi pimpitaishkam ichichtawai,","poem":1},{"lineBreak":true},{"text":"dutijua pujut pegkegnum etawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nugka ségaju ishamain","poem":1},{"lineBreak":true},{"text":"suwenum nagkaemaknush,","poem":1},{"lineBreak":true},{"text":"ame wijai wekagu asamin, ishamkashtatjai.","poem":1},{"lineBreak":true},{"text":"Uwija kuitamin uwigjin ayamjuktatus","poem":1},{"lineBreak":true},{"text":"ushujutaijin takus wekagama numamtuk,","poem":1},{"lineBreak":true},{"text":"amek mina ayamjutkatasam wekaeme.","poem":1},{"lineBreak":true},{"text":"Nuadui jamainnum jegaknush ishamkashtatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mina shiwag kajegtin aidaun emtin,","poem":1},{"lineBreak":true},{"text":"ame minak yutai pegkeg aidau umigtame.","poem":1},{"lineBreak":true},{"text":"Aents ipaamujin shiig anentus juwak","poem":1},{"lineBreak":true},{"text":"buuken kugkuinai nijau aina imatiksam","poem":1},{"lineBreak":true},{"text":"minak shiig awajtukume.","poem":1},{"lineBreak":true},{"text":"Umutai umikbau pinignum aun","poem":1},{"lineBreak":true},{"text":"aents wainak shiig anegama numamtuk,","poem":1},{"lineBreak":true},{"text":"minashkam shiig anemtijusume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amina anenkagmia nunú,","poem":1},{"lineBreak":true},{"text":"wait anenkagtutaigmijai","poem":1},{"lineBreak":true},{"text":"ashí tsawantai tuke uyuuntawai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwah, wika","poem":1},{"lineBreak":true},{"text":"ame pujam nuwi tuke pujustinaitjai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}