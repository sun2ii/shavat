{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":24,"content":[{"type":"heading","content":["Ashí najankamu aina nuna apuji"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Nugkak ashí Tuke Pujuunui,","poem":1},{"lineBreak":true},{"text":"nunú nugkanum ashí ayá duka,","poem":1},{"lineBreak":true},{"text":"nuwi batsamin aidaujai","poem":1},{"lineBreak":true},{"text":"ashí niinu ainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wagki nugka tujig asatnunak nii umikui,","poem":1},{"lineBreak":true},{"text":"dutika nayantsanum,","poem":1},{"lineBreak":true},{"text":"namak aidaunum aatus","poem":1},{"lineBreak":true},{"text":"emetug idaisauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tuke Pujuu mujaji etegkamua nuwish","poem":1},{"lineBreak":true},{"text":"¿yaki wakainta?","poem":1},{"lineBreak":true},{"text":"Apajuí jee pegkegma imannummash","poem":1},{"lineBreak":true},{"text":"¿yaki wayash pujusainta?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nunak aents pegkegchaun takachu,","poem":1},{"lineBreak":true},{"text":"anentai pegkeg,","poem":1},{"lineBreak":true},{"text":"dakumka najanamun emematchau,","poem":1},{"lineBreak":true},{"text":"umikchatnaitak tsanumak","poem":1},{"lineBreak":true},{"text":"Apajuí daajin adayas","poem":1},{"lineBreak":true},{"text":"dekas umiktatjai tuu wekaechau,","poem":1},{"lineBreak":true},{"text":"nuwig wayawagtinai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunú aentsnak","poem":1},{"lineBreak":true},{"text":"niina apuji Apajuíya nunú uwemtijatnai.","poem":1},{"lineBreak":true},{"text":"Tuja niinak Tuke Pujuu","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigkig,","poem":1},{"lineBreak":true},{"text":"ayamjuk shiig pujutan susatnai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu, Jacopa Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"aents amina egapaidauk,","poem":1},{"lineBreak":true},{"text":"dutika yayaam agtinai.","poem":1},{"lineBreak":true},{"text":"Tuja amina segapaina nuna uchiji aidaushkam","poem":1},{"lineBreak":true},{"text":"dutiksaik yayaam agtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Jerusalégka waitijiya nunú ujaitajum!","poem":1},{"lineBreak":true},{"text":"¡Yaunchuk waitai aajakua","poem":1},{"lineBreak":true},{"text":"nunú ujai idaisatajum!","poem":1},{"lineBreak":true},{"text":"¡Apu pegkejam niina imanjin nayaimpinum,","poem":1},{"lineBreak":true},{"text":"nugkanmash inamna nunú wayattawai!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apu pegkejam niina imanjin nayaimpinum,","poem":1},{"lineBreak":true},{"text":"nugkanmash inamna dusha ¿yaita?","poem":1},{"lineBreak":true},{"text":"Duka dekas iina apuji","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina shiwaajinash ishamchau,","poem":1},{"lineBreak":true},{"text":"wajiuwa nunuwai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Jerusalégka waitijiya nunú ujaitajum!","poem":1},{"lineBreak":true},{"text":"¡Yaunchuk waitai aajakua","poem":1},{"lineBreak":true},{"text":"duka ujai idaisatajum!","poem":1},{"lineBreak":true},{"text":"¡Apu pegkejam niina imanjin nayaimpinum,","poem":1},{"lineBreak":true},{"text":"nugkanmash inamna nunú wayattawai!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¿Yaita nayaimpinum,","poem":1},{"lineBreak":true},{"text":"nugkanum inamna dusha?","poem":1},{"lineBreak":true},{"text":"¡Duka Israel aents aidaun Apujiyai!","poem":1},{"lineBreak":true},{"text":"¡Duka Tuke Pujuu ashí senchigtina nunuwai!","poem":1},{"lineBreak":true},{"text":"¡Niiyai dekas apu pegkejam,","poem":1},{"lineBreak":true},{"text":"niina imanjin nayaimpin, nugkan apujiya nunú!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}