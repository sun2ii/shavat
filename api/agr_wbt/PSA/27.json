:1},{"lineBreak":true},{"text":"kajinmamsam anentaimsata!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":14}