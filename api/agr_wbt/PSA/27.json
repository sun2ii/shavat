m":1},{"lineBreak":true},{"text":"wika puyattsuk pujuttajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ima makichkia nunak","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun segabiajai,","poem":1},{"lineBreak":true},{"text":"tuja wika ima makichkia nunak wakegajai:","poem":1},{"lineBreak":true},{"text":"Wika iwaku pujag duikik","poem":1},{"lineBreak":true},{"text":"kashi kashinig Tuke Pujuun emematkun","poem":1},{"lineBreak":true},{"text":"niina jee pegkegma nuwi","poem":1},{"lineBreak":true},{"text":"pujustatajai, niina pegkegmajiya","poem":1},{"lineBreak":true},{"text":"nuna wainkatasan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsawan utugchat ajuttaish,","poem":1},{"lineBreak":true},{"text":"Apajuí niina jee pegkegma nuwi uugkattawai,","poem":1},{"lineBreak":true},{"text":"Tuja kaya muunnum waka","poem":1},{"lineBreak":true},{"text":"uwemaina numamtuk uwemtijugtatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui mina shiwag aidau","poem":1},{"lineBreak":true},{"text":"tententuinakuish, ishamkashtatjai","poem":1},{"lineBreak":true},{"text":"Apajuí depetmikaju asamtai.","poem":1},{"lineBreak":true},{"text":"Nuadui kuntinu maan","poem":1},{"lineBreak":true},{"text":"Apajuí jee pegkegma nuwi","poem":1},{"lineBreak":true},{"text":"apeakun niina ememattatjai;","poem":1},{"lineBreak":true},{"text":"shiig aneasan senchi kantamkun","poem":1},{"lineBreak":true},{"text":"Tuke Pujuun ememattatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amina segajame, antugtukta!","poem":1},{"lineBreak":true},{"text":"¡Minash wait anenjujam, aigkata!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mina anentaig chichagtak:","poem":1},{"lineBreak":true},{"text":"“Apajuí egakta”, tujutui.","poem":1},{"lineBreak":true},{"text":"Nuadui amina wainkatasan