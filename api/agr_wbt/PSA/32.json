 kagama","poem":1},{"lineBreak":true},{"text":"numamtuk dekapmamkun,","poem":1},{"lineBreak":true},{"text":"kakaumainchau dekapmaijai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nuniakun mina pegkegchaugnak,","poem":1},{"lineBreak":true},{"text":"makichkish uutsuk etsegtumaktajai","poem":1},{"lineBreak":true},{"text":"tusan amina ashí ujakmaijame,","poem":1},{"lineBreak":true},{"text":"nuadui ame mina tudaujuk","poem":1},{"lineBreak":true},{"text":"ashí tsagkugtugmayume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui amina umigtamin aidauk,","poem":1},{"lineBreak":true},{"text":"waituinakush amina segapainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui nujag dujajak","poem":1},{"lineBreak":true},{"text":"nugka punag weakush,","poem":1},{"lineBreak":true},{"text":"ditanak amaigkashtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ametme mina ejamataigmek,","poem":1},{"lineBreak":true},{"text":"ishamainnumash ame kuitamjame;","poem":1},{"lineBreak":true},{"text":"nuadui ame agkanmitkajuamun anentaimtusan","poem":1},{"lineBreak":true},{"text":"shiig aneakun, kantamjagme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Wi aminak diyakjame,","poem":1},{"lineBreak":true},{"text":"nuadui amina unuinagtasan jintintuattagme,","poem":1},{"lineBreak":true},{"text":"tuja wiki jintan inaktusan kuitamkattagme.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuadui caballo, burrojai anentaimchau","poem":1},{"lineBreak":true},{"text":"asamtai, jagken jijui jinka emetua","poem":1},{"lineBreak":true},{"text":"mai japia, mai japia,","poem":1},{"lineBreak":true},{"text":"awajam wegama numamtinuk, amek aipa”,","poem":1},{"lineBreak":true},{"text":"tujamui Apajuí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aents pegkegchaun takau aina duka","poem":1},{"lineBreak":true},{"text":"kuashat waituinawai.","poem":1},{"lineBreak":true},{"text":"Untsu ima Tuke Pujuuwaig","poem":1},{"lineBreak":true},{"text":"kajinas anentaimaina nunak,","poem":1},{"lineBreak":true},{"text":"niina anenke múunta duwi","poem":1},{"lineBreak":true},{"text":"tuke ijik kuitamui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aents pegkeg,","poem":1},{"lineBreak":true},{"text":"tuja takatjish pegkeg aidautigmek,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwai shiig dakujustajum,","poem":1},{"lineBreak":true},{"text":"¡Nuniakjum nii emematkujum shiig aneasjum senchi kantamjuatajum!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":11}