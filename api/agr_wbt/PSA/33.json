{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":33,"content":[{"type":"heading","content":["Shiig aneasa Apajuí emematku kantamjamu"]},{"type":"verse","number":1,"content":[{"text":"Aents pegkeg aidauwah, shiig aneasjum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu emematkujum kantamatajum.","poem":1},{"lineBreak":true},{"text":"Aents pegkeg aidau kantabauk yajautsui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arpa awatku kantamtai kantamkujum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu see titajum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Kantamtai pegkeg aina nunú","poem":1},{"lineBreak":true},{"text":"kantamkujum nii ememattajum!","poem":1},{"lineBreak":true},{"text":"Tuja yamajam kantamtai","poem":1},{"lineBreak":true},{"text":"kantamkujum nii eme anentsajum","poem":1},{"lineBreak":true},{"text":"shiig aneakjum untsumtajum.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke Pujuun chichamega duka","poem":1},{"lineBreak":true},{"text":"waitchauwai, shiig dekaske,","poem":1},{"lineBreak":true},{"text":"nuadui nii tibauwa duka ashí betek uminui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk pegkeg takata nuna","poem":1},{"lineBreak":true},{"text":"dekaskea nujai aneawai.","poem":1},{"lineBreak":true},{"text":"¡Nuadui niina anenkega duka","poem":1},{"lineBreak":true},{"text":"ashí nugkan jamag awai!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk ima niina chichamenig","poem":1},{"lineBreak":true},{"text":"nayaim aidaun, nantu, etsa, yaya aidaun","poem":1},{"lineBreak":true},{"text":"aatus ashí najankauwai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apajuíyai kucha múun aidaunmayan","poem":1},{"lineBreak":true},{"text":"yumi yajuak makichkinmak ijumjauwa duka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Aents ashí nugkanmaya aidautijum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu eme anentsajum umigkatajum!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wagki nii niina chichamenig","poem":1},{"lineBreak":true},{"text":"ashí najankauwai.","poem":1},{"lineBreak":true},{"text":"Tuja nii nunikti timauwa duka imanisag","poem":1},{"lineBreak":true},{"text":"makichkish wajukachmin wajas asauwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tuke Pujuuk aents pegkegchau","poem":1},{"lineBreak":true},{"text":"tikich nugkanmaya aidau","poem":1},{"lineBreak":true},{"text":"pegkegchaun dutikatag tusa","poem":1},{"lineBreak":true},{"text":"anentaimtugbaujin betek umikti","poem":1},{"lineBreak":true},{"text":"tusag ayatkek idaitsui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Untsu Tuke Pujuu nuna dutikatjai tibauwa duka","poem":1},{"lineBreak":true},{"text":"makichkish yapajinchauwai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aents aidau Tuke Pujuuwai dekas iina","poem":1},{"lineBreak":true},{"text":"Apajuíjig tuina duka","poem":1},{"lineBreak":true},{"text":"shiig aneasag pujusagtinai,","poem":1},{"lineBreak":true},{"text":"wagki midau ati tusa etegkamu asag.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk nayaimpinum pujusag","poem":1},{"lineBreak":true},{"text":"ashí aents aidaunak diyakui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nii puja nuwi pujusag","poem":1},{"lineBreak":true},{"text":"aents nugkanmaya aidaush","poem":1},{"lineBreak":true},{"text":"wajukenawa nunak ashí wainui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apajuíyai iina anentain najadauk,","poem":1},{"lineBreak":true},{"text":"nuadui ashí ii takamunak diigtamkawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Makichik apua duka","poem":1},{"lineBreak":true},{"text":"niina suntaji aina nujaig","poem":1},{"lineBreak":true},{"text":"ayamjumakag uwemaitsui,","poem":1},{"lineBreak":true},{"text":"tuja aents aidaushkam","poem":1},{"lineBreak":true},{"text":"niina senchijinigkik ayamjumamaitsui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja caballo aina duka","poem":1},{"lineBreak":true},{"text":"senchigtin ainayatkush,","poem":1},{"lineBreak":true},{"text":"aentsu ayamjukag uwemtikmaitsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Untsu Tuke Pujuun eme anentus,","poem":1},{"lineBreak":true},{"text":"ima niyaig kajinmamas anentaimaina","poem":1},{"lineBreak":true},{"text":"nunak nii tuké kuitamui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tuja nujan tepeamtaish,","poem":1},{"lineBreak":true},{"text":"nujantai jakati tusag idaitsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ii aidautik Tuke Pujuuwai kajinmamsa anentaimji,","poem":1},{"lineBreak":true},{"text":"nuniajin ¡nii kuitamjamak yaimpaji!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Iina anentain Apajuí anentaimtusa shiig aneaji.","poem":1},{"lineBreak":true},{"text":"Nuniaku niina daaji pegkegma nuwi","poem":1},{"lineBreak":true},{"text":"kajinmamsa anentaimji.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"aminí anentaimsa pujau asajin,","poem":1},{"lineBreak":true},{"text":"amina anenkagmia nunú uyunkagtusti!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}