eBreak":true},{"text":"Tuke Pujuu umigtan wi jintituatjime.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Kuashat tsawan pujustasamesh wakegamek?","poem":1},{"lineBreak":true},{"text":"Iwaku pujusam shiig takakum","poem":1},{"lineBreak":true},{"text":"dakujustasamesh ¿wakegamek?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuniakmek,","poem":1},{"lineBreak":true},{"text":"pegkegchau chichamak chichatsuk pujusta,","poem":1},{"lineBreak":true},{"text":"tuja wait aina duka makichkish chichakaipa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pegkegchau takat aina duka idaisata,","poem":1},{"lineBreak":true},{"text":"nunikam pegkeja duke takasta;","poem":1},{"lineBreak":true},{"text":"nuniakum kakanmamsata maak agkan pujutnum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tuke Pujuuk aents niina shiig umijin aina nuna kuitamui,","poem":1},{"lineBreak":true},{"text":"dutikak nii sumamunash antujuk yayawai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Untsu tudaun takau aidaunak","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu kajejawai,","poem":1},{"lineBreak":true},{"text":"dutikak ijina atakesh adeagchatnun","poem":1},{"lineBreak":true},{"text":"emegkagtatui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk niina umijin aidau","poem":1},{"lineBreak":true},{"text":"sumamun betek antujui;","poem":1},{"lineBreak":true},{"text":"dutikak nii waitiamujinash agkanmitkawai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aents wika uwemjashtinapitja tusa","poem":1},{"lineBreak":true},{"text":"anentaimak waitiaun uwemtijatatus","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuk tikijuch pujawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tuke Pujuun umigna duka","poem":1},{"lineBreak":true},{"text":"kuashat utugchatan igkuawai,","poem":1},{"lineBreak":true},{"text":"tujash niinak Apajuí depetmatnak suwawai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuja niina ukunchi aidaunashkam","poem":1},{"lineBreak":true},{"text":"nii kuitamjawai;","poem":1},{"lineBreak":true},{"text":"nuadui makichik ukunchinakesh kupigkachagtinai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"ditá tudau takamsamujin waituinawai,","poem":1},{"lineBreak":true},{"text":"tuja Apajuí umijin aidaun kajejuina dushakam","poem":1},{"lineBreak":true},{"text":"suwimkan jukiagtinai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tujash Tuke Pujuuk niina inake aidaun uwemtikawai.","poem":1},{"lineBreak":true},{"text":"Nuadui ¡Tuke Pujuuwai kajinmamas anentaimaidauk","poem":1},{"lineBreak":true},{"text":"suwimak suwamak achagtinai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}