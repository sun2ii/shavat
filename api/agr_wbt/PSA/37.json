oem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuke Pujuu shiig anentsam aneeta,","poem":1},{"lineBreak":true},{"text":"nii umiktatui ame senchi wakegamunak.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amina pujutjumek Tuke Pujuu idaitusta,","poem":1},{"lineBreak":true},{"text":"dutikakum niyai kajinmamsam pujusta,","poem":1},{"lineBreak":true},{"text":"nuniamin nii yaimpaktatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ame shiig pujamugmea nunú,","poem":1},{"lineBreak":true},{"text":"tuja amina takatjum pegkeja dushakam","poem":1},{"lineBreak":true},{"text":"etsa tajimak shiig etsantama iman atinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tuke Pujuu emtin wainka chichá wekaetsuk","poem":1},{"lineBreak":true},{"text":"takamtak pujusta;","poem":1},{"lineBreak":true},{"text":"nuniakum dakasta nii yaimpakti.","poem":1},{"lineBreak":true},{"text":"Tuja aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"shiig atsumkas pujuinakui,","poem":1},{"lineBreak":true},{"text":"nunú diisam kajegkagtukaipa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuja kajeta duka idaisata,","poem":1},{"lineBreak":true},{"text":"kajeka jiyanita dushakam ukukta,","poem":1},{"lineBreak":true},{"text":"kajekaipa, wagki kajeamua duka utugchatan itawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aina duka ijina utsaam agtinai.","poem":1},{"lineBreak":true},{"text":"Untsu aents aidau Apajuín umijuinak","poem":1},{"lineBreak":true},{"text":"niinig anentaimas kajinas batsata nunú","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu nugkan anagkagtuawa nuna jukiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aents pegkegchaun takau aidauk,","poem":1},{"lineBreak":true},{"text":"dukap atsuk megkaejattawai;","poem":1},{"lineBreak":true},{"text":"nunikagmatai wainkatasa egaakmesh","poem":1},{"lineBreak":true},{"text":"makichkish wainkashtinaitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Untsu aents ememachu aina nunú nugka pegkegnum wayawag,","poem":1},{"lineBreak":true},{"text":"tutit chicham atsamunum shiig pujusagtinai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Untsu aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"aents pegkejan kajejak","poem":1},{"lineBreak":true},{"text":"pegkegchau awajkatatus egatui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tujash Apajuík nunú aents aidaunak dushikiawai,","poem":1},{"lineBreak":true},{"text":"wagki dita megkaejatnuk tsawan jegau asamtai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"ujudauch aidaun, ememachu aidaun,","poem":1},{"lineBreak":true},{"text":"pujutji pegkeg aidaun aatus maawagtatus","poem":1},{"lineBreak":true},{"text":"puyagjin akentaijijai uminawai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tujash ditak, dita puyagjinig maam agtatui,","poem":1},{"lineBreak":true},{"text":"untsu akentaiji aina duka","poem":1},{"lineBreak":true},{"text":"kupija utsantam agtatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aents pegkegma duka","poem":1},{"lineBreak":true},{"text":"wajiji kuashat achataish,","poem":1},{"lineBreak":true},{"text":"aents wiakuch pegkegchaun","poem":1},{"lineBreak":true},{"text":"nagkaesau shiig pujawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuk","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidaun ijinak,","poem":1},{"lineBreak":true},{"text":"aents pegkeg aidaun kuitamkattawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Apajuík aents tudaugtuchu aidaun kuitamui,","poem":1},{"lineBreak":true},{"text":"tuja ditak ajumaish tuke atina nuna jukiagtinai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsawan waitiamu jegataish,","poem":1},{"lineBreak":true},{"text":"ditak waittsachagtinai,","poem":1},{"lineBreak":true},{"text":"tuja nujan tepeamtaish,","poem":1},{"lineBreak":true},{"text":"dita yuwatnuk kuashat ajiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aents pegkegchau aina duka","poem":1},{"lineBreak":true},{"text":"dupa kagakujai betek keekagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuín shiwaaji aidaushkam","poem":1},{"lineBreak":true},{"text":"jii bukuiti megkagama numamtuk","poem":1},{"lineBreak":true},{"text":"megkaejatin ainawai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"tsagkatjukta takui tsagkatkamash akikmachui;","poem":1},{"lineBreak":true},{"text":"untsu aents pegkeja duka","poem":1},{"lineBreak":true},{"text":"tsagkatkamak nuni ewagas akikmawai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apajuí pegkegnum yumigsamu aina nunú","poem":1},{"lineBreak":true},{"text":"nugka pegkegnum pujusagtinai;","poem":1},{"lineBreak":true},{"text":"untsu nii pegkegchaunum","poem":1},{"lineBreak":true},{"text":"yumigjamu aina duka, ijina utsam agtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tuke Pujuuk aentsu pujutjin diijus","poem":1},{"lineBreak":true},{"text":"nii wakegamujai betek pegkeg ataik,","poem":1},{"lineBreak":true},{"text":"shiig pujusti tusa yayawai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tuja nunú aentsuk","poem":1},{"lineBreak":true},{"text":"pegkegchaunum iyakush,","poem":1},{"lineBreak":true},{"text":"nunisagkek megkaekashtinai,","poem":1},{"lineBreak":true},{"text":"wagki nigka Tuke Pujuu achiakbau asa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Wi datsa asan pujuyag duwikish,","poem":1},{"lineBreak":true},{"text":"tuja yamai múuntuch wajasan pujag duwish,","poem":1},{"lineBreak":true},{"text":"makichkish waintsujai aents pegkeg aidau","poem":1},{"lineBreak":true},{"text":"Apajuí kajimatki idaisamu asag waituidaunak,","poem":1},{"lineBreak":true},{"text":"tuja dita uchiji aidaukesh","poem":1},{"lineBreak":true},{"text":"yumain atsujam waituinak","poem":1},{"lineBreak":true},{"text":"sumá yujaunak makichkish waintsujai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aents pegkeg aina duka","poem":1},{"lineBreak":true},{"text":"ashí tsawantai wait anenkagtinai,","poem":1},{"lineBreak":true},{"text":"nuniau asa tsagkatkagtinai;","poem":1},{"lineBreak":true},{"text":"tuja niina uchiji aidaushkam","poem":1},{"lineBreak":true},{"text":"pegkegnum chichajam agtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pegkegchau takata duka tupanjata,","poem":1},{"lineBreak":true},{"text":"nunikam pegkeja duke takasta,","poem":1},{"lineBreak":true},{"text":"nuniakum ame pujustinun Apajuí anagtabauwa","poem":1},{"lineBreak":true},{"text":"nuwi tuke pujustinaitme.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuk","poem":1},{"lineBreak":true},{"text":"shiig takamua nuna wakegawai;","poem":1},{"lineBreak":true},{"text":"nuadui niina umijuidaunak kajimatkig idaitsui;","poem":1},{"lineBreak":true},{"text":"untsu pegkegchau aidaunak","poem":1},{"lineBreak":true},{"text":"dita uchiji aidaujai ashí ijinui.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nugkan Apajuí anagkagtuawa nuwig","poem":1},{"lineBreak":true},{"text":"aents niina umijin aidau tuke pujusagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Aents pegkejak shiig anentaimas chichawai;","poem":1},{"lineBreak":true},{"text":"nuniak tuke pegkeja nunak chichawai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nuniau asa niina anentainishkam","poem":1},{"lineBreak":true},{"text":"Apajuí jintintuamua nunak tuke aneakui;","poem":1},{"lineBreak":true},{"text":"¡nuadui niig makichkish pegkegchaunmak","poem":1},{"lineBreak":true},{"text":"iyaumaitsui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Aents pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"aents pegkejan tsanumjug,","poem":1},{"lineBreak":true},{"text":"maatnume tusa sujuktatus wekaetawai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tujash Tuke Pujuuk aents pegkegchauwa nunú","poem":1},{"lineBreak":true},{"text":"maati tusag idaisashtatui;","poem":1},{"lineBreak":true},{"text":"tuja nuigtushkam tsanumjujagmatai,","poem":1},{"lineBreak":true},{"text":"achikag waitkastinme tusagkesh idaisashtatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Tuja amek Tuke Pujuuwai kajinmamsam pujusta,","poem":1},{"lineBreak":true},{"text":"nuniakum niina chichame umigkata;","poem":1},{"lineBreak":true},{"text":"wagki nii aminak tikich aidaun nagkaesau etamtatui,","poem":1},{"lineBreak":true},{"text":"dutijama nugkan anagtabauwa nuna amastinai.","poem":1},{"lineBreak":true},{"text":"¡Nuwi pujusam aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"jinuidau wainkatnaitme!","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Aents pegkegchauwa nunú","poem":1},{"lineBreak":true},{"text":"numi múun wajaama numamtuk","poem":1},{"lineBreak":true},{"text":"ememas wajaun wainkabiajai.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tujash wajukayawas, megkaekabi,","poem":1},{"lineBreak":true},{"text":"wainkatasan egaknush wainkachmaijai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Aents shiig anentaimkauwa nunú diista,","poem":1},{"lineBreak":true},{"text":"nunú aentsuk tutit chicham atsaunum agkan pujustinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Untsu aents antumtikmainchau","poem":1},{"lineBreak":true},{"text":"intimkiu aina duka","poem":1},{"lineBreak":true},{"text":"ashí ijina utsaam agtinai;","poem":1},{"lineBreak":true},{"text":"nuadui ditak jinatnujin dakainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Tuke Pujuuk aents pegkeg aidaun","poem":1},{"lineBreak":true},{"text":"yaigka uwemtiknai,","poem":1},{"lineBreak":true},{"text":"tuja tsawan waitiamu jegataish,","poem":1},{"lineBreak":true},{"text":"nii ejaka kuitamui.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Tuja ditanak Tuke Pujuu ayamjuk agkanmitkawai,","poem":1},{"lineBreak":true},{"text":"wagki niyai kajinmamas","poem":1},{"lineBreak":true},{"text":"anentaimaidau asagmatai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":40}