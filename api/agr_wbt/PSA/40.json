{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":40,"content":[{"type":"heading","content":["Apajuíjuh, ame wakegamun umiktasan wakegajai"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Wika Tuke Pujuu yainkati tusan","poem":1},{"lineBreak":true},{"text":"niiyai kajitmamsa pujusan segabiajai;","poem":1},{"lineBreak":true},{"text":"tusa segai nii antugtukmayi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuja wi jamainnum jeganta pujaish,","poem":1},{"lineBreak":true},{"text":"nii uwemtijugmayi.","poem":1},{"lineBreak":true},{"text":"Tuja kuchanum tepea","poem":1},{"lineBreak":true},{"text":"jamaina numamtuk ashí jaka pujai,","poem":1},{"lineBreak":true},{"text":"Apajuí uwemtijugmayi.","poem":1},{"lineBreak":true},{"text":"Dutijua kaya múun","poem":1},{"lineBreak":true},{"text":"makichkish buchitmainchaunum wajasa iyaumaitsu iman etibi.","poem":1},{"lineBreak":true},{"text":"Nuadui wi wekaesatnunak nii umigtuke.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dutijak yamajam kantamtain","poem":1},{"lineBreak":true},{"text":"Apajuí kantamjutain kantamati tusa jintinjuabi;","poem":1},{"lineBreak":true},{"text":"nuna wi kantabau kuashat aents aidau","poem":1},{"lineBreak":true},{"text":"anentain antinkabi,","poem":1},{"lineBreak":true},{"text":"dutikam Tuke Pujuuwaig kajinas anentaibiagmayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Aents ememachu","poem":1},{"lineBreak":true},{"text":"tuja wainka apajuímtai aidaunash emematchau,","poem":1},{"lineBreak":true},{"text":"ima Tuke Pujuuwaig kajinmamas anentaimaina duka","poem":1},{"lineBreak":true},{"text":"shiig aneas pujustinai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu mina Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"amek jutii wait anenkagtakum,","poem":1},{"lineBreak":true},{"text":"kuashat ishamain wainchatai aidau iwainajuitme.","poem":1},{"lineBreak":true},{"text":"¡Makichkish amejai betekak atsawai!","poem":1},{"lineBreak":true},{"text":"Nuna pachisan etsegkatag takunush,","poem":1},{"lineBreak":true},{"text":"ashí etsegmainchau dekapeajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apajuí tsagkugtugti tusag","poem":1},{"lineBreak":true},{"text":"kuntinu maawag nuna nejen ashí apeatnume,","poem":1},{"lineBreak":true},{"text":"dutikainak ajak aidaunashkam anentag sujustinme tusamek sumatsme.","poem":1},{"lineBreak":true},{"text":"Untsu Apajuín chichamen antukti tujutiume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuadui, papiinum agagbau","poem":1},{"lineBreak":true},{"text":"mina pachitus tawa nujai betek,","poem":1},{"lineBreak":true},{"text":"chichaakun: Juwi pujajai, timajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuíjuh, ame wakegamu takata nunú minak shiig awajtawai.","poem":1},{"lineBreak":true},{"text":"¡Ame jintinjuamua nunú mina anentaijui ajutui!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amina aentsjum aidau","poem":1},{"lineBreak":true},{"text":"kuashat tuwaka ijunbaunum","poem":1},{"lineBreak":true},{"text":"amina takatjum pegkegma nuna iwainakmajai.","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuuwah, wi aminun pachisa etsegtsuk","poem":1},{"lineBreak":true},{"text":"uuka pujatsug duka amek shiig dekame!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuja aents aidau wait anentakum,","poem":1},{"lineBreak":true},{"text":"dita tudaujish tsagkugnaitam nunú pachisa","poem":1},{"lineBreak":true},{"text":"etsegtanmak itattsachmajai.","poem":1},{"lineBreak":true},{"text":"Tuja ame anagkagtuamuk betek uminaitam nuna","poem":1},{"lineBreak":true},{"text":"ame uwemtikagtamujai pachisan chichagkagtukmajai.","poem":1},{"lineBreak":true},{"text":"Nuigtush amina aentsjum kuashat aina","poem":1},{"lineBreak":true},{"text":"nuna emtinig amina anenkagminak","poem":1},{"lineBreak":true},{"text":"dekaskegmijaig, makichkish uukchamjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nuadui Tuke Pujuuwah, amesh minash wait aneasam","poem":1},{"lineBreak":true},{"text":"amina anenkagmea duka atushat etugtipa.","poem":1},{"lineBreak":true},{"text":"¡Amina anenkagmin","poem":1},{"lineBreak":true},{"text":"pegkegmagmea nujai yainkata!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Untsu ame kuitamjachkuminig wika jamainaitjai,","poem":1},{"lineBreak":true},{"text":"wagki wi waitiamua duka","poem":1},{"lineBreak":true},{"text":"dekapakuish makichkish ejemaitsui.","poem":1},{"lineBreak":true},{"text":"Mina tudaujuk mina intashjun nagkaesau","poem":1},{"lineBreak":true},{"text":"shiig kuashat ajutui.","poem":1},{"lineBreak":true},{"text":"Iman asamtai, datsaamakun shiig niimsachmin,","poem":1},{"lineBreak":true},{"text":"nuigtush shiig pujuschamin jakamin dekapeajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tuke Pujuuwah, ¡wait aneasam,","poem":1},{"lineBreak":true},{"text":"minash agkanmitkajuata,","poem":1},{"lineBreak":true},{"text":"dutijakum wamak yainkata!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aents aidau mina mantuawagtatus","poem":1},{"lineBreak":true},{"text":"wakejutuina duka ame inatsakta;","poem":1},{"lineBreak":true},{"text":"dutikamu asag,","poem":1},{"lineBreak":true},{"text":"mina pegkegchau awajtuktatus","poem":1},{"lineBreak":true},{"text":"anentaimaina duka","poem":1},{"lineBreak":true},{"text":"datsantin pisagtinme.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja mina dushijuina duka","poem":1},{"lineBreak":true},{"text":"datsagkag pisagtinme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Untsu amina egapaina duka shiig aneastinme;","poem":1},{"lineBreak":true},{"text":"tuja ame uwemtikagtinaitamnuna wakejuina duka:","poem":1},{"lineBreak":true},{"text":"“¡Apajuíyai dekas múunta duka!” tusag","poem":1},{"lineBreak":true},{"text":"tuke emematjamtin atinme.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tuja wi shiig senchi waitiakun","poem":1},{"lineBreak":true},{"text":"wake besemag pujag nunú,","poem":1},{"lineBreak":true},{"text":"minash wait aneasam Tuke Pujuuwah, kajimatjukipa.","poem":1},{"lineBreak":true},{"text":"Ametme mina yainkam uwemtijinmek;","poem":1},{"lineBreak":true},{"text":"nuadui Apajuíjuh, minash wamak yainkata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":17}