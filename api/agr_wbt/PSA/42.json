{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":42,"content":[{"type":"heading","content":["Wi jinta niimjamua duka Apajuíyai"]},{"type":"hebrew_subtitle","content":["Coré uchiji aidau kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"Japa senchi kitamak uwagtatus yumin egama numamtuk","poem":1},{"lineBreak":true},{"text":"wika Apajuíjuh, amina egajame.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apajuí pujuta sukagtina nuna wainkatasan,","poem":1},{"lineBreak":true},{"text":"aents kitakai waitiak yumin egamaina","poem":1},{"lineBreak":true},{"text":"numamtuk egajai.","poem":1},{"lineBreak":true},{"text":"¿Wajutik wisha ataktush","poem":1},{"lineBreak":true},{"text":"Apajuí jee pegkegma nuwish wayatja? tusan","poem":1},{"lineBreak":true},{"text":"anentaima pujajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuadui tsawaish,","poem":1},{"lineBreak":true},{"text":"tuja kashish buutú pujajai,","poem":1},{"lineBreak":true},{"text":"nuniai aents aidau inintuinak:","poem":1},{"lineBreak":true},{"text":"“¿Amina Apajuígmesha?” tujutuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nuwi anentaimkunuk","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeajai.","poem":1},{"lineBreak":true},{"text":"Wi yaunchuk aents aidaun yajuakan","poem":1},{"lineBreak":true},{"text":"Apajuí jee pegkegma nuwi emai,","poem":1},{"lineBreak":true},{"text":"shiig aneasag Apajuín emematuinak","poem":1},{"lineBreak":true},{"text":"untsumki shimuyanum nuna anentaimjai.","poem":1},{"lineBreak":true},{"text":"¡Yajauwajah ijunja Apajuí emematbau!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iman aish ¿wagkanuk wisha mijaktaja?","poem":1},{"lineBreak":true},{"text":"Wi puyatjumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Apajuí uwemtikagtina nuwig","poem":1},{"lineBreak":true},{"text":"kajintsan anentaimtatjai,","poem":1},{"lineBreak":true},{"text":"nuniakun ima niinak ememattatjai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Shiig aneasa pujuschamin","poem":1},{"lineBreak":true},{"text":"wake besemag dekapeajai,","poem":1},{"lineBreak":true},{"text":"nuniakun muja Hermón","poem":1},{"lineBreak":true},{"text":"tuja muja Misar tutainum","poem":1},{"lineBreak":true},{"text":"namak Jordágka nujinchi jinagbaunum","poem":1},{"lineBreak":true},{"text":"pujusan aminí senchi anentaimjai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuja ame najankamu aidau","poem":1},{"lineBreak":true},{"text":"mujanum wajasa antam,","poem":1},{"lineBreak":true},{"text":"namaka nujinchi chichijam","poem":1},{"lineBreak":true},{"text":"tuna detau aidau senchi uutak,","poem":1},{"lineBreak":true},{"text":"ishamain wajama imanik","poem":1},{"lineBreak":true},{"text":"wi waitiamua duka minitjawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tujash kashi kashinig","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu niina anenkega duwi minak yaintui;","poem":1},{"lineBreak":true},{"text":"nuadui wishakam","poem":1},{"lineBreak":true},{"text":"Apajuí mina pujutan suja nuna emematkun","poem":1},{"lineBreak":true},{"text":"kashi kantamtanak mijattsujai,","poem":1},{"lineBreak":true},{"text":"nuniakun segatnashkam segatskek idaitsujai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apajuí mina ayamjutna nuna chichagkun:","poem":1},{"lineBreak":true},{"text":"“¿Wagka minash kajimatjukiume?","poem":1},{"lineBreak":true},{"text":"¿Wagkanuk wisha mina shiwag aintuinakuish,","poem":1},{"lineBreak":true},{"text":"wake besemjash wekaetaja?” tajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mina shiwag aidau dushiktuinak:","poem":1},{"lineBreak":true},{"text":"“¿Amina Apajuígmesha?”","poem":1},{"lineBreak":true},{"text":"tusa aju ajumag inintuinawai.","poem":1},{"lineBreak":true},{"text":"Imatjutiagtai mina ukunchig najautuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tuja ¿wagkanuk wisha mijaktaja?","poem":1},{"lineBreak":true},{"text":"Wi puyatjumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Apajuí uwemtikagtina nuwig","poem":1},{"lineBreak":true},{"text":"kajintsan anentaimtatjai,","poem":1},{"lineBreak":true},{"text":"nuniakun ima niinak ememattatjai.","poem":1},{"lineBreak":true},{"text":"¡Niyai mina Apajuíg uwemtijinuk!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":11}