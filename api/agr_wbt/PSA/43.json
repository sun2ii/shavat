{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Apajuíyah, wi pegkegchau takamsamu","poem":1},{"lineBreak":true},{"text":"atsugta duka ame dekame,","poem":1},{"lineBreak":true},{"text":"nuniau asam ¡aents pegkegchau aina nunú","poem":1},{"lineBreak":true},{"text":"maawai tusam ayamjutkata!","poem":1},{"lineBreak":true},{"text":"¡Aents pegkegchau waitjin aidaunum agkanmitkajuata,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wagki ametme mina Apajuíg kuitamjinmek!","poem":1},{"lineBreak":true},{"text":"¿Wagka minash idaitusume?","poem":1},{"lineBreak":true},{"text":"¿Wagkanuk wisha mina shiwag aintuinakuish","poem":1},{"lineBreak":true},{"text":"wake besemjash wekaetaja? tajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amina tsaaptinjum","poem":1},{"lineBreak":true},{"text":"dekaskegmijai sujusta, nunú jintinjuati.","poem":1},{"lineBreak":true},{"text":"Muja ame etegkamunum pujam nuwi","poem":1},{"lineBreak":true},{"text":"wakatag tusaish wajuk wemainaita nuna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuwi wakan amina altarjumin jegantan,","poem":1},{"lineBreak":true},{"text":"arpa awatkun amina ememattajame;","poem":1},{"lineBreak":true},{"text":"wagki shiig aneasa pujuta nunú ame sujau asamin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuja ¿wagkanuk wisha mijaktaja?","poem":1},{"lineBreak":true},{"text":"Wi puyatjumainuk atsawai.","poem":1},{"lineBreak":true},{"text":"Apajuí uwemtikagtina nuwig kajintsan anentaimtatjai,","poem":1},{"lineBreak":true},{"text":"nuniakun ima niinak ememattatjai.","poem":1},{"lineBreak":true},{"text":"¡Niyai mina Apajuíg uwemtijinuk!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}