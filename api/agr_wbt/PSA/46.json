{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":46,"content":[{"type":"heading","content":["Apajuík jutijai pujawai"]},{"type":"hebrew_subtitle","content":["Coré uchiji aidau agajagbauJuka jaka ukumamunum kantamajakbauwai"]},{"type":"verse","number":1,"content":[{"text":"Apajuíyai iina kuitamjamin,","poem":1},{"lineBreak":true},{"text":"iina senchimtijamin,","poem":1},{"lineBreak":true},{"text":"tuja utugchat ataish tuke yaijatin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuadui nugka buchittai,","poem":1},{"lineBreak":true},{"text":"muja aidau yumpunainak,","poem":1},{"lineBreak":true},{"text":"nayantsanum kakegu","poem":1},{"lineBreak":true},{"text":"wainkuish ishamaitsuji.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nayants senchi tsukatbau,","poem":1},{"lineBreak":true},{"text":"kedegtak muja aidaun senchi umuchiak","poem":1},{"lineBreak":true},{"text":"ishamain wajakuish ishamaitsuji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Namakak nii tsegkeakbaujijai","poem":1},{"lineBreak":true},{"text":"Apajuí yaaktajin aents batsatun shiig anemtikui,","poem":1},{"lineBreak":true},{"text":"nunú yaaktak dekas tikich yaakat aidaun nagkaesau","poem":1},{"lineBreak":true},{"text":"shiig pegkegmai, Apajuí pujutai asa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apajuík nunú yaakta ejapeen pujawai,","poem":1},{"lineBreak":true},{"text":"nuadui makichkish tsaimainchau ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí aentsji aidau,","poem":1},{"lineBreak":true},{"text":"nunú yaaktanum batsatunak kashikiuch nagkamas yayawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aents nugka muunnumia aidauk,","poem":1},{"lineBreak":true},{"text":"nugka múun aidaun apuji aidaujai","poem":1},{"lineBreak":true},{"text":"Apajuí chichamun antukag","poem":1},{"lineBreak":true},{"text":"ishamainak senchi pampainawai.","poem":1},{"lineBreak":true},{"text":"Tuja nugkashkam Apajuí chichatai,","poem":1},{"lineBreak":true},{"text":"yumpuna tsainak megkaewai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Tuke Pujuu ashí senchigtina duka jutijai pujawai!","poem":1},{"lineBreak":true},{"text":"¡Jacopan Apajuíjiya nunuwai iina kuitamjamin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuke Pujuu ishamain wainchatai aidaun","poem":1},{"lineBreak":true},{"text":"juju nugkanum iwainajua nunú","poem":1},{"lineBreak":true},{"text":"taajum diistajum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maanitak ashí nugkanum atsuti tusa tine.","poem":1},{"lineBreak":true},{"text":"Nuadui maaniaku flecha akentai aidaunak","poem":1},{"lineBreak":true},{"text":"nagki aidaujai kupigmayi,","poem":1},{"lineBreak":true},{"text":"dutikak carro maaniaku jutai aidaunashkam","poem":1},{"lineBreak":true},{"text":"apeka utsagmayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Anuig nagkankatajum!","poem":1},{"lineBreak":true},{"text":"¡Witjai Apajuínuk, nunú dekatajum!","poem":1},{"lineBreak":true},{"text":"Ashí nugkanmaya aidauk mina umigtukagtatui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¡Tuke Pujuu ashí senchigtina duka jutijai pujawai!","poem":1},{"lineBreak":true},{"text":"¡Jacopa Apajuíjiya nunuwai iina kuitamjamnuk!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":11}