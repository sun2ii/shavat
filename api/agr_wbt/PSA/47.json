{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":47,"content":[{"type":"heading","content":["Apajuíyai ashí nugka apujig"]},{"type":"hebrew_subtitle","content":["Coré uchiji aidau kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"Ashí aents aidautijum Apajuí uwejum awatitajum.","poem":1},{"lineBreak":true},{"text":"Tuja nii emematkujum","poem":1},{"lineBreak":true},{"text":"shiig aneasjum senchi kantamatajum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuwai ishamtai múun, ashí nugka apujiya duka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aents tikich nugkanmaya aidaun Apajuí depetuk,","poem":1},{"lineBreak":true},{"text":"atum inagtajum tusa iina idaitugmasui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apajuí Jacopan aneau asa,","poem":1},{"lineBreak":true},{"text":"nii wegantu aidautin etegtamjauwai,","poem":1},{"lineBreak":true},{"text":"dutijama nugka pegkejan","poem":1},{"lineBreak":true},{"text":"nii anagtabauwa nuna sujamsajui.","poem":1},{"lineBreak":true},{"text":"Nunú nugka duwi ii eme anenmamji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuke Pujuu Apajuík niina aentsji aidau","poem":1},{"lineBreak":true},{"text":"shiig aneasag senchi kantamainak,","poem":1},{"lineBreak":true},{"text":"nuigtu uwija kachujin umpuinak","poem":1},{"lineBreak":true},{"text":"pampainamunum niina pujusa inamtaijin","poem":1},{"lineBreak":true},{"text":"waya ekemsae.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Kantamtai Apajuí kantamjuatajum!","poem":1},{"lineBreak":true},{"text":"¡Kantamtai iina apuji kantamjuawagmi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apajuíyai ashí nugkanmaya aidaun apuji,","poem":1},{"lineBreak":true},{"text":"nuadui shiig aneasjum kantamjuatajum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apajuík nii pujusa inamtaiji","poem":1},{"lineBreak":true},{"text":"pegkegma nuwi pujusag,","poem":1},{"lineBreak":true},{"text":"ashí aents nugkanmaya aidaun inawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuja ashí tikich nugkanmaya","poem":1},{"lineBreak":true},{"text":"apu eme anentsa diitai aidauk,","poem":1},{"lineBreak":true},{"text":"Abrahama Apajuíjin ememattatus","poem":1},{"lineBreak":true},{"text":"nii wegantu aidaujai ijunainawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ashí aents nugkanmaya aina duka Apajuínu ainawai.","poem":1},{"lineBreak":true},{"text":"Nuadui nii ashí inawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}