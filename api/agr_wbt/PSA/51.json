{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":51,"content":[{"type":"heading","content":["Apawa wait aneasam mina tudaujush tsagkugtugta"]},{"type":"hebrew_subtitle","content":["David Betsabén nuwatkamtai",{"noteId":0},"profeta Natán jiyakam pujusa juna aatus agajui"]},{"type":"verse","number":1,"content":[{"text":"Apajuíyah, amina anenkagmin wait anenjugta;","poem":1},{"lineBreak":true},{"text":"tuja amina wait anenkagtutaigmin","poem":1},{"lineBreak":true},{"text":"mina tudaujush tsagkugtugta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Mina anentaijui pegkegchau ayá nunú nijatjugta!","poem":1},{"lineBreak":true},{"text":"Tuja mina tudaujush jaipja utsanjukta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mina pegkegchaugnak wika shiig dekagmamjai.","poem":1},{"lineBreak":true},{"text":"Tuja wi pegkegchau takamsamua duka","poem":1},{"lineBreak":true},{"text":"mina anentaijuig sakamtsui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ame dakitamun amina emtimin","poem":1},{"lineBreak":true},{"text":"pegkegchaun takamsan","poem":1},{"lineBreak":true},{"text":"ikajeakun waitkagme.","poem":1},{"lineBreak":true},{"text":"Nuadui minak dekaskenum","poem":1},{"lineBreak":true},{"text":"suwimkak sujustatme.","poem":1},{"lineBreak":true},{"text":"Wika pegkegmaitjai tusanuk tumaitsujai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wika dekas wi akiinawaitag","poem":1},{"lineBreak":true},{"text":"duwi nagkamsanuk tudauwaitjai;","poem":1},{"lineBreak":true},{"text":"tuja mina dukuju muntsujin muntsuaku asanuk tudau ayajai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amek dekas aents ememachu","poem":1},{"lineBreak":true},{"text":"dekaskenum chichauwa nunú aneame;","poem":1},{"lineBreak":true},{"text":"nuadui shiig anentaimja pujut sujusume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi pegkegchau takamsamu","poem":1},{"lineBreak":true},{"text":"mina anentaijui ajuta nunú hisopowai","poem":1},{"noteId":1},{"text":"jaipja ajapjutuata,","poem":1},{"lineBreak":true},{"text":"dutijuawamin pegkeg wajastajai;","poem":1},{"lineBreak":true},{"text":"ashí minak nijatjata, dutijuawamin","poem":1},{"lineBreak":true},{"text":"yujagkim pujuama nuna nagkaesau wajastajai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Suwimak sujakum waitkagsau akumesh,","poem":1},{"lineBreak":true},{"text":"yamaik minash shiig aneasa pujut sujusta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mina tudaug aina duka kajimatkita,","poem":1},{"lineBreak":true},{"text":"nuniakum mina pegkegchaug aina nunú","poem":1},{"lineBreak":true},{"text":"ashí esaktujata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Apajuíyah, mina anentaijush tudaugtuchu yamajam etugtita,","poem":1},{"lineBreak":true},{"text":"dutikakum pegkeg anentaimat","poem":1},{"lineBreak":true},{"text":"ima aminak umigtamain sujusta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tikima ajapjutak ajapjuawaipa,","poem":1},{"lineBreak":true},{"text":"tuja amina Wakanim Pegkegma dusha jujutkipa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuja ame uwemtikagtujamin shiig aneamu","poem":1},{"lineBreak":true},{"text":"ajutkagtuwama nunú ataktu sujusta,","poem":1},{"lineBreak":true},{"text":"nuniakum amina Wakanim wait anenkagtina nujai","poem":1},{"lineBreak":true},{"text":"kuitamjukta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dutijuawamin aents amina chichamjumin umitan","poem":1},{"lineBreak":true},{"text":"dakitin aina nuna jintintuatjai,","poem":1},{"lineBreak":true},{"text":"amina nemagtamkatnume tusan.","poem":1},{"lineBreak":true},{"text":"Dutika ai aents tudau aidaush dita tudaujin idaisag","poem":1},{"lineBreak":true},{"text":"ima aminak umigtamkatnume.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apajuíyah, ametme mina uwemtijinmek,","poem":1},{"lineBreak":true},{"text":"tuja wi pegkegchaun takamsauwaitag duwi","poem":1},{"lineBreak":true},{"text":"maatnume tusamek idaitusaipa.","poem":1},{"lineBreak":true},{"text":"Wisha ame wait anenkagtutaigmea nuna","poem":1},{"lineBreak":true},{"text":"pachisan etsegkun shiig aneasan","poem":1},{"lineBreak":true},{"text":"kantamtain senchi kantamjuatjame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Apuh, minash kantamati tujutta,","poem":1},{"lineBreak":true},{"text":"wisha kantamtain amina kantamjuatjame.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja uwija maan nuna nejen ashí apeakun,","poem":1},{"lineBreak":true},{"text":"nuigtu anentag aidaun amaakun","poem":1},{"lineBreak":true},{"text":"amina ememattag takunush","poem":1},{"lineBreak":true},{"text":"dutikmainchau dekapeajai,","poem":1},{"lineBreak":true},{"text":"wagki duka aminak shiig awajtamchau asamtai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apajuíyah, amek aents wika tudauwapitja tusa","poem":1},{"lineBreak":true},{"text":"anentaimak waitia nunú shiig anentame.","poem":1},{"lineBreak":true},{"text":"Tuja aents wika tudauwapitja tusa","poem":1},{"lineBreak":true},{"text":"awake anentaimag tsagkugtugta tusa","poem":1},{"lineBreak":true},{"text":"segapakuig, yaitskek idaichauwaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Apuh, wait aneasam","poem":1},{"lineBreak":true},{"text":"Isarael aents aina nunú","poem":1},{"lineBreak":true},{"text":"wait anenjam kuitamkata.","poem":1},{"lineBreak":true},{"text":"Dutikakum Jerusalén peejamu tsaikbauwa nuna","poem":1},{"lineBreak":true},{"text":"ataktu peejatnume tusam yaigta.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dutikawamin kuntinu maawag","poem":1},{"lineBreak":true},{"text":"nuna nejen ashí apeawagtata","poem":1},{"lineBreak":true},{"text":"nunú shiig awajtamkattawai.","poem":1},{"lineBreak":true},{"text":"Nuadui amina emematjamainak","poem":1},{"lineBreak":true},{"text":"toro tsakat aidaun maawag apeawagtinai.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Nunú pachisa ausata 2 Sam 12.1-12.","reference":{"chapter":51,"verse":0}},{"noteId":1,"caller":"+","text":"“Hisopo” tawa duka makichik ajak ajakui. Nuna duke juki jaipmaina numamtuk jaipjugti tusa David tiuwai.","reference":{"chapter":51,"verse":7}}]},"thisChapterLink":"/api/agr_wbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":19}