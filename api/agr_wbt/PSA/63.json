{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":63,"content":[{"type":"heading","content":["Apajuí anenkegpujutan nagkaesauwai"]},{"type":"hebrew_subtitle","content":["David Judá wegantu aidau nugken uwegshunum pujusa agagbau"]},{"type":"verse","number":1,"content":[{"text":"Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"ametme mina Apajuígmek,","poem":1},{"lineBreak":true},{"text":"Yama tsawamuik kashikmasan","poem":1},{"lineBreak":true},{"text":"wakejusan segajame,","poem":1},{"lineBreak":true},{"text":"wika amina wainkatasan wakegakun","poem":1},{"lineBreak":true},{"text":"kitamaku wajuktayama imaniajai.","poem":1},{"lineBreak":true},{"text":"Tuja yumi yutushtai nugka buku wajas,","poem":1},{"lineBreak":true},{"text":"yumin atsumak wajukchawash imaniawai,","poem":1},{"lineBreak":true},{"text":"mina iyashjuk amina atsumjamak.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amina jem pegkegma nuwi wayan,","poem":1},{"lineBreak":true},{"text":"amina imanjumea nuna","poem":1},{"lineBreak":true},{"text":"senchigmijai wainkatasan wakegajai,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"wagki amina anenkagmea duka","poem":1},{"lineBreak":true},{"text":"pujutan nagkaesauwai,","poem":1},{"lineBreak":true},{"text":"nuadui kantamkun ememattatjame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wika aminak tuke ememattinaitjame,","poem":1},{"lineBreak":true},{"text":"nuniakun mina uwejun takuin","poem":1},{"lineBreak":true},{"text":"amina aujtatjame.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aents yutai pegkejan yuwa","poem":1},{"lineBreak":true},{"text":"shiig aneas pujuuwa numamtuk wika shiig aneasan pujuttajai,","poem":1},{"lineBreak":true},{"text":"nuadui shiig aneasan","poem":1},{"lineBreak":true},{"text":"kantamkun ememattatjame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kashi kanaku tepesnush","poem":1},{"lineBreak":true},{"text":"aminí anentaimsanuk tepajai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ametme mina yaintumek;","poem":1},{"lineBreak":true},{"text":"nuadui aminí yunumsan","poem":1},{"lineBreak":true},{"text":"ame kuitamjusamin shiig aneasan pujujai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ashí mina pujutjua nunak","poem":1},{"lineBreak":true},{"text":"amina amaajai, wagki ame minak","poem":1},{"lineBreak":true},{"text":"amina senchigmin kuitamjame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mina mantuawagtatus","poem":1},{"lineBreak":true},{"text":"wakejutuina duka ijinata,","poem":1},{"lineBreak":true},{"text":"dutikam initak yutuam emegkagta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Ditak nagkí iju maam agtinai,","poem":1},{"lineBreak":true},{"text":"dutikamun ikamia yawá yukagtin aidau","poem":1},{"lineBreak":true},{"text":"ditá iyashinak yuwawagtinai!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Untsu apuk, Apajuíyai shiig aneastinai!","poem":1},{"lineBreak":true},{"text":"¡Tuja ashí aents Apajuín daajin chichau aidaushkam","poem":1},{"lineBreak":true},{"text":"shiig anentsag kantamjuawagtinai!","poem":1},{"lineBreak":true},{"text":"Untsu waitjin aina nuna weninak","poem":1},{"lineBreak":true},{"text":"Apajuí ashí epetjatnai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}