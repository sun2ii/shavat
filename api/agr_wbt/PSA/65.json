{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":65,"content":[{"type":"heading","content":["Ima Apajuíke ememattaig"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuíyah, muja Siógnum pujuuwah,","poem":1},{"lineBreak":true},{"text":"¡ametme eme anentsa","poem":1},{"lineBreak":true},{"text":"kantamjam amainmek!","poem":1},{"lineBreak":true},{"text":"Amina takagsatjame tusa anagtabau aidauk","poem":1},{"lineBreak":true},{"text":"betek umigtamain ainawai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amek ii segamash antugkagtame;","poem":1},{"lineBreak":true},{"text":"tuja ashí nugkanmaya aidauk aminí mininawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iina tudauji aidau wagagkagtakuish,","poem":1},{"lineBreak":true},{"text":"ame tsagkugkagtame.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ame aents aidau etegjam,","poem":1},{"lineBreak":true},{"text":"ame jem pegkegma nuwi amejai pujustinme","poem":1},{"lineBreak":true},{"text":"tiuwaitam duka shiig aneasagtinai.","poem":1},{"lineBreak":true},{"text":"¡Tuja ame jem pegkegma nuwi pujusa","poem":1},{"lineBreak":true},{"text":"amina pegkegmagmea nunú wainkau asaja shiig aneastatji!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apajuíyah, ametme jutiin uwemtikagtinmek,","poem":1},{"lineBreak":true},{"text":"nuadui aents pegkegchau aidau suwimak suwakum","poem":1},{"lineBreak":true},{"text":"amina umigtamaidauk shiig anennaitme.","poem":1},{"lineBreak":true},{"text":"Nuadui ashí nugkanum pujuidauk","poem":1},{"lineBreak":true},{"text":"tuja nayantsa amain atushat batsamin aidaushkam","poem":1},{"lineBreak":true},{"text":"ima aminig kajinmamas anentaimainawai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muja aidauk amina senchigmijai najanauwaitme,","poem":1},{"lineBreak":true},{"text":"dutikam buchittsuk asatnume tusam kuitame.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amek nayants tsukatbaujish imignaitme,","poem":1},{"lineBreak":true},{"text":"tuja aents aidau pampaidaush,","poem":1},{"lineBreak":true},{"text":"bitat asatajum tusam itatmitkauwaitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuja atushat batsamin aidaushkam ame amina senchigmin","poem":1},{"lineBreak":true},{"text":"wainchatai aidau iwainamun wainkag kujainawai.","poem":1},{"lineBreak":true},{"text":"Tuja ashí nugkanum batsamin aidaush","poem":1},{"lineBreak":true},{"text":"aminí shiig aneenak untsumainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ametme nugka kuitamnumek;","poem":1},{"lineBreak":true},{"text":"tuja yumishkam yutumtikame,","poem":1},{"lineBreak":true},{"text":"dutikam ajak aidaush tsapapitkame.","poem":1},{"lineBreak":true},{"text":"Ame yumi yutumtikjamu betsaka akagak","poem":1},{"lineBreak":true},{"text":"nugkan uchupjamtai, trigo aidaush","poem":1},{"lineBreak":true},{"text":"shiig tsapainiag nejenawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ajak ajakmatasa nugka taimu aidaush","poem":1},{"lineBreak":true},{"text":"yumi yutumtikjam uchupiame,","poem":1},{"lineBreak":true},{"text":"wagki ajak aidau tsapainiag senchi nejektinme tusam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ajak aidau mijadai kuashat nejektinme","poem":1},{"lineBreak":true},{"text":"tusamesh nejemtiknaitme.","poem":1},{"lineBreak":true},{"text":"Tuja yumi kuashat yutau asamtai,","poem":1},{"lineBreak":true},{"text":"yumi atsumakuish waitnatsui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui uwegshunmash","poem":1},{"lineBreak":true},{"text":"dupa tsapaka samekbau pegkeg wajas awai.","poem":1},{"lineBreak":true},{"text":"Tuja muja aidaushkam","poem":1},{"lineBreak":true},{"text":"samekbau pegkejan iwagmamainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tuja nugka nain pegkeg aidaunmak,","poem":1},{"lineBreak":true},{"text":"tagku aidau piyake,","poem":1},{"lineBreak":true},{"text":"tuja nugka paka aidaunmak","poem":1},{"lineBreak":true},{"text":"kuashat trigo ayawai.","poem":1},{"lineBreak":true},{"text":"¡Ashí nunú aidau shiig anenawai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":13}