{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":66,"content":[{"type":"heading","content":["Apawa amina takatjumek shiig pegkejai"]},{"type":"hebrew_subtitle","content":["Kantamtai agagbau"]},{"type":"verse","number":1,"content":[{"text":"Ashí nugkanmaya aidautijum","poem":1},{"lineBreak":true},{"text":"shiig aneasjum Apajuí kantamjuatajum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apajuí daaji pegkegma nunú pachisjum","poem":1},{"lineBreak":true},{"text":"kantamtai kantamatajum.","poem":1},{"lineBreak":true},{"text":"Tuja niina imanjiya nunú pachisjumshakam","poem":1},{"lineBreak":true},{"text":"kantamtai kantamatajum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apajuí chichagkujum:","poem":1},{"lineBreak":true},{"text":"“Amina takatjumek shiig pegkeg ainawai.","poem":1},{"lineBreak":true},{"text":"Ame ima senchigtin asamin,","poem":1},{"lineBreak":true},{"text":"amina shiwaajum aidauk","poem":1},{"lineBreak":true},{"text":"ishamjamainak aminí yunumainawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nuninak ashí amina etsagtamainawai,","poem":1},{"lineBreak":true},{"text":"nuninak amina daagmin pachisag","poem":1},{"lineBreak":true},{"text":"kantamtain kantamainawai”, titajum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apajuí aents aidautin ayamjutpak","poem":1},{"lineBreak":true},{"text":"ishamain wainchatai aidaun iwainajua","poem":1},{"lineBreak":true},{"text":"nunú anentaimtustajum.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nigki nayantsanash ukuya buku emauwai,","poem":1},{"lineBreak":true},{"text":"dutikamtai ii muunji aajaku aidau bukunum katiajajui.","poem":1},{"lineBreak":true},{"text":"Nuadui ¡ima Apajuíyaig shiig aneasagmi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apajuí niina senchijiya duwi","poem":1},{"lineBreak":true},{"text":"aents aidaunak tuke inawai;","poem":1},{"lineBreak":true},{"text":"untsu niina umigtan dakitin aidaunak","poem":1},{"lineBreak":true},{"text":"niijai shiwagmagawainum tusa tuke diyakui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Ashí aents aidautijum,","poem":1},{"lineBreak":true},{"text":"iina Apajuíjiya nunú","poem":1},{"lineBreak":true},{"text":"pegkegnum chichagtajum!","poem":1},{"lineBreak":true},{"text":"¡Dutikakjum kantamtai kantamjuatajum!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wagki nii iinak kuitamjamui.","poem":1},{"lineBreak":true},{"text":"Pegkegchaun takastinme tusag idaikagtatsui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iina Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"amek ima aminigkiash","poem":1},{"lineBreak":true},{"text":"kajinas anentaima tusam","poem":1},{"lineBreak":true},{"text":"dekapkagtusuitme,","poem":1},{"lineBreak":true},{"text":"nuadui plata jinum jiyamu","poem":1},{"lineBreak":true},{"text":"pegkejama iman ekagtiuwaitme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tuja kuntin achiktinun","poem":1},{"lineBreak":true},{"text":"dakamtikak, kuntinun achiyajama numamtuk,","poem":1},{"lineBreak":true},{"text":"shiwaaji achiktinme tusam","poem":1},{"lineBreak":true},{"text":"tsagkamkagtukume.","poem":1},{"lineBreak":true},{"text":"Nuigtush shiig kuashat waitkagkagtusume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuadui aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"waitkastinme tusam","poem":1},{"lineBreak":true},{"text":"agkan idaisabiume,","poem":1},{"lineBreak":true},{"text":"tuja jutiik yuminmash tuja","poem":1},{"lineBreak":true},{"text":"jiinmashkam nagkaemakmaiji.","poem":1},{"lineBreak":true},{"text":"Dutika ashí dekapkagtusam,","poem":1},{"lineBreak":true},{"text":"juju nugka pegkeja imagnum","poem":1},{"lineBreak":true},{"text":"pujustinme tusam apujkagtusmayume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui wi yaunchuk","poem":1},{"lineBreak":true},{"text":"ishamainnum pujusan amina chichagkun:","poem":1},{"lineBreak":true},{"text":"Ame yaintsamin juna nagkaikinuk,","poem":1},{"lineBreak":true},{"text":"amina emematkun anentag amastinaitjame","poem":1},{"lineBreak":true},{"text":"tiuwaitjam, nuna imatiksanuk amina jem","poem":1},{"lineBreak":true},{"text":"pegkegma nuwi wayan kuntinu maan,","poem":1},{"lineBreak":true},{"text":"nuna nejen ashí apeakun ememattatjame.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja kuntin duwejam aidaun","poem":1},{"lineBreak":true},{"text":"uwija wiyaji aidaujai","poem":1},{"lineBreak":true},{"text":"amina eme anentsan ashí apeattajai.","poem":1},{"lineBreak":true},{"text":"Nuigtushkam toro aidaun, chivo aidaun,","poem":1},{"lineBreak":true},{"text":"amina emematkun apeattajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¡Ashí atum Apajuí umijin","poem":1},{"lineBreak":true},{"text":"aidautigmek minitajum!","poem":1},{"lineBreak":true},{"text":"Nunikjum antuktajum","poem":1},{"lineBreak":true},{"text":"Apajuí mina yainka nuna pachisan ujaktajime.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apajuín untsukmaijai,","poem":1},{"lineBreak":true},{"text":"dutikan niina emematkun kantamjuamiajai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi ayatak pegkegchaunmak","poem":1},{"lineBreak":true},{"text":"anentaimsan pujutaik,","poem":1},{"lineBreak":true},{"text":"Apajuík antugtukchatnuyi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tujash minak antugtuku asa,","poem":1},{"lineBreak":true},{"text":"wi segamunash yainkabi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡Apajuík wi segamunak dakitjachmayi,","poem":1},{"lineBreak":true},{"text":"tuja niina anenkenash sujitjukchabi,","poem":1},{"lineBreak":true},{"text":"nuadui tuke ememattai atin ati!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":19}