{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":69,"content":[{"type":"heading","content":["Waitiaku pujusa Apajuí segamu"]},{"type":"hebrew_subtitle","content":["David kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuíjuh, kuashat waitiakun","poem":1},{"lineBreak":true},{"text":"atsanmainchau dekapeajai,","poem":1},{"lineBreak":true},{"text":"wait aneasam yainkata.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kucha amutnunum tepeajai,","poem":1},{"lineBreak":true},{"text":"wajai emetumainkesh atsugtawai.","poem":1},{"lineBreak":true},{"text":"Dekas namaka kunajin akaejai,","poem":1},{"lineBreak":true},{"text":"namak chichijam asa ajektawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Untsu untsumkawan sagagjai;","poem":1},{"lineBreak":true},{"text":"mina suweg dajautawai.","poem":1},{"lineBreak":true},{"text":"¡Apajuín daka dakakuan jiijuish yawegjai!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mina shiwaajuk intash kuashta","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau ainawai,","poem":1},{"lineBreak":true},{"text":"utugchat atsugtaig kajegtuinak,","poem":1},{"lineBreak":true},{"text":"mantuatag tuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja makichkish kasamkachu aig,","poem":1},{"lineBreak":true},{"text":"kasamkamujum awagkita tusa imatjutuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apajuíjuh, ame dekame wika pegkegchau ayajai;","poem":1},{"lineBreak":true},{"text":"nuadui mina tudaugnak ugmaitsugme.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuke Pujuu Apajuí ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"¡aminí kajinmamas anentaimin aina nunú,","poem":1},{"lineBreak":true},{"text":"wainak mina pegkegchaujui","poem":1},{"lineBreak":true},{"text":"datsaama yujainum idaisaipa!","poem":1},{"lineBreak":true},{"text":"Israel aents aidaun Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"aents amina egapau aina nunú","poem":1},{"lineBreak":true},{"text":"mina pegkegchaujui datsaama","poem":1},{"lineBreak":true},{"text":"yujainum kuitamkata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amina umiju asan","poem":1},{"lineBreak":true},{"text":"kajegtuinakuish katsuntajai.","poem":1},{"lineBreak":true},{"text":"Datsanjui mina yapijuk nimpawai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Mina yatsuchig aidaush,","poem":1},{"lineBreak":true},{"text":"tikich aents itugmaina dutijuinawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amina jemin akasmatkun senchi waitiajai.","poem":1},{"lineBreak":true},{"text":"Tuja amina pegkegchaun chichagtamainakui,","poem":1},{"lineBreak":true},{"text":"nuna antakun kajeajai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buutkun yujumkan yutsuk","poem":1},{"lineBreak":true},{"text":"ijagmaan pujai, dushiktuinakuish katsuntajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jakamunum nugkutain","poem":1},{"lineBreak":true},{"text":"nugkuai, dushiktuinakuish katsuntajai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ashí aents aidauk","poem":1},{"lineBreak":true},{"text":"pegkegchaun chichagtuinawai.","poem":1},{"lineBreak":true},{"text":"Tuja nampen aidaushkam","poem":1},{"lineBreak":true},{"text":"tuke aneas dushiktuinak kantamjutuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tujash Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"wika amina segajame,","poem":1},{"lineBreak":true},{"text":"¡wait aneasam yainkata!","poem":1},{"lineBreak":true},{"text":"Amek anenkaitme, tuke kuitamkagtinaitme,","poem":1},{"lineBreak":true},{"text":"iman asam minash uwemtijugta.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsakusnum tepean tepag nunú","poem":1},{"lineBreak":true},{"text":"eke jatsaig jiigkita,","poem":1},{"lineBreak":true},{"text":"tuja mina kajegtuina dusha agkanmitkajuata.","poem":1},{"lineBreak":true},{"text":"Tuja namak chichijam ajapjuattak","poem":1},{"lineBreak":true},{"text":"awajta nunú uwemtijugta.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Namak chichijam","poem":1},{"lineBreak":true},{"text":"ajekjati tusamek idaitusaipa!","poem":1},{"lineBreak":true},{"text":"Tuja wainchi ishamaina nunú","poem":1},{"lineBreak":true},{"text":"yutua emegkakti tusamesh idaitusaipa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¡Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"amek pegkeg, anentak wajasuitme,","poem":1},{"lineBreak":true},{"text":"iman asam minash aigkata!","poem":1},{"lineBreak":true},{"text":"Amek wait anenkagtinaitam","poem":1},{"lineBreak":true},{"text":"iman asam minash antugtukta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Juju amina inakem","poem":1},{"lineBreak":true},{"text":"segapa nunú antugtsuk idaisaipa!","poem":1},{"lineBreak":true},{"text":"¡Utugchat ishamain ajutui, wamak yainkata!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Juwi taam, shiwag aidau","poem":1},{"lineBreak":true},{"text":"waitkajuina nunú ayamjutkata!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Amek mina dushiktuinak","poem":1},{"lineBreak":true},{"text":"inastuina duka shiig dekame.","poem":1},{"lineBreak":true},{"text":"Tuja mina shiwaajush ya ainawa","poem":1},{"lineBreak":true},{"text":"dushakam amek dekame.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ima imatjutuinakua ipimtukiaje,","poem":1},{"lineBreak":true},{"text":"nuadui shiig aneasa pujumainchau","poem":1},{"lineBreak":true},{"text":"kakaagchamin dekapeajai.","poem":1},{"lineBreak":true},{"text":"Yaki wait anenjug","poem":1},{"lineBreak":true},{"text":"anentaijun ichichtujainta tusan,","poem":1},{"lineBreak":true},{"text":"egaknush wainkachmaijai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yapajaish, yutainum jatain egketjiagmayi,","poem":1},{"lineBreak":true},{"text":"tuja kitamaish chujuinun sujiagmayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nuadui dita jiistamaina nunú","poem":1},{"lineBreak":true},{"text":"yutaiji aina nunú aatus ditan pempeentuki","poem":1},{"lineBreak":true},{"text":"utugchatan apujtusti.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Tuja wainmachu,","poem":1},{"lineBreak":true},{"text":"kakaumainchau emakta!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dutikakum ame kajekbauwai","poem":1},{"lineBreak":true},{"text":"makichkish idaitsuk ashí ijinata.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dutikawamin dita jee aina duka","poem":1},{"lineBreak":true},{"text":"agkan juwajagtatui,","poem":1},{"lineBreak":true},{"text":"tuja nunú jega aidaunmak","poem":1},{"lineBreak":true},{"text":"makichkish pujuschatnume.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wagki ame mina suwimak sujusamin","poem":1},{"lineBreak":true},{"text":"waitiaish, ditak minak diigtsuk","poem":1},{"lineBreak":true},{"text":"ayá dushiktuinak, nuni senchi waitkajuinawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nuadui ameshkam","poem":1},{"lineBreak":true},{"text":"pegkegchaunmak ikata.","poem":1},{"lineBreak":true},{"text":"¡Tuja makichkish dita tudaujig tsagkujaipa!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"¡Aents tuke pujusagtin aina nuna daaji","poem":1},{"lineBreak":true},{"text":"papiinum agatkamua nuwi, dita daaji ayá","poem":1},{"lineBreak":true},{"text":"duka ashí esakatjata!","poem":1},{"lineBreak":true},{"text":"Tuja aents amina umigtamin aidaun","poem":1},{"lineBreak":true},{"text":"daaji agatkamua nuwig,","poem":1},{"lineBreak":true},{"text":"dita daajig makichkish agatjaipa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Apajuíyah, wi jakun wake besemag","poem":1},{"lineBreak":true},{"text":"dushikiam pujag nunú minash","poem":1},{"lineBreak":true},{"text":"wait aneasam yainkam uwemtijugta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"¡Apajuín see tusan kantamtain kantamkun,","poem":1},{"lineBreak":true},{"text":"shiig aneasan ashí iwainakan","poem":1},{"lineBreak":true},{"text":"niina daajin ememattatjai!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nunú dekas, kuntin aidau","poem":1},{"lineBreak":true},{"text":"maa apeamun nagkaesau","poem":1},{"lineBreak":true},{"text":"Tuke Pujuunak shiig awagmaktatui.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tuja aents Apajuín segau aidau","poem":1},{"lineBreak":true},{"text":"wake besemag batsatuk,","poem":1},{"lineBreak":true},{"text":"nuna wainkag shiig aneasagtatui;","poem":1},{"lineBreak":true},{"text":"nuninak ichichmamjagtatui.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuk aents waitiak","poem":1},{"lineBreak":true},{"text":"wake besemag pujus sumaunak antujui;","poem":1},{"lineBreak":true},{"text":"tuja niina aentsji aidau achikam batsamas","poem":1},{"lineBreak":true},{"text":"waitiagtaish, dakitjag idaitsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Nugka, nayaim, nayants aidautigmesh","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum,","poem":1},{"lineBreak":true},{"text":"tuja ashí nuwi batsamin aidautigmeshkam","poem":1},{"lineBreak":true},{"text":"Apajuí ememattajum.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Apajuí Jerusalégnak kuitamkattawai,","poem":1},{"lineBreak":true},{"text":"dutikak Judá wegantu aidaun","poem":1},{"lineBreak":true},{"text":"yaaktaji aidau tsaikbau aina nunak","poem":1},{"lineBreak":true},{"text":"ataktu iwagkattawai.","poem":1},{"lineBreak":true},{"text":"Dutikamtai niina aentsji aidau","poem":1},{"lineBreak":true},{"text":"nuwi batsamsagtinai.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Nunú nugkak niina aentsji aidaun","poem":1},{"lineBreak":true},{"text":"uchiji wegantu aidaunu atinai.","poem":1},{"lineBreak":true},{"text":"Tuja nunú nugkanmak Apajuín aneen aidau","poem":1},{"lineBreak":true},{"text":"shiig batsamsagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":36}