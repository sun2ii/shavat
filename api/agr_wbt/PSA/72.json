{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":72,"content":[{"type":"heading","content":["Apu eme anentsa Apajuí segatbau"]},{"type":"hebrew_subtitle","content":["Salomón kantamjuamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"juju apu amina takatjum pegkeja nuna","poem":1},{"lineBreak":true},{"text":"niishkam shiig takasti tusam yaigta.","poem":1},{"lineBreak":true},{"text":"Tuja tikich apu atina dushakam","poem":1},{"lineBreak":true},{"text":"dutiksag shiig takastin atinme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aatus amina aentsjum aidaun,","poem":1},{"lineBreak":true},{"text":"tuja nuigtu waitkam batsatu aidaun apuji wajas,","poem":1},{"lineBreak":true},{"text":"inamak shiig takastin ati.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuja muja aina nuwiya jiinjag,","poem":1},{"lineBreak":true},{"text":"agkan maanitsuk pujutan,","poem":1},{"lineBreak":true},{"text":"pegkeg takatjai aents aidaun jintintuati.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Ujudauch aidaun ayamjukti!","poem":1},{"lineBreak":true},{"text":"¡Tuja aents waituina nuna","poem":1},{"lineBreak":true},{"text":"uchiji aidaunashkam ayamjukti!","poem":1},{"lineBreak":true},{"text":"¡Tuja untsu tsanumag kasamin aina nunak waitkasti!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Nii tuké iina apuji atin ati,","poem":1},{"lineBreak":true},{"text":"Tuja etsa, nantu megkaekashtinun tuke auwa","poem":1},{"lineBreak":true},{"text":"nujai betek pujustin ati!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Yumi yutak nugkan uchupig, ajakan shiig tsapapama iman ati!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Nii apu wajas inamtata duik shiig agkan pujusa takamu ati!","poem":1},{"lineBreak":true},{"text":"¡Tuja nii inabaujig nantu tuke auwa","poem":1},{"lineBreak":true},{"text":"nujai betek atin ati!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Nunú apua duka","poem":1},{"lineBreak":true},{"text":"etsa jiintaya imanui nagkamas,","poem":1},{"lineBreak":true},{"text":"etsa akaetaiya aatus","poem":1},{"lineBreak":true},{"text":"ashí nugkanum inamjatin ati!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Tuja niina shiwaaji aidau","poem":1},{"lineBreak":true},{"text":"uwegshunum batsata duka","poem":1},{"lineBreak":true},{"text":"nii tabaun umiktinme!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Nuninak Tarsis nugkan apuji aidau,","poem":1},{"lineBreak":true},{"text":"ajuntai aidaunum batsamnun apuji aidau,","poem":1},{"lineBreak":true},{"text":"Sabá nugkan apuji aidau,","poem":1},{"lineBreak":true},{"text":"nuigtu Sebá nugkan apuji aidau aatus","poem":1},{"lineBreak":true},{"text":"waji aidaun ikautiagtinai!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Ashí apu aidauk","poem":1},{"lineBreak":true},{"text":"ima niinak tikishmatjagtatui!","poem":1},{"lineBreak":true},{"text":"¡Tikich nugkanmaya aidaushkam","poem":1},{"lineBreak":true},{"text":"ima niinak umigkagtatui!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ujudauch aidau atsumainak","poem":1},{"lineBreak":true},{"text":"sumainamunak nii yaigtatui,","poem":1},{"lineBreak":true},{"text":"tuja waitiak wake besemag","poem":1},{"lineBreak":true},{"text":"pujaunashkam nii ayamjuktatui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ujudauch aidaun wait anenjattawai,","poem":1},{"lineBreak":true},{"text":"dutikak wake besemag pujaunash","poem":1},{"lineBreak":true},{"text":"yaigka uwemtijattawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ujudauch aidaun waitkainak maaniagtaish,","poem":1},{"lineBreak":true},{"text":"nii ayamjuk uwemtijattawai.","poem":1},{"lineBreak":true},{"text":"Wagki dita pujutji aina duka","poem":1},{"lineBreak":true},{"text":"nii diismak akik ainawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¡Niig tuke iina apuji atin ati!","poem":1},{"lineBreak":true},{"text":"¡Sabánmaya oronak ashí susatnume!","poem":1},{"lineBreak":true},{"text":"¡Nii pachisa tuke Apajuí segattai ati!","poem":1},{"lineBreak":true},{"text":"¡Tuke pegkegnum chichagtai ati!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Tuja ashí juju nugkanmak","poem":1},{"lineBreak":true},{"text":"trigo shiig kuashat aittawai,","poem":1},{"lineBreak":true},{"text":"imaniak muja titijinak ijia emegkaktatui!","poem":1},{"lineBreak":true},{"text":"Imaniau asa muja Líbano tutainum","poem":1},{"lineBreak":true},{"text":"trigo aijakua iman wajasti,","poem":1},{"lineBreak":true},{"text":"nuniak nuna yagkuji aidauk","poem":1},{"lineBreak":true},{"text":"dupa yagkujuwama imanik yagkujuk asattawai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Apu daajig etsa tuke ekemna iman","poem":1},{"lineBreak":true},{"text":"tuke pegkegnum chichagtai ati!","poem":1},{"lineBreak":true},{"text":"¡Aents ashí nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"niina daajin pegkegnum yumigkiam agtinai!","poem":1},{"lineBreak":true},{"text":"Ashí nugkanmaya aidauk niina","poem":1},{"lineBreak":true},{"text":"pegkegnum chichajiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tuke Pujuu, Israel aents aidaun Apajuíjiya duka","poem":1},{"lineBreak":true},{"text":"tuke pegkegnum chichagtai ati,","poem":1},{"lineBreak":true},{"text":"wagki ima nigki wainchatai aidaunash iwaidau asamtai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Apajuí daaji pegkegma duka","poem":1},{"lineBreak":true},{"text":"tuke pegkegnum chichagtai ati.","poem":1},{"lineBreak":true},{"text":"¡Niina imanjiya nunú ashí nugkan jamagti!","poem":1},{"lineBreak":true},{"text":"¡Aatus ati!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Jesé uchiji David aajakua nunú kantamamuk juwi amuewai."]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":20}