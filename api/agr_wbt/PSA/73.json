{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":73,"content":[{"type":"heading","content":["Apajuí wait anenkagtamu"]},{"type":"hebrew_subtitle","content":["Asaf kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Israel aents aidau anentaimtaji pegkeg aidaunak","poem":1},{"lineBreak":true},{"text":"Apajuí shiig kuitamui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Namput wajaschabiajai iyautnak,","poem":1},{"lineBreak":true},{"text":"jukea akunuk iyagtinuyajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aents Apajuín umigchau aidau wiakchamenakui,","poem":1},{"lineBreak":true},{"text":"nuna diisan kajebiajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ditak jamamtuchu batsatu asag","poem":1},{"lineBreak":true},{"text":"jakachainjash tusagkesh puyatuinatsui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dita utugchatjig atsujuinawai,","poem":1},{"lineBreak":true},{"text":"nuadui tikich aidau waituina imanikag","poem":1},{"lineBreak":true},{"text":"waituinatsui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuadui ditak nugkutai pegkeg najanamu","poem":1},{"lineBreak":true},{"text":"nugkumaina numamtuk,","poem":1},{"lineBreak":true},{"text":"dita emematin nugkuaju ainawai.","poem":1},{"lineBreak":true},{"text":"Tuja ditak magkagtutaijinak,","poem":1},{"lineBreak":true},{"text":"jáanchjai betek nugkuaju ainawai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Duwegmatnak duwejam ainawai,","poem":1},{"lineBreak":true},{"text":"tujash dita yapinig wainnawai","poem":1},{"lineBreak":true},{"text":"anentai shiig pegkegchau aina duka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ememainak tikich aents aidaunash","poem":1},{"lineBreak":true},{"text":"dushikinawai, nuninak","poem":1},{"lineBreak":true},{"text":"makichkish datsaamtsuk,","poem":1},{"lineBreak":true},{"text":"ii wakegakuik pegkegchau takamsattaji","poem":1},{"lineBreak":true},{"text":"tusag awanmainawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuninak Apajuínash pegkegchaun chichajuinawai,","poem":1},{"lineBreak":true},{"text":"tuja aents aidaunash dutiksag pegkegchaun chichajuinawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nuna aents yujajus iniinak","poem":1},{"lineBreak":true},{"text":"yajau chichainatsui tusag","poem":1},{"lineBreak":true},{"text":"shiig antuju yujaush ainawai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuninak: “¿Apajuísh wajuk dekatki iina pujutjinash?","poem":1},{"lineBreak":true},{"text":"Tuja Apajuí nayaimpinum puja aniaush","poem":1},{"lineBreak":true},{"text":"aents takainamunash","poem":1},{"lineBreak":true},{"text":"¿wajuk dekamainaita?” tuinawai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Diisjua aents pegkegchau aina nunú!","poem":1},{"lineBreak":true},{"text":"Ditak utugchatji atsau,","poem":1},{"lineBreak":true},{"text":"shiig pujusag wiakuch wenawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Wi pegkegchau takatan","poem":1},{"lineBreak":true},{"text":"ashí idaisauwaitag duka minak","poem":1},{"lineBreak":true},{"text":"makichkish pegkegnumak yaintsui!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Minak wa wamak utugchatan itagtuinawai,","poem":1},{"lineBreak":true},{"text":"tuja kashi kashikmasan suwimkanak igkuajai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tuja wisha dita anentaimaina nujai betek anentaimkunuk,","poem":1},{"lineBreak":true},{"text":"amina aentsjum aina nunak kajimatki idaikunus,","poem":1},{"lineBreak":true},{"text":"wi wakegamun takasu aintagtai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja ibau tudaugtin aidaush,","poem":1},{"lineBreak":true},{"text":"¿wajukag wiakchash wenawa? tusa","poem":1},{"lineBreak":true},{"text":"anentaimsan ejetakamanush","poem":1},{"lineBreak":true},{"text":"ejemainchau dekapjabiajai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nuni pujaun Apajuí jee pegkegma nuwi","poem":1},{"lineBreak":true},{"text":"niijai chichastasan waya ai,","poem":1},{"lineBreak":true},{"text":"aents pegkegchau aidaush","poem":1},{"lineBreak":true},{"text":"wajukatnuk ainawa","poem":1},{"lineBreak":true},{"text":"nuna Apajuí dekamtijuabi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nunú aents aidauk ishamainnum batsasume,","poem":1},{"lineBreak":true},{"text":"dutikamu asag dita megkaejatnunum shimawai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Nunú aidauk pachiachbau","poem":1},{"lineBreak":true},{"text":"shiig wamak ijina utsam agtatui!","poem":1},{"lineBreak":true},{"text":"¡Ditak sapijai jinawagtinai!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, aents kanag tepau nantak","poem":1},{"lineBreak":true},{"text":"nii kajamjamujin kajimatama numamtuk,","poem":1},{"lineBreak":true},{"text":"ame nantakum aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"ditash ima pegkeg ainawa tumain aina duka","poem":1},{"lineBreak":true},{"text":"emegkagtatme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Wi senchi kajekan pujubiajai,","poem":1},{"lineBreak":true},{"text":"nuniai mina anentaig dajautibi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wika aents pegkegchau aina nuna","poem":1},{"lineBreak":true},{"text":"pujutjin dekajuatasan wakegakun,","poem":1},{"lineBreak":true},{"text":"kuntin jintiag anentaimchau asa","poem":1},{"lineBreak":true},{"text":"wajukmaina numamtuk wajabiajai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nuniayatkun amejaig tuke pujubiajai,","poem":1},{"lineBreak":true},{"text":"nuniau asamtai tudaunum iyawai tusam","poem":1},{"lineBreak":true},{"text":"egkegsam awekatmayume.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Umigtukti tujutu asam","poem":1},{"lineBreak":true},{"text":"ame chichagtukmayume,","poem":1},{"lineBreak":true},{"text":"nuadui wi jakamtaish,","poem":1},{"lineBreak":true},{"text":"eme anenjusam jujuktinaitme.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¿Amina nagkaetamsaush tikichish","poem":1},{"lineBreak":true},{"text":"nayaimpinmash ya pujawa? Duka atsawai,","poem":1},{"lineBreak":true},{"text":"ima ameketme.","poem":1},{"lineBreak":true},{"text":"Amejai pujaknuk juju nugkanmaya aidaunak","poem":1},{"lineBreak":true},{"text":"makichkish wakejumaitsujai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mina pujutjua duka nagkankattawai,","poem":1},{"lineBreak":true},{"text":"tujash Apajuíya nunú","poem":1},{"lineBreak":true},{"text":"pujut tuke atinun sujustatui,","poem":1},{"lineBreak":true},{"text":"tuja nii mina anentaijuish ichichtawai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aents amina nemagtamtan dakitauk, jinawagtinai;","poem":1},{"lineBreak":true},{"text":"tuja ima aminig kajinas","poem":1},{"lineBreak":true},{"text":"anentaimainachushkam ijinatnaitme.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Untsu wika ima Apajuíyaig","poem":1},{"lineBreak":true},{"text":"anentaimsan pujustinaitjai,","poem":1},{"lineBreak":true},{"text":"nunú minak shiig awajtawai.","poem":1},{"lineBreak":true},{"text":"Ametme Tuke Pujuu Apajuí, mina ayamjutkatnumek.","poem":1},{"lineBreak":true},{"text":"Nuadui ashí ame dutikamu aina nunak etsegkattajai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}