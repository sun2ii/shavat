ine_break"},{"type":"verse","number":3,"content":[{"text":"Ame nayaim najanamua","poem":1},{"lineBreak":true},{"text":"nuna diisan, tuja nantu,","poem":1},{"lineBreak":true},{"text":"yaya aidaujai ame najankamu aidau","poem":1},{"lineBreak":true},{"text":"nayaimpinum ayá nunashkam wainkun","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"anentaimsan:","poem":1},{"lineBreak":true},{"text":"¡Aents aidautik pegkegmakesh ainatsji!","poem":1},{"lineBreak":true},{"text":"¡Tikima wainkauch ainaji!","poem":1},{"lineBreak":true},{"text":"Nunin ajinish ¿wagka tujash","poem":1},{"lineBreak":true},{"text":"puyatkagtusmesh kuitamkagtame?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aentsuk ángelchawashit tumain najanauwaitme.","poem":1},{"lineBreak":true},{"text":"Nuadui apu kuitamaina","poem":1},{"lineBreak":true},{"text":"imatiksam kuitamam duka dutikame.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja ashí ame najankamu aina duka","poem":1},{"lineBreak":true},{"text":"ashí nii idaitusuitme, dutikakum","poem":1},{"lineBreak":true},{"text":"tikich ame najankamu aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau emam apusauwaitme.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dutikam uwig aidau","poem":1},{"lineBreak":true},{"text":"buey aidau, kuntin ikamia aidau,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"chigki yakí nanamin aidau,","poem":1},{"lineBreak":true},{"text":"namak nayantsanmaya aidau,","poem":1},{"lineBreak":true},{"text":"tuja tikich kuntin aidau","poem":1},{"lineBreak":true},{"text":"nayantsanum ayá duka","poem":1},{"lineBreak":true},{"text":"ashí nii idaitusuitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tuke Pujuuwah, ametme iina apujimek,","poem":1},{"lineBreak":true},{"text":"ametme ashí tikich aidaun","poem":1},{"lineBreak":true},{"text":"nagkaesau dekas muunmek.","poem":1},{"lineBreak":true},{"text":"¡Amina daagminak","poem":1},{"lineBreak":true},{"text":"ashí nugkanum dekainawai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}