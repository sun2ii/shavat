{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":80,"content":[{"type":"heading","content":["Tuke Pujuuwah, wait anenkagtugta"]},{"type":"hebrew_subtitle","content":["Asaf kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Apajuí, Israel aents aidaun kuitamnuh,","poem":1},{"lineBreak":true},{"text":"¡ame José wegantu aina duka","poem":1},{"lineBreak":true},{"text":"aents uwigjin kuitamas awekauwama numamtuk","poem":1},{"lineBreak":true},{"text":"kuitamsa awekame!","poem":1},{"lineBreak":true},{"text":"¡Ame querubin aidauk iname!","poem":1},{"lineBreak":true},{"text":"¡Iman asam Efraín wegantu aidau,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benjamín wegantu aidau,","poem":1},{"lineBreak":true},{"text":"Manasés wegantu aidau wait anenjata!","poem":1},{"lineBreak":true},{"text":"Dutikakum amina senchigmijai uwemtikagtugta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, ¡iina pujutji yapagkagtuam","poem":1},{"lineBreak":true},{"text":"yaunchuk ayag iman ekagtita!","poem":1},{"lineBreak":true},{"text":"Dutikagtuawaminig jutiishkam uwemjagtatji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tuke Pujuu ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"amina aentsjum aidau","poem":1},{"lineBreak":true},{"text":"segapainakui dakitam dusha","poem":1},{"lineBreak":true},{"text":"¿wajupa kuashta aikash pujugtatme?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yutai sukagtumaina nunú","poem":1},{"lineBreak":true},{"text":"waitut sukagtusmayume,","poem":1},{"lineBreak":true},{"text":"tuja umutai umumaina nunú","poem":1},{"lineBreak":true},{"text":"waitiaku buutbau sukagtusmayume.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iina nugkega nuna yantamen batsamin aina","poem":1},{"lineBreak":true},{"text":"nunú atsaneaku dushiktai ekagtiume.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apajuí ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"¡iina pujutji yapajiam","poem":1},{"lineBreak":true},{"text":"yaunchuk ayag iman ekagtita!","poem":1},{"lineBreak":true},{"text":"Dutikagtuawaminig jutiishkam uwemjagtatji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uva numiji","poem":1},{"noteId":2},{"text":"egiptunmaya jukim","poem":1},{"lineBreak":true},{"text":"juwi itaam, aents pegkegchau aidau","poem":1},{"lineBreak":true},{"text":"jiija utsaakum juju nugkanum ajabiume.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dutikam shiig tsapaiti tusam nugka iwajabiume,","poem":1},{"lineBreak":true},{"text":"dutikawamin nuwi tsapaka","poem":1},{"lineBreak":true},{"text":"ashí nugkan jamagmayi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Imaniku asa nunú tsakaak","poem":1},{"lineBreak":true},{"text":"muja aidaunak bikintu awajsabi;","poem":1},{"lineBreak":true},{"text":"dutikak numi múun aidaunash","poem":1},{"lineBreak":true},{"text":"nagkagag niina kanawen yutua asabi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Imaniau asa kanawe aidauk","poem":1},{"lineBreak":true},{"text":"nayantsanum jegabi.","poem":1},{"lineBreak":true},{"text":"Tuja nuwi yama tsapaidaushkam","poem":1},{"lineBreak":true},{"text":"namak Eufratesa imanui jegabi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uva ajakbau peejamua dusha","poem":1},{"lineBreak":true},{"text":"¿wagka yumpuntuamesh agkantash awajtusume,","poem":1},{"lineBreak":true},{"text":"aents aidau nagkaemainak","poem":1},{"lineBreak":true},{"text":"akajag yajumtinme tusamesh?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paki utsantua tegaja ijinui.","poem":1},{"lineBreak":true},{"text":"¡Kuntin ikamia aidau amuinawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Amek Apajuí ashí senchigtinaitme,","poem":1},{"lineBreak":true},{"text":"iman asam wait aneasam","poem":1},{"lineBreak":true},{"text":"nayaimpinum pujusam","poem":1},{"lineBreak":true},{"text":"juju uva ajakbauwa nunú kuitamkata.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Juju uva ayá duka ame ajakbau ainawai,","poem":1},{"lineBreak":true},{"text":"nuadui kuitamkata.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja uva numijin tsupig apea ijinuk,","poem":1},{"lineBreak":true},{"text":"ameshkam dutiksamek ijinata.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Untsu apu ati tusa ame etegkamua duka","poem":1},{"lineBreak":true},{"text":"kuitamkata, dutikakum yaigta.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tuja yamai nagkamsaik","poem":1},{"lineBreak":true},{"text":"makichkish aminig tsujakchattaji.","poem":1},{"lineBreak":true},{"text":"¡Pujut sukagtusta ima aminig","poem":1},{"lineBreak":true},{"text":"kajitmamsa batsamsagmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Chah, Tuke Pujuuwah, ametme","poem":1},{"lineBreak":true},{"text":"Apajuí ashí senchigtinmek,","poem":1},{"lineBreak":true},{"text":"nuadui ¡iina pujutji yapajiam","poem":1},{"lineBreak":true},{"text":"yaunchuk ayag iman ekagtita!","poem":1},{"lineBreak":true},{"text":"¡Dutikagtuawaminig jutiishkam uwemjagtatji!","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“Uva numiji” tawa nunak Israel aents aidau Egipto nugkanum batsatun Apajuí jiija yajuak Canaán nugkanum ikaunma, nuwi aents aidaun jiija utsaak nunú nugkanum batsasua nuna taku tawai.","reference":{"chapter":80,"verse":8}}]},"thisChapterLink":"/api/agr_wbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":19}