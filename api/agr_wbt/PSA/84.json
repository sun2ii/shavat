{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":84,"content":[{"type":"heading","content":["Apajuí jee pegkegma nuwi pujustasan ima senchi wakegajai"]},{"type":"hebrew_subtitle","content":["Coré uchiji aidau kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"¡Tuke Pujuu, ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"amina jemea duka shiig pegkejai!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Wika Tuke Pujuu jee pegkegma nuwi pujustasan","poem":1},{"lineBreak":true},{"text":"shiig senchi wakegajai!","poem":1},{"lineBreak":true},{"text":"¡Nuniakun Apajuí pujuta sukagtina nuna","poem":1},{"lineBreak":true},{"text":"shiig anentsan senchi kantamjajai!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, ametme ashí senchigtinum.","poem":1},{"lineBreak":true},{"text":"Mina apug, Apajuíjuh,","poem":1},{"lineBreak":true},{"text":"tiki pishakchikesh amina jemin waya,","poem":1},{"lineBreak":true},{"text":"pasugmak uchijin muumpitkamainuk","poem":1},{"lineBreak":true},{"text":"agkantak ayawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Amina jem pegkegma nuwi pujuidauk","poem":1},{"lineBreak":true},{"text":"shiig aneasag batsatainawai,","poem":1},{"lineBreak":true},{"text":"nunidau asag amina emematjamtanak","poem":1},{"lineBreak":true},{"text":"makichkish mijamainatsui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja aents aidau aminiyan","poem":1},{"lineBreak":true},{"text":"senchimetan juwina duka shiig aneasagtatui,","poem":1},{"lineBreak":true},{"text":"tuja amina jemin minitag tusa","poem":1},{"lineBreak":true},{"text":"wakeyin aina dushakam shiig aneasagtatui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nugka paka buutbau tutai","poem":1},{"lineBreak":true},{"text":"yumi atsaunum weakush,","poem":1},{"lineBreak":true},{"text":"yumi pukuni jiinaidaun waintinai;","poem":1},{"lineBreak":true},{"text":"tuja yumigmat taimunmaya yumi","poem":1},{"lineBreak":true},{"text":"kuyua megkaetaish, yumi yutak","poem":1},{"lineBreak":true},{"text":"ashí nugka waa aidaunmak pimasua waigtinai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apajuíyah, amina senchigmejai","poem":1},{"lineBreak":true},{"text":"ditak tuké senchimeawagtinai.","poem":1},{"lineBreak":true},{"text":"Tuja Siógnum jegawag","poem":1},{"lineBreak":true},{"text":"Apajuí senchigtina nuna wainkagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuke Pujuu, ashí senchigtin,","poem":1},{"lineBreak":true},{"text":"Jacopan Apajuíjiyah,","poem":1},{"lineBreak":true},{"text":"¡wi sumamush antugtukta!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apajuíyah, jutii ejamaktin","poem":1},{"lineBreak":true},{"text":"ame etegkam apu emauwaitam","poem":1},{"lineBreak":true},{"text":"nunú shiig anentsam kuitamkata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amina jem pegkegma nuwi waya,","poem":1},{"lineBreak":true},{"text":"makichik tsawan pujamua duka,","poem":1},{"lineBreak":true},{"text":"mil tsawan agá pujumaina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau ima pegkejai.","poem":1},{"lineBreak":true},{"text":"Wika aents pegkegchau aina nujai","poem":1},{"lineBreak":true},{"text":"ijunja pujutnak idaikun,","poem":1},{"lineBreak":true},{"text":"dekas amina jem pegkegman waitijiya nuna","poem":1},{"lineBreak":true},{"text":"kuitamin atajai tusan wakegajai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuu Apajuí iinak ejapak kuitamjamui;","poem":1},{"lineBreak":true},{"text":"tuja aents tudau takatsuk batsata nunak,","poem":1},{"lineBreak":true},{"text":"nii wait anentak eme anentus kuitamui,","poem":1},{"lineBreak":true},{"text":"dutikak waji pegkeg aidaunak sujitatsui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tuke Pujuu, ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"¡aminí kajinmamas anentaimaidauk","poem":1},{"lineBreak":true},{"text":"shiig aneasagtinai!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":12}