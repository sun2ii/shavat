{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":87,"content":[{"type":"heading","content":["Jerusalén pachisa kantamamu"]},{"type":"hebrew_subtitle","content":["Coré uchiji aidau kantamawagbau"]},{"type":"verse","number":1,"content":[{"text":"Yaakat Jerusalégkak muja pegkejam","poem":1},{"lineBreak":true},{"text":"Apajuínu tutaiya nuwi yaaktamamui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuke Pujuuk Israel aents aidaun yaaktaji,","poem":1},{"lineBreak":true},{"text":"tikich aina nuna nagkagas,","poem":1},{"lineBreak":true},{"text":"Jerusalégkan ima senchi aneawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apajuín yaaktajiya nuna","poem":1},{"lineBreak":true},{"text":"Jerusalégkan pachisag,","poem":1},{"lineBreak":true},{"text":"shiig pegkejan augmatuinawai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Aents aidau mina emematjuina duka","poem":1},{"lineBreak":true},{"text":"Egipto nugkanum, Babilonia nugkanum,","poem":1},{"lineBreak":true},{"text":"Tironum, Etiopía nugkanum, Filisteo nugkanum aatus batsatui.","poem":1},{"lineBreak":true},{"text":"Nunú nugkanmaya aents aidau chichainak:","poem":1},{"lineBreak":true},{"text":"‘Apajuínak Jerusalégnum wainkabiajai’ tiagtatui”, tiuwai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuja Siógnumia aidaun chichajuinak:","poem":1},{"lineBreak":true},{"text":"“¿Wagkag ditash ibau pegkegnumash batsamsajabi?","poem":1},{"lineBreak":true},{"text":"Dita batsamsatnunak dekas Apajuíyap","poem":1},{"lineBreak":true},{"text":"umigkauwaita”, tiagtinai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aents aidaun daaji agattainum","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu dita daajinak:","poem":1},{"lineBreak":true},{"text":"“Juka Siógnum akiinauwai”, tuu agatjatnai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nuadui nuwiya aents aidauk nantsemki,","poem":1},{"lineBreak":true},{"text":"kantamkabaikia chichainak:","poem":1},{"lineBreak":true},{"text":"“Mina pujutaijuk Jerusalégkai”, tiagtinai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":7}