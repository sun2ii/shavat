{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":89,"content":[{"type":"heading","content":["Apajuí Davitjai chicham umikbau"]},{"type":"hebrew_subtitle","content":["Esrahita aents Etán aajakua nunú kantamamu"]},{"type":"verse","number":1,"content":[{"text":"Tuke Pujuuwah, wi kantamkunuk,","poem":1},{"lineBreak":true},{"text":"amek tuke wait anenkagtinaitme titatjame,","poem":1},{"lineBreak":true},{"text":"tusan aju ajumag kantamjittagme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuniakun amina anenkem tuke auwa nuna,","poem":1},{"lineBreak":true},{"text":"tuja ame anagkagtuamuk","poem":1},{"lineBreak":true},{"text":"nayaim yapajinchauwa imana nuna etsegkattajai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amek Davidjai chichamak umikuitme;","poem":1},{"lineBreak":true},{"text":"dutikau asam nii anagkuakum:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Ame jakaminig,","poem":1},{"lineBreak":true},{"text":"ame wegantunmaya apu wajasa","poem":1},{"lineBreak":true},{"text":"ame pujusa inamtaigmin pujus inamjatnai”,","poem":1},{"lineBreak":true},{"text":"tiuwaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"nayaim aidauk amina takatjum pegkeja","poem":1},{"lineBreak":true},{"text":"nuna diisag emematjamainawai,","poem":1},{"lineBreak":true},{"text":"tuja ashí ángel aidauk","poem":1},{"lineBreak":true},{"text":"amina anenkagmin pachisag chichainawai;","poem":1},{"lineBreak":true},{"text":"ima aminak eme anenjamainawai.","poem":1},{"lineBreak":true},{"text":"Tuke Pujuuwah, ametme","poem":1},{"lineBreak":true},{"text":"tikich aents aidaun apajuíji aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau ishamtai dekas muunmek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tuke Pujuu ashí senchigtinuh,","poem":1},{"lineBreak":true},{"text":"ame senchigtinum chichakbaugmek","poem":1},{"lineBreak":true},{"text":"betek uminaitam imanuk tikichik","poem":1},{"lineBreak":true},{"text":"makichkish atsawai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ame nayantsak inau asam,","poem":1},{"lineBreak":true},{"text":"tsukatak ishamain wajakuish,","poem":1},{"lineBreak":true},{"text":"mijaakta tusam imijiame.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayantsanmaya kuntin múun depetkam,","poem":1},{"lineBreak":true},{"text":"amina senchigmin shiwaajum aidau","poem":1},{"lineBreak":true},{"text":"uwaakam ipisjabiume.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nayaim, nugka aina duka aminu ainawai,","poem":1},{"lineBreak":true},{"text":"ame nugkak, tuja ashí nugkanum","poem":1},{"lineBreak":true},{"text":"ayá nujai najankauwaitme.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsumujinish, nujinchinish","poem":1},{"lineBreak":true},{"text":"ame ashí nugkak najanauwaitme.","poem":1},{"lineBreak":true},{"text":"Tuja muja Tabor, muja Hermógjai","poem":1},{"lineBreak":true},{"text":"amina daagmin pachisag kantamainawai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amina kuntugmek senchigtinai,","poem":1},{"lineBreak":true},{"text":"tuja amina uwejum untsuja dushakam","poem":1},{"lineBreak":true},{"text":"senchigtin depetbauwai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amek pegkegnum anenkajai inaame,","poem":1},{"lineBreak":true},{"text":"tujash nuna nagkaesau dekas","poem":1},{"lineBreak":true},{"text":"amina anenkagmin","poem":1},{"lineBreak":true},{"text":"tuke kuitamkagtame.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"aents amina emematjamin,","poem":1},{"lineBreak":true},{"text":"amina tsaaptinjumin wekayin,","poem":1},{"lineBreak":true},{"text":"tuja amina takatjum pegkegma nuna diis","poem":1},{"lineBreak":true},{"text":"tuke shiig anea duka","poem":1},{"lineBreak":true},{"text":"amek eme anentame,","poem":1},{"lineBreak":true},{"text":"dutikakum pegkegnum yumigkiame.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wagki dita imanji aina duka,","poem":1},{"lineBreak":true},{"text":"tuja senchiji aina nujai ame susauwaitme.","poem":1},{"lineBreak":true},{"text":"Nuadui jutii aidautik aan nagkaemasam","poem":1},{"lineBreak":true},{"text":"senchigtin ekagtame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Israel aents aidaun Apajuíji, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"ametme iina apuji pegkegmamek,","poem":1},{"lineBreak":true},{"text":"tuja ametme ejajatkam kuitamkagtaumek.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Amina chichamjumin etsejin","poem":1},{"lineBreak":true},{"text":"yaunchuk kajanum chichagkum:","poem":1},{"lineBreak":true},{"text":"“Mina aentsug aina nuwiyan","poem":1},{"lineBreak":true},{"text":"makichik wajiun etegkajai,","poem":1},{"lineBreak":true},{"text":"duka mina inakeg Davitai,","poem":1},{"lineBreak":true},{"text":"wi niinak yaigkan, chichame antugtai emajai.","poem":1},{"lineBreak":true},{"text":"Dutikan ¡Israel aents aidaun apuji adaikajai!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Niinak yaitskek idaisashtinaitjai.","poem":1},{"lineBreak":true},{"text":"Mina senchigjai senchimtikatnaitjai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Niina shiwaaji aidaush jetekchagtin ainawai,","poem":1},{"lineBreak":true},{"text":"tuja aents pegkegchau aidaushkam","poem":1},{"lineBreak":true},{"text":"depetkachagtin ainawai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Niina shiwaaji aidaunak","poem":1},{"lineBreak":true},{"text":"niish wainaig ijinatnaitjai,","poem":1},{"lineBreak":true},{"text":"tuja niina kajejuidaunash ijinatnaitjai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wi niina aneamua duka tuke atinai,","poem":1},{"lineBreak":true},{"text":"wi kuitamsam kuashat kaweg","poem":1},{"lineBreak":true},{"text":"senchigtin wajastinai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuja niig nayants Mediterraneo tutaya","poem":1},{"lineBreak":true},{"text":"nuwi nagkamas namak","poem":1},{"lineBreak":true},{"text":"Eufratesa aatus inamjatnai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tuja nii chichagtak:","poem":1},{"lineBreak":true},{"text":"‘Ametme mina apag kuitamjaumek;","poem":1},{"lineBreak":true},{"text":"tuja ametme mina Apajuíg uwemtijinmek’, tujuttinai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tuja wi niinak mina uchig iwai,","poem":1},{"lineBreak":true},{"text":"ashí tikich apu aidaunash","poem":1},{"lineBreak":true},{"text":"nagkaesau apu emattajai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wika niinak tuke anetnaitjai,","poem":1},{"lineBreak":true},{"text":"tuja wi niijai chichaman umikuitag","poem":1},{"lineBreak":true},{"text":"dushakam tuke atinai.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nayaim awa nunisag aigkik,","poem":1},{"lineBreak":true},{"text":"niina uchiji wegantu aidaunmayag","poem":1},{"lineBreak":true},{"text":"tuke apu wegagtin ainawai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Untsu dita chicham umiktinun","poem":1},{"lineBreak":true},{"text":"wi jintintuau ainag nuna","poem":1},{"lineBreak":true},{"text":"kajimatkiag batsamas,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"nunú chichaman uminachkuig,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"dita pegkegchaujin","poem":1},{"lineBreak":true},{"text":"suwimak ishamainun susatnaitjai.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Untsu Davidnak tuke anetnaitjai,","poem":1},{"lineBreak":true},{"text":"tuja wi niina anagkuawaitag nunashkam","poem":1},{"lineBreak":true},{"text":"umitskek idaisashtinaitjai.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Wi niijai chichaman umikuitag nunak","poem":1},{"lineBreak":true},{"text":"tuke idaisashtinaitjai,","poem":1},{"lineBreak":true},{"text":"nunak tuke umiktinaitjai.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Makichik tsawantai","poem":1},{"lineBreak":true},{"text":"wi Davitan anagkuawaitag nunak","poem":1},{"lineBreak":true},{"text":"dekas umiktatjai tusan tumamjai.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Etsa eketa nunisag eketaigkik,","poem":1},{"lineBreak":true},{"text":"niina uchiji wegantu aidauk","poem":1},{"lineBreak":true},{"text":"tuke apu wegagtin ainawai.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"¡Nii wegantu aidauk,","poem":1},{"lineBreak":true},{"text":"nantu tuke ekemna iman atinai!","poem":1},{"lineBreak":true},{"text":"¡Nii pujusa inamtaijishkam nayaim tuke auwa iman atinai!” tiuwaitme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Tusa tiuwaitkum ame apu etegkamu aig,","poem":1},{"lineBreak":true},{"text":"kajegkam dakitja idaisaume.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Dutikau asam niijai chicham umikuitam duka","poem":1},{"lineBreak":true},{"text":"umitsuk, David kajimatkim idaisaume.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Tuja yaakat Jerusalén peejamua dushakam","poem":1},{"lineBreak":true},{"text":"yumpua tsaikam ayamjumamainchau","poem":1},{"lineBreak":true},{"text":"emam idaisaume.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ashí aents nuni nagkaemaidauk","poem":1},{"lineBreak":true},{"text":"wayawag dita wakegamun kasamainawai,","poem":1},{"lineBreak":true},{"text":"tuja aents dita nugkega nuna yantamen","poem":1},{"lineBreak":true},{"text":"batsamin aidau dushikinawai.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Nuadui Davita shiwaaji aidauk shiig anenawai,","poem":1},{"lineBreak":true},{"text":"wagki dita ima senchijinawaju asag.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Niina maanitaiji puyagshakam atankiume;","poem":1},{"lineBreak":true},{"text":"dutikau asam maaniakuish yaigchaume.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Eme anentai aajakua duka","poem":1},{"lineBreak":true},{"text":"wainkauch idaisaume;","poem":1},{"lineBreak":true},{"text":"dutikakum apu wajasa inamtaijishkam","poem":1},{"lineBreak":true},{"text":"tikima wainkauch awajtusume.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Tuja nuigtush kuashat mijan","poem":1},{"lineBreak":true},{"text":"pujuschati tusam atankiume,","poem":1},{"lineBreak":true},{"text":"dutikakum datsa datsantak awajsaume.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Chah, Tuke Pujuuwah,","poem":1},{"lineBreak":true},{"text":"¿uumjutkamek pujuttam?","poem":1},{"lineBreak":true},{"text":"¿Kajegtukbaukek pujuttam?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Apuh, mina pujutug piipichia nunú adeagta;","poem":1},{"lineBreak":true},{"text":"ame aents najanamua duka","poem":1},{"lineBreak":true},{"text":"ujumak tsawantak pujus jauwai.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"¡Makichik aentsuk jatsukek iwakuk pujumaitsui!","poem":1},{"lineBreak":true},{"text":"¡Tuja jakashtajai tusa,","poem":1},{"lineBreak":true},{"text":"jata uwemtumainchakam makichkish atsawai!","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Apuh, ¿ame yama nagkamchakum:","poem":1},{"lineBreak":true},{"text":"Davita tuke anetnaitjame tusam","poem":1},{"lineBreak":true},{"text":"tiuwaitam dusha wajukame?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Apuh, iinak kuashat dushiktamainawai,","poem":1},{"lineBreak":true},{"text":"imatika dushiktamainakuish atsaneaji.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Tuke Pujuuwah, amina shiwaajum aidau","poem":1},{"lineBreak":true},{"text":"¡aatus iina pegkegchaun chichagtamainawai!","poem":1},{"lineBreak":true},{"text":"¡Aatus ame apu etegkamua nuna","poem":1},{"lineBreak":true},{"text":"aju ajumag pegkegchaun chichajuinawai!","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"¡Tuke Pujuuk, tuke pegkegnum chichagtai atin ati!","poem":1},{"lineBreak":true},{"text":"Maake, aatus ati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":48}