{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":90,"content":[{"type":"heading","content":["Aentsuk Apajuí tuke pujuuwa nuninchauwai"]},{"type":"hebrew_subtitle","content":["Moisés Apajuí etegkamu aajakua nunú Apajuín ausamu"]},{"type":"verse","number":1,"content":[{"text":"Apuh, amek yaunchuk nagkamsam","poem":1},{"lineBreak":true},{"text":"jutiik tuké yaijatnaitme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuja muja aidaush najaneatsaig, nugkashkam najaneatsaig,","poem":1},{"lineBreak":true},{"text":"yaunchuk nagkamsam,","poem":1},{"lineBreak":true},{"text":"yamaya juish, tuja atakea duishkam","poem":1},{"lineBreak":true},{"text":"ameketme Apajuímek.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amina chichamjuminig","poem":1},{"lineBreak":true},{"text":"aents aidauk jakag nugka najanenawai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ame diismak mil mijana duka","poem":1},{"lineBreak":true},{"text":"makichik tsawan nagkaema nuninai;","poem":1},{"lineBreak":true},{"text":"tuja mil mijana duka","poem":1},{"lineBreak":true},{"text":"kiyag tsawak megkagama","poem":1},{"lineBreak":true},{"text":"numamtuk nagkaemawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amek namak chichigmajai betek","poem":1},{"lineBreak":true},{"text":"aents aidauk utsame,","poem":1},{"lineBreak":true},{"text":"tuja iina pujutjig kajanum kajamja","poem":1},{"lineBreak":true},{"text":"shintaku ukutiama nujai betekai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aents aidauk dupajai betek ainawai,","poem":1},{"lineBreak":true},{"text":"dupa kashikmas yagkujuk,","poem":1},{"lineBreak":true},{"text":"etsa akagai kagaka","poem":1},{"lineBreak":true},{"text":"jinuwama numamtuk wajaji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ame kajekbaugmin amujatme,","poem":1},{"lineBreak":true},{"text":"tuja ame kajekamin ishamka","poem":1},{"lineBreak":true},{"text":"imaanjaujai betek pujaji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iina tudauji pegkegchauwa duka","poem":1},{"lineBreak":true},{"text":"ame shiig dekame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Ame kajegkagtukaminig","poem":1},{"lineBreak":true},{"text":"ii iwaku batsatag duka,","poem":1},{"lineBreak":true},{"text":"mayai mayati ajaptayama","poem":1},{"lineBreak":true},{"text":"numamtuk jaka megkaemainaitji!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iik ayatak setenta mijan pujusa jainaji,","poem":1},{"lineBreak":true},{"text":"tuja nuni wajiu aidau ochenta mijan jegainawai;","poem":1},{"lineBreak":true},{"text":"tujash imaan mijan pujakuish,","poem":1},{"lineBreak":true},{"text":"ima waitiamua duke utugchatjai igkunui.","poem":1},{"lineBreak":true},{"text":"¡Mijanak jutii pujutjijai betek","poem":1},{"lineBreak":true},{"text":"wamak nagkaemawai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ame senchi kajeamugminash","poem":1},{"lineBreak":true},{"text":"¿ya dekamainaita?","poem":1},{"lineBreak":true},{"text":"Ame kajekbaujum ishamaina nunash","poem":1},{"lineBreak":true},{"text":"¿yaki dekamainaita?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Iik tuke jakatnapitji tusa,","poem":1},{"lineBreak":true},{"text":"shiig dekau ata nunú jintinkagtuata!","poem":1},{"lineBreak":true},{"text":"¡Nunú dekau asaja,","poem":1},{"lineBreak":true},{"text":"pegkegnum pujuta nunú puyatjukagmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Tuke Pujuuwah, ataktu yaijatkata!","poem":1},{"lineBreak":true},{"text":"¿Wajupa asamea yaijatkattame?","poem":1},{"lineBreak":true},{"text":"¡Juju amina inakem aina nunú wait anenjata!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kashikmasa nagkamsam","poem":1},{"lineBreak":true},{"text":"amina anenkagmea nunú sukagtusta,","poem":1},{"lineBreak":true},{"text":"dutikagtuawaminig ashí tsawantai,","poem":1},{"lineBreak":true},{"text":"shiig aneasa tuké kantamtinaitji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kuashat mijanai waitujakuitag","poem":1},{"lineBreak":true},{"text":"imatiksamek shiig aneasa pujut sukagtusta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Juju amina inakem aina nunú","poem":1},{"lineBreak":true},{"text":"dita wegantu aidaujai amina imanjumin","poem":1},{"lineBreak":true},{"text":"senchigmejai wainkatnume tusam iwaintukta!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Iina Apajuíji Tuke Pujuuwa","poem":1},{"lineBreak":true},{"text":"nuna wait anenkagtutaijig jutinii asati!","poem":1},{"lineBreak":true},{"text":"¡Apajuíjuh, iina takatjish pegkegnum yumigsata!","poem":1},{"lineBreak":true},{"text":"¡Ehe, dekas iina takatjig pegkegnum yumigsata!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}