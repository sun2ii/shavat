{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":91,"content":[{"type":"heading","content":["Apajuíyai iina kuitamjamnuk"]},{"type":"verse","number":1,"content":[{"text":"Apajuí múun, ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"kuitamsam pujauk,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuke Pujuun chichajak: “Ametme","poem":1},{"lineBreak":true},{"text":"mina ejamataijuk,","poem":1},{"lineBreak":true},{"text":"wi uumka ayamjumataig.","poem":1},{"lineBreak":true},{"text":"¡Ametme mina Apajuíg,","poem":1},{"lineBreak":true},{"text":"ima aminig kajintsan anentaimjai!” tawai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wakan pegkegchau","poem":1},{"lineBreak":true},{"text":"utugchatan apujtugmataish,","poem":1},{"lineBreak":true},{"text":"tuja jata aidaunmashkam","poem":1},{"lineBreak":true},{"text":"ima nigki ayamjutpamainai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wagki niig atash niina nanapen uchuchiji aidaun","poem":1},{"lineBreak":true},{"text":"dukuka kuitamama numamtuk kuitamjamnai,","poem":1},{"lineBreak":true},{"text":"nuadui amek puyattsuk","poem":1},{"lineBreak":true},{"text":"shiig aneasam pujustinaitme.","poem":1},{"lineBreak":true},{"text":"¡Niina anenkega duwi","poem":1},{"lineBreak":true},{"text":"aminak tantag ejamatia numamtuk","poem":1},{"lineBreak":true},{"text":"ejapak kuitamjamkattawai!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuadui kashi ishamainnum pujakmesh,","poem":1},{"lineBreak":true},{"text":"tuja tsawai wekaekumesh,","poem":1},{"lineBreak":true},{"text":"mantuachagtimpash tusamek ishamkaipa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuja jata kashi magkagtin,","poem":1},{"lineBreak":true},{"text":"tsawai magkagtinkesh iyanjugmatai,","poem":1},{"lineBreak":true},{"text":"jakashtajash tusamek ishamkaipa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amina menagmea nuni mil aents jinitnai,","poem":1},{"lineBreak":true},{"text":"tuja untsugmea nunishkam","poem":1},{"lineBreak":true},{"text":"diez mil aents jinitnai,","poem":1},{"lineBreak":true},{"text":"tujash amek makichkish wajukashtinaitme.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Untsu aents pegkegchau aidaun Apajuí suwimak susam jinuidau waintinaitme,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"wagki aminak Tuke Pujuu múun,","poem":1},{"lineBreak":true},{"text":"ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"ejapak kuitamjamu asamtai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aminak makichik pegkegchaukesh","poem":1},{"lineBreak":true},{"text":"waitkagmaschatnai,","poem":1},{"lineBreak":true},{"text":"tuja jatashkam amina jeminig utugmashtinai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wagki Apajuí ángel aidaun ishiaktatui","poem":1},{"lineBreak":true},{"text":"ame tuwi wekaetatme nuwi kuitamjamkatnun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nunú ángel aidau achigmaku agtatui,","poem":1},{"lineBreak":true},{"text":"kaya tukumak iyajai tusa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuadui, ikamyawa yukagtin aidau,","poem":1},{"lineBreak":true},{"text":"tuja tikich kuntin ishamain ayaunum","poem":1},{"lineBreak":true},{"text":"wekaekumesh, uyumat aneakas wekaetatme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Apajuí chichaak:","poem":1},{"lineBreak":true},{"text":"“Juju aentsuk mina waitui,","poem":1},{"lineBreak":true},{"text":"anentanash anentui, nuniau asamtai","poem":1},{"lineBreak":true},{"text":"wi niinak ayamjukan uwemtikjattajai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuja yainkati tusa mina segatkuishkam,","poem":1},{"lineBreak":true},{"text":"aiktinaitjai, dutikakun ¡niijaig pujutnaitjai!","poem":1},{"lineBreak":true},{"text":"¡Tuja waitiakuishkam agkanmitkatnaitjai!","poem":1},{"lineBreak":true},{"text":"¡Dutikakun eme anentsa diitai awajsatnaitjai!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tuja kuashat mijan","poem":1},{"lineBreak":true},{"text":"shiig pujustin ati titinaitjai.","poem":1},{"lineBreak":true},{"text":"¡Dutikakun pujut nagkanchau tuke atina nuwi pujus","poem":1},{"lineBreak":true},{"text":"dakujusti tusan jukitnaitjai!” tawai Apajuí.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}