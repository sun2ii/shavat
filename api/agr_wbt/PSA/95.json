{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":95,"content":[{"type":"heading","content":["Apajuí shiig anentsa kantamjuawagmi"]},{"type":"verse","number":1,"content":[{"text":"Kaunatajum,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, iina kuitamjamak","poem":1},{"lineBreak":true},{"text":"uwemtijamna nunú","poem":1},{"lineBreak":true},{"text":"shiig aneasa kantamjuawagmi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nii pujamunum wayawaja","poem":1},{"lineBreak":true},{"text":"nii emematku kantamtai kantamjuawagmi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuwai dekas múun senchigtin,","poem":1},{"lineBreak":true},{"text":"ashí tikich apajuímtai aina nunashkam Apujiyai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nugkak initken nagkamas","poem":1},{"lineBreak":true},{"text":"ashí Apajuí emetuam awai,","poem":1},{"lineBreak":true},{"text":"tuja muja tsakaju aidaushkam niinu ainawai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuja nayantsashkam","poem":1},{"lineBreak":true},{"text":"nii najanamu asa ima niinuke.","poem":1},{"lineBreak":true},{"text":"¡Nugkanashkam nigki najanauwai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Minitajum,","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu, iina najapauwa nunú","poem":1},{"lineBreak":true},{"text":"tikishmatja emematiagmi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niyai iina Apajuíjig,","poem":1},{"lineBreak":true},{"text":"tuja iik niina aentsji ainaji,","poem":1},{"lineBreak":true},{"text":"nuadui uwija kuitamin","poem":1},{"lineBreak":true},{"text":"niina uwigjin kuitamama numamtuk","poem":1},{"lineBreak":true},{"text":"iinash kuitamjamui.","poem":1},{"lineBreak":true},{"text":"Apajuí yamai atumin tujama","poem":1},{"lineBreak":true},{"text":"nunú antuktajum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Yaunchuk Meribánum,","poem":1},{"lineBreak":true},{"text":"tuja uwejush Masánmashkam","poem":1},{"lineBreak":true},{"text":"Apajuí chichamen intimjukiu aina","poem":1},{"lineBreak":true},{"text":"numamtuk wajakaigpajum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Atumin muunjum aajaku aina duka","poem":1},{"lineBreak":true},{"text":"kuashat wainchatai aidaun","poem":1},{"lineBreak":true},{"text":"wi iwainamun wainainayatak,","poem":1},{"lineBreak":true},{"text":"dekaskechua nunin diisu ainawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuadui nunú aents aidaun","poem":1},{"lineBreak":true},{"text":"dakitjan cuarenta mijan pujubiajai,","poem":1},{"lineBreak":true},{"text":"nuniakun: ‘Juju aents aidauk","poem":1},{"lineBreak":true},{"text":"shiig wainak yujawai; núnidau asag","poem":1},{"lineBreak":true},{"text":"mina chichamjunak umigtuinatsui’.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuadui kajekan,","poem":1},{"lineBreak":true},{"text":"chicham yapajiashtinun chichaakun:","poem":1},{"lineBreak":true},{"text":"‘Dita shiig batsamsatnun nugka pegkejan","poem":1},{"lineBreak":true},{"text":"wi ditan anagkuawaitag","poem":1},{"lineBreak":true},{"text":"nuwig ditak jegashtin atinme’ tiabiajai”,","poem":1},{"lineBreak":true},{"text":"tiuwai Apajuí.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":11}