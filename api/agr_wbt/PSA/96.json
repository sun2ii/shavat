{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"PSA","translationId":"agr_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":57,"sha256":"102a2a19401f0af8720a15324c7edd971d3b25bb8da18091f6b24de146b1a44a","firstChapterNumber":1,"firstChapterApiLink":"/api/agr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agr_wbt/PSA/150.json","totalNumberOfVerses":938},"chapter":{"number":96,"content":[{"type":"heading","content":["Yamajam kantamtai ii apuji kantamjamu"]},{"type":"verse","number":1,"content":[{"text":"Ashí nugkanmaya aents aidautijum","poem":1},{"lineBreak":true},{"text":"yamajam kantamtai","poem":1},{"lineBreak":true},{"text":"Tuke Pujuu kantamjuatajum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuke Pujuu kantamjakjum,","poem":1},{"lineBreak":true},{"text":"niina daaji pegkegnum chichagtajum.","poem":1},{"lineBreak":true},{"text":"Tuja Apajuíyai uwemtikagtinuk tusajum","poem":1},{"lineBreak":true},{"text":"kashi kashinig etsegtajum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apajuí imanjiya nunú,","poem":1},{"lineBreak":true},{"text":"niina pegkegmajijai pachisjum","poem":1},{"lineBreak":true},{"text":"ashí nugka múun aidaunum etsegkatajum.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wagki Tuke Pujuuwai dekas múuntak,","poem":1},{"lineBreak":true},{"text":"ima nigki eme anentsa kantamjam amainuk.","poem":1},{"lineBreak":true},{"text":"Niyai tikich apajuímtai aina","poem":1},{"lineBreak":true},{"text":"nuna nagkaesau ishamain.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tikich aents aidaun apajuímtaiji aina duka","poem":1},{"lineBreak":true},{"text":"wainak ainawai;","poem":1},{"lineBreak":true},{"text":"tuja Tuke Pujuuwai nayaimpin najanauk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Apajuín tsaaptinjiya duka jiin utsumakui!","poem":1},{"lineBreak":true},{"text":"¡Nii pujamujiya nuwig niina senchiji,","poem":1},{"lineBreak":true},{"text":"pegkegmajiya nujai awai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ashí nugkanmaya aidautijum:","poem":1},{"lineBreak":true},{"text":"“Ameketme senchigtinum,","poem":1},{"lineBreak":true},{"text":"ameketme pegkegmamek”,","poem":1},{"lineBreak":true},{"text":"tusajum Tuke Pujuu ememattajum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuke Pujuu anentag susatin jukijum,","poem":1},{"lineBreak":true},{"text":"nii jega nuna agájin ikaunmajum,","poem":1},{"lineBreak":true},{"text":"tikishmaja pujusjum Apajuí etsagjatajum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apajuí jee pegkegma nuwi","poem":1},{"lineBreak":true},{"text":"wayajum etsagjatajum.","poem":1},{"lineBreak":true},{"text":"¡Ashí nugkanmaya aidauk","poem":1},{"lineBreak":true},{"text":"amina ishamjamainak kujaitnume!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ashí aents nugkanmaya aidau chichagkujum:","poem":1},{"lineBreak":true},{"text":"“¡Tuke Pujuuwai iina apujiya duka!","poem":1},{"lineBreak":true},{"text":"Nugkanak jasa buchittsuk asatnun nii najanauwai,","poem":1},{"lineBreak":true},{"text":"tuja ashí aents aidaunak","poem":1},{"lineBreak":true},{"text":"nii inak betek diyakui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Nayaim aidaush, tuja nugkashkam","poem":1},{"lineBreak":true},{"text":"shiig aneastinme!","poem":1},{"lineBreak":true},{"text":"¡Tuja nayantsashkam,","poem":1},{"lineBreak":true},{"text":"tikich namak múun aidaujai","poem":1},{"lineBreak":true},{"text":"shiig aneenak uuttinme!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Tuja nugkashkam,","poem":1},{"lineBreak":true},{"text":"nunú nugkanum batsamin aidaujaí","poem":1},{"lineBreak":true},{"text":"shiig aneastinme!","poem":1},{"lineBreak":true},{"text":"¡Tuja numi ikam ayaushkam shiig aneenak,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"juju nugka juwi inamjatin","poem":1},{"lineBreak":true},{"text":"mina nuna emtin pampaitnume!","poem":1},{"lineBreak":true},{"text":"¡Tuke Pujuu dekas","poem":1},{"lineBreak":true},{"text":"iina nugken inamjatatus taattawai!","poem":1},{"lineBreak":true},{"text":"Nunik taa aents aidau takasbaujin","poem":1},{"lineBreak":true},{"text":"diijus etegjattawai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}