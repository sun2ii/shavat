{"translation":{"id":"agr_wbt","name":"Awajún [Aguaruna]","website":"https://ebible.org/Scriptures/details.php?id=agr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=agr","licenseNotes":null,"shortName":"WBT","englishName":"Aguaruna Bible","language":"agr","textDirection":"ltr","sha256":"191a605bef3edc10375296088f3d3898ebf9ae1582ba4cd747a67ebc4791e7aa","availableFormats":["json"],"listOfBooksApiLink":"/api/agr_wbt/books.json","numberOfBooks":57,"totalNumberOfChapters":670,"totalNumberOfVerses":16956,"languageName":"Aguaruna","languageEnglishName":"Aguaruna"},"book":{"id":"ZEC","translationId":"agr_wbt","name":"Zacarías","commonName":"Zacarías","title":"Zacarías","order":38,"numberOfChapters":2,"sha256":"56eeaff0e6db4198ed286c0c781fa74d24fdae245d79f5029b132f49e1e40d78","firstChapterNumber":9,"firstChapterApiLink":"/api/agr_wbt/ZEC/9.json","lastChapterNumber":10,"lastChapterApiLink":"/api/agr_wbt/ZEC/10.json","totalNumberOfVerses":9},"chapter":{"number":9,"content":[{"type":"heading","content":["Israel aents aidaun apuji atin pachisa etsegkamu"]},{"type":"verse","number":9,"content":["¡Yaakat Jerusalégnumia aidautigmek shiig aneastajum!",{"text":"¡Shiig aneakjum kantamatajum!","poem":1},{"lineBreak":true},{"text":"¡Amina apujum burro tsakatnum entsatkau minitjamui!","poem":1},{"lineBreak":true},{"text":"Imanchauch wajakin, pegkejam, pegkegchaun takachu,","poem":1},{"lineBreak":true},{"text":"amina yaimpak depetmitkagmaktatus minawai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Efraín wegantu aidaun carroji aidaunak,","poem":1},{"lineBreak":true},{"text":"flecha akenka nagkimtai aidaujai ashí tsaiktatui,","poem":1},{"lineBreak":true},{"text":"dutikak Jerusalégnumia caballo aidaunashkam ijinattawai.","poem":1},{"lineBreak":true},{"text":"Israel nugkanmak ashí depetmaktatui,","poem":1},{"lineBreak":true},{"text":"nunik ashí tikich aents aidaush agkan batsamsatnume titatui.","poem":1},{"lineBreak":true},{"text":"Tuja niig nayants jinagbau aina imanui nagkamas,","poem":1},{"lineBreak":true},{"text":"namak Eufratesa aatus ashí nugkanum inamjatnai,","poem":1},{"lineBreak":true},{"text":"nii inabaujig nagkatkauk achatnai.","poem":1}]},{"type":"heading","content":["Apajuí niina aentsji aidaun yainka ataktu inantaitin"]},{"type":"verse","number":11,"content":["Tuke Pujuu chichaak:",{"text":"“Jerusalégkah, wi amejai numpai chichaman","poem":1},{"lineBreak":true},{"text":"umikuitag nuna betek umiakun,","poem":1},{"lineBreak":true},{"text":"yumigmat taimu yumi atsaig ashí","poem":1},{"lineBreak":true},{"text":"jinaajum chimpigjum nunak jiijan uwemtijattajime.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Achija yajuakam tikich nugkanum batsatutigmek","poem":1},{"lineBreak":true},{"text":"yaakat shiig peeja umikbauwa nuwi waketjattagme.","poem":1},{"lineBreak":true},{"text":"Yamaik atum waitiajum nuna nagkaesau,","poem":1},{"lineBreak":true},{"text":"pegkegnum yumigsattajime,","poem":1},{"lineBreak":true},{"text":"nuadui shiig aneasjum batsamsattajume.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Judá wegantu aidauk arcojai betek,","poem":1},{"lineBreak":true},{"text":"tuja Israel wegantu aidauk flechajai betek,","poem":1},{"lineBreak":true},{"text":"tuja Jerusalégnak puyagjai betek awajsattajai,","poem":1},{"lineBreak":true},{"text":"dutikan ditajai griego aents aidaunak ijinattajai”, tawai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuke Pujuu ditan jetektajum tusa titata nunak,","poem":1},{"lineBreak":true},{"text":"dita nagki akenbaujig peemjai betek agtinai,","poem":1},{"lineBreak":true},{"text":"Apajuí kachun umpuag tsumujinia dasenum pachitkau wetinai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuke Pujuu ashí senchigtina nunú","poem":1},{"lineBreak":true},{"text":"niina aentsji aidaunak kuitamkatnai,","poem":1},{"lineBreak":true},{"text":"dutikamu asag dita shiwaaji aidaunak depetuk","poem":1},{"lineBreak":true},{"text":"najakag ashí amukagtinai.","poem":1},{"lineBreak":true},{"text":"Aatus depetmakaju asag, shiig aneenak","poem":1},{"lineBreak":true},{"text":"altar ukatkatasa numpa tsapanum aimka jutaya","poem":1},{"lineBreak":true},{"text":"imatika aimak vinon umuinak nampejag shiig aneenak pampainiagtinai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nunú tsawan jegakuig, mina aentsug aidaunak,","poem":1},{"lineBreak":true},{"text":"uwija kuitamin uwigjin ayamjina numamtuk","poem":1},{"lineBreak":true},{"text":"wi ayamjukan uwemtikjatnaitjai,","poem":1},{"lineBreak":true},{"text":"dutika ai dita nugken waketug batsamsag","poem":1},{"lineBreak":true},{"text":"kaya pegkeg winchamtin juki atsejutai najanamu winchantuwama iman agtinai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Yajauwajah, nuwauch aidau,","poem":1},{"lineBreak":true},{"text":"uchi datsauch aidau shiig yuwawag senchigtin","poem":1},{"lineBreak":true},{"text":"shiig aneas dakunkut juju nugkanum batsatbau!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agr_wbt/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agr_wbt/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agr_wbt/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}