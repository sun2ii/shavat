{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":1,"content":[{"type":"heading","content":["Yi e' yi at banl Kataj squibaj"]},{"type":"verse","number":1,"content":[{"text":"Ba'n cyeri e' yi qui na chixom te cyajtza'kl yi e' mal nak,","poem":1},{"noteId":0},{"text":"yi qui na chixcye' cu'n tan xtxumle'n cyajtza'kl yi e' juchul il,","poem":2},{"lineBreak":true},{"text":"yi qui na chic'ole' ẍchixo'l yi e' yi na el k'ej Ryos cya'n.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma na cho'n ajlij chic'u'l te yi ca'wl Kataj yi kaRyosil.","poem":1},{"lineBreak":true},{"text":"Nin sk'ejl tu lak'bal na chitzan cyera'tz tan xtxumle'n yi e'chk ca'wla'tz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yi e'a'tz, ni'cu'n tzun quitane'n chi jun wi' tze' yi awij stzi' a'.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Yi jun tze'a'tz na tak' wutz yi na opon tiempil.","poem":1},{"lineBreak":true},{"text":"Nin qui'c jun k'ej najk num yi xak.","poem":1},{"lineBreak":true},{"text":"Ni'cu'n tzun quitane'n cyakil yi e' balaj wunaka'tz, na na wutzin cyakil yi na chiban.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma yi e' wunak yi cachi' cyajtza'kl, cho'n quitane'n cyetz chi tane'n xak xtze',","poem":1},{"noteId":2},{"text":"yi na ben tan cyek'ek'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cha'stzun te yil tz'oc Ryos tan ma'le'n cyajtza'kl yi e'a's, quil chinimsaj chic'u'l tan chicolol quib, na quibe' tajlal yi e' balaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yi e' balaj nak, q'uicy'le'n che' tan Ryos.","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Ma yi e' mal nak, ẍchisotzok cyera'tz.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sal 34:14.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Job 29:19; Jer 17:7-8.","reference":{"chapter":1,"verse":3}},{"noteId":2,"caller":"+","text":"Job 21:18; Jer 13:24; Os 13:3.","reference":{"chapter":1,"verse":4}},{"noteId":3,"caller":"+","text":"Pr 4:18-19; Nah 1:7; Mt 7:13-14.","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/agu_nvs/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/EST/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}