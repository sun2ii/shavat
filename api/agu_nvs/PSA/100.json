{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":100,"content":[{"type":"heading","content":["Katyoẍink tetz Kataj na i' bnol ketz"]},{"type":"verse","number":1,"content":[{"text":"Yi e'u' yi ate'u' bene'n tzi'n wi munt cyak'e'u' chik'ajsbilu' tetz Kataj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tzatzin cu'n chibne'u' chimunlu' swutz i'. Tzatzin cu'n chibitzinu' swutz tan tak'le'n k'ej i'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eli'ch te chic'u'lu' yi Kataj i' kaRyosil. I' bnol ketz.","poem":1},{"lineBreak":true},{"text":"Ej nin o' tetz, o' tanum i'. Ni'cu'n chi o'-k cneru' yi na chiwan le tetz cojbil.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yi na cho'cu' le puertil yi tetz ca'l ba'n chityoẍinu' tetz.","poem":1},{"lineBreak":true},{"text":"Nin yi na cho'cu' wutzk'anil yi tetz ca'l tan tak'le'n chik'ajsbilu' swutz i', chityoẍinku' tetz, nin cyak'e'u' k'ej yi tetz bi'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na chumbalaj nin i'. Quinin bajsbe'n tetz yi banl talma' i'. Nin ba'n k'uke' kac'u'l te'j sbne' opon tunintz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}