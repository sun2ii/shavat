{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":113,"content":[{"type":"heading","content":["K'ajsbil tetz Kajcaw"]},{"type":"verse","number":1,"content":[{"text":"Kak'e' kak'ajsbil tetz Kajcaw yi o' ẍchakum i'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kak'e' k'ej yi tetz bi' jalu' nin sbne' opon tunintz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cyak'e'u' chik'ajsbilu' tetz yi e'u' yi ate'u' tele'n tzi'n nin toque'n tzi'n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na i' ajcaw tibaj cyakil e'chk nación.","poem":1},{"lineBreak":true},{"text":"Chin wutzile'n nin yi tetz k'ej.","poem":1},{"lineBreak":true},{"text":"Nin qui'c stzajsbil wi'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cya'l jun yi cho'n nink chi tane'n i', na cho'n najlij i' jalen tzi'n tcya'j.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nin na c'o'e' tzaj i' tan xmaye'n yi tcya'j tu yi wuxtx'otx'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yi e' yi qui'c ate' cu'nt, na chije' tzaj ta'n tc'u'l me'ba'il.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ncha'tz na tak' i' ama'l scyetz tan chic'olewe'n chixlaj yi e' wi'tz ajcaw, yi cyajcawil yi tetz tanum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na tak' chik'ej yi e' xna'n yi qui'c cyalbil.","poem":1},{"lineBreak":true},{"text":"Na yi na el tiemp na jal cyal tan yi tetz porer.","poem":1},{"lineBreak":true},{"text":"Nin na chitzatzin le cyetz chinajbil.","poem":1},{"lineBreak":true},{"text":"Kak'e' bin kak'ajsbil tetz i'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}