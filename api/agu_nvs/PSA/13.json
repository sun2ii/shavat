{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":13,"content":[{"type":"heading","content":["Jakle'n ẍch'eybil ketz tetz Ryos"]},{"type":"verse","number":1,"content":[{"text":"Wajcaw ¿tona' nin nu'l tx'akx tc'u'lu'?","poem":1},{"lineBreak":true},{"text":"¿Junawes pe' ja ne'l te c'u'lu'?","poem":1},{"lineBreak":true},{"text":"¿Tona' nin qui't tew tibu' tzinwutz?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ta' ¿tona' nin qui't chimbisun?","poem":1},{"lineBreak":true},{"text":"¿Tona' nin qui't tzintij q'uixc'uj?","poem":1},{"lineBreak":true},{"text":"¿Tona' nin qui't chicawun yi e' incontr swe'j?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wajcaw, ilu' inRyosil.","poem":1},{"lineBreak":true},{"text":"Elk k'ajabu' swe'j.","poem":1},{"lineBreak":true},{"text":"Tbite'u' inyol, ẍe'nk chintzatzin junt tir.","poem":1},{"lineBreak":true},{"text":"Na i waj yi quil chinquim chan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bantz quil cyal incontr: “Ja kaxcye' te'jx.”","poem":1},{"lineBreak":true},{"text":"Na kol chinquim, chitzatzink yi e' incontra'tz swe'j.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Poro yi in wetz cho'n nin k'uklij inc'u'l te yi banl talma'u'.","poem":1},{"lineBreak":true},{"text":"Nin yi walma' ilenin na tzatzin, na ilu' colol wetz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wajcaw, ilenin swak'e' ink'ajsbil teru'.","poem":1},{"lineBreak":true},{"text":"Na wi'nin banl talma'u' swibaj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}