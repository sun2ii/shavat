{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":130,"content":[{"type":"heading","content":["Ba'n k'uke' kac'u'l te Kajcaw"]},{"type":"verse","number":1,"content":[{"text":"Wajcaw, na cu' intzi' teru', na cho'n atin jalen tjul tane'n.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tbite'u' intzi' inkul, na na chinẍch'in tan jakle'n ẍch'eybil wetz teru'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wajcaw, yi nak ocu' tan xtxumle'n cyakil impaj, ja klo' wi't ne'l cu'n tanu' swutz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Poro qui'. Na list atite'tu' tan cuyle'n kapaj, bantz koque'nt c'ulutxum jak' ca'wlu'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cho'n k'uklij inc'u'l te'ju' Wajcaw.","poem":1},{"lineBreak":true},{"text":"Nin cho'n k'uklij inc'u'l te yi yolu'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cho'n k'uklij inc'u'l te'ju', na na chintzan tan ẍch'iwe'nu', chi na chiban yi e' q'uicy'lom tnum yi na cyal:","poem":1},{"text":"“Lok tz'ul chan skil, lok tz'ul chan skil,” che'ch.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cyakil o', yi o' xonl Israel, na katzan tan ẍch'iwe'n Kajcaw, na katzan tan ẍch'iwe'n yi banl talma' i', na tan i' na ke'le't liwr.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kelepon liwr yi o' xonl Israel.","poem":1},{"lineBreak":true},{"text":"Kelepon liwr tk'ab yi kil tan Kajcaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}