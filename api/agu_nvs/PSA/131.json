1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}