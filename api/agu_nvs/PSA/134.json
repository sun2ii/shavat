{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":134,"content":[{"type":"heading","content":["Kajcaw tz'ak'on banl squibaj"]},{"type":"verse","number":1,"content":[{"text":"E'u' ẍchakum Kajcaw, quiwit. Quil chik'e'xiju' tan tak'le'n chik'ajsbilu' swutz Kajcaw. Cyakil nin akale'n cyak'e'u' chik'ajsbilu' tetz, yi e'u' yi na chixconu' xe ca'l i'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ba'n cyak' ninu' chik'abu' kale atit yi ama'l yi chin xan nin tan tak'le'n k'ej i'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tak' tzaj bin Kajcaw, yi najlij wi Sión, yi banl talma' squibu'. Na yi ketz Kajcawa'tz i' bnol tetz yi tcya'j tu yi wuxtx'otx'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/134.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/133.json","previousChapterAudioLinks":{},"numberOfVerses":3}