{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":43,"content":[{"type":"heading","content":["Chin colpe'u' ẍchik'ab yi e' mal nak"]},{"type":"verse","number":1,"content":[{"text":"Siwl Ta', chin ma'laju' bantz tilolu' yi qui'c impaltil.","poem":1},{"lineBreak":true},{"text":"Xomok wi'u' swe'j, na qui'c wil.","poem":1},{"lineBreak":true},{"text":"Chin colpe'u' ẍchik'ab yi e' mal nak, yi e' yi chin la'j nin e'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na yi ilu' teru', ilu' inRyosil, ilu' colol wetz.","poem":1},{"lineBreak":true},{"text":"¿Mbi tzuntz yi nchincyaj tilolu'?","poem":1},{"lineBreak":true},{"text":"¿Mbi tzuntz yi na tak'u' ama'l tan imbisune'n?","poem":1},{"lineBreak":true},{"text":"¿Mbi tzuntz na tak'u' ama'l scyetz incontr tan imbuchle'n?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ẍchaje'u' yi bintzi swetz.","poem":1},{"lineBreak":true},{"text":"Ẍchaje'u' swetz bantz inxome'n te yi balaj be', yi na opon kale atit yi wi'wtz yi chin xan nin, kale najle'tu'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ko ya'tz tuleju', nocopon tzuntz swutz yi patbil katx'ixwatz.","poem":1},{"lineBreak":true},{"text":"Swak'e' ink'ajsbil swutzu' tan arpa.","poem":1},{"lineBreak":true},{"text":"Na ntin ilu' Ta', na ak'on tzatzin swetz.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cha'stzun te,","poem":1},{"lineBreak":true},{"text":"¿mbi xac tzincabej inc'u'l?","poem":1},{"lineBreak":true},{"text":"¿Mbi xac na chimbisun?","poem":1},{"lineBreak":true},{"text":"Ba'n tcu'n k'ukek inc'u'l te wetz inRyosil.","poem":1},{"lineBreak":true},{"text":"Swak'e' ink'ajsbil tetz.","poem":1},{"lineBreak":true},{"text":"Na i' inRyosil, nin i' yi colol wetz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}