{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":54,"content":[{"type":"heading","content":["List Kataj tan kacolche'n ẍchik'ab kacontr"]},{"type":"verse","number":1,"content":[{"text":"Wajcaw, ilu' inRyosil.","poem":1},{"lineBreak":true},{"text":"Chin cole'u' tan yi teru' ẍchamilu'.","poem":1},{"lineBreak":true},{"text":"Chin cole'u' tan yi teru' poreru'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na cu' inwutz teru' Ta', na ilu' inRyosil.","poem":1},{"lineBreak":true},{"text":"Tbite'u' intzi' inkul. Tbite'u' yi wajbil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na ja je' chimolol quib yi e' wunak yi na cyocsaj quib nim tu cyajtza'kl tan oyintzi' swe'j.","poem":1},{"lineBreak":true},{"text":"Nin yi cyajbil i'tz tan imbiyle'n cu'n.","poem":1},{"lineBreak":true},{"text":"Yi e'a's siquier nin najk cyek ẍchi'u'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Poro ilu' inRyosil. At ninu' tan wuch'eye'n.","poem":1},{"lineBreak":true},{"text":"Nin quil tak'u' ama'l scyetz tan imbiyle'n cu'n.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nin stk'e'u' chicaws yi e'a'tz.","poem":1},{"lineBreak":true},{"text":"Nin e' te'n chibaj tc'u'l yi e'chk takle'n yi ja baj chitxumul swe'j.","poem":1},{"lineBreak":true},{"text":"Wajcaw, che' xit cu'nu' yi e' incontra'tz, na ba'n k'uke' inc'u'l te'ju' yi list atitu' tan wuch'eye'n.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ej nin ko ya'tz, swak'e' intx'ixwatz teru'.","poem":1},{"lineBreak":true},{"text":"Nin swak'e' k'eju', na chumbalaj nin ilu'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na ja chinclax tanu' tk'ab cyakil yi e'chk sotzaj c'u'lal.","poem":1},{"lineBreak":true},{"text":"Nin ja che'l cu'n cyakil incontr tanu' swutz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}