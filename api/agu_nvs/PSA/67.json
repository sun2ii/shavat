},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ta', lok cyak' cyakil wunak chik'ajsbil teru'.","poem":1},{"lineBreak":true},{"text":"Lok cyak' chik'ajsbil tan tak'le'n k'eju'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yi cojbil, ja wi't tak' balaj cosech, na ja tak'u' yi banlu' skibaj, na ilu' kaRyosil.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ilu' kaRyosil, tak' tzaju' yi banlu' skibaj, bantz cyak'ol cyakil wunak yi k'eju'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}