{"translation":{"id":"agu_nvs","name":"Yi Antiw Bible / Yi Ac'aj Testament","website":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aguBl","licenseNotes":null,"shortName":"NVS","englishName":"Aguacateco Bible","language":"agu","textDirection":"ltr","sha256":"b8de56007a475d5d016027e9fe8ace6025248b67e46e16bd50a2015537c6dc29","availableFormats":["json"],"listOfBooksApiLink":"/api/agu_nvs/books.json","numberOfBooks":53,"totalNumberOfChapters":774,"totalNumberOfVerses":19943,"languageName":"Aguacateco","languageEnglishName":"Aguacateco"},"book":{"id":"PSA","translationId":"agu_nvs","name":"Salmos","commonName":"Salmos","title":"SALMOS","order":19,"numberOfChapters":150,"sha256":"5b2b68a1bfadbf4634238b8872c4ffc2368bd10d4ebc2e21e286a2992dc94e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/agu_nvs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/agu_nvs/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":70,"content":[{"type":"heading","content":["Ta', sajk chanu' tan wuch'eye'n"]},{"type":"verse","number":1,"content":[{"text":"Ilu' inRyosil, chincole'u'.","poem":1},{"lineBreak":true},{"text":"Sajkchanu' tan wuch'eye'n.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yi wajbil Ta' i'tz:","poem":1},{"lineBreak":true},{"text":"Yi nink tz'el chitx'ix yi e' yi na cyaj yil chinquim wetz.","poem":1},{"lineBreak":true},{"text":"Subcunu' yi chitxumu'n, na na cyaj yil chinlo'on.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lok che'l ojk yi e'a'tz yi na chitze'en swe'j.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Poro tak' tzaju' tzatzin scyetz cyakil yi e' yi na chitzan tan joyle'n puntil tan chixome'n te'ju'.","poem":1},{"lineBreak":true},{"text":"Nin yil cho'c tan joyle'n ẍch'eybil cyetz teru', nink cyal: “Chin cham nin yi Kataj.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma yi in wetz Ta', yi nternin na chimbisun, bne'u' pawor. Sajkchanu' tan wuch'eye'n.","poem":1},{"lineBreak":true},{"text":"Na ntin cu'n ilu' xcyeku' tan wuch'eye'n nin tan incolpe'n.","poem":1},{"lineBreak":true},{"text":"Qui'k ẍch'iwu' mas tiemp. Sajku' tan wuch'eye'n.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}