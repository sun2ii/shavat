' yi na cawunu' le ca'lu'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/agu_nvs/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/agu_nvs/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/agu_nvs/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}