{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"ܩܵܡܘܿܕܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܟܵܠܹܝܬ ܪܸܚܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܛܲܫܹܝܬ ܓܵܢܘܼܟ݂ ܒܥܕܵܢܵܬܹ̈‌ܐ ܕܥܵܘܩܵܢܵܐ؟","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܝܼܫܹ̈ܐ ܒܫܘܼܒ݂ܗܵܪܵܐ ܟܹܐ ܡܲܠܝܸܨܝܼ ܠܡܸܣܟܹܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܦܵܝܫܝܼ ܕܒ݂ܝܼܩܹܐ ܒܚܘܼܫܵܒܹ̈ܐ ܕܥܒ݂ܝܼܕ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܚܵܬܹܪ ܒܝܼܫܵܐ ܒܘܼܬ ܫܲܗܘܲܬܬܵ‌ܐ ܕܢܲܦ̮ܫܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܚܵܛܘܿܦܵܐ ܟܹܐ ܠܵܐܹܛ ܘܟܹܐ ܡܲܣܠܹܐ ܠܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܝܼܫܵܐ ܢܵܚܝܼܪܹܗ ܪܵܡܵܐ ܠܹܐ ܛܵܥܹܐ ܒܵܬܪܹܗ،","poem":1},{"lineBreak":true},{"text":"ܠܲܝܬ ܐܲܠܵܗܵܐ ܒܟܠܵܝܗ‌ܝ ܚܘܼܫܵܒ݂ܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܡܲܢܬܝܼܵܢܹ̈ܐ ܝܢܵܐ ܐܘܼܪ̈ܚܵܬܘܼܗ‌ܝ ܒܟܠܔ ܥܕܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܪ̈ܵܡܹܐ ܝܢܵܐ ܕܝܼܘܵܢܘܼ̈ܟ݂، ܥܸܠܸܠܔ ܡ̣ܢ ܚܙܵܝܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܓܲܫܸܩ ܒܥܲܝܢܵܐ ܕܡܲܣܠܲܝܬܵ‌ܐ ܠܟܠܵܝܗ‌ܝ ܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܹܗ ܒܠܸܒܹܗ: ”ܠܹܐ ܫܵܥܫܹܢ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܚܵܙܹܝܢ ܣܸܪܝܘܼܬܵ‌ܐ ܡ̣ܢ ܕܵܪܵܐ ܠܕܵܪܵܐ.“","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܦܘܼܡܹܗ ܡܸܠܝܵܐ ܝܠܹܗ ܠܵܘܛܬܵ‌ܐ ܘܦܸܠܡܹ̈ܐ ܘܓܸܙܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܬܚܘܿܬ ܠܸܫܵܢܹܗ ܡܲܠܝܲܨܬܵ‌ܐ ܘܥܵܘܠܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܝܵܬܹܒ݂ ܒܟܡܹܐܢܵܐ ܓܵܘ ܡܵܬܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܓܵܘ ܣܸܬܵܪܹ̈ܐ ܟܹܐ ܩܵܛܹܠܔ ܠܙܲܟܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܥܲܝܢܘܼ̈ܗ‌ܝ ܒܛܸܫܘܵܐ ܟܹܐ ܛܵܥܝܼ ܠܒܝܼܫܓܲܕܹ̈ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܝܵܬܹܒ݂ ܒܣܸܬܵܪܹ̈ܐ ܐܲܝܟ݂ ܐܲܪܝܵܐ ܒܓܘܼܒܹܗ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܝܵܬܹܒ݂ ܒܟܡܹܐܢܵܐ ܠܸܚܛܵܦܵܐ ܠܡܸܣܟܹܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܚܵܛܹܦ ܠܡܸܣܟܹܢܵܐ ܐܝܼܡܲܢ ܕܓܵܪܹܫ ܠܹܗ ܠܓܲܪܕܹܗ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܟܵܐܹܦ ܠܸܨܦܵܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܲܝܠܹܗ ܟܹܐ ܢܵܦܠܝܼ ܒܝܼܫܓܲܕܹ̈ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܹܗ ܒܠܸܒܹܗ: ”ܠܹܐ ܡܲܣܸܡ ܒܵܠܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܘܼܣܝܘܼܗ̇ ܝܠܹܗ ܦܵܬܹܗ، ܠܹܐ ܚܵܙܹܐ ܠܥܵܠܲܡ.“","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ، ܡܲܪܸܡ ܐܝܼܕܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܢܵܫܹܝܬ ܠܡܸܣܟܹܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܡܲܣܠܹܐ ܪܲܫܝܼܥܵܐ ܠܐܲܠܵܗܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܐܡܝܼܪܹܗ ܒܠܸܒܹܗ: ”ܠܹܐ ܚܲܫܒܸܢܵܗ̇ ܥܲܠܝܼ.“","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܚܸܙܝܵܐ ܠܘܼܟ݂ ܐܲܢ݇ܬ! ܟܹܐ ܚܵܝܪܹܬ ܠܥܵܘܩܵܢܵܐ ܘܠܚܲܫܵܐ، ܠܸܫܩܵܠܵܐ ܓܵܘ ܐܝܼܕܵܬܹ̈‌ܐ ܕܓܵܢܘܼܟ݂؛","poem":1},{"lineBreak":true},{"text":"ܥܲܠܘܼܟ݂ ܟܹܐ ܣܲܦܹܐ ܠܵܗ̇ ܓܵܢܹܗ ܒܝܼܫܓܲܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܝܲܬܘܼܡܵܐ ܐܲܢ݇ܬ ܟܹܐ ܗܵܘܹܝܬ ܗܲܝܸܪܵܢܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܬܵܒ݂ܪܹܬ ܕܪܲܥܢܵܐ ܕܪܲܫܝܼܥܵܐ ܘܕܒܝܼܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܬܲܥܠܡܸܬ ܠܒܝܼܫܬܹܗ ܗܲܠܔ ܕܠܵܐ ܡܲܫ݇ܟ̰ܚܸܬ ܠܵܗ̇ ܐܚܹܪܢܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܡܲܠܟܵܐ ܝܠܹܗ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ،","poem":1},{"lineBreak":true},{"text":"ܛܠܝܼܩ ܠܗܘܿܢ ܐܸܡܘܵܬܹ̈‌ܐ ܡ̣ܢ ܐܲܪܥܹܗ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܛܠܵܒܬܵ‌ܐ ܕܡܸܣܟܹܢܹ̈ܐ ܫܡܝܼܥ ܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܩܘܹܝܬ ܠܸܒܵܝܗ‌ܝ، ܒܸܬ ܨܲܠܹܝܬ ܢܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܠܸܥܒ݂ܵܕܵܐ ܕܝܼܘܵܢ ܕܝܲܬܘܼܡܵܐ ܘܡܘܼܠܝܸܨܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܐܢܵܫܵܐ ܕܡ̣ܢ ܐܲܪܥܵܐ ܠܵܐ ܡܲܙܝܸܕ ܐܚܹܪܢܵܐ ܠܡܲܙܕܘܼܥܹܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}