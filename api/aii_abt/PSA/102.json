ent":[{"lineBreak":true},{"text":"ܡ̣ܢ ܩܵܠܵܐ ܕܬܲܢܲܚܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܫܥܹܐ ܠܹܗ ܓܸܠܕܝܼ ܠܓܲܪ̈ܡܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܕܡܹܐ ܠܝܼ ܠܩܵܩܵܐ ܕܒܲܪܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܝܼ ܐܲܝܟ݂ ܩܘܼܦܬܵ‌ܐ ܕܚܵܪ̈ܵܒܹܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܪܥܝܼܫܵܐ؛","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܝܼ ܐܲܝܟ݂ ܛܲܝܪܵܐ ܒܢܲܦ̮ܫܹܗ ܥܲܠܔ ܐܓܵܪܹܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܠܵܝܡܝܼ ܠܝܼ ܕܸܫ̃ܡܸܢܝܼ̈ ܟܠܹܗ ܝܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܣܚܸܪ̈ܵܢܝܼ ܡܘܼܦܠܸܚ ܠܗܘܿܢ ܫܸܡܝܼ ܒܠܵܘܛܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܩܸܛܡܵܐ ܐܲܝܟ݂ ܠܲܚܡܵܐ ܐܟ݂ܝܼܠܔ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܫܬܵܝܬ‌ܝܼ ܒܕܸܡ̈ܥܹܐ ܡܙܝܼܓ݂ ܠܝܼ،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܥܸܠܬܵ‌ܐ ܕܟܲܪܒܘܼܟ݂ ܘܚܸܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܩܵܡ ܡܲܪܡܹܝܬ ܘܪܲܦܹܝܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܝܵܘܡܵܢܝܼ̈ ܐܲܝܟ݂ ܛܸܠܵܢܝܼܬܵ‌ܐ ܒܸܓܢܵܝܵܐ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܵܢܵܐ ܐܲܝܟ݂ ܓܸܠܵܐ ܒܸܒܪܵܙܵܐ ܝܘܸܢ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܠܥܵܠܲܡ ܝܬܝܼܒ݂ܵܐ ܝܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܘܕܟ݂ܵܪܘܼܟ݂ ܠܕܵܪܵܐ ܘܕܵܪܵܐ ܝܠܹܗ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܒܸܬ ܩܵܝܡܹܬ، ܒܸܬ ܪܲܚܡܸܬ ܥܲܠܔ ܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܥܕܵܢܵܐ ܝܠܵܗ̇ ܠܸܥܒ݂ܵܕܵܐ ܚܢܵܢܵܐ ܥܲܠܘܼܗ̇، ܒܗ̇ܝ ܕܐܬܹ‌ܐ ܠܵܗ̇ ܥܕܵܢܵܐ ܪܫܝܼܡܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܒܵܣܡܵܐ ܠܗܘܿܢ ܪܹ̈ܓܵܘܵܬܘܼܟ݂ ܒܟܹܐܦܘܼ̈ܗ̇.","poem":1},{"lineBreak":true},{"text":"ܘܥܲܠܔ ܥܲܦܪܘܼܗ̇ ܟܹܐ ܥܵܒ݂ܕܝܼ ܚܢܵܢܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܘܒܸܬ ܙܵܕܥܝܼ ܐܸܡܘܵܬܹ̈‌ܐ ܡ̣ܢ ܫܸܡܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܵܝܗ‌ܝ ܡܲܠܟܹ̈ܐ ܕܐܲܪܥܵܐ ܡ̣ܢ ܐܝܼܩܵܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܸܬ ܒܵܢܹܐ ܡܵܪܝܵܐ ܠܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܵܐܹܫ ܚܸܙܝܵܐ ܒܫܘܼܒ݂ܚܹܗ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܫܡܝܼܥܵܐ ܠܹܗ ܨܠܘܿܬܵ‌ܐ ܕܡܸܣܟܹܢܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܡܘܼܣܠܹܐ ܠܹܗ ܠܨܠܘܿܬܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܦܵܝܫܵܐ ܟܬܝܼܒ݂ܬܵ‌ܐ ܐܵܗܵܐ ܠܕܵܪܵܐ ܕܐܵܬܹ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܡܵܐ ܕܦܵܐܹܫ ܒܸܪܝܵܐ ܒܸܬ ܫܲܒܸܚ ܠܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܓܘܼܫܸܩ ܠܹܗ ܡ̣ܢ ܡܪܵܘܡܵܐ ܕܩܘܼܕܫܹܗ،","poem":1},{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܡ̣ܢ ܫܡܲܝܵܐ ܠܐܲܪܥܵܐ ܚܝܼܪܹܗ،","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܠܸܫܡܵܥܵܐ ܫܲܦܠܲܦܬܵ‌ܐ ܕܐܲܣܝܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܸܫܪܵܝܵܐ ܠܒܢܲܝ̈ ܡܵܘܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܕܗܲܩܝܼ ܓܵܘ ܨܸܗܝܘܿܢ ܫܸܡܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܬܸܫܒܘܿܚܬܹܗ ܓܵܘ ܐܘܿܪܸܫܠܸܡ،","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܓ̰ܵܡܥܝܼ ܥܲܡܡܹ̈ܐ ܥܲܡ ܚܕܵܕܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܠܟܘܵܬܹ̈‌ܐ، ܠܸܦܠܵܚܵܐ ܠܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܫܡܝܼܛ ܠܹܗ ܚܲܝܠܝܼ ܒܪܲܗܛܵܐ ܕܚܲܝܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܟܪܝܼܵܝ ܠܹܗ ܝܵܘܡܵܢܝܼ̈،","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܐܵܡܪܹܢ، ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܠܵܐ ܫܵܩܠܹܬ ܠܝܼ ܒܦܲܠܓܵܐ ܕܝܵܘܡܵܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܒܕܵܪܵܐ ܕܕܵܪܹ̈ܐ ܝܢܵܐ ܫܸܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܙܲܒ݂ܢܵܐ ܩܲܕܝܼܡܵܝܵܐ، ܫܘܼܬܐܸܣܵܐ ܠܘܼܟ݂ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܫܡܲܝܹ̈ܐ ܦܘܼܠܚܵܢܵܐ ܕܐܝܼܕܵܬܘܼ̈ܟ݂ ܝܼܢܵܐ،","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܐܵܢܝܼ ܒܸܬ ܛܵܠܩܝܼ، ܐܝܼܢܵܐ ܐܲܢ݇ܬ ܦܵܝܫܵܢܵܐ ܝܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܵܝܗ‌ܝ ܐܲܝܟ݂ ܓ̰ܘܼܠܵܐ ܒܸܬ ܒܵܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܠܒ݂ܘܼܫܵܐ ܒܸܬ ܫܲܚܠܸܦܸܬ ܠܗܘܿܢ، ܘܐܵܢܝܼ ܒܸܬ ܦܵܝܫܝܼ ܬܝܼܡܹܐ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ ܗܲܪ ܗ̇ܘ ܝܼܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܘܫܸܢܘܼ̈ܟ݂ ܠܹܐ ܬܵܝܡܝܼ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܒܢܘܿܢܹ̈ܐ ܕܪܹ̈ܓܵܘܵܬܘܼܟ݂ ܒܸܬ ܥܵܡܪܝܼ ܒܫܲܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܪܥܵܝܗ‌ܝ ܩܲܕܡܘܼܟ݂ ܒܸܬ ܡܩܲܘܹܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}