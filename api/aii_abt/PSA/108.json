ܥܲܠܔ ܟܠܵܗ̇ ܐܲܪܥܵܐ ܐܝܼܩܵܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܩܵܐ ܕܦܵܨܝܼ ܡܘܼܚܸܒܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܸܩ ܒܝܲܡܝܼܢܘܼܟ݂ ܘܓ̰ܲܘܸܒ ܠܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܗܘܼܡܙܸܡ ܠܹܗ ܒܩܘܼܕܫܹܗ: ”ܒܸܬ ܦܵܨܚܹܢ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܲܠܥܸܢ ܠܫܟܹܝܡ، ܘܪܵܘܘܿܠܵܐ ܕܣܵܟܘܼܬ ܒܸܬ ܟܵܝܠܹܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"”ܕܝܼܝܼ ܝܠܹܗ ܓܸܠܥܵܕ، ܕܝܼܝܼ ܝܠܹܗ ܡܢܲܫܹܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܦܪܹܝܡ ܣܲܢܘܲܪܬܵ‌ܐ ܕܪܹܝܫܝܼ،","poem":1},{"lineBreak":true},{"text":"ܝܼܗܘܼܕܵܐ ܚܘܼܛܪܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܘܼܐܵܒ݂ ܡܵܪܸܓܠܵܐ ܕܚܲܠܲܠܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܐܲܕܘܿܡ ܒܸܬ ܪܲܦܹܝܢ ܨܵܘܸܠܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܦܠܸܫܬ ܒܸܬ ܡܲܩܘܸܚܸܢ.“","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܒܸܬ ܠܲܒܸܠܔ ܠܝܼ ܠܡܕܝܼܢ݇ܬܵ‌ܐ ܡܘܼܩܘܝܼܬܵ‌ܐ؟","poem":1},{"lineBreak":true},{"text":"ܡܵܢܝܼ ܒܸܬ ܡܗܲܕܹܐ ܠܝܼ ܗܲܠܔ ܐܲܕܘܿܡ؟","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܠܹܐ ܝܘܸܬ ܡܘܼܚܦܸܠܵܐ ܐܸܠܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܦܵܠܛܹܬ ܥܲܡ ܚܲܝܠܵܘܵܬܲܢ̈، ܝܵܐ ܐܲܠܵܗܵܐ؟","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܠܲܢ ܗܲܝܲܪܬܵ‌ܐ ܡ̣ܢ ܕܸܫ̃ܡܸܢ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܣܪܝܼܩܘܼܬܵ‌ܐ ܝܠܵܗ̇ ܦܲܪܲܩܬܵ‌ܐ ܕܒܲܪܢܵܫܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܐܲܠܵܗܵܐ ܒܸܬ ܥܵܒ݂ܕܲܚ ܓܲܒܵܪܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܗ̇ܘ ܒܸܬ ܕܲܫܕܸܫ ܠܕܸܫ̃ܡܸܢܲܢ̈.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}