,"poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡܲܩܸܡ ܥܲܠܘܼܗ‌ܝ ܪܲܫܝܼܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܕܲܠܩܘܼܒ݂ܠܵܝܵܐ ܟܵܠܹܐ ܥܲܠܔ ܝܲܡܝܼܢܹܗ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܦܵܐܹܫ ܕܝܼܢܵܐ، ܫܒ݂ܘܿܩ ܦܵܠܹܛ ܚܲܝܵܒ݂ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܨܠܘܿܬܹܗ ܚܵܕܪܵܐ ܠܚܛܝܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܼ ܝܵܘܡܵܢܘܼ̈ܗ‌ܝ ܒܵܨܘܿܪܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܕܲܒܪܵܢܘܼܬܹܗ ܫܵܩܹܠܔ ܚܲܕ ܐܚܹܪܢܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܼ ܒܢܘܿܢܘܼ̈ܗ‌ܝ ܝܲܬܘܼܡܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܟ݂ܬܹܗ ܐܲܪܡܸܠܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܚܕܵܪܵܐ ܚܵܕܪܝܼ ܒܢܘܿܢܘܼ̈ܗ‌ܝ ܘܓܵܒ݂ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܛܵܥܝܼ ܒܵܬܪ ܠܲܚܡܵܐ ܒܕܘܼܟܵܢܵܝ̈ܗ‌ܝ ܚܵܪ̈ܵܒܹܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܟ̰ܵܠܹܓ̰ ܡܵܪܵܐ ܕܕܲܝܢܵܐ ܠܟܠܔ ܡܸܢܕܝܼ ܕܐܝܼܬ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܠܒܝܼ ܢܘܼܟ݂ܪ̈ܵܝܹܐ ܛܥܘܼܢܬܵ‌ܐ ܕܥܲܡܠܹܗ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܗܵܘܹܐ ܐܸܠܹܗ ܝܵܗܒ݂ܵܢܵܐ ܕܪ̈ܲܚܡܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܗܵܘܹܐ ܥܵܒ݂ܕܵܢܵܐ ܕܚܢܵܢܵܐ ܠܝܲܬܘܼܡܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܦܵܐܹܫ ܩܛܝܼܥܵܐ ܙܲܪܥܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܐ ܕܵܪܵܐ ܐܚܹܪܢܵܐ ܫܸܡܵܝܗ‌ܝ ܗܵܘܹܐ ܓܪܝܼܕܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܦܵܐܹܫ ܕܟ݂ܝܼܪܵܐ ܥܵܘܠܵܐ ܕܐܲܒ݂ܵܗܵܬܘܼ̈ܗ‌ܝ ܠܟܸܣ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܚܛܝܼܬܵ‌ܐ ܕܝܸܡܹܗ ܠܵܐ ܦܵܝܫܵܐ ܓܪܝܼܕܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܼ ܩܲܕܡ ܡܵܪܝܵܐ ܒܟܠܔ ܙܲܒ݂ܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܛܹܥ ܕܟ݂ܵܪܵܝܗ‌ܝ ܡ̣ܢ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܵܐ ܕܟ݂ܝܼܪܹܗ ܠܸܥܒ݂ܵܕܵܐ ܛܵܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܵܐ ܢܦܝܼܠܔ ܠܹܗ ܒܵܬܪ ܐܢܵܫܵܐ ܡܸܣܟܹܢܵܐ ܘܣܢܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܘܼܥܝܸܩܵܐ ܒܠܸܒܵܐ، ܠܡܲܡܝܘܼܬܹ‌ܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܡܘܼܚܸܒ ܠܹܗ ܠܵܘܛܬܵ‌ܐ، ܫܒ݂ܘܿܩ ܐܵܬܝܵܐ ܥܲܠܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܒܣܝܼܡ ܠܵܗ̇ ܠܹܗ ܒܒܘܼܪܟܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܪܵܚܩܵܐ ܡܸܢܹܗ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܘܠܒ݂ܝܼܫ ܠܹܗ ܠܵܘܛܬܵ‌ܐ ܐܲܝܟ݂ ܠܒ݂ܝܼܫܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܥܒ݂ܝܼܪܵܗ̇ ܒܓܵܘܹܗ ܐܲܝܟ݂ ܡ̈ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܓܲܪ̈ܡܘܼܗ‌ܝ ܐܲܝܟ݂ ܡܸܫܚܵܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܵܐ ܐܸܠܹܗ ܐܲܝܟ݂ ܥܵܒܵܝܬܵ‌ܐ ܕܩܵܛܹܒ݂ ܠܵܗ̇ ܠܓܵܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܝܟ݂ ܬܲܣܡܵܐ ܒܟܠܔ ܙܲܒ݂ܢܵܐ ܐܵܣܹܪܵܗ̇ ܒܚܲܨܹܗ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܵܗܵܐ ܝܠܹܗ ܦܘܼܪܥܵܢܵܐ ܕܕܲܠܩܘܼܒ݂ܠܵܝܝܼ̈ ܡ̣ܢ ܠܟܸܣ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܕܗܲܡܙܸܡܵܢܹ̈ܐ ܕܒܝܼܫܬܵ‌ܐ ܥܲܠܔ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ، ܦܠܘܿܚ ܠܓܹܒܝܼ ܒܘܼܬ ܫܸܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܦܲܨܝܼ ܠܝܼ، ܣܵܒܵܒ ܨܦܵܝܝܼ ܝܠܵܗ̇ ܛܲܝܒܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܸܣܟܹܢܵܐ ܘܣܢܝܼܩܵܐ ܝܘܸܢ ܐܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܸܒܝܼ ܟ̰ܪܝܼܙܵܐ ܝܠܹܗ ܒܓܵܘܝܼ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܛܸܠܵܢܝܼܬܵ‌ܐ ܕܒܥܕܵܢܵܐ ܕܓܢܵܝܬܵ‌ܐ ܒܸܛܠܵܩܵܐ ܝܘܸܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܩܲܡܨܵܐ ܦܝܼܫܵܐ ܝܘܸܢ ܢܦܝܼܨܵܐ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܒܸܪ̈ܟܵܟܝܼ ܪܓܝܼܕ ܠܗܘܿܢ ܡ̣ܢ ܨܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܣܪܝܼ ܢܘܝܼܠܔ ܠܹܗ ܒܗ̇ܝ ܕܠܲܝܬ ܬܲܪܒܵܐ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܘܐܵܢܵܐ ܗܘܹܐ ܠܝܼ ܠܵܘܡܵܐ ܐܸܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܟܲܕ ܚܵܙܝܼ ܠܝܼ ܟܹܐ ܫܵܥܫܝܼ ܪܹܝܫܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܗܲܝܸܪܝܼ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܸܩ ܠܝܼ ܐܲܝܟ݂ ܛܲܝܒܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܕܝܵܕܥܝܼ ܕܐܝܼܕܘܼܟ݂ ܝܼܠܵܗ̇ ܐܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܥܒ݂ܝܼܕܵܐ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܐܵܢܝܼ ܠܵܝܛܝܼ، ܐܝܼܢܵܐ ܐܲܢ݇ܬ ܒܲܪܟܸܬ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܩܵܝܡܝܼ ܒܸܬ ܢܵܟ݂ܦܝܼ، ܐܝܼܢܵܐ ܪܹܓܘܼܟ݂ ܒܸܬ ܚܵܕܹܐ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ܠܵܒ݂ܫܝܼ ܕܲܠܩܘܼܒ݂ܠܵܝܝܼ̈ ܢܟܸܦܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܛܒ݂ܝܼ ܐܲܝܟ݂ ܥܵܒܵܝܬܵ‌ܐ ܢܟܸܦܬܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ܪܵܒܵܐ ܒܸܬ ܫܲܟܪܸܢ ܠܡܵܪܝܵܐ ܒܦܘܼܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܓܵܘܵܐ ܕܟܸܢܫܹ̈ܐ ܒܸܬ ܫܲܒܚܸܢܹܗ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܟܵܠܹܐ ܠܝܲܡܝܼܢܵܐ ܕܣܢܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܦܲܪܘܼܩܹܗ ܡ̣ܢ ܕܲܝܵܢܹ̈ܐ ܕܢܲܦ̮ܫܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}