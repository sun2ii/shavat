t":"ܕܟܹܐ ܥܵܒܹܕ ܨܒ݂ܘܼܝܵܬܘܼ̈ܗ‌ܝ ܒܗܵܩܘܼܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܠܥܵܠܲܡ ܠܹܐ ܫܵܥܹܫ،","poem":1},{"lineBreak":true},{"text":"ܕܟ݂ܵܪܵܐ ܕܙܲܕܝܼܩܵܐ ܒܸܬ ܗܵܘܹܐ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܚܲܒܪܵܐ ܚܸܪܒܵܐ، ܠܹܐ ܙܵܕܹܥ،","poem":1},{"lineBreak":true},{"text":"ܡܩܵܘܝܵܢܵܐ ܝܠܹܗ ܠܸܒܹܗ ܒܣܲܒ݂ܪܵܐ ܠܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܣܢܝܼܕܵܐ ܝܠܹܗ ܠܸܒܹܗ ܠܹܐ ܙܵܕܹܥ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܕܚܵܙܹܐ ܙܵܟ݂ܘܼܬܵ‌ܐ ܠܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܘܼܪܒܸܙ ܠܹܗ ܘܝܘܼܗܒܹܠܔ ܠܹܗ ܠܣܢܝܼܩܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܹܗ ܦܵܝܫܵܢܬܵ‌ܐ ܝܠܵܗ̇ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܪܹܝܫܹܗ ܒܸܬ ܪܵܐܹܡ ܒܐܝܼܩܵܪܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܪܲܫܝܼܥܵܐ ܒܸܬ ܚܵܙܹܐ ܘܒܸܬ ܟܵܪܹܒ،","poem":1},{"lineBreak":true},{"text":"ܟܹܟܘܼ̈ܗ‌ܝ ܒܸܬ ܚܲܪܚܸܟ̃ ܘܒܸܬ ܦܵܫܹܪ،","poem":1},{"lineBreak":true},{"text":"ܫܲܗܘܲܬܬܵ‌ܐ ܕܪ̈ܲܫܝܼܥܹܐ ܒܸܬ ܛܵܠܩܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}