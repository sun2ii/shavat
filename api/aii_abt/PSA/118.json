ue},{"text":"ܝܲܡܝܼܢܵܐ ܕܡܵܪܝܵܐ ܥܵܒ݂ܕܵܢܬܵ‌ܐ ܕܚܲܝܠܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܠܹܐ ܡܵܝܬܹܢ ܐܸܠܵܐ ܒܸܬ ܚܵܝܹܝܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܗܲܩܹܝܢ ܥܒ݂ܵܕܹ̈ܐ ܕܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܬܲܥܠܘܼܡܹܐ ܬܘܼܥܠܡܸܢܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܠܡܵܘܬܵ‌ܐ ܠܵܐ ܣܘܼܦܝܸܢܹܗ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܦܬܘܿܚܘܼܢ ܐܸܠܝܼ ܕܲܪ̈ܘܵܙܹܐ ܕܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܥܵܒ݂ܪܹܢ ܒܝܼܵܝܗ‌ܝ ܘܫܲܟܪܸܢ ܠܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܵܗܵܐ ܝܠܹܗ ܕܲܪܘܵܙܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܙܲܕܝܼܩܹ̈ܐ ܒܸܬ ܥܵܒ݂ܪܝܼ ܒܝܼܹܗ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܸܢܘܼܟ݂ ܕܩܵܡ ܓ̰ܲܘܸܒܸܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܘܼܟ݂ ܐܸܠܝܼ ܦܘܼܪܩܵܢܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܟܹܐܦܵܐ ܕܡܘܼܣܠܹܐ ܠܗܘܿܢ ܒܲܢܵܝܹ̈ܐ","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܹܗ ܠܪܹܝܫܵܐ ܕܩܘܼܪܢܝܼܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܠܟܸܣ ܡܵܪܝܵܐ ܗܘܹܐ ܠܵܗ̇ ܐܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܝ ܥܘܼܓ̰ܵܒܵܐ ܝܠܵܗ̇ ܒܥܲܝܢܲܢ̈.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܐܵܗܵܐ ܝܠܹܗ ܝܵܘܡܵܐ ܕܥܒ݂ܝܼܕ ܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܵܨܚܲܚ ܘܚܵܕܲܚ ܒܝܼܹܗ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܦܲܪܦܘܼܠܹܐ ܝܘܲܚ، ܝܵܐ ܡܵܪܝܵܐ، ܦܲܪܸܩ ܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܦܘܼܠܹܐ ܝܘܲܚ، ܝܵܐ ܡܵܪܝܵܐ، ܡܲܢܬ‌ܝܼ ܠܲܢ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܗ̇ܘ ܕܒܹܐܬܵܝܵܐ ܝܠܹܗ ܒܫܸܡܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܒܲܪܟܲܚ ܠܵܘܟ݂ܘܿܢ ܡ̣ܢ ܒܲܝܬܵ‌ܐ ܕܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܡܵ