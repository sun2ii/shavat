e":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܝܪܝܼܟ݂ ܠܵܗ̇ ܥܲܠܝܼ ܥܡܵܪܬܵ‌ܐ ܕܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܲܡ ܣܵܢܝܵܢܹ̈ܐ ܕܫܠܵܡܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܵܢܵܐ ܒܵܬܪ ܫܠܵܡܵܐ ܝܘܸܢ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܝܼܡܲܢ ܕܗܲܡܙܸܡܸܢ، ܐܵܢܝܼ ܒܵܬܪ ܦܠܵܫܵܐ ܝܢܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}