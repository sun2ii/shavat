:true},{"text":"ܡ̣ܢ ܡܲܣܠܲܝܬܵ‌ܐ ܕܫܲܒ݂ܗܸܪ̈ܵܢܹܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}