,"number":5,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܝܼ ܕܩܵܠܒܝܼ ܠܐܘܼܪ̈ܚܵܬܵܝܗ‌ܝ ܦܟ̰ܝܼܠܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܠܲܒܸܠܔ ܠܗܘܿܢ ܡܵܪܝܵܐ ܥܲܡ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܠܵܡܵܐ ܥܲܠܔ ܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}