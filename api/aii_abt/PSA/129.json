er":6,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܼ ܐܲܝܟ݂ ܓܸܠܵܐ ܕܐܓܵܪ̈ܵܘܵܬܹ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܕܟܹܐ ܒܵܪܹܙ ܡ̣ܢ ܩܲܕܡ ܕܦܵܐܹܫ ܢܟ̰ܝܼܠܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܕܠܹܐ ܡܵܠܝܵܐ ܡܸܢܹܗ ܐܝܼܕܵܐ ܕܚܲܨܵܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܚܦܵܩܵܐ ܕܐܵܣܪܵܢܵܐ ܕܕܲܪ̈ܙܹܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܘܠܹܐ ܐܵܡܪܝܼ ܥܵܒ݂ܪ̈ܵܢܹܐ:","poem":1},{"lineBreak":true},{"text":"”ܒܘܼܪܟܬܵ‌ܐ ܕܡܵܪܝܵܐ ܥܲܠܵܘܟ݂ܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܲܪܘܼܟܹܐ ܝܘܲܚ ܐܸܠܵܘܟ݂ܘܿܢ ܒܫܸܡܵܐ ܕܡܵܪܝܵܐ.“","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}