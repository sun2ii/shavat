{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["ܙܡܪܬ‌ܐ ܕܐܣܩܬ‌ܐ."]},{"type":"verse","number":1,"content":[{"text":"ܕܟ݂ܘܿܪ، ܝܵܐ ܡܵܪܝܵܐ، ܠܕܵܘܝܼܕ،","poem":1},{"lineBreak":true},{"text":"ܠܟܠܵܝܗ‌ܝ ܐܘܼܠܨܵܢܘܼ̈ܗ‌ܝ،","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܕܵܐܟ݂ܝܼ ܕܝܡܹܐ ܠܹܗ ܠܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܢܕܝܼܪܹܗ ܠܙܲܪܒܵܢܵܐ ܕܝܲܥܩܘܿܒ݂:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"”ܠܹܐ ܥܵܒ݂ܪܹܢ ܬܚܘܿܬ ܫܟܘܼܪܹܐ ܕܒܲܝܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܐܵܣܩܹܢ ܥܲܠܔ ܫܘܝܼܬܵ‌ܐ ܕܕܡܵܟ݂ܬ‌ܝܼ،","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"”ܠܹܐ ܝܵܗܒܹܢ ܫܸܢܬܵ‌ܐ ܠܥܲܝܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܢܵܘܡܵܐ ܠܛܸܠܦܵܦܝܼ̈،","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"”ܗܲܠܔ ܕܡܲܫ݇ܟ̰ܚܸܢ ܕܘܼܟܬܵ‌ܐ ܩܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܫܟܢܵܐ ܩܵܐ ܙܲܪܒܵܢܵܐ ܕܝܲܥܩܘܿܒ݂.“","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܫܡܝܼܥ ܠܲܢ ܒܘܼܬ ܕܝܼܘܼܗ̇ ܓܵܘ ܐܵܦܲܪܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܫ݇ܟ̰ܚܵܐ ܠܲܢ ܓܵܘ ܚܲܩܠܵܢܹ̈ܐ ܕܡܲܝܫܵܐ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܥܵܒ݂ܪܲܚ ܠܡܲܫܟܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܣܵܓ݂ܕܲܚ ܠܓܹܒܵܐ ܕܟܘܼܒ݂ܫܵܐ ܕܐܲܩܠܘܼ̈ܗ‌ܝ،","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܒܹܐܡܵܪܵܐ: ”ܩܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ، ܠܢܝܵܚܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܘܩܹܒ݂ܘܼܬܵ‌ܐ ܕܙܲܪܒܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"”ܟܵܗܢܘܼ̈ܟ݂ ܠܵܒ݂ܫܝܼ ܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܕܝܼܩܘܼ̈ܟ݂ ܫܲܒܚܝܼ.“","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܘܼܬ ܕܵܘܝܼܕ ܪܹܓܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܡܲܕܸܪܸܬ ܦܵܬܵ‌ܐ ܕܡܫܝܼܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܝܡܹܐ ܠܹܗ ܡܵܪܝܵܐ ܠܕܵܘܝܼܕ ܒܫܲܪܝܼܪܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܕܵܐܹܪ ܡܸܢܘܼܗ̇:","poem":1},{"lineBreak":true},{"text":"”ܡ̣ܢ ܛܥܘܼܢܝܵܬܹ̈‌ܐ ܕܟܹܪ݇ܣܘܼܟ݂ ܒܸܬ ܡܲܬܒܸܢ ܥܲܠܔ ܟܘܼܪܣܝܘܼܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"”ܐܸܢ ܢܵܛܪܝܼ ܒܢܘܿܢܘܼ̈ܟ݂ ܘܲܥܕܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܗܕܘܵܬ‌ܝܼ̈ ܕܡܲܠܦܸܢܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܒܢܘܿܢܵܝ̈ܗ‌ܝ ܠܥܵܠܲܡ ܒܸܬ ܝܵܬܒ݂ܝܼ ܥܲܠܔ ܟܘܼܪܣܝܘܼܟ݂.“","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܓܘܼܒܹܐ ܠܹܗ ܡܵܪܝܵܐ ܠܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܫܘܼܗܘܸܬ ܠܹܗ ܕܗܵܘܝܵܐ ܒܹܝܬ ܡܲܥܡܪܹܗ، ܒܹܐܡܵܪܵܐ:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"”ܐܵܗܵܐ ܝܠܵܗ̇ ܢܝܵܚܬ‌ܝܼ ܗܲܠܔ ܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܠܲܐܟ݂ܵܐ ܒܸܬ ܝܵܬܒܹܢ ܣܵܒܵܒ ܫܘܼܗܘܸܬ ܠܝܼ ܐܸܠܘܼܗ̇.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"”ܡܹܐܟ݂ܘܼܠܬܘܼܗ̇ ܒܲܪܘܼܟܹܐ ܒܸܬ ܒܲܪܟܸܢ،","poem":1},{"lineBreak":true},{"text":"ܣܢܝܼܩܘܼ̈ܗ̇ ܒܸܬ ܡܲܣܒܸܥܸܢ ܒܠܲܚܡܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"”ܘܠܟܵܗܢܘܼ̈ܗ̇ ܒܸܬ ܡܲܠܒܸܫܸܢ ܦܘܼܪܩܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܕܝܼܩܘܼ̈ܗ̇ ܫܲܒܲܚܬܵ‌ܐ ܒܸܬ ܫܲܒܚܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"”ܬܵܡܵܐ ܒܸܬ ܡܲܩܸܡܸܢ ܚܲܝܠܵܐ ܠܕܵܘܝܼܕ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܪܝܸܙ ܠܝܼ ܫܪܵܓ݂ܵܐ ܩܵܐ ܡܫܝܼܚܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"”ܠܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ ܒܸܬ ܡܲܠܒܸܫܸܢ ܢܟ݂ܝܼܦܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܥܲܠܘܼܗ‌ܝ ܒܸܬ ܦܵܩܹܚ ܬܵܓܹܗ.“","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}