{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܨܘܼܚܨܝܼܵܐ ܝܘܸܬ ܐܸܠܝܼ ܘܟܹܐ ܝܵܕܥܹܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܟܹܐ ܝܵܕܥܹܬ ܝܬܵܒ݂ܬ‌ܝܼ ܘܩܝܵܡܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܘܼܪܡܹܐ ܠܘܼܟ݂ ܚܘܼܫܵܒ݂ܝܼ ܡ̣ܢ ܪܸܚܩܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܘܼܪܚܝܼ ܘܕܡܵܟ݂ܬ‌ܝܼ ܬܘܼܦ̮ܬܸܫ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܵܝܗ‌ܝ ܐܘܼܪ̈ܚܵܬ‌ܝܼ ܟܹܐ ܝܵܕܥܹܬ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܗܸܫ ܠܲܝܬ ܚܲܒܪܵܐ ܒܠܸܫܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܵܐ ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܟܹܐ ܝܵܕܥܹܬ ܠܹܗ ܟܠܹܗ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܒܵܬܪܵܐ ܘܩܲܕܡܵܐ ܩܵܡ ܚܲܪܕܸܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܡ ܡܲܬܒܸܬ ܐܝܼܕܘܼܟ݂ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܥܓ̰ܝܼܒܬܵ‌ܐ ܝܠܵܗ̇ ܐܵܗܵܐ ܝܕܵܥܬܵ‌ܐ ܩܵܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܸܠܸܠܔ ܝܼܠܵܗ̇ ܡ̣ܢ ܨܲܠܡܲܢܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܠܐܲܝܟܵܐ ܐܵܙܹܠ݇ܢ ܡ̣ܢ ܪܘܼܚܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܠܐܲܝܟܵܐ ܥܵܪܩܹܢ ܡ̣ܢ ܦܵܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܐܵܣܩܹܢ ܠܫܡܲܝܵܐ، ܬܵܡܵܐ ܝܘܸܬ ܐܲܢ݇ܬ،","poem":1},{"lineBreak":true},{"text":"ܘܐܸܢ ܫܲܘܹܝܢ ܫܘܝܼܬ‌ܝܼ ܓܵܘ ܫܝܘܿܠܔ، ܗܵܐ، ܬܵܡܵܐ ܝܘܸܬ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܫܵܩܠܹܢ ܓܘܼܠܦܵܢܹ̈ܐ ܕܨܸܡܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܫܵܪܹܝܢ ܒܚܲܪܬܵ‌ܐ ܕܝܵܡܵܐ،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܬܵܡܵܐ ܐܝܼܕܘܼܟ݂ ܒܸܬ ܡܗܲܕܝܵܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܝܲܡܝܼܢܘܼܟ݂ ܒܸܬ ܕܵܒ݂ܩܵܐ ܠܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܘܐܸܢ ܐܵܡܪܹܢ: ”ܒܫܪܵܪܵܐ، ܚܸܫܟܵܐ ܒܸܬ ܟܲܣܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܗܪܵܐ ܕܥܲܠܝܼ ܒܸܬ ܗܵܘܹܐ ܠܲܝܠܹܐ،“","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܚܸܫܟܵܐ ܠܹܐ ܝܠܹܗ ܚܸܫܟܵܢܵܐ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܠܲܝܠܹܐ ܐܲܝܟ݂ ܐܝܼܡܵܡܵܐ ܟܹܐ ܒܲܗܪܸܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܚܸܫܟܵܐ، ܗܵܕܟ݂ܵܐ ܒܲܗܪܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܲܢ݇ܬ ܒܪܹܐ ܠܘܼܟ݂ ܠܪܸܥܝܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܙܵܩܪܹܬ ܠܝܼ ܒܒܲܛܢܵܐ ܕܝܸܡܝܼ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܸܢܘܼܟ݂ ܒܗ̇ܝ ܕܣܲܗܡܵܢܵܐ ܘܥܓ̰ܝܼܒܵܐ ܦܝܼܫ ܠܝܼ ܥܒ݂ܝܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܥܓ̰ܝܼܒܹ̈ܐ ܝܢܵܐ ܦܘܼܠܚܵܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܢܝܼ ܨܦܵܝܝܼ ܟܹܐ ܝܵܕܥܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܦܝܼܫ ܠܗܘܿܢ ܛܸܫܝܹܐ ܓܲܪ̈ܡܝܼ ܡܸܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܲܕ ܦܝܼܫ ܠܝܼ ܥܒ݂ܝܼܕܵܐ ܒܣܸܬܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܙܩܝܼܪܵܐ ܓܵܘ ܬܲܚ̈ܬܵܝܵܬܹ‌ܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܚܙܹܐ ܠܗܘܿܢ ܥܲܝ̈ܢܘܼܟ݂ ܓܒ݂ܝܼܠܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܘ ܟܬܵܒ݂ܘܼܟ݂ ܟܠܵܝܗ‌ܝ ܝܵܘܡܵܢܝܼ̈ ܦܝܼܫ ܠܗܘܿܢ ܟܬܝܼܒܹܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܗܘܿܢ ܪܫܝܼܡܹܐ، ܟܲܕ ܠܲܝܬ ܗܘܵܐ ܐܘܼܦ ܚܲܕ ܡܸܢܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܘܐܸܠܝܼ ܟܡܵܐ ܡܝܘܼܩܪܹ̈ܐ ܝܢܵܐ ܚܘܼܫܵܒ݂ܘܼ̈ܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܡܵܐ ܪܵܒܵܐ ܝܢܵܐ ܡܸܢܝܵܢܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܡܵܢܹܢܗܘܿܢ ܒܘܼܫ ܒܸܬ ܙܵܝܕܝܼ ܡ̣ܢ ܣܹܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܪܵܥܫܹܢ ܘܗܸܫ ܐܵܢܵܐ ܥܲܡܘܼܟ݂ ܝܼܘܸܢ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܕܩܵܛܠܹܬ ܠܪ̈ܲܫܝܼܥܹܐ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܪܚܘܿܩܘܼܢ ܡܸܢܝܼ، ܝܵܐ ܫܲܦܟ݂ܵܢܹ̈ܐ ܕܕܸܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܗܲܡܙܸܡܝܼ ܒܘܼܬ ܕܝܼܘܼܟ݂ ܒܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂ ܟܹܐ ܫܵܩܠܝܼ ܫܸܡܘܼܟ݂ ܒܣܪܝܼܩܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܠܹܐ ܣܵܢܹܝܢ ܠܣܵܢܝܵܢܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܓܲܢܓܸܙܸܢ ܡ̣ܢ ܩܵܝܡܵܢܹ̈ܐ ܕܕܲܠܩܘܼܒ݂ܠܘܼܟ݂؟","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܣܢܵܝܬܵ‌ܐ ܓܡܝܼܪܬܵ‌ܐ ܟܹܐ ܣܵܢܹܢܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܗܘܿܢ ܐܸܠܝܼ ܕܸܫ̃ܡܸܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܨܲܚܨܝܼ ܠܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ، ܘܝܕܹܥ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܬܲܦ̮ܬܸܫ ܠܝܼ ܘܝܕܹܥ ܚܲܡܝܼ̈.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܘܚܙܝܼ ܐܸܢ ܐܝܼܬ ܒܝܼܝܼ ܡܸܢܕܝܼ ܥܲܓ̰ܸܙܵܢܵܐ ܩܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܡܗܲܕܝܼ ܠܝܼ ܒܐܘܼܪܚܵܐ ܕܠܥܵܠܲܡ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}