{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܩܪܹܐ ܠܝܼ ܐܸܠܘܼܟ݂، ܡܲܠܝܸܙ ܠܟܸܣܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ ܠܩܵܠܝܼ ܟܲܕ ܩܵܪܹܝܢ ܐܸܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܵܐ ܨܠܘܿܬ‌ܝܼ ܐܲܝܟ݂ ܒܸܣܡܵܐ ܩܲܕܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܲܪܲܡܬܵ‌ܐ ܕܐܝܼܕܵܬ‌ܝܼ̈ ܐܲܝܟ݂ ܩܘܼܪܒܵܢܵܐ ܕܪܲܡܫܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܡܲܬܸܒ݂ ܢܛܵܪܬܵ‌ܐ ܠܦܘܼܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܢܛܘܿܪ ܠܬܲܪܥܵܐ ܕܣܸܦܘܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܫܵܒ݂ܩܹܬ ܦܵܬܹܠܔ ܠܸܒܝܼ ܠܗܹܡܸܙܡܵܢ ܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܸܥܒ݂ܵܕܵܐ ܥܒ݂ܵܕܹ̈ܐ ܒܪܲܫܝܼܥܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܥܲܡ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܫܵܒ݂ܩܹܬ ܐܵܟ݂ܠܹܢ ܡ̣ܢ ܛܲܥܡܵܬܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܡܵܚܹܐ ܠܝܼ ܙܲܕܝܼܩܵܐ، ܛܲܝܒܘܼܬܵ‌ܐ ܝܠܵܗ̇ ܐܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܢܟܸܣ ܠܝܼ، ܡܸܫܚܵܐ ܕܪܹܝܫܵܐ ܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܡܲܚܦܸܠܔ ܪܹܝܫܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܗܸܫ ܨܠܘܿܬ‌ܝܼ ܕܲܠܩܘܼܒ݂ܠܔ ܕܒܝܼܫܵܬܵܝ̈ܗ‌ܝ ܝܠܵܗ̇.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܦܵܝܫܝܼ ܪܘܼܦܝܹܐ ܒܕܸܦܢܵܬܹ̈‌ܐ ܕܩܵܝܵܐ ܕܲܝܵܢܵܝ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܫܵܡܥܝܼ ܗܹܡܸܙܡܵܢܝܼ̈ ܒܗ̇ܝ ܕܒܲܣܝܼܡܹ̈ܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܛܵܪܝܵܢܵܐ ܕܦܕܵܢܵܐ ܕܛܵܪܹܐ ܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܦܝܼܫ ܠܗܘܿܢ ܒܘܼܪܒܸܙܹܐ ܓܲܪ̈ܡܲܢ ܥܲܠܔ ܦܘܼܡܵܐ ܕܫܝܘܿܠܔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܥܲܝܢܝܼ̈ ܐܸܠܘܼܟ݂ ܝܼܢܵܐ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܝܼܘܼܟ݂ ܫܩܝܼܠܔ ܠܝܼ ܓܵܘܣܵܐ، ܠܵܐ ܫܵܒ݂ܩܹܬ ܠܵܗ̇ ܓܵܢܝܼ ܒܠܵܐ ܢܛܵܪܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܢܛܘܿܪܝܼ ܡ̣ܢ ܦܲܚܹ̈ܐ ܕܡܘܼܬܸܒ݂ ܠܗܘܿܢ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܢܸܫܒ݂ܵܐ ܕܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܢܵܦܠܝܼ ܪ̈ܲܫܝܼܥܹܐ ܥܲܡ ܚܕܵܕܹ̈ܐ ܒܓܲܪܕܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܕܐܵܢܵܐ ܥܵܒ݂ܪܹܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}