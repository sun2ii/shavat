{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܫܡܹܥ ܨܠܘܿܬ‌ܝܼ، ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ ܠܢܵܘܢܲܝܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܓ̰ܲܘܸܒ ܠܝܼ، ܒܙܲܕܝܼܩܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܘܠܵܐ ܡܲܥܒܸܪܸܬ ܠܹܗ ܪܹܓܘܼܟ݂ ܠܕܝܵܢܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܝܠܹܗ ܙܲܕܝܼܩܵܐ ܩܲܕܡܘܼܟ݂ ܟܠܔ ܐܢܵܫܵܐ ܚܵܝܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܢܦܝܼܠܔ ܠܹܗ ܕܸܫ̃ܡܸܢ ܒܵܬܪ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܛܒ݂ܝܼܚ ܠܹܗ ܠܐܲܪܥܵܐ ܚܲܝܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܡܲܬܸܒ݂ ܠܝܼ ܒܕܘܼܟܵܢܹ̈ܐ ܚܸܫܟܵܢܹ̈ܐ ܐܲܝܟ݂ ܡܝܼ̈ܬܹ‌ܐ ܕܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܘܕܘܼܪܕܸܫ̃ܬܵ‌ܐ ܝܠܵܗ̇ ܒܓܵܘܝܼ ܪܘܼܚܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܓܵܘܝܼ ܫܓ݂ܝܼܫܵܐ ܝܠܹܗ ܠܸܒܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܝܼܪܝܼ ܠܝܵܘܡܵܢܹ̈ܐ ܩܲܕܝܼܡܵܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܗܘܼܓܹܐ ܠܝܼ ܒܘܼܬ ܟܠܵܝܗ‌ܝ ܦܘܼܠܚܵܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܥܒ݂ܵܕܹ̈ܐ ܕܐܝܼܕܵܬܘܼ̈ܟ݂ ܬܘܼܚܡܸܢܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܦܘܼܫܸܛ ܠܝܼ ܐܝܼܕܵܬ‌ܝܼ̈ ܠܟܸܣܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܓܵܢܝܼ ܨܗܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܐܸܠܘܼܟ݂ ܐܲܝܟ݂ ܐܲܪܥܵܐ ܒܪܝܼܙܬܵ‌ܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܡܲܠܝܸܙ ܓ̰ܲܘܸܒ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܬܝܼܡ ܠܵܗ̇ ܪܘܼܚܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܛܲܫܹܝܬ ܦܵܬܘܼܟ݂ ܡܸܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܵܐ ܒܸܬ ܗܵܘܹܝܢ ܕܘܼܡܝܵܐ ܠܨܵܠܝܵܢܹ̈ܐ ܕܓܘܼܒܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܲܫܡܸܥ ܠܝܼ ܒܨܲܦܪܵܐ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܝܼܘܼܟ݂ ܦܝܼܫ ܠܝܼ ܒܣܲܒ݂ܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܕܸܥ ܠܝܼ ܐܘܼܪܚܵܐ ܕܐܵܙܹܠ݇ܢ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܸܠܘܼܟ݂ ܡܘܼܪܡܵܐ ܠܝܼ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܦܲܨܝܼ ܠܝܼ ܡ̣ܢ ܕܸܫ̃ܡܸܢܝܼ̈، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܟܸܣܠܘܼܟ݂ ܛܘܼܫܝܘܼܗ̇ ܝܘܸܢ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܲܠܸܦ ܠܝܼ ܠܸܥܒ݂ܵܕܵܐ ܨܸܒ݂ܝܵܢܘܼܟ݂، ܒܗ̇ܝ ܕܐܲܢ݇ܬ ܝܼܘܸܬ ܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܪܘܼܚܘܼܟ݂ ܛܵܒ݂ܵܐ ܡܗܲܕܹܐ ܠܝܼ ܒܐܲܪܥܵܐ ܬܪܘܼܨܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܘܼܬ ܫܸܡܘܼܟ݂ ܡܲܚܹܝܬ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܦܲܠܛܸܬ ܓܵܢܝܼ ܡ̣ܢ ܐܘܼܠܨܵܢܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܘܒܛܲܝܒܘܼܬܘܼܟ݂ ܡܲܫܬܸܩܸܬ ܠܕܸܫ̃ܡܸܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܛܲܠܩܸܬ ܠܟܠܵܝܗ‌ܝ ܡܲܠܝܸܨܵܢܹ̈ܐ ܕܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܪܹܓܘܼܟ݂ ܝܼܘܸܢ ܐܵܢܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}