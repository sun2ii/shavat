{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"ܒܸܬ ܡܲܪܡܸܢܘܼܟ݂، ܝܵܐ ܐܲܠܵܗ‌ܝܼ ܡܲܠܟܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܒܲܪܟܸܢ ܫܸܡܘܼܟ݂ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܟܠܔ ܝܘܿܡ ܒܸܬ ܒܲܪܟܸܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܫܲܒܚܸܢ ܠܫܸܡܘܼܟ݂ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܓܘܼܪܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܘܡܫܘܼܒܚܵܐ ܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܓܘܼܪܘܼܬܹܗ ܠܲܝܬ ܨܲܚܨܲܝܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܕܵܪܵܐ ܒܸܬ ܫܲܒܸܚ ܦܘܼܠܚܵܢܘܼ̈ܟ݂ ܠܕܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓܲܒܵܪ̈ܘܼܝܵܬܘܼܟ݂ ܒܸܬ ܡܲܕܥܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܠܣܸܩܠܵܐ ܕܚܸܩܪܵܐ ܕܫܘܼܒ݂ܚܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܥܒ݂ܵܕܘܼ̈ܟ݂ ܡܲܥܓ̰ܸܒܵܢܹ̈ܐ ܒܸܬ ܗܲܓܹܝܢ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܒܘܼܬ ܚܲܝܠܵܐ ܕܥܒ݂ܵܕܘܼ̈ܟ݂ ܣܲܗܡܵܢܹ̈ܐ ܒܸܬ ܐܵܡܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܘܼܪܘܼܬܘܼܟ݂ ܒܸܬ ܗܲܩܹܝܢ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܵܪܵܐ ܕܦܸܪܝܘܼܬܵ‌ܐ ܕܛܵܒ݂ܘܼܬܘܼܟ݂ ܒܸܬ ܬܲܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܒܸܬ ܡܲܩܘܸܚܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܚܲܢܵܢܵܐ ܝܠܹܗ ܘܡܪܲܚܡܵܢܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܲܪܝܼܟ݂ܬܵ‌ܐ ܒܹܐܢܹܗ ܘܓܘܼܪܬܵ‌ܐ ܛܲܝܒܘܼܬܹܗ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܛܵܒ݂ܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܠܟܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܪ̈ܲܚܡܘܼܗ‌ܝ ܥܲܠܔ ܟܠܵܝܗ‌ܝ ܦܘܼܠܚܵܢܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܝܼ ܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܟܠܵܝܗ‌ܝ ܦܘܼܠܚܵܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܡܗܘܼܡܢܘܼ̈ܟ݂ ܒܸܬ ܒܲܪܟ݂ܝܼ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܘܼܬ ܚܸܩܪܵܐ ܕܡܲܠܟܘܼܬܘܼܟ݂ ܒܸܬ ܐܵܡܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܲܒܵܪܘܼܬܘܼܟ݂ ܒܸܬ ܗܲܡܙܸܡܝܼ،","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܠܡܲܕܘܼܥܹܐ ܠܒܢܲܝ̈ܢܵܫܵܐ ܓܲܒܵܪ̈ܘܼܝܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܚܸܩܪܵܐ ܕܣܸܩܠܵܐ ܕܡܲܠܟܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܡܲܠܟܘܼܬܘܼܟ݂ ܡܲܠܟܘܼܬܵ‌ܐ ܥܵܠܡܝܼܢܵܝܬܵ‌ܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܫܘܼܠܛܵܢܘܼܟ݂ ܒܟܠܔ ܕܵܪܵܐ ܘܕܵܪܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܣܵܢܹܕ ܡܵܪܝܵܐ ܠܟܠܵܝܗ‌ܝ ܢܵܦܠܵܢܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܡܲܩܸܡ ܠܟܠܵܝܗ‌ܝ ܛܥܝܼ̈ܦܹܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܥܲܝ̈ܢܹܐ ܕܟܠܵܝܗ‌ܝ ܐܸܠܘܼܟ݂ ܟܹܐ ܣܵܦܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܢ݇ܬ ܟܹܐ ܝܵܗܒܹܬ ܠܗܘܿܢ ܡܹܐܟ݂ܘܼܠܬܵܝܗ‌ܝ ܒܥܕܵܢܘܼܗ̇.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܦܵܬܚܹܬ ܐܝܼܕܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܡܲܣܒܸܥܸܬ ܠܨܸܒ݂ܝܵܢܵܐ ܕܟܠܔ ܚܵܝܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܒܟܠܵܝܗ‌ܝ ܐܘܼܪ̈ܚܵܬܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܡܗܘܼܡܢܵܐ ܒܟܠܵܝܗ‌ܝ ܦܘܼܠܚܵܢܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܩܘܼܪܒܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܠܟܠܵܝܗ‌ܝ ܩܵܪ̈ܝܵܢܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܠܟܠܔ ܡ̇ܢ ܕܩܵܪܹܐ ܠܹܗ ܒܫܲܪܝܼܪܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܨܸܒ݂ܝܵܢܵܐ ܕܙܕܝܼܥܘܼ̈ܗ‌ܝ ܟܹܐ ܥܵܒܹܕ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܩܘܲܚܬܵܝܗ‌ܝ ܟܹܐ ܫܵܡܹܥ، ܘܟܹܐ ܦܲܪܸܩ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܢܵܛܹܪ ܡܵܪܝܵܐ ܠܟܠܵܝܗ‌ܝ ܡܲܚܸܒܵܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܠܟܠܵܝܗ‌ܝ ܪ̈ܲܫܝܼܥܹܐ ܒܸܬ ܛܲܠܸܩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܬܸܫܒܘܿܚܬܵ‌ܐ ܕܡܵܪܝܵܐ ܒܸܬ ܗܲܡܙܸܡ ܦܘܼܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܒܲܪܟ݂ܵܐ ܟܠܔ ܓܵܢܵܐ ܫܸܡܵܐ ܕܩܘܼܕܫܹܗ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}