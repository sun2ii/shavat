1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܫܘܼܬܐܸܣܵܝ ܠܹܗ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ،","poem":1},{"lineBreak":true},{"text":"ܝܘܼܗܒܹܠܔ ܠܹܗ ܩܵܢܘܿܢܵܐ ܕܠܹܐ ܒܵܛܹܠܔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܫܲܒܚܘܼܢ ܠܡܵܪܝܵܐ ܡ̣ܢ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܬܲܢܝܼܢܹ̈ܐ ܘܟܠܵܝܗ‌ܝ ܬܗܘܿܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܢܘܼܪܵܐ ܘܒܲܪܕܵܐ، ܬܲܠܓܵܐ ܘܗܵܘܓܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܵܘܚܵܐ ܕܥܲܠܥܵܠܵܐ ܥܵܒ݂ܕܵܢܵܐ ܕܚܲܒܪܹܗ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܛܘܼܪ̈ܵܢܹܐ ܘܟܠܵܝܗ‌ܝ ܪ̈ܘܼܡܝܵܬܹ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܠܵܢܹ̈ܐ ܕܛܥܘܼܢܬܵ‌ܐ ܘܟܠܵܝܗ‌ܝ ܐܲܪ̈ܙܹܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܚܲܝܘܬܵ‌ܐ ܘܟܠܔ ܒܸܩܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܪܸܓ̰ܒܵܐ ܘܛܲܝܪܵܐ ܡܵܪܹܐ ܓܘܼܠܦܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܲܠܟܹ̈ܐ ܕܐܲܪܥܵܐ ܘܟܠܵܝܗ‌ܝ ܐܸܡܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܪ̈ܵܢܹܐ ܘܟܠܵܝܗ‌ܝ ܕܲܝܵܢܹ̈ܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܥܠܲܝܡܹ̈ܐ ܘܐܘܼܦ ܥܠܲܝܡܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܹ̈ܐ ܥܲܡ ܝܵܠܹ̈ܕ݇ܐ ܙܥܘܿܪܹ̈ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܫܲܒܚܝܼ ܠܫܸܡܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܪܝܼܡܵܐ ܝܠܹܗ ܫܸܡܹܗ ܒܢܲܦ̮ܫܹܗ،","poem":1},{"lineBreak":true},{"text":"ܚܸܩܪܹܗ ܥܲܠܔ ܐܲܪܥܵܐ ܘܫܡܲܝܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܘܡܘܼܪܸܡ ܠܹܗ ܚܲܝܠܵܐ ܕܥܲܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܕܝܼܠܹܗ ܬܸܫܒܘܿܚܬܵ‌ܐ ܕܟܠܵܝܗ‌ܝ ܙܲܕܝܼܩܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܕܒܢܲܝ̈ ܐܝܼܣܪܵܐܹܝܠܔ، ܥܲܡܵܐ ܕܩܘܼܪܒܵܐ ܐܸܠܹܗ.","poem":1},{"lineBreak":true},{"text":"ܗܲܠܸܠܘܼܝܵܐ","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/149.json","nextChapterAudioL