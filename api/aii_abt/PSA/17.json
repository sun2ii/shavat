{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"heading","content":["ܨܠܘܬ‌ܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܫܡܹܥ، ܝܵܐ ܡܵܪܝܵܐ، ܠܦܲܪܦܲܠܬܵ‌ܐ ܙܲܕܝܼܩܬܵ‌ܐ، ܨܘܼܬ ܠܡܲܩܘܲܚܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ ܠܨܠܘܿܬ‌ܝܼ، ܕܠܹܐ ܝܠܵܗ̇ ܒܣܸܦܘܵܬܹ̈‌ܐ ܕܦܸܠܡܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܦܵܠܛܵܐ ܕܝܼܘܵܢܝܼ ܡܸܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܥܲܝ̈ܢܘܼܟ݂ ܚܵܙܝܼ ܠܬܪ̈ܘܼܨܘܼܝܵܬܹ‌ܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܒܘܼܚܸܪܘܼܟ݂ ܠܸܒܝܼ، ܣܘܼܚܒܸܪܘܼܟ݂ ܐܸܠܝܼ ܒܠܲܝܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܨܘܼܪܸܦܸܢܘܼܟ݂، ܠܵܐ ܡܘܼܫ݇ܟ̰ܸܚ ܠܘܼܟ݂ ܡܸܢܕܝܼ ܚܸܠܛܵܐ ܒܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕ ܠܝܼ ܩܛܵܥܬܵ‌ܐ ܕܠܹܐ ܚܵܛܹܐ ܦܘܼܡܝܼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܘܼܬ ܦܘܼܠܚܵܢܹ̈ܐ ܕܒܲܪܢܵܫܵܐ، ܐܲܝܟ݂ ܗܹܡܸܙܡܵܢ ܕܣܸܦܘܵܬܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܵܢܵܐ ܢܛܝܼܪܝܼ ܓܵܢܝܼ ܡ̣ܢ ܐܘܼܪ̈ܚܵܬܹ‌ܐ ܕܒܝܼܫܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܩܘܹܐ ܠܗܘܿܢ ܦܵܣܘܿܥܝܵܬ‌ܝܼ̈ ܒܫܒ݂ܝܼܠܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܫܥܝܼܫ ܠܗܘܿܢ ܐܲܩܠܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܐܵܢܵܐ ܩܪܹܐ ܠܝܼ ܐܸܠܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ، ܒܗ̇ܝ ܕܒܸܬ ܓ̰ܲܘܸܒܸܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡܲܟܸܦ ܢܵܬܘܼܟ݂ ܐܸܠܝܼ، ܫܡܹܥ ܠܗܹܡܸܙܡܵܢܝܼ̈.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܡܲܚܙܝܼ ܛܲܝܒܘܼܬܘܼܟ݂ ܒܥܲܓ̰ܝܼܒܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܦܵܪܘܿܩܵܐ ܕܐܵܢܝܼ ܕܡ̣ܢ ܕܸܫ̃ܡܸܢܵܝ̈ܗ‌ܝ ܫܵܩܠܝܼ ܓܵܘܣܵܐ ܒܝܲܡܝܼܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܢܛܘܿܪܝܼ ܐܲܝܟ݂ ܒܹܒܸܠܬܵ‌ܐ ܕܥܲܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܛܸܠܵܢܝܼܬܵ‌ܐ ܕܓܘܼܠܦܵܢܘܼ̈ܟ݂ ܛܲܫܹܝܬ ܠܝܼ؛","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܩܲܕܡ ܒܝܼܫܹ̈ܐ ܕܦܲܪܦܘܼܣܝܼ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܕܸܫ̃ܡܸܢܝܼ̈ ܕܚܲܪܕܝܼ ܠܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܕܒ݂ܝܼܪܘܼܗ‌ܝ ܝܢܵܐ ܠܸܒܵܝܗ‌ܝ ܩܸܫܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܦܘܼܡܵܝܗ‌ܝ ܟܹܐ ܗܲܡܙܸܡܝܼ ܫܘܼܒ݂ܗܵܪܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܚܘܼܪܕܝܼܹܐ ܝܢܵܐ ܐܸܠܝܼ ܐܵܕܝܼܵܐ ܒܦܵܣܘܿܥܝܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܬܸܒ݂ ܠܗܘܿܢ ܥܲܝ̈ܢܵܝܗ‌ܝ ܠܪܲܦܘܼܝܝܼ ܠܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܒܸܕܡܵܝܵܐ ܠܐܲܪܝܵܐ ܕܫܲܗܘܸܬ ܠܸܦܪܵܛܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܓܘܼܪܝܵܐ ܕܐܲܪܝܵܐ ܝܬܝܼܒ݂ܵܐ ܒܣܸܬܵܪܹ̈ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܠܝܼ ܩܲܕܡ ܦܵܬܵܝܗ‌ܝ ܘܡܲܒܪܸܟ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܦܲܨܝܼ ܠܓܵܢܝܼ ܡ̣ܢ ܪ̈ܲܫܝܼܥܹܐ ܒܝܲܕ ܣܲܝܦܘܼܟ݂؛","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܐܢܵܫܹ̈ܐ ܒܝܲܕ ܐܝܼܕܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܐܢܵܫܹ̈ܐ ܕܐܵܗܵܐ ܥܵܠܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܣܵܗܡܵܝܗ‌ܝ ܒܐܲܢܹܐ ܚܲܝܹ̈ܐ ܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܣܝܼܡܬܘܼܟ݂ ܟܹܐ ܡܵܠܹܝܬ ܟܹܪ݇ܣܵܝܗ‌ܝ، ܘܟܹܐ ܣܵܒ݂ܥܝܼ ܒܢܘܿܢܵܝ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܫܵܒ݂ܩܝܼ ܫܲܪܟܵܢܵܐ ܠܝܲܠܘܼܕܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ، ܒܸܬ ܚܵܙܹܝܢ ܠܦܵܬܘܼܟ݂ ܒܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܣܵܒ݂ܥܹܢ ܒܨܘܼܪܬܘܼܟ݂ ܐܝܼܡܲܢ ܕܪܵܥܫܹܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}