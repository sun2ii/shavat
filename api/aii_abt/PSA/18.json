erse","number":5,"content":[{"lineBreak":true},{"text":"ܚܲܒ݂ܠܹ̈ܐ ܕܫܝܘܿܠܔ ܩܵܡ ܚܲܪܕܝܼ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܬܦܝܼܩ ܠܗܘܿܢ ܒܝܼܝܼ ܢܸܫܒܹ̈ܐ ܕܡܵܘܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܥܝܼܩ ܠܵܗ̇ ܐܸܠܝܼ، ܩܪܹܐ ܠܝܼ ܠܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܘܼܩܘܸܚ ܠܝܼ ܠܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܫܡܝܼܥ ܠܹܗ ܡ̣ܢ ܗܲܝܟܠܹܗ ܩܵܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܥܵܝܬ‌ܝܼ ܩܲܕܡܘܼܗ‌ܝ ܡܛܹܐ ܠܵܗ̇ ܠܢܵܬܝܵܬܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܫܥܝܼܫ ܠܵܗ̇ ܘܕܘܼܪܘܸܕ ܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܪܓܝܼܕ ܠܗܘܿܢ ܘܫܥܝܼܫ ܠܗܘܿܢ ܒܸܢܝܲܬܹ̈‌ܐ ܕܛܘܼܪ̈ܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܚܸܡܬܵ‌ܐ ܕܟܲܪܒܹܗ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܣܝܼܩ ܠܹܗ ܬܸܢܵܐ ܡ̣ܢ ܢܵܚܝܼܪܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܢܘܼܪܵܐ ܐܵܟ݂ܘܿܠܵܐ ܡ̣ܢ ܦܘܼܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܡܪܹ̈ܐ ܠܒ݂ܝܼܟ݂ ܠܗܘܿܢ ܡܸܢܹܗ،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܘܼܟܸܦ ܠܹܗ ܫܡܲܝܹ̈ܐ ܘܨܠܹܐ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܟܲܕ ܥܲܝܒ݂ܵܐ ܚܸܫܟܵܢܬܵ‌ܐ ܬܚܘܿܬ ܐܲܩܠܵܬܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܪܟܝܼܒ݂ ܠܹܗ ܥܲܠܔ ܟܪܘܿܒ݂ܵܐ ܘܦܪܝܼܚ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܣܛܹܐ ܠܹܗ ܥܲܠܔ ܓܘܼܠܦܵܢܹ̈ܐ ܕܦܵܘܚܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕ ܠܹܗ ܠܚܸܫܟܵܐ ܣܸܬܵܪܹܗ، ܡܛܲܠܠܹܗ ܚܵܕܸܪ̈ܘܵܢܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܠܚܸܫܟܵܐ ܕܡ̈ܝܼܵܐ، ܥܲܝܒ݂ܵܬܹ̈‌ܐ ܕܪܩܝܼܥܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܫܲܦ̮ܩܵܐ ܕܩܲܕܡ ܦܵܬܹܗ ܥܲܝܒ݂ܵܬܘܼ̈ܗ‌ܝ ܡܘܼܥܪܹܐ ܠܗܘܿܢ","poem":1},{"lineBreak":true},{"text":"ܒܲܪܕܵܐ ܘܓܘܼܡܪܹ̈ܐ ܕܢܘܼܪܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܘܩܘܼܪܩܸܡ ܠܹܗ ܒܫܡܲܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܸܠܵܝܵܐ ܝܘܼܗܒܹܠܔ ܠܹܗ ܩܵܠܹܗ،","poem":1},{"lineBreak":