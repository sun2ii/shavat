{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܒܚܲܝܠܘܼܟ݂ ܟܹܐ ܚܵܕܹܐ ܡܲܠܟܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܦܘܼܪܩܵܢܘܼܟ݂ ܟܡܵܐ ܪܵܒܵܐ ܟܹܐ ܦܵܨܹܚ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܛܠܵܒܬܵ‌ܐ ܕܠܸܒܹܗ ܝܘܼܗܒܹܠܔ ܠܘܼܟ݂ ܐܸܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܵܥܘܼܬܵ‌ܐ ܕܣܸܦܘܵܬܘܼ̈ܗ‌ܝ ܠܵܐ ܡܘܼܟܠܹܐ ܠܘܼܟ݂. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܟܹܐ ܡܲܬܦܸܩܸܬ ܒܝܼܹܗ ܒܘܼܪ̈ܟܵܬܹ‌ܐ ܛܵܒܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܬܒܸܬ ܒܪܹܝܫܹܗ ܬܵܓ݂ܵܐ ܕܕܲܗܒ݂ܵܐ ܨܸܦܝܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܚܲܝܹ̈ܐ ܛܠܝܼܒ ܠܹܗ ܡܸܢܘܼܟ݂ ܘܝܘܼܗܒܹܠܔ ܠܘܼܟ݂ ܐܸܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܝܵܘܡܵܢܹ̈ܐ ܝܲܪ̈ܝܼܟܹܐ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܓܘܼܪܵܐ ܝܠܹܗ ܐܝܼܩܵܪܹܗ ܒܦܘܼܪܩܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܚܸܩܪܵܐ ܘܙܲܗܝܘܼܬܵ‌ܐ ܟܹܐ ܡܲܬܒܸܬ ܥܲܠܘܼܗ‌ܝ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܟܹܐ ܡܲܬܒܸܬ ܐܸܠܹܗ ܒܘܼܪ̈ܟܵܬܹ‌ܐ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܚܕܸܝܬ ܠܹܗ ܒܦܨܵܚܬܵ‌ܐ ܕܗܸܙܘܼܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܲܠܟܵܐ ܒܸܣܒܵܪܵܐ ܝܠܹܗ ܒܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܛܲܝܒܘܼܬܵ‌ܐ ܕܥܸܠܵܝܵܐ ܠܹܐ ܫܵܥܹܫ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܲܫ݇ܟ̰ܚܵܐ ܐܝܼܕܘܼܟ݂ ܠܟܠܵܝܗ‌ܝ ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܲܡܝܼܢܘܼܟ݂ ܡܲܫ݇ܟ̰ܚܵܐ ܠܣܵܢܝܵܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒ݂ܕܹܬ ܠܗܘܿܢ ܐܲܝܟ݂ ܐܲܬܘܼܢܵܐ ܕܢܘܼܪܵܐ ܒܥܕܵܢܵܐ ܕܡܲܒܝܲܢܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܒܚܸܡܬܹܗ ܒܸܬ ܒܵܠܹܥ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܘܢܘܼܪܵܐ ܒܸܬ ܐܵܟܹܠܔ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܝܵܠܵܕ݇ܝ̈ܗ‌ܝ ܡ̣ܢ ܐܲܪܥܵܐ ܒܸܬ ܛܲܠܩܸܬ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܪ̈ܥܵܝܗ‌ܝ ܡ̣ܢ ܒܢܲܝ̈ܢܵܫܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܬܘܼܚܡܸܢܗܘܿܢ ܥܲܠܘܼܟ݂ ܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܚܫܝܼܒ݂ ܠܗܘܿܢ ܦܸܠܡܵܐ، ܐܝܼܢܵܐ ܠܹܐ ܡܵܨܝܼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܸܬ ܡܲܥܒܸܕܸܬ ܠܗܘܿܢ ܕܥܵܪܩܝܼ،","poem":1},{"lineBreak":true},{"text":"ܩܸܫܬܘܼܟ݂ ܒܸܬ ܗܲܕܪܸܬ ܠܦܵܬܘܵܬܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܪܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ، ܒܥܘܼܫܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܫܲܒܚܲܚ ܘܙܵܡܪܲܚ ܓܲܒܵܪܘܼܬܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}