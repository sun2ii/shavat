t":"ܣܵܒܵܒ ܐܲܢ݇ܬ ܝܼܘܸܬ ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܘܼܟ݂ ܣܦܝܼܪܝܼ ܟܠܹܗ ܝܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ ܪ̈ܲܚܡܘܼܟ݂ ܡܵܪܝܵܐ ܘܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡ̣ܢ ܥܵܠܲܡ ܝܼܢܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܚܛܵܗܹ̈ܐ ܕܥܠܲܝܡܘܼܬ‌ܝܼ ܘܓܢܵܗ‌ܝܼ̈ ܠܵܐ ܕܵܟ݂ܪܹܬ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܛܲܝܒܘܼܬܘܼܟ݂ ܕܟ݂ܘܿܪ ܐܸܠܝܼ ܐܲܢ݇ܬ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܚܵܬܸܪ ܕܛܵܒ݂ܘܼܬܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܛܵܒ݂ܵܐ ܘܬܪܘܼܨܵܐ ܝܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܐܵܗܵܐ ܟܹܐ ܬܲܠܡܸܕ ܚܲܛܵܝܹ̈ܐ ܒܐܘܼܪܚܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܗܲܕܹܐ ܠܡܲܟܝܼܟܹ̈ܐ ܒܕܝܼܘܵܢ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܠܸܦ ܠܡܲܟܝܼܟܹ̈ܐ ܐܘܼܪܚܹܗ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܛܲܝܒܘܼܬܵ‌ܐ ܘܫܲܪܝܼܪܘܼܬܵ‌ܐ ܝܢܵܐ ܟܠܵܝܗ‌ܝ ܐܘܼܪ̈ܚܵܬܹ‌ܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܢܵܛܪ̈ܵܢܹܐ ܕܘܲܥܕܹܗ ܘܣܵܗܕܘܵܬܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܘܼܬ ܫܸܡܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܠܥܵܘܠܝܼ ܒܗ̇ܝ ܕܝܼܠܹܗ ܓܘܼܪܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܠܹܗ ܙܕܝܼܥܵܐ ܕܡܵܪܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܠܸܦ ܠܹܗ ܐܘܼܪܚܵܐ ܕܓܲܒܹܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܓܵܢܹܗ ܒܛܵܒ݂ܬܵ‌ܐ ܒܸܬ ܫܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܪܥܹܗ ܒܸܬ ܝܵܪܹܬ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܫܵܘܬܵܦܘܼܬܵ‌ܐ ܕܡܵܪܝܵܐ ܥܲܡ ܙܕܝܼܥܘܼ̈ܗ‌ܝ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܘܲܥܕܹܗ ܒܸܬ ܡܲܕܸܥ ܐܸܠܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܥܲܝܢܝܼ̈ ܐܲܡܝܼܢܵܐܝܼܬ ܠܡܵܪܝܵܐ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗ̇ܘ ܒܸܬ ܦܲܠܸܛ ܠܗܘܿܢ ܐܲܩܠܝܼ̈ ܡ̣ܢ ܓܲܪܕܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܕܘܼܪ ܠܟܸܣܠܝܼ ܘܪܲܚܸܡ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܒܢܲܦ̮ܫܝܼ ܝܘܸܢ ܘܡܸܣܟܹܢܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܥܵܘܩܵܢܹ̈ܐ ܕܠܸܒܝܼ ܙܝܼܕ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܐܘܼܠܨܵܢܝܼ ܦܲܠܸܛ ܠܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܚܙܝܼ ܥܵܘܩܵܢܝܼ ܘܥܲܡܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܦܲܚܸܠܔ ܠܟܠܵܝܗ‌ܝ ܚܛܝܼܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܚܙܝܼ ܠܕܸܫ̃ܡܸܢܝܼ̈ ܕܙܝܼܕܹܐ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܣܢܵܝܬܵ‌ܐ ܚܸܡܬܵܢܬܵ‌ܐ ܩܵܡ ܣܵܢܝܼ ܠܝܼ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܢܛܘܿܪ ܓܵܢܝܼ ܘܦܲܨܝܼ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܫܵܒ݂ܩܹܬ ܢܵܟ݂ܦܹܢ ܒܗ̇ܝ ܕܫܩܝܼܠܔ ܠܝܼ ܓܵܘܣܵܐ ܒܝܼܘܼܟ݂.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܬܲܡܝܼܡܘܼܬܵ‌ܐ ܘܬܪܘܼܨܘܼܬܵ‌ܐ ܚܲܡܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܣܦܝܼܪܝܼ ܥܲܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܦܲܪܸܩ، ܝܵܐ ܐܲܠܵܗܵܐ، ܠܐܝܼܣܪܵܐܹܝܠܔ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܟܠܵܝܗ‌ܝ ܥܵܘܩܵܢܘܼ̈ܗ‌ܝ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}