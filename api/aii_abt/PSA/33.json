{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"ܡܲܩܘܸܚܘܼܢ ܠܡܵܪܝܵܐ، ܝܵܐ ܙܲܕܝܼܩܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܬܪ̈ܘܼܨܹܐ ܚܫܝܼܚܬܵ‌ܐ ܝܠܵܗ̇ ܬܸܫܒܘܿܚܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܫܲܟܪܘܼܢ ܠܡܵܪܝܵܐ ܒܟܸܢܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܩܝܼܬܵܪܵܐ ܕܥܸܣܪܵܐ ܣܝܼܡܹ̈ܐ ܙܡܘܿܪܘܼܢ ܐܸܠܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܙܡܘܿܪܘܼܢ ܐܸܠܹܗ ܙܡܵܪܬܵ‌ܐ ܚܲܕܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܨܦܵܝܝܼ ܡܚܹܝܡܘܼܢ ܥܲܡ ܩܲܘܲܚܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܬܪܘܼܨܵܐ ܝܠܹܗ ܚܲܒܪܵܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܡܗܘܼܡܢܘܼܬܵ‌ܐ ܝܠܹܗ ܟܠܹܗ ܦܘܼܠܚܵܢܹܗ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܲܚܸܒ ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܘܕܝܼܘܵܢ،","poem":1},{"lineBreak":true},{"text":"ܡܠܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܐܲܪܥܵܐ ܛܲܝܒܘܼܬܵ‌ܐ ܕܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܒܗܹܡܸܙܡܵܢ ܕܡܵܪܝܵܐ ܫܡܲܝܹ̈ܐ ܦܝܼܫ ܠܗܘܿܢ ܥܒ݂ܝܼܕܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܢܫܲܡܬܵ‌ܐ ܕܦܘܼܡܹܗ ܟܠܹܗ ܚܲܝܠܵܘܵܬܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܓ̰ܲܡܸܥ ܐܲܝܟ݂ ܩܘܼܚܵܐ ܡ̈ܝܼܵܐ ܕܝܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܬܸܒ݂ ܒܐܲܢܒܵܪܹ̈ܐ ܬܗܘܿܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܙܵܕܥܵܐ ܡ̣ܢ ܡܵܪܝܵܐ ܟܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܸܢܹܗ ܪܲܬܪܸܬ‌ܝܼ ܟܠܵܝܗ‌ܝ ܥܵܡܪ̈ܵܢܹܐ ܕܒܪܝܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗ̇ܘ ܐܡܝܼܪܹܗ ܘܗܘܹܐ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܦܩܝܼܕ ܠܹܗ ܘܟܠܹܐ ܠܵܗ̇.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܟܹܐ ܫܵܡܹܛ ܡܸܠܟܵܐ ܕܐܸܡܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܒܲܛܸܠܔ ܚܘܼܫܵܒܹ̈ܐ ܕܥܲܡܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܸܠܟܵܐ ܕܡܵܪܝܵܐ ܠܥܵܠܲܡ ܒܸܬ ܟܵܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܚܘܼܫܵܒܹ̈ܐ ܕܠܸܒܹܗ ܠܕܵܪܵܐ ܘܕܵܪܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܘܼܡܬܵ‌ܐ ܕܡܵܪܝܵܐ ܝܠܹܗ ܐܲܠܵܗܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܥܲܡܵܐ ܕܓܘܼܒܹܐ ܠܹܗ ܠܝܵܪܬܘܼܬܵ‌ܐ ܐܸܠܹܗ،","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܫܡܲܝܵܐ ܓܘܼܫܸܩ ܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܙܹܐ ܠܹܗ ܠܟܠܵܝܗ‌ܝ ܒܢܲܝ̈ܢܵܫܵܐ،","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܕܘܼܟܵܐ ܕܝܬܵܒ݂ܬܹܗ ܚܝܼܪܹܗ","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܟܠܵܝܗ‌ܝ ܥܵܡܪ̈ܵܢܹܐ ܕܐܲܪܥܵܐ،","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܓܵܒ݂ܠܵܢܵܐ ܕܠܸܒܵܐ ܕܟܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܕܦܲܪܡܹܐ ܟܠܵܝܗ‌ܝ ܥܒ݂ܵܕܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܠܲܝܬ ܡܲܠܟܵܐ ܕܦܝܼܫ ܠܹܗ ܦܘܼܪܩܵܐ ܒܓܘܼܪܘܼܬܵ‌ܐ ܕܚܲܝܠܵܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܓܲܒܵܪܵܐ ܠܹܐ ܦܵܐܹܫ ܦܘܼܨܝܵܐ ܒܓܘܼܪܘܼܬܵ‌ܐ ܕܚܲܝܠܹܗ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܕܘܼܓܠܵܐ ܝܠܹܗ ܣܘܼܣܵܐ ܩܵܐ ܦܲܪܲܩܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܓܘܼܪܘܼܬܵ‌ܐ ܕܚܲܝܠܹܗ ܠܹܐ ܡܵܨܹܐ ܚܲܠܸܨ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܥܲܝܢܵܐ ܕܡܵܪܝܵܐ ܠܙܕܝܼܥܘܼ̈ܗ‌ܝ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܠܐܵܢܝܼ ܕܣܵܦܪܝܼ ܠܛܲܝܒܘܼܬܹܗ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܠܦܲܨܘܼܝܹܐ ܡ̣ܢ ܡܵܘܬܵ‌ܐ ܓܵܢܵܬܵܝ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܠܡܲܚܘܼܝܵܝ ܒܙܲܒ݂ܢܵܐ ܕܟܸܦܢܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܓܵܢܲܢ ܣܦܝܼܪܵܗ̇ ܠܡܵܪܝܵܐ، ܗܲܝܲܪܬܲܢ ܘܡܵܛܵܠܲܢ ܗ̇ܘ ܝܼܠܹܗ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܝܼܹܗ ܒܸܬ ܚܵܕܹܐ ܠܸܒܲܢ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܫܸܡܵܐ ܕܩܘܼܕܫܹܗ ܣܒܝܼܪܲܢ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܵܐ ܛܲܝܒܘܼܬܘܼܟ݂ ܥܲܠܲܢ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܵܐܟ݂ܝܼ ܕܣܦܝܼܪܲܢ ܐܸܠܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}