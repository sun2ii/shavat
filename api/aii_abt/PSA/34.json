lineBreak":true},{"text":"ܘܦܵܬܘܵܬܵܝ̈ܗ‌ܝ ܠܹܐ ܦܵܝܫܝܼ ܢܟ݂ܝܼܦܹܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܐܵܗܵܐ ܡܸܣܟܹܢܵܐ ܩܪܹܐ ܠܹܗ، ܘܡܵܪܝܵܐ ܫܡܝܼܥ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܟܠܵܝܗ‌ܝ ܐܘܼܠܨܵܢܘܼ̈ܗ‌ܝ ܦܘܼܪܸܩ ܠܹܗ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܵܚܹܐ ܡܲܫܪܝܼܬܵ‌ܐ ܡܲܠܲܐܟ݂ܵܐ ܕܡܵܪܝܵܐ ܚܵܕܸܪ̈ܘܵܢܹܐ ܕܙܕܝܼܥܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܦܲܨܹܐ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܛܥܘܿܡܘܼܢ ܘܚܙܹܝܡܘܼܢ ܕܛܵܒ݂ܵܐ ܝܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܢܵܫܵܐ ܕܫܵܩܹܠܔ ܓܵܘܣܵܐ ܒܝܼܹܗ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܙܕܹܥܡܘܼܢ ܡ̣ܢ ܡܵܪܝܵܐ، ܝܵܐ ܩܲܕܝܼܫܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܲܝܬ ܚܘܼܣܪܵܢܵܐ ܠܙܕܝܼܥܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܓܘܼܪ̈ܝܹܐ ܕܐܲܪܝܵܐ ܡܘܼܣܟܸܢܗܘܿܢ ܘܟܦܝܼܢܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܝܼ ܕܛܵܥܝܼ ܠܡܵܪܝܵܐ ܠܹܐ ܚܵܣܪܝܼ ܟܠܔ ܛܵܒ݂ܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܬܹܝܡܘܼܢ ܒܢܘܿܢܹ̈ܐ، ܫܡܹܥܡܘܼܢ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܙܕܘܼܥܬܵ‌ܐ ܕܡܵܪܝܵܐ ܡܲܠܦܸܢܵܘܟ݂ܘܿܢ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܠܹܗ ܐܢܵܫܵܐ ܕܒܵܣܡܝܼ ܠܹܗ ܚܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܕܡܲܚܸܒ ܝܵܘܡܵܢܹ̈ܐ ܠܸܚܙܵܝܵܐ ܛܵܒ݂ܬܵ‌ܐ؟","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܢܛܘܿܪ ܠܸܫܵܢܘܼܟ݂ ܡ̣ܢ ܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܸܦܘܵܬܘܼ̈ܟ݂ ܡ̣ܢ ܗܲܡܙܘܼܡܹܐ ܦܸܠܡܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܩܠܘܿܒ ܡ̣ܢ ܒܝܼܫܬܵ‌ܐ ܘܥܒ݂ܘܿܕ ܛܵܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܛܥܝܼ ܫܠܵܡܵܐ ܘܢܦܘܿܠܔ ܒܵܬܪܹܗ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܥܲܝ̈ܢܹܐ ܕܡܵܪܝܵܐ ܠܙܲܕܝܼܩܹ̈ܐ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܢܵܬܝܵܬܘܼ̈ܗ‌ܝ ܠܓܥܵܝܬܵܝܗ‌ܝ،","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܦܵܬܵ‌ܐ ܕܡܵܪܝܵܐ ܕܲܠܩܘܼܒ݂ܠܔ ܕܥܵܒ݂ܕܵܢܹ̈ܐ ܕܒܝܼܫܬܵ‌ܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܠܸܩܛܵܥܵܐ ܡ̣ܢ ܐܲܪܥܵܐ ܕܟ݂ܵܪܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܡܘܼܩܘܸܚ ܠܗܘܿܢ ܘܡܵܪܝܵܐ ܫܡܝܼܥ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܟܠܵܝܗ‌ܝ ܐܘܼܠܨܵܢܵܝ̈ܗ‌ܝ ܦܘܼܨܝܵܝ ܠܹܗ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܩܘܼܪܒܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܠܬܒ݂ܝܼܪܹ̈ܐ ܕܠܸܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܡܲܟܝܼܟܹ̈ܐ ܒܪܘܼܚܵܐ ܟܹܐ ܦܲܪܸܩ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܪܵܒܵܐ ܝܢܵܐ ܥܵܘܩܵܢܹ̈ܐ ܕܙܲܕܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܟܠܵܝܗ‌ܝ ܟܹܐ ܦܲܨܹܐ ܠܹܗ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܢܵܛܹܪ ܠܟܠܵܝܗ‌ܝ ܓܲܪ̈ܡܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܚܲܕ ܠܵܐ ܦܝܼܫ ܠܹܗ ܬܒ݂ܝܼܪܵܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܒܝܼܫܬܵ‌ܐ ܒܸܬ ܡܲܡܝܸܬܵ‌ܐ ܠܪܲܫܝܼܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܢܝܵܢܹ̈ܐ ܕܙܲܕܝܼܩܵܐ ܒܸܬ ܗܵܘܝܼ ܚܲܝܵܒܹ̈ܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܦܲܪܸܩ ܡܵܪܝܵܐ ܓܵܢܵܐ ܕܪܹ̈ܓܵܘܵܬܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܗܵܘܝܼ ܚܲܝܵܒܹ̈ܐ ܟܠܵܝܗ‌ܝ ܐܵܢܝܼ ܕܫܵܩܠܝܼ ܓܵܘܣܵܐ ܒܝܼܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}