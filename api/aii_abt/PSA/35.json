{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܟܠܝܼ ܒܕܝܼܘܵܢ، ܝܵܐ ܡܵܪܝܵܐ، ܩܲܕܡ ܐܵܢܝܼ ܕܥܵܒ݂ܕܝܼ ܕܝܼܘܵܢ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܠܘܿܫ ܥܲܡ ܦܵܠܫܵܢܹ̈ܐ ܥܲܡܝܼ،","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܕܒ݂ܘܿܩ ܡܵܛܵܠܵܐ ܘܣܲܟܪܵܐ، ܘܩܘܼܡ ܠܗܲܝܲܪܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܘܓܪܘܿܫ ܪܘܼܡܚܵܐ ܘܕܒ݂ܘܿܩ ܠܐܘܼܪܚܵܐ ܕܢܵܦܠܵܢܹ̈ܐ ܒܵܬܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܡܘܿܪ ܠܓܵܢܝܼ: ”ܐܵܢܵܐ ܝܘܸܢ ܦܘܼܪܩܵܢܵܟ݂ܝ.“","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܘܦܵܝܫܝܼ ܡܘܼܢܟܸܦܹܐ ܛܵܥܝܵܢܹ̈ܐ ܠܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܵܝܫܝܼ ܡܘܼܕܸܪܹܐ ܠܒܵܬܪܵܐ ܘܡܘܼܢܟܸܦܹܐ ܐܵܢܝܼ ܕܬܲܚܡܘܼܢܹܐ ܝܢܵܐ ܠܸܥܒ݂ܵܕܵܐ ܒܝܼܫܬܵ‌ܐ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܼ ܐܲܝܟ݂ ܬܸܒ݂ܢܵܐ ܩܲܕܡ ܦܵܘܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܠܲܐܟ݂ܵܐ ܕܡܵܪܝܵܐ ܚܲܪܙܘܼܦܵܝ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܵܐ ܐܘܼܪܚܵܝܗ‌ܝ ܚܸܫܟܵܐ ܘܡܲܓ̰ܪ̈ܲܛܝܵܬܹ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܠܲܐܟ݂ܵܐ ܕܡܵܪܝܵܐ ܒܸܢܦܵܠܵܐ ܒܵܬܪܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܠܵܐ ܥܸܠܬܵ‌ܐ ܛܘܼܫܹܐ ܠܗܘܿܢ ܐܸܠܝܼ ܓܲܪܕܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܥܸܠܬܵ‌ܐ ܚܦܝܼܪܗܘܿܢ ܓܘܼܒܵܐ ܠܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܵܬܹ‌ܐ ܥܲܠܘܼܗ‌ܝ ܚܪܵܒ݂ܵܐ ܒܠܵܐ ܣܦܵܪܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܵܒܹܩ ܐܸܠܹܗ ܓܲܪܕܵܐ ܕܛܘܼܫܹܐ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܢܵܦܹܠܔ ܒܝܼܹܗ ܠܚܪܵܒ݂ܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܘܓܵܢܝܼ ܒܸܬ ܦܵܨܚܵܐ ܒܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܨܵܚܵܐ ܒܸܬ ܦܵܨܚܵܐ ܒܦܘܼܪܩܵܢܹܗ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܟܠܵܗ̇ ܓܵܢܝܼ ܒܸܬ ܐܵܡܪܵܐ: ”ܝܵܐ ܡܵܪܝܵܐ، ܡܵܢܝܼ ܐܝܼܬ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂؟","poem":1},{"lineBreak":true},{"text":"ܦܲܨܝܵܢܵܐ ܠܡܸܣܟܹܢܵܐ ܡ̣ܢ ܚܲܕ ܒܘܼܫ ܙܲܪܒܵܢܵܐ ܡܸܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܠܡܸܣܟܹܢܵܐ ܘܠܣܢܝܼܩܵܐ ܡ̣ܢ ܚܵܛܘܿܦܹܗ.“","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܩܵܝܡܝܼ ܣܵܗܕܹ̈ܐ ܣܸܪ̈ܝܹܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܨܲܚܨܹܐ ܠܝܼ ܒܘܼܬ ܡܸܢܕܝܼ ܕܠܹܐ ܝܵܕܥܹܢ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܦܵܪܥܝܼ ܠܝܼ ܒܝܼܫܬܵ‌ܐ ܡܓܹܒܵܐ ܕܛܵܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܸܥܒ݂ܵܕܘܼܗ̇ ܡܘܼܫܲܡܸܪ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ، ܟܲܕ ܡܪܝܼܥ ܠܗܘܿܢ ܠܒ݂ܝܼܫ ܠܝܼ ܣܲܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܥܝܸܩܵܐ ܠܝܼ ܒܨܵܘܡܵܐ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܨܠܘܿܬ‌ܝܼ ܠܚܦܵܩܝܼ ܕܝܼܪܵܗ̇.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܠܚܲܒ݂ܪܝܼ، ܐܲܝܟ݂ ܠܐܲܚܘܿܢܝܼ، ܚܕܝܼܪܝܼ ܠܸܥܒ݂ܵܕܵܐ ܐܸܒ݂ܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܥܵܒ݂ܕܵܢܵܐ ܕܬܵܥܙܝܼ ܠܝܸܡܵܐ، ܠܒ݂ܝܼܫܵܐ ܟܘܼܡܵܐ، ܡܘܼܟܸܦܵܐ ܠܝܼ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܒܬܲܪܩܲܠܬ‌ܝܼ ܦܨܝܼܚ ܠܗܘܿܢ ܘܓ̰ܡܝܼܥ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܓ̰ܡܝܼܥ ܠܗܘܿܢ ܥܲܠܝܼ ܡܵܚܝܵܢܝܼ̈ ܘܠܵܐ ܝܕܝܼܥ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܘܼܪܦܸܛܸܢܗܘܿܢ ܘܠܵܐ ܫܠܹܐ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܚܲܢܦܹ̈ܐ ܡܲܣܚܘܼܪܹܐ ܡܘܼܣܚܸܪܗܘܿܢ ܒܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܚܲܪܚܘܼܟ̰ܹܐ ܟܹܟܵܝ̈ܗ‌ܝ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܟܡܵܐ ܒܸܬ ܗܵܘܹܝܬ ܓܲܫܘܼܩܹܐ،","poem":1},{"lineBreak":true},{"text":"ܦܲܨܝܼ ܓܵܢܝܼ ܡ̣ܢ ܚܪ̈ܵܒ݂ܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܓܘܼܪ̈ܝܹܐ ܕܐܲܪ̈ܝܹܐ ܝܼܚܝܼܕܵܝܘܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܸܢܘܼܟ݂ ܓܵܘ ܟܸܢܫܵܐ ܓܘܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܓܵܘ ܥܲܡܵܐ ܙܲܪܒܵܢܵܐ ܒܸܬ ܫܲܒܚܸܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܚܵܕܝܼ ܥܲܠܝܼ ܕܸܫ̃ܡܸܢܝܼ̈ ܕܒܕܘܼܓܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܢܝܵܢܝܼ̈ ܕܠܵܐ ܥܸܠܬܵ‌ܐ ܠܵܐ ܠܵܟܙܝܼ ܥܲܝܢܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܗܲܡܙܸܡܝܼ ܫܠܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܠܔ ܫܸܠܝܹ̈ܐ ܕܒܐܲܪܥܵܐ ܟܹܐ ܚܵܫܒ݂ܝܼ ܦܸܠܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܘܡܘܼܪܘܸܚ ܠܗܘܿܢ ܦܘܼܡܵܝܗ‌ܝ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܡܝܼܪܗܘܿܢ: ”ܐܲܗܵܐ! ܐܲܗܵܐ! ܚܙܹܐ ܠܗܘܿܢ ܥܲܝܢܲܢ̈.“","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܚܙܹܐ ܠܘܼܟ݂ ܡܵܪܝܵܐ، ܠܵܐ ܗܵܘܹܝܬ ܫܬܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܠܵܐ ܪܵܚܩܹܬ ܡܸܢܝܼ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܪܥܘܿܫ ܘܬܥܘܿܪ ܠܕܝܼܘܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ ܘܡܵܪܝܼ، ܠܨܒ݂ܘܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܠܵܗ̇ ܕܝܼܘܵܢܝܼ ܐܲܝܟ݂ ܙܲܕܝܼܩܘܼܬܘܼܟ݂، ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܚܵܕܝܼ ܒܝܼܝܼ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܐܵܡܪܝܼ ܒܠܸܒܵܝܗ‌ܝ: ”ܐܲܗܵܐ! ܗܘܹܐ ܠܹܗ ܨܸܒ݂ܝܵܢܵܐ ܕܓܵܢܲܢ.","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܐܵܡܪܝܼ: ܒܠܝܼܥ ܠܲܢ ܐܸܠܹܗ.“","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܘܦܵܝܫܝܼ ܡܘܼܢܟܸܦܹܐ ܟܠܵܝܗ‌ܝ ܡܸܚܕܵܕܹ̈ܐ ܚܵܕܝܵܢܹ̈ܐ ܠܒܝܼܫܓܲܕܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܵܒ݂ܫܝܼ ܢܟ݂ܝܼܦܬܵ‌ܐ ܘܦܵܝܫܝܼ ܡܘܼܢܟܸܦܹܐ ܓܲܪ̈ܘܸܣܵܢܹܐ ܕܓܵܢܵܝܗ‌ܝ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܡܲܩܘܸܚܝܼ ܘܦܵܨܚܝܼ ܐܵܢܝܼ ܕܒܵܣܡܵܐ ܠܗܘܿܢ ܒܙܲܕܝܼܩܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܡܝܼܢܵܐܝܼܬ ܐܵܡܪܝܼ: ”ܓܘܼܪܵܐ ܝܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܕܒܵܣܡܵܐ ܠܹܗ ܒܫܠܵܡܵܐ ܕܪܹܓܹܗ.“","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܘܠܸܫܵܢܝܼ ܒܸܬ ܗܲܡܙܸܡ ܙܲܕܝܼܩܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܠܹܗ ܝܵܘܡܵܐ ܬܸܫܒܘܿܚܬܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}