{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ ܪܓܐ ܕܡܪܝܐ."]},{"type":"verse","number":1,"content":[{"text":"ܥܵܘܠܵܐ ܟܹܐ ܚܵܫܹܒ݂ ܪܲܫܝܼܥܵܐ ܒܓܵܘܵܐ ܕܠܸܒܹܗ،","poem":1},{"lineBreak":true},{"text":"ܠܲܝܬ ܙܕܘܼܥܬܵ‌ܐ ܕܐܲܠܵܗܵܐ ܩܲܕܡ ܥܲܝܢܘܼ̈ܗ‌ܝ،","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܡܲܫܦܸܪܵܗ̇ ܓܵܢܹܗ ܒܥܲܝܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܗܵܕܵܐ ܕܠܵܐ ܡܲܫ݇ܟ̰ܸܚ ܠܥܵܘܠܹܗ ܘܣܵܢܹܐ ܠܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܗܹܡܸܙܡܵܢܹ̈ܐ ܕܦܘܼܡܹܗ ܥܵܘܠܵܐ ܘܦܸܠܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܠܹܐ ܠܹܗ ܡ̣ܢ ܠܦܲܪܡܘܼܝܹܐ ܘܠܸܥܒ݂ܵܕܵܐ ܛܵܒ݂ܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܥܵܘܠܵܐ ܟܹܐ ܬܲܚܡܸܢ ܥܲܠܔ ܫܘܝܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܟܵܠܹܐ ܥܲܠܔ ܐܘܼܪܚܵܐ ܠܵܐ ܨܦܵܝܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܝܼܫܬܵ‌ܐ ܠܹܐ ܡܲܣܠܹܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܗܲܠܔ ܫܡܲܝܵܐ ܝܠܵܗ̇ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܗܲܠܔ ܥܢܵܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܐܲܝܟ݂ ܛܘܼܪ̈ܵܢܹܐ ܕܐܲܠܵܗܵܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܕܝܼܘܵܢܘܼ̈ܟ݂ ܐܲܝܟ݂ ܬܗܘܿܡܵܐ ܓܘܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܲܪܢܵܫܵܐ ܘܗܲܝܘܵܢ ܟܹܐ ܦܲܪܩܸܬ، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܟܡܵܐ ܝܲܩܝܼܪܬܵ‌ܐ ܝܠܵܗ̇ ܛܲܝܒܘܼܬܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܢܲܝ̈ܢܵܫܵܐ ܒܛܸܠܵܢܝܼܬܵ‌ܐ ܕܓܘܼܠܦܵܢܘܼ̈ܟ݂ ܟܹܐ ܫܵܩܠܝܼ ܓܵܘܣܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܫܵܬ‌ܝܼ ܣܒ݂ܵܥܬܵܝܗ‌ܝ ܡ̣ܢ ܫܲܡܝܼܢܘܼܬܵ‌ܐ ܕܒܲܝܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܢܲܗܪܵܐ ܕܒܲܣܝܼܡܘܼܝܵܬ̈ܘܼܟ݂ ܟܹܐ ܡܲܫܬܹܝܬ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܥܲܡܘܼܟ݂ ܝܼܠܹܗ ܡܲܒܘܼܥܵܐ ܕܚܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܒܲܗܪܘܼܟ݂ ܟܹܐ ܚܵܙܲܚ ܒܲܗܪܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܲܪܝܸܟ݂ ܛܲܝܒܘܼܬܘܼܟ݂ ܠܝܵܕܥܵܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܠܬܪ̈ܘܼܨܹܐ ܕܠܸܒܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܐܵܬܝܵܐ ܥܲܠܝܼ ܐܲܩܠܵܐ ܕܫܲܒ݂ܗܸܪ̈ܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܝܼܕܵܐ ܕܪ̈ܲܫܝܼܥܹܐ ܠܵܐ ܫܵܥܫܵܐ ܠܝܼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܬܵܡܵܐ ܢܦܝܼܠܔ ܠܗܘܿܢ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܗܘܿܢ ܚܘܼܪܙܸܦܹܐ ܘܠܹܐ ܡܵܨܝܼ ܩܵܝܡܝܼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}