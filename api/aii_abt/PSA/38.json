{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ ܕܕܘܝܕ. ܠܕܘܟ݂ܪܢܐ."]},{"type":"verse","number":1,"content":[{"text":"ܒܟܲܪܒܘܼܟ݂ ܠܵܐ ܡܲܢܟܸܣܸܬ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܸܡܬܘܼܟ݂ ܠܵܐ ܬܲܥܠܡܸܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܓܹܐܪ̈ܘܼܟ݂ ܛܥܝܼܨ ܠܗܘܿܢ ܒܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܠܝܼ ܨܠܹܐ ܠܵܗ̇ ܐܝܼܕܘܼܟ݂.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܠܲܝܬ ܚܘܼܠܡܵܢܵܐ ܒܒܸܣܪܝܼ ܒܥܸܠܬܵ‌ܐ ܕܚܸܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܲܝܬ ܫܲܠܡܘܼܬܵ‌ܐ ܒܓܲܪ̈ܡܝܼ ܒܥܸܠܬܵ‌ܐ ܕܚܛܝܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܣܝܼܩ ܠܗܘܿܢ ܥܵܘܠܝܼ̈ ܥܸܠܸܠܔ ܡ̣ܢ ܪܹܝܫܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܟܵܪܬܵ‌ܐ ܝܲܩܘܼܪܬܵ‌ܐ ܙܵܘܕܵܐ ܡ̣ܢ ܚܲܝܠܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܚܡܝܼܩ ܠܗܘܿܢ، ܓ̰ܪܹܐ ܠܗܘܿܢ ܕܲܪ̈ܒܵܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܥܸܠܬܵ‌ܐ ܕܣܲܟ݂ܠܘܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܩܘܼܛܪܸܢܵܐ، ܟܝܼܦ ܠܝܼ ܗܲܠܔ ܦܪܵܩܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܝܼ ܒܸܚܕܵܪܵܐ ܒܐܸܒ݂ܠܵܐ ܟܠܹܗ ܝܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܕܸܦܢܵܬ‌ܝܼ̈ ܡܸܠܝܹܐ ܝܢܵܐ ܩܝܘܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܲܝܬ ܚܘܼܠܡܵܢܵܐ ܒܒܸܣܪܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܬܒ݂ܝܼܢܝܼ ܘܦܝܼܫ ܠܝܼ ܛܒ݂ܝܼܚܵܐ ܟ̰ܸܡ ܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܪܒܸܪܝܼ ܡܣܵܒܵܒ ܫܓ݂ܝܼܫܘܼܬܵ‌ܐ ܕܠܸܒܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ، ܒܲܠܩܘܼܒ݂ܠܘܼܟ݂ ܝܼܠܵܗ̇ ܟܠܵܗ̇ ܛܠܵܒܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܬܲܢܲܚܬ‌ܝܼ ܡܸܢܘܼܟ݂ ܠܹܐ ܝܠܵܗ̇ ܛܫܝܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܠܸܒܝܼ ܪܲܦܪܘܼܦܹܐ ܝܠܹܗ، ܫܒ݂ܝܼܩܸܢܹܗ ܚܲܝܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܗܪܵܐ ܕܥܲܝܢܝܼ̈، ܐܘܼܦ ܗ̇ܘ ܠܲܝܬ ܥܲܡܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܲܚܸܒܵܢܝܼ̈ ܘܪ̈ܵܚܡܝܼ ܟܹܐ ܟܵܠܝܼ ܪܚܝܼܩܹܐ ܡ̣ܢ ܡܚܘܿܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܚܸܙܡܵܢܝܼ̈ ܪܸܚܩܵܐ ܟܸܠܝܹܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܘܡܘܼܬܸܒ݂ ܠܗܘܿܢ ܢܸܫܒܹ̈ܐ ܛܵܥܝܵܢܹ̈ܐ ܠܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܵܥܝܵܢܹ̈ܐ ܕܒܝܼܫܬ‌ܝܼ ܗܘܼܡܙܸܡ ܠܗܘܿܢ ܒܘܼܬ ܚܪܵܒ݂ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܗܲܓܝܼ ܦܸܠܡܹ̈ܐ ܟܠܹܗ ܝܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ ܐܲܝܟ݂ ܚܲܪܫܵܐ ܝܘܸܢ ܕܠܹܐ ܫܵܡܹܥ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܝܟ݂ ܠܲܥܠܵܐ ܕܠܹܐ ܦܵܬܹܚ ܦܘܼܡܹܗ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܝܼ ܐܲܝܟ݂ ܐܢܵܫܵܐ ܕܠܹܐ ܫܵܡܹܥ،","poem":1},{"lineBreak":true},{"text":"ܘܕܠܲܝܬ ܕܪܵܫܬܵ‌ܐ ܒܦܘܼܡܹܗ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܸܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܣܒܝܼܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܒܸܬ ܓ̰ܲܘܸܒܸܬ، ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܡܝܼܪܝܼ: ”ܠܵܐ ܗܵܘܹܐ ܕܚܵܕܝܼ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܓ̰ܪܵܛܬܵ‌ܐ ܕܐܲܩܠܝܼ ܓܲܪܘܸܣܝܼ ܓܵܢܵܝܗ‌ܝ.“","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܵܢܵܐ ܩܘܼܪܒܵܐ ܝܘܸܢ ܠܸܢܦܵܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐܒ݂ܝܼ ܥܲܡܝܼ ܝܠܹܗ ܒܟܠܔ ܥܕܵܢܵܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܗܹܐ، ܒܸܬ ܡܵܘܕܸܢܹܗ ܥܵܘܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܵܫܡܹܢ ܒܘܼܬ ܚܛܝܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܘܕܸܫ̃ܡܸܢܝܼ̈ ܚܵܝܹ̈ܐ ܝܢܵܐ ܪܵܒܵܐ ܘܓܘܼܪܹ̈ܐ ܒܡܸܢܝܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܸܪ̈ܝܹܐ ܝܢܵܐ ܣܵܢܝܵܢܝܼ̈ ܒܠܵܐ ܥܸܠܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܘܦܵܪ̈ܥܵܢܹܐ ܕܒܝܼܫܬܵ‌ܐ ܡ̣ܢ ܓܹܒܵܐ ܕܛܵܒ݂ܬܵ‌ܐ","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܗܘܿܢ ܕܲܠܩܘܼܒ݂ܠܝܼ، ܒܗ̇ܝ ܕܢܦܝܼܠܔ ܠܝܼ ܒܵܬܪ ܛܵܒ݂ܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܫܵܒ݂ܩܹܬ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܠܵܐ ܪܵܚܩܹܬ ܡܸܢܝܼ؛","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܡܲܠܝܸܙ ܠܗܲܝܲܪܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܦܘܼܪܩܵܢܝܼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}