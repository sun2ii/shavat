{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܠܝܕܘܬܘܢ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܐܡܝܼܪܝܼ: ”ܒܸܬ ܢܵܛܪܹܢ ܐܘܼܪ̈ܚܵܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܠܸܚܛܵܝܵܐ ܒܠܸܫܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܐܵܣܪܹܢ ܠܦܘܼܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܟܡܵܐ ܕܒܝܼܫܵܐ ܒܲܠܩܘܼܒ݂ܠܝܼ ܝܠܹܗ.“","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܗܘܹܐ ܠܝܼ ܠܲܥܠܵܐ ܘܫܬܝܼܩܵܐ، ܐܘܼܦ ܫܬܝܼܩ ܠܝܼ ܡ̣ܢ ܛܵܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܕܲܪ̈ܕܝܼ ܙܝܼܕ ܠܗܘܿܢ،","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܚܝܼܡ ܠܹܗ ܠܸܒܝܼ ܒܓܵܘܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗܲܓܲܝܬ‌ܝܼ ܒܸܠܒ݂ܵܟ݂ܵܐ ܝܗܘܵܐ ܢܘܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܗܘܼܡܙܸܡ ܠܝܼ ܒܠܸܫܵܢܝܼ:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"”ܡܲܕܸܥ ܐܸܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܚܲܪܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܡܫܘܼܚܬܵ‌ܐ ܕܝܵܘܡܵܢܝܼ̈ ܡܘܼܕܝܼ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܕܝܵܕܥܹܢ ܟܡܵܐ ܙܲܒ݂ܢܵܢܵܝܵܐ ܝܘܸܢ ܐܵܢܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"”ܗܵܐ، ܟܸܪ̈ܝܹܐ ܥܒ݂ܝܼܕܵܝ ܠܘܼܟ݂ ܝܵܘܡܵܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܡܸܬܚܵܐ ܕܚܲܝܝܼ̈ ܐܲܝܟ݂ ܗܸܟ̃ ܡܸܢܕܝܼ ܝܠܹܗ ܠܟܸܣܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܫܲܪܝܼܪܵܐܝܼܬ، ܐܲܚܟ̰ܝܼ ܚܕܵܐ ܢܫܲܡܬܵ‌ܐ ܝܠܹܗ ܟܠܔ ܒܲܪܢܵܫܵܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"”ܫܲܪܝܼܪܵܐܝܼܬ، ܐܲܝܟ݂ ܨܲܠܡܵܐ ܟܹܐ ܚܵܕܹܪ ܐܢܵܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܲܪܝܼܪܵܐܝܼܬ، ܒܣܪܝܼܩܘܼܬܵ‌ܐ ܟܹܐ ܫܵܓܹܫ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܙܝܸܕ ܥܘܼܬܪܵܐ ܘܠܹܐ ܝܵܕܹܥ ܡܵܢܝܼ ܒܸܬ ܓ̰ܲܡܸܥ ܠܹܗ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"”ܘܐܵܕܝܼܵܐ، ܠܡܘܼܕܝܼ ܣܵܦܪܹܢ، ܝܵܐ ܡܵܪܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܣܲܒ݂ܪܝܼ ܒܝܼܘܼܟ݂ ܝܠܹܗ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"”ܦܲܨܝܼ ܠܝܼ ܡ̣ܢ ܟܠܵܝܗ‌ܝ ܓܢܵܗ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܥܵܒ݂ܕܹܬ ܠܝܼ ܠܵܘܡܵܐ ܕܣܲܟ݂ܠܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"”ܗܘܹܐ ܠܝܼ ܠܲܥܠܵܐ، ܠܵܐ ܦܬܝܼܚ ܠܝܼ ܦܘܼܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܢ݇ܬ ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܐܵܗܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"”ܡܲܥܒܸܪ ܡܥܲܠܝܼ ܡܚܘܿܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܡܚܵܝܬܵ‌ܐ ܕܐܝܼܕܘܼܟ݂ ܐܵܢܵܐ ܬܝܼܡ ܠܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"”ܟܹܐ ܬܲܥܠܡܸܬ ܐܢܵܫܵܐ ܒܢܓ̰ܵܘ̈ܝܵܬܹ‌ܐ ܒܘܼܬ ܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܡܲܚܪܸܒܸܬ ܐܲܝܟ݂ ܐܸܟ݂ܠܵܐ ܡܸܢܕܝܼ ܕܫܲܗܘܸܬ ܐܸܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܫܲܪܝܼܪܵܐܝܼܬ، ܢܫܲܡܬܵ‌ܐ ܝܠܹܗ ܟܠܔ ܒܲܪܢܵܫܵܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"”ܫܡܹܥ ܨܠܘܿܬ‌ܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܘܠܓܥܵܝܬ‌ܝܼ ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܕܸܡܥܝܼܬ‌ܝܼ ܠܵܐ ܫܵܬܩܹܬ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܡܵܫܵܚܲܛ ܝܘܸܢ ܐܵܢܵܐ ܠܟܸܣܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܬܵܘܬܵܒ݂ܵܐ ܐܲܝܟ݂ ܟܠܵܝܗ‌ܝ ܐܲܒ݂ܵܗܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"”ܦܪܘܿܩ ܡܸܢܝܼ ܕܚܵܕܹܝܢ","poem":1},{"lineBreak":true},{"text":"ܡܩܲܕܡ ܕܐܵܙܹܠ݇ܢ ܘܠܵܐ ܗܵܘܹܝܢ ܐܚܹܪܢܵܐ.“","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}