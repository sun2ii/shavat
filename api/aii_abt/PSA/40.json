{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܣܦܵܪܵܐ ܣܦܝܼܪܝܼ ܠܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܬܝܼܠܔ ܠܹܗ ܠܟܸܣܠܝܼ ܘܫܡܝܼܥ ܠܹܗ ܓܥܵܝܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܘܩܵܡ ܡܲܐܣܸܩ ܠܝܼ ܡ̣ܢ ܓܘܼܒܵܐ ܕܚܪܵܒ݂ܵܐ، ܡ̣ܢ ܛܝܼܢܵܐ ܕܙܸܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܘܼܩܸܡ ܠܹܗ ܥܲܠܔ ܩܵܝܵܐ ܐܲܩܠܵܬ‌ܝܼ̈، ܟܲܕ ܡܲܩܘܘܼܝܹܐ ܦܵܣܘܿܥܝܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܘܡܘܼܬܸܒ݂ ܠܹܗ ܒܦܘܼܡܝܼ ܙܡܵܪܬܵ‌ܐ ܚܲܕܬܵ‌ܐ ܕܬܸܫܒܘܿܚܬܵ‌ܐ ܠܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܚܵܙܝܼ ܪܵܒܵܐ ܘܒܸܬ ܙܵܕܥܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܣܵܒܪܝܼ ܒܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܢܵܫܵܐ ܕܥܵܒܹܕ ܠܡܵܪܝܵܐ ܬܘܼܟ݂ܠܵܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܦܬܝܼܠܔ ܠܹܗ ܠܚܵܬܪ̈ܵܢܹܐ، ܐܘܼܦ ܠܵܐ ܠܐܵܙܵܠ݇ܢܹ̈ܐ ܒܵܬܪ ܕܘܼܓܠܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܪܵܒܵܐ ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܕܘܼܡܵܪܹ̈ܐ ܘܚܘܼܫܵܒܹ̈ܐ ܐܸܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܠܲܝܬ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܸܢ ܡܲܕܥܸܢ ܗܘܵܐ ܘܗܲܡܙܸܡܸܢ ܗܘܵܐ، ܒܸܬ ܗܵܘܝܼ ܗܘܵܘ ܒܘܼܫ ܙܵܘܕܵܐ ܡ̣ܢ ܠܸܡܢܵܝܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܒܕܸܒ݂ܚܵܐ ܘܒܩܘܼܪܒܵܢܵܐ ܠܵܐ ܒܣܝܼܡ ܠܵܗ̇ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܦܵܬܚܹܬ ܠܗܘܿܢ ܢܵܬܝܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܕܸܒ݂ܚܵܐ ܡܘܼܩܕܵܐ ܘܕܸܒ݂ܚܵܐ ܕܚܛܝܼܬܵ‌ܐ ܠܵܐ ܛܠܝܼܒ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܐܡܝܼܪܝܼ: ”ܗܵܐ، ܐܬܝܼܵܐ ܝܘܸܢ،","poem":1},{"lineBreak":true},{"text":"ܒܟܸܪܟ݂ܵܐ ܕܟܬܵܒ݂ܵܐ ܦܝܼܫܵܐ ܠܹܗ ܟܬܝܼܒ݂ܵܐ ܒܘܼܬ ܕܝܼܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"”ܠܸܥܒ݂ܵܕܵܐ ܨܸܒ݂ܝܵܢܘܼܟ݂، ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܩܘܼܒܸܠܔ ܠܝܼ ܒܘܼܣܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܢܵܡܘܿܣܘܼܟ݂ ܓܵܘ ܠܸܒܝܼ ܝܠܹܗ.“","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܘܼܫܚܸܕ ܠܝܼ ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܒܟܸܢܫܵܐ ܓܘܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܵܐ، ܣܸܦܘܵܬ‌ܝܼ̈ ܠܹܐ ܡܲܟܠܸܢܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܟܹܐ ܝܵܕܥܹܬ، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܠܵܐ ܟܘܼܣܝܵܐ ܠܝܼ ܓܵܘ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܘܼܡܙܸܡ ܠܝܼ ܒܘܼܬ ܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܘܒܘܼܬ ܦܘܼܪܩܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܛܲܝܒܘܼܬܘܼܟ݂ ܘܫܲܪܝܼܪܘܼܬܘܼܟ݂ ܠܵܐ ܛܘܼܫܹܐ ܠܝܼ ܡ̣ܢ ܟܸܢܫܵܐ ܓܘܼܪܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܠܹܐ ܚܵܣܟܹܬ ܪ̈ܲܚܡܘܼܟ݂ ܡܸܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܛܲܝܒܘܼܬܘܼܟ݂ ܘܫܲܪܝܼܪܘܼܬܘܼܟ݂ ܐܲܡܝܼܢܵܐܝܼܬ ܟܹܐ ܢܵܛܪܝܼ ܠܝܼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܩܵܡ ܟܵܪܟ݂ܝܼ ܠܝܼ ܒܝܼܫܵܬܹ̈‌ܐ ܒܠܵܐ ܡܸܢܝܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܸܛܝܸܢܗܘܿܢ ܥܵܘܠܝܼ̈ ܘܠܹܐ ܝܘܸܢ ܒܸܡܨܵܝܵܐ ܕܚܵܙܹܝܢ،","poem":1},{"lineBreak":true},{"text":"ܙܝܼܕ ܠܗܘܿܢ ܡ̣ܢ ܣܲܥܪܵܐ ܕܪܹܝܫܝܼ ܘܠܸܒܝܼ ܩܵܡ ܫܵܒܹܩ ܠܝܼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܵܣܡܵܐ ܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܠܦܲܨܘܼܝܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡܲܠܝܸܙ ܠܗܲܝܲܪܬ‌ܝܼ، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܘܦܵܝܫܝܼ ܡܘܼܢܟܸܦܹܐ ܟܠܵܝܗ‌ܝ ܛܵܥܝܵܢܹ̈ܐ ܠܓܵܢܝܼ ܠܛܲܠܘܼܩܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܕܵܝܪܝܼ ܠܒܵܬܪܵܐ ܘܗܵܘܝܼ ܡܘܼܣܠܝܼܹܐ","poem":1},{"lineBreak":true},{"text":"ܐܵܢܝܼ ܕܒܵܣܡܵܐ ܠܗܘܿܢ ܒܒܝܼܫܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܦܵܝܫܝܼ ܬܡܝܼܗܹܐ ܡ̣ܢ ܢܟ݂ܝܼܦܬܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܐܵܢܝܼ ܕܟܹܐ ܐܵܡܪܝܼ ܐܸܠܝܼ: ”ܐܘܿܚܲܝ! ܐܘܿܚܲܝ!“","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܚܵܕܝܼ ܘܦܵܨܚܝܼ ܒܝܼܘܼܟ݂ ܟܠܵܝܗ‌ܝ ܛܵܥܝܵܢܹ̈ܐ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܵܡܪܝܼ ܐܲܡܝܼܢܵܐܝܼܬ ܡܲܚܸܒܵܢܹ̈ܐ ܕܦܘܼܪܩܵܢܘܼܟ݂:","poem":1},{"lineBreak":true},{"text":"”ܗܵܘܹܐ ܓܘܼܪܵܐ ܡܵܪܝܵܐ.“","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܘܐܵܢܵܐ ܡܸܣܟܹܢܵܐ ܝܘܸܢ ܘܣܢܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܟܹܐ ܬܲܚܡܸܢ ܒܘܼܬ ܕܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܝܲܪܬ‌ܝܼ ܘܦܲܨܝܵܢܝܼ ܐܲܢ݇ܬ ܝܼܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܠܵܐ ܥܲܪܩܸܠܸܬ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}