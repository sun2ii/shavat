{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܲܣܟܝܼܠܔ ܕܒܢܝ̈ ܩܘܪܚ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܒܢܵܬܝܵܬܲܢ̈ ܫܡܝܼܥ ܠܲܢ، ܐܲܒ݂ܵܗܵܬܲܢ̈ ܗܘܼܩܹܐ ܠܗܘܿܢ ܐܸܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܦܘܼܠܚܵܢܹ̈ܐ ܕܦܠܝܼܚ ܠܘܼܟ݂ ܒܝܵܘܡܵܢܵܝ̈ܗ‌ܝ، ܒܝܵܘܡܵܢܹ̈ܐ ܩܲܕܝܼܡܵܝܹ̈ܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܒܐܝܼܕܘܼܟ݂ ܛܪܝܼܕܵܝ ܠܘܼܟ݂ ܐܸܡܘܵܬܹ̈‌ܐ ܘܢܨܝܼܒ݂ܵܝ ܠܘܼܟ݂ ܐܲܒ݂ܵܗܵܬܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܣܪܝܼܬܵ‌ܐ ܠܥܲܡܡܹ̈ܐ ܘܡܘܼܦܪܸܣܵܝ ܠܘܼܟ݂ ܐܲܒ݂ܵܗܵܬܲܢ̈.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܝܗܘܵܐ ܒܣܲܝܦܵܝܗ‌ܝ ܕܩܵܡ ܝܵܪܬ‌ܝܼ ܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܵܦܠܵܐ ܕܪܲܥܢܵܝܗ‌ܝ ܩܵܡ ܦܲܪܸܩ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܵܐ ܝܲܡܝܼܢܘܼܟ݂ ܘܕܪܲܥܢܘܼܟ݂ ܘܒܲܗܪܵܐ ܕܦܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܣܝܼܡ ܠܵܗ̇ ܠܘܼܟ݂ ܒܝܼܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܝܼܘܸܬ ܡܲܠܟܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܩܘܿܕ ܦܘܼܪܩܵܢܵܐ ܕܝܲܥܩܘܿܒ݂.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܝܼܘܼܟ݂ ܒܸܬ ܡܵܚܲܚ ܠܡܲܠܝܸܨܵܢܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܒܫܸܡܘܼܟ݂ ܒܸܬ ܕܲܫܕܸܫܲܚ ܠܩܵܝܡܵܢܹ̈ܐ ܕܥܲܠܲܢ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܩܸܫܬ‌ܝܼ ܠܹܐ ܦܵܝܫܹܢ ܒܣܲܒ݂ܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܲܝܦܝܼ ܠܹܐ ܦܲܪܸܩ ܠܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܢ݇ܬ ܩܵܡ ܦܲܪܩܸܬ ܠܲܢ ܡ̣ܢ ܡܲܠܝܸܨܵܢܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܢܝܵܢܲܢ̈ ܡܘܼܢܟܸܦܵܝ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܒܐܲܠܵܗܵܐ ܫܘܼܒܸܚ ܠܲܢ ܟܠܹܗ ܝܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܫܸܡܘܼܟ݂ ܗܲܠܔ ܥܵܠܲܡ ܒܸܬ ܫܲܟܪܲܚ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܡܘܼܚܦܸܠܔ ܠܘܼܟ݂ ܘܡܘܼܢܟܸܦ ܠܘܼܟ݂ ܐܸܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܦܵܠܛܹܬ ܥܲܡ ܚܲܝܠܵܘܵܬܲܢ̈.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܘܼܕܸܪܘܼܟ݂ ܐܸܠܲܢ ܠܒܵܬܪܵܐ ܡ̣ܢ ܩܲܕܡ ܕܸܫ̃ܡܸܢ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܢܝܵܢܲܢ̈ ܣܠܝܼܒ ܠܗܘܿܢ ܩܵܐ ܓܵܢܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܝܵܗܒܹܬ ܠܲܢ ܐܲܝܟ݂ ܥܸܪ̈ܒܹܐ ܕܦܵܝܫܲܚ ܐܟ݂ܝܼܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܘ ܐܸܡܘܵܬܹ̈‌ܐ ܩܵܡ ܒܵܙܩܹܬ ܠܲܢ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܙܘܼܒܸܢܘܼܟ݂ ܠܥܲܡܘܼܟ݂ ܪܵܒܵܐ ܐܲܪܙܵܢ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܩܢܹܐ ܠܘܼܟ݂ ܒܛܝܼܡܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܥܵܒ݂ܕܹܬ ܠܲܢ ܠܵܘܡܵܐ ܠܫܒ݂ܵܒܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܡܲܣܚܲܪܬܵ‌ܐ ܘܠܵܘܡܵܐ ܠܐܵܢܝܼ ܕܝܼܢܵܐ ܚܵܕܸܪ̈ܘܵܢܲܢ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܥܵܒ݂ܕܹܬ ܠܲܢ ܡܲܬܠܵܐ ܓܵܘ ܐܸܡܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܥܸܠܬܵ‌ܐ ܕܫܥܵܫܬܵ‌ܐ ܕܪܹܝܫܵܐ ܓܵܘ ܥܲܡܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܟܠܹܗ ܝܵܘܡܵܐ ܢܟܸܦܬ‌ܝܼ ܩܲܕܡܝܼ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܢܟܸܦܬܵ‌ܐ ܕܦܵܬ‌ܝܼ ܩܵܡ ܟܲܣܝܵܐ ܠܝܼ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܥܸܠܬܵ‌ܐ ܕܩܵܠܵܐ ܕܠܵܝܡܵܢܵܐ ܘܓܵܕܦܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܩܲܕܡ ܕܸܫ̃ܡܸܢ ܘܫܵܩܠܵܢܵܐ ܕܬܘܼܥܠܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܟܠܵܗ̇ ܐܵܗܵܐ ܐܬܹ‌ܐ ܠܵܗ̇ ܥܲܠܲܢ ܘܠܵܐ ܢܫܹܐ ܠܲܢ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܕܘܼܓܸܠܔ ܠܲܢ ܠܘܲܥܕܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܕܝܼܪܹܗ ܠܒܵܬܪܵܐ ܠܸܒܲܢ،","poem":1},{"lineBreak":true},{"text":"ܐܵܦܠܵܐ ܩܠܝܼܒ ܠܗܘܿܢ ܦܵܣܘܿܥܝܵܬܲܢ̈ ܡ̣ܢ ܐܘܼܪܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܩܵܡ ܛܵܒ݂ܚܹܬ ܠܲܢ ܒܐܲܪܥܵܐ ܕܟ̰ܲܩܵܠܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܡ ܡܲܟܣܸܬ ܠܲܢ ܒܛܸܠܵܢܝܼܬܵ‌ܐ ܕܡܵܘܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܗܵܘܲܚ ܢܸܫܝܹܗ ܫܸܡܵܐ ܕܐܲܠܵܗܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܦܪܝܼܣܵܝ ܐܝܼܕܵܬܲܢ̈ ܠܟܸܣ ܐܲܠܵܗܵܐ ܢܘܼܟ݂ܪܵܝܵܐ؛","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܠܹܐ ܒܵܚܹܪ ܐܲܠܵܗܵܐ ܠܐܵܗܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗ̇ܘ ܟܹܐ ܝܵܕܹܥ ܡܸܢܕܝܼ ܛܸܫܝܵܐ ܕܠܸܒܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܒܘܼܬ ܕܝܼܘܼܟ݂ ܦܝܵܫܵܐ ܝܘܲܚ ܩܛܝܼܠܹܐ ܟܠܹܗ ܝܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܲܢ ܚܘܼܫܒܸܢܹܐ ܐܲܝܟ݂ ܥܸܪ̈ܒܹܐ ܠܦܪܵܡܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܪܥܘܿܫ، ܩܵܡܘܿܕܝܼ ܛܵܠܥܹܬ، ܝܵܐ ܡܵܪܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܦܘܼܫ ܪܥܝܼܫܵܐ، ܠܵܐ ܪܲܦܹܝܬ ܠܲܢ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܛܲܫܹܝܬ ܠܵܗ̇ ܦܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܢܵܫܹܝܬ ܥܵܘܩܵܢܲܢ̈ ܘܐܘܼܠܨܵܢܲܢ̈؟","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܝܼܦ ܠܵܗ̇ ܠܥܲܦܪܵܐ ܓܵܢܲܢ،","poem":1},{"lineBreak":true},{"text":"ܛܦܹܐ ܠܵܗ̇ ܠܐܲܪܥܵܐ ܟܹܪ݇ܣܲܢ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ ܠܗܲܝܲܪܬܵ‌ܐ ܐܸܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܦܲܪܸܩ ܠܲܢ ܒܘܼܬ ܛܲܝܒܘܼܬܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}