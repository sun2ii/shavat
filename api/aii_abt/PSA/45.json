{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ: ܥܠܔ ܫܘܼܫܲܢܝܼܡ. ܡܣܟܝܠܔ ܕܒܢܝ̈ ܩܘܪܚ. ܙܡܪܬ‌ܐ ܕܚܘܒܐ."]},{"type":"verse","number":1,"content":[{"text":"ܚܲܒܪܵܐ ܛܵܒ݂ܵܐ ܒܸܢܒ݂ܵܥܵܐ ܝܠܹܗ ܡ̣ܢ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܹܐܡܵܪܵܝ ܝܘܸܢ ܓ̰ܲܪ̈ܓܝܼ ܠܡܲܠܟܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܸܫܵܢܝܼ ܩܲܢܝܵܐ ܕܣܵܦܪܵܐ ܡܗܝܼܪܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܘܼܫ ܫܲܦܝܼܪܵܐ ܝܘܸܬ ܡ̣ܢ ܒܢܲܝ̈ܢܵܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܦܝܼܟ݂ܬܵ‌ܐ ܝܠܵܗ̇ ܫܵܦܵܩܲܬ ܥܲܠܔ ܣܸܦܘܵܬܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܐܵܗܵܐ، ܩܵܡ ܒܲܪܸܟ݂ ܠܘܼܟ݂ ܐܲܠܵܗܵܐ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܣܘܿܪ ܣܲܝܦܘܼܟ݂ ܥܲܠܔ ܥܸܛܡܵܐ، ܝܵܐ ܓܲܒܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܚܸܩܪܘܼܟ݂ ܘܫܘܼܒ݂ܚܘܼܟ݂،","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܘܒܫܘܼܒ݂ܚܘܼܟ݂ ܪܟܘܿܒ݂ ܥܲܠܔ ܣܘܼܣܵܐ ܘܗܘܝܼ ܓ݂ܵܠܒܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܵܐ ܒܘܼܬ ܫܪܵܪܵܐ ܘܡܲܟܝܼܟ݂ܘܼܬܵ‌ܐ ܘܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܝܲܡܝܼܢܘܼܟ݂ ܡܲܠܦܵܐ ܐܸܠܘܼܟ݂ ܥܒ݂ܵܕܹ̈ܐ ܣܲܗܡܵܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܚܲܪ̈ܝܼܦܹܐ ܝܢܵܐ ܓܹܐܪ̈ܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܥܲܡܡܹ̈ܐ ܬܚܘܿܬ ܐܲܩܠܘܼ̈ܟ݂ ܟܹܐ ܢܵܦܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܛܵܥܨܝܼ ܓܹܐܪ̈ܘܼܟ݂ ܒܠܸܒܵܐ ܕܕܸܫ̃ܡܸܢܘܼ̈ܟ݂، ܝܵܐ ܡܲܠܟܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܬܪܘܿܢܘܿܣܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ، ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ،","poem":1},{"lineBreak":true},{"text":"ܚܘܼܛܪܵܐ ܕܬܪܘܼܨܘܼܬܵ‌ܐ ܚܘܼܛܪܵܐ ܕܡܲܠܟܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܡܘܼܚܸܒ ܠܘܼܟ݂ ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܘܣܢܹܐ ܠܘܼܟ݂ ܒܝܼܫܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܐܵܗܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ، ܩܵܡ ܡܵܫܹܚ ܠܘܼܟ݂ ܐܲܠܵܗܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܡܸܫܚܵܐ ܕܦܨܝܼܚܘܼܬܵ‌ܐ ܒܘܼܫ ܙܵܘܕܵܐ ܡ̣ܢ ܚܲܒ݂ܪ̈ܵܘܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܒܡܘܼܪܵܐ، ܥܸܠܘܲܝ، ܘܩܲܣܝܵܐ ܥܘܼܛܪܸܢܹܐ ܝܢܵܐ ܟܠܵܝܗ‌ܝ ܠܒ݂ܘܼܫܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܩܲܨܪܵܐ ܕܓܪܲܡܦܝܼܠܵܐ ܣܝܼܡܹ̈ܐ ܕܩܝܼܬܵܪܹ̈ܐ ܩܵܡ ܡܲܚܕܝܼ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܢܵܬܹ̈‌ܐ ܕܡܲܠܟܹ̈ܐ ܒܹܝܠܔ ܡܝܲܩܪ̈ܵܬܘܼܟ݂ ܝܼܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܠܟܬܵ‌ܐ ܟܠܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܒܝܲܡܝܼܢܘܼܟ݂ ܒܕܲܗܒ݂ܵܐ ܕܐܵܘܦܹܝܪ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܫܡܹܥ، ܝܵܐ ܒܪܵܬܵ‌ܐ، ܘܚܙܝܼ، ܘܡܲܟܸܦ ܢܵܬܵܟ݂ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܢܫܝܼ ܥܲܡܵܟ݂ܝ ܘܒܲܝܬܵ‌ܐ ܕܒܵܒܵܟ݂ܝ،","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܕܫܲܗܘܸܬ ܡܲܠܟܵܐ ܠܫܘܼܦܪܵܟ݂ܝ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗ̇ܘ ܝܼܠܹܗ ܡܵܪܵܟ݂ܝ، ܡܲܟܸܦܝ ܓܵܢܵܟ݂ܝ ܐܸܠܹܗ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܒܪܵܬܵ‌ܐ ܕܨܘܿܪ ܒܸܬ ܐܵܬܝܵܐ ܒܡܵܘܗܲܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܵܬܵܟ݂ܝ ܒܸܬ ܛܵܥܝܼ ܥܲܬܝܼܪܹ̈ܐ ܕܥܲܡܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܟܠܔ ܚܸܩܪܵܐ ܝܠܵܗ̇ ܒܪܵܬܵ‌ܐ ܕܡܲܠܟܵܐ ܓܵܘ ܩܲܨܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܒ݂ܝܼܫܬܘܼܗ̇ ܡ̣ܢ ܙܩܘܼܪܹ̈ܐ ܕܕܲܗܒ݂ܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܒܠܒ݂ܘܼܫܹ̈ܐ ܠܩܝܼܛܹ̈ܐ ܒܸܬ ܦܵܝܫܵܐ ܠܘܼܒܸܠܬܵ‌ܐ ܠܡܲܠܟܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܲܪ̈ܝܼܒ݂ܝܵܬܹ‌ܐ ܒܬܘܼܠܵܬܹ̈‌ܐ ܕܒܵܬܪܘܼܗ̇ ܦܝܵܫܵܐ ܡܘܼܬܝܹܐ ܩܲܕܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܦܵܝܫܝܼ ܠܘܼܒܠܹܐ ܒܚܲܕܘܼܬܵ‌ܐ ܘܦܨܵܚܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒ݂ܪܝܼ ܓܵܘ ܩܲܨܪܵܐ ܕܡܲܠܟܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܒܫܵܘܦܵܐ ܕܒܵܒܵܘܵܬܘܼ̈ܟ݂ ܒܸܬ ܗܵܘܝܼ ܒܢܘܿܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܲܬܒܸܬ ܠܗܘܿܢ ܪܹ̈ܝܫܵܢܹܐ ܒܟܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܡܲܕܟܸܪܸܢ ܫܸܡܘܼܟ݂ ܒܟܠܔ ܕܵܪܵܐ ܘܕܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܐܵܗܵܐ، ܥܲܡܡܹ̈ܐ ܒܸܬ ܫܲܟܪܝܼ ܠܘܼܟ݂ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}