{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["ܙܡܪܬ‌ܐ. ܡܙܡܘܪܐ ܕܒܢܝ̈ ܩܘܪܚ."]},{"type":"verse","number":1,"content":[{"text":"ܓܘܼܪܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܘܡܫܘܼܒܚܵܐ ܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܡܕܝܼܢ݇ܬܵ‌ܐ ܕܐܲܠܵܗܲܢ، ܛܘܼܪܵܐ ܕܩܘܼܕܫܹܗ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܫܲܦܝܼܪܵܐ ܒܪܵܡܘܼܬܵ‌ܐ، ܚܲܕܘܼܬܵ‌ܐ ܕܟܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܛܘܼܪܵܐ ܕܨܸܗܝܘܿܢ ܒܫܸܦܘܼܠܹ̈ܐ ܕܓܲܪܒܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܕܝܼܢ݇ܬܵ‌ܐ ܕܡܲܠܟܵܐ ܓܘܼܪܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܒܩܲܨܪ̈ܘܼܗ̇ ܡܘܼܕܸܥܵܐ ܠܹܗ ܓܵܢܹܗ ܐܲܝܟ݂ ܓܵܘܣܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗܵܐ، ܡܲܠܟܹ̈ܐ ܚܘܼܝܸܕ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܪܗܘܿܢ ܥܲܡ ܚܕܵܕܹ̈ܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܐܵܢܝܼ ܟܲܕ ܚܙܹܐ ܠܗܘܿܢ، ܦܝܼܫ ܠܗܘܿܢ ܬܡܝܼܗܹܐ،","poem":1},{"lineBreak":true},{"text":"ܫܥܝܼܫ ܠܗܘܿܢ ܘܡܘܼܠܝܸܙ ܠܗܘܿܢ ܠܸܥܪܵܩܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܪܲܬܪܲܬܬܵ‌ܐ ܩܵܡ ܕܵܒ݂ܩܵܐ ܠܗܘܿܢ ܬܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܚܸܒ݂ܠܹ̈ܐ ܐܲܝܟ݂ ܝܵܠܸܕܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܒܦܵܘܚܵܐ ܕܡܲܕܢܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܬܵܒ݂ܪܹܬ ܓܵܡܝܼܹ̈ܐ ܕܬܲܪܫܝܼܫ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܕܵܐܟ݂ܝܼ ܕܫܡܝܼܥ ܠܲܢ، ܗܵܕܟ݂ܵܐ ܚܙܹܐ ܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܒܡܕܝܼܢ݇ܬܵ‌ܐ ܕܡܵܪܝܵܐ ܚܲܝܠܬܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܡܕܝܼܢ݇ܬܵ‌ܐ ܕܐܲܠܵܗܲܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܒܸܬ ܡܲܩܘܹܐ ܠܵܗ̇ ܗܲܠܔ ܥܵܠܲܡ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܬܘܼܚܡܸܢܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ، ܒܘܼܬ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܓܵܘܵܐ ܕܗܲܝܟܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܫܸܡܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܝܠܵܗ̇ ܬܸܫܒܘܿܚܬܘܼܟ݂ ܗܲܠܔ ܡܲܪ̈ܙܵܢܹܐ ܕܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܠܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܝܲܡܝܼܢܘܼܟ݂ ܙܲܕܝܼܩܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܚܵܕܹܐ ܛܘܼܪܵܐ ܕܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܦܵܨܚܝܼ ܒܢܵܬܹ̈‌ܐ ܕܝܼܗܘܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܕܝܼܘܵܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܚܕܘܿܪܘܼܢ ܚܵܕܸܪ̈ܘܵܢܹܐ ܕܨܸܗܝܘܿܢ، ܘܟܪܘܿܟ݂ܘܼܢ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡܢܹܝܡܘܼܢ ܒܘܼܪ̈ܓ̰ܘܼܗ̇.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܡܲܣܸܡܘܼܢ ܒܵܠܵܐ ܒܫܘܼܪ̈ܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܨܲܚܨܹܝܡܘܼܢ ܠܩܲܨܪ̈ܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܩܵܐ ܕܗܲܩܹܝܬܘܿܢ ܠܕܵܪܵܐ ܐܚܹܪܢܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܕܐܵܗܵܐ ܐܲܠܵܗܵܐ، ܐܲܠܵܗܲܢ ܝܼܠܹܗ، ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܒܸܬ ܡܕܲܒܸܪܲܢ ܗܲܠܔ ܡܵܘܬܵ‌ܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}