{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ: ܒܫܒܝܒ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܠܗܹܡܸܙܡܵܢܝܼ̈ ܨܲܠܝܼ ܢܵܬܵ‌ܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܣܸܡ ܒܵܠܵܐ ܠܬܲܢܲܚܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ ܠܩܵܠܵܐ ܕܓܥܵܝܬ‌ܝܼ، ܡܲܠܟܝܼ ܘܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܸܠܘܼܟ݂ ܨܲܠܘܼܝܹܐ ܝܘܸܢ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܒܨܲܦܪܵܐ ܒܸܬ ܫܵܡܥܹܬ ܩܵܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܨܲܦܪܵܐ ܒܸܬ ܡܲܩܪܸܒܸܢ ܨܠܘܿܬ‌ܝܼ ܐܸܠܘܼܟ݂، ܘܒܸܬ ܗܵܘܹܝܢ ܩܲܙܘܼܕܹܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܲܢ݇ܬ ܠܹܐ ܝܘܸܬ ܐܲܠܵܗܵܐ ܕܒܵܣܡܵܐ ܠܹܗ ܒܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܥܵܡܹܪ ܒܝܼܫܵܐ ܥܲܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܠܹܐ ܟܵܠܝܼ ܫܲܒ݂ܗܸܪ̈ܵܢܹܐ ܩܲܕܡ ܥܲܝ̈ܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܣܵܢܹܝܬ ܟܠܵܝܗ‌ܝ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܛܲܠܩܸܬ ܠܗܲܡܙܸܡܵܢܹ̈ܐ ܕܕܲܓܵܠܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܫܲܦܟ݂ܵܢܵܐ ܕܕܸܡܵܐ ܘܡ̣ܢ ܦܸܠܡܵܐ ܟܹܐ ܓܲܢܓܸܙ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ ܒܣܲܓܝܼܐܘܼܬܵ‌ܐ ܕܛܵܒ݂ܵܬܘܼ̈ܟ݂ ܒܸܬ ܥܵܒ݂ܪܹܢ ܠܒܲܝܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܙܕܘܼܥܬܵ‌ܐ ܡܸܢܘܼܟ݂ ܒܸܬ ܣܵܓ݂ܕܹܢ ܠܓܹܒܵܐ ܕܗܲܝܟܠܵܐ ܕܩܘܼܕܫܘܼܟ݂.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܡܗܲܕܝܼ ܠܝܼ ܒܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܒܥܸܠܬܵ‌ܐ ܕܕܸܫ̃ܡܸܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܬܪܘܼܨܬܵ‌ܐ ܩܲܕܡܝܼ ܐܘܼܪܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܠܲܝܬ ܒܦܘܼܡܵܝܗ‌ܝ ܫܪܵܪܵܐ ܡܩܵܘܝܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܓܵܘܵܝܗ‌ܝ ܚܪܵܒ݂ܵܐ ܝܠܹܗ.","poem":1},{"lineBreak":true},{"text":"ܒܵܠܘܿܥܬܵܝܗ‌ܝ ܩܲܒ݂ܪܵܐ ܦܬܘܼܚܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܠܸܫܵܢܵܝܗ‌ܝ ܟܹܐ ܫܲܕܠܝܼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܕܘܼܢ ܐܸܠܵܝܗ‌ܝ ܐܲܝܟ݂ ܚܲܝܵܒܹ̈ܐ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܢܵܦܠܝܼ ܒܡܸܠܟܵܐ ܕܓܵܢܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܦܸܪܝܘܼܬܵ‌ܐ ܕܓܢܵܗܵܝ̈ܗ‌ܝ ܚܲܪܙܸܦ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܗܘܹܐ ܠܗܘܿܢ ܡܵܪ̈ܘܿܕܹܐ ܥܲܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܦܵܨܚܝܼ ܟܠܵܝܗ‌ܝ ܐܵܢܝܼ ܕܫܵܩܠܝܼ ܓܵܘܣܵܐ ܠܟܸܣܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܫܲܒܚܝܼ ܒܚܲܕܘܼܬܵ‌ܐ ܠܥܵܠܲܡ، ܘܟܲܣܝܼ ܠܗܘܿܢ ܒܢܵܛܘܿܪܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܦܨܵܚܵܐ ܦܵܨܚܝܼ ܒܝܼܘܼܟ݂ ܡܲܚܸܒܵܢܹ̈ܐ ܕܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܢ݇ܬ ܟܹܐ ܒܲܪܟܸܬ ܠܙܲܕܝܼܩܵܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܡܵܛܵܠܵܐ ܒܫܵܦܵܩܲܬ ܟܹܐ ܚܲܪܕܸܬ ܠܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}