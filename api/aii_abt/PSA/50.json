{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"ܐܹܝܠܔ، ܐܲܠܵܗܵܐ، ܡܵܪܝܵܐ، ܗܘܼܡܙܸܡ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܩܪܹܐ ܠܹܗ ܠܐܲܪܥܵܐ ܡ̣ܢ ܙܪܵܩܵܐ ܕܫܸܡܫܵܐ ܗܲܠܔ ܓܢܵܝܬܹܗ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܨܸܗܝܘܿܢ، ܓܡܝܼܪܘܼܬܵ‌ܐ ܕܫܘܼܦܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܙܪܝܼܩ ܠܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܐܵܬܹ‌ܐ ܐܲܠܵܗܲܢ ܘܠܹܐ ܫܵܬܹܩ،","poem":1},{"lineBreak":true},{"text":"ܩܲܕܡܘܼܗ‌ܝ ܢܘܼܪܵܐ ܒܸܬ ܐܵܟܹܠܔ،","poem":1},{"lineBreak":true},{"text":"ܚܵܕܸܪ̈ܘܵܢܘܼܗ‌ܝ ܥܲܠܥܵܠܵܐ ܪܵܒܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܩܵܪܹܐ ܠܫܡܲܝܵܐ ܡ̣ܢ ܥܸܠܸܠܔ،","poem":1},{"lineBreak":true},{"text":"ܘܠܐܲܪܥܵܐ ܠܸܕܝܵܢܵܐ ܠܥܲܡܹܗ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"”ܓ̰ܲܡܸܥܡܘܼܢ ܠܟܸܣܠܝܼ ܡܗܘܼܡܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܩܵܛܥܵܢܹ̈ܐ ܕܘܲܥܕܝܼ ܒܕܸܒ݂ܚܵܐ.“","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܟܹܐ ܡܲܕܥܵܐ ܫܡܲܝܵܐ ܙܲܕܝܼܩܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܠܵܗܵܐ ܝܠܹܗ ܕܲܝܵܢܵܐ ܗ̇ܘ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"”ܫܡܹܥ، ܝܵܐ ܥܲܡܝܼ، ܘܒܸܬ ܗܲܡܙܸܡܸܢ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܝܼܣܪܵܐܹܝܠܔ، ܘܒܸܬ ܣܵܗܕܹܢ ܕܲܠܩܘܼܒ݂ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ، ܐܲܠܵܗܘܼܟ݂ ܐܵܢܵܐ ܝܘܸܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"”ܒܘܼܬ ܕܸܒ݂ܚܘܼ̈ܟ݂ ܠܹܐ ܡܲܢܟܸܣܸܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܒܘܼܬ ܕܸܒ݂ܚܘܼ̈ܟ݂ ܡܘܼܩܕܹ̈ܐ ܕܝܼܢܵܐ ܠܒܲܠܩܘܼܒ݂ܠܝܼ ܐܲܡܝܼܢܵܐܝܼܬ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"”ܠܹܐ ܫܵܩܠܹܢ ܡ̣ܢ ܒܲܝܬܘܼܟ݂ ܬܵܘܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܡ̣ܢ ܓܘܼܡܵܢܘܼ̈ܟ݂ ܢܹܐܪ̈ܝܼܹܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"”ܣܵܒܵܒ ܕܝܼܝܼ ܝܢܵܐ ܟܠܵܝܗ‌ܝ ܚܲܝܘܵܬܹ̈‌ܐ ܕܥܵܒ݂ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܥܝܼܪܹ̈ܐ ܕܒܐܲܠܦܵܐ ܛܘܼܪ̈ܵܢܹܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"”ܟܹܐ ܝܵܕܥܹܢ ܠܟܠܵܗ̇ ܦܵܪܲܚܬܵ‌ܐ ܕܛܘܼܪ̈ܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓ̰ܵܘܓ̰ܵܢܹ̈ܐ ܕܕܸܫܬܵ‌ܐ ܥܲܡܝܼ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"”ܐܸܢ ܟܵܦܢܹܢ ܗܘܵܐ ܠܹܐ ܐܵܡܪܹܢ ܗܘܵܐ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܕܝܼܝܼ ܝܠܵܗ̇ ܒܪܝܼܬܵ‌ܐ ܘܡܸܠܝܘܼܬܘܼܗ̇.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"”ܗܵܐ، ܒܸܬ ܐܵܟ݂ܠܹܢ ܒܸܣܪܵܐ ܕܡܘܼܓ̰ܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܫܵܬܹܝܢ ܕܸܡܵܐ ܕܢܹܐܪ̈ܝܼܹܐ؟","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"”ܕܒ݂ܘܿܚ ܠܐܲܠܵܗܵܐ ܫܲܟܲܪܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܬܲܡܸܡ ܠܥܸܠܵܝܵܐ ܢܸܕܪ̈ܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"”ܘܩܪܝܼ ܐܸܠܝܼ ܒܝܵܘܡܵܐ ܕܐܘܼܠܨܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܲܨܸܢܘܼܟ݂ ܘܒܸܬ ܡܝܲܩܪܸܬ ܠܝܼ.“","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܠܪܲܫܝܼܥܵܐ ܒܹܐܡܵܪܵܐ ܝܠܹܗ ܐܲܠܵܗܵܐ:","poem":1},{"lineBreak":true},{"text":"”ܡܵܐ ܠܘܼܟ݂ ܠܗܲܩܘܼܝܹܐ ܩܵܢܘܿܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܠܸܫܩܵܠܵܐ ܘܲܥܕܝܼ ܒܦܘܼܡܘܼܟ݂؟","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"”ܣܵܒܵܒ ܐܲܢ݇ܬ ܣܢܹܐ ܠܘܼܟ݂ ܬܲܥܠܲܡܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܪܘܼܦܹܐ ܠܘܼܟ݂ ܗܹܡܸܙܡܵܢܝܼ̈ ܒܵܬܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"”ܐܸܢ ܚܙܹܐ ܠܘܼܟ݂ ܓܹܢܵܒ݂ܵܐ، ܟܹܐ ܒܵܣܡܵܐ ܠܘܼܟ݂ ܒܝܼܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܡ ܓܲܝܵܪܹ̈ܐ ܝܠܹܗ ܣܵܗܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"”ܦܘܼܡܘܼܟ݂ ܝܘܼܗܒܹܠܔ ܠܘܼܟ݂ ܠܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܸܫܵܢܘܼܟ݂ ܟܹܐ ܡܲܠܚܸܡ ܦܸܠܡܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"”ܟܹܐ ܝܵܬܒܹܬ ܗܲܡܙܸܡܸܬ ܕܲܠܩܘܼܒ݂ܠܔ ܕܐܲܚܘܿܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܒܪܘܿܢܵܐ ܕܝܸܡܘܼܟ݂ ܟܹܐ ܕܵܪܹܝܬ ܒܘܼܚܬܵܢ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"”ܐܲܢܹܐ ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܘܐܵܢܵܐ ܫܬܝܼܩ ܠܝܼ؛","poem":1},{"lineBreak":true},{"text":"ܚܫܝܼܒ݂ ܠܘܼܟ݂ ܗܘܵܝܵܐ ܒܸܬ ܗܵܘܹܝܢ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܒܸܬ ܡܲܢܟܸܣܸܢܘܼܟ݂ ܘܒܸܬ ܚܵܪܙܹܢ ܥܒ݂ܵܕܘܼ̈ܟ݂ ܩܲܕܡ ܥܲܝ̈ܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"”ܦܲܪܡܹܝܡܘܼܢ ܐܵܗܵܐ، ܝܵܐ ܢܵܫܝܵܢܹ̈ܐ ܕܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܗܵܘܝܵܐ ܕܦܲܪܦܸܛܸܢ ܘܠܵܐ ܗܵܘܹܐ ܦܲܨܝܵܢܵܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"”ܟܠܔ ܕܕܵܒܹܚ ܫܲܟܲܪܬܵ‌ܐ ܟܹܐ ܡܝܲܩܸܪܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܡܲܪܝܸܙܸܢܵܐ ܕܐܘܼܪܚܹܗ ܒܸܬ ܡܲܚܙܹܝܢ ܦܘܼܪܩܵܢܵܐ ܕܐܲܠܵܗܵܐ.“","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}