{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ، ܐܝܡܢ ܕܐܬ‌ܐ ܠܗ ܠܟܣ ܠܗ ܢܬܢ ܢܒ݂ܝܐ ܟܕ ܥܒ݂ܝܪܗ ܠܟܣ ܒܬܫܒ݂ܥ."]},{"type":"verse","number":1,"content":[{"text":"ܪܚܘܿܡ ܥܲܠܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ، ܐܲܝܟ݂ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܦܸܪܝܘܼܬܵ‌ܐ ܕܪ̈ܲܚܡܘܼܟ݂ ܓܪܘܿܕ ܠܗܘܿܢ ܓܢܵܗ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܥܵܘܠܝܼ ܚܲܠܸܠܔ ܠܝܼ ܓܡܝܼܪܵܐܝܼܬ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܚܛܝܼܬ‌ܝܼ ܕܲܟ݂ܝܼ ܠܝܼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܵܢܵܐ ܟܹܐ ܝܵܕܥܹܢ ܠܓܢܵܗ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܚܛܝܼܬ‌ܝܼ ܒܲܠܩܘܼܒ݂ܠܝܼ ܝܠܵܗ̇ ܐܲܡܝܼܢܵܐܝܼܬ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܐܸܠܘܼܟ݂، ܐܲܚܟ̰ܝܼ ܐܸܠܘܼܟ݂، ܚܛܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܝܼܫܘܼܬܵ‌ܐ ܩܲܕܡ ܥܲܝ̈ܢܘܼܟ݂ ܥܒ݂ܝܼܕ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܐܵܗܵܐ، ܒܸܬ ܗܵܘܹܝܬ ܙܲܕܝܼܩܵܐ ܒܗܲܡܙܲܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܗܵܘܹܝܬ ܕܸܟ݂ܝܵܐ ܒܕܝܵܢܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܒܥܵܘܠܵܐ ܦܝܼܫ ܠܝܼ ܝܠܝܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܛܝܼܬܵ‌ܐ ܒܛܝܼܢܸܢܵܗ̇ ܝܸܡܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܟܹܐ ܒܵܣܡܵܐ ܠܘܼܟ݂ ܒܫܲܪܝܼܪܘܼܬܵ‌ܐ ܕܝܼܠܵܗ̇ ܡ̣ܢ ܥܘܼܡܩܵܐ ܕܓܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܕܘܼܟܵܐ ܛܫܝܼܬܵ‌ܐ ܚܸܟ݂ܡܬܵ‌ܐ ܒܸܬ ܡܲܕܥܸܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܕܲܟܹܝܬ ܠܝܼ ܒܙܘܿܦܵܐ ܘܒܸܬ ܗܵܘܹܝܢ ܕܸܟ݂ܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܲܠܸܠܸܬ ܠܝܼ ܘܒܸܬ ܗܵܘܹܝܢ ܒܘܼܫ ܚܘܵܪܵܐ ܡ̣ܢ ܬܲܠܓܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܫܵܡܥܹܢ ܦܨܵܚܵܐ ܘܚܲܕܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܦܵܨܚܝܼ ܓܲܪ̈ܡܹܐ ܕܛܒ݂ܝܼܚ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܛܲܫܝܼ ܦܵܬܘܼܟ݂ ܡ̣ܢ ܚܛܝܼܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܵܝܗ‌ܝ ܥܵܘܠܝܼ̈ ܓܪܘܿܕ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܠܸܒܵܐ ܕܸܟ݂ܝܵܐ ܒܪܝܼ ܓܵܘܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܚܲܕܸܬ ܪܘܼܚܵܐ ܡܗܘܼܡܸܢܬܵ‌ܐ ܒܓܵܘܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܪܲܦܹܝܬ ܠܝܼ ܡ̣ܢ ܗܸܙܘܼܪܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܪܘܼܚܵܐ ܕܩܘܼܕܫܘܼܟ݂ ܠܵܐ ܫܵܩܠܹܬ ܡܸܢܝܼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡܲܕܸܪ ܐܸܠܝܼ ܦܨܵܚܵܐ ܕܦܘܼܪܩܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܪܘܼܚܵܐ ܕܨܸܒ݂ܝܵܢܘܼܬܵ‌ܐ ܣܵܢܕܹܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܒܸܬ ܡܲܠܦܸܢ ܠܥܵܘܵܠܹ̈ܐ ܐܘܼܪ̈ܚܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܚܲܛܵܝܹ̈ܐ ܠܟܸܣܠܘܼܟ݂ ܒܸܬ ܕܵܝܪܝܼ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܦܲܨܝܼ ܠܝܼ ܡ̣ܢ ܚܛܝܼܬܵ‌ܐ ܕܫܲܦܲܟ݂ܬܵ‌ܐ ܕܕܸܡܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ، ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܦܨܝܼܚܘܼܬܵ‌ܐ ܒܸܬ ܙܵܡܹܪ ܠܸܫܵܢܝܼ ܙܲܕܝܼܩܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܦܵܬܚܹܬ ܣܸܦܘܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܩܵܐ ܕܦܘܼܡܝܼ ܡܲܕܸܥ ܬܸܫܒܘܿܚܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܒܵܣܡܵܐ ܠܘܼܟ݂ ܒܕܸܒ݂ܚܵܐ، ܐܸܠܵܐ ܒܸܬ ܝܵܗܒܹܢ ܗܘܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܸܒ݂ܚܵܐ ܡܘܼܩܕܵܐ ܠܹܐ ܗܵܢܝܵܐ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܕܸܒ݂ܚܵܐ ܕܐܲܠܵܗܵܐ ܪܘܼܚܵܐ ܬܒ݂ܝܼܪܬܵ‌ܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܠܸܒܵܐ ܬܒ݂ܝܼܪܵܐ ܘܒܠܝܼܣܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ، ܠܹܐ ܡܲܣܠܹܝܬ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܛܵܒ݂ܬܵ‌ܐ ܒܨܸܒ݂ܝܵܢܘܼܟ݂ ܠܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܵܢܹܝܬ ܫܘܼܪܹ̈ܐ ܕܐܘܿܪܸܫܠܸܡ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܒܸܬ ܒܵܣܡܵܐ ܠܘܼܟ݂ ܒܕܸܒ݂ܚܹ̈ܐ ܕܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܸܒ݂ܚܵܐ ܡܘܼܩܕܵܐ ܘܕܸܒ݂ܚܵܐ ܓܡܝܼܪܵܐܝܼܬ ܡܘܼܩܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܒܸܬ ܡܲܐܣܩܝܼ ܬܵܘܪܹ̈ܐ ܥܲܠܔ ܡܲܕܒܚܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}