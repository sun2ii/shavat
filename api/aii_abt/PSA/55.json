{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ: ܒܩܝܬܪ̈ܐ. ܡܲܣܟܝܼܠܔ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ، ܝܵܐ ܐܲܠܵܗܵܐ، ܠܨܠܘܿܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܛܲܫܹܝܬ ܓܵܢܘܼܟ݂ ܡ̣ܢ ܦܲܪܦܲܠܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܡܲܨܝܸܬ ܐܸܠܝܼ ܘܓ̰ܲܘܸܒ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܢܲܟܢܘܼܟܹܐ ܝܘܸܢ ܒܬܲܢܲܚܬ‌ܝܼ ܘܛܠܝܼܩܬܵ‌ܐ ܝܠܵܗ̇ ܥܲܠܝܼ،","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܩܵܠܵܐ ܕܕܸܫ̃ܡܸܢ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܥܵܘܩܵܢܵܐ ܕܪܲܫܝܼܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܟܹܐ ܡܲܫܦܸܟ݂ܝܼ ܥܲܠܝܼ ܣܸܪܝܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܸܡܬܵ‌ܐ ܟܹܐ ܣܵܢܝܼ ܐܸܠܝܼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܠܸܒܝܼ ܟܹܐ ܪܵܓܹܕ ܒܓܵܘܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܣܘܼܪ̈ܵܕܹܐ ܕܡܵܘܬܵ‌ܐ ܢܦܝܼܠܔ ܠܗܘܿܢ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܙܕܘܼܥܬܵ‌ܐ ܘܪܲܬܪܲܬܬܵ‌ܐ ܥܒ݂ܝܼܪܗܘܿܢ ܒܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܪܓܘܼܕܵܐ ܩܵܡ ܟܲܣܹܐ ܠܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܐܡܝܼܪܝܼ: ”ܛܘܼܒ݂ܵܐ ܕܗܵܘܹܐ ܗܘܵܐ ܠܝܼ ܓܘܼܠܦܵܢܹ̈ܐ ܐܲܝܟ݂ ܝܵܘܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܦܵܪܚܹܢ ܗܘܵܐ ܘܪܵܝܦܹܢ ܗܘܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"”ܗܵܐ، ܒܸܬ ܥܵܪܩܹܢ ܗܘܵܐ ܪܸܚܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܫܵܪܹܝܢ ܗܘܵܐ ܒܠܲܝܠܹܐ ܓܵܘ ܒܲܪܝܼܵܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܡܲܠܝܸܙܸܢ ܠܦܲܪܘܼܩܘܼܗ̇ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܦܵܘܚܵܐ ܚܲܝܠܵܢܵܐ ܘܡ̣ܢ ܥܲܠܥܵܠܵܐ.“","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܲܠܒܸܠܔ، ܝܵܐ ܡܵܪܝܵܐ، ܦܲܠܸܥ ܠܸܫܵܢܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܚܙܹܐ ܠܝܼ ܛܠܘܼܡܝܵܐ ܘܡܲܩܲܪܵܨܘܼܬܵ‌ܐ ܓܵܘ ܡܕܝܼܢ݇ܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܵܡܵܐ ܘܠܲܝܠܹܐ ܟܹܐ ܚܵܕܪܝܼ ܥܲܠܔ ܫܘܼܪ̈ܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܥܵܘܠܵܐ ܘܐܘܼܠܨܵܢܵܐ ܒܓܵܘܘܼܗ̇ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܚܪ̈ܵܒܹܐ ܐܝܼܬ ܓܵܘܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܦܵܪܩܝܼ ܛܠܘܼܡܝܵܐ ܘܦܸܠܡܵܐ ܡ̣ܢ ܫܘܼܩܘܼܗ̇.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܝܗܘܵܐ ܕܸܫ̃ܡܸܢ ܕܠܝܼܡ ܠܹܗ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܕܩܲܒܠܸܢ ܗܘܵܐ.","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܝܗܘܵܐ ܣܵܢܝܵܢܝܼ ܕܓܘܼܪܘܸܣܵܐ ܠܹܗ ܓܵܢܹܗ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܕܛܲܫܹܝܢ ܗܘܵܐ ܠܵܗ̇ ܓܵܢܝܼ ܡܸܢܹܗ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ، ܐܢܵܫܵܐ ܐܲܝܟ݂ ܕܝܼܝܼ،","poem":1},{"lineBreak":true},{"text":"ܪܵܚܡܝܼ ܘܝܵܕܥܵܢܝܼ،","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܕܥܲܡ ܚܕܵܕܹ̈ܐ ܥܒ݂ܝܼܕ ܠܲܢ ܫܵܘܬܵܦܘܼܬܵ‌ܐ ܚܠܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܓܵܘ ܒܲܝܬܵ‌ܐ ܕܐܲܠܵܗܵܐ ܟܹܐ ܚܵܕܪܲܚ ܗܘܵܘ ܥܲܡ ܟܸܢܫܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܐܵܬܹ‌ܐ ܡܵܘܬܵ‌ܐ ܥܲܠܵܝܗ‌ܝ ܡܸܢܫܸܠܬܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܨܵܠܝܼ ܠܫܝܘܿܠܔ ܟܲܕ ܚܵܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܝܼܫܵܬܹ̈‌ܐ ܐܝܼܬ ܓܵܘ ܒܹܝܬ ܡܲܥܡܪ̈ܵܝܗ‌ܝ، ܒܓܵܘܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ، ܠܐܲܠܵܗܵܐ ܒܸܬ ܩܵܪܹܝܢ،","poem":1},{"lineBreak":true},{"text":"ܘܡܵܪܝܵܐ ܒܸܬ ܦܲܪܸܩ ܠܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܪܲܡܫܵܐ، ܘܨܲܦܪܵܐ، ܘܛܲܗܪܵܐ، ܒܸܬ ܩܵܒ݂ܠܹܢ ܘܬܲܢܸܚܸܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܫܵܡܹܥ ܠܹܗ ܩܵܠܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܦܲܪܸܩ ܒܫܠܵܡܵܐ ܓܵܢܝܼ ܡ̣ܢ ܦܠܵܫܵܐ ܕܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܪܵܒܵܐ ܝܢܵܐ ܕܲܠܩܘܼܒ݂ܠܝܼ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܵܡܹܥ ܐܲܠܵܗܵܐ، ܝܵܬܒ݂ܵܢܵܐ ܕܡ̣ܢ ܙܲܒ݂ܢܹ̈ܐ ܩܲܕܝܼܡܵܝܹ̈ܐ، ܘܒܸܬ ܡܲܠܝܸܨ ܠܗܘܿܢ. ܣܹܠܵܗ","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܫܲܚܠܸܦܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܙܵܕܥܝܼ ܡ̣ܢ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܦܘܼܫܸܛ ܠܹܗ ܐܝܼܕܵܬܘܼ̈ܗ‌ܝ ܥܲܠܔ ܕܐܵܢܝܼ ܕܝܼܢܵܐ ܒܫܠܵܡܵܐ ܥܲܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܫܡܝܼܛ ܠܹܗ ܩܵܘܠܹܗ،","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܟ̰ܘܼܥܝܵܐ ܐܲܝܟ݂ ܟܲܪܥܵܐ ܦܘܼܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܝܼܬ ܦܠܵܫܵܐ ܒܠܸܒܹܗ؛","poem":1},{"lineBreak":true},{"text":"ܪܲܟܝܼܟܹܐ ܚܲܒܪ̈ܘܼܗ‌ܝ ܡ̣ܢ ܡܸܫܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܣܲܝܦܹ̈ܐ ܓܪ̈ܝܼܫܹܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܕܪܝܼ ܠܵܗ̇ ܥܲܠܔ ܡܵܪܝܵܐ ܟܵܪܬܘܼܟ݂، ܘܗ̇ܘ ܒܸܬ ܬܲܪܣܹܐ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܫܵܒܹܩ ܠܥܵܠܲܡ ܙܲܕܝܼܩܵܐ ܫܵܥܹܫ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ، ܝܵܐ ܐܲܠܵܗܵܐ، ܒܸܬ ܡܲܨܠܹܝܬ ܠܗܘܿܢ ܠܓܘܼܒܵܐ ܕܚܪܵܒ݂ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܲܦܟ݂ܵܢܹ̈ܐ ܕܕܸܡܵܐ ܘܥܵܒ݂ܕܵܢܹ̈ܐ ܕܦܸܠܡܵܐ ܠܹܐ ܡܵܛܝܼ ܠܦܲܠܓܵܐ ܕܚܲܝܵܝ̈ܗ‌ܝ؛","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ ܒܸܬ ܣܵܒܪܹܢ ܒܝܼܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}