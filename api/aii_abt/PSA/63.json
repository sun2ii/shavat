{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ ܕܕܘܝܕ، ܐܝܡܢ ܕܝܗܘܐ ܓܘ ܒܪܝܐ ܕܝܗܘܕܐ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܐܲܠܵܗ‌ܝܼ ܝܘܸܬ ܐܲܢ݇ܬ، ܒܸܬ ܛܵܥܹܝܢ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܨܗܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܐܸܠܘܼܟ݂ ܓܵܢܝܼ، ܪܲܚܪܘܼܚܹܐ ܝܠܹܗ ܐܸܠܘܼܟ݂ ܢܲܦ̮ܫܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܐܲܪܥܵܐ ܒܵܪܘܿܙܬܵ‌ܐ ܘܟܟ̰ܝܼܚܬܵ‌ܐ ܒܠܵܐ ܡ̈ܝܼܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܓܵܘ ܡܲܩܕܫܵܐ ܩܵܡ ܚܵܙܹܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܚܙܵܝܵܐ ܚܲܝܠܘܼܟ݂ ܘܐܝܼܩܵܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܘܼܫ ܨܦܵܝܝܼ ܝܠܵܗ̇ ܛܲܝܒܘܼܬܘܼܟ݂ ܡ̣ܢ ܚܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܣܸܦܘܵܬ‌ܝܼ̈ ܒܸܬ ܫܲܒܚܝܼ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܒܸܬ ܒܲܪܟܸܢܘܼܟ݂ ܒܚܲܝܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܒܫܸܡܘܼܟ݂ ܒܸܬ ܡܲܪܡܸܢ ܐܝܼܕܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܒܬܲܪܒܵܐ ܘܒܛܪܝܼܨܘܼܬܵ‌ܐ ܒܸܬ ܣܵܒ݂ܥܵܐ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܣܸܦܘܵܬܹ̈‌ܐ ܕܦܨܝܼܚܘܼܬܵ‌ܐ ܒܸܬ ܫܲܒܸܚ ܦܘܼܡܝܼ؛","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܕܵܟ݂ܪܹܢܘܼܟ݂ ܥܲܠܔ ܫܘܝܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܒܲܕ̈ܠܹܐ ܒܸܬ ܗܲܓܹܝܢ ܒܘܼܬ ܕܝܼܘܼܟ݂،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗܘܹܐ ܠܘܼܟ݂ ܗܲܝܲܪܬܵ‌ܐ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܬܚܘܿܬ ܛܸܠܵܢܝܼܬܵ‌ܐ ܕܓܘܼܠܦܵܢܘܼ̈ܟ݂ ܒܸܬ ܫܲܒܚܸܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܬܒܝܼܥ ܠܵܗ̇ ܓܵܢܝܼ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܝܼ ܣܢܝܼܕ ܠܵܗ̇ ܝܲܡܝܼܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܝܼ ܕܟܹܐ ܛܵܥܝܼ ܠܸܛܠܵܩܵܐ ܠܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒ݂ܪܝܼ ܒܬܲܚ̈ܬܵܝܵܬܹ‌ܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܦܵܝܫܝܼ ܣܘܼܦܝܹܐ ܒܐܝܼܕܵܐ ܕܣܲܝܦܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܗܵܘܝܼ ܡܹܐܟ݂ܘܼܠܬܵ‌ܐ ܕܬܲܥ̈ܠܹܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܡܲܠܟܵܐ ܒܸܬ ܦܵܨܹܚ ܒܐܲܠܵܗܵܐ.","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒܹܕ ܫܘܼܒ݂ܗܵܪܵܐ ܟܠܔ ܕܝܵܡܹܐ ܒܝܼܹܗ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܸܬ ܦܵܝܫܝܼ ܐܟ̰ܝܼܡܹܐ ܦܘܼܡܹ̈ܐ ܕܗܲܡܙܸܡܵܢܹ̈ܐ ܕܕܘܼܓܠܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}