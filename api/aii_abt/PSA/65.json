{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ. ܙܡܪܬ‌ܐ."]},{"type":"verse","number":1,"content":[{"text":"ܐܸܠܘܼܟ݂ ܒܸܣܦܵܪܵܐ ܝܠܵܗ̇ ܬܸܫܒܘܿܚܬܵ‌ܐ ܒܨܸܗܝܘܿܢ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܸܠܘܼܟ݂ ܒܸܬ ܦܵܐܹܫ ܦܪܝܼܥܵܐ ܢܸܕܪܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܫܵܡܥܵܢܵܐ ܕܨܠܘܿܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܟܸܣܠܘܼܟ݂ ܟܠܔ ܐܢܵܫܵܐ ܒܸܬ ܐܵܬܹ‌ܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܥܵܘ̈ܠܹܐ ܙܘܼܪܒܸܢܗܘܿܢ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܓܢܵܗܲܢ̈ ܐܲܢ݇ܬ ܟܹܐ ܦܲܚܠܸܬ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܡ̇ܢ ܕܓܲܒܹܝܬ ܘܩܲܪܒܸܢܸܬ ܠܹܗ ܐܸܠܘܼܟ݂","poem":1},{"lineBreak":true},{"text":"ܕܫܵܪܹܐ ܒܕܵܪ̈ܵܬܘܼܟ݂. ܒܸܬ ܣܵܒ݂ܥܲܚ ܒܛܵܒ݂ܬܵ‌ܐ ܕܒܲܝܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܩܲܕܝܼܫܘܼܬܵ‌ܐ ܕܗܲܝܟܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܣܲܗܡܵܢܘܼܝܵܬܹ̈ܐ ܟܹܐ ܓ̰ܲܘܸܒܸܬ ܠܲܢ ܒܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܲܢ،","poem":1},{"lineBreak":true},{"text":"ܣܲܒ݂ܪܵܐ ܕܟܠܵܝܗ‌ܝ ܡܲܪ̈ܙܵܢܹܐ ܕܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܝܵܡܵܬܹ̈‌ܐ ܪ̈ܲܚܝܼܩܹܐ،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡܫܲܬܐܸܣܵܢܵܐ ܕܛܘܼܪܹ̈ܐ ܒܚܲܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܚܠܝܼܨܵܐ ܒܓܲܒܵܪܘܼܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܡܲܫܠܝܼܵܢܵܐ ܕܫܓ݂ܘܼܫܝܵܐ ܕܝܵܡܵܬܹ̈‌ܐ، ܫܓ݂ܘܼܫܝܵܐ ܕܠܲܦܵܝ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܚܒ݂ܵܛܵܐ ܕܥܲܡܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܘܟܹܐ ܙܵܕܥܝܼ ܥܵܡܪ̈ܵܢܹܐ ܕܡܲܪ̈ܙܵܢܹܐ ܕܐܲܪܥܵܐ ܡ̣ܢ ܢܝܼܫܲܢܩܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܦܠܵܛܵܐ ܕܨܲܦܪܵܐ ܘܕܪܲܡܫܵܐ ܟܹܐ ܥܵܒ݂ܕܹܬ ܫܲܒܚܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܘܼܚܒܸܪܘܼܟ݂ ܠܐܲܪܥܵܐ ܘܡܘܼܫܬܝܼܵܐ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܥܵܒ݂ܕܹܬ ܠܵܗ̇ ܥܲܬܝܼܪܬܵ‌ܐ ܪܵܒܵܐ.","poem":1},{"lineBreak":true},{"text":"ܫܵܩܝܼܬܵ‌ܐ ܕܐܲܠܵܗܵܐ ܡܠܝܼܬܵ‌ܐ ܝܠܵܗ̇ ܡ̈ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܬܲܪܨܸܬ ܕܲܚܠܵܝܗ‌ܝ ܣܵܒܵܒ ܗܵܕܟ݂ܵܐ ܗܘܼܕܪܘܼܗ̇ ܝܘܸܬ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܟܪ̈ܝܼܒ݂ܘܼܗ̇ ܟܹܐ ܡܲܫܬܹܝܬ ܒܣܒ݂ܵܥܬܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܫܘܹܝܬ ܝܵܝܘܼ̈ܗ̇.","poem":1},{"lineBreak":true},{"text":"ܒܩܲܫܩܲܫܝܵܬܹ̈‌ܐ ܟܹܐ ܡܲܪܟܸܟܸܬ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡܲܓ̰ܝܲܢܬܘܼܗ̇ ܟܹܐ ܒܲܪܟܸܬ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܘܼܢܦܸܪܘܼܟ݂ ܫܹܢ݇ܬܵ‌ܐ ܒܛܵܒ݂ܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܐܘܼܪ̈ܚܵܬܘܼܟ݂ ܟܹܐ ܡܲܫܦܸܟ݂ܝܼ ܦܸܪܝܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܲܫܦܸܟ݂ܝܼ ܡܲܪ̈ܥܝܹܐ ܕܒܲܪܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܒ݂ܝܼܫܹܐ ܝܢܵܐ ܪ̈ܘܼܡܝܵܬܹ‌ܐ ܦܨܵܚܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܙܩܝܼܪܵܐ ܝܢܵܐ ܡܲܪ̈ܓܹܐ ܒܦܸܣܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓܲܠܝܼܹ̈ܐ ܟܘܼܣܝܹܐ ܝܢܵܐ ܒܕܲܚܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܩܲܘܸܚܝܼ، ܐܘܼܦ ܟܹܐ ܙܵܡܪܝܼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}