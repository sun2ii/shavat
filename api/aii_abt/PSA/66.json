{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܙܡܪܬ‌ܐ. ܡܙܡܘܪܐ."]},{"type":"verse","number":1,"content":[{"text":"ܩܲܘܸܚܘܼܢ ܠܐܲܠܵܗܵܐ ܟܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܙܡܘܿܪܘܼܢ ܠܐܝܼܩܵܪܵܐ ܕܫܸܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܡܲܬܒ݂ܘܼܢ ܐܝܼܩܵܪܵܐ ܠܬܸܫܒܘܿܚܬܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܡܘܿܪܘܼܢ ܠܐܲܠܵܗܵܐ: ”ܟܡܵܐ ܣܲܗܡܵܢܹ̈ܐ ܝܢܵܐ ܦܘܼܠܚܵܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܥܸܠܬܵ‌ܐ ܕܓܘܼܪܘܼܬܵ‌ܐ ܕܥܘܼܫܢܘܼܟ݂ ܒܸܬ ܫܵܠܡܝܼ ܐܸܠܘܼܟ݂ ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"”ܟܠܵܗ̇ ܒܢܲܝ̈ ܐܲܪܥܵܐ ܒܸܬ ܣܵܓ݂ܕܝܼ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܙܵܡܪܝܼ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܙܵܡܪܝܼ ܠܫܸܡܘܼܟ݂.“ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܬܹܝܡܘܼܢ ܘܚܙܹܝܡܘܼܢ ܦܘܼܠܚܵܢܹ̈ܐ ܕܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܲܗܡܵܢܹ̈ܐ ܝܢܵܐ ܦܘܼܠܚܵܢܘܼ̈ܗ‌ܝ ܒܓܵܘܵܐ ܕܒܢܲܝ̈ܢܵܫܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡܘܼܚܕܸܪܹܗ ܝܵܡܵܐ ܠܒܸܪܙܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܓܵܘ ܢܲܗܪܵܐ ܥܒ݂ܝܼܪܗܘܿܢ ܒܐܲܩܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܚܵܕܲܚ ܒܝܼܹܗ ܬܵܡܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܫܲܠܛܵܢܵܐ ܝܠܹܗ ܒܓܲܒܵܪܘܼܬܹܗ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܥܲܝܢܘܼ̈ܗ‌ܝ ܠܐܸܡܘܵܬܹ̈‌ܐ ܟܹܐ ܩܲܙܸܕܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡܵܪ̈ܘܿܕܹܐ ܠܵܐ ܡܲܪܡܝܼ ܓܵܢܵܝܗ‌ܝ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܒܲܪܟ݂ܘܼܢ، ܝܵܐ ܥܲܡܡܹ̈ܐ، ܠܐܲܠܵܗܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܫܡܸܥܡܘܼܢ ܩܵܠܵܐ ܕܬܸܫܒܘܿܚܬܹܗ،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗ̇ܘ ܕܚܘܼܡܹܐ ܠܹܗ ܓܵܢܲܢ ܒܚܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܫܒ݂ܝܼܩ ܠܹܗ ܕܫܵܥܫܵܐ ܐܲܩܠܲܢ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܩܵܡ ܒܵܚܪܹܬ ܠܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܨܲܪܸܦܸܬ ܠܲܢ ܐܲܝܟ݂ ܨܲܪܲܦܬܵ‌ܐ ܕܣܹܐܡܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܡܲܥܒܸܪܸܬ ܠܲܢ ܓܵܘ ܓܲܪܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܬܸܒ݂ ܠܘܼܟ݂ ܟܵܪܬܵ‌ܐ ܥܲܠܔ ܚܵܨܲܢ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡܘܼܪܟܸܒ݂ ܠܘܼܟ݂ ܒܲܪܢܵܫܵܐ ܒܪܹܝܫܲܢ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܪܲܢ ܒܢܘܼܪܵܐ ܘܒܡ̈ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܩܵܡ ܦܲܠܛܸܬ ܠܲܢ ܠܕܘܼܟܬܵ‌ܐ ܕܦܸܪܝܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒ݂ܪܹܢ ܠܒܲܝܬܘܼܟ݂ ܒܕܸܒ݂ܚܹ̈ܐ ܡܘܼܩܕܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܬܲܡܸܡܸܢ ܐܸܠܘܼܟ݂ ܢܸܕܪ̈ܝܼ؛","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܲܝܢܝܼ ܕܗܘܼܡܙܸܡ ܠܗܘܿܢ ܣܸܦܘܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܦܠܝܼܛ ܠܗܘܿܢ ܡ̣ܢ ܦܘܼܡܝܼ ܟܲܕ ܒܥܵܘܩܵܢܵܐ ܝܘܸܢ ܗܘܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܕܸܒ݂ܚܹ̈ܐ ܡܘܼܩܕܹ̈ܐ ܕܛܪ̈ܝܼܨܹܐ ܒܸܬ ܡܲܐܣܩܸܢ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܥܲܡ ܒܸܣܡܵܐ ܕܒܲܪ̈ܥܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒ݂ܕܹܢ ܕܸܒ݂ܚܹ̈ܐ ܕܬܵܘܪܹ̈ܐ ܥܲܡ ܓܸܕܝܹ̈ܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܬܹܝܡܘܼܢ ܫܡܹܥܡܘܼܢ ܟܠܵܝܗ‌ܝ ܙܕܝܼ̈ܥܹܐ ܕܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܗܲܩܹܝܢ ܡܸܢܕܝܼ ܕܥܒ݂ܝܼܕ ܠܹܗ ܩܵܐ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܐܸܠܹܗ ܒܦܘܼܡܝܼ ܩܪܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܦܝܼܫ ܠܹܗ ܡܘܼܪܡܵܐ ܒܠܸܫܵܢܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܢܵܛܪܹܢ ܗܘܵܐ ܥܵܘܠܵܐ ܒܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܫܵܡܹܥ ܗܘܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܒܫܪܵܪܵܐ، ܫܡܝܼܥ ܠܹܗ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܨܝܸܬ ܠܹܗ ܠܩܵܠܵܐ ܕܨܠܘܿܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܡܘܼܕܸܪܹܗ ܨܠܘܿܬ‌ܝܼ، ܐܵܦܠܵܐ ܡܘܼܥܒܸܪܹܗ ܛܲܝܒܘܼܬܹܗ ܡܸܢܝܼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}