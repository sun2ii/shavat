{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܡܙܡܘܪܐ ܕܕܘܝܕ. ܙܡܪܬ‌ܐ."]},{"type":"verse","number":1,"content":[{"text":"ܟܹܐ ܩܵܐܹܡ ܐܲܠܵܗܵܐ، ܟܹܐ ܒܲܪܒܸܙܝܼ ܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܥܵܪܩܝܼ ܣܵܢܝܵܢܘܼ̈ܗ‌ܝ ܡ̣ܢ ܩܲܕܡܘܼܗ‌ܝ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܕܦܵܐܹܫ ܒܘܼܪܒܸܙܵܐ ܬܸܢܵܐ ܒܲܪܒܸܙܸܬ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܕܦܵܫܪܵܐ ܫܲܡܲܥ ܡ̣ܢ ܩܲܕܡ ܢܘܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܛܵܠܩܝܼ ܪ̈ܲܫܝܼܥܹܐ ܡ̣ܢ ܩܲܕܡ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܙܲܕܝܼܩܹ̈ܐ ܚܵܕܝܼ ܘܦܵܨܚܝܼ ܩܲܕܡ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܗܵܘܝܼ ܦܨܝܼܚܹܐ ܒܚܲܕܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܫܲܒܚܘܼܢ ܠܐܲܠܵܗܵܐ، ܙܡܘܿܪܘܼܢ ܫܸܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܡܲܪܡܘܼܢ ܠܪܲܟܵܒ݂ܵܐ ܒܕܸܫܝܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܝܠܹܗ ܫܸܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܦܨܘܿܚܘܼܢ ܩܲܕܡܘܼܗ‌ܝ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܵܒܵܐ ܕܝܲܬܘܼܡܹ̈ܐ ܘܥܵܒ݂ܕܵܢܵܐ ܕܕܝܼܘܵܢ ܕܐܲܪ̈ܡܸܠܝܵܬܹ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܒܡܲܥܡܪܵܐ ܕܩܘܼܕܫܹܗ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܟܹܐ ܡܲܬܸܒ݂ ܒܒܲܝܬܵ‌ܐ ܠܐܵܢܝܼ ܕܝܼܢܵܐ ܒܢܲܦ̮ܫܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܦܲܠܸܛ ܐܲܣܝܼܪܹ̈ܐ ܠܟܲܫܝܼܪܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܡܵܪ̈ܘܿܕܹܐ ܟܹܐ ܥܵܡܪܝܼ ܒܐܲܪܥܵܐ ܨܗܝܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܟܲܕ ܦܠܝܼܛ ܠܘܼܟ݂ ܩܲܕܡ ܥܲܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܦܣܵܥܬܘܼܟ݂ ܓܵܘ ܒܲܪܝܼܵܐ، ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܲܪܥܵܐ ܫܥܝܼܫ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܫܡܲܝܹ̈ܐ ܡܘܼܢܛܸܦ ܠܗܘܿܢ ܡܸܛܪܵܐ ܩܲܕܡ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܕܐܵܗܵܐ ܣܝܼܢܲܝ؛ ܡ̣ܢ ܩܲܕܡ ܐܲܠܵܗܵܐ، ܐܲܠܵܗܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܸܛܪܵܐ ܕܨܸܒ݂ܝܵܢܵܐ ܡܘܼܫܦܸܟ݂ ܠܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܝܵܪܬܘܼܬܘܼܟ݂ ܟܲܕ ܢܘܝܼܠܔ ܠܵܗ̇ ܐܲܢ݇ܬ ܬܘܼܪܣܝܼܵܐ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܦܸܣܩܘܼܟ݂ ܝܬܝܼܒ݂ ܠܗܘܿܢ ܓܵܘܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܬܘܼܪܣܹܐ ܠܘܼܟ݂ ܒܛܲܝܒܘܼܬܘܼܟ݂ ܠܡܸܣܟܹܢܹ̈ܐ، ܝܵܐ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܟܹܐ ܝܵܗܒܹܠܔ ܦܘܼܩܕܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܟ݂ܬܵܬܹ̈‌ܐ ܕܡܲܫܚܸܕܝܼ ܠܹܗ ܚܲܝܠܵܐ ܓܘܼܪܵܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܡܲܠܟܹ̈ܐ ܕܚܲܝܠܵܘܵܬܹ̈‌ܐ ܟܹܐ ܥܵܪܩܝܼ، ܟܹܐ ܥܵܪܩܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܥܵܡܪܵܢܬܵ‌ܐ ܕܒܲܝܬܵ‌ܐ ܟܹܐ ܦܲܠܥܵܐ ܣܠܵܒܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܵܦܸܢ ܕܕܵܡܟ݂ܝܼܬܘܿܢ ܒܓܵܘܵܐ ܕܓܘܼܡܵܢܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܠܦܵܢܹ̈ܐ ܕܝܵܘܢܵܐ ܩܪܝܼܡܹܐ ܝܢܵܐ ܒܣܹܐܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܲܪ̈ܘܼܗ̇ ܒܕܲܗܒ݂ܵܐ ܡܲܙܪܘܼܟ̰ܹܐ ܩܝܼܢܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܒܘܼܪܒܸܙ ܠܹܗ ܐܹܝܠܔ ܫܲܕܲܝ ܡܲܠܟܹ̈ܐ ܓܵܘܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܒܸܥܪܵܝܵܐ ܝܗܘܵܐ ܬܲܠܓܵܐ ܓܵܘ ܨܲܠܡܘܿܢ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܛܘܼܪܵܐ ܕܐܲܠܵܗܵܐ ܛܘܼܪܵܐ ܕܒܲܝܫܵܢ ܝܼܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܛܘܼܪܵܐ ܡܵܪܹܐ ܩܲܪ̈ܩܲܦܝܵܬܹ‌ܐ ܝܠܹܗ ܛܘܼܪܵܐ ܕܒܲܝܫܵܢ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܛܘܼܪ̈ܵܢܹܐ ܡܵܪܹܐ ܩܲܪ̈ܩܲܦܝܵܬܹ‌ܐ، ܩܵܡܘܿܕܝܼ ܚܵܝܪܝܼܬܘܿܢ ܒܥܲܝܢܵܐ ܕܒܲܚܲܠܬܵ‌ܐ","poem":1},{"lineBreak":true},{"text":"ܠܛܘܼܪܵܐ ܕܒܣܝܼܡ ܠܵܗ̇ ܠܹܗ ܐܲܠܵܗܵܐ ܠܸܬܝܵܒ݂ܵܐ ܓܵܘܹܗ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܠܥܵܠܲܡ ܡܵܪܝܵܐ ܒܸܬ ܫܵܪܹܐ ܓܵܘܹܗ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܡܲܪ̈ܟܒ݂ܵܬܹ‌ܐ ܕܐܲܠܵܗܵܐ ܬܲܪܬܹܝ ܪܸ̈ܒܘܵܬܹ‌ܐ ܝܢܵܐ، ܐܲܠܦܹ̈ܐ ܥܲܠܔ ܐܲܠܦܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܕܣܝܼܢܲܝ ܒܓܵܘܵܝܗ‌ܝ ܝܠܹܗ ܒܩܲܕܝܼܫܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܐܣܝܼܩ ܠܘܼܟ݂ ܠܡܪܵܘܡܵܐ، ܠܘܼܒܸܠܔ ܠܘܼܟ݂ ܐܲܣܝܼܪܹ̈ܐ ܠܐܲܣܝܼܪܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܩܝܼܠܔ ܠܘܼܟ݂ ܡܵܘܗܒ݂ܵܬܹ̈‌ܐ ܡ̣ܢ ܒܢܲܝ̈ܢܵܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܘܼܦ ܡ̣ܢ ܡܵܪ̈ܘܿܕܹܐ، ܕܫܵܪܹܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܬܵܡܵܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܘܡܵܐ ܒܝܵܘܡܵܐ ܟܹܐ ܛܵܥܹܢ ܝܘܼܩܪܲܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܲܢ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܐܸܠܲܢ ܐܲܠܵܗܵܐ ܕܦܘܼܪ̈ܩܵܢܹܐ ܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܕܐܲܠܵܗܵܐ ܡܵܪܝܵܐ ܝܢܵܐ ܦܠܵܛܹ̈ܐ ܡ̣ܢ ܡܵܘܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܒܫܪܵܪܵܐ ܐܲܠܵܗܵܐ ܒܸܬ ܒܵܠܹܣ ܪܹܝܫܵܐ ܕܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܩܲܪܩܲܦܬܵ‌ܐ ܡܸܙܬܵܢܬܵ‌ܐ ܕܚܵܕܪܵܢܵܐ ܒܓܢܵܗܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܹܗ ܡܵܪܝܵܐ: ”ܡ̣ܢ ܒܲܝܫܵܢ ܒܸܬ ܡܲܕܸܪܸܢܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܕܸܪܸܢܗܘܿܢ ܡ̣ܢ ܥܘܼܡܩܹ̈ܐ ܕܝܵܡܵܐ،","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"”ܩܵܐ ܕܒܵܠܣܵܐ ܠܗܘܿܢ ܐܲܩܠܘܼܟ݂ ܒܕܸܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܸܫܵܢܹ̈ܐ ܕܟܲܠܒܘܼ̈ܟ݂ ܩܲܒܠܝܼ ܣܵܗܡܵܝܗ‌ܝ ܡ̣ܢ ܕܸܫ̃ܡܸܢܹ̈ܐ.“","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܚܙܹܐ ܠܗܘܿܢ ܙܘܼܝܵܚܘܼ̈ܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܙܘܼܝܵܚܹ̈ܐ ܕܐܲܠܵܗ‌ܝܼ ܡܲܠܟܝܼ ܒܒܹܝܬ ܩܘܼܕܫܵܐ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܩܘܼܕܸܡ ܠܗܘܿܢ ܙܲܡܵܪܹ̈ܐ، ܒܵܬܪܵܝܗ‌ܝ ܡܵܚܝܵܢܹ̈ܐ ܕܩܝܼܬܵܪܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܓܵܘܵܐ ܕܥܠܲܝܡܵܬܹ̈‌ܐ ܡܵܚܝܵܢܹ̈ܐ ܕܦܠܲܓܹ̈ܐ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܓܵܘ ܟܢܘܼܫܝܹ̈ܐ ܒܲܪܟ݂ܘܼܢ ܠܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܲܪܟ݂ܘܼܢ ܠܡܵܪܝܵܐ، ܐܲܚܬܘܿܢ ܕܡ̣ܢ ܡܲܒܘܼܥܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܬܵܡܵܐ ܝܠܹܗ ܒܸܢܝܵܡܹܝܢ ܙܥܘܿܪܵܐ، ܫܲܠܝܼܛܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܪ̈ܵܢܹܐ ܕܝܼܗܘܼܕܵܐ ܒܟܸܢܫܵܝ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܪ̈ܵܢܹܐ ܕܙܒ݂ܘܿܠܘܿܢ ܘܓܘܼܪ̈ܵܢܹܐ ܕܢܲܦ̮ܬܵܠܝܼ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܦܩܘܿܕ، ܝܵܐ ܐܲܠܵܗܵܐ، ܥܘܼܫܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܚܲܠܸܢ، ܝܵܐ ܐܲܠܵܗܵܐ، ܡܸܢܕܝܼ ܕܦܠܝܼܚ ܠܘܼܟ݂ ܐܸܠܲܢ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܗܲܝܟܠܘܼܟ݂ ܒܐܘܿܪܸܫܠܸܡ،","poem":1},{"lineBreak":true},{"text":"ܡܲܠܟܹ̈ܐ ܒܸܬ ܡܲܝܬ‌ܝܼ ܠܘܼܟ݂ ܕܲܫܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ܢܓ̰ܘܿܘ ܒܗܲܝܘܵܢ ܕܙܹܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܓ̰ܵܡܵܥܲܬ ܕܬܵܘܪܹ̈ܐ ܥܲܡ ܡܘܼܓ̰ܹ̈ܐ ܕܥܲܡܡܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܟܘܼܦܹܐ ܓܵܢܵܝܗ‌ܝ ܘܡܲܩܪܘܼܒܹܐ ܩܸܛܥܵܛܹ̈ܐ ܕܣܹܐܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܲܪܒܸܙ ܥܲܡܡܹ̈ܐ ܕܟܹܐ ܒܵܣܡܵܐ ܠܗܘܿܢ ܒܦܠܵܫܹ̈ܐ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܐܵܬ‌ܝܼ ܐܝܼܙܓܲܕܹ̈ܐ ܡ̣ܢ ܡܸܨܪܹܝܢ،","poem":1},{"lineBreak":true},{"text":"ܟܘܼܫ ܒܸܬ ܦܲܫܛܵܐ ܐܝܼܕܵܬܘܼ̈ܗ̇ ܠܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܲܠܟܘܵܬܹ̈‌ܐ ܕܐܲܪܥܵܐ، ܫܲܒܚܘܼܢ ܠܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܙܡܘܿܪܘܼܢ ܠܡܵܪܝܵܐ، ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ܠܪܵܟܒ݂ܵܢܵܐ ܕܥܲܠܔ ܫܡܲܝ̈ ܫܡܲܝܹ̈ܐ ܩܲܕܝܼܡܵܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܗܵܐ، ܪܲܦܘܼܝܹܗ ܩܵܠܹܗ، ܩܵܠܵܐ ܙܲܪܒܵܢܵܐ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ܗܲܒ݂ܠܘܼܢ ܥܘܼܫܢܵܐ ܠܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܐܝܼܣܪܵܐܹܝܠܔ ܝܠܵܗ̇ ܪܵܡܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܚܲܝܠܹܗ ܒܪܩܝܼܥܵܐ.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ܣܲܗܡܵܢܵܐ ܝܘܸܬ، ܝܵܐ ܐܲܠܵܗܵܐ، ܡ̣ܢ ܡܲܩܕܫܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ ܗ̇ܘ ܟܹܐ ܝܵܗܒܹܠܔ ܥܘܼܫܢܵܐ ܘܚܲܝܠܵܐ ܠܥܲܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܐܲܠܵܗܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}