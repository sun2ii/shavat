{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܥܠܔ ܫܘܼܫܲܢܝܼܡ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܦܲܪܸܩ ܠܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܛܹܐ ܠܗܘܿܢ ܡ̈ܝܼܵܐ ܗܲܠܔ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܛܒܝܼܥ ܠܝܼ ܓܵܘ ܛܝܼܢܵܐ ܥܲܡܘܼܩܵܐ ܘܠܲܝܬ ܕܘܼܟܬܵ‌ܐ ܕܟܠܵܝܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܪܝܼ ܒܥܘܼܡܩܹ̈ܐ ܕܡ̈ܝܼܵܐ ܘܛܵܘܦܵܢܵܐ ܩܵܡ ܟܲܪܦܸܫ ܠܝܼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܟܟ̰ܝܼܚ ܠܝܼ ܒܩܪܵܝܬ‌ܝܼ، ܚܪܝܼܟ݂ ܠܵܗ̇ ܒܵܠܘܿܥܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܚܒܹܐ ܠܗܘܿܢ ܥܲܝܢܝܼ̈ ܒܸܣܦܵܪܵܐ ܠܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܘܼܫ ܪܵܒܵܐ ܝܢܵܐ ܡ̣ܢ ܡܸܙܝܵܬܹ̈‌ܐ ܕܪܹܝܫܝܼ ܣܵܢܝܵܢܝܼ̈ ܕܠܵܐ ܥܸܠܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܙܘܼܪܒܸܢܗܘܿܢ ܛܲܠܩܵܢܝܼ̈، ܕܸܫ̃ܡܸܢܝܼ̈ ܕܒܕܘܼܓܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܕܸܪܝܼ ܡܸܢܕܝܼ ܕܠܹܐ ܝܘܸܢ ܗܘܵܐ ܟ̰ܠܝܼܓ̰ܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܐܲܢ݇ܬ ܟܹܐ ܝܵܕܥܹܬ ܣܲܟ݂ܠܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܢܵܗ‌ܝܼ̈ ܡܸܢܘܼܟ݂ ܠܹܐ ܝܢܵܐ ܛܸܫܝܹܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܢܵܟ݂ܦܝܼ ܒܘܼܬ ܕܝܼܝܼ ܣܵܒܪ̈ܵܢܹܐ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ؛","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܦܵܝܫܝܼ ܢܟ݂ܝܼܦܹܐ ܒܘܼܬ ܕܝܼܝܼ ܛܵܥܝܵܢܹ̈ܐ ܕܐܸܠܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܘܼܬ ܕܝܼܘܼܟ݂ ܩܘܼܒܸܠܔ ܠܝܼ ܠܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܘܼܣܹܐ ܠܵܗ̇ ܢܟܸܦܬܵ‌ܐ ܠܦܵܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܩܵܪܝܼܒܵܝܵܐ ܗܘܹܐ ܠܝܼ ܠܐܲܚܘܿܢܘܵܬ‌ܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܢܘܼܟ݂ܪܵܝܵܐ ܠܒܢܘܿܢܹ̈ܐ ܕܝܸܡܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܛܢܵܢܵܐ ܕܒܲܝܬܘܼܟ݂ ܩܵܡ ܐܵܟܹܠܔ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܘܡܹ̈ܐ ܕܠܵܝܡܵܢܘܼ̈ܟ݂ ܢܦܝܼܠܔ ܠܗܘܿܢ ܥܲܠܝܼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܘܒܟܹܐ ܠܝܼ ܓܵܘ ܓܵܢܝܼ ܒܨܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܹܗ ܠܠܵܘܡܵܐ ܐܸܠܝܼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܘܥܒ݂ܝܼܕ ܠܝܼ ܠܒ݂ܝܼܫܬ‌ܝܼ ܣܲܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܝܼ ܐܸܠܵܝܗ‌ܝ ܠܡܲܬܠܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܗܲܡܙܸܡܝܼ ܒܘܼܬ ܕܝܼܝܼ ܝܵܬܒ݂ܵܢܹ̈ܐ ܒܕܲܪܘܵܙܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܝܼ ܙܡܵܪ̈ܝܵܬܹ‌ܐ ܠܫܵܬܝܵܢܹ̈ܐ ܕܫܲܟ݂ܪܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ، ܨܠܘܿܬ‌ܝܼ ܐܸܠܘܼܟ݂ ܝܠܵܗ̇، ܝܵܐ ܡܵܪܝܵܐ، ܒܙܲܒ݂ܢܵܐ ܡܩܲܒܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܒܦܸܪܝܘܼܬܵ‌ܐ ܕܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܓ̰ܲܘܸܒ ܠܝܼ ܒܫܲܪܝܼܪܘܼܬܵ‌ܐ ܕܦܘܼܪܩܵܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܦܲܨܝܼ ܠܝܼ ܡ̣ܢ ܛܝܼܢܵܐ ܕܠܵܐ ܛܵܒܥܹܢ،","poem":1},{"lineBreak":true},{"text":"ܦܵܝܫܹܢ ܦܘܼܨܝܵܐ ܡ̣ܢ ܣܵܢܝܵܢܝܼ̈، ܘܡ̣ܢ ܥܘܼܡܩܵܐ ܕܡ̈ܝܼܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܟܲܪܦܸܫ ܠܝܼ ܛܵܘܦܵܢܵܐ ܕܡ̈ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܒܵܠܹܥ ܐܸܠܝܼ ܥܘܼܡܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܐܵܟ̰ܹܡ ܥܲܠܝܼ ܒܹܐܪܵܐ ܦܘܼܡܹܗ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܓ̰ܲܘܸܒ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܒܗ̇ܝ ܕܨܦܵܝܝܼ ܝܠܵܗ̇ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܦܸܪܝܘܼܬܵ‌ܐ ܕܪ̈ܲܚܡܘܼܟ݂ ܕܘܼܪ ܐܸܠܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܘܠܵܐ ܛܲܫܹܝܬ ܦܵܬܘܼܟ݂ ܡ̣ܢ ܪܹܓܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܥܝܼܩ ܠܵܗ̇ ܐܸܠܝܼ؛ ܡܲܠܝܸܙ ܓ̰ܲܘܸܒ ܠܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܩܲܪܒܸܢ ܠܓܵܢܝܼ، ܦܲܨܝܼ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܕܸܫ̃ܡܸܢܝܼ̈ ܦܲܪܸܩ ܠܝܼ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܟܹܐ ܝܵܕܥܹܬ ܠܵܘܡܝܼ، ܘܢܟܸܦܬ‌ܝܼ، ܘܡܲܣܠܲܝܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܩܲܕܡܘܼܟ݂ ܝܼܢܵܐ ܟܠܵܝܗ‌ܝ ܡܲܠܝܸܨܵܢܝܼ̈.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܠܵܘܡܵܐ ܬܒ݂ܝܼܪܹܗ ܠܸܒܝܼ ܘܩܵܡ ܡܲܡܪܸܥ ܠܝܼ.","poem":1},{"lineBreak":true},{"text":"ܣܦܝܼܪܝܼ ܠܚܲܕ ܕܡܲܩܸܕ ܠܸܒܵܐ ܥܲܠܝܼ، ܐܝܼܢܵܐ ܠܲܝܬ،","poem":1},{"lineBreak":true},{"text":"ܘܠܝܵܗܒ݂ܵܢܹ̈ܐ ܕܠܸܒܵܐ، ܐܝܼܢܵܐ ܠܵܐ ܡܘܼܫ݇ܟ̰ܸܚ ܠܝܼ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܘܝܘܼܗܒܹܠܔ ܠܗܘܿܢ ܡܪܵܪܹ̈ܐ ܩܵܐ ܐܟ݂ܵܠܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܐ ܨܲܗܘܝܼ ܩܵܡ ܡܲܫܬ‌ܝܼ ܠܝܼ ܚܲܠܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܗܵܘܹܐ ܦܵܬܘܿܪܵܝܗ‌ܝ ܠܦܲܚܵܐ ܩܲܕܡܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܗܵܘܹܐ ܫܠܵܡܵܝܗ‌ܝ ܠܩܘܼܠܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܚܵܒ݂ܝܼ ܥܲܝ̈ܢܵܝܗ‌ܝ ܡ̣ܢ ܠܸܚܙܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܡܝܼܢܵܐܝܼܬ ܪܵܓܹܕ ܚܲܨܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܡܲܫܦܸܟ݂ ܟܲܪܒܘܼܟ݂ ܥܲܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܚܸܡܬܵ‌ܐ ܕܟܲܪܒܘܼܟ݂ ܡܵܛܝܵܐ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܗܵܘܹܐ ܡܲܥܡܪܵܝܗ‌ܝ ܚܵܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܡܲܫܟܢܵܝ̈ܗ‌ܝ ܠܵܐ ܗܵܘܹܐ ܥܵܡܪܵܢܵܐ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܗ̇ܘ ܕܐܲܢ݇ܬ ܡܚܹܐ ܠܘܼܟ݂، ܪܕܝܼܦ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܗܲܩܝܼ ܒܘܼܬ ܟܹܐܒܹ̈ܐ ܕܡܵܢܝܼ ܕܕܘܼܪܒܸܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܥܵܘܠܵܐ ܥܲܠܔ ܥܵܘܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܫܵܒ݂ܩܹܬ ܥܵܒ݂ܪܝܼ ܒܙܲܕܝܼܩܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܦܵܝܫܝܼ ܓܪܝܼܕܹܐ ܡ̣ܢ ܟܬܵܒ݂ܵܐ ܕܚܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܡ ܙܲܕܝܼܩܹ̈ܐ ܠܵܐ ܦܵܝܫܝܼ ܟܬܝܼܒܹܐ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ، ܡܸܣܟܹܢܵܐ ܝܘܸܢ ܘܕܘܼܪܕܸܫ̃ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܘܼܪܩܵܢܘܼܟ݂ ܡܲܪܸܡ ܠܝܼ ܠܫܲܝܢܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܒܚܸܢ ܠܫܸܡܵܐ ܕܐܲܠܵܗܵܐ ܒܙܡܵܪܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܓܲܪܘܸܣܸܢܹܗ ܒܫܲܟܲܪܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ܐܵܗܵܐ ܒܸܬ ܫܵܦܪܵܐ ܠܡܵܪܝܵܐ ܒܘܼܫ ܡ̣ܢ ܕܒ݂ܵܚܬܵ‌ܐ ܕܬܵܘܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܡܘܼܓ̰ܵܐ ܡܵܪܹܐ ܩܲܪ̈݇ܢܵܢܹܐ ܘܣܸܡܵܬܹ̈‌ܐ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܚܵܙܝܼ ܡܸܣܟܹܢܹ̈ܐ ܘܒܸܬ ܦܵܨܚܝܼ.","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܛܵܥܝܵܢܹ̈ܐ ܕܐܲܠܵܗܵܐ، ܚܵܝܹܐ ܠܸܒܵܘܟ݂ܘܿܢ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܫܵܡܹܥ ܡܵܪܝܵܐ ܠܣܢܝܼܩܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܐܲܣܝܼܪ̈ܘܼܗ‌ܝ ܠܹܐ ܡܲܣܠܹܐ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ܫܲܒܚܝܼ ܠܹܗ ܫܡܲܝܵܐ ܘܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܡܵܬܹ̈‌ܐ ܘܟܠܔ ܕܪܵܚܹܫ ܓܵܘܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܠܵܗܵܐ ܒܸܬ ܦܲܪܸܩ ܠܨܸܗܝܘܿܢ ܘܒܵܢܹܐ ܡܕܝܼܢܵܬܹ̈‌ܐ ܕܝܼܗܘܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܝܵܬܒ݂ܝܼ ܬܵܡܵܐ ܘܝܵܪܬ‌ܝܼ ܠܵܗ̇.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ܘܙܲܪ̈ܥܹܐ ܕܪܹ̈ܓܵܘܵܬܘܼܗ‌ܝ ܒܸܬ ܝܵܪܬ‌ܝܼ ܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܚܸܒܵܢܹ̈ܐ ܕܫܸܡܹܗ ܒܸܬ ܫܵܪܝܼ ܓܵܘܘܼܗ̇.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}