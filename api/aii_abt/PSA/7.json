{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"heading","content":["ܫܸܓܝܘܿܢ ܕܕܘܝܕ، ܗ̇ܘ ܕܙܡܝܪܗ ܠܡܪܝܐ ܥܠܔ ܟܘܫ ܒܢܝܡܝܢܝܐ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܒܝܼܘܼܟ݂ ܫܩܝܼܠܔ ܠܝܼ ܓܵܘܣܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܸܩ ܠܝܼ ܡ̣ܢ ܟܠܵܝܗ‌ܝ ܪ̈ܵܕܘܿܦܝܼ ܘܦܲܨܝܼ ܠܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܗܵܘܹܐ ܕܐܲܝܟ݂ ܐܲܪܝܵܐ ܦܲܪܦܸܛ ܠܵܗ̇ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܵܪܹܛ ܟܲܕ ܠܲܝܬ ܦܲܨܝܵܢܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܐܸܢ ܥܒ݂ܝܼܕ ܠܝܼ ܐܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܸܢ ܐܝܼܬ ܥܵܘܠܵܐ ܒܐܝܼܕܝܼ̈؛","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܦܪܝܼܥ ܠܝܼ ܒܝܼܫܬܵ‌ܐ ܠܡ̇ܢ ܕܝܼܠܹܗ ܒܫܠܵܡܵܐ ܥܲܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܣܠܝܼܒ ܠܝܼ ܠܕܲܠܩܘܼܒ݂ܠܵܝܝܼ ܒܠܵܐ ܥܸܠܬܵ‌ܐ؛","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܢܵܦܹܠܔ ܕܸܫ̃ܡܸܢ ܒܵܬܪ ܓܵܢܝܼ ܘܡܵܛܹܐ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܕܲܫܕܸܫ ܠܐܲܪܥܵܐ ܚܲܝܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܬܸܒ݂ ܠܥܲܦܪܵܐ ܐܝܼܩܵܪܝܼ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ، ܒܟܲܪܒܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܲܪܸܡ ܓܵܢܘܼܟ݂ ܥܲܠܔ ܚܸܡܬܵ‌ܐ ܕܕܸܫ̃ܡܸܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܘܪܥܘܿܫ ܒܘܼܬ ܕܝܼܝܼ ܒܕܝܼܘܵܢ ܕܦܩܝܼܕܵܐ ܝܘܸܬ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܘܫܒ݂ܘܿܩ ܟܸܢܫܵܐ ܕܐܸܡܘܵܬܹ̈‌ܐ ܓ̰ܵܡܥܝܼ ܚܵܕܸܪ̈ܘܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܝܬܘܿܒ݂ ܥܲܠܵܝܗ‌ܝ ܕܲܝܵܢܵܐ ܡ̣ܢ ܪܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܟܹܐ ܕܵܐܹܢ ܠܥܲܡܡܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܠܵܗ̇ ܕܝܼܘܵܢܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܐܲܝܟ݂ ܙܲܕܝܼܩܘܼܬ‌ܝܼ ܘܐܲܝܟ݂ ܬܲܡܝܼܡܘܼܬܵ‌ܐ ܕܐܝܼܬ ܒܝܼܝܼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܫܒ݂ܘܿܩ ܬܵܝܡܵܐ ܒܝܼܫܬܵ‌ܐ ܕܪ̈ܲܫܝܼܥܹܐ، ܘܡܲܩܘܝܼ ܠܙܲܕܝܼܩܵܐ؛","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܒܵܚܪܵܢܵܐ ܕܠܸܒܵܘܵܬܹ̈‌ܐ ܘܪܸ̈ܥܝܵܢܹܐ، ܐܲܠܵܗܵܐ ܙܲܕܝܼܩܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܡܵܛܵܠܝܼ ܝܠܹܗ ܥܲܡ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܩܵܢܵܐ ܕܬܪ̈ܘܼܨܹܐ ܕܠܸܒܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܕܲܝܵܢܵܐ ܙܲܕܝܼܩܵܐ ܝܠܹܗ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܘ ܚܸܡܬܵ‌ܐ ܝܠܹܗ ܐܲܠܵܗܵܐ ܟܠܔ ܝܘܿܡ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܠܵܐ ܬܲܘܸܒ ܐܢܵܫܵܐ، ܣܲܝܦܹܗ ܒܸܬ ܡܲܚܪܸܦ ܠܹܗ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܸܫܬܹܗ ܡܬܝܼܚܘܼܗ̇ ܝܠܹܗ ܘܗܘܼܕܪܘܼܗ̇.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܘܙܲܝܢܹ̈ܐ ܕܡܵܘܬܵ‌ܐ ܗܘܼܕܪܵܝ ܠܹܗ ܐܸܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܓܹܐܪ̈ܘܼܗ‌ܝ ܥܒ݂ܝܼܕܵܝ ܠܵܗܝܵܢܹ̈ܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܪܲܫܝܼܥܵܐ ܟܹܐ ܕܵܒܹܩ ܚܸܒ݂ܠܹ̈ܐ ܕܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܒܵܛܹܢ ܐܘܼܠܨܵܢܵܐ، ܘܝܵܠܹܕ ܦܸܠܡܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܒܹܐܪܵܐ ܟܹܐ ܥܵܩܹܪ ܘܚܵܦܹܪ،","poem":1},{"lineBreak":true},{"text":"ܘܢܵܦܹܠܔ ܒܓܘܼܒܵܐ ܕܬܘܼܪܸܨ ܠܹܗ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܐܘܼܠܨܵܢܹܗ ܒܪܹܝܫܹܗ ܒܸܬ ܕܵܐܹܪ،","poem":1},{"lineBreak":true},{"text":"ܘܛܠܘܼܡܝܹܗ ܠܩܲܪܩܲܦܬܹܗ ܒܸܬ ܨܵܠܹܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܸܢ ܠܡܵܪܝܵܐ ܐܲܝܟ݂ ܙܲܕܝܼܩܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܙܵܡܪܹܢ ܫܸܡܵܐ ܕܡܵܪܝܵܐ ܥܸܠܵܝܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}