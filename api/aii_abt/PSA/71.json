{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"ܒܝܼܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܫܩܝܼܠܔ ܠܝܼ ܓܵܘܣܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܫܵܒ݂ܩܹܬ ܢܵܟ݂ܦܹܢ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܦܲܨܹܝܬ ܠܝܼ ܘܦܲܪܩܸܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡܲܨܠܝܼ ܢܵܬܘܼܟ݂ ܐܸܠܝܼ ܘܗܲܒ݂ܠܔ ܠܝܼ ܦܘܼܪܩܵܢܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܗܘܝܼ ܐܸܠܝܼ ܠܐܝܼܨܵܪܵܐ ܕܡܲܥܡܪܵܐ ܕܥܵܒ݂ܪܹܢ ܓܵܘܹܗ ܒܟܠܔ ܥܕܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܩܝܼܕ ܠܘܼܟ݂ ܠܦܲܪܘܼܩܹܐ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܩܵܝܝܼ ܘܚܸܣܢܝܼ ܐܲܢ݇ܬ ܝܼܘܸܬ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܦܲܨܝܼ ܠܝܼ ܡ̣ܢ ܐܝܼܕܵܐ ܕܪܲܫܝܼܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܟ̰ܲܢܓܘܼܪܬܵ‌ܐ ܕܥܵܘܵܠܵܐ ܘܛܵܠܘܿܡܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܲܢ݇ܬ ܝܼܘܸܬ ܣܲܒ݂ܪܝܼ، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܬܘܼܟ݂ܠܵܢܝܼ ܡ̣ܢ ܙܥܘܿܪܘܼܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܥܲܠܘܼܟ݂ ܣܢܝܼܕ ܠܝܼ ܡ̣ܢ ܒܲܛܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܝܼܘܸܬ ܦܲܠܛܵܢܝܼ ܡ̣ܢ ܡܲܪܒܥܵܐ ܕܝܸܡܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܸܠܘܼܟ݂ ܝܼܠܵܗ̇ ܬܸܫܒܘܿܚܬ‌ܝܼ ܐܲܡܝܼܢܵܐܝܼܬ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܕܘܼܡܵܪܵܐ ܗܘܹܐ ܠܝܼ ܠܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ ܒܹܝܬ ܓܵܘܣܝܼ ܥܲܫܝܼܢܵܐ ܝܘܸܬ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܸܠܝܵܐ ܝܠܹܗ ܦܘܼܡܝܼ ܬܸܫܒܘܿܚܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܹܗ ܝܵܘܡܵܐ ܚܸܩܪܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܪܲܦܹܝܬ ܠܝܼ ܒܙܲܒ݂ܢܵܐ ܕܣܲܝܒܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܟܲܕ ܬܵܐܹܡ ܚܲܝܠܝܼ ܠܵܐ ܫܵܒ݂ܩܹܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܗܘܼܡܙܸܡ ܠܗܘܿܢ ܕܸܫ̃ܡܸܢܝܼ̈ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܢܵܛܪ̈ܵܢܹܐ ܠܓܵܢܝܼ ܥܒ݂ܝܼܕ ܠܗܘܿܢ ܡܸܠܟܵܐ ܥܲܡ ܚܕܵܕܹ̈ܐ،","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܹܐܡܵܪܵܐ: ”ܐܲܠܵܗܵܐ ܩܵܡ ܫܵܒܹܩ ܠܹܗ؛","poem":1},{"lineBreak":true},{"text":"ܢܦܘܿܠܘܼܢ ܒܵܬܪܹܗ ܘܕܒ݂ܘܿܩܘܼܢ ܠܹܗ، ܒܗ̇ܝ ܕܠܲܝܬ ܠܹܗ ܦܲܨܝܵܢܵܐ.“","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܠܵܐ ܪܵܚܩܹܬ ܡܸܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܡܲܠܝܸܙ ܠܗܲܝܲܪܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܘܬܵܝܡܝܼ ܥܵܒ݂ܕܵܢܹ̈ܐ ܕܕܲܠܩܘܼܒ݂ܠܘܼܬܵ‌ܐ ܠܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܵܒ݂ܫܝܼ ܠܵܘܡܵܐ ܘܢܟ݂ܝܼܦܬܵ‌ܐ ܛܵܥܝܵܢܹ̈ܐ ܠܒܝܼܫܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܘܐܵܢܵܐ ܐܲܡܝܼܢܵܐܝܼܬ ܒܸܬ ܣܵܦܪܹܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܝܵܗܒܹܢܘܼܟ݂ ܬܸܫܒܘܿܚܬܵ‌ܐ ܥܲܠܔ ܬܸܫܒܘܿܚܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܦܘܼܡܝܼ ܒܸܬ ܗܲܩܹܐ ܙܲܕܝܼܩܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܠܹܗ ܝܵܘܡܵܐ ܦܘܼܪܩܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܠܵܐ ܝܕܝܼܥ ܠܝܼ ܡܸܢܝܵܢܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܐܵܬܹܝܢ ܒܓܲܒܵܪ̈ܘܼܝܵܬܹ‌ܐ ܕܡܵܪܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܕܟܸܪܸܢ ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܕܕܝܼܘܼܟ݂ ܐܲܚܟ̰ܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܩܵܡ ܡܲܠܦܸܬ ܠܝܼ ܡ̣ܢ ܙܥܘܿܪܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܗܲܠܔ ܠܲܐܟ݂ܵܐ ܡܘܼܕܸܥ ܠܝܼ ܕܘܼܡܵܪ̈ܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܘܐܘܼܦ ܗܲܠܔ ܚܘܵܪܕܸܩܢܘܼܬܵ‌ܐ ܘܣܲܝܒܘܼܬܵ‌ܐ، ܝܵܐ ܐܲܠܵܗܵܐ، ܠܵܐ ܪܲܦܹܝܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܕܡܲܕܥܸܢ ܚܲܝܠܘܼܟ݂ ܠܕܵܪܵܐ ܐܚܹܪܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܓܲܒܵܪܘܼܬܘܼܟ݂ ܠܟܠܔ ܕܐܵܬܹ‌ܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ، ܗܲܠܔ ܡܪܵܘܡܵܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܕܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܦܘܼܠܚܵܢܹ̈ܐ ܓܘܼܪܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܡܵܢܝܼ ܝܠܹܗ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂؟","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܕܩܵܡ ܡܲܚܙܹܝܬ ܠܝܼ ܪܵܒܵܐ ܥܵܘܩܵܢܹ̈ܐ ܣܸܪ̈ܝܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܕܵܝܪܹܬ ܡܲܚܹܝܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܥܘܼܡܩܹ̈ܐ ܕܐܲܪܥܵܐ ܒܸܬ ܕܵܝܪܹܬ ܡܲܐܣܩܸܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܡܲܙܝܸܕܸܬ ܓܘܼܪܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܕܵܝܪܹܬ ܝܵܗܒܹܬ ܠܝܼ ܠܸܒܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܐܵܢܵܐ ܒܸܬ ܫܲܟܪܸܢܘܼܟ݂ ܒܩܝܼܬܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܵܐ ܫܲܪܝܼܪܘܼܬܘܼܟ݂، ܝܵܐ ܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܙܵܡܪܹܢ ܐܸܠܘܼܟ݂ ܒܟܸܢܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܩܲܕܝܼܫܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܒܚܝܼ ܣܸܦܘܵܬ‌ܝܼ̈ ܟܲܕ ܙܵܡܪܹܢ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܓܵܢܝܼ ܕܦܘܼܪܩܵܐ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܠܸܫܵܢܝܼ ܟܠܹܗ ܝܵܘܡܵܐ ܒܸܬ ܗܲܡܙܸܡ ܙܲܕܝܼܩܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܢܟ݂ܝܼܦ ܠܗܘܿܢ ܕܦܝܼܫ ܠܗܘܿܢ ܡܘܼܟܸܦܹܐ ܛܵܥܝܵܢܹ̈ܐ ܠܒܝܼܫܬ‌ܝܼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}