xt":"ܘܒܸܬ ܨܲܠܝܼ ܒܘܼܬ ܕܝܼܹܗ ܐܲܡܝܼܢܵܐܝܼܬ،","poem":1},{"lineBreak":true},{"text":"ܟܠܹܗ ܝܵܘܡܵܐ ܒܸܬ ܒܲܪܟ݂ܝܼ ܠܹܗ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܗܵܘܝܵܐ ܦܸܪܝܘܼܬܵ‌ܐ ܕܕܲܚܠܵܐ ܒܐܲܪܥܵܐ ܒܪܹܝܫܵܐ ܕܛܘܼܪ̈ܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܫܵܥܫܵܐ ܐܲܝܟ݂ ܠܸܒ݂ܢܵܢ ܛܥܘܼܢܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܦܵܩܚܝܼ ܐܢܵܫܹ̈ܐ ܡ̣ܢ ܡܕܝܼܢ݇ܬܵ‌ܐ ܐܲܝܟ݂ ܓܸܠܵܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܗܵܘܹܐ ܫܸܡܹܗ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܦܵܐܹܫ ܫܸܡܹܗ ܟܡܵܐ ܕܐܝܼܬ ܫܸܡܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܦܵܝܫܝܼ ܒܘܼܪܟܹܐ ܒܝܼܹܗ ܟܠܵܝܗ‌ܝ ܐܸܡܘܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܝܵܗܒ݂ܝܼ ܠܹܗ ܛܘܼܒ݂ܵܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ، ܥܵܒ݂ܕܵܢܹ̈ܐ ܕܥܲܓ̰ܝܼܒܘܼܝܵܬܹ̈‌ܐ ܒܢܲܦ̮ܫܹܗ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܘܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܫܸܡܹܗ ܡܝܘܼܩܪܵܐ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܘܦܵܝܫܵܐ ܡܠܝܼܬܵ‌ܐ ܟܠܵܗ̇ ܐܲܪܥܵܐ ܐܝܼܩܵܪܹܗ،","poem":1},{"lineBreak":true},{"text":"ܐܵܡܹܝܢ ܘܐܵܡܹܝܢ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܬܝܼܡ ܠܗܘܿܢ ܨܠܵܘܵܬܹ̈‌ܐ ܕܕܵܘܝܼܕ ܒܪܘܿܢܵܐ ܕܐܝܼܫܲܝ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}