e":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܘܐܝܼܡܲܢ ܕܬܘܼܚܡܸܢܝܼ ܕܦܲܪܡܹܝܢ ܐܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܙܹܐ ܠܝܼ ܕܥܲܡܠܵܐ ܝܗܘܵܐ ܒܥܲܝܢܝܼ̈،","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܗܲܠܔ ܕܥܒ݂ܝܼܪܝܼ ܠܡܲܩܕܫܵܐ ܕܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܘܼܪܡܹܐ ܠܝܼ ܠܚܲܪܬܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܬܪܘܼܨܵܐ، ܟܹܐ ܡܲܬܒܸܬ ܠܗܘܿܢ ܒܕܘܼܟܵܢܹ̈ܐ ܡܲܓ̰ܪܸ̈ܛܵܢܹܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܡܲܢܦܸܠܸܬ ܠܗܘܿܢ ܠܚܵܪ̈ܵܒܹܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܕܐܲܝܟ݂ ܐܬܹ‌ܐ ܠܗܘܿܢ ܠܚܪܵܒ݂ܵܐ ܒܛܲܪܦܲܛܬܵ‌ܐ ܕܥܲܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܛܝܼܥ ܠܗܘܿܢ ܘܬܝܼܡ ܠܗܘܿܢ ܒܓܘܼܢܚܹ̈ܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܚܸܠܡܵܐ ܝܢܵܐ ܡܒܵܬܪ ܪܥܵܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܒܬܥܵܪܬܘܼܟ݂ ܨܲܠܡܵܝܗ‌ܝ ܒܸܬ ܡܲܣܠܹܝܬ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܦܝܼܫ ܠܹܗ ܡܘܼܡܪܸܪܵܐ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܘܝܼ ܦܝܼܫ ܠܹܗ ܟ̰ܪܝܼܙܵܐ،","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܵܢܵܐ ܐܲܗܡܲܩ ܝܼܘܸܢ ܗܘܵܐ، ܘܠܵܐ ܝܕܝܼܥ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܝܘܵܢ ܗܘܹܐ ܠܝܼ ܟܸܣ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܘܗܸܫ ܐܵܢܵܐ ܐܲܡܝܼܢܵܐܝܼܬ ܥܲܡܘܼܟ݂ ܝܼܘܸܢ،","poem":1},{"lineBreak":true},{"text":"ܕܒ݂ܝܼܩ ܠܘܼܟ݂ ܒܐܝܼܕܝܼ ܕܝܲܡܝܼܢܵܐ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ܒܡܸܠܟܘܼܟ݂ ܒܸܬ ܬܲܓܒܸܪܸܬ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܵܬܪ ܗܵܕܵܐ ܒܐܝܼܩܵܪܵܐ ܩܲܒܠܸܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܐܝܼܬ ܠܝܼ ܒܫܡܲܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܘܫܒ݂ܘܿܩ ܡܸܢܘܼܟ݂ ܠܹܐ ܒܵܣܡܵܐ ܠܝܼ ܒܡܸܢܕܝܼ ܒܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ܬܝܼܡ ܠܹܗ ܒܸܣܪܝܼ ܘܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܨܵܪܵܐ ܕܠܸܒܝܼ ܘܣܵܗܡܝܼ ܐܲܠܵܗܵܐ ܝܠܹܗ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗܵܐ، ܐܵܢܝܼ ܕܝܼܢܵܐ ܪܸܚܩܵܐ ܡܸܢܘܼܟ݂ ܒܸܬ ܛܵܠܩܝܼ،","poem":1},{"lineBreak":true},{"text":"ܦܘܼܢܹܐ ܠܘܼܟ݂ ܟܠܔ ܙܲܢܵܝܵܐ ܡ̣ܢ ܟܸܣ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ܘܐܵܢܵܐ، ܩܲܪܒܲܢܬܵ‌ܐ ܠܐܲܠܵܗܵܐ ܩܵܬ‌ܝܼ ܨܦܵܝܝܼ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܬܸܒ݂ ܠܝܼ ܒܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܒܹܝܬ ܓܵܘܣܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܗܲܩܘܼܝܹܐ ܟܠܵܝܗ‌ܝ ܦܘܼܠܚܵܢܘܼ̈ܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}