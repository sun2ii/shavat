{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"verse","number":1,"content":[{"text":"ܩܵܡܘܿܕܝܼ، ܝܵܐ ܐܲܠܵܗܵܐ، ܩܵܡ ܡܲܚܦܸܠܸܬ ܠܲܢ ܠܥܵܠܲܡ؟","poem":1},{"lineBreak":true},{"text":"ܬܲܢܬܘܼܢܹܐ ܝܠܵܗ̇ ܚܸܡܬܘܼܟ݂ ܥܲܠܔ ܦܸܣܩܵܐ ܕܡܲܪܥܝܼܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ ܠܟܢܘܼܫܝܘܼܟ݂ ܕܙܒ݂ܝܼܢܘܼܟ݂ ܡ̣ܢ ܙܲܒ݂ܢܵܐ ܩܲܕܝܼܡܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܲܒ݂ܛܵܐ ܕܝܵܪܬܘܼܬܘܼܟ݂ ܕܦܘܼܪܸܩ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܐܵܗܵܐ ܛܘܼܪܵܐ ܕܨܸܗܝܘܿܢ ܕܫܪܹܐ ܠܘܼܟ݂ ܒܝܼܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܡܲܦܬܸܠܔ ܦܵܣܘܿܥܝܵܬܘܼ̈ܟ݂ ܠܓܹܒܵܐ ܕܚܵܪ̈ܵܒܹܐ ܕܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܟܠܔ ܒܝܼܫܬܵ‌ܐ ܥܒ݂ܝܼܕ ܠܹܗ ܕܸܫ̃ܡܸܢ ܒܡܲܩܕܫܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܓܘܼܪܓܸܡ ܠܗܘܿܢ ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂ ܒܓܵܘܵܐ ܕܓ̰ܵܡܵܥܲܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܩܸܡ ܠܗܘܿܢ ܐܵܬܘܵܬܵܝ̈ܗ‌ܝ ܐܲܝܟ݂ ܢܝܼܫܲܢܩܹ̈ܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܗܘܝܼܹܐ ܝܗܘܵܘ ܐܲܝܟ݂ ܡܵܚܝܵܢܵܐ ܕܢܲܪ̈ܥܹܐ","poem":1},{"lineBreak":true},{"text":"ܒܐܝܼܠܵܢܹ̈ܐ ܕܥܵܒ݂ܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܘܐܵܕܝܼܵܐ، ܢܩܵܪ̈ܝܵܬܘܼܗ‌ܝ ܟܠܵܝܗ‌ܝ ܡܸܚܕܵܕܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܚܵܨܝܼܢܹ̈ܐ ܘܢܲܪ̈ܥܹܐ ܛܲܚܛܘܼܚܹܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܕܪܹܐ ܠܗܘܿܢ ܒܢܘܼܪܵܐ ܡܲܩܕܫܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܐܲܪܥܵܐ ܫܚܝܼܡ ܠܗܘܿܢ ܡܲܫܟܢܵܐ ܕܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܗܘܿܢ ܒܠܸܒܵܝܗ‌ܝ: ”ܙܵܠܡܲܚ ܠܟܠܵܝܗ‌ܝ.“","poem":1},{"lineBreak":true},{"text":"ܡܘܼܩܸܕ ܠܗܘܿܢ ܟܠܵܝܗ‌ܝ ܟܢܘܼܫܝܵܬܹ̈‌ܐ ܕܐܲܠܵܗܵܐ ܒܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܢܝܼܫܲܢܩܹ̈ܐ ܐܸܠܲܢ ܠܹܐ ܝܘܲܚ ܒܸܚܙܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܲܝܬ ܐܚܹܪܢܵܐ ܢܒ݂ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܲܝܬ ܥܲܡܲܢ ܚܲܕ ܕܝܵܕܹܥ ܗܲܠܔ ܐܝܼܡܲܢ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ، ܒܸܬ ܠܵܐܹܡ ܡܲܠܝܸܨܵܢܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܣܚܸܪ ܕܸܫ̃ܡܸܢ ܒܫܸܡܘܼܟ݂ ܠܥܵܠܲܡ؟","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܡܲܕܘܼܪܹܐ ܝܘܸܬ ܐܝܼܕܘܼܟ݂ ܘܝܲܡܝܼܢܘܼܟ݂؟","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܓܵܘ ܥܘܼܒܘܼܟ݂ ܦܲܠܸܛ ܠܵܗ̇ ܘܛܲܠܸܩ ܠܹܗ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܘܐܲܠܵܗܵܐ ܡܲܠܟܝܼ ܝܠܹܗ ܡ̣ܢ ܙܲܒ݂ܢܵܐ ܩܲܕܝܼܡܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܵܠܚܵܢܹ̈ܐ ܕܦܘܼܪ̈ܩܵܢܹܐ ܒܓܵܘܵܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܒܥܘܼܫܢܘܼܟ݂ ܟ̰ܠܝܼܦܵܐ ܠܘܼܟ݂ ܝܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܬܒ݂ܝܼܪܘܼܟ݂ ܪܹ̈ܝܫܵܢܹܐ ܕܬܲܢܝܼܢܹ̈ܐ ܒܡ̈ܝܼܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܛܒ݂ܝܼܚ ܠܘܼܟ݂ ܪܹ̈ܝܫܵܢܹܐ ܕܠܹܘܝܵܬܵܢ،","poem":1},{"lineBreak":true},{"text":"ܩܵܡ ܝܵܗܒܹܬ ܠܹܗ ܡܹܐܟ݂ܘܼܠܬܵ‌ܐ ܠܥܲܡܵܐ، ܠܥܵܡܪ̈ܵܢܹܐ ܕܒܲܪܝܼܵܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܡܘܼܦܩܸܥ ܠܘܼܟ݂ ܥܲܝܢܵܬܹ̈‌ܐ ܘܢܲܚܠܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܡܘܼܒܪܸܙ ܠܘܼܟ݂ ܢܲܗܪ̈ܵܘܵܬܹ‌ܐ ܙܲܪ̈ܒܵܢܹܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܕܝܼܘܼܟ݂ ܝܠܹܗ ܝܵܘܡܵܐ، ܐܘܼܦ ܕܝܼܘܼܟ݂ ܝܠܹܗ ܠܲܝܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܫܘܼܬܐܸܣ ܠܘܼܟ݂ ܒܲܗܪܵܐ ܘܫܸܡܫܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܡܘܼܬܸܒ݂ ܠܘܼܟ݂ ܟܠܵܝܗ‌ܝ ܬܚܘܼܡܹ̈ܐ ܕܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܲܝܛܵܐ ܘܣܸܬܘܵܐ ܐܲܢ݇ܬ ܥܒ݂ܝܼܕܵܝ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ ܐܵܗܵܐ، ܕܵܐܟ݂ܝܼ ܠܝܼܡ ܠܹܗ ܕܸܫ̃ܡܸܢ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܡܵܐ ܣܲܟ݂ܠܵܐ ܡܘܼܣܚܸܪܹܗ ܒܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܝܵܗܒܹܬ ܓܵܢܵܐ ܕܓܘܼܪܓܘܼܡܘܼܟ݂ ܠܚܲܝܘܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܡܲܢܫܹܝܬ ܚܲܝܹ̈ܐ ܕܡܸܣܟܹܢܘܼ̈ܟ݂ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܚܘܼܪ ܠܘܲܥܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܸܠܝܹܐ ܝܢܵܐ ܕܘܼܟܵܢܹ̈ܐ ܚܸܫܟܵܢܹ̈ܐ ܕܐܲܪܥܵܐ ܒܕܘܼܝܵܪܹ̈ܐ ܕܚܸܡܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܕܵܐܹܪ ܡܘܼܠܝܸܨܵܐ ܟܲܕ ܢܟ݂ܝܼܦܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܸܣܟܹܢܵܐ ܘܣܢܝܼܩܵܐ ܫܲܒܚܝܼ ܠܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ، ܝܵܐ ܐܲܠܵܗܵܐ، ܥܒ݂ܘܿܕ ܕܝܼܘܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ ܠܵܘܡܘܼܟ݂ ܡ̣ܢ ܣܲܟ݂ܠܵܐ ܟܠܹܗ ܝܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܡܲܢܫܹܝܬ ܩܵܠܵܐ ܕܕܸܫ̃ܡܸܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܫܓ݂ܘܼܫܝܵܐ ܕܩܵܝܡܵܢܹ̈ܐ ܕܲܠܩܘܼܒ݂ܠܘܼܟ݂ ܒܹܐܣܵܩܵܐ ܐܲܡܝܼܢܵܐܝܼܬ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}