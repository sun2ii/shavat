{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܥܠܔ ܝܕܘܬܘܢ. ܡܙܡܘܪܐ."]},{"type":"verse","number":1,"content":[{"text":"ܟܹܐ ܕܵܪܹܝܢ ܩܵܠܹ̈ܐ ܠܐܲܠܵܗܵܐ، ܘܒܸܬ ܡܲܩܘܸܚܸܢ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܕܵܪܹܝܢ ܩܵܠܹ̈ܐ ܠܐܲܠܵܗܵܐ، ܘܒܸܬ ܝܵܗܒܹܠܔ ܢܵܬܵ‌ܐ ܐܸܠܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܝܵܘܡܵܐ ܕܥܵܘܩܵܢܝܼ ܠܡܵܪܝܵܐ ܛܥܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܕܝܼ ܒܠܲܝܠܹܐ ܦܝܼܫ ܠܵܗ̇ ܦܘܼܫܸܛܬܵ‌ܐ ܘܠܵܐ ܬܒ݂ܝܼܢܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܚܦܸܠܔ ܠܵܗ̇ ܠܸܫܩܵܠܵܐ ܠܸܒܵܐ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܕܵܟ݂ܪܹܢ ܠܐܲܠܵܗܵܐ ܘܟܹܐ ܢܲܟܢܸܟܸܢ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܗܲܓܹܝܢ ܘܦܝܼܫ ܠܵܗ̇ ܕܘܼܪܕܸܫ̃ܬܵ‌ܐ ܪܘܼܚܝܼ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܫܒ݂ܝܼܩ ܠܘܼܟ݂ ܐܵܟ̰ܡܝܼ ܛܸܠܦܵܦܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܫܓ݂ܝܼܫܵܐ ܗܵܕܵܐ ܕܠܹܐ ܡܵܨܹܝܢ ܗܲܡܙܸܡܸܢ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܬܘܼܚܡܸܢܝܼ ܒܘܼܬ ܝܵܘܡܵܢܹ̈ܐ ܥܲܬܝܼܩܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܸܢܹ̈ܐ ܕܥܵܠܡܝܼܢ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܒܸܕܟ݂ܵܪܵܐ ܝܘܸܢ ܙܡܵܪܬ‌ܝܼ ܒܠܲܝܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܠܸܒܝܼ ܟܹܐ ܗܲܓܹܝܢ ܘܟܹܐ ܨܲܚܨܝܼܵܐ ܪܘܼܚܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܒܸܬ ܪܲܦܹܐ ܠܝܼ ܡܵܪܝܵܐ ܠܥܵܠܡܝܼܢ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܡܲܙܝܸܕ ܗܸܢܝܵܢܹܗ ܡܸܢܕܪܸܫ؟","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܫܠܹܐ ܠܵܗ̇ ܠܥܵܠܲܡ ܛܲܝܒܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܬܝܼܡ ܠܹܗ ܩܵܘܠܹܗ ܠܕܵܪܵܐ ܘܕܵܪܵܐ؟","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܡܘܼܢܫܹܐ ܠܹܗ ܠܸܥܒ݂ܵܕܵܐ ܪ̈ܲܚܡܹܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܒܚܸܡܬܵ‌ܐ ܚܣܝܼܟ݂ܵܝ ܠܹܗ ܪ̈ܲܚܡܘܼܗ‌ܝ؟ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܘܐܡܝܼܪܝܼ: ”ܒܸܒܙܵܥܵܐ ܝܠܹܗ ܠܸܒܝܼ","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܫܲܚܠܲܦܬܵ‌ܐ ܕܝܲܡܝܼܢܵܐ ܕܥܸܠܵܝܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܡܲܕܟܸܪܸܢ ܥܒ݂ܵܕܹ̈ܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܹܐ، ܒܸܬ ܕܵܟ݂ܪܹܢ ܕܘܼܡܵܪ̈ܘܼܟ݂ ܡ̣ܢ ܙܲܒ݂ܢܵܐ ܩܲܕܝܼܡܵܝܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"”ܘܒܸܬ ܗܲܓܹܝܢ ܟܠܹܗ ܦܘܼܠܚܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܘܼܬ ܥܒ݂ܵܕܘܼ̈ܟ݂ ܒܸܬ ܬܲܚܡܸܢܸܢ.“","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܒܩܲܕܝܼܫܘܼܬܵ‌ܐ ܝܠܵܗ̇ ܐܘܼܪܚܘܼܟ݂؛","poem":1},{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܠܹܗ ܐܲܠܵܗܵܐ ܓܘܼܪܵܐ ܐܲܝܟ݂ ܐܲܠܵܗܲܢ؟","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܝܼܘܸܬ ܐܲܠܵܗܵܐ ܥܵܒ݂ܕܵܢܹ̈ܐ ܕܕܘܼܡܵܪܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܕܸܥ ܠܘܼܟ݂ ܓܵܘ ܥܲܡܡܹ̈ܐ ܚܲܝܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܦܘܼܪܸܩ ܠܘܼܟ݂ ܒܕܪܲܥܢܘܼܟ݂ ܠܥܲܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܢܲܝ̈ ܝܲܥܩܘܿܒ݂ ܘܝܵܘܣܸܦ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܚܙܹܐ ܠܗܘܿܢ ܐܸܠܘܼܟ݂ ܡ̈ܝܼܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܙܹܐ ܠܗܘܿܢ ܐܸܠܘܼܟ݂ ܡ̈ܝܼܵܐ ܘܪܘܼܬܪܸܬ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܪܓܝܼܕ ܠܗܘܿܢ ܬܗܘܿܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܥܢܵܢܹ̈ܐ ܫܘܼܦܸܟ݂ ܠܗܘܿܢ ܡ̈ܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܩܘܼܪܩܸܡ ܠܗܘܿܢ ܫܡܲܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܓܹܐܪ̈ܘܼܟ݂ ܣܛܹܐ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܩܵܠܵܐ ܕܩܲܪ̈ܩܲܡܝܵܬܘܼܟ݂ ܒܓܵܪܕܵܒܘܼܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܗܪܸܢܗܘܿܢ ܒܸܪ̈ܩܹܐ ܠܒܪܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܪܓܝܼܕ ܠܵܗ̇ ܘܕܘܼܪܘܸܕ ܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܒܝܵܡܵܐ ܝܼܗܘܵܐ ܐܘܼܪܚܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܫܒ݂ܝܼܠܘܼܟ݂ ܝܼܗܘܵܐ ܒܡ̈ܝܼܵܐ ܪܵܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܫܵܘܦܵܦܹ̈ܐ ܕܐܲܩܠܘܼ̈ܟ݂ ܠܵܐ ܦܝܼܫ ܠܗܘܿܢ ܚܸܙܝܹܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܡܗܘܼܕܹܐ ܠܘܼܟ݂ ܐܲܝܟ݂ ܥܸܪ̈ܒܹܐ ܠܥܲܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܐܝܼܕܵܐ ܕܡܘܼܫܹܐ ܘܕܐܲܗܪܘܿܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}