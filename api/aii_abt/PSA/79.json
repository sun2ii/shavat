{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ ܕܐܣܦ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܥܒ݂ܝܼܪܗܘܿܢ ܐܸܡܘܵܬܹ̈‌ܐ ܠܓܵܘ ܝܵܪܬܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟ̰ܘܼܦܠܸܢܗܘܿܢ ܠܗܲܝܟܠܵܐ ܕܩܘܼܕܫܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܚܕܸܪܵܐ ܠܗܘܿܢ ܐܘܿܪܸܫܠܸܡ ܠܚܵܪ̈ܵܒܹܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܝܘܼܗܒܹܠܔ ܠܗܘܿܢ ܫܠܲܕܵܐ ܕܪܹ̈ܓܵܘܵܬܘܼܟ݂ ܡܹܐܟ݂ܘܼܠܬܵ‌ܐ ܠܦܵܪܲܚܬܵ‌ܐ ܕܫܡܲܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܣܪܵܐ ܕܙܲܕܝܼܩܘܼ̈ܟ݂ ܠܚܲܝܘܬܵ‌ܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܫܘܼܦܸܟ݂ ܠܗܘܿܢ ܕܸܡܵܝܗ‌ܝ ܐܲܝܟ݂ ܡ̈ܝܼܵܐ ܠܚܵܕܸܪ̈ܘܵܢܹܐ ܕܐܘܿܪܸܫܠܸܡ،","poem":1},{"lineBreak":true},{"text":"ܘܠܲܝܬ ܗܘܵܐ ܩܵܒ݂ܪܵܢܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܗܘܹܐ ܠܲܢ ܠܵܘܡܵܐ ܠܫܒ݂ܵܒܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܡܲܣܠܲܝܬܵ‌ܐ ܘܡܲܣܚܲܪܬܵ‌ܐ ܠܐܵܢܝܼ ܕܝܼܢܵܐ ܠܚܵܕܸܪ̈ܘܵܢܲܢ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ، ܝܵܐ ܡܵܪܝܵܐ؟ ܒܸܬ ܟܵܪܒܹܬ ܠܥܵܠܲܡ؟","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܝܵܩܹܕ ܐܲܝܟ݂ ܢܘܼܪܵܐ ܛܢܵܢܘܼܟ݂؟","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܫܲܦܸܟ݂ ܚܸܡܬܘܼܟ݂ ܥܲܠܔ ܐܸܡܘܵܬܹ̈‌ܐ ܕܠܹܐ ܝܵܕܥܝܼ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܠܔ ܡܲܠܟܘܵܬܹ̈‌ܐ ܕܒܫܸܡܘܼܟ݂ ܠܹܐ ܩܵܪܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܦܘܼܪܦܸܛ ܠܗܘܿܢ ܠܝܲܥܩܘܿܒ݂،","poem":1},{"lineBreak":true},{"text":"ܘܠܕܘܼܝܵܪܹܗ ܡܘܼܚܪܸܒ݂ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܠܵܐ ܕܵܟ݂ܪܹܬ ܥܲܠܲܢ ܥܵܘ̈ܠܹܐ ܩܲܕܝܼܡܵܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܠܝܸܙ ܠܡܲܬܦܘܼܩܹܐ ܒܝܼܲܢ ܪ̈ܲܚܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܦܝܼܫ ܠܲܢ ܡܘܼܟܸܦܹܐ ܪܵܒܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗܲܝܸܪܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܲܢ، ܒܘܼܬ ܚܸܩܪܵܐ ܕܫܸܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܦܲܨܝܼ ܠܲܢ ܘܥܒ݂ܘܿܕ ܚܘܼܣܵܝܵܐ ܥܲܠܔ ܚܛܝܼܵܬܲܢ̈ ܡ̣ܢ ܥܸܠܬܵ‌ܐ ܕܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܐܵܡܪܝܼ ܐܸܡܘܵܬܹ̈‌ܐ: ”ܐܲܝܟܵܐ ܝܠܹܗ ܐܲܠܵܗܵܝܗ‌ܝ؟“","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܩܲܕܡ ܥܲܝܢܲܢ̈ ܦܵܐܹܫ ܝܕܝܼܥܵܐ ܓܵܘ ܐܸܡܘܵܬܹ̈‌ܐ","poem":1},{"lineBreak":true},{"text":"ܕܐܲܢ݇ܬ ܟܹܐ ܫܵܩܠܹܬ ܬܘܼܥܠܵܐ ܕܕܸܡܵܐ ܕܪܹ̈ܓܵܘܵܬܘܼܟ݂ ܕܦܝܼܫ ܠܹܗ ܫܘܼܦܟ݂ܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܐܵܬܝܵܐ ܩܲܕܡܘܼܟ݂ ܬܲܢܲܚܬܵ‌ܐ ܕܐܲܣܝܼܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܪܲܒܘܼܬܵ‌ܐ ܕܕܪܲܥܢܘܼܟ݂ ܫܪܝܼ ܠܒܢܲܝ̈ ܡܵܘܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܘܡܲܕܸܪ ܠܥܘܼܒܵܐ ܕܫܒ݂ܵܒܲܢ̈ ܚܲܕ ܒܫܲܒ݂ܥܵܐ","poem":1},{"lineBreak":true},{"text":"ܠܵܘܡܵܝܗ‌ܝ، ܗ̇ܘ ܕܩܵܡ ܠܵܝܡܝܼ ܠܘܼܟ݂ ܒܝܼܹܗ، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܘܐܲܚܢܲܢ ܐܢܵܫܘܼ̈ܟ݂ ܘܦܸܣܩܵܐ ܕܡܲܪܥܝܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܲܚ ܠܘܼܟ݂ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܠܕܵܪܵܐ ܘܕܵܪܵܐ ܒܸܬ ܗܲܩܲܚ ܬܸܫܒܘܿܚܬܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}