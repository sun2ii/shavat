{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ: ܥܠܔ ܓܬܝܼܬ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܡܵܪܝܵܐ، ܡܵܪܲܢ،","poem":1},{"lineBreak":true},{"text":"ܟܡܵܐ ܡܫܘܼܒܚܵܐ ܝܠܹܗ ܫܸܡܘܼܟ݂ ܒܟܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܡܘܼܫܪܹܐ ܠܘܼܟ݂ ܚܸܩܪܘܼܟ݂ ܥܲܠܔ ܫܡܲܝܹ̈ܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܦܘܼܡܵܐ ܕܝܵܠܹ̈ܕ݇ܐ ܘܝܲܠܘܼܕܹ̈ܐ ܫܘܼܬܐܸܣ ܠܘܼܟ݂ ܚܲܝܠܵܐ، ܒܥܸܠܬܵ‌ܐ ܕܕܲܠܩܘܼܒ݂ܠܵܝܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܡܲܫܠܘܼܝܹܐ ܕܸܫ̃ܡܸܢ ܘܫܵܩܠܵܢܵܐ ܕܬܘܼܥܠܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܓܲܫܩܸܢ ܠܫܡܲܝܘܼ̈ܟ݂، ܦܘܼܠܚܵܢܵܐ ܕܨܸܒܥܵܬܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܲܗܪܵܐ ܘܟܵܘܟ݂ܒܹ̈ܐ ܕܡܘܼܬܒ݂ܵܝ ܠܘܼܟ݂ ܒܕܘܼܟܵܝܗ‌ܝ،","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܡܘܼܕܝܼ ܝܠܹܗ ܐܢܵܫܵܐ ܕܕܵܟ݂ܪܹܬ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܪܢܵܫܵܐ ܕܣܲܚܒܸܪܸܬ ܠܹܗ؟","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܘܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܐܸܠܹܗ ܚܲܕܟ̰ܵܐ ܒܘܼܫ ܒܵܨܘܿܪܵܐ ܡ̣ܢ ܡܲܠܲܐܟܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܸܩܪܵܐ ܘܐܝܼܩܵܪܵܐ ܒܘܼܢܦܸܪܘܼܟ݂ ܐܸܠܹܗ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܝܘܼܗܒܹܠܔ ܠܘܼܟ݂ ܫܘܼܠܛܵܢܵܐ ܐܸܠܹܗ ܥܲܠܔ ܦܘܼܠܚܵܢܹ̈ܐ ܕܐܝܼܕܵܬܘܼ̈ܟ݂؛","poem":1},{"lineBreak":true},{"text":"ܟܠܔ ܡܸܢܕܝܼ ܡܘܼܬܸܒ݂ ܠܘܼܟ݂ ܬܚܘܿܬ ܐܲܩܠܵܬܘܼ̈ܗ‌ܝ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܥܸܪ̈ܒܹܐ ܘܬܵܘܪܹ̈ܐ ܟܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܐܘܼܦ ܚܲܝܘܵܬܹ̈‌ܐ ܕܕܸܫܬܵ‌ܐ؛","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܛܲܝܪܹ̈ܐ ܕܫܡܲܝܵܐ ܘܢܘܼܢܹ̈ܐ ܕܝܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܠܔ ܓ̰ܵܘܓ̰ܵܢܵܐ ܒܪܵܗܛܵܐ ܕܡ̈ܝܼܵܐ ܓܵܘ ܝܵܡܵܬܹ̈‌ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ، ܡܵܪܲܢ، ܟܡܵܐ ܡܫܘܼܒܚܵܐ ܝܠܹܗ ܫܸܡܘܼܟ݂ ܒܟܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}