{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܥܠܔ ܫܘܼܫܲܢܝܼܡ ܥܹܕܘܿܬ. ܡܙܡܘܪܐ ܕܐܣܦ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܪܵܥܝܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ، ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܕܲܒܪܵܢܵܐ ܕܝܵܘܣܸܦ ܐܲܝܟ݂ ܦܸܣܩܵܐ.","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܝܵܬܒ݂ܵܢܵܐ ܒܹܝܠܔ ܟܪ̈ܘܿܒܹܐ، ܙܪܘܿܩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܩܲܕܡ ܐܲܦܪܹܝܡ، ܘܒܸܢܝܵܡܹܝܢ، ܘܡܢܲܫܹܐ، ܡܲܪܥܸܫ ܠܓܲܒܵܪܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܬܵ‌ܐ ܠܦܘܼܪܩܵܢܲܢ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܡܲܕܸܪܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܗܪܸܢ ܦܵܬܘܼܟ݂ ܕܦܵܝܫܲܚ ܦܘܼܪܩܹܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ ܒܸܬ ܟܵܪܒܹܬ ܥܲܠܔ ܨܠܘܿܬܵ‌ܐ ܕܥܲܡܘܼܟ݂؟","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܡܘܼܐܟ݂ܠܵܝ ܠܘܼܟ݂ ܠܲܚܡܵܐ ܕܕܸܡܥܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܘܼܫܬܝܼܵܝ ܠܘܼܟ݂ ܕܸܡ̈ܥܹܐ ܒܟܝܘܼܠܵܐ ܓܘܼܪܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕܲܚ ܠܘܼܟ݂ ܡܲܩܲܪܵܨܘܼܬܵ‌ܐ ܠܫܒ݂ܵܒܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܘܒܹܝܠܵܝܗ‌ܝ ܡܘܼܣܚܸܪܗܘܿܢ ܕܸܫ̃ܡܸܢܲܢ̈ ܒܝܼܲܢ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ، ܡܲܕܸܪܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܲܗܪܸܢ ܦܵܬܘܼܟ݂ ܕܦܵܝܫܲܚ ܦܘܼܪܩܹܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܓܸܦܬܵ‌ܐ ܡ̣ܢ ܡܸܨܪܹܝܢ ܦܘܼܠܛܵܐ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܛܪܝܼܕ ܠܘܼܟ݂ ܠܐܸܡܘܵܬܹ̈‌ܐ ܘܢܨܝܼܒ݂ܵܐ ܠܘܼܟ݂ ܒܫܵܘܦܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܗܘܼܕܸܪܘܼܟ݂ ܥܲܦܪܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܕܒ݂ܝܼܩ ܠܵܗ̇ ܥܸܩܪܘܼܗ̇، ܘܡܠܹܐ ܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܦܝܼܫ ܠܗܘܿܢ ܡܘܼܟܣܹܐ ܛܘܼܪ̈ܵܢܹܐ ܡ̣ܢ ܛܸܠܵܢܝܼܬܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܪ̈ܙܹܐ ܓܘܼܪܹ̈ܐ ܡ̣ܢ ܦܲܥܘܵܢܘܼ̈ܗ̇.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܦܘܼܫܸܛ ܠܵܗ̇ ܦܲܥܘܵܢܘܼ̈ܗ̇ ܗܲܠܔ ܝܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܪܝܼܣ ܠܵܗ̇ ܠܢܲܗܪܵܐ ܨܸܒܥܵܬܘܼ̈ܗ̇.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܬܪܝܼܥ ܠܘܼܟ݂ ܣܝܵܓ݂ܘܼܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܢܟ̰ܝܼܠܔ ܠܗܘܿܢ ܡܸܢܘܼܗ̇ ܟܠܵܝܗ‌ܝ ܥܵܒ݂ܪ̈ܵܢܹܐ ܕܐܘܼܪܚܵܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܟ݂ܵܠܵܐ ܒܹܐܟ݂ܵܠܘܼܗ̇ ܝܠܹܗ ܚܙܘܼܪܵܐ ܡ̣ܢ ܥܵܒ݂ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܓ̰ܵܘܓ̰ܵܢܹ̈ܐ ܕܕܸܫܬܵ‌ܐ ܒܸܪܥܵܝܘܼܗ̇ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ، ܕܘܼܪ ܐܵܕܝܼܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܘܼܪ ܡ̣ܢ ܫܡܲܝܵܐ ܘܚܙܝܼ، ܘܣܲܚܒܸܪ ܠܐܵܗܵܐ ܓܸܦܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܠܥܸܩܪܵܐ ܕܢܨܝܼܒ݂ ܠܵܗ̇ ܝܲܡܝܼܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܒܪܘܿܢܵܐ ܕܚܘܼܠܸܢܘܼܟ݂ ܩܵܐ ܓܵܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܡܘܼܩܸܕܬܵ‌ܐ ܝܠܵܗ̇ ܒܢܘܼܪܵܐ، ܦܪܝܼܡܬܵ‌ܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܢܓ̰ܵܘܬܵ‌ܐ ܕܦܵܬܘܼܟ݂ ܟܹܐ ܛܵܠܩܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܗܵܘܝܵܐ ܐܝܼܕܘܼܟ݂ ܠܐܢܵܫܵܐ ܕܡ̣ܢ ܝܲܡܝܼܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܒܪܘܿܢܵܐ ܕܐܢܵܫܵܐ ܕܚܘܼܠܸܢܘܼܟ݂ ܩܵܐ ܓܵܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܕܠܵܐ ܩܵܠܒܲܚ ܡܸܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܡܲܚܹܝܬ ܠܲܢ، ܘܒܫܸܡܘܼܟ݂ ܒܸܬ ܩܵܪܲܚ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ، ܡܲܕܸܪܲܢ،","poem":1},{"lineBreak":true},{"text":"ܒܲܗܪܸܢ ܦܵܬܘܼܟ݂ ܕܦܵܝܫܲܚ ܦܘܼܪܩܹܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}