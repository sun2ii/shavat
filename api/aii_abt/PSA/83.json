{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["ܙܡܪܬ‌ܐ. ܡܙܡܘܪܐ ܕܐܣܦ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܠܵܐ ܗܵܘܝܵܐ ܫܠܵܝܬܵ‌ܐ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܵܐ ܫܵܬܩܹܬ ܘܠܵܐ ܗܵܘܹܝܬ ܫܸܠܝܵܐ، ܝܵܐ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗܵܐ، ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂ ܒܸܥܒ݂ܵܕܵܐ ܝܢܵܐ ܫܓ݂ܘܼܫܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܢܝܵܢܘܼ̈ܟ݂ ܡܘܼܪܸܡ ܠܗܘܿܢ ܪܹܝܫܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܥܲܠܔ ܥܲܡܘܼܟ݂ ܥܒ݂ܝܼܕ ܠܗܘܿܢ ܒܘܼܨܵܐ ܨܢܝܼܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܒ݂ܝܼܕ ܠܗܘܿܢ ܡܸܠܟܵܐ ܥܲܠܔ ܣܝܼܡܵܬܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܗܘܿܢ: ”ܬܹܝܡܘܼܢ ܘܛܲܠܩܲܚ ܠܗܘܿܢ ܡ̣ܢ ܐܘܼܡܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܦܵܐܹܫ ܕܟ݂ܝܼܪܵܐ ܫܸܡܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ ܡܸܢܕܪܸܫ.“","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܥܒ݂ܝܼܕ ܠܗܘܿܢ ܡܸܠܟܵܐ ܒܠܸܒܵܐ ܥܲܡ ܚܕܵܕܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܩܛܝܼܥ ܠܗܘܿܢ ܩܵܘܠܵܐ ܥܲܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡܲܫܟܢܹ̈ܐ ܕܐܲܕܘܿܡ ܘܕܐܝܼܫܡܲܥܠܵܝܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܐܵܒ݂ ܘܗܵܓ݂ܵܪ̈ܵܝܹܐ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܓܒܲܠܔ ܘܥܲܡܘܿܢ ܘܥܡܵܠܹܝܩ،","poem":1},{"lineBreak":true},{"text":"ܦܠܸܫܬ ܥܲܡ ܥܵܡܪ̈ܵܢܹܐ ܕܨܘܿܪ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܐܵܬܘܿܪ ܙܘܼܘܸܓ ܠܹܗ ܥܲܡܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܗܘܿܢ ܕܪܲܥܢܵܐ ܠܒܢܘܿܢܹ̈ܐ ܕܠܘܿܛ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܐܸܠܵܝܗ‌ܝ ܐܲܝܟ݂ ܠܡܸܕܝܲܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܠܣܝܼܣܪܵܐ ܘܝܵܒ݂ܝܼܢ ܒܢܲܗܪܵܐ ܕܩܝܼܫܘܿܢ،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܕܦܝܼܫ ܠܗܘܿܢ ܛܘܼܠܩܹܐ ܒܥܝܼܢܕܘܿܪ،","poem":1},{"lineBreak":true},{"text":"ܘܗܘܹܐ ܠܗܘܿܢ ܙܸܒܠܵܐ ܠܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܠܗܘܿܢ ܢܲܨܝܼܚܵܝ̈ܗ‌ܝ ܐܲܝܟ݂ ܥܘܿܪܝܼܒ݂ ܘܐܲܝܟ݂ ܙܝܼܒ݂،","poem":1},{"lineBreak":true},{"text":"ܘܟܠܵܝܗ‌ܝ ܫܲܠܝܼܛܵܝ̈ܗ‌ܝ ܐܲܝܟ݂ ܙܵܒ݂ܵܚ ܘܐܲܝܟ݂ ܨܲܠܡܢܲܥ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܕܐܡܝܼܪܗܘܿܢ: ”ܝܵܪܬܲܚ ܠܗܘܿܢ ܠܓܵܢܲܢ","poem":1},{"lineBreak":true},{"text":"ܡܲܪ̈ܥܝܹܐ ܕܐܲܠܵܗܵܐ.“","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܥܒ݂ܘܿܕ ܠܗܘܿܢ ܐܲܝܟ݂ ܓܵܪܕܵܒܘܼܠܹܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܟܘܼܠܵܫ ܩܲܕܡ ܦܵܘܚܵܐ،","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܢܘܼܪܵܐ ܕܡܲܩܸܕ ܥܵܒ݂ܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܝܟ݂ ܠܵܗܵܐ ܕܡܲܠܗܸܒ݂ ܛܘܼܪ̈ܵܢܹܐ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܢܵܦܠܹܬ ܒܵܬܪܵܝܗ‌ܝ ܒܥܲܠܥܵܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܓܵܪܕܵܒܘܼܠܘܼܟ݂ ܡܲܪܓܸܕܸܬ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܡܠܝܼ ܦܵܬܘܵܬܵܝ̈ܗ‌ܝ ܒܘܼܨܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܛܵܥܝܼ ܠܫܸܡܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܘܦܵܝܫܝܼ ܫܓ݂ܝܼܫܹܐ ܗܲܠܔ ܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܘܦܵܝܫܝܼ ܢܟ݂ܝܼܦܹܐ ܘܛܵܠܩܝܼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܘܝܵܕܥܝܼ ܕܐܲܢ݇ܬ ܒܢܲܦ̮ܫܘܼܟ݂ ܫܸܡܘܼܟ݂ ܡܵܪܝܵܐ ܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܥܸܠܵܝܵܐ ܥܲܠܔ ܟܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}