{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܥܠܔ ܓܬܝܼܬ. ܡܙܡܘܪܐ ܕܒܢܝ̈ ܩܘܪܚ."]},{"type":"verse","number":1,"content":[{"text":"ܟܡܵܐ ܡܘܼܚܸܒܹ̈ܐ ܝܢܵܐ ܡܲܫܟܢܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܚܲܝܠܬܵܢܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܪܘܼܚܪܸܚ ܠܵܗ̇ ܘܐܘܼܦ ܬܝܼܡ ܠܵܗ̇ ܓܵܢܝܼ ܠܕܵܪ̈ܵܬܹ‌ܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܸܒܝܼ ܘܦܲܓ݂ܪܝܼ ܟܹܐ ܫܲܒܚܝܼ ܠܐܲܠܵܗܵܐ ܚܵܝܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܨܸܦܪܬܵ‌ܐ ܡܘܼܫ݇ܟ̰ܸܚ ܠܵܗ̇ ܒܲܝܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܢܘܿܢܝܼܬܵ‌ܐ ܩܸܢܵܐ ܩܵܬܘܼܗ̇، ܕܡܲܬܒ݂ܵܐ ܙܲܥܝܘܼ̈ܗ̇،","poem":1},{"lineBreak":true},{"text":"ܠܟܸܣ ܡܲܕܒܚܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ ܚܲܝܠܬܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܠܟܝܼ ܘܐܲܠܵܗ‌ܝܼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܥܵܡܪ̈ܵܢܹܐ ܕܒܲܝܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܗܲܪ ܒܸܬ ܫܲܒܚܝܼ ܠܘܼܟ݂. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܢܵܫܹ̈ܐ ܕܚܲܝܠܵܝܗ‌ܝ ܒܝܼܘܼܟ݂ ܝܼܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܫܒ݂ܝܼܠܹ̈ܐ ܕܠܨܸܗܝܘܿܢ ܒܠܸܒܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܥܵܒ݂ܪ̈ܵܢܹܐ ܕܪܵܘܘܿܠܵܐ ܕܒܸܟ݂ܝܵܐ، ܟܹܐ ܥܵܒ݂ܕܝܼ ܠܹܗ ܥܲܝܢܵܬܹ̈‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܡܸܛܪܵܐ ܩܲܕܡܵܝܬܵ‌ܐ ܟܹܐ ܡܲܒܪܝܼܵܐ ܒܸܪ̈ܟܹܐ ܕܡ̈ܝܼܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܐܵܙܠ݇ܝܼ ܡ̣ܢ ܚܲܝܠܵܐ ܠܚܲܝܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܵܝܫܝܼ ܚܸܙܝܵܐ ܠܐܲܠܵܗܵܐ ܒܨܸܗܝܘܿܢ،","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ، ܫܡܹܥ ܨܠܘܿܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ، ܝܵܐ ܐܲܠܵܗܵܐ ܕܝܲܥܩܘܿܒ݂. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܚܙܝܼ ܡܵܛܵܠܲܢ، ܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܚܘܼܪ ܒܦܵܬܵ‌ܐ ܕܡܫܝܼܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܘܼܫ ܨܦܵܝܝܼ ܝܠܹܗ ܚܲܕ ܝܵܘܡܵܐ ܒܕܵܪ̈ܵܬܘܼܟ݂ ܡ̣ܢ ܐܲܠܦܵܐ ܒܕܘܼܟܵܐ ܐܚܹܪܬܵ‌ܐ.","poem":1},{"lineBreak":true},{"text":"ܓܘܼܒܹܐ ܠܝܼ ܠܹܗܘܵܝܵܐ ܒܣܩܘܼܦܬܵ‌ܐ ܕܒܲܝܬܵ‌ܐ ܕܐܲܠܵܗ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܠܸܥܡܵܪܵܐ ܒܡܲܫܟܢܹ̈ܐ ܕܪ̈ܲܫܝܼܥܹܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܫܸܡܫܵܐ ܘܡܵܛܵܠܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ،","poem":1},{"lineBreak":true},{"text":"ܫܵܦܵܩܲܬ ܘܐܝܼܩܵܪܵܐ ܒܸܬ ܝܵܗܒܹܠܔ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܡܲܟܠܹܐ ܛܵܒ݂ܬܵ‌ܐ ܡ̣ܢ ܕܐܵܢܝܼ ܕܚܵܕܪܝܼ ܒܬܲܡܝܼܡܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܚܲܝܠܬܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܢܵܫܵܐ ܕܣܵܒܹܪ ܒܝܼܘܼܟ݂.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}