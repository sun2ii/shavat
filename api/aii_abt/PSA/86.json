{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["ܨܠܘܬ‌ܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܨܲܠܝܼ ܢܵܬܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܘܓ̰ܲܘܸܒ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܡܸܣܟܹܢܵܐ ܝܘܸܢ ܘܣܢܝܼܩܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܢܛܘܿܪ ܓܵܢܝܼ ܒܗ̇ܝ ܕܟܫܝܼܛܵܐ ܝܘܸܢ ܐܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܲܪܸܩ ܠܪܹܓܘܼܟ݂، ܝܵܐ ܐܲܠܵܗܵܐ، ܕܒܸܣܒܵܪܵܐ ܝܠܹܗ ܒܝܼܘܼܟ݂.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܪܲܚܸܡ ܥܲܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܸܠܘܼܟ݂ ܒܸܩܪܵܝܵܐ ܝܘܸܢ ܟܠܹܗ ܝܵܘܡܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܡܲܚܕܝܼ ܓܵܢܵܐ ܕܪܹܓܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܸܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܡܲܪܘܼܡܘܼܗ̇ ܝܘܸܢ ܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܛܵܒ݂ܵܐ ܝܘܸܬ ܘܫܵܒ݂ܩܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܸܪܝܵܐ ܒܛܲܝܒܘܼܬܵ‌ܐ ܠܟܠܔ ܕܩܵܪܹܐ ܐܸܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܢܵܬܵ‌ܐ، ܝܵܐ ܡܵܪܝܵܐ، ܠܨܠܘܿܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܨܝܸܬ ܠܩܵܠܵܐ ܕܢܵܘܢܲܝܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܒܝܵܘܡܵܐ ܕܥܵܘܩܵܢܝܼ ܒܸܬ ܩܵܪܹܝܢ ܐܸܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܒܸܬ ܓ̰ܲܘܸܒܸܬ ܠܝܼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܠܲܝܬ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂ ܓܵܘ ܐܲܠܵܗܹ̈ܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܲܝܬ ܦܘܼܠܚܵܢܹ̈ܐ ܐܲܝܟ݂ ܦܘܼܠܚܵܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܟܠܵܝܗ‌ܝ ܐܸܡܘܵܬܹ̈‌ܐ ܕܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܒܸܬ ܐܵܬ‌ܝܼ ܘܣܵܓ݂ܕܝܼ ܩܲܕܡܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܡܝܲܩܪܝܼ ܠܫܸܡܘܼܟ݂،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܓܘܼܪܵܐ ܝܘܸܬ ܐܲܢ݇ܬ ܘܥܵܒ݂ܕܵܢܵܐ ܕܕܘܼܡܵܪܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܝܼܘܸܬ ܐܲܠܵܗܵܐ ܒܢܲܦ̮ܫܘܼܟ݂.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܲܠܸܦ ܠܝܼ ܐܘܼܪܚܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܕܚܵܕܪܹܢ ܒܫܲܪܝܼܪܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܠܹܗ ܠܸܒܝܼ ܚܲܕ، ܕܙܵܕܹܥ ܡ̣ܢ ܫܸܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܸܢܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗ‌ܝܼ، ܒܟܠܹܗ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܡܝܲܩܪܸܢܹܗ ܫܸܡܘܼܟ݂ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܛܲܝܒܘܼܬܘܼܟ݂ ܓܘܼܪܬܵ‌ܐ ܝܠܵܗ̇ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܦܘܼܨܹܐ ܠܘܼܟ݂ ܓܵܢܝܼ ܡ̣ܢ ܫܝܘܿܠܔ ܬܲܚܬܵܝܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ، ܚܵܬܪ̈ܵܢܹܐ ܩܝܼܡ ܠܗܘܿܢ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܟܸܢܫܵܐ ܕܛܵܠܘܿܡܹ̈ܐ ܛܥܹܐ ܠܗܘܿܢ ܠܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܩܵܡ ܡܲܬܒ݂ܝܼ ܠܘܼܟ݂ ܩܲܕܡ ܦܵܬܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܘܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܐܲܠܵܗܵܐ ܡܪܲܚܡܵܢܵܐ ܘܚܲܢܵܢܵܐ ܝܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܝܲܪܝܼܟ݂ܬܵ‌ܐ ܒܹܐܢܹܗ، ܘܪܵܒܵܐ ܒܛܲܝܒܘܼܬܵ‌ܐ ܘܒܫܲܪܝܼܪܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܕܘܼܪ ܠܟܸܣܠܝܼ ܘܪܲܚܸܡ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܗܲܒ݂ܠܔ ܥܘܼܫܢܘܼܟ݂ ܠܪܹܓܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܦܲܪܸܩ ܠܒܪܘܿܢܵܐ ܕܚܸܕܲܡܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܥܒ݂ܘܿܕ ܥܲܡܝܼ ܢܝܼܫܲܢܩܵܐ ܠܛܵܒ݂ܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܚܵܙܝܼ ܣܵܢܝܵܢܝܼ̈ ܘܢܵܟ݂ܦܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܩܵܡ ܗܲܝܸܪܸܬ ܘܝܵܗܒܹܬ ܠܝܼ ܠܸܒܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}