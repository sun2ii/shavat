{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["ܙܡܪܬ‌ܐ. ܡܙܡܘܪܐ ܕܒܢܝ̈ ܩܘܪܚ. ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ. ܥܠܔ ܡܲܚܠܸܬ ܠܥܲܢܘܿܬ. ܡܲܣܟܝܼܠܔ ܕܗܝܡܢ ܐܙܪܚܝܐ."]},{"type":"verse","number":1,"content":[{"text":"ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܕܦܘܼܪܩܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܐܝܼܡܵܡܵܐ ܘܒܠܲܝܠܹܐ ܡܘܼܩܘܸܚ ܠܝܼ ܩܲܕܡܘܼܟ݂.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܫܒ݂ܘܿܩ ܐܵܬܝܵܐ ܠܩܲܕܡܘܼܟ݂ ܨܠܘܿܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܡܲܟܸܦ ܢܵܬܘܼܟ݂ ܠܡܲܩܘܲܚܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܠܹܐ ܠܵܗ̇ ܡ̣ܢ ܣܸܪ̈ܝܵܬܹ‌ܐ ܓܵܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܚܲܝܝܼ̈ ܠܫܝܘܿܠܔ ܡܛܹܐ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܚܘܼܫܒܸܢܵܐ ܥܲܡ ܨܵܠܝܵܢܹ̈ܐ ܕܓܘܼܒܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܝܼ ܐܲܝܟ݂ ܓܲܒ݂ܪܵܐ ܕܠܲܝܬ ܠܹܗ ܚܲܝܠܵܐ؛","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܓܵܘܵܐ ܕܡܝܼ̈ܬܹ‌ܐ ܫܒ݂ܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܩܛܝܼ̈ܠܹܐ ܕܵܡܟ݂ܵܢܹ̈ܐ ܒܩܲܒ݂ܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܠܹܐ ܕܵܟ݂ܪܹܬ ܠܗܘܿܢ ܐܚܹܪܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܵܢܝܼ ܡ̣ܢ ܐܝܼܕܘܼܟ݂ ܦܝܼܫ ܠܗܘܿܢ ܩܛܝܼܥܹܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡܘܼܬܸܒ݂ ܠܘܼܟ݂ ܐܸܠܝܼ ܒܓܘܼܒܵܐ ܬܲܚܬܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܕܘܼܟܵܢܹ̈ܐ ܚܸܫܟܵܢܹ̈ܐ، ܒܥܘܼܡܩܹ̈ܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܥܲܠܝܼ ܦܝܼܫ ܠܵܗ̇ ܡܘܼܬܸܒ݂ܬܵ‌ܐ ܚܸܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܩܵܡ ܡܲܥܝܸܩܸܬ ܠܝܼ ܒܟܠܵܝܗ‌ܝ ܡܲܚܫܘܼܠܘܼ̈ܟ݂. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܘܼܪܚܸܩ ܠܘܼܟ݂ ܝܵܕܥܵܢܝܼ̈ ܡܸܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕܸܢܘܼܟ݂ ܛܲܡܐܘܼܬܵ‌ܐ ܐܸܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫܵܐ ܝܘܸܢ ܚܒ݂ܝܼܫܵܐ ܘܠܹܐ ܡܵܨܹܝܢ ܦܵܠܛܹܢ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܥܲܝܢܝܼ ܢܘܝܼܠܔ ܠܵܗ̇ ܡ̣ܢ ܥܵܘܩܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܟܠܹܗ ܝܵܘܡܵܐ ܩܪܹܐ ܠܝܼ ܐܸܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܪܝܼܣ ܠܝܼ ܐܸܠܘܼܟ݂ ܐܝܼܕܵܬ‌ܝܼ̈.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܠܡܝܼ̈ܬܹ‌ܐ ܒܸܬ ܥܵܒ݂ܕܹܬ ܕܘܼܡܵܪܹ̈ܐ؟","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܪ̈ܘܼܚܵܬܹ‌ܐ ܕܡܝܼ̈ܬܹ‌ܐ ܒܸܬ ܩܵܝܡܝܼ ܫܲܟܪܝܼ ܠܘܼܟ݂؟ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܒܸܬ ܦܵܝܫܵܐ ܗܘܼܩܝܼܬܵ‌ܐ ܒܩܲܒ݂ܪܵܐ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܒܐܲܒ݂ܕܵܢܵܐ ܡܗܘܼܡܢܘܼܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܒܸܬ ܦܵܝܫܝܼ ܝܕܝܼܥܹܐ ܒܚܸܫܟܵܐ ܕܘܼܡܵܪ̈ܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܒܐܲܪܥܵܐ ܕܡܲܢܫܲܝܬܵ‌ܐ ܙܲܕܝܼܩܘܼܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܵܢܵܐ ܐܸܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܡܘܼܩܘܸܚ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܨܲܦܪܵܐ ܨܠܘܿܬ‌ܝܼ ܠܟܸܣܠܘܼܟ݂ ܟܹܐ ܐܵܬܝܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܪܲܦܹܝܬ ܠܵܗ̇ ܓܵܢܝܼ؟","poem":1},{"lineBreak":true},{"text":"ܩܵܡܘܿܕܝܼ ܛܲܫܹܝܬ ܠܵܗ̇ ܦܵܬܘܼܟ݂ ܡܸܢܝܼ؟","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܡܘܼܥܝܸܩܵܐ ܝܘܸܢ ܐܵܢܵܐ، ܘܒܸܡܝܵܬܵ‌ܐ ܡ̣ܢ ܥܠܲܝܡܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܩܘܼܒܸܠܔ ܠܝܼ ܙܕܘܼܥܝܵܬܘܼ̈ܟ݂، ܦܝܼܫ ܠܝܼ ܗܝܼܪܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܚܸܡܬܵ‌ܐ ܕܟܲܪ̈ܒܘܼܟ݂ ܐܬܹ‌ܐ ܠܵܗ̇ ܥܲܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܙܕܘܼܥܝܵܬܘܼ̈ܟ݂ ܩܵܡ ܡܲܫܬܸܩܝܼ ܠܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܩܵܡ ܟܵܪܟ݂ܝܼ ܠܝܼ ܐܲܝܟ݂ ܡ̈ܝܼܵܐ ܟܠܹܗ ܝܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܘܼܪܕܹܐ ܠܗܘܿܢ ܥܲܠܝܼ ܡܥܘܼܕܵܠܹܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܡܘܼܪܚܸܩ ܠܘܼܟ݂ ܡܸܢܝܼ ܡܘܼܚܸܒܵܐ ܘܪܵܚܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܕܥܵܢܝܼ̈ ܒܚܸܫܟܵܐ ܝܢܵܐ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}