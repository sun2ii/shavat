{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["ܡܲܣܟܝܼܠܔ ܕܐܝܬܢ ܐܙܪܚܝܐ."]},{"type":"verse","number":1,"content":[{"text":"ܛܲܝܒܘܵܬܹ̈‌ܐ ܕܡܵܪܝܵܐ ܠܥܵܠܲܡ ܒܸܬ ܙܵܡܪܹܢ،","poem":1},{"lineBreak":true},{"text":"ܠܕܵܪܵܐ ܘܕܵܪܵܐ ܒܸܬ ܡܲܕܥܸܢ ܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܒܦܘܼܡܝܼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܡܝܼܪܝܼ: ܠܥܵܠܲܡ ܛܲܝܒܘܼܬܵ‌ܐ ܒܸܬ ܦܵܝܫܵܐ ܒܢܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܫܡܲܝܵܐ ܒܸܬ ܡܲܩܘܹܝܬ ܡܗܘܼܡܢܘܼܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܡܝܼܪܹܗ ܡܵܪܝܵܐ: ”ܩܛܝܼܥ ܠܝܼ ܘܲܥܕܵܐ ܠܓܘܼܒܝܝܼ،","poem":1},{"lineBreak":true},{"text":"ܝܡܹܐ ܠܝܼ ܠܕܵܘܝܼܕ ܪܹܓܝܼ،","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"”ܗܲܠܔ ܥܵܠܲܡ ܒܸܬ ܡܲܩܘܹܝܢ ܙܲܪܥܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܒܵܢܹܝܢ ܠܕܵܪܵܐ ܘܕܵܪܵܐ ܟܘܼܪܣܝܘܼܟ݂.“ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܫܲܟܪܝܼ ܫܡܲܝܹ̈ܐ ܕܘܼܡܵܪ̈ܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܒܟܸܢܫܵܐ ܕܩܲܕܝܼܫܹ̈ܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܵܢܝܼ ܒܫܡܲܝܵܐ ܦܵܐܹܫ ܡܘܼܕܒܸܩܵܐ ܥܲܡ ܡܵܪܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܡܵܢܝܼ ܕܵܡܹܐ ܠܡܵܪܝܵܐ ܓܵܘ ܒܢܘܿܢܹ̈ܐ ܕܐܲܠܵܗܹ̈ܐ؟","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܲܠܵܗܵܐ ܣܲܗܡܵܢܵܐ ܝܠܹܗ ܪܵܒܵܐ ܓܵܘ ܡܵܘܬܒ݂ܵܐ ܕܩܲܕܝܼܫܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܣܲܗܡܵܢܵܐ ܥܲܠܔ ܟܠܵܝܗ‌ܝ ܚܵܕܸܪ̈ܘܵܢܘܼܗ‌ܝ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܚܲܝܠܬܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܠܹܗ ܐܲܝܟ݂ ܕܝܼܘܼܟ݂ ܥܲܫܝܼܢܵܐ، ܡܵܪܝܵܐ؟","poem":1},{"lineBreak":true},{"text":"ܡܗܘܼܡܢܘܼܬܘܼܟ݂ ܒܚܵܕܸܪ̈ܘܵܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܟܹܐ ܥܵܒ݂ܕܹܬ ܫܘܼܠܛܵܢܵܐ ܥܲܠܔ ܪܵܡܘܼܬܵ‌ܐ ܕܝܵܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܲܕ ܪܵܝܡܝܼ ܠܲܦܘܼ̈ܗ̇ ܐܲܢ݇ܬ ܟܹܐ ܡܲܫܠܹܝܬ ܠܗܘܿܢ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܐܲܢ݇ܬ ܛܒ݂ܝܼܚ ܠܘܼܟ݂ ܠܪܵܚܵܒ݂ ܐܲܝܟ݂ ܩܛܝܼܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܕܪܲܥܢܵܐ ܕܥܘܼܫܢܘܼܟ݂ ܒܙܝܼܩ ܠܘܼܟ݂ ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܕܝܼܘܼܟ݂ ܝܼܠܵܗ̇ ܫܡܲܝܵܐ، ܐܘܼܦ ܕܝܼܘܼܟ݂ ܝܼܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܪܝܼܬܵ‌ܐ ܘܡܸܠܝܘܼܬܘܼܗ̇ ܐܲܢ݇ܬ ܫܘܼܬܐܸܣܵܝ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܓܲܪܒܝܵܐ ܘܬܲܝܡܢܵܐ ܐܲܢ݇ܬ ܒܸܪܝܵܝ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܬܵܒ݂ܘܿܪ ܘܚܸܪܡܘܿܢ ܒܫܸܡܘܼܟ݂ ܟܹܐ ܩܲܘܸܚܝܼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܕܝܼܘܼܟ݂ ܝܼܠܹܗ ܕܪܲܥܢܵܐ ܥܲܡ ܓܲܒܵܪܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܚܲܝܠܵܢܬܵ‌ܐ ܝܠܵܗ̇ ܐܝܼܕܘܼܟ݂، ܪܵܡܬܵ‌ܐ ܝܠܵܗ̇ ܝܲܡܝܼܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܘܕܝܼܘܵܢ ܫܲܬܐܸܣܬܵ‌ܐ ܕܟܘܼܪܣܝܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܛܲܝܒܘܼܬܵ‌ܐ ܘܫܪܵܪܵܐ ܟܹܐ ܩܲܕܡܝܼ ܦܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܥܲܡܵܐ ܕܝܵܕܥܝܼ ܩܲܘܲܚܬܵ‌ܐ ܕܚܲܕܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܒܒܲܗܪܵܐ ܕܦܵܬܘܼܟ݂ ܟܹܐ ܚܵܕܪܝܼ،","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܒܫܸܡܘܼܟ݂ ܟܹܐ ܦܵܨܚܝܼ ܟܠܹܗ ܝܵܘܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܒܙܲܕܝܼܩܘܼܬܘܼܟ݂ ܟܹܐ ܪܵܝܡܝܼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܚܸܩܪܵܐ ܕܥܘܼܫܢܵܝܗ‌ܝ ܐܲܢ݇ܬ ܝܼܘܸܬ،","poem":1},{"lineBreak":true},{"text":"ܘܒܨܸܒ݂ܝܵܢܘܼܟ݂ ܟܹܐ ܪܵܐܹܡ ܚܲܝܠܲܢ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܡܵܛܵܠܲܢ ܕܡܵܪܝܵܐ ܝܠܵܗ̇،","poem":1},{"lineBreak":true},{"text":"ܘܡܲܠܟܲܢ ܕܩܲܕܝܼܫܵܐ ܕܐܝܼܣܪܵܐܹܝܠܔ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܗ̇ܝܓܵܗ ܗܘܼܡܙܸܡ ܠܘܼܟ݂ ܒܚܸܙܘܵܐ ܥܲܡ ܙܲܕܝܼܩܘܼ̈ܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܐܡܝܼܪܘܼܟ݂: ”ܝܘܼܗܒܹܠܔ ܠܝܼ ܗܲܝܲܪܬܵ‌ܐ ܠܓܲܒܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܪܸܡ ܠܝܼ ܓܘܼܒܝܵܐ ܡ̣ܢ ܓܵܘ ܥܲܡܵܐ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"”ܡܘܼܫ݇ܟ̰ܸܚ ܠܝܼ ܠܕܵܘܝܼܕ ܪܹܓܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܡܸܫܚܵܐ ܕܩܘܼܕܫܝܼ ܩܵܡ ܡܵܫܚܹܢܹܗ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"”ܐܝܼܕܝܼ ܒܸܬ ܗܵܘܝܵܐ ܡܩܵܘܝܵܢܬܵ‌ܐ ܥܲܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܐܘܼܦ ܕܪܲܥܢܝܼ ܒܸܬ ܚܲܠܸܢ ܐܸܠܹܗ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"”ܠܹܐ ܥܲܠܕܹܐ ܕܸܫ̃ܡܸܢ ܐܸܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܪܘܿܢܵܐ ܕܥܵܘܠܵܐ ܠܹܐ ܡܲܠܝܸܨ ܠܹܗ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܛܵܒ݂ܚܹܢ ܡ̣ܢ ܩܲܕܡܘܼܗ‌ܝ ܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܢܝܵܢܘܼ̈ܗ‌ܝ ܒܸܬ ܡܵܚܹܝܢ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"”ܡܗܘܼܡܢܘܼܬ‌ܝܼ ܘܛܲܝܒܘܼܬ‌ܝܼ ܥܲܡܹܗ ܒܸܬ ܗܵܘܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܫܸܡܝܼ ܒܸܬ ܪܵܐܹܡ ܚܲܝܠܹܗ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܡܲܬܒܸܢ ܒܝܵܡܵܐ ܐܝܼܕܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܢܲܗܪ̈ܵܘܵܬܹ‌ܐ ܝܲܡܝܼܢܹܗ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"”ܗ̇ܘ ܒܸܬ ܩܵܪܹܐ ܠܝܼ: ’ܒܵܒܝܼ ܝܘܸܬ ܐܲܢ݇ܬ،","poem":1},{"lineBreak":true},{"text":"ܐܲܠܵܗ‌ܝܼ ܘܐܝܼܨܵܪܵܐ ܕܦܘܼܪܩܵܢܝܼ.‘","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"”ܐܘܼܦ ܐܵܢܵܐ ܒܘܼܟ݂ܪܵܐ ܒܸܬ ܥܵܒ݂ܕܹܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܥܸܠܵܝܵܐ ܥܲܠܔ ܡܲܠܟܹ̈ܐ ܕܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"”ܠܥܵܠܲܡ ܒܸܬ ܢܵܛܪܹܢ ܩܵܐ ܕܝܼܹܗ ܛܲܝܒܘܼܬ‌ܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܘܲܥܕܝܼ ܒܸܬ ܦܵܐܹܫ ܡܘܼܩܘܝܼܵܐ ܐܸܠܹܗ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܡܲܬܒܸܢ ܠܥܵܠܲܡ ܙܲܪܥܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܟܘܼܪܣܝܹܗ ܐܲܝܟ݂ ܝܵܘܡܵܢܹ̈ܐ ܕܫܡܲܝܵܐ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"”ܐܸܢ ܫܵܒ݂ܩܝܼ ܒܢܘܿܢܘܼ̈ܗ‌ܝ ܢܵܡܘܿܣܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܒܕܝܼܘܵܢܝܼ̈ ܠܵܐ ܚܵܕܪܝܼ،","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"”ܐܸܢ ܩܵܢܘܿܢܝܼ ܟ̰ܲܦܠܸܢܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܦܘܼܩܕܵܢܝܼ̈ ܠܵܐ ܢܵܛܪܝܼ،","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܣܲܚܒܸܪܸܢ ܒܩܵܛܝܼܵܐ ܓܢܵܗܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܒܡܲܚܘܵܬܹ̈‌ܐ ܥܵܘܠܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"”ܐܝܼܢܵܐ ܛܲܝܒܘܼܬ‌ܝܼ ܠܹܐ ܩܵܛܥܹܢ ܡܸܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܕܲܓܠܸܢ ܥܲܠܔ ܡܗܘܼܡܢܘܼܬ‌ܝܼ،","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"”ܠܹܐ ܟ̰ܲܦܠܸܢܸܢ ܘܲܥܕܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܡܸܢܕܝܼ ܕܦܠܝܼܛ ܠܹܗ ܡ̣ܢ ܣܸܦܘܵܬ‌ܝܼ̈ ܠܹܐ ܫܲܚܠܸܦܸܢ.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"”ܚܕܵܐ ܓܵܗܵܐ ܝܡܹܐ ܠܝܼ ܒܩܘܼܕܫܝܼ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܕܲܓܠܸܢ ܠܕܵܘܝܼܕ.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"”ܙܲܪܥܹܗ ܠܥܵܠܲܡ ܒܸܬ ܗܵܘܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܘܼܪܣܝܹܗ ܐܲܝܟ݂ ܫܸܡܫܵܐ ܠܒܲܠܩܘܼܒ݂ܠܝܼ.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"”ܐܲܝܟ݂ ܣܲܗܪܵܐ ܒܸܬ ܩܵܘܹܐ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܘܣܵܗܕܵܐ ܒܫܡܲܝܵܐ ܡܗܘܼܡܢܵܐ.“ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ، ܪܘܼܦܹܐ ܠܘܼܟ݂ ܘܡܘܼܣܠܹܐ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟܪܝܼܒ ܠܘܼܟ݂ ܥܲܠܔ ܡܫܝܼܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"ܣܪܝܼܒ݂ ܠܘܼܟ݂ ܘܲܥܕܵܐ ܕܪܹܓܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܟ̰ܘܼܦܠܸܢܘܼܟ݂ ܥܲܠܔ ܐܲܪܥܵܐ ܒܸܢܦܵܪܹܗ.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"ܬܪܝܼܥ ܠܘܼܟ݂ ܠܟܠܵܝܗ‌ܝ ܣܝܵܓ݂ܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܩܲܠܥܵܬܘܼ̈ܗ‌ܝ ܚܵܪܵܒܵܐ.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"ܣܠܝܼܒ ܠܗܘܿܢ ܐܸܠܹܗ ܟܠܵܝܗ‌ܝ ܥܵܒ݂ܪ̈ܵܢܹܐ ܕܐܘܼܪܚܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܘܹܐ ܠܹܗ ܠܵܘܡܵܐ ܠܫܒ݂ܵܒ݂ܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"ܡܘܼܪܸܡ ܠܘܼܟ݂ ܝܲܡܝܼܢܵܐ ܕܡܲܠܝܸܨܵܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܚܕܹܐ ܠܘܼܟ݂ ܟܠܵܝܗ‌ܝ ܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"ܐܘܼܦ ܡܘܼܚܕܸܪܘܼܟ݂ ܚܸܪܦܵܐ ܕܣܲܝܦܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܠܵܐ ܡܘܼܩܘܹܐ ܠܘܼܟ݂ ܐܸܠܹܗ ܓܵܘ ܦܠܵܫܵܐ.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"ܡܘܼܟܠܹܐ ܠܘܼܟ݂ ܠܙܲܗܝܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܟܘܼܪܣܝܹܗ ܠܐܲܪܥܵܐ ܚܘܼܪܙܸܦ ܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"ܡܘܼܟܪܹܐ ܠܘܼܟ݂ ܝܵܘܡܵܢܹ̈ܐ ܕܥܠܲܝܡܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܟܸܣ ܠܘܼܟ݂ ܥܲܠܘܼܗ‌ܝ ܢܟ݂ܝܼܦܬܵ‌ܐ. ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ، ܝܵܐ ܡܵܪܝܵܐ، ܒܸܬ ܛܲܫܹܝܬ ܓܵܢܘܼܟ݂ ܠܥܵܠܲܡ؟","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܠܵܗܝܵܐ ܐܲܝܟ݂ ܢܘܼܪܵܐ ܚܸܡܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ ܡܘܼܕܝܼ ܝܠܹܗ ܡܸܬܚܵܐ ܕܚܲܝܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܡܘܼܕܝܼ ܣܪܝܼܩܘܼܬܵ‌ܐ ܒܪܹܐ ܠܘܼܟ݂ ܠܟܠܵܝܗ‌ܝ ܒܢܲܝ̈ܢܵܫܵܐ؟","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܠܹܗ ܓܲܒ݂ܪܵܐ ܕܚܵܝܹܐ ܘܠܵܐ ܚܵܙܹܐ ܡܵܘܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܕܚܲܠܹܨ ܠܵܗ̇ ܓܵܢܹܗ ܡ̣ܢ ܐܝܼܕܵܐ ܕܫܝܘܿܠܔ؟ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"ܐܲܝܟܵܐ ܝܢܵܐ ܛܲܝܒܘܵܬܘܼ̈ܟ݂ ܩܲܕܝܼܡܵܝܹ̈ܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܝܡܹܐ ܠܘܼܟ݂ ܠܕܵܘܝܼܕ ܒܡܗܘܼܡܢܘܼܬܘܼܟ݂؟","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"ܕܟ݂ܘܿܪ، ܝܵܐ ܡܵܪܝܵܐ، ܠܵܘܡܵܐ ܕܪܹ̈ܓܵܘܵܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܩܘܼܒܸܠܔ ܠܝܼ ܒܥܘܼܒܝܼ ܡ̣ܢ ܟܠܵܝܗ‌ܝ ܥܲܡܡܹ̈ܐ ܣܲܓܝܼܐܹ̈ܐ،","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"ܕܠܝܼܡ ܠܗܘܿܢ ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܕܠܝܼܡ ܠܗܘܿܢ ܠܦܵܣܘܿܥܝܵܬܹ̈‌ܐ ܕܡܫܝܼܚܘܼܟ݂.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"ܒܪܝܼܟ݂ܵܐ ܝܠܹܗ ܡܵܪܝܵܐ ܠܥܵܠܲܡ،","poem":1},{"lineBreak":true},{"text":"ܐܵܡܹܝܢ ܘܐܵܡܹܝܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}