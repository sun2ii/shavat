{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["ܠܪܝܫ ܓܘܕܐ ܕܙܡܪ̈ܐ: ܥܠܔ ܡܘܼܬ-ܠܲܒܸܢ. ܡܙܡܘܪܐ ܕܕܘܝܕ."]},{"type":"verse","number":1,"content":[{"text":"ܒܸܬ ܫܲܟܪܸܢ ܠܡܵܪܝܵܐ ܒܟܠܹܗ ܠܸܒܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܗܲܩܹܝܢ ܟܠܵܝܗ‌ܝ ܕܘܼܡܵܪ̈ܘܼܟ݂؛","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܚܵܕܹܝܢ ܘܒܸܬ ܦܵܨܚܹܢ ܒܝܼܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܙܵܡܪܹܢ ܫܸܡܘܼܟ݂، ܝܵܐ ܥܸܠܵܝܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܕܵܝܪܝܼ ܕܸܫ̃ܡܸܢܝܼ ܠܒܵܬܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܬܲܪܩܸܠܝܼ ܘܛܵܠܩܝܼ ܡ̣ܢ ܩܲܕܡܘܼܟ݂؛","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܕܝܼܘܵܢܝܼ ܘܕܝܵܢܬ‌ܝܼ؛","poem":1},{"lineBreak":true},{"text":"ܝܬܝܼܒ݂ ܠܘܼܟ݂ ܥܲܠܔ ܟܘܼܪܣܝܵܐ ܒܸܕܝܵܢܵܐ ܒܙܲܕܝܼܩܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܢܓ̰ܝܼܘ ܠܘܼܟ݂ ܒܐܸܡܘܵܬܹ̈‌ܐ، ܛܘܼܠܸܩ ܠܘܼܟ݂ ܠܒܝܼܫܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܸܡܵܝܗ‌ܝ ܓܪܝܼܕ ܠܘܼܟ݂ ܠܥܵܠܲܡ ܥܵܠܡܝܼܢ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܕܸܫ̃ܡܸܢ ܬܝܼܡ ܠܹܗ ܒܚܪܵܒ݂ܵܐ ܥܵܠܡܝܼܢܵܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡܕܝܼܢܵܬܵܝ̈ܗ‌ܝ ܥܩܝܼܪܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܛܠܝܼܩ ܠܹܗ ܕܟ݂ܵܪܵܐ ܕܝܼܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܡܵܪܝܵܐ ܠܥܵܠܲܡ ܝܬܝܼܒ݂ܵܐ ܝܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܡܘܼܩܘܝܼܵܐ ܝܠܹܗ ܟܘܼܪܣܝܹܗ ܠܕܝܵܢܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܘܗ̇ܘ ܒܸܬ ܕܵܐܹܢ ܠܒܪܝܼܬܵ‌ܐ ܒܙܲܕܝܼܩܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܥܵܒܹܕ ܕܝܵܢܬܵ‌ܐ ܠܥܲܡܡܹ̈ܐ ܒܬܪܘܼܨܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܘܒܸܬ ܗܵܘܹܐ ܡܵܪܝܵܐ ܒܹܝܬ ܓܵܘܣܵܐ ܠܡܘܼܠܝܸܨܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܹܝܬ ܓܵܘܣܵܐ ܒܥܕܵܢܵܐ ܕܐܘܼܠܨܵܢܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܘܒܸܬ ܣܵܒܪܝܼ ܒܝܼܘܼܟ݂ ܝܵܕܥܵܢܹ̈ܐ ܕܫܸܡܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܠܹܐ ܝܘܸܬ ܫܒ݂ܝܼܩܵܐ ܠܛܵܥܝܵܢܹ̈ܐ ܕܐܸܠܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܙܡܘܿܪܘܼܢ ܠܡܵܪܝܵܐ ܥܵܡܪܵܢܵܐ ܒܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܡܲܕܸܥܡܘܼܢ ܥܒ݂ܵܕܘܼ̈ܗ‌ܝ ܓܵܘ ܥܲܡܡܹ̈ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܫܵܩܠܵܢܵܐ ܕܬܘܼܥܠܵܐ ܕܕܸܡܵܐ ܟܹܐ ܕܵܟܹܪ ܠܡܘܼܠܝܸܨܹ̈ܐ؛","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܡܲܢܫܹܐ ܠܡܲܩܘܲܚܬܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܪܲܚܸܡ ܥܲܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܙܝܼ ܐܘܼܠܨܵܢܝܼ ܕܡ̣ܢ ܣܵܢܝܵܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܡܲܪܡܵܢܝܼ ܡ̣ܢ ܕܲܪ̈ܘܵܙܹܐ ܕܡܵܘܬܵ‌ܐ،","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܕܗܲܩܹܝܢ ܟܠܵܝܗ‌ܝ ܬܸܫܒܘܿܚܝܵܬܘܼ̈ܟ݂","poem":1},{"lineBreak":true},{"text":"ܒܕܲܪ̈ܘܵܙܹܐ ܕܒܪܵܬ ܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܥܵܒ݂ܕܹܢ ܦܨܵܚܵܐ ܒܦܘܼܪܩܵܢܘܼܟ݂.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܛܒܝܼܥ ܠܗܘܿܢ ܐܸܡܘܵܬܹ̈‌ܐ ܒܓܘܼܒܵܐ ܕܚܦܝܼܪܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܓܲܪܕܵܐ ܕܛܘܼܡܸܪܗܘܿܢ ܦܝܼܫ ܠܵܗ̇ ܕܒ݂ܝܼܩܬܵ‌ܐ ܐܲܩܠܵܝܗ‌ܝ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܦܝܼܫܵܐ ܝܠܹܗ ܝܕܝܼܥܵܐ ܡܵܪܝܵܐ ܒܕܝܼܘܵܢ ܕܥܒ݂ܝܼܕ ܠܹܗ،","poem":1},{"lineBreak":true},{"text":"ܪܲܫܝܼܥܵܐ ܒܦܘܼܠܚܵܢܵܐ ܕܐܝܼܕܘܼ̈ܗ‌ܝ ܟܹܐ ܦܵܐܹܫ ܕܒ݂ܝܼܩܵܐ ܒܩܘܼܠܬܵ‌ܐ. ܗܓܵܝܘܿܢ ܣܹܠܵܗ","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܒܸܬ ܕܵܝܪܝܼ ܒܝܼܫܹ̈ܐ ܠܫܝܘܿܠܔ،","poem":1},{"lineBreak":true},{"text":"ܟܠܵܝܗ‌ܝ ܐܸܡܘܵܬܹ̈‌ܐ ܢܵܫܝܵܢܹ̈ܐ ܕܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܥܵܠܲܡ ܠܹܐ ܦܵܐܹܫ ܡܘܼܢܫܝܼܵܐ ܣܢܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܠܹܐ ܛܵܠܹܩ ܣܲܒ݂ܪܵܐ ܕܡܸܣܟܹܢܹ̈ܐ ܠܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܩܘܼܡ، ܝܵܐ ܡܵܪܝܵܐ، ܕܠܵܐ ܡܲܫ݇ܟ̰ܸܚ ܙܵܟ݂ܘܼܬܵ‌ܐ ܐܢܵܫܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܵܝܫܝܼ ܕܝܼܢܹܐ ܐܸܡܘܵܬܹ̈‌ܐ ܩܲܕܡ ܦܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܡܲܬܸܒ݂، ܝܵܐ ܡܵܪܝܵܐ، ܙܕܘܼܥܬܵ‌ܐ ܥܲܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܕܝܵܕܥܝܼ ܐܸܡܘܵܬܹ̈‌ܐ ܕܒܢܲܝ̈ܢܵܫܵܐ ܝܢܵܐ ܐܵܢܝܼ. ܣܹܠܵܗ","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}