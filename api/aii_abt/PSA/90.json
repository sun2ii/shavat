{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["ܨܠܘܬ‌ܐ ܕܡܘܫܐ ܐܢܫܐ ܕܐܠܗܐ."]},{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܡܵܪܝܵܐ، ܒܹܝܬ ܡܲܥܡܪܵܐ ܐܲܢ݇ܬ ܗܘܹܐ ܠܘܼܟ݂ ܐܸܠܲܢ ܒܕܵܪܵܐ ܘܕܵܪܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܩܲܕܡ ܕܛܘܼܪܹ̈ܐ ܦܵܝܫܝܼ ܗܘܵܘ ܝܠܝܼܕܹܐ،","poem":1},{"lineBreak":true},{"text":"ܘܬܲܪܨܸܬ ܗܘܵܐ ܐܲܪܥܵܐ ܘܒܪܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܥܵܠܲܡ ܘܥܵܠܲܡ ܐܲܢ݇ܬ ܝܼܘܸܬ ܐܲܠܵܗܵܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܲܕܸܪܸܬ ܠܹܗ ܐܢܵܫܵܐ ܠܥܲܦܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܐܵܡܪܹܬ: ”ܕܘܼܪܘܼܢ، ܝܵܐ ܒܢܲܝ̈ܢܵܫܵܐ.“","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܠܦܵܐ ܫܸܢܹ̈ܐ ܒܥܲܝ̈ܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܐܬܸܡܵܠܝ ܝܢܵܐ ܕܥܒ݂ܝܼܪܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܝܟ݂ ܒܲܕܠܵܐ ܕܠܲܝܠܹܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܓܪܝܼܦܵܝ ܠܘܼܟ݂، ܗܘܹܐ ܠܗܘܿܢ ܐܲܝܟ݂ ܫܸܢܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܓܸܠܵܐ ܕܡܲܩܝܸܢ ܒܨܲܦܪܵܐ،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܒܨܲܦܪܵܐ ܟܹܐ ܡܲܓ̰ܝܸܢ ܘܟܹܐ ܡܲܩܝܸܢ،","poem":1},{"lineBreak":true},{"text":"ܒܪܲܡܫܵܐ ܟܹܐ ܟ̰ܵܡܹܟ̃ ܘܟܹܐ ܒܵܪܹܙ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܬܝܼܡ ܠܲܢ ܒܟܲܪܒܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܚܸܡܬܘܼܟ݂ ܦܝܼܫ ܠܲܢ ܫܓ݂ܝܼܫܹܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܘܼܬܸܒ݂ ܠܘܼܟ݂ ܥܵܘܠܲܢ̈ ܠܒܲܠܩܘܼܒ݂ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܚܛܵܗܲܢ̈ ܛܸܫܝܹ̈ܐ ܩܲܕܡ ܒܲܗܪܵܐ ܕܦܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܠܵܝܗ‌ܝ ܝܵܘܡܵܢܲܢ̈ ܥܒ݂ܝܼܪܗܘܿܢ ܒܚܸܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܬܝܼܡܵܝ ܠܲܢ ܫܸܢܲܢ̈ ܐܲܝܟ݂ ܬܲܢܲܚܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܝܵܘܡܵܢܹ̈ܐ ܕܚܲܝܲܢ̈ ܫܲܒ݂ܥܝܼ ܫܸܢܹ̈ܐ ܝܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܸܢ ܒܓܲܒܵܪܘܼܬܵ‌ܐ، ܬܡܵܢܝܼ ܫܸܢܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܒܪܲܒܘܼܬܵܝܗ‌ܝ ܥܲܡܠܵܐ ܘܕܲܪܕ،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܟܹܐ ܥܵܒ݂ܪܝܼ ܓ̰ܲܠܕܹܐ ܘܟܹܐ ܦܵܪܚܲܚ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܝܵܕܹܥ ܚܲܝܠܵܐ ܕܚܸܡܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܣܵܒܵܒ ܗܲܪ ܐܲܝܟ݂ ܙܕܘܼܥܬܵ‌ܐ ܕܡܸܢܘܼܟ݂ ܝܼܠܵܗ̇ ܟܲܪܒܘܼܟ݂؟","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܡܲܕܸܥ ܠܲܢ ܠܸܡܢܵܝܵܐ ܝܵܘܡܵܢܲܢ̈،","poem":1},{"lineBreak":true},{"text":"ܕܡܵܛܲܚ ܠܠܸܒܵܐ ܕܚܸܟ݂ܡܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܕܘܼܪ، ܝܵܐ ܡܵܪܝܵܐ! ܗܲܠܔ ܐܝܼܡܲܢ؟","poem":1},{"lineBreak":true},{"text":"ܘܪܲܚܸܡ ܥܲܠܔ ܪܹ̈ܓܵܘܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܡܲܣܒܸܥ ܠܲܢ ܒܨܲܦܪܵܐ ܒܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܫܲܒܚܲܚ ܘܚܵܕܲܚ ܒܟܠܵܝܗ‌ܝ ܝܵܘܡܵܢܲܢ̈.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܡܲܚܕܝܼ ܠܲܢ ܐܲܝܟ݂ ܝܵܘܡܵܢܹ̈ܐ ܕܩܵܡ ܡܲܠܝܸܨܸܬ ܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܫܸܢܹ̈ܐ ܕܚܙܹܐ ܠܲܢ ܒܝܼܫܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܦܵܐܹܫ ܚܸܙܝܵܐ ܠܪܹ̈ܓܵܘܵܬܘܼܟ݂ ܦܘܼܠܚܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܫܘܼܒ݂ܚܘܼܟ݂ ܠܒܢܘܿܢܵܝ̈ܗ‌ܝ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܘܗܵܘܝܵܐ ܒܲܣܝܼܡܘܼܬܵ‌ܐ ܕܡܵܪܝܵܐ ܐܲܠܵܗܵܐ ܥܲܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܥܒ݂ܵܕܵܐ ܕܐܝܼܕܵܬܲܢ̈ ܡܲܩܘܹܐ ܥܲܠܲܢ،","poem":1},{"lineBreak":true},{"text":"ܘܥܒ݂ܵܕܵܐ ܕܐܝܼܕܵܬܲܢ̈ ܡܲܩܘܹܐ ܠܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}