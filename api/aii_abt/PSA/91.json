ineBreak":true},{"text":"ܡ̣ܢ ܓܹܐܪܵܐ ܕܦܵܪܹܚ ܒܐܝܼܡܵܡܵܐ،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܡ̣ܢ ܡܲܪܥܵܐ ܩܵܛܠܵܢܵܐ ܕܚܵܕܹܪ ܒܚܸܫܟܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܡܲܚܪܲܒ݂ܬܵ‌ܐ ܕܛܲܠܩܵܐ ܒܛܲܗܪܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܢܵܦܠܝܼ ܐܲܠܦܵܐ ܡ̣ܢ ܕܸܦܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܪܸܒܘܼܬܵ‌ܐ ܡ̣ܢ ܝܲܡܝܼܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܠܟܸܣܠܘܼܟ݂ ܠܹܐ ܩܲܪܒܸܢ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܲܚܟ̰ܝܼ ܒܥܲܝ̈ܢܘܼܟ݂ ܒܸܬ ܚܵܝܪܹܬ،","poem":1},{"lineBreak":true},{"text":"ܘܦܘܼܪܥܵܢܵܐ ܕܪ̈ܲܫܝܼܥܹܐ ܒܸܬ ܚܵܙܹܝܬ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܠܡܵܪܝܵܐ ܥܸܠܵܝܵܐ، ܗ̇ܘ ܕܝܼܠܹܗ ܒܹܝܬ ܓܵܘܣܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܒ݂ܝܼܕ ܠܘܼܟ݂ ܡܲܥܡܪܘܼܟ݂،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܠܹܐ ܬܵܦܩܵܐ ܒܝܼܘܼܟ݂ ܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܹܐ ܩܲܪܒܸܢܵܐ ܠܡܲܫܟܢܘܼܟ݂ ܡܚܘܿܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܒܸܬ ܦܵܩܹܕ ܠܡܲܠܲܐܟ݂ܘܼ̈ܗ‌ܝ ܒܘܼܬ ܕܝܼܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܢܵܛܪܝܼ ܠܘܼܟ݂ ܒܟܠܵܝܗ‌ܝ ܐܘܼܪ̈ܚܵܬܘܼܟ݂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܥܲܠܔ ܐܝܼܕܵܬܵܝ̈ܗ‌ܝ ܒܸܬ ܛܵܥܢܝܼ ܠܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܕܠܵܐ ܬܲܪܩܸܠܵܐ ܒܟܹܐܦܵܐ ܐܲܩܠܘܼܟ݂.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܥܲܠܔ ܐܲܪܝܵܐ ܘܦܲܬܢܵܐ ܒܸܬ ܦܵܣܥܹܬ،","poem":1},{"lineBreak":true},{"text":"ܓܘܼܪܝܵܐ ܕܐܲܪܝܵܐ ܘܬܲܢܝܼܢܵܐ ܒܸܬ ܕܲܫܕܸܫܸܬ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܦܲܨܹܢܹܗ ܣܵܒܵܒ ܡܘܼܚܸܒ ܠܹܗ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܡܲܪܡܸܢܹܗ ܠܫܲܝܢܵܐ ܒܗ̇ܝ ܕܝܕܝܼܥ ܠܹܗ ܫܸܡܝܼ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"”ܒܸܬ ܓ̰ܲܘܸܒܸܢܹܗ ܐܝܼܡܲܢ ܕܩܵܪܹܐ ܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܥܲܡܹܗ ܝܘܸܢ ܐܵܢܵܐ ܒܥܕܵܢܵܐ ܕܥܵܘܩܵܢܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܲܨܹܢܹܗ ܘܒܸܬ ܡܝܲܩܪܸܢܹܗ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"”ܒܝܘܼܪܟ݂ܵܐ ܕܝܵܘܡܵܢܹ̈ܐ ܒܸܬ ܡܲܣܒܸܥܸܢܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܡܲܚܙܹܝܢ ܐܸܠܹܗ ܦܘܼܪܩܵܢܝܼ.“","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}