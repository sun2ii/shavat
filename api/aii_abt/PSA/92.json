{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["ܡܙܡܘܪܐ. ܙܡܪܬ‌ܐ ܩܐ ܝܘܡܐ ܕܫܒܬ."]},{"type":"verse","number":1,"content":[{"text":"ܨܦܵܝܝܼ ܝܠܵܗ̇ ܠܫܲܟܘܼܪܹܐ ܠܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܸܙܡܵܪܵܐ ܠܫܸܡܘܼܟ݂، ܝܵܐ ܥܸܠܵܝܵܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܠܡܲܕܘܼܥܹܐ ܒܨܲܦܪܵܐ ܛܲܝܒܘܼܬܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܘܒܠܲܝܠܵܘܵܬܹ̈‌ܐ ܡܗܘܼܡܢܘܼܬܘܼܟ݂،","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܥܲܠܔ ܡܵܐܢܹ̈ܐ ܕܙܡܵܪܵܐ ܕܥܸܣܪܵܐ ܣܝܼܡܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܘܥܲܠܔ ܩܝܼܬܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܥܲܠܔ ܗܵܘܵܙ ܕܟܸܢܵܪܵܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܩܵܡ ܡܲܚܕܹܝܬ ܠܝܼ، ܝܵܐ ܡܵܪܝܵܐ، ܒܦܘܼܠܚܵܢܘܼܟ݂،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܦܘܼܠܚܵܢܹ̈ܐ ܕܐܝܼܕܵܬܘܼ̈ܟ݂ ܒܸܬ ܫܲܒܚܸܢ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܟܡܵܐ ܓܘܼܪܹ̈ܐ ܝܢܵܐ ܦܘܼܠܚܵܢܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܪܵܒܵܐ ܥܲܡܘܼܩܹ̈ܐ ܝܢܵܐ ܚܘܼܫܵܒ݂ܘܼ̈ܟ݂.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܐܢܵܫܵܐ ܫܹܐܕܵܢܵܐ ܠܹܐ ܝܵܕܹܥ،","poem":1},{"lineBreak":true},{"text":"ܘܣܲܟ݂ܠܵܐ ܠܹܐ ܦܲܪܡܹܐ ܐܵܗܵܐ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܕܒܲܪܛܸܢܝܼ ܪ̈ܲܫܝܼܥܹܐ ܐܲܝܟ݂ ܓܸܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܦܵܩܚܝܼ ܟܠܵܝܗ‌ܝ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܵܕܟ݂ܵܐ ܟܹܐ ܗܵܘܝܵܐ ܕܦܵܝܫܝܼ ܛܘܼܠܩܹܐ ܗܲܠܔ ܥܵܠܲܡ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܐܲܢ݇ܬ ܪܵܡܵܐ ܝܘܸܬ ܠܥܵܠܲܡ، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܗܵܐ، ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܗ̇ܝ ܕܗܵܐ، ܕܸܫ̃ܡܸܢܘܼ̈ܟ݂ ܒܸܬ ܛܵܠܩܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܦܵܝܫܝܼ ܒܘܼܪܒܸܙܹܐ ܟܠܵܝܗ‌ܝ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܘܡܘܼܪܸܡ ܠܘܼܟ݂ ܩܲܪ݇ܢܝܼ ܐܲܝܟ݂ ܩܲܪ݇ܢܵܐ ܕܪܲܝܡܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫ ܠܝܼ ܡܫܝܼܚܵܐ ܒܡܸܫܚܵܐ ܚܵܕܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܘܚܙܹܐ ܠܵܗ̇ ܥܲܝܢܝܼ ܙܵܟ݂ܘܼܬܵ‌ܐ ܠܕܸܫ̃ܡܸܢܝܼ̈،","poem":1},{"lineBreak":true},{"text":"ܫܡܝܼܥ ܠܗܘܿܢ ܢܵܬܝܵܬ‌ܝܼ̈ ܒܘܼܬ ܩܵܝܡܵܢܹ̈ܐ ܥܲܠܝܼ، ܥܵܒ݂ܕܵܢܹ̈ܐ ܕܒܝܼܫܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܙܲܕܝܼܩܵܐ ܐܲܝܟ݂ ܐܝܼܠܵܢܵܐ ܕܚܘܼܪ̈ܡܹܐ ܒܸܬ ܒܲܪܛܸܢ،","poem":1},{"lineBreak":true},{"text":"ܐܲܝܟ݂ ܐܲܪ̈ܙܹܐ ܕܒܠܸܒ݂ܢܵܢ ܒܸܬ ܓܲܪܘܸܣ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܫܬܝܼܠܹܐ ܝܢܵܐ ܒܒܲܝܬܵ‌ܐ ܕܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܕܵܪ̈ܵܬܹ‌ܐ ܕܐܲܠܵܗܲܢ ܒܸܬ ܒܲܪܛܸܢܝܼ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܗܸܫ ܒܸܬ ܡܲܝܬ‌ܝܼ ܛܥܘܼܢܬܵ‌ܐ ܒܣܲܝܒܘܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܫܲܡܝܼܢܹ̈ܐ ܘܩܝܼܢܹ̈ܐ ܒܸܬ ܗܵܘܝܼ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܠܡܲܕܘܼܥܹܐ ܕܬܪܘܼܨܵܐ ܝܠܹܗ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܝܼܨܵܪܝܼ، ܘܠܲܝܬ ܥܵܘܠܵܐ ܒܝܼܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}