{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܫܵܩܠܵܢܵܐ ܕܬܘܼܥܠܵܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܝܵܐ ܐܲܠܵܗܵܐ ܫܵܩܠܵܢܵܐ ܕܬܘܼܥܠܵܐ، ܙܪܘܿܩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܦܘܼܫ ܪܝܼܡܵܐ، ܝܵܐ ܕܲܝܵܢܵܐ ܕܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡܲܕܸܪ ܦܘܼܪܥܵܢܵܐ ܥܲܠܔ ܚܵܬܪ̈ܵܢܹܐ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ ܪ̈ܲܫܝܼܥܹܐ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܐܝܼܡܲܢ ܪ̈ܲܫܝܼܥܹܐ ܦܵܨܚܝܼ؟","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܓܲܒܓܸܒܝܼ، ܟܹܐ ܗܲܡܙܸܡܝܼ ܒܫܘܼܒ݂ܗܵܪܵܐ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܚܵܬܪܝܼ ܒܓܵܢܵܝܗ‌ܝ ܟܠܵܝܗ‌ܝ ܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܠܥܲܡܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܟܹܐ ܛܲܚܛܸܚܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܝܵܪܬܘܼܬܘܼܟ݂ ܟܹܐ ܡܲܠܝܸܨܝܼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܠܐܲܪܡܸܠܬܵ‌ܐ ܘܠܡܵܫܵܚܲܛ ܟܹܐ ܩܵܛܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܘܠܝܲܬܘܼܡܹ̈ܐ ܟܹܐ ܡܲܡܝܸܬ‌ܝܼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܘܟܹܐ ܐܵܡܪܝܼ: ”ܠܹܐ ܚܵܙܹܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܠܵܗܵܐ ܕܝܲܥܩܘܿܒ݂ ܠܹܐ ܡܲܣܸܡ ܒܵܠܵܐ.“","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܡܲܣܸܡܘܼܢ ܒܵܠܵܐ، ܝܵܐ ܐܲܗܡܲܩܹ̈ܐ ܕܓܵܘ ܥܲܡܵܐ؛","poem":1},{"lineBreak":true},{"text":"ܐܝܼܡܲܢ ܒܸܬ ܦܲܪܡܹܝܬܘܿܢ، ܝܵܐ ܣܲܟ݂ܠܹ̈ܐ؟","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܢܵܨܒ݂ܵܢܵܐ ܕܢܵܬܵ‌ܐ، ܗܵܐ، ܠܹܐ ܫܵܡܹܥ؟","poem":1},{"lineBreak":true},{"text":"ܝܲܢ ܓܵܒ݂ܠܵܢܵܐ ܕܥܲܝܢܵܐ، ܗܵܐ، ܠܹܐ ܚܵܙܹܐ؟","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܬܲܠܡܸܕܵܢܵܐ ܕܐܸܡܘܵܬܹ̈‌ܐ، ܗܵܐ، ܠܹܐ ܡܲܢܟܸܣ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܕܟܹܐ ܡܲܠܸܦ ܝܕܵܥܬܵ‌ܐ ܠܒܲܪܢܵܫܵܐ؟","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܡܵܪܝܵܐ ܟܹܐ ܝܵܕܹܥ ܚܘܼܫܵܒܹ̈ܐ ܕܐܢܵܫܵܐ","poem":1},{"lineBreak":true},{"text":"ܕܣܪܝܼܩܘܼܬܵ‌ܐ ܝܢܵܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܛܘܼܒ݂ܵܐ ܠܐܢܵܫܵܐ ܕܬܲܠܡܸܕܸܬ ܠܹܗ، ܝܵܐ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܡ̣ܢ ܢܵܡܘܿܣܘܼܟ݂ ܡܲܠܦܸܬ ܠܹܗ،","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ܠܝܼܵܗܒܹܗ ܢܝܵܚܵܐ ܡ̣ܢ ܝܵܘܡܵܢܹ̈ܐ ܕܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܗܲܠܔ ܕܦܵܐܹܫ ܚܦܝܼܪܵܐ ܓܘܼܒܵܐ ܠܪܲܫܝܼܥܵܐ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܹܐ ܪܲܦܹܐ ܡܵܪܝܵܐ ܠܥܲܡܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܠܝܵܪܬܘܼܬܹܗ ܠܹܐ ܫܵܒܹܩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܠܙܲܕܝܼܩܘܼܬܵ‌ܐ ܒܸܬ ܕܵܝܪܵܐ ܕܝܼܘܵܢ،","poem":1},{"lineBreak":true},{"text":"ܘܒܸܬ ܐܵܙܠ݇ܝܼ ܒܵܬܪܘܼܗ̇ ܟܠܵܝܗ‌ܝ ܬܪ̈ܘܼܨܹܐ ܕܠܸܒܵܐ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ܡܵܢܝܼ ܒܸܬ ܩܵܐܹܡ ܩܵܬ‌ܝܼ ܕܲܠܩܘܼܒ݂ܠܔ ܕܥܵܒ݂ܕܵܢܹ̈ܐ ܕܒܝܼܫܬܵ‌ܐ؟","poem":1},{"lineBreak":true},{"text":"ܡܵܢܝܼ ܒܸܬ ܟܵܠܹܐ ܩܵܬ‌ܝܼ ܕܲܠܩܘܼܒ݂ܠܔ ܕܦܵܠܚܵܢܹ̈ܐ ܕܥܵܘܠܵܐ؟","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܠܵܐ ܗܵܘܹܐ ܗܘܵܐ ܡܵܪܝܵܐ ܗܲܝܲܪܬܵ‌ܐ ܐܸܠܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܵܬܪ ܚܲܕܟ̰ܵܐ ܒܸܬ ܫܵܪܝܵܐ ܗܘܵܐ ܓܵܢܝܼ ܒܕܘܼܝܵܪܵܐ ܕܫܸܬܩܵܐ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ܐܸܢ ܐܡܝܼܪܝܼ: ”ܓ̰ܪܝܼܛ ܠܵܗ̇ ܐܲܩܠܝܼ،“","poem":1},{"lineBreak":true},{"text":"ܛܲܝܒܘܼܬܘܼܟ݂، ܝܵܐ ܡܵܪܝܵܐ، ܟܹܐ ܣܵܢܕܵܐ ܠܝܼ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ܟܲܕ ܙܵܝܕܝܼ ܚܲܡܝܼ̈ ܒܓܵܘܝܼ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܝܵܐܘܼ̈ܟ݂ ܟܹܐ ܡܲܚܕܝܼ ܠܓܵܢܝܼ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ܗܵܐ، ܡܵܨܝܼ ܥܵܒ݂ܕܝܼ ܚܲܒ݂ܪܘܼܬܵ‌ܐ ܥܲܡܘܼܟ݂ ܫܘܼܠܛܵܢܹ̈ܐ ܕܛܠܘܼܡܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܐܵܢܝܼ ܕܟܹܐ ܓܵܒ݂ܠܝܼ ܡܲܠܝܲܨܬܵ‌ܐ ܒܩܵܢܘܿܢܵܐ؟","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ܘܟܹܐ ܓ̰ܵܡܥܝܼ ܥܲܠܔ ܓܵܢܵܐ ܕܙܲܕܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܕܸܡܵܐ ܙܲܟܵܝܵܐ ܟܹܐ ܥܵܒ݂ܕܝܼ ܚܲܝܵܒ݂ܵܐ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ܐܝܼܢܵܐ ܗܘܹܐ ܠܹܗ ܡܵܪܝܵܐ ܐܸܠܝܼ ܩܲܠܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܐܲܠܵܗ‌ܝܼ ܐܝܼܨܵܪܵܐ ܕܒܹܝܬ ܓܵܘܣܝܼ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ܘܒܸܬ ܡܲܕܸܪ ܥܲܠܵܝܗ‌ܝ ܥܵܘܠܵܝܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܘܓܵܘ ܒܝܼܫܘܼܬܵܝܗ‌ܝ ܒܸܬ ܛܲܠܸܩ ܠܗܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܒܸܬ ܛܲܠܸܩ ܠܗܘܿܢ ܡܵܪܝܵܐ ܐܲܠܵܗܲܢ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}