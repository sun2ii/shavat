{"translation":{"id":"aii_abt","name":"ܕܝܬܩܐ ܚܕܬܐ ܕܡܪܢ ܝܫܘܥ ܡܫܝܚܐ ܘܡܙܡܘܪ̈ܐ ܒܠܫܢܐ ܐܬܘܪܝܐ","website":"https://ebible.org/Scriptures/details.php?id=aii","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aii","licenseNotes":null,"shortName":"ABT","englishName":"Assyrian Neo-Aramaic NT+Psalms","language":"aii","textDirection":"rtl","sha256":"1859152dbbffe55d2b7ac6d4c09fbad5a6416ca25359e69220bb358dac602444","availableFormats":["json"],"listOfBooksApiLink":"/api/aii_abt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10420,"languageName":"Assyrian Neo-Aramaic","languageEnglishName":"Assyrian Neo-Aramaic"},"book":{"id":"PSA","translationId":"aii_abt","name":"ܡܙܡܘܪ̈ܐ","commonName":"ܡܙܡܘܪ̈ܐ","title":"ܡܙܡܘܪ̈ܐ","order":19,"numberOfChapters":150,"sha256":"08b7c4463dda6adc56b2c377f42d67ace350af655720940a2e395776a718fc6c","firstChapterNumber":1,"firstChapterApiLink":"/api/aii_abt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/aii_abt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"ܡܵܪܝܵܐ ܒܸܥܒ݂ܵܕܵܐ ܝܠܹܗ ܡܲܠܟܘܼܬܵ‌ܐ، ܦܵܨܚܵܐ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܚܵܕܝܼ ܓܵܙܪ̈ܵܬܹ‌ܐ ܦܸܪ̈ܝܹܐ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ܥܢܵܢܵܐ ܘܚܸܫܟܵܐ ܥܲܡܘܼܩܵܐ ܠܚܵܕܸܪ̈ܘܵܢܘܼܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܙܲܕܝܼܩܘܼܬܵ‌ܐ ܘܕܝܼܘܵܢ ܫܲܬܐܸܣܬܵ‌ܐ ܕܟܘܼܪܣܝܹܗ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ܢܘܼܪܵܐ ܩܲܕܡܘܼܗ‌ܝ ܟܹܐ ܐܵܙܹܠܔ،","poem":1},{"lineBreak":true},{"text":"ܘܟܹܐ ܡܲܩܸܕ ܕܸܫ̃ܡܸܢܘܼ̈ܗ‌ܝ ܒܚܵܕܸܪ̈ܘܵܢܹܐ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ܒܘܼܗܪܸܢܗܘܿܢ ܒܸܪ̈ܩܘܼܗ‌ܝ ܠܒܪܝܼܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܚܙܹܐ ܠܵܗ̇ ܘܪܘܼܬܪܸܬ ܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ܦܫܝܼܪܗܘܿܢ ܛܘܼܪ̈ܵܢܹܐ ܐܲܝܟ݂ ܫܲܡܲܥ ܡ̣ܢ ܩܲܕܡ ܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܡ̣ܢ ܩܲܕܡ ܡܵܪܵܐ ܕܟܠܵܗ̇ ܐܲܪܥܵܐ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ܟܹܐ ܡܲܕܥܝܼ ܫܡܲܝܹ̈ܐ ܙܲܕܝܼܩܘܼܬܹܗ،","poem":1},{"lineBreak":true},{"text":"ܘܚܙܹܐ ܠܗܘܿܢ ܟܠܵܝܗ‌ܝ ܥܲܡܡܹ̈ܐ ܐܝܼܩܵܪܹܗ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ܢܵܟ݂ܦܝܼ ܟܠܵܝܗ‌ܝ ܦܵܠܚܵܢܹ̈ܐ ܕܨܲܠܡܹ̈ܐ،","poem":1},{"lineBreak":true},{"text":"ܥܵܒ݂ܕܵܢܹ̈ܐ ܕܫܘܼܒ݂ܗܵܪܵܐ ܒܨܵܢܲܡܹ̈ܐ ܣܪ̈ܝܼܩܹܐ.","poem":1},{"lineBreak":true},{"text":"ܣܓ݂ܘܿܕܘܼܢ ܐܸܠܹܗ ܟܠܵܝܗ‌ܝ ܐܲܠܵܗܹ̈ܐ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ܫܡܝܼܥ ܠܵܗ̇ ܘܚܕܹܐ ܠܵܗ̇ ܨܸܗܝܘܿܢ،","poem":1},{"lineBreak":true},{"text":"ܘܦܨܝܼܚ ܠܗܘܿܢ ܒܢܵܬܹ̈‌ܐ ܕܝܼܗܘܼܕܵܐ،","poem":1},{"lineBreak":true},{"text":"ܒܘܼܬ ܕܝܼܘܵܢܘܼ̈ܟ݂، ܝܵܐ ܡܵܪܝܵܐ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ܣܵܒܵܒ ܐܲܢ݇ܬ، ܝܵܐ ܡܵܪܝܵܐ، ܥܸܠܵܝܵܐ ܝܘܸܬ ܥܲܠܔ ܟܠܵܗ̇ ܐܲܪܥܵܐ،","poem":1},{"lineBreak":true},{"text":"ܦܝܼܫܵܐ ܝܘܸܬ ܡܘܼܪܡܵܐ ܪܵܒܵܐ ܥܲܠܔ ܟܠܵܝܗ‌ܝ ܐܲܠܵܗܹ̈ܐ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ܝܵܐ ܡܲܚܸܒܵܢܹ̈ܐ ܕܡܵܪܝܵܐ، ܣܢܹܝܡܘܼܢ ܠܒܝܼܫܬܵ‌ܐ،","poem":1},{"lineBreak":true},{"text":"ܗ̇ܘ ܟܹܐ ܢܵܛܹܪ ܓܵܢܵܬܹ̈‌ܐ ܕܡܗܘܼܡܢܘܼ̈ܗ‌ܝ،","poem":1},{"lineBreak":true},{"text":"ܟܹܐ ܦܲܨܹܐ ܠܗܘܿܢ ܡ̣ܢ ܐܝܼܕܵܐ ܕܪ̈ܲܫܝܼܥܹܐ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ܒܲܗܪܵܐ ܙܪܝܼܩ ܠܹܗ ܠܙܲܕܝܼܩܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܠܬܪ̈ܘܼܨܹܐ ܕܠܸܒܵܐ ܚܲܕܘܼܬܵ‌ܐ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ܚܕܹܝܡܘܼܢ، ܝܵܐ ܙܲܕܝܼܩܹ̈ܐ، ܒܡܵܪܝܵܐ،","poem":1},{"lineBreak":true},{"text":"ܘܫܲܟܪܘܼܢ ܠܕܟ݂ܵܪܵܐ ܕܩܘܼܕܫܹܗ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aii_abt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aii_abt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aii_abt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}