{"translation":{"id":"alq_cbs","name":"Kije Manido Odikido8in: Ocki Mazinaigan","website":"https://ebible.org/Scriptures/details.php?id=alqALGNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alqALGNT","licenseNotes":null,"shortName":"CBS","englishName":"Algonquin NT","language":"alq","textDirection":"ltr","sha256":"0875dbba07d092cd4fb49df3a8227df34e98a8ac231b3235db1837e70ddae69f","availableFormats":["json"],"listOfBooksApiLink":"/api/alq_cbs/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7923,"languageName":"Algonquin","languageEnglishName":"Algonquin"},"book":{"id":"MAT","translationId":"alq_cbs","name":"MATIO","commonName":"MATIO","title":"Min8adjimo8ini kagi ojibiag kitcit8a Matio","order":40,"numberOfChapters":28,"sha256":"8bcdff3ff0729e4277018e6e79f8a61794ed8095314beed354239d5a509e5019","firstChapterNumber":1,"firstChapterApiLink":"/api/alq_cbs/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/alq_cbs/MAT/28.json","totalNumberOfVerses":1070},"chapter":{"number":1,"content":[{"type":"heading","content":["Jesos 8edaiagizidj"]},{"type":"verse","number":1,"content":["Niga mikoma Jesos Christ. Ogima Davidikag odaiagizigoban aa Jesos, acitc dac ogima David 8in Abanaamikag (Abraham) odaiagizigoban. Midac oo 8edaiagizipan Jesos:"]},{"type":"verse","number":2,"content":[{"text":"Abanaam ini og8izisibanin Aisikan (Isaac).","poem":1},{"text":"Aisik ini og8izisibanin Tcekapan (Jacob).","poem":2},{"lineBreak":true},{"text":"Tcekap ini og8izisibanin Codan (Juda)","poem":2},{"text":"acitc Codan ka iji 8idjiki8endjin.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Coda ini og8izisibanin Peresan (Pharès) acitc Zaran.","poem":2},{"text":"Mi ini odjodjomi8abanin Tamaran.","poem":3},{"text":"Peres ini og8izisibanin Esroman.","poem":2},{"lineBreak":true},{"text":"Esrom ini og8izisibanin Araman.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aram ini og8izisibanin Aminadaban.","poem":2},{"lineBreak":true},{"text":"Aminadab ini og8izisibanin Naassonan.","poem":2},{"lineBreak":true},{"text":"Naasson ini og8izisibanin Salmon.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmo ini og8izisibanin Boozan.","poem":2},{"text":"Mi ini Booz odjodjombanin Raaban.","poem":3},{"text":"Booz ini og8izisibanin Obedan.","poem":2},{"text":"Mi ini Obed odjodjombanin Ruthan.","poem":3},{"text":"Obed ini og8izisibanin Jessen.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jesse ini og8izisibanin ogima Davidan.","poem":2},{"lineBreak":true},{"text":"David ini og8izisibanin Sanamo (Salomon).","poem":1},{"text":"Sanamo odjodjoman,","poem":3},{"lineBreak":true},{"text":"mi ini ockadok Ori (Urie) okokomimbanin.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Sanamo ini og8izisibanin Roboaman.","poem":2},{"lineBreak":true},{"text":"Roboam ini og8izisibanin Abian.","poem":2},{"lineBreak":true},{"text":"Abia ini og8izisibanin Asafan.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaf ini og8izisibanin Josapatan.","poem":2},{"lineBreak":true},{"text":"Josapat ini og8izisibanin Joraman.","poem":2},{"lineBreak":true},{"text":"Joram ini og8izisibanin Oziasan.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ozias ini og8izisibanin Joataman.","poem":2},{"lineBreak":true},{"text":"Joatam ini og8izisibanin Akazan.","poem":2},{"lineBreak":true},{"text":"Akaz ini og8izisibanin Ezekiasan.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezekias ini og8izisibanin Manasan.","poem":2},{"lineBreak":true},{"text":"Manasa ini og8izisibanin Amonan.","poem":2},{"lineBreak":true},{"text":"Amon ini og8izisibanin Josiasan.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Josias ini og8izisibanin Iekonian","poem":2},{"text":"acitc ka iji 8idjiki8edj Iekonia.","poem":3},{"text":"Midac ii apitc ka iji8inagani8i8adj Israel a8iagog","poem":1},{"text":"8edi Babilon (Babylone) akikag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ka ick8a iji8inagani8i8adj Israel a8iagog 8edi Babilon akikag,","poem":1},{"text":"Iekonia ini og8izisibanin Salatielan.","poem":2},{"lineBreak":true},{"text":"Salatiel ini og8izisibanin Zorobabelan.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zorobabel ini og8izisibanin Abiodan.","poem":2},{"lineBreak":true},{"text":"Abiod ini og8izisibanin Eliakiman.","poem":2},{"lineBreak":true},{"text":"Eliakim ini og8izisibanin Azoran.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azor ini og8izisibanin Sadokan.","poem":2},{"lineBreak":true},{"text":"Sadok ini og8izisibanin Akiman.","poem":2},{"lineBreak":true},{"text":"Akim ini og8izisibanin Eliodan.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliod ini og8izisibanin Eleazaran.","poem":2},{"lineBreak":true},{"text":"Eleazar ini og8izisibanin Matanan.","poem":2},{"lineBreak":true},{"text":"Matan ini og8izisibanin Tcekapan (Jacob).","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tcekap ini og8izisibanin Josepan,","poem":2},{"text":"mi ini Mani o8idigemaganibanin.","poem":3},{"lineBreak":true},{"text":"Mi aa Mani kagi nta8igiadjin Jesosan,","poem":3},{"lineBreak":true},{"text":"8in “Kije Manido ka pidjinija8adjin” kaijinikanagani8indjin.","poem":3}]},{"type":"verse","number":17,"content":["Midatcin acitc ni8in dac ki ani aianike nta8igi8ag ka ako tedj Abanaam (Abraham) pinici David. Mina8adj dac midatcin acitc ni8in inigik ki ani aianike nta8igi8ag ka ako tedj David pinici kidji odjitcisenig apitc kagi ijinija8agani8i8agobanen Israel a8iagog 8edi Babilon akikag. Mina8adj dac midatcin acitc ni8in ki ani aianike nta8igi8ag ka ako ijinija8agani8i8agobanen Israel a8iagog 8edi Babilon akikag pinici kidji nta8igindjin Jesosan, mi ini Kije Manido kagi ikidogobanen kidji pidjinija8agobanen."]},{"type":"heading","content":["Jesos ka nta8igidj"]},{"type":"verse","number":18,"content":["8adan adi ka ijiseg apitc Jesos Christ ka pi nta8igidj. Odjodjoman Manin aja ki iji pagidinimagani8inigoban Josepikag kidji iji niba8indjin. Ab8amaci dac madji 8idji tajikemidi8adj, abinodjijan ogi kigicka8an Mani, kagi minigodjin Mino Manidon."]},{"type":"verse","number":19,"content":["Kitci k8aiak8adizigoban aa nabe Josep, Manin ke iji 8idigemadjin. Apitc Josep ka kikendag Manin kidji otcidjicimindjin, ogi inendanaban kidji naganadjin, ka8in dac o8i ki8enija8asi8abanin meg8adj e kijigabamagani8idj, acitc ogi inendanaban kidji kimodji madjinija8adjin."]},{"type":"verse","number":20,"content":["Ka8in maci ododji onendasinaban adi ke inakamigizidj, apitc ka pi nda 8abamigodjin ka Tibendjigendjin odajenimini meg8adj e nibadj. Ajenin dac ogi igon: “Josep, kin David odanike ojisan, ka8in segiziken Mani kidji iji o8idigemaganian. Teb8e mega Mino Manidon ogi minigon kidji kigicka8adjin abinodjijan."]},{"type":"verse","number":21,"content":["Kada og8izisi. Jesos kiga ijinikana. Oga ag8aciman mega odanicinabeman adi ka iji patadindjin.”"]},{"type":"verse","number":22,"content":["Kakina dac ii ki iji8eban, 8eckadj kagi minapanin ka Tibendjigedj niganadjimo8innin kidji tibadjimondjin:"]},{"type":"verse","number":23,"content":[{"text":"“Ockinigik8e kada kigicka8aso.","poem":1},{"lineBreak":true},{"text":"Kada og8izisi.","poem":1},{"lineBreak":true},{"text":"Emmanuel kada ijinikazo8an.”Ésaïe 7.14","poem":1},"Emmanuel dac ikidomagan: “Kije Manido ki8idjiogonan.”"]},{"type":"verse","number":24,"content":["Apitc ka kockozidj Josep, mi ka inakamigizidj kagi igodjin ka Tibendjigendjin odajenimini. Ogi 8idigeman Manin."]},{"type":"verse","number":25,"content":["Ka8in dac ododji pamenimasi8an Manin, pinici kidji nta8igindjin og8izisini. Josep dac ogi 8inan ini abinodjijan, “Jesos” ogi ijinikanan."]}],"footnotes":[]},"thisChapterLink":"/api/alq_cbs/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alq_cbs/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}