{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"1JN","translationId":"alw_wtw","name":"ዎኔ ያህይ","commonName":"ዎኔ ያህይ","title":"ያህይ ከተቦሃ ዎኔ ሶህኑተ","order":62,"numberOfChapters":5,"sha256":"a98fc112d25b0619446a8f5dd626c76ae9e8f0ae4808894b51906667ca7624dc","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/alw_wtw/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["ሄእ ላገተ"]},{"type":"verse","number":1,"content":["ክልቀቲች ብርተ ዮ ሄእ ላገተኔ ሞጮጭኖሚሃ፥ እሌንተኔ ለዕኖሚሃ፥ አጥራመንት ለዕኖሚሃለከ አንጋንከኔ አንፎሚሃ ኩልናንክዕኔ።"]},{"type":"verse","number":2,"content":["ኩ ሄኡ ለልዮኡ፤ ነኡን ለዕኖም፤ መሰከርናም፤ ከኒች ብርተ አናከኔ መገን ቤቾን ዮኢሃለከ ኔሳሃ ለሌኢሃ ዘላለሚሃ ሄአኖ ሄእተኔሃ ኩልናንክዕኔ።"]},{"type":"verse","number":3,"content":["ኒን ሜጡበ ሜጦመት ሄኦህዕኔተ ለዕኖሚሃለከ ሞጮጭኖሚሃ ክዕኔንከ ኩልናንክዕኔ፤ ኒ ሜጦመት አነ መገኒንትለከ ቤትንከስ መሲህ ኢስን ሜጡባት።"]},{"type":"verse","number":4,"content":["ሙንዲኑኔ ዊመ እኮተ ካን ከተንባንክዕኔ።",{"noteId":0}]},{"type":"heading","content":["መገኑ ኑር እሁስ"]},{"type":"verse","number":5,"content":["ኢሲች ሞጮጭኖሚሁለከ ክዕኔሃ ኩልናም ሶህኑት ተኒት «መገኑ ኑር እኮቤቺሃ እስቤቾን ቱንስቹ ሆሮን ዮበአ» ይታእተ።"]},{"type":"verse","number":6,"content":["ህካን እኮቤቺሃ «መገኒን ሜጦመት ዮኔ» ይነን ቱንስች ኣዜን ሄዕኖም ጎሬ ክዝምባሚት ቤሉ ሀንቅን ሄዕኖምበአ ዩሃን።"]},{"type":"verse","number":7,"content":["ጠዉ እኮጎሬ እስ ኑሬን ሄዕዮገን ነኡ ኑሬን ሄዕኖም ጎሬ ገገዉንኩኔ ሜጦመት ሄኣኔ፤ ህትን ቤትስ ኢስ ቄጉ ጩብች ጉዕሚችን ነጠ አአኖኔ።"]},{"type":"verse","number":8,"content":["ህካን እኮቤቺሃ ነኡ «ጩቡ ዮኔበአ» ይኖምጎሬ ገዉኔ ሉስንሳሚት ቤሉ ሀንቁ ኒ ኣዜን ዮበአ።"]},{"type":"verse","number":9,"content":["ህትን ጩብኔ መገኒሃ ኩልኖሚች መገኑ አመዕነሞሃለከ ፈየ እኮቤቺሃ ጩብኔ ጉዕመንከ «ፈቁን» የኖ፤ ህትን ጩብችኔ ጉዕሚችን ነጠ አአኖኔ።"]},{"type":"verse","number":10,"content":["ነኡን «ጩብ አዕኖምበአ» ይናሚሃ እንኮምጎሬ መገኑ ክዝበኘ አዕናምት፤ ህትን መገን ላገንት ኒ ኣዜን ዮበአ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ሙንዲኑኔ፦ መት-መቱ ሉህ ክታበት «ሙንዲኑክዕኔ» ይታአ።","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/alw_wtw/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}