{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"1TI","translationId":"alw_wtw","name":"ዎኔ ጢሞትዎሴ","commonName":"ዎኔ ጢሞትዎሴ","title":"ጳዉሎስ ጥሞትዎሴሃ ከተቦ ሶህኑተ","order":54,"numberOfChapters":6,"sha256":"8ab496c0c77a043c8290c428b95a75614c43226c27c5684c9fae54b670304269","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/alw_wtw/1TI/6.json","totalNumberOfVerses":112},"chapter":{"number":3,"content":[{"type":"heading","content":["አመዕናኖ አዎንሳኖተኔሃ"]},{"type":"verse","number":1,"content":["«አዪሁ አመዕናኖ አዎንሳንቹ እሆተ ሀሾ ጎር ሎረ ሆጉተ ሃሸአኖት» ይታ ላገት ሀንቅሃን።"]},{"type":"verse","number":2,"content":["አመዕናኖ አዎንሳንቹንኩ ኩሌኖስ ጠዉ ዮስበኢሃ፥ መቴ መንቾተ ምኒ አነ እኮሃ፥ ጌሲን ሄአኖሃ፥ ገዉስ አገዕረኖሃ፥ ኬዕምኝስ አገዕረኖሃ፥ ኮሀ ቶገኖሃ፥ ተማርሲሃ አታለኖሃ፥"]},{"type":"verse","number":3,"content":["ሰከሪባሃ፥ ኡሙዕሪባሃ፥ ጎደበ ላፈ፥ ብተምባሃ፥ ብረ ኢትባሃ፥"]},{"type":"verse","number":4,"content":["ገይስ ምኒ አበሮሱ ጡመገ ገሾተ አታለኖሃ፥ እለስ አዘዘንታሲሃ፥ ጉዕመንከ አዲን ኬዕምሳሲሃ እሁ ሀስሰኖስ።"]},{"type":"verse","number":5,"content":["መሰንትስ መቱ መንቹ ምንስ ገሾተ አታልባች መገኑ አመዕኔ መነ ገሾተ ሀት አታለኖ?"]},{"type":"verse","number":6,"content":["ህትን እልቢስ አሌን ፈረደሞገን ቦኝያን አሌስ ፈረደመኖበእገ ሃዕሮ አመዕኔ መንቹ አዎንሳንቹ እሁንከ።"]},{"type":"verse","number":7,"content":["ህትን ሆፍኚንለከ ሻይጣን ዎሻድን ኣገኖበእገ አመዕንበ መንቤቾን ገለትጨሞኢሃ እሁ ሀስሰኖስ።"]},{"type":"heading","content":["ድያቆናከተኔሃ"]},{"type":"verse","number":8,"content":["ህትን ድያቆናከተ",{"noteId":0},"ኬዕምኙ ሀስሰኖሰረ፥ ለሙ ጠወኣበእረ፥ ዎይን ጠጂን ሰከርታበእረ፥ ብሪሃ ጎራይትበረ እሁ ሀስሰኖሰ።"]},{"type":"verse","number":9,"content":["ህትን አመዕነቲን ለሌ ሀንቅ ነጠ ቀልቢን ጠረኝስ አፉ ሀስሰኖሰ።"]},{"type":"verse","number":10,"content":["እሰንተ ሄጬን ፌተኔን ለኡ ሀስሰኖ፤ ህከኒች ኤተሮን ኩሌኖሰ ጠዉ ዮበእራ እኮኢች ዲያቆነ እኮተ አታልታአ።"]},{"type":"verse","number":11,"content":["ህትን ምንሰ አማኑት ኬዕምሴኖሰረ፥ ሄዕምታበእረ፥ ገዉሰ አገዕርታእረለከ ጉዕመርቾንን አመዕነንቶእራ እሁ ሀስሰኖሰ።"]},{"type":"verse","number":12,"content":["ህትን ዲያቆነት መቴ መንቾ ምኒ አነ እኮረ፥ ኦሱሰለከ አበሮሱሰ ጡመገ ገሽታእረ እሁ ሀስሰኖሰ።"]},{"type":"verse","number":13,"content":["መሰንትስ ዲያቆነት ጡመገ ሆጉተ አታእሩ ገይሀሰ አበ ኬዕምኝ ደእታአ፤ ህትን መሲህ ኢሲን ዮሰ አመዕነትተኔ ልግብ መለሉ ደእታአ።"]},{"type":"heading","content":["ማጠሞ ሎረ ምስጥርተኔሃ"]},{"type":"verse","number":14,"content":["ፎሊን ሄአኖ ዱእ ምኒ በላን መቱ መንቹ ሀት እክ ሄኡ ሀስሰኖሰ ጎሬ ሀት እክ ፈንቀላመኖ ጎር ደጋገ ከተቦንኬ፤ ሁኩ መገን ምኑንኩ ሀንቅ ቱቃለከ ቀበበ።"]},{"type":"verse","number":16,"content":["አመዕነትኔ ማጠሞ ጠዉ ሸክሲስበ ሎረሃን፤ እስን",{"text":"መንቹ እክ ለልዮእሃ፤","poem":1},{"text":"ሀንቅ እሁስ ጠሊለ አያኒን አዋጀሞእሃ፤","poem":2},{"lineBreak":true},{"text":"መላይካተ ለልዮእሃ፤","poem":2},{"text":"መኒሃ ጉዕሚንከ ዱዱብሰሞእሃ፤","poem":1},{"text":"ከን ኣዱንያ አል መኑ አመዕንዮስሃ፤","poem":2},{"lineBreak":true},{"text":"ኬዕምኚን ሰማሃ ኦሮዕዮእሃ።","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ድያቆናከ ሆጉት፦ አመዕናኑተ አዎንስታ ባልቀተ ሀዕልታእራን።","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/alw_wtw/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}