{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"HEB","translationId":"alw_wtw","name":"እብራውያን","commonName":"እብራውያን","title":"እብራውያን መኒሃ ከተበሞ ሶህኑተ","order":58,"numberOfChapters":13,"sha256":"2e2e9ba298f929bee9dba74dfa474995bb22459a5dd44fb88784aec3d4e45731","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/alw_wtw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["መገኑ ቤትስ አዲን ጠወዕዮገ"]},{"type":"verse","number":1,"content":["ብሬ ዘማኔን መገኑ ልግብ አደደ እኮ ዎቃን አበናኖተኔ ነብያኖ አዲን ልግብ ወክት ጠወዕዮ እቅ።"]},{"type":"verse","number":2,"content":["እኮጎሬ ከን መጨረሽ ዘማኔን ጉዕመንከ ረገአኖሃ አዕዮስ ቤትስ አዲን ኔሳሃ ጠወዕዮኔ። ህትን ጉዕመንከ ከለቆሁ እስ አዲንት።"]},{"type":"verse","number":3,"content":["ቤቱስ መገን ኬዕምኝ ለሊሰኖሃን፤ እስን ዊመ ዊሚን መገኑ አጉደኖሃን፤ ወልቀት ዮ ላጋንከስ ጉዕመንከ ድክሽ አፎኡ፤ ህትን መነ ጩቢች ነጠ አዕዮች ኤተሮን ሎረ መገን መኬ አዲን ሰማን አፉዕልዮኡ።"]},{"type":"heading","content":["ኢስ መላይካች ሎረ እሁስ"]},{"type":"verse","number":4,"content":["መገን ቤቱ መላይከ ሱዕሚች ሎሩ ሱዕሙ ኣሰሞስ ሃሊን እሳች በትሽ በተዕዮሃ እኮ።"]},{"type":"verse","number":5,"content":[{"text":"መሰንትስ መገኑ መላይካችስ መቲሀሲ","poem":1},{"lineBreak":true},{"text":"«አት ቤቱሃኤ፤ አን አናክ»","poem":1},{"lineBreak":true},{"text":"ህከረንገ","poem":1},{"lineBreak":true},{"text":"«አን አነ እሃንስ፤ እሲሁ ቤቱእ እሀኖ»","poem":1},{"text":"ዬኢሁ አዬህት?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ህትን ሀንገፈ ቤቱስ ኣዱንያ አል ኤቦ ወክት","poem":1},{"lineBreak":true},{"text":"«መገን መላይከት ጉዕሙንኩ እሲሃ ሰገዶስተ» ሀስሰኖ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"እኮጎሬ መላይከተኔሃ ጠወአን","poem":1},{"text":"«መላይከስ ቦብረ፥ ካዲመተ ጊረ ለበነተ አአኖ» የኖ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጠው እኮጎሬ ቤትስተኔሃ፤","poem":1},{"lineBreak":true},{"text":"«መገኖ! ዳኞመክ ቦርጭመት ዘላለሚሃ ሄኣአ።","poem":1},{"text":"ዎምነቶንከክ ጡመገ አት ገሽታንት፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ፈዩተ ኢትት ሂለ ጠወ ግቦንት፤","poem":1},{"lineBreak":true},{"text":"ህከን መሳን መገኑ መጠሮሄ፤","poem":1},{"lineBreak":true},{"text":"ሙንዲኑተ ኣሰኖ ዘይተ ቡር ጃላችክ በትሽ ኢቴሄ» የኖ።","poem":1}]},{"type":"verse","number":10,"content":["ቴሁ ቤትስተኔሃ ህት የኖ፤",{"text":"«ቀርቾ! አት ሄጭት ኡለተ ከለቆንት፤","poem":1},{"text":"ሰሞንኩ አንገክተ ሆጉ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሰ ጉዕሙንኩሰ በኣአ፤","poem":1},{"lineBreak":true},{"text":"እኮጎሬ አት ሄኣንት፤","poem":1},{"text":"እሰ ጉዕሙንኩሰ ኦድኖገ ኑባጵታአ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቡሉኮገን ጣጣንትሰ፤","poem":1},{"text":"እሰ ኦድኖገን ዶረንታአ።","poem":2},{"text":"2 አት ጉዕመ ወክትንከ አቴት፤","poem":1},{"lineBreak":true},{"text":"ዘማኑክ ሆሮ ጎፈኖበአ» የኖ።","poem":1}]},{"type":"verse","number":13,"content":["ጠው እኮጎሬ መገኑ መላይከ በሊች፤",{"text":"«ባለጋረክ ሎካችክ ዎሮን አኦተ ኢለ","poem":1},{"lineBreak":true},{"text":"መኬእ አዲን አፉዕል» ዬኢሁ አዬት?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ህከረ መላይከት ጉዕሙንኩ ጡሙ ደእታ መነ ካደንቶተ ሶሀንቶ አያናከተበእንዶ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/alw_wtw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}