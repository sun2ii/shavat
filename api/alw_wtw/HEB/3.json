{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"HEB","translationId":"alw_wtw","name":"እብራውያን","commonName":"እብራውያን","title":"እብራውያን መኒሃ ከተበሞ ሶህኑተ","order":58,"numberOfChapters":13,"sha256":"2e2e9ba298f929bee9dba74dfa474995bb22459a5dd44fb88784aec3d4e45731","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/alw_wtw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":3,"content":[{"type":"heading","content":["ኢስ ሙሲች ሎረ እሁስ"]},{"type":"verse","number":1,"content":["ህካን እኮቤቺሃ ሰሜ ጄነትሃ ገአንቴን ቤቀማኑተ እኬንተ ጠሊላኑት አመኤ ኦሶ! ጠወዕናም አመዕነት ሎረ ቂስቹ እሆተ መገኒን ሶሀሞ ኢሰ ሰዉ ይዬ።"]},{"type":"verse","number":2,"content":["ሙስ ዱእ ምኒ ሆጎን ጉዕማን አመዕነሞኢሃ እኮገን ኢሲሁ እሱ ሾሞስ መገኒሃ አመዕነሞእሃ እቅ።"]},{"type":"verse","number":3,"content":["ምኒ እጃረኖሁ ምኒች ሎሩ ኬዕምኙ ሄአኖስሀንገን ኢሲሃ ሙስ ኬዕምኚች በተአኖ ኬዕምኙ ሀስሰኖስ።"]},{"type":"verse","number":4,"content":["መሰንትስ ምኒሃ ጉዕሚንከ መቱ እጃረኖሁ ሄአኖ፤ ጠዉ እኮጎሬ ጉዕመርቹንከ እጃሮሁ መገኑሃን።"]},{"type":"verse","number":5,"content":["ሙስ ከ ኤተሩ ኩለመኖ ጠዊሃ ምስክር እሆተ መገን ምኔን ጉዕማን ካድንችገ እክ አመዕነሞእሃ እቅ።"]},{"type":"verse","number":6,"content":["መሲህ መገን ምኔን ጉዕማን ሹምነቱ ኣሰሞስ ቤትገ አመዕነሞሃ እቅ፤ ነኡን አመዕንናምለከ ድከዕናም ተብሳሃ ኤተሩ ኢለ ጠረኝንስ አንፎምጎሬ እስ ምኒ እንካም።"]},{"type":"heading","content":["መገን ኡመቲሃ ኣሰሞ አገዕርተኔሃ"]},{"type":"verse","number":7,"content":["ህካን እኮቤቺሃ ጠሊሉ አያኑ",{"text":"«ከበር ላገስ ሞጮጭቴነን","poem":1}]},{"type":"verse","number":8,"content":[{"text":"አዕኑ ኡለ ኡድማን ፌተንቴንተኤ ወክት አበናኑክዕኔ ሾክቶኤገን","poem":2},{"lineBreak":true},{"text":"ቀልብክዕኔ ዱድሶኖቼ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህከኔን አበናኑክዕኔ ፌተንቶኤሁ፥ አሙዕርሲሶኤሁ፤","poem":1},{"text":"አዕዮምርቹንከ ሸይሉ ዘማን ለኦኡ» የኖ መገኑ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«ህካን እኮቤቺሃ አን ህከን ዘማን መናን ኡሙዕሬም፤","poem":1},{"text":"‹ጉዕመ ወክት ቀልቡሰ ሉጨሞእሃ፥","poem":2},{"lineBreak":true},{"text":"ዎቃንከኤ ደግበረሁ› ዬም።»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አንን አሙዕሬን","poem":1},{"lineBreak":true},{"text":"«‹እሰ ኢ ፎሎጭቤቹ ሆሮ ኣጋባአ› ይ","poem":1},{"text":"ጤሌዕሌም።»","poem":2}]},{"type":"verse","number":12,"content":["ኢ ጃላ! ዘላለሚሃ ሄአኖ መገኑ ለገእሲሰኖ ሂሉ አመዕንቡ ቀልቡ ክዕኔኤች አዬሃ ሄአኖበእገ አገዕርዬ።"]},{"type":"verse","number":13,"content":["እኮጎሬ ክዕኔኤች አዪሁ ጩቢን ጣንሰም ቀልብስ ዱድሱዕነ «ከበር» የመሞ በሩ ጎፉዕነ ጉዕመ ወክት ገገዉክዕኔ አማዕለሜ።"]},{"type":"verse","number":14,"content":["ወዕና ሄዕዮኔ አመዕነቱ መጨረሸ ኢለ ጠረኝንስ አንፎምጎሬ መሲህን ሜጡበ ቤቀማምረ እንካም።"]},{"type":"verse","number":15,"content":["ከኒች ብርተ",{"text":"«ከበር ላገስ ሞጮጭቴነን","poem":2},{"lineBreak":true},{"text":"ህከ ወክት አበናኑክዕኔ ሾክማን አቶገን ቀልብክዕኔ ዱድሶኖቼ»","poem":2},"የመም ከተበሞጋት።"]},{"type":"verse","number":16,"content":["ላገስ ሞጮጭት ሾክቶእሩ አዬኤታን? ሙስ አዎንስ ግብጽ ባዲች ፉሼሰሩ ጉዕማንከሰበእንዶ?"]},{"type":"verse","number":17,"content":["ሸይሉ ዘማን ዊመ መገኑ አሙዕርስሶሩ አዬኤታን? ጩብ አቶቤቺሃ ጀናዘሰ ኡለ ኡድማን ፈቆእረበእንዶ?"]},{"type":"verse","number":18,"content":["ህካን እኮቤቺሃ አዘዘንቶበእ መን ቤሉ «ፎሎጭኤ ቤቹ ኣጌነንተበአ» ይ መገኑ ጠሌዕሌሰሩ አዬኤታን?"]},{"type":"verse","number":19,"content":["ቴሁ እሰ አመዕኑ ሆጎ መሳን ፎሎጭቤቹ ኣጎተ አታሉ ሆጉሰ ደንጋም።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/alw_wtw/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}