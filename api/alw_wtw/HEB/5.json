{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"HEB","translationId":"alw_wtw","name":"እብራውያን","commonName":"እብራውያን","title":"እብራውያን መኒሃ ከተበሞ ሶህኑተ","order":58,"numberOfChapters":13,"sha256":"2e2e9ba298f929bee9dba74dfa474995bb22459a5dd44fb88784aec3d4e45731","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/alw_wtw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ጉዕሙንኩ ሎሩ ቂሰት መን በሊች መጠረንታአ፤ ጩብ አቶ መን ወጥ መገኒሃ ክትምለከ ሰደቀ ሆንጠህሲሃ መገኒን መጠረንቶእረ።"]},{"type":"verse","number":2,"content":["ሁኩ ቂስቹንኩ ሆጎሃ እኮቤቺሃ ገዋኑተለከ ሉሳእረ መረርስጮተ አታለኖ።"]},{"type":"verse","number":3,"content":["እስ ገውንኩስ ሆጎሃ እኮቤቺሃ ኡመት ጩቢሃ ጠለዕል እሁዕናን ገይስ ጩቢሃለከ መን ጩቢሃ ክትመ ሆንጠህሱ ሀስሰኖስ።"]},{"type":"verse","number":4,"content":["ሀሩንገ መገኒን ገአምባች ሎረ ቂሰ እህ ኬዕምኝ አዪሁ ደኦተ አታለኖበአ።"]},{"type":"verse","number":5,"content":["ህትን መሲህ ሎረ ቂስቹ እሆተ ገዉስ ሎሪስዮበአ፤ ጠዉ እኮጎሬ ህከ ሎርመተ ደኤኢሁ",{"text":"«አት ኢሃ ቤቱ፤","poem":1},{"text":"አንን ከበር እሎንኬ» ዬ መገኒችት።","poem":2}]},{"type":"verse","number":6,"content":["ህትን መገኑ ዎሎ ቤቾን",{"text":"«አት መልከ-ጼዴቄገ ቂሶመ ሹምነትገ","poem":1},{"text":"ዘላለሚሃ ቂሰሃን» የኖ።","poem":2}]},{"type":"verse","number":7,"content":["ኢስን መንቹ እክ ዱንያ አሌን ሄዕዮ ዘማኔን ሬሆች ፌሶስተ አታለኖ መገን ቤቹ አበ ያረናንለከ እንጂጃን አበ ዱአ አዕዮ፤ ኢስን መገኑ ዋጀኖሃ እኮቤቺሃ ዱኡስ ሞጮጨሞ።"]},{"type":"verse","number":8,"content":["እስን መገን ቤቱ እክ ኦርሸ ኣዝን ህጎጎሬሁ ህከ ቶጎ ኦርሻች አዘዘሙ ተማሮ።"]},{"type":"verse","number":9,"content":["እስን ኩሌኖስርቹ ዮበኢሃ እክ አዘዘንታስሀኑኡተ ጉዕሚንከ ዘላለም ጡሚሃ መሰተ እኮሰ።"]},{"type":"verse","number":10,"content":["መገኑ ኢሰ መልከ-ጼዴቄ ቂሶማ ሹምነትገ ሎረ ቂስቹ አዕዮስ።"]},{"type":"heading","content":["መኑ አመዕነቱሰ አጉርታበእገ ኣሰንቶ ሸዘነተ"]},{"type":"verse","number":11,"content":["ከን ጠውተኔሃ ልግቡ ጠወዕናም ጠዉ ዮኔ፤ ጠዉ እኮጎሬ ቴሱ ገበንቺን ተማሩ ሆጌንተቤቺሃ ሂሬን ክዕኔሃ ኩሉ ኦርሸተ።"]},{"type":"verse","number":12,"content":["ከ ወክት ኢለ አስተማረተ እኬንታ እቅ፤ እኮጎሬ መቱ መንቹ መገን ላገ ዎኔ ትምርቲሃ ክዕኔሃ ለንኪሃ ተማርሱ ሀስሰኖ፤ ህትን እሰገን ጠረኘ እቸተ እሁዕነ አዙት ሀስሳህዕኔ።"]},{"type":"verse","number":13,"content":["መሰንትስ አዙተ አዎንሱ ጉዕሙንኩ ኦሶተ እኮቤቺሃ ጡመርቹ ሂለርቺች አደ አዕይ ደገኖበአ።"]},{"type":"verse","number":14,"content":["ጠረኘት እቸት ሀሲሳኢሁ ጡመለከ ሂለ አደ አዕይ ደገኖ ሎርሎረ መኒሃት።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/alw_wtw/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}