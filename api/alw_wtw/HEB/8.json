{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"HEB","translationId":"alw_wtw","name":"እብራውያን","commonName":"እብራውያን","title":"እብራውያን መኒሃ ከተበሞ ሶህኑተ","order":58,"numberOfChapters":13,"sha256":"2e2e9ba298f929bee9dba74dfa474995bb22459a5dd44fb88784aec3d4e45731","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/alw_wtw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["ኢስ ሃዕሮ ወኣድ ላገ ሎረ ቂሰ ሀለቀ እሁስ"]},{"type":"verse","number":1,"content":["ቴሁ ጠወዕኖም ጠዊች ቡዕሉስ ከኒት፤ ሁኩንን ጉዕሚች ሎረ እኮ መገን ዎመ ቦርጭመ መኬ አዲን ሰማን አፉዕሌ ህትናሙ ሎሩ ቂሰ ሀለቁ ዮኔ።"]},{"type":"verse","number":2,"content":["እስ ሀንቅ ዱካነ እኮ ዱእ ምኒ ኣዜን ቂሰ ሀለቀ እክ ካደመኖሃን፤ ዱካኑስ መን አንጋን እሁዕነ ቀርች አንጋን ካሰሞእሃን።"]},{"type":"verse","number":3,"content":["ሎሩ ቂሰ ሀለቀት ጉዕሙንኩ ሾመንታኢሁ መገኒሃ ሰደቀለከ ክትመ ሆንጠህሲሃት፤ ህካን እኮቤቺሃ ከን ቂስቺሃ ክትሚ ሆንጠህሴኖ መቱርቹ ሄኡ ሀስሰኖስ።"]},{"type":"verse","number":4,"content":["እስ ኣዱንያ አሌን ሄዕዮእቃን ቂስቹ እሀኖበአ እቅ፤ ሁኩንን ሕግጊን መገኒሃ አኤኖርቹ ሆንጠህሳ ዎሉ ቂሰት ሄኦቤቺሃት።"]},{"type":"verse","number":5,"content":["እሰ አቶኢሁ ሰማን ዮኢሃ ምሳልተለከ ሀላሃ እኮሀን ኣዜኒት እቅ፤ ሁኩን እኮሁ ሙስ ዱካነ መክሶተ ቅጥዬ ወክት መገኑ «ቆተ አሌን ለሌሄ ሃሊን ጉዕመርቹንከ አገርት አእ» ይ አዘዦስጋት።"]},{"type":"verse","number":6,"content":["ቴሱ እኮጎሬ ኢስ በል መንቹ እኮ ወኣድ ላገተ ኑባቾ ወኣድ ላጋች ሎረ እኮቤቺሃለከ ቆሀኖ ወኣድ ላጋን ጀመረሞሃ እኮቤቺሃ እሲሃ ኣሰንቶ ሆጉት ሎረታን።"]},{"type":"verse","number":7,"content":["ዎዕኔ ወኣዴን ሉጨንሹ ዮበእቃን ለንክ ወኣድ ላገት ሀሲሳሰበአ እቅ።"]},{"type":"verse","number":8,"content":["መሰንትስ ቀርቹ መገኑ እሳን ሉጨንሸ ደግ",{"text":"«ቴሱ አን እስራኤልለከ አይሁድ ባድ መኒን","poem":1},{"text":"ሃዕሮ ወኣድ ላገተ ኣጋም ወክቱ አሜተኖ» የኖ ቀርቹ።","poem":2}]},{"type":"verse","number":9,"content":["ኩ ወኣድ ላገተ አን ግብጽ ባዲች ፉሾሰተ አንገሰ አፎም በር አበናኖንከሰ ኣጎም ወኣድ ላጋ ደነበአ፤ መሰንትስ እሰ ኢ ወኣድ ላገተ ጠረኝት ሄኡ ሆጎቤቺሃ አጉሮንሰ።"]},{"type":"verse","number":10,"content":[{"text":"«ህከን ዘማኒች ኤተሮን እስረኤል መኒሃ","poem":1},{"text":"ኣጋም ወኣድ ላገት ተኔት ይ ጠወዕዮ ቀርቹ፤","poem":2},{"text":"ኢ ሕገንከ ቀልቤንከሰ አኣም፤","poem":1},{"text":"ወዘናንከሰን ከተባም፤","poem":2},{"lineBreak":true},{"text":"አነሰ መገኑ እሃም፤","poem":2},{"lineBreak":true},{"text":"እሰን ኢ ኡመት እካአ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እሳችን አዪሁ ዎሉ መነሃ","poem":1},{"text":"አመስቤቱ ‹መገኑ ደግ› ይ ተማርሰኖስበአ፤","poem":2},{"text":"መሰንትስ ቀዊች ኬሽ ሎረ ኢለ ጉዕሙንኩ","poem":1},{"text":"ኤሳሃ ደጋኤ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አን እሰ ሂልመተ አጉረንሰ፤","poem":1},{"text":"ጩብሰን ለንኪሃ ሰውያምበአ» የኖ ቀርቹ።","poem":2}]},{"type":"verse","number":13,"content":["ቴሱ «ሃዕሮ ወአድ ላገተ» የኖ ወክት ወዕኔ ወኣድ ላገተ ኑባቹ አዕዮኡ ዩሃን፤ ህካን እኮቤቺሃ ኑባጴኢሁ በአኖ ወክቱ ኢልዮኡ ዩሃን።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/alw_wtw/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}