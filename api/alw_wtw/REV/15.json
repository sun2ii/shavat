{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"REV","translationId":"alw_wtw","name":"ያህይ ለዕዮ መናመተ","commonName":"ያህይ ለዕዮ መናመተ","title":"ያህይ ለዕዮ መናመተ","order":66,"numberOfChapters":22,"sha256":"feccf161853179a8c18590d350b1188b544378fb98c9143faf6cc61bcdd6d882","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/alw_wtw/REV/22.json","totalNumberOfVerses":403},"chapter":{"number":15,"content":[{"type":"heading","content":["መጨረሽ በለተ አፎ መላይከተ"]},{"type":"verse","number":1,"content":["ዎሉ አጀብሲሰኖ መላተ ሰማን ለዕዮም፤ ሁኩንን መገን ኡሙዕርት ጎፋ መጨረሽ ለመለ በለተ አፎ ለመለ መላይከተ ለዕዮም።"]},{"type":"verse","number":2,"content":["ህከኒች ኤተሮን ጊራን ልቀለቀሞ ለአቃንች ባረ አጉደኖሃ ለዕዮም፤ ህትን ቡሳውችለከ ቡሳውች ምስለ፥ ሱዕምስ ዎሊንሽ መላተ ድለ አቶረ ለዕዮም፤ መገኑ ኣሴሰ ክራረ አፍ ህከን ቡርጩቅ ባር መዴን ኡርቶኢሃ ለዕዮም።"]},{"type":"verse","number":3,"content":["እሰን መገን ካድንቾ ሙስ መዝሙረለከ ሆልች መዝሙረ",{"text":"«ጉዕመንከ አታልታንት ቀርቾ መገኖ!","poem":1},{"text":"ሆጉክ ሎረተለከ አጀብሲሳእታን፤","poem":2},{"text":"ጉዕማንከ ኡመት ዎመ!","poem":1},{"noteId":11},{"text":"ዎቆክ ጌጥዬሃለከ ሀንቅሃን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቀርቾ! ኬሳሃ ዋጅባሁለከ","poem":1},{"text":"ሱዕመክ ከበጅባሁ አዬት?","poem":2},{"lineBreak":true},{"text":"መሰንትስ ጠሊሉ ጠለዕል አቴት፤","poem":2},{"text":"ሀንቅ ፍርዱክ ለሌቤቺሃ","poem":1},{"text":"ኡመቱ ጉዕሙንኩ አሜች ብሬንከክ ሰገዳአ» ይተን ዘመርታ እቅ።","poem":2}]},{"type":"verse","number":5,"content":["ህከኒች ኤተሮን ምስክር ዱካኑ ሁኩንን መገን ምኑ ሰማን ፈንተዕያን ለዕዮም።"]},{"type":"verse","number":6,"content":["ህከ ለመለንከ በለተ አፎ ለመሉንኩ መላይከት መገን ምኒች ፉልቶኡ፤ ነጠተ በለቃ ዋጁተ ኦድኑተ ኦደኦ እቅ፤ ወዘነሰ ዎርቅ ቀበቶን ቆዕርቶ እቅ።"]},{"type":"verse","number":7,"content":["ሾሎንከ ክልቀቲች መቱ ለመለንከ መላይኬቺሃ ዘላለሚች ዘላለመ ኢለ ሄአኖ መገን ኡሙዕርት ዊንቶ ለመለ ዎርቅ ጠበትተ ኣሴሰ።"]},{"type":"verse","number":8,"content":["መገን ኬዕምኚችለከ ዎልቃች ፉልታ ዉሊልት ዱእ ምኒ ዊሞ፤ ሁኩ ለመሉንኩ መላይከት አፎ ለመሉንኩ በለት እሆተ ኢለ አዪሁ ዱእ ምኒ ኣጎተ አታሎበአ።"]}],"footnotes":[{"noteId":11,"caller":"+","text":"ኡመት ዎመ፦ መት-መቱ እንክለንቶሩ «ዘማናከ ዎመ» ይታአ።","reference":{"chapter":15,"verse":3}}]},"thisChapterLink":"/api/alw_wtw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}