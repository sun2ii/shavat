{"translation":{"id":"alw_wtw","name":"ሃዕሮ ወኣድ መጻፈ","website":"https://ebible.org/Scriptures/details.php?id=alw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=alw","licenseNotes":null,"shortName":"WTW","englishName":"Alaba-K’abeena NT","language":"alw","textDirection":"ltr","sha256":"df1593dab32c5f4d7ce1648e97397eed31570267c01fad8d5d09ce5e4e67301d","availableFormats":["json"],"listOfBooksApiLink":"/api/alw_wtw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Alaba-K’abeena","languageEnglishName":"Alaba-K’abeena"},"book":{"id":"REV","translationId":"alw_wtw","name":"ያህይ ለዕዮ መናመተ","commonName":"ያህይ ለዕዮ መናመተ","title":"ያህይ ለዕዮ መናመተ","order":66,"numberOfChapters":22,"sha256":"feccf161853179a8c18590d350b1188b544378fb98c9143faf6cc61bcdd6d882","firstChapterNumber":1,"firstChapterApiLink":"/api/alw_wtw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/alw_wtw/REV/22.json","totalNumberOfVerses":403},"chapter":{"number":5,"content":[{"type":"heading","content":["መጻፈለከ ሆልችተኔሃ"]},{"type":"verse","number":1,"content":["ጄነት ቦርጭማን አፉዕሌሀን መኬ አንጋን ኣዝ አዲንለከ አብል አዲን ከተቤመ ለመለ ማተቢን አሸጌመ ጣጠሞ መጻፈ ለዕዮም።"]},{"type":"verse","number":2,"content":["መቱ ጠረኙ መላይኬቹ ሎረ ላጋን «ከ ማተበ ፊሎተለከ ጣጠሞ መጻፈ ፈኖተ ሀስሰኖሲሁ አዬት?» የን አዋጀኖሃ ለዕዮም።"]},{"type":"verse","number":3,"content":["ጠዉ እኮጎሬ ሰማን፥ ኡላንለከ ኡላች ኣዚን ጣጠሞ መጻፈ ፈኖተ ህከረንገ ኣዝስ ለኦተ አታሎሁ አዪሁ ደገሞበአ።"]},{"type":"verse","number":4,"content":["አንን ጣጠሞ መጻፈ ፈኖተ ህከረንገ ኣዝስ ለኦተ አታለኖሁ ደገሙሆጎቤቺሃ አበ ኦዕዮም።"]},{"type":"verse","number":5,"content":["ህከ ወክት ባልቃች መቱ «ኦኦት! ይሁድ ዘሬች ደዉዴ ደቦች እኮሁ ድለ አዕዮቤቺሃ ጣጠሞ መጻፈለከ ለመለንከ ማተበ ፈኖተ አታለኖ» ዬኤ።"]},{"type":"verse","number":6,"content":["ህከኒች ኤተሮን ኬዕምኝ ቦርጭመ በላን ሾሎንከ ክልቀትለከ ለሞድምኔ ሾሎንከ ባልቀ በላን ጎረጠሞሃ አጉደኖ ሆልቹ ኡሬኢሃ ለዕዮም፤ ሁኩ ሆልቹ ለመሉ ቡዱለከ ለመልት እልት ሄኦስ እቅ፤ እሰን ኣዱንያ አል ጉዕመንከ ሶሃንቶ መገንየ አያነ እቅ።"]},{"type":"verse","number":7,"content":["እስን አሜች ኬዕምኝ ቦርጭማን አፉዕሌሀኒች መኬስ አንጋች ጣጠሞ መጻፈ ኣኤእ።"]},{"type":"verse","number":8,"content":["ጣጠሞ መጻፈ ኣኤ ወክት ሾሉንኩ ክልቀቱለከ ለሞድምኔ ሾሉንኩ ባልቀት ሆልች ብሬን ሚኔንከሰ ጎምብሰንቶኡ፤ ጉዕሙንኩሰ ክራረ አፎ እቅ፤ ህትን ጠሊላኖ ዱአ እኮ ህጣነ ዊሞ ወርቅ ኦደተ አፎ እቅ፤"]},{"type":"verse","number":9,"content":["እሰን ሃዕሮ መዝሙረ",{"text":"«ቄጊንከክ ደቦች፥ አደደ አፎ ጠወኣ መኒች","poem":1},{"text":"ቦክችለከ ኡመቲች","poem":2},{"text":"መነ መገኒሃ ዎዚሃ","poem":1},{"lineBreak":true},{"text":"አት ጎረጠንቶንትቤቺሃ","poem":1},{"text":"ጣጠሞ መጻፈ ኣኢሃለከ","poem":2},{"lineBreak":true},{"text":"ማተበ ፈኒሃ በቀኦንቲሃ እኮንት፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መገኒሃኔ ቂሰተለከ ዎመ","poem":1},{"text":"እካገ አቶንትሰ፤","poem":2},{"lineBreak":true},{"text":"ኡለ አሌን ዎመ እካአ» ይተን ዘመርቶኡ።","poem":2}]},{"type":"verse","number":11,"content":["ህከ ቤቹ ለዕዮም ወክት ኬዕምኝ ቦርጭመተ፥ ክልቀትለከ ለሞዱምኔ ሾሉንከ ባልቀተ ዘህ ልግቤ መላይከ ላገተ ሞጮጬም፤ በትኝሰን ዎለኤን አታሌንበ ጌሰ እቅ።"]},{"type":"verse","number":12,"content":["ሎረ ላጋኒን",{"text":"«ጎረጠሞ ሆልቺሃ ወልቀት፥ ቀባጡት","poem":1},{"lineBreak":true},{"text":"ሀይመተ፥ ጠረኝመተ፥ ሎርመተ፥ ኬዕምኝለከ","poem":1},{"lineBreak":true},{"text":"ገለት ቶጊሃ ሀስሰኖስ» ይቶኡ።","poem":1}]},{"type":"verse","number":13,"content":["ህትን ቴሱ ሰማንለከ ኡላን፥ ኡለች ኣዝ አዲንለከ ባር ኣዚን ጉዕመ ቤቾንን ዮ ክልቀቱ ጉዕሙንኩ",{"text":"«ኬዕምኝ ቦርጭማን አፉዕሌሀኒሃለከ ሆልቺሃ","poem":1},{"lineBreak":true},{"text":"ገለቱ፥ ሎርመት፥ ኬዕምኙለከ ዎልቀት","poem":1},{"lineBreak":true},{"text":"ዘላለሚሃ እሲሃ እሁን» ይተን ሞጮጬም።","poem":1}]},{"type":"verse","number":14,"content":["ሾሉንኩ ክልቀቱ «ኣሚዕን!» ይቶኡ፤ ህትን ለሞድምኔ ሾልት ባልቀት ሚኔንከሰ ጎምብሰንት ሰገዶኡ።"]}],"footnotes":[]},"thisChapterLink":"/api/alw_wtw/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/alw_wtw/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/alw_wtw/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}