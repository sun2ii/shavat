{"translation":{"id":"amf_sim","name":"Haalin Mallano","website":"https://ebible.org/Scriptures/details.php?id=amf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amf","licenseNotes":null,"shortName":"SIM","englishName":"Banna NT","language":"amf","textDirection":"ltr","sha256":"5c8c789d2f35ec4c50ec9a79061a12f1a16365e12996d1fb498e93eef6150c7c","availableFormats":["json"],"listOfBooksApiLink":"/api/amf_sim/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7839,"languageName":"Hamer-Banna","languageEnglishName":"Hamer-Banna"},"book":{"id":"HEB","translationId":"amf_sim","name":"Ibra","commonName":"Ibra","title":"Ibra Eenana Thaapadhoono Warqanno","order":58,"numberOfChapters":13,"sha256":"1e5811b9bacc9300b1b06bf63e4493194785c5c3897d3032c10a3a66afd1e8bc","firstChapterNumber":1,"firstChapterApiLink":"/api/amf_sim/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/amf_sim/HEB/13.json","totalNumberOfVerses":301},"chapter":{"number":1,"content":[{"type":"heading","content":["Barjo Yisa Naasaka Kinin Giyoono"]},{"type":"verse","number":1,"content":["Barjo ena wodanka waana waana goytika Barjokala qansayse eenna giyaynaka wosa eykenana thoothi wodana giydine."]},{"type":"verse","number":2,"content":["Taaki macchin wodan koka yer wulsa toydi maataa yisa Naasaka wona giydine. Barjoar yer wulam kinin pijoono Naasa yintea goynkane."]},{"type":"verse","number":3,"content":["Kidi yinti Barjo gobshinsa shaakane; kidi yisa dantanka Barjo Imbaabesana kalaane. Yisa kantan upsinka pijadhin wulam keedhayse ki yedade. Eenaamaar kesa seesora yinin gazinsonsa budonte cecinte wuldara gobshinka sagi maataa Barjosa mizaqimbar ki dooqade."]},{"type":"heading","content":["Yesus Barjosa Gaananadara Kinin Sagayno"]},{"type":"verse","number":4,"content":["Barjo Naasana imbhoono naabeno Barjo gaananasa naabendara kattsi sagine; ogodettsi kidi kedara sagine."]},{"type":"verse","number":5,"content":["Harrna hambhidianna, Barjo yisa gaananasa kalaana",{"text":"“Ya isa Naasine;","poem":1},{"lineBreak":true},{"text":"inta haam kina adhidine”","poem":1},"pir,",{"text":"“Inta kisa Imba ida maate;","poem":1},{"lineBreak":true},{"text":"kidiar isa Naasi kida maate”","poem":1},"hamayse kinin giyaa hayne?"]},{"type":"verse","number":6,"content":["Pir Barjo biraa Naasa yinteam peendar yinin nittsenka,",{"text":"“Barjosa gaanana wul kumpurdhayse kina ke goodime”","poem":1},"ki hamade."]},{"type":"verse","number":7,"content":["Barjo yisa gaananaka",{"text":"“Isa gaananaam wuradettsi ida haye;","poem":1},{"lineBreak":true},{"text":"ina waadimaynaamaar nuusa laabhinadettsi ida haye”","poem":1},"ki hamade."]},{"type":"verse","number":8,"content":["Yisa Naasaka ko hanna,",{"text":"“Barjo, hasa bitamon borkotono rooro wul lay koda dee;","poem":1},{"text":"hasa eenaam tipamoka hada wottse.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tipamon waadimanam nashayse siyon waadimanam ha jibbade.","poem":1},{"lineBreak":true},{"text":"Ogo goynka hasa Barjoa haam kamayse hasa aanammadara kattsi sagi hayayse haam wozisen zaytinka ki qadhade”","poem":1},"ki hamade."]},{"type":"verse","number":10,"content":["Yin pir,",{"text":"“Imbo, ya ena birayse peenam ha pijade;","poem":1},{"text":"cecinoar hasa aanin waadimanone.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Igina kaya ke kaye;","poem":1},{"text":"ya rooro wul daada dee.","poem":2},{"text":"Kedi wul apaladettsi keda gecche;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"apaladettsiar keam hada umbhuse;","poem":1},{"text":"apaladettsiar ookaada ooke.","poem":2},{"text":"Yaar rooro wul lay ookimattane;","poem":1},{"text":"hasa levensa macchi qolehe”","poem":2},"ki hamade."]},{"type":"verse","number":13,"content":["Barjo gaananasa kalaana",{"text":"“Haam jibbaynaam hasa hayamon demente inin hayenka yekka isa mizaqinte dooqaa”","poem":1},"hamayse kinin giyaa hayne?"]},{"type":"verse","number":14,"content":["Ta keeda gaanana wul Barjoyn dhacchaynaam kenin kelshoadettsi nittsadhayna Barjona waadadhayna manpasinatayu?"]}],"footnotes":[]},"thisChapterLink":"/api/amf_sim/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amf_sim/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amf_sim/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}