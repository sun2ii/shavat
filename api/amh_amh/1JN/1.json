{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"1JN","translationId":"amh_amh","name":"1ኛ የዮሐንስ መልእክት","commonName":"1ኛ የዮሐንስ መልእክት","title":"1ኛ የዮሐንስ መልእክት","order":62,"numberOfChapters":5,"sha256":"91438ad2e22cf73194d6caadfbcb43be14aeae5da0f394a43d127c18acb69801","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/amh_amh/1JN/5.json","totalNumberOfVerses":101},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ስለ ሕይወት ቃል ከመጀመሪያው የነበረውንና የሰማነውን በዓይኖቻችንም ያየነውን የተመለከትነውንም እጆቻችንም የዳሰሱትን እናወራለን፤"]},{"type":"verse","number":2,"content":["ሕይወትም ተገለጠ አይተንማል እንመሰክርማለን፥ ከአብ ዘንድ የነበረውንም ለእኛም የተገለጠውን የዘላለምን ሕይወት እናወራላችኋለን፤"]},{"type":"verse","number":3,"content":["እናንተ ደግሞ ከእኛ ጋር ኅብረት እንዲኖራችሁ ያየነውንና የሰማነውን ለእናንተ ደግሞ እናወራላችኋለን። ኅብረታችንም ከአባት ጋር ከልጁም ከኢየሱስ ክርስቶስ ጋር ነው።"]},{"type":"verse","number":4,"content":["ደስታችሁም እንዲፈጸም ይህን እንጽፍላችኋለን።"]},{"type":"verse","number":5,"content":["ከእርሱም የሰማናት ለእናንተም የምናወራላችሁ መልእክት። እግዚአብሔር ብርሃን ነው ጨለማም በእርሱ ዘንድ ከቶ የለም የምትል ይህች ናት።"]},{"type":"verse","number":6,"content":["ከእርሱ ጋር ኅብረት አለን ብንል በጨለማም ብንመላለስ እንዋሻለን እውነትንም አናደርግም፤"]},{"type":"verse","number":7,"content":["ነገር ግን እርሱ በብርሃን እንዳለ በብርሃን ብንመላለስ ለእያንዳንዳችን ኅብረት አለን፥ የልጁም የኢየሱስ ክርስቶስ ደም ከኃጢአት ሁሉ ያነጻናል።"]},{"type":"verse","number":8,"content":["ኃጢአት የለብንም ብንል ራሳችንን እናስታለን፥ እውነትም በእኛ ውስጥ የለም።"]},{"type":"verse","number":9,"content":["በኃጢአታችን ብንናዘዝ ኃጢአታችንን ይቅር ሊለን ከዓመፃም ሁሉ ሊያነጻን የታመነና ጻድቅ ነው።"]},{"type":"verse","number":10,"content":["ኃጢአትን አላደረግንም ብንል ሐሰተኛ እናደርገዋለን ቃሉም በእኛ ውስጥ የለም።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}