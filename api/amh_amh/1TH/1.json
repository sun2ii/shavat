{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"1TH","translationId":"amh_amh","name":"1ኛ ወደ ተሰሎንቄ ሰዎች","commonName":"1ኛ ወደ ተሰሎንቄ ሰዎች","title":"1ኛ ወደ ተሰሎንቄ ሰዎች","order":52,"numberOfChapters":5,"sha256":"b51de9977d2900c80edfd99a4197a6be81841e6df9a89060de4599e90c3a57ba","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/1TH/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/amh_amh/1TH/5.json","totalNumberOfVerses":68},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ጳውሎስና ስልዋኖስ ጢሞቴዎስም፥ በእግዚአብሔር አብ በጌታ በኢየሱስ ክርስቶስም ወደምትሆን ወደ ተሰሎንቄ ሰዎች ቤተ ክርስቲያን፤ ከእግዚአብሔር ከአባታችን ከጌታ ከኢየሱስ ክርስቶስም ጸጋ ሰላምም ለእናንተ ይሁን።"]},{"type":"verse","number":2,"content":["በእግዚአብሔር የምትወደዱ ወንድሞች ሆይ፥ እንደ ተመረጣችሁ አውቀናልና።"]},{"type":"verse","number":5,"content":["ወንጌላችን በኃይልና በመንፈስ ቅዱስ በብዙ መረዳትም እንጂ በቃል ብቻ ወደ እናንተ አልመጣምና፤ በእናንተ ዘንድ ስለ እናንተ እንዴት እንደ ነበርን ታውቃላችሁ።"]},{"type":"verse","number":6,"content":["ደግሞ እናንተ ቃሉን በብዙ መከራ ከመንፈስ ቅዱስ ደስታ ጋር ተቀብላችሁ፥ እኛንና ጌታን የምትመስሉ ሆናችሁ፤"]},{"type":"verse","number":7,"content":["ስለዚህም በመቄዶንያና በአካይያ ላሉት ምእመናን ሁሉ ምሳሌ ሆናችሁላቸው።"]},{"type":"verse","number":8,"content":["ከእናንተ ወጥቶ የጌታ ቃል በመቄዶንያና በአካይያ ብቻ አልተሰማምና፥ ነገር ግን ምንም እንድንናገር እስከማያስፈልግ ድረስ፥ በእግዚአብሔር ዘንድ የሚሆን እምነታችሁ በሁሉ ስፍራ ተወርቶአል።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/1TH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/1TH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/COL/4.json","previousChapterAudioLinks":{},"nu