{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"1TH","translationId":"amh_amh","name":"1ኛ ወደ ተሰሎንቄ ሰዎች","commonName":"1ኛ ወደ ተሰሎንቄ ሰዎች","title":"1ኛ ወደ ተሰሎንቄ ሰዎች","order":52,"numberOfChapters":5,"sha256":"b51de9977d2900c80edfd99a4197a6be81841e6df9a89060de4599e90c3a57ba","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/1TH/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/amh_amh/1TH/5.json","totalNumberOfVerses":68},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["ስለዚህ ወደ ፊት እንታገሥ ዘንድ ባልተቻለን ጊዜ፥ በአቴና ብቻችንን ልንቀር በጎ ፈቃዳችን ሆነ።"]},{"type":"verse","number":2,"content":["ስለ እምነታችሁም እንዲያጸናችሁና እንዲመክራችሁ ወንድማችንን የእግዚአብሔርንም አገልጋይ ከእኛ ጋርም አብሮ በክርስቶስ ወንጌል የሚሠራውን ጢሞቴዎስን ላክነው፤"]},{"type":"verse","number":3,"content":["በዚህ መከራ ማንም እንዳይናውጥ፥ ለዚህ እንደ ተመረጥን ራሳችሁ ታውቃላችሁና።"]},{"type":"verse","number":4,"content":["በእውነት ከእናንተ ጋር ሳለን፥ መከራ እንቀበል ዘንድ እንዳለን አስቀድመን እንነግራችሁ ነበር፤ እንዲሁም ደግሞ ሆነ፥ ይህንም ታውቃላችሁ።"]},{"type":"verse","number":5,"content":["ስለዚህ እኔ ደግሞ ወደ ፊት እታገሥ ዘንድ ባልተቻለኝ ጊዜ። ፈታኝ ምናልባት ፈትኖአቸዋል ድካማችንም ከንቱ ሆኖአል ብዬ እምነታችሁን ለማወቅ ላክሁ።"]},{"type":"verse","number":6,"content":["አሁን ግን ጢሞቴዎስ ከእናንተ ዘንድ ወደ እኛ መጥቶ ስለ እምነታችሁና ስለ ፍቅራችሁ የምስራች ብሎ በነገረን ጊዜ፥ እኛም እናያችሁ ዘንድ እንደምንናፍቅ ታዩን ዘንድ እየናፈቃችሁ ሁልጊዜ በመልካም እንደምታስቡን በነገረን ጊዜ፥"]},{"type":"verse","number":7,"content":["ስለዚህ፥ ወንድሞች ሆይ፥ በእምነታችሁ በኩል በችግራችንና በመከራችን ሁሉ ስለ እናንተ ተጽናናን፤"]},{"type":"verse","number":8,"content":["እናንተ በጌታ ጸንታችሁ ብትቆሙ፥ አሁን በሕይወት እንኖራለንና።"]},{"type":"verse","number":9,"content":["አምላካችንና አባታችን ራሱ ጌታችንም ኢየሱስ ክርስቶስ ወደ እናንተ መንገዳችንን ያቅና፤"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/1TH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/1TH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/1TH/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}