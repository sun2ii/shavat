{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"1TI","translationId":"amh_amh","name":"1ኛ ወደ ጢሞቴዎስ","commonName":"1ኛ ወደ ጢሞቴዎስ","title":"1ኛ ወደ ጢሞቴዎስ","order":54,"numberOfChapters":6,"sha256":"a0d3753789e5413add98bc036a53f37518f9d1b501cc52012dab8260e2286221","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/amh_amh/1TI/6.json","totalNumberOfVerses":90},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["አንድ እግዚአብሔር አለና፥ በእግዚአብሔርና በሰውም መካከል ያለው መካከለኛው ደግሞ አንድ አለ፥ እርሱም ሰው የሆነ ክርስቶስ ኢየሱስ ነው፤"]},{"type":"verse","number":6,"content":["ራሱንም ለሁሉ ቤዛ ሰጠ፥ ይህም በገዛ ዘመኑ ምስክርነቱ ነበረ፤"]},{"type":"verse","number":7,"content":["እኔም ለዚህ ነገር አዋጅ ነጋሪና ሐዋርያ በእምነትና በእውነትም የአሕዛብ አስተማሪ ለመሆን ተሾምሁ፤ እውነት እናገራለሁ፤ አልዋሽም።"]},{"type":"verse","number":8,"content":["እንግዲህ ወንዶች በስፍራ ሁሉ አለ ቍጣና አለ ክፉ አሳብ የተቀደሱትን እጆች እያነሱ እንዲጸልዩ እፈቅዳለሁ።"]},{"type":"verse","number":9,"content":["ሴት በነገር ሁሉ እየተገዛች በዝግታ ትማር፤"]},{"type":"verse","number":12,"content":["ሴት ግን በዝግታ ትኑር እንጂ ልታስተምር ወይም በወንድ ላይ ልትሰለጥን አልፈቅድም።"]},{"type":"verse","number":13,"content":["አዳም ቀድሞ ተፈጥሮአልና፥ በኋላም ሔዋን ተፈጠረች።"]},{"type":"verse","number":14,"content":["የተታለለም አዳም አይደለም፥ ሴቲቱ ግን ተታልላ በመተላለፍ ወደቀች፤"]},{"type":"verse","number":15,"content":["ነገር ግን በእምነትና በፍቅር በቅድስናም ራሳቸውን እየገዙ ቢኖሩ በመውለድ ትድናለች።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/1TI/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/1TI/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/1TI/1.json","previousChapterAudioLinks":{},"numberOfVerses":9}