{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"1TI","translationId":"amh_amh","name":"1ኛ ወደ ጢሞቴዎስ","commonName":"1ኛ ወደ ጢሞቴዎስ","title":"1ኛ ወደ ጢሞቴዎስ","order":54,"numberOfChapters":6,"sha256":"a0d3753789e5413add98bc036a53f37518f9d1b501cc52012dab8260e2286221","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/amh_amh/1TI/6.json","totalNumberOfVerses":90},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["እነዚህ ውሸተኞች መጋባትን ይከለክላሉ፥ አምነውም እውነትን የሚያውቁ ከምስጋና ጋር ይቀበሉ ዘንድ እግዚአብሔር ከፈጠረው መብል እንዲርቁ ያዝዛሉ።"]},{"type":"verse","number":4,"content":["እግዚአብሔር የፈጠረው ሁሉ መልካም ነውና፥ ከምስጋናም ጋር ቢቀበሉት የሚጣል ምንም የለም፤"]},{"type":"verse","number":5,"content":["በእግዚአብሔር ቃልና በጸሎት የተቀደሰ ነውና።"]},{"type":"verse","number":6,"content":["ስለዚህ ወንድሞችን ብታሳስብ፥ በእምነትና በተከተልኸው በመልካም ትምህርት ቃል የምትመገብ የኢየሱስ ክርስቶስ መልካም አገልጋይ ትሆናለህ።"]},{"type":"verse","number":7,"content":["ነገር ግን ለዚህ ዓለም ከሚመችና የአሮጊቶችን ሴቶች ጨዋታ ከሚመስለው ተረት ራቅ። እግዚአብሔርን ለመምሰል ግን ራስህን አስለምድ።"]},{"type":"verse","number":8,"content":["ሰውነትን ለሥጋዊ ነገር ማስለመድ ለጥቂት ይጠቅማልና፤ እግዚአብሔርን መምሰል ግን የአሁንና የሚመጣው ሕይወት ተስፋ ስላለው፥ ለነገር ሁሉ ይጠቅማል።"]},{"type":"verse","number":9,"content":["ይህ ቃል የታመነ ሁሉም እንዲቀበሉት የተገባ ነው፤"]},{"type":"verse","number":10,"content":["ይህን ለማግኘት እንደክማለንና፥ ስለዚህም እንሰደባለን፤ ይህም ሰውን ሁሉ ይልቁንም የሚያምኑትን በሚያድን በሕያው አምላክ ተስፋ ስለምናደርግ ነው።"]},{"type":"verse","number":11,"content":["እስክመጣ ድረስ ለማንበብና ለመምከር ለማስተማርም ተጠንቀቅ።"]},{"type":"verse","number":14,"content":["በትንቢት ከሽማግሌዎች እጅ መጫን ጋር የተሰጠህን፥ በአንተ ያለውን የጸጋ ስጦታ ቸል አትበል።"]},{"type":"verse","number":15,"content":["ማደግህ በነገር ሁሉ እንዲገለጥ ይህን አስብ፥ ይህንም አዘውትር።"]},{"type":"verse","number":16,"content":["ለራስህና ለትምህርትህ ተጠንቀቅ፥ በእነዚህም ጽና፤ ይህን ብታደርግ፥ ራስህንም የሚሰሙህንም ታድናለህና።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/1TI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/1TI/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/1TI/3.json","previousChapterAudioLinks":{},"numberOfVerses":12}