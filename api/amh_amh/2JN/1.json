{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"2JN","translationId":"amh_amh","name":"2ኛ የዮሐንስ መልእክት","commonName":"2ኛ የዮሐንስ መልእክት","title":"2ኛ የዮሐንስ መልእክት","order":63,"numberOfChapters":1,"sha256":"f1c7b3f5d66cebe35fa9c1a21592d7c01ca950e56a63b529fd3c5b5e2aedb9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/2JN/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/amh_amh/2JN/1.json","totalNumberOfVerses":11},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ከእግዚአብሔር አብና ከአብ ልጅ ከኢየሱስ ክርስቶስ ጸጋና ምሕረት ሰላምም በእውነትና በፍቅር ከእኛ ጋር ይሆናሉ።"]},{"type":"verse","number":4,"content":["ትእዛዝን ከአብ እንደ ተቀበልን ከልጆችሽ በእውነት የሚሄዱ አንዳንዶችን ስለ አገኘኋቸው እጅግ ደስ ብሎኛል።"]},{"type":"verse","number":5,"content":["አሁንም፥ እመቤት ሆይ፥ እርስ በርሳችን እንድንዋደድ እለምንሻለሁ፤ ይህች ከመጀመሪያ በእኛ ዘንድ የነበረች ትእዛዝ ናት እንጂ አዲስ ትእዛዝን እንደምጽፍልሽ አይደለም።"]},{"type":"verse","number":6,"content":["እንደ ትእዛዛቱም እንሄድ ዘንድ ይህ ፍቅር ነው፤ ከመጀመሪያ እንደ ሰማችሁ፥ በእርስዋ ትሄዱ ዘንድ ትእዛዙ ይህች ናት።"]},{"type":"verse","number":7,"content":["ብዙ አሳቾች ወደ ዓለም ገብተዋልና እነርሱም ኢየሱስ ክርስቶስ በሥጋ እንደ መጣ የማያምኑ ናቸው፤ ይህ አሳቹና የክርስቶስ ተቃዋሚው ነው።"]},{"type":"verse","number":8,"content":["ሙሉ ደመወዝን እንድትቀበሉ እንጂ የሠራችሁትን እንዳታጠፉ ለራሳችሁ ተጠንቀቁ።"]},{"type":"verse","number":9,"content":["ለሚወጣ ሁሉ በክርስቶስም ትምህርት ለማይኖር ሰው አምላክ የለውም፤ በክርስቶስ ትምህርት ለሚኖር አብና ወልድ አሉት።"]},{"type":"verse","number":10,"content":["ማንም ወደ እናንተ ቢመጣ ይህንም ትምህርት ባያመጣ በቤታችሁ አትቀበሉት ሰላምም አትበሉት፤"]},{"type":"verse","number":11,"content":["ሰላም የሚለው ሰው በክፉ ሥራው ይካፈላልና።"]},{"type":"verse","number":12,"content":["እንድጽፍላችሁ የምፈልገው ብዙ ነገር ሳለኝ በወረቀትና በቀለም ልጽፈው አልወድም፥ ዳሩ ግን ደስታችሁ ፍጹም እንዲሆን ወደ እናንተ ልመጣ አፍ ለአፍም ልናገራችሁ ተስፋ አደርጋለሁ።"]},{"type":"verse","number":13,"content":["የተመረጠችው የእኅትሽ ልጆች ሰላምታ ያቀርቡልሻል።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/2JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/3JN/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/1JN/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}