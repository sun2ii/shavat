{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"2TH","translationId":"amh_amh","name":"2ኛ ወደ ተሰሎንቄ ሰዎች","commonName":"2ኛ ወደ ተሰሎንቄ ሰዎች","title":"2ኛ ወደ ተሰሎንቄ ሰዎች","order":53,"numberOfChapters":3,"sha256":"403503e0ce44ede5c9617205285bb5e9943196958f2af6985b491ad072236ec9","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/2TH/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/amh_amh/2TH/3.json","totalNumberOfVerses":31},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ጳውሎስና ስልዋኖስ ጢሞቴዎስም፥ በእግዚአብሔር በአባታችን በጌታ በኢየሱስ ክርስቶስም ወደምትሆን ወደ ተሰሎንቄ ሰዎች ቤተ ክርስቲያን፤"]},{"type":"verse","number":2,"content":["ከእግዚአብሔር ከአባታችን ከጌታ ከኢየሱስ ክርስቶስም ጸጋ ሰላምም ለእናንተ ይሁን።"]},{"type":"verse","number":3,"content":["ወንድሞች ሆይ፥ እምነታችሁ እጅግ ስለሚያድግ የሁላችሁም የእያንዳንዳችሁ ፍቅር እርስ በርሳችሁ ስለሚበዛ፥ ሁልጊዜ ስለ እናንተ እግዚአብሔርን እንደሚገባ ልናመሰግን ግድ አለብን፤"]},{"type":"verse","number":4,"content":["ስለዚህ በምትታገሱበት በስደታችሁና በመከራችሁ ሁሉ ከመጽናታችሁና ከእምነታችሁ የተነሣ በእግዚአብሔር አብያተ ክርስቲያናት ስለ እናንተ ራሳችን እንመካለን።"]},{"type":"verse","number":5,"content":["ስለ እርሱ ደግሞ መከራ ለምትቀበሉለት ለእግዚአብሔር መንግሥት የምትበቁ ሆናችሁ ትቈጠሩ ዘንድ፥ ይህ የእግዚአብሔር ቅን ፍርድ ምልክት ነው።"]},{"type":"verse","number":6,"content":["እግዚአብሔርን የማያውቁትን፥ ለጌታችንም ለኢየሱስ ክርስቶስ ወንጌል የማይታዘዙትን ይበቀላል፤"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/2TH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/2TH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/1TH/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}