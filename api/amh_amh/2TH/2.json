{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"2TH","translationId":"amh_amh","name":"2ኛ ወደ ተሰሎንቄ ሰዎች","commonName":"2ኛ ወደ ተሰሎንቄ ሰዎች","title":"2ኛ ወደ ተሰሎንቄ ሰዎች","order":53,"numberOfChapters":3,"sha256":"403503e0ce44ede5c9617205285bb5e9943196958f2af6985b491ad072236ec9","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/2TH/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/amh_amh/2TH/3.json","totalNumberOfVerses":31},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["ማንም በማናቸውም መንገድ አያስታችሁ፤ ክህደቱ አስቀድሞ ሳይመጣና የዓመፅ ሰው እርሱም የጥፋት ልጅ ሳይገለጥ፥ አይደርስምና።"]},{"type":"verse","number":4,"content":["እኔ እግዚአብሔር ነኝ ብሎ አዋጅ እየነገረ በእግዚአብሔር ቤተ መቅደስ እስኪቀመጥ ድረስ፥ አምላክ ከተባለው ሁሉ፥ ሰዎችም ከሚያመልኩት ሁሉ በላይ ራሱን ከፍ ከፍ የሚያደርገው ተቃዋሚ እርሱ ነው።"]},{"type":"verse","number":5,"content":["ገና ከእናንተ ጋር ሳለሁ፥ ይህን እንዳልኋችሁ ትዝ አይላችሁምን?"]},{"type":"verse","number":6,"content":["በገዛ ራሱ ጊዜም ይገለጥ ዘንድ፥ የሚከለክለውን አሁን ታውቃላችሁ።"]},{"type":"verse","number":7,"content":["የዓመፅ ምሥጢር አሁን ይሠራልና፤ ብቻ ከመንገድ እስኪወገድ ድረስ አሁን የሚከለክል አለ።"]},{"type":"verse","number":8,"content":["በዚያም ጊዜ ጌታ ኢየሱስ በአፉ መንፈስ የሚያጠፋው፥ ሲመጣም በመገለጡ የሚሽረው ዓመፀኛ ይገለጣል፤"]},{"type":"verse","number":9,"content":["እኛ ግን፥ በጌታ የተወደዳችሁ ወንድሞች ሆይ፥ ሁልጊዜ ስለ እናንተ እግዚአብሔርን ልናመሰግን ግድ አለብን፥ እግዚአብሔር በመንፈስ መቀደስ እውነትንም በማመን ለመዳን እንደ በኵራት መርጦአችኋልና፤"]},{"type":"verse","number":14,"content":["ለዚህም የጌታችንን የኢየሱስ ክርስቶስን ክብር ለማግኘት በወንጌላችን ጠራችሁ።"]},{"type":"verse","number":15,"content":["እንግዲያስ፥ ወንድሞች ሆይ፥ ጸንታችሁ ቁሙ፥ በቃላችንም ቢሆን ወይም በመልእክታችን የተማራችሁትን ወግ ያዙ።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/2TH/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/2TH/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/2TH/1.json","previousChapterAudioLinks":{},"numberOfVerses":9}