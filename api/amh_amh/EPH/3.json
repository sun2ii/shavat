{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"EPH","translationId":"amh_amh","name":"ወደ ኤፌሶን ሰዎች","commonName":"ወደ ኤፌሶን ሰዎች","title":"ወደ ኤፌሶን ሰዎች","order":49,"numberOfChapters":6,"sha256":"e8bf50356ff6723605edb9624af64a0dbff7d71fea75a0ffd21be7cbc05f64e9","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/amh_amh/EPH/6.json","totalNumberOfVerses":123},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["ስለዚህም አሕዛብ ስለ ሆናችሁ ስለ እናንተ የክርስቶስ ኢየሱስ እስር የሆንሁ እኔ ጳውሎስ ለእግዚአብሔር እንበረከካለሁ።"]},{"type":"verse","number":2,"content":["ለእናንተ ስለ ተሰጠኝ ስለ እግዚአብሔር ጸጋ መጋቢነት በእርግጥ ሰምታችኋል፤"]},{"type":"verse","number":3,"content":["አስቀድሜ በአጭሩ እንደ ጻፍሁ፥ ይህን ምሥጢር በመግለጥ አስታወቀኝ፤"]},{"type":"verse","number":4,"content":["ይህንም ስታነቡ የክርስቶስን ምሥጢር እንዴት እንደማስተውል ልትመለከቱ ትችላላችሁ፤"]},{"type":"verse","number":5,"content":["እንደ ኃይሉ ሥራ እንደ ተሰጠኝም እንደ እግዚአብሔር ጸጋ ስጦታ መጠንየወንጌል አገልጋይ ሆንሁለት።"]},{"type":"verse","number":8,"content":["ብዙ ልዩ ልዩ የእግዚአብሔር ጥበብ አሁን በቤተ ክርስቲያን በኩል በሰማያዊ ስፍራ ውስጥ ላሉት አለቆችና ሥልጣናት ትታወቅ ዘንድ፤"]},{"type":"verse","number":11,"content":["ይህም በክርስቶስ ኢየሱስ በጌታችን የፈጸመው የዘላለም አሳብ ነበረ፥"]},{"type":"verse","number":12,"content":["በእርሱም ዘንድ ባለ እምነታችን በኩል በመታመን ድፍረትና መግባት በእርሱ አለን።"]},{"type":"verse","number":13,"content":["ስለዚህ ስለ እናንተ ስላለ መከራዬ እንዳትታክቱ እለምናችኋለሁ፥ ክብራችሁ ነውና።"]},{"type":"verse","number":14,"content":["እንግዲህ በእኛ እንደሚሠራው ኃይል መጠን ከምንለምነው ወይም ከምናስበው ሁሉ ይልቅ እጅግ አብልጦ ሊያደርግ ለሚቻለው፥"]},{"type":"verse","number":21,"content":["ለእርሱ በቤተ ክርስቲያን በክርስቶስ ኢየሱስ እስከ ትውልዶች ሁሉ ከዘላለም እስከ ዘላለም ክብር ይሁን፤ አሜን።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/EPH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/EPH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/EPH/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}