{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"HEB","translationId":"amh_amh","name":"ወደ ዕብራውያን","commonName":"ወደ ዕብራውያን","title":"ወደ ዕብራውያን","order":58,"numberOfChapters":13,"sha256":"728e417c245429d559673f6d34cda3a5405c25da4f68b1a199a2a5edbc87fc5a","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/amh_amh/HEB/13.json","totalNumberOfVerses":259},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["እግዚአብሔርም ቢፈቅድ ይህን እናደርጋለን።"]},{"type":"verse","number":4,"content":["አንድ ጊዜ ብርሃን የበራላቸውን ሰማያዊውንም ስጦታ የቀመሱትን ከመንፈስ ቅዱስም ተካፋዮች ሆነው የነበሩትን"]},{"type":"verse","number":5,"content":["መልካሙንም የእግዚአብሔርን ቃልና ሊመጣ ያለውን የዓለም ኃይል የቀመሱትን"]},{"type":"verse","number":6,"content":["በኋላም የካዱትን እንደገና ለንስሐ እነርሱን ማደስ የማይቻል ነው፤ ለራሳቸው የእግዚአብሔርን ልጅ ይሰቅሉታልና ያዋርዱትማልና።"]},{"type":"verse","number":7,"content":["ብዙ ጊዜ በእርስዋ ላይ የሚወርደውን ዝናብ የምትጠጣ መሬት፥ ለሚያርሱአትም ደግሞ የምትጠቅምን አትክልት የምታበቅል፥ ከእግዚአብሔር በረከትን ታገኛለችና፤"]},{"type":"verse","number":8,"content":["እሾህና ኵርንችትን ግን ብታወጣ፥ የተጣለች ናት ለመረገምም ትቀርባለች፥ መጨረሻዋም መቃጠል ነው።"]},{"type":"verse","number":9,"content":["ስለ እናንተ ግን፥ ወዳጆች ሆይ፥ ምንም እንኳ እንዲሁ ብንናገር፥ አብልጦ የሚሻለውና ለመዳን የሚሆነው እንዲሆንላችሁ ተረድተናል።"]},{"type":"verse","number":10,"content":["እግዚአብሔር፥ ቅዱሳንን ስላገለገላችሁ እስከ አሁንም ስለምታገለግሉአቸው፥ ያደረጋችሁትን ሥራ ለስሙም ያሳያችሁትን ፍቅር ይረሳ ዘንድ ዓመፀኛ አይደለምና።"]},{"type":"verse","number":11,"content":["እንዲሁም እርሱ ከታገሰ በኋላ ተስፋውን አገኘ።"]},{"type":"verse","number":16,"content":["ሰዎች ከእነርሱ በሚበልጠው ይምላሉና፥ ለማስረዳትም የሆነው መሐላ የሙግት ሁሉ ፍጻሜ ይሆናል፤"]},{"type":"verse","number":17,"content":["ይህም ተስፋ እንደ ነፍስ መልሕቅ አለን እርሱም እርግጥና ጽኑ የሆነ ወደ መጋረጃውም ውስጥ የገባ ነው፤"]},{"type":"verse","number":20,"content":["በዚያም ኢየሱስ እንደ መልከ ጼዴቅ ሹመት ለዘላለም ሊቀ ካህናት የሆነው፥ ስለ እኛ ቀዳሚ ሆኖ ገባ።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/HEB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/HEB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/HEB/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}