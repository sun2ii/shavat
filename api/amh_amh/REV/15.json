{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"REV","translationId":"amh_amh","name":"የዮሐንስ ራእይ","commonName":"የዮሐንስ ራእይ","title":"የዮሐንስ ራእይ","order":66,"numberOfChapters":22,"sha256":"bf8c8b771d5f29b8d2c619e00e56ad6d81503aa9844b2792b6655a704875527a","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/amh_amh/REV/22.json","totalNumberOfVerses":383},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["ሌላም ታላቅና ድንቅ ምልክት በሰማይ አየሁ፤ የእግዚአብሔር ቍጣ በእነርሱ ስለሚፈጸም ኋለኛዎቹን ሰባት መቅሠፍቶች የያዙ ሰባት መላእክት ታዩ።"]},{"type":"verse","number":2,"content":["በእሳትም የተቀላቀለውን የብርጭቆ ባሕር የሚመስለውን አየሁ፥ በአውሬውና በምስሉም በስሙም ቍጥር ላይ ድል ነሥተው የነበሩት የእግዚአብሔርን በገና ይዘው በብርጭቆ ባሕር ላይ ሲቆሙ አየሁ።"]},{"type":"verse","number":3,"content":["ከዚህም በኋላ አየሁ፥ የምስክርም ድንኳን መቅደስ በሰማይ ተከፈተ፥"]},{"type":"verse","number":6,"content":["ሰባቱንም መቅሠፍት የያዙ ሰባቱ መላእክት ከመቅደሱ ወጡ፤ ከተልባ እግርም የተሠራ ጥሩ የጌጥ ልብስ ለበሱ ደረታቸውንም በወርቅ መታጠቂያ ታጠቁ።"]},{"type":"verse","number":7,"content":["ከአራቱም እንስሶች አንዱ ከዘላለም እስከ ዘላለም ድረስ የሚኖር የእግዚአሔር ቍጣ የሞላባቸውን ሰባት የወርቅ ጽዋዎች ለሰባቱ መላእክት ሰጣቸው።"]},{"type":"verse","number":8,"content":["ከእግዚአብሔርም ክብርና ከኃይሉ ጢስ በመቅደሱ ሞላበት፥ የሰባቱ መላእክት ሰባቱ መቅሰፍት እስኪፈጸሙ ድረስ አንድ እንኳ ወደ መቅደሱ ይገባ ዘንድ አልቻለም።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/REV/14.json","previousChapterAudioLinks"