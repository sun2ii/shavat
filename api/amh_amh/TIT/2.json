{"translation":{"id":"amh_amh","name":"መጽሐፍ ቅዱስ","website":"https://ebible.org/Scriptures/details.php?id=amh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=amh","licenseNotes":null,"shortName":"AMH","englishName":"Amharic NT","language":"amh","textDirection":"ltr","sha256":"0bc4bb475020938b13a1fd036991f310c442518900573d54977a65d9933b9425","availableFormats":["json"],"listOfBooksApiLink":"/api/amh_amh/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7369,"languageName":"አማርኛ","languageEnglishName":"Amharic"},"book":{"id":"TIT","translationId":"amh_amh","name":"ወደ ቲቶ","commonName":"ወደ ቲቶ","title":"ወደ ቲቶ","order":56,"numberOfChapters":3,"sha256":"c8821af1df9bffb56808e3cc8e9e02381c60c2f128888e291e755f5aaa7b08b1","firstChapterNumber":1,"firstChapterApiLink":"/api/amh_amh/TIT/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/amh_amh/TIT/3.json","totalNumberOfVerses":28},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["አንተ ግን ሕይወት ለሚገኝበት ትምህርት የሚገባውን ተናገር።"]},{"type":"verse","number":2,"content":["ሽማግሌዎች ልከኞች፥ ጭምቶች፥ ራሳቸውን የሚገዙ፥ በእምነትና በፍቅር በመጽናትም ጤናሞች እንዲሆኑ ምከራቸው፤"]},{"type":"verse","number":3,"content":["እንዲሁም አሮጊቶች ሴቶች አካሄዳቸው ለቅዱስ አገልግሎት የሚገባ፥ የማያሙ፥ ለብዙ ወይን ጠጅ የማይገዙ፥ በጎ የሆነውን ነገር የሚያስተምሩ ይሁኑ፤"]},{"type":"verse","number":4,"content":["ጎበዞችም እንዲሁ ራሳቸውን እንዲገዙ ምከራቸው።"]},{"type":"verse","number":7,"content":["ሰዎችን ሁሉ የሚያድን የእግዚአብሔር ጸጋ ተገልጦአልና፤"]},{"type":"verse","number":12,"content":["መድኃኒታችንም ከዓመፅ ሁሉ እንዲቤዠን፥ መልካሙንም ለማድረግ የሚቀናውን ገንዘቡም የሚሆነውን ሕዝብ ለራሱ እንዲያነጻ፥ ስለ እኛ ነፍሱን ሰጥቶአል።"]},{"type":"verse","number":15,"content":["ይህን በሙሉ ሥልጣን ተናገርና ምከር ገሥጽም፤ ማንም አይናቅህ።"]}],"footnotes":[]},"thisChapterLink":"/api/amh_amh/TIT/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/amh_amh/TIT/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/amh_amh/TIT/1.json","previousChapterAudioLinks":{},"numberOfVerses":7}