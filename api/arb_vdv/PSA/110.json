{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseNotes":null,"shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["لِدَاوُدَ. مَزْمُورٌ"]},{"type":"verse","number":1,"content":["قَالَ ٱلرَّبُّ لِرَبِّي: «ٱجْلِسْ عَنْ يَمِينِي حَتَّى أَضَعَ أَعْدَاءَكَ مَوْطِئًا لِقَدَمَيْكَ»."]},{"type":"verse","number":2,"content":["يُرْسِلُ ٱلرَّبُّ قَضِيبَ عِزِّكَ مِنْ صِهْيَوْنَ. تَسَلَّطْ فِي وَسَطِ أَعْدَائِكَ."]},{"type":"verse","number":3,"content":["شَعْبُكَ مُنْتَدَبٌ فِي يَوْمِ قُوَّتِكَ، فِي زِينَةٍ مُقَدَّسَةٍ مِنْ رَحِمِ ٱلْفَجْرِ، لَكَ طَلُّ حَدَاثَتِكَ."]},{"type":"verse","number":4,"content":["أَقْسَمَ ٱلرَّبُّ وَلَنْ يَنْدَمَ: «أَنْتَ كَاهِنٌ إِلَى ٱلْأَبَدِ عَلَى رُتْبَةِ مَلْكِي صَادَقَ»."]},{"type":"verse","number":5,"content":["ٱلرَّبُّ عَنْ يَمِينِكَ يُحَطِّمُ فِي يَوْمِ رِجْزِهِ مُلُوكًا."]},{"type":"verse","number":6,"content":["يَدِينُ بَيْنَ ٱلْأُمَمِ. مَلَأَ جُثَثًا أَرْضًا وَاسِعَةً. سَحَقَ رُؤُوسَهَا."]},{"type":"verse","number":7,"content":["مِنَ ٱلنَّهْرِ يَشْرَبُ فِي ٱلطَّرِيقِ، لِذَلِكَ يَرْفَعُ ٱلرَّأْسَ."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}