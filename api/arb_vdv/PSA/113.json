{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseNotes":null,"shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":["هَلِّلُويَا. سَبِّحُوا يَا عَبِيدَ ٱلرَّبِّ. سَبِّحُوا ٱسْمَ ٱلرَّبِّ."]},{"type":"verse","number":2,"content":["لِيَكُنِ ٱسْمُ ٱلرَّبِّ مُبَارَكًا مِنَ ٱلْآنَ وَإِلَى ٱلْأَبَدِ."]},{"type":"verse","number":3,"content":["مِنْ مَشْرِقِ ٱلشَّمْسِ إِلَى مَغْرِبِهَا ٱسْمُ ٱلرَّبِّ مُسَبَّحٌ."]},{"type":"verse","number":4,"content":["ٱلرَّبُّ عَالٍ فَوْقَ كُلِّ ٱلْأُمَمِ. فَوْقَ ٱلسَّمَاوَاتِ مَجْدُهُ."]},{"type":"verse","number":5,"content":["مَنْ مِثْلُ ٱلرَّبِّ إِلَهِنَا ٱلسَّاكِنِ فِي ٱلْأَعَالِي؟"]},{"type":"verse","number":6,"content":["ٱلنَّاظِرِ ٱلْأَسَافِلَ فِي ٱلسَّمَاوَاتِ وَفِي ٱلْأَرْضِ،"]},{"type":"verse","number":7,"content":["ٱلْمُقِيمِ ٱلْمِسْكِينَ مِنَ ٱلتُّرَابِ، ٱلرَّافِعِ ٱلْبَائِسَ مِنَ ٱلْمَزْبَلَةِ"]},{"type":"verse","number":8,"content":["لِيُجْلِسَهُ مَعَ أَشْرَافٍ، مَعَ أَشْرَافِ شَعْبِهِ."]},{"type":"verse","number":9,"content":["ٱلْمُسْكِنِ ٱلْعَاقِرَ فِي بَيْتٍ، أُمَّ أَوْلَادٍ فَرْحَانَةً. هَلِّلُويَا."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}