ِكِ»."]},{"type":"verse","number":9,"content":["مِنْ أَجْلِ بَيْتِ ٱلرَّبِّ إِلَهِنَا أَلْتَمِسُ لَكِ خَيْرًا."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}