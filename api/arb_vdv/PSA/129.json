ِّ»."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}