{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseNotes":null,"shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["لِإِمَامِ ٱلْمُغَنِّينَ. لِبَنِي قُورَحَ. مَزْمُورٌ"]},{"type":"verse","number":1,"content":["يَا جَمِيعَ ٱلْأُمَمِ صَفِّقُوا بِٱلْأَيَادِي. ٱهْتِفُوا لِلهِ بِصَوْتِ ٱلِٱبْتِهَاجِ."]},{"type":"verse","number":2,"content":["لِأَنَّ ٱلرَّبَّ عَلِيٌّ مَخُوفٌ، مَلِكٌ كَبِيرٌ عَلَى كُلِّ ٱلْأَرْضِ."]},{"type":"verse","number":3,"content":["يُخْضِعُ ٱلشُّعُوبَ تَحْتَنَا، وَٱلْأُمَمَ تَحْتَ أَقْدَامِنَا."]},{"type":"verse","number":4,"content":["يَخْتَارُ لَنَا نَصِيبَنَا، فَخْرَ يَعْقُوبَ ٱلَّذِي أَحَبَّهُ. سِلَاهْ."]},{"type":"verse","number":5,"content":["صَعِدَ ٱللهُ بِهُتَافٍ، ٱلرَّبُّ بِصَوْتِ ٱلصُّورِ."]},{"type":"verse","number":6,"content":["رَنِّمُوا لِلهِ، رَنِّمُوا. رَنِّمُوا لِمَلِكِنَا، رَنِّمُوا."]},{"type":"verse","number":7,"content":["لِأَنَّ ٱللهَ مَلِكُ ٱلْأَرْضِ كُلِّهَا، رَنِّمُوا قَصِيدَةً."]},{"type":"verse","number":8,"content":["مَلَكَ ٱللهُ عَلَى ٱلْأُمَمِ. ٱللهُ جَلَسَ عَلَى كُرْسِيِّ قُدْسِهِ."]},{"type":"verse","number":9,"content":["شُرَفَاءُ ٱلشُّعُوبِ ٱجْتَمَعُوا. شَعْبُ إِلَهِ إِبْرَاهِيمَ. لِأَنَّ لِلهِ مَجَانَّ ٱلْأَرْضِ. هُوَ مُتَعَالٍ جِدًّا."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}