,{"type":"verse","number":8,"content":["هَكَذَا أُرَنِّمُ لِٱسْمِكَ إِلَى ٱلْأَبَدِ، لِوَفَاءِ نُذُورِي يَوْمًا فَيَوْمًا."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}