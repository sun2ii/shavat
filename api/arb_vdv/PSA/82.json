{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseNotes":null,"shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["مَزْمُورٌ لِآسَافَ"]},{"type":"verse","number":1,"content":["ٱللهُ قَائِمٌ فِي مَجْمَعِ ٱللهِ. فِي وَسْطِ ٱلْآلِهَةِ يَقْضِي:"]},{"type":"verse","number":2,"content":["«حَتَّى مَتَى تَقْضُونَ جَوْرًا وَتَرْفَعُونَ وُجُوهَ ٱلْأَشْرَارِ؟ سِلَاهْ."]},{"type":"verse","number":3,"content":["اِقْضُوا لِلذَّلِيلِ وَلِلْيَتِيمِ. أَنْصِفُوا ٱلْمِسْكِينَ وَٱلْبَائِسَ."]},{"type":"verse","number":4,"content":["نَجُّوا ٱلْمِسْكِينَ وَٱلْفَقِيرَ. مِنْ يَدِ ٱلْأَشْرَارِ أَنْقِذُوا."]},{"type":"verse","number":5,"content":["«لَا يَعْلَمُونَ وَلَا يَفْهَمُونَ. فِي ٱلظُّلْمَةِ يَتَمَشَّوْنَ. تَتَزَعْزَعُ كُلُّ أُسُسِ ٱلْأَرْضِ."]},{"type":"verse","number":6,"content":["أَنَا قُلْتُ: إِنَّكُمْ آلِهَةٌ وَبَنُو ٱلْعَلِيِّ كُلُّكُمْ."]},{"type":"verse","number":7,"content":["لَكِنْ مِثْلَ ٱلنَّاسِ تَمُوتُونَ وَكَأَحَدِ ٱلرُّؤَسَاءِ تَسْقُطُونَ»."]},{"type":"verse","number":8,"content":["قُمْ يَا ٱللهُ. دِنِ ٱلْأَرْضَ، لِأَنَّكَ أَنْتَ تَمْتَلِكُ كُلَّ ٱلْأُمَمِ."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}