{"translation":{"id":"arb_vdv","name":"الكتاب المقدس باللغة العربية، فان دايك","website":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=arb-vd","licenseNotes":null,"shortName":"VDV","englishName":"Arabic Van Dyck Bible","language":"arb","textDirection":"rtl","sha256":"a7dbde0da2118c438758bca1706ea71c5c2e4cec72eb996463e4c761c9f6bffb","availableFormats":["json"],"listOfBooksApiLink":"/api/arb_vdv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"العربية","languageEnglishName":"Arabic"},"book":{"id":"PSA","translationId":"arb_vdv","name":"اَلْمَزَامِيرُ","commonName":"المَزامِير","title":"اَلْمَزَامِيرُ","order":19,"numberOfChapters":150,"sha256":"2f5cafa2da943dabdbf800c3707753b5ced89423803534ef7ce9fc7d80106d03","firstChapterNumber":1,"firstChapterApiLink":"/api/arb_vdv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/arb_vdv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["اَلرَّبُّ قَدْ مَلَكَ. لَبِسَ ٱلْجَلَالَ. لَبِسَ ٱلرَّبُّ ٱلْقُدْرَةَ، ٱئْتَزَرَ بِهَا. أَيْضًا تَثَبَّتَتِ ٱلْمَسْكُونَةُ. لَا تَتَزَعْزَعُ."]},{"type":"verse","number":2,"content":["كُرْسِيُّكَ مُثْبَتَةٌ مُنْذُ ٱلْقِدَمِ. مُنْذُ ٱلْأَزَلِ أَنْتَ."]},{"type":"verse","number":3,"content":["رَفَعَتِ ٱلْأَنْهَارُ يَارَبُّ، رَفَعَتِ ٱلْأَنْهَارُ صَوْتَهَا. تَرْفَعُ ٱلْأَنْهَارُ عَجِيجَهَا."]},{"type":"verse","number":4,"content":["مِنْ أَصْوَاتِ مِيَاهٍ كَثِيرَةٍ، مِنْ غِمَارِ أَمْوَاجِ ٱلْبَحْرِ، ٱلرَّبُّ فِي ٱلْعُلَى أَقْدَرُ."]},{"type":"verse","number":5,"content":["شَهَادَاتُكَ ثَابِتَةٌ جِدًّا. بِبَيْتِكَ تَلِيقُ ٱلْقَدَاسَةُ يَارَبُّ إِلَى طُولِ ٱلْأَيَّامِ."]}],"footnotes":[]},"thisChapterLink":"/api/arb_vdv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/arb_vdv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/arb_vdv/PSA/92.json","previousChapterAudioLink