{"translation":{"id":"are_bsa","name":"Altjirraka angkatja  - Arrarnturna kngartiwukala","website":"https://ebible.org/Scriptures/details.php?id=are","licenseUrl":"https://ebible.org/Scriptures/details.php?id=are","licenseNotes":null,"shortName":"BSA","englishName":"Western Arrarnta NT","language":"are","textDirection":"ltr","sha256":"e9ce6102d98f180cf1d9b433087a5c7fef970da500636aa9b02d9533606e6d2e","availableFormats":["json"],"listOfBooksApiLink":"/api/are_bsa/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7917,"languageName":"Western Arrarnta","languageEnglishName":"Western Arrarnta"},"book":{"id":"HEB","translationId":"are_bsa","name":"HEBREWS","commonName":"HEBREWS","title":"HEBREWS","order":58,"numberOfChapters":13,"sha256":"cecca259c25e182064dd2351a33a7e394aec200bfa85ed5a927e9c190dbedc61","firstChapterNumber":1,"firstChapterApiLink":"/api/are_bsa/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/are_bsa/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Altjirranha kala ingkarnarangantama relhurna angkaka, 'Lira ekuranharlarlanga"]},{"type":"verse","number":1,"content":["Imanka Altjirranha errilkngipata nurnakanha ntjarrurna angkaka, urrpia ekuranharlarlanga. Era urrpia nhanha etnanha angkatja ekuranha kurrkamakurrka iletnaka, etna altjirraramalanga, etnanha eterrintja nthamalalka."]},{"type":"verse","number":2,"content":["Ngurrukalkurantama era nurnakurna angkaka 'Lira ekuranharlarlanga. Lakinha Altjirrala antala arrkurlinya erinha mangkilaka, antala ingkarninya erinha turtantama tjontalhelaka. 'Lira nhanha ekurarlarlanga Altjirrala nhanga alha, alkiralka ingkarraka arrpmarnakala. Lyarta era kala 'Lira erinha Altjirrakanha ingkarraka ekuranha nthaka."]},{"type":"verse","number":3,"content":["Altjirranha makalaria pa ekarlta inthorra nama. Nhanha relhala 'Lirarlarlanga arama, 'Lira era nthurrpa inthorra Altjirra namanga warta. Lira nhanha era turta alha, alkiralka ingkarraka inthorra errkuma, angkatja ekarlta ekuranhala. 'Lira nhanha era iluka relha kornakakwia, korna etnakanha iwutjika. Ekuriperrantama 'Lira era alkirurna alpuka, era turtantama Altjirra ekarlta inthorraka akwala nama."]},{"type":"verse","number":4,"content":["Rretnya 'Lirantama rretnya angel-anga tjiparralkura nama. 'Lira era turta angel ingkarrakanga kngarralkura nama."]},{"type":"heading","content":["'Lira era angel ingkarrakanga kngarralkura nama"]},{"type":"verse","number":5,"content":["Etarlarai, Altjirrala itja angel nyintanha paka ilaka,",{"text":"“Unta 'Lira nuka nama,","poem":1},{"lineBreak":true},{"text":"lyartanga yinga kala kaarta ungkwanga","poem":1},{"lineBreak":true},{"text":"namantama.” Nhanha turta,","poem":1},{"lineBreak":true},{"text":"“Yinga kaarta ekura nitjina,","poem":1},{"lineBreak":true},{"text":"era turta 'Lira nuka nitjina.”","poem":1}]},{"type":"verse","number":6,"content":["Wotha, Altjirrala nhanga 'Lira arrkurlinya alkngerrakala ekuranha alhurna yairnamala, era angel ntjarranha ilaka,",{"text":"“Altjirraka angel ingkarraka ekura","poem":1},{"lineBreak":true},{"text":"urrkurrkintja nitjika.”","poem":1}]},{"type":"verse","number":7,"content":["Angel etnakiperra pula Altjirranha lakinhala angkama,",{"text":"“Angel etna wurinya ngerra wara nama,","poem":1},{"lineBreak":true},{"text":"ura ngerra wara turta.”","poem":1}]},{"type":"verse","number":8,"content":["'Liriperra pula era lakinhala angkama,",{"text":"“Unta Altjirra nama.","poem":1},{"lineBreak":true},{"text":"Unta king ngerra ngampakala","poem":1},{"lineBreak":true},{"text":"tjitjarterritjina.","poem":1},{"lineBreak":true},{"text":"Unta relha ingkarrakanha arratja","poem":1},{"lineBreak":true},{"text":"tjiperrawutjina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Unta relha etnaka kangkama, etnala","poem":1},{"lineBreak":true},{"text":"arratja ntelalhamanga.","poem":1},{"lineBreak":true},{"text":"Unta relha etnaka yirrkngerrama,","poem":1},{"lineBreak":true},{"text":"etnala korna ntelalhamanga.","poem":1},{"lineBreak":true},{"text":"Lakinhanga atha, Altjirra ungkwanganhala,","poem":1},{"lineBreak":true},{"text":"nganha urraraka.","poem":1},{"lineBreak":true},{"text":"Unta turtantama kngarralkura arrkana","poem":1},{"lineBreak":true},{"text":"nitjina,","poem":1},{"lineBreak":true},{"text":"tjina ungkwanganha ntjarrangatjina.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Era turta 'Liriperra lakinha angkama,","poem":1},{"lineBreak":true},{"text":"“Ingkartai, tjontintjala unta alha erinha","poem":1},{"lineBreak":true},{"text":"arrpmarnaka,","poem":1},{"lineBreak":true},{"text":"unta turta alkira etnanha urrkapuka,","poem":1},{"lineBreak":true},{"text":"iltja ungkwanganhala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Etna kala yirritjina.","poem":1},{"lineBreak":true},{"text":"Etna mantarra ngerra ingkwierritjina.","poem":1},{"lineBreak":true},{"text":"Unta pula kuterritjina.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mantarra tjenya ngerrantama unta","poem":1},{"lineBreak":true},{"text":"etnanha ilinyawutjina,","poem":1},{"lineBreak":true},{"text":"mantarra ingkwia ngerra turta unta","poem":1},{"lineBreak":true},{"text":"etnanha ipmintja iwutjina.","poem":1},{"lineBreak":true},{"text":"Unta pula itja kngartiwulhama.","poem":1},{"lineBreak":true},{"text":"Unta turta itja yirritjina.","poem":1}]},{"type":"verse","number":13,"content":["Altjirrala turta itja kuta angel nyintanha lakinha paka ilaka,",{"text":"“Nukanga akwampinyaka arrarnalhai,","poem":1},{"lineBreak":true},{"text":"atha leltja ungkwanganha ntjarranharrka","poem":1},{"lineBreak":true},{"text":"yirralhelitjinanga.”","poem":1}]},{"type":"verse","number":14,"content":["Iwunhantama angel etna nama? Etna kunha enka marra ntjarra nama. Altjirrala etnanha yairnama relha lenha ntjarraka tangitjala nitjika, etnanhala era tangkalhelitjinala."]}],"