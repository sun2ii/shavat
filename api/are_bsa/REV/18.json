,{"lineBreak":true},{"text":"erinha kapanha tumala,","poem":1},{"lineBreak":true},{"text":"era arrpunha ntjarraka alhwa thalakalanga,","poem":1},{"lineBreak":true},{"text":"etnanha tumala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Babylon-anha kngarra inthorra","poem":1},{"lineBreak":true},{"text":"tjurnalhakala.","poem":1},{"lineBreak":true},{"text":"Lakinhanga Altjirranhantama ekura kngarra","poem":1},{"lineBreak":true},{"text":"inthorra alkngarnterritjina,","poem":1},{"lineBreak":true},{"text":"erinha kngarra inthorra","poem":1},{"lineBreak":true},{"text":"rrukunthakunthilitjina turta.","poem":1},{"lineBreak":true},{"text":"Arai, Babylon-anha kunha lakinha eterraka,","poem":1},{"lineBreak":true},{"text":"‘Yinga kunha queen kngarra nama.","poem":1},{"lineBreak":true},{"text":"Yinga itjama warlukurterritjina.","poem":1},{"lineBreak":true},{"text":"Yinga itjama ltarrperritjina paka.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lakinhanga era arlta nyintala kuta","poem":1},{"lineBreak":true},{"text":"ilkaarta initjina, ltarrperritjina,","poem":1},{"lineBreak":true},{"text":"ngaiyalerritjina, ilutjina turta.","poem":1},{"lineBreak":true},{"text":"Mpurrka ekuranhantama etna urala etitjina.","poem":1},{"lineBreak":true},{"text":"Nhanha kala lakinherritjina,","poem":1},{"lineBreak":true},{"text":"Ingkarta Altjirra era ekarlta inthorra namanga.","poem":1},{"lineBreak":true},{"text":"Era turta erinha tjiperrawumanga.”","poem":1}]},{"type":"verse","number":9,"content":["King ingkarraka etnala ekuralela intakala, ekuralela marna kngarra ilkukala, kngarra ntjukala turta, etna kala itnitjinantama. Etna nthorrkngerritjina turta etna urakwarta erinha aramanga, era mpurlanamanga."]},{"type":"verse","number":10,"content":["Etna pula trerramala ilanga itnatjina, Babylon era kngarra mpangkamanga. Etnantama angkitjina,",{"text":"“Apu, Babylon-ai,","poem":1},{"lineBreak":true},{"text":"unta kunha town kngarritja inthorra naka,","poem":1},{"lineBreak":true},{"text":"town ekarlta inthorra turta.","poem":1},{"lineBreak":true},{"text":"Arrpunhala pula nganha hour nyintala kala","poem":1},{"lineBreak":true},{"text":"yirralhelakanta.”","poem":1}]},{"type":"verse","number":11,"content":["Yultha yirrinthanhinthanha ingkarraka turta Babylon ekura nthorrkngerritjina, relha arrpunha itjantama namanga yultha etnakanha buy-emilitjika."]},{"type":"verse","number":12,"content":["Nhanga gold etnakanha, silver, parta lantjalantja, parta tjiparra turta. Nhanga mantarra tjenya etnakanha, mantarra ntjatjintja, mantarra intorta, mantarra thathaka turta. Nhanga irna marra etnakanha, irna tjulkura, irna tjiparra turta. Nhanga irna bronze etnakanha, irna iron, irna tjiparra arrpunha turta."]},{"type":"verse","number":13,"content":["Nhanga marna kumiilanha etnakanha, irna unpa marra, myrrh, frankincense turta. Nhanga wine etnakanha, olive oil, marna wheat turta. Nhanga bullock etnakanha, sheep, nantha, wagon, relha urrkapunhapunha ntjarra turta."]},{"type":"verse","number":14,"content":["Yultha yirrinthanhinthanha etna Babylon-anha ilitjina,",{"text":"“Babylon-ai, yultha etnakala unta nhanga","poem":1},{"lineBreak":true},{"text":"kngarra antja nakala,","poem":1},{"lineBreak":true},{"text":"etna kunha kala yirraka.","poem":1},{"lineBreak":true},{"text":"Mantarra intorta, marna kumia etnala","poem":1},{"lineBreak":true},{"text":"ungkwanga intitjata,","poem":1},{"lineBreak":true},{"text":"etna turta kala yirrakantema.","poem":1},{"lineBreak":true},{"text":"Untantama etnaka yarna kuta yonthitjina.”","poem":1}]},{"type":"verse","number":15,"content":["Yultha yirrinthanhinthanha etna kunha Babylon ekuranga netaneterrakala. Etna pula aramalanga era nyingalauwumanga, etna trerraka. Etna ilanga itnaka, itnika, nthorrkngerraka turta."]},{"type":"verse","number":16,"content":["Etna lakinha ilkaka,",{"text":"“Apu, Babylon-ai, unta kunha town","poem":1},{"lineBreak":true},{"text":"kngarritja inthorra naka.","poem":1},{"lineBreak":true},{"text":"Unta marla ngerra naka,","poem":1},{"lineBreak":true},{"text":"erala mantarra intorta inthorraka","poem":1},{"lineBreak":true},{"text":"ekarralhakala,","poem":1},{"lineBreak":true},{"text":"mantarra thathakaka turta irrpukala.","poem":1},{"lineBreak":true},{"text":"Unta yultha intortaka ekarralhitjata,","poem":1},{"lineBreak":true},{"text":"gold-anga mpaarakalaka,","poem":1},{"lineBreak":true},{"text":"parta tjipurrkurlaka turta.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Arrpunhalantama yultha kngarra","poem":1},{"lineBreak":true},{"text":"ungkwanganha hour nyintala kuta","poem":1},{"lineBreak":true},{"text":"yirralhelaka.”","poem":1},"Ship-aka itornka ingkarraka, ship-ala lhanhalhanha ingkarraka, ship-aka urrkapunhapunha ingkarraka turta, ilanga itnaka. Relha etna turta, etnala yultha etnakanha pmara arrpunhurna yairnitjata ship-ala, etna turta ilanga itnakantema."]},{"type":"verse","number":18,"content":["Urakwarta erinha aramala Babylon-anga ntjinhamanga, etna ilkaka, “Town arrpunha Babylon ngerra itja naka paka.”"]},{"type":"verse","number":19,"content":["Etnantama kapurta arnala tintjawulhaka. Kngarra itnimala, nthorrkngerramala turta etna ilkaka,",{"text":"“Apu, Babylon-ai, town kngarritjai.","poem":1},{"lineBreak":true},{"text":"Ship-akakurtwia ingkarraka ungkwanganga","poem":1},{"lineBreak":true},{"text":"wara netaneterrakala.","poem":1},{"lineBreak":true},{"text":"Kala hour nyintala kutantama arrpunhala","poem":1},{"lineBreak":true},{"text":"nganha yirralhelaka.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“Alkirarinya ntjarrai, rrangkarra pula","poem":1},{"lineBreak":true},{"text":"arrkanerritjikala.","poem":1},{"lineBreak":true},{"text":"Relha alkngaltara ntjarrai, apostle","poem":1},{"lineBreak":true},{"text":"ntjarrai, Altjirraka urrpia ntjarrai,","poem":1},{"lineBreak":true},{"text":"rrangkarra turta arrkanerritjikantema.","poem":1},{"lineBreak":true},{"text":"Altjirrala kunha Babylon-anha rrarrathala","poem":1},{"lineBreak":true},{"text":"tuka,","poem":1},{"lineBreak":true},{"text":"Babylon-ala rrangkarranha tukala ngerra.”","poem":1}]},{"type":"verse","number":21,"content":["Angel ekarltalantama parta tnyana ngerra kngarritja inthorra tjurnaka, laiyaka iwuka turta. Era angkaka,",{"text":"“Parta nhanha yirraka atha erinha kwatjaka","poem":1},{"lineBreak":true},{"text":"iwukalanga.","poem":1},{"lineBreak":true},{"text":"Lakinha ngerra Babylon-anha turta","poem":1},{"lineBreak":true},{"text":"yirritjinantema,","poem":1},{"lineBreak":true},{"text":"Altjirrala erinha rrarrathala tumalanga.","poem":1},{"lineBreak":true},{"text":"Arrpunhala erinha itja wotha arltaritjina.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Babylon ekurala, relhala itja wotha","poem":1},{"lineBreak":true},{"text":"music wutjina.","poem":1},{"lineBreak":true},{"text":"Music nhanga harp-akanha paka,","poem":1},{"lineBreak":true},{"text":"trumpet-akanhalka paka.","poem":1},{"lineBreak":true},{"text":"Relhala turta itja wotha wutjina,","poem":1},{"lineBreak":true},{"text":"relha arrpunha Babylon-ala urrkapumanga,","poem":1},{"lineBreak":true},{"text":"marna paka thamanga, parta tnyanala.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ingula irna parrtjakanha itja wotha","poem":1},{"lineBreak":true},{"text":"Babylon-ala mputjina.","poem":1},{"lineBreak":true},{"text":"Relhala turta itja wotha wutjina noarta","poem":1},{"lineBreak":true},{"text":"lheloalhelarramanga paka.","poem":1},{"lineBreak":true},{"text":"Arai, nhanha lakinherritjina Babylon-aka","poem":1},{"lineBreak":true},{"text":"yirrinthanhinthanha ntjarra","poem":1},{"lineBreak":true},{"text":"tjurnalhakalanga inthorra.","poem":1},{"lineBreak":true},{"text":"Era turta relha ingkarrakanha arrangkultha","poem":1},{"lineBreak":true},{"text":"ekuranhala kornilakalanga.","poem":1}]},{"type":"verse","number":24,"content":