{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"1CH","translationId":"asm_irv","name":"1 বংশাৱলি","commonName":"1 বংশাৱলি","title":"1 বংশাৱলি","order":13,"numberOfChapters":29,"sha256":"890d917a83c030579de4878e31e9a82cb197972ecaca34e0faa4fa775ad534a9","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/asm_irv/1CH/29.json","totalNumberOfVerses":934},"chapter":{"number":3,"content":[{"type":"heading","content":["দায়ূদৰ সন্তান সকলৰ তালিকা।"]},{"type":"verse","number":1,"content":["হিব্ৰোণত জন্ম হোৱা দায়ূদৰ সন্তান সকলৰ নাম:",{"text":"তেওঁৰ প্ৰথম পুত্র অম্নোন, তেওঁ যিজ্ৰিয়েলীয়া অহীনোৱমৰ পুত্র;","poem":1},{"lineBreak":true},{"text":"দ্বিতীয় দানিয়েল, তেওঁ কৰ্মিলীয়া অবীগলৰ পুত্র;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তৃতীয় অবচালোম, তেওঁ গচুৰৰ তল্ময় ৰজাৰ জীয়েক মাখাৰ পুত্র;","poem":1},{"lineBreak":true},{"text":"চতুৰ্থ অদোনীয়া, তেওঁ হগ্গীতৰ পুত্র;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"পঞ্চম চফটিয়া, তেওঁ অবীটলৰ পুত্র;","poem":1},{"lineBreak":true},{"text":"ষষ্ঠ যিত্ৰিয়ম, তেওঁৰ ভাৰ্যা ইগ্লাৰ পুত্র;","poem":1}]},{"type":"verse","number":4,"content":["দায়ূদৰ এই ছয়জন পুত্র হিব্ৰোণত জন্ম হৈছিল; এই ঠাইত তেওঁ সাত বছৰ ছমাহ ৰাজত্ব কৰিছিল। তাৰ পাছত তেওঁ যিৰূচালেমত তেত্ৰিশ বছৰ ৰাজত্ব কৰিছিল।"]},{"type":"verse","number":5,"content":["যিৰূচালেমত অম্মীয়েলৰ জীয়েক বৎ-চূৱাৰ পৰা জন্মা তেওঁৰ চাৰি জন পুত্রৰ নাম: চিমিয়া, চোবব, নাথন, আৰু চলোমন।"]},{"type":"verse","number":6,"content":[{"text":"দায়ূদৰ আন আৰু ন জন পুত্রৰ নাম","poem":1},{"lineBreak":true},{"text":"যিভৰ, ইলীচামা, ইলীফেলট,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"নোগহ, নেফগ, যাফীয়া,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ইলীচামা, ইলিয়াদা, আৰু ইলীফেলট,","poem":1}]},{"type":"verse","number":9,"content":["উপপত্নীসকলৰ পৰা হোৱা সন্তান সকলক বাদ দি এইসকলো দায়ূদৰ সন্তান; তামাৰ তেওঁলোকৰ ভনীয়েক আছিল।"]},{"type":"verse","number":10,"content":["চলোমনৰ পুত্র ৰহবিয়াম।",{"text":"ৰহবিয়ামৰ পুত্র অবিয়া।","poem":1},{"lineBreak":true},{"text":"অবিয়াৰ পুত্র আচা।","poem":1},{"lineBreak":true},{"text":"আচাৰ পুত্র যিহোচাফট;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"যিহোচাফটৰ পুত্র যোৰাম;","poem":1},{"lineBreak":true},{"text":"যোৰামৰ পুত্র অহজিয়া;","poem":1},{"lineBreak":true},{"text":"অহজিয়াৰ পুত্র যোৱাচ;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"যোৱাচৰ পুত্র অমচিয়া;","poem":1},{"lineBreak":true},{"text":"অমচিয়াৰ পুত্র অজৰিয়া;","poem":1},{"lineBreak":true},{"text":"অজৰিয়াৰ পুত্র যোথম;","poem":1},{"lineBreak":true},{"text":"যোথমৰ পুত্র আহজ;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"আহজৰ পুত্র হিষ্কিয়া;","poem":1},{"lineBreak":true},{"text":"হিষ্কিয়াৰ পুত্র মনচি;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"মনচিৰ পুত্র আমোন;","poem":1},{"lineBreak":true},{"text":"আমোনৰ পুত্র যোচিয়া।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যোচিয়াৰ প্ৰথম পুত্র যোহানন, দ্বিতীয় যিহোয়াকীম, তৃতীয় চিদিকিয়া, আৰু চতুৰ্থ চল্লুম।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"যিহোয়াকীমৰ পুত্র যকনিয়া, শেষৰ জন ৰজা আছিল চিদিকিয়া।","poem":1}]},{"type":"verse","number":17,"content":["বন্দী কৰি নিয়া যকনিয়াৰ পুত্রসকল, চল্টীয়েল,"]},{"type":"verse","number":18,"content":["মল্কিৰাম, পদায়া, চিনচৰ, যকমিয়া, হোচামা, আৰু নদবিয়া।"]},{"type":"verse","number":19,"content":["পদায়াৰ পুত্র জৰুব্বাবিল আৰু চিমিয়ী; জৰুব্বাবিলৰ পুত্র মচূল্লম আৰু হননিয়া; আৰু চলোমীৎ তেওঁলোকৰ ভনীয়েক আছিল।"]},{"type":"verse","number":20,"content":["তেওঁৰ আন পাঁচ জন পুত্র হ’ল হচূবা, ওহেল, বেৰেখিয়া, হচদিয়া আৰু যুচবহচেদ।"]},{"type":"verse","number":21,"content":["হননিয়াৰ বংশধৰ সকল পলটিয়া, যিচয়া আৰু ৰফায়াৰ সন্তান সকল হ’ল অৰ্ণনৰ, ওবদিয়াৰ, আৰু চখনিয়া।"]},{"type":"verse","number":22,"content":["চখনিয়াৰ পুত্র চমৰিয়া। আৰু চমৰিয়াৰ ছয় জন পুত্র হ’ল হটূচ, যিগাল, বাৰীহ, নিয়ৰিয়া, আৰু চাফট।"]},{"type":"verse","number":23,"content":["নিয়ৰিয়াৰ তিনি জন পুত্র হ’ল ইলীয়োঐনয়, হিষ্কিয়া, আৰু অজ্ৰীকাম।"]},{"type":"verse","number":24,"content":["ইলীয়োঐনয়ৰ সাত জন পুত্র হ’ল হোদবিয়া, ইলিয়াচীব, পলায়া, অক্কুব, যোহানন, দলায়া, আৰু অনানী।"]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/1CH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/1CH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/1CH/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}