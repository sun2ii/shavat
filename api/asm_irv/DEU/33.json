{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"DEU","translationId":"asm_irv","name":"দ্বিতীয় বিৱৰণ","commonName":"দ্বিতীয় বিৱৰণ","title":"দ্বিতীয় বিৱৰণ","order":5,"numberOfChapters":34,"sha256":"d8033fda13d570e9d7b1fca14cc43cc5bc439b9b919ff79ff96dfe89a58d7d65","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/asm_irv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["ইস্রায়েলীয়াসকললৈ মোচিৰ অন্তিম আশীৰ্ব্বাদ"]},{"type":"verse","number":1,"content":["তাৰ পাছত ঈশ্বৰৰ লোক মোচিয়ে তেওঁৰ মৃত্যুৰ আগেয়ে ইস্ৰায়েলীয়া সন্তান সকলক আশীৰ্ব্বাদ কৰিলে।"]},{"type":"verse","number":2,"content":["তেওঁ ক’লে,",{"text":"যিহোৱা চীনয় পৰ্ব্বতৰ পৰা আহিল,","poem":1},{"lineBreak":true},{"text":"তেওঁ চেয়ীৰৰ পৰা তেওঁলোকৰ ওপৰত উদয় হ’ল;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ জ্যোতি পাৰণ পৰ্ব্বতৰ পৰা জিলিকি উঠিল","poem":1},{"lineBreak":true},{"text":"তেওঁ অযুত অযুত পবিত্ৰসকলৰ মাজৰ পৰা আহিল।","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সোঁ হাতত আছিল তেওঁলোকৰ কাৰণে বিজুলীৰ চমক ভৰা ব্যৱস্থা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সঁচাই তেওঁ নিজৰ","poem":1},{"lineBreak":true},{"text":"লোকসকলক প্ৰেম কৰে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সকলো পবিত্ৰ লোক তেওঁৰ হাতত আছিল;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক সকলো তেওঁৰ ভৰিত নত হ’ল;","poem":1},{"lineBreak":true},{"text":"প্ৰতিজনে তেওঁৰ বাক্য গ্ৰহণ কৰিলে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মই, মোচিয়ে আপোনালোকক এক ব্যৱস্থাৰ আজ্ঞা দিলোঁ,","poem":1},{"lineBreak":true},{"text":"এই ব্যৱস্থা যাকোবৰ বংশধৰসকলৰ বাবে এক উত্তৰাধিকাৰ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যেতিয়া ইস্রায়েলৰ মুখ্য লোকসকল গোট খালে, আৰু","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েলৰ সকলো ফৈদ একত্রিত হ’ল,","poem":1},{"lineBreak":true},{"text":"তেতিয়া যিহোৱাই আছিল যিচুৰূণৰ","poem":1},{"noteId":8},{"text":"ৰজা।","poem":1}]},{"type":"heading","content":["বাৰ ফৈদৰ প্রতি আশীর্বাদ"]},{"type":"verse","number":6,"content":[{"text":"ৰূবেণ জীয়াই থাকক, নমৰক; কিন্তু তেওঁৰ গোষ্ঠীৰ লোক লেখত অলপ হওক।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যিহূদাক দিয়া আশীৰ্ব্বাদ এই: মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“হে যিহোৱা, তুমি যিহূদাৰ মাত শুনা,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ লোকসকলৰ মাজলৈ তেওঁক পুনৰ ঘূৰাই আনা,","poem":1},{"lineBreak":true},{"text":"তোমাৰ হাতেৰে তেওঁৰ বাবে যুদ্ধ কৰা;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ শত্ৰুবোৰৰ বিৰুদ্ধে এক সহায় হোৱা।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"লেবীৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“লেবী, তোমাৰ ভক্তৰ লগত তোমাৰ তুম্মীম আৰু উৰীম","poem":1},{"noteId":9},{"text":"আছে;","poem":1},{"lineBreak":true},{"text":"মচ্ছাত তুমি যাৰ পৰীক্ষা কৰিছিলা,","poem":1},{"lineBreak":true},{"text":"মিৰীবাৰ পানীৰ ওচৰত যাৰ সৈতে বিবাদ কৰিছিলা,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিজনে নিজ পিতৃ আৰু মাতৃৰ বিষয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"‘মই তেওঁলোকক দেখা নাই।’","poem":1},{"lineBreak":true},{"text":"নিজৰ ভাই-ককাইক স্বীকাৰ নকৰিলে,","poem":1},{"lineBreak":true},{"text":"এনেকি নিজৰ সন্তানবোৰকে নিচিনিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁ তোমাৰ বাক্যক পহৰা দিছে আৰু","poem":1},{"lineBreak":true},{"text":"তোমাৰ ব্যৱস্থা ৰক্ষা কৰিছে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"লেবীসকলে তোমাৰ আজ্ঞাবোৰ যাকোবক শিকায়,","poem":1},{"lineBreak":true},{"text":"ব্যৱস্থাবোৰ ইস্ৰায়েলক শিকায়;","poem":1},{"lineBreak":true},{"text":"তোমাৰ আগত ধূপ জ্বলায়,","poem":1},{"lineBreak":true},{"text":"যজ্ঞ-বেদিৰ ওপৰত হোমবলি উৎসৰ্গ কৰে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তুমি তেওঁৰ তাৰ সম্পত্তিত আশীৰ্ব্বাদ কৰা,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সকলো হাতৰ কাৰ্য গ্ৰহণ কৰা;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ বিৰুদ্ধে উঠা শত্রুবোৰৰ কঁকাল ভাঙি দিয়া;।","poem":1},{"lineBreak":true},{"text":"তেওঁক ঘিণাওঁতাসকলৰ কঁকাল ভাঙি দিয়া, যাতে পুনৰ উঠিব নোৱাৰে।”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"বিন্যামীনৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“যিহোৱাই যাক প্রেম কৰে,","poem":1},{"lineBreak":true},{"text":"বিন্যামীন তেওঁৰ ওচৰত নিৰ্ভয়ে থাকে;","poem":1},{"lineBreak":true},{"text":"যিহোৱাই ওৰে দিনটো তেওঁক আৱৰি ৰাখে,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁ যিহোৱাৰ দুই বাহুৰ মাজত বাস কৰে।”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যোচেফৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“আকাশৰ উত্তম দান আৰু নিয়ৰেৰে সৈতে,","poem":1},{"lineBreak":true},{"text":"তলত ব্যাপি থকা সাগৰেৰে,","poem":1},{"lineBreak":true},{"text":"যিহোৱাই যোচেফৰ দেশক আশীৰ্ব্বাদ কৰক।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"সূৰ্যৰ তাপৰ উৎকৃষ্ট ফলেৰে,","poem":1},{"lineBreak":true},{"text":"মাহবোৰৰ উত্তম শস্যৰে,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"পুৰণি পৰ্ব্বতবোৰৰ অতি উত্তম সম্পদেৰে,","poem":1},{"lineBreak":true},{"text":"চিৰকালৰ পাহাৰবোৰৰ বহুমূলীয়া বস্তুৰে,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"পৃথিবীৰ উত্তম উত্তম দ্ৰব্যৰ প্রচুৰতাৰে,","poem":1},{"lineBreak":true},{"text":"আৰু জ্বলন্ত জোপোহাৰ মাজত যি জনা আছিল, তেওঁৰ আনুগ্রহেৰে সৈতে -","poem":1},{"lineBreak":true},{"text":"যোচেফৰ মূৰত,","poem":1},{"lineBreak":true},{"text":"যিজন ভাই-ককাইসকলৰ মাজত ৰাজপুত্র আছিল,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ কপালত এই সকলো আশীর্বাদ পৰক।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"যোচেফৰ মহিমা প্ৰথমে ওপজা এটা ষাঁড়,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ শিং দুটা বনৰীয়া ষাঁড়ৰ শিঙৰ দৰে;","poem":1},{"lineBreak":true},{"text":"তাৰ দ্বাৰাই তেওঁ সকলো জাতিকে বিদ্ধ কৰিব,","poem":1},{"lineBreak":true},{"text":"এনেকি পৃথিবীৰ অন্তলৈকে জাতিবোৰক ঠেলি নিব;","poem":1},{"lineBreak":true},{"text":"এইদৰেই ইফ্ৰয়িমৰ অযুত অযুত আৰু মনচিৰ হাজাৰ হাজাৰ লোক হ’ব।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"জবূলূনৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"হে জবুলুন, তুমি বাহিৰলৈ যোৱা কালত আনন্দিত হোৱা,","poem":1},{"lineBreak":true},{"text":"আৰু হে ইচাখৰ, তুমি নিজ তম্বুত আনন্দ কৰা।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"লোকসকলক তেওঁলোকে পৰ্ব্বতলৈ মাতি পঠাব;","poem":1},{"lineBreak":true},{"text":"সেই ঠাইত তেওঁলোকে যোগ্য মনোভাৱেৰে বলি উৎসৰ্গ কৰিব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে সমুদ্ৰৰ প্রচুৰ সমৃদ্ধি আৰু বালিৰ পৰা গুপুত ধন চুহিব।”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"গাদৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“যিজনাই গাদৰ ৰাজ্যৰ সীমা বঢ়াব, সেই জনা ধন্য;","poem":1},{"lineBreak":true},{"text":"গাদে সিংহৰ দৰে বাস কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁ বাহু, এনেকি মূৰৰ তালুকো বিদাৰে।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ কাৰণে উৎকৃষ্ট ভাগ মনোনীত কৰিলে,","poem":1},{"lineBreak":true},{"text":"কিয়নো সেই ঠাইত নেতাৰ যোগ্য লোকৰ কাৰণে ভাগ ৰাখি থোৱা আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁ লোক সকলৰ মুখ্যৰ লগত আহিল।","poem":1},{"lineBreak":true},{"text":"তেওঁ যিহোৱাৰ ন্যায় কাৰ্য সিদ্ধ কৰিলে, আৰু","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েলৰ সৈতে যিহোৱাৰ নিয়ম পালন কৰিলে।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"দানৰ বিষয়ে মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“দান বাচানৰ পৰা জাপ মাৰি অহা যুৱা সিংহ।”","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"নপ্তালীৰ বিষয়ে মোচিয়ে কলে,","poem":1},{"lineBreak":true},{"text":"“হে নপ্তালী, তুমি যিহোৱাৰ অনুগ্ৰহেৰে তৃপ্ত, আৰু","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ আশীৰ্ব্বাদেৰে পৰিপূৰ্ণ;","poem":1},{"lineBreak":true},{"text":"পশ্চিম আৰু দক্ষিণ অঞ্চল অধিকাৰ কৰা।”","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"আচেৰৰ বিষয়ে মোচিয়ে কলে,","poem":1},{"lineBreak":true},{"text":"“আন সন্তান সকলতকৈ আচেৰে অধিক আশীৰ্ব্বাদ পাওক;","poem":1},{"lineBreak":true},{"text":"তেওঁ যেন নিজৰ ভাই-ককাইসকলৰ প্রিয় হয়,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ ভৰি দুখন যেন জলফাইৰ তেলত ডুবি থাকে।","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"তোমাৰ নগৰৰ ডাংবোৰ লোহা বা পিতলৰ হ’ব;","poem":1},{"lineBreak":true},{"text":"যিমানদিন তোমাৰ আয়ুস থাকিব,","poem":1},{"lineBreak":true},{"text":"সিমানদিন তোমাৰ শক্তি থাকিব।”","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"মোচিয়ে ক’লে,","poem":1},{"lineBreak":true},{"text":"“হে যিচুৰূণ, ঈশ্বৰৰ তুল্য কোনো নাই;","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ সহায়ৰ কাৰণে তেওঁ","poem":1},{"lineBreak":true},{"text":"নিজ গৌৰৱেৰে মেঘৰথত উঠি","poem":1},{"lineBreak":true},{"text":"আকাশ পথত অহা যোৱা কৰে।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"যিজন অনাদিকালৰ ঈশ্বৰ","poem":1},{"lineBreak":true},{"text":"তেৱেঁই নিজৰ লোকসকলৰ আশ্রয়,","poem":1},{"lineBreak":true},{"text":"অধোদেশত তেওঁ চিৰস্থায়ী বাহুৰে ধৰি ৰাখে;","poem":1},{"lineBreak":true},{"text":"তেওঁ তোমালোকৰ সন্মুখৰ পৰা শত্ৰুবোৰক দূৰ কৰিব,","poem":1},{"lineBreak":true},{"text":"তেওঁ ক’ব, ‘এওঁলোকক ধ্বংস কৰা!’","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ইস্ৰায়েল জাতিয়ে নিৰ্ভয়েৰে বাস কৰিব;","poem":1},{"lineBreak":true},{"text":"যাকোবৰ ভুমুক শস্য আৰু","poem":1},{"lineBreak":true},{"text":"নতুন দ্রাক্ষাৰসৰ দেশত নিৰাপদ হ’ব;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ ওপৰত আকাশৰ নিয়ৰ টোপা টোপে পৰক।","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"হে ইস্ৰায়েল, তুমি ধন্য;","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ দ্বাৰাই নিস্তাৰ পোৱা জাতি যি তোমালোক,","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ সদৃশ কোন আছে?","poem":1},{"lineBreak":true},{"text":"তেওঁ তোমালোকৰ সাহার্যকাৰী ঢাল,","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ গৌৰৱৰ তৰোৱাল;","poem":1},{"lineBreak":true},{"text":"শত্ৰুবোৰ তোমালোকৰ ওচৰলৈ কম্পমান হৈ আহিব;","poem":1},{"lineBreak":true},{"text":"তোমালোকে ওখ ঠাইবোৰত ভৰি দিবা।”","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"যিচুৰণৰ অর্থাৎ ইস্রায়েলৰ","reference":{"chapter":33,"verse":5}},{"noteId":9,"caller":"+","text":"যাত্রা 28:30","reference":{"chapter":33,"verse":8}}]},"thisChapterLink":"/api/asm_irv/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}