{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"EST","translationId":"asm_irv","name":"ইষ্টেৰ","commonName":"ইষ্টেৰ","title":"ইষ্টেৰ","order":17,"numberOfChapters":10,"sha256":"7f971db8ceaee56f40d018d90d38c5174b64d14251447a527f652b5c1df365ae","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/asm_irv/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["তাৰ পাছত ৰজা অহচবেৰোচে দেশত, আৰু সমুদ্ৰৰ পাৰত থকা দেশবোৰত কৰ ধাৰ্য্য কৰিলে।"]},{"type":"verse","number":2,"content":["তেওঁৰ ক্ষমতা আৰু পৰাক্ৰমৰ সকলো কথা, ৰজাই মৰ্দখয়ক যি মহত্ত্ব দি ওখ পদত তুলিছিল, তাৰ সম্পূৰ্ণ বৃত্তান্ত মাদিয়া আৰু পাৰস্যৰ ৰজা সকলৰ ইতিহাস পুস্তকত লিখা আছে।"]},{"type":"verse","number":3,"content":["যিহুদী মৰ্দখয় ৰজা অহচবেৰোচ দ্বিতীয় স্থানত আছিল। যিহুদী লোক সকলৰ মাজত তেওঁ মহৎ আছিল, আৰু তেওঁৰ অনেক যিহুদী ভাই সকলৰ মাজত জনাজাত আছিল। কিয়নো তেওঁ নিজৰ লোক সকলৰ হিত চিন্তা কৰিছিল; আৰু তেওঁলোকৰ শান্তিৰ বাবে কথা কৈছিল।"]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}