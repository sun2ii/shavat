{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"JOB","translationId":"asm_irv","name":"ইয়োব","commonName":"ইয়োব","title":"ইয়োব","order":18,"numberOfChapters":42,"sha256":"e68aeca30b503eb8e84e522714361410995e6149437774fa185c4d906c19f7bf","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/asm_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["মোৰ উশাহ বিকৃত হৈছে, মোৰ দিনৰ অন্ত পৰিছে;",{"text":"মোলৈ মৈদাম যুগুত আছে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"নিশ্চয়ে ঠাট্টা কৰোঁতাবোৰ মোৰ ওচৰত আছে,","poem":1},{"lineBreak":true},{"text":"আৰু সিহঁতে দিয়া বিৰক্তিবোৰ মোৰ চকুৰ আগত আছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"বিনয় কৰোঁ, তুমি মোৰ নিৰ্দ্দোষীতা প্ৰকাশ কৰাৰ এটা চিন থোৱা;","poem":1},{"lineBreak":true},{"text":"নিজৰ আগত নিজেই মোৰ জামিন হোৱা;","poem":1},{"lineBreak":true},{"text":"আন কোনেও মোৰ জামিন হ’বলৈ স্বীকাৰ কৰিব?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিয়নো তুমি এওঁলোকৰ চিত্ত জ্ঞানৰ পৰা আঁৰ কৰিছা;","poem":1},{"lineBreak":true},{"text":"এই হেতুকে তুমি এওঁলোকক মোক জয় কৰিবলৈ নিদিবা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিকোনোৱে নিজ বন্ধুক লুটদ্ৰব্য স্বৰূপে সমৰ্পণ কৰে,","poem":1},{"lineBreak":true},{"text":"তেনে বন্ধুৰ সন্তানবোৰৰ চকু অন্ধ হ’ব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁ মোক লোকসকলৰ আগত দৃষ্টান্ত কৰিলে;","poem":1},{"lineBreak":true},{"text":"যাৰ মুখত লোকে থু পেলায়, মই তেনে মানুহ হ’লো।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মনৰ বেজাৰত মোৰ চকু নিস্তেজ হ’ল,","poem":1},{"lineBreak":true},{"text":"আৰু মোৰ সকলো অঙ্গ-প্ৰত্যঙ্গ ছাঁৰ তুল্য হ’ল।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ইয়াতে সৰল আচৰণ কৰোঁতাবোৰে আচৰিত মানিব,","poem":1},{"lineBreak":true},{"text":"আৰু অধৰ্মিৰ বিৰুদ্ধে নিৰ্দ্দোষী জঁকি উঠিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তথাপি ধাৰ্মিকে নিজ পথত চলি থাকিব;","poem":1},{"lineBreak":true},{"text":"যাৰ হাত শুচি, তাৰ বল ক্ৰমে ক্ৰমে বাঢ়ি থাকিব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কিন্তু আহাঁ, তোমালোক সকলোৱে পুনৰায় আৰম্ভ কৰা;","poem":1},{"lineBreak":true},{"text":"আৰু মই তোমালোকৰ মাজত কাকো জ্ঞানী নাপাওঁ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"মোৰ দিন কেইটা গ’ল, মোৰ অভিপ্ৰায় শেষ হৈছে,","poem":1},{"lineBreak":true},{"text":"এনে কি মোৰ হৃদয়ৰ শুভেচ্ছা জনোৱা হ’ল।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"সেই মানুহবোৰ বিদ্ৰূপকাৰী, সিহঁতে ৰাতিক দিনলৈ ৰূপান্তৰিত কৰে,","poem":1},{"lineBreak":true},{"text":"পোহৰ আহিলে সিহঁতে কয়, অন্ধকাৰ ওচৰ চাপি আহিছে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যদি চিয়োলেই মোৰ ঘৰ হ’ব বুলি মই অপেক্ষা কৰিছোঁ,","poem":1},{"lineBreak":true},{"text":"যদি আন্ধাৰত মোৰ শয্যা পাৰিছোঁ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"যদি মই গাতক মোৰ পিতৃ,","poem":1},{"lineBreak":true},{"text":"আৰু পোকক, তুমি মোৰ মাতৃ আৰু ভনী বুলি কৈছা,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তেনেহ’লে মোৰ আশা ক’ত?","poem":1},{"lineBreak":true},{"text":"আৰু মোৰ আশাক নো কোনে দেখা পাব?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"আশাৰ সৈতে নামি গৈ মই চিয়োলৰ দুৱাৰমুখ পাম","poem":1},{"lineBreak":true},{"text":"কেতিয়া ধূলিত গৈ জিৰণী পাম?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}