{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"JOB","translationId":"asm_irv","name":"ইয়োব","commonName":"ইয়োব","title":"ইয়োব","order":18,"numberOfChapters":42,"sha256":"e68aeca30b503eb8e84e522714361410995e6149437774fa185c4d906c19f7bf","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/asm_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["ইয়োবৰ উত্তৰ।"]},{"type":"verse","number":1,"content":["তেতিয়া ইয়োবে পুনৰায় উত্তৰ কৰি কলে,"]},{"type":"verse","number":2,"content":[{"text":"“তুমি দুৰ্ব্বলক বৰ সহায় কৰিলা!","poem":1},{"lineBreak":true},{"text":"আৰু বল নথকা বাহুক বৰ নিস্তাৰ কৰিলা!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"আৰু জ্ঞানহীনক বৰ পৰামৰ্শ দিলা!","poem":1},{"lineBreak":true},{"text":"আৰু মূল কথা বৰ ভালকৈ বুজালা!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তুমি নো কাৰ আগত কথা কলা?","poem":1},{"lineBreak":true},{"text":"কাৰ নিশ্বাস নো তোমাৰ মুখৰ পৰা ওলাল?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"বিল্দদে উত্তৰ কৰি ক’লে, “যি সকল সম্প্রতি মৃত, অবহেলিত, উদ্বিগ্ন,","poem":1},{"lineBreak":true},{"text":"যিসকলে জল সমূহৰ তলত নিবাস কৰে ---","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁৰ আগত চিয়োল অনাবৃত,","poem":1},{"lineBreak":true},{"text":"আৰু বিনাশৰ ঠাইৰ ঢাকনি নাই।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তেওঁ শূন্যৰ ওপৰত উত্তৰৰ আকাশ বিস্তৰ কৰে,","poem":1},{"lineBreak":true},{"text":"আৰু পৃথিবীক শূন্যত ওলোমাই থয়।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ ঘন মেঘত জল বন্ধ কৰে;","poem":1},{"lineBreak":true},{"text":"তথাপি জলৰ ভৰত মেঘ নাফাটে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তেওঁ পূৰ্ণিমাৰ চন্দ্রৰ মূখ ঢাকি দিয়ে,","poem":1},{"lineBreak":true},{"text":"আৰু তাৰ ওপৰত তেওঁৰ মেঘ বিস্তাৰ কৰে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যি ঠাইত আন্ধাৰ আৰু পোহৰ লগ লাগিছে,","poem":1},{"lineBreak":true},{"text":"সেই ঠাইকে তেওঁ সীমা কৰি সমুদ্ৰৰ ওপৰত চক্ৰাকাৰ ৰেখা আঁকে,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তেওঁৰ ধমকিত আকাশ-মণ্ডলৰ স্তম্ভবোৰ কঁপে,","poem":1},{"lineBreak":true},{"text":"আৰু বিচুৰ্ত্তি হয়,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ পৰাক্ৰমেৰে সাগৰকো আস্ফালন কৰায়,","poem":1},{"lineBreak":true},{"text":"আৰু নিজ বুদ্ধিৰে ৰাহবক ডোখৰ ডোখৰ কৰে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"তেওঁৰ আত্মাৰ দ্ধাৰাই আকাশ-মণ্ডল বিভুষিত হয়;","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁৰ হাতে পলাই যোৱা নাগটোক খুচি মাৰিলে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"চোৱা, এইবোৰ তেওঁৰ কাৰ্যবোৰৰ কণিকা মাথোন,","poem":1},{"lineBreak":true},{"text":"আৰু আমি তেওঁৰ বিষয়ে কেনে সৰু ফুচফুচনি শুনিছো!","poem":1},{"lineBreak":true},{"text":"কিন্তু তেওঁৰ পৰাক্ৰমৰ গৰ্জ্জন কোনে বুজিব পাৰে?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}