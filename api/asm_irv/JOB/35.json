{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"JOB","translationId":"asm_irv","name":"ইয়োব","commonName":"ইয়োব","title":"ইয়োব","order":18,"numberOfChapters":42,"sha256":"e68aeca30b503eb8e84e522714361410995e6149437774fa185c4d906c19f7bf","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/asm_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["ইলীহুৰ তৃতীয় বক্তৃতা।"]},{"type":"verse","number":1,"content":["পাছত ইলীহুৱে আৰু উত্তৰ কৰি কলে,"]},{"type":"verse","number":2,"content":[{"text":"“মোৰ কি উপকাৰ?","poem":1},{"lineBreak":true},{"text":"বা মই পাপ কৰা লাভতকৈ মোৰ কি অধিক লাভ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"এই বুলি যে তুমি কৈছা, ইয়াক তুমি ন্যায় বুলি ভাবিছা নে?","poem":1},{"lineBreak":true},{"text":"বা ঈশ্বৰৰ ধাৰ্মিকতাকৈ মোৰ ধাৰ্মিকতা অধিক,","poem":1},{"lineBreak":true},{"text":"এই বুলি কৈছানে?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মই তোমাক আৰু তোমাৰ লগৰ তোমাৰ বন্ধুবিলাককো উত্তৰ দিওঁ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তুমি চকু তুলি আকাশৰ ফাললৈ চোৱা,","poem":1},{"lineBreak":true},{"text":"তোমাতকৈ ওখত থকা গগণ-মণ্ডললৈ নিৰীক্ষণ কৰা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তুমি পাপ কৰিলে, তেওঁৰ কি হানি কৰিব পাৰা?","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ অপৰাধ অধিক হলে তুমি তেওঁ কি কৰিবা?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তুমি ধাৰ্মিক হলে, তেওঁক কি দিব পাৰা?","poem":1},{"lineBreak":true},{"text":"বা তেওঁ তোমাৰ হাতৰ পৰা কি গ্ৰহণ কৰিব?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমাৰ দুষ্টতাই তোমাৰ নিচিনা মানুহৰহে হানি কৰিব পাৰে,","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ ধাৰ্মিকতা মনুষ্য সন্তানৰহে উপকাৰী হব পাৰে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"অধিক উপদ্ৰৱ পোৱাত লোকবিলাকে কাতৰোক্তি কৰে,","poem":1},{"lineBreak":true},{"text":"আৰু বলৱান বিলাকৰ বাহুৰ কাৰণে উপকাৰ পাবলৈ চিঞঁৰে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যি জনাই ৰাতি গীত গোৱাই,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"যি জনাই পৃথিবীৰ পশুবোৰতকৈ আমাক বেছিকৈ শিক্ষা দিছে,","poem":1},{"lineBreak":true},{"text":"আৰু যি জনাই আমাক আকাশৰ চৰাই-চিৰিকটিতকৈ বেছি জ্ঞানী কৰিছে মোৰ সেই সৃষ্টিকৰ্ত্তা ঈশ্বৰ ক’ত? এই বুলি সিবিলাকৰ কোনেও নকয়।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তেতিয়া সিবিলাকে দুষ্টবোৰৰ অহঙ্কাৰৰ কাৰণে কাতৰোক্তি কৰে,","poem":1},{"lineBreak":true},{"text":"কিন্তু তেওঁ উত্তৰ নিদিয়ে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"বাস্তৱিক ঈশ্বৰে অসাৰ কথা নুশুনে,","poem":1},{"lineBreak":true},{"text":"আৰু সৰ্ব্বশক্তিমান জনাই তাক নাচাবও।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তেন্তে তুমি তেওঁক নেদেখো বুলি কলে, তেওঁ জানো শুনিব,","poem":1},{"lineBreak":true},{"text":"তোমাৰ গোচৰ তেওঁৰ আগত আছে, তুমি তেওঁলৈ বাট চাই থাকিবা।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"কিন্তু তেওঁ তেওঁৰ কোপত শাস্তি নিদিয়ে,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁ অপৰাধলৈ বৰকৈ মন নিদিয়ে;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"এই নিমিত্তে ইয়োবে অসাৰ কথা কবলৈ মুখ মেলিছে,","poem":1},{"lineBreak":true},{"text":"অনেক জ্ঞানশূন্য কথা কৈছে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}