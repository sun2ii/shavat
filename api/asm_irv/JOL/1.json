{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"JOL","translationId":"asm_irv","name":"যোৱেল","commonName":"যোৱেল","title":"যোৱেল","order":29,"numberOfChapters":3,"sha256":"304fc9aea38ef60ad1433c9a3d5d20435068beb2329909b5be9245a0feb2d96b","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/asm_irv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["বৰ্ত্তমানৰ আপদৰ বিষয়।"]},{"type":"verse","number":1,"content":["পথূৱেলৰ পুত্ৰ যোৱেললৈ অহা এইটো যিহোৱাৰ বাক্য।"]},{"type":"verse","number":2,"content":[{"text":"হে পৰিচাৰকসকল, এই কথা শুনা?","poem":1},{"lineBreak":true},{"text":"আৰু হে দেশনিবাসীসকল, কাণ দিয়া। তোমালোকৰ দিনত বা তোমালোকৰ পূৰ্বপুৰুষসকলৰ দিনত এনে ঘটিছিল নে?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমালোকে নিজ নিজ সন্তান সকলক এই বিষয়ে কোৱা,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকেও নিজ নিজ সন্তান সকলক কওঁক,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকৰ সন্তান সকলেও তেওঁলোকৰ ভাবী সন্তান সকলক কওঁক।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কুটি খোৱা ফৰিঙে এৰাখিনি কাকতী ফৰিঙে খালে;","poem":1},{"lineBreak":true},{"text":"আৰু কাকতী ফৰিঙে এৰাখিনি চেলেকা ফৰিঙে খালে;","poem":1},{"lineBreak":true},{"text":"আৰু চেলেকা ফৰিঙে এৰাখিনি বিনাশকাৰী","poem":1},{"noteId":0},{"text":"ফৰিঙে খালে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে মতলীয়াসকল, সাৰ পোৱা আৰু কান্দা!","poem":1},{"lineBreak":true},{"text":"বিলাপ কৰা, হে দ্ৰাক্ষাৰস পান কৰোঁতাসকল,","poem":1},{"lineBreak":true},{"text":"কাৰণ নতুন দ্রাক্ষাৰস তোমালোকৰ মুখৰ পৰা সম্পূর্ণৰূপে আতৰাই দিয়া হ’ল।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কিয়নো এটা জাতি","poem":1},{"noteId":1},{"text":"মোৰ দেশৰ বিৰুদ্ধে উঠি আহিল,","poem":1},{"lineBreak":true},{"text":"অসংখ্য প্ৰাণী থকা এক বলবান জাতি।","poem":1},{"lineBreak":true},{"text":"সিহঁতৰ দাঁত সিংহৰ দাঁতৰ নিচিনা,","poem":1},{"lineBreak":true},{"text":"আৰু সিংহী","poem":1},{"noteId":2},{"text":"ৰ গুৰি দাঁতৰ নিচিনা সিহঁতৰ গুৰি দাঁত।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"সিহঁতে মোৰ দ্ৰাক্ষালতা ধ্বংস কৰিলে,","poem":1},{"lineBreak":true},{"text":"আৰু মোৰ ডিমৰু গছৰ বাকলি এৰুৱালে।","poem":1},{"lineBreak":true},{"text":"সিহঁতে তাক নিচেইকৈ বখলিয়ালে আৰু পেলাই দিলে;","poem":1},{"lineBreak":true},{"text":"তাৰ ডালবোৰ বগা কৰিলে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যৌৱন কালৰ স্বামীৰ শোকত চট কাপোৰেৰে কঁকাল বন্ধা কন্যাৰ নিচিনাকৈ তুমি বিলাপ কৰা।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ গৃহৰ পৰা ভক্ষ্য আৰু পেয় নৈবেদ্য বন্ধ কৰা হ’ল।","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ দাসবোৰ, পুৰোহিতসকলে শোক কৰিছে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"পথাৰবোৰ নষ্ট হ’ল,","poem":1},{"lineBreak":true},{"text":"ভূমিয়ে শোক","poem":1},{"noteId":3},{"text":"কৰিছে।","poem":1},{"lineBreak":true},{"text":"কিয়নো শস্য নষ্ট কৰা হ’ল,","poem":1},{"lineBreak":true},{"text":"নতুন দ্ৰাক্ষাৰস শুকাল,","poem":1},{"lineBreak":true},{"text":"আৰু তেল নাইকিয়া হ’ল।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে খেতিয়কসকল, লজ্জিত হোৱা,","poem":1},{"lineBreak":true},{"text":"হে দ্ৰাক্ষাবাৰী আপডাল কৰোঁতাসকল,","poem":1},{"lineBreak":true},{"text":"ঘেঁহু ধান আৰু যৱৰ বাবে বাবে বিলাপ কৰা।","poem":1},{"lineBreak":true},{"text":"কিয়নো পথাৰৰ শস্য বিনষ্ট হ’ল।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"দ্ৰাক্ষালতা শুকাল, ডিমৰু গছ জঁয় পৰিল,","poem":1},{"lineBreak":true},{"text":"ডালিম, খাজুৰ আৰু আপেলৰ গছবোৰ -","poem":1},{"lineBreak":true},{"text":"পথাৰৰ সকলো গছ শুকাল। সঁচাকৈ মনুষ্য সন্তান সকলৰ মাজৰ পৰা আমোদ প্ৰমোদ নাইকিয়া হ’ল।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"হে পুৰোহিতসকল, তোমালোকে চট কাপোৰ পৰিধান কৰি বিলাপ কৰা!","poem":1},{"lineBreak":true},{"text":"হে যজ্ঞ-বেদিৰ পৰিচাৰকসকল, বিলাপ কৰা।","poem":1},{"lineBreak":true},{"text":"হে মোৰ ঈশ্বৰৰ দাসবোৰ, আহাঁ, চট কাপোৰ পিন্ধি ওৰে ৰাতি পৰি থাকা।","poem":1},{"lineBreak":true},{"text":"কিয়নো তোমালোকৰ ঈশ্বৰৰ গৃহৰ পৰা ভক্ষ্য আৰু পেয় নৈবেদ্য প্রতিৰোধ কৰা হৈছে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তোমালোকে পবিত্ৰ উপবাস নিৰূপণ কৰা,","poem":1},{"lineBreak":true},{"text":"সমাজ গোট খাবলৈ ঘোষণা কৰা।","poem":1},{"lineBreak":true},{"text":"পৰিচাৰকসকল আদি কৰি দেশনিবাসী আটাই লোকক গোট খুউৱাই","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ ঈশ্বৰ যিহোৱাৰ গৃহত","poem":1},{"lineBreak":true},{"text":"যিহোৱালৈ কাতৰোক্তি কৰা,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"হায় হায়, এয়ে কেনে দিন!","poem":1},{"lineBreak":true},{"text":"কিয়নো যিহোৱাৰ ভয়ংকৰ দিন ওচৰ।","poem":1},{"lineBreak":true},{"text":"এই সকলোৰে সৈতে সৰ্ব্বশক্তিমান ঈশ্বৰৰ পৰা যেন প্ৰলয়হে উপস্থিত হ’ল।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"আমাৰ চকুৰ আগত খোৱা বস্তুবোৰ,","poem":1},{"lineBreak":true},{"text":"আৰু এনেকি আমাৰ ঈশ্বৰৰ গৃহৰ আনন্দ আৰু উল্লাস লোপ পোৱা নাই নে?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"বোৱা কঠীয়াৰ ধানবোৰ নিজ নিজ চপৰাৰ তলত শুকাই গ’ল,","poem":1},{"lineBreak":true},{"text":"ভঁৰালবোৰ ধ্বংস কৰা হ’ল, শস্যৰ ঘৰবোৰ ভাগিল,","poem":1},{"lineBreak":true},{"text":"কাৰণ শস্যবোৰ নাইকিয়া হ’ল।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"পশুবোৰে কেনেকৈ কেঁকাইছে!","poem":1},{"lineBreak":true},{"text":"চৰণীয়া ঠাই নোহোৱাৰ বাবে","poem":1},{"lineBreak":true},{"text":"গৰুৰ জাকবোৰ ব্যাকুল হৈছে।","poem":1},{"lineBreak":true},{"text":"এনেকি মেৰ-ছাগ আৰু ছাগলীৰ জাকবোৰে দণ্ড ভোগ কৰিছে।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মই তোমাৰেই আগত কাতৰোক্তি কৰিছোঁ।","poem":1},{"lineBreak":true},{"text":"কিয়নো অগ্নিয়ে অৰণ্যৰ চৰণীয়া ঠাইবোৰ গ্ৰাস কৰিলে,","poem":1},{"lineBreak":true},{"text":"অগ্নিশিখাই খেতিৰ সকলো গছবোৰ পুৰি পেলালে।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"বনৰ পশুবোৰেও তোমাৰ আগত ক্ৰন্দন কৰিছে,","poem":1},{"lineBreak":true},{"text":"কিয়নো জলৰ জুৰিবোৰ শুকাল,","poem":1},{"lineBreak":true},{"text":"আৰু অৰণ্যৰ চৰণীয়া ঠাইবোৰ অগ্নিয়ে গ্ৰাস কৰিলে।","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"বিনাশকাৰী ভুৰ পোক","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"ফৰিঙৰ এটা বৃহৎ সৈন্য দল।","reference":{"chapter":1,"verse":6}},{"noteId":2,"caller":"+","text":"প্রকাশিত বাক্য 9:7-10","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"শুকাই গ’ল।","reference":{"chapter":1,"verse":10}}]},"thisChapterLink":"/api/asm_irv/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}