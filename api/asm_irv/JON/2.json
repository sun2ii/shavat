{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"JON","translationId":"asm_irv","name":"যোনা","commonName":"যোনা","title":"যোনা","order":32,"numberOfChapters":4,"sha256":"2934d6d35ccb1576c96f1896247dc1d6e44694b61ac3eb0d6f10995f334d122c","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/asm_irv/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["যোনাৰ প্রার্থনা"]},{"type":"verse","number":1,"content":["যোনাই সেই মাছৰ পেটৰ পৰা নিজ ঈশ্বৰ যিহোৱাৰ আগত প্ৰাৰ্থনা কৰিলে।"]},{"type":"verse","number":2,"content":["তেওঁ ক’লে,",{"text":"“মই যিহোৱাক মোৰ কষ্টৰ বিষয়ে প্ৰাৰ্থনাত ক’লো;","poem":1},{"lineBreak":true},{"text":"তাতে তেওঁ মোক উত্তৰ দিলে।","poem":1},{"lineBreak":true},{"text":"চিয়োলৰ","poem":1},{"noteId":0},{"text":"ভিতৰৰ পৰা মই সহায়ৰ কাৰণে কাতৰোক্তি কৰিলোঁ আৰু আপুনি মোৰ স্বৰ শুনিলে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"আপুনি মোক গভীৰ জলত সাগৰৰ মাজত পেলালে","poem":1},{"lineBreak":true},{"text":"আৰু মোক সাগৰৰ সোঁতে বেৰি ধৰিলে,","poem":1},{"lineBreak":true},{"text":"আপোনাৰ আটাই ঢৌ আৰু তৰঙ্গ মোৰ ওপৰেদি গ’ল।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মই ক’লো, ‘আপোনাৰ দৃষ্টিৰ পৰা মোক দূৰ কৰি","poem":1},{"lineBreak":true},{"text":"দিলে; মই কেনেকৈ পুনৰ আপোনাৰ পবিত্ৰ মন্দিৰৰ ফালে দৃষ্টি কৰিম?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"জল সমূহে মোক গ্রাস কৰি প্রাণৰ সংশয়লৈ লৈ","poem":1},{"lineBreak":true},{"text":"গ’ল; অগাধ জলে মোক আগুৰি ধৰিলে;","poem":1},{"lineBreak":true},{"text":"সাগৰৰ লতা-বনবোৰে মোৰ মূৰ মেৰাই ধৰিলে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মই ডুবি গৈ পৰ্ব্বতবোৰৰ মূল পর্যন্ত নামি গ’লোঁ;","poem":1},{"lineBreak":true},{"text":"নিজৰ ডাংবোৰেৰে পৃথিৱীয়ে মোক চিৰকাললৈকে আটক কৰিলে;","poem":1},{"lineBreak":true},{"text":"কিন্তু, হে মোৰ ঈশ্বৰ যিহোৱা, আপুনি সেই গাতৰ পৰা মোক উঠাই আনিলে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মোৰ প্ৰাণ যেতিয়া মোৰ অন্তৰত ব্যাকুল হ’ল,","poem":1},{"lineBreak":true},{"text":"মই যিহোৱাক সোঁৱৰণ কৰিলোঁ আৰু মোৰ প্ৰাৰ্থনা","poem":1},{"lineBreak":true},{"text":"আপোনাৰ ওচৰত আপোনাৰ পবিত্ৰ মন্দিৰত উপস্থিত হ’ল।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিসকলে অসাৰ দেৱতাবোৰক মানে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে আপোনাৰ যি বিশ্বস্ততা, তাক অৱহেলা কৰে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"কিন্তু মই হ’লে স্তুতি-ধন্যবাদেৰে আপোনাৰ উদ্দেশ্যে বলি উৎসৰ্গ কৰিম;","poem":1},{"lineBreak":true},{"text":"মই কৰা সংকল্প সিদ্ধ কৰিম;","poem":1},{"lineBreak":true},{"text":"পৰিত্ৰাণ যিহোৱাৰ পৰাই আহে!”","poem":1}]},{"type":"verse","number":10,"content":["পাছত যিহোৱাই মাছটোক আজ্ঞা দিয়াত মাছটোৱে যোনাক বামত বমি কৰি উলিয়াই দিলে।"]}],"footnotes":[{"noteId":0,"caller":"+","text":"চিয়োল, অর্থাৎ মৈদাম।","reference":{"chapter":2,"verse":2}}]},"thisChapterLink":"/api/asm_irv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}