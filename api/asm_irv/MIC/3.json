{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"MIC","translationId":"asm_irv","name":"মীখা","commonName":"মীখা","title":"মীখা","order":33,"numberOfChapters":7,"sha256":"82ad2240c73a159b681364867c1389c4dbf9e9bf511c15f48bacf38157dce255","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/asm_irv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"মই কলোঁ,","poem":1},{"lineBreak":true},{"text":"“যাকোবৰ মূখ্য লোকসকল,","poem":1},{"lineBreak":true},{"text":"আৰু ইস্রায়েলৰ বংশৰ শাসনকৰ্ত্তাসকল এতিয়া শুনা:","poem":1},{"lineBreak":true},{"text":"ন্যায় বুজি পোৱাটো তোমালোকৰ বাবে উচিত নহয় নে?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তোমালোকৰ যিসকলে ভাল কৰ্ম ঘিণ কৰে,","poem":1},{"lineBreak":true},{"text":"আৰু পাপক ভাল পায়,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ তোমালোকে ছাল বখলিয়াবা,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকৰ হাড়ৰ পৰা মাংস এৰুৱাবা,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমালোকে মোৰ লোকসকলৰ মাংসও খোৱা,","poem":1},{"lineBreak":true},{"text":"তোমালোকে মোৰ লোকসকলৰো ছাল বখলিওৱা,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ হাড় ভাঙা,","poem":1},{"lineBreak":true},{"text":"পাত্রৰ বাবে মাংস,","poem":1},{"lineBreak":true},{"text":"আৰু কেৰাহীত দিয়া মাংসৰ দৰে,","poem":1},{"lineBreak":true},{"text":"তোমালোকে তেওঁলোকক টুকুৰা টুকুৰ কৰা আৰু খোৱা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেতিয়া শাসনকৰ্ত্তাসকলে যিহোৱাৰ আগত কাতৰোক্তি কৰিব,","poem":1},{"lineBreak":true},{"text":"কিন্তু তেওঁ তোমালোকক উত্তৰ নিদিব।","poem":1},{"lineBreak":true},{"text":"সেই সময়ত তেওঁ তোমালোকৰ পৰা মুখ লুকুৱাব,","poem":1},{"lineBreak":true},{"text":"কাৰণ তোমালোকে পাপ কৰ্ম কৰিছা।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ভাববাদীসকলৰ বিষয়ে যিহোৱাই এইদৰে কৈছে,","poem":1},{"lineBreak":true},{"text":"মোৰ লোকসকলক কোনে ভ্ৰান্ত কৰে:","poem":1},{"lineBreak":true},{"text":"যিসকলে তেওঁলোকক আহাৰ খুৱাই, তেওঁলোকৰ বাবে","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে ঘোষণা কৰে, ‘তাত উন্নতি হ’ব।’","poem":1},{"lineBreak":true},{"text":"কিন্তু যিসকলে নিজৰ মুখত একো নলয়, তেওঁলোকৰ বাবে","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তেওঁলোকৰ বিৰুদ্ধে যুদ্ধ ঘোষণা কৰে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সেই কাৰণে কোনো দৰ্শন নোহোৱাকৈ তোমালোকলৈ ৰাতি হ’ব;","poem":1},{"lineBreak":true},{"text":"আৰু তোমালোকে ভৱিষ্যৎ গণনা কৰিব নোৱাৰাকৈ তোমালোকলৈ আন্ধাৰ হ’ব;","poem":1},{"lineBreak":true},{"text":"ভাববাদীসকলৰ ওপৰত সূৰ্য মাৰ যাব,","poem":1},{"lineBreak":true},{"text":"আৰু সেই দিনা তেওঁলোকৰ ওপৰত আন্ধাৰ হ’ব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"দৰ্শকসকলক লাজত পেলোৱা হ’ব,","poem":1},{"lineBreak":true},{"text":"আৰু ভৱিষ্যৎ গণনা কৰা সকল বিভ্রান্ত হ’ব।","poem":1},{"lineBreak":true},{"text":"তেওঁলোক সকলোৱে নিজৰ মুখ ঢাকিব;","poem":1},{"lineBreak":true},{"text":"কাৰণ মোৰ পৰা তেওঁলোকলৈ একো উত্তৰ নাহিব;”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"কিন্তু মোৰ ক্ষেত্রত, যাকোবক তেওঁৰ অপৰাধ","poem":1},{"lineBreak":true},{"text":"আৰু ইস্ৰায়েলক তেওঁৰ পাপ ঘোষণা কৰিবলৈ,","poem":1},{"lineBreak":true},{"text":"মই যিহোৱাৰ আত্মাৰ দ্বাৰাই শক্তি,","poem":1},{"lineBreak":true},{"text":"ন্যায় বিচাৰ, আৰু পৰাক্রমেৰে পৰিপূৰ্ণ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"সকলো সৎ কৰ্মত বিপথে যোৱা,","poem":1},{"lineBreak":true},{"text":"আৰু ন্যায় ঘৃণা কৰা হে যাকোবৰ বংশৰ মূখ্য লোকসকল,","poem":1},{"lineBreak":true},{"text":"আৰু ইস্ৰায়েল বংশৰ শাসনকৰ্ত্তাসকল, এতিয়া এই কথা শুনা;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তোমালোকে ৰক্তপাতেৰে চিয়োন,","poem":1},{"lineBreak":true},{"text":"আৰু পাপেৰে যিৰূচালেম নিৰ্মাণ কৰিলা;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তোমালোকৰ মুখ্য লোকসকলে উৎকোচৰ বাবে বিচাৰ কৰে,","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ পুৰোহিতসকলে মূল্যৰ বাবে শিক্ষা দিয়ে,","poem":1},{"lineBreak":true},{"text":"আৰু তোমালোকৰ ভাববাদীসকলে ধনৰ বাবে ভৱিষ্যত বাণী কৰে,","poem":1},{"lineBreak":true},{"text":"তথাপি তোমালোকে যিহোৱাৰ ওপৰত ভাৰসা কৰি কোৱা,","poem":1},{"lineBreak":true},{"text":"“যিহোৱা আমাৰ লগত নাই নে?","poem":1},{"lineBreak":true},{"text":"কোনো আপদ আমালৈ নাহিব;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"এই হেতুকে তোমালোকৰ কাৰণে","poem":1},{"lineBreak":true},{"text":"পথাৰ চহোৱাৰ দৰে চিয়োনক চহোৱা হ’ব,","poem":1},{"lineBreak":true},{"text":"যিৰূচালেম ধ্বংসৰ স্তূপ হ’ব,","poem":1},{"lineBreak":true},{"text":"আৰু মন্দিৰ থকা পাহাৰ জংঘলৰ দৰে হ’ব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}