{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"MIC","translationId":"asm_irv","name":"মীখা","commonName":"মীখা","title":"মীখা","order":33,"numberOfChapters":7,"sha256":"82ad2240c73a159b681364867c1389c4dbf9e9bf511c15f48bacf38157dce255","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/asm_irv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["ইস্ৰায়েলৰ ভাবী মঙ্গল।"]},{"type":"verse","number":1,"content":[{"text":"কিন্তু আহি থকা দিনত এইদৰে ঘটিব,","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ গৃহ থকা পৰ্ব্বতটো","poem":1},{"lineBreak":true},{"text":"আন পৰ্ব্বতবোৰৰ ওপৰত স্থাপন কৰা হ’ব।","poem":1},{"lineBreak":true},{"text":"এই গৃহটি পাহাৰবোৰতকৈয়ো উচ্চ কৰা হ’ব;","poem":1},{"lineBreak":true},{"text":"আৰু লোকসকল সোঁত বোৱাদি তালৈ যাব।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"অনেক দেশৰ লোক যাব আৰু ক’ব,","poem":1},{"lineBreak":true},{"text":"“আহাঁ, আমি যিহোৱাৰ পৰ্ব্বতটোলৈ উঠোহঁক,","poem":1},{"lineBreak":true},{"text":"আৰু যাকোবৰ ঈশ্বৰৰ গৃহলৈ যাওঁহক।","poem":1},{"lineBreak":true},{"text":"তেওঁ আমাক তেওঁৰ পথৰ বিষয়ে শিক্ষা দিব,","poem":1},{"lineBreak":true},{"text":"আৰু আমি তেওঁৰ পথত চলিম;”","poem":1},{"lineBreak":true},{"text":"কিয়নো চিয়োনৰ পৰা বিধান,","poem":1},{"lineBreak":true},{"text":"আৰু যিৰূচালেমৰ পৰা যিহোৱাৰ বাক্য বাহিৰ ওলাব।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁ অনেক লোকৰ মাজত বিচাৰ কৰিব,","poem":1},{"lineBreak":true},{"text":"আৰু দূৰত থকা বহুতো দেশবাসীৰ বিষয়ে সিদ্ধান্ত ল’ব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তেওঁলোকৰ তৰোৱাল ভাঙি নাঙলৰ ফাল,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকৰ যাঠী ভাঙি কলম দিয়া কটাৰী গঢ়াই ল’ব;","poem":1},{"lineBreak":true},{"text":"এটা দেশে আন দেশৰ বিৰুদ্ধে তৰোৱাল নাদাঙিব,","poem":1},{"lineBreak":true},{"text":"অথবা তেওঁলোকে যুদ্ধবিদ্যা পুনৰ নিশিকিব।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তাৰ পৰিৱৰ্তে প্ৰতিজন লোকে দ্ৰাক্ষাবাৰী,","poem":1},{"lineBreak":true},{"text":"আৰু ডিমৰু গছৰ তলত বহিব।","poem":1},{"lineBreak":true},{"text":"কোনেও তেওঁলোকক ভয় খুৱাব নোৱাৰিব;","poem":1},{"lineBreak":true},{"text":"কাৰণ বাহিনীসকলৰ যিহোৱাই নিজৰ মুখেৰে এই কথা কৈছিল,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কাৰণ সকলো লোকে","poem":1},{"lineBreak":true},{"text":"নিজৰ নিজৰ দেৱতাৰ নামেৰে চলে,","poem":1},{"lineBreak":true},{"text":"কিন্তু আমি চিৰকাললৈকে","poem":1},{"lineBreak":true},{"text":"আমাৰ ঈশ্বৰ যিহোৱাৰ নামেৰে চলিম।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যিহোৱাই কৈছে, “সেই দিনা মই যিসকলক দুৰ্দশাগ্রস্ত কৰিছিলোঁ,","poem":1},{"lineBreak":true},{"text":"সেই পঙ্গুসকলক মই একগোট কৰিম,","poem":1},{"lineBreak":true},{"text":"আৰু অনুন্নত লোকসকলক একত্রিত কৰিম।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মই পঙ্গুক অৱশিষ্ট কৰি ৰাখিম,","poem":1},{"lineBreak":true},{"text":"আৰু যিজনক দূৰ কৰা হৈছিল, তেওঁক এক বলৱান জাতি কৰিম;","poem":1},{"lineBreak":true},{"text":"আৰু মই, যিহোৱাই এতিয়াৰ পৰা চিৰকাললৈকে","poem":1},{"lineBreak":true},{"text":"চিয়োন পৰ্ব্বতত তেওঁলোকৰ ওপৰত ৰাজত্ব কৰিম।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমালোক পশুৰ জাকৰ বাবে পহৰা দিয়া দুৰ্গ,","poem":1},{"lineBreak":true},{"text":"আৰু তোমালোকলৈ","poem":1},{"lineBreak":true},{"text":"চিয়োন জীয়ৰীৰ পাহাৰ,","poem":1},{"lineBreak":true},{"text":"পূৰ্বৰ শাসন,","poem":1},{"lineBreak":true},{"text":"যিৰূচালেম জীয়ৰীৰ ৰাজ্য আহিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"এতিয়া কিয় তোমালোকে চিঞৰি কান্দিছা?","poem":1},{"lineBreak":true},{"text":"প্ৰসৱ কৰা মহিলাৰ দৰে, তোমালোকৰ যে আকস্মিক বেদনা হৈছে;","poem":1},{"lineBreak":true},{"text":"তোমালোকৰ মাজত কোনো ৰজা নাই নে?","poem":1},{"lineBreak":true},{"text":"আৰু তোমালোকৰ পৰামৰ্শদাতা বিনষ্ট হ’ল নে?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"চিয়োন জীয়ৰী,","poem":1},{"lineBreak":true},{"text":"বেদনা অনুভৱ কৰা,","poem":1},{"lineBreak":true},{"text":"প্রসৱ কৰিবলৈ লোৱা মহিলাৰ দৰে,","poem":1},{"lineBreak":true},{"text":"উৎপন্ন কৰিবলৈ পৰিশ্রম কৰা,","poem":1},{"lineBreak":true},{"text":"কাৰণ তোমালোক এতিয়া নগৰৰ পৰা বাহিৰ ওলাই গৈ,","poem":1},{"lineBreak":true},{"text":"পথাৰত থাকিব লাগিব,","poem":1},{"lineBreak":true},{"text":"আৰু বাবিললৈ যাব লাগিব;","poem":1},{"lineBreak":true},{"text":"সেই ঠাইতে তোমালোকে উদ্ধাৰ পাবা,","poem":1},{"lineBreak":true},{"text":"সেই ঠাইতেই যিহোৱাই তোমাৰ","poem":1},{"lineBreak":true},{"text":"শত্ৰুৰ হাতৰ পৰা তোমাক মুক্ত কৰিব।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"এতিয়া অনেক দেশ তোমালোকৰ বিৰুদ্ধে একত্রিত হ’ব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে কৈছে, তেওঁক কলুষিত হ’ব দিয়া,","poem":1},{"lineBreak":true},{"text":"আমাৰ চকুক চিয়োনক আগ্রহেৰে চাব দিয়া।”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ভাববাদীয়ে কৈছে, “তেওঁলোকে যিহোৱাৰ কল্পনাবোৰ নাজানে,","poem":1},{"lineBreak":true},{"text":"নাইবা তেওঁলোকে তেওঁৰ আঁচনিবোৰ নুবুজে;","poem":1},{"lineBreak":true},{"text":"কাৰণ তেওঁ মৰণা মৰা ঠাইত ডাঙৰি গোটোৱাৰ দৰে তেওঁলোকক গোটাইছে।”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যিহোৱাই কৈছে, “হে চিয়োন জীয়ৰী উঠা, আৰু প্রহাৰ কৰা;","poem":1},{"lineBreak":true},{"text":"কাৰণ মই তোমাৰ শিং লোহাৰ","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ খুৰা পিতলৰ কৰিম;","poem":1},{"lineBreak":true},{"text":"তুমি অনেক লোকক মাৰি চূৰ্ণ কৰিবা;","poem":1},{"lineBreak":true},{"text":"মই যিহোৱাই নিজৰ বাবে তেওঁলোকৰ অন্যায়ৰ সম্পত্তি উৎসৰ্গ কৰিম,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ অধিকাৰ গোটেই পৃথিবীৰ প্ৰভুৰ উদ্দেশ্যে উৎসৰ্গ কৰিম।”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}