{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PRO","translationId":"asm_irv","name":"হিতোপদেশ","commonName":"হিতোপদেশ","title":"হিতোপদেশ","order":20,"numberOfChapters":31,"sha256":"04e3968d2c96d14ea61cbf43b4f717f46eef427dc413302ddac35d32cc76a0bb","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/asm_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["প্ৰজ্ঞাৰ ভোজ।"]},{"type":"verse","number":1,"content":[{"text":"প্ৰজ্ঞাই নিজৰ গৃহ নিৰ্মাণ কৰিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁ শিলৰ পৰা সাতটা স্তম্ভ কাটিলে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তেওঁ ৰাতিৰ আহাৰৰ বাবে নিজৰ পশু আৰু দ্রাক্ষাৰস যুগুত কৰিলে;","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁ নিজৰ মেজ সজালে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ দাসীসকলক বাহিৰলৈ পঠাই","poem":1},{"lineBreak":true},{"text":"নগৰৰ ওখ ঠাইৰ পৰা নিমন্ত্ৰণ কৰিলে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“যিসকল অশিক্ষিত, তেওঁলোক ইয়ালৈ আহক!”","poem":1},{"lineBreak":true},{"text":"যিসকল জ্ঞানশূন্য তেওঁলোকক তেওঁ ক’লে,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“আহাঁ, মোৰ আহাৰ ভোজন কৰা,","poem":1},{"lineBreak":true},{"text":"আৰু মই মিহলাই থোৱা দ্ৰাক্ষাৰস পান কৰা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"শিক্ষাবিহীন পথ এৰি জীৱন ধাৰণ কৰা,","poem":1},{"lineBreak":true},{"text":"সুবিবেচনাৰ পথত চলা।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যিজনে নিন্দক লোকক শিক্ষা দিয়ে, তেওঁ অপমান পায়,","poem":1},{"lineBreak":true},{"text":"আৰু যিজনে দুষ্টক অনুযোগ কৰে, তেওঁ মনত আঘাত পায়।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তুমি নিন্দক লোকক অনুযোগ নকৰিবা, কৰিলে তেওঁ তোমাক ঘিণ কৰিব;","poem":1},{"lineBreak":true},{"text":"জ্ঞানী লোকক অনুযোগ কৰা, তেওঁ তোমাক প্ৰেম কৰিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"জ্ঞানী লোকক শিক্ষা দিয়া, তেওঁ অধিক জ্ঞানী হ’ব;","poem":1},{"lineBreak":true},{"text":"ধাৰ্মিক লোকক শিক্ষা দিয়া, তেওঁ শিক্ষাত বৃদ্ধি পাব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিহোৱালৈ ভয় ৰখাই প্রজ্ঞাৰ আৰম্ভণ,","poem":1},{"lineBreak":true},{"text":"আৰু পবিত্ৰজনাক জনাই সুবিবেচনা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কিয়নো মোৰ দ্বাৰাই তোমাৰ আয়ুস বৃদ্ধি হ’ব,","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ জীৱনৰ বছৰবোৰ বাঢ়ি যাব।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তুমি যদি জ্ঞানী, তেনেহ’লে তোমাৰ বাবেই তুমি জ্ঞানী,","poem":1},{"lineBreak":true},{"text":"কিন্তু যদি তুমি নিন্দক, তেনেহ’লে তুমি অকলেই তাৰ ভাৰ ব’বা।”","poem":1}]},{"type":"heading","content":["অজ্ঞানী মহিলাই কৰা নিমন্ত্ৰণ"]},{"type":"verse","number":13,"content":[{"text":"অজ্ঞানী মহিলা কোলাহলপূৰ্ণ-","poem":1},{"lineBreak":true},{"text":"তেওঁ অশিক্ষিত, আৰু তেওঁ একো নাজানে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ ঘৰৰ দুৱাৰত,","poem":1},{"lineBreak":true},{"text":"আৰু নগৰৰ উচ্চ স্থানত বহে।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যিসকলে সেই পথেৰে যায়, তেওঁলোকক মাতে;","poem":1},{"lineBreak":true},{"text":"সেই লোকসকল নিজ পথত গৈ থাকিলেও তেওঁ মাতে,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“যিসকলে শিক্ষা পোৱা নাই, তেওঁলোক ইয়ালৈ আহক!”","poem":1},{"lineBreak":true},{"text":"যিসকল জ্ঞানশূন্য, তেওঁলোকক তেওঁ কয়,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“চুৰ কৰা পানী মিঠা,","poem":1},{"lineBreak":true},{"text":"আৰু গুপুতে খোৱা আহাৰ অতি সুস্বাদু।”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"কিন্তু মৃত্যু যে তাত আছে,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁৰ অতিথি সকল যে চিয়োলৰ গভীৰ ঠাইত আছে, সেই কথা তেওঁ নাজানে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}