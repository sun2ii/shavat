umber":5,"content":[{"lineBreak":true},{"text":"এই কাৰণে দুষ্টবোৰে ন্যায় বিচাৰত থিয় হ’ব নোৱাৰিব,","poem":1},{"lineBreak":true},{"text":"আৰু পাপীলোকে ধাৰ্মিকসকলৰ সভাত থাকিব নোৱাৰিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কাৰণ যিহোৱাই ধাৰ্মিকসকল চলা পথত সতর্ক দৃষ্টি ৰাখে,","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টবোৰৰ পথৰ অন্ত হ’ব সৰ্ব্বনাশ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}