{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["ধন্যবাদাৰ্থক গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে সমুদায় পৃথিৱী, তোমালোকে যিহোৱাৰ উদ্দেশ্যে আনন্দ ধ্বনি কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আনন্দ মনেৰে যিহোৱাৰ সেৱা কৰা;","poem":1},{"lineBreak":true},{"text":"আনন্দ গানেৰে সৈতে তেওঁৰ উপস্থিতিৰ সন্মুখলৈ আহাঁ;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমালোকে ইয়াকে জানা যে, যিহোৱাই ঈশ্বৰ;","poem":1},{"lineBreak":true},{"text":"তেঁৱেই আমাক নিৰ্ম্মাণ কৰিলে, আমি তেওঁৰেই;","poem":1},{"lineBreak":true},{"text":"আমি তেওঁৰ প্ৰজা আৰু তেওঁৰ চৰণীয়া পথাৰৰ মেৰ-ছাগ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁৰ ধন্যবাদ কৰি তেওঁৰ দুৱাৰবোৰত প্রৱেশ কৰা,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ প্ৰশংসা কৰি তেওঁৰ চোতাল কেইখনত সোমোৱা;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ স্তুতি কৰা, তেওঁৰ নামৰ ধন্যবাদ কৰা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো যিহোৱা মঙ্গলময়, তেওঁৰ দয়া চিৰকাল স্থায়ী;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ বিশ্বস্ততা পুৰুষে পুৰুষে স্থায়ী।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}