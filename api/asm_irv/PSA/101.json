pe":"verse","number":5,"content":[{"lineBreak":true},{"text":"যি জনে গোপনে চুবুৰীয়াৰ অপবাদ চৰ্চ্চে,","poem":1},{"lineBreak":true},{"text":"তেওঁক মই উচ্ছন্ন কৰিম;","poem":1},{"lineBreak":true},{"text":"গর্বিত দৃষ্টি আৰু অহংকাৰী মনৰ লোকক মই সহ্য নকৰিম।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"দেশৰ বিশ্বাসী লোকসকলৰ ওপৰত মোৰ কৃপা দৃষ্টি থাকিব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে মোৰ সৈতে বাস কৰিব।","poem":1},{"lineBreak":true},{"text":"যিজন সিদ্ধ পথত চলে, তেওঁ মোৰ পৰিচাৰক হ’ব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ছলনাকাৰীবোৰ মোৰ গৃহৰ ভিতৰত বাস কৰিব নোৱাৰিব;","poem":1},{"lineBreak":true},{"text":"মিথ্যাবাদীবোৰ মোৰ চকুৰ আগত থিৰে থাকিব নোৱাৰিব।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"প্রতি ৰাতিপুৱাতে সকলো দুষ্ট লোকক মই বিনষ্ট কৰিম;","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ নগৰৰ পৰা সকলো অধর্মচাৰীকে উচ্ছন্ন কৰিম।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}