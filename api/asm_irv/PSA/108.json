{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["সঙ্গীত। দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, মোৰ মন সুস্থিৰ; মোৰ মন সুস্থিৰ আছে;","poem":1},{"lineBreak":true},{"text":"মই গীত গাম; মোৰ প্ৰাণেৰে সৈতে প্ৰশংসাৰ গানৰ সুৰ তুলিম।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে নেবল আৰু বীণা, সাৰ পোৱা; মই প্ৰভাতক জগাম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, জাতি সমূহৰ মাজত মই তোমাৰ ধন্যবাদ কৰিম।","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ মাজত তোমাৰ প্ৰশংসাৰ গান কৰিম।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিয়নো তোমাৰ গভীৰ প্রেম আকাশমণ্ডলতকৈয়ো উচ্চ;","poem":1},{"lineBreak":true},{"text":"তোমাৰ বিশ্ৱস্ততা মেঘ পর্যন্ত ব্যাপ্ত।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, আকাশমণ্ডলৰ ওপৰলৈকে তুমি উন্নত হোৱা;","poem":1},{"lineBreak":true},{"text":"গোটেই পৃথিৱীৰ ওপৰত তোমাৰ গৌৰৱ হওক।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তুমি যি সকলক ভালপোৱা, তেওঁলোকে যেন উদ্ধাৰ পায়,","poem":1},{"lineBreak":true},{"text":"তোমাৰ সোঁ হাতেৰে আমাক উদ্ধাৰ কৰা,","poem":1},{"lineBreak":true},{"text":"আৰু মোক উত্তৰ দিয়া।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ঈশ্বৰে নিজৰ পবিত্ৰতাত প্রতিজ্ঞা কৰিলে,","poem":1},{"lineBreak":true},{"text":"“মই আনন্দেৰে সৈতে চিখিম ভাগ বাঁটি দিম,","poem":1},{"lineBreak":true},{"text":"চুক্কোতৰ উপত্যকাৰ জৰীপ কৰি ভাগ কৰি দিম।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"গিলিয়দ মোৰেই, মনচিও মোৰেই;","poem":1},{"lineBreak":true},{"text":"ইফ্ৰয়িম মোৰ শিৰোৰক্ষক;","poem":1},{"lineBreak":true},{"text":"যিহূদা মোৰ বিচাৰদণ্ড;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"মোৱাব মোৰ প্ৰক্ষালন-পাত্ৰ;","poem":1},{"lineBreak":true},{"text":"ইদোমৰ ওপৰলৈ মই মোৰ জোতা নিক্ষেপ কৰিম;","poem":1},{"lineBreak":true},{"text":"পলেষ্টিয়াৰ ওপৰত মই বিজয়ৰ উচ্চ-ধ্বনি কৰিম।”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কোনে মোক সেই শক্তিশালী নগৰৰ ভিতৰলৈ লৈ যাব?","poem":1},{"lineBreak":true},{"text":"কোনে ইদোমলৈকে মোক পথ দেখুৱাই লৈ যাব?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, তুমি আমাক জানো ত্যাগ কৰা নাই?","poem":1},{"lineBreak":true},{"text":"আমাৰ সৈন্যসকলৰ লগত যুদ্ধলৈ তুমিতো পুনৰ নোযোৱা।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"শত্ৰুৰ বিৰুদ্ধে তুমি আমাক সহায় কৰ;","poem":1},{"lineBreak":true},{"text":"কিয়নো মানুহৰ সাহার্য বৃথা।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ঈশ্বৰৰ সহায়ত আমি সাহসেৰে কাৰ্য কৰিম;","poem":1},{"lineBreak":true},{"text":"কিয়নো আমাৰ শত্ৰুবোৰক তেৱেঁই ভৰিৰে গচকিব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}