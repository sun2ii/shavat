{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"মই যিহোৱাতে আশ্ৰয় লৈছোঁ।","poem":1},{"lineBreak":true},{"text":"তোমালোকে কেনেকৈ মোক ক’ব পাৰা,","poem":1},{"lineBreak":true},{"text":"“পক্ষীৰ দৰে উৰি পৰ্ব্বতলৈ পলাই যোৱা?”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"কিয়নো চোৱা! শুদ্ধ অন্তৰৰ লোকক আন্ধাৰৰ পৰা আহত কৰিবৰ কাৰণে","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰে নিজৰ ধনু ভিৰাই লৈছে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তাত কাঁড় লগাইছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যদি ভিত্তিমূলবোৰ ধ্বংস কৰা হয়,","poem":1},{"lineBreak":true},{"text":"তেন্তে ধাৰ্মিকসকলে কি কৰিব পাৰিব?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিন্তু যিহোৱা, তেওঁৰ পবিত্ৰ মন্দিৰত আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সিংহাসন স্বর্গতে আছে।","poem":1},{"lineBreak":true},{"text":"তেওঁ মানুহলৈ চাই থাকে,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ চকুৱে মানুহক পৰীক্ষা কৰে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিহোৱাই ধাৰ্মিক আৰু দুষ্ট সকলোকে পৰীক্ষা কৰে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যিবোৰ দুষ্ট, অত্যাচাৰপ্রিয়, তেনেলোকক তেওঁ ঘৃণা কৰে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁ দুষ্ট লোকৰ ওপৰত জ্বলন্ত অগ্নি আৰু গন্ধক বর্ষাব;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ পাত্রৰ পৰা দগ্ধ কৰি নিয়া বতাহ তেওঁলোকৰ ভাগত হ’ব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যিহোৱা ধাৰ্মিক, আৰু ধার্মিকতা তেওঁ ভাল পায়;","poem":1},{"lineBreak":true},{"text":"সৎ লোকে তেওঁৰ মুখ দেখা পাব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}