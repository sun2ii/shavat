{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা!","poem":1},{"lineBreak":true},{"text":"মই সমস্ত মনেৰে যিহোৱাৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"ধাৰ্মিকসকলৰ সভাত আৰু মণ্ডলীৰ মাজত প্ৰশংসা কৰিম।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ কাৰ্যবোৰ মহৎ;","poem":1},{"lineBreak":true},{"text":"যিসকল তাত আনন্দিত হয়, তেওঁলোকে সেইবোৰ ধ্যান কৰে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁৰ কাৰ্য গৌৰৱ আৰু মহিমাৰে পৰিপূর্ণ;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ ধাৰ্মিকতা চিৰকাললৈকে থাকে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ আচৰিত কাৰ্যবোৰ স্মৰণীয় কৰিলে;","poem":1},{"lineBreak":true},{"text":"যিহোৱা কৃপাময় আৰু দয়ালু।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তেওঁৰ ভক্তসকলক তেওঁ আহাৰ যোগায়;","poem":1},{"lineBreak":true},{"text":"নিজে স্থাপন কৰা নিয়মটি তেওঁ চিৰকাললৈকে সোঁৱৰণ কৰিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"অন্যান্য জাতিবোৰৰ আধিপত্য নিজৰ লোকসকলক দি","poem":1},{"lineBreak":true},{"text":"তেওঁ নিজৰ কাৰ্যৰ শক্তি তেওঁলোকক দেখুৱালে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তেওঁৰ হাতৰ কাৰ্যবোৰ বিশ্বস্ত আৰু ন্যায়পূর্ণ;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সকলো বিধি বিশ্বাসযোগ্য।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"সেইবোৰ অনন্ত কাললৈকে অলৰ;","poem":1},{"lineBreak":true},{"text":"সেইবোৰ বিশ্ৱস্ততা আৰু সততাৰে সৈতে স্থাপন কৰা হৈছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"নিজৰ লোকসকলৰ কাৰণে তেওঁ মুক্তি পঠাই দিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁ আজ্ঞা দি অনন্ত কালৰ কাৰণে নিজৰ নিয়ম স্থাপন কৰিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ নাম পবিত্ৰ আৰু ভয়ঙ্কৰ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিহোৱালৈ ভয় ৰখাই জ্ঞানৰ আৰম্ভণ;","poem":1},{"lineBreak":true},{"text":"যিসকলে তেওঁৰ আজ্ঞা অনুসাৰে কাৰ্য কৰে, তেওঁলোকে সুবুদ্ধি পায়;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ প্ৰশংসা অনন্ত কাললৈকে থাকে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}