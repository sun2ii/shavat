{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1},{"lineBreak":true},{"text":"হে যিহোৱাৰ দাসবোৰ, প্ৰশংসা কৰা; যিহোৱাৰ নামৰ প্ৰশংসা কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"এতিয়াৰ পৰা অনন্ত কাললৈকে যিহোৱাৰ নাম ধন্য হওক।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সূৰ্যৰ উদয়স্থানৰ পৰা অস্তস্থান পর্যন্ত যিহোৱাৰ নাম প্ৰশংসিত হওঁক।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যিহোৱা সর্বজাতিৰ ওপৰত উন্নত; তেওঁৰ গৌৰৱ আকাশ-মণ্ডলতকৈয়ো ওখ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"আমাৰ ঈশ্বৰ যিহোৱাৰ তুল্য কোন আছে?","poem":1},{"lineBreak":true},{"text":"যি জনাৰ আসন আকাশৰ ওপৰত সমাহীন,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যি জনাই নত হৈ আকাশ-মণ্ডল আৰু পৃথিৱীলৈ দৃষ্টিপাত কৰে;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তেওঁ ধুলিৰ পৰা দুখীয়াক উঠায়,","poem":1},{"lineBreak":true},{"text":"সাৰৰ দ’মৰ পৰা দীনহীনক তোলে,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যাতে তেওঁ প্ৰধানসকলৰ লগত তেওঁলোকক বহুৱাব পাৰে,","poem":1},{"lineBreak":true},{"text":"নিজৰ লোক সকলৰ প্ৰধানসকলৰ লগত বহুৱাব পাৰে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তেওঁ বন্ধ্যা মহিলাক সুখী মাতৃ কৰি পৰিয়াল দান কৰে।","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}