{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"ইস্রায়েল জাতি যেতিয়া মিচৰৰ পৰা ওলাই আহিল,","poem":1},{"lineBreak":true},{"text":"যাকোবৰ বংশই যেতিয়া বিদেশী ভাষা কোৱা লোকৰ মাজৰ পৰা ওলাই আহিল,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তেতিয়া যিহূদা হ’ল ঈশ্বৰৰ পবিত্র স্থান,","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েল হ’ল তেওঁৰ ৰাজ্য।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সমুদ্ৰই","poem":1},{"noteId":125},{"text":"তাকে দেখি পলায়ন কৰিলে;","poem":1},{"lineBreak":true},{"text":"যৰ্দ্দন নদী উজাই গ’ল।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"পর্বতবোৰে মতা মেৰ-ছাগৰ নিচিনাকৈ,","poem":1},{"lineBreak":true},{"text":"পাহাৰবোৰে মেৰ-ছাগ পোৱালীৰ নিচিনাকৈ জঁপিয়াবলৈ ধৰিলে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে সমুদ্ৰ, তোমাৰ কি হ’ল?","poem":1},{"lineBreak":true},{"text":"কিয় তুমি পলাই গ’লা?","poem":1},{"lineBreak":true},{"text":"হে যৰ্দ্দন, কিয় তুমি উজাই গ’লা?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"হে পৰ্বতসমূহ, কিয় তোমালোকে মতা মেৰ-ছাগৰ দৰে জঁপিয়াবলৈ ধৰিলা?","poem":1},{"lineBreak":true},{"text":"হে পাহাৰসমূহ, কিয় তোমালোকে মেৰ-ছাগ পোৱালীৰ দৰে জঁপিয়াবলৈ ধৰিলা?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে পৃথিৱী! তুমি যিহোৱাৰ সন্মুখত কম্পমান হোৱা,","poem":1},{"lineBreak":true},{"text":"যাকোবৰ ঈশ্বৰৰ সন্মুখত কম্পমান হোৱা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তেওঁ শিলক জলাশয়লৈ পৰিণত কৰিলে,","poem":1},{"lineBreak":true},{"text":"চক্‌মকীয়া কঠিন শিলক জলৰ এক ভুমুক কৰিলে।","poem":1}]}],"footnotes":[{"noteId":125,"caller":"+","text":"সমুদ্ৰই চূফ সাগৰ","reference":{"chapter":114,"verse":3}}]},"thisChapterLink":"/api/asm_irv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}