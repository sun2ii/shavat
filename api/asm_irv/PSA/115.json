{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, আমাক নহয়, আমাক নহয়,","poem":1},{"lineBreak":true},{"text":"কিন্তু তোমাৰ নামকহে গৌৰৱাম্বিত কৰা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ অসীম প্রেম আৰু বিশ্ৱস্ততাৰ অর্থেই কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আন জাতিবোৰে কিয় ক’ব,","poem":1},{"lineBreak":true},{"text":"“ক’ত আছে তেওঁলোকৰ ঈশ্বৰ?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"আমাৰ ঈশ্বৰ হ’লে স্বৰ্গত আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁ যিহকে ইচ্ছা কৰে, তাকে কৰে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ প্রতিমাবোৰ হ’লে ৰূপ আৰু সোণৰ,","poem":1},{"lineBreak":true},{"text":"মনুষ্যৰ হাতৰ কাৰ্য।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সেইবোৰৰ মুখ আছে, কিন্তু কথা ক’ব নোৱাৰে;","poem":1},{"lineBreak":true},{"text":"চকু আছে, কিন্তু নেদেখে;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কাণ আছে, কিন্তু নুশুনে;","poem":1},{"lineBreak":true},{"text":"নাক আছে, কিন্তু ঘ্ৰাণ ল’ব নোৱাৰে;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হাত আছে, কিন্তু চুব নোৱাৰে;","poem":1},{"lineBreak":true},{"text":"ভৰি আছে, কিন্তু খোজ কাঢ়িব নোৱাৰে;","poem":1},{"lineBreak":true},{"text":"কন্ঠই একো মাত উলিয়াব নোৱাৰে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিসকলে সেইবোৰক নিৰ্ম্মাণ কৰে আৰু সেইবোৰত নির্ভৰ কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোক সেইবোৰৰ নিচিনাই।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে ইস্ৰায়েল, যিহোৱাত ভাৰসা কৰা!","poem":1},{"lineBreak":true},{"text":"তেৱেঁই তেওঁলোকৰ সহায় আৰু ঢাল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"হে হাৰোণৰ বংশ, যিহোৱাত ভাৰসা কৰা;","poem":1},{"lineBreak":true},{"text":"তেৱেঁই তেওঁলোকৰ সহায় আৰু ঢাল।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে যিহোৱাৰ ভয়কাৰী লোক, যিহোৱাত ভাৰসা কৰা;","poem":1},{"lineBreak":true},{"text":"তেৱেঁই তেওঁলোকৰ সহায় আৰু ঢাল।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"যিহোৱাই আমাক সোঁৱৰণ কৰিলে,","poem":1},{"lineBreak":true},{"text":"সেইবাবে তেওঁ আমাক আশীৰ্ব্বাদ কৰিব;","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েলৰ বংশক আশীৰ্ব্বাদ কৰিব;","poem":1},{"lineBreak":true},{"text":"হাৰোণৰ বংশক আশীর্ব্বাদ কৰিব;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যিসকলে যিহোৱাক ভয় কৰে, তেওঁলোক সকলোকে তেওঁ আশীর্ব্বাদ কৰিব,","poem":1},{"lineBreak":true},{"text":"সৰু কি বৰ সকলোকে আশীৰ্ব্বাদ কৰিব।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"যিহোৱাই তোমালোকক বৃদ্ধি কৰক;","poem":1},{"lineBreak":true},{"text":"তোমালোকক আৰু তোমালোকৰ সন্তান সকলক বৃদ্ধি কৰক।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যিহোৱা, যিজন স্বৰ্গ আৰু পৃথিৱীৰ স্ৰজনকৰ্ত্তা,","poem":1},{"lineBreak":true},{"text":"তেওঁ তোমালোকক আশীৰ্ব্বাদ কৰক।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"স্বৰ্গ হৈছে যিহোৱাৰেই স্বৰ্গ;","poem":1},{"lineBreak":true},{"text":"কিন্তু পৃথিৱীখন হ’লে তেওঁ মনুষ্যক দিলে।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"মৃতলোকে যিহোৱাৰ প্রশংসা নকৰে;","poem":1},{"lineBreak":true},{"text":"যিসকলে নিস্তব্ধ স্থানলৈ নামি যায়,","poem":1},{"lineBreak":true},{"text":"তেওঁলোক কোনেও তেওঁৰ স্তুতি নকৰে।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"কিন্তু আমি হ’লে যিহোৱাৰ ধন্যবাদ কৰিম,","poem":1},{"lineBreak":true},{"text":"এতিয়াৰ পৰা অনন্ত কাল পর্যন্ত কৰিম।","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}