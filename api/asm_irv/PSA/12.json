{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: চমীনীৎ সুৰত গোৱা দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা সহায় কৰা; তোমাৰ ভক্তসকল নোহোৱা হ’ল;","poem":1},{"lineBreak":true},{"text":"বিশ্বাসীসকল মনুষ্যৰ মাজৰ পৰা অদৃশ্য হৈ গ’ল।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মানুহে মানুহৰ ওচৰত মিছা কথা কয়;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তৈলমৰ্দনকাৰী ওঁঠ আৰু ছলনা ভৰা দুই মনৰ অন্তৰেৰে কথা কয়।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ তৈলমোদী ওঁঠ আৰু ভীষণ গর্বিত জিভাক যেন যিহোৱাই কাটি পেলায়;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"সেই সকলে কয়, “আমাৰ জিভাৰেই আমি জয় কৰিম;","poem":1},{"lineBreak":true},{"text":"আমাৰ ওঁঠ যেতিয়া আমাৰ নিজৰেই,","poem":1},{"lineBreak":true},{"text":"কোন আমাৰ ওপৰত প্ৰভু হ’ব?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিহোৱাই কৈছে, “দুখীসকলৰ উপদ্ৰৱ আৰু অভাৱীসকলৰ কেঁকনিৰ কাৰণে","poem":1},{"lineBreak":true},{"text":"মই এতিয়া জাগি উঠিম।","poem":1},{"lineBreak":true},{"text":"নিৰাপত্তা কামনা কৰা সকলক মই নিৰাপদে ৰাখিম।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ প্রতিজ্ঞাবোৰ বিশুদ্ধ।","poem":1},{"lineBreak":true},{"text":"সেইবোৰ যেন মাটিত বহোৱা এক অগ্নিশালত শোধন কৰা ৰূপ;","poem":1},{"lineBreak":true},{"text":"সাতবাৰকৈ বিশুদ্ধ কৰা ৰূপ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তুমিয়েই আমাক","poem":1},{"noteId":12},{"text":"নিৰাপদে ৰাখিবা।","poem":1},{"lineBreak":true},{"text":"এই কালৰ লোকসকলৰ হাতৰ পৰা চিৰকাল আমাক","poem":1},{"noteId":13},{"text":"ৰক্ষা কৰিবা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"লোকসকলৰ মাজত যেতিয়া দুষ্টতা আদৰণীয় হয়,","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰে তেতিয়া বিনা বাধাই চাৰিওফালে ঘূৰি ফুৰে।","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"তেওঁলোকক","reference":{"chapter":12,"verse":7}},{"noteId":13,"caller":"+","text":"তেওঁলোকক","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/asm_irv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}