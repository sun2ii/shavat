{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["মন্দিৰ অভিমুখে যাত্রাৰ সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"মোৰ সঙ্কটৰ কালত মই যিহোৱাৰ ওচৰত প্ৰাৰ্থনা কৰিলোঁ; তাতে তেওঁ মোক উত্তৰ দিলে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“হে যিহোৱা, মিছলীয়া ওঁঠ আৰু ছলনাকাৰী জিভাৰ পৰা তুমি মোক মুক্ত কৰা।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে ছলনাকাৰী জিভা, তোমাক তেওঁ কি দিব? তোমাক অধিক শাস্তি দিবলৈ কি কৰা হ’ব?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁ তোমাক বীৰৰ তীক্ষ্ন কাঁড়সমূহ আৰু ৰোতম গছৰ জ্বলা আঙঠাসমূহ দিব।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হায়, কি দুর্ভাগ্য মোৰ! মই মেচেকত প্ৰবাস কৰিছোঁ;","poem":1},{"lineBreak":true},{"text":"কেদৰৰ তম্বুবোৰৰ মাজত বসতি কৰিছোঁ।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যি সকলে শান্তিক ঘৃণা কৰে, সেই লোকসকলৰ সৈতে মই বহুকাল বাস কৰিছোঁ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মই শান্তি ভাল পাওঁ;","poem":1},{"lineBreak":true},{"text":"কিন্তু মই শান্তিৰ কথা ক’লে, তেওঁলোকে যুদ্ধ কৰিবলৈ বিচাৰে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}