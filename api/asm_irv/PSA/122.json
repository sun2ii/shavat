{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত যাত্ৰাৰ সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"মই আনন্দিত হ’লো, যেতিয়া লোকসকলে মোক ক’লে,","poem":1},{"lineBreak":true},{"text":"“ব’লা, আমি যিহোৱাৰ গৃহলৈ যাওঁ।”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে যিৰূচালেম, আমি তোমাৰ দুৱাৰবোৰৰ ভিতৰত ভৰি থৈ থিয় হৈ আছোঁ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সেই যিৰূচালেমক একেলগে সুদৃঢ়ভাৱে সংযুক্ত কৰা এটি নগৰ হিচাবে গঢ়ি তোলা হৈছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"সকলো ফৈদ সেই ঠাইলৈ উঠি যায়,","poem":1},{"lineBreak":true},{"text":"তেওঁলোক যিহোৱাৰ লোকসকলৰ ফৈদ;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে ইস্ৰায়েল জাতিৰ বাবে দিয়া আজ্ঞা অনুসাৰে যিহোৱাৰ নামৰ ধন্যবাদ কৰিবলৈ উঠি যায়।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো সেই ঠাইত বিচাৰৰ বাবে সিংহাসনবোৰ আছে,","poem":1},{"lineBreak":true},{"text":"দায়ুদৰ বংশৰ সিংহাসনবোৰ স্থাপিত আছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তোমালোকে যিৰূচালেমৰ শান্তিৰ অৰ্থে প্ৰাৰ্থনা কৰা;","poem":1},{"lineBreak":true},{"text":"“যিসকলে যিৰূচালেমক ভাল পায়, তেওঁলোক উন্নত হওঁক।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তোমালোকৰ প্রাচীৰবোৰৰ ভিতৰত শান্তি হওঁক,","poem":1},{"lineBreak":true},{"text":"আৰু তোমালোকৰ উচ্চ অট্টালিকাবোৰ নিৰাপদে থাকক।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"মোৰ কুটুম্ব আৰু বন্ধুসকলৰ অর্থে মই ক’ম, “যিৰূচালেমৰ মাজত শান্তি থাকক।”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"আমাৰ ঈশ্বৰ যিহোৱাৰ গৃহ সেই ঠাইত আছে বাবেই মই তোমাৰ মঙ্গল বিচাৰি","poem":1},{"noteId":132},{"text":"প্ৰার্থনা কৰিম।","poem":1}]}],"footnotes":[{"noteId":132,"caller":"+","text":"বিচাৰিম।","reference":{"chapter":122,"verse":9}}]},"thisChapterLink":"/api/asm_irv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}