{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["যাত্ৰাৰ সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"যিহোৱাই যেতিয়া চিয়োনক পুনৰ আগৰ অৱস্থালৈ ঘূৰাই আনিলে","poem":1},{"noteId":133},{"text":",","poem":1},{"lineBreak":true},{"text":"তেতিয়া আমি সপোন দেখা মানুহৰ নিচিনা হ’লো।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তেতিয়া আমাৰ মুখ হাঁহিৰে ভৰি পৰিল,","poem":1},{"lineBreak":true},{"text":"আমাৰ জিভা আনন্দ-গানেৰে পৰিপূৰ্ণ হ’ল;","poem":1},{"lineBreak":true},{"text":"আন জাতিৰ লোকসকলে তেতিয়া কোৱাকুই কৰিলে,","poem":1},{"lineBreak":true},{"text":"“যিহোৱাই তেওঁলোকৰ কাৰণে অনেক মহৎ কার্য কৰিলে।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যিহোৱাই আমাৰ কাৰণে অনেক মহৎ কৰ্ম কৰিলে;","poem":1},{"lineBreak":true},{"text":"সেয়ে আমি আনন্দ কৰিলোঁ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, নেগেভ মৰুভূমিৰ জুৰিবোৰৰ নিচিনাকৈ,","poem":1},{"lineBreak":true},{"text":"তুমি আমাৰ ভৱিষ্যত আগৰ অৱস্থালৈ ঘূৰাই আনা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিসকলে চকুলোৰে বয়, তেওঁলোকে আনন্দেৰে দাব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যিসকলে কান্দি কান্দি কঠীয়া ববলৈ ওলাই যায়, তেওঁলোকে নিশ্চয়ে আনন্দেৰে নিজৰ নিজৰ ডাঙৰি লৈ উলটি আহিব।","poem":1}]}],"footnotes":[{"noteId":133,"caller":"+","text":"যেতিয়া যিহোৱাই নির্বাসনৰ পৰা পুনৰ চিয়োনলৈ আনিলে, তেতিয়া ইয়াক পুনৰ উর্বৰ কৰিলে। (চিয়োনৰ আন নাম ‘যিৰুচালেম’।)","reference":{"chapter":126,"verse":1}}]},"thisChapterLink":"/api/asm_irv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}