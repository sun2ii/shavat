ype":"verse","number":5,"content":[{"lineBreak":true},{"text":"সেই পুৰুষ সুখী, যিজনৰ কাঁড়েৰে পূর্ণ কাঁড় থোৱা চূঙা থাকে।","poem":1},{"lineBreak":true},{"text":"নগৰৰ দুৱাৰত শত্ৰুবোৰে সৈতে তেওঁ যেতিয়া কথা পাতে, তেওঁ লজ্জিত নহ’ব।","poem":1}]}],"footnotes":[{"noteId":134,"caller":"+","text":"তেওঁ যি পাবলগীয়া, সেয়া তেওঁ নিদ্রাত থাকোতে পায়।","reference":{"chapter":127,"verse":2}}]},"thisChapterLink":"/api/asm_irv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}