em":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"এনে কি, তুমি তোমাৰ সন্তানৰ বংশকো দেখা পাবা।","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েলৰ ওপৰত শান্তি হওক।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}