6,"content":[{"lineBreak":true},{"text":"তেওঁলোক ঘৰৰ চালৰ ওপৰত গজা ঘাঁহৰ দৰে হওঁক,","poem":1},{"lineBreak":true},{"text":"যি নৌ বাঢ়োতেই শুকাই যায়;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যেয়ে তাক দাব বিচাৰে, তাৰে তেওঁৰ হাতৰ মুঠি পূৰ নহয়,","poem":1},{"lineBreak":true},{"text":"যেয়ে তাক ডাঙৰি বান্ধিব বিচাৰে, তাৰে তেওঁৰ ভড়াল পূর্ণ নহয়।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"বাটৰুৱাবোৰে সেই ফালেদি গ’লে তেওঁলোকক এনেদৰে নকয়,","poem":1},{"lineBreak":true},{"text":"“তোমালোকৰ ওপৰত যিহোৱাৰ আশীৰ্ব্বাদ থাকক!","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ নামেৰে আমি তোমালোকক আশীৰ্ব্বাদ দিছোঁ।”","poem":1}]}],"footnotes":[{"noteId":135,"caller":"+","text":"তেওঁ দুষ্টবোৰৰ ৰচীবোৰ ছিঙি পেলালে।","reference":{"chapter":129,"verse":4}}]},"thisChapterLink":"/api/asm_irv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}