{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["যাত্ৰাৰ সঙ্গীত"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, মই গভীৰ কষ্টৰ মাজত থাকি তোমাক মাতিছো।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে প্ৰভু, মোৰ স্বৰ শুনা!","poem":1},{"lineBreak":true},{"text":"মোৰ কাকুতিৰ স্বৰলৈ তুমি মনোযোগ দিয়া!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তুমি যদি অপৰাধ ধৰি ৰাখা,","poem":1},{"lineBreak":true},{"text":"তেন্তে প্রভু, কোন তিষ্ঠি থাকিব পাৰে?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিন্তু তোমাৰ ওচৰত ক্ষমা আছে,","poem":1},{"lineBreak":true},{"text":"যেন মানুহে তোমাক ভয় কৰে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"মই যিহোৱালৈ অপেক্ষা কৰিছোঁ, মোৰ প্ৰাণে অপেক্ষা কৰিছে,","poem":1},{"lineBreak":true},{"text":"মই তেওঁৰ বাক্যত আশা কৰিছোঁ।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"প্রহৰীসকলে যেনেকৈ ৰাতিপুৱালৈ অপেক্ষা কৰে,","poem":1},{"lineBreak":true},{"text":"হয়, তেওঁলোকে যেনেকৈ ৰাতিপুৱালৈ অপেক্ষা কৰি থাকে,","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ কাৰণে মোৰ প্রাণে তাতোকৈ অধিক বেচি অপেক্ষা কৰি আছে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে ইস্ৰায়েল, যিহোৱাৰ ওপৰত আশা ৰাখা, কিয়নো যিহোৱাৰ লগত সুস্থিৰ প্রেম আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ মুক্তি দিয়াৰ মহান ক্ষমতা আছে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তেৱেঁ ইস্ৰায়েলক মুক্ত কৰিব,","poem":1},{"lineBreak":true},{"text":"সকলো অপৰাধৰ পৰা মুক্ত কৰিব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}