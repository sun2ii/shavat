{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"যেতিয়া আমাৰ চিয়োনলৈ মনত পৰিছিল,","poem":1},{"lineBreak":true},{"text":"তেতিয়া বাবিলৰ নদীবিলাকৰ তীৰত বহি আমি কান্দিছিলোঁ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সেই ঠাইৰ মাজত থকা বাইচি গছত, আমি আমাৰ বীণাবোৰ আৰি থৈছিলোঁ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিয়নো তাত আমাক বন্দী কৰি নিয়াসকলে আমাক গান গাবলৈ কৈছিল,","poem":1},{"lineBreak":true},{"text":"সেই উপদ্রৱকাৰীবোৰে আমাৰ পৰা আনন্দৰ গান শুনিবলৈ বিচাৰিছিল;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে কৈছিল, “আমাৰ আগত চিয়োনৰ এটি গীত গোৱা।”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"আমি কেনেকৈ বিদেশী ভূমিত যিহোৱাৰ গীত-গান কৰিম?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে যিৰূচালেম, মই যদি তোমাক পাহৰোঁ,","poem":1},{"lineBreak":true},{"text":"তেন্তে মোৰ সোঁ হাতৰ দক্ষতা যেন নিজে অকামিলা হৈ যায়।","poem":1},{"noteId":138}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যদি মই তোমাক সোঁৱৰণ নকৰোঁ,","poem":1},{"lineBreak":true},{"text":"যদি যিৰূচালেমক মোৰ সবাতোকৈ বেচি আনন্দৰ বিষয় বুলি নাভাৱো,","poem":1},{"lineBreak":true},{"text":"তেতিয়া মোৰ জিভা তালুত লাগি ধৰক।","poem":1},{"noteId":139}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, যিৰূচালেমৰ ধ্বংসৰ দিনা ইদোমীয়াবোৰে যি কৰিছিল","poem":1},{"lineBreak":true},{"text":"তাক তেওঁলোকৰ বিৰুদ্ধে সোঁৱৰণ কৰা।","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে কৈছিল, “উচ্ছেদ কৰা! যিৰূচালেমক উচ্ছেদ কৰা,","poem":1},{"lineBreak":true},{"text":"একেবাৰে ইয়াৰ ভেঁটি পর্যন্ত উচ্ছেদ কৰা।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে বাবিল কন্যা, তোমাক বিনাশ কৰা হ’ব;","poem":1},{"lineBreak":true},{"text":"তুমি আমাৰ প্রতি যেনে ৰূপে ব্যৱহাৰ কৰিলা,","poem":1},{"lineBreak":true},{"text":"ধন্য সেইজন, যিজনে তোমাকো তেনে ৰূপে প্ৰতিফল দিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ধন্য সেইজন, যি জনে তোমাৰ শিশুসকলক ধৰি শিলত আছাৰিব।","poem":1}]}],"footnotes":[{"noteId":138,"caller":"+","text":"মোৰ সোঁ হাতৰ বীণা বজোৱা দক্ষতা যেন নিজে নিজে হেৰাই যায়।","reference":{"chapter":137,"verse":5}},{"noteId":139,"caller":"+","text":"তেতিয়া মই পুনৰ গান গাব নোৱাৰা হওঁ।","reference":{"chapter":137,"verse":6}}]},"thisChapterLink":"/api/asm_irv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}