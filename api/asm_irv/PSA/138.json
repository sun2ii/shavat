{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, মোৰ সমস্ত চিত্তেৰে মই তোমাৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"দেৱতাবোৰৰ আগত মই তোমাৰ প্ৰশংসাৰ গান কৰিম।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তোমাৰ পবিত্ৰ মন্দিৰৰ ফালে প্ৰণিপাত কৰিম;","poem":1},{"lineBreak":true},{"text":"তোমাৰ চিৰস্থায়ী প্রেম আৰু বিশ্ৱস্ততাৰ কাৰণে তোমাৰ নামৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"কিয়নো তোমাৰ নাম আৰু তোমাৰ আজ্ঞাবোৰ সকলোতকৈ মহান","poem":1},{"noteId":140},{"text":"।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"মই প্ৰাৰ্থনা কৰা কালত তুমি মোক উত্তৰ দিলা;","poem":1},{"lineBreak":true},{"text":"তুমি মোৰ প্ৰাণক শক্তি দি মোক উৎসাহিত কৰিলা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, পৃথিৱীৰ সকলো ৰজাই তোমাৰ ধন্যবাদ কৰিব;","poem":1},{"lineBreak":true},{"text":"কিয়নো তেওঁলোকে তোমাৰ মুখৰ বাক্য শুনিলে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তেওঁলোকে যিহোৱাৰ পথৰ বিষয়ে গান কৰিব;","poem":1},{"lineBreak":true},{"text":"কিয়নো যিহোৱাৰ গৌৰৱ মহান।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কাৰণ যদিও যিহোৱা সকলোৰে উচ্চত, তথাপি তেওঁ হীন অৱস্থাৰ লোকলৈ দৃষ্টি ৰাখে;","poem":1},{"lineBreak":true},{"text":"কিন্তু অহংকাৰী লোকক তেওঁ দূৰৈৰ পৰাই জানে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যেতিয়া মই সঙ্কটৰ মাজেদি গমন কৰোঁ,","poem":1},{"lineBreak":true},{"text":"তেতিয়া তুমি মোৰ প্রাণ ৰক্ষা কৰিবা","poem":1},{"noteId":141},{"text":";","poem":1},{"lineBreak":true},{"text":"তুমি মোৰ শত্ৰুবোৰৰ ক্ৰোধৰ অহিতে তোমাৰ হাত মেলিবা আৰু তোমাৰ সোঁ হাতেৰে মোক উদ্ধাৰ কৰিবা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিহোৱাই মোৰ পক্ষে নিজৰ উদ্দেশ্য সিদ্ধ কৰিব;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা, তোমাৰ প্রেম অনন্তকাল স্থায়ী।","poem":1},{"lineBreak":true},{"text":"তুমি তোমাৰ হাতৰ কৰ্ম ত্যাগ নকৰিবা।","poem":1}]}],"footnotes":[{"noteId":140,"caller":"+","text":"তুমি তোমাৰ নাম আৰু কথাবোৰ উন্নত কৰিলা। বা, তুমি তোমাৰ নাম আৰু প্রতিজ্ঞাক সকলোতকৈ মহান কৰিলা।","reference":{"chapter":138,"verse":2}},{"noteId":141,"caller":"+","text":"তুমি মোক পুনৰুত্থান কৰিবা","reference":{"chapter":138,"verse":7}}]},"thisChapterLink":"/api/asm_irv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}