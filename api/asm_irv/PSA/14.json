{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"এজন অজ্ঞানীয়ে, তেওঁৰ অন্তৰত কয়, “ঈশ্বৰ বুলি কোনো নাই।”","poem":1},{"lineBreak":true},{"text":"তেওঁলোক ভ্রষ্ট হৈছে, তেওঁলোকে জঘন্য কার্যবোৰ কৰে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ মাজত সৎ কার্য কৰোঁতা কোনো নাই;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাই স্বর্গৰ পৰা তললৈ মানুহৰ ফালে লক্ষ্য কৰি থাকে;","poem":1},{"lineBreak":true},{"text":"তেওঁ চাব বিচাৰে, প্রকৃতার্থত কোনো জ্ঞানী আছে নে নাই;","poem":1},{"lineBreak":true},{"text":"তেওঁ চাব বিচাৰে, ঈশ্বৰক বিচাৰা কোনো জ্ঞানী আছে নে নাই।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁ দেখিলে, সকলোৱেই অপথে গ’ল;","poem":1},{"lineBreak":true},{"text":"সকলো উচ্ছৃঙ্খল হ’ল;","poem":1},{"lineBreak":true},{"text":"সৎকৰ্ম কৰোঁতা কোনো নাই, এজনো নাই।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যিসকলে দুষ্টতাৰ কার্য কৰে, তেওঁলোক কি ইমানেই জ্ঞানশূন্য যে,","poem":1},{"lineBreak":true},{"text":"মানুহে নিজৰ আহাৰ খোৱাৰ নিচিনাকৈ তেওঁলোকে মোৰ লোকসকলক খাই পেলায় আৰু","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে যিহোৱাৰ ওচৰত প্ৰাৰ্থনাও নকৰে?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ঈশ্বৰ তেওঁৰ ভক্তসকলৰ সঙ্গত থাকে।","poem":1},{"lineBreak":true},{"text":"সেয়ে সেই লোকসকল তাত ভীষণ ভয়ৰ মাজত থাকিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"দুষ্টতাৰ কার্য কৰা যি তোমালোক,","poem":1},{"lineBreak":true},{"text":"তোমালোকে দুখীয়াৰ পৰিকল্পনা ব্যৰ্থ কৰিবা,","poem":1},{"lineBreak":true},{"text":"কিন্তু যিহোৱা তেওঁলোকৰ আশ্ৰয়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"অহ! ইস্রায়েলৰ উদ্ধাৰ চিয়োনৰ মাজৰ পৰা আহক!","poem":1},{"lineBreak":true},{"text":"যিহোৱাই যেতিয়া তেওঁৰ লোকসকলৰ অৱস্থা পুনৰ পৰিবর্তন কৰিব,","poem":1},{"lineBreak":true},{"text":"তেতিয়া যাকোবৰ বংশই আনন্দ কৰিব;","poem":1},{"lineBreak":true},{"text":"ইস্রায়েলীয়াসকল উল্লাসিত হ’ব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}