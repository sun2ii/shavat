{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, মই তোমাক মাতিছো;","poem":1},{"lineBreak":true},{"text":"তুমি শীঘ্রেই মোৰ ওচৰলৈ আহাঁ।","poem":1},{"lineBreak":true},{"text":"মই প্ৰাৰ্থনা কৰা কালত তুমি মোৰ স্বৰলৈ কাণ পাতা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মোৰ প্ৰাৰ্থনা তোমাৰ আগত সুগন্ধি ধূপৰ দৰে হওঁক,","poem":1},{"lineBreak":true},{"text":"মই ওপৰলৈ তোলা মোৰ হাত সন্ধিয়া উৎসর্গ কৰা বলিদানৰ দৰে হওঁক।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মোৰ মুখৰ আগত তুমি ৰখীয়া ৰাখা,","poem":1},{"lineBreak":true},{"text":"মোৰ ওঁঠৰ দুৱাৰত ৰখীয়া ৰাখা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কোনো মন্দ বিষয়ত মোৰ মন প্রবৃত্ত নকৰিবা,","poem":1},{"lineBreak":true},{"text":"মই যেন অধার্মিকবোৰৰ সৈতে দুষ্টতাৰ কাৰ্য নকৰোঁ;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ সুস্বাদু আহাৰ যেন মই গ্রহণ নকৰোঁ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ধাৰ্মিক লোকে মোক প্ৰহাৰ কৰক, সেয়া মোৰ বাবে এক দয়া হ’ব;","poem":1},{"lineBreak":true},{"text":"তেওঁ মোক অনুযোগ কৰক,","poem":1},{"lineBreak":true},{"text":"সেয়া মোৰ মূৰত দিয়া তেলৰ নিচিনা হ’ব;","poem":1},{"lineBreak":true},{"text":"মোৰ মূৰে তাক গ্রহণ কৰিবলৈ অগ্ৰাহ্য নকৰক।","poem":1},{"lineBreak":true},{"text":"কিন্তু মোৰ প্রার্থনা সকলো সময়তে","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰৰ কার্যৰ বিৰুদ্ধে থাকিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ শাসক সকলক ওখ পর্বতৰ ওপৰৰ পৰা তললৈ পেলোৱা হ’ব,","poem":1},{"lineBreak":true},{"text":"তেতিয়া তেওঁলোকে মোৰ বাক্যলৈ কাণ দিব, কিয়নো সেয়ে মধুৰ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মানুহে হাল বাই যেনেকৈ মাটি ভাঙে,","poem":1},{"lineBreak":true},{"text":"তেনেকৈ আমাৰ অস্থিবোৰ চিয়োলৰ মুখত সিচঁৰিত হৈছে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"কিন্তু হে মোৰ ঈশ্বৰ যিহোৱা, মোৰ চকু তোমাৰ ফালেই আছে;","poem":1},{"lineBreak":true},{"text":"মই তোমাতেই আশ্ৰয় লৈছোঁ,","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাণ মৃত্যুৰ হাতত এৰি নিদিবা।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তেওঁলোকে মোৰ কাৰণে যি জাল পাতিছে,","poem":1},{"lineBreak":true},{"text":"তাৰ পৰা মোক ৰক্ষা কৰা,","poem":1},{"lineBreak":true},{"text":"অধার্মিকবোৰৰ ফান্দৰ পৰা মোক ৰক্ষা কৰা।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"দুষ্ট লোক তেওঁলোকৰ নিজৰ জালত নিজেই পৰক,","poem":1},{"lineBreak":true},{"text":"আৰু মই সেই সময়ত অকলেই ৰক্ষা পাম।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}