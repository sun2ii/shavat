{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["গুহাত থকাৰ সময়ত দায়ুদৰ ৰচিত মচকীল নামৰ গীত। এটি প্ৰাৰ্থনা।"]},{"type":"verse","number":1,"content":[{"text":"মই চিঞঁৰি যিহোৱাৰ ওচৰত ক্রন্দন কৰিলোঁ,","poem":1},{"lineBreak":true},{"text":"মই নিজ স্বৰেৰে যিহোৱাৰ আগত মিনতি কৰিলোঁ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মই মোৰ দুখৰ কথা তেওঁৰ আগত ভাঙি ক’লো,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ আগত মোৰ কষ্টৰ কথা জনালোঁঁ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"মোৰ আত্মা যেতিয়া অন্তৰত ব্যাকুল হয়,","poem":1},{"lineBreak":true},{"text":"তেতিয়া তুমি মোৰ পথ জানা;","poem":1},{"lineBreak":true},{"text":"মই অহা-যোৱা কৰা পথত লোকবোৰে মোৰ বাবে গোপনে ফান্দ পাতিলে;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মোৰ সোঁ ফালে দৃষ্টি কৰি চোৱা,","poem":1},{"lineBreak":true},{"text":"মোৰ খবৰ লওঁতা কোনো নাই;","poem":1},{"lineBreak":true},{"text":"মোৰ বাবে আশ্রয় স্থান নাই,","poem":1},{"lineBreak":true},{"text":"মোৰ বাবে কোনেও চিন্তা নকৰে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মই তোমাৰ ওচৰত ক্রন্দনৰে কৈছো,","poem":1},{"lineBreak":true},{"text":"“তুমিয়েই মোৰ আশ্ৰয়, জীৱিত লোকৰ দেশত তুমিয়েই মোৰ অধিকাৰ।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তুমি মোৰ কাকুতিলৈ মনোযোগ দিয়া,","poem":1},{"lineBreak":true},{"text":"কিয়নো মই অতি অসহায় অৱস্থাত পৰিছোঁ;","poem":1},{"lineBreak":true},{"text":"মোৰ তাড়নাকাৰীবোৰৰ হাতৰ পৰা মোক উদ্ধাৰ কৰা,","poem":1},{"lineBreak":true},{"text":"কাৰণ তেওঁলোক মোতকৈ শক্তিশালী।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কাৰাগাৰৰ পৰা মোৰ প্রাণ মুক্ত কৰা,","poem":1},{"lineBreak":true},{"text":"যেন মই তোমাৰ নামৰ ধন্যবাদ কৰিব পাৰোঁ;","poem":1},{"lineBreak":true},{"text":"ধাৰ্মিকসকলে মোক চাৰিওফালে ঘেৰি ৰাখিব;","poem":1},{"lineBreak":true},{"text":"কাৰণ তুমি মোলৈ প্রচুৰ মঙ্গল কৰিবা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}