{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1},{"lineBreak":true},{"text":"হে মোৰ মন, যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মোৰ আয়ুস থাকেমানে মই যিহোৱাৰ প্ৰশংসা কৰিম,","poem":1},{"lineBreak":true},{"text":"জীয়াই থাকোঁমানে মোৰ ঈশ্বৰৰ উদ্দেশ্যে প্ৰশংসাৰ গান কৰিম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমালোকে কোনো অধিপতি বা কোনো মানুহৰ সন্তানৰ ওপৰত ভাৰসা নকৰিবা;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে সহায় কৰিব নোৱাৰে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ উশাহ বাহিৰ হৈ গ’লে, তেওঁলোক পুনৰায় মাটিলৈ ঘূৰি যায়;","poem":1},{"lineBreak":true},{"text":"সেই দিনাই তেওঁলোকৰ সকলো পৰিকল্পনা শেষ হৈ যায়।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যাকোবৰ ঈশ্বৰ যাৰ সহায় সেই জন ধন্য;","poem":1},{"lineBreak":true},{"text":"যাৰ আশাভূমি যিহোৱা তেওঁৰ ঈশ্বৰ।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেৱেঁই আকাশ-মণ্ডল আৰু পৃথিৱী, সমুদ্ৰ আৰু তাত থকা সকলোৰে সৃষ্টিকর্তা,","poem":1},{"lineBreak":true},{"text":"তেওঁ অনন্তকালে বিশ্বাসযোগ্য।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তেওঁ উপদ্ৰৱ পোৱাসকলৰ পক্ষে ন্যায় বিচাৰ কৰে,","poem":1},{"lineBreak":true},{"text":"ক্ষুধাতুৰবোৰক আহাৰ দান কৰে;","poem":1},{"lineBreak":true},{"text":"যিহোৱাই বন্দীবোৰক মুক্ত কৰে;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিহোৱাই অন্ধবোৰৰ চকু মুকলি কৰে,","poem":1},{"lineBreak":true},{"text":"নত অৱস্থাত থকাসকলক যিহোৱাই তুলি ধৰে;","poem":1},{"lineBreak":true},{"text":"যিহোৱাই ধাৰ্মিক লোকক প্ৰেম কৰে;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাই বিদেশীবোৰক ৰক্ষা কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁ মাউৰা আৰু বিধৱাসকলক ধৰি ৰাখে,","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টবোৰৰ পথ তেওঁ বিঘিনিযুক্ত কৰে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিহোৱাই অনন্ত কাল ৰাজত্ব কৰিব;","poem":1},{"lineBreak":true},{"text":"হে চিয়োন, পুৰুষানুক্ৰমে তোমাৰ ঈশ্বৰে ৰাজত্ব কৰিব।","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}