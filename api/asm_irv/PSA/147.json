{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা;","poem":1},{"lineBreak":true},{"text":"কিয়নো আমাৰ ঈশ্বৰৰ উদ্দেশ্যে প্ৰশংসাৰ গীত গোৱা কেনে উত্তম!","poem":1},{"lineBreak":true},{"text":"কাৰণ সেয়ে সন্তোষজনক, প্ৰশংসাৰ উপযুক্ত।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাই যিৰূচালেমক পুনৰায় নিৰ্ম্মাণ কৰে;","poem":1},{"lineBreak":true},{"text":"সিঁচৰতি হৈ পৰা ইস্ৰায়েলীয়াসকলক তেওঁ গোটাই একত্র কৰে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁ ভগ্ন চিত্তীয়া লোকক সুস্থ কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁ তেওঁলোকৰ ঘাঁবোৰ বান্ধে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁ তৰাবোৰ গণনা কৰে;","poem":1},{"lineBreak":true},{"text":"তেওঁ সেইবোৰৰ প্রত্যেককে নাম ধৰি ধৰি মাতে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"আমাৰ প্ৰভু মহান;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ পৰাক্ৰম প্রচুৰ; তেওঁৰ জ্ঞান-বুদ্ধিৰ সীমা নাই।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যিহোৱাই নম্ৰ লোকক ধৰি ৰাখে;","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰক মাটিলৈ পেলাই দিয়ে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ উদ্দেশ্যে ধন্যবাদৰ গীত গোৱা;","poem":1},{"lineBreak":true},{"text":"বীণাৰে সৈতে আমাৰ ঈশ্বৰৰ প্রশংসাৰ গীত গোৱা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যি জনাই আকাশমণ্ডল মেঘেৰে ঢাকে,","poem":1},{"lineBreak":true},{"text":"যি জনাই পৃথিৱীলৈ বৰষুণৰ ব্যৱস্থা কৰে,","poem":1},{"lineBreak":true},{"text":"যি জনাই পৰ্ব্বতবোৰৰ ওপৰত ঘাঁহ গজায়,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"পশু আৰু চিঁ চিঁয়াই থকা কাউৰী পোৱালিবোৰে মাতিলে","poem":1},{"lineBreak":true},{"text":"তেওঁ আহাৰ দিয়ে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ঘোঁৰাৰ শক্তিত তেওঁ সন্তোষ নাপায়,","poem":1},{"lineBreak":true},{"text":"মানুহৰ","poem":1},{"noteId":146},{"text":"ভৰিৰ শক্তিতো তেওঁ সন্তুষ্ট নহয়;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কিন্তু যিসকলে যিহোৱাক ভয় কৰে,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁৰ সুস্থিৰ প্রেমত আশা ৰাখে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকক লৈয়েই যিহোৱা সন্তুষ্ট হয়।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"হে যিৰূচালেম, যিহোৱাৰ প্রশংসা কৰা;","poem":1},{"lineBreak":true},{"text":"হে চিয়োন, তোমাৰ ঈশ্বৰৰ প্ৰশংসা কৰা।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"কিয়নো তেওঁ তোমাৰ দুৱাৰৰ ডাংবোৰ দৃঢ় কৰিলে,","poem":1},{"lineBreak":true},{"text":"তোমাৰ মাজত বাস কৰা তোমাৰ সন্তান সকলক আশীৰ্ব্বাদ দিলে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তোমাৰ সীমাৰ ভিতৰত তেৱেঁই শান্তি ৰাখে;","poem":1},{"lineBreak":true},{"text":"তোমাক উত্তম ঘেঁহুৰে পৰিতৃপ্ত কৰে।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তেওঁ পৃথিৱীলৈ নিজৰ আজ্ঞা পঠায়;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ বাক্য ততালিকে ধাবমান হয়।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"তেওঁ মেৰ-ছাগৰ নোমৰ সদৃশ তুষাৰ দিয়ে,","poem":1},{"lineBreak":true},{"text":"ছাঁইৰ দৰে নিয়ৰ সিঁচি দিয়ে।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"তেওঁ টুকুৰা টুকুৰ কৰি শিল বৰষায়;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ শীতৰ সন্মুখত কোন থাকিব পাৰে?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ বাক্য পঠাই সেই সকলো দ্রৱীভূত কৰে;","poem":1},{"lineBreak":true},{"text":"তেওঁ নিজৰ বতাহ বলালে পানী বৈ যায়।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"তেওঁ যাকোবক নিজৰ বাক্য ঘোষণা কৰিলে;","poem":1},{"lineBreak":true},{"text":"আৰু ইস্ৰায়েলৰ ওচৰত নিজৰ বিধি আৰু শাসন প্ৰণালীবোৰ জনালে।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"অন্য কোনো জাতিৰ কাৰণে তেওঁ এইৰূপ ব্যৱহাৰ কৰা নাই;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ শাসন প্ৰণালীবোৰ তেওঁলোকে নাজানে।","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]}],"footnotes":[{"noteId":146,"caller":"+","text":"মানুহৰ যোদ্ধাৰ","reference":{"chapter":147,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}