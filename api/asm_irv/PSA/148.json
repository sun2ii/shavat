{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1},{"lineBreak":true},{"text":"স্বর্গৰ পৰা যিহোৱাৰ প্ৰশংসা কৰা; উচ্চ স্থানত তেওঁৰ প্ৰশংসা কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে যিহোৱাৰ সকলো দূত, তেওঁৰ প্ৰশংসা কৰা;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱাৰ সকলো বাহিনী, তেওঁৰ প্ৰশংসা কৰা!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে সূৰ্য আৰু চন্দ্ৰ, তেওঁৰ প্ৰশংসা কৰা;","poem":1},{"lineBreak":true},{"text":"হে দীপ্তিময় সকলো তৰা, তেওঁৰ প্ৰশংসা কৰা!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"হে স্বর্গৰ স্বর্গ, তেওঁৰ প্ৰশংসা কৰা!","poem":1},{"lineBreak":true},{"text":"হে আকাশ-মণ্ডলৰ উর্দ্ধস্থানৰ জল সমূহ, তেওঁৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সেইবোৰ সকলোৱে যিহোৱাৰ নামৰ প্ৰশংসা কৰক;","poem":1},{"lineBreak":true},{"text":"কিয়নো তেওঁ আজ্ঞা দিলে আৰু এইবোৰৰ সৃষ্টি হ’ল।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁ চিৰকালৰ কাৰণে সেইবোৰক সঠিক ঠাইত স্থাপন কৰিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁ এটা বিধি দিলে, কোনোৱে তাক উলঙ্ঘন কৰিব নোৱাৰিব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে সাগৰৰ প্রকাণ্ড জলচৰবোৰ আৰু মহাসাগৰৰ গভীৰ অধোভাগ,","poem":1},{"lineBreak":true},{"text":"পৃথিৱীৰ পৰা তোমালোকে যিহোৱাৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে জুই","poem":1},{"noteId":147},{"text":"আৰু শিলাবৃষ্টি, তুষাৰ আৰু কুঁৱলী,","poem":1},{"lineBreak":true},{"text":"আৰু যিহোৱাৰ আজ্ঞা পালন কৰা প্রৱল ধুমুহা, তেওঁৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে সকলো পর্বত আৰু পাহাৰবোৰ,","poem":1},{"lineBreak":true},{"text":"আৰু ফলৱতী গছ আৰু এৰচ গছবোৰ, তেওঁৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"হে বনৰীয়া জন্তু আৰু ঘৰচীয়া পশুবোৰ,","poem":1},{"lineBreak":true},{"text":"আৰু বগাই ফুৰা উৰগ আৰু ডেউকা লগা পক্ষীসমূহ, তেওঁৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে পৃথিৱীৰ ৰজাসকল আৰু সমুদায় জাতি,","poem":1},{"lineBreak":true},{"text":"অধিপতি আৰু পৃথিৱীৰ শাসকগণ, তেওঁৰ প্রশংসা কৰা!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"হে যুৱক আৰু যুৱতীসকল, বৃদ্ধ আৰু শিশুসকল,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ প্ৰশংসা কৰা!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"এই সকলোবোৰে যিহোৱাৰ প্ৰশংসা কৰক;","poem":1},{"lineBreak":true},{"text":"কিয়নো কেৱল তেওঁৰেই নাম মহান;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ গৌৰৱ পৃথিৱী আৰু আকাশ-মণ্ডলৰ ওপৰলৈকে বিস্তাৰিত।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তেওঁ নিজৰ লোকসকলৰ কাৰণে এটি শিং উত্তোলন কৰিলে;","poem":1},{"lineBreak":true},{"text":"সেয়া তেওঁৰ সকলো ভক্তৰ বাবে প্রশংসা,","poem":1},{"lineBreak":true},{"text":"সেয়া তেওঁৰ ওচৰত থকা ইস্রায়েল জাতিৰ বাবে প্রশংসা।","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ প্ৰশংসা কৰা।","poem":1}]}],"footnotes":[{"noteId":147,"caller":"+","text":"বিজুলী","reference":{"chapter":148,"verse":8}}]},"thisChapterLink":"/api/asm_irv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}