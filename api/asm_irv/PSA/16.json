{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["মিকটাম নামৰ দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, তুমি মোক ৰক্ষা কৰা,","poem":1},{"lineBreak":true},{"text":"কিয়নো মই তোমাতেই আশ্ৰয় লৈছোঁ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মই যিহোৱাক ক’লোঁ, “তুমিয়েই মোৰ প্ৰভু;","poem":1},{"lineBreak":true},{"text":"তোমাৰ বাহিৰে মোৰ আন কতো মঙ্গল নাই।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"পৃথিবীত যি সকল পবিত্ৰ লোক থাকে তেওঁলোক মহান;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ ওপৰতে মোৰ আনন্দ সম্পূৰ্ণ হয়।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যিসকলে আন দেৱতাক মনোনীত কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ অধিক যাতনা হ’ব,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ দেৱতাৰ উদ্দেশ্যে অনা তেজৰ যি পেয় নৈবেদ্য, মই তাক উৎসৰ্গ নকৰিম;","poem":1},{"lineBreak":true},{"text":"দেৱতাৰ নামো মোৰ ওঁঠত নলম।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিহোৱা, তুমিয়েই মোৰ আধিপত্যৰ মনোনীত ভাগ আৰু মোৰ পান-পাত্র;","poem":1},{"lineBreak":true},{"text":"মোৰ ভৱিষ্যত তোমাৰ হাততে আছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মোৰ সীমাৰ মাজত যি ঠাই পৰিছে, সেয়ে মনোহৰ ঠাই,","poem":1},{"lineBreak":true},{"text":"অৱশ্যেই মোৰ এক মনোমোহা আধিপত্য আছে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যি জনাই মোক সুবুদ্ধি দিয়ে, মই সেই যিহোৱাৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"ৰাতিও মোৰ হৃদয়ে মোক শিক্ষা দিয়ে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"মই যিহোৱাক সদায় মোৰ সন্মূখত ৰাখোঁ;","poem":1},{"lineBreak":true},{"text":"তেওঁ মোৰ সোঁহাতে থকাত মই অস্থিৰ নহম।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"এই কাৰণে মোৰ মন আনন্দেৰে ভৰা,","poem":1},{"lineBreak":true},{"text":"মোৰ হৃদয়ে উল্লাস কৰে;","poem":1},{"lineBreak":true},{"text":"মোৰ শৰীৰ নিৰাপদে থাকিব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কিয়নো তুমি মোৰ প্ৰাণ চিয়োলত ত্যাগ নকৰিবা,","poem":1},{"lineBreak":true},{"text":"তোমাৰ ভক্তজনক গাতত ক্ষয় পাবলৈ নিদিবা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তুমি মোক জীৱনৰ পথ শিকাইছা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ উপস্থিতিত আছে পৰিপূর্ণ আনন্দ;","poem":1},{"lineBreak":true},{"text":"তোমাৰ সোঁ-হাতত আছে অনন্ত সুখ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}