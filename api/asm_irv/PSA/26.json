{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, মোৰ বিচাৰ কৰা,","poem":1},{"lineBreak":true},{"text":"কিয়নো মই নিজ সিদ্ধতাত চলিছোঁ,","poem":1},{"lineBreak":true},{"text":"অলৰভাৱে মই যিহোৱাত ভাৰসা কৰিছোঁ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তুমি মোক পৰীক্ষা কৰি মোৰ শুদ্ধতাৰ প্রমাণ চোৱা;","poem":1},{"lineBreak":true},{"text":"মোৰ হৃদয় আৰু মনক খপি চোৱা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কাৰণ তোমাৰ অসীম দয়া মোৰ চকুৰ আগত আছে,","poem":1},{"lineBreak":true},{"text":"মই তোমাৰ বিশ্বস্ততাত চলা-ফুৰা কৰোঁ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"প্রৱঞ্চক লোকসকলৰ লগত মই বহা নাই।","poem":1},{"lineBreak":true},{"text":"অসৎ লোকসকলৰ সৈতে মই মিলা-মিছা কৰা নাই।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"মই দুষ্টবোৰৰ সমাজক ঘৃণা কৰোঁ;","poem":1},{"lineBreak":true},{"text":"দুষ্ট লোকৰ লগত নবহো।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মই মোৰ নিৰ্দোষীতাত হাত ধোওঁ,","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ যজ্ঞবেদী প্রদক্ষিণ কৰোঁ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যাতে মই উচ্চস্বৰে প্রশংসাৰ গীত গাই তোমাক ধন্যবাদ জনাব পাৰোঁ;","poem":1},{"lineBreak":true},{"text":"তোমাৰ আচৰিত কৰ্মবোৰ প্ৰচাৰ কৰিব পাৰোঁ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, যি গৃহত তুমি নিবাস কৰা,","poem":1},{"lineBreak":true},{"text":"তোমাৰ গৌৰৱ সেই ঠাইত থাকে,","poem":1},{"lineBreak":true},{"text":"মই তোমাৰ নিবাস গৃহক ভাল পাওঁ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"পাপীবোৰৰ লগত মোৰ প্ৰাণ লৈ নাযাবা;","poem":1},{"lineBreak":true},{"text":"ৰক্তপাতী মনুষ্যবোৰৰ লগত মোৰ জীৱন নিনিবা।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ হাতত দুষ্টতাৰ পৰিকল্পনা আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ সোঁহাত উৎকোচেৰে ভৰা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কিন্তু মই হলে নিজ সিদ্ধতাত চলোঁ;","poem":1},{"lineBreak":true},{"text":"মোক মুক্ত কৰা; মোক কৃপা কৰা।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"মোৰ ভৰি সমান ঠাইত থিয় হৈ আছে;","poem":1},{"lineBreak":true},{"text":"মহা-সমাজবোৰৰ মাজত মই যিহোৱাৰ ধন্যবাদ কৰিম।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}