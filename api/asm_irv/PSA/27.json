{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত"]},{"type":"verse","number":1,"content":[{"text":"যিহোৱা মোৰ দীপ্তি, মোৰ পৰিত্ৰাণ;","poem":1},{"lineBreak":true},{"text":"মই কাক ভয় কৰিম?","poem":1},{"lineBreak":true},{"text":"যিহোৱা মোৰ জীৱন ৰক্ষক কোঁঠ,","poem":1},{"lineBreak":true},{"text":"মই কাৰ বাবে ত্ৰাসযুক্ত হম?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"দুষ্টবোৰে যেতিয়া মোৰ মাংস খাবলৈ ওচৰলৈ আহে,","poem":1},{"lineBreak":true},{"text":"তেতিয়া মোৰ সেই শত্রু আৰু বিৰোধীবোৰ উজুতি খাই পৰে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সৈন্যৰ দলেও যদি মোৰ বিৰুদ্ধে ছাউনি পাতে,","poem":1},{"lineBreak":true},{"text":"মোৰ হৃদয়ে ভয় নকৰিব;","poem":1},{"lineBreak":true},{"text":"মোৰ বিৰুদ্ধে যদি যুদ্ধও আৰম্ভ হয়,","poem":1},{"lineBreak":true},{"text":"তেতিয়াও মই সাহসেৰে থাকিম।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ ওচৰত মই এটা বিষয় যাচনা কৰিছোঁ,","poem":1},{"lineBreak":true},{"text":"মই তাকেই অন্বেষণ কৰিম:","poem":1},{"lineBreak":true},{"text":"মই যেন যিহোৱাৰ সৌন্দর্য দেখা পাবলৈ,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁৰ মন্দিৰত ধ্যান কৰিবলৈ","poem":1},{"lineBreak":true},{"text":"মোৰ গোটেই জীৱন কাল যিহোৱাৰ গৃহত বাস কৰিব পাৰোঁ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"আপদৰ কালত তেওঁ মোক নিজ আশ্রয়ত গুপুতে ৰাখিব,","poem":1},{"lineBreak":true},{"text":"নিজৰ তম্বুত মোক লুকুৱাই ৰাখিব;","poem":1},{"lineBreak":true},{"text":"তেওঁ মোক শিলৰ ওপৰত তুলি থব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যি শত্রুবোৰে মোক চাৰিওফালে বেৰি ধৰিছে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকতকৈ মোৰ মূৰ উন্নত হব;","poem":1},{"lineBreak":true},{"text":"মই তেওঁৰ তম্বুত আনন্দ জয়ধ্বনিৰে বলি উৎসৰ্গ কৰিম।","poem":1},{"lineBreak":true},{"text":"মই যিহোৱাৰ উদ্দেশ্যে গীত-গান কৰিম!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মই মাতিলে, তুমি শুনা।","poem":1},{"lineBreak":true},{"text":"মোক কৃপা কৰা, মোক উত্তৰ দিয়া!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"মোৰ হৃদয়ে","poem":1},{"noteId":27},{"text":"তোমাৰ এই কথাকে ক’লে, “আহাঁ, তোমালোকে মোৰ সাক্ষাৎ পাবলৈ বিচাৰা।”","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা, মই তোমাৰ সাক্ষাৎ পাবলৈ বিচাৰো।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তোমাৰ মুখ মোৰ পৰা লুকুৱাই নাৰাখিবা;","poem":1},{"lineBreak":true},{"text":"ক্ৰোধত তুমি তোমাৰ দাসক দূৰ নকৰিবা।","poem":1},{"lineBreak":true},{"text":"তুমিয়েই মোৰ সহায় হৈ আহিছা;","poem":1},{"lineBreak":true},{"text":"হে মোৰ পৰিত্ৰাণৰ ঈশ্বৰ, মোক নেৰিবা, মোক পৰিত্যাগ নকৰিবা!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"মোৰ পিতৃ-মাতৃয়ে মোক ত্যাগ কৰিলেও, যিহোৱাই মোক তুলি লব।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে যিহোৱা,","poem":1},{"lineBreak":true},{"text":"মোৰ শত্রুবোৰৰ কাৰণে,","poem":1},{"lineBreak":true},{"text":"তুমি মোক তোমাৰ পথ শিকোৱা;","poem":1},{"lineBreak":true},{"text":"তুমি মোক সমান পথত চলোৱা।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"মোৰ বিৰোধীবোৰৰ ইচ্ছাত তুমি মোক সমর্পণ নকৰিবা;","poem":1},{"lineBreak":true},{"text":"কিয়নো মিছা সাক্ষীবোৰ মোৰ বিৰুদ্ধে উঠিছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ প্রশ্ৱাসত অত্যাচাৰ ওলাই আহে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"মই বিশ্বাস কৰোঁ যে,","poem":1},{"lineBreak":true},{"text":"জীৱিতসকলৰ দেশত মই যিহোৱাৰ মঙ্গল দেখা পাম","poem":1},{"noteId":28},{"text":"!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তুমি যিহোৱালৈ অপেক্ষা কৰা;","poem":1},{"lineBreak":true},{"text":"সবল হোৱা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ অন্তঃকৰণ সাহিয়াল হওঁক;","poem":1},{"lineBreak":true},{"text":"পুনৰায় কওঁ, যিহোৱালৈ অপেক্ষা কৰা।","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"মোৰ হৃদয়ে তুমি কোৱা","reference":{"chapter":27,"verse":8}},{"noteId":28,"caller":"+","text":"যেতিয়া মই জীৱিতসকলৰ দেশত আশা নকৰি যিহোৱাৰ মঙ্গল দেখা পাম বুলি বাট চাওঁ, তেতিয়া মই নিৰাশ হৈ মৰাৰ দৰে হওঁ।","reference":{"chapter":27,"verse":13}}]},"thisChapterLink":"/api/asm_irv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}