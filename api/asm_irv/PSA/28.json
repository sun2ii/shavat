{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, মই তোমাৰ ওচৰত প্ৰাৰ্থনা কৰিছোঁ;","poem":1},{"lineBreak":true},{"text":"হে মোৰ শিলা, মোলৈ আওকাণ নকৰিবা।","poem":1},{"lineBreak":true},{"text":"কাৰণ, তুমি যদি মনে মনে থাকা,","poem":1},{"lineBreak":true},{"text":"তেন্তে মৈদামৰ গাতলৈ নামি যোৱাবোৰৰ দৰে মোৰ দশা হ’ব।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সহায়ৰ কাৰণে মই যেতিয়া তোমাৰ আগত কাতৰোক্তি কৰোঁ,","poem":1},{"lineBreak":true},{"text":"তোমাৰ মহা পবিত্ৰ স্থানৰ ফাললৈ হাত দাঙো,","poem":1},{"lineBreak":true},{"text":"তেতিয়া তুমি মোৰ নিবেদন শুনা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যিসকল দুষ্ট, যিসকলে দুষ্টতাৰ কার্য কৰি ফুৰে,","poem":1},{"lineBreak":true},{"text":"যিসকলে চুবুৰীয়াৰ লগত মুখেৰে শান্তিৰ কথা কয়,","poem":1},{"lineBreak":true},{"text":"অথচ অন্তঃকৰনত দুষ্ট ইচ্ছা পুহি ৰাখে,","poem":1},{"lineBreak":true},{"text":"সেইসকলৰ লগত তুমি মোক টানি নিনিবা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁলোকৰ কাৰ্য আৰু কৰ্মৰ দুষ্টতা অনুসাৰে,","poem":1},{"lineBreak":true},{"text":"তুমি তেওঁলোকক প্ৰতিফল দিয়া;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকৰ হাতৰ কার্য অনুসাৰে তেওঁলোকক প্রতিফল দিয়া।","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে পাবলগীয়া যি আছে, তাকেই তেওঁলোকক দিয়া।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো তেওঁলোকে যিহোৱাৰ কাৰ্য বা তেওঁৰ হাতে কৰা কর্মলৈ মনোযোগ নিদিয়ে;","poem":1},{"lineBreak":true},{"text":"সেয়ে, যিহোৱাই তেওঁলোকক বিনষ্ট কৰিব,","poem":1},{"lineBreak":true},{"text":"আৰু পুনৰায় গঢ় নিদিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সকলো প্রশংসা যিহোৱাৰেই; তেওঁ মোৰ কাকুতিৰ স্বৰ শুনিলে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যিহোৱাই মোৰ বল আৰু মোৰ ঢাল;","poem":1},{"lineBreak":true},{"text":"মোৰ হৃদয়ে তেওঁতে ভাৰসা কৰে।","poem":1},{"lineBreak":true},{"text":"সেইবাবেই মই সহায় পাইছোঁ।","poem":1},{"lineBreak":true},{"text":"সেইবাবেই মোৰ অন্তৰ আনন্দত ভৰি পৰিছে;","poem":1},{"lineBreak":true},{"text":"মই মোৰ গীতেৰে তেওঁৰ ধন্যবাদ কৰোঁ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিহোৱা তেওঁৰ লোকসকলৰ বল;","poem":1},{"lineBreak":true},{"text":"তেৱেঁই তেওঁৰ অভিষিক্তজনৰ পৰিত্ৰাণৰ দুৰ্গ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তোমাৰ লোকসকলক তুমি ৰক্ষা কৰা,","poem":1},{"lineBreak":true},{"text":"তোমাৰ সম্পত্তিক তুমি আশীৰ্ব্বাদ কৰা;","poem":1},{"lineBreak":true},{"text":"তুমি তেওঁলোকৰ ৰখীয়া হোৱা","poem":1},{"lineBreak":true},{"text":"আৰু চিৰকাল তেওঁলোকক বৈ নিয়া।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}