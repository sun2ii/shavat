{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["দায়ুদৰ ৰচিত গীত"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰৰ সন্তান সকল, তোমালোকে যিহোৱাৰ গৌৰৱ কীৰ্ত্তন কৰা,","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ গৌৰৱ আৰু পৰাক্ৰম কীৰ্ত্তন কৰা,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ নামৰ গৌৰৱ কীৰ্ত্তন কৰা;","poem":1},{"lineBreak":true},{"text":"পবিত্ৰ সমাৰোহত যিহোৱাৰ আৰাধনা কৰা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"জল সমূহৰ ওপৰত যিহোৱাৰ স্বৰ শুনা যায়;","poem":1},{"lineBreak":true},{"text":"গৌৰৱান্বিত ঈশ্বৰে বজ্ৰধ্বনিৰে গর্জন কৰে,","poem":1},{"lineBreak":true},{"text":"যিহোৱা মহাজল সমূহৰ ওপৰত বিদ্যমান।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰ ক্ষমতাপূর্ণ;","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰ মহিমাৰে পৰিপূৰ্ণ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰে এৰচ গছবোৰ ভাঙে;","poem":1},{"lineBreak":true},{"text":"যিহোৱাই লিবানোনৰ এৰচ গছবোৰ ভাঙি পেলায়।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁ লিবানোনৰ পর্বতমালাক দামুৰিৰ দৰে ডেও দি নচুৱায়;","poem":1},{"lineBreak":true},{"text":"চিৰিয়োনক নচুৱায় যুবা বন্য ষাঁড়ৰ দৰে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰে বিজুলীৰ চমক সৃষ্টি কৰে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰে মৰুপ্রান্তৰ কঁপাই তোলে;","poem":1},{"lineBreak":true},{"text":"কাদেচৰ মৰুপ্রান্তৰ যিহোৱাই কঁপাই তোলে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ স্বৰত হৰিণীবোৰে পোৱালি দিয়ে,","poem":1},{"lineBreak":true},{"text":"ডাল-পাতবোৰ পৰি গৈ বনক নগ্ন কৰে,","poem":1},{"lineBreak":true},{"text":"কিন্তু তেওঁৰ মন্দিৰত সকলোৱে কয়, “গৌৰৱ!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিহোৱা জলপ্লাৱনত সিংহাসনত অধিষ্ঠিত আছিল,","poem":1},{"lineBreak":true},{"text":"যিহোৱা চিৰকাললৈকে ৰজা স্বৰূপে সিংহাসনত অধিষ্ঠিত হৈ আছে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"যিহোৱাই তেওঁৰ লোকসকলক শক্তিদান কৰক!","poem":1},{"lineBreak":true},{"text":"যিহোৱাই তেওঁৰ লোকসকলক শান্তি দি আশীৰ্ব্বাদ কৰক!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}