{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: তাঁৰযুক্ত বাদ্যৰে সৈতে গোৱা দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে মোৰ ধাৰ্মিকতাৰ ঈশ্বৰ, মই যেতিয়া তোমাক মাতো,","poem":1},{"lineBreak":true},{"text":"তেতিয়া তুমি মোক উত্তৰ দিয়া।","poem":1},{"lineBreak":true},{"text":"বিপদে যেতিয়া মোক হেঁচি ধৰিলে,","poem":1},{"lineBreak":true},{"text":"কিন্তু তুমিয়ে মোক বহল ঠাই দিলা;","poem":1},{"lineBreak":true},{"text":"মোক কৃপা কৰা; মোৰ প্ৰাৰ্থনা শুনা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে মনুষ্য, কিমান কালনো তোমালোকে মোৰ সন্মানক অসন্মান কৰিবা?","poem":1},{"lineBreak":true},{"text":"কিমান কালনো তোমালোকে অসাৰকে ভাল পাই থাকি","poem":1},{"lineBreak":true},{"text":"অসত্যৰ পাছে পাছে দৌৰিবা? (চেলা)।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিন্তু তোমালোকে জানি থোৱা, যিহোৱাই নিজৰ ভক্তসকলক","poem":1},{"lineBreak":true},{"text":"তেওঁৰ নিজৰ কাৰণে পৃথক কৰিলে।","poem":1},{"lineBreak":true},{"text":"মই মাতিলে, যিহোৱাই মোৰ প্রার্থনা শুনে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তোমালোকে মনৰ ব্যাকুলতাত পাপ নকৰিবা;","poem":1},{"lineBreak":true},{"text":"নিজৰ শয্যাত শুই তাক দকৈ মনতে চিন্তা কৰি চাবা আৰু নিজম দি থাকিবা। (চেলা)।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তোমালোকে যোগ্য বলি উৎসৰ্গ কৰা, আৰু যিহোৱাত ভাৰসা ৰাখা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"অনেকে কয়, “অহ! আমি যদি অলপমান মঙ্গলকে দেখা পালোহেঁতেন!”","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা, তোমাৰ মুখৰ দীপ্তি আমাৰ ওপৰত প্রতিফলিত হওঁক।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"প্রচুৰ শস্য আৰু নতুন দ্রাক্ষাৰস উভৈনদী হ’লে যেনেকৈ আনন্দ হয়,","poem":1},{"lineBreak":true},{"text":"তাতোকৈয়ো অধিক আনন্দ দি তুমি মোৰ অন্তৰ পূর্ণ কৰি ৰাখিছা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"মই শান্তিৰে শুই টোপনি যাম।","poem":1},{"lineBreak":true},{"text":"কাৰণ, হে যিহোৱা, কেৱল তুমিয়েই মোক নিৰাপত্তা দি নিৰাপদে ৰাখিছা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}