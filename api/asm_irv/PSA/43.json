{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, মোৰ বিচাৰ কৰা;","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰ ভয়হীন জাতিৰ বিৰুদ্ধে মোৰ পক্ষে কথা কোৱা;","poem":1},{"lineBreak":true},{"text":"ছল আৰু অন্যায়কাৰী মানুহৰ পৰা মোক ৰক্ষা কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"কিয়নো তুমিয়েই মোৰ ঈশ্বৰ, মোৰ দুৰ্গ; তুমি মোক কিয় ত্যাগ কৰিলা?","poem":1},{"lineBreak":true},{"text":"মই কিয় শত্ৰুৰ উপদ্ৰৱৰ কাৰণে বিষন্ন মনেৰে ফুৰিছোঁ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমাৰ দীপ্তি আৰু সত্যতাক পঠাই দিয়া; সেইবোৰেই মোৰ পথদৰ্শক হওঁক;","poem":1},{"lineBreak":true},{"text":"সেইবোৰেই মোক তোমাৰ সেই পবিত্ৰ পৰ্ব্বতলৈ","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ আবাসলৈ লৈ যাওঁক।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তাতে মই ঈশ্বৰৰ যজ্ঞ-বেদীৰ ওচৰলৈ যাম,","poem":1},{"lineBreak":true},{"text":"মোৰ পৰম আনন্দৰ ঈশ্বৰৰ ওচৰলৈ যাম;","poem":1},{"lineBreak":true},{"text":"হে ঈশ্বৰ, হে মোৰ ঈশ্বৰ, মই বীণাৰে তোমাৰ ধন্যবাদ কৰিম।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে মোৰ মন, তুমি কিয় নিৰাশ হৈছা?","poem":1},{"lineBreak":true},{"text":"কিয় মোৰ অন্তৰত ব্যাকুল হৈছা?","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰত ভাৰসা কৰা; কাৰণ মই পুনৰায় তেওঁৰ স্তুতি কৰিম।","poem":1},{"lineBreak":true},{"text":"তেৱেঁই মোৰ সহায়, মোৰ ঈশ্বৰ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}