{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: কোৰহৰ বংশৰ ৰচিত গীত। অলামোৎ সুৰত গাবলগীয়া সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"ঈশ্বৰ আমাৰ আশ্ৰয় আৰু বল,","poem":1},{"lineBreak":true},{"text":"সঙ্কটৰ সময়ত বিচাৰা মাত্ৰে পাব পৰা ঈশ্বৰ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"এই বাবেই মই ভয় নকৰিম - যদিও পৃথিবীৰ পৰিবৰ্ত্তন হয়, পৰ্ব্বতবোৰ কঁপি উঠি সাগৰৰ বুকুত পৰে,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যদিও জল সমূহে তৰ্জ্জন-গৰ্জ্জন কৰে আৰু ফেনে-ফুটুকাৰে ভৰি পৰে,","poem":1},{"lineBreak":true},{"text":"যদিও পৰ্ব্বতবোৰে আলোড়ন কৰি কঁপি উঠে। (চেলা)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"এখন নদী আছে; তাৰ সুঁতিবোৰে ঈশ্বৰৰ নগৰক আনন্দময় কৰি তোলে,","poem":1},{"lineBreak":true},{"text":"আনন্দময় কৰি তোলে সৰ্ব্বোপৰি জনা থকা সেই পবিত্ৰ স্থান।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ঈশ্বৰ সেই নগৰৰ মাজত থাকে; সেয়ে তাই বিচলিত নহ’ব।","poem":1},{"lineBreak":true},{"text":"অতি পুৱাতেই ঈশ্বৰে তাইক সহায় কৰিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"জাতিবোৰে হৈ চৈ কৰিছে; আৰু ৰাজ্যবোৰ উচ্ছন্ন হৈছে;","poem":1},{"lineBreak":true},{"text":"তেওঁ গর্জন কৰি উঠিছে আৰু পৃথিৱী দ্রৱীভূত হ’ল।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"বাহিনীসকলৰ সর্বশক্তিমান যিহোৱা আমাৰ সঙ্গত আছে;","poem":1},{"lineBreak":true},{"text":"যাকোবৰ ঈশ্বৰ আমাৰ আশ্রয়স্থান। (চেলা)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"আহাঁ, যিহোৱাৰ কার্য-কলাপ চোৱা,","poem":1},{"lineBreak":true},{"text":"তেওঁ পৃথিবীত ধ্বংস আনিছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তেওঁ পৃথিবীৰ সকলো যুদ্ধ বন্ধ কৰে,","poem":1},{"lineBreak":true},{"text":"তেওঁ ধনু ভাঙে, বৰছা ডোখৰ ডোখৰ কৰে,","poem":1},{"lineBreak":true},{"text":"ৰথবোৰ জুইত পোৰে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিহোৱাই কৈছে, “তোমালোক ক্ষান্ত","poem":1},{"noteId":38},{"text":"হোৱা, মই যে ঈশ্বৰ, ইয়াকে জানা!","poem":1},{"lineBreak":true},{"text":"সকলো জাতিয়ে মোকেই গৌৰৱান্বিত কৰিব,","poem":1},{"lineBreak":true},{"text":"পৃথিৱীয়ে মোকেই গৌৰৱান্বিত কৰিব।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"বাহিনীসকলৰ সর্বশক্তিমান যিহোৱা আমাৰ সঙ্গত আছে;","poem":1},{"lineBreak":true},{"text":"যাকোবৰ ঈশ্বৰ আমাৰ আশ্রয়স্থান। (চেলা)","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"যুদ্ধবোৰ বন্ধ কৰা","reference":{"chapter":46,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}