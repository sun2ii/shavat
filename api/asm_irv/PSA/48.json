{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["এটি সঙ্গীত। কোৰহৰ বংশৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"আমাৰ ঈশ্বৰৰ নগৰত, তেওঁৰ পবিত্ৰ পৰ্ব্বতত,","poem":1},{"lineBreak":true},{"text":"যিহোৱা মহান আৰু অতীব প্রশংসাৰ যোগ্য,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"উত্তৰপ্রান্তত স্থিত সেই চিয়োন পৰ্ব্বত;","poem":1},{"lineBreak":true},{"text":"ওখ টিলাৰ ওপৰত মহান ৰজাৰ সেই নগৰ দেখিবলৈ সুন্দৰ;","poem":1},{"lineBreak":true},{"text":"গোটেই পৃথিবীকে আনন্দ দিয়ে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ঈশ্বৰে সেই চহৰৰ অট্টালিকাবোৰৰ মাজত","poem":1},{"lineBreak":true},{"text":"নিজক দুৰ্গ স্বৰূপে প্রকাশ কৰিছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ৰজাসকলে একগোট হ’ল আৰু একেলগে আগুৱাই গ’ল।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তেওঁলোকে সেই নগৰ দেখি আতংকিত হ’ল;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক বিহ্বল হৈ পলাই গ’ল।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সেই ঠাইত ভয়তে তেওঁলোকৰ কঁপনি উঠিছিল,","poem":1},{"lineBreak":true},{"text":"প্রসৱকাৰিনী মহিলাৰ দৰে যন্ত্রণা হৈছিল।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যেনেকৈ পূব দিশৰ বতাহে তৰ্চীচৰ জাহাজবোৰ ভাঙি পেলায়,","poem":1},{"lineBreak":true},{"text":"তেনেকৈ তেওঁলোকক ভাঙিলে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"বাহিনীসকলৰ যিহোৱাৰ নগৰত, আমাৰ ঈশ্বৰৰ নগৰত;","poem":1},{"lineBreak":true},{"text":"আমি যি শুনিছিলোঁ, তাকে দেখিলোঁ;","poem":1},{"lineBreak":true},{"text":"দেখিলোঁ, ঈশ্বৰে নগৰখন চিৰকালৰ কাৰণে স্থাপন কৰিব। (চেলা)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, তোমাৰ মন্দিৰৰ ভিতৰত, আমি তোমাৰ গভীৰ প্রেমৰ কথা ধ্যান কৰোঁ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, তোমাৰ প্ৰশংসাৰ দৰেই তোমাৰ নাম পৃথিৱীৰ শেষ সীমা পর্যন্ত আছে।","poem":1},{"lineBreak":true},{"text":"তোমাৰ সোঁ হাত ধার্মিকতাৰে পৰিপূর্ণ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তোমাৰ ন্যায় বিচাৰৰ কাৰণে চিয়োন পৰ্ব্বতে আনন্দ কৰক,","poem":1},{"lineBreak":true},{"text":"যিহূদাৰ নগৰবোৰ","poem":1},{"noteId":40},{"text":"উল্লাস কৰা।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তোমালোকে চিয়োনৰ চাৰিওফালে ঘূৰা,","poem":1},{"lineBreak":true},{"text":"আহাঁ, তাৰ কোঁঠবোৰ গণনা কৰা।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"তাৰ প্রাচীৰবোৰ লক্ষ্য কৰা;","poem":1},{"lineBreak":true},{"text":"তাৰ ৰাজ-অট্টালিকাবোৰ ঘূৰি চোৱা","poem":1},{"lineBreak":true},{"text":"যাতে তোমালোকে সেই কথা তোমালোকৰ ভাৱী সন্তান সকলক ক’ব পাৰা।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"এই ঈশ্বৰ, আমাৰ অনন্তকালৰ ঈশ্বৰ; তেওঁ চিৰকাললৈকে আমাৰ পথদৰ্শক হ’ব।","poem":1}]}],"footnotes":[{"noteId":40,"caller":"+","text":"জীয়ৰীসকল উল্লাসিত হোৱা","reference":{"chapter":48,"verse":11}}]},"thisChapterLink":"/api/asm_irv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}