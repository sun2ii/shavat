{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: তাঁৰযুক্ত যন্ত্ৰেৰে গাবলগীয়া মচকীল নামে দায়ুদৰ ৰচিত গীত। জীফীয়াসকলে গৈ যেতিয়া ৰজা চৌলক জনাইছিল যে, “দায়ুদ তেওঁলোকৰ মাজত লুকাই আছে” - এইয়া সেই সময়ৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, তোমাৰ নামৰ দ্বাৰাই মোক উদ্ধাৰ কৰা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ পৰাক্রমেৰে মোৰ দোষ মোচন কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, মোৰ প্ৰাৰ্থনা শুনা,","poem":1},{"lineBreak":true},{"text":"মোৰ মুখৰ কথালৈ কাণ দিয়া।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিয়নো অন্য জাতিৰ লোকসকল মোৰ বিৰুদ্ধে উঠিছে,","poem":1},{"lineBreak":true},{"text":"হৃদয়হীন","poem":1},{"noteId":54},{"text":"লোকে মোৰ প্ৰাণ লবলৈ বিচাৰিছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে নিজৰ সন্মুখত ঈশ্বৰক ঠাই নিদিয়ে। [চেলা]","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিন্তু ঈশ্ৱৰ মোৰ সহায়কৰ্তা;","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰেই মোৰ জীৱন ধৰি ৰাখে","poem":1},{"noteId":55},{"text":"।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তেওঁ মোৰ শত্ৰুবোৰৰ অপৰাধৰ প্ৰতিশোধ ল’ব;","poem":1},{"lineBreak":true},{"text":"তোমাৰ বিশ্ৱস্ততাত তুমি তেওঁলোকক বিনষ্ট কৰা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মই নিজ ইচ্ছাৰে তোমাৰ উদ্দেশ্যে বলি উৎসৰ্গ কৰিম;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা, মই তোমাৰ নামৰ ধন্যবাদ কৰিম; কিয়নো সেয়ে উত্তম।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কাৰণ তেওঁ মোক মোৰ সকলো সঙ্কটৰ পৰা উদ্ধাৰ কৰিলে;","poem":1},{"lineBreak":true},{"text":"মোৰ চকুৱে শত্ৰুবোৰৰ ওপৰত মোক জয়ী হোৱা দেখিলে।","poem":1}]}],"footnotes":[{"noteId":54,"caller":"+","text":"বিদেশী","reference":{"chapter":54,"verse":3}},{"noteId":55,"caller":"+","text":"সেই ঈশ্বৰ, যিসকলক তেওঁ সাবতি ধৰে।","reference":{"chapter":54,"verse":4}}]},"thisChapterLink":"/api/asm_irv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}