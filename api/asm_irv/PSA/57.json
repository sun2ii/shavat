{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে অল-তচহেৎ সুৰত গাবলগীয়া মিকটাম নামে দায়ূদৰ ৰচিত গীত। তেওঁ চৌলৰ সন্মুখৰ পৰা গুহালৈ পলাই যোৱা সময়ৰ গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, মোক কৃপা কৰা, মোক কৃপা কৰা;","poem":1},{"lineBreak":true},{"text":"কিয়নো মোৰ প্ৰাণে তোমাতেই আশ্রয় লৈছে;","poem":1},{"lineBreak":true},{"text":"এনে কি, এই আপদবোৰ শেষ নহয়মানে, মই তোমাৰ ডেউকাৰ ছাঁত আশ্ৰয় লম।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মই সৰ্ব্বোপৰি ঈশ্বৰৰ আগত প্ৰাৰ্থনা কৰিম,","poem":1},{"lineBreak":true},{"text":"মোৰ কাৰ্যসাধক ঈশ্বৰক নিবেদন কৰিম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"মোক গ্ৰাস কৰিব খোজা জনে নিন্দা কৰা সময়ত, তেওঁ স্বৰ্গৰ পৰা পঠাই মোক পৰিত্ৰাণ কৰিব; [চেলা]।","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰে নিজ দয়া আৰু সত্যতা পঠাই দিব।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মোৰ জীৱন শত্রুবোৰৰ মাজত আছে","poem":1},{"noteId":57},{"text":",","poem":1},{"lineBreak":true},{"text":"সেই লোকসকলৰ দাঁত বৰছা আৰু কাঁড় স্বৰূপ,","poem":1},{"lineBreak":true},{"text":"আৰু যিবোৰৰ জিভা চোকা তৰোৱাল স্বৰূপ,","poem":1},{"lineBreak":true},{"text":"এনে অগ্নি-শিখা স্বৰূপ মনুষ্য সন্তানবোৰৰ মাজত মই শুইছোঁ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, স্বৰ্গৰ ওপৰলৈকে তুমি উন্নত হোৱা;","poem":1},{"lineBreak":true},{"text":"গোটেই পৃথিবীৰ ওপৰত তোমাৰ গৌৰৱ হওক।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সিহঁতে মোৰ ভৰিলৈ জাল পাতিলে;","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাণ নত হৈছে।","poem":1},{"lineBreak":true},{"text":"সিহঁতে মোৰ সন্মুখত গাত খানিলে;","poem":1},{"lineBreak":true},{"text":"সিহঁত নিজেই তাৰ ভিতৰত পৰিল। [চেলা]।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, মোৰ মন সুস্থিৰ হ’ল, মোৰ মন সুস্থিৰ হ’ল,","poem":1},{"lineBreak":true},{"text":"মই গীত গাম, এনে কি, প্ৰশংসাৰ গান কৰিম।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে মোৰ হৃদয়, সাৰ পোৱা;","poem":1},{"lineBreak":true},{"text":"হে নেবল আৰু বীণা, সাৰ পোৱা;","poem":1},{"lineBreak":true},{"text":"মই প্ৰভাতক জগাম।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে প্ৰভু, জাতিবিলাকৰ মাজত মই তোমাৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"লোক সকলৰ মাজত মই তোমাৰ প্ৰশংসাৰ গান কৰিম।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কিয়নো তোমাৰ দয়াৰ মহত্ব স্বৰ্গলৈকে,","poem":1},{"lineBreak":true},{"text":"আৰু তোমাৰ সত্যতা আকাশলৈকে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, স্বৰ্গৰ ওপৰলৈকে তুমি উন্নত হোৱা;","poem":1},{"lineBreak":true},{"text":"গোটেই পৃথিবীৰ ওপৰত তোমাৰ গৌৰৱ হওক।","poem":1}]}],"footnotes":[{"noteId":57,"caller":"+","text":"মোৰ প্ৰাণ সিংহবোৰৰ মাজত আছে;","reference":{"chapter":57,"verse":4}}]},"thisChapterLink":"/api/asm_irv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}