{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: চমীনীৎ সুৰত তাঁৰযুক্ত যন্ত্ৰেৰে গোৱা দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে যিহোৱা, তুমি খঙত মোক ধমকি নিদিবা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ ক্রোধত মোক শাসন নকৰিবা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মোক কৃপা কৰা,","poem":1},{"lineBreak":true},{"text":"কিয়নো মই দুর্বল;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা মোক সুস্থ কৰা,","poem":1},{"lineBreak":true},{"text":"কিয়নো মোৰ হাড়বোৰ ভয়তে কঁপিছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"মোৰ প্ৰাণো ভয়তে ব্যাকুল হৈছে;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা, এইদৰে কিমান কাললৈ হৈ থাকিব?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, মোলৈ ঘূৰি চোৱা,","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাণ ৰক্ষা কৰা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ অসীম প্রেমেৰে মোক উদ্ধাৰ কৰা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"মৃত্যু হ’লে তোমাক সোঁৱৰণ কৰা নহয়;","poem":1},{"lineBreak":true},{"text":"চিয়োলত","poem":1},{"noteId":7},{"text":"কোনে তোমাৰ প্ৰশংসা কৰিব?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মই কেঁকাই কেঁকাই ক্লান্ত হৈ পৰিছো;","poem":1},{"lineBreak":true},{"text":"গোটেই নিশা কান্দি-কান্দি মই মোৰ শয্যা চকুৰ পানীৰে তিয়াও;","poem":1},{"lineBreak":true},{"text":"মোৰ বিচনা তিতি যায়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"দুখতে মোৰ চকুৰ দৃষ্টি কমি গৈছে;","poem":1},{"lineBreak":true},{"text":"শত্রুবোৰৰ কাৰণে মোৰ চকু দুৰ্বল হৈছে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে দুষ্ট কার্য কৰা লোকবিলাক,","poem":1},{"lineBreak":true},{"text":"তোমালোক সকলোৱেই মোৰ ওচৰৰ পৰা দূৰ হৈ যোৱা;","poem":1},{"lineBreak":true},{"text":"কিয়নো যিহোৱাই মোৰ ক্ৰন্দন শুনিছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাই মোৰ নিবেদন শুনিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁ মোৰ প্ৰাৰ্থনা গ্ৰহণ কৰিছে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"মোৰ সকলো শত্রুবোৰ লজ্জিত হ’ব আৰু ভয়তে ব্যাকুল হ’ব;","poem":1},{"lineBreak":true},{"text":"সিহঁত ঘূৰি যাব আৰু হঠাৎ লাজত পৰিব।","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"চিয়োলত মৈদাম","reference":{"chapter":6,"verse":5}}]},"thisChapterLink":"/api/asm_irv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}