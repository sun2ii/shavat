{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: তাৰযুক্ত যন্ত্ৰেৰে গাবলগীয়া দায়ূদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, মোৰ ক্রন্দন শুনা;","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাৰ্থনালৈ কাণ দিয়া।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মোৰ মন দুখত যেতিয়া ভাঙি পৰে,","poem":1},{"lineBreak":true},{"text":"মই পৃথিবীৰ অন্তত থাকিলেও তাৰ পৰা তোমাক মাতিম;","poem":1},{"lineBreak":true},{"text":"তুমি মোক মোতকৈ ওখ শিলটোলৈ লৈ যোৱা য’ত মোৰ নিৰাপত্তা আছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিয়নো তুমি মোৰ আশ্ৰয়,","poem":1},{"lineBreak":true},{"text":"শত্ৰুৰ পৰা ৰক্ষা কৰোঁতা দৃঢ় দুৰ্গ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মই যেন চিৰকাললৈকে তোমাৰ তম্বুত বাস কৰিবলৈ পাম;","poem":1},{"lineBreak":true},{"text":"তোমাৰ ডেউকাৰ আঁৰত মই যেন আশ্রয় পাম। [চেলা]","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো হে ঈশ্বৰ, তুমিয়েই মোৰ সঙ্কল্পবোৰ শুনিলা।","poem":1},{"lineBreak":true},{"text":"তোমাৰ নাম শ্রদ্ধা কৰাসকলৰ আধিপত্য তুমি মোক দিলা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তুমি ৰজাৰ আয়ুস দীর্ঘাযু় কৰিবা;","poem":1},{"lineBreak":true},{"text":"তেওঁ বয়স বহু পুৰুষলৈকে থাকিব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তেওঁ ঈশ্বৰৰ সাক্ষাতে চিৰকাল বাস কৰিব;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ ৰক্ষাৰ অৰ্থে দয়া আৰু সত্যতা ব্যৱহাৰ কৰা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তাতে, মই চিৰকাললৈকে তোমাৰ প্ৰশংসাৰ গান কৰিম;","poem":1},{"lineBreak":true},{"text":"প্রতিদিনে নিজৰ সঙ্কল্প সিদ্ধ কৰিম।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}