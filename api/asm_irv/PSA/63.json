{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["যিহূদাৰ অৰণ্যত থকা সময়ত দায়ূদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, তুমি মোৰ ঈশ্বৰ;","poem":1},{"lineBreak":true},{"text":"আন্তৰিকতাৰে মই তোমাক বিচাৰিম;","poem":1},{"lineBreak":true},{"text":"পানী নথকা শুকান আৰু খৰাং দেশত, তোমালৈ হাবিয়াহ কৰোঁতে,","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাণ তৃষ্ণাতুৰ হৈছে, মোৰ শৰীৰ ক্ষীণাই গৈছে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"এই দৰে মই তোমাৰ আশ্রয় স্থল, পৰাক্ৰম আৰু গৌৰৱ দেখিবলৈ,","poem":1},{"lineBreak":true},{"text":"পবিত্ৰ স্থানত তোমাক চাইছিলোঁ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিয়নো তোমাৰ প্ৰতিজ্ঞা আৰু বিশ্বস্ততা জীৱনতকৈয়ো উত্তম;","poem":1},{"lineBreak":true},{"text":"মোৰ ওঁঠে তোমাৰ স্তুতি প্রশংসা কৰিব।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"এইদৰে মই জীয়াই থাকোমানে তোমাৰ ধন্যবাদ কৰিম,","poem":1},{"lineBreak":true},{"text":"তোমাৰ নামত মই মোৰ হাত প্রার্থনাৰ সময়ত ওপৰলৈ তুলি ধৰিম।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"লোকসকলে মগজু আৰু তেলীয়া মাংসত যেনেকৈ সন্তুষ্ট, তেনেকৈ মোৰ প্ৰাণ তৃপ্ত হ’ব;","poem":1},{"lineBreak":true},{"text":"আৰু মোৰ মুখে আনন্দিত মনেৰে তোমাৰ প্ৰশংসা কৰিব।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মই মোৰ শয্যাত শুই তোমাৰ কথা ভাৱো;","poem":1},{"lineBreak":true},{"text":"নিশা প্ৰহৰে প্ৰহৰে তোমাক ধ্যান কৰোঁ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কিয়নো তুমি মোৰ সহায়কর্তা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ ডেউকাৰ ছাঁত মই আনন্দ কৰিম।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"মোৰ প্ৰাণে তোমাক ধৰি ৰাখিছে;","poem":1},{"lineBreak":true},{"text":"তোমাৰ সোঁ হাতে মোক ধৰি ৰাখিছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিবোৰে বিনাশৰ অৰ্থে মোৰ প্ৰাণ বিচাৰিছে,","poem":1},{"lineBreak":true},{"text":"তেওঁলোক পৃথিবীৰ অধঃস্থানলৈ গতি কৰিব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তেওঁলোক তৰোৱালৰ ধাৰত সমৰ্পিত হ’ব;","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকৰ অংশ শিয়ালৰ আহাৰ হ’ব।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কিন্তু ৰজাই ঈশ্বৰত আনন্দ কৰিব;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ নামেৰে শপত কৰা প্ৰতিজনে গৌৰৱ কৰিব,","poem":1},{"lineBreak":true},{"text":"কিয়নো মিছলীয়াবোৰৰ মুখ বন্ধ হ’ব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}