{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: দায়ূদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, মোৰ অভিযোগবোৰৰ কথা কওঁতে মোৰ মাত শুনা;","poem":1},{"lineBreak":true},{"text":"শত্রুৰ ভয়ৰ পৰা মোৰ জীৱন ৰক্ষা কৰা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"দুষ্টবোৰৰ ষড়যন্ত্ৰৰ পৰা মোক লুকুৱাই ৰাখা;","poem":1},{"lineBreak":true},{"text":"দুৰাচাৰীবিলাকৰ মানসিক উত্তেজনাৰ অপৰাধবোৰৰ পৰা মোক গুপুতে ৰাখা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তেওঁলোকে তৰোৱাল ধৰোঁৱাদি নিজৰ জিভা ধৰাইছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তিক্ততাপূর্ণ কথাৰ ধনুকাঁড় জুৰিছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"নির্দোষী জনক গুপুতে মাৰিবলৈ নিজৰ কাঁড় জুৰিছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে তালৈ অকস্মাতে বাণ মাৰে, ভয় নকৰে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সিহঁতে কুমন্ত্ৰণাত নিজক উৎসাহ দিয়ে;","poem":1},{"lineBreak":true},{"text":"গুপুতে ফান্দ পতাৰ বিষয়ে কথা পাতে;","poem":1},{"lineBreak":true},{"text":"সিহঁতে কয়, “এই আমাক","poem":1},{"noteId":65},{"text":"কোনে দেখিব?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তেওঁলোকে কু-পৰিকল্পনাৰ বিষয়ে আলোচনা কৰে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে কয়, “আমি ভালকৈ ভাবি-চিন্তি কল্পনা কৰি থৈছোঁ।”","poem":1},{"lineBreak":true},{"text":"প্ৰত্যেকৰ আন্তৰিক ভাব আৰু হৃদয় গভীৰ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কিন্তু ঈশ্বৰে তেওঁলোকক আহত কৰিব;","poem":1},{"lineBreak":true},{"text":"অকস্মাতে কাঁড়ৰ দ্বাৰাই আঘাত কৰিব।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তেওঁলোকে অন্যায় কাম কৰাৰ কাৰণে, তেওঁলোকৰ জিভা তেওঁলোকৰ বিৰোধী হ’ল।","poem":1},{"lineBreak":true},{"text":"যি সকলে তেওঁলোকক অস্থিৰ হোৱা দেখিব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক সকলোৱে তাকে দেখি মূৰ জোকাৰিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তেওঁলোক সকলোৱে ভয়াৰ্ত হ’ব;","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰে যি কার্য কৰিলে, সেই বিষয়ে চিন্তা কৰিব,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে ঈশ্বৰৰ কাৰ্যৰ বিষয়ে ঘোষণা কৰিব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ধাৰ্মিক লোকে যিহোৱাত আনন্দিত হৈ তেওঁত আশ্ৰয় ল’ব;","poem":1},{"lineBreak":true},{"text":"ঈশ্বৰ ভক্ত সকলোৱে তেওঁৰ ন্যায়পৰায়ণতা দেখি অন্তৰৰে গৌৰৱ কৰিব।","poem":1}]}],"footnotes":[{"noteId":65,"caller":"+","text":"বস্তুবোৰ","reference":{"chapter":64,"verse":5}}]},"thisChapterLink":"/api/asm_irv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}