{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: অলতচেৎ সুৰত গাবলগীয়া আচফৰ ৰচিত গীত, সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বৰ, আমি তোমাৰ ধন্যবাদ কৰিম;","poem":1},{"lineBreak":true},{"text":"আমি তোমাৰ ধন্যবাদ কৰিম, কিয়নো তুমি তোমাৰ উপস্থিতি প্রকাশ কৰিলা;","poem":1},{"lineBreak":true},{"text":"লোকসকলে তোমাৰ আচৰিত কাৰ্যবোৰ বৰ্ণনা কৰি আছে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যেতিয়া নিৰুপিত সময় উপস্থিত হব;","poem":1},{"lineBreak":true},{"text":"তেতিয়া মই ন্যায়েৰে বিচাৰ কৰিম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যদিও পৃথিৱী আৰু তাৰ বাসিন্দাসকল ভয়াতুৰ আৰু দুর্বল;","poem":1},{"lineBreak":true},{"text":"তথাপি ময়েই তাৰ স্তম্ভবোৰ দৃঢ়কৈ স্থাপন কৰিলোঁ। [চেলা]","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মই অহঙ্কাৰীবোৰক কলোঁ, “তোমালোকে অহঙ্কাৰেৰে কাৰ্য নকৰিবা;”","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰক ক’লো, “পৰিত্রাণ পাবলৈ নি:সংশয় নহবা;","poem":1},{"lineBreak":true},{"text":"দুষ্টবোৰ জয়ী হ’বলৈ অত্যন্ত নিশ্চিন্ত নহওক।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তোমালোক জয়ী হ’বলৈ অত্যন্ত নিশ্চিন্ত নহবা;","poem":1},{"lineBreak":true},{"text":"তোমালোকে গর্ব কৰি কথা নকবা।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কিয়নো পূব বা পশ্চিম দিশৰ পৰা জয় লাভ নহয়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কিন্তু ঈশ্বৰ ন্যায় বিচাৰক;","poem":1},{"lineBreak":true},{"text":"কোনোক তললৈ নমায়, কোনোক ওপৰলৈ তোলে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"কিয়নো যিহোৱাৰ হাতত এক পান-পাত্ৰ আছে,","poem":1},{"lineBreak":true},{"text":"তাত মিশ্ৰিত দ্ৰব্যেৰে সৈতে পৰিপূৰ্ণ ফেনাই উঠা দ্রাক্ষাৰস আছে;","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁ সেই পাত্রৰ কিছু ঢালি দিয়ে;","poem":1},{"lineBreak":true},{"text":"পৃথিৱীৰ দুষ্ট লোকবোৰে অৱশ্যেই তাৰ তলিলৈকে থকা গেদবোৰ খাব লাগিব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"কিন্তু মই হ’লে, চিৰকাললৈ তেওঁ কৰা কার্যৰ প্ৰচাৰ কৰিম;","poem":1},{"lineBreak":true},{"text":"মই যাকোবৰ ঈশ্বৰৰ উদ্দেশ্যে স্তুতি গান কৰিম।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তেওঁ ক’লে, “মই দুষ্ট লোকবোৰৰ আটাই শিং","poem":1},{"noteId":79},{"text":"কাটি পেলাম;","poem":1},{"lineBreak":true},{"text":"কিন্তু ধাৰ্মিক লোকসকলৰ শিং","poem":1},{"noteId":80},{"text":"উচ্চ কৰিম।”","poem":1}]}],"footnotes":[{"noteId":79,"caller":"+","text":"শক্তি","reference":{"chapter":75,"verse":10}},{"noteId":80,"caller":"+","text":"শক্তি","reference":{"chapter":75,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}