{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: তাৰযুক্ত যন্ত্ৰেৰে গাবলগীয়া, আচফৰ ৰচিত গীত,সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"যিহূদাৰ সকলোৱেই ঈশ্বৰক জানে;","poem":1},{"lineBreak":true},{"text":"ইস্ৰায়েলৰ মাজত তেওঁৰ নাম মহান।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"চালেম","poem":1},{"noteId":81},{"text":"ত তেওঁৰ তম্বু আছে;","poem":1},{"lineBreak":true},{"text":"চিয়োনত তেওঁৰ বসতি স্থান আছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তাত তেওঁ ধনুৰ কাঁড় ভাঙিলে;","poem":1},{"lineBreak":true},{"text":"ঢাল তৰোৱাল আদি যুদ্ধৰ সঁজুলি ভাঙিলে। [চেলা]","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তোমাৰ প্রতিফলিত উজ্জ্বল আৰু বিকশিত গৌৰৱ;","poem":1},{"lineBreak":true},{"text":"যি দৰে এই পৰ্ব্বতবোৰৰ পৰা নামি অহাৰ উদ্দেশ্যে, য’ত তুমি তোমাৰ চিকাৰ আহত কৰিছিলা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"এই দুঃসাহসী লোকসকলক অপহৰণ কৰা হ’ল;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক ভীষণ নিদ্ৰামগ্ন হ’ল।","poem":1},{"lineBreak":true},{"text":"পৰাক্ৰমীসকল অসহায় হ’ল।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"হে যাকোবৰ ঈশ্বৰ; যুদ্ধ ক্ষেত্রৰ কান্দোনত,","poem":1},{"lineBreak":true},{"text":"ৰথ চালক আৰু ঘোঁৰা উভয়ে টোপনি গ’ল।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তুমি, হয় তুমিয়েই আতঙ্কজনক;","poem":1},{"lineBreak":true},{"text":"তোমাৰ ক্ৰোধ উঠিলে কোনে তোমাৰ আগত থিয় হ’ব পাৰে?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমাৰ ন্যায় বিচাৰ স্বৰ্গৰ পৰা হয়;","poem":1},{"lineBreak":true},{"text":"পৃথিৱী আতঙ্কিত হৈ নীৰৱে আছিল।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰ, তুমি উঠা, বিচাৰ নিস্পতি কৰা;","poem":1},{"lineBreak":true},{"text":"পৃথিৱীৰ নির্যাতিত সকলক ৰক্ষা কৰিবলৈ উঠা। [চেলা]","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"অৱশ্যে তোমাৰ ক্ৰোধ বিচাৰেই সেই লোকসকলৰ প্ৰশংসাৰ কাৰণ হ’ব;","poem":1},{"lineBreak":true},{"text":"তুমি সম্পূৰ্ণকৈ উপহাস কৰি ক্রোধ সোঁৱৰণ কৰিবা","poem":1},{"noteId":82},{"text":"।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তোমালোকে নিজৰ ঈশ্বৰ যিহোৱালৈ সঙ্কল্প কৰা, আৰু তাক সিদ্ধও কৰা;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ চাৰিওফালে থকা সকলোৱে সেই আতঙ্কিত জনাৰ উদ্দেশ্যে উপহাৰ আনিব।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তেওঁ ৰাজকোঁৱৰ সকলৰ সাহস খর্ব কৰিব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে পৃথিবীৰ ৰজালৈ আতঙ্কিত হ’ব।","poem":1}]}],"footnotes":[{"noteId":81,"caller":"+","text":"যিৰুচালেম","reference":{"chapter":76,"verse":2}},{"noteId":82,"caller":"+","text":"অৱশিষ্ট লোকৰ যুদ্ধক সোঁৱৰণ কৰিব।","reference":{"chapter":76,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/77.json",