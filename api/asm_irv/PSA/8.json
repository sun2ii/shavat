{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["প্ৰধান বাদ্যকৰৰ নিমিত্তে: গিত্তীৎ সুৰত গোৱা দায়ুদৰ ৰচিত গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে আমাৰ প্ৰভু যিহোৱা, গোটেই পৃথিবীতে তোমাৰ নাম কেনে মহৎ!","poem":1},{"lineBreak":true},{"text":"তুমি তোমাৰ গৌৰৱ আকাশমণ্ডলৰ ওপৰত স্থাপন কৰিলা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"শিশু আৰু পিয়াহ খোৱা কেঁচুৱাৰ মুখৰ প্রশংসাৰে","poem":1},{"lineBreak":true},{"text":"তোমাৰ শত্রুবোৰৰ কাৰণে","poem":1},{"lineBreak":true},{"text":"তুমি এক কোঁঠ স্থাপন কৰিলা,","poem":1},{"lineBreak":true},{"text":"যাতে তোমাৰ শত্রু আৰু প্রতিশোধ লোৱাসকলক তুমি স্তব্ধ কৰিব পাৰা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যেতিয়া মই তোমাৰ হাতেৰে সৃষ্টি কৰা আকাশৰ ফালে চাওঁ আৰু","poem":1},{"lineBreak":true},{"text":"তাত তুমি স্থাপন কৰা চন্দ্ৰ আৰু তৰাবোৰলৈ চাওঁ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেতিয়া মই ভাৱো, মানুহনো কি যে, তুমি তেওঁলোকৰ বিষয়ে চিন্তা কৰা?","poem":1},{"lineBreak":true},{"text":"মানুহৰ সন্তানেই বা কি, তুমি যে তেওঁলোকৰ বুজ-বিচাৰ লোৱা?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো তুমি তেওঁলোকক তোমাতকৈ","poem":1},{"noteId":8},{"text":"অলপহে সৰু কৰি স্রজন কৰিলা","poem":1},{"noteId":9},{"text":",","poem":1},{"lineBreak":true},{"text":"গৌৰৱ আৰু মৰ্য্যদাৰূপ মুকুটেৰে তেওঁলোকক বিভুষিত কৰিলা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তোমাৰ হাতেৰে সৃষ্টি কৰা সকলো বস্তুৰ ওপৰত তুমি মানুহক গৰাকী পাতিলা;","poem":1},{"lineBreak":true},{"text":"সকলোকে তুমি মানুহৰ ভৰিৰ তলত ৰাখিলা","poem":1},{"noteId":10},{"text":"; সেইবোৰ -","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মেৰ-ছাগ, ষাঁড় আদিকে ধৰি পথাৰৰ সকলো পশুৰ জাক,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"আকাশত উৰি ফুৰা পক্ষীবোৰ, সমুদ্ৰৰ মাছবোৰ","poem":1},{"lineBreak":true},{"text":"আৰু সাগৰৰ সোঁতত ঘূৰি ফুৰা অন্যান্য সকলো প্রাণী।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, আমাৰ প্ৰভু,","poem":1},{"lineBreak":true},{"text":"গোটেই পৃথিবীতে তোমাৰ নাম কেনে মহৎ!","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"স্বর্গদূতসকলতকৈ","reference":{"chapter":8,"verse":5}},{"noteId":9,"caller":"+","text":"ইব্রী 2:7","reference":{"chapter":8,"verse":5}},{"noteId":10,"caller":"+","text":"ইব্রী 2:9","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/asm_irv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}