{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["কোৰহৰ বংশৰ ৰচিত গীত। এটি সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"যিহোৱাই পবিত্ৰ পৰ্ব্বত শ্রেনীৰ ওপৰত তেওঁৰ নগৰ স্থাপন কৰিলে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যাকোবৰ বংশৰ সকলো নিবাসতকৈ যিহোৱাই চিয়োনৰ দুৱাৰবোৰ ভাল পায়।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে ঈশ্বৰৰ নগৰ, তোমাৰ বিষয়ে অনেক গৌৰৱৰ কথা কোৱা হৈছে। (চেলা)।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“মই মোৰ চিনাকিবোৰৰ মাজত ৰাহব আৰু বাবিলৰো চর্চা কৰিম;","poem":1},{"lineBreak":true},{"text":"পলেষ্টিয়া, তূৰ আৰু ইথিওপিয়াৰ","poem":1},{"noteId":91},{"text":"কথাও চর্চা কৰিম,","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে কয়, ‘এইসকল প্রত্যেকৰে জন্ম তাত হৈছে’।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"এনে কি, চিয়োনৰ বিষয়েও এই বুলি কোৱা হ’ব, “অমুক বা তমুক মানুহৰ তাত জন্ম হৈছিল;","poem":1},{"lineBreak":true},{"text":"সৰ্ব্বোপৰি জনাই নিজেই চিয়োনক স্থাপন কৰিব।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"যিহোৱাই জাতি সমূহৰ নাম লিখি তালিকা কৰাৰ সময়ত এই কথা ক’ব, “এইজনৰ চিয়োনত জন্ম হৈছিল।” (চেলা)।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"গায়ক আৰু নাচনীবোৰে একেভাৱে ক’ব, “মোৰ সকলো ভুমুক তোমাৰ মাজতেই আছে।”","poem":1}]}],"footnotes":[{"noteId":91,"caller":"+","text":"ইথিওপিয়াৰ কুচক","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/asm_irv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}