{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["গীতমালা‍ চতুর্থ খণ্ড"]},{"type":"heading","content":["ঈশ্বৰৰ লোক মোচিৰ প্ৰাৰ্থনা।"]},{"type":"verse","number":1,"content":[{"text":"হে প্ৰভু, পুৰুষে পুৰুষে তুমিয়েই আমাৰ বাসস্থান হৈ আহিছা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"পৰ্ব্বতবোৰ উৎপন্ন হোৱাৰ আগেয়ে,","poem":1},{"lineBreak":true},{"text":"পৃথিৱী আৰু জগত সৃষ্টিৰ আগতে,","poem":1},{"lineBreak":true},{"text":"অনাদি কালৰ পৰা অনন্ত কাল পর্যন্ত তুমিয়েই ঈশ্বৰ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তুমি মানুহক ধূলিলৈ উভটাই লৈ যোৱা;","poem":1},{"lineBreak":true},{"text":"তুমি কোৱা, “হে মনুষ্য সন্তান সকল উভটি যোৱা”।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তোমাৰ দৃষ্টিত হাজাৰ বছৰ যেন পাৰ হোৱা যোৱাকালিৰ নিচিনা;","poem":1},{"lineBreak":true},{"text":"যেন ৰাতিৰ এক প্ৰহৰ মাত্র।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তুমি মানুহক ধলৰ দৰে উটুৱাই লৈ যোৱা,","poem":1},{"lineBreak":true},{"text":"তেওঁলোক এটা সপোনৰ নিচিনা;","poem":1},{"lineBreak":true},{"text":"যেন ৰাতিপুৱা নতুনকৈ ঠন ধৰি উঠা ঘাঁহৰ দৰে;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ৰাতি পুৱালেই সেয়ে গজি বাঢ়িবলৈ ধৰে;","poem":1},{"lineBreak":true},{"text":"গধূলি বেলা সেয়ে শুকাই শেষ হৈ যায়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তোমাৰ ক্ৰোধে আমাক গ্রাস কৰে,","poem":1},{"lineBreak":true},{"text":"তোমাৰ কোপত আমি ব্যাকুল হওঁ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তুমি আমাৰ অপৰাধবোৰ তোমাৰ সন্মুখত থৈছা;","poem":1},{"lineBreak":true},{"text":"তোমাৰ উপস্থিতিৰ পোহৰত আমাৰ গুপুত পাপবোৰ প্রকাশ পায়।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তোমাৰ ভীষণ ক্ৰোধত আমাৰ দিনবোৰ হ্ৰাস হৈ যায়;","poem":1},{"lineBreak":true},{"text":"নিশ্বাসৰ দৰেই আমাৰ আয়ুসৰ বছৰবোৰ শেষ হৈ যায়।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"আমাৰ আয়ুস মাত্র সত্তৰ বছৰ,","poem":1},{"lineBreak":true},{"text":"হয়তো শক্তি থাকিলে, আশী বছৰো হ’ব পাৰে;","poem":1},{"lineBreak":true},{"text":"তথাপিতো আমি শক্তি","poem":1},{"noteId":98},{"text":"থকা বছৰবোৰত মাথোন দুখ আৰু ক্লেশ থাকে;","poem":1},{"lineBreak":true},{"text":"বছৰবোৰ বেগাই ঢুকাই যায় আৰু আমিও পলকতে উড়ি","poem":1},{"noteId":99},{"text":"যাওঁ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তোমাৰ ক্ৰোধৰ পৰাক্ৰম কোনে জানে?","poem":1},{"lineBreak":true},{"text":"তোমাৰ ক্রোধ, তোমাৰ প্রাপ্য ভয়-ভক্তিৰ দৰেই মহান?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"সেয়ে আমাৰ আয়ুসৰ কাল গণনা কৰিবলৈ তুমি আমাক শিকোৱা;","poem":1},{"lineBreak":true},{"text":"যাতে আমি প্রজ্ঞাৰ চিত্ত লাভ কৰিব পাৰোঁ।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, আৰু কিমান কাল?","poem":1},{"lineBreak":true},{"text":"তুমি ঘূৰি আহাঁ! তোমাৰ দাসবোৰৰ প্রতি সদয় হোৱা।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"পুৱাতে তোমাৰ গভীৰ প্রেমেৰে আমাক তৃপ্ত কৰা,","poem":1},{"lineBreak":true},{"text":"যেন আয়ুস থাকেমানে গোটেই জীৱনত আমি আনন্দ আৰু উল্লাস কৰিব পাৰোঁ।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যিমান দিন ধৰি তুমি আমাক দুখ দিলা আৰু,","poem":1},{"lineBreak":true},{"text":"যিমান বছৰ আমি কষ্ট দেখিলোঁ, সেই অনুসাৰেই তুমি আমাক আনন্দিত কৰা।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"তোমাৰ দাসবোৰৰ আগত তোমাৰ কৰ্ম,","poem":1},{"lineBreak":true},{"text":"আৰু তেওঁলোকৰ সন্তান সকলৰ ওপৰত তোমাৰ গৌৰৱ প্ৰকাশিত হওক।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"আমাৰ ঈশ্বৰ যিহোৱাৰ দয়া আমাৰ ওপৰত থাকক;","poem":1},{"lineBreak":true},{"text":"তুমি আমাৰ হাতৰ সকলো কার্য সফল কৰা;","poem":1},{"lineBreak":true},{"text":"হয়, আমাৰ হাতৰ সকলো কামত তুমি সফলতা দান কৰা।","poem":1}]}],"footnotes":[{"noteId":98,"caller":"+","text":"গর্ব কৰিব পৰা বছৰবোৰত","reference":{"chapter":90,"verse":10}},{"noteId":99,"caller":"+","text":"নাইকিয়া হৈ যাওঁ","reference":{"chapter":90,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}