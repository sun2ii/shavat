{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["এটি গীত। বিশ্ৰামবাৰৰ অৰ্থে সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"যিহোৱাৰ উদ্দেশ্যে ধন্যবাদ কৰা উত্তম;","poem":1},{"lineBreak":true},{"text":"হে সৰ্ব্বোপৰি জনা, তোমাৰ নামৰ উদ্দেশ্যে স্তুতি গান কৰা উত্তম;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ৰাতিপুৱা তোমাৰ অসীম প্রেমৰ কথা","poem":1},{"lineBreak":true},{"text":"আৰু প্ৰতি ৰাতি তোমাৰ বিশ্বস্ততা প্রচাৰ কৰা উত্তম;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"দহ গুণীয়া যন্ত্ৰ আৰু নেবল যন্ত্ৰ সহকাৰে,","poem":1},{"lineBreak":true},{"text":"গভীৰ বীণাৰ স্বৰেৰে তোমাৰ ধন্যবাদ-স্তুতি কৰা উত্তম।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিয়নো হে যিহোৱা, তুমি তোমাৰ কার্যৰ দ্বাৰাই মোক আনন্দিত কৰিছা;","poem":1},{"lineBreak":true},{"text":"মই তোমাৰ হাতে কৰা কাৰ্য দেখি আনন্দেৰে গীত গান কৰোঁ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তোমাৰ কাৰ্যবোৰ কেনে মহৎ!","poem":1},{"lineBreak":true},{"text":"তোমাৰ চিন্তাবোৰ কেনে গভীৰ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"নির্বোধ লোকে নাজানে,","poem":1},{"lineBreak":true},{"text":"বিবেকহীন লোকে এই সকলোবোৰ বুজি নাপায়;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"দুষ্টবোৰ যদিও ঘাহঁৰ নিচিনাকৈ বাঢ়ি উঠে,","poem":1},{"lineBreak":true},{"text":"অন্যায়কাৰীবোৰে যদিও উন্নতি লাভ কৰে,","poem":1},{"lineBreak":true},{"text":"তথাপিতো তেওঁলোক চিৰকাললৈকে বিনষ্ট হ’ব।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"কিন্তু হে যিহোৱা, তুমি অনন্তকাল উর্দ্ধবাসী।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"কিয়নো, হে যিহোৱা, তোমাৰ শত্ৰুবোৰ,","poem":1},{"lineBreak":true},{"text":"তোমাৰ শত্রুবোৰ ধ্বংস হ’ব;","poem":1},{"lineBreak":true},{"text":"তোমাৰ অন্যায়কাৰী সকলোবোৰ ছিন্ন-ভিন্ন হ’ব।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কিন্তু বনৰীয়া ষাঁড়ৰ শিঙৰ দৰে তুমি মোৰ শক্তিক","poem":1},{"noteId":101},{"text":"তুলি ধৰিলা;","poem":1},{"lineBreak":true},{"text":"তুমি মোৰ ওপৰত নতুন অভিষিক্ত তেল","poem":1},{"noteId":102},{"text":"ঢালি দিলা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"মোৰ শত্ৰুবোৰৰ পতন মই নিজ চকুৰে দেখিলোঁ;","poem":1},{"lineBreak":true},{"text":"মোৰ বিৰুদ্ধে উঠা সেই দুষ্টবোৰৰ সর্বনাশ মই নিজ কাণেৰে শুনিবলৈ পালোঁ।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ধাৰ্মিকলোক খাজুৰ গছৰ দৰে উজ্বলি উঠিব;","poem":1},{"lineBreak":true},{"text":"লিবানোনৰ এৰচ গছৰ নিচিনাকৈ বাঢ়ি যাব।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"তেওঁলোকক যিহোৱাৰ গৃহত ৰোপন কৰা হ’ল;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক আমাৰ ঈশ্বৰৰ চোতাল কেইখনত প্ৰফুল্লিত হ’ব।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তেওঁলোকে বৃদ্ধ বয়সতো ফল উৎপন্ন কৰিব;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক ৰসাল আৰু সেউজীয়া হৈ থাকিব;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তাতে প্রচাৰিত হ’ব যে যিহোৱা ন্যায়বান;","poem":1},{"lineBreak":true},{"text":"তেৱেঁই মোৰ শিলা,","poem":1},{"lineBreak":true},{"text":"তেওঁত কোনো অধার্মিকতা নাই।","poem":1}]}],"footnotes":[{"noteId":101,"caller":"+","text":"শিং","reference":{"chapter":92,"verse":10}},{"noteId":102,"caller":"+","text":"আশীর্বাদেৰে আনন্দিত কৰিলা","reference":{"chapter":92,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}