{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"যিহোৱাই ৰাজত্ব কৰে, তেওঁ মহিমাৰে সজ্জিত;","poem":1},{"lineBreak":true},{"text":"যিহোৱা সুসজ্জিত; তেওঁ পৰাক্ৰমেৰে নিজৰ কঁকাল বান্ধিলে;","poem":1},{"lineBreak":true},{"text":"জগতখনো তেওঁ লৰচৰ হ’ব নোৱাৰাকৈ স্থাপন কৰিলে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তোমাৰ সিংহাসন পূৰ্বৰে পৰা স্থাপন কৰা হ’ল;","poem":1},{"lineBreak":true},{"text":"তুমি অনাদি কালৰে পৰা বিদ্যমান।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, নদীৰ পানী ওফন্দি উঠিছে,","poem":1},{"lineBreak":true},{"text":"নদীবোৰ নিজ নিজ তৰঙ্গ ধ্বনিৰে ওফন্দি উঠিছে;","poem":1},{"lineBreak":true},{"text":"নদীবোৰে নিজ নিজ গর্জনৰ ঢৌ তুলিছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"মহা জল সমূহৰ কল্লোল ধ্বনিতকৈয়ো,","poem":1},{"lineBreak":true},{"text":"সমুদ্ৰৰ প্ৰচণ্ড তৰঙ্গবোৰতকৈয়ো সৰ্ব্বোপৰি যিহোৱা বলৱান।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তোমাৰ আজ্ঞাবোৰ অতি বিশ্বাসযোগ্য;","poem":1},{"lineBreak":true},{"text":"হে যিহোৱা চিৰদিনৰ কাৰণে পবিত্ৰতা তোমাৰ গৃহৰ শোভা।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}