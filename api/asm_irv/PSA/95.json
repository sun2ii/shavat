{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"আহাঁ, আমি যিহোৱাৰ উদ্দেশ্যে গান কৰোঁহক;","poem":1},{"lineBreak":true},{"text":"আমাৰ পৰিত্ৰাণৰ শিলাৰ অৰ্থে আনন্দ-ধ্বনি কৰোঁহক।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আহাঁ, আমি ধন্যবাদ জনাই জনাই তেওঁৰ আগত উপস্থিত হওঁ;","poem":1},{"lineBreak":true},{"text":"স্তুতি-গানেৰে তেওঁৰ উদ্দেশ্যে আনন্দ ধ্বনি কৰোঁহক।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কিয়নো যিহোৱা মহান ঈশ্বৰ,","poem":1},{"lineBreak":true},{"text":"সকলো দেৱতাবোৰৰ ওপৰত তেৱেঁই মহান ৰজা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"পৃথিৱীৰ সকলো গভীৰ স্থান তেওঁৰ হাতত আছে,","poem":1},{"lineBreak":true},{"text":"পৰ্ব্বতবোৰৰ টিংবোৰো তেওঁৰেই।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সমুদ্ৰ তেওঁৰেই, কাৰণ তেৱেঁই তাক স্ৰজিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ হাতে শুকান ভূমি নিৰ্ম্মাণ কৰিলে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আহাঁ, আমি আঁঠুকাঢ়ি প্ৰণিপাত কৰোঁ,","poem":1},{"lineBreak":true},{"text":"আমাৰ সৃষ্টিকৰ্ত্তা যিহোৱাৰ আগত আঁঠু লওঁ;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কিয়নো তেৱেঁই আমাৰ ঈশ্বৰ, আমি তেওঁৰ প্রজা;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ হাতৰ চৰণীয়া পথাৰৰ মেৰ-ছাগৰ নিচিনা।","poem":1},{"lineBreak":true},{"text":"“আজি যদি তোমালোকে তেওঁৰ মাত শুনিলেহেঁতেন!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমালোকৰ পূর্বপুৰুষসকলৰ দৰে তোমালোকে নিজৰ নিজৰ হৃদয় কঠিন নকৰিবা;","poem":1},{"lineBreak":true},{"text":"তেওঁলোকে মৰুপ্রান্তৰৰ মাজত মিৰীবা আৰু মচ্ছাত মোৰ পৰীক্ষা কৰিছিল।","poem":1},{"noteId":103}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যদিও তোমালোকৰ পূর্বপুৰুষসকলে মোৰ কার্য দেখিছিল,","poem":1},{"lineBreak":true},{"text":"তথাপিও তেওঁলোকে তাত মোক পৰীক্ষা কৰি প্রমাণ চাইছিল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"চল্লিশ বছৰ ধৰি সেই কালৰ লোকসকলৰ প্রতি মই বিৰক্ত হৈছিলো।","poem":1},{"lineBreak":true},{"text":"মই কৈছিলোঁ, “এই লোকসকলৰ হৃদয় বিপথে পৰিচালিত হৈছে; তেওঁলোকে মোৰ পথ নাজানে","poem":1},{"noteId":104},{"text":"।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"এই হেতুকে মই মোৰ ক্ৰোধত শপত খাই কৈছিলোঁ, “তেওঁলোক মোৰ বিশ্ৰামত সোমাব নাপাব।”","poem":1}]}],"footnotes":[{"noteId":103,"caller":"+","text":"মিৰীবা অর্থাৎ বিবাদ, মচ্ছা অর্থাৎ পৰীক্ষা (যাত্রা 17:7 পদ)","reference":{"chapter":95,"verse":8}},{"noteId":104,"caller":"+","text":"তেওঁলোকে মোৰ আজ্ঞা নাজানে","reference":{"chapter":95,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}