{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ উদ্দেশ্যে এটি নতুন গীত গোৱা;","poem":1},{"lineBreak":true},{"text":"হে সমগ্র পৃথিৱীৰ লোক, তোমালোকে যিহোৱাৰ উদ্দেশ্যে গীত গোৱা।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ উদ্দেশ্যে গীত গোৱা, তেওঁৰ নামৰ ধন্যবাদ কৰা;","poem":1},{"lineBreak":true},{"text":"দিনে দিনে তেওঁৰ পৰিত্ৰাণৰ কথা প্ৰচাৰ কৰা।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"বিভিন্ন জাতিৰ মাজত তেওঁৰ গৌৰৱ প্ৰচাৰ কৰা,","poem":1},{"lineBreak":true},{"text":"সমুদায় লোকৰ মাজত তেওঁৰ আচৰিত কৰ্ম ঘোষণা কৰা।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কিয়নো যিহোৱা মহান আৰু অতি প্ৰশংসাৰ যোগ্য;","poem":1},{"lineBreak":true},{"text":"তেওঁ সকলো দেৱতাতকৈয়ো ভয়ানক।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"কিয়নো সকলো জাতিৰ দেৱতাবোৰ অসাৰ মাত্র,","poem":1},{"lineBreak":true},{"text":"কিন্তু যিহোৱা আকাশমণ্ডলৰ সৃষ্টিকর্তা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"মহিমা আৰু প্ৰতাপ তেওঁৰ সন্মুখত আছে;","poem":1},{"lineBreak":true},{"text":"পৰাক্রম আৰু শোভা তেওঁৰ পবিত্ৰ স্থানত বিদ্যমান।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"হে জাতিবোৰৰ ফৈদ সমূহ,","poem":1},{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ গৌৰৱ কীৰ্ত্তন কৰা,","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰেই গৌৰৱ আৰু পৰাক্রম কীৰ্ত্তন কৰা।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমালোকে যিহোৱাৰ নামৰ উদ্দেশ্যে তেওঁৰ যোগ্য গৌৰৱ কীৰ্ত্তন কৰা,","poem":1},{"lineBreak":true},{"text":"নৈবেদ্যৰে সৈতে তেওঁৰ চোতাল কেইখনলৈ আহাঁ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ পবিত্ৰ শোভাত আহি তেওঁৰ আগত প্ৰণিপাত কৰা;","poem":1},{"lineBreak":true},{"text":"হে সমুদায় পৃথিৱী, তেওঁৰ সন্মুখত কম্পমান হোৱা।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"বিভিন্ন জাতিৰ মাজত তোমালোকে কোৱা,","poem":1},{"lineBreak":true},{"text":"“যিহোৱা ৰজা।","poem":1},{"lineBreak":true},{"text":"জগতখনক স্থিৰভাৱে স্থাপিত কৰা হ’ল; সেয়ে কেতিয়াও বিচলিত নহ’ব।","poem":1},{"lineBreak":true},{"text":"তেওঁ ন্যায়েৰে লোকসকলৰ বিচাৰ কৰিব।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"আকাশমণ্ডলে আনন্দ কৰক,","poem":1},{"lineBreak":true},{"text":"পৃথিৱীয়ে উল্লাস কৰক;","poem":1},{"lineBreak":true},{"text":"সমুদ্ৰ আৰু তাৰ সকলোৱে গৰ্জ্জন কৰক।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"পথাৰ আৰু তাত থকা সকলো উল্লাসিত হওক;","poem":1},{"lineBreak":true},{"text":"তেতিয়া অৰণ্যৰ সকলো বৃক্ষই আনন্দ গান কৰিব।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ সন্মুখতে গান কৰিব;","poem":1},{"lineBreak":true},{"text":"কিয়নো তেওঁ আহি আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁ পৃথিৱীৰ বিচাৰ কৰিবলৈ আহি আছে।","poem":1},{"lineBreak":true},{"text":"তেওঁ ধাৰ্মিকতাৰে জগতৰ বিচাৰ কৰিব;","poem":1},{"lineBreak":true},{"text":"নিজ সত্যতাৰে জাতি সমূহৰ বিচাৰ কৰিব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}