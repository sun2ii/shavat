{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"যিহোৱাই ৰজা; পৃথিৱীয়ে আনন্দ কৰক;","poem":1},{"lineBreak":true},{"text":"দ্বীপ সমূহেও আনন্দ কৰক।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তেওঁৰ চাৰিওফালে মেঘ আৰু ঘন অন্ধকাৰে ঘেৰি আছে;","poem":1},{"lineBreak":true},{"text":"ধাৰ্মিকতা আৰু ন্যায় বিচাৰ তেওঁৰ সিংহাসনৰ ভিত্তিমূল","poem":1},{"noteId":105},{"text":"।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"অগ্নিয়ে তেওঁৰ আগে আগে গমন কৰে;","poem":1},{"lineBreak":true},{"text":"চাৰিওফালে তেওঁৰ শত্ৰুবোৰক দগ্ধ কৰিছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁৰ বিজুলীৰ চমকে জগতখন আলোকময় হ’ল;","poem":1},{"lineBreak":true},{"text":"তাকে দেখি পৃথিৱী কম্পমান হ’ল।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"পর্বতবোৰ মমৰ দৰে গলি গ’ল যিহোৱাৰ সন্মুখত,","poem":1},{"lineBreak":true},{"text":"সমুদায় পৃথিৱীৰ সন্মুখত।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আকাশমণ্ডলে তেওঁৰ ধাৰ্মিকতা প্রচাৰ কৰিছে,","poem":1},{"lineBreak":true},{"text":"সকলো জাতিয়ে তেওঁৰ গৌৰৱ দেখিছে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"লজ্জিত হওঁক সেইসকল,","poem":1},{"lineBreak":true},{"text":"যিসকলে মূৰ্ত্তি পূজা কৰে;","poem":1},{"lineBreak":true},{"text":"যিসকলে অসাৰ প্রতিমাত গর্ব কৰে;","poem":1},{"lineBreak":true},{"text":"যিহোৱাৰ আগত সকলো দেৱতাই প্ৰণিপাত কৰক।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তোমাৰ ন্যায় বিচাৰৰ কাৰণে চিয়োন আনন্দিত হৈছে,","poem":1},{"lineBreak":true},{"text":"যিহূদাৰ জীয়ৰীসকল উল্লাসিত হৈছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"হে যিহোৱা, তুমি সমুদায় পৃথিৱীৰে সৰ্ব্বোপৰি জনা;","poem":1},{"lineBreak":true},{"text":"সকলো দেৱতাৰ ওপৰত তোমাৰ স্থান।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিসকলে দুষ্টতাক ঘিণ কৰে, যিহোৱাই তেওঁলোকক প্ৰেম কৰে","poem":1},{"noteId":106},{"text":";","poem":1},{"lineBreak":true},{"text":"তেওঁ নিজৰ ভক্তসকলৰ প্ৰাণ ৰক্ষা কৰে,","poem":1},{"lineBreak":true},{"text":"দুষ্টসকলৰ হাতৰ পৰা তেওঁলোকক উদ্ধাৰ কৰে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ধাৰ্মিকৰ কাৰণে পোহৰ সিঁচি দিয়া হয়;","poem":1},{"lineBreak":true},{"text":"সৰল অন্তৰৰ লোকৰ কাৰণে আনন্দ দিয়া হয়।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"হে ধাৰ্মিক লোকসকল,","poem":1},{"lineBreak":true},{"text":"যিহোৱাত আনন্দ কৰা,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ পবিত্ৰ নামৰ ধন্যবাদ কৰা।","poem":1}]}],"footnotes":[{"noteId":105,"caller":"+","text":"ধাৰ্মিকতা আৰু ন্যায় বিচাৰ তেওঁ শাসন কৰিব","reference":{"chapter":97,"verse":2}},{"noteId":106,"caller":"+","text":"হে যিহোৱাক আৰাধনা কৰা লোক, দুষ্টতাক ঘৃণা কৰিবা।","reference":{"chapter":97,"verse":10}}]},"thisChapterLink":"/api/asm_irv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}