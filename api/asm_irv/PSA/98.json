{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"PSA","translationId":"asm_irv","name":"গীতমালা","commonName":"গীতমালা","title":"গীতমালা","order":19,"numberOfChapters":150,"sha256":"ef7e28bec041f99c8c23cf76b89f6f390d03b929b0ecf7a2e4052aef03e177ef","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/asm_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["এটি গীত।"]},{"type":"verse","number":1,"content":[{"text":"তোমালোকে যিহোৱাৰ উদ্দেশ্যে নতুন গীত গোৱা;","poem":1},{"lineBreak":true},{"text":"কাৰণ তেওঁ অনেক আচৰিত কার্য কৰিলে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ সোঁ হাত আৰু তেওঁৰ পবিত্ৰ বাহুৱে","poem":1},{"lineBreak":true},{"text":"আমাক জয়ী কৰিলে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"যিহোৱাই তেওঁৰ পৰিত্ৰাণৰ কথা জনালে;","poem":1},{"lineBreak":true},{"text":"তেওঁ জাতি সমূহৰ দৃষ্টি গোচৰত নিজৰ ধাৰ্মিকতা মুকলিকৈ প্ৰকাশ কৰিলে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ইস্ৰায়েল বংশৰ কাৰণে তেওঁৰ অটল প্রেম আৰু বিশ্বস্ততাৰ কথা তেওঁ সোঁৱৰণ কৰিলে;","poem":1},{"lineBreak":true},{"text":"পৃথিৱীৰ সকলো প্রান্তই আমাৰ ঈশ্বৰৰ জয় দেখা পাব।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"হে সমুদায় পৃথিৱী, যিহোৱাৰ উদ্দেশ্যে আনন্দ-ধ্বনি কৰা;","poem":1},{"lineBreak":true},{"text":"উচ্চ ধ্বনিৰে আনন্দ গান কৰা, প্ৰশংসাৰ গীত গোৱা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"বীণা বজাই যিহোৱাৰ প্ৰশংসাৰ গীত গোৱা,","poem":1},{"lineBreak":true},{"text":"বীণা বজাই সুন্দৰ সুৰেৰে যিহোৱাৰ প্ৰশংসাৰ গীত গোৱা।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তূৰী বজাই শিঙা বাদ্যৰে সৈতে ৰজা যিহোৱাৰ আগত আনন্দ ধ্বনি কৰা।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"সমুদ্ৰ আৰু তাৰ সকলোৱেই গৰ্জ্জন কৰক;","poem":1},{"lineBreak":true},{"text":"জগত আৰু তাত বাস কৰা সকলোৱে গৰ্জ্জন কৰক।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"নদীবোৰে হাত-তালি দিয়ক;","poem":1},{"lineBreak":true},{"text":"পর্বতবোৰে একেলগে আনন্দ গান কৰক,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিহোৱাৰ সন্মুখতে তেনে কৰক;","poem":1},{"lineBreak":true},{"text":"কিয়নো তেওঁ আহি আছে;","poem":1},{"lineBreak":true},{"text":"পৃথিৱীৰ বিচাৰ কৰিবলৈ তেওঁ আহি আছে।","poem":1},{"lineBreak":true},{"text":"তেওঁ ধাৰ্মিকতাৰে জগতৰ বিচাৰ কৰিব;","poem":1},{"lineBreak":true},{"text":"নিজ ন্যায়েৰে জাতি সমূহৰ বিচাৰ কৰিব।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}