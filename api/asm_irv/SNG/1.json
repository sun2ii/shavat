{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"SNG","translationId":"asm_irv","name":"পৰমগীত","commonName":"পৰমগীত","title":"পৰমগীত","order":22,"numberOfChapters":8,"sha256":"da7ab4f7705128d9d2db9d274ced6d1aa8e0d072060d2e9a712f9558e8da6bbd","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/asm_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["চলোমনৰ পৰমগীত"]},{"type":"verse","number":1,"content":["ৰজা চলোমনৰ অতি সুন্দৰ গীতৰ শৰাই- কইনাই নিজৰ ভালপোৱা স্বীকাৰ কৰা:",{"text":"প্রিয়াৰ কথা","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"তুমি তোমাৰ মুখৰ চুম্বনবোৰেৰে মোক","poem":1},{"noteId":0},{"text":"ভৰাই দিয়া,","poem":1},{"lineBreak":true},{"text":"কাৰণ তোমাৰ ভালপোৱা দ্রাক্ষাৰসতকৈও উত্তম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমাৰ তেলৰ সুগন্ধই আনন্দৰ সৌৰভ আনে;","poem":1},{"lineBreak":true},{"text":"বাকি দিয়া সুগন্ধৰ দৰেই তোমাৰ নাম;","poem":1},{"lineBreak":true},{"text":"সেই বাবেই যুৱতীসকলে তোমাক ভাল পায়।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"(যুৱতীয়ে নিজৰ মনতে ক’লে) মোক তোমাৰ লগত লৈ ব’লা; আমি সোনকালে পলাই যাম।","poem":1},{"lineBreak":true},{"text":"ৰজাই মোক তেওঁৰ কক্ষৰ ভিতৰলৈ লৈ আনিলে;","poem":1},{"text":"প্রিয়ৰ প্রতি কইনাৰ কথা:","descriptive":true},{"text":"মই সুখী; মই তোমাক লৈ আনন্দ কৰোঁ;","poem":1},{"lineBreak":true},{"text":"মোক তোমাৰ প্রেমত উল্লাসিত হ’বলৈ দিয়া; তোমাৰ ভালপোৱা দ্রাক্ষাৰসতকৈও উত্তম।","poem":1},{"lineBreak":true},{"text":"আন ৰমণীসকলে যে তোমাৰ প্রশংসা কৰে, ই স্বাভাৱিক কথা।","poem":1},{"text":"আন ৰমণীসকলৰ প্রতি:","descriptive":true}]},{"type":"verse","number":5,"content":["হে যিৰূচালেমৰ",{"text":"ৰমণীসকল, মই ক’লা বৰণীয়া হ’লেও সুন্দৰী;","poem":1},{"lineBreak":true},{"text":"মই কেদৰৰ তম্বুৰ নিচিনা ক’লা আৰু চলোমনৰ পর্দাবোৰৰ দৰে সুন্দৰী।","poem":1}]},{"type":"verse","number":6,"content":["মই ক’লা বাবেই মোলৈ",{"text":"চাই নাথাকিবা; কাৰণ সূর্যৰ তাপে মোক ডেই নিলে।","poem":1},{"lineBreak":true},{"text":"মোৰ ভাই-ককাইসকলে","poem":1},{"lineBreak":true},{"text":"মোৰ ওপৰত খং কৰি মোক","poem":1},{"lineBreak":true},{"text":"দ্ৰাক্ষাবাৰীবোৰৰ দেখা-শুনা কৰিবলৈ দিছিল;","poem":1},{"lineBreak":true},{"text":"সেয়ে মই মোৰ নিজৰ দ্ৰাক্ষাবাৰী","poem":1},{"noteId":1},{"text":"ৰ যত্ন ল’ব পৰা নাই।","poem":1},{"text":"প্রিয়ৰ প্রতি যুৱতীৰ কথা:","descriptive":true}]},{"type":"verse","number":7,"content":[{"text":"হে মোৰ প্রিয়তম, মোৰ প্রাণে তোমাকে ভালপায়!","poem":1},{"lineBreak":true},{"text":"মোক কোৱা, তুমি তোমাৰ মেৰ-ছাগৰ জাকক কোন ঠাইত চৰোৱা?","poem":1},{"lineBreak":true},{"text":"তুমি তোমাৰ মেৰ-ছাগবোৰক দুপৰীয়া ক’ত বিশ্রাম কৰোঁৱা?","poem":1},{"lineBreak":true},{"text":"তোমাৰ লগৰীয়াৰ মেৰ-ছাগৰ জাকবোৰৰ কাষত,","poem":1},{"lineBreak":true},{"text":"মই কিয় ওৰণি লোৱা","poem":1},{"noteId":2},{"text":"জনীৰ নিচিনা ঘূৰি ফুৰিম?","poem":1},"চলোমন আৰু তেওঁৰ কন্যা দুয়ো দুয়োতে সুখী",{"text":"প্রিয়ৰ কথা:","descriptive":true}]},{"type":"verse","number":8,"content":[{"text":"তুমি যদি তাক নাজানা, হে পৰম সুন্দৰী যুৱতী,","poem":1},{"lineBreak":true},{"text":"মোৰ মেৰ-ছাগৰ জাকৰ খোজৰ","poem":1},{"lineBreak":true},{"text":"চিনবোৰৰ পাছে পাছে আহাঁ আৰু","poem":1},{"lineBreak":true},{"text":"তোমাৰ ছাগলী পোৱালিবোৰক মেৰ-ছাগ ৰখীয়াসকলৰ তম্বুৰ ওচৰতে চৰোৱা।","poem":1}]},{"type":"verse","number":9,"content":["হে মোৰ প্ৰিয়তমা,",{"text":"ফৰৌণৰ ৰথৰ এজনী ঘোঁৰাৰে সৈতে,","poem":1},{"lineBreak":true},{"text":"মই তোমাক তুলনা কৰিছোঁ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"গালৰ দুপাশৰ গহণাৰে সৈতে, তোমাৰ গাল দুখন সুন্দৰ দেখাইছে,","poem":1},{"lineBreak":true},{"text":"আৰু মুকুতাৰ কণ্ঠহাৰে তোমাৰ ডিঙি শোভিত কৰিছে।","poem":1}]},{"type":"verse","number":11,"content":["মই তোমাৰ কাৰণে ঠায়ে",{"text":"ঠায়ে ৰূপ খচিত","poem":1},{"lineBreak":true},{"text":"সোণৰ অলঙ্কাৰ নির্মাণ কৰিম।","poem":1},{"text":"প্রিয়াৰ কথা:","descriptive":true}]},{"type":"verse","number":12,"content":["ৰজাই যেতিয়া তেওঁৰ বিচনাত",{"noteId":3},"শুইছিল,",{"text":"তেতিয়া মোৰ সুগন্ধৰ সুঘ্রাণ বিয়পি পৰিল।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"মোৰ ওচৰত মোৰ প্রিয় গন্ধৰস থোৱা এটি মোনাৰ দৰে,","poem":1},{"lineBreak":true},{"text":"যি মোৰ স্তনযুগলৰ মাজত গোটেই ৰাতি থাকে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"মোৰ প্রিয় মোৰ ওচৰত যেন এথোপা জেতুকা ফুল,","poem":1},{"lineBreak":true},{"text":"যি অয়িন-গদীৰ দ্ৰাক্ষাবাৰীত উৎপন্ন হয়।","poem":1},{"text":"প্রিয়ৰ কথা:","descriptive":true}]},{"type":"verse","number":15,"content":[{"text":"চোৱা, কি সুন্দৰী তুমি! মোৰ প্রিয়া;","poem":1},{"lineBreak":true},{"text":"তুমি কিমান যে সুন্দৰী! তোমাৰ দুচকু কপৌৰ নিচিনা।","poem":1},{"text":"প্রিয়াৰ কথা:","descriptive":true}]},{"type":"verse","number":16,"content":[{"text":"চোৱা, কি সুন্দৰ তুমি! মোৰ প্রিয়;","poem":1},{"lineBreak":true},{"text":"তুমি কিমান যে সুন্দৰ!","poem":1},{"lineBreak":true},{"text":"আমাৰ শয্যা সেউজীয়া ঘাহেঁৰে ভৰা।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"এৰচ গছৰ ডাল আমাৰ ঘৰৰ চতি আৰু আমাৰ ঘৰৰ বাটাম দেবদাৰুৰ ডাল।","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"তেওঁ তেওঁৰ ওঁঠ","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"নিজৰ সৌন্দর্য","reference":{"chapter":1,"verse":6}},{"noteId":2,"caller":"+","text":"ঘূৰি ফুৰা","reference":{"chapter":1,"verse":7}},{"noteId":3,"caller":"+"