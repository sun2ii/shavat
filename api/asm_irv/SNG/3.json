{"translation":{"id":"asm_irv","name":"ইণ্ডিয়ান ৰিভাইচ ভাৰচন (IRV) আচামিচ - 2019","website":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=asmfb","licenseNotes":null,"shortName":"IRV","englishName":"Assamese Indian Revised Version Bible","language":"asm","textDirection":"ltr","sha256":"6886f1655c6e7c6696b2fb43a1a85123b4860b1d77e887a511e8a98a6dcd7a4f","availableFormats":["json"],"listOfBooksApiLink":"/api/asm_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31092,"languageName":"অসমীয়া","languageEnglishName":"Assamese"},"book":{"id":"SNG","translationId":"asm_irv","name":"পৰমগীত","commonName":"পৰমগীত","title":"পৰমগীত","order":22,"numberOfChapters":8,"sha256":"da7ab4f7705128d9d2db9d274ced6d1aa8e0d072060d2e9a712f9558e8da6bbd","firstChapterNumber":1,"firstChapterApiLink":"/api/asm_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/asm_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["কইনাৰ সপোন:"]},{"type":"verse","number":1,"content":[{"text":"ৰাতি মোৰ শয্যাত","poem":1},{"lineBreak":true},{"text":"মোৰ প্ৰাণৰ প্ৰিয়তমক মই বিচাৰিলো;","poem":1},{"lineBreak":true},{"text":"মই তেওঁক বিচাৰিলো, কিন্তু নাপালোঁ;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"মই ভাবিলোঁ, “মই এতিয়া উঠি নগৰখনৰ মাজত ঘূৰি ফুৰিম;","poem":1},{"lineBreak":true},{"text":"ৰাস্তায় ৰাস্তায়, চকবোৰত ঘূৰি ফুৰিম;","poem":1},{"lineBreak":true},{"text":"তাত মই মোৰ প্রাণৰ প্রিয়তমক বিচাৰিম।”","poem":1},{"lineBreak":true},{"text":"মই তেওঁক বিচাৰিলোঁ, কিন্তু নাপালোঁ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"প্ৰহৰীবোৰে নগৰ ঘূৰি ফুৰি পহৰা দিয়াৰ সময়ত,","poem":1},{"lineBreak":true},{"text":"মোক দেখা পালে।","poem":1},{"lineBreak":true},{"text":"মই তেওঁলোকক সুধিলোঁ, আপোনালোকে মোৰ প্ৰাণৰ প্ৰিয়তমক দেখিছিল নে?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তেওঁলোকক পাৰ হৈ আগুৱাই যাওঁতেই,","poem":1},{"lineBreak":true},{"text":"মই মোৰ প্ৰাণৰ প্ৰিয়তমক দেখা পালোঁ।","poem":1},{"lineBreak":true},{"text":"তেওঁক ধৰি মোৰ মাতৃৰ ঘৰলৈ লৈ নহালৈকে,","poem":1},{"lineBreak":true},{"text":"মই তেওঁক এৰি নিদিলোঁ;","poem":1},{"lineBreak":true},{"text":"যি গৰাকীয়ে মোক গর্ভত ধাৰণ কৰিছিল,","poem":1},{"lineBreak":true},{"text":"মই তেওঁৰেই শোৱনি কোঠালিলৈ প্রিয়তমক লৈ আনিলো।","poem":1},{"text":"ৰমণীসকলৰ প্রতি উক্তি:","descriptive":true}]},{"type":"verse","number":5,"content":[{"text":"হে যিৰূচালেমৰ যুৱতীসকল,","poem":1},{"lineBreak":true},{"text":"কৃষ্ণসাৰ আৰু পথাৰৰ হৰিণবোৰৰ নামেৰে মোৰ ওচৰত প্রতিশ্রুতি দিয়া,","poem":1},{"lineBreak":true},{"text":"আমাৰ প্ৰেমৰ সময় শেষ নোহোৱালৈকে","poem":1},{"lineBreak":true},{"text":"তোমালোকে আমাৰ ভালপোৱাত বিঘিনি নিদিবা।","poem":1},{"text":"বিবাহৰ বাবে চলোমনৰ আগমণ","descriptive":true}]},{"type":"verse","number":6,"content":[{"text":"মৰুভূমিৰ পৰা ধোঁৱাৰ স্তম্ভৰ দৰে সেই গৰাকী কোন আহিছে?","poem":1},{"lineBreak":true},{"text":"তেওঁ ব্যৱসায়ীৰ সকলো ধৰণৰ মছলাগুৰিৰ গন্ধ লৈ,","poem":1},{"lineBreak":true},{"text":"গন্ধৰস আৰু সুগন্ধি ধূপৰ সুবাসেৰে এক ধোঁৱাৰ স্তম্ভৰ দৰে আহিছে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"চোৱা, সৌৱা চলোমনৰ দোলা;","poem":1},{"lineBreak":true},{"text":"ষাঠিজন বীৰ যোদ্ধাই সেই দোলাক ঘেৰি ৰাখিছে;","poem":1},{"lineBreak":true},{"text":"তেওঁলোক ইস্রায়েলৰ শক্তিশালী সৈন্য।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তেওঁলোক সকলোৰে লগত আছে তৰোৱাল;","poem":1},{"lineBreak":true},{"text":"যুদ্ধত তেওঁলোক সুদক্ষ;","poem":1},{"lineBreak":true},{"text":"তৰোৱাল ককালত বান্ধি লৈ","poem":1},{"lineBreak":true},{"text":"তেওঁলোক প্ৰতিজন প্রস্তুত আছে ৰাতিৰ বিপদৰ কাৰণে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ৰজা চলোমনে লিবানোনৰ কাঠেৰে নিজৰ বাবে,","poem":1},{"lineBreak":true},{"text":"এটি দোলা নির্মাণ কৰিলে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"দোলাৰ খুটাবোৰ ৰূপেৰে","poem":1},{"lineBreak":true},{"text":"পিছৰ ভাগ সোণেৰে,","poem":1},{"lineBreak":true},{"text":"আসনখন বেঙেনা বৰণীয়া কাপোৰেৰে তৈয়াৰী;","poem":1},{"lineBreak":true},{"text":"যিৰূচালেমৰ ৰমণীসকলৰ প্রেমেৰে","poem":1},{"lineBreak":true},{"text":"তাৰ ভিতৰ অংশ খচিত আৰু শোভিত কৰা হ’ল","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"হে চিয়োনৰ যুৱতীসকল, তোমালোক বাহিৰলৈ ওলাই আহাঁ,","poem":1},{"lineBreak":true},{"text":"চোৱা, ৰজা চলোমনে মুকুট পিন্ধি আছে;","poem":1},{"lineBreak":true},{"text":"তেওঁৰ বিবাহৰ দিনা, তেওঁৰ সেই মনৰ আনন্দৰ দিনা,","poem":1},{"lineBreak":true},{"text":"তেওঁৰ মাকে তেওঁক মুকুট পিন্ধাই দিছে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/asm_irv/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}