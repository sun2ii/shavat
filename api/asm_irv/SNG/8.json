":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"তুমি মোক শিক্ষা দিবা।","reference":{"chapter":8,"verse":2}},{"noteId":13,"caller":"+","text":"খুবানি, সুমথিৰা ৰঙৰ এবিধ টেঙা ফল","reference":{"chapter":8,"verse":5}},{"noteId":14,"caller":"+","text":"মই এক প্রাচীৰ আছিলোঁ, কিন্তু এতিয়া মোৰ বক্ষযুগল মিনাৰৰ কোঁঠৰ নিচিনা, সেয়ে, মই সম্পূর্ণকৈ তেওঁৰ দৃষ্টিত অনুগ্ৰহ পাইছো।","reference":{"chapter":8,"verse":10}},{"noteId":15,"caller":"+","text":"এক চেকল হ’ল, সেই সময়ত এজন গাৱঁলীয়া কর্মীৰ এদিনৰ হাজিৰা।","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/asm_irv/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/asm_irv/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/asm_irv/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}