{"translation":{"id":"atg_wbt","name":"Ebe-No-Pfuasẹ Ishobọ Onogbọ","website":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseNotes":null,"shortName":"WBT","englishName":"Ivbie North-Okpela-Arhe NT","language":"atg","textDirection":"ltr","sha256":"83221f9f7633c093e6bc4a684fb251cab2f80436e15f5a1ac40fca75c2092dd8","availableFormats":["json"],"listOfBooksApiLink":"/api/atg_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7949,"languageName":"Ivbie North-Okpela-Arhe","languageEnglishName":"Ivbie North-Okpela-Arhe"},"book":{"id":"MAT","translationId":"atg_wbt","name":"iMatiu","commonName":"iMatiu","title":"Usomhi Onete oyi iJesu iKirisiti ni IMatiu Ọ kẹkẹ","order":40,"numberOfChapters":28,"sha256":"fda99320037df63ce147248548d08690b6e68675e6cf01b00babb542f636bafb","firstChapterNumber":1,"firstChapterApiLink":"/api/atg_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/atg_wbt/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["Unuẹkpẹ oyi iJesu iKirisiti"]},{"type":"verse","number":1,"content":["Ona o khi akẹkẹ shi ekẹ abi unuẹkpẹ oyi iJesu iKirisiti Omi iDefidi ni ọ khi Omi Aburaamu o li zẹ."]},{"type":"verse","number":2,"content":["Aburaamu ọ bia Aziki,",{"text":"Aziki ọ bia iGiekọpu,","poem":1},{"lineBreak":true},{"text":"IGiekọpu ọ bia iJuda","poem":1},{"lineBreak":true},{"text":"ali inyọghuo ọli nya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"IJuda ọ bia iPẹrẹzi","poem":1},{"lineBreak":true},{"text":"ali iZẹra, ọkpotso ni ọ bia wẹ,","poem":1},{"text":"a lu iTama.","poem":2},{"text":"IPẹrẹzi ọ bia Ezirọni.","poem":1},{"lineBreak":true},{"text":"Ezirọni ọ bia iRamu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"IRamu ọ bia Aminadabu.","poem":1},{"lineBreak":true},{"text":"Aminadabu ọ bia iNashọni,","poem":1},{"lineBreak":true},{"text":"iNashọni ọ bia iSalimọni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ISalimọni ọ bia iBoazi,","poem":1},{"lineBreak":true},{"text":"ọkpotso ni ọ bia iBoazi,","poem":1},{"text":"a lu iRe-abu.","poem":2},{"text":"IBoazi ọ bia Obẹdi","poem":1},{"lineBreak":true},{"text":"ni a lu inyọli iRutu.","poem":1},{"lineBreak":true},{"text":"Obẹdi ọ bia iJese.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"IJese ọ bia iDefidi","poem":1},{"text":"ni ọ khi oghie.","poem":2},{"text":"IDefidi ọ bia iSolomoni","poem":1},{"lineBreak":true},{"text":"ni inyọli ọ kpẹ khi ughuẹ Uraya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ISolomoni ọ bia iReobuamu.","poem":1},{"lineBreak":true},{"text":"IReobuamu ọ bia Abija.","poem":1},{"lineBreak":true},{"text":"Abija ọ bia Asa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ọ bia iJeoshafati.","poem":1},{"lineBreak":true},{"text":"IJeoshafati ọ bia iJeoramu,","poem":1},{"lineBreak":true},{"text":"iJeoramu ọ bia Uzaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzaya ọ bia iJotamu.","poem":1},{"lineBreak":true},{"text":"IJotamu ọ bia Aazi.","poem":1},{"lineBreak":true},{"text":"Aazi ọ bia Ezekaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezekaya ọ bia iManasẹ,","poem":1},{"lineBreak":true},{"text":"iManasẹ ọ bia Amọni.","poem":1},{"lineBreak":true},{"text":"Amọni ọ bia iJosaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"IJosaya ọ bia iJekonaya","poem":1},{"lineBreak":true},{"text":"ali inyọghuo ọli nya","poem":1},{"lineBreak":true},{"text":"ẹghẹghẹ ni a rọ muno","poem":1},{"lineBreak":true},{"text":"ẹgbọ iZirẹni ighumha je iBabilọ.","poem":1},{"noteId":0}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abi e ke rọ rọte iBabilọ jele,","poem":1},{"lineBreak":true},{"text":"iJekonaya ọ bia iShalitiẹni.","poem":1},{"lineBreak":true},{"text":"IShalitiẹni ọ bia IZerubabẹli.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"IZerubabẹli ọ bia Abiudu.","poem":1},{"lineBreak":true},{"text":"Abiudu ọ bia Eliakimu.","poem":1},{"lineBreak":true},{"text":"Eliakimu ọ bia Azori.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azori ọ bia iZadọki.","poem":1},{"lineBreak":true},{"text":"IZadọki ọ bia Akimu.","poem":1},{"lineBreak":true},{"text":"Akimu ọ bia Eliudu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliudu ọ bia Eliaza.","poem":1},{"lineBreak":true},{"text":"Eliaza ọ bia iMataani.","poem":1},{"lineBreak":true},{"text":"IMataani ọ bia iGiekọpu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"IGiekọpu ọ bia iJosẹfu,","poem":1},{"lineBreak":true},{"text":"ni ọ rue iMeli inyi iJesu shi","poem":1},{"lineBreak":true},{"text":"ni a lu iKirisiti.","poem":1}]},{"type":"verse","number":17,"content":["Rọte ẹghẹghẹ Aburaamu bhale ẹghẹghẹ iDefidi, e khi agbhotu igbẹne. Ke rọte ẹghẹghẹ iDefidi bhale ẹghẹghẹ ni a rọ muno ẹgbọ iZirẹni ighumha je iBabilọ, e khi agbhotu igbẹne. Ke rọte ẹghẹghẹ iBabilọ bhale ẹghẹghẹ ni a rọ bia iJesu iKirisiti, e gbo li khi agbhotu igbẹne ghọ."]},{"type":"heading","content":["Abi a li bia iJesu iKirisiti"]},{"type":"verse","number":18,"content":["Abi a li bia iJesu iKirisiti na. Neni iMeli inyọli ọ ngeli na iJosẹfu ni ọọ gue ọli. A bhale ya ẹ khi iMeli ọọ mẹ ọmọ ni ọ rọte obọ oyi Ayẹmhẹ-nọ-pfuasẹ bhale.",{"noteId":1}]},{"type":"verse","number":19,"content":["Itobọ khi iJosẹfu ughuọli, ọ khi ọgbọ ni ọ guẹ angeli, ọọ sali shi udu khi lọli ya kuegbe-a ri imeli shi ekẹ, ini lọli khi yẹghẹ ọlia ukpẹloe agbọ."]},{"type":"verse","number":20,"content":["Abi ọ lii sa ona shi udu, agẹni ọ bhale deba li alo ẹlena, ọọ li, “IJosẹfu omi iDefidi, khi ke zẹ ni ulishi o mu ẹ abi u li ya rue iMeli shi ughuẹ, irari khi ọmọ ni ọọ mẹ, obọ oyi Ayẹmhẹ-nọ-pfuasẹ ọ te bhale."]},{"type":"verse","number":21,"content":["Ọ ya bia ọmọ ọmọse, eva ni u ya lu ọni ọmọ khi iJesu, irari khi ọ ya mie ẹgbọ eyọli olamhẹ pfuese.”",{"noteId":2}]},{"type":"verse","number":22,"content":["Eri a mẹ enana ni a rọ bhẹ ya ẹ khi ingmemhi ni Ẹshinẹgba ọ rọte unu oyi ọmekẹguele ngme, ni e bhale ya tsẹ. Ni ọọ,"]},{"type":"verse","number":23,"content":["“Ghe khẹ! Ọmueshi ni ọa lẹ deba ọmọse ghue ọ ya ke mẹ ọmọ, ọ bia ọmọ ọmọse, eva oyọli a ya ke lu iManuẹni.”",{"noteId":3},"Abi ona o ngme khi, “Ẹshinẹgba ọ nu awa la.”"]},{"type":"verse","number":24,"content":["Abi iJosẹfu ọ rọ guale, ọ riẹlẹ emini Ọnọmhuẹ ọ mhẹsẹ na li ọ riẹlẹ, ọ rue iMeli ughuẹ abi Ẹshinẹgba ọ gueyẹ ọli."]},{"type":"verse","number":25,"content":["Eri-tsẹ khi iJosẹfu ọa tigbe lẹ deba iMeli, ramhi ni ọ rọ bia ọni ọmọ ọmọse. IJosẹfu ọ lu eva oyi ọni ọmọ, iJesu.",{"noteId":4}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Li zẹ 2 Ighie 24.14-15; 2 Okhẹ 36.10; iJere 27.20","reference":{"chapter":1,"verse":11}},{"noteId":1,"caller":"+","text":"Li zẹ iLuk 1.27","reference":{"chapter":1,"verse":18}},{"noteId":2,"caller":"+","text":"Li zẹ iLuk 1.31","reference":{"chapter":1,"verse":21}},{"noteId":3,"caller":"+","text":"Li zẹ Aza 7.14; 8.8,10","reference":{"chapter":1,"verse":23}},{"noteId":4,"caller":"+","text":"Li zẹ iLuk 2.21","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/atg_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/atg_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}