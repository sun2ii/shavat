{"translation":{"id":"atg_wbt","name":"Ebe-No-Pfuasẹ Ishobọ Onogbọ","website":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseNotes":null,"shortName":"WBT","englishName":"Ivbie North-Okpela-Arhe NT","language":"atg","textDirection":"ltr","sha256":"83221f9f7633c093e6bc4a684fb251cab2f80436e15f5a1ac40fca75c2092dd8","availableFormats":["json"],"listOfBooksApiLink":"/api/atg_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7949,"languageName":"Ivbie North-Okpela-Arhe","languageEnglishName":"Ivbie North-Okpela-Arhe"},"book":{"id":"REV","translationId":"atg_wbt","name":"Irọkhasẹ","commonName":"Irọkhasẹ","title":"Irọkhasẹ Ni iJọni ọ kẹkẹ","order":66,"numberOfChapters":22,"sha256":"9cf94cb4f4c5c5fb73e83739320c4c982f9be903c10296bce8318e829f5525cb","firstChapterNumber":1,"firstChapterApiLink":"/api/atg_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/atg_wbt/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Udemhi oyi iBabilọ"]},{"type":"verse","number":1,"content":["Onana ọ dọsẹ se, mhi mẹ agẹni olese khi ọ rọte iloghie ẹ tiemhile. Ọ mhọli afu nofunẹ, ugẹmhi oyọli o ri ekẹ agbọ ọ gẹ nyanyanya."]},{"type":"verse","number":2,"content":["Ọ ri uruli oniẹmhi tsẹsẹ leghe, ọ li.",{"text":"“Ẹoli iBabilọ Oniẹmhi,","poem":1},{"text":"o she de.","poem":2},{"text":"O she mele ugbebo","poem":1},{"text":"oyi iyẹmhẹ eyi","poem":2},{"lineBreak":true},{"text":"ọkphaghiẹ-a,","poem":2},{"text":"ali ashini iyẹmhẹ","poem":1},{"text":"ọkphaghiẹ e la lese,","poem":2},{"text":"ashini ipfeli ali elamhakọ","poem":1},{"text":"ni aa pfuasẹ ni aa ghuẹ,","poem":2},{"lineBreak":true},{"text":"ẹẹ la.","poem":2},{"noteId":119}]},{"type":"verse","number":3,"content":[{"text":"Irari khi ishishi nya,","poem":1},{"text":"e she kpọkpọ onyọ,","poem":2},{"text":"ni o ri ujili ẹ kpha,","poem":1},{"text":"ikhi onyọ okia oyọli.","poem":2},{"text":"Ighie na ekẹ agbọ","poem":1},{"text":"e she kia okia deba li.","poem":2},{"text":"Eduoki na ekẹ agbọ,","poem":1},{"lineBreak":true},{"text":"e she rọte","poem":1},{"lineBreak":true},{"text":"iliagbọ-tsuakua oyọli","poem":1},{"text":"mhuẹ ẹpfue.”","poem":2},{"noteId":120}]},{"type":"verse","number":4,"content":["Ighọ mhi suọ uruli olese ni o rọte idane liẹ,",{"text":"“Ẹgbọ eyẹmhẹ, a na li egbe kua,","poem":1},{"text":"ini a khi mhuẹ okemhi","poem":2},{"lineBreak":true},{"text":"shi olamhẹ eyọli,","poem":2},{"text":"ini a khi mhuẹ okemhi","poem":1},{"text":"shi osoli anasẹmhẹ oyọli.","poem":2},{"noteId":121}]},{"type":"verse","number":5,"content":[{"text":"Irari khi olamhẹ eyọli","poem":1},{"text":"e she tigbili yagha ramhi idane,","poem":2},{"text":"Ẹshinẹgba ọ she sato","poem":1},{"text":"umha-guẹli eyọli.","poem":2},{"noteId":122}]},{"type":"verse","number":6,"content":[{"text":"Ā li ọli, abi ọ li ẹ,","poem":1},{"text":"ā fali ọli ota asha eva","poem":2},{"lineBreak":true},{"text":"shi ikanya ni ọ gbe.","poem":2},{"text":"Onyọ ni o toto ni ọ rọ na ẹ da,","poem":1},{"text":"a sọ oghọghọ nali da asha eva.","poem":2},{"noteId":123}]},{"type":"verse","number":7,"content":[{"text":"A ri osoli ali oyala nali","poem":1},{"text":"ni o guẹ to ufumhi ali ẹpfue","poem":2},{"lineBreak":true},{"text":"ni ọ rọna egbọli.","poem":2},{"text":"Irari khi eri Ọni Ọkpotso","poem":1},{"text":"ọ la ekelemhi tono obọ udu liẹ,","poem":2},{"text":"‘Mhẹmhẹ mhi khi ọni ọlele!","poem":1},{"text":"Mhi aa tigbe ya khi","poem":2},{"lineBreak":true},{"text":"ọsamhi-olimhi,","poem":2},{"text":"mhi aa tigbe ya","poem":1},{"text":"mẹ oya egbe ghue.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Irarighọ, ogbẹlẹghuo","poem":1},{"lineBreak":true},{"text":"anasẹmhẹ oyọli","poem":1},{"text":"o rọ ya sha rughu ọli,","poem":2},{"text":"shi eghuli ali eviẹ","poem":1},{"text":"ali okiamhi.","poem":2},{"text":"A ya ri erali tosẹ ọli-a.","poem":1},{"lineBreak":true},{"text":"Irari khi Ẹshinẹgba Ọnọmhuẹ","poem":1},{"text":"ni ọ ya gue ọli ẹzọ,","poem":2},{"lineBreak":true},{"text":"ọnọfunẹ nya ọ khi.”","poem":2},{"noteId":124}]},{"type":"verse","number":9,"content":["“Ini ighie na agbọ ni e kia okia deba li, ni e nu ọli li agbọ tsua kua, e ya viẹ, e viẹ eviẹ oya na li, ini e mẹ ewọli erali ni ẹẹ tosẹ ọli-a."]},{"type":"verse","number":10,"content":["E ya tapfia migha ke viẹ irari ulishi osoli ni a na li, ẹẹ liẹ,",{"text":"“ ‘Eekhue o Eekhue o","poem":1},{"text":"yẹyẹ ẹoli nofunẹ,","poem":2},{"lineBreak":true},{"text":"iBabilọ ẹoli no mhuẹ ekpabọ!","poem":2},{"text":"Elemhi iwakati oghuo tsẹ","poem":1},{"text":"epfua oyẹ o she bhale!’","poem":2},{"noteId":125}]},{"type":"verse","number":11,"content":["“Eduoki na agbọ e ya viẹ ọli e viẹ oya irari khi ọgbọkhọghuo ọa ke nu wẹ ya dẹ itsua.",{"noteId":126}]},{"type":"verse","number":12,"content":["Itsua igolu ali ẹlomho, imiechẹ ni e somhotse ni e ghalẹ, ifẹfẹ ali ema, ide epfopfo na kpishi, ali eni ẹ yilẹ, ghe ena wọnọ, ali ilọlọ eni eyilẹ ali itsua ọdọda ni a ri ọọra ni ẹ pfie khali, ali itsua ọdọda ni a ri ekphali eni khali, ali ẹẹra ni e ghalẹ, idẹ ali ikhuli ali echẹ imabo."]},{"type":"verse","number":13,"content":["Ali alagho na lu ikinamọni ali ọshamhi ali ituale afu ẹẹra ali ituale ni a ku ẹ shi olimhi egbe, ali atike ni ọọ pfie ni o ghalẹ ali onyọ ali oili ali ifulawa ali ikpamhi emhi ni a lu ado, ena ali isumha ali ichi ali amọku ni ichi ẹẹ tsua, li shi ẹgbọ ni e khi ighumha.",{"noteId":127}]},{"type":"verse","number":14,"content":["“Eni eduoki e ya liẹ ọli, ‘Imọmhi ni u ri ukpẹloe shi ekẹ ẹ khẹ, o she mẹ na. Ẹpfue ali ọsuemhẹ eyẹ nya e she kele-a, ni a ke dobẹ gbolo mẹ ya mie.’"]},{"type":"verse","number":15,"content":["Eduoki ni e ri emhi enana dẹ ni e mẹ elele ẹpfue rọte obọ oyi ọni ọkpotso, e ya migha tapfia, ulishi osoli ni ọ mẹ ọọ mu wẹ. E ya viẹ e viẹ oya,",{"noteId":128}]},{"type":"verse","number":16,"content":["e viẹ nyogho, ee liẹ,",{"text":"“ ‘Eekhue-o! Eekhue-o,","poem":1},{"text":"ẹoli Onofunẹ,","poem":2},{"text":"ni a ri iwulu ichẹ eneyilẹ,","poem":1},{"text":"ni a ri igolu ali echẹ","poem":2},{"text":"ni e ghalẹ ali ifẹfẹ","poem":1},{"text":"khuẹ akhuẹ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aboriẹkhi ighọ,","poem":1},{"text":"elemhi iwakati oghuo tsẹ,","poem":2},{"text":"eni ẹpfue eniẹmhi eghọ","poem":1},{"text":"e li opfu-a.’","poem":2},{"noteId":129},"“Eni e khi ega ọkọ-okẹ oniẹmhi nya ali eni ẹ lo ọkọ-okẹ oniẹmhi ya asha ali eni ẹ gua li ali eni e rọte okẹ oniẹmhi ẹ mie ifata, e ya tapfia migha."]},{"type":"verse","number":18,"content":["Ini e mẹ ewọli eyi utomhi oyọli, e ya liẹ, ‘Ẹoli okhọghuo o la ọ ni o li abi oni ẹoli oniẹmhi?’",{"noteId":130}]},{"type":"verse","number":19,"content":["E yalọ ifufu ku ukhomhi, e ri eviẹ ali oya viẹ leghe, ee liẹ,",{"noteId":131},{"text":"“ ‘Eekhue-o! Eekhue-o,","poem":1},{"text":"yẹyẹ ẹoli oniẹmhi,","poem":2},{"text":"ni eni e mhọli","poem":1},{"text":"ọkọ-okẹ oniẹmhi nya,","poem":2},{"text":"e te mhọli ẹpfue eyẹwẹ","poem":1},{"text":"rọte ọsuemhẹ oyi oni ẹoli!","poem":2},{"text":"Elemhi iwakati oghuo tsẹ","poem":1},{"text":"a rọ pfuse ọli-a.","poem":2},{"noteId":132}]},{"type":"verse","number":20,"content":[{"text":"A ri itobọ li","poem":1},{"text":"ke ghẹlẹ, iloghie,","poem":2},{"text":"A ke ghẹlẹ,","poem":1},{"text":"ẹẹ eni a pfa na","poem":2},{"lineBreak":true},{"text":"ali ighiusomhi na kẹẹ ali emekẹguele!","poem":2},{"text":"Irari khi Ẹshinẹgba","poem":1},{"text":"ọ she gue ọli ẹzọ","poem":2},{"lineBreak":true},{"text":"shi abi ọ li nasẹ ẹ.’ ”","poem":2},{"noteId":133}]},{"type":"verse","number":21,"content":["Ighọ agẹni nọfunẹ o rue udumhi ẹchẹ ni o li abi ẹchẹ iko pfilo oni okẹ oniẹmhi, ọọ li,",{"text":"“Ekpabọ na guo","poem":1},{"text":"a rọ ya guọghọ","poem":2},{"lineBreak":true},{"text":"ẹoli iBabilọ oniẹmhi-a,","poem":2},{"text":"aa ke gbo ya","poem":1},{"text":"mẹ ẹ ẹloe ghue.","poem":2},{"noteId":134}]},{"type":"verse","number":22,"content":[{"text":"Ọgbọ ọa ke gbo ya suọ","poem":1},{"lineBreak":true},{"text":"uruli ẹfa","poem":1},{"lineBreak":true},{"text":"wẹkhi oyi emini áá kpheli","poem":1},{"lineBreak":true},{"text":"wẹkhi oyi ofele,","poem":1},{"lineBreak":true},{"text":"wẹkhi oyi akala","poem":1},{"text":"elemhi yẹyẹ oni ẹoli ona ghue.","poem":2},{"text":"Ọgbọ ọa ke ya mẹ","poem":1},{"text":"ọgbakanya ọkhọghuo","poem":2},{"lineBreak":true},{"text":"elemhi ẹ ghue.","poem":2},{"text":"Ọgbọ ọa ke ya suọ","poem":1},{"text":"okeke emini a mhẹli iko,","poem":2},{"lineBreak":true},{"text":"elemhi ẹ ghue.","poem":2},{"noteId":135}]},{"type":"verse","number":23,"content":[{"text":"Erali ákpá ọa ke gbo ya gẹ","poem":1},{"text":"elemhi ẹ ghue,","poem":2},{"text":"wẹkhi eri a ya gbo suọ","poem":1},{"text":"uruli eni ẹ zu ode","poem":2},{"lineBreak":true},{"text":"elemhi ẹ ghue.","poem":2},{"text":"Eduoki eyẹ e khi","poem":1},{"text":"ẹgbọ eni e funẹ na ekẹ agbọ,","poem":2},{"text":"u ri ogbhọ oyẹ","poem":1},{"text":"di ishishi nya wasẹ-a.","poem":2},{"noteId":136}]},{"type":"verse","number":24,"content":[{"text":"Elemhi oni ẹoli a mẹ","poem":1},{"text":"ọlia eyi emekẹguele","poem":2},{"lineBreak":true},{"text":"ali eyi eni a pfa na,","poem":2},{"lineBreak":true},{"text":"ali eni a gboloa shi ekẹ agbọ nya.”","poem":2},{"noteId":137}]}],"footnotes":[{"noteId":119,"caller":"+","text":"Li zẹ Aza 13.21; 21.9; iJere 50.39; 51.8; Irọ 14.8","reference":{"chapter":18,"verse":2}},{"noteId":120,"caller":"+","text":"Li zẹ Aza 23.17; iJere 51.7","reference":{"chapter":18,"verse":3}},{"noteId":121,"caller":"+","text":"Li zẹ Aza 48.20; iJere 50.8; 51.6,45","reference":{"chapter":18,"verse":4}},{"noteId":122,"caller":"+","text":"Li zẹ Igbae 18.20-21; iJere 51.9","reference":{"chapter":18,"verse":5}},{"noteId":123,"caller":"+","text":"Li zẹ Iwolo 137.8; iJere 50.29","reference":{"chapter":18,"verse":6}},{"noteId":124,"caller":"+","text":"Li zẹ Aza 47.7-9","reference":{"chapter":18,"verse":8}},{"noteId":125,"caller":"+","text":"Li zẹ Ezik 26.16-