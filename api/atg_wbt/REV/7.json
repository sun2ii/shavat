{"translation":{"id":"atg_wbt","name":"Ebe-No-Pfuasẹ Ishobọ Onogbọ","website":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=atgNT","licenseNotes":null,"shortName":"WBT","englishName":"Ivbie North-Okpela-Arhe NT","language":"atg","textDirection":"ltr","sha256":"83221f9f7633c093e6bc4a684fb251cab2f80436e15f5a1ac40fca75c2092dd8","availableFormats":["json"],"listOfBooksApiLink":"/api/atg_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7949,"languageName":"Ivbie North-Okpela-Arhe","languageEnglishName":"Ivbie North-Okpela-Arhe"},"book":{"id":"REV","translationId":"atg_wbt","name":"Irọkhasẹ","commonName":"Irọkhasẹ","title":"Irọkhasẹ Ni iJọni ọ kẹkẹ","order":66,"numberOfChapters":22,"sha256":"9cf94cb4f4c5c5fb73e83739320c4c982f9be903c10296bce8318e829f5525cb","firstChapterNumber":1,"firstChapterApiLink":"/api/atg_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/atg_wbt/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"heading","content":["Ẹgbọ agbẹlẹ egbhuẹshilua ali ene (144,000) ni a shi ọlẹlẹ"]},{"type":"verse","number":1,"content":["Ona o dọsẹ sẹ, mhi ke gbo mẹ khi igẹni aane e migha iguabọ enenene na ekẹ agbọ. E mu akpekpeli enenene na iguabọ ekẹ agbọ gba ini akpekpeli o khi ke li ekẹ agbọ, wẹẹ ukhomhi okẹ oniẹmhi wẹẹ ẹẹra.",{"noteId":45}]},{"type":"verse","number":2,"content":["Ighọ mhi kẹ mẹ agẹni ọlese khi ọ rọte obini ovọ o te ẹ ngale lasele, ọ tsua akhuli ni a rọ ọ shi emhi ọlẹlẹ oyi Ẹshinẹgba ni ọ la agbọ. Ọ ri uruli na leghe lu eni igẹni aane eghọ ni a ri ekpabọ na ni e rọ yese ekẹ ali okẹ oniẹmhi-a."]},{"type":"verse","number":3,"content":["Ọọ wẹ, “A khi yese ekẹ-a wẹẹ okẹ oniẹmhi wẹẹ ẹẹra, sẹ khi awa shi ọlẹlẹ shi eni ẹẹ ga eyi Ẹshinẹgba alukpo se.”",{"noteId":46}]},{"type":"verse","number":4,"content":["Ighọ mhi suọ khi eni a rọte elemhi ẹdẹli eyi iZirẹni nya shi ọlẹlẹ, e ya khi ẹgbọ agbẹlẹ egbhuẹshilua ali ene (144,000)."]},{"type":"verse","number":5,"content":[{"text":"A rọte unuẹkpẹ oyi iJuda,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iRubẹni,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iGadi,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi Asha,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iNafutali,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iManasẹ,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iSamọ,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iLiva,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iSaka,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iZebulọ,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iJosẹfu,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000).","poem":1},{"lineBreak":true},{"text":"A rọte unuẹkpẹ oyi iBẹjami,","poem":1},{"lineBreak":true},{"text":"shi ọlẹlẹ shi ẹgbọ","poem":1},{"lineBreak":true},{"text":"agbẹlẹ igbẹva egbe (12,000.)","poem":1}]},{"type":"verse","number":9,"content":["Ona o dọsẹ se, mhi bino, ghe ebubu ẹgbọ ni ọgbọkhọghuo ọa dobẹ ya leli khẹ! Ishishi khi ishishi ali unuẹkpẹ nya ali ẹgbọ ali ẹmuẹ ọdọda e te bhale. Ighọ e migha odalo oyi oni ukpẹkhomhi oghie, e migha odalo oyi ọni Omi Osumha, e sọnọ itsua epfopfo, e muno eyamhi mhọli abọ."]},{"type":"verse","number":10,"content":["E tsẹsẹ leghe, e liẹ.",{"text":"“Ẹshinẹgba ọni ọ shitọ","poem":1},{"text":"oni ukpẹkhomhi oghie,","poem":2},{"text":"Ọ mhọli ekpabọ","poem":1},{"text":"ni ọ rọ mie ẹgbọ eyọli pfuese,","poem":2},{"text":"ighọ li khi ọni Omi Osumha.”","poem":1}]},{"type":"verse","number":11,"content":["Igẹni nya e migha gasẹ ọni ukpẹkhomhi oghie, ali eni egbhali ali elamhakọ aane e de ta alo mu ekẹ odalo oni ukpẹkhomhi oghie e ga Ẹshinẹgba."]},{"type":"verse","number":12,"content":["E liẹ,",{"text":"“Atsẹ!","poem":1},{"text":"Ikuẹghiẹ ali ufumhi,","poem":2},{"text":"ali ẹgbhẹ ali","poem":1},{"text":"ikphẹmhi ali ekpẹ,","poem":2},{"text":"ali ekpabọ ali itoto,","poem":1},{"text":"e khi eyi Ẹshinẹgba ọyawa,","poem":2},{"text":"ẹlẹ na agbọagbọ.","poem":1},{"text":"Atsẹ!”","poem":2}]},{"type":"verse","number":13,"content":["Ighọ ọgbhali ọghuo elemhi wẹ ọ nu mhẹ ngme ọ mhẹ, “Eghuo eghọ e khi ni e sọnọ itsua epfopfo? U lẹsẹ obini e tẹ bhale?”"]},{"type":"verse","number":14,"content":["Mhiẹ ọli, “Ọga, yẹyẹ u ya lẹsẹ.”",{"noteId":47},"Ọọ mhẹ, “Ena e khi eni e pfue oni ukpokpomhi ajilimhẹ, e she pfuẹ itsua eyẹwẹ-a, e ri ọlia eyi ọni Omi Osumha rẹwẹ pfuasẹ."]},{"type":"verse","number":15,"content":["Irarighọ,",{"text":"“E rọ migha odalo","poem":1},{"lineBreak":true},{"text":"ukpẹkhomhi oghie","poem":1},{"lineBreak":true},{"text":"oyi Ẹshinẹgba.","poem":1},{"text":"Ni e la","poem":2},{"text":"elemhi Owa oyi Ẹshinẹgba oyọli","poem":1},{"text":"ke ga li ẹlẹ ọguota ali ẹliyọsẹ.","poem":2},{"text":"Ọni ọ shitọ oni","poem":1},{"lineBreak":true},{"text":"ukpẹkhomhi oghie oyọli,","poem":1},{"lineBreak":true},{"text":"ọ ya ri okholo oyọli","poem":1},{"text":"khukhu wẹ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Okiamhi ọa ke","poem":1},{"text":"gbo ya gbe wẹ ghue,","poem":2},{"lineBreak":true},{"text":"wẹkhi okiamẹ o kẹ ya gbe wẹ ghue.","poem":2},{"text":"A ya khukhu wẹ ovọ ererẹ,","poem":1},{"text":"ọa kẹ tosẹ wẹ ghue.","poem":2},{"noteId":48}]},{"type":"verse","number":17,"content":[{"text":"Irari khi ọni Omi Osumha","poem":1},{"lineBreak":true},{"text":"ni ọ migha odalo oni","poem":1},{"text":"ukpẹkhomhi oghie,","poem":2},{"text":"ọ ya ri ẹloe ke khu wẹ.","poem":1},{"text":"O rẹwẹ je okẹ amẹ","poem":2},{"lineBreak":true},{"text":"ni o ri agbọ a na ọgbọ.","poem":2},{"text":"Ẹshinẹgba ọ ya shishi wẹ ameviẹ alo-a.”","poem":1},{"noteId":49}]}],"footnotes":[{"noteId":45,"caller":"+","text":"Li zẹ iJere 49.36; iDan 7.2; iZaka 6.5","reference":{"chapter":7,"verse":1}},{"noteId":46,"caller":"+","text":"Li zẹ Ezik 9.4,6","reference":{"chapter":7,"verse":3}},{"noteId":47,"caller":"+","text":"Li zẹ iDan 12.1; iMat 24.21; iMak 13.19","reference":{"chapter":7,"verse":14}},{"noteId":48,"caller":"+","text":"Li zẹ Aza 49.10","reference":{"chapter":7,"verse":16}},{"noteId":49,"caller":"+","text":"Li zẹ Iwolo 23.1; Ezik 34.23; Iwolo 23.2; Aza 49.10; 25.8","reference":{"chapter":7,"verse":17}}]},"thisChapterLink":"/api/atg_wbt/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/atg_wbt/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/atg_wbt/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}