{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ECC","translationId":"aui_wbt","name":"Ekalesiyestis","commonName":"Ekalesiyestis","title":"Ekalesiyestis","order":21,"numberOfChapters":9,"sha256":"da349c37761aeca00206560d86b7c3eb9e755880ccc71ae6fee5330ab0a04cf0","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/aui_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":4,"content":[{"type":"verse","number":9,"content":[{"text":"Wawaya tanaduma yamakamake na wasina,","poem":1},{"text":"bi gegha da wawaya bata sinamakena inamiise kirakii.","poem":2},{"lineBreak":true},{"text":"Toudi yadi bagibagiye siniwiitakabivivirana da miisena sinabanani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Memeda toudi, tana inabeku,","poem":1},{"text":"na tana inageghomiiri da kwiinana iniwiiteni.","poem":2},{"text":"Bi meboda wawaya tana makedumana bi inabeku na noko ibero kirakii,","poem":1},{"text":"basuna getana iiyabo nama da iniwiitenina.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mayimayiyina, wawaya bata sinikena rereghana na sinidi sinamuyamuya,","poem":1},{"text":"bi wawaya tanagha na metagha tanaduma bi sinina inamuyamuya?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rubana aviya wawaya inagogona wawaya tanaduma makamakena biidi na inageeiwayi,","poem":1},{"text":"bi wawaya bata na sinimiiri kubukubutana na aviyina sinageebodeni.","poem":2},{"text":"Wawaya yadi aroba na parapa maragata ghamana ware kwaro, urawa yadi arobama sametanina naboni.","poem":1},{"text":"Tam gerubana noko kwarona kunayaragha yaininenina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":4}