bero kirakiina kubura debane akita na mmko:","poem":1},{"text":"Wawaya tana iiyabo inamoura kirakii,","poem":2},{"text":"bi memeda inakabitawani tounamani kiravine,","poem":1},{"text":"na mourina inageghomiiri wawayina inakasiwiibero.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Meboda wawaya tana yana mane wiigimogimone itore,","poem":1},{"text":"bi gegha, yikuwamira da yabero na noko manena yiwapeni.","poem":2},{"text":"Wasina bi raghanina inarabobo,","poem":1},{"text":"na natunatuna kate gegha ere yadi manena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Noko naboni touda ighanidagha tatubugha,","poem":1},{"text":"getana mane bo sawara,","poem":2},{"text":"bi raghanina tanarabobo, na mmko kuburina tanakuyoveni,","poem":1},{"text":"na kate getana awaki tanakawarina.","poem":2},{"text":"Touda yada bagibagi tupadi kiiravidiye na","poem":1},{"text":"getana miisana imadae tanakawarina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":6}