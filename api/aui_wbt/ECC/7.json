{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ECC","translationId":"aui_wbt","name":"Ekalesiyestis","commonName":"Ekalesiyestis","title":"Ekalesiyestis","order":21,"numberOfChapters":9,"sha256":"da349c37761aeca00206560d86b7c3eb9e755880ccc71ae6fee5330ab0a04cf0","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/aui_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":7,"content":[{"type":"heading","content":["Yawa kana nuwagiura"]},{"type":"verse","number":15,"content":["Yagu yawa na basuna gegha, bi gegha da kamone na sawara tupadi akita:",{"text":"Rotomana wawayidi na God yana gwara sakivikivini bi gegha da saraborabobo,","poem":1},{"text":"bi berabero wawayidi na God yana gwara gesiyakivikivinina bi gegha da samake da raghani gurina.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Noko biidi gekonanoghosi da tami parapa rotomanimi,","poem":1},{"text":"Bi gekoniyaba da tami yami nuwagiura parapa miisedi.","poem":2},{"lineBreak":true},{"text":"Da kowiiwiini tamimani konirabobo mayemi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gegha konabera da tami bero kirakiimina,","poem":1},{"text":"gekonabera da parapa wawaya kawakeekeedi.","poem":2},{"text":"Metagha, kowiiwiini da konarabobo yaninagha,","poem":1},{"text":"muriye da gabudara waghata inakabi?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Augunai da bera miisena na meboda mmkodi wonawiikatagha konakabitawana:","poem":1},{"lineBreak":true},{"text":"Wawaya iiyabo God yakabikabikarawayeni,","poem":1},{"text":"na mmkodi keda berodi yadi bata gwabidima inamiiritaveyana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nuwagiura yabera da wawaya tana yimaragata kirakii,","poem":1},{"text":"geware kiikiiwawo yadi 10 kwanatu tanagha kamone sibadana naboni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Getana wawaya nama mmko kuburina debane iiyabo nonowa bera rotomanidi yaberabera,","poem":1},{"text":"da tamumu geiyaberaberana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}