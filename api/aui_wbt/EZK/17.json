{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"EZK","translationId":"aui_wbt","name":"Igikel","commonName":"Igikel","title":"Igikel","order":26,"numberOfChapters":7,"sha256":"7591970f424f0e06e167d7b60c269d0e81e55e991621b88e4dac11b5fca0fc92","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/EZK/1.json","lastChapterNumber":37,"lastChapterApiLink":"/api/aui_wbt/EZK/37.json","totalNumberOfVerses":42},"chapter":{"number":17,"content":[{"type":"heading","content":["Yawe God ivimiiba da yana wawaya iniwouwamiredi"]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mmko na metagha Yawe God iwona,","poem":1},{"text":"“Tagu wosina ragharagha karapumkina anakabi, kii kana waghawagha sida,","poem":2},{"lineBreak":true},{"text":"bi kiina gekirakiina debane Tagu numonumona anakiyapiini da koya gekirakiina debane anawavi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nama noko koyana debane Isrel kubura kamone inagogo inagae","poem":1},{"text":"patana da sidana inikii kiitowana da waratetena,","poem":2},{"lineBreak":true},{"text":"bi inaruragharagha da inuwagha.","poem":2},{"text":"Manu kadi kita bogaebogae nama ragharaghane sinakema","poem":1},{"text":"da rogune sinikiirogu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bi kii tupadi kubura debane sinakovi da Tagu na Yawe God.","poem":1},{"lineBreak":true},{"text":"Kii guridi atarayidi sayowogha","poem":1},{"text":"bi kii gisigisidi aberadi da sagogo da saguri.","poem":2},{"text":"Kii matayidi abera da sarabobo,","poem":1},{"text":"bi kii raborabobodi aberadi da sayawa.","poem":2},{"text":"Tagu Yawe God avisisiya, Tagu anabera.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/EZK/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/EZK/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/EZK/2.json","previousChapterAudioLinks":{},"numberOfVerses":3}