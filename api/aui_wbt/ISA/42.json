{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ISA","translationId":"aui_wbt","name":"Aisaiya","commonName":"Aisaiya","title":"Aisaiya","order":23,"numberOfChapters":19,"sha256":"702952dbbd8c12e6983c84bd5d4d3a93457bd6c7d09da8a72a74ef1fedd031a1","firstChapterNumber":2,"firstChapterApiLink":"/api/aui_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/aui_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":42,"content":[{"type":"heading","content":["Yawe God yana wiivinevinegha tamariyina"]},{"type":"verse","number":1,"content":[{"text":"Yawe God iwona bo, “Kokita, yagu tamariyana, iiyabo akabiwiimaragasina,","poem":1},{"text":"Tagu avineyi bi iinuwamiise touna biidi.","poem":2},{"text":"Bi kanumigu touna debane atore,","poem":1},{"text":"na keda rotomanine initupawamiwamira wiimasi,","poem":2},{"text":"wawaya tupadi kiiravidiye kubura debane,","poem":1},{"text":"da inapiikedi God yana wiibadana rogune.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Touna geinarukwatu bo gamona inarukabepina,","poem":1},{"text":"gegha kedae inisisiya gwaruna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sawasawa reina kiina tuwayowanina gerubana inaturagiinina,","poem":1},{"text":"bo rampa vikina pepana nuwatepane karakarasina gerubana inuvenawiipekina.","poem":2},{"text":"Touna keda rotomanine initupawamiwamira wiimasi","poem":1},{"text":"bi nuwayuyune kayowiiyayeyana inapiikeni wawaya tupadi biidi kubura debane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Touna geinakabibeku bo inanagharana,","poem":1},{"text":"patana da kayowiiyayeyana kubura debane","poem":2},{"text":"inatoura wiikayokayowana inakovi.","poem":1},{"text":"Wawaya kubura rabarabae","poem":2},{"lineBreak":true},{"text":"patana yana wiiyeveveyana sinakoyayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tagu, Yawe God, yagu miisenama na akwatuvem,","poem":1},{"text":"imam anakabitawani","poem":2},{"text":"da anitara babaranem.","poem":1},{"text":"Anaberam da ware wiiwaghasina maragasina naboni wawaya biiyadi","poem":2},{"lineBreak":true},{"text":"bi kate yeghana kubuna damdi kiiravidiye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tam wawaya mata potapotadi matadi","poem":1},{"text":"kuna kimotaatara,","poem":2},{"text":"bi biwakabikabi damdi biwa gawarinama","poem":1},{"text":"kunikanibuvedi,","poem":2},{"text":"bi iiyawogha biwa gawaridi wiididibaridiye makamakedi,","poem":1},{"text":"na tam kuniyawiidi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":6}