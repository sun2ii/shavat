{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ISA","translationId":"aui_wbt","name":"Aisaiya","commonName":"Aisaiya","title":"Aisaiya","order":23,"numberOfChapters":19,"sha256":"702952dbbd8c12e6983c84bd5d4d3a93457bd6c7d09da8a72a74ef1fedd031a1","firstChapterNumber":2,"firstChapterApiLink":"/api/aui_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/aui_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":50,"content":[{"type":"heading","content":["Yawe God yana tamariyana kabikabisisirina"]},{"type":"verse","number":4,"content":[{"text":"Yawe God iviyevevegu da metagha anisisiya,","poem":1},{"text":"da tagu wawaya amameyanidi anawonawiitoratoradi.","poem":2},{"text":"Didibara patepatena na yakasiwiimatakigu,","poem":1},{"text":"bi tainagu yakimobubu","poem":2},{"lineBreak":true},{"text":"da awaki iniyevevegu na anawaiyanedi ware giruma ededa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe God tainagu ikimobubu","poem":1},{"text":"na geayiaviyeni bo ayamiiri kubutenina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tagu kubukiigu avereyana da wawaya sirouvi,","poem":1},{"text":"bi nawanawagu avereyana da kagu mudukoro sitayinaraguragu.","poem":2},{"text":"Bi raghanina siyiinamayegu da siyakanukanugu,","poem":1},{"text":"na mayiyigu geayikowoyina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bi gegha da Yawe God iviwiitegu","poem":1},{"text":"na gesinakitayowoyeguna.","poem":2},{"text":"Noko biidi tagu iitepatora,","poem":1},{"text":"bi akovi da yagu kabikwarakwara sinimayagha geinavereguna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"God na ririguve bi iwonayaragha","poem":1},{"text":"da tagu getana awaki ayabera berona.","poem":2},{"text":"Iiyabo teya kanikawakereyana?","poem":1},{"text":"Piika, tani sisiya patapata.","poem":2},{"text":"Iiyabo yiwawugu?","poem":1},{"text":"Touna iyamiiririya da yana wiiwawu iyawonegu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kita, Yawe God na yagu nawae da yiwiitegu;","poem":1},{"text":"Iiyabo inawona da tagu bera berona abera?","poem":2},{"text":"Kagu wiiwawu wawayidi tupadi na sinamomogha","poem":1},{"text":"ware gara katamanidi beba sakamna naboni.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":6}