{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ISA","translationId":"aui_wbt","name":"Aisaiya","commonName":"Aisaiya","title":"Aisaiya","order":23,"numberOfChapters":19,"sha256":"702952dbbd8c12e6983c84bd5d4d3a93457bd6c7d09da8a72a74ef1fedd031a1","firstChapterNumber":2,"firstChapterApiLink":"/api/aui_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/aui_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":52,"content":[{"type":"verse","number":7,"content":[{"text":"Sawariyonayona tana koya nawanakinama","poem":1},{"text":"wara miisena ikabiyapiipiika,","poem":2},{"text":"na touna kayena waratete wosina,","poem":1},{"text":"basuna warana yapiipiikeni na nuwaruriri","poem":2},{"text":"da metagha God wawaya iniyawiidina kiiravidiye.","poem":1},{"text":"Bi Zaiyon iwoneni bo, “Yami God ivikiiwawo!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuwaiyana, wawaya iiyawogha yam kwanatu sakighukighu na sarurukwatu;","poem":1},{"text":"bi toudimani matadima sikita da","poem":2},{"text":"Yawe God yaveraveramagha Zaiyonma,","poem":1},{"text":"na nuwamiiseye sarurukwatu patapata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tami, Jerusalem kamone gawara kasikasiwiiberodi,","poem":1},{"text":"nuwamiiseye korukwatu patapata","poem":2},{"text":"basuna Yawe God yana wawaya na yawonawona wiikayokayowanedi,","poem":1},{"text":"bi yana kwanatu yabababari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yana maragata kabikabikuwayina yidebeni dam tupadi biiyadi,","poem":1},{"text":"bi wawaya tupadi kubure sinakita","poem":2},{"lineBreak":true},{"text":"da yada God, wawaya yadi tamumuma iniyawiidi.","poem":2}]},{"type":"heading","content":["Yawe God yana wiitamariyana yakabikwarakwara"]},{"type":"verse","number":13,"content":[{"text":"Kita, yagu wiitamariyana yana bagibagi inabera wiimasiyeni da yana bagibagi uwadi sinatubugha;","poem":1},{"text":"Tagu anarukabepi da wawaya tupadi inageetawanidi","poem":2},{"lineBreak":true},{"text":"bi kabi karawagha ghamana sinavereni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wawaya korotodi raghanina sikitana sikabinokeni;","poem":1},{"text":"toudi sirouvi siviberoberowaneni da mayiyina kitana ivibogae,","poem":2},{"lineBreak":true},{"text":"bi kanakita iwamiri da gegha naboni ware wawaya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Da dam tupadi ininokadi,","poem":1},{"text":"bi kiikiiwawo sinakabinokeni na kawadi sinapota gesinisisiyana.","poem":2},{"text":"Kiiravine awaki sawaridi gesiyawonedi, na sinakita,","poem":1},{"text":"bi awaki sawaridi gesiyawaiyanedi, na akovidi sinayouna.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":7}