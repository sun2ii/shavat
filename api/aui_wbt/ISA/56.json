{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ISA","translationId":"aui_wbt","name":"Aisaiya","commonName":"Aisaiya","title":"Aisaiya","order":23,"numberOfChapters":19,"sha256":"702952dbbd8c12e6983c84bd5d4d3a93457bd6c7d09da8a72a74ef1fedd031a1","firstChapterNumber":2,"firstChapterApiLink":"/api/aui_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/aui_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":56,"content":[{"type":"heading","content":["Rupari barena wawaya tupadi kiiravidiye"]},{"type":"verse","number":1,"content":["Yawe God iwona bo,",{"text":"“Tagu pinimina bi wiiyawiimi kiiravine na anaveramagha,","poem":1},{"text":"bi wawaya tupadi yagu bera rotomanidi aniyevevedi,","poem":2},{"text":"na rotomane da wiisuwone wawaya kokoyagha yaporidi","poem":1},{"text":"bi bera miisedi kobera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muriye, na kubuna damdi sinaveremayedi Tagu, Yawe God biidi","poem":1},{"text":"da yagu kayowana sinabera;","poem":2},{"text":"toudi sininuwayuyunegu bi sinakabikuwayegu.","poem":1},{"text":"Toudi yagu wiiyawiitaveyana gabudarina sinakabikarawayeni","poem":2},{"text":"bi noko gabudarina kana gwara ayavereveredi na","poem":1},{"text":"gesinikasigiiyeni da siniberona.","poem":2},{"lineBreak":true},{"text":"Bi yagu wiiwaghasina maragisina sinakabitawana kikisi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nokodi kubuna damdi anakabidi anapiika","poem":1},{"text":"yagu koya kabikabikuwayine, Jerusalem kwanatune,","poem":2},{"lineBreak":true},{"text":"bi yagu pari barene nuwamiise anaveredi.","poem":2},{"text":"Yadi suwara gabugabunidi da puyo mududi Tagu yagu suwara gabugabuna gawarina debane aniwaghasinedi,","poem":1},{"text":"basuna wawaya yagu Bare Kabikabikuwayina sinakwatuveni da pari barena dam tupadi kiiravidiye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":3}