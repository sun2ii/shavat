{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ISA","translationId":"aui_wbt","name":"Aisaiya","commonName":"Aisaiya","title":"Aisaiya","order":23,"numberOfChapters":19,"sha256":"702952dbbd8c12e6983c84bd5d4d3a93457bd6c7d09da8a72a74ef1fedd031a1","firstChapterNumber":2,"firstChapterApiLink":"/api/aui_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/aui_wbt/ISA/64.json","totalNumberOfVerses":130},"chapter":{"number":9,"content":[{"type":"heading","content":["Raghani murina kiiwawona"]},{"type":"verse","number":1,"content":["Wawaya iiyawogha siyiinuwapoya na gewiididibare sinamakena. Naghove Zebulan kubure da Neptalai kubure na wawaya wiikayotaketowane siyamakamake, bi gegha raghani muriye na nokodi kubura kabikarawagha sinakabi - keda ghamana Mediteriyen Yegii ririnagha, bi kubura Jodan rarimina nawane da kate bada Galili kubure meme dam bi dam sipiika samakamakena."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wawaya wiididibare sapeepewa","poem":1},{"text":"na yeghana matakonakonana sikita;","poem":2},{"text":"bi iiyawogha wiididibara ghamane samakamake,","poem":1},{"text":"na yeghana irukarata debadiye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bada, dam Isrel kubera da sikoroto kirakii,","poem":1},{"text":"tam nuwasisira ghamana kuveredi.","poem":2},{"text":"Awaki kiiravidiye kubera na iberadi da sinuwamiise kirakii,","poem":1},{"text":"kedana mayimayiyina ware wawaya kabipura raghanine sinuwamiisena naboni,","poem":2},{"lineBreak":true},{"text":"bi kedana mayimayiyina ware wiiruwa tomotomogha nuwamiise kiiravine sarurukwatu na naboni","poem":2},{"lineBreak":true},{"text":"raghanina kadiaviya gwabidima yapi sawaridi sikawara bi sareereghana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Simira kiiravidae itubugha, Yawe God natutomogha ivereda.","poem":1},{"text":"Touna maragata inakabi da inibadeda.","poem":2},{"text":"Bi wawaya sinakwatuveni da:","poem":1},{"text":"“Wiiyoyowana Verevereyana Waratetena,”","poem":2},{"text":"“God Maragata Kirakiina,”","poem":1},{"text":"“Tamada Makewaghawaghasina,”","poem":2},{"lineBreak":true},{"text":"“Nuwaruriri Badana.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yana wiibada da nuwaruriri inapiikeni na","poem":1},{"text":"inatuwa wiikarukaru da geere damonana.","poem":2},{"text":"Touna kiiwawo Deivid kana gaware inikiiwawo,","poem":1},{"text":"da kubura tupana inibadeni,","poem":2},{"text":"inabera da inimaragata bi wawaya rotomane inakoyayidi da wiisuwona teya,","poem":1},{"text":"kata da inanagho wiikarukaru waghata.","poem":2},{"text":"Yawe God Maragata Kirakiina mmko inabera","poem":1},{"text":"basuna yana nuwayuyuna wawaya biiyadi na iragata kirakii.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":5}