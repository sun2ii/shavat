{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"JER","translationId":"aui_wbt","name":"Jerimaiya","commonName":"Jerimaiya","title":"Jerimaiya","order":24,"numberOfChapters":8,"sha256":"52d059078c6913c45471b4206e339903eba05b42d1bcb8105fd0434110dd78a7","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/aui_wbt/JER/38.json","totalNumberOfVerses":45},"chapter":{"number":6,"content":[{"type":"verse","number":13,"content":[{"text":"“Yagu wawaya tupadi, moyamoyakidi bi moumouridi na wawaya nuwabanigovidi,","poem":1},{"text":"toudi wawaya siyabedi bi mane sayouna toudimani kiiravidiye.","poem":2},{"text":"Bi kate peroperoveta da prist na bada naboni,","poem":1},{"text":"Toudi tupadi na wiiwiiyabidi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yagu wawaya na kadi gubaga ghamana, bi peroperoveta da prist siyabera da siyabunami,","poem":1},{"text":"bi gegha, sabera da ware tupakwari gisina naboni.","poem":2},{"text":"Na sawona bo, ‘Sawara tupana na wasina,’","poem":1},{"text":"Bi gegha da noko gewaghasina!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/JER/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":2}