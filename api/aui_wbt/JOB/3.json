{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"JOB","translationId":"aui_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"df2be6c4a55a8a7d29b244268085880c06b4ea61a0378566a440811fd2fd05d9","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/aui_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":3,"content":[{"type":"heading","content":["Job yana sisiya dagudaguna"]},{"type":"verse","number":1,"content":["Noko taparorone raghanine getana iiyabo iyisisiya bi murine, na Job ikararupama da ere ghakighakina sinananaki ivitubuyina gabudarina ivisisiya beroveni."]},{"type":"verse","number":2,"content":["Iwona bo,"]},{"type":"verse","number":3,"content":[{"text":"“O God, sinagunaki ivitubuyigu na gabudarina kasunaghataveni","poem":1},{"text":"da kate nubabasune siwona bo,","poem":2},{"text":"‘Tomogha itubugha.’","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Noko gabudarina na inididibari!","poem":1},{"text":"God kiidamove kate geininoyenina,","poem":2},{"lineBreak":true},{"text":"da yeghana kate geinarukarata debanena.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wiididibara ghamana noko gabudarina inibonuvi;","poem":1},{"text":"Uwa wowonagha inasowo mumu,","poem":2},{"text":"bi mmko wiididibarina inabera","poem":1},{"text":"da sinagunaki ivitubuyiguna gabudarina inanaghara kirakii.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wiididibara ghamana noko nubabasuna inakabitawani!","poem":1},{"text":"Noko nubabasuna kate geininuwamiise","poem":2},{"text":"ware gabudara mududi naboni bodu tana kamone;","poem":1},{"text":"genoko boduna kamone sinakabiyawa wiikapuna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Noko nubabasuna na inigagara,","poem":1},{"text":"getana nuwamiise rukwatudi sinawaiyana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Imapu damdi iiyawogha sakovi da metagha yegii motana ghamanakina sinakasiwiimatakina,","poem":1},{"text":"na toudi damdi mmko gabudarina sinawona imimagi.","poem":2},{"noteId":2}]},{"type":"verse","number":9,"content":[{"text":"Rubana raghani boribori kewokewona inididibari,","poem":1},{"text":"rubana da raghani yeghanina inakoyagha kawakawa","poem":2},{"lineBreak":true},{"text":"da raghani didigubana na geinakitana,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kiiravine noko wiididibarina sinagunaki raparapana matamketana geiyagudu bodenina,","poem":1},{"text":"getana piropiro gwabiguma iyikowoyidina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Iyamiise da sinagunaki kamokamone ayarabobo,","poem":1},{"text":"bo ayatubutubugha na raghanine ayarabobo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awaki kiiravine sinagunaki manonone ivikenegu?","poem":1},{"text":"Bi awaki kiiravine susunama ivisusugu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Memeda yagu tubugha raghanine ayarabobo, na tagu ayakenayowogha, ayiraborabobo;","poem":1},{"text":"Augunai da tagu ayakenakena, bi nuwaruririye ayiiyawiitaveyana.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Wawaya waragututu sivisisiyana na noko mota ghamanakina yegii kamone iyamakamake kiiravine. Kana waghawagha Leviatan. Wawaya sinoghosi da sinakasiwiimataki na inageghomiiri da nuwapoya bo piropiro initubutubugha.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/aui_wbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":13}