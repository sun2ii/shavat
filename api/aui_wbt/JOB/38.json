{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"JOB","translationId":"aui_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"df2be6c4a55a8a7d29b244268085880c06b4ea61a0378566a440811fd2fd05d9","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/aui_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":38,"content":[{"type":"heading","content":["Yawe, Job iwonabodeni"]},{"type":"verse","number":1,"content":["Wasina bi Yawe God yanunu virovirogha kamonama Job iwonabodeni bo,"]},{"type":"verse","number":2,"content":[{"text":"“Metagha, bi yam sisiya kwabudima","poem":1},{"text":"yagu nuwagiura kiiravine kwiitarakiiyana?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabunagha da tomogha naboni bagibagi ghamana kiiravine;","poem":1},{"text":"Basuna gwabiguve na wiitarakiiyana viya tam kiiravimve,","poem":2},{"lineBreak":true},{"text":"da kunawonabodeyana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Raghanina kubura kayena ayaberabera, na tam meme barasina?","poem":1},{"text":"Mmko kunakovi na kuwonegu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwakovi bo gegha da iiyabo kana ruba inuwagiureni?","poem":1},{"text":"Bi iiyabo imana irutatari da irubani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kayena awaki debane ivitukikita,","poem":1},{"text":"bo iiyabo papasusu koghorina ikabiwiimiiri,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"noko raghanine, na raghani boribori kewokewodi tupadi sitawora patapata","poem":1},{"text":"bi aneyaneya tupadi nuwamiise kiiravine sirukwatu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iiyabo matamketa itoredi da yegii iyamiiri babareni","poem":1},{"text":"raghanina raparapama ivikwata ikanibuna?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":8}