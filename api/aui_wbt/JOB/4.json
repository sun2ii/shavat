{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"JOB","translationId":"aui_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"df2be6c4a55a8a7d29b244268085880c06b4ea61a0378566a440811fd2fd05d9","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/aui_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":4,"content":[{"type":"heading","content":["Elipas ivisisiya Job biidi"]},{"type":"verse","number":1,"content":["Wasina bi Teman tomogha Elipas iwonabodeyana bo,"]},{"type":"verse","number":2,"content":[{"text":"“Meboda animatipo da wiisisiya biidi,","poem":1},{"text":"na nuwanuwam inapughu bo gegha?","poem":3},{"text":"Basuna gerubana da mmko raghanine anikawapotapota makena.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wasina tam raghani katamanidiye wawaya korotodi kuviyevevedi,","poem":1},{"text":"bi wawaya noganogadi kuviwiitedi da sivimaragata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yam sisiya na wawaya bekubekudi ikabiwiigeghomiiridi;","poem":1},{"text":"bi wawaya utukirokirorodi kuberadi da sivimaragata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bi katana piropiro ipiika tam biidi,","poem":1},{"text":"na tam gekuyitumaghanana;","poem":2},{"text":"piropirona ikabitowoyim,","poem":1},{"text":"na parapa kwanaghanaghara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Metagha, God kabepepina yam noghota yimaragasi bo gegha?","poem":1},{"text":"Bi yam makamake yawana noghota yavereverem da tam wasina bo?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mmko kunuwagiureni!","poem":1},{"text":"Da wawaya iiyawogha bera berodi gesiyaberaberana sarabobo?","poem":2},{"text":"Bo wawaya yadi makamake yawana rotomanidi,","poem":1},{"text":"God iviberodi bo gegha? Gegha!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bi yagu wiikitakitayena, wawaya iiyawogha berona sarove bi piropiro sawavi,","poem":1},{"text":"na damone mayimayiyina sinakabipura.”","poem":2},"Job turaturana patana siyawonewoneni da touna bera berodi peyaridi ibera kiiravine na kata piropiro ghamadi iyouna bi gegha da Job iyawonawona da getana bera berodi iyaberana."]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}