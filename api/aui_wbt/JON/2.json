{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"JON","translationId":"aui_wbt","name":"Jona","commonName":"Jona","title":"Jona","order":32,"numberOfChapters":4,"sha256":"8a063e2f635155fa38b188cb2034a40aaa0d36aaf5a70a5347cda10d0f0ca665","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/aui_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jona yana pari Yawe God biidi"]},{"type":"verse","number":1,"content":["Raghanina Jona patana noko ighanina kamone na Yawe yana God biidi irupari."]},{"type":"verse","number":2,"content":["Iwona bo,",{"lineBreak":true},{"text":"“O Yawe God, yagu nuwabero ghamana kamone bi tam biidi arukwatu,","poem":1},{"text":"na kuwonabodegu.","poem":2},{"text":"Bi wawaya raborabobodi yadi kubura kamonakinama wiiwiita kiiravine adou","poem":1},{"text":"na tam kuwaiyanegu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tam boga dumadumaye kuvitavenayowoyegu,","poem":1},{"text":"da ayowogha anagho dibune,","poem":2},{"text":"meme yegii yana maragata tupana ivikenaviviregu,","poem":1},{"text":"bi yam yabarata ghamanakidi tupadi na debaguve siyatamotamo gawowora.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tagu anoghosi da ware gwabimma kudarutavegu,","poem":1},{"text":"bi gegha, akovi da kate yam Bare Kabikabikuwayina anakitamayeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bi yegii isowomumugu da gerubana yawiigu ayatavenina,","poem":1},{"text":"bi boga dumaduma ivikenaviviregu,","poem":2},{"lineBreak":true},{"text":"da watawata gayamigu siviruvivireni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tagu ayori ayowogha koya kaye parapine.","poem":1},{"text":"Bi noko kuburine avibiwa kabikabi wawayina,","poem":2},{"lineBreak":true},{"text":"noko gawarine na matamketa gudu makewaghawaghasina.","poem":2},{"text":"Bi gegha da tam, Yawe yagu God kuviyawiigu,","poem":1},{"text":"da noko doguna wautapunama yawayawiigu bi kukabiwiiveramayigu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bi raghanina ayaparoparoro,","poem":1},{"text":"na Yawe God anoghosim,","poem":2},{"text":"da arupari tam biidi,","poem":1},{"text":"bi yam Bare Kabikabikuwayine kuwaiyanegu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nokodi iiyawogha god wiiwiiyaba sapeepetedi,","poem":1},{"text":"na yam nuwamonika simiiri kubuteni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bi kiiraviguve, na tam anakabepepim;","poem":1},{"text":"tagu na tam anasuwarim,","poem":2},{"lineBreak":true},{"text":"bi avisuwona da nokodi sawara ayabera tam biidi na anabera.","poem":2},{"lineBreak":true},{"text":"Yawe God, tam kawagha kuviyawiigu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Raghanina gabudara viya sikovi, na Yawe God yana sisiya bagibagine na ighana, Jona kikire tepaye iguruwiitaveni."]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}