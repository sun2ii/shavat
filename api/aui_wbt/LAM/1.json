{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"LAM","translationId":"aui_wbt","name":"Nuwapoya Ayidi","commonName":"Nuwapoya Ayidi","title":"Nuwapoya Ayidi (Lamentations)","order":25,"numberOfChapters":2,"sha256":"44f13b888937571816dd9d63654f6e9942b0425853aa2665a125d3479fbf94a9","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/LAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/aui_wbt/LAM/3.json","totalNumberOfVerses":22},"chapter":{"number":1,"content":[{"type":"heading","content":["Nuwavisi Jerusalem kamone"]},{"type":"verse","number":1,"content":[{"text":"Naghove, na wawaya korotodi Jerusalem kamone,","poem":1},{"text":"bi katana noko kwanatuna ikwebu.","poem":2},{"text":"Roro kubura debane na kwanatu tupadi kamodiye,","poem":1},{"text":"na touna kwanatu maragasina tana,","poem":2},{"text":"bi katana tanaduma ware wasike kwabukwaburina naboni.","poem":1},{"text":"Roro na touna ware kiiwawo wasikena naboni,","poem":2},{"lineBreak":true},{"text":"bi katana touna wiibagubagurana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nubabasuve na yaduu raghani,","poem":1},{"text":"matadoga mayiyinagha sitototo sayowogha.","poem":2},{"text":"Kana tomotomogha tupadi subukwari kuyoveni,","poem":1},{"text":"gerubana siniororogha mayenina.","poem":2},{"text":"Turaturana sigiyaguveni bi nuwanuwadi sipughu touna biidi","poem":1},{"text":"da katana toudi na kana aviya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aviya sigeghomiiri da Jiuda damdi siburavidi bi sikabidi sinaghotaveyana,","poem":1},{"text":"bi situpedi da yadi bagubagurana bi nuwapoya ghamadi debadiye sitoura.","poem":2},{"text":"Katana toudi dam wiibata yadi kubure samakamake,","poem":1},{"text":"bi getana gawara meme siyabanani da siyiyawiitaveyanana.","poem":2},{"text":"Kadi aviya sigeghomiiri da sirukwavinidi bi sikabitawatawanidi,","poem":1},{"text":"toudi gerubana da kadi aviya gwabidima sinaverataveyanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Keda sanono Zaiyonma na sibubu,","poem":1},{"text":"kiiravine getana iiyabo gabudara kabikabikuwayidiye","poem":2},{"text":"namagha iyanono God kabepepina kiiravine.","poem":1},{"text":"Getana iiyabo kwanatu matamketadigha iyarughurughuna,","poem":2},{"text":"bi prist ere nuwaberodi sakabikabida.","poem":1},{"text":"Wasiwasike woudi saduudu,","poem":2},{"lineBreak":true},{"text":"bi kwanatu kana wawaya tupadi kabikwarakwara ghamaghamadi sabanabanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Katana kadi aviya sigeghomiiri da sibadedi,","poem":1},{"text":"bi sawara tupadi sakayokayovedina gwabidiye.","poem":2},{"text":"Yawe God igeghomiiri da Jerusalem","poem":1},{"text":"yana tamumu peyaridi kiiravidiye na aro ivereni.","poem":2},{"text":"Aviya sigeghomiiri da natunatudi siburavidi","poem":1},{"text":"bi sikabidi sinagho kubura rabarabae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Naghove, Jerusalem na maragasina bi wiinuwakayowanina,","poem":1},{"text":"bi katana nokodi tupadi sikovi.","poem":2},{"text":"Kana babada na ware ribiribi kadi waghawagha diya","poem":1},{"noteId":0},{"text":"vitonana sirabobo","poem":1},{"text":"na kam sininoghana naboni.","poem":2},{"text":"Toudi panapana irouvidi da sinoganoga,","poem":1},{"text":"gerubana kadi aviya gwabidima sinaverataveyanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Katana Jerusalem damdi kabikwarakwara sabanabanana,","poem":1},{"text":"da yadi wiikedakeda kubura mududiye,","poem":2},{"text":"na yadi noghota yaveramagha da naghove sawara miisedi tupadi rapediye na sanoghosidi.","poem":1},{"text":"Wasina bi aviya sipiika da siburavidi,","poem":2},{"text":"bi getana iiyabo da iyiwiitedi.","poem":1},{"text":"Nokodi aviya kwanatuna sikitani,","poem":2},{"lineBreak":true},{"text":"bi raghanina siyibero na simaniveni.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Diya na ribiribi tana bi touna rei yakamkam, bi wawaya touna ribiribina sayebayebayeni iyuwa kiiravine.","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/aui_wbt/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JER/38.json","previousChapterAudioLinks":{},"numberOfVerses":7}