k":"/api/aui_wbt/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}