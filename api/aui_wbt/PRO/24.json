{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PRO","translationId":"aui_wbt","name":"Wonawiiyoyowana (Proverbs)","commonName":"Wonawiiyoyowana (Proverbs)","title":"Wonawiiyoyowana (Proverbs)","order":20,"numberOfChapters":14,"sha256":"b3a6291dabf250ecad4d2f31769946c2cd18f8adcf4f9fd2022a673456c6f164","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/aui_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tagu, tomogha kapokapoyanina yana kwabu averatupiireni,","poem":1},{"text":"bi greip kwabuna, na tomogha kawakeekeena rapene.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bi akita da dinamona iyiyodi kwabuna debane siyagogogo,","poem":1},{"text":"bi pasiporo dobodobo sisowomumuni,","poem":2},{"lineBreak":true},{"text":"da kwabuna garina akimama beraberana itamoririgha.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tagu mmkodi sawara akitadi,","poem":1},{"text":"na akowa gwabidima akabi:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Da kena pinimina, wiiyawiitaveyana gisina kabina.","poem":1},{"text":"Bi imam kunarukuma da kuniyawiitaveyana kamogha,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"bi gegha, noko raghanine kunakenakena na","poem":1},{"text":"yaininagha tam kunigiikayokayo","poem":2},{"lineBreak":true},{"text":"ware yapiyapi tomoyina ruta yawata yapiika da yam sawara tupadi yayounana naboni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":5}