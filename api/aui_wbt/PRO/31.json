{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PRO","translationId":"aui_wbt","name":"Wonawiiyoyowana (Proverbs)","commonName":"Wonawiiyoyowana (Proverbs)","title":"Wonawiiyoyowana (Proverbs)","order":20,"numberOfChapters":14,"sha256":"b3a6291dabf250ecad4d2f31769946c2cd18f8adcf4f9fd2022a673456c6f164","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/aui_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":31,"content":[{"type":"heading","content":["Gwabigwabiyana miisena"]},{"type":"verse","number":10,"content":[{"text":"Wiisuwona gwabigwabiyana dadourina,","poem":1},{"text":"na touna parapa gararaba miisena tomogha iiyabo inabanani na.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tomogha wavinena initumaghaneni,","poem":1},{"text":"na kate getana awaki inadiyanana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Touna nonowa miisena yaberabera bi geberona moghanena biidi","poem":1},{"text":"gabudara tupadi yana yawa kamone.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Touna sip ghunighunidi yayouna da bebera yabera bi","poem":1},{"text":"yinuwamiise da imanama yabagibagi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bi yana urawa yatumsesera bi yanowa,","poem":1},{"text":"da kana gara tounamani yaberabera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Touna imana yatatari moyamoyakidi yiwiitedi","poem":1},{"text":"da imana yakoghasi iiyawogha getana awaki gwabidiye na toudi biiyadi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Wasike yana bera wiigayagayaye na rubana tomogha iniyabeni,","poem":1},{"text":"bi mayiyi kepamarina na geinamake waghatana.","poem":2},{"lineBreak":true},{"text":"Bi gegha da, wasike iiyabo Yawe God yakabikabikarawayeni na kokabepepi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bi awaki ibera na kiiravine kana reregha kovereni,","poem":1},{"text":"wawaya naghodiye kokabepepi basuna sawara tupadi iberana kiiravine.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":8}