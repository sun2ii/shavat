{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PRO","translationId":"aui_wbt","name":"Wonawiiyoyowana (Proverbs)","commonName":"Wonawiiyoyowana (Proverbs)","title":"Wonawiiyoyowana (Proverbs)","order":20,"numberOfChapters":14,"sha256":"b3a6291dabf250ecad4d2f31769946c2cd18f8adcf4f9fd2022a673456c6f164","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/aui_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":5,"content":[{"type":"heading","content":["Madawara kana wiiyoyowana"]},{"type":"verse","number":8,"content":[{"text":"Madawara wasike gwabinama kumiiritaveyana!","poem":1},{"text":"Da gekunanagho yana makamake gawarina ririnena!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bi meboda kunanagho, na wawaya kate tam gesinakabikarawayemna,","poem":1},{"text":"bi sawara tupana kunavereyana da moghanena kunimiisanena mayeni,","poem":2},{"lineBreak":true},{"text":"tomogha meko geinanuwaghanemna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Wawaya awaki sawaridi tupadi yaberabera na Yawe God yakitakita,","poem":1},{"text":"bi bera miisedi bo berodi wawaya yavinevinegha na yakitakita yapoyapora.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kawakeekee damdi yadi tamumu na noko sapuru,","poem":1},{"text":"na yadi tamumu sapuruna yakonamayedi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Toudi koyagha mayeyana gwabidiye kiiravine na sarabobo.","poem":1},{"text":"Yadi kawakeekee beradi siniporadi sinanagho kadi karawage.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":5}