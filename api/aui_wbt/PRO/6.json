{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PRO","translationId":"aui_wbt","name":"Wonawiiyoyowana (Proverbs)","commonName":"Wonawiiyoyowana (Proverbs)","title":"Wonawiiyoyowana (Proverbs)","order":20,"numberOfChapters":14,"sha256":"b3a6291dabf250ecad4d2f31769946c2cd18f8adcf4f9fd2022a673456c6f164","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/aui_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":6,"content":[{"type":"heading","content":["Madawara kana wiikatagha"]},{"type":"verse","number":20,"content":[{"text":"Natugu, tamada da sinada sawara tupadi","poem":1},{"noteId":1},{"text":"siyevevem,","poem":1},{"text":"na kabisisiredi da kukivina.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yadi sisiya nuwanuwamve kutoredi da nonowa kunanoghonoghota.","poem":1},{"text":"Kubera da ware posaru kanighomve naboni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Raghanina kunapeepewa,","poem":1},{"text":"na mmkodi gwara waratetedi yam keda siniyevevem.","poem":2},{"text":"Raghanina kunakenakena,","poem":1},{"text":"na mmkodi gwara sinababarem.","poem":2},{"text":"Bi kunamataka,","poem":1},{"text":"na mmkodi gwara sinisisiya tam biidi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kiiravine gwara na kibe,","poem":1},{"text":"bi wiiyeveveyana na yeghana wiididibara kamone.","poem":2},{"lineBreak":true},{"text":"Yadi giu na rubana iniyevevem da metagha keda rotomandiye kunamakae.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Toudi madawara wasike yana kedama sinamiiri babarem","poem":1},{"text":"da kate tomogha bogae wavinena yana sisiya metemetevidima.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gegha nuwanuwam kamonama yana kepamara kunakita kirorovenina,","poem":1},{"text":"bo yana wiimatakamokamota inabera da tam inirubasimna.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Mmkona God yana gwara Mosis ivereni na yisisiyeni. Tamamnaki da sinamnaki mmkodi gwara siyiyevevem.","reference":{"chapter":6,"verse":20}}]},"thisChapterLink":"/api/aui_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}