{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PRO","translationId":"aui_wbt","name":"Wonawiiyoyowana (Proverbs)","commonName":"Wonawiiyoyowana (Proverbs)","title":"Wonawiiyoyowana (Proverbs)","order":20,"numberOfChapters":14,"sha256":"b3a6291dabf250ecad4d2f31769946c2cd18f8adcf4f9fd2022a673456c6f164","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/aui_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":9,"content":[{"type":"heading","content":["Nuwagiura da kawakeekee"]},{"type":"verse","number":1,"content":[{"text":"Nuwagiura yana bare iyoghani ware abayoghayoghana yaberana naboni;","poem":1},{"text":"touna barena kiiravine na kanakoghora yadi 7 itarakatukatuyidi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wasikena parapa ribiribi iunugha da kepo ghamanakina kiiravine ikabununayi,","poem":1},{"text":"da kana wain iwamira,","poem":2},{"lineBreak":true},{"text":"bi sawara tupadi na kiinabonabo debane itoura.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bi yana tamariyana wasiwasike idarudi sikanibu da wawaya tupadi siyiyonedi.","poem":1},{"text":"Nuwagiura kwanatu kamone gawara gekirakiina debanama iyiikwatu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"iyawonawona bo, “Iiyawogha geakakovimi","poem":1},{"text":"korughu yagu bareye,”","poem":2},{"lineBreak":true},{"text":"bi kawakeekeedi biiyadi iyawonawona bo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Kopiika, korughu yagu kam konakani,","poem":1},{"text":"bi wain meko awamirina konaniuni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kawakeekee beradi kokuyowana,","poem":1},{"text":"bi konadagu yawa miisene konamakae,","poem":2},{"lineBreak":true},{"text":"bi akowa yana keda konakivini.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}