{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":1,"content":[{"type":"heading","content":["Nuwamiise wiisuwonina"]},{"type":"verse","number":1,"content":[{"text":"Wawaya iiyawogha berabero wawayidi geyawata siyapeepewa","poem":1},{"text":"bi yadi sisiya gesiyakivikivina,","poem":2},{"lineBreak":true},{"text":"da bada gewiigeruwana damdi yadi sisiya siyawaiwaiyana raghanina God sinamayenina,","poem":2},{"text":"toudi nuwamiise wawayidi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Bi gegha da Yawe God yana wiiyeveveyana sivinuwayuyuneni,","poem":1},{"text":"na raghani nonowa gabudara da nubabasu na yana gwara sinuwanoghonoghoteni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Toudi ware kii rarima kawabarane siwawa na naboni,","poem":1},{"text":"kadi iri vinevineyina nunune suwagha","poem":2},{"lineBreak":true},{"text":"bi rugurugudi gesiyaraborabobo da siyariirighana.","poem":2},{"text":"Wawaya nokodi naboni, na awaki sabera na berana kamna yatubugha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bi berabero wawayidi na genaboni.","poem":1},{"text":"Toudi na ware rugurugu pokina naboni,","poem":2},{"lineBreak":true},{"text":"yanunu yatapitaveni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na God matane na toudi gewasina","poem":1},{"text":"raghanina wawaya initupawamiwamiredina gabudarine,","poem":2},{"lineBreak":true},{"text":"toudi kate gegha God yana wawaya yawata sinikapudina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawe God kana kivikivina yinaghovedi bi yakoyayidi,","poem":1},{"text":"bi berabero wawayidi na rabobo kedane sapeepewa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}