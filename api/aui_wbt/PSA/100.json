gha kovimiiseyeni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Basuna Yawe God na wiinuwanuwaghaneyanina;","poem":1},{"text":"yana nuwamonika na makewaghawaghasina","poem":2},{"lineBreak":true},{"text":"bi yana nuwamiise na inanowiikarukaru kimta bi kimta biiyadi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":5}