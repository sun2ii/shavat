{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":110,"content":[{"type":"heading","content":["Yawe God da yana Wiivinevinegha Kiiwawona"]},{"type":"hebrew_subtitle","content":["Mmko Psamna Deivid igirumi."]},{"type":"verse","number":1,"content":["Yawe God yagu Bada",{"noteId":1},"iwoneni bo,",{"text":"“Mma ririguve kumakekira gawara kabikabikarawayine","poem":1},{"text":"bi Tagu kam aviya anageiwayidi da yam wiibadana rogune anatoredi.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe God inabera da yam wiibadana inaragata","poem":1},{"text":"da Jerusalemma yam kanibutaveyana kamone","poem":2},{"lineBreak":true},{"text":"na tam kam aviya kunibadedi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Noko gabudarine kunanagho aviye yam maragatama wiirouwa biiyadi,","poem":1},{"text":"na yam wawaya nuwasisire sinaveremayedi sinanagho.","poem":2},{"text":"Tam na gara kabikabikuwayidi kunikote,","poem":1},{"text":"bi gabudara nununaghana yam maragata aniiwuwamiri,","poem":2},{"lineBreak":true},{"text":"ware youra didibara nununagha naboni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tagu, Yawe God wiisuwona abera na","poem":1},{"text":"gegha yagu noghota anawamirina, awona bo,","poem":2},{"text":"“Tam na kuni prist waghata","poem":1},{"text":"Melkisidek","poem":2},{"noteId":2},{"text":"yana kayenama.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Yawe God, kiiwawo na katiiyamma yamiimiiri","poem":1},{"text":"da babarem kiiravine.","poem":2},{"text":"Bi kiikiiwawo korotodi inikasunughana","poem":1},{"text":"raghanina nuwanuwana inapughuna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Touna dam tupadi aro inaveredi","poem":1},{"text":"bi yadi kubura na wawaya sirabobona tubuyidima inibonuvi.","poem":2},{"text":"Bi kiikiiwawo tupadi inageiwayidi, kubura tupane.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Touna kedae wusire rarima inaniuna","poem":1},{"text":"da gayamina inarukabepi bi iniyeveveyana da touna kana aviya igeeiwayidi.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Akowa damdi sawona da mmko God yana Wiivinevinegha Kiiwawona, Keriso kiiravine yisisiya (Matiu 22:44 kokita).","reference":{"chapter":110,"verse":1}},{"noteId":2,"caller":"+","text":"Melkisidek na yana kayena getayakovina bi touna God yana prist kiikiiwawona tana ware Isu naboni Abraham yana raghaniye.","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/aui_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":7}