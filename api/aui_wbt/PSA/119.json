iirapeneyanana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bi yam keda ananoghonoghosi;","poem":1},{"text":"yam gwara kiiravidiye na yagu wiinuwanoghonoghota kamone","poem":2},{"lineBreak":true},{"text":"nonowa ananoghonoghosidi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tagu yam gwara kiiravidiye na aninuwamiise,","poem":1},{"text":"bi wonam geaninuwawapidina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":8}