{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":139,"content":[{"type":"heading","content":["God yana nuwagiura tupana da koyagha"]},{"type":"hebrew_subtitle","content":["Mmko Psamna Deivid igirumi."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Yawe God, tam nuwanuwagu kamona kwaginigini","poem":1},{"text":"bi kwakowa kirakiiyegu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tam kwakovi da awaki raghanine amakeyowogha","poem":1},{"text":"bo ageghomiiri amiiri.","poem":2},{"text":"Bagune tam rabarabae,","poem":1},{"text":"nonowa na yagu noghota kwakakovi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tam apeepewana raghanine na kwakitakitagu","poem":1},{"text":"bo raghanina yagu bare kamone iiyawiitaveyanana.","poem":2},{"text":"Tagu sawara tupana aberabera na tam kwakakovi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yawe God, muriyeda ayisisiya na,","poem":1},{"text":"tam nada kwakovi da awaki anisisiyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tamna ware gari naboni kuvitumpipinegu,","poem":1},{"text":"bi imam debaguve kutore da yam maragatama kwabababaregu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tam akovigu kabina mma naboni na parapa iragata kirakii","poem":1},{"text":"da gerubana anakovina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tagu gerubana mebo anaverairem ananagho da gekunakitaguna?","poem":1},{"text":"Getana kubura noko naboni meme.","poem":2},{"lineBreak":true},{"text":"Meghamegha ananono na tam nonowa na nama!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Meboda anagae abame, na tam nama;","poem":1},{"text":"Bo meboda anarabobo bi sinadogugu,","poem":2},{"lineBreak":true},{"text":"na tam nama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meboda anarowoghataveyana ananagho raghani matene gabudara yageegeena kuburidiye,","poem":1},{"text":"bo meboda ananagho raghani didine gabudara yayoyona kuburidiye make biidi","poem":2}]},{"type":"verse","number":10,"content":[{"text":"na tam imam maragasina ininaghovegu,","poem":1},{"text":"bi katiiyam inababaregu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tagu meboda wiididibara ayawoneni da iyikowoyigu","poem":1},{"text":"bo yeghana ivitumpipinegu na iyididibara magha","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bi gegha da bagune wiididibara kamone,","poem":1},{"text":"tagu gerubana anakowoyemna.","poem":2},{"text":"Tam biidi wiididibara na parapa yeghanina ware gabudara.","poem":1},{"text":"Wiididibara da yeghana tam biidi na mayimayiyidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tam tubuyigu kamona torerereyidi, nuwanuwa da gayama kubera","poem":1},{"text":"bi sinagunaki raparapane kuvikiikiigu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bi kubera wiimasiyegu kiiravine na iikiikiivem;","poem":1},{"text":"bagibagi tupadi kwaberabera na waratetedi.","poem":2},{"lineBreak":true},{"text":"Tagu nuwanuwagu tupanama akovi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Raghanina irikegu kubera, bi sinagunaki raparapane kutoura yapoyapora,","poem":1},{"text":"bi name wiikowoye ayaragaragata na tam kwakovi da tagu nama.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muriye da ayatubugha na tam kukitagu.","poem":1},{"lineBreak":true},{"text":"Na yagu make yawana gabudaridi kuveregu da anamake,","poem":1},{"text":"na yam buka kamone kugiruma.","poem":2},{"lineBreak":true},{"text":"Muriye da gabudara dagudaguna iyadagu,","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"O God ipiropiro kirakii da tagu yam noghota parapa anakovidi","poem":1},{"text":"basuna toudi sipeyara kirakii!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tagu gerubagu da anakabiyavidina","poem":1},{"text":"basuna toudi parapa sipeyara,","poem":2},{"lineBreak":true},{"text":"gekikira eghana naboni!","poem":2},{"text":"Bi tupadi kabiyawa kovidina na,","poem":1},{"text":"augunai da ayamakewaghata tam naboni!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"God, tagu parapa akayokayoveni da berabero wawayidi kunikasunughana!","poem":1},{"text":"Kasukasunugha wawayidi gwabiguma kurukwavina tavetaveyana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Toudi sisiya berodima sigiboyim;","poem":1},{"text":"bi kam waghawagha gesiyakabikabi karawayenina.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O Yawe God, tagu iiyawogha sasinighiiyem na asinighiiyedi,","poem":1},{"text":"da iiyawogha gesiyakabikabi sisiremna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Getana awaki, da nuwapughuma iisinighiighiiyedi,","poem":1},{"text":"na toudi kagu aviya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"O God, kita rughuwona da nuwanuwagu kunakita","poem":1},{"text":"bi kuruyaghagu da yagu noghota kunakovi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bi meboda berabero wawayidi yadi kedagha ananono na kiyevevegu,","poem":1},{"text":"bi yawa makewaghawaghasina kedane kinaghovegu anapiika tam biidi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":24}