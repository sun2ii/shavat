ip yitarababaranedi bi yakoyakoyayidina naboni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kagu aviya matadiye bi","poem":1},{"text":"tam kepo kiiraviguve kwakabunayi.","poem":2},{"text":"Tam oil gayamiguve kwiiwayi","poem":1},{"text":"da wiiyeveveyana tam kwakabikabi karawayegu.","poem":2},{"text":"Yagu niniuna reduna kwiibonuvi yakamiviwayi","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akovi da tam kuninuwayuyunegu","poem":1},{"text":"bi miisena kunabera tagu biidi","poem":2},{"text":"patana da anarabobo","poem":1},{"text":"da Yawe God yana bareye anamake waghata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":6}