{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":27,"content":[{"type":"heading","content":["Kabepepa Parina"]},{"type":"hebrew_subtitle","content":["Ayina Deivid igirumi"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Yagu yeghana na Yawe God gwabinama yapiipiika,","poem":1},{"text":"bi yiyawiigu na geananagharana.","poem":2},{"text":"Touna piropiro gwabidima yamiiri babaregu","poem":1},{"text":"na kate geiiyabo ananagharenina.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Raghanina kagu aviya, iiyawogha na wawaya beroberodi","poem":1},{"text":"sinagogona tagu biidi bi sinimatipo da kasunuyigu,","poem":2},{"lineBreak":true},{"text":"na toudi wosina sinataguredi da sinabeku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meboda aviya peyaridi sinapiika sinituwiikapudi da sinagogona tagu biidi,","poem":1},{"text":"bi gegha da geananagharedina.","poem":2},{"text":"Raghanina sinagogona tagu biidi,","poem":1},{"text":"na tagu Yawe God kawagha anitumaghaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tagu sawara tanagha kiiravine Yawe God avibabiini,","poem":1},{"text":"sawara tanagha kawagha akayoveni:","poem":2},{"lineBreak":true},{"text":"Yagu wiina kirakii da yagu yawa tupana kamone na yana bare kamone anamakae,","poem":2},{"lineBreak":true},{"text":"bi anakita da touna imiise da awaki patana","poem":2},{"lineBreak":true},{"text":"bi yana Bare Kabikabikuwayine anarupari touna biidi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Raghanina piropiro anabanani na yana gawara nighorovine inikowoyigu,","poem":1},{"text":"bi yana bare kamone inababaregu,","poem":2},{"lineBreak":true},{"text":"touna akima kiidamo kirakiine inatoregeeyegu","poem":2},{"lineBreak":true},{"text":"meme kagu aviya gerubana sinakabiguna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kagu aviya sinagwagwara wiikenaviviregu,","poem":1},{"text":"bi gegha da animaragata kirakii da anageiwayidi.","poem":2},{"text":"Yawe God yana bare kabikabikuwayina kamone tagu suwara anagibu,","poem":1},{"text":"bi nuwamiiseye anarukwatu da anatawora","poem":2},{"lineBreak":true},{"text":"bi inawa anarouwa da ayima anakabepepi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawe God, raghanina arupari tam biidi na kwawaiyanegu,","poem":1},{"text":"kinuwanuwaghanegu bi yagu sisiya kuwonabodegu!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tam kuwonegu bo, Piika kunisisiya tagu biidi,","poem":1},{"text":"na kata apiipiika tam biidi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tagu yam wiitamariyana,","poem":1},{"text":"genuwanuwam inapughu da kunamiiri kubuteguna,","poem":2},{"lineBreak":true},{"text":"gegwabiguma kunakowoghana!","poem":2},{"text":"Tam kuviyawiigu bi nonowa kwiiwiitegu,","poem":1},{"text":"na kata gekunakuyoveguna!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meboda tamagunaki da sinagunaki sinamiiri kubutegu,","poem":1},{"text":"bi gegha, Yawe God na nonowa inakoyakoyayigu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawe God, kagu aviya sikoyakoyagha da sinaburavigu,","poem":1},{"text":"na kiyevevegu da anakivinim,","poem":2},{"lineBreak":true},{"text":"bi keda rotomanidiye kinaghovegu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nokodi aviyidi kiiraviguve sisiya wiiyaba saberabera,","poem":1},{"text":"yadi wiina da siniberogu,","poem":2},{"lineBreak":true},{"text":"na gekuniwaghasinedi da sinaburaviguna!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bi gegha da iitumaghana da Yawe God miisena inabera tagu biidi,","poem":1},{"text":"raghanina mmko kuburina debane patana yawayawiiguve amakamakena","poem":2},{"lineBreak":true},{"text":"bi anakitani da noko inabera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Na tam Yawe God kitumaghaneni,","poem":1},{"text":"kimaragata bi nuwanuwam inatora,","poem":2},{"lineBreak":true},{"text":"na Yawe God kitumaghaneni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":14}