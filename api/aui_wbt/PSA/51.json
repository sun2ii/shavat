{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":51,"content":[{"type":"heading","content":["Noghotataveyana kana Pari"]},{"type":"hebrew_subtitle","content":["Raghani tana kiiwawo Deivid madawara ibera, tomogha kana waghawagha Uraiya wavinena kana waghawagha Betsiba yawata. Na God yana peroveta Neitan noko berana kiiravine ikini na Deivid yanabera kiiravine ivinuwapoya na God biidi mmko parina igirumi."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O God, yam nuwayuyuna geiyakovikovina","poem":1},{"text":"na miisena kubera tagu biidi.","poem":2},{"text":"Tam nonowa wawaya kwiinuwapoyedi,","poem":1},{"text":"na berona ayaberabera na kunoghotataveni;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yagu berona koghataveni,","poem":1},{"text":"bi yagu tamumu kugigirataveni ware wawaya gara dadabuna sakoghatavenina naboni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Berona ayaberabera na akovi,","poem":1},{"text":"raghani nonowa na iinuwanoghonoghoteni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tagu berona tam biidi abera, tam kawagha;","poem":1},{"text":"yagu kabikwayo matam kamone ibero.","poem":2},{"text":"Na raghanina kuwonegu bo, “Tam bera berona kubera!”","poem":1},{"text":"Na tam wonawaghata kwiisisiya.","poem":2},{"text":"Raghanina aro kunavereguna,","poem":1},{"text":"tam bera rotomanina kwaberabera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yagu tubugha raghanine da kata na tagu tamumu wawayigu,","poem":1},{"text":"raghanina tagu patana sinagunaki kamokamone na tagu naboni abero.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bi gegha da kukayoveni da nuwanuwagu kamone wiisuwona iyibonuvigu","poem":1},{"text":"na noghota miisena nama kuviyevevegu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yagu berona ayaberabera na kukoghataveni da anamiise magha;","poem":1},{"text":"da parapa anapoe wamira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuwonegu da tam kunoghotatavegu na","poem":1},{"text":"wiisuwona aninuwamiise!","poem":2},{"text":"Naghove, tam irikegu kugawowora,","poem":1},{"text":"katana kubera da aninuwamiise magha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Geyagu berona kunakita kirakiiyedina","poem":1},{"text":"bi kabitavena tuwanonoyidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O God, nuwanuwa miisena, bi wouna kuveregu","poem":1},{"text":"da tam wiisuwone anakivinim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gegha gwabimma kunaporataveguna!","poem":1},{"text":"Gegha Kanumim Kabikabikuwayina gwabiguma kunakabitavenina!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuberagu da aninuwamiise magha,","poem":1},{"text":"ware dagudagune kuviyawiiguna raghanine naboni;","poem":2},{"text":"kuberagu da yam sisiya kabisisirenina nuwanuwagu inasisira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wasina bi bero berabera wawayidi biiyadi yam keda aniyeveveyana","poem":1},{"text":"da sinamiiri karona magha tam biidi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"O God tam kuviyawiigu, na kata yagu yawa kitara babaraneni","poem":1},{"text":"bi yam keda rotomanidi kiiravine nuwamiiseye anataworedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O Bada, kiwiitegu da anisisiya","poem":1},{"text":"da tam anakabepepim.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tagu ribiribi anagibu da tam biidi anasuwara, bi gegha, noko geyam kayowana,","poem":1},{"text":"tam suwara noko naboni na gekiiravidiye kuyibabana.","poem":2},{"noteId":0}]},{"type":"verse","number":17,"content":[{"text":"Raghanina atoreyowoyena mayegu","poem":1},{"text":"bi iibabiim da yagu tamumu kunanoghotataveni,","poem":2},{"text":"na nokodi suwara naboni na tam yam kayowana.","poem":1},{"text":"O God, gekuyamiimiiri kubutegu","poem":2},{"text":"raghanina yagu tamumu kiiravine iinuwapoya","poem":1},{"text":"bi arupari tam biidina.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O God yam nuwasisirama na Zaiyon biidi miisena kunabera;","poem":1},{"text":"bi Jerusalem papana kunayoghana mayeni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wasina bi wawaya nuwanuwadi miisenama tam biidi suwara sinabera, na tam kuninuwamiise toudi biiyadi.","poem":1},{"text":"Toudi suwara bogaebogae sinagabuna tam biidi.","poem":2},{"lineBreak":true},{"text":"Bi suwara gabugabunidi kiiravine na kau makidi yam suwara gabugabuna debane sinagabuna.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mmko geiyawonawona da God yana kayowana da wawaya suwara beradi sinakabiturana. Mmko yana basuna na God yanoghonoghota da parapa suwara miisena na raghanina yada berona kiiravine tani nuwapoya bi tani babiini da inanoghota taveda.","reference":{"chapter":51,"verse":16}}]},"thisChapterLink":"/api/aui_wbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":19}