"text":"bi dam tupadi kubura debane kwiinaghovedi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na dam bi dam tupadi tam sinakabepepim,","poem":1},{"text":"O God, wawaya tupadi na tam sinakabepepim!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na kwabu kabipura miisena inavereyana,","poem":1},{"text":"bi yada God parapa miisena inabera touda biiyadi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wonawaghata, God wiimiiseyana inavereda","poem":1},{"text":"bi meghamegha mmko kuburina debane,","poem":2},{"lineBreak":true},{"text":"na wawaya God sinakabikarawayeni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}