{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"PSA","translationId":"aui_wbt","name":"Psam","commonName":"Psam","title":"Psam","order":19,"numberOfChapters":13,"sha256":"33488404fde7e685c4d5e7a17f87b9bf782662cc07896804016f8536e479f454","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/aui_wbt/PSA/139.json","totalNumberOfVerses":168},"chapter":{"number":90,"content":[{"type":"heading","content":["God da Wawaya kiiravidiye"]},{"type":"hebrew_subtitle","content":["God yana bagibagi tomoyina Mosis, touna mmko parina igirumi."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Yawe God, kimta bi kimta nunudigha na","poem":1},{"text":"tam na ware yama bare.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tam rorowainagha na God waghata","poem":1},{"text":"bi muriye da koya kuyaberadi","poem":2},{"lineBreak":true},{"text":"da muriye na kubura kuyabera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wawaya kwawonedi bo, “Koveramagha konidobodobo magha!”","poem":1},{"text":"Na kwawamiridi da saveramagha sidobodobo, mema sipiikana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mata kamomve, na bodu 1,000 na ware gabudara tanagha naboni,","poem":1},{"text":"toudi ware raghani tupona nubabasu kamone.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wawaya yadi yawa kwabori yaininagha","poem":1},{"text":"ware raghanina mimeu yakovina naboni.","poem":2},{"lineBreak":true},{"text":"Touda ware rei didibare yagogo yageena naboni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Didibare na reina matayina da yagogo yapora","poem":1},{"text":"bi ravidiye na yivivi da yarabobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Noko naboni da yam nuwapughu ghamana yiberomii.","poem":1},{"text":"Raghanina nuwanuwam yapughu toumii biiyadi,","poem":2},{"lineBreak":true},{"text":"na parapa kanagharena kirakiiyem.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bi yama bera berodi tupadi kwakitakita","poem":1},{"text":"bi kiimatipo da yama berona kayikowoyidi,","poem":2},{"lineBreak":true},{"text":"bi gegha da tupadi kwakitadi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Raghanina yawayawiimii kamakamake na nuwanuwam yapughu toumii biiyadi,","poem":1},{"text":"da yama yawa kwabori yaiyainedi,","poem":2},{"lineBreak":true},{"text":"mayimayiyina raghanina wawaya yiyawiigurina naboni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Toumii kamake da bodu 70 naboni","poem":1},{"text":"bi meboda wawaya viya maragasidi na","poem":2},{"text":"samake da bodu 80 naboni,","poem":1},{"text":"bi gegha da nuwapoya peyaridi kabanana,","poem":2},{"text":"na raghani yanagho yaininagha da karabobo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Getana iiyabo parapa iyakakovi da yam nuwapughu maragasina metagha;","poem":1},{"text":"meboda yam nuwapughu kayakowa yapori,","poem":2},{"lineBreak":true},{"text":"na parapa kayakumararayem.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kiyevevemii da yama yawa makena gabudarina yana guri kanakovi,","poem":1},{"text":"da toumii noghota miisena tam gwabimma kanakabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawe God kuveramagha da kuninuwanuwaghanemii!","poem":1},{"text":"Genuwanuwam inapughumake toumii biiyadina!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yam nuwamonikama didibara patepatena kibonuvimii,","poem":1},{"text":"da yama make yawana kamone nuwamiimiiseye kanatawora.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bodu peyaridi nuwapoya kuveremii kiiravine,","poem":1},{"text":"na kata raghani gurina nuwamiise kuveremii!","poem":2},{"text":"Yama kabikwarakwara kabitavetaveyana,","poem":1},{"text":"bi bodu miisedi kuveremii!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Toumii yam wiitamariyana, yam bagibagi yana maragata kiyevevemii.","poem":1},{"text":"Yam badobado da maragata metagha na natunatumii kiyevevedi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawe tamna yama God, kinuwanuwaghanemii","poem":1},{"text":"bi awaki bagibagidi kaberabera na","poem":2},{"text":"kubera da sinuwagha wiimasi,","poem":1},{"text":"bi awaki bagibagidi kaberabera na","poem":2},{"lineBreak":true},{"text":"kubera da sinuwagha wiimasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/aui_wbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":17}