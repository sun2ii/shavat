{"translation":{"id":"aui_wbt","name":"Buk Baibel long Anuki","website":"https://ebible.org/Scriptures/details.php?id=aui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=aui","licenseNotes":null,"shortName":"WBT","englishName":"Anuki Bible Portions","language":"aui","textDirection":"ltr","sha256":"d890728dccfbd25d646e9a394e2a012b70379174f7b6dc00d9c77e75eb5d0ab7","availableFormats":["json"],"listOfBooksApiLink":"/api/aui_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":268,"totalNumberOfVerses":4087,"languageName":"Anuki","languageEnglishName":"Anuki"},"book":{"id":"ZEC","translationId":"aui_wbt","name":"Jakaraiya","commonName":"Jakaraiya","title":"Jakaraiya","order":38,"numberOfChapters":4,"sha256":"bf45aab691fa2f2eeb1f3e80b6f383d6aa2fb04ae3b21d00a01f8a87f54fe100","firstChapterNumber":1,"firstChapterApiLink":"/api/aui_wbt/ZEC/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/aui_wbt/ZEC/13.json","totalNumberOfVerses":5},"chapter":{"number":9,"content":[{"type":"line_break"},{"type":"verse","number":9,"content":["Yawe God iwona bo,",{"text":"“Tami Zaiyon dammi parapa kovi nuwamiise,","poem":1},{"text":"bi Jerusalem dammi korukwatu gwaru.","poem":2},{"noteId":0},{"text":"Kokita, yami kiiwawo yapiipiika tami biiyadi.","poem":1},{"text":"Yana keda na rotomanidi, bi sawara tupadi igeeiwaiyidi,","poem":2},{"text":"touna wawaya wawumina bi donki debane inageru bi inapiipiika.","poem":1},{"text":"Bi donki wotuna debane inageru, nokona donki yagarina natuna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tagu, Isrel kamone seriyot da kate","poem":1},{"lineBreak":true},{"text":"Jerusalem kamone hosi, mekodi wiirouwa kamone sigerugeru na anakabitavetaveyana.","poem":1},{"text":"Bi wiirouwa sawaridi tupadi aniberodi,","poem":2},{"text":"yami kiiwawo nuwaruriri inapiikeni dam tupadi biiyadi.","poem":1},{"text":"Yana wiibadana yegii nawane inadaguni da inanagho yegii nawane,","poem":2},{"text":"bi kate Iparate rarimine da inanagho kubura tupana damone.”","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mmkodi waghawagha yadi bata Zaiyon da Jerusalem na kwanatuna tanagha sisisiyeni, bi gegha da Zaiyon na touna gawara meme Bare Kabikabikuwayina yamiimiirina yisisiyeni.","reference":{"chapter":9,"verse":9}}]},"thisChapterLink":"/api/aui_wbt/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/aui_wbt/ZEC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/aui_wbt/ZEC/1.json","previousChapterAudioLinks":{},"numberOfVerses":2}