oem":1},{"lineBreak":true},{"text":"Síátio Sérápáperimba maꞌankówana","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sérápáperi Ápáyatimba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Ápáyati Éráyakimumba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Éráyakimu Ésomba maꞌankówana","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Éso Sétókomba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Sétóko Ékímumba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Ékímu Éráyatimba maꞌankówana","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éráyati Éríesaamba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Éríesaa Mátánaamba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Mátánaa Yékopumba maꞌankówana","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yékopu Yósepimba maꞌankówana","poem":1},{"lineBreak":true},{"text":"Yósepi Máríyaan-awaaikó úwana Máríyaa","poem":1},{"lineBreak":true},{"text":"Ísun-anówan-iye. Ísuntafesa Maníkó íyáfasinankaraiwaiye sésa Káráísitiye wésewe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Émbaramumo méronkaꞌa sísamaifakemba éíyaimba kumbaimái-waasi 14 waasi agaiyówasa Téfítimo paápé urénamo méronkaꞌa sísamaifakemba éíyaimba kumbaimái-waasi 14 waasi agaiyówasa Pépírónifakewi tatíꞌmaesa Pépírónifaꞌa ándáfaꞌa mátínkarowasa méron-kanaafimba sísamaifakemba éíyaimba kumbaimái-waasi 14 waasi agaiyówana minkáꞌá Máríyaa Ísu Káráísitimba maꞌánkaraiye."]},{"type":"heading","content":["Ísumbo maꞌánkarain-aai."]},{"type":"verse","number":18,"content":["Ísu Káráísitimba maꞌankómba maará uráiye. Ísun-anówamba Yósepinkaꞌa aaí símakowana Yósepi ímba weséꞌa kurónkaꞌa ámúꞌa paápé uráiye. Ufaen-ámútánkó Máríyaan-arumpi túwana ámúꞌa paápé úwana"]},{"type":"verse","number":19,"content":["awaaikó kaweꞌá wéuwai séna waási túrankaꞌa aiꞌmáráanana Máríyaa aigaesáféna ifáímpóꞌa aúpáꞌá aiꞌmátuwanaumne-imayaa uráiye."]},{"type":"line_break"},{"type":"verse","number":20,"content":["Miyá imáyáa wéena aún-kwérowana Fasiꞌaénkó kísau-waasigo wíyómpakewi kaainampáꞌá simámena séna Yósepiyo Téfítin-andafaken-kwaasi óne. Máríyaamo ámúꞌo káúfímba Ufaen-ámútánkó aantemba ámúꞌa kauwánkáímba po wembá úwoi máínompo ímba ááꞌa íno."]},{"type":"verse","number":21,"content":["Iyámpóímo maꞌankáínda áwíꞌa Ísuwe simánkaao siyáiye. Mináwíkóní áwáuma wení waási sáwí-imayaagomo taꞌótokaimpinkemba faútinkainiye siyáiye."]},{"type":"line_break"},{"type":"verse","number":22,"content":["Naaófáꞌá Maníkón-aaimo simátímakowi siyónkaꞌa póna miyán-tántááꞌá paápé uráiye."]},{"type":"verse","number":23,"content":["Wemá agaimaréna séna",{"text":"moórá-inaamarugo waaí ímba maiyéna ámúꞌa","poem":1},{"lineBreak":true},{"text":"kaumái iyámpói maꞌankáínasa miníyámpóígón-","poem":1},{"lineBreak":true},{"text":"áwíꞌa Émániyueriye sénááwe","poem":1},"agaimaréna siyáimba mináwíkóní áwáuma Maníkó keséta méraiye siyáiye."]},{"type":"verse","number":24,"content":["Yósepi aúfínkémbá íyáfasinena Fasiꞌaénkóní kísau-waasigo wíyómpakewi siyóntemba awaainínkómbá maiyéna"]},{"type":"verse","number":25,"content":["ímba weséꞌa kúmba úwoi ména káráwiyowana iyámpói maꞌankówana áwíꞌa Ísuwe simánkaraiye."]}],"footnotes":[]},"thisChapterLink":"/api/auy_tbl/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/auy_tbl/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}