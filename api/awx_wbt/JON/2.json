{"translation":{"id":"awx_wbt","name":"Awara Baibel","website":"https://ebible.org/Scriptures/details.php?id=awx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=awx","licenseNotes":null,"shortName":"WBT","englishName":"Awara Bible portions","language":"awx","textDirection":"ltr","sha256":"d597aae1517b41b64b2421a0382b945ad3f0db601399d0b9e4b1514a574d68f1","availableFormats":["json"],"listOfBooksApiLink":"/api/awx_wbt/books.json","numberOfBooks":3,"totalNumberOfChapters":58,"totalNumberOfVerses":1637,"languageName":"Awara","languageEnglishName":"Awara"},"book":{"id":"JON","translationId":"awx_wbt","name":"Jona","commonName":"Jona","title":"Jona","order":32,"numberOfChapters":4,"sha256":"9e0d9043bca8dda57be3da7a91281f5abac62e7c39e9c01882250251aa7d51cd","firstChapterNumber":1,"firstChapterApiLink":"/api/awx_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/awx_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonale tumuk"]},{"type":"verse","number":1,"content":["Jona pisde bänipkätan yiwixäwik, tumuk wamu Anätunä Yawele"]},{"type":"verse","number":2,"content":["using yakut.",{"text":"“Yawe, nä anaxälake yanggäwämba,","poem":1},{"text":"nätä natäke yakumu gätä pahakuläk.","poem":2},{"text":"Ämusing hikngä axumgin ämindä yiwixayingkätandä,","poem":1},{"text":"tumuk wamu anggatängamiläkge yäwa,","poem":2},{"lineBreak":true},{"text":"näle tumuxu anatäpguläk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gätä mumbi,","poem":1},{"text":"nä yanggä ämalan hikngä,","poem":2},{"lineBreak":true},{"text":"yanggä bänipkätan epgum.","poem":2},{"text":"Tiwän yanggätä täpän kopa,","poem":1},{"text":"gäle yanggätä täku temäke pänguhikut.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tiwän using natäpgum.","poem":1},{"text":"‘Gätä gika nomdanetä anawaläk.","poem":2},{"lineBreak":true},{"text":"Tiwändeyä gika takwän yotda hipdu axawit.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yanggätä täpän kopgum,","poem":1},{"text":"tiwän pälä päkakopa hakin.","poem":2},{"text":"Yanggä gäpmayi hikngä gwendä","poem":1},{"text":"tängäna täpä undä hikngä täpän kopa,","poem":2},{"text":"songäsongä yanggäne nanätä","poem":1},{"text":"kuhitna gwenu wamgin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nä täwan kemat hikngä aepgum.","poem":1},{"text":"Kepdä yämä iwikiwik yiwitde alepän kuhingamikut.","poem":2},{"text":"Tiwändeyä, Yawe Anätunatä","poem":1},{"text":"gapmayinetä käluk täkako tewi yiwikum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nina natäpa, käluk yiwitnangäsä täknga wenä tinangge tiwän,","poem":1},{"text":"Yawe, nä gäle natäke,","poem":2},{"lineBreak":true},{"text":"tumuxu yäwa,","poem":2},{"text":"yot takwändanetä anatäpguläk.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hängä kitokngänä wenä ämindäkän kwätäluke","poem":1},{"text":"tumuxu ile tahakaying äminu uläkwäxu,","poem":2},{"text":"gwälam hikngä gätä pahangyäminggaläxu","poem":1},{"text":"maha yämikaying.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tiwändeyä nä kawu gäle tayixäwik,","poem":1},{"text":"gäle uman täknga yatängenaxäwik,","poem":2},{"lineBreak":true},{"text":"hikawu gäle tänguke häwa ihikuwik.","poem":2},{"text":"Wamu kitokngä u yakumu","poem":1},{"text":"undä pahawit.","poem":2},{"text":"Axumnangäsä tiwändeyä,","poem":1},{"text":"Yawetäkän käluxu nipmambän yiwixamängunin,”","poem":2},"yang yakut."]},{"type":"verse","number":10,"content":["Tiwänä Yawetä pis gwenu iniwän, täku yanggä kwayimune watutekut, Jonan."]}],"footnotes":[]},"thisChapterLink":"/api/awx_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/awx_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/awx_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}