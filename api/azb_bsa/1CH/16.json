{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"1CH","translationId":"azb_bsa","name":"BİRİNCİ SALNAMƏLƏR","commonName":"BİRİNCİ SALNAMƏLƏR","title":"BİRİNCİ SALNAMƏLƏR KİTABI","order":13,"numberOfChapters":29,"sha256":"ab8d076d67a1c5121ed9453b03ef11663447271712966271acddc9f23410d891","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/azb_bsa/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Allahın sandığını gətirib onun üçün Davudun qurduğu çadırın ortasına qoydular. Allahın önündə yandırma və ünsiyyət qurbanları təqdim etdilər."]},{"type":"verse","number":2,"content":["Davud yandırma və ünsiyyət qurbanlarını təqdim edib qurtarandan sonra Rəbbin adı ilə xalqa xeyir-dua verdi."]},{"type":"verse","number":3,"content":["O bütün İsraillilərə – kişilərin və qadınların hər birinə bir kömbə çörək, bir parça ət və bir üzüm lavaşanası payladı."]},{"type":"verse","number":4,"content":["Davud İsrailin Allahı Rəbbi çağırıb Ona şükür və həmd etmək üçün Levililərdən xidmət edən bu adamları Rəbbin sandığının önünə qoydu."]},{"type":"verse","number":5,"content":["Başçı Asəf, onun köməkçisi Zəkəriyyə, çəng və lira çalan Yeiel, Şemiramot, Yexiel, Mattitya, Eliav, Benaya, Oved-Edom və Yeiel, sincləri yüksək səslə çalan Asəf,"]},{"type":"verse","number":6,"content":["Allahın Əhd sandığı önündə həmişə kərənaylar çalan kahinlər Benaya və Yaxaziel."]},{"type":"verse","number":7,"content":["O gün Davud ilk dəfə olaraq Rəbbə şükür etmək işini Asəflə yoldaşlarına tapşırdı."]},{"type":"heading","content":["Allaha həsr olunan məzmur"]},{"type":"verse","number":8,"content":[{"text":"«Rəbbə şükür edin, ismini çağırın,","poem":1},{"lineBreak":true},{"text":"Əməllərini xalqlar arasında elan edin!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onu ilahilərlə tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Bütün xariqələrini bəyan edin!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onun müqəddəs adı ilə fəxr edin,","poem":1},{"lineBreak":true},{"text":"Ey Rəbbi axtaranlar, ürəkləriniz qoy sevinsin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbbi, Onun qüvvətini arayın,","poem":1},{"lineBreak":true},{"text":"Daim hüzurunu axtarın.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Etdiyi xariqələri,","poem":1},{"lineBreak":true},{"text":"Möcüzələri, dilindən çıxan hökmləri xatırlayın,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey Onun qulu İsrail nəsli,","poem":1},{"lineBreak":true},{"text":"Ey Yaqub övladları, ey Onun seçdikləri!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Allahımız Rəbb Odur,","poem":1},{"lineBreak":true},{"text":"Hökmü bütün yer üzərindədir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Əbədi olaraq – min nəslə qədər əhdini,","poem":1},{"lineBreak":true},{"text":"Əmr etdiyi sözü,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"İbrahimlə kəsdiyi əhdini,","poem":1},{"lineBreak":true},{"text":"İshaqa and içərək verdiyi vədini unutmaz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bunu qayda kimi Yaqub üçün təsdiq etdi,","poem":1},{"lineBreak":true},{"text":"Bu əbədi əhdi İsrail üçün etdi,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dedi: “Övladlarının payına düşən mülk kimi","poem":1},{"lineBreak":true},{"text":"Kənan torpağını sənə verəcəyəm”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O zaman sayca onlar az idilər,","poem":1},{"lineBreak":true},{"text":"Azsaylı olaraq ölkədə qərib idilər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ölkədən-ölkəyə,","poem":1},{"lineBreak":true},{"text":"Məmləkətdən-məmləkətə köçürdülər.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbb heç kimi onlara əzab verməyə qoymadı,","poem":1},{"lineBreak":true},{"text":"Onlara görə padşahları tənbeh etdi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dedi: “Məsh elədiklərimə dəyməyin,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərimə pislik etməyin”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ey bütün dünya, Rəbbə ilahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Xilaskar olduğunu gündən-günə müjdələyin.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ehtişamını millətlərə elan edin,","poem":1},{"lineBreak":true},{"text":"Xariqələrini bütün xalqlara bəyan edin!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Axı Rəbb əzəmətlidir, bol həmdə layiqdir,","poem":1},{"lineBreak":true},{"text":"O bütün allahlardan daha zəhmlidir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bütün özgə xalqların allahları bütlərdir,","poem":1},{"lineBreak":true},{"text":"Lakin göyləri yaradan Rəbdir.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ehtişam və əzəmət hüzurunda olar,","poem":1},{"lineBreak":true},{"text":"Sevinclə qüdrət Onun yerindədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ey xalqların tayfaları, Rəbbə verin –","poem":1},{"lineBreak":true},{"text":"Ehtişamı, qüdrəti Rəbbə verin,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Adına layiq ehtişamı Rəbbə verin,","poem":1},{"lineBreak":true},{"text":"Hüzuruna girib təqdimlər verin.","poem":1},{"lineBreak":true},{"text":"Müqəddəslik zinəti ilə Rəbbə səcdə edin.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ey bütün dünya, Onun hüzurunda lərzəyə gəlin!","poem":1},{"lineBreak":true},{"text":"O, dünyanı sarsılmaz və möhkəm qurub.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Göylər sevinsin, yer üzü şad olsun!","poem":1},{"lineBreak":true},{"text":"Millətlərə belə elan edin:","poem":1},{"lineBreak":true},{"text":"“Rəbb hökmranlıq edir”.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Dənizin və dənizdəki canlıların səsi ucalsın,","poem":1},{"lineBreak":true},{"text":"Çöllər və çöldə yaşayanlar fərəhlənsin,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Meşədəki bütün ağaclar mədh söyləsin","poem":1},{"lineBreak":true},{"text":"Rəbbin hüzurunda!","poem":1},{"lineBreak":true},{"text":"O, dünyanın hökmünü vermək üçün gəlir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Deyin: “Ey qurtarıcımız Allah, bizi qurtar,","poem":1},{"lineBreak":true},{"text":"Bizi millətlərin arasından topla və azad et.","poem":1},{"lineBreak":true},{"text":"Müqəddəs isminə şükür edək,","poem":1},{"lineBreak":true},{"text":"Biz fəxrlə Sənə həmd söyləyək”.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Alqış olsun İsrailin Allahı Rəbbə","poem":1},{"lineBreak":true},{"text":"Əzəldən sonsuza qədər!»","poem":1},"Bütün xalq «Amin!» söylədi və Rəbbə həmd etdi."]},{"type":"heading","content":["Rəbbin Əhd sandığının önündə və Giveonda xidmət edənlər"]},{"type":"verse","number":37,"content":["Davud orada – Rəbbin Əhd sandığının önündə bu adamları qoydu: hər günün işinə görə sandığın önündə daim xidmət edən Asəf və onun yoldaşları,"]},{"type":"verse","number":38,"content":["Oved-Edom və onun altmış səkkiz nəfər yoldaşı, qapıçılar Yedutun oğlu Oved-Edom və Xosa."]},{"type":"verse","number":39,"content":["O, Giveonda olan səcdəgahda, Rəbbin məskəni önündə, kahin Sadoqu və onun kahin yoldaşlarını qoydu ki,"]},{"type":"verse","number":40,"content":["Rəbbin İsrailə əmr etdiyi Qanunda yazılanların hamısına görə daim səhər və axşam Rəbbə yandırma qurbanları üçün düzəldilən qurbangahda Ona yandırma qurbanları versinlər."]},{"type":"verse","number":41,"content":["Onlarla birgə Hemanı, Yedutunu və adları çəkilən başqa seçilmiş adamları təyin etdi ki, Rəbbə şükür etsinlər, çünki Onun məhəbbəti əbədidir."]},{"type":"verse","number":42,"content":["Heman, Yedutun və həmin adamların əlində Allaha yüksək səslə musiqi çalmaq üçün kərənaylar, sinclər və başqa alətlər var idi. Yedutunun oğulları isə qapıçı oldular."]},{"type":"verse","number":43,"content":["Bütün xalq – hər kəs evinə getdi, Davud da öz evinə xeyir-dua vermək üçün geri qayıtdı."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}