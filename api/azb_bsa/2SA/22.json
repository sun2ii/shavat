{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"2SA","translationId":"azb_bsa","name":"İKİNCİ ŞAMUEL","commonName":"İKİNCİ ŞAMUEL","title":"İKİNCİ ŞAMUEL KİTABI","order":10,"numberOfChapters":24,"sha256":"c6002705ab23a458cdce3fa93fe3461ef3a566538ad2e8abc954dfe3a19584c4","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/azb_bsa/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Davudun qələbə məzmuru"]},{"type":"verse","number":1,"content":["Rəbb Davudu bütün düşmənlərinin və Şaulun əlindən qurtaranda Davud bu ilahinin",{"noteId":7},"sözlərini Rəbbə söylədi;"]},{"type":"verse","number":2,"content":["O belə oxudu:",{"text":"Rəbb qayam, qalamdır, xilaskarımdır,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allahım qayamdır, Ona pənah gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Odur qalxanım, qüvvətli qurtarıcım, qülləm,","poem":1},{"lineBreak":true},{"text":"Sığınacaq yerim, xilaskarım!","poem":1},{"lineBreak":true},{"text":"Sən məni zalımların əlindən qurtarırsan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Həmdə layiq olan Rəbbi çağıracağam,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin əlindən qurtulacağam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki ətrafımı ölüm dalğaları bürümüşdü,","poem":1},{"lineBreak":true},{"text":"Məni əcəl selləri ürkütmüşdü,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ölülər diyarının ipləri mənə sarılmışdı,","poem":1},{"lineBreak":true},{"text":"Ölüm kəməndləri məni qarşılamışdı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Əzab içində Rəbbə yalvardım,","poem":1},{"lineBreak":true},{"text":"Allahımı köməyə çağırdım.","poem":1},{"lineBreak":true},{"text":"O, məbədindən səsimi eşitdi,","poem":1},{"lineBreak":true},{"text":"Fəryadımsa Onun qulağına yetdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O zaman sarsılıb dünya titrədi,","poem":1},{"lineBreak":true},{"text":"Göylər təməllərindən sarsılıb lərzəyə gəldi.","poem":1},{"lineBreak":true},{"text":"Çünki O qəzəbləndi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Burnundan tüstü çıxıb yüksəldi,","poem":1},{"lineBreak":true},{"text":"Ağzından yandırıb-yaxan alov püskürdü,","poem":1},{"lineBreak":true},{"text":"Bundan közlər tutuşdu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O, göyləri yarıb yerədək endi.","poem":1},{"lineBreak":true},{"text":"Qatı zülmət ayaqları altında idi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bir keruva minib uçdu,","poem":1},{"lineBreak":true},{"text":"Yel qanadları üstündə şığıdı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ətrafını zülmətə bürüdü,","poem":1},{"lineBreak":true},{"text":"Tufan qoparan qara buludlardan Özünə çardaqlar qurdu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hüzurunun nuru şəfəq saçdı,","poem":1},{"lineBreak":true},{"text":"Oradan odlu közlər düşüb alovlandı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb göylərdən gurladı,","poem":1},{"lineBreak":true},{"text":"Haqq-Taala səs saldı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Oxlar atıb düşmənləri darmadağın etdi,","poem":1},{"lineBreak":true},{"text":"Şimşəyini çaxdırıb onları dağıtdı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbbin məzəmmətindən,","poem":1},{"lineBreak":true},{"text":"Burnundakı nəfəsinin şiddətindən","poem":1},{"lineBreak":true},{"text":"Dənizin dərinlikləri göründü,","poem":1},{"lineBreak":true},{"text":"Dünyanın bünövrələri açıq qaldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"O, ucalardan əl uzadıb məni tutdu,","poem":1},{"lineBreak":true},{"text":"Məni dərin suların içindən çıxartdı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Məni qüvvətli düşmənimdən azad etdi,","poem":1},{"lineBreak":true},{"text":"Çünki yağılarım məndən güclü idi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fəlakətli günümdə qarşıma çıxdılar,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb mənə dayaq oldu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O məni geniş yerə çıxartdı,","poem":1},{"lineBreak":true},{"text":"Məndən razı qalıb məni qurtardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rəbb mənə salehliyim naminə ənam verdi,","poem":1},{"lineBreak":true},{"text":"Mənə əlitəmizliyimin əvəzini verdi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki Rəbbin yolunu tutmuşam,","poem":1},{"lineBreak":true},{"text":"Pis olub Allahımın yolundan azmamışam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onun bütün hökmləri önümdədir,","poem":1},{"lineBreak":true},{"text":"Qaydalarından imtina etməmişəm.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onun önündə kamilliyə çatmışam,","poem":1},{"lineBreak":true},{"text":"Özümü günahdan qorumuşam.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Rəbb mənə salehliyimin əvəzini verdi,","poem":1},{"lineBreak":true},{"text":"Gözünün önündə təmizliyimin əvəzini verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sədaqətlilərlə sədaqətlisən,","poem":1},{"lineBreak":true},{"text":"Kamillərlə kamilsən.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Təmizlərlə təmizsən,","poem":1},{"lineBreak":true},{"text":"Əyrilərlə əyriliklərinə görə davranırsan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"İtaətkar insanları qurtarırsan,","poem":1},{"lineBreak":true},{"text":"Lovğalara göz qoyursan, onları alçaldırsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ya Rəbb, Sən mənim çırağımsan,","poem":1},{"lineBreak":true},{"text":"Rəbb zülmətimi nura çevirir.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Səninlə qoşun üstünə hücum çəkirəm,","poem":1},{"lineBreak":true},{"text":"Allahımla sədlər keçirəm.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Allahın yolu kamildir,","poem":1},{"lineBreak":true},{"text":"Rəbbin kəlamı safdır,","poem":1},{"lineBreak":true},{"text":"Rəbb ona sığınanların sipəridir.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Rəbdən başqa Allah kimdir ki?","poem":1},{"lineBreak":true},{"text":"Allahımızdan başqa qaya kimdir ki?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Allah qalamdır, mənə qüvvət verər,","poem":1},{"lineBreak":true},{"text":"Yolumu kamil edər.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ayaqlarımı maral ayaqları kimi çevik edər,","poem":1},{"lineBreak":true},{"text":"Məni zirvələrdə saxlar.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Əllərimə döyüş təlimi verər,","poem":1},{"lineBreak":true},{"text":"Qollarım tunc kamanı dartar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Sən mənə qurtuluş qalxanını verdin,","poem":1},{"lineBreak":true},{"text":"Etdiyin köməklə Sən məni yüksəltdin.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Geniş yer açdın ki, addımlayım,","poem":1},{"lineBreak":true},{"text":"Büdrəməsin ayaqlarım.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Düşmənlərimi qovdum, onları qırdım,","poem":1},{"lineBreak":true},{"text":"Onlar məhv olanadək geriyə qayıtmadım.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Onları əzib qurtardım, qalxa bilmədilər,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımın altına sərildilər.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Döyüş üçün məni qüvvə ilə bürüdün,","poem":1},{"lineBreak":true},{"text":"Əleyhdarlarımı ayağımın altına saldın,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Düşmənlərimin kürəyini mənə sarı çevirdin,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edən yağıları məhv etdim.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Gözləsələr də, onları qurtaran olmadı,","poem":1},{"lineBreak":true},{"text":"Rəbbə baxsalar da, Ondan cavab gəlmədi.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Onları yerdəki toz kimi əzdim,","poem":1},{"lineBreak":true},{"text":"Küçələrin palçığı kimi tapdaladım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Sən məni xalqımın çəkişmələrindən qurtardın,","poem":1},{"lineBreak":true},{"text":"Məni millətlərə başçı qoydun,","poem":1},{"lineBreak":true},{"text":"Tanımadığım xalqları mənə tabe etdirdin.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Yadellilər mənə boyun əyirlər.","poem":1},{"lineBreak":true},{"text":"Səsimi eşidəndə mənə itaət edirlər.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Yadellilərin cəsarəti qırıldı,","poem":1},{"lineBreak":true},{"text":"Titrəyərək sığınacaqlarından çıxdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Rəbb əbədi yaşayır, Qayama alqış olsun!","poem":1},{"lineBreak":true},{"text":"Məni qurtaran Qayam, Allahım ucalsın!","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"O Allahdır, mənə görə qisas alır,","poem":1},{"lineBreak":true},{"text":"Xalqları mənə tabe etdirir.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"O məni düşmən içindən çıxarır,","poem":1},{"lineBreak":true},{"text":"Məni yağılar üstündə ucaldır,","poem":1},{"lineBreak":true},{"text":"Məni zalımların əlindən qurtarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Buna görə, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Millətlər arasında Sənə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsminə tərənnüm söyləyəcəyəm!","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Rəbb padşahına böyük zəfərlər verər,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyi Davuda və nəslinə əbədi məhəbbət göstərər.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"İlahi – ruhani nəğmə.","reference":{"chapter":22,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}