{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bu, Teqoada sürü sahiblərindən biri olan Amosun sözləridir. O, Yəhuda padşahı Uzziyanın və İsrail padşahı Yoaş oğlu Yarovamın dövründə – böyük zəlzələdən iki il qabaq İsrail barədə belə görüntü görmüşdü."]},{"type":"verse","number":2,"content":["Amos belə dedi:",{"text":"«Rəbb Siondan nərə çəkir,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdən guruldayır.","poem":1},{"lineBreak":true},{"text":"Bundan otlaqlar solur,","poem":1},{"lineBreak":true},{"text":"Karmel dağının başı quruyur.","poem":1}]},{"type":"heading","content":["Rəbbin Aramlılara verəcəyi cəza"]},{"type":"verse","number":3,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Dəməşqlilərin üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Gileadı dəmirdişli vəllərlə döydü.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buna görə də Xazaelin sarayına od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Ben-Hadadın qalalarını yandırıb-yaxsın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dəməşqin darvazalarının sürgülərini qıracağam,","poem":1},{"lineBreak":true},{"text":"Aven dərəsindən əhalini silib-atacağam,","poem":1},{"lineBreak":true},{"text":"Bet-Edendən əsa gəzdirəni kəsəcəyəm,","poem":1},{"lineBreak":true},{"text":"Aram xalqı Qirə sürgünə aparılacaq” Rəbb belə deyir.","poem":1}]},{"type":"heading","content":["Rəbbin Filiştlilərə verəcəyi cəza"]},{"type":"verse","number":6,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Qəzzəlilərin üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam.","poem":1},{"lineBreak":true},{"text":"Çünki onlar bütün camaatı əsir edib Edoma təslim etdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buna görə də Qəzzənin divarlarına od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Oranın qalalarını yandırıb-yaxsın.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aşdoddan əhalini silib-atacağam,","poem":1},{"lineBreak":true},{"text":"Aşqelondan əsa gəzdirəni kəsəcəyəm.","poem":1},{"lineBreak":true},{"text":"Eqrona qarşı əlimi qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Qalan Filiştlilər də yox olacaqlar” Xudavənd Rəbb belə deyir.","poem":1}]},{"type":"heading","content":["Rəbbin Surlulara verəcəyi cəza"]},{"type":"verse","number":9,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Surluların üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar bütün camaatı Edoma əsir edib qardaşlıq əhdini pozdu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buna görə də Surun divarlarına od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Oranın qalalarını yandırıb-yaxsın”.","poem":1}]},{"type":"heading","content":["Rəbbin Edomlulara verəcəyi cəza"]},{"type":"verse","number":11,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Edomluların üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar mərhəmət hissini qılıncla boğub qardaş xalqı qovdular,","poem":1},{"lineBreak":true},{"text":"Heç vaxt azğınlıqlarının qarşısını almadılar və yırtıcılıq etdilər.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buna görə də Temana od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Bosranın qalalarını yandırıb-yaxsın”.","poem":1}]},{"type":"heading","content":["Rəbbin Ammonlulara verəcəyi cəza"]},{"type":"verse","number":13,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Ammonluların üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar ərazilərini genişləndirmək üçün","poem":1},{"lineBreak":true},{"text":"Gileadda hamilə qadınların qarınlarını yırtdılar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Buna görə də Rabbanın divarına od vuracağam ki,","poem":1},{"lineBreak":true},{"text":"Oranın qalalarını yandırıb-yaxsın.","poem":1},{"lineBreak":true},{"text":"Bu yer döyüş zamanı qışqırtı ilə,","poem":1},{"lineBreak":true},{"text":"Qasırğa günü fırtına ilə dağılacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onların padşahları ilə başçıları","poem":1},{"lineBreak":true},{"text":"Birgə sürgünə aparılacaq” Rəbb belə deyir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}