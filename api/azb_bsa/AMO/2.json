{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["Rəbbin Moavlılara verəcəyi cəza"]},{"type":"verse","number":1,"content":["Rəbb belə deyir:",{"text":"“Moavlıların üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Edom padşahının sümüklərini yandırıb əhəng hazırladı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buna görə də Moava od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Qeriyotun qalalarını yandırıb-yaxsın.","poem":1},{"lineBreak":true},{"text":"Moav qışqırtı və şeypur səsi altında,","poem":1},{"lineBreak":true},{"text":"Səs-küylə məhv olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onların arasından hakimləri kəsib-atacağam,","poem":1},{"lineBreak":true},{"text":"Bütün başçılarını da öldürəcəyəm” Rəbb belə deyir.","poem":1}]},{"type":"heading","content":["Rəbbin Yəhudalılara verəcəyi cəza"]},{"type":"verse","number":4,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Yəhudalıların üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Rəbbin qanununa xor baxıb qaydalarına riayət etmədi,","poem":1},{"lineBreak":true},{"text":"Atalarının sitayiş etdiyi saxta bütlər onları da yollarından azdırdı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buna görə də Yəhudaya od yağdıracağam ki,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin qalalarını yandırıb-yaxsın”.","poem":1}]},{"type":"heading","content":["Rəbbin İsraillilərə verəcəyi cəza"]},{"type":"verse","number":6,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“İsraillilərin üç-dörd qat günahına görə","poem":1},{"lineBreak":true},{"text":"Onları cəzasız buraxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlar düz adamları pula,","poem":1},{"lineBreak":true},{"text":"Möhtacları da bir cüt çarığa satır,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yoxsulları toz-torpağın içinə salıb əzir,","poem":1},{"lineBreak":true},{"text":"Məzlumlara yol vermir.","poem":1},{"lineBreak":true},{"text":"Ata və oğul eyni qızla yatıb","poem":1},{"lineBreak":true},{"text":"Müqəddəs adımı ləkələyir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsraillilər hər qurbangahın yanında","poem":1},{"lineBreak":true},{"text":"Girov götürdükləri paltarın üzərində yatır,","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahının məbədində","poem":1},{"lineBreak":true},{"text":"Cərimə üçün gətirilən şərabı içirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amma Mən sidr ağacı kimi hündür,","poem":1},{"lineBreak":true},{"text":"Palıd ağacı kimi möhkəm olan","poem":1},{"lineBreak":true},{"text":"Emorluları qarşınızda yox etdim,","poem":1},{"lineBreak":true},{"text":"Yuxarıdan bəhrəsini, aşağıdan kökünü kəsdim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən sizi Misir torpağından çıxarıb","poem":1},{"lineBreak":true},{"text":"Qırx il çöldə gəzdirmişdim ki,","poem":1},{"lineBreak":true},{"text":"Siz Emorluların torpağına sahib olasınız.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Oğullarınızdan peyğəmbərlər,","poem":1},{"lineBreak":true},{"text":"Cavanlarınızdan Nəzirilər təyin etdim.","poem":1},{"lineBreak":true},{"text":"Ey İsraillilər, bu belə deyilmi?” Rəbb bəyan edir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“Siz isə Nəzirilərə şərab içirdiniz,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərə ‹peyğəmbərlik etmə› əmri verdiniz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dərzlə dolu olan araba torpağı necə əzirsə,","poem":1},{"lineBreak":true},{"text":"Mən də sizi elə əzəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bərk qaçan qaça bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Qüvvətli isə gücünü göstərə bilməyəcək.","poem":1},{"lineBreak":true},{"text":"İgid canını qurtara bilməyəcək,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yay çəkən də mövqe tuta bilməyəcək.","poem":1},{"lineBreak":true},{"text":"Ayaqdan çevik olan qurtula bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Süvari də canını qurtara bilməyəcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hətta ən igid döyüşçü belə,","poem":1},{"lineBreak":true},{"text":"O gün əliyalın qaçacaq” Rəbb belə bəyan edir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}