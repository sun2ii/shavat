{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Ey İsraillilər! Rəbbin əleyhinizə dediyi sözü dinləyin! Misir torpağından çıxardığı bu nəslin hamısına belə deyir:"]},{"type":"verse","number":2,"content":[{"text":"“Yer üzündəki nəsillərin arasında yalnız sizinlə ünsiyyət yaratmışam.","poem":1},{"lineBreak":true},{"text":"Ona görə Mən bütün cəzanızı öz başınıza gətirəcəyəm”.","poem":1}]},{"type":"heading","content":["Peyğəmbərlik işi"]},{"type":"verse","number":3,"content":[{"text":"İki nəfər razılaşıb görüşməsə,","poem":1},{"lineBreak":true},{"text":"Birgə yol gedərmi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Şikarı olmayan şir","poem":1},{"lineBreak":true},{"text":"Meşədə nərə çəkərmi?","poem":1},{"lineBreak":true},{"text":"Heç nə ovlamamış gənc aslan","poem":1},{"lineBreak":true},{"text":"Yuvasında nərildəyərmi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yerdə tələ qurub yem qoyulmazsa,","poem":1},{"lineBreak":true},{"text":"Oraya quş düşərmi?","poem":1},{"lineBreak":true},{"text":"Bir şey tutmayan tələ","poem":1},{"lineBreak":true},{"text":"Yerindən atılarmı?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Şəhərdə şeypur çalınarsa,","poem":1},{"lineBreak":true},{"text":"Xalq qorxuya düşməzmi?","poem":1},{"lineBreak":true},{"text":"Əgər Rəbb bəla göndərməsə,","poem":1},{"lineBreak":true},{"text":"Hansısa bir şəhərə bəla gələrmi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Həqiqətən, Xudavənd Rəbb qulu olan peyğəmbərlərə","poem":1},{"lineBreak":true},{"text":"Öz niyyətini açmadan heç nə etmir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Şir nərə çəkəndə","poem":1},{"lineBreak":true},{"text":"Kim ondan qorxmaz?","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb söyləyəndə","poem":1},{"lineBreak":true},{"text":"Kim peyğəmbərlik etməz?","poem":1}]},{"type":"heading","content":["Samariyanın taleyi"]},{"type":"verse","number":9,"content":[{"text":"Aşdodun qalalarında,","poem":1},{"lineBreak":true},{"text":"Misir torpağının qalalarında belə elan edin:","poem":1},{"lineBreak":true},{"text":"“Samariya dağlarının üzərinə yığılın.","poem":1},{"lineBreak":true},{"text":"Oradakı böyük qarışıqlığı,","poem":1},{"lineBreak":true},{"text":"Onun içindəki təzyiqi görün”.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Hətta düz iş görməyi bacarmırlar.","poem":1},{"lineBreak":true},{"text":"Onlar qalalarına zorakılıqla,","poem":1},{"lineBreak":true},{"text":"Soyğunçuluqla qənimət yığır”.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ona görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Düşmən gəlib ölkəni mühasirəyə alacaq,","poem":1},{"lineBreak":true},{"text":"Səni gücdən salıb qalalarını qarət edəcək”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Çoban şir ağzından necə iki bud sümüyü","poem":1},{"lineBreak":true},{"text":"Yaxud qulağın bir parçasını çəkib qurtararsa,","poem":1},{"lineBreak":true},{"text":"Samariyada divan üzərində,","poem":1},{"lineBreak":true},{"text":"Dəməşqdə yataqda oturan","poem":1},{"lineBreak":true},{"text":"İsrail övladları da eləcə xilas olacaq”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Buna qulaq asın!","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinə xəbərdarlıq edin!”","poem":1},{"lineBreak":true},{"text":"Ordular Allahı Xudavənd Rəbb belə deyir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Mən İsraillilərə günahlarına görə cəza verəcəyim gün","poem":1},{"lineBreak":true},{"text":"Bet-Eldəki qurbangahı da cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"O qurbangahın buynuzları kəsilib yerə tullanacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən qış sarayı ilə yay sarayını yıxacağam,","poem":1},{"lineBreak":true},{"text":"Fil sümüyü ilə bəzənmiş evlər dağılacaq,","poem":1},{"lineBreak":true},{"text":"Böyük saraylar viran qalacaq” Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}