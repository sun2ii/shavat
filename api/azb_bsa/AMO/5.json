{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["İsrail üçün mərsiyə"]},{"type":"verse","number":1,"content":["Ey İsrail nəsli, sizin barənizdə mərsiyə kimi oxuduğum bu sözləri dinləyin!"]},{"type":"verse","number":2,"content":[{"text":"“İsrail zorlanmış bir qız kimi yıxılıb,","poem":1},{"lineBreak":true},{"text":"Bir daha qalxmayacaq.","poem":1},{"lineBreak":true},{"text":"Öz torpağı üstə atılıb,","poem":1},{"lineBreak":true},{"text":"Onu qaldıran yoxdur”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Çünki Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Bir şəhərdən min nəfər döyüşə çıxsa,","poem":1},{"lineBreak":true},{"text":"Yüz nəfəri sağ qalacaq,","poem":1},{"lineBreak":true},{"text":"Yüz adam döyüşə çıxsa,","poem":1},{"lineBreak":true},{"text":"İsrail nəslindən on nəfər sağ qalacaq”.","poem":1}]},{"type":"heading","content":["İsrail bəladan necə qurtara bilər"]},{"type":"verse","number":4,"content":[{"text":"Rəbb İsrail nəslinə belə deyir:","poem":1},{"lineBreak":true},{"text":"“Mənə tərəf dönün ki, sağ qalasınız!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bet-Elə dönməyin,","poem":1},{"lineBreak":true},{"text":"Qilqala getməyin,","poem":1},{"lineBreak":true},{"text":"Beer-Şevaya keçməyin,","poem":1},{"lineBreak":true},{"text":"Çünki sürgün olunmaq hökmən Qilqala gəlir,","poem":1},{"lineBreak":true},{"text":"Bet-El bir heçə dönəcək”.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbbə tərəf dönün ki, sağ qalasınız!","poem":1},{"lineBreak":true},{"text":"Yoxsa O, Yusif nəslini od kimi yandırıb-yaxacaq,","poem":1},{"lineBreak":true},{"text":"Bet-Eldəki odu söndürən olmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey ədaləti çevirib acı yovşan edənlər,","poem":1},{"lineBreak":true},{"text":"Ey salehliyi yerə vurub tapdalayanlar!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Odur Ülkər və Orion bürclərini yaradan,","poem":1},{"lineBreak":true},{"text":"Qaranlığı aydın səhərə çevirən,","poem":1},{"lineBreak":true},{"text":"Gündüzü gecə edib qaraldan,","poem":1},{"lineBreak":true},{"text":"Dəniz sularını götürüb yer üzünə tökən –","poem":1},{"lineBreak":true},{"text":"Onun adı Rəbdir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Güclüləri ildırım kimi məhv edər,","poem":1},{"lineBreak":true},{"text":"Qalalarını viran edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siz isə haqsızlığa etirazını bildirənlərə,","poem":1},{"lineBreak":true},{"text":"Düz danışanlara nifrət edirsiniz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kasıbı ayaq altına saldığınıza görə,","poem":1},{"lineBreak":true},{"text":"Ondan taxıl qopardığınıza görə","poem":1},{"lineBreak":true},{"text":"Yonulmuş daşdan evlər tikib","poem":1},{"lineBreak":true},{"text":"Onların içində yaşamayacaqsınız.","poem":1},{"lineBreak":true},{"text":"Gözəl üzümlüklər salıb","poem":1},{"lineBreak":true},{"text":"Onların şərabını içməyəcəksiniz.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki cinayətlərinizin çox,","poem":1},{"lineBreak":true},{"text":"Günahlarınızın ağır olduğunu bilirəm.","poem":1},{"lineBreak":true},{"text":"Ey salehi incidənlər, rüşvət alanlar,","poem":1},{"lineBreak":true},{"text":"Möhtacların haqqını tapdalayanlar!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu zəmanə o qədər pisdir ki,","poem":1},{"lineBreak":true},{"text":"Ağlı başında olan susur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pislikdən yaxşılığa dönün ki, sağ qalasınız!","poem":1},{"lineBreak":true},{"text":"Beləcə iddia etdiyiniz kimi","poem":1},{"lineBreak":true},{"text":"Ordular Allahı Rəbb,","poem":1},{"lineBreak":true},{"text":"Həqiqətən, sizə yar olacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pisliyə nifrət edin,","poem":1},{"lineBreak":true},{"text":"Yaxşılığı sevin,","poem":1},{"lineBreak":true},{"text":"Məhkəmədə ədalətə üstünlük verin.","poem":1},{"lineBreak":true},{"text":"Bəlkə Ordular Allahı Rəbb","poem":1},{"lineBreak":true},{"text":"Qalan Yusif övladlarına lütf edər.","poem":1}]},{"type":"heading","content":["İsrail üçün fəğan"]},{"type":"verse","number":16,"content":[{"text":"Ordular Allahı Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Bütün meydanlardan fəğan qopacaq,","poem":1},{"lineBreak":true},{"text":"Bütün küçələrdə ah-zar edəcəklər.","poem":1},{"lineBreak":true},{"text":"Fəğan edən mərsiyə oxuyanlarla","poem":1},{"lineBreak":true},{"text":"Kəndlilər yas tutmağa çağırılacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bütün üzüm bağlarından da fəğan qopacaq,","poem":1},{"lineBreak":true},{"text":"Çünki aranızdan Mən keçəcəyəm” Rəbb belə deyir.","poem":1}]},{"type":"heading","content":["İsrailin saxta inamının aqibəti"]},{"type":"verse","number":18,"content":[{"text":"Vay halınıza, ey Rəbbin gününün həsrətini çəkənlər!","poem":1},{"lineBreak":true},{"text":"Rəbbin günü siz nə əldə edəcəksiniz?","poem":1},{"lineBreak":true},{"text":"İşıq yox, qaranlıq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Şirdən qaçan adamın qarşısına ayı necə çıxarsa","poem":1},{"lineBreak":true},{"text":"Yaxud evə gəlib əlini divara dayayanı ilan necə çalarsa,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rəbbin günü də eləcə işıq yox, qaranlıq olmayacaqmı?","poem":1},{"lineBreak":true},{"text":"O, zülmətdir, onda nur yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Bayramlarınıza nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Xor baxıram,","poem":1},{"lineBreak":true},{"text":"Təntənəli toplantılarınızdan iyrənirəm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mənə yandırma qurbanlarınızı,","poem":1},{"lineBreak":true},{"text":"Taxıl təqdimlərinizi gətirsəniz də, razı qalmayacağam.","poem":1},{"lineBreak":true},{"text":"Mənə kökəldilmiş heyvanlarınızdan","poem":1},{"lineBreak":true},{"text":"Ünsiyyət qurbanı təqdim etsəniz də,","poem":1},{"lineBreak":true},{"text":"Onlara nəzər salmayacağam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gurultulu ilahilərinizi Məndən uzaq edin!","poem":1},{"lineBreak":true},{"text":"Çənglərinizin səsinə qulaq asmayacağam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lakin qoy ədalət sular kimi tökülsün,","poem":1},{"lineBreak":true},{"text":"Salehlik davamlı sel kimi axsın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ey İsrail nəsli,","poem":1},{"lineBreak":true},{"text":"Qırx il çöldə olanda Mənə qurban və təqdimlər gətirmişdinizmi?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Öz düzəltdiyiniz saxta Sakkut padşahınızı,","poem":1},{"lineBreak":true},{"text":"Kiyun bütlərinizi, ulduz allahlarınızı gəzdirmişdinizmi?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Elə buna görə də sizi","poem":1},{"lineBreak":true},{"text":"Dəməşqin o tayına sürgünə aparacağam” Rəbb belə deyir.","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Allahıdır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}