{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["İsrailin nahaq yerə gücə arxalanması"]},{"type":"verse","number":1,"content":[{"text":"Vay halınıza, ey Sionda laqeyd olanlar,","poem":1},{"lineBreak":true},{"text":"Samariya dağında arxayın oturanlar,","poem":1},{"lineBreak":true},{"text":"İsrail nəslinin müraciət etdiyi","poem":1},{"lineBreak":true},{"text":"Millətlər arasında adlı-sanlılar!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kalneyə keçib görün,","poem":1},{"lineBreak":true},{"text":"Oradan böyük Xamata gedin,","poem":1},{"lineBreak":true},{"text":"Filiştlilərin Qat şəhərinə gəlin.","poem":1},{"lineBreak":true},{"text":"Onların halı bu ölkələrdən daha yaxşıdırmı?","poem":1},{"lineBreak":true},{"text":"Onların ərazisi sizinkindən böyükdürmü?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vay halınıza, ey bəla gününü uzaq sanıb","poem":1},{"lineBreak":true},{"text":"Zorakılığı taxtına yaxınlaşdıranlar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey fil dişi ilə bəzənmiş çarpayılarda yayxanıb,","poem":1},{"lineBreak":true},{"text":"Yataqlarda uzanıb,","poem":1},{"lineBreak":true},{"text":"Sürüdəki quzulardan,","poem":1},{"lineBreak":true},{"text":"Axurun yanındakı danalardan götürüb yeyənlər!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çəng çalıb bədahətən oxuyanlar,","poem":1},{"lineBreak":true},{"text":"Guya Davud kimi musiqi alətləri ilə nəğmə deyənlər,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Piyalə-piyalə şərab içənlər,","poem":1},{"lineBreak":true},{"text":"Bədənlərinə əla yağlar sürtənlər,","poem":1},{"lineBreak":true},{"text":"Lakin Yusif nəslinin qırğınına görə","poem":1},{"lineBreak":true},{"text":"Narahat olmayanlar!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bundan ötrü indi sürgünə","poem":1},{"lineBreak":true},{"text":"Başda siz gedəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Keflənib yayxananların ziyafəti başa çatacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xudavənd Rəbb Öz haqqına and içir,","poem":1},{"lineBreak":true},{"text":"Ordular Allahı Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Yaqub nəslinin qüruruna nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Qalalarından zəhləm gedir.","poem":1},{"lineBreak":true},{"text":"İçində olanlarla birlikdə","poem":1},{"lineBreak":true},{"text":"Paytaxtlarını təslim edəcəyəm”.","poem":1}]},{"type":"verse","number":9,"content":["Əgər bir evdə on nəfər qalsa, onlar da öləcək."]},{"type":"verse","number":10,"content":["Ölən bir nəfərin qohumu onun cəsədini götürüb yandırmaq üçün gələcək. Evin içində olana “Yanında kim var?” deyə soruşanda, o da “heç kim” söyləyəcək. Onda o qohum belə deyəcək: “Sus, Rəbbin adını çəkmək olmaz”."]},{"type":"verse","number":11,"content":["Çünki Rəbb əmr edəndə böyük evlər parça-parça olub yıxılacaq, kiçik komalar da qırıq-qırıq olub dağılacaq."]},{"type":"verse","number":12,"content":[{"text":"Qaya üzərində atlar çaparmı?","poem":1},{"lineBreak":true},{"text":"Orada kim öküzlərlə kotan sürər?","poem":1},{"lineBreak":true},{"text":"Siz isə ədaləti zəhərə döndərmisiniz,","poem":1},{"lineBreak":true},{"text":"Bəraəti də acıya çevirmisiniz.","poem":1}]},{"type":"verse","number":13,"content":["Ey Lo-Devarı",{"noteId":0},"tutub “Qarnayimi",{"noteId":1},"öz gücümüzlə almadıqmı?” deyərək lovğalananlar!"]},{"type":"verse","number":14,"content":["Ordular Allahı Rəbb belə bəyan edir: “Budur, ey İsrail nəsli! Mən sizə qarşı bir millət çıxarıram. Xamat keçidindən Arava vadisinə qədər onlar sizə zülm edəcək”."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Lo-Devar – ibrani dilində heç nə.","reference":{"chapter":6,"verse":13}},{"noteId":1,"caller":"+","text":"Qarnayim – ibrani dilində buynuzlar, yəni güclü.","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/azb_bsa/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}