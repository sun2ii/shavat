{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Yay meyvəsi barəsində görüntü"]},{"type":"verse","number":1,"content":["Xudavənd Rəbb mənə belə bir görüntü göstərdi: budur, bir səbət yay meyvəsi gördüm."]},{"type":"verse","number":2,"content":["O məndən soruşdu: “Amos, sən nə görürsən?” Mən cavab verdim: “Bir səbət yay meyvəsi”. Rəbb mənə dedi:",{"text":"“Xalqım İsrailin axır günü yetişib.","poem":1},{"lineBreak":true},{"text":"Artıq onlardan əl çəkməyəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Həmin gün saray nəğmələri fəryada çevriləcək.","poem":1},{"lineBreak":true},{"text":"Meyit meyit üstə düşəcək, hər tərəfə atılacaq.","poem":1},{"lineBreak":true},{"text":"Sonra sükut olacaq”.","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb belə bəyan edir.","poem":1}]},{"type":"heading","content":["Allah İsrailə cəza verəcək"]},{"type":"verse","number":4,"content":["Siz, ey möhtacları tapdalayıb əzənlər, ey kasıbların başını yeyənlər, indi buna qulaq asın!"]},{"type":"verse","number":5,"content":["Deyirsiniz: “Təzə Ay mərasimi nə vaxt sona çatacaq ki, taxılı başqasına sataq? Şənbə günü nə vaxt qurtaracaq ki, buğdanı satışa qoyaq? Qoy ölçünü azaldaq, qiyməti də artıraq, aldadıcı tərəzi quraq."]},{"type":"verse","number":6,"content":["Qoy yoxsulları pula, möhtacları bir cüt çarığa satın alaq, buğdanın tör-töküntüsünü də sataq”."]},{"type":"verse","number":7,"content":["Yaqubun fəxri olan Rəbb belə and içmişdir: “Onların bütün işlərini heç vaxt unutmayacağam”."]},{"type":"verse","number":8,"content":["Bundan ötrü deyilmi ki, yer titrəyəcək, orada yaşayan hər kəs yasa batacaq? Bəli, bütün yer Nil çayı kimi qabaracaq, Misirdəki Nil çayı kimi coşandan sonra çəkiləcək."]},{"type":"verse","number":9,"content":[{"text":"Xudavənd Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Həmin gün günorta günəşi batıracağam,","poem":1},{"lineBreak":true},{"text":"Yer üzündə gündüzü qaraldacağam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bayramlarınızı yasa döndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün mahnılarınızı mərsiyəyə çevirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Hər kəsin belinə çul büründürəcəyəm,","poem":1},{"lineBreak":true},{"text":"Hər başın saçını qırxdıracağam.","poem":1},{"lineBreak":true},{"text":"Yeganə oğula yas tutulan kimi","poem":1},{"lineBreak":true},{"text":"O günü sona qədər acı edəcəyəm”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xudavənd Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Budur, elə günlər gələcək ki,","poem":1},{"lineBreak":true},{"text":"Ölkəyə qıtlıq göndərəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bu günlərdə çörək və suyun qıtlığı deyil,","poem":1},{"lineBreak":true},{"text":"Rəbbin sözlərinin qıtlığı olacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İnsanlar Rəbbin sözünü axtaracaq.","poem":1},{"lineBreak":true},{"text":"Dənizdən-dənizə,","poem":1},{"lineBreak":true},{"text":"Şimaldan şərqə qədər","poem":1},{"lineBreak":true},{"text":"Sürətlə gəzib-dolaşacaqlar,","poem":1},{"lineBreak":true},{"text":"Lakin onu tapmayacaqlar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Həmin gün gözəl qızlar, igid oğlanlar","poem":1},{"lineBreak":true},{"text":"Susuzluqdan qəşş edəcəklər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Samariyanın bütlərə and içib","poem":1},{"lineBreak":true},{"text":"‹Ey Dan, allahının haqqı!›,","poem":1},{"lineBreak":true},{"text":"‹Beer-Şevaya gedən yol haqqı!› deyən adamlar","poem":1},{"lineBreak":true},{"text":"Yıxılacaq və bir daha qalxmayacaq”.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}