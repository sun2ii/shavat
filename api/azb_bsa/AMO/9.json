{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"AMO","translationId":"azb_bsa","name":"AMOS","commonName":"AMOS","title":"AMOS PEYĞƏMBƏRİN KİTABI","order":30,"numberOfChapters":9,"sha256":"adcfc6e326d706eb002406a73d2215b3de4bf4d1e8cb67355c959a93b8099098","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/azb_bsa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Xudavəndi qurbangah yanında duran gördüm. O dedi:",{"text":"“Sütun başlıqlarını elə vur ki,","poem":1},{"lineBreak":true},{"text":"Astanalar sarsılsın.","poem":1},{"lineBreak":true},{"text":"Binanı hamının başına uçur.","poem":1},{"lineBreak":true},{"text":"Sağ qalanları Mən qılıncdan keçirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onlardan heç kim qaçıb qurtula bilməz.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ölülər diyarına girsələr belə,","poem":1},{"lineBreak":true},{"text":"Onları orada ələ keçirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Göylərə qalxsalar belə,","poem":1},{"lineBreak":true},{"text":"Onları endirəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Karmel dağının təpəsində gizlənsələr belə,","poem":1},{"lineBreak":true},{"text":"Onları axtarıb oradan götürəcəyəm.","poem":1},{"lineBreak":true},{"text":"Gözümdən yayınıb dənizin dibinə girsələr belə,","poem":1},{"lineBreak":true},{"text":"İlana əmr edəcəyəm ki, onları sancsın.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Düşmən önündə əsir aparılsalar belə,","poem":1},{"lineBreak":true},{"text":"Qılınca əmr edəcəyəm ki, onları qırsın.","poem":1},{"lineBreak":true},{"text":"Gözlərimi yaxşılıq üçün deyil,","poem":1},{"lineBreak":true},{"text":"Pislik üçün onların üzərinə dikəcəyəm”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ordular Rəbbi Xudavənd toxunub yeri titrədər,","poem":1},{"lineBreak":true},{"text":"Orada yaşayan hər kəsi yasa batırar,","poem":1},{"lineBreak":true},{"text":"Bütün yer Nil çayı kimi qabarar,","poem":1},{"lineBreak":true},{"text":"Misirdəki Nil çayı kimi çəkilər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Otaqlarını göylərdə tikən,","poem":1},{"lineBreak":true},{"text":"Qübbəsini yer üzündə quran,","poem":1},{"lineBreak":true},{"text":"Dəniz sularını götürüb yer üzünə tökən Odur –","poem":1},{"lineBreak":true},{"text":"Onun adı Rəbdir.","poem":1}]},{"type":"heading","content":["Məhvdən sonra bərpa"]},{"type":"verse","number":7,"content":["Rəbb bəyan edir: “Ey İsraillilər! Mənim üçün Kuşlular kimi deyilsinizmi? Siz İsrailliləri Misir torpağından çıxaran kimi Filiştliləri Kaftordan, Aramlıları Qirdən çıxarmadımmı?"]},{"type":"verse","number":8,"content":["Budur, Xudavənd Rəbbin gözləri bu günahkar ölkəyə dikilir. Onları yer üzündən silib-atacağam. Amma Yaqub nəslini tamamilə silib-atmayacağam” Rəbb belə bəyan edir."]},{"type":"verse","number":9,"content":["“Çünki, budur, Mən belə əmr edirəm: Mən İsrail nəslini bütün millətlər arasında xəlbirdən keçirəcəyəm. Xəlbirləyəndə bir çınqıl belə, yerə düşməyəcək."]},{"type":"verse","number":10,"content":["Xalqımdan bütün günah işlədənlər, Mənə ‹bəla bizə yaxınlaşmaz, bizə rast gəlməz› deyənlərin hamısı qılıncdan keçiriləcək."]},{"type":"verse","number":11,"content":["Həmin gün Davudun yıxılan çadırını bərpa edəcəyəm. Onun dəlmə-deşiklərini tutub cırılan yerlərini tikəcəyəm. Onu əvvəlki halına salacağam,"]},{"type":"verse","number":12,"content":["ona görə ki qalan Edomlulara və Mənim adımla çağırılan bütün millətlərə sahib olsunlar” Rəbb belə bəyan edir."]},{"type":"verse","number":13,"content":[{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Budur, elə günlər gələcək ki,","poem":1},{"lineBreak":true},{"text":"Kotan sürən biçinçiyə yetişəcək,","poem":1},{"lineBreak":true},{"text":"Üzüm sıxan meynə əkənlə rastlaşacaq,","poem":1},{"lineBreak":true},{"text":"Dağlardan şirin şərab damacaq,","poem":1},{"lineBreak":true},{"text":"Bütün təpələrdən də axacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xalqım İsraili əsirlikdən qaytaracağam,","poem":1},{"lineBreak":true},{"text":"Viran şəhərləri tikib məskən salacaqlar.","poem":1},{"lineBreak":true},{"text":"Üzümlüklər əkib şərabını içəcəklər,","poem":1},{"lineBreak":true},{"text":"Bağlar salıb meyvəsindən yeyəcəklər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onları özlərinin torpağında yerləşdirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlara verdiyim torpaqdan bir daha kənara atılmayacaqlar” Allahın Rəbb belə deyir».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}