{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"DEU","translationId":"azb_bsa","name":"QANUNUN TƏKRARI","commonName":"QANUNUN TƏKRARI","title":"QANUNUN TƏKRARI KİTABI","order":5,"numberOfChapters":34,"sha256":"b6dc86373ae9e3f94125951aaf62b37fbf0d5c7b6c02e433d1f09b9c2f18e0f8","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/azb_bsa/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"«Ey göylər, qulaq asın, söyləyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qoy yer üzü dilimdən çıxan sözləri eşitsin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy təlimim yağış kimi tökülsün,","poem":1},{"lineBreak":true},{"text":"Sözüm şeh kimi düşsün,","poem":1},{"lineBreak":true},{"text":"Çəmən üzərinə düşən narın yağış tək olsun,","poem":1},{"lineBreak":true},{"text":"Ot üzərinə tökülən leysana oxşasın,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki Rəbbin ismini elan edəcəyəm!","poem":1},{"lineBreak":true},{"text":"Allahımızın əzəmətini mədh edin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O, işləri kamil Qayadır,","poem":1},{"lineBreak":true},{"text":"Çünki bütün yolları haqdır,","poem":1},{"lineBreak":true},{"text":"Sadiq Allahdır, heç zaman haqsızlıq etməz,","poem":1},{"lineBreak":true},{"text":"Adil və doğru olan Odur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ona xəyanət etdilər,","poem":1},{"lineBreak":true},{"text":"Ona övlad olmadılar,","poem":1},{"lineBreak":true},{"text":"Ona görə rüsvay oldular.","poem":1},{"lineBreak":true},{"text":"Çünki əyri və tərs nəsildirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey axmaq, ağılsız xalq,","poem":1},{"lineBreak":true},{"text":"Rəbbə budurmu əvəziniz?","poem":1},{"lineBreak":true},{"text":"Sizi yaradan, sizə görkəm verən","poem":1},{"lineBreak":true},{"text":"Atanız, Yaradanınız O deyilmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ötən günləri yadınıza salın,","poem":1},{"lineBreak":true},{"text":"Keçmiş nəsillərin dövrünə nəzər salın,","poem":1},{"lineBreak":true},{"text":"Atanızdan soruşun, o sizə desin,","poem":1},{"lineBreak":true},{"text":"Ağsaqqallarınızdan soruşun, onlar sizə söyləsin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Haqq-Taala millətlərə irsi torpaq bölərkən,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarını ayırarkən","poem":1},{"lineBreak":true},{"text":"İsrail övladlarının sayına görə","poem":1},{"lineBreak":true},{"text":"Xalqlara sərhəd qoydu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki Rəbbin payı Öz xalqıdır!","poem":1},{"lineBreak":true},{"text":"Yaqub Onun payına düşən irsidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Onu quraq bir torpaqda,","poem":1},{"lineBreak":true},{"text":"Uğultulu, boş-biyaban səhrada tapdı.","poem":1},{"lineBreak":true},{"text":"Bir sipər kimi onu hifz etdi,","poem":1},{"lineBreak":true},{"text":"Göz bəbəyi kimi onu qorudu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yuvasında balalarını sövq etdirərək uçuran,","poem":1},{"lineBreak":true},{"text":"Onlar üzərində qanad çalan,","poem":1},{"lineBreak":true},{"text":"Qanadlarını açıb onları tutan,","poem":1},{"lineBreak":true},{"text":"Pərlərinin üzərində aparan qartal kimi","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ona yol göstərən yalnız Rəbb idi.","poem":1},{"lineBreak":true},{"text":"Yanında özgə bir allah yox idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Onu yer üzünün yüksəkliklərinə çıxartdı,","poem":1},{"lineBreak":true},{"text":"Zəminin məhsulundan yedirtdi.","poem":1},{"lineBreak":true},{"text":"Onu qayadan süzülən balla,","poem":1},{"lineBreak":true},{"text":"Çaxmaq daşından çəkilən yağla bəslədi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onu inəklərin kəsmiyi, qoyunların südü ilə,","poem":1},{"lineBreak":true},{"text":"Kökəldilmiş quzularla,","poem":1},{"lineBreak":true},{"text":"Başandakı təkələrlə, qoçlarla.","poem":1},{"lineBreak":true},{"text":"Ən yaxşı buğda ilə bəslədi.","poem":1},{"lineBreak":true},{"text":"Xalq şərabı, üzümün al qanını içdi,","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lakin Yeşurun","poem":1},{"noteId":2},{"text":"kökələrkən təpik atdı,","poem":1},{"lineBreak":true},{"text":"Doyarkən, yoğunlaşıb piyləşərkən","poem":1},{"lineBreak":true},{"text":"Onu yaradan Allahı tərk etdi,","poem":1},{"lineBreak":true},{"text":"Xilaskarını, Qayasını rədd etdi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yad allahlarla Allahı qısqandırdılar,","poem":1},{"lineBreak":true},{"text":"İyrənc əməllərlə Onu qəzəbləndirdilər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Allah olmayan cinlərə,","poem":1},{"lineBreak":true},{"text":"Tanımadıqları allahlara,","poem":1},{"lineBreak":true},{"text":"Atalarının qorxmadıqları,","poem":1},{"lineBreak":true},{"text":"Son zamanlar yeni yaranan allahlara","poem":1},{"lineBreak":true},{"text":"Qurban kəsdilər.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sizi həyata gətirən Qayanı atdınız.","poem":1},{"lineBreak":true},{"text":"Sizi yaradan Allahı unutdunuz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rəbb bunu görəndə onları rədd etdi,","poem":1},{"lineBreak":true},{"text":"Çünki oğul və qızları Onu hiddətləndirdi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O dedi: “Bax onlardan Mənim üzüm dönəcək,","poem":1},{"lineBreak":true},{"text":"Onların aqibəti görüm necə olacaq?","poem":1},{"lineBreak":true},{"text":"Çünki onlar etimada layiq olmayan övladlar, azğın nəsildirlər.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Məni Allah olmayanlarla qısqandırdılar,","poem":1},{"lineBreak":true},{"text":"Boş bütləri ilə qəzəbləndirdilər.","poem":1},{"lineBreak":true},{"text":"Mən də onları xalq olmayanlarla qısqandıracağam,","poem":1},{"lineBreak":true},{"text":"Axmaq bir millətlə qəzəbləndirəcəyəm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki qəzəbimdən bir od alovlandı,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarı dibinəcən yandı.","poem":1},{"lineBreak":true},{"text":"Dünyanı və nemətlərini yeyib qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Dağların bünövrəsi odlanıb tutuşacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mən onların üzərinə bəlalar yığacağam,","poem":1},{"lineBreak":true},{"text":"Oxlarımı onlara tuşlayacağam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qıtlıqdan tükənəcək, qızdırmadan qırılacaqlar,","poem":1},{"lineBreak":true},{"text":"Vəbadan tələf olacaqlar.","poem":1},{"lineBreak":true},{"text":"Heyvanların dişlərini,","poem":1},{"lineBreak":true},{"text":"Torpaqda sürünən ilanların zəhərini","poem":1},{"lineBreak":true},{"text":"Onlara sarı göndərəcəyəm.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gənc oğlanı və qızı,","poem":1},{"lineBreak":true},{"text":"Südəmər körpəni, ağsaçlı insanı","poem":1},{"lineBreak":true},{"text":"Bayırdan qılınc, daxildən dəhşət məhv edəcək.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dedim: ‹Qoy onları uzaqlara dağıdım,","poem":1},{"lineBreak":true},{"text":"Onları insanların yaddaşından çıxarım›.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Lakin düşmənin istehzasından çəkindim,","poem":1},{"lineBreak":true},{"text":"İstəmədim ki, əleyhdarları yanlış anlayıb desinlər:","poem":1},{"lineBreak":true},{"text":"‹Bütün bu işləri Rəbb görməyib,","poem":1},{"lineBreak":true},{"text":"Özümüz zəfər qazanmışıq›”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Çünki onlar düşüncəsiz bir millətdir,","poem":1},{"lineBreak":true},{"text":"Necə də ağılsızdırlar.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Kaş ki müdrik olub bunu dərk edəydilər,","poem":1},{"lineBreak":true},{"text":"Aqibətlərini düşünəydilər.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Əgər onların Qayası onları satmasaydı,","poem":1},{"lineBreak":true},{"text":"Rəbb onları təslim etməsəydi,","poem":1},{"lineBreak":true},{"text":"Bir adam min nəfəri necə qova bilərdi?","poem":1},{"lineBreak":true},{"text":"İki kişi on min nəfəri necə qaçıra bilərdi?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Həqiqətən, onların qayası Qayamız kimi deyil,","poem":1},{"lineBreak":true},{"text":"Hətta düşmənlərimiz bunu qəbul edir.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tənəkləri Sodomdakı üzüm ağaclarındandır,","poem":1},{"lineBreak":true},{"text":"Homorra bağlarındandır.","poem":1},{"lineBreak":true},{"text":"Üzümləri zəhərlidir,","poem":1},{"lineBreak":true},{"text":"Salxımları acıdır.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Şərabları əfi ilan zəhəridir,","poem":1},{"lineBreak":true},{"text":"Gürzələrin öldürücü ağısıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Məgər bunların hamısını Mən yanımda saxlamamışammı?","poem":1},{"lineBreak":true},{"text":"Bunları xəzinəmdə möhürləyən Mən deyiləmmi?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Qisas Mənimdir, əvəzini Mən verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Vaxtı çatarkən sürüşüb yıxılacaqlar,","poem":1},{"lineBreak":true},{"text":"Çünki onlar həlak gününə yaxındırlar,","poem":1},{"lineBreak":true},{"text":"Əcəlləri tez çatar”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Rəbb Öz xalqını mühakimə edəcək.","poem":1},{"lineBreak":true},{"text":"Onların gücünün qurtardığını görərkən,","poem":1},{"lineBreak":true},{"text":"Nə kölədən, nə azaddan kimsə qalmayarkən","poem":1},{"lineBreak":true},{"text":"Qullarına rəhm edəcək.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"O belə deyəcək: “Hanı onların Allahı, sığınacaqları qaya?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Qurbanlarının yağını yeyən,","poem":1},{"lineBreak":true},{"text":"Hanı içmə təqdimlərini içən allahları?","poem":1},{"lineBreak":true},{"text":"Qoy sizə kömək etmək üçün dursunlar,","poem":1},{"lineBreak":true},{"text":"Pənahgahınız olsunlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"İndi görün ki, Mən, Mən Oyam,","poem":1},{"lineBreak":true},{"text":"Məndən başqa Allah yoxdur.","poem":1},{"lineBreak":true},{"text":"Mənəm öldürən və həyat verən,","poem":1},{"lineBreak":true},{"text":"Mənəm yaralayan və şəfa verən,","poem":1},{"lineBreak":true},{"text":"Heç kim əlimdən qurtara bilməz.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Çünki əlimi göylərə qaldırıb belə bəyan edirəm:","poem":1},{"lineBreak":true},{"text":"‹Əbədi Varlığıma and olsun ki,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Şimşək çaxan qılıncımı itiləyib","poem":1},{"lineBreak":true},{"text":"Hökm etmək üçün əlimə alsam,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimdən qisas alacağam,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edənlərdən əvəz çıxacağam.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Onların qanı ilə oxlarımı sərxoş edəcəyəm;","poem":1},{"lineBreak":true},{"text":"Qılıncım əti, qırılanların, əsir edənlərin qanını,","poem":1},{"lineBreak":true},{"text":"Düşmən rəhbərlərinin başını yeyəcək›”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Ey millətlər, Onun xalqı ilə birgə sevinin!","poem":1},{"lineBreak":true},{"text":"Çünki O, qullarının qan qisasını alacaq,","poem":1},{"lineBreak":true},{"text":"Düşmənlərindən əvəz çıxacaq,","poem":1},{"lineBreak":true},{"text":"Ölkəsi və xalqı üçün kəffarə edəcək».","poem":1}]},{"type":"verse","number":44,"content":["Musa Nun oğlu Yeşua ilə bərabər gəlib bu ilahinin bütün sözlərini xalq qarşısında söylədi."]},{"type":"verse","number":45,"content":["Musa bütün İsraillilərə bu sözlərin hamısını söyləyib qurtaranda"]},{"type":"verse","number":46,"content":["belə dedi: «Bu gün sizə bəyan etdiyim sözlərin hamısına ürəkdən bağlanın ki, övladlarınıza bu qanunun bütün sözlərinə diqqətlə əməl etməyi əmr edəsiniz."]},{"type":"verse","number":47,"content":["Axı bu sizin üçün əhəmiyyətsiz iş deyil, həyatınızdır. Bu sözlər mülk olaraq almaq üçün İordan çayını keçərək gedəcəyiniz torpaqda sizə uzun ömür verəcək»."]},{"type":"heading","content":["Musanın ölümünün əvvəldən bildirilməsi"]},{"type":"verse","number":48,"content":["Rəbb elə həmin gün Musaya belə dedi:"]},{"type":"verse","number":49,"content":["«Yerixo qarşısında, Moav torpağında olan bu Avarim dağına, Nevo dağına çıx. İsrail övladlarına mülk olaraq verəcəyim Kənan torpağını gör."]},{"type":"verse","number":50,"content":["Qardaşın Harun Hor dağında ölüb əcdadlarına qoşulduğu kimi sən də çıxacağın dağda ölüb xalqına qovuşacaqsan."]},{"type":"verse","number":51,"content":["Çünki Zin səhrasında, Meriva-Qadeş sularında, İsrail övladlarının önündə Məni müqəddəs saymamaqla İsrail övladları arasında Mənə xəyanət etdiniz."]},{"type":"verse","number":52,"content":["Ona görə ölkəni uzaqdan görəcəksən, lakin İsrail övladlarına verəcəyim torpağa girməyəcəksən»."]}],"footnotes":[{"noteId":2,"caller":"+","text":"Yeşurun – İsrailin bir ləqəbi olub düz olan mənasını verir.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/azb_bsa/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}