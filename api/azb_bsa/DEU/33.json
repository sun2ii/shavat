{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"DEU","translationId":"azb_bsa","name":"QANUNUN TƏKRARI","commonName":"QANUNUN TƏKRARI","title":"QANUNUN TƏKRARI KİTABI","order":5,"numberOfChapters":34,"sha256":"b6dc86373ae9e3f94125951aaf62b37fbf0d5c7b6c02e433d1f09b9c2f18e0f8","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/azb_bsa/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Musanın İsrail qəbilələrinə xeyir-duası"]},{"type":"verse","number":1,"content":["Allah adamı Musa ölümündən əvvəl İsrail övladlarına bu xeyir-duanı oxudu."]},{"type":"verse","number":2,"content":["O belə dedi:",{"text":"«Rəbb Sina dağından gəldi,","poem":1},{"lineBreak":true},{"text":"Bizə Seirdən zühur etdi,","poem":1},{"lineBreak":true},{"text":"Paran dağından şəfəq saçdı,","poem":1},{"lineBreak":true},{"text":"On minlərlə müqəddəs mələklər ilə gəldi.","poem":1},{"lineBreak":true},{"text":"Sağ əlində yanar alov var idi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, həqiqətən, Sən xalqları sevirsən!","poem":1},{"lineBreak":true},{"text":"Bütün müqəddəslər Sənin əlindədir!","poem":1},{"lineBreak":true},{"text":"Onlar ayağına düşər, sözlərini dinlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Musa bizə qanuna əməl etməyi tapşırdı,","poem":1},{"lineBreak":true},{"text":"Bu, Yaqubun camaatı üçün bir irsdir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İsrail qəbilələri,","poem":1},{"lineBreak":true},{"text":"Xalqın rəhbərləri bir yerə yığılanda","poem":1},{"lineBreak":true},{"text":"Rəbb Yeşuruna padşah oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Qoy Ruven ölməsin, yaşasın!","poem":1},{"lineBreak":true},{"text":"Xalqının sayı azalmasın!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Musa Yəhuda üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, Yəhudanın səsini eşit,","poem":1},{"lineBreak":true},{"text":"Onu xalqına geri qaytar.","poem":1},{"lineBreak":true},{"text":"O özü üçün öz əlləri ilə döyüşdü,","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə görə ona kömək et!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Levi üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, Tummimin və Urimin","poem":1},{"lineBreak":true},{"text":"Sənin sadiq qulun üçündür.","poem":1},{"lineBreak":true},{"text":"Onu Massada sınaqdan keçirdin,","poem":1},{"lineBreak":true},{"text":"Onunla Meriva sularında mübahisə etdin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, ata-anası üçün dedi:","poem":1},{"lineBreak":true},{"text":"“Onlara nəzər salmadım”.","poem":1},{"lineBreak":true},{"text":"Qardaşlarını tanımadı,","poem":1},{"lineBreak":true},{"text":"Övladlarını unutdu,","poem":1},{"lineBreak":true},{"text":"Ancaq Sənin sözünə riayət etdi,","poem":1},{"lineBreak":true},{"text":"Sənin əhdini hifz etdi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hökmlərini Yaqub nəslinə,","poem":1},{"lineBreak":true},{"text":"Qanununu İsraillilərə öyrədəcəklər.","poem":1},{"lineBreak":true},{"text":"Onlar hüzurunda buxuru,","poem":1},{"lineBreak":true},{"text":"Qurbangahında bütöv yandırma qurbanını təqdim edəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ya Rəbb, onların malına bərəkət ver,","poem":1},{"lineBreak":true},{"text":"Əməllərindən razı qal.","poem":1},{"lineBreak":true},{"text":"Kim onlara hücum etsə,","poem":1},{"lineBreak":true},{"text":"Kim onlara nifrət etsə,","poem":1},{"lineBreak":true},{"text":"Belini qır,","poem":1},{"lineBreak":true},{"text":"Bir daha qalxmasınlar!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Binyamin üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Rəbbin sevimlisi","poem":1},{"lineBreak":true},{"text":"Onun yanında əmin-amanlıqda yaşasın!","poem":1},{"lineBreak":true},{"text":"Rəbb gün boyu onu qoruyur,","poem":1},{"lineBreak":true},{"text":"O da Rəbbin qucağında qalır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yusif üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Onun torpağı Rəbdən bərəkət alsın,","poem":1},{"lineBreak":true},{"text":"Göydən gələn qiymətli şehlə,","poem":1},{"lineBreak":true},{"text":"Yer altında yatan dərin sularla,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Günəşin yetişdirdiyi ən gözəl barlarla,","poem":1},{"lineBreak":true},{"text":"Hər ay yetişən ən gözəl bəhərlərlə,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qədimdən qalan dağların əla nemətləri ilə,","poem":1},{"lineBreak":true},{"text":"Əbədi təpələrin münbitliyi ilə,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yerin ən qiymətli məhsulu və bolluğu ilə,","poem":1},{"lineBreak":true},{"text":"Kolda məskən Salanın lütfü ilə","poem":1},{"lineBreak":true},{"text":"Qoy bərəkət alsın!","poem":1},{"lineBreak":true},{"text":"Yusifin başı üzərinə –","poem":1},{"lineBreak":true},{"text":"Qardaşlarından ayrı düşənin başı üzərinə","poem":1},{"lineBreak":true},{"text":"Qoy bərəkət yağsın!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"O, birinci doğulan buğa qədər heybətlidir,","poem":1},{"lineBreak":true},{"text":"Buynuzları çöl öküzünün buynuzlarına bənzəyir.","poem":1},{"lineBreak":true},{"text":"Bu buynuzlarla xalqları,","poem":1},{"lineBreak":true},{"text":"Yer üzünün qurtaracağınadək hər yerdə olanları vuracaq.","poem":1},{"lineBreak":true},{"text":"Bax belədir Efrayimin on minləri,","poem":1},{"lineBreak":true},{"text":"Bax budur Menaşşenin minləri».","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zevulun üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Ey Zevulun, yola düşəndə sevin,","poem":1},{"lineBreak":true},{"text":"Ey İssakar, çadırlarında sevin!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onlar xalqları dağa çağıracaqlar,","poem":1},{"lineBreak":true},{"text":"Orada salehlik qurbanları kəsəcəklər.","poem":1},{"lineBreak":true},{"text":"Bol dəniz nemətləri ilə,","poem":1},{"lineBreak":true},{"text":"Qumlarda gizlənən xəzinələrlə doyacaqlar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Qad üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Qadın ərazisini artırana şükür olsun!","poem":1},{"lineBreak":true},{"text":"Qad aslan tək yaşayır,","poem":1},{"lineBreak":true},{"text":"Qolu, başı qoparır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O özü üçün ilk torpağı seçdi.","poem":1},{"lineBreak":true},{"text":"Çünki onun üçün sərdarın payı saxlanıldı.","poem":1},{"lineBreak":true},{"text":"Xalq rəhbərləri yığılanda","poem":1},{"lineBreak":true},{"text":"Rəbbin ədalətini,","poem":1},{"lineBreak":true},{"text":"İsraillilərə gətirdiyi hökmləri icra etdi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dan üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Dan Başandan sıçrayan","poem":1},{"lineBreak":true},{"text":"Bala aslandır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Naftali üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Ey Rəbbin lütfü və bərəkəti ilə dolu olan Naftali,","poem":1},{"lineBreak":true},{"text":"Qərbi və cənubu mülk edəcəksən».","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Aşer üçün belə dedi:","poem":1},{"lineBreak":true},{"text":"«Oğullar arasında Aşer ən çox bərəkət alsın!","poem":1},{"lineBreak":true},{"text":"Qardaşlarının ən çox bəyəndiyi o olsun!","poem":1},{"lineBreak":true},{"text":"Ayağını zeytun yağına batırsın.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Darvazalarının cəftələri dəmirdən, tuncdan olsun,","poem":1},{"lineBreak":true},{"text":"Qüvvətin ömrün boyu qurtarmasın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ey Yeşurun, bax sənə kömək etmək üçün","poem":1},{"lineBreak":true},{"text":"Göylər və buludlara əzəməti ilə minən","poem":1},{"lineBreak":true},{"text":"Allahın bənzəri yoxdur.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Pənahgahın əzəli əbədi Allahdır,","poem":1},{"lineBreak":true},{"text":"Səni daim qollarında gəzdirər.","poem":1},{"lineBreak":true},{"text":"Düşmənlərini qarşından qovar,","poem":1},{"lineBreak":true},{"text":"“Yox et onları!” sənə deyər.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"İsrail əmin-amanlıqda yaşayır.","poem":1},{"lineBreak":true},{"text":"Taxıl və təzə şərab torpağında","poem":1},{"lineBreak":true},{"text":"Yaqubun çeşməsi sakit qalır,","poem":1},{"lineBreak":true},{"text":"Oraya göylərdən şeh damır.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ey İsrail! Nə bəxtiyarsan,","poem":1},{"lineBreak":true},{"text":"Sənin kimisi varmı?","poem":1},{"lineBreak":true},{"text":"Rəbbin qurtardığı xalqsan!","poem":1},{"lineBreak":true},{"text":"Rəbb sipərdir, köməyinə çatandır,","poem":1},{"lineBreak":true},{"text":"Əzəmətli qılıncındır.","poem":1},{"lineBreak":true},{"text":"Sənə düşmənlər yaltaqlanır,","poem":1},{"lineBreak":true},{"text":"Sən onların yuxarı yerlərini tapdalayırsan».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}