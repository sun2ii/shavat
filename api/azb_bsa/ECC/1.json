{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Hər şey puçdur"]},{"type":"verse","number":1,"content":["Bu, Yerusəlimdə padşahlıq edən Davud oğlu Vaizin sözləridir."]},{"type":"verse","number":2,"content":[{"text":"Vaiz deyir:","poem":1},{"lineBreak":true},{"text":"«Hər şey puçdur, puçdur, tamam puçdur!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İnsanın səma altında çəkdiyi","poem":1},{"lineBreak":true},{"text":"Bütün zəhmətlərinin nə faydası var?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bir nəsil gedir, o biri nəsil gəlir,","poem":1},{"lineBreak":true},{"text":"Amma dünya daim qalır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Günəş çıxır, günəş batır,","poem":1},{"lineBreak":true},{"text":"Sonra tələsik yerinə dönür ki,","poem":1},{"lineBreak":true},{"text":"Təzədən çıxsın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Külək cənub səmtinə əsir,","poem":1},{"lineBreak":true},{"text":"Sonra şimal səmtinə dönür.","poem":1},{"lineBreak":true},{"text":"Dönə-dönə gedir,","poem":1},{"lineBreak":true},{"text":"Öz yolunu təkrar edir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bütün çaylar dənizə axır,","poem":1},{"lineBreak":true},{"text":"Amma dəniz heç vaxt dolmur.","poem":1},{"lineBreak":true},{"text":"Axdıqları yerə qayıdırlar ki,","poem":1},{"lineBreak":true},{"text":"Təzədən axsınlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hər şey çətin başa gəlir.","poem":1},{"lineBreak":true},{"text":"Sözlər kifayət etmir,","poem":1},{"lineBreak":true},{"text":"Göz görməkdən doymur,","poem":1},{"lineBreak":true},{"text":"Qulaq da eşitməkdən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nə olubsa, yenə olacaq,","poem":1},{"lineBreak":true},{"text":"Nə edilibsə, yenə ediləcək.","poem":1},{"lineBreak":true},{"text":"Ona görə də səma altında tamam təzə bir şey yoxdur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məgər bir şey var ki,","poem":1},{"lineBreak":true},{"text":"Onun haqqında deyilsin:","poem":1},{"lineBreak":true},{"text":"“Bax bu təzə bir şeydir?”","poem":1},{"lineBreak":true},{"text":"O da çoxdan var imiş –","poem":1},{"lineBreak":true},{"text":"Bizim dövrümüzdən əvvəl.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əvvəlki şeylərdən heç nə xatırlanmır,","poem":1},{"lineBreak":true},{"text":"Gələcəkdə baş verən şeylərdən də","poem":1},{"lineBreak":true},{"text":"Bundan sonra gələnlər arasında","poem":1},{"lineBreak":true},{"text":"Heç nə xatırlanmayacaq.","poem":1}]},{"type":"heading","content":["Hikmətin puçluğu"]},{"type":"verse","number":12,"content":["Mən Vaiz Yerusəlimdə İsrailin padşahı idim."]},{"type":"verse","number":13,"content":["Ürəyimdə niyyət etdim ki, göylər altında edilən bütün işləri hikmətlə öyrənib araşdırım. Bu çətin işi üzərində zəhmət çəkmək üçün Allah insanlara verib."]},{"type":"verse","number":14,"content":["Səma altında edilən bütün işlərə nəzər saldım və bildim ki, onların hamısı puçdur, külək dalınca qaçmağa bənzər."]},{"type":"verse","number":15,"content":[{"text":"Əyri olan düz ola bilməz,","poem":1},{"lineBreak":true},{"text":"Əskik olan sayıla bilməz.","poem":1}]},{"type":"verse","number":16,"content":["Öz-özümə dedim: “Bax mən böyük adam olmuşam və məndən əvvəl Yerusəlimdə yaşayanların hamısından çox hikmət qazanmışam. Ağlımda çoxlu hikmət və bilik var”."]},{"type":"verse","number":17,"content":["Sonra ürəyimdə niyyət etdim ki, hikmətin nə olduğunu, dəlilik və axmaqlığın nə olduğunu öyrənim. Amma bildim ki, bu da külək dalınca qaçmağa bənzər."]},{"type":"verse","number":18,"content":[{"text":"Çünki hikmət çox olduqca","poem":1},{"lineBreak":true},{"text":"Kədər də çoxalır.","poem":1},{"lineBreak":true},{"text":"Bilik artdıqca","poem":1},{"lineBreak":true},{"text":"Dərd də artır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}