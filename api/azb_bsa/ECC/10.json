{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Ölü milçəklər ətirdüzəldənin yağını","poem":1},{"lineBreak":true},{"text":"İylədib xarab edər.","poem":1},{"lineBreak":true},{"text":"Kiçik ağılsızlıq da","poem":1},{"lineBreak":true},{"text":"Hikmət və hörmət sahibini rüsvay edər.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hikmətli adamın ürəyi düzlüyə tərəf yönələr,","poem":1},{"lineBreak":true},{"text":"Ağılsız adamın ürəyi əyriliyə.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O yol gedəndə də ağlının azlığı bilinər,","poem":1},{"lineBreak":true},{"text":"Ağılsız olduğunu hamıya göstərər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əgər hakimin qəzəbi sənə qarşı alovlansa,","poem":1},{"lineBreak":true},{"text":"Yerindən tərpənmə.","poem":1},{"lineBreak":true},{"text":"Çünki sakitlik","poem":1},{"lineBreak":true},{"text":"Böyük xətaların üstünü örtər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Səma altında bir dərd də gördüm:","poem":1},{"lineBreak":true},{"text":"O da hökmdarın əlindən çıxan səhvdir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ağılsızlar yüksək vəzifələrə qoyulur,","poem":1},{"lineBreak":true},{"text":"Halbuki varlılar aşağıda oturur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gördüm ki, qullar necə at üstündə,","poem":1},{"lineBreak":true},{"text":"Ağalar isə qul kimi piyada gedir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Quyu qazan içinə özü düşə bilər,","poem":1},{"lineBreak":true},{"text":"Divar sökəni ilan sanca bilər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Daş kəsəni daşlar yaralar,","poem":1},{"lineBreak":true},{"text":"Odun yarana odun xətər yetirər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əgər balta kütdürsə,","poem":1},{"lineBreak":true},{"text":"Onun ağzı itilənməyə verilməyibsə,","poem":1},{"lineBreak":true},{"text":"Daha çox güc sərf olunmalıdır.","poem":1},{"lineBreak":true},{"text":"Amma hikmət insanın köməyinə çatar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əgər ilan ovsun oxunmazdan qabaq sancsa,","poem":1},{"lineBreak":true},{"text":"Ovsunçu çağırmağın faydası yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hikmətli adamın ağzından lütfkar sözlər çıxar,","poem":1},{"lineBreak":true},{"text":"Lakin ağılsız öz dili ilə həlakına yol açar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onun dilindəki sözlər ağılsızlıqla başlanar,","poem":1},{"lineBreak":true},{"text":"Danışığının axırı da sarsaqlıqdır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ağılsız adam çox söz danışar.","poem":1},{"lineBreak":true},{"text":"Heç kəs nə olacağını bilməz.","poem":1},{"lineBreak":true},{"text":"Bəs kim ona özündən sonra","poem":1},{"lineBreak":true},{"text":"Nə olacağını deyə bilər?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ağılsızların çəkdikləri zəhmət","poem":1},{"lineBreak":true},{"text":"Özlərini yorar,","poem":1},{"lineBreak":true},{"text":"Onlar şəhərə gedən yolu da bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Əgər padşahın bir uşaqdırsa,","poem":1},{"lineBreak":true},{"text":"Başçıların səhər tezdən","poem":1},{"lineBreak":true},{"text":"Ziyafətə başlayırsa,","poem":1},{"lineBreak":true},{"text":"Onda vay halına, ey ölkə!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Əgər padşahın bir əsilzadədirsə,","poem":1},{"lineBreak":true},{"text":"Başçıların da vaxtında","poem":1},{"lineBreak":true},{"text":"Keflənmək üçün yox, qüvvətlənmək üçün yeyirsə,","poem":1},{"lineBreak":true},{"text":"Onda xoş halına, ey ölkə!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tənbəllik üzündən evin damı uçar,","poem":1},{"lineBreak":true},{"text":"Heç bir iş görməsən, evin tavanı damar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yemək şadlıq gətirər,","poem":1},{"lineBreak":true},{"text":"Şərab həyatı keflə doldurar,","poem":1},{"lineBreak":true},{"text":"Pul isə hər istəyini ödəyər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Padşahı hətta ürəyində də söymə,","poem":1},{"lineBreak":true},{"text":"Varlı adamı yataq otağında da lənətləmə.","poem":1},{"lineBreak":true},{"text":"Çünki göydə uçan quşlar xəbər aparar,","poem":1},{"lineBreak":true},{"text":"Qanadlı məxluqlar sənin sözünü çatdırar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}