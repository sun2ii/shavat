{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Zəhmətin qiyməti"]},{"type":"verse","number":1,"content":[{"text":"Çörəyini suların üzünə burax,","poem":1},{"lineBreak":true},{"text":"Çünki uzun müddət sonra yenə onu taparsan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yeddi ya səkkiz adama pay ver,","poem":1},{"lineBreak":true},{"text":"Çünki bilmirsən ki,","poem":1},{"lineBreak":true},{"text":"Ölkədə necə bir pis gün olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əgər buludlar su ilə dolu olsa,","poem":1},{"lineBreak":true},{"text":"Yağışlarını yer üzünə səpər.","poem":1},{"lineBreak":true},{"text":"Əgər bir ağac cənub ya şimal","poem":1},{"lineBreak":true},{"text":"Səmtinə yıxılsa,","poem":1},{"lineBreak":true},{"text":"Elə yıxıldığı yerdə də qalar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Küləyə baxan toxum səpməz,","poem":1},{"lineBreak":true},{"text":"Buludlara baxan əkdiyini biçməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Küləyin səmtini,","poem":1},{"lineBreak":true},{"text":"Hamilə qadının qarnında","poem":1},{"lineBreak":true},{"text":"Sümüklərin necə böyüdüyünü bilmədiyin kimi","poem":1},{"lineBreak":true},{"text":"Hər şeyi yaradan","poem":1},{"lineBreak":true},{"text":"Allahın işlərindən də xəbərsizsən.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toxumunu səhər vaxtı səp,","poem":1},{"lineBreak":true},{"text":"Axşama qədər də əlin boş durmasın.","poem":1},{"lineBreak":true},{"text":"Çünki bilmirsən ki, əvvəlki məhsuldar olacaq","poem":1},{"lineBreak":true},{"text":"Yoxsa sonrakı","poem":1},{"lineBreak":true},{"text":"Yaxud hər ikisi birlikdə.","poem":1}]},{"type":"heading","content":["Yaradanı unutma"]},{"type":"verse","number":7,"content":[{"text":"Həqiqətən, işıq gözəldir,","poem":1},{"lineBreak":true},{"text":"Günəşi görmək gözlərə xoşdur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əgər insan uzun ömür sürürsə,","poem":1},{"lineBreak":true},{"text":"Qoy sevinclə yaşasın.","poem":1},{"lineBreak":true},{"text":"Ancaq qaranlıq günlərinin də olduğunu unutmasın,","poem":1},{"lineBreak":true},{"text":"Çünki onlar daha çox olacaq.","poem":1},{"lineBreak":true},{"text":"Baş verəcək hər şey puçdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey gənc, cavanlığında sevin,","poem":1},{"lineBreak":true},{"text":"Qoy ürəyin səni cavanlıq günlərində sevindirsin.","poem":1},{"lineBreak":true},{"text":"Ürəyinin istədiyi ilə,","poem":1},{"lineBreak":true},{"text":"Gözlərinin gördüyü ilə get.","poem":1},{"lineBreak":true},{"text":"Ancaq bil ki, Allah","poem":1},{"lineBreak":true},{"text":"Bunların hamısına görə","poem":1},{"lineBreak":true},{"text":"Səni mühakimə edəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buna görə də təşvişi ürəyindən qov,","poem":1},{"lineBreak":true},{"text":"Əzabı bədənindən uzaqlaşdır.","poem":1},{"lineBreak":true},{"text":"Çünki cavanlıq da,","poem":1},{"lineBreak":true},{"text":"Cavanlıqdakı güc də puçdur.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}