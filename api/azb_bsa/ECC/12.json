{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Pis günlər gəlməzdən qabaq,","poem":1},{"lineBreak":true},{"text":"“Onlardan zövq almıram” deyəcəyin illər","poem":1},{"lineBreak":true},{"text":"Yaxınlaşmazdan əvvəl,","poem":1},{"lineBreak":true},{"text":"Cavanlıq günlərində","poem":1},{"lineBreak":true},{"text":"Səni Yaradanı xatırla.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Günəş, işıq, ay və ulduzlar sönməzdən əvvəl,","poem":1},{"lineBreak":true},{"text":"Yağışdan sonra buludlar yenə qayıtmazdan əvvəl","poem":1},{"lineBreak":true},{"text":"Onu xatırla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O gün gələndə","poem":1},{"lineBreak":true},{"text":"Evi qoruyanlar tir-tir əsəcək,","poem":1},{"lineBreak":true},{"text":"Güclülər əyiləcək,","poem":1},{"lineBreak":true},{"text":"Əl dəyirmanı ilə işləyənlər","poem":1},{"lineBreak":true},{"text":"Az olduqları üçün","poem":1},{"lineBreak":true},{"text":"Dən üyüdə bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Pəncərədən baxanlar qaralacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Küçəyə açılan qapılar bağlanacaq,","poem":1},{"lineBreak":true},{"text":"Dəyirmanların səsi kəsiləcək.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Adamlar quş səsi ilə oyanacaq,","poem":1},{"lineBreak":true},{"text":"Nəğmə oxuyan bütün qızların səsini","poem":1},{"lineBreak":true},{"text":"Zəif eşidəcəklər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O zaman onlar uca yerdən qorxacaq,","poem":1},{"lineBreak":true},{"text":"Yolda yerimək də təhlükəli olur.","poem":1},{"lineBreak":true},{"text":"Bax badam ağacı çiçək verir,","poem":1},{"lineBreak":true},{"text":"Çəyirtkə özünü güclə çəkir,","poem":1},{"lineBreak":true},{"text":"Həvəsi zəifləyir.","poem":1},{"lineBreak":true},{"text":"Beləcə insan son mənzilə gedir,","poem":1},{"lineBreak":true},{"text":"Yas tutanlar küçələrə düşür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gümüş iplər qopmamış,","poem":1},{"lineBreak":true},{"text":"Qızıl kasa qırılmamış,","poem":1},{"lineBreak":true},{"text":"Bulaq başında kuzə tikə-tikə olmamış,","poem":1},{"lineBreak":true},{"text":"Quyu yanında çarx sınmamış,","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Torpaq gəldiyi yerə qayıtmamış,","poem":1},{"lineBreak":true},{"text":"Həyat nəfəsi isə onu verən Allaha dönməmiş","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Səni Yaradanı xatırla».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vaiz deyir:","poem":1},{"lineBreak":true},{"text":"«Hər şey puçdur, tamam puçdur».","poem":1}]},{"type":"heading","content":["Son söz"]},{"type":"verse","number":9,"content":["Vaiz hikmətli adam olmaqdan başqa, xalqa bilik də öyrədirdi. O bir çox məsəlləri araşdırıb axtardı və tərtib etdi."]},{"type":"verse","number":10,"content":["Vaiz faydalı sözlər tapmağa çalışdı. Onun yazdıqları düzgün və doğrudur."]},{"type":"verse","number":11,"content":["Hikmətlilərin sözləri çoban çubuğu kimi, topladıqları sözləri bərk vurulmuş mıxlar kimidir; o sözlər bir Çoban tərəfindən verilir."]},{"type":"verse","number":12,"content":[{"text":"Bunlardan başqa, oğlum, sən buna diqqət et ki,","poem":1},{"lineBreak":true},{"text":"Çox kitab yazmağın axırı yoxdur,","poem":1},{"lineBreak":true},{"text":"Çox oxumaq adamı yorur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hər şey aşkar oldu,","poem":1},{"lineBreak":true},{"text":"Nəticə bundan ibarətdir:","poem":1},{"lineBreak":true},{"text":"Allahdan qorx,","poem":1},{"lineBreak":true},{"text":"Onun əmrlərini yerinə yetir.","poem":1},{"lineBreak":true},{"text":"Bəli, insanın əsas vəzifəsi budur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki Allah hər işi, gizli olan hər şeyi –","poem":1},{"lineBreak":true},{"text":"İstər yaxşı olsun, istər pis –","poem":1},{"lineBreak":true},{"text":"Mühakimə edəcək.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Burada rəmzi izah mümkündür: evi qoruyanlar – əl-qol, güclülər – ayaqlar, əl dəyirmanı ilə işləyənlər – dişlər, pəncərədən baxanlar – gözlər, küçəyə açılan qapılar – qulaqlar, dəyirmanlar – dişlər mənasını verə bilər.","reference":{"chapter":12,"verse":4}},{"noteId":2,"caller":"+","text":"Bu sözlər insanın bədən üzvlərinin çürüməsini təsvir edən rəmzi ifadələr də ola bilər.","reference":{"chapter":12,"verse":6}},{"noteId":3,"caller":"+","text":"Bax: Yar. 2:7.","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/azb_bsa/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}