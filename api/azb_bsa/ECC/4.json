{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Dünyanın əziyyətləri"]},{"type":"verse","number":1,"content":[{"text":"Mən yenə səma altında edilən","poem":1},{"lineBreak":true},{"text":"Bütün zülmləri gördüm:","poem":1},{"lineBreak":true},{"text":"Məzlumların göz yaşlarını gördüm,","poem":1},{"lineBreak":true},{"text":"Onlara təsəlli verən yox idi,","poem":1},{"lineBreak":true},{"text":"Qüdrət zalımların əlində idi,","poem":1},{"lineBreak":true},{"text":"Məzlumlara təsəlli verən yox idi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çoxdan ölüb getmiş adamları","poem":1},{"lineBreak":true},{"text":"Hələ diri qalanlardan daha xoşbəxt saydım.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bunlardan da xoşbəxt o adamdır ki,","poem":1},{"lineBreak":true},{"text":"Hələ dünyaya gəlməyib,","poem":1},{"lineBreak":true},{"text":"Səma altında edilən pisliyi görməyib.","poem":1}]},{"type":"verse","number":4,"content":["Mən gördüm ki, bir adamın çəkdiyi bütün zəhmətlər, yaxşı gedən bütün işlər qonşusunda qısqanclıqdan həvəs yaradır. Bu da puçdur, külək dalınca qaçmağa bənzər."]},{"type":"verse","number":5,"content":[{"text":"Ağılsız adam əlini qoynuna qoyur,","poem":1},{"lineBreak":true},{"text":"Öz canını üzür.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bir ovuc dolusunun gətirdiyi rahatlıq","poem":1},{"lineBreak":true},{"text":"İki ovuc dolusunun gətirdiyi","poem":1},{"lineBreak":true},{"text":"Zəhmətdən və külək dalınca qaçmaqdan yaxşıdır.","poem":1}]},{"type":"verse","number":7,"content":["Mən yenə səma altında puç olan başqa bir şeyi gördüm:"]},{"type":"verse","number":8,"content":[{"text":"Tənha bir adam var idi,","poem":1},{"lineBreak":true},{"text":"Onun nə oğlu, nə də qardaşı var idi.","poem":1},{"lineBreak":true},{"text":"Zəhmət çəkməkdən yorulmazdı,","poem":1},{"lineBreak":true},{"text":"Lakin yenə də gözləri mal-dövlətdən doymurdu.","poem":1},{"lineBreak":true},{"text":"Özündən soruşmurdu ki,","poem":1},{"lineBreak":true},{"text":"Kimin üçün bu qədər zəhmət çəkirəm,","poem":1},{"lineBreak":true},{"text":"Kimin üçün özümü zövq almaqdan məhrum edirəm?","poem":1},{"lineBreak":true},{"text":"Bu da puçdur, böyük bir dərddir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İki adam bir adamdan yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki zəhmətləri üçün yaxşı muzd alacaqlar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əgər biri yıxılsa,","poem":1},{"lineBreak":true},{"text":"O biri yoldaşını qaldırar.","poem":1},{"lineBreak":true},{"text":"Lakin vay o adamın halına ki,","poem":1},{"lineBreak":true},{"text":"Yıxılanda onu qaldıran olmur!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Həmçinin iki nəfər bir yerdə yatarsa,","poem":1},{"lineBreak":true},{"text":"Bir-birini isidər.","poem":1},{"lineBreak":true},{"text":"Amma tək yatan necə isinə bilər?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əgər bir nəfər tək qalıb məğlub olarsa,","poem":1},{"lineBreak":true},{"text":"İki nəfər hücuma tab gətirə bilər.","poem":1},{"lineBreak":true},{"text":"Üçqat ip tez qırılmaz.","poem":1}]},{"type":"verse","number":13,"content":["Yoxsul və hikmətli bir cavan irad qəbul etməyən qoca və səfeh padşahdan yaxşıdır."]},{"type":"verse","number":14,"content":["Çünki o cavan bu ölkədə yoxsulluq içində doğulsa da, zindana düşsə də, çıxıb padşah ola bilər."]},{"type":"verse","number":15,"content":["Gördüm ki, səma altında dolaşan bütün adamlar padşah taxtına oturan bu cavanın ardınca gedir."]},{"type":"verse","number":16,"content":["Onun başına yığışan bütün xalqın sayı-hesabı yox idi. Ancaq sonra gələn nəsillər onun üçün də sevinməyəcək. Bu da puçdur, külək dalınca qaçmağa bənzər."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}