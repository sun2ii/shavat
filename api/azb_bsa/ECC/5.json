{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":5,"content":[{"type":"heading","content":["Allaha münasibət"]},{"type":"verse","number":1,"content":["Allahın evinə getdiyin zaman hərəkətlərinə diqqət et. Qulaq asmaq üçün oraya girmək yaxşı və pisin nə olduğunu bilməyən səfeh adamların qurban təqdim etməsindən yaxşıdır."]},{"type":"verse","number":2,"content":[{"text":"Dilin tələsməsin,","poem":1},{"lineBreak":true},{"text":"Allahın hüzurunda söz deməyə","poem":1},{"lineBreak":true},{"text":"Ürəyin tələsməsin.","poem":1},{"lineBreak":true},{"text":"Çünki Allah göydədir, sən yerdə.","poem":1},{"lineBreak":true},{"text":"Buna görə də az danış.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Necə ki iş çox olanda adam yuxu görər,","poem":1},{"lineBreak":true},{"text":"Söz də çox olanda səfeh danışığa çevrilər.","poem":1}]},{"type":"verse","number":4,"content":["Allaha əhd edəndə onu yerinə yetirməkdə yubanma, çünki ağılsızlar Onun xoşuna gəlməz. Öz əhdini yerinə yetir."]},{"type":"verse","number":5,"content":["Əhd etməmək əhd edib onu yerinə yetirməməkdən yaxşıdır."]},{"type":"verse","number":6,"content":["Qoyma sözlərin səni günaha batırsın. Allahın elçisinə demə ki, bu, kiçik səhv idi. Nə üçün Allah sənin sözünə qəzəblənsin və əlinin zəhmətini yox etsin?"]},{"type":"verse","number":7,"content":["Çünki çox yuxu görəndə də, çox söz danışanda da puç şeylər çox olar. Sən ancaq Allahdan qorx."]},{"type":"heading","content":["Var-dövlətin puçluğu"]},{"type":"verse","number":8,"content":["Əgər bir vilayətdə yoxsullara zülm edildiyini, ədalət və salehliyin ayaq altında tapdalandığını görürsənsə, gördüyünə təəccüb etmə. Çünki hər vəzifə başında olana özündən yuxarıda bir nəzarətçi qoyulub və onların başında da özlərindən yuxarıda olanlar var."]},{"type":"verse","number":9,"content":["Ancaq hamıdan yuxarıda olan padşah ədalətli olsa, hər kəs öz tarlasının bəhrəsindən xeyir götürər."]},{"type":"verse","number":10,"content":[{"text":"Pul sevən puldan doymaz,","poem":1},{"lineBreak":true},{"text":"Var-dövlət sevən də qazancdan.","poem":1},{"lineBreak":true},{"text":"Bu da puçdur.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Var-dövlət çoxaldıqca","poem":1},{"lineBreak":true},{"text":"Onu yeyənlər də çoxalır.","poem":1},{"lineBreak":true},{"text":"Gözləri ilə görməkdən savayı","poem":1},{"lineBreak":true},{"text":"Sahibinə ondan nə fayda var?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fəhlə az da yesə, çox da yesə,","poem":1},{"lineBreak":true},{"text":"Yuxusu şirindir.","poem":1},{"lineBreak":true},{"text":"Amma varlı adamın dövləti qoymaz ki,","poem":1},{"lineBreak":true},{"text":"O, rahat yatsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Səma altında gördüyüm","poem":1},{"lineBreak":true},{"text":"Başqa böyük dərd də var:","poem":1},{"lineBreak":true},{"text":"Yığdığı sərvət sahibinə zərər gətirir,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bu sərvəti bədbəxt hadisələr yox edir,","poem":1},{"lineBreak":true},{"text":"Sərvət sahibinin oğlu doğulanda","poem":1},{"lineBreak":true},{"text":"Ona verməyə bir şeyi qalmır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Necə ki o, anasının bətnindən çılpaq doğulub,","poem":1},{"lineBreak":true},{"text":"Eləcə də bu dünyadan gedir.","poem":1},{"lineBreak":true},{"text":"Zəhmətinin bəhrəsindən","poem":1},{"lineBreak":true},{"text":"Heç nəyi əlinə götürüb","poem":1},{"lineBreak":true},{"text":"Özü ilə apara bilmir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bu da böyük bir dərddir:","poem":1},{"lineBreak":true},{"text":"İnsan dünyaya necə gəlirsə,","poem":1},{"lineBreak":true},{"text":"Elə də gedir.","poem":1},{"lineBreak":true},{"text":"Boş yerə çəkdiyi zəhmətin","poem":1},{"lineBreak":true},{"text":"Ona nə faydası var?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ömrü boyu öz çörəyini","poem":1},{"lineBreak":true},{"text":"Qaranlıq, böyük sıxıntı, xəstəlik və","poem":1},{"lineBreak":true},{"text":"Qəzəb içində yeyir.","poem":1}]},{"type":"verse","number":18,"content":["İnsan üçün mənim gördüyüm yaxşı və gözəl olan budur ki, o yeyib-içsin və Allahın ona verdiyi bir neçə günlük ömründə səma altında çəkdiyi bütün zəhmətlərindən zövq alsın, çünki ona düşən bəxşiş budur."]},{"type":"verse","number":19,"content":["Həmçinin Allah hər kəsə var-dövlət bəxş edərək qüvvət verib ki, ondan yesin, payını götürsün və zəhmətindən zövq alsın. Bu, Allahın hədiyyəsidir."]},{"type":"verse","number":20,"content":["Çünki Allah insanın başını şənliklə qatdığı üçün insan ömrünün günlərini dərindən düşünmür."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}