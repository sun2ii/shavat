{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Səma altında gördüyüm bir dərd də var ki, insanlar arasında çox yayılıb:"]},{"type":"verse","number":2,"content":["adam var ki, Allah ona var-dövlət, izzət verir, arzu etdiyi hər şeyi yerinə yetirir, ancaq ona bu şeylərdən yeyib-içməyə imkan vermir, yad bir adam onun malını yeyir. Bu da puçdur, böyük bir dərddir."]},{"type":"verse","number":3,"content":["Bir adam yüz uşaq atası olub, uzun illər yaşasa da, amma uzun ömrünün əvəzində firavanlığından doymayıb hörmətlə dəfn olunmazsa, məncə, ölü doğulmuş uşaq ondan yaxşıdır."]},{"type":"verse","number":4,"content":["Çünki ölü doğulmuş uşaq boş yerə doğulur, qaranlıq içində itib-gedir, heç adı da çəkilmir."]},{"type":"verse","number":5,"content":["Nə günəş üzü görür, nə də bir şey bilir. Amma bu uşağın rahatlığı o adamınkından çoxdur."]},{"type":"verse","number":6,"content":["Çünki o adam iki dəfə min il ömür sürsə də, sevincin nə olduğunu bilmir. Məgər hər ikisi eyni yerə getmirmi?"]},{"type":"verse","number":7,"content":[{"text":"İnsan bütün zəhməti","poem":1},{"lineBreak":true},{"text":"Qarnı üçün çəkir,","poem":1},{"lineBreak":true},{"text":"Amma yenə də iştahası bitib-tükənmir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hikmətli adamın ağılsızdan","poem":1},{"lineBreak":true},{"text":"Nə üstünlüyü var?","poem":1},{"lineBreak":true},{"text":"Yoxsul başqa insanlarla","poem":1},{"lineBreak":true},{"text":"Necə rəftar etməyi bilsə də,","poem":1},{"lineBreak":true},{"text":"Bunun ona nə faydası var?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gözün görməsi ürəyin istəməsindən yaxşıdır.","poem":1},{"lineBreak":true},{"text":"Bu da puçdur, külək dalınca qaçmağa bənzər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nə varsa, adı çoxdan qoyulmuşdur,","poem":1},{"lineBreak":true},{"text":"İnsanın da nə olduğu bilinir.","poem":1},{"lineBreak":true},{"text":"Heç kəs özündən güclü ilə güləşə bilməz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sözün çoxluğu puçluğu çoxaldır.","poem":1},{"lineBreak":true},{"text":"Bunun insana nə faydası var?","poem":1}]},{"type":"verse","number":12,"content":["Görəsən kim bilir ki, kölgə kimi keçən qısa puç həyatda insan üçün yaxşı şey nədir? Kim insana deyə bilər ki, özündən sonra səma altında nə baş verəcək?"]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}