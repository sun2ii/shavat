{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ECC","translationId":"azb_bsa","name":"VAİZ","commonName":"VAİZ","title":"VAİZ KİTABI","order":21,"numberOfChapters":12,"sha256":"37a29dfe42a9dd03ccd04c11aaab04f9769bfe8aa25993acd8387de7ddd7da10","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/azb_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Hikmət haqqında"]},{"type":"verse","number":1,"content":[{"text":"Yaxşı ad ətirli yağdan,","poem":1},{"lineBreak":true},{"text":"Ölüm günü isə doğum günündən yaxşıdır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yas evinə getmək","poem":1},{"lineBreak":true},{"text":"Ziyafət evinə getməkdən yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki hər kəsin axırı ölümdür.","poem":1},{"lineBreak":true},{"text":"Gərək yaşayan hər adam","poem":1},{"lineBreak":true},{"text":"Bunu yadında saxlasın.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qüssə gülməkdən yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki üzün qəmgin olması","poem":1},{"lineBreak":true},{"text":"İnsan üçün daha yaxşıdır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hikmətli adamın ürəyi yas evindədir,","poem":1},{"lineBreak":true},{"text":"Amma ağılsızın ürəyi şadlıq evində.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hikmətli adamın məzəmmətini eşitmək","poem":1},{"lineBreak":true},{"text":"Ağılsızın nəğməsini eşitməkdən yaxşıdır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki ağılsız adamın gülməyi","poem":1},{"lineBreak":true},{"text":"Qazan altında yanan tikanlı kolun səsi kimidir.","poem":1},{"lineBreak":true},{"text":"Bu da puçdur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Haram gəlir hikmətli adamı ağılsıza çevirir,","poem":1},{"lineBreak":true},{"text":"Rüşvət isə ürəyi bərbad edir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bir şeyin axırı əvvəlindən yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Səbirli adam qürurludan yaxşıdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qəzəblənməyə tələsmə,","poem":1},{"lineBreak":true},{"text":"Çünki qəzəb ağılsızların","poem":1},{"lineBreak":true},{"text":"Ürəyində yuva salar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“Niyə keçən günlər bu gündən yaxşı idi?” demə,","poem":1},{"lineBreak":true},{"text":"Çünki verdiyin sual hikmətli sual deyil.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hikmət miras mal qədər yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Dünyada yaşayan hər kəs üçün faydalıdır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki pul necə insanın sipəridirsə,","poem":1},{"lineBreak":true},{"text":"Hikmət də eləcə insanın sipəridir.","poem":1},{"lineBreak":true},{"text":"Amma biliyin faydası bundan ibarətdir:","poem":1},{"lineBreak":true},{"text":"Hikmət ona sahib olana həyat verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Allahın işinə diqqət et:","poem":1},{"lineBreak":true},{"text":"Onun əydiyini kim düzəldə bilər?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaxşı gündə şad-xürrəm ol,","poem":1},{"lineBreak":true},{"text":"Pis gündə isə bunu anla:","poem":1},{"lineBreak":true},{"text":"Hər cür günü Allah təyin edib ki,","poem":1},{"lineBreak":true},{"text":"İnsan özündən sonra nə olacağını bilməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Puç ömrümdə bunları gördüm:","poem":1},{"lineBreak":true},{"text":"Saleh adam salehliyinə baxmayaraq, ölür,","poem":1},{"lineBreak":true},{"text":"Pis adamın isə pisliyinə baxmayaraq, ömrü uzanır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Həddən artıq saleh olma,","poem":1},{"lineBreak":true},{"text":"Həddən artıq müdrik olma.","poem":1},{"lineBreak":true},{"text":"Nə üçün özünü üzəsən?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Həddən artıq pis olma,","poem":1},{"lineBreak":true},{"text":"Həddən artıq ağılsız olma.","poem":1},{"lineBreak":true},{"text":"Nə üçün əcəlin çatmamış öləsən?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bir şeydən yapışmağın yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Amma o birindən də əlini çəkmə.","poem":1},{"lineBreak":true},{"text":"Çünki Allahdan qorxan adam","poem":1},{"lineBreak":true},{"text":"Hər ikisini tarazlayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hikmət ağıllı adama","poem":1},{"lineBreak":true},{"text":"Şəhərdə olan on hakimin hökmündən","poem":1},{"lineBreak":true},{"text":"Daha çox güc verər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Doğrudan da, yer üzündə elə saleh adam yoxdur ki,","poem":1},{"lineBreak":true},{"text":"Yalnız yaxşılıq edib heç bir günah etməsin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Adamların dediyi hər sözə məhəl qoyma,","poem":1},{"lineBreak":true},{"text":"Onda nökərinin səni söydüyünü eşitməzsən.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki sənin ürəyin də yaxşı bilir ki,","poem":1},{"lineBreak":true},{"text":"Sən də başqa adamları çox söymüsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bu deyilənlərin hamısını hikmətlə sınadım.","poem":1},{"lineBreak":true},{"text":"“Hikmətli olacağam” söylədim.","poem":1},{"lineBreak":true},{"text":"Amma buna qadir olmadım.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hikmət deyilən şey","poem":1},{"lineBreak":true},{"text":"Çox uzaqda, çox dərindədir.","poem":1},{"lineBreak":true},{"text":"Onu kim tapa bilər?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mən ürəyimdə niyyət etdim ki,","poem":1},{"lineBreak":true},{"text":"Hikməti və hər şeyin əsasını bilim,","poem":1},{"lineBreak":true},{"text":"Axtarıb araşdırım,","poem":1},{"lineBreak":true},{"text":"Bilim ki, pislik ağılsızlıqdır,","poem":1},{"lineBreak":true},{"text":"Ağılsızlıq isə dəlilikdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Tələ quran qadını","poem":1},{"lineBreak":true},{"text":"Ölümdən acı gördüm.","poem":1},{"lineBreak":true},{"text":"Onun ürəyi tora,","poem":1},{"lineBreak":true},{"text":"Əlləri zəncirə bənzər.","poem":1},{"lineBreak":true},{"text":"Allahın razı qaldığı adam ondan qaçar,","poem":1},{"lineBreak":true},{"text":"Ancaq günahkar adam ona əsir olar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Vaiz deyir:","poem":1},{"lineBreak":true},{"text":"«Bax bunu öyrəndim:","poem":1},{"lineBreak":true},{"text":"Hər şeyin əsasını tapmaq üçün","poem":1},{"lineBreak":true},{"text":"Bir-bir araşdıran zaman","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ürəyim hey axtarır, ancaq tapa bilmir.","poem":1},{"lineBreak":true},{"text":"Min kişinin içində bir yaxşısını tapdım,","poem":1},{"lineBreak":true},{"text":"Amma bu qədər qadının içində bir yaxşısını tapmadım.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ancaq bunu öyrəndim ki,","poem":1},{"lineBreak":true},{"text":"Allah insanları kamil yaratdı,","poem":1},{"lineBreak":true},{"text":"Onlar isə qarışıq fikirlərə düşdü.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}