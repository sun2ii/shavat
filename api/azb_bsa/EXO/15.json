{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EXO","translationId":"azb_bsa","name":"ÇIXIŞ","commonName":"ÇIXIŞ","title":"ÇIXIŞ KİTABI","order":2,"numberOfChapters":40,"sha256":"1f2a0456f6cb7910ec707c6f63dd506dd548e9b3dc64640ce55211ce47023812","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/azb_bsa/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Musanın qurtuluş ilahisi"]},{"type":"verse","number":1,"content":["O vaxt Musa ilə İsrail övladları Rəbbə bu ilahini oxudular:",{"text":"«Rəbbə ilahi oxuyacağam,","poem":1},{"lineBreak":true},{"text":"Çox böyük zəfər çaldı.","poem":1},{"lineBreak":true},{"text":"Atı və süvarini dənizə tulladı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb qüvvətim, məzmurumdur, O məni xilas etdi.","poem":1},{"lineBreak":true},{"text":"Rəbb mənim Allahımdır, Ona həmd edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Atamın Allahıdır, Rəbbi yüksəldəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb döyüşçüdür, Rəbdir Onun adı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fironun döyüş arabalarını,","poem":1},{"lineBreak":true},{"text":"Ordusunu da dənizə atdı.","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarının başçıları","poem":1},{"lineBreak":true},{"text":"Qırmızı dənizdə boğuldu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əngin sulara bürünüb","poem":1},{"lineBreak":true},{"text":"Daş tək dərinliklərə","poem":1},{"lineBreak":true},{"text":"Necə də qərq oldular.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya Rəbb! Sənin sağ əlin qüdrətdən izzətləndi.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb! Sənin sağ əlin düşməni əzəndir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənə qarşı çıxanları möhtəşəm əzəmətin yıxar,","poem":1},{"lineBreak":true},{"text":"Sənin göndərdiyin qəzəb onları saman çöpü tək yandırar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Burnunun nəfəsi ilə sular toplanar,","poem":1},{"lineBreak":true},{"text":"Yığılar bir yerə, axınlar dayanar,","poem":1},{"lineBreak":true},{"text":"Dəniz qoynunda coşan sular qatılaşar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Düşmən dedi:","poem":1},{"lineBreak":true},{"text":"“İzləyim, çatıb qənimət paylayım:","poem":1},{"lineBreak":true},{"text":"Bundan canım doyacaq,","poem":1},{"lineBreak":true},{"text":"Qılıncımla onları məhv edəcəyəm”.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nəfəsinlə üfürdün, dənizlə onları bürüdün.","poem":1},{"lineBreak":true},{"text":"Qurğuşun tək onlar nəhəng sularda batdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, allahlar arasında Sənin kimisi varmı?","poem":1},{"lineBreak":true},{"text":"Müqəddəslikdə əzəmətli, zəhmli və alqışlara layiq,","poem":1},{"lineBreak":true},{"text":"Möcüzələr yaradan Sənin kimisi varmı?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sağ əlini uzadanda torpaq onları uddu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Məhəbbətinlə qurtardığın xalqa Sən yol göstərdin.","poem":1},{"lineBreak":true},{"text":"Müqəddəs məskəninə Öz gücünlə apardın.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xalqlar eşidib əsdi,","poem":1},{"lineBreak":true},{"text":"Filişt sakinlərini qorxu kəsdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Edom başçılarını o an dəhşət bürüdü.","poem":1},{"lineBreak":true},{"text":"Moav igidlərini vahimələrə saldı.","poem":1},{"lineBreak":true},{"text":"Kənan sakinləri isə üzülüb qaldı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onların üzərini qorxu, vəlvələ aldı.","poem":1},{"lineBreak":true},{"text":"Güclü qoluna görə daş tək lal-kar oldular,","poem":1},{"lineBreak":true},{"text":"O vaxtadək ki xalqın keçəcək,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, qurtardığın xalq keçəcək!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ya Rəbb, xalqını gətirib salacaqsan mülkün olan dağına,","poem":1},{"lineBreak":true},{"text":"Yaşamaq üçün Özünə yaratdığın yerə,","poem":1},{"lineBreak":true},{"text":"Ey Xudavənd! Əlinlə qurduğun Müqəddəs məkanına.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbb əbədi, daima padşahlıq edəcəkdir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Fironun atları, döyüş arabaları və süvariləri ilə birgə dənizə girəndə Rəbb dənizin sularını onların üzərinə geri qaytarmışdı. İsrail övladları isə dənizin ortasında quru yerdən keçmişdilər."]},{"type":"verse","number":20,"content":["Harunun bacısı peyğəmbər Məryəm əlinə dəf aldı; bütün qadınlar əllərinə dəf alıb oynayaraq onun ardınca çıxdılar."]},{"type":"verse","number":21,"content":["Məryəm onların qarşısında bu ilahini oxudu:",{"text":"Rəbbə ilahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Çox böyük zəfər çaldı.","poem":1},{"lineBreak":true},{"text":"Atı və süvariləri dənizə tulladı!","poem":1}]},{"type":"heading","content":["Acı su"]},{"type":"verse","number":22,"content":["Musa İsrail xalqını Qırmızı dənizin sahilindən gedən yola gətirdi. Onlar Şur səhrasına çıxıb orada üç gün yol getdilər, amma su tapmadılar."]},{"type":"verse","number":23,"content":["Maraya çatdılar, lakin oranın suyunu içə bilmədilər, çünki çox acı idi. Buna görə də o yer Mara",{"noteId":5},"adlanır."]},{"type":"verse","number":24,"content":["Xalq «Nə içək?» deyə Musadan giley-güzar etdi."]},{"type":"verse","number":25,"content":["Musa Rəbbə fəryad etdi və Rəbb ona bir ağac göstərdi. Musa onu suya atdı və su şirin oldu. Orada İsrail övladlarını sınağa çəkdiyi yerdə Rəbb onlar üçün qayda-qanun qoyaraq dedi:"]},{"type":"verse","number":26,"content":["«Əgər siz Allahınız Rəbbin səsinə qulaq asıb Onun gözündə doğru olsanız, Onun əmrlərini dinləyib bütün qanunlarına riayət etsəniz, Misirlilərə verdiyim xəstəliklərin heç birini sizə verməyəcəyəm. Çünki sizə şəfa verən Rəbb Mənəm»."]},{"type":"verse","number":27,"content":["Sonra İsrail övladları Elimə gəldilər. Orada on iki su qaynağı və yetmiş xurma ağacı var idi. İsrail xalqı orada sular ətrafında düşərgə qurdu."]}],"footnotes":[{"noteId":5,"caller":"+","text":"Mara – ibrani dilində acı.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/azb_bsa/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}