{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["İsrail rəhbərləri üçün mərsiyə"]},{"type":"verse","number":1,"content":["Sən İsrail rəhbərləri üçün mərsiyə oxuyub söylə:"]},{"type":"verse","number":2,"content":[{"text":"“Sənin anan nə idi?","poem":1},{"lineBreak":true},{"text":"Şirlər arasında dişi bir şir!","poem":1},{"lineBreak":true},{"text":"O, cavan aslanların içində yatardı,","poem":1},{"lineBreak":true},{"text":"Balalarını bəsləyərdi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O, balalarından birini böyütdü,","poem":1},{"lineBreak":true},{"text":"Bala cavan bir şir oldu.","poem":1},{"lineBreak":true},{"text":"Şikar etməyi öyrəndi,","poem":1},{"lineBreak":true},{"text":"Adamları yeməyə başladı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Millətlər onun xəbərini eşitdi,","poem":1},{"lineBreak":true},{"text":"Bu şir onların quyusuna düşüb ələ keçdi.","poem":1},{"lineBreak":true},{"text":"Burnuna halqa taxıb onu","poem":1},{"lineBreak":true},{"text":"Misir torpağına gətirdilər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dişi şir boş yerə gözlədiyini,","poem":1},{"lineBreak":true},{"text":"Ümid qalmadığını görəndə","poem":1},{"lineBreak":true},{"text":"Balalarından birini götürüb","poem":1},{"lineBreak":true},{"text":"Cavan bir şir etdi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu bala şirlər arasında gəzirdi.","poem":1},{"lineBreak":true},{"text":"O da cavan bir şir olub","poem":1},{"lineBreak":true},{"text":"Şikar etməyi öyrəndi,","poem":1},{"lineBreak":true},{"text":"Adamları yeməyə başladı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların qəsrlərini dağıtdı,","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Şəhərlərini viran etdi.","poem":1},{"lineBreak":true},{"text":"Bu şirin nərə səsindən","poem":1},{"lineBreak":true},{"text":"Ölkə və onun əhalisi dəhşət içində idi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ətraf ölkələrin millətləri","poem":1},{"lineBreak":true},{"text":"Onun üstünə gəldi,","poem":1},{"lineBreak":true},{"text":"Öz torlarını üzərinə atdı,","poem":1},{"lineBreak":true},{"text":"Bu şir onların quyusuna düşüb ələ keçdi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onun burnuna halqa taxıb qəfəsə saldılar.","poem":1},{"lineBreak":true},{"text":"Onu Babil padşahının yanına gətirdilər.","poem":1},{"lineBreak":true},{"text":"Sonra qalaya saldılar ki,","poem":1},{"lineBreak":true},{"text":"İsrail dağları üzərində","poem":1},{"lineBreak":true},{"text":"Bir daha səsi eşidilməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sənin anan da çay kənarındakı bağında","poem":1},{"lineBreak":true},{"text":"Əkilmiş bir üzüm tənəyi kimi idi.","poem":1},{"lineBreak":true},{"text":"Bol sulardan bəhərli oldu,","poem":1},{"lineBreak":true},{"text":"Çoxlu qol-budaq verdi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onun budaqları","poem":1},{"lineBreak":true},{"text":"Padşah əsası olacaq qədər gücləndi,","poem":1},{"lineBreak":true},{"text":"Boyu hündür ağaclara qədər ucaldı,","poem":1},{"lineBreak":true},{"text":"Onun çoxlu budaqları ilə","poem":1},{"lineBreak":true},{"text":"Hündürlüyü görünürdü.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ancaq onu qəzəblə","poem":1},{"lineBreak":true},{"text":"Kökündən çıxarıb yerə atdılar,","poem":1},{"lineBreak":true},{"text":"Şərq küləyi onun meyvəsini qurutdu,","poem":1},{"lineBreak":true},{"text":"Möhkəm budaqları qoparıldı,","poem":1},{"lineBreak":true},{"text":"Onlar qurudu,","poem":1},{"lineBreak":true},{"text":"Onları od yandırıb-yaxdı.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O indi","poem":1},{"lineBreak":true},{"text":"Çöldə, quraq və susuz torpaqda əkildi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gövdəsinin bir budağından od çıxdı,","poem":1},{"lineBreak":true},{"text":"Onun meyvəsini yandırıb-yaxdı.","poem":1},{"lineBreak":true},{"text":"Onda padşah əsası olmaq üçün","poem":1},{"lineBreak":true},{"text":"Bir möhkəm budaq da qalmadı”.","poem":1},{"lineBreak":true},"Bu bir mərsiyə idi, mərsiyə olaraq da qalacaq»."]}],"footnotes":[{"noteId":3,"caller":"+","text":"Qəsrlərini dağıtdı – arami tərcüməsində belədir, ibrani mətnində isə dul qadınlarını tanıdı.","reference":{"chapter":19,"verse":7}}]},"thisChapterLink":"/api/azb_bsa/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}