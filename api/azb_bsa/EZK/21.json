{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":21,"content":[{"type":"heading","content":["Rəbbin cəza qılıncı"]},{"type":"verse","number":1,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Ey bəşər oğlu, üzünü Yerusəlimə tərəf çevirib Müqəddəs məkanlara qarşı danış və İsrail torpağının əleyhinə peyğəmbərlik et."]},{"type":"verse","number":3,"content":["Sən İsrail torpağına söylə ki, Rəbb belə deyir: “Budur, Mən sənin əleyhinəyəm. Qılıncımı qınından çıxararaq sənin içində olan salehi də, pis adamı da qırıb-çatacağam."]},{"type":"verse","number":4,"content":["Sənin içində olan salehi də, pis adamı da qırıb-çatım deyə Mənim qılıncım cənubdan şimaladək ərazidə yaşayan bütün bəşərin üzərinə enmək üçün qınından çıxacaq."]},{"type":"verse","number":5,"content":["Onda bütün bəşər biləcək ki, Mən Rəbb qılıncımı qınından çıxardım və bir daha yerinə qayıtmayacaq”."]},{"type":"verse","number":6,"content":["İçini çək, ey bəşər oğlu, sən belini büküb onların gözü önündə acı-acı içini çək."]},{"type":"verse","number":7,"content":["Onlar sənə “Nəyə görə içini çəkirsən?” söyləyəndə onlara deyərsən: “Gələn xəbərə görə. Hər ürək əriyəcək, hər əl yanına düşəcək, bütün ruhlar zəifləyəcək və bütün dizlər titrəyəcək. O xəbər gəlir, bunlar yerinə yetəcək” Xudavənd Rəbb belə bəyan edir»."]},{"type":"verse","number":8,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":9,"content":["«Ey bəşər oğlu, peyğəmbərlik edib söylə ki, Xudavənd belə deyir:",{"text":"“Söylə ki, qılınc, qılınc","poem":1},{"lineBreak":true},{"text":"İtilənib, cilalanıb.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Öldürmək üçün itilənib,","poem":1},{"lineBreak":true},{"text":"Şimşək kimi çaxsın deyə cilalanıb.","poem":1},{"lineBreak":true},{"text":"Necə sevinə bilərik?","poem":1},{"lineBreak":true},{"text":"Qılınc oğlumun əsasına","poem":1},{"lineBreak":true},{"text":"Hər hansı bir əl ağacı kimi xor baxdı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qılınc əldə tutulmaq üçün","poem":1},{"lineBreak":true},{"text":"Cilalanmağa verildi.","poem":1},{"lineBreak":true},{"text":"Öldürənin əlinə verilsin deyə","poem":1},{"lineBreak":true},{"text":"İtilənib cilalandı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey bəşər oğlu, fəryad edib ağla.","poem":1},{"lineBreak":true},{"text":"Çünki bu qılınc xalqıma və","poem":1},{"lineBreak":true},{"text":"Bütün İsrail rəhbərlərinə qarşı qalxıb.","poem":1},{"lineBreak":true},{"text":"Onlar xalqımla birgə","poem":1},{"lineBreak":true},{"text":"Qılınca təslim edildi.","poem":1},{"lineBreak":true},{"text":"Bunun üçün sinə döy”.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xudavənd Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Qarşıda sınaq var.","poem":1},{"lineBreak":true},{"text":"Qılıncın xor baxdığı əsa","poem":1},{"lineBreak":true},{"text":"Daha salamat qalmazsa, nə olar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sən ey bəşər oğlu, peyğəmbərlik et,","poem":1},{"lineBreak":true},{"text":"Əllərini bir-birinə vur.","poem":1},{"lineBreak":true},{"text":"Qoy qılınc iki, üç dəfə vursun.","poem":1},{"lineBreak":true},{"text":"O öldürən bir qılıncdır,","poem":1},{"lineBreak":true},{"text":"Çoxlu adam qıran,","poem":1},{"lineBreak":true},{"text":"İnsanı hər tərəfdən saran qılıncdır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onların ürəyi ərisin,","poem":1},{"lineBreak":true},{"text":"Yerə sərilənlər çox olsun deyə","poem":1},{"lineBreak":true},{"text":"Bütün darvazalarında qırğın qılıncı qoydum.","poem":1},{"lineBreak":true},{"text":"Ah, o, şimşək kimi parıldadı,","poem":1},{"lineBreak":true},{"text":"Öldürmək üçün sıyrıldı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ey qılınc, sağa-sola dönüb kəs,","poem":1},{"lineBreak":true},{"text":"Sağa dön, sola dön,","poem":1},{"lineBreak":true},{"text":"Üzün hara çevrilsə, ora get.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mən də əllərimi bir-birinə vuracağam,","poem":1},{"lineBreak":true},{"text":"Beləcə qəzəbimi yatırdacağam.","poem":1},{"lineBreak":true},{"text":"Bunu Mən Rəbb söylədim”».","poem":1}]},{"type":"verse","number":18,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":19,"content":["«Sən ey bəşər oğlu, Babil padşahının qılıncının gəlməsi üçün iki yol hazırla, ikisi də bir ölkədən çıxsın. Bir yerdə nişan qoy, onu şəhər yolunun başında qoy."]},{"type":"verse","number":20,"content":["Qılınc Ammon övladlarının Rabba şəhərinə, Yəhudaya və qalalı Yerusəlimə yönəlsin deyə yol hazırla."]},{"type":"verse","number":21,"content":["Çünki Babil padşahı yolayrıcında – iki yolun başında falçılıq etmək üçün dayanacaq. Oxları qarışdıracaq, ev bütlərindən soruşacaq, kəsilən bir heyvanın qaraciyərinə baxacaq."]},{"type":"verse","number":22,"content":["Onun sağ əlində Yerusəlimi göstərən fal var. Orada qoçbaşı alətləri qoyacaq, öldürmək əmri verəcək, döyüş nidası ucaldacaq, qoçbaşı alətlərini darvazaların önündə qoyacaq, torpaq qalağı və mühasirə divarları düzəldəcək."]},{"type":"verse","number":23,"content":["Onunla and içib saziş bağlayanlar falın yalan olduğunu güman edəcək. Ancaq padşah təqsirlərini xatırlayıb onları əsir alacaq."]},{"type":"verse","number":24,"content":["Buna görə də Xudavənd Rəbb belə deyir: “İndi ki təqsirlərinizi və üsyankarlığınızı göstərməklə bunları yada saldınız, bütün işlərinizdə günahlarınız aşkara çıxdı və yada salındınız, mütləq əsir düşəcəksiniz."]},{"type":"verse","number":25,"content":["Sən ey murdar və pis olan İsrail rəhbəri, günün çatdı, nəhayət, cəza vaxtın gəldi”."]},{"type":"verse","number":26,"content":["Xudavənd Rəbb belə deyir: “Çalmanı və tacı götür. Daha bu belə olmayacaq. Alçalanı yüksəlt, yüksələni alçalt."]},{"type":"verse","number":27,"content":["Viran, viran, viran qoyacağam şəhəri! Haqq sahibi gələnə qədər bərpa olunmayacaq. Mən şəhəri ona verəcəyəm”."]},{"type":"verse","number":28,"content":["Sən ey bəşər oğlu, peyğəmbərlik edib söylə ki, Ammonlular və onların etdikləri təhqirə görə Xudavənd Rəbb belə deyir:",{"text":"“Qılınc, qılınc həlak etmək üçün sıyrılıb,","poem":1},{"lineBreak":true},{"text":"Qırğın üçün itilənib ki,","poem":1},{"lineBreak":true},{"text":"Şimşək kimi parlasın.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Elə bir zamanda ki","poem":1},{"lineBreak":true},{"text":"Sənə boş görüntülər görünür,","poem":1},{"lineBreak":true},{"text":"Sənə yalan falçılıq açırlar.","poem":1},{"lineBreak":true},{"text":"Ölməli olan pis adamların","poem":1},{"lineBreak":true},{"text":"Boyunlarına enəcəksən, ey qılınc!","poem":1},{"lineBreak":true},{"text":"Bu adamların günü çatdı,","poem":1},{"lineBreak":true},{"text":"Nəhayət, cəza vaxtı gəldi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qılınc qınına qoyulsun!","poem":1},{"lineBreak":true},{"text":"Səni yaradıldığın yerdə,","poem":1},{"lineBreak":true},{"text":"Doğulduğun ölkədə mühakimə edəcəyəm.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Qəzəbimi üstünə tökəcəyəm,","poem":1},{"lineBreak":true},{"text":"Hiddətimin odunu üstünə püfləyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Səni vəhşi adamlara təslim edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onlar məhv etməkdə mahirdir.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Sən oda qida olacaqsan,","poem":1},{"lineBreak":true},{"text":"Ölkə içində qanın töküləcək.","poem":1},{"lineBreak":true},{"text":"Daha yada salınmayacaqsan,","poem":1},{"lineBreak":true},{"text":"Çünki Mən Rəbb bunu söylədim”».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/EZK/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/20.json","previousChapterAudioLinks":{},"numberOfVerses":32}