{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":24,"content":[{"type":"heading","content":["Paslanmış qazanla müqayisə"]},{"type":"verse","number":1,"content":["Sürgünlüyümüzün doqquzuncu ilində, onuncu ayın onuncu günü mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Ey bəşər oğlu, bu günün, məhz bu günün tarixini qeyd elə. Çünki Babil padşahı məhz bu gün Yerusəlimi mühasirəyə aldı."]},{"type":"verse","number":3,"content":["Bu üsyankar xalqa bir məsəl danışıb söylə ki, Xudavənd Rəbb belə deyir:",{"text":"“Qazanı oda qoy, oda qoy,","poem":1},{"lineBreak":true},{"text":"İçinə su doldur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ətin parçalarını, ən yaxşı parçalarını,","poem":1},{"lineBreak":true},{"text":"Budu və döşü oraya yığ.","poem":1},{"lineBreak":true},{"text":"Onu seçilmiş sümüklərlə doldur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sürüdən ən yaxşı heyvanları götür,","poem":1},{"lineBreak":true},{"text":"Qazanın altına isə odun","poem":1},{"noteId":5},{"text":"yığ.","poem":1},{"lineBreak":true},{"text":"Qoy içindəki su qaynasın ki,","poem":1},{"lineBreak":true},{"text":"Qazandakı sümükləri də bişsin”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Buna görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Qan tökən şəhərin vay halına!","poem":1},{"lineBreak":true},{"text":"Ora pas tutmuşdur,","poem":1},{"lineBreak":true},{"text":"Öz pasından təmizlənməmiş qazana bənzəyir.","poem":1},{"lineBreak":true},{"text":"Püşk atmadan əti parça-parça qazandan çıxarın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki onun tökdüyü qan hələ içindədir.","poem":1},{"lineBreak":true},{"text":"Qanı tozla örtmək üçün hətta yerə də tökmədi,","poem":1},{"lineBreak":true},{"text":"Düz çılpaq qayanın üstünə axıtdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mən də qəzəbi alovlandıraraq","poem":1},{"lineBreak":true},{"text":"Qisas alınsın deyə","poem":1},{"lineBreak":true},{"text":"Onun qanını çılpaq bir qayanın","poem":1},{"lineBreak":true},{"text":"Üstünə tökdüm ki, örtülməsin”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Buna görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Qan tökən şəhərin vay halına!","poem":1},{"lineBreak":true},{"text":"Mən də odun qalağını böyüdəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Odunları yığ, odu alovlandır,","poem":1},{"lineBreak":true},{"text":"Əti yaxşı bişir,","poem":1},{"lineBreak":true},{"text":"Ədviyyatını qat,","poem":1},{"lineBreak":true},{"text":"Sümüklər də yansın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onun közləri üstünə","poem":1},{"lineBreak":true},{"text":"Qazanı boş qoy ki, qızsın,","poem":1},{"lineBreak":true},{"text":"Misi yansın,","poem":1},{"lineBreak":true},{"text":"İçindəki murdarlığı getsin,","poem":1},{"lineBreak":true},{"text":"Pası ərisin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bütün zəhmət hədər getdi,","poem":1},{"lineBreak":true},{"text":"Qalın pası ərimək bilmir,","poem":1},{"lineBreak":true},{"text":"Pası odla da çıxmır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Etdiyin pozğunluq səni murdarladı,","poem":1},{"lineBreak":true},{"text":"Səni təmizləmək istədim,","poem":1},{"lineBreak":true},{"text":"Amma sən təmizlənmək istəmədin.","poem":1},{"lineBreak":true},{"text":"Sənə qarşı qəzəbim yatana qədər","poem":1},{"lineBreak":true},{"text":"Öz murdarlığından təmizlənməyəcəksən.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mən Rəbb bunu söylədim,","poem":1},{"lineBreak":true},{"text":"Vaxt çatdı ki, yerinə yetirim.","poem":1},{"lineBreak":true},{"text":"Çəkinməyəcəyəm, acımayacağam,","poem":1},{"lineBreak":true},{"text":"Peşman olmayacağam.","poem":1},{"lineBreak":true},{"text":"Adətlərinə və əməllərinə görə cəzalanacaqsan”","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb belə deyir».","poem":1}]},{"type":"heading","content":["Yezekelin arvadının ölümü"]},{"type":"verse","number":15,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":16,"content":["«Ey bəşər oğlu, gözündə çox qiymətli olan bir nəfəri bir zərbə ilə əlindən alacağam. Amma sən yas tutma, ağlayıb göz yaşı tökmə."]},{"type":"verse","number":17,"content":["İçin-için ağla, ölülər üçün yas tutma. Çalmanı başına qoyub çarığını ayağına gey. Üzünün alt hissəsini örtmə, yas tutanların",{"noteId":6},"çörəyini yemə»."]},{"type":"verse","number":18,"content":["Mən səhər xalqa bu sözləri söylədim. Axşamüstü arvadım öldü. Ertəsi gün səhər mənə əmr olunanı etdim."]},{"type":"verse","number":19,"content":["Xalq mənə dedi: «Etdiyin bu şeylərin bizə nə dəxli var? Bizə bildirməzsən?»"]},{"type":"verse","number":20,"content":["Mən onlara dedim: «Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":21,"content":["İsrail nəslinə söylə ki, Xudavənd Rəbb belə deyir: “Öyündüyünüz güc mənbəyinizi, gözünüzdə ən qiymətli olan şeyi, ürəyinizin arzusu olan Müqəddəs məkanımın murdarlanmasına izin verəcəyəm. Arxada qoyduğunuz oğullarınız və qızlarınız qılıncdan keçiriləcək."]},{"type":"verse","number":22,"content":["Mən nə etdimsə, siz də elə edəcəksiniz: üzünüzün alt hissəsini örtməyəcəksiniz, yas tutanların çörəyini yeməyəcəksiniz."]},{"type":"verse","number":23,"content":["Çalmanız başınızda, çarığınız ayağınızda olacaq. Yas tutmayacaq, ağlamayacaqsınız, ancaq təqsirlərinizin içində əriyib yox olacaq, baş-başa verib inləyəcəksiniz."]},{"type":"verse","number":24,"content":["Yezekel sizə bir əlamət olacaq: o nə edəcəksə, siz də onu edəcəksiniz. Bu hadisələr olanda biləcəksiniz ki, Xudavənd Rəbb Mənəm”."]},{"type":"verse","number":25,"content":["Sən ey bəşər oğlu, qalalarını, sevinc və izzətlərini, gözlərində qiymətli olan şeyi, ürəklərinin arzusunu, oğulları ilə qızlarını onlardan aldığım vaxt –"]},{"type":"verse","number":26,"content":["o gün fəlakətdən qaçıb qurtulan bir nəfər gəlib sənə bu xəbəri bildirəcək."]},{"type":"verse","number":27,"content":["O gün bu qaçağın yanında dilin açılacaq, onunla danışacaq, artıq dinməz qalmayacaqsan. Beləcə onlar üçün bir əlamət olacaqsan. Onda biləcəklər ki, Rəbb Mənəm»."]}],"footnotes":[{"noteId":5,"caller":"+","text":"Odun – ibrani mətnində sümüklər.","reference":{"chapter":24,"verse":5}},{"noteId":6,"caller":"+","text":"Yas tutanların – arami və latın tərcümələrində belədir, ibrani mətnində isə adamların.","reference":{"chapter":24,"verse":17}}]},"thisChapterLink":"/api/azb_bsa/EZK/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/23.json","previousChapterAudioLinks":{},"numberOfVerses":27}