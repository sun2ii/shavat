{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["Sur şəhəri üçün mərsiyə"]},{"type":"verse","number":1,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Sən ey bəşər oğlu, Sur üçün mərsiyə oxuyub"]},{"type":"verse","number":3,"content":["ona söylə ki, sən ey dəniz qapılarında yerləşən, çoxlu sahil xalqı ilə ticarət edən şəhər, Xudavənd Rəbb belə deyir:",{"text":"“Ey Sur, sən dedin:","poem":1},{"lineBreak":true},{"text":"‹Mən gözəllikdə qüsursuzam›.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sərhədlərin dənizin qoynunda idi.","poem":1},{"lineBreak":true},{"text":"Səni tikənlər gözəlliyini kamil etdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bütün taxtalarını","poem":1},{"lineBreak":true},{"text":"Senirin şam ağaclarından düzəltdilər.","poem":1},{"lineBreak":true},{"text":"Sənə dor qayırmaq üçün","poem":1},{"lineBreak":true},{"text":"Livandan sidr ağacları gətirdilər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Avarlarını Başanın palıd ağaclarından qayırdılar,","poem":1},{"lineBreak":true},{"text":"Göyərtəni fil sümüyü ilə bəzənən,","poem":1},{"lineBreak":true},{"text":"Kittim sahillərindən gətirilən","poem":1},{"lineBreak":true},{"text":"Şam ağaclarından düzəltdilər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin yelkənin, bayrağın","poem":1},{"lineBreak":true},{"text":"Misirin naxışlı kətanından oldu.","poem":1},{"lineBreak":true},{"text":"Talvarın Elişa sahillərinin","poem":1},{"lineBreak":true},{"text":"Bənövşəyi və tünd qırmızı parçalarından idi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sidonda və Ervadda yaşayanlar","poem":1},{"lineBreak":true},{"text":"Sənin avar çəkənlərin idi.","poem":1},{"lineBreak":true},{"text":"Ey Sur, səndə bacarıqlı adamlar var idi,","poem":1},{"lineBreak":true},{"text":"Gəmiçilərin onlardan idi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gəmilərindəki yarıqları təmir edənlər","poem":1},{"lineBreak":true},{"text":"Gevalın təcrübəli və bacarıqlı adamları idi.","poem":1},{"lineBreak":true},{"text":"Dənizdəki bütün gəmilər və dənizçilər","poem":1},{"lineBreak":true},{"text":"Mallarını dəyişmək üçün","poem":1},{"lineBreak":true},{"text":"Sənin yanına gəldi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fars, Lud və Put əsgərləri","poem":1},{"lineBreak":true},{"text":"Ordunda xidmət edirdi.","poem":1},{"lineBreak":true},{"text":"Qalxanlarını, dəbilqələrini","poem":1},{"lineBreak":true},{"text":"Divarlarından asdılar,","poem":1},{"lineBreak":true},{"text":"Sənə əzəmət verdilər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ervaddan və Xelekdən gələnlər","poem":1},{"lineBreak":true},{"text":"Hər tərəfdən divarlarını qorudu.","poem":1},{"lineBreak":true},{"text":"Qammadlılar qüllələrində gözətçi oldu.","poem":1},{"lineBreak":true},{"text":"Qalxanlarını divarlarından asdı,","poem":1},{"lineBreak":true},{"text":"Gözəlliyini kamil etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Səndə hər cür mal bol olduğu üçün","poem":1},{"lineBreak":true},{"text":"Tarşiş səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzinə sənə","poem":1},{"lineBreak":true},{"text":"Gümüş, dəmir, qalay və qurğuşun verdilər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yavan, Tuval və Meşek səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzinə sənə","poem":1},{"lineBreak":true},{"text":"Qullar və tunc qablar verdilər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bet-Toqarma xalqı","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzinə sənə","poem":1},{"lineBreak":true},{"text":"At, döyüş atı və qatır verdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dedan xalqı səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Çoxlu sahil xalqı sənin müştərin idi,","poem":1},{"lineBreak":true},{"text":"Səndən aldıqları malın əvəzinə","poem":1},{"lineBreak":true},{"text":"Fil sümüyü və abnos ağacı verdilər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sənin məmulatın çox olduğu üçün","poem":1},{"lineBreak":true},{"text":"Aram səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzində sənə","poem":1},{"lineBreak":true},{"text":"Firuzə, tünd qırmızı qumaş, naxışlı paltarlar,","poem":1},{"lineBreak":true},{"text":"İncə kətan, mərcan və yaqut verdilər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yəhuda və İsrail ölkəsi səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzinə sənə","poem":1},{"lineBreak":true},{"text":"Minnit buğdası, darı, bal,","poem":1},{"lineBreak":true},{"text":"Zeytun yağı və balzam verdilər.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sənin məmulatın çox olduğu üçün,","poem":1},{"lineBreak":true},{"text":"Səndə hər cür mal bol olduğuna görə","poem":1},{"lineBreak":true},{"text":"Dəməşq səninlə ticarət etdi,","poem":1},{"lineBreak":true},{"text":"Helbon şərabı, Saxar yunu ilə ticarət etdi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Vadan və Uzaldan gələn","poem":1},{"lineBreak":true},{"text":"Yavan səninlə ticarət etdi.","poem":1},{"lineBreak":true},{"text":"Sənə gətirilən mallar arasında","poem":1},{"lineBreak":true},{"text":"İşlənmiş dəmir, darçın və ətirli qamış var idi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dedan xalqı səninlə ticarət edib","poem":1},{"lineBreak":true},{"text":"Sənə yəhər üçün qumaş verdi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ərəbistan və bütün Qedar rəhbərləri","poem":1},{"lineBreak":true},{"text":"Sənin müştərilərin idi,","poem":1},{"lineBreak":true},{"text":"Quzu, qoç və təkə ilə","poem":1},{"lineBreak":true},{"text":"Səninlə ticarət etdilər.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Səba və Raama tacirləri","poem":1},{"lineBreak":true},{"text":"Səninlə ticarət etdi.","poem":1},{"lineBreak":true},{"text":"Mallarının əvəzinə sənə","poem":1},{"lineBreak":true},{"text":"Hər cür dəyərli ətriyyat, qiymətli daşlar və qızıl verdilər.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xaran, Kanne, Eden, Səba tacirləri, Aşşur və Kilmad","poem":1},{"lineBreak":true},{"text":"Səninlə ticarət etdi,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onlar bazarlarında","poem":1},{"lineBreak":true},{"text":"Gözəl paltar, bənövşəyi qumaş, naxışlı libaslar,","poem":1},{"lineBreak":true},{"text":"Sıx toxunmuş, iplərlə bağlanmış","poem":1},{"lineBreak":true},{"text":"Rəngli xalçalarla","poem":1},{"lineBreak":true},{"text":"Səninlə ticarət etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tarşiş gəmiləri","poem":1},{"noteId":7},{"text":"sənin mallarını daşıdı.","poem":1},{"lineBreak":true},{"text":"Dənizin qoynunda böyük yüklə doldun.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Avarçəkənlərin səni açıq dənizlərə çıxartdı,","poem":1},{"lineBreak":true},{"text":"Ancaq şərq yeli dənizin qoynunda səni parçaladı.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gəmin qəzaya uğradığı gün","poem":1},{"lineBreak":true},{"text":"Var-dövlətin, malların, ticarət şeylərin,","poem":1},{"lineBreak":true},{"text":"Gəmiçilərin, sükançıların,","poem":1},{"lineBreak":true},{"text":"Təmirçilərin, ticarət şəriklərin,","poem":1},{"lineBreak":true},{"text":"Döyüşçülərin – içində olan bütün camaat","poem":1},{"lineBreak":true},{"text":"Dənizin dərinliklərinə batacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sükançıların fəryadından","poem":1},{"lineBreak":true},{"text":"Dənizin sahilləri titrəyəcək.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Avarçəkənlərin hamısı gəmilərini tərk edəcək,","poem":1},{"lineBreak":true},{"text":"Gəmiçilərlə sükançıların hamısı","poem":1},{"lineBreak":true},{"text":"Gəmilərindən düşüb quruda dayanacaq.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Uca səslə sənin üçün","poem":1},{"lineBreak":true},{"text":"Acı-acı fəryad edəcəklər.","poem":1},{"lineBreak":true},{"text":"Başlarına torpaq səpələyəcəklər,","poem":1},{"lineBreak":true},{"text":"Küldə eşələnəcəklər.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sənin üçün saçlarını ülgüclə qırxacaqlar,","poem":1},{"lineBreak":true},{"text":"Çula bürünəcəklər.","poem":1},{"lineBreak":true},{"text":"Sənin üçün acı-acı ağlayıb","poem":1},{"lineBreak":true},{"text":"Yas tutacaqlar.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yaslarında sənin üçün mərsiyə oxuyub","poem":1},{"lineBreak":true},{"text":"Belə deyəcəklər:","poem":1},{"lineBreak":true},{"text":"‹Dənizin ortasında","poem":1},{"lineBreak":true},{"text":"Sur şəhəri kimi susdurulan","poem":1},{"lineBreak":true},{"text":"Bir şəhər varmı görəsən?›","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Malların dənizin o tayına çatanda","poem":1},{"lineBreak":true},{"text":"Çoxlu xalqı doydururdun.","poem":1},{"lineBreak":true},{"text":"Böyük var-dövlətinlə, malınla","poem":1},{"lineBreak":true},{"text":"Dünya padşahlarını sərvət sahibi edirdin.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"İndi isə dənizdə, suların dərinliyində","poem":1},{"lineBreak":true},{"text":"Xarabalığa çevrildiyin zaman","poem":1},{"lineBreak":true},{"text":"Mal-dövlətin və bütün camaatın","poem":1},{"lineBreak":true},{"text":"Səninlə birlikdə batdı.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Sahillərdə yaşayanların hamısı","poem":1},{"lineBreak":true},{"text":"Başına gələnlərdən heyrətə düşdü.","poem":1},{"lineBreak":true},{"text":"Onların padşahlarının tükləri biz-biz oldu,","poem":1},{"lineBreak":true},{"text":"Bənizləri soldu.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Millətlərin arasındakı tacirlər","poem":1},{"lineBreak":true},{"text":"Sənə görə fit çalacaq.","poem":1},{"lineBreak":true},{"text":"Aqibətin dəhşətli oldu,","poem":1},{"lineBreak":true},{"text":"Sən əbədi olaraq yox olacaqsan”».","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Tarşiş gəmiləri – yaxud ticarət gəmiləri.","reference":{"chapter":27,"verse":25}}]},"thisChapterLink":"/api/azb_bsa/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}