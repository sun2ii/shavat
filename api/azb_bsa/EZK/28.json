{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Sur padşahının əleyhinə peyğəmbərlik"]},{"type":"verse","number":1,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Ey bəşər oğlu, Sur hökmdarına söylə ki, Xudavənd Rəbb belə deyir: “Sən qürurlandın və belə söylədin:",{"text":"‹Mən Allaham,","poem":1},{"lineBreak":true},{"text":"Dənizlərin qoynunda,","poem":1},{"lineBreak":true},{"text":"Allahın taxtında otururam›.","poem":1},{"lineBreak":true},{"text":"Ürəyində özünü Allah sandın,","poem":1},{"lineBreak":true},{"text":"Ancaq sən Allah deyil, insansan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bax sən Danieldən daha müdriksən,","poem":1},{"lineBreak":true},{"text":"Heç kəs öz sirrini səndən gizlədə bilməz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Müdrikliyin və ağlınla özünə sərvət yığdın,","poem":1},{"lineBreak":true},{"text":"Xəzinələrinə qızıl-gümüş topladın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ticarətdə çox bacarıqlı olduğun üçün","poem":1},{"lineBreak":true},{"text":"Öz sərvətini artırdın.","poem":1},{"lineBreak":true},{"text":"Var-dövlətin çoxalanda","poem":1},{"lineBreak":true},{"text":"Özünə qürrələndin”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Buna görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“İndi ki ürəyində özünü Allah sandın,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən də yadelliləri, ən rəhmsiz millətləri","poem":1},{"lineBreak":true},{"text":"Üstünə göndərəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onlar sənin müdrikliyinin gözəlliyinə","poem":1},{"lineBreak":true},{"text":"Qılınc çəkib","poem":1},{"lineBreak":true},{"text":"Əzəmətini murdarlayacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Səni məzara endirəcəklər.","poem":1},{"lineBreak":true},{"text":"Sən dənizlərin qoynunda","poem":1},{"lineBreak":true},{"text":"Dəhşətli bir ölümlə məhv olacaqsan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Səni öldürənlərə də","poem":1},{"lineBreak":true},{"text":"‹Mən Allaham› deyəcəksənmi?","poem":1},{"lineBreak":true},{"text":"Səni öldürənlərin əlində","poem":1},{"lineBreak":true},{"text":"Sən Allah deyil, insansan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yadellilərin əlində","poem":1},{"lineBreak":true},{"text":"Sünnətsizlərin ölümü ilə öləcəksən”.","poem":1},{"lineBreak":true},{"text":"Çünki Mən bunu söylədim,","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb belə bəyan edir».","poem":1}]},{"type":"verse","number":11,"content":["Mənə yenə Xudavənd Rəbbin sözü nazil oldu: «Ey bəşər oğlu, Sur padşahı üçün mərsiyə oxuyub söylə ki, Xudavənd Rəbb belə deyir:"]},{"type":"verse","number":12,"content":[{"text":"“Sən kamilliyin möhürüsən,","poem":1},{"lineBreak":true},{"text":"Müdrikliyin bütöv,","poem":1},{"lineBreak":true},{"text":"Gözəlliyin qüsursuz idi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən Allahın bağçası olan","poem":1},{"lineBreak":true},{"text":"Eden bağında idin.","poem":1},{"lineBreak":true},{"text":"Cürbəcür qiymətli daşlarla –","poem":1},{"lineBreak":true},{"text":"Yaqut, topaz, almaz,","poem":1},{"lineBreak":true},{"text":"Sarı yaqut, damarlı əqiq, yəşəm daşı,","poem":1},{"lineBreak":true},{"text":"Göy yaqut, firuzə və zümrüdlə bəzənmişdin.","poem":1},{"lineBreak":true},{"text":"Qaxma və oyma işlərin qızıldan idi.","poem":1},{"lineBreak":true},{"text":"Bunlar yaradıldığın gün hazırlanmışdı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən məsh edilmiş, qoruyucu bir keruv idin.","poem":1},{"lineBreak":true},{"text":"Səni bunun üçün qoymuşdum.","poem":1},{"lineBreak":true},{"text":"Allahın müqəddəs dağının üstündə idin,","poem":1},{"lineBreak":true},{"text":"Odlu daşlar arasında gəzirdin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaradıldığın gündən","poem":1},{"lineBreak":true},{"text":"Səndə pislik tapılana qədər","poem":1},{"lineBreak":true},{"text":"Yollarında qüsursuz idin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bol ticarətindən ötrü","poem":1},{"lineBreak":true},{"text":"İçin zorakılıqla doldu,","poem":1},{"lineBreak":true},{"text":"Sən günah etdin.","poem":1},{"lineBreak":true},{"text":"Buna görə də səni murdar bir şey kimi","poem":1},{"lineBreak":true},{"text":"Allahın dağından atdım,","poem":1},{"lineBreak":true},{"text":"Odlu daşların arasından qovdum,","poem":1},{"lineBreak":true},{"text":"Ey qoruyucu keruv!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gözəl olduğun üçün ürəyin qürurlandı,","poem":1},{"lineBreak":true},{"text":"Əzəmətinə görə müdrikliyini korladın.","poem":1},{"lineBreak":true},{"text":"Beləcə səni yerə atdım,","poem":1},{"lineBreak":true},{"text":"Padşahların önündə tamaşaya çevirdim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çoxlu təqsir etdiyin üçün,","poem":1},{"lineBreak":true},{"text":"Ticarətdə əliəyriliyinə görə","poem":1},{"lineBreak":true},{"text":"Müqəddəs məkanlarını murdarladın.","poem":1},{"lineBreak":true},{"text":"Mən içindən bir od çıxardım ki,","poem":1},{"lineBreak":true},{"text":"Səni yandırıb məhv etsin.","poem":1},{"lineBreak":true},{"text":"Bütün seyr edənlərin gözü önündə","poem":1},{"lineBreak":true},{"text":"Səni torpaq üstündə külə çevirdim.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Xalqlar arasında səni tanıyanlar","poem":1},{"lineBreak":true},{"text":"Fəlakətinə heyrət etdi.","poem":1},{"lineBreak":true},{"text":"Aqibətin dəhşətli oldu,","poem":1},{"lineBreak":true},{"text":"Artıq salamat qalmayacaqsan”».","poem":1}]},{"type":"heading","content":["Sidonun əleyhinə peyğəmbərlik"]},{"type":"verse","number":20,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":21,"content":["«Ey bəşər oğlu, üzünü Sidona tərəf çevirib onun əleyhinə peyğəmbərlik edərək söylə ki,"]},{"type":"verse","number":22,"content":["Xudavənd Rəbb belə deyir:",{"text":"“Ey Sidon, Mən sənin əleyhinəyəm,","poem":1},{"lineBreak":true},{"text":"Sənin içində izzət qazanacağam.","poem":1},{"lineBreak":true},{"text":"Mən sakinlərini cəzalandırıb","poem":1},{"lineBreak":true},{"text":"Onların arasında müqəddəs tutulanda","poem":1},{"lineBreak":true},{"text":"Biləcəklər ki, Rəbb Mənəm.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Əhalinin içinə vəba,","poem":1},{"lineBreak":true},{"text":"Küçələrinə qan göndərəcəyəm.","poem":1},{"lineBreak":true},{"text":"Hər tərəfdən onların üstünə gələn qılıncla","poem":1},{"lineBreak":true},{"text":"Vurulub həlak olacaqlar.","poem":1},{"lineBreak":true},{"text":"Onda biləcəklər ki, Rəbb Mənəm.","poem":1}]},{"type":"heading","content":["Allahın İsrail xalqına vədi"]},{"type":"verse","number":24,"content":["İsrail nəslinin ətrafında olub onları təhqir edən heç bir xalq bir daha İsrail üçün batan tikan, sancan qanqal olmayacaq. Onda biləcəklər ki, Rəbb Mənəm”."]},{"type":"verse","number":25,"content":["Xudavənd Rəbb belə deyir: “İsrail xalqını aralarına səpələdiyim xalqların içindən yığanda, millətlərin gözü önündə müqəddəs tutulanda onlar qulum Yaquba verdiyim torpaqlarında sakin olacaq."]},{"type":"verse","number":26,"content":["Orada asayiş içində yaşayacaq, evlər tikəcək və bağlar salacaqlar. Onları təhqir edən bütün ətraf xalqları cəzalandırdığım zaman asayiş içində yaşayacaqlar. Onda biləcəklər ki, Rəbb Mənəm”»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}