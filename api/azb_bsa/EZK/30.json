{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"EZK","translationId":"azb_bsa","name":"YEZEKEL","commonName":"YEZEKEL","title":"YEZEKEL PEYĞƏMBƏRİN KİTABI","order":26,"numberOfChapters":48,"sha256":"fbf25715e4d4d4e607088244cd7448ad6703d834139c087822ad1f202a7cdd9f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/azb_bsa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Rəbbin Misirliləri cəzalandırması"]},{"type":"verse","number":1,"content":["Mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Ey bəşər oğlu, peyğəmbərlik edib söylə ki, Xudavənd Rəbb belə deyir:",{"text":"“‹Ah, o gün› deyib fəryad edin,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki o gün yaxındır,","poem":1},{"lineBreak":true},{"text":"Rəbbin günü yaxındır.","poem":1},{"lineBreak":true},{"text":"O gün buludlu gündür,","poem":1},{"lineBreak":true},{"text":"Millətlərin qiyamət günüdür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Misirin üstünə qılınc gələcək,","poem":1},{"lineBreak":true},{"text":"Kuş əzab çəkəcək.","poem":1},{"lineBreak":true},{"text":"Misirdə adamlar həlak olanda","poem":1},{"lineBreak":true},{"text":"Ölkənin sərvəti qarət olunacaq,","poem":1},{"lineBreak":true},{"text":"O öz təməlindən dağılacaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Misirlə birlikdə Kuş, Put, Lud,","poem":1},{"lineBreak":true},{"text":"Bütün Ərəbistan, Kuv və əhd bağladığı ölkənin adamları","poem":1},{"lineBreak":true},{"text":"Qılıncdan keçiriləcək”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Misirə arxa olanlar yıxılacaq,","poem":1},{"lineBreak":true},{"text":"Onun qürurlandığı qüdrət çökəcək.","poem":1},{"lineBreak":true},{"text":"Miqdoldan Asvana qədər ərazidə","poem":1},{"lineBreak":true},{"text":"Qılıncdan keçiriləcəklər”","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Misir xaraba qalmış ölkələr kimi","poem":1},{"lineBreak":true},{"text":"Xaraba qalacaq.","poem":1},{"lineBreak":true},{"text":"Şəhərləri viran olmuş","poem":1},{"lineBreak":true},{"text":"Şəhərlər kimi viran olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mən Misiri oda təslim edəndə,","poem":1},{"lineBreak":true},{"text":"Ona kömək edənlər əziləndə","poem":1},{"lineBreak":true},{"text":"Biləcəklər ki, Rəbb Mənəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["O gün qayğısız Kuş əhalisini qorxutmaq üçün gəmilərlə qasidlər göndərəcəyəm. Onlar Misirin dağıldığı gün gələndə dəhşətə düşəcək. Budur, o gün gəlir!”"]},{"type":"verse","number":10,"content":[{"text":"Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Babil padşahı Navuxodonosor vasitəsilə","poem":1},{"lineBreak":true},{"text":"Misirin sərvətinə son qoyacağam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O öz ordusu ilə, millətlər arasında ən rəhmsizi ilə","poem":1},{"lineBreak":true},{"text":"Ölkəni yerlə yeksan etmək üçün gətiriləcək.","poem":1},{"lineBreak":true},{"text":"Misirə qarşı qılınc çəkəcək,","poem":1},{"lineBreak":true},{"text":"Ölkəni ölülərlə dolduracaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çayları qurudub,","poem":1},{"lineBreak":true},{"text":"Ölkəni pis adamlara satacağam.","poem":1},{"lineBreak":true},{"text":"Ölkəni də, orada olan hər şeyi də","poem":1},{"lineBreak":true},{"text":"Yadellilərin əli ilə viran edəcəyəm”","poem":1},{"lineBreak":true},{"text":"Mən Rəbb bunu söylədim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Bütləri məhv edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Nofdakı","poem":1},{"noteId":9},{"text":"bütləri yox edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Artıq Misirdə rəhbər qalmayacaq,","poem":1},{"lineBreak":true},{"text":"Ölkəni dəhşətə salacağam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Patrosu xarabalığa çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Soanı oda verəcəyəm,","poem":1},{"lineBreak":true},{"text":"No","poem":1},{"noteId":10},{"text":"şəhərini cəzalandıracağam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qəzəbimi Misirin qalası olan","poem":1},{"lineBreak":true},{"text":"Sin üzərinə tökəcəyəm,","poem":1},{"lineBreak":true},{"text":"No şəhərinin çoxlu əhalisini yox edəcəyəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Misiri oda verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sin ağrıdan qıvrılacaq,","poem":1},{"lineBreak":true},{"text":"No şəhərinin divarı yarılacaq.","poem":1},{"lineBreak":true},{"text":"Gündüz vaxtı Nofda","poem":1},{"lineBreak":true},{"text":"Düşmənlər cövlan edəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"On şəhərinin və Pi-Besetin cavanları","poem":1},{"lineBreak":true},{"text":"Qılıncdan keçiriləcək.","poem":1},{"lineBreak":true},{"text":"Oradakı əhali sürgün olunacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Taxpanxesdə Misirin boyunduruğunu qırdığım zaman","poem":1},{"lineBreak":true},{"text":"Orada gündüz qaranlığa çevriləcək,","poem":1},{"lineBreak":true},{"text":"Qürurlandığı qüdrət məhv olacaq.","poem":1},{"lineBreak":true},{"text":"Şəhər buludlarla örtüləcək,","poem":1},{"lineBreak":true},{"text":"Qızları sürgün olunacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Beləcə Misiri cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"Onda biləcəklər ki, Rəbb Mənəm”».","poem":1}]},{"type":"verse","number":20,"content":["Sürgünlüyümüzün on birinci ilində, birinci ayın yeddinci günü mənə Rəbbin sözü nazil oldu:"]},{"type":"verse","number":21,"content":["«Ey bəşər oğlu, Misir padşahı fironun qolunu qırdım. Qolu sağalmaq üçün bağlanmadı, ona sarğı qoyulmadı ki, qılınc ələ alacaq qədər güclənsin."]},{"type":"verse","number":22,"content":["Buna görə də Xudavənd Rəbb belə deyir: “Mən Misir padşahı fironun əleyhinəyəm. Hər iki qolunu – sağlam olanı da, sınanı da qıracaq, qılıncı əlindən salacağam."]},{"type":"verse","number":23,"content":["Misirliləri millətlər arasına yayacağam, ölkələr arasına səpələyəcəyəm."]},{"type":"verse","number":24,"content":["Babil padşahının qoluna güc verəcək, qılıncımı onun əlinə verəcəyəm. Fironun isə qollarını qıracağam. O, Babil padşahının önündə ağır yaralı kimi inildəyəcək."]},{"type":"verse","number":25,"content":["Babil padşahının qoluna güc verəcəyəm, fironun qolları isə yanına düşəcək. Qılıncımı Babil padşahının əlinə verəndə, o da bu qılıncı Misir ölkəsinə tuşlayanda biləcəklər ki, Rəbb Mənəm."]},{"type":"verse","number":26,"content":["Misirliləri millətlər arasına yayacağam və ölkələr arasına səpələyəcəyəm. Onda biləcəklər ki, Rəbb Mənəm”»."]}],"footnotes":[{"noteId":9,"caller":"+","text":"Nof – yunan adı Memfis.","reference":{"chapter":30,"verse":13}},{"noteId":10,"caller":"+","text":"No – yunan adı Fiv.","reference":{"chapter":30,"verse":14}}]},"thisChapterLink":"/api/azb_bsa/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}