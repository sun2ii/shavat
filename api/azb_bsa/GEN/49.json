{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"GEN","translationId":"azb_bsa","name":"YARADILIŞ","commonName":"YARADILIŞ","title":"YARADILIŞ KİTABI","order":1,"numberOfChapters":50,"sha256":"e07fa3d592e404b8cad1a9161745299e199da9416aff09aba4a6c0fd4e10b3a6","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/azb_bsa/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaqubun oğullarına xeyir-duası"]},{"type":"verse","number":1,"content":["Yaqub oğullarını çağırıb dedi: «Yanıma toplaşın, gələcəkdə başınıza gələnləri sizə söyləyim:"]},{"type":"verse","number":2,"content":[{"text":"Ey Yaqub oğulları, yığılıb eşidin,","poem":1},{"lineBreak":true},{"text":"Atanız İsrailə qulaq asın:","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey Ruven, ilk oğlum,","poem":1},{"lineBreak":true},{"text":"Sən mənim gücümsən, qüdrətimin başlanğıcısan.","poem":1},{"lineBreak":true},{"text":"Ləyaqətin hamıdan üstündür,","poem":1},{"lineBreak":true},{"text":"Qüvvətin hamıdan çoxdur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma sən su kimi oynaqsan,","poem":1},{"lineBreak":true},{"text":"Artıq üstün olmayacaqsan.","poem":1},{"lineBreak":true},{"text":"Çünki atanın yatağına girib","poem":1},{"lineBreak":true},{"text":"Onu murdar etdin –","poem":1},{"lineBreak":true},{"text":"Bax o, döşəyimə çıxdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Şimeonla Levi qardaşdır,","poem":1},{"lineBreak":true},{"text":"Qəddarlıq qılıncları ilə silahlanıblar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey qəlbim, onların məclisinə getmə,","poem":1},{"lineBreak":true},{"text":"Ey şərəfim, onların toplantısında olma.","poem":1},{"lineBreak":true},{"text":"Çünki onlar qəzəblənəndə qətl etdilər,","poem":1},{"lineBreak":true},{"text":"Əylənəndə öküzlərin ayaq vətərini kəsdilər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lənət olsun vəhşi qəzəblərinə,","poem":1},{"lineBreak":true},{"text":"Lənət olsun qəddar hiddətlərinə.","poem":1},{"lineBreak":true},{"text":"Onları Yaqubda böləcəyəm,","poem":1},{"lineBreak":true},{"text":"İsraildə səpələyəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yəhuda, qardaşların səni mədh edəcək,","poem":1},{"lineBreak":true},{"text":"Düşmənlərin boynu əlində olacaq,","poem":1},{"lineBreak":true},{"text":"Atanın oğulları önündə səcdə edəcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yəhuda bir aslan balasıdır,","poem":1},{"lineBreak":true},{"text":"Ey oğlum, sən şikara çıxanda","poem":1},{"lineBreak":true},{"text":"Bir şir kimi yerə əyilirsən,","poem":1},{"lineBreak":true},{"text":"Dişi aslan kimi torpağa yatırsan.","poem":1},{"lineBreak":true},{"text":"Kim səni yerindən qaldıra bilər?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Padşahlıq əsası","poem":1},{"lineBreak":true},{"text":"Yəhudanın əlindən getməyəcək,","poem":1},{"lineBreak":true},{"text":"Hökmdarlıq əsası onun nəslindən itməyəcək;","poem":1},{"lineBreak":true},{"text":"O vaxta qədər ki əsanın Sahibi","poem":1},{"noteId":59},{"text":"gələcək.","poem":1},{"lineBreak":true},{"text":"Onda xalqlar Ona itaət edəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eşşəyini tənəyə,","poem":1},{"lineBreak":true},{"text":"Ulağını ən seçmə bir tənəyə bağlayacaq.","poem":1},{"lineBreak":true},{"text":"Paltarını şərabda,","poem":1},{"lineBreak":true},{"text":"Köynəyini üzümün qanında yuyacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gözləri şərabdan da parlaq olacaq,","poem":1},{"lineBreak":true},{"text":"Dişləri süddən də ağ olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zevulun isə dəniz kənarında yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Ora gəmilərin limanı olacaq,","poem":1},{"lineBreak":true},{"text":"Ərazisi Sidonun yanınadək uzanacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Qoyun ağılları arasında uzanan İssakar","poem":1},{"lineBreak":true},{"text":"Bir qüvvətli ulağa oxşar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O, yaxşı və rahat olan yer,","poem":1},{"lineBreak":true},{"text":"Bir səfalı ölkə görsə,","poem":1},{"lineBreak":true},{"text":"Çiynini yük daşımaq üçün əyər,","poem":1},{"lineBreak":true},{"text":"Mükəlləfiyyətçi qul olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dan İsrail qəbilələrindən biri olub","poem":1},{"lineBreak":true},{"text":"Öz xalqına hökm edəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dan yol üstündə bir ilan,","poem":1},{"lineBreak":true},{"text":"Cığırda bir gürzə olacaq;","poem":1},{"lineBreak":true},{"text":"Elə bir gürzə ki atın topuğundan sancır,","poem":1},{"lineBreak":true},{"text":"Süvarisi arxası üstə yıxılır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ya Rəbb! Mən Sənin xilasını gözləyirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Qad talançı basqınına düçar olacaq,","poem":1},{"lineBreak":true},{"text":"Lakin onları topuğundan vuracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aşerdən zəngin nemətlər gələcək,","poem":1},{"lineBreak":true},{"text":"O, şahanə ləzzətli yeməklər yetirəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naftali azad edilmiş bir maraldır,","poem":1},{"lineBreak":true},{"text":"Ondan gözəl balalar doğulacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yusif barlı bir ağac,","poem":1},{"lineBreak":true},{"text":"Çeşmə kənarında meyvəli bir ağacdır,","poem":1},{"lineBreak":true},{"text":"Budaqları divarın üstündən aşar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Oxçular ona güclü hücum etdilər,","poem":1},{"lineBreak":true},{"text":"Düşmənçilik edib üstünə ox yağdırdılar.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amma Yaqubun qüdrətli Allahı –","poem":1},{"lineBreak":true},{"text":"İsrailin Daşı və Çobanı olan","poem":1},{"lineBreak":true},{"text":"Allahın sayəsində","poem":1},{"lineBreak":true},{"text":"Onun kamanı möhkəm,","poem":1},{"lineBreak":true},{"text":"Qolları qüvvətli oldu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sənə kömək edən","poem":1},{"lineBreak":true},{"text":"Atanın Allahıdır,","poem":1},{"lineBreak":true},{"text":"Sənə xeyir-dua verən","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyardır.","poem":1},{"lineBreak":true},{"text":"Yuxarıda göylərin bərəkəti ilə,","poem":1},{"lineBreak":true},{"text":"Dərinlikdə olan","poem":1},{"lineBreak":true},{"text":"Su mənbələrinin bərəkəti ilə,","poem":1},{"lineBreak":true},{"text":"Döşlərin və bətnlərin bərəkəti ilə","poem":1},{"lineBreak":true},{"text":"Sənə xeyir-dua verəcək.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Atanın xeyir-duası","poem":1},{"lineBreak":true},{"text":"Atalarımın xeyir-duasından daha ucadır;","poem":1},{"lineBreak":true},{"text":"Əbədi qalan təpələrin","poem":1},{"lineBreak":true},{"text":"Zirvəsinə çatar.","poem":1},{"lineBreak":true},{"text":"Qoy xeyir-dualarım","poem":1},{"lineBreak":true},{"text":"Yusifin – qardaşlar arasında","poem":1},{"lineBreak":true},{"text":"Başçı olanın üstündə olsun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Binyamin acgöz bir qurddur,","poem":1},{"lineBreak":true},{"text":"Səhər ovunu yeyər,","poem":1},{"lineBreak":true},{"text":"Axşam qənimət paylar».","poem":1}]},{"type":"verse","number":28,"content":["Bunların hamısı İsrailin on iki qəbiləsidir. Ataları onlara xeyir-dua verərkən bu sözləri söylədi və hər birinə xeyir-dua verdi."]},{"type":"heading","content":["Yaqubun ölümü"]},{"type":"verse","number":29,"content":["Sonra Yaqub oğullarına vəsiyyət edib dedi: «Mən ölüb əcdadlarıma qoşulacağam. Məni atalarımın yanında – Xetli Efronun tarlasında olan mağarada basdırın."]},{"type":"verse","number":30,"content":["O mağara Kənan torpağında olan Mamre qarşısındakı Maxpela tarlasındadır. İbrahim o mağaranı qəbir düzəltmək üçün Xetli Efrondan tarlası ilə birlikdə satın almışdı."]},{"type":"verse","number":31,"content":["İbrahimlə arvadı Sara və İshaqla arvadı Rivqa orada basdırılmışdı. Mən Leanı da orada basdırdım."]},{"type":"verse","number":32,"content":["Həmin tarla ilə oradakı mağara Xetlilərdən satın alınıb»."]},{"type":"verse","number":33,"content":["Yaqub oğullarına vəsiyyət edib qurtaranda ayaqlarını yatağına yığaraq son dəfə nəfəs aldı və ölüb əcdadlarına qoşuldu."]}],"footnotes":[{"noteId":59,"caller":"+","text":"Əsanın Sahibi – ibrani mətnində Şilo sözü olub mənası tam aydın deyil.","reference":{"chapter":49,"verse":10}}]},"thisChapterLink":"/api/azb_bsa/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}