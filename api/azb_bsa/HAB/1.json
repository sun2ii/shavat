{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HAB","translationId":"azb_bsa","name":"HABAQQUQ","commonName":"HABAQQUQ","title":"HABAQQUQ PEYĞƏMBƏRİN KİTABI","order":35,"numberOfChapters":3,"sha256":"7ce36fecbeb1f68538da234e84b58a3260bbff7e43f483327bccaa2e2f12c987","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Habaqquq peyğəmbərə görüntü ilə nazil olan xəbərdarlıq."]},{"type":"heading","content":["Habaqququn şikayəti"]},{"type":"verse","number":2,"content":[{"text":"Ya Rəbb, nə vaxta qədər Səni imdada çağıracağam?","poem":1},{"lineBreak":true},{"text":"Sənsə eşitmirsən.","poem":1},{"lineBreak":true},{"text":"«Zorakılıq var!» deyə Sənə fəryad edirəm,","poem":1},{"lineBreak":true},{"text":"Lakin bizi qurtarmırsan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niyə mənə şər göstərirsən,","poem":1},{"lineBreak":true},{"text":"Özün də haqsızlığa baxırsan?","poem":1},{"lineBreak":true},{"text":"Hara nəzər salsam,","poem":1},{"lineBreak":true},{"text":"Orada soyğunçuluq və zorakılıq var,","poem":1},{"lineBreak":true},{"text":"Davaların, çəkişmələrin sonu yoxdur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buna görə qanun qüvvədən düşdü,","poem":1},{"lineBreak":true},{"text":"Ədalətə üstünlük verilmir.","poem":1},{"lineBreak":true},{"text":"Pis adamlar salehləri dövrəyə alır,","poem":1},{"lineBreak":true},{"text":"Ona görə ədalət təhrif olunur.","poem":1}]},{"type":"heading","content":["Rəbbin cavabı"]},{"type":"verse","number":5,"content":[{"text":"Baxın o biri millətlərə,","poem":1},{"lineBreak":true},{"text":"Gördüklərinizə təəccüblənərək mat qalın.","poem":1},{"lineBreak":true},{"text":"Sizin vaxtınızda elə işlər görəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Bunu sizə danışsalar, inanmazsınız.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Budur, Mən amansız və qəddar milləti –","poem":1},{"lineBreak":true},{"text":"Dünyanın dörd tərəfinə yüyürən,","poem":1},{"lineBreak":true},{"text":"Özgə məskənləri zəbt edən","poem":1},{"lineBreak":true},{"text":"Xaldeyliləri qaldırıram.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onlar dəhşətli və qorxuncdur,","poem":1},{"lineBreak":true},{"text":"Ədalət və şərəf yalnız onlar deyəndir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Atları bəbirdən çevik,","poem":1},{"lineBreak":true},{"text":"Özləri isə ac qurddan daha azğındır,","poem":1},{"lineBreak":true},{"text":"Süvariləri yeri deşərək uzaqdan gəlir,","poem":1},{"lineBreak":true},{"text":"Şikarını yeməyə cuman qartal kimi şığıyır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onların hamısı zorakılıq üçün gəlir,","poem":1},{"lineBreak":true},{"text":"Hamısı bir nəfər kimi irəliyə üz tutur,","poem":1},{"lineBreak":true},{"text":"Əsirləri qum kimi yığırlar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Padşahlara rişxənd edirlər,","poem":1},{"lineBreak":true},{"text":"Hökmdarlara gülürlər.","poem":1},{"lineBreak":true},{"text":"Hər qalalı şəhərə lağ edirlər,","poem":1},{"lineBreak":true},{"text":"Oraya torpaq qalağı töküb ələ keçirirlər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onlar yel kimi keçib-gedir.","poem":1},{"lineBreak":true},{"text":"Qüvvələrini özlərinə allah edən bu adamlar","poem":1},{"lineBreak":true},{"text":"Təqsirkar sayılacaq.","poem":1}]},{"type":"heading","content":["Habaqquq yenə də Rəbbə şikayət edir"]},{"type":"verse","number":12,"content":[{"text":"Əzəldən bəri var olan Sən deyilsənmi?","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, Allahım, Müqəddəs Olanım,","poem":1},{"lineBreak":true},{"text":"Biz ölməyəcəyik.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, məhkum etmək üçün onları təyin etdin.","poem":1},{"lineBreak":true},{"text":"Ey Qayamız, bizi cəzalandırma hökmünü onlara verdin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sənin gözlərin çox təmizdir,","poem":1},{"lineBreak":true},{"text":"Şəri görən gözün yoxdur,","poem":1},{"lineBreak":true},{"text":"Pis əməllərə dözə bilmirsən.","poem":1},{"lineBreak":true},{"text":"Bəs xəyanətkarlara necə baxa bilirsən?","poem":1},{"lineBreak":true},{"text":"Pis özündən daha salehin başını yeyəndə","poem":1},{"lineBreak":true},{"text":"Axı niyə susursan?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən insanları sanki dəniz balıqlarına,","poem":1},{"lineBreak":true},{"text":"Başçıları olmayan sürünən canlılara çevirdin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O onların hamısını qarmaqla çəkir,","poem":1},{"lineBreak":true},{"text":"Torla çıxarır, ağlarına","poem":1},{"noteId":0},{"text":"yığır,","poem":1},{"lineBreak":true},{"text":"Buna sevinib-şadlanır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Buna görə torları üçün qurban kəsir,","poem":1},{"lineBreak":true},{"text":"Ağları üçün buxur yandırır,","poem":1},{"lineBreak":true},{"text":"Axı o bu torlarla","poem":1},{"lineBreak":true},{"text":"Bol və ləzzətli yemək əldə edir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Torunu durmadan boşaltmağa,","poem":1},{"lineBreak":true},{"text":"Millətləri amansızcasına qırmağa davam edəcəkmi?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ağ – torun bir növü.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/azb_bsa/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}