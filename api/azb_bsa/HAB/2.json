{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HAB","translationId":"azb_bsa","name":"HABAQQUQ","commonName":"HABAQQUQ","title":"HABAQQUQ PEYĞƏMBƏRİN KİTABI","order":35,"numberOfChapters":3,"sha256":"7ce36fecbeb1f68538da234e84b58a3260bbff7e43f483327bccaa2e2f12c987","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Keşiyimdə duracağam,","poem":1},{"lineBreak":true},{"text":"Gözətçi qülləsində dayanacağam.","poem":1},{"lineBreak":true},{"text":"Baxım Rəbb mənə nə deyəcək,","poem":1},{"lineBreak":true},{"text":"Görüm şikayətlərimə nə cavab verəcək?","poem":1}]},{"type":"heading","content":["Rəbbin cavabı"]},{"type":"verse","number":2,"content":[{"text":"Rəbb mənə belə cavab verdi:","poem":1},{"lineBreak":true},{"text":"«Görüntünü yaz, lövhələrdə açıqla ki,","poem":1},{"lineBreak":true},{"text":"Qoy hər kəs tez onu oxuya bilsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki bu görüntü müəyyən vaxt üçündür,","poem":1},{"lineBreak":true},{"text":"Başa çatmağa tələsir və yalan deyil.","poem":1},{"lineBreak":true},{"text":"Gecikmiş kimi görünsə də, gözləyin,","poem":1},{"lineBreak":true},{"text":"Hökmən gələcək, gecikməyəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bax, bu adam məğrurdur, köksündəki ürəyi düz deyil,","poem":1},{"lineBreak":true},{"text":"Amma saleh adam imanı ilə yaşayacaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Həm də bu məğruru şərab aldadır,","poem":1},{"lineBreak":true},{"text":"Bu təkəbbürlü adam sakit durmaz,","poem":1},{"lineBreak":true},{"text":"Acgözlüyünü ölülər diyarı kimi genişləndirir,","poem":1},{"lineBreak":true},{"text":"Ölüm kimi heç doymaz.","poem":1},{"lineBreak":true},{"text":"Bütün millətləri özü üçün toplayar,","poem":1},{"lineBreak":true},{"text":"Bütün xalqları özü üçün əsir alar.","poem":1}]},{"type":"heading","content":["Xaldeylilərin sonrakı aqibəti"]},{"type":"verse","number":6,"content":[{"text":"Amma bütün bu əsir alınanlar","poem":1},{"lineBreak":true},{"text":"Onu lağa qoyacaqlar,","poem":1},{"lineBreak":true},{"text":"İstehzalı müəmmalarla deyəcəklər:","poem":1},{"lineBreak":true},{"text":"“Özünə aid olmayanı ələ keçirənin,","poem":1},{"lineBreak":true},{"text":"Xərac alıb varlananın vay halına!","poem":1},{"lineBreak":true},{"text":"Bu nə vaxta qədər davam edəcək?”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənə xərac verənlər bir gün","poem":1},{"lineBreak":true},{"text":"Qəflətən qiyam etməzmi?","poem":1},{"lineBreak":true},{"text":"Oyanıb sizi qorxutmazmı?","poem":1},{"lineBreak":true},{"text":"Budur, o vaxt onlara qənimət olacaqsan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bir çox milləti soyduğun üçün","poem":1},{"lineBreak":true},{"text":"Xalqlardan sağ qalanlar səni də soyacaq.","poem":1},{"lineBreak":true},{"text":"Çünki insan qanı tökdün,","poem":1},{"lineBreak":true},{"text":"Ölkələrə və şəhərlərə,","poem":1},{"lineBreak":true},{"text":"Orada yaşayan hər kəsə zorakılıq etdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Evini haram qazancla dolduranın,","poem":1},{"lineBreak":true},{"text":"Fəlakətdən qaçmaq üçün","poem":1},{"lineBreak":true},{"text":"Yuvasını yüksək yerdə quranın vay halına!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sən çox xalqları qırmaqla","poem":1},{"lineBreak":true},{"text":"Öz evini rüsvay etdin,","poem":1},{"lineBreak":true},{"text":"Öz həyatına günah gətirdin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Belə ki divar daşları bu barədə fəryad qoparacaq,","poem":1},{"lineBreak":true},{"text":"Taxta tirlər əks-səda verəcək!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şəhəri qanlarla tikənin,","poem":1},{"lineBreak":true},{"text":"Kəndi haqsızlıqla quranın vay halına!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xalqlar odda yandırılmaq üçün zəhmət çəkir,","poem":1},{"lineBreak":true},{"text":"Ümmətlər boş yerə özünü yorur.","poem":1},{"lineBreak":true},{"text":"Bu, Ordular Rəbbindən deyilmi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki sular dənizi bürüdüyü kimi","poem":1},{"lineBreak":true},{"text":"Dünya Rəbbin izzətinin biliyi ilə doldurulacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Qonşuların çılpaq bədənlərinə tamaşa etmək üçün","poem":1},{"lineBreak":true},{"text":"Onlara şərab içirdib sərxoş edənin,","poem":1},{"lineBreak":true},{"text":"İçkiyə zəhrimar qatanın vay halına!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hörmət əvəzinə xəcalətlə doyacaqsan,","poem":1},{"lineBreak":true},{"text":"Sən də iç, çılpaqlığını göstər;","poem":1},{"lineBreak":true},{"text":"Rəbbin sağ əlindəki cam","poem":1},{"lineBreak":true},{"text":"Sənin üzərində fırlanacaq.","poem":1},{"lineBreak":true},{"text":"Rüsvayçılıq hörmətin üzərinə gələcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Livanda etdiyin zorakılıq öz başına gələcək,","poem":1},{"lineBreak":true},{"text":"Heyvanların qırğını səni dəhşətə gətirəcək;","poem":1},{"lineBreak":true},{"text":"Çünki insan qanı tökdün,","poem":1},{"lineBreak":true},{"text":"Ölkələrə və şəhərlərə,","poem":1},{"lineBreak":true},{"text":"Orada yaşayan hər kəsə zorakılıq etdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sənətkarın oyduğu yonma ya tökmə bütün","poem":1},{"lineBreak":true},{"text":"Yalan öyrətməkdən başqa nə xeyri var?","poem":1},{"lineBreak":true},{"text":"Bütü düzəldən sənətkar öz işinə güvənir,","poem":1},{"lineBreak":true},{"text":"Amma onun düzəltdiyi","poem":1},{"lineBreak":true},{"text":"Dilsiz bütdən başqa nədir ki?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Taxtaya “Oyan!”, dilsiz daşa “Qalx!”","poem":1},{"lineBreak":true},{"text":"Deyən insanın vay halına!","poem":1},{"lineBreak":true},{"text":"Büt yol göstərə bilərmi?","poem":1},{"lineBreak":true},{"text":"Budur o, qızılla, gümüşlə örtülüb,","poem":1},{"lineBreak":true},{"text":"Daxilində isə həyat nəfəsi yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lakin Rəbb müqəddəs məbədindədir,","poem":1},{"lineBreak":true},{"text":"Qoy bütün dünya Onun önündə sussun!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}