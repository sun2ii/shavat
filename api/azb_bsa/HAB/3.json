{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HAB","translationId":"azb_bsa","name":"HABAQQUQ","commonName":"HABAQQUQ","title":"HABAQQUQ PEYĞƏMBƏRİN KİTABI","order":35,"numberOfChapters":3,"sha256":"7ce36fecbeb1f68538da234e84b58a3260bbff7e43f483327bccaa2e2f12c987","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Habaqququn duası"]},{"type":"verse","number":1,"content":[{"text":"Peyğəmbər Habaqququn duası,","poem":1},{"lineBreak":true},{"text":"Şiqqayonlar","poem":1},{"noteId":1},{"text":"kökü üstündə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ya Rəbb, Sənin şöhrətin haqqında eşitdim,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, gördüyün işlərə görə qorxdum.","poem":1},{"lineBreak":true},{"text":"Bizim vaxtımızda da eyni işlər gör,","poem":1},{"lineBreak":true},{"text":"Bizim dövrümüzdə bunları bildir!","poem":1},{"lineBreak":true},{"text":"Qəzəblənəndə mərhəmətini xatırla!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Allah Temandan,","poem":1},{"lineBreak":true},{"text":"Müqəddəs Olan Paran dağından gəldi. Sela3:3 Sela – fərz edilir ki, bu bir musiqi terminidir.","poem":1},{"lineBreak":true},{"text":"Ehtişamı göyü bürüdü,","poem":1},{"lineBreak":true},{"text":"Yer üzü Ona edilən həmd-sənalarla doldu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cah-calalı günəş tək parıldayır,","poem":1},{"lineBreak":true},{"text":"Əlindən nur tökülür,","poem":1},{"lineBreak":true},{"text":"Qüdrəti əlində gizli saxlanılıb.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vəba Onun önündə gedir,","poem":1},{"lineBreak":true},{"text":"Ölümcül xəstəlik arxasınca gəlir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O durdu, yeri tərpətdi,","poem":1},{"lineBreak":true},{"text":"Baxdı, millətləri sarsıtdı,","poem":1},{"lineBreak":true},{"text":"Qədim dağlar dağıldı,","poem":1},{"lineBreak":true},{"text":"Əzəldən qalan təpələr ona baş əydi.","poem":1},{"lineBreak":true},{"text":"Allahın yolu əbədidir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gördüm ki, Kuşan çadırları əziyyət altındadır,","poem":1},{"lineBreak":true},{"text":"Midyan çadırlarının pərdələri lərzəyə gəldi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb, məgər Sən","poem":1},{"lineBreak":true},{"text":"Çaylara qarşı qəzəblənmisən?","poem":1},{"lineBreak":true},{"text":"Acığın irmaqlara qarşıdırmı?","poem":1},{"lineBreak":true},{"text":"Yoxsa dənizə qarşı hiddətlənmisən?","poem":1},{"lineBreak":true},{"text":"Axı atlarına, müzəffər döyüş arabalarına minmisən?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yayını açdın,","poem":1},{"lineBreak":true},{"text":"Oxdanını oxlarla doldurdun. Sela","poem":1},{"lineBreak":true},{"text":"Yer üzünü çaylarla yardın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Səni görüb dağlar lərzəyə gəldi,","poem":1},{"lineBreak":true},{"text":"Sellər hər yanı süpürüb axdı,","poem":1},{"lineBreak":true},{"text":"Dərinliklər gurladı, dalğalar qalxdı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uçan oxlarının qığılcımından,","poem":1},{"lineBreak":true},{"text":"İşıldayan nizənin parıltısından","poem":1},{"lineBreak":true},{"text":"Günəş və ay yerlərində durdu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yer üzündə qəzəb içində gəzdin,","poem":1},{"lineBreak":true},{"text":"Millətləri hiddətlə tapdaladın.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən Öz xalqının qurtulması üçün,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyinin xilası üçün çıxdın,","poem":1},{"lineBreak":true},{"text":"Şər nəslin başçısını əzdin,","poem":1},{"lineBreak":true},{"text":"Təpədən dırnağa qədər onu soydun. Sela","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Cəngavərləri fırtına tək","poem":1},{"lineBreak":true},{"text":"Bizi dağıtmağa gələndə","poem":1},{"lineBreak":true},{"text":"Onların başını öz nizələri ilə deşdin.","poem":1},{"lineBreak":true},{"text":"Onlar gizlənən zavallıları","poem":1},{"lineBreak":true},{"text":"Məhv edənlər kimi sevinərdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sən Öz atlarınla dənizi tapdaladın,","poem":1},{"lineBreak":true},{"text":"Coşğun suları köpüklətdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Eşitdim və varlığım lərzəyə gəldi,","poem":1},{"lineBreak":true},{"text":"Səsindən dodaqlarım əsdi.","poem":1},{"lineBreak":true},{"text":"Çürüklük sümüklərimə girdi,","poem":1},{"lineBreak":true},{"text":"Dizlərim titrədi.","poem":1},{"lineBreak":true},{"text":"Amma bizə hücum edən xalqın","poem":1},{"lineBreak":true},{"text":"Fəlakətə düşdüyü günü səbirlə gözləyəcəyəm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Əncir ağacı tumurcuqlanmasa da,","poem":1},{"lineBreak":true},{"text":"Meynələr bar gətirməsə də,","poem":1},{"lineBreak":true},{"text":"Zeytun ağaclarına çəkdiyim zəhmət boşa çıxsa da,","poem":1},{"lineBreak":true},{"text":"Tarlalar məhsul yetişdirməsə də,","poem":1},{"lineBreak":true},{"text":"Qoyun-keçi ağıllarda,","poem":1},{"lineBreak":true},{"text":"Mal-qara tövlələrdə yox olsa da,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mən yenə Rəbdə sevinc tapacağam.","poem":1},{"lineBreak":true},{"text":"Xilasımın Allahı ilə şadlıqdan coşacağam!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xudavənd Rəbb mənim qüvvətimdir,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımı marallar kimi çevik edir,","poem":1},{"lineBreak":true},{"text":"Zirvələrimdə məni gəzdirir.","poem":1},{"lineBreak":true},{"text":"Musiqi rəhbəri üçün: simli alətlərin müşayiəti ilə.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Şiqqayonlar – fərz edilir ki, bu bir musiqi terminidir.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}