{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HAG","translationId":"azb_bsa","name":"HAQQAY","commonName":"HAQQAY","title":"HAQQAY PEYĞƏMBƏRİN KİTABI","order":37,"numberOfChapters":2,"sha256":"e22bfdc83d9869b519cb966cbf46a0802408e3fde5ede621a186abf5fa174fde","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HAG/1.json","lastChapterNumber":2,"lastChapterApiLink":"/api/azb_bsa/HAG/2.json","totalNumberOfVerses":38},"chapter":{"number":1,"content":[{"type":"heading","content":["Rəbb Yerusəlimdəki məbədinin bərpası haqqında əmr verir"]},{"type":"verse","number":1,"content":["Padşah Daranın hakimiyyətinin ikinci ili, altıncı ayın birində",{"noteId":0},"Yəhuda valisi Şealtiel oğlu Zerubbabilə və baş kahin Yehosadaq oğlu Yeşuaya peyğəmbər Haqqay vasitəsilə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":["«Ordular Rəbbi belə deyir: “Bu xalq deyir ki, hələ Rəbbin məbədini qurmaq vaxtı çatmayıb”»."]},{"type":"verse","number":3,"content":["Rəbbin bu sözü peyğəmbər Haqqay vasitəsilə nazil oldu:"]},{"type":"verse","number":4,"content":[{"text":"«Bu məbəd xaraba qaldığı halda","poem":1},{"lineBreak":true},{"text":"Sizin üçün damı yaraşıqlı evlərinizdə oturmaq vaxtıdırmı?»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İndi isə Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Həyat yollarınız haqqında yaxşı düşünün.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çox əkdiniz, amma az götürdünüz.","poem":1},{"lineBreak":true},{"text":"Yeyirsiniz, amma doymursunuz.","poem":1},{"lineBreak":true},{"text":"İçirsiniz, amma susuzluğunuz yatmır.","poem":1},{"lineBreak":true},{"text":"Geyinirsiniz, amma geyiminiz sizi isitmir.","poem":1},{"lineBreak":true},{"text":"Məvacibiniz cırıq kisəyə qoyulur».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Həyat yollarınız haqqında yaxşı düşünün.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İndi dağlara çıxıb ağac gətirin və məbədi qurun.","poem":1},{"lineBreak":true},{"text":"Onda razı qalaram, izzətlənərəm».","poem":1},{"lineBreak":true},{"text":"Bunu deyən Rəbdir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Çox şey gözlədiniz, budur, az oldu.","poem":1},{"lineBreak":true},{"text":"Az olanı da evə gətirəndə onları sovurdum.","poem":1},{"lineBreak":true},{"text":"Nə üçün? Xaraba qalan məbədimə görə.","poem":1},{"lineBreak":true},{"text":"Amma siz öz evləriniz üçün əlləşirsiniz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sizdən ötrü buna görə göylər şehini, yer də məhsulunu kəsdi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yerə, dağlara, taxıla, təzə şəraba, zeytun yağına,","poem":1},{"lineBreak":true},{"text":"Torpağın yetirdiyi nemətlərə,","poem":1},{"lineBreak":true},{"text":"Eləcə də insana, heyvana və əllərinizin bütün zəhmətinə","poem":1},{"lineBreak":true},{"text":"Mən quraqlıq elan etdim».","poem":1}]},{"type":"verse","number":12,"content":["Şealtiel oğlu Zerubbabil ilə baş kahin Yehosadaq oğlu Yeşua və xalqın sağ qalanları özlərinin Allahı Rəbbin dediklərinə – peyğəmbər Haqqayın sözünə baxdılar. Çünki onu onların Allahı Rəbb göndərmişdi. Xalq Rəbdən qorxdu."]},{"type":"verse","number":13,"content":["Rəbbin elçisi Haqqay Rəbbin müraciəti ilə xalqa belə dedi: «Rəbb deyir: “Mən sizinləyəm”»."]},{"type":"verse","number":14,"content":["Rəbb Yəhuda valisi Şealtiel oğlu Zerubbabili, baş kahin Yehosadaq oğlu Yeşuanı və xalqın sağ qalanlarını ruhlandırdı. Xalq yığılıb özlərinin Allahı olan Ordular Rəbbinin məbədində işləməyə başladı."]},{"type":"verse","number":15,"content":["Bu hadisə padşah Daranın hakimiyyətinin ikinci ili, altıncı ayın iyirmi dördündə baş verdi."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Miladdan əvvəl 29 avqust 520-ci il.","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/HAG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HAG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEP/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}