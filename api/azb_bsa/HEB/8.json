{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HEB","translationId":"azb_bsa","name":"İBRANİLƏRƏ","commonName":"İBRANİLƏRƏ","title":"İBRANİLƏRƏ MƏKTUB","order":58,"numberOfChapters":13,"sha256":"f129759a847d23fdee0b8fa44f9ae901b944fb1fa8f40754bf99e1201438153f","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/azb_bsa/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Deyilənlərin əsası isə budur: bizim elə bir Baş Kahinimiz var ki, göylərdəki möhtəşəm Allahın taxtının sağında oturub."]},{"type":"verse","number":2,"content":["O, Müqəddəs məkanda və insanın deyil, Rəbbin qurduğu həqiqi çadırda xidmət edir."]},{"type":"verse","number":3,"content":["Hər baş kahin təqdim və qurban gətirmək üçün təyin olunur. Buna görə bizim də Baş Kahinimizin təqdim etmək üçün nəyisə olmalıdır."]},{"type":"verse","number":4,"content":["Əgər Özü yer üzündə olsaydı, əsla Kahin olmazdı. Çünki Qanuna əsasən təqdim gətirənlər var."]},{"type":"verse","number":5,"content":["Onlar göylərdəkilərin təsviri və kölgəsi olan yerdə ibadət edir, necə ki Musa İbadət çadırını qurmaq üzrə olanda Allah onu xəbərdar etmişdi: «Dağda sənə göstərilən nümunəyə görə bunların hamısını ehtiyatla düzəlt»."]},{"type":"verse","number":6,"content":["Amma indi İsa daha yaxşı vədlər üzərində qurulmuş daha yaxşı bir Əhdin Vasitəçisi olduğu qədər üstün bir xidmətə nail oldu."]},{"type":"verse","number":7,"content":["Əgər ilk Əhd qüsursuz olsaydı, ikinci Əhdə səbəb axtarılmazdı."]},{"type":"verse","number":8,"content":["Çünki Allah Öz xalqını təqsirkar çıxararaq deyir:",{"text":"«Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“İsrail xalqı və Yəhuda xalqı ilə","poem":1},{"lineBreak":true},{"text":"Yeni bir Əhd bağlayacağım günlər yaxınlaşır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu Əhd","poem":1},{"lineBreak":true},{"text":"Atalarını Misir torpağından çıxartmaq üçün","poem":1},{"lineBreak":true},{"text":"Əllərindən tutduğum gün","poem":1},{"lineBreak":true},{"text":"Onlarla bağladığım əhdə bənzəməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki onlar əhdimə sadiq qalmadılar,","poem":1},{"lineBreak":true},{"text":"Mən də onlardan üz döndərdim”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“O günlərdən sonra","poem":1},{"lineBreak":true},{"text":"İsrail xalqı ilə","poem":1},{"lineBreak":true},{"text":"Bağlayacağım Əhd belədir”","poem":1},{"lineBreak":true},{"text":"Rəbb bəyan edir,","poem":1},{"lineBreak":true},{"text":"“Qanunlarımı onların zehinlərinə qoyub","poem":1},{"lineBreak":true},{"text":"Ürəklərinə yazacağam.","poem":1},{"lineBreak":true},{"text":"Mən onların Allahı,","poem":1},{"lineBreak":true},{"text":"Onlar da Mənim xalqım olacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bir kəs öz həmvətənini yaxud qardaşını","poem":1},{"lineBreak":true},{"text":"‹Rəbbi tanı› deyib öyrətməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki böyükdən kiçiyə qədər hamı Məni tanıyacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki təqsirlərinə qarşı mərhəmətli olacağam,","poem":1},{"lineBreak":true},{"text":"Günahlarını daha yada salmayacağam”».","poem":1}]},{"type":"verse","number":13,"content":["Allah «Yeni Əhd» deməklə birincisinin köhnə olduğunu göstərir. Köhnələn və yaşa dolansa çox keçmədən yox olur."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}