{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"İsrail bir qollu-budaqlı meynədir ki,","poem":1},{"lineBreak":true},{"text":"Bol-bol bar gətirir.","poem":1},{"lineBreak":true},{"text":"Ancaq barı artdıqca","poem":1},{"lineBreak":true},{"text":"Qurbangahları da artırdı.","poem":1},{"lineBreak":true},{"text":"Torpağı bərəkətli olduqca","poem":1},{"lineBreak":true},{"text":"Daha gözəl olan müqəddəs daşları da düzəltdi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onların ürəkləri yalanla doldu,","poem":1},{"lineBreak":true},{"text":"Günahlarına görə də cəzalanacaqlar.","poem":1},{"lineBreak":true},{"text":"Rəbb onların qurbangahlarını dağıdacaq,","poem":1},{"lineBreak":true},{"text":"Müqəddəs daşlarını sındıracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Onda onlar deyəcək:","poem":1},{"lineBreak":true},{"text":"«Bizim padşahımız yoxdur,","poem":1},{"lineBreak":true},{"text":"Çünki biz Rəbdən qorxmadıq.","poem":1},{"lineBreak":true},{"text":"Padşahımız olsa da,","poem":1},{"lineBreak":true},{"text":"Bizə nə edəcəkdi?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əhd bağlayanda boş vədlər verir,","poem":1},{"lineBreak":true},{"text":"Yalandan and içirlər.","poem":1},{"lineBreak":true},{"text":"Buna görə də məhkəmə işləri","poem":1},{"lineBreak":true},{"text":"Şumlanmış tarladakı zəhərli ot kimi böyüyür.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Samariya sakinləri","poem":1},{"lineBreak":true},{"text":"Bet-Avendəki dana bütlərinə görə","poem":1},{"lineBreak":true},{"text":"Qorxuya düşəcək.","poem":1},{"lineBreak":true},{"text":"Onun üçün xalqı yas tutacaq.","poem":1},{"lineBreak":true},{"text":"Onun calalı ilə coşan kahinləri","poem":1},{"lineBreak":true},{"text":"Sürgünə aparıldığı üçün ağlayacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Büt özü Aşşura – böyük padşaha","poem":1},{"lineBreak":true},{"text":"Hədiyyə aparılacaq.","poem":1},{"lineBreak":true},{"text":"Efrayim biabır olacaq,","poem":1},{"lineBreak":true},{"text":"İsrail aldığı məsləhətdən utanacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Samariya və onun padşahı","poem":1},{"lineBreak":true},{"text":"Su üstündəki çubuq kimi","poem":1},{"lineBreak":true},{"text":"Axıb-gedəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsrailin günahı olan","poem":1},{"lineBreak":true},{"text":"Avendəki","poem":1},{"noteId":8},{"text":"səcdəgahlar yox olacaq,","poem":1},{"lineBreak":true},{"text":"Onun qurbangahlarında","poem":1},{"lineBreak":true},{"text":"Tikan və qanqal bitəcək.","poem":1},{"lineBreak":true},{"text":"O zaman dağlara «Bizi örtün!»,","poem":1},{"lineBreak":true},{"text":"Təpələrə «Üstümüzə yıxılın!» deyəcəklər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«İsrail Giveada keçirdiyi","poem":1},{"lineBreak":true},{"text":"Günlərdən bəri günah etdi.","poem":1},{"lineBreak":true},{"text":"Orada öz işlərini davam etdirdilər.","poem":1},{"lineBreak":true},{"text":"Şər adamlara qarşı müharibə","poem":1},{"lineBreak":true},{"text":"Onları Giveada yaxalamazmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən istədiyim zaman","poem":1},{"lineBreak":true},{"text":"Onları cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"Xalqlar onlara qarşı birləşib,","poem":1},{"lineBreak":true},{"text":"İkiqat cinayətlərindən ötrü","poem":1},{"lineBreak":true},{"text":"Onları əsir edəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayim əhliləşmiş,","poem":1},{"lineBreak":true},{"text":"Taxıl döyməyi sevən düyəyə bənzər.","poem":1},{"lineBreak":true},{"text":"Mən onun incə boynunu əsirgədim.","poem":1},{"lineBreak":true},{"text":"İndi isə Efrayimi sürdürəcəyəm.","poem":1},{"lineBreak":true},{"text":"Yəhuda yer şumlasın,","poem":1},{"lineBreak":true},{"text":"Yaqub isə dırmıq çəksin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Özünüz üçün salehlik əkin,","poem":1},{"lineBreak":true},{"text":"Məhəbbət bəhərini biçərsiniz.","poem":1},{"lineBreak":true},{"text":"Dincə qoyulmuş torpağınızı şumlayın,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbi axtarmaq vaxtıdır.","poem":1},{"lineBreak":true},{"text":"Nəhayət, O gəlib üstünüzə","poem":1},{"lineBreak":true},{"text":"Salehliyin nemətlərini yağdıracaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amma siz pislik əkib,","poem":1},{"lineBreak":true},{"text":"Qəbahət biçdiniz.","poem":1},{"lineBreak":true},{"text":"Yalanın bəhərini yediniz.","poem":1},{"lineBreak":true},{"text":"Çünki öz üsulunuza,","poem":1},{"lineBreak":true},{"text":"Çoxlu cəngavərlərinizə güvəndiniz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xalqınızın içində müharibə gurultusu qopacaq,","poem":1},{"lineBreak":true},{"text":"Bütün qalalarınız dağılacaq,","poem":1},{"lineBreak":true},{"text":"Necə ki Şalman müharibə günündə","poem":1},{"lineBreak":true},{"text":"Bet-Arbeli dağıtdı,","poem":1},{"lineBreak":true},{"text":"Ana uşaqları ilə birgə yerə çırpılıb parçalandı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ey Bet-El, pisliyinin çoxluğu üzündən","poem":1},{"lineBreak":true},{"text":"Səninlə də belə rəftar ediləcək.","poem":1},{"lineBreak":true},{"text":"Dan ağaranda İsrail padşahı həlak olacaq.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Aven – burada Bet-El, Allahın evi şəhəri pislik mənası verən bu sözlə adlandırılır.","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/azb_bsa/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}