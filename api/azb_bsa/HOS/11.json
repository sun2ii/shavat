{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Allahın İsrailə məhəbbəti"]},{"type":"verse","number":1,"content":[{"text":"İsrail uşaq ikən onu sevdim,","poem":1},{"lineBreak":true},{"text":"Öz oğlumu Misirdən çağırdım.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Peyğəmbərlər İsraili çağırdıqca","poem":1},{"lineBreak":true},{"text":"İsrail onlardan uzaqlaşdı.","poem":1},{"lineBreak":true},{"text":"Baal bütlərinə qurban kəsdilər,","poem":1},{"lineBreak":true},{"text":"Oyma bütlərə buxur yandırdılar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efrayimə gəzməyi Mən öyrətdim,","poem":1},{"lineBreak":true},{"text":"Onları qollarım üstünə aldım.","poem":1},{"lineBreak":true},{"text":"Ancaq bilmədilər ki,","poem":1},{"lineBreak":true},{"text":"Onlara Mən şəfa verdim.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onları insani tellərlə,","poem":1},{"lineBreak":true},{"text":"Sevgi bağları ilə Özümə çəkdim.","poem":1},{"lineBreak":true},{"text":"Onlar üçün çənələrindən boyunduruğu qaldıran","poem":1},{"lineBreak":true},{"text":"Bir kəs oldum,","poem":1},{"lineBreak":true},{"text":"Əyilib onlara yemək verdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Məgər Misirə qayıtmayacaqlar?","poem":1},{"lineBreak":true},{"text":"Aşşur onlara padşah olmayacaq?","poem":1},{"lineBreak":true},{"text":"Çünki onlar Mənə üz tutmaq istəmədilər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Şəhərlərinin içində qılınc fırlanacaq,","poem":1},{"lineBreak":true},{"text":"Onların qapı sürgülərini qıracaq.","poem":1},{"lineBreak":true},{"text":"Fitnələri üzündən onları yeyib-qurtaracaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xalqım Məndən üz döndərməyi qərara alıb.","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanı çağırsalar da,","poem":1},{"lineBreak":true},{"text":"Onları heç vaxt ucaltmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey Efrayim, səni necə əldən verim?","poem":1},{"lineBreak":true},{"text":"Ey İsrail, səni necə təslim edim?","poem":1},{"lineBreak":true},{"text":"Admaya etdiyimi sənə necə edim?","poem":1},{"lineBreak":true},{"text":"Səni necə Sevoyim kimi edim?","poem":1},{"lineBreak":true},{"text":"Köksümdə ürəyim alt-üst oldu,","poem":1},{"lineBreak":true},{"text":"Mərhəmət hisslərim alovlandı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mən qızğın qəzəbimlə rəftar etmərəm,","poem":1},{"lineBreak":true},{"text":"Efrayimi artıq məhv etmərəm.","poem":1},{"lineBreak":true},{"text":"Çünki Mən Allaham, insan deyiləm,","poem":1},{"lineBreak":true},{"text":"Aranızda Müqəddəs Olanam.","poem":1},{"lineBreak":true},{"text":"Qəzəblə üzərinizə gəlmərəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar aslan kimi nərə çəkən","poem":1},{"lineBreak":true},{"text":"Rəbbin arxasınca gedəcək.","poem":1},{"lineBreak":true},{"text":"O nərə çəkəndə","poem":1},{"lineBreak":true},{"text":"Övladları qərbdən titrəyərək gələcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Misirdən quşlar kimi,","poem":1},{"lineBreak":true},{"text":"Aşşur ölkəsindən göyərçinlər kimi","poem":1},{"lineBreak":true},{"text":"Titrəyərək gələcəklər.","poem":1},{"lineBreak":true},{"text":"Onları evlərində sakin edəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"heading","content":["İsrailin günahı"]},{"type":"verse","number":12,"content":[{"text":"Efrayim yalanla, İsrail nəsli hiylə ilə","poem":1},{"lineBreak":true},{"text":"Ətrafımı bürüdü.","poem":1},{"lineBreak":true},{"text":"Amma Yəhuda hələ də Allahla birgə gedir,","poem":1},{"lineBreak":true},{"text":"Müqəddəs Olana sadiqdir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}