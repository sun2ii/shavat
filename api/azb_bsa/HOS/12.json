{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efrayim yellə bəslənir,","poem":1},{"lineBreak":true},{"text":"Bütün gün şərq küləyinin dalınca düşür.","poem":1},{"lineBreak":true},{"text":"Yalanı, qoluzorluluğu artırır.","poem":1},{"lineBreak":true},{"text":"Aşşurla saziş bağlayır,","poem":1},{"lineBreak":true},{"text":"Misirə zeytun yağı göndərir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yəhuda ilə Rəbbin davası var,","poem":1},{"lineBreak":true},{"text":"Yaqubu getdiyi yola görə cəzalandıracaq,","poem":1},{"lineBreak":true},{"text":"Əməllərinə görə əvəz verəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O hələ ana bətnində ikən","poem":1},{"lineBreak":true},{"text":"Qardaşının topuğundan tutdu,","poem":1},{"lineBreak":true},{"text":"Böyüklük çağında Allahla güləşdi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mələklə güləşib ona üstün gəldi,","poem":1},{"lineBreak":true},{"text":"Ağlayaraq Ondan xeyirxahlıq istədi.","poem":1},{"lineBreak":true},{"text":"Allah onu Bet-Eldə tapdı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ordular Allahı Rəbb","poem":1},{"lineBreak":true},{"text":"Bizimlə orada danışdı.","poem":1},{"lineBreak":true},{"text":"Onun adı «Rəbb»dir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna görə də sən Allahına üz tut,","poem":1},{"lineBreak":true},{"text":"Məhəbbətə, ədalətə bağlan,","poem":1},{"lineBreak":true},{"text":"Daim Allahına ümid bağla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Efrayim tacirdir,","poem":1},{"lineBreak":true},{"text":"Əlindəki aldadıcı tərəzi ilə","poem":1},{"lineBreak":true},{"text":"Aldatmağı sevir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Efrayim deyir:","poem":1},{"lineBreak":true},{"text":"«Doğrudan da, mən varlandım,","poem":1},{"lineBreak":true},{"text":"Özüm üçün sərvət topladım.","poem":1},{"lineBreak":true},{"text":"Çoxlu şeylər qazansam da,","poem":1},{"lineBreak":true},{"text":"Məndə günah sayılacaq bir təqsir tapılmayacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ancaq səni Misir torpağından çıxaran","poem":1},{"lineBreak":true},{"text":"Allahın Rəbb Mənəm.","poem":1},{"lineBreak":true},{"text":"Bayram günlərində olduğu kimi","poem":1},{"lineBreak":true},{"text":"Səni yenə öz çadırlarında məskunlaşdıracağam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən peyğəmbərlərlə danışdım,","poem":1},{"lineBreak":true},{"text":"Çoxlu görüntü göndərdim,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərin dilindən məsəllər söylədim».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gilead xalqı pis xalqdır,","poem":1},{"lineBreak":true},{"text":"Doğrudan da, yaramazdır.","poem":1},{"lineBreak":true},{"text":"Qilqalda buğaları qurban kəsirlər.","poem":1},{"lineBreak":true},{"text":"Onların qurbangahları","poem":1},{"lineBreak":true},{"text":"Şumlanmış tarladakı daş qalaqları kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaqub Aram torpağına qaçdı,","poem":1},{"lineBreak":true},{"text":"İsrail arvad üçün qul oldu,","poem":1},{"lineBreak":true},{"text":"Arvada görə qoyun otardı.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb İsraili bir peyğəmbər vasitəsilə","poem":1},{"lineBreak":true},{"text":"Misirdən çıxartdı,","poem":1},{"lineBreak":true},{"text":"Bir peyğəmbər vasitəsilə qorudu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Efrayim Allahı bərk qəzəbləndirdi,","poem":1},{"lineBreak":true},{"text":"Tökdüyü qanı öz başına gətirəcək,","poem":1},{"lineBreak":true},{"text":"Xudavənd onun rüsvayçılığını özünə qaytaracaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}