{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Rəbbin İsrailə qəzəbi"]},{"type":"verse","number":1,"content":[{"text":"Efrayim danışanda hamı titrəyirdi.","poem":1},{"lineBreak":true},{"text":"İsraildə ucalmışdı,","poem":1},{"lineBreak":true},{"text":"Amma Baala tapınıb təqsir edəndə məhv oldu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İndi günah üstünə günah edirlər,","poem":1},{"lineBreak":true},{"text":"Gümüşlərindən özlərinə tökmə bütlər,","poem":1},{"lineBreak":true},{"text":"Məharətlə düşünülmüş bütlər düzəldirlər.","poem":1},{"lineBreak":true},{"text":"Hamısı usta işidir.","poem":1},{"lineBreak":true},{"text":"«Qurban gətirən adamlar","poem":1},{"lineBreak":true},{"text":"Danaları öpsün!» deyirlər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buna görə də səhər dumanı,","poem":1},{"lineBreak":true},{"text":"Erkən uçub gedən şeh,","poem":1},{"lineBreak":true},{"text":"Xırmanda sovrulan saman çöpü,","poem":1},{"lineBreak":true},{"text":"Bacadan çıxan tüstü kimi olacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ancaq Səni Misir torpağından çıxaran","poem":1},{"lineBreak":true},{"text":"Allahın Rəbb Mənəm.","poem":1},{"lineBreak":true},{"text":"Sən Məndən başqa allah tanımamalısan,","poem":1},{"lineBreak":true},{"text":"Çünki Məndən başqa xilaskar yoxdur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən sənə çöldə, quraq torpaqlarda göz-qulaq oldum.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onları bəslədiyimə görə doydular,","poem":1},{"lineBreak":true},{"text":"Doyandan sonra onların ürəyi qürurlandı,","poem":1},{"lineBreak":true},{"text":"Buna görə də Məni unutdular.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən onlara bir aslan olacağam,","poem":1},{"lineBreak":true},{"text":"Bəbir kimi yol kənarında","poem":1},{"lineBreak":true},{"text":"Pusquda duracağam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Balalarından məhrum olmuş ayı kimi","poem":1},{"lineBreak":true},{"text":"Onlara hücum çəkəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ürəklərinin pərdəsini yırtacağam.","poem":1},{"lineBreak":true},{"text":"Dişi aslan kimi onları yeyib-qurtaracağam,","poem":1},{"lineBreak":true},{"text":"Vəhşi canavar onları parçalayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey İsrail, Mənə – Köməkçinə qarşı çıxmağın","poem":1},{"lineBreak":true},{"text":"Səni ölümə aparır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İndi padşahın haradadır ki,","poem":1},{"lineBreak":true},{"text":"Bütün şəhərlərində səni xilas etsin?","poem":1},{"lineBreak":true},{"text":"Hakimlərin haradadır?","poem":1},{"lineBreak":true},{"text":"Sən ki onlar barədə","poem":1},{"lineBreak":true},{"text":"“Mənə bir padşah və başçılar ver” deyirdin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qəzəb içində sənə padşah verdim,","poem":1},{"lineBreak":true},{"text":"Hiddətlənəndə onu apardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Efrayimin qəbahəti yığılıb,","poem":1},{"lineBreak":true},{"text":"Günahı qeydə alınıb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Doğan qadının ağrıları ona çatır,","poem":1},{"lineBreak":true},{"text":"Amma o, ağılsız oğuldur.","poem":1},{"lineBreak":true},{"text":"Çünki vaxtı çatanda","poem":1},{"lineBreak":true},{"text":"Bətndən çıxmağa ləngiyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mən onları ölülər diyarının","poem":1},{"lineBreak":true},{"text":"Əlindən satın alacağam,","poem":1},{"lineBreak":true},{"text":"Onları ölümdən xilas edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ey ölüm, bəlaların hanı?","poem":1},{"lineBreak":true},{"text":"Ey ölülər diyarı, həlakın hanı?","poem":1},{"lineBreak":true},{"text":"Gözümdə mərhəmət görünməyəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Efrayim öz qardaşları arasında","poem":1},{"lineBreak":true},{"text":"Barlı-bəhərli olsa da,","poem":1},{"lineBreak":true},{"text":"Şərq yeli, səhradan qalxan","poem":1},{"lineBreak":true},{"text":"Rəbbin küləyi gələcək,","poem":1},{"lineBreak":true},{"text":"Onun bulağı quruyacaq,","poem":1},{"lineBreak":true},{"text":"Çeşməsinin suyu kəsiləcək.","poem":1},{"lineBreak":true},{"text":"Bütün qiymətli şeylər xəzinəsi qarət olunacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Samariya günahının cəzasını çəkəcək,","poem":1},{"lineBreak":true},{"text":"Çünki Allahına qarşı üsyankar oldu.","poem":1},{"lineBreak":true},{"text":"Onlar qılıncdan həlak olacaq.","poem":1},{"lineBreak":true},{"text":"Balaları yerə çırpılıb parçalanacaq,","poem":1},{"lineBreak":true},{"text":"Hamilə qadınlarının qarnı yarılacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}