{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Rəbbin İsrailə müraciəti"]},{"type":"verse","number":1,"content":[{"text":"Allahın Rəbbə üz tut, ey İsrail,","poem":1},{"lineBreak":true},{"text":"Çünki günahlarından ötrü büdrədin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dua sözləri ilə Rəbbə tərəf dönün.","poem":1},{"lineBreak":true},{"text":"Ona belə deyin:","poem":1},{"lineBreak":true},{"text":"«Hər qəbahətimizi bağışla,","poem":1},{"lineBreak":true},{"text":"Bizi mərhəmətlə qəbul et.","poem":1},{"lineBreak":true},{"text":"Buğalar yerinə ağzımızdan çıxan","poem":1},{"lineBreak":true},{"text":"Şükürləri təqdim edirik.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aşşur bizi xilas etməyəcək,","poem":1},{"lineBreak":true},{"text":"Atların belinə minməyəcəyik,","poem":1},{"lineBreak":true},{"text":"Artıq əl işlərimizə","poem":1},{"lineBreak":true},{"text":"“Allahlarımız” deməyəcəyik.","poem":1},{"lineBreak":true},{"text":"Çünki yetim Səndən mərhəmət görəcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Onların dönüklüyünə əlac edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onları ürəkdən sevəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki qəzəbim onlardan vaz keçdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən İsrailə bir şeh olacağam,","poem":1},{"lineBreak":true},{"text":"O, zanbaq kimi çiçək açacaq,","poem":1},{"lineBreak":true},{"text":"Livan sidri kimi kök atacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qollu-budaqlı olacaq,","poem":1},{"lineBreak":true},{"text":"Zeytun ağacı kimi gözəl olacaq,","poem":1},{"lineBreak":true},{"text":"Livan sidri kimi ətir saçacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adamlar yenə də kölgəsi altında oturub","poem":1},{"lineBreak":true},{"text":"Buğda kimi cücərəcək,","poem":1},{"lineBreak":true},{"text":"Meynə kimi tumurcuqlayacaq,","poem":1},{"lineBreak":true},{"text":"Şöhrəti Livan şərabı kimi olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Efrayim deyəcək:","poem":1},{"lineBreak":true},{"text":"“Artıq bütlər nəyimə gərəkdir?”","poem":1},{"lineBreak":true},{"text":"Mən onun səsini eşidəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ona nəzər salacağam.","poem":1},{"lineBreak":true},{"text":"Mən həmişəyaşıl şam kimiyəm,","poem":1},{"lineBreak":true},{"text":"Sənin bar verməyin Məndən gələcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kim müdrikdirsə, bu sözləri dərk etsin,","poem":1},{"lineBreak":true},{"text":"Kim dərrakəlidirsə, bunları başa düşsün.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin yolları düzdür.","poem":1},{"lineBreak":true},{"text":"Salehlər o yollarla gedir,","poem":1},{"lineBreak":true},{"text":"Ancaq üsyankarlar o yollarda büdrəyir».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}