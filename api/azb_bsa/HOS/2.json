{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Qardaşlarınızı “xalqım”, bacılarınızı isə “mərhəmət tapmış” deyə çağırın."]},{"type":"heading","content":["İsrailin xəyanəti"]},{"type":"verse","number":2,"content":[{"text":"Qınayın siz ananızı, qınayın,","poem":1},{"lineBreak":true},{"text":"Çünki o Mənim arvadım deyil,","poem":1},{"lineBreak":true},{"text":"Mən də onun əri deyiləm.","poem":1},{"lineBreak":true},{"text":"Qoy üzündə görünən fahişəliyi,","poem":1},{"lineBreak":true},{"text":"Qoynunda olan xəyanəti atsın.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yoxsa onu çıl-çılpaq soyundurub","poem":1},{"lineBreak":true},{"text":"Lüt, anadangəlmə edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Mən onu səhra, quru torpaq kimi edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Susuzluqdan öldürəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onun balalarına da rəhm etməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki onlar da xəyanət övladıdır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onların anası zina etdi.","poem":1},{"lineBreak":true},{"text":"Onlara hamilə qalan qadın rəzillik etdi,","poem":1},{"lineBreak":true},{"text":"Çünki dedi: “Oynaşlarımın dalınca gedəcəyəm,","poem":1},{"lineBreak":true},{"text":"Axı çörəyimi, suyumu, yunumu, kətanımı,","poem":1},{"lineBreak":true},{"text":"Zeytun yağımı və içkimi verən onlardır”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Buna görə də onun yolunu qanqallarla kəsib","poem":1},{"lineBreak":true},{"text":"Önünə hasar çəkəcəyəm.","poem":1},{"lineBreak":true},{"text":"Öz yolunu tapa bilməyəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oynaşlarının dalınca gedəcək,","poem":1},{"lineBreak":true},{"text":"Ancaq onlara çatmayacaq.","poem":1},{"lineBreak":true},{"text":"Onları axtaracaq,","poem":1},{"lineBreak":true},{"text":"Ancaq tapmayacaq.","poem":1},{"lineBreak":true},{"text":"O zaman deyəcək:","poem":1},{"lineBreak":true},{"text":"“Qoy öz əvvəlki ərimin yanına qayıdım,","poem":1},{"lineBreak":true},{"text":"Çünki o vaxt halım indikindən yaxşı idi”.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amma o bilmirdi ki,","poem":1},{"lineBreak":true},{"text":"Ona taxılı, təzə şərabı,","poem":1},{"lineBreak":true},{"text":"Zeytun yağını verən Mənəm.","poem":1},{"lineBreak":true},{"text":"Baal bütü üçün sərf etdikləri","poem":1},{"lineBreak":true},{"text":"Qızıl-gümüşü çoxaldan Mənəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buna görə də öz vaxtında taxılımı,","poem":1},{"lineBreak":true},{"text":"Öz mövsümündə təzə şərabımı geri alacağam.","poem":1},{"lineBreak":true},{"text":"Onun çılpaqlığını örtmək üçün verdiyim","poem":1},{"lineBreak":true},{"text":"Yunu və kətanı əlindən alacağam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İndi oynaşlarının önündə","poem":1},{"lineBreak":true},{"text":"Onun ayıbını üzə çıxaracağam.","poem":1},{"lineBreak":true},{"text":"Kimsə onu əlimdən qurtara bilməyəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onda olan bütün şadlıqlara,","poem":1},{"lineBreak":true},{"text":"Bayramlara, Təzə Ay mərasimlərinə,","poem":1},{"lineBreak":true},{"text":"Şənbə günlərinə və bütün təntənələrə son qoyacağam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onun meynələrini və əncir ağaclarını məhv edəcəyəm.","poem":1},{"lineBreak":true},{"text":"O bunlar barədə deyirdi:","poem":1},{"lineBreak":true},{"text":"“Bu, oynaşlarımın mənə verdiyi muzddur”.","poem":1},{"lineBreak":true},{"text":"Bağlarını tikanlığa çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çöl heyvanlarına yem olacaqlar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Baal bütlərinə buxur yandırdığı günlər üçün","poem":1},{"lineBreak":true},{"text":"Onu cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"O vaxt halqalar və cəvahiratla özünü bəzəyərək","poem":1},{"lineBreak":true},{"text":"Oynaşlarının dalınca getmiş,","poem":1},{"lineBreak":true},{"text":"Məni isə unutmuşdu»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Amma Mən onu dilə tutub","poem":1},{"lineBreak":true},{"text":"Səhraya aparacağam,","poem":1},{"lineBreak":true},{"text":"Onun ürəyincə olan sözlər deyəcəyəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Orada ona üzüm bağları verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Akor","poem":1},{"noteId":3},{"text":"vadisini ümid qapısına çevirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Cavanlıq günlərində olduğu kimi,","poem":1},{"lineBreak":true},{"text":"Misir torpağından çıxdığı gün kimi","poem":1},{"lineBreak":true},{"text":"Orada nəğmə oxuyacaq».","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: «Həmin gün","poem":1},{"lineBreak":true},{"text":"Mənə “ərim” deyəcəksən,","poem":1},{"lineBreak":true},{"text":"Artıq “ağam”","poem":1},{"noteId":4},{"text":"deməyəcəksən.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Baal bütlərinin adını dilindən siləcəyəm,","poem":1},{"lineBreak":true},{"text":"Onların adı bir də yada salınmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O gün sənin asayişin üçün","poem":1},{"lineBreak":true},{"text":"Çöl heyvanları, göy quşları və","poem":1},{"lineBreak":true},{"text":"Yerdə sürünənlərlə əhd kəsəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ölkədən kamanı, qılıncı,","poem":1},{"lineBreak":true},{"text":"Müharibəni götürəcək,","poem":1},{"lineBreak":true},{"text":"Səni əmin-amanlıqda yatıracağam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Səni əbədi olaraq Özümə nişanlayacağam,","poem":1},{"lineBreak":true},{"text":"Salehlik, ədalət, məhəbbət və mərhəmətlə","poem":1},{"lineBreak":true},{"text":"Səni özümə nişanlayacağam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Səni sədaqətlə Özümə nişanlayacağam,","poem":1},{"lineBreak":true},{"text":"Sən də Rəbbi tanıyacaqsan».","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rəbb bəyan edir: «O gün hay verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Göylərə hay verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar da yerə hay verəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yer isə taxıla, təzə şəraba və","poem":1},{"lineBreak":true},{"text":"Zeytun yağına hay verəcək,","poem":1},{"lineBreak":true},{"text":"Onlar da İzreelə hay verəcək.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xalqımı ölkədə Özüm üçün əkəcəyəm,","poem":1},{"lineBreak":true},{"text":"“Mərhəmət tapmamış” dediyimə","poem":1},{"lineBreak":true},{"text":"Mərhəmət edəcəyəm.","poem":1},{"lineBreak":true},{"text":"“Xalqım deyil” dediyimə","poem":1},{"lineBreak":true},{"text":"“Xalqımsan” deyəcəyəm.","poem":1},{"lineBreak":true},{"text":"O isə Mənə “Allahımsan” deyəcək».","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Akor – ibrani dilində əziyyət.","reference":{"chapter":2,"verse":15}},{"noteId":4,"caller":"+","text":"Ağam – ibrani mətnində Baali sözü olub mənim Baalım deməkdir.","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/azb_bsa/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}