{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Rəbbin İsraili məzəmmət etməsi"]},{"type":"verse","number":1,"content":[{"text":"«Ey İsrail övladları, Rəbbin sözünü eşidin,","poem":1},{"lineBreak":true},{"text":"Çünki bu ölkədə yaşayanları","poem":1},{"lineBreak":true},{"text":"Rəbb ittiham edir.","poem":1},{"lineBreak":true},{"text":"Sədaqət, məhəbbət, Allahı tanımaq","poem":1},{"lineBreak":true},{"text":"Bu yerdə yox olub.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lənət, yalan, qətl, oğurluq və zina","poem":1},{"lineBreak":true},{"text":"Hər yerə yayılıb.","poem":1},{"lineBreak":true},{"text":"Qoluzorluluq edərək","poem":1},{"lineBreak":true},{"text":"Qan üstünə qan tökürlər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bundan ötrü ölkə yas tutur,","poem":1},{"lineBreak":true},{"text":"Orada yaşayan hər kəs bezib.","poem":1},{"lineBreak":true},{"text":"Həmçinin çöl heyvanları, göy quşları,","poem":1},{"lineBreak":true},{"text":"Hətta dənizdəki balıqlar da məhv olur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ancaq heç kəs dava etməsin,","poem":1},{"lineBreak":true},{"text":"Heç kəs başqasını təqsirləndirməsin,","poem":1},{"lineBreak":true},{"text":"Çünki Mənim davam səninlədir, ey kahin.","poem":1},{"noteId":5}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sən gündüz büdrəyəcəksən,","poem":1},{"lineBreak":true},{"text":"Peyğəmbər də gecə səninlə birgə.","poem":1},{"lineBreak":true},{"text":"Sənin ananı","poem":1},{"noteId":6},{"text":"məhv edəcəyəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xalqım biliksizlikdən məhv oldu.","poem":1},{"lineBreak":true},{"text":"Sən biliyi rədd etdiyin üçün","poem":1},{"lineBreak":true},{"text":"Mən də səni rədd edəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Bir daha Mənə kahinlik etməyəsən.","poem":1},{"lineBreak":true},{"text":"İndi ki öz Allahının qanununu unutdun,","poem":1},{"lineBreak":true},{"text":"Mən də sənin balalarını unudacağam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kahinlər nə qədər çoxaldısa,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı o qədər çox günah etdi.","poem":1},{"lineBreak":true},{"text":"Onların izzətini rüsvayçılığa çevirəcəyəm.","poem":1},{"noteId":7}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xalqımın günahı ilə bəslənirlər,","poem":1},{"lineBreak":true},{"text":"Onların qəbahətinə can atırlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xalqın başına gələn","poem":1},{"lineBreak":true},{"text":"Kahinin də başına gələcək.","poem":1},{"lineBreak":true},{"text":"Tutduqları yol üçün onları cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"Əməllərinin əvəzini onlara ödəyəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yeyəcəklər, amma doymayacaqlar,","poem":1},{"lineBreak":true},{"text":"Fahişəlik edəcəklər, amma çoxalmayacaqlar,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Rəbbi tərk edib","poem":1},{"lineBreak":true},{"text":"Başqa allahlara könül verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zina, köhnə və təzə şərab","poem":1},{"lineBreak":true},{"text":"Onların ürəklərini cəlb edib.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xalqım ağacdan olan əşyaya sual verir,","poem":1},{"lineBreak":true},{"text":"Əsalarından cavab alır,","poem":1},{"lineBreak":true},{"text":"Çünki xəyanət ruhu onları azdırdı.","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahından ayrılıb xəyanət etdilər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dağların başında qurban kəsirlər,","poem":1},{"lineBreak":true},{"text":"Təpələrdə palıd, ağcaqovaq və yabanı püstə ağacı altında","poem":1},{"lineBreak":true},{"text":"Kölgələri gözəl olduğu üçün buxur yandırırlar.","poem":1},{"lineBreak":true},{"text":"Buna görə də qızlarınız fahişəlik edir,","poem":1},{"lineBreak":true},{"text":"Gəlinləriniz də zinakardır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fahişəlik edən qızlarınızı,","poem":1},{"lineBreak":true},{"text":"Zina edən gəlinlərinizi cəzalandırmayacağam.","poem":1},{"lineBreak":true},{"text":"Çünki kişiləriniz fahişələrlə oynaşır,","poem":1},{"lineBreak":true},{"text":"Məbəd fahişələri ilə birgə qurban kəsir.","poem":1},{"lineBreak":true},{"text":"Dərrakəsiz xalq məhv olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ey İsrail, sən xəyanət etsən də,","poem":1},{"lineBreak":true},{"text":"Heç olmasa Yəhuda təqsirkar olmasın.","poem":1},{"lineBreak":true},{"text":"Qilqala getməyin,","poem":1},{"lineBreak":true},{"text":"Bet-Avenə çıxmayın.","poem":1},{"lineBreak":true},{"text":"“Var olan Rəbbin haqqı üçün”","poem":1},{"lineBreak":true},{"text":"Deyib and içməyin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bəli, İsrail inadkar bir düyə kimi inad etdi.","poem":1},{"lineBreak":true},{"text":"İndi Rəbb onları","poem":1},{"lineBreak":true},{"text":"Otlaqda quzu otaran kimi necə otarsın?","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Efrayim bütlərindən yapışdı,","poem":1},{"lineBreak":true},{"text":"Burax onu!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onlar içkiləri qurtarandan sonra","poem":1},{"lineBreak":true},{"text":"Hələ pozğunluq da edir.","poem":1},{"lineBreak":true},{"text":"Onların başçıları rüsvayçılığı çox sevir.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Külək onları qanadları ilə sarıyacaq,","poem":1},{"lineBreak":true},{"text":"Qurbanlarından ötrü utanacaqlar.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Mənim davam səninlədir, ey kahin – yaxud xalqın kahinlə çəkişənlərə bənzəyir.","reference":{"chapter":4,"verse":4}},{"noteId":6,"caller":"+","text":"Sənin anan – İsrail xalqı nəzərdə tutulur.","reference":{"chapter":4,"verse":5}},{"noteId":7,"caller":"+","text":"Onların izzətini rüsvayçılığa çevirəcəyəm – əksər ibrani əlyazmalarında Mənim izzətimi rüsvayçılığa çevirdilər.","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/azb_bsa/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}