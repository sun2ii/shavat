{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["İsrailin cəzası"]},{"type":"verse","number":1,"content":[{"text":"Ey kahinlər, bunu eşidin!","poem":1},{"lineBreak":true},{"text":"Ey İsrail nəsli, diqqətlə dinləyin!","poem":1},{"lineBreak":true},{"text":"Ey padşah sarayında olanlar, qulaq verin!","poem":1},{"lineBreak":true},{"text":"Sizin barənizdə hökm çıxarıldı,","poem":1},{"lineBreak":true},{"text":"Çünki siz Mispada bir tələ,","poem":1},{"lineBreak":true},{"text":"Tavor dağına sərilmiş bir tor oldunuz.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qanunsuzlar adam öldürməklə məşğuldur.","poem":1},{"lineBreak":true},{"text":"Amma Mən onların hamısını cəzalandıracağam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efrayimi tanıyıram,","poem":1},{"lineBreak":true},{"text":"İsrail Məndən gizli deyil,","poem":1},{"lineBreak":true},{"text":"Çünki indi sən fahişəlik edirsən, ey Efrayim,","poem":1},{"lineBreak":true},{"text":"İsrail də murdarlanıb.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əməlləri qoymur ki, onlar","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahına tərəf dönsün,","poem":1},{"lineBreak":true},{"text":"Çünki içlərində xəyanət ruhu var,","poem":1},{"lineBreak":true},{"text":"Rəbbi də tanımırlar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İsrailin qüruru özünə qarşı şəhadət edir.","poem":1},{"lineBreak":true},{"text":"İsraillə Efrayim","poem":1},{"lineBreak":true},{"text":"Günahlarından ötrü büdrəyib-yıxılır.","poem":1},{"lineBreak":true},{"text":"Yəhuda da onlarla birgə yıxılır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qoyun-keçi, mal-qara qurban edərək","poem":1},{"lineBreak":true},{"text":"Rəbbi axtarmağa gedəcəklər,","poem":1},{"lineBreak":true},{"text":"Amma tapmayacaqlar,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb onları tərk etdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onlar Rəbbə xəyanət etdi,","poem":1},{"lineBreak":true},{"text":"Çünki bic uşaqlar doğdu.","poem":1},{"lineBreak":true},{"text":"İndi Təzə Ay mərasimi olanda","poem":1},{"lineBreak":true},{"text":"Onlar tarlaları ilə birlikdə məhv olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Giveada şeypur çalın,","poem":1},{"lineBreak":true},{"text":"Ramada kərənay çalın,","poem":1},{"lineBreak":true},{"text":"Bet-Avendə car çəkin,","poem":1},{"lineBreak":true},{"text":"Düşmən arxandadır, ey Binyamin!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efrayim cəza günündə viran olacaq,","poem":1},{"lineBreak":true},{"text":"Bu yəqin sözü İsrail qəbilələri arasında bəyan edirəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yəhuda başçıları","poem":1},{"lineBreak":true},{"text":"Sərhəd daşı dəyişənlərə bənzəyir.","poem":1},{"lineBreak":true},{"text":"Qəzəbimi sel kimi onların üstünə tökəcəyəm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayim zülm gördü,","poem":1},{"lineBreak":true},{"text":"Hökm ilə əzildi,","poem":1},{"lineBreak":true},{"text":"Çünki bilə-bilə","poem":1},{"lineBreak":true},{"text":"Boş şeylərin dalınca getdi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mən Efrayimlilərə qarşı güvə,","poem":1},{"lineBreak":true},{"text":"Yəhuda nəsli üçün kif olacağam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Efrayim xəstəliyini,","poem":1},{"lineBreak":true},{"text":"Yəhuda yarasını gördü.","poem":1},{"lineBreak":true},{"text":"Efrayim Aşşura getdi,","poem":1},{"lineBreak":true},{"text":"Böyük padşahdan kömək istədi,","poem":1},{"lineBreak":true},{"text":"Amma o sizə şəfa verməz,","poem":1},{"lineBreak":true},{"text":"Yaranızı sağaltmaz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bəli, Mən Efrayimlilərə qarşı bir şir,","poem":1},{"lineBreak":true},{"text":"Yəhuda nəsli üçün cavan aslan olacağam.","poem":1},{"lineBreak":true},{"text":"Mən, Mən onu parçalayıb gedəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sürüyəcəyəm və kimsə əlimdən qurtarmayacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sonra qayıdıb Öz məskənimə gedəcəyəm,","poem":1},{"lineBreak":true},{"text":"O vaxtacan ki özlərini günahkar sayaraq","poem":1},{"lineBreak":true},{"text":"Mənim hüzurumu axtaracaqlar.","poem":1},{"lineBreak":true},{"text":"Bəlaya düşəndə həsrətlə Məni axtaracaqlar».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}