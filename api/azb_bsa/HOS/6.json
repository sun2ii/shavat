{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["İsrailə çağırış"]},{"type":"verse","number":1,"content":[{"text":"«Gəlin Rəbbə qayıdaq.","poem":1},{"lineBreak":true},{"text":"O bizi parçaladı,","poem":1},{"lineBreak":true},{"text":"O da bizə şəfa verəcək.","poem":1},{"lineBreak":true},{"text":"O bizi yaraladı,","poem":1},{"lineBreak":true},{"text":"O da yaramızı sarıyacaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İki gün sonra bizi dirildəcək,","poem":1},{"lineBreak":true},{"text":"Üçüncü gün ayağa qaldıracaq,","poem":1},{"lineBreak":true},{"text":"Onun hüzurunda yaşayacağıq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gəlin Rəbbi tanıyaq, tanımağa səy edək.","poem":1},{"lineBreak":true},{"text":"O hökmən dan yeri kimi doğacaq,","poem":1},{"lineBreak":true},{"text":"Yağış kimi,","poem":1},{"lineBreak":true},{"text":"Torpağı sulayan yaz yağışı kimi","poem":1},{"lineBreak":true},{"text":"Yanımıza gələcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Allah deyir:","poem":1},{"lineBreak":true},{"text":"«Ey Efrayim, sənə nə edim?","poem":1},{"lineBreak":true},{"text":"Ey Yəhuda, bəs sənə nə edim?","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbətiniz səhər dumanı,","poem":1},{"lineBreak":true},{"text":"Erkən uçub gedən şeh kimidir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buna görə də sizi peyğəmbərlər vasitəsilə parçaladım,","poem":1},{"lineBreak":true},{"text":"Ağzımdan çıxan sözlərlə öldürdüm.","poem":1},{"lineBreak":true},{"text":"Sizin üzərinizdə hökmüm","poem":1},{"lineBreak":true},{"text":"Şimşək kimi parıldayır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki Mən qurban deyil,","poem":1},{"lineBreak":true},{"text":"Məhəbbət istəyirəm.","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanlarından çox","poem":1},{"lineBreak":true},{"text":"Allahı tanımağınızı istəyirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ancaq onlar Adəm kimi əhdi pozdu,","poem":1},{"lineBreak":true},{"text":"Orada Mənə xəyanət etdi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gilead şər adamların şəhəridir,","poem":1},{"lineBreak":true},{"text":"Qan izləri ilə doludur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Quldur dəstələri necə insan üçün pusquya yatırsa,","poem":1},{"lineBreak":true},{"text":"Kahin dəstələri də Şekemə gedən yolda adam öldürür,","poem":1},{"lineBreak":true},{"text":"Bəli, xəbislik edir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İsrail nəslində qorxunc bir şey gördüm,","poem":1},{"lineBreak":true},{"text":"Efrayim fahişəliyə batmış,","poem":1},{"lineBreak":true},{"text":"İsrail murdarlanmışdır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey Yəhuda, sənin üçün də","poem":1},{"lineBreak":true},{"text":"Bir biçin günü təyin edildi.","poem":1},{"lineBreak":true},{"text":"Mən xalqımı sürgündən qaytaranda,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}