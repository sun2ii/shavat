{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"İsrailə şəfa vermək istəyəndə","poem":1},{"lineBreak":true},{"text":"Efrayimin günahları,","poem":1},{"lineBreak":true},{"text":"Samariyanın pislikləri ortaya çıxır.","poem":1},{"lineBreak":true},{"text":"Çünki hiylə ilə davranırlar.","poem":1},{"lineBreak":true},{"text":"Evlərə oğru girir,","poem":1},{"lineBreak":true},{"text":"Küçədə quldur soyğunçuluq edir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ürəklərində düşünmürlər ki,","poem":1},{"lineBreak":true},{"text":"Mən onların bütün pisliklərini yada salıram.","poem":1},{"lineBreak":true},{"text":"İndi günahları onları dövrələyib və","poem":1},{"lineBreak":true},{"text":"Gözümün önündədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Padşahı pislikləri ilə,","poem":1},{"lineBreak":true},{"text":"Başçıları yalanları ilə sevindirirlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hamısı zinakardır,","poem":1},{"lineBreak":true},{"text":"Yoğrulan xəmir acıyana qədər","poem":1},{"lineBreak":true},{"text":"Təndirçinin odunu qurdalamağa ehtiyac görmədiyi","poem":1},{"lineBreak":true},{"text":"Soba kimi şəhvətlə yanırlar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Padşahımızın ad günündə","poem":1},{"lineBreak":true},{"text":"Başçılar şərabın atəşindən xəstələndi,","poem":1},{"lineBreak":true},{"text":"Padşah da istehzaçılarla əl-ələ verdi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pusquda yatarkən","poem":1},{"lineBreak":true},{"text":"Ürəkləri soba kimi qızar.","poem":1},{"lineBreak":true},{"text":"Qəzəbləri bütün gecə için-için yanar,","poem":1},{"lineBreak":true},{"text":"Səhər də alovlu atəş kimi parlayar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların hamısı soba kimi qızışıb","poem":1},{"lineBreak":true},{"text":"Öz hakimlərini həlak etdi.","poem":1},{"lineBreak":true},{"text":"Bütün padşahları yıxıldı,","poem":1},{"lineBreak":true},{"text":"Aralarında Məni çağıran yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Efrayim başqa xalqlara qarışır;","poem":1},{"lineBreak":true},{"text":"Efrayim bir üzü çiy qalan kökədir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onun gücünü özgələr yedi,","poem":1},{"lineBreak":true},{"text":"O isə bilmir,","poem":1},{"lineBreak":true},{"text":"Saçına dən düşüb,","poem":1},{"lineBreak":true},{"text":"O isə bilmir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İsrailin qüruru özünə qarşı şəhadət edir.","poem":1},{"lineBreak":true},{"text":"Ancaq yenə də özlərinin Allahı Rəbbə tərəf dönmür,","poem":1},{"lineBreak":true},{"text":"Onu axtarmırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Efrayim səfeh və dərrakəsiz bir göyərçin kimidir.","poem":1},{"lineBreak":true},{"text":"Gah Misirliləri çağırır,","poem":1},{"lineBreak":true},{"text":"Gah Aşşura gedirlər.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onlar gedən zaman","poem":1},{"lineBreak":true},{"text":"Mən onların başına torumu atacağam.","poem":1},{"lineBreak":true},{"text":"Göydəki quşlar kimi","poem":1},{"lineBreak":true},{"text":"Onları vurub yerə salacağam.","poem":1},{"lineBreak":true},{"text":"İcmalarında bildirildiyi kimi","poem":1},{"lineBreak":true},{"text":"Onları cəzalandıracağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Vay onların halına!","poem":1},{"lineBreak":true},{"text":"Çünki Məndən uzaqlaşdılar.","poem":1},{"lineBreak":true},{"text":"Başlarına bəla gəlsin!","poem":1},{"lineBreak":true},{"text":"Çünki Mənə qarşı üsyan etdilər.","poem":1},{"lineBreak":true},{"text":"Mən onları qurtarmaq istəyirdim,","poem":1},{"lineBreak":true},{"text":"Onlarsa Mənə böhtan deyir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ürəkdən Mənə fəryad etmirlər,","poem":1},{"lineBreak":true},{"text":"Ancaq yataqlarının içində ulayırlar.","poem":1},{"lineBreak":true},{"text":"Taxıl və təzə şərab üçün özlərini yaralayırlar,","poem":1},{"lineBreak":true},{"text":"Amma Məndən üz döndərirlər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən onlara nəsihət verdim,","poem":1},{"lineBreak":true},{"text":"Qollarına güc verdim.","poem":1},{"lineBreak":true},{"text":"Onlarsa Mənə qarşı qəsd qurur.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onlar üz tutur,","poem":1},{"lineBreak":true},{"text":"Ancaq ucalara tərəf yox.","poem":1},{"lineBreak":true},{"text":"Hədəfi əyri vuran kamana bənzəyirlər.","poem":1},{"lineBreak":true},{"text":"Dillərinin arsızlığı üzündən","poem":1},{"lineBreak":true},{"text":"Başçıları qılınca tuş gələcək.","poem":1},{"lineBreak":true},{"text":"Buna görə də Misirdə","poem":1},{"lineBreak":true},{"text":"Kinayə hədəfi olacaqlar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}