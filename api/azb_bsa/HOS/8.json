{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["İsrailin bütpərəstliyi"]},{"type":"verse","number":1,"content":[{"text":"Şeypur çalmağa hazırlaş!","poem":1},{"lineBreak":true},{"text":"Rəbbin evinin üzərinə","poem":1},{"lineBreak":true},{"text":"Düşmən qartal kimi hücum çəkir.","poem":1},{"lineBreak":true},{"text":"Çünki İsraillilər Mənim əhdimi pozdu,","poem":1},{"lineBreak":true},{"text":"Mənim qanunuma qarşı çıxdı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar Mənə fəryad edib deyəcək:","poem":1},{"lineBreak":true},{"text":"“Allahım, biz İsraillilər Səni tanıyırıq”.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İsrail yaxşılığı rədd etdi,","poem":1},{"lineBreak":true},{"text":"Düşmən onu təqib edəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məndən soruşmadan","poem":1},{"lineBreak":true},{"text":"Özlərinə padşah qoydular.","poem":1},{"lineBreak":true},{"text":"Məndən xəbər almadan","poem":1},{"lineBreak":true},{"text":"Başçılar seçdilər.","poem":1},{"lineBreak":true},{"text":"Özlərinə qızıl və gümüşlərindən","poem":1},{"lineBreak":true},{"text":"Ölümlərinə yol açan","poem":1},{"lineBreak":true},{"text":"Bütlər düzəltdilər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Samariya, dana bütün rədd edildi!","poem":1},{"lineBreak":true},{"text":"Mənim qəzəbim onlara qarşı alovlandı.","poem":1},{"lineBreak":true},{"text":"Nə vaxta qədər onlar pak olmayacaq?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki bu büt İsrailin işidir,","poem":1},{"lineBreak":true},{"text":"Usta onu düzəldib,","poem":1},{"lineBreak":true},{"text":"Ona görə də Allah deyil.","poem":1},{"lineBreak":true},{"text":"Samariyadakı dana bütü","poem":1},{"lineBreak":true},{"text":"Xıncım-xıncım olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Onlar külək qaldırdı,","poem":1},{"lineBreak":true},{"text":"Qasırğa alacaqlar.","poem":1},{"lineBreak":true},{"text":"Sünbül bitirməyən buğda un verməz,","poem":1},{"lineBreak":true},{"text":"Versə də, yadlar onu udacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsrail udulmuşdur,","poem":1},{"lineBreak":true},{"text":"İndi onlar millətlər arasında","poem":1},{"lineBreak":true},{"text":"Heç kəsin bəyənmədiyi bir qab kimi oldu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar tənha gəzən vəhşi eşşək kimi","poem":1},{"lineBreak":true},{"text":"Aşşur tərəfə getdi.","poem":1},{"lineBreak":true},{"text":"Efrayim muzdla özünə oynaşlar tutdu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar millətlər arasında muzdla oynaş tutsalar da,","poem":1},{"lineBreak":true},{"text":"Mən indi onları bir yerə toplayacağam.","poem":1},{"lineBreak":true},{"text":"Onlar qüdrətli padşahın zülmündən","poem":1},{"lineBreak":true},{"text":"Azalmağa başlayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayim günah təqdimi üçün","poem":1},{"lineBreak":true},{"text":"Çoxlu qurbangah tiksə də,","poem":1},{"lineBreak":true},{"text":"Bunlar onu günaha batıran qurbangahlar oldu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mən onlar üçün çoxlu qanun yazdım,","poem":1},{"lineBreak":true},{"text":"Onlarsa bunları yad bir şey hesab etdi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mənə kəsilən qurbanlara gəlincə,","poem":1},{"lineBreak":true},{"text":"Əti Mənə qurban gətirib","poem":1},{"lineBreak":true},{"text":"Özləri yeyir.","poem":1},{"lineBreak":true},{"text":"Rəbb onlardan razı deyil.","poem":1},{"lineBreak":true},{"text":"İndi onların qəbahətlərini yada salacaq,","poem":1},{"lineBreak":true},{"text":"Günahlarına görə onları cəzalandıracaq.","poem":1},{"lineBreak":true},{"text":"Onlar Misirə qayıdacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"İsrail də Yaradanını unutdu,","poem":1},{"lineBreak":true},{"text":"Özünə saraylar qurdu.","poem":1},{"lineBreak":true},{"text":"Yəhuda da çoxlu qalalı şəhər tikdi,","poem":1},{"lineBreak":true},{"text":"Ancaq Mən onun şəhərlərinə od göndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qalalarını alov yeyəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}