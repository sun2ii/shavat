{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"HOS","translationId":"azb_bsa","name":"HUŞƏ","commonName":"HUŞƏ","title":"HUŞƏ PEYĞƏMBƏRİN KİTABI","order":28,"numberOfChapters":14,"sha256":"8f2844f2811a6c22da2b7065bde0efadefdd8b5ef58ac41f5725c8bde0f4fcdc","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["İsrailin cəzası"]},{"type":"verse","number":1,"content":[{"text":"Ey İsrail, başqa xalqlar kimi","poem":1},{"lineBreak":true},{"text":"Sevinib coşma,","poem":1},{"lineBreak":true},{"text":"Çünki öz Allahına xəyanət etdin.","poem":1},{"lineBreak":true},{"text":"Bütün xırmanlarda","poem":1},{"lineBreak":true},{"text":"Fahişəlik muzduna könül verdin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xırman və üzümsıxan xalqı doydurmayacaq,","poem":1},{"lineBreak":true},{"text":"Təzə şərab onlara qismət olmayacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbbin torpağında yaşamayacaqlar,","poem":1},{"lineBreak":true},{"text":"Efrayim Misirə qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Aşşurda murdar yemək yeyəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbbə təqdim olaraq şərab tökməyəcəklər,","poem":1},{"lineBreak":true},{"text":"Qurbanları Ona məqbul olmayacaq.","poem":1},{"lineBreak":true},{"text":"Qurbanlar onlara yas çörəyi olacaq,","poem":1},{"lineBreak":true},{"text":"Onu yeyənlərin hamısı murdar olacaq.","poem":1},{"lineBreak":true},{"text":"Çörəkləri özlərinə qismət olacaq,","poem":1},{"lineBreak":true},{"text":"Amma Rəbbin evinə gətirilməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Təntənəli bayramda,","poem":1},{"lineBreak":true},{"text":"Rəbbin bayram günündə nə edəcəksiniz?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Məhvdən qaçsalar da,","poem":1},{"lineBreak":true},{"text":"Misir onları yığacaq,","poem":1},{"lineBreak":true},{"text":"Memfis qəbirə basdıracaq.","poem":1},{"lineBreak":true},{"text":"Onların gümüş xəzinələrini gicitkən tutacaq,","poem":1},{"lineBreak":true},{"text":"Çadırlarında qanqal bitəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların cəza günləri gəldi,","poem":1},{"lineBreak":true},{"text":"Haqq-hesab günləri yetişdi.","poem":1},{"lineBreak":true},{"text":"Qoy İsrail bunu bilsin!","poem":1},{"lineBreak":true},{"text":"Təqsirlərinizin çoxluğundan,","poem":1},{"lineBreak":true},{"text":"Düşmənçiliyinizin böyüklüyündən","poem":1},{"lineBreak":true},{"text":"Peyğəmbəri əbləh,","poem":1},{"lineBreak":true},{"text":"Ruhani adamı divanə saydınız.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Peyğəmbər Allahımın Efrayim üzərində qoyduğu gözətçidir.","poem":1},{"lineBreak":true},{"text":"Amma onun getdiyi hər yerdə tor qurdular,","poem":1},{"lineBreak":true},{"text":"Allahın evində düşmənçilik var.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Givea günlərində olduğu kimi","poem":1},{"lineBreak":true},{"text":"Onlar böyük pozğunluğa düçar oldu.","poem":1},{"lineBreak":true},{"text":"Allah onların təqsirlərini yada salacaq,","poem":1},{"lineBreak":true},{"text":"Günahları üçün onları cəzalandıracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Səhrada üzüm tapan kimi","poem":1},{"lineBreak":true},{"text":"Mən İsraili tapdım,","poem":1},{"lineBreak":true},{"text":"İlk dəfə məhsul verən əncir nübarı kimi","poem":1},{"lineBreak":true},{"text":"Mən atalarınızı gördüm.","poem":1},{"lineBreak":true},{"text":"Amma onlar Baal-Peora çatanda","poem":1},{"lineBreak":true},{"text":"Rüsvayçı bütlərə təslim oldu.","poem":1},{"lineBreak":true},{"text":"Özləri də sevdikləri şeylər kimi","poem":1},{"lineBreak":true},{"text":"İyrənc oldu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayimin calalı","poem":1},{"lineBreak":true},{"text":"Bir quş kimi uçub gedəcək.","poem":1},{"lineBreak":true},{"text":"Nə doğum, nə hamiləlik, nə mayalanma olacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Öz uşaqlarını böyütsələr də,","poem":1},{"lineBreak":true},{"text":"Balalarını əllərindən alacağam,","poem":1},{"lineBreak":true},{"text":"Onları kimsəsiz qoyacağam.","poem":1},{"lineBreak":true},{"text":"Mən onları tərk etdikdə vay hallarına!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mən gördüm ki, Efrayim","poem":1},{"lineBreak":true},{"text":"Sur şəhəri kimi gözəl bir yerdə məskən salıb.","poem":1},{"lineBreak":true},{"text":"Amma Efrayim öz övladlarını","poem":1},{"lineBreak":true},{"text":"Qatil qabağına çıxaracaq».","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ya Rəbb, nə verəcəksən, ver onlara,","poem":1},{"lineBreak":true},{"text":"Onlara uşaq salan bətn, südsüz döşlər ver!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rəbb deyir: «Onlar bütün pis əməllərini","poem":1},{"lineBreak":true},{"text":"Qilqalda edir,","poem":1},{"lineBreak":true},{"text":"Orada onlara nifrət etdim.","poem":1},{"lineBreak":true},{"text":"Etdikləri günahlardan ötrü","poem":1},{"lineBreak":true},{"text":"Onları evimdən qovacağam.","poem":1},{"lineBreak":true},{"text":"Artıq onları sevməyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bütün başçıları üsyankardır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Efrayim kəsildi,","poem":1},{"lineBreak":true},{"text":"Kökləri qurudu.","poem":1},{"lineBreak":true},{"text":"Onlar bar verməyəcək.","poem":1},{"lineBreak":true},{"text":"Əgər doğsalar da,","poem":1},{"lineBreak":true},{"text":"Bətnlərinin əziz barını Mən məhv edəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Allahım onları rədd edəcək,","poem":1},{"lineBreak":true},{"text":"Çünki Ona qulaq asmadılar.","poem":1},{"lineBreak":true},{"text":"Millətlər arasında sərgərdan gəzəcəklər.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}