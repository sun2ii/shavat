{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yəhuda padşahları Uzziya, Yotam, Axaz, Xizqiyanın dövründə Yəhuda və Yerusəlim barəsində Amots oğlu Yeşayaya görünən görüntü."]},{"type":"heading","content":["Rəbb xalqına xəbərdarlıq edir"]},{"type":"verse","number":2,"content":[{"text":"Ey göylər, eşidin,","poem":1},{"lineBreak":true},{"text":"Ey yer üzü, dinləyin!","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb belə söylədi:","poem":1},{"lineBreak":true},{"text":"«Övladlar yetişdirib böyütdüm,","poem":1},{"lineBreak":true},{"text":"Amma onlar Mənə qarşı üsyankar oldular.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Öküz yiyəsini,","poem":1},{"lineBreak":true},{"text":"Eşşək də sahibinin təknəsini tanıyır,","poem":1},{"lineBreak":true},{"text":"Lakin İsrail xalqı Məni tanımır,","poem":1},{"lineBreak":true},{"text":"Xalqım anlamır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Günah edən millətin,","poem":1},{"lineBreak":true},{"text":"Şər işlər görən xalqın,","poem":1},{"lineBreak":true},{"text":"Yolunu azmış nəslin,","poem":1},{"lineBreak":true},{"text":"Pozulmuş övladların vay halına!","poem":1},{"lineBreak":true},{"text":"Onlar Rəbbi tərk etdilər,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsinə xor baxdılar,","poem":1},{"lineBreak":true},{"text":"Ondan üz döndərdilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Siz nə üçün yenə döyüləsiniz,","poem":1},{"lineBreak":true},{"text":"Niyə üsyan etməkdə davam edirsiniz?","poem":1},{"lineBreak":true},{"text":"Xoralar başınızı tamamilə bürüyüb,","poem":1},{"lineBreak":true},{"text":"Ürəyiniz azara düşüb.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Təpədən dırnağacan bədəniniz xəstədir,","poem":1},{"lineBreak":true},{"text":"Bir sağlam yeriniz yoxdur:","poem":1},{"lineBreak":true},{"text":"Yaralarınız, zədələriniz,","poem":1},{"lineBreak":true},{"text":"Yenə də vurulmuş yaralarınız","poem":1},{"lineBreak":true},{"text":"Təmizlənməmiş, sarılmamış,","poem":1},{"lineBreak":true},{"text":"Məlhəmlə yumşaldılmamışdır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ölkəniz viran qaldı,","poem":1},{"lineBreak":true},{"text":"Şəhərləriniz alışıb-yandı,","poem":1},{"lineBreak":true},{"text":"Yadellilər gözünüzün önündəcə torpağınızı yeyib-dağıtdı.","poem":1},{"lineBreak":true},{"text":"Torpağınız kimsəsiz qalıb,","poem":1},{"lineBreak":true},{"text":"Sanki yad adamlar oranı talayıb.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sion qızı bağdakı çardaq, bostandakı koma,","poem":1},{"lineBreak":true},{"text":"Mühasirəyə alınmış şəhər kimi tək qalıb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Əgər Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Bizim üçün bir neçə adamı sağ qoymasaydı,","poem":1},{"lineBreak":true},{"text":"Biz Sodom kimi olardıq,","poem":1},{"lineBreak":true},{"text":"Homorraya bənzəyərdik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ey Sodom başçıları,","poem":1},{"lineBreak":true},{"text":"Rəbbin sözünü eşidin!","poem":1},{"lineBreak":true},{"text":"Siz, ey Homorra xalqı,","poem":1},{"lineBreak":true},{"text":"Allahımızın təlimini dinləyin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Qurbanlarınız çoxalıb, Mənə nə?","poem":1},{"lineBreak":true},{"text":"Yandırma qoç qurbanlarından,","poem":1},{"lineBreak":true},{"text":"Bəslənmiş heyvanların piyindən doymuşam.","poem":1},{"lineBreak":true},{"text":"Buğa, quzu, təkə qanını istəmirəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hüzuruma gələrkən","poem":1},{"lineBreak":true},{"text":"Əlinizdə bunları gətirməyinizi kim istədi?","poem":1},{"lineBreak":true},{"text":"Məbədimin həyətlərinə boş yerə ayaq basırsınız.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mənə artıq batil təqdimlər gətirməyin,","poem":1},{"lineBreak":true},{"text":"Buxur Məndə ikrah yaradır.","poem":1},{"lineBreak":true},{"text":"Pisliklə dolu","poem":1},{"lineBreak":true},{"text":"Təzə Ay mərasimlərinizə,","poem":1},{"lineBreak":true},{"text":"Şənbə günlərinizə,","poem":1},{"lineBreak":true},{"text":"Müqəddəs toplantılarınıza","poem":1},{"lineBreak":true},{"text":"Dözə bilmirəm!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Təzə Ay mərasimlərinizə,","poem":1},{"lineBreak":true},{"text":"Bayram günlərinizə","poem":1},{"lineBreak":true},{"text":"Ürəkdən nifrət edirəm.","poem":1},{"lineBreak":true},{"text":"Bunlar Mənə yük oldu,","poem":1},{"lineBreak":true},{"text":"Onları daşımaqdan yoruldum.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Siz əl açıb Mənə yalvaranda","poem":1},{"lineBreak":true},{"text":"Göz yumacağam.","poem":1},{"lineBreak":true},{"text":"Nə qədər çox dua etsəniz də,","poem":1},{"lineBreak":true},{"text":"Yenə qulaq asmayacağam.","poem":1},{"lineBreak":true},{"text":"Əlləriniz qanla doludur,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yuyunub təmizlənin,","poem":1},{"lineBreak":true},{"text":"Gözümün önündə işlərinizi şərdən uzaqlaşdırın,","poem":1},{"lineBreak":true},{"text":"Pislik etməkdən vaz keçin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaxşılıq etməyi öyrənin,","poem":1},{"lineBreak":true},{"text":"Ədaləti axtarın,","poem":1},{"lineBreak":true},{"text":"Məzlumları qurtarın,","poem":1},{"lineBreak":true},{"text":"Yetimin haqqını qoruyun,","poem":1},{"lineBreak":true},{"text":"Dul qadını müdafiə edin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Gəlin indi birgə düşünək bu an,","poem":1},{"lineBreak":true},{"text":"Günahlarınız qıpqırmızı parça kimi görünsə də,","poem":1},{"lineBreak":true},{"text":"Onlar qar kimi ağ olacaq,","poem":1},{"lineBreak":true},{"text":"Tünd qırmızı rəngə çalsa da,","poem":1},{"lineBreak":true},{"text":"Onlar ağ yun kimi bəyaz olacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"İtaətkar olub sözə baxsanız,","poem":1},{"lineBreak":true},{"text":"Torpağın ən gözəl bəhrələrindən yeyərsiniz.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Əgər üsyankar olub Məni rədd etsəniz,","poem":1},{"lineBreak":true},{"text":"Qılınc sizi yeyəcək».","poem":1},{"lineBreak":true},{"text":"Bu sözlər Rəbbin ağzından çıxıb.","poem":1}]},{"type":"heading","content":["Günahlı şəhər"]},{"type":"verse","number":21,"content":[{"text":"Rəbbə sadiq şəhər","poem":1},{"lineBreak":true},{"text":"Necə də fahişəyə bənzər oldu!","poem":1},{"lineBreak":true},{"text":"Axı o, ədalətlə dolu idi,","poem":1},{"lineBreak":true},{"text":"Orada salehlik məskunlaşmışdı,","poem":1},{"lineBreak":true},{"text":"İndi isə qatillərlə doludur!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gümüşünüz tullantıya çevrildi,","poem":1},{"lineBreak":true},{"text":"Şərabınıza su qatıldı.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Başçılarınız üsyankar olub oğrularla əlbirdir.","poem":1},{"lineBreak":true},{"text":"Hər kəs rüşvəti sevir, bəxşiş dalınca düşür.","poem":1},{"lineBreak":true},{"text":"Yetimin haqqını qorumur,","poem":1},{"lineBreak":true},{"text":"Dul qadını müdafiə etmək haqqında düşünmür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Buna görə də Sahibimiz, Ordular Rəbbi,","poem":1},{"lineBreak":true},{"text":"İsrailin Qadir Allahı","poem":1},{"lineBreak":true},{"text":"Belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Yağılarımı cəzalandırıb rahatlanacağam,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimdən qisas alacağam.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ey İsrail xalqı, sənə əlimi uzadacağam,","poem":1},{"lineBreak":true},{"text":"Paxırını gilabı ilə təmizləyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün çirkini yuyacağam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hakimlərini, məsləhətçilərini","poem":1},{"lineBreak":true},{"text":"Əvvəlki kimi geri qaytaracağam.","poem":1},{"lineBreak":true},{"text":"Sənə yenidən:","poem":1},{"lineBreak":true},{"text":"“Salehlik şəhəri, sadiq şəhər” deyiləcək».","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sion ədalətlə,","poem":1},{"lineBreak":true},{"text":"Tövbə edən sakinləri salehliklə qurtulacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lakin üsyankarlarla günahkarlar","poem":1},{"lineBreak":true},{"text":"Birgə həlak olacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbi tərk edənlər yox olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Palıd ağaclarına səcdə etməkdən xəcalət çəkəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Seçdiyiniz bağlarda ibadət etməkdən utanacaqsınız.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yarpaqları solmuş palıd ağacına,","poem":1},{"lineBreak":true},{"text":"Susuz bağa dönəcəksiniz.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Güclü adam kətan qırıntısına oxşayacaq,","poem":1},{"lineBreak":true},{"text":"Gördüyü iş qığılcım kimi olacaq,","poem":1},{"lineBreak":true},{"text":"İkisi birlikdə yanacaq,","poem":1},{"lineBreak":true},{"text":"Onları söndürən olmayacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}