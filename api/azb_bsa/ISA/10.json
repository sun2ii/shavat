{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Haqsız qaydalar çıxaranların,","poem":1},{"lineBreak":true},{"text":"Ədalətsiz qanun qoyanların,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yoxsullardan ədaləti əsirgəyənlərin,","poem":1},{"lineBreak":true},{"text":"Xalqımın kasıblarının haqqını əlindən alanların,","poem":1},{"lineBreak":true},{"text":"Dul qadınları soyanların,","poem":1},{"lineBreak":true},{"text":"Yetimlərin malını ələ keçirənlərin vay halına!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cəza günü uzaqlardan başınıza bəla gələndə nə edəcəksiniz?","poem":1},{"lineBreak":true},{"text":"Kömək üçün kimin yanına qaçacaqsınız?","poem":1},{"lineBreak":true},{"text":"Mal-dövlətinizi harada saxlayacaqsınız?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dustaqlar arasında əyilməkdən","poem":1},{"lineBreak":true},{"text":"Yaxud öldürülənlər arasında yıxılmaqdan","poem":1},{"lineBreak":true},{"text":"Başqa bir çarə qalmayacaq.","poem":1},{"lineBreak":true},{"text":"Bütün bunlara qarşı yenə də Rəbbin qəzəbi sönmədi,","poem":1},{"lineBreak":true},{"text":"Əli hələ də cəzalandırmağa hazır idi.","poem":1}]},{"type":"heading","content":["Allahın Aşşura verdiyi cəza"]},{"type":"verse","number":5,"content":[{"text":"«Vay Aşşurun halına,","poem":1},{"lineBreak":true},{"text":"O Mənim qəzəb əsam,","poem":1},{"lineBreak":true},{"text":"Əlindəki dəyənəksə qeyzimdir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aşşuru göndərəcəyəm allahsız millətin üstünə,","poem":1},{"lineBreak":true},{"text":"Qəzəbləndiyim xalqın üzərinə hücum etməyə,","poem":1},{"lineBreak":true},{"text":"Qarət etməyə, talan malı götürməyə.","poem":1},{"lineBreak":true},{"text":"Onları küçələrdəki palçıq kimi","poem":1},{"lineBreak":true},{"text":"Tapdalamağa əmr verəcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amma Aşşur padşahı","poem":1},{"lineBreak":true},{"text":"Bundan da pis niyyətlər haqda düşünür,","poem":1},{"lineBreak":true},{"text":"Bir neçə millətin kökünü kəsib məhv etməyi fikirləşir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O deyir: “Məgər sərkərdələrimin hamısı padşahlardan artıq deyilmi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kalnonu Karkemiş kimi ələ keçirmədimmi?","poem":1},{"lineBreak":true},{"text":"Xamat və Arpad şəhərlərini süqut etdirmədimmi?","poem":1},{"lineBreak":true},{"text":"Samariya ilə Dəməşq bizə təslim olmadılarmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yerusəlimlə Samariyadakından daha çox oyma bütləri olan","poem":1},{"lineBreak":true},{"text":"Bütpərəst ölkələri necə ələ keçirdimsə,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Samariyaya və onun bütlərinə nə etdimsə,","poem":1},{"lineBreak":true},{"text":"Yerusəlimə və onun bütlərinə də elə etmərəmmi?”»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xudavənd Sion dağında və Yerusəlimdə işini bitirəndən sonra belə deyəcək:","poem":1},{"lineBreak":true},{"text":"«Aşşur padşahını qürurlu ürəyinə görə,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü baxışlarına görə cəzalandıracağam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çünki o deyir:","poem":1},{"lineBreak":true},{"text":"“Bunu mən əlimin qüvvəti ilə, hikmətim və ağlımla etdim.","poem":1},{"lineBreak":true},{"text":"Xalqları ayıran sərhədləri yox etdim, xəzinələrini talan etdim,","poem":1},{"lineBreak":true},{"text":"Bir güclü buğa kimi padşahları taxtlarından endirdim.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Elə bil əlimi quş yuvasına uzadıb","poem":1},{"lineBreak":true},{"text":"Xalqların var-dövlətini götürdüm.","poem":1},{"lineBreak":true},{"text":"Elə bil yiyəsiz yumurtaları yığıb","poem":1},{"lineBreak":true},{"text":"Bütün dünyanı mən beləcə zəbt etdim.","poem":1},{"lineBreak":true},{"text":"Qanad çırpan, ağzını açıb səsini çıxaran belə, olmadı”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Balta onu işlədənin qarşısında öyünərmi?","poem":1},{"lineBreak":true},{"text":"Mişar onu qaldıranın qarşısında qürrələnərmi?","poem":1},{"lineBreak":true},{"text":"Sanki dəyənək onu götürəni işlədir,","poem":1},{"lineBreak":true},{"text":"Elə bil ağacdan düzəlmiş əsa canlını hərəkət etdirir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Buna görə Sahibimiz, Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Aşşurun güclü əsgərlərinə azar göndərəcək,","poem":1},{"lineBreak":true},{"text":"Möhtəşəm orduları od tutub yanacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"İsrailin Nuru od,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsi alov olacaq.","poem":1},{"lineBreak":true},{"text":"Aşşuru tikan və qanqal kimi bir gündə yandırıb yox edəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gözəl meşələri, məhsuldar tarlaları","poem":1},{"lineBreak":true},{"text":"Tamamilə xarab olacaq,","poem":1},{"lineBreak":true},{"text":"Ağır xəstəliyə tutulan insanın canı kimi","poem":1},{"lineBreak":true},{"text":"Həlak olacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Meşələrində qalan ağaclarsa","poem":1},{"lineBreak":true},{"text":"Bir uşağın saya biləcəyi qədər az qalacaq.","poem":1}]},{"type":"heading","content":["İsrailin sağ qalanları"]},{"type":"verse","number":20,"content":[{"text":"O gün İsrailin sağ qalanları,","poem":1},{"lineBreak":true},{"text":"Yaqubun nəslindən xilas olub sağ qalanlar","poem":1},{"lineBreak":true},{"text":"Onları həlak edənlərə artıq bel bağlamayacaq.","poem":1},{"lineBreak":true},{"text":"Lakin, həqiqətən, Rəbbə –","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsinə arxalanacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sağ qalanlar,","poem":1},{"noteId":6},{"lineBreak":true},{"text":"Yaqub nəslindən sağ qalanlar","poem":1},{"lineBreak":true},{"text":"Qüdrətli Allaha tərəf dönəcək,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ey İsrail, xalqın dəniz qumu qədər çox olsa belə,","poem":1},{"lineBreak":true},{"text":"Onlar arasından ancaq sağ qalanlar Allaha tərəf dönəcək.","poem":1},{"lineBreak":true},{"text":"Tükənməz ədalətlə dağıdılma hökmü verilib.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xudavənd, Ordular Rəbbi dağıdılma hökmünü","poem":1},{"lineBreak":true},{"text":"Bütün dünyada yerinə yetirəcək.","poem":1}]},{"type":"heading","content":["Rəbb Aşşuru cəzalandıracaq"]},{"type":"verse","number":24,"content":[{"text":"Buna görə də Xudavənd, Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Ey Sionda yaşayan xalqım,","poem":1},{"lineBreak":true},{"text":"Misirlilərin sənə etdiyi kimi","poem":1},{"lineBreak":true},{"text":"Səni dəyənəklə vuran,","poem":1},{"lineBreak":true},{"text":"Üzərinə çomaq qaldıran","poem":1},{"lineBreak":true},{"text":"Aşşurlulardan qorxma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çünki bu yaxında qəzəbim sönəcək,","poem":1},{"lineBreak":true},{"text":"Hiddətim Aşşurluların məhvinə səbəb olacaq».","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mən Ordular Rəbbi, Midyanlıları Orev qayasında vurduğum kimi","poem":1},{"lineBreak":true},{"text":"Onları da qırmancla vuracağam,","poem":1},{"lineBreak":true},{"text":"Dəyənəyimi Misirlilərə qarşı nə cür dənizin üzərinə uzatdımsa,","poem":1},{"lineBreak":true},{"text":"İndi də elə edəcəyəm.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"O gün Aşşurun yükü çiyninizdən,","poem":1},{"lineBreak":true},{"text":"Boyunduruğu boynunuzdan götürüləcək.","poem":1},{"lineBreak":true},{"text":"Dirçəldiyinizə görə boyunduruq qırılacaq.","poem":1}]},{"type":"heading","content":["İşğalçıların hücumu"]},{"type":"verse","number":28,"content":[{"text":"Ayat şəhərini alıb Miqrondan keçdilər,","poem":1},{"lineBreak":true},{"text":"Mikmasda yüklərini boşaltdılar.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Onlar keçidi keçdi, Gevada gecələdi,","poem":1},{"lineBreak":true},{"text":"Rama şəhəri lərzəyə gəldi,","poem":1},{"lineBreak":true},{"text":"Şaulun şəhəri Giveada yaşayanlar qaçdı.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ey Qallim əhli, səsini ucalt!","poem":1},{"lineBreak":true},{"text":"Ey Layşa, dinlə,","poem":1},{"lineBreak":true},{"text":"Ey zavallı Anatot!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Madmena sakinləri qaçır,","poem":1},{"lineBreak":true},{"text":"Gevim sakinləri sığınacaq axtarır.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bu gün işğalçılar Novda qalacaq,","poem":1},{"lineBreak":true},{"text":"Sion şəhərinin qurulduğu dağa –","poem":1},{"lineBreak":true},{"text":"Yerusəlim təpəsinə yumruq göstərəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Budur, Sahibimiz, Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Düşməni dəhşətli gücü ilə budaqlar kimi kəsəcək.","poem":1},{"lineBreak":true},{"text":"Ən hündür ağaclar qırılacaq,","poem":1},{"lineBreak":true},{"text":"Qürurlular alçaldılacaq.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Meşədəki kolluqları balta kimi","poem":1},{"lineBreak":true},{"text":"Kəsib yerə sərəcək.","poem":1},{"lineBreak":true},{"text":"Livan Qüdrətli Olanın önündə diz çökəcək.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Sağ qalanlar – ibrani mətnində Şear-Yaşuv. Yeşaya bu sözləri ilk oğluna ad kimi verdi. Bax: Yeş. 7:3.","reference":{"chapter":10,"verse":21}}]},"thisChapterLink":"/api/azb_bsa/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}