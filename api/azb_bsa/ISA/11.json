{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Sülh ümidi"]},{"type":"verse","number":1,"content":[{"text":"Yesseyin kötüyündən yeni bir fidan çıxacaq,","poem":1},{"lineBreak":true},{"text":"Kökündən çıxan bir budaq bar verəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbin Ruhu,","poem":1},{"lineBreak":true},{"text":"Hikmət və anlayış ruhu,","poem":1},{"lineBreak":true},{"text":"Öyüd-nəsihət və qüdrət ruhu,","poem":1},{"lineBreak":true},{"text":"Bilik və Rəbb qorxusu ruhu","poem":1},{"lineBreak":true},{"text":"Onun üzərində olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O, Rəbb qorxusunda sevinc tapacaq.","poem":1},{"lineBreak":true},{"text":"Gözlərinin gördüyü ilə hökm etməyəcək,","poem":1},{"lineBreak":true},{"text":"Qulağı ilə eşitdiyinə görə qərar çıxarmayacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lakin o, yoxsullara haqq ilə hökm edəcək,","poem":1},{"lineBreak":true},{"text":"Yer üzündəki fəqirlərin işinə ədalətlə qərar çıxaracaq.","poem":1},{"lineBreak":true},{"text":"Dünyanı ağzının dəyənəyi ilə vuracaq.","poem":1},{"lineBreak":true},{"text":"Pis adamları ağzının nəfəsi ilə öldürəcək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O, belini salehliklə qurşayacaq,","poem":1},{"lineBreak":true},{"text":"Sədaqəti kəmər kimi taxacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O gün qurdla quzu bir yerdə yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Bəbirlə çəpiş birgə yatacaq,","poem":1},{"lineBreak":true},{"text":"Dana, gənc aslan və bəslənmiş mal-qara","poem":1},{"lineBreak":true},{"text":"Yan-yana duracaq,","poem":1},{"lineBreak":true},{"text":"Onları balaca uşaq gəzdirəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"İnəklə ayı bir yerdə otlayacaq,","poem":1},{"lineBreak":true},{"text":"Onların balaları bir yerdə yatacaq,","poem":1},{"lineBreak":true},{"text":"Şir də buğa tək saman yeyəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Südəmər körpə əfi ilanın","poem":1},{"lineBreak":true},{"text":"Yuvası üstündə oynayacaq,","poem":1},{"lineBreak":true},{"text":"Süddən kəsilmiş uşaq","poem":1},{"lineBreak":true},{"text":"Əlini gürzənin yuvasına salacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Müqəddəs dağımın heç bir yerində","poem":1},{"lineBreak":true},{"text":"Heç kimə zərər dəyməyəcək,","poem":1},{"lineBreak":true},{"text":"Heç bir kəs o birisini məhv etməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki sular dənizi bürüdüyü kimi","poem":1},{"lineBreak":true},{"text":"Dünya Rəbbin biliyi ilə dolacaq.","poem":1}]},{"type":"heading","content":["Əsirlər geri qayıdacaq"]},{"type":"verse","number":10,"content":[{"text":"O gün Yesseyin kökü xalqlara bayraq olacaq,","poem":1},{"lineBreak":true},{"text":"Millətlər ona tərəf yönələcək","poem":1},{"lineBreak":true},{"text":"Məskunlaşdığı yer izzətlə dolacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O gün Xudavənd Aşşurdan,","poem":1},{"lineBreak":true},{"text":"Misirdən, Patrosdan, Kuşdan,","poem":1},{"lineBreak":true},{"text":"Elamdan, Şinardan, Xamatdan və uzaq diyarlardan","poem":1},{"lineBreak":true},{"text":"Xalqının sağ qalanlarını qurtarmaq üçün","poem":1},{"lineBreak":true},{"text":"İkinci dəfə əlini uzadacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Millətlər üçün bayraq qaldıracaq,","poem":1},{"lineBreak":true},{"text":"Əsir düşmüş İsrail övladlarını yığacaq,","poem":1},{"lineBreak":true},{"text":"Dağılmış Yəhudalıları","poem":1},{"lineBreak":true},{"text":"Dünyanın dörd bucağından bir yerə gətirəcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Efrayimin qısqanclığı yox olacaq,","poem":1},{"lineBreak":true},{"text":"Yəhudanı sıxışdıranlar məhv olacaq.","poem":1},{"lineBreak":true},{"text":"Efrayim Yəhudaya qısqanmayacaq,","poem":1},{"lineBreak":true},{"text":"Yəhuda Efrayimi sıxışdırmayacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onların ikisi qərbdə Filiştlilərin üstünə hücum edəcək,","poem":1},{"lineBreak":true},{"text":"Birlikdə şərqdə yaşayanların var-dövlətini qarət edəcək,","poem":1},{"lineBreak":true},{"text":"Edom və Moav torpaqlarını zəbt edəcək,","poem":1},{"lineBreak":true},{"text":"Ammonlular onlara tabe olacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rəbb Misirdəki dənizin körfəzini","poem":1},{"lineBreak":true},{"text":"Büsbütün qurudacaq.","poem":1},{"lineBreak":true},{"text":"Fərat çayının üzərində","poem":1},{"lineBreak":true},{"text":"Əlini yellədərək səmum küləyi gətirəcək,","poem":1},{"lineBreak":true},{"text":"O, çayı yeddi dərəyə böləcək,","poem":1},{"lineBreak":true},{"text":"Adamlar oradan çarıqlarla keçə biləcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"İsrail övladları Misir torpağından çıxdığı kimi","poem":1},{"lineBreak":true},{"text":"Rəbbin Aşşurda sağ qalan xalqı üçün","poem":1},{"lineBreak":true},{"text":"Böyük bir çıxış yolu olacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}