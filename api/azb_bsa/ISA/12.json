{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Şükür məzmuru"]},{"type":"verse","number":1,"content":["O gün sən, ey İsrail, belə deyəcəksən:",{"text":"«Ya Rəbb, Sənə şükür edəcəyəm!","poem":1},{"lineBreak":true},{"text":"Sən mənə qəzəblənirdin,","poem":1},{"lineBreak":true},{"text":"Lakin qəzəbin söndü,","poem":1},{"lineBreak":true},{"text":"Mənə təsəlli verdin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Allah xilasımdır,","poem":1},{"lineBreak":true},{"text":"Ona güvənəcəyəm və qorxmayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb Allahımız qüvvətim, məzmurumdur,","poem":1},{"lineBreak":true},{"text":"O mənə xilas verdi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sevinclə xilas mənbələrindən","poem":1},{"lineBreak":true},{"text":"Su çəkəcəksiniz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O gün belə deyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"«Rəbbə şükür edin, Onun adını çağırın,","poem":1},{"lineBreak":true},{"text":"Xalqlar arasında Onun işlərini bəyan edin,","poem":1},{"lineBreak":true},{"text":"Onun adının ucalığını elan edin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbi tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Çünki O, möhtəşəm işlər gördü,","poem":1},{"lineBreak":true},{"text":"Qoy bütün dünya bunu bilsin!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey Sion sakinləri, səsinizi ucaldın,","poem":1},{"lineBreak":true},{"text":"Sevinclə çığırın,","poem":1},{"lineBreak":true},{"text":"Çünki aranızdakı İsrailin Müqəddəsi böyükdür».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}