{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Allah Babili cəzalandıracaq"]},{"type":"verse","number":1,"content":["Amots oğlu Yeşayaya Babil haqqında görüntü ilə nazil olan xəbərdarlıq:"]},{"type":"verse","number":2,"content":[{"text":"Çılpaq dağın zirvəsinə bayraq sancın!","poem":1},{"lineBreak":true},{"text":"Döyüşçüləri bərkdən səsləyin,","poem":1},{"lineBreak":true},{"text":"Əl edin ki, onlar","poem":1},{"lineBreak":true},{"text":"Əsilzadələr üçün ayrılan qapılardan içəri girsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mən seçdiklərimə əmr verdim,","poem":1},{"lineBreak":true},{"text":"Qəzəbimi düşmənlərə tökmək üçün","poem":1},{"lineBreak":true},{"text":"Cəsur cəngavərləri,","poem":1},{"lineBreak":true},{"text":"Ucalığımla öyünən igidləri səslədim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dağlardakı izdihamın gurultusunu eşidin,","poem":1},{"lineBreak":true},{"text":"Bu, böyük bir xalqın səsinə bənzər.","poem":1},{"lineBreak":true},{"text":"Bir yerə toplanan millətlərin,","poem":1},{"lineBreak":true},{"text":"Padşahlıqların nidasını dinləyin!","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi bir ordunu döyüşə çağırır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onlar uzaq ölkədən,","poem":1},{"lineBreak":true},{"text":"Üfüqlərin o biri tərəfindən gəlir.","poem":1},{"lineBreak":true},{"text":"Ölkəni tamamilə yerlə yeksan etmək üçün","poem":1},{"lineBreak":true},{"text":"Rəbb və Onun qəzəbinin silahı gəlir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fəryad edin, çünki Rəbbin günü yaxınlaşır.","poem":1},{"lineBreak":true},{"text":"O gün Külli-İxtiyarın etdiyi qırğın kimi gəlir!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buna görə hamının əlləri yanına düşəcək,","poem":1},{"lineBreak":true},{"text":"Hər kəs qorxub ürəyini yeyəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hər bir adamı dəhşət bürüyəcək,","poem":1},{"lineBreak":true},{"text":"Dərd və iztirab içində boğulacaq,","poem":1},{"lineBreak":true},{"text":"Doğan qadın kimi ağrı çəkəcək,","poem":1},{"lineBreak":true},{"text":"Çaşqın-çaşqın bir-birinə baxacaq,","poem":1},{"lineBreak":true},{"text":"Üzləri qızaracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Budur Rəbbin günü gəlir,","poem":1},{"lineBreak":true},{"text":"Amansızlıqla, qeyzlə, qızğın qəzəblə gəlir ki,","poem":1},{"lineBreak":true},{"text":"Yeri səhraya döndərsin,","poem":1},{"lineBreak":true},{"text":"Oradakı günahkarları məhv etsin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Göydəki ulduzlar və bürclər işıq verməyəcək,","poem":1},{"lineBreak":true},{"text":"Günəş doğarkən tutulacaq,","poem":1},{"lineBreak":true},{"text":"Ay nurunu saçmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rəbb deyir: «Pisliyə görə dünyanı,","poem":1},{"lineBreak":true},{"text":"Günahlarına görə pis adamları cəzalandıracağam.","poem":1},{"lineBreak":true},{"text":"Təkəbbürlülərin qürurunu qıracağam,","poem":1},{"lineBreak":true},{"text":"Zalımların məğrurluğunu alçaldacağam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İnsan saf qızıldan da az olacaq,","poem":1},{"lineBreak":true},{"text":"Adam Ofir qızılından da nadir halda tapılacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Buna görə də Mən Ordular Rəbbi,","poem":1},{"lineBreak":true},{"text":"Qızğın qəzəb günündə","poem":1},{"lineBreak":true},{"text":"Qeyzlə göyləri titrədəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yer üzü lərzəyə gələcək.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hər kəs qovulan ceyrana, çobansız qoyunlara dönüb","poem":1},{"lineBreak":true},{"text":"Öz xalqının yanına qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Öz vətəninə qaçacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bütün tutulanların bədəni dəlik-deşik olacaq,","poem":1},{"lineBreak":true},{"text":"Ələ keçənlərin hamısı qılıncdan keçiriləcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onların gözləri önündə körpələri parça-parça ediləcək,","poem":1},{"lineBreak":true},{"text":"Evləri talan ediləcək,","poem":1},{"lineBreak":true},{"text":"Arvadlarının namusuna toxunulacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gümüşə qiymət verməyən,","poem":1},{"lineBreak":true},{"text":"Qızılı sevməyən Midiyalıları","poem":1},{"lineBreak":true},{"text":"Onlara qarşı qaldıracağam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ox-kamanları gəncləri parça-parça edəcək,","poem":1},{"lineBreak":true},{"text":"Körpələrə rəhm etməyəcəklər,","poem":1},{"lineBreak":true},{"text":"Uşaqları əsirgəməyəcəklər.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mən Allah Sodomla Homorranı necə dağıtdımsa,","poem":1},{"lineBreak":true},{"text":"Padşahlıqların ən gözəli olan,","poem":1},{"lineBreak":true},{"text":"Xaldeylilərin calalı və qüruru olan","poem":1},{"lineBreak":true},{"text":"Babili də elə yıxacağam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Orada bir daha heç kim yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"Nəsildən-nəslə kimsə məskunlaşmayacaq.","poem":1},{"lineBreak":true},{"text":"Ərəblər çadırlarını qurmayacaq,","poem":1},{"lineBreak":true},{"text":"Çobanlar sürülərini orada saxlamayacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ora vəhşi heyvanların yaşadığı yer olacaq,","poem":1},{"lineBreak":true},{"text":"Bayquşlar evlərdə qaynaşacaq,","poem":1},{"lineBreak":true},{"text":"Orada dəvəquşular məskən salacaq,","poem":1},{"lineBreak":true},{"text":"Təkələr oynaşacaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Saraylarında goreşənlər çığıracaq,","poem":1},{"lineBreak":true},{"text":"Gözəl imarətlərində çaqqallar gəzəcək.","poem":1},{"lineBreak":true},{"text":"Babilin sonu yaxınlaşır,","poem":1},{"lineBreak":true},{"text":"O günlər tez gəlib çatacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}