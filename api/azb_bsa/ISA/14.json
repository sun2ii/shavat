{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"heading","content":["Əsirlərin qayıtması"]},{"type":"verse","number":1,"content":[{"text":"Rəbb Yaqub nəslinə rəhm edəcək,","poem":1},{"lineBreak":true},{"text":"İsrail xalqını yenə seçib torpaqlarına sakin edəcək,","poem":1},{"lineBreak":true},{"text":"Yadellilər də Yaqub nəslinə qoşulacaq, onlarla birləşəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xalqlar İsrail xalqını götürüb torpaqlarına aparacaq.","poem":1},{"lineBreak":true},{"text":"Onda İsrail xalqı Rəbbin torpağında","poem":1},{"lineBreak":true},{"text":"Onları özlərinə qul və kəniz edəcək;","poem":1},{"lineBreak":true},{"text":"Onları əsir aparanları özləri əsir edəcək,","poem":1},{"lineBreak":true},{"text":"Onlara zülm edənlərin üzərində hökm sürəcək.","poem":1}]},{"type":"heading","content":["Ölülər diyarına düşən Babil padşahı"]},{"type":"verse","number":3,"content":[{"text":"Rəbb səni ağrıdan, sıxıntıdan,","poem":1},{"lineBreak":true},{"text":"Gördüyün ağır işdən qurtaranda","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Babil padşahına lağ edib belə deyəcəksən:","poem":1},{"lineBreak":true},{"text":"«Zülmkarın sonu gör necə oldu!","poem":1},{"lineBreak":true},{"text":"Zorakılığın axırı gör necə oldu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbb pis adamların dəyənəyini,","poem":1},{"lineBreak":true},{"text":"Hökmdarların əsasını qırdı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O əsa ki dayanmadan xalqları qəzəblə vurardı,","poem":1},{"lineBreak":true},{"text":"Millətləri qeyzlə, amansızca əzərdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"İndi isə bütün dünya","poem":1},{"lineBreak":true},{"text":"Sakitlik və rahatlıq içində sevincdən coşur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Livanın şam və sidr ağacları","poem":1},{"lineBreak":true},{"text":"Sənin fəlakətinə sevinərək deyir:","poem":1},{"lineBreak":true},{"text":"“Sənin ölümündən bəri heç kim bizi kəsməyə gəlmir”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yerin altındakı ölülər diyarı sənə “xoş gəldin” deyib,","poem":1},{"lineBreak":true},{"text":"Səni qarşılamağa can atır, ey Babil padşahı!","poem":1},{"lineBreak":true},{"text":"Yer üzünün ölən bütün başçıları","poem":1},{"lineBreak":true},{"text":"Sənin gəlişindən həyəcanlanır,","poem":1},{"lineBreak":true},{"text":"Millətlərin bütün keçmiş padşahları","poem":1},{"lineBreak":true},{"text":"Taxtlarından ayağa qalxır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hamı səni çağırıb belə deyəcək:","poem":1},{"lineBreak":true},{"text":"“Sən də bizim kimi zəif oldun, bizə bənzədin!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cah-calalın, çənglərinin səsi","poem":1},{"lineBreak":true},{"text":"Ölülər diyarına endirildi.","poem":1},{"lineBreak":true},{"text":"Altını qurd, üstünü həşərat bürüdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey parlaq ulduz, dan oğlu,","poem":1},{"lineBreak":true},{"text":"Necə də göylərdən yerə düşdün!","poem":1},{"lineBreak":true},{"text":"Ey millətləri tapdalayıb keçən,","poem":1},{"lineBreak":true},{"text":"Necə də yerə yıxıldın!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən ürəyində dedin:","poem":1},{"lineBreak":true},{"text":"“Göylərə qalxacağam,","poem":1},{"lineBreak":true},{"text":"Taxtımı Allahın ulduzları üzərində ucaldacağam,","poem":1},{"lineBreak":true},{"text":"Şimaldakı yüksək yerdə, toplantı dağında oturacağam,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Uca buludların üzərinə çıxacağam,","poem":1},{"lineBreak":true},{"text":"Haqq-Taala kimi olacağam”.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ancaq ölülər diyarına,","poem":1},{"lineBreak":true},{"text":"Ölüm çuxurunun dərinliyinə endiriləcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Səni görənlər gözlərini zilləyib","poem":1},{"lineBreak":true},{"text":"Sənin haqqında düşünüb belə deyəcək:","poem":1},{"lineBreak":true},{"text":"“Dünyanı sarsıdan, padşahlıqları lərzəyə salan,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yer üzünü səhraya çevirən,","poem":1},{"lineBreak":true},{"text":"Şəhərlərini yerlə yeksan edən,","poem":1},{"lineBreak":true},{"text":"Dustaqları evlərinə buraxmayan adam bu deyilmi?”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bütün millətlərin padşahları,","poem":1},{"lineBreak":true},{"text":"Hər biri öz əzəmətli sərdabəsində uyuyur.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakin sən iyrənc budaq kimi","poem":1},{"lineBreak":true},{"text":"Qəbrindən kənara, uzağa atıldın,","poem":1},{"lineBreak":true},{"text":"Bir çuxurun dibinə tullanan,","poem":1},{"lineBreak":true},{"text":"Bədənləri qılıncla deşilən meyitlərlə örtülmüsən,","poem":1},{"lineBreak":true},{"text":"Ayaq altında qalan leş kimisən.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ölkəni dağıdıb xalqını öldürdüyünə görə","poem":1},{"lineBreak":true},{"text":"Başqaları kimi dəfn olmayacaqsan.","poem":1},{"lineBreak":true},{"text":"Pislik edənlərin nəsli bir daha xatırlanmayacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Atalarının günahına görə","poem":1},{"lineBreak":true},{"text":"Övladları üçün qırğın hazırlayın ki,","poem":1},{"lineBreak":true},{"text":"Onlar qalxıb dünyanı zəbt etməsinlər,","poem":1},{"lineBreak":true},{"text":"Dünyanın üzərini şəhərləri ilə bürüməsinlər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Babil xalqına qarşı qalxacağam»","poem":1},{"lineBreak":true},{"text":"Bunu Ordular Rəbbi bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Babilin adını, sağ qalanlarını, oğullarını,","poem":1},{"lineBreak":true},{"text":"Nəsillərini yox edəcəyəm» Rəbb bəyan edir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"«Babili bayquş yuvasına, bataqlığa çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qırğın süpürgəsi ilə süpürəcəyəm»","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi bəyan edir.","poem":1}]},{"type":"heading","content":["Rəbb Aşşurluları cəzalandıracaq"]},{"type":"verse","number":24,"content":[{"text":"Ordular Rəbbi and içib belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mütləq düşündüyüm kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Niyyət etdiyim kimi gerçəkləşəcək.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ölkəmdə Aşşurluları məhv edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Dağlarımda onları tapdalayacağam.","poem":1},{"lineBreak":true},{"text":"Xalqım Aşşurun boyunduruğundan,","poem":1},{"lineBreak":true},{"text":"Çiyinlərindəki yükündən qurtulacaq.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bütün dünya üçün hazırladığım hökm budur,","poem":1},{"lineBreak":true},{"text":"Bütün millətlərə qarşı uzanan əl budur.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ordular Rəbbinin hökmünü kim poza bilər?","poem":1},{"lineBreak":true},{"text":"Uzanan əlini kim geri qaytara bilər?»","poem":1}]},{"type":"heading","content":["Rəbb Filiştliləri cəzalandıracaq"]},{"type":"verse","number":28,"content":["Padşah Axazın öldüyü ildə görüntü ilə nazil olan xəbərdarlıq:"]},{"type":"verse","number":29,"content":[{"text":"«Ey bütün Filiştlilər, sevinməyin ki, sizi döyən dəyənək qırıldı,","poem":1},{"lineBreak":true},{"text":"Çünki ilanın kökündən gürzə törəyəcək,","poem":1},{"lineBreak":true},{"text":"Onun törəməsi də uçan ilan olacaq.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kasıbların ən kasıbı doyacaq,","poem":1},{"lineBreak":true},{"text":"Fəqirlər rahat dincələcək.","poem":1},{"lineBreak":true},{"text":"Amma sizin kökünüzü qıtlıqla kəsəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sağ qalanlarınız da öldürüləcək.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ey darvaza, fəryad et!","poem":1},{"lineBreak":true},{"text":"Ey şəhər, ağla!","poem":1},{"lineBreak":true},{"text":"Ey bütün Filiştlilər, başdan-başa əriyin!","poem":1},{"lineBreak":true},{"text":"Çünki şimaldan tüstü gəlir,","poem":1},{"lineBreak":true},{"text":"Düşmən əsgərləri nizamı pozmadan gəlir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"O millətin elçilərinə nə cavab veriləcək?","poem":1},{"lineBreak":true},{"text":"«Rəbb Sionun təməlini qoyub,","poem":1},{"lineBreak":true},{"text":"Onun xalqının fəqirləri orada","poem":1},{"lineBreak":true},{"text":"Sığınacaq tapacaq» deyiləcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}