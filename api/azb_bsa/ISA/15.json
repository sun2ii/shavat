{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Moavın dağılması"]},{"type":"verse","number":1,"content":["Moav barədə xəbərdarlıq:",{"text":"Moavın Ar şəhəri bir gecəyə xarabalığa döndü, dağıldı,","poem":1},{"lineBreak":true},{"text":"Moavın Kir şəhəri bir gecəyə viranəliyə döndü, dağıldı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buna görə Divon xalqı ağlamaq üçün məbədə,","poem":1},{"lineBreak":true},{"text":"Səcdəgahlara çıxdı.","poem":1},{"lineBreak":true},{"text":"Moav xalqı Nevo və Medva üçün fəryad edir.","poem":1},{"lineBreak":true},{"text":"Yas tutmaq üçün hamı saçını kəsdi,","poem":1},{"lineBreak":true},{"text":"Saqqalını qırxdı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çula bürünərək küçələrdə,","poem":1},{"lineBreak":true},{"text":"Damlarda, meydanlarda hər kəs fəryad edir,","poem":1},{"lineBreak":true},{"text":"Göz yaşları sel kimi axır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xeşbon və Elale fəryad edir,","poem":1},{"lineBreak":true},{"text":"Səsləri Yahsaya qədər eşidilir.","poem":1},{"lineBreak":true},{"text":"Buna görə Moav əsgərləri nalə çəkir,","poem":1},{"lineBreak":true},{"text":"Ürəkləri qorxu içindədir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ürəyim Moav üçün kədərlənir,","poem":1},{"lineBreak":true},{"text":"Oranın qaçqınları Soara, Eqlat-Şelişiyaya doğru qaçdı.","poem":1},{"lineBreak":true},{"text":"Luxit yoxuşundan ağlayaraq çıxırlar.","poem":1},{"lineBreak":true},{"text":"Xoronayim yolunda məhv olduqları üçün ağlayırlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimrim suları quruduğu üçün ot soldu,","poem":1},{"lineBreak":true},{"text":"Bitkilər qalmadı, artıq göy-göyərti yox oldu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buna görə xalq qazandığı mal-dövlətini, yığdığı sərvətini","poem":1},{"lineBreak":true},{"text":"Söyüdlər vadisindən keçirir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xalqın ağlaşması Moav torpağını bürüyür,","poem":1},{"lineBreak":true},{"text":"Fəryadı Eqlayimədək, Beer-Elimədək çatır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki Dimon suları qanla doludur,","poem":1},{"lineBreak":true},{"text":"Amma Mən Dimonun başına daha betər bəla gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Moavdan qaçıb-qurtulanların,","poem":1},{"lineBreak":true},{"text":"Ölkədə sağ qalanların üstünə şirlər göndərəcəyəm.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}