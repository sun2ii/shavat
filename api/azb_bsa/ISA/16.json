{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Seladan səhra yolu ilə Sion dağına,","poem":1},{"lineBreak":true},{"text":"Ölkənin hökmdarına quzular göndərin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moav qızları yuvalarından atılmış,","poem":1},{"lineBreak":true},{"text":"Ora-bura uçan quşlara bənzəyir,","poem":1},{"lineBreak":true},{"text":"Onlar Arnon çayının bərələrində dolaşır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Bizə öyüd ver, ədalət göstər,","poem":1},{"lineBreak":true},{"text":"Gündüzün istisində gecə kimi üstümüzə kölgə sal,","poem":1},{"lineBreak":true},{"text":"Sürgünləri saxla, qaçqınları təslim etmə.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoy Moavdan sürgün olanlar","poem":1},{"lineBreak":true},{"text":"Səninlə birlikdə yaşasın,","poem":1},{"lineBreak":true},{"text":"Məhv edənlərə qarşı biz Moavlıların pənahı ol».","poem":1},{"lineBreak":true},{"text":"Qarət və qırğın qurtaranda,","poem":1},{"lineBreak":true},{"text":"Ölkəni ayaqları altına salanlar yox olanda,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Məhəbbət üzərində taxt qurulacaq,","poem":1},{"lineBreak":true},{"text":"Davud nəslindən bir nəfər","poem":1},{"lineBreak":true},{"text":"Sədaqətlə padşahlıq edəcək,","poem":1},{"lineBreak":true},{"text":"Hökm edərkən ədaləti axtaracaq,","poem":1},{"lineBreak":true},{"text":"Tezliklə salehliyi yerinə yetirəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moavlıların nə dərəcədə","poem":1},{"lineBreak":true},{"text":"Qürurlanıb lovğalandıqlarını,","poem":1},{"lineBreak":true},{"text":"Nə cür təkəbbürlü olduqlarını eşitdik,","poem":1},{"lineBreak":true},{"text":"Boş yerə öyünürlər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buna görə Moavlılar Moav üçün fəryad edəcək;","poem":1},{"lineBreak":true},{"text":"Hamısı fəryad edəcək,","poem":1},{"lineBreak":true},{"text":"Qir-Xaresetin kişmiş kökələrini","poem":1},{"lineBreak":true},{"text":"Yada salaraq inləyib kədərlənəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Çünki Xeşbon tarlaları,","poem":1},{"lineBreak":true},{"text":"Sivma tənəkləri qurudu.","poem":1},{"lineBreak":true},{"text":"Başqa millətlərin başçıları seçmə budaqlarını qırdı,","poem":1},{"lineBreak":true},{"text":"O budaqları ki Yazerə qədər uzanardı,","poem":1},{"lineBreak":true},{"text":"Səhraya çatırdı, şaxələnib dənizi aşırdı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buna görə Yazer ağlaşması ilə","poem":1},{"lineBreak":true},{"text":"Sivma tənəkləri üçün acı-acı ağlayıram.","poem":1},{"lineBreak":true},{"text":"Ey Xeşbon və Elale,","poem":1},{"lineBreak":true},{"text":"Çünki yay meyvələrinizin və biçininizin üzərinə","poem":1},{"lineBreak":true},{"text":"Döyüş nərəsi düşdü.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Meyvə bağlarından sevinc və fərəh götürüldü,","poem":1},{"lineBreak":true},{"text":"Üzümlüklərdə nə nəğmələr, nə də sevinc nidaları səslənir.","poem":1},{"lineBreak":true},{"text":"Üzümsıxanlardan şərab götürülməyəcək,","poem":1},{"lineBreak":true},{"text":"Onların sevinc səslərini kəsdim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buna görə ürəyim Moav üçün lira kimi inləyir,","poem":1},{"lineBreak":true},{"text":"Qəlbim Qir-Xareset üçün sızlayır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moav xalqı səcdəgahlarına çıxaraq","poem":1},{"lineBreak":true},{"text":"Boş yerə özünü yorur,","poem":1},{"lineBreak":true},{"text":"Dua etmək üçün Müqəddəs məkanına gedəcək,","poem":1},{"lineBreak":true},{"text":"Amma hər şey boş-boşunadır!","poem":1}]},{"type":"verse","number":13,"content":["Rəbbin Moav haqqında keçmişdə dediyi sözü budur."]},{"type":"verse","number":14,"content":["İndi isə Rəbb belə deyir: «Tam üç ilin ərzində Moavın şan-şöhrəti çoxsaylı xalqı ilə birgə alçaldılacaq, sağ qalanları azalıb zəifləyəcək»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}