{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Aram və İsrail haqqında peyğəmbərlik"]},{"type":"verse","number":1,"content":["Dəməşq barədə xəbərdarlıq:",{"text":"Budur, Dəməşq daha şəhər olmayacaq,","poem":1},{"lineBreak":true},{"text":"Bir yığın xarabalığa dönəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aroer şəhərləri tərk olunacaq.","poem":1},{"lineBreak":true},{"text":"Oralar sürülərin otlaq yeri olacaq,","poem":1},{"lineBreak":true},{"text":"Onları qorxudan olmayacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efrayimdə qalalı şəhər qalmayacaq,","poem":1},{"lineBreak":true},{"text":"Dəməşqin hakimiyyəti yox olacaq,","poem":1},{"lineBreak":true},{"text":"Sağ qalan Aramlıların qüvvəti","poem":1},{"lineBreak":true},{"text":"İsrail övladlarının qüvvəti tək olacaq.","poem":1},{"lineBreak":true},{"text":"Bunu Ordular Rəbbi bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O gün Yaqub nəslinin əzəməti sönəcək,","poem":1},{"lineBreak":true},{"text":"Hamısı bir dəri, bir sümük qalacaq;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Biçinçi taxılı necə biçirsə,","poem":1},{"lineBreak":true},{"text":"Başaqları əli ilə necə yığırsa,","poem":1},{"lineBreak":true},{"text":"Refaim vadisində başaqları necə toplayırsa,","poem":1},{"lineBreak":true},{"text":"Onlar da elə olacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zeytun ağacı silkələnəndən sonra","poem":1},{"lineBreak":true},{"text":"Təpəsində iki-üç zeytun qaldığı kimi,","poem":1},{"lineBreak":true},{"text":"Bəhərli budaqlarında dörd-beş zeytun qaldığı kimi","poem":1},{"lineBreak":true},{"text":"Çox az adam sağ qalacaq.","poem":1},{"lineBreak":true},{"text":"Bunu İsrailin Allahı Rəbb bəyan edir.","poem":1}]},{"type":"verse","number":7,"content":["O gün insan öz Yaradanına nəzər salacaq və gözləri İsrailin Müqəddəsini görəcək."]},{"type":"verse","number":8,"content":["Əlləri ilə yaratdığı qurbangahlara baxmayacaq, barmaqları ilə düzəltdiyi ilahə Aşeranın rəmzi olan sütunlara, buxur qurbangahlarına nəzər salmayacaq."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O gün istehkamlı şəhərləri","poem":1},{"lineBreak":true},{"text":"İsrail övladlarından qaçan Hivlilərlə Emorluların tərk etdiyi","poem":1},{"lineBreak":true},{"text":"Şəhərlərə bənzəyəcək, viran qalacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sən, ey İsrail, sənə qurtuluş verən","poem":1},{"lineBreak":true},{"text":"Allahını unutdun,","poem":1},{"lineBreak":true},{"text":"Pənahgahın olan Qayanı xatırlamadın.","poem":1},{"lineBreak":true},{"text":"Buna görə də sən əcnəbi bütlər üçün bağ əkirsən,","poem":1},{"lineBreak":true},{"text":"Özgə ağacların budaqlarından peyvənd edirsən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onları əkdiyin gün böyüdürsən,","poem":1},{"lineBreak":true},{"text":"Ertəsi gün çiçəkləndirirsən,","poem":1},{"lineBreak":true},{"text":"Amma kədərli, sağalmayan ağrılı gündə məhsul verməyəcəklər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ah, çoxsaylı xalqların gurultusu","poem":1},{"lineBreak":true},{"text":"Dənizlərin gurultusuna bənzər!","poem":1},{"lineBreak":true},{"text":"Ümmətlərin nərəsi böyük suların çağlayışına oxşar!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ümmətlərin səsi böyük suların gurultusuna bənzəyəcək,","poem":1},{"lineBreak":true},{"text":"Lakin Allah onları məzəmmət edəcək,","poem":1},{"lineBreak":true},{"text":"Onlar uzaqlara qaçacaq,","poem":1},{"lineBreak":true},{"text":"Küləyin qarşısında təpəliklərdəki saman çöpü kimi,","poem":1},{"lineBreak":true},{"text":"Qasırğanın önündə yuvarlanan küləş kimi qovulacaqlar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Axşamçağı onlar dəhşət doğururlar,","poem":1},{"lineBreak":true},{"text":"Səhər açılmadan yox olurlar.","poem":1},{"lineBreak":true},{"text":"Bizi soyanların aqibəti budur,","poem":1},{"lineBreak":true},{"text":"Bizi qarət edənlərin sonu budur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}