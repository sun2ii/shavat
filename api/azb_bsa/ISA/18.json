{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Allahın Kuşa cəza verməsi"]},{"type":"verse","number":1,"content":[{"text":"Kuş çaylarının o tərəfində yerləşən,","poem":1},{"lineBreak":true},{"text":"Qanad vızıltıları eşidilən ölkənin vay halına!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dəniz yolu ilə, qamış qayıqları ilə","poem":1},{"lineBreak":true},{"text":"Bu ölkə elçilər göndərir!","poem":1},{"lineBreak":true},{"text":"Ey sürətli qasidlər, yola düşün!","poem":1},{"lineBreak":true},{"text":"Çaylarla bölünmüş ölkəyə,","poem":1},{"lineBreak":true},{"text":"Ucaboylu, parlaq dərili millətin,","poem":1},{"lineBreak":true},{"text":"Hər yanda qorxu doğuran xalqın,","poem":1},{"lineBreak":true},{"text":"Güclü və işğalçı millətin yanına gedin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey bütün yer üzündə yaşayanlar!","poem":1},{"lineBreak":true},{"text":"Ey dünya sakinləri!","poem":1},{"lineBreak":true},{"text":"Dağların zirvəsinə bayraq dikələndə baxın!","poem":1},{"lineBreak":true},{"text":"Şeypur çalınanda eşidin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Rəbb mənə belə deyir:","poem":1},{"lineBreak":true},{"text":"«Günəş şüalarından yaranan qızmarlıq kimi,","poem":1},{"lineBreak":true},{"text":"Biçin vaxtının istisində şeh buludu kimi","poem":1},{"lineBreak":true},{"text":"Sakitcə məskənimdən baxacağam».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çiçəklənmə qurtarıb məhsul yığımından əvvəl","poem":1},{"lineBreak":true},{"text":"Üzümlər qora bağlayanda","poem":1},{"lineBreak":true},{"text":"O, bağ qayçıları ilə pöhrələri kəsəcək,","poem":1},{"lineBreak":true},{"text":"Şaxələnmiş budaqları qırıb atacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamısı dağın yırtıcı quşlarına,","poem":1},{"lineBreak":true},{"text":"Yerin vəhşi heyvanlarının qarşısına atılacaq.","poem":1},{"lineBreak":true},{"text":"Yayda yırtıcı quşlara,","poem":1},{"lineBreak":true},{"text":"Qışda bütün vəhşi heyvanlara yem olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O vaxt çaylarla bölünmüş ölkə","poem":1},{"lineBreak":true},{"text":"Ucaboylu, parlaq dərili xalq,","poem":1},{"lineBreak":true},{"text":"Hər yanda qorxu doğuran xalq","poem":1},{"lineBreak":true},{"text":"Güclü və işğalçı millət","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbinə,","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbinin adını qoyduğu yerə –","poem":1},{"lineBreak":true},{"text":"Sion dağına xərac gətirəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}