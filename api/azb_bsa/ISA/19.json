{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Allahın Misirə cəza verməsi"]},{"type":"verse","number":1,"content":["Misir barədə xəbərdarlıq:",{"text":"Budur, Rəbb sürətlə gedən buludun üstünə minib Misirə gəlir.","poem":1},{"lineBreak":true},{"text":"Misir bütləri Onun qarşısında titrəyir,","poem":1},{"lineBreak":true},{"text":"Misirlilərin ürəkləri qorxudan əriyir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Mən Misirliləri Misirlilərə qarşı qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Qardaş qardaşla, qonşu qonşu ilə,","poem":1},{"lineBreak":true},{"text":"Şəhər şəhərlə, ölkə ölkə ilə vuruşacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Misirlilərin ruhu qırılacaq, niyyətlərini boşa çıxaracağam.","poem":1},{"lineBreak":true},{"text":"Onlar bütlərdən, ölü ruhlarından, cindarlardan,","poem":1},{"lineBreak":true},{"text":"Ruhçağıranlardan məsləhət istəyəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Misirliləri qəddar bir sahibə təslim edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qüvvətli padşah üzərlərində hökm sürəcək».","poem":1},{"lineBreak":true},{"text":"Sahibimiz, Ordular Rəbbi belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nilin suları azalacaq,","poem":1},{"lineBreak":true},{"text":"Çay çəkilib quruyacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çaylar iylənəcək,","poem":1},{"lineBreak":true},{"text":"Misirin arxları boşalıb quruyacaq,","poem":1},{"lineBreak":true},{"text":"Qamışlar və qarğılar çürüyəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nil kənarında, çayın qırağındakı qarğılar,","poem":1},{"lineBreak":true},{"text":"Nil boyunca əkilmiş zəmilər quruyacaq, sovrulub yox olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Balıqçılar, Nilə tilov atanların hamısı ağlayaraq yas tutacaq,","poem":1},{"lineBreak":true},{"text":"Nilə tilov atanların hamısı ağlayacaq,","poem":1},{"lineBreak":true},{"text":"Suya tor salanlar kədərlənəcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İncə kətan üzərində işləyənlər,","poem":1},{"lineBreak":true},{"text":"Ağ bez toxuyanlar ümidlərini itirəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misirin sütunları qırılacaq,","poem":1},{"lineBreak":true},{"text":"Bütün muzdlu işçilər ruhdan düşəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Soan şəhərinin başçıları necə də axmaqdır!","poem":1},{"lineBreak":true},{"text":"Fironun hikmətli vəzirləri ağılsız məsləhətlər verir.","poem":1},{"lineBreak":true},{"text":"Onlar firona necə: «Mən müdriklərin,","poem":1},{"lineBreak":true},{"text":"Qədim padşahların nəslindənəm!» deyə bilər?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey firon, sənin hikmətli vəzirlərin indi haradadır?","poem":1},{"lineBreak":true},{"text":"Qoy sənə bildirsinlər","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Misirə qarşı nə hazırlayıb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Soan başçıları axmaq oldu,","poem":1},{"lineBreak":true},{"text":"Nof rəisləri aldandı,","poem":1},{"lineBreak":true},{"text":"Misir qəbilələrinin başçıları Misiri yoldan azdırdı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb onların ağlını çaşdırdı.","poem":1},{"lineBreak":true},{"text":"Necə ki sərxoş adam öz qusduğunun ətrafında səndələyirsə,","poem":1},{"lineBreak":true},{"text":"Misir də öz əməllərində belə dolaşır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Misirdə heç kim heç bir iş görə bilməyəcək:","poem":1},{"lineBreak":true},{"text":"Nə baş, nə quyruq və nə xurma budağı, nə də qamış.","poem":1}]},{"type":"heading","content":["Misir Rəbbə tərəf dönəcək"]},{"type":"verse","number":16,"content":["O gün Misirlilər qadına bənzəyəcək, Ordular Rəbbinin onlara qarşı qalxan əlinin önündə titrəyib dəhşətə gələcək."]},{"type":"verse","number":17,"content":["Yəhuda torpağı Misirliləri dəhşətə gətirəcək. Ordular Rəbbinin Misirə qarşı hazırladığı niyyətə görə Yəhudanın adını eşidən hər kəs vəlvələyə düşəcək."]},{"type":"verse","number":18,"content":["O gün Misirdə Kənan dilində danışan və Ordular Rəbbinin adına and içən beş şəhər olacaq. Onlardan biri Həlak şəhəri",{"noteId":7},"adlandırılacaq."]},{"type":"verse","number":19,"content":["O gün Misir ölkəsində Rəbbə qurbangah qurulacaq, sərhədində isə Ona sütun tikiləcək."]},{"type":"verse","number":20,"content":["Bu, Misir torpağında Ordular Rəbbinin əlaməti və şəhadəti olacaq. Onlar zülmkarlardan qurtulmaq üçün Rəbbə fəryad edəcək. O, Misirlilərə xilaskar və müdafiəçi göndərib onları qurtaracaq."]},{"type":"verse","number":21,"content":["Rəbb Özünü Misirlilərə tanıtdıracaq, onlar da o gün Rəbbi tanıyacaq. Misirlilər Rəbbə qurbanlar, təqdimlər gətirəcək, nəzir-niyaz edib yerinə yetirəcək."]},{"type":"verse","number":22,"content":["Rəbb Misirliləri vuracaq və sonra şəfa verəcək. Onlar Rəbbə tərəf dönəcək, yalvarışları qəbul olunacaq və Rəbb onlara şəfa verəcək."]},{"type":"verse","number":23,"content":[{"text":"O gün Misirdən Aşşura böyük yol olacaq.","poem":1},{"lineBreak":true},{"text":"Aşşurlu Misirə, Misirli Aşşura gedib-gələcək.","poem":1},{"lineBreak":true},{"text":"Misirlilərlə Aşşurlular birlikdə Rəbbə səcdə edəcək.","poem":1}]},{"type":"verse","number":24,"content":["O gün İsrail Misir və Aşşurun yanında üçüncü ölkə olacaq. Dünya bunların sayəsində xeyir-dua alacaq."]},{"type":"verse","number":25,"content":["Ordular Rəbbi onlara xeyir-dua verib deyəcək: «Xalqım Misir, yaratdığım Aşşur, irsim İsrail bərəkətli olsun»."]}],"footnotes":[{"noteId":7,"caller":"+","text":"Həlak şəhəri – ibrani dilində Günəş şəhəri mənasını verə bilər. Misirdəki Heliopolisə işarədir.","reference":{"chapter":19,"verse":18}}]},"thisChapterLink":"/api/azb_bsa/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}