{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Rəbbin dağı"]},{"type":"verse","number":1,"content":["Amots oğlu Yeşayanın Yəhuda və Yerusəlim barəsində gördükləri:"]},{"type":"verse","number":2,"content":[{"text":"Axır zamanda Rəbbin evi olan dağ","poem":1},{"lineBreak":true},{"text":"Dağların zirvəsində möhkəm duracaq,","poem":1},{"lineBreak":true},{"text":"Təpələrdən yuxarı ucalacaq.","poem":1},{"lineBreak":true},{"text":"Bütün millətlər ona sarı gələcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çox xalqlar gəlib deyəcək:","poem":1},{"lineBreak":true},{"text":"«Gəlin Rəbbin dağına,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının evinə qalxaq,","poem":1},{"lineBreak":true},{"text":"Qoy Rəbb bizə Öz yollarını öyrətsin,","poem":1},{"lineBreak":true},{"text":"Biz Onun rizləri ilə gedək».","poem":1},{"lineBreak":true},{"text":"Siondan Rəbbin təlimi,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdən Onun kəlamı yayılacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Millətlər arasında Rəbb hakim olacaq,","poem":1},{"lineBreak":true},{"text":"Çox xalqlar haqqında qərar çıxaracaq.","poem":1},{"lineBreak":true},{"text":"Onlar qılınclarından kotan,","poem":1},{"lineBreak":true},{"text":"Nizələrindən isə dəryaz düzəldəcək.","poem":1},{"lineBreak":true},{"text":"Millət millətə qarşı qılınc qaldırmayacaq,","poem":1},{"lineBreak":true},{"text":"Artıq dava etməyi öyrənməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey Yaqub nəsli, gəlin Rəbbin nurunda gəzək.","poem":1}]},{"type":"heading","content":["Rəbbin günü"]},{"type":"verse","number":6,"content":[{"text":"Ya Rəbb, xalqını – Yaqub nəslini atdın,","poem":1},{"lineBreak":true},{"text":"Çünki onlar","poem":1},{"lineBreak":true},{"text":"Şərqdən gələn mövhumatlara uymuşdular,","poem":1},{"lineBreak":true},{"text":"Filiştlilər kimi falçılıq edirlər,","poem":1},{"lineBreak":true},{"text":"Əcnəbilərin adət-ənənələrinə əməl edirlər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ölkələri qızıl-gümüşlə dolu,","poem":1},{"lineBreak":true},{"text":"Xəzinələrinin sonu yoxdur.","poem":1},{"lineBreak":true},{"text":"Ölkələrində çoxlu atlar var,","poem":1},{"lineBreak":true},{"text":"Döyüş arabaları külli miqdardadır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ölkələri bütlərlə doludur,","poem":1},{"lineBreak":true},{"text":"Əlləri ilə düzəltdikləri,","poem":1},{"lineBreak":true},{"text":"Barmaqları ilə işlədikləri","poem":1},{"lineBreak":true},{"text":"Bütlərin qarşısında səcdə qılırlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buna görə də hamı yerə səriləcək,","poem":1},{"lineBreak":true},{"text":"Hər kəs diz üstə çökdürüləcək.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, onları bağışlama!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbbin zəhmli üzündən,","poem":1},{"lineBreak":true},{"text":"Ehtişamının əzəmətindən","poem":1},{"lineBreak":true},{"text":"Qayalıqlara gedin,","poem":1},{"lineBreak":true},{"text":"Yerin altında gizlənin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adamların təkəbbürlü baxışları alçaldılacaq,","poem":1},{"lineBreak":true},{"text":"İnsanların qüruru qırılacaq,","poem":1},{"lineBreak":true},{"text":"O gün yalnız Rəbb yüksəldiləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Çünki o gün Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Bütün qürurluları, lovğaları, məğrurları alçaldacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Livanın bütün hündür və vüqarlı sidr ağaclarını məhv edəcək,","poem":1},{"lineBreak":true},{"text":"Bütün Başan palıdlarını yox edəcək.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bütün ulu dağları, hündür təpələri,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bütün yüksək qüllələri,","poem":1},{"lineBreak":true},{"text":"Qala divarlarını yerlə yeksan edəcək,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bütün Tarşiş gəmilərini,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Bütün gözəl gəmiləri yox edəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Adamların təkəbbürü qırılacaq,","poem":1},{"lineBreak":true},{"text":"İnsanların qüruru alçaldılacaq,","poem":1},{"lineBreak":true},{"text":"O gün yalnız Rəbb ucaldılacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bütlər tamamilə aradan götürüləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rəbb yeri sarsıtmağa qalxanda","poem":1},{"lineBreak":true},{"text":"Onun zəhmli üzündən, ehtişamının əzəmətindən","poem":1},{"lineBreak":true},{"text":"Hər bir insan qayalıqdakı mağaralara,","poem":1},{"lineBreak":true},{"text":"Yerin altındakı xəndəklərə qaçıb girəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O gün insanlar","poem":1},{"lineBreak":true},{"text":"Səcdə etmək üçün düzəltdikləri","poem":1},{"lineBreak":true},{"text":"Qızıl və gümüş bütlərini götürüb","poem":1},{"lineBreak":true},{"text":"Köstəbək və yarasaların","poem":1},{"lineBreak":true},{"text":"Qabağına atacaqlar ki,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbb yeri sarsıtmağa qalxarkən","poem":1},{"lineBreak":true},{"text":"Onun zəhmli üzündən, ehtişamının əzəmətindən","poem":1},{"lineBreak":true},{"text":"Qaçmaq üçün qayalıqdakı çatlaqlara,","poem":1},{"lineBreak":true},{"text":"Uçurumlardakı yarıqlara girsinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nəfəsi burunda olan insandan əl çəkin,","poem":1},{"lineBreak":true},{"text":"Onun nə dəyəri var ki?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Tarşiş gəmiləri – yaxud ticarət gəmiləri.","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/azb_bsa/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}