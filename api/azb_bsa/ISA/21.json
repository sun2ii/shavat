{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Babilin düşkünlüyü haqqında görüntü"]},{"type":"verse","number":1,"content":["Dəniz sahilindəki səhra barəsində xəbərdarlıq:",{"text":"Cənubdan necə fırtınalar gəlirsə,","poem":1},{"lineBreak":true},{"text":"Səhradan, dəhşətli ölkədən də elə bir fəlakət gəlir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dəhşətli görüntü mənə nazil oldu:","poem":1},{"lineBreak":true},{"text":"Xain xainlik edir, viranəçi viran edir.","poem":1},{"lineBreak":true},{"text":"Ey Elam, qalx! Ey Midiya, Babili mühasirəyə al!","poem":1},{"lineBreak":true},{"text":"Babilin bais olduğu bütün fəryadlara son qoyacağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gördüklərimdən belimə sancı düşdü,","poem":1},{"lineBreak":true},{"text":"Doğan qadın tək məni ağrı tutdu.","poem":1},{"lineBreak":true},{"text":"Eşitdiklərimdən sarsıldım","poem":1},{"lineBreak":true},{"text":"Gördüklərimdən məni vahimə bürüdü.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ürəyim əsir, dəhşət məni bürüyür.","poem":1},{"lineBreak":true},{"text":"Həsrətlə gözlədiyim sübh artıq məni qorxudur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gördüyüm görüntüdə süfrə hazırlayırlar,","poem":1},{"lineBreak":true},{"text":"Xalçalar sərirlər,","poem":1},{"lineBreak":true},{"text":"Yeyib-içirlər.","poem":1},{"lineBreak":true},{"text":"Qalxın, ey sərkərdələr,","poem":1},{"lineBreak":true},{"text":"Qalxanları yağlayın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xudavənd mənə belə dedi:","poem":1},{"lineBreak":true},{"text":"«Get, gözətçi təyin et,","poem":1},{"lineBreak":true},{"text":"Qoy o gördüklərini danışsın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoşa atlı döyüş arabalarına,","poem":1},{"lineBreak":true},{"text":"Atlara, eşşəklərə, dəvələrə minmiş","poem":1},{"lineBreak":true},{"text":"Adamları gördükdə çox diqqət edin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gözətçi bağırdı: «Ey Xudavənd, gözətçi qülləsində daim duraram,","poem":1},{"lineBreak":true},{"text":"Hər gecə yerimdə növbəmdə olaram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Budur, döyüş arabalarında süvarilər cüt-cüt gəlir».","poem":1},{"lineBreak":true},{"text":"Sonra o çığırdı: «Yıxıldı, Babil yıxıldı!","poem":1},{"lineBreak":true},{"text":"Onun allahlarının bütləri isə yerə düşüb parça-parça oldu».","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey xalqım, ey xırmanda buğda kimi döyülmüş xalqım!","poem":1},{"lineBreak":true},{"text":"İsrailin Allahı Ordular Rəbbindən eşitdiyimi sizə bildirmişəm.","poem":1}]},{"type":"heading","content":["Duma barəsində görüntü"]},{"type":"verse","number":11,"content":["Duma",{"noteId":8},"barəsində xəbərdarlıq:",{"text":"Bir nəfər Seirdən məni səsləyir:","poem":1},{"lineBreak":true},{"text":"«Ey gözətçi, gecənin qurtarmağına nə qədər qalıb?","poem":1},{"lineBreak":true},{"text":"Ey gözətçi, gecənin qurtarmağına nə qədər qalıb?»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gözətçi cavab verdi: «Səhərin açılmağına az qalıb,","poem":1},{"lineBreak":true},{"text":"Lakin yenə gecə gələcək.","poem":1},{"lineBreak":true},{"text":"Soruşmaq istəsəniz, yenə gəlin soruşun».","poem":1}]},{"type":"heading","content":["Ərəbistan barəsində vəhy"]},{"type":"verse","number":13,"content":["Ərəbistan barəsində xəbərdarlıq:",{"text":"Ey Dedan karvanları,","poem":1},{"lineBreak":true},{"text":"Ərəbistan meşələrində gecələyəcəksiniz!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ey Tema sakinləri,","poem":1},{"lineBreak":true},{"text":"Susamışlara su gətirin!","poem":1},{"lineBreak":true},{"text":"Qaçıb qurtulanlara çörək verin!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Çünki onlar qılıncdan,","poem":1},{"lineBreak":true},{"text":"Sıyrılmış qılıncdan,","poem":1},{"lineBreak":true},{"text":"Çəkilmiş ox-kamandan, ağır döyüşdən qaçıb.","poem":1}]},{"type":"verse","number":16,"content":["Xudavənd mənə belə dedi: «Tam bir ilin ərzində Qedarın bütün əzəməti qurtaracaq."]},{"type":"verse","number":17,"content":["Oxatanlardan, Qedar nəslinin cəngavərlərindən az qalacaq». İsrailin Allahı Rəbb belə dedi."]}],"footnotes":[{"noteId":8,"caller":"+","text":"Duma – Edomun başqa adı.","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/azb_bsa/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}