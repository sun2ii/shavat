{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Yerusəlim barəsində görüntü"]},{"type":"verse","number":1,"content":["Görüntü vadisi barəsində xəbərdarlıq:",{"text":"Ey şəhər xalqı, nə olub ki, hamınız damlara çıxmısınız?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey səs-küylü, əylənən, gurultulu şəhər,","poem":1},{"lineBreak":true},{"text":"Öldürülənləriniz nə qılıncdan keçirildi,","poem":1},{"lineBreak":true},{"text":"Nə də döyüşlərdə öldürüldü.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Başçılarınız birlikdə qaçdı,","poem":1},{"lineBreak":true},{"text":"Onlar kamanlarından ox atmamış yaxalandı.","poem":1},{"lineBreak":true},{"text":"Uzaqlara qaçdıqlarına baxmayaraq hamısı birgə yaxalandı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buna görə mən belə dedim:","poem":1},{"lineBreak":true},{"text":"«Məni tənha qoyun, qoy acı-acı ağlayım,","poem":1},{"lineBreak":true},{"text":"Əziz xalqım məğlub olduğuna görə","poem":1},{"lineBreak":true},{"text":"Mənə təsəlli verməyə cəhd göstərməyin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Çünki Ordular Rəbbi Xudavəndin","poem":1},{"lineBreak":true},{"text":"Görüntü vadisində təlaş, basqın və çaşqınlıq günü var.","poem":1},{"lineBreak":true},{"text":"Divarların dağıdılması və fəryadın dağlara çatdığı gün gəlir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Elamlılar oxdanlarını tutub adamlarla dolu döyüş arabaları ilə, süvariləri ilə gəldilər.","poem":1},{"lineBreak":true},{"text":"Kir sakinləri qalxanlarını açdılar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ən gözəl vadilərin döyüş arabaları ilə doludur,","poem":1},{"lineBreak":true},{"text":"Süvarilər şəhər darvazalarının qarşısına düzüldülər.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yəhudanın istehkamları deşik-deşik oldu,","poem":1},{"lineBreak":true},{"text":"O gün siz «Meşə» adlı evdə saxlanılan silaha nəzər saldınız.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Davudun şəhərinin divarlarında çoxlu dəlik-deşik əmələ gəldiyini gördünüz,","poem":1},{"lineBreak":true},{"text":"Aşağı hovuza su yığdınız.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yerusəlimdəki evləri saydınız,","poem":1},{"lineBreak":true},{"text":"Şəhər divarının təmiri üçün evləri sökdünüz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Köhnə hovuzun suları üçün","poem":1},{"lineBreak":true},{"text":"İki divar arasında su anbarı düzəltdiniz.","poem":1},{"lineBreak":true},{"text":"Lakin bu işi Görənə baxmadınız,","poem":1},{"lineBreak":true},{"text":"Bunu çoxdan hazırlayan Allaha nəzər salmadınız.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O gün Ordular Rəbbi Xudavənd sizi ağlaşmağa,","poem":1},{"lineBreak":true},{"text":"Yas tutmağa, saçınızı yolmağa, çula bürünməyə çağırdı.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fəqət bunun əvəzinə siz sevinc və şadlıq tapdınız,","poem":1},{"lineBreak":true},{"text":"«Qoy yeyib-içək, çünki sabah öləcəyik!» dediniz,","poem":1},{"lineBreak":true},{"text":"Cöngə, qoyun kəsdiniz, ət yediniz, şərab içdiniz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi bunu mənə açdı:","poem":1},{"lineBreak":true},{"text":"«Bu günah sizə ölənə qədər əsla bağışlanmaz!»","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Xudavənd belə buyurur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ordular Rəbbi Xudavənd belə dedi:","poem":1},{"lineBreak":true},{"text":"Dur, saray rəisi Şevnanın yanına get və de:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Sənin burada nə işin var?","poem":1},{"lineBreak":true},{"text":"Kim icazə verib ki,","poem":1},{"lineBreak":true},{"text":"Burada – yüksəkdə özün üçün məzar qazasan,","poem":1},{"lineBreak":true},{"text":"Qayanın içində özünə sərdabə düzəldəsən?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ey güclü kişi, bax Rəbb səni var-qüvvə ilə atıb-tutacaq,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Top kimi yuvarlayacaq,","poem":1},{"lineBreak":true},{"text":"Gen-bol ölkəyə atacaq.","poem":1},{"lineBreak":true},{"text":"Orada öləcəksən və öyündüyün arabaların orada qalacaq,","poem":1},{"lineBreak":true},{"text":"Axı öz ağanın evini biabır edən sənsən!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Səni vəzifəndən atacağam,","poem":1},{"lineBreak":true},{"text":"Tutduğun yerindən qovacağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"O gün qulum Xilqiya oğlu Elyaqimi çağırıb","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sənin geyimini ona geyindirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sənin qurşağını onun belinə bağlayacağam,","poem":1},{"lineBreak":true},{"text":"Səlahiyyətini onun ixtiyarına verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bu adam Yerusəlim sakinlərinə,","poem":1},{"lineBreak":true},{"text":"Yəhuda xalqına ata olacaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Davud nəslinin açarını onun çiynindən asacağam,","poem":1},{"lineBreak":true},{"text":"Açdığını heç kim bağlaya bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Bağladığını heç kim aça bilməyəcək.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mən onu paya kimi bərk yerə vuracağam.","poem":1},{"lineBreak":true},{"text":"O, nəsli üçün fəxr olacaq.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bütün nəslinin şöhrəti onun üzərində olacaq.","poem":1},{"lineBreak":true},{"text":"Nəslin və övladların şərəfi –","poem":1},{"lineBreak":true},{"text":"Taslardan tabaqlaradək","poem":1},{"lineBreak":true},{"text":"Bütün qab-qacaqların şöhrəti","poem":1},{"lineBreak":true},{"text":"Onun üzərində olacaq».","poem":1}]},{"type":"verse","number":25,"content":["Ordular Rəbbi bəyan edir: «O gün bərk yerə vurulmuş paya qırılıb-düşəcək, onun üstünə asılan yük də yox olacaq». Çünki Rəbb belə söylədi."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}