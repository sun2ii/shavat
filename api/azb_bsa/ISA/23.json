{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Sur şəhəri barəsində görüntü"]},{"type":"verse","number":1,"content":["Sur barəsində xəbərdarlıq:",{"text":"Ey Tarşiş gəmiləri, fəryad edin,","poem":1},{"lineBreak":true},{"text":"Çünki Sur şəhəri evləri ilə, limanları ilə birlikdə dağıldı,","poem":1},{"lineBreak":true},{"text":"Kittim torpağından onlara xəbər gəldi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ey sahil sakinləri, dənizçilərin sayəsində varlanan Sidon tacirləri, susun!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Şixorun taxılı, Nilin məhsulu","poem":1},{"lineBreak":true},{"text":"Dəniz yolundan gələn gəliriniz idi.","poem":1},{"lineBreak":true},{"text":"Bütün şəhər millətlərin alver yeri idi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Utan, ey Sidon, dəniz sahilində yerləşən qala!","poem":1},{"lineBreak":true},{"text":"Çünki dəniz belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən heç doğuş ağrısı çəkmədim, doğmadım,","poem":1},{"lineBreak":true},{"text":"Nə oğlanlar yetişdirdim, nə də qızlar böyütdüm».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sur haqqında xəbər Misirə çatanda","poem":1},{"lineBreak":true},{"text":"Misirlilərin ürəkləri üzüləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey sahil sakinləri, Tarşişə doğru gedin, fəryad edin!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uzaq ölkələri müstəmləkə etmiş,","poem":1},{"lineBreak":true},{"text":"Əylənib keflənən sakinləri olan","poem":1},{"lineBreak":true},{"text":"Qədim şəhər bu imiş?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Taclar geyindirən Sura qarşı","poem":1},{"lineBreak":true},{"text":"Bunları kim hazırladı?","poem":1},{"lineBreak":true},{"text":"Axı bu şəhərin tacirləri şahzadə idi,","poem":1},{"lineBreak":true},{"text":"Ticarətçiləri dünyanın ən hörmətli adamları idi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi bunu hazırladı ki,","poem":1},{"lineBreak":true},{"text":"Hər cür gözəlliyin qürurunu qırsın,","poem":1},{"lineBreak":true},{"text":"Yer üzünün hörmətli adamlarını utandırsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ey Tarşiş qızı, öz torpaqlarından Nil kimi keç,","poem":1},{"lineBreak":true},{"text":"Artıq maneçilik yoxdur.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb dənizin üzərinə əlini uzatdı,","poem":1},{"lineBreak":true},{"text":"Padşahlıqları titrətdi,","poem":1},{"lineBreak":true},{"text":"Kənanın istehkamlarının dağılması haqqında əmr verdi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onda Rəbb dedi:","poem":1},{"lineBreak":true},{"text":"«Ey zorlanmış bakirə Sidon qızı,","poem":1},{"lineBreak":true},{"text":"Sən bir daha sevinməyəcəksən!","poem":1},{"lineBreak":true},{"text":"Qalx, Kittimə yollan,","poem":1},{"lineBreak":true},{"text":"Amma orada da canına rahatlıq tapmayacaqsan».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xaldey ölkəsinə bax!","poem":1},{"lineBreak":true},{"text":"O xalq artıq yoxdur.","poem":1},{"lineBreak":true},{"text":"Aşşurlular o ölkəni","poem":1},{"lineBreak":true},{"text":"Vəhşi heyvanların məskəninə döndərdi.","poem":1},{"lineBreak":true},{"text":"Onlar hücum etmək üçün qüllələri tikdi,","poem":1},{"lineBreak":true},{"text":"Sarayları dağıtdılar,","poem":1},{"lineBreak":true},{"text":"Bu diyarı viranəliyə çevirdi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fəryad edin, ey Tarşiş gəmiləri,","poem":1},{"lineBreak":true},{"text":"Çünki istehkamınız dağılıb.","poem":1}]},{"type":"verse","number":15,"content":["Bundan sonra Sur şəhəri yetmiş il ərzində bir padşahın ömrü qədər unudulacaq. Yetmiş il keçdikdən sonra Surun da başına fahişə qadın üçün bəstələdiyi nəğmədəki kimi belə gələcək:"]},{"type":"verse","number":16,"content":[{"text":"«Ey unudulmuş fahişə,","poem":1},{"lineBreak":true},{"text":"Əlinə bir lira al, şəhəri dolan!","poem":1},{"lineBreak":true},{"text":"Gözəl havalar çal, çoxlu nəğmələr oxu,","poem":1},{"lineBreak":true},{"text":"Qoy səni yada salsınlar!»","poem":1}]},{"type":"verse","number":17,"content":["Yetmişinci ilin sonunda Rəbb Sur şəhərini yada salacaq. Bu şəhər yenə də ticarətə başlayacaq. Dünyanın bütün padşahlıqları ilə fahişəlik edəcək."]},{"type":"verse","number":18,"content":["Amma Surun ticarətdən gələn gəliri Rəbbə həsr olunacaq. Ticarətdən qazanılmış pullar xəzinələrə qoyulmayacaq, gizlədilməyəcək. Bu gəlir Rəbbin hüzurunda gəzən adamların yeməyini və gözəl geyimini təmin edəcək."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}