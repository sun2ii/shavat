{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Rəbbin dünyaya verəcəyi cəza"]},{"type":"verse","number":1,"content":[{"text":"Budur, Rəbb yer üzünü boş qoyub xarabalığa çevirəcək,","poem":1},{"lineBreak":true},{"text":"Dünyanı alt-üst edəcək,","poem":1},{"lineBreak":true},{"text":"Sakinlərini dağıdacaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nə xalqla kahin arasında,","poem":1},{"lineBreak":true},{"text":"Nə nökərlə ağası arasında,","poem":1},{"lineBreak":true},{"text":"Nə qarabaşla xanımı arasında,","poem":1},{"lineBreak":true},{"text":"Nə alıcı ilə satıcı arasında,","poem":1},{"lineBreak":true},{"text":"Nə borc verənlə borc alan arasında","poem":1},{"lineBreak":true},{"text":"Nə də sələmçi ilə borc alan arasında","poem":1},{"lineBreak":true},{"text":"Heç bir fərq qoyulmayacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yer üzü tamamilə boş qalıb xarabalığa çevriləcək.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb bu sözü söylədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dünya saralıb-solur,","poem":1},{"lineBreak":true},{"text":"Yer üzü quruyub-solur.","poem":1},{"lineBreak":true},{"text":"Dünyanın məğrur insanları məyus olur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dünyanı sakinləri murdar etdi,","poem":1},{"lineBreak":true},{"text":"Çünki Allahın qanunlarını tapdaladı,","poem":1},{"lineBreak":true},{"text":"Qaydalarına xor baxdı,","poem":1},{"lineBreak":true},{"text":"Əbədi əhdi pozdu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu səbəbə görə","poem":1},{"lineBreak":true},{"text":"Lənət yer üzünü məhv edir.","poem":1},{"lineBreak":true},{"text":"Yer üzünün sakinləri","poem":1},{"lineBreak":true},{"text":"Günahlarının cəzasını çəkir,","poem":1},{"lineBreak":true},{"text":"Buna görə yanır,","poem":1},{"lineBreak":true},{"text":"Çox az adam sağ qalacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Təzə şərab qurtarır, meynələr solur,","poem":1},{"lineBreak":true},{"text":"Nə vaxtsa fərəhlənən adamlar kədərlənir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dəflərin şən səsi kəsilib,","poem":1},{"lineBreak":true},{"text":"Sevinc nidası eşidilmir,","poem":1},{"lineBreak":true},{"text":"Liraların avazı gəlmir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bir daha nəğmə oxuyub şərab içmirlər,","poem":1},{"lineBreak":true},{"text":"İçkinin dadı içənə acı gəlir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Viran qalmış şəhər xaraba qalıb,","poem":1},{"lineBreak":true},{"text":"Bütün evlər qıfıllanıb,","poem":1},{"lineBreak":true},{"text":"Heç kim ora girə bilmir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Şərab çatmamazlığına görə küçələrdə qışqırırlar,","poem":1},{"lineBreak":true},{"text":"Fərəhdən əsər-əlamət qalmadı.","poem":1},{"lineBreak":true},{"text":"Dünyanın sevinci əsir aparıldı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Şəhər viranə qaldı,","poem":1},{"lineBreak":true},{"text":"Darvazaları darmadağın oldu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zeytun ağacından zeytunları tökmək üçün ağacı silkələyib döyəndə necə olursa,","poem":1},{"lineBreak":true},{"text":"Üzüm məhsulu yığılandan sonra qalan salxımlar necə olursa,","poem":1},{"lineBreak":true},{"text":"Dünyadakı xalqlar da elə olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sağ qalanlar səslərini ucaldıb","poem":1},{"lineBreak":true},{"text":"Sevinc ilahiləri söyləyəcək,","poem":1},{"lineBreak":true},{"text":"Qərbdə yaşayanlar Rəbbin əzəmətindən nəql edəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Beləliklə, şərqdə yaşayanlar Rəbbi ucaldacaq,","poem":1},{"lineBreak":true},{"text":"Uzaq diyarların sakinləri İsrailin Allahı Rəbbin adını yüksəldəcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dünyanın ən uzaq guşələrindən tərənnüm ilahisi eşidirik:","poem":1},{"lineBreak":true},{"text":"«Saleh Olana izzət olsun!»","poem":1},{"lineBreak":true},{"text":"Amma mən dedim: «Ölürəm, ölürəm! Vay halıma!","poem":1},{"lineBreak":true},{"text":"Xainlər xainliklərini davam edir,","poem":1},{"lineBreak":true},{"text":"Bəli, xainlər xaincəsinə hərəkət edir!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ey dünya sakinləri,","poem":1},{"lineBreak":true},{"text":"Qarşınıza dəhşət, dərin çuxur və tələ çıxacaq!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dəhşətdən qaçan dərin çuxura düşəcək,","poem":1},{"lineBreak":true},{"text":"Dərin çuxurdan çıxa bilən tələyə düşəcək.","poem":1},{"lineBreak":true},{"text":"Göylərin pəncərələri açılacaq,","poem":1},{"lineBreak":true},{"text":"Dünyanın təməlləri sarsılacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yer üzü çatlayacaq, çatlayacaq,","poem":1},{"lineBreak":true},{"text":"Dünya yarılacaq, yarılacaq,","poem":1},{"lineBreak":true},{"text":"Dünya lərzəyə gələcək, lərzəyə gələcək!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dünya sərxoş kimi yırğalanacaq,","poem":1},{"lineBreak":true},{"text":"Külək əsəndə talvar kimi silkələnəcək,","poem":1},{"lineBreak":true},{"text":"Qanunsuzluğun ağırlığı altında yerə yatacaq,","poem":1},{"lineBreak":true},{"text":"Bir daha qalxa bilməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"O gün Rəbb yuxarıda – göydəki orduları,","poem":1},{"lineBreak":true},{"text":"Aşağıda – yer üzünün padşahlarını cəzalandıracaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onlar yeraltı zindana dustaq kimi yığılacaq,","poem":1},{"lineBreak":true},{"text":"Həbsxanada bağlı saxlanacaq,","poem":1},{"lineBreak":true},{"text":"Uzun müddət keçəndən sonra cəzalanacaq.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ay qaralacaq, günəş işıq saçmayacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Ordular Rəbbi Sion dağında,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə hökm sürəcək.","poem":1},{"lineBreak":true},{"text":"Xalqın başçıları Onun əzəmətini görəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}