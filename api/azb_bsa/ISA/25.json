{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Sevinc ilahisi"]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Sən mənim Allahımsan,","poem":1},{"lineBreak":true},{"text":"Səni ucaldıram, adına həmdlər oxuyuram.","poem":1},{"lineBreak":true},{"text":"Çünki Sən qədimdən bəri möcüzələrini, niyyətlərini","poem":1},{"lineBreak":true},{"text":"Sədaqətlə həyata keçirdin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki Sən şəhəri bir daş yığınına,","poem":1},{"lineBreak":true},{"text":"İstehkamlı şəhəri xarabalığa döndərdin.","poem":1},{"lineBreak":true},{"text":"O şəhər yadellilərin qalası idi,","poem":1},{"lineBreak":true},{"text":"Ondan əsər-əlamət qalmadı,","poem":1},{"lineBreak":true},{"text":"O bir daha bərpa olunmaz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buna görə qüvvətli xalqlar Səni izzətləndirəcək.","poem":1},{"lineBreak":true},{"text":"Qəddar millətlərə mənsub şəhərlər Səndən qorxacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Sən yoxsula sığınacaq,","poem":1},{"lineBreak":true},{"text":"Sıxıntı içində olan fəqirə pənahgah,","poem":1},{"lineBreak":true},{"text":"Fırtına vaxtı çardaq,","poem":1},{"lineBreak":true},{"text":"İstilik vaxtı kölgəlik oldun.","poem":1},{"lineBreak":true},{"text":"Qəddarların nəfəsi divara çarpan fırtına kimidir,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quraqlıqda bürkü kimidir.","poem":1},{"lineBreak":true},{"text":"Lakin Sən, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Zülmkarların azğınlığını bulud bürkünün qarşısını alan kimi aldın,","poem":1},{"lineBreak":true},{"text":"Amansız yağıların nəğmə səslərini kəsdin.","poem":1}]},{"type":"heading","content":["Rəbbin hazırladığı ziyafət"]},{"type":"verse","number":6,"content":[{"text":"Bu dağda Ordular Rəbbi bütün xalqlar üçün","poem":1},{"lineBreak":true},{"text":"Zəngin yeməklərdən, gözəl şərablardan ibarət ziyafət düzəldəcək,","poem":1},{"lineBreak":true},{"text":"Orada ən ləziz yeməklər, ən dadlı şərablar olacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu dağda bütün xalqların üzərindəki duvağı,","poem":1},{"lineBreak":true},{"text":"Bütün millətlərin üstündə olan toxunma örtüyü götürəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ölümü əbədi olaraq yox edəcək,","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb bütün adamların üzündən göz yaşlarını siləcək,","poem":1},{"lineBreak":true},{"text":"Bütün yer üzündən xalqının rüsvayçılığını götürəcək.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb belə söylədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O gün deyəcəklər:","poem":1},{"lineBreak":true},{"text":"«Budur bizim Allahımız!","poem":1},{"lineBreak":true},{"text":"Ona etibar etdik, O bizi qurtardı,","poem":1},{"lineBreak":true},{"text":"Rəbb Odur, biz Ona ümid etdik.","poem":1},{"lineBreak":true},{"text":"İndi isə O bizi qurtardığına görə","poem":1},{"lineBreak":true},{"text":"Sevinib şadlanaq!»","poem":1}]},{"type":"heading","content":["Allahın Moava verdiyi cəza"]},{"type":"verse","number":10,"content":[{"text":"Rəbbin əli bu dağın üstündə olacaq,","poem":1},{"lineBreak":true},{"text":"Amma Moav peyinliyə düşən saman kimi tapdaq altında qalacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Üzgüçü üzərkən əl-qol atdığı kimi","poem":1},{"lineBreak":true},{"text":"Moav peyinlikdə əl-qol atacaq,","poem":1},{"lineBreak":true},{"text":"Amma Allah Moavın qürurunu əllərinin məharəti ilə alçaldacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O, Moavın istehkamlarını,","poem":1},{"lineBreak":true},{"text":"Yüksək divarlarını yerə endirəcək,","poem":1},{"lineBreak":true},{"text":"Dağıdıb yerlə yeksan edəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}