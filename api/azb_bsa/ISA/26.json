{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Həmd ilahisi"]},{"type":"verse","number":1,"content":["O gün Yəhuda diyarında belə ilahi oxunacaq:",{"text":"«Qüvvətli şəhərimiz var,","poem":1},{"lineBreak":true},{"text":"Allahın qurtuluşu şəhər üçün divarlar, səngərlər kimidir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Açın şəhərin darvazalarını,","poem":1},{"lineBreak":true},{"text":"Qoy sadiq qalan saleh millət içəri girsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ağlı Sənə yönəlmiş adamlara","poem":1},{"lineBreak":true},{"text":"Sən kamil sülh verirsən,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Sənə güvənir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbbə həmişə güvənin,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb Allah əbədi Qayadır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O, yuxarıdan gedənləri alçaldar,","poem":1},{"lineBreak":true},{"text":"Onların yaşadığı şəhəri dağıdar,","poem":1},{"lineBreak":true},{"text":"Yerlə yeksan edər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O şəhər məzlumların ayaqları,","poem":1},{"lineBreak":true},{"text":"Yoxsulların addımları altında tapdalanacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saleh adamın yolu düzdür.","poem":1},{"lineBreak":true},{"text":"Ey Düz Olan, saleh adamın yolunu Sən düz edirsən.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Həqiqətən, ya Rəbb, Sənin hökmlərinin yolunda biz Sənə ümid bağlayırıq,","poem":1},{"lineBreak":true},{"text":"Sənin adın, ismin ürəyimizin istəyidir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qəlbim gecələr Sənin üçün həsrət çəkər,","poem":1},{"lineBreak":true},{"text":"Bəli, ruhum daxilimdə Səni arayar.","poem":1},{"lineBreak":true},{"text":"Hökmlərin yer üzündə həyata keçdikcə","poem":1},{"lineBreak":true},{"text":"Dünyanın sakinləri doğruluğu öyrənir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pis adama rəhm etsələr də,","poem":1},{"lineBreak":true},{"text":"O, doğruluğu öyrənməz,","poem":1},{"lineBreak":true},{"text":"Doğruluq hökm sürən ölkədə də haqsızlıq edər,","poem":1},{"lineBreak":true},{"text":"Rəbbin əzəmətini görməz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ya Rəbb, əlini qaldırdın,","poem":1},{"lineBreak":true},{"text":"Amma pis adamlar bunu görmür.","poem":1},{"lineBreak":true},{"text":"Öz xalqın üçün göstərdiyin qeyrəti görüb utansınlar.","poem":1},{"lineBreak":true},{"text":"Bəli, düşmənlərin üçün yağdırdığın od onları məhv edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ya Rəbb, bizə sülh verən Sənsən,","poem":1},{"lineBreak":true},{"text":"Bütün işlərimizi Sən bizim üçün tənzimləyirsən.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey Allahımız Rəbb,","poem":1},{"lineBreak":true},{"text":"Səndən savayı başqa ağalar üzərimizdə hökm sürürdü,","poem":1},{"lineBreak":true},{"text":"Lakin biz yalnız Sənin adını tanıyırıq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O ağalar öldü, artıq yaşamır,","poem":1},{"lineBreak":true},{"text":"Onlar kölgə kimidir, dirilməyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki Sən onları cəzalandırıb məhv etdin,","poem":1},{"lineBreak":true},{"text":"Onlar haqqında hər bir xatirəni yox etdin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakin Sən bu milləti çoxaltdın, ya Rəbb!","poem":1},{"lineBreak":true},{"text":"Bəli, milləti çoxaltdın,","poem":1},{"lineBreak":true},{"text":"Özünü izzətləndirdin.","poem":1},{"lineBreak":true},{"text":"Hər tərəfə ölkənin sərhədlərini genişləndirdin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ya Rəbb, onlar bəlaya düşəndə Səni axtardı.","poem":1},{"lineBreak":true},{"text":"Sənin cəzan üzərlərində olanda","poem":1},{"lineBreak":true},{"text":"Sənə dua edib yalvardı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hamilə qadın doğuş vaxtı gələndə","poem":1},{"lineBreak":true},{"text":"Ağrı çəkib qovrularaq necə qışqırırsa,","poem":1},{"lineBreak":true},{"text":"Biz də Sənin qarşında elə idik, ya Rəbb!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Biz də sanki hamilə idik, ağrı çəkirdik,","poem":1},{"lineBreak":true},{"text":"Lakin küləkdən başqa bir şey doğmadıq.","poem":1},{"lineBreak":true},{"text":"Nə dünyaya qurtuluş gətirə bildik,","poem":1},{"lineBreak":true},{"text":"Nə də dünya sakinlərini həyata qovuşdurduq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sənin ölənlərin həyata qovuşacaq, meyitimlə birgə diriləcəklər.","poem":1},{"lineBreak":true},{"text":"Ey torpaq altında yatanlar, oyanın,","poem":1},{"lineBreak":true},{"text":"Sevinc nəğməsini oxuyun,","poem":1},{"lineBreak":true},{"text":"Çünki şeh torpağı necə təravətləndirirsə,","poem":1},{"lineBreak":true},{"text":"Rəbb də torpaqdakı ölüləri belə dirçəldəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ey xalqım, keç içəri otaqlara,","poem":1},{"lineBreak":true},{"text":"Qapıları ört,","poem":1},{"lineBreak":true},{"text":"Rəbbin qeyzi keçənəcən","poem":1},{"lineBreak":true},{"text":"Qısa bir müddətə gizlən!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki budur, Rəbb yer üzünün sakinlərini","poem":1},{"lineBreak":true},{"text":"Qəbahətləri üzündən cəzalandırmaq üçün","poem":1},{"lineBreak":true},{"text":"Öz məskənindən gəlir.","poem":1},{"lineBreak":true},{"text":"Torpaq udduğu qanı üzə çıxaracaq,","poem":1},{"lineBreak":true},{"text":"Öldürülənləri artıq gizlətməyəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}