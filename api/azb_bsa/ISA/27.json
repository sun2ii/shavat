{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["İsrailin qurtuluşu"]},{"type":"verse","number":1,"content":[{"text":"O gün Rəbb Livyatana,","poem":1},{"noteId":9},{"text":"qaçan ilana,","poem":1},{"lineBreak":true},{"text":"Bəli, Livyatana, qıvrılan ilana","poem":1},{"lineBreak":true},{"text":"Amansız, nəhəng və qüvvətli qılıncı ilə cəza verəcək,","poem":1},{"lineBreak":true},{"text":"Dənizdəki əjdahanı öldürəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O gün Rəbb deyəcək:","poem":1},{"lineBreak":true},{"text":"«Xoşladığım bağ üçün nəğmələr oxuyun!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mən Rəbb, bağı qoruyuram,","poem":1},{"lineBreak":true},{"text":"Tez-tez sulayıram,","poem":1},{"lineBreak":true},{"text":"Gecə-gündüz keşiyində dururam ki,","poem":1},{"lineBreak":true},{"text":"Heç kəs ona zərər verməsin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mən qəzəblənmirəm,","poem":1},{"lineBreak":true},{"text":"Kaş qarşıma tikan və qanqal çıxaydı,","poem":1},{"lineBreak":true},{"text":"Onda onlara qarşı çıxıb döyüşərdim,","poem":1},{"lineBreak":true},{"text":"Hamısını odda yandırardım.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaxud qoy Mənə pənah gətirsinlər,","poem":1},{"lineBreak":true},{"text":"Mənimlə barışsınlar,","poem":1},{"lineBreak":true},{"text":"Bəli, qoy Mənimlə barışsınlar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaqub nəsli gələcəkdə kök salacaq,","poem":1},{"lineBreak":true},{"text":"İsrail şaxələnəcək, çiçəklənəcək,","poem":1},{"lineBreak":true},{"text":"Yer üzünü bəhrələri ilə dolduracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbb İsraili vuran düşmənləri kimi onu vurdumu?","poem":1},{"lineBreak":true},{"text":"Yaxud O, başqalarını öldürdüyü kimi İsraili də öldürdümü?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb Öz xalqına hökm etdi,","poem":1},{"lineBreak":true},{"text":"Qovub sürgünə göndərdi.","poem":1},{"lineBreak":true},{"text":"Şərq küləyi əsən gün Rəbb onları şiddətli yeli ilə qovdu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaqub nəslinin qəbahəti bununla bağışlanacaq,","poem":1},{"lineBreak":true},{"text":"Günahın aradan götürülməsinin tam bəhrəsi bu olacaq:","poem":1},{"lineBreak":true},{"text":"Bütpərəst qurbangahların daşları","poem":1},{"lineBreak":true},{"text":"Tabaşir kimi ovulacaq,","poem":1},{"lineBreak":true},{"text":"İlahə Aşeranın rəmzi olan sütunlar","poem":1},{"lineBreak":true},{"text":"Ya da buxur qurbangahları","poem":1},{"lineBreak":true},{"text":"Bir daha dikəlməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"İstehkamlı şəhər tənha, kimsəsiz yurd,","poem":1},{"lineBreak":true},{"text":"Səhra kimi boş qaldı.","poem":1},{"lineBreak":true},{"text":"Orada dana otlayıb yatacaq,","poem":1},{"lineBreak":true},{"text":"Budaqları yeyib-qurtaracaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Şaxələri quruyanda qoparılacaq,","poem":1},{"lineBreak":true},{"text":"Qadınlar gəlib onları yandıracaq.","poem":1},{"lineBreak":true},{"text":"Bu xalq ağılsız olduğuna görə","poem":1},{"lineBreak":true},{"text":"Yaradan onlara rəhm etməyəcək,","poem":1},{"lineBreak":true},{"text":"Xaliq onlara qarşı xeyirxah olmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O gün Rəbb Fərat çayından","poem":1},{"lineBreak":true},{"text":"Misir vadisinə qədər","poem":1},{"lineBreak":true},{"text":"Öz bəhrələrini yığacaq.","poem":1},{"lineBreak":true},{"text":"Siz bir-bir toplanacaqsınız, ey İsrail övladları!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O gün böyük şeypur çalınacaq,","poem":1},{"lineBreak":true},{"text":"Aşşur torpağında itkin düşənlərlə","poem":1},{"lineBreak":true},{"text":"Misirə sürgün edilənlər gəlib","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə Müqəddəs dağda","poem":1},{"lineBreak":true},{"text":"Rəbbə səcdə edəcək.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Livyatan – bu gün bizə məlum olmayan nəhəng su heyvanı, şər rəmzi.","reference":{"chapter":27,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}