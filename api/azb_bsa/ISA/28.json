{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Şimal padşahlığına xəbərdarlıq"]},{"type":"verse","number":1,"content":[{"text":"Məhsuldar vadinin başında yerləşən,","poem":1},{"lineBreak":true},{"text":"Şəraba uymuşların şəhərinin –","poem":1},{"lineBreak":true},{"text":"Efrayim sərxoşlarının qürurlu tacının,","poem":1},{"lineBreak":true},{"text":"İzzətli gözəlliyin və solan çiçəyin vay halına!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Budur, Rəbbin güclü, qüvvətli bir adamı var.","poem":1},{"lineBreak":true},{"text":"O, bərk yağan dolu,","poem":1},{"lineBreak":true},{"text":"Bəla gətirən fırtına kimi,","poem":1},{"lineBreak":true},{"text":"Hər şeyi yolunda məhv edən sel kimi gəlir,","poem":1},{"lineBreak":true},{"text":"Əlləri ilə şəhəri yerlə yeksan edəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efrayim sərxoşlarının şəhəri, qürur tacı","poem":1},{"lineBreak":true},{"text":"Ayaq altında tapdalanacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məhsuldar vadinin başında yerləşən şəhər,","poem":1},{"lineBreak":true},{"text":"İzzətli və gözəl tac,","poem":1},{"lineBreak":true},{"text":"Artıq solan çiçəyi xatırladan şəhər,","poem":1},{"lineBreak":true},{"text":"Vaxtından əvvəl yetişən əncir kimi olacaq.","poem":1},{"lineBreak":true},{"text":"Onu görən tez dərib yeyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O gün Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Sağ qalan xalqı üçün","poem":1},{"lineBreak":true},{"text":"Gözəllik tacı, izzət çələngi olacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hökm kürsüsündə oturana ədalət ruhu,","poem":1},{"lineBreak":true},{"text":"Şəhər darvazalarını müdafiə edənlərə qüdrət verəcək.","poem":1}]},{"type":"heading","content":["Yeşaya sərxoş peyğəmbərlərə xəbərdarlıq edir"]},{"type":"verse","number":7,"content":[{"text":"Kahinlər və peyğəmbərlər də şərabdan səndələyir,","poem":1},{"lineBreak":true},{"text":"İçkidən büdrəyir,","poem":1},{"lineBreak":true},{"text":"Şərab içib xumarlanıb,","poem":1},{"lineBreak":true},{"text":"İçkidən yollarını azıb.","poem":1},{"lineBreak":true},{"text":"Onlar yanlış görüntülər görür,","poem":1},{"lineBreak":true},{"text":"Tutarsız qərarlar qəbul edir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütün süfrələri qusmaq və natəmizliklə doludur,","poem":1},{"lineBreak":true},{"text":"Bulanmamış yer yoxdur!","poem":1}]},{"type":"heading","content":["Yeşayaya edilən istehza"]},{"type":"verse","number":9,"content":[{"text":"«Bu adam kimi öyrədir? Kimə öyüd verir?","poem":1},{"lineBreak":true},{"text":"Süddən kəsilmiş, ana döşündən ayrılmış körpə uşaqlaramı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bu nədir?","poem":1},{"lineBreak":true},{"text":"Əmr üstünə əmr, əmr üstünə əmr,","poem":1},{"lineBreak":true},{"text":"Sətir üstünə sətir, sətir üstünə sətir,","poem":1},{"lineBreak":true},{"text":"Bir az oradan, bir az buradan».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Onda Rəbb bu xalqla","poem":1},{"lineBreak":true},{"text":"Yadellilərin ağzı ilə,","poem":1},{"lineBreak":true},{"text":"Başqa dildə danışacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O sizin hamınıza dedi:","poem":1},{"lineBreak":true},{"text":"«Rahatlıq budur,","poem":1},{"lineBreak":true},{"text":"Yorğunlara dinclik verin, budur istirahət».","poem":1},{"lineBreak":true},{"text":"Amma onlar eşitmək istəmədilər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbbin sözü onlar üçün","poem":1},{"lineBreak":true},{"text":"«Əmr üstünə əmr, əmr üstünə əmr,","poem":1},{"lineBreak":true},{"text":"Sətir üstünə sətir, sətir üstünə sətir,","poem":1},{"lineBreak":true},{"text":"Bir az oradan, bir az buradan» olacaq ki,","poem":1},{"lineBreak":true},{"text":"Gedib arxası üstə yıxılsınlar, yaralansınlar,","poem":1},{"lineBreak":true},{"text":"Tələyə düşüb əsir aparılsınlar.","poem":1}]},{"type":"heading","content":["Sion üçün guşədaşı"]},{"type":"verse","number":14,"content":[{"text":"Buna görə də, ey rişxəndçilər,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə olan bu xalqın rəhbərləri,","poem":1},{"lineBreak":true},{"text":"Rəbbin sözünə qulaq asın!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Madam ki siz dediniz:","poem":1},{"lineBreak":true},{"text":"«Ölümlə əhd bağladıq,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarı ilə razılığa gəldik,","poem":1},{"lineBreak":true},{"text":"Ölkəyə böyük bəla gələndə","poem":1},{"lineBreak":true},{"text":"Bizə zərər verməyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki yalanı özümüzə sığınacaq etdik,","poem":1},{"lineBreak":true},{"text":"Hiylənin arxasında gizləndik»,","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Buna görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"Budur, Sionda təməl olaraq bir daş,","poem":1},{"lineBreak":true},{"text":"Sınaqdan keçirilmiş daş, qiymətli bir guşədaşı qoyuram.","poem":1},{"lineBreak":true},{"text":"Ona iman edən hər kəs narahat olmayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ədaləti ölçü, salehliyi şaqul edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Yalan sığınacağını dolu məhv edəcək,","poem":1},{"lineBreak":true},{"text":"Gizləndiyiniz yerləri sellər yuyub-aparacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ölümlə bağladığınız əhd ləğv olunacaq,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarı ilə razılığınız qüvvədən düşəcək.","poem":1},{"lineBreak":true},{"text":"Ölkəyə böyük bəla gələndə sizi məhv edəcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bu bəla hər gələndə sizə toxunacaq.","poem":1},{"lineBreak":true},{"text":"O hər səhər, gecə-gündüz keçəcək.","poem":1},{"lineBreak":true},{"text":"Bu xəbəri anlayanda dəhşətə gələcəksiniz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yataq uzanmaq üçün qısa,","poem":1},{"lineBreak":true},{"text":"Yorğan bürünmək üçün dar olacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki Rəbb Perasim dağında etdiyi kimi qalxacaq,","poem":1},{"lineBreak":true},{"text":"Giveon vadisindəki kimi qəzəblənəcək.","poem":1},{"lineBreak":true},{"text":"O Öz işini, qeyri-adi işini yerinə yetirəcək!","poem":1},{"lineBreak":true},{"text":"Öz əməlini, naməlum əməlini həyata keçirəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Buna görə də rişxənd etməyin ki,","poem":1},{"lineBreak":true},{"text":"Buxovlarınız daha da ağırlaşmasın.","poem":1},{"lineBreak":true},{"text":"Çünki Ordular Rəbbi Xudavənddən eşitmişəm ki,","poem":1},{"lineBreak":true},{"text":"Bütün ölkə məhv olacaq.","poem":1}]},{"type":"heading","content":["Allahın hikməti"]},{"type":"verse","number":23,"content":[{"text":"Qulaq asın, səsimi eşidin, diqqət edin,","poem":1},{"lineBreak":true},{"text":"Dediyimi dinləyin.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Əkinçi əkin əkmək üçün durmadan yeri şumlayarmı,","poem":1},{"lineBreak":true},{"text":"Torpaqda şırım açıb malalayarmı?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"O, torpağı hamarlayandan sonra qara çörək otunu, zirəni səpməzmi?","poem":1},{"lineBreak":true},{"text":"Buğdanı sıra ilə, arpanı ayırdığı yerə, pərinci də onun yanına əkməzmi?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Allah ona öyüd verər, onu öyrədər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Çünki qara çörək otunu vəl ilə döyməzlər,","poem":1},{"lineBreak":true},{"text":"Zirənin üstünə araba təkərləri ilə sürməzlər.","poem":1},{"lineBreak":true},{"text":"Qara çörək otu dəyənəklə, zirə isə çubuqla döyülər.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Buğdanı çörək bişirmək üçün xırmanda döyürlər,","poem":1},{"lineBreak":true},{"text":"Amma o fasiləsiz döyülməz.","poem":1},{"lineBreak":true},{"text":"Xırmanın üstündən araba və atlar keçsə də, buğdanı əzməz.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bu hikmət Ordular Rəbbindən gəlir.","poem":1},{"lineBreak":true},{"text":"Onun məsləhəti ecazkardır, hikməti böyükdür.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}