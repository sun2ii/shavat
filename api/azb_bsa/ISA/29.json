{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Vay Yerusəlimin halına!"]},{"type":"verse","number":1,"content":[{"text":"Ariel,","poem":1},{"noteId":10},{"text":"ey Ariel, Davudun ordugah qurduğu şəhər!","poem":1},{"lineBreak":true},{"text":"İli ilə qat, bayramların keçirilsin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amma Arielə əzab verəcəyəm,","poem":1},{"lineBreak":true},{"text":"O, fəryad, fəğan edəcək,","poem":1},{"lineBreak":true},{"text":"Mənim üçün qurbangah ocağı kimi olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənə qarşı ətrafında ordugah quracağam,","poem":1},{"lineBreak":true},{"text":"Dövrəsinə istehkamlar düzəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sənə hücum etmək üçün qüllələr tikəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alçaldılacaqsan, yerin altından danışacaqsan,","poem":1},{"lineBreak":true},{"text":"Toz-torpaq içindən səsin boğuq gələcək,","poem":1},{"lineBreak":true},{"text":"Səsin ölü səsi kimi yerdən,","poem":1},{"lineBreak":true},{"text":"Sözlərin pıçıltı kimi torpağın altından çıxacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amma çoxlu düşmənlərin narın toz kimi,","poem":1},{"lineBreak":true},{"text":"Qorxunc adamların orduları sovrulmuş saman çöpü kimi olacaq.","poem":1},{"lineBreak":true},{"text":"Qəflətən bir an içində,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi göy gurultusu ilə, zəlzələ ilə,","poem":1},{"lineBreak":true},{"text":"Böyük səs-küylə, qasırğa və fırtına ilə,","poem":1},{"lineBreak":true},{"text":"Hər şeyi məhv edən od ilə sənin yanına gələcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sonra Arielə qarşı döyüşən bütün millətlərdən izdihamlar,","poem":1},{"lineBreak":true},{"text":"Ona və qalalarına qarşı savaşanların hamısı,","poem":1},{"lineBreak":true},{"text":"Ona zülm edənlər bir röya kimi,","poem":1},{"lineBreak":true},{"text":"Gecə görünən yuxu kimi yox olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuxuda çörək yediyini görən ac adam","poem":1},{"lineBreak":true},{"text":"Oyananda yenə acdır.","poem":1},{"lineBreak":true},{"text":"Yuxuda su içdiyini görən susuz adam","poem":1},{"lineBreak":true},{"text":"Oyananda yenə susuzluqdan yanır.","poem":1},{"lineBreak":true},{"text":"Sion dağına qarşı döyüşən","poem":1},{"lineBreak":true},{"text":"Bütün millətlərdən izdihamlar da belə olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Heyrətlənin və təəccüblənin,","poem":1},{"lineBreak":true},{"text":"Gözünüzü kor edin, qoy görməsin.","poem":1},{"lineBreak":true},{"text":"Şərab içmədən sərxoş olun,","poem":1},{"lineBreak":true},{"text":"İçki içmədən səndələyin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki Rəbb sizi dərin yuxuya saldı.","poem":1},{"lineBreak":true},{"text":"Ey peyğəmbərlər, gözlərinizi yumdu,","poem":1},{"lineBreak":true},{"text":"Ey görücülər, sizi kor elədi.","poem":1}]},{"type":"verse","number":11,"content":["Bütün bu görüntü sizin üçün möhürlənmiş kitabın sözlərinə bənzəyir. Oxumağı bacarana bunu verib desələr: «Rica edirəm, bunu oxu!» O isə cavab verir: «Oxuya bilmərəm, çünki möhürlüdür»."]},{"type":"verse","number":12,"content":["Kitabı oxuya bilməyənə verib desələr: «Bunu oxu, rica edirəm», o isə cavab verir: «Mən oxuya bilmirəm»."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xudavənd deyir:","poem":1},{"lineBreak":true},{"text":"«Bu xalq Mənə yaxınlaşıb","poem":1},{"lineBreak":true},{"text":"Dilləri və dodaqları ilə Mənə hörmət edir,","poem":1},{"lineBreak":true},{"text":"Amma qəlbləri Məndən uzaqdır.","poem":1},{"lineBreak":true},{"text":"Onların Mənə səcdə etmələri","poem":1},{"lineBreak":true},{"text":"İnsanlardan öyrəndikləri əmrlərdən gəlir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ona görə Mən bir də bu xalq üçün","poem":1},{"lineBreak":true},{"text":"Yeni möcüzə, ecazkar şeylər edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Müdriklərinin müdrikliyi məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Aqillərinin ağlı yox olacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Öz niyyətlərini Rəbdən gizlətməyə çalışanların vay halına!","poem":1},{"lineBreak":true},{"text":"Qaranlıqda iş görən bu adamlar","poem":1},{"lineBreak":true},{"text":"«Bizi kim görür, kim tanıyır?» deyirlər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bu nə cür ağılsız düşüncədir!","poem":1},{"lineBreak":true},{"text":"Heç dulusçunu gil ilə bir tutmaq olarmı?","poem":1},{"lineBreak":true},{"text":"Düzəldilən əşya onu düzəldən barədə","poem":1},{"lineBreak":true},{"text":"«O məni düzəltmədi» deyərmi?","poem":1},{"lineBreak":true},{"text":"Qab onu yaradan barədə","poem":1},{"lineBreak":true},{"text":"«O heç nə anlamır» deyərmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Livan tezliklə məhsuldar tarlaya,","poem":1},{"lineBreak":true},{"text":"Məhsuldar tarla isə meşəyə dönməyəcəkmi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O gün karlar kitabdakı sözləri eşidəcək,","poem":1},{"lineBreak":true},{"text":"Korların gözləri zülmət qaranlıqda görəcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fəqirlər Rəbdə sevinc tapacaq,","poem":1},{"lineBreak":true},{"text":"Yoxsullar İsrailin Müqəddəsində şadlanacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Çünki zülmkarlar yox olacaq,","poem":1},{"lineBreak":true},{"text":"Rişxəndçilər itib-batacaq.","poem":1},{"lineBreak":true},{"text":"Pislik etməyə hazır olanlar məhv olacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onlar başqasına böhtan atanlar,","poem":1},{"lineBreak":true},{"text":"Şəhər darvazasında hakimə tələ quranlardır,","poem":1},{"lineBreak":true},{"text":"Haqlının haqqını nahaq yerə təhrif edənlərdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Buna görə də İbrahimi qurtaran Rəbb Yaqub nəslinə belə deyir:","poem":1},{"lineBreak":true},{"text":"«Yaqub nəsli artıq utanmayacaq,","poem":1},{"lineBreak":true},{"text":"Üzləri qorxudan saralmayacaq.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Əlimlə yaratdığım övladlarını","poem":1},{"lineBreak":true},{"text":"Aralarında görəndə","poem":1},{"lineBreak":true},{"text":"Adımı müqəddəs tutacaqlar,","poem":1},{"lineBreak":true},{"text":"Yaqubun Müqəddəsini təqdis edəcəklər,","poem":1},{"lineBreak":true},{"text":"İsrailin Allahından qorxacaqlar.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yolunu azanlar anlayacaq,","poem":1},{"lineBreak":true},{"text":"Gileylənənlər təlim öyrənəcək».","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Ariel – ibrani dilində qurbangah ocağı yaxud Allahın aslanı mənasını daşıyır. Yerusəlim şəhərinə işarədir.","reference":{"chapter":29,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}