{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusəlimdə qarmaqarışıqlıq"]},{"type":"verse","number":1,"content":[{"text":"Budur, Sahibimiz, Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Yerusəlimdən və Yəhudadan hər bir yardımı, köməyi,","poem":1},{"lineBreak":true},{"text":"Bütün çörək, su yardımını kəsəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İgidlərlə cəngavərləri,","poem":1},{"lineBreak":true},{"text":"Hakimlərlə peyğəmbərləri,","poem":1},{"lineBreak":true},{"text":"Falçılarla ağsaqqalları,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əllibaşılarla adlı-sanlı adamları, məsləhətçiləri,","poem":1},{"lineBreak":true},{"text":"Mahir sehrbazlarla cadugərləri aradan qaldıracaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Uşaqları onların üzərinə başçı qoyacağam,","poem":1},{"lineBreak":true},{"text":"Qoy körpələr onlara hökm etsin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İnsan insanla, qonşu qonşusu ilə,","poem":1},{"lineBreak":true},{"text":"Cavan yaşlı ilə, adi adam nüfuzlu insanla","poem":1},{"lineBreak":true},{"text":"Həyasızcasına rəftar edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ailədə qardaş qardaşa sarılıb deyəcək:","poem":1},{"lineBreak":true},{"text":"«Sənin heç olmasa əyninə geyməyə paltarın var.","poem":1},{"lineBreak":true},{"text":"Sən başçımız ol,","poem":1},{"lineBreak":true},{"text":"Qoy bu xarabalıqlar sənin əlinin altında olsun!»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O vaxt bu adam uca səslə söyləyəcək:","poem":1},{"lineBreak":true},{"text":"«Mən yaralarınızı sarımağı bacarmaram,","poem":1},{"lineBreak":true},{"text":"Çünki evimdə nə yemək, nə də paltar var,","poem":1},{"lineBreak":true},{"text":"Məni xalqın başçısı qoymayın».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusəlim sarsıldı, Yəhuda dağıldı,","poem":1},{"lineBreak":true},{"text":"Çünki sözləri və əməlləri","poem":1},{"lineBreak":true},{"text":"Rəbbə qarşı oldu,","poem":1},{"lineBreak":true},{"text":"Onun əzəmətli hüzuru kimsə tərəfindən sayılmadı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sifətlərinin ifadəsi onlara qarşı şəhadət edir,","poem":1},{"lineBreak":true},{"text":"Günahları haqda Sodomdakı kimi açıq danışırlar,","poem":1},{"lineBreak":true},{"text":"Bunu gizlətmirlər.","poem":1},{"lineBreak":true},{"text":"Vay onların halına!","poem":1},{"lineBreak":true},{"text":"Axı bu bəlanı başlarına özləri gətirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Saleh adamlara söyləyin ki,","poem":1},{"lineBreak":true},{"text":"Onlara yaxşılıq ediləcək,","poem":1},{"lineBreak":true},{"text":"Çünki onlar xeyirxahlıqlarının bəhrəsini yeyəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pis adamların vay halına!","poem":1},{"lineBreak":true},{"text":"Çünki onlara pislik olunacaq,","poem":1},{"lineBreak":true},{"text":"Elədikləri əməlləri qarşılarına çıxacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uşaqlar xalqıma zülm edir,","poem":1},{"lineBreak":true},{"text":"Qadınlar üzərimizdə hökm sürür!","poem":1},{"lineBreak":true},{"text":"Ey xalqım, sənə yol göstərənlər","poem":1},{"lineBreak":true},{"text":"Səni azdırır, yolunu dolaşdırırlar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rəbb məhkəməsini qurmaq üçün qalxır,","poem":1},{"lineBreak":true},{"text":"Xalqları mühakimə etmək üçün durur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb xalqının rəhbərlərini,","poem":1},{"lineBreak":true},{"text":"Başçılarını məhkəməyə gətirir:","poem":1},{"lineBreak":true},{"text":"«Sizsiniz üzüm bağını yeyib-dağıdan,","poem":1},{"lineBreak":true},{"text":"Kasıbların malı ilə evlərinizi dolduran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nə haqla xalqıma zülm edib","poem":1},{"lineBreak":true},{"text":"Yoxsullara əzab verirsiniz?»","poem":1},{"lineBreak":true},{"text":"Bunu Ordular Rəbbi Xudavənd bəyan edir.","poem":1}]},{"type":"heading","content":["Yerusəlim qadınlarına xəbərdarlıq"]},{"type":"verse","number":16,"content":[{"text":"Rəbb deyir: Madam ki","poem":1},{"lineBreak":true},{"text":"Sion qızları çox təkəbbürlüdür,","poem":1},{"lineBreak":true},{"text":"Boylana-boylana gəzir, göz-qaş oynadır,","poem":1},{"lineBreak":true},{"text":"Addımlarını asta-asta atırlar,","poem":1},{"lineBreak":true},{"text":"Ayaqlarındakı xalxalları cingildədib yeriyirlər,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Buna görə də Xudavənd","poem":1},{"lineBreak":true},{"text":"Sion qızlarının başlarına qotur salacaq.","poem":1},{"lineBreak":true},{"text":"Ayıb yerlərini açıb göstərəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O gün Xudavənd onların bəzəklərini –","poem":1},{"lineBreak":true},{"text":"Topuqlara taxılan bilərziklərini,","poem":1},{"lineBreak":true},{"text":"Araqçınlarını, aypara şəkilli boyunbağılarını,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sırğalarını, qolbaqlarını, örpəklərini,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tac şəkilli başlıqlarını,","poem":1},{"lineBreak":true},{"text":"Bazubəndlərini, qurşaqlarını,","poem":1},{"lineBreak":true},{"text":"Ətirlə dolu mücrülərini,","poem":1},{"lineBreak":true},{"text":"Tilsimlənmiş bəzək əşyalarını,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Üzüklərini, burun halqalarını,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bayram libaslarını, paltarlarını,","poem":1},{"lineBreak":true},{"text":"Örtüklərini, əl çantalarını,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Güzgülərini, nəfis toxunmuş kətan libaslarını,","poem":1},{"lineBreak":true},{"text":"Çalmalarını, duvaqlarını əllərindən alacaq;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"O vaxt gözəl ətir yerinə üfunət,","poem":1},{"lineBreak":true},{"text":"Kəmər əvəzinə ip,","poem":1},{"lineBreak":true},{"text":"Lülə-lülə saç əvəzinə keçəl baş,","poem":1},{"lineBreak":true},{"text":"Bəzəkli paltar əvəzinə çul bürüncək,","poem":1},{"lineBreak":true},{"text":"Gözəllik əvəzinə dağlanma olacaq.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kişiləriniz qılıncla,","poem":1},{"lineBreak":true},{"text":"İgidləriniz döyüşdə məhv olacaq.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yerusəlimin darvazaları","poem":1},{"lineBreak":true},{"text":"Nalə çəkib yas tutacaq,","poem":1},{"lineBreak":true},{"text":"Bu şəhərsə kimsəsiz qadın tək","poem":1},{"lineBreak":true},{"text":"Quru yerdə oturacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}