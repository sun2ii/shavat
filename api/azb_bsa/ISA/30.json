{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["Misirlə bağlanan əhd puçdur"]},{"type":"verse","number":1,"content":[{"text":"Rəbb bəyan edir: «Bu dikbaş övladların vay halına,","poem":1},{"lineBreak":true},{"text":"Mənim niyyətlərimi yox, öz niyyətlərini qururlar,","poem":1},{"lineBreak":true},{"text":"Ruhuma uyğun olmayan razılaşma edirlər,","poem":1},{"lineBreak":true},{"text":"Eləcə günahı günaha qatırlar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Məndən məsləhət almadan","poem":1},{"lineBreak":true},{"text":"Misirə gedirlər,","poem":1},{"lineBreak":true},{"text":"Fironun himayəsini axtarırlar,","poem":1},{"lineBreak":true},{"text":"Misirin kölgəsi altında sığınacaq tapırlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fəqət fironun himayəsi","poem":1},{"lineBreak":true},{"text":"Onlar üçün xəcalətə,","poem":1},{"lineBreak":true},{"text":"Misir kölgəsi altındakı","poem":1},{"lineBreak":true},{"text":"Sığınacaq rüsvayçılığa çevriləcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Başçıları Soanda olduqlarına,","poem":1},{"lineBreak":true},{"text":"Elçiləri Xanesə yetişdiklərinə baxmayaraq,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Özlərinə faydası olmayan xalqa görə hamı utanacaq.","poem":1},{"lineBreak":true},{"text":"O xalqın onlara nə köməyi, nə də faydası olacaq,","poem":1},{"lineBreak":true},{"text":"Ancaq xəcalət və rüsvayçılıq olacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Negev heyvanları barəsində xəbərdarlıq:",{"text":"Yəhudanın elçiləri erkək və dişi aslanların,","poem":1},{"lineBreak":true},{"text":"Gürzələrin, uçan ilanların yaşadığı","poem":1},{"lineBreak":true},{"text":"Narahat və təhlükəli torpaqdan keçirlər.","poem":1},{"lineBreak":true},{"text":"Mal-dövlətini eşşəklərin belinə,","poem":1},{"lineBreak":true},{"text":"Xəzinələrini dəvələrin hürgücünə yükləyib","poem":1},{"lineBreak":true},{"text":"Onlara kömək edə bilməyən xalq üçün aparırlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Misirin köməyi boş və faydasızdır,","poem":1},{"lineBreak":true},{"text":"Buna görə də Mən Misirə","poem":1},{"lineBreak":true},{"text":"«Tənbəl Rahav»","poem":1},{"noteId":11},{"text":"adını qoydum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«İndi get, sənə danışdığımı","poem":1},{"lineBreak":true},{"text":"Onların qarşısında bir lövhəyə yaz, kitaba köçür ki,","poem":1},{"lineBreak":true},{"text":"Gələcəkdə, əbədiyyətdə şahid olsun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki bu, üsyankar xalq,","poem":1},{"lineBreak":true},{"text":"Yalançılar nəslidir,","poem":1},{"lineBreak":true},{"text":"Rəbbin qanununa qulaq asmaq istəməyən bir soydur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar baxıcılara “bir daha görüntü görməyin”,","poem":1},{"lineBreak":true},{"text":"Görücülərə “bizim üçün düzgün şeylər haqqında peyğəmbərlik etməyin,","poem":1},{"lineBreak":true},{"text":"Bizə xoş sözlər söyləyin,","poem":1},{"lineBreak":true},{"text":"Arzuladığımızı peyğəmbərlik edin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yoldan çəkilin, bizə yol verin,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsini bizimlə üzləşdirməyin” deyirlər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Buna görə də İsrailin Müqəddəsi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Bu sözü rədd etdiyinizə görə,","poem":1},{"lineBreak":true},{"text":"Zorakılığa və yalana güvənib bel bağladığınıza görə","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu qəbahət sizin üçün hündür divarda əmələ gələn çata bənzəyir,","poem":1},{"lineBreak":true},{"text":"Qəflətən, bir an içində dağıla bilər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ölkəniz də bir gil qab kimi qırılacaq,","poem":1},{"lineBreak":true},{"text":"Elə xıncım-xıncım olacaq ki,","poem":1},{"lineBreak":true},{"text":"Ocaqdan od götürmək üçün","poem":1},{"lineBreak":true},{"text":"Yaxud hovuzdan su çəkmək üçün bir qırığı da qalmayacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xudavənd Rəbb, İsrailin Müqəddəsi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mənə tərəf dönüb rahatlıq tapanda xilas olarsınız,","poem":1},{"lineBreak":true},{"text":"Sakitləşib inanmaqla qüdrətli olarsınız,","poem":1},{"lineBreak":true},{"text":"Lakin siz bunu istəmirsiniz.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Siz dediniz: “Xeyr, atlara minib-qaçacağıq”,","poem":1},{"lineBreak":true},{"text":"Buna görə siz qaçmalı olacaqsınız.","poem":1},{"lineBreak":true},{"text":"“Çevik atlara minəcəyik”.","poem":1},{"lineBreak":true},{"text":"Buna görə təqibçiləriniz də çevik olacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Min nəfər bir nəfərin hədəsinə görə qaçacaq,","poem":1},{"lineBreak":true},{"text":"Beş nəfərin hədəsinə görə hamınız qaçacaqsınız;","poem":1},{"lineBreak":true},{"text":"Sağ qalanlarınız dağın zirvəsindəki bayrağın şüvülü tək,","poem":1},{"lineBreak":true},{"text":"Təpədəki bayraq tək olacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Amma Rəbb sizə lütf göstərmək üçün gözləyir,","poem":1},{"lineBreak":true},{"text":"Yenə də sizə rəhm etməyə hazırdır,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb adil Allahdır,","poem":1},{"lineBreak":true},{"text":"Onu intizarla gözləyənlər nə bəxtiyardır!","poem":1}]},{"type":"heading","content":["Rəbb xalqına bərəkət verəcək"]},{"type":"verse","number":19,"content":[{"text":"Ey Yerusəlimdə yaşayanlar, ey Sion xalqı,","poem":1},{"lineBreak":true},{"text":"Siz artıq ağlamayacaqsınız,","poem":1},{"lineBreak":true},{"text":"Fəryad etdikdə Rəbb sizin üçün lütfkar olacaq,","poem":1},{"lineBreak":true},{"text":"Fəryadınızı eşidən kimi cavab verəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rəbb çörəyi əzabla, suyu çətinliklə sizə verəcək,","poem":1},{"lineBreak":true},{"text":"Lakin O bir daha Mürəbbinizi sizdən gizlətməyəcək,","poem":1},{"lineBreak":true},{"text":"Onu gözünüzlə görəcəksiniz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sağa ya sola azdığınız vaxt","poem":1},{"lineBreak":true},{"text":"Arxanızdan «Yol budur, gedin bu yolla»","poem":1},{"lineBreak":true},{"text":"Deyilən səsi eşidəcəksiniz.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onda siz gümüşlə örtülən oyma bütlərinizi,","poem":1},{"lineBreak":true},{"text":"Qızılla örtülmüş tökmə bütlərinizi","poem":1},{"lineBreak":true},{"text":"Murdar hesab edəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Murdar bir şeyi atdığınız kimi onları atıb deyəcəksiniz:","poem":1},{"lineBreak":true},{"text":"«Rədd ol!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbb yerə əkdiyiniz toxum üçün yağış verəcək,","poem":1},{"lineBreak":true},{"text":"Torpağın məhsulu bol və bərəkətli olacaq.","poem":1},{"lineBreak":true},{"text":"O gün mal-qaranız geniş otlaqlarda otlayacaq.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Torpağı şumlayan öküzlərlə eşşəklər","poem":1},{"lineBreak":true},{"text":"Kürəklə, yaba ilə sovrulmuş duzlu yem yeyəcək.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"O böyük məğlubiyyət günündə","poem":1},{"lineBreak":true},{"text":"Qalalar yerə çökəndə","poem":1},{"lineBreak":true},{"text":"Hər hündür dağdan,","poem":1},{"lineBreak":true},{"text":"Hər uca təpədən sellər axacaq.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Rəbb Öz xalqının yaralarını sarıdığı gün,","poem":1},{"lineBreak":true},{"text":"Zərbəsi ilə açdığı yaralarına şəfa verən gün,","poem":1},{"lineBreak":true},{"text":"Ay işığı günəş işığı,","poem":1},{"lineBreak":true},{"text":"Günəşin işığı yeddi günün işığı kimi","poem":1},{"lineBreak":true},{"text":"Yeddi qat artıq parlayacaq.","poem":1}]},{"type":"heading","content":["Rəbb Aşşuru cəzalandıracaq"]},{"type":"verse","number":27,"content":[{"text":"Budur, Rəbbin adı uzaqdan gəlir,","poem":1},{"lineBreak":true},{"text":"Qızğın qeyzlə qara bulud içində","poem":1},{"lineBreak":true},{"text":"Ağzı qəzəbli sözlərlə doludur,","poem":1},{"lineBreak":true},{"text":"Dili sanki hər şeyi məhv edən alovdur.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Onun nəfəsi insan boğazına çatmış daşan sel kimidir,","poem":1},{"lineBreak":true},{"text":"Millətləri ələkdən keçirəcək ki, məhv olsunlar,","poem":1},{"lineBreak":true},{"text":"Xalqların ağzına yüyən taxacaq ki, yolunu azsınlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Siz isə müqəddəs bayram gecəsi kimi","poem":1},{"lineBreak":true},{"text":"İlahilər oxuyacaqsınız.","poem":1},{"lineBreak":true},{"text":"Rəbbin dağına, İsrailin Qayasına tütək çalaraq çıxan tək","poem":1},{"lineBreak":true},{"text":"Ürəyiniz şadlanacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Rəbb əzəmətli səsini eşitdirəcək,","poem":1},{"lineBreak":true},{"text":"Qızğın qəzəblə, hər şeyi yandıran alovla,","poem":1},{"lineBreak":true},{"text":"Fırtına ilə, güclü leysanla, dolu ilə","poem":1},{"lineBreak":true},{"text":"Qolunun qüdrətini göstərəcək.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aşşur Rəbbin səsindən vahiməyə gələcək,","poem":1},{"lineBreak":true},{"text":"Rəbb dəyənəyi ilə onları vuracaq.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Rəbbin onlara endirdiyi dəyənəyinin hər zərbəsini","poem":1},{"lineBreak":true},{"text":"Dəf və liralar müşayiət edəcək.","poem":1},{"lineBreak":true},{"text":"Döyüşərkən əl-qol atıb onları vuracaq.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tofet çoxdan hazırdır,","poem":1},{"lineBreak":true},{"text":"Aşşur padşahı üçün də","poem":1},{"lineBreak":true},{"text":"O yer dərinləşdirilib genişləndirilmişdir.","poem":1},{"lineBreak":true},{"text":"Od çuxurunda çoxlu odun, alov var.","poem":1},{"lineBreak":true},{"text":"Rəbbin nəfəsi kükürd axını kimi onu yandırar.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Rahav – Misirin rəmzi.","reference":{"chapter":30,"verse":7}}]},"thisChapterLink":"/api/azb_bsa/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}