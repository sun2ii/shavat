{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Misirə güvənməyin"]},{"type":"verse","number":1,"content":[{"text":"Kömək üçün Misirə enənlərin,","poem":1},{"lineBreak":true},{"text":"Atlara güvənənlərin vay halına!","poem":1},{"lineBreak":true},{"text":"Onlar döyüş arabalarının çoxluğuna,","poem":1},{"lineBreak":true},{"text":"Süvarilərin gücünə bel bağlayır!","poem":1},{"lineBreak":true},{"text":"Amma İsrailin Müqəddəsinə baxmırlar,","poem":1},{"lineBreak":true},{"text":"Rəbbi axtarmırlar!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lakin Rəbb tam hikmətə malikdir,","poem":1},{"lineBreak":true},{"text":"O bəla gətirər, Öz sözlərini geri götürməz,","poem":1},{"lineBreak":true},{"text":"Pislik edən adamlara,","poem":1},{"lineBreak":true},{"text":"Günahkarlara kömək edənlərə qarşı çıxar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Misirlilər Allah deyil, insandır,","poem":1},{"lineBreak":true},{"text":"Atları da ətdəndir, ruhdan deyil.","poem":1},{"lineBreak":true},{"text":"Rəbb Öz əlini uzadanda","poem":1},{"lineBreak":true},{"text":"Yardım edən büdrəyəcək,","poem":1},{"lineBreak":true},{"text":"Yardım alan yıxılacaq,","poem":1},{"lineBreak":true},{"text":"Hamısı birlikdə məhv olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Çünki Rəbb mənə belə dedi:","poem":1},{"lineBreak":true},{"text":"«Şir ya gənc aslan öz şikarı üstünə nərə çəkəndə","poem":1},{"lineBreak":true},{"text":"Bir dəstə çoban ona qarşı haray salsa da,","poem":1},{"lineBreak":true},{"text":"Aslan onların səslərindən qorxmur,","poem":1},{"lineBreak":true},{"text":"Qışqırıqlarına məhəl qoymur.","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi də elə enəcək,","poem":1},{"lineBreak":true},{"text":"Sion dağını, onun təpələrini","poem":1},{"lineBreak":true},{"text":"Qorumaq üçün döyüşəcək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quş qanad açıb necə balalarını qoruyursa,","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Yerusəlimi də belə qoruyacaq,","poem":1},{"lineBreak":true},{"text":"Müdafiə edəcək, qurtaracaq, saxlayacaq, xilas edəcək».","poem":1}]},{"type":"verse","number":6,"content":["Ey İsrail övladları, üz döndərdiyiniz Rəbbə tərəf dönün!"]},{"type":"verse","number":7,"content":["Çünki o gün hamınız əlinizlə günahkarcasına düzəltdiyiniz qızıl və gümüş bütlərinizi tullayacaqsınız."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Aşşurlular qılıncdan məhv olacaq,","poem":1},{"lineBreak":true},{"text":"İnsan qılıncından yox.","poem":1},{"lineBreak":true},{"text":"Onlar qılıncdan keçiriləcək,","poem":1},{"lineBreak":true},{"text":"Amma bu insan qılıncı olmayacaq.","poem":1},{"lineBreak":true},{"text":"Aşşurlular döyüş meydanından qaçacaq,","poem":1},{"lineBreak":true},{"text":"Cavanları isə yaxalanıb qul olacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aşşur padşahı dəhşət içində qaçacaq.","poem":1},{"lineBreak":true},{"text":"Sərkərdələri bayraqlarını atıb vəlvələyə düşəcək».","poem":1},{"lineBreak":true},{"text":"Bunu alovu Sionda,","poem":1},{"lineBreak":true},{"text":"Ocağı Yerusəlimdə olan Rəbb bəyan edir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}