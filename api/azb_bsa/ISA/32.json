{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Saleh padşah"]},{"type":"verse","number":1,"content":[{"text":"Budur, padşah salehliklə hökm sürəcək,","poem":1},{"lineBreak":true},{"text":"Başçılar ədalətlə rəhbərlik edəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onların hər biri","poem":1},{"lineBreak":true},{"text":"Küləyə qarşı bir pənahgah,","poem":1},{"lineBreak":true},{"text":"Fırtınaya qarşı sığınacaq,","poem":1},{"lineBreak":true},{"text":"Quraqlıqda bulaqlar,","poem":1},{"lineBreak":true},{"text":"Cansıxıcı torpaqda kölgə salan böyük qaya kimi olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Görənlərin gözləri bir daha yumulmayacaq,","poem":1},{"lineBreak":true},{"text":"Eşidənlərin qulaqları dinləyəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ağılsızların ağlı biliyə doğru yönələcək,","poem":1},{"lineBreak":true},{"text":"Pəltəklər açıq-aydın danışacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Artıq axmaq adama alicənab deyilməyəcək,","poem":1},{"lineBreak":true},{"text":"Alçağı ağayana insan saymayacaqlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki axmaq səfeh-səfeh danışır,","poem":1},{"lineBreak":true},{"text":"Ürəyinin niyyəti pislik etməkdir.","poem":1},{"lineBreak":true},{"text":"Onun işi küfr edib,","poem":1},{"lineBreak":true},{"text":"Rəbbə qarşı təhqiranə danışmaq,","poem":1},{"lineBreak":true},{"text":"Acları ac, susuzları susuz qoymaqdır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alçaq adamın əməlləri pisdir.","poem":1},{"lineBreak":true},{"text":"O, hiylə işlədir ki,","poem":1},{"lineBreak":true},{"text":"Yalan sözlərlə haqlı olan yoxsula ziyan versin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amma alicənab adam","poem":1},{"lineBreak":true},{"text":"Alicənab şeylər barəsində fikirləşər.","poem":1},{"lineBreak":true},{"text":"Elədiyi xoş əməllər ona dayaqdır.","poem":1}]},{"type":"heading","content":["Hökm və qurtuluş"]},{"type":"verse","number":9,"content":[{"text":"Ey qayğısız qadınlar,","poem":1},{"lineBreak":true},{"text":"Qalxın, səsimi eşidin!","poem":1},{"lineBreak":true},{"text":"Ey laqeyd qızlar, sözümü dinləyin!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey laqeyd qadınlar,","poem":1},{"lineBreak":true},{"text":"Siz bir ildən sonra sarsılacaqsınız,","poem":1},{"lineBreak":true},{"text":"Çünki bağda məhsul,","poem":1},{"lineBreak":true},{"text":"Meyvə yığımı olmayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey qayğısızlar, əsin!","poem":1},{"lineBreak":true},{"text":"Ey laqeydlər, lərzəyə gəlin,","poem":1},{"lineBreak":true},{"text":"Geyimlərinizi çıxarın,","poem":1},{"lineBreak":true},{"text":"Soyunun, belinizə çul qurşayın.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gözəl tarlalar,","poem":1},{"lineBreak":true},{"text":"Məhsuldar meynələr üçün,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xalqımın tikanlı kollar bitən torpağı üçün,","poem":1},{"lineBreak":true},{"text":"Zövq-səfalı şəhərlərdəki şən evləriniz üçün","poem":1},{"lineBreak":true},{"text":"Sinə döyün.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki saray viranə,","poem":1},{"lineBreak":true},{"text":"İzdihamlı şəhər boş qalacaq,","poem":1},{"lineBreak":true},{"text":"Qala ilə gözətçi qülləsi","poem":1},{"lineBreak":true},{"text":"Əbədilik mağaralara çevriləcək,","poem":1},{"lineBreak":true},{"text":"Vəhşi eşşəklərin gəzdiyi,","poem":1},{"lineBreak":true},{"text":"Sürülərin otlaq yeri olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bunlar yuxarıdan üzərimizə Ruh tökülənədək davam edəcək.","poem":1},{"lineBreak":true},{"text":"O vaxt səhra məhsuldar tarlaya,","poem":1},{"lineBreak":true},{"text":"Məhsuldar tarla isə meşəyə dönəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sonra ədalət səhrada məskunlaşacaq,","poem":1},{"lineBreak":true},{"text":"Salehlik məhsuldar tarlada yaşayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Salehliyin bəhrəsi əmin-amanlıq,","poem":1},{"lineBreak":true},{"text":"Nəticəsi isə əbədi sakitlik və təhlükəsizlik olacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xalqım əmin-amanlıq içində evlərində,","poem":1},{"lineBreak":true},{"text":"Təhlükəsiz məskəndə, rahat yerlərdə yaşayacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dolu meşələrə düşsə də,","poem":1},{"lineBreak":true},{"text":"Şəhər yerlə yeksan olsa da,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bütün sulu torpaqlarda toxum əkənlər,","poem":1},{"lineBreak":true},{"text":"Oraya malını, eşşəyini sərbəst buraxanlar,","poem":1},{"lineBreak":true},{"text":"Siz nə xoşbəxtsiniz!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}