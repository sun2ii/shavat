{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Kömək üçün yalvarış"]},{"type":"verse","number":1,"content":[{"text":"Vay halına, ey yıxıb-dağıdan,","poem":1},{"lineBreak":true},{"text":"Amma özü yıxılmayan insan!","poem":1},{"lineBreak":true},{"text":"Vay halına, ey xain adam,","poem":1},{"lineBreak":true},{"text":"Hərçənd sənə qarşı xəyanət etməmişlər!","poem":1},{"lineBreak":true},{"text":"Sən məhv edib qurtaran zaman","poem":1},{"lineBreak":true},{"text":"Özün də yıxılacaqsan,","poem":1},{"lineBreak":true},{"text":"Sən xain əməllərindən dönəndə","poem":1},{"lineBreak":true},{"text":"Xəyanətlə rastlaşacaqsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ya Rəbb, bizə qarşı lütfkar ol,","poem":1},{"lineBreak":true},{"text":"Çünki Sənə ümid etmişik.","poem":1},{"lineBreak":true},{"text":"Hər səhər bizim qüvvətimiz ol,","poem":1},{"lineBreak":true},{"text":"Fəlakət günündə bizi qurtar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənin qüdrətli səsindən xalqlar qaçır,","poem":1},{"lineBreak":true},{"text":"Sən ayağa qalxarkən","poem":1},{"lineBreak":true},{"text":"Millətlər pərən-pərən olur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çəyirtkələr tarlanı nə cür talan edirlərsə,","poem":1},{"lineBreak":true},{"text":"Ey millətlər, qənimətiniz də o cür talan olacaq.","poem":1},{"lineBreak":true},{"text":"Malınızın üstünə çəyirtkə yığını kimi cumacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb ucadır, yüksəklərdə oturur,","poem":1},{"lineBreak":true},{"text":"Sionu ədalətlə və salehliklə doldurur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O, yaşadığınız dövrün təməlidir,","poem":1},{"lineBreak":true},{"text":"Qurtuluşun, hikmətin, biliyin mənbəyidir,","poem":1},{"lineBreak":true},{"text":"Rəbb qorxusu sənin xəzinəndir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Budur, millətlərin igidləri küçələrdə çığırırlar.","poem":1},{"lineBreak":true},{"text":"Sülh qasidləri hönkürüb ağlayırlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yollar boşalıb, səyyahlar yoxdur.","poem":1},{"lineBreak":true},{"text":"Düşmən əhdi pozdu,","poem":1},{"lineBreak":true},{"text":"Şəhərləri dağıtdı, adamları alçaltdı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ölkə yas tutur, zəifləyir,","poem":1},{"lineBreak":true},{"text":"Livan məğlub olub, solub,","poem":1},{"lineBreak":true},{"text":"Şaron səhraya dönür,","poem":1},{"lineBreak":true},{"text":"Başan və Karmelin ağacları yarpaqlarını tökür.","poem":1}]},{"type":"heading","content":["Rəbbin xalqlara xəbərdarlığı"]},{"type":"verse","number":10,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«İndi qalxacağam,","poem":1},{"lineBreak":true},{"text":"İndi yüksələcəyəm,","poem":1},{"lineBreak":true},{"text":"İndi ucalacağam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Samana hamilə qalıb küləş doğacaqsınız,","poem":1},{"lineBreak":true},{"text":"Nəfəsiniz sizi məhv edən alova dönəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xalqlar yanıb kül olacaq,","poem":1},{"lineBreak":true},{"text":"Kəsilib odda yandırılan tikanlı kollara oxşayacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey uzaqda yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Nə elədiyimi eşidin,","poem":1},{"lineBreak":true},{"text":"Ey yaxında yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Mənim gücümü bilin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Siondakı günahkarlar dəhşətə,","poem":1},{"lineBreak":true},{"text":"Allahsızlar lərzəyə gəldi:","poem":1},{"lineBreak":true},{"text":"«Hər şeyi məhv edən alovun yanında hansımız yaşaya bilərik?","poem":1},{"lineBreak":true},{"text":"Əbədi yanan atəşin yanında hansımız dayana bilərik?»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amma salehlik yolu ilə gedən,","poem":1},{"lineBreak":true},{"text":"Doğru sözlər danışan,","poem":1},{"lineBreak":true},{"text":"Zorakılıqla əldə edilən qazancı rədd edən,","poem":1},{"lineBreak":true},{"text":"Əlini rüşvətdən uzaq tutan,","poem":1},{"lineBreak":true},{"text":"Qatillərin qurduğu qəsdə fikir verməyən,","poem":1},{"lineBreak":true},{"text":"Pisliyə qarşı gözlərini yuman","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yüksəkliklərdə yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Təpələrin başındakı qalalar onun dayağı olacaq.","poem":1},{"lineBreak":true},{"text":"O, çörəklə, su ilə təmin olunacaq.","poem":1}]},{"type":"heading","content":["Parlaq gələcək"]},{"type":"verse","number":17,"content":[{"text":"Gözlərin padşahı bütün gözəlliyi ilə görəcək,","poem":1},{"lineBreak":true},{"text":"Ucsuz-bucaqsız ölkəni seyr edəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"«Haradadır xərac yığan?","poem":1},{"lineBreak":true},{"text":"Haradadır qeydiyyat aparan?","poem":1},{"lineBreak":true},{"text":"Haradadır qüllələrə nəzər salan?» deyərək","poem":1},{"lineBreak":true},{"text":"Dəhşətli günlər haqqında düşünəcəksən.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Anlaşılmaz, yad dildə danışan","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü xalqı daha görməyəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bayramlar keçirdiyimiz şəhərə – Siona bax!","poem":1},{"lineBreak":true},{"text":"Gözlərin Yerusəlimi,","poem":1},{"lineBreak":true},{"text":"Sarsılmaz çadırı, sülh məskənini görəcək.","poem":1},{"lineBreak":true},{"text":"Onun payaları heç vaxt sökülməyəcək,","poem":1},{"lineBreak":true},{"text":"Kəndirlərinin heç biri qırılmayacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lakin orada –","poem":1},{"lineBreak":true},{"text":"Geniş çayların, irmaqların olduğu yerdə","poem":1},{"lineBreak":true},{"text":"Əzəmətli Rəbb bizimlə olacaq.","poem":1},{"lineBreak":true},{"text":"Oradan avarlı qayıqlar, böyük gəmilər","poem":1},{"lineBreak":true},{"text":"Keçə bilməz.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki Rəbdir hakim olan,","poem":1},{"lineBreak":true},{"text":"Rəbdir qanunumuzu qoyan,","poem":1},{"lineBreak":true},{"text":"Padşahımız Rəbdir, Odur bizi qurtaran.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gəmilərinin ipləri boşaldı,","poem":1},{"lineBreak":true},{"text":"Dor ağacları yerində möhkəm dayanmadı,","poem":1},{"lineBreak":true},{"text":"Yelkənləri açılmadı.","poem":1},{"lineBreak":true},{"text":"O vaxt böyük talan malı paylanacaq,","poem":1},{"lineBreak":true},{"text":"Hətta topal adamlar da talan edəcək.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Heç bir Sion sakini","poem":1},{"lineBreak":true},{"text":"«Xəstəyəm» deməyəcək,","poem":1},{"lineBreak":true},{"text":"Orada yaşayan xalqın günahları bağışlanacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}