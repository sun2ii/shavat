{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Allahın millətlərə cəza verməsi"]},{"type":"verse","number":1,"content":[{"text":"Ey millətlər, yaxın gəlin, eşidin,","poem":1},{"lineBreak":true},{"text":"Ey ümmətlər, dinləyin!","poem":1},{"lineBreak":true},{"text":"Ey dünya və sakinləri,","poem":1},{"lineBreak":true},{"text":"Yer üzü və onun bütün yetirmələri, qulaq asın!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki Rəbb bütün millətlərə qarşı qəzəbləndi,","poem":1},{"lineBreak":true},{"text":"Onların ordularına qarşı qeyzə gəldi.","poem":1},{"lineBreak":true},{"text":"Onların hamısını məhv edəcək,","poem":1},{"lineBreak":true},{"text":"Ölümə məhkum edəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ölüləri kənara atılacaq,","poem":1},{"lineBreak":true},{"text":"Meyitlərindən üfunət qalxacaq,","poem":1},{"lineBreak":true},{"text":"Dağlar onların qanına bulanacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bütün göy cisimləri çürüyəcək,","poem":1},{"lineBreak":true},{"text":"Göylər bir tumar kimi büküləcək.","poem":1},{"lineBreak":true},{"text":"Göy ulduzları meynə yarpağı kimi,","poem":1},{"lineBreak":true},{"text":"Əncir yarpağı kimi düşəcək, saralıb-solacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Çünki qılıncım göylərdə doyub,","poem":1},{"lineBreak":true},{"text":"Bax Edomun üzərinə,","poem":1},{"lineBreak":true},{"text":"Məhv etməyə qərar verdiyim xalqın üzərinə enir».","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbbin qılıncı qanla, quzu və təkə qanı ilə doydu,","poem":1},{"lineBreak":true},{"text":"Qoç böyrəklərinin yağı ilə piy bağladı.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb Bosrada qurban,","poem":1},{"lineBreak":true},{"text":"Edomda isə böyük qırğın hazırlayıb.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onlarla birlikdə çöl öküzləri,","poem":1},{"lineBreak":true},{"text":"Buzovlar, güclü buğalar yerə səriləcək.","poem":1},{"lineBreak":true},{"text":"Onların ölkəsi qanla dolacaq, torpaqları piylə münbit olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Çünki Rəbbin qisas günü var,","poem":1},{"lineBreak":true},{"text":"Siona edilən zülmlərin intiqam ili var.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Edomun axar suları qatrana,","poem":1},{"lineBreak":true},{"text":"Torpağı kükürdə dönəcək,","poem":1},{"lineBreak":true},{"text":"Ölkənin hər tərəfi yanan qatrana çevriləcək;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gecə-gündüz sönməyəcək, tüstüsü həmişə qalxacaq,","poem":1},{"lineBreak":true},{"text":"Nəsildən-nəslədək viran qalacaq,","poem":1},{"lineBreak":true},{"text":"Əsrlər boyu oradan heç kəs keçməyəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Orada ancaq bayquşlarla kirpilər yurd salacaq,","poem":1},{"lineBreak":true},{"text":"Böyük bayquşlarla qarğalar orada yaşayacaq.","poem":1},{"lineBreak":true},{"text":"Rəbb oranı qarmaqarışıqlıq ipi, viranəlik şaqulu ilə ölçəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Orada heç bir adlı-sanlı adam qalmayacaq ki,","poem":1},{"lineBreak":true},{"text":"Onu padşah elan etsinlər.","poem":1},{"lineBreak":true},{"text":"Bütün başçıların sonu gələcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Saraylarında tikanlar,","poem":1},{"lineBreak":true},{"text":"Qalalarında gicitkən və böyürtkən bitəcək.","poem":1},{"lineBreak":true},{"text":"Ora çaqqalların yurdu, dəvəquşuların yuvası olacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vəhşi heyvanlarla goreşənlər orada görüşəcək,","poem":1},{"lineBreak":true},{"text":"Təkələr bir-birini səsləyəcək,","poem":1},{"lineBreak":true},{"text":"Gecə heyvanları da orada məskunlaşıb rahat yer tapacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Orada bayquş yuva quracaq, yumurtlayacaq,","poem":1},{"lineBreak":true},{"text":"Öz kölgəsi altında balalar çıxaracaq.","poem":1},{"lineBreak":true},{"text":"Çalağanlar da orada cüt-cüt yığışacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbbin kitabını araşdırın, oxuyun,","poem":1},{"lineBreak":true},{"text":"Bunlardan heç biri əskik olmayacaq,","poem":1},{"lineBreak":true},{"text":"Hər bir dişi heyvan öz cütünü tapacaq,","poem":1},{"lineBreak":true},{"text":"Çünki bu əmr Onun ağzından çıxdı,","poem":1},{"lineBreak":true},{"text":"Ruhu da onları toplayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbb Özü onlar üçün püşk atdı,","poem":1},{"lineBreak":true},{"text":"Əli ilə ölkəni ölçüb, onlara payladı.","poem":1},{"lineBreak":true},{"text":"Onlar bu ölkəyə əbədi malik olacaq,","poem":1},{"lineBreak":true},{"text":"Nəsildən-nəslə burada yaşayacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}