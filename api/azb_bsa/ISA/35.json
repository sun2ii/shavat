{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Müqəddəs yol"]},{"type":"verse","number":1,"content":[{"text":"Səhra və quru torpaq sevinəcək,","poem":1},{"lineBreak":true},{"text":"Çöl şadlanacaq, nərgiz kimi çiçəklənəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hər yan gül açacaq,","poem":1},{"lineBreak":true},{"text":"Şadlanacaq, sevincdən nəğmə oxuyacaq.","poem":1},{"lineBreak":true},{"text":"Livanın gözəlliyi, şan-şöhrəti,","poem":1},{"lineBreak":true},{"text":"Karmelin və Şaronun cah-calalı ona veriləcək.","poem":1},{"lineBreak":true},{"text":"Hamı Rəbbin izzətini, Allahımızın əzəmətini görəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zəif əllərə qüvvət verin,","poem":1},{"lineBreak":true},{"text":"Əsən dizləri möhkəmləndirin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ürəklərində qorxanlara deyin:","poem":1},{"lineBreak":true},{"text":"«Möhkəm olun, qorxmayın!","poem":1},{"lineBreak":true},{"text":"Budur, Allahınız","poem":1},{"lineBreak":true},{"text":"İntiqam almaq, düşmənlərinizdən qisas almaq üçün gəlir.","poem":1},{"lineBreak":true},{"text":"O gəlib sizə qurtuluş verəcək!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O vaxt korların gözləri, karların qulaqları açılacaq,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Axsaqlar ceyran kimi hoppanacaq,","poem":1},{"lineBreak":true},{"text":"Lalların dili sevinclə nəğmə deyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki səhrada bulaqlar fışqıracaq,","poem":1},{"lineBreak":true},{"text":"Quru torpaqda çaylar axacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qızmar qum hovuza, susuz torpaq su bulaqlarına çevriləcək.","poem":1},{"lineBreak":true},{"text":"Çaqqalların yaşadığı yerlərdə qamış və qarğı bitəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Orada bir yol olacaq,","poem":1},{"lineBreak":true},{"text":"O yol «Müqəddəs yol» adlanacaq.","poem":1},{"lineBreak":true},{"text":"Murdar adam oradan keçməyəcək,","poem":1},{"lineBreak":true},{"text":"O yol qurtuluş tapanların yoludur.","poem":1},{"lineBreak":true},{"text":"Ora ilə gedənlərdən heç biri,","poem":1},{"lineBreak":true},{"text":"Hətta ağılsızlar da keçsələr,","poem":1},{"lineBreak":true},{"text":"Əsla yolunu azmayacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Orada şirlər olmayacaq,","poem":1},{"lineBreak":true},{"text":"Yırtıcı heyvanlar o yola çıxmayacaq,","poem":1},{"lineBreak":true},{"text":"Onlara orada rast gəlməyəcəklər.","poem":1},{"lineBreak":true},{"text":"Ancaq qurtuluş tapanlar o yol ilə gəzəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbbin satın alınmış adamları qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Sevinclə nəğmə deyərək Siona gələcək.","poem":1},{"lineBreak":true},{"text":"Üzlərində əbədi sevinc olacaq,","poem":1},{"lineBreak":true},{"text":"Onlar fərəh və şadlıq tapacaq,","poem":1},{"lineBreak":true},{"text":"Kədər və qəm-qüssə yox olacaq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}