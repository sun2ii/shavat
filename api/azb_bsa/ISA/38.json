{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Xizqiyanın xəstələnməsi"]},{"type":"verse","number":1,"content":["O günlərdə Xizqiya ölümcül xəstələndi. Peyğəmbər Amots oğlu Yeşaya onun yanına gəlib dedi: «Rəbb belə deyir: “Evin üçün vəsiyyət et, çünki xəstəlikdən sağalmayıb öləcəksən”»."]},{"type":"verse","number":2,"content":["Xizqiya üzünü divara çevirdi və Rəbbə dua edib dedi:"]},{"type":"verse","number":3,"content":["«Yalvarıram, ya Rəbb, yadına sal ki, necə Sənin önündə salehliklə və sidq ürəklə davranmışam, necə Sənin gözündə yaxşı olan işlər etmişəm». Xizqiya acı-acı ağladı."]},{"type":"verse","number":4,"content":["Sonra Rəbbin sözü Yeşayaya nazil oldu:"]},{"type":"verse","number":5,"content":["«Qayıt, Xizqiyaya söylə ki, baban Davudun Allahı Rəbb belə deyir: “Sənin duanı eşitdim, göz yaşlarını gördüm. Bax sənin ömrünü on beş il artırıram."]},{"type":"verse","number":6,"content":["Səni və bu şəhəri Aşşur padşahının əlindən qurtaracağam. Bu şəhəri qoruyacağam."]},{"type":"verse","number":7,"content":["Söylədiyi sözə əməl edəcəyinə Rəbbin verdiyi əlamət budur:"]},{"type":"verse","number":8,"content":["batan günəşin Axazın tikdiyi günəş saatının üstünə düşən kölgəsi on dərəcə geri çəkiləcək”». Beləliklə, günəş enmə dərəcəsindən on dərəcə geri çəkildi."]},{"type":"verse","number":9,"content":["Yəhuda padşahı Xizqiya xəstələnib şəfa tapdığından sonra bunu yazdı:"]},{"type":"verse","number":10,"content":[{"text":"«Mən öz-özümə dedim:","poem":1},{"lineBreak":true},{"text":"Ömrüm yarıya çatan zaman","poem":1},{"lineBreak":true},{"text":"Ölülər diyarının qapısından keçməliyəm,","poem":1},{"lineBreak":true},{"text":"Həyatımın qalan illərindən məhrum olmuşam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dedim, Rəbbi dirilər arasında,","poem":1},{"lineBreak":true},{"text":"Bəli, Rəbbi bir daha görməyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bu dünyada yaşayanlar kimi","poem":1},{"lineBreak":true},{"text":"Artıq insan üzü görməyəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Evim çoban çadırı kimi dağıldı,","poem":1},{"lineBreak":true},{"text":"Əlimdən alındı.","poem":1},{"lineBreak":true},{"text":"Həyatım dəzgahda toxunan saplar kimi dövr edirdi,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, bu dəzgahdan məni kəsdin.","poem":1},{"lineBreak":true},{"text":"Bir günün içində əcəlimi çatdırdın.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Səhərə qədər ağrılardan çığırdım,","poem":1},{"lineBreak":true},{"text":"Rəbb aslan tək bütün sümüklərimi qırır.","poem":1},{"lineBreak":true},{"text":"Bir günün içində əcəlimi çatdırdın.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qaranquş kimi, durna kimi çığırdım,","poem":1},{"lineBreak":true},{"text":"Mən göyərçin tək inləyirəm.","poem":1},{"lineBreak":true},{"text":"Göyə baxmaqdan gözlərim yoruldu.","poem":1},{"lineBreak":true},{"text":"Ya Xudavənd, imdadıma çat, zülmə düşmüşəm!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nə deyim? Mənimlə danışan, bunu edən Rəbdir.","poem":1},{"lineBreak":true},{"text":"Çəkdiyim əzablardan sonra qalan illərimi","poem":1},{"lineBreak":true},{"text":"Sakit yaşayacağam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ya Xudavənd, adamları yaşadan Sənsən,","poem":1},{"lineBreak":true},{"text":"Məni də Sən yaşadırsan.","poem":1},{"lineBreak":true},{"text":"Məni yenə canlandıracaqsan,","poem":1},{"lineBreak":true},{"text":"Yaşat məni!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çəkdiyim əzab-əziyyətim mənim xeyrimə oldu.","poem":1},{"lineBreak":true},{"text":"Sən sevginlə canımı qəbirdən qurtardın,","poem":1},{"lineBreak":true},{"text":"Bütün günahlarımı aradan götürdün.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Axı ölülər diyarı Sənə şükür etməz,","poem":1},{"lineBreak":true},{"text":"Ölüm həmdlər söyləməz,","poem":1},{"lineBreak":true},{"text":"Qəbirə düşənlər Sənin sədaqətinə ümid etməz.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bu gün Sənə etdiyim kimi","poem":1},{"lineBreak":true},{"text":"Dirilər, yalnız dirilər Sənə şükür edər.","poem":1},{"lineBreak":true},{"text":"Atalar Sənin sədaqətini övladlarına tanıtdırır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rəbb mənə qurtuluş verdi,","poem":1},{"lineBreak":true},{"text":"Ömrümüz boyu Rəbbin məbədində","poem":1},{"lineBreak":true},{"text":"Səni simli alətlərlə, ilahilərlə mədh edərik».","poem":1}]},{"type":"verse","number":21,"content":["Əvvəl Yeşaya demişdi: «Əncir kündəsi götürün, çibanın üstünə qoyun ki, padşah sağalsın»."]},{"type":"verse","number":22,"content":["Xizqiya dedi: «Rəbbin məbədinə qalxmağım üçün əlamət nədir?»"]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}