{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Təsəlliverici sözlər"]},{"type":"verse","number":1,"content":[{"text":"Allahınız deyir:","poem":1},{"lineBreak":true},{"text":"«Təsəlli verin xalqıma, təsəlli verin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yerusəlim sakinlərinə təskinlik verən sözlər söyləyin!","poem":1},{"lineBreak":true},{"text":"Əsirlik dövrünün qurtarmasını,","poem":1},{"lineBreak":true},{"text":"Təqsirlərinin əvəzinin verilməsini,","poem":1},{"lineBreak":true},{"text":"Bütün günahlarına görə Rəbbin əlindən","poem":1},{"lineBreak":true},{"text":"İkiqat cəza aldıqlarını onlara bəyan edin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nida edənin səsi gəlir:","poem":1},{"lineBreak":true},{"text":"«Səhrada Rəbbin yolunu hazırlayın,","poem":1},{"lineBreak":true},{"text":"Çöldə Allahımızın keçəcəyi yerləri hamar edin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hər dərə yüksəldiləcək,","poem":1},{"lineBreak":true},{"text":"Hər dağ və təpə aşağı endiriləcək,","poem":1},{"lineBreak":true},{"text":"Yoldakı əyriliklər düzələcək,","poem":1},{"lineBreak":true},{"text":"Kələ-kötür yerlər hamar ediləcək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbin əzəməti aşkar olunacaq,","poem":1},{"lineBreak":true},{"text":"Bütün bəşər bunu birlikdə görəcək».","poem":1},{"lineBreak":true},{"text":"Bu sözlər Rəbbin ağzından çıxıb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Səs deyir: «Bəyan et!»","poem":1},{"lineBreak":true},{"text":"«Nəyi bəyan edim?» deyə soruşdum.","poem":1},{"lineBreak":true},{"text":"«Bütün bəşər ota bənzər,","poem":1},{"lineBreak":true},{"text":"Onun bütün gözəlliyi çöl çiçəyi kimidir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb nəfəsini üzərinə üfürəndə","poem":1},{"lineBreak":true},{"text":"Ot quruyar, çiçək solar,","poem":1},{"lineBreak":true},{"text":"Həqiqətən, bu xalq ota oxşar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ot quruyar, çiçək solar,","poem":1},{"lineBreak":true},{"text":"Amma Allahımızın sözü əbədi qalar».","poem":1}]},{"type":"heading","content":["İsrail Allahı qüdrətlidir"]},{"type":"verse","number":9,"content":[{"text":"Ey Siona müjdə gətirən, yüksək dağa çıx!","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlimə xoş xəbər gətirən,","poem":1},{"lineBreak":true},{"text":"Ucalt səsini, car çək,","poem":1},{"lineBreak":true},{"text":"Qaldır səsini, qorxma.","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərinə de:","poem":1},{"lineBreak":true},{"text":"«Budur Allahınız!»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Budur, Xudavənd Rəbb Öz qüvvəsi ilə gəlir,","poem":1},{"lineBreak":true},{"text":"O, qüdrətlə hökm edəcək,","poem":1},{"lineBreak":true},{"text":"Mükafatı Onunladır,","poem":1},{"lineBreak":true},{"text":"Ənamı önündədir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O Öz sürüsünü çoban kimi otaracaq,","poem":1},{"lineBreak":true},{"text":"Quzuları qucağına alacaq, sinəsində gəzdirəcək,","poem":1},{"lineBreak":true},{"text":"Sağmal heyvanların qayğısını çəkib otaracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kim dənizləri ovcu ilə,","poem":1},{"lineBreak":true},{"text":"Göyləri qarışı ilə ölçüb?","poem":1},{"lineBreak":true},{"text":"Yerin torpağını ölçü ilə,","poem":1},{"lineBreak":true},{"text":"Dağları qapanla,","poem":1},{"lineBreak":true},{"text":"Təpələri tərəzi ilə kim çəkib?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbbin Ruhuna kim yol göstərdi?","poem":1},{"lineBreak":true},{"text":"Ona kim məsləhətçi olub öyrətdi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ağıl öyrənmək üçün O kimdən məsləhət alıb?","poem":1},{"lineBreak":true},{"text":"Ədalət yolunu kimdir ona göstərən?","poem":1},{"lineBreak":true},{"text":"Kimdir Rəbbə bilik verən?","poem":1},{"lineBreak":true},{"text":"Kimdir Ona dərrakə yolunu anladan?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rəbb üçün millətlər vedrədə bir damla su kimidir,","poem":1},{"lineBreak":true},{"text":"Tərəzidə toz zərrəsi kimi sayılar,","poem":1},{"lineBreak":true},{"text":"Budur, adaları da toz kimi göyə sovurar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qurbanları yandırmaq üçün","poem":1},{"lineBreak":true},{"text":"Livan meşəsi kifayət deyil,","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanlar üçün oradakı heyvanlar bəs deyil.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbbin önündə bütün millətlər heçdir,","poem":1},{"lineBreak":true},{"text":"Bu Onun önündə heçdən də az, boş sayılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bəs onda Allahı kimə bənzədərsiniz?","poem":1},{"lineBreak":true},{"text":"Onu nəyə oxşadarsınız?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bütəmi? Onu usta tökür,","poem":1},{"lineBreak":true},{"text":"Zərgər qızılla örtür,","poem":1},{"lineBreak":true},{"text":"Gümüş zəncirlərlə bəzəyir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Belə təqdimi gətirə bilməyən yoxsul adam","poem":1},{"lineBreak":true},{"text":"Çürüməyən bir ağac seçər,","poem":1},{"lineBreak":true},{"text":"Məharətli usta tapar ki,","poem":1},{"lineBreak":true},{"text":"Yerindən tərpənməyən büt düzəltsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Məgər siz bilmirsiniz?","poem":1},{"lineBreak":true},{"text":"Məgər eşitməmisiniz?","poem":1},{"lineBreak":true},{"text":"Başlanğıcdan bəri bunu sizə bildirmədilərmi?","poem":1},{"lineBreak":true},{"text":"Dünyanın təməli qoyulduqdan bəri bunu dərk etmədinizmi?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Rəbb göy qübbəsinin üstündə oturur,","poem":1},{"lineBreak":true},{"text":"Yer üzündə yaşayanlar çəyirtkə kimidir.","poem":1},{"lineBreak":true},{"text":"Göyləri tül pərdə kimi açır,","poem":1},{"lineBreak":true},{"text":"Onları yaşamaq üçün çadır kimi qurur.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Rəbb padşahları heç edər,","poem":1},{"lineBreak":true},{"text":"Dünya hökmdarlarını heçə endirər.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onlar yenicə basdırılan, yenicə əkilən,","poem":1},{"lineBreak":true},{"text":"Gövdələri yenicə kök salan ağaclara bənzəyər.","poem":1},{"lineBreak":true},{"text":"Üzərlərindən Rəbbin küləyi əsəndə quruyarlar,","poem":1},{"lineBreak":true},{"text":"Qasırğa onları saman çöpü kimi sovurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Bəs Məni onda kimə bənzədərsiniz ki,","poem":1},{"lineBreak":true},{"text":"Mən ona oxşayım?»","poem":1},{"lineBreak":true},{"text":"Deyir Müqəddəs Olan.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Başınızı göylərə qaldırıb baxın:","poem":1},{"lineBreak":true},{"text":"Bunları kim yaratdı?","poem":1},{"lineBreak":true},{"text":"Rəbb göy cisimlərini sıraya düzüb çıxarar,","poem":1},{"lineBreak":true},{"text":"Onların hamısını adları ilə çağırar.","poem":1},{"lineBreak":true},{"text":"Bol qüvvəsinə, böyük qüdrətinə görə","poem":1},{"lineBreak":true},{"text":"Onlardan heç biri əskik olmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ey Yaqub nəsli, ey İsrail!","poem":1},{"lineBreak":true},{"text":"Nə üçün «Rəbb başıma gələnləri bilmir,","poem":1},{"lineBreak":true},{"text":"Allahım mənim haqqıma diqqətsizlik edir?»","poem":1},{"lineBreak":true},{"text":"Deyib gileylənirsən?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Məgər sən bilmirsən?","poem":1},{"lineBreak":true},{"text":"Məgər eşitməmisən?","poem":1},{"lineBreak":true},{"text":"Rəbb əbədi Allahdır,","poem":1},{"lineBreak":true},{"text":"Odur bütün dünyanı yaradan.","poem":1},{"lineBreak":true},{"text":"Nə yorulur, nə taqətdən düşür,","poem":1},{"lineBreak":true},{"text":"Onun ağlı dərkedilməzdir.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"O, yorğunlara güc verər,","poem":1},{"lineBreak":true},{"text":"Taqətsizlərin qüvvətini artırar.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hətta cavanlar yorular, taqətdən düşər,","poem":1},{"lineBreak":true},{"text":"İgidlər əldən düşüb titrəyər.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Rəbbə ümid bağlayanlarsa","poem":1},{"lineBreak":true},{"text":"Yeni qüvvət alar,","poem":1},{"lineBreak":true},{"text":"Qanad açıb qartal kimi yüksəklərə uçar,","poem":1},{"lineBreak":true},{"text":"Qaçanda taqətdən düşməzlər,","poem":1},{"lineBreak":true},{"text":"Yol gedib yorulmazlar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}