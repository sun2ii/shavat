{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Allahın İsrailə verdiyi təminat"]},{"type":"verse","number":1,"content":["Rəbb deyir:",{"text":"«Susun qarşımda, ey uzaq diyarlar!","poem":1},{"lineBreak":true},{"text":"Qoy ümmətlər yeni güc alsın,","poem":1},{"lineBreak":true},{"text":"Qoy yaxınlaşıb danışsınlar,","poem":1},{"lineBreak":true},{"text":"Məhkəmə üçün birgə toplaşaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ədalətli adamı şərqdən kim ayağa qaldırdı?","poem":1},{"lineBreak":true},{"text":"Kim ona xidmət etməyi əmr etdi?","poem":1},{"lineBreak":true},{"text":"Millətləri onun ixtiyarına kim verdi?","poem":1},{"lineBreak":true},{"text":"Padşahları kim məğlub etdi?","poem":1},{"lineBreak":true},{"text":"O öz qılıncı ilə","poem":1},{"lineBreak":true},{"text":"Onları torpağın tozuna çevirir,","poem":1},{"lineBreak":true},{"text":"Yayı ilə göyə sovrulan samana döndərir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O onları təqib edir,","poem":1},{"lineBreak":true},{"text":"Ayaqlarını basmadığı yoldan sağ-salamat keçir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bunları kim etdi, tamamladı?","poem":1},{"lineBreak":true},{"text":"Əzəldən bəri nəsilləri çağıran kimdir?","poem":1},{"lineBreak":true},{"text":"Mən Rəbbəm, birinciyəm və sonuncularla da Mən Oyam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uzaq diyarlar bunu görüb qorxdu,","poem":1},{"lineBreak":true},{"text":"Dünyanın ucqar yerləri lərzəyə gəldi.","poem":1},{"lineBreak":true},{"text":"Onlar yaxınlaşıb gəldilər,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hər kəs qonşusuna kömək edir,","poem":1},{"lineBreak":true},{"text":"Qardaşına «Cəsur ol!» deyir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Usta zərgəri ürəkləndirir,","poem":1},{"lineBreak":true},{"text":"Hamarlayan zindana çəkiclə vuranı ruhlandırır,","poem":1},{"lineBreak":true},{"text":"«Lehim yaxşı oldu» deyir.","poem":1},{"lineBreak":true},{"text":"Büt yerindən laxlamasın deyə bütün mıxları bərkidirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakin sən ey qulum İsrail,","poem":1},{"lineBreak":true},{"text":"Seçdiyim Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Dostum İbrahimin övladları!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Səni dünyanın ucqar yerlərindən topladım,","poem":1},{"lineBreak":true},{"text":"Ən uzaq yerlərdən səslədim:","poem":1},{"lineBreak":true},{"text":"«Sən qulumsan, səni seçdim, rədd etmədim» dedim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qorxma, çünki Mən səninləyəm,","poem":1},{"lineBreak":true},{"text":"Dəhşətə gəlmə, çünki Allahın Mənəm.","poem":1},{"lineBreak":true},{"text":"Səni qüvvətləndirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sənə kömək edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Sadiq sağ əlimlə sənə dayaq olacağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sənə qarşı hirslənənlər hamısı xəcalət çəkib biabır olacaq,","poem":1},{"lineBreak":true},{"text":"Sənə qarşı çıxanlar heçə çıxıb tələf olacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Səninlə düşmənçilik edənləri axtaracaqsan,","poem":1},{"lineBreak":true},{"text":"Amma tapa bilməyəcəksən,","poem":1},{"lineBreak":true},{"text":"Səninlə vuruşanlar heç olacaq,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çünki sənin sağ əlindən tutub","poem":1},{"lineBreak":true},{"text":"«Qorxma, sənə kömək edəcəyəm» deyən Allahın Rəbb Mənəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Ey torpaq qurdu olan Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Ey İsrail əhli, qorxma!","poem":1},{"lineBreak":true},{"text":"Sənə kömək edəcəyəm» Rəbb bəyan edir.","poem":1},{"lineBreak":true},{"text":"Səni Satınalan İsrailin Müqəddəsidir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Budur, səni təzə, dişləri iti vəl edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Sən dağları döyüb əzəcəksən,","poem":1},{"lineBreak":true},{"text":"Təpələri saman çöpü kimi sovuracaqsan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sən onları sovurduqda külək aparacaq,","poem":1},{"lineBreak":true},{"text":"Qasırğa onları dağıdacaq,","poem":1},{"lineBreak":true},{"text":"Sənsə Rəbdə sevinəcəksən,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsi ilə öyünəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Məzlumlar və fəqirlər","poem":1},{"lineBreak":true},{"text":"Su axtarıb tapmayanda","poem":1},{"lineBreak":true},{"text":"Dilləri susuzluqdan quruyur.","poem":1},{"lineBreak":true},{"text":"Mən Rəbb onlara cavab verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Mən İsrailin Allahı onları tərk etməyəcəyəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çılpaq təpələrdən çaylar,","poem":1},{"lineBreak":true},{"text":"Vadilərdə su mənbələri açacağam.","poem":1},{"lineBreak":true},{"text":"Səhranı gölməçəyə, quraq torpağı bulaqlara çevirəcəyəm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Səhrada sidr, əbrişim, mərsin və zeytun əkəcəyəm.","poem":1},{"lineBreak":true},{"text":"Quru torpaqda şam, çinar və sərv ağacını bir sırada salacağam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Beləcə insanlar görüb bilsin,","poem":1},{"lineBreak":true},{"text":"Birgə fikirləşib başa düşsün:","poem":1},{"lineBreak":true},{"text":"Bunu edən Rəbbin əlidir,","poem":1},{"lineBreak":true},{"text":"Bunu yaradan İsrailin Müqəddəsidir.","poem":1}]},{"type":"heading","content":["Rəbb bütlərə səcdə etməyin əleyhinədir"]},{"type":"verse","number":21,"content":[{"text":"Rəbb deyir: «İşinizi təqdim edin,","poem":1},{"lineBreak":true},{"text":"Sübutlarınızı göstərin»,","poem":1},{"lineBreak":true},{"text":"Bunu Yaqubun Padşahı söyləyir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bütlərinizi gətirin və qoy onlar sonra nə olacağını bizə bildirsin,","poem":1},{"lineBreak":true},{"text":"Olub-keçənləri bizə nəql etsin,","poem":1},{"lineBreak":true},{"text":"Biz dərindən düşünüb sonunu öyrənək.","poem":1},{"lineBreak":true},{"text":"Yaxud onlar gələcəyi bizə agah etsin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ey bütlər, bundan sonra baş verən hadisələrdən bizə danışın,","poem":1},{"lineBreak":true},{"text":"Qoy sizin allah olduğunuzu bilək!","poem":1},{"lineBreak":true},{"text":"Yaxşılıq ya pislik edin ki, hamımız qorxub vahiməyə düşək.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amma siz heç nəsiniz, əməlləriniz də heçdir.","poem":1},{"lineBreak":true},{"text":"Sizə səcdə etməyi seçən iyrəncdir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Şimaldan bir nəfəri hərəkətə gətirdim, o gəlir.","poem":1},{"lineBreak":true},{"text":"O, gündoğandan adımı çağıracaq.","poem":1},{"lineBreak":true},{"text":"Dulusçu gili tapdalayan kimi","poem":1},{"lineBreak":true},{"text":"O, hökmdarları palçıq kimi tapdalayacaq.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kim bunu başlanğıcdan bəyan etdi ki, biz bilək,","poem":1},{"lineBreak":true},{"text":"Əvvəlcədən kim bildirdi ki,","poem":1},{"lineBreak":true},{"text":"Biz «O haqlıdır» deyə bilək?","poem":1},{"lineBreak":true},{"text":"Amma bunu bəyan edən yox idi,","poem":1},{"lineBreak":true},{"text":"Bildirən yox idi,","poem":1},{"lineBreak":true},{"text":"Sözlərinizi eşidən də yox idi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"İlk olaraq Siona «budur, budur onlar» deyirəm.","poem":1},{"lineBreak":true},{"text":"Yerusəlimə müjdəçini göndərəcəyəm.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Baxdım, aralarında öyüd-nəsihət verə bilən heç kim yox idi ki,","poem":1},{"lineBreak":true},{"text":"Onlardan soruşum, bir cavab alım.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Budur, hamısı puçdur,","poem":1},{"lineBreak":true},{"text":"Etdikləri işlər də heç bir şeydir,","poem":1},{"lineBreak":true},{"text":"İnsanların tökmə bütləri yalnız küləkdir, fanidir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}