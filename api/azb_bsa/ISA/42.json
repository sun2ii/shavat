{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Rəbbin qulu"]},{"type":"verse","number":1,"content":[{"text":"Budur, Mənim saxladığım, seçdiyim qulum!","poem":1},{"lineBreak":true},{"text":"Könlüm ondan razıdır!","poem":1},{"lineBreak":true},{"text":"Mən Öz Ruhumu onun üzərinə qoymuşam.","poem":1},{"lineBreak":true},{"text":"O, millətlərə ədalət gətirəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çığırmayacaq, səsini qaldırmayacaq,","poem":1},{"lineBreak":true},{"text":"Küçələrdə heç kim onun səsini eşitməyəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əzilmiş qamışı qırmayacaq,","poem":1},{"lineBreak":true},{"text":"Tüstülənən piltəni söndürməyəcək.","poem":1},{"lineBreak":true},{"text":"O, ədaləti sədaqətlə yayacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O, yer üzündə ədaləti quranadək","poem":1},{"lineBreak":true},{"text":"Ümidini, cəsarətini itirməyəcək,","poem":1},{"lineBreak":true},{"text":"Uzaq diyarlar onun qanununa etibar edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Göyləri yaradıb onları sərən,","poem":1},{"lineBreak":true},{"text":"Yeri və onun üzərindəkiləri düzəldən,","poem":1},{"lineBreak":true},{"text":"Dünyadakı adamlara nəfəs verən,","poem":1},{"lineBreak":true},{"text":"Yer üzündə gəzən insanlara ruh verən","poem":1},{"lineBreak":true},{"text":"Rəbb Allah belə deyir:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Mən Rəbb salehliyimlə səni çağırdım,","poem":1},{"lineBreak":true},{"text":"Səni əlindən tutacağam,","poem":1},{"lineBreak":true},{"text":"Səni qoruyacağam,","poem":1},{"lineBreak":true},{"text":"Səni xalqım üçün əhd edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Millətlərə nur edəcəyəm ki,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Korların gözlərini açasan,","poem":1},{"lineBreak":true},{"text":"Zindandan dustaqları,","poem":1},{"lineBreak":true},{"text":"Zülmətdə, həbsxanada oturanları azad edəsən.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mən Rəbbəm, adım budur.","poem":1},{"lineBreak":true},{"text":"Öz izzətimi heç kimə vermərəm,","poem":1},{"lineBreak":true},{"text":"Həmdlərimi bütlərə bəxş etmərəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Budur, əvvəlki işlər həyata keçdi,","poem":1},{"lineBreak":true},{"text":"İndi Mən təzə işləri bəyan edirəm,","poem":1},{"lineBreak":true},{"text":"Onlar yetişməmişdən əvvəl","poem":1},{"lineBreak":true},{"text":"Sizi xəbərdar edirəm».","poem":1}]},{"type":"heading","content":["Şükür ilahisi"]},{"type":"verse","number":10,"content":[{"text":"Ey dəniz səyyahları, dənizdəki canlılar,","poem":1},{"lineBreak":true},{"text":"Uzaq diyarlar və orada yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Rəbbə yeni ilahi oxuyun!","poem":1},{"lineBreak":true},{"text":"Dünyanın ən ucqar yerlərindən","poem":1},{"lineBreak":true},{"text":"Ona həmdlər gətirin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qoy səhra və oradakı şəhərlər,","poem":1},{"lineBreak":true},{"text":"Qedar xalqı yaşayan kəndlər səsini ucaltsın,","poem":1},{"lineBreak":true},{"text":"Sela sakinləri tərənnüm nəğməsi söyləsin,","poem":1},{"lineBreak":true},{"text":"Dağların zirvəsindən qışqırsın.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hamı Rəbbi izzətləndirsin,","poem":1},{"lineBreak":true},{"text":"Uzaq diyarlar da Ona həmd etsin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb cəsur igid kimi çıxacaq,","poem":1},{"lineBreak":true},{"text":"Cəngavər kimi qeyrətə gələcək,","poem":1},{"lineBreak":true},{"text":"Çığırıb döyüş nərəsi çəkəcək,","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə Öz qüdrətini göstərəcək.","poem":1}]},{"type":"heading","content":["Rəbb Öz xalqına kömək etməyi vəd verir"]},{"type":"verse","number":14,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Xeyli vaxtdır ki, dinmirəm,","poem":1},{"lineBreak":true},{"text":"Susuram, səbir edirəm,","poem":1},{"lineBreak":true},{"text":"İndi isə doğuş ağrısı çəkən qadın kimi","poem":1},{"lineBreak":true},{"text":"Qışqıracağam, təngnəfəs olub zarıyacağam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dağları, təpələri dağıdacağam,","poem":1},{"lineBreak":true},{"text":"Bütün yaşıllıqlarını qurudacağam,","poem":1},{"lineBreak":true},{"text":"Çayları adalara çevirəcəyəm, hovuzları qurudacağam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Korları tanımadıqları yolla aparacağam,","poem":1},{"lineBreak":true},{"text":"Onlara bilmədikləri yollarda rəhbər olacağam.","poem":1},{"lineBreak":true},{"text":"Qaranlığı qarşılarında işığa,","poem":1},{"lineBreak":true},{"text":"Kələ-kötür yolları düzənliyə çevirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bu şeyləri onlar üçün edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onları tərk etməyəcəyəm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Oyma bütlərə güvənənlər,","poem":1},{"lineBreak":true},{"text":"Tökmə bütlərə “Sizsiniz allahlarımız” deyənlər","poem":1},{"lineBreak":true},{"text":"Geri qaytarılıb utandırılacaq.","poem":1}]},{"type":"heading","content":["Kor və kar İsrail"]},{"type":"verse","number":18,"content":[{"text":"Ey karlar, eşidin!","poem":1},{"lineBreak":true},{"text":"Ey korlar, baxın, görün!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Qulum qədər kor olan varmı?","poem":1},{"lineBreak":true},{"text":"Göndərdiyim qasid qədər kar olan varmı?","poem":1},{"lineBreak":true},{"text":"Özünü Mənə həsr edən, Rəbbin qulu qədər kor olan varmı?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Siz çox şey gördünüz, amma nəzərə almadınız,","poem":1},{"lineBreak":true},{"text":"Qulaqlarınız açıq idi, amma eşitmədiniz!»","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbb Öz salehliyi naminə","poem":1},{"lineBreak":true},{"text":"Qanununu ucaldıb izzətləndirməkdən xoşlandı.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lakin bu qarət olunmuş, soyulmuş xalqdır.","poem":1},{"lineBreak":true},{"text":"Hamısı qazamatlarda buxovlanıb zindanlarda saxlanılmışdır.","poem":1},{"lineBreak":true},{"text":"Onlar ovlanıb və qurtaranları yoxdur.","poem":1},{"lineBreak":true},{"text":"Onları qarət edirlər, «geri qaytarın» deyən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sizdən kim buna qulaq asacaq,","poem":1},{"lineBreak":true},{"text":"Gələcəkdə kim diqqətlə dinləyəcək?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yaqub nəslini, İsraili soyğunçular əlinə","poem":1},{"lineBreak":true},{"text":"Kim qarət edilmək üçün təslim etdi?","poem":1},{"lineBreak":true},{"text":"Məgər qarşısında günah işlətdiyimiz Rəbb deyilmi?","poem":1},{"lineBreak":true},{"text":"Onlar Onun yolları ilə getmək istəmədi,","poem":1},{"lineBreak":true},{"text":"Qanununa qulaq asmadı.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Buna görə alovlu qəzəbini, döyüşün şiddətini üstlərinə yağdırdı.","poem":1},{"lineBreak":true},{"text":"Od onları dövrəyə aldı,","poem":1},{"lineBreak":true},{"text":"Amma onlar anlamadılar,","poem":1},{"lineBreak":true},{"text":"Onları yandırdı,","poem":1},{"lineBreak":true},{"text":"Amma ona ciddi fikir vermədilər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}