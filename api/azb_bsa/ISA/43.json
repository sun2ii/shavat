{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["İsrailin yeganə qurtarıcısı Rəbdir"]},{"type":"verse","number":1,"content":[{"text":"İndi isə, ey Yaqub, ey İsrail, səni yaradan,","poem":1},{"lineBreak":true},{"text":"Sənə həyat verən Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Qorxma, çünki Mən səni satın aldım,","poem":1},{"lineBreak":true},{"text":"Səni adınla çağırdım, sən Mənimsən.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dərin sulardan keçsən belə,","poem":1},{"lineBreak":true},{"text":"Mən səninlə olacağam,","poem":1},{"lineBreak":true},{"text":"Çaylardan keçəndə batmayacaqsan,","poem":1},{"lineBreak":true},{"text":"Odun içindən qaçsan belə, yanmayacaqsan,","poem":1},{"lineBreak":true},{"text":"Alov səni məhv etməyəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki Mən sənin Allahın Rəbbəm,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsiyəm,","poem":1},{"lineBreak":true},{"text":"Sənin Xilaskarınam.","poem":1},{"lineBreak":true},{"text":"Misiri sənin üçün fidyə,","poem":1},{"noteId":12},{"lineBreak":true},{"text":"Kuş və Seva ölkələrini","poem":1},{"lineBreak":true},{"text":"Sənin azadlığının əvəzinə verdim.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sən nəzərimdə qiymətli, çox əziz olduğuna görə","poem":1},{"lineBreak":true},{"text":"Səni sevdiyim üçün,","poem":1},{"lineBreak":true},{"text":"Sənin əvəzinə adamları, həyatın üçün ümmətləri verəcəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qorxma, Mən səninləyəm,","poem":1},{"lineBreak":true},{"text":"Nəslindən olanları şərqdən gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Səni qərbdən toplayacağam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Şimala “ver” deyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Cənuba “saxlama” söyləyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Oğullarımı uzaqlardan,","poem":1},{"lineBreak":true},{"text":"Qızlarımı dünyanın ucqar yerlərindən gətir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mənim adımla çağırılan hər insanı,","poem":1},{"lineBreak":true},{"text":"İzzətim üçün yaratdığım,","poem":1},{"lineBreak":true},{"text":"Bəli, həyat verdiyim,","poem":1},{"lineBreak":true},{"text":"Yaratdığım hər bir adamı gətir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gözləri olan kor,","poem":1},{"lineBreak":true},{"text":"Qulaqları olan kar xalqı gətir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bütün millətlər bir yerə yığılsın,","poem":1},{"lineBreak":true},{"text":"Ümmətlər toplansın.","poem":1},{"lineBreak":true},{"text":"Bunlardan kim bu sözü bəyan edər?","poem":1},{"lineBreak":true},{"text":"Olub-keçənləri bizə bildirər?","poem":1},{"lineBreak":true},{"text":"Qoy onların şahidləri irəli gəlib bəraət qazansın,","poem":1},{"lineBreak":true},{"text":"Dinləyib desin: «Bu düzdür».","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: «Sizsiniz Mənim şahidlərim, seçdiyim qullarım,","poem":1},{"lineBreak":true},{"text":"Belə ki Məni tanıyıb, Mənə arxalanasınız,","poem":1},{"lineBreak":true},{"text":"Həm də anlayasınız ki, Mən Oyam.","poem":1},{"lineBreak":true},{"text":"Məndən əvvəl Allah mövcud olmayıb,","poem":1},{"lineBreak":true},{"text":"Məndən sonra da olmayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mənəm Rəbb, yalnız Mənəm,","poem":1},{"lineBreak":true},{"text":"Məndən başqa qurtarıcı yoxdur.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mən dedim və Mən qurtardım,","poem":1},{"lineBreak":true},{"text":"Mən bəyan etdim,","poem":1},{"lineBreak":true},{"text":"Aranızda başqa allahlar yox idi.","poem":1},{"lineBreak":true},{"text":"Sizsiniz şahidlərim».","poem":1},{"lineBreak":true},{"text":"Rəbb bəyan edir, «Allah Mənəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əzəldən bəri Mən Oyam,","poem":1},{"lineBreak":true},{"text":"Mənim əlimdən qurtaran yoxdur.","poem":1},{"lineBreak":true},{"text":"Mən bir şey edəndə buna kim mane ola bilər?»","poem":1}]},{"type":"heading","content":["Babildən qurtuluş"]},{"type":"verse","number":14,"content":[{"text":"Sizi Satınalan, İsrailin Müqəddəsi,","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Sizin xatirinizə Babilə ordu göndərəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onların hamısını qaçqın edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Xaldeylilər də öyündükləri gəmilərlə qaçacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən Rəbbəm, sizin Müqəddəsinizəm,","poem":1},{"lineBreak":true},{"text":"İsraili yaradanam, Padşahınızam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dənizdə və azğın sularda yol, riz açan,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Atlarla döyüş arabalarını,","poem":1},{"lineBreak":true},{"text":"İgid cəngavərləri ilə ordunu birgə yola çıxaran Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Onlar yıxılıb, qalxa bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Basdırılıb piltə kimi söndürüldü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Əvvəlki şeyləri yada salmayın,","poem":1},{"lineBreak":true},{"text":"Köhnə hadisələr barəsində düşünməyin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Budur, Mən təzə bir şey edirəm,","poem":1},{"lineBreak":true},{"text":"O artıq baş verir,","poem":1},{"lineBreak":true},{"text":"Məgər siz bunu başa düşmürsünüz?","poem":1},{"lineBreak":true},{"text":"Bəli, Mən çöllükdə yol salacağam,","poem":1},{"lineBreak":true},{"text":"Quru torpaqda çaylar yaradacağam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mənim seçdiyim xalqıma su içirtmək üçün","poem":1},{"lineBreak":true},{"text":"Çöllükdə su verdiyimə görə,","poem":1},{"lineBreak":true},{"text":"Quru torpaqda çaylar yaratdığıma görə,","poem":1},{"lineBreak":true},{"text":"Vəhşi heyvanlar, çaqqallar və dəvəquşuları Məni ucaldacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bu xalqı Mən Özüm üçün yaratdım ki,","poem":1},{"lineBreak":true},{"text":"Mənə həmdlər söyləsin.","poem":1}]},{"type":"heading","content":["İsrailin günahı"]},{"type":"verse","number":22,"content":[{"text":"Lakin sən, ey Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Mənim adımı çağırmadın,","poem":1},{"lineBreak":true},{"text":"Ey İsrail, Məndən bezdin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yandırma qurbanı üçün Mənə quzular gətirmədin,","poem":1},{"lineBreak":true},{"text":"Qurbanlarınla Mənə ehtiram etmədin.","poem":1},{"lineBreak":true},{"text":"Sənə təqdimlərə görə əziyyət vermədim,","poem":1},{"lineBreak":true},{"text":"Kündür təqdimləri ilə bezdirmədim.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mənim üçün pulla ətirli qamış almadın,","poem":1},{"lineBreak":true},{"text":"Qurbanların piyi ilə Məni doydurmadın.","poem":1},{"lineBreak":true},{"text":"Əksinə, sən günahlarını Mənə yüklədin,","poem":1},{"lineBreak":true},{"text":"Təqsirlərinlə Məni yordun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mənəm Öz xatirimə görə sənin üsyankarlığını silən,","poem":1},{"lineBreak":true},{"text":"Bəli, Mən günahlarını yada salmaram.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yadıma sal, gəl mühakiməyə gedək,","poem":1},{"lineBreak":true},{"text":"Bəraət qazanmaq üçün məhkəmədə işindən danış.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"İlk əcdadların günaha batdı,","poem":1},{"lineBreak":true},{"text":"Rəhbərlərin Mənə qarşı üsyankar oldu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Buna görə də Mən","poem":1},{"lineBreak":true},{"text":"İbadətgahın rəhbərlərini murdarlığa vadar etdim.","poem":1},{"lineBreak":true},{"text":"Yaqub nəslini qırğına, İsraili isə rəzalətə məhkum etdim.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Fidyə – girov tutulmuş yaxud əsir alınmış bir adamı azad etmək üçün verilən pul vəsaiti.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/azb_bsa/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}