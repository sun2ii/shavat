{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Rəbb yeganə Allahdır"]},{"type":"verse","number":1,"content":[{"text":"İndi isə, ey qulum Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Seçdiyim İsrail, qulaq as!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Səni yaradan, ana bətnində quruluş verən,","poem":1},{"lineBreak":true},{"text":"İmdadına çatan Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Qorxma, ey qulum Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Ey seçdiyim Yeşurun!","poem":1},{"noteId":13}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Susamış torpağı sulayacağam,","poem":1},{"lineBreak":true},{"text":"Quru torpağa sellər axıdacağam,","poem":1},{"lineBreak":true},{"text":"Övladlarına Ruhumu ehsan edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Nəslinə xeyir-duamı verəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlar otlar arasında,","poem":1},{"lineBreak":true},{"text":"Axar sular kənarında,","poem":1},{"lineBreak":true},{"text":"Söyüd ağacları kimi boy atacaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Biri ‹Mən Rəbbinəm› deyəcək,","poem":1},{"lineBreak":true},{"text":"O birisi Yaqubun adı ilə çağırılacaq.","poem":1},{"lineBreak":true},{"text":"Digəri də əlinə ‹Rəbbin quluyam› deyə yazacaq,","poem":1},{"lineBreak":true},{"text":"İsrail adını üzərinə götürəcək”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rəbb, İsrailin Padşahı, Satınalanı,","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən birinciyəm, Mən sonuncuyam,","poem":1},{"lineBreak":true},{"text":"Məndən başqa Allah yoxdur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mənə bənzəyən varmı? Xəbər versin.","poem":1},{"lineBreak":true},{"text":"Qədim xalqımı yaratdığımdan bəri olub-keçənləri,","poem":1},{"lineBreak":true},{"text":"Bundan sonra olduqlarını danışıb nəql etsin,","poem":1},{"lineBreak":true},{"text":"Bəli, gələcək hadisələri bildirin!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qorxmayın, dəhşətə gəlməyin,","poem":1},{"lineBreak":true},{"text":"Mən sizə əzəldən bəri bunu söyləyib danışmadımmı?","poem":1},{"lineBreak":true},{"text":"Siz Mənim şahidlərimsiniz!","poem":1},{"lineBreak":true},{"text":"Məndən başqa Allah varmı?","poem":1},{"lineBreak":true},{"text":"Başqa Qaya yoxdur.","poem":1},{"lineBreak":true},{"text":"O birilərini tanımıram».","poem":1}]},{"type":"heading","content":["Bütlərə səcdə edənlər xəcalət çəkəcək"]},{"type":"verse","number":9,"content":[{"text":"Bütləri düzəldən adamlar puçdur,","poem":1},{"lineBreak":true},{"text":"Zövq aldıqları əşyalardan heç bir xeyir yoxdur.","poem":1},{"lineBreak":true},{"text":"Bütlərə qulluq edənlər heç bir şey görmür,","poem":1},{"lineBreak":true},{"text":"Heç bir şey bilmir,","poem":1},{"lineBreak":true},{"text":"Onlar axırda xəcalət içində olacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kim istəyər fayda verməyən allah düzəltsin,","poem":1},{"lineBreak":true},{"text":"Tökmə büt yaratsın?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Budur, bunları düzəldənlərin hamısı xəcalət içində olacaq.","poem":1},{"lineBreak":true},{"text":"Ustalar isə özləri də insandır,","poem":1},{"lineBreak":true},{"text":"Qoy onların hamısı toplaşıb məhkəmədə dursun,","poem":1},{"lineBreak":true},{"text":"Dəhşətə düşüb birlikdə xəcalət çəksin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dəmirçi alətini götürüb,","poem":1},{"lineBreak":true},{"text":"Kömürün odunda işləyir,","poem":1},{"lineBreak":true},{"text":"Çəkiclə dəmirə ölçü verir,","poem":1},{"lineBreak":true},{"text":"Güclü əli ilə üstündə çalışır.","poem":1},{"lineBreak":true},{"text":"Onda ac qalır, taqətdən düşür,","poem":1},{"lineBreak":true},{"text":"Susuz qalıb üzülür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dülgər iplə ölçür,","poem":1},{"lineBreak":true},{"text":"Ağacı tabaşirlə nişanlayır,","poem":1},{"lineBreak":true},{"text":"Rəndələyir, istənilən şəklə salır,","poem":1},{"lineBreak":true},{"text":"Pərgarla dairə çəkir,","poem":1},{"lineBreak":true},{"text":"İnsan surəti verir,","poem":1},{"lineBreak":true},{"text":"İnsan gözəlliyinə bənzər düzəldərək","poem":1},{"lineBreak":true},{"text":"Evinə qoymaq üçün bir büt yaradır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"İnsan özü üçün sidr ağacları kəsir,","poem":1},{"lineBreak":true},{"text":"Şam ağacını, palıd ağacını seçir.","poem":1},{"lineBreak":true},{"text":"Meşədə özü üçün bir ağac götürür,","poem":1},{"lineBreak":true},{"text":"Küknar ağacı əkir və yağış onu böyüdür.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sonra ağac oduna işlənir.","poem":1},{"lineBreak":true},{"text":"İnsan gətirdiyi odunla həm isinir,","poem":1},{"lineBreak":true},{"text":"Həm sobanı yandırır, çörək bişirir.","poem":1},{"lineBreak":true},{"text":"Həm də özünə bir allah düzəldir,","poem":1},{"lineBreak":true},{"text":"Düzəltdiyi bütün qarşısında səcdə edir,","poem":1},{"lineBreak":true},{"text":"Yerə sərilir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Odunun bir hissəsini yandırır,","poem":1},{"lineBreak":true},{"text":"Alovunda ət qızardır,","poem":1},{"lineBreak":true},{"text":"Qarnını doyuraraq, isinib deyir:","poem":1},{"lineBreak":true},{"text":"«Ah, isindim, odun istisini hiss etdim!»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ağacın qalığından özünə allah,","poem":1},{"lineBreak":true},{"text":"Bir oyma büt düzəldib","poem":1},{"lineBreak":true},{"text":"Qarşısında yerə sərilir, səcdə edir.","poem":1},{"lineBreak":true},{"text":"Bu bütə dua edib yalvarır:","poem":1},{"lineBreak":true},{"text":"«Məni xilas et, çünki sənsən mənim allahım!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Onlar bilmir, dərk etmir,","poem":1},{"lineBreak":true},{"text":"Çünki gözləri də, zehinləri də elə bağlıdır ki,","poem":1},{"lineBreak":true},{"text":"Görməzlər, anlamazlar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Buna fikir vermirlər, bilmirlər,","poem":1},{"lineBreak":true},{"text":"Dərk etmirlər ki, belə desinlər:","poem":1},{"lineBreak":true},{"text":"«Odunun bir hissəsini yandırdım,","poem":1},{"lineBreak":true},{"text":"Közündə də çörək bişirdim, ət qızartdım, yedim.","poem":1},{"lineBreak":true},{"text":"Qalığından bir murdar şey düzəldimmi?","poem":1},{"lineBreak":true},{"text":"Bir parça taxtanın qarşısında yerə sərilimmi?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bu, kül yemək kimi boş işdir,","poem":1},{"lineBreak":true},{"text":"Aldanmış ürəkləri onları yoldan azdırır,","poem":1},{"lineBreak":true},{"text":"Canlarını qurtara bilmir və sağ əlimdəki əşya aldadıcı deyilmi?»","poem":1}]},{"type":"heading","content":["Rəbb Yaradan və Xilaskardır"]},{"type":"verse","number":21,"content":[{"text":"«Ey Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Dediyim sözləri xatırla,","poem":1},{"lineBreak":true},{"text":"Çünki sən qulumsan, ey İsrail,","poem":1},{"lineBreak":true},{"text":"Mən səni yaratdım, sən Mənim qulumsan,","poem":1},{"lineBreak":true},{"text":"Səni unutmaram, ey İsrail!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Üsyankarlığını bulud kimi dağıtdım,","poem":1},{"lineBreak":true},{"text":"Günahlarını duman kimi sildim,","poem":1},{"lineBreak":true},{"text":"Mənə tərəf dön,","poem":1},{"lineBreak":true},{"text":"Çünki Mən səni satın aldım».","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tərənnüm edin, ey göylər,","poem":1},{"lineBreak":true},{"text":"Çünki bunu edən Rəbdir.","poem":1},{"lineBreak":true},{"text":"Çığırın, ey torpağın dərinlikləri,","poem":1},{"lineBreak":true},{"text":"Ey dağlar, ey meşə, ey meşədəki bütün ağaclar,","poem":1},{"lineBreak":true},{"text":"Sevincdən haray çəkin,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb Yaqub nəslini satın aldı,","poem":1},{"lineBreak":true},{"text":"İsraildə izzətini aşkar etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Səni Satınalan,","poem":1},{"lineBreak":true},{"text":"Ana bətnində quruluş verən Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Bütün şeyləri yaradan, göyləri təkcə yayan,","poem":1},{"lineBreak":true},{"text":"Təkbaşına yer üzünü sərən,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yalançı peyğəmbərlərin möcüzələrini boşa çıxaran,","poem":1},{"lineBreak":true},{"text":"Falçıları ifşa edən,","poem":1},{"lineBreak":true},{"text":"Müdrikləri geri qaytaran,","poem":1},{"lineBreak":true},{"text":"Onların biliyini heçə çevirən,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Qulunun sözlərini icra edən,","poem":1},{"lineBreak":true},{"text":"Elçilərinin sözlərini gerçək edən,","poem":1},{"lineBreak":true},{"text":"Yerusəlim üçün “burada sakinləri təzədən məskunlaşacaq”,","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərinə “bunlar yenidən qurulacaq,","poem":1},{"lineBreak":true},{"text":"Xarabalıqları yenidən bərpa edəcəyəm” deyən Rəbb Mənəm.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dərin sulara “Quru! Mən çaylarını qurudacağam” söyləyən,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kir haqqında “o, çobanımdır,","poem":1},{"lineBreak":true},{"text":"Xoşuma gələnlərin hamısını həyata keçirəcək”,","poem":1},{"lineBreak":true},{"text":"Yerusəlim haqqında “yenidən qurulacaq”,","poem":1},{"lineBreak":true},{"text":"Məbəd haqqında “təməlin qoyulacaq” deyən Rəbb Mənəm».","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Yeşurun – İsrailin bir ləqəbi olub düz olan mənasını verir.","reference":{"chapter":44,"verse":2}}]},"thisChapterLink":"/api/azb_bsa/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}