{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Rəbb Fars padşahı Kiri seçir"]},{"type":"verse","number":1,"content":[{"text":"Rəbb məsh etdiyi adama –","poem":1},{"lineBreak":true},{"text":"Sağ əlindən tutduğu Kirə belə deyir.","poem":1},{"lineBreak":true},{"text":"Onun önündə millətləri baş əydirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Padşahları qüdrətindən məhrum edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Önündə qapıları açacağam,","poem":1},{"lineBreak":true},{"text":"Darvazalar onun qarşısında bir daha bağlanmayacaq.","poem":1},{"lineBreak":true},{"text":"Rəbb deyir:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Mən qarşında gedib dağları düzəngaha çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Tunc qapıları qırıb","poem":1},{"lineBreak":true},{"text":"Dəmir qıfılları sındıracağam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qaranlıqda gizlənmiş sərvətlərini,","poem":1},{"lineBreak":true},{"text":"Gizli yerlərdə saxlanılan xəzinələri sənə verəcəyəm ki, biləsən:","poem":1},{"lineBreak":true},{"text":"Səni adınla çağıran Rəbb Mənəm, İsrailin Allahıyam Mən.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qulum Yaqub nəsli, seçdiyim İsrail naminə","poem":1},{"lineBreak":true},{"text":"Səni adınla çağırıb hörmət göstərdim,","poem":1},{"lineBreak":true},{"text":"Halbuki sən Məni tanımırdın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbb Mənəm, başqası yoxdur,","poem":1},{"lineBreak":true},{"text":"Məndən başqa Allah yoxdur.","poem":1},{"lineBreak":true},{"text":"Səni Mən gücləndirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Halbuki Məni tanımırdın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beləliklə, gündoğandan günbatana qədər qoy bilsinlər ki,","poem":1},{"lineBreak":true},{"text":"Məndən savayı heç kim yoxdur,","poem":1},{"lineBreak":true},{"text":"Rəbb Mənəm, başqası yoxdur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuru, qaranlığı, sülhü, fəlakəti yaradan Mənəm,","poem":1},{"lineBreak":true},{"text":"Bütün bunları edən Rəbb Mənəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey göylər, yuxarıdan damlayın,","poem":1},{"lineBreak":true},{"text":"Qoy buludlar salehlik yağdırsın,","poem":1},{"lineBreak":true},{"text":"Torpaq açılsın, xilas bəhrəsini yetişdirsin,","poem":1},{"lineBreak":true},{"text":"Onunla birlikdə salehlik bitsin.","poem":1},{"lineBreak":true},{"text":"Bunları yaradan Rəbb Mənəm».","poem":1}]},{"type":"heading","content":["Hər şeyi yaradan Allahdır"]},{"type":"verse","number":9,"content":[{"text":"Yaradanı ilə çəkişənin vay halına!","poem":1},{"lineBreak":true},{"text":"Çəkişən özü də saxsı qablar arasında yalnız saxsı parçasıdır.","poem":1},{"lineBreak":true},{"text":"Gil öz dulusçusuna «Nə düzəldirsən?»","poem":1},{"lineBreak":true},{"text":"Yaxud «yaratdığın şeyin dəstəkləri yoxdur» deyə bilərmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Atasına «Dünyaya məni nə üçün gətirdin?»","poem":1},{"lineBreak":true},{"text":"Anasına «Məni nə üçün doğdun?» deyənin vay halına!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"İsrailin Müqəddəsi,","poem":1},{"lineBreak":true},{"text":"Onu yaradan Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Övladlarımın gələcəyi haqqında","poem":1},{"lineBreak":true},{"text":"Mənə sual verə bilərsinizmi?","poem":1},{"lineBreak":true},{"text":"Gördüklərim işlər barəsində","poem":1},{"lineBreak":true},{"text":"Mənə əmr edə bilərsinizmi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dünyanı da, yer üzündə yaşayan adamı da Mən yaratdım.","poem":1},{"lineBreak":true},{"text":"Mənim əllərim göyləri yaydı,","poem":1},{"lineBreak":true},{"text":"Əmrimlə səma cisimləri quruldu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mən Kiri ədalətlə hərəkət etməyə vadar etdim.","poem":1},{"lineBreak":true},{"text":"Yollarını dürüst edəcəyəm.","poem":1},{"lineBreak":true},{"text":"O, şəhərimi tikəcək,","poem":1},{"lineBreak":true},{"text":"Sürgün olunmuş adamlarımı","poem":1},{"lineBreak":true},{"text":"Fidyəsiz, bəxşişsiz azad edəcək».","poem":1},{"lineBreak":true},{"text":"Bunu Ordular Rəbbi deyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Misirlilərin var-dövləti, Kuşun ticarət gəliri,","poem":1},{"lineBreak":true},{"text":"Ucaboylu Sevalılar yanınıza gəlib qulunuz olacaq.","poem":1},{"lineBreak":true},{"text":"Onlar buxovlanacaq və ardınızca gedəcək,","poem":1},{"lineBreak":true},{"text":"Qarşınızda yerə sərilib yalvaracaq:","poem":1},{"lineBreak":true},{"text":"“Allah yalnız sizinlədir və başqa birisi yoxdur.","poem":1},{"lineBreak":true},{"text":"Bundan savayı Allah yoxdur”».","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Həqiqətən, Sən Özünü gizlədən Allahsan,","poem":1},{"lineBreak":true},{"text":"Ey İsrailin Allahı, ey Qurtarıcı!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Büt düzəldənlərin hamısı utandırılacaq,","poem":1},{"lineBreak":true},{"text":"Rüsvay olacaq, xəcalət çəkib uzaqlaşacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amma İsrailə qurtuluşu Rəbb verəcək.","poem":1},{"lineBreak":true},{"text":"Bu qurtuluş əbədi sürəcək.","poem":1},{"lineBreak":true},{"text":"Əsrlər boyu İsrail utanmayacaq, rüsvay olmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Göyləri yaradan Rəbb bircə olan Allahdır!","poem":1},{"lineBreak":true},{"text":"O, dünyanı yaratdı, ona quruluş verdi,","poem":1},{"lineBreak":true},{"text":"Rəbb dünyanı qarmaqarışıq yaratmadı,","poem":1},{"lineBreak":true},{"text":"Onu yaşamaq üçün qurdu.","poem":1},{"lineBreak":true},{"text":"O deyir: «Mən Rəbbəm, başqası yoxdur!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mən gizlində, qaranlıq dünyasında danışmadım,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinə “Məni qarmaqarışıq yerdə axtarın” demədim.","poem":1},{"lineBreak":true},{"text":"Doğrusunu söyləyən, ədaləti bəyan edən Rəbb Mənəm.","poem":1}]},{"type":"heading","content":["Allah və Babilin bütləri"]},{"type":"verse","number":20,"content":[{"text":"Yığışın, gəlin, bir yerə toplaşın, ey millətlərdən sağ qalan kəslər!","poem":1},{"lineBreak":true},{"text":"Taxta bütləri gəzdirənlər,","poem":1},{"lineBreak":true},{"text":"Xilas verməyən allahlara dua edənlər heç nə bilmir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Danışın, işinizi təqdim edin,","poem":1},{"lineBreak":true},{"text":"Qoy hamı birlikdə məsləhətləşib söyləsin:","poem":1},{"lineBreak":true},{"text":"“Bunu qədimdə kim bəyan etdi,","poem":1},{"lineBreak":true},{"text":"Keçmişdə kim bildirdi?”","poem":1},{"lineBreak":true},{"text":"Bunu Mən Rəbb, demədimmi?","poem":1},{"lineBreak":true},{"text":"Məndən başqa Allah,","poem":1},{"lineBreak":true},{"text":"Ədalətli Allah və Qurtarıcı yoxdur.","poem":1},{"lineBreak":true},{"text":"Məndən başqası yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ey yer üzünün qurtaracağınadək hər yerdə yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Mənə tərəf dönün və xilas olun!","poem":1},{"lineBreak":true},{"text":"Çünki Mən Allaham və başqası yoxdur!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Varlığıma and içdim,","poem":1},{"lineBreak":true},{"text":"Ağzımdan çıxan kəlmə doğrudur, boşa çıxmaz.","poem":1},{"lineBreak":true},{"text":"Hər diz önümdə çökəcək,","poem":1},{"lineBreak":true},{"text":"Hər dil Mənə and içəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mənim üçün belə deyəcəklər:","poem":1},{"lineBreak":true},{"text":"“Salehlik və qüvvət yalnız Rəbdədir.","poem":1},{"lineBreak":true},{"text":"Ona qarşı qəzəblənənlər hüzuruna gəlib utanacaqlar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bütün İsrail nəsli Rəbdə haqq qazanacaq və izzətlənəcək”».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}