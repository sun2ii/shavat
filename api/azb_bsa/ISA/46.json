{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"«Bel allahı diz çökdü,","poem":1},{"lineBreak":true},{"text":"Nevo allahı əyildi,","poem":1},{"lineBreak":true},{"text":"Babilin bütləri heyvanlara, öküzlərə yükləndi,","poem":1},{"lineBreak":true},{"text":"Daşınan əşyalar heyvanlara ağır yük oldu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar birgə əyildilər, diz çökdülər,","poem":1},{"lineBreak":true},{"text":"Yük oldular, bundan qurtula bilməyib əsirliyə aparıldılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qulaq asın Mənə, ey Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"Ey bütün İsrail nəslinin sağ qalanları!","poem":1},{"lineBreak":true},{"text":"Anadan olandan sizi aparıram,","poem":1},{"lineBreak":true},{"text":"Bətndən çıxandan sizi daşıyıram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siz qocalanacan Mən Oyam,","poem":1},{"lineBreak":true},{"text":"Saçlarınıza dən düşənəcən","poem":1},{"lineBreak":true},{"text":"Mən sizi aparacağam,","poem":1},{"lineBreak":true},{"text":"Sizi Mən yaratdım, Mən daşıyacağam.","poem":1},{"lineBreak":true},{"text":"Bəli, Mən sizi aparacağam və xilas edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Məni kimə bənzədəcəksiniz, kimə oxşadacaqsınız,","poem":1},{"lineBreak":true},{"text":"Kiminlə müqayisə edəcəksiniz ki, biz oxşar olaq?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kimsə pul kisəsindən qızıl çıxarır,","poem":1},{"lineBreak":true},{"text":"Tərəzidə gümüş çəkir,","poem":1},{"lineBreak":true},{"text":"Bu puldan zərgərə büt düzəltdirir,","poem":1},{"lineBreak":true},{"text":"Sonra önündə yerə sərilib səcdə edir!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onu çiyinlərinə yükləyib daşıyırlar, yerinə qoyurlar.","poem":1},{"lineBreak":true},{"text":"Beləcə büt durur, yerindən tərpənmir.","poem":1},{"lineBreak":true},{"text":"Ona yalvarırlar, o cavab vermir,","poem":1},{"lineBreak":true},{"text":"Heç bir bəladan qurtarmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey üsyankar insanlar, bunu xatırlayın,","poem":1},{"lineBreak":true},{"text":"Mərd olun, yadınızdan çıxarmayın!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qədimdən bəri olan hadisələri xatırlayın,","poem":1},{"lineBreak":true},{"text":"Çünki Allah Mənəm, başqası yoxdur,","poem":1},{"lineBreak":true},{"text":"Mənəm Allah, Mənə bənzəri yoxdur!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Axırı əvvəldən,","poem":1},{"lineBreak":true},{"text":"Baş verməmiş hadisələri əzəldən bildirən,","poem":1},{"lineBreak":true},{"text":"“Niyyətim baş tutacaq,","poem":1},{"lineBreak":true},{"text":"İstədiyim hər şeyi edəcəyəm” deyən Mənəm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Şərqdən bir yırtıcı quşu,","poem":1},{"lineBreak":true},{"text":"Uzaq diyardan niyyətimi yerinə yetirən adamı çağıran Mənəm.","poem":1},{"lineBreak":true},{"text":"Mən bunları dedim,","poem":1},{"lineBreak":true},{"text":"Mütləq yerinə yetirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Mən niyyət etmişəm, bunu icra edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey salehlikdən uzaq olan dikbaş insanlar!","poem":1},{"lineBreak":true},{"text":"Məni dinləyin!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Salehliyiniz yaxındır, uzaq deyil,","poem":1},{"lineBreak":true},{"text":"Qurtuluşum ləngiməyəcək.","poem":1},{"lineBreak":true},{"text":"Siona xilası, İsrailə izzətimi bəxş edəcəyəm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}