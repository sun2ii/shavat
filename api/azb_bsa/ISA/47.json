{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilin düşkünlüyü"]},{"type":"verse","number":1,"content":[{"text":"Ey bakirə Babil qızı,","poem":1},{"lineBreak":true},{"text":"Düş aşağı, torpaqda otur.","poem":1},{"lineBreak":true},{"text":"Ey Xaldey qızı,","poem":1},{"lineBreak":true},{"text":"Artıq taxt yoxdur, yerdə otur.","poem":1},{"lineBreak":true},{"text":"Bundan sonra sənə","poem":1},{"lineBreak":true},{"text":"“Zərif, nazlı” deməyəcəklər.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bir cüt dəyirman daşı götür, unu üyüt.","poem":1},{"lineBreak":true},{"text":"Örpəyini aç, balağını qaldır,","poem":1},{"lineBreak":true},{"text":"Baldırların açıb çaylardan keç.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çılpaqlığın açılacaq, ayıb yerin görünəcək.","poem":1},{"lineBreak":true},{"text":"Mən intiqam alacağam,","poem":1},{"lineBreak":true},{"text":"Heç kimi əsirgəməyəcəyəm».","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bizi Satınalan İsrailin Müqəddəsidir,","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb deyir: «Ey Xaldey qızı,","poem":1},{"lineBreak":true},{"text":"Qaranlığa çəkil, sakitcə otur!","poem":1},{"lineBreak":true},{"text":"Çünki bundan sonra səni daha","poem":1},{"lineBreak":true},{"text":"Padşahlıqların mələkəsi çağırmayacaqlar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Öz xalqıma qəzəbləndim,","poem":1},{"lineBreak":true},{"text":"İrsimi kiçildib sənə verdim.","poem":1},{"lineBreak":true},{"text":"Lakin sən onların halına acımadın,","poem":1},{"lineBreak":true},{"text":"Hətta yaşlılara da ağır boyunduruq yüklədin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Həmişə əbədi mələkə olacağam” deyə düşünürdün.","poem":1},{"lineBreak":true},{"text":"Bunları ürəyinə gətirmirdin, sonu düşünmürdün.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"İndi isə qulaq as, ey əmin-amanlıqda yaşayan zövq düşkünü!","poem":1},{"lineBreak":true},{"text":"Sən ürəyində deyirdin: “Mən mənəm,","poem":1},{"lineBreak":true},{"text":"Məndən başqası yoxdur.","poem":1},{"lineBreak":true},{"text":"Heç vaxt dul qalmayacağam,","poem":1},{"lineBreak":true},{"text":"Övlad itirmək dərdini bilməyəcəyəm”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu iki bəla bir gündə,","poem":1},{"lineBreak":true},{"text":"Qəflətən başına gələcək.","poem":1},{"lineBreak":true},{"text":"Böyük cadugərliyinə, hədsiz ovsunçuluq etdiyinə baxmayaraq,","poem":1},{"lineBreak":true},{"text":"Həm övladlarını itirəcək, həm də dul qalacaqsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pisliyinə güvəndin,","poem":1},{"lineBreak":true},{"text":"Dedin: “Məni heç kim görmür”.","poem":1},{"lineBreak":true},{"text":"Sənin hikmətin və biliyin səni azdırdı.","poem":1},{"lineBreak":true},{"text":"Düşündün: “Mən mənəm,","poem":1},{"lineBreak":true},{"text":"Məndən başqası yoxdur”.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lakin üzərinə bəla gələcək,","poem":1},{"lineBreak":true},{"text":"Sən onun qarşısını ala bilməyəcəksən,","poem":1},{"lineBreak":true},{"text":"Sən xərac versən də, bu fəlakət üstünə gələcək,","poem":1},{"lineBreak":true},{"text":"Bilmədiyin bəla qəflətən üzərinə düşəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gənc yaşlarından bəri","poem":1},{"lineBreak":true},{"text":"Məşğul olduğun ovsunçuluğuna və böyük cadugərliyinə davam et.","poem":1},{"lineBreak":true},{"text":"Bəlkə onlardan bir xeyir görərsən,","poem":1},{"lineBreak":true},{"text":"Bəlkə düşmənlərini onlarla vahiməyə sala bilərsən!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aldığın çoxlu məsləhətlər səni üzdü.","poem":1},{"lineBreak":true},{"text":"Qoy ulduz falına baxanlar, münəccimlər,","poem":1},{"lineBreak":true},{"text":"Yeni ay çıxanda olacaq hadisələri bildirənlər","poem":1},{"lineBreak":true},{"text":"İndi gəlib səni","poem":1},{"lineBreak":true},{"text":"Başına gələn bəlalardan xilas etsinlər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bax, onlar küləş kimidir,","poem":1},{"lineBreak":true},{"text":"Od onları yandırıb-yaxar.","poem":1},{"lineBreak":true},{"text":"Özlərini alovun gücündən xilas edə bilməyəcəklər.","poem":1},{"lineBreak":true},{"text":"Bu alov isinmək üçün kömürlü od deyil,","poem":1},{"lineBreak":true},{"text":"Qabağında oturulacaq od deyil.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sənin işlədiyin, cavanlığından bəri alver etdiyin adamların","poem":1},{"lineBreak":true},{"text":"Aqibəti belə olacaq.","poem":1},{"lineBreak":true},{"text":"Hər kəs öz yolu ilə gedəcək, səni xilas edən olmayacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}