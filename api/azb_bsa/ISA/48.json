{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["İsrailin inadkarlığı"]},{"type":"verse","number":1,"content":[{"text":"Ey Yaqub nəsli,","poem":1},{"lineBreak":true},{"text":"İsrail adı ilə çağırılan,","poem":1},{"lineBreak":true},{"text":"Yəhudanın belindən gələn,","poem":1},{"lineBreak":true},{"text":"Rəbbin adı ilə and içən,","poem":1},{"lineBreak":true},{"text":"İsrail Allahının adını etiraf edən,","poem":1},{"lineBreak":true},{"text":"Fəqət buna həqiqətlə və salehliklə əməl etməyən nəsil,","poem":1},{"lineBreak":true},{"text":"Buna qulaq as!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Müqəddəs şəhərdən olduğunuza görə,","poem":1},{"lineBreak":true},{"text":"İsrail Allahına bel bağladığınıza görə fəxr edirsiniz.","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Olub-keçənləri əvvəldən Mən bəyan etdim.","poem":1},{"lineBreak":true},{"text":"Bu sözlər ağzımdan çıxdı və onları Mən bildirdim.","poem":1},{"lineBreak":true},{"text":"Sonra qəflətən bunları həyata keçirdim və onlar yerinə yetdi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bilirdim inadkar olduğunuzu,","poem":1},{"lineBreak":true},{"text":"Dəmir boyunlusunuz, tunc alınlısınız.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bunları sizə qədimdən bəri bildirdim,","poem":1},{"lineBreak":true},{"text":"Baş verməmişdən əvvəl sizə xəbər verdim ki,","poem":1},{"lineBreak":true},{"text":"Siz “bunu bütüm etdi, oyma və tökmə bütlər","poem":1},{"lineBreak":true},{"text":"Bunları əmr etdilər” deməyəsiniz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bunu eşitdiniz, indi isə hamısına nəzər salın.","poem":1},{"lineBreak":true},{"text":"Bəs bunu qəbul etməyəcəksiniz?","poem":1},{"lineBreak":true},{"text":"İndi isə Mən sizə yeni şeyləri,","poem":1},{"lineBreak":true},{"text":"Bilmədiyiniz gizli şeyləri bildirəcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bunlar indi yaradılır, keçmişdə yox.","poem":1},{"lineBreak":true},{"text":"Siz bunu bu günə qədər bilmədiniz,","poem":1},{"lineBreak":true},{"text":"Ona görə “bunu bilirdik” deyə bilməzsiniz.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siz bu barədə nə eşitmisiniz,","poem":1},{"lineBreak":true},{"text":"Nə də xəbəriniz olub,","poem":1},{"lineBreak":true},{"text":"Keçmişdən bəri qulaqlarınız bağlıdır.","poem":1},{"lineBreak":true},{"text":"Nə qədər xain olduğunuzu bilirəm,","poem":1},{"lineBreak":true},{"text":"Ana bətnindən belə, sizin üsyankar çağırılacağınızdan xəbərdaram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Adım naminə qəzəbimi saxlayırdım,","poem":1},{"lineBreak":true},{"text":"Şöhrətim naminə qeyzimin qabağını alırdım ki, sizi məhv etməyim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Budur, Mən sizi gümüş kimi olmasa da, təmizlədim,","poem":1},{"lineBreak":true},{"text":"Sizi iztirab ocağında çəkdim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Öz xatirimə, Öz xatirimə bunu edirəm.","poem":1},{"lineBreak":true},{"text":"Axı niyə Mənim adım küfrlə çəkilsin?","poem":1},{"lineBreak":true},{"text":"Mən Öz izzətimi heç kimə vermərəm.","poem":1}]},{"type":"heading","content":["Rəbb İsraili satın alır"]},{"type":"verse","number":12,"content":[{"text":"Qulaq as Mənə, ey Yaqub nəsli, çağırdığım İsrail!","poem":1},{"lineBreak":true},{"text":"Mən Oyam, Mən birinciyəm, Mən sonuncuyam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mənim əlim yerin təməlini qoydu,","poem":1},{"lineBreak":true},{"text":"Sağ əlim göyləri sərdi.","poem":1},{"lineBreak":true},{"text":"Mən onları çağıranda onlar birlikdə düzülür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hamınız toplaşın, dinləyin!","poem":1},{"lineBreak":true},{"text":"Bütlərdən hansıdır bu şeyləri bəyan edən?","poem":1},{"lineBreak":true},{"text":"Rəbbin sevdiyi adam Babildə Onun məqsədini yerinə yetirəcək,","poem":1},{"lineBreak":true},{"text":"Onun əli Xaldeylilərə qarşı qalxacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən, bəli Mən dedim,","poem":1},{"lineBreak":true},{"text":"Onu Mən çağırdım,","poem":1},{"lineBreak":true},{"text":"Onu gətirdim,","poem":1},{"lineBreak":true},{"text":"O öz yolunda uğurlu olacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mənə yaxın gəlin, bunu dinləyin!","poem":1},{"lineBreak":true},{"text":"Başlanğıcdan bəri Mən açıq danışdım,","poem":1},{"lineBreak":true},{"text":"O vaxtdan indiyədək oradayam.","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb indi Məni və Ruhunu göndərdi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Səni Satınalan, Rəbb, İsrailin Müqəddəsi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Allahın Rəbb Mənəm,","poem":1},{"lineBreak":true},{"text":"Mən sənin xeyrinə səni öyrədirəm,","poem":1},{"lineBreak":true},{"text":"Getdiyin lazım olan yolla səni aparıram.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ah, kaş ki sən Mənim əmrlərimə diqqət yetirəydin!","poem":1},{"lineBreak":true},{"text":"Onda əmin-amanlığın heç vaxt qurumayan çay kimi axardı,","poem":1},{"lineBreak":true},{"text":"Salehliyin dəniz dalğaları kimi olardı.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nəslin dəniz qumu kimi,","poem":1},{"lineBreak":true},{"text":"Övladların qum dənələri kimi olardı.","poem":1},{"lineBreak":true},{"text":"Adları qarşımda nə pozulardı, nə də silinərdi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Babildən çıxın, Xaldeylilərin torpağından qaçın,","poem":1},{"lineBreak":true},{"text":"Sevinc səsi ilə bəyan edin, bunu bildirin,","poem":1},{"lineBreak":true},{"text":"Dünyanın ən uzaq yerlərinə bu xəbəri çatdırın,","poem":1},{"lineBreak":true},{"text":"Deyin: «Rəbb qulu Yaqub nəslini satın aldı».","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Səhradan keçərkən susuzluq çəkmədilər.","poem":1},{"lineBreak":true},{"text":"Rəbb onlar üçün qayadan su axıtdı,","poem":1},{"lineBreak":true},{"text":"Qayanı yardı və oradan su fışqırdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Pislərə isə sülh yoxdur» Rəbb deyir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}