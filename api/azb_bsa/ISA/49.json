{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Rəbbin qulu çağırışını izah edir"]},{"type":"verse","number":1,"content":[{"text":"Ey uzaq diyarlar, Məni dinləyin!","poem":1},{"lineBreak":true},{"text":"Ey uzaqda yaşayan ümmətlər, yaxşı qulaq asın!","poem":1},{"lineBreak":true},{"text":"Rəbb məni anadan olandan bəri çağırmışdı,","poem":1},{"lineBreak":true},{"text":"Ana bətnindən adımı yadına saldı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ağzımı iti qılınc kimi etdi,","poem":1},{"lineBreak":true},{"text":"O məni əlinin kölgəsində gizlətdi.","poem":1},{"lineBreak":true},{"text":"O məni iti ox edib","poem":1},{"lineBreak":true},{"text":"Öz oxdanında saxladı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mənə dedi: «Qulumsan, ey İsrail,","poem":1},{"lineBreak":true},{"text":"Mən səninlə izzətlənəcəyəm».","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma mən dedim:","poem":1},{"lineBreak":true},{"text":"«Mən boş yerə çalışdım,","poem":1},{"lineBreak":true},{"text":"Gücümü hədər yerə tükətdim.","poem":1},{"lineBreak":true},{"text":"Rəbb mənə yenə haqq qazandırır,","poem":1},{"lineBreak":true},{"text":"Mükafatım Allahımdadır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb məni qulu etmək üçün","poem":1},{"lineBreak":true},{"text":"Ana bətnində mənə quruluş verdi ki,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslini Ona tərəf döndərim,","poem":1},{"lineBreak":true},{"text":"İsraili Onun önünə toplayım.","poem":1},{"lineBreak":true},{"text":"Onun gözündə hörmət qazandım,","poem":1},{"lineBreak":true},{"text":"Qüdrətim Allahım oldu.","poem":1},{"lineBreak":true},{"text":"Rəbb indi belə deyir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O deyir:","poem":1},{"lineBreak":true},{"text":"«Yaqub qəbilələrinin bərpası,","poem":1},{"lineBreak":true},{"text":"İsrailin sağ qalanlarının geri qayıtması üçün","poem":1},{"lineBreak":true},{"text":"Qulum olmağın kifayət deyil.","poem":1},{"lineBreak":true},{"text":"Səni millətlərə nur edəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Xilasım dünyanın ən uzaq yerlərinə yayılsın».","poem":1}]},{"type":"heading","content":["Allah Öz qulunu ruhlandırır"]},{"type":"verse","number":7,"content":[{"text":"Adamların nifrət etdiyi,","poem":1},{"lineBreak":true},{"text":"Millətin həqarətlə baxdığı,","poem":1},{"lineBreak":true},{"text":"Hökmdarların qulu olan şəxsə,","poem":1},{"lineBreak":true},{"text":"İsrailin Satınalanı, Müqəddəsi,","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«İsrailin Müqəddəsi,","poem":1},{"lineBreak":true},{"text":"Sadiq Rəbb səni seçdiyinə görə","poem":1},{"lineBreak":true},{"text":"Padşahlar səni görüb ayağa qalxacaq,","poem":1},{"lineBreak":true},{"text":"Əmirlər qarşında yerə səriləcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Münasib vaxtda sənə cavab verdim,","poem":1},{"lineBreak":true},{"text":"Xilas günü sənə kömək etdim.","poem":1},{"lineBreak":true},{"text":"Səni hifz edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Səni xalqım üçün əhd edəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Dağılmış ölkəni bərpa edəsən,","poem":1},{"lineBreak":true},{"text":"İrs olaraq yenə sahiblərinə verəsən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dustaqlara “çıxın”,","poem":1},{"lineBreak":true},{"text":"Zülmətdə oturanlara","poem":1},{"lineBreak":true},{"text":"“Özünüzü göstərin!” deyəsən.","poem":1},{"lineBreak":true},{"text":"Onlar yol boyunca quzu kimi bəslənəcək,","poem":1},{"lineBreak":true},{"text":"Hər çılpaq təpədə otlaq tapacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar nə ac, nə də susuz qalacaq,","poem":1},{"lineBreak":true},{"text":"Qızmar isti və günəş onları vurmayacaq.","poem":1},{"lineBreak":true},{"text":"Çünki onlara mərhəmət edən yol göstərəcək,","poem":1},{"lineBreak":true},{"text":"Onları bulaqlara doğru yönəldəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mən bütün dağlarımı yola döndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yollarımı hamar edəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Budur, xalqım uzaq yerlərdən,","poem":1},{"lineBreak":true},{"text":"Kimisi şimaldan, kimisi qərbdən,","poem":1},{"lineBreak":true},{"text":"Kimisi isə Sinim","poem":1},{"noteId":14},{"text":"ölkəsindən gələcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tərənnüm edin, ey göylər,","poem":1},{"lineBreak":true},{"text":"Ey yer üzü, fərəhlən!","poem":1},{"lineBreak":true},{"text":"Ey dağlar, sevinc nidalarına qoşulun!","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb xalqına təsəlli verəcək,","poem":1},{"lineBreak":true},{"text":"İztirab çəkənlərinə rəhm edəcək.","poem":1}]},{"type":"heading","content":["Sionun bərpası"]},{"type":"verse","number":14,"content":[{"text":"Amma Sion dedi: «Rəbb məni tərk etdi,","poem":1},{"lineBreak":true},{"text":"Xudavəndim məni unutdu».","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rəbb isə deyir: «Ana südəmər körpəsini heç unudarmı?","poem":1},{"lineBreak":true},{"text":"Bətnindən çıxan oğluna rəhm etməzmi?","poem":1},{"lineBreak":true},{"text":"Ana öz körpəsini unutsa belə,","poem":1},{"lineBreak":true},{"text":"Mən səni əsla unutmaram.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mən sənin adını ovuclarımda həkk etmişəm,","poem":1},{"lineBreak":true},{"text":"Ey Sion, divarların daima önümdədir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Oğulların tələsib yanına gələcək,","poem":1},{"lineBreak":true},{"text":"Səni qarət edənlər, soyğunçular çıxıb-gedəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qaldır başını, bax ətrafına:","poem":1},{"lineBreak":true},{"text":"Hamı yığılıb yanına gəlir.","poem":1},{"lineBreak":true},{"text":"Mən Rəbb Varlığıma and içib bəyan edirəm ki,","poem":1},{"lineBreak":true},{"text":"Onların hamısı sənin üçün bər-bəzək olacaq,","poem":1},{"lineBreak":true},{"text":"Gəlin kimi onları taxıb fəxr edəcəksən!","poem":1}]},{"type":"heading","content":["Allah İsrail xalqını bərpa edib artıracaq"]},{"type":"verse","number":19,"content":[{"text":"Xarabalığa, viranəliyə dönmüşdün,","poem":1},{"lineBreak":true},{"text":"Ölkən yerlə yeksan olmuşdu.","poem":1},{"lineBreak":true},{"text":"Amma indi bu torpaq sakinlərin üçün dar olacaq,","poem":1},{"lineBreak":true},{"text":"Səni xaraba qoyanlar səndən uzaqda duracaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sənin sürgündə doğulmuş övladların","poem":1},{"lineBreak":true},{"text":"Səsini ucaldıb belə deyəcək:","poem":1},{"lineBreak":true},{"text":"“Bu yer bizim üçün dar gəlir,","poem":1},{"lineBreak":true},{"text":"Yaşamaq üçün bizə yer ver”.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sən qəlbində deyəcəksən:","poem":1},{"lineBreak":true},{"text":"“Axı bunları mənim üçün kim doğdu?","poem":1},{"lineBreak":true},{"text":"Övladlarım itkin düşmüşdü, sonsuz oldum,","poem":1},{"lineBreak":true},{"text":"Sürgün edilmişdim, qovulmuşdum.","poem":1},{"lineBreak":true},{"text":"Belə isə bunları kim böyütdü?","poem":1},{"lineBreak":true},{"text":"Mən tək-tənha qalmışdım,","poem":1},{"lineBreak":true},{"text":"Bəs bunlar haradan gəlib-çıxdı?”»","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Budur, Mən əlimi millətlərə","poem":1},{"lineBreak":true},{"text":"Bir işarə kimi uzadacağam,","poem":1},{"lineBreak":true},{"text":"Bayrağımı xalqlar arasında qaldıracağam.","poem":1},{"lineBreak":true},{"text":"Onlar sənin oğullarını qucağında,","poem":1},{"lineBreak":true},{"text":"Qızlarını çiyinlərində gətirəcək.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Padşahlar sənə atalıq,","poem":1},{"lineBreak":true},{"text":"Mələkələr sənə analıq edəcək.","poem":1},{"lineBreak":true},{"text":"Üzüstə yerə sərilib sənə səcdə edəcəklər,","poem":1},{"lineBreak":true},{"text":"Ayaqlarının tozunu yalayacaqlar.","poem":1},{"lineBreak":true},{"text":"Onda biləcəksən ki, Mən Rəbbəm,","poem":1},{"lineBreak":true},{"text":"Mənə güvənənlər utanmayacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Məgər güclünün əlindən qənimət alına bilərmi?","poem":1},{"lineBreak":true},{"text":"Zorakının əlindən əsirlər qurtula bilərmi?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amma Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Bəli, güclünün əlindən əsirlər də alına bilər,","poem":1},{"lineBreak":true},{"text":"Zorakının əlindən qənimət də götürülə bilər,","poem":1},{"lineBreak":true},{"text":"Səninlə çəkişənlərlə Mən çəkişəcəyəm,","poem":1},{"lineBreak":true},{"text":"Övladlarını Mən qurtaracağam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sənə zülm edənlərə öz ətlərini yedirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Öz qanları ilə sərxoş olub","poem":1},{"lineBreak":true},{"text":"Şirin şərab içənlərin halına düşəcəklər.","poem":1},{"lineBreak":true},{"text":"Beləcə bütün bəşər biləcək ki,","poem":1},{"lineBreak":true},{"text":"Səni qurtaran Rəbb Mənəm.","poem":1},{"lineBreak":true},{"text":"Səni Satınalan, Yaqubun qüdrətli Allahı Mənəm».","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Sinim – zənn edilir ki, Misirdəki bir bölgənin adıdır.","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/azb_bsa/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}