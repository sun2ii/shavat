{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Üzüm bağı haqqında nəğmə"]},{"type":"verse","number":1,"content":[{"text":"Sevgilimin üzüm bağı barəsində","poem":1},{"lineBreak":true},{"text":"Məhəbbət nəğməsini oxuyuram:","poem":1},{"lineBreak":true},{"text":"Torpağın məhsuldar bir təpəsində","poem":1},{"lineBreak":true},{"text":"Sevgilimin bir üzüm bağı var idi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O, torpağı belləyib daşlardan təmizlədi,","poem":1},{"lineBreak":true},{"text":"Seçmə meynələr əkdi,","poem":1},{"lineBreak":true},{"text":"Ortada gözətçi qülləsi tikdi,","poem":1},{"lineBreak":true},{"text":"Üzümsıxan düzəltdi,","poem":1},{"lineBreak":true},{"text":"Üzümlüyün barını gözlədi,","poem":1},{"lineBreak":true},{"text":"Amma bağ cır üzüm gətirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«İndi isə xahiş edirəm, ey Yerusəlimdə yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Ey Yəhuda adamları,","poem":1},{"lineBreak":true},{"text":"Mənimlə üzüm bağımın arasında hakim olun!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bağım üçün daha nə etməliyəm?","poem":1},{"lineBreak":true},{"text":"Üzümlüyün barını gözləyərkən","poem":1},{"lineBreak":true},{"text":"Axı nə üçün bağım cır üzüm gətirsin?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İndi qoy mən sizə bağımla nə edəcəyimi bildirim:","poem":1},{"lineBreak":true},{"text":"Çəpərini sökəcəyəm və onu yeyib-dağıdacaqlar,","poem":1},{"lineBreak":true},{"text":"Hasarını yıxacağam və onlar tapdalanacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oranı viranəliyə çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Oranı nə budayacaqlar, nə də belləyəcəklər.","poem":1},{"lineBreak":true},{"text":"Orada tikan və qanqal bitəcək,","poem":1},{"lineBreak":true},{"text":"Buludlara əmr edəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Üzərinə yağış yağmasın».","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"İsrail nəsli Ordular Rəbbinin üzüm bağıdır,","poem":1},{"lineBreak":true},{"text":"Yəhuda adamları isə Onun sevimli meynələridir!","poem":1},{"lineBreak":true},{"text":"O, ədalət gözləyirdi,","poem":1},{"lineBreak":true},{"text":"Budur, zorakılıq gördü,","poem":1},{"lineBreak":true},{"text":"O, salehlik gözləyirdi,","poem":1},{"lineBreak":true},{"text":"Budur, fəryadlar gördü!","poem":1}]},{"type":"heading","content":["İnsanların pis əməlləri"]},{"type":"verse","number":8,"content":[{"text":"Yer qalmayana qədər evi evə,","poem":1},{"lineBreak":true},{"text":"Tarlanı tarlaya birləşdirənlərin vay halına!","poem":1},{"lineBreak":true},{"text":"Yaşamağa yer qoymamısınız,","poem":1},{"lineBreak":true},{"text":"Məgər bu ölkədə tək siz yaşayırsınız?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi mənə belə eşitdirdi:","poem":1},{"lineBreak":true},{"text":"«Böyük və yaraşıqlı çoxlu evlər xaraba qalacaq,","poem":1},{"lineBreak":true},{"text":"İçində yaşayan olmayacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Üzümlüyün on sahəsindən","poem":1},{"noteId":1},{"text":"bir bat şərab əldə ediləcək,","poem":1},{"lineBreak":true},{"text":"Bir xomer toxumdan bir efa taxıl əmələ gələcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vay halına səhər erkən qalxıb içki ardınca düşənlərin,","poem":1},{"lineBreak":true},{"text":"Gecə yarısınadək şərab içib keflənənlərin!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onların ziyafətlərində","poem":1},{"lineBreak":true},{"text":"Lira, çəng, dəf və ney çalınar,","poem":1},{"lineBreak":true},{"text":"Şərab içilər,","poem":1},{"lineBreak":true},{"text":"Lakin onlar Rəbbin gördüyü işlərə","poem":1},{"lineBreak":true},{"text":"Diqqət etməzlər, əməllərinə baxmazlar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Buna görə xalqım ağılsızlığından sürgünə gedəcək,","poem":1},{"lineBreak":true},{"text":"Onun adlı-sanlı adamları acından öləcək,","poem":1},{"lineBreak":true},{"text":"Adi adamlar isə susuzluqdan yanacaq!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ölülər diyarı həddindən artıq ağzını açıb","poem":1},{"lineBreak":true},{"text":"Doymaq bilmir.","poem":1},{"lineBreak":true},{"text":"Yerusəlimin adlı-sanlıları,","poem":1},{"lineBreak":true},{"text":"Adi adamları, səs-küylə əylənən insanları bu diyara enəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Buna görə də hamı yerə səriləcək,","poem":1},{"lineBreak":true},{"text":"Hər kəs diz üstə çökdürüləcək,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü baxışlar alçaldılacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Amma Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Ədaləti ilə ucaldılacaq,","poem":1},{"lineBreak":true},{"text":"Müqəddəs Allah salehliyi ilə","poem":1},{"lineBreak":true},{"text":"Müqəddəsliyini göstərəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Quzular öz otlaqlarındakı kimi otlayacaq,","poem":1},{"lineBreak":true},{"text":"Varlıların viranə qalan evlərini yadellilər alacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pisliyi yalanla hörülmüş iplərlə,","poem":1},{"lineBreak":true},{"text":"Günahı araba kəndirləri ilə çəkənlərin vay halına!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onlar deyir: «Qoy Allah tələssin,","poem":1},{"lineBreak":true},{"text":"Öz əməlini tez həyata keçirsin, biz də görək.","poem":1},{"lineBreak":true},{"text":"Qoy İsrailin Müqəddəsinin niyyəti gerçək olsun ki, bunu bilək!»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vay halına pisə yaxşı, yaxşıya pis söyləyənlərin,","poem":1},{"lineBreak":true},{"text":"Qaranlığı işıq, işığı qaranlıq sayanların,","poem":1},{"lineBreak":true},{"text":"Acıya şirin, şirinə acı deyənlərin!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Vay halına özlərini müdrik zənn edənlərin, ağıllı sayanların!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Vay halına şərab içməkdə qəhrəman,","poem":1},{"lineBreak":true},{"text":"İçkiləri qarışdırıb içməkdə pərgar olanların!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vay halına rüşvət alıb təqsirkara bəraət qazandıranların,","poem":1},{"lineBreak":true},{"text":"Haqlıların haqqını əlindən alanların!","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Beləliklə, alovun dili samanı necə yeyib-qurtarırsa,","poem":1},{"lineBreak":true},{"text":"Küləş od içində necə əriyib-gedirsə,","poem":1},{"lineBreak":true},{"text":"Onlar da köklərindən elə çürüyəcək,","poem":1},{"lineBreak":true},{"text":"Tumurcuqları toz kimi havaya sovrulacaq,","poem":1},{"lineBreak":true},{"text":"Çünki Ordular Rəbbinin qanununu rədd etdilər,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsinin sözünə xor baxdılar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Buna görə də Rəbbin qəzəbi Öz xalqına qarşı alovlandı,","poem":1},{"lineBreak":true},{"text":"Əlini onlara qarşı uzadaraq onları vurdu.","poem":1},{"lineBreak":true},{"text":"Dağlar titrədi, küçələrdə meyitləri zibil kimi qaldı,","poem":1},{"lineBreak":true},{"text":"Bütün bunlara qarşı yenə də Rəbbin qəzəbi sönmədi,","poem":1},{"lineBreak":true},{"text":"Əli hələ də cəzalandırmağa hazır idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Rəbb uzaqda yaşayan millətləri","poem":1},{"lineBreak":true},{"text":"Bayraq işarəsi ilə,","poem":1},{"lineBreak":true},{"text":"Onları yer üzünün ucqarlarından","poem":1},{"lineBreak":true},{"text":"Fit səsi ilə səsləyəcək.","poem":1},{"lineBreak":true},{"text":"Tezliklə bu millətlər gələcək.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aralarında yorulan, büdrəyən olmayacaq.","poem":1},{"lineBreak":true},{"text":"Onlar mürgüləməyəcək və yuxuya getməyəcək,","poem":1},{"lineBreak":true},{"text":"Belindəki kəmər açılmayacaq, ayaqqabı bağı qırılmayacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Onların oxları iti, yayları da dartılmışdır.","poem":1},{"lineBreak":true},{"text":"Atların dırnaqları çaxmaq daşına bənzər,","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarının təkərləri qasırğa kimidir.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Onların nərəsi bağıran şikarlarını qapıb aparan,","poem":1},{"lineBreak":true},{"text":"Kimsə onu əlindən ala bilməyən","poem":1},{"lineBreak":true},{"text":"Şirin, gənc aslanın nərəsinə bənzər.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"O gün İsrailə qarşı onlar dənizin uğultusu kimi gurlayacaqlar.","poem":1},{"lineBreak":true},{"text":"Kim yerə baxarsa, budur, zülmət, dərd görəcək.","poem":1},{"lineBreak":true},{"text":"Axı işıq qara buludlarla örtülüb.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"On sahə – ibrani dilində on cüt öküzün bir gündə şumladığı torpaq sahəsi, təqribən 16 000 kvadrat metr.","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/azb_bsa/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}