{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["İsrailin günahına görə cəzası"]},{"type":"verse","number":1,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Boşadığım ananızın talağı haradadır?","poem":1},{"lineBreak":true},{"text":"Borc verənlərimin hansı birinə satdım sizi?","poem":1},{"lineBreak":true},{"text":"Siz şər əməllərinizə görə satıldınız,","poem":1},{"lineBreak":true},{"text":"Ananız üsyankarlığınız üzündən qovuldu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bəs nə üçün Mən gələndə heç kim olmadı?","poem":1},{"lineBreak":true},{"text":"Axı niyə Mən çağıranda cavab verən olmadı?","poem":1},{"lineBreak":true},{"text":"Məgər Mənim əlim zəifləyib ki,","poem":1},{"lineBreak":true},{"text":"Xilas etməyə qadir olmasın?","poem":1},{"lineBreak":true},{"text":"Yaxud Mənim sizi qurtarmağa gücüm çatmazmı?","poem":1},{"lineBreak":true},{"text":"Mən qəzəbimlə dənizi quruduram,","poem":1},{"lineBreak":true},{"text":"Çayları səhraya çevirirəm.","poem":1},{"lineBreak":true},{"text":"Suyun çatışmazlığından balıqlar iylənir, susuzluqdan ölür.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mənəm göyləri zülmətə bürüyən,","poem":1},{"lineBreak":true},{"text":"Oranı çulla örtən».","poem":1}]},{"type":"heading","content":["Rəbbin qulunun itaəti"]},{"type":"verse","number":4,"content":[{"text":"Yorğunlara sözlə dayaq olmağı bilim deyə","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb mənə savadlıların dilini verdi.","poem":1},{"lineBreak":true},{"text":"O hər səhər qulağımı oyadır ki,","poem":1},{"lineBreak":true},{"text":"Savadlı adamlar kimi dinləyə bilim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xudavənd Rəbb qulağımı açdı,","poem":1},{"lineBreak":true},{"text":"Mən qarşı durmadım, geri çəkilmədim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Məni döyənlər üçün belimi açdım,","poem":1},{"lineBreak":true},{"text":"Üzümü saqqalımı yolanlara tərəf uzatdım.","poem":1},{"lineBreak":true},{"text":"Təhqirlərdən, tüpürcəklərdən üzümü gizlətmədim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xudavənd Rəbb mənə kömək etdiyinə görə utanmayacağam.","poem":1},{"lineBreak":true},{"text":"Buna görə də üzümü çaxmaq daşı kimi etdim.","poem":1},{"lineBreak":true},{"text":"Bilirəm ki, əsla xəcalət çəkməyəcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mənə haqq qazandıran yaxındadır.","poem":1},{"lineBreak":true},{"text":"Mənimlə kim mübahisə etmək istəyir?","poem":1},{"lineBreak":true},{"text":"Qoy mənimlə üz-üzə gəlsin.","poem":1},{"lineBreak":true},{"text":"Kimdir rəqibim?","poem":1},{"lineBreak":true},{"text":"Qoy yanıma gəlsin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mənə kömək edən Xudavənd Rəbdir.","poem":1},{"lineBreak":true},{"text":"Kim məni təqsirkar çıxara bilər?","poem":1},{"lineBreak":true},{"text":"Rəqiblərimin hamısı paltar kimi köhnələcək,","poem":1},{"lineBreak":true},{"text":"Onları güvə yeyib məhv edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aranızda Rəbdən qorxan,","poem":1},{"lineBreak":true},{"text":"Qulunun sözünə qulaq asan varmı?","poem":1},{"lineBreak":true},{"text":"Qaranlıqda gəzən, nurdan məhrum olan","poem":1},{"lineBreak":true},{"text":"Rəbbin adına güvənsin, Allahına arxalansın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey sizlər, od qalayıb, qığılcımı qoruyanlar,","poem":1},{"lineBreak":true},{"text":"Hamınız öz odunuza, yandırdığınız qığılcımın içinə atılın.","poem":1},{"lineBreak":true},{"text":"Mənim əlimdən aldığınız pay bu olacaq:","poem":1},{"lineBreak":true},{"text":"Əzab içində qalacaqsınız.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}