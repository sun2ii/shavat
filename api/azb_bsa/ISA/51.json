{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Yerusəlimə təsəlliverici sözlər"]},{"type":"verse","number":1,"content":[{"text":"Ey salehliyi arayanlar, Rəbbi axtaranlar,","poem":1},{"lineBreak":true},{"text":"Məni dinləyin!","poem":1},{"lineBreak":true},{"text":"Yonulduğunuz qayaya,","poem":1},{"lineBreak":true},{"text":"Çıxarıldığınız çuxurun dərinliyinə baxın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atanız İbrahimə, sizi doğan Saraya baxın!","poem":1},{"lineBreak":true},{"text":"Mən onu tək çağırdım, xeyir-dua verdim,","poem":1},{"lineBreak":true},{"text":"Nəslini artırdım.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Həqiqətən, Rəbb Siona və onun xarabalıqlarına təsəlli verəcək.","poem":1},{"lineBreak":true},{"text":"Səhralarını Edenə, çöllərini Rəbbin bağına döndərəcək.","poem":1},{"lineBreak":true},{"text":"Orada sevinc və şadlıq tapacaqlar,","poem":1},{"lineBreak":true},{"text":"Şükürlər, ilahilər oxunacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey xalqım, Məni dinlə,","poem":1},{"lineBreak":true},{"text":"Ey ümmətim, Məni eşit!","poem":1},{"lineBreak":true},{"text":"Qanun Məndən çıxacaq,","poem":1},{"lineBreak":true},{"text":"Ədalətimi nur tək","poem":1},{"lineBreak":true},{"text":"Xalqlara ehsan edəcəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salehliyim yaxındır, qurtuluşum gəlir,","poem":1},{"lineBreak":true},{"text":"Xalqları Öz gücümlə mühakimə edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Uzaq diyarlar Mənə bel bağlayır,","poem":1},{"lineBreak":true},{"text":"Qüvvətimə ümid edir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Başınızı qaldırıb göylərə nəzər salın,","poem":1},{"lineBreak":true},{"text":"Aşağıya, yer üzünə baxın.","poem":1},{"lineBreak":true},{"text":"Çünki göylər dağılacaq tüstü kimi,","poem":1},{"lineBreak":true},{"text":"Yer üzü paltar kimi köhnələcək.","poem":1},{"lineBreak":true},{"text":"Beləcə yer üzünün sakinləri də qırılacaq.","poem":1},{"lineBreak":true},{"text":"Lakin Mənim xilasım əbədidir,","poem":1},{"lineBreak":true},{"text":"Salehliyim sonsuzdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey salehlikdən xəbərdar olanlar,","poem":1},{"lineBreak":true},{"text":"Qanunumu qəlblərində saxlayan xalq,","poem":1},{"lineBreak":true},{"text":"Mənə qulaq asın!","poem":1},{"lineBreak":true},{"text":"Adamların məzəmmətindən qorxmayın,","poem":1},{"lineBreak":true},{"text":"Onların söyüşlərindən dəhşətə düşməyin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onlar güvənin yediyi paltar kimi məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Qurdun yediyi yun kimi məhv olacaq.","poem":1},{"lineBreak":true},{"text":"Lakin Mənim salehliyim əbədidir,","poem":1},{"lineBreak":true},{"text":"Qurtuluşum nəsillər boyu duracaqdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Qalx, qalx, güclən, ey Rəbbin qolu!","poem":1},{"lineBreak":true},{"text":"Qədim zamanlardakı kimi","poem":1},{"lineBreak":true},{"text":"Qalx əvvəlki nəsillərin vaxtında olduğu kimi!","poem":1},{"lineBreak":true},{"text":"Sən Rahavı","poem":1},{"noteId":15},{"text":"parça-parça etmədinmi?","poem":1},{"lineBreak":true},{"text":"Sən əjdahanın bədənini deşmədinmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dənizi, dərin suları Sən qurutmadınmı?","poem":1},{"lineBreak":true},{"text":"Satın alınan xalqının keçməsindən ötrü","poem":1},{"lineBreak":true},{"text":"Dənizin dərinliklərini yola çevirən","poem":1},{"lineBreak":true},{"text":"Sən deyildinmi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbbin satın alınmış adamları qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Sevinclə nəğmə deyərək Siona gələcək.","poem":1},{"lineBreak":true},{"text":"Üzlərində əbədi sevinc olacaq,","poem":1},{"lineBreak":true},{"text":"Onlar sevinc və şadlıq tapacaq,","poem":1},{"lineBreak":true},{"text":"Kədər və qəm-qüssə yox olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rəbb deyir: «Sizə təsəlli verən Mənəm, Mən!","poem":1},{"lineBreak":true},{"text":"Fani insandan, ot kimi solan bəşər oğlundan qorxan","poem":1},{"lineBreak":true},{"text":"Gör sən kimsən?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Səni yaradan, göyləri sərən,","poem":1},{"lineBreak":true},{"text":"Dünyanın təməlini qoyan Rəbbi necə unudursan?","poem":1},{"lineBreak":true},{"text":"Səni məhv etmək niyyətində olan","poem":1},{"lineBreak":true},{"text":"Zülmkarın qəzəbindən gün boyu, dayanmadan qorxursan.","poem":1},{"lineBreak":true},{"text":"Bəs hanı zülmkarın qəzəbi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zəncirlərlə buxovlanmış dustaqlar","poem":1},{"lineBreak":true},{"text":"Tezliklə azadlığa çıxacaq.","poem":1},{"lineBreak":true},{"text":"Ölüm çuxuruna düşməyəcək,","poem":1},{"lineBreak":true},{"text":"Çörəkləri əskik olmayacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Allahınız Rəbb Mənəm.","poem":1},{"lineBreak":true},{"text":"Mənəm dənizi gur dalğalarla çalxalayan.","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbidir Onun adı!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mən sözlərimi sənin ağzına qoydum,","poem":1},{"lineBreak":true},{"text":"Əlimin kölgəsində səni gizlətdim ki,","poem":1},{"lineBreak":true},{"text":"Göyləri qurum, dünyanın təməlini qoyum,","poem":1},{"lineBreak":true},{"text":"Siona “Xalqım sənsən” deyim».","poem":1}]},{"type":"heading","content":["Yerusəlimin əzabının sonu"]},{"type":"verse","number":17,"content":[{"text":"Oyan, oyan, qalx ayağa, ey Yerusəlim!","poem":1},{"lineBreak":true},{"text":"Sən ki Rəbbin əlindən","poem":1},{"lineBreak":true},{"text":"Qəzəb kasasını alıb içdin.","poem":1},{"lineBreak":true},{"text":"Sərxoşluq kasasını axıra qədər boşaltdın.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Doğduğu bütün oğullardan ona yol göstərən,","poem":1},{"lineBreak":true},{"text":"Böyütdüyü bütün oğullardan ona əl tutan olmadı.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bu iki bəla sənin başına gəldi,","poem":1},{"lineBreak":true},{"text":"Dərdinə kim şərik olacaq?","poem":1},{"lineBreak":true},{"text":"Qarət, dağıntı, qıtlıq və qılınc!","poem":1},{"lineBreak":true},{"text":"Sənə necə təsəlli verim?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Övladların taqətdən düşüb,","poem":1},{"lineBreak":true},{"text":"Rəbbin qəzəbi, Allahının məzəmməti üzərlərindədir.","poem":1},{"lineBreak":true},{"text":"Onlar tələyə düşmüş cüyür kimi","poem":1},{"lineBreak":true},{"text":"Hər küçə başında uzanıb.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Buna görə də, ey yaralı Yerusəlim,","poem":1},{"lineBreak":true},{"text":"Şərabsız sərxoş xalq, bunu eşit!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Xudavəndin Rəbb, Öz xalqını müdafiə edən","poem":1},{"lineBreak":true},{"text":"Allahın belə deyir:","poem":1},{"lineBreak":true},{"text":"«Budur, sərxoşluq kasasını əlindən almışam.","poem":1},{"lineBreak":true},{"text":"Qəzəbimin kasasından artıq içməyəcəksən.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bu kasanı sənin zülmkarlarının əlinə verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Axı onlar sənə belə dedi:","poem":1},{"lineBreak":true},{"text":"“Uzan yerə, üstündən keçək”.","poem":1},{"lineBreak":true},{"text":"Sən də kürəyini torpaq kimi, yol kimi etdin ki, üstündən keçsinlər».","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Rahav – bax: Yeş. 30:7.","reference":{"chapter":51,"verse":9}}]},"thisChapterLink":"/api/azb_bsa/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}