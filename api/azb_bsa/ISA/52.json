{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Yerusəlimin sevinci"]},{"type":"verse","number":1,"content":[{"text":"Qalx, qalx, ey Sion, qüdrətinə qurşan!","poem":1},{"lineBreak":true},{"text":"Ey müqəddəs şəhər, ey Yerusəlim,","poem":1},{"lineBreak":true},{"text":"Gözəl paltarlarını geyin!","poem":1},{"lineBreak":true},{"text":"Çünki sünnətsizlər, murdarlar","poem":1},{"lineBreak":true},{"text":"Sənin darvazalarından əsla keçməyəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üst-başındakı tozu çırp,","poem":1},{"lineBreak":true},{"text":"Qalx, ey Yerusəlim, taxtına otur,","poem":1},{"lineBreak":true},{"text":"Zənciri boynundan qır,","poem":1},{"lineBreak":true},{"text":"Ey əsir aparılan Sion qızı!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Siz müftə satılmışdınız,","poem":1},{"lineBreak":true},{"text":"Müftə də satın alınacaqsınız».","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Xalqım qürbətdə yaşamaq üçün","poem":1},{"lineBreak":true},{"text":"Əvvəllər Misirə enmişdi.","poem":1},{"lineBreak":true},{"text":"Sonra Aşşurlular onlara boş yerə zülm etdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xalqım nahaq yerə götürülüb aparıldı,","poem":1},{"lineBreak":true},{"text":"İndi bundan Mənə nə qaldı?» Rəbb bəyan edir.","poem":1},{"lineBreak":true},{"text":"Bu, Rəbbin sözüdür:","poem":1},{"lineBreak":true},{"text":"«Onların başçıları ah-zar edir,","poem":1},{"lineBreak":true},{"text":"Həmişə, gün boyu adım küfrlə çəkilir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna görə xalqım","poem":1},{"lineBreak":true},{"text":"Mənim adımı tanıyacaq,","poem":1},{"lineBreak":true},{"text":"O gün “budur, Mənəm” deyənin Mən olduğunu başa düşəcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sülh xəbəri gətirən,","poem":1},{"lineBreak":true},{"text":"Dağları aşıb-gələn","poem":1},{"lineBreak":true},{"text":"Müjdəçinin qədəmləri necə də gözəldir!","poem":1},{"lineBreak":true},{"text":"O, xoş müjdə gətirir,","poem":1},{"lineBreak":true},{"text":"Qurtuluş xəbəri verir,","poem":1},{"lineBreak":true},{"text":"Sion xalqına","poem":1},{"lineBreak":true},{"text":"«Allahınız hökm sürür!» bəyan edir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qulaq asın! Gözətçilər səslərini ucaldır,","poem":1},{"lineBreak":true},{"text":"Birlikdə mədh oxuyur,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin Siona qayıdışını","poem":1},{"lineBreak":true},{"text":"Öz gözləri ilə görür.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim xarabalıqları,","poem":1},{"lineBreak":true},{"text":"Şənlik edin, birlikdə mədh oxuyun,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb xalqına təsəlli verdi,","poem":1},{"lineBreak":true},{"text":"Yerusəlimi satın aldı.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb bütün millətlərin gözləri önündə","poem":1},{"lineBreak":true},{"text":"Müqəddəs qolunu çırmaladı,","poem":1},{"lineBreak":true},{"text":"Yer üzünün qurtaracağınadək hər yer","poem":1},{"lineBreak":true},{"text":"Allahımızın gətirdiyi xilası görəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Çəkilin, çəkilin, oradan çıxın,","poem":1},{"lineBreak":true},{"text":"Murdar şeylərə toxunmayın,","poem":1},{"lineBreak":true},{"text":"Oradan çıxıb təmizlənin,","poem":1},{"lineBreak":true},{"text":"Ey Rəbbin əşyalarını daşıyanlar!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Axı siz tələsmədən çıxacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qaça-qaça getməyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb qarşınızda gedəcək,","poem":1},{"lineBreak":true},{"text":"İsrailin Allahı arxanızda olacaq.","poem":1}]},{"type":"heading","content":["Rəbbin qulunun iztirab çəkməsi və qələbəsi"]},{"type":"verse","number":13,"content":[{"text":"Budur, Mənim qulum uğur qazanacaq,","poem":1},{"lineBreak":true},{"text":"O yüksəldiləcək, ucaldılacaq, çox izzətlənəcək.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çoxları onun qarşısında mat qalacaq.","poem":1},{"lineBreak":true},{"text":"Bəli, onun görkəmi çox dəyişmişdi,","poem":1},{"lineBreak":true},{"text":"Zahirən insan surətindən çıxmışdı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakin o, çox millətləri heyrətə salacaq,","poem":1},{"lineBreak":true},{"text":"Onun qarşısında padşahlar ağzını yumacaq,","poem":1},{"lineBreak":true},{"text":"Çünki onlar bilmədiklərini görəcək,","poem":1},{"lineBreak":true},{"text":"Eşitmədiklərini anlayacaq.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}