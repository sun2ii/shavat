{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Xəbərimizə kim inandı,","poem":1},{"lineBreak":true},{"text":"Rəbbin gücü kimə zahir oldu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O, Rəbbin önündə bir fidan kimi,","poem":1},{"lineBreak":true},{"text":"Quru torpaqda bitən kök kimi böyüdü.","poem":1},{"lineBreak":true},{"text":"Baxanda onun nə görkəmi, nə gözəlliyi var idi,","poem":1},{"lineBreak":true},{"text":"Gözümüzü oxşayan zahiri siması da yox idi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adamlar ona həqarətlə baxıb rədd etdi.","poem":1},{"lineBreak":true},{"text":"O, dərdli, xəstəlikləri görən insan idi,","poem":1},{"lineBreak":true},{"text":"Adamlar ondan üz döndərdi, xor baxdı.","poem":1},{"lineBreak":true},{"text":"Biz ona qiymət vermədik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Əslində xəstəliklərimizi o çəkdi,","poem":1},{"lineBreak":true},{"text":"Dərdlərimizi öz üzərinə götürdü.","poem":1},{"lineBreak":true},{"text":"Biz isə onun Allah tərəfindən cəzalandırıldığını,","poem":1},{"lineBreak":true},{"text":"Vurulub iztirab çəkdiyini zənn etdik.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bizim üsyankarlığımıza görə onun bədəni deşildi,","poem":1},{"lineBreak":true},{"text":"Şər əməllərimiz naminə əzildi,","poem":1},{"lineBreak":true},{"text":"Bizim əmin-amanlığımız üçün o cəza aldı,","poem":1},{"lineBreak":true},{"text":"Onun yaraları ilə biz şəfa tapdıq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamımız qoyun kimi yolu azmışdıq,","poem":1},{"lineBreak":true},{"text":"Hər birimiz öz yolumuzla gedirdik.","poem":1},{"lineBreak":true},{"text":"Rəbb hamımızın şər əməllərinin yükünü onun üzərinə qoydu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ona zülm etdilər,","poem":1},{"lineBreak":true},{"text":"O iztirab çəkdi, amma ağzını açmadı.","poem":1},{"lineBreak":true},{"text":"Kəsilməyə aparılan quzu kimi,","poem":1},{"lineBreak":true},{"text":"Qırxımçıların qabağında dilsiz qoyun kimi","poem":1},{"lineBreak":true},{"text":"Ağzını açmadı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ədalətsizliklə məhkum olunaraq ölümə aparıldı.","poem":1},{"lineBreak":true},{"text":"Onun nəsli haqqında kim düşünə bilərdi?","poem":1},{"lineBreak":true},{"text":"Axı xalqımın üsyankarlığına görə","poem":1},{"lineBreak":true},{"text":"O edam olundu, dirilər arasından atıldı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O heç bir zorakılıq etmədiyi,","poem":1},{"lineBreak":true},{"text":"Ağzından yalan söz çıxmadığı halda","poem":1},{"lineBreak":true},{"text":"Qəbri pis adamların yanında quruldu,","poem":1},{"lineBreak":true},{"text":"Dövlətli adamın yanında dəfn olundu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amma Rəbb Özü onun bu iztirablarını istədi,","poem":1},{"lineBreak":true},{"text":"Çəkdiyi əziyyətlər Onun iradəsi idi.","poem":1},{"lineBreak":true},{"text":"Öz canını təqsir qurbanı təqdim edərsə,","poem":1},{"lineBreak":true},{"text":"Nəsil görəcək, ömür uzadacaq.","poem":1},{"lineBreak":true},{"text":"Rəbbin istəyi onun əli ilə uğur qazanacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O çəkdiyi iztirablarının bəhrəsini görüb qane olacaq,","poem":1},{"lineBreak":true},{"text":"Mənim saleh qulum öz biliyi ilə çoxlarına bəraət qazandıracaq,","poem":1},{"lineBreak":true},{"text":"Onların şər əməllərinin yükünü üzərinə götürəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buna görə Mən ona böyük adamların arasında pay verəcəyəm.","poem":1},{"lineBreak":true},{"text":"O, qəniməti güclülərlə böləcək.","poem":1},{"lineBreak":true},{"text":"Çünki o, canını fəda etdi,","poem":1},{"lineBreak":true},{"text":"Üsyankarlara tay tutuldu.","poem":1},{"lineBreak":true},{"text":"Çox adamların günahını üzərinə götürdü,","poem":1},{"lineBreak":true},{"text":"Üsyankarlardan ötrü yalvardı.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}