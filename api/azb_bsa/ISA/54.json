{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Rəbbin İsrailə məhəbbəti"]},{"type":"verse","number":1,"content":[{"text":"«Şənlən, ey sonsuz, qısır qadın!","poem":1},{"lineBreak":true},{"text":"Sevinclə mahnı oxu,","poem":1},{"lineBreak":true},{"text":"Ey doğuş ağrısı çəkməyən qadın!","poem":1},{"lineBreak":true},{"text":"Çünki atılmış qadının övladları","poem":1},{"lineBreak":true},{"text":"Ərli qadının övladlarından çox olacaq»,","poem":1},{"lineBreak":true},{"text":"Bunu Rəbb deyir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Çadırının yerini genişləndir,","poem":1},{"lineBreak":true},{"text":"Məskənlərinin örtüklərini uzat,","poem":1},{"lineBreak":true},{"text":"Çəkinmə, ipləri uzat, payaları vur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki sağa və sola səpələnəcəksən,","poem":1},{"lineBreak":true},{"text":"Nəslin millətlərə yiyələnəcək,","poem":1},{"lineBreak":true},{"text":"Viran qalmış şəhərlərdə məskunlaşacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Qorxma, çünki utanmayacaqsan,","poem":1},{"lineBreak":true},{"text":"Ruhdan düşmə, çünki rüsvay olmayacaqsan.","poem":1},{"lineBreak":true},{"text":"Cavanlığın xəcalətini unudacaqsan,","poem":1},{"lineBreak":true},{"text":"Bir daha dulluğun rüsvayçılığını","poem":1},{"lineBreak":true},{"text":"Yadına salmazsan».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki sənin ərin səni Yaradandır,","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1},{"lineBreak":true},{"text":"Səni Satınalan İsrailin Müqəddəsidir,","poem":1},{"lineBreak":true},{"text":"O bütün dünyanın Allahı adlanır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Allahın deyir:","poem":1},{"lineBreak":true},{"text":"«Rəbb səni çağırır","poem":1},{"lineBreak":true},{"text":"Atılmış və ruhu əzilmiş,","poem":1},{"lineBreak":true},{"text":"Gənc yaşında ərə getmiş,","poem":1},{"lineBreak":true},{"text":"Sonra isə rədd olunmuş bir qadın kimi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bir anlığa səni tərk etdim,","poem":1},{"lineBreak":true},{"text":"Amma böyük rəhmlə geri qəbul edəcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bir anlığa qızğın qəzəblə səndən üzümü döndərdim,","poem":1},{"lineBreak":true},{"text":"Lakin əbədi məhəbbətimlə sənə rəhm edəcəyəm».","poem":1},{"lineBreak":true},{"text":"Bunu səni Satınalan, Rəbb deyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Bu Mənim üçün sanki Nuhun dövründə baş verən daşqındır,","poem":1},{"lineBreak":true},{"text":"Nuhun dövründəki daşqının suları","poem":1},{"lineBreak":true},{"text":"Bir daha yer üzünü örtməyəcəyi barədə necə and içmişdimsə,","poem":1},{"lineBreak":true},{"text":"İndi də and içirəm ki,","poem":1},{"lineBreak":true},{"text":"Sənə qəzəblənməyəcəyəm, səni məzəmmət etməyəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dağlar yerini dəyişsə də,","poem":1},{"lineBreak":true},{"text":"Təpələr sarsılsa da,","poem":1},{"lineBreak":true},{"text":"Sənə olan məhəbbətim dəyişməz,","poem":1},{"lineBreak":true},{"text":"Sülh əhdim sarsılmaz».","poem":1},{"lineBreak":true},{"text":"Bunu sənə rəhm edən Rəbb deyir.","poem":1}]},{"type":"heading","content":["Yeni Yerusəlimin xoşbəxtliyi"]},{"type":"verse","number":11,"content":[{"text":"«Ey tufana düşmüş,","poem":1},{"lineBreak":true},{"text":"Təsəlli tapmamış yazıq şəhər!","poem":1},{"lineBreak":true},{"text":"Sənin daşlarını əqiqlərlə,","poem":1},{"lineBreak":true},{"text":"Təməlini göy yaqutlarla qoyacağam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qüllələrini yaqutdan,","poem":1},{"lineBreak":true},{"text":"Darvazalarını ləl-cəvahirdən,","poem":1},{"lineBreak":true},{"text":"Divarlarını qiymətli daşlardan hörəcəyəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bütün övladlarını Mən Rəbb öyrədəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar tam sülh içində olacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Salehliyində möhkəmlənəcəksən,","poem":1},{"lineBreak":true},{"text":"Zülmdən uzaq olacaqsan, qorxmayacaqsan.","poem":1},{"lineBreak":true},{"text":"Qorxu hissi səndən uzaq olacaq, sənə yaxınlaşmayacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sənə hücum edən olsa, bil ki, bu Məndən deyil,","poem":1},{"lineBreak":true},{"text":"Sənə hücum edən hər kəs","poem":1},{"lineBreak":true},{"text":"Qarşında yerə yıxılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Budur, odda kömürü körükləyən,","poem":1},{"lineBreak":true},{"text":"Öz məqsədi üçün silah hazırlayan","poem":1},{"lineBreak":true},{"text":"Dəmirçini Mən yaratdım.","poem":1},{"lineBreak":true},{"text":"Məhv etmək üçün qırıcını da Mən yaratdım.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sənə qarşı işlənən","poem":1},{"lineBreak":true},{"text":"Heç bir silah işə yaramayacaq.","poem":1},{"lineBreak":true},{"text":"Məhkəmədə səni təqsirləndirən","poem":1},{"lineBreak":true},{"text":"Hər kəsi təqsirkar çıxaracaqsan.","poem":1},{"lineBreak":true},{"text":"Rəbbə qulluq edənlərin irsi belədir.","poem":1},{"lineBreak":true},{"text":"Onların salehliyi Məndən gəlir».","poem":1},{"lineBreak":true},{"text":"Bunu Rəbb bəyan edir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}