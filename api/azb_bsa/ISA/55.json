{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Rəbbin çağırışı"]},{"type":"verse","number":1,"content":[{"text":"Ey bütün susamışlar, gəlin su başına!","poem":1},{"lineBreak":true},{"text":"Ey pulu olmayanlar, gəlin, alın, yeyin!","poem":1},{"lineBreak":true},{"text":"Gəlin, şərabı və südü pulsuz, havayı alın!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nə üçün pulunuzu çörək olmayan şeylərə,","poem":1},{"lineBreak":true},{"text":"Qazandığınızı sizi doydurmayan şeylərə xərcləyirsiniz?","poem":1},{"lineBreak":true},{"text":"Məni diqqətlə dinləyin ki,","poem":1},{"lineBreak":true},{"text":"Yaxşı şeylər yeyəsiniz, nemətlərdən dadasınız.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qulaq asın, Mənim yanıma gəlin,","poem":1},{"lineBreak":true},{"text":"Dinləyin ki, sağ qalasınız.","poem":1},{"lineBreak":true},{"text":"Mən sizinlə əbədi əhd,","poem":1},{"lineBreak":true},{"text":"Davuda vəd etdiyim sadiq məhəbbət əhdi kəsəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Budur, onu ümmətlərə şahid,","poem":1},{"lineBreak":true},{"text":"Xalqlara başçı və hökmdar etdim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tanımadığınız millətləri çağıracaqsınız.","poem":1},{"lineBreak":true},{"text":"Sizi tanımayan millətlər qaça-qaça yanınıza gələcək.","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbə görə,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsindən ötrü onlar gələcək,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb sizi ucaltdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tapmaq fürsəti olarkən Rəbbi axtarın,","poem":1},{"lineBreak":true},{"text":"O yaxın ikən Onu çağırın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoy pis adam öz yolunu,","poem":1},{"lineBreak":true},{"text":"Şər adam öz fikirlərini atsın.","poem":1},{"lineBreak":true},{"text":"Qoy Rəbbə sarı dönsün ki, Onda mərhəmət tapsın.","poem":1},{"lineBreak":true},{"text":"Qoy Allahımıza tərəf dönsün,","poem":1},{"lineBreak":true},{"text":"Çünki Onun əfvi boldur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Çünki Mənim fikirlərim sizin fikirləriniz deyil,","poem":1},{"lineBreak":true},{"text":"Sizin yollarınız Mənim yollarım deyil»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Çünki göylər yer üzündən nə qədər yüksəkdirsə,","poem":1},{"lineBreak":true},{"text":"Yollarım da sizin yollarınızdan,","poem":1},{"lineBreak":true},{"text":"Fikirlərim də sizin fikirlərinizdən o qədər yüksəkdir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yağış və qar necə göylərdən yağıb oraya qayıtmırsa,","poem":1},{"lineBreak":true},{"text":"Ancaq torpağı sulayıb yeri məhsuldar edirsə,","poem":1},{"lineBreak":true},{"text":"Əkinçiyə toxum, yeyənə çörək verirsə,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ağzımdan çıxan kəlmə də belədir:","poem":1},{"lineBreak":true},{"text":"Boş yerə yanıma qayıtmaz,","poem":1},{"lineBreak":true},{"text":"Ancaq istədiyimi yerinə yetirər,","poem":1},{"lineBreak":true},{"text":"Onu göndərdiyim iş icra olunsun deyə həyata keçirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sevinclə çıxacaqsınız,","poem":1},{"lineBreak":true},{"text":"Sülhlə müşayiət olunacaqsınız,","poem":1},{"lineBreak":true},{"text":"Dağlar, təpələr önünüzdə sevinclə nəğmə deyəcək,","poem":1},{"lineBreak":true},{"text":"Çöldəki bütün ağaclar əl çalacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tikanlı kol əvəzinə şam ağacı,","poem":1},{"lineBreak":true},{"text":"Qanqal əvəzinə mərsin ağacı bitəcək.","poem":1},{"lineBreak":true},{"text":"Bu, Rəbb üçün şöhrət,","poem":1},{"lineBreak":true},{"text":"Pozulmaz əbədi əlamət olacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}