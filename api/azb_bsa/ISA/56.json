{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Rəbb bütün xalqları qəbul edəcək"]},{"type":"verse","number":1,"content":["Rəbb belə deyir:",{"text":"«Ədaləti qoruyun, salehliyə əməl edin.","poem":1},{"lineBreak":true},{"text":"Çünki xilasım yaxındadır,","poem":1},{"lineBreak":true},{"text":"Salehliyim tezliklə aşkar olunacaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bunu edən insan,","poem":1},{"lineBreak":true},{"text":"Buna itaət edən bəşər oğlu nə bəxtiyardır!","poem":1},{"lineBreak":true},{"text":"Şənbə gününü tutar, murdarlamaz,","poem":1},{"lineBreak":true},{"text":"Hər cür şərdən qorunar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qoy Rəbbə bel bağlayan heç bir yadelli deməsin:","poem":1},{"lineBreak":true},{"text":"“Əlbəttə, Rəbb məni Öz xalqından ayıracaq”.","poem":1},{"lineBreak":true},{"text":"Qoy heç bir xədim deməsin:","poem":1},{"lineBreak":true},{"text":"“Mən quru bir ağacam”».","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Şənbə günlərimə riayət edən,","poem":1},{"lineBreak":true},{"text":"Mənə xoş gələni seçən,","poem":1},{"lineBreak":true},{"text":"Əhdimə itaət edən xədimlərə","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Evimdə, divarlarımın arasında","poem":1},{"lineBreak":true},{"text":"Oğul və qızlardan daha da yaxşı olan","poem":1},{"lineBreak":true},{"text":"Xatirə və ad verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onlara silinməz, əbədi bir ad verəcəyəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbbə xidmət etmək, Onun adını sevmək,","poem":1},{"lineBreak":true},{"text":"Onun qulu olmaq üçün Şənbə gününə riayət edən, o günü murdarlamayan,","poem":1},{"lineBreak":true},{"text":"Əhdimə itaət edən,","poem":1},{"lineBreak":true},{"text":"Rəbbə bel bağlayan bütün yadelliləri","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Müqəddəs dağıma gətirib","poem":1},{"lineBreak":true},{"text":"Dua evimdə sevindirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onların gətirdikləri","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanları, bütün qurbanlar","poem":1},{"lineBreak":true},{"text":"Qurbangahımda qəbul olunacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Mənim evim bütün xalqlar üçün","poem":1},{"lineBreak":true},{"text":"Dua evi adlandırılacaq».","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsrailin əsir düşmüş övladlarını toplayan","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Mən hələ toplanmışların yanına başqalarını da yığacağam».","poem":1}]},{"type":"heading","content":["İsrailin pis başçıları mühakimə olunur"]},{"type":"verse","number":9,"content":[{"text":"Ey bütün çöl heyvanları,","poem":1},{"lineBreak":true},{"text":"Ey bütün meşə heyvanları,","poem":1},{"lineBreak":true},{"text":"Gəlin yeməyə!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xalqımın bütün gözətçiləri kordur, cahildir!","poem":1},{"lineBreak":true},{"text":"Onların hamısı hürə bilməyən lal itlərdir,","poem":1},{"lineBreak":true},{"text":"Yuxu görürlər, uzanırlar,","poem":1},{"lineBreak":true},{"text":"Yatmağı sevirlər!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Acgöz, azğın köpəklərdir bunlar,","poem":1},{"lineBreak":true},{"text":"Axmaq çobanlardır bunlar!","poem":1},{"lineBreak":true},{"text":"Hər kəs öz yolu ilə gedir,","poem":1},{"lineBreak":true},{"text":"Hər biri öz xeyrini güdür!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bir-birlərinə deyirlər:","poem":1},{"lineBreak":true},{"text":"«Gəlin, şərab gətirək,","poem":1},{"lineBreak":true},{"text":"Bol-bol kefləndirici içki içək!","poem":1},{"lineBreak":true},{"text":"Sabahkı gün də bu gün kimi,","poem":1},{"lineBreak":true},{"text":"Hətta bundan da çox yaxşı olacaq!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}