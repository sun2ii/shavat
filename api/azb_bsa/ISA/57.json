{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"heading","content":["Vəfasız xalq"]},{"type":"verse","number":1,"content":[{"text":"«Saleh adam ölür və bunu vecinə alan yoxdur.","poem":1},{"lineBreak":true},{"text":"Mömin adamlar da köçüb gedir,","poem":1},{"lineBreak":true},{"text":"Amma heç kim anlamır ki,","poem":1},{"lineBreak":true},{"text":"Bəla gəlməmiş saleh adam canını qurtarır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Saleh adam sülhə qovuşur,","poem":1},{"lineBreak":true},{"text":"Doğru yolla gedən son yatağında rahat yatır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amma siz, ey cadugər qadının övladları,","poem":1},{"lineBreak":true},{"text":"Fahişə və zinakarlar nəsli, bura, yaxın gəlin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siz kimi məsxərəyə qoyursunuz?","poem":1},{"lineBreak":true},{"text":"Kimə ağız əyirsiniz?","poem":1},{"lineBreak":true},{"text":"Kimə dil göstərirsiniz?","poem":1},{"lineBreak":true},{"text":"Məgər siz itaətsiz övladlar,","poem":1},{"lineBreak":true},{"text":"Yalançı nəsil deyilsiniz?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Palıd ağacları arasında,","poem":1},{"lineBreak":true},{"text":"Hər kölgəli ağacın altında","poem":1},{"lineBreak":true},{"text":"Şəhvətlə alışıb-yanan,","poem":1},{"lineBreak":true},{"text":"Vadilərdə, qaya oyuqlarında,","poem":1},{"lineBreak":true},{"text":"Övladlarınızı qurban gətirən","poem":1},{"lineBreak":true},{"text":"Siz deyilmisiniz?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sizin payınız","poem":1},{"lineBreak":true},{"text":"Vadinin hamar daşlarından düzələn bütlərdir.","poem":1},{"lineBreak":true},{"text":"Onlardır, bəli, onlardır sizə nəsib olan.","poem":1},{"lineBreak":true},{"text":"Onların qarşısında içmə təqdimi tökdünüz,","poem":1},{"lineBreak":true},{"text":"Taxıl təqdimi gətirdiniz.","poem":1},{"lineBreak":true},{"text":"Bunlara görə Mən təsəlli taparammı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yatağınızı yüksək, uca dağda salmısınız,","poem":1},{"lineBreak":true},{"text":"Qurbanlarınızı kəsmək üçün də oraya çıxırsınız.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qapılarınıza, qapıların yan taxtalarının arxasına","poem":1},{"lineBreak":true},{"text":"İyrənc işarələr düzmüsünüz.","poem":1},{"lineBreak":true},{"text":"Məni tərk edib yatağınızı geniş açdınız,","poem":1},{"lineBreak":true},{"text":"Orada uzandınız, oynaşlarınızla sövdələşdiniz,","poem":1},{"lineBreak":true},{"text":"Birlikdə yatmağa can atdınız,","poem":1},{"lineBreak":true},{"text":"Onların çılpaqlığına tamaşa etdiniz!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ətirləri bol-bol vurandan sonra","poem":1},{"lineBreak":true},{"text":"Molek allahına sarı getdiniz.","poem":1},{"lineBreak":true},{"text":"Elçilərinizi uzaqlara göndərdiniz,","poem":1},{"lineBreak":true},{"text":"Özünüzü ölülər diyarına qədər endirdiniz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Uzun yollar sizi taqətdən saldı.","poem":1},{"lineBreak":true},{"text":"Lakin siz “daha bəsdir” demədiniz.","poem":1},{"lineBreak":true},{"text":"Gücünüzü təzələyib qalxdınız,","poem":1},{"lineBreak":true},{"text":"Buna görə yorulmadınız.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kim sizi qorxudub dəhşətə saldı ki,","poem":1},{"lineBreak":true},{"text":"Məni aldatdınız?","poem":1},{"lineBreak":true},{"text":"Məni yada salmadınız,","poem":1},{"lineBreak":true},{"text":"Ürəyinizdə Mənə yer vermədiniz?","poem":1},{"lineBreak":true},{"text":"Mən xeyli vaxt susduğuma görə,","poem":1},{"lineBreak":true},{"text":"Siz Məndən qorxmursunuz?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mən sizin salehliyinizi,","poem":1},{"lineBreak":true},{"text":"Etdiyiniz əməlləri aşkara çıxaracağam,","poem":1},{"lineBreak":true},{"text":"Bunların sizə xeyri olmayacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Siz fəryad edəndə","poem":1},{"lineBreak":true},{"text":"Bu yığdığınız bütlər","poem":1},{"lineBreak":true},{"text":"Görək sizi nə cür qurtaracaq!","poem":1},{"lineBreak":true},{"text":"Onların hamısını külək sovurub atacaq,","poem":1},{"lineBreak":true},{"text":"Bir nəfəs onları yerindən tərpədib aparacaq.","poem":1},{"lineBreak":true},{"text":"Lakin Mənə sığınan torpağı irs olaraq alacaq,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağımı mülk edəcək».","poem":1}]},{"type":"heading","content":["Rəbb xalqına şəfa verəcək"]},{"type":"verse","number":14,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Tikin, tikin, yol hazırlayın!","poem":1},{"lineBreak":true},{"text":"Xalqımın yolundakı əngəlləri götürün!»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Uca və əzəmətli,","poem":1},{"lineBreak":true},{"text":"Əbədi yaşayan, adı müqəddəs Olan","poem":1},{"lineBreak":true},{"text":"Belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən yüksək və müqəddəs yerdə yaşadığım halda","poem":1},{"lineBreak":true},{"text":"Ruhu əzilənlərlə, özünü aşağı tutanlarla birlikdəyəm ki,","poem":1},{"lineBreak":true},{"text":"Özünü aşağı tutanların ruhunu dirildim,","poem":1},{"lineBreak":true},{"text":"Əzilmişlərin ürəyini dirçəldim.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Həmişə çəkişib qəzəblənməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yoxsa yaratdığım canlı insan qarşımda dura bilməz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tamahkarlıq günahına görə","poem":1},{"lineBreak":true},{"text":"Qəzəblənib xalqı cəzalandırdım,","poem":1},{"lineBreak":true},{"text":"Hiddətlənib üzümü ondan döndərdim.","poem":1},{"lineBreak":true},{"text":"O da inad edib öz yolu ilə getdi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Əməllərini gördüm,","poem":1},{"lineBreak":true},{"text":"Amma bu xalqa şəfa verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ona rəhbərlik edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ona və onun yas tutanlarına təsəlli verəcəyəm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ağızları ilə həmdlər söyləyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Uzaqdakılara və yaxındakılara qoy sülh, sülh olsun».","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir: «Mən onlara şəfa verəcəyəm».","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pislər isə sanki dalğalanan dənizdir,","poem":1},{"lineBreak":true},{"text":"Bu dəniz sakit dura bilməz,","poem":1},{"lineBreak":true},{"text":"Onun suları palçıq və kir çıxarar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"«Pislərə isə sülh yoxdur» deyir mənim Allahım.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}