{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Düzgün oruc"]},{"type":"verse","number":1,"content":[{"text":"«Avazla çığırın, çəkinməyin,","poem":1},{"lineBreak":true},{"text":"Səsinizi şeypur səsi kimi ucaldın,","poem":1},{"lineBreak":true},{"text":"Xalqıma üsyankarlığını,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinə günahlarını bildirin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar hər gün Məni axtarır,","poem":1},{"lineBreak":true},{"text":"Mənim yolumu öyrənməkdən zövq alır.","poem":1},{"lineBreak":true},{"text":"Sanki bu əməlisaleh,","poem":1},{"lineBreak":true},{"text":"Allahının hökmündən ayrılmayan millət imiş.","poem":1},{"lineBreak":true},{"text":"Onlar Məndən düzgün hökmlər diləyirdi,","poem":1},{"lineBreak":true},{"text":"Allaha yaxınlaşmaqdan zövq alırdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Onlar belə deyir:","poem":1},{"lineBreak":true},{"text":"“Oruc tutduğumuzu nə üçün görmürsən,","poem":1},{"lineBreak":true},{"text":"Özümüzü aşağı tutanda,","poem":1},{"lineBreak":true},{"text":"Sən niyə fikir vermirsən?”","poem":1},{"lineBreak":true},{"text":"Baxın, oruc tutduğunuz gün","poem":1},{"lineBreak":true},{"text":"Siz istədiyinizi edirsiniz,","poem":1},{"lineBreak":true},{"text":"Bütün işçilərinizi sıxışdırırsınız.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baxın, orucunuzu savaşma ilə,","poem":1},{"lineBreak":true},{"text":"Dava ilə, yumruqla, döyməklə keçirirsiniz.","poem":1},{"lineBreak":true},{"text":"Səsinizi ucalara çatdırmaq üçün","poem":1},{"lineBreak":true},{"text":"Bugünkü kimi sizə oruc tutmaq olmaz.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İstədiyim oruc, insanın özünü aşağı tutduğu gün belə olmalı idimi?","poem":1},{"lineBreak":true},{"text":"Bu, qamış kimi başınızı əyib,","poem":1},{"lineBreak":true},{"text":"Əyninizə çul geyib, kül üstündə oturmağınızdırmı?","poem":1},{"lineBreak":true},{"text":"Bunamı oruc və Rəbbə məqbul olan gün deyirsiniz?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mənim istədiyim orucsa","poem":1},{"lineBreak":true},{"text":"Haqsızlığın buxovlarını qırmaq,","poem":1},{"lineBreak":true},{"text":"Boyunduruğun iplərini açmaq,","poem":1},{"lineBreak":true},{"text":"Sıxıntı içində olanları azad etmək,","poem":1},{"lineBreak":true},{"text":"Hər cür boyunduruğu məhv etmək deyilmi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yediyiniz çörəyi acla bölüşdürmək,","poem":1},{"lineBreak":true},{"text":"Yurdsuz kasıbları evinizə gətirmək deyilmi?","poem":1},{"lineBreak":true},{"text":"Mənim istədiyim oruc bu deyilmi?","poem":1},{"lineBreak":true},{"text":"Çılpaq görəndə geyindirmək,","poem":1},{"lineBreak":true},{"text":"Yaxınlarınızdan köməyinizi əsirgəməmək deyilmi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onda nurunuz şəfəq kimi saçacaq,","poem":1},{"lineBreak":true},{"text":"Tezliklə şəfa tapacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qarşınızda salehliyiniz gedəcək,","poem":1},{"lineBreak":true},{"text":"Rəbbin izzəti sizə arxa olacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O vaxt Rəbbi köməyə çağıracaqsınız, Rəbb cavab verəcək.","poem":1},{"lineBreak":true},{"text":"Fəryad edəcəksiniz, O sizə “buradayam” deyəcək.","poem":1},{"lineBreak":true},{"text":"Əgər siz boyunduruğu,","poem":1},{"lineBreak":true},{"text":"Yəni başqalarına zülm etməyinizi","poem":1},{"lineBreak":true},{"text":"Aranızdan rədd etsəniz,","poem":1},{"lineBreak":true},{"text":"Barmaq uzadıb şər sözlər söyləməyə yol verməsəniz,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Can-dildən acların qayğısına qalsanız,","poem":1},{"lineBreak":true},{"text":"Fəqirlərin ehtiyaclarını ödəsəniz,","poem":1},{"lineBreak":true},{"text":"Nurunuz qaranlıqda parlayacaq,","poem":1},{"lineBreak":true},{"text":"Qaranlığınız günorta işığı kimi nur saçacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb həmişə sizə yol göstərəcək,","poem":1},{"lineBreak":true},{"text":"Quru torpaqlarda sizi doyuzduracaq, güc verəcək.","poem":1},{"lineBreak":true},{"text":"Siz də sulanmış bağça kimi,","poem":1},{"lineBreak":true},{"text":"Suları heç vaxtı əskilməyən","poem":1},{"lineBreak":true},{"text":"Bulaq kimi olacaqsınız.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sizdən törənənlər qədim dağıntıları tikəcək,","poem":1},{"lineBreak":true},{"text":"Nəsillərdən qalma təməllərin üstünü","poem":1},{"lineBreak":true},{"text":"Siz bərpa edəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Sizə xarabalıqları bərpa edənlər,","poem":1},{"lineBreak":true},{"text":"Camaatın yaşaması üçün","poem":1},{"lineBreak":true},{"text":"Küçələri yenidən quranlar deyiləcək.","poem":1}]},{"type":"heading","content":["Şənbə gününə riayət edənlər üçün mükafat"]},{"type":"verse","number":13,"content":[{"text":"Şənbə günündə büdrəməsəniz,","poem":1},{"lineBreak":true},{"text":"Müqəddəs günümdə istədiyinizi etməsəniz,","poem":1},{"lineBreak":true},{"text":"Şənbə gününü “şən gün”,","poem":1},{"lineBreak":true},{"text":"Rəbbin müqəddəs gününü","poem":1},{"lineBreak":true},{"text":"“Şərəfli gün” adlandırsanız,","poem":1},{"lineBreak":true},{"text":"Öz yolunuzla getməməklə,","poem":1},{"lineBreak":true},{"text":"İstədiyinizi əldə etməməklə,","poem":1},{"lineBreak":true},{"text":"Boşboğazlıqla məşğul olmamaqla,","poem":1},{"lineBreak":true},{"text":"O günü əziz tutsanız,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəblə ünsiyyətdən zövq alacaqsınız.","poem":1},{"lineBreak":true},{"text":"O zaman Mən sizi yer üzünün","poem":1},{"lineBreak":true},{"text":"Yüksək yerlərinə çıxaracağam,","poem":1},{"lineBreak":true},{"text":"Atanız Yaqubun payından dadacaqsınız».","poem":1},{"lineBreak":true},{"text":"Bu sözlər Rəbbin ağzından çıxıb.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}