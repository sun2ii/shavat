{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Günah və etiraf"]},{"type":"verse","number":1,"content":[{"text":"Ah, Rəbbin əli qısa deyil ki, xilas edə bilməsin,","poem":1},{"lineBreak":true},{"text":"Qulağı kar deyil ki, eşidə bilməsin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lakin şər əməlləriniz","poem":1},{"lineBreak":true},{"text":"Allahınızla sizin aranızda ayrılıq saldı.","poem":1},{"lineBreak":true},{"text":"Günahlarınıza görə Onun üzü sizdən döndü,","poem":1},{"lineBreak":true},{"text":"O səsinizi eşitmir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki əlləriniz qanla,","poem":1},{"lineBreak":true},{"text":"Barmaqlarınız şər əməllərlə murdarlanıb.","poem":1},{"lineBreak":true},{"text":"Dodaqlarınız yalan danışır,","poem":1},{"lineBreak":true},{"text":"Diliniz pislik söyləyir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məhkəmədə ədalətlə işə baxan yoxdur,","poem":1},{"lineBreak":true},{"text":"Doğruluqla özünü müdafiə edən yoxdur,","poem":1},{"lineBreak":true},{"text":"Boş sözlərə güvənirlər, aldadırlar,","poem":1},{"lineBreak":true},{"text":"Əziyyətə hamilə olub pislik doğurlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gürzə yumurtalarına qırt yatırlar,","poem":1},{"lineBreak":true},{"text":"Hörümçək toru toxuyurlar.","poem":1},{"lineBreak":true},{"text":"O yumurtalardan yeyən ölür,","poem":1},{"lineBreak":true},{"text":"Qırılan yumurtalardan əfi ilan çıxır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onların toxuduğu hörümçək torundan paltar çıxmaz,","poem":1},{"lineBreak":true},{"text":"Toxuduqları parça ilə özlərini örtə bilmirlər.","poem":1},{"lineBreak":true},{"text":"Elədikləri əməllər şər əməllərdir,","poem":1},{"lineBreak":true},{"text":"Əllərində zorakılıq işləri var.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ayaqları pis işlər etməyə tələsir,","poem":1},{"lineBreak":true},{"text":"Günahsız qan tökməyə cəlddir.","poem":1},{"lineBreak":true},{"text":"Fikirləri, niyyətləri şər əməllərdir,","poem":1},{"lineBreak":true},{"text":"Yollarında viranəlik, qırğın var.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əmin-amanlıq yolu nədir, onlar bilmirlər,","poem":1},{"lineBreak":true},{"text":"Getdikləri yolda ədalət yoxdur,","poem":1},{"lineBreak":true},{"text":"Özlərinə əyri yol seçdilər,","poem":1},{"lineBreak":true},{"text":"O yoldan gedənlərin heç biri","poem":1},{"lineBreak":true},{"text":"Əmin-amanlıq nədir bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Buna görə ədalət bizdən uzaqlaşıb,","poem":1},{"lineBreak":true},{"text":"Salehliyə çata bilmirik.","poem":1},{"lineBreak":true},{"text":"İşıq ümidindəyik, lakin qaranlıqdayıq,","poem":1},{"lineBreak":true},{"text":"Aydınlıq gözləyirik, zülmətdə yeriyirik.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kor kimi əllərimizlə divarı yoxlayırıq,","poem":1},{"lineBreak":true},{"text":"Gözü görməyənlər tək yol axtarırıq.","poem":1},{"lineBreak":true},{"text":"Günorta çağı gecə vaxtı olduğu kimi büdrəyirik,","poem":1},{"lineBreak":true},{"text":"Güclülər arasında ölülər kimiyik.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hamımız ayı kimi nərildəyirik,","poem":1},{"lineBreak":true},{"text":"Göyərçin tək inildəyirik.","poem":1},{"lineBreak":true},{"text":"Ədalət gözləyirik, lakin heç bir şey yoxdur.","poem":1},{"lineBreak":true},{"text":"Qurtuluş gözləyirik, amma bizdən uzaqdır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki Önündə üsyankarlığımız böyükdür,","poem":1},{"lineBreak":true},{"text":"Günahlarımız bizə qarşı şəhadət edir.","poem":1},{"lineBreak":true},{"text":"Üsyankarlığımız bizi dövrəyə alıb,","poem":1},{"lineBreak":true},{"text":"Şər əməllərimizdən xəbərdarıq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Üsyankar olub Rəbbi rədd etdik,","poem":1},{"lineBreak":true},{"text":"Allahımızın ardınca getmədik,","poem":1},{"lineBreak":true},{"text":"Zorakılıq, xəyanətlə dolu sözlər danışdıq,","poem":1},{"lineBreak":true},{"text":"Yalan kəlmələri ürəyimizdə gizlətdik,","poem":1},{"lineBreak":true},{"text":"Sonra aşkara çıxartdıq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ədalət geri çəkildi,","poem":1},{"lineBreak":true},{"text":"Salehlik uzaqda durdu,","poem":1},{"lineBreak":true},{"text":"Çünki həqiqət şəhər meydanında yıxıldı,","poem":1},{"lineBreak":true},{"text":"Dürüstlük aramıza daxil ola bilmir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Həqiqət heç bir yerdə yoxdur,","poem":1},{"lineBreak":true},{"text":"Şərdən uzaq duran talan olunur.","poem":1},"Rəbb xalqını qurtaracaq",{"text":"Rəbb bunları gördü,","poem":1},{"lineBreak":true},{"text":"Ədalətin yoxluğu Onun xoşuna gəlmədi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb gördü ki, heç kim yoxdur,","poem":1},{"lineBreak":true},{"text":"Havadarın olmadığına görə O mat qaldı.","poem":1},{"lineBreak":true},{"text":"Onda Onun qolu Ona zəfər gətirdi,","poem":1},{"lineBreak":true},{"text":"Salehliyi Ona dayaq oldu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"O, salehliyi zireh kimi geydi,","poem":1},{"lineBreak":true},{"text":"Qurtuluş dəbilqəsini başına taxdı.","poem":1},{"lineBreak":true},{"text":"Qisas geyimlərini geydi,","poem":1},{"lineBreak":true},{"text":"Qeyrət libasına büründü.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O hər kəsə əməllərinə görə əvəz verəcək.","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə qəzəblə, yağılarına,","poem":1},{"lineBreak":true},{"text":"Uzaq diyarlara qisasla əvəz verəcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Beləcə qərbdən şərqədək adamlar","poem":1},{"lineBreak":true},{"text":"Rəbbin adından və əzəmətindən qorxacaq.","poem":1},{"lineBreak":true},{"text":"Çünki düşmən azğın bir çay kimi gəldikdə","poem":1},{"lineBreak":true},{"text":"Rəbbin nəfəsi onu qovacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rəbb bəyan edir: «Satınalan Siona gələcək,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinin üsyankarlıqdan dönənlərinin yanına gələcək».","poem":1}]},{"type":"verse","number":21,"content":["«Mənim onlarla bağladığım əhd budur: üzərindəki Ruhum, ağzına qoyduğum sözlərim indidən sonsuzadək sənin, övladlarının, nəvə-nəticələrinin ağzından düşməyəcək». Bunu Allah deyir."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}