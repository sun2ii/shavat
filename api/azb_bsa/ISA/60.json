{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Sionun şərəfli gələcəyi"]},{"type":"verse","number":1,"content":[{"text":"Qalx, işıqlan, çünki nurun gəldi,","poem":1},{"lineBreak":true},{"text":"Rəbbin izzəti üzərinə gəldi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Budur, dünyanı qaranlıq, ümmətləri zülmət bürüyəcək.","poem":1},{"lineBreak":true},{"text":"Amma Rəbb üzərinə nur saçacaq,","poem":1},{"lineBreak":true},{"text":"İzzəti səni əhatə edəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Millətlər sənin nuruna,","poem":1},{"lineBreak":true},{"text":"Padşahlar üzərinə çökən aydınlığa doğru gələcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Qaldır başını, bax ətrafına,","poem":1},{"lineBreak":true},{"text":"Hamı yığılıb yanına gəlir!","poem":1},{"lineBreak":true},{"text":"Oğulların uzaqdan gəlir,","poem":1},{"lineBreak":true},{"text":"Qızların qucaqda gətirilir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O vaxt bunu görüb üzün nur saçacaq,","poem":1},{"lineBreak":true},{"text":"Ürəyin sevincdən tez-tez çırpınacaq.","poem":1},{"lineBreak":true},{"text":"Çünki uzaq ölkələrin var-dövləti sənə gətiriləcək,","poem":1},{"lineBreak":true},{"text":"Millətlərin sərvəti sənə gələcək.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dəvə sürüləri, Midyan və Efa köşəkləri","poem":1},{"lineBreak":true},{"text":"Torpaqlarını dolduracaq.","poem":1},{"lineBreak":true},{"text":"Bütün Səba xalqı gəlib","poem":1},{"lineBreak":true},{"text":"Qızıl və kündür gətirəcək,","poem":1},{"lineBreak":true},{"text":"Rəbbə həmdlər söyləyəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qedarın bütün qoyun sürüləri yanına yığılacaq,","poem":1},{"lineBreak":true},{"text":"Nevayotun qoçları sənin əlinin altında olacaq,","poem":1},{"lineBreak":true},{"text":"Qurbangahıma Mənə məqbul olan qurbanlar gətiriləcək.","poem":1},{"lineBreak":true},{"text":"Şərəfli evimi daha da izzətləndirəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kimdir bunlar, bulud kimi,","poem":1},{"lineBreak":true},{"text":"Yuvalarına yaxınlaşan göyərçin tək uçub gələnlər?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzaq diyarlar Mənə ümid bağladıqlarına görə","poem":1},{"lineBreak":true},{"text":"Tarşiş gəmiləri başda olmaqla","poem":1},{"lineBreak":true},{"text":"Allahın Rəbbin şərəfinə,","poem":1},{"lineBreak":true},{"text":"Səni ucaldan İsrailin Müqəddəsi üçün","poem":1},{"lineBreak":true},{"text":"Sənin övladlarını qızıl-gümüşü ilə","poem":1},{"lineBreak":true},{"text":"Uzaqdan gətirən gəmilərdir bunlar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əcnəbilər divarlarını tikəcək,","poem":1},{"lineBreak":true},{"text":"Padşahları sənə xidmət edəcək.","poem":1},{"lineBreak":true},{"text":"Qəzəbimdə səni vurdumsa da,","poem":1},{"lineBreak":true},{"text":"Lütfümlə sənə mərhəmət edəcəyəm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Darvazaların həmişə açıq qalacaq,","poem":1},{"lineBreak":true},{"text":"Nə gecə, nə də gündüz qıfıllanmayacaq ki,","poem":1},{"lineBreak":true},{"text":"Millətlərin sərvəti sənə təqdim olunsun,","poem":1},{"lineBreak":true},{"text":"Padşahları yanına gətirilsin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki sənə xidmət etmək istəməyən","poem":1},{"lineBreak":true},{"text":"Millət ya padşahlıq məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Bəli, o millətlər tamamilə yox olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Livanın şan-şöhrəti olan şam ağacı, çinar və sərv ağacları","poem":1},{"lineBreak":true},{"text":"Müqəddəs məkanımdakı yeri gözəlləşdirmək üçün","poem":1},{"lineBreak":true},{"text":"Birgə yanına gətiriləcək,","poem":1},{"lineBreak":true},{"text":"Qədəm qoyduğum yeri şərəfləndirəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sənə zülm edənlərin övladları","poem":1},{"lineBreak":true},{"text":"Gəlib önündə təzim edəcək.","poem":1},{"lineBreak":true},{"text":"Sənə həqarətlə baxanların hamısı","poem":1},{"lineBreak":true},{"text":"Ayaqlarına düşüb səcdə edəcək.","poem":1},{"lineBreak":true},{"text":"Sənə Rəbbin şəhəri,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsinin Sionu deyəcəklər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Səni tərk edib nifrət etdilər,","poem":1},{"lineBreak":true},{"text":"Yanından heç kim keçmirdi,","poem":1},{"lineBreak":true},{"text":"İndi isə Mən səni əbədi fəxr,","poem":1},{"lineBreak":true},{"text":"Nəsillər boyu sevinc edəcəyəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Millətlər və padşahlar","poem":1},{"lineBreak":true},{"text":"Bir ana kimi sənə süd verəcəklər.","poem":1},{"lineBreak":true},{"text":"O vaxt biləcəksən ki, səni qurtaran Rəbb,","poem":1},{"lineBreak":true},{"text":"Səni Satınalan, Yaqubun qüdrətli Allahı Mənəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sənə tunc əvəzinə qızıl,","poem":1},{"lineBreak":true},{"text":"Dəmir yerinə gümüş,","poem":1},{"lineBreak":true},{"text":"Ağac yerinə tunc,","poem":1},{"lineBreak":true},{"text":"Daş əvəzinə dəmir gətirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Əmin-amanlığı başçın,","poem":1},{"lineBreak":true},{"text":"Salehliyi hökmdarın təyin edəcəyəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ölkəndən zorakılıq,","poem":1},{"lineBreak":true},{"text":"Sərhədlərindən viranəlik,","poem":1},{"lineBreak":true},{"text":"Qırğın xəbəri gəlməyəcək.","poem":1},{"lineBreak":true},{"text":"Divarlarını «Xilas»,","poem":1},{"lineBreak":true},{"text":"Darvazalarını «Həmd» adlandıracaqsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Artıq gündüz günəş sənin işığın olmayacaq,","poem":1},{"lineBreak":true},{"text":"Gecə ay sənə aydınlıq verməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb əbədi nurun,","poem":1},{"lineBreak":true},{"text":"Allahın sənin şöhrətin olacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Günəşin batmayacaq, ayın gizlənməyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb əbədi nurun olacaq,","poem":1},{"lineBreak":true},{"text":"Sənin yaslı günlərin qurtaracaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bütün xalqın saleh olacaq,","poem":1},{"lineBreak":true},{"text":"Torpağı əbədi mülk olaraq alacaq.","poem":1},{"lineBreak":true},{"text":"Onlar əkdiyim fidandır,","poem":1},{"lineBreak":true},{"text":"Şöhrətimi göstərmək üçün əlimin işidir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ən kiçik ailədən böyük nəsil törəyəcək,","poem":1},{"lineBreak":true},{"text":"Azsaylı nəsil qüdrətli millət olacaq.","poem":1},{"lineBreak":true},{"text":"Mən Rəbb bunu öz vaxtında tez edəcəyəm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}