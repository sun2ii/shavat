{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Rəbbin lütf ili"]},{"type":"verse","number":1,"content":[{"text":"Xudavənd Rəbbin Ruhu üzərimdədir,","poem":1},{"lineBreak":true},{"text":"Çünki fəqirlərə müjdəni bildirmək üçün","poem":1},{"lineBreak":true},{"text":"O məni məsh etdi.","poem":1},{"lineBreak":true},{"text":"Qəlbi sınıq olanlar üçün, yaralarını sarımaq üçün,","poem":1},{"lineBreak":true},{"text":"Əsirlərə azadlıq,","poem":1},{"lineBreak":true},{"text":"Dustaqlara sərbəstlik elan etmək üçün,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbin lütf ilini,","poem":1},{"lineBreak":true},{"text":"Allahımızın qisas gününü bəyan etmək üçün,","poem":1},{"lineBreak":true},{"text":"Yaslıların hamısına təsəlli vermək üçün,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sionda yas tutanları təmin etmək,","poem":1},{"lineBreak":true},{"text":"Kül yerinə çələng,","poem":1},{"lineBreak":true},{"text":"Yas yerinə sevinc gətirən məsh yağı,","poem":1},{"lineBreak":true},{"text":"Kədərli ruh əvəzinə","poem":1},{"lineBreak":true},{"text":"Həmd libasını bəxş etmək üçün","poem":1},{"lineBreak":true},{"text":"Rəbb məni göndərdi.","poem":1},{"lineBreak":true},{"text":"Rəbbin şöhrətini aşkar etmək üçün","poem":1},{"lineBreak":true},{"text":"Onlara Rəbbin əkdiyi salehlik palıdları deyiləcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlar qədim dağıntıları inşa edəcək,","poem":1},{"lineBreak":true},{"text":"Əvvəlki xarabalıqları bərpa edəcək,","poem":1},{"lineBreak":true},{"text":"Nəsillər boyu viranə qalmış şəhərləri yenidən quracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yadellilər gəlib sürülərinizi otaracaq,","poem":1},{"lineBreak":true},{"text":"Əcnəbilər sizə əkinçilik və bağbanlıq edəcək.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sizsə Rəbbin kahinləri,","poem":1},{"lineBreak":true},{"text":"Allahımızın xidmətçiləri adlanacaqsınız.","poem":1},{"lineBreak":true},{"text":"Millətlərin sərvəti ilə bəslənəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Var-dövlətləri ilə fəxr edəcəksiniz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çəkdiyiniz xəcalət yerinə ikiqat şərəf,","poem":1},{"lineBreak":true},{"text":"Rüsvayçılıq əvəzinə payınızı alıb sevinəcəksiniz.","poem":1},{"lineBreak":true},{"text":"İndi isə torpağınızda ikiqat mülk alacaqsınız,","poem":1},{"lineBreak":true},{"text":"Sevinciniz əbədi olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Çünki Mən Rəbb ədaləti sevirəm.","poem":1},{"lineBreak":true},{"text":"Soyğunçuluğa, haqsızlığa nifrət edirəm.","poem":1},{"lineBreak":true},{"text":"Əlbəttə, əməllərinə görə onlara haqqını verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlarla əbədi əhd kəsəcəyəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nəsillərindən törəyənlər millətlər içində,","poem":1},{"lineBreak":true},{"text":"Övladları xalqlar arasında tanınacaq.","poem":1},{"lineBreak":true},{"text":"Onları görən hər kəs biləcək ki,","poem":1},{"lineBreak":true},{"text":"Rəbb nəsillərinə xeyir-dua verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbdə böyük sevinc tapacağam,","poem":1},{"lineBreak":true},{"text":"Allahımda ürəyim şadlıqdan coşacaq,","poem":1},{"lineBreak":true},{"text":"Çünki çələnglə bəzənmiş bəy kimi,","poem":1},{"lineBreak":true},{"text":"Bər-bəzək taxmış gəlin kimi","poem":1},{"lineBreak":true},{"text":"Mənə qurtuluş paltarı geyindirdi,","poem":1},{"lineBreak":true},{"text":"Salehlik libası ilə bürüdü.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Torpaq zoğlarını necə cücərdirsə,","poem":1},{"lineBreak":true},{"text":"Bağ əkilən toxumları necə yetişdirirsə,","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb də bütün millətlər qarşısında","poem":1},{"lineBreak":true},{"text":"Salehliyi və həmdi belə yetişdirəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}