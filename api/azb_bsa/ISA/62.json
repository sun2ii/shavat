{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Sionun yeni adı"]},{"type":"verse","number":1,"content":[{"text":"Salehliyi nur kimi saçanadək,","poem":1},{"lineBreak":true},{"text":"Qurtuluşu məşəl tək yananadək","poem":1},{"lineBreak":true},{"text":"Sion naminə susmayacağam,","poem":1},{"lineBreak":true},{"text":"Yerusəlim naminə sakit durmayacağam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Millətlər salehliyini,","poem":1},{"lineBreak":true},{"text":"Bütün padşahlar əzəmətini görəcək.","poem":1},{"lineBreak":true},{"text":"Rəbbin ağzı ilə deyəcəyi,","poem":1},{"lineBreak":true},{"text":"Sənə verəcəyi yeni bir adla çağırılacaqsan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sən Rəbbin əlində gözəllik tacı,","poem":1},{"lineBreak":true},{"text":"Allahının ovcunda padşahlıq çələngi olacaqsan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Artıq sənə «atılmış»,","poem":1},{"lineBreak":true},{"text":"Ölkənə «viranə qalmış» deməyəcəklər.","poem":1},{"lineBreak":true},{"text":"Əvəzinə sənə «sevdiyim»,","poem":1},{"lineBreak":true},{"text":"Ölkənə isə «ərli» deyiləcək.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb səni sevəcək,","poem":1},{"lineBreak":true},{"text":"Ölkən də ərli sayılacaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bir gənc bakirə qızla evləndiyi kimi","poem":1},{"lineBreak":true},{"text":"Səni Yaradan da səninlə evlənəcək.","poem":1},{"lineBreak":true},{"text":"Bəy gəlindən zövq aldığı kimi","poem":1},{"lineBreak":true},{"text":"Allahın da səndən zövq alacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey Yerusəlim, divarlarının üstünə","poem":1},{"lineBreak":true},{"text":"Mən qarovulçular qoydum.","poem":1},{"lineBreak":true},{"text":"Gecə-gündüz onlar susmayacaq.","poem":1},{"lineBreak":true},{"text":"Ey Rəbbə sözünü xatırladan sizlər, susmayın,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb Yerusəlimi bərpa edənədək,","poem":1},{"lineBreak":true},{"text":"Onu yer üzünün tərifə layiq şəhərinə döndərənədək","poem":1},{"lineBreak":true},{"text":"Ona rahatlıq verməyin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb sağ əlini, güclü qolunu","poem":1},{"lineBreak":true},{"text":"Qaldırıb and içdi:","poem":1},{"lineBreak":true},{"text":"«Düşmənlərinə sənin taxılını bir daha yedirtməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yadellilər sənin əziyyətlə sıxdığın şərabını içməyəcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Taxılı yığan yeyəcək,","poem":1},{"lineBreak":true},{"text":"Rəbbə həmdlər edəcək.","poem":1},{"lineBreak":true},{"text":"Üzümü toplayan şərabını","poem":1},{"lineBreak":true},{"text":"Məbədimin həyətlərində içəcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Keçin, keçin şəhər darvazalarından,","poem":1},{"lineBreak":true},{"text":"Xalq üçün yol hazırlayın!","poem":1},{"lineBreak":true},{"text":"Tikin, yol salın,","poem":1},{"lineBreak":true},{"text":"Daşları kənara atın,","poem":1},{"lineBreak":true},{"text":"Xalqlar üçün bayraq qaldırın!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb yer üzünün ən uzaq yerlərinə bəyan etdi:","poem":1},{"lineBreak":true},{"text":"«Sion qızına deyin:","poem":1},{"lineBreak":true},{"text":"“Budur, qurtuluşun gəlir,","poem":1},{"lineBreak":true},{"text":"Rəbbin mükafatı onunladır,","poem":1},{"lineBreak":true},{"text":"Ənamı önündədir”».","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sion xalqına","poem":1},{"lineBreak":true},{"text":"«Rəbbin satın aldığı, müqəddəs xalq» deyəcəklər.","poem":1},{"lineBreak":true},{"text":"Sən, ey Yerusəlim,","poem":1},{"lineBreak":true},{"text":"«Allahın axtardığı, tərk olmamış şəhər» adlanacaqsan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}