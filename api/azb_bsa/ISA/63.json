{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Rəbbin qüdrəti"]},{"type":"verse","number":1,"content":[{"text":"Edomdan, Bosradan al geyimlər geyib","poem":1},{"lineBreak":true},{"text":"Bu gələn kimdir?","poem":1},{"lineBreak":true},{"text":"Təmtəraqlı libas içində,","poem":1},{"lineBreak":true},{"text":"Böyük qüdrətlə gələn kimdir?","poem":1},{"lineBreak":true},{"text":"«O Mənəm, həqiqətlə danışan,","poem":1},{"lineBreak":true},{"text":"Qurtarmağa qadir olan».","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nə üçün geyimlərin qırmızıdır,","poem":1},{"lineBreak":true},{"text":"Nə üçün libasın al rəngdədir,","poem":1},{"lineBreak":true},{"text":"Sanki sən üzümsıxanda üzüm sıxırdın?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"«Üzümsıxanda üzümü tək sıxdım,","poem":1},{"lineBreak":true},{"text":"Yanımda xalqlardan heç kim olmadı.","poem":1},{"lineBreak":true},{"text":"Qəzəb içində onları tapdaladım,","poem":1},{"lineBreak":true},{"text":"Qeyzlə təpiyimin altına saldım.","poem":1},{"lineBreak":true},{"text":"Qanları geyimlərimə sıçradı,","poem":1},{"lineBreak":true},{"text":"Bütün libaslarımı bulaşdırdım.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki qisas günü qəlbimdə idi,","poem":1},{"lineBreak":true},{"text":"Xalqımı satın aldığım il gəldi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən baxdım, kömək edən bir kəs yox idi,","poem":1},{"lineBreak":true},{"text":"Mənim tərəfimi saxlayan olmadığına məəttəl qaldım,","poem":1},{"lineBreak":true},{"text":"Onda qolum mənə zəfər gətirdi,","poem":1},{"lineBreak":true},{"text":"Qeyzim mənə dayaq oldu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qəzəb içində xalqları tapdaladım,","poem":1},{"lineBreak":true},{"text":"Qeyzimi onlara içirtdim,","poem":1},{"lineBreak":true},{"text":"Qanlarını yerə axıtdım».","poem":1}]},{"type":"heading","content":["Rəbbin xeyirxahlığı"]},{"type":"verse","number":7,"content":[{"text":"Rəbbin lütfkar işlərindən,","poem":1},{"lineBreak":true},{"text":"Həmdlərə layiq əməllərindən nəql edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Böyük mərhəməti və məhəbbəti naminə,","poem":1},{"lineBreak":true},{"text":"İsrail nəslinə etdiyi böyük xeyirxahlığına görə,","poem":1},{"lineBreak":true},{"text":"Rəbbin bizə etdiyi bütün işlərinə görə","poem":1},{"lineBreak":true},{"text":"Onu xatırlayacağam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb dedi:","poem":1},{"lineBreak":true},{"text":"«Əlbəttə, onlar Mənim xalqımdır,","poem":1},{"lineBreak":true},{"text":"Məni aldatmayan övladlarımdır».","poem":1},{"lineBreak":true},{"text":"Beləcə onlara Qurtarıcı oldu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar əziyyət çəkdikdə","poem":1},{"lineBreak":true},{"text":"O da əziyyət çəkdi.","poem":1},{"lineBreak":true},{"text":"Hüzurundan gələn mələk onları xilas etdi.","poem":1},{"lineBreak":true},{"text":"Məhəbbəti və mərhəməti ilə","poem":1},{"lineBreak":true},{"text":"Onları satın aldı.","poem":1},{"lineBreak":true},{"text":"Bütün keçmiş günlərdə onları götürüb apardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lakin İsrail üsyankar olaraq","poem":1},{"lineBreak":true},{"text":"Onun Müqəddəs Ruhunu kədərləndirdi.","poem":1},{"lineBreak":true},{"text":"Rəbb də düşməni olub","poem":1},{"lineBreak":true},{"text":"Onlara qarşı döyüşdü.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sonra xalq keçmiş günləri –","poem":1},{"lineBreak":true},{"text":"Rəbbin qulu Musanın dövrünü yada saldı.","poem":1},{"lineBreak":true},{"text":"Onları sürüsünün çobanları ilə birgə","poem":1},{"lineBreak":true},{"text":"Dənizdən keçirən haradadır?","poem":1},{"lineBreak":true},{"text":"Onların daxilinə","poem":1},{"lineBreak":true},{"text":"Müqəddəs Ruhunu ehsan edən,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Öz əzəmətli gücü ilə Musanın sağ əlindən tutub,","poem":1},{"lineBreak":true},{"text":"Özünə əbədi ad qazandırmaq üçün","poem":1},{"lineBreak":true},{"text":"Suları qarşılarında yaran Rəbb haradadır?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bir at çöldə yıxılmadan çapan kimi","poem":1},{"lineBreak":true},{"text":"Onları da dərinliklərdən elə keçirən Rəbb haradadır?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbbin Ruhu onlara elə rahatlıq verdi ki,","poem":1},{"lineBreak":true},{"text":"Elə bil naxır otu bol olan dərədə otarılır.","poem":1},{"lineBreak":true},{"text":"Bəli, Sən adını şərəfləndirmək naminə","poem":1},{"lineBreak":true},{"text":"Xalqına belə yol göstərdin.","poem":1}]},{"type":"heading","content":["Rəhm və imdad haqqında yalvarış"]},{"type":"verse","number":15,"content":[{"text":"Ya Rəbb, göylərdən bax,","poem":1},{"lineBreak":true},{"text":"Müqəddəs, izzətli, uca məskənindən bizə nəzər sal!","poem":1},{"lineBreak":true},{"text":"Haradadır Sənin qeyrətin, gücün?","poem":1},{"lineBreak":true},{"text":"Qəlbindəki həsrəti, rəhmi bizdən əsirgədin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sənsən Atamız.","poem":1},{"lineBreak":true},{"text":"İbrahim bizi tanımasa da,","poem":1},{"lineBreak":true},{"text":"İsrail bizim kim olduğumuzu bilməsə də,","poem":1},{"lineBreak":true},{"text":"Atamız Sənsən, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Əzəldən bəri adın «Bizi Satınalan»dır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nə üçün, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Bizi yolundan azdırırsan,","poem":1},{"lineBreak":true},{"text":"Səndən qorxmayaq deyə","poem":1},{"lineBreak":true},{"text":"Qəlblərimizi inadkar edirsən?","poem":1},{"lineBreak":true},{"text":"Qullarının xatirinə,","poem":1},{"lineBreak":true},{"text":"İrsin olan qəbilələrinin xatirinə geri dön.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Müqəddəs xalqın qısa müddətə Sənin Müqəddəs məkanına sahib oldu.","poem":1},{"lineBreak":true},{"text":"İndi isə oranı düşmənlərimizin ayağı tapdalayır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Əzəldən bəri heç vaxt","poem":1},{"lineBreak":true},{"text":"Hakimlik etmədiyin xalqa bənzədik,","poem":1},{"lineBreak":true},{"text":"Sanki Sənin adına bağlı xalq olmamışıq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}