{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, kaş göyləri yarıb enəydin,","poem":1},{"lineBreak":true},{"text":"Dağlar hüzurunda sarsılardı!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alov kolluğu yandıran kimi,","poem":1},{"lineBreak":true},{"text":"Od suyu qaynadan kimi","poem":1},{"lineBreak":true},{"text":"Adını yağılarına tanıtdıraydın,","poem":1},{"lineBreak":true},{"text":"Millətlər önündə lərzəyə gələrdi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sən gözləmədiyimiz əzəmətli işlər edəndə","poem":1},{"lineBreak":true},{"text":"Endin yer üzünə, dağlar önündə sarsıldı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ona etibar edənlər üçün belə işlər edən Allahı,","poem":1},{"lineBreak":true},{"text":"Əzəldən bəri Səndən başqasını nə göz görüb, nə də qulaq eşidib.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sevinə-sevinə salehlik edəni,","poem":1},{"lineBreak":true},{"text":"Yollarında Səni xatırlayanları qarşılayırsan.","poem":1},{"lineBreak":true},{"text":"Amma biz günaha batdıq, Sən qəzəbləndin.","poem":1},{"lineBreak":true},{"text":"Beləcə xeyli vaxt yaşadıq,","poem":1},{"lineBreak":true},{"text":"Bəs biz necə xilas ola bilərik?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamımız elə bil ki murdarlandıq,","poem":1},{"lineBreak":true},{"text":"Bütün saleh əməllərimiz murdar əskiyə bənzəyir.","poem":1},{"lineBreak":true},{"text":"Hamımız yarpaq kimi soluruq,","poem":1},{"lineBreak":true},{"text":"Şər əməllərimiz bizi külək tək sovurub-aparır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin adını çağıran yoxdur,","poem":1},{"lineBreak":true},{"text":"Sənə bağlanmaq üçün can atan yoxdur.","poem":1},{"lineBreak":true},{"text":"Çünki bizdən üz döndərdin,","poem":1},{"lineBreak":true},{"text":"Şər əməllərimizə görə bizi yox etdin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yenə də, ya Rəbb, Sənsən Atamız:","poem":1},{"lineBreak":true},{"text":"Biz gilik, Sən isə dulusçu,","poem":1},{"lineBreak":true},{"text":"Biz hamımız Sənin əlinin işiyik.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ya Rəbb, çox qəzəblənmə,","poem":1},{"lineBreak":true},{"text":"Şər əməllərimizi heç vaxt xatırlama,","poem":1},{"lineBreak":true},{"text":"Hamımız Sənin xalqınıq, bunu nəzərə al.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Müqəddəs şəhərlərin səhraya,","poem":1},{"lineBreak":true},{"text":"Sion çöllüyə döndü,","poem":1},{"lineBreak":true},{"text":"Yerusəlim viran qaldı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Atalarımızın Sənə həmd etdikləri yer –","poem":1},{"lineBreak":true},{"text":"Müqəddəs, şanlı məbədimiz yandı,","poem":1},{"lineBreak":true},{"text":"Gözəl binalarımız xaraba qaldı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bütün bunlardan sonra,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, yenə də Özünü saxlayacaqsanmı?","poem":1},{"lineBreak":true},{"text":"Susub bizi nə qədər alçaldacaqsan?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}