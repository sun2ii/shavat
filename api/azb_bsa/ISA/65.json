{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Dikbaşlar cəza çəkəcək"]},{"type":"verse","number":1,"content":[{"text":"«Məni soruşmayanlara Mən zühur etdim,","poem":1},{"lineBreak":true},{"text":"Məni axtarmayanlar tərəfindən tapıldım.","poem":1},{"lineBreak":true},{"text":"Adımı çağırmayan millətə dedim:","poem":1},{"lineBreak":true},{"text":"“Buradayam! Buradayam!”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pis yolla gedən,","poem":1},{"lineBreak":true},{"text":"Öz düşüncələri ilə hərəkət edən","poem":1},{"lineBreak":true},{"text":"Dikbaş xalqa gün boyu əllərimi uzadıb durdum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O xalq ki bağlarda qurban kəsərək,","poem":1},{"lineBreak":true},{"text":"Kərpiclərin üstündə buxur yandırıb","poem":1},{"lineBreak":true},{"text":"Gözüm önündə daima Məni təhqir edir,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qəbiristanlıqda oturub","poem":1},{"lineBreak":true},{"text":"Gizli yerlərdə gecələyir,","poem":1},{"lineBreak":true},{"text":"Donuz əti yeyir,","poem":1},{"lineBreak":true},{"text":"Qablarında haram ət qaynadır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlar bir-birinə deyir: “Uzaq dur,","poem":1},{"lineBreak":true},{"text":"Mənə yaxınlaşma, çünki mən səndən müqəddəsəm”.","poem":1},{"lineBreak":true},{"text":"Belələri burnuma tüstü,","poem":1},{"lineBreak":true},{"text":"Bütün gün yanan alovdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Budur, qarşımda bunlar yazılıb:","poem":1},{"lineBreak":true},{"text":"Mən susmayacağam,","poem":1},{"lineBreak":true},{"text":"Ancaq onların əvəzini verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Əməllərini başlarına çevirəcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların da, atalarının da qəbahətlərinin cəzasını","poem":1},{"lineBreak":true},{"text":"Onlara çəkdirəcəyəm».","poem":1},{"lineBreak":true},{"text":"Rəbb deyir.","poem":1},{"lineBreak":true},{"text":"«Dağların başında buxur yandırdıqlarına görə,","poem":1},{"lineBreak":true},{"text":"Təpələrin başında Mənə küfr etdiklərinə görə","poem":1},{"lineBreak":true},{"text":"Mən əvvəlki əməllərini ölçüb onların əvəzini onlara çəkdirəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Üzüm salxımında şirə tapıldığına görə deyirlər:","poem":1},{"lineBreak":true},{"text":"“Salxımı xarab etməyin, içində bərəkət var”.","poem":1},{"lineBreak":true},{"text":"Mən də qullarımın xatirinə belə edərəm ki,","poem":1},{"lineBreak":true},{"text":"Onların hamısı məhv olmasın.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaqubdan törəyənlərin sayını artıracağam,","poem":1},{"lineBreak":true},{"text":"Yəhuda nəslindən dağlarıma varis çıxacaq,","poem":1},{"lineBreak":true},{"text":"Seçilmiş xalqım oranı irs alacaq.","poem":1},{"lineBreak":true},{"text":"Mənim qullarım orada məskunlaşacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məni axtaran xalqım üçün","poem":1},{"lineBreak":true},{"text":"Şaron sürülərin otlağı,","poem":1},{"lineBreak":true},{"text":"Akor vadisi mal-qaranın rahatlandığı yer olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakin sizlər – Rəbbi tərk edənlər,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağımı unudanlar,","poem":1},{"lineBreak":true},{"text":"Tale allahına süfrə açanlar,","poem":1},{"lineBreak":true},{"text":"Qismət allahına camlarda şərab təqdim edənlər,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mən də sizi qılınca qismət edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Hamınız qırılmaq üçün diz çökəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Çünki Mən çağıranda sizdən cavab almadım,","poem":1},{"lineBreak":true},{"text":"Danışanda qulaq asmadınız.","poem":1},{"lineBreak":true},{"text":"Gözümdə pis olanı etdiniz,","poem":1},{"lineBreak":true},{"text":"Mənə məqbul olmayanı seçdiniz».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Buna görə də Xudavənd Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Qullarım yeyəcək, sizsə ac qalacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qullarım içəcək, sizsə susayacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qullarım sevinəcək, sizsə utanacaqsınız.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qullarım şadlanıb mədhiyyələr söyləyəcək,","poem":1},{"lineBreak":true},{"text":"Sizsə ürək ağrısından qışqıracaqsınız,","poem":1},{"lineBreak":true},{"text":"Kədərli ruhla fəryad edəcəksiniz.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sizin adınız seçilmiş xalqımın","poem":1},{"lineBreak":true},{"text":"Ağzında ancaq lənət kimi qalacaq.","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb sizi öldürəcək,","poem":1},{"lineBreak":true},{"text":"Öz qullarına isə başqa ad verəcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ölkədə kim xeyir-dua istəsə,","poem":1},{"lineBreak":true},{"text":"Sadiq Allahdan diləyəcək.","poem":1},{"lineBreak":true},{"text":"Ölkədə kim and içsə,","poem":1},{"lineBreak":true},{"text":"Sadiq Allahın adı ilə and içəcək.","poem":1},{"lineBreak":true},{"text":"Çünki keçmiş əziyyətlər unudulub","poem":1},{"lineBreak":true},{"text":"Gözümün önündən yox olacaq.","poem":1}]},{"type":"heading","content":["Yeni yer, yeni göylər"]},{"type":"verse","number":17,"content":[{"text":"Budur, Mən yeni göylər və yeni yer yaradıram.","poem":1},{"lineBreak":true},{"text":"Əvvəlki işlər bir daha xatırlanmayacaq,","poem":1},{"lineBreak":true},{"text":"Heç yada düşməyəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaratdığımla əbədilik sevinin, şadlanın.","poem":1},{"lineBreak":true},{"text":"Çünki sevinc üçün yeni Yerusəlimi,","poem":1},{"lineBreak":true},{"text":"Sakinlərini xoşbəxtlik üçün yaradacağam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mən Yerusəlim üçün sevinəcəyəm,","poem":1},{"lineBreak":true},{"text":"Xalqım üçün şadlanacağam.","poem":1},{"lineBreak":true},{"text":"Orada nə ağlaşma, nə fəryad səsi","poem":1},{"lineBreak":true},{"text":"Bir daha eşidilməyəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Uşaqlar artıq körpə çağlarında ölməyəcək,","poem":1},{"lineBreak":true},{"text":"Uzun ömür sürməyən qoca olmayacaq,","poem":1},{"lineBreak":true},{"text":"Yüz yaşında ölənlər cavan sayılacaq,","poem":1},{"lineBreak":true},{"text":"Yüz yaşına çatmayanlar lənətli sayılacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onlar evlər tikib orada məskunlaşacaq,","poem":1},{"lineBreak":true},{"text":"Üzüm bağları salacaq, bəhrələrindən yeyəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tikdikləri evdə özgələr yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"Əkdikləri bağın meyvələrini başqaları yeməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki xalqım ağaclar tək uzun ömür sürəcək,","poem":1},{"lineBreak":true},{"text":"Seçilmişlərim əllərinin işlərindən zövq alacaq.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onlar boş yerə əlləşməyəcək,","poem":1},{"lineBreak":true},{"text":"Övladları bəlalarla üzləşməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki özləri də, övladları da,","poem":1},{"lineBreak":true},{"text":"Rəbbin xeyir-dualı nəsli olacaq.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onlar Məni çağırmamışdan","poem":1},{"lineBreak":true},{"text":"Mən onlara cavab verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar hələ danışarkən Mən eşidəcəyəm.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qurdla quzu bir yerdə otlayacaq,","poem":1},{"lineBreak":true},{"text":"Şir buğa tək saman yeyəcək,","poem":1},{"lineBreak":true},{"text":"İlanın yediyi torpaq olacaq.","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağımın heç bir yerində","poem":1},{"lineBreak":true},{"text":"Heç kimə zərər dəyməyəcək,","poem":1},{"lineBreak":true},{"text":"Heç bir kəs o birisini məhv etməyəcək».","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}