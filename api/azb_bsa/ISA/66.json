{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Mühakimə və ümid"]},{"type":"verse","number":1,"content":["Rəbb belə deyir:",{"text":"«Göylər Mənim taxtımdır,","poem":1},{"lineBreak":true},{"text":"Yer ayaqlarımın altındakı kətildir.","poem":1},{"lineBreak":true},{"text":"Mənim üçün harada ev tikəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Dincələcəyim yer harada olacaq?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki bütün bunları Mənim əlim yaratdı,","poem":1},{"lineBreak":true},{"text":"Hər şey beləcə əmələ gəldi» Rəbb bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Ancaq Mən özünü aşağı tutan və ruhu əzilmiş insana,","poem":1},{"lineBreak":true},{"text":"Sözümün önündə titrəyənə nəzər salaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Buğa kəsən şəxs adam öldürən kimidir,","poem":1},{"lineBreak":true},{"text":"Quzunu qurban verən şəxs itin boynunu qıran kimidir,","poem":1},{"lineBreak":true},{"text":"Taxıl təqdimi gətirən şəxs donuz qanını təqdim edən kimidir,","poem":1},{"lineBreak":true},{"text":"Kündür yandıraraq təqdim edən şəxs bütə pərəstiş edən kimidir.","poem":1},{"lineBreak":true},{"text":"Onlar öz yolları ilə gedir,","poem":1},{"lineBreak":true},{"text":"İyrənc işlərindən həzz alır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mən də onları çətinliyə düçar edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qorxduqları bəlanı başlarına gətirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki Mən çağıranda onlardan cavab almadım,","poem":1},{"lineBreak":true},{"text":"Danışanda qulaq asmadılar,","poem":1},{"lineBreak":true},{"text":"Gözümdə pis olanı etdilər,","poem":1},{"lineBreak":true},{"text":"Mənə məqbul olmayanı seçdilər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey Rəbbin sözü önündə titrəyənlər,","poem":1},{"lineBreak":true},{"text":"Onun dediklərini eşidin:","poem":1},{"lineBreak":true},{"text":"«Mənim adıma görə sizə nifrət edib təqib edən soydaşlarınız","poem":1},{"lineBreak":true},{"text":"“Qoy Rəbb izzətini göstərsin,","poem":1},{"lineBreak":true},{"text":"Biz də görək, necə sevinərsiniz” deyirdilər.","poem":1},{"lineBreak":true},{"text":"Amma onlar rüsvay olacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Şəhərdən nərələr,","poem":1},{"lineBreak":true},{"text":"Məbəddən bir səs eşidilir!","poem":1},{"lineBreak":true},{"text":"Bu, düşmənlərindən qisas alan Rəbbin səsidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bir qadın ağrı çəkmədən,","poem":1},{"lineBreak":true},{"text":"Sancısı tutmadan bir oğlan uşağı doğdu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Belə bir şey eşidən olubmu?","poem":1},{"lineBreak":true},{"text":"Belə şeyləri kim görüb?","poem":1},{"lineBreak":true},{"text":"Bir gündə ölkə yarana bilərmi?","poem":1},{"lineBreak":true},{"text":"Bir anda millət doğula bilərmi?","poem":1},{"lineBreak":true},{"text":"Sion isə ağrısı tutan kimi övladlarını doğdu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mən doğuş anınadək gətirib","poem":1},{"lineBreak":true},{"text":"Doğmağa güc vermərəmmi?» deyir Rəbb.","poem":1},{"lineBreak":true},{"text":"«Doğuş üçün güc verən Mən","poem":1},{"lineBreak":true},{"text":"Bətni bağlayarammı?» deyir Allahın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Yerusəlimlə birgə sevinin,","poem":1},{"lineBreak":true},{"text":"Ey onu sevənlər, hamınız onun üçün şadlanın.","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlim üçün yas tutanlar,","poem":1},{"lineBreak":true},{"text":"Onunla birgə cuşa gəlin, fərəhlənin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siz ananız Yerusəlimin döşlərini əmib","poem":1},{"lineBreak":true},{"text":"Təsəlli tapacaqsınız, doyacaqsınız,","poem":1},{"lineBreak":true},{"text":"Onun bol nemətlərindən dadıb zövq alacaqsınız».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Budur, Mən əmin-amanlığı bir çay tək,","poem":1},{"lineBreak":true},{"text":"Millətlərin sərvətini daşqın sel kimi","poem":1},{"lineBreak":true},{"text":"Ona sarı axıdacağam.","poem":1},{"lineBreak":true},{"text":"Siz ondan bəslənəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Qucağında daşınacaqsınız,","poem":1},{"lineBreak":true},{"text":"Dizlərində oxşanacaqsınız.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Övladına təsəlli verən bir ana tək","poem":1},{"lineBreak":true},{"text":"Mən sizə təsəlli verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə təsəlli tapacaqsınız.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bunları görüb ürəyiniz sevinəcək;","poem":1},{"lineBreak":true},{"text":"Bədənləriniz yaşıl ot kimi qüvvətlənəcək.","poem":1},{"lineBreak":true},{"text":"Hər kəs biləcək ki,","poem":1},{"lineBreak":true},{"text":"Rəbbin qoruyucu əli qullarının,","poem":1},{"lineBreak":true},{"text":"Qəzəbi isə düşmənlərinin üstündədir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Budur, Rəbb odla gəlir,","poem":1},{"lineBreak":true},{"text":"Onun döyüş arabaları qasırğa tək gəlir.","poem":1},{"lineBreak":true},{"text":"Şiddətli qəzəbini, məzəmmətini","poem":1},{"lineBreak":true},{"text":"Alov kimi tökməyə hazırdır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb bütün bəşəri odla,","poem":1},{"lineBreak":true},{"text":"Qılıncı ilə mühakimə edəcək,","poem":1},{"lineBreak":true},{"text":"Çoxlarını məhv edəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Bağlara girmək üçün","poem":1},{"lineBreak":true},{"text":"Özlərini təqdis edib pak edənlər,","poem":1},{"lineBreak":true},{"text":"Mərkəzdə duranın ardınca gedərək","poem":1},{"lineBreak":true},{"text":"Donuz, siçan və digər murdar heyvanların","poem":1},{"lineBreak":true},{"text":"Ətini yeyənlərin hamısı məhv olacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb bəyan edir.","poem":1}]},{"type":"verse","number":18,"content":["«Çünki Mən onların əməllərini də, fikirlərini də bilirəm. Bütün millətləri və dilləri bir yerə topladığım vaxt gəlir. Onlar gəlib Mənim əzəmətimi görəcək."]},{"type":"verse","number":19,"content":["Mən aralarında bir əlamət qoyacağam. Onlardan qaçıb-qurtulanları Mən millətlərə – Tarşişə, Pula, mahir oxatanların vətəni Luda, Tuvala, Yavana, şöhrətimi eşitməyən, əzəmətimi görməyən uzaq diyarlara göndərəcəyəm. Onlar Mənim əzəmətimi bu millətlər arasında bəyan edəcək."]},{"type":"verse","number":20,"content":["İsrail övladları Rəbbin məbədinə pak qablarda təqdimlərini necə gətirirlərsə, onlar da bütün millətlərdən soydaşlarını atlarla, arabalarla, taxt-rəvanlarla, qatırlarla, dəvələrlə müqəddəs dağıma, Yerusəlimə, Rəbbə elə təqdim edəcək."]},{"type":"verse","number":21,"content":["Onlardan bəzisini Mən kahin və Levili seçəcəyəm» Rəbb bəyan edir."]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Yaradacağım yeni göylər və yeni yer önümdə necə qalacaqsa,","poem":1},{"lineBreak":true},{"text":"Nəsliniz və adınız da elə qalacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb bəyan edir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"«Hər Təzə Ay mərasimində, hər Şənbə günündə","poem":1},{"lineBreak":true},{"text":"Bütün bəşər gəlib qarşımda səcdə edəcək».","poem":1},{"lineBreak":true},{"text":"Rəbb deyir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"«Onlar eşiyə çıxanda","poem":1},{"lineBreak":true},{"text":"Mənə qarşı üsyankar olanların meyitlərini görəcək.","poem":1},{"lineBreak":true},{"text":"Meyitləri yeyən qurd ölməyəcək,","poem":1},{"lineBreak":true},{"text":"Onları yandıran alov sönməyəcək.","poem":1},{"lineBreak":true},{"text":"Bütün bəşər onlardan iyrənəcək».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}