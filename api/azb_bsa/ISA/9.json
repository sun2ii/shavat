{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ISA","translationId":"azb_bsa","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA PEYĞƏMBƏRİN KİTABI","order":23,"numberOfChapters":66,"sha256":"4af85652779c5ed7e37e0c9c55fd74ac6d49e254b031a1e3df569ee9da434576","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/azb_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Sülh Hökmdarı"]},{"type":"verse","number":1,"content":["Lakin əzab çəkmiş xalq qaranlıqda qalmayacaq.",{"text":"Keçmişdə Rəbb Zevulun və Naftali bölgələrini alçaltdı,","poem":1},{"lineBreak":true},{"text":"Gələcəkdə isə dənizkənarı yolu,","poem":1},{"lineBreak":true},{"text":"İordan çayının o biri tayını,","poem":1},{"lineBreak":true},{"text":"Müxtəlif millətlər yaşayan Qalileyanı","poem":1},{"lineBreak":true},{"text":"Şərəfə çatdıracaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zülmətdə yaşayan xalq","poem":1},{"lineBreak":true},{"text":"Möhtəşəm bir işıq gördü.","poem":1},{"lineBreak":true},{"text":"Ölüm kölgəsi diyarında məskunlaşanların","poem":1},{"lineBreak":true},{"text":"Üzərinə nur doğdu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, milləti çoxaldıb sevinclərini artırdın,","poem":1},{"lineBreak":true},{"text":"Əkib-biçənlərin fərəhləndiyi,","poem":1},{"lineBreak":true},{"text":"Qənimət bölənlərin sevindiyi kimi","poem":1},{"lineBreak":true},{"text":"Onlar da Sənin hüzurunda sevindilər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki onlara yük olan boyunduruğunu,","poem":1},{"lineBreak":true},{"text":"Çiyinlərini döyən çomağını,","poem":1},{"lineBreak":true},{"text":"Onlara zülm edənlərin dəyənəyini çilik-çilik etmisən","poem":1},{"lineBreak":true},{"text":"Midyanlıların başlarına gətirdiyin gün kimi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Döyüşdə geyilən çəkmələri,","poem":1},{"lineBreak":true},{"text":"Qana bulanmış geyimləri yandırılacaq,","poem":1},{"lineBreak":true},{"text":"Oda yem olacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki bizim üçün körpə doğuldu,","poem":1},{"lineBreak":true},{"text":"Bizə oğul verildi,","poem":1},{"lineBreak":true},{"text":"Hakimiyyət onun çiyinləri üzərində olacaq,","poem":1},{"lineBreak":true},{"text":"Onun adı Ecazkar Məsləhətçi, Qüdrətli Allah,","poem":1},{"lineBreak":true},{"text":"Əbədi Ata, Sülh Hökmdarı olacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hakimiyyətinin və sülhünün artmasının sonu olmayacaq,","poem":1},{"lineBreak":true},{"text":"O, Davudun taxtı və padşahlığı üzərində hökm sürəcək,","poem":1},{"lineBreak":true},{"text":"O, hakimiyyətini ədalətlə və salehliklə indidən sonsuzadək quracaq.","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbinin qeyrəti bunu edəcək.","poem":1}]},{"type":"heading","content":["Rəbbin İsrailə qarşı qəzəbi"]},{"type":"verse","number":8,"content":[{"text":"İsrail üzərində həyata keçirilsin deyə","poem":1},{"lineBreak":true},{"text":"Rəbb Yaqub nəslinin əleyhinə xəbərdarlıq etdi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bütün xalq,","poem":1},{"lineBreak":true},{"text":"Efrayimin, Samariyanın sakinləri","poem":1},{"lineBreak":true},{"text":"Bunu biləcək.","poem":1},{"lineBreak":true},{"text":"Bu qürurlu, təkəbbürlü xalq belə deyir:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Kərpic evlərimiz yıxıldı,","poem":1},{"lineBreak":true},{"text":"Amma əvəzinə yonma daşdan evlər tikərik.","poem":1},{"lineBreak":true},{"text":"Firon ənciri ağacları kəsildi,","poem":1},{"lineBreak":true},{"text":"Amma biz onların əvəzinə sidr ağacları əkərik».","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buna görə Rəbb Resinin düşmənlərini gücləndirəcək,","poem":1},{"lineBreak":true},{"text":"Yağılarını dirçəldəcək,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aramlılar şərqdən,","poem":1},{"lineBreak":true},{"text":"Filiştlilər qərbdən","poem":1},{"lineBreak":true},{"text":"Ağızlarını açıb İsraili udacaq.","poem":1},{"lineBreak":true},{"text":"Bütün bunlara qarşı yenə də Rəbbin qəzəbi sönmədi,","poem":1},{"lineBreak":true},{"text":"Əli hələ də cəzalandırmağa hazır idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amma xalq onu cəzalandıran Rəbbə tərəf dönmədi,","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbini axtarmadı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Buna görə Rəbb İsraildən başı, quyruğu,","poem":1},{"lineBreak":true},{"text":"Xurma ağacının budağını, qarğını bir gündə kəsib atacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Baş – ağsaqqal və hörmətli şəxsdir,","poem":1},{"lineBreak":true},{"text":"Quyruq isə yalan təlim verən peyğəmbərdir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bu xalqa yol göstərənlər onları azdırır,","poem":1},{"lineBreak":true},{"text":"Onların ardınca gedənlər qırılır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Buna görə də Xudavənd","poem":1},{"lineBreak":true},{"text":"Onların cavanlarına görə sevinməyəcək,","poem":1},{"lineBreak":true},{"text":"Yetimlərin və dul qadınların halına yanmayacaq.","poem":1},{"lineBreak":true},{"text":"Çünki hamı allahsızdır,","poem":1},{"lineBreak":true},{"text":"Şər işlər görür,","poem":1},{"lineBreak":true},{"text":"Hamının ağzından axmaq kəlmələr çıxır.","poem":1},{"lineBreak":true},{"text":"Bütün bunlara qarşı yenə də Rəbbin qəzəbi sönmədi,","poem":1},{"lineBreak":true},{"text":"Əli hələ də cəzalandırmağa hazır idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ona görə pislik alovlanıb-yanır,","poem":1},{"lineBreak":true},{"text":"Tikanla qanqalı yandırıb-yaxır,","poem":1},{"lineBreak":true},{"text":"Meşədəki kolluqlar məhv olur,","poem":1},{"lineBreak":true},{"text":"Tüstü sütunları qalxır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ordular Rəbbinin qəzəbi","poem":1},{"lineBreak":true},{"text":"Ölkəni od kimi yandırdı,","poem":1},{"lineBreak":true},{"text":"Xalqı alov yandırıb-yaxır,","poem":1},{"lineBreak":true},{"text":"Qardaş qardaşa rəhm etmir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adamlar orada-burada tapdıqlarını yeyəcək,","poem":1},{"lineBreak":true},{"text":"Amma doymayıb ac qalacaq.","poem":1},{"lineBreak":true},{"text":"Hər kəs öz uşağının ətini yeyəcək.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Menaşşe Efrayimi yeyəcək,","poem":1},{"lineBreak":true},{"text":"Efrayim Menaşşeni.","poem":1},{"lineBreak":true},{"text":"Sonra birlikdə Yəhudaya hücum edəcəklər.","poem":1},{"lineBreak":true},{"text":"Bütün bunlara qarşı yenə də Rəbbin qəzəbi sönmədi,","poem":1},{"lineBreak":true},{"text":"Əli hələ də cəzalandırmağa hazır idi.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}