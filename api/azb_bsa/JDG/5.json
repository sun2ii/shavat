{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JDG","translationId":"azb_bsa","name":"HAKİMLƏR","commonName":"HAKİMLƏR","title":"HAKİMLƏR KİTABI","order":7,"numberOfChapters":21,"sha256":"6aeecb615567787792b9972a5b7d3ff556ba863687cdc8ce40c1858d7a24afc5","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/azb_bsa/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Devora ilə Baraqın ilahisi"]},{"type":"line_break"},{"type":"verse","number":1,"content":["Həmin gün Devora və Avinoam oğlu Baraq bu ilahini oxudular:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Başçılar İsraildə rəhbərlik edəndə,","poem":1},{"lineBreak":true},{"text":"Xalq özünü könüllü təqdim edəndə","poem":1},{"lineBreak":true},{"text":"Rəbbə alqış edin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dinləyin, ey padşahlar! Qulaq asın, əmirlər!","poem":1},{"lineBreak":true},{"text":"Mən Rəbbi tərənnüm edəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsrailin Allahı Rəbbə nəğmə söyləyəcəyəm!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, Sən Seirdən çıxarkən,","poem":1},{"lineBreak":true},{"text":"Edom çölündən keçərkən","poem":1},{"lineBreak":true},{"text":"Yer titrədi, göylər damdı.","poem":1},{"lineBreak":true},{"text":"Bəli, buludlardan sular axdı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sina dağına sahib olan Rəbbin qarşısında,","poem":1},{"lineBreak":true},{"text":"İsrailin Allahı Rəbbin qarşısında","poem":1},{"lineBreak":true},{"text":"Dağlar titrədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anat oğlu Şamqar zamanında,","poem":1},{"lineBreak":true},{"text":"Həm də Yael zamanında","poem":1},{"lineBreak":true},{"text":"Karvanlar buraya gəlişini kəsdi,","poem":1},{"lineBreak":true},{"text":"Səyyahlar dolanbac yollarla getdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən Devora ayağa qalxanadək,","poem":1},{"lineBreak":true},{"text":"İsraildə ana kimi meydana çıxanadək","poem":1},{"lineBreak":true},{"text":"İsraildə kəndlilər artıq yaşamırdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsraillilər yeni allahlar seçərkən","poem":1},{"lineBreak":true},{"text":"Döyüşlər darvazalardan keçdi.","poem":1},{"lineBreak":true},{"text":"O zaman qırx min İsraillinin əlində","poem":1},{"lineBreak":true},{"text":"Nə nizə, nə də ki qalxan göründü.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mənim könlüm İsrailə hökm edənlərlədir,","poem":1},{"lineBreak":true},{"text":"Xalq içində özünü könüllü təqdim edənlərlədir.","poem":1},{"lineBreak":true},{"text":"Rəbbə alqış edin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bu nəğməni söyləyin, ey ağappaq eşşəklərə minənlər,","poem":1},{"lineBreak":true},{"text":"Ey əlvan xalılar üstündə əyləşənlər,","poem":1},{"lineBreak":true},{"text":"Ey bütün yoldan keçənlər!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Oxatanların səs-küyündən uzaqda,","poem":1},{"lineBreak":true},{"text":"Su çəkənlər arasında –","poem":1},{"lineBreak":true},{"text":"Orada Rəbbin zəfərlərindən,","poem":1},{"lineBreak":true},{"text":"İsraildəki igidlərin zəfərlərindən nəql ediləcək.","poem":1},{"lineBreak":true},{"text":"O zaman Rəbbin xalqı darvazalara endi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oyan, ey Devora, oyan!","poem":1},{"lineBreak":true},{"text":"Oyan, ilahi oxu, oyan!","poem":1},{"lineBreak":true},{"text":"Ayağa qalx, ey Baraq!","poem":1},{"lineBreak":true},{"text":"Sən, ey Avinoam oğlu, gəl əsirlərini apar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O zaman sağ qalanlar əyanların yanına endi.","poem":1},{"lineBreak":true},{"text":"Rəbbin xalqı cəngavər tək yanıma endi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amaleq soyundan olanlar Efrayimdən gəldi,","poem":1},{"lineBreak":true},{"text":"Sənin ardınca gələn xalq arasında Binyamin də var idi.","poem":1},{"lineBreak":true},{"text":"Makirdən əmirlər,","poem":1},{"lineBreak":true},{"text":"Zevulundan sərkərdə əsasını daşıyanlar gəldilər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"İssakardakı ağalar Devora ilə gəldilər.","poem":1},{"lineBreak":true},{"text":"İssakar necədirsə, Baraq da elə idi,","poem":1},{"lineBreak":true},{"text":"Onun ardınca vadiyə hücum çəkirdilər.","poem":1},{"lineBreak":true},{"text":"Ruven qəbiləsinin bölmələri çaşıb qalmışdı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çobanların sürülərinə çaldığı tütək səsini dinləmək üçün","poem":1},{"lineBreak":true},{"text":"Niyə ağıllar arasında qaldınız?","poem":1},{"lineBreak":true},{"text":"Ruven qəbiləsinin bölmələri çaşıb qalmışdı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gilead xalqı İordan çayının o tayında qaldı.","poem":1},{"lineBreak":true},{"text":"Bəs niyə Dan gəmilərin yanında sakin oldu?","poem":1},{"lineBreak":true},{"text":"Aşer dənizlərin sahilində qaldı,","poem":1},{"lineBreak":true},{"text":"Öz limanlarında məskən saldı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Döyüş meydanının yüksək yerlərində, Zevulunla Naftali","poem":1},{"lineBreak":true},{"text":"Canlarını ölüm təhlükəsinə atan bir xalq oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O zaman padşahlar gəlib vuruşdular.","poem":1},{"lineBreak":true},{"text":"Taanakda, Megiddo suları kənarında","poem":1},{"lineBreak":true},{"text":"Kənan padşahları vuruşdular.","poem":1},{"lineBreak":true},{"text":"Nə gümüş, nə də qənimət alan oldu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ulduzlar göydən döyüşdü,","poem":1},{"lineBreak":true},{"text":"Sisraya qarşı öz dövrəsində döyüşdülər.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Düşmənləri Qişon çayı apardı,","poem":1},{"lineBreak":true},{"text":"Qişon çayı coşub-daşandı.","poem":1},{"lineBreak":true},{"text":"Ey canım, sən qüvvətlə irəli get!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"O zaman at dırnaqları vurdu o yerə damğalar,","poem":1},{"lineBreak":true},{"text":"Dördnala, dördnala qaçarkən köhlən atlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbbin mələyi dedi: «Meroza lənət edin,","poem":1},{"lineBreak":true},{"text":"Onun xalqına ağır lənət söyləyin.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin köməyinə,","poem":1},{"lineBreak":true},{"text":"Cəngavərlərə qarşı Rəbbin köməyinə gəlmədilər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Qenli Xeverin arvadı Yael","poem":1},{"lineBreak":true},{"text":"Qadınlar arasında hamıdan artıq xeyir-dua alsın,","poem":1},{"lineBreak":true},{"text":"Çadırda yaşayan qadınlardan daha bəxtiyar olsun!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Su istəyəndə Sisra","poem":1},{"lineBreak":true},{"text":"Yael ona süd verdi.","poem":1},{"lineBreak":true},{"text":"Ağalara layiq bir camda ayran verdi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sol əlinə payanı,","poem":1},{"lineBreak":true},{"text":"Sağ əlinə isə işçi toxmağını götürdü,","poem":1},{"lineBreak":true},{"text":"Onlarla Sisranı vurdu, başını əzdi.","poem":1},{"lineBreak":true},{"text":"Sındırıb gicgahlarını, deşib yerə keçirtdi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"O yıxılıb ayaqlar altına sərildi,","poem":1},{"lineBreak":true},{"text":"Yerə döşəndi,","poem":1},{"lineBreak":true},{"text":"O yıxılıb ayaqlar altına sərildi,","poem":1},{"lineBreak":true},{"text":"Yıxıldığı yerə sərilib öldü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sisranın anası məhəccər arxasından,","poem":1},{"lineBreak":true},{"text":"Pəncərədən nigaran-nigaran baxıb çığırdı:","poem":1},{"lineBreak":true},{"text":"«Nə üçün onun döyüş arabası bu qədər gecikir?","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarının səsi axı niyə ləngiyir?»","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Müdrik əsilzadə xanımlar ona cavab verirdi,","poem":1},{"lineBreak":true},{"text":"O da öz-özünə təkrar-təkrar deyirdi:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"«Bəlkə qənimət malını tapıb bölüşdürürlər,","poem":1},{"lineBreak":true},{"text":"Yəqin ki hər igidə bir-iki qız düşür.","poem":1},{"lineBreak":true},{"text":"Sisraya talan malından düşür əlvan geyimlər,","poem":1},{"lineBreak":true},{"text":"Bəli, talan malından naxışlı əlvan geyimlər.","poem":1},{"lineBreak":true},{"text":"Qarət etdiklərinin içindən tapıb bölüşdürdülər,","poem":1},{"lineBreak":true},{"text":"Talançıların boyunları üçün","poem":1},{"lineBreak":true},{"text":"İki tərəfdən əlvan naxışlı geyimlər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ya Rəbb, bütün düşmənlərin belə yox olur.","poem":1},{"lineBreak":true},{"text":"Amma səni sevənlər qüdrəti ilə doğan günəş kimi olur!","poem":1},{"lineBreak":true},"Bundan sonra ölkə qırx il rahat yaşadı."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}