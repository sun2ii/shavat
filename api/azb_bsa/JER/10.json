{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Allaha ibadət və bütlərə pərəstiş"]},{"type":"verse","number":1,"content":["Rəbbin sizə söylədiyi sözü eşidin, ey İsrail nəsli!"]},{"type":"verse","number":2,"content":["Rəbb belə deyir:",{"text":"«Başqa millətlərin yolu ilə getməyin,","poem":1},{"lineBreak":true},{"text":"Göy əlamətlərindən qorxmayın,","poem":1},{"lineBreak":true},{"text":"Bunlardan başqa millətlər qorxur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki xalqların adətləri boş şeydir.","poem":1},{"lineBreak":true},{"text":"Meşədə ağac kəsirlər,","poem":1},{"lineBreak":true},{"text":"Usta əli kəski ilə onu düzəldir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sonra qızıl-gümüşlə bəzəyirlər,","poem":1},{"lineBreak":true},{"text":"Çəkiclə, mıxla bərkidirlər ki,","poem":1},{"lineBreak":true},{"text":"Yerindən tərpənməsin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bütləri xiyar bostanındakı müqəvva kimi","poem":1},{"lineBreak":true},{"text":"Danışa bilmir.","poem":1},{"lineBreak":true},{"text":"Onları daşımaq lazımdır,","poem":1},{"lineBreak":true},{"text":"Çünki gedə bilmirlər.","poem":1},{"lineBreak":true},{"text":"Onlardan qorxmayın,","poem":1},{"lineBreak":true},{"text":"Çünki nə pislik edə bilərlər,","poem":1},{"lineBreak":true},{"text":"Nə də yaxşılıq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sənin kimi Allah yoxdur, ya Rəbb.","poem":1},{"lineBreak":true},{"text":"Sən böyüksən, əzəmətdə adın ucadır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey millətlərin Padşahı,","poem":1},{"lineBreak":true},{"text":"Sənə kim hörmət etməz?","poem":1},{"lineBreak":true},{"text":"Sənə hörmət yaraşır,","poem":1},{"lineBreak":true},{"text":"Çünki millətlərin bütün müdrikləri arasında,","poem":1},{"lineBreak":true},{"text":"Bütün ölkələrində Sənin kimisi yoxdur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütlərə səcdə edənlərin hamısı","poem":1},{"lineBreak":true},{"text":"Ağılsız və axmaqdır,","poem":1},{"lineBreak":true},{"text":"Boş şeylərdən təlim alırlar.","poem":1},{"lineBreak":true},{"text":"Büt bir ağacdır!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tarşişdən döyülmüş gümüş,","poem":1},{"lineBreak":true},{"text":"Ufazdan qızıl gətirilir.","poem":1},{"lineBreak":true},{"text":"Ustanın və zərgərin əli ilə düzəldilən bütə","poem":1},{"lineBreak":true},{"text":"Bənövşəyi və tunc qırmızı paltar geyindirilir.","poem":1},{"lineBreak":true},{"text":"Hamısı bacarıqlı toxucu işidir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ancaq Rəbb həqiqi Allahdır.","poem":1},{"lineBreak":true},{"text":"Var olan Allahdır,","poem":1},{"lineBreak":true},{"text":"Əbədi Padşah Odur.","poem":1},{"lineBreak":true},{"text":"Qəzəbindən dünya titrəyər,","poem":1},{"lineBreak":true},{"text":"Hiddətinin qarşısında","poem":1},{"lineBreak":true},{"text":"Millətlər dura bilməz.","poem":1}]},{"type":"verse","number":11,"content":["Allah mənə dedi ki, onlara belə söylə: «Yeri və göyü yaratmayan allahlar yer üzündən və göyün altından yox olacaq».",{"noteId":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rəbb qüdrəti ilə yer üzünü yaratdı,","poem":1},{"lineBreak":true},{"text":"Hikməti ilə dünyanı qurdu,","poem":1},{"lineBreak":true},{"text":"Dərrakəsi ilə göyləri yaydı.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O gurlayanda göylərdəki sular çağlayır,","poem":1},{"lineBreak":true},{"text":"Yerin ucqarlarından buludları yüksəldir,","poem":1},{"lineBreak":true},{"text":"Yağış üçün şimşək çaxdırır,","poem":1},{"lineBreak":true},{"text":"Anbarlarından külək çıxarır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hər kəs ağılsız oldu,","poem":1},{"lineBreak":true},{"text":"Bilikləri qalmadı.","poem":1},{"lineBreak":true},{"text":"Hər zərgər düzəltdiyi bütdən utanacaq,","poem":1},{"lineBreak":true},{"text":"Çünki onun tökdüyü büt puçdur,","poem":1},{"lineBreak":true},{"text":"Onda nəfəs yoxdur.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onlar boş şey,","poem":1},{"lineBreak":true},{"text":"Masqaraçıların işidir.","poem":1},{"lineBreak":true},{"text":"Cəza vaxtı məhv olacaqlar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaquba Nəsib Olan isə onlara bənzəməz,","poem":1},{"lineBreak":true},{"text":"Çünki hər şeyi yaradan Odur.","poem":1},{"lineBreak":true},{"text":"İsrail Onun irs qəbiləsidir,","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ey sən mühasirəyə alınan şəhərdə yaşayan,","poem":1},{"lineBreak":true},{"text":"Şələ-küləni yerdən yığışdır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən bu dəfə ölkənin sakinlərini","poem":1},{"lineBreak":true},{"text":"Sapandla kənara atacağam.","poem":1},{"lineBreak":true},{"text":"Onları dara salacağam ki,","poem":1},{"lineBreak":true},{"text":"Düşmən əlinə keçsinlər».","poem":1}]},{"type":"heading","content":["Yeremyanın duası"]},{"type":"verse","number":19,"content":[{"text":"Əzabıma görə vay halıma!","poem":1},{"lineBreak":true},{"text":"Yaram sağalmaz.","poem":1},{"lineBreak":true},{"text":"Ancaq mən dedim:","poem":1},{"lineBreak":true},{"text":"«Həqiqətən, bu mənim dərdimdir,","poem":1},{"lineBreak":true},{"text":"Mən də ona dözməliyəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Çadırım yıxıldı,","poem":1},{"lineBreak":true},{"text":"Bütün iplərim qopdu.","poem":1},{"lineBreak":true},{"text":"Uşaqlarım məni tərk etdi,","poem":1},{"lineBreak":true},{"text":"Onlar artıq yoxdur.","poem":1},{"lineBreak":true},{"text":"Çadırımı quran, pərdələrimi asan qalmadı.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki xalqın çobanları ağılsız oldu,","poem":1},{"lineBreak":true},{"text":"Rəbdən soruşmadılar.","poem":1},{"lineBreak":true},{"text":"Buna görə də uğur qazanmadılar,","poem":1},{"lineBreak":true},{"text":"Bütün sürüləri dağıldı.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dinləyin, bir xəbər yayılır:","poem":1},{"lineBreak":true},{"text":"Şimal ölkəsindən böyük gurultu gəlir ki,","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərini xarabalığa,","poem":1},{"lineBreak":true},{"text":"Çaqqal yuvasına çevirsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ya Rəbb, bilirəm ki,","poem":1},{"lineBreak":true},{"text":"İnsanın ömrü öz əlində deyil.","poem":1},{"lineBreak":true},{"text":"Addımlarını düzəltmək","poem":1},{"lineBreak":true},{"text":"Gedən adamın işi deyil.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mənə cəza ver, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Ancaq qəzəbinlə yox, ədalətinlə.","poem":1},{"lineBreak":true},{"text":"Yoxsa məni heçə çıxardarsan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qəzəbini Səni tanımayan millətlərin,","poem":1},{"lineBreak":true},{"text":"Adını çağırmayan tayfaların üzərinə tök.","poem":1},{"lineBreak":true},{"text":"Çünki onlar Yaqub nəslini yedi,","poem":1},{"lineBreak":true},{"text":"Onu yeyib-qurtardı,","poem":1},{"lineBreak":true},{"text":"Yurdunu viran etdi».","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Bu ayə arami dilində yazılmışdır.","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/azb_bsa/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}