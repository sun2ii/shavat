{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Yeremyanın Allahla söhbəti"]},{"type":"verse","number":1,"content":[{"text":"Əgər Səninlə mübahisə etsəm,","poem":1},{"lineBreak":true},{"text":"Sən haqlı çıxarsan, ya Rəbb.","poem":1},{"lineBreak":true},{"text":"Ancaq yenə də ədalət barədə","poem":1},{"lineBreak":true},{"text":"Səninlə danışmaq istəyirəm.","poem":1},{"lineBreak":true},{"text":"Nə üçün pis adamlar əməllərində","poem":1},{"lineBreak":true},{"text":"Uğur qazanır,","poem":1},{"lineBreak":true},{"text":"Bütün xainlər dinc yaşayır?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onları Sən əkdin, kök saldılar,","poem":1},{"lineBreak":true},{"text":"Qol-budaq atdılar,","poem":1},{"lineBreak":true},{"text":"Bar verdilər.","poem":1},{"lineBreak":true},{"text":"Sən onların dillərinə yaxınsan,","poem":1},{"lineBreak":true},{"text":"Amma ürəklərindən uzaqsan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Məni isə, ya Rəbb, Sən tanıyırsan,","poem":1},{"lineBreak":true},{"text":"Görürsən və sınayırsan.","poem":1},{"lineBreak":true},{"text":"Ürəyim Səninlədir.","poem":1},{"lineBreak":true},{"text":"Onları qurbanlıq qoyun kimi ayır,","poem":1},{"lineBreak":true},{"text":"Qırğın günü üçün hazırla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nə vaxta qədər torpaq yas tutacaq,","poem":1},{"lineBreak":true},{"text":"Bütün çöl otları quruyacaq?","poem":1},{"lineBreak":true},{"text":"Orada yaşayanların pisliyi üzündən","poem":1},{"lineBreak":true},{"text":"Heyvanlar və otlar məhv oldu.","poem":1},{"lineBreak":true},{"text":"Onlar isə «bu adam aqibətimizi görməyəcək» deyir.","poem":1}]},{"type":"heading","content":["Allahın cavabı"]},{"type":"verse","number":5,"content":[{"text":"«Ey Yeremya, əgər sən piyadalarla qaçanda yoruldunsa,","poem":1},{"lineBreak":true},{"text":"Atlarla necə yarışa bilərsən?","poem":1},{"lineBreak":true},{"text":"Əgər əmin-amanlıq olan torpaqda büdrəsən,","poem":1},{"lineBreak":true},{"text":"İordan çayının kənarındakı sıx meşədə nə edəcəksən?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hətta öz qardaşların – ata evin də","poem":1},{"lineBreak":true},{"text":"Sənə xəyanət etdi,","poem":1},{"lineBreak":true},{"text":"Onlar da sənin ardınca","poem":1},{"lineBreak":true},{"text":"Ucadan bağırdı.","poem":1},{"lineBreak":true},{"text":"Sənə yaxşı sözlər söyləsələr də,","poem":1},{"lineBreak":true},{"text":"Onlara inanma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Evimi tərk etdim,","poem":1},{"lineBreak":true},{"text":"İrsimi əldən verdim,","poem":1},{"lineBreak":true},{"text":"Sevgilimi düşmənlərə təslim etdim.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İrsim Mənim üçün","poem":1},{"lineBreak":true},{"text":"Meşədəki aslan kimi oldu.","poem":1},{"lineBreak":true},{"text":"Üstümə nərə çəkdi,","poem":1},{"lineBreak":true},{"text":"Buna görə də ona nifrət etdim.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İrsim Mənim üçün","poem":1},{"lineBreak":true},{"text":"Alabəzək yırtıcı quş oldumu?","poem":1},{"lineBreak":true},{"text":"Hər tərəfdən yırtıcı quşlar","poem":1},{"lineBreak":true},{"text":"Onun üstünə töküldü.","poem":1},{"lineBreak":true},{"text":"Gedin bütün vəhşi heyvanları toplayın,","poem":1},{"lineBreak":true},{"text":"Yeyib-qurtarmaq üçün onun üstünə gətirin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çoxlu çoban bağımı viran etdi,","poem":1},{"lineBreak":true},{"text":"Tarlamı tapdalayıb əzdi,","poem":1},{"lineBreak":true},{"text":"Gözəl zəmimi boş çölə çevirdi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onu xaraba qoydular,","poem":1},{"lineBreak":true},{"text":"Xarabalıq içində önümdə ağlayır.","poem":1},{"lineBreak":true},{"text":"Bütün ölkə viran oldu,","poem":1},{"lineBreak":true},{"text":"Amma heç kəsin vecinə deyil.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çöldəki bütün çılpaq təpələrə məhv edənlər gəldi.","poem":1},{"lineBreak":true},{"text":"Çünki ölkənin bir ucundan o biri ucuna qədər","poem":1},{"lineBreak":true},{"text":"Rəbbin qılıncı qırıb-çatır.","poem":1},{"lineBreak":true},{"text":"Heç kim salamat qalmır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onlar buğda əkdi, qanqal biçdi.","poem":1},{"lineBreak":true},{"text":"Zəhmət çəkdilər, xeyir görmədilər.","poem":1},{"lineBreak":true},{"text":"Rəbbin qızğın qəzəbindən ötrü","poem":1},{"lineBreak":true},{"text":"Məhsullarınızdan utanacaqsınız».","poem":1}]},{"type":"verse","number":14,"content":["Rəbb belə deyir: «Xalqım İsrailə irs olaraq verdiyim mülkə toxunan bütün bədxah qonşularıma gəlincə, Mən onları torpaqlarından çıxarıb atacağam, onların arasından Yəhuda nəslini də çıxarıb atacağam."]},{"type":"verse","number":15,"content":["Amma onları çıxarıb atdıqdan sonra yenə hallarına acıyacağam. Hər kəsi öz mülkünə, öz torpağına qaytaracağam."]},{"type":"verse","number":16,"content":["Əgər onlar xalqımın yolunu yaxşı öyrənsələr, xalqımı Baal adı ilə and içməyi öyrətdikləri kimi “var olan Rəbbə and olsun” deyib Mənim adımla and içsələr, o zaman xalqımın arasında sakin olacaqlar."]},{"type":"verse","number":17,"content":["Ancaq qulaq asmasalar, o zaman belə bir milləti mütləq kökündən çıxarıb yox edəcəyəm» Rəbb belə bəyan edir."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}