{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"heading","content":["Kətan qurşaqla müqayisə"]},{"type":"verse","number":1,"content":["Rəbb mənə belə dedi: «Get özünə bir kətan qurşaq al və belinə bağla, amma onu suya qoyma»."]},{"type":"verse","number":2,"content":["Mən Rəbbin sözünə görə qurşaq aldım və belimə bağladım."]},{"type":"verse","number":3,"content":["Mənə yenə Rəbbin sözü nazil oldu:"]},{"type":"verse","number":4,"content":["«Belindəki aldığın qurşağı götürüb qalx və Fərat çayına tərəf get. Onu orada qayanın oyuğunda gizlət»."]},{"type":"verse","number":5,"content":["Mən gedib Rəbbin əmr etdiyi kimi onu Fərat çayının yaxınlığında gizlətdim."]},{"type":"verse","number":6,"content":["Uzun müddət sonra Rəbb mənə dedi: «Qalx Fərat çayına tərəf get və sənə gizlətməyi əmr etdiyim qurşağı oradan götür»."]},{"type":"verse","number":7,"content":["Mən Fərat çayına tərəf getdim və qurşağı gizlətdiyim yerdən qazıb götürdüm. Gördüm ki, qurşaq çürüyüb və daha heç nəyə yaramır."]},{"type":"verse","number":8,"content":["O zaman mənə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":9,"content":["«Rəbb belə deyir: “Yəhudanın təkəbbürünü və Yerusəlimin böyük qürurunu beləcə çürüdəcəyəm."]},{"type":"verse","number":10,"content":["Sözlərimə qulaq asmayan, inadkarlıqla ürəklərinin istədiyinə uyan, başqa allahlara qulluq və səcdə edərək onların tərəfdarı olan bu pis xalq heç bir şeyə yaramayan həmin qurşaq kimi olacaq”."]},{"type":"verse","number":11,"content":["Rəbb deyir: “Qurşaq insanın belinə necə yapışırsa, bütün İsrail nəslini və Yəhuda nəslini Özümə eləcə yapışdırdım ki, Öz xalqım olub Mənə şöhrət, tərif və izzət gətirsinlər, ancaq onlar qulaq asmadı”."]},{"type":"verse","number":12,"content":["Buna görə onlara bu sözü çatdır ki, İsrailin Allahı Rəbb belə deyir: “Hər tuluq şərabla dolacaq”. Onda sənə deyəcəklər: “Hər tuluğun şərabla dolacağını biz də bilmirikmi?”"]},{"type":"verse","number":13,"content":["O zaman onlara söylə ki, Rəbb belə deyir: “Bütün bu ölkədə yaşayanları, Davudun taxtı üzərində oturan padşahları, kahinləri, peyğəmbərləri, bütün Yerusəlimdə yaşayanları sərxoş olana qədər şərabla doyduracağam”."]},{"type":"verse","number":14,"content":["Rəbb bəyan edir: “Mən onları ata və oğulları ilə birlikdə bir-birlərinə çırpacağam. Onlara rəhm etməyəcək, aman verməyəcək, həlak etməyə heyfsilənməyəcəyəm”»."]},{"type":"heading","content":["Əsarət barədə xəbərdarlıq"]},{"type":"verse","number":15,"content":[{"text":"Eşidin və qulaq asın,","poem":1},{"lineBreak":true},{"text":"Qürurlu olmayın,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb belə söylədi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nə qədər ki qaranlıq çökdürməyib,","poem":1},{"lineBreak":true},{"text":"Zülmət dağlarında ayaqlarınız büdrəməyib,","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbi izzətləndirin.","poem":1},{"lineBreak":true},{"text":"Siz işıq gözləyirsiniz,","poem":1},{"lineBreak":true},{"text":"Amma Rəbb onu ölüm kölgəsinə çevirər,","poem":1},{"lineBreak":true},{"text":"Dərin zülmətə döndərər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ancaq siz ona qulaq asmasanız,","poem":1},{"lineBreak":true},{"text":"Gözlərim acı-acı yaş tökəcək,","poem":1},{"lineBreak":true},{"text":"Göz yaşları sel kimi axacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin sürüsünü","poem":1},{"lineBreak":true},{"text":"Sürgün etdilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Padşaha və onun anasına söylə:","poem":1},{"lineBreak":true},{"text":"«Taxtınızdan enin,","poem":1},{"lineBreak":true},{"text":"Çünki şərəf tacınız başınızdan düşdü».","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Negev şəhərlərinin darvazaları bağlandı,","poem":1},{"lineBreak":true},{"text":"Açan yoxdur.","poem":1},{"lineBreak":true},{"text":"Bütün Yəhuda sürgün edildi,","poem":1},{"lineBreak":true},{"text":"Hamı sürgün edildi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Başınızı qaldırıb","poem":1},{"lineBreak":true},{"text":"Şimaldan gələnləri görün.","poem":1},{"lineBreak":true},{"text":"Sənə verilən sürü,","poem":1},{"lineBreak":true},{"text":"Sənin gözəl sürün haradadır?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbb müttəfiq kimi hazırladığın adamları","poem":1},{"lineBreak":true},{"text":"Sənə hakim qoyanda nə deyəcəksən?","poem":1},{"lineBreak":true},{"text":"Məgər doğan qadının çəkdiyi sancı kimi","poem":1},{"lineBreak":true},{"text":"Səni də ağrı tutmayacaqmı?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Əgər ürəyində","poem":1},{"lineBreak":true},{"text":"«Bütün bunlar nə üçün başıma gəldi» desən,","poem":1},{"lineBreak":true},{"text":"Bil ki, günahının çoxluğundan","poem":1},{"lineBreak":true},{"text":"Ətəklərin qaldırıldı və zorlandın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kuşlu öz dərisini,","poem":1},{"lineBreak":true},{"text":"Bəbir öz xallarını dəyişdirə bilərmi?","poem":1},{"lineBreak":true},{"text":"Pislik etməyə alışmış","poem":1},{"lineBreak":true},{"text":"Siz də yaxşılıq edə bilməzsiniz.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"«Bundan ötrü səni çöl küləyi ilə","poem":1},{"lineBreak":true},{"text":"Sovrulan saman çöpü kimi səpələyəcəyəm.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sənə düşən püşk,","poem":1},{"lineBreak":true},{"text":"Mənim sənə ayırdığım pay budur»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Çünki Məni unutdun,","poem":1},{"lineBreak":true},{"text":"Yalana güvəndin.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bundan ötrü Mən də sənin ətəklərini","poem":1},{"lineBreak":true},{"text":"Üzünə qaldıracağam ki,","poem":1},{"lineBreak":true},{"text":"Ayıbın görünsün.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Çöldəki təpələr üzərində","poem":1},{"lineBreak":true},{"text":"Gördüyün iyrənc işləri,","poem":1},{"lineBreak":true},{"text":"Zinakarlığını, şəhvətlə kişnəməyini,","poem":1},{"lineBreak":true},{"text":"Həyasız əxlaqsızlığını gördüm.","poem":1},{"lineBreak":true},{"text":"Vay halına, ey Yerusəlim!","poem":1},{"lineBreak":true},{"text":"Sən nə vaxta qədər","poem":1},{"lineBreak":true},{"text":"Təmizlənə bilməyəcəksən?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}