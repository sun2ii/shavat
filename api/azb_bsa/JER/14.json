{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Qılınc, aclıq, vəba"]},{"type":"verse","number":1,"content":[{"text":"Bu, quraqlıq haqqında Yeremyaya nazil olan Rəbbin sözüdür.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Yəhuda yas tutur,","poem":1},{"lineBreak":true},{"text":"Onun şəhər darvazaları qəmli görünür.","poem":1},{"lineBreak":true},{"text":"Adamlar qara geyinmişlər,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin fəryadı ucalmışdır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əyanlar nökərlərini su dalınca göndərir,","poem":1},{"lineBreak":true},{"text":"Onlar isə quyu yanına gəlib","poem":1},{"lineBreak":true},{"text":"Su tapmır,","poem":1},{"lineBreak":true},{"text":"Boş qablarla geri dönürlər,","poem":1},{"lineBreak":true},{"text":"Utanıb xəcalət çəkərək","poem":1},{"lineBreak":true},{"text":"Başlarını örtürlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ölkədə yağış olmadığı üçün","poem":1},{"lineBreak":true},{"text":"Torpaq cadar-cadar oldu.","poem":1},{"lineBreak":true},{"text":"Əkinçilər utanır,","poem":1},{"lineBreak":true},{"text":"Başlarını örtür.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hətta çöldəki maral da","poem":1},{"lineBreak":true},{"text":"Balasını doğub tərk edir,","poem":1},{"lineBreak":true},{"text":"Çünki ot yoxdur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vəhşi eşşəklər çılpaq təpələrdə durub,","poem":1},{"lineBreak":true},{"text":"Çaqqal kimi tez-tez nəfəs alır.","poem":1},{"lineBreak":true},{"text":"Onların gözləri korlaşır,","poem":1},{"lineBreak":true},{"text":"Çünki otlaq yoxdur».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ya Rəbb, hərçənd təqsirlərimiz","poem":1},{"lineBreak":true},{"text":"Bizə qarşı şəhadət edir,","poem":1},{"lineBreak":true},{"text":"Sən Öz adından ötrü səy göstər.","poem":1},{"lineBreak":true},{"text":"Çünki dəfələrlə dönüklük etmiş,","poem":1},{"lineBreak":true},{"text":"Sənə qarşı günah etmişik.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey İsrailin Ümidgahı,","poem":1},{"lineBreak":true},{"text":"Məşəqqət zamanı Xilaskarı!","poem":1},{"lineBreak":true},{"text":"Nə üçün Sən bu torpaqda bir qərib,","poem":1},{"lineBreak":true},{"text":"Gecələmək üçün yoldan ayrılan bir səyyah kimisən?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nə üçün çaşmış adam,","poem":1},{"lineBreak":true},{"text":"Qurtarmağa gücü çatmayan","poem":1},{"lineBreak":true},{"text":"İgid kimi olmusan?","poem":1},{"lineBreak":true},{"text":"Ancaq Sən aramızdasan, ya Rəbb.","poem":1},{"lineBreak":true},{"text":"Biz Sənə məxsusuq,","poem":1},{"lineBreak":true},{"text":"Bizi tərk etmə.","poem":1}]},{"type":"verse","number":10,"content":["Rəbb bu xalq barədə belə deyir: «Onlar gəzib-dolaşmağı o qədər sevir ki, ayaq saxlamırlar. Buna görə də Rəbb onlardan razı deyil. İndi onların təqsirkarlığını yada salacaq, günahları üçün cəza verəcək»."]},{"type":"verse","number":11,"content":["Rəbb mənə dedi: «Sən bu xalqın uğur qazanması üçün dua etmə."]},{"type":"verse","number":12,"content":["Oruc tutsalar da, Mən onların fəryadını eşitməyəcəyəm. Yandırma qurbanı və taxıl təqdimi gətirdikləri zaman onlardan razı olmayacağam. Mən onları qılınc, aclıq və vəba ilə qırıb-çatacağam»."]},{"type":"verse","number":13,"content":["Mən dedim: «Ah, Xudavənd Rəbb, peyğəmbərlər onlara belə deyir: “Qılınc görməyəcəksiniz, aclıq olmayacaq. Ancaq Mən bu yerdə sizə həqiqi sülh verəcəyəm”»."]},{"type":"verse","number":14,"content":["Rəbb mənə dedi: «Peyğəmbərlər Mənim adımla yalançı peyğəmbərlik edir. Onları Mən göndərməmişəm, onlara əmr edib söz deməmişəm. Sizə peyğəmbərlik etdikləri şeylər yalan bir görüntü, falçılıq, boş bir şey, öz ürəklərinin uydurmasıdır."]},{"type":"verse","number":15,"content":["Buna görə də Rəbb o peyğəmbərlər barədə belə deyir: “Onları göndərmədiyim halda Mənim adımla peyğəmbərlik edən, ‹bu torpaqda qılınc və aclıq olmayacaq› deyən bu peyğəmbərlər özləri qılınc və aclıqdan həlak olacaq."]},{"type":"verse","number":16,"content":["Peyğəmbərlik etdikləri xalq da qılınc və aclıq üzündən Yerusəlim küçələrinə atılacaq. Onların özlərini, arvadlarını, oğullarını və qızlarını basdıran olmayacaq, çünki onların pisliklərini öz başlarına gətirəcəyəm”."]},{"type":"verse","number":17,"content":[{"text":"Onlara bu sözü söylə:","poem":1},{"lineBreak":true},{"text":"“Qoy gözlərim gecə-gündüz","poem":1},{"lineBreak":true},{"text":"Dayanmadan yaş töksün.","poem":1},{"lineBreak":true},{"text":"Çünki bakirə qıza bənzəyən əziz xalqım","poem":1},{"lineBreak":true},{"text":"Ağır bir yara aldı,","poem":1},{"lineBreak":true},{"text":"Şiddətli bir zərbə yedi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çölə çıxıram,","poem":1},{"lineBreak":true},{"text":"Qılıncla öldürülənləri görürəm,","poem":1},{"lineBreak":true},{"text":"Şəhərə girirəm,","poem":1},{"lineBreak":true},{"text":"Aclıqdan üzülənləri görürəm.","poem":1},{"lineBreak":true},{"text":"Çünki peyğəmbər də, kahin də","poem":1},{"lineBreak":true},{"text":"Bixəbər olaraq ölkəni dolaşır”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Məgər Sən Yəhudanı birdəfəlik rədd etmisən?","poem":1},{"lineBreak":true},{"text":"Məgər Siona nifrət edirsən?","poem":1},{"lineBreak":true},{"text":"Niyə bizi elə vurdun ki,","poem":1},{"lineBreak":true},{"text":"Sağaltmaq mümkün olmasın?","poem":1},{"lineBreak":true},{"text":"Sülh gözlədik, amma xeyir gəlmədi.","poem":1},{"lineBreak":true},{"text":"Şəfa vaxtını gözlədik,","poem":1},{"lineBreak":true},{"text":"Ancaq dəhşət gəlir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ya Rəbb, pisliyimizi,","poem":1},{"lineBreak":true},{"text":"Atalarımızın təqsirkarlığını bilirik.","poem":1},{"lineBreak":true},{"text":"Çünki Sənə qarşı günah etdik.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Öz adın naminə bizdən imtina etmə,","poem":1},{"lineBreak":true},{"text":"Öz izzətli taxtını alçaltma.","poem":1},{"lineBreak":true},{"text":"Bizimlə olan əhdini pozma, yada sal.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Millətlərin bütləri arasında","poem":1},{"lineBreak":true},{"text":"Yağış yağdıra biləni varmı?","poem":1},{"lineBreak":true},{"text":"Göylər leysan tökə bilərmi?","poem":1},{"lineBreak":true},{"text":"Bunu edən Sən deyilsənmi, ya Rəbb Allahımız?","poem":1},{"lineBreak":true},{"text":"Ümidimiz Sənədir.","poem":1},{"lineBreak":true},{"text":"Çünki bütün bu şeyləri Sən etdin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}