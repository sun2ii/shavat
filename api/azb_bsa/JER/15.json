{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"heading","content":["Yəhuda xalqının məhvi"]},{"type":"verse","number":1,"content":["Rəbb mənə dedi: «Musa ilə Şamuel önümdə dursalar da, yenə ürəyim bu xalqa tərəf yönəlməz. Onları qarşımdan rədd et ki, getsinlər."]},{"type":"verse","number":2,"content":["Sənə “Hara gedək?” dedikləri zaman onlara söylə ki, Rəbb belə deyir:",{"text":"“Vəba üçün ayrılanlar vəbaya,","poem":1},{"lineBreak":true},{"text":"Qılınc üçün ayrılanlar qılınca,","poem":1},{"lineBreak":true},{"text":"Aclıq üçün ayrılanlar aclığa,","poem":1},{"lineBreak":true},{"text":"Sürgün üçün ayrılanlar sürgünə”.","poem":1}]},{"type":"verse","number":3,"content":["Rəbb bəyan edir: “Onların başına dörd növ bəla gətirəcəyəm: öldürmək üçün qılıncı, parçalamaq üçün itləri, yeyib həlak etmək üçün göydəki quşları və yerdəki heyvanları."]},{"type":"verse","number":4,"content":["Yəhuda padşahı Xizqiya oğlu Menaşşeyə, onun Yerusəlimdə etdiyi işlərə görə onları yer üzünün bütün ölkələrinin qarşısında dəhşətli hala salacağam”."]},{"type":"verse","number":5,"content":[{"text":"Ey Yerusəlim, bəs sənə kim acıyacaq?","poem":1},{"lineBreak":true},{"text":"Sənin üçün kim yas tutacaq?","poem":1},{"lineBreak":true},{"text":"Halını soruşmaq üçün","poem":1},{"lineBreak":true},{"text":"Kim yolundan dönüb sənin yanına gələcək?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: “Sən Məni rədd etdin,","poem":1},{"lineBreak":true},{"text":"Geri çəkildin.","poem":1},{"lineBreak":true},{"text":"Mən də əlimi uzadıb səni məhv edirəm.","poem":1},{"lineBreak":true},{"text":"Daha bağışlamaqdan yoruldum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onları ölkənin şəhər darvazalarında","poem":1},{"lineBreak":true},{"text":"Kürəklə sovurdum,","poem":1},{"lineBreak":true},{"text":"Xalqımı övladsız qoydum,","poem":1},{"lineBreak":true},{"text":"Onları məhv etdim.","poem":1},{"lineBreak":true},{"text":"Çünki yollarından dönmədilər.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mənim önümdə onların dul qadınlarının sayı","poem":1},{"lineBreak":true},{"text":"Dəniz qumundan da çox oldu.","poem":1},{"lineBreak":true},{"text":"Günorta çağı","poem":1},{"lineBreak":true},{"text":"Cavanlarının analarını ağlar qoymaq üçün","poem":1},{"lineBreak":true},{"text":"Məhv edəni gətirdim.","poem":1},{"lineBreak":true},{"text":"Qəflətən onları qorxu və dəhşətə saldım.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yeddi uşaq doğan qadın zəifləyib can verdi,","poem":1},{"lineBreak":true},{"text":"Onun günəşi günorta çağı batdı,","poem":1},{"lineBreak":true},{"text":"Utanıb alçaldı.","poem":1},{"lineBreak":true},{"text":"Onlardan sağ qalanlarını","poem":1},{"lineBreak":true},{"text":"Düşmənlərinin önündə","poem":1},{"lineBreak":true},{"text":"Qılınca təslim edəcəyəm”»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vay mənim halıma!","poem":1},{"lineBreak":true},{"text":"Ey anam, sən məni bütün ölkə ilə","poem":1},{"lineBreak":true},{"text":"Mübahisə və dava etmək üçün doğmusan!","poem":1},{"lineBreak":true},{"text":"Mən heç kəsə sələm vermədim,","poem":1},{"lineBreak":true},{"text":"Heç kəs də mənə sələm vermədi.","poem":1},{"lineBreak":true},{"text":"Ancaq hamı məni lənətləyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rəbb dedi:","poem":1},{"lineBreak":true},{"text":"«Bundan sonra mütləq səni","poem":1},{"lineBreak":true},{"text":"Xeyir üçün xilas edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bəla və kədər vaxtı düşmənlərini","poem":1},{"lineBreak":true},{"text":"Sənə yalvarmağa məcbur edəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dəmiri, şimaldan gələn dəmiri və tuncu","poem":1},{"lineBreak":true},{"text":"Kim qıra bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sənin sərvətini və xəzinələrini","poem":1},{"lineBreak":true},{"text":"Qarət malı kimi başqalarına havayı verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bunu ölkənin hər tərəfində","poem":1},{"lineBreak":true},{"text":"Sənin günahlarından ötrü edəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mən səni tanımadığın ölkədə","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə qul edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki qəzəbim od tutub","poem":1},{"lineBreak":true},{"text":"Sizi yandıracaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sən bilirsən, ya Rəbb!","poem":1},{"lineBreak":true},{"text":"Məni yada sal və qayğıma qal.","poem":1},{"lineBreak":true},{"text":"Məni təqib edənlərdən qisasımı al,","poem":1},{"lineBreak":true},{"text":"Səbirli olduğuna görə məni həlak etmə.","poem":1},{"lineBreak":true},{"text":"Bil ki, Sənin üçün rüsvay oldum.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sözlərini tapıb yedim,","poem":1},{"lineBreak":true},{"text":"Sözlərin mənə sevinc və ürəyimə şadlıq gətirdi.","poem":1},{"lineBreak":true},{"text":"Çünki Sənə məxsusam,","poem":1},{"lineBreak":true},{"text":"Ey Ordular Allahı Rəbb!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kef çəkənlərin məclisində oturaraq","poem":1},{"lineBreak":true},{"text":"Sevinib coşmadım,","poem":1},{"lineBreak":true},{"text":"Əlin üzərimdə olduğuna görə","poem":1},{"lineBreak":true},{"text":"Tək-tənha oturdum.","poem":1},{"lineBreak":true},{"text":"Çünki məni qəzəblə doldurmuşdun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nə üçün ağrım kəsilməz,","poem":1},{"lineBreak":true},{"text":"Yaram çarəsizdir,","poem":1},{"lineBreak":true},{"text":"Şəfasına ümid yoxdur?","poem":1},{"lineBreak":true},{"text":"Məgər mənim üçün suyu qurumuş,","poem":1},{"lineBreak":true},{"text":"Etibarsız bir vadi olacaqsan?","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Buna görə Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Əgər sən tövbə etsən,","poem":1},{"lineBreak":true},{"text":"Səni yenə qəbul edib xidmətimə təyin edərəm.","poem":1},{"lineBreak":true},{"text":"Əgər cəfəngiyat danışmaq əvəzinə","poem":1},{"lineBreak":true},{"text":"Qiymətli sözlər söyləsən,","poem":1},{"lineBreak":true},{"text":"O zaman Mənim dilimlə danışacaqsan.","poem":1},{"lineBreak":true},{"text":"Onlar özləri sənə tərəf dönəcək,","poem":1},{"lineBreak":true},{"text":"Amma sən onlara tərəf qayıtmayacaqsan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Səni bu xalq üçün","poem":1},{"lineBreak":true},{"text":"Möhkəm tunc bir divar edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Sənə qarşı döyüşəcəklər,","poem":1},{"lineBreak":true},{"text":"Ancaq qalib gələ bilməyəcəklər.","poem":1},{"lineBreak":true},{"text":"Çünki Mən səninlə olacağam ki,","poem":1},{"lineBreak":true},{"text":"Səni qurtarıb azad edim»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"«Səni pis adamların əlindən azad edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Zülmkarların pəncəsindən satın alacağam».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}