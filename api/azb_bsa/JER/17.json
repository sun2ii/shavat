{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"heading","content":["Yəhudanın günahı və cəzası"]},{"type":"verse","number":1,"content":[{"text":"Yəhudanın günahı dəmir qələmlə yazıldı,","poem":1},{"lineBreak":true},{"text":"Ürəklərinin lövhələri və qurbangahlarının buynuzları üzərinə","poem":1},{"lineBreak":true},{"text":"Almaz uclu alətlə həkk edildi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar kölgəli ağacların yanında,","poem":1},{"lineBreak":true},{"text":"Yüksək təpələrdə, çöldəki dağlarda","poem":1},{"lineBreak":true},{"text":"Qurbangahlarına və Aşera bütlərinə","poem":1},{"lineBreak":true},{"text":"Öz uşaqlarına göstərdikləri qədər maraq göstərir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənin mal-dövlətini,","poem":1},{"lineBreak":true},{"text":"Bütün xəzinələrini, səcdəgahlarını","poem":1},{"lineBreak":true},{"text":"Ölkənin hər tərəfində işlənən günahlardan ötrü","poem":1},{"lineBreak":true},{"text":"Qarətə təslim edəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sənə verdiyim irsi","poem":1},{"lineBreak":true},{"text":"Öz qəbahətinlə yox edəcəksən.","poem":1},{"lineBreak":true},{"text":"Tanımadığın ölkədə səni","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə qul edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki siz Mənim qəzəbimdən","poem":1},{"lineBreak":true},{"text":"Od alışdırdınız,","poem":1},{"lineBreak":true},{"text":"O əbədi yanacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«O adam lənətlidir ki,","poem":1},{"lineBreak":true},{"text":"İnsana güvənir,","poem":1},{"lineBreak":true},{"text":"Bəşərin gücünə arxalanır,","poem":1},{"lineBreak":true},{"text":"Ürəyi Rəbdən ayrılır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O, çöldəki yulğun ağacı kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Xeyir gələndə onu görməyəcək.","poem":1},{"lineBreak":true},{"text":"Səhrada olan quraq yerlərdə","poem":1},{"lineBreak":true},{"text":"Heç kəs yaşamayan şoranlıqda sakin olacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nə xoşbəxtdir o adam ki","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənir,","poem":1},{"lineBreak":true},{"text":"Rəbbi özünə arxa sayır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O, sular kənarında","poem":1},{"lineBreak":true},{"text":"Əkilmiş ağac kimi olacaq.","poem":1},{"lineBreak":true},{"text":"Elə ağac ki çay kənarında kök salar,","poem":1},{"lineBreak":true},{"text":"İsti gələndə qorxmaz,","poem":1},{"lineBreak":true},{"text":"Yarpağı həmişə yaşıl qalar,","poem":1},{"lineBreak":true},{"text":"Quraqlıq olan il qayğı çəkməz,","poem":1},{"lineBreak":true},{"text":"Bəhər verməkdən qalmaz».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İnsan ürəyi hər şeydən hiyləgərdir,","poem":1},{"lineBreak":true},{"text":"Çarəsi yoxdur.","poem":1},{"lineBreak":true},{"text":"Onu kim başa düşə bilər?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Mən Rəbb ürəyi yoxlayıram,","poem":1},{"lineBreak":true},{"text":"İnsanın fikrini sınayıram ki,","poem":1},{"lineBreak":true},{"text":"Hər kəsə əməllərinə görə,","poem":1},{"lineBreak":true},{"text":"İşlərinin bəhrəsinə görə əvəz verim».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Haqsızlıqla var-dövlət toplayan adam","poem":1},{"lineBreak":true},{"text":"Özünün yumurtlamadığı yumurtaların üstünə","poem":1},{"lineBreak":true},{"text":"Oturan kəklik kimidir.","poem":1},{"lineBreak":true},{"text":"Ömrünün ortasında var-dövləti əldən gedəcək,","poem":1},{"lineBreak":true},{"text":"Axırda o adam axmaq çıxacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Müqəddəs məkanımızdakı yer","poem":1},{"lineBreak":true},{"text":"Əvvəlcədən ucaldılmış izzət taxtıdır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ya Rəbb, İsrailin Ümidgahı,","poem":1},{"lineBreak":true},{"text":"Səni tərk edənlərin hamısı utanacaq.","poem":1},{"lineBreak":true},{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Məndən üz döndərənlərin adı","poem":1},{"lineBreak":true},{"text":"Toz-torpağa yazılacaq,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbi – axar sular mənbəyini tərk etdilər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ya Rəbb, mənə şəfa versən,","poem":1},{"lineBreak":true},{"text":"Mən sağalaram.","poem":1},{"lineBreak":true},{"text":"Məni xilas etsən,","poem":1},{"lineBreak":true},{"text":"Mən xilas olaram.","poem":1},{"lineBreak":true},{"text":"Çünki həmd etdiyim Sənsən.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bax onlar mənə","poem":1},{"lineBreak":true},{"text":"«Rəbbin sözü hanı?","poem":1},{"lineBreak":true},{"text":"Qoy yerinə yetsin!» deyir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mən Sənin xidmətində","poem":1},{"lineBreak":true},{"text":"Çoban olmaqdan boyun qaçırmadım.","poem":1},{"lineBreak":true},{"text":"Bəla gününün gəlməsini istəmədim.","poem":1},{"lineBreak":true},{"text":"Sən bilirsən ki,","poem":1},{"lineBreak":true},{"text":"Ağzımdan nə çıxdısa,","poem":1},{"lineBreak":true},{"text":"Sənin gözünün önündədir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Məni dəhşətə salma,","poem":1},{"lineBreak":true},{"text":"Fəlakət günündə sığınacağım Sənsən.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qoy məni təqib edənlər utansın,","poem":1},{"lineBreak":true},{"text":"Mənsə utanmayım.","poem":1},{"lineBreak":true},{"text":"Qoy onlar qorxuya düşsün,","poem":1},{"lineBreak":true},{"text":"Mən isə qorxmayım.","poem":1},{"lineBreak":true},{"text":"Qara günü onların başına gətir,","poem":1},{"lineBreak":true},{"text":"Tamamilə qırılana qədər onları qır.","poem":1}]},{"type":"heading","content":["Şənbə gününə əməl edilməsi"]},{"type":"verse","number":19,"content":["Rəbb mənə belə dedi: «Get Yəhuda padşahlarının girib-çıxdıqları Xalq darvazasında və Yerusəlimin bütün darvazalarında dayanıb"]},{"type":"verse","number":20,"content":["onlara söylə ki, ey Yəhuda padşahları, Yəhuda və Yerusəlimin bütün əhalisi, bu darvazalardan girənlər, Rəbbin sözünə qulaq asın."]},{"type":"verse","number":21,"content":["Rəbb belə deyir: “Öz canınızı qorumaq üçün Şənbə günü yük daşımayın, Yerusəlim darvazalarından içəri gətirməyin."]},{"type":"verse","number":22,"content":["Şənbə günü evlərinizdən yük çıxarmayın, heç bir iş görməyin. Atalarınıza əmr etdiyim kimi Şənbə gününü təqdis edin."]},{"type":"verse","number":23,"content":["Ancaq onlar eşitmədi, qulaq asmadı. İnadkarlıq edərək Məni eşitmədilər və nəsihət almaq istəmədilər”."]},{"type":"verse","number":24,"content":["Rəbb bəyan edir: “Əgər siz Şənbə günü bu şəhərin darvazalarından yük daşımamaq, Şənbə gününü təqdis etmək və bu gün heç bir işlə məşğul olmamaqla Mənə, həqiqətən, itaət etsəniz,"]},{"type":"verse","number":25,"content":["o zaman Davudun taxtında oturan padşahlar və başçılar döyüş arabalarına və atlara minib Yəhuda adamları, Yerusəlimdə yaşayanlarla birgə bu şəhərin darvazalarından girəcək. Bu şəhər əbədi olaraq məskunlaşmış qalacaq."]},{"type":"verse","number":26,"content":["Yəhuda şəhərlərindən, Yerusəlimin ətrafından, Binyamin torpağından, yamaclı-düzənlikli bölgədən, dağlıq bölgədən və Negevdən adamlar gəlib Rəbbin məbədinə yandırma qurbanları, başqa qurbanlar, taxıl təqdimləri, kündür və şükür təqdimləri gətirəcək."]},{"type":"verse","number":27,"content":["Əgər siz Şənbə günü yük daşıyıb Yerusəlim darvazalarından girərək Şənbə gününü təqdis etməməklə Mənim sözümə qulaq asmasanız, onda Mən şəhərin darvazalarına od vuracağam, alov Yerusəlimin saraylarını yandırıb-yaxacaq və heç vaxt sönməyəcək”»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}