{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"heading","content":["Yeremya dulusçunun evində"]},{"type":"verse","number":1,"content":["Rəbdən Yeremyaya bu söz nazil oldu:"]},{"type":"verse","number":2,"content":["«Qalx dulusçunun evinə en, orada sözlərimi sənə bildirəcəyəm»."]},{"type":"verse","number":3,"content":["Mən dulusçunun evinə endim. Gördüm ki, o, çarx üzərində işləyir."]},{"type":"verse","number":4,"content":["Palçıqdan düzəltdiyi qab əlində xarab olanda dulusçu özünün istədiyi kimi palçıqdan başqa bir qab düzəldirdi."]},{"type":"verse","number":5,"content":["Mənə yenə Rəbbin sözü nazil oldu:"]},{"type":"verse","number":6,"content":["«Ey İsrail nəsli, Mən də sizinlə bu dulusçunun etdiyi kimi rəftar edə bilmərəmmi?» Rəbb belə bəyan edir. «Bilin ki, palçıq dulusçunun əlində necədirsə, siz də Mənim əlimdə o cürsünüz, ey İsrail nəsli."]},{"type":"verse","number":7,"content":["Bir vaxt Mən bir milləti yaxud ölkəni kökündən dağıdacağımı, yıxıb məhv edəcəyimi söyləyəndə"]},{"type":"verse","number":8,"content":["əgər Mənim xəbərdarlıq etdiyim bu millət öz pis əməlindən dönərsə, ona göndərmək istədiyim bəladan vaz keçəcəyəm."]},{"type":"verse","number":9,"content":["Başqa vaxt bir milləti yaxud da ölkəni qurub-tikəcəyimi söyləyəndə"]},{"type":"verse","number":10,"content":["əgər bu millət sözümə qulaq asmayıb pis əməl edərsə, ona vəd verdiyim yaxşılıqdan vaz keçəcəyəm."]},{"type":"verse","number":11,"content":["İndi Yəhuda adamlarına, Yerusəlimdə yaşayanlara söylə ki, Rəbb belə deyir: “Mən sizə bir bəla hazırlayıram, sizə bir qəsd qururam. İndi hər biriniz öz pis yolunuzdan dönüb yaşayışınızı və əməllərinizi islah edin”."]},{"type":"verse","number":12,"content":["Ancaq onlar deyir: “Boş sözdür, biz öz niyyətlərimizin dalınca gedəcəyik, hər birimiz öz qara ürəyimizin inadına görə rəftar edəcəyik”»."]},{"type":"verse","number":13,"content":[{"text":"Buna görə Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«İndi millətlər arasında soruşun ki,","poem":1},{"lineBreak":true},{"text":"Kim belə sözlər eşitmişdir?","poem":1},{"lineBreak":true},{"text":"Bakirə qıza bənzəyən İsrail","poem":1},{"lineBreak":true},{"text":"Dəhşətli bir iş etdi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Livanın qarı qayalı dağ yamaclarından","poem":1},{"lineBreak":true},{"text":"Heç əskik olarmı?","poem":1},{"lineBreak":true},{"text":"Uzaqdan axan soyuq sular quruyarmı?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amma xalqım Məni unutdu,","poem":1},{"lineBreak":true},{"text":"Saxta allahlara buxur yandırdı.","poem":1},{"lineBreak":true},{"text":"Bu allahlar onların gedəcəyi yollarda,","poem":1},{"lineBreak":true},{"text":"Qədim yollarda büdrəmələrinə səbəb oldu,","poem":1},{"lineBreak":true},{"text":"Onları hamar olmayan","poem":1},{"lineBreak":true},{"text":"Dolanbac yollarda gəzdirdilər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ölkələri viran ediləcək,","poem":1},{"lineBreak":true},{"text":"Əbədi kinayə hədəfinə çevriləcək.","poem":1},{"lineBreak":true},{"text":"Onda oradan ötən hər kəs","poem":1},{"lineBreak":true},{"text":"Heyrətə gəlib başını bulayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onları səmum küləyi kimi","poem":1},{"lineBreak":true},{"text":"Düşmən önündə pərən-pərən salacağam.","poem":1},{"lineBreak":true},{"text":"Onlara fəlakət günündə","poem":1},{"lineBreak":true},{"text":"Üzümü deyil, arxamı göstərəcəyəm».","poem":1}]},{"type":"verse","number":18,"content":["O zaman onlar dedi: «Gəlin Yeremyaya qəsd quraq. Çünki qanunu öyrədəcək kahin, nəsihət verəcək müdrik adam, söz deyəcək peyğəmbər heç vaxt əskik olmayacaq. Gəlin ona dilimizlə hücum edək, sözlərinə qulaq asmayaq»."]},{"type":"verse","number":19,"content":[{"text":"Ya Rəbb, mənə yaxşı qulaq as,","poem":1},{"lineBreak":true},{"text":"Mənimlə çəkişənlərin sözünü eşit.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaxşılığın əvəzində pislik edilərmi?","poem":1},{"lineBreak":true},{"text":"Onlar canımı almaq üçün quyu qazır.","poem":1},{"lineBreak":true},{"text":"Unutma, mən önündə ona görə dayanmışam ki,","poem":1},{"lineBreak":true},{"text":"Onlar üçün yaxşı şey istəyim,","poem":1},{"lineBreak":true},{"text":"Onlardan qəzəbini döndərim.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Buna görə də onların övladlarını","poem":1},{"lineBreak":true},{"text":"Aclığa ver, qılınc ağzına təslim et.","poem":1},{"lineBreak":true},{"text":"Qadınları uşaqsız və dul qalsın,","poem":1},{"lineBreak":true},{"text":"Ərlərini ölüm aparsın.","poem":1},{"lineBreak":true},{"text":"Cavanlarını müharibədə qılınc öldürsün.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sən onların üzərinə","poem":1},{"lineBreak":true},{"text":"Qəflətən qarətçilər göndərəndə","poem":1},{"lineBreak":true},{"text":"Qoy evlərindən fəryad eşidilsin.","poem":1},{"lineBreak":true},{"text":"Çünki məni tutmaq üçün quyu qazdılar,","poem":1},{"lineBreak":true},{"text":"Ayağımın altında gizlincə tələ qurdular.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ancaq, ya Rəbb, məni öldürmək üçün","poem":1},{"lineBreak":true},{"text":"Qurduqları bütün qəsdləri Sən bilirsən.","poem":1},{"lineBreak":true},{"text":"Təqsirlərini bağışlama,","poem":1},{"lineBreak":true},{"text":"Günahlarını önündən silmə.","poem":1},{"lineBreak":true},{"text":"Sənin önündə yıxılsınlar,","poem":1},{"lineBreak":true},{"text":"Qəzəbin vaxtı onlara qarşı hərəkət et.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}