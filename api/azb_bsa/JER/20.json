{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Yeremyanın Paşxurla mübahisəsi"]},{"type":"verse","number":1,"content":["Rəbbin məbədində baş nəzarətçi olan kahin İmmer oğlu Paşxur Yeremyanın bu sözlərlə peyğəmbərlik etdiyini eşitdi."]},{"type":"verse","number":2,"content":["Paşxur Yeremya peyğəmbəri döydü və Rəbbin məbədinin yanındakı Yuxarı Binyamin darvazasında olan kündəyə",{"noteId":7},"saldı."]},{"type":"verse","number":3,"content":["Ertəsi gün Paşxur Yeremyanı kündədən çıxartdı. Yeremya ona dedi: «Rəbb sənin adını Paşxur deyil, Maqor-Missaviv",{"noteId":8},"qoydu."]},{"type":"verse","number":4,"content":["Çünki Rəbb belə deyir: “Bax Mən səni özün və bütün səni sevənlər üçün dəhşətə çevirəcəyəm. Onlar öz düşmənlərinin qılıncı ilə həlak olacaq və sənin gözlərin bunu görəcək. Bütün Yəhudanı Babil padşahına təslim edəcəyəm. O, xalqı Babilə sürgün edəcək və qılıncla həlak edəcək."]},{"type":"verse","number":5,"content":["Bu şəhərin bütün var-dövlətini, qazancını, qiymətli şeylərini və Yəhuda padşahlarının bütün xəzinələrini düşmənlərə təslim edəcəyəm. Onları qarət edəcəklər, götürüb Babilə aparacaqlar."]},{"type":"verse","number":6,"content":["Sən Paşxur və evində yaşayanların hamısı Babilə sürgün olunacaqsınız. Sən və yalandan peyğəmbərlik etdiyin bütün dostların orada öləcəksiniz, orada da basdırılacaqsınız”»."]},{"type":"heading","content":["Yeremyanın şikayəti"]},{"type":"verse","number":7,"content":[{"text":"Ya Rəbb, Sən məni məcbur etdin,","poem":1},{"lineBreak":true},{"text":"Mən də məcbur oldum.","poem":1},{"lineBreak":true},{"text":"Sən məndən güclüsən,","poem":1},{"lineBreak":true},{"text":"Sən mənə üstün gəldin.","poem":1},{"lineBreak":true},{"text":"Bütün gün mənə gülürlər,","poem":1},{"lineBreak":true},{"text":"Hər kəs mənimlə əylənir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Çünki mən danışmağa başlayan kimi","poem":1},{"lineBreak":true},{"text":"Fəryad edib","poem":1},{"lineBreak":true},{"text":"«Zorakılıq və talan!» deyə qışqırıram.","poem":1},{"lineBreak":true},{"text":"Rəbbin sözündən ötrü","poem":1},{"lineBreak":true},{"text":"Mən bütün gün rüsvay oldum,","poem":1},{"lineBreak":true},{"text":"Təhqir edildim.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mən fikirləşdim:","poem":1},{"lineBreak":true},{"text":"«Daha Onu yada salmayacağam,","poem":1},{"lineBreak":true},{"text":"Onun adı ilə danışmayacağam».","poem":1},{"lineBreak":true},{"text":"Onda Onun sözü sümüklərimdə həbs edilən,","poem":1},{"lineBreak":true},{"text":"Ürəyimdə yanan bir od oldu.","poem":1},{"lineBreak":true},{"text":"Onu içimdə saxlamaqdan yoruldum,","poem":1},{"lineBreak":true},{"text":"Artıq bunu edə bilmirəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki çoxlarının","poem":1},{"lineBreak":true},{"text":"«Hər tərəfdə dəhşət!","poem":1},{"lineBreak":true},{"text":"Onu mühakimə edin,","poem":1},{"lineBreak":true},{"text":"Biz də onu mühakimə edək!»","poem":1},{"lineBreak":true},{"text":"Deyə pıçıldaşdığını eşitdim.","poem":1},{"lineBreak":true},{"text":"Bütün güvəndiyim adamlar","poem":1},{"lineBreak":true},{"text":"Büdrəməyimi gözləyərək","poem":1},{"lineBreak":true},{"text":"«Bəlkə aldanar, onda onu məğlub edərik,","poem":1},{"lineBreak":true},{"text":"Ondan qisasımızı alarıq» dedilər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ancaq Rəbb igid bir döyüşçü kimi mənimlədir.","poem":1},{"lineBreak":true},{"text":"Buna görə də məni təqib edənlər büdrəyəcək,","poem":1},{"lineBreak":true},{"text":"Qalib gələ bilməyəcək.","poem":1},{"lineBreak":true},{"text":"Uğur qazana bilmədikləri üçün","poem":1},{"lineBreak":true},{"text":"Böyük xəcalət çəkəcəklər.","poem":1},{"lineBreak":true},{"text":"Rüsvayçılıq əbədi olacaq,","poem":1},{"lineBreak":true},{"text":"Heç vaxt unudulmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ancaq, ey Ordular Rəbbi,","poem":1},{"lineBreak":true},{"text":"Sən salehi sınağa çəkirsən,","poem":1},{"lineBreak":true},{"text":"Fikri və ürəyi görürsən.","poem":1},{"lineBreak":true},{"text":"Qoy gözüm Sənin onlardan alacağın","poem":1},{"lineBreak":true},{"text":"Qisası görsün!","poem":1},{"lineBreak":true},{"text":"Çünki işimi Sənə tapşırdım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rəbbi tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Çünki fəqiri","poem":1},{"lineBreak":true},{"text":"Zalımların əlindən qurtardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Doğulduğum gün lənətə gəlsin!","poem":1},{"lineBreak":true},{"text":"Anamın məni doğduğu günə","poem":1},{"lineBreak":true},{"text":"Bir daş düşsün!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Atamı çox sevindirərək","poem":1},{"lineBreak":true},{"text":"«Bir oğlan uşağın oldu!»","poem":1},{"lineBreak":true},{"text":"Deyə müjdə verən adam","poem":1},{"lineBreak":true},{"text":"Lənətə gəlsin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qoy o adam Rəbbin","poem":1},{"lineBreak":true},{"text":"Yazığı gəlməyib dağıtdığı","poem":1},{"lineBreak":true},{"text":"Şəhərlər kimi olsun!","poem":1},{"lineBreak":true},{"text":"Səhər fəryad,","poem":1},{"lineBreak":true},{"text":"Günorta nalə eşitsin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki bətndə ikən məni öldürmədi.","poem":1},{"lineBreak":true},{"text":"Onda anamın qarnı qəbrim olardı,","poem":1},{"lineBreak":true},{"text":"Bətni daim hamilə qalardı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nə üçün ana bətnindən çıxdım?","poem":1},{"lineBreak":true},{"text":"Əzab-əziyyət görmək,","poem":1},{"lineBreak":true},{"text":"Ömrümü rüsvayçılıqla keçirmək üçünmü?","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Kündə – dustaqları bağlamaq üçün cəza aləti.","reference":{"chapter":20,"verse":2}},{"noteId":8,"caller":"+","text":"Paşxur – ibrani dilində azad, Maqor-Missaviv – ibrani dilində hər tərəfdə dəhşət.","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/azb_bsa/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}