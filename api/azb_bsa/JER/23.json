{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":23,"content":[{"type":"heading","content":["Saleh padşah"]},{"type":"verse","number":1,"content":["Rəbb bəyan edir: «Otlağımın qoyunlarını məhv edən və pərən-pərən salan çobanların vay halına!»"]},{"type":"verse","number":2,"content":["Buna görə də İsrailin Allahı Rəbb xalqımı otaran çobanların əleyhinə belə deyir: «Siz Mənim sürümü pərən-pərən salıb qovdunuz, onların qayğısına qalmadınız. İndi Mən də etdiyiniz bəd əməllərə görə cəzanızın qayğısına qalacağam» Rəbb belə bəyan edir."]},{"type":"verse","number":3,"content":["«Sürümün qalanlarını sürgün etdiyim bütün ölkələrdən yığıb-toplayacağam, onları yenə ağıllarına qaytaracağam və törəyib çoxalacaqlar."]},{"type":"verse","number":4,"content":["Üstlərinə onları otaracaq çobanlar qoyacağam. Daha qorxub dəhşətə düşməyəcəklər, biri də itməyəcək» Rəbb belə bəyan edir."]},{"type":"verse","number":5,"content":[{"text":"«Budur, Davud üçün saleh bir Pöhrə","poem":1},{"lineBreak":true},{"text":"Çıxaracağım günlər gəlir.","poem":1},{"lineBreak":true},{"text":"Bu Padşah müdrikliklə padşahlıq edəcək,","poem":1},{"lineBreak":true},{"text":"Ölkədə ədalətli və saleh işlər görəcək»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Onun dövründə Yəhuda xilas olacaq,","poem":1},{"lineBreak":true},{"text":"İsrail əmin-amanlıqda yaşayacaq.","poem":1},{"lineBreak":true},{"text":"Onu “Rəbb salehliyimizdir” çağıracaqlar».","poem":1}]},{"type":"verse","number":7,"content":["Buna görə də Rəbb bəyan edir: «Bir gün gələcək ki, insanlar artıq “İsrail övladlarını Misir torpağından çıxaran Rəbbin varlığına and olsun” deməyəcək,"]},{"type":"verse","number":8,"content":["amma “İsrail nəslindən törəyənləri şimal ölkəsindən və sürgün etdiyi bütün başqa ölkələrdən geri qaytaran Rəbbin varlığına and olsun” deyəcək. Beləcə öz torpaqlarında yaşayacaqlar»."]},{"type":"heading","content":["Yəhudanın yalançı peyğəmbərləri"]},{"type":"verse","number":9,"content":["Peyğəmbərlər haqqında:",{"text":"Ürəyim içimdə parçalandı,","poem":1},{"lineBreak":true},{"text":"Bütün sümüklərim titrədi.","poem":1},{"lineBreak":true},{"text":"Rəbbə görə,","poem":1},{"lineBreak":true},{"text":"Onun müqəddəs sözlərinə görə","poem":1},{"lineBreak":true},{"text":"Bir sərxoş kimi,","poem":1},{"lineBreak":true},{"text":"Şəraba aludə olan adam kimiyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki ölkə zinakarlarla doludur,","poem":1},{"lineBreak":true},{"text":"Lənətə görə yas tutur.","poem":1},{"lineBreak":true},{"text":"Çöldəki otlaqlar quruyub,","poem":1},{"lineBreak":true},{"text":"Adamlar pis yola düşüb.","poem":1},{"lineBreak":true},{"text":"Güclərini zorakılığa sərf edirlər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Peyğəmbər də, kahin də allahsızdır,","poem":1},{"lineBreak":true},{"text":"Məbədimdə pisliklərini gördüm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buna görə getdikləri yol","poem":1},{"lineBreak":true},{"text":"Qaranlıqda sürüşkən yer kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Orada qovulub yıxılacaqlar.","poem":1},{"lineBreak":true},{"text":"Çünki cəzalanacaqları il","poem":1},{"lineBreak":true},{"text":"Başlarına fəlakət gətirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"«Samariya peyğəmbərləri arasında","poem":1},{"lineBreak":true},{"text":"Bu iyrənc işi gördüm:","poem":1},{"lineBreak":true},{"text":"Baalın adı ilə peyğəmbərlik edərək","poem":1},{"lineBreak":true},{"text":"Xalqım İsraili yoldan azdırdılar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yerusəlim peyğəmbərləri arasında","poem":1},{"lineBreak":true},{"text":"Bu qorxunc işi gördüm:","poem":1},{"lineBreak":true},{"text":"Zina edirlər,","poem":1},{"lineBreak":true},{"text":"Yalan dalınca gedirlər.","poem":1},{"lineBreak":true},{"text":"Zorakıların qoluna güc verirlər.","poem":1},{"lineBreak":true},{"text":"Beləcə heç kəs pisliyindən dönmür.","poem":1},{"lineBreak":true},{"text":"Hamısı Mənim üçün Sodom kimi,","poem":1},{"lineBreak":true},{"text":"Şəhər xalqı Homorra kimi oldu».","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Buna görə də Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlər haqqında belə deyir:","poem":1},{"lineBreak":true},{"text":"«Baxın Mən onlara yovşan yedirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Zəhərli su içirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki allahsızlıq Yerusəlim peyğəmbərlərindən","poem":1},{"lineBreak":true},{"text":"Bütün ölkəyə yayıldı».","poem":1}]},{"type":"verse","number":16,"content":["Ordular Rəbbi belə deyir:",{"text":"«Sizin üçün peyğəmbərlik edən","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərin sözünə qulaq asmayın.","poem":1},{"lineBreak":true},{"text":"Onlar sizə boş şeylər öyrədir.","poem":1},{"lineBreak":true},{"text":"Rəbbin ağzından çıxanları deyil,","poem":1},{"lineBreak":true},{"text":"Özlərinin uydurduqları görüntüləri söyləyirlər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onlar Mənə xor baxanlara deyir:","poem":1},{"lineBreak":true},{"text":"“Rəbb söylədi ki, sizin üçün","poem":1},{"lineBreak":true},{"text":"Əmin-amanlıq olacaq”.","poem":1},{"lineBreak":true},{"text":"İnadkarlıqla ürəklərinin istədiyinə uyanlara deyirlər:","poem":1},{"lineBreak":true},{"text":"“Üstünüzə fəlakət gəlməyəcək”.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbbin sözünü anlayıb eşitmək üçün","poem":1},{"lineBreak":true},{"text":"Rəbbin məclisində kimsə durubmu?","poem":1},{"lineBreak":true},{"text":"Onun sözünə qulaq asıb eşidən varmı?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Budur, Rəbbin fırtınası qəzəblə qopacaq,","poem":1},{"lineBreak":true},{"text":"Qasırğa fırlanıb","poem":1},{"lineBreak":true},{"text":"Pis adamların başında çatlayacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ürəyinin istəyinə çatana qədər,","poem":1},{"lineBreak":true},{"text":"Onu bitirənə qədər","poem":1},{"lineBreak":true},{"text":"Rəbbin qəzəbi dayanmayacaq.","poem":1},{"lineBreak":true},{"text":"Gələcək günlərdə bunu açıq-aşkar anlayacaqsınız.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bu peyğəmbərləri Mən göndərmədim,","poem":1},{"lineBreak":true},{"text":"Amma ora-bura qaçdılar.","poem":1},{"lineBreak":true},{"text":"Onlara Mən söz demədim,","poem":1},{"lineBreak":true},{"text":"Amma peyğəmbərlik etdilər.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ancaq onlar məclisimdə dursaydılar,","poem":1},{"lineBreak":true},{"text":"Sözlərimi xalqıma çatdırardılar.","poem":1},{"lineBreak":true},{"text":"Pis yollarından, şər əməllərindən","poem":1},{"lineBreak":true},{"text":"Xalqı çəkindirərdilər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Mən yalnız yaxında olan Allah deyiləm,","poem":1},{"lineBreak":true},{"text":"Həm də uzaqda olan Allaham.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kimsə gizli yerlərdə saxlana bilər ki,","poem":1},{"lineBreak":true},{"text":"Mən onu görə bilməyim?»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Yeri, göyü Mən doldurmamışammı?»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":25,"content":["«Mənim adımdan yalan söyləyən peyğəmbərlərin “Yuxu gördüm, yuxu gördüm!” sözlərini eşitdim."]},{"type":"verse","number":26,"content":["Nə vaxta qədər yalan söyləyən, öz ürəklərinin uydurmalarını bildirən peyğəmbərlər bu işlə məşğul olacaq?"]},{"type":"verse","number":27,"content":["Ataları necə Baal bütünə görə adımı unutdularsa, onlar da zənn edir ki, bir-birlərinə danışdıqları yuxularla xalqıma adımı unutduracaq."]},{"type":"verse","number":28,"content":["Yuxu görən peyğəmbər yuxusunu söyləsin. Amma sözüm nazil olan adam onu dəqiq danışsın. Daha buğdanın yanında saman nədir?» Rəbb belə bəyan edir."]},{"type":"verse","number":29,"content":["«Mənim sözüm bir od kimi, qayaları parçalayan gürz kimi deyilmi?» Rəbb belə bəyan edir."]},{"type":"verse","number":30,"content":["«Buna görə də Mən peyğəmbərlərə qarşıyam, onlar sözlərimi bir-birlərindən oğurlayır» Rəbb belə bəyan edir."]},{"type":"verse","number":31,"content":["«Bax Mən peyğəmbərlərə qarşıyam. Onlar öz dillərini tərpədib “Rəbb belə deyir” söyləyir» Rəbb belə bəyan edir."]},{"type":"verse","number":32,"content":["«Bax Mən yalançı yuxular görüb peyğəmbərlik edənlərə qarşıyam» Rəbb belə bəyan edir. «Onlar bu yuxuları danışıb yalanları və boş lovğalıqları ilə xalqımı yoldan azdırır. Onları Mən göndərmədim, onlara heç nə buyurmadım. Bu xalqa heç bir faydaları yoxdur» Rəbb belə bəyan edir."]},{"type":"verse","number":33,"content":["«Əgər bu xalqdan biri yaxud bir peyğəmbər ya da bir kahin səndən “Bəs Rəbbin yük olan kəlamı nədir?” soruşsa, ona söylə: “Yük sizsiniz. Mən sizi atacağam” Rəbb belə bəyan edir."]},{"type":"verse","number":34,"content":["“Rəbbin yük olan kəlamıdır” deyən peyğəmbərə, kahinə yaxud adi adama gəlincə, Mən o adamı da, onun ailəsini də cəzalandıracağam."]},{"type":"verse","number":35,"content":["Hər biriniz öz yoldaşınıza, soydaşınıza belə deyin: “Rəbb nə cavab verdi? Rəbb nə söylədi?”"]},{"type":"verse","number":36,"content":["Bir daha Rəbbin yük olan kəlamını yada salmayacaqsınız, çünki hər kəsin sözü özünə yük olacaq. Bununla siz var olan Allahın, Ordular Rəbbinin, Allahımızın sözlərini təhrif etdiniz."]},{"type":"verse","number":37,"content":["Peyğəmbərə belə söylə: “Rəbb sənə nə cavab verdi? Rəbb nə söylədi?”"]},{"type":"verse","number":38,"content":["“Rəbbin yük olan kəlamıdır” desəniz də, Rəbb hökmən belə deyər: “‹Rəbbin yük olan kəlamıdır› deyirsiniz, halbuki Mən sizə xəbərdarlıq edib ‹Rəbbin yük olan kəlamıdır› deməməyi söyləmişdim."]},{"type":"verse","number":39,"content":["Buna görə də sizi tamamilə unudacağam, sizi də, özünüzə və atalarınıza verdiyim şəhəri də önümdən rədd edəcəyəm."]},{"type":"verse","number":40,"content":["Üzərinizə heç vaxt unudulmayan biabırçılıq, əbədi rüsvayçılıq gətirəcəyəm”»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/22.json","previousChapterAudioLinks":{},"numberOfVerses":40}