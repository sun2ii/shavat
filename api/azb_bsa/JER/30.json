{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Allahın öz xalqına vədi"]},{"type":"verse","number":1,"content":["Yeremyaya Rəbdən bu söz nazil oldu:"]},{"type":"verse","number":2,"content":["«İsrailin Allahı Rəbb belə deyir: “Sənə söylədiyim bütün sözləri bir kitaba yaz”."]},{"type":"verse","number":3,"content":["Çünki Rəbb bəyan edir: “Xalqım İsraili və Yəhudanı sürgündən qaytaracağım günlər yaxınlaşır. Onları atalarına verdiyim torpağa qaytaracağam və oranı mülk edəcəklər”. Bu, Rəbbin sözüdür."]},{"type":"verse","number":4,"content":["İsrail və Yəhuda üçün Rəbbin söylədiyi sözlər bunlardır."]},{"type":"verse","number":5,"content":["Rəbb belə deyir:",{"text":"“Qorxu səsi eşitdik,","poem":1},{"lineBreak":true},{"text":"Asayiş deyil, dəhşət səsi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"İndi soruşun, bilin ki,","poem":1},{"lineBreak":true},{"text":"Kişi də uşaq doğarmı?","poem":1},{"lineBreak":true},{"text":"Elə isə nə üçün doğan qadın kimi","poem":1},{"lineBreak":true},{"text":"Hər kişinin əllərini belində görürəm?","poem":1},{"lineBreak":true},{"text":"Nə üçün hamının bənizi solub?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ah, bu nə dəhşətli gündür!","poem":1},{"lineBreak":true},{"text":"Bir daha belə gün olmayacaq,","poem":1},{"lineBreak":true},{"text":"Yaqub nəsli üçün sıxıntı dövrü olacaq,","poem":1},{"lineBreak":true},{"text":"Ancaq yenə də bundan qurtulacaq”.","poem":1}]},{"type":"verse","number":8,"content":["Ordular Rəbbi bəyan edir: “O gün boynundakı boyunduruğu qıracaq, iplərini qoparacağam. Bundan sonra yadellilər onları özlərinə qul etməyəcək."]},{"type":"verse","number":9,"content":["Ancaq özlərinin Allahı Rəbbə, onlara təyin edəcəyim padşahları Davuda qulluq edəcəklər”."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Qorxma, ey qulum Yaqub,","poem":1},{"lineBreak":true},{"text":"Dəhşətə düşmə, ey İsrail.","poem":1},{"lineBreak":true},{"text":"Çünki səni uzaq yerlərdən,","poem":1},{"lineBreak":true},{"text":"Nəslini sürgün olunduğu ölkədən qurtaracağam.","poem":1},{"lineBreak":true},{"text":"Yaqub nəsli yenə geri qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Rahatlıq tapıb qayğısız olacaq,","poem":1},{"lineBreak":true},{"text":"Onu kimsə qorxutmayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki Mən səninləyəm,","poem":1},{"lineBreak":true},{"text":"Səni qurtaracağam”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"“Səni aralarına apardığım","poem":1},{"lineBreak":true},{"text":"Millətlərin hamısını yox etsəm də,","poem":1},{"lineBreak":true},{"text":"Səni tamamilə məhv etməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Səni ədalətlə tərbiyələndirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Amma cəzasız da qoymayacağam”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Çünki Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Sənin yaran şəfa tapmaz,","poem":1},{"lineBreak":true},{"text":"Xoran sağalmaz.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Məhkəmədə işinə baxan yoxdur,","poem":1},{"lineBreak":true},{"text":"Xəstəliyinə dərman yoxdur,","poem":1},{"lineBreak":true},{"text":"Sənin dərdinə əlac yoxdur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bütün müttəfiqlərin səni unutdu,","poem":1},{"lineBreak":true},{"text":"Səni arayıb-axtarmırlar.","poem":1},{"lineBreak":true},{"text":"Düşmən vuran kimi Mən səni vurdum.","poem":1},{"lineBreak":true},{"text":"Rəhmsizcəsinə cəzalandırdım.","poem":1},{"lineBreak":true},{"text":"Çünki təqsirkarlığın böyükdür,","poem":1},{"lineBreak":true},{"text":"Günahların çoxdur.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Niyə yarandan ötrü qışqırırsan?","poem":1},{"lineBreak":true},{"text":"Dərdin şəfa tapmaz.","poem":1},{"lineBreak":true},{"text":"Bu işləri ona görə sənə etdim ki,","poem":1},{"lineBreak":true},{"text":"Təqsirkarlığın böyükdür,","poem":1},{"lineBreak":true},{"text":"Günahların çoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ancaq səni yeyənlərin də hamısı yem olacaq.","poem":1},{"lineBreak":true},{"text":"Bütün düşmənlərin sürgünə gedəcək.","poem":1},{"lineBreak":true},{"text":"Səni soyanlar soyulacaq,","poem":1},{"lineBreak":true},{"text":"Səni qarət edənlər qarət olunacaq”.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Mən səni yenə sağaldacağam,","poem":1},{"lineBreak":true},{"text":"Yaralarına şəfa verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki deyirlər ki,","poem":1},{"lineBreak":true},{"text":"Sion rədd edilib,","poem":1},{"lineBreak":true},{"text":"Onu axtaran yoxdur”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Mən Yaqubun çadırlarını","poem":1},{"lineBreak":true},{"text":"Sürgündən geri qaytaracağam.","poem":1},{"lineBreak":true},{"text":"Onun məskənlərinə rəhm edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Şəhər yenidən viranələri üzərində tikiləcək,","poem":1},{"lineBreak":true},{"text":"Saray öz yerində bərpa olunacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onların arasından","poem":1},{"lineBreak":true},{"text":"Şükür və şənlik səsləri eşidiləcək.","poem":1},{"lineBreak":true},{"text":"Mən onları çoxaldacağam, azalmayacaqlar,","poem":1},{"lineBreak":true},{"text":"İzzətləndirəcəyəm, alçalmayacaqlar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Övladları əvvəlki kimi olacaq,","poem":1},{"lineBreak":true},{"text":"İcması önümdə möhkəm duracaq.","poem":1},{"lineBreak":true},{"text":"Onları sıxışdıranların hamısını cəzalandıracağam.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəhbərləri özlərindən olacaq,","poem":1},{"lineBreak":true},{"text":"Başçıları aralarından çıxacaq.","poem":1},{"lineBreak":true},{"text":"Onu Özümə yaxınlaşdıracağam,","poem":1},{"lineBreak":true},{"text":"O da Mənə yaxınlaşacaq.","poem":1},{"lineBreak":true},{"text":"Başqa cür kim Mənə özü yaxınlaşmağa","poem":1},{"lineBreak":true},{"text":"Cürət edə bilər?”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"“Beləcə siz Mənim xalqım,","poem":1},{"lineBreak":true},{"text":"Mən də sizin Allahınız olacağam”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Budur, Rəbbin fırtınası qəzəblə qopacaq,","poem":1},{"lineBreak":true},{"text":"Şiddətli qasırğası","poem":1},{"lineBreak":true},{"text":"Pis adamların başında çatlayacaq.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Rəbb Öz ürəyinin istədiyini","poem":1},{"lineBreak":true},{"text":"Tamamilə edənə qədər","poem":1},{"lineBreak":true},{"text":"Qızğın qəzəbini söndürməyəcək.","poem":1},{"lineBreak":true},{"text":"Siz gələcəkdə bunu anlayacaqsınız.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}