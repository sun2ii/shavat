{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Rəbb bəyan edir: «O zaman Mən bütün İsrail qəbilələrinin Allahı olacağam, onlar da Mənim xalqım olacaq»."]},{"type":"heading","content":["İsrail xalqının öz yurduna dönməsi"]},{"type":"verse","number":2,"content":["Rəbb belə deyir:",{"text":"«Mən İsrailə dinclik verməyə gedəndə","poem":1},{"lineBreak":true},{"text":"Qılıncdan qaçıb qurtulan xalq","poem":1},{"lineBreak":true},{"text":"Çöldə lütf tapdı».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb uzaqdan mənə görünüb dedi:","poem":1},{"lineBreak":true},{"text":"«Səni əbədi bir məhəbbətlə sevdim,","poem":1},{"lineBreak":true},{"text":"Buna görə də sevgi ilə","poem":1},{"lineBreak":true},{"text":"Səni Özümə tərəf çəkdim.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səni yenidən ayağa qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Sən də ayağa qalxacaqsan,","poem":1},{"lineBreak":true},{"text":"Ey bakirə qıza bənzəyən İsrail!","poem":1},{"lineBreak":true},{"text":"Sən yenə dəflərinlə bəzənib","poem":1},{"lineBreak":true},{"text":"Şadlıq edənlərlə birgə rəqsə qoşulacaqsan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yenə də Samariya dağlarında bağ salacaqsan,","poem":1},{"lineBreak":true},{"text":"Bağ salanlar onun meyvələrindən dadacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bir gün gələcək ki,","poem":1},{"lineBreak":true},{"text":"Efrayimin dağlıq bölgəsində","poem":1},{"lineBreak":true},{"text":"Keşikçilər “qalxın, Siona,","poem":1},{"lineBreak":true},{"text":"Allahımız Rəbbin yanına çıxaq”","poem":1},{"lineBreak":true},{"text":"Deyə qışqıracaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Yaqubu sevinclə tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Millətlərin başçısı üçün səs qaldırın!","poem":1},{"lineBreak":true},{"text":"Ucadan həmd edib bildirin!","poem":1},{"lineBreak":true},{"text":"“Ya Rəbb, xalqını,","poem":1},{"lineBreak":true},{"text":"İsraildən sağ qalanları xilas et!” deyin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mən onları şimal ölkəsindən qaytaracağam,","poem":1},{"lineBreak":true},{"text":"Dünyanın uzaq yerlərindən toplayacağam.","poem":1},{"lineBreak":true},{"text":"Aralarında kor, topal,","poem":1},{"lineBreak":true},{"text":"Hamilə və doğan qadın da olacaq.","poem":1},{"lineBreak":true},{"text":"Böyük bir camaat olub buraya qayıdacaqlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar ağlaya-ağlaya gələcək,","poem":1},{"lineBreak":true},{"text":"Yalvardıqları zaman","poem":1},{"lineBreak":true},{"text":"Onlara yol göstərib geri qaytaracağam.","poem":1},{"lineBreak":true},{"text":"Axar sular boyunca","poem":1},{"lineBreak":true},{"text":"Büdrəməyəcəkləri düz yolla aparacağam.","poem":1},{"lineBreak":true},{"text":"Çünki Mən İsrailin atasıyam,","poem":1},{"lineBreak":true},{"text":"Efrayim də ilk oğlumdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ey millətlər, Rəbbin sözünü eşidin,","poem":1},{"lineBreak":true},{"text":"Uzaqlardakı adalarda elan edib deyin:","poem":1},{"lineBreak":true},{"text":"“İsraili səpələyən onu bir yerə toplayacaq,","poem":1},{"lineBreak":true},{"text":"Sürüsünü qoruyan çoban kimi","poem":1},{"lineBreak":true},{"text":"Onu qoruyacaq”.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki Rəbb Yaqubu satın aldı,","poem":1},{"lineBreak":true},{"text":"Ondan güclü olanın əlindən qurtardı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onlar Sionun yüksək təpəsinə gəlib","poem":1},{"lineBreak":true},{"text":"Tərənnüm edəcək.","poem":1},{"lineBreak":true},{"text":"Rəbbin verdiyi nemətlər –","poem":1},{"lineBreak":true},{"text":"Taxıl, təzə şərab, zeytun yağı,","poem":1},{"lineBreak":true},{"text":"Qoyun-keçi, mal-qara önünə axışacaqlar.","poem":1},{"lineBreak":true},{"text":"Canları sulanmış bağça kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Bir daha taqətdən düşməyəcəklər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O zaman bakirə qız, cavan və qoca kişilər","poem":1},{"lineBreak":true},{"text":"Birlikdə rəqs edib sevinəcək,","poem":1},{"lineBreak":true},{"text":"Mən onların yasını şadlığa çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sevincə çevirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Kədərlərinə təsəlli verib","poem":1},{"lineBreak":true},{"text":"Onları sevindirəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kahinləri bol yeməklə doyduracağam,","poem":1},{"lineBreak":true},{"text":"Xalqım nemətlərimlə doyacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Ramada bir səs eşidildi,","poem":1},{"lineBreak":true},{"text":"Yas və acı fəryad səsləri!","poem":1},{"lineBreak":true},{"text":"Rəhilə uşaqları üçün ağlayır,","poem":1},{"lineBreak":true},{"text":"Təsəlli istəmir.","poem":1},{"lineBreak":true},{"text":"Çünki onlar daha yoxdur».","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Səsini ağlamaqdan,","poem":1},{"lineBreak":true},{"text":"Gözlərini yaş tökməkdən qoru,","poem":1},{"lineBreak":true},{"text":"Çünki çəkdiyin zəhmətin əvəzi veriləcək,","poem":1},{"lineBreak":true},{"text":"Xalqım düşmən ölkəsindən qayıdacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Gələcəyin üçün ümid var,","poem":1},{"lineBreak":true},{"text":"Övladların öz yurdlarına dönəcək»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bəli, Mən Efrayimin nalələrini eşitdim:","poem":1},{"lineBreak":true},{"text":"«Sən məni","poem":1},{"lineBreak":true},{"text":"Öyrədilməmiş dana kimi tərbiyələndirdin,","poem":1},{"lineBreak":true},{"text":"Mən də tərbiyə aldım.","poem":1},{"lineBreak":true},{"text":"Məni geri qaytar, qayıdım,","poem":1},{"lineBreak":true},{"text":"Çünki Allahım Rəbb Sənsən.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mən yolumdan azdıqdan sonra tövbə etdim,","poem":1},{"lineBreak":true},{"text":"Ağlım başıma gələndə əllərimi yanıma çırpdım.","poem":1},{"lineBreak":true},{"text":"Cavanlığımda etdiyim eyib işlərdən","poem":1},{"lineBreak":true},{"text":"Utandım, rüsvay oldum.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Efrayim əziz oğlum deyilmi?","poem":1},{"lineBreak":true},{"text":"Mənim razı olduğum övlad deyilmi?","poem":1},{"lineBreak":true},{"text":"Hər dəfə əleyhinə danışanda","poem":1},{"lineBreak":true},{"text":"Yenə onu yadıma salıram.","poem":1},{"lineBreak":true},{"text":"Ürəyim onun üçün sızlayır,","poem":1},{"lineBreak":true},{"text":"Ona hədsiz rəhmim gəlir»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Yol işarələri qoy,","poem":1},{"lineBreak":true},{"text":"Yol göstərən lövhələr düzəlt.","poem":1},{"lineBreak":true},{"text":"Böyük yola – getdiyin yola fikir ver.","poem":1},{"lineBreak":true},{"text":"Geri dön, ey bakirə qıza bənzəyən İsrail,","poem":1},{"lineBreak":true},{"text":"Öz şəhərlərinə qayıt!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nə vaxta qədər sərgərdan gəzəcəksən,","poem":1},{"lineBreak":true},{"text":"Ey dönük qız?","poem":1},{"lineBreak":true},{"text":"Rəbb dünyada yeni bir şey yaradacaq:","poem":1},{"lineBreak":true},{"text":"Qadın kişini qoruyacaq».","poem":1}]},{"type":"verse","number":23,"content":["İsrailin Allahı olan Ordular Rəbbi belə deyir: «Mən onların sürgün olunmuşlarını geri qaytaranda Yəhuda torpağında və onun şəhərlərində yenə belə söyləyəcəklər:",{"text":"“Ey ədalət yurdu, ey müqəddəs dağ,","poem":1},{"lineBreak":true},{"text":"Rəbb sənə xeyir-dua versin!”","poem":1}]},{"type":"verse","number":24,"content":["Xalq – əkinçilər, sürüləri ilə gəzən çobanlar Yəhudada və onun şəhərlərində birlikdə yaşayacaq."]},{"type":"verse","number":25,"content":["Çünki Mən yorğun adama su verəcəyəm, taqətsiz adamı doyduracağam»."]},{"type":"verse","number":26,"content":["Bu zaman oyanıb baxdım, yuxum şirin olmuşdu."]},{"type":"verse","number":27,"content":["Rəbb bəyan edir: «İsrail və Yəhuda torpaqlarında insan toxumu və heyvan toxumu əkəcəyim günlər yaxınlaşır."]},{"type":"verse","number":28,"content":["Kökündən çıxarıb yox edəndə, yıxıb-dağıdanda və bəla gətirəndə onlara necə nəzarət etdimsə, dirçəldib yerləşdirəndə də eləcə nəzarət edəcəyəm» Rəbb belə bəyan edir."]},{"type":"verse","number":29,"content":["«O vaxt adamlar daha “atalar kal üzüm yedi, oğulların dişi qamaşır” deməyəcək."]},{"type":"verse","number":30,"content":["Hər kəs öz təqsirinə görə öləcək. Kal üzüm yeyənin öz dişləri qamaşacaq»."]},{"type":"heading","content":["Yeni Əhd"]},{"type":"verse","number":31,"content":["Rəbb bəyan edir: «İsrail xalqı və Yəhuda xalqı ilə Yeni Əhd bağlayacağım günlər yaxınlaşır."]},{"type":"verse","number":32,"content":["Bu Əhd atalarını Misir torpağından çıxartmaq üçün əllərindən tutduğum gün onlarla bağladığım əhdə bənzəməyəcək. Onların ağası olduğum halda o əhdimi pozdular» Rəbb belə bəyan edir."]},{"type":"verse","number":33,"content":["«O günlərdən sonra İsrail xalqı ilə bağlayacağım Əhd belədir: qanunumu onların daxilinə qoyub ürəklərinə yazacağam. Mən onların Allahı, onlar da Mənim xalqım olacaq» Rəbb belə bəyan edir."]},{"type":"verse","number":34,"content":["«Bundan sonra bir kəs öz qonşusunu yaxud qardaşını “Rəbbi tanıyın” deyib öyrətməyəcək. Ona görə ki böyükdən kiçiyə qədər hamı Məni tanıyacaq. Çünki təqsirlərini bağışlayacağam, günahlarını daha yada salmayacağam» Rəbb belə bəyan edir."]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Gündüz işıq olsun deyə günəşi çıxaran,","poem":1},{"lineBreak":true},{"text":"Gecə işıq olsun deyə aya və ulduzlara qaydalar qoyan,","poem":1},{"lineBreak":true},{"text":"Dalğaları kükrəsin deyə dənizi qabardan Rəbb –","poem":1},{"lineBreak":true},{"text":"Adı Ordular Rəbbi Olan belə deyir:","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"«Əgər qoyulan bu qayda-qanunlar","poem":1},{"lineBreak":true},{"text":"Önümdən götürülərsə,","poem":1},{"lineBreak":true},{"text":"Yalnız onda İsrail nəsli əbədilik","poem":1},{"lineBreak":true},{"text":"Bir millət olmaqdan çıxar»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Əgər yuxarıda göylər ölçülə bilsə,","poem":1},{"lineBreak":true},{"text":"Aşağıda yerin təməlləri üzə çıxarıla bilsə,","poem":1},{"lineBreak":true},{"text":"Mən də onda bütün etdikləri işlərdən ötrü","poem":1},{"lineBreak":true},{"text":"Bütün İsrail nəslini rədd edərəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":38,"content":["Rəbb bəyan edir: «Xananel qülləsindən Künc darvazasına qədər şəhərin Mənim üçün yenidən tikiləcəyi günlər gəlir."]},{"type":"verse","number":39,"content":["Oradan da ölçü ipi Qarev təpəsinə doğru uzanıb Qoaya dönəcək."]},{"type":"verse","number":40,"content":["Ölülərin və küllərin atıldığı bütün vadi, Qidron vadisinə qədər uzanan tarlalar, şərqdə At darvazasının küncünədək Rəbb üçün müqəddəs olacaq. Şəhər bir daha kökündən çıxarılmayacaq, heç vaxt dağıdılmayacaq»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}