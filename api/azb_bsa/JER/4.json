{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Rəbb bəyan edir: «Ey İsrail, əgər geri qayıtsan,","poem":1},{"lineBreak":true},{"text":"Mənə tərəf qayıtsan,","poem":1},{"lineBreak":true},{"text":"İyrənc bütlərini önümdən götürsən,","poem":1},{"lineBreak":true},{"text":"Bir daha sərgərdan gəzməsən,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Həqiqət, ədalət və doğruluqla","poem":1},{"lineBreak":true},{"text":"“Var olan Rəbbə and olsun!” deyə and içsən,","poem":1},{"lineBreak":true},{"text":"O zaman millətlər","poem":1},{"lineBreak":true},{"text":"Rəbb vasitəsilə bərəkət alacaq,","poem":1},{"lineBreak":true},{"text":"Onunla öyünəcək».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki Yəhuda adamlarına və Yerusəlimə","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Özünüz üçün təzə əkin yeri şumlayın,","poem":1},{"lineBreak":true},{"text":"Ancaq tikanlar arasında əkməyin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey Yəhuda adamları və Yerusəlimdə yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Özünüzü Rəbb üçün sünnət edin,","poem":1},{"lineBreak":true},{"text":"Ürəyinizin sünnət ətini kəsin.","poem":1},{"lineBreak":true},{"text":"Yoxsa pis əməllərinizə görə","poem":1},{"lineBreak":true},{"text":"Qəzəbim od kimi püskürüb yandıracaq,","poem":1},{"lineBreak":true},{"text":"Söndürən olmayacaq.","poem":1}]},{"type":"heading","content":["Yəhudaya hücum"]},{"type":"verse","number":5,"content":[{"text":"Yəhudada elan edin,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə car çəkib deyin:","poem":1},{"lineBreak":true},{"text":"“Ölkədə şeypur çalın!”","poem":1},{"lineBreak":true},{"text":"Ucadan qışqırıb söyləyin:","poem":1},{"lineBreak":true},{"text":"“Gəlin toplanıb","poem":1},{"lineBreak":true},{"text":"Qalalı şəhərlərə girək!”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Siona qaçın” deyə bayraq qaldırın,","poem":1},{"lineBreak":true},{"text":"Qaçıb qurtulun, dayanmayın.","poem":1},{"lineBreak":true},{"text":"Çünki Mən şimaldan","poem":1},{"lineBreak":true},{"text":"Bəla və böyük qırğın gətirəcəyəm».","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aslan yuvasından çıxdı,","poem":1},{"lineBreak":true},{"text":"Millətləri məhv edən yola düşdü.","poem":1},{"lineBreak":true},{"text":"Öz yerindən çıxdı ki,","poem":1},{"lineBreak":true},{"text":"Ölkənizi viran etsin.","poem":1},{"lineBreak":true},{"text":"Şəhərləriniz yerlə yeksan olacaq,","poem":1},{"lineBreak":true},{"text":"Orada sakin qalmayacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buna görə də çul geyinin,","poem":1},{"lineBreak":true},{"text":"Yas tutub ağlayın.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin qızğın qəzəbi","poem":1},{"lineBreak":true},{"text":"Bizdən dönmədi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«O gün padşahın və başçıların","poem":1},{"lineBreak":true},{"text":"Ürəyi gedəcək» Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Kahinlər çaşacaq,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlər karıxacaq».","poem":1}]},{"type":"verse","number":10,"content":["Mən dedim: «Ah, ey Xudavənd Rəbb! Bu xalqı və Yerusəlimi tamamilə aldatdın. “Sizin üçün əmin-amanlıq olacaq” dedin, halbuki qılınc boğazımıza dirəndi»."]},{"type":"verse","number":11,"content":["O vaxt bu xalqa və Yerusəlimə deyiləcək: «Səhradakı çılpaq təpələrdən əziz xalqıma tərəf isti bir külək əsir. Bu külək dən sovurmayacaq, taxıl təmizləməyəcək."]},{"type":"verse","number":12,"content":["Mənim əmrimlə bundan da güclü bir külək əsəcək və Mən indi onlara Öz hökmümü bildirəcəyəm»."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Budur, düşmən buludlar kimi gəlir,","poem":1},{"lineBreak":true},{"text":"Onun döyüş arabaları qasırğa kimi yüksəlir,","poem":1},{"lineBreak":true},{"text":"Atları qartallardan iti gedir.","poem":1},{"lineBreak":true},{"text":"Vay halımıza! Çünki bərbad olduq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim, ürəyini pislikdən yuyub-təmizlə ki, xilas olasan.","poem":1},{"lineBreak":true},{"text":"Bəd fikirlərin nə vaxta qədər içində qalacaq?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Artıq Dandan bir səs gəlir,","poem":1},{"lineBreak":true},{"text":"Efrayimin dağlıq bölgəsindən bəd xəbər eşidilir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Millətlərə elan edin, Yerusəlimə xəbər çatdırın ki,","poem":1},{"lineBreak":true},{"text":"Uzaq bir ölkədən gələn qoşun onu mühasirəyə alacaq,","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərinin önündə nərə çəkəcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onlar tarla nəzarətçiləri kimi hər tərəfdən şəhərə doğru gəlir,","poem":1},{"lineBreak":true},{"text":"Çünki o Mənə qarşı üsyan etdi» Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"«Bunları sənin başına gətirən öz işlərin, öz əməllərindir.","poem":1},{"lineBreak":true},{"text":"Cəzanın acısı lap ürəyinə çatıb.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ah, sinəmdəki dərdim!","poem":1},{"lineBreak":true},{"text":"Əzabdan qıvrılıram.","poem":1},{"lineBreak":true},{"text":"Ah, qəlbim, qəlbim çırpınır, susa bilmirəm.","poem":1},{"lineBreak":true},{"text":"Çünki, ey canım, şeypur səsini, döyüş nərəsini eşidirəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qırğın üstünə qırğın gəlir,","poem":1},{"lineBreak":true},{"text":"Bütün ölkə xaraba qalıb.","poem":1},{"lineBreak":true},{"text":"Çadırlarım qəflətən,","poem":1},{"lineBreak":true},{"text":"Pərdələrim bir anda dağıdıldı.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nə vaxta qədər bayraq görəcəyəm,","poem":1},{"lineBreak":true},{"text":"Boru səsi eşidəcəyəm?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Həqiqətən, xalqım ağılsızdır,","poem":1},{"lineBreak":true},{"text":"Məni tanımır.","poem":1},{"lineBreak":true},{"text":"Onlar cahil övladlardır,","poem":1},{"lineBreak":true},{"text":"Dərrakələri yoxdur,","poem":1},{"lineBreak":true},{"text":"Ağılları pislik etməyə çatır,","poem":1},{"lineBreak":true},{"text":"Yaxşılıq etməyin nə olduğunu bilmirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yer üzünə baxdım,","poem":1},{"lineBreak":true},{"text":"Quruluşsuz və boşdur.","poem":1},{"lineBreak":true},{"text":"Göylərə baxdım,","poem":1},{"lineBreak":true},{"text":"İşıqları yoxdur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dağlara baxdım, titrəyirdilər,","poem":1},{"lineBreak":true},{"text":"Bütün təpələr yerlərindən qopurdu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Baxıb gördüm ki, bir adam qalmayıb,","poem":1},{"lineBreak":true},{"text":"Göydəki quşların hamısı uçub getmişdir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Baxıb gördüm ki, bəhərli torpaq","poem":1},{"lineBreak":true},{"text":"Səhraya çevrilib,","poem":1},{"lineBreak":true},{"text":"Rəbbin önündə bütün şəhərləri","poem":1},{"lineBreak":true},{"text":"Onun qızğın qəzəbi ilə dağılıb».","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bəli, Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Bütün ölkə viran olacaq,","poem":1},{"lineBreak":true},{"text":"Ancaq tam məhv olmasına yol verməyəcəyəm.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Buna görə yer yas tutacaq,","poem":1},{"lineBreak":true},{"text":"Yuxarıda göylər qaralacaq,","poem":1},{"lineBreak":true},{"text":"Çünki bunu Mən demişəm,","poem":1},{"lineBreak":true},{"text":"Fikrimdən daşınmayacağam,","poem":1},{"lineBreak":true},{"text":"Sözümdən dönməyəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bütün şəhərlərin əhalisi","poem":1},{"lineBreak":true},{"text":"Süvarilərin və oxatanların","poem":1},{"lineBreak":true},{"text":"Gurultusundan qaçacaq.","poem":1},{"lineBreak":true},{"text":"Onlar sıx meşələrə girir,","poem":1},{"lineBreak":true},{"text":"Qayalara dırmaşır.","poem":1},{"lineBreak":true},{"text":"Bütün şəhərlər tərk edilmiş,","poem":1},{"lineBreak":true},{"text":"Orada kimsə yaşamır.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Bəs sən ey viran şəhər, nə edəcəksən?","poem":1},{"lineBreak":true},{"text":"Qırmızı paltar geyinsən də,","poem":1},{"lineBreak":true},{"text":"Qızıl bəzəklər taxsan da,","poem":1},{"lineBreak":true},{"text":"Gözlərinə sürmə sürtsən də,","poem":1},{"lineBreak":true},{"text":"Əbəs yerə özünü bəzəyirsən.","poem":1},{"lineBreak":true},{"text":"Sənə oynaşların xor baxır,","poem":1},{"lineBreak":true},{"text":"Canını almaq istəyir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mən bir səs eşidirəm:","poem":1},{"lineBreak":true},{"text":"Sanki doğuş ağrısı çəkən,","poem":1},{"lineBreak":true},{"text":"Birinci dəfə doğan qadının –","poem":1},{"lineBreak":true},{"text":"Əllərini uzatmış,","poem":1},{"lineBreak":true},{"text":"Nəfəsi kəsilmiş Sion qızının səsidir.","poem":1},{"lineBreak":true},{"text":"O deyir: “Vay halıma!","poem":1},{"lineBreak":true},{"text":"Qatillərin önündə","poem":1},{"lineBreak":true},{"text":"Canım taqətdən düşdü”.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}