{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Misirin məğlub olması"]},{"type":"verse","number":1,"content":["Bu, millətlər barədə Yeremya peyğəmbərə nazil olan Rəbbin sözüdür."]},{"type":"verse","number":2,"content":["Misir haqqında, Misir padşahı firon Nekonun ordusu barədə nazil olan sözdür. Bu ordu Fərat çayı sahilində olan Karkemişdə idi. Yəhuda padşahı Yoşiya oğlu Yehoyaqimin padşahlığının dördüncü ilində Babil padşahı Navuxodonosor onu məğlub etdi."]},{"type":"verse","number":3,"content":[{"text":"«Qalxan və sipər hazırlayıb","poem":1},{"lineBreak":true},{"text":"Döyüşə girin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atlarınızı yəhərləyin,","poem":1},{"lineBreak":true},{"text":"Ayğırlarınıza minin, ey atlılar!","poem":1},{"lineBreak":true},{"text":"Dəbilqə geyinib sıraya düzülün,","poem":1},{"lineBreak":true},{"text":"Nizələrinizi itiləyib zireh geyinin!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nə üçün mən bunu gördüm?","poem":1},{"lineBreak":true},{"text":"Onlar dəhşətə düşüb geri döndü,","poem":1},{"lineBreak":true},{"text":"Döyüşçüləri məğlub oldu,","poem":1},{"lineBreak":true},{"text":"Tez qaçıb heç geriyə də baxmadı.","poem":1},{"lineBreak":true},{"text":"Hər tərəfdə dəhşət var!»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Bərk qaçan qaça bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Güclü qurtula bilməyəcək.","poem":1},{"lineBreak":true},{"text":"Şimalda Fərat çayı sahilində","poem":1},{"lineBreak":true},{"text":"Büdrəyib yıxılacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nil kimi qalxan,","poem":1},{"lineBreak":true},{"text":"Suları sel kimi çalxalanan kimdir?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nil kimi qalxan,","poem":1},{"lineBreak":true},{"text":"Suları sel kimi çalxalanan Misirdir.","poem":1},{"lineBreak":true},{"text":"O deyir: “Qalxıb yer üzünü basacağam.","poem":1},{"lineBreak":true},{"text":"Şəhərləri və orada yaşayanları həlak edəcəyəm”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey atlar, şahə qalxın!","poem":1},{"lineBreak":true},{"text":"Ey döyüş arabaları, dəli kimi cumun!","poem":1},{"lineBreak":true},{"text":"Ey qalxanla silahlanmış Kuş və Put döyüşçüləri,","poem":1},{"lineBreak":true},{"text":"Kaman götürən və onu çəkən Ludlular, irəli gedin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O gün Ordular Rəbbi Xudavəndin günüdür,","poem":1},{"lineBreak":true},{"text":"Düşmənlərindən qisas alması üçün","poem":1},{"lineBreak":true},{"text":"Qisas günüdür.","poem":1},{"lineBreak":true},{"text":"Onları qılınc yeyib-doyacaq,","poem":1},{"lineBreak":true},{"text":"Qanlarını içib susuzluğunu yatıracaq.","poem":1},{"lineBreak":true},{"text":"Çünki şimal ölkəsində, Fərat çayı sahilində","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Xudavənd qurban kəsir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey bakirə qıza bənzəyən Misir,","poem":1},{"lineBreak":true},{"text":"Gileada çıx, məlhəm al.","poem":1},{"lineBreak":true},{"text":"Çoxlu dərman içməyin əbəsdir,","poem":1},{"lineBreak":true},{"text":"Sənin dərdinə əlac yoxdur.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Millətlər sənin rüsvayçılığını eşitdi,","poem":1},{"lineBreak":true},{"text":"Fəryadın yer üzünü bürüdü.","poem":1},{"lineBreak":true},{"text":"Çünki döyüşçü döyüşçünü büdrətdi,","poem":1},{"lineBreak":true},{"text":"İkisi də birdən yıxıldı».","poem":1}]},{"type":"verse","number":13,"content":["Babil padşahı Navuxodonosorun gəlib Misir torpağına hücum edəcəyi barədə Rəbb Yeremya peyğəmbərə bu sözləri nazil etdi:"]},{"type":"verse","number":14,"content":[{"text":"«Misirdə bildirin,","poem":1},{"lineBreak":true},{"text":"Miqdolda eşitdirin,","poem":1},{"lineBreak":true},{"text":"Nofda və Taxpanxesdə elan edib deyin:","poem":1},{"lineBreak":true},{"text":"“Qalx və hazırlaş,","poem":1},{"lineBreak":true},{"text":"Çünki ətrafında olanları","poem":1},{"lineBreak":true},{"text":"Qılınc yeyib-qurtardı”.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cəngavərlərin nə üçün yerə yıxıldı,","poem":1},{"lineBreak":true},{"text":"Dayana bilmədi?","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb onu yerə vurdu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dəfələrlə büdrədilər,","poem":1},{"lineBreak":true},{"text":"Bir-birlərinin üstünə yıxılıb dedilər:","poem":1},{"lineBreak":true},{"text":"“Qalxın zalımların qılıncından qaçıb","poem":1},{"lineBreak":true},{"text":"Öz xalqımızın yanına,","poem":1},{"lineBreak":true},{"text":"Doğma vətənimizə qayıdaq”.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Orada onlar bağırdılar:","poem":1},{"lineBreak":true},{"text":"“Misir padşahı firon boşboğazdır,","poem":1},{"lineBreak":true},{"text":"O, fürsəti əldən verdi”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Adı Ordular Rəbbi olan Padşah bəyan edir:","poem":1},{"lineBreak":true},{"text":"“Varlığıma and olsun ki,","poem":1},{"lineBreak":true},{"text":"Tavor və dəniz sahilindəki Karmel dağları","poem":1},{"lineBreak":true},{"text":"Dağlar arasında necə nəzərə çarparsa,","poem":1},{"lineBreak":true},{"text":"Gələn şəxs də elə olacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ey Misirdə yaşayan,","poem":1},{"lineBreak":true},{"text":"Sürgünə getmək üçün əşyalarını hazırla.","poem":1},{"lineBreak":true},{"text":"Çünki Nof viran olub yanacaq,","poem":1},{"lineBreak":true},{"text":"İçində bir sakin qalmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Misir çox gözəl bir düyədir,","poem":1},{"lineBreak":true},{"text":"Ancaq şimaldan üstünə mozalan gəlir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onun muzdlu əsgərləri də","poem":1},{"lineBreak":true},{"text":"Bəslənmiş dana kimidir.","poem":1},{"lineBreak":true},{"text":"Onlar üz çevirib birlikdə qaçdı,","poem":1},{"lineBreak":true},{"text":"Yerlərində durmadı.","poem":1},{"lineBreak":true},{"text":"Çünki fəlakətlərinin günü,","poem":1},{"lineBreak":true},{"text":"Cəzalarının vaxtı gəlmişdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sürünən ilan kimi fışıltıları gəlir,","poem":1},{"lineBreak":true},{"text":"Çünki ordu ilə irəliləyirlər,","poem":1},{"lineBreak":true},{"text":"Ağac kəsənlər kimi ona qarşı","poem":1},{"lineBreak":true},{"text":"Balta ilə gəlirlər.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Keçilməz olsa da,","poem":1},{"lineBreak":true},{"text":"Yenə meşəni kəsəcəklər”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"“Çünki onlar çəyirtkələrdən çoxdur,","poem":1},{"lineBreak":true},{"text":"Hesaba gəlməzlər.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Misir utandırılacaq,","poem":1},{"lineBreak":true},{"text":"Şimal xalqına təslim ediləcək”.","poem":1}]},{"type":"verse","number":25,"content":["İsrailin Allahı olan Ordular Rəbbi deyir: “Mən No şəhərinin allahı Amonu, fironu, Misiri, onun allahlarını, padşahlarını və firona güvənənləri cəzalandıracağam."]},{"type":"verse","number":26,"content":["Canlarını almaq istəyənlərə – Babil padşahı Navuxodonosora və onun əyanlarına təslim edəcəyəm. Ancaq sonra əvvəllər olduğu kimi adamlar yenə Misirdə yaşayacaq” Rəbb belə bəyan edir."]},{"type":"heading","content":["Rəbbin Öz xalqına vədi"]},{"type":"verse","number":27,"content":[{"text":"“Qorxma, ey qulum Yaqub,","poem":1},{"lineBreak":true},{"text":"Dəhşətə düşmə, ey İsrail.","poem":1},{"lineBreak":true},{"text":"Çünki səni uzaq yerlərdən,","poem":1},{"lineBreak":true},{"text":"Nəslini sürgün olunduğu ölkədən qurtaracağam.","poem":1},{"lineBreak":true},{"text":"Yaqub geri qayıdacaq,","poem":1},{"lineBreak":true},{"text":"Rahatlıq tapıb qayğısız olacaq,","poem":1},{"lineBreak":true},{"text":"Onu qorxudan olmayacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Qorxma, ey qulum Yaqub,","poem":1},{"lineBreak":true},{"text":"Çünki Mən səninləyəm”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"“Səni aralarına sürgün etdiyim","poem":1},{"lineBreak":true},{"text":"Millətlərin hamısını yox etsəm də,","poem":1},{"lineBreak":true},{"text":"Səni tamamilə məhv etməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ədalətlə tərbiyələndirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Amma cəzasız qoymayacağam”».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}