{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Filiştlilər barədə vəhy"]},{"type":"verse","number":1,"content":["Firon Qəzzəyə hücum etməzdən əvvəl Yeremya peyğəmbərə Filiştlilər barədə Rəbbin bu sözü nazil oldu:"]},{"type":"verse","number":2,"content":[{"text":"«Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"“Budur, şimaldan sular qalxır,","poem":1},{"lineBreak":true},{"text":"Onlar sel kimi daşacaq,","poem":1},{"lineBreak":true},{"text":"Ölkənin və oradakı hər şeyin,","poem":1},{"lineBreak":true},{"text":"Şəhərin və orada yaşayanların üstünə axacaq.","poem":1},{"lineBreak":true},{"text":"İnsanlar fəryad edəcək,","poem":1},{"lineBreak":true},{"text":"O ölkədə yaşayanların hamısı nalə çəkəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayğırlarının yeri döyən dırnaqlarının səsindən,","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarının vəlvələsindən,","poem":1},{"lineBreak":true},{"text":"Təkərlərinin gurultusundan","poem":1},{"lineBreak":true},{"text":"Əlləri taqətdən düşdüyü üçün","poem":1},{"lineBreak":true},{"text":"Atalar dönüb oğullarına baxmır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Filiştlilərin məhv ediləcəyi gün gəlir.","poem":1},{"lineBreak":true},{"text":"Sur və Sidona yardım edə bilən,","poem":1},{"lineBreak":true},{"text":"Sağ qalan hər kəs yox ediləcək.","poem":1},{"lineBreak":true},{"text":"Rəbb Kaftor sahilindən gələn","poem":1},{"noteId":13},{"lineBreak":true},{"text":"Filiştlilərin sağ qalanlarını həlak edəcək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qəzzə saçını yolacaq,","poem":1},{"lineBreak":true},{"text":"Aşqelon susdurulacaq.","poem":1},{"lineBreak":true},{"text":"Ey düzənliklərində sağ qalanlar,","poem":1},{"lineBreak":true},{"text":"Nə vaxta qədər bədənlərinizi yaralayacaqsınız?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"‹Ey Rəbbin qılıncı,","poem":1},{"lineBreak":true},{"text":"Nə vaxt sakitləşəcəksən?","poem":1},{"lineBreak":true},{"text":"Qınına dön, dayan və sakit ol!› deyəcəksiniz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb əmr etdiyi halda","poem":1},{"lineBreak":true},{"text":"Qılınc necə susa bilər?","poem":1},{"lineBreak":true},{"text":"Rəbb onu oraya – Aşqelona,","poem":1},{"lineBreak":true},{"text":"Dəniz sahilinə qarşı göndərdi”».","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Kaftor – indiki Krit adası.","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/azb_bsa/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}