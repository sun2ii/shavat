{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Moav barədə vəhy"]},{"type":"verse","number":1,"content":["Moav barədə İsrailin Allahı olan Ordular Rəbbi belə deyir:",{"text":"«Vay Nevonun halına!","poem":1},{"lineBreak":true},{"text":"Çünki viranəliyə çevriləcək.","poem":1},{"lineBreak":true},{"text":"Qiryatayim dağılacaq,","poem":1},{"lineBreak":true},{"text":"Ələ keçiriləcək.","poem":1},{"lineBreak":true},{"text":"Qalası dağılacaq,","poem":1},{"lineBreak":true},{"text":"Darmadağın olacaq.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Artıq Moavın şöhrəti qalmayıb.","poem":1},{"lineBreak":true},{"text":"Xeşbonda","poem":1},{"noteId":14},{"text":"onun məhvi üçün niyyət qururlar:","poem":1},{"lineBreak":true},{"text":"“Gəlin onu yox edək ki,","poem":1},{"lineBreak":true},{"text":"Daha bir də belə millət olmasın”.","poem":1},{"lineBreak":true},{"text":"Ey Madmen,","poem":1},{"noteId":15},{"text":"sən də susdurulacaqsan,","poem":1},{"lineBreak":true},{"text":"Qılınc səni qovacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xoronayimdən fəryad səsi gələcək:","poem":1},{"lineBreak":true},{"text":"“Şəhər dağıldı və böyük qırğın oldu!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moav dağıdıldı,","poem":1},{"lineBreak":true},{"text":"Övladlarının fəryadı ucaldı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ağlaya-ağlaya","poem":1},{"lineBreak":true},{"text":"Luxit yoxuşundan çıxırlar,","poem":1},{"lineBreak":true},{"text":"Çünki Xoronayim enişində","poem":1},{"lineBreak":true},{"text":"Qırğına görə acı fəryadlar eşidilir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qaçın, canınızı qurtarın!","poem":1},{"lineBreak":true},{"text":"Çöldəki yulğun ağacı kimi az-az görünün.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Öz istehkamlarına və mal-dövlətinə güvəndiyin üçün","poem":1},{"lineBreak":true},{"text":"Sən də ələ keçiriləcəksən.","poem":1},{"lineBreak":true},{"text":"Allahın Kemoş da kahinləri və başçıları ilə birlikdə","poem":1},{"lineBreak":true},{"text":"Sürgün ediləcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbbin söylədiyi kimi","poem":1},{"lineBreak":true},{"text":"Məhv edən hər şəhərin üstünə gələcək,","poem":1},{"lineBreak":true},{"text":"Heç bir şəhər qurtulmayacaq.","poem":1},{"lineBreak":true},{"text":"Vadi yerlə yeksan olacaq,","poem":1},{"lineBreak":true},{"text":"Yayla viran ediləcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moav torpağına duz tökün ki,","poem":1},{"lineBreak":true},{"text":"Bərəkətsiz olsun.","poem":1},{"lineBreak":true},{"text":"Şəhərləri elə viran olacaq ki,","poem":1},{"lineBreak":true},{"text":"Orada kimsə yaşamayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbbin işini yarımçıq görənə","poem":1},{"lineBreak":true},{"text":"Lənət olsun!","poem":1},{"lineBreak":true},{"text":"Qılıncını qan tökməkdən saxlayana","poem":1},{"lineBreak":true},{"text":"Lənət olsun!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moav cavanlığından bəri qayğısız idi.","poem":1},{"lineBreak":true},{"text":"Tortası dibdə qalan şəraba oxşayırdı.","poem":1},{"lineBreak":true},{"text":"Qabdan qaba boşaldılmadı,","poem":1},{"lineBreak":true},{"text":"Sürgünə getmədi.","poem":1},{"lineBreak":true},{"text":"Buna görə də dadını dəyişmədi,","poem":1},{"lineBreak":true},{"text":"Ətrini itirmədi.","poem":1}]},{"type":"verse","number":12,"content":["Ancaq onu qabdan qaba tökəcək adamları göndərəcəyim günlər gəlir» Rəbb belə bəyan edir. «Bəli, onu tökəcəklər, qablarını boşaldacaqlar, küplərini parça-parça edəcəklər."]},{"type":"verse","number":13,"content":["İsrail xalqı güvəndiyi Bet-Eldən necə utandısa, Moav da allahı Kemoşdan eləcə utanacaq."]},{"type":"verse","number":14,"content":[{"text":"Nə üçün “biz igidik,","poem":1},{"lineBreak":true},{"text":"Döyüşə qabil əsgərlərik” deyirsiniz?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moav məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Onun şəhərlərinə hücum edəcəklər.","poem":1},{"lineBreak":true},{"text":"Ən seçmə döyüşçüləri öldürülməyə gedəcək»","poem":1},{"lineBreak":true},{"text":"Adı Ordular Rəbbi olan Padşah bunu bəyan edir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Moavın fəlakəti gəlmək üzrədir,","poem":1},{"lineBreak":true},{"text":"Onun bəlası sürətlə yaxınlaşır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ey onun ətrafında olanlar,","poem":1},{"lineBreak":true},{"text":"Onun adını bilənlər,","poem":1},{"lineBreak":true},{"text":"Onun üçün yas tutub deyin:","poem":1},{"lineBreak":true},{"text":"“Qüdrətli əsa, əzəmətli dəyənək","poem":1},{"lineBreak":true},{"text":"Necə də qırıldı!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ey qıza bənzəyən Divonun sakini,","poem":1},{"lineBreak":true},{"text":"Cah-calalından düş,","poem":1},{"lineBreak":true},{"text":"Susuz yerdə otur.","poem":1},{"lineBreak":true},{"text":"Çünki Moavı məhv edən","poem":1},{"lineBreak":true},{"text":"Sənin də üstünə gələcək,","poem":1},{"lineBreak":true},{"text":"Qalalarını dağıdacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ey Aroer sakini,","poem":1},{"lineBreak":true},{"text":"Yol kənarında durub gözlə!","poem":1},{"lineBreak":true},{"text":"Qaçan kişidən, qurtulan qadından","poem":1},{"lineBreak":true},{"text":"“Nə olub?” deyə soruş.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Moav alçaldıldı,","poem":1},{"lineBreak":true},{"text":"Çünki dağıldı.","poem":1},{"lineBreak":true},{"text":"Fəryad et, bağır!","poem":1},{"lineBreak":true},{"text":"Moavın məhv olduğunu","poem":1},{"lineBreak":true},{"text":"Arnon vadisində bildir.","poem":1}]},{"type":"verse","number":21,"content":["Yayladakı şəhərlər – Xolon, Yahsa, Mefaat,"]},{"type":"verse","number":22,"content":["Divon, Nevo, Bet-Divlatayim,"]},{"type":"verse","number":23,"content":["Qiryatayim, Bet-Qamul, Bet-Meon,"]},{"type":"verse","number":24,"content":["Qeriyot, Bosra – uzaq və yaxın bütün Moav şəhərləri məhkum oldu."]},{"type":"verse","number":25,"content":["Moavın buynuzu kəsildi, qolu qırıldı» Rəbb belə bəyan edir."]},{"type":"verse","number":26,"content":["«Moavı sərxoş edin, çünki Rəbbin qarşısında qürurlandı. Moav öz qusduğuna bələnəcək, masqaraya çevriləcək."]},{"type":"verse","number":27,"content":["Bəs İsrail sənə masqara olmadımı? Məgər o, oğrular arasında tutuldu ki, ondan danışanda həqarətlə başını yelləyirsən?"]},{"type":"verse","number":28,"content":[{"text":"Ey Moav sakinləri,","poem":1},{"lineBreak":true},{"text":"Şəhərlərinizi tərk edib","poem":1},{"lineBreak":true},{"text":"Qayalara sığının.","poem":1},{"lineBreak":true},{"text":"Yuvasını uçurumun ağzında quran","poem":1},{"lineBreak":true},{"text":"Göyərçin kimi olun.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Moavın qüruru, onun hədsiz məğrurluğu,","poem":1},{"lineBreak":true},{"text":"Təkəbbürü, təşəxxüsü, lovğalığı,","poem":1},{"lineBreak":true},{"text":"Özünü yüksək tutması barədə biz eşitmişdik.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Azğınlığını bilirəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Öyünməsi də boş şeydir, etdikləri də.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Buna görə də Moav üçün nalə çəkəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün Moav üçün fəryad edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qir-Xeres xalqı üçün yas tutacağam.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ey Sivma tənəyi,","poem":1},{"lineBreak":true},{"text":"Sənin üçün Yazer xalqından çox ağlayacağam.","poem":1},{"lineBreak":true},{"text":"Budaqların dənizi aşdı,","poem":1},{"lineBreak":true},{"text":"Yazer dənizinə uzandı.","poem":1},{"lineBreak":true},{"text":"Məhv edən sənin yay meyvələrinin,","poem":1},{"lineBreak":true},{"text":"Yetişmiş üzümünün üstünə atıldı.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Moavın meyvə bağlarından, tarlalarından","poem":1},{"lineBreak":true},{"text":"Sevinc və fərəh götürüldü.","poem":1},{"lineBreak":true},{"text":"Üzümsıxanlardan axan şərabı kəsdim.","poem":1},{"lineBreak":true},{"text":"Heç kəs sevinc nidası ilə üzüm əzmir.","poem":1},{"lineBreak":true},{"text":"Gələn səda sevinc nidası deyil.","poem":1}]},{"type":"verse","number":34,"content":["Xeşbonun fəryadı Elaleyə qədər eşidilir. Yahsaya qədər, Soardan Xoronayimə, Eqlat-Şelişiyaya qədər səslərini ucaltdılar. Çünki Nimrim suları da qurudu."]},{"type":"verse","number":35,"content":["Moavda səcdəgahlarda qurban gətirənləri, öz allahlarına buxur yandıranları məhv edəcəyəm» Rəbb belə bəyan edir."]},{"type":"verse","number":36,"content":["«Buna görə də Moav üçün ürəyim ney kimi inləyir. Qir-Xeres xalqı üçün ürəyim ney kimi inləyir. Çünki əldə etdiyi mal-dövlət yox oldu."]},{"type":"verse","number":37,"content":["Hər kəs saçını, saqqalını kəsəcək, əlini yaralayacaq, belinə çul sarıyacaq."]},{"type":"verse","number":38,"content":["Moav damlarından, meydanlarından yalnız ağlaşma səsi gəlir. Çünki Moavı heç kəsin bəyənmədiyi bir qab kimi qırdım» Rəbb belə bəyan edir."]},{"type":"verse","number":39,"content":["«Moav necə viran oldu! Necə də fəryad edirlər! Moav xəcalətdən arxaya dönür. Bütün ətrafındakılar üçün rişxənd və dəhşət nümunəsi oldu»."]},{"type":"verse","number":40,"content":["Rəbb belə deyir:",{"text":"«Bax düşmən qartal kimi uçub","poem":1},{"lineBreak":true},{"text":"Moav üzərində qanadlarını gərəcək.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Qeriyot ələ keçiriləcək,","poem":1},{"lineBreak":true},{"text":"Qalalar alınacaq.","poem":1},{"lineBreak":true},{"text":"O gün Moav döyüşçülərinin ürəyi","poem":1},{"lineBreak":true},{"text":"Doğuş ağrısı çəkən qadının ürəyi kimi olacaq.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Moav viran olacaq,","poem":1},{"lineBreak":true},{"text":"Xalqlar arasından silinəcək.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb qarşısında qürurlandı.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ey Moav sakinləri,","poem":1},{"lineBreak":true},{"text":"Qarşınıza dəhşət, dərin çuxur və tələ çıxacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"«Dəhşətdən qaçan dərin çuxura düşəcək,","poem":1},{"lineBreak":true},{"text":"Dərin çuxurdan çıxa bilən tələyə düşəcək.","poem":1},{"lineBreak":true},{"text":"Çünki Moavın üzərinə","poem":1},{"lineBreak":true},{"text":"Cəza ilini gətirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"«Xeşbonun kölgəsində","poem":1},{"lineBreak":true},{"text":"Qaçqınlar taqətsiz durmuşlar.","poem":1},{"lineBreak":true},{"text":"Çünki Xeşbondan od,","poem":1},{"lineBreak":true},{"text":"Sixonun ortasından alov çıxdı.","poem":1},{"lineBreak":true},{"text":"Moavın alnını,","poem":1},{"lineBreak":true},{"text":"Hər yana səs salanların başlarını","poem":1},{"lineBreak":true},{"text":"Yandırıb-yaxdı.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Vay halına, ey Moav!","poem":1},{"lineBreak":true},{"text":"Kemoşun xalqı yox oldu.","poem":1},{"lineBreak":true},{"text":"Oğulların sürgünə göndərildi,","poem":1},{"lineBreak":true},{"text":"Qızların əsir alındı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Ancaq gələcəkdə","poem":1},{"lineBreak":true},{"text":"Moavdan sürgün olunanları geri qaytaracağam»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"Moav barədəki hökm burada sona çatır.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Xeşbon – ibrani dilində niyyət qurmaq sözünə oxşayır.","reference":{"chapter":48,"verse":2}},{"noteId":15,"caller":"+","text":"Madmen – ibrani dilində susdurmaq sözünə oxşayır.","reference":{"chapter":48,"verse":2}}]},"thisChapterLink":"/api/azb_bsa/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}