{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Ammon barədə vəhy"]},{"type":"verse","number":1,"content":["Ammon övladları barədə Rəbb belə deyir:",{"text":"«İsrailin övladları yoxmu?","poem":1},{"lineBreak":true},{"text":"Onun varisi yoxmu?","poem":1},{"lineBreak":true},{"text":"Elə isə nə üçün Milkom Qada sahib oldu?","poem":1},{"lineBreak":true},{"text":"Niyə onun xalqı Qad şəhərlərində yaşayır?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bu səbəbdən də o günlər gəlir ki,","poem":1},{"lineBreak":true},{"text":"Ammon övladlarının Rabba şəhərinə","poem":1},{"lineBreak":true},{"text":"Döyüş nərələri eşitdirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Rabba bir xarabalıq qalağı olacaq,","poem":1},{"lineBreak":true},{"text":"Qəsəbələri yandırılacaq.","poem":1},{"lineBreak":true},{"text":"Beləcə İsrail onu torpağından qovanları qovacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Nalə çək, ey Xeşbon,","poem":1},{"lineBreak":true},{"text":"Çünki Ay şəhəri viran oldu.","poem":1},{"lineBreak":true},{"text":"Fəryad edin, ey Rabba qızları,","poem":1},{"lineBreak":true},{"text":"Çula bürünüb yas tutun.","poem":1},{"lineBreak":true},{"text":"Divarlar arasında ora-bura qaçın.","poem":1},{"lineBreak":true},{"text":"Çünki Milkom kahinləri və başçıları ilə birlikdə","poem":1},{"lineBreak":true},{"text":"Sürgünə gedəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vadilərlə nə üçün öyünürsən?","poem":1},{"lineBreak":true},{"text":"Taqətin kəsilir,","poem":1},{"lineBreak":true},{"text":"Ey dönük qız!","poem":1},{"lineBreak":true},{"text":"Sən mal-dövlətinə güvənərək","poem":1},{"lineBreak":true},{"text":"“Üstümə kim gələ bilər” deyirdin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ətrafında olanların hamısından","poem":1},{"lineBreak":true},{"text":"Sənin üzərinə dəhşət gətirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Xudavənd belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Hamı o yan-bu yana qaçacaq,","poem":1},{"lineBreak":true},{"text":"Qaçanları toplayan olmayacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ancaq bundan sonra sürgün olunan","poem":1},{"lineBreak":true},{"text":"Ammon övladlarını geri qaytaracağam»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"heading","content":["Edom barədə vəhy"]},{"type":"verse","number":7,"content":[{"text":"Edom barədə Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Teman şəhərində müdriklik qalmadımı?","poem":1},{"lineBreak":true},{"text":"Ağıllı adamların nəsihəti tükəndimi?","poem":1},{"lineBreak":true},{"text":"Onların müdrikliyi söndümü?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qaçın, arxaya dönün,","poem":1},{"lineBreak":true},{"text":"Dərin mağaralarda gizlənin,","poem":1},{"lineBreak":true},{"text":"Ey Dedanda yaşayanlar!","poem":1},{"lineBreak":true},{"text":"Çünki Esavı cəzalandırdığım vaxt","poem":1},{"lineBreak":true},{"text":"Başına fəlakət gətirəcəyəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Əgər üzüm yığanlar sənin bağına gəlsəydi,","poem":1},{"lineBreak":true},{"text":"Bir neçə salxımı saxlamazdılarmı?","poem":1},{"lineBreak":true},{"text":"Gecə oğrular gəlsəydi,","poem":1},{"lineBreak":true},{"text":"Yalnız istədiklərini oğurlamazdılarmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amma mən Esavı çıl-çılpaq soyunduracağam.","poem":1},{"lineBreak":true},{"text":"Onun gizli yerlərini aşkar edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Özü də gizlənə bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Övladları, qohum-qonşuları həlak olacaq,","poem":1},{"lineBreak":true},{"text":"Özü də məhv olacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Öz yetimlərini burax,","poem":1},{"lineBreak":true},{"text":"Onları Mən yaşadaram.","poem":1},{"lineBreak":true},{"text":"Dul qadınların da Mənə güvənsin».","poem":1}]},{"type":"verse","number":12,"content":["Rəbb belə deyir: «Layiq olmayanlar da cəza kasası içmək məcburiyyətində ikən sənmi cəzasız qalacaqsan? Yox, cəzasız qalmayacaqsan, mütləq bu kasadan içəcəksən»."]},{"type":"verse","number":13,"content":["Rəbb bəyan edir: «Adım naminə and içirəm ki, Bosra xarabalığa çevriləcək, dəhşət, rüsvayçılıq, viranəlik və lənətə düçar olacaq. Bütün şəhərləri əbədi olaraq viran qalacaq."]},{"type":"verse","number":14,"content":[{"text":"Rəbdən bir xəbər eşitdim:","poem":1},{"lineBreak":true},{"text":"Millətlər arasına göndərdiyi qasid","poem":1},{"lineBreak":true},{"text":"“Edoma hücum etmək üçün yığılıb","poem":1},{"lineBreak":true},{"text":"Döyüşə hazırlaşın!” deyir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bax səni millətlər arasında kiçildəcəyəm,","poem":1},{"lineBreak":true},{"text":"İnsanlar sənə xor baxacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ey sən qaya","poem":1},{"noteId":16},{"text":"çatları arasında məskən salan,","poem":1},{"lineBreak":true},{"text":"Təpələrin başını əldə saxlayan!","poem":1},{"lineBreak":true},{"text":"Saldığın dəhşət və ürəyinin qüruru səni aldatdı.","poem":1},{"lineBreak":true},{"text":"Yuvanı qartal kimi yuxarılarda qursan da,","poem":1},{"lineBreak":true},{"text":"Səni oradan endirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Edom dəhşət hədəfi olacaq,","poem":1},{"lineBreak":true},{"text":"Oradan keçən hər kəs","poem":1},{"lineBreak":true},{"text":"Bütün yaralarından ötrü","poem":1},{"lineBreak":true},{"text":"Heyrət içində ona fit çalacaq».","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Sodomla Homorranı və ətrafındakı kəndləri","poem":1},{"lineBreak":true},{"text":"Necə dağıtdımsa,","poem":1},{"lineBreak":true},{"text":"Orada da kimsə yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"O yerdə bəşər oğlu sakin olmayacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Budur, aslan İordan çayının kənarındakı sıx meşədən","poem":1},{"lineBreak":true},{"text":"Yaxşı sulanan otlağa qalxdığı kimi","poem":1},{"lineBreak":true},{"text":"Mən də Edomluları bir anda öz yurdundan qovacağam.","poem":1},{"lineBreak":true},{"text":"Seçib ona rəhbər qoyacağım adam kimdir?","poem":1},{"lineBreak":true},{"text":"Mənim kimisi varmı?","poem":1},{"lineBreak":true},{"text":"Mənimlə dava edən,","poem":1},{"lineBreak":true},{"text":"Mənim qabağımda duran bir çoban varmı?»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Buna görə də Rəbbin Edoma qarşı fikrini,","poem":1},{"lineBreak":true},{"text":"Temanda yaşayanlara qarşı məqsədini eşidin:","poem":1},{"lineBreak":true},{"text":"Sürünün ən kiçikləri də sürgün ediləcək,","poem":1},{"lineBreak":true},{"text":"Xalqına görə Edom otlaqları","poem":1},{"lineBreak":true},{"text":"Səhraya çevriləcək.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dağılmalarının gurultusundan","poem":1},{"lineBreak":true},{"text":"Yer üzü titrəyəcək.","poem":1},{"lineBreak":true},{"text":"Qışqırıqlarının səsi","poem":1},{"lineBreak":true},{"text":"Qırmızı dənizədək eşidiləcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Düşmən qartal kimi qalxıb üstünə cumacaq,","poem":1},{"lineBreak":true},{"text":"Bosra üzərində qanadlarını gərəcək.","poem":1},{"lineBreak":true},{"text":"O gün Edom döyüşçülərinin ürəyi","poem":1},{"lineBreak":true},{"text":"Doğuş ağrısı çəkən qadının ürəyi kimi olacaq.","poem":1}]},{"type":"heading","content":["Dəməşq barədə vəhy"]},{"type":"verse","number":23,"content":[{"text":"Bu sözlər Dəməşq barədədir:","poem":1},{"lineBreak":true},{"text":"«Xamat və Arpad utanacaq,","poem":1},{"lineBreak":true},{"text":"Çünki pis xəbər eşidib","poem":1},{"lineBreak":true},{"text":"Ruhdan düşdülər.","poem":1},{"lineBreak":true},{"text":"Sakit durmayan dəniz kimi","poem":1},{"lineBreak":true},{"text":"Coşub narahat oldular.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dəməşq əldən düşdü,","poem":1},{"lineBreak":true},{"text":"Qaçmağa üz qoydu,","poem":1},{"lineBreak":true},{"text":"Onu vahimə bürüdü.","poem":1},{"lineBreak":true},{"text":"Doğan qadın kimi","poem":1},{"lineBreak":true},{"text":"Onu sancı və ağrı tutdu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Necə oldu ki, Məni sevindirən,","poem":1},{"lineBreak":true},{"text":"Şöhrətli şəhər tərk edilmədi?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Buna görə də cavanları","poem":1},{"lineBreak":true},{"text":"Meydanlarında həlak olacaq.","poem":1},{"lineBreak":true},{"text":"O gün bütün döyüşçüləri susdurulacaq»","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi belə bəyan edir.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"«Dəməşqin divarlarına od salacağam,","poem":1},{"lineBreak":true},{"text":"Ben-Hadadın saraylarını yandırıb məhv edəcək».","poem":1}]},{"type":"heading","content":["Qedar və Xasor barədə vəhy"]},{"type":"verse","number":28,"content":["Babil padşahı Navuxodonosorun məğlub etdiyi Qedar və Xasor padşahlıqları barədə Rəbb belə deyir:",{"text":"«Qalxın Qedara hücum edin,","poem":1},{"lineBreak":true},{"text":"Şərq xalqını məhv edin.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Onların çadırlarını və sürülərini","poem":1},{"lineBreak":true},{"text":"Əllərindən alacaqlar,","poem":1},{"lineBreak":true},{"text":"Çadır pərdələri, bütün əşyaları və dəvələri","poem":1},{"lineBreak":true},{"text":"Götürülüb aparılacaq.","poem":1},{"lineBreak":true},{"text":"Onlara “Hər tərəfdən dəhşət!”","poem":1},{"lineBreak":true},{"text":"Deyib bağıracaqlar.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ey Xasorda yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Qaçın, uzaqlaşın,","poem":1},{"lineBreak":true},{"text":"Dərin mağaralarda gizlənin»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Çünki Babil padşahı Navuxodonosor","poem":1},{"lineBreak":true},{"text":"Sizin barənizdə bir fikrə gəldi,","poem":1},{"lineBreak":true},{"text":"Sizə qarşı tədbir tökdü.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Qalxın qayğısız və asayiş içində yaşayan","poem":1},{"lineBreak":true},{"text":"Xalqın üzərinə hücum edin»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Onların şəhər darvazaları və sürgüləri yoxdur,","poem":1},{"lineBreak":true},{"text":"Xalqı da özbaşına buraxılıb.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Dəvələri qarət ediləcək,","poem":1},{"lineBreak":true},{"text":"Saysız sürüləri qənimət kimi aparılacaq.","poem":1},{"lineBreak":true},{"text":"Kəkillərini qırxanları","poem":1},{"lineBreak":true},{"text":"Dörd tərəfə səpələyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Hər yandan başlarına fəlakət gətirəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"«Xasor çaqqal yuvasına,","poem":1},{"lineBreak":true},{"text":"Əbədi viranəliyə çevriləcək.","poem":1},{"lineBreak":true},{"text":"Orada kimsə yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"O yerdə bəşər oğlu sakin olmayacaq».","poem":1}]},{"type":"heading","content":["Elam barədə vəhy"]},{"type":"verse","number":34,"content":["Yəhuda padşahı Sidqiyanın padşahlığının əvvəlində Rəbb Yeremya peyğəmbərə Elam barədə bu sözləri nazil etdi:"]},{"type":"verse","number":35,"content":[{"text":"«Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"“Baxın Elamın kamanını,","poem":1},{"lineBreak":true},{"text":"Əsas qüvvələrini sındıracağam.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Elam üzərinə göylərin hər tərəfindən","poem":1},{"lineBreak":true},{"text":"Dörd küləyi gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Xalqını dörd tərəfə səpələyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Elamdan sürgün olunanların","poem":1},{"lineBreak":true},{"text":"Aralarına getmədiyi bir millət qalmayacaq.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Düşmənlərinin qarşısında,","poem":1},{"lineBreak":true},{"text":"Canını almaq istəyənlərin önündə","poem":1},{"lineBreak":true},{"text":"Elamı dəhşətə salacağam.","poem":1},{"lineBreak":true},{"text":"Başlarına fəlakət gətirib","poem":1},{"lineBreak":true},{"text":"Şiddətli qəzəbimi yağdıracağam”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"“Onları tamamilə yox edənə qədər","poem":1},{"lineBreak":true},{"text":"Arxalarınca qılınc göndərəcəyəm.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Elamda taxtımı quracaq,","poem":1},{"lineBreak":true},{"text":"Elam padşahı ilə başçılarını məhv edəcəyəm”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"“Ancaq gələcəkdə","poem":1},{"lineBreak":true},{"text":"Elamdan sürgün olunanları geri qaytaracağam”","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir».","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Qaya – ibrani mətnində sela. Sela Edomun paytaxtı idi.","reference":{"chapter":49,"verse":16}}]},"thisChapterLink":"/api/azb_bsa/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}