{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Yerusəlimin günahı"]},{"type":"verse","number":1,"content":[{"text":"Yerusəlimin küçələrini dolaşın,","poem":1},{"lineBreak":true},{"text":"Ətrafa baxıb fikirləşin,","poem":1},{"lineBreak":true},{"text":"Onun meydanlarını axtarın.","poem":1},{"lineBreak":true},{"text":"Əgər bir nəfər düz iş görən,","poem":1},{"lineBreak":true},{"text":"Həqiqət axtaran adam tapsanız,","poem":1},{"lineBreak":true},{"text":"Mən şəhəri bağışlayaram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar “var olan Allaha and olsun” desələr də,","poem":1},{"lineBreak":true},{"text":"Yalandan and içirlər».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, gözlərin həqiqətə tərəf yönəlməyibmi?","poem":1},{"lineBreak":true},{"text":"Sən onları vurdun,","poem":1},{"lineBreak":true},{"text":"Ancaq ağrı hiss etmədilər.","poem":1},{"lineBreak":true},{"text":"Sən onları qırdın,","poem":1},{"lineBreak":true},{"text":"Ancaq ibrət götürmədilər.","poem":1},{"lineBreak":true},{"text":"Üzləri qayadan bərk olub,","poem":1},{"lineBreak":true},{"text":"Dönmək istəmədilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mən dedim: «Bunlar ancaq yoxsul, ağılsız avamlardır,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin yolunu,","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahının hökmlərini bilmirlər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qoy mən böyüklərin yanına gedib","poem":1},{"lineBreak":true},{"text":"Onlarla danışım,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin yolunu,","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahının hökmlərini bilirlər».","poem":1},{"lineBreak":true},{"text":"Ancaq onlar da boyunduruğu sındırıb","poem":1},{"lineBreak":true},{"text":"İpləri qopardılar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna görə də meşədən bir aslan çıxıb","poem":1},{"lineBreak":true},{"text":"Onları öldürəcək,","poem":1},{"lineBreak":true},{"text":"Səhradan qurd gəlib onları parçalayacaq,","poem":1},{"lineBreak":true},{"text":"Şəhər kənarında bəbir pusqu quracaq,","poem":1},{"lineBreak":true},{"text":"Şəhərdən çıxan hər adam parçalanacaq.","poem":1},{"lineBreak":true},{"text":"Çünki çox üsyan etdilər,","poem":1},{"lineBreak":true},{"text":"Dəfələrlə dönük oldular.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Buna görə səni necə bağışlaya bilərəm?","poem":1},{"lineBreak":true},{"text":"Övladların Məni tərk etdi,","poem":1},{"lineBreak":true},{"text":"Allah olmayan bütlərin adı ilə and içdi.","poem":1},{"lineBreak":true},{"text":"Mən onları doydurdum,","poem":1},{"lineBreak":true},{"text":"Amma onlar zina etdi,","poem":1},{"lineBreak":true},{"text":"Fahişələrin evlərinə yığışdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onlar harınlaşmış, şəhvətli atlar kimidir.","poem":1},{"lineBreak":true},{"text":"Hər biri qonşusunun arvadına kişnəyir».","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: «Bunlara görə","poem":1},{"lineBreak":true},{"text":"Mən onlara cəza verməyimmi?","poem":1},{"lineBreak":true},{"text":"Belə bir millətdən qisas almayımmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onların bağlarını dolaşıb dağıdın,","poem":1},{"lineBreak":true},{"text":"Amma büsbütün məhv etməyin.","poem":1},{"lineBreak":true},{"text":"Meynə budaqlarını qoparıb atın,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Rəbbə məxsus olmayan insanlardır».","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: «İsrail və Yəhuda nəsli","poem":1},{"lineBreak":true},{"text":"Mənə tamamilə xəyanət etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Onlar Rəbb üçün yalandan dedi:","poem":1},{"lineBreak":true},{"text":"“O heç nə etməz,","poem":1},{"lineBreak":true},{"text":"Başımıza bəla gəlməz.","poem":1},{"lineBreak":true},{"text":"Nə qılınc görəcəyik, nə aclıq”.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Peyğəmbərlər boşboğazdır.","poem":1},{"lineBreak":true},{"text":"Allahın sözü onlarda deyil,","poem":1},{"lineBreak":true},{"text":"Qoy onların başına bu iş gəlsin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Buna görə də Ordular Allahı Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Belə sözlər dedikləri üçün,","poem":1},{"lineBreak":true},{"text":"Ey Yeremya, sözlərimi sənin ağzında atəşə,","poem":1},{"lineBreak":true},{"text":"Bu xalqı isə oduna çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Atəş onları yandırıb-qurtaracaq».","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir: «Ey İsrail xalqı,","poem":1},{"lineBreak":true},{"text":"Uzaqdan üstünüzə bir millət gətirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Dilini bilmədiyin,","poem":1},{"lineBreak":true},{"text":"Dediklərini anlamadığın","poem":1},{"lineBreak":true},{"text":"Güclü, qədim bir millət.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onların oxdanları","poem":1},{"lineBreak":true},{"text":"Açıq qəbir kimidir,","poem":1},{"lineBreak":true},{"text":"Hamısı igid döyüşçüdür.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onlar sənin məhsul və çörəyini yeyəcək.","poem":1},{"lineBreak":true},{"text":"Oğul və qızlarını yeyəcək,","poem":1},{"lineBreak":true},{"text":"Sürü və naxırlarını yeyəcək,","poem":1},{"lineBreak":true},{"text":"Meynə və əncir ağaclarını yeyəcək.","poem":1},{"lineBreak":true},{"text":"Güvəndiyin qalalı şəhərləri","poem":1},{"lineBreak":true},{"text":"Qılıncla dağıdacaq».","poem":1}]},{"type":"verse","number":18,"content":["Ancaq Rəbb bəyan edir: «Hətta o günlər sizi tamamilə qırıb-çatmayacağam."]},{"type":"verse","number":19,"content":["Bir vaxt onlar soruşacaq: “Nə üçün Allahımız Rəbb bütün bunları başımıza gətirdi?” Onda onlara belə söylə: “Necə Məni tərk edərək öz ölkənizdə yad allahlara xidmət etdinizsə, eləcə də özgə ölkədə yadellilərə xidmət edəcəksiniz”."]},{"type":"verse","number":20,"content":[{"text":"Bunu Yaqub nəslinin içində bildirin,","poem":1},{"lineBreak":true},{"text":"Yəhudada elan edin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ey gözləri olub görməyən,","poem":1},{"lineBreak":true},{"text":"Qulaqları olub eşitməyən,","poem":1},{"lineBreak":true},{"text":"Ağılsız və dərrakəsiz xalq,","poem":1},{"lineBreak":true},{"text":"Bu sözə qulaq asın!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Məndən qorxmursunuzmu?» Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Mənim qarşımda titrəmirsinizmi?","poem":1},{"lineBreak":true},{"text":"Axı Mən əbədi qayda ilə","poem":1},{"lineBreak":true},{"text":"Dəniz üçün qumu sərhəd qoydum,","poem":1},{"lineBreak":true},{"text":"Dəniz bu sərhədi keçə bilməz.","poem":1},{"lineBreak":true},{"text":"Dalğaları coşsa da,","poem":1},{"lineBreak":true},{"text":"Üstün gələ bilməz.","poem":1},{"lineBreak":true},{"text":"Nərə çəksə də, keçə bilməz.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bu xalqın ürəyi inadlı və üsyankardır.","poem":1},{"lineBreak":true},{"text":"Onlar azıb öz yolları ilə getdi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Daha öz-özlərinə demirlər ki,","poem":1},{"lineBreak":true},{"text":"Payız və yaz yağışlarını vaxtında verən,","poem":1},{"lineBreak":true},{"text":"Müəyyən biçin həftələrini bizim üçün qoruyan","poem":1},{"lineBreak":true},{"text":"Allahımız Rəbbə sitayiş edək.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Təqsirləriniz bunları sizdən aldı,","poem":1},{"lineBreak":true},{"text":"Günahlarınız sizi bu nemətdən məhrum etdi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mənim xalqımın içində pis adamlar var:","poem":1},{"lineBreak":true},{"text":"Quş ovçuları kimi pusquda dururlar,","poem":1},{"lineBreak":true},{"text":"Tələ qurub adam tuturlar.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Quşlarla dolu qəfəs kimi","poem":1},{"lineBreak":true},{"text":"Onların evləri hiylə ilə doludur.","poem":1},{"lineBreak":true},{"text":"Bunun sayəsində yüksəldilər, varlandılar.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Onlar piylənib, yoğunlaşıb,","poem":1},{"lineBreak":true},{"text":"Pis işlərlə hədlərini aşıb,","poem":1},{"lineBreak":true},{"text":"Məhkəmə işlərini,","poem":1},{"lineBreak":true},{"text":"Yetimlərin işlərini","poem":1},{"lineBreak":true},{"text":"Ədalətlə həll etmirlər ki,","poem":1},{"lineBreak":true},{"text":"Qalib gəlsinlər.","poem":1},{"lineBreak":true},{"text":"Yoxsulların haqqını müdafiə etmirlər».","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Bunlara görə Mən onlara cəza verməyimmi?","poem":1},{"lineBreak":true},{"text":"Belə bir millətdən qisas almayımmı?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Bu ölkədə heyrətli və dəhşətli bir iş oldu:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Peyğəmbərlər yalandan peyğəmbərlik edir,","poem":1},{"lineBreak":true},{"text":"Kahinlər onların əli ilə hökmranlıq edir.","poem":1},{"lineBreak":true},{"text":"Xalqım da bunu bəyənir.","poem":1},{"lineBreak":true},{"text":"Amma axırda nə edəcəksiniz?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}