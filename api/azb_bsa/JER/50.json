{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Babil barədə vəhy"]},{"type":"verse","number":1,"content":["Rəbb Babil və Xaldey ölkəsi barədə Yeremya peyğəmbər vasitəsilə bu sözləri nazil etdi:"]},{"type":"verse","number":2,"content":[{"text":"«Millətlərə bildirib elan edin.","poem":1},{"lineBreak":true},{"text":"Bayraq qaldırıb xəbər verin,","poem":1},{"lineBreak":true},{"text":"Heç nəyi gizlətməyin!","poem":1},{"lineBreak":true},{"text":"Deyin ki, Babil ələ keçiriləcək,","poem":1},{"lineBreak":true},{"text":"Bel allahı utandırılacaq,","poem":1},{"lineBreak":true},{"text":"Marduk allahı dəhşətə düşəcək,","poem":1},{"lineBreak":true},{"text":"Bütləri alçaldılacaq,","poem":1},{"lineBreak":true},{"text":"Məbudları parça-parça olacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki onun üstünə şimaldan","poem":1},{"lineBreak":true},{"text":"Bir millət hücum edəcək,","poem":1},{"lineBreak":true},{"text":"Ölkəsini viran edəcək.","poem":1},{"lineBreak":true},{"text":"Orada yaşayan olmayacaq,","poem":1},{"lineBreak":true},{"text":"İnsan da, heyvan da qaçıb gedəcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbb bəyan edir: «O gün, o zaman","poem":1},{"lineBreak":true},{"text":"İsrail xalqı ilə Yəhuda xalqı","poem":1},{"lineBreak":true},{"text":"Birlikdə gələcək,","poem":1},{"lineBreak":true},{"text":"Onlar ağlaya-ağlaya gəlib","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahı Rəbbi axtaracaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Üzləri Siona tərəf","poem":1},{"lineBreak":true},{"text":"Oraya gedən yolu soruşacaqlar,","poem":1},{"lineBreak":true},{"text":"Onlar gəlib unudulmaz, əbədi bir əhdlə","poem":1},{"lineBreak":true},{"text":"Rəbbə bağlanacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xalqım itmiş qoyunlar kimidir,","poem":1},{"lineBreak":true},{"text":"Çobanları onları azdırdı,","poem":1},{"lineBreak":true},{"text":"Dağlarda özbaşına dolandırdı,","poem":1},{"lineBreak":true},{"text":"Onlar dağdan təpəyə getdi,","poem":1},{"lineBreak":true},{"text":"Yatdıqları yeri unutdu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kim onları tapdısa, yedi.","poem":1},{"lineBreak":true},{"text":"Düşmənləri dedi:","poem":1},{"lineBreak":true},{"text":"“Biz təqsirkar deyilik,","poem":1},{"lineBreak":true},{"text":"Çünki onlara əsl otlaq olan Rəbbə –","poem":1},{"lineBreak":true},{"text":"Atalarının Ümidgahı Rəbbə qarşı günah etdilər”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Babildən qaçıb qurtarın!","poem":1},{"lineBreak":true},{"text":"Xaldey ölkəsini tərk edin,","poem":1},{"lineBreak":true},{"text":"Sürüyə yol göstərən təkə kimi olun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki Mən şimal ölkəsindən","poem":1},{"lineBreak":true},{"text":"Babilə qarşı böyük millətlər ittifaqını","poem":1},{"lineBreak":true},{"text":"Oyandırıb çıxaracağam.","poem":1},{"lineBreak":true},{"text":"Babilin önündə düzülüb","poem":1},{"lineBreak":true},{"text":"Onu şimaldan ələ keçirəcəklər.","poem":1},{"lineBreak":true},{"text":"Oxları mahir döyüşçü oxları kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Heç biri əliboş qayıtmayacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xaldey ölkəsi qarət olunacaq,","poem":1},{"lineBreak":true},{"text":"Onu qarət edənlər maldan doyacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Ey irsimi talayanlar,","poem":1},{"lineBreak":true},{"text":"İndi ki sevinib şadlıqla coşursunuz,","poem":1},{"lineBreak":true},{"text":"Xırmanda taxıl döyən düyə kimi tullanırsınız,","poem":1},{"lineBreak":true},{"text":"Ayğır kimi kişnəyirsiniz,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ananız çox utanacaq,","poem":1},{"lineBreak":true},{"text":"Sizi doğanın üzü qızaracaq.","poem":1},{"lineBreak":true},{"text":"Xaldey millətlərin ən zəifi,","poem":1},{"lineBreak":true},{"text":"Quraq, boz bir səhra olacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbbin qəzəbi üzündən","poem":1},{"lineBreak":true},{"text":"Heç kəs orada yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"Tamamilə viran olacaq.","poem":1},{"lineBreak":true},{"text":"Hər keçən Babilin aldığı","poem":1},{"lineBreak":true},{"text":"Bütün yaraları görəndə","poem":1},{"lineBreak":true},{"text":"Heyrət içində fit çalacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ey bütün kaman çəkənlər,","poem":1},{"lineBreak":true},{"text":"Babilin ətrafında döyüş üçün düzülün.","poem":1},{"lineBreak":true},{"text":"Oraya ox atın, oxunuzu əsirgəməyin.","poem":1},{"lineBreak":true},{"text":"Çünki o, Rəbbə qarşı günah etdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hər tərəfdən ona qarşı nərə çəkin,","poem":1},{"lineBreak":true},{"text":"O təslim oldu,","poem":1},{"lineBreak":true},{"text":"Qüllələri yıxıldı, divarları uçuldu.","poem":1},{"lineBreak":true},{"text":"Çünki bu, Rəbbin qisasıdır.","poem":1},{"lineBreak":true},{"text":"Ondan qisas alın,","poem":1},{"lineBreak":true},{"text":"O nə etdisə, başına onu gətirin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Babildə əkinçiləri məhv edin,","poem":1},{"lineBreak":true},{"text":"Biçin vaxtı oraqçıları rədd edin.","poem":1},{"lineBreak":true},{"text":"Zalımların qılıncı üzündən","poem":1},{"lineBreak":true},{"text":"Hər kəs öz xalqının yanına qayıtsın,","poem":1},{"lineBreak":true},{"text":"Hamı öz ölkəsinə qaçsın.","poem":1}]},{"type":"heading","content":["İsrailin qayıtması"]},{"type":"verse","number":17,"content":[{"text":"İsrail dağılmış bir sürüyə bənzər,","poem":1},{"lineBreak":true},{"text":"Onu aslanlar qaçırtdı.","poem":1},{"lineBreak":true},{"text":"Onu əvvəl Aşşur padşahı yedi,","poem":1},{"lineBreak":true},{"text":"Sonra Babil padşahı Navuxodonosor","poem":1},{"lineBreak":true},{"text":"Onun sümüklərini qırdı».","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Buna görə də İsrailin Allahı olan","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Aşşur padşahını necə cəzalandırdımsa,","poem":1},{"lineBreak":true},{"text":"Babil padşahı ilə ölkəsini də","poem":1},{"lineBreak":true},{"text":"Eləcə cəzalandıracağam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakin İsraili yenə öz otlağına gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"O, Karmeldə və Başanda otlayacaq.","poem":1},{"lineBreak":true},{"text":"Efrayim və Gilead dağlıq bölgələrində","poem":1},{"lineBreak":true},{"text":"İstədiyi qədər yeyib-doyacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O gün, o zaman","poem":1},{"lineBreak":true},{"text":"İsraildə təqsir axtarılacaq,","poem":1},{"lineBreak":true},{"text":"Ancaq olmayacaq.","poem":1},{"lineBreak":true},{"text":"Yəhudada da günah axtarılacaq,","poem":1},{"lineBreak":true},{"text":"Ancaq tapılmayacaq.","poem":1},{"lineBreak":true},{"text":"Çünki salamat qoyduğum adamları bağışlayacağam»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"heading","content":["Rəbbin Babili cəzalandırması"]},{"type":"verse","number":21,"content":[{"text":"«Meratayim torpağına,","poem":1},{"lineBreak":true},{"text":"Peqodda yaşayanlara hücum et.","poem":1},{"lineBreak":true},{"text":"Onları təqib edib öldür,","poem":1},{"lineBreak":true},{"text":"Bütünlüklə yox et»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Sənə nə buyururamsa, hamısını et.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ölkədə müharibə və böyük qırğın","poem":1},{"lineBreak":true},{"text":"Gurultusu eşidilir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bütün dünyanın gürzü","poem":1},{"lineBreak":true},{"text":"Necə də qırılıb parçalandı!","poem":1},{"lineBreak":true},{"text":"Babil necə də millətlər arasında","poem":1},{"lineBreak":true},{"text":"Viranə oldu!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Sənin üçün tələ qurdum, ey Babil,","poem":1},{"lineBreak":true},{"text":"Sən də bilmədən tələmə düşdün.","poem":1},{"lineBreak":true},{"text":"Tutulub yaxalandın,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbə qarşı çıxdın.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Rəbb cəbbəxanasını açdı,","poem":1},{"lineBreak":true},{"text":"Qəzəbinin silahlarını çıxartdı.","poem":1},{"lineBreak":true},{"text":"Çünki Ordular Rəbbi Xudavəndin","poem":1},{"lineBreak":true},{"text":"Xaldey ölkəsində edəcəyi bir iş var.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hər yandan ona hücum edin,","poem":1},{"lineBreak":true},{"text":"Anbarlarını açın,","poem":1},{"lineBreak":true},{"text":"Mallarını qalaq-qalaq yığın.","poem":1},{"lineBreak":true},{"text":"Onu tamamilə məhv edin,","poem":1},{"lineBreak":true},{"text":"Ondan bir şey qalmasın.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bütün buğalarını kəsin,","poem":1},{"lineBreak":true},{"text":"Sallaqxanaya getsinlər.","poem":1},{"lineBreak":true},{"text":"Vay onların halına!","poem":1},{"lineBreak":true},{"text":"Çünki onların günü,","poem":1},{"lineBreak":true},{"text":"Cəza vaxtı gəldi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Allahımız Rəbbin qisasını,","poem":1},{"lineBreak":true},{"text":"Onun məbədinin qisasını","poem":1},{"lineBreak":true},{"text":"Sionda elan etmək üçün","poem":1},{"lineBreak":true},{"text":"Babil ölkəsindən qaçıb qurtaranların","poem":1},{"lineBreak":true},{"text":"Səsini eşidin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bütün oxçuları, kaman çəkənləri","poem":1},{"lineBreak":true},{"text":"Babilə qarşı çağırın.","poem":1},{"lineBreak":true},{"text":"Ətrafını mühasirəyə alın,","poem":1},{"lineBreak":true},{"text":"Heç kəs qaçıb qurtara bilməsin.","poem":1},{"lineBreak":true},{"text":"Ona işlərinə görə əvəz verin.","poem":1},{"lineBreak":true},{"text":"O nə etdisə, başına onu gətirin.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbə, İsrailin Müqəddəsinə qarşı","poem":1},{"lineBreak":true},{"text":"Məğrurluq etdi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Buna görə də cavanları","poem":1},{"lineBreak":true},{"text":"Meydanlarda həlak olacaq,","poem":1},{"lineBreak":true},{"text":"O gün bütün döyüşçüləri susdurulacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"«Budur, Mən sənə qarşıyam, ey məğrur»","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Xudavənd belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Çünki sənin günün,","poem":1},{"lineBreak":true},{"text":"Səni cəzalandıracağım vaxt gəldi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Məğrur büdrəyib-yıxılacaq,","poem":1},{"lineBreak":true},{"text":"Onu qaldıran olmayacaq,","poem":1},{"lineBreak":true},{"text":"Şəhərlərinə od salacağam,","poem":1},{"lineBreak":true},{"text":"Bütün ətrafda olanları","poem":1},{"lineBreak":true},{"text":"Yandırıb yox edəcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Bütün İsrail xalqı da,","poem":1},{"lineBreak":true},{"text":"Yəhuda xalqı da əziyyət çəkir.","poem":1},{"lineBreak":true},{"text":"Onları əsir tutanlar möhkəm saxlayır,","poem":1},{"lineBreak":true},{"text":"Buraxmaq istəmir.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Amma onların Satınalanı güclüdür,","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1},{"lineBreak":true},{"text":"Rəbb mütləq onların işinə baxacaq ki,","poem":1},{"lineBreak":true},{"text":"Ölkəyə rahatlıq versin,","poem":1},{"lineBreak":true},{"text":"Amma Babil sakinlərinə təşviş gətirsin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Rəbb bəyan edir: «Xaldeylilərə qarşı qılınc gəlsin!","poem":1},{"lineBreak":true},{"text":"Babildə yaşayanlara, Babil başçılarına,","poem":1},{"lineBreak":true},{"text":"Müdriklərinə qarşı qılınc gəlsin!","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Yalançı peyğəmbərlərə qarşı qılınc gəlsin!","poem":1},{"lineBreak":true},{"text":"Axmaqlıqları üzə çıxacaq.","poem":1},{"lineBreak":true},{"text":"Döyüşçülərinə qarşı qılınc gəlsin!","poem":1},{"lineBreak":true},{"text":"Onlar çaşqınlığa düşəcək.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Atlarına, döyüş arabalarına,","poem":1},{"lineBreak":true},{"text":"Aralarındakı yadelli muzdlulara qarşı qılınc gəlsin!","poem":1},{"lineBreak":true},{"text":"Hamısı arvad kimi ürkək olacaq.","poem":1},{"lineBreak":true},{"text":"Xəzinələrinə qarşı qılınc gəlsin!","poem":1},{"lineBreak":true},{"text":"Onlar qarət ediləcək.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Sularına quraqlıq gəlsin!","poem":1},{"lineBreak":true},{"text":"Onlar quruyacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Babil bütlər ölkəsidir,","poem":1},{"lineBreak":true},{"text":"Onlar qorxunc bütlərlə dəli oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Buna görə də orada vəhşi heyvanlar,","poem":1},{"lineBreak":true},{"text":"Çaqqallar, bayquşlar yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Daha insan yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"Əbədi olaraq orada heç kəs sakin olmayacaq.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Sodomla Homorranı və ətrafındakı kəndləri","poem":1},{"lineBreak":true},{"text":"Allah necə dağıtdısa,","poem":1},{"lineBreak":true},{"text":"Orada kimsə yaşamayacaq,","poem":1},{"lineBreak":true},{"text":"O yerdə bəşər oğlu sakin olmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Budur, şimaldan bir ordu gəlir,","poem":1},{"lineBreak":true},{"text":"Dünyanın uzaq yerlərindən","poem":1},{"lineBreak":true},{"text":"Böyük bir millət və çoxlu padşahlar","poem":1},{"lineBreak":true},{"text":"Hərəkətə gəlir.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Onlar ox-kaman və nizə ilə silahlanmış,","poem":1},{"lineBreak":true},{"text":"Qəddar və rəhmsizdir.","poem":1},{"lineBreak":true},{"text":"Atların üstündə gələrkən","poem":1},{"lineBreak":true},{"text":"Səsləri dəniz kimi gurlayır.","poem":1},{"lineBreak":true},{"text":"Döyüşə hazır döyüşçülər","poem":1},{"lineBreak":true},{"text":"Önündə düzüləcək, ey Babil xalqı!","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Babil padşahı onların xəbərini eşitdi,","poem":1},{"lineBreak":true},{"text":"Əlləri yanına düşdü.","poem":1},{"lineBreak":true},{"text":"Doğan qadın kimi","poem":1},{"lineBreak":true},{"text":"Onu üzüntü və sancı bürüdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Budur, aslan İordan çayının kənarındakı sıx meşədən","poem":1},{"lineBreak":true},{"text":"Yaxşı sulanan otlağa qalxdığı kimi","poem":1},{"lineBreak":true},{"text":"Mən də Xaldeyliləri bir anda öz yurdundan qovacağam.","poem":1},{"lineBreak":true},{"text":"Seçib ona rəhbər qoyacağım adam kimdir?","poem":1},{"lineBreak":true},{"text":"Mənim kimisi varmı?","poem":1},{"lineBreak":true},{"text":"Mənimlə dava edəcək,","poem":1},{"lineBreak":true},{"text":"Mənim qabağımda duracaq","poem":1},{"lineBreak":true},{"text":"Bir çoban varmı?»","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Buna görə də Rəbbin Babilə qarşı fikrini,","poem":1},{"lineBreak":true},{"text":"Xaldey ölkəsinə qarşı məqsədini eşidin:","poem":1},{"lineBreak":true},{"text":"«Sürünün ən kiçikləri də sürgün ediləcək,","poem":1},{"lineBreak":true},{"text":"Xalqına görə otlaqlar səhraya çevriləcək.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"“Babil süqut etdi” səsindən yer üzü titrəyəcək,","poem":1},{"lineBreak":true},{"text":"Millətlər arasında onun fəryadı eşidiləcək».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}