{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Rəbb belə deyir:",{"text":"«Mən Babildə və Lev-Qamayda","poem":1},{"noteId":17},{"text":"yaşayanlara qarşı","poem":1},{"lineBreak":true},{"text":"Həlakedici bir külək əsdirəcəyəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Babilə taxılsovuranlar","poem":1},{"noteId":18},{"text":"göndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onu sovurub ölkəsini boş qoyacaqlar,","poem":1},{"lineBreak":true},{"text":"Qara gündə hər yandan ona hücum edəcəklər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oxçu kamanını çəkməsin,","poem":1},{"lineBreak":true},{"text":"Zirehini geyməsin.","poem":1},{"lineBreak":true},{"text":"Onun cavanlarına rəhm etməyin,","poem":1},{"lineBreak":true},{"text":"Ordusunu tamamilə məhv edin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Öldürülənlər Xaldey ölkəsində,","poem":1},{"lineBreak":true},{"text":"Yaralılar Babil küçələrində","poem":1},{"lineBreak":true},{"text":"Yerə səriləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ancaq İsrailin Müqəddəsinə qarşı","poem":1},{"lineBreak":true},{"text":"Ölkələri təqsirlə dolduğu halda","poem":1},{"lineBreak":true},{"text":"Özlərinin Allahı Ordular Rəbbi","poem":1},{"lineBreak":true},{"text":"İsrail və Yəhuda xalqlarını tərk etmədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Babilin içindən qaçın!","poem":1},{"lineBreak":true},{"text":"Hər kəs canını qurtarsın!","poem":1},{"lineBreak":true},{"text":"Onun günahına görə məhv olmayın.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin qisas zamanıdır,","poem":1},{"lineBreak":true},{"text":"Ona öz əvəzini verəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Babil Rəbbin əlində bir qızıl kasa idi,","poem":1},{"lineBreak":true},{"text":"Bütün dünyanı sərxoş edirdi.","poem":1},{"lineBreak":true},{"text":"Millətlər onun şərabını içdi,","poem":1},{"lineBreak":true},{"text":"Ona görə də çılğınlaşdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Babil qəflətən düşüb parça-parça olacaq,","poem":1},{"lineBreak":true},{"text":"Onun üçün yas tutun!","poem":1},{"lineBreak":true},{"text":"Yarasına məlhəm sürtün,","poem":1},{"lineBreak":true},{"text":"Bəlkə şəfa tapar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Babilə şəfa vermək istədik,","poem":1},{"lineBreak":true},{"text":"Amma sağalmadı.","poem":1},{"lineBreak":true},{"text":"Onu tərk edək,","poem":1},{"lineBreak":true},{"text":"Hər birimiz öz ölkəmizə qayıdaq.","poem":1},{"lineBreak":true},{"text":"Çünki Babilin hökmü göylərə çatır,","poem":1},{"lineBreak":true},{"text":"Buludlara qədər yüksəlir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb bizə bəraət verdi.","poem":1},{"lineBreak":true},{"text":"Gəlin Allahımız Rəbbin nələr etdiyini","poem":1},{"lineBreak":true},{"text":"Sionda elan edək!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Oxları itiləyin,","poem":1},{"lineBreak":true},{"text":"Kaman qablarını doldurun!","poem":1},{"lineBreak":true},{"text":"Rəbb Midiya padşahlarını hərəkətə gətirdi.","poem":1},{"lineBreak":true},{"text":"Məqsədi Babili yox etməkdir,","poem":1},{"lineBreak":true},{"text":"Rəbb Öz qisasını, məbədinin qisasını alacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Babil divarlarına qarşı","poem":1},{"lineBreak":true},{"text":"Bayraq yüksəldin!","poem":1},{"lineBreak":true},{"text":"Keşikçiləri çoxaldın,","poem":1},{"lineBreak":true},{"text":"Növbətçiləri öz yerinə qoyun,","poem":1},{"lineBreak":true},{"text":"Pusquda durun.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb Babildə yaşayanlara qarşı","poem":1},{"lineBreak":true},{"text":"Həm niyyət qurdu,","poem":1},{"lineBreak":true},{"text":"Həm də söylədiyini yerinə yetirdi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey axar suların sahilində yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Çoxlu xəzinələri olanlar,","poem":1},{"lineBreak":true},{"text":"Axırınız gəldi,","poem":1},{"lineBreak":true},{"text":"Vaxtınız yetişdi».","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi Öz varlığına and içdi:","poem":1},{"lineBreak":true},{"text":"«Səni çəyirtkə sürüsü ilə dolduran kimi","poem":1},{"lineBreak":true},{"text":"Mütləq əsgərlərlə dolduracağam,","poem":1},{"lineBreak":true},{"text":"Sənə qarşı zəfər nərəsi çəkəcəklər».","poem":1}]},{"type":"heading","content":["Rəbbin mədhi"]},{"type":"verse","number":15,"content":[{"text":"Rəbb qüdrəti ilə yer üzünü yaratdı,","poem":1},{"lineBreak":true},{"text":"Hikməti ilə dünyanı qurdu,","poem":1},{"lineBreak":true},{"text":"Dərrakəsi ilə göyləri yaydı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O gurlayanda göydəki sular çağlayır,","poem":1},{"lineBreak":true},{"text":"Yerin ucqarlarından buludları yüksəldir,","poem":1},{"lineBreak":true},{"text":"Yağış üçün şimşək çaxdırır,","poem":1},{"lineBreak":true},{"text":"Anbarlarından külək çıxarır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hər kəs ağılsız oldu,","poem":1},{"lineBreak":true},{"text":"Bilikləri qalmadı.","poem":1},{"lineBreak":true},{"text":"Hər zərgər düzəltdiyi bütdən utanacaq,","poem":1},{"lineBreak":true},{"text":"Çünki onun tökdüyü büt puçdur,","poem":1},{"lineBreak":true},{"text":"Onda nəfəs yoxdur.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onlar boş şey, masqaraçıların işidir,","poem":1},{"lineBreak":true},{"text":"Cəza vaxtı məhv olacaqlar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaquba Nəsib Olan isə onlara bənzəməz,","poem":1},{"lineBreak":true},{"text":"Çünki irs qəbiləsi ilə birgə","poem":1},{"lineBreak":true},{"text":"Hər şeyi yaradan Odur.","poem":1},{"lineBreak":true},{"text":"Onun adı Ordular Rəbbidir.","poem":1}]},{"type":"heading","content":["Babilin cəzalanması"]},{"type":"verse","number":20,"content":[{"text":"«Sən mənim toppuzum, döyüş silahımsan,","poem":1},{"lineBreak":true},{"text":"Səninlə millətləri qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə padşahlıqları məhv edirəm.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Səninlə atları və süvariləri qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə döyüş arabaları və minicilərini qırıram,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Səninlə kişi və qadınları qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə qoca və cavanları qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə gənc oğlan və qızları qırıram.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Səninlə çoban və sürüsünü qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə əkinçi və öküzlərini qırıram,","poem":1},{"lineBreak":true},{"text":"Səninlə valilərlə vəkilləri qırıram.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amma Babildə və Xaldey ölkəsində yaşayanlara","poem":1},{"lineBreak":true},{"text":"Sionda etdikləri bütün pis əməllərinin əvəzini","poem":1},{"lineBreak":true},{"text":"Gözlərinizin önündə verəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Budur, sənə qarşıyam,","poem":1},{"lineBreak":true},{"text":"Ey həlak edən dağ»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Ey bütün dünyanı həlak edən!","poem":1},{"lineBreak":true},{"text":"Sənə əlimi qaldırıb","poem":1},{"lineBreak":true},{"text":"Qayanın başından yuvarlayacağam,","poem":1},{"lineBreak":true},{"text":"Səni yanmış bir dağa çevirəcəyəm.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Səndən künc və təməl daşı götürməyəcəklər,","poem":1},{"lineBreak":true},{"text":"Sən əbədi bir viranə olacaqsan»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Yer üzündə bayraq qaldırın!","poem":1},{"lineBreak":true},{"text":"Millətlər arasında şeypur çalın!","poem":1},{"lineBreak":true},{"text":"Millətləri Babilə qarşı döyüşə hazırlayın!","poem":1},{"lineBreak":true},{"text":"Urartu, Minni və Aşkenaz padşahlıqlarını","poem":1},{"lineBreak":true},{"text":"Ona qarşı toplayın.","poem":1},{"lineBreak":true},{"text":"Ona qarşı bir sərkərdə təyin edin,","poem":1},{"lineBreak":true},{"text":"Üstünə çəyirtkə sürüsü qədər atlar göndərin.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Millətləri – Midiya padşahlarını,","poem":1},{"lineBreak":true},{"text":"Valilərini və bütün vəkillərini,","poem":1},{"lineBreak":true},{"text":"Başçılıqları altındakı bütün ölkələri","poem":1},{"lineBreak":true},{"text":"Babilə qarşı döyüşə hazırlayın!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ölkə titrəyib lərzəyə gəlir!","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin Babilə qarşı niyyəti –","poem":1},{"lineBreak":true},{"text":"Oranı sakinsiz bir viranəyə çevirmə niyyəti","poem":1},{"lineBreak":true},{"text":"Yerinə yetməlidir.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Babil döyüşçüləri vuruşmaqdan əl çəkdi,","poem":1},{"lineBreak":true},{"text":"Öz qalalarında oturdu.","poem":1},{"lineBreak":true},{"text":"Gücləri tükəndi,","poem":1},{"lineBreak":true},{"text":"Ürkək qadınlara döndülər.","poem":1},{"lineBreak":true},{"text":"Yaşadıqları yerlər oda verildi,","poem":1},{"lineBreak":true},{"text":"Darvaza sürgüləri qırıldı.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Qasid qasid dalınca,","poem":1},{"lineBreak":true},{"text":"Xəbərçi xəbərçi dalınca qaçıb","poem":1},{"lineBreak":true},{"text":"Bu xəbəri Babil padşahına çatdırır:","poem":1},{"lineBreak":true},{"text":"“Şəhər hər tərəfdən alındı,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Çay keçidləri tutuldu,","poem":1},{"lineBreak":true},{"text":"Qamışlıqlar yandırıldı,","poem":1},{"lineBreak":true},{"text":"Döyüşçülər çaşqınlığa düşdü”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"İsrailin Allahı olan Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Vaxtı gələndə xırman yeri necə tapdalanırsa,","poem":1},{"lineBreak":true},{"text":"Babil xalqı da elə olacaq.","poem":1},{"lineBreak":true},{"text":"Qısa müddətdən sonra","poem":1},{"lineBreak":true},{"text":"Onun da biçin zamanı gələcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Babil padşahı Navuxodonosor","poem":1},{"lineBreak":true},{"text":"Bizi əzib yedi,","poem":1},{"lineBreak":true},{"text":"Boş bir qaba çevirdi.","poem":1},{"lineBreak":true},{"text":"Canavar kimi uddu,","poem":1},{"lineBreak":true},{"text":"Gözəl yeməklərimizlə qarnını doydurdu.","poem":1},{"lineBreak":true},{"text":"Sonra bizi qusdu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Bizə və əhalimizə qarşı edilən zorakılıq","poem":1},{"lineBreak":true},{"text":"Babilin başına gəlsin»","poem":1},{"lineBreak":true},{"text":"Deyir Sion sakini.","poem":1},{"lineBreak":true},{"text":"«Tökülən qanımızın haqq-hesabı","poem":1},{"lineBreak":true},{"text":"Qoy Xaldeylilərdən soruşulsun»","poem":1},{"lineBreak":true},{"text":"Deyir Yerusəlim.","poem":1}]},{"type":"heading","content":["Rəbbin İsrailə köməyi"]},{"type":"verse","number":36,"content":[{"text":"Buna görə Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Məhkəmədə işinizə Mən baxacağam,","poem":1},{"lineBreak":true},{"text":"Qisasınızı Mən alacağam.","poem":1},{"lineBreak":true},{"text":"Onun çayını qurudacaq,","poem":1},{"lineBreak":true},{"text":"Bulağının suyunu kəsəcəyəm.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Babil daş qalaqlarına,","poem":1},{"lineBreak":true},{"text":"Çaqqal yuvasına dönəcək.","poem":1},{"lineBreak":true},{"text":"Dəhşət hədəfi olacaq,","poem":1},{"lineBreak":true},{"text":"İstehza ilə ona fit çalacaqlar.","poem":1},{"lineBreak":true},{"text":"Orada heç kəs yaşamayacaq.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Xalqı cavan aslanlar kimi kükrəyəcək,","poem":1},{"lineBreak":true},{"text":"Şir balaları kimi nərildəyəcək.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ancaq qızışdıqları vaxt","poem":1},{"lineBreak":true},{"text":"Ziyafət düzəldib onları sərxoş edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Qoy keflənsinlər,","poem":1},{"lineBreak":true},{"text":"Əbədi yuxuya dalsınlar,","poem":1},{"lineBreak":true},{"text":"Heç vaxt oyanmasınlar»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"«Onları quzu, qoç və təkə kimi","poem":1},{"lineBreak":true},{"text":"Kəsməyə aparacağam.","poem":1}]},{"type":"heading","content":["Babilin sonu"]},{"type":"verse","number":41,"content":[{"text":"Şeşak","poem":1},{"noteId":19},{"text":"necə alındı!","poem":1},{"lineBreak":true},{"text":"Bütün dünyanın qürurlandığı yer","poem":1},{"lineBreak":true},{"text":"Necə dəhşətli hala düşdü.","poem":1},{"lineBreak":true},{"text":"Babil millətlər arasında","poem":1},{"lineBreak":true},{"text":"Necə dəhşətli hala düşdü!","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Babili çay basacaq,","poem":1},{"lineBreak":true},{"text":"Onu gurlayan dalğalar örtəcək.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Qəsəbələri viran olacaq,","poem":1},{"lineBreak":true},{"text":"Torpaqları heç kəsin yaşamadığı,","poem":1},{"lineBreak":true},{"text":"Bəşər oğlunun keçmədiyi","poem":1},{"lineBreak":true},{"text":"Quraq bir çölə dönəcək.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Babildə Bel bütünü cəzalandıracağam,","poem":1},{"lineBreak":true},{"text":"Udduğunu ona qusduracağam.","poem":1},{"lineBreak":true},{"text":"Artıq millətlər oraya axın-axın gəlməyəcək,","poem":1},{"lineBreak":true},{"text":"Babil divarı da yıxılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Oradan çıx, ey xalqım!","poem":1},{"lineBreak":true},{"text":"Hamınız canınızı qurtarın!","poem":1},{"lineBreak":true},{"text":"Rəbbin qızğın qəzəbindən qaçın!","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Ölkədə eşitdiyiniz şayiələrə görə","poem":1},{"lineBreak":true},{"text":"Cəsarətinizi itirib qorxmayın.","poem":1},{"lineBreak":true},{"text":"Bir il bir şayiə gəlir,","poem":1},{"lineBreak":true},{"text":"O biri il başqası.","poem":1},{"lineBreak":true},{"text":"Ölkədə zorakılıq,","poem":1},{"lineBreak":true},{"text":"Başçının başçıya qarşı çıxması barədə","poem":1},{"lineBreak":true},{"text":"Şayiələr yayılır.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Buna görə də yəqin ki","poem":1},{"lineBreak":true},{"text":"Babilin bütlərini cəzalandıracağım günlər gəlir.","poem":1},{"lineBreak":true},{"text":"Bütün ölkə utandırılacaq,","poem":1},{"lineBreak":true},{"text":"Öldürülənləri onun ortasında yerə səriləcək.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"O zaman yer, göy və onlardakı hər şey","poem":1},{"lineBreak":true},{"text":"Babilin başına gələnlərə sevinəcək.","poem":1},{"lineBreak":true},{"text":"Çünki şimaldan gələn məhv edənlər","poem":1},{"lineBreak":true},{"text":"Ona hücum edəcək»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"«İsrailin öldürülənlərinə görə","poem":1},{"lineBreak":true},{"text":"Babil də məhv olmalıdır,","poem":1},{"lineBreak":true},{"text":"Necə ki yer üzündə öldürülən hər kəs","poem":1},{"lineBreak":true},{"text":"Babilə görə məhv oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Ey qılıncdan qurtulanlar,","poem":1},{"lineBreak":true},{"text":"Qaçın, ləngiməyin!","poem":1},{"lineBreak":true},{"text":"Rəbbi uzaqdan yada salın,","poem":1},{"lineBreak":true},{"text":"Yerusəlim barədə düşünün!»","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Biz utandıq,","poem":1},{"lineBreak":true},{"text":"Çünki təhqir eşitdik,","poem":1},{"lineBreak":true},{"text":"Üzümüzü rüsvayçılıq örtdü.","poem":1},{"lineBreak":true},{"text":"Çünki yadellilər Rəbbin məbədinin","poem":1},{"lineBreak":true},{"text":"Müqəddəs yerlərinə girdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"«Buna görə də bütlərini","poem":1},{"lineBreak":true},{"text":"Cəzalandıracağım günlər gəlir,","poem":1},{"lineBreak":true},{"text":"Bütün ölkədə yaralılar inildəyəcək»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"«Babil göylərə çıxsa da,","poem":1},{"lineBreak":true},{"text":"Ucalardakı qalasını möhkəmləndirsə də,","poem":1},{"lineBreak":true},{"text":"Məhv edənləri üstünə göndərəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"«Babildən fəryad,","poem":1},{"lineBreak":true},{"text":"Xaldey ölkəsindən böyük qırğın səsi eşidilir.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Çünki Rəbb Babili məhv edir,","poem":1},{"lineBreak":true},{"text":"Onun hay-küyünü susdurur.","poem":1},{"lineBreak":true},{"text":"Düşmən dalğaları axar sular kimi kükrəyir,","poem":1},{"lineBreak":true},{"text":"Səslərinin gurultusu ucalır.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Çünki Babilə qarşı bir məhv edən çıxacaq,","poem":1},{"lineBreak":true},{"text":"Döyüşçüləri əsir tutulacaq,","poem":1},{"lineBreak":true},{"text":"Kamanları qırılacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb əvəz verən bir Allahdır,","poem":1},{"lineBreak":true},{"text":"Mütləq cəzalandıracaq.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Babil başçılarını, müdriklərini,","poem":1},{"lineBreak":true},{"text":"Valilərini, vəkillərini, döyüşçülərini","poem":1},{"lineBreak":true},{"text":"Elə sərxoş edəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Əbədi yuxuya dalacaq,","poem":1},{"lineBreak":true},{"text":"Heç vaxt oyanmayacaqlar»","poem":1},{"lineBreak":true},{"text":"Adı Ordular Rəbbi olan Padşah belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Ordular Rəbbi deyir:","poem":1},{"lineBreak":true},{"text":"«Babilin qalın divarları yerlə yeksan ediləcək,","poem":1},{"lineBreak":true},{"text":"Uca darvazaları oda veriləcək.","poem":1},{"lineBreak":true},{"text":"Xalqlar boş-boşuna zəhmət çəkir,","poem":1},{"lineBreak":true},{"text":"Ümmətlərin çəkdiyi əziyyət","poem":1},{"lineBreak":true},{"text":"Oda təslim ediləcək».","poem":1}]},{"type":"heading","content":["Yeremyanın sözünün Babilə çatması"]},{"type":"verse","number":59,"content":["Yəhuda padşahı Sidqiyanın padşahlığının dördüncü ilində ordu təsərrüfatçısı Maxseya oğlu Neriya oğlu Seraya, Sidqiya ilə birgə Babilə gedərkən Yeremya peyğəmbər ona bu əmri tapşırdı."]},{"type":"verse","number":60,"content":["Yeremya Babilin başına gələcək bütün fəlakətləri, Babil barədə yazılmış bütün bu sözləri bir tumara yazdı."]},{"type":"verse","number":61,"content":["Yeremya Serayaya dedi: «Babilə çatanda bütün bu sözləri oxumağı unutma."]},{"type":"verse","number":62,"content":["De ki: “Ya Rəbb, buranı dağıdacağını, içində insanın da, heyvanın da yaşamayacağını, ölkənin əbədi viran qalacağını söylədin”."]},{"type":"verse","number":63,"content":["Bu tumarı oxuyub qurtaranda sən ona bir daş bağlayıb Fərat çayının ortasına at və"]},{"type":"verse","number":64,"content":["söylə: “Qoy Babil də belə batsın və Mənim onun başına gətirəcəyim fəlakətdən bir daha çıxa bilməsin, qoy onlar taqətdən düşsün”». Yeremyanın sözləri buraya qədərdir."]}],"footnotes":[{"noteId":17,"caller":"+","text":"Lev-Qamay – ibrani dilində düşmənlərimin ürəyi mənasında olub Xaldey ölkəsinin rəmzi adıdır.","reference":{"chapter":51,"verse":1}},{"noteId":18,"caller":"+","text":"Taxılsovuranlar – yaxud yadellilər.","reference":{"chapter":51,"verse":2}},{"noteId":19,"caller":"+","text":"Şeşak – bax: 25:26.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/azb_bsa/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}