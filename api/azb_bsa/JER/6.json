{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Yerusəlimin mühasirəsi"]},{"type":"verse","number":1,"content":[{"text":"Ey Binyamin övladları,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin içindən qaçıb qurtarın.","poem":1},{"lineBreak":true},{"text":"Teqoada şeypur çalın,","poem":1},{"lineBreak":true},{"text":"Bet-Hakkeremdə odla işarə verin,","poem":1},{"lineBreak":true},{"text":"Çünki şimaldan fəlakət,","poem":1},{"lineBreak":true},{"text":"Böyük qırğın zahir olur.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mən gözəl və zərif qızı –","poem":1},{"lineBreak":true},{"text":"Sion qızını talan edəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çobanlar öz sürüləri ilə","poem":1},{"lineBreak":true},{"text":"Ona qarşı gələcək,","poem":1},{"lineBreak":true},{"text":"Hər tərəfdən onun önündə çadır quracaq.","poem":1},{"lineBreak":true},{"text":"Hər kəs öz yerində sürüsünü otaracaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sion qızı ilə döyüşə hazırlaşın!","poem":1},{"lineBreak":true},{"text":"Qalxın, günorta çağı hücum edək!","poem":1},{"lineBreak":true},{"text":"Vay halımıza!","poem":1},{"lineBreak":true},{"text":"Gün tutqunlaşır,","poem":1},{"lineBreak":true},{"text":"Axşam kölgələri uzanır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qalxın, gecə vaxtı hücum edək!","poem":1},{"lineBreak":true},{"text":"Onun imarətlərini dağıdaq!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ordular Rəbbi belə dedi:","poem":1},{"lineBreak":true},{"text":"«Ağac kəsin,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin önündə torpaq qalağı qurun.","poem":1},{"lineBreak":true},{"text":"Bu şəhər cəzalanmalıdır,","poem":1},{"lineBreak":true},{"text":"Çünki zorakılıqla dolub-daşır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bir bulaqdan necə su axarsa,","poem":1},{"lineBreak":true},{"text":"Bu şəhərdən də eləcə pislik fışqırır.","poem":1},{"lineBreak":true},{"text":"İçində zorakılıq və soyğunçuluq səsi eşidilir.","poem":1},{"lineBreak":true},{"text":"Önümdə həmişə dərd və yara görürəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim, ibrət al,","poem":1},{"lineBreak":true},{"text":"Yoxsa səndən üz döndərərəm,","poem":1},{"lineBreak":true},{"text":"Səni xarabaya, əhalisiz torpağa çevirərəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Tənəkdən son üzümlər yığılan kimi","poem":1},{"lineBreak":true},{"text":"İsrailin qalan əhalisi də","poem":1},{"lineBreak":true},{"text":"Yığılıb qurtaracaq.","poem":1},{"lineBreak":true},{"text":"Üzümyığan kimi","poem":1},{"lineBreak":true},{"text":"Yenə meynə budaqlarına əlini uzat».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kiminlə danışım,","poem":1},{"lineBreak":true},{"text":"Kimə xəbərdarlıq edim ki, qulaq assın?","poem":1},{"lineBreak":true},{"text":"Axı qulaqları tıxanıb,","poem":1},{"lineBreak":true},{"text":"Eşidə bilmirlər.","poem":1},{"lineBreak":true},{"text":"Onların arasında Rəbbin sözünə lağ edilir,","poem":1},{"lineBreak":true},{"text":"Ondan xoşları gəlmir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buna görə də mən Rəbbin qəzəbi ilə dolmuşam,","poem":1},{"lineBreak":true},{"text":"Özümü ələ almaqdan yorulmuşam.","poem":1},{"lineBreak":true},{"text":"«Qəzəbini küçədə olan uşaqların,","poem":1},{"lineBreak":true},{"text":"Yığılan cavanların üzərinə tök.","poem":1},{"lineBreak":true},{"text":"Bəli, ər də, arvad da,","poem":1},{"lineBreak":true},{"text":"Qoca da, yaşa dolmuş adam da ələ keçəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Evləri, tarlaları və arvadları da","poem":1},{"lineBreak":true},{"text":"Başqalarına qalacaq.","poem":1},{"lineBreak":true},{"text":"Çünki əlimi ölkədə yaşayanlara qarşı uzadacağam»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ona görə ki böyüyündən kiçiyinə qədər","poem":1},{"lineBreak":true},{"text":"Hər kəs haram qazanc dalınca qaçır.","poem":1},{"lineBreak":true},{"text":"Peyğəmbərdən kahinə qədər hər kəs hiylə qurur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xalqımın yarasını yüngülcəsinə müalicə edirlər,","poem":1},{"lineBreak":true},{"text":"“Sülh, sülh” deyirlər,","poem":1},{"lineBreak":true},{"text":"Amma sülh yoxdur.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"İyrənc işlər görəndə utanırlarmı?","poem":1},{"lineBreak":true},{"text":"Yox, heç utanmırlar,","poem":1},{"lineBreak":true},{"text":"Utanıb qızarmaq bilmirlər.","poem":1},{"lineBreak":true},{"text":"Buna görə yıxılanlar arasında","poem":1},{"lineBreak":true},{"text":"Onlar da olacaq.","poem":1},{"lineBreak":true},{"text":"Mən onları cəzalandıranda","poem":1},{"lineBreak":true},{"text":"Yerə səriləcəklər» deyir Rəbb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Yolayrıcında dayanıb baxın,","poem":1},{"lineBreak":true},{"text":"Əzəldən olan yolları soruşun.","poem":1},{"lineBreak":true},{"text":"Yaxşı yolun harada olduğunu öyrənin,","poem":1},{"lineBreak":true},{"text":"O yolla gedin.","poem":1},{"lineBreak":true},{"text":"Onda ürəyiniz dinclik tapar.","poem":1},{"lineBreak":true},{"text":"Ancaq siz “o yolla getməyəcəyik” dediniz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mən sizin üzərinizə","poem":1},{"lineBreak":true},{"text":"Gözətçilər qoyub dedim:","poem":1},{"lineBreak":true},{"text":"“Şeypur səsinə qulaq asın!”","poem":1},{"lineBreak":true},{"text":"Ancaq siz “qulaq asmayacağıq” dediniz.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Buna görə də, ey millətlər, qulaq asın,","poem":1},{"lineBreak":true},{"text":"Ey camaat, bilin ki,","poem":1},{"lineBreak":true},{"text":"Onların başına nə gələcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Eşit, ey yer üzü,","poem":1},{"lineBreak":true},{"text":"Mən bu xalqın başına fəlakət gətirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Bu onların niyyətlərinin bəhrəsi olacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Mənim sözlərimə qulaq asmadılar,","poem":1},{"lineBreak":true},{"text":"Mənim qanunumu rədd etdilər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Səbadan gətirilən kündür,","poem":1},{"lineBreak":true},{"text":"Uzaq ölkədən gəlmiş ətirli qamış","poem":1},{"lineBreak":true},{"text":"Nəyimə lazımdır?","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanlarınız Mənə məqbul deyil,","poem":1},{"lineBreak":true},{"text":"Başqa qurbanlarınız da Mənə xoş deyil».","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Buna görə də Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən bu xalqın qabağına","poem":1},{"lineBreak":true},{"text":"Maneələr qoyacağam.","poem":1},{"lineBreak":true},{"text":"Atalar və oğullar birlikdə","poem":1},{"lineBreak":true},{"text":"Onlara ilişib yıxılacaq.","poem":1},{"lineBreak":true},{"text":"Qonşu dostu ilə birgə həlak olacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Budur, şimal ölkəsindən","poem":1},{"lineBreak":true},{"text":"Bir xalq gəlir,","poem":1},{"lineBreak":true},{"text":"Dünyanın uzaq yerlərindən","poem":1},{"lineBreak":true},{"text":"Böyük bir millət hərəkətə gəlir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onlar əllərində ox-kaman və nizə tutub,","poem":1},{"lineBreak":true},{"text":"Rəhmsizdirlər, heç kəsə acımırlar.","poem":1},{"lineBreak":true},{"text":"Səsləri dəniz kimi gurlayır,","poem":1},{"lineBreak":true},{"text":"Atlara miniblər.","poem":1},{"lineBreak":true},{"text":"Onlar yekdilliklə səninlə","poem":1},{"lineBreak":true},{"text":"Müharibəyə hazırdır, ey Sion qızı!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Onlar haqqında xəbər eşitdik,","poem":1},{"lineBreak":true},{"text":"Əllərimiz yanımıza düşdü.","poem":1},{"lineBreak":true},{"text":"Doğan qadın kimi bizi","poem":1},{"lineBreak":true},{"text":"Sıxıntı və əzab bürüdü.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çölə çıxma, yola düşmə,","poem":1},{"lineBreak":true},{"text":"Çünki düşməndə qılınc,","poem":1},{"lineBreak":true},{"text":"Hər tərəfdə dəhşət var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ey əziz xalqım!","poem":1},{"lineBreak":true},{"text":"Çul geyin və küldə yuvarlan.","poem":1},{"lineBreak":true},{"text":"Vahid oğluna yas tutan kimi","poem":1},{"lineBreak":true},{"text":"Yas tutub acı-acı ağla.","poem":1},{"lineBreak":true},{"text":"Çünki məhv edən qəflətən başımızın üstünü alacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Rəbb deyir: «Ey Yeremya, Mən səni qoydum ki,","poem":1},{"lineBreak":true},{"text":"Xalqımı yoxlayıb imtahan edəsən,","poem":1},{"lineBreak":true},{"text":"Onlara nəzər qoyub əməllərini sınayasan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hamısı inadkar dönükdür,","poem":1},{"lineBreak":true},{"text":"Böhtançılar kimi dolaşan adamlardır.","poem":1},{"lineBreak":true},{"text":"Tunc və dəmir kimi sərtdirlər,","poem":1},{"lineBreak":true},{"text":"Hamısı pozğun olub.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Körük basılır,","poem":1},{"lineBreak":true},{"text":"Atəşində qurğuşun əriyir.","poem":1},{"lineBreak":true},{"text":"Ancaq dəmirçi nahaq yerə əridir,","poem":1},{"lineBreak":true},{"text":"Çünki pislər ayrılmır.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Onlara isə “atılmış gümüş” deyəcəklər,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb onları atdı».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}