{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Rəbb bəyan edir: «O vaxt Yəhuda padşahlarının və başçılarının, kahinlərinin, peyğəmbərlərin və Yerusəlimdə yaşayanların sümüklərini qəbirlərindən çıxarıb atacaqlar."]},{"type":"verse","number":2,"content":["Onların sümükləri sevdikləri, qulluq etdikləri, tərəfdarı olduqları, müraciət və səcdə etdikləri günəşin, ayın və bütün səma cisimlərinin önünə töküləcək. Onlar bir yerə yığılıb basdırılmayacaq, torpağın üstündə peyin kimi olacaq."]},{"type":"verse","number":3,"content":["Bu pis tayfadan sağ qalanların hamısı sürgün etdiyim hər yerdə həyatı yox, ölümü seçəcək» Ordular Rəbbi belə bəyan edir."]},{"type":"heading","content":["Günah və mükafat"]},{"type":"verse","number":4,"content":["Onlara söyləyəcəksən ki, Rəbb belə deyir:",{"text":"«Yıxılanlar qalxmazmı?","poem":1},{"lineBreak":true},{"text":"Yoldan azan geri qayıtmazmı?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bəs nə üçün bu xalq yoldan azdı?","poem":1},{"lineBreak":true},{"text":"Nə üçün Yerusəlim daim dönüklük edir?","poem":1},{"lineBreak":true},{"text":"Onlar yalandan bərk yapışıb,","poem":1},{"lineBreak":true},{"text":"Dönmək istəmir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mən diqqət edib qulaq asdım:","poem":1},{"lineBreak":true},{"text":"Heç kəs düz danışmır,","poem":1},{"lineBreak":true},{"text":"“Nə etdim?” deyib öz pisliyindən tövbə etmir.","poem":1},{"lineBreak":true},{"text":"Hər biri döyüşə atılan at kimi","poem":1},{"lineBreak":true},{"text":"Öz yoluna tərəf dönür.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hətta göydə uçan leylək də","poem":1},{"lineBreak":true},{"text":"Öz vaxtını bilir,","poem":1},{"lineBreak":true},{"text":"Qumru, qaranquş, durna da","poem":1},{"lineBreak":true},{"text":"Uçub gələcəkləri vaxtı gözləyir,","poem":1},{"lineBreak":true},{"text":"Amma Mənim xalqım Rəbbin hökmlərini bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nə haqla deyirsiniz ki, biz müdrikik,","poem":1},{"lineBreak":true},{"text":"Rəbbin Qanunu bizdədir?","poem":1},{"lineBreak":true},{"text":"Budur, alimlərin hiyləgər qələmi","poem":1},{"lineBreak":true},{"text":"Onu yalan şərh edir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Müdriklər rüsvay oldu,","poem":1},{"lineBreak":true},{"text":"Çaşıb tora düşdü.","poem":1},{"lineBreak":true},{"text":"Onlar Rəbbin sözünü rədd etdi.","poem":1},{"lineBreak":true},{"text":"Bəs onların müdrikliyi nədədir?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buna görə də arvadlarını başqa adamlara,","poem":1},{"lineBreak":true},{"text":"Tarlalarını isə başqa sahiblərə verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ona görə ki böyükdən kiçiyə qədər","poem":1},{"lineBreak":true},{"text":"Hər kəs haram qazanc dalınca qaçır.","poem":1},{"lineBreak":true},{"text":"Peyğəmbərdən kahinə qədər","poem":1},{"lineBreak":true},{"text":"Hər biri yalan iş görür.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əziz xalqımın yarasını","poem":1},{"lineBreak":true},{"text":"Yüngülcəsinə müalicə edirlər.","poem":1},{"lineBreak":true},{"text":"“Sülh, sülh” deyirlər,","poem":1},{"lineBreak":true},{"text":"Amma sülh yoxdur.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İyrənc işlər görəndə utanırlarmı?","poem":1},{"lineBreak":true},{"text":"Yox, heç utanmırlar,","poem":1},{"lineBreak":true},{"text":"Utanıb-qızarmaq bilmirlər.","poem":1},{"lineBreak":true},{"text":"Buna görə yıxılanlar arasında","poem":1},{"lineBreak":true},{"text":"Onlar da olacaq.","poem":1},{"lineBreak":true},{"text":"Onları cəzalandırdığım vaxt","poem":1},{"lineBreak":true},{"text":"Yerə səriləcəklər» deyir Rəbb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Onları qırıb-çatacağam»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1},{"lineBreak":true},{"text":"«Tənək üzüm gətirməyəcək,","poem":1},{"lineBreak":true},{"text":"Əncir ağacı bar verməyəcək,","poem":1},{"lineBreak":true},{"text":"Yarpaqlar solacaq.","poem":1},{"lineBreak":true},{"text":"Mən onlara nə verdimsə,","poem":1},{"lineBreak":true},{"text":"Hamısı əllərindən alınacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Nə üçün yerimizdə oturmuşuq?","poem":1},{"lineBreak":true},{"text":"Yığılın, gedib qalalı şəhərlərə girək,","poem":1},{"lineBreak":true},{"text":"Orada həlak olaq,","poem":1},{"lineBreak":true},{"text":"Çünki Allahımız Rəbb","poem":1},{"lineBreak":true},{"text":"Bizi ölümə təslim etdi,","poem":1},{"lineBreak":true},{"text":"Bizə zəhərli su içirdi,","poem":1},{"lineBreak":true},{"text":"Ona görə ki Rəbbə qarşı günah etdik.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sülh gözləyirik, amma xeyir gəlmir.","poem":1},{"lineBreak":true},{"text":"Şəfa vaxtını gözləyirik,","poem":1},{"lineBreak":true},{"text":"Amma dəhşət gəlir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dandan onların atlarının fınxırtısı eşidilir,","poem":1},{"lineBreak":true},{"text":"Ayğırlarının kişnəmə səsindən","poem":1},{"lineBreak":true},{"text":"Bütün ölkə titrəyir.","poem":1},{"lineBreak":true},{"text":"Onlar gəlir,","poem":1},{"lineBreak":true},{"text":"Torpağı və orada olan hər şeyi,","poem":1},{"lineBreak":true},{"text":"Şəhəri və orada yaşayanları yeyib-qurtarır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Baxın Mən üstünüzə ilanlar,","poem":1},{"lineBreak":true},{"text":"Ovsunla ram olmayan gürzələr göndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar sizi sancacaq» Rəbb belə bəyan edir.","poem":1}]},{"type":"heading","content":["Yeremyanın xalqın taleyi üçün narahatlığı"]},{"type":"verse","number":18,"content":[{"text":"Dərdimə təsəlli yoxdur,","poem":1},{"lineBreak":true},{"text":"Ürəyim köksümdə taqətsizdir.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baxın uzaq ölkədən","poem":1},{"lineBreak":true},{"text":"Əziz xalqımın fəryadını eşidirəm:","poem":1},{"lineBreak":true},{"text":"«Məgər Rəbb Sionda yoxdur?","poem":1},{"lineBreak":true},{"text":"Onun padşahı orada deyilmi?","poem":1},{"lineBreak":true},{"text":"Onlar nə üçün oyma bütləri,","poem":1},{"lineBreak":true},{"text":"Yad olan puç şeyləri ilə","poem":1},{"lineBreak":true},{"text":"Məni qəzəbləndirirlər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Biçin sona çatdı, yay qurtardı,","poem":1},{"lineBreak":true},{"text":"Biz xilas olmadıq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Əziz xalqımın yarasından","poem":1},{"lineBreak":true},{"text":"Mən də yaralandım,","poem":1},{"lineBreak":true},{"text":"Yas tutub dəhşətə gəldim.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Məgər Gileadda məlhəm yoxdur?","poem":1},{"lineBreak":true},{"text":"Orada həkim yoxdur?","poem":1},{"lineBreak":true},{"text":"Əgər varsa,","poem":1},{"lineBreak":true},{"text":"Əziz xalqıma nə üçün şəfa verilmədi?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}