{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JER","translationId":"azb_bsa","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA PEYĞƏMBƏRİN KİTABI","order":24,"numberOfChapters":52,"sha256":"80f4a2b009e8c37cd10d7e81aca524d132d875c4841393e5dc022133621eb056","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/azb_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Kaş ki başım bulaq olaydı,","poem":1},{"lineBreak":true},{"text":"Gözlərim yaş çeşməsinə dönəydi,","poem":1},{"lineBreak":true},{"text":"Əziz xalqımdan öldürülənlərə","poem":1},{"lineBreak":true},{"text":"Gecə-gündüz yas tutaydım.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaş ki kimsə mənə səhrada","poem":1},{"lineBreak":true},{"text":"Səyyahların sığınacağını verəydi!","poem":1},{"lineBreak":true},{"text":"Mən xalqımı tərk edib","poem":1},{"lineBreak":true},{"text":"Onlardan uzaqlaşardım.","poem":1},{"lineBreak":true},{"text":"Çünki onların hamısı","poem":1},{"lineBreak":true},{"text":"Zinakar və xain yığınıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Dillərini yalan üçün","poem":1},{"lineBreak":true},{"text":"Kaman kimi dartırlar.","poem":1},{"lineBreak":true},{"text":"Həqiqət naminə güc göstərmirlər.","poem":1},{"lineBreak":true},{"text":"Çünki pisliyi pislik dalınca edirlər,","poem":1},{"lineBreak":true},{"text":"Məni tanımırlar» Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Hər kəs dostundan çəkinsin,","poem":1},{"lineBreak":true},{"text":"Heç qardaşına da etibar etməsin.","poem":1},{"lineBreak":true},{"text":"Çünki hər qardaş başqasına badalaq gəlir,","poem":1},{"lineBreak":true},{"text":"Hər dost böhtançıdır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hər kəs öz dostunu aldadır,","poem":1},{"lineBreak":true},{"text":"Doğru söyləmir.","poem":1},{"lineBreak":true},{"text":"Onlar dillərini yalan danışmağa öyrətdi,","poem":1},{"lineBreak":true},{"text":"Yorulana qədər günah işlətdi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey Yeremya, hiylə içində yaşayırsan,","poem":1},{"lineBreak":true},{"text":"Hiylədən ötrü Məni tanımaq istəmirlər»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Buna görə də Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«Mən onları əridəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sınaqdan keçirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Axı Mən əziz xalqımla","poem":1},{"lineBreak":true},{"text":"Başqa cür necə rəftar edə bilərəm?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dilləri öldürücü oxdur,","poem":1},{"lineBreak":true},{"text":"Məkrlə danışırlar.","poem":1},{"lineBreak":true},{"text":"Ağzı ilə qonşusuna xoş sözlər söyləyir,","poem":1},{"lineBreak":true},{"text":"Ürəyində isə ona tələ qururlar».","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Bunlara görə Mən onlara cəza verməyimmi?","poem":1},{"lineBreak":true},{"text":"Belə bir millətdən qisas almayımmı?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dağlar üçün ağlayıb nalə çəkəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çölün otlaqları üçün mərsiyə oxuyacağam.","poem":1},{"lineBreak":true},{"text":"Çünki hamısı yandı,","poem":1},{"lineBreak":true},{"text":"Daha kimsə oradan keçmir,","poem":1},{"lineBreak":true},{"text":"Naxırın böyürtüsü eşidilmir.","poem":1},{"lineBreak":true},{"text":"Quşlar və heyvanlar da qaçıb getdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Yerusəlimi daş qalaqlarına,","poem":1},{"lineBreak":true},{"text":"Çaqqal yuvasına döndərəcəyəm.","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərini","poem":1},{"lineBreak":true},{"text":"Sakinsiz bir xarabalığa çevirəcəyəm» deyir Rəbb.","poem":1}]},{"type":"verse","number":12,"content":["Bir müdrik adam varmı, bunu anlasın? Rəbbin dili ilə danışan bir adam varmı, bunu izah etsin? Niyə bu ölkə məhv oldu, səhra kimi yandı və heç kəs oradan keçmir?"]},{"type":"verse","number":13,"content":["Rəbb deyir: «Ona görə belə oldu ki, onlar üçün qoyduğum qanunumu rədd etdilər, sözümə qulaq asıb əməl etmədilər,"]},{"type":"verse","number":14,"content":["ürəklərinin inadkarlığına görə rəftar etdilər və atalarının öyrətdiyi kimi Baal bütlərinə itaət etdilər."]},{"type":"verse","number":15,"content":["Buna görə də İsrailin Allahı olan Ordular Rəbbi belə deyir: “Mən bu xalqa yovşan yedirəcək, zəhərli su içirəcəyəm."]},{"type":"verse","number":16,"content":["Onları özlərinin və atalarının tanımadıqları millətlər arasına səpələyəcəyəm. Onları məhv edənədək arxalarınca qılınc göndərəcəyəm”»."]},{"type":"verse","number":17,"content":[{"text":"Ordular Rəbbi belə deyir:","poem":1},{"lineBreak":true},{"text":"«İndi düşünün,","poem":1},{"lineBreak":true},{"text":"Mərsiyəçi qadınları çağırın gəlsinlər,","poem":1},{"lineBreak":true},{"text":"Bu işdə bacarıqlı olanları","poem":1},{"lineBreak":true},{"text":"Gətirin gəlsinlər.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qoy onlar tələsib o qədər","poem":1},{"lineBreak":true},{"text":"Bizim üçün fəryad etsinlər ki,","poem":1},{"lineBreak":true},{"text":"Gözlərimizdən yaş axsın,","poem":1},{"lineBreak":true},{"text":"Kirpiklərimizdən su süzülsün».","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Çünki Siondan fəryad səsi eşidilir:","poem":1},{"lineBreak":true},{"text":"«Biz necə talan olunduq,","poem":1},{"lineBreak":true},{"text":"Yaman rüsvay edildik.","poem":1},{"lineBreak":true},{"text":"Çünki ölkəni tərk edirik,","poem":1},{"lineBreak":true},{"text":"Məskənlərimiz dağıdılır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ey qadınlar, Rəbbin sözünü eşidin,","poem":1},{"lineBreak":true},{"text":"Ağzından çıxan sözə qulaq asın.","poem":1},{"lineBreak":true},{"text":"Qızlarınıza fəryad etməyi öyrədin,","poem":1},{"lineBreak":true},{"text":"Hər kəs yoldaşına mərsiyə oxumağı öyrətsin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki ölüm pəncərələrimizə dırmaşdı,","poem":1},{"lineBreak":true},{"text":"Saraylarımıza girdi ki,","poem":1},{"lineBreak":true},{"text":"Küçədə uşaqları,","poem":1},{"lineBreak":true},{"text":"Meydanlarda cavanları qırıb-çatsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sən söylə ki, Rəbb belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«İnsan cəsədləri tarlada peyin kimi,","poem":1},{"lineBreak":true},{"text":"Biçinçinin ardınca qalan taya kimi yerə yıxılacaq.","poem":1},{"lineBreak":true},{"text":"Onları yığıb aparan olmayacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Müdrik müdrikliyi ilə öyünməsin,","poem":1},{"lineBreak":true},{"text":"İgid öz gücü ilə öyünməsin,","poem":1},{"lineBreak":true},{"text":"Varlı öz sərvəti ilə öyünməsin.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ancaq öyünən onunla öyünsün ki,","poem":1},{"lineBreak":true},{"text":"Mən Rəbbin dünyada","poem":1},{"lineBreak":true},{"text":"Məhəbbət, ədalət və salehlik yaratdığını","poem":1},{"lineBreak":true},{"text":"Dərk edir və Məni tanıyır.","poem":1},{"lineBreak":true},{"text":"Çünki Mən bunlardan xoşlanıram»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]},{"type":"verse","number":25,"content":["Bəli, Rəbb bəyan edir: «Gün gələcək ki, yalnız bədəni sünnət olanları cəzalandıracağam."]},{"type":"verse","number":26,"content":["Misiri, Yəhudanı, Edomu, Ammon övladlarını, Moavı, çöldə yaşayıb kəkillərini qırxanların hamısını cəzalandıracağam, çünki bütün bu millətlər sünnətsizdir, bütün İsrail nəslinin də ürəyi sünnətsizdir»."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}