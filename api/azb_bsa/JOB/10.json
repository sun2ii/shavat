{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Canım həyatımdan bezib.","poem":1},{"lineBreak":true},{"text":"Şikayətimə məhdudiyyət qoymayacağam,","poem":1},{"lineBreak":true},{"text":"Acı həyatımdan danışacağam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy Allaha deyim: “Məni günahlandırma,","poem":1},{"lineBreak":true},{"text":"Bir mənə söylə, niyə mənimlə çəkişirsən?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Məni incitmək,","poem":1},{"lineBreak":true},{"text":"Əllərinin işini xor görmək,","poem":1},{"lineBreak":true},{"text":"Pislərin niyyətlərinə işıq vermək Sənə xoşdurmu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səndə insan gözümü var?","poem":1},{"lineBreak":true},{"text":"İnsan necə görürsə, Sən də elə görürsənmi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Günlərin insan ömrü kimidirmi?","poem":1},{"lineBreak":true},{"text":"İllərin insanın yaşadığı illər kimidirmi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki məndə təqsir axtarırsan,","poem":1},{"lineBreak":true},{"text":"Günahlarımı araşdırırsan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Özün də bilirsən mən şər adam deyiləm,","poem":1},{"lineBreak":true},{"text":"Məni Sənin əlindən qurtaran yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Əllərin mənə quruluş verdi, məni yaratdı.","poem":1},{"lineBreak":true},{"text":"İndi dönüb məni yox edəcəksənmi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Məni palçıqdan düzəltdin, bunu xatırla.","poem":1},{"lineBreak":true},{"text":"Yenidən məni torpağa çevirəcəksənmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məni süd kimi tökmədinmi,","poem":1},{"lineBreak":true},{"text":"Pendir kimi bərkitmədinmi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ət və dərini əynimə geyindirdin,","poem":1},{"lineBreak":true},{"text":"Məni sümük və vətərlərlə hördün,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mənə həyat verdin, sevgi göstərdin,","poem":1},{"lineBreak":true},{"text":"Qayğıma qalmağınla ruhumu hifz etdin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amma bunları qəlbində gizlətdin.","poem":1},{"lineBreak":true},{"text":"Mən isə bilirəm, fikrində bu şeylər var:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Günah işlətsəydim, mənə nəzarət edərdin,","poem":1},{"lineBreak":true},{"text":"Təqsirlərimi cəzasız qoymazdın.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Əgər günahkar olsaydım, vay halıma!","poem":1},{"lineBreak":true},{"text":"Günahsız olsam belə, yenə başımı qaldıra bilmərəm,","poem":1},{"lineBreak":true},{"text":"Çünki xəcalət içindəyəm, necə də biçarəyəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Əgər başımı qaldırsam, məni aslan kimi ovlarsan,","poem":1},{"lineBreak":true},{"text":"Yenə heyrətamiz qüvvəni mənə göstərərsən.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Əleyhimə yeni şahidlər çıxararsan,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı qəzəbini artırarsan,","poem":1},{"lineBreak":true},{"text":"Orduların üstümə dayanmadan hücum çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Niyə məni doğulmağa qoydun?","poem":1},{"lineBreak":true},{"text":"Kimsənin gözü məni görmədən kaş öləydim.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kaş ki heç yaranmayaydım,","poem":1},{"lineBreak":true},{"text":"Bətndən məzara düşəydim.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Məgər ömrümə bir neçə gün qalmayıbmı?","poem":1},{"lineBreak":true},{"text":"Mənə bir qədər sərbəstlik ver ki, bir az ürəyim açılsın","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gedər-gəlməz yerə,","poem":1},{"lineBreak":true},{"text":"Zülmət və ölüm kölgəsi diyarına,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qatı qaranlıq diyarına,","poem":1},{"lineBreak":true},{"text":"Ölüm kölgəsi, qarışıqlıq diyarına,","poem":1},{"lineBreak":true},{"text":"İşığı qaranlıq olan diyara getməzdən əvvəl”».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}