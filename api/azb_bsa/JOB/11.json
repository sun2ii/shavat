{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofar"]},{"type":"verse","number":1,"content":["Naamatlı Sofar belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bu qədər söz cavabsız qalsınmı?","poem":1},{"lineBreak":true},{"text":"Çox danışan haqlı sayılsınmı?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İnsanlar boşboğazlıqlarının qarşısında sussunmu?","poem":1},{"lineBreak":true},{"text":"Sən rişxənd edəndə səni saxlamasınlar?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Allaha deyirsən: “İmanda safam,","poem":1},{"lineBreak":true},{"text":"Gözün görür ki, pakam”.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaş ki Allah danışaydı,","poem":1},{"lineBreak":true},{"text":"Sənə qarşı ağzını açaydı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Səni hikmətin sirlərindən agah etsəydi,","poem":1},{"lineBreak":true},{"text":"Hikmətin çox şaxələri üzə çıxardı.","poem":1},{"lineBreak":true},{"text":"Bil ki, Allah günahlarının neçəsindən keçib.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Allahın dərin sirlərini dərk edə bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın sərhədlərinə çata bilərsənmi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onlar göylər qədər ucadır, axı nə edə bilərsən?","poem":1},{"lineBreak":true},{"text":"Ölülər diyarından dərindir, nəyi dərk edə bilərsən?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Meyarı aləmdən uzundur,","poem":1},{"lineBreak":true},{"text":"Dənizlərdən genişdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Əgər gəlib səni zindana salarsa, məhkum edərsə,","poem":1},{"lineBreak":true},{"text":"Kim Onun qarşısını ala bilər?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O, yalançıları tanıyır,","poem":1},{"lineBreak":true},{"text":"Pisliyi görəndə onu dərk edir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vəhşi eşşək insan olaraq doğulanda","poem":1},{"lineBreak":true},{"text":"Axmaq da ağla gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Əgər ürəyini təqdis etsən,","poem":1},{"lineBreak":true},{"text":"Əllərini Ona tərəf uzatsan,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Günahın varsa, ondan əl çək,","poem":1},{"lineBreak":true},{"text":"Qoyma pislik çadırında sakin olsun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onda başını utanmadan dik tutarsan,","poem":1},{"lineBreak":true},{"text":"Sağ-salamat, qorxusuz yaşayarsan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sən dar gününü unudub","poem":1},{"lineBreak":true},{"text":"Onu axıb-qurtaran bir su kimi yad edərsən.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Həyatın gündüzün günəşindən də parlaq olar,","poem":1},{"lineBreak":true},{"text":"Qaranlığın səhər kimi işıqlanar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki ümidin var, sən arxayınsan,","poem":1},{"lineBreak":true},{"text":"Mühafizə olunaraq rahat yatarsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yatanda belə, səni qorxudan olmaz,","poem":1},{"lineBreak":true},{"text":"Sənin lütfünü çoxları arzular.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amma pis adamların gözlərinin nuru sönəcək,","poem":1},{"lineBreak":true},{"text":"Onların pənah yeri olmayacaq,","poem":1},{"lineBreak":true},{"text":"Yeganə ümidləri son nəfəslərini vermək olacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}