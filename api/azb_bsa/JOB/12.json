{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Yəqin ki siz özünüzü xalq içində müdrik sanırsınız,","poem":1},{"lineBreak":true},{"text":"Siz öləndə hikmət də öləcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sizin qədər mənim də ağlım var,","poem":1},{"lineBreak":true},{"text":"Sizdən geri qalmıram.","poem":1},{"lineBreak":true},{"text":"Bu cür şeyləri kim bilmir?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mən dostlarımın gülüş hədəfi olmuşam,","poem":1},{"lineBreak":true},{"text":"Vaxtı ilə Allaha yalvaranda mən də cavab almışam,","poem":1},{"lineBreak":true},{"text":"Amma indi bir saleh, bir kamil insan gülünc olub.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dərdsizlər bəlanı boş bir şey sanır,","poem":1},{"lineBreak":true},{"text":"Büdrəyənlər üçün bəla hazır dayanır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soyğunçuların çadırlarında rahatlıq var,","poem":1},{"lineBreak":true},{"text":"Allahı qəzəbləndirənlər əmin-amanlıqdadır,","poem":1},{"lineBreak":true},{"text":"Axı onlar Allaha yox, öz qollarına arxalanır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gəl heyvanlardan soruş, qoy sənə bildirsin,","poem":1},{"lineBreak":true},{"text":"Qoy göydəki quşlar sənə desin,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Torpağa de, qoy o sənə bildirsin,","poem":1},{"lineBreak":true},{"text":"Dənizdəki balıqlardan soruş, sənə məlumat versin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bunlardan hansı biri bilmir ki,","poem":1},{"lineBreak":true},{"text":"Bunu Rəbbin əli edib?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hər yaratdığının canı Onun əlindədir,","poem":1},{"lineBreak":true},{"text":"Bütün insanların nəfəsi Onun əlindədir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yeməyin dadını damaq hiss etdiyi kimi","poem":1},{"lineBreak":true},{"text":"Qulaq da sözləri sınaqdan keçirməzmi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ağsaqqalların hikməti var,","poem":1},{"lineBreak":true},{"text":"Uzunömürlülər dünyagörmüş olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hikmət və qüdrət Allahdandır,","poem":1},{"lineBreak":true},{"text":"O, nəsihət və dərrakə verir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onun yıxdığı bərpa olunmaz,","poem":1},{"lineBreak":true},{"text":"Onun həbs etdiyi insan azad olmaz.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Suları kəsərsə, quraqlıq olar,","poem":1},{"lineBreak":true},{"text":"Suları buraxsa, dünyanı sel aparar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qüdrət və hikmət Onundur,","poem":1},{"lineBreak":true},{"text":"Aldadan da, aldanan da Onundur","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Məsləhətçiləri talana məruz qoyar,","poem":1},{"lineBreak":true},{"text":"Hakimləri axmaqlaşdırar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Padşahların bağladığı bağı açar,","poem":1},{"lineBreak":true},{"text":"Bellərinə qurşaq salar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kahinləri talana məruz qoyar,","poem":1},{"lineBreak":true},{"text":"Mətinləri də devirər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Etibarlı məsləhətçiləri susdurar,","poem":1},{"lineBreak":true},{"text":"Ağsaqqalların ağlını alar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əsilzadələrin üstünə rüsvayçılıq yağdırar,","poem":1},{"lineBreak":true},{"text":"Güclülərin qurşaqlarını çıxarar.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qaranlığın dərin sirlərini açar,","poem":1},{"lineBreak":true},{"text":"Ölüm kölgəsini aydınlığa çıxarar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Millətləri çoxaldar, millətləri yox edər,","poem":1},{"lineBreak":true},{"text":"Millətləri artırar, millətləri sürgün edər.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dünyanın başçılarının ağlını başından alar,","poem":1},{"lineBreak":true},{"text":"Yolu-izi məlum olmayan çöllərdə dolandırar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qaranlıqda əl sürtə-sürtə yeriyərlər,","poem":1},{"lineBreak":true},{"text":"Onları sərxoş kimi aşa-aşa gəzdirər.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}