{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Bax gözlərim hər şeyi gördü,","poem":1},{"lineBreak":true},{"text":"Qulaqlarım bunu eşidib dərk etdi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sizin bildiyinizi mən də anlayıram,","poem":1},{"lineBreak":true},{"text":"Sizdən geri qalmıram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amma istəyirəm Külli-İxtiyarla danışım,","poem":1},{"lineBreak":true},{"text":"Allahla mübarizə aparım.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sizlərsə yalandan mala çəkirsiniz,","poem":1},{"lineBreak":true},{"text":"Hamınız dəyərsiz həkimlərsiniz.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaş hamınız səsinizi kəsəydiniz,","poem":1},{"lineBreak":true},{"text":"Onda hikmətli görünərdiniz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"İndi necə bəhsə girdiyimi eşidin,","poem":1},{"lineBreak":true},{"text":"Dilimin iddiasını yaxşı dinləyin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Məgər Allah üçün haqsız sözlər söyləyəcəksiniz?","poem":1},{"lineBreak":true},{"text":"Onun adına yalanmı söyləyəcəksiniz?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sizmi Onun tərəfini tutacaqsınız?","poem":1},{"lineBreak":true},{"text":"Sizmi Onun müdafiəsinə qalxacaqsınız?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O sizi istintaq edərsə, yaxşı olarmı?","poem":1},{"lineBreak":true},{"text":"İnsanları aldatdığınız kimi Onu da aldadacaqsınızmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əgər Onun tərəfini gizli tutsanız,","poem":1},{"lineBreak":true},{"text":"Şübhəsiz ki, sizi də məzəmmət edər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onun əzəməti sizi vahimələndirməzmi?","poem":1},{"lineBreak":true},{"text":"Xofu üstünüzə düşməzmi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fikrinizdəki sözlər, məsəllər külə dəyməz,","poem":1},{"lineBreak":true},{"text":"Müdafiəniz lilə dəyməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Susun, qoyun danışım,","poem":1},{"lineBreak":true},{"text":"Qoy başıma gələn gəlsin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Həyatım təhlükəyə düşürsə-düşsün.","poem":1},{"lineBreak":true},{"text":"Canım bəlaya düşürsə-düşsün.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Məni öldürsə də, Ona etibar edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Amma yolumun müdafiəsi üçün hüzuruna çıxacağam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Əslində bu məni qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Çünki Allaha inanmayan Onun hüzuruna gələ bilməz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Diqqətlə sözlərimə qulaq asın,","poem":1},{"lineBreak":true},{"text":"Qoy elan etdiklərim qulaqlarınızda qalsın.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baxın mühakiməyə hazırlaşmışam,","poem":1},{"lineBreak":true},{"text":"Haqlı çıxacağımı bilirəm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kim məni ittiham edəcək?","poem":1},{"lineBreak":true},{"text":"Eləsi varsa, son nəfəsimi verib susaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ey Allah, mənim üçün bu iki şeyi et ki,","poem":1},{"lineBreak":true},{"text":"Səndən gizlənməyim:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əlini üzərimdən götür,","poem":1},{"lineBreak":true},{"text":"Məni dəhşətinlə qorxutma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sonra da məni səslə, qoy Sənə cavab verim,","poem":1},{"lineBreak":true},{"text":"Yaxud da qoy mən danışım, Sən cavab söylə.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Təqsirlərim, günahlarım nə qədərdir?","poem":1},{"lineBreak":true},{"text":"Mənə üsyankarlığımı və günahlarımı bildir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Niyə üzünü gizlədirsən,","poem":1},{"lineBreak":true},{"text":"Məni düşmən hesab edirsən?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Məgər yelin qopardığı yarpağı qorxudacaqsan?","poem":1},{"lineBreak":true},{"text":"Məgər quru saman çöpünü qovacaqsan?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Çünki əleyhimə acı şeylər yazırsan,","poem":1},{"lineBreak":true},{"text":"Gənclikdə etdiyim günahları mənə irs olaraq verirsən.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ayaqlarımı buxovlayırsan,","poem":1},{"lineBreak":true},{"text":"Bütün yollarıma göz qoyursan,","poem":1},{"lineBreak":true},{"text":"Hər addımımı yoxlayırsan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ona görə çürük şey tək məhv oluram.","poem":1},{"lineBreak":true},{"text":"Güvə yemiş paltar kimiyəm.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}