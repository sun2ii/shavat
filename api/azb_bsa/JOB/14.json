{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Qadından doğulan insanın ömrü azdır,","poem":1},{"lineBreak":true},{"text":"Həyatı sıxıntı ilə doludur.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çiçək kimi açar, solar,","poem":1},{"lineBreak":true},{"text":"Kölgə kimi keçib-gedər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gözlərini beləsinəmi dikirsən?","poem":1},{"lineBreak":true},{"text":"Mühakimə etmək üçünmü məni hüzuruna gətirirsən?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kim çirkab içindən təmiz bir şey tapar?","poem":1},{"lineBreak":true},{"text":"Heç kim!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İnsana ömür günləri müəyyən edilib,","poem":1},{"lineBreak":true},{"text":"Aylarının sayını Sən bilirsən,","poem":1},{"lineBreak":true},{"text":"Ömrü üçün müəyyən hədd qoymusan,","poem":1},{"lineBreak":true},{"text":"Bu həddi keçən yoxdur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sən ondan gücünü çək,","poem":1},{"lineBreak":true},{"text":"İş gününü bitirən zəhmətkeş kimi","poem":1},{"lineBreak":true},{"text":"Bir az dincəlsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bir ağac üçün ümid var,","poem":1},{"lineBreak":true},{"text":"Kəsilsə belə, yenə pöhrəsini verər,","poem":1},{"lineBreak":true},{"text":"Şaxələri əskilməz.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kökü yerdə qocalsa da,","poem":1},{"lineBreak":true},{"text":"Kötüyü torpaqda məhv olsa da,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Suyun iyini duyanda çiçəklənər,","poem":1},{"lineBreak":true},{"text":"Cavan ağac kimi şaxələnər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amma insan ölər, dəfn olunar,","poem":1},{"lineBreak":true},{"text":"Son nəfəsini verər, yox olar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dəniz suları çəkilib getdiyi kimi,","poem":1},{"lineBreak":true},{"text":"Çaylar azalıb quruduğu kimi","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İnsan da yatar, bir daha qalxmaz,","poem":1},{"lineBreak":true},{"text":"Göylər yox olanadək oyadılmaz,","poem":1},{"lineBreak":true},{"text":"Yuxularından ayılmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kaş ki məni ölülər diyarında gizlədəydin,","poem":1},{"lineBreak":true},{"text":"Qəzəbin keçənədək saxlayaydın,","poem":1},{"lineBreak":true},{"text":"Mənə möhlət verəydin,","poem":1},{"lineBreak":true},{"text":"Sonra məni yada salaydın.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"İnsan ölsə, dirilərmi?","poem":1},{"lineBreak":true},{"text":"Növbəm çatanacan","poem":1},{"lineBreak":true},{"text":"Bu əzabdan qurtulmaq üçün hər gün gözləyəcəyəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sən çağıranda cavab verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Əllərinin bu işinin həsrətini çəkəcəksən.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O zaman addımlarımı sayacaqsan,","poem":1},{"lineBreak":true},{"text":"Günahımı nəzərə almayacaqsan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Üsyankarlığım torbada möhürlənəcək,","poem":1},{"lineBreak":true},{"text":"Günahımın üstünü örtəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Amma dağın uçub dağılması kimi,","poem":1},{"lineBreak":true},{"text":"Qayanın yerindən qopması kimi,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Su daşları yuvarladığı kimi,","poem":1},{"lineBreak":true},{"text":"Sellər torpağı yuyub apardığı kimi","poem":1},{"lineBreak":true},{"text":"Sən də insanın ümidini yox edirsən.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onu əbədi məğlub edirsən, o köçüb gedir.","poem":1},{"lineBreak":true},{"text":"Görkəmini dəyişdirib yola salırsan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Övladları şərəflənəndə də onun xəbəri olmaz,","poem":1},{"lineBreak":true},{"text":"Düşkün hala düşəndə də heç nəyi başa düşməz.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hamı öz canının ağrısını duyur,","poem":1},{"lineBreak":true},{"text":"Yalnız özü üçün yas tutur».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}