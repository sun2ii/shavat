{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Elifaz"]},{"type":"verse","number":1,"content":["Temanlı Elifaz belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Müdrik insan boş sözlərlə cavab verərmi?","poem":1},{"lineBreak":true},{"text":"Köksünü şərq küləyi ilə doldurarmı?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Faydasız sözlərlə, dəyərsiz nitqlərlə","poem":1},{"lineBreak":true},{"text":"Mübahisə etmək olarmı?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma sən Allah qorxusunu bir kənara qoyursan,","poem":1},{"lineBreak":true},{"text":"Allah hüzurunda düşünməyə mane olursan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki sənin ağzın günahdan dərs alıb,","poem":1},{"lineBreak":true},{"text":"Hiyləgərlərin dili ilə danışırsan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Səni məhkum edən mən deyiləm, öz dilindir.","poem":1},{"lineBreak":true},{"text":"Dodaqların öz əleyhinə şəhadət edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"İlk doğulan insan sənsənmi?","poem":1},{"lineBreak":true},{"text":"Yoxsa dağlardan da əvvəl sən var olmusan?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Allahın sirrinəmi qulaq asmısan?","poem":1},{"lineBreak":true},{"text":"Təkcə özünümü müdrik sayırsan?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sən nəyi bilirsən ki, biz onu bilmirik?","poem":1},{"lineBreak":true},{"text":"Sənin dərk etdiyin nədir ki, biz onu dərk etmirik?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bizdə ağsaçlı da, yaşlı da var,","poem":1},{"lineBreak":true},{"text":"Onlar atandan da yaşlı olar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sənə Allahın təsəllisi,","poem":1},{"lineBreak":true},{"text":"Söylədiyi xoş sözlər kifayət deyilmi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niyə qəlbin səni belə çaşdırır,","poem":1},{"lineBreak":true},{"text":"Gözlərindən od çıxır?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Niyə Allaha qəzəbini göstərirsən,","poem":1},{"lineBreak":true},{"text":"Dilindən belə sözlər çıxır?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"İnsan, həqiqətən, təmiz ola bilərmi?","poem":1},{"lineBreak":true},{"text":"Qadından doğulan insan saleh ola bilərmi?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Allah müqəddəslərinə belə, etibar etmirsə,","poem":1},{"lineBreak":true},{"text":"Göylər belə, Onun gözündə təmiz deyilsə,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Haqsızlığı su kimi içən,","poem":1},{"lineBreak":true},{"text":"İyrənc, korlanmış insana","poem":1},{"lineBreak":true},{"text":"O etibar edərmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dinlə məni, sənə deyim,","poem":1},{"lineBreak":true},{"text":"Gördüyümü bəyan edim –","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hikmətli adamların dediklərini,","poem":1},{"lineBreak":true},{"text":"Atalarından alıb gizlətmədiyi şeyləri.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O atalar ki ölkə yalnız onlara verilmişdi,","poem":1},{"lineBreak":true},{"text":"Aralarına yadelli girməmişdi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pis insan həyatı boyu əzab çəkir,","poem":1},{"lineBreak":true},{"text":"Zorakı adama ayrılan illərin sayı bilinir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qulağından dəhşətli səslər əskilmir,","poem":1},{"lineBreak":true},{"text":"Dinc oturanda soyğunçular ona hücum edir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"İnana bilməz ki, qaranlıqdan qurtara bilər,","poem":1},{"lineBreak":true},{"text":"Onu qılınc gözlər.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"“Haradadır?” deyib çörək üçün avara gəzər,","poem":1},{"lineBreak":true},{"text":"Qara günlərinin yanında olduğunu bilər.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ağrı və sıxıntı onu qorxudar,","poem":1},{"lineBreak":true},{"text":"Zəfər çalan padşah kimi onu məğlubiyyətə uğradar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çünki Allaha belə, əl uzadıb,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyara meydan oxuyub.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dikbaşlıq edib, dəyirmi sipərini tutub,","poem":1},{"lineBreak":true},{"text":"Allahın üstünə hücum çəkir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Onun üzü tosqunluqdan şişər,","poem":1},{"lineBreak":true},{"text":"Qarnı nə qədər piyləşər,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"O, dağılmış şəhərlərdə,","poem":1},{"lineBreak":true},{"text":"Kimsəsiz, yerlə yeksan olan viranələrdə,","poem":1},{"lineBreak":true},{"text":"Aqibəti dağılmaq olan evlərdə yaşayacaq.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Varlı olmayacaq, sərvətləri tükənəcək,","poem":1},{"lineBreak":true},{"text":"Malları ölkəni bürüməyəcək.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qaranlıqdan qurtulmayacaq,","poem":1},{"lineBreak":true},{"text":"Pöhrələrini alov tutacaq,","poem":1},{"lineBreak":true},{"text":"Allahın ağzının nəfəsi ilə yox olacaq.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Qoy boş şeyə güvənərək özünü aldatmasın,","poem":1},{"lineBreak":true},{"text":"Çünki əvəzində nəsibi boşluq olacaq.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"İşi vaxtsız bitəcək,","poem":1},{"lineBreak":true},{"text":"Budağı göyərməyəcək.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Qorası tökülən üzüm ağacı kimi,","poem":1},{"lineBreak":true},{"text":"Çiçəyi tökülən zeytun ağacı kimi olacaq.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Çünki allahsız icma qısır olar,","poem":1},{"lineBreak":true},{"text":"Rüşvətxorların çadırı od tutub yanar.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Onlar bəlaya hamilə olub şər doğar,","poem":1},{"lineBreak":true},{"text":"Bətnləri hiylə ilə dolar».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}