{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bu cür sözləri çox eşitmişəm,","poem":1},{"lineBreak":true},{"text":"Hamınız adamincidən təsəlliçilərsiniz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu boş söhbətləriniz qurtaracaqmı?","poem":1},{"lineBreak":true},{"text":"Sizi nə vadar edir, belə danışırsınız?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siz mənim yerimdə olsaydınız, mən də belə deyərdim.","poem":1},{"lineBreak":true},{"text":"Əleyhinizə yaxşı-yaxşı sözlər düzüb başımı yelləyərdim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ağzım ürəkləndirici sözlər deyərdi,","poem":1},{"lineBreak":true},{"text":"Dilimdən təsəlliverici sözlər çıxarardım,","poem":1},{"lineBreak":true},{"text":"Mən sizi ovudardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Danışmağımla dərdim azalmır,","poem":1},{"lineBreak":true},{"text":"Susuram, nə dəyişir?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ay Allah, məni taqətdən saldın,","poem":1},{"lineBreak":true},{"text":"Bütün külfətimi darmadağın etdin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sıxılıb əzilməyim buna şahiddir,","poem":1},{"lineBreak":true},{"text":"Taqətsizliyim əleyhimə çıxıb şahidlik edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Allah məni qəzəbi ilə parçalayır,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edir, dişlərini qıcıdır,","poem":1},{"lineBreak":true},{"text":"Düşmənim gözlərini mənə dikir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mənə qarşı insanlar dodaq büzür,","poem":1},{"lineBreak":true},{"text":"Həqarətlə üzümə şillə vurur,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı əlbir olur.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allah məni haqsızlara təslim etdi,","poem":1},{"lineBreak":true},{"text":"Pislərin əlinə verdi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rahat yaşayırdım, Allah məni pərən-pərən saldı,","poem":1},{"lineBreak":true},{"text":"Boynumdan tutub yerə vurdu, məni Özünə hədəf etdi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onun oxçuları ətrafımı aldı,","poem":1},{"lineBreak":true},{"text":"Aman vermədən böyrəklərimi deşdilər,","poem":1},{"lineBreak":true},{"text":"Ödümü yerə tökdülər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bədənimə yara üstündən yara vurulur,","poem":1},{"lineBreak":true},{"text":"Cəngavər tək üzərimə yüyürürlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Əynimə çul tikmişəm,","poem":1},{"lineBreak":true},{"text":"Qürurumu yerə atmışam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ağlamaqdan üzüm qızardı,","poem":1},{"lineBreak":true},{"text":"Kirpiklərimin altı-üstü kölgə saldı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yenə də zalımlıq əlimdən gəlmir,","poem":1},{"lineBreak":true},{"text":"Sənə səmimiyyətlə dua edirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ey torpaq, qanımın üstünü örtmə,","poem":1},{"lineBreak":true},{"text":"Qoy heç nə mənim naləmi saxlamasın.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lap indidən şahidim göylərdədir,","poem":1},{"lineBreak":true},{"text":"Himayədarım yüksəklərdədir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dostlarım məni ələ salır,","poem":1},{"lineBreak":true},{"text":"Gözlərim Allaha baxıb ağlayır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bəşər oğlu qonşusu üçün yalvardığı kimi","poem":1},{"lineBreak":true},{"text":"Biri də mən insandan ötrü qoy Allaha yalvarsın.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki bir neçə il keçəndən sonra","poem":1},{"lineBreak":true},{"text":"Gedər-gəlməz yola gedəcəyəm.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}