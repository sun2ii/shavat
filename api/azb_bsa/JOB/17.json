{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Taqətim kəsilir, günlərim batır,","poem":1},{"lineBreak":true},{"text":"Məni məzar gözləyir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Həqiqətən, ətrafıma rişxəndçilər yığılır,","poem":1},{"lineBreak":true},{"text":"Gözüm onların düşmənçiliyini görür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey Allah, Öz hüzurunda mənə zəmanət ver.","poem":1},{"lineBreak":true},{"text":"Başqa kim var ki, mənə zamin dursun?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki onların qəlbini anlayış üçün bağladın,","poem":1},{"lineBreak":true},{"text":"Ona görə onlara zəfər qazandırmayacaqsan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pul üçün dostlarını satanın","poem":1},{"lineBreak":true},{"text":"Övladlarının işığı sönəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Allah məni insanların dilinə saldı,","poem":1},{"lineBreak":true},{"text":"Üzümə tüpürdülər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gözümün nuru kədərdən qaraldı,","poem":1},{"lineBreak":true},{"text":"Bütün əzalarım kölgə kimi qaldı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buna əməlisaleh insanlar mat qalıb,","poem":1},{"lineBreak":true},{"text":"Günahsızlar allahsızlara qarşı çıxır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Saleh insanlar öz yolunu tutur,","poem":1},{"lineBreak":true},{"text":"Əlitəmiz olanlar getdikcə güclənir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amma hamınız qayıdıb gəlsəniz,","poem":1},{"lineBreak":true},{"text":"Aranızdan bir hikmətli insan tapmaram.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Günlərim ötüşdü,","poem":1},{"lineBreak":true},{"text":"Fikirlərim, arzularım pərən-pərən düşdü.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onlar gecəni gündüzə çevirir,","poem":1},{"lineBreak":true},{"text":"“Zülmətə işıq yaxındır” deyir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əgər ölülər diyarını evimdir deyə gözləsəm,","poem":1},{"lineBreak":true},{"text":"Yatağımı qaranlıqda sərsəm,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qəbirə “atam sənsən”,","poem":1},{"lineBreak":true},{"text":"Qurda “anam-bacım sənsən” desəm,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ümidim hara gedər?","poem":1},{"lineBreak":true},{"text":"Mənim ümidimi kim görər?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ümid mənimlə ölülər diyarınamı düşər?","poem":1},{"lineBreak":true},{"text":"Mənimlə birgə torpaq altınamı girər?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}