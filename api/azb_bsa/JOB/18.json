{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bildad"]},{"type":"verse","number":1,"content":["Şuahlı Bildad belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bu sözlər nə vaxt qurtaracaq?","poem":1},{"lineBreak":true},{"text":"Əgər dərrakəli olsanız, danışarıq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niyə heyvana bənzəyək?","poem":1},{"lineBreak":true},{"text":"Gözlərinizə axmaq kimi görünək?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Özünü hirsindən didib-dağıdırsan.","poem":1},{"lineBreak":true},{"text":"Sənə görə bu aləmdən vaz keçəkmi?","poem":1},{"lineBreak":true},{"text":"Yoxsa sal qayalar yerindən çıxsın?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bəli, şər insanın işığı sönəcək,","poem":1},{"lineBreak":true},{"text":"Odu-alovu parlamayacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çadırında nur qaranlığa dönəcək,","poem":1},{"lineBreak":true},{"text":"Yanındakı çıraq sönəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Addımları gücdən düşəcək,","poem":1},{"lineBreak":true},{"text":"Öz işlətdiyi fənddən yıxılacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayaqları onu tələyə aparacaq,","poem":1},{"lineBreak":true},{"text":"Öz ayağı ilə tora düşəcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kəmənd topuğundan tutacaq,","poem":1},{"lineBreak":true},{"text":"Tələ açılıb onu qapacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Torpaq üstə onun üçün gizli kəmənd səriləcək,","poem":1},{"lineBreak":true},{"text":"Yolu üstə onu tələ gözləyəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dəhşət onu hər tərəfdən bürüyəcək,","poem":1},{"lineBreak":true},{"text":"Hər addımda onu təqib edəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aclıq taqətini yeyib-qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Yanında fəlakət hazır dayanacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dərisini azar yeyəcək,","poem":1},{"lineBreak":true},{"text":"Ölümün ilk övladı əzalarını yeyib işini bitirəcək.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Əmin-amanlıq çadırından atılacaq,","poem":1},{"lineBreak":true},{"text":"Dəhşətlər padşahının yanına aparılacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Çadırında ona aid heç nə olmayacaq,","poem":1},{"lineBreak":true},{"text":"Yurduna kükürd yağacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aşağıda rişələri quruyacaq,","poem":1},{"lineBreak":true},{"text":"Yuxarıda budaqları solacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onun adı yer üzündə unudulacaq,","poem":1},{"lineBreak":true},{"text":"Məhəllə-küçələrdə adı yaddan çıxacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"İşıqdan zülmətə aparılacaq,","poem":1},{"lineBreak":true},{"text":"Dünyadan qovulacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nə övladı, nə nəvəsi xalqı arasında olmayacaq,","poem":1},{"lineBreak":true},{"text":"Məskənində bir kimsəsi qalmayacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qərbdəkilər halına heyrətlənəcək,","poem":1},{"lineBreak":true},{"text":"Şərqdəkilər onu görüb dəhşətə gələcək.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bəli, pislərin həyatının aqibəti budur,","poem":1},{"lineBreak":true},{"text":"Allahı tanımayanların məskəni budur».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}