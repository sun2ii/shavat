{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Nə vaxtadək məni üzəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Məni sözlə əzəcəksiniz,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"On dəfədir ki, məni təhqir edirsiniz,","poem":1},{"lineBreak":true},{"text":"Utanmadan mənə kəskin sözlər söyləyirsiniz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Həqiqətən, azıb yanlış yola düşmüşəmsə,","poem":1},{"lineBreak":true},{"text":"Səhvim öz üstümdə qalır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Özünüzü, həqiqətən, məndən üstün tutursunuz,","poem":1},{"lineBreak":true},{"text":"Eybimi üzümə vurursunuz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amma bilin ki, Allah mənə haqsızlıq etdi,","poem":1},{"lineBreak":true},{"text":"Hər tərəfdən məni toruna saldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Budur, “Zorakılıqdır!” deyə bağırıram,","poem":1},{"lineBreak":true},{"text":"Bir cavab verən yoxdur,","poem":1},{"lineBreak":true},{"text":"Kömək üçün nalə çəkirəm, ədalət yoxdur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Keçə bilmirəm, yollarıma sədd çəkilib,","poem":1},{"lineBreak":true},{"text":"Yollarımı qaranlığa salıb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Şərəfimi əynimdən soyundurub,","poem":1},{"lineBreak":true},{"text":"Başımdan tacı götürüb.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O məni hər tərəfdən yıxdı, əldən gedirəm,","poem":1},{"lineBreak":true},{"text":"Ümidimi ağac kimi kökündən qopartdı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mənə qarşı qəzəbi od tutub yandı,","poem":1},{"lineBreak":true},{"text":"Məni Özünə düşmən saydı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Orduları üstümə gəlir,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı torpaq qalağı düzəldir,","poem":1},{"lineBreak":true},{"text":"Çadırımın ətrafında ordugah qurur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Qardaşlarımı məndən uzaqlaşdırdı,","poem":1},{"lineBreak":true},{"text":"Tanışlarım mənə yad oldu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qohumlarım məni tərk eləyib,","poem":1},{"lineBreak":true},{"text":"Yaxın dostlarım məni unudub.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Evimin sakinləri və kənizlər","poem":1},{"lineBreak":true},{"text":"Məni özgə sayır,","poem":1},{"lineBreak":true},{"text":"Onların gözündə yad olmuşam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qulumu çağırıram,","poem":1},{"lineBreak":true},{"text":"Ağız açıb yalvarsam belə, cavab almıram.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nəfəsimdən arvadımın da zəhləsi gedir,","poem":1},{"lineBreak":true},{"text":"Qardaşlarım məndən iyrənir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mənə hətta kiçik uşaqlar xor baxır,","poem":1},{"lineBreak":true},{"text":"Ayağa duranda məni ələ salırlar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bütün səmimi dostlarım belə, məndən ikrah edir,","poem":1},{"lineBreak":true},{"text":"Əzizlərim belə, əleyhimə çıxır.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bir dəri, bir sümük qalmışam,","poem":1},{"lineBreak":true},{"text":"Ölüm kandarına çatmışam.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aman, ey dostlarım, aman,","poem":1},{"lineBreak":true},{"text":"Allahın əli məni vurdu!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Niyə məni Allah kimi qovursunuz?","poem":1},{"lineBreak":true},{"text":"Niyə mənim ətimdən doymursunuz?","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kaş ki sözlərim yazılaydı,","poem":1},{"lineBreak":true},{"text":"Kitaba köçürüləydi,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dəmir qələmlə, qurğuşunla","poem":1},{"lineBreak":true},{"text":"Əbədi qalmaq üçün bir qayaya həkk olaydı.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amma mən bilirəm ki, Satınalanım yaşayır,","poem":1},{"lineBreak":true},{"text":"Axırda O, yer üzərində dayanacaq.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dərim yox olandan sonra","poem":1},{"lineBreak":true},{"text":"Bədən alıb Allahı görəcəyəm.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mən Ona baxacağam,","poem":1},{"lineBreak":true},{"text":"Başqası yox, mən öz gözlərimlə görəcəyəm.","poem":1},{"lineBreak":true},{"text":"Budur, ürəyim həsrətdən üzülür!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mənim üçün “Bəs onu necə qovaq?","poem":1},{"lineBreak":true},{"text":"Bədbəxtliyin kökü ondadır” desəniz,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Qılıncdan qorxmalısınız,","poem":1},{"lineBreak":true},{"text":"Çünki qılınc cəzası qəzəblə gəlir.","poem":1},{"lineBreak":true},{"text":"Onda ədalətin var olduğunu görəcəksiniz».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}