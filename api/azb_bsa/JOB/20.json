{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Sofar"]},{"type":"verse","number":1,"content":["Naamatlı Sofar belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Düşüncələrimə görə cavab verməyə məcburam,","poem":1},{"lineBreak":true},{"text":"Çünki daxilən narahatam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Məni utandıran bir giley eşidirəm,","poem":1},{"lineBreak":true},{"text":"Ruhum dərrakəsi ilə məni cavab verməyə sövq edir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bilirsən ki, əzəldən bəri,","poem":1},{"lineBreak":true},{"text":"İnsanın dünyaya gəlişindən bəri","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pislərin qələbə çalması qısa çəkər,","poem":1},{"lineBreak":true},{"text":"Allahsızın sevinci bir an sürər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boyu göylərə çatsa da,","poem":1},{"lineBreak":true},{"text":"Başı buludlara dəysə də,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Öz nəcisi kimi əbədilik yox ediləcək,","poem":1},{"lineBreak":true},{"text":"Onu görənlər “O haradadır?” deyəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuxu kimi uçacaq, bir daha tapılmayacaq,","poem":1},{"lineBreak":true},{"text":"Bəli, gecə röyası kimi yox olacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onu görən gözlər bir daha görməyəcək,","poem":1},{"lineBreak":true},{"text":"Yaşadığı yerdə görünməyəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Övladları fəqirlərdən mərhəmət diləyəcək,","poem":1},{"lineBreak":true},{"text":"Sərvətləri əllərindən gedəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İnsanın sümükləri gənclik alovu ilə dolar,","poem":1},{"lineBreak":true},{"text":"Amma insanla birlikdə torpaq altında yatacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pislik ağzına şirin gəlsə də,","poem":1},{"lineBreak":true},{"text":"Dilinin altında gizlənsə də,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"İnsan pisliyi tutub buraxmasa da,","poem":1},{"lineBreak":true},{"text":"Damağının altında saxlasa da,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yediyi yemək mədəsində qıcqıracaq,","poem":1},{"lineBreak":true},{"text":"Daxilində ilan zəhərinə dönəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yediyi sərvətləri qusacaq,","poem":1},{"lineBreak":true},{"text":"Qarnındakıları Allah bayıra çıxaracaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Başqa yerdə əfi ilan zəhərini əməcək,","poem":1},{"lineBreak":true},{"text":"Gürzənin dişindən öləcək.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Axar suların, bal və qaymaq axan dərələrin","poem":1},{"lineBreak":true},{"text":"Səfasını görməyəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zəhmətlə qazandığını yeməyib geri qaytaracaq,","poem":1},{"lineBreak":true},{"text":"Ticarətdən qazandığı sərvətdən ləzzət almayacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Çünki fəqirləri əzib üzüqoylu qoymuşdu,","poem":1},{"lineBreak":true},{"text":"Özü tikmədiyi evi zorla almışdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Könlü rahatlıq nədir bilməz,","poem":1},{"lineBreak":true},{"text":"Zövq aldığı şeylər onu xilas etməz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yeməyindən artıq qalmayacaq,","poem":1},{"lineBreak":true},{"text":"Ona görə firavanlığı uzun sürməyəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bolluq içində əzaba düşəcək,","poem":1},{"lineBreak":true},{"text":"Fəlakət ona qarşı əl qaldıracaq.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Qarnını dolduranda","poem":1},{"lineBreak":true},{"text":"Allah şiddətli qəzəbini onun üzərinə göndərəcək,","poem":1},{"lineBreak":true},{"text":"Onun üstünə tökəcək.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dəmir silahdan qaça bilsə də,","poem":1},{"lineBreak":true},{"text":"Tunc ox onu dəlib-deşəcək,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ox onu dəlib-keçəcək,","poem":1},{"lineBreak":true},{"text":"Onun kürəyindən çıxacaq,","poem":1},{"lineBreak":true},{"text":"Parlaq ucu ödünü dağıdıb tökəcək.","poem":1},{"lineBreak":true},{"text":"Üstünə dəhşət gələcək.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Xəzinələrinin aqibəti qaranlıq olacaq,","poem":1},{"lineBreak":true},{"text":"Üfürülməmiş od onu yeyib-qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Çadırında qalanları da yandırıb-yaxacaq.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Göylər şər işlərinin üstünü açacaq,","poem":1},{"lineBreak":true},{"text":"Dünya onun əleyhinə qalxacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Allahın qəzəb günündə","poem":1},{"lineBreak":true},{"text":"Azğın sellər sərvətini aparacaq.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Pis insan Allahdan belə pay alacaq,","poem":1},{"lineBreak":true},{"text":"Allahın ona verdiyi irs budur».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}