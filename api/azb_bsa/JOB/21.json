{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Sözlərimi diqqətlə dinləyin,","poem":1},{"lineBreak":true},{"text":"Siz bununla mənə təsəlli verin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qoyun mən də bir şey deyim,","poem":1},{"lineBreak":true},{"text":"Mən danışandan sonra lağ edin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Şikayətim insana qarşıdırmı?","poem":1},{"lineBreak":true},{"text":"Mən necə səbir edim?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mənə baxıb mat qalın,","poem":1},{"lineBreak":true},{"text":"Əlinizi ağzınızın üstünə qoyun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bunu düşünəndə köksümü dəhşət bürüyür,","poem":1},{"lineBreak":true},{"text":"Bədənimə titrətmə düşür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pislər nə üçün yaşayır?","poem":1},{"lineBreak":true},{"text":"Yaşlandıqca niyə gücləri artır?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Övladları ətrafında,","poem":1},{"lineBreak":true},{"text":"Nəsilləri gözlərinin qarşısında sapsağlamdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Evlərində əmin-amanlıqdır, qorxudan uzaqdır,","poem":1},{"lineBreak":true},{"text":"Allahın dəyənəyi onlara dəymir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Öküzləri cütləşir, qarınları boş qalmır,","poem":1},{"lineBreak":true},{"text":"Doğar inəkləri var, bala salmaz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Övladlarını sürü tək yola salır,","poem":1},{"lineBreak":true},{"text":"Uşaqları oynaşır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dəf və lira çalaraq nəğmə deyirlər,","poem":1},{"lineBreak":true},{"text":"Tütək səsi ilə şənlənirlər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ömürlərini firavan keçirirlər,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarına rahat gedirlər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Allaha belə deyirlər: “Bizdən uzaq ol,","poem":1},{"lineBreak":true},{"text":"Yolunu tanımaq istəmirik.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kimdir Külli-İxtiyar, biz Ona qulluq edək?","poem":1},{"lineBreak":true},{"text":"Əgər Ona dua etsək, bizə nə fayda verər?”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Görürsən ki, xoşbəxtlikləri öz əllərində deyil,","poem":1},{"lineBreak":true},{"text":"Pislərin nəsihəti qoy məndən uzaq olsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Neçə dəfə pislərin çırağı söndü,","poem":1},{"lineBreak":true},{"text":"Başlarına bəla gəldi.","poem":1},{"lineBreak":true},{"text":"Allah qəzəblənəndə onlara kədəri pay verdimi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Neçə dəfə yel sovuran saman kimi,","poem":1},{"lineBreak":true},{"text":"Tufanın uçurduğu saman çöpü kimi oldular?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Deyirsiniz ki, Allah","poem":1},{"lineBreak":true},{"text":"Atanın cəzasını övladına çəkdirir.","poem":1},{"lineBreak":true},{"text":"Bunun nə olduğunu bilsin deyə özünə çəkdirsin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qoy öz həlakını gözləri görsün,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın qəzəbini su kimi içsin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki ili, ayı qurtaranda,","poem":1},{"lineBreak":true},{"text":"Arxada qalan külfətindən nə zövq ala bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yüksək mənsəb sahiblərinə hökm edən Allaha","poem":1},{"lineBreak":true},{"text":"Kim bilik verə bilər?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Biri tamam güclü,","poem":1},{"lineBreak":true},{"text":"Tamam rahat və qayğısız,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bədəni ətli-canlı,","poem":1},{"lineBreak":true},{"text":"Sümükləri ilikli ölür.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"O biri isə dərd içində,","poem":1},{"lineBreak":true},{"text":"Həyatdan kam almamış ölür.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"İkisi də torpaqda yatır,","poem":1},{"lineBreak":true},{"text":"İkisinin də bədənini qurd basır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bilirəm nə fikirdəsiniz,","poem":1},{"lineBreak":true},{"text":"Qəsdiniz mənə qarşı olmaqdır.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Deyirsiniz: “Əsilzadələrin evi haradadır?","poem":1},{"lineBreak":true},{"text":"Pislərin yaşadığı çadır haradadır?”","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yoldan keçənlərdən soruşmadınızmı?","poem":1},{"lineBreak":true},{"text":"Söhbətlərinə qulaq asmadınızmı?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Pis insan fəlakət günündə sağ qalır,","poem":1},{"lineBreak":true},{"text":"Qəzəb günü yol göstərilərək qurtulur.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Kim davranışını onun üzünə vurur?","poem":1},{"lineBreak":true},{"text":"Kim etdiklərinə görə onu cəzalandırır?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Qəbiristana aparılarkən","poem":1},{"lineBreak":true},{"text":"Məzarı üstə qarovul çəkilir.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Vadinin torpağı ona şirin gəlir,","poem":1},{"lineBreak":true},{"text":"Hamı onun ardınca düşür.","poem":1},{"lineBreak":true},{"text":"Qarşısında gedənlərsə saysızdır.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Məni necə boş sözlərlə ovuda bilərsiniz?","poem":1},{"lineBreak":true},{"text":"Cavablarınız axıradək yalandır».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}