{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifaz"]},{"type":"verse","number":1,"content":["Temanlı Elifaz belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«İnsan Allaha fayda verə bilərmi?","poem":1},{"lineBreak":true},{"text":"Müdrik adam Ona fayda verərmi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənin salehliyindən Külli-İxtiyar nə ləzzət alır?","poem":1},{"lineBreak":true},{"text":"Sənin düz həyat tərzinin Ona nə faydası var?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səni tənbeh etməsi, mübarizə aparması","poem":1},{"lineBreak":true},{"text":"Ondan qorxduğun üçündürmü?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pisliyin böyük deyilmi,","poem":1},{"lineBreak":true},{"text":"Təqsirin hədsiz deyilmi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki qardaşlarından səbəbsiz girov aldın,","poem":1},{"lineBreak":true},{"text":"Onları lüt qoydun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yorğuna bir içim su vermədin,","poem":1},{"lineBreak":true},{"text":"Ac olandan çörəyini əsirgədin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qol gücünlə ölkəyə sahib oldun,","poem":1},{"lineBreak":true},{"text":"Hörmətli insan kimi orada yaşadın.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dul qadınları əliboş qaytardın,","poem":1},{"lineBreak":true},{"text":"Yetimlərin qol-qanadını qırdın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ona görə hər yanını tələlər bürüyüb,","poem":1},{"lineBreak":true},{"text":"Qəfil qorxu səni dəhşətləndirib.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hər şeyə qara vurub görmürsən,","poem":1},{"lineBreak":true},{"text":"Sellərdə boğulursan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Allah göylərdə – ucalarda deyilmi?","poem":1},{"lineBreak":true},{"text":"Ən uzaq ulduzlara bir nəzər sal,","poem":1},{"lineBreak":true},{"text":"Gör nə qədər ucalarda yerləşib!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amma deyirsən “Allah nə bilir?","poem":1},{"lineBreak":true},{"text":"Qatı qaranlıq içindən hökm verə bilərmi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Görə bilmir, qara buludlar Ona mane olur,","poem":1},{"lineBreak":true},{"text":"Göy qübbəsinin üzərində dolaşır”.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pis adamların gəzdiyi","poem":1},{"lineBreak":true},{"text":"Köhnə yolumu tutacaqsan?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onlar vaxtı çatmamış çəkilib getdilər,","poem":1},{"lineBreak":true},{"text":"Təməllərini sellər basdı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Allaha dedilər: “Bizdən uzaq ol!","poem":1},{"lineBreak":true},{"text":"Bizə Külli-İxtiyar nə edə bilər?”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amma evlərini bərəkətlə dolduran Allah idi,","poem":1},{"lineBreak":true},{"text":"Ona görə pislərin nəsihəti qoy məndən uzaq olsun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Salehlər pislərin həlak olduğunu görüb sevinir,","poem":1},{"lineBreak":true},{"text":"Günahsızlar onlara belə istehza edir:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“Düşmənlərimiz yox oldu,","poem":1},{"lineBreak":true},{"text":"Onlardan nə qaldısa, yanıb kül oldu”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Allahla barışıb dost olsan,","poem":1},{"lineBreak":true},{"text":"Xeyir taparsan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onun ağzından çıxan təlimi qəbul et,","poem":1},{"lineBreak":true},{"text":"Onun sözlərini qəlbində saxla.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Külli-İxtiyara tərəf dönsən,","poem":1},{"lineBreak":true},{"text":"Əvvəlki halına düşərsən.","poem":1},{"lineBreak":true},{"text":"Çadırın şərdən uzaq olsa,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qızılını torpağa,","poem":1},{"lineBreak":true},{"text":"Ofir qızılını dərədəki çınqıllığa atsan,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Külli-İxtiyar sənin qızılın olar,","poem":1},{"lineBreak":true},{"text":"Qiymətli gümüşün olar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Onda Külli-İxtiyardan zövq alarsan,","poem":1},{"lineBreak":true},{"text":"Allaha üz tutarsan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ona yalvarsan, səni eşidər,","poem":1},{"lineBreak":true},{"text":"Etdiyin nəzirləri yerinə yetirərsən.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"O da dediyin sözü yerinə yetirər,","poem":1},{"lineBreak":true},{"text":"Yollarına nur səpilər.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"İnsanlar səni alçaldanda","poem":1},{"lineBreak":true},{"text":"“Baş ucalığına görədir” deyərsən,","poem":1},{"lineBreak":true},{"text":"Çünki Allah itaətkarları xilas edər.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"O, günahsız olmayanı belə qurtarar,","poem":1},{"lineBreak":true},{"text":"Sənin əllərinin təmizliyinə görə günahkar xilas olar».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}