{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bu gün də acı-acı şikayət edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Naləmə baxmayaraq üstümdə Allahın əli ağırdır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaş biləydim Onu harada tapmaq olar,","poem":1},{"lineBreak":true},{"text":"Məskəninə çatmaq olar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O zaman davamı Onun hüzurunda dilə gətirərdim,","poem":1},{"lineBreak":true},{"text":"Dəlillərimi dalbadal düzərdim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mənə verəcəyi cavabı öyrənərdim,","poem":1},{"lineBreak":true},{"text":"Dediyini dərk edərdim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Əzəməti, qüdrəti ilə əleyhimə çıxardımı?","poem":1},{"lineBreak":true},{"text":"Xeyr, yəqin sözümə qulaq asardı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hüzurunda bir haqlı insan mübahisə etsəydi,","poem":1},{"lineBreak":true},{"text":"Mən hakimimin yanında haqq qazanardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Şərqə getsəm, Allah orada deyil,","poem":1},{"lineBreak":true},{"text":"Qərbə getsəm, Onu tapa bilmirəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, şimalda işləsə, gözüm seçməz,","poem":1},{"lineBreak":true},{"text":"Cənuba dönsə, Onu görə bilmərəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amma tutduğum yolu O tanıyır,","poem":1},{"lineBreak":true},{"text":"Məni sınayan zaman qızıl kimi çıxaram.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hər addımını yaxından izlədim,","poem":1},{"lineBreak":true},{"text":"Azmadan yoluna bağlı qaldım.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ağzından çıxan əmrlərdən ayrılmadım,","poem":1},{"lineBreak":true},{"text":"Gündəlik çörəkdən çox ağzından çıxan sözləri qiymətləndirdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O təkbaşına dayanıb, kim Onu döndərə bilər?","poem":1},{"lineBreak":true},{"text":"Könlü nə istəsə, onu edər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mənimlə bağlı qərarını yerinə yetirəcək,","poem":1},{"lineBreak":true},{"text":"Belə fikirləri çoxdur.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ona görə hüzurunda dəhşətə gəlirəm,","poem":1},{"lineBreak":true},{"text":"Bunları düşünəndə Ondan vahimələnirəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Allah qəlbimin cəsarətini qırdı,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyar məni qorxuya saldı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sifətimi qatı qaranlıq bürüsə belə,","poem":1},{"lineBreak":true},{"text":"Məni zülmət susdura bilməz.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}