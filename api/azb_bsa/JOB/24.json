{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Niyə Külli-İxtiyar hökm üçün zaman təyin etmir?","poem":1},{"lineBreak":true},{"text":"Niyə Onu tanıyanlar hökm günlərini görmür?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İnsanlar sərhəd daşlarını qaldırır,","poem":1},{"lineBreak":true},{"text":"Sürüləri oğurlayıb otarır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yetimlərin eşşəyini əlindən alır,","poem":1},{"lineBreak":true},{"text":"Dul qadının öküzünü girov götürür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yoxsulları yoldan çıxarır,","poem":1},{"lineBreak":true},{"text":"Ölkədəki fəqirlərin hamısı gizlənməyə məcbur olur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Baxın kasıblar vəhşi eşşəklər kimi","poem":1},{"lineBreak":true},{"text":"Yemək tapmaq üçün ertədən işə çıxır,","poem":1},{"lineBreak":true},{"text":"Övladları üçün çöldə çörək axtarır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zəmilərdən yem yığırlar,","poem":1},{"lineBreak":true},{"text":"Pislərin üzüm bağından üzüm qalıqlarını toplayırlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gecə paltarsız, çılpaq qalırlar,","poem":1},{"lineBreak":true},{"text":"Soyuqda üstlərini örtməyə bir şey tapmırlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dağlara yağan yağışdan islanırlar,","poem":1},{"lineBreak":true},{"text":"Daldalanacaqları olmadığı üçün qayalara qısılırlar,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yetim uşağı döşdən ayırırlar,","poem":1},{"lineBreak":true},{"text":"Fəqirin körpəsini girov alırlar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bu yazıqlar paltarsız, çılpaq dolanır,","poem":1},{"lineBreak":true},{"text":"Qarınları acdır, amma taxıl dərzləri daşıyır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pislərin çəpərləri arasında yağ üçün zeytun sıxırlar,","poem":1},{"lineBreak":true},{"text":"Şərab üçün üzüm sıxırlar,","poem":1},{"lineBreak":true},{"text":"Amma özləri susuzluqdan yanırlar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Şəhərlərdən insan nalələri ucalır,","poem":1},{"lineBreak":true},{"text":"Canı yaralı olanlar fəryad qoparır,","poem":1},{"lineBreak":true},{"text":"Amma Allah dualarını nəzərə almır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Elə insanlar var ki, işığa üsyan edir,","poem":1},{"lineBreak":true},{"text":"Nurlu yolu tanımır,","poem":1},{"lineBreak":true},{"text":"Onun dalınca getmir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qatil gün batanda qalxır,","poem":1},{"lineBreak":true},{"text":"Fəqiri, yoxsulu öldürür,","poem":1},{"lineBreak":true},{"text":"Gecə oğrusuna bənzəyir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zinakarın gözü alaqaranlıqdadır,","poem":1},{"lineBreak":true},{"text":"“Kimsə məni görməz” deyə düşünür,","poem":1},{"lineBreak":true},{"text":"Üz-gözünü gizlədir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Oğrular evləri qaranlıqda yarır,","poem":1},{"lineBreak":true},{"text":"Gündüz gizlənir, işıq nədir, bilmir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki onların sabahı qatı qaranlıqdır,","poem":1},{"lineBreak":true},{"text":"Zülmətin dəhşəti onların aşnasıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Amma onlar su üzərində köpüyə bənzər,","poem":1},{"lineBreak":true},{"text":"Torpaqdan lənət payı alar,","poem":1},{"lineBreak":true},{"text":"Üzüm bağlarına qayıtmazlar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Necə ki quraqlıq və istilik qarı əridib udar,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarı da günahkarları elə götürüb aparar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onları ana bətni unudar,","poem":1},{"lineBreak":true},{"text":"Qurdlar üçün ləziz yem olar,","poem":1},{"lineBreak":true},{"text":"Bir də onları heç kim yada salmaz,","poem":1},{"lineBreak":true},{"text":"Haqsızlıq bir ağac kimi sınar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki sonsuz qadınlara yamanlıq edərlər,","poem":1},{"lineBreak":true},{"text":"Dul qadınlara yaxşılıq etməzlər.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Allah isə qüdrəti ilə bu güclüləri dartıb yerə vurar,","poem":1},{"lineBreak":true},{"text":"Onlar qalxsa belə, həyatlarından əmin olmazlar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Allah onlara izin verir ki, əmin-amanlıqda yaşasınlar,","poem":1},{"lineBreak":true},{"text":"Amma onlar gedən yollara göz qoyur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qısa müddətə ucalır, sonra da yox olurlar.","poem":1},{"lineBreak":true},{"text":"Yıxılırlar, lap əvvəlkilər kimi götürülüb aparılırlar,","poem":1},{"lineBreak":true},{"text":"Sünbül kimi dərilib yığılırlar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Əgər belə deyilsə,","poem":1},{"lineBreak":true},{"text":"Yalançı olduğumu kim sübut edə bilər?","poem":1},{"lineBreak":true},{"text":"Sözlərimin dəyərsiz olduğunu kim deyə bilər?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}