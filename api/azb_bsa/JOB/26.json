ext":"Həlak yerinin örtüyü yoxdur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şimalı boş fəzanın üstünə yayır,","poem":1},{"lineBreak":true},{"text":"Dünyanı heçliyin üstündən asır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buludların içinə sularını büküb yığır,","poem":1},{"lineBreak":true},{"text":"Onların ağırlığından buludlar yırtılmır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bədirlənmiş ayın üzünü örtür,","poem":1},{"lineBreak":true},{"text":"Buludları üstünə çəkir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Suların üstünə bir sərhəd çəkir,","poem":1},{"lineBreak":true},{"text":"İşıqla qaranlığı bölür.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O qəzəblənəndə göyün dirəkləri sarsılır,","poem":1},{"lineBreak":true},{"text":"Çaşıb qalır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dənizi gücü ilə çalxalayır,","poem":1},{"lineBreak":true},{"text":"Müdrikliyi ilə Rahavı","poem":1},{"noteId":3},{"text":"vurur.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Göyləri nəfəsi ilə açır,","poem":1},{"lineBreak":true},{"text":"Qaçan ilanı əli ilə parçalayır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bunlar yalnız Onun etdiklərinin bir zərrəsidir,","poem":1},{"lineBreak":true},{"text":"Ondan eşitdiyimiz çox zəif bir pıçıltıdır.","poem":1},{"lineBreak":true},{"text":"Axı qüdrətli gurultusunu kim dərk edə bilər?»","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Rahav – 9:13-də olan qeydə bax.","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/azb_bsa/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14