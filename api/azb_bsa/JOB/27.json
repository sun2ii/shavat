{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Əyyub misal çəkərək dedi:"]},{"type":"verse","number":2,"content":[{"text":"«Haqqımı əlimdən alan var olan Allaha and olsun,","poem":1},{"lineBreak":true},{"text":"Canımı dərdə salan Külli-İxtiyara and olsun,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nə qədər canımda can,","poem":1},{"lineBreak":true},{"text":"Burnumda Allahın nəfəsi varsa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ağzımdan pis söz çıxmayacaq,","poem":1},{"lineBreak":true},{"text":"Dilim yalan danışmayacaq!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sizin sözlərinizi əsla təsdiq etməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Son nəfəsimə qədər kamilliyimdən əl çəkməyəcəyəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Salehliyimdən bərk yapışmışam,","poem":1},{"lineBreak":true},{"text":"Onu buraxmaram,","poem":1},{"lineBreak":true},{"text":"Elə gün keçirməmişəm ki, ürəyim tərəfindən ittiham olunum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Qoy düşmən pis adamların gününə düşsün,","poem":1},{"lineBreak":true},{"text":"Haqsız adamlara nə edilirsə, əleyhdarlarıma da elə edilsin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Allahsız insanı Allah kəsib atanda,","poem":1},{"lineBreak":true},{"text":"Canını alanda ümidi olarmı?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dara düşəndə fəryadını","poem":1},{"lineBreak":true},{"text":"Allah eşidəcəkmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O, Külli-İxtiyardan zövq alırmı?","poem":1},{"lineBreak":true},{"text":"O hər zaman Allaha yalvarırmı?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allahın qolu haqqında sizə bilik verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın niyyətini sizdən gizlətməyəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əslində hamınız bunu görmüsünüz,","poem":1},{"lineBreak":true},{"text":"Bəs niyə boş sözlər söyləyirsiniz?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pis adam Allahdan belə pay alar,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyardan zorakı adamlara bu nəsib olar:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nə olsun, övladları çoxalır,","poem":1},{"lineBreak":true},{"text":"Hamısı qılıncdan keçiriləcək,","poem":1},{"lineBreak":true},{"text":"Nəslində doyunca çörək tapan olmayacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nəslindən sağ qalanlar xəstəlikdən ölərək dəfn ediləcək,","poem":1},{"lineBreak":true},{"text":"Dul arvadları ağlaya bilməyəcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pis insan qum qədər gümüş yığsa da,","poem":1},{"lineBreak":true},{"text":"Torpaq zərrələri qədər paltar yığsa da,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onun yığdığını saleh geyəcək,","poem":1},{"lineBreak":true},{"text":"Gümüşünü günahsızlar böləcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Güvə çanağı kimi,","poem":1},{"lineBreak":true},{"text":"Qarovulçu çardağı kimi ev tikir,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Varlı olaraq yatır, amma sona qədər belə qalmaz,","poem":1},{"lineBreak":true},{"text":"Gözlərini açanda hamısı yox olub gedəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dəhşət onu sel tək basacaq,","poem":1},{"lineBreak":true},{"text":"Tufan gecə onu qapıb aparacaq.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Şərq küləyi onu qaldırıb sovuracaq,","poem":1},{"lineBreak":true},{"text":"Onu öz yerindən süpürüb aparacaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ona qarşı amansız küləklər əsəcək,","poem":1},{"lineBreak":true},{"text":"O isə yelin əlindən qaçmağa cəhd edəcək.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Külək onu ələ salaraq əl çalacaq,","poem":1},{"lineBreak":true},{"text":"Öz yerindən onun üçün vıyıldayacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}