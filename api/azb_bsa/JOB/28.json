{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Hikmətin mədhi"]},{"type":"verse","number":1,"content":[{"text":"Gümüşün mədəni,","poem":1},{"lineBreak":true},{"text":"Qızılın təmizlənmə yeri var.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dəmir torpaqdan çıxarılır,","poem":1},{"lineBreak":true},{"text":"Mis daşlardan əridilərək alınır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İnsan qaranlığa son qoyur,","poem":1},{"lineBreak":true},{"text":"Sonacan qatı qaranlıqda, zülmətdə filiz axtarır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"İnsan məskənlərindən uzaq bir çuxur açır,","poem":1},{"lineBreak":true},{"text":"İnsan ayağı dəyməyən yerlərdə,","poem":1},{"lineBreak":true},{"text":"İnsanlardan uzaqlarda ilişib yellənə-yellənə qalır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Torpaqdan çörək çıxır,","poem":1},{"lineBreak":true},{"text":"Torpağın altı isə fırlanır, elə bil odlar yanır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qayalarından göy yaqut çıxır,","poem":1},{"lineBreak":true},{"text":"Orada qızıl tozu da var.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oranın yolunu yırtıcı quşlar bilmir,","poem":1},{"lineBreak":true},{"text":"Şahinin gözü oranı görməyib.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ora məğrur heyvanların ayağı dəyməyib,","poem":1},{"lineBreak":true},{"text":"Yırtıcı aslanlar oradan keçməyib.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mədənçi əlini çaxmaq daşına uzadır,","poem":1},{"lineBreak":true},{"text":"Dağları dibindən oynadır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qayalardan yeraltı keçidlər açır,","poem":1},{"lineBreak":true},{"text":"Gözləri müxtəlif qiymətli şeylərə baxır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çayların mənbələrini bağlayır,","poem":1},{"lineBreak":true},{"text":"Gizlini aşkara çıxarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amma hikməti haradan tapmaq olar?","poem":1},{"lineBreak":true},{"text":"Müdrikliyin yeri hanı?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"İnsan onun qiymətini bilməz,","poem":1},{"lineBreak":true},{"text":"Dirilər arasında ona rast gəlməz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dərinliklər deyər: “Məndə yoxdur”,","poem":1},{"lineBreak":true},{"text":"Dəniz deyər: “Yanımda yoxdur”.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Saf qızıl onu əvəz edə bilməz,","poem":1},{"lineBreak":true},{"text":"Qiyməti gümüşlə ölçülməz.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onu Ofir qızılı ilə qiymətləndirmək olmaz,","poem":1},{"lineBreak":true},{"text":"Onu qiymətli damarlı əqiqlə, göy yaqutla dəyərləndirmək olmaz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nə qızıl, nə də gözəl cam ona tay deyil,","poem":1},{"lineBreak":true},{"text":"Hikmət saf qızıl qablarla əvəz edilmir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yanında mərcanın, büllurun adı çəkilməz,","poem":1},{"lineBreak":true},{"text":"Hikmətin qiyməti yaqutdan artıqdır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kuş topazı onun tayı deyil,","poem":1},{"lineBreak":true},{"text":"Onun dəyəri saf qızılla ölçülməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bəs hikmət haradan gəlir?","poem":1},{"lineBreak":true},{"text":"Müdrikliyin yeri hanı?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O bütün canlıların gözündən uzaqdır,","poem":1},{"lineBreak":true},{"text":"Göydə uçan quşlardan belə, gizli qalır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Həlak yeri ilə ölüm belə deyir:","poem":1},{"lineBreak":true},{"text":"“Qulaqlarımız yalnız sorağını eşidir”.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onun yolunu Allah dərk edir,","poem":1},{"lineBreak":true},{"text":"Yerini yalnız O bilir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Çünki yer üzünün ucqarlarına qədər baxır,","poem":1},{"lineBreak":true},{"text":"Göylərin altındakı hər şeyi görür.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Küləyin gücünü təyin edəndə,","poem":1},{"lineBreak":true},{"text":"Suları ölçəndə,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yağışa qanun qoyanda,","poem":1},{"lineBreak":true},{"text":"Şimşəyə yol açanda","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hikmətə baxıb qiymət qoydu,","poem":1},{"lineBreak":true},{"text":"Onu bərqərar edib araşdırdı.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"İnsana dedi: “Rəbb qorxusu hikmətdir,","poem":1},{"lineBreak":true},{"text":"Pislikdən çəkinmək müdriklikdir”».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}