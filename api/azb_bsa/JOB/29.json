{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Əyyubun yekun sözü"]},{"type":"verse","number":1,"content":["Əyyub yenə misal çəkərək dedi:"]},{"type":"verse","number":2,"content":[{"text":"«Kaş ki ötən aylar geri dönəydi –","poem":1},{"lineBreak":true},{"text":"Allahın məni qoruduğu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çırağının başım üstə işıq saçdığı,","poem":1},{"lineBreak":true},{"text":"Nuru ilə qaranlıqda gəzdiyim günlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaş ki həyatımın çiçəkli günləri geri dönəydi –","poem":1},{"lineBreak":true},{"text":"Mənə yar olan Allahın çadırımı qoruduğu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Külli-İxtiyarın hər vaxt mənimlə olduğu,","poem":1},{"lineBreak":true},{"text":"Övladlarımın ətrafımda dolandığı,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yollarımın südlə yuyulduğu,","poem":1},{"lineBreak":true},{"text":"Yanımdakı qayadan zeytun yağı axdığı günlər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şəhər darvazasına gedərkən,","poem":1},{"lineBreak":true},{"text":"Kürsümü meydanın başına qoyarkən","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gənclər məni görüb gizlənərdi,","poem":1},{"lineBreak":true},{"text":"Yaşlılar ayağa qalxıb hörmət göstərərdi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Başçılar söhbətini dayandırardı,","poem":1},{"lineBreak":true},{"text":"Əlləri ilə ağızlarını tutardı.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əsilzadələrin səsi çıxmazdı,","poem":1},{"lineBreak":true},{"text":"Dilləri damaqlarına yapışardı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qulaq məni eşidəndə alqışlayardı,","poem":1},{"lineBreak":true},{"text":"Göz məni görəndə tərifləyərdi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki imdad diləyən fəqiri,","poem":1},{"lineBreak":true},{"text":"Köməksiz yetimi qurtarardım.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Son anlarını yaşayanlar mənə xeyir-dua verərdi,","poem":1},{"lineBreak":true},{"text":"Dul qadının qəlbinə şən nəğmələr verərdim.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Libas kimi salehliyi geyinmişdim,","poem":1},{"lineBreak":true},{"text":"Sanki ədalətim mənə cübbə və tac idi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Korlara göz idim,","poem":1},{"lineBreak":true},{"text":"Topallara ayaq idim,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yoxsulların atası idim,","poem":1},{"lineBreak":true},{"text":"Qəriblərin müşküllərinin qayğısına qalırdım,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Haqsızın çənəsini qırırdım,","poem":1},{"lineBreak":true},{"text":"Ovunu dişlərindən qoparırdım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Düşünürdüm: “Son nəfəsimi yuvamdaca verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ömrümün günlərini qum qədər çoxaldacağam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Köküm sulara tərəf rişələnəcək,","poem":1},{"lineBreak":true},{"text":"Budaqlarıma şeh düşəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qazandığım şərəf təzələnəcək,","poem":1},{"lineBreak":true},{"text":"Əlimə yeni ox-kaman gələcək”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"İnsanlar ehtiramla məni dinlərdi,","poem":1},{"lineBreak":true},{"text":"Səssizcə məsləhətimi gözlərdi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Heç kim sözümün üstündən söz deməzdi,","poem":1},{"lineBreak":true},{"text":"Sözlərim üzərlərinə tökülərdi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Məni yağış kimi gözləyirdilər,","poem":1},{"lineBreak":true},{"text":"Yaz yağışı tək sözlərimi içirdilər,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Üzlərinə gülümsəyəndə gözlərinə inanmazdılar,","poem":1},{"lineBreak":true},{"text":"Gülər üzümdən ruhlanardılar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Onlara yol göstərərdim, başçı kimi əyləşərdim,","poem":1},{"lineBreak":true},{"text":"Əsgərlərin arasında padşah kimi ömür sürərdim,","poem":1},{"lineBreak":true},{"text":"Yaslılara təsəlli verənə bənzəyərdim.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}