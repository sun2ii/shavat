{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Əyyubun gileyi"]},{"type":"verse","number":1,"content":["Bundan sonra Əyyub ağzını açıb öz doğulduğu günə lənət etdi."]},{"type":"verse","number":2,"content":["Dilə gəlib belə dedi:"]},{"type":"verse","number":3,"content":[{"text":"«Kaş ki mən doğulan gün yox olaydı,","poem":1},{"lineBreak":true},{"text":"“Oğlun oldu!” deyilən gecə yox olaydı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O gün qara gələydi,","poem":1},{"lineBreak":true},{"text":"Allah göydən o günün qayğısına qalmayaydı,","poem":1},{"lineBreak":true},{"text":"O gün üçün sabah açılmayaydı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O günü zülmət, qatı qaranlıq bürüyəydi,","poem":1},{"lineBreak":true},{"text":"Üzünü bulud tutaydı,","poem":1},{"lineBreak":true},{"text":"Nurunu qaranlıq batıraydı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O gecəni zil qaranlıq udub yeyəydi,","poem":1},{"lineBreak":true},{"text":"İlin günləri arasında fərəh tapmayaydı,","poem":1},{"lineBreak":true},{"text":"Ayın günləri sırasına girməyəydi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kaş o gecə qısır olaydı,","poem":1},{"lineBreak":true},{"text":"Sevincsiz, səssiz qalaydı!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Günlərə lənət oxuyanlar,","poem":1},{"lineBreak":true},{"text":"Livyatanı","poem":1},{"noteId":1},{"text":"oyatmağa mahir olanlar","poem":1},{"lineBreak":true},{"text":"Qoy o günə lənət yağdırsın.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dan ulduzları sönəydi,","poem":1},{"lineBreak":true},{"text":"İşığa olan ümidləri boşa çıxaydı,","poem":1},{"lineBreak":true},{"text":"Sübhün nuru görünməyəydi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Əfsus ki O, anamın bətninin qapılarını bağlamadı,","poem":1},{"lineBreak":true},{"text":"Gözlərimi əzabsız saxlamadı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Niyə doğulanda mən ölmədim,","poem":1},{"lineBreak":true},{"text":"Bətndən çıxarkən nəfəsim kəsilmədi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niyə məni dizlərin arasından aldılar,","poem":1},{"lineBreak":true},{"text":"Əmizdirmək üçün ağzıma döş saldılar?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Belə olmasaydı, indi rahat uzanardım,","poem":1},{"lineBreak":true},{"text":"Yatıb dincələrdim","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Özləri üçün viranə şəhərləri tikən","poem":1},{"lineBreak":true},{"text":"Dünya padşahları və müşavirlərlə,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Evlərini gümüşə qərq edən","poem":1},{"lineBreak":true},{"text":"Qızıl xəzinəsi olan rəhbərlərlə.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Niyə bətndən yarımçıq uşaq tək düşmədim?","poem":1},{"lineBreak":true},{"text":"Niyə işıq üzü görməyən körpə kimi basdırılmadım?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Orada pis adamlar belə, kini atır,","poem":1},{"lineBreak":true},{"text":"Yorğunlar rahatlıq tapır,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Məhbuslar dinc yaşayır,","poem":1},{"lineBreak":true},{"text":"Nəzarətçinin səsi çıxmır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Orada kiçik də, böyük də vardır,","poem":1},{"lineBreak":true},{"text":"Qul ağasından da azaddır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Niyə əzab çəkənlər işıq üzü görür,","poem":1},{"lineBreak":true},{"text":"Əziyyət içində olanlar həyata gəlir?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ölüm arzulayırlar amma tapmırlar,","poem":1},{"lineBreak":true},{"text":"Dəfinə axtarmaqdan da çox onu axtarırlar,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onlar məzar tapanda fərəhlənər,","poem":1},{"lineBreak":true},{"text":"Şadlanaraq sevinər.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hara getdiyi bilinməyən insana,","poem":1},{"lineBreak":true},{"text":"Ətrafına Allah sədd çəkdiyi adama niyə ömür verilir?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Çörəkdən əvvəl ah-zar gəlir,","poem":1},{"lineBreak":true},{"text":"Nalələrim sular kimi tökülür.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çəkindiyim şeylər üzərimə tökülür,","poem":1},{"lineBreak":true},{"text":"Qorxduğum şeylər başıma gəlir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Rahatlığım, sakitliyim, dincliyim yoxdur,","poem":1},{"lineBreak":true},{"text":"Ancaq sıxıntım vardır».","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Livyatan – bu gün bizə məlum olmayan nəhəng su heyvanı.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/azb_bsa/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}