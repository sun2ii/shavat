{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"Amma indi yaşca məndən kiçiklər","poem":1},{"lineBreak":true},{"text":"Mənə lağ edirlər.","poem":1},{"lineBreak":true},{"text":"Vaxtı ilə atalarını heç bir işə layiq görməzdim,","poem":1},{"lineBreak":true},{"text":"Sürümün itlərinin yanına belə, qoymazdım.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki taqətdən düşmüşdülər,","poem":1},{"lineBreak":true},{"text":"Biləklərinin gücü getmişdi,","poem":1},{"lineBreak":true},{"text":"Heç biri işimə yaramırdı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onlar yoxsulluqdan, aclıqdan zəifləmişdi,","poem":1},{"lineBreak":true},{"text":"Gecələr çöl-biyabanda bitki kökü gəmirirdi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kollardan duzlu bitkilər toplayırdılar,","poem":1},{"lineBreak":true},{"text":"Süpürgə kollarının köklərini yeyirdilər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xalq arasından qovulurdular,","poem":1},{"lineBreak":true},{"text":"Üstlərinə elə çığırırdılar ki,","poem":1},{"lineBreak":true},{"text":"Elə bil ki oğrudurlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vadi yataqlarında, yerin dəliklərində,","poem":1},{"lineBreak":true},{"text":"Qaya ovuqlarında yaşayırdılar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kollar arasında bağırırdılar,","poem":1},{"lineBreak":true},{"text":"Qara tikan kolu altında daldalanırdılar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Axmaqların, adsız-sansız insanların övladlarıdır,","poem":1},{"lineBreak":true},{"text":"Ölkədən qovulmuşdular.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İndisə dillərində dastan olmuşam,","poem":1},{"lineBreak":true},{"text":"Ağızlarında məsəl olmuşam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İkrah edərək məndən gen dayanırlar,","poem":1},{"lineBreak":true},{"text":"Hətta üzümə tüpürməkdən çəkinmirlər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki Allah kamanımın ipini boşaltdı,","poem":1},{"lineBreak":true},{"text":"Məni zəlil elədi.","poem":1},{"lineBreak":true},{"text":"Ona görə onlar gözümün qabağındaca","poem":1},{"lineBreak":true},{"text":"Cilovlarını çıxarıb atdılar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bu avara gənclər sağ tərəfimdən çıxır,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımı büdrədir,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı torpaq qalağı düzəldir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yolumu bərbad etdilər,","poem":1},{"lineBreak":true},{"text":"Onlara dəstək verən olmasa da,","poem":1},{"lineBreak":true},{"text":"Məni yox etməyə çalışırlar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sanki geniş dəliklərdən keçib","poem":1},{"lineBreak":true},{"text":"Viranəlikdən üstümə yuvarlanırlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dəhşətlər üstümə doldu,","poem":1},{"lineBreak":true},{"text":"Şərəfimi yel tək sovurdu,","poem":1},{"lineBreak":true},{"text":"Xoşbəxtliyim bulud kimi keçib getdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"İndi canım taqətdən düşdü,","poem":1},{"lineBreak":true},{"text":"Dar günlər məndən bərk yapışdı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gecələr sümüklərim sızıldayır,","poem":1},{"lineBreak":true},{"text":"Canımı gəmirən ağrılar dayanmır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Allah paltarı zorla əynimdən çıxarır,","poem":1},{"lineBreak":true},{"text":"Məndən cübbəmin yaxası kimi yapışır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Məni lilə batırır,","poem":1},{"lineBreak":true},{"text":"Toza, külə dönmüşəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Sənə yalvarıram, cavab vermirsən,","poem":1},{"lineBreak":true},{"text":"Ayağa qalxmağıma göz qoyursan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mənə qarşı rəhmsizsən,","poem":1},{"lineBreak":true},{"text":"Güclü əllərinlə məni əzirsən.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Məni qaldırıb yel üstünə mindirirsən,","poem":1},{"lineBreak":true},{"text":"Fırtına içinə salıb məni darmadağın edirsən.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bilirəm, məni ölümə,","poem":1},{"lineBreak":true},{"text":"Bütün ömür sürənlər üçün təyin olunan son mənzilə aparacaqsan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yıxılana əl qaldırmaq olmaz,","poem":1},{"lineBreak":true},{"text":"Bəlaya düşənin harayına çatan yoxdur.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Məgər dara düşənlər üçün ağlamırdımmı?","poem":1},{"lineBreak":true},{"text":"Yoxsulların halına yanmırdımmı?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mən yaxşılıq gözlədim, yamanlıq gəldi,","poem":1},{"lineBreak":true},{"text":"Mən işıq umarkən qaranlıq gəldi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ürəyim çırpınır, rahatlığı yoxdur,","poem":1},{"lineBreak":true},{"text":"Ağır günlər qarşımı kəsdi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yoxdur bir işıq ucu, qarala-qarala gəzirəm,","poem":1},{"lineBreak":true},{"text":"Camaat arasında durub fəryad edirəm.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Çaqqallara qardaş oldum,","poem":1},{"lineBreak":true},{"text":"Bayquşlara yoldaş oldum.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qaralan dərim soyulur,","poem":1},{"lineBreak":true},{"text":"Qızdırmadan sümüklərim yanır.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Liram yas tutub nalə çəkir,","poem":1},{"lineBreak":true},{"text":"Tütəyim zar-zar inləyir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}