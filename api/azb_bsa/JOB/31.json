{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Gözlərim üçün əhd etmişəm,","poem":1},{"lineBreak":true},{"text":"Gözüm bir qıza baxarmı?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İnsan yuxarıdan – Allahdan nə pay alır?","poem":1},{"lineBreak":true},{"text":"İnsana ucalardan – Külli-İxtiyardan nə irs qalır?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Məgər haqsızların başına fəlakət gəlmir?","poem":1},{"lineBreak":true},{"text":"Məgər fitnəkarların başına bəla gəlmir?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məgər O, yollarıma baxmır?","poem":1},{"lineBreak":true},{"text":"Məgər O hər addımımı saymır?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Əgər yalançı olaraq gəzmişəmsə,","poem":1},{"lineBreak":true},{"text":"Ayağım fırıldaq üçün qaçıbsa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qoy Allah məni haqq tərəzisində çəksin,","poem":1},{"lineBreak":true},{"text":"Kamil olduğumu görsün.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yolumda əyri addım atmışamsa,","poem":1},{"lineBreak":true},{"text":"Gözlərimin ardınca qəlbimi sürükləmişəmsə,","poem":1},{"lineBreak":true},{"text":"Əllərimi ləkələmişəmsə,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əkdiyimi yadlar yesin,","poem":1},{"lineBreak":true},{"text":"Qoy əkinim kökündən çıxarılsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Əgər qəlbim başqa bir qadına meyl edibsə,","poem":1},{"lineBreak":true},{"text":"Qonşumun qapısını pusmuşamsa,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qoy arvadım başqasının taxılını üyütsün,","poem":1},{"lineBreak":true},{"text":"Qoy onunla başqa kişilər yatsın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Axı bu bir xəcalət olardı,","poem":1},{"lineBreak":true},{"text":"Məhkəməyə veriləsi bir günah sayılardı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki bu Həlak yerinədək yandırıb-yaxan bir alovdur.","poem":1},{"lineBreak":true},{"text":"Bu bütün barımı kökündən çıxarardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Əgər mənimlə çəkişəndə","poem":1},{"lineBreak":true},{"text":"Nökərlərimin və kənizlərimin","poem":1},{"lineBreak":true},{"text":"Haqqını yemişəmsə,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Allah ayağa qalxanda","poem":1},{"lineBreak":true},{"text":"Mən nə edə bilərəm?","poem":1},{"lineBreak":true},{"text":"Məni yoxlayanda nə cavab verərəm?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Anamın bətnində məni yaradan","poem":1},{"lineBreak":true},{"text":"Onu yaratmayıbmı?","poem":1},{"lineBreak":true},{"text":"Bətndən bizə quruluş verən O olmayıbmı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Əgər yoxsulların istədiklərini bir kənara qoymuşamsa,","poem":1},{"lineBreak":true},{"text":"Dul qadının ümidini qırmışamsa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bir tikəmi özüm yeyib","poem":1},{"lineBreak":true},{"text":"Yetimə verməmişəmsə,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gəncliyimdən bəri yetimlərə atalıq etməmişəmsə,","poem":1},{"lineBreak":true},{"text":"Doğulandan bəri dul qadına yol göstərməmişəmsə,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paltarı olmadığı üçün canı ağrıyan,","poem":1},{"lineBreak":true},{"text":"Ya örtüyə möhtac qalan yoxsulları görəndə","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qoyunlarımın yunu ilə onları isitməmişəmsə,","poem":1},{"lineBreak":true},{"text":"Onlar da mənə ürəkdən alqış etməyiblərsə,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Məhkəmədə sözü keçən olduğum üçün","poem":1},{"lineBreak":true},{"text":"Yetimə əl qaldırmışamsa,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qollarım qırılıb çiyinlərimdən düşsün,","poem":1},{"lineBreak":true},{"text":"Qoy qolum lüləsindən sınsın.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Çünki Allahın bəlasından qorxuram,","poem":1},{"lineBreak":true},{"text":"Əzəməti qarşısında dayana bilmərəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Əgər qızıla ümid bağlamışamsa,","poem":1},{"lineBreak":true},{"text":"Saf qızıla “ümidim sənsən” demişəmsə,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Əgər bol sərvətimə görə,","poem":1},{"lineBreak":true},{"text":"Əlimin gəlirinin çoxluğuna görə sevinmişəmsə,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Əgər parlayan günəşə,","poem":1},{"lineBreak":true},{"text":"İşıq saçaraq dövran edən aya baxıb,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Könlümün meylini gizlicə azdırıb,","poem":1},{"lineBreak":true},{"text":"Sitayiş etmək üçün əlimlə onlara","poem":1},{"lineBreak":true},{"text":"Öpüş yollamışamsa,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bu da məni ittiham edən günah sayılardı,","poem":1},{"lineBreak":true},{"text":"Çünki ucalarda olan Allahı danmış olardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Əgər düşmənlərimin bədbəxtliyinə sevinmişəmsə,","poem":1},{"lineBreak":true},{"text":"Başına bəla gəldi deyə fərəhlənmişəmsə,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kiminsə canına qarğış yağdıraraq","poem":1},{"lineBreak":true},{"text":"Dilimə günah işlətməyə yol vermişəmsə,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Evimdəki insanlar “Əyyubun verdiyi ətlə","poem":1},{"lineBreak":true},{"text":"Qarnını doyurmayan varmı?” deyə soruşmayıblarsa,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"– Heç bir yadelli gecəni küçədə keçirməzdi,","poem":1},{"lineBreak":true},{"text":"Qapım həmişə yoldan keçənlərin üzünə açıq idi –","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Əgər təqsirimi gizlətmişəmsə,","poem":1},{"lineBreak":true},{"text":"Adəm kimi üsyankarlığımı ört-basdır etmişəmsə,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Camaatdan qorxduğum üçün,","poem":1},{"lineBreak":true},{"text":"El qınağından dəhşətə gəldiyim üçün","poem":1},{"lineBreak":true},{"text":"Dinməzcə bayıra çıxmamışamsa…","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Kaş məni bir eşidən olaydı!","poem":1},{"lineBreak":true},{"text":"Bu sözümü təsdiq edirəm,","poem":1},{"lineBreak":true},{"text":"Qoy Külli-İxtiyar mənə bir cavab versin!","poem":1},{"lineBreak":true},{"text":"Əleyhdarım bunu tumara yazıb əlimə versin.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Şübhəsiz, bu tumarı çiynimdə gəzdirərdim,","poem":1},{"lineBreak":true},{"text":"Başıma tac edərdim.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Onda atdığım hər addımı Allaha bildirərdim,","poem":1},{"lineBreak":true},{"text":"Mən bir şahzadə kimi Onun yanına gedərdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Torpağım da məndən fəryad edirsə,","poem":1},{"lineBreak":true},{"text":"Kotanın açdığı yarıqlar əlimdən bir ağızdan ağlayırsa,","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Pulunu vermədən məhsulu yemişəmsə,","poem":1},{"lineBreak":true},{"text":"Buranın sakinlərinin ürəyini qırmışamsa,","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Qoy sahəmdə buğda yerinə tikan,","poem":1},{"lineBreak":true},{"text":"Arpa yerinə alaq bitsin».","poem":1},{"lineBreak":true},{"text":"Əyyubun söhbəti sona yetdi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}