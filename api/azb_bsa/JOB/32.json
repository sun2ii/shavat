{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Elihu"]},{"type":"verse","number":1,"content":["Beləliklə, bu üç kişi artıq Əyyuba cavab verməyi dayandırdı, çünki Əyyub öz gözündə saleh idi."]},{"type":"verse","number":2,"content":["Amma Əyyub özünü Allahdan da saleh saydığı üçün Ram nəslindən Buzlu Barakelin oğlu Elihu ona qarşı qəzəbdən alovlandı."]},{"type":"verse","number":3,"content":["Elihu Əyyubun üç dostuna görə də hirsindən alışıb-yandı, çünki düzgün cavab tapmayıb Əyyubu günahkar çıxartdılar."]},{"type":"verse","number":4,"content":["Elihu Əyyubla danışmaq üçün növbəsini gözləyirdi, çünki əvvəlkilər yaşca ondan böyük idi."]},{"type":"verse","number":5,"content":["Bu üç nəfərin daha sözü qalmadığını görəndə o, hirsindən alışıb-yandı."]},{"type":"verse","number":6,"content":["Buzlu Barakelin oğlu Elihu belə dedi:",{"text":"«Mən yaşca kiçiyəm, sizsə yaşlısınız.","poem":1},{"lineBreak":true},{"text":"Ona görə çəkindim,","poem":1},{"lineBreak":true},{"text":"Bildiyimi sizə söyləməyə qorxdum.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dedim “qoy danışsın çox uzun ömür sürənlər,","poem":1},{"lineBreak":true},{"text":"Qoy hikmət öyrətsin çox illərin şahidləri”.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Həqiqətən, insanda olan ruh,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın nəfəsi insana ağıl verir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hikmət yaşda olmaz,","poem":1},{"lineBreak":true},{"text":"Ədaləti dərk etmək yaşa baxmaz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ona görə deyirəm ki, məni dinləyin,","poem":1},{"lineBreak":true},{"text":"Qoy mən də bildiyimi söyləyim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Siz danışarkən mən gözlədim,","poem":1},{"lineBreak":true},{"text":"Siz sözləri araşdırarkən fikirlərinizi dinlədim.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bütün diqqətimi sizə tərəf çevirdim,","poem":1},{"lineBreak":true},{"text":"Amma heç biriniz Əyyuba haqsızlığını sübut etmədiniz,","poem":1},{"lineBreak":true},{"text":"Onun dediklərinə cavab vermədiniz.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əsla deməyin ki, hikmət tapmışıq,","poem":1},{"lineBreak":true},{"text":"Haqsızlığını insan yox, Allah ona sübut etsin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amma Əyyubun sözlərinin hədəfi mən deyiləm,","poem":1},{"lineBreak":true},{"text":"Sizin sözlərinizlə ona cavab verməyəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Onlar məəttəl qaldılar.","poem":1},{"lineBreak":true},{"text":"Artıq cavab tapmadılar.","poem":1},{"lineBreak":true},{"text":"Deməyə sözləri qalmadı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onlar danışmırlar, dayanıblar,","poem":1},{"lineBreak":true},{"text":"Cavab vermirlər deyə","poem":1},{"lineBreak":true},{"text":"Mən gözləməliyəmmi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amma deməyə sözüm var,","poem":1},{"lineBreak":true},{"text":"Mən də bildiyimi söyləyim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki sinəm sözlə doludur,","poem":1},{"lineBreak":true},{"text":"Köksümdəki ruh məni sıxır,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Az qalır açılmamış şərab kimi,","poem":1},{"lineBreak":true},{"text":"Təzə tuluqlar kimi bağrım çatlasın.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qoy danışım, rahatca nəfəs alaram,","poem":1},{"lineBreak":true},{"text":"Dil açıb cavab verim.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Heç kimin tərəfini saxlamayacağam,","poem":1},{"lineBreak":true},{"text":"Heç kimə yaltaqlıq etməyəcəyəm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki yaltaqlıq nədir bilmərəm,","poem":1},{"lineBreak":true},{"text":"Yoxsa Yaradanım məni yox edər.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}