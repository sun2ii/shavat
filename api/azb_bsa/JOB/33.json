{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Əyyub, indisə mənim sözümü dinlə,","poem":1},{"lineBreak":true},{"text":"Hər kəlməmə qulaq as.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bax ağzımı açıram,","poem":1},{"lineBreak":true},{"text":"Dilim bu sözləri deyir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sözlərim səmimi ürəkdən gəlir,","poem":1},{"lineBreak":true},{"text":"Dodaqlarım biliyi doğru söyləyir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məni Allahın Ruhu yaratdı,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın nəfəsi mənə həyat verdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əgər əlindən gəlirsə, mənə cavab ver,","poem":1},{"lineBreak":true},{"text":"Sıraya düz sözlərini, qarşımda dayan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mən də Allahın nəzərində sənin kimiyəm,","poem":1},{"lineBreak":true},{"text":"Mən də palçıqdan düzəldilmişəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dəhşətimdən vahiməyə düşmə,","poem":1},{"lineBreak":true},{"text":"Bu hücumum sənə ağır gəlməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Həqiqətən, səsin hələ qulaqlarımdadır,","poem":1},{"lineBreak":true},{"text":"Belə demişdin:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Pakam, günahsızam,","poem":1},{"lineBreak":true},{"text":"Təmizəm, təqsirsizəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yenə də Allah mənə qarşı bəhanə axtarır,","poem":1},{"lineBreak":true},{"text":"Məni Özünə düşmən sayır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ayaqlarımı buxovlayır,","poem":1},{"lineBreak":true},{"text":"Bütün yollarıma göz qoyur”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amma qoy bunu sənə söyləyim ki,","poem":1},{"lineBreak":true},{"text":"Sən bu barədə haqsızsan,","poem":1},{"lineBreak":true},{"text":"Çünki Allah insandan böyükdür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"İnsanın heç bir sözünə cavab vermir deyə","poem":1},{"lineBreak":true},{"text":"Niyə Onunla çəkişirsən?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki insan anlamasa da,","poem":1},{"lineBreak":true},{"text":"Allah bu və ya digər yolla danışır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yuxuda, gecə röyalarında,","poem":1},{"lineBreak":true},{"text":"İnsanlar dərin yuxuya qərq olanda,","poem":1},{"lineBreak":true},{"text":"Yataqda yatanda","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"İnsanın qulağını açır,","poem":1},{"lineBreak":true},{"text":"Xəbərdarlıq edərək onu qorxudur ki,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"İnsan şər iş görməkdən dönsün,","poem":1},{"lineBreak":true},{"text":"Təkəbbürdən uzaq olsun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"İnsanın canını quyudan,","poem":1},{"lineBreak":true},{"text":"Həyatını qılıncla həlak olmaqdan qurtarır,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"İnsanı yatağında ağrılarla,","poem":1},{"lineBreak":true},{"text":"Sümüklərini kəsilməyən sızıltılarla yola gətirir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Belə ki könlündən yemək keçmir,","poem":1},{"lineBreak":true},{"text":"Ən ləziz yeməkdən iyrənir.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əti tökülür, görünməz hala düşür.","poem":1},{"lineBreak":true},{"text":"Görünməyən sümükləri üzə çıxır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Canı quyuya,","poem":1},{"lineBreak":true},{"text":"Həyatı ölüm mələklərinə yaxınlaşır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"İnsana əməlisalehliyini bəyan etmək üçün","poem":1},{"lineBreak":true},{"text":"Min mələyin içindən bir mələk, bir vasitəçi olsa,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"O zaman Allah ona rəhm edib deyər:","poem":1},{"lineBreak":true},{"text":"“Onu quyuya düşməkdən qurtar,","poem":1},{"lineBreak":true},{"text":"Onun üçün kəffarə tapmışam”.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Onda bədəni uşaq bədəni kimi təzə olar,","poem":1},{"lineBreak":true},{"text":"Yeniyetməlik dövrünə qayıdar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dua edəndə Allah ondan razı qalar,","poem":1},{"lineBreak":true},{"text":"Sevinərək Allahın üzünü görər,","poem":1},{"lineBreak":true},{"text":"Allah onun vəziyyətini düzəldər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sonra insanların önündə nəğmə söyləyər:","poem":1},{"lineBreak":true},{"text":"“Günah işlədib doğru yoldan azmışdım,","poem":1},{"lineBreak":true},{"text":"Allah mənə layiq olduğum cəzanı vermədi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Canımı quyuya düşməkdən qurtardı,","poem":1},{"lineBreak":true},{"text":"Həyatım nur görəcək”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bax Allah bütün bunları insanlara","poem":1},{"lineBreak":true},{"text":"Ya iki dəfə ya da üç dəfə edər ki,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Onların canını quyudan xilas etsin,","poem":1},{"lineBreak":true},{"text":"Onlar həyatın nurunu görsün.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yaxşı dinlə, Əyyub, bir qulaq as,","poem":1},{"lineBreak":true},{"text":"Sakit ol, qoy danışım.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Əgər deməyə sözün varsa, mənə cavab ver,","poem":1},{"lineBreak":true},{"text":"Danış, çünki səni haqlı çıxarmaq istəyirəm.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Sözün yoxsa, mənə qulaq as,","poem":1},{"lineBreak":true},{"text":"Sakit ol, qoy sənə hikmət öyrədim».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}