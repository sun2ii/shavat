{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Elihu söhbətini belə davam etdirdi:"]},{"type":"verse","number":2,"content":[{"text":"«Ey hikmətlilər, sözlərimi dinləyin,","poem":1},{"lineBreak":true},{"text":"Ey çoxbilənlər, məni eşidin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki damaq yeməyin dadını bildiyi kimi","poem":1},{"lineBreak":true},{"text":"Qulaq da sözləri müəyyən edir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gəlin doğrunu seçək,","poem":1},{"lineBreak":true},{"text":"Birlikdə yaxşını öyrənək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki Əyyub deyir: “Mən günahsızam,","poem":1},{"lineBreak":true},{"text":"Allah isə əlimdən haqqımı aldı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Haqlı olduğum halda yalançı sayılıram,","poem":1},{"lineBreak":true},{"text":"Bir təqsirim yox ikən oxundan sağalmaz yara aldım”.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Əyyub kimi şəxsiyyət varmı?","poem":1},{"lineBreak":true},{"text":"O, kinayəni su kimi içir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pislik edənlərlə yoldaşlıq edib gəzir,","poem":1},{"lineBreak":true},{"text":"Pis adamlarla yol gedir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki “çalışıb Allahı razı salmaq","poem":1},{"lineBreak":true},{"text":"İnsana xeyir gətirməz” deyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Buna görə, ey dərrakəli insanlar, məni dinləyin!","poem":1},{"lineBreak":true},{"text":"Məgər Allah pislik edərmi?","poem":1},{"lineBreak":true},{"text":"Məgər Külli-İxtiyar haqsızlıq edərmi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki O hər kəsə əməlinin əvəzini verir,","poem":1},{"lineBreak":true},{"text":"Qazandığını başına gətirir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Məgər Allah pislik edir?","poem":1},{"lineBreak":true},{"text":"Məgər Külli-İxtiyar haqsızlıq edir?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ona bütün dünyanı kim təslim etdi?","poem":1},{"lineBreak":true},{"text":"Kim Onu yer üzərində təyin etdi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Əgər qəsdinə durub","poem":1},{"lineBreak":true},{"text":"Ruhunu, nəfəsini geri çəkərsə,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bir anda bütün bəşər yox olar,","poem":1},{"lineBreak":true},{"text":"İnsan torpağa qayıdar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Əgər düşüncən varsa, bunları dinlə,","poem":1},{"lineBreak":true},{"text":"Sözlərimi eşit.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ədalətə nifrət edən səltənət sürə bilərmi?","poem":1},{"lineBreak":true},{"text":"Adil və qüdrəti Olanımı məhkum edəcəksən?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Padşahlara “yaramazsınız”,","poem":1},{"lineBreak":true},{"text":"Əsilzadələrə “şərsiniz” deyən,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Başçılar arasında tərəfkeşlik etməyən,","poem":1},{"lineBreak":true},{"text":"Varlını yoxsuldan üstün saymayan","poem":1},{"lineBreak":true},{"text":"O deyilmi?","poem":1},{"lineBreak":true},{"text":"Çünki hamını Onun əlləri yaratdı,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hamı bir an içində, bir gecə yarısı ölüb gedir,","poem":1},{"lineBreak":true},{"text":"Xalq lərzəyə gəlib ölür.","poem":1},{"lineBreak":true},{"text":"Güclülər belə, əl dəyməmiş aradan götürülür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Allah gözlərini insanların yolundan çəkmir,","poem":1},{"lineBreak":true},{"text":"Atdıqları hər addımı görür.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Şər iş görənlərin gizlənəcəyi","poem":1},{"lineBreak":true},{"text":"Nə qaranlıq, nə də zülmət yeri var.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hökm üçün hüzuruna gəlsinlər deyə","poem":1},{"lineBreak":true},{"text":"Allah insana nəzarət etmək üçün ehtiyac duymur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"İstintaq etmədən güclü insanları qırır,","poem":1},{"lineBreak":true},{"text":"Onların yerinə başqalarını qoyur.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çünki onların işlərini bilir,","poem":1},{"lineBreak":true},{"text":"Bir gecə onları alt-üst edir, onlar əzilir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hamının gözü önündə","poem":1},{"lineBreak":true},{"text":"Pislikləri üzündən onlara cəza verir.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Çünki Onun ardınca getmədilər,","poem":1},{"lineBreak":true},{"text":"Yollarının heç birinə fikir vermədilər.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ona görə yoxsulların fəryadı Onun hüzuruna yetdi,","poem":1},{"lineBreak":true},{"text":"O, fəqirlərin fəryadını eşitdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Amma Allah səssiz dursa, kim Onu ittiham edə bilər?","poem":1},{"lineBreak":true},{"text":"Üzünü gizlədərsə, kim Onu görə bilər?","poem":1},{"lineBreak":true},{"text":"Hər millət, hər insan üçün O eynidir ki,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Allahsız insan hökmranlıq etməsin,","poem":1},{"lineBreak":true},{"text":"Xalqa tələ qurmasın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Allaha deyən olubmu:","poem":1},{"lineBreak":true},{"text":"“Günahkaram, bir də pis iş görməyəcəyəm?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Görmədiyimi mənə göstər,","poem":1},{"lineBreak":true},{"text":"Haqsızlıq etmişəmsə, bir də etmərəm”.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Onu atdığın halda sənə","poem":1},{"lineBreak":true},{"text":"Kefin istəyən əvəz verməlidirmi?","poem":1},{"lineBreak":true},{"text":"Qərar verən sənsən, mən deyiləm,","poem":1},{"lineBreak":true},{"text":"İndi bildiyini mənə söylə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Dərrakəli insanlar,","poem":1},{"lineBreak":true},{"text":"Məni dinləyən müdrik adamlar deyəcək:","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"“Əyyub avam-avam danışır,","poem":1},{"lineBreak":true},{"text":"Sözlərinin mənası yoxdur”.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Bir şər adam kimi cavab verdiyi üçün","poem":1},{"lineBreak":true},{"text":"Qoy Əyyub axıradək sınaqda olsun!","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Çünki günahına üsyankarlıq da artırır,","poem":1},{"lineBreak":true},{"text":"Qarşımızda elə bil rişxənd edərək əl çalır,","poem":1},{"lineBreak":true},{"text":"Allaha qarşı danışdıqca danışır».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}