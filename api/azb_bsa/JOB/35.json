{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihu sözünü belə davam etdirdi:"]},{"type":"verse","number":2,"content":[{"text":"«Allah önündə haqlı olduğunu deyirsən.","poem":1},{"lineBreak":true},{"text":"Bunun doğru olduğunumu düşünürsən?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bəs niyə soruşursan ki, “əgər günah işlətməsəm,","poem":1},{"lineBreak":true},{"text":"Bundan xeyrim, qazancım nə ola bilər?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Həm sənə, həm də dostlarına","poem":1},{"lineBreak":true},{"text":"Belə cavab verəcəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bir bax səmaya,","poem":1},{"lineBreak":true},{"text":"Nəzər sal başının üstündəki buludlara.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Günah işlətsən, bunun Allaha nə ziyanı dəyər?","poem":1},{"lineBreak":true},{"text":"Nə qədər üsyankar olsan da, Ona bir şey olarmı?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin salehliyin Ona nə verir?","poem":1},{"lineBreak":true},{"text":"Yaxud da O, əlindən nəyi alıb götürür?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pisliyin özün kimisinə ziyan vurur,","poem":1},{"lineBreak":true},{"text":"Salehliyin isə bəşər oğlu üçündür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İnsanlar ağır təzyiq altında fəryad edir,","poem":1},{"lineBreak":true},{"text":"Güclülərə qarşı yardım istəyir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amma deyən yoxdur: “Hanı məni yaradan Allah?","poem":1},{"lineBreak":true},{"text":"Hanı bizə gecələr ilahilər oxutduran Allah?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O bizi yer üzünün heyvanlarından çox öyrədib,","poem":1},{"lineBreak":true},{"text":"Bizə göydəki quşlardan daha çox hikmət verib”.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Orada pislərin qüruru üzündən","poem":1},{"lineBreak":true},{"text":"İnsanlar fəryad edir,","poem":1},{"lineBreak":true},{"text":"Amma Allah cavab vermir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əslində Allah boş fəryadı dinləmir,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyar buna əhəmiyyət vermir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən onu görmədiyini söylədiyin anda belə,","poem":1},{"lineBreak":true},{"text":"Mübahisən önündədir, Onu gözlə.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"İndi qəzəblənib cəzalandırmırsa,","poem":1},{"lineBreak":true},{"text":"Təqsirin çoxluğuna baxmır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ona görə Əyyub boş yerə ağzını yorur,","poem":1},{"lineBreak":true},{"text":"Avam-avam danışdıqca danışır».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}