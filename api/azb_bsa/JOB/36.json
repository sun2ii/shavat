{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Elihu sözünü belə davam etdirdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bir az səbir elə, sənə izah edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki Allah barədə deyiləcək çox sözüm var.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Geniş məlumat toplayacağam,","poem":1},{"lineBreak":true},{"text":"Yaradanıma haqq verəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dediyimin heç biri, şübhəsiz, yalan deyil,","poem":1},{"lineBreak":true},{"text":"Qarşında dayanan kamil bilicidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allah güclüdür, kimsəyə xor baxmaz,","poem":1},{"lineBreak":true},{"text":"Güclüdür, dərin şüura malikdir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pis adamları yaşatmaz,","poem":1},{"lineBreak":true},{"text":"Fəqirlərin haqqını verər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Salehdən gözünü çəkməz,","poem":1},{"lineBreak":true},{"text":"Onu padşahlarla birgə taxtda oturdar,","poem":1},{"lineBreak":true},{"text":"Əbədilik ucaldar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amma əgər insanlar zəncirlənib","poem":1},{"lineBreak":true},{"text":"Təzyiq altında saxlanarsa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlara əməllərini, günahlarını göstərər,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü rəftar etdiklərini bildirər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Öyüdlərini eşitdirər,","poem":1},{"lineBreak":true},{"text":"Pislikdən dönmələrini əmr edər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əgər Ona qulaq asıb qulluq edərlərsə,","poem":1},{"lineBreak":true},{"text":"Qalan günlərini bolluq içində yaşarlar,","poem":1},{"lineBreak":true},{"text":"Qalan illərini əmin-amanlıqda yaşarlar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qulaq asmazlarsa, qılıncdan keçirilərlər,","poem":1},{"lineBreak":true},{"text":"Cəhalət içində canları çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Allahsızlar ürəklərində kin saxlayırlar,","poem":1},{"lineBreak":true},{"text":"Allah onları qandallayanda belə, Onu çağırmırlar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vaxtsız ölüb gedərlər,","poem":1},{"lineBreak":true},{"text":"Şərəfsiz ömür sürərlər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amma Allah əzabkeşləri əzablarından xilas edər,","poem":1},{"lineBreak":true},{"text":"Dara düşəndə onlara səsini eşitdirər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bəli, O səni çətinlikdən","poem":1},{"lineBreak":true},{"text":"Darısqal olmayan geniş yerə,","poem":1},{"lineBreak":true},{"text":"Yağlı yeməklərlə bəzənmiş süfrəyə çıxarar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amma şərin hökmü vücuduna dolar,","poem":1},{"lineBreak":true},{"text":"Haqq-ədalət isə yaxandan tutar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ehtiyatlı ol, qoy pul səni başdan çıxarmasın,","poem":1},{"lineBreak":true},{"text":"Rüşvətin böyüklüyünü görüb azmayasan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Səni dardan qurtarmağa,","poem":1},{"lineBreak":true},{"text":"Varının, yoxsa qüdrətinin gücü çatarmı?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xalqların öz yerlərindən","poem":1},{"lineBreak":true},{"text":"Yox edildiyi gecənin həsrətini çəkmə.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ehtiyatlı ol ki, şərə tərəf dönməyəsən,","poem":1},{"lineBreak":true},{"text":"Çünki zəlil olmaqdan çox bunu seçmisən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Budur, Allah əzəməti ilə ucalır,","poem":1},{"lineBreak":true},{"text":"Onun kimi müəllim haradadır?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kim Ona nə etməsinin lazım olduğunu söyləyə bilər?","poem":1},{"lineBreak":true},{"text":"Kim Ona “haqsızsan” deyə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Onun işlərini yada sal,","poem":1},{"lineBreak":true},{"text":"İnsanların ilahilərlə tərənnüm etdiyi işləri mədh etməlisən.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bütün insanlar bunu görür,","poem":1},{"lineBreak":true},{"text":"Hamı bu işləri uzaqdan seyr edir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bəli, Allah çox böyükdür, Onu tanıya bilmirik,","poem":1},{"lineBreak":true},{"text":"İllərinin sayını araşdıran yoxdur.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Su damcılarını yuxarı qaldırır,","poem":1},{"lineBreak":true},{"text":"Buxarlandırır, yağış yağdırır.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bu yağışlar buludlardan tökülür,","poem":1},{"lineBreak":true},{"text":"İnsanların üstünə bol yağışlar səpilir.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Buludların necə yayılmasını,","poem":1},{"lineBreak":true},{"text":"Göylərin çadırında guruldamasını","poem":1},{"lineBreak":true},{"text":"Kim dərk edə bilər?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Baxın, ətrafında şimşəkləri çaxdırır,","poem":1},{"lineBreak":true},{"text":"Dənizin dərinliklərini doldurur.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Allah xalqlara rəhbərlik edir,","poem":1},{"lineBreak":true},{"text":"Onları bol ərzaqla təmin edir.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Şimşəyi əlləri ilə tutur,","poem":1},{"lineBreak":true},{"text":"Hədəfə vurmasını buyurur.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Gurultusu qasırğadan xəbər verir,","poem":1},{"lineBreak":true},{"text":"Qasırğanın qopacağını öküzlərə belə, bildirir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}