{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"Bundan qəlbim çırpınıb yerindən oynayır,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dinləyin! Gurlayan səsini dinləyin,","poem":1},{"lineBreak":true},{"text":"Ağzından çıxan harayını eşidin!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Göy altında, hər yanda səs salır,","poem":1},{"lineBreak":true},{"text":"Yer üzünün dörd bucağında şimşəyini çaxdırır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ardınca nərə vurur,","poem":1},{"lineBreak":true},{"text":"Əzəmətli səsi ilə gurlayır,","poem":1},{"lineBreak":true},{"text":"Həniri eşidilir, dayanmadan şimşək çaxır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allahın səsi heyrətamiz şəkildə gurlayır,","poem":1},{"lineBreak":true},{"text":"O bizə məlum olmayan böyük işlər görür.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki “yerə yağ” deyə qara əmr edir,","poem":1},{"lineBreak":true},{"text":"Leysana “şiddətlə tökül” deyir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaratdığı bütün insanlar Onun işlərini bilsinlər deyə","poem":1},{"lineBreak":true},{"text":"Hər kəsin əlini işdən saxlayır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Heyvanlar yuvalarına çəkilir,","poem":1},{"lineBreak":true},{"text":"Öz yerlərində qalır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tufan otağından çıxır,","poem":1},{"lineBreak":true},{"text":"Soyuq şimal yellərindən gəlir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Allahın nəfəsi suları dondurur,","poem":1},{"lineBreak":true},{"text":"Ümman sular buz bağlayır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buludlara nəm çəkdirərək yükləyir,","poem":1},{"lineBreak":true},{"text":"Buludlar içindən şimşək səpələyir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buludlar yer üzündə əmrini yerinə yetirmək üçün","poem":1},{"lineBreak":true},{"text":"Onun istəyi istiqamətində dönüb fırlanır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bəzən insanları cəzalandırmaq üçün,","poem":1},{"lineBreak":true},{"text":"Bəzən torpağı suvarmaq üçün,","poem":1},{"lineBreak":true},{"text":"Bəzən də sevgisini göstərmək üçün yağış göndərir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Əyyub, bunu dinlə,","poem":1},{"lineBreak":true},{"text":"Bir dayan, Allahın heyrətamiz işlərindən düşün.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Allahın buludlar üçün necə nizam qurduğunu bilirsənmi?","poem":1},{"lineBreak":true},{"text":"Buludlarındakı şimşəkdən necə od çıxır?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Buludların tarazlığını,","poem":1},{"lineBreak":true},{"text":"Kamil biliyə malik olanın heyrətamiz işlərini bilirsənmi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Səmum küləyi dünyanın nəfəsini kəsərkən","poem":1},{"lineBreak":true},{"text":"Paltarın içərisində istidən huşunu itirirsən.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tökmə bürünc ayna kimi möhkəm olan göy qübbəsini","poem":1},{"lineBreak":true},{"text":"Allahla birlikdə sərə bilirsənmi?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ona nə deyəcəyimizi bizə öyrət,","poem":1},{"lineBreak":true},{"text":"Çünki cəhalətimiz üzündən sözlərimiz nizamsızdır.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onunla danışmaq istərəm, bu Ona xəbər verilərmi?","poem":1},{"lineBreak":true},{"text":"Kimsə udulmasını istərmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Külək qurtaranda, göyü təmizləyəndə","poem":1},{"lineBreak":true},{"text":"Göydə parlayan işığa kimsə baxmaz.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Şimaldan qızılı parıltı görünür,","poem":1},{"lineBreak":true},{"text":"Allah qüdrətli əzəmətində gəlir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Biz Külli-İxtiyarı tapa bilmərik,","poem":1},{"lineBreak":true},{"text":"Qüvvəti möhtəşəmdir.","poem":1},{"lineBreak":true},{"text":"Salehliyi misilsizdir, ədalətlidir,","poem":1},{"lineBreak":true},{"text":"Heç haqsızlıq etmir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Buna görə insanlar Ondan qorxar,","poem":1},{"lineBreak":true},{"text":"O özünü hikmətli sayanlara baxmaz».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}