{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Allah danışır"]},{"type":"verse","number":1,"content":["O zaman Rəbb qasırğanın içindən Əyyuba belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Məsləhəti savadsız sözlərlə qaranlığa salan bu kimdir?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İndi kişi kimi belinə qurşaq bağla,","poem":1},{"lineBreak":true},{"text":"Sual verəcəyəm, Mənə cavab ver.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mən yerin təməlini qoyarkən haradaydın?","poem":1},{"lineBreak":true},{"text":"Anlayışın varsa, söylə.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İndi ki bilirsən,","poem":1},{"lineBreak":true},{"text":"De görüm, yerin ölçüsünü kim qoydu,","poem":1},{"lineBreak":true},{"text":"Yaxud yer üstündə ölçü xəttini kim çəkdi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nəyin üstündə onun təməlləri quruldu?","poem":1},{"lineBreak":true},{"text":"Kim onun guşədaşını qoydu?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onda dan ulduzları birgə nəğmə oxuyurdu,","poem":1},{"lineBreak":true},{"text":"Bütün ilahi varlıqlar sevincdən haray salırdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dəniz bətndən çıxıb fışqırarkən","poem":1},{"lineBreak":true},{"text":"Onu qapılar arasında kim bağladı?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ona buludları libas,","poem":1},{"lineBreak":true},{"text":"Qatı qaranlıqları qundaq etdim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onun sərhədini çəkdim,","poem":1},{"lineBreak":true},{"text":"Qapı və cəftələrini qoydum.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O vaxt dedim: “Buraya qədər gəlib o tərəfə çıxmayacaqsan,","poem":1},{"lineBreak":true},{"text":"Qürurlu dalğaların burada dursun”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sən ömründə səhərə buyruq verdinmi?","poem":1},{"lineBreak":true},{"text":"Şəfəqə yerini göstərdinmi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Belə ki yer üzünün ucqarlarını tutsun,","poem":1},{"lineBreak":true},{"text":"Üstündən pisləri çırpıb atsın.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Torpağın quruluşu dəyişir,","poem":1},{"lineBreak":true},{"text":"Möhür vurulanda palçıqda əksi qalan kimi,","poem":1},{"lineBreak":true},{"text":"Libasdakı qırışlar kimi gözə görünür.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pislərin nuru batırılar,","poem":1},{"lineBreak":true},{"text":"Qaldırdıqları qolları qırılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dənizin mənbələrinə getmisənmi?","poem":1},{"lineBreak":true},{"text":"Dərinliyin dibində gəzmisənmi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ölüm dərgahı sənə göstərilibmi?","poem":1},{"lineBreak":true},{"text":"Ölüm kölgəsinin qapılarını görmüsənmi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dünyanın həcmini dərk edə bilirsənmi?","poem":1},{"lineBreak":true},{"text":"De görüm, bunların hamısını bilirsənmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"İşıq məskəninə gedən yol haradadır?","poem":1},{"lineBreak":true},{"text":"Qaranlığın yeri haradadır?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onları yerlərinə apara bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Evlərinin yolunu bilirsənmi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əlbəttə, heç nə anlamırsan,","poem":1},{"lineBreak":true},{"text":"Çünki onlarla eyni vaxtda doğulmusan!","poem":1},{"lineBreak":true},{"text":"Yaşın bu qədərdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Qar anbarlarına girmisənmi?","poem":1},{"lineBreak":true},{"text":"Dolu anbarlarını görmüsənmi?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mən onları dar gün üçün,","poem":1},{"lineBreak":true},{"text":"Döyüş və müharibə günləri üçün saxlayıram.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hansı yolla işıq yayılar,","poem":1},{"lineBreak":true},{"text":"Yer üzündə şərq küləyi qopar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kim sellər üçün arx,","poem":1},{"lineBreak":true},{"text":"İldırım üçün yol açdı ki,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kimsəsiz yerləri,","poem":1},{"lineBreak":true},{"text":"İnsan yaşamayan çölləri sulasın,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Səhralar – biyabanlar doyunca su içsin,","poem":1},{"lineBreak":true},{"text":"Yaşıl ot bitsin?","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yağışın atası varmı?","poem":1},{"lineBreak":true},{"text":"Şeh damlalarını kim yaratdı?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Buz kimin bətnindən çıxdı?","poem":1},{"lineBreak":true},{"text":"Göylərdən düşən şaxtanı kim doğdu?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sular nə zaman daş kimi bərkiyir,","poem":1},{"lineBreak":true},{"text":"Dərinliklərin səthi donur?","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ülkər ulduzlarını bağlaya bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Orionun bağlarını aça bilərsənmi?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Hər bürcü öz vaxtında çıxara bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Böyük, Kiçik Ayı bürcünə yol göstərə bilərsənmi?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Göylərin qanunlarını bilirsənmi?","poem":1},{"lineBreak":true},{"text":"Allahın hakimiyyətini yer üzərində qura bilərsənmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Başına bol yağış yağsın deyə","poem":1},{"lineBreak":true},{"text":"Buludları səsləyə bilərsənmi?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Şimşəkləri göndərə bilərsənmi getsinlər,","poem":1},{"lineBreak":true},{"text":"Sənə də “bax buradayıq” desinlər?","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kim ürəyə hikmət qoydu,","poem":1},{"lineBreak":true},{"text":"Dərk etmək üçün şüur verdi?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Kim buludları ağılla saya bilər?","poem":1},{"lineBreak":true},{"text":"Göyün tuluqlarını kim boşalda bilər?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Onda toz yatıb yer bərkiyər,","poem":1},{"lineBreak":true},{"text":"Kəsəklər bir-birinə yapışar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Dişi aslanlar üçün ov ovlaya bilərsənmi,","poem":1},{"lineBreak":true},{"text":"Gənc aslanların qarnını doyura bilərsənmi","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Yuvalarına girəndə,","poem":1},{"lineBreak":true},{"text":"Kolluqda pusqu quranda?","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Kim qarğaya yem verə bilər","poem":1},{"lineBreak":true},{"text":"Balaları Allaha fəryad edəndə,","poem":1},{"lineBreak":true},{"text":"Acından vurnuxanda?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}