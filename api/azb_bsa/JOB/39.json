{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Dağ keçilərinin nə vaxt doğduğunu bilirsənmi?","poem":1},{"lineBreak":true},{"text":"Maralların balalamasının vaxtını sən gözləyirsənmi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar boğaz olanda ayını-gününü sən sayırsanmı?","poem":1},{"lineBreak":true},{"text":"Nə vaxt doğacaqlarını bilirsənmi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diz çöküb balalarını doğar,","poem":1},{"lineBreak":true},{"text":"Ağrılardan qurtarar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Balaları çöldə böyüyüb güc alar,","poem":1},{"lineBreak":true},{"text":"Gedər, geri qayıtmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kim vəhşi eşşəyi azad buraxdı?","poem":1},{"lineBreak":true},{"text":"Kim onun iplərini açdı?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ona çölləri məskən verdim,","poem":1},{"lineBreak":true},{"text":"Şoran düzləri ona yurd etdim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, şəhərdəki izdihama gülər,","poem":1},{"lineBreak":true},{"text":"Sahibinin hay-küyünü eşitməz.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Təpələri dolaşıb otlar,","poem":1},{"lineBreak":true},{"text":"Yaşıllığı axtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Çöl öküzü sənə xidmət etmək istəyərmi?","poem":1},{"lineBreak":true},{"text":"Gecəni sənin axurunda keçirərmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kotan sürsün deyə onu boyunduruğa sala bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Ardınca dərələrdə şırım aça bilərmi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onun hədsiz gücünə bel bağlaya bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Ona ağır iş gördürə bilərsənmi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çöl öküzünə etibar edə bilərsən ki,","poem":1},{"lineBreak":true},{"text":"Əkininin məhsulunu daşısın,","poem":1},{"lineBreak":true},{"text":"Onu xırmanına yığsın?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dəvəquşu qanadını sevinclə çırpar,","poem":1},{"lineBreak":true},{"text":"Amma onun qanadı nə leyləyin qanadları ilə,","poem":1},{"lineBreak":true},{"text":"Nə də ki pərləri ilə müqayisə olunur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yerdə yumurtalayır,","poem":1},{"lineBreak":true},{"text":"Onları toz-torpaq üstündə qızdırır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yadından çıxarır ki, yumurtalar ayaq altında sınır,","poem":1},{"lineBreak":true},{"text":"Çöl heyvanlarının ayağı altında qalır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Balaları ilə elə sərt rəftar edir ki,","poem":1},{"lineBreak":true},{"text":"Elə bil özününkü deyil,","poem":1},{"lineBreak":true},{"text":"Çəkdiyi zəhmətin boşa getməsindən narahat olmaz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki Allah ona müdriklik verməyib,","poem":1},{"lineBreak":true},{"text":"Ona dərrakə bəxş etməyib.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qaçmaq üçün yenə qanad açanda","poem":1},{"lineBreak":true},{"text":"Ata və atlıya gülər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ata güc verən sənsənmi?","poem":1},{"lineBreak":true},{"text":"Boynuna yalı qoyan sənsənmi?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onu çəyirtkə kimi tullandıran sənsənmi?","poem":1},{"lineBreak":true},{"text":"Onun təmtəraqlı kişnəməsi xof salır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dərələrə ayağını bərk vurur,","poem":1},{"lineBreak":true},{"text":"Öz qüvvəsi ilə sevinib-coşur,","poem":1},{"lineBreak":true},{"text":"Silahlıların qabağına çıxır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qorxuya gülər, heç bir şeydən çəkinməz,","poem":1},{"lineBreak":true},{"text":"Qılınc qarşısında ayağını geri çəkməz.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onun üstündə oxdan cingildəyir,","poem":1},{"lineBreak":true},{"text":"Parlaq nizə və mizraq şimşək tək keçir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Coşanda qəzəblənib yeri-yurdu qapır,","poem":1},{"lineBreak":true},{"text":"Şeypur çalınan kimi yerindən dik atılır.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Şeypur çalınanda “hiaaa!” deyib kişnəyir,","poem":1},{"lineBreak":true},{"text":"Döyüş qoxusunu, sərkərdələrin gurlayan səsini,","poem":1},{"lineBreak":true},{"text":"Döyüşün nərəsini uzaqdan hiss edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Məgər qırğı sənin dərrakənləmi uçur,","poem":1},{"lineBreak":true},{"text":"Cənuba tərəf qanad açır?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Məgər qartal sənin əmrinləmi göyə qalxır,","poem":1},{"lineBreak":true},{"text":"Uca yerlərdə özünə yuva qurur?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sıldırım qayalarda yaşayır,","poem":1},{"lineBreak":true},{"text":"Şiş uclu qayalarda məskən salır.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Oradan şikarını axtarır,","poem":1},{"lineBreak":true},{"text":"Gözləri onları uzaqdan görür.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Onun balaları qanla qidalanır,","poem":1},{"lineBreak":true},{"text":"Harada leş olsa, o da oradadır».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}