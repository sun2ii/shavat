{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifaz"]},{"type":"verse","number":1,"content":["Temanlı Elifaz belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Kimsə sənə bir söz desə, inciyərsənmi?","poem":1},{"lineBreak":true},{"text":"Danışmasın deyə kim özünü saxlaya bilər?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bəli, çoxlarına dərs verdin,","poem":1},{"lineBreak":true},{"text":"Onları əlləri taqətdən düşərkən gücləndirdin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yıxılanları sözlərinlə qaldırdın,","poem":1},{"lineBreak":true},{"text":"Dizləri əsənlərə güc verdin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İndi bu iş başına gələrkən","poem":1},{"lineBreak":true},{"text":"Özün taqətdən düşdün,","poem":1},{"lineBreak":true},{"text":"Bəla sənə dəyəndə özünü itirdin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sən Allah xofuna etibar etmirdinmi?","poem":1},{"lineBreak":true},{"text":"Kamil həyatına ümid edən sən deyildinmi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kimdir günahsız məhv olan? İndi yada sal.","poem":1},{"lineBreak":true},{"text":"Əməlisalehlərin həlak olduğunu harada görmüsən?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mənim gördüyümə görə şər sahəsini belləyən,","poem":1},{"lineBreak":true},{"text":"Əzab toxumu səpən insanlar əkdiyini biçər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar Allahın nəfəsi ilə yox olar,","poem":1},{"lineBreak":true},{"text":"Qəzəbinin küləyi onları udar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aslanların nəfəsi, qızmış şirlərin səsi kəsildi,","poem":1},{"lineBreak":true},{"text":"Gənc aslanların dişləri qırıldı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Şikarı olmadığı üçün güclü aslan həlak olar,","poem":1},{"lineBreak":true},{"text":"Dişi aslanların balaları pərən-pərən qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mənə gizli bir söz çatdı,","poem":1},{"lineBreak":true},{"text":"Qulağım bir pıçıltı eşitdi,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gecə röyalardan doğan düşüncələr içində olanda,","poem":1},{"lineBreak":true},{"text":"İnsanların dərin yuxuya getdiyi zamanda","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Üstümə bir qorxu, bir titrətmə gəldi,","poem":1},{"lineBreak":true},{"text":"Bütün sümüklərimi lərzəyə saldı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qarşımdan bir ruh keçdi,","poem":1},{"lineBreak":true},{"text":"Bütün tüklərimi ürpətdi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ruh dayandı, bunun nə olduğunu bilmədim.","poem":1},{"lineBreak":true},{"text":"Gözlərimin önündə bir surət dururdu,","poem":1},{"lineBreak":true},{"text":"Sükunətin içindən bir səs eşitdim:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“İnsan Allah qarşısında saleh olarmı?","poem":1},{"lineBreak":true},{"text":"Yaradanın qarşısında təmiz adam varmı?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Allah bəndələrinə güvənmir,","poem":1},{"lineBreak":true},{"text":"Mələklərində belə, səhv görür.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Palçıq evlərdə yaşayanlara,","poem":1},{"lineBreak":true},{"text":"Mayası torpaqdan olanlara,","poem":1},{"lineBreak":true},{"text":"Güvədən də tez əzilənlərə O güvənərmi?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ömürləri səhərdən axşama çatmır,","poem":1},{"lineBreak":true},{"text":"Fərqi yoxdur, hamı əbədi yox olur.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yaşadıqları çadırın ipləri çəkiləndə","poem":1},{"lineBreak":true},{"text":"Heç nə anlamazlar, ölüb gedərlər”.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}