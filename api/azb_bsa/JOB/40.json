{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Rəbb Əyyuba belə dedi:"]},{"type":"verse","number":2,"content":[{"text":"«Kim ki tənbehə layiq görülür,","poem":1},{"lineBreak":true},{"text":"O, Külli-İxtiyarla mübahisə edə bilərmi?","poem":1},{"lineBreak":true},{"text":"Qoy buna Allahı ittiham edən cavab versin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Onda Əyyub Rəbbə belə cavab verdi:"]},{"type":"verse","number":4,"content":[{"text":"«Mənim gərəksizliyimə bax,","poem":1},{"lineBreak":true},{"text":"Sənə necə cavab verim,","poem":1},{"lineBreak":true},{"text":"Ağzımı əlimlə tutmuşam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bir dəfə danışdım, daha cavabım yoxdur,","poem":1},{"lineBreak":true},{"text":"Artıq ikinci dəfə nə danışım».","poem":1}]},{"type":"verse","number":6,"content":["Rəbb qasırğanın içindən Əyyuba cavab verdi:"]},{"type":"verse","number":7,"content":[{"text":"«İndi kişi kimi belinə qurşaq bağla,","poem":1},{"lineBreak":true},{"text":"Sual verəcəyəm, Mənə cavab ver.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sənmi ədalətimi boşa çıxaracaqsan?","poem":1},{"lineBreak":true},{"text":"Özünə haqq qazandırmaq üçün sənmi Məni günahlandıracaqsan?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Allahın qolu kimi qolun varmı?","poem":1},{"lineBreak":true},{"text":"Səsin Onunku kimi gurlayarmı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Əgər belədirsə, şərəfə, şana bürün,","poem":1},{"lineBreak":true},{"text":"Ehtişamı, əzəməti geyin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qoy qəzəbinin alovu saçsın,","poem":1},{"lineBreak":true},{"text":"Hər qürurluya baxıb onları alçalt.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qürurluların hamısına baxıb aşağı endir,","poem":1},{"lineBreak":true},{"text":"Pisləri yerindəcə təpiyinin altına sal.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hamısını birlikdə torpaq altında basdır,","poem":1},{"lineBreak":true},{"text":"Məzarda üzləri kəfənə bürünsün.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O zaman Mən də bunu qəbul edərəm,","poem":1},{"lineBreak":true},{"text":"Belə ki sağ qolun səni qurtarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Behemota","poem":1},{"noteId":4},{"text":"bax, öküz kimi ot yeyir,","poem":1},{"lineBreak":true},{"text":"Səni yaratdığım kimi onu da Mən yaratmışam,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gör belində nə qədər güc var,","poem":1},{"lineBreak":true},{"text":"Qarın əzələləri necə möhkəmdir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sallanan quyruğu sidr ağacına bənzəyir,","poem":1},{"lineBreak":true},{"text":"Budlarındakı vətərlər bir-birinə hörülüb.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sümükləri sanki tunc borudur,","poem":1},{"lineBreak":true},{"text":"Qabırğaları elə bil dəmir çubuqdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Allahın işləri arasında şah əsərdir,","poem":1},{"lineBreak":true},{"text":"Yalnız Yaradan ona qılıncla yaxınlaşa bilir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Təpələr məhsullarını ona verir,","poem":1},{"lineBreak":true},{"text":"Bütün çöl heyvanları yanında oynaşır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nilufərlərin altında,","poem":1},{"lineBreak":true},{"text":"Qamışla örtülü bataqlıqlarda yatır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nilufərlər üstünə kölgə salır,","poem":1},{"lineBreak":true},{"text":"Dərənin söyüdləri onu əhatəyə alır.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Coşğun çaylardan qorxmur,","poem":1},{"lineBreak":true},{"text":"Sellər boğazına çatsa da, arxayındır.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gözləri açıq ikən kim onu tuta bilər?","poem":1},{"lineBreak":true},{"text":"Kim qıra ilə onun burnunu deşər?","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":4,"caller":"+","text":"Behemot – bu gün bizə məlum olmayan nəhəng su heyvanı.","reference":{"chapter":40,"verse":15}}]},"thisChapterLink":"/api/azb_bsa/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}