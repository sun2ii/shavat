{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Məgər sən Livyatanı","poem":1},{"noteId":5},{"text":"qarmaqla çəkə bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Dilinə qaytan vura bilərsənmi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Burnuna ip taxa bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Qıra ilə çənəsini deşə bilərsənmi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənə yalvarıb-yaxararmı,","poem":1},{"lineBreak":true},{"text":"Səninlə şirin-şirin danışarmı?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əbədi qulun olmaq üçün","poem":1},{"lineBreak":true},{"text":"Səninlə əhd kəsərmi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quşla oynadığın kimi onunla oynaya bilərsənmi?","poem":1},{"lineBreak":true},{"text":"Boynuna ip bağlayıb onu qızların üçün apara bilərsənmi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Məgər tacirlər onu alıb-satarlarmı?","poem":1},{"lineBreak":true},{"text":"Aralarında bölə bilərlərmi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yabalarla dərisini,","poem":1},{"lineBreak":true},{"text":"Balıqçı neştərləri ilə başını doldura bilərsənmi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əlini onun üstünə qoy, nə cəncələ düşəcəyini təsəvvür et,","poem":1},{"lineBreak":true},{"text":"Onda bu işi bir daha görməzsən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onu tutmaq ümidin boş istəkdir.","poem":1},{"lineBreak":true},{"text":"Onun görkəmi adamı yıxmırmı?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onu oyatmaq üçün heç kimdə cəsarət yoxdur.","poem":1},{"lineBreak":true},{"text":"Bəs Mənim qarşımda kim dayana bilər?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kim Mənə bir şey verib ki, ona geri qaytarım?","poem":1},{"lineBreak":true},{"text":"Bax göylər altında hər şey Mənimdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sözümü kəsməyib onun əzalarından,","poem":1},{"lineBreak":true},{"text":"Möhkəm gücündən və gözəl görünüşündən deyəcəyəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Üstündəki paltarı kim çıxara bilər?","poem":1},{"lineBreak":true},{"text":"Qoşa cilovla kim ona yaxınlaşa bilər?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ağzının qapılarını kim aça bilər?","poem":1},{"lineBreak":true},{"text":"Çünki damağındakı dişlər dəhşətlidir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kürəyi nizamla düzülmüş qalxanlara oxşayır,","poem":1},{"lineBreak":true},{"text":"Onlar bir-birinə möhkəm bağlanıb,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bir-birlərinə elə bağlanıb ki,","poem":1},{"lineBreak":true},{"text":"Arasından hava keçməz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bir-birlərinə elə yapışıb ki,","poem":1},{"lineBreak":true},{"text":"Birdir, ayrılmaz.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asqıranda od sıçrayır,","poem":1},{"lineBreak":true},{"text":"Gözləri səhər işığı tək par-par yanır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ağzından alovlu məşəllər çıxır,","poem":1},{"lineBreak":true},{"text":"Qığılcımlar saçılır.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Burnunun deşiklərindən tüstü çıxır,","poem":1},{"lineBreak":true},{"text":"Elə bil qazan qaynayır, qamış yanır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nəfəsindən kömürlər közərir,","poem":1},{"lineBreak":true},{"text":"Ağzından alov çıxır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Boynunda qüvvət yaşayır,","poem":1},{"lineBreak":true},{"text":"Qabağında dəhşət oynayır.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ətinin qatları bir-birinə bitişib,","poem":1},{"lineBreak":true},{"text":"Oradan tərpənə bilməz, üstünə bərk yapışıb.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ürəyi daş kimi möhkəmdir,","poem":1},{"lineBreak":true},{"text":"Dəyirmanın alt daşı kimi bərkdir.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qalxanda güclülər lərzəyə gəlir,","poem":1},{"lineBreak":true},{"text":"Qorxub ürəkləri gedir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Üstünə qılınc çəkməyin faydasızdır,","poem":1},{"lineBreak":true},{"text":"Nizə, tir, mizraqdan kar aşmır.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dəmiri saman çöpü,","poem":1},{"lineBreak":true},{"text":"Tuncu çürük odun sayır.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"O, oxlardan qaçmır,","poem":1},{"lineBreak":true},{"text":"Sapanddan daş atsan, elə bilər ki, çöpdür.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dəyənəkləri küləş qırıntısı sanır,","poem":1},{"lineBreak":true},{"text":"Mizraqın vıyıltısına gülür.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qarnının altı sərt saxsıya oxşayır,","poem":1},{"lineBreak":true},{"text":"Palçıq üstə vəl kimi iz qoyur.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Dərin suları bir qazan kimi qaynadır,","poem":1},{"lineBreak":true},{"text":"Dənizi ətir küpünə döndərir,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Arxasınca parlaq bir iz buraxır,","poem":1},{"lineBreak":true},{"text":"İnsan bu dərinliyi ağaran saça oxşadır.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Yer üzündə misli-bərabəri yoxdur,","poem":1},{"lineBreak":true},{"text":"Qorxu bilməyən məxluqdur.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Hər lovğalanana xor baxır,","poem":1},{"lineBreak":true},{"text":"Bütün məğrur heyvanların hakimidir».","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Livyatan – bu gün bizə məlum olmayan nəhəng su heyvanı.","reference":{"chapter":41,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}