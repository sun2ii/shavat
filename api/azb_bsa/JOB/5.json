{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Çağır görək sənə cavab verən varmı?","poem":1},{"lineBreak":true},{"text":"Müqəddəslərin hansı birinə üz tutacaqsan?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Səfehi qəzəb öldürər,","poem":1},{"lineBreak":true},{"text":"Nadanı həsəd məhv edər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Səfehin kök saldığını görərkən","poem":1},{"lineBreak":true},{"text":"Dərhal yurduna lənət etmişəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Övladları əmin-amanlıqdan uzaqdır,","poem":1},{"lineBreak":true},{"text":"Məhkəmə qapılarında tapdalanır,","poem":1},{"lineBreak":true},{"text":"Onlara havadar yoxdur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Məhsullarını aclar yeyir,","poem":1},{"lineBreak":true},{"text":"Tikanlar arasında olanlarını belə, yığırlar,","poem":1},{"lineBreak":true},{"text":"Susayanlar sərvətini udmaq istəyir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Axı torpaqdan bəla gəlməz,","poem":1},{"lineBreak":true},{"text":"Əzab yerdən bitməz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sanki havaya atılan qığılcımdır,","poem":1},{"lineBreak":true},{"text":"İnsan əzab çəkmək üçün doğulur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mən olsaydım, Allaha üz tutardım,","poem":1},{"lineBreak":true},{"text":"Müşkül işlərimi Ona tapşırardım.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki O, dərk etmədiyimiz böyük işləri görür,","poem":1},{"lineBreak":true},{"text":"Saysız xariqələr göstərir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yer üzərinə yağış yağdırır,","poem":1},{"lineBreak":true},{"text":"Çöllərə sular axıdır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alçaldılanları ucaldır,","poem":1},{"lineBreak":true},{"text":"Yaslıları əmin-amanlığa çıxarır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əlləri qurğu qurmağı öyrənməsin deyə","poem":1},{"lineBreak":true},{"text":"Hiyləgərlərin fəndini pozur.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Müdrikləri hiylə qurarkən yaxalayır,","poem":1},{"lineBreak":true},{"text":"Fəndgirlərin oyununa son qoyur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gündüzləri qaranlığa dönür,","poem":1},{"lineBreak":true},{"text":"Günorta onlara gecə kimi görünür,","poem":1},{"lineBreak":true},{"text":"Onlar kor kimi əl sürtə-sürtə gəzir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yoxsulları isə onların ağızlarındakı qılıncdan qurtarır,","poem":1},{"lineBreak":true},{"text":"Zorakının əlindən alır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kasıblar ümid tapır,","poem":1},{"lineBreak":true},{"text":"Haqsızlıq ağzını yumur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Allahın tərbiyə etdiyi insan nə bəxtiyardır!","poem":1},{"lineBreak":true},{"text":"Sən Külli-İxtiyarın tərbiyəsinə xor baxma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki O yaralayar, sonra isə sarıyar,","poem":1},{"lineBreak":true},{"text":"Ağrı verər, əlləri ilə sağaldar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O, altı dəfə dara düşsən belə, qurtarar,","poem":1},{"lineBreak":true},{"text":"Yeddinci dəfə sənə ziyan dəyməz.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O səni aclıqda məhv olmaqdan,","poem":1},{"lineBreak":true},{"text":"Döyüşdəki qılıncdan qurtarar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kəskin dillərdən uzaq olarsan,","poem":1},{"lineBreak":true},{"text":"Qırğın gələrkən qorxmazsan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qırğına, aclığa gülərsən,","poem":1},{"lineBreak":true},{"text":"Vəhşi heyvanlardan qorxmazsan.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Çünki çöldəki daşlarla belə, əhd kəsərsən,","poem":1},{"lineBreak":true},{"text":"Vəhşi heyvanlarla belə, barışarsan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Çadırının salamat qalacağını bilərsən,","poem":1},{"lineBreak":true},{"text":"Mülkünə baxanda heç bir əskiklik tapmazsan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Övladlarının necə artdığını görərsən,","poem":1},{"lineBreak":true},{"text":"Nəslin ot kimi bitib qalxar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Vaxtında yığılan taxıl dərzləri kimi","poem":1},{"lineBreak":true},{"text":"Kama çatıb məzarına gedərsən.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bax bunu araşdırmışıq, bu həqiqətdir,","poem":1},{"lineBreak":true},{"text":"Onun üçün bunu dinlə və anla».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}