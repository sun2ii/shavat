{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Kaş bu dərdim çəkiləydi,","poem":1},{"lineBreak":true},{"text":"Bütün ağrılarım tərəziyə qoyulaydı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onda dənizlərin qumundan ağır gələrdi,","poem":1},{"lineBreak":true},{"text":"Ona görə tez bu sözləri dedim.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Həqiqətən, Külli-İxtiyarın oxları köksümdədir,","poem":1},{"lineBreak":true},{"text":"Ruhum onların zəhərlərini içir.","poem":1},{"lineBreak":true},{"text":"Allahın dəhşətləri mənə hücum çəkir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ot olanda vəhşi eşşək anqırarmı?","poem":1},{"lineBreak":true},{"text":"Yem tapanda öküz heç böyürərmi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Duzsuz, şit yeməyi yemək olarmı?","poem":1},{"lineBreak":true},{"text":"Yumurta ağının dadı varmı?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Belə yeməklərə əl vurmaq istəmirəm,","poem":1},{"lineBreak":true},{"text":"Onlardan iyrənirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kaş arzuma çataydım,","poem":1},{"lineBreak":true},{"text":"Allah mənə həsrətində olduğumu verəydi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lütf edib məni əzsə belə,","poem":1},{"lineBreak":true},{"text":"Əldən cəld olub həyatımın bağını kəssə belə,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən yenə ovunardım,","poem":1},{"lineBreak":true},{"text":"Bu amansız dərdimə baxmayaraq","poem":1},{"lineBreak":true},{"text":"Müqəddəs Olanın sözlərini inkar etmədiyimə görə sevinərdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nə gücüm var ki, gözləyim?","poem":1},{"lineBreak":true},{"text":"Sonum nə qədərdir ki, səbir edim?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Daş qədər güclüyəmmi?","poem":1},{"lineBreak":true},{"text":"Ətim tuncdandırmı?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əlacsız qalanda","poem":1},{"lineBreak":true},{"text":"Özümə kömək etməyə gücüm çatarmı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"İnsan Külli-İxtiyarın qorxusundan vaz keçsə belə,","poem":1},{"lineBreak":true},{"text":"Çarəsiz qalanda ona dostun sədaqəti gərəkdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Qardaşlarım mənə bir vadi kimi xəyanət etdi,","poem":1},{"lineBreak":true},{"text":"Çaylar kimi axıb getdi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bu vadilər buzlar əriyəndə daşar,","poem":1},{"lineBreak":true},{"text":"Qar suları ilə dolar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu vadilər quraq vaxtı quruyar,","poem":1},{"lineBreak":true},{"text":"İstidə yataqlarından yox olar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bu vadilərə görə karvanlar yolunu azar,","poem":1},{"lineBreak":true},{"text":"Səhraya çıxanda həlak olar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Temanın karvanları su axtarar,","poem":1},{"lineBreak":true},{"text":"Səbadan gələn səyyahlar ora ümid bağlar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amma ora çatanda ümid bağladıqlarına peşman olar,","poem":1},{"lineBreak":true},{"text":"Mat-məəttəl qalar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"İndi siz də mənim üçün bir heç olmusunuz,","poem":1},{"lineBreak":true},{"text":"Bu dəhşətə baxıb qorxursunuz.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mən demişəmmi “Mənə nəyisə verin,","poem":1},{"lineBreak":true},{"text":"Var-dövlətinizdən mənə rüşvət göndərin?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yaxud da məni düşmən əlindən qurtarın,","poem":1},{"lineBreak":true},{"text":"Zalımların əlindən azad edin?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mən susum, siz mənə öyrədin,","poem":1},{"lineBreak":true},{"text":"Nə səhv etmişəmsə, mənə göstərin.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Doğru söz kəsərli olar,","poem":1},{"lineBreak":true},{"text":"Sizin bu iradınız bəs nəyi sübut edir?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Niyə sözlərimi qınamaq istəyirsiniz?","poem":1},{"lineBreak":true},{"text":"Niyə mən biçarənin dediyini boşboğazlıq sanırsınız?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yetim üçün belə, püşk atırsınız,","poem":1},{"lineBreak":true},{"text":"Dostunuzu satırsınız.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"İndi lütf edib mənə baxın,","poem":1},{"lineBreak":true},{"text":"Bax mən üzünüzə ağ yalan demərəm.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Atın haqsızlığı, haqsızlıq etməyin,","poem":1},{"lineBreak":true},{"text":"Düşünün ki, bu davada mən haqlıyam.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dilimdən haqsız söz çıxırmı?","poem":1},{"lineBreak":true},{"text":"Pis şeyləri ağzıma alırammı?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}