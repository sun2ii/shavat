{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"İnsanın yer üzündəki həyatı ağır xidmət deyilmi?","poem":1},{"lineBreak":true},{"text":"Keçirdiyi günlərin muzdur ömründən fərqi nədir?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kölgəyə həsrət qalan kölə kimidir,","poem":1},{"lineBreak":true},{"text":"Muzdunu gözləyən fəhlə kimidir,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bəli, irs olaraq mənə boş aylar verildi,","poem":1},{"lineBreak":true},{"text":"Qismətimə sıxıntılı gecələr düşdü.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yatanda düşünürəm: “Görəsən nə vaxt qalxacağam?”","poem":1},{"lineBreak":true},{"text":"Gecə isə hey uzanır,","poem":1},{"lineBreak":true},{"text":"Mən gün doğana qədər yerimdə qurcalanıram.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bədənimə qurd düşüb, qabıqlanır,","poem":1},{"lineBreak":true},{"text":"Çatlayan dərimdən irin axır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Günlərim toxucunun məkikindən də sürətli gedir,","poem":1},{"lineBreak":true},{"text":"Ümidsiz sona çatır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Allah, yada sal, həyatım bir nəfəsdir,","poem":1},{"lineBreak":true},{"text":"Gözüm yenidən yaxşılıq görməyəcək.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu anda mənə baxan gözlər məni təzədən görməyəcək,","poem":1},{"lineBreak":true},{"text":"Sənin gözlərin üzərimdə olacaq, amma mən olmayacağam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bulud dağılıb getdiyi kimi","poem":1},{"lineBreak":true},{"text":"Ölülər diyarına enən bir daha çıxmaz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bir daha evinə qayıtmaz,","poem":1},{"lineBreak":true},{"text":"Olduğu yer artıq onu tanımaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ona görə sakitləşməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ruhumun sıxıntısını dilə gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Canımın ağrısından şikayət edəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dənizəmmi, dəniz əjdahasıyammı?","poem":1},{"lineBreak":true},{"text":"Niyə üzərimdə nəzarətçi qoyursan?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Düşündüm ki, bəlkə yatağım məni rahatlar,","poem":1},{"lineBreak":true},{"text":"Döşəyim şikayətimi azaldar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Məni yuxularla qorxudursan,","poem":1},{"lineBreak":true},{"text":"Röyalarla canıma vəlvələ salırsan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Canım boğulub-ölməyi yaşamaqdan üstün tutur,","poem":1},{"lineBreak":true},{"text":"Quru cəsəddə qalmaqdansa ölüm mənə xoşdur.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Həyatımdan bezmişəm,","poem":1},{"lineBreak":true},{"text":"Uzun ömür istəmirəm.","poem":1},{"lineBreak":true},{"text":"Məndən əlini çək,","poem":1},{"lineBreak":true},{"text":"Ömrümün mənası getdi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"İnsan nədir ki, onu bu qədər böyüdürsən,","poem":1},{"lineBreak":true},{"text":"Qayğısını çəkirsən.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ona hər səhər baş çəkirsən,","poem":1},{"lineBreak":true},{"text":"Hər an onu sınayırsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nə vaxtadək nəzərini üzərimdən çəkməyəcəksən?","poem":1},{"lineBreak":true},{"text":"Mənə udqunmağa imkan verməyəcəksən?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ey insan nəzarətçisi, nədir günahım?","poem":1},{"lineBreak":true},{"text":"Mən Sənə nə etmişəm?","poem":1},{"lineBreak":true},{"text":"Məni niyə Özünə hədəf etdin?","poem":1},{"lineBreak":true},{"text":"İndi öz yükümü çəkə bilmirəm.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Niyə üsyankarlığımı əfv etmirsən,","poem":1},{"lineBreak":true},{"text":"Təqsirimi bağışlamırsan?","poem":1},{"lineBreak":true},{"text":"Bir azdan torpaq altda yatacağam,","poem":1},{"lineBreak":true},{"text":"Axtarsan da, məni tapmayacaqsan».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}