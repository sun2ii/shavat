{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bildad"]},{"type":"verse","number":1,"content":["Şuahlı Bildad belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Bunları nə vaxta qədər deyəcəksən?","poem":1},{"lineBreak":true},{"text":"Sözlərin sərt küləyə bənzər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allah ədaləti azdırarmı?","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyar salehi əyri edərmi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bəlkə oğulların Ona qarşı günah edib,","poem":1},{"lineBreak":true},{"text":"O da üsyankarlıqlarının cəzasını verib.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əgər cəhd göstərib Allahı axtarsaydın,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyara yalvarsaydın,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Əgər təmiz, doğru olsaydın,","poem":1},{"lineBreak":true},{"text":"O sənin üçün, həqiqətən, qalxardı,","poem":1},{"lineBreak":true},{"text":"Sənə layiqincə bir məskən verərdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Başlanğıcın kiçik olsa da,","poem":1},{"lineBreak":true},{"text":"Sonun böyük olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gəl indi əvvəlki nəsillərdən soruş,","poem":1},{"lineBreak":true},{"text":"Ata-babaların sınağından keçənlərə yaxşı nəzər sal.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dünənki övladlarıq, heç nə bilmirik.","poem":1},{"lineBreak":true},{"text":"Bu dünyada ömrümüz sadəcə bir kölgədir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar izah edib sənə öyrətməzlərmi?","poem":1},{"lineBreak":true},{"text":"Köksündəki sözləri dilə gətirməzlərmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bataqlıq olmayan yerdə qarğı bitərmi?","poem":1},{"lineBreak":true},{"text":"Su olmayan yerdə qamış çıxarmı?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hələ yaşıl ikən qırılmadan,","poem":1},{"lineBreak":true},{"text":"Hər otdan əvvəl onlar quruyar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Allahı unudan hər kəs axırda belə qalar,","poem":1},{"lineBreak":true},{"text":"Allahsız insanın ümidi beləcə yox olar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onun etibar etdiyi şeylər qırılar,","poem":1},{"lineBreak":true},{"text":"Bel bağladığı sanki hörümçək toru olar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Evinə söykənərkən evi uçar,","poem":1},{"lineBreak":true},{"text":"Evindən tutarkən dağılar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sanki bu allahsızlar günəşə baxar, yaşıllaşar,","poem":1},{"lineBreak":true},{"text":"Pöhrələri bağçanın hər tərəfinə yayılar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rişələri daş qalağına dolaşar,","poem":1},{"lineBreak":true},{"text":"Çınqılların arasında yer axtarar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amma yerindən qoparılarkən","poem":1},{"lineBreak":true},{"text":"Yer inkar edərək deyər: “Səni görməmişəm”.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bax belə sevincinə son qoyular,","poem":1},{"lineBreak":true},{"text":"Onun yerində başqa bitkilər bitər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Allah kamil insanı Özündən kənar etməz,","poem":1},{"lineBreak":true},{"text":"Pislik edənlərinsə əlindən tutmaz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O sənin ağzını yenə gülüşlə,","poem":1},{"lineBreak":true},{"text":"Dodaqlarını sevinc nidaları ilə doldurar.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Düşmənlərini rüsvayçılıq bürüyəcək,","poem":1},{"lineBreak":true},{"text":"Pislərin çadırı məhv ediləcək».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}