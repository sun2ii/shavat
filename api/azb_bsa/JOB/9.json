{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOB","translationId":"azb_bsa","name":"ƏYYUB","commonName":"ƏYYUB","title":"ƏYYUB KİTABI","order":18,"numberOfChapters":42,"sha256":"02a548f8f22e89e1d36bc404a84dd8427b34eb7172c0740dfd643be359cbbaf0","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/azb_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Əyyub"]},{"type":"verse","number":1,"content":["Əyyub belə cavab verdi:"]},{"type":"verse","number":2,"content":[{"text":"«Belə olduğunu, həqiqətən, bilirəm.","poem":1},{"lineBreak":true},{"text":"Amma Allah qarşısında insan necə haqlı çıxa bilər?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əgər Onunla kimsə mübahisə etmək istəsə,","poem":1},{"lineBreak":true},{"text":"Onun min sualına bir cavab tapa bilməz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hikməti dərin, gücü tükənməyən Odur.","poem":1},{"lineBreak":true},{"text":"Ona qarşı duranlardan kim sağ qalıb?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allah dağları yerindən oynadar,","poem":1},{"lineBreak":true},{"text":"Dağlar heç bilməz.","poem":1},{"lineBreak":true},{"text":"Qəzəbi ilə onları alt-üst edər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dünyanı yerindən oynadar,","poem":1},{"lineBreak":true},{"text":"Dirəklərini lərzəyə salar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Əmr etsə, günəş doğmaz,","poem":1},{"lineBreak":true},{"text":"Ulduzların işığını örtüb möhürlər.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Odur təkbaşına göyləri sərən,","poem":1},{"lineBreak":true},{"text":"Dəniz dalğalarının üstündə gəzən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Odur Böyük Ayı, Orion, Ülkər bürclərini,","poem":1},{"lineBreak":true},{"text":"Cənub bürclərini yaradan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Odur dərk etmədiyimizdən də böyük işlər görən,","poem":1},{"lineBreak":true},{"text":"Saysız xariqələr göstərən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bax yanımdan elə keçər ki, Onu görə bilmərəm,","poem":1},{"lineBreak":true},{"text":"Elə keçib gedər ki, heç hiss etmərəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nə isə tutub apararsa, kim Ona mane ola bilər?","poem":1},{"lineBreak":true},{"text":"Kim Ona “Nə edirsən?” deyə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Allah qəzəbini geri döndərməz,","poem":1},{"lineBreak":true},{"text":"Rahavın","poem":1},{"noteId":2},{"text":"köməkçiləri belə, ayağı altda qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Belə isə Ona necə cavab verə bilərəm?","poem":1},{"lineBreak":true},{"text":"Hüzurunda necə söz tapa bilərəm?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Günahsız olsam belə, Ona cavab verə bilmərəm,","poem":1},{"lineBreak":true},{"text":"Rəhm etsin deyə Hökmdarıma yalvarmalıyam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onu çağıranda O mənə cavab versə belə,","poem":1},{"lineBreak":true},{"text":"Yenə inanmıram ki, O, səsimi eşidir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki tufanla məni əzir,","poem":1},{"lineBreak":true},{"text":"Nahaq yerə yaralarımı çoxaldır,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Məni nəfəs almağa qoymur,","poem":1},{"lineBreak":true},{"text":"Məni acılarla cana doydurur,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"İş qüvvədədirsə, O qüvvəlidir,","poem":1},{"lineBreak":true},{"text":"İş ədalətdədirsə, kim Onu hakimin qarşısına apara bilər?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mən günahsız olsam belə, dilim məni ittiham edər,","poem":1},{"lineBreak":true},{"text":"Kamil olsam belə, məni təqsirkar çıxarar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kamil olsam da, bir şey deyiləm,","poem":1},{"lineBreak":true},{"text":"Öz həyatıma xor baxıram.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hamısı birdir, ona görə deyirəm:","poem":1},{"lineBreak":true},{"text":"“O həm kamili, həm də günahkarı yox edir”.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Əgər qəfil ölüm gəlsə,","poem":1},{"lineBreak":true},{"text":"Günahsızların əzabına gülür.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dünya pislərə təslim edilib,","poem":1},{"lineBreak":true},{"text":"Dünya hakimlərinin gözünü bağlayan Odur.","poem":1},{"lineBreak":true},{"text":"O deyilsə, bəs kimdir?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Günlərim sürətlə qaçır, çapardan sürətlidir,","poem":1},{"lineBreak":true},{"text":"Bir xeyir tapmadan qaçırlar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Qamış qayıq kimi keçib gedirlər","poem":1},{"lineBreak":true},{"text":"Ovunun üstünə şığıyan qartal kimidirlər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bu şikayətimi unutmaq istəsəm,","poem":1},{"lineBreak":true},{"text":"Sifətimin ifadəsini dəyişib ürəyimin açılmasını istəsəm,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bu əziyyətdən yenə vahimələnərəm,","poem":1},{"lineBreak":true},{"text":"Məni günahsız saymayacağını bilərəm.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Madam ki yenə günahkar çıxacağam,","poem":1},{"lineBreak":true},{"text":"Boş yerə niyə belə zəhmət çəkim?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Əgər qar suyu ilə yuyunsam,","poem":1},{"lineBreak":true},{"text":"Əllərimi gilabı ilə yusam,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yenə də məni çirkaba batırarsan,","poem":1},{"lineBreak":true},{"text":"Paltarlarım belə, məndən iyrənir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"O mənim kimi insan olmadığına görə","poem":1},{"lineBreak":true},{"text":"Ona cavab verə bilmirəm, məhkəməyə birgə gedə bilmirəm.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kaş aramızda bir hakim olaydı,","poem":1},{"lineBreak":true},{"text":"Əlini ikimizin də üzərinə qoyaydı.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Allah Öz dəyənəyini üstümdən götürəydi,","poem":1},{"lineBreak":true},{"text":"Dəhşəti ilə məni vahimələndirməyəydi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"O zaman Ondan qorxmadan danışardım,","poem":1},{"lineBreak":true},{"text":"Amma bu vəziyyətdə heç nə edə bilmirəm.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"Rahav – xaos və şər qüvvələrin rəmzi olan dəniz əjdahası.","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/azb_bsa/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}