{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOL","translationId":"azb_bsa","name":"YOEL","commonName":"YOEL","title":"YOEL PEYĞƏMBƏRİN KİTABI","order":29,"numberOfChapters":3,"sha256":"125b3130edb14fa64cad92227726facf0f16a4eb7a0b600a2000677d61964a64","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Məhv olmuş məhsul üçün yas"]},{"type":"verse","number":1,"content":["Petuelin oğlu Yoelə nazil olan Rəbbin sözü budur:"]},{"type":"verse","number":2,"content":[{"text":"Ey ağsaqqallar, bunu dinləyin.","poem":1},{"lineBreak":true},{"text":"Ey bütün ölkə əhalisi, buna qulaq asın,","poem":1},{"lineBreak":true},{"text":"Sizin və atalarınızın dövründə","poem":1},{"lineBreak":true},{"text":"Belə bir şey olubmu?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siz bunu övladlarınıza danışın.","poem":1},{"lineBreak":true},{"text":"Övladlarınız da öz övladlarına,","poem":1},{"lineBreak":true},{"text":"Onların övladları isə gələcək nəslə danışsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kəsici çəyirtkələrdən qalanı qaynaşan çəyirtkə yedi,","poem":1},{"lineBreak":true},{"text":"Qaynaşan çəyirtkədən qalanı tullanan çəyirtkə yedi,","poem":1},{"lineBreak":true},{"text":"Tullanan çəyirtkədən qalanı dağıdıcı çəyirtkə yeyib-qurtardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ayılın, ey sərxoşlar və ağlayın.","poem":1},{"lineBreak":true},{"text":"Ey şirin şərab içənlər, hamınız nalə çəkin,","poem":1},{"lineBreak":true},{"text":"Ona görə ki, şirin şərab ağzınızdan alındı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki mənim torpağımın üzərinə","poem":1},{"lineBreak":true},{"text":"Qüvvətli və saysız-hesabsız bir millət gəldi.","poem":1},{"lineBreak":true},{"text":"Onların dişləri aslan dişləri kimidir,","poem":1},{"lineBreak":true},{"text":"Onlarda dişi aslanın köpək dişləri var.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tənəyimi məhv etdi,","poem":1},{"lineBreak":true},{"text":"Əncir ağacımı gəmirdi,","poem":1},{"lineBreak":true},{"text":"Qabıqlarını tamamilə soyub yerə atdı,","poem":1},{"lineBreak":true},{"text":"Budaqları ağ qaldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Cavanlıqda nişanlısını itirən,","poem":1},{"lineBreak":true},{"text":"Büsbütün çul geyinən","poem":1},{"lineBreak":true},{"text":"Bir qız kimi yas tutun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbbin evindən","poem":1},{"lineBreak":true},{"text":"Taxıl təqdimi və içmə təqdimi kəsildi,","poem":1},{"lineBreak":true},{"text":"Rəbbə xidmət edən kahinlər yas tutur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zəmi viran qalıb, torpaq ağlayır,","poem":1},{"lineBreak":true},{"text":"Çünki taxıl zay oldu, təzə şərab qurudu,","poem":1},{"lineBreak":true},{"text":"Zeytun yağı qurtardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Buğda və arpaya görə","poem":1},{"lineBreak":true},{"text":"Ey əkinçilər, utanın!","poem":1},{"lineBreak":true},{"text":"Ey bağbanlar, nalə çəkin!","poem":1},{"lineBreak":true},{"text":"Çünki torpağın məhsulları yoxa çıxdı,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tənək qurudu,","poem":1},{"lineBreak":true},{"text":"Əncir ağacı soldu,","poem":1},{"lineBreak":true},{"text":"Nar, xurma, alma,","poem":1},{"lineBreak":true},{"text":"Çölün bütün ağacları qurudu.","poem":1},{"lineBreak":true},{"text":"Görün ki, bəşər övladları arasından sevinc yox oldu.","poem":1}]},{"type":"heading","content":["Tövbəyə çağırın"]},{"type":"verse","number":13,"content":[{"text":"Ey kahinlər, çul geyinərək yas tutun!","poem":1},{"lineBreak":true},{"text":"Ey qurbangah xidmətçiləri, nalə çəkin!","poem":1},{"lineBreak":true},{"text":"Ey Allahıma xidmət edənlər,","poem":1},{"lineBreak":true},{"text":"Gəlin çulda gecələyin,","poem":1},{"lineBreak":true},{"text":"Çünki Allahınızın evindən","poem":1},{"lineBreak":true},{"text":"Taxıl təqdimi və içmə təqdimi yox oldu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Oruc üçün vaxt təyin edin,","poem":1},{"lineBreak":true},{"text":"Təntənəli toplantı çağırın.","poem":1},{"lineBreak":true},{"text":"Ağsaqqalları, ölkənin bütün əhalisini","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbin evinə yığın,","poem":1},{"lineBreak":true},{"text":"Rəbbə fəryad qoparın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vay o günə!","poem":1},{"lineBreak":true},{"text":"Budur, Rəbbin o günü yaxındır,","poem":1},{"lineBreak":true},{"text":"O gün Külli-İxtiyar fəlakət gətirəcək.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O yemək gözlərimizin önündən,","poem":1},{"lineBreak":true},{"text":"Sevinc və şadlıq Allahımızın evindən yox olmadımı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Torpaq kəsəkləri altında toxumlar çürüdü,","poem":1},{"lineBreak":true},{"text":"Zirzəmilər boş qaldı,","poem":1},{"lineBreak":true},{"text":"Anbarlar dağıldı,","poem":1},{"lineBreak":true},{"text":"Çünki taxıllar məhv oldu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Heyvanlar necə də inildəyir,","poem":1},{"lineBreak":true},{"text":"Naxırlar çaşbaş qalıb,","poem":1},{"lineBreak":true},{"text":"Çünki onlar otlaqsız qalıb,","poem":1},{"lineBreak":true},{"text":"Sürülər də susuzluqdan əldən düşür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ya Rəbb, Sənə fəryad edirəm,","poem":1},{"lineBreak":true},{"text":"Çünki çölün otlaqlarını alov yandırıb-yaxdı,","poem":1},{"lineBreak":true},{"text":"Bütün düzəngahın ağacları odda qovruldu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Çöl heyvanları da Səni çağırır,","poem":1},{"lineBreak":true},{"text":"Axı axar sular quruyub,","poem":1},{"lineBreak":true},{"text":"Çölün otlaqlarını alov yandırıb-yaxdı.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}