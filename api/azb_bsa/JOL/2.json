{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOL","translationId":"azb_bsa","name":"YOEL","commonName":"YOEL","title":"YOEL PEYĞƏMBƏRİN KİTABI","order":29,"numberOfChapters":3,"sha256":"125b3130edb14fa64cad92227726facf0f16a4eb7a0b600a2000677d61964a64","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Rəbbin günü – qaranlıq və zülmət günü"]},{"type":"verse","number":1,"content":[{"text":"Sionda şeypur çalın,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağımda bərkdən çalın.","poem":1},{"lineBreak":true},{"text":"Qoy ölkənin bütün əhalisi titrəsin,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin günü gəlir,","poem":1},{"lineBreak":true},{"text":"Həmin gün yaxındadır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qaranlıq zülmətli bir gün!","poem":1},{"lineBreak":true},{"text":"Buludlu və qatı qaranlıq bir gün!","poem":1},{"lineBreak":true},{"text":"Bir qoşun gəlir","poem":1},{"lineBreak":true},{"text":"Dağlar üzərində yayılan dan kimi","poem":1},{"lineBreak":true},{"text":"Çoxsaylı və qüvvətli bir qoşun.","poem":1},{"lineBreak":true},{"text":"Elə bir qoşun ki,","poem":1},{"lineBreak":true},{"text":"Əzəldən bəri bunun kimisi olmamışdır,","poem":1},{"lineBreak":true},{"text":"Bundan sonra da nəsillər boyu olmayacaqdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Önlərindəki hər şeyi od yandırıb-yaxır,","poem":1},{"lineBreak":true},{"text":"Arxada qalanları alov qovurur.","poem":1},{"lineBreak":true},{"text":"Önlərindəki Eden bağına bənzər yerdir,","poem":1},{"lineBreak":true},{"text":"Arxalarında olansa izsiz bir səhradır,","poem":1},{"lineBreak":true},{"text":"Heç nə onlardan qaçıb qurtara bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Onlar görkəmcə ata bənzəyir.","poem":1},{"lineBreak":true},{"text":"Atlar necə çapırlarsa,","poem":1},{"lineBreak":true},{"text":"Onlar da eləcə çapırlar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Döyüş arabalarına bənzəyən səslə,","poem":1},{"lineBreak":true},{"text":"Küləşi yandırıb-yaxan od-alovun səsi ilə,","poem":1},{"lineBreak":true},{"text":"Dağların zirvələri üzərindən tullanırlar.","poem":1},{"lineBreak":true},{"text":"Onlar hücum üçün düzülən güclü bir qoşuna bənzəyirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onların qarşısında xalqlar sanki ağrı çəkir,","poem":1},{"lineBreak":true},{"text":"Bütün üzlər solur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qaçırlar igidlər kimi,","poem":1},{"lineBreak":true},{"text":"Divara dırmaşırlar cəngavərlər kimi.","poem":1},{"lineBreak":true},{"text":"Hamı nizamla gedir sırasını pozmadan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Heç kim yoldaşını tapdalamadan","poem":1},{"lineBreak":true},{"text":"Yolundan çıxmır.","poem":1},{"lineBreak":true},{"text":"Silahlar sırasını yarıb-keçirlər,","poem":1},{"lineBreak":true},{"text":"Lakin salamat qalırlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Şəhərə doğru qaçışır,","poem":1},{"lineBreak":true},{"text":"Divarlardan atlanıb evlərə soxulurlar,","poem":1},{"lineBreak":true},{"text":"Quldur kimi pəncərələrdən girirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qarşılarında yer sarsılır,","poem":1},{"lineBreak":true},{"text":"Göylər lərzəyə gəlir,","poem":1},{"lineBreak":true},{"text":"Günəş və ay qaralır,","poem":1},{"lineBreak":true},{"text":"Ulduzlar işıqlarını gizlədir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb Öz ordusu önündə səs salır:","poem":1},{"lineBreak":true},{"text":"Ordularının sayı-hesabı yoxdur.","poem":1},{"lineBreak":true},{"text":"Onun sözünü yerinə yetirənlər güclüdür.","poem":1},{"lineBreak":true},{"text":"Rəbbin günü möhtəşəm və çox dəhşətlidir.","poem":1},{"lineBreak":true},{"text":"Buna kim dözə bilər?","poem":1}]},{"type":"heading","content":["Rəbbə dönün"]},{"type":"verse","number":12,"content":[{"text":"Rəbb belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«İndi isə orucla, ağlamaqla, yas tutmaqla","poem":1},{"lineBreak":true},{"text":"Bütün qəlbinizlə Mənə dönün.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paltarlarınızı deyil, ürəyinizi yırtın,","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbə tərəf qayıdın».","poem":1},{"lineBreak":true},{"text":"Çünki O, lütfkar və rəhmlidir,","poem":1},{"lineBreak":true},{"text":"Hədsiz səbirlidir, bol məhəbbətlidir,","poem":1},{"lineBreak":true},{"text":"Bəla göndərməz, rəhm edər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kim bilir, bəlkə rəhm edib dönər?","poem":1},{"lineBreak":true},{"text":"Sonra Allahınız Rəbbə","poem":1},{"lineBreak":true},{"text":"Taxıl və içmə təqdimlərini verəsiniz deyə","poem":1},{"lineBreak":true},{"text":"Sizə bərəkət verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sionda şeypur çalın,","poem":1},{"lineBreak":true},{"text":"Oruc üçün vaxt təyin edin,","poem":1},{"lineBreak":true},{"text":"Təntənəli toplantı çağırın.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xalqı bir yerə yığın,","poem":1},{"lineBreak":true},{"text":"Camaatı təqdis edin,","poem":1},{"lineBreak":true},{"text":"Ağsaqqalları yığın,","poem":1},{"lineBreak":true},{"text":"Uşaqları və südəmər çağaları toplayın.","poem":1},{"lineBreak":true},{"text":"Bəy öz otağından,","poem":1},{"lineBreak":true},{"text":"Gəlin də öz gərdəyindən çıxsın.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbbə xidmət edən kahinlər","poem":1},{"lineBreak":true},{"text":"Məbədin eyvanı ilə qurbangah arasında ağlayıb desin:","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, xalqına qıyma,","poem":1},{"lineBreak":true},{"text":"Öz irsini rüsvay olmağa qoyma!","poem":1},{"lineBreak":true},{"text":"Qoyma onlar millətlərin dilinə düşsün.","poem":1},{"lineBreak":true},{"text":"Axı nə üçün xalqlar arasında belə deyilsin:","poem":1},{"lineBreak":true},{"text":"“Bəs hanı onların Allahı?”»","poem":1}]},{"type":"heading","content":["Rəbbin cavabı və bərəkət vədi"]},{"type":"verse","number":18,"content":[{"text":"O zaman Rəbb Öz torpağına qıymayacaq,","poem":1},{"lineBreak":true},{"text":"Öz xalqına rəhm edəcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rəbb xalqına belə cavab verəcək:","poem":1},{"lineBreak":true},{"text":"«Budur, sizə taxıl,","poem":1},{"lineBreak":true},{"text":"Təzə şərab və zeytun yağı göndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bunlarla doyacaqsınız,","poem":1},{"lineBreak":true},{"text":"Artıq sizi millətlər arasında rüsvay etməyəcəyəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Şimal tərəfdən gələn ordunu sizdən uzaqlaşdıracağam.","poem":1},{"lineBreak":true},{"text":"Onu quraq, izsiz bir yerə,","poem":1},{"lineBreak":true},{"text":"Qarşıdakı ordunu Şərq dənizinə,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Arxadan gələnləri isə Qərb dənizinə aparacağam.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Onların cəsədlərinin pis iyləri ətrafa yayılacaq».","poem":1},{"lineBreak":true},{"text":"Həqiqətən, Rəbb böyük işlər gördü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Qorxma, ey torpaq, sevin, fərəhlən.","poem":1},{"lineBreak":true},{"text":"Bu böyük işləri görən Rəbdir.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qorxmayın, ey çöl heyvanları,","poem":1},{"lineBreak":true},{"text":"Çünki çölün otlaqları göyərir.","poem":1},{"lineBreak":true},{"text":"Ağac meyvəsi ilə yüklənir,","poem":1},{"lineBreak":true},{"text":"Əncir ağacı, tənək bəhrələrini verir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ey Sion xalqı,","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbdə sevinin və şadlanın,","poem":1},{"lineBreak":true},{"text":"Çünki payız yağışını sizə kifayət qədər verir.","poem":1},{"noteId":2},{"lineBreak":true},{"text":"Əvvəlki kimi payız yağışı ilə","poem":1},{"lineBreak":true},{"text":"Yaz yağışını yağdırır.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xırmanlar taxılla dolu olacaq,","poem":1},{"lineBreak":true},{"text":"Təknələr təzə şərab və zeytun yağı ilə daşacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«Aranıza göndərdiyim böyük qoşunumun –","poem":1},{"lineBreak":true},{"text":"Kəsici çəyirtkənin, qaynaşan çəyirtkənin,","poem":1},{"lineBreak":true},{"text":"Tullanan çəyirtkənin və dağıdıcı çəyirtkənin","poem":1},{"lineBreak":true},{"text":"Yeyib-qurtardığı illərin əvəzini verəcəyəm.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bol-bol, doyunca yeyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Sizin üçün möcüzəli şeylər edən","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbin adına şükürlər edəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Xalqım əbədi olaraq rüsvay olmayacaq.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Onda biləcəksiniz ki,","poem":1},{"lineBreak":true},{"text":"Mən İsrailin arasındayam,","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbb Mənəm,","poem":1},{"lineBreak":true},{"text":"Başqası yoxdur.","poem":1},{"lineBreak":true},{"text":"Xalqım əbədi olaraq rüsvay olmayacaq.","poem":1}]},{"type":"heading","content":["Rəbbin günü"]},{"type":"verse","number":28,"content":[{"text":"Ondan sonra isə","poem":1},{"lineBreak":true},{"text":"Bütün bəşər üzərinə Ruhumu tökəcəyəm.","poem":1},{"lineBreak":true},{"text":"Oğullarınız və qızlarınız peyğəmbərlik edəcək,","poem":1},{"lineBreak":true},{"text":"Ağsaqqallarınız röyalar,","poem":1},{"lineBreak":true},{"text":"Cavanlarınızsa görüntülər görəcək.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"O günlərdə qul və qarabaşların üzərinə də","poem":1},{"lineBreak":true},{"text":"Ruhumu tökəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Göylərdə və yerdə əlamətlər göstərəcəyəm:","poem":1},{"lineBreak":true},{"text":"Qan, alov və tüstü dirəkləri görünəcək.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Rəbbin möhtəşəm və dəhşətli günü gəlməzdən əvvəl","poem":1},{"lineBreak":true},{"text":"Günəş qaranlığa və ay qan rənginə dönəcək.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Amma Rəbbin adını çağıran hər kəs xilas olacaq,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin dediyi kimi","poem":1},{"lineBreak":true},{"text":"Sion dağında və Yerusəlimdə qurtuluş olacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbin çağırdığı sağ qalanlar arasında olacaq.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Şərq dənizi – Ölü dəniz.","reference":{"chapter":2,"verse":20}},{"noteId":1,"caller":"+","text":"Qərb dənizi – Aralıq dənizi.","reference":{"chapter":2,"verse":20}},{"noteId":2,"caller":"+","text":"Payız yağışını sizə kifayət qədər verir – yaxud sizə salehliyi öyrədən müəllimi verir.","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/azb_bsa/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}