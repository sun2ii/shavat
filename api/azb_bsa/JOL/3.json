{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JOL","translationId":"azb_bsa","name":"YOEL","commonName":"YOEL","title":"YOEL PEYĞƏMBƏRİN KİTABI","order":29,"numberOfChapters":3,"sha256":"125b3130edb14fa64cad92227726facf0f16a4eb7a0b600a2000677d61964a64","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Rəbb millətləri mühakimə edir"]},{"type":"verse","number":1,"content":["O günlərdə Yəhuda və Yerusəlimin",{"text":"Sərvətlərini geri qaytardığım zaman","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bütün millətləri yığıb","poem":1},{"lineBreak":true},{"text":"Yehoşafat","poem":1},{"noteId":3},{"text":"vadisinə endirəcəyəm.","poem":1},{"lineBreak":true},{"text":"İrsim və xalqım İsraildən ötrü","poem":1},{"lineBreak":true},{"text":"Orada millətləri mühakimə edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki xalqımı millətlər arasında dağıtdılar,","poem":1},{"lineBreak":true},{"text":"Torpağımı da böldülər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xalqım üçün püşk atdılar,","poem":1},{"lineBreak":true},{"text":"Oğlan uşaqlarını fahişə əvəzinə verdilər,","poem":1},{"lineBreak":true},{"text":"İçki içsinlər deyə","poem":1},{"lineBreak":true},{"text":"Qızları şəraba satdılar».","poem":1}]},{"type":"verse","number":4,"content":["«Ey Surlular, Sidonlular və bütün Filişt vilayətlərinin əhalisi, siz kimsiniz ki, Məndən qisas alasınız. Əgər siz Məndən qisas alsanız, çox tezliklə Mən sizin etdiyinizin əvəzini öz başınıza döndərəcəyəm."]},{"type":"verse","number":5,"content":["Siz qızılımı və gümüşümü aldınız və qiymətli şeylərimi məbədlərinizə apardınız,"]},{"type":"verse","number":6,"content":["Yəhuda və Yerusəlim xalqını öz vətənlərindən uzaqlaşdırmaq üçün Yunan xalqına satdınız."]},{"type":"verse","number":7,"content":["Amma Mən onları satdığınız yerdən götürəcəyəm, etdiyinizin əvəzini öz başınıza döndərəcəyəm."]},{"type":"verse","number":8,"content":["Oğul-qızlarınızı Yəhuda xalqına satacağam və Yəhuda xalqı isə onları ucqar bir millətə – Səbalılara satacaq». Rəbb belə söylədi."]},{"type":"verse","number":9,"content":[{"text":"«Millətlər arasında bunu elan edin:","poem":1},{"lineBreak":true},{"text":"Döyüşə hazırlaşın,","poem":1},{"lineBreak":true},{"text":"İgidləri qızışdırın,","poem":1},{"lineBreak":true},{"text":"Bütün döyüşçülər yaxınlaşıb yuxarı çıxsın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kotanlarınızdan qılınc,","poem":1},{"lineBreak":true},{"text":"Dəryazlarınızdan nizə düzəldin.","poem":1},{"lineBreak":true},{"text":"Qoy zəif olan “güclüyəm” desin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tələsin, ey hər tərəfdəki millətlər,","poem":1},{"lineBreak":true},{"text":"Gəlin və toplaşın.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, igidlərini oraya endir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Millətlər hərəkətə gələrək","poem":1},{"lineBreak":true},{"text":"Yehoşafat vadisinə çıxsın,","poem":1},{"lineBreak":true},{"text":"Çünki hər tərəfdəki bütün millətləri","poem":1},{"lineBreak":true},{"text":"Mühakimə etmək üçün orada oturacağam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Oraq çalın,","poem":1},{"lineBreak":true},{"text":"Çünki məhsul yetişib.","poem":1},{"lineBreak":true},{"text":"Gəlin ayağınızla əzin,","poem":1},{"lineBreak":true},{"text":"Çünki üzümsıxanlar doludur,","poem":1},{"lineBreak":true},{"text":"Təknələr daşır.","poem":1},{"lineBreak":true},{"text":"Çünki onların pisliyi böyükdür».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kütlələr, mühakimə vadisində olan kütlələr,","poem":1},{"lineBreak":true},{"text":"Çünki mühakimə vadisində Rəbbin günü yaxındır!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Günəş və ay qaralır,","poem":1},{"lineBreak":true},{"text":"Ulduzlar işıqlarını gizlədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbb Siondan nərə çəkəcək,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdən guruldayacaq,","poem":1},{"lineBreak":true},{"text":"Göy və yer sarsılacaq.","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb Öz xalqı üçün sığınacaq yer,","poem":1},{"lineBreak":true},{"text":"İsrail övladları üçün qala olacaq.","poem":1}]},{"type":"heading","content":["Allahın Öz xalqına xeyir-duası"]},{"type":"verse","number":17,"content":[{"text":"«O zaman biləcəksiniz ki,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağım Sionda məskən salan","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbb Mənəm!","poem":1},{"lineBreak":true},{"text":"Yerusəlim müqəddəs olacaq,","poem":1},{"lineBreak":true},{"text":"Artıq yadellilər oradan keçməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O gün belə olacaq:","poem":1},{"lineBreak":true},{"text":"Dağlardan şirin şərab damacaq,","poem":1},{"lineBreak":true},{"text":"Təpələrdən süd axacaq,","poem":1},{"lineBreak":true},{"text":"Yəhudanın bütün dərələrində sular axacaq.","poem":1},{"lineBreak":true},{"text":"Rəbbin evindən bir qaynaq çıxacaq,","poem":1},{"lineBreak":true},{"text":"Əbrişimlər","poem":1},{"noteId":4},{"text":"vadisini sulayacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yəhuda xalqına qəddarlıq etdiyinə,","poem":1},{"lineBreak":true},{"text":"Torpaqlarında günahsız qan tökdüyünə görə","poem":1},{"lineBreak":true},{"text":"Misir viran qalacaq,","poem":1},{"lineBreak":true},{"text":"Edom izsiz bir səhra olacaq.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lakin Yəhuda əbədi qalacaq,","poem":1},{"lineBreak":true},{"text":"Yerusəlim nəsildən-nəslə keçəcək.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onların tökdüyü qanları","poem":1},{"lineBreak":true},{"text":"İndiyə qədər bağışlamamışam,","poem":1},{"lineBreak":true},{"text":"Lakin bundan sonra bağışlayacağam.","poem":1},{"lineBreak":true},{"text":"Rəbb Sionda məskən salır».","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Yehoşafat – ibrani dilində Rəbb mühakimə edir.","reference":{"chapter":3,"verse":2}},{"noteId":4,"caller":"+","text":"Əbrişimlər – ibrani mətnində Şittim.","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/azb_bsa/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}