{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"JON","translationId":"azb_bsa","name":"YUNUS","commonName":"YUNUS","title":"YUNUS PEYĞƏMBƏRİN KİTABI","order":32,"numberOfChapters":4,"sha256":"e63f3b9569f4eb393e0e07f9fbb2f23dfdbe0d9fa0b68b2f50358d36bb9a0228","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/azb_bsa/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yunusun tövbəsi və xilası"]},{"type":"verse","number":1,"content":["Yunus balığın qarnından Allahı Rəbbə dua edib dedi:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Əzab içində Rəbbi çağırdım,","poem":1},{"lineBreak":true},{"text":"O mənə cavab verdi.","poem":1},{"lineBreak":true},{"text":"Ölülər diyarının bağrından fəryad etdim,","poem":1},{"lineBreak":true},{"text":"Sən mənim səsimi eşitdin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sən məni dərinə, dənizin qoynuna atdın,","poem":1},{"lineBreak":true},{"text":"Məni sellər sarıdı,","poem":1},{"lineBreak":true},{"text":"Sənin bütün ləpələrin və dalğaların","poem":1},{"lineBreak":true},{"text":"Üstümdən keçdi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mən dedim: “Sənin gözlərinin önündən qovuldum”,","poem":1},{"lineBreak":true},{"text":"Lakin yenə Sənin müqəddəs məbədini görəcəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nəfəsim kəsilənə qədər məni sular bürüdü,","poem":1},{"lineBreak":true},{"text":"Məni dərinliklər aldı,","poem":1},{"lineBreak":true},{"text":"Başıma yosunlar sarıldı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dağların dibinə qədər endim,","poem":1},{"lineBreak":true},{"text":"Arxamca əbədilik dünya bağlandı.","poem":1},{"lineBreak":true},{"text":"Lakin, ya Rəbb Allahım, Sən canımı dərin çuxurdan çıxartdın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Daxilimdə canım üzüləndə Rəbbə üz tutdum,","poem":1},{"lineBreak":true},{"text":"Mənim duam Sənə,","poem":1},{"lineBreak":true},{"text":"Sənin müqəddəs məbədinə çatdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Puç olan bütlərə səcdə edənlər","poem":1},{"lineBreak":true},{"text":"Onlara verilən lütfdən imtina edərlər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amma mən Sənə şükür nəğməsi ilə qurban gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Əhdimi yerinə yetirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Xilas Rəbdədir!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Rəbb balığa əmr etdi və balıq Yunusu ağzından quruya qaytardı."]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}