{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"LAM","translationId":"azb_bsa","name":"MƏRSİYƏLƏR","commonName":"MƏRSİYƏLƏR","title":"MƏRSİYƏLƏR KİTABI","order":25,"numberOfChapters":5,"sha256":"58b72d7422ae3c60d29af846445a375b62cfd5f12a87667d9a5705d9141a0e96","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/azb_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Yerusəlim dərdi"]},{"type":"verse","number":1,"content":["Yerusəlim şəhəri necə də boş qalıb,",{"text":"Bir zaman insanlarla dolu idi,","poem":1},{"lineBreak":true},{"text":"İndi dul qadına bənzəyir –","poem":1},{"lineBreak":true},{"text":"Millətlər arasında ulu sayılan,","poem":1},{"lineBreak":true},{"text":"Ellər arasında mələkə olan,","poem":1},{"lineBreak":true},{"text":"Bu şəhər nökərçilik edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gecələr acı-acı ağlar,","poem":1},{"lineBreak":true},{"text":"Göz yaşları ilə yanağı islanar,","poem":1},{"lineBreak":true},{"text":"Məşuqlarının arasından","poem":1},{"lineBreak":true},{"text":"Ona təsəlli verən yoxdur.","poem":1},{"lineBreak":true},{"text":"Bütün dostları ona xəyanət etdi, düşmən oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yəhuda dərdə, ağır zillətə düşüb,","poem":1},{"lineBreak":true},{"text":"İndi sürgünə gedir.","poem":1},{"lineBreak":true},{"text":"O, millətlər arasında yaşayır,","poem":1},{"lineBreak":true},{"text":"O torpaqlarda rahatlıq tapmır,","poem":1},{"lineBreak":true},{"text":"Yəhuda bu iztiraba düşəndə,","poem":1},{"lineBreak":true},{"text":"Təqibçilər ona çatdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Siona gedən yollar yas tutur,","poem":1},{"lineBreak":true},{"text":"Çünki bayramlarına gələn yoxdur,","poem":1},{"lineBreak":true},{"text":"Buranın bütün darvazaları kimsəsiz qalıb,","poem":1},{"lineBreak":true},{"text":"Kahinləri ah-zar edir.","poem":1},{"lineBreak":true},{"text":"Bu şəhərin qızları əzab-əziyyət çəkir,","poem":1},{"lineBreak":true},{"text":"Buranın aqibəti acıdır,","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"İndi düşmənlər bu şəhərin üstündə hökmrandır,","poem":1},{"lineBreak":true},{"text":"Bu yağılar gör necə firavan yaşayır.","poem":1},{"lineBreak":true},{"text":"Çox üsyankar olduqlarına görə","poem":1},{"lineBreak":true},{"text":"Rəbb onları bu zülmə saldı,","poem":1},{"lineBreak":true},{"text":"Övladları düşmən önündə əsir aparıldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sion qızının cah-calalı yox oldu,","poem":1},{"lineBreak":true},{"text":"Onların başçıları otlaqsız maral kimi oldu,","poem":1},{"lineBreak":true},{"text":"Onlar təqib edənlərin qarşısından","poem":1},{"lineBreak":true},{"text":"Taqətsiz qaçırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yerusəlim sıxıntı içində avara gəzərkən","poem":1},{"lineBreak":true},{"text":"Ötən günlərdə olan bütün sərvətini xatırlayır,","poem":1},{"lineBreak":true},{"text":"Xalqı düşmənlərinə təslim olanda köməyinə çatan yoxdur.","poem":1},{"lineBreak":true},{"text":"Düşmənləri ona baxır,","poem":1},{"lineBreak":true},{"text":"Yıxılmağına gülür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusəlim böyük günah işlətdi,","poem":1},{"lineBreak":true},{"text":"Ona görə özünü murdar etdi.","poem":1},{"lineBreak":true},{"text":"Yerusəlimə hörmət edənlərin hər biri","poem":1},{"lineBreak":true},{"text":"İndi ona xor baxır,","poem":1},{"lineBreak":true},{"text":"Çünki onu çılpaq görürlər,","poem":1},{"lineBreak":true},{"text":"O da üzünü yana çevirib inləyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ətəyində ləkələr qaldı,","poem":1},{"lineBreak":true},{"text":"Sonunu düşünməz oldu,","poem":1},{"lineBreak":true},{"text":"Ona görə qorxunc surətdə yıxıldı,","poem":1},{"lineBreak":true},{"text":"Ona təsəlli verən yoxdur,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, gör bu əzabımı,","poem":1},{"lineBreak":true},{"text":"Çünki düşmən zəfər çaldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Onun bütün sərvətini talamaq üçün","poem":1},{"lineBreak":true},{"text":"Düşmən əlini uzatdı.","poem":1},{"lineBreak":true},{"text":"Göz önündəcə millətlər,","poem":1},{"lineBreak":true},{"text":"Camaatın arasına girməsini qadağan etdiyin","poem":1},{"lineBreak":true},{"text":"Müqəddəs məkanına soxuldu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Oranın bütün xalqı zarıyır, çörək axtarır,","poem":1},{"lineBreak":true},{"text":"Canlarını taqətə gətirmək üçün","poem":1},{"lineBreak":true},{"text":"Sərvətlərinin əvəzinə azuqə alır.","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, indi bax, halımı gör,","poem":1},{"lineBreak":true},{"text":"Bir səfilə dönmüşəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey yoldan keçənlərin hamısı,","poem":1},{"lineBreak":true},{"text":"Bu iş sizin üçün boşdurmu?","poem":1},{"lineBreak":true},{"text":"Baxın dərdimə, bunun kimisi varmı,","poem":1},{"lineBreak":true},{"text":"Mənim başıma gətirilən dərd başqasında olarmı?","poem":1},{"lineBreak":true},{"text":"Rəbb qəzəbdən alovlananda","poem":1},{"lineBreak":true},{"text":"Bu dərdi başıma tökdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yuxarıdan od göndərdi,","poem":1},{"lineBreak":true},{"text":"Sümüklərimədək bu odu yeritdi.","poem":1},{"lineBreak":true},{"text":"Ayaqlarım üçün tor qurdu,","poem":1},{"lineBreak":true},{"text":"Məni geri qaytardı.","poem":1},{"lineBreak":true},{"text":"Gün boyu məni yalqız qoydu, taqətdən saldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xudavənd günahlarımı mənə boyunduruq etdi,","poem":1},{"lineBreak":true},{"text":"Əli ilə bir-birinə hördü,","poem":1},{"lineBreak":true},{"text":"Onları boynuma keçirtdi,","poem":1},{"lineBreak":true},{"text":"Taqətimi tükəndirdi.","poem":1},{"lineBreak":true},{"text":"Məni qarşısında dura bilmədiyim","poem":1},{"lineBreak":true},{"text":"İnsanlara təslim etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Məni müdafiə edən cəngavərlər vardı,","poem":1},{"lineBreak":true},{"text":"Hamısı Xudavənd tərəfindən atıldı.","poem":1},{"lineBreak":true},{"text":"Mənə qarşı bir ordu göndərdi,","poem":1},{"lineBreak":true},{"text":"Seçmə igidlərimi qırıb tapdalatdı.","poem":1},{"lineBreak":true},{"text":"Bakirə Yəhuda qızını üzümsıxanda əzdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bunlar üçün ağlayıram,","poem":1},{"lineBreak":true},{"text":"Gözlərimdən yaş axır.","poem":1},{"lineBreak":true},{"text":"Təsəlli verən məndən uzaqdır,","poem":1},{"lineBreak":true},{"text":"Məni dirçəldən uzaqdır.","poem":1},{"lineBreak":true},{"text":"Övladlarım yalqız qalıb,","poem":1},{"lineBreak":true},{"text":"Çünki düşmən zəfər çalıb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sion əl açıb,","poem":1},{"lineBreak":true},{"text":"Amma ona təsəlli verən yoxdur.","poem":1},{"lineBreak":true},{"text":"Rəbb Yaqub nəslinə qarşı bu əmrini verib:","poem":1},{"lineBreak":true},{"text":"«Qoy qonşuları onun düşməni olsun,","poem":1},{"lineBreak":true},{"text":"Çünki Yerusəlim onlar üçün murdar əskiyə çevrilib».","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rəbb adildir, mən isə əmrinə qarşı çıxdım,","poem":1},{"lineBreak":true},{"text":"Ey bütün xalqlar, siz mənə qulaq asın!","poem":1},{"lineBreak":true},{"text":"Mənim çəkdiyim bu dərdə baxın,","poem":1},{"lineBreak":true},{"text":"Bakirə qızlarım, igidlərim sürgünə gedib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Müttəfiqlərimi çağırdım,","poem":1},{"lineBreak":true},{"text":"Lakin məni aldatdılar,","poem":1},{"lineBreak":true},{"text":"Kahinlərim, ağsaqqallarım cana gəlmək üçün","poem":1},{"lineBreak":true},{"text":"Yemək axtardılar,","poem":1},{"lineBreak":true},{"text":"Amma şəhərin içindəcə canlarını tapşırdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ya Rəbb, bax dara düşmüşəm,","poem":1},{"lineBreak":true},{"text":"Canım əzabdan yanır.","poem":1},{"lineBreak":true},{"text":"Çox üsyankarlıq etmişəm,","poem":1},{"lineBreak":true},{"text":"Buna görə ürəyim üzülür.","poem":1},{"lineBreak":true},{"text":"Bayırdakı qılınc məni övladsız qoyur,","poem":1},{"lineBreak":true},{"text":"Ölüm evimi içəridən bəzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Necə ah-zar çəkdiyimi eşidiblər,","poem":1},{"lineBreak":true},{"text":"Amma mənə təsəlli verən yoxdur,","poem":1},{"lineBreak":true},{"text":"Düşmənlərim bu əziyyətimdən xəbər tutdu,","poem":1},{"lineBreak":true},{"text":"Onlar başıma gələnlərə sevinir,","poem":1},{"lineBreak":true},{"text":"Elan etdiyin günü yetir!","poem":1},{"lineBreak":true},{"text":"Qoy onlar mənim vəziyyətimə düşsün.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Etdikləri pislikləri yada sal,","poem":1},{"lineBreak":true},{"text":"Üsyankarlığıma görə mənə etdiyini onlara da et,","poem":1},{"lineBreak":true},{"text":"Çox ah-nalə çəkirəm,","poem":1},{"lineBreak":true},{"text":"Ürəyim taqətdən düşüb.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}