{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"LAM","translationId":"azb_bsa","name":"MƏRSİYƏLƏR","commonName":"MƏRSİYƏLƏR","title":"MƏRSİYƏLƏR KİTABI","order":25,"numberOfChapters":5,"sha256":"58b72d7422ae3c60d29af846445a375b62cfd5f12a87667d9a5705d9141a0e96","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/azb_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Yerusəlimin cəzası"]},{"type":"verse","number":1,"content":[{"text":"Xudavənd Sion qızına qəzəblənərkən","poem":1},{"lineBreak":true},{"text":"Onu hər tərəfdən qara bulud aldı.","poem":1},{"lineBreak":true},{"text":"İsrailin əzəmətini göydən yerə tulladı,","poem":1},{"lineBreak":true},{"text":"Qəzəbləndiyi gün kətilini","poem":1},{"noteId":0},{"text":"xatirindən çıxardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Xudavənd aman vermədən","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinin bütün məskənlərini dağıtdı,","poem":1},{"lineBreak":true},{"text":"Qəzəbi ilə Yəhuda qızının qalalarını yıxdı,","poem":1},{"lineBreak":true},{"text":"Padşahlığı, başçıları yerlə yeksan etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qızğın qəzəbi ilə İsrailin qüvvəsini kökündən kəsdi,","poem":1},{"lineBreak":true},{"text":"Düşmən önündə onun üstündən sağ əlini götürdü.","poem":1},{"lineBreak":true},{"text":"Sanki Yaqub nəslini hər tərəfdən oda saldı","poem":1},{"lineBreak":true},{"text":"Göndərdiyi atəşlə yandırıb-yaxdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Düşmən kimi kamanının yayını dartdı,","poem":1},{"lineBreak":true},{"text":"Yağı kimi sağ əlini qaldırdı,","poem":1},{"lineBreak":true},{"text":"Gözə xoş görünənləri tamamilə öldürdü.","poem":1},{"lineBreak":true},{"text":"Qəzəbini Sion qızının çadırına alov kimi tökdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xudavənd İsraili uddu,","poem":1},{"lineBreak":true},{"text":"Onunla düşmən kimi rəftar etdi.","poem":1},{"lineBreak":true},{"text":"Bütün saraylarını yerlə yeksan etdi,","poem":1},{"lineBreak":true},{"text":"Qalalarını viran qoydu,","poem":1},{"lineBreak":true},{"text":"Yəhudanın fəryadını, fəğanını daha da artırdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Çardağını viranə bağlar tək qırıb tökdü,","poem":1},{"lineBreak":true},{"text":"Görüş yerlərini xarabalığa çevirdi,","poem":1},{"lineBreak":true},{"text":"Rəbb Siona bayram və Şənbə günlərini unutdurdu,","poem":1},{"lineBreak":true},{"text":"Qəzəbi ilə padşahını, kahinini atdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xudavənd qurbangahını rədd etdi,","poem":1},{"lineBreak":true},{"text":"Müqəddəs məkanını tərk etdi.","poem":1},{"lineBreak":true},{"text":"Saraylarının sədlərini düşmən əlinə keçirtdi,","poem":1},{"lineBreak":true},{"text":"Onlar bayram günlərində olduğu kimi","poem":1},{"lineBreak":true},{"text":"Rəbbin məbədində haray qopardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb niyyət etdi ki,","poem":1},{"lineBreak":true},{"text":"Sion qızının divarlarını dağıtsın.","poem":1},{"lineBreak":true},{"text":"Ölçü ipini dartıb, dağıtmaq üçün ondan əl çəkməyəcək.","poem":1},{"lineBreak":true},{"text":"Qala divarını, səddini, matəmə bürüyüb,","poem":1},{"lineBreak":true},{"text":"Hamısı qüvvələrini itirib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Onun darvazalarını yerə batırdı,","poem":1},{"lineBreak":true},{"text":"Cəftələrini qırıb atdı,","poem":1},{"lineBreak":true},{"text":"Padşahlarını, başçılarını","poem":1},{"lineBreak":true},{"text":"Yad millətlərin arasına saldı,","poem":1},{"lineBreak":true},{"text":"Qanuna əməl edilmir,","poem":1},{"lineBreak":true},{"text":"Artıq peyğəmbərlərinə Rəbdən görüntü gəlmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sion qızının ağsaqqalları susub-dinmir,","poem":1},{"lineBreak":true},{"text":"Onlar toz-torpaq içində əyləşib,","poem":1},{"lineBreak":true},{"text":"Başlarına toz töküb, çul geyib,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin bakirə qızları başlarını yerə dikib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ağlamaqdan gözlərimin nuru gedir,","poem":1},{"lineBreak":true},{"text":"Canım əzabdan yanır.","poem":1},{"lineBreak":true},{"text":"Əziz xalqım qırıldığına görə ürəyimdən qan axır.","poem":1},{"lineBreak":true},{"text":"Çünki şəhər meydanlarındakı","poem":1},{"lineBreak":true},{"text":"Körpələrin, uşaqların huşu başından çıxır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şəhər meydanlarında yaralılar kimi huşunu itirirlər,","poem":1},{"lineBreak":true},{"text":"Ana qucağında can verirlər.","poem":1},{"lineBreak":true},{"text":"Analarından soruşurlar:","poem":1},{"lineBreak":true},{"text":"«Hanı çörək, hanı şərab?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ey Yerusəlim qızı, sənə nə deyim?","poem":1},{"lineBreak":true},{"text":"Səni kimlə müqayisə edim?","poem":1},{"lineBreak":true},{"text":"Ey bakirə Sion qızı, səni kimə bənzədim?","poem":1},{"lineBreak":true},{"text":"Bununla mən sənə təsəlli verə bilim?","poem":1},{"lineBreak":true},{"text":"Çünki yaran dəniz qədər dərindir,","poem":1},{"lineBreak":true},{"text":"Sənə kim şəfa verə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sənin üçün görülən görüntülər yalan oldu,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərin səni aldatdı.","poem":1},{"lineBreak":true},{"text":"Firavanlığını sənə qaytarmaq üçün","poem":1},{"lineBreak":true},{"text":"Təqsirlərini üzə çıxartmadılar,","poem":1},{"lineBreak":true},{"text":"Amma bu peyğəmbərlər səni azdırdı,","poem":1},{"lineBreak":true},{"text":"Sənin üçün yalandan görüntülər gördü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yoldan keçən bütün insanlar","poem":1},{"lineBreak":true},{"text":"Qarşında əl çalırlar,","poem":1},{"lineBreak":true},{"text":"Başlarını yelləyib səni fitə basırlar.","poem":1},{"lineBreak":true},{"text":"Yerusəlim qızına belə deyirlər:","poem":1},{"lineBreak":true},{"text":"«Bütün dünyanın gözəllik və sevinc rəmzi olan şəhər budurmu?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bütün düşmənlərin səni ələ salır,","poem":1},{"lineBreak":true},{"text":"Fitə basır, diş qıcıdır,","poem":1},{"lineBreak":true},{"text":"«Onu udduq,","poem":1},{"lineBreak":true},{"text":"Bu günün həsrətini çəkdik, axır ki bunu gördük» deyirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Rəbb Öz iradəsini yerinə yetirdi,","poem":1},{"lineBreak":true},{"text":"Qədim zamanlarda əmr etdiyi sözü həyata keçirtdi.","poem":1},{"lineBreak":true},{"text":"Səni viran qoydu, aman vermədi,","poem":1},{"lineBreak":true},{"text":"Düşmənlərini sənin halına sevindirdi,","poem":1},{"lineBreak":true},{"text":"Yağılarını gücləndirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Xalq Xudavəndə ürəkdən fəryad etdi,","poem":1},{"lineBreak":true},{"text":"Ey Sion qızının divarı!","poem":1},{"lineBreak":true},{"text":"Qoy gecə-gündüz sənin gözlərindən sel kimi yaş axsın,","poem":1},{"lineBreak":true},{"text":"Dincəlmə, aç gözlərini, yumulmasın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Qalx, gecə fəryad etməyə,","poem":1},{"lineBreak":true},{"text":"Gecə növbələri başlayarkən","poem":1},{"lineBreak":true},{"text":"Xudavəndin hüzurunda qəlbini sular kimi açıb tök.","poem":1},{"lineBreak":true},{"text":"Əllərini Ona aç, övladlarının sağ qalmasını dilə,","poem":1},{"lineBreak":true},{"text":"Onlar hər tin başında acından huşunu itirir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ya Rəbb, indi bax, xalqının halını gör!","poem":1},{"lineBreak":true},{"text":"Kiminlə belə rəftar etmisən?","poem":1},{"lineBreak":true},{"text":"Analar uşaqlarını, əziz balalarınımı yesin?","poem":1},{"lineBreak":true},{"text":"Kahinlər, peyğəmbərlər Xudavəndin Müqəddəs məkanındamı qətlə yetirilsin?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Gənclər, qocalar toz-torpaqda, küçələrdə yatır.","poem":1},{"lineBreak":true},{"text":"Bakirə qızlarım, igidlərim qılıncdan keçirilir.","poem":1},{"lineBreak":true},{"text":"Qəzəbləndiyin gün onları qətlə çatdırmısan,","poem":1},{"lineBreak":true},{"text":"Aman vermədən qırmısan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Qorxduqlarımı hər yandan çağırmısan,","poem":1},{"lineBreak":true},{"text":"Elə bil bayrama dəvət etmisən.","poem":1},{"lineBreak":true},{"text":"Rəbbin qəzəb günündə qaçıb-qurtulan olmadı,","poem":1},{"lineBreak":true},{"text":"Onların arasından sağ qalan olmadı,","poem":1},{"lineBreak":true},{"text":"Sevə-sevə övlad böyütmüşdüm,","poem":1},{"lineBreak":true},{"text":"Onları düşmənim həlak etdi.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kətil – burada Əhd sandığı ya da Sion dağı mənasında işlənir.","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/azb_bsa/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}