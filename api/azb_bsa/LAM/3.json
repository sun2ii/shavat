{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"LAM","translationId":"azb_bsa","name":"MƏRSİYƏLƏR","commonName":"MƏRSİYƏLƏR","title":"MƏRSİYƏLƏR KİTABI","order":25,"numberOfChapters":5,"sha256":"58b72d7422ae3c60d29af846445a375b62cfd5f12a87667d9a5705d9141a0e96","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/azb_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Cəza və ümid"]},{"type":"verse","number":1,"content":[{"text":"Rəbbin qəzəb dəyənəyindən","poem":1},{"lineBreak":true},{"text":"Mən əzab çəkirəm,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O məni apardı,","poem":1},{"lineBreak":true},{"text":"İşıqda deyil, qaranlıqda gəzdirdi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bütün gün – dəfələrlə qaldırdığı əli","poem":1},{"lineBreak":true},{"text":"Mənə qarşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ətimi, dərimi çürütdü,","poem":1},{"lineBreak":true},{"text":"Sümüklərimi sındırdı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Məni əzabla, cəfa ilə sarıdı,","poem":1},{"lineBreak":true},{"text":"Mühasirəyə saldı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çoxdan ölüb-gedənlər kimi","poem":1},{"lineBreak":true},{"text":"Məni zülmətdə yaşatdı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ətrafımı hər tərəfdən hasara aldı,","poem":1},{"lineBreak":true},{"text":"Məni zəncirləyib, qaça bilmirəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fəryad edib mən imdad istəyərkən","poem":1},{"lineBreak":true},{"text":"O, duamın qarşısına sədd çəkdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yonma daşlarla yollarımı kəsdi,","poem":1},{"lineBreak":true},{"text":"Onları dolaşdırdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mənə ayı kimi pusqu düzəldir,","poem":1},{"lineBreak":true},{"text":"Gizlənib aslan kimi məni güdür.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yoldan sürükləyib məni parçaladı,","poem":1},{"lineBreak":true},{"text":"Çarəsiz hala saldı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kamanının yayını çəkdi,","poem":1},{"lineBreak":true},{"text":"Məni Özü üçün bir hədəf etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Çəkib oxdanından ox atdı,","poem":1},{"lineBreak":true},{"text":"Böyrəyimə sapladı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gün boyu xalqımın gülüş hədəfinə döndüm,","poem":1},{"lineBreak":true},{"text":"Məzhəkəli nəğmə ilə məni ələ salırlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O, acı otlardan mənə doyunca yedirtdi,","poem":1},{"lineBreak":true},{"text":"Yovşan suyunu içirtdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dişlərimi çınqılla qırdı,","poem":1},{"lineBreak":true},{"text":"Kül içində məni diz çökdürtdü.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Salamatlıqdan canımı uzaq etdi,","poem":1},{"lineBreak":true},{"text":"Yaxşılığı unutdum.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dedim: «Üzərimdən əzəmətim getdi,","poem":1},{"lineBreak":true},{"text":"Rəbdən ümidim kəsildi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Əzabımı və sərgərdanlığımı,","poem":1},{"lineBreak":true},{"text":"Acı yovşanı və zəhəri yada sal.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Daim onları xatırlayıram,","poem":1},{"lineBreak":true},{"text":"Ona görə köksümdən ürəyim üzülür.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Amma bunları yada salarkən","poem":1},{"lineBreak":true},{"text":"Məndə ümid yaranır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rəbbin məhəbbətinə görə məhv olmadıq,","poem":1},{"lineBreak":true},{"text":"Çünki mərhəməti tükənməzdir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hər səhər bunlar təzələnir,","poem":1},{"lineBreak":true},{"text":"Sənin sədaqətin böyükdür.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Öz-özümə deyirəm: «Rəbb mənim nəsibimdir»,","poem":1},{"lineBreak":true},{"text":"Ona görə Rəbbə ümid bəsləyirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Rəbb Ona güvənənlərə,","poem":1},{"lineBreak":true},{"text":"Onu axtaran könüllərə xeyirxahdır.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Rəbbə ümid bəsləmək,","poem":1},{"lineBreak":true},{"text":"Sakitcə bizə qurtuluş verməsini gözləmək nə yaxşıdır.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yaxşı olar ki, insan","poem":1},{"lineBreak":true},{"text":"Boyunduruğunu gənc yaşından daşısın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Qoy susub tənha otursun,","poem":1},{"lineBreak":true},{"text":"Axı Rəbb boynuna boyunduruq salıb.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Üzünü yerə sürtsün,","poem":1},{"lineBreak":true},{"text":"Bəlkə hələ ümid var.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"İzin versin, qoy sifətinə vursunlar,","poem":1},{"lineBreak":true},{"text":"Qoy ona doyunca böhtan atsınlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Çünki Xudavənd əbədilik","poem":1},{"lineBreak":true},{"text":"Bizi Özündən kənar etməz.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Qəm-qüssə versə belə,","poem":1},{"lineBreak":true},{"text":"Bol məhəbbətinə görə rəhmə gələr.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Çünki ürəkdən istəyərək bəşər övladlarına əzab verməz,","poem":1},{"lineBreak":true},{"text":"Heç kimi kədərləndirməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Dünyadakı bütün əsirlərin ayaq altında əzilməsini,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Haqq-Taalanın hüzurunda insanın","poem":1},{"lineBreak":true},{"text":"Öz haqlarından məhrum olmasını,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"İnsanın ədalətdən məhrum olmasını","poem":1},{"lineBreak":true},{"text":"Xudavənd heç görmürmü?","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Xudavənd əmr verməsə,","poem":1},{"lineBreak":true},{"text":"Kimin dediyi həyata keçər?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Həm xeyir, həm də şər,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanın əmri ilə gələr.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Öz günahının cəzasından","poem":1},{"lineBreak":true},{"text":"Sağ qalan insan niyə şikayətlənir?","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Qoy yollarımıza diqqətlə baxaq,","poem":1},{"lineBreak":true},{"text":"Rəbbə yenidən üz tutaq.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Göylərdəki Allaha əllərimizi,","poem":1},{"lineBreak":true},{"text":"Həm də ürəklərimizi açaq.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Deyək: «Biz qanunsuzluq və üsyankarlıq etdik,","poem":1},{"lineBreak":true},{"text":"Bunu bizə bağışlamadın».","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Qəzəbə bürünmüsən, bizi təqib etmisən,","poem":1},{"lineBreak":true},{"text":"Aman vermədən öldürmüsən.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Özünə buludlardan örtük çəkdin,","poem":1},{"lineBreak":true},{"text":"Onların arasından dua keçmir.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Xalqlar arasında","poem":1},{"lineBreak":true},{"text":"Bizi zibilə, tullantıya çevirmisən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Bütün düşmənlərimizin bizə qarşı","poem":1},{"lineBreak":true},{"text":"Ağızları açıldı.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Dəhşət və çuxur,","poem":1},{"lineBreak":true},{"text":"Məhv və qırğın birlikdə başımıza gəldi.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Qırılan əziz xalqıma görə","poem":1},{"lineBreak":true},{"text":"Gözlərimdən sel kimi yaş axdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Dinmədən, dayanmadan","poem":1},{"lineBreak":true},{"text":"Gözlərimdən yaş axacaq,","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Rəbb göylərdən aşağıya baxana qədər,","poem":1},{"lineBreak":true},{"text":"Olanları görənə qədər.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Şəhərimdəki hər qızın taleyini görərkən","poem":1},{"lineBreak":true},{"text":"Ürəyimi kədər bürüyür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Nahaq yerə mənə düşmən olanlar","poem":1},{"lineBreak":true},{"text":"Məni quş tək ovladılar.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Quyuya salıb məni öldürmək istədilər,","poem":1},{"lineBreak":true},{"text":"Daşqalaq etdilər.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Sular başımdan aşdı,","poem":1},{"lineBreak":true},{"text":"Dedim: «Ömrüm sona çatdı».","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Ya Rəbb, ismini","poem":1},{"lineBreak":true},{"text":"O quyunun dibindən səslədim.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"«Qulağını tıxama, fəryadımı dinlə» deyərkən","poem":1},{"lineBreak":true},{"text":"Səsimi eşitdin.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Səni çağıranda yanıma gəldin,","poem":1},{"lineBreak":true},{"text":"Mənə «qorxma» söylədin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Ey Xudavənd, mənim əməlimə baxdın,","poem":1},{"lineBreak":true},{"text":"Həyatımı satın aldın.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Ya Rəbb, başıma gətirdikləri şəri gördün,","poem":1},{"lineBreak":true},{"text":"Bu iş barədə hökmünü ver.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"Mənə bəslədikləri kini,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı qurulan fəndləri gördün.","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Ya Rəbb, mənə etdikləri həqarəti eşitdin,","poem":1},{"lineBreak":true},{"text":"Əleyhimə fənd qururlar.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Əleyhdarlarımın pıçıltısını,","poem":1},{"lineBreak":true},{"text":"Gün boyu mənə qarşı mırıltısını eşitdin.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"Onların oturuşuna-duruşuna bax,","poem":1},{"lineBreak":true},{"text":"Onlara məzhəkə nəğməsi olmuşam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Ya Rəbb, onların əllərinin əməllərinə görə","poem":1},{"lineBreak":true},{"text":"Əvəzini verəcəksən.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"Onların qəlbini inadkar et,","poem":1},{"lineBreak":true},{"text":"Qoy lənətin onların üstünə gəlsin.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Ya Rəbb, qəzəbinlə onları qov,","poem":1},{"lineBreak":true},{"text":"Səma altından məhv edib at!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}