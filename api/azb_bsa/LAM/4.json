{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"LAM","translationId":"azb_bsa","name":"MƏRSİYƏLƏR","commonName":"MƏRSİYƏLƏR","title":"MƏRSİYƏLƏR KİTABI","order":25,"numberOfChapters":5,"sha256":"58b72d7422ae3c60d29af846445a375b62cfd5f12a87667d9a5705d9141a0e96","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/azb_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Dağılmış Yerusəlim"]},{"type":"verse","number":1,"content":[{"text":"Qızıl necə də tutqunlaşdı,","poem":1},{"lineBreak":true},{"text":"Saf qızıl parıltıdan düşdü.","poem":1},{"lineBreak":true},{"text":"Müqəddəs daşlar","poem":1},{"lineBreak":true},{"text":"Hər küçə başına dağılmışlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sion övladları tərəziyə qoyulanda","poem":1},{"lineBreak":true},{"text":"Saf qızıldan da qiymətli idi.","poem":1},{"lineBreak":true},{"text":"İndi isə onlar saxsı qablara,","poem":1},{"lineBreak":true},{"text":"Dulusçunun əl işinə bərabər olublar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Çaqqallar belə, balalarına əmcək verir,","poem":1},{"lineBreak":true},{"text":"Onları əmizdirir.","poem":1},{"lineBreak":true},{"text":"Əziz xalqım isə insafı atır,","poem":1},{"lineBreak":true},{"text":"Səhra dəvəquşularına oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Südəmər körpənin dili","poem":1},{"lineBreak":true},{"text":"Susuzluqdan damağına yapışır.","poem":1},{"lineBreak":true},{"text":"Uşaqlar yemək istəyir, verən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ən ləziz yeməkləri yeyənlər","poem":1},{"lineBreak":true},{"text":"İndi küçələrdə taqətdən düşüblər.","poem":1},{"lineBreak":true},{"text":"Al rəngli paltar geyib-böyüyənlər","poem":1},{"lineBreak":true},{"text":"Zibillikdə yatırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Axı əziz xalqımın təqsiri","poem":1},{"lineBreak":true},{"text":"Sodomun günahını keçdi,","poem":1},{"lineBreak":true},{"text":"Bu şəhər əl toxunmadan","poem":1},{"lineBreak":true},{"text":"Bir andaca yerlə yeksan oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yerusəlimin başçıları qardan da təmiz idi,","poem":1},{"lineBreak":true},{"text":"Süddən də bəyaz idi,","poem":1},{"lineBreak":true},{"text":"Vücudları qıpqırmızı yaqut kimi idi,","poem":1},{"lineBreak":true},{"text":"Zahirən göy yaquta bənzəyirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"İndisə üzləri kömür kimi qaralıb,","poem":1},{"lineBreak":true},{"text":"Küçələrdə heç birini tanımaq olmur,","poem":1},{"lineBreak":true},{"text":"Onlar cılızlaşaraq bir sümük, bir də dəri qalıb,","poem":1},{"lineBreak":true},{"text":"Ağac kimi quruyub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bu aclığın qurbanındansa","poem":1},{"lineBreak":true},{"text":"Qılınc qurbanı olan bəxtiyardır.","poem":1},{"lineBreak":true},{"text":"Zəminin məhsulundan məhrum olmuşdular,","poem":1},{"lineBreak":true},{"text":"Əriyən canlarında can qalmayıb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hətta ən qəlbiyumşaq qadınlar","poem":1},{"lineBreak":true},{"text":"Öz əlləri ilə balalarını bişirirdi.","poem":1},{"lineBreak":true},{"text":"Əziz xalqım qırılarkən","poem":1},{"lineBreak":true},{"text":"Balalarının ətini yeyirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rəbb hiddətini boşaltdı,","poem":1},{"lineBreak":true},{"text":"Qızğın qəzəbini yağdırdı,","poem":1},{"lineBreak":true},{"text":"Sionda alovunu alışdırdı,","poem":1},{"lineBreak":true},{"text":"Onu təməlinədək yandırıb-yaxdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dünyada heç bir padşah inanmazdı ki,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin darvazalarından keçib","poem":1},{"lineBreak":true},{"text":"Yağılar və düşmənlər","poem":1},{"lineBreak":true},{"text":"Bu şəhəri zəbt edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bu iş şəhərdə salehlərin qanının tökülməsi","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərin günahları, kahinlərin təqsirləri üzündən oldu,","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kor kimi küçələrdə dolanırdılar,","poem":1},{"lineBreak":true},{"text":"Qanla murdar oldular,","poem":1},{"lineBreak":true},{"text":"Onların libaslarına belə,","poem":1},{"lineBreak":true},{"text":"Kimsə toxuna bilməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"İnsanlar onlara qışqırır: «Ey murdarlar, rədd olun!","poem":1},{"lineBreak":true},{"text":"İtilin buradan, bizə dəyməyin, rədd olun!»","poem":1},{"lineBreak":true},{"text":"Onlar qaçqın, sərgərdan dolanarkən","poem":1},{"lineBreak":true},{"text":"Başqa millətlər deyir: «Bunlar burada qalmasın!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbb Özü onları pərən-pərən saldı,","poem":1},{"lineBreak":true},{"text":"Onlara yenidən baxmaz,","poem":1},{"lineBreak":true},{"text":"O daha kahinlərə hörmət etmir,","poem":1},{"lineBreak":true},{"text":"Ağsaqqallara xeyirxahlıq göstərmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hər an boş yerə yardım gözləməkdən","poem":1},{"lineBreak":true},{"text":"Gözlərimiz taqətdən düşdü,","poem":1},{"lineBreak":true},{"text":"Bizi qurtara bilməyən milləti","poem":1},{"lineBreak":true},{"text":"Hey gözlədik, gəlmədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ardımızca düşmən düşüb,","poem":1},{"lineBreak":true},{"text":"Küçələrdə gəzə bilmirik.","poem":1},{"lineBreak":true},{"text":"Sonumuz çatdı, günlərimiz bitdi,","poem":1},{"lineBreak":true},{"text":"Aqibətimiz sona yetdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bizi təqib edənlər","poem":1},{"lineBreak":true},{"text":"Göylərdəki qartallardan sürətlidirlər,","poem":1},{"lineBreak":true},{"text":"Dağlarda ardımızca düşdülər,","poem":1},{"lineBreak":true},{"text":"Pusqu qurub səhrada gözlədilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rəbbin məsh etdiyi, həyatımızın nəfəsi","poem":1},{"lineBreak":true},{"text":"Onların xəndəklərində yaxalandı,","poem":1},{"lineBreak":true},{"text":"Halbuki deyirdik: «Onun kölgəsində","poem":1},{"lineBreak":true},{"text":"Millətlərin içində yaşayacağıq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ey Us ölkəsində yaşayan Edom xalqı,","poem":1},{"lineBreak":true},{"text":"Sevin, fərəhlən!","poem":1},{"lineBreak":true},{"text":"Sən də bu kasadan içəcəksən,","poem":1},{"lineBreak":true},{"text":"Sərxoş olub, çılpaq qalacaqsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ey Sion qızı, təqsirinin cəzası sona çatdı,","poem":1},{"lineBreak":true},{"text":"Rəbb səni bir daha sürgünə göndərməyəcək,","poem":1},{"lineBreak":true},{"text":"Ey Edom xalqı, təqsirini cəzasına çatdıracaq,","poem":1},{"lineBreak":true},{"text":"Günahlarını meydana çıxaracaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}