{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"LAM","translationId":"azb_bsa","name":"MƏRSİYƏLƏR","commonName":"MƏRSİYƏLƏR","title":"MƏRSİYƏLƏR KİTABI","order":25,"numberOfChapters":5,"sha256":"58b72d7422ae3c60d29af846445a375b62cfd5f12a87667d9a5705d9141a0e96","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/azb_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Mərhəmət duası"]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, başımıza gələni yada sal","poem":1},{"lineBreak":true},{"text":"Gör bu xəcalətimizi, buna nəzər sal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İrs torpağımız yadellilərin əlinə keçib,","poem":1},{"lineBreak":true},{"text":"Evlərimiz əcnəbilərə verilib.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atalarımız öldü, yetim qaldıq,","poem":1},{"lineBreak":true},{"text":"Analarımız dul qaldı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Suyumuzu pulla alıb içirik,","poem":1},{"lineBreak":true},{"text":"Pulla odun almağa məcburuq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bizi qovub başımızdan basırlar,","poem":1},{"lineBreak":true},{"text":"Yorulmuşuq, bizi rahat qoymurlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Doyunca çörək yemək üçün","poem":1},{"lineBreak":true},{"text":"Misirə, Aşşura əl açmışıq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ata-babalarımız günah işlədərək keçib-getdi,","poem":1},{"lineBreak":true},{"text":"Təqsirlərinin cəzası üstümüzə yükləndi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qullar bizə hökmran olub,","poem":1},{"lineBreak":true},{"text":"Bizi onların əlindən qurtaran yoxdur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çöldəki qılınca görə,","poem":1},{"lineBreak":true},{"text":"Canımız bahasına çörək qazanırıq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aclıq bizi yandırıb-yaxdığına görə","poem":1},{"lineBreak":true},{"text":"Dərimiz qaralıb, kürəyə bənzəyir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sionda qadınlar,","poem":1},{"lineBreak":true},{"text":"Yəhuda şəhərlərindəki bakirə qızlar zorlanır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Başçılar əllərindən asılıb,","poem":1},{"lineBreak":true},{"text":"Ağsaqqallar hörmətdən düşüb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Məcburiyyət qarşısında cavanlar əl dəyirmanını çəkir,","poem":1},{"lineBreak":true},{"text":"Oğlanlar odun yükləri altında səndələyir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Şəhər darvazasında ağsaqqallar oturmur,","poem":1},{"lineBreak":true},{"text":"Gənclər çalğı alətlərində çalmır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ürəyimizdən şadlıq çəkilib,","poem":1},{"lineBreak":true},{"text":"Oyunlarımız yasa çevrilib.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Başımızın tacı düşüb,","poem":1},{"lineBreak":true},{"text":"Vay halımıza! Çünki günah işlətmişik.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Buna görə ürəklərimiz çəkilib,","poem":1},{"lineBreak":true},{"text":"Gözlərimiz qaralıb,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki Sion dağı viran qalıb,","poem":1},{"lineBreak":true},{"text":"Üstündə tülkülər gəzib-dolaşır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sən isə, ya Rəbb, əbədi hökmransan,","poem":1},{"lineBreak":true},{"text":"Nəsildən-nəslə qədər taxtında oturacaqsan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Uzun zamandan bəri niyə bizi bu qədər tərk etmisən?","poem":1},{"lineBreak":true},{"text":"Niyə bizi bu qədər uzun müddətə tərk etmisən?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ya Rəbb, bizi Özünə qaytar,","poem":1},{"lineBreak":true},{"text":"Təzədən əvvəlki günlərimizə qayıdaq!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yoxsa hüzurundan bizi tamamilə atmısan,","poem":1},{"lineBreak":true},{"text":"Bizə qarşı hədsiz qəzəblənmisən?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}