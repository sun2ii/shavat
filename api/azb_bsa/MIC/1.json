{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Samariya və Yerusəlim üçün mərsiyə"]},{"type":"verse","number":1,"content":["Yəhuda padşahları Yotam, Axaz və Xizqiyanın dövründə Samariya və Yerusəlim barəsində Moreşetli Mikeyaya görüntü ilə Rəbbin bu sözü nazil oldu."]},{"type":"verse","number":2,"content":[{"text":"Eşidin, ey bütün xalqlar,","poem":1},{"lineBreak":true},{"text":"Qulaq asın, yer üzü və orada yaşayanlar!","poem":1},{"lineBreak":true},{"text":"Qoy Xudavənd Rəbb sizə qarşı müqəddəs məbədindən","poem":1},{"lineBreak":true},{"text":"Şəhadət etsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Budur, Rəbb göylərdəki taxtından enir,","poem":1},{"lineBreak":true},{"text":"Yer üzünü dağların zirvəsi ilə gəzir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Od yanında əriyən mum tək önündə dağlar əriyəcək,","poem":1},{"lineBreak":true},{"text":"Təpələrdən gələn sellər tək yarğanlar açacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bunlar Yaqub övladlarının üsyankarlığına,","poem":1},{"lineBreak":true},{"text":"İsrail xalqının günahlarına görədir.","poem":1},{"lineBreak":true},{"text":"Yaqub övladlarının üsyankarlığına görə","poem":1},{"lineBreak":true},{"text":"Axı kimdir müqəssir? Samariya deyilmi?","poem":1},{"lineBreak":true},{"text":"Yəhudanın bütpərəstliyinə görə","poem":1},{"lineBreak":true},{"text":"Axı kimdir təqsirkar? Yerusəlim deyilmi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Buna görə Mən Rəbb Samariyanı yerlə yeksan edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yerində üzümlük salınacaq.","poem":1},{"lineBreak":true},{"text":"Daşlarını dərəyə tökəcəyəm,","poem":1},{"lineBreak":true},{"text":"Təməllərini açıq qoyacağam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Samariyanın bütün oyma bütləri parça-parça olacaq,","poem":1},{"lineBreak":true},{"text":"Məbədinə verilən hədiyyələr yandırılacaq,","poem":1},{"lineBreak":true},{"text":"Bütün heykəllərini dağıdacağam.","poem":1},{"lineBreak":true},{"text":"Axı bu hədiyyələr fahişəlik haqqı ilə yığılmışdı,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Onlar yenə də fahişələr üçün işlədiləcək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Buna görə Mən Mikeya, ağlayıb göz yaşı axıdacağam,","poem":1},{"lineBreak":true},{"text":"Ayaqyalın, lüt-üryan dolaşacağam,","poem":1},{"lineBreak":true},{"text":"Çaqqal kimi ulayacağam,","poem":1},{"lineBreak":true},{"text":"Bayquş kimi səs salacağam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Samariyanın yaraları sağalmaz,","poem":1},{"lineBreak":true},{"text":"Yəhudayadək yayılıb,","poem":1},{"lineBreak":true},{"text":"Xalqımın darvazalarınadək,","poem":1},{"lineBreak":true},{"text":"Yerusəlimədək çatıb.","poem":1}]},{"type":"heading","content":["Düşmən Yerusəlimə yaxınlaşır"]},{"type":"verse","number":10,"content":[{"text":"Bunu Qatda bildirməyin,","poem":1},{"lineBreak":true},{"text":"Önlərində ağlamayın.","poem":1},{"lineBreak":true},{"text":"Bet-Leafrada","poem":1},{"noteId":1},{"text":"toz-torpaqda yuvarlanın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siz ey Şafir","poem":1},{"noteId":2},{"text":"sakinləri,","poem":1},{"lineBreak":true},{"text":"Lüt-üryan, xəcalət içində əsarətə gedin!","poem":1},{"lineBreak":true},{"text":"Saananda","poem":1},{"noteId":3},{"text":"yaşayanlar oradan çıxa bilməyəcək.","poem":1},{"lineBreak":true},{"text":"Bet-Esel əhli yas tutacaq,","poem":1},{"lineBreak":true},{"text":"Köməyini sizdən çəkəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Marot","poem":1},{"noteId":4},{"text":"əhalisi xeyir arzulasa da,","poem":1},{"lineBreak":true},{"text":"Rəbb Yerusəlimin darvazasına bəla gətirir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey Lakiş","poem":1},{"noteId":5},{"text":"sakinləri, atlarınızı","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarına qoşun","poem":1},{"lineBreak":true},{"text":"Sion qızını günaha batırdınız,","poem":1},{"lineBreak":true},{"text":"İsrailin üsyankarlığına bais oldunuz!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Buna görə Moreşet-Qata","poem":1},{"noteId":6},{"text":"cehiz verəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Akziv","poem":1},{"noteId":7},{"text":"şəhəri İsrail padşahlarını aldadacaq.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ey Mareşa","poem":1},{"noteId":8},{"text":"sakinləri,","poem":1},{"lineBreak":true},{"text":"Rəbb üzərinizə yenə istilaçı gətirəcək,","poem":1},{"lineBreak":true},{"text":"Adullam mağarasına İsrailin adlı-sanlı adamları sığınacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ey Yəhuda, əziz balalarından ötrü saçını qırx,","poem":1},{"lineBreak":true},{"text":"Qoy başın kərkəs başı kimi keçəl olsun,","poem":1},{"lineBreak":true},{"text":"Çünki övladların sürgünə aparılacaq!","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Burada bütpərəst məbədlərində tətbiq olunan mərasim nəzərdə tutulur.","reference":{"chapter":1,"verse":7}},{"noteId":1,"caller":"+","text":"Bet-Leafra – ibrani dilində toz evi.","reference":{"chapter":1,"verse":10}},{"noteId":2,"caller":"+","text":"Şafir – ibrani dilində xoş.","reference":{"chapter":1,"verse":11}},{"noteId":3,"caller":"+","text":"Saanan – ibrani dilində çıxmaq.","reference":{"chapter":1,"verse":11}},{"noteId":4,"caller":"+","text":"Marot – ibrani dilində acı.","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"+","text":"Lakiş – ibrani dilində bir dəstə at sözünə oxşayır.","reference":{"chapter":1,"verse":13}},{"noteId":6,"caller":"+","text":"Moreşet – ibrani dilində gəlin sözünə oxşayır.","reference":{"chapter":1,"verse":14}},{"noteId":7,"caller":"+","text":"Akziv – ibrani dilində aldatmaq.","reference":{"chapter":1,"verse":14}},{"noteId":8,"caller":"+","text":"Mareşa – ibrani dilində istilaçı.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/azb_bsa/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}