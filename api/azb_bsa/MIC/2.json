{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Kasıblara zülm edənlərin taleyi"]},{"type":"verse","number":1,"content":[{"text":"Yatağında şər niyyətdə olanların,","poem":1},{"lineBreak":true},{"text":"Yamanlıq üçün qəsd quranların vay halına!","poem":1},{"lineBreak":true},{"text":"Onların gücü buna çatdığına görə","poem":1},{"lineBreak":true},{"text":"Ona səhər tezdən əməl edirlər!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tarlalara tamah salıb mənimsəyirlər,","poem":1},{"lineBreak":true},{"text":"Evlərə göz dikib sahib dururlar.","poem":1},{"lineBreak":true},{"text":"Ev sahibi ilə ailəsinə zülm edirlər,","poem":1},{"lineBreak":true},{"text":"Adamları mirasından məhrum edirlər!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buna görə də Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Bu xalqa bəla gətirməyə hazırlaşıram,","poem":1},{"lineBreak":true},{"text":"Ondan boyun qaçıra bilməyəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Siz bir daha dikbaş gəzməyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Çünki pis zaman gəlir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O gün sizi lağa qoyub,","poem":1},{"lineBreak":true},{"text":"Belə yanıqlı mərsiyə oxuyacaqlar:","poem":1},{"lineBreak":true},{"text":"“Biz tamam məhv olduq!","poem":1},{"lineBreak":true},{"text":"Rəbb xalqımın payını dəyişdirdi,","poem":1},{"lineBreak":true},{"text":"Onu necə məndən uzaqlaşdırdı,","poem":1},{"lineBreak":true},{"text":"Tarlamızı satqınlara payladı”.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buna görə ölkə yenə püşklə bölünsə də,","poem":1},{"lineBreak":true},{"text":"Rəbbin camaatı arasında sizə pay verəcək kimsə olmayacaq».","poem":1}]},{"type":"heading","content":["Yalançı vaizlər"]},{"type":"verse","number":6,"content":[{"text":"Adamlar deyir:","poem":1},{"lineBreak":true},{"text":"«Vəz etməyin,","poem":1},{"lineBreak":true},{"text":"Bu işlər barədə vəz etməyin,","poem":1},{"lineBreak":true},{"text":"Rüsvay olmayacağıq!»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey Yaqub nəsli, belə deyilirmi:","poem":1},{"lineBreak":true},{"text":"«Məgər Rəbbin səbri tükəndi?","poem":1},{"lineBreak":true},{"text":"O belə şeylər edərmi?»","poem":1},{"lineBreak":true},{"text":"Mənim sözlərim düzgün yolla gəzənlərin xeyrinə deyilmi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dünən xalqım idiniz,","poem":1},{"lineBreak":true},{"text":"Bu gün isə Mənə düşmən oldunuz.","poem":1},{"lineBreak":true},{"text":"Müharibədən qayıdanların,","poem":1},{"lineBreak":true},{"text":"Yoldan sakit keçənlərin","poem":1},{"lineBreak":true},{"text":"Əynindən paltarlarını alıb","poem":1},{"lineBreak":true},{"text":"Onları soyursunuz.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xalqımın qadınlarını","poem":1},{"lineBreak":true},{"text":"Rahat evlərindən qovursunuz,","poem":1},{"lineBreak":true},{"text":"Uşaqlarını Mənim verdiyim bərəkətdən","poem":1},{"lineBreak":true},{"text":"Əbədilik məhrum edirsiniz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qalxın gedin,","poem":1},{"lineBreak":true},{"text":"Çünki bura istirahət yeri deyil.","poem":1},{"lineBreak":true},{"text":"Bu yer murdarlandığına görə","poem":1},{"lineBreak":true},{"text":"Dəhşətli surətdə darmadağın olacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əgər bir adam hiyləgər ruhla gəlib yalan vəz edib desə:","poem":1},{"lineBreak":true},{"text":"«Sənə vəz edim, şərab və başqa kefləndirici içkiniz bol olacaq»,","poem":1},{"lineBreak":true},{"text":"Bu adam xalqın vaizi olar!","poem":1}]},{"type":"heading","content":["Rəbbin ümid vədi"]},{"type":"verse","number":12,"content":[{"text":"Ey Yaqub övladları,","poem":1},{"lineBreak":true},{"text":"Mən mütləq hamınızı bir yerə yığacağam,","poem":1},{"lineBreak":true},{"text":"İsrailin sağ qalanlarını toplayacağam.","poem":1},{"lineBreak":true},{"text":"Sizi ağıldakı qoyun-keçi kimi bir yerə yığacağam.","poem":1},{"lineBreak":true},{"text":"Otlaqdakı sürü kimi ölkəniz adamlarla dolacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Azad edən qalxacaq,","poem":1},{"lineBreak":true},{"text":"Sağ qalanların yolunu açacaq.","poem":1},{"lineBreak":true},{"text":"Onlar darvazanı qıracaq,","poem":1},{"lineBreak":true},{"text":"Oradan keçib-çıxacaq.","poem":1},{"lineBreak":true},{"text":"Padşahları onların qabağında gedəcək,","poem":1},{"lineBreak":true},{"text":"Rəbb önlərində gedəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}