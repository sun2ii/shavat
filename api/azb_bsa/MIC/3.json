{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Mikeya İsrail rəhbərlərini ittiham edir"]},{"type":"verse","number":1,"content":[{"text":"Onda mən dedim:","poem":1},{"lineBreak":true},{"text":"«Dinləyin, ey Yaqub rəhbərləri,","poem":1},{"lineBreak":true},{"text":"Ey İsrail xalqının başçıları!","poem":1},{"lineBreak":true},{"text":"Axı siz ədalətli olmalısınız!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siz ki yaxşıya nifrət edirsiniz,","poem":1},{"lineBreak":true},{"text":"Pisliyi sevirsiniz,","poem":1},{"lineBreak":true},{"text":"Xalqımın dərisini soyursunuz,","poem":1},{"lineBreak":true},{"text":"Ətini sümüklərindən qoparırsınız,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siz xalqımın ətini yeyirsiniz,","poem":1},{"lineBreak":true},{"text":"Dərisini soyursunuz, sümüyünü qırırsınız.","poem":1},{"lineBreak":true},{"text":"Sanki qazanda, tavada bişirilən ət kimi","poem":1},{"lineBreak":true},{"text":"Xalqımı doğrayırsınız.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gün gələcək, Rəbbə fəryad edəndə","poem":1},{"lineBreak":true},{"text":"O sizə cavab verməyəcək.","poem":1},{"lineBreak":true},{"text":"O zaman Rəbb üzünü sizdən gizlədəcək,","poem":1},{"lineBreak":true},{"text":"Çünki əməlləriniz pis olub».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xalqını azdıran peyğəmbərlərə qarşı","poem":1},{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Yeməyiniz olanda","poem":1},{"lineBreak":true},{"text":"Sülh bəyan edirsiniz.","poem":1},{"lineBreak":true},{"text":"Sizə çörək verməyənlərə isə","poem":1},{"lineBreak":true},{"text":"Dava elan edirsiniz».","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna görə sizə görüntüsüz gecə gələcək,","poem":1},{"lineBreak":true},{"text":"Qaranlıqda falçılıq edə bilməyəcəksiniz.","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlər üçün günəş batacaq,","poem":1},{"lineBreak":true},{"text":"Gündüz onlar üçün zülmət olacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Görücülər rüsvay olacaq,","poem":1},{"lineBreak":true},{"text":"Falçılar biabır olacaq,","poem":1},{"lineBreak":true},{"text":"Onların hamısı bundan utanıb susacaq,","poem":1},{"lineBreak":true},{"text":"Çünki Allahdan cavab olmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mən isə Yaqub övladlarına üsyankarlığını,","poem":1},{"lineBreak":true},{"text":"İsrailə günahını bildirmək üçün","poem":1},{"lineBreak":true},{"text":"Qüvvətlə, Rəbbin Ruhu ilə,","poem":1},{"lineBreak":true},{"text":"Ədalət və cəsarətlə qurşanıram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bunu dinləyin, ey Yaqub rəhbərləri,","poem":1},{"lineBreak":true},{"text":"Ey İsrail xalqının başçıları!","poem":1},{"lineBreak":true},{"text":"Siz ədalətə nifrət edirsiniz,","poem":1},{"lineBreak":true},{"text":"Hər cür düzlüyü əyriyə çevirirsiniz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sionu qan bahasına bina edirsiniz,","poem":1},{"lineBreak":true},{"text":"Yerusəlimi haqsızlıq üzərində tikirsiniz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəhbərləri rüşvətlə hökm edir,","poem":1},{"lineBreak":true},{"text":"Kahinləri muzdla təlim verir,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərləri falçılıq edib pul alır.","poem":1},{"lineBreak":true},{"text":"Amma Rəbbə güvənərək belə deyirlər:","poem":1},{"lineBreak":true},{"text":"«Rəbb aramızda deyilmi?","poem":1},{"lineBreak":true},{"text":"Üstümüzə bəla gəlməz».","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buna görə də sizin üzünüzdən","poem":1},{"lineBreak":true},{"text":"Sion tarla kimi şumlanacaq,","poem":1},{"lineBreak":true},{"text":"Yerusəlim daş qalağına,","poem":1},{"lineBreak":true},{"text":"Məbədin tikildiyi dağ","poem":1},{"lineBreak":true},{"text":"Meşəli təpələrə çevriləcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}