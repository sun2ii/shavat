{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Rəbb bütün dünyada əmin-amanlıqla hökm sürəcək"]},{"type":"verse","number":1,"content":[{"text":"Axır zamanda Rəbbin evi olan dağ","poem":1},{"lineBreak":true},{"text":"Dağların zirvəsində möhkəm duracaq,","poem":1},{"lineBreak":true},{"text":"Təpələrdən yuxarı ucalacaq.","poem":1},{"lineBreak":true},{"text":"Xalqlar ona sarı gələcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çox millətlər gəlib deyəcək:","poem":1},{"lineBreak":true},{"text":"«Gəlin Rəbbin dağına,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının evinə qalxaq,","poem":1},{"lineBreak":true},{"text":"Qoy Rəbb bizə Öz yollarını öyrətsin,","poem":1},{"lineBreak":true},{"text":"Biz Onun rizləri ilə gedək».","poem":1},{"lineBreak":true},{"text":"Siondan Rəbbin təlimi,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdən Onun kəlamı yayılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbb çox xalqlar arasında hakim olacaq,","poem":1},{"lineBreak":true},{"text":"Güclü millətlər haqqında qərar çıxaracaq.","poem":1},{"lineBreak":true},{"text":"Onlar qılınclarından kotan,","poem":1},{"lineBreak":true},{"text":"Nizələrindən isə dəryaz düzəldəcək.","poem":1},{"lineBreak":true},{"text":"Millət millətə qarşı qılınc qaldırmayacaq,","poem":1},{"lineBreak":true},{"text":"Artıq dava etməyi öyrənməyəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hər kəs öz meynəsinin, əncir ağacının altında əyləşəcək,","poem":1},{"lineBreak":true},{"text":"Onları qorxudan olmayacaq.","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi belə söz verdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bütün xalqlar,","poem":1},{"lineBreak":true},{"text":"Öz allahlarının adı ilə getsələr belə,","poem":1},{"lineBreak":true},{"text":"Biz daim və əbədi","poem":1},{"lineBreak":true},{"text":"Allahımız Rəbbin adı ilə gedirik.","poem":1}]},{"type":"heading","content":["Rəbbin xalqı sürgündən qayıdacaq"]},{"type":"verse","number":6,"content":[{"text":"«Gün gələcək» Rəbb bəyan edir,","poem":1},{"lineBreak":true},{"text":"«Mən şikəstləri yığacağam,","poem":1},{"lineBreak":true},{"text":"İncitdiyim pərən-pərən düşən xalqı","poem":1},{"lineBreak":true},{"text":"Bir yerə toplayacağam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şikəstləri sağ qalan xalq edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Atılanları güclü millətə çevirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Mən Rəbb onlara Sion dağından","poem":1},{"lineBreak":true},{"text":"İndidən sonsuzadək hökm edəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sən, ey Yerusəlim, sürüyə nəzarət edən qüllə,","poem":1},{"lineBreak":true},{"text":"Sion qızının qalası,","poem":1},{"lineBreak":true},{"text":"Əvvəlki hakimiyyət sənə yenidən veriləcək,","poem":1},{"lineBreak":true},{"text":"Yerusəlim qızının səltənəti gələcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İndi nə üçün uca səslə çağırırsan?","poem":1},{"lineBreak":true},{"text":"Niyə doğan qadın kimi ağrı çəkirsən?","poem":1},{"lineBreak":true},{"text":"Məgər sənin yanında padşah yoxdurmu?","poem":1},{"lineBreak":true},{"text":"Məsləhətçilərin həlak olubmu?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Sion qızı, ağrıdan qovrul,","poem":1},{"lineBreak":true},{"text":"Doğan qadın kimi bərkdən qışqır,","poem":1},{"lineBreak":true},{"text":"Çünki şəhərdən çıxıb, çöldə yaşayacaqsan,","poem":1},{"lineBreak":true},{"text":"Babilə qədər gedəcəksən.","poem":1},{"lineBreak":true},{"text":"Lakin orada xilas olacaqsan,","poem":1},{"lineBreak":true},{"text":"Rəbb səni düşmənlərinin əlindən satın alacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amma indi çox millətlər","poem":1},{"lineBreak":true},{"text":"Sənə qarşı birləşib belə deyir:","poem":1},{"lineBreak":true},{"text":"«Qoy Sion rüsvay olub murdarlansın!","poem":1},{"lineBreak":true},{"text":"Bunu öz gözümüzlə görək!»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lakin onlar Rəbbin düşüncələrini bilmir,","poem":1},{"lineBreak":true},{"text":"Məsləhətini anlamır.","poem":1},{"lineBreak":true},{"text":"Xırmanda yığılan dərzlər kimi","poem":1},{"lineBreak":true},{"text":"Rəbb onları bir yerə toplamışdır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb belə deyir: «Ey Sion qızı,","poem":1},{"lineBreak":true},{"text":"Qalx, xırmandakı taxılını döy!","poem":1},{"lineBreak":true},{"text":"Səni dəmir buynuzlu buğa kimi,","poem":1},{"lineBreak":true},{"text":"Tunc dırnaqlı öküz kimi güclü edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Sən çox xalqları əzəcəksən,","poem":1},{"lineBreak":true},{"text":"Onların qənimətini Mənə – Rəbbə,","poem":1},{"lineBreak":true},{"text":"Mal-dövlətini bütün yer üzünün Sahibinə həsr edəcəksən».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}