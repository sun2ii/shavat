{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ey qoşunlar qızı, indi qoşunlarını topla!","poem":1},{"lineBreak":true},{"text":"Bizi dövrəyə alıblar,","poem":1},{"lineBreak":true},{"text":"İsrail hökmdarının üzünə dəyənəklə vuracaqlar.","poem":1}]},{"type":"heading","content":["Gələcək kamil hökmdar"]},{"type":"verse","number":2,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Ey Bet-Lexem Efrata, sən","poem":1},{"lineBreak":true},{"text":"Yəhuda nəsillərinin kiçiyi olsan da,","poem":1},{"lineBreak":true},{"text":"Mənim üçün İsrail üzərində","poem":1},{"lineBreak":true},{"text":"Hökmdar səndən çıxacaq.","poem":1},{"lineBreak":true},{"text":"Onun nəsli çox qədimlərə,","poem":1},{"lineBreak":true},{"text":"Zamanın başlanğıcına gedir».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hamilə qadın doğana qədər","poem":1},{"lineBreak":true},{"text":"Rəbb Öz xalqını təslim edəcək.","poem":1},{"lineBreak":true},{"text":"İsrail övladlarının yanına","poem":1},{"lineBreak":true},{"text":"Qalan qohumları qayıdacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu hökmdar Allahı Rəbbin əzəmətli adı ilə qalxacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbin gücü ilə sürüsünü otaracaq.","poem":1},{"lineBreak":true},{"text":"Çünki yer üzünün qurtaracağınadək hər yerdə o böyük olacaq,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xalq onun bəxş etdiyi sülhlə yaşayacaq.","poem":1},"Qurtuluş və cəza",{"text":"Əgər Aşşurlular ölkəmizə gələrsə,","poem":1},{"lineBreak":true},{"text":"Qalalarımıza ayaq açarlarsa,","poem":1},{"lineBreak":true},{"text":"Onlara qarşı başçılarımız –","poem":1},{"lineBreak":true},{"text":"Xalqımızdan olan çoxlu rəhbərlərimiz çıxar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qılıncla Aşşur torpaqlarını,","poem":1},{"lineBreak":true},{"text":"Nəmrud ölkəsini viran edəcəklər.","poem":1},{"lineBreak":true},{"text":"Aşşurlular torpağımıza gələndə,","poem":1},{"lineBreak":true},{"text":"Sərhədimizi keçəndə","poem":1},{"lineBreak":true},{"text":"Bizi rəhbərlərimiz qurtaracaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaqub nəslinin sağ qalanları","poem":1},{"lineBreak":true},{"text":"Çoxlu xalqlar arasında","poem":1},{"lineBreak":true},{"text":"Heç kimi gözləmədən,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarından asılı olmadan","poem":1},{"lineBreak":true},{"text":"Rəbbin göndərdiyi şeh tək,","poem":1},{"lineBreak":true},{"text":"Ot üzərinə tökülən leysan kimi olacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaqub nəslinin sağ qalanları","poem":1},{"lineBreak":true},{"text":"Çoxlu xalqların, millətlərin arasında","poem":1},{"lineBreak":true},{"text":"Sanki meşə heyvanları arasındakı şir,","poem":1},{"lineBreak":true},{"text":"Qoyun sürüsü arasındakı gənc aslandır.","poem":1},{"lineBreak":true},{"text":"Sürünün içinə girsə, didib dağıdar,","poem":1},{"lineBreak":true},{"text":"Heç kəs ondan qurtula bilməz.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Əlin düşmənlərin üzərinə qalxacaq,","poem":1},{"lineBreak":true},{"text":"Ey İsrail, yağıların məhv olacaq!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Gün gələcək» Rəbb bəyan edir,","poem":1},{"lineBreak":true},{"text":"«Atlarınızı qıracağam,","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarınızı yox edəcəyəm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ölkənizdəki şəhərləri darmadağın edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün qalalarınızı yerlə yeksan edəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əlinizdəki cadugərliyi məhv edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sizdə gələcəyideyənlər bir daha olmayacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sizin bütlərinizi qıracağam,","poem":1},{"lineBreak":true},{"text":"Daş sütunlarınızı söküb-dağıdacağam.","poem":1},{"lineBreak":true},{"text":"Əllərinizlə düzəltdiyiniz əşyaya","poem":1},{"lineBreak":true},{"text":"Artıq səcdə etməyəcəksiniz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sizin Aşera bütlərinizi qırıb-dağıdacağam.","poem":1},{"lineBreak":true},{"text":"Şəhərlərinizi viran qoyacağam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"İtaətsiz millətlərdən qəzəblə, hiddətlə qisas alacağam».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}