{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Rəbbin İsrailə qarşı ittihamı"]},{"type":"verse","number":1,"content":[{"text":"Rəbbin nə dediyini indi dinləyin:","poem":1},{"lineBreak":true},{"text":"«Məhkəmə qarşısında durun,","poem":1},{"lineBreak":true},{"text":"Qoy dağlar bunun şahidi olsun,","poem":1},{"lineBreak":true},{"text":"Qoy təpələr səsinizi eşitsin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey dağlar və yerin sarsılmaz təməlləri,","poem":1},{"lineBreak":true},{"text":"Rəbbin ittihamını eşidin!","poem":1},{"lineBreak":true},{"text":"Rəbb Öz xalqını ittiham edir,","poem":1},{"lineBreak":true},{"text":"İsraili məhkəməyə verir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey xalqım, nə etmişəm sənə?","poem":1},{"lineBreak":true},{"text":"Nə ilə yormuşam səni?","poem":1},{"lineBreak":true},{"text":"Mənə cavab ver!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səni Misir torpağından çıxaran,","poem":1},{"lineBreak":true},{"text":"Köləlik diyarından sizi satın alan,","poem":1},{"lineBreak":true},{"text":"Musanı, Harunu, Məryəmi,","poem":1},{"lineBreak":true},{"text":"Sənin qabağına göndərən Mən oldum.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey xalqım, sənə qarşı","poem":1},{"lineBreak":true},{"text":"Moav padşahı Balaqın niyyətlərini,","poem":1},{"lineBreak":true},{"text":"Beor oğlu Bilamın ona nə cavab verdiyini xatırla,","poem":1},{"lineBreak":true},{"text":"Şittimdən Qilqala gedəndə yolda nə baş verdiyini xatırla ki,","poem":1},{"lineBreak":true},{"text":"Rəbbin sənə göstərdiyi sədaqətini biləsən».","poem":1}]},{"type":"heading","content":["Rəbbin adamlardan istəyi"]},{"type":"verse","number":6,"content":[{"text":"Rəbbin hüzuruna nə ilə gedim?","poem":1},{"lineBreak":true},{"text":"Uca Allaha necə səcdə edim?","poem":1},{"lineBreak":true},{"text":"Önünə yandırma qurbanları ilə –","poem":1},{"lineBreak":true},{"text":"Birillik danalarla çıxımmı?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Minlərlə qoç qurbanı,","poem":1},{"lineBreak":true},{"text":"Zeytun yağının on minlərlə seli Rəbbin xoşuna gələrmi?","poem":1},{"lineBreak":true},{"text":"Üsyankarlığıma görə ilk oğlumu,","poem":1},{"lineBreak":true},{"text":"Günahım üçün öz övladımı verimmi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey insan, Allah sənə yaxşı olanı bildirdi;","poem":1},{"lineBreak":true},{"text":"Ədalət yaratmaqdan, məhəbbət göstərməyi sevməkdən,","poem":1},{"lineBreak":true},{"text":"İtaətkarcasına Allahınla bir yol getməkdən başqa","poem":1},{"lineBreak":true},{"text":"Rəbb səndən nə istəyir ki?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbbin səsi şəhərə nida edir,","poem":1},{"lineBreak":true},{"text":"Onun adından qorxmaq hikmətdir.","poem":1},{"lineBreak":true},{"text":"«Ey şəhərdə toplanan camaat, eşidin!","poem":1},{"lineBreak":true},{"text":"Ey şəhər sakinləri, dinləyin!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məgər pislərin evindəki haram mal-dövlətdən,","poem":1},{"lineBreak":true},{"text":"Lənətli əskik ölçülərdən xəbərim yoxdur?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Saxta tərəzi və aldadıcı çəki daşlarından","poem":1},{"lineBreak":true},{"text":"İstifadə edəni haqlı sayarammı?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Şəhərin varlıları zorakılıq edir,","poem":1},{"lineBreak":true},{"text":"Sakinləri adamları aldadır –","poem":1},{"lineBreak":true},{"text":"Yalanla nəfəs alır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Buna görə Mən sizi vurmağa,","poem":1},{"lineBreak":true},{"text":"Günahlarınıza görə əzab verməyə başladım.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yeyəcəksiniz, amma doymayacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qarınlarınız boş qalacaq.","poem":1},{"lineBreak":true},{"text":"Sərvət yığacaqsınız, amma saxlamayacaqsınız,","poem":1},{"lineBreak":true},{"text":"Qılıncla topladığınızı məhv edəcəyəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Siz əkəcəksiniz, amma biçməyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Zeytun sıxacaqsınız, yağından ətir düzəltməyəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Üzüm sıxacaqsınız, şərab içməyəcəksiniz.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Axı padşah Omrinin qaydalarına riayət etmisiniz,","poem":1},{"lineBreak":true},{"text":"Axav sülaləsinin adətlərinə uymusunuz,","poem":1},{"lineBreak":true},{"text":"Onların məsləhətinə görə getmisiniz,","poem":1},{"lineBreak":true},{"text":"Buna görə də sizi viranəliyə döndərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sakinlərinizi rişxənd hədəfinə çevirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Xalqım olduğunuz üçün rüsvay ediləcəksiniz».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}