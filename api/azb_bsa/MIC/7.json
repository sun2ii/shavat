{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"MIC","translationId":"azb_bsa","name":"MİKEYA","commonName":"MİKEYA","title":"MİKEYA PEYĞƏMBƏRİN KİTABI","order":33,"numberOfChapters":7,"sha256":"05d8f824d55fff141aafd8367eb5f56dc1db51b99a68872eed04244aa496c124","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/azb_bsa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Mikeyanın mərsiyəsi"]},{"type":"verse","number":1,"content":[{"text":"Vay halıma!","poem":1},{"lineBreak":true},{"text":"Mən bir adama bənzəyirəm ki,","poem":1},{"lineBreak":true},{"text":"Yay mövsümündən sonra","poem":1},{"lineBreak":true},{"text":"Meyvəsi tamam yığılmış,","poem":1},{"lineBreak":true},{"text":"Tənəkləri təmizlənmiş,","poem":1},{"lineBreak":true},{"text":"Nə üzüm salxımı,","poem":1},{"lineBreak":true},{"text":"Nə də könlü istəyən bir dənə əncir yeməyə qalıb.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ölkədə Allaha sadiq adam qalmadı,","poem":1},{"lineBreak":true},{"text":"İnsanlar arasında doğru adam tükəndi.","poem":1},{"lineBreak":true},{"text":"Hamı qan tökmək üçün pusquda durur,","poem":1},{"lineBreak":true},{"text":"Qardaş qardaşa tələ qurur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pis işlərə əlləri zirək olur,","poem":1},{"lineBreak":true},{"text":"Rəislər, hakimlər rüşvət tələb edir,","poem":1},{"lineBreak":true},{"text":"Dövlətlilər istədiklərini edir,","poem":1},{"lineBreak":true},{"text":"Hamısı hiylə ilə iş görür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bunların ən yaxşısı tikandan dəyərsizdir,","poem":1},{"lineBreak":true},{"text":"Ən salehi də alaq otundan pisdir.","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərin xəbərdarlıq etdiyi kimi","poem":1},{"lineBreak":true},{"text":"Cəza günü gəldi.","poem":1},{"lineBreak":true},{"text":"İndi siz çaşbaş qalmısınız.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qonşunuza inanmayın,","poem":1},{"lineBreak":true},{"text":"Dostunuza bel bağlamayın,","poem":1},{"lineBreak":true},{"text":"Hətta qoynunuzda yatan arvadınızdan belə,","poem":1},{"lineBreak":true},{"text":"Ağzınızı möhkəm saxlayın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki oğul atasına xor baxır,","poem":1},{"lineBreak":true},{"text":"Qız anasına, gəlin də qayınanasına qarşı qalxır.","poem":1},{"lineBreak":true},{"text":"İnsanın düşməni öz ev əhli olub.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən isə Rəbbə baxacağam,","poem":1},{"lineBreak":true},{"text":"Məni xilas edən Allahı gözləyəcəyəm.","poem":1},{"lineBreak":true},{"text":"O məni xilas edəcək,","poem":1},{"lineBreak":true},{"text":"Allahım məni eşidəcək.","poem":1}]},{"type":"heading","content":["Qurtuluş yolu"]},{"type":"verse","number":8,"content":[{"text":"Halıma sevinmə, ey düşmənim!","poem":1},{"lineBreak":true},{"text":"Mən yıxılsam da, qalxacağam.","poem":1},{"lineBreak":true},{"text":"Qaranlıqda olsam da,","poem":1},{"lineBreak":true},{"text":"Rəbb mənim nurum olacaq!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mənə bəraət qazandırıb","poem":1},{"lineBreak":true},{"text":"Hökmünü icra edənə qədər","poem":1},{"lineBreak":true},{"text":"Rəbbin qəzəbinə dözəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki Ona qarşı günah işlətdim.","poem":1},{"lineBreak":true},{"text":"O sonra məni işığa çıxaracaq,","poem":1},{"lineBreak":true},{"text":"Onun salehliyini görəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Düşmənim bunu görüb xəcalət çəkəcək.","poem":1},{"lineBreak":true},{"text":"O mənə demişdi:","poem":1},{"lineBreak":true},{"text":"«Allahın Rəbb haradadır?»","poem":1},{"lineBreak":true},{"text":"Bu düşmənin məğlubiyyətini görəcəyəm,","poem":1},{"lineBreak":true},{"text":"O, küçələrdə palçıq kimi tapdalanacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ey Yerusəlim, divarlarının bərpa günü yaxınlaşır,","poem":1},{"lineBreak":true},{"text":"O gün sərhədlərin genişlənəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O gün xalqın Aşşurdan,","poem":1},{"lineBreak":true},{"text":"Misir şəhərlərindən,","poem":1},{"lineBreak":true},{"text":"Misirdən Fərat çayına qədər uzanan torpaqlardan,","poem":1},{"lineBreak":true},{"text":"Dənizdən dənizədək, dağdan dağadək,","poem":1},{"lineBreak":true},{"text":"Sənin yanına qayıdacaq.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lakin sakinlərinin əməllərinə görə","poem":1},{"lineBreak":true},{"text":"Yer üzü viran olacaq.","poem":1}]},{"type":"heading","content":["Rəbbin İsrailə məhəbbəti"]},{"type":"verse","number":14,"content":[{"text":"Ya Rəbb, mirasın olan sürünü –","poem":1},{"lineBreak":true},{"text":"Öz xalqını çomağınla otar.","poem":1},{"lineBreak":true},{"text":"O, çöldə indi tənha qalır,","poem":1},{"lineBreak":true},{"text":"Ətrafında isə yaxşı otlaq var.","poem":1},{"lineBreak":true},{"text":"Qoy keçmiş günlərdəki kimi","poem":1},{"lineBreak":true},{"text":"Başan və Gileadda otlasınlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Misirdən çıxdığın günlərdəki kimi","poem":1},{"lineBreak":true},{"text":"Sizə möcüzələr göstərəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Millətlər bunu görəcək,","poem":1},{"lineBreak":true},{"text":"Öz qüvvətlərinə görə utanacaq.","poem":1},{"lineBreak":true},{"text":"Əlləri ilə ağızlarını yumacaq,","poem":1},{"lineBreak":true},{"text":"Qulaqları kar olacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"İlan kimi torpağı yalayacaq,","poem":1},{"lineBreak":true},{"text":"Əsə-əsə yuvalarından sürünənlər kimi çıxacaq.","poem":1},{"lineBreak":true},{"text":"Ey Allahımız Rəbb, onlar Səndən qorxub","poem":1},{"lineBreak":true},{"text":"Dəhşət içində Sənə tərəf dönəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sağ qalan xalqının cəzasını aradan götürən,","poem":1},{"lineBreak":true},{"text":"Üsyankarlığını bağışlayan","poem":1},{"lineBreak":true},{"text":"Sənin kimi Allah varmı?","poem":1},{"lineBreak":true},{"text":"Qəzəbini əbədi saxlamazsan,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbət göstərməyi xoşlayırsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yenə bizə rəhm edib şər əməllərimizi siləcəksən,","poem":1},{"lineBreak":true},{"text":"Bütün günahlarımızı","poem":1},{"lineBreak":true},{"text":"Dənizin dərinliklərinə atacaqsan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qədim zamanda atalarımıza and içdiyin kimi","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinə sədaqətini,","poem":1},{"lineBreak":true},{"text":"İbrahim övladlarına məhəbbətini göstərəcəksən.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}