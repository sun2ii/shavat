{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"NAM","translationId":"azb_bsa","name":"NAHUM","commonName":"NAHUM","title":"NAHUM PEYĞƏMBƏRİN KİTABI","order":34,"numberOfChapters":3,"sha256":"9866e2c07425cc20ef4d23639d3d886448306c9daff7781ac94b8ddbc4056998","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bu, Nineva haqqındakı xəbərdarlıq, Elqoşlu Nahumun görüntülərindən ibarət kitabdır."]},{"type":"heading","content":["Rəbbin Ninevadan aldığı qisas"]},{"type":"verse","number":2,"content":[{"text":"Rəbb qısqancdır, qisas alan Allahdır,","poem":1},{"lineBreak":true},{"text":"İntiqam alır, qəzəblə doludur,","poem":1},{"lineBreak":true},{"text":"Düşmənlərindən qisas alır,","poem":1},{"lineBreak":true},{"text":"Yağılarına qarşı qəzəblidir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb hədsiz səbirlidir, qüdrətlidir,","poem":1},{"lineBreak":true},{"text":"Təqsirkarı əsla cəzasız qoymaz,","poem":1},{"lineBreak":true},{"text":"Onun yolu qasırğadadır, fırtınadadır,","poem":1},{"lineBreak":true},{"text":"Buludlar ayaqlarının tozudur,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dənizə əmr edib onu qurudar,","poem":1},{"lineBreak":true},{"text":"Bütün çayların sularını da qurudar,","poem":1},{"lineBreak":true},{"text":"Başan və Karmel meşələri saralır,","poem":1},{"lineBreak":true},{"text":"Livanın gül-çiçəyi solur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbin hüzurundan dağlar titrəyir,","poem":1},{"lineBreak":true},{"text":"Təpələr əriyir,","poem":1},{"lineBreak":true},{"text":"Yer üzü Rəbbin önündə sarsılır,","poem":1},{"lineBreak":true},{"text":"Dünya və onun sakinləri lərzəyə gəlir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onun qəzəbinə qarşı kim dura bilər?","poem":1},{"lineBreak":true},{"text":"Qızğın hiddətinə kim tab gətirər?","poem":1},{"lineBreak":true},{"text":"Rəbbin qeyzi od kimi tökülər,","poem":1},{"lineBreak":true},{"text":"Qarşısında qayalar dağılar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb xeyirxahdır, dar gündə sığınacaqdır,","poem":1},{"lineBreak":true},{"text":"Ona güvənənləri tanıyır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lakin O, Ninevanın olduğu yeri","poem":1},{"lineBreak":true},{"text":"Azğın sellərlə məhv edəcək.","poem":1},{"lineBreak":true},{"text":"Düşmənlərini zülmətə salacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbbə qarşı nə qəsd etsələr,","poem":1},{"lineBreak":true},{"text":"O hər şeyə son qoyacaq,","poem":1},{"lineBreak":true},{"text":"Onlardan bir daha bəla çıxmaz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tikanlar kimi bir-birinə dolaşmışlar,","poem":1},{"lineBreak":true},{"text":"Əyyaşlar kimi sərxoş olmuşlar,","poem":1},{"lineBreak":true},{"text":"Quru küləş tək tamamilə yanacaqlar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey Nineva, Rəbbə qarşı pislik düşünən","poem":1},{"lineBreak":true},{"text":"Şər məsləhətçini sən yetirdin!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Aşşurlular çox və güclü olsa da,","poem":1},{"lineBreak":true},{"text":"Yenə məhv olub gedəcək.","poem":1},{"lineBreak":true},{"text":"Ey xalqım İsrail, sənə çox əzab vermişəm,","poem":1},{"lineBreak":true},{"text":"Səni bir daha incitmərəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"İndi boyunduruğunu parçalayıb,","poem":1},{"lineBreak":true},{"text":"Qandallarını qıracağam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ey Nineva, Rəbb sənin haqqında","poem":1},{"lineBreak":true},{"text":"Belə əmr verib:","poem":1},{"lineBreak":true},{"text":"«Artıq övladların olmayacaq, adını daşımayacaq,","poem":1},{"lineBreak":true},{"text":"Allahlarının məbədindən","poem":1},{"lineBreak":true},{"text":"Oyma bütləri, tökmə bütləri məhv edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Qəbir qazacağam sənə, çünki alçaqsan!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Budur, müjdə gətirənin","poem":1},{"lineBreak":true},{"text":"Ayaqları dağlar aşır, gəlir,","poem":1},{"lineBreak":true},{"text":"Sülh xəbəri gətirir.","poem":1},{"lineBreak":true},{"text":"Ey Yəhuda, bayramlarını keçir,","poem":1},{"lineBreak":true},{"text":"Əhdlərini yerinə yetir!","poem":1},{"lineBreak":true},{"text":"O pis millətin ayağı ölkəndən artıq keçməyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki tamamilə məhv oldu».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}