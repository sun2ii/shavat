{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"NAM","translationId":"azb_bsa","name":"NAHUM","commonName":"NAHUM","title":"NAHUM PEYĞƏMBƏRİN KİTABI","order":34,"numberOfChapters":3,"sha256":"9866e2c07425cc20ef4d23639d3d886448306c9daff7781ac94b8ddbc4056998","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ninevanın dağılması"]},{"type":"verse","number":1,"content":[{"text":"Ey Nineva, həlak edən qüvvə qarşına çıxdı,","poem":1},{"lineBreak":true},{"text":"İstehkamını qoru, yolunu qoru,","poem":1},{"lineBreak":true},{"text":"Belini möhkəm qurşa,","poem":1},{"lineBreak":true},{"text":"Bütün gücünü topla!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rəbb Yaqub nəslini","poem":1},{"lineBreak":true},{"text":"İsrailin əvvəlki əzəmətinə qaytaracaq.","poem":1},{"lineBreak":true},{"text":"Hərçənd quldurlar onu viran etdi,","poem":1},{"lineBreak":true},{"text":"Tənəklərini dağıtdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İgidlərin qalxanları qıpqırmızıdır,","poem":1},{"lineBreak":true},{"text":"Cəngavərlərin libasları al rəngdədir.","poem":1},{"lineBreak":true},{"text":"Onlar hazır olan gün","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarının dəmirləri necə də parıldayır,","poem":1},{"lineBreak":true},{"text":"Şam ağacından nizələr havada oynayır!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Döyüş arabaları küçələrdən dəlicəsinə qaçır,","poem":1},{"lineBreak":true},{"text":"Meydanlarda ora-bura yüyürür,","poem":1},{"lineBreak":true},{"text":"Məşəllər kimi parıldayır,","poem":1},{"lineBreak":true},{"text":"Şimşək kimi cəld qaçır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nineva padşahı seçmə əsgərlərini toplayır,","poem":1},{"lineBreak":true},{"text":"Amma onlar yolda büdrəyir.","poem":1},{"lineBreak":true},{"text":"Düşmən orduları şəhər divarına tərəf qaçır,","poem":1},{"lineBreak":true},{"text":"Qalxanlarını qaldırıb sipər qurur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çayların suyunu saxlayan bəndlər açıldı,","poem":1},{"lineBreak":true},{"text":"Sarayı dəhşət bürüdü.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mələkəni lüt-üryan aparırlar,","poem":1},{"lineBreak":true},{"text":"Kənizləri qumru kimi inləyib","poem":1},{"lineBreak":true},{"text":"Sinələrinə vurur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qədimdən bəri Nineva","poem":1},{"lineBreak":true},{"text":"Sulu hovuz kimi idi,","poem":1},{"lineBreak":true},{"text":"İndi isə sular axıb gedir,","poem":1},{"lineBreak":true},{"text":"Onlara «Dayanın, dayanın!» deyirlər,","poem":1},{"lineBreak":true},{"text":"Amma geri dönən yoxdur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gümüşü talan edin, qızılı oğurlayın,","poem":1},{"lineBreak":true},{"text":"Sərvətlərin sonu yoxdur,","poem":1},{"lineBreak":true},{"text":"Bol miqdarda qiymətli əşyalar var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nineva viran oldu, dağıldı, xaraba qaldı!","poem":1},{"lineBreak":true},{"text":"Sakinlərinin ürəyi əsir, dizləri taqətdən düşür.","poem":1},{"lineBreak":true},{"text":"Hamının bədənləri titrəyir, üzləri solur!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nə oldu aslanlar yuvasına?","poem":1},{"lineBreak":true},{"text":"Gənc aslanların bəsləndiyi,","poem":1},{"lineBreak":true},{"text":"Şirlə dişisinin və balalarının qorxusuz gəzdiyi yerə nə oldu?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aslan öz balalarına kifayət qədər şikar ovladı,","poem":1},{"lineBreak":true},{"text":"Dişisi üçün ovunu boğazladı,","poem":1},{"lineBreak":true},{"text":"Mağarasını ovladığı heyvanlarla,","poem":1},{"lineBreak":true},{"text":"Yuvasını şikarla doldurdu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ordular Rəbbi bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Mən sizin əleyhinizəyəm,","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarınızı tüstüdə yandıracağam,","poem":1},{"lineBreak":true},{"text":"Gənc aslanlarını qılınc yeyəcək,","poem":1},{"lineBreak":true},{"text":"Yer üzündən şikarını kəsəcəyəm,","poem":1},{"lineBreak":true},{"text":"Qasidlərinin səsi daha eşidilməyəcək».","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}