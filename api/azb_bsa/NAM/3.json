{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"NAM","translationId":"azb_bsa","name":"NAHUM","commonName":"NAHUM","title":"NAHUM PEYĞƏMBƏRİN KİTABI","order":34,"numberOfChapters":3,"sha256":"9866e2c07425cc20ef4d23639d3d886448306c9daff7781ac94b8ddbc4056998","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Qanlı şəhərin vay halına!","poem":1},{"lineBreak":true},{"text":"O yalan və soyğunçuluqla doludur,","poem":1},{"lineBreak":true},{"text":"Orada quldurluğun ardı kəsilmir!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qamçı səsi, təkərlər gurultusu,","poem":1},{"lineBreak":true},{"text":"Çapan atların, yırğalanan döyüş arabalarının sədası!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Süvarilər hücum edir, qılınclar parıldayır,","poem":1},{"lineBreak":true},{"text":"Nizələr bərq vurur, ölənlər yığın-yığın,","poem":1},{"lineBreak":true},{"text":"Cəsədlərin sayı yox,","poem":1},{"lineBreak":true},{"text":"İnsanların ayağı meyitlərə dolaşır!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Millətləri fahişəliyi ilə,","poem":1},{"lineBreak":true},{"text":"Xalqları cadugərliyi ilə satan, cazibəli,","poem":1},{"lineBreak":true},{"text":"Cadugərlikdə mahir fahişə – Ninevanın","poem":1},{"lineBreak":true},{"text":"Hədsiz əxlaqsızlığına görə","poem":1},{"lineBreak":true},{"text":"Bunlar baş verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ordular Rəbbi bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Ey Nineva, Mən sənin əleyhinəyəm!","poem":1},{"lineBreak":true},{"text":"Paltarının ətəyini üzünə qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Çılpaqlığını millətlərə göstərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ayıbını ölkələrə açacağam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Üstünə iyrənc şeyləri atacağam,","poem":1},{"lineBreak":true},{"text":"Səni rüsvay edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Tamaşaya qoyacağam!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Səni görənlərin hamısı səndən qaçıb","poem":1},{"lineBreak":true},{"text":"Belə deyəcək:","poem":1},{"lineBreak":true},{"text":"“Nineva viran qaldı!","poem":1},{"lineBreak":true},{"text":"Onun üçün kim ağlayacaq?”","poem":1},{"lineBreak":true},{"text":"Haradan sənə təsəlli verənləri tapım?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Axı sənin No-Ammondan","poem":1},{"noteId":0},{"text":"nəyin artıqdır?","poem":1},{"lineBreak":true},{"text":"O şəhər çaylar arasında yerləşib","poem":1},{"lineBreak":true},{"text":"Sularla əhatə olunmuşdu,","poem":1},{"lineBreak":true},{"text":"Sipəri dəniz,","poem":1},{"lineBreak":true},{"text":"Qala divarı isə Nil çayı idi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuş və Misir onun sonsuz qüvvəti idi,","poem":1},{"lineBreak":true},{"text":"Put və Liviya da köməkçiləri idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lakin əsir aparıldı, sürgün oldu,","poem":1},{"lineBreak":true},{"text":"Övladları parça-parça doğrandı,","poem":1},{"lineBreak":true},{"text":"Hər küçə başına atıldı,","poem":1},{"lineBreak":true},{"text":"Adlı-sanlı adamları üçün püşk atdılar,","poem":1},{"lineBreak":true},{"text":"Əyanlarını qandallara saldılar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sən də, ey Nineva, sərxoş olacaqsan,","poem":1},{"lineBreak":true},{"text":"Mat-məəttəl qalacaqsan,","poem":1},{"lineBreak":true},{"text":"Düşmənlərin əlindən pənahgah axtaracaqsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bütün istehkamların","poem":1},{"lineBreak":true},{"text":"Əncir ağacının ilk yetişən meyvələri kimidir,","poem":1},{"lineBreak":true},{"text":"Silkələnəndə yeyənin ağzına düşür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Budur, əsgərlərin qadın kimidir,","poem":1},{"lineBreak":true},{"text":"Ölkənin darvazaları düşmənlərin üzünə taybatay açılıb.","poem":1},{"lineBreak":true},{"text":"Qapı rəzələrini od yeyib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mühasirə vaxtı üçün özünə su çək,","poem":1},{"lineBreak":true},{"text":"Qalalarını möhkəmləndir,","poem":1},{"lineBreak":true},{"text":"Çamıra gir, palçığı tapda,","poem":1},{"lineBreak":true},{"text":"Kərpic kəsmək üçün qəlib götür!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Orada od səni yeyib-qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Qılınc səni kəsib-qıracaq,","poem":1},{"lineBreak":true},{"text":"Çəyirtkələrin yedikləri əkin kimi yox olacaqsan.","poem":1},{"lineBreak":true},{"text":"Sayını çəyirtkə kimi artır,","poem":1},{"lineBreak":true},{"text":"Özünü qaynaşan çəyirtkə kimi çoxalt!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tacirlərinin sayı","poem":1},{"lineBreak":true},{"text":"Göylərdəki ulduzlardan çoxdur,","poem":1},{"lineBreak":true},{"text":"Amma düşmənlərin","poem":1},{"lineBreak":true},{"text":"Çəyirtkə kimi ölkəni talan edib uçacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gözətçilərin çəyirtkə kimi,","poem":1},{"lineBreak":true},{"text":"Məmurların çəyirtkə sürüsü kimidir –","poem":1},{"lineBreak":true},{"text":"Soyuq gündə çəpərlərə yerləşir,","poem":1},{"lineBreak":true},{"text":"Gün doğanda uçub gedir,","poem":1},{"lineBreak":true},{"text":"Getdikləri yer bilinmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ey Aşşur padşahı,","poem":1},{"lineBreak":true},{"text":"Əyanların ölüm yuxusuna gedib,","poem":1},{"lineBreak":true},{"text":"Adlı-sanlı adamların yatıb.","poem":1},{"lineBreak":true},{"text":"Xalqın dağlara səpələnib,","poem":1},{"lineBreak":true},{"text":"Onları bir yerə yığan yoxdur.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dərdinə dərman yoxdur, yaraların sağalmaz.","poem":1},{"lineBreak":true},{"text":"Barəndə xəbər eşidənlər sevinib əl çalır.","poem":1},{"lineBreak":true},{"text":"Axı sənin bu sonsuz pisliyin kimə dəyməyib?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"No-Ammon – qədim Misirin paytaxt şəhərlərindən biri.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/azb_bsa/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}