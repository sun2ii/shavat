{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"NUM","translationId":"azb_bsa","name":"SAYLAR","commonName":"SAYLAR","title":"SAYLAR KİTABI","order":4,"numberOfChapters":36,"sha256":"fd32bfbd0e9ce9c9c1a1701a9d9f8ba4a820bb6d33ed6dbe45a1307497c05263","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/azb_bsa/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Bilam Rəbbin gözündə İsrailə xeyir-dua verməyin yaxşı olduğunu gördükdə əvvəlki kimi baxıcılıq etmədi, amma üzünü səhraya doğru çevirdi."]},{"type":"verse","number":2,"content":["Bilam gözlərini qaldırdı və İsraili qəbilələrinə görə yerləşmiş görəndə onun üzərinə Allahın Ruhu endi."]},{"type":"verse","number":3,"content":["O, gələcəkdən xəbər verib dedi:",{"text":"«Budur, Beor oğlu Bilamın kəlamı,","poem":1},{"lineBreak":true},{"text":"Uzaq görən adamın kəlamı,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Allahın sözlərini eşidən,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın görüntüsünü görən,","poem":1},{"lineBreak":true},{"text":"Gözləri açıq, yerə sərilən adamın kəlamı:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Ey Yaqub, sənin çadırların,","poem":1},{"lineBreak":true},{"text":"Ey İsrail, məskənlərin nə gözəldir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yayılırlar vadilər tək,","poem":1},{"lineBreak":true},{"text":"Çay kənarındakı bağ-bağçalar tək,","poem":1},{"lineBreak":true},{"text":"Rəbbin bitirdiyi əzvay ağacları tək,","poem":1},{"lineBreak":true},{"text":"Çay kənarındakı sidr ağacları tək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Satıllarından sular axacaq,","poem":1},{"lineBreak":true},{"text":"Toxumları bol su ilə sulanacaq,","poem":1},{"lineBreak":true},{"text":"Padşahları Aqaqdan böyük olacaq,","poem":1},{"lineBreak":true},{"text":"Padşahlıqları ucalacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Allah onları Misirdən çıxartdı;","poem":1},{"lineBreak":true},{"text":"Onların çöl öküzü kimi qüvvəti var.","poem":1},{"lineBreak":true},{"text":"Onlar düşmən millətləri yeyib qurtaracaq.","poem":1},{"lineBreak":true},{"text":"Sümüklərini qıracaq,","poem":1},{"lineBreak":true},{"text":"Oxları ilə onları dələcək.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar pusub şir kimi yatar,","poem":1},{"lineBreak":true},{"text":"Dişi aslana oxşar.","poem":1},{"lineBreak":true},{"text":"Onları oyandırmağa kim cürət edər?","poem":1},{"lineBreak":true},{"text":"Sizə xeyir-dua verən xeyir-dualı olsun,","poem":1},{"lineBreak":true},{"text":"Sizə lənət oxuyan qoy lənətli olsun!”»","poem":1}]},{"type":"verse","number":10,"content":["Bilama qarşı Balaqın qəzəbi alovlandı. Balaq əllərini bir-birinə vurdu və Bilama dedi: «Səni düşmənlərimə lənət etmək üçün çağırdım və budur, üçüncü dəfədir ki, onlara ancaq xeyir-dua verirsən."]},{"type":"verse","number":11,"content":["İndi tez get, yerinə qayıt. Demişdim ki, səni çox mükafatlandıracağam, amma Rəbb səni mükafatdan məhrum etdi»."]},{"type":"verse","number":12,"content":["Bilam Balaqa dedi: «Yanıma göndərdiyin qasidlərə demədimmi,"]},{"type":"verse","number":13,"content":["Balaq mənə qızıl və gümüşlə dolu evini versə belə, Rəbbin sözündən bilə-bilə yan keçib yaxşılıq yaxud pislik edə bilmərəm. Rəbb nə desə, onu deyəcəyəm."]},{"type":"verse","number":14,"content":["İndi mən xalqımın yanına qayıdıram. Qoy mən bu xalqın gələcəkdə sənin xalqının başına nə gətirəcəyini bildirim»."]},{"type":"heading","content":["Bilamın dördüncü dəfə gələcəkdən xəbər verməsi"]},{"type":"verse","number":15,"content":["Sonra Bilam gələcəkdən xəbər verib dedi:",{"text":"«Budur, Beor oğlu Bilamın kəlamı,","poem":1},{"lineBreak":true},{"text":"Uzaq görən adamın kəlamı,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Allahın sözlərini eşidən,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanın biliyinə qovuşan,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın görüntüsünü görən,","poem":1},{"lineBreak":true},{"text":"Gözləri açıq, yerə sərilən adamın kəlamı:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“Onu mən görürəm, amma indi deyil,","poem":1},{"lineBreak":true},{"text":"Mən ona baxıram, amma yaxından deyil.","poem":1},{"lineBreak":true},{"text":"Yaqubdan bir ulduz çıxacaq,","poem":1},{"lineBreak":true},{"text":"İsraildən bir Əsa","poem":1},{"noteId":6},{"text":"ucalacaq,","poem":1},{"lineBreak":true},{"text":"Moavlıların alınlarını,","poem":1},{"lineBreak":true},{"text":"Şet övladlarının başlarını əzəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onun düşməni Edomla Seir təslim olacaq,","poem":1},{"lineBreak":true},{"text":"İsrail isə get-gedə güclənəcək.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaqubun nəslindən olan o adam","poem":1},{"lineBreak":true},{"text":"Səltənət sürəcək,","poem":1},{"lineBreak":true},{"text":"Şəhərdə sağ qalanları məhv edəcək”».","poem":1}]},{"type":"heading","content":["Bilamın sonuncu dəfə gələcəkdən xəbər verməsi"]},{"type":"verse","number":20,"content":["Bilam Amaleqliləri görəndə gələcəkdən xəbər verib belə dedi:",{"text":"«Amaleq millətlərin birincisi idi,","poem":1},{"lineBreak":true},{"text":"Ancaq axırda məhv olacaq».","poem":1}]},{"type":"verse","number":21,"content":["Qenliləri görəndə gələcəkdən xəbər verib belə dedi:",{"text":"«Məskəniniz möhkəm,","poem":1},{"lineBreak":true},{"text":"Yuvanız qayada qurulub.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amma, ey Qenlilər, Aşşurlular sizi əsir alanda","poem":1},{"lineBreak":true},{"text":"Yanıb yox olacaqsınız».","poem":1}]},{"type":"verse","number":23,"content":["Bilam gələcəkdən xəbər verməyə belə davam etdi:",{"text":"«Vay, Allah bunu etdiyi zaman kim yaşaya biləcək?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kittim sahillərindən gəmilər gələcək,","poem":1},{"lineBreak":true},{"text":"Aşşur ilə Everi ram edəcək,","poem":1},{"lineBreak":true},{"text":"Amma onlar da məhv olacaq».","poem":1}]},{"type":"verse","number":25,"content":["Bundan sonra Bilam yola çıxıb evinə qayıtdı. Balaq da öz yoluna davam etdi."]}],"footnotes":[{"noteId":6,"caller":"+","text":"Əsa – burada başçı mənasında işlənir.","reference":{"chapter":24,"verse":17}}]},"thisChapterLink":"/api/azb_bsa/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}