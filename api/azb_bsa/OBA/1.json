{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"OBA","translationId":"azb_bsa","name":"AVDİYA","commonName":"AVDİYA","title":"AVDİYA PEYĞƏMBƏRİN KİTABI","order":31,"numberOfChapters":1,"sha256":"0859032d72e849c72a401d93aafe415d41cf16d3cec5c526e1a30dac61f6c186","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/azb_bsa/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bu, Avdiyaya zühur olan görüntüdür. Edom üzərində Allahın məhkəməsi",{"text":"Xudavənd Rəbb Edom barəsində belə deyir:","poem":1},{"lineBreak":true},{"text":"Biz Rəbdən xəbər eşitdik,","poem":1},{"lineBreak":true},{"text":"Millətlər arasına","poem":1},{"lineBreak":true},{"text":"«Qalxın, Edoma qarşı döyüşək!» deyən qasid göndərildi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Bax səni millətlər arasında kiçildəcəyəm,","poem":1},{"lineBreak":true},{"text":"Hamı sənə xor baxacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey sən qaya","poem":1},{"noteId":0},{"text":"çatlarında məskən salan,","poem":1},{"lineBreak":true},{"text":"Evini yüksəklərdə quran!","poem":1},{"lineBreak":true},{"text":"Ürəyinin qüruru səni aldatdı,","poem":1},{"lineBreak":true},{"text":"Çünki sən qəlbində “Məni kim yerə yıxa bilər?” dedin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sən qartal kimi yuxarı uçub","poem":1},{"lineBreak":true},{"text":"Yuvanı ulduzlar arasında qursan da,","poem":1},{"lineBreak":true},{"text":"Səni oradan endirəcəyəm».","poem":1},{"lineBreak":true},{"text":"Rəbb bəyan edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Əgər gecə yanına oğrular, quldurlar gəlsəydi,","poem":1},{"lineBreak":true},{"text":"Ancaq öz istədikləri qədər oğurlamazdılarmı?","poem":1},{"lineBreak":true},{"text":"Əgər üzüm yığanlar sənin bağına gəlsəydi,","poem":1},{"lineBreak":true},{"text":"Bir neçə salxımı saxlamazdılarmı?","poem":1},{"lineBreak":true},{"text":"Amma gör səni nə cür müsibətlər gözləyir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Esavın hər şeyi talan ediləcək,","poem":1},{"lineBreak":true},{"text":"Gizli xəzinələri aşkara çıxarılacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Səninlə əhd bağlayanların hamısı","poem":1},{"lineBreak":true},{"text":"Səni ölkəndən qovacaq,","poem":1},{"lineBreak":true},{"text":"Müttəfiqlərin səni aldadıb məğlub edəcək.","poem":1},{"lineBreak":true},{"text":"Səninlə çörək yeyənlər sənə tələ quracaq,","poem":1},{"lineBreak":true},{"text":"“Onun ağlı haradadır?” deyəcək».","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«O gün Edomun hikmətli adamlarını,","poem":1},{"lineBreak":true},{"text":"Esav dağındakı müdrikləri məhv edəcəyəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Teman,","poem":1},{"noteId":1},{"text":"igid adamların elə qorxuya düşəcək ki,","poem":1},{"lineBreak":true},{"text":"Esav dağlarının hər sakini qırğında öldürüləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qardaşın Yaquba etdiyin zorakılığa görə","poem":1},{"lineBreak":true},{"text":"Sən xəcalət içində qalacaqsan,","poem":1},{"lineBreak":true},{"text":"Əbədi məhv olacaqsan.","poem":1},{"noteId":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yadellilər onun sərvətini aparanda","poem":1},{"lineBreak":true},{"text":"Sən uzaqda durub tamaşa etdin.","poem":1},{"lineBreak":true},{"text":"Əcnəbilər onun şəhər darvazalarından girib","poem":1},{"lineBreak":true},{"text":"Yerusəlim üçün püşk atanda","poem":1},{"lineBreak":true},{"text":"Sən də onlardan biri kimi davrandın.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sən gərək Yəhudalı soydaşlarının","poem":1},{"lineBreak":true},{"text":"Bədbəxtlik günündən zövq almayaydın,","poem":1},{"lineBreak":true},{"text":"Həlak olduqları gün sevinməyəydin,","poem":1},{"lineBreak":true},{"text":"O əzablı gündə rişxənd etməyəydin,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xalqımın fəlakətli günündə","poem":1},{"lineBreak":true},{"text":"Onların şəhər darvazalarından girməyəydin,","poem":1},{"lineBreak":true},{"text":"Başlarına bəla gələn gün","poem":1},{"lineBreak":true},{"text":"Onların fəlakətini sevinclə seyr etməyəydin,","poem":1},{"lineBreak":true},{"text":"Başlarına bəla gələn gün","poem":1},{"lineBreak":true},{"text":"Onların malına əl uzatmayaydın!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən gərək qaçan Yəhuda övladlarını öldürmək üçün","poem":1},{"lineBreak":true},{"text":"Yol ayrıcında dayanmayaydın,","poem":1},{"lineBreak":true},{"text":"O əzablı gün qurtulanları","poem":1},{"lineBreak":true},{"text":"Düşmənə təslim etməyəydin!","poem":1}]},{"type":"heading","content":["Rəbbin günü yaxınlaşır"]},{"type":"verse","number":15,"content":[{"text":"Axı bütün millətlər üçün Rəbbin günü yaxınlaşır,","poem":1},{"lineBreak":true},{"text":"Ey Edom, sən nə cür etdinsə, sənə də belə ediləcək,","poem":1},{"lineBreak":true},{"text":"Əməllərinin əvəzi öz başına gələcək!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çünki siz Mənim müqəddəs dağımda içdiyiniz kimi","poem":1},{"lineBreak":true},{"text":"Bütün xalqlar durmadan içəcək,","poem":1},{"lineBreak":true},{"text":"İçib yox olacaq,","poem":1},{"lineBreak":true},{"text":"Sanki əvvəldən yox idi.","poem":1}]},{"type":"heading","content":["İsrailin zəfəri"]},{"type":"verse","number":17,"content":[{"text":"Lakin qurtuluş tapanlar","poem":1},{"lineBreak":true},{"text":"Sion dağına toplanacaq,","poem":1},{"lineBreak":true},{"text":"O dağ müqəddəs olacaq.","poem":1},{"lineBreak":true},{"text":"Yaqub nəsli mülkünə sahib olacaq!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaqub nəsli od,","poem":1},{"lineBreak":true},{"text":"Yusif nəsli alov,","poem":1},{"lineBreak":true},{"text":"Esav nəsli isə küləş olacaq,","poem":1},{"lineBreak":true},{"text":"Yaqub və Yusif nəsli","poem":1},{"lineBreak":true},{"text":"Esav nəslini yandırıb məhv edəcək.","poem":1},{"lineBreak":true},{"text":"Esav nəslindən qurtulan olmayacaq.","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb belə söylədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Negev sakinləri Esav dağını,","poem":1},{"lineBreak":true},{"text":"Yamaclı-düzənlikli bölgədə yaşayanlar Filiştlilərin bölgəsini,","poem":1},{"lineBreak":true},{"text":"Yəhudalılar Efrayimlə Samariya torpaqlarını,","poem":1},{"lineBreak":true},{"text":"Binyaminlilər isə Gileadı zəbt edəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xalahda olan İsrail sürgünləri","poem":1},{"lineBreak":true},{"text":"Kənanın Sarfata qədər uzanan torpaqlarını,","poem":1},{"lineBreak":true},{"text":"Sefaradda olan Yerusəlim sürgünləri","poem":1},{"lineBreak":true},{"text":"Negev şəhərlərini zəbt edəcək.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xalqı qurtaranlar Sion dağına çıxıb","poem":1},{"lineBreak":true},{"text":"Esav dağına hökm edəcək:","poem":1},{"lineBreak":true},{"text":"Rəbb səltənət sürəcək».","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Qaya – ibrani mətnində sela kimi səslənir. Sela Edomun paytaxtının adı idi.","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"Teman – Edomun şəhərlərindən biri.","reference":{"chapter":1,"verse":9}},{"noteId":2,"caller":"+","text":"Yaqubla Esav doğma qardaş idi. Yaqub İsraillilərin əcdadı idi. Esav Edomluların əcdadı idi.","reference":{"chapter":1,"verse":10}}]},"thisChapterLink":"/api/azb_bsa/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}