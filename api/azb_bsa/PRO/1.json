{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["İsrail padşahı Davud oğlu Süleymanın məsəlləri:"]},{"type":"heading","content":["Hikmət mənbəyi"]},{"type":"verse","number":2,"content":[{"text":"Hikmət və tərbiyəyə malik olmaq,","poem":1},{"lineBreak":true},{"text":"Müdrik sözləri dərk etmək üçün,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Salehlik, ədalət, insaf barədə","poem":1},{"lineBreak":true},{"text":"İdrak tərbiyəsi almaq üçün,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cahillərə uzaqgörənlik,","poem":1},{"lineBreak":true},{"text":"Gənc oğlana bilik və dərrakə vermək üçün;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qoy hikmətli qulaq asıb müdrikliyini artırsın,","poem":1},{"lineBreak":true},{"text":"Dərrakəli adam sağlam məsləhət alsın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu yolla insanlar məsəl və kinayələri,","poem":1},{"lineBreak":true},{"text":"Hikmətlilərin sözlərini və müəmmalarını anlasınlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb qorxusu biliyin başlanğıcıdır,","poem":1},{"lineBreak":true},{"text":"Amma səfehlər hikmət və tərbiyəyə xor baxar.","poem":1}]},{"type":"heading","content":["Günahkarlardan uzaq durmaq"]},{"type":"verse","number":8,"content":[{"text":"Oğlum, ata tərbiyəsinə qulaq as,","poem":1},{"lineBreak":true},{"text":"Ananın öyrətdiklərini kənara atma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar başını gözəl çələng kimi,","poem":1},{"lineBreak":true},{"text":"Boynunu boyunbağı kimi bəzər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Oğlum, qoyma səni günahkarlar azdırsın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Desələr ki: «Gəl bizimlə pusqu qurub qan tökək,","poem":1},{"lineBreak":true},{"text":"Nahaq yerə günahsızları güdək,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gəl onları ölülər diyarı kimi diri-diri udaq,","poem":1},{"lineBreak":true},{"text":"Tamam qəbirə düşənlərə bənzəsinlər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onda çoxlu qiymətli sərvət taparıq,","poem":1},{"lineBreak":true},{"text":"Evlərimizi talan malı ilə doldurarıq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bizə qoşul,","poem":1},{"lineBreak":true},{"text":"Qoy kisəmiz bir olsun»,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Oğlum, onlara qoşulma,","poem":1},{"lineBreak":true},{"text":"Yollarına ayaq basma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çünki onların ayaqları pisliyə tərəf qaçar,","poem":1},{"lineBreak":true},{"text":"Qan tökməyə tələsər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bir quşun gözü önündə","poem":1},{"lineBreak":true},{"text":"Tələ qurmaq faydasızdır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki onların qurduğu pusqu öz qanlarını tökmək üçündür,","poem":1},{"lineBreak":true},{"text":"Güdməkləri öz canları üçündür.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tamahkarın yolu həmişə belədir,","poem":1},{"lineBreak":true},{"text":"Tamahı onun canını alar.","poem":1}]},{"type":"heading","content":["Hikmət çağırır"]},{"type":"verse","number":20,"content":[{"text":"Hikmət bayırda ucadan çağırır,","poem":1},{"lineBreak":true},{"text":"Meydanlarda onun səsi ucalır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O, səsli-küylü küçələrin başında çağırır,","poem":1},{"lineBreak":true},{"text":"Şəhər darvazalarında deyir:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"«Ey cahillər, nə vaxtadək","poem":1},{"lineBreak":true},{"text":"Cəhaləti sevəcəksiniz?","poem":1},{"lineBreak":true},{"text":"Nə vaxtadək rişxəndçilər rişxənddən zövq alacaq,","poem":1},{"lineBreak":true},{"text":"Axmaqların bilikdən zəhləsi gedəcək?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Məzəmmətimdən düzəlsəydiniz,","poem":1},{"lineBreak":true},{"text":"Ruhumu üstünüzə tökərdim,","poem":1},{"lineBreak":true},{"text":"Sözlərimi sizə bildirərdim.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Sizi çağıranda məni rədd etdiniz,","poem":1},{"lineBreak":true},{"text":"Əlimi uzadanda əhəmiyyət vermədiniz.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bütün nəsihətlərimi boş saydınız,","poem":1},{"lineBreak":true},{"text":"Məzəmmətlərimi qəbul etmədiniz.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ona görə də sizin üzərinizə bəla gələndə güləcəyəm,","poem":1},{"lineBreak":true},{"text":"Dəhşət sizi bürüyəndə,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tufan kimi dəhşət sizə hücum çəkəndə,","poem":1},{"lineBreak":true},{"text":"Sizə qasırğa kimi bəla gələndə,","poem":1},{"lineBreak":true},{"text":"Dara, əziyyətə düşəndə istehza edəcəyəm.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"O vaxt məni çağıranlara cavab verməyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Səylə axtarsalar da, məni tapa bilməyəcəklər.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Çünki onlar biliyə nifrət etdilər,","poem":1},{"lineBreak":true},{"text":"Rəbdən qorxmaq istəmədilər,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nəsihətimi istəmədilər,","poem":1},{"lineBreak":true},{"text":"Hər məzəmmətimi rədd etdilər.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Buna görə də öz yollarının bəhrəsini yeyəcəklər,","poem":1},{"lineBreak":true},{"text":"Öz nəsihətləri ilə doyacaqlar.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Cahili özbaşınalığı öldürəcək,","poem":1},{"lineBreak":true},{"text":"Axmağı laqeydliyi məhv edəcək.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mənə qulaq asanlarsa əmin-amanlıqda yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Rahatlıq tapacaq, pislikdən qorxmayacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}