{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["Məsəllər"]},{"type":"verse","number":1,"content":["Süleymanın məsəlləri:",{"text":"Hikmətli oğul atasını sevindirər,","poem":1},{"lineBreak":true},{"text":"Axmaq oğul anasına dərd gətirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Şər yolla yığılan xəzinədən fayda götürmək olmaz,","poem":1},{"lineBreak":true},{"text":"Amma salehlik insanı ölümdən qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbb saleh insanı ac qoymaz,","poem":1},{"lineBreak":true},{"text":"O, acgöz pisləri doydurmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tənbəlin əlləri onu yoxsullaşdırar,","poem":1},{"lineBreak":true},{"text":"Çalışqanın əli sərvət qazanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ağıllı oğul yayda məhsul yığar,","poem":1},{"lineBreak":true},{"text":"Biçin vaxtı yatan oğul rüsvay olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Saleh insanın başından bərəkət yağar,","poem":1},{"lineBreak":true},{"text":"Şər adamın dili zorakılığı gizli saxlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saleh insanın adı xeyir-dua ilə çağırılar,","poem":1},{"lineBreak":true},{"text":"Şər adamın adı isə çürüyər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Qəlbən hikmətli olan əmrləri qəbul edər,","poem":1},{"lineBreak":true},{"text":"Səfeh boşboğazlığı üzündən itib-batar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kamalla gəzib-dolaşan dinc yaşar,","poem":1},{"lineBreak":true},{"text":"Yolu əyri olanlar üzə çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Göz vuran başına bəla açar,","poem":1},{"lineBreak":true},{"text":"Səfeh boşboğazlığı üzündən itib-batar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Salehin ağzı həyat qaynağı olar,","poem":1},{"lineBreak":true},{"text":"Amma şər adamın dili zorakılığı gizli saxlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nifrət nifaq yaradar,","poem":1},{"lineBreak":true},{"text":"Lakin məhəbbət bütün günahları örtər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dərrakəlinin dilindən hikmət tökülər,","poem":1},{"lineBreak":true},{"text":"Qanmaz kürəyindən kötəklənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hikmətli adamlar bilik toplar,","poem":1},{"lineBreak":true},{"text":"Səfehin boşboğazlığı onu bəlaya yaxınlaşdırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zənginin var-dövləti ona qalalı şəhərdir,","poem":1},{"lineBreak":true},{"text":"Kasıbı yoxsulluq bəlaya salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Salehin mükafatı həyatdır,","poem":1},{"lineBreak":true},{"text":"Şər adamınsa qazancı günahdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tərbiyəyə bağlanan həyat yolunda olar,","poem":1},{"lineBreak":true},{"text":"Məzəmməti rədd edən yolunu azar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nifrətini gizlədən yalan danışar,","poem":1},{"lineBreak":true},{"text":"Axmaq hər yana böhtanlar yayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Çox sözlərlə günahı azaltmaq olmaz,","poem":1},{"lineBreak":true},{"text":"Dilini saxlayan ağıllıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Saleh insanın dili saf gümüşə oxşar,","poem":1},{"lineBreak":true},{"text":"Şər adamın qəlbinin dəyəri az olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Saleh öz dili ilə çox adamı doydurar,","poem":1},{"lineBreak":true},{"text":"Səfeh qanmazlığı üzündən həlak olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rəbbin xeyir-duası insana sərvət gətirər,","poem":1},{"lineBreak":true},{"text":"Daha ona qüssə verməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Axmaq üçün şər iş görmək bir əyləncədir,","poem":1},{"lineBreak":true},{"text":"Dərrakəlininsə hikməti var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Şər adam nədən qorxursa, başına gələr,","poem":1},{"lineBreak":true},{"text":"Saleh isə muradına çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Qopan tufan şəri süpürüb aparar,","poem":1},{"lineBreak":true},{"text":"Salehin təməli əbədi qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dişlərə sirkə, gözlərə tüstü necə təsir edirsə,","poem":1},{"lineBreak":true},{"text":"Tənbələ iş buyuran bunu elə hiss edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Rəbb qorxusu ömür uzadar,","poem":1},{"lineBreak":true},{"text":"Şər insanların ömründən illər azalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Salehləri sevinc gözlər,","poem":1},{"lineBreak":true},{"text":"Şər insanların ümidi boşa çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kamilin pənahı Rəbbin yoludur.","poem":1},{"lineBreak":true},{"text":"Şər iş görənin başı bəla ilə doludur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Saleh heç vaxt sarsılmaz,","poem":1},{"lineBreak":true},{"text":"Şər insanlar yer üzündə qalmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Salehin ağzı hikmətlə çiçəklənər,","poem":1},{"lineBreak":true},{"text":"Hiyləli dillər kəsilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Saleh insanın dili razı salmağı bacarar,","poem":1},{"lineBreak":true},{"text":"Şər insanın ağzından hiyləli sözlər çıxar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}