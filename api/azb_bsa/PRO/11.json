{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Aldadıcı tərəzi Rəbdə ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"Rəbb düz çəki daşından razı qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lovğalıq gələndə şərəfsizlik gətirər,","poem":1},{"lineBreak":true},{"text":"Hikmət itaətkarın yanına gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Əməlisalehi kamillik yolu aparar,","poem":1},{"lineBreak":true},{"text":"Xəyanətkar əyriliyindən məhv olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Heç kimi var-dövləti qəzəb günündən xilas etməz,","poem":1},{"lineBreak":true},{"text":"Amma salehlik insanı ölümdən qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kamil insanın yolunu salehliyi düz edər,","poem":1},{"lineBreak":true},{"text":"Şər adamı pisliyi yıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Əməlisalehi salehliyi qurtarar,","poem":1},{"lineBreak":true},{"text":"Xaini acgözlüyü tələyə salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Şər insan ölər, ümidi də boşa çıxar,","poem":1},{"lineBreak":true},{"text":"Pislərin arzusu itib-batar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Saleh dardan qurtular,","poem":1},{"lineBreak":true},{"text":"Onun yerinə pis insan dara düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Allahsızın dili qonşusunu məhv edər,","poem":1},{"lineBreak":true},{"text":"Bilik salehi xilas edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Salehlər xeyrə çatanda bütün şəhər şad olar,","poem":1},{"lineBreak":true},{"text":"Şər adamlar öləndə sevinc harayı qalxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Əməlisalehlərin alqışı şəhəri şərəfə çatdırar,","poem":1},{"lineBreak":true},{"text":"Lakin şərin qarğışı oranı viran qoyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Qanmaz qonşusuna xor baxar,","poem":1},{"lineBreak":true},{"text":"Dərrakəli insan dinc dayanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sözgəzdirən sirləri açıb yayar,","poem":1},{"lineBreak":true},{"text":"Etibarlı adam sözü gizli saxlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Düz məsləhət verilməyən yerdə xalq yıxılar,","poem":1},{"lineBreak":true},{"text":"Doğru nəsihət verən çoxdursa, xalq qurtuluşa çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Özgəyə zamin duran özünü bəlaya salar,","poem":1},{"lineBreak":true},{"text":"Belə zaminlikdən zəhləsi gedən dinc yaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mehriban qadın şərəfdən,","poem":1},{"lineBreak":true},{"text":"Zalım insan isə sərvətdən yapışar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"İnsanın sadiqliyi ona xeyir gətirər,","poem":1},{"lineBreak":true},{"text":"Qəddar adam özünə əzab verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Şər adam saxta mükafat qazanar,","poem":1},{"lineBreak":true},{"text":"Salehlik toxumu əkən, həqiqətən, onun əvəzini alar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sidq ürəkdən saleh olan həyata qovuşar,","poem":1},{"lineBreak":true},{"text":"Şərin ardınca düşən ölümə çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Əyri ürəkli olmaq Rəbdə ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"O, yolu kamil olanlardan razı qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Doğrudan da, pis cəzasız qalmaz,","poem":1},{"lineBreak":true},{"text":"Salehlərin nəsli xilas olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bir gözəl qadının xoş rəftarı olmazsa,","poem":1},{"lineBreak":true},{"text":"Burnuna qızıl halqa taxılmış donuza bənzər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Salehlər yalnız yaxşılıq arzular,","poem":1},{"lineBreak":true},{"text":"Şər adama qəzəb nəsib olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Əliaçıq adamın bərəkəti artar,","poem":1},{"lineBreak":true},{"text":"Başqasının qazancını yeyən ehtiyaca düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Comərd bolluğa yetişər,","poem":1},{"lineBreak":true},{"text":"Su verənə su verilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Taxılı anbarda gizlədənə camaat lənət oxuyar,","poem":1},{"lineBreak":true},{"text":"Onu satanın başına bərəkət yağar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Səylə yaxşılığın ardınca gedən lütf axtarar,","poem":1},{"lineBreak":true},{"text":"Şər ardınca düşən isə başını bəlaya salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sərvətinə güvənənlər yıxılar,","poem":1},{"lineBreak":true},{"text":"Salehlər isə yaşıl yarpaq kimi təzələnər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Külfətini əzaba salanın nəsibi yel tək sovrular,","poem":1},{"lineBreak":true},{"text":"Qəlbində hikmət olana səfeh qul olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Salehin barı həyat ağacıdır,","poem":1},{"lineBreak":true},{"text":"Hikmətli insan canları qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Əgər bu dünyada salehlərə belə, cəza verilirsə,","poem":1},{"lineBreak":true},{"text":"Pislərə, günahkarlara gör nə qədər cəza verilər!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}