{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Tərbiyəni sevən biliyi sevər,","poem":1},{"lineBreak":true},{"text":"Məzəmmətə nifrət edən şüursuzdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rəbb yaxşı adamdan razı qalar,","poem":1},{"lineBreak":true},{"text":"Pisniyyət adamı isə məhkum edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İnsan şərlə möhkəm olmaz,","poem":1},{"lineBreak":true},{"text":"Salehinsə kökü sarsılmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xeyirxah arvad ərinin tacıdır,","poem":1},{"lineBreak":true},{"text":"Adbatıran qadın çürümüş sümüyə oxşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Salehlərin məqsədi ədalətdir,","poem":1},{"lineBreak":true},{"text":"Şər insanların məsləhəti hiyləgərlikdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Şər adamların sözləri ölüm üçün pusqu qurar,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər dili ilə xilas olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pislər yıxılıb məhv olar,","poem":1},{"lineBreak":true},{"text":"Salehin evi dağılmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"İnsan ağıllı sözlərinə görə təriflənər,","poem":1},{"lineBreak":true},{"text":"Qəlbində hiylə olanlara xor baxılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Şöhrətsiz, lakin qul sahibi olan insan","poem":1},{"lineBreak":true},{"text":"Lovğalanan, lakin çörəyə möhtac adamdan yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Saleh insan hətta heyvanlarının ehtiyacını duyar,","poem":1},{"lineBreak":true},{"text":"Şər insanın mərhəmətində də zalımlıq var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Torpağını əkib-becərən doyunca çörək yeyər,","poem":1},{"lineBreak":true},{"text":"Qanmaz boş şeylərin ardınca gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şər adam pislərin şikarına qibtə edər,","poem":1},{"lineBreak":true},{"text":"Salehin kökü pöhrələnər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pis adamı itaətsiz dili tələyə salar,","poem":1},{"lineBreak":true},{"text":"Saleh dara düşsə də, oradan salamat qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"İnsanın dilindən yaxşı söz çıxarsa, bol xeyir tapar,","poem":1},{"lineBreak":true},{"text":"Əlinin zəhmətinin əvəzini alar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Səfehin yolu öz gözündə düz görünər,","poem":1},{"lineBreak":true},{"text":"Hikmətli adam nəsihəti dinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Səfeh dərhal qəzəbini üzə verər,","poem":1},{"lineBreak":true},{"text":"Uzaqgörən şərəfsizliyin üstünü örtər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Doğru şahid həqiqəti danışar,","poem":1},{"lineBreak":true},{"text":"Yalançı şahid hiylə qurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Düşünmədən danışanın dili qılınc kimi yaralar,","poem":1},{"lineBreak":true},{"text":"Hikmətlinin dili isə insanları sağaldar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Düz söz əbədi yaşar,","poem":1},{"lineBreak":true},{"text":"Yalanın ömrü az olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Şər quranın qəlbində hiylə olar,","poem":1},{"lineBreak":true},{"text":"Nəsihət verib sülhə çağıran sevinc tapar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Saleh heç vaxt bəlaya düşməz,","poem":1},{"lineBreak":true},{"text":"Pislərin başı bəla ilə dolu olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rəbb yalançı dilə ikrah edər,","poem":1},{"lineBreak":true},{"text":"Həqiqəti yerinə yetirənlərdən isə razı qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Uzaqgörən bildiyini özü üçün saxlar,","poem":1},{"lineBreak":true},{"text":"Axmaq qəlbinin səfehliyini hamıya yayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Çalışqanın əli özünü ağa edər,","poem":1},{"lineBreak":true},{"text":"Tənbəllik insanı qula çevirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Qəlbi narahat olanın qəddi əyilər,","poem":1},{"lineBreak":true},{"text":"Xoş söz könlü şad edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Saleh insan qonşusuna da yol göstərər,","poem":1},{"lineBreak":true},{"text":"Lakin şər insanın yolu dolaşıqdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tənbəlin əlinə ov düşsə də, onu bişirməz,","poem":1},{"lineBreak":true},{"text":"Çalışqan qiymətli sərvətə çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Salehliyin yollarında həyat var,","poem":1},{"lineBreak":true},{"text":"Kim bu yolla getsə, orada ölüm tapmaz.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}