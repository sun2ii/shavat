{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Hikmətli oğul ata tərbiyəsinə qulaq asar,","poem":1},{"lineBreak":true},{"text":"Rişxəndçi iradı qulaq ardına vurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"İnsanın dilində yaxşı söz olsa, onun xeyrini yeyər,","poem":1},{"lineBreak":true},{"text":"Xain zorakılıq istər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dilini saxlayan canını qoruyar,","poem":1},{"lineBreak":true},{"text":"Boşboğaz başını bəlaya salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tənbəl arzuladığına çatmaz,","poem":1},{"lineBreak":true},{"text":"Çalışqan bolluğa qovuşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Saleh adam yalana nifrət edər,","poem":1},{"lineBreak":true},{"text":"Şər insanın sözləri xəcalət və rüsvayçılıq gətirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kamillik yolunda olanı salehlik qoruyar,","poem":1},{"lineBreak":true},{"text":"Günahkarı şər yıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Adam var ki, heç nəyi yoxdur, özünü varlı göstərir,","poem":1},{"lineBreak":true},{"text":"Adam var ki, malı çoxdur, özünü yoxsul göstərir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sərvət insanın canını təhlükədən qurtarar,","poem":1},{"lineBreak":true},{"text":"Yoxsul isə hədə-qorxu eşitməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Saleh insanların işığı könlü sevindirər,","poem":1},{"lineBreak":true},{"text":"Şər insanların çırağı sönər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Təkəbbürdən ancaq münaqişə yaranar,","poem":1},{"lineBreak":true},{"text":"Yaxşı nəsihətə qulaq asanın hikməti var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kələklə gələn sərvət azalar,","poem":1},{"lineBreak":true},{"text":"Zəhmətlə qazanılan sərvət isə artar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gecikən ümid ürəyi xəstələndirir,","poem":1},{"lineBreak":true},{"text":"Arzuya çatmaq həyat ağacıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Öyüdə xor baxan öz canını həlak edər,","poem":1},{"lineBreak":true},{"text":"Əmrə ehtiram edənlərə mükafat verilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hikmətli adamın təlimi həyat qaynağıdır,","poem":1},{"lineBreak":true},{"text":"İnsanı ölüm tələsinə düşməkdən geri qaytarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dərin ağlı olan lütf qazanır,","poem":1},{"lineBreak":true},{"text":"Xainin yolu dolaşıqdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Uzaqgörən hər gördüyü işi bilir,","poem":1},{"lineBreak":true},{"text":"Axmaq öz səfehliyini hamıya göstərir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Pis qasid bəlaya düşər,","poem":1},{"lineBreak":true},{"text":"Etibarlı elçi şəfa verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tərbiyəni rədd edən yoxsullaşıb şərəfdən düşər,","poem":1},{"lineBreak":true},{"text":"Məzəmməti qəbul edən şərəfə yetişər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Arzuya çatmaq qəlbə, cana şirin gələr,","poem":1},{"lineBreak":true},{"text":"Axmaq pislikdən dönməyə ikrah edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hikmətli ilə oturub-duran hikmət qazanar,","poem":1},{"lineBreak":true},{"text":"Axmaqlarla ayaqlaşan bədbəxt olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Günahkarı şər qovar,","poem":1},{"lineBreak":true},{"text":"Salehin yaxşı bir əvəzi var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaxşı insan nəvələrinə də irs qoyar,","poem":1},{"lineBreak":true},{"text":"Günahkarın yığdığı sərvət salehə qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yoxsulların əkini bol bəhrə versə də,","poem":1},{"lineBreak":true},{"text":"Ədalət olmayan yerdə bada gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Oğlundan kötəyi əsirgəyən sanki ona nifrət edər,","poem":1},{"lineBreak":true},{"text":"Oğlunu sevən ona düzgün tərbiyə verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Saleh yeyib doyar,","poem":1},{"lineBreak":true},{"text":"Şər adamsa ac qalar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}