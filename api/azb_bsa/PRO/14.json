{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Hikmətli qadın evini qurar,","poem":1},{"lineBreak":true},{"text":"Səfeh qadın onu öz əli ilə uçurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Düz yol tutan Rəbdən qorxar,","poem":1},{"lineBreak":true},{"text":"Yolunu azan Ona xor baxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Səfeh lovğa sözlərinə görə kötək qazanar,","poem":1},{"lineBreak":true},{"text":"Hikmətlinin dili onu qoruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Öküz olmayan yerdə axur təmiz olar,","poem":1},{"lineBreak":true},{"text":"Amma bol məhsul öküzün gücü ilə yaranar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Doğru şahid yalan deməz,","poem":1},{"lineBreak":true},{"text":"Yalançı şahid yalandan üzə durar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rişxəndçi hikmət axtaranda onu tapmaz,","poem":1},{"lineBreak":true},{"text":"Dərrakəli adama bilik tapmaq asan olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Axmağın qarşısından çəkil,","poem":1},{"lineBreak":true},{"text":"Onun dilində ağıllı söz tapmazsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uzaqgörən hikməti ilə öz yolunu anlar,","poem":1},{"lineBreak":true},{"text":"Axmaq səfehliyi ilə öz-özünü aldadar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Səfehlər günaha rişxənd edər,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər bir-birini məmnun edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ürək öz dərdini bilər,","poem":1},{"lineBreak":true},{"text":"Özgələr onun sevincinə şərik olmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Şərin evi tar-mar olar,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlərin yurdu çiçək açar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yol var ki, insanın qarşısında düz görünür,","poem":1},{"lineBreak":true},{"text":"Amma sonu ölümdür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ürək güləndə də qəmli olar,","poem":1},{"lineBreak":true},{"text":"Sevincin sonunda da kədər var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Azğın ürəklilər öz yollarının bəhrəsini doyunca yeyir,","poem":1},{"lineBreak":true},{"text":"Yaxşı adam isə əməlinin əvəzini alır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Cahil hər sözə inanar,","poem":1},{"lineBreak":true},{"text":"Uzaqgörən hər addımına nəzər salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hikmətli qorxub pislikdən dönər,","poem":1},{"lineBreak":true},{"text":"Axmaq ehtiyatsızdır, özünə güvənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hövsələsiz səfeh-səfeh iş görər,","poem":1},{"lineBreak":true},{"text":"Pisniyyət adama nifrət edilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Cahil səfehliyi irs alar,","poem":1},{"lineBreak":true},{"text":"Uzaqgörənin başına bilik tacı qoyular.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Pislər yaxşıların qarşısında,","poem":1},{"lineBreak":true},{"text":"Şər adam isə salehin qapısında əyilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yoxsula qonşusu da nifrət edər,","poem":1},{"lineBreak":true},{"text":"Zəngini isə çox adam sevər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Qonşusuna xor baxan günaha batar,","poem":1},{"lineBreak":true},{"text":"Məzluma səxavət göstərən nə bəxtiyardır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Şər quranlar yolundan azmırlarmı?","poem":1},{"lineBreak":true},{"text":"Məqsədi xeyirxahlıq olan xeyirxahlığa, sədaqətə çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hər zəhmətdə bir fayda var,","poem":1},{"lineBreak":true},{"text":"Boş sözlər insanı ehtiyac içində qoyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Hikmətlinin başına sərvət tacı qoyular,","poem":1},{"lineBreak":true},{"text":"Axmaqlar səfehliyi ilə tanınar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Doğru şahid canları qurtarar,","poem":1},{"lineBreak":true},{"text":"Yalançı şahid hiylə qurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Rəbdən qorxan tam arxayındır,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb onun övladlarının pənahıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Rəbb qorxusu həyat qaynağıdır,","poem":1},{"lineBreak":true},{"text":"İnsanı ölüm tələsinə düşməkdən geri qaytarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Padşahın əzəməti xalqın çoxluğu ilə bilinər,","poem":1},{"lineBreak":true},{"text":"Əgər təbəələri olmasa, hökmdar süqut edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Gec qəzəblənənin böyük dərrakəsi var,","poem":1},{"lineBreak":true},{"text":"Hövsələsizlərdən səfehlik çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ürəyin rahatlığı cana həyat verər,","poem":1},{"lineBreak":true},{"text":"Paxıllıqsa sümükləri çürüdər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kasıba zülm edən Yaradanına xor baxar,","poem":1},{"lineBreak":true},{"text":"Yoxsula lütf göstərən Ona hörmət edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Şər adam pisliyi üzündən qovular,","poem":1},{"lineBreak":true},{"text":"Salehin ölümündə belə, pənahı var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Hikmət dərrakəlinin qəlbində özünə rahat yuva qurar,","poem":1},{"lineBreak":true},{"text":"Hətta axmaqların arasında da bəlli olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Salehlik bir milləti ucaldar,","poem":1},{"lineBreak":true},{"text":"Günah ümmətləri utandırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Padşah ağıllı qulundan razı qalar,","poem":1},{"lineBreak":true},{"text":"Adbatıransa onun qəzəbinə düçar olar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}