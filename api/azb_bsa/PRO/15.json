{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Həlim cavab hirsi yatırar,","poem":1},{"lineBreak":true},{"text":"Sərt söz qəzəbi alovlandırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hikmətlinin dili biliyi mədh edər,","poem":1},{"lineBreak":true},{"text":"Axmaqların dilindən səfehlik tökülər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbbin gözü hər yerə baxar,","poem":1},{"lineBreak":true},{"text":"Pislərə, yaxşılara nəzər salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Şəfa gətirən dil həyat ağacıdır,","poem":1},{"lineBreak":true},{"text":"Əyri dil ürək qırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Səfeh ata tərbiyəsini ələ salar,","poem":1},{"lineBreak":true},{"text":"Məzəmməti qəbul edən uzaqgörən olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Salehin evində böyük xəzinə yaşar,","poem":1},{"lineBreak":true},{"text":"Şər insanın isə gəlirində əzab var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hikmətlinin dili bilik səpələyir,","poem":1},{"lineBreak":true},{"text":"Axmağın qəlbi bunu edə bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb şər insanın etdiyi qurbandan ikrah edir,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlərin duasından isə razı qalır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbb şər insanın yollarından ikrah edər,","poem":1},{"lineBreak":true},{"text":"Amma salehliyin ardınca gedəni sevər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Düz yolu buraxana şiddətli töhmət verilər,","poem":1},{"lineBreak":true},{"text":"Məzəmmətə nifrət edənə ölüm gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ölüm və Həlak yeri Rəbbə aşkardır,","poem":1},{"lineBreak":true},{"text":"Gör O, insan ürəyindən necə agahdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rişxəndçi iradı sevməz,","poem":1},{"lineBreak":true},{"text":"Hikmətlilərin yanına gəlməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Qəlbin sevinci üzü xoş edər,","poem":1},{"lineBreak":true},{"text":"Ürəyin kədəri könlü sındırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dərrakəlinin könlü bilik axtarar,","poem":1},{"lineBreak":true},{"text":"Axmaqların ağzı səfehliklə qidalanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Məzlumun hər günü qaradır,","poem":1},{"lineBreak":true},{"text":"Ürəyi bəxtəvərin elə bil daima ziyafəti var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbb qorxusu ilə qazanılan az şey","poem":1},{"lineBreak":true},{"text":"Qayğı ilə yığılan böyük xəzinədən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sevgi dolu bir yerdə göyərti yemək","poem":1},{"lineBreak":true},{"text":"Nifrət dolu bir yerdə yağlı dana əti yeməkdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kəmhövsələ dava yaradar,","poem":1},{"lineBreak":true},{"text":"Səbirli münaqişəni sovuşdurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tənbəlin yolunu tikanlar basar,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlərin yolu baş yoldur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hikmətli oğul atasını sevindirər,","poem":1},{"lineBreak":true},{"text":"Axmaq anasına xor baxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Qanmaz səfehlikdən sevinər,","poem":1},{"lineBreak":true},{"text":"Dərrakəli düz yolla gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Məsləhətsiz niyyət boşa çıxar,","poem":1},{"lineBreak":true},{"text":"Doğru nəsihət verən çoxdursa, uğur qazandırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"İnsan münasib cavab versə, şad olar,","poem":1},{"lineBreak":true},{"text":"Sözü yerində demək nə yaxşıdır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ağıllı insan aşağıdan – ölülər diyarından ayrılmaq üçün","poem":1},{"lineBreak":true},{"text":"Həyat yolunu tutub yuxarı gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Rəbb təkəbbürlünün evini yıxar,","poem":1},{"lineBreak":true},{"text":"Dul qadının sərhədini qoruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Pislərin məqsədləri Rəbdə ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"Ona xoş gələnlərin sözlərini təmiz sayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tamahkar külfətini əzaba salar,","poem":1},{"lineBreak":true},{"text":"Rüşvətə nifrət edənin ömrü uzun olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Saleh insan cavab verməzdən əvvəl qəlbində düşünər,","poem":1},{"lineBreak":true},{"text":"Şər insanın dilindən pislik tökülər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Rəbb şər adamdan gen dayanar,","poem":1},{"lineBreak":true},{"text":"Saleh insanların duasına qulaq asar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nurlu gözlər qəlbi sevindirər,","poem":1},{"lineBreak":true},{"text":"Yaxşı xəbər qəddi düzəldər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Həyatverici məzəmmətə qulaq asan","poem":1},{"lineBreak":true},{"text":"Hikmətlilərin içərisində yaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tərbiyəni rədd edən öz canına xor baxar,","poem":1},{"lineBreak":true},{"text":"Məzəmmətə qulaq asan anlayış qazanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Rəbb qorxusu hikmət tərbiyəsi verər,","poem":1},{"lineBreak":true},{"text":"İtaətkarlıq şərəfdən əvvəl gələr.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}