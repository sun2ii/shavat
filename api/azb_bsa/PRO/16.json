{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Ürəyin fikirləri insandan,","poem":1},{"lineBreak":true},{"text":"Dilin cavabı isə Rəbdəndir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"İnsanın bütün yolları öz gözündə təmiz sayılar,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb ürəkləri yoxlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Görəcəyin işləri Rəbbə ver,","poem":1},{"lineBreak":true},{"text":"Onda niyyətlərin yerinə yetər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbb hər şeyi məqsədinə müvafiq yaradıb,","poem":1},{"lineBreak":true},{"text":"O, pis insanı bəla günü üçün yaradıb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb qəlbi təkəbbürlülərdən ikrah edər,","poem":1},{"lineBreak":true},{"text":"Doğrudan da, onlar cəzasız qalmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xeyirxahlıq və sədaqət hər təqsiri kəffarə edər,","poem":1},{"lineBreak":true},{"text":"İnsan Rəbb qorxusuna görə pislikdən dönər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbb insanın həyatından razı qaldısa,","poem":1},{"lineBreak":true},{"text":"Düşmənlərini belə, onunla barışdırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Salehliklə qazanılan az şey","poem":1},{"lineBreak":true},{"text":"Haqsız yolla olan bol gəlirdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İnsan ürəyində özü üçün yol qurar,","poem":1},{"lineBreak":true},{"text":"Amma Rəbbin verdiyi istiqamətlə addımlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Padşah uzaqgörənliklə dilindən sözlər çıxarar,","poem":1},{"lineBreak":true},{"text":"Qoy onda məhkəmədə ədalətdən yan keçməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rəbb düzgün tərəzi və çəkini tələb edər,","poem":1},{"lineBreak":true},{"text":"O, torbadakı hər çəki daşını müəyyən edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şər iş görmək padşahlarda ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"Çünki salehliklə taxtlar möhkəm olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Saleh adamın dili padşahları razı salar,","poem":1},{"lineBreak":true},{"text":"Onlar düz danışanı sevər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Padşahın hiddəti ölüm elçisidir,","poem":1},{"lineBreak":true},{"text":"Amma hikmətli insan bu hiddəti yatırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Padşahın üzü nuranidirsə, demək, həyat var,","poem":1},{"lineBreak":true},{"text":"Razılığı yaz yağışı gətirən buluda oxşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Qızıldan çox hikmət qazanmaq yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Gümüşü yox, idrakı yığmaq üstün tutular.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Əməlisalehlər pislikdən dönmək yolunu tutar,","poem":1},{"lineBreak":true},{"text":"Yoluna diqqət edən canını qoruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Əcəldən əvvəl təkəbbür gələr,","poem":1},{"lineBreak":true},{"text":"Fəlakətdən əvvəl lovğalıq ruhu gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Məzlumlar arasında sadə qəlbli olmaq","poem":1},{"lineBreak":true},{"text":"Təkəbbürlülərlə talan malı bölüşdürməkdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Sözdən hikmət alan xeyir tapar,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənən insan nə bəxtiyardır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Qəlbində hikmət olan dərrakəli adlanar,","poem":1},{"lineBreak":true},{"text":"Şirin dilli olan müdrikliyi artırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ağıl insan üçün həyat çeşməsidir,","poem":1},{"lineBreak":true},{"text":"Axmağa tərbiyə vermək səfehlikdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hikmətlinin ürəyi dilinə tərbiyə verir,","poem":1},{"lineBreak":true},{"text":"Ağzındakı müdrik sözləri artıq edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Xoş sözlər sanki pətəkdə baldır,","poem":1},{"lineBreak":true},{"text":"Cana şirinlik, sümüklərə şəfadır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yol var ki, insanın qarşısında düz görünür,","poem":1},{"lineBreak":true},{"text":"Amma sonu ölümdür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Əməkçi qarnı üçün zəhmət çəkir,","poem":1},{"lineBreak":true},{"text":"Aclıq onu məcbur edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yaramaz şər quyusu qazar,","poem":1},{"lineBreak":true},{"text":"Dili alov kimi yandırıb-yaxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Hiyləgər adam dava yaradar,","poem":1},{"lineBreak":true},{"text":"Qeybətçi əziz dostları ayırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Zorakı qonşularını aldadar,","poem":1},{"lineBreak":true},{"text":"Onları yaxşı olmayan yola aparar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Niyyəti hiyləli olan göz vurar,","poem":1},{"lineBreak":true},{"text":"Dodaq büzər, şər qurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ağaran saçlar şərəf tacıdır,","poem":1},{"lineBreak":true},{"text":"Salehlik yolunun qazancıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"İgid olmaqdan səbirli olmaq yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Nəfsə hakim olmaq şəhəri almaqdan üstündür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ətəyin üstünə püşk atılar,","poem":1},{"lineBreak":true},{"text":"Amma hökm Rəbdən gələr.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}