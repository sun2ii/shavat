{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Quru bir loğması olan dinc ev","poem":1},{"lineBreak":true},{"text":"Münaqişəli olan, ziyafət dolu evdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ağıllı nökər adbatıran oğlun ağası olar,","poem":1},{"lineBreak":true},{"text":"Qardaşlar arasında miras payı alar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qızıl-gümüş isti kürədə yoxlanar,","poem":1},{"lineBreak":true},{"text":"Rəbb isə ürəyi araşdırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pis adamın diqqəti şər ağızdadır,","poem":1},{"lineBreak":true},{"text":"Yalançı fitnəkarın sözlərinə qulaq asır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yoxsula rişxənd edən Yaradanına xor baxır,","poem":1},{"lineBreak":true},{"text":"Başqasının bəlasına sevinən cəzasız qalmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nəvələr ahılların tacıdır,","poem":1},{"lineBreak":true},{"text":"Oğulların şərəfi atalarıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sarsağa bəlağətli","poem":1},{"noteId":0},{"text":"söz yaraşmadığı kimi","poem":1},{"lineBreak":true},{"text":"Əsilzadəyə də yalançı dil yaraşmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rüşvət verənin gözündə rüşvət bir tilsimdir,","poem":1},{"lineBreak":true},{"text":"Çünki hansı tərəfə getsə, uğur gətirir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Günahı örtən məhəbbət axtarar,","poem":1},{"lineBreak":true},{"text":"Sözgəzdirən əziz dostları ayırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qanan insan üçün bir irad","poem":1},{"lineBreak":true},{"text":"Axmağa vurulan yüz zərbədən də artıq təsir edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pis insan ancaq üsyankarlıq axtarar,","poem":1},{"lineBreak":true},{"text":"Onun əleyhinə qəddar qasid göndərilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Balalarını itirmiş bir ayıya rast gəlmək","poem":1},{"lineBreak":true},{"text":"Səfahətə batmış axmaqla rastlaşmaqdan yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kim yaxşılıq əvəzinə pislik etsə,","poem":1},{"lineBreak":true},{"text":"Evindən pislik ayrılmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Davanın başlanması su bəndinin açılmasına bənzər,","poem":1},{"lineBreak":true},{"text":"Dava başlanmamış münaqişəni tərk et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Şərə haqq vermək, salehi məhkum etmək –","poem":1},{"lineBreak":true},{"text":"Hər ikisi Rəbdə ikrah yaradır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Axmaq hikmət qazanmaq istəməz,","poem":1},{"lineBreak":true},{"text":"Bunun üçün pul sərf etmək fayda verməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dost hər zaman sevər,","poem":1},{"lineBreak":true},{"text":"Qardaş dar gün üçün doğular.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Qanmaz başqası ilə əlbir olar,","poem":1},{"lineBreak":true},{"text":"O, qonşusuna zamin durar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"İtaətsizliyi sevən münaqişəni sevər,","poem":1},{"lineBreak":true},{"text":"Qapısını ucaldan əcəlini səslər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Əyri ürəkli xeyir tapmaz,","poem":1},{"lineBreak":true},{"text":"Hiyləgər dilli insanı bəlaya salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Axmağın atası dərdə düşər,","poem":1},{"lineBreak":true},{"text":"Sarsağın atasının sevinci itər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ürək sevinci can üçün ən yaxşı məlhəmdir,","poem":1},{"lineBreak":true},{"text":"Könlün sınması sümükləri qurudar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Şər qoltuğuna rüşvət götürər ki,","poem":1},{"lineBreak":true},{"text":"Ədalət yollarını pozsun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Qanan adam hikmətə baxar,","poem":1},{"lineBreak":true},{"text":"Axmağın gözləri dünyanın o tayını axtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Axmaq oğul atasına qəm-kədər verər,","poem":1},{"lineBreak":true},{"text":"Onu doğan anasını qubarladar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Saleh insanı cərimə etmək yaxşı deyil,","poem":1},{"lineBreak":true},{"text":"Əsilzadəni düzlüyünə görə döymək yaxşı deyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Çoxbilən az danışar,","poem":1},{"lineBreak":true},{"text":"Müdrik həlimlik ruhunda olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Səfeh belə, sakit dayansa, hikmətli hesab edilər,","poem":1},{"lineBreak":true},{"text":"Ağzını yumsa, dərrakəli görünər.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Bəlağətli – inandırıcı, gözəl və aydın nitq.","reference":{"chapter":17,"verse":7}}]},"thisChapterLink":"/api/azb_bsa/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}