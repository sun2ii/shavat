{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Tənhalığı sevən niyyətinin ardınca düşür,","poem":1},{"lineBreak":true},{"text":"Sağlam şüura zidd gedir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Axmaq dərrakəni deyil,","poem":1},{"lineBreak":true},{"text":"Fikrini ortaya tökməyi sevir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Şər insanla hörmətsizlik,","poem":1},{"lineBreak":true},{"text":"Şərəfsizliklə rüsvayçılıq gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dilin sözlərindən dərin sular yaranar,","poem":1},{"lineBreak":true},{"text":"Hikmət qaynağından çay axar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Məhkəmədə salehi haqsız çıxarmaq üçün","poem":1},{"lineBreak":true},{"text":"Pis adama tərəfkeşlik etmək yaxşı deyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Axmağın dili münaqişəyə girişər,","poem":1},{"lineBreak":true},{"text":"Ağzı özünü döydürər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Axmağın ağzı onu bəlaya salar,","poem":1},{"lineBreak":true},{"text":"Dili canına tələ qurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Qeybətçinin sözləri şirin tikələrə bənzər,","poem":1},{"lineBreak":true},{"text":"Mədənin ən dərin yerlərinə düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ləng işləyən dağıdıcıya yoldaşdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbbin adı qüvvətli bir qaladır,","poem":1},{"lineBreak":true},{"text":"Saleh qaçıb ona pənah aparır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Varlı üçün sərvəti ona qala şəhəridir,","poem":1},{"lineBreak":true},{"text":"Öz gümanında özü üçün pənah hasarı tikir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ürəyin təkəbbürü əcəldən əvvəl gələr,","poem":1},{"lineBreak":true},{"text":"İtaətkarlıq şərəfdən əvvəl gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Eşitməzdən qabaq cavab vermək","poem":1},{"lineBreak":true},{"text":"Səfehlik və rüsvayçılıqdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xəstənin ürəyi bütün ağrıları çəkər.","poem":1},{"lineBreak":true},{"text":"Amma ürəyi sınıqdırsa, buna necə dözər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dərrakəli ürək bilik qazanar,","poem":1},{"lineBreak":true},{"text":"Hikmətlinin qulağı bilik axtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"İnsanın hədiyyəsi ona yol açar,","poem":1},{"lineBreak":true},{"text":"Böyük adamların hüzuruna aparar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"İddiasını əvvəl deyən haqlı görünər,","poem":1},{"lineBreak":true},{"text":"Amma əleyhdarı gəlib onu istintaq edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Püşk atmaq davaları yatırar,","poem":1},{"lineBreak":true},{"text":"Savaşanları bir-birindən ayırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"İncik qardaşın könlünü almaq qalalı şəhəri almaqdan daha çətindir,","poem":1},{"lineBreak":true},{"text":"Belə davalar qapısı cəftəli qala kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"İnsanın qarnı ağzının bəhəri ilə,","poem":1},{"lineBreak":true},{"text":"Dilinin səmərəsi ilə doyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ölüm və həyat dilin əlindədir,","poem":1},{"lineBreak":true},{"text":"Onu sevənlər barından yeyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Arvad alan uğur qazanar,","poem":1},{"lineBreak":true},{"text":"Rəbbin razılığını alar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yoxsul rəhm istəyər,","poem":1},{"lineBreak":true},{"text":"Zəngin isə sərt cavab verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dost çoxaldan öz-özünü yıxar,","poem":1},{"lineBreak":true},{"text":"Amma qardaşdan daha yaxın dost da var.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}