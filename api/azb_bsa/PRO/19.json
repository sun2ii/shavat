{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Kamalla yaşayan yoxsul insan","poem":1},{"lineBreak":true},{"text":"Şər danışan axmaqdan yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bilik yoxdursa, həvəs yaxşılıq edə bilməz.","poem":1},{"lineBreak":true},{"text":"Tələsən tərsə düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İnsan öz səfehliyi ilə yolunu alt-üst edər,","poem":1},{"lineBreak":true},{"text":"Ürəyində isə Rəbbə hiddətlənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Var-dövlət dost artırar,","poem":1},{"lineBreak":true},{"text":"Kasıbı isə dostları atar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yalançı şahid cəzasız qalmaz,","poem":1},{"lineBreak":true},{"text":"Yalandan üzə duran qurtuluş tapmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Çoxları nəcabətlinin üzünü görmək istər,","poem":1},{"lineBreak":true},{"text":"Səxavətli adamla çoxları dostluq edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yoxsuldan qardaşının da zəhləsi gedər,","poem":1},{"lineBreak":true},{"text":"Dostları ondan lap uzaq gəzər,","poem":1},{"lineBreak":true},{"text":"Yalvararaq ardınca düşsə də, yaxınına gəlməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Anlayış qazanan öz canını sevər,","poem":1},{"lineBreak":true},{"text":"Dərrakəyə bağlanan uğur qazanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yalançı şahid cəzasız qalmaz,","poem":1},{"lineBreak":true},{"text":"Yalandan üzə duran həlak olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Axmağa dəbdəbəli həyat yaraşmadığı kimi","poem":1},{"lineBreak":true},{"text":"Qulun ağalara hökm etməsi də yaraşmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"İnsanın ağlı hiddəti ləngidər,","poem":1},{"lineBreak":true},{"text":"Başqasının günahını bağışlamaq ona şərəf gətirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Padşahın qəzəbi aslan nərəsinə bənzər,","poem":1},{"lineBreak":true},{"text":"Razılığı çəmənə düşən şehə bənzər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Axmaq oğul atasına bəla olar,","poem":1},{"lineBreak":true},{"text":"Davakar arvad kəsilməyən damcıya oxşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"İnsana ev, var-dövlət atalardan miras qalar,","poem":1},{"lineBreak":true},{"text":"Ağıllı arvadı isə Rəbb nəsib edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tənbəllik insana dərin yuxu gətirər,","poem":1},{"lineBreak":true},{"text":"Avaralıq insanı ac qoyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Əmrə əməl edən canını saxlar,","poem":1},{"lineBreak":true},{"text":"Yoluna baxmayan həlak olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kasıba səxavət göstərən sanki Rəbbə borc verər,","poem":1},{"lineBreak":true},{"text":"Çünki onun əvəzi Rəbdən gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ümid varkən oğluna tərbiyə ver,","poem":1},{"lineBreak":true},{"text":"Ölümünə bais olma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kəmhövsələ insan cəriməyə düşər,","poem":1},{"lineBreak":true},{"text":"Onu qurtarsan belə, yenə də davam edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nəsihətə qulaq as, tərbiyəni qəbul et,","poem":1},{"lineBreak":true},{"text":"Bunun nəticəsində hikmətli olarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"İnsanın qəlbində çox amalı var,","poem":1},{"lineBreak":true},{"text":"Amma Rəbbin niyyəti həyata keçər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"İnsan etibar arzular,","poem":1},{"lineBreak":true},{"text":"Yoxsul adam fırıldaqçıdan yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbb qorxusu insana həyat verər,","poem":1},{"lineBreak":true},{"text":"Ona şər yaxınlaşmaz, tox yatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tənbəl əlini qabda olana batırar,","poem":1},{"lineBreak":true},{"text":"Ağzına belə, aparmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Rişxəndçini döysən, cahil insan uzaqgörən olar,","poem":1},{"lineBreak":true},{"text":"Dərrakəlini danlasan, biliyini artırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kim ki atasını soyub, anasını qovar,","poem":1},{"lineBreak":true},{"text":"Xəcalət gətirən övladdır, ad batırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Oğlum, bilik verən sözlərdən dönmək istəsən,","poem":1},{"lineBreak":true},{"text":"Tərbiyəyə qulaq asmaqdan vaz keç!","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yaramaz şahid ədalətə rişxənd edər,","poem":1},{"lineBreak":true},{"text":"Pislərin ağzı acgözlüklə şəri yeyər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Rişxəndçilər üçün məhkəmə,","poem":1},{"lineBreak":true},{"text":"Axmaqların kürəyi üçün kötək hazırlanar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}