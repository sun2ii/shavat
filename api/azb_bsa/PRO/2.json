{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Hikmətin dəyəri"]},{"type":"verse","number":1,"content":[{"text":"Oğlum, əgər sözlərimi qəbul etsən,","poem":1},{"lineBreak":true},{"text":"Əmrlərimi qorusan,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qulağını hikmətə tərəf çevirsən,","poem":1},{"lineBreak":true},{"text":"Ürəyini dərrakəyə tərəf meyl etdirsən,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sən, həqiqətən, idrakı çağırsan,","poem":1},{"lineBreak":true},{"text":"Səs ucaldıb dərrakəni səsləsən,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bunları gümüş kimi axtarsan,","poem":1},{"lineBreak":true},{"text":"Gizli xəzinə kimi arasan,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onda Rəbb qorxusunu anlayarsan,","poem":1},{"lineBreak":true},{"text":"Allahı tanıyarsan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki Rəbb hikmət verir,","poem":1},{"lineBreak":true},{"text":"Onun ağzından bilik və dərrakə çıxır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, əməlisalehlərin sağlam şüurunu qoruyur,","poem":1},{"lineBreak":true},{"text":"Kamalla gəzənlərə sipər olur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O, ədalətin yollarını qoruyur,","poem":1},{"lineBreak":true},{"text":"Möminlərin yollarını hifz edir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onda salehlik və ədaləti dərk edərsən,","poem":1},{"lineBreak":true},{"text":"İnsafı, bütün yaxşı yolları tanıyarsan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hikmət qəlbinə dolar,","poem":1},{"lineBreak":true},{"text":"Bilikdən könlün xoş olar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İdrak səni hifz edər,","poem":1},{"lineBreak":true},{"text":"Dərrakə səni qoruyar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hikmət səni pislərin yolundan,","poem":1},{"lineBreak":true},{"text":"Sözü məkrli adamlardan qurtarar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onlar düz yolları atıblar,","poem":1},{"lineBreak":true},{"text":"Qaranlıq yollarda dolanırlar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Şər iş görəndə şad olurlar,","poem":1},{"lineBreak":true},{"text":"Şərin məkrindən xoşhallanırlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bu adamların yolları əyridir,","poem":1},{"lineBreak":true},{"text":"Onlar dolaşıq yollarla gedir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hikmət səni yad arvaddan,","poem":1},{"lineBreak":true},{"text":"Şirin dilli əxlaqsız qadından qurtarar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu qadın gənc vaxtı getdiyi ərini atıb,","poem":1},{"lineBreak":true},{"text":"Allahının əhdini unudub.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onun evi ölümə,","poem":1},{"lineBreak":true},{"text":"Yolları qəbiristanlığa aparar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yanına gələn kimsə geri qayıtmaz,","poem":1},{"lineBreak":true},{"text":"Bir daha həyat yollarına çatmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Beləliklə, yaxşıların yolu ilə gedərsən,","poem":1},{"lineBreak":true},{"text":"Salehlərin yollarına bağlı qalarsan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki əməlisalehlər yer üzündə sakin olacaq,","poem":1},{"lineBreak":true},{"text":"Kamillər burada qalacaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pis adamlar bu torpaqdan atılacaq,","poem":1},{"lineBreak":true},{"text":"Xainlərin kökü buradan qoparılacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}