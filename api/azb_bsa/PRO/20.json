{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Şərab insanları ələ salar,","poem":1},{"lineBreak":true},{"text":"Kefləndirici içki onları dalaşdırar,","poem":1},{"lineBreak":true},{"text":"Sərxoş olan müdrik olmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Padşahın vahiməsi aslan nərəsinə bənzər,","poem":1},{"lineBreak":true},{"text":"Onu əsəbləşdirən canını itirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Münaqişədən çəkinmək insana şərəf gətirər,","poem":1},{"lineBreak":true},{"text":"Hər səfeh davaya girişər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mövsümündə kotan sürməyən tənbəl əkinçi","poem":1},{"lineBreak":true},{"text":"Biçin vaxtı heç nə tapmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ürəyin düşüncələri dərin sulara oxşar,","poem":1},{"lineBreak":true},{"text":"Dərrakəli adam onu çəkib çıxarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"İnsanların çoxu sədaqətindən dəm vurar.","poem":1},{"lineBreak":true},{"text":"Amma sadiq adamı haradan tapmaq olar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saleh kamalı ilə yaşar,","poem":1},{"lineBreak":true},{"text":"Özündən sonra gələn nəsli bəxtiyar olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nə zaman ki padşah hökm üçün taxta çıxar,","poem":1},{"lineBreak":true},{"text":"Gözləri ilə bütün pisliyi sovurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kim deyər ki, qəlbimi təmizləmişəm,","poem":1},{"lineBreak":true},{"text":"Günahımı silmişəm?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aldadıcı ölçü, aldadıcı çəki –","poem":1},{"lineBreak":true},{"text":"Hər ikisi Rəbdə ikrah yaradar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hətta uşaq da əməlləri ilə,","poem":1},{"lineBreak":true},{"text":"İşlərinin saf, doğru, yoxsa əksinə olması ilə tanınar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Eşidən qulaq, görən gözlər –","poem":1},{"lineBreak":true},{"text":"Bunların hər ikisini yaradan Rəbdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sevmə yatmağı, yoxsullaşarsan,","poem":1},{"lineBreak":true},{"text":"Ayıq ol, onda bol çörəyə çatarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Müştəri deyər: «Pisdir, pis maldır»,","poem":1},{"lineBreak":true},{"text":"Amma alıb gedəndə özünü öyər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Qızıl və çox yaqut var,","poem":1},{"lineBreak":true},{"text":"Amma ağıllı söz danışan dil qiymətli cəvahirdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Özgəyə zamin duranın libasını al,","poem":1},{"lineBreak":true},{"text":"Onu qəriblər üçün girov saxla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kələklə əldə edilən çörək əvvəlcə şirin olar,","poem":1},{"lineBreak":true},{"text":"Axırda ağzı çınqılla doldurar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nəsihət alaraq möhkəm qərar çıxar,","poem":1},{"lineBreak":true},{"text":"Müharibəni sağlam məsləhətlə apar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sözgəzdirən sirləri açıb yayar,","poem":1},{"lineBreak":true},{"text":"Gərək boşboğaza qoşulmayasan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kim ki atasına, anasına qarğış edər,","poem":1},{"lineBreak":true},{"text":"Zülmətə düşərkən çırağı sönər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tələsik alınan mülk","poem":1},{"lineBreak":true},{"text":"Axırda xeyir gətirməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Demə «bu pisliyin əvəzini çıxacağam»","poem":1},{"lineBreak":true},{"text":"Rəbbi gözlə, qoy O səni xilas etsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Fərqli çəki daşları Rəbdə ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"O, aldadıcı tərəzidən xoşlanmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kişiyə addım atdıran Rəbdir.","poem":1},{"lineBreak":true},{"text":"Bəs tutduğu yolu insan necə anlasın?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Düşünmədən nəzir edən özünü tələyə salar,","poem":1},{"lineBreak":true},{"text":"Sonra öz əhdi barədə çox fikirləşməli olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Hikmətli padşah pisləri sovurar,","poem":1},{"lineBreak":true},{"text":"Onlar dəyirman daşında üyüdülər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"İnsanın ruhu Rəbbin çırağıdır,","poem":1},{"lineBreak":true},{"text":"Daxilinin dərin yerlərini araşdırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Padşahı məhəbbət və sədaqət qoruyar,","poem":1},{"lineBreak":true},{"text":"Taxtını xeyirxahlıq möhkəm saxlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Gəncləri qüvvəti şərəfləndirər,","poem":1},{"lineBreak":true},{"text":"Ağ saçlar qocalara zinət verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Yaralayıcı zərbələr pis insanı düzəldə bilər,","poem":1},{"lineBreak":true},{"text":"Kötəkləmək daxilin dərin yerlərinə təsir edə bilər.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}