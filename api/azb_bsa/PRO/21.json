{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Padşahın ürəyi Rəbbin əlindədir,","poem":1},{"lineBreak":true},{"text":"Onu su arxı kimi istədiyi səmtə döndərər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"İnsanın yolu öz gözündə düz sayılar,","poem":1},{"lineBreak":true},{"text":"Lakin ürəkləri Rəbb yoxlayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbb Ona qurban təqdimindən çox","poem":1},{"lineBreak":true},{"text":"Salehliyə, ədalətə riayət edilməsini istər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Təkəbbürlü baxış, lovğa ürək","poem":1},{"lineBreak":true},{"text":"Pislərin işığı və günahıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Çalışqanın niyyəti xeyir gətirər,","poem":1},{"lineBreak":true},{"text":"Tələsən ehtiyac içinə düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yalançılıqla qazanılan xəzinə","poem":1},{"lineBreak":true},{"text":"Havaya yayılan sis-dumandır, bir ölüm tələsidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zorakılığına görə pislər süpürülüb atılacaq,","poem":1},{"lineBreak":true},{"text":"Çünki onlar ədalətə əməl etmək istəmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Günahkarın yolu dolaşıqdır,","poem":1},{"lineBreak":true},{"text":"Pak insanın etdiyi doğru sayılır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Davakar arvadla bir evdə yaşamaqdansa","poem":1},{"lineBreak":true},{"text":"Damın bir küncündə yaşamaq yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pis insan şərə can atar,","poem":1},{"lineBreak":true},{"text":"Qonşusu gözündə lütf tapmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rişxəndçini cərimə etsən, cahil bundan hikmət alar,","poem":1},{"lineBreak":true},{"text":"Hikmətli ibrətdən bilik qazanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Saleh insan pislərin evi barədə düşünər,","poem":1},{"lineBreak":true},{"text":"Çünki pislər alt-üst olub bəlaya düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Qulağını tutub kasıbın fəryadını eşitməyənin","poem":1},{"lineBreak":true},{"text":"Fəryadına cavab verilməyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gizli hədiyyə qəzəbi,","poem":1},{"lineBreak":true},{"text":"Qoltuqdakı rüşvət hiddəti yatırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Haqq öz yerinə gələndə saleh sevinər,","poem":1},{"lineBreak":true},{"text":"Şər iş görənin başı bəlaya düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kim ki ağlın yolundan çıxar,","poem":1},{"lineBreak":true},{"text":"Ölülər camaatı arasında uyuyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zövq-səfaya düşkün olan ehtiyaca düşər,","poem":1},{"lineBreak":true},{"text":"Şərab və yağlı yemək hərisi sərvət tapmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pis insan salehin yerinə,","poem":1},{"lineBreak":true},{"text":"Xain əməlisalehin əvəzinə girov verilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Davakar, deyingən arvadla yaşamaqdansa","poem":1},{"lineBreak":true},{"text":"Çöllükdə yaşamaq yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hikmətlinin evində istənilən xəzinə və bolluq var,","poem":1},{"lineBreak":true},{"text":"Axmağın nəyi varsa, yeyib-qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Salehlik və sədaqətin ardınca gedən","poem":1},{"lineBreak":true},{"text":"Həyat, salehlik və şərəf tapar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bir hikmətli qəhrəmanların şəhərinə hücum çəkər,","poem":1},{"lineBreak":true},{"text":"Alınmaz qalanı darmadağın edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ağzını, dilini tutan insan","poem":1},{"lineBreak":true},{"text":"Canını bəlalardan saxlayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Lovğa, təkəbbürlü adam rişxəndçi adlanır,","poem":1},{"lineBreak":true},{"text":"Lovğalandıqca lovğalanır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tənbəlin arzusu onu ölümə aparır,","poem":1},{"lineBreak":true},{"text":"Çünki əlləri zəhmətdən qaçır.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tənbəl bütün gün çox şey arzulayar,","poem":1},{"lineBreak":true},{"text":"Salehsə əsirgəmədən azuqə paylayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Şər adamın etdiyi qurban iyrəncdir,","poem":1},{"lineBreak":true},{"text":"Pis niyyətlə təqdim olunarsa, daha pisdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yalançı şahid həlak olar,","poem":1},{"lineBreak":true},{"text":"Söz eşidən həmişə danışdırılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Şər adam üzünü sərtləşdirər,","poem":1},{"lineBreak":true},{"text":"Əməlisaleh tutduğu yolu möhkəmləndirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Heç bir hikmət, dərrakə, ibrət","poem":1},{"lineBreak":true},{"text":"Rəbbin qarşısında dayana bilməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Atlar döyüş günü üçün hazırlanar,","poem":1},{"lineBreak":true},{"text":"Amma zəfəri Rəbb qazandırar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}