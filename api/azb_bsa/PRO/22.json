{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Yaxşı ad böyük sərvətdən,","poem":1},{"lineBreak":true},{"text":"Lütfkarlıq isə qızıl-gümüşdən üstündür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zəngin və yoxsul insan bir şeydə bir-birinə bənzəyir –","poem":1},{"lineBreak":true},{"text":"Hər ikisini yaradan Rəbdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Uzaqgörən qabaqcadan şəri görüb ondan qaçar,","poem":1},{"lineBreak":true},{"text":"Cahil isə irəli çıxar, ziyan tapar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"İtaətkarlığın və Rəbb qorxusunun nəticəsi","poem":1},{"lineBreak":true},{"text":"Sərvət, şərəf, həyatdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Əyri yol tikanlıdır, orada tələlər var,","poem":1},{"lineBreak":true},{"text":"Canını qoruyan bundan uzaqlaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Uşağa tərbiyə ver ki, layiqli yol tutsun,","poem":1},{"lineBreak":true},{"text":"O qocalanda da bu yoldan dönməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zəngin yoxsulun ağası olar,","poem":1},{"lineBreak":true},{"text":"Borclu adam borc verənə qul olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Haqsızlıq əkən şər biçər,","poem":1},{"lineBreak":true},{"text":"Onun qəzəbinin dəyənəyi məhv edilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Əliaçıq bərəkət qazanar,","poem":1},{"lineBreak":true},{"text":"Çünki çörəyindən kasıba paylar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rişxəndçi adamı qovsan, münaqişə qurtarar,","poem":1},{"lineBreak":true},{"text":"Çəkişmə, şərəfsizlik sona çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ürək təmizliyini sevən,","poem":1},{"lineBreak":true},{"text":"Dilindən lütfkar sözlər tökülən padşahın dostudur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rəbbin gözləri biliyi qoruyar,","poem":1},{"lineBreak":true},{"text":"Xainin sözlərini isə boşa çıxarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tənbəl deyər: «Bayırda aslan var,","poem":1},{"lineBreak":true},{"text":"Küçəyə çıxsam, məni parçalar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Əxlaqsız qadının ağzı dərin çuxura oxşar,","poem":1},{"lineBreak":true},{"text":"Rəbbin lənətinə gələn ora yıxılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Səfehlik uşağın qəlbindən yapışar,","poem":1},{"lineBreak":true},{"text":"Kötəklə tənbeh ediləndə bu ondan uzaqlaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Varlanmaq üçün kasıba zülm edən,","poem":1},{"lineBreak":true},{"text":"Zəngin adama verən ehtiyaca düşər.","poem":1}]},{"type":"heading","content":["Hikmətlilərin sözləri"]},{"type":"verse","number":17,"content":[{"text":"Qulağını aç, hikmətlilərin sözlərini eşit,","poem":1},{"lineBreak":true},{"text":"Ürəyini mənim biliyimə ver.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onları sinənə doldursan,","poem":1},{"lineBreak":true},{"text":"Onların hamısını dilinə salsan, yaxşı olar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rəbbə güvənəsən deyə","poem":1},{"lineBreak":true},{"text":"Bu gün bunları sənə bildirirəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sənə nəsihətlə, biliklə dolu əla məsəllər yazmamışammı?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qoy bunlar haqq sözün həqiqətini sənə bildirsinlər ki,","poem":1},{"lineBreak":true},{"text":"Hara səni göndərsələr, düz məlumat gətirəsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kasıbı fəqir olduğu üçün soyma,","poem":1},{"lineBreak":true},{"text":"Darvazada məzlumu zülmə salma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Çünki onların münaqişəsinə Rəbb baxar,","poem":1},{"lineBreak":true},{"text":"Onları soyanları soyub-talayar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tez qəzəblənənə yoldaş olma,","poem":1},{"lineBreak":true},{"text":"Kəmhövsələ ilə yola çıxma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yoxsa onun yollarına alışarsan,","poem":1},{"lineBreak":true},{"text":"Canını tələyə salarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Başqalarının borclarına zamin durmaqdan,","poem":1},{"lineBreak":true},{"text":"Belə işə əl atmaqdan çəkin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ödəməyə pulun olmasa,","poem":1},{"lineBreak":true},{"text":"Altından yatağını apararlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ata-babalarından qalan","poem":1},{"lineBreak":true},{"text":"Qədim sərhəd daşının yerini dəyişmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"İşində mahir olanı görürsənmi?","poem":1},{"lineBreak":true},{"text":"Sıravi adamların deyil, şahların hüzurunda dayanar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}