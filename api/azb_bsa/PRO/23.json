{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Bir ağa ilə süfrəyə əyləşəndə","poem":1},{"lineBreak":true},{"text":"Qarşında olana yaxşı bax.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İştahan çox olsa da, boğazına sərhəd qoy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onun ləziz xörəklərinə tamah salma,","poem":1},{"lineBreak":true},{"text":"Çünki bu yemək adamı aldadar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sərvət qazanmaq üçün özünü əldən salma,","poem":1},{"lineBreak":true},{"text":"İdraklı ol, bu fikirdən vaz keç.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gözünü sərvətə diksən, yox olar,","poem":1},{"lineBreak":true},{"text":"Birdən qanadlanar, uçub qartal tək göyə qalxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xəsisin çörəyini yemə,","poem":1},{"lineBreak":true},{"text":"Onun ləziz xörəklərinə tamah salma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, ürəyində hər şeyin hesabını edər.","poem":1},{"lineBreak":true},{"text":"Dilində sənə «ye, iç» deyər,","poem":1},{"lineBreak":true},{"text":"Amma ürəyi ilə dili bir deyil.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yediyin loğmanı qusarsan,","poem":1},{"lineBreak":true},{"text":"Dediyin bütün şirin sözlər boşa çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Axmağın qulağına söz demə,","poem":1},{"lineBreak":true},{"text":"Çünki sənin ağıllı sözlərinə xor baxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qədim sərhəd daşının yerini dəyişmə,","poem":1},{"lineBreak":true},{"text":"Yetimlərin əkininə girmə.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki onların Hamisi qüvvətlidir,","poem":1},{"lineBreak":true},{"text":"Səninlə olan münaqişəyə O baxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Qəlbini tərbiyəyə,","poem":1},{"lineBreak":true},{"text":"Qulaqlarını bilik sözlərinə ver.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Uşağa tərbiyə ver, bundan vaz keçmə,","poem":1},{"lineBreak":true},{"text":"Tərbiyə kötəyi ona ölüm gətirməz.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Əgər sən onu kötəkləsən,","poem":1},{"lineBreak":true},{"text":"Canını ölülər diyarından xilas edərsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Oğlum, ürəyin hikmətli olarsa,","poem":1},{"lineBreak":true},{"text":"Mənim də ürəyim sevinər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dilindən düz sözlər çıxarsa,","poem":1},{"lineBreak":true},{"text":"Könlüm sevincdən cuşa gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ürəyin günahkarlara qibtə etməsin,","poem":1},{"lineBreak":true},{"text":"Ancaq bütün gün Rəbb qorxusu ilə yaşa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sənin də bir aqibətin var,","poem":1},{"lineBreak":true},{"text":"Ümidin boşa çıxmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Oğlum, dinlə, hikmətli ol,","poem":1},{"lineBreak":true},{"text":"Qəlbini düz yola bağla.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Şərab düşkünü olan əyyaşlara,","poem":1},{"lineBreak":true},{"text":"Ət qapan qarınqululara qoşulma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki əyyaş və qarınqulu yoxsullaşar,","poem":1},{"lineBreak":true},{"text":"Yeyib-içib, məst olan cır-cındır içində qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Doğma atana qulaq as,","poem":1},{"lineBreak":true},{"text":"Qoca anana xor baxma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Həqiqət al, onu satma,","poem":1},{"lineBreak":true},{"text":"Hikməti, tərbiyəni, idrakı qoruyub-saxla.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Salehin atası bolluca fərəhlənəcək,","poem":1},{"lineBreak":true},{"text":"Hikmətlinin övladı onu sevindirəcək.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qoy ata-anan sevinsin,","poem":1},{"lineBreak":true},{"text":"Səni doğan fərəhlənsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Oğlum, ürəyini mənə yönəlt,","poem":1},{"lineBreak":true},{"text":"Gözlərin mənim yollarımı nəzərdən keçirsin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fahişə dərin bir çuxurdur,","poem":1},{"lineBreak":true},{"text":"Yad arvad dar quyudur.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Quldur kimi pusqu qurar,","poem":1},{"lineBreak":true},{"text":"İnsanlar arasında xainləri artırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kimdir yaslı?","poem":1},{"lineBreak":true},{"text":"Kimdir dərdli?","poem":1},{"lineBreak":true},{"text":"Kimin münaqişəsi var?","poem":1},{"lineBreak":true},{"text":"Kimin şikayəti var?","poem":1},{"lineBreak":true},{"text":"Kim boş yerə yaralandı?","poem":1},{"lineBreak":true},{"text":"Kimin gözləri qızarar?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Şərab içməyə oturub qalxmayan,","poem":1},{"lineBreak":true},{"text":"Gedib müxtəlif şərab dadanlar!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Şərabın al rənginə,","poem":1},{"lineBreak":true},{"text":"Qədəhdə parlamasına, rahat içilməsinə baxma.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Axırda ilan kimi sancar,","poem":1},{"lineBreak":true},{"text":"Əfi ilan kimi zəhərlər.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Gözlərinə qəribə şeylər görünər,","poem":1},{"lineBreak":true},{"text":"Qəlbinə əyri fikirlər gələr.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Özünü dənizin ortasında sanarsan,","poem":1},{"lineBreak":true},{"text":"Sanki gəmi dirəyinin başında yatmısan.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Deyərsən: «Məni vurublar, hiss etməmişəm,","poem":1},{"lineBreak":true},{"text":"Məni döyüblər, heç bilməmişəm.","poem":1},{"lineBreak":true},{"text":"Yenə içmək üçün nə zaman ayılacağam?»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}