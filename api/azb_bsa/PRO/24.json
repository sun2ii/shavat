{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Pis adamlara qibtə etmə,","poem":1},{"lineBreak":true},{"text":"Onlara qoşulmaq istəmə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki ürəklərində zalımlığı fikirləşər,","poem":1},{"lineBreak":true},{"text":"Dilləri qəddarlıqdan danışar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ev hikmətlə tikilər,","poem":1},{"lineBreak":true},{"text":"Dərrakə ilə möhkəmlənər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mənzillər bilik vasitəsilə,","poem":1},{"lineBreak":true},{"text":"Hər cür dəyərli, yaxşı şeylərlə dolar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hikmətli kişi qüvvətli olar,","poem":1},{"lineBreak":true},{"text":"Bilikli adam öz gücünü artırar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Düzgün məsləhətlə müharibə edə bilərsən,","poem":1},{"lineBreak":true},{"text":"Doğru nəsihət verən çoxdursa, qələbəyə çatarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Səfeh üçün hikmət əlçatmazdır,","poem":1},{"lineBreak":true},{"text":"Darvazada susub ağzını açmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Şər quran fitnəkar adlanar,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Səfehin pis əməlləri günah sayılar,","poem":1},{"lineBreak":true},{"text":"Rişxəndçilər insanlarda ikrah yaradar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dar gündə taqətdən düşsən,","poem":1},{"lineBreak":true},{"text":"Necə də zəif adamsan!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ölümə aparılanları qurtar,","poem":1},{"lineBreak":true},{"text":"Qırğın təhlükəsi altında olanları geri çək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Desən ki, bax bundan xəbərim yox idi,","poem":1},{"lineBreak":true},{"text":"Ürəkləri yoxlayan bunu görməzmi?","poem":1},{"lineBreak":true},{"text":"Canını qoruyan bunu bilməzmi?","poem":1},{"lineBreak":true},{"text":"İnsan əməlinə görə Ondan əvəz almazmı?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oğlum, bal ye, xeyri var,","poem":1},{"lineBreak":true},{"text":"Şanı balının şirin dadı damağında qalar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bil ki, hikmət də canın üçün belə olar,","poem":1},{"lineBreak":true},{"text":"Onu tapsan, nəticəsi də var,","poem":1},{"lineBreak":true},{"text":"Ümidin boşa çıxmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ey şər insan, salehin yurdu üçün pusqu qurma,","poem":1},{"lineBreak":true},{"text":"Onun evini soyma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Saleh yeddi dəfə yıxılsa belə, yenə qalxar,","poem":1},{"lineBreak":true},{"text":"Şər insan büdrəsə, bəlaya düçar olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Düşməninin yıxılmasına sevinmə,","poem":1},{"lineBreak":true},{"text":"Onun büdrəməsinə görə ürəyin fərəhlənməsin.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yoxsa Rəbb görər, bundan xoşu gəlməz,","poem":1},{"lineBreak":true},{"text":"Düşmənin üzərindən qəzəbini götürər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Pislik edənlərə görə qəzəblənmə,","poem":1},{"lineBreak":true},{"text":"Şər insanlara qibtə etmə,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Çünki pis insanın axırı yoxdur,","poem":1},{"lineBreak":true},{"text":"Şər adamın çırağı sönər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Oğlum, Rəbdən və padşahdan qorx,","poem":1},{"lineBreak":true},{"text":"Xəyanətkarlarla yoldaş olmaqdan çəkin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onların bəlası qəfildən gəlir.","poem":1},{"lineBreak":true},{"text":"Hər ikisinin verəcəyi cəzanı kim bilir?","poem":1}]},{"type":"heading","content":["Hikmətli sözlərin davamı"]},{"type":"verse","number":23,"content":[{"text":"Bu sözləri də hikmətlilər deyib:","poem":1},{"lineBreak":true},{"text":"Məhkəmədə tərəfkeşlik etmək yaxşı deyil.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pis insana «sən salehsən» deyəni xalqlar qınayar,","poem":1},{"lineBreak":true},{"text":"Ümmətlər lənət yağdırar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amma onu danlayanlar xeyir tapar,","poem":1},{"lineBreak":true},{"text":"Başlarından bol bərəkət yağar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"İnsana doğru cavab verən","poem":1},{"lineBreak":true},{"text":"Sanki onun üzündən öpər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Əvvəlcə çöldəki işini qurtar,","poem":1},{"lineBreak":true},{"text":"Zəmi sal, sonra evini tik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Qonşunun əleyhinə haqsız şahidlik etmə,","poem":1},{"lineBreak":true},{"text":"Qoy dilindən yalan söz çıxmasın.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Demə: «Mənə etdiyini mən də ona edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onun əməlinin əvəzini verəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tənbəlin zəmisindən,","poem":1},{"lineBreak":true},{"text":"Qanmazın üzümlüyündən keçdim.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Gördüm hər yanı tikan basıb,","poem":1},{"lineBreak":true},{"text":"Gicitkən bürüyüb, daşı-divarı uçub.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Baxaraq ona diqqət yetirdim,","poem":1},{"lineBreak":true},{"text":"Bundan ibrət götürdüm:","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Bir az da uzanıb yuxuya dalsan,","poem":1},{"lineBreak":true},{"text":"Əl-qolunu uzadaraq yatsan,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yoxsulluq üstünə soyğunçu kimi,","poem":1},{"lineBreak":true},{"text":"Ehtiyac üstünə quldur kimi hücum çəkər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}