{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["Süleymanın məsəllərinin davamı"]},{"type":"verse","number":1,"content":["Bunlar da Süleymanın məsəlləridir. Yəhuda padşahı Xizqiyanın adamları bir yerə yığılıb bunların üzünü köçürtdü."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Allahın işlərinin müəmması Onu şərəfləndirər,","poem":1},{"lineBreak":true},{"text":"Bu işləri aşkar etmək padşahlara şərəf gətirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Göyün yüksəkliyini, yerin dərinliyini,","poem":1},{"lineBreak":true},{"text":"Padşahın da qəlbindən keçənləri bilmək olmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tullantını gümüşdən ayırsan,","poem":1},{"lineBreak":true},{"text":"Zərgərə əl işi qalar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əgər şər adam padşahın yanından ayrılarsa,","poem":1},{"lineBreak":true},{"text":"Taxtı salehliklə möhkəmlənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Padşahın hüzurunda özünü ucaltma,","poem":1},{"lineBreak":true},{"text":"Rütbəlilərin yanında dayanma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki «buyur yuxarı» dəvətini almaq","poem":1},{"lineBreak":true},{"text":"Bir əsilzadə qarşısında aşağı endirilməkdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gördüyün şeylər barədə","poem":1},{"lineBreak":true},{"text":"Dava yaratmağa tələsmə.","poem":1},{"lineBreak":true},{"text":"Sonra qonşun səni utandırsa, nə edərsən?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Münaqişəni qonşunla özün həll et,","poem":1},{"lineBreak":true},{"text":"Özgənin sirrini açma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yoxsa hər eşidən sənə xor baxar,","poem":1},{"lineBreak":true},{"text":"Bu səni etibardan salar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yerində deyilən sözlər,","poem":1},{"lineBreak":true},{"text":"Gümüş oymalar içində qızıl almalara bənzər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sözəbaxan insana hikmətlinin məzəmməti","poem":1},{"lineBreak":true},{"text":"Qızıl sırğa, qızıl bəzək kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Biçin zamanı qar kimi sərinlik necədirsə,","poem":1},{"lineBreak":true},{"text":"Etibarlı elçi də onu göndərən üçün belədir.","poem":1},{"lineBreak":true},{"text":"O, ağasının ruhunu təzələyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kim ki vermədiyi bəxşişlərlə öyünür,","poem":1},{"lineBreak":true},{"text":"Yağışsız buluda və küləyə bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Səbirlə hökmdarı da inandırmaq olar,","poem":1},{"lineBreak":true},{"text":"Şirin dil sümükləri belə, yumşaldar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bal tapsan, lazımi qədər ye,","poem":1},{"lineBreak":true},{"text":"Acgözlüklə yesən, qusarsan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qonşunun evinə az-az get,","poem":1},{"lineBreak":true},{"text":"Yoxsa bezər, sənə nifrət edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kim ki qonşusuna qarşı yalandan şahidlik edir,","poem":1},{"lineBreak":true},{"text":"Toppuza, qılınca, iti oxa bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dar gündə namərdə bel bağlamaq","poem":1},{"lineBreak":true},{"text":"Çürük dişə, şikəst ayağa güvənməyə bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Qəlbi qubarlıya nəğmə söyləmək","poem":1},{"lineBreak":true},{"text":"Soyuq havada lüt qoyulmağa,","poem":1},{"lineBreak":true},{"text":"Soda üstə sirkə tökülməyə bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Düşmənin acdırsa, onu yedizdir,","poem":1},{"lineBreak":true},{"text":"Susuzdursa, ona su ver.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Belə etməklə sanki onun başına köz tökərsən,","poem":1},{"lineBreak":true},{"text":"Bunun əvəzini Rəbdən alarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Şimal küləyi yağış gətirir,","poem":1},{"lineBreak":true},{"text":"Qeybətçi dil isə insanın üzünə qəzəb gətirir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Davakar arvadla bir evdə yaşamaqdansa","poem":1},{"lineBreak":true},{"text":"Damın bir küncündə yaşamaq yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Susuzluqdan yanana sərin su necədirsə,","poem":1},{"lineBreak":true},{"text":"Uzaq diyardan gələn xoş xəbər də elədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Əgər saleh insan pis adama təslim olarsa,","poem":1},{"lineBreak":true},{"text":"Bulanan bulağa, murdarlanan quyuya bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Qədərindən çox bal yemək xeyirli olmadığı kimi","poem":1},{"lineBreak":true},{"text":"Tərifə uymaq da yaxşı deyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nəfsini saxlaya bilməyən","poem":1},{"lineBreak":true},{"text":"Dağılmış, hasarsız şəhərə bənzəyir.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}