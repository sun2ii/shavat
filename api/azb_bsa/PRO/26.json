{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Yay fəslinə qar, biçinə yağış yaraşmadığı kimi","poem":1},{"lineBreak":true},{"text":"Axmağa da şərəf yaraşmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sərçənin ora-bura uçduğu kimi,","poem":1},{"lineBreak":true},{"text":"Qaranquşun gəlib-getdiyi kimi","poem":1},{"lineBreak":true},{"text":"Nahaq qarğış da boşdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ata qamçı, eşşəyə noxta necə yaraşırsa,","poem":1},{"lineBreak":true},{"text":"Axmağın kürəyinə də kötək elə yaraşır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Axmağa səfehliyinə görə cavab vermə,","poem":1},{"lineBreak":true},{"text":"Yoxsa ona bənzərsən.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Axmağa səfehliyinə görə elə bir cavab ver ki,","poem":1},{"lineBreak":true},{"text":"Öz gözündə hikmətli görünməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kim ki axmaq vasitəsilə xəbər göndərir,","poem":1},{"lineBreak":true},{"text":"Öz ayaqlarını kəsib ziyan çəkənə bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Axmağın ağzından çıxan məsəl","poem":1},{"lineBreak":true},{"text":"Topalın ayağının axsamağına bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Axmağı tərifləmək","poem":1},{"lineBreak":true},{"text":"Sapanda qoyulan daşa bənzəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sərxoş tikanlı budağı əlində tutduğu kimi","poem":1},{"lineBreak":true},{"text":"Axmaq da məsəl çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Axmağı, hər yoldan ötəni muzdla tutan","poem":1},{"lineBreak":true},{"text":"Hamını yaralayan naşı oxatan kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hansı axmaq öz səfehliyini təkrarlayırsa,","poem":1},{"lineBreak":true},{"text":"Qusduğuna qayıdan itə oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Öz gözündə hikmətli sayılanı görmüsənmi?","poem":1},{"lineBreak":true},{"text":"Axmağa ondan artıq ümid var.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tənbəl deyər: «Yolda aslan var,","poem":1},{"lineBreak":true},{"text":"Şir küçələri dolanır».","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qapı öz oxu üstündə necə fırlanırsa,","poem":1},{"lineBreak":true},{"text":"Tənbəl də yatağında elə fırlanır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tənbəl əlini qabda olana batırar,","poem":1},{"lineBreak":true},{"text":"Ağzına aparmağa ərinər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tənbəl öz gözündə","poem":1},{"lineBreak":true},{"text":"Ağıllı cavab verən yeddi nəfərdən də çox hikmətli görünər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ona aid olmayan münaqişəyə qarışan","poem":1},{"lineBreak":true},{"text":"Elə bil küçədəki iti qulaqlarından tutur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Odlu, öldürücü oxlar atan dəli necədirsə,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Qonşusunu aldadıb «zarafat etdim» deyən də elədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Odun qurtaranda ocaq sönər,","poem":1},{"lineBreak":true},{"text":"Qeybətçi olmayan yerdə dava bitər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Necə ki kömür köz salar, odun alışar,","poem":1},{"lineBreak":true},{"text":"Davakar adam da münaqişəni bu cür alovlandırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Qeybətçinin sözləri şirin tikələrə bənzər,","poem":1},{"lineBreak":true},{"text":"Mədənin ən dərin yerlərinə düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hərarətli dili, şər dolu ürəyi olan insan","poem":1},{"lineBreak":true},{"text":"Gümüşü suya çəkilmiş saxsı qaba oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Düşmən kinini dili altında gizlədər,","poem":1},{"lineBreak":true},{"text":"Qəlbində hiyləsini saxlar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Onun mehriban danışığına inanma,","poem":1},{"lineBreak":true},{"text":"Qəlbinə yeddi cür iyrənclik doldurub.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nifrətini fırıldaqla gizlətsə də,","poem":1},{"lineBreak":true},{"text":"Şəri camaat qarşısında üzə çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Quyu qazan özü quyuya düşər,","poem":1},{"lineBreak":true},{"text":"Daş isə onu yuvarlayanın üstünə gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yalan danışan dil sancdığı adamlara nifrətini göstərər,","poem":1},{"lineBreak":true},{"text":"Yaltaqlanan ağız hər yanı xarabaya çevirər.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}