{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Şər insan onu qovan yox ikən qaçar,","poem":1},{"lineBreak":true},{"text":"Saleh aslan kimi mərd dayanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ölkədə üsyan olanda rəhbərlər artar,","poem":1},{"lineBreak":true},{"text":"Dərrakəli, işbilən adam olsa, ölkəni uzun müddət qoruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bir yoxsul kişi kasıbları incidərsə,","poem":1},{"lineBreak":true},{"text":"Bu, əkini yuyub aparan, qıtlıq yaradan güclü yağışa bənzər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Qanunu pozanlar pisi təriflər,","poem":1},{"lineBreak":true},{"text":"Qanuna əməl edənlər onlara qarşı çıxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pis insanlar nə bilir ki, ədalət nədir,","poem":1},{"lineBreak":true},{"text":"Rəbbi axtaranlar bunu dərk edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kamalla yaşayan yoxsul insan","poem":1},{"lineBreak":true},{"text":"Əyri yolla sərvət qazanandan yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Qanan oğul qanunu yerinə yetirər,","poem":1},{"lineBreak":true},{"text":"Qarınquluya qoşulan atasına xəcalət çəkdirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kim ki müamilə ilə, sələmlə var-dövlət yığar,","poem":1},{"lineBreak":true},{"text":"Onun varı axırda kasıblara səxavət göstərənə qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kim ki qanunu eşitməmək üçün qulaqlarını bağlayır,","poem":1},{"lineBreak":true},{"text":"Onun duaları iyrəncdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kim ki əməlisalehləri əyri yola çəkər,","poem":1},{"lineBreak":true},{"text":"Öz qazdığı quyuya düşər,","poem":1},{"lineBreak":true},{"text":"Kamillərə yaxşı şeylər irs qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zəngin özünü hikmətli sanar,","poem":1},{"lineBreak":true},{"text":"Amma müdrik kasıb onun qəlbini oxuyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Salehlərin zəfəri hamıya şərəf gətirər,","poem":1},{"lineBreak":true},{"text":"Amma pislər hakim olsa, hamı gizlənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Günahlarını ört-basdır edən uğur qazanmaz,","poem":1},{"lineBreak":true},{"text":"Onu etiraf edərək tərk edən mərhəmət tapar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Həmişə Rəbdən qorxan bəxtiyardır,","poem":1},{"lineBreak":true},{"text":"Ürəyi inadkar bəlaya düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kasıb xalqın üzərində olan pis hökmdar","poem":1},{"lineBreak":true},{"text":"Nərildəyən aslan, hücum edən ayıya oxşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dərrakəsiz hökmdar qəddar, zülmkar olar,","poem":1},{"lineBreak":true},{"text":"Haram qazanca nifrət edənin ömrü uzanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Qantökən qorxub məzara düşənədək qaçar.","poem":1},{"lineBreak":true},{"text":"Qoy heç kim ona kömək etməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kamillik yolu ilə gedən qurtular,","poem":1},{"lineBreak":true},{"text":"Əyri yolda olanlar qəflətən yıxılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Torpağını əkib-becərən doyunca çörək yeyər,","poem":1},{"lineBreak":true},{"text":"Boş şeylərin ardınca gedən müflisləşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Etibarlı insanın bərəkəti boldur,","poem":1},{"lineBreak":true},{"text":"Tez varlanmaq istəyən cəzasız qalmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tərəfkeşlik yaxşı deyil,","poem":1},{"lineBreak":true},{"text":"Kişi bir loğma çörək üçün günah işlədə bilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xəsis var-dövlət ardınca düşər,","poem":1},{"lineBreak":true},{"text":"Bilmədən yoxsulluğa yetişər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kim ki başqasını danlayır,","poem":1},{"lineBreak":true},{"text":"Yağlı dilə tutandan çox axırda o, lütf qazanır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ata-anasını soyub «günah deyildir» deyən","poem":1},{"lineBreak":true},{"text":"Qırıcı insana yoldaşdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tamahkar dava yaradar,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənən bolluğa çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Öz ağlına güvənən axmaqdır,","poem":1},{"lineBreak":true},{"text":"Hikmətlə gəzib-dolaşan azad olur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yoxsula əl tutan möhtac qalmır,","poem":1},{"lineBreak":true},{"text":"Ona məhəl qoymayan lənət qazanır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Pislər hakim olsa, hamı gizlənər,","poem":1},{"lineBreak":true},{"text":"Onlar yox olanda salehlər çoxalar.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}