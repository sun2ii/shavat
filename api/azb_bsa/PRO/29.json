{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Məzəmmətlərə baxmayıb dikbaşlıq edən","poem":1},{"lineBreak":true},{"text":"Birdən yıxılıb çarəsiz qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Salehlər artanda xalq sevinər,","poem":1},{"lineBreak":true},{"text":"Pis hökmdar olanda xalq nalə çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hikmət sevən atasını sevindirər,","poem":1},{"lineBreak":true},{"text":"Fahişələrə aşna olanın əlindən var-yoxu gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Padşah ölkəni ədalətlə möhkəmləndirər,","poem":1},{"lineBreak":true},{"text":"Ağır vergilər qoyansa ölkəni süqut etdirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bir kişi ki qonşusunu yağlı dilə tutur,","poem":1},{"lineBreak":true},{"text":"Onun addımları üçün tor qurur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pisin günahı özünə tələdir,","poem":1},{"lineBreak":true},{"text":"Saleh sevincindən haray çəkir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saleh kasıbların haqqını görür,","poem":1},{"lineBreak":true},{"text":"Pis adam bunu dərk etmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rişxəndçilər şəhəri çaxnaşdırar,","poem":1},{"lineBreak":true},{"text":"Hikmətlilər isə qəzəbi yatırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hikmətli səfehi məhkəməyə versə,","poem":1},{"lineBreak":true},{"text":"Səfeh coşub lağ edər, dinclik gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qana susayanlar kamil insana nifrət edər,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər can qurtarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Axmaq həddini aşıb özündən çıxar,","poem":1},{"lineBreak":true},{"text":"Hikmətli səbirli dayanar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hökmdar yalan sözə qulaq asarsa,","poem":1},{"lineBreak":true},{"text":"Bütün xidmətçiləri şər insana çevrilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yoxsul insan və zalım bir-birinə bir şeydə bənzəyir:","poem":1},{"lineBreak":true},{"text":"Hər ikisinin gözlərini işıqlandıran Rəbdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Padşah kasıblara həqiqətlə hökm versə,","poem":1},{"lineBreak":true},{"text":"Taxtı əbədi möhkəmlənər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kötək və məzəmmət hikmət gətirər,","poem":1},{"lineBreak":true},{"text":"Özbaşına qalan uşaq anasını rüsvay edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pislər çoxalanda cinayət artar,","poem":1},{"lineBreak":true},{"text":"Salehlər görəcək ki, onlar necə yıxılacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Oğluna tərbiyə ver ki, canın dinc olsun,","poem":1},{"lineBreak":true},{"text":"Könlün bundan ləzzət alsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"İlahi söz nazil olmayanda xalqda hərc-mərclik olar.","poem":1},{"lineBreak":true},{"text":"Qanuna əməl edən nə bəxtiyardır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Qula sözlə tərbiyə vermək olmaz,","poem":1},{"lineBreak":true},{"text":"Çünki başa düşsə belə, qulaq asmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Düşünmədən danışana baxmısanmı?","poem":1},{"lineBreak":true},{"text":"Axmağa ondan artıq ümid var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kim ərköyün qul böyütsə,","poem":1},{"lineBreak":true},{"text":"Axırda bu ona dərd verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Qəzəbli insan dava yaradar,","poem":1},{"lineBreak":true},{"text":"Kəmhövsələ günahı artırar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"İnsanı təkəbbürü alçaldar,","poem":1},{"lineBreak":true},{"text":"İtaətkar şərəfə çatar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Oğruya qoşulan öz-özünə düşməndir,","poem":1},{"lineBreak":true},{"text":"And içsə də, məhkəmədə həqiqəti söyləməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"İnsandan qorxan özünü tələyə salar,","poem":1},{"lineBreak":true},{"text":"Amma Rəbbə güvənən arxayın yaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Çoxu hökmdarın hüzurunu arzular,","poem":1},{"lineBreak":true},{"text":"Amma insan ədaləti Rəbdə tapar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Salehlər haqsızlardan,","poem":1},{"lineBreak":true},{"text":"Pis insanlarsa əməlisalehlərdən ikrah edər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}