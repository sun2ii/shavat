{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Rəbbə güvən"]},{"type":"verse","number":1,"content":[{"text":"Oğlum, təlimimi unutma,","poem":1},{"lineBreak":true},{"text":"Qoy qəlbin əmrlərimə bağlansın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onlar ömrünü uzadar,","poem":1},{"lineBreak":true},{"text":"Həyatına illər, firavanlıq artırar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qoy səni xeyirxahlıq və sədaqət tərk etməsin,","poem":1},{"lineBreak":true},{"text":"Onları boynuna bağla, ürəyinin lövhəsinə yaz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onda Allahın və insanların gözündə","poem":1},{"lineBreak":true},{"text":"Lütf tapıb şərəfə çatarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bütün qəlbinlə Rəbbə güvən,","poem":1},{"lineBreak":true},{"text":"Öz idrakına etibar etmə.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bütün yollarında Onu tanı,","poem":1},{"lineBreak":true},{"text":"O sənin yollarını düzəldər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Öz gözündə özünü hikmətli sanma,","poem":1},{"lineBreak":true},{"text":"Rəbdən qorx, şərdən çəkin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu, bədəninə şəfa verər,","poem":1},{"lineBreak":true},{"text":"Sümüklərinə ilik olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbbi var-dövlətinlə,","poem":1},{"lineBreak":true},{"text":"Məhsulunun nübarı ilə şərəfləndir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onda anbarların nemətlə dolar,","poem":1},{"lineBreak":true},{"text":"Şərab çənlərin təzə şərabla daşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Oğlum, Rəbbin verdiyi tərbiyəyə xor baxma,","poem":1},{"lineBreak":true},{"text":"Onun məzəmmətinə nifrət etmə.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ata sevdiyi oğlunu necə məzəmmət edərsə,","poem":1},{"lineBreak":true},{"text":"Rəbb də sevdiyini elə məzəmmət edər.","poem":1}]},{"type":"heading","content":["Hikmətin mədhi"]},{"type":"verse","number":13,"content":[{"text":"Hikmətə çatan,","poem":1},{"lineBreak":true},{"text":"Dərrakə tapan insan nə bəxtiyardır!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bunları qazanmaq gümüş qazanmaqdan yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Bu qazanc saf qızıldan dəyərlidir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hikmət yaqutlardan qiymətlidir,","poem":1},{"lineBreak":true},{"text":"Xoşladığın bütün şeylər ona tay deyil.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onun sağ əlində uzun ömür,","poem":1},{"lineBreak":true},{"text":"Sol əlində sərvət və şərəf var.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onun yolları bəyənilir,","poem":1},{"lineBreak":true},{"text":"Bütün yolları əmin-amandır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ona bağlananlar üçün o, həyat ağacıdır,","poem":1},{"lineBreak":true},{"text":"Ondan möhkəm yapışanlar nə bəxtiyardır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rəbb dünyanın təməlini hikmətlə qurub,","poem":1},{"lineBreak":true},{"text":"Dərrakə vasitəsilə göyləri bərqərar edib.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Biliyi ilə dərinliklər yarılıb,","poem":1},{"lineBreak":true},{"text":"Göylərdən şeh çilənir.","poem":1}]},{"type":"heading","content":["Qonşularla davranış"]},{"type":"verse","number":21,"content":[{"text":"Oğlum, sağlam şüura, dərrakəyə bağlan,","poem":1},{"lineBreak":true},{"text":"Bunlardan gözünü çəkmə.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onlar sənin həyatın olar,","poem":1},{"lineBreak":true},{"text":"Gözəl naxış kimi boynuna bağlanar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"O zaman rahat gəzərsən,","poem":1},{"lineBreak":true},{"text":"Ayaqların büdrəməz.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qorxusuz, rahat yatarsan,","poem":1},{"lineBreak":true},{"text":"Şirin yuxu taparsan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qəfil fəlakətdən,","poem":1},{"lineBreak":true},{"text":"Pislərə gələn bəladan qorxma.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Çünki güvəndiyin Rəbdir,","poem":1},{"lineBreak":true},{"text":"O qoymaz ki, sən tələyə düşəsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Əlindən yaxşılıq gəlirsə,","poem":1},{"lineBreak":true},{"text":"Buna layiq insanlardan əsirgəmə.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"İmkanın varsa, qonşuna demə:","poem":1},{"lineBreak":true},{"text":"«Sonra gələrsən, sabah verərəm».","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yanında sakit yaşayan qonşun üçün","poem":1},{"lineBreak":true},{"text":"Şər qurma.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sənə pislik etməyənlə","poem":1},{"lineBreak":true},{"text":"Nahaq yerə çəkişmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Zorakıya qibtə etmə,","poem":1},{"lineBreak":true},{"text":"O gedən yolların heç birini seçmə.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Çünki azğınlar Rəbdə ikrah yaradar,","poem":1},{"lineBreak":true},{"text":"Rəbb əməlisalehlərlə dost olar.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Rəbb pislərin ocağına lənət edər,","poem":1},{"lineBreak":true},{"text":"Salehlərin yurduna xeyir-dua verər.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Rəbb rişxəndçilərə istehza edər,","poem":1},{"lineBreak":true},{"text":"İtaətkarlara isə lütf göstərər.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Hikmətlilər şərəfi irs alacaq,","poem":1},{"lineBreak":true},{"text":"Axmağın nəsibi şərəfsizlik olacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}