{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Aqurun müdrik məsəlləri"]},{"type":"verse","number":1,"content":["Yaqe oğlu Aqurun sözləri, onun kəlamı.",{"text":"Bu adam Yetielə, Yetiel və Ukala belə dedi:","poem":1},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Həqiqətən, mən hamıdan ağılsızam,","poem":1},{"lineBreak":true},{"text":"İnsan idrakına malik deyiləm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nə hikmət öyrənmişəm,","poem":1},{"lineBreak":true},{"text":"Nə də Müqəddəsin biliyindən xəbərim var.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kim göylərə qalxıb endi?","poem":1},{"lineBreak":true},{"text":"Kim yeli ovcunda topladı?","poem":1},{"lineBreak":true},{"text":"Kim suları paltarına sarıdı?","poem":1},{"lineBreak":true},{"text":"Yer üzünün qurtaracağınadək hər yeri kim yaratdı?","poem":1},{"lineBreak":true},{"text":"Adı nədir? Oğlunun adı nədir?","poem":1},{"lineBreak":true},{"text":"Bilirsənmi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allahın hər bir kəlamı safdır,","poem":1},{"lineBreak":true},{"text":"Ona pənah gətirənlərin sipəri Odur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onun sözünə heç nəyi əlavə etmə,","poem":1},{"lineBreak":true},{"text":"Yoxsa səni tənbeh edər, yalanını çıxarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Allah, Səndən iki şey istəyirəm,","poem":1},{"lineBreak":true},{"text":"Nə qədər ömrüm var, məndən onları əsirgəmə:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Saxta, yalan sözlər qoy məndən uzaq olsun;","poem":1},{"lineBreak":true},{"text":"Məni nə yoxsul, nə də zəngin et,","poem":1},{"lineBreak":true},{"text":"Ancaq mənə gündəlik çörəyimi ver.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Varlansam, «Rəbb kimdir?» deyə Sənə küfr edərəm,","poem":1},{"lineBreak":true},{"text":"Yoxsul olsam, oğurlaram və Allahımın adını ləkələrəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qul barədə ağasına pis sözlər demə,","poem":1},{"lineBreak":true},{"text":"Yoxsa sənə qarğış edər, bu təqsirlə yüklənərsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Adam var ki, atasına qarğış edir,","poem":1},{"lineBreak":true},{"text":"Anasına alqış etmir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Adam var ki, özünü təmiz sanır,","poem":1},{"lineBreak":true},{"text":"Amma murdarlıqdan təmizlənməyib.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Adam var ki, yuxarıdan aşağı baxar,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlə baxmaq üçün gözlərini qaldırar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Adam var ki, dişləri qılınca bənzər,","poem":1},{"lineBreak":true},{"text":"Elə bil çənəsinə bıçaqlar düzüb,","poem":1},{"lineBreak":true},{"text":"Yer üzündən məzlumları udar,","poem":1},{"lineBreak":true},{"text":"İnsanların içindən fəqirləri məhv edər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zəlinin iki qızı var,","poem":1},{"lineBreak":true},{"text":"«Ver, ver» deyib bağırar.","poem":1},{"lineBreak":true},{"text":"Üç şey var ki, heç doymaz,","poem":1},{"lineBreak":true},{"text":"Dörd şey var ki, «bəsdir» deməz:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ölülər diyarı, qısır bətn,","poem":1},{"lineBreak":true},{"text":"Sudan doymayan torpaq,","poem":1},{"lineBreak":true},{"text":"«Bəsdir» deməyən alov.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kim ki atasına rişxənd edir,","poem":1},{"lineBreak":true},{"text":"Anasının sözünə xor baxır,","poem":1},{"lineBreak":true},{"text":"Dərələrdəki qarğalar onun gözlərini deşəcək,","poem":1},{"lineBreak":true},{"text":"Qartal balaları onun bəbəklərini yeyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mənim ağlım kəsməyən üç şey var,","poem":1},{"lineBreak":true},{"text":"Anlamadığım dörd şey var:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Səmada qartalın yolu,","poem":1},{"lineBreak":true},{"text":"Qayada ilanın yolu,","poem":1},{"lineBreak":true},{"text":"Dənizdə gəminin yolu,","poem":1},{"lineBreak":true},{"text":"Kişi ilə gənc qadının yolu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zinakar qadının da yolu belədir:","poem":1},{"lineBreak":true},{"text":"Yeyər, ağzını silər,","poem":1},{"lineBreak":true},{"text":"«Nə pis iş görmüşəm ki?» deyər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yer üç şeydən lərzəyə gəlir,","poem":1},{"lineBreak":true},{"text":"Dörd şey var ki, ona tab gətirmir:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qulun padşah olması,","poem":1},{"lineBreak":true},{"text":"Sarsağın doyunca çörək tapması,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nifrətəlayiq qadının ərə getməsi,","poem":1},{"lineBreak":true},{"text":"Qarabaşın öz xanımının yerinə keçməsi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yer üzündə dörd şey var,","poem":1},{"lineBreak":true},{"text":"Kiçik olsa da, hikməti çoxdur:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qarışqalar qüvvətli olmayan birlikdir,","poem":1},{"lineBreak":true},{"text":"Yemini yayda tədarük edir;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Qayadovşanları","poem":1},{"noteId":2},{"text":"da güclü olmayan birlikdir,","poem":1},{"lineBreak":true},{"text":"Evlərini qaya içində tikir;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Çəyirtkələrin şahı yoxdur,","poem":1},{"lineBreak":true},{"text":"Lakin hamısı dəstə-dəstə irəliləyir;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kərtənkələni əllə tutmaq olur,","poem":1},{"lineBreak":true},{"text":"Amma o, padşah saraylarına çıxır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Üç məxluq var ki, yerişi gözəldir,","poem":1},{"lineBreak":true},{"text":"Dörd məxluq var ki, gedişi gözəldir:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Heyvanların ən güclüsü,","poem":1},{"lineBreak":true},{"text":"Heç nəyin qarşısından geri dönməyən şir,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Döyüşkən xoruz, təkə,","poem":1},{"lineBreak":true},{"text":"Qoşun qabağına çıxan padşah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Əgər özünü ucaltmaqla sarsaqlıq etmisənsə,","poem":1},{"lineBreak":true},{"text":"Fikrində pis niyyətin varsa, əlinlə ağzını tut.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Çünki südü çalxalayanda yağ çıxdığı kimi,","poem":1},{"lineBreak":true},{"text":"Burnu sıxanda qan çıxdığı kimi","poem":1},{"lineBreak":true},{"text":"Qəzəbi qızışdıranda da dava yaranar.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Bu adam Yetielə, Yetiel və Ukala belə dedi – yaxud ey Allah, yorulmuşam, yorulub taqətdən düşmüşəm.","reference":{"chapter":30,"verse":1}},{"noteId":2,"caller":"+","text":"Qayadovşanı – ibrani dilində şafan adlanan məməli heyvan.","reference":{"chapter":30,"verse":26}}]},"thisChapterLink":"/api/azb_bsa/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}