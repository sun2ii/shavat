{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["Lemuel padşahın anasının sözləri"]},{"type":"verse","number":1,"content":["Lemuel padşahın sözləri, anasının ona öyrətdiyi kəlam."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nə deyim, oğlum, ey doğduğum oğul,","poem":1},{"lineBreak":true},{"text":"Nəzir-niyazla əldə etdiyim oğul?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gücünü qadınlara,","poem":1},{"lineBreak":true},{"text":"Yollarını padşahları məhvə aparanlara sərf etmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey Lemuel, şərab içmək padşahlara yaraşmaz,","poem":1},{"lineBreak":true},{"text":"Kefləndirici içkiyə aludə olmaq hökmdarlara yaraşmaz.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İçəndə qayda-qanunu unudarlar,","poem":1},{"lineBreak":true},{"text":"Bütün məzlumların haqqını pozarlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kefləndirici içkini düşkünə,","poem":1},{"lineBreak":true},{"text":"Şərabı dərdliyə verin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoy içib yoxsulluğunu unutsun,","poem":1},{"lineBreak":true},{"text":"Öz dərdini daha yada salmasın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dilsizə görə ağız aç,","poem":1},{"lineBreak":true},{"text":"Bütün möhtacların haqqını qoru.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ağzını aç, ədalətlə hökm ver,","poem":1},{"lineBreak":true},{"text":"Məzlumların, fəqirlərin haqqını yerinə yetir.","poem":1}]},{"type":"heading","content":["Xeyirxah arvad"]},{"type":"verse","number":10,"content":[{"text":"Xeyirxah arvad tapan kimdir?","poem":1},{"noteId":3},{"lineBreak":true},{"text":"O, yaqutlardan daha qiymətlidir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ərinin qəlbi ondan arxayındır,","poem":1},{"lineBreak":true},{"text":"Dayanmadan bərəkət qazanır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ömrü boyu ərinə pislik deyil, yaxşılıq gətirir,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yunu, kətanı tapıb seçir,","poem":1},{"lineBreak":true},{"text":"Əlindən hər iş zövqlə gəlir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ticarət gəmilərinə bənzəyir,","poem":1},{"lineBreak":true},{"text":"Uzaqlardan gələn ruzini gətirir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alaqaranlıqda yuxudan durur,","poem":1},{"lineBreak":true},{"text":"Ailəsinə yemək hazırlayır,","poem":1},{"lineBreak":true},{"text":"Kənizlərinə də paylayır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tarlaya baxandan sonra satın alır,","poem":1},{"lineBreak":true},{"text":"Əlinin zəhməti ilə bağ salır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Belini möhkəm bağlayır,","poem":1},{"lineBreak":true},{"text":"Qolları güc üstündən güc alır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ticarətin şirinliyindən dadır,","poem":1},{"lineBreak":true},{"text":"Bütün gecə boyu çırağı yanır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Əlləri ilə cəhrə əyirir,","poem":1},{"lineBreak":true},{"text":"İyini","poem":1},{"noteId":4},{"text":"bərkidir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Məzlumlar üçün əliaçıqdır,","poem":1},{"lineBreak":true},{"text":"Fəqirlərə əl tutur.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qar yağanda ailəsi üçün qayğısı olmaz,","poem":1},{"lineBreak":true},{"text":"Çünki hamısı qırmızı paltar geyinib.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yorğan-döşək üçün örtük toxuyur,","poem":1},{"lineBreak":true},{"text":"Öz libası tünd qırmızı incə kətandandır.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Əri şəhər darvazalarında yaxşı tanınır,","poem":1},{"lineBreak":true},{"text":"El ağsaqqalları ilə oturub-durur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qadın tacirlərə qurşaqları,","poem":1},{"lineBreak":true},{"text":"Toxuduğu kətan paltarları satır.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qüvvəyə, şərəfə bürünür,","poem":1},{"lineBreak":true},{"text":"Gələcək üzünə gülür.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ağzını açanda hikmət axır,","poem":1},{"lineBreak":true},{"text":"Dilindən sədaqət təlimi çıxır.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ailəsinin işini idarə edir,","poem":1},{"lineBreak":true},{"text":"Tənbələ layiq olan çörəyi yemir.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Övladları ayağa qalxıb onu alqışlayır,","poem":1},{"lineBreak":true},{"text":"Əri onu tərifləyir:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"«Xeyirxah qadınlar çoxdur,","poem":1},{"lineBreak":true},{"text":"Amma sənin tayın yoxdur».","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qadının məlahəti aldadıcı, gözəlliyi fanidir,","poem":1},{"lineBreak":true},{"text":"Yalnız Rəbdən qorxan qadın tərifə layiqdir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ona əlinin bəhrəsini verin,","poem":1},{"lineBreak":true},{"text":"Qoy şəhər darvazasında əməlləri ona tərif gətirsin.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Bu ayələr akrostix şəkildə yazılıb, yəni ayələr ibrani əlifbasının sırası ilə başlayır.","reference":{"chapter":31,"verse":10}},{"noteId":4,"caller":"+","text":"İy – cəhrənin sap dolanan düz çubuğu.","reference":{"chapter":31,"verse":19}}]},"thisChapterLink":"/api/azb_bsa/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}