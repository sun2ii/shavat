{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Hikmətin üstünlüyü"]},{"type":"verse","number":1,"content":[{"text":"Ey oğullar, atanızın verdiyi tərbiyə qulağınızda qalsın,","poem":1},{"lineBreak":true},{"text":"İdrakı dərk etmək üçün diqqətli olun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki sizə yaxşı dərs verirəm,","poem":1},{"lineBreak":true},{"text":"Təlimimi atmayın.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mən ata ocağında uşaq olanda,","poem":1},{"lineBreak":true},{"text":"Anamın yeganə balası olanda","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Atam mənə təlim verərək dedi:","poem":1},{"lineBreak":true},{"text":"«Qoy qəlbin sözümə möhkəm bağlansın,","poem":1},{"lineBreak":true},{"text":"Əmrlərimə əməl et ki, ömrün uzun olsun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hikmət qazan, idrak qazan,","poem":1},{"lineBreak":true},{"text":"Sözlərimi unutma, sözümdən çıxma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hikmətdən ayrılmasan, o səni qoruyar,","poem":1},{"lineBreak":true},{"text":"Əgər onu sevsən, səni saxlayar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hikmət hər şeydən üstündür, gərək onu qazanasan,","poem":1},{"lineBreak":true},{"text":"İdraka sahib olmaq üçün var-yoxunu verəsən.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onu üstün tutsan, səni ucaldar,","poem":1},{"lineBreak":true},{"text":"Əgər ona bağlansan, səni şərəfə çatdırar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O sənin başının gözəl çələngi olar,","poem":1},{"lineBreak":true},{"text":"Başına şərəf tacı qoyar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oğlum, məni dinlə,","poem":1},{"lineBreak":true},{"text":"Sözlərimi qəbul etsən, ömrünü uzadarsan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sənə hikmət yolunun təlimini verirəm,","poem":1},{"lineBreak":true},{"text":"Düz yolda gəzdirirəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gedəndə addımların büdrəməz,","poem":1},{"lineBreak":true},{"text":"Qaçanda ayaqların sürüşməz.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aldığın tərbiyəyə bağlan, ayrılma,","poem":1},{"lineBreak":true},{"text":"Onu saxla, o sənin həyatındır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pislərin yoluna ayaq basma,","poem":1},{"lineBreak":true},{"text":"Şər insanın yolu ilə getmə.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Çəkil, bu yolun yaxınından belə, keçmə,","poem":1},{"lineBreak":true},{"text":"Uzaq dur, başqa bir səmtdən yolu keç.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çünki şər adamlar pislik etməsələr,","poem":1},{"lineBreak":true},{"text":"Yata bilməzlər.","poem":1},{"lineBreak":true},{"text":"Kimisə yıxmasalar, yuxuları qaçar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Şərin çörəyini yeyərlər,","poem":1},{"lineBreak":true},{"text":"Zorakılığın şərabını içərlər.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Salehlərin yolu isə dan yeri tək şəfəq saçar,","poem":1},{"lineBreak":true},{"text":"Nurunu artıraraq gündüzə qovuşar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pislərinsə yolu zülmətdir,","poem":1},{"lineBreak":true},{"text":"Onlar nəyə görə büdrədiklərini bilməzlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Oğlum, sözlərimə fikir ver,","poem":1},{"lineBreak":true},{"text":"Dediklərimə qulaq as.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onları gözlərinin önündən ayırma,","poem":1},{"lineBreak":true},{"text":"Onları ürəyində qoru.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki onları tapanlar","poem":1},{"lineBreak":true},{"text":"Həyat və cansağlığı tapar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hər şeydən əvvəl öz ürəyini qoru,","poem":1},{"lineBreak":true},{"text":"Çünki həyat çeşməsi odur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Əyri danışığı ağzından götür,","poem":1},{"lineBreak":true},{"text":"Azğın dodaqları özündən uzaqlaşdır.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gözlərin irəliyə baxsın,","poem":1},{"lineBreak":true},{"text":"Düppədüz qarşına nəzər sal.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Getdiyin yolu düzəlt,","poem":1},{"lineBreak":true},{"text":"Yollarını sahmana sal.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nə sağa, nə də sola dön,","poem":1},{"lineBreak":true},{"text":"Ayağını pislikdən çək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}