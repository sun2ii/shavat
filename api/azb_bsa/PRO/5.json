{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Əxlaqsızlıqdan uzaqlaş"]},{"type":"verse","number":1,"content":[{"text":"Oğlum, mənim hikmətimə diqqət yetir,","poem":1},{"lineBreak":true},{"text":"Qulağını müdrik sözlərimə tərəf çevir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onda dərrakəyə bağlanarsan,","poem":1},{"lineBreak":true},{"text":"Dilin biliyi kənara atmaz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əxlaqsız qadının dodağından sanki bal axır,","poem":1},{"lineBreak":true},{"text":"Dili şirin, yağdan yumşaqdır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma aqibəti yovşan kimi acıdır,","poem":1},{"lineBreak":true},{"text":"İkiağızlı qılınc kimi kəskindir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onun ayaqları ölümə aparır,","poem":1},{"lineBreak":true},{"text":"Onun addımları ölülər diyarına çatır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Həyat yoluna fikir vermir,","poem":1},{"lineBreak":true},{"text":"Yolları dolaşıqdır, özü də bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"İndi, ey övladlar, mənə qulaq asın,","poem":1},{"lineBreak":true},{"text":"Dilimdən çıxan sözlərdən yayınmayın.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Belə qadından uzaq ol,","poem":1},{"lineBreak":true},{"text":"Evinin qapısına yaxın getmə.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yoxsa şərəfini yadlara verərsən,","poem":1},{"lineBreak":true},{"text":"Ömrünü zalımlara sərf edərsən.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sənin var-yoxunu yadlar yeyər,","poem":1},{"lineBreak":true},{"text":"Qazancın özgənin evinə gedər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ömrünün sonu çatanda,","poem":1},{"lineBreak":true},{"text":"Canında taqət qalmayanda","poem":1},{"lineBreak":true},{"text":"Ah-nalə çəkərək belə deyərsən:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«Mən də tərbiyəyə nifrət etdim,","poem":1},{"lineBreak":true},{"text":"Ürəyimdə məzəmmətlərə güldüm!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Müəllimimin sözünə baxmadım,","poem":1},{"lineBreak":true},{"text":"Tərbiyəçilərimə qulaq asmadım.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Camaatın və icmanın arasında","poem":1},{"lineBreak":true},{"text":"Az qala hər cür bəlaya düşəcəkdim».","poem":1}]},{"type":"heading","content":["Arvadına vəfalı ol"]},{"type":"verse","number":15,"content":[{"text":"Öz su anbarından,","poem":1},{"lineBreak":true},{"text":"Öz quyunun içməli suyundan iç.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Niyə sənin qaynaqların küçələrə,","poem":1},{"lineBreak":true},{"text":"Su arxların meydanlara axıb getsin?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onlar yalnız səninki olsun,","poem":1},{"lineBreak":true},{"text":"Yadlara paylama.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qoy çeşmən bərəkətli olsun,","poem":1},{"lineBreak":true},{"text":"Gənc ikən evləndiyin arvadınla xoşbəxt yaşa!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sevimli maralın, gözəl ceyranın","poem":1},{"lineBreak":true},{"text":"Həmişə səni öz döşləri ilə doydursun,","poem":1},{"lineBreak":true},{"text":"Onun eşqi ilə məst ol.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Oğlum, niyə əxlaqsız qadınla məst olmalısan,","poem":1},{"lineBreak":true},{"text":"Yad arvadı qoynuna almalısan?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"İnsanların yolları Rəbbin gözü qarşısındadır,","poem":1},{"lineBreak":true},{"text":"Onların hər addımlarını yoxlayır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Şər insan öz təqsirlərinə görə tutular,","poem":1},{"lineBreak":true},{"text":"Günahının kəməndinə dolanar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tərbiyəsizliyi üzündən həlak olar,","poem":1},{"lineBreak":true},{"text":"Hədsiz səfehliyi üzündən azar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}