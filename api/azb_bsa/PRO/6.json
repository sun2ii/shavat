{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Tələlərdən ehtiyatlı ol"]},{"type":"verse","number":1,"content":[{"text":"Oğlum, qonşuna zamin durub,","poem":1},{"lineBreak":true},{"text":"Yadlarla əlbir olub,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ağzından çıxan sözlərlə tələyə düşmüsənsə,","poem":1},{"lineBreak":true},{"text":"Ağzından çıxan sözlərlə ələ keçmisənsə,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Demək bu qonşunun əlinə düşmüsən.","poem":1},{"lineBreak":true},{"text":"Oğlum, çalış, özünü qurtar:","poem":1},{"lineBreak":true},{"text":"Get onun ayağına düş, yalvar-yaxar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoy gözünə yuxu getməsin,","poem":1},{"lineBreak":true},{"text":"Kirpiklərin ağırlaşmasın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Özünü ovçunun əlindən ceyran kimi,","poem":1},{"lineBreak":true},{"text":"Quşbazın əlindən quş kimi qurtar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey tənbəl, qarışqalara diqqət yetir,","poem":1},{"lineBreak":true},{"text":"Onların həyatından ibrət götür.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların nə başçıları var,","poem":1},{"lineBreak":true},{"text":"Nə nəzarətçiləri, nə də hökmdarları.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yayda azuqələrini yığar,","poem":1},{"lineBreak":true},{"text":"Biçin vaxtı özlərinə yem toplayarlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey tənbəl, nə qədər yatacaqsan?","poem":1},{"lineBreak":true},{"text":"Nə vaxt yuxudan oyanacaqsan?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bir az da uzanıb yuxuya dalsan,","poem":1},{"lineBreak":true},{"text":"Əl-qolunu uzadaraq yatsan,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yoxsulluq soyğunçu kimi üstünə gələr,","poem":1},{"lineBreak":true},{"text":"Ehtiyac quldur kimi sənə hücum çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaramaz adam – şər insan","poem":1},{"lineBreak":true},{"text":"Əyri danışaraq dolanar,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Göz vurar, ayaqları ilə işarə edər,","poem":1},{"lineBreak":true},{"text":"Barmaqları ilə göstərər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qəlbinin məkrli niyyəti var,","poem":1},{"lineBreak":true},{"text":"Həmişə şər qurar, nifaq salar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ona görə başına qəfildən bəla gələr,","poem":1},{"lineBreak":true},{"text":"Birdən yıxılıb çarəsiz qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbbin zəhləsi altı şeydən gedir,","poem":1},{"lineBreak":true},{"text":"Yeddi şey var, ondan ikrah edir:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Təkəbbürlə baxan gözlər;","poem":1},{"lineBreak":true},{"text":"Yalan danışan dil;","poem":1},{"lineBreak":true},{"text":"Nahaq qan tökən əllər;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Məqsədi şər olan ürək;","poem":1},{"lineBreak":true},{"text":"Şərə çatmaq üçün qaçan ayaqlar;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nəfəsini yalanla çıxaran yalançı şahid;","poem":1},{"lineBreak":true},{"text":"Qardaşlar arasında nifaq salan şəxs.","poem":1}]},{"type":"heading","content":["Zinaya qarşı xəbərdarlıq"]},{"type":"verse","number":20,"content":[{"text":"Oğlum, atanın əmrini yerinə yetir,","poem":1},{"lineBreak":true},{"text":"Ananın öyrətdiklərini atma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onları qəlbinin başına yapışdır,","poem":1},{"lineBreak":true},{"text":"Həmişə onları boynuna bağla.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gəzəndə onlar sənə yol göstərər,","poem":1},{"lineBreak":true},{"text":"Yatanda səni hifz edər,","poem":1},{"lineBreak":true},{"text":"Oyananda sənə məsləhət verər.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bu əmr çıraqdır, bu təlim nurdur,","poem":1},{"lineBreak":true},{"text":"Tərbiyə üçün edilən məzəmmət həyat yoludur.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bunlar səni pozğun qadından,","poem":1},{"lineBreak":true},{"text":"Şirindilli yad arvaddan qoruyar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Onun gözəlliyinə aşiq olma,","poem":1},{"lineBreak":true},{"text":"Onun kirpiklərinin əsiri olma.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fahişənin üzündən insan bir tikə çörəyə möhtac qalar,","poem":1},{"lineBreak":true},{"text":"Kiminsə zinakar arvadı insanın qiymətli canını ovlar.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bir kişi qoynuna od alanda","poem":1},{"lineBreak":true},{"text":"Əyin-başı yanmazmı?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Köz üzərində gəzənin","poem":1},{"lineBreak":true},{"text":"Ayaqları bişməzmi?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Qonşusunun arvadının yanına girənin də halı belədir,","poem":1},{"lineBreak":true},{"text":"O qadına toxunan cəzasını çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Qarnını doydurmaq üçün ac oğru oğurlarsa,","poem":1},{"lineBreak":true},{"text":"Kimsə onu qınamaz.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Amma onu tutsalar, yeddi qat ödəməlidir,","poem":1},{"lineBreak":true},{"text":"Evinin var-yoxunu verməlidir.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Qadınla zina edən qanmazdır,","poem":1},{"lineBreak":true},{"text":"Özünü məhv etmək istəyən belə edər.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Bu kişinin nəsibi kötək, şərəfsizlikdir,","poem":1},{"lineBreak":true},{"text":"Biabırçılığı üzərindən silinməz.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Çünki ərini qeyrət coşdurar,","poem":1},{"lineBreak":true},{"text":"Ondan amansızcasına qisas alar.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Heç nə ilə ərinin qarşısını almaq olmaz,","poem":1},{"lineBreak":true},{"text":"Nə verilsə belə, o razılaşmaz.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}