{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Əxlaqsız qadının hiyləsi"]},{"type":"verse","number":1,"content":[{"text":"Oğlum, sözlərimə bağlı qal,","poem":1},{"lineBreak":true},{"text":"Əmrlərimi özündə saxla.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Əmrlərimə bağlı qalsan, yaşayacaqsan,","poem":1},{"lineBreak":true},{"text":"Təlimimi göz bəbəyin kimi qoru.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onları üzük kimi barmağına keçir,","poem":1},{"lineBreak":true},{"text":"Ürəyinin lövhəsinə köçür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hikmətə de: «Bacımsan»,","poem":1},{"lineBreak":true},{"text":"İdraka söylə: «Yaxın dostumsan».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlar səni əxlaqsız qadından,","poem":1},{"lineBreak":true},{"text":"Şirindilli yad arvaddan qoruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Evimin pəncərəsinin şəbəkəsindən","poem":1},{"lineBreak":true},{"text":"Mən bayıra baxırdım.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bir dəstə cahil gənc arasında","poem":1},{"lineBreak":true},{"text":"Qanmaz bir cavanı gördüm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu qadının evinin tininə yaxın küçədən keçirdi,","poem":1},{"lineBreak":true},{"text":"Onun evi olan yolla gedirdi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alaqaranlıqda, gün batanda,","poem":1},{"lineBreak":true},{"text":"Gecə düşəndə, hava qaralanda.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fahişə libaslı, qəlbi fitnə dolu bu qadın","poem":1},{"lineBreak":true},{"text":"Dərhal onu qarşıladı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O hay-küyçüdür, o bihəyadır,","poem":1},{"lineBreak":true},{"text":"Öz evində oturmayandır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gah küçəyə, gah meydanlara çıxar,","poem":1},{"lineBreak":true},{"text":"Hər tin başı bir pusqu qurar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O, oğlanı tutub öpdü,","poem":1},{"lineBreak":true},{"text":"Həyasızcasına belə dedi:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"«Ünsiyyət qurbanı kəsməyə borclu idim,","poem":1},{"lineBreak":true},{"text":"Əhdimə bu gün əməl etmişəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ona görə səni görmək üçün qarşına çıxdım,","poem":1},{"lineBreak":true},{"text":"Səni çox axtardım, axır ki tapdım.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yatağıma Misir kətanından toxunan","poem":1},{"lineBreak":true},{"text":"Əlvan üz çəkmişəm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yorğan-döşəyimə","poem":1},{"lineBreak":true},{"text":"Mirra, əzvay, darçın səpmişəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gəl sübhə qədər doyunca sevişək,","poem":1},{"lineBreak":true},{"text":"Eşqdən məst olaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ərim evdə yoxdur,","poem":1},{"lineBreak":true},{"text":"Uzaq bir səfərə gedib.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pul kisəsini götürüb,","poem":1},{"lineBreak":true},{"text":"Evə ay bədirlənəndə qayıdacaq».","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fəndlər işlədib onu tovladı,","poem":1},{"lineBreak":true},{"text":"Şirin dilə tutub yoldan çıxartdı.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kəsilməyə aparılan bir öküz kimi,","poem":1},{"lineBreak":true},{"text":"Kəməndə salınan bir maral kimi","poem":1},{"lineBreak":true},{"text":"Bu oğlan o qadının ardınca düşdü.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Axırda ciyərinə bir ox saplanacaq.","poem":1},{"lineBreak":true},{"text":"Uçub tez tora düşən quş kimi","poem":1},{"lineBreak":true},{"text":"Bu oğlan da canının alınacağını bilmirdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"İndi, ey övladlar, mənə qulaq asın,","poem":1},{"lineBreak":true},{"text":"Dilimdən çıxan sözlərə laqeyd olmayın.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qoyma qəlbin o qadının yollarına meyl etsin,","poem":1},{"lineBreak":true},{"text":"Onun yoluna dönmə.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Çünki o qadın nə qədər insanı qurban edib,","poem":1},{"lineBreak":true},{"text":"Nə qədər adamı öldürüb.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Onun evinin yolu ölülər diyarına aparır,","poem":1},{"lineBreak":true},{"text":"Ölüm mənzilinə gedib çatır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}