{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Hikmətin nitqi"]},{"type":"verse","number":1,"content":[{"text":"Məgər hikmət çağırmırmı,","poem":1},{"lineBreak":true},{"text":"Məgər dərrakə səsləmirmi","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uca yerlərdə, yol kənarında,","poem":1},{"lineBreak":true},{"text":"Yollar ayrıcında dayanıb?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Darvazaların yanında, şəhərin qarşısında,","poem":1},{"lineBreak":true},{"text":"Qapıların kandarında çağırır:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Ey insanlar, mən sizi səsləyirəm,","poem":1},{"lineBreak":true},{"text":"Ey bəşər övladları, sizə xitab edirəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey cahillər, uzaqgörən olun,","poem":1},{"lineBreak":true},{"text":"Ey axmaqlar, ağıllanın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dinləyin, əla şeylərdən danışıram,","poem":1},{"lineBreak":true},{"text":"Dilimdən düz sözlər çıxır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ağzım həqiqət söyləyir,","poem":1},{"lineBreak":true},{"text":"Dilim şərdən iyrənir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ağzımdan yalnız salehlik sözləri çıxır,","poem":1},{"lineBreak":true},{"text":"Sözlərimdə nə əyrilik, nə də ki yalan var.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anlayanlar üçün hər şey aydındır,","poem":1},{"lineBreak":true},{"text":"Bilik qazananlar üçün bu bir həqiqətdir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gümüşü yox, tərbiyəmi qəbul edin,","poem":1},{"lineBreak":true},{"text":"Saf qızıldan çox biliyi seçin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki hikmət yaqutdan qiymətlidir,","poem":1},{"lineBreak":true},{"text":"İnsanın könlü istəyən şeylər ona tay deyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mən hikmətəm, uzaqgörənlik məndə məskən salıb,","poem":1},{"lineBreak":true},{"text":"Biliyi, dərrakəni tapmışam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb qorxusu pisliyə nifrət etməkdir,","poem":1},{"lineBreak":true},{"text":"Lovğalığa, təkəbbürə, pis yola,","poem":1},{"lineBreak":true},{"text":"Hiyləli dilə nifrət edərəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nəsihət, sağlam şüur mənimdir,","poem":1},{"lineBreak":true},{"text":"İdrak mənəm, qüvvəm var.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mənim vasitəmlə şahlar hökmranlıq edir,","poem":1},{"lineBreak":true},{"text":"Hökmdarlar ədalətli fərman verir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ədalətli hakim olan bütün başçılar və əsilzadələr","poem":1},{"lineBreak":true},{"text":"Mənim vasitəmlə hökm verir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Məni sevənləri sevirəm,","poem":1},{"lineBreak":true},{"text":"Məni səylə axtaran tapır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sərvət və şərəf,","poem":1},{"lineBreak":true},{"text":"Dağılmaz var-dövlət və salehlik yanımdadır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Barım qızıldan, saf qızıldan dəyərlidir,","poem":1},{"lineBreak":true},{"text":"Bəhərim gümüşdən qiymətlidir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mən salehlik yolunda,","poem":1},{"lineBreak":true},{"text":"Ədalət yollarının ortasında gəzərəm.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Məni sevənləri sərvətə çatdıraram,","poem":1},{"lineBreak":true},{"text":"Xəzinələrini dolduraram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rəbb Öz yolunun başlanğıcında,","poem":1},{"lineBreak":true},{"text":"Hər işindən əvvəl mənə malik oldu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yaradılışın əzəlindən,","poem":1},{"lineBreak":true},{"text":"Dünya yaranmazdan əvvəl mən var idim.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dərin sular olmazdan əvvəl,","poem":1},{"lineBreak":true},{"text":"Bol sulu çeşmələr olmazdan əvvəl doğulmuşam.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dağlar yaradılmazdan əvvəl,","poem":1},{"lineBreak":true},{"text":"Təpələr mövcud olmazdan əvvəl təvəllüd tapmışam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Rəbb dünyanı, çölü-düzü, torpaqları yaradanda,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Göyləri yaradanda,","poem":1},{"lineBreak":true},{"text":"Dərinliyin üzü üstündə bir dairə çəkəndə,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Buludları yuxarıda yerləşdirəndə,","poem":1},{"lineBreak":true},{"text":"Dərinlikdə bulaqları bağlayanda,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sular əmrindən çıxmasın deyə dənizə sədd çəkəndə,","poem":1},{"lineBreak":true},{"text":"Yerin bünövrələrini təyin edəndə","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Rəbbin yanında memar idim.","poem":1},{"lineBreak":true},{"text":"Hər gün fərəhlənirdim,","poem":1},{"lineBreak":true},{"text":"Hüzurunda həmişə sevinirdim.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yaratdığı aləmə görə sevinirdim,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına görə fərəhlənirdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"İndi, ey övladlar, mənə qulaq asın:","poem":1},{"lineBreak":true},{"text":"Yoluma bağlı qalan nə bəxtiyardır!","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Verdiyim tərbiyəyə qulaq asın,","poem":1},{"lineBreak":true},{"text":"Hikmət alın, onu bir tərəfə atmayın.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mənə qulaq asan,","poem":1},{"lineBreak":true},{"text":"Hər gün darvazalarım qarşısında duran,","poem":1},{"lineBreak":true},{"text":"Qapılarımda dayanıb gözləyən nə bəxtiyardır!","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Çünki məni tapan həyat tapar,","poem":1},{"lineBreak":true},{"text":"Rəbbi razı salar.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Məni əldən verən canına qəsd edər,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edənlərin hamısı ölümü sevər».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}