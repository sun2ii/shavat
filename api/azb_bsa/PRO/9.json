{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PRO","translationId":"azb_bsa","name":"SÜLEYMANIN MƏSƏLLƏRİ","commonName":"SÜLEYMANIN MƏSƏLLƏRİ","title":"SÜLEYMANIN MƏSƏLLƏRİ","order":20,"numberOfChapters":31,"sha256":"6f8f8f7a73c1f613d0772fa17cf125a1bffef1f977e59f163742804344d471e9","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/azb_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Hikmət yolu"]},{"type":"verse","number":1,"content":[{"text":"Hikmət evini qurub,","poem":1},{"lineBreak":true},{"text":"Yeddi dirəyini yonub,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heyvanlarını kəsib,","poem":1},{"lineBreak":true},{"text":"Şərabını hazırlayıb,","poem":1},{"lineBreak":true},{"text":"Süfrəsini də düzəldib.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Göndərdiyi kənizlər","poem":1},{"lineBreak":true},{"text":"Şəhərin uca yerlərindən car çəkərlər:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Gəlin bura, ey cahillər!»","poem":1},{"lineBreak":true},{"text":"Qanmazlara belə deyərlər:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«Gəlin, çörəyimdən yeyin,","poem":1},{"lineBreak":true},{"text":"Hazırladığım şərabdan için.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cəhaləti atın, ömür sürün,","poem":1},{"lineBreak":true},{"text":"İdrak yolu ilə düz gedin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rişxəndçini tənqid edən özünü rüsvayçılığa salar,","poem":1},{"lineBreak":true},{"text":"Şər adamı danlayan axırda ləkələnər.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rişxəndçini danlama, yoxsa sənə nifrət edər,","poem":1},{"lineBreak":true},{"text":"Müdrik insanı danlasan, səni sevər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hikmətliyə öyüd versən, hikmətini artıracaq,","poem":1},{"lineBreak":true},{"text":"Salehə bilik öyrətsən, müdrikliyini çoxaldacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbb qorxusu hikmətin başlanğıcıdır,","poem":1},{"lineBreak":true},{"text":"Müqəddəsi tanımaq idraklı olmaqdır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hikmətin vasitəsilə ömrün-günün çoxalar,","poem":1},{"lineBreak":true},{"text":"Həyatına illər əlavə olar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əgər hikmət qazansan, özünə xeyir verərsən,","poem":1},{"lineBreak":true},{"text":"Əgər rişxənd etsən, zərərini özün çəkərsən.","poem":1}]},{"type":"heading","content":["Axmaqlıq yolu"]},{"type":"verse","number":13,"content":[{"text":"Axmaq qadın hay-küy salır,","poem":1},{"lineBreak":true},{"text":"Cahildir, heç nə qanmır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O, evinin qapısı önündə oturub,","poem":1},{"lineBreak":true},{"text":"Şəhərin uca yerlərində kətil üstə əyləşib,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yoldan ötənləri,","poem":1},{"lineBreak":true},{"text":"Düz yolda olanları çağırır:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Bura gəlin, ey cahillər!»","poem":1},{"lineBreak":true},{"text":"Qanmazlara belə deyir:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Oğurluq su şirin olar,","poem":1},{"lineBreak":true},{"text":"Gizli yeyilən çörəyin başqa ləzzəti var».","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lakin yanına gələnlər bilməzlər ki,","poem":1},{"lineBreak":true},{"text":"Orada ölüm var,","poem":1},{"lineBreak":true},{"text":"Bu qadının çağırdıqları ölülər diyarının dərinliyindədir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}