{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"heading","content":["Məzmur 10"]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, nə üçün uzaqda durmusan?","poem":1},{"lineBreak":true},{"text":"Mən dara düşəndə niyə gizlənirsən?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pislər təkəbbürlə məzlumları təqib edir,","poem":1},{"lineBreak":true},{"text":"Öz qurduqları fəndlərə özləri düşür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pis insan könlünün istəkləri ilə fəxr edir,","poem":1},{"lineBreak":true},{"text":"Acgöz Rəbbə xor baxır, Ona küfr edir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Təkəbbürlü, pis insan Allahı axtarmaz,","poem":1},{"lineBreak":true},{"text":"«Allah yoxdur» deyə düşünər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Belə insan həmişə uğur qazanar,","poem":1},{"lineBreak":true},{"text":"Bütün düşmənlərinə xor baxar.","poem":1},{"lineBreak":true},{"text":"Sənin hökmlərinsə onun dərrakəsindən çox uzaqdır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ürəyində deyir: «Sarsılmaram,","poem":1},{"lineBreak":true},{"text":"Heç zaman fəlakətə düşmərəm».","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onun ağzı lənətlə, hiylə ilə, hədə ilə doludur,","poem":1},{"lineBreak":true},{"text":"Dilinin altında zülm və şər var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kəndlərdə pusqu yerlərini qurar,","poem":1},{"lineBreak":true},{"text":"Günahsızları xəlvətcə öldürər.","poem":1},{"lineBreak":true},{"text":"Biçarəyə göz qoyub gizlicə güdər,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yuvasında oturmuş aslan kimi gizli yerdə pusqu qurar,","poem":1},{"lineBreak":true},{"text":"Məzlumu tutmaq üçün güdər,","poem":1},{"lineBreak":true},{"text":"Toruna salıb onu tutar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Biçarələrin başından basıb qəddini qırar,","poem":1},{"lineBreak":true},{"text":"Onlar bu pis adamın əlindən yıxılar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pis adam belə düşünər:","poem":1},{"lineBreak":true},{"text":"«Allah məni yaddan çıxarıb,","poem":1},{"lineBreak":true},{"text":"Heç vaxt görməz, çünki mənə göz yumub».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ya Rəbb, qalx, ey Allah, onlara əl qaldır!","poem":1},{"lineBreak":true},{"text":"Unutma məzlumları!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Niyə pis insan Allaha küfr etsin?","poem":1},{"lineBreak":true},{"text":"Niyə ürəyində «məndən əvəzini çıxmaz» desin?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Amma Sən bu əzab-əziyyətə baxırsan,","poem":1},{"lineBreak":true},{"text":"Məzluma kömək əlini uzadırsan.","poem":1},{"lineBreak":true},{"text":"Biçarə özünü Sənə tapşırar,","poem":1},{"lineBreak":true},{"text":"Yetimlərin imdadı Sənsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Şər iş görənin, pis insanın qol-qanadını qır,","poem":1},{"lineBreak":true},{"text":"Axıracan pisliklərini ifşa et.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb sonsuzadək, əbədi padşahdır!","poem":1},{"lineBreak":true},{"text":"Onun diyarından millətlər yox olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ya Rəbb, məzlumların səsini eşidəcəksən,","poem":1},{"lineBreak":true},{"text":"Onları ürəkləndirib diqqət yetirəcəksən.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yetimə, fəqirə ədalət göstərəcəksən;","poem":1},{"lineBreak":true},{"text":"Belə ki torpaqdan yaradılan insan","poem":1},{"lineBreak":true},{"text":"Bir daha təhlükə yaratmasın.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}