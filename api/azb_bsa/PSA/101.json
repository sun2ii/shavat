er":5,"content":[{"lineBreak":true},{"text":"Qonşusuna gizlincə böhtan atanı susduracağam,","poem":1},{"lineBreak":true},{"text":"Yuxarıdan baxan lovğa insana dözə bilmərəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gözüm ölkənin sadiq insanlarına baxar,","poem":1},{"lineBreak":true},{"text":"Qoy onlar yanımda yaşasın.","poem":1},{"lineBreak":true},{"text":"Kamillik yolu ilə gedənlər qulluğumda dayanar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fırıldaqçıları sarayımda yaşamağa qoymaram,","poem":1},{"lineBreak":true},{"text":"Yalançını hüzurumda dayanmağa qoymaram.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hər səhər ölkədəki pisləri yox edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün şər iş görənləri Rəbbin şəhərindən kəsib atacağam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}