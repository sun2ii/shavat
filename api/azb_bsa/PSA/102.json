{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"heading","content":["Məzmur 102"]},{"type":"hebrew_subtitle","content":["Bir məzlumun duası."]},{"type":"hebrew_subtitle","content":["Taqətdən düşüb Rəbbin hüzurunda şikayətlənəndə."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, bu duama qulaq as,","poem":1},{"lineBreak":true},{"text":"Qoy fəryadım Sənə çatsın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nə olar, dar günümdə üzünü məndən gizlətmə,","poem":1},{"lineBreak":true},{"text":"Qulaq as, Səni çağırarkən mənə tez cavab ver.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Günlərim tüstü kimi çəkilir,","poem":1},{"lineBreak":true},{"text":"Sümüklərim elə bil yanıb közə dönür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ürəyim kəsilib atılan ot kimi saralıb-solur,","poem":1},{"lineBreak":true},{"text":"Çörək yemək belə, yadımdan çıxır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ah-zar çəkməkdən","poem":1},{"lineBreak":true},{"text":"Bir dəri, bir sümük qalmışam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"İndi çöldəki yapalağa bənzəyirəm,","poem":1},{"lineBreak":true},{"text":"Viranəlik bayquşu kimiyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gözümə yuxu getmir,","poem":1},{"lineBreak":true},{"text":"Damda tənha qalan bir quşa bənzəyirəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütün gün düşmənlərim məni təhqir edir,","poem":1},{"lineBreak":true},{"text":"Mənə istehza edənlər adımla lənət oxuyur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yeməyim çörək yerinə kül olub,","poem":1},{"lineBreak":true},{"text":"İçməyim göz yaşıma qarışıb.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki qəzəbindən, hiddətindən","poem":1},{"lineBreak":true},{"text":"Məni götürüb bir tərəfə atmısan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Günlərim axşamın kölgəsi kimi keçir,","poem":1},{"lineBreak":true},{"text":"Bir ot kimi quruyuram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakin Sən, ya Rəbb, əbədi taxtında əyləşmisən,","poem":1},{"lineBreak":true},{"text":"Sənin şöhrətin nəsildən-nəslə deyiləcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən qalxıb Siona mərhəmət edəcəksən,","poem":1},{"lineBreak":true},{"text":"Zamanını təyin etdin, indi ona lütf ediləcək.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki Sənin qulların onun daşlarını əziz tuturlar,","poem":1},{"lineBreak":true},{"text":"Onun toz-torpağına necə də acıyırlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Millətlər Rəbbin ismindən,","poem":1},{"lineBreak":true},{"text":"Dünyanın bütün padşahları Onun əzəmətindən qorxacaqlar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb Sionu yenidən bərpa edəcək,","poem":1},{"lineBreak":true},{"text":"Əzəmətində görünəcək,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yoxsulların duasına qulaq asacaq,","poem":1},{"lineBreak":true},{"text":"Yalvarışlarına xor baxmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sonrakı övladları Rəbbə həmd etsin deyə","poem":1},{"lineBreak":true},{"text":"Qoy gələcək nəsil üçün belə yazılsın:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"«Rəbb müqəddəs yüksəklikdən,","poem":1},{"lineBreak":true},{"text":"Göylərdən yer üzünə nəzər saldı;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Əsirlərin naləsini eşitmək üçün,","poem":1},{"lineBreak":true},{"text":"Ölümə aparılanları azad etmək üçün».","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ona görə Rəbbin ismini Sionda elan edəcəklər,","poem":1},{"lineBreak":true},{"text":"Yerusəlimdə Ona həmdlər söyləyəcəklər","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Rəbbə xidmət etmək üçün gələrkən,","poem":1},{"lineBreak":true},{"text":"Xalqlar, ölkələr bir yerə gələrkən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yolda ikən Rəbb gücümü azaltdı,","poem":1},{"lineBreak":true},{"text":"O, ömrümü qısaltdı.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dedim: «Ey Allahım, canımı alma, ömrümün yarısıdır,","poem":1},{"lineBreak":true},{"text":"Sənin illərin nəsillərdən-nəsillərə çatır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yerin təməlini əzəldən qurmusan,","poem":1},{"lineBreak":true},{"text":"Göylər Sənin əllərinin işidir!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Onlar yox olacaq, amma Sən qalacaqsan,","poem":1},{"lineBreak":true},{"text":"Hamısı paltar kimi köhnələcək,","poem":1},{"lineBreak":true},{"text":"Onları geyim kimi dəyişdirəcəksən,","poem":1},{"lineBreak":true},{"text":"Keçib-gedəcəklər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Amma Sən dəyişməzsən,","poem":1},{"lineBreak":true},{"text":"İllərin tükənməzdir.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Qullarının övladları yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Nəvə-nəticələri hüzurunda dayanacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}