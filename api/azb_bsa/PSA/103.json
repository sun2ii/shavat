{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"heading","content":["Məzmur 103"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Rəbbə alqış et, ey könlüm,","poem":1},{"lineBreak":true},{"text":"Ey bütün varlığım, Onun müqəddəs adına alqış et!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbə alqış et, ey könlüm,","poem":1},{"lineBreak":true},{"text":"Unutma etdiyi yaxşılıqları:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Odur bütün təqsirlərini əfv edən,","poem":1},{"lineBreak":true},{"text":"Bütün xəstəliklərinə şəfa verən.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Odur həyatını məzara düşməkdən qurtaran,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin, mərhəmətin tacını başına qoyan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Odur ömür boyu səni bərəkəti ilə doyduran,","poem":1},{"lineBreak":true},{"text":"Səni təzələyib gənc, gümrah qartala oxşadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rəbb bütün miskinlər üçün","poem":1},{"lineBreak":true},{"text":"Haqq və ədalət edir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yollarını Musaya,","poem":1},{"lineBreak":true},{"text":"Əməllərini İsrail övladlarına göstərib.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb rəhmli və lütfkardır,","poem":1},{"lineBreak":true},{"text":"Hədsiz səbirli və bol məhəbbətlidir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Həmişə töhmətləndirməz,","poem":1},{"lineBreak":true},{"text":"Qəzəbi sonsuza qədər sürməz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bizimlə günahlarımıza görə davranmaz,","poem":1},{"lineBreak":true},{"text":"Təqsirlərimizin əvəzini çıxmaz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki göylər yerdən nə qədər ucadırsa,","poem":1},{"lineBreak":true},{"text":"Ondan qorxanlara olan məhəbbəti o qədər böyükdür.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nə qədər şərq qərbdən uzaqdırsa,","poem":1},{"lineBreak":true},{"text":"Qanunsuzluqlarımızı bizdən o qədər uzaqlaşdırıb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ata övladlarına rəhm etdiyi kimi","poem":1},{"lineBreak":true},{"text":"Rəbb də Ondan qorxanlara elə rəhm edir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki necə yarandığımızı bilir,","poem":1},{"lineBreak":true},{"text":"Torpaqdan düzəlməyimizi unutmur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"İnsanınsa ömrü bir ota oxşar,","poem":1},{"lineBreak":true},{"text":"Çəmən gülləri kimi çiçək açar,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Üstündən yel əsərkən yox olur,","poem":1},{"lineBreak":true},{"text":"Yerində izi belə, qalmır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbbin isə Ondan qorxanlara olan məhəbbəti,","poem":1},{"lineBreak":true},{"text":"Onların övladlarına olan salehliyi","poem":1},{"lineBreak":true},{"text":"Əzəldən var, bu əbədi qalacaq.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Onun əhdinə vəfa edənlərə bunları göstərir,","poem":1},{"lineBreak":true},{"text":"Qayda-qanunlarını yerinə yetirənləri unutmur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rəbb taxtını göylərdə qurub,","poem":1},{"lineBreak":true},{"text":"Hər yerdə hökmranlıq edir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rəbbə alqış edin, ey Onun mələkləri,","poem":1},{"lineBreak":true},{"text":"Ey Onun sözünə baxıb icra edən qüdrətli igidlər!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbbə alqış edin, ey səmanın bütün orduları,","poem":1},{"lineBreak":true},{"text":"İradəsini yerinə yetirən xidmətçiləri!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Rəbbə alqış edin, ey Onun yaratdıqları,","poem":1},{"lineBreak":true},{"text":"Ey Onun hökm etdiyi yer üzərində olan bütün varlıqlar!","poem":1},{"lineBreak":true},{"text":"Rəbbə alqış et, ey könlüm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}