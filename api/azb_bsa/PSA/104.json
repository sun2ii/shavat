{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"heading","content":["Məzmur 104"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə alqış et, ey könlüm!","poem":1},{"lineBreak":true},{"text":"Ya Rəbb Allahım, Sən nə qədər böyüksən,","poem":1},{"lineBreak":true},{"text":"Ehtişamı, əzəməti geyinmisən!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nura libas kimi bürünən,","poem":1},{"lineBreak":true},{"text":"Göyləri çadır tək açan,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuxarı otaqlarını suların üstündə quran,","poem":1},{"lineBreak":true},{"text":"Buludları Özünə araba edən,","poem":1},{"lineBreak":true},{"text":"Yel qanadları üstünə minib gəzən,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Küləyi Özünə elçi edən,","poem":1},{"lineBreak":true},{"text":"Yanar odu Özünə xidmətçi edən Sənsən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yer üzünün təməlini elə qurdun ki,","poem":1},{"lineBreak":true},{"text":"Əsla sarsılmasın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dərin suları libas kimi yer üzünə geydirdin,","poem":1},{"lineBreak":true},{"text":"Sular dağların üstünə qalxdı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin məzəmmətindən sular çəkildi,","poem":1},{"lineBreak":true},{"text":"Şimşəyinin səsindən qorxub qaçdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dağlardan dərələrə axdı,","poem":1},{"lineBreak":true},{"text":"Sənin təyin etdiyin yerlərə töküldü.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onların önünə hədd qoydun ki, ondan aşmasınlar,","poem":1},{"lineBreak":true},{"text":"Heç vaxt daşıb dünyanı basmasınlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bulaqları vadilərdən fışqırtdın,","poem":1},{"lineBreak":true},{"text":"Dağların arasından axıtdın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bu bulaqlar bütün çöl heyvanlarına su verər,","poem":1},{"lineBreak":true},{"text":"Vəhşi eşşəklər içər, susuzluğu gedər.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yanlarında quşlar yuva qurar,","poem":1},{"lineBreak":true},{"text":"Budaqlara qonub oxuyar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən dağları göydəki sarayından sulayırsan,","poem":1},{"lineBreak":true},{"text":"Əlinin bəhrəsindən yer doyur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Heyvanlar üçün ot bitirirsən,","poem":1},{"lineBreak":true},{"text":"İnsana becərmək üçün bitkilər yetirirsən.","poem":1},{"lineBreak":true},{"text":"Qoy insan torpaqdan azuqəsini çıxartsın:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ürəkləri xoşhal edən şərabı,","poem":1},{"lineBreak":true},{"text":"Üzləri güldürən zeytun yağını,","poem":1},{"lineBreak":true},{"text":"Taqət verən çörəyi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Doyunca su içər Rəbbin ağacları,","poem":1},{"lineBreak":true},{"text":"Livanda əkdiyi sidr ağacları.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu ağaclarda quşlar yuva qurar,","poem":1},{"lineBreak":true},{"text":"Leyləklərin yuvası şam ağacındadır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Uca dağlar dağ keçilərinin oylağıdır,","poem":1},{"lineBreak":true},{"text":"Qayalar qayadovşanlarının sığınacağıdır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fəsilləri müəyyən etmək üçün ayı yaratdın,","poem":1},{"lineBreak":true},{"text":"Günəş batacağı zamanı bilir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gecə olsun deyə havanı qaraldırsan,","poem":1},{"lineBreak":true},{"text":"Bütün meşə heyvanları vurnuxmaya düşürlər.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ov üçün gənc aslanlar nərə çəkərlər,","poem":1},{"lineBreak":true},{"text":"Öz yemlərini Allahdan istəyərlər.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gün doğanda çəkilirlər,","poem":1},{"lineBreak":true},{"text":"Yuvalarında yatırlar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"İnsanlar iş başına gedir,","poem":1},{"lineBreak":true},{"text":"Qaş qaralana qədər işləyirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ya Rəbb, əməllərin çoxdur!","poem":1},{"lineBreak":true},{"text":"Hər birini müdrikliklə etmisən,","poem":1},{"lineBreak":true},{"text":"Yaratdıqların yer üzünü doldurub.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Böyük, dərin dənizlərin var,","poem":1},{"lineBreak":true},{"text":"Orada da saysız məxluqlar –","poem":1},{"lineBreak":true},{"text":"Həm kiçik, həm də böyük canlılar qaynaşar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Oradan gəmilər keçir,","poem":1},{"lineBreak":true},{"text":"Yaratdığın Livyatan sularda oynayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bunların hamısı gözləyir ki, Sən","poem":1},{"lineBreak":true},{"text":"Vaxtlı-vaxtında onları yemləyəsən.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sən yem verərkən onlar yem yığırlar,","poem":1},{"lineBreak":true},{"text":"Açıq əlinin nemətindən doyurlar.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Amma üzünü gizlədərkən vəlvələyə düşürlər,","poem":1},{"lineBreak":true},{"text":"Sən onların nəfəsini kəsərkən ölüb torpağa qarışırlar,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ruhunu göndərərkən onlar yaranır,","poem":1},{"lineBreak":true},{"text":"Yer üzünə yeni həyat verirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Rəbbin ehtişamı qoy əbədi var olsun!","poem":1},{"lineBreak":true},{"text":"Qoy Rəbb yaratdıqlarına görə şad olsun!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Rəbb yerə baxanda yer lərzəyə gəlir,","poem":1},{"lineBreak":true},{"text":"Dağa toxunanda dağ tüstülənir.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Rəbbə ömrüm boyu ilahi söyləyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Nə qədər varam, Allahımı tərənnüm edəcəyəm.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Düşüncəm Ona xoş görünsün,","poem":1},{"lineBreak":true},{"text":"Mən Rəbbə görə sevinəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Günahkarlar yer üzündən silinsinlər,","poem":1},{"lineBreak":true},{"text":"Pis adamlar yox olsunlar!","poem":1},{"lineBreak":true},{"text":"Rəbbə alqış et, ey könlüm!","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1},{"noteId":11}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Rəbbə həmd edin – ibrani dilində Halleluya.","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/azb_bsa/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}