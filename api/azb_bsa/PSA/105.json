{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["Məzmur 105"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə şükür edin, ismini çağırın,","poem":1},{"lineBreak":true},{"text":"Əməllərini xalqlar arasında elan edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onu ilahilərlə tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Bütün xariqələrini bəyan edin!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onun müqəddəs adı ilə fəxr edin,","poem":1},{"lineBreak":true},{"text":"Ey Rəbbi axtaranlar, ürəkləriniz qoy sevinsin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbbi, Onun qüvvətini arayın,","poem":1},{"lineBreak":true},{"text":"Daim hüzurunu axtarın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Etdiyi xariqələri,","poem":1},{"lineBreak":true},{"text":"Möcüzələri, dilindən çıxan hökmləri xatırlayın,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey Onun qulu İbrahim nəsli,","poem":1},{"lineBreak":true},{"text":"Ey Yaqub övladları, ey Onun seçdikləri!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Allahımız Rəbb Odur,","poem":1},{"lineBreak":true},{"text":"Hökmü bütün yer üzündədir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əbədi olaraq min nəslə qədər əhdini,","poem":1},{"lineBreak":true},{"text":"Əmr etdiyi sözü,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İbrahimlə kəsdiyi əhdini,","poem":1},{"lineBreak":true},{"text":"İshaqa and içərək verdiyi vədini unutmaz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bunu qayda kimi Yaqub üçün təsdiq etdi,","poem":1},{"lineBreak":true},{"text":"Bu əbədi əhdi İsrail üçün etdi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dedi: «Övladlarının payına düşən mülk kimi","poem":1},{"lineBreak":true},{"text":"Kənan torpağını sənə verəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O zaman onlar sayca az idilər,","poem":1},{"lineBreak":true},{"text":"Azsaylı olaraq ölkədə qərib idilər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ölkədən-ölkəyə,","poem":1},{"lineBreak":true},{"text":"Məmləkətdən-məmləkətə köçürdülər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb heç kimi onlara əzab verməyə qoymadı,","poem":1},{"lineBreak":true},{"text":"Onlara görə padşahları tənbeh etdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dedi: «Məsh etdiklərimə dəyməyin,","poem":1},{"lineBreak":true},{"text":"Peyğəmbərlərimə pislik etməyin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ölkəyə qıtlıq göndərdi,","poem":1},{"lineBreak":true},{"text":"Bütün çörəyin kökünü kəsdi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lakin bunlardan əvvəl birini göndərmişdi,","poem":1},{"lineBreak":true},{"text":"Bu, qul kimi satılan Yusif idi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ayaqlarını zəncirləyib əzdilər,","poem":1},{"lineBreak":true},{"text":"Boğazına dəmir halqa keçirdilər.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yusifin sözü düz çıxanadək","poem":1},{"lineBreak":true},{"text":"Rəbbin sözü onu təmizlədi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Padşah buyruq verərək onu azad etdi,","poem":1},{"lineBreak":true},{"text":"Xalqların hökmdarı ona azadlıq verdi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onu sarayının ağası etdi,","poem":1},{"lineBreak":true},{"text":"Varidatı üçün cavabdeh etdi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ona başçılar üstündə səlahiyyət verdi ki,","poem":1},{"lineBreak":true},{"text":"Ağsaqqallarına uzaqgörənlik öyrətsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sonra İsrail Misirə gəldi,","poem":1},{"lineBreak":true},{"text":"Yaqub Ham ölkəsində yerləşdi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Rəbb onun xalqına bərəkət verdi,","poem":1},{"lineBreak":true},{"text":"Düşmənlərindən çox onlara qüdrət verdi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Rəbb düşmənlərinə fikir göndərdi ki, xalqına nifrət etsinlər,","poem":1},{"lineBreak":true},{"text":"Qullarına qarşı fırıldaq işlətsinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Qulu Musanı,","poem":1},{"lineBreak":true},{"text":"Həm də seçdiyi Harunu göndərdi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Xalqın arasında Rəbbin əlamətlərini,","poem":1},{"lineBreak":true},{"text":"Ham ölkəsində Onun möcüzələrini göstərdilər.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Rəbb qaranlıq göndərərək ölkəni zülmət etdi,","poem":1},{"lineBreak":true},{"text":"Çünki Onun sözlərinə itaət etmədilər.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sularını qana çevirdi,","poem":1},{"lineBreak":true},{"text":"Balıqlarını öldürdü.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ölkəyə qurbağalar qaynaşıb gəldilər,","poem":1},{"lineBreak":true},{"text":"Padşahın otaqlarına belə, girdilər.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Əmr etdi, topa-topa mozalan gəldi,","poem":1},{"lineBreak":true},{"text":"Mığmığalar bütün ərazilərini bürüdü.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yağış əvəzinə dolu yağdırdı,","poem":1},{"lineBreak":true},{"text":"Ölkələrini şimşəklərə qərq etdi.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tənəklərinə, əncir ağaclarına zərbə vurdu,","poem":1},{"lineBreak":true},{"text":"Sahələrində olan ağacları qırdı.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Əmr etdi çəyirtkələrə qaynaşsın,","poem":1},{"lineBreak":true},{"text":"Saysız balaları torpaqlarına daraşsın.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Onlar ölkədə olan bütün otları yedilər,","poem":1},{"lineBreak":true},{"text":"Torpaqlarının bar-bəhərini yedilər.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"O, ölkədə hər yerlinin ilk oğlunu,","poem":1},{"lineBreak":true},{"text":"Hər kişinin belindən gələn ilk oğlunu öldürdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"İsrailliləri oradan qızılla, gümüşlə çıxartdı,","poem":1},{"lineBreak":true},{"text":"Qəbilələri arasında yıxılan olmadı.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Onlar çıxanda Misirlilər sevindi,","poem":1},{"lineBreak":true},{"text":"Canlarında İsraillilərin qorxusu var idi.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Üzərlərinə örtük kimi bulud sərdi,","poem":1},{"lineBreak":true},{"text":"Gecəni işıqlandırmaq üçün od göndərdi.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"İstədiklərinə görə O, bildirçin gətirdi,","poem":1},{"lineBreak":true},{"text":"Onlara göydən doyunca çörək verdi.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Qayanı yararaq suyu fışqırtdı,","poem":1},{"lineBreak":true},{"text":"Quraq yerə çay kimi axdı.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Çünki müqəddəs sözünü yada salmışdı,","poem":1},{"lineBreak":true},{"text":"Qulu İbrahimə verdiyi vədini xatırlamışdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"O, xalqını sevinclə,","poem":1},{"lineBreak":true},{"text":"Öz seçdiklərini mədh səsi ilə çıxartdı.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Millətlərin torpaqlarını onlara verdi,","poem":1},{"lineBreak":true},{"text":"Onları ümmətlərin sərvətlərinə sahib etdi.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Qoy Rəbbin qaydalarına riayət etsinlər,","poem":1},{"lineBreak":true},{"text":"Qanunlarına əməl etsinlər.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}