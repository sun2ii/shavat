{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["Məzmur 106"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbin qüdrətli işlərini sözlə demək olarmı?","poem":1},{"lineBreak":true},{"text":"Onu layiqincə həmd edən varmı?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nə bəxtiyardır ədalətə bağlananlar,","poem":1},{"lineBreak":true},{"text":"Hər zaman əməlisaleh olanlar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, xalqına lütf edərkən məni yada sal,","poem":1},{"lineBreak":true},{"text":"Onları nicata çatdırarkən mənim də qayğıma qal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qoy seçdiklərini bəxtiyar görüm,","poem":1},{"lineBreak":true},{"text":"Millətinin sevinci ilə sevinim,","poem":1},{"lineBreak":true},{"text":"İrsinlə birlikdə fəxr edim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ata-babamız kimi biz də günaha batmışıq,","poem":1},{"lineBreak":true},{"text":"Biz də şər iş görməklə təqsirkar olmuşuq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Misirdə olanda ata-babamız Sənin xariqələrini anlamadı,","poem":1},{"lineBreak":true},{"text":"Bol məhəbbətini yada salmadı,","poem":1},{"lineBreak":true},{"text":"Dəniz kənarında, Qırmızı dənizdə Sənə qarşı üsyankar oldu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amma Rəbb qüdrətini göstərmək üçün","poem":1},{"lineBreak":true},{"text":"Onları ismi naminə qurtardı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onun məzəmmətindən Qırmızı dəniz qurudu,","poem":1},{"lineBreak":true},{"text":"Çöldən keçdikləri kimi onları dərin yerdən keçirtdi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İsrailliləri onlara nifrət edənin əlindən qurtardı,","poem":1},{"lineBreak":true},{"text":"Onları düşməninin əlindən xilas etdi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yağıları sular basdı,","poem":1},{"lineBreak":true},{"text":"Bir nəfər də qalmadı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O zaman Rəbbin sözlərinə inandılar,","poem":1},{"lineBreak":true},{"text":"Onu həmdlə tərənnüm etdilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakin Rəbbin əməllərini tez unutdular,","poem":1},{"lineBreak":true},{"text":"Ondan məsləhət almadılar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onlar səhrada iştahaya düşdülər,","poem":1},{"lineBreak":true},{"text":"Çöllükdə Allahı sınağa çəkdilər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O da istədiklərini verdi,","poem":1},{"lineBreak":true},{"text":"Lakin onlara azar göndərdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Düşərgədə Musaya,","poem":1},{"lineBreak":true},{"text":"Rəbb üçün təqdis olunan Haruna paxıllıq etdilər,","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Torpaq yarılıb Datanı uddu,","poem":1},{"lineBreak":true},{"text":"Aviramla yoldaşlarını yerə batırdı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yoldaşlarının içinə alov saldı,","poem":1},{"lineBreak":true},{"text":"Bu, pisləri yandırıb-yaxdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xorevdə bir dana heykəli düzəltdilər,","poem":1},{"lineBreak":true},{"text":"Tökmə bir bütə səcdə etdilər.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Allahın əvəzinə","poem":1},{"lineBreak":true},{"text":"Otyeyən buğanın surətinə şərəf verdilər.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onları qurtaran Allahı –","poem":1},{"lineBreak":true},{"text":"Misirdə böyük möcüzələr yaradanı,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ham ölkəsində xariqələr göstərəni,","poem":1},{"lineBreak":true},{"text":"Qırmızı dənizdə zəhmli işlər görəni unutdular.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Rəbb onları yox etmək üçün niyyətini söylədi,","poem":1},{"lineBreak":true},{"text":"Onu məhvedici qəzəbindən döndərmək üçün","poem":1},{"lineBreak":true},{"text":"Seçdiyi Musa Onun qarşısına gəldi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sonra o gözəl diyara da xor baxdılar,","poem":1},{"lineBreak":true},{"text":"Rəbbin vədinə inanmadılar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çadırlarında giley-güzar etdilər,","poem":1},{"lineBreak":true},{"text":"Rəbbin səsini eşitmədilər.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Buna görə Rəbb and içdi:","poem":1},{"lineBreak":true},{"text":"Meyitlərini çöllərə sərəcək,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Övladlarını millətlər arasına səpələyəcək,","poem":1},{"lineBreak":true},{"text":"Onları ölkələr arasında darmadağın edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Onlar Peordakı Baala səcdə etməyə gəldilər,","poem":1},{"lineBreak":true},{"text":"Ölü bütə verilən qurban ətindən yedilər.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bu işlər Rəbbin qəzəbinə gəldi,","poem":1},{"lineBreak":true},{"text":"Aralarına vəba töküldü.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Onda Pinxas qalxıb buna müdaxilə etdi,","poem":1},{"lineBreak":true},{"text":"Beləliklə, vəba çəkilib getdi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bu, nəsillər boyu, əbədilik","poem":1},{"lineBreak":true},{"text":"Onun üçün salehlik sayıldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Onlar Meriva suları kənarında Rəbbi qəzəbləndirdilər,","poem":1},{"lineBreak":true},{"text":"Buna görə Musanın başına qəza gəldi:","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Onlar Musanın ruhunu incitdilər,","poem":1},{"lineBreak":true},{"text":"O da düşünülməmiş sözlər dedi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Rəbbin əmrini yerinə yetirmədilər,","poem":1},{"lineBreak":true},{"text":"Dediyi xalqları məhv etmədilər.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Əksinə, həmin millətlərə qarışdılar,","poem":1},{"lineBreak":true},{"text":"Adət-ənənələrini öyrənib onlara əməl etdilər.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Onların bütlərinə ibadət edərək","poem":1},{"lineBreak":true},{"text":"Özlərini bu tələyə saldılar.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Oğul-qızlarını","poem":1},{"lineBreak":true},{"text":"Cinlərə qurban verdilər.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Oğul-qızlarının günahsız qanını tökdülər,","poem":1},{"lineBreak":true},{"text":"Onları Kənan bütlərinə qurban verdilər,","poem":1},{"lineBreak":true},{"text":"Ölkəni qana bulaşdırdılar.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Belə işlərlə murdarlandılar,","poem":1},{"lineBreak":true},{"text":"Öz əməlləri ilə xəyanətə satıldılar.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Rəbb xalqına qarşı qəzəbindən yandı,","poem":1},{"lineBreak":true},{"text":"Öz irsini iyrənc bir şey sandı.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Onları millətlərə təslim etdi,","poem":1},{"lineBreak":true},{"text":"Onlara nifrət edənlər üzərlərində hakim oldu.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Düşmənləri onları zülm altına saldılar,","poem":1},{"lineBreak":true},{"text":"Onlara tabe olaraq əl altında qaldılar.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Rəbb dəfələrlə onları azad etmişdi,","poem":1},{"lineBreak":true},{"text":"Amma pisniyyətli olduqları üçün üsyankar olmuşdular,","poem":1},{"lineBreak":true},{"text":"Bu insanları öz günahları alçaltdı.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Lakin O, fəryadlarını eşidəndə","poem":1},{"lineBreak":true},{"text":"Onların əziyyətinə baxdı.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Bu insanlarla bağladığı əhdini yada saldı,","poem":1},{"lineBreak":true},{"text":"Bol məhəbbəti naminə rəhmini göstərdi.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Onları əsir edənlərin","poem":1},{"lineBreak":true},{"text":"Qəlbinə mərhəmət saldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Ey Allahımız Rəbb, bizi qurtar,","poem":1},{"lineBreak":true},{"text":"Bizi millətlərin arasından topla.","poem":1},{"lineBreak":true},{"text":"Müqəddəs isminə şükür edək,","poem":1},{"lineBreak":true},{"text":"Biz fəxrlə Sənə həmd söyləyək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Alqış olsun İsrailin Allahı Rəbbə","poem":1},{"lineBreak":true},{"text":"Əzəldən sonsuza qədər!","poem":1},{"lineBreak":true},{"text":"Qoy bütün xalq söyləsin «Amin!»","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}