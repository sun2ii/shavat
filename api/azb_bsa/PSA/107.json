{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"heading","content":["Məzmur 107"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy belə söyləsin Rəbbin xilas etdikləri,","poem":1},{"lineBreak":true},{"text":"Düşmən əlindən qurtardıqları,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Şərqdən, qərbdən, şimaldan və cənubdan –","poem":1},{"lineBreak":true},{"text":"Ölkələrdən topladıqları.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bəziləri səhrada, çöllükdə sərgərdan dolanırdılar,","poem":1},{"lineBreak":true},{"text":"Yaşamaq üçün heç bir şəhər tapmırdılar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aclıqdan, susuzluqdan","poem":1},{"lineBreak":true},{"text":"Canlarının taqəti getmişdi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onlar dara düşəndə Rəbbə fəryad etdilər,","poem":1},{"lineBreak":true},{"text":"Rəbb onları dərdlərindən qurtardı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaşamaq üçün onlar bir şəhərə çatanadək","poem":1},{"lineBreak":true},{"text":"Onları düz yolla apardı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbbə şükür etsinlər məhəbbətinə görə,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına göstərdiyi xariqələrinə görə!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki O, susuzlara doyunca su verər,","poem":1},{"lineBreak":true},{"text":"Acları bol nemətlərlə bəslər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bəziləri əsir düşüb zülmətdə yaşayırdı,","poem":1},{"lineBreak":true},{"text":"Zəncirlənib qaranlıqda, əziyyətdə qalırdı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki Allahın sözlərinə qarşı çıxmışdılar,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanın məsləhətinə xor baxmışdılar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ona görə ağır işlə onların ürəklərinə əzab verdi,","poem":1},{"lineBreak":true},{"text":"Yıxılanda heç kim onlara kömək etmədi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onlar dara düşəndə Rəbbə fəryad etdilər,","poem":1},{"lineBreak":true},{"text":"Rəbb onları dərdlərindən qurtardı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onların buxovlarını qopardı,","poem":1},{"lineBreak":true},{"text":"Zülmətdən, qaranlıqdan çıxardı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qoy şükür etsinlər Rəbbə məhəbbətinə görə,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına göstərdiyi xariqələrinə görə!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çünki O, tunc qapıları qırar,","poem":1},{"lineBreak":true},{"text":"Dəmir cəftələri qoparar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bəzilərinin ağlı çaşıb üsyankar oldu,","poem":1},{"lineBreak":true},{"text":"Təqsirləri onları zülmə saldı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hər yeməkdən iyrəndilər,","poem":1},{"lineBreak":true},{"text":"Ölüm qapılarına yaxın gəldilər.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dara düşərkən Rəbbə fəryad qopardılar,","poem":1},{"lineBreak":true},{"text":"Rəbb onları dərdlərindən qurtardı.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kəlamını göndərib onlara şəfa verdi,","poem":1},{"lineBreak":true},{"text":"Məzara düşməkdən onları xilas etdi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbbə şükür etsinlər məhəbbətinə görə,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına göstərdiyi xariqələrinə görə!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Qoy şükür qurbanlarını təqdim etsinlər,","poem":1},{"lineBreak":true},{"text":"Əməllərinə mədh oxuyub bəyan etsinlər!","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bəziləri gəmilərlə dənizlərdə üzdülər,","poem":1},{"lineBreak":true},{"text":"Dəryalarda böyük işlər gördülər.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Orada Rəbbin əməllərinə,","poem":1},{"lineBreak":true},{"text":"Dərin sularda etdiyi xariqələrinə şahid oldular.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Çünki Onun əmri ilə qasırğa qopdu,","poem":1},{"lineBreak":true},{"text":"Dənizin dalğaları qalxdı.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gəmiçilər göyə qalxıb dərinə enirdi,","poem":1},{"lineBreak":true},{"text":"Qorxudan canları əldən gedirdi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Onlar sərxoş kimi yırğalanıb-səndələyirdi,","poem":1},{"lineBreak":true},{"text":"Ağıllarına heç bir çarə gəlmirdi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Onlar dara düşəndə Rəbbə fəryad etdilər,","poem":1},{"lineBreak":true},{"text":"Rəbb onları dərdlərindən qurtardı.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Qasırğanı yatırdı, sükut gətirdi,","poem":1},{"lineBreak":true},{"text":"Dalğaları sakit etdi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sakitlik yarananda onlar çox sevindilər,","poem":1},{"lineBreak":true},{"text":"Rəbb də onları istədikləri limana çatdırdı.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Rəbbə məhəbbətinə görə,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına göstərdiyi xariqələrinə görə şükür etsinlər!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Qoy Onu xalqın toplantısında ucaltsınlar,","poem":1},{"lineBreak":true},{"text":"Ona ağsaqqallar məclisində həmd etsinlər!","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"O, çayları qurudub səhra edər,","poem":1},{"lineBreak":true},{"text":"Bulaqlar olan yeri quraq çölə döndərər,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Orada yaşayanların pisliyinə görə","poem":1},{"lineBreak":true},{"text":"Münbit torpağı şoranlığa çevirər.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Səhranı gölməçəyə döndərər,","poem":1},{"lineBreak":true},{"text":"Quraq torpaqdan bulaqlar çıxardar.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Oranı verər ki, aclar məskən salsınlar,","poem":1},{"lineBreak":true},{"text":"Yaşamaq üçün özlərinə şəhər qursunlar,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Tarlanı əksinlər, üzümlüklər salsınlar.","poem":1},{"lineBreak":true},{"text":"Bol məhsul götürsünlər.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Onun xeyir-duası ilə törəyib artırlar,","poem":1},{"lineBreak":true},{"text":"Heyvanlarının sayı azalmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Sonra əzabdan, darlıqdan, bəlalardan","poem":1},{"lineBreak":true},{"text":"Onlar azalıb alçaldılan an","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Rəbb əsilzadələrin üstünə həqarət yağdırar,","poem":1},{"lineBreak":true},{"text":"Onları sonsuz çöldə sərgərdan dolandırar.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Amma fəqiri zülm altından qaldırar,","poem":1},{"lineBreak":true},{"text":"Övladlarını sürü kimi çoxaldar.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Bunu görən əməlisalehlər şad olar,","poem":1},{"lineBreak":true},{"text":"Fitnə söyləyən ağızlarsa yumular.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Kimin ağlı varsa, qoy buna fikir versin,","poem":1},{"lineBreak":true},{"text":"Qoy Rəbbin məhəbbətini dərk etsin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}