{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["Məzmur 108"]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allahım, qəlbim Sənə möhkəm bağlanıb,","poem":1},{"lineBreak":true},{"text":"Qoy bütün varlığımla ilahi oxuyum, Səni tərənnüm edim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey çəng və lira, oyan!","poem":1},{"lineBreak":true},{"text":"Qoy səhəri oyadım.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, xalqlar arasında","poem":1},{"lineBreak":true},{"text":"Sənə şükür edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ümmətlər arasında","poem":1},{"lineBreak":true},{"text":"Səni tərənnüm edəcəyəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məhəbbətin böyükdür, göylərdən ucadır,","poem":1},{"lineBreak":true},{"text":"Sədaqətin buludlara çatır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey Allah, göylər üzərində ucal!","poem":1},{"lineBreak":true},{"text":"Ehtişamın bütün yer üzərində olsun!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sevdiyin insanların xilas olması üçün","poem":1},{"lineBreak":true},{"text":"Sağ əlinlə bizi qurtar, mənə cavab ver!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Allah Öz müqəddəs məskənindən belə söylədi:","poem":1},{"lineBreak":true},{"text":"«Şekemi sevinclə bölüşdürəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sukkot dərəsini böləcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gilead torpağı Mənimdir,","poem":1},{"lineBreak":true},{"text":"Menaşşe torpağı Mənimdir,","poem":1},{"lineBreak":true},{"text":"Efrayim başımın dəbilqəsidir,","poem":1},{"lineBreak":true},{"text":"Yəhuda Mənim əsamdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moav yuyunmaq üçün ləyənimdir,","poem":1},{"lineBreak":true},{"text":"Çarığımı ataraq Edomu tutacağam,","poem":1},{"lineBreak":true},{"text":"Zəfər harayını Filiştə salacağam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kim məni istehkamlı şəhərə apara bilər?","poem":1},{"lineBreak":true},{"text":"Edoma qədər kim mənə yol göstərə bilər?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ay Allah, niyə bizi atmısan?","poem":1},{"lineBreak":true},{"text":"Ay Allah, qoşunlarımızla niyə yürüşə çıxmırsan?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Düşmənin qarşısında bizə imdad et,","poem":1},{"lineBreak":true},{"text":"Çünki insanın köməyi puçdur.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Allahın köməyi ilə şücaət göstərəcəyik,","poem":1},{"lineBreak":true},{"text":"O, düşmənlərimizi tapdalayacaq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}