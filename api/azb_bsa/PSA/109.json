{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"heading","content":["Məzmur 109"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey tərənnüm etdiyim Allah, susma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki pislər, hiyləgərlər ağzını açıb","poem":1},{"lineBreak":true},{"text":"Yalançı dilləri ilə məndən danışırlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mənə hər tərəfdən nifrət dolu sözlər deyirlər,","poem":1},{"lineBreak":true},{"text":"Nahaq yerə hücumlarına məruz qalıram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sevgimin əvəzinə mənə ittiham yağdırırlar,","poem":1},{"lineBreak":true},{"text":"Mən isə dua etməkdəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaxşılığımın əvəzinə yamanlıq edirlər,","poem":1},{"lineBreak":true},{"text":"Sevgimin əvəzinə nifrətlə cavab verirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Belə adamın qarşısına bir pis insanı çıxar,","poem":1},{"lineBreak":true},{"text":"Sağ tərəfində dayanıb onu ittiham etsin!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hökm oxunanda o təqsirkar çıxsın,","poem":1},{"lineBreak":true},{"text":"Qoy onun duası günah sayılsın!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onun ömrü az olsun,","poem":1},{"lineBreak":true},{"text":"Vəzifəsini başqası tutsun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Övladları yetim,","poem":1},{"lineBreak":true},{"text":"Arvadı isə dul qalsın!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Övladları didərgin düşüb dilənçi olsun,","poem":1},{"lineBreak":true},{"text":"Yaşamağa xarabalıq belə, tapmasın!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sələmçilər hər şeyini əlindən alsın,","poem":1},{"lineBreak":true},{"text":"Nə qazanıbsa, yadellilər talayaraq aparsın!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ona məhəbbət göstərən olmasın,","poem":1},{"lineBreak":true},{"text":"Yetim qalan balalarına yazığı gələn tapılmasın!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qoy onun nəsli kəsilsin,","poem":1},{"lineBreak":true},{"text":"Gələcək nəslin arasından adları silinsin!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ata-babasının təqsiri Rəbbin hüzurunda yaddan çıxmasın,","poem":1},{"lineBreak":true},{"text":"Anasının günahı heç zaman yuyulmasın!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Belə adamlar Rəbbin hüzurunda daim təqsirkar qalsınlar,","poem":1},{"lineBreak":true},{"text":"Dünyadan izi-tozu silinsin, yada salınmasınlar!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Çünki məhəbbət göstərməyi unutdular,","poem":1},{"lineBreak":true},{"text":"Məzlumu, fəqiri, qəlbisınıqları","poem":1},{"lineBreak":true},{"text":"Həlak etmək üçün təqib etdilər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qarğış etməyi sevirdi, öz başına dönsün,","poem":1},{"lineBreak":true},{"text":"Alqış etməyi sevmirdi, ona əli çatmasın!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ondan əynindəki paltar kimi qarğış çıxardı,","poem":1},{"lineBreak":true},{"text":"Qoy qarğışı su kimi canına, ilik kimi sümüklərinə hopsun!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Qarğışı onu əyninin libası kimi bürüsün,","poem":1},{"lineBreak":true},{"text":"Hər gün belinə kəmər tək dolansın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Məni ittiham edənlər,","poem":1},{"lineBreak":true},{"text":"Mənim barəmdə pis sözlər söyləyənlər","poem":1},{"lineBreak":true},{"text":"Rəbbin cəzasına gəlsinlər!","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lakin, ey Xudavənd Rəbb, ismin naminə","poem":1},{"lineBreak":true},{"text":"Özün mənə qayğı göstər,","poem":1},{"lineBreak":true},{"text":"O gözəl məhəbbətinə görə məni azad et.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki mən məzlum və fəqir insanam,","poem":1},{"lineBreak":true},{"text":"Köksümdəki ürəyimdən yaralanmışam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Düşən kölgə kimi itirəm,","poem":1},{"lineBreak":true},{"text":"Vurulub atılan çəyirtkəyə bənzəyirəm.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bax oruc tutmaqdan dizlərim əsir,","poem":1},{"lineBreak":true},{"text":"Bir dəri, bir sümük qalmışam.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Görənlər mənə lağ edir,","poem":1},{"lineBreak":true},{"text":"Başlarını yelləyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ya Rəbb Allahım, Sən mənə kömək et,","poem":1},{"lineBreak":true},{"text":"Məhəbbətinə görə məni qurtar.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bilsinlər ki, bu Sənin əlindədir,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, Sən bunu edə bilərsən.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Qoy onlar qarğış etsinlər, Sən mənə xeyir-dua ver,","poem":1},{"lineBreak":true},{"text":"Qoy onlar əleyhimə qalxarkən utansınlar.","poem":1},{"lineBreak":true},{"text":"Sənin qulunam, qoy sevinim!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"İttihamçılarım rüsvayçılığa bürünsünlər,","poem":1},{"lineBreak":true},{"text":"Xəcaləti xalat kimi geyinsinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mənim dilim Rəbbə bol-bol şükür söyləyəcək,","poem":1},{"lineBreak":true},{"text":"Xalq içində Ona həmd edəcək.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Çünki O, fəqirin sağ tərəfində dayanar ki,","poem":1},{"lineBreak":true},{"text":"Edam hökmü verənlərin əlindən onu qurtarsın.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}