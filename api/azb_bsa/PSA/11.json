taxtı göylərdədir.","poem":1},{"lineBreak":true},{"text":"Rəbbin görən gözləri var, gözünü açar,","poem":1},{"lineBreak":true},{"text":"Bəşər övladlarına diqqətlə baxar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbb saleh adamı sınaqdan keçirir,","poem":1},{"lineBreak":true},{"text":"Pisə, zülmkarasa nifrət edir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pislərin üstünə odlu köz, kükürd yağdırır,","poem":1},{"lineBreak":true},{"text":"Onların kasalarına düşən pay səmum yeli olacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki Rəbb adildir, ədaləti sevir,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər Onun üzünü görəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}