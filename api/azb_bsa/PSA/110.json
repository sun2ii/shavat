{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Məzmur 110"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Rəbb mənim Ağama dedi:","poem":1},{"lineBreak":true},{"text":"«Mən düşmənlərini ayaqlarının altına kətil kimi salanadək","poem":1},{"lineBreak":true},{"text":"Sağımda otur».","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb Siondan Sənin qüdrətli əsanı göndərəcək,","poem":1},{"lineBreak":true},{"text":"Düşmənlərinin üzərində sənə hökmranlıq verəcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Döyüşəcəyin gün xalqın könüllü olaraq sənə qoşulacaq,","poem":1},{"lineBreak":true},{"text":"Gənclərin səhər şehi kimi müqəddəs libasını geyib yanına gələcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbb and içdi, qərarını dəyişməz:","poem":1},{"lineBreak":true},{"text":"«Sən Melkisedeq vəzifəli əbədi bir kahinsən».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xudavənd sənin sağ tərəfindədir,","poem":1},{"lineBreak":true},{"text":"Qəzəb günündə padşahları qıracaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Millətlərin hökmünü verəndə cəsədləri hər yeri bürüyəcək,","poem":1},{"lineBreak":true},{"text":"O bütün ölkələrin başçılarını əzəcək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yol kənarında olan vadidən su içəcək,","poem":1},{"lineBreak":true},{"text":"Buna görə güclənib yüksələcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}