{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Məzmur 111"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər məclisində, icma arasında","poem":1},{"lineBreak":true},{"text":"Bütün qəlbimlə Rəbbə şükür edəcəyəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbin işləri böyükdür,","poem":1},{"lineBreak":true},{"text":"Bunlardan zövq alanlar ibrət götürür.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əməllərində ehtişamı, əzəməti görünür,","poem":1},{"lineBreak":true},{"text":"Salehliyi əbədi qalır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xariqələrini xalqının yadına salır.","poem":1},{"lineBreak":true},{"text":"Rəbb lütfkar və rəhmlidir,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ondan qorxanları bəsləyərək saxlayır,","poem":1},{"lineBreak":true},{"text":"Öz əhdini əbədi olaraq yadda saxlayır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xalqına millətlərin torpaqlarını verərək","poem":1},{"lineBreak":true},{"text":"Qüdrətli işlərini onlara göstərdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Əllərinin işləri sədaqət və ədalətdir,","poem":1},{"lineBreak":true},{"text":"Onun bütün qayda-qanunları etibarlıdır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onlar həmişə, əbədi olaraq möhkəmdir,","poem":1},{"lineBreak":true},{"text":"Sədaqətdən, düzlükdən yaranmışdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Öz xalqına qurtuluş göndərdi,","poem":1},{"lineBreak":true},{"text":"Əhdi əbədi olsun deyə əmr verdi,","poem":1},{"lineBreak":true},{"text":"İsmi müqəddəsdir, zəhmlidir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb qorxusu hikmətin başlanğıcıdır,","poem":1},{"lineBreak":true},{"text":"Buna əməl edənlərin sağlam düşüncəsi vardır.","poem":1},{"lineBreak":true},{"text":"Ona əbədi olaraq həmdlər olsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}