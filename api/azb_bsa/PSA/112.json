{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Məzmur 112"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Nə bəxtiyardır Rəbdən qorxan,","poem":1},{"lineBreak":true},{"text":"Əmrlərindən zövq alan insan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nəsli yer üzündə güclü olacaq,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlərin övladları xeyir-dua alacaq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Evindən bolluq və sərvət əskilməz,","poem":1},{"lineBreak":true},{"text":"Salehliyi əbədi qalar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zülmətdə belə, əməlisaleh insanlar üçün,","poem":1},{"lineBreak":true},{"text":"Lütfkar, rəhmli və saleh adamlar üçün nur doğar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Səxavətlə borc verən,","poem":1},{"lineBreak":true},{"text":"İşlərini ədalətlə görən yaxşı insandır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Belə adam əsla sarsılmaz,","poem":1},{"lineBreak":true},{"text":"Saleh insan əbədi olaraq yadda qalacaq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pis xəbərdən qorxmaz,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvəndiyi üçün ürəyi möhkəmdir,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cəsur ürəklidir,","poem":1},{"lineBreak":true},{"text":"Düşmənlərinin süqutunu görənədək qorxmaz.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Səpələyər, fəqirlərə paylayar,","poem":1},{"lineBreak":true},{"text":"Salehliyi əbədi qalar,","poem":1},{"lineBreak":true},{"text":"Qüdrəti və hörməti ucalar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pis adamsa bunu görüb qəzəblənər,","poem":1},{"lineBreak":true},{"text":"Dişlərini qıcıdar, yanıb-tökülər,","poem":1},{"lineBreak":true},{"text":"Pislərin arzusu puç olar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}