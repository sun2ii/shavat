{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Məzmur 113"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Ey Rəbbin qulları, həmd edin,","poem":1},{"lineBreak":true},{"text":"Rəbbin isminə həmd edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İndidən sonsuzadək","poem":1},{"lineBreak":true},{"text":"Rəbbin isminə alqış olsun!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gündoğandan günbatanadək","poem":1},{"lineBreak":true},{"text":"Rəbbin ismi həmdə layiqdir!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbb bütün millətlərdən ucadır,","poem":1},{"lineBreak":true},{"text":"Ehtişamı göylərdən yüksəkdir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allahımız Rəbbin misli varmı?","poem":1},{"lineBreak":true},{"text":"Ucalardakı taxtında oturan,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Göyə, yerə əyilərək baxan Odur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, yoxsulları toz-torpaqdan qaldırar,","poem":1},{"lineBreak":true},{"text":"Fəqirləri küllükdən çıxarar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onları əsilzadələrlə,","poem":1},{"lineBreak":true},{"text":"Öz xalqının əsilzadələri ilə yanaşı oturdar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sonsuz qadının evini tikər,","poem":1},{"lineBreak":true},{"text":"Ona övlad verməklə bəxtəvər ana edər.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}