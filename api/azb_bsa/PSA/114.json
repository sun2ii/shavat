{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["Məzmur 114"]},{"type":"verse","number":1,"content":[{"text":"İsraillilər Misirdən çıxanda,","poem":1},{"lineBreak":true},{"text":"Yaqub nəsli başqa dildə danışan xalqdan ayrılanda","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yəhuda Rəbbin müqəddəs məskəni oldu,","poem":1},{"lineBreak":true},{"text":"İsrail Rəbbin səltənəti oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Onları görəndə dəniz qaçdı,","poem":1},{"lineBreak":true},{"text":"İordan çayı geri çəkildi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zirvələr qoçlar kimi,","poem":1},{"lineBreak":true},{"text":"Təpələr quzular kimi tullandı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey dəniz, niyə qaçdın, sənə nə oldu?","poem":1},{"lineBreak":true},{"text":"Ey İordan çayı, niyə belə geri çəkildin?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey zirvələr, qoçlar kimi,","poem":1},{"lineBreak":true},{"text":"Ey təpələr, quzular kimi niyə tullandınız?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey dünya, Hökmranın hüzurunda,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının qarşısında lərzəyə gəl!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qayanı gölməçəyə döndərən,","poem":1},{"lineBreak":true},{"text":"Çaxmaq daşını çeşməyə çevirən Odur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}