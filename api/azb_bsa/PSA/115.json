{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["Məzmur 115"]},{"type":"verse","number":1,"content":[{"text":"Bizi yox, ya Rəbb, bizi yox,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin, sədaqətin naminə","poem":1},{"lineBreak":true},{"text":"Öz adını şərəfləndir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Niyə millətlər belə desin:","poem":1},{"lineBreak":true},{"text":"«Onların Allahı haradadır?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allahımız göylərdədir,","poem":1},{"lineBreak":true},{"text":"Öz istədiyini edir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma onların bütləri qızıldan, gümüşdən düzəlmişdir,","poem":1},{"lineBreak":true},{"text":"Onlar insan əllərinin işidir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ağızları var, danışa bilmir,","poem":1},{"lineBreak":true},{"text":"Gözləri var, amma görmür,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qulaqları var, eşitmir,","poem":1},{"lineBreak":true},{"text":"Burunları var, qoxu bilmir,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Əlləri var, hiss etmir,","poem":1},{"lineBreak":true},{"text":"Ayaqları var, gəzə bilmir,","poem":1},{"lineBreak":true},{"text":"Boğazlarından səs gəlmir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütləri düzəldən, onlara güvənən insanlar","poem":1},{"lineBreak":true},{"text":"Bu bütlər kimi cansız olacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey İsraillilər, Rəbbə güvənin,","poem":1},{"lineBreak":true},{"text":"Odur köməyiniz və sipəriniz!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Harun nəsli, Rəbbə güvənin,","poem":1},{"lineBreak":true},{"text":"Odur köməyiniz və sipəriniz!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey Rəbdən qorxanlar, Rəbbə güvənin,","poem":1},{"lineBreak":true},{"text":"Odur köməyiniz və sipəriniz!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rəbb bizi unutmayıb,","poem":1},{"lineBreak":true},{"text":"Bizə xeyir-dua verəcək –","poem":1},{"lineBreak":true},{"text":"İsrail nəslinə xeyir-dua verəcək,","poem":1},{"lineBreak":true},{"text":"Harun nəslinə xeyir-dua verəcək,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kiçikdən böyüyə qədər","poem":1},{"lineBreak":true},{"text":"Ondan qorxanlara xeyir-dua verəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Qoy Rəbb sizi,","poem":1},{"lineBreak":true},{"text":"Sizi və nəslinizi artırsın!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rəbdən, göyləri və yeri Yaradandan","poem":1},{"lineBreak":true},{"text":"Bərəkət alasınız!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rəbb səmaya sahibdir,","poem":1},{"lineBreak":true},{"text":"Yeri bəşər övladlarına verdi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ölənlər, sükut diyarına düşənlər","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd etmirlər.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lakin biz Rəbbə alqış edirik","poem":1},{"lineBreak":true},{"text":"İndidən sonsuzadək.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}