{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Məzmur 116"]},{"type":"verse","number":1,"content":[{"text":"Rəbbi sevirəm,","poem":1},{"lineBreak":true},{"text":"Çünki O, yalvarışımı eşidir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Səsimə qulaq asdığı üçün","poem":1},{"lineBreak":true},{"text":"Nə qədər varam, Onu çağıracağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ətrafıma ölüm bağları sarıldı,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarının sıxıntıları məni haqladı,","poem":1},{"lineBreak":true},{"text":"Dərd-bəlalar məni tapdı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O zaman Rəbbin adını çağırdım:","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, amandır, canımı qurtar!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb lütfkardır, ədalətlidir,","poem":1},{"lineBreak":true},{"text":"Allahımız mərhəmətlidir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb avam adamı qoruyur,","poem":1},{"lineBreak":true},{"text":"O məni düşkünlüyə düçar olanda qurtardı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey canım, rahat ol,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb sənə comərdlik etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb, canımı ölümdən,","poem":1},{"lineBreak":true},{"text":"Gözlərimi göz yaşından, ayağımı büdrəməkdən qurtardın.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İndi Rəbbin hüzurunda gəzib-dolaşıram,","poem":1},{"lineBreak":true},{"text":"Dirilər arasındayam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Mən çox əzab çəkirəm» deyərkən","poem":1},{"lineBreak":true},{"text":"İnamımı itirməmişdim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mən təlaşa düşüb belə demişdim:","poem":1},{"lineBreak":true},{"text":"«Bütün insanlar yalançıdır».","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mənə etdiyi comərdliyə görə","poem":1},{"lineBreak":true},{"text":"Rəbbin borcunu necə qaytara bilərəm?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qurtuluş piyaləsini qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Rəbbin ismini çağıracağam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbbə Onun bütün xalqı qarşısında","poem":1},{"lineBreak":true},{"text":"Əhd etdiyim təqdimləri verəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rəbbin gözündə hər bir möminin","poem":1},{"lineBreak":true},{"text":"Ölümü çox bahadır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aman, ya Rəbb, mən Sənin qulunam,","poem":1},{"lineBreak":true},{"text":"Qulunam, kənizinin oğluyam,","poem":1},{"lineBreak":true},{"text":"Buxovlarımı açmısan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sənə şükür qurbanları təqdim edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Rəbbin adını çağıracağam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbbə Onun bütün xalqı qarşısında","poem":1},{"lineBreak":true},{"text":"Əhd etdiyim təqdimləri verəcəyəm","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Rəbbin evinin həyətində,","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlim, sənin mərkəzində.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}