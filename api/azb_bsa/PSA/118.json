{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["Məzmur 118"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy İsraillilər belə desin:","poem":1},{"lineBreak":true},{"text":"«Çünki məhəbbəti əbədidir!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Harun nəsli belə desin:","poem":1},{"lineBreak":true},{"text":"«Çünki məhəbbəti əbədidir!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoy Rəbdən qorxanlar belə söyləsin:","poem":1},{"lineBreak":true},{"text":"«Çünki məhəbbəti əbədidir!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sıxıntı içində Rəbbi çağırdım,","poem":1},{"lineBreak":true},{"text":"Cavab verib məni genişliyə çıxartdı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb mənimlədir, heç qorxmaram.","poem":1},{"lineBreak":true},{"text":"İnsan mənə nə edə bilər?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb mənimlədir, mənə yardım edər,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edənlərin aqibətini görəcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbbə pənah gətirmək","poem":1},{"lineBreak":true},{"text":"İnsana güvənməkdən yaxşıdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbbə pənah gətirmək","poem":1},{"lineBreak":true},{"text":"Əsilzadələrə güvənməkdən yaxşıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bütün millətlər məni mühasirəyə aldılar,","poem":1},{"lineBreak":true},{"text":"Rəbbin ismi ilə onları qırdım.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hər tərəfdən məni mühasirəyə aldılar,","poem":1},{"lineBreak":true},{"text":"Rəbbin ismi ilə onları qırdım.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Arılar tək məni mühasirəyə aldılar,","poem":1},{"lineBreak":true},{"text":"Lakin kol-kos kimi alışıb tez söndülər,","poem":1},{"lineBreak":true},{"text":"Rəbbin ismi ilə onları qırdım.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Möhkəm təzyiq altında yıxılmağıma az qalmışdı,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb imdadıma çatdı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb qüvvətim, məzmurumdur,","poem":1},{"lineBreak":true},{"text":"O məni xilas etdi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Salehlərin çadırlarından zəfər nidası yüksəlir:","poem":1},{"lineBreak":true},{"text":"«Rəbbin sağ əli qüdrətli işlər göstərir!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbbin sağ əli necə əzəmətlidir!","poem":1},{"lineBreak":true},{"text":"Rəbbin sağ əli qüdrətli işlər göstərir!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ölməyib sağ qalacağam,","poem":1},{"lineBreak":true},{"text":"Rəbbin işlərini bəyan edəcəyəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbb mənə möhkəm cəza verdi,","poem":1},{"lineBreak":true},{"text":"Amma məni ölümə təslim etmədi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Salehlik darvazalarını üzümə açın,","poem":1},{"lineBreak":true},{"text":"Qoy oradan keçib Rəbbə şükür edim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bu, Rəbbin darvazasıdır,","poem":1},{"lineBreak":true},{"text":"Oradan saleh insanlar keçəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ya Rəbb, Sənə şükür edirəm,","poem":1},{"lineBreak":true},{"text":"Çünki cavab verərək məni xilas etmisən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bənnaların rədd etdiyi daş","poem":1},{"lineBreak":true},{"text":"Guşədaşı olub.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bu, Rəbbin işi idi,","poem":1},{"lineBreak":true},{"text":"Gözümüzdə xariqəli bir işdir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bu günü Rəbb yaratdı,","poem":1},{"lineBreak":true},{"text":"Onda sevinib şadlıq edək!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Aman, ya Rəbb, bizi qurtar!","poem":1},{"lineBreak":true},{"text":"Aman, ya Rəbb, bizə uğur göndər!","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Rəbbin ismi ilə gələnə alqış olsun!","poem":1},{"lineBreak":true},{"text":"Sizə Rəbbin evindən xeyir-dua veririk.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Rəbb Allahdır, O, üzərimizə nur saçdı,","poem":1},{"lineBreak":true},{"text":"Qurbangahın buynuzlarına bayram qurbanını bağlayın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Allahım Sənsən, Sənə şükür edəcəyəm!","poem":1},{"lineBreak":true},{"text":"Allahımsan, Səni yüksəldəcəyəm!","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}