{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"heading","content":["Məzmur 119"]},{"type":"heading","content":["Alef119:0 Məzmur 119-da hər səkkiz ayə ibrani əlifba sırası ilə başlayır."]},{"type":"verse","number":1,"content":[{"text":"Nə bəxtiyardır öz yolunda kamil olanlar,","poem":1},{"lineBreak":true},{"text":"Rəbbin qanununa görə yaşayanlar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nə bəxtiyardır Onun göstərişlərinə əməl edənlər,","poem":1},{"lineBreak":true},{"text":"Bütün qəlbi ilə Onu axtaranlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Həqiqətən, onlar fitnəkarlıq etməzlər,","poem":1},{"lineBreak":true},{"text":"Rəbbin yolunda gəzərlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sən qayda-qanunlarını qoydun,","poem":1},{"lineBreak":true},{"text":"Bunlara bağlı qalmağı buyurdun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sənin qaydalarına bağlı qalmaq üçün","poem":1},{"lineBreak":true},{"text":"Kaş tutduğum yolda möhkəm olaydım.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onda xəcalət çəkməzdim,","poem":1},{"lineBreak":true},{"text":"Sənin bütün əmrlərindən gözümü çəkməzdim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adil hökmlərini öyrənərkən","poem":1},{"lineBreak":true},{"text":"Sənə düz qəlblə şükür edəcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sənin qaydalarına əməl edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sən məni tamamilə tərk etmə!","poem":1}]},{"type":"heading","content":["Bet"]},{"type":"verse","number":9,"content":[{"text":"Bir cavan yolunu necə təmiz saxlaya bilər?","poem":1},{"lineBreak":true},{"text":"– Sənin sözlərinə bağlı qalmaqla.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bütün qəlbimlə Səni axtarmışam,","poem":1},{"lineBreak":true},{"text":"Qoyma əmrlərindən çıxım.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sənə qarşı günah etməyim deyə","poem":1},{"lineBreak":true},{"text":"Kəlamını qəlbimdə qoruyub saxlamışam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sənə alqış olsun!","poem":1},{"lineBreak":true},{"text":"Qaydalarını mənə öyrət.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ağzından çıxan hər hökmü","poem":1},{"lineBreak":true},{"text":"Dilimlə bəyan edirəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Göstərişlərinin ardınca gedərkən sevinirəm,","poem":1},{"lineBreak":true},{"text":"Elə bil bolluca var-dövlətə çatmışam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarını dərindən düşünürəm,","poem":1},{"lineBreak":true},{"text":"Sənin yollarından gözümü çəkmirəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qaydalarından zövq alıram,","poem":1},{"lineBreak":true},{"text":"Sözünü unutmuram.","poem":1}]},{"type":"heading","content":["Gimel"]},{"type":"verse","number":17,"content":[{"text":"Quluna comərdliyini göstər,","poem":1},{"lineBreak":true},{"text":"Qoy yaşayım və sözünə bağlı qalım.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gözlərimi aç ki,","poem":1},{"lineBreak":true},{"text":"Qanununun xariqələrini görüm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Əmrlərini məndən gizlətmə,","poem":1},{"lineBreak":true},{"text":"Çünki mən bu dünyada bir qəribəm,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hökmlərinin həsrətini çəkməkdən","poem":1},{"lineBreak":true},{"text":"Hər zaman ürəyim ağrıyır.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sənin əmrlərindən çıxan lovğaları məzəmmət etdin,","poem":1},{"lineBreak":true},{"text":"Çünki onlar lənətləndi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Həqarəti, tənəni məndən uzaq et,","poem":1},{"lineBreak":true},{"text":"Göstərişlərinə əməl etmişəm.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Başçılar yığılıb mənim üçün qəsd qurdular,","poem":1},{"lineBreak":true},{"text":"Lakin mən qulun qaydalarını dərin düşünürəm.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Göstərişlərin mənə zövq verir,","poem":1},{"lineBreak":true},{"text":"Onlar mənim məsləhətçilərimdir.","poem":1}]},{"type":"heading","content":["Dalet"]},{"type":"verse","number":25,"content":[{"text":"Mən torpağa düşmüşəm,","poem":1},{"lineBreak":true},{"text":"Öz sözünə görə məni həyata qaytar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Keçdiyim yolları Sənə bəlli edəndə cavab verdin,","poem":1},{"lineBreak":true},{"text":"Mənə qaydalarını öyrət.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarının yollarını mənə Özün izah et,","poem":1},{"lineBreak":true},{"text":"Xariqələrin barədə dərin düşünüm.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kədərdən canım üzülüb,","poem":1},{"lineBreak":true},{"text":"Öz sözünə görə mənə güc ver.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Məni yanlış yoldan uzaqlaşdır,","poem":1},{"lineBreak":true},{"text":"Qanununa görə mənə lütf göstər.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mən sədaqət yolunu seçdim,","poem":1},{"lineBreak":true},{"text":"Hökmlərini gözümün önünə gətirdim.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sənin göstərişlərindən yapışmışam,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, qoyma xəcalətli qalım.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Qəlbimin düşüncəsini genişləndirərkən","poem":1},{"lineBreak":true},{"text":"Əmrlərinin yolu ilə getməyə səy göstərəcəyəm.","poem":1}]},{"type":"heading","content":["He"]},{"type":"verse","number":33,"content":[{"text":"Ya Rəbb, Sən mənə qaydalarının yolunu öyrət,","poem":1},{"lineBreak":true},{"text":"Onlara axıradək əməl edəcəyəm.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mənə ağıl ver, qanununa görə yaşayım,","poem":1},{"lineBreak":true},{"text":"Bütün qəlbimlə ona bağlanım.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Mənə əmrlərinin yollarını göstər,","poem":1},{"lineBreak":true},{"text":"Bu yollardan zövq alaram.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Qəlbimi haram qazanca deyil,","poem":1},{"lineBreak":true},{"text":"Göstərişlərinə tərəf yönəlt.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Qoyma gözlərim fani şeylərə baxsın,","poem":1},{"lineBreak":true},{"text":"Öz yolunda mənə həyat bəxş et.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Səndən qorxanlara verdiyin vədini","poem":1},{"lineBreak":true},{"text":"Qulun üçün həyata keçirt.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Qorxduğum tənələri məndən sovuşdur,","poem":1},{"lineBreak":true},{"text":"Sənin hökmlərin nə yaxşıdır!","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarının həsrətini çəkirəm,","poem":1},{"lineBreak":true},{"text":"Salehliyinlə məni yaşat.","poem":1}]},{"type":"heading","content":["Vav"]},{"type":"verse","number":41,"content":[{"text":"Ya Rəbb, mənə məhəbbətini göstər,","poem":1},{"lineBreak":true},{"text":"Kəlamına görə məni qurtar!","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Məni təhqir edənlərə layiqincə cavab verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin sözlərinə güvənirəm.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Qoy həqiqət kəlamı dilimdən düşməsin,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin hökmlərinə ümid bağlamışam.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Daim, əbədi olaraq","poem":1},{"lineBreak":true},{"text":"Qanununa bağlı qalacağam.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Azad gəzib-dolaşacağam,","poem":1},{"lineBreak":true},{"text":"Çünki qayda-qanunlarını axtarmışam.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Padşahların hüzurunda göstərişlərindən danışacağam,","poem":1},{"lineBreak":true},{"text":"Bundan utanmayacağam.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Sənin əmrlərindən zövq alıram,","poem":1},{"lineBreak":true},{"text":"Onları sevirəm.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Sevdiyim əmrlərinə tərəf əl açacağam,","poem":1},{"lineBreak":true},{"text":"Sənin qaydalarını dərindən düşünəcəyəm.","poem":1}]},{"type":"heading","content":["Zayin"]},{"type":"verse","number":49,"content":[{"text":"Sən quluna verdiyin sözü xatırla,","poem":1},{"lineBreak":true},{"text":"Bu sözünlə mənə ümid vermisən.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Əzab çəkəndə bundan təsəlli tapıram ki,","poem":1},{"lineBreak":true},{"text":"Kəlamın məni həyata qaytaracaq.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Lovğalar mənə çox istehza etdilər,","poem":1},{"lineBreak":true},{"text":"Amma Sənin qanunundan dönmədim.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Əzəldən var olan hökmlərini xatırladıqca,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, bunlardan təsəlli tapıram.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Qanununu atan pisləri görərkən","poem":1},{"lineBreak":true},{"text":"Qəzəb məni bürüyür.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Sənin qaydalarını bu qürbət eldə","poem":1},{"lineBreak":true},{"text":"İlahi tək oxuyuram.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Hər gecə adını yadıma salıram,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, qanununa bağlı qalıram.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Bu mənə bir adət oldu,","poem":1},{"lineBreak":true},{"text":"Sənin qayda-qanunlarını yerinə yetirdim.","poem":1}]},{"type":"heading","content":["Xet"]},{"type":"verse","number":57,"content":[{"text":"Ya Rəbb, mənim nəsibimsən,","poem":1},{"lineBreak":true},{"text":"Sözlərinə bağlı qalmaq üçün vəd etmişəm.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Bütün qəlbimlə Sənə yalvarıram,","poem":1},{"lineBreak":true},{"text":"Sən Öz kəlamına görə mənə lütf göstər.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Tutduğum yollara nəzər salmışam,","poem":1},{"lineBreak":true},{"text":"Hər addımımı göstərişlərinə tərəf yönəltmişəm.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"Əmrlərinə bağlanmaq üçün tələsirəm,","poem":1},{"lineBreak":true},{"text":"Bunun üçün ləngimirəm.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Pis adamlar mənə kəmənd atarkən","poem":1},{"lineBreak":true},{"text":"Qanununu unutmadım.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Adil hökmlərinə görə Sənə şükür etmək üçün","poem":1},{"lineBreak":true},{"text":"Gecə yarısı qalxıram.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"Səndən qorxanların hamısı ilə,","poem":1},{"lineBreak":true},{"text":"Qayda-qanunlarına bağlı qalanlarla dostam.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Ya Rəbb, yer üzü məhəbbətinə bürünüb,","poem":1},{"lineBreak":true},{"text":"Mənə qaydalarını öyrət.","poem":1}]},{"type":"heading","content":["Tet"]},{"type":"verse","number":65,"content":[{"text":"Ya Rəbb, verdiyin sözə görə","poem":1},{"lineBreak":true},{"text":"Quluna xeyirxahlıq etmisən.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Mənə ağıl, bilik öyrət,","poem":1},{"lineBreak":true},{"text":"Çünki əmrlərinə inanıram.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"Əzaba düşməzdən əvvəl yoldan azırdım,","poem":1},{"lineBreak":true},{"text":"Amma indi mən kəlamına bağlıyam.","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"Nə qədər yaxşısan, xeyirxahlıq edirsən!","poem":1},{"lineBreak":true},{"text":"Mənə qaydalarını öyrət.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"Lovğalar yalanları ilə mənə qara yaxırlar,","poem":1},{"lineBreak":true},{"text":"Amma mən bütün qəlbimlə qayda-qanunlarını yerinə yetirirəm.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"Onların ürəkləri piylənərək daş bağlayıb,","poem":1},{"lineBreak":true},{"text":"Mənsə qanunundan zövq alıram.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"Çəkdiyim əzabın xeyri mənə bu olub:","poem":1},{"lineBreak":true},{"text":"Sənin qaydalarını öyrənirəm.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"Ağzından çıxan qanun mənim üçün","poem":1},{"lineBreak":true},{"text":"Minlərlə qızıldan, gümüşdən daha qiymətlidir.","poem":1}]},{"type":"heading","content":["Yod"]},{"type":"verse","number":73,"content":[{"text":"Əllərinlə yaranmışam, mənə surət vermisən,","poem":1},{"lineBreak":true},{"text":"Mənə qabiliyyət ver, qoy əmrlərini öyrənim.","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"Səndən qorxanlar məni görərkən sevinsinlər,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin sözünə ümid bağlamışam.","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"Ya Rəbb, bilirəm ki, hökmlərin ədalətlidir,","poem":1},{"lineBreak":true},{"text":"Mənə əzab çəkdirsən də, sədaqətin yox olmur.","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"Quluna verdiyin kəlama görə","poem":1},{"lineBreak":true},{"text":"Məhəbbətin mənə təsəlli versin.","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"Mənə mərhəmət et ki, yaşayım,","poem":1},{"lineBreak":true},{"text":"Çünki qanunundan zövq alıram.","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"Mənim barəmdə yalan danışan lovğaları utandır,","poem":1},{"lineBreak":true},{"text":"Çünki mən qayda-qanunlarını dərindən düşünürəm.","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"Səndən qorxanlar yanıma gəlsin,","poem":1},{"lineBreak":true},{"text":"Onlar Sənin göstərişlərini bilənlərdir.","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"Qaydalarına görə mənim qəlbim kamil olsun,","poem":1},{"lineBreak":true},{"text":"Qoy heç zaman xəcalət çəkməyim!","poem":1}]},{"type":"heading","content":["Kaf"]},{"type":"verse","number":81,"content":[{"text":"Qurtuluş həsrətini çəkməkdən qəlbimdə tab qalmayıb,","poem":1},{"lineBreak":true},{"text":"Sözünə ümid bağlamışam.","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"Sözünün intizarından gözümün nuru sönür.","poem":1},{"lineBreak":true},{"text":"Deyirəm: «Nə vaxt mənə təsəlli verəcəksən?»","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"Tüstü içindəki tuluq kimi oldum,","poem":1},{"lineBreak":true},{"text":"Amma qaydalarını unutmuram.","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"Qulun daha nə qədər gözləsin?","poem":1},{"lineBreak":true},{"text":"Məni təqib edənləri nə vaxt mühakimə edəcəksən?","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"Qanununu pozan lovğa insanlar","poem":1},{"lineBreak":true},{"text":"Mənim üçün quyu qazıblar.","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"Sənin bütün əmrlərin etibarlıdır.","poem":1},{"lineBreak":true},{"text":"Kömək et! Məni yalançı insanlar təqib edir.","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"Az qaldı ki, yer üzündən məni yox etsinlər,","poem":1},{"lineBreak":true},{"text":"Lakin qayda-qanunlarından çıxmamışam.","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"Məhəbbətinə görə mənə həyat ver,","poem":1},{"lineBreak":true},{"text":"Ağzından çıxan göstərişlərə bağlı qalım.","poem":1}]},{"type":"heading","content":["Lamed"]},{"type":"verse","number":89,"content":[{"text":"Ya Rəbb, sözün əbədidir,","poem":1},{"lineBreak":true},{"text":"Göylərdədir, dəyişməzdir.","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"Sədaqətin nəsildən-nəslə çatır,","poem":1},{"lineBreak":true},{"text":"Yer üzünü Sən qurmusan, möhkəm qalır.","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"Hökmlərinə görə bu günədək hər şey qalır,","poem":1},{"lineBreak":true},{"text":"Onlar Sənin xidmətində dayanırlar.","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"Sənin qanunundan zövq almasaydım,","poem":1},{"lineBreak":true},{"text":"Əzab çəkməkdən həlak olardım.","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarını heç vaxt unutmaram,","poem":1},{"lineBreak":true},{"text":"Çünki onlarla məni həyata qaytarmısan.","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"Qurtar məni, mən Səninəm,","poem":1},{"lineBreak":true},{"text":"Qayda-qanunlarını axtarmışam.","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"Pislər məni öldürmək üçün pusqu qurarkən","poem":1},{"lineBreak":true},{"text":"Mən Sənin göstərişlərinin üzərində düşünürəm.","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"Görmüşəm ki, hər kamil şeyin qarşısına bir hədd qoyulur,","poem":1},{"lineBreak":true},{"text":"Sənin əmrlərin isə sərhəd tanımır.","poem":1}]},{"type":"heading","content":["Mem"]},{"type":"verse","number":97,"content":[{"text":"Qanununu nə qədər sevirəm!","poem":1},{"lineBreak":true},{"text":"Həmişə onun üzərində dərindən düşünürəm.","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"Əmrlərin məni düşmənlərimdən daha müdrik edir,","poem":1},{"lineBreak":true},{"text":"Çünki onlar həmişə mənimlədir.","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"Bütün müəllimlərimdən daha aqil olmuşam,","poem":1},{"lineBreak":true},{"text":"Çünki göstərişlərin üzərində dərindən düşünürəm.","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"Ağsaqqallardan da artıq dərrakəliyəm,","poem":1},{"lineBreak":true},{"text":"Çünki qayda-qanunlarına əməl edirəm.","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"Ayağımı hər pis yoldan kənar qoydum ki,","poem":1},{"lineBreak":true},{"text":"Sözlərinə bağlı qalım.","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"Hökmlərindən dönməmişəm,","poem":1},{"lineBreak":true},{"text":"Çünki məni Sən belə öyrətmisən.","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"Vədlərin damağıma necə də ləzzət verir!","poem":1},{"lineBreak":true},{"text":"Onlar dilimdə baldan şirindir.","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarına görə dərrakəliyəm,","poem":1},{"lineBreak":true},{"text":"Buna görə hər yanlış yola nifrət edirəm.","poem":1}]},{"type":"heading","content":["Nun"]},{"type":"verse","number":105,"content":[{"text":"Sözün addımıma çıraqdır,","poem":1},{"lineBreak":true},{"text":"Yollarıma işıqdır.","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"Ədalətli hökmlərinə bağlı qalmaq üçün and içmişəm,","poem":1},{"lineBreak":true},{"text":"Yerinə yetirəcəyəm.","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"Ya Rəbb, nə qədər əzab çəkmişəm!","poem":1},{"lineBreak":true},{"text":"Öz sözünə görə həyatımı qoru.","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"Ya Rəbb, sidq ürəkdən etdiyim həmdi qəbul et,","poem":1},{"lineBreak":true},{"text":"Mənə Öz hökmlərini öyrət.","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"Həyatım daim təhlükəyə düşdü,","poem":1},{"lineBreak":true},{"text":"Amma qanununu unutmadım.","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"Pislər mənə tələ quranda belə,","poem":1},{"lineBreak":true},{"text":"Mən Sənin qayda-qanunlarını pozmadım.","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"Əbədilik Sənin göstərişlərinə malikəm,","poem":1},{"lineBreak":true},{"text":"Çünki onlar qəlbimə sevinc verir.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"Qəlbimi əbədilik, sonsuzadək","poem":1},{"lineBreak":true},{"text":"Qaydalarına əməl etməyə meyl etdirmişəm.","poem":1}]},{"type":"heading","content":["Samek"]},{"type":"verse","number":113,"content":[{"text":"İkiüzlü insanlara nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Qanununu isə sevirəm.","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"Sən pənahgahım, sipərimsən,","poem":1},{"lineBreak":true},{"text":"Sözünə ümid bağlamışam.","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"Siz ey pislər, məndən uzaq olun!","poem":1},{"lineBreak":true},{"text":"Qoy Allahımın əmrlərinə əməl edim.","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"Kəlamınla mənə dayaq ol ki, yaşayım,","poem":1},{"lineBreak":true},{"text":"Ümidim boşa çıxmasın, utanmayım.","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"Özün mənə dayaq ol, qoy mən nicat tapım,","poem":1},{"lineBreak":true},{"text":"Sənin qaydalarını həmişə nəzərimdə tutum.","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"Qaydalarını atanları Özündən kənar edirsən,","poem":1},{"lineBreak":true},{"text":"Çünki onların bütün fəndləri boşdur.","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"Yer üzünün bütün pislərini tullantı hesab edirsən,","poem":1},{"lineBreak":true},{"text":"Buna görə göstərişlərini sevirəm.","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"Zəhmindən bədənim lərzəyə gəlir,","poem":1},{"lineBreak":true},{"text":"Hökmlərindən çox qorxuram.","poem":1}]},{"type":"heading","content":["Ayin"]},{"type":"verse","number":121,"content":[{"text":"Ədalətli, düz işlər görmüşəm,","poem":1},{"lineBreak":true},{"text":"Məni zülmkarlara təslim etmə.","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"Qulunun xeyri üçün zamin dur,","poem":1},{"lineBreak":true},{"text":"Qoyma lovğa insanlar mənə zülm etsin.","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"Xilasını, haqq sözünə əməl olunmasını gözləməkdən","poem":1},{"lineBreak":true},{"text":"Gözümün nuru sönür.","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"Quluna məhəbbət göstər,","poem":1},{"lineBreak":true},{"text":"Qaydalarını mənə öyrət.","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"Qulunam, mənə ağıl ver ki,","poem":1},{"lineBreak":true},{"text":"Sənin göstərişlərini dərk edim.","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"Ya Rəbb, insanlar qanununu pozdular,","poem":1},{"lineBreak":true},{"text":"Vaxtı çatıb, onlar üçün bir tədbir gör.","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"Qızıldan, saf qızıldan çox","poem":1},{"lineBreak":true},{"text":"Sənin əmrlərini sevirəm.","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"Bəli, bütün qayda-qanunlarına görə","poem":1},{"lineBreak":true},{"text":"Mən düz yolla gedirəm,","poem":1},{"lineBreak":true},{"text":"Bütün səhv yollarasa nifrət edirəm.","poem":1}]},{"type":"heading","content":["Pe"]},{"type":"verse","number":129,"content":[{"text":"Göstərişlərinin heyrətamizliyinə görə","poem":1},{"lineBreak":true},{"text":"Onlara ürəkdən əməl edirəm.","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"Kəlamının açıqlanması nur saçır,","poem":1},{"lineBreak":true},{"text":"Hər nadanı ağıllandırır.","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"Ağız açıb ah-zar edirəm,","poem":1},{"lineBreak":true},{"text":"Çünki əmrlərinin həsrətini çəkirəm.","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"Adını sevənlər üçün etdiyin adətə görə","poem":1},{"lineBreak":true},{"text":"Mənə bax və lütf göstər.","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"Kəlamınla addımlarımı möhkəmləndir,","poem":1},{"lineBreak":true},{"text":"Qoy heç bir təqsirim mənə hakimlik etməsin.","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"Məni insanların zülmündən qurtar,","poem":1},{"lineBreak":true},{"text":"Qoy Sənin qayda-qanunlarına bağlı qalım.","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"Üzün qulunun üstünə nur saçsın,","poem":1},{"lineBreak":true},{"text":"Sən mənə qaydalarını öyrət.","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"Gözlərimdən sellər kimi yaş axır,","poem":1},{"lineBreak":true},{"text":"Çünki insanlar qanununa bağlı qalmırlar.","poem":1}]},{"type":"heading","content":["Sade"]},{"type":"verse","number":137,"content":[{"text":"Ya Rəbb, adilsən,","poem":1},{"lineBreak":true},{"text":"Hökmlərin doğrudur.","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"Buyurduğun göstərişlər ədalətlidir,","poem":1},{"lineBreak":true},{"text":"Onlar tamamilə etibarlıdır.","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"Qeyrətim məni yandırıb-yaxıb,","poem":1},{"lineBreak":true},{"text":"Çünki düşmənlərim Sənin sözlərini unudub.","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"Sənin kəlamın çox safdır,","poem":1},{"lineBreak":true},{"text":"Bu qulun onu sevir.","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"Kiçik sayılsam da, mənə xor baxsalar da,","poem":1},{"lineBreak":true},{"text":"Qayda-qanunlarını unutmamışam.","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"Salehliyin əbədi salehlikdir,","poem":1},{"lineBreak":true},{"text":"Sənin qanunun həqiqətdir.","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"Başıma sıxıntı və məşəqqət gəldi,","poem":1},{"lineBreak":true},{"text":"Amma Sənin əmrlərin mənə zövq verdi.","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"Sənin göstərişlərin həmişə ədalətlidir,","poem":1},{"lineBreak":true},{"text":"Mənə ağıl ver ki, yaşayım.","poem":1}]},{"type":"heading","content":["Qof"]},{"type":"verse","number":145,"content":[{"text":"Ya Rəbb, cavab ver! Bütün qəlbimlə Səni səsləyirəm,","poem":1},{"lineBreak":true},{"text":"Sənin qaydalarına əməl edəcəyəm.","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"Səni səslədim, məni qurtar,","poem":1},{"lineBreak":true},{"text":"Qoy göstərişlərinə bağlı qalım.","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"Dan yeri sökülməzdən əvvəl qalxıb Səni imdada çağırıram,","poem":1},{"lineBreak":true},{"text":"Çünki ümidimi Sənin sözlərinə bağlayıram.","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"Gecə boyu gözümə yuxu getmir,","poem":1},{"lineBreak":true},{"text":"Kəlamını dərindən düşünürəm.","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"Məhəbbətinə görə mənim səsimi eşit,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, hökmlərinə görə mənə həyat bəxş et.","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"Şər ardınca qaçanlar mənə yaxınlaşdılar,","poem":1},{"lineBreak":true},{"text":"Onlar Sənin qanunundan uzaqlaşdılar.","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sən mənə yaxınsan,","poem":1},{"lineBreak":true},{"text":"Bütün əmrlərin həqiqətdir.","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"Göstərişlərini lap əvvəldən öyrənirəm,","poem":1},{"lineBreak":true},{"text":"Əbədi qalsın deyə öyüdlərini verdin.","poem":1}]},{"type":"heading","content":["Reş"]},{"type":"verse","number":153,"content":[{"text":"Çəkdiyim əzabı gör, məni qurtar,","poem":1},{"lineBreak":true},{"text":"Çünki qanununu unutmamışam.","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"Münaqişəmi həll edib Özün məni azad et,","poem":1},{"lineBreak":true},{"text":"Mənə kəlamına görə həyat bəxş et.","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"Pislər qurtuluşdan uzaqdır,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Sənin qaydalarını axtarmırlar.","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"Ya Rəbb, mərhəmətin çoxdur,","poem":1},{"lineBreak":true},{"text":"Hökmlərinə görə məni yaşat.","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"Düşmənlərim, məni təqib edənlər çoxdur,","poem":1},{"lineBreak":true},{"text":"Lakin Sənin göstərişlərindən dönmədim.","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"Bu xainlərə ikrahla baxıram,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin vədinə bağlı qalmayıblar.","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"Sənin qayda-qanunlarını gör nə qədər sevirəm,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, məhəbbətinə görə mənə həyat ver.","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"Sözlərinin mahiyyəti həqiqətdir,","poem":1},{"lineBreak":true},{"text":"Bütün ədalətli hökmlərin əbədidir.","poem":1}]},{"type":"heading","content":["Sin və Şin"]},{"type":"verse","number":161,"content":[{"text":"Başçılar boş yerə məni təqib edir,","poem":1},{"lineBreak":true},{"text":"Amma ürəyim Sənin sözlərindən qorxur.","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"Çoxlu qənimət tapan bir insan kimi","poem":1},{"lineBreak":true},{"text":"Sənin kəlamın məni sevindirir.","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"Yalandan zəhləm gedir, iyrənirəm,","poem":1},{"lineBreak":true},{"text":"Çünki qanununu sevirəm.","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"Ədalətli hökmlərinə görə","poem":1},{"lineBreak":true},{"text":"Hər gün yeddi dəfə Sənə həmd edirəm.","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"Qanununu sevənlər böyük əmin-amanlıq tapırlar,","poem":1},{"lineBreak":true},{"text":"Onlar heç nə ilə büdrəməzlər.","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"Ya Rəbb, xilasına ümid bəsləmişəm,","poem":1},{"lineBreak":true},{"text":"Əmrlərinə əməl etmişəm.","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"Göstərişlərinə ürəkdən bağlanmışam,","poem":1},{"lineBreak":true},{"text":"Onları çox sevirəm!","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"Qayda-qanunlarına, göstərişlərinə bağlı qalıram,","poem":1},{"lineBreak":true},{"text":"Çünki bütün yollarım Sənin hüzurundadır.","poem":1}]},{"type":"heading","content":["Tav"]},{"type":"verse","number":169,"content":[{"text":"Ya Rəbb, mənim fəryadım qoy Sənə çatsın,","poem":1},{"lineBreak":true},{"text":"Mənə Öz sözünə görə ağıl ver.","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"Qoy yalvarışım hüzuruna çatsın,","poem":1},{"lineBreak":true},{"text":"Məni Öz kəlamınla azad et.","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"Qoy dilimdən həmdlər tökülsün,","poem":1},{"lineBreak":true},{"text":"Mənə qaydalarını öyrətmisən.","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"Sənin kəlamını dilim tərənnüm etsin,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin bütün əmrlərin ədalətlidir.","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"Sənin əlin mənə kömək etsin,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin qayda-qanunlarını seçdim.","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"Ya Rəbb, qurtuluşun üçün həsrət çəkirəm,","poem":1},{"lineBreak":true},{"text":"Qanunundan zövq alıram.","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"Mənə həyat bəxş elə, qoy Sənə həmd oxuyum,","poem":1},{"lineBreak":true},{"text":"Hökmlərin qoy mənə kömək olsun.","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"İtən quzu kimi azmışam, qulunu axtar,","poem":1},{"lineBreak":true},{"text":"Çünki əmrlərini unutmamışam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}