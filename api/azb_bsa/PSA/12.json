{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Məzmur 12"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun səkkiz simli alətlərin müşayiəti ilə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, bizə yardım et, mömin insan qalmayıb,","poem":1},{"lineBreak":true},{"text":"Bəşər övladları arasında vəfalılar qurtarıb.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hər kəs başqasına yalan söyləyir,","poem":1},{"lineBreak":true},{"text":"Ağzı yalan danışır, ikiüzlülük edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qoy Rəbb yalan danışan hər ağzı yumsun,","poem":1},{"lineBreak":true},{"text":"Hər lovğa dili kəssin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlar deyir ki, biz dilimizlə zəfər çalacağıq.","poem":1},{"lineBreak":true},{"text":"Bu ağız bizdədirsə, kim bizə ağalıq edə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb deyir: «İndi qalxacağam,","poem":1},{"lineBreak":true},{"text":"Çünki fəqirlərə zülm edilir,","poem":1},{"lineBreak":true},{"text":"Məzlumlar nalə çəkir, qurtuluş istəyir.","poem":1},{"lineBreak":true},{"text":"Mən bunu onlara verəcəyəm».","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbbin kəlamları pakdır,","poem":1},{"lineBreak":true},{"text":"Kürədə əridilən, yeddi dəfə təmizlənən gümüş kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sən, ya Rəbb, onları qoru,","poem":1},{"lineBreak":true},{"text":"Bu nəsildən onların hər birini əbədilik hifz et.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bəşər övladları arasında namərdlik artarkən","poem":1},{"lineBreak":true},{"text":"Hər yanda pislər gəzər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}