{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Məzmur 120"]},{"type":"hebrew_subtitle","content":["Ziyarət nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Dar gündə Rəbbi səslədim,","poem":1},{"lineBreak":true},{"text":"O mənə cavab verdi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dedim: «Ya Rəbb, yalançı dodaqlardan,","poem":1},{"lineBreak":true},{"text":"Fitnəkar dillərdən canımı qurtar».","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey fitnəkar dil, sənə nə veriləcək?","poem":1},{"lineBreak":true},{"text":"Bu işinin əvəzi nə ilə ödəniləcək?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cəngavərin iti oxları ilə,","poem":1},{"lineBreak":true},{"text":"Süpürgə ağacının odlu közləri ilə!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yazıq canım, Meşekdə qərib olmuşam,","poem":1},{"lineBreak":true},{"text":"Qedar çadırlarında yaşayıram!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mənim belə yerdə,","poem":1},{"lineBreak":true},{"text":"Sülhə nifrət edənlərin içində yaşamağım bəsdir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən sülh sevirəm, buna görə danışıram,","poem":1},{"lineBreak":true},{"text":"Onlarsa müharibə üçün çalışır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}