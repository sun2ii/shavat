tent":[{"lineBreak":true},{"text":"Gündüz günəşin ziyanı sənə dəyməz,","poem":1},{"lineBreak":true},{"text":"Gecə ay da sənə zərər verməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbb səni hər cür şərdən saxlayar,","poem":1},{"lineBreak":true},{"text":"Canını qoruyar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb gediş-gəlişini hifz edər","poem":1},{"lineBreak":true},{"text":"İndidən sonsuza qədər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}