{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Məzmur 122"]},{"type":"hebrew_subtitle","content":["Davudun ziyarət nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Mənə «Rəbbin evinə gedək» deyilərkən sevindim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim, sənin darvazalarından keçdim,","poem":1},{"lineBreak":true},{"text":"Torpağına qədəm qoydum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bu, Yerusəlim şəhəridir,","poem":1},{"lineBreak":true},{"text":"Çox sıx tikilmişdir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"İsrail üçün verilən şəhadət naminə","poem":1},{"lineBreak":true},{"text":"Qəbilələr, Rəbbin qəbilələri","poem":1},{"lineBreak":true},{"text":"Rəbbin isminə şükür etmək üçün","poem":1},{"lineBreak":true},{"text":"Buranı ziyarət etməyə gəlirlər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hökm üçün burada taxtlar qurulub,","poem":1},{"lineBreak":true},{"text":"Bu taxtlarda Davud sülaləsi oturub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hamı Yerusəlim üçün sülh diləsin:","poem":1},{"lineBreak":true},{"text":"«Qoy səni sevənlər dinc həyat sürsün!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoy qala divarlarının içində sülh olsun!","poem":1},{"lineBreak":true},{"text":"Qoy saraylarındakılar dinc yaşasın!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yoldaşlarıma, dostlarıma görə","poem":1},{"lineBreak":true},{"text":"«Səndə sülh olsun!» deyirəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Allahımız Rəbbin evinə görə","poem":1},{"lineBreak":true},{"text":"Sənə bəxtiyarlıq diləyirəm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}