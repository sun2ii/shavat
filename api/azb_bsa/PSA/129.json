{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Məzmur 129"]},{"type":"hebrew_subtitle","content":["Ziyarət nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Qoy İsrail söyləsin:","poem":1},{"lineBreak":true},{"text":"«Mənə gəncliyimdən bəri əzab verdilər.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bəli, gəncliyimdən bəri mənə əzab verdilər,","poem":1},{"lineBreak":true},{"text":"Lakin məğlub edə bilmədilər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Elə bil kürəyimdə kotan sürüblər,","poem":1},{"lineBreak":true},{"text":"Qamçılarla bədənimə uzun-uzun şırım çəkiblər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbb isə adildir,","poem":1},{"lineBreak":true},{"text":"Pislərin buxovlarını qırdı».","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Siona nifrət bəsləyənlərin hamısı","poem":1},{"lineBreak":true},{"text":"Qoy xəcalət içində geri qovulsun!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qoy cücərmədən solsunlar,","poem":1},{"lineBreak":true},{"text":"Damda bitən ot kimi olsunlar!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, biçinçinin ovcunu,","poem":1},{"lineBreak":true},{"text":"Dərz bağlayanın qucağını doldurmaz!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yoldan keçən onlara belə deməz:","poem":1},{"lineBreak":true},{"text":"«Rəbb sizə xeyir-dua versin,","poem":1},{"lineBreak":true},{"text":"Sizə Rəbbin ismi ilə alqış olsun!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}