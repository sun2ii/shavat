{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Məzmur 130"]},{"type":"hebrew_subtitle","content":["Ziyarət nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, dərinliklərdən","poem":1},{"lineBreak":true},{"text":"Səni səsləyirəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, səsimi eşit,","poem":1},{"lineBreak":true},{"text":"Yalvarış səsimi yaxşı dinlə.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, bizim təqsirlərimizi siyahıya alsan,","poem":1},{"lineBreak":true},{"text":"Bəs, ey Xudavənd, kim bunun qarşısında dayana bilər?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma Sən bağışlayansan,","poem":1},{"lineBreak":true},{"text":"Ona görə hamı Səndən çəkinir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbbi gözləyirəm, döyünən ürəyim gözləyir,","poem":1},{"lineBreak":true},{"text":"Onun sözünə ümid edirəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Keşikçilər səhərin açılmasını gözlər,","poem":1},{"lineBreak":true},{"text":"Bəli, keşikçilər səhərin açılmasını gözlər,","poem":1},{"lineBreak":true},{"text":"Qəlbimsə bundan da çox Xudavəndin həsrətini çəkər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey İsrail, Rəbbə ümidini bağla!","poem":1},{"lineBreak":true},{"text":"Çünki Rəbdə məhəbbət var,","poem":1},{"lineBreak":true},{"text":"Onda bol-bol qurtuluş var.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey İsrail, O səni","poem":1},{"lineBreak":true},{"text":"Bütün təqsirlərindən azad edər!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}