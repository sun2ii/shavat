{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Məzmur 132"]},{"type":"hebrew_subtitle","content":["Ziyarət nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Davudu,","poem":1},{"lineBreak":true},{"text":"Çəkdiyi bütün əzabları,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbə etdiyi andı,","poem":1},{"lineBreak":true},{"text":"Yaqubun qüdrətli Allahına etdiyi əhdi yada sal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O dedi: «Öz evimdə yaşamaram,","poem":1},{"lineBreak":true},{"text":"Yatağımda yatmaram,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gözümə yuxu getməz,","poem":1},{"lineBreak":true},{"text":"Gözlərimi yummaram","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbə layiq bir yer,","poem":1},{"lineBreak":true},{"text":"Yaqubun qüdrətli Allahına bir məskən tapana qədər».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Əhd sandığının Efratada olduğunu eşitdik,","poem":1},{"lineBreak":true},{"text":"Onu Yaar tarlalarında tapdıq.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dedik: «Gəlin, Onun məkanına gedək,","poem":1},{"lineBreak":true},{"text":"Kətilində səcdə edək».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb, qüvvənin rəmzi olan sandığınla birgə","poem":1},{"lineBreak":true},{"text":"İstirahət edəcəyin yerə qalx.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kahinlərin həqiqətə bürünsün,","poem":1},{"lineBreak":true},{"text":"Möminlərin Səni mədh etsin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qulun Davudun xatirinə","poem":1},{"lineBreak":true},{"text":"Məsh etdiyindən üz döndərmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rəbb Davuda sədaqətlə and içdi,","poem":1},{"lineBreak":true},{"text":"Bu andından dönməz:","poem":1},{"lineBreak":true},{"text":"«Belindən gələn oğullarından birini","poem":1},{"lineBreak":true},{"text":"Səndən sonra taxtında oturdacağam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Əgər övladların əhdimə,","poem":1},{"lineBreak":true},{"text":"Onlara öyrədəcəyim göstərişlərə əməl edərlərsə,","poem":1},{"lineBreak":true},{"text":"Onların oğulları da","poem":1},{"lineBreak":true},{"text":"Sonsuza qədər sənin taxtında oturacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Çünki Rəbb Sionu seçdi,","poem":1},{"lineBreak":true},{"text":"Orada Öz məskənini salmaq istədi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dedi: «Bura əbədi olaraq istirahət edəcəyim yerdir,","poem":1},{"lineBreak":true},{"text":"İstəyirəm ki, burada məskən salım.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bu yerə bol ruzi-bərəkət verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Buradakı fəqirlərə doyunca ərzaq verəcəyəm.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kahinlərini zəfərə bürüyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Möminləri sevinclə mədh oxuyacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Burada Davud sülaləsindən güclü hökmdar yetirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyim üçün bir çıraq hazır etmişəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Düşmənlərini xəcalətə salacağam,","poem":1},{"lineBreak":true},{"text":"Lakin onun tacı nur saçacaq».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}