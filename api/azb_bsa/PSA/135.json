{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"heading","content":["Məzmur 135"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Rəbbin isminə həmd edin,","poem":1},{"lineBreak":true},{"text":"Ey Rəbbin qulları, həmd edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Rəbbin evində xidmət edənlər,","poem":1},{"lineBreak":true},{"text":"Allahımızın evinin həyətində duranlar,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb yaxşıdır, Rəbbə həmd edin,","poem":1},{"lineBreak":true},{"text":"O nə qədər şirindir, isminə tərənnüm oxuyun!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Rəbb Özü üçün Yaqubu seçdi,","poem":1},{"lineBreak":true},{"text":"İsraili Özünə məxsus xalq olaraq seçdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bilirəm, Rəbb əzəmətlidir,","poem":1},{"lineBreak":true},{"text":"Xudavəndimiz bütün allahlardan üstündür.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Göylərdə, yer üzündə,","poem":1},{"lineBreak":true},{"text":"Dənizlərdə, bütün ümmanlarda Rəbb istədiyini edər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yerin ucqarlarından buludları qaldırar,","poem":1},{"lineBreak":true},{"text":"Şimşəkləri çaxdırar, yağış yağdırar,","poem":1},{"lineBreak":true},{"text":"Küləkləri öz mənbələrindən çıxarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb Misirlilərin ilk oğullarını qırdı,","poem":1},{"lineBreak":true},{"text":"Hər insanın, hər heyvanın ilk balasını öldürdü.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Misir, sənin daxilində,","poem":1},{"lineBreak":true},{"text":"Fironla bütün əyanlarının üzərində","poem":1},{"lineBreak":true},{"text":"O, əlamətlərini, möcüzələrini göstərdi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nə qədər millətləri qırdı,","poem":1},{"lineBreak":true},{"text":"Qüdrətli padşahları öldürdü.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Emorluların padşahı Sixonu,","poem":1},{"lineBreak":true},{"text":"Başan padşahı Oqu,","poem":1},{"lineBreak":true},{"text":"Bütün Kənan padşahlarını qırdı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onların torpaqlarını, mülklərini","poem":1},{"lineBreak":true},{"text":"Öz xalqı İsrailə irs olaraq verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, Sənin adın əbədidir!","poem":1},{"lineBreak":true},{"text":"Ey Rəbb, ismin nəsillərdən-nəsillərə çatır!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb xalqına haqq verəcək,","poem":1},{"lineBreak":true},{"text":"Qullarına rəhm edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amma millətlərin bütləri qızıldan, gümüşdən düzəlmişdir,","poem":1},{"lineBreak":true},{"text":"Onlar insan əllərinin işidir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ağızları var, danışa bilmir,","poem":1},{"lineBreak":true},{"text":"Gözləri var, amma görmür,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qulaqları var, eşitmir,","poem":1},{"lineBreak":true},{"text":"Ağızlarından nəfəs gəlmir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bütləri düzəldən, onlara güvənən insanlar","poem":1},{"lineBreak":true},{"text":"Bu bütlər kimi cansız olacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ey İsraillilər, Rəbbə alqış edin!","poem":1},{"lineBreak":true},{"text":"Ey Harun nəsli, Rəbbə alqış söyləyin!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ey Levi nəsli, Rəbbə alqış edin!","poem":1},{"lineBreak":true},{"text":"Ey Rəbdən qorxanlar, Ona alqış söyləyin!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rəbbə Siondan alqış oxunsun!","poem":1},{"lineBreak":true},{"text":"Rəbb Yerusəlimdə yaşayır!","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}