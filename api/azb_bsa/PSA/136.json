{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"heading","content":["Məzmur 136"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə şükür edin, ona görə ki yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Allahların Allahına şükür edin,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hökmranların Hökmranına şükür edin,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yalnız Odur böyük xariqələr yaradan,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Odur göyləri hikməti ilə quran,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Odur yerin təməlini sular üstündə qoyan,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Odur böyük işıqları yaradan,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gündüzü günəşin hökmü altına saldı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gecə ay-ulduzların hökmü altında oldu,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"O, Misirlilərin ilk oğullarını qırdı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İsrail nəslini Misirlilərin arasından çıxartdı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İsrailliləri qüdrətli əli, uzanan qolu ilə apardı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qırmızı dənizi iki yerə yardı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"İsrailliləri dənizin ortasından keçirtdi,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fironla ordusunu Qırmızı dənizdə batırdı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"O, xalqını səhrada apardı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"O, böyük padşahları vurdu,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O, güclü padşahları qırdı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Emor padşahı Sixonu vurdu,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Başan padşahı Oqu öldürdü,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onların torpaqlarını irs olaraq verdi,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bu yerləri qulu İsrail nəslinin mülkü etdi,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"O, miskin halımızda bizi yaddan çıxarmadı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bizi düşmən əlindən qurtardı,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"O, bəşəriyyətə ruzi verir,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Göylərin Allahına şükür edin,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbəti əbədidir!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}