{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Məzmur 137"]},{"type":"verse","number":1,"content":[{"text":"Babil torpağında olanda Sionu yada salardıq,","poem":1},{"lineBreak":true},{"text":"Çay kənarında oturaraq ağlayardıq,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Liralarımızı söyüd ağaclarından asardıq.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bizi əsir edənlər","poem":1},{"lineBreak":true},{"text":"Nəğmə oxumağımızı əmr edirdilər,","poem":1},{"lineBreak":true},{"text":"Bizə zülm verənlər","poem":1},{"lineBreak":true},{"text":"Onları şənləndirməyimizi istəyirdilər,","poem":1},{"lineBreak":true},{"text":"«Bizim üçün Sion nəğmələrini oxuyun» deyirdilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Axı yad ölkədə Rəbbin nəğmələrini necə oxuyaq?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim, əgər səni unutsam,","poem":1},{"lineBreak":true},{"text":"Qoy sağ əlim qurusun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey Yerusəlim,","poem":1},{"lineBreak":true},{"text":"Səni anmasam, ən böyük sevincim olmasan,","poem":1},{"lineBreak":true},{"text":"Qoy dilim damağıma yapışsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ya Rəbb, Edomluları bir yada sal,","poem":1},{"lineBreak":true},{"text":"Məğlubiyyət günü Yerusəlimdən danışırdılar,","poem":1},{"lineBreak":true},{"text":"Deyirdilər: «Gəlin oranı uçuraq, təməlindən dağıdaq!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey Babil qızı, xaraba qalacaqsan.","poem":1},{"lineBreak":true},{"text":"Bizə etdiyinin əvəzini sənə verən qoy bəxtiyar olsun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Körpələrini daşa çırpıb öldürən bəxtiyar olsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}