{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Məzmur 138"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Bütün qəlbimlə Sənə şükür edirəm,","poem":1},{"lineBreak":true},{"text":"«Allahlar»ın önündə Səni tərənnüm edirəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Müqəddəs məbədinə tərəf səcdə edirəm,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin, sədaqətin naminə isminə şükür edirəm.","poem":1},{"lineBreak":true},{"text":"Çünki ismini, kəlamını hər şeydən üstün tutmusan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Səni çağıranda mənə cavab vermisən,","poem":1},{"lineBreak":true},{"text":"Canıma taqət verib məni ürəkləndirmisən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, bütün dünya padşahları Sənə şükür edəcəklər,","poem":1},{"lineBreak":true},{"text":"Çünki ağzından çıxan kəlamları eşidiblər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbin yollarını tərənnüm edəcəklər,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbbin ehtişamı böyükdür.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb ucalarda olsa da, yazıqlara nəzər salar,","poem":1},{"lineBreak":true},{"text":"Amma lovğaları uzaqdan tanıyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sıxıntı içində gəzsəm də,","poem":1},{"lineBreak":true},{"text":"Mənə həyat verirsən.","poem":1},{"lineBreak":true},{"text":"Düşmənin qəzəbinə qarşı əl qaldırırsan,","poem":1},{"lineBreak":true},{"text":"Məni sağ əlinlə qurtarırsan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb mənə verdiyi vədə əməl edir.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, məhəbbətin əbədidir.","poem":1},{"lineBreak":true},{"text":"Öz əlinin işini tərk etmə!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}