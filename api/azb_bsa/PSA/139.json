{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["Məzmur 139"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, məni yoxlayaraq tanıdın,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oturuşumu-duruşumu Özün bilirsən,","poem":1},{"lineBreak":true},{"text":"Fikirlərimi uzaqdan duyursan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Getməyimə, yatmağıma nəzarət edirsən,","poem":1},{"lineBreak":true},{"text":"Nə yollardan keçdiyimi bilirsən.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sözlərimi dilə gətirməmişdən əvvəl,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, hamısını tamamilə bilirsən.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hər yandan məni əhatə etmisən,","poem":1},{"lineBreak":true},{"text":"Öz əlini üzərimə qoymusan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu bilik əsrarəngizdir, məndən yüksəkdir,","poem":1},{"lineBreak":true},{"text":"Bunu dərk edə bilmərəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hara gedim ki, Ruhun orada olmasın?","poem":1},{"lineBreak":true},{"text":"Hara qaçım ki, hüzurunda olmayım?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Əgər göylərə çıxsam, Sən oradasan,","poem":1},{"lineBreak":true},{"text":"Ölülər diyarında yatsam, Sən oradasan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qanad alıb gündoğana uçsam belə,","poem":1},{"lineBreak":true},{"text":"Dənizi keçib günbatana qonsam belə,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sənin sağ əlin bələdçim olacaq,","poem":1},{"lineBreak":true},{"text":"Sağ əlin məni qoruyacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Desəm də: «Qoy zülmət məni bürüsün,","poem":1},{"lineBreak":true},{"text":"İşıq batsın, ətrafım gecəyə dönsün»,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sənin qarşında zülmət batar,","poem":1},{"lineBreak":true},{"text":"Önündə gecə də gündüz kimi nur saçar.","poem":1},{"lineBreak":true},{"text":"Nurun, zülmətin Sənin üçün nə fərqi var?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sən mənim daxili üzvlərimi yaratmısan,","poem":1},{"lineBreak":true},{"text":"Mənə ana bətnində quruluş vermisən.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən məni ecazkar, əsrarəngiz yolla yaratmısan,","poem":1},{"lineBreak":true},{"text":"Ona görə şükür edirəm.","poem":1},{"lineBreak":true},{"text":"Nə qədər xariqəli işlər görmüsən!","poem":1},{"lineBreak":true},{"text":"Bunu ürəkdən yaxşı dərk edirəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən gizli bir yerdə yaranarkən,","poem":1},{"lineBreak":true},{"text":"Dünyanın dərin yerində yaranarkən","poem":1},{"lineBreak":true},{"text":"Bədənim Səndən gizli qalmadı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dünyaya gəlməzdən əvvəl","poem":1},{"lineBreak":true},{"text":"Sənin gözlərin məni gördü.","poem":1},{"lineBreak":true},{"text":"Ömrüm başlamazdan əvvəl","poem":1},{"lineBreak":true},{"text":"Mənə təyin etdiyin hər bir günü kitabına yazmısan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ey Allah, mənim üçün fikirlərinin qiyməti çoxdur,","poem":1},{"lineBreak":true},{"text":"Onların sayı-hesabı yoxdur!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Saysaydım onları, qum dənələrindən çox olardı,","poem":1},{"lineBreak":true},{"text":"Oyananda yenə mən Səninləyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ey Allah, kaş ki pisləri qıraydın,","poem":1},{"lineBreak":true},{"text":"Qantökənlərin hamısı məndən uzaq olaydı,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onlar Sənə qarşı pis niyyətlə danışır,","poem":1},{"lineBreak":true},{"text":"Düşmənlərin adına küfr edirlər!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sənə nifrət edənlərə nifrət etmərəmmi?","poem":1},{"lineBreak":true},{"text":"Əleyhdarlarından ikrah etmərəmmi?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onlara tamamilə nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Onları özümə düşmən sayıram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ey Allah, məni yoxla, qəlbimi öyrən,","poem":1},{"lineBreak":true},{"text":"Sən məni sınaqdan keçirib bütün fikirlərimi bil.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gör qəlbimdə pisliyə yol verirəmmi?","poem":1},{"lineBreak":true},{"text":"Əbədi yolda mənə rəhbər ol!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}