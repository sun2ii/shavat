{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Məzmur 14"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Axmaqlar ürəyində «Allah yoxdur!» deyə düşünürlər.","poem":1},{"lineBreak":true},{"text":"İnsanlar pozulmuş, əməlləri iyrənc olmuş,","poem":1},{"lineBreak":true},{"text":"Yaxşı iş görən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rəbb göylərdən bəşər övladına baxır.","poem":1},{"lineBreak":true},{"text":"Görəsən Allahı dərk edən, Onu axtaran varmı?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hamı birgə pozulub, namus əldən gedib,","poem":1},{"lineBreak":true},{"text":"Bir nəfər də olsun yaxşı iş görən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Şər iş görənlərin hər biri məgər heç nə qanmır?","poem":1},{"lineBreak":true},{"text":"Xalqımı çörək yerinə yeyirlər, Rəbbi çağırmırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onlar böyük dəhşətə düşəcək,","poem":1},{"lineBreak":true},{"text":"Lakin Allah salehlərin nəslinə yar olacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onlar məzlumların niyyətini boşa çıxarır,","poem":1},{"lineBreak":true},{"text":"Amma Rəbb məzlumların pənahıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kaş İsrailin azadlığı Siondan gələydi!","poem":1},{"lineBreak":true},{"text":"Rəbb Öz xalqına bəxtəvər günlərini qaytaran zaman","poem":1},{"lineBreak":true},{"text":"Yaqub övladları şadlıq edəcək,","poem":1},{"lineBreak":true},{"text":"İsraillilər sevinəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}