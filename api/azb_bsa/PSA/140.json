{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"heading","content":["Məzmur 140"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, məni şər adamlardan xilas et,","poem":1},{"lineBreak":true},{"text":"Məni qəddar insanlardan hifz et.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ürəklərində pis niyyətləri var,","poem":1},{"lineBreak":true},{"text":"Hər gün dava yaradırlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kəskin dilləri ilan tək çalar,","poem":1},{"lineBreak":true},{"text":"Sanki dodaqlarında gürzə zəhəri var. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, şər insanın əlindən,","poem":1},{"lineBreak":true},{"text":"Qəddar insanlardan məni qoru.","poem":1},{"lineBreak":true},{"text":"İstəyirlər ki, ayağımı büdrətsinlər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bu təkəbbürlü insanlar mənə tələ qurublar,","poem":1},{"lineBreak":true},{"text":"Tor atıblar, cələlərini yolumun üstünə qoyublar. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rəbbə dedim: «Allahım Sənsən,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, yalvarıram, Sən məni eşit!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey Xudavənd Rəbb, Sən qüvvətli Xilaskarımsan,","poem":1},{"lineBreak":true},{"text":"Döyüş günündə başıma dəbilqə qoymusan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya Rəbb, qoy pis adam muradına çatmasın,","poem":1},{"lineBreak":true},{"text":"Pis niyyətinə imkan vermə, qoy lovğalanmasın». Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ətrafımdakıların ağzından çıxan pis sözlər","poem":1},{"lineBreak":true},{"text":"Qoy öz başlarına tökülsün!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qoy onların üstünə yanar közlər tökülsün,","poem":1},{"lineBreak":true},{"text":"Onlar quyuya düşüb, çıxa bilməsin!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qoyma ki bu ölkədə iftiraçı uğur qazansın,","poem":1},{"lineBreak":true},{"text":"Bəlalar qəddarı vursun, onu ovlasın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bilirəm ki, Rəbb məzlumların məhkəmə işinə baxır,","poem":1},{"lineBreak":true},{"text":"Fəqirlərə haqq qazandırır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bəli, salehlər Sənin isminə şükür oxuyacaq,","poem":1},{"lineBreak":true},{"text":"Əməlisalehlər hüzurunda yaşayacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}