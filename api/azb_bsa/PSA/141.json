{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["Məzmur 141"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Səni çağırıram, tez imdadıma yetiş,","poem":1},{"lineBreak":true},{"text":"Fəryad edərkən səsimi eşit!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy hüzurunda dualarım buxur kimi,","poem":1},{"lineBreak":true},{"text":"Açılan əllərim axşam qurbanı kimi qəbul olunsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ya Rəbb, ağzıma nəzarətçi qoy,","poem":1},{"lineBreak":true},{"text":"Dodağımın qapısını qoru.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoyma qəlbim şərə meyl etsin,","poem":1},{"lineBreak":true},{"text":"Şər iş görənlərə qoşulub mən də pis iş görməyim,","poem":1},{"lineBreak":true},{"text":"Pislərlə birgə onların ləziz yeməklərindən yeməyim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Saleh insan məni vursa, məhəbbətinə görə tənbeh edər,","poem":1},{"lineBreak":true},{"text":"Bundan imtina etmərəm, sanki başıma çəkilən yağdır.","poem":1},{"lineBreak":true},{"text":"Daim pislərin şərinə qarşı dua edərəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hakimləri yarğandan atılarkən","poem":1},{"lineBreak":true},{"text":"Qoy xalq sözlərimi eşitsin, şirinliyini bilsin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şumlanan yerdə şırımlara narın torpaq töküldüyü kimi","poem":1},{"lineBreak":true},{"text":"Sümüklərimiz ölülər diyarının qapısına səpilib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey Xudavənd Rəbb, gözlərimi Sənə dikmişəm,","poem":1},{"lineBreak":true},{"text":"Məni təhlükədə qoyma, Sənə pənah gətirmişəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Şər iş görənlərin tələsindən,","poem":1},{"lineBreak":true},{"text":"Onların qurduğu cələdən məni qoru.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qoy pislər öz torlarına düşsün,","poem":1},{"lineBreak":true},{"text":"Mən də yolumu salamat keçib-gedim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}