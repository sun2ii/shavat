{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Məzmur 142"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Maskil."]},{"type":"hebrew_subtitle","content":["Mağarada olanda etdiyi dua."]},{"type":"verse","number":1,"content":[{"text":"Rəbbə fəryad qoparıb haray salıram,","poem":1},{"lineBreak":true},{"text":"Rəbbə yalvararaq haray salıram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hüzuruna şikayətimi tökürəm,","poem":1},{"lineBreak":true},{"text":"Qarşısında əziyyətimi söyləyirəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ruhdan düşəndə hansı yolda olduğumu bildin,","poem":1},{"lineBreak":true},{"text":"Yolumda gizli tələ qurublar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sağıma bax, Özün gör, heç kim məni saymır,","poem":1},{"lineBreak":true},{"text":"Pənah yerim yoxdur,","poem":1},{"lineBreak":true},{"text":"Heç kim qayğıma qalmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, Sənə fəryad edərək dedim:","poem":1},{"lineBreak":true},{"text":"«Pənahım Sənsən,","poem":1},{"lineBreak":true},{"text":"Dirilər arasında Sən mənim nəsibimsən».","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qulaq as fəryadıma,","poem":1},{"lineBreak":true},{"text":"Nə qədər alçaldılmışam!","poem":1},{"lineBreak":true},{"text":"Məni təqib edənlərdən qurtar,","poem":1},{"lineBreak":true},{"text":"Çünki onlar məndən güclüdür.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Canımı zindandan qurtar,","poem":1},{"lineBreak":true},{"text":"Qoy isminə şükür edim!","poem":1},{"lineBreak":true},{"text":"Onda salehlər məni əhatə edəcək,","poem":1},{"lineBreak":true},{"text":"Çünki mənə comərdlik etdin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}