{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["Məzmur 143"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, eşit duamı, yalvararkən məni dinlə,","poem":1},{"lineBreak":true},{"text":"Mənə sədaqətin, salehliyin naminə cavab söylə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qulunu məhkəməyə çəkmə,","poem":1},{"lineBreak":true},{"text":"Bu bəşəriyyət içindən kimsə qarşında saleh çıxmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Məni düşmən təqib etdi,","poem":1},{"lineBreak":true},{"text":"Yerə vurdu, həyatım əldən getdi.","poem":1},{"lineBreak":true},{"text":"Sanki lap çoxdan ölənlərin biriyəm,","poem":1},{"lineBreak":true},{"text":"Bu düşmən məni zülmətə saldı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ona görə ruhdan düşmüşəm,","poem":1},{"lineBreak":true},{"text":"Bu dəhşət qəlbimi sarsıtdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Qədim dövrlər yadıma düşür,","poem":1},{"lineBreak":true},{"text":"Sənin bütün işlərini dərindən düşünürəm,","poem":1},{"lineBreak":true},{"text":"Əməllərin barədə hey fikirləşirəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sənə sarı əllərimi açmışam,","poem":1},{"lineBreak":true},{"text":"Bir quraq torpaq kimi Sənin üçün susamışam. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ya Rəbb, mənə tez cavab ver,","poem":1},{"lineBreak":true},{"text":"Çünki ürəyim çəkilir.","poem":1},{"lineBreak":true},{"text":"Üzünü məndən gizlətmə,","poem":1},{"lineBreak":true},{"text":"Qoyma qəbirə düşən insanlara bənzəyim.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hər səhər məhəbbətini mənə hiss etdir,","poem":1},{"lineBreak":true},{"text":"Çünki Sənə güvənirəm.","poem":1},{"lineBreak":true},{"text":"Gedəcəyim yolu mənə öyrət,","poem":1},{"lineBreak":true},{"text":"Çünki varlığımı Sənə verirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ya Rəbb, məni düşmənlərdən qurtar,","poem":1},{"lineBreak":true},{"text":"Sənə pənah gətirirəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mənə Sənin iradənə əməl etməyi öyrət,","poem":1},{"lineBreak":true},{"text":"Çünki mənim Allahım Sənsən.","poem":1},{"lineBreak":true},{"text":"Sənin Ruhun yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Düz yer üçün mənə yol göstər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, mənə ismin naminə həyat ver,","poem":1},{"lineBreak":true},{"text":"Salehliyin naminə canımı dardan qurtar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Məhəbbətin naminə yağılarımı məhv et,","poem":1},{"lineBreak":true},{"text":"Canıma düşmən olanları qır, çünki mən Sənin qulunam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}