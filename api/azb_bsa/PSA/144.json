{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["Məzmur 144"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Alqış olsun Rəbbə, Qayama!","poem":1},{"lineBreak":true},{"text":"Əllərimə döyüş təlimi,","poem":1},{"lineBreak":true},{"text":"Barmaqlarıma müharibə təlimi verən Odur.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mənə Məhəbbət göstərən, mənim Qalam,","poem":1},{"lineBreak":true},{"text":"Qülləm, Xilaskarım,","poem":1},{"lineBreak":true},{"text":"Qalxanım, Pənahgahım,","poem":1},{"lineBreak":true},{"text":"Xalqımı mənə itaət etdirən Odur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ya Rəbb, insan kimdir ki, qayğısına qalırsan,","poem":1},{"lineBreak":true},{"text":"Bəşər övladı kimdir ki, onu düşünürsən?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"İnsan bir nəfəsə bənzər,","poem":1},{"lineBreak":true},{"text":"Ömrü kölgə kimi keçib-gedər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, göyləri yar, aşağı en,","poem":1},{"lineBreak":true},{"text":"Dağlara toxun, qoy tüstülənsin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Şimşəyini çaxdır, düşmənləri dağıt,","poem":1},{"lineBreak":true},{"text":"Oxlarını yağdır, yağıları darmadağın et.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Göylərdən əl uzadıb dərin sulardan məni xilas et,","poem":1},{"lineBreak":true},{"text":"Məni yadellilərin əlindən azad et.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onların dili yalan danışar,","poem":1},{"lineBreak":true},{"text":"Sağ əlləri yalandan and etmək üçün qalxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey Allah, Sənə yeni bir ilahi ilə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Səni ontelli çənglə tərənnüm edəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sənsən padşahlara zəfər qazandıran,","poem":1},{"lineBreak":true},{"text":"Qulun Davudu amansız qılıncdan qurtaran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Məni yadellilərin əlindən xilas et,","poem":1},{"lineBreak":true},{"text":"Sən məni azad et!","poem":1},{"lineBreak":true},{"text":"Onların dili yalan danışar,","poem":1},{"lineBreak":true},{"text":"Sağ əlləri yalandan and etmək üçün qalxar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Qoy yeniyetmə oğullarımız sağlam fidan kimi boy atsın,","poem":1},{"lineBreak":true},{"text":"Qızlarımız oyulmuş saray sütunları kimi gümrah olsun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Anbarlarımız müxtəlif nemətlərlə dolub-daşsın,","poem":1},{"lineBreak":true},{"text":"Otlaqda qoyunlarımız minlərlə, on minlərlə çoxalsın.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naxırlarımız çoxlu balalar versin,","poem":1},{"lineBreak":true},{"text":"Hasarlarımız dəlmə-deşiksiz olsun.","poem":1},{"lineBreak":true},{"text":"İnsanlarımız əsir düşməsin,","poem":1},{"lineBreak":true},{"text":"Meydanlarımız şivən səsinə bir daha bürünməsin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nə bəxtiyardır belə xeyir-dua alan xalq!","poem":1},{"lineBreak":true},{"text":"Nə bəxtiyardır Allahı Rəbb olan xalq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}