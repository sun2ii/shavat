{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"heading","content":["Məzmur 145"]},{"type":"hebrew_subtitle","content":["Davudun həmd nəğməsi."]},{"type":"verse","number":1,"content":[{"text":"Ey Padşahım olan Allahım, Səni yüksəldəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsminə sonsuza qədər alqış edəcəyəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sənə hər gün alqış edəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsminə əbədilik həmd edəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb əzəmətlidir, bol həmdə layiqdir,","poem":1},{"lineBreak":true},{"text":"Onun əzəməti insan ağlına sığmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Əməllərin nəsildən-nəslə qədər mədh ediləcək,","poem":1},{"lineBreak":true},{"text":"Qüdrətli işlərin bəyan ediləcək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əzəmətindən, izzətindən, şərəfindən deyiləcək,","poem":1},{"lineBreak":true},{"text":"Xariqəli işlərini dərindən düşünəcəyəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"İnsanlar zəhmli işlərinin qüdrətindən danışacaq,","poem":1},{"lineBreak":true},{"text":"Sənin əzəmətini elan edəcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"İnsanlar Sənin bol xeyirxahlığını bəyan edəcəklər,","poem":1},{"lineBreak":true},{"text":"Salehliyini mədh edəcəklər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb lütfkar və rəhmlidir,","poem":1},{"lineBreak":true},{"text":"Hədsiz səbirli və bol məhəbbətlidir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbb hamıya xeyirxahlıq edər,","poem":1},{"lineBreak":true},{"text":"Yaratdıqlarının hər birinə mərhəmət göstərər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ya Rəbb, bütün yaratdıqların Sənə şükür edəcək,","poem":1},{"lineBreak":true},{"text":"Möminlərin Sənə alqış edəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Padşahlığının əzəmətindən deyəcəklər,","poem":1},{"lineBreak":true},{"text":"Qüdrətindən danışacaqlar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qoy bəşər övladları Sənin qüdrətini,","poem":1},{"lineBreak":true},{"text":"Padşahlığının izzətini, əzəmətini bilsin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sənin padşahlığın əbədi padşahlıqdır,","poem":1},{"lineBreak":true},{"text":"Səltənətin nəsildən-nəslə qədər uzanır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rəbb yıxılanların hamısına dayaqdır,","poem":1},{"lineBreak":true},{"text":"Qəddi əyilənlərin hamısını qaldırır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ya Rəbb, hamının gözü Sənə baxır,","poem":1},{"lineBreak":true},{"text":"Vaxtlı-vaxtında onlara azuqə verirsən.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Əlini açırsan,","poem":1},{"lineBreak":true},{"text":"Bütün canlıları doyunca yedirirsən.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rəbb bütün yollarında adildir,","poem":1},{"lineBreak":true},{"text":"Hər işində sadiqdir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbb Onu çağıran bütün insanlara,","poem":1},{"lineBreak":true},{"text":"Onu sidq ürəkdən çağıran bütün insanlara yaxındır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ondan qorxanları murada çatdırar,","poem":1},{"lineBreak":true},{"text":"Fəryadlarına qulaq asıb onları qurtarar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rəbb Onu sevənlərin hamısını hifz edər,","poem":1},{"lineBreak":true},{"text":"Bütün pis adamlarınsa kökünü kəsər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mənim dilim Rəbbə həmd oxuyacaq,","poem":1},{"lineBreak":true},{"text":"Qoy Onun müqəddəs isminə bütün bəşəriyyət əbədilik alqış etsin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}