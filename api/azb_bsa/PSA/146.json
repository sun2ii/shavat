{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Məzmur 146"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Ey könlüm, Rəbbə həmd et!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ömür boyu Rəbbə həmdlər söyləyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Allahımı nə qədər varam, tərənnüm edəcəyəm!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Əsilzadələrə,","poem":1},{"lineBreak":true},{"text":"Sizi qurtara bilməyən bəşər oğluna güvənməyin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlar canı çıxan kimi torpağa düşər,","poem":1},{"lineBreak":true},{"text":"Niyyətləri bircə anda yox olar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nə bəxtiyardır Yaqubun Allahından kömək alan,","poem":1},{"lineBreak":true},{"text":"Yalnız Allahı Rəbbə ümid bağlayan insan!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Odur göyləri, yeri, dənizi, dənizdəkiləri yaradan,","poem":1},{"lineBreak":true},{"text":"Odur əbədi sadiq qalan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O, miskinlərə haqq qazandırır,","poem":1},{"lineBreak":true},{"text":"O, acları azuqə ilə doydurur.","poem":1},{"lineBreak":true},{"text":"Rəbb əsirləri azad edir,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb kor gözləri açır.","poem":1},{"lineBreak":true},{"text":"Rəbb qəddi əyilənləri düzəldir,","poem":1},{"lineBreak":true},{"text":"Rəbb salehləri sevir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbb qəriblərə dayaq olur,","poem":1},{"lineBreak":true},{"text":"Yetimi, dul qadını ayağa qaldırır,","poem":1},{"lineBreak":true},{"text":"Pislərinsə yollarını dolaşdırır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbb əbədi hökmranlıq edir,","poem":1},{"lineBreak":true},{"text":"Ey Sion, Allahın nəsillər boyu hökm verir!","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}