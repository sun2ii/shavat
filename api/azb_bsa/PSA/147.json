{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["Məzmur 147"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Allahımızı tərənnüm etmək nə qədər yaxşıdır!","poem":1},{"lineBreak":true},{"text":"O buna layiqdir, Ona həmdlər söyləmək xoşdur!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rəbb Yerusəlimi bərpa edər,","poem":1},{"lineBreak":true},{"text":"İsrailin əsarətdə olanlarını yığıb-gətirər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O, sınıq qəlblərə şəfa verər,","poem":1},{"lineBreak":true},{"text":"Yaralarını sarıyar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ulduzların sayını hesablar,","poem":1},{"lineBreak":true},{"text":"Hər birini öz adı ilə çağırar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xudavəndimiz əzəmətlidir,","poem":1},{"lineBreak":true},{"text":"Qüvvəti çoxdur, dərrakəsi hədsizdir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb məzlumları ayağa qaldırar,","poem":1},{"lineBreak":true},{"text":"Pisləri isə toz-torpaq içinə atar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbbə şükür nəğməsi söyləyin,","poem":1},{"lineBreak":true},{"text":"Allahımızı lira ilə tərənnüm edin!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O, göyləri buludlarla bürüyər,","poem":1},{"lineBreak":true},{"text":"Yer üzünü yağışla təmin edər,","poem":1},{"lineBreak":true},{"text":"Dağlarda ot bitirər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, heyvanlara yem verər,","poem":1},{"lineBreak":true},{"text":"Çığırışan quzğun balalarını yemlər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O, güclü atlardan zövq almaz,","poem":1},{"lineBreak":true},{"text":"Qüvvətli addımlardan razı qalmaz.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amma Rəbb Ondan qorxanlardan,","poem":1},{"lineBreak":true},{"text":"Onun məhəbbətinə ümid bağlayanlardan razı qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey Yerusəlim, Rəbbi mədh et!","poem":1},{"lineBreak":true},{"text":"Ey Sion, Allahına həmd et!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çünki darvazalarının cəftələrini bərkidər,","poem":1},{"lineBreak":true},{"text":"Sənin əhalinə bərəkət verər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sərhədinə əmin-amanlıq,","poem":1},{"lineBreak":true},{"text":"Sənə doyunca əla taxıl yetirər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kəlamını yer üzünə yollar,","poem":1},{"lineBreak":true},{"text":"Onun sözü tez yayılar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ağ yun kimi qar yağdırar,","poem":1},{"lineBreak":true},{"text":"Kül kimi qırov salar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Parça-parça dolu tökər.","poem":1},{"lineBreak":true},{"text":"Onun soyuğuna kim dözə bilər?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Buyruq verəndə buz əriyər,","poem":1},{"lineBreak":true},{"text":"Külək əsdirəndə sular sel tək axar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O, Yaqub nəslinə sözlərini,","poem":1},{"lineBreak":true},{"text":"İsraillilərə qanun və hökmlərini bildirir.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Başqa millətlər üçün belə etməyib,","poem":1},{"lineBreak":true},{"text":"Heç birinə hökmlərini bildirməyib.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}