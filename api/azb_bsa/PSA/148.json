{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"heading","content":["Məzmur 148"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə həmd edin!","poem":1},{"lineBreak":true},{"text":"Göylərdən Rəbbə həmd edin,","poem":1},{"lineBreak":true},{"text":"Yüksəklərdən Ona həmd edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Onun bütün mələkləri, Ona həmd edin!","poem":1},{"lineBreak":true},{"text":"Ey Onun bütün orduları, Ona həmd edin!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey günəş, ey ay, Ona həmd edin!","poem":1},{"lineBreak":true},{"text":"Ey parlayan bütün ulduzlar, Ona həmd edin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey göylərin ən uca qatları, Ona həmd edin!","poem":1},{"lineBreak":true},{"text":"Ey göy üzərindəki sular, Ona həmd edin!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbin isminə həmd etsinlər!","poem":1},{"lineBreak":true},{"text":"Çünki Onun əmri ilə yaranıblar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb onları həmişəlik, əbədi olaraq yerinə qoyub,","poem":1},{"lineBreak":true},{"text":"Bunun üçün pozulmaz qayda qoyub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbbə həmd edin, ey yer üzündəkilər,","poem":1},{"lineBreak":true},{"text":"Ey dəniz əjdahaları, ey bütün dərinliklər,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey şimşək, dolu, qar, buludlar,","poem":1},{"lineBreak":true},{"text":"Ey Onun əmrinə tabe olan qasırğalar,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey dağlar, bütün təpələr,","poem":1},{"lineBreak":true},{"text":"Ey bəhərli ağaclar, bütün sidr ağacları,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey çöl və ev heyvanları,","poem":1},{"lineBreak":true},{"text":"Ey sürünənlər və uçan quşlar,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey dünya padşahları və bütün ümmətlər,","poem":1},{"lineBreak":true},{"text":"Ey başçılar və dünyada olan bütün hakimlər,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey gənc oğlanlar və qızlar,","poem":1},{"lineBreak":true},{"text":"Ey qocalar, cavanlar!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hamınız Rəbbin isminə həmd edin!","poem":1},{"lineBreak":true},{"text":"Çünki yalnız Onun ismi ucadır.","poem":1},{"lineBreak":true},{"text":"Əzəməti göylərin, yerin üstündədir,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O, xalqına böyük qüvvət verib.","poem":1},{"lineBreak":true},{"text":"Buna görə Ona həmd etsin Onun bütün möminləri,","poem":1},{"lineBreak":true},{"text":"Əziz xalqı olan İsrail övladları!","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}