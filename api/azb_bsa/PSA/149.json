eBreak":true},{"text":"Yataqlarında belə, Onu tərənnüm etsinlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dilləri ilə Allahı ucaltsınlar,","poem":1},{"lineBreak":true},{"text":"Əllərində ikiağızlı qılınc tutsunlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Millətləri qıraraq qisas alsınlar,","poem":1},{"lineBreak":true},{"text":"Ümmətləri cəzalandırsınlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Padşahlarına zəncir vursunlar,","poem":1},{"lineBreak":true},{"text":"Sərkərdələrini dəmir buxovlara salsınlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onlar üçün yazılan hökmü yerinə yetirsinlər,","poem":1},{"lineBreak":true},{"text":"Rəbbin bütün möminləri bununla şərəflənsinlər.","poem":1},{"lineBreak":true},{"text":"Rəbbə həmd edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}