{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Məzmur 16"]},{"type":"hebrew_subtitle","content":["Davudun miktamı."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, məni hifz et,","poem":1},{"lineBreak":true},{"text":"Sənə pənah gətirmişəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbbə dedim: «Mənim Xudavəndim Sənsən.","poem":1},{"lineBreak":true},{"text":"Səndən başqa mənim xoşbəxtliyim yoxdur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yer üzünün müqəddəsləri isə nəcib insanlardır,","poem":1},{"lineBreak":true},{"text":"Yalnız belələrindən zövq alıram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yad allahların ardınca qaçanların dərdi artacaq,","poem":1},{"lineBreak":true},{"text":"Onlar üçün qan təqdimləri vermərəm,","poem":1},{"lineBreak":true},{"text":"Adlarını dilimə gətirmərəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, mənim qismətimsən, kasama düşən paysan,","poem":1},{"lineBreak":true},{"text":"Püşkümə düşən Səndən asılıdır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qismətimə gözəl yerlər düşdü,","poem":1},{"lineBreak":true},{"text":"Bəli, mənə nemət nəsib oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mənə nəsihət verən Rəbbə alqış edirəm,","poem":1},{"lineBreak":true},{"text":"Hətta gecələr də vicdanım mənə ağıl öyrədir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbbə həmişə üz tutmuşam,","poem":1},{"lineBreak":true},{"text":"Sağımda olduğu üçün sarsılmaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Elə bunun üçün qəlbim sevinir, ruhum şad olur,","poem":1},{"lineBreak":true},{"text":"Cismim əmin-amanlıqda yaşayır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki məni ölülər diyarına atmazsan,","poem":1},{"lineBreak":true},{"text":"Mömin insanını qəbirə salmazsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mənə həyat yolunu öyrədirsən,","poem":1},{"lineBreak":true},{"text":"Doyunca sevinc Sənin hüzurundadır,","poem":1},{"lineBreak":true},{"text":"Sağ əlində hər zaman səadət var».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}