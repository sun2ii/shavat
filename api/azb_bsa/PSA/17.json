{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"heading","content":["Məzmur 17"]},{"type":"hebrew_subtitle","content":["Davudun duası."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, haqq sözümü dinlə, fəryadımı eşit,","poem":1},{"lineBreak":true},{"text":"Yalansız dilimdən çıxan duama qulaq as.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gözlərinlə həqiqəti görürsən,","poem":1},{"lineBreak":true},{"text":"Mənə haqq qazandır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gecə ikən qəlbimi yoxlayıb-araşdırdın,","poem":1},{"lineBreak":true},{"text":"Məni sınaqdan keçirtdin,","poem":1},{"lineBreak":true},{"text":"Heç nə tapmadın.","poem":1},{"lineBreak":true},{"text":"Niyyətim budur ki, ağzım öz həddini aşmasın.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sənin sözünə görə zalımların tutduğu yoldan,","poem":1},{"lineBreak":true},{"text":"Bu insanların əməlindən özümü qorumuşam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sənin yolundan möhkəm tutmuşam,","poem":1},{"lineBreak":true},{"text":"Sarsılmadan addımlamışam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Səni çağırıram, ey Allah, mənə cavab verirsən,","poem":1},{"lineBreak":true},{"text":"Qulağını mənə tərəf çevir, sözlərimi dinlə.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Məhəbbətinlə Sənə sığınanlara xariqələrini göstər,","poem":1},{"lineBreak":true},{"text":"Sağ əlinlə onları düşmənlərdən qurtar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Məni göz bəbəyin kimi qoru,","poem":1},{"lineBreak":true},{"text":"Qanadlarının kölgəsində saxla","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Məni dara salan şər insanlardan,","poem":1},{"lineBreak":true},{"text":"Ətrafımı bürüyən, canıma düşmən olanlardan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Onların ürəkləri qapalıdır, harınlayıblar,","poem":1},{"lineBreak":true},{"text":"Ağızlarından lovğa-lovğa sözlər çıxarırlar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İndi izimə düşüb məni mühasirəyə aldılar,","poem":1},{"lineBreak":true},{"text":"Güdürlər ki, məni yerə vursunlar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onlar parçalamağa həris bir aslan kimidir,","poem":1},{"lineBreak":true},{"text":"Pusquda duran cavan bir şir kimidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, qalx,","poem":1},{"lineBreak":true},{"text":"Onların önündə dayan,","poem":1},{"lineBreak":true},{"text":"Onları yerlə yeksan et.","poem":1},{"lineBreak":true},{"text":"Qılıncınla bu pis insanlardan canımı qurtar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ya Rəbb, məni belə insanlardan,","poem":1},{"lineBreak":true},{"text":"Nəsibi bu həyatda olanlardan","poem":1},{"lineBreak":true},{"text":"Öz əlinlə xilas et!","poem":1},{"lineBreak":true},{"text":"Qarınlarını xəzinənlə doldurursan,","poem":1},{"lineBreak":true},{"text":"Onlar övladlarını doydurur,","poem":1},{"lineBreak":true},{"text":"Nəvə-nəticələrinə də miras qoyur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amma mən salehliklə üzünə baxacağam,","poem":1},{"lineBreak":true},{"text":"Oyananda Səni görməklə doyacağam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}