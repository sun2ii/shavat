{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"heading","content":["Məzmur 18"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Rəbb Öz qulu Davudu bütün düşmənlərin və Şaulun əlindən qurtaranda Davudun Ona söylədiyi ilahi."]},{"type":"verse","number":1,"content":[{"text":"O belə oxudu:","poem":1},{"lineBreak":true},{"text":"Ey mənə qüvvət verən Rəbb, Səni sevirəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb qayam, qalam, xilaskarımdır,","poem":1},{"lineBreak":true},{"text":"Allahım qayamdır, Ona pənah gətirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Odur qalxanım, qüdrətli qurtarıcım, qülləm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Həmdə layiq Rəbbi çağıracağam,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin əlindən qurtulacağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ətrafımı ölüm ipləri bürümüşdü,","poem":1},{"lineBreak":true},{"text":"Məni əcəl selləri ürkütmüşdü.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ölülər diyarının ipləri mənə sarılmışdı,","poem":1},{"lineBreak":true},{"text":"Ölüm kəməndləri məni qarşılamışdı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Əzab içində Rəbbə yalvardım,","poem":1},{"lineBreak":true},{"text":"Allahıma fəryad qopardım.","poem":1},{"lineBreak":true},{"text":"O, məbədindən səsimi eşitdi,","poem":1},{"lineBreak":true},{"text":"Fəryadımsa hüzuruna, Onun qulağına yetdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O zaman yer üzü sarsılıb titrədi,","poem":1},{"lineBreak":true},{"text":"Dağların təməlləri lərzəyə gəldi,","poem":1},{"lineBreak":true},{"text":"Onlar sarsıldı,","poem":1},{"lineBreak":true},{"text":"Çünki O qəzəbləndi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Burnundan tüstü çıxıb yüksəldi,","poem":1},{"lineBreak":true},{"text":"Ağzından yandırıb-yaxan alov püskürdü,","poem":1},{"lineBreak":true},{"text":"Bundan közlər tutuşdu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, göyləri yarıb yerədək endi,","poem":1},{"lineBreak":true},{"text":"Qatı zülmət ayaqları altında idi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bir keruva minib uçdu,","poem":1},{"lineBreak":true},{"text":"Yel qanadları üstə şığıdı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gizlənmək üçün ətrafını zülmətə bürüdü,","poem":1},{"lineBreak":true},{"text":"Tufan qoparan qara buludlardan Özünə çardaq qurdu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hüzurundan şəfəq saçdı,","poem":1},{"lineBreak":true},{"text":"Odlu közlər və dolu buludları yardı.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb göylərdə gurladı,","poem":1},{"lineBreak":true},{"text":"Haqq-Taala səs saldı,","poem":1},{"lineBreak":true},{"text":"Odlu közlər və dolu yağdı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Oxlarını atıb düşmənləri darmadağın etdi,","poem":1},{"lineBreak":true},{"text":"Şimşəyini çaxdırıb onları dağıtdı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sənin məzəmmətindən,","poem":1},{"lineBreak":true},{"text":"Burnundakı nəfəsinin şiddətindən","poem":1},{"lineBreak":true},{"text":"Suların dərinlikləri göründü,","poem":1},{"lineBreak":true},{"text":"Dünyanın bünövrələri açıq qaldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"O, ucalardan əl uzadıb məni tutdu,","poem":1},{"lineBreak":true},{"text":"Məni dərin suların içindən çıxartdı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Məni qüvvətli düşmənimdən azad etdi,","poem":1},{"lineBreak":true},{"text":"Çünki yağılarım məndən güclü idi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fəlakətli günümdə qarşıma çıxdılar,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb mənə dayaq oldu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O məni genişliyə çıxardı,","poem":1},{"lineBreak":true},{"text":"Məndən razı qalıb məni qurtardı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rəbb mənə salehliyim naminə ənam verdi,","poem":1},{"lineBreak":true},{"text":"Mənə əlitəmizliyimin əvəzini verdi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Çünki Rəbbin yolunu tutmuşam,","poem":1},{"lineBreak":true},{"text":"Pis olub Allahımın yolundan azmamışam.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Onun bütün hökmləri önümdədir,","poem":1},{"lineBreak":true},{"text":"Qaydalarından imtina etməmişəm.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onunla mən kamala çatmışam,","poem":1},{"lineBreak":true},{"text":"Özümü günahdan qorumuşam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Rəbb mənə salehliyimin əvəzini verdi,","poem":1},{"lineBreak":true},{"text":"Gözünün önündə əlitəmiz olmağımın əvəzini verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Sədaqətlilərlə sədaqətlisən,","poem":1},{"lineBreak":true},{"text":"Kamillərlə kamilsən.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Təmizlərlə təmizsən,","poem":1},{"lineBreak":true},{"text":"Əyrilərlə əyriliyinə görə davranırsan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"İtaətkar insanları qurtarırsan,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü baxışları alçaldırsan.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sən çırağıma işıq verirsən!","poem":1},{"lineBreak":true},{"text":"Allahım Rəbb zülmətimi nura çevirir.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Səninlə qoşun üstünə hücum çəkirəm,","poem":1},{"lineBreak":true},{"text":"Allahımla sədlər keçirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Allahın yolu kamildir,","poem":1},{"lineBreak":true},{"text":"Rəbbin kəlamı safdır,","poem":1},{"lineBreak":true},{"text":"Rəbb Ona sığınanların sipəridir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Rəbdən başqa Allah kimdir ki?","poem":1},{"lineBreak":true},{"text":"Allahımızdan başqa qaya kimdir ki?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Allah məni qüvvəsi ilə bürüyər,","poem":1},{"lineBreak":true},{"text":"Yolumu kamil edər.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ayaqlarımı maral ayaqları kimi çevik edər,","poem":1},{"lineBreak":true},{"text":"Məni zirvələrimdə saxlar.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Əllərimə döyüş təlimi verər,","poem":1},{"lineBreak":true},{"text":"Qollarım tunc kamanın yayını dartar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Sən mənə qurtuluş qalxanını verdin,","poem":1},{"lineBreak":true},{"text":"Mənə sağ əlinlə dayaq oldun,","poem":1},{"lineBreak":true},{"text":"Köməyinlə məni yüksəltdin.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Geniş yer açdın ki, addımlayım,","poem":1},{"lineBreak":true},{"text":"Ayaqlarım büdrəməsin.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Düşmənlərimi qovub onlara çatdım,","poem":1},{"lineBreak":true},{"text":"Onlar məhv olanadək geriyə qayıtmadım.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Onları əzdim, qalxa bilmədilər,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımın altına sərildilər.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Döyüş üçün məni qüvvə ilə bürüdün,","poem":1},{"lineBreak":true},{"text":"Əleyhdarlarımı ayağımın altına saldın.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Düşmənlərimin kürəyini mənə sarı çevirdin,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edən yağıları məhv etdim.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Fəryad etsələr də, onları qurtaran olmadı,","poem":1},{"lineBreak":true},{"text":"Rəbbi çağırsalar da, cavab almadılar.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Onları əzib külək sovuran toz etdim,","poem":1},{"lineBreak":true},{"text":"Küçələrin palçığı kimi tapdaladım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Sən məni xalqın çəkişmələrindən qurtardın,","poem":1},{"lineBreak":true},{"text":"Məni millətlərə başçı qoydun,","poem":1},{"lineBreak":true},{"text":"Tanımadığım xalqları mənə tabe etdirdin.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Yadellilər mənə boyun əydilər,","poem":1},{"lineBreak":true},{"text":"Səsimi eşidəndə mənə itaət etdilər.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Yadellilərin cəsarəti qırıldı,","poem":1},{"lineBreak":true},{"text":"Titrəyərək sığınacaqlarından çıxdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Rəbb əbədi yaşayır! Qayama alqış olsun!","poem":1},{"lineBreak":true},{"text":"Məni qurtaran Allahım ucalsın!","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"O, Allahdır, mənə görə qisas alır,","poem":1},{"lineBreak":true},{"text":"Xalqları mənə tabe etdirir.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"O məni düşmənlərimin arasından xilas edir,","poem":1},{"lineBreak":true},{"text":"Bəli, məni yağılar üstündə ucaldır,","poem":1},{"lineBreak":true},{"text":"Məni zalımların əlindən qurtarır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Buna görə, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Millətlər arasında Sənə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsminə tərənnüm söyləyəcəyəm.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Rəbb padşahına böyük zəfərlər verər,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyi Davuda və nəslinə əbədi məhəbbət göstərər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}