{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Məzmur 19"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Göylər Allahın əzəmətini bəyan edir,","poem":1},{"lineBreak":true},{"text":"Göy qübbəsi əllərinin işini elan edir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hər gün ertəsi günə nəql edir,","poem":1},{"lineBreak":true},{"text":"Hər gecə o biri gecəyə bilik verir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onların nə nitqi, nə də sözləri var,","poem":1},{"lineBreak":true},{"text":"Onların səsləri eşidilmir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amma avazları bütün dünyaya yayılır,","poem":1},{"lineBreak":true},{"text":"Sözləri yerin ucqarlarına çatır.","poem":1},{"lineBreak":true},{"text":"Allah günəş üçün göylərdə çadır qurur,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Günəş gərdəyindən bəy kimi çıxır,","poem":1},{"lineBreak":true},{"text":"Qaçışa çıxan bir igid kimi şad olur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bir tərəfdən çıxır, göylərdə dövrə vurur,","poem":1},{"lineBreak":true},{"text":"Heç nə istisindən gizlənə bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbbin qanunu kamildir, canı təzələyir,","poem":1},{"lineBreak":true},{"text":"Rəbbin öyüdü etibarlıdır, nadanı müdrik edir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbbin qayda-qanunları düzdür, ürəyi sevindirir,","poem":1},{"lineBreak":true},{"text":"Rəbbin əmrləri pakdır, gözləri aydın edir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rəbb qorxusu safdır, əbədi yaşayır,","poem":1},{"lineBreak":true},{"text":"Rəbbin hökmləri haqdır, hamısı ədalətlidir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar qızıldan, bol miqdarda olan saf qızıldan da çox sevilir,","poem":1},{"lineBreak":true},{"text":"Onlar baldan, şanı balından da şirindir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bəndən bunlardan nəsihət alar,","poem":1},{"lineBreak":true},{"text":"Onlara əməl edənin bol mükafatı var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kim öz səhvlərini duya bilər?","poem":1},{"lineBreak":true},{"text":"Məni gizli təqsirlərimdən təmizlə.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qulunu aşkar günahlardan qoru,","poem":1},{"lineBreak":true},{"text":"Qoyma onların hökmü altında qalım.","poem":1},{"lineBreak":true},{"text":"Onda kamilliyə çataram,","poem":1},{"lineBreak":true},{"text":"Bütün itaətsizliklərdən ayrılaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ağzımdan çıxan sözlər,","poem":1},{"lineBreak":true},{"text":"Qəlbimdəki düşüncələr","poem":1},{"lineBreak":true},{"text":"Hüzurunda qəbul olunsun.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, ey Qayam və Satınalanım!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}