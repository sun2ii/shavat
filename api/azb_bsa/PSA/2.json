{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["Məzmur 2"]},{"type":"verse","number":1,"content":[{"text":"Nə üçün millətlər belə vurnuxmaya düşür,","poem":1},{"lineBreak":true},{"text":"Ümmətlər boş şeylər düşünür?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dünya şahları yığışır,","poem":1},{"lineBreak":true},{"text":"Hökmdarlar Rəbbə və","poem":1},{"lineBreak":true},{"text":"Onun məsh etdiyinə qarşı birləşir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Deyirlər: «Gəlin onların buxovlarını qoparaq,","poem":1},{"lineBreak":true},{"text":"Üstümüzdəki zəncirlərini ataq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Göylərin sakini gülür,","poem":1},{"lineBreak":true},{"text":"Xudavənd onlara istehza edir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sonra onlara hiddəti ilə xəbərdarlıq edəcək,","poem":1},{"lineBreak":true},{"text":"Qəzəbi ilə onları dəhşətə gətirəcək.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O deyir: «Mən padşahımı","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağım Sionda əyləşdirmişəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbbin fərmanını elan edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Rəbb mənə dedi:","poem":1},{"lineBreak":true},{"text":"«Sən Mənim oğlumsan,","poem":1},{"lineBreak":true},{"text":"Mən bu gün sənə Ata oldum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Məndən istə, onda irs olaraq millətləri,","poem":1},{"lineBreak":true},{"text":"Mülk olaraq yer üzünün qurtaracağınadək hər yeri","poem":1},{"lineBreak":true},{"text":"Sənə verərəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onları dəmir əsa ilə qıracaqsan,","poem":1},{"lineBreak":true},{"text":"Saxsı qab kimi çilik-çilik edəcəksən».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"İndi, ey şahlar, müdrik olun!","poem":1},{"lineBreak":true},{"text":"Ey dünya hakimləri, ibrət alın!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbdən qorxub Ona xidmət edin,","poem":1},{"lineBreak":true},{"text":"Həm titrəyin, həm sevinin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oğulu öpün ki, qəzəblənməsin,","poem":1},{"lineBreak":true},{"text":"Yoxsa tutduğunuz yolda məhv olarsınız.","poem":1},{"lineBreak":true},{"text":"Çünki qəzəbi tezliklə alovlanar.","poem":1},{"lineBreak":true},{"text":"Ona pənah gətirənlərin hamısı nə bəxtiyardır!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}