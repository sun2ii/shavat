{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Məzmur 20"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Dar gündə Rəbb sənə cavab versin,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının ismi səni hifz etsin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Müqəddəs məskənindən köməyinə çatsın,","poem":1},{"lineBreak":true},{"text":"Siondan sənə dayaq olsun!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bütün təqdimlərindən razı qalsın,","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanların qəbul olunsun! Sela","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O səni ürəyinin istəyinə çatdırsın,","poem":1},{"lineBreak":true},{"text":"Hər bir niyyətini yerinə yetirsin!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Biz sənin zəfərlərinə mədh oxuyarıq,","poem":1},{"lineBreak":true},{"text":"Allahımız naminə bayraqlarımızı qaldırarıq!","poem":1},{"lineBreak":true},{"text":"Rəbb səni hər bir diləyinə çatdırsın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"İndi bildim ki, Rəbb məsh etdiyinə zəfərlər verər,","poem":1},{"lineBreak":true},{"text":"Müqəddəs səmasından ona cavab göndərər,","poem":1},{"lineBreak":true},{"text":"Sağ əlinin qüdrəti onu qalib edər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bəziləri döyüş arabaları, bəziləri atları ilə öyünür,","poem":1},{"lineBreak":true},{"text":"Bizsə Allahımız Rəbbin adı ilə öyünürük.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onlar büdrəyəcəklər, yıxılacaqlar,","poem":1},{"lineBreak":true},{"text":"Bizsə qalxıb dik duracağıq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sən padşaha zəfər ver,","poem":1},{"lineBreak":true},{"text":"Səni çağırarkən bizə cavab ver.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}