{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["Məzmur 21"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, padşah qüdrətinlə sevinir,","poem":1},{"lineBreak":true},{"text":"Zəfərinlə fərəhlənir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Onu ürəyinin arzusuna çatdırmısan,","poem":1},{"lineBreak":true},{"text":"Dilindən çıxan diləyini ondan əsirgəməmisən. Sela","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki onu yaxşı nemətlərlə qarşılamısan,","poem":1},{"lineBreak":true},{"text":"Saf qızıldan başına tac qoymusan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səndən həyat istəyəndə ona verdin,","poem":1},{"lineBreak":true},{"text":"Onun ömrünü əbədi olaraq uzatmısan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ona zəfər çaldıraraq şərəfini ucaltmısan,","poem":1},{"lineBreak":true},{"text":"Ehtişam və əzəmət bağışlamısan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Əbədi olaraq başına nemətlər tökmüsən,","poem":1},{"lineBreak":true},{"text":"Hüzurundakı sevinclə Sən onu fərəhləndirmisən.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki padşah Rəbbə güvənir,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanın məhəbbəti ilə sarsılmazdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Əlin bütün düşmənlərini tapacaq,","poem":1},{"lineBreak":true},{"text":"Sağ əlin yağıları tutacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ya Rəbb, onlara görünən zaman","poem":1},{"lineBreak":true},{"text":"Sən onları soba tək yandıracaqsan,","poem":1},{"lineBreak":true},{"text":"Onları qəzəbinlə yeyib, alovunla udacaqsan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Övladlarını yer üzündən,","poem":1},{"lineBreak":true},{"text":"Gələcək nəsillərini insanlar arasından yox edəcəksən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Çünki pis niyyətlə əleyhinə çıxdılar,","poem":1},{"lineBreak":true},{"text":"Hiylə işlətdilər, amma gücləri çatmadı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki Sən onları geri qovacaqsan,","poem":1},{"lineBreak":true},{"text":"Yay çəkib oxla üzlərini nişan alacaqsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, qoy Sənin uca qüdrətini görək!","poem":1},{"lineBreak":true},{"text":"Əzəmətini ilahilərlə tərənnüm edək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}