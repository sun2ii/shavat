{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"heading","content":["Məzmur 22"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Ayyelet haşşaxar» üstə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allahım, Allahım, niyə məni tərk etdin?","poem":1},{"lineBreak":true},{"text":"Niyə ah-zarımdan uzaq durursan, mənə imdad etmirsən?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Allahım, gündüz çağıranda mənə cavab vermirsən,","poem":1},{"lineBreak":true},{"text":"Gecə rahatlığım yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nə qədər müqəddəssən!","poem":1},{"lineBreak":true},{"text":"İsrailin həmdləri üzərində taxt quran Sənsən!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ata-babalarımız Sənə güvənmişdi,","poem":1},{"lineBreak":true},{"text":"Sənə güvənəndə onları xilas etdin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sənə yalvararkən qurtuldular,","poem":1},{"lineBreak":true},{"text":"Sənə güvənərkən rüsvay olmadılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lakin mən torpaq qurduyam, insan deyiləm,","poem":1},{"lineBreak":true},{"text":"Adamların tənə hədəfiyəm,","poem":1},{"lineBreak":true},{"text":"Xalq mənə xor baxır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Məni hər görən lağ edir,","poem":1},{"lineBreak":true},{"text":"Dodaq büzüb, başını yırğalayıb belə deyir:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Qoy güvəndiyi Rəbb onu azad etsin,","poem":1},{"lineBreak":true},{"text":"Rəbb ondan razı qalıb, qoy onu xilas etsin».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakin bətndən dünyaya məni gətirən,","poem":1},{"lineBreak":true},{"text":"Ana qucağında ikən mənə əminlik verən Sənsən.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Doğulandan bəri Səndən asılıyam,","poem":1},{"lineBreak":true},{"text":"Ana bətnindən bəri Allahım Sənsən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Məndən uzaq durma, çünki əzab yaxındır,","poem":1},{"lineBreak":true},{"text":"Köməyimə çatan yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nə qədər buğa məni dövrəyə salıb,","poem":1},{"lineBreak":true},{"text":"Güclü Başan buğaları yan-yörəmi bürüyüb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yırtıcı aslanlar kimi nərə çəkirlər,","poem":1},{"lineBreak":true},{"text":"Məni parçalamaq üçün ağızlarını açırlar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mən su kimi töküldüm,","poem":1},{"lineBreak":true},{"text":"Bütün sümüklərim oynaqlarından çıxdı,","poem":1},{"lineBreak":true},{"text":"Köksümdəki ürəyim mum kimi əridi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Saxsı parçası kimi gücüm qurudu,","poem":1},{"lineBreak":true},{"text":"Dilim damağıma yapışdı,","poem":1},{"lineBreak":true},{"text":"Sən məni torpağa salıb ölüm verdin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Şər insanlar dəstəsi məni dövrəyə aldı,","poem":1},{"lineBreak":true},{"text":"İt sürüsü kimi yan-yörəmi bürüdülər,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımı, əllərimi deşdilər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sümüklərimi saya bilirəm,","poem":1},{"lineBreak":true},{"text":"Onlar baxırlar, gözlərini mənə zilləyirlər!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aralarında paltarlarımı bölüşdürürlər,","poem":1},{"lineBreak":true},{"text":"Geyimim üçün püşk atırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ya Rəbb, uzaq durma,","poem":1},{"lineBreak":true},{"text":"Ey mənim Qüdrətlim, dadıma tez çat!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Həyatımı qılıncdan qurtar,","poem":1},{"lineBreak":true},{"text":"Canımı itlərin caynağından qurtar,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Məni aslanın ağzından xilas et!","poem":1},{"lineBreak":true},{"text":"Çöl öküzləri məni buynuzlayarkən mənə cavab ver.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"İsmini qardaşlarıma elan edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Camaat arasında Sənə həmd söyləyəcəyəm:","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"«Siz ey Rəbdən qorxanlar, Ona həmd edin,","poem":1},{"lineBreak":true},{"text":"Ey bütün Yaqub nəsli, Onu şərəfləndirin,","poem":1},{"lineBreak":true},{"text":"Siz ey İsrail nəsli, Ona ehtiram edin!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Çünki Rəbb bu məzlumun dərdinə xor baxmadı,","poem":1},{"lineBreak":true},{"text":"Ondan ikrah edərək üzünü gizlətmədi,","poem":1},{"lineBreak":true},{"text":"İmdada çağıranda səsinə cavab verdi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Çoxlu camaat arasında həmd etdiyim Sənsən!","poem":1},{"lineBreak":true},{"text":"Səndən qorxanların önündə əhd etdiyim təqdimləri verəcəyəm.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Qoy məzlumlar doyunca yesin,","poem":1},{"lineBreak":true},{"text":"Rəbbi axtaranlar Ona həmd etsin!","poem":1},{"lineBreak":true},{"text":"Qoy canınız həmişə sağ olsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yer üzünün qurtaracağınadək hər yerdə yaşayanlar","poem":1},{"lineBreak":true},{"text":"Rəbbi xatırlayacaq, Ona tərəf dönəcəklər.","poem":1},{"lineBreak":true},{"text":"Bütün millətlərin soyları","poem":1},{"lineBreak":true},{"text":"Onun hüzurunda səcdə qılacaq.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Çünki hökmranlıq Rəbbindir,","poem":1},{"lineBreak":true},{"text":"Millətlər üzərində səltənət sürən Odur!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bütün dünya zənginləri yeyib-doyacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbin hüzurunda səcdə qılacaq.","poem":1},{"lineBreak":true},{"text":"Torpağa düşənlərin hamısı –","poem":1},{"lineBreak":true},{"text":"Özlərini ölümdən saxlaya bilməyənlər","poem":1},{"lineBreak":true},{"text":"Onun hüzurunda diz çökəcəklər.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gələcək nəsillər Ona qulluq edəcək,","poem":1},{"lineBreak":true},{"text":"Xudavənd haqqında övladlarına deyəcək;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Onun ədalətini, Onun əməllərini","poem":1},{"lineBreak":true},{"text":"Gələcəkdə doğulan xalqa bildirəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}