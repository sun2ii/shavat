eBreak":true},{"text":"Mənim üçün süfrə açırsan,","poem":1},{"lineBreak":true},{"text":"Başıma ətirli yağ çəkirsən,","poem":1},{"lineBreak":true},{"text":"Ağzınadək camımı doldurursan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bəli, bütün həyatım boyu","poem":1},{"lineBreak":true},{"text":"Yaxşılıq, məhəbbət məni izləyir.","poem":1},{"lineBreak":true},{"text":"Bütün ömrüm boyu","poem":1},{"lineBreak":true},{"text":"Rəbbin evində yaşayacağam!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}