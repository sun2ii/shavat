{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["Məzmur 24"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Rəbbindir yer üzü və orada mövcud olanlar,","poem":1},{"lineBreak":true},{"text":"Dünya və orada yaşayanlar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O, yerin təməlini dənizlər üstündə qurdu,","poem":1},{"lineBreak":true},{"text":"Dünyanı sular üzərində yaratdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbbin dağına kim çıxa bilər?","poem":1},{"lineBreak":true},{"text":"Müqəddəs məskəninə kim girə bilər?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"– Əlləri pak, qəlbi təmiz,","poem":1},{"lineBreak":true},{"text":"Hiyləyə könül verməyən,","poem":1},{"lineBreak":true},{"text":"Yalandan and içməyən insan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O, Rəbdən bərəkət alacaq,","poem":1},{"lineBreak":true},{"text":"Xilaskarı Allahdan salehlik alacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Belə adam Rəbbi soraqlayar,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının üzünü axtarar. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey darvazalar, başlarınızı qaldırın,","poem":1},{"lineBreak":true},{"text":"Ey qədim qapılar, açılın,","poem":1},{"lineBreak":true},{"text":"Əzəmətli Padşah içəri daxil olsun!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu əzəmətli Padşah kimdir?","poem":1},{"lineBreak":true},{"text":"– Odur, güclü-qüdrətli Rəbb,","poem":1},{"lineBreak":true},{"text":"Döyüşdə qüvvətli Rəbb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey darvazalar, başlarınızı qaldırın,","poem":1},{"lineBreak":true},{"text":"Ey qədim qapılar, açılın,","poem":1},{"lineBreak":true},{"text":"Əzəmətli Padşah içəri daxil olsun!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bu əzəmətli Padşah kimdir?","poem":1},{"lineBreak":true},{"text":"– Ordular Rəbbi,","poem":1},{"lineBreak":true},{"text":"Odur əzəmətli Padşah! Sela","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}