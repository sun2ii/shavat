{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"heading","content":["Məzmur 25"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Sənə ürəyimi təqdim edirəm,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Allahım, yalnız Sənə güvənirəm!","poem":1},{"lineBreak":true},{"text":"Məni xəcalətdə qoyma,","poem":1},{"lineBreak":true},{"text":"Qoy düşmənlərim mənə qalib gələrək sevinməsinlər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sənə ümid bağlayanlar heç zaman utanmasınlar,","poem":1},{"lineBreak":true},{"text":"Haqsız xəyanətkarlarsa rüsvay olsunlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, yollarını mənə göstər,","poem":1},{"lineBreak":true},{"text":"Öz yollarını mənə öyrət.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Məni haqq yolu ilə apar,","poem":1},{"lineBreak":true},{"text":"Həqiqətini mənə öyrət.","poem":1},{"lineBreak":true},{"text":"Məni qurtaran Allah Sənsən,","poem":1},{"lineBreak":true},{"text":"Daim Səni gözləyirəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya Rəbb, əzəldən bəri var olan","poem":1},{"lineBreak":true},{"text":"Mərhəmətini, məhəbbətini yada sal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gənclikdə günahkar, üsyankar oldum,","poem":1},{"lineBreak":true},{"text":"Bunları yadına salma.","poem":1},{"lineBreak":true},{"text":"Məni məhəbbətin naminə,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, xeyirxahlığına görə yada sal!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb xeyirxah və haqdır,","poem":1},{"lineBreak":true},{"text":"Ona görə günahkara düz yol göstərir,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İtaətkarları ədalət yolu ilə aparır,","poem":1},{"lineBreak":true},{"text":"Öz yolunu onlara öyrədir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kim Rəbbin əhdinə və göstərişlərinə bağlıdırsa,","poem":1},{"lineBreak":true},{"text":"Rəbb yolunda onun üçün xeyirxahlıq və sədaqət var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, ismin naminə məni bağışla,","poem":1},{"lineBreak":true},{"text":"Təqsirim böyükdür.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rəbdən qorxan kimdir?","poem":1},{"lineBreak":true},{"text":"Rəbb ona yol seçməyi öyrədir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O bəxtəvər yaşayacaq,","poem":1},{"lineBreak":true},{"text":"Ölkə onun nəslinə irs olaraq qalacaq.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbb Ondan qorxanlara sirrini açar,","poem":1},{"lineBreak":true},{"text":"Onlara Öz əhdini öyrədər.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Həmişə gözüm Rəbdədir,","poem":1},{"lineBreak":true},{"text":"Çünki O, ayaqlarımı tələdən xilas edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Üzünü mənə sarı çevir və lütfkar ol,","poem":1},{"lineBreak":true},{"text":"Çünki tənhayam, zülm içindəyəm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qəlbimdəki qubar artıb,","poem":1},{"lineBreak":true},{"text":"Məni dərdlərdən qurtar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Əzab-əziyyətimə bax,","poem":1},{"lineBreak":true},{"text":"Bütün günahlarımı bağışla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Düşmənlərimə bax, gör nə qədər çoxalıb,","poem":1},{"lineBreak":true},{"text":"Amansız nifrətlərinə hədəfəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Canımı qoru, məni qurtar,","poem":1},{"lineBreak":true},{"text":"Sənə pənah gətirdiyimə görə qoyma rüsvay olum!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qoy kamalla düzlük məni hifz etsin,","poem":1},{"lineBreak":true},{"text":"Çünki Səni gözləyirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ey Allah, İsraili","poem":1},{"lineBreak":true},{"text":"Bütün çətinliklərindən qurtar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}