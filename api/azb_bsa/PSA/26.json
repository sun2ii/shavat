{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Məzmur 26"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Məni haqlı çıxar, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Çünki mən kamalla gəzmişəm,","poem":1},{"lineBreak":true},{"text":"Sarsılmadan Rəbbimə güvənmişəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ya Rəbb, məni sınaqdan keçir,","poem":1},{"lineBreak":true},{"text":"Sən məni imtahan et,","poem":1},{"lineBreak":true},{"text":"Qəlbimi, fikirlərimi saf et.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Məhəbbətin gözümün önündə durur,","poem":1},{"lineBreak":true},{"text":"Sənin sədaqətinlə gəzirəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yalançı insanlarla oturmuram,","poem":1},{"lineBreak":true},{"text":"İkiüzlülərlə yoldaşlıq etmirəm,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaramazların məclisinə nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Pislərlə oturmuram.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya Rəbb, günahsızlıq içində əllərimi yuyuram,","poem":1},{"lineBreak":true},{"text":"Qurbangahının başına dolanıram,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şükür səsimi ucaldıram,","poem":1},{"lineBreak":true},{"text":"Bütün xariqələrini bəyan edirəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya Rəbb, məskənin olan evi,","poem":1},{"lineBreak":true},{"text":"Calalının sakin olduğu yeri sevirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Məni günahkarlara qatıb aparma,","poem":1},{"lineBreak":true},{"text":"Qatillərlə birgə canımı alma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar pis niyyəti əllərində tutublar,","poem":1},{"lineBreak":true},{"text":"Sağ əllərini rüşvətlə doldurublar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mənsə kamalla gəzirəm,","poem":1},{"lineBreak":true},{"text":"Məni qurtar, mənə lütf et!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ayağım düzlük üstündə durur,","poem":1},{"lineBreak":true},{"text":"Cəmiyyətin içində Rəbbə alqış edəcəyəm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}