{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["Məzmur 27"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Rəbdir nurum, qurtuluşum!","poem":1},{"lineBreak":true},{"text":"Mən kimdən qorxum?","poem":1},{"lineBreak":true},{"text":"Rəbdir ömrümün qalası,","poem":1},{"lineBreak":true},{"text":"Mən kimdən vahimələnim?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ətimi yemək üçün hücum edən şər adamlar –","poem":1},{"lineBreak":true},{"text":"Yağılarım, düşmənlərim büdrəyərək yıxılarlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bir ordu qarşımda düzülsə belə, ürəyim qorxmaz,","poem":1},{"lineBreak":true},{"text":"Mənimlə döyüşsələr də, arxayınam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbdən bir arzum, bir istəyim var:","poem":1},{"lineBreak":true},{"text":"Bütün ömrüm boyu Rəbbin evində yaşayım,","poem":1},{"lineBreak":true},{"text":"Məbədində Rəbbin camalına baxım,","poem":1},{"lineBreak":true},{"text":"Ona pərəstiş edim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dar gündə məni çardağında gizlər,","poem":1},{"lineBreak":true},{"text":"Çadırının örtüyü ilə örtər,","poem":1},{"lineBreak":true},{"text":"Qaya başındakı yüksək yerə gətirər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"İndi ətrafımdakı düşmənlərimin üzərində","poem":1},{"lineBreak":true},{"text":"Qələbələr çalacağam,","poem":1},{"lineBreak":true},{"text":"Rəbbin çadırında şənlik qurub qurbanlar kəsəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onu ilahilərlə tərənnüm edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ya Rəbb, dinlə, Səni çağırıram,","poem":1},{"lineBreak":true},{"text":"Lütf edib mənə cavab ver.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sən dedin: «Üzümü axtarın».","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, mən Sənin üzünü axtarıram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Üzünü məndən gizlətmə,","poem":1},{"lineBreak":true},{"text":"Qulunu qəzəblə qovma.","poem":1},{"lineBreak":true},{"text":"Mənə Sən kömək etmisən,","poem":1},{"lineBreak":true},{"text":"Məni atma, tərk etmə,","poem":1},{"lineBreak":true},{"text":"Ey məni qurtaran Allahım!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ata-anam məni atsa belə,","poem":1},{"lineBreak":true},{"text":"Rəbb məni qəbul edər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ya Rəbb, yolunu mənə öyrət,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimdən ötrü mənə düz yolda rəhbərlik et.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Məni düşmənlərin əlinə salma,","poem":1},{"lineBreak":true},{"text":"Çünki yalançı şahidlər, zorakılar əleyhimə qalxdılar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbbin xeyirxahlığını dirilər arasında görəcəyəm,","poem":1},{"lineBreak":true},{"text":"Buna şübhəm yoxdur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rəbbə ümid bağla!","poem":1},{"lineBreak":true},{"text":"Möhkəm və cəsarətli ol!","poem":1},{"lineBreak":true},{"text":"Rəbbə ümid bağla!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}