{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["Məzmur 28"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Səni səsləyirəm,","poem":1},{"lineBreak":true},{"text":"Ey Qayam, qulağını tıxama.","poem":1},{"lineBreak":true},{"text":"Əgər cavab verməsən,","poem":1},{"lineBreak":true},{"text":"Qəbirə düşənlərə bənzəyərəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Səni yardıma çağırarkən,","poem":1},{"lineBreak":true},{"text":"Məbədinin ən müqəddəs yerinə tərəf əllərimi qaldırarkən,","poem":1},{"lineBreak":true},{"text":"Yalvarış səsimi eşit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pislərlə, şər iş görənlərlə birgə","poem":1},{"lineBreak":true},{"text":"Məni dartıb aparma.","poem":1},{"lineBreak":true},{"text":"Onlar qonşuları ilə dost kimi danışır,","poem":1},{"lineBreak":true},{"text":"Lakin qəlblərində şər dolaşır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əməllərinə, pis işlərinə görə","poem":1},{"lineBreak":true},{"text":"Onların əvəzini ver,","poem":1},{"lineBreak":true},{"text":"Əllərindən gələn bu işlər nəyə layiqdirsə,","poem":1},{"lineBreak":true},{"text":"Onlar üçün ödə.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbin əməllərinə əhəmiyyət vermədiklərinə görə,","poem":1},{"lineBreak":true},{"text":"Onun əllərinin əməllərinə fikir vermədiklərinə görə","poem":1},{"lineBreak":true},{"text":"Rəbb onları yerə vuracaq,","poem":1},{"lineBreak":true},{"text":"Bir daha qaldırmayacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alqış olsun Rəbbə,","poem":1},{"lineBreak":true},{"text":"Yalvarış səsimi eşitdi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbb qalam, sipərimdir!","poem":1},{"lineBreak":true},{"text":"Qəlbim Ona güvənəndə köməyimə çatır.","poem":1},{"lineBreak":true},{"text":"Sevincdən qəlbim cuşa gəlir,","poem":1},{"lineBreak":true},{"text":"İlahilərimlə Ona şükür edirəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb Öz xalqının gücüdür,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyi insanın nicat qalasıdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Öz xalqını qurtar,","poem":1},{"lineBreak":true},{"text":"Seçdiklərinə xeyir-dua ver.","poem":1},{"lineBreak":true},{"text":"Öz sürünü otar,","poem":1},{"lineBreak":true},{"text":"Xalqının əbədilik qayğısına qal!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}