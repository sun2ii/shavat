{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Məzmur 3"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Oğlu Avşalomun qarşısından qaçanda."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, düşmənlərim nə qədər çoxalıb!","poem":1},{"lineBreak":true},{"text":"Əleyhimə qalxanlar nə qədər artıb!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mənim üçün çoxları deyir:","poem":1},{"lineBreak":true},{"text":"«Allahdan ona xilas yoxdur». Sela3:2 Sela – fərz edilir ki, bu bir musiqi terminidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amma Sən, ya Rəbb, ətrafımda sipərsən,","poem":1},{"lineBreak":true},{"text":"Şərəfimsən, başımı ucaldan Sənsən!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbbi ucadan səsləyirəm,","poem":1},{"lineBreak":true},{"text":"O, müqəddəs dağından mənə cavab verir. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mən yatıram, yuxuya gedirəm,","poem":1},{"lineBreak":true},{"text":"Yenə oyanıram, çünki Rəbb mənə kömək edir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hər yandan məni mühasirəyə alan","poem":1},{"lineBreak":true},{"text":"On minlərlə xalqdan qorxmuram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Qalx, ya Rəbb! Ey Allahım, məni qurtar!","poem":1},{"lineBreak":true},{"text":"Çünki Sən bütün düşmənlərimin əngindən vurursan,","poem":1},{"lineBreak":true},{"text":"Pislərin dişlərini qırırsan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qurtuluş Rəbdəndir,","poem":1},{"lineBreak":true},{"text":"Qoy Sənin xeyir-duan xalqının üzərində olsun! Sela","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}