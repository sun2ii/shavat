{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["Məzmur 30"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Məbədin təqdisinə aid ilahi."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Səni ucaldıram,","poem":1},{"lineBreak":true},{"text":"Çünki Sən məni qurtardın,","poem":1},{"lineBreak":true},{"text":"Düşməni mənə görə sevinməyə qoymadın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ya Rəbb Allahım,","poem":1},{"lineBreak":true},{"text":"Səni imdada çağırarkən","poem":1},{"lineBreak":true},{"text":"Mənə şəfa verdin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, canımı","poem":1},{"lineBreak":true},{"text":"Ölülər diyarından azad etdin,","poem":1},{"lineBreak":true},{"text":"Qəbirə düşməyim deyə","poem":1},{"lineBreak":true},{"text":"Sən mənə həyat verdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey Rəbbin möminləri,","poem":1},{"lineBreak":true},{"text":"Onu tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Onun müqəddəs isminə şükür edin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki qəzəbi bir anlıq olur,","poem":1},{"lineBreak":true},{"text":"Lütfü isə ömür boyu qalır.","poem":1},{"lineBreak":true},{"text":"Kimin bir gecə gözündən yaş tökülərsə,","poem":1},{"lineBreak":true},{"text":"Onun üçün sübh tezdən sevinc doğar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dinclik tapanda dedim:","poem":1},{"lineBreak":true},{"text":"«Əsla sarsılmaram».","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ya Rəbb, lütfünlə məni","poem":1},{"lineBreak":true},{"text":"Bir dağ kimi möhkəm etdin.","poem":1},{"lineBreak":true},{"text":"Sonra məndən üz gizlətdin,","poem":1},{"lineBreak":true},{"text":"Canıma vəlvələ düşdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb, Səni çağırdım,","poem":1},{"lineBreak":true},{"text":"Xudavəndə belə yalvardım:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Qanımı töküb qəbirə düşsəm,","poem":1},{"lineBreak":true},{"text":"Sənə fayda verərmi?","poem":1},{"lineBreak":true},{"text":"Torpaq Sənə şükür edə bilərmi,","poem":1},{"lineBreak":true},{"text":"Sədaqətini elan edə bilərmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ya Rəbb, dinlə, mənə lütf et,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, köməyimə çat».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yasımı şənliyə çevirdin,","poem":1},{"lineBreak":true},{"text":"Çulumu çıxarıb məni sevincə bürüdün.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ona görə susmayacağam,","poem":1},{"lineBreak":true},{"text":"Səni ucadan tərənnüm edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb Allahım,","poem":1},{"lineBreak":true},{"text":"Sənə daim şükür edəcəyəm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}