{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["Məzmur 31"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Sənə pənah gətirirəm!","poem":1},{"lineBreak":true},{"text":"Heç vaxt məni xəcalətdə qoyma,","poem":1},{"lineBreak":true},{"text":"Ədalətinlə məni xilas et!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qulağını mənə tərəf çevir,","poem":1},{"lineBreak":true},{"text":"Məni tez azad et!","poem":1},{"lineBreak":true},{"text":"Bir qaya ol, qoy sığınım,","poem":1},{"lineBreak":true},{"text":"Möhkəm bir qala ol, qoy qurtulum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki qayam da Sən, qalam da Sənsən!","poem":1},{"lineBreak":true},{"text":"Öz ismin naminə mənə yol göstərib rəhbərlik et.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məni qarşımda qurulan gizli tordan hifz et,","poem":1},{"lineBreak":true},{"text":"Çünki Sən mənim sığınacağımsan!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ruhumu Sənin əlinə verirəm,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, sadiq Allah, Sən məni azad et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Boş şey olan bütlərə pərəstiş edənlərə nifrət edirəm,","poem":1},{"lineBreak":true},{"text":"Mən Rəbbə güvənirəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən Sənin məhəbbətində","poem":1},{"lineBreak":true},{"text":"Şad olub sevinəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çünki məzlum halımı görmüsən,","poem":1},{"lineBreak":true},{"text":"Çəkdiyim əzabı bilmisən.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Məni düşmənə təslim etmədin,","poem":1},{"lineBreak":true},{"text":"Genişlikdə gəzdirdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ya Rəbb, mənə rəhm et,","poem":1},{"lineBreak":true},{"text":"Çünki əzabdayam,","poem":1},{"lineBreak":true},{"text":"Kədərdən gözüm, qəlbim, bədənim quruyub.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ömrüm qüssə ilə,","poem":1},{"lineBreak":true},{"text":"İllərim ah-nalə ilə keçir.","poem":1},{"lineBreak":true},{"text":"Təqsirimə görə taqətim qalmayıb,","poem":1},{"lineBreak":true},{"text":"Sümüklərim quruyub.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bütün düşmənlərim mənə tənə edir,","poem":1},{"lineBreak":true},{"text":"Qonşularımsa onlardan daha betərdir,","poem":1},{"lineBreak":true},{"text":"Tanışlarım məni görərkən dəhşətə düşür,","poem":1},{"lineBreak":true},{"text":"Məni küçələrdə görənlər məndən qaçır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ölü bir adam kimi unudulmuşam,","poem":1},{"lineBreak":true},{"text":"Çilik-çilik qırılan bir qaba oxşayıram.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çox adamların pıçıltısını eşidirəm,","poem":1},{"lineBreak":true},{"text":"Hər tərəfimi dəhşət alıb,","poem":1},{"lineBreak":true},{"text":"Hamı əleyhimə əlbir olub,","poem":1},{"lineBreak":true},{"text":"Canımı almaq üçün qəsd qurub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ya Rəbb, yalnız Sənə güvənirəm,","poem":1},{"lineBreak":true},{"text":"Dedim: «Allahımsan Sən».","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mənim hər anım Sənin əlindədir,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin, təqibçilərimin əlindən","poem":1},{"lineBreak":true},{"text":"Məni azad et.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bəndənin üstünə üzünün nurunu sal,","poem":1},{"lineBreak":true},{"text":"Məhəbbətinlə məni qurtar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ya Rəbb, məni xəcalətdə qoyma,","poem":1},{"lineBreak":true},{"text":"Çünki Səni çağırıram.","poem":1},{"lineBreak":true},{"text":"Qoy pislər utansın,","poem":1},{"lineBreak":true},{"text":"Qoy ölülər diyarında səsləri batsın.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Təkəbbürlə, həqarətlə yalan danışan,","poem":1},{"lineBreak":true},{"text":"Salehlərə böhtan atan dillər lal olsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xeyirxahlığın nə qədər böyükdür!","poem":1},{"lineBreak":true},{"text":"Bunu Səndən qorxanlar üçün saxladın.","poem":1},{"lineBreak":true},{"text":"Bütün bəşər övladları qarşısında","poem":1},{"lineBreak":true},{"text":"Sənə pənah gətirənlərə xeyirxahlıq etdin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Onları insanların qəsdlərindən","poem":1},{"lineBreak":true},{"text":"Hüzurunda sığındırırsan,","poem":1},{"lineBreak":true},{"text":"Böhtançı dillərə qarşı çardağında gizlədirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Qoy Rəbbə alqış olsun!","poem":1},{"lineBreak":true},{"text":"Çünki mühasirəyə düşən şəhərdə","poem":1},{"lineBreak":true},{"text":"Məhəbbətini xariqələrlə mənə göstərdi!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mən təlaşa düşüb demişdim:","poem":1},{"lineBreak":true},{"text":"«Sənin gözlərinin önündən kənara atıldım».","poem":1},{"lineBreak":true},{"text":"Lakin Səni imdada çağıranda","poem":1},{"lineBreak":true},{"text":"Yalvarış səsimi eşitdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbbi sevin, siz ey bütün möminlər!","poem":1},{"lineBreak":true},{"text":"Rəbb həmişə Ona sadiq qalanı qoruyur,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlü insana isə layiq olduğunu verir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ey Rəbbə ümid bağlayan bütün insanlar,","poem":1},{"lineBreak":true},{"text":"Möhkəm olun, qoy ürəyiniz cəsarətli olsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}