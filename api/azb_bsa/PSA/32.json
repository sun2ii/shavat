{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["Məzmur 32"]},{"type":"hebrew_subtitle","content":["Davudun maskili.",{"noteId":2}]},{"type":"verse","number":1,"content":[{"text":"Üsyankarlığı bağışlanan,","poem":1},{"lineBreak":true},{"text":"Günahı əfv olunan insan","poem":1},{"lineBreak":true},{"text":"Nə bəxtiyardır!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb tərəfindən təqsirkar sayılmayan,","poem":1},{"lineBreak":true},{"text":"Qəlbində hiylə olmayan insan","poem":1},{"lineBreak":true},{"text":"Nə bəxtiyardır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Etiraf etməyəndə","poem":1},{"lineBreak":true},{"text":"Bütün gün nalə çəkməkdən","poem":1},{"lineBreak":true},{"text":"Sümüklərim taqətdən düşdü.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əlin üzərimdə gecə-gündüz ağırlaşdı,","poem":1},{"lineBreak":true},{"text":"Sanki yayın quraqlığı məni taqətdən saldı. Sela","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sonra Sənə günahımı etiraf etdim,","poem":1},{"lineBreak":true},{"text":"Təqsirlərimi gizlətmədim.","poem":1},{"lineBreak":true},{"text":"Dedim: «Üsyankarlığımı Rəbbə etiraf edirəm».","poem":1},{"lineBreak":true},{"text":"Təqsirimi, günahımı bağışladın. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Buna görə hər bir mömin","poem":1},{"lineBreak":true},{"text":"Səni tapan zaman Sənə dua etsin.","poem":1},{"lineBreak":true},{"text":"Azğın sellər daşsa da,","poem":1},{"lineBreak":true},{"text":"Möminə toxunmaz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sığınacaq yerim Sənsən,","poem":1},{"lineBreak":true},{"text":"Məni dardan hifz edirsən.","poem":1},{"lineBreak":true},{"text":"Zəfər harayı ilə","poem":1},{"lineBreak":true},{"text":"Ətrafımda dövr edirsən. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dedin: «Sənə təlim verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Gedəcəyin yolu öyrədəcəyəm.","poem":1},{"lineBreak":true},{"text":"Nəsihət verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Gözüm sənin üstündə olacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"At yaxud qatır kimi","poem":1},{"lineBreak":true},{"text":"Şüursuz olmayın.","poem":1},{"lineBreak":true},{"text":"Cilov, yüyən vurulmasa,","poem":1},{"lineBreak":true},{"text":"Onlar idarə edilə bilməz».","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pislərin başına çox bəla gələr,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənənlər isə hər tərəfdən məhəbbətə bürünər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey salehlər, fərəhlənin,","poem":1},{"lineBreak":true},{"text":"Rəbbə görə sevinin!","poem":1},{"lineBreak":true},{"text":"Ey ürəyidüz olanlar,","poem":1},{"lineBreak":true},{"text":"Onu mədh edin!","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Maskil – bir musiqi və yaxud ədəbi termin.","reference":{"chapter":32,"verse":0}}]},"thisChapterLink":"/api/azb_bsa/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}