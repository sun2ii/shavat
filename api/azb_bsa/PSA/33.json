{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"heading","content":["Məzmur 33"]},{"type":"verse","number":1,"content":[{"text":"Ey salehlər, Rəbbi mədh edin,","poem":1},{"lineBreak":true},{"text":"Ürəyidüz olanlara həmd söyləmək yaraşır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lira çalın, Rəbbə şükür edin,","poem":1},{"lineBreak":true},{"text":"On telli çənglə Onu tərənnüm edin,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ona yeni bir nəğmə oxuyun,","poem":1},{"lineBreak":true},{"text":"Sevinc nidaları ilə çalın.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Rəbbin sözü haqdır,","poem":1},{"lineBreak":true},{"text":"Hər işini sədaqətlə aparır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbb salehliyi və ədaləti sevir,","poem":1},{"lineBreak":true},{"text":"Yer üzü Onun məhəbbəti ilə dolur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Göylər Rəbbin sözü ilə,","poem":1},{"lineBreak":true},{"text":"Səma cisimləri Onun hökmü ilə yarandı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dənizin sularını bir yerə yığdı,","poem":1},{"lineBreak":true},{"text":"Dərin suları anbarlarda saxladı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qoy bütün dünya Rəbdən qorxsun,","poem":1},{"lineBreak":true},{"text":"Bütün yer üzünün əhalisi Onu şərəfləndirsin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki nə söylədi, mövcud oldu,","poem":1},{"lineBreak":true},{"text":"Nə əmr etdi, quruldu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb millətlərin məsləhətini puç edər,","poem":1},{"lineBreak":true},{"text":"Xalqların məqsədini heç edər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lakin Rəbbin məsləhəti əbədi olar,","poem":1},{"lineBreak":true},{"text":"Ürəyinin məqsədi nəsillər ötsə də, qalar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nə bəxtiyardır o millət ki Allahı Rəbdir,","poem":1},{"lineBreak":true},{"text":"O xalq ki Rəbb onu irs olaraq seçmişdir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb göylərdən baxır,","poem":1},{"lineBreak":true},{"text":"Bütün bəşər övladlarını görür,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Taxtında oturduğu yerdən","poem":1},{"lineBreak":true},{"text":"Bütün dünya əhalisini görür.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Odur hər bir insanın ürəyini yaradan,","poem":1},{"lineBreak":true},{"text":"Əməllərini anlayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Qoşunun çoxluğu ilə heç bir padşah qurtulmaz,","poem":1},{"lineBreak":true},{"text":"Qolunun gücü ilə heç bir cəngavər zəfər çalmaz.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qələbə üçün at boş şeydir,","poem":1},{"lineBreak":true},{"text":"Qüvvətinin çoxluğu ilə bir kimsə xilas olmaz.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbbin gözü Ondan qorxanlara,","poem":1},{"lineBreak":true},{"text":"Onun məhəbbətinə ümid bağlayanlara baxar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"İstəyir ki, onları ölümdən qurtarsın,","poem":1},{"lineBreak":true},{"text":"Qıtlıqda belə, onlar sağ qalsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Könlümüz Rəbbin yolunu gözlər,","poem":1},{"lineBreak":true},{"text":"Odur köməyimiz və sipərimiz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bizim qəlbimiz Onda sevinc tapır,","poem":1},{"lineBreak":true},{"text":"Müqəddəs isminə arxalanmışıq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ya Rəbb, ümidimizi Sənə bağlamışıq,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin üzərimizdən tükənməsin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}