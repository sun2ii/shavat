{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["Məzmur 34"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["O, Avimelekin önündə özünü dəli kimi göstərib qovulanda."]},{"type":"verse","number":1,"content":[{"text":"Hər zaman Rəbbə alqış edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ona daim mənim dilim həmd edəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəblə könlüm fəxr edir,","poem":1},{"lineBreak":true},{"text":"Ey məzlumlar, eşidib sevinin!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gəlin mənimlə birgə Rəbbi müqəddəs tutaq,","poem":1},{"lineBreak":true},{"text":"Rəbbin ismini birgə ucaldaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbbə üz tutdum, O mənə cavab verdi,","poem":1},{"lineBreak":true},{"text":"O hər bir dəhşətdən məni xilas etdi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbə baxan nur saçar,","poem":1},{"lineBreak":true},{"text":"Üzü qızarmaz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mən məzlum, Rəbbi çağırdım, O məni eşitdi,","poem":1},{"lineBreak":true},{"text":"Bütün əzablarımdan məni xilas etdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rəbdən qorxanları Onun mələyi müdafiə edər,","poem":1},{"lineBreak":true},{"text":"Onlara zəfər verər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dadın, görün Rəbb nə qədər şirindir,","poem":1},{"lineBreak":true},{"text":"Nə bəxtiyardır Ona pənah gətirənlər!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Rəbbin müqəddəsləri, Rəbdən qorxun,","poem":1},{"lineBreak":true},{"text":"Ondan qorxan heç nəyə möhtac qalmaz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gənc aslanlar ac-yalavac qaldılar,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbbi axtaranlar","poem":1},{"lineBreak":true},{"text":"Heç bir yaxşı şeydən korluq çəkməzlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gəlin, ey övladlar, məni dinləyin,","poem":1},{"lineBreak":true},{"text":"Rəbb qorxusunu sizə öyrədim:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kim həyatdan kam almaq istəyirsə,","poem":1},{"lineBreak":true},{"text":"Uzun ömür sürüb xoş gün görmək istəyirsə,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qoy dilini şərdən,","poem":1},{"lineBreak":true},{"text":"Ağzını fırıldaq üçün işlətməkdən qorusun,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qoy şərdən çəkinib yaxşılıq etsin,","poem":1},{"lineBreak":true},{"text":"Sülhü axtarıb ardınca getsin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Rəbbin gözü salehlərin üzərindədir,","poem":1},{"lineBreak":true},{"text":"Qulaqları onların fəryadlarına açıqdır.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbbin üzü şər iş görənlərə qarşıdır,","poem":1},{"lineBreak":true},{"text":"Yer üzündə onlardan nişanə qoymayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Salehlər fəryad çəkəndə Rəbb eşidir,","poem":1},{"lineBreak":true},{"text":"Onları bütün əzablarından azad edir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbb qəlbisınıqlara yaxındır,","poem":1},{"lineBreak":true},{"text":"O, ruhən əzilmişləri qurtarır.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Salehlər çox bəlaya düçar olar,","poem":1},{"lineBreak":true},{"text":"Lakin Rəbb onları hər birindən qurtarır.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rəbb onların hər bir sümüyünü qoruyur,","poem":1},{"lineBreak":true},{"text":"Heç biri zədələnməz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Pislər öz şəri ilə məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Salehə nifrət edən məhkum olacaq.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Rəbb qullarının canını azad edir,","poem":1},{"lineBreak":true},{"text":"Rəbbə pənah gətirən məhkum olmur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}