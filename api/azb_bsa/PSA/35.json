{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["Məzmur 35"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, mənimlə çəkişənlərlə Sən çəkiş.","poem":1},{"lineBreak":true},{"text":"Mənimlə döyüşənlərlə Sən döyüş.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qalxan və sipərini əlinə al,","poem":1},{"lineBreak":true},{"text":"Qalx, mənim imdadıma çat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nizəni tutub ardımca düşənlərin yolunu kəs,","poem":1},{"lineBreak":true},{"text":"Qəlbimə söylə: «Səni qurtaran Mənəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Canımın qəsdinə duranlar","poem":1},{"lineBreak":true},{"text":"Qoy utanıb rüsvay olsunlar,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı pis niyyəti olanlar","poem":1},{"lineBreak":true},{"text":"Geri qovulub biabır olsunlar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Saman çöpü tək olsunlar, onları yel sovursun,","poem":1},{"lineBreak":true},{"text":"Rəbbin mələyi onları silib atsın.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qoy yolları zülmət, sürüşkən olsun,","poem":1},{"lineBreak":true},{"text":"Qoy Rəbbin mələyi onları qovsun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki nahaq yerə mənə tələ qurdular,","poem":1},{"lineBreak":true},{"text":"Nahaqdan canım üçün quyu qazdılar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qoy başlarına qəfil fəlakət gəlsin,","poem":1},{"lineBreak":true},{"text":"Qurduqları tələyə özləri düşsün,","poem":1},{"lineBreak":true},{"text":"Hazırladıqları bəlaya düçar olsunlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Onda canım Rəblə şad olacaq,","poem":1},{"lineBreak":true},{"text":"Məni qurtardığı üçün qəlbim fərəh tapacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bütün varlığımla belə deyəcəyəm:","poem":1},{"lineBreak":true},{"text":"«Ya Rəbb, Sənin kimisi varmı?","poem":1},{"lineBreak":true},{"text":"Məzlumu ondan güclünün əlindən,","poem":1},{"lineBreak":true},{"text":"Məzlumu və fəqiri istismarçının əlindən azad edirsən».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amansız şahidlər qalxırlar,","poem":1},{"lineBreak":true},{"text":"Yalandan üzümə dururlar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaxşılığımın əvəzində onlardan yamanlıq görürəm,","poem":1},{"lineBreak":true},{"text":"Əzizi ölən bir adama bənzəyirəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vaxtı ilə onlar xəstələnərkən","poem":1},{"lineBreak":true},{"text":"Çul geyib, oruc tutub canıma zülm edirdim,","poem":1},{"lineBreak":true},{"text":"Başımı aşağı salıb dua edirdim.","poem":1},{"noteId":3}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onları özümə dost və qardaş bilirdim.","poem":1},{"lineBreak":true},{"text":"Anası üçün yas tutan adam tək","poem":1},{"lineBreak":true},{"text":"Bükülüb hüznlə gəzirdim.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakin mən büdrəyərkən","poem":1},{"lineBreak":true},{"text":"Bir yerə toplaşıb sevindilər.","poem":1},{"lineBreak":true},{"text":"Tanımadığım əclaflar mənə qarşı toplaşdılar.","poem":1},{"lineBreak":true},{"text":"Dayanmadan məni didirdilər,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Şikəstləri təhqir edən allahsızlar kimi","poem":1},{"lineBreak":true},{"text":"Mənə dişlərini qıcayırdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ey Xudavənd, nə vaxta qədər buna baxacaqsan?","poem":1},{"lineBreak":true},{"text":"Canımı məhv edilməkdən,","poem":1},{"lineBreak":true},{"text":"Həyatımı bu gənc aslanlardan qurtar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çoxlu camaat arasında Sənə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Çoxsaylı xalq arasında Sənə həmd edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Qoyma haqsız düşmənlərim mənə görə sevinsin,","poem":1},{"lineBreak":true},{"text":"Mənə nahaqdan nifrət edənlər bir-birinə göz vursun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Çünki onlar sülh üçün danışmırlar,","poem":1},{"lineBreak":true},{"text":"Sözləri ilə ölkənin dinc sakinlərinə fənd qururlar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ağızlarını üstümə iri açıb belə deyirlər:","poem":1},{"lineBreak":true},{"text":"«Aha! Aha! Bax, öz gözümüzlə gördük».","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ya Rəbb, bunu gördün, indi susma,","poem":1},{"lineBreak":true},{"text":"Ey Xudavənd, məndən uzaq durma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ey Xudavənd Allahım, oyan, qalx,","poem":1},{"lineBreak":true},{"text":"Bu mübarizəmdən qoy mən haqlı çıxım.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ədalətinə görə mənə bəraət qazandır,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb Allahım, qoyma mənə görə sevinsinlər.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qoyma düşünsünlər: «Aha! Muradımıza çatmışıq!»","poem":1},{"lineBreak":true},{"text":"Qoyma söyləsinlər: «Onun başını yemişik!»","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Pis günümə şadlananlar","poem":1},{"lineBreak":true},{"text":"Qoy utanıb biabır olsunlar,","poem":1},{"lineBreak":true},{"text":"Qarşımda qürrələnənlər","poem":1},{"lineBreak":true},{"text":"Xəcalətə, rüsvayçılığa bürünsünlər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mənim haqlı çıxmağımı istəyənlər","poem":1},{"lineBreak":true},{"text":"Sevinib Səni mədh etsinlər.","poem":1},{"lineBreak":true},{"text":"Daim belə söyləsinlər:","poem":1},{"lineBreak":true},{"text":"«Öz qulunun əmin-amanlığını istəyən Rəbb ucalsın!»","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Dilim Sənin salehliyindən deyəcək,","poem":1},{"lineBreak":true},{"text":"Daim Sənə həmd edəcəyəm!","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Başımı aşağı salıb dua edirdim – yaxud duam cavabsız qalarkən.","reference":{"chapter":35,"verse":13}}]},"thisChapterLink":"/api/azb_bsa/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}