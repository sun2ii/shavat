{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["Məzmur 36"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Rəbbin qulu Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Şər pis insanın ürəyinə pıçıldayır,","poem":1},{"lineBreak":true},{"text":"Onun gözündə Allah qorxusu yoxdur.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Öz gözündə özünü yüksək tutur,","poem":1},{"lineBreak":true},{"text":"Nə təqsirini görür, nə də ona nifrət edir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dilindən fitnə-fəsad düşmür,","poem":1},{"lineBreak":true},{"text":"Müdrik, xeyirxah əməllərdən əl çəkib.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yatağında fitnələr barədə fikirləşir,","poem":1},{"lineBreak":true},{"text":"Pis yolda dayanır, şər işlərdən ikrah etmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, məhəbbətin göylərdədir,","poem":1},{"lineBreak":true},{"text":"Sədaqətin asimanı bürüyür.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dağlar kimi salehliyin uludur,","poem":1},{"lineBreak":true},{"text":"Dərya kimi ədalətin dərindir.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, həm insanı, həm heyvanı qoruyursan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Allah, məhəbbətin nə qədər qiymətlidir!","poem":1},{"lineBreak":true},{"text":"Bəşər övladları Sənin qanadlarının kölgəsinə sığınır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Evinin bolluğu ilə onları doydurursan,","poem":1},{"lineBreak":true},{"text":"Sənin xoşhal edən axar çayından onları içirirsən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki həyat mənbəyi Səndədir,","poem":1},{"lineBreak":true},{"text":"Biz Sənin nurunla görə bilirik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Səni tanıyanlara məhəbbətini,","poem":1},{"lineBreak":true},{"text":"Ürəyidüz olanlara salehliyini daima göstər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qoy təkəbbürlülərin təpiyi altında qalmayım,","poem":1},{"lineBreak":true},{"text":"Pis adamların əli ilə qovulmayım.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gördüm ki, şər iş görənlər yıxılıblar,","poem":1},{"lineBreak":true},{"text":"Onlar yerə sərilib, daha qalxa bilməzlər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}