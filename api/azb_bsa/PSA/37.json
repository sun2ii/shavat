{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"heading","content":["Məzmur 37"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Pislik edənlərə görə narahat olma,","poem":1},{"lineBreak":true},{"text":"Fitnəkarlıq edənlərə qibtə etmə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tezliklə onlar ot kimi quruyacaq,","poem":1},{"lineBreak":true},{"text":"Yaşıl çəmən kimi tez solacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbbə güvən, yaxşılıq et,","poem":1},{"lineBreak":true},{"text":"Bu diyarda arxayın ömür sür.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rəbdən zövq al,","poem":1},{"lineBreak":true},{"text":"O da səni ürəyinin istəklərinə çatdıracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yolunu Rəbbə ver,","poem":1},{"lineBreak":true},{"text":"Ona güvən,","poem":1},{"lineBreak":true},{"text":"O edəcək.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbb sənin salehliyini nur kimi aydınlaşdıracaq,","poem":1},{"lineBreak":true},{"text":"Həqiqətini gündüz günəşi tək çıxaracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbbin hüzurunda sükut et,","poem":1},{"lineBreak":true},{"text":"Onu səbirlə gözlə.","poem":1},{"lineBreak":true},{"text":"Yolunda uğur qazanan","poem":1},{"lineBreak":true},{"text":"Hiyləgər insan üçün narahat olma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Qəzəbi at, hiddətdən çəkin,","poem":1},{"lineBreak":true},{"text":"Narahat olma, bunlar insanı şərə salar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki şər adamlar kəsilib atılacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbə ümid bağlayanlar ölkəni mülk olaraq alacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bir az gözlə, pis yox olacaq,","poem":1},{"lineBreak":true},{"text":"Yerini axtarsan belə, tapılmayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Həlimlər yer üzünü mülk olaraq alacaq,","poem":1},{"lineBreak":true},{"text":"Əmin-amanlığın bolluğundan zövq tapacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şər adam salehin qəsdinə durur,","poem":1},{"lineBreak":true},{"text":"Ona qarşı dişlərini qıcayır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amma Xudavənd şər adama gülür,","poem":1},{"lineBreak":true},{"text":"Onun dövranının az olmasını bilir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Məzlumu, fəqiri yerə vurmaq üçün,","poem":1},{"lineBreak":true},{"text":"Düz yolda olanı boğazlamaq üçün","poem":1},{"lineBreak":true},{"text":"Pislər qılınc çəkər, ox-kamanını qurar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakin onların qılıncları öz ürəklərinə saplanacaq,","poem":1},{"lineBreak":true},{"text":"Ox-kamanları parça-parça olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Salehin az malı","poem":1},{"lineBreak":true},{"text":"Pislərin bütün sərvətlərindən yaxşıdır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki pislərin qol-qanadı qırılacaq,","poem":1},{"lineBreak":true},{"text":"Rəbb isə salehlərin dayağıdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rəbbə kamillərin gündəlik qayğıları məlumdur,","poem":1},{"lineBreak":true},{"text":"Onların irsi əbədi qalacaq.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dar gündə utanmayacaqlar,","poem":1},{"lineBreak":true},{"text":"Qıtlıqda tox yaşayacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lakin pislər həlak olacaq,","poem":1},{"lineBreak":true},{"text":"Rəbbin düşmənləri çəmənin təravəti kimi solacaq,","poem":1},{"lineBreak":true},{"text":"Tüstü kimi çəkilərək yox olacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pis adam borc alır, qaytarmır,","poem":1},{"lineBreak":true},{"text":"Salehlər səxavətlə paylayır.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Rəbdən bərəkət alan ölkəni mülk olaraq alacaq,","poem":1},{"lineBreak":true},{"text":"Lənət etdiyi kəslər kəsilib atılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rəbb insana gedəcəyi yolu göstərir,","poem":1},{"lineBreak":true},{"text":"Kimdən razı qalırsa, onu möhkəmləndirir.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bu insan büdrəsə də, yıxılmaz,","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb onun əlindən tutar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Gəncliyimdən qocalığımadək","poem":1},{"lineBreak":true},{"text":"Salehin tərk edildiyini,","poem":1},{"lineBreak":true},{"text":"Nəslinin çörək üçün diləndiyini görməmişəm.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"O hər zaman səxavətlə borc verər,","poem":1},{"lineBreak":true},{"text":"Övladlarına xeyir-dua gələr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Şərdən çəkinib yaxşılıq et ki,","poem":1},{"lineBreak":true},{"text":"Ölkədə əbədi məskən sala biləsən.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Çünki Rəbb ədaləti sevir,","poem":1},{"lineBreak":true},{"text":"Heç zaman möminlərini tərk etmir.","poem":1},{"lineBreak":true},{"text":"Salehlər daim müdafiə olunacaq,","poem":1},{"lineBreak":true},{"text":"Pislər nəsilliklə kəsilib atılacaq.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Salehlər ölkəni mülk olaraq alacaq,","poem":1},{"lineBreak":true},{"text":"Onlar orada əbədi məskən salacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Salehin ağzından hikmət çıxar,","poem":1},{"lineBreak":true},{"text":"Dili haqq söz danışar.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Çünki Allahın qanunu ürəyindədir,","poem":1},{"lineBreak":true},{"text":"Ayaqları büdrəmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Pis adam salehi güdür,","poem":1},{"lineBreak":true},{"text":"Onu öldürmək üçün fürsət axtarır.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Rəbb salehi pisin əlinə düşməyə qoymaz,","poem":1},{"lineBreak":true},{"text":"Ona ittiham oxunanda məhkum olmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Rəbbi gözlə, Onun yolunu tut,","poem":1},{"lineBreak":true},{"text":"O sənə ölkəni mülk olaraq verəcək, səni yüksəldəcək.","poem":1},{"lineBreak":true},{"text":"Pislərin kəsilib atılacağı zamanı görəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Münbit torpaqda yaşıl ağac tək bitən,","poem":1},{"lineBreak":true},{"text":"Kök salan zalım, pis adamı görmüşdüm.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"O keçib-getdi, yeri boş qaldı,","poem":1},{"lineBreak":true},{"text":"Onu axtararkən tapa bilmədim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Kamil adama bax, əməlisaleh insana nəzər yetir,","poem":1},{"lineBreak":true},{"text":"Gələcək sülhsevən adama bəxş ediləcək.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Amma bütün üsyankarlar birlikdə yox olacaq,","poem":1},{"lineBreak":true},{"text":"Pislərin kökü kəsiləcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Salehlərin qurtuluşu Rəbdəndir,","poem":1},{"lineBreak":true},{"text":"Dar gündə onlara pənah yeridir.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Rəbb onların imdadına çatır,","poem":1},{"lineBreak":true},{"text":"Onları qurtarıb pislərin əlindən alır,","poem":1},{"lineBreak":true},{"text":"Çünki onlar Rəbbə pənah aparır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}