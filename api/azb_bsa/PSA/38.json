{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"heading","content":["Məzmur 38"]},{"type":"hebrew_subtitle","content":["Davudun yadasalma məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, qəzəblənib məni töhmətləndirmə,","poem":1},{"lineBreak":true},{"text":"Hiddətlənib məni tənbeh eləmə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Artıq Sənin oxların mənə saplanıb,","poem":1},{"lineBreak":true},{"text":"Əllərin üstümə ağırlıq salıb.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bədənimdə qəzəbindən sağ yer qalmadı,","poem":1},{"lineBreak":true},{"text":"Günahıma görə sümüklərim də xəstəlik tapdı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki təqsirlərim başımdan aşır,","poem":1},{"lineBreak":true},{"text":"Ağır yük tək onlara gücüm çatmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ağılsızlığımın üzündən","poem":1},{"lineBreak":true},{"text":"Yaralarım iyrənc və irinlidir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mənim qəddim əyilib, ikiqat bükülmüşəm,","poem":1},{"lineBreak":true},{"text":"Gün boyu yaslı gəzirəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki belim qızdırmadan yandı,","poem":1},{"lineBreak":true},{"text":"Bədənimdə sağ yer qalmadı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Taqətim kəsildi, çox əzilmişəm,","poem":1},{"lineBreak":true},{"text":"Ürəyimdəki iztiraba görə ah-zar edirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey Xudavənd, mənim arzu-diləyim hüzurundadır,","poem":1},{"lineBreak":true},{"text":"Mənim iniltilərim Səndən gizli qalmır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ürəyim çırpınır, gücüm tükəndi,","poem":1},{"lineBreak":true},{"text":"Gözlərimin nuru da söndü.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Azarımı görüb məndən dost-yoldaşım uzaqlaşdı,","poem":1},{"lineBreak":true},{"text":"Qohumlarım məndən uzaqda qaldı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Canımın qəsdinə duranlar mənə tələ qurur,","poem":1},{"lineBreak":true},{"text":"Bədxahlarım ölümümdən danışır,","poem":1},{"lineBreak":true},{"text":"Gün boyu mənim üçün hiylə qururlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mən bir kar kimi eşitmirəm,","poem":1},{"lineBreak":true},{"text":"Dilsiz-ağızsız bir lal kimiyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dilsiz-cavabsız","poem":1},{"lineBreak":true},{"text":"Bir lal-kar kimiyəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ya Rəbb, ümidim Sənə qalıb,","poem":1},{"lineBreak":true},{"text":"Ey Xudavənd Allahım, Səndən cavab gözləyirəm!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dedim ki, qoy halıma sevinməsinlər,","poem":1},{"lineBreak":true},{"text":"Ayağım büdrəyəndə qarşımda öyünməsinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mən yıxılmaq üzrəyəm,","poem":1},{"lineBreak":true},{"text":"Daim əzabla üz-üzəyəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Təqsirlərimi etiraf edirəm,","poem":1},{"lineBreak":true},{"text":"Günahlarım üçün nigarançılıq çəkirəm.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Düşmənlərim qüvvətlidir, hələ sağdır,","poem":1},{"lineBreak":true},{"text":"Nahaq yerə mənə nifrət edənlər çoxdur.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaxşılığa yamanlıq edənlər","poem":1},{"lineBreak":true},{"text":"Yaxşılığa meyl etdiyimə görə əleyhimə durublar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ya Rəbb, məni tərk etmə!","poem":1},{"lineBreak":true},{"text":"Ey Allahım, məndən uzaq dayanma!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, tez imdadıma çat,","poem":1},{"lineBreak":true},{"text":"Mənim xilaskarım Sənsən!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}