{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["Məzmur 39"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri Yedutun üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Dedim: «Hər addımıma diqqət edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Dilimlə günah etməkdən çəkinəcəyəm.","poem":1},{"lineBreak":true},{"text":"Pis adam qarşımda durarkən","poem":1},{"lineBreak":true},{"text":"Dilimi yüyənləyib dinməyəcəyəm».","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dilimi saxlayıb susdum,","poem":1},{"lineBreak":true},{"text":"Yaxşılığa belə, danışmadım.","poem":1},{"lineBreak":true},{"text":"Dərdlərim ağırlaşdı,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Köksümdəki qəlbimə köz doldu.","poem":1},{"lineBreak":true},{"text":"Dərin düşünəndə yanıb-yaxıldım,","poem":1},{"lineBreak":true},{"text":"Dilimlə belə dedim:","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Ya Rəbb, mənə bildir,","poem":1},{"lineBreak":true},{"text":"Aqibətim necə olacaq?","poem":1},{"lineBreak":true},{"text":"Ömrümün günləri nə qədər qalıb?","poem":1},{"lineBreak":true},{"text":"Qoy nə qədər fani olduğumu anlayım!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Budur, günlərim ovcuna sığdı,","poem":1},{"lineBreak":true},{"text":"Ömrüm qarşında heç oldu.","poem":1},{"lineBreak":true},{"text":"Bəli, insan sadəcə bir nəfəsdir. Sela","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Əlbəttə, insan kölgə kimi dolaşır,","poem":1},{"lineBreak":true},{"text":"Həqiqətən, o boş yerə çarpışır,","poem":1},{"lineBreak":true},{"text":"Var-dövlət yığır, kimə qalacağını bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Xudavənd, indi mən nə gözləyim?","poem":1},{"lineBreak":true},{"text":"Mənim ümidim Sənsən!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Məni bütün təqsirlərimdən qurtar,","poem":1},{"lineBreak":true},{"text":"Məni axmaqların tənəsinə hədəf etmə.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Susdum, ağzımı açmadım,","poem":1},{"lineBreak":true},{"text":"Çünki Sən bunu etdin!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Göndərdiyin bəlanı mənim üstümdən götür,","poem":1},{"lineBreak":true},{"text":"Əlinin zərbəsindən gör necə əzildim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İnsanı təqsirinə görə məzəmmət edən zaman","poem":1},{"lineBreak":true},{"text":"Arzularını güvə kimi dağıdırsan.","poem":1},{"lineBreak":true},{"text":"Bəli, insan sadəcə bir nəfəsdir. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dinlə duamı, ya Rəbb, fəryadımı eşit!","poem":1},{"lineBreak":true},{"text":"Biganə qalma göz yaşlarıma.","poem":1},{"lineBreak":true},{"text":"Çünki Sənin yanında bir qəribəm,","poem":1},{"lineBreak":true},{"text":"Ata-babam kimi bir qonağam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bir azca nəzərini məndən çək,","poem":1},{"lineBreak":true},{"text":"Qoy köçüb getməzdən əvvəl dinc yaşayım».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}