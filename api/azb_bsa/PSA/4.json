{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Məzmur 4"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun simli alətlərin müşayiəti ilə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Səni çağıranda mənə cavab ver,","poem":1},{"lineBreak":true},{"text":"Ey adil Allahım!","poem":1},{"lineBreak":true},{"text":"Dara düşən zaman məni genişə çıxar,","poem":1},{"lineBreak":true},{"text":"Mənə lütf edib duama qulaq as!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ey insan övladları, nə vaxtadək","poem":1},{"lineBreak":true},{"text":"Şərəfimi rüsvayçılığa çevirəcəksiniz?","poem":1},{"lineBreak":true},{"text":"Nə vaxtadək boş şeylərə meyl göstərib","poem":1},{"lineBreak":true},{"text":"Yalan axtaracaqsınız? Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bilin ki, mömin insanı Rəbb Özü üçün ayırıb;","poem":1},{"lineBreak":true},{"text":"Nə vaxt Rəbbi çağırsam, məni eşidir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qorxub-titrəyin, günah etməyin,","poem":1},{"lineBreak":true},{"text":"Yatağınızda olarkən ürəyinizdə düşünün, dinməyin. Sela","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salehlik qurbanları kəsin,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Çoxları deyir: «Kim bizə yaxşılıq edəcək?»","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, üzünün nurunu üstümüzə sal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onların bol taxıl və təzə şəraba görə sevindiklərindən də çox","poem":1},{"lineBreak":true},{"text":"Mənim qəlbimə sevinc verdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arxayın yatıb yuxuya gedirəm,","poem":1},{"lineBreak":true},{"text":"Çünki yalnız Sən, ya Rəbb, məni əmin-amanlıqda yaşadırsan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}