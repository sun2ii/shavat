{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["Məzmur 40"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Rəbbi səbir edərək gözlədim,","poem":1},{"lineBreak":true},{"text":"Mənə tərəf dönərək fəryadımı eşitdi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O məni çamırlı quyudan,","poem":1},{"lineBreak":true},{"text":"Lilli bataqlıqdan çıxartdı.","poem":1},{"lineBreak":true},{"text":"Ayağımı qaya üzərində bərkitdi,","poem":1},{"lineBreak":true},{"text":"Hər addımımı möhkəm etdi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dilimə yeni bir nəğmə verdi,","poem":1},{"lineBreak":true},{"text":"İlahi ilə Allahımıza həmd etdim.","poem":1},{"lineBreak":true},{"text":"Bax nə qədər adam bunu görəcək,","poem":1},{"lineBreak":true},{"text":"Qorxub Rəbbə güvənəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbbə ümidlə arxalanan,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlülərə üz tutmayan,","poem":1},{"lineBreak":true},{"text":"Bütlərə aldananlara qoşulmayan","poem":1},{"lineBreak":true},{"text":"İnsan nə bəxtiyardır!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya Rəbb Allahım, Sənə bənzəyən yoxdur!","poem":1},{"lineBreak":true},{"text":"Bizə aid xariqələrin, düşüncələrin çoxdur.","poem":1},{"lineBreak":true},{"text":"Onlardan danışmaq istəsəm,","poem":1},{"lineBreak":true},{"text":"Belə deyərdim: «Sayı-hesabı yoxdur».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Qurbandan, təqdimdən xoşun gəlmədi,","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanı, günah qurbanı tələb etmədin,","poem":1},{"lineBreak":true},{"text":"Amma mənim qulağımı açdın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O zaman dedim: «Budur, gəlmişəm,","poem":1},{"lineBreak":true},{"text":"Sənin tumarında mənim haqqımda yazılıb.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey Allahım, Sənin iradəni yerinə yetirmək","poem":1},{"lineBreak":true},{"text":"Mənə zövq verir,","poem":1},{"lineBreak":true},{"text":"Qanunun qəlbimdədir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Çoxlu camaat arasında salehliyini car çəkdim,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, Sən bilirsən ki, ağzımı yummadım.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Salehliyini qəlbimdə gizlətmədim,","poem":1},{"lineBreak":true},{"text":"Xilaskar olduğunu, sədaqətini söylədim.","poem":1},{"lineBreak":true},{"text":"Çoxlu camaat arasından","poem":1},{"lineBreak":true},{"text":"Məhəbbətini, həqiqətini gizli saxlamadım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, mərhəmətini məndən əsirgəmə,","poem":1},{"lineBreak":true},{"text":"Daim məni məhəbbətinlə, həqiqətinlə qoru.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünki sonsuz bəlalar ətrafımı bürüdü,","poem":1},{"lineBreak":true},{"text":"Günahlarım mənə sarıldı.","poem":1},{"lineBreak":true},{"text":"Görə bilmirəm, çünki məndə ürək qalmadı,","poem":1},{"lineBreak":true},{"text":"Onlar başımın tükündən çoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, lütfünlə məni xilas et,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, dadıma tez çat!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Canımı almaq üçün qəsd quranlar","poem":1},{"lineBreak":true},{"text":"Qoy utanıb biabır olsunlar.","poem":1},{"lineBreak":true},{"text":"Pis günümdən zövq alanlar","poem":1},{"lineBreak":true},{"text":"Geri qovulub rüsvay olsunlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mənə «Aha! Aha!» deyənlər","poem":1},{"lineBreak":true},{"text":"Xəcalət içində çaşıb qalsınlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lakin Səni axtaranlar","poem":1},{"lineBreak":true},{"text":"Sənə görə qoy şad olub sevinsinlər.","poem":1},{"lineBreak":true},{"text":"Xilaskar olduğunu sevənlər","poem":1},{"lineBreak":true},{"text":"Daim «Qoy ucalsın Rəbb!» desinlər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Budur, bir məzlum, bir fəqirəm,","poem":1},{"lineBreak":true},{"text":"Lakin Xudavənd qayğıma qalır.","poem":1},{"lineBreak":true},{"text":"Köməyim, xilaskarım Sənsən,","poem":1},{"lineBreak":true},{"text":"Ey Allahım, ləngimə!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}