{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["Məzmur 41"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Yoxsulların qayğısına qalan nə bəxtiyardır!","poem":1},{"lineBreak":true},{"text":"Rəbb dar günündə onu qurtarar,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb onu qoruyar, salamat saxlayar.","poem":1},{"lineBreak":true},{"text":"O, ölkədə bəxtiyar olar,","poem":1},{"lineBreak":true},{"text":"Düşmənlərinə təslim edilməz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yatağa düşəndə Rəbb ona dayaq olar,","poem":1},{"lineBreak":true},{"text":"Onu bütün xəstəlikdən sağaldar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mən dedim: «Ya Rəbb, mənə rəhm et,","poem":1},{"lineBreak":true},{"text":"Canıma şəfa ver,","poem":1},{"lineBreak":true},{"text":"Çünki Sənə qarşı günah etmişəm».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Düşmənlərim məndən pis sözlər söyləyir:","poem":1},{"lineBreak":true},{"text":"«Bu nə vaxt öləcək, adı batacaq?» deyirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mənə baş çəkənlər yalan danışır,","poem":1},{"lineBreak":true},{"text":"Ürəklərinə böhtan yığır,","poem":1},{"lineBreak":true},{"text":"Bayıra çıxanda bundan danışırlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bütün mənə nifrət edənlər mənim barəmdə pıçıldaşır,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı pis fikirləri var.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Deyirlər: «Bu, ölümcül bəlaya düşüb,","poem":1},{"lineBreak":true},{"text":"Budur, yatır, daha qalxmaz».","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hətta etibarlı saydığım ən yaxın dostum,","poem":1},{"lineBreak":true},{"text":"Çörəyimi yeyən mənə xəyanət etdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sən, ya Rəbb, rəhm edib məni ayağa qaldır,","poem":1},{"lineBreak":true},{"text":"Qoy onlardan bunun əvəzini çıxım!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Məndən razı qaldığını bundan bilirəm:","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin mənə qalib gəlmədiyini görürəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kamil olduğum üçün məndən möhkəm yapışdın,","poem":1},{"lineBreak":true},{"text":"Məni hüzurunda əbədilik dayandırdın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alqış olsun İsrailin Allahı Rəbbə","poem":1},{"lineBreak":true},{"text":"Əzəldən sonsuza qədər!","poem":1},{"lineBreak":true},{"text":"Amin! Amin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}