{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"heading","content":["Məzmur 42"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının maskili."]},{"type":"verse","number":1,"content":[{"text":"Maral axar sulara həsrət qalan kimi,","poem":1},{"lineBreak":true},{"text":"Ey Allah, könlüm Sənin həsrətini çəkir!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey var olan Allah, mənim qəlbim Sənin üçün susayıb.","poem":1},{"lineBreak":true},{"text":"Ay Allah, nə vaxt gəlib hüzurunda görünüm?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Göz yaşlarım gecə-gündüz qidam olub,","poem":1},{"lineBreak":true},{"text":"Daim mənə deyirlər: «Bəs hanı Allahın?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bunları yadıma salarkən ürəyim üzülür,","poem":1},{"lineBreak":true},{"text":"Necə də yüksəkdən sevinc, şükür nidalarını söyləyərək","poem":1},{"lineBreak":true},{"text":"Bayram edən xalqın qarşısında gedərdim,","poem":1},{"lineBreak":true},{"text":"Onları Allahın evinə aparardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mənim qəlbim, niyə qırılmısan?","poem":1},{"lineBreak":true},{"text":"Axı niyə bu köksümdə təlaşlanırsan?","poem":1},{"lineBreak":true},{"text":"Ümidini yenə Allaha bağla,","poem":1},{"lineBreak":true},{"text":"Qoy Allahıma – məni qurtarana şükür edim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Köksümdəki qəlbim qırılıb,","poem":1},{"lineBreak":true},{"text":"Ona görə İordan diyarında,","poem":1},{"lineBreak":true},{"text":"Xermon, Misar dağında","poem":1},{"lineBreak":true},{"text":"Səni düşünürəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dərin sular şəlalələrinin səsi ilə","poem":1},{"lineBreak":true},{"text":"Dərin suları çağırdı,","poem":1},{"lineBreak":true},{"text":"Sənin ləpələrin, dalğaların başımdan aşdı.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb mənə gündüz məhəbbət göstərir,","poem":1},{"lineBreak":true},{"text":"Gecə isə həyatımın Allahına","poem":1},{"lineBreak":true},{"text":"Etdiyim dua və ilahi dilimdən düşmür.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qayama – Allahıma deyirəm: «Niyə məni unutdun?","poem":1},{"lineBreak":true},{"text":"Düşmənin zülmünə görə niyə yaslı gəzməliyəm?»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Düşmənlərim sümüklərimi qırıb məni təhqir edirlər,","poem":1},{"lineBreak":true},{"text":"Daim mənə «Bəs hanı Allahın?» deyirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mənim qəlbim, niyə qırılmısan?","poem":1},{"lineBreak":true},{"text":"Axı niyə bu köksümdə təlaşlanırsan?","poem":1},{"lineBreak":true},{"text":"Ümidini yenə Allaha bağla,","poem":1},{"lineBreak":true},{"text":"Qoy Allahıma – məni qurtarana şükür edim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}