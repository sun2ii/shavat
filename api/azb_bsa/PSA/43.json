{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Məzmur 43"]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, etibarsız millətə qarşı olan mübarizəmdən","poem":1},{"lineBreak":true},{"text":"Məni haqlı çıxart,","poem":1},{"lineBreak":true},{"text":"Məni hiyləgər, fitnəkar adamın əlindən qurtar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çünki Sən pənah gətirdiyim Allahsan.","poem":1},{"lineBreak":true},{"text":"Niyə məni atmısan?","poem":1},{"lineBreak":true},{"text":"Düşmənin zülmünə görə niyə yaslı gəzməliyəm?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Göndər Öz nurunu, həqiqətini,","poem":1},{"lineBreak":true},{"text":"Qoy yolunu mənə göstərsinlər,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağına, məskənlərinə","poem":1},{"lineBreak":true},{"text":"Qoy məni aparsınlar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onda Allahın qurbangahına,","poem":1},{"lineBreak":true},{"text":"Sevincim, fərəhim olan Allahımın yanına gedərəm.","poem":1},{"lineBreak":true},{"text":"Lira çalıb Sənə şükür edərəm,","poem":1},{"lineBreak":true},{"text":"Ey Allah, mənim Allahım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mənim qəlbim, niyə qırılmısan?","poem":1},{"lineBreak":true},{"text":"Axı niyə bu köksümdə təlaşlanırsan?","poem":1},{"lineBreak":true},{"text":"Ümidini yenə Allaha bağla,","poem":1},{"lineBreak":true},{"text":"Qoy Allahıma – məni qurtarana şükür edim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}