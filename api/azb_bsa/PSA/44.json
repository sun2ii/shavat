{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["Məzmur 44"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının maskili."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, öz qulağımızla eşitmişik ki,","poem":1},{"lineBreak":true},{"text":"Ata-babalarımızdan bizə çatıb ki,","poem":1},{"lineBreak":true},{"text":"Onların dövründə, qədim zamanda","poem":1},{"lineBreak":true},{"text":"Sən hansı işləri görmüsən.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Öz əlinlə millətləri torpaqlarından götürdün,","poem":1},{"lineBreak":true},{"text":"Atalarımızı orada yerləşdirdin.","poem":1},{"lineBreak":true},{"text":"Xalqlara bəla verdin,","poem":1},{"lineBreak":true},{"text":"Atalarımızın soyunu şaxələndirdin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onlar qılıncları ilə deyil,","poem":1},{"lineBreak":true},{"text":"Sənin sağ əlinlə torpaqlara sahib oldular.","poem":1},{"lineBreak":true},{"text":"Öz qolları deyil,","poem":1},{"lineBreak":true},{"text":"Sənin sağ qolun onlara zəfər qazandırdı.","poem":1},{"lineBreak":true},{"text":"Onlara üzündən nur verdin,","poem":1},{"lineBreak":true},{"text":"Çünki Sən onları sevirdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey mənim Allahım, Sənsən Padşahım,","poem":1},{"lineBreak":true},{"text":"Əmr et, Yaqub nəsli qələbə çalsın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Köməyinlə düşmənlərimizi devirək,","poem":1},{"lineBreak":true},{"text":"İsminlə əleyhdarlarımızı əzək.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ox-kamanıma güvənmərəm,","poem":1},{"lineBreak":true},{"text":"Qılıncım məni qurtarmaz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yalnız Sən bizi düşmənlərimizdən xilas etdin,","poem":1},{"lineBreak":true},{"text":"Bizə nifrət edənləri rüsvay etdin!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gün boyu Allahla fəxr edirik,","poem":1},{"lineBreak":true},{"text":"İsminə sonsuza qədər şükür edirik. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"İndi isə bizi atıb rüsvay etmisən,","poem":1},{"lineBreak":true},{"text":"Ordularımızla yürüşə çıxmırsan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Düşmənin qarşısından bizi geriyə qovursan,","poem":1},{"lineBreak":true},{"text":"Bizə nifrət edənlər bizi soyub-talayır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bizi kəsilməyə gedən qoyun kimi etdin,","poem":1},{"lineBreak":true},{"text":"Sən bizi millətlər arasına səpdin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Öz xalqını yaman ucuz satdın,","poem":1},{"lineBreak":true},{"text":"Onların dəyərindən çox qazanmadın.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bizi qonşularımıza tənə hədəfi etdin,","poem":1},{"lineBreak":true},{"text":"Ələ salıb lağ edənlərlə yan-yörəmizi doldurdun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bizi millətlərin dilinə saldın,","poem":1},{"lineBreak":true},{"text":"Ümmətlərin gülüş hədəfinə döndərdin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rüsvayçılığım daim qarşımı kəsir,","poem":1},{"lineBreak":true},{"text":"Bu xəcalətin üzündən,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Təhqir, söyüş sözlərindən,","poem":1},{"lineBreak":true},{"text":"Düşməndən, qisasçıdan üzümü gizlədirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Səni unutmadığımız,","poem":1},{"lineBreak":true},{"text":"Əhdinə xəyanət etmədiyimiz halda","poem":1},{"lineBreak":true},{"text":"Bunların hamısı başımıza gəldi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Səndən qəlbimiz dönmədiyi,","poem":1},{"lineBreak":true},{"text":"Yolundan ayaqlarımız büdrəmədiyi halda","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sən bizi çaqqalların diyarında əzdin,","poem":1},{"lineBreak":true},{"text":"Qatı zülmətə qərq etdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Allahımızın ismini unutmuş olsaydıq,","poem":1},{"lineBreak":true},{"text":"Yad allaha əl açmış olsaydıq,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Allah bunu araşdırmazdımı?","poem":1},{"lineBreak":true},{"text":"Çünki qəlbin hər sirrini bilən Odur.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Biz gün boyu Sənin uğrunda öldürülürük,","poem":1},{"lineBreak":true},{"text":"Qurbanlıq qoyunlar sayılırıq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ey Xudavənd, oyan, niyə yatmısan?","poem":1},{"lineBreak":true},{"text":"Qalx, bizi əbədilik atma!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Niyə üzünü bizdən gizlədirsən?","poem":1},{"lineBreak":true},{"text":"Əzab-əziyyətimizi nə üçün unutdun?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Qəlbimiz palçıq kimi əzilmişdir,","poem":1},{"lineBreak":true},{"text":"Qəddimiz əyilib yerə dəyir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Qalx, bizə kömək et,","poem":1},{"lineBreak":true},{"text":"Bizi məhəbbətin naminə xilas et!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}