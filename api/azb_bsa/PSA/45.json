{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"heading","content":["Məzmur 45"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının «Şoşannim» üstə oxunan maskili."]},{"type":"hebrew_subtitle","content":["Sevgi nəğməsi"]},{"type":"verse","number":1,"content":[{"text":"Qəlbim yaxşı sözlərlə çağlayır,","poem":1},{"lineBreak":true},{"text":"Qoy şeirlərimi padşahıma söyləyim,","poem":1},{"lineBreak":true},{"text":"Dilim mahir bir xəttatın qələminə oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bəşər övladlarının ən gözəli sənsən,","poem":1},{"lineBreak":true},{"text":"Dodaqlarından lətafətli sözlər tökülür,","poem":1},{"lineBreak":true},{"text":"Çünki Allah səni əbədilik xeyir-dualı edib.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey cəngavər, qılıncını belinə bağla,","poem":1},{"lineBreak":true},{"text":"Əzəmətini, ehtişamını göstər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Həqiqət, itaətkarlıq və salehlik naminə","poem":1},{"lineBreak":true},{"text":"Döyüş arabasına qalx,","poem":1},{"lineBreak":true},{"text":"Əzəmətinlə uğur qazan.","poem":1},{"lineBreak":true},{"text":"Qoy sağ əlindən möhtəşəm işlər gəlsin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nə itidir oxların,","poem":1},{"lineBreak":true},{"text":"Padşahın düşmənlərinin köksünə saplanır.","poem":1},{"lineBreak":true},{"text":"Xalqlar ayağının altına yıxılır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey Allah, taxtın əbədilik, sonsuzadək qalır,","poem":1},{"lineBreak":true},{"text":"Sənin şahlıq əsan insaf əsasıdır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Salehliyi sevib pisliyə nifrət edirsən.","poem":1},{"lineBreak":true},{"text":"Ona görə Allah, sənin Allahın","poem":1},{"lineBreak":true},{"text":"Sevinc yağı ilə","poem":1},{"lineBreak":true},{"text":"Yoldaşlarından çox səni məsh edib.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütün paltarlarından","poem":1},{"lineBreak":true},{"text":"Mirra, əzvay və Çin darçınının ətri gəlir.","poem":1},{"lineBreak":true},{"text":"Fil dişindən olan saraylarından","poem":1},{"lineBreak":true},{"text":"Səni şənləndirən simli alətlərin sədası gəlir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Şərəfə çatdırdığın qadınlar arasında","poem":1},{"lineBreak":true},{"text":"Şahzadə xanımlar da var.","poem":1},{"lineBreak":true},{"text":"Mələkə olacaq qız sağ qoluna girib,","poem":1},{"lineBreak":true},{"text":"Ofir qızıllarına bürünüb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dinlə, ey qız, diqqət elə, sözümə qulaq as,","poem":1},{"lineBreak":true},{"text":"Öz xalqını, ata evini unut.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sənin gözəlliyin padşahı məftun etsin.","poem":1},{"lineBreak":true},{"text":"O sənin ağandır, ona itaət et.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sur xalqı yanına hədiyyələr gətirəcək,","poem":1},{"lineBreak":true},{"text":"Xalqın varlıları səndən lütf istəyəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bu şah qızı sarayına cah-calalla gətirilir,","poem":1},{"lineBreak":true},{"text":"Paltarları qızıl tikmələrə bürünmüş.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Padşahın yanına əlvan libasda gətirilir,","poem":1},{"lineBreak":true},{"text":"Rəfiqələri sağdışı-soldışıdır.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onlar sevinclə, şadlıqla gətirilir,","poem":1},{"lineBreak":true},{"text":"Padşahın sarayına girirlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ey padşah, ata-baban kimi oğulların olacaq,","poem":1},{"lineBreak":true},{"text":"Onlara bütün yer üzünün hakimiyyətini verəcəksən.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Adını nəsillərdən-nəsillərə çatdıracağam,","poem":1},{"lineBreak":true},{"text":"Xalqlar da sonsuza qədər sənə həmd oxuyacaq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}