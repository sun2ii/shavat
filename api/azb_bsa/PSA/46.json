{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["Məzmur 46"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının «Alamot» üstə oxunan ilahisi."]},{"type":"verse","number":1,"content":[{"text":"Allah bizə sığınacaqdır, qüvvətdir,","poem":1},{"lineBreak":true},{"text":"Dar gündə çox kömək edir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buna görə biz qorxmuruq:","poem":1},{"lineBreak":true},{"text":"Yer üzü alt-üst olsa belə,","poem":1},{"lineBreak":true},{"text":"Dağlar uçub dənizin köksünə aşsa belə,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dalğalar kükrəyib qalxsa belə,","poem":1},{"lineBreak":true},{"text":"Vurub dağları yırğalasa belə,","poem":1},{"lineBreak":true},{"text":"Biz qorxmuruq. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bir çay var ki suları Allahın şəhərinə axır,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalanın müqəddəs məskəninə sevinc gətirir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allah bu şəhərin mərkəzində sarsılmaz durub,","poem":1},{"lineBreak":true},{"text":"Ona dan yeri söküləndə yardım edər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Millətlər kükrəyər, ölkələr sarsılar,","poem":1},{"lineBreak":true},{"text":"Allah səsini çıxaranda dünya əriyər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi bizimlədir!","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahı qalamızdır! Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gəlin, görün Rəbbin işlərini,","poem":1},{"lineBreak":true},{"text":"Dünyada etdiyi viranəliyi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, yerin ucqarlarınadək döyüşləri dayandırar,","poem":1},{"lineBreak":true},{"text":"Kamanları qırar, nizələri sındırar,","poem":1},{"lineBreak":true},{"text":"Döyüş arabalarını oda atar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Dayanın, bilin ki, Mən Allaham,","poem":1},{"lineBreak":true},{"text":"Millətlər arasında ucayam,","poem":1},{"lineBreak":true},{"text":"Yer üzündə ucayam!»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ordular Rəbbi bizimlədir!","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahı qalamızdır! Sela","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}