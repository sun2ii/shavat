{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Məzmur 47"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey bütün xalqlar, əl çalın,","poem":1},{"lineBreak":true},{"text":"Cuşa gəlib Allaha nida edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haqq-Taala Rəbb necə də zəhmlidir,","poem":1},{"lineBreak":true},{"text":"Bütün yer üzünün böyük Padşahıdır!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onun sayəsində xalqlar bizə tabe olub,","poem":1},{"lineBreak":true},{"text":"O, ümmətləri ayaqlarımızın altına salıb.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sevdiyi Yaqubun fəxri olan torpağı","poem":1},{"lineBreak":true},{"text":"Bizə mülk etmək üçün seçdi. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allah nida ilə ucaldı,","poem":1},{"lineBreak":true},{"text":"Rəbb şeypur səsi ilə yüksəldi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tərənnüm edin Allahı, tərənnüm edin!","poem":1},{"lineBreak":true},{"text":"Tərənnüm edin Padşahımızı, tərənnüm edin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Çünki Allah bütün yer üzünün Padşahıdır,","poem":1},{"lineBreak":true},{"text":"Onu ilahilərlə tərənnüm edin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Allah Öz müqəddəs taxtında əyləşir,","poem":1},{"lineBreak":true},{"text":"Allah millətlərə padşahlıq edir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İbrahimin Allahının xalqı ilə bir yerdə olmaq üçün","poem":1},{"lineBreak":true},{"text":"Xalqların əsilzadələri yığılır,","poem":1},{"lineBreak":true},{"text":"Çünki yer üzünün sipərləri Allahındır.","poem":1},{"lineBreak":true},{"text":"O nə qədər ucadır!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}