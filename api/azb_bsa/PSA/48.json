{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["Məzmur 48"]},{"type":"hebrew_subtitle","content":["Qorah övladlarının məzmuru."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Allahımızın şəhərində,","poem":1},{"lineBreak":true},{"text":"Öz müqəddəs dağında","poem":1},{"lineBreak":true},{"text":"Rəbb çox əzəmətlidir,","poem":1},{"lineBreak":true},{"text":"Bol həmdlərə layiqdir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Şimala tərəf böyük Padşahın şəhəri –","poem":1},{"lineBreak":true},{"text":"Sion dağı ucalığı ilə gözəldir,","poem":1},{"lineBreak":true},{"text":"Dünyanın sevincidir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onun qalalarında Allah Özünü","poem":1},{"lineBreak":true},{"text":"Alınmaz qala kimi göstərmişdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Padşahlar bir yerə yığıldılar,","poem":1},{"lineBreak":true},{"text":"Siona yürüş etdilər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onu görəndə mat qaldılar,","poem":1},{"lineBreak":true},{"text":"Qorxub tez qaçdılar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamilə qadının ağrısı kimi","poem":1},{"lineBreak":true},{"text":"Canlarına lərzə düşdü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sən şərq küləyi ilə","poem":1},{"lineBreak":true},{"text":"Tarşiş gəmilərini parçaladın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ordular Rəbbinin şəhərində –","poem":1},{"lineBreak":true},{"text":"Allahımızın şəhərində","poem":1},{"lineBreak":true},{"text":"Nə eşitmişiksə, onu gördük,","poem":1},{"lineBreak":true},{"text":"Allah oranı əbədi saxlayacaq. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey Allah, məbədində","poem":1},{"lineBreak":true},{"text":"Məhəbbətin barədə dərindən düşünürük.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Allah, yerin ucqarlarına qədər","poem":1},{"lineBreak":true},{"text":"Adın həmdə layiqdir.","poem":1},{"lineBreak":true},{"text":"Sağ əlin ədalətinlə doludur.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qoy Sion dağı sevinsin.","poem":1},{"lineBreak":true},{"text":"Sənin hökmlərinə görə","poem":1},{"lineBreak":true},{"text":"Qoy Yəhuda qızları şad olsun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sionun ətrafında gəzib-dolaşın,","poem":1},{"lineBreak":true},{"text":"Onun qüllələrini sayın.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Divarlarına fikir verin,","poem":1},{"lineBreak":true},{"text":"Qalalarına diqqətlə baxın.","poem":1},{"lineBreak":true},{"text":"Gələcək nəslə belə deyin:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"«Əbədi, sonsuzadək","poem":1},{"lineBreak":true},{"text":"Bu Allah bizim Allahımızdır.","poem":1},{"lineBreak":true},{"text":"Ömrümüzün sonunadək","poem":1},{"lineBreak":true},{"text":"O bizə yol göstərəcək!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}