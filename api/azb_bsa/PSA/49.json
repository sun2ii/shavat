{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"heading","content":["Məzmur 49"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Siz, ey bütün xalqlar,","poem":1},{"lineBreak":true},{"text":"Bunu dinləyin!","poem":1},{"lineBreak":true},{"text":"Ey dünya sakinləri,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey sadə insanlar, əsilzadələr,","poem":1},{"lineBreak":true},{"text":"Ey zənginlər, fəqirlər,","poem":1},{"lineBreak":true},{"text":"Hamınız qulaq asın!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dilimdən hikmətli sözlər çıxacaq,","poem":1},{"lineBreak":true},{"text":"Bu müdrik fikirlər qəlbimdən gəlir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu məsəllərə qulaq asacağam,","poem":1},{"lineBreak":true},{"text":"Bu müəmmamı mən lira ilə açacağam:","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Niyə yaman günlərdən,","poem":1},{"lineBreak":true},{"text":"Ətrafımda məni təqib edənlərin pis niyyətindən qorxum?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Onlar var-dövlətlərinə güvənirlər,","poem":1},{"lineBreak":true},{"text":"Bol sərvətləri ilə öyünürlər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amma kimsə öz ömrünü satın ala bilməz,","poem":1},{"lineBreak":true},{"text":"Həyatının haqqını Allaha ödəyə bilməz.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Çünki insanın canının haqqı çox dəyərlidir,","poem":1},{"lineBreak":true},{"text":"Ən üstün qiymətlər ona kifayət etmir ki,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"İnsan əbədi ömür sürsün,","poem":1},{"lineBreak":true},{"text":"Məzarı heç görməsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aydındır ki, həm hikmətlilər ölür,","poem":1},{"lineBreak":true},{"text":"Həm axmaqlar, həm də səfehlər tələf olur,","poem":1},{"lineBreak":true},{"text":"Hamının sərvəti başqasına nəsib olur.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Torpaqlara sahib olsalar belə,","poem":1},{"lineBreak":true},{"text":"Son mənzilləri qəbirdir,","poem":1},{"lineBreak":true},{"text":"Yenə nəsillərdən-nəsillərədək yerləri məzardır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"İnsan dəyərli olsa da, qalmır,","poem":1},{"lineBreak":true},{"text":"Həlak olan heyvana oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Özünə güvənənlərin yolu ölümə aparır,","poem":1},{"lineBreak":true},{"text":"Özündən razı lovğaların sonu belədir. Sela","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onlar sürü kimi ölülər diyarına aparılar,","poem":1},{"lineBreak":true},{"text":"Onları ölüm otarar.","poem":1},{"lineBreak":true},{"text":"Səhər açılanda əməlisalehlər onlara hakim olar.","poem":1},{"lineBreak":true},{"text":"Yurd-yuvasından uzaq bir yerdə, ölülər diyarında","poem":1},{"lineBreak":true},{"text":"Cəsədləri çürüyüb qalar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amma Allah ölülər diyarının əlindən canımı qurtaracaq,","poem":1},{"lineBreak":true},{"text":"Məni oradan alacaq. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Qorxma bir adam varlı olanda,","poem":1},{"lineBreak":true},{"text":"Evinə sərvət yığılanda.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki öləndə heç nə apara bilməz,","poem":1},{"lineBreak":true},{"text":"Sərvəti ardınca getməz.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sağ ikən özünü xoşbəxt saysa da,","poem":1},{"lineBreak":true},{"text":"Uğur qazananda təriflənsə də,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ata-babalarının yanına gedəcək,","poem":1},{"lineBreak":true},{"text":"Sonsuzadək orada işıq görməyəcək.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"İnsan dəyərli olsa da, anlamır,","poem":1},{"lineBreak":true},{"text":"Həlak olan heyvana oxşayır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}