{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["Məzmur 5"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun nəfəs alətlərinin müşayiəti ilə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, sözlərimə qulaq as,","poem":1},{"lineBreak":true},{"text":"Ah-naləmə nəzər sal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Padşahım, ey Allahım, fəryad səsimə qulaq as,","poem":1},{"lineBreak":true},{"text":"Çünki Sənə dua edirəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, səhər erkən səsimi eşidirsən,","poem":1},{"lineBreak":true},{"text":"Səhər erkən Sənə dua edib cavab gözləyirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Çünki Sən pislikdən xoşlanan Allah deyilsən,","poem":1},{"lineBreak":true},{"text":"Şər Sənin yanına gəlməz.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Təkəbbürlülər hüzurunda dayana bilməz,","poem":1},{"lineBreak":true},{"text":"Bütün şər iş görənlərə nifrət edirsən.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yalan söyləyənləri məhv edirsən,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, qaniçənlərdən, hiyləgərlərdən ikrah edirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fəqət mən bol məhəbbətin naminə evinə gələcəyəm,","poem":1},{"lineBreak":true},{"text":"Üz tutub müqəddəs məbədinə qorxu ilə səcdə edəcəyəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya Rəbb, ədalətinlə məni düz yola yönəlt,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin üzündən Öz yolunu qarşımda düzəlt.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onların dillərində düz söz yoxdur,","poem":1},{"lineBreak":true},{"text":"Ürəkləri pis niyyətlə doludur.","poem":1},{"lineBreak":true},{"text":"Boğazları açıq qəbirdir,","poem":1},{"lineBreak":true},{"text":"Dilləri yalan danışır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Allah, onları təqsirkar çıxar,","poem":1},{"lineBreak":true},{"text":"Qoy niyyətlərinə görə bu şər insanlar yıxılsın.","poem":1},{"lineBreak":true},{"text":"Onları saysız günahlarına görə qov,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin əleyhinə qalxıblar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sənə pənah gətirənlərsə qoy sevinsin,","poem":1},{"lineBreak":true},{"text":"Qoy Səni daima mədh etsinlər,","poem":1},{"lineBreak":true},{"text":"Çünki onları Sən qoruyursan.","poem":1},{"lineBreak":true},{"text":"Sənin adını sevənlər sevincdən cuşa gəlsin!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ya Rəbb, salehə xeyir-dua verirsən,","poem":1},{"lineBreak":true},{"text":"Lütfünlə sipər kimi onları hifz edirsən.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}