{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["Məzmur 50"]},{"type":"hebrew_subtitle","content":["Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Güclü Rəbb Allah çağırır,","poem":1},{"lineBreak":true},{"text":"Gündoğandan günbatanadək","poem":1},{"lineBreak":true},{"text":"Bütün yer üzünü səsləyir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qüsursuz, gözəl Siondan","poem":1},{"lineBreak":true},{"text":"Allah Öz nurunu saçır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allahımız gəlir, sakit dayanmaz,","poem":1},{"lineBreak":true},{"text":"Önündə yandırıb-yaxan alov var,","poem":1},{"lineBreak":true},{"text":"Ətrafında şiddətli tufan qopar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O, xalqını mühakimə etmək üçün","poem":1},{"lineBreak":true},{"text":"Yuxarıdakı göyü və yeri şahid çağırır:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«Hüzuruma möminlərimi,","poem":1},{"lineBreak":true},{"text":"Qurban verib Mənimlə əhd bağlayanları yığın!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Göylər ədalətini bəyan edir,","poem":1},{"lineBreak":true},{"text":"Çünki hakim Allahın Özüdür. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Danışıram, dinlə Məni, ey xalqım!","poem":1},{"lineBreak":true},{"text":"Ey İsrail, əleyhinə şəhadət edirəm.","poem":1},{"lineBreak":true},{"text":"Allaham, sənin Allahın Mənəm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qurbanlarından ötrü səni tənbeh etmirəm,","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanlarını həmişə görürəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tövləndəki buğanı, ağılındakı təkəni","poem":1},{"lineBreak":true},{"text":"Səndən qəbul etmirəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki Mənimdir bütün meşələrdə olan heyvanlar,","poem":1},{"lineBreak":true},{"text":"Minlərlə dağda otlayan mal-qaralar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dağlardakı bütün quşları tanıyıram,","poem":1},{"lineBreak":true},{"text":"Bütün çöl heyvanları əlimin altındadır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Acsam, sənə demərəm,","poem":1},{"lineBreak":true},{"text":"Çünki dünyaya, dünyadakı hər şeyə sahibəm!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Məgər Mən buğa əti yeyirəm?","poem":1},{"lineBreak":true},{"text":"Məgər Mən təkə qanı içirəm?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Şükür qurbanını Allaha təqdim et,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalaya əhd etdiyin təqdimlərini ver.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dar gündə Məni çağır,","poem":1},{"lineBreak":true},{"text":"Mən səni xilas edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sən də Məni şərəfləndirəcəksən».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pislərəsə Allah deyir:","poem":1},{"lineBreak":true},{"text":"«Qaydalarımı əzbər söyləməyə haqqınız varmı?","poem":1},{"lineBreak":true},{"text":"Əhdimi dilə gətirməyə haqqınız varmı?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mənim iradıma nifrət edirsən,","poem":1},{"lineBreak":true},{"text":"Sözlərimi qulaq ardına vurursan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bir oğru görəndə ona qoşulursan,","poem":1},{"lineBreak":true},{"text":"Zinakarlara yoldaş olursan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ağzını şər üçün açırsan,","poem":1},{"lineBreak":true},{"text":"Dilini fırıldaq üçün işə salırsan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Oturub qardaşından gileylənirsən,","poem":1},{"lineBreak":true},{"text":"Ananın oğlundan qeybət edirsən.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sən belə edəndə Mən dinməmişəm.","poem":1},{"lineBreak":true},{"text":"Məgər Məni özün kimi sanırsan?","poem":1},{"lineBreak":true},{"text":"İndi isə səni tənbeh edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Əməllərini gözünün önünə düzəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ey Allahı unudanlar,","poem":1},{"lineBreak":true},{"text":"Buna diqqət edin!","poem":1},{"lineBreak":true},{"text":"Yoxsa sizi parça-parça edərəm,","poem":1},{"lineBreak":true},{"text":"Heç birinizi xilas edən olmaz.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kim ki şükür qurbanı təqdim edir,","poem":1},{"lineBreak":true},{"text":"Məni şərəfləndirir.","poem":1},{"lineBreak":true},{"text":"Doğru yol tutan şəxsə","poem":1},{"lineBreak":true},{"text":"Allahın xilasını göstərəcəyəm».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}