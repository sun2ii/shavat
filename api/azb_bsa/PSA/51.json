{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["Məzmur 51"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Davudun Bat-Şeva ilə olan münasibətinə görə Natan peyğəmbər onun yanına gəlib irad tutandan sonra."]},{"type":"verse","number":1,"content":[{"text":"Məhəbbətinə görə, ey Allah, mənə rəhm et,","poem":1},{"lineBreak":true},{"text":"Bol mərhəmətinə görə qanunsuzluqlarımı sil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Təqsirimi tamamilə yu,","poem":1},{"lineBreak":true},{"text":"Günahımdan məni təmizlə.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki qanunsuzluqlarımı bilirəm,","poem":1},{"lineBreak":true},{"text":"Günahım daim gözümün qarşısındadır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sənə, yalnız Sənə qarşı günah işlətmişəm,","poem":1},{"lineBreak":true},{"text":"Gözündə pis sayılanı etmişəm.","poem":1},{"lineBreak":true},{"text":"Mənə görə çıxarılan hökmündə ədalətlisən,","poem":1},{"lineBreak":true},{"text":"Məni məhkum etməkdə haqlısan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən doğulandan bəri günahkaram,","poem":1},{"lineBreak":true},{"text":"Ana bətnindən belə, təqsirkaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sənsə ürəkdə düzlüyün olmasını istəyirsən,","poem":1},{"lineBreak":true},{"text":"Mənə daxilən hikmət öyrət.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Məni züfa ilə pak et, təmiz olum,","poem":1},{"lineBreak":true},{"text":"Məni yu, qardan da ağ olum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mənə şadlıq, sevinc səsini eşitdir,","poem":1},{"lineBreak":true},{"text":"Qırdığın sümüklərim xoşhallansın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Üzünü tut, günahlarımı görmə,","poem":1},{"lineBreak":true},{"text":"Bütün təqsirlərimi sil.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Allah, məndə təmiz ürək yarat,","poem":1},{"lineBreak":true},{"text":"Daxilimə yenidən sədaqət ruhunu ver.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Məni Öz hüzurundan atma,","poem":1},{"lineBreak":true},{"text":"Müqəddəs Ruhunu məndən götürmə.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xilasının sevincini mənə qaytar,","poem":1},{"lineBreak":true},{"text":"İtaətkarlıq ruhu verib mənə dayaq ol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Qoy Sənin yollarını qanunsuzlara öyrədim,","poem":1},{"lineBreak":true},{"text":"Günahkarlar Sənə sarı dönsünlər.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ey Allah, məni azad et,","poem":1},{"lineBreak":true},{"text":"Qan tökmək təqsirindən məni qurtar,","poem":1},{"lineBreak":true},{"text":"Dilim ədalətini mədh etsin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, Sən dilimi aç,","poem":1},{"lineBreak":true},{"text":"Ağzımla Sənə olan həmdlərimi bəyan edim.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sən qurbanlardan zövq almazsan,","poem":1},{"lineBreak":true},{"text":"Yoxsa kəsərdim.","poem":1},{"lineBreak":true},{"text":"Yandırma qurbanlarından razı qalmazsan,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Allaha məqbul olan qurban sınmış ruhdur,","poem":1},{"lineBreak":true},{"text":"Sən sınan və peşman olan ürəyə xor baxmazsan, ey Allah!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lütfünlə Siona yaxşılıq et,","poem":1},{"lineBreak":true},{"text":"Yerusəlimin divarlarını bərpa et.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onda doğru yolla təqdim edilən qurbanlardan,","poem":1},{"lineBreak":true},{"text":"Bütöv yandırma qurbanlarından zövq alarsan.","poem":1},{"lineBreak":true},{"text":"O zaman qurbangahında buğalar qurban kəsilər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}