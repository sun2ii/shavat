{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["Məzmur 52"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun maskili."]},{"type":"hebrew_subtitle","content":["Edomlu Doeq Davudun Aximelekin evinə getdiyini Şaula xəbər verəndə"]},{"type":"verse","number":1,"content":[{"text":"Pisliyinlə nə üçün öyünürsən, ey cəngavər?","poem":1},{"lineBreak":true},{"text":"Sonsuzdur Allahın məhəbbəti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey hiyləgər, dilin insanı məhv edir,","poem":1},{"lineBreak":true},{"text":"İti ülgüc kimi kəsir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaxşılıqdan çox yamanı,","poem":1},{"lineBreak":true},{"text":"Doğru sözdən çox yalanı sevirsən. Sela","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey hiyləgər dilli,","poem":1},{"lineBreak":true},{"text":"Məhvedici sözləri çox sevirsən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allah səni əbədilik qıracaq,","poem":1},{"lineBreak":true},{"text":"Yaxandan yapışaraq evindən çölə atacaq,","poem":1},{"lineBreak":true},{"text":"Dirilər arasından kökünü qoparacaq. Sela","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Salehlər buna baxıb qorxacaqlar,","poem":1},{"lineBreak":true},{"text":"Gülə-gülə belə deyəcəklər:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Bu adam Allaha pənah gətirmədi,","poem":1},{"lineBreak":true},{"text":"Öz bol sərvətinə güvəndi,","poem":1},{"lineBreak":true},{"text":"Başqalarını məhv edərək gücləndi».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Amma mən Allahın evində","poem":1},{"lineBreak":true},{"text":"Yaşıl zeytun ağacına bənzərəm,","poem":1},{"lineBreak":true},{"text":"Daima, əbədilik","poem":1},{"lineBreak":true},{"text":"Allahın məhəbbətinə güvənirəm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sənin gördüyün işlərə görə daim şükür edirəm,","poem":1},{"lineBreak":true},{"text":"Möminlərin qarşısında gözəl isminə ümid bağlayıram!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}