{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["Məzmur 53"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Maxalat» üstə oxunan maskili."]},{"type":"verse","number":1,"content":[{"text":"Axmaqlar ürəyində «Allah yoxdur!» deyə düşünürlər,","poem":1},{"lineBreak":true},{"text":"İnsanlar pozulmuş, əməlləri iyrənc olmuş,","poem":1},{"lineBreak":true},{"text":"Yaxşı iş görən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Allah göylərdən bəşər övladına baxır;","poem":1},{"lineBreak":true},{"text":"Görəsən Allahı dərk edən, Onu axtaran varmı?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hamı birgə pozulub, namus əldən gedib,","poem":1},{"lineBreak":true},{"text":"Bir nəfər də olsun yaxşı iş görən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Şər iş görənlərin hər biri məgər heç nə qanmırmı?","poem":1},{"lineBreak":true},{"text":"Xalqımı çörək yerinə yeyirlər, Allahı çağırmırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onlar böyük dəhşətə düşəcək,","poem":1},{"lineBreak":true},{"text":"Heç görünməmiş dəhşətə düçar olacaqlar.","poem":1},{"lineBreak":true},{"text":"Allah bizi mühasirəyə salanların","poem":1},{"lineBreak":true},{"text":"Sümüklərini qırıb dağıdacaq.","poem":1},{"lineBreak":true},{"text":"Onlar qarşımızda pərt qalacaq,","poem":1},{"lineBreak":true},{"text":"Çünki Allah tərəfindən rədd olunacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaş İsrailin azadlığı Siondan gələydi!","poem":1},{"lineBreak":true},{"text":"Allah Öz xalqına bəxtəvər günlərini qaytaran zaman","poem":1},{"lineBreak":true},{"text":"Yaqub övladları şadlıq edəcək,","poem":1},{"lineBreak":true},{"text":"İsraillilər sevinəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}