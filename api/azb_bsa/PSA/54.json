{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Məzmur 54"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun simli alətlərin müşayiəti ilə oxunan maskili."]},{"type":"hebrew_subtitle","content":["Ziflilər Şaulun yanına gəlib «yəqin ki Davud bizim aramızda gizlənib» deyəndə."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, isminlə məni qurtar,","poem":1},{"lineBreak":true},{"text":"Qüvvənlə mənə bəraət ver.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Allah, mənim duamı dinlə,","poem":1},{"lineBreak":true},{"text":"Dilimdən çıxan sözlərə qulaq as.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yadellilər əleyhimə qalxıblar,","poem":1},{"lineBreak":true},{"text":"Zalımlar canımı almaq üçün məni axtarırlar,","poem":1},{"lineBreak":true},{"text":"Heç Allaha baxmırlar. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Budur, Allah mənə kömək edir,","poem":1},{"lineBreak":true},{"text":"Xudavənd ömrümə dayaq olur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O bu şəri düşmənlərimə tərəf döndərəcək.","poem":1},{"lineBreak":true},{"text":"Mənim sadiq Allahım, düşmənləri yox et!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sənə könüllü qurban kəsəcəyəm,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, gözəl isminə şükür edəcəyəm!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Məni hər darlıqdan xilas etdin,","poem":1},{"lineBreak":true},{"text":"Gözüm düşmənlərimin məhvini gördü.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}