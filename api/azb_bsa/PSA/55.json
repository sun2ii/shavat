{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["Məzmur 55"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun simli alətlərin müşayiəti ilə oxunan maskili."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, duamı dinlə,","poem":1},{"lineBreak":true},{"text":"Yalvarışımdan gizlənmə!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaxşı qulaq as mənə, bir cavab söylə,","poem":1},{"lineBreak":true},{"text":"Düşüncələrim məni narahat edir,","poem":1},{"lineBreak":true},{"text":"Çaş-baş qalmışam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Düşmənin səsindən,","poem":1},{"lineBreak":true},{"text":"Zalımların zülmündən narahatam.","poem":1},{"lineBreak":true},{"text":"Məni onların şər işləri sarsıdır,","poem":1},{"lineBreak":true},{"text":"Onlar qəzəblə mənə qəsd-qərəz qurur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Köksümdəki ürəyim sancır,","poem":1},{"lineBreak":true},{"text":"Ölüm dəhşəti üzərimə düşdü.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mənə qorxu və titrətmə gəlib,","poem":1},{"lineBreak":true},{"text":"Canımı vicvicə bürüyüb.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dedim: «Kaş göyərçin kimi qanadlarım olaydı,","poem":1},{"lineBreak":true},{"text":"Uçub rahatlıq tapaydım.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Doğrudan da, uzaqlara qaçardım,","poem":1},{"lineBreak":true},{"text":"Çöllərdə məskən salardım. Sela","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu sərt yellərdən, qasırğalardan","poem":1},{"lineBreak":true},{"text":"Daldalanmaq üçün tez bir yerə gedəydim».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ey Xudavənd, bu şəhəri alt-üst et,","poem":1},{"lineBreak":true},{"text":"Oradakıların dillərinə ayrılıq sal.","poem":1},{"lineBreak":true},{"text":"Orada zorakılıq, dava gördüm;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bunlar gecə-gündüz divarlarının üstündə dolanır,","poem":1},{"lineBreak":true},{"text":"Pislik və şər şəhərin içindədir,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aralarında qırğın var,","poem":1},{"lineBreak":true},{"text":"Meydanlarından hədə-qorxu və fırıldaq çıxır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Əgər məni düşmən təhqir etsəydi, dözərdim,","poem":1},{"lineBreak":true},{"text":"Yağı qarşımda qürrələnsəydi, gizlənərdim.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amma bunu sən etdin, ey rəfiqim,","poem":1},{"lineBreak":true},{"text":"Ey yoldaşım, ürək həmdəmim.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Səninlə şirin-şirin söhbət edərdik,","poem":1},{"lineBreak":true},{"text":"Allah evinə birgə gedərdik.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qoy düşmənlərə qəfil ölüm gəlsin,","poem":1},{"lineBreak":true},{"text":"Onlar diri-diri ölülər diyarına düşsün,","poem":1},{"lineBreak":true},{"text":"Çünki şər onların evində və qəlbindədir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mənsə Allahı səsləyərəm,","poem":1},{"lineBreak":true},{"text":"Rəbb məni xilas edər.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Səhər, günorta, axşam nalə çəkirəm,","poem":1},{"lineBreak":true},{"text":"Ah-zar edirəm, O, səsimi eşidir.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çoxları əleyhimə çıxır,","poem":1},{"lineBreak":true},{"text":"Amma O, canımı döyüşdən qoruyur.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Əzəldən bəri taxtında oturan Allah","poem":1},{"lineBreak":true},{"text":"Məni eşidib onları zəlil edəcək. Sela","poem":1},{"lineBreak":true},{"text":"Çünki onlar əsla dəyişməz,","poem":1},{"lineBreak":true},{"text":"Allahdan qorxmurlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yoldaşım dostuna əl qaldırır,","poem":1},{"lineBreak":true},{"text":"Dostluq əhdini pozur.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Onun dili kərə yağından da yağlıdır,","poem":1},{"lineBreak":true},{"text":"Qəlbində isə çəkişmələr yaşayır,","poem":1},{"lineBreak":true},{"text":"Sözləri zeytun yağından yumşaqdır,","poem":1},{"lineBreak":true},{"text":"Amma sıyrılmış qılınclardır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sən qayğı yükünü Rəbbə ver,","poem":1},{"lineBreak":true},{"text":"Qoy sənə dayaq olsun.","poem":1},{"lineBreak":true},{"text":"O heç vaxt salehə sarsıntı verməz.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ey Allah, qanlı, hiyləgər adamları","poem":1},{"lineBreak":true},{"text":"Qəbirə endirəcəksən.","poem":1},{"lineBreak":true},{"text":"Onların ömrü yarıya çatmayacaq.","poem":1},{"lineBreak":true},{"text":"Amma mən yalnız Sənə güvənirəm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}