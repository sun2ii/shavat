{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["Məzmur 56"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Yonat elem rexoqim» üstə oxunan miktamı."]},{"type":"hebrew_subtitle","content":["Filiştlilər onu Qat şəhərində yaxalayanda."]},{"type":"verse","number":1,"content":[{"text":"Rəhm et mənə, ey Allah,","poem":1},{"lineBreak":true},{"text":"İnsanlar sel kimi üstümə cumur,","poem":1},{"lineBreak":true},{"text":"Gün boyu döyüşərək məni sıxışdırırlar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gün boyu düşmənlərim sel kimi üstümə cumur,","poem":1},{"lineBreak":true},{"text":"Əleyhimə qalxan məğrur döyüşçülər çoxdur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu dəhşətli gündə","poem":1},{"lineBreak":true},{"text":"Mən yalnız Sənə güvənirəm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vədinə görə Allaha həmd edirəm,","poem":1},{"lineBreak":true},{"text":"Mən Allaha güvənirəm, qorxmuram;","poem":1},{"lineBreak":true},{"text":"Fani insan mənə nə edə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hər işimə onlar ziyan vururlar,","poem":1},{"lineBreak":true},{"text":"Həmişə mənə qəsd-qərəz qururlar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xəlvət bir yerə yığılıb hər addımımı izləyirlər,","poem":1},{"lineBreak":true},{"text":"Pusqu qurub canımı almaq üçün gözləyirlər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Günahlarına görə onları cəzalandır,","poem":1},{"lineBreak":true},{"text":"Ey Allah, qəzəblə bu xalqları yerlə yeksan et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dərdlərimi saydın,","poem":1},{"lineBreak":true},{"text":"Göz yaşlarımı tuluğuna yığ.","poem":1},{"lineBreak":true},{"text":"Bunlar Sənin kitabında yazılmayıbmı?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mən Səni çağıranda düşmənlərim geri dönür,","poem":1},{"lineBreak":true},{"text":"Bunu bilirəm, Allah mənim tərəfimdədir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vədinə görə həmd etdiyim Allaha,","poem":1},{"lineBreak":true},{"text":"Vədinə görə həmd etdiyim Rəbbə,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allaha güvənirəm və qorxmuram;","poem":1},{"lineBreak":true},{"text":"Fani insan mənə nə edə bilər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey Allah, Sənə olan əhdlərimə əməl etməliyəm,","poem":1},{"lineBreak":true},{"text":"Sənə şükür qurbanı təqdim edəcəyəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çünki canımı ölümdən qurtardın,","poem":1},{"lineBreak":true},{"text":"Ayaqlarımı büdrəməyə qoymadın,","poem":1},{"lineBreak":true},{"text":"Belə ki Allahın hüzurunda,","poem":1},{"lineBreak":true},{"text":"Həyatın nurunda dolanım.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}