{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Məzmur 57"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Al-taşxet» üstə oxuduğu miktamı."]},{"type":"hebrew_subtitle","content":["Şauldan qaçıb mağarada gizlənəndə."]},{"type":"verse","number":1,"content":[{"text":"Mənə rəhm et, ey Allah, mənə rəhm et!","poem":1},{"lineBreak":true},{"text":"Canımı götürüb Sənin yanına pənah gətirmişəm.","poem":1},{"lineBreak":true},{"text":"Bəlalar keçib-gedənəcən","poem":1},{"lineBreak":true},{"text":"Qanadlarının altına sığınacağam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Allah-Taalanı çağırıram,","poem":1},{"lineBreak":true},{"text":"Mənim üçün hər şeyi verən Allahı çağırıram.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Göydən mənə qurtuluş göndərəcək,","poem":1},{"lineBreak":true},{"text":"Başımı yemək istəyəni rüsvay edəcək. Sela","poem":1},{"lineBreak":true},{"text":"Allah Öz məhəbbətini və sədaqətini göndərəcək.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sanki aslanların arasındayam,","poem":1},{"lineBreak":true},{"text":"Yandırıb-yaxan adamların arasında yatıram.","poem":1},{"lineBreak":true},{"text":"Dişləri nizədir, oxdur,","poem":1},{"lineBreak":true},{"text":"Dilləri iti qılıncdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey Allah, göylər üzərində ucal!","poem":1},{"lineBreak":true},{"text":"Ehtişamın bütün yer üzərində olsun!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yolumda tələ qurub canımı üzdülər,","poem":1},{"lineBreak":true},{"text":"Mənə qazdıqları quyuya özləri düşdülər. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Allah, qəlbim Sənə möhkəm bağlanıb, möhkəm bağlanıb,","poem":1},{"lineBreak":true},{"text":"Qoy ilahi oxuyum, Səni tərənnüm edim.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey mənim ruhum, oyan!","poem":1},{"lineBreak":true},{"text":"Ey çəng və lira, oyan!","poem":1},{"lineBreak":true},{"text":"Qoy səhəri oyadım.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, xalqlar arasında","poem":1},{"lineBreak":true},{"text":"Sənə şükür edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ümmətlər arasında","poem":1},{"lineBreak":true},{"text":"Səni tərənnüm edəcəyəm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məhəbbətin böyükdür, göylərə çatır,","poem":1},{"lineBreak":true},{"text":"Sədaqətin buludlara dəyir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey Allah, göylər üzərində ucal!","poem":1},{"lineBreak":true},{"text":"Ehtişamın bütün yer üzərində olsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}