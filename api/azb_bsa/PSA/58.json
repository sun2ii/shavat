{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"heading","content":["Məzmur 58"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Al-taşxet» üstə oxuduğu miktamı."]},{"type":"verse","number":1,"content":[{"text":"Ey qüdrətlilər, doğrudanmı ədalətlə danışırsınız?","poem":1},{"lineBreak":true},{"text":"Bəşər övladları üçün insaflamı hökm çıxarırsınız?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xeyr, qəlbinizdən fitnə-fəsad çıxır,","poem":1},{"lineBreak":true},{"text":"Bu dünyada əlinizdən zorakılıq gəlir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pis adamlar ana bətnindən belə, azğındırlar,","poem":1},{"lineBreak":true},{"text":"Çaşıblar, doğulan gündən belə, yalançıdırlar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlar əfi ilan kimi zəhərlidirlər,","poem":1},{"lineBreak":true},{"text":"Qulaqlarını tıxayan gürzəyə bənzəyirlər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlar ilanoynadanın səsinə gəlmir,","poem":1},{"lineBreak":true},{"text":"Usta bir ovsunçu onu ovsunlaya bilmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey Allah, onların ağızlarındakı dişlərini qır,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, bu gənc aslanların dişlərini çıxar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoy onlar su kimi axıb yox olsun,","poem":1},{"lineBreak":true},{"text":"Kaman üstündəki oxlarının ucları qırılsın.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İlbiz kimi gedərkən ərisinlər,","poem":1},{"lineBreak":true},{"text":"Ölü doğulan körpələr kimi günəş nuru görməsinlər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ocaqda qazanlarını qızdırmazdan əvvəl kol-kosları sovrulsun,","poem":1},{"lineBreak":true},{"text":"Nə qurularından, nə də yaşlarından heç nə qalmasın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pislərdən qisas alındığını görən salehlər şad olacaq,","poem":1},{"lineBreak":true},{"text":"Ayaqlarını onların qanına batıracaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İnsanlar belə deyəcək: «Bəli, salehlər barlı olar,","poem":1},{"lineBreak":true},{"text":"Həqiqətən, dünyanın hökmranı olan bir Allah var!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}