{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"heading","content":["Məzmur 59"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Al-taşxet» üstə oxunan miktamı."]},{"type":"hebrew_subtitle","content":["Şaul onu öldürmək üçün evinə adam göndərib pusqu qoyanda."]},{"type":"verse","number":1,"content":[{"text":"Ey Allahım, məni düşmənlərimdən qurtar,","poem":1},{"lineBreak":true},{"text":"Əleyhdarlarımın əlindən hifz et.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Məni şər iş görənlərdən xilas et,","poem":1},{"lineBreak":true},{"text":"Məni qaniçənlərdən azad et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Canımı almaq üçün məni güdürlər,","poem":1},{"lineBreak":true},{"text":"Güclülər əleyhimə birləşiblər.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, üsyankar, günahkar,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Təqsirkar olmadığım halda","poem":1},{"lineBreak":true},{"text":"Onlar mənə qarşı qəti tədbir görürlər.","poem":1},{"lineBreak":true},{"text":"Bir oyan, halımı gör, yardım et,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Ordular Rəbbi, İsrailin Allahı!","poem":1},{"lineBreak":true},{"text":"Bütün millətlərə cəza vermək üçün oyan,","poem":1},{"lineBreak":true},{"text":"Xəyanətkar pislərin heç birinə rəhm etmə. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bu pis adamlar axşamüstü qayıdırlar,","poem":1},{"lineBreak":true},{"text":"Köpək kimi mırıldayırlar,","poem":1},{"lineBreak":true},{"text":"Şəhərdə sülənib-dolaşırlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gör dodaqlarından nələr tökülür,","poem":1},{"lineBreak":true},{"text":"Ağızlarından qılınclar çıxır.","poem":1},{"lineBreak":true},{"text":"Onlar zənn edirlər ki, eşidən yoxdur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lakin, ya Rəbb, Sən onlara gülürsən,","poem":1},{"lineBreak":true},{"text":"Bütün millətlərə rişxənd edirsən.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey mənə qüvvət verən,","poem":1},{"lineBreak":true},{"text":"Səni gözləyirəm!","poem":1},{"lineBreak":true},{"text":"Ey Allahım, qalamsan,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mənə məhəbbətini göstərirsən!","poem":1},{"lineBreak":true},{"text":"Ey Allah, imdad etmək üçün çıxacaqsan,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin qırılmasını mənə göstərəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ey Xudavənd, Sənsən sipərimiz!","poem":1},{"lineBreak":true},{"text":"Xalqımın yadında qalsın deyə","poem":1},{"lineBreak":true},{"text":"Düşmənləri qırma, lakin gücünlə","poem":1},{"lineBreak":true},{"text":"Onları dağıdaraq məğlub et.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Günahkar dillərinə görə,","poem":1},{"lineBreak":true},{"text":"Ağızlarının sözlərinə görə","poem":1},{"lineBreak":true},{"text":"Təkəbbürlülərin tələsinə özləri düşsünlər.","poem":1},{"lineBreak":true},{"text":"Yağdırdıqları lənətlərə görə,","poem":1},{"lineBreak":true},{"text":"Dedikləri yalanlara görə","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onları qəzəbinlə məhv et,","poem":1},{"lineBreak":true},{"text":"Məhv et, qoy bir nişanə qalmasın.","poem":1},{"lineBreak":true},{"text":"Qoy insanlar bilsinlər:","poem":1},{"lineBreak":true},{"text":"Allah səltənət sürür","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinin üzərində,","poem":1},{"lineBreak":true},{"text":"Ta ucqarlara qədər yer üzərində. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bu pis adamlar axşamüstü qayıdırlar,","poem":1},{"lineBreak":true},{"text":"Köpək kimi mırıldayırlar,","poem":1},{"lineBreak":true},{"text":"Şəhərdə sülənib-dolaşırlar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Avara-avara gəzib yem axtarırlar,","poem":1},{"lineBreak":true},{"text":"Doyunca tapmasalar, gecə boyu ulayırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mən isə Sənin qüdrətini tərənnüm edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sübh tezdən məhəbbətini mədh edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Çünki Sən mənə qala olmusan,","poem":1},{"lineBreak":true},{"text":"Dar günümdə mənim pənahımsan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ey mənə qüvvət verən,","poem":1},{"lineBreak":true},{"text":"Səni tərənnüm edəcəyəm!","poem":1},{"lineBreak":true},{"text":"Ey Allahım, qalamsan,","poem":1},{"lineBreak":true},{"text":"Mənə məhəbbətini göstərirsən!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}