{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["Məzmur 6"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun səkkiz simli alətlərin müşayiəti ilə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, qəzəblənib məni töhmətləndirmə,","poem":1},{"lineBreak":true},{"text":"Hiddətlənib məni tənbeh etmə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ya Rəbb, mənə rəhm et,","poem":1},{"lineBreak":true},{"text":"Çünki taqətim qalmayıb.","poem":1},{"lineBreak":true},{"text":"Mənə şəfa ver, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Sümüklərim sızlayır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Canıma vəlvələ düşüb.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, bu nə vaxtadək olacaq?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, gəl, mənə kömək et,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin naminə məni xilas et!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ölüb-gedən insan Səni xatırlamaz.","poem":1},{"lineBreak":true},{"text":"Axı ölülər diyarından kim Sənə şükür edəcək?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Öz ah-naləmdən bezmişəm,","poem":1},{"lineBreak":true},{"text":"Hər gecə ağlamaqdan döşəyim islanır,","poem":1},{"lineBreak":true},{"text":"Göz yaşlarımdan yatağım yaş olur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qəmdən gözümün nuru sönüb,","poem":1},{"lineBreak":true},{"text":"Gözlərim düşmənləri görməkdən zəifləyib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Siz ey şər iş görənlər, məndən uzaq durun!","poem":1},{"lineBreak":true},{"text":"Çünki Rəbb hönkürtümü eşitdi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O, yalvarışımı dinlədi,","poem":1},{"lineBreak":true},{"text":"Rəbb duamı qəbul etdi!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bütün düşmənlərim rüsvay olacaq,","poem":1},{"lineBreak":true},{"text":"Canlarına vəlvələ salınacaq,","poem":1},{"lineBreak":true},{"text":"Xəcalət içində bir andaca geri qayıdacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}