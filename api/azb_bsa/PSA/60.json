{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"heading","content":["Məzmur 60"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Şuşan-edut» üstə oxunan təlim miktamı."]},{"type":"hebrew_subtitle","content":["Davud Naharayim və Sova Aramlıları ilə döyüşərkən Yoav gedib Duz vadisində on iki min Edomlunu öldürəndə."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, Sən bizi atmısan,","poem":1},{"lineBreak":true},{"text":"Müdafiə qüvvələrimizi dağıtmısan.","poem":1},{"lineBreak":true},{"text":"Bizə qəzəblənmisən,","poem":1},{"lineBreak":true},{"text":"Bizi əvvəlki halımıza qaytar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yeri lərzəyə salmısan,","poem":1},{"lineBreak":true},{"text":"Torpağını dağıtmısan.","poem":1},{"lineBreak":true},{"text":"Yarıqlarını yenə bitişdir,","poem":1},{"lineBreak":true},{"text":"Çünki yer sarsılıb.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Öz xalqını çətinliyə salmısan,","poem":1},{"lineBreak":true},{"text":"Şərab içirərək bizi səndələtmisən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Səndən qorxanlara isə bayraq vermisən,","poem":1},{"lineBreak":true},{"text":"Qoy onu həqiqət naminə qaldırsınlar. Sela","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sevdiyin insanların xilas olması üçün","poem":1},{"lineBreak":true},{"text":"Sağ əlinlə bizi qurtar, mənə cavab ver!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Allah Öz müqəddəs məskənindən belə söylədi:","poem":1},{"lineBreak":true},{"text":"«Şekemi sevinclə bölüşdürəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sukkot dərəsini böləcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gilead torpağı Mənimdir,","poem":1},{"lineBreak":true},{"text":"Menaşşe torpağı da Mənimdir,","poem":1},{"lineBreak":true},{"text":"Efrayim başımın dəbilqəsidir,","poem":1},{"lineBreak":true},{"text":"Yəhuda Mənim əsamdır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moav yuyunmaq üçün ləyənimdir,","poem":1},{"lineBreak":true},{"text":"Çarığımı ataraq Edomu tutacağam,","poem":1},{"lineBreak":true},{"text":"Zəfər harayını Filiştə salacağam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kim məni istehkamlı şəhərə apara bilər?","poem":1},{"lineBreak":true},{"text":"Kim mənə Edoma qədər yol göstərər?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ay Allah, Sən niyə bizi atmısan?","poem":1},{"lineBreak":true},{"text":"Ay Allah, qoşunlarımızla niyə yürüşə çıxmırsan?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bizə düşmənin qarşısında imdad et,","poem":1},{"lineBreak":true},{"text":"Çünki insanın köməyi puçdur.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Allahın köməyi ilə igidlik edəcəyik,","poem":1},{"lineBreak":true},{"text":"O, düşmənlərimizi tapdalayacaq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}