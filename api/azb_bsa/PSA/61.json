{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Məzmur 61"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun simli alətlərin müşayiəti ilə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, fəryadımı eşit,","poem":1},{"lineBreak":true},{"text":"Duamı dinlə.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Düşkünlük qəlbimi alıb,","poem":1},{"lineBreak":true},{"text":"Mən dünyanın ucqarından Səni çağırıram.","poem":1},{"lineBreak":true},{"text":"Sən məni əlçatmaz bir qayaya apar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Çünki Sən mənim pənahgahımsan,","poem":1},{"lineBreak":true},{"text":"Düşmənə qarşı möhkəm qülləsən.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoy sonsuzadək çadırında yaşayım,","poem":1},{"lineBreak":true},{"text":"Qanadlarının altında pənah tapım. Sela","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sən, ey Allah, etdiyim əhdi eşitdin,","poem":1},{"lineBreak":true},{"text":"Adından qorxanlara təyin etdiyin payı mənə verdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sən ömür ver, qoy padşahın yaşasın,","poem":1},{"lineBreak":true},{"text":"İlləri nəsillərdən-nəsillərə qədər uzansın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Allahın hüzurunda daim taxtda otursun,","poem":1},{"lineBreak":true},{"text":"Məhəbbət və sədaqət ver, onu qorusun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mənsə adını həmişə tərənnüm edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Hər gün əhd etdiyim təqdimləri verəcəyəm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}