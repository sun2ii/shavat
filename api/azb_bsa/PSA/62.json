{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["Məzmur 62"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri Yedutun üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Susan qəlbim yalnız Allahı gözləyir,","poem":1},{"lineBreak":true},{"text":"Ondadır qurtuluşum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yalnız Odur qayam, qurtuluşum,","poem":1},{"lineBreak":true},{"text":"O mənim qalamdır, mən əsla sarsılmaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İnsan divar kimi əyiləndə,","poem":1},{"lineBreak":true},{"text":"Hasar kimi laxlayanda","poem":1},{"lineBreak":true},{"text":"Nə vaxtadək üstünə hücum edəcəksiniz?","poem":1},{"lineBreak":true},{"text":"Nə vaxtadək onu əzəcəksiniz?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yalnız fikirləşirsiniz, onu nüfuzdan salaq,","poem":1},{"lineBreak":true},{"text":"Çünki yalandan zövq alırsınız.","poem":1},{"lineBreak":true},{"text":"Diliniz xeyir-dua söyləsə də,","poem":1},{"lineBreak":true},{"text":"Qəlbiniz lənət yağdırır. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey qəlbim, sükutla Allahı gözlə,","poem":1},{"lineBreak":true},{"text":"Çünki ümidim Ondadır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qayam, qurtuluşum yalnız Odur,","poem":1},{"lineBreak":true},{"text":"O mənim qalamdır, mən sarsılmaram.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qurtuluşum, şərəfim Allaha bağlıdır,","poem":1},{"lineBreak":true},{"text":"Allah möhkəm qayam və pənahımdır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey xalq, hər zaman Ona arxalan,","poem":1},{"lineBreak":true},{"text":"Onun hüzurunda qəlbini açıb-boşalt,","poem":1},{"lineBreak":true},{"text":"Çünki Allah bizim pənahımızdır! Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bəşər övladları yalnız bir nəfəsdir –","poem":1},{"lineBreak":true},{"text":"İnsan övladları fanidir.","poem":1},{"lineBreak":true},{"text":"Tərəzinin gözündə çəkərkən hamısı yuxarı qalxır,","poem":1},{"lineBreak":true},{"text":"Çəkisi bir nəfəsdən yüngül gəlir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heç zaman zorakılığınıza güvənməyin,","poem":1},{"lineBreak":true},{"text":"Talan malına boş yerə ümid bağlamayın,","poem":1},{"lineBreak":true},{"text":"Var-dövlətiniz artsa da, ona arxalanmayın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Allah bir dəfə dedi,","poem":1},{"lineBreak":true},{"text":"Bunu iki dəfə eşitdim:","poem":1},{"lineBreak":true},{"text":"Qüdrət Allahındır,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, məhəbbət Sənindir!","poem":1},{"lineBreak":true},{"text":"Sən hər kəsə əməlinə görə əvəz verirsən!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}