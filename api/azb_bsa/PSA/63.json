{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Məzmur 63"]},{"type":"hebrew_subtitle","content":["Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Yəhuda çölündə olanda."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, mənim Allahım Sənsən,","poem":1},{"lineBreak":true},{"text":"Sənin üçün yaman qəribsəmişəm.","poem":1},{"lineBreak":true},{"text":"Quraq, cansıxıcı, susuz bir diyarda","poem":1},{"lineBreak":true},{"text":"Sənsiz könlüm susuzdur.","poem":1},{"lineBreak":true},{"text":"Bütün varlığımla həsrətini çəkirəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Müqəddəs yerdə Səni seyr edirdim,","poem":1},{"lineBreak":true},{"text":"Qüdrətini, əzəmətini görürdüm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mənim dilim Səni tərənnüm edir,","poem":1},{"lineBreak":true},{"text":"Məhəbbətin bu həyatdan gözəldir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bütün ömrüm boyu Sənə alqış edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Əllərimi qaldırıb adınla Səni səsləyəcəyəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sanki yağlı yeməklə canım tox olacaq,","poem":1},{"lineBreak":true},{"text":"Dilim Səni mədh edəcək, ağzım həmd oxuyacaq.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yatanda belə, Səni xatırlayıram,","poem":1},{"lineBreak":true},{"text":"Gecə növbələrində Səni düşünürəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sən mənə kömək oldun,","poem":1},{"lineBreak":true},{"text":"Qanadlarının kölgəsində Sənə mədh oxuyacağam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Könlüm Sənə bağlanır,","poem":1},{"lineBreak":true},{"text":"Sağ əlin məni möhkəm tutur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amma canımın qəsdinə duranlar","poem":1},{"lineBreak":true},{"text":"Yerin dibinə batacaqlar,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qılıncın ağzına tuş gələcəklər,","poem":1},{"lineBreak":true},{"text":"Çaqqallara yem olacaqlar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amma padşah Allaha görə sevinəcək,","poem":1},{"lineBreak":true},{"text":"Adına and içən hər kəs həmd söyləyəcək,","poem":1},{"lineBreak":true},{"text":"Yalançıların isə ağzı yumulacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}