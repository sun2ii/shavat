{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Məzmur 64"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, eşit səsimi, Sənə şikayət edirəm,","poem":1},{"lineBreak":true},{"text":"Həyatımı düşmən vahiməsindən qoru.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pislərin fəndlərindən,","poem":1},{"lineBreak":true},{"text":"Şər iş görənlərin vəlvələsindən","poem":1},{"lineBreak":true},{"text":"Məni qoru.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onlar qılınc kimi dillərini itiləyirlər,","poem":1},{"lineBreak":true},{"text":"Kamanın üstünə ox kimi acı sözlərini qoyurlar,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Günahsız insana pusqu qurduqları yerlərdən","poem":1},{"lineBreak":true},{"text":"Qəfildən, çəkinmədən atırlar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bir-birlərini şər iş görməkdə cəsarətləndirirlər,","poem":1},{"lineBreak":true},{"text":"Gizlənib tələ qurmaq üçün məsləhət edirlər,","poem":1},{"lineBreak":true},{"text":"«Bunu kim görəcək?» deyirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fitnəkarlıqla qəsd qururlar və belə deyirlər:","poem":1},{"lineBreak":true},{"text":"«Ustalıqla fənd işlətdik».","poem":1},{"lineBreak":true},{"text":"İnsanın daxili, qəlbi görünməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakin Allah onlara ox atacaq,","poem":1},{"lineBreak":true},{"text":"Onlar qəflətən yaralanacaq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Öz dilləri özlərini yıxacaq,","poem":1},{"lineBreak":true},{"text":"Onları görənlər başını bulayıb xor baxacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bütün insanlar qorxacaq,","poem":1},{"lineBreak":true},{"text":"Allahın əməllərini bəyan edəcək,","poem":1},{"lineBreak":true},{"text":"Onun işləri barədə düşünəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Saleh insan Rəbbə görə sevinəcək,","poem":1},{"lineBreak":true},{"text":"Ona pənah gətirəcək.","poem":1},{"lineBreak":true},{"text":"Bütün ürəyidüz insanlar Rəbbə həmd edəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}