{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["Məzmur 65"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, Səni Sionda həmdlər gözləyir,","poem":1},{"lineBreak":true},{"text":"Sənə edilən əhd yerinə yetiriləcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey duaları eşidən,","poem":1},{"lineBreak":true},{"text":"Bütün bəşər hüzuruna gələcək.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mən günaha batmışdım,","poem":1},{"lineBreak":true},{"text":"Lakin Sən üsyankarlığımızı kəffarə edirsən.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nə bəxtiyardır evinin həyətlərində yaşayan,","poem":1},{"lineBreak":true},{"text":"Seçib Özünə yaxın etdiyin insan!","poem":1},{"lineBreak":true},{"text":"Biz Sənin evinin, müqəddəs məbədinin","poem":1},{"lineBreak":true},{"text":"Nemətləri ilə doyacağıq!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sən ey qurtuluşumuzun Allahı,","poem":1},{"lineBreak":true},{"text":"Zəhmli işlərinlə ədalətini göstərirsən,","poem":1},{"lineBreak":true},{"text":"Bizə cavab verirsən.","poem":1},{"lineBreak":true},{"text":"Sən yer üzünün bütün ucqarlarının,","poem":1},{"lineBreak":true},{"text":"Ən uzaq dənizlərin belə, ümidisən.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sən qüdrətə bürünmüsən,","poem":1},{"lineBreak":true},{"text":"Qüvvətinlə dağları möhkəmlətmisən.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dənizlərin uğultusunu,","poem":1},{"lineBreak":true},{"text":"Dalğaların gurultusunu,","poem":1},{"lineBreak":true},{"text":"Ümmətlərin çaxnaşmasını","poem":1},{"lineBreak":true},{"text":"Yatıran Sənsən.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dünyanın ucqarlarında yaşayanlar","poem":1},{"lineBreak":true},{"text":"Sənin əlamətlərinə mat qalırlar.","poem":1},{"lineBreak":true},{"text":"Gündoğandan günbatanadək bütün insanlar","poem":1},{"lineBreak":true},{"text":"Sənə mədh oxuyurlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yer üzünün qayğısına qalıb su verirsən,","poem":1},{"lineBreak":true},{"text":"Onu çox məhsuldar edirsən.","poem":1},{"lineBreak":true},{"text":"Ey Allah, çayın su ilə doludur,","poem":1},{"lineBreak":true},{"text":"Torpağı taxıl üçün hazır edirsən.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Torpağın şırımlarını sulayırsan,","poem":1},{"lineBreak":true},{"text":"Aralarını bərkidirsən,","poem":1},{"lineBreak":true},{"text":"Gur yağışla torpağını yumşaldırsan,","poem":1},{"lineBreak":true},{"text":"Məhsuluna bərəkət verirsən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaxşılıqlarınla tac qoyursan,","poem":1},{"lineBreak":true},{"text":"Yollarından yağ damır,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çöl otlaqlarına tökülür,","poem":1},{"lineBreak":true},{"text":"Təpələr sevincə bürünür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çəmənlərin sürülərlə dolur,","poem":1},{"lineBreak":true},{"text":"Dərələrini taxıl bürüyür.","poem":1},{"lineBreak":true},{"text":"Onlar cuşa gəlib tərənnüm söyləyir!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}