{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"heading","content":["Məzmur 66"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Bir ilahi."]},{"type":"hebrew_subtitle","content":["Məzmur."]},{"type":"verse","number":1,"content":[{"text":"Ey bütün dünya əhli,","poem":1},{"lineBreak":true},{"text":"Cuşa gəlib Allaha nida edin,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Şərəfli ismini tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Ona şərəflə həmd edin!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siz Allaha belə deyin:","poem":1},{"lineBreak":true},{"text":"«Əməllərin nə qədər zəhmlidir!","poem":1},{"lineBreak":true},{"text":"O qədər qüdrətlisən ki,","poem":1},{"lineBreak":true},{"text":"Düşmənlərin qarşında diz çökür!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bütün dünya Sənə səcdə edir,","poem":1},{"lineBreak":true},{"text":"Səni tərənnüm edir,","poem":1},{"lineBreak":true},{"text":"İsmini tərənnüm edir». Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gəlin, Allahın işlərini,","poem":1},{"lineBreak":true},{"text":"Bəşər övladları üçün etdiyi zəhmli əməllərini görün.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dənizi quruya çevirdi,","poem":1},{"lineBreak":true},{"text":"Çayın sularını saxlayıb xalqını piyada keçirtdi.","poem":1},{"lineBreak":true},{"text":"Biz Allaha görə sevinək!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qüdrəti ilə əbədi səltənət sürər,","poem":1},{"lineBreak":true},{"text":"Günahkarlar Ona qarşı qalxmasın deyə","poem":1},{"lineBreak":true},{"text":"Göz qoyub millətlərə nəzarət edər. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey xalqlar, Allahımıza alqış edin,","poem":1},{"lineBreak":true},{"text":"Ona həmd edin, səsiniz eşidilsin!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Odur canımızı qoruyan,","poem":1},{"lineBreak":true},{"text":"Ayağımızı büdrəməyə qoymayan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ey Allah, bizi sınaqdan keçirtdin,","poem":1},{"lineBreak":true},{"text":"Sən bizi gümüş kimi təmizləyib saflaşdırdın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sən bizi Öz torunla tutdun,","poem":1},{"lineBreak":true},{"text":"Kürəyimizə ağır yük qoydun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sən insanları başımızın üstündən keçirtdin.","poem":1},{"lineBreak":true},{"text":"Oda düşdük, suya düşdük,","poem":1},{"lineBreak":true},{"text":"Axırda bizi Sən bolluğa çıxartdın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sənin evinə yandırma qurbanları ilə gələcəyəm,","poem":1},{"lineBreak":true},{"text":"Sənə əhd etdiyim təqdimləri verəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dar gündə dilim bunları bəyan etdi,","poem":1},{"lineBreak":true},{"text":"Mənim ağzım bu əhdləri söylədi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kökəldilmiş heyvanları","poem":1},{"lineBreak":true},{"text":"Sənin üçün yandırma qurbanı verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Qoçların xoş tüstüsü Sənə sarı qalxacaq,","poem":1},{"lineBreak":true},{"text":"Təkələri, öküzləri qurban gətirəcəyəm. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ey Allahdan qorxanlar, gəlin, dinləyin,","poem":1},{"lineBreak":true},{"text":"Onun mənə nə etdiyini sizə bəyan edim.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ağzımla Onu səslədim,","poem":1},{"lineBreak":true},{"text":"Dilimlə Onu mədh etdim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mən qəlbimdə təqsirə yer versəydim,","poem":1},{"lineBreak":true},{"text":"Xudavənd məni eşitməzdi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakin Allah məni dinlədi,","poem":1},{"lineBreak":true},{"text":"Duamın səsini eşitdi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alqış olsun Allaha! Duamı rədd etmədi,","poem":1},{"lineBreak":true},{"text":"Məndən məhəbbətini əsirgəmədi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}