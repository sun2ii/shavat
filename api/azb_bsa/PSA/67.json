{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Məzmur 67"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün simli alətlərin müşayiəti ilə oxunan məzmur."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Lütf edib, ey Allah, bizə xeyir-dua ver,","poem":1},{"lineBreak":true},{"text":"Üzün üstümüzə nur saçsın. Sela","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy yer üzündə Sənin yolun,","poem":1},{"lineBreak":true},{"text":"Bütün millətlər arasında qurtuluşun tanınsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ey Allah, Sənə xalqlar şükür etsin,","poem":1},{"lineBreak":true},{"text":"Qoy Sənə bütün xalqlar şükür etsin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qoy ümmətlər sevinclə Səni mədh etsin,","poem":1},{"lineBreak":true},{"text":"Çünki xalqlara insafla hökm edirsən,","poem":1},{"lineBreak":true},{"text":"Yer üzündəki ümmətlərə yol göstərirsən. Sela","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Allah, Sənə xalqlar şükür etsin,","poem":1},{"lineBreak":true},{"text":"Qoy Sənə bütün xalqlar şükür etsin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yer üzü bəhrəsini verib,","poem":1},{"lineBreak":true},{"text":"Allah, bizim Allahımız bizə bərəkət verib.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Allah bizə xeyir-dua verib.","poem":1},{"lineBreak":true},{"text":"Qoy yer üzünün qurtaracağınadək hər yerdə olanlar Ondan qorxsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}