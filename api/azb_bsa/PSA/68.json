{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"heading","content":["Məzmur 68"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun məzmuru."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Allah qalxsın, qoy düşmənlər dağılsın,","poem":1},{"lineBreak":true},{"text":"Ona nifrət edənlər qarşısından qaçsın,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pislər çəkilən tüstü kimi dağılsın,","poem":1},{"lineBreak":true},{"text":"Alovun qarşısında mum kimi ərisin.","poem":1},{"lineBreak":true},{"text":"Qoy onlar Allahın qarşısında məhv olsun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Salehlər sevinsin,","poem":1},{"lineBreak":true},{"text":"Allahın hüzurunda fərəhindən coşsun,","poem":1},{"lineBreak":true},{"text":"Sevinib şad olsun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Allaha ilahi oxuyun, ismini tərənnüm edin,","poem":1},{"lineBreak":true},{"text":"Buludlar üstünə minənə yol açın.","poem":1},{"lineBreak":true},{"text":"İsmi Rəbdir, hüzurunda fərəhiniz çağlasın.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Öz müqəddəs məskənində olan Allah","poem":1},{"lineBreak":true},{"text":"Yetimlərin atası,","poem":1},{"lineBreak":true},{"text":"Dul qadınların müdafiəçisidir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Allah kimsəsizlərə ev qurur,","poem":1},{"lineBreak":true},{"text":"Əsirləri firavanlığa çıxarır,","poem":1},{"lineBreak":true},{"text":"Günahkarlar isə quru yurdda yaşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Allah, Sən xalqının önündə gedərkən,","poem":1},{"lineBreak":true},{"text":"Çöllükdə yürüşə çıxarkən Sela","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sina dağındakı Allahın qarşısında,","poem":1},{"lineBreak":true},{"text":"Allahın, İsrailin Allahının hüzurunda","poem":1},{"lineBreak":true},{"text":"Yer lərzəyə gəldi, göydən yağış töküldü.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Allah, yaxşıca yağışlar yağdırdın,","poem":1},{"lineBreak":true},{"text":"Solan torpaqlarını canlandırdın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xalqın orada məskən saldı.","poem":1},{"lineBreak":true},{"text":"Ey Allah, xeyirxahlığına görə","poem":1},{"lineBreak":true},{"text":"Məzlumlar üçün oranı Sən hazırladın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xudavənd əmr edir,","poem":1},{"lineBreak":true},{"text":"Bir alay qadın","poem":1},{"lineBreak":true},{"text":"Belə müjdə paylayır:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«Düşmən orduları qaçır!","poem":1},{"lineBreak":true},{"text":"Padşahları qaçır!","poem":1},{"lineBreak":true},{"text":"Evdə olanlar","poem":1},{"lineBreak":true},{"text":"Talan malını paylayırlar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Siz ağıllar arasında yatanda","poem":1},{"lineBreak":true},{"text":"Qanadları gümüş kimi bərq vuran,","poem":1},{"lineBreak":true},{"text":"Tükləri isə qızıl kimi parlayan,","poem":1},{"lineBreak":true},{"text":"Göyərçinə oxşayırsınız».","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Külli-İxtiyar padşahları elə dağıtdı ki,","poem":1},{"lineBreak":true},{"text":"Elə bil Salmon dağına göydən qar tökülür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ey Başan dağı, Allahın dağı,","poem":1},{"lineBreak":true},{"text":"Ey zirvələri çox olan Başan dağı!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ey zirvələri çox olan dağlar,","poem":1},{"lineBreak":true},{"text":"Allah məskən salmaq üçün seçdiyi dağa","poem":1},{"lineBreak":true},{"text":"Niyə qibtə ilə baxırsınız?","poem":1},{"lineBreak":true},{"text":"Bəli, Rəbb orada əbədi yaşar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Allahın döyüş arabaları var","poem":1},{"lineBreak":true},{"text":"Minlərlə, saysız-hesabsız.","poem":1},{"lineBreak":true},{"text":"Xudavənd onlarla birgə","poem":1},{"lineBreak":true},{"text":"Sinadan müqəddəs məskəninə gəlib.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ya Rəbb Allah, Sən yüksək yerlərə çıxıb məskən saldın,","poem":1},{"lineBreak":true},{"text":"Əsir etdiyin düşmənləri Özünlə oraya apardın,","poem":1},{"lineBreak":true},{"text":"Sən bütün insanlardan,","poem":1},{"lineBreak":true},{"text":"Hətta üsyankarlardan da xərac aldın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xudavəndə,","poem":1},{"lineBreak":true},{"text":"Bizi qurtaran Allaha –","poem":1},{"lineBreak":true},{"text":"Hər gün qayğı yükümüzü çəkənə alqış olsun! Sela","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Allahımız azad edən Allahdır,","poem":1},{"lineBreak":true},{"text":"Ölümdən qurtaran Xudavənd Rəbdir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Allah düşmənlərin kəlləsini,","poem":1},{"lineBreak":true},{"text":"Günah içində yaşayanların tüklü təpəsini əzəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Xudavənd belə dedi:","poem":1},{"lineBreak":true},{"text":"«Onları Başandan geri qaytaracağam,","poem":1},{"lineBreak":true},{"text":"Dənizin dibində olsalar belə,","poem":1},{"lineBreak":true},{"text":"Oradan geri qaytaracağam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Qoy ayaqların düşmənlərin qanına batsın,","poem":1},{"lineBreak":true},{"text":"Bundan itlərinin dilləri də pay alıb yalasın».","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ey Allah, indi burada o zəfər yürüşün,","poem":1},{"lineBreak":true},{"text":"Ey Allahım, Padşahım, müqəddəs yerə gəlişin görünür,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Öndə ilahi oxuyanlar,","poem":1},{"lineBreak":true},{"text":"Arxalarından isə çalğıçılar,","poem":1},{"lineBreak":true},{"text":"Aralarında dəfçalan qızlar gəlir.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ey İsrailin belindən gələnlər, cəmiyyət içində","poem":1},{"lineBreak":true},{"text":"Allahınız Rəbbə alqış edin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Qabaqda kiçik Binyamin qəbiləsi gedir,","poem":1},{"lineBreak":true},{"text":"Ardınca çoxlu Yəhuda başçıları,","poem":1},{"lineBreak":true},{"text":"Ondan sonra Zevulunun, Naftalinin başçıları gəlir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ey Allah, qüdrətini,","poem":1},{"lineBreak":true},{"text":"Bizim üçün işlətdiyin qüvvətini göstər.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yerusəlimdəki məbədinə görə","poem":1},{"lineBreak":true},{"text":"Sənə padşahlar xərac gətirir.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Qamışlıqda yaşayan heyvanları,","poem":1},{"lineBreak":true},{"text":"Xalqların danaları ilə buğa sürüsünü tənbeh et.","poem":1},{"lineBreak":true},{"text":"Bu gümüşpərəstləri təpiyinin altına sal,","poem":1},{"lineBreak":true},{"text":"Davakar xalqları pərən-pərən et.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Misirdən Allahın hüzuruna elçilər gələcək,","poem":1},{"lineBreak":true},{"text":"Kuşlular da Ona əl açacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ey dünya ölkələri,","poem":1},{"lineBreak":true},{"text":"Allaha ilahi söyləyin.","poem":1},{"lineBreak":true},{"text":"Xudavəndi tərənnüm edin, Sela","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Göylərin, ulu göylərin üstünə minəni,","poem":1},{"lineBreak":true},{"text":"Güclü səslə gurlayanı dinləyin,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Allahın qüdrətini bəyan edin,","poem":1},{"lineBreak":true},{"text":"Əzəməti İsrail üzərindədir,","poem":1},{"lineBreak":true},{"text":"Onun qüdrəti göylərdədir!","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Müqəddəs məkanında olan ey Allah, zəhmlisən!","poem":1},{"lineBreak":true},{"text":"İsrailin Allahı Öz xalqına qüdrət, qüvvət verir.","poem":1},{"lineBreak":true},{"text":"Allaha alqış olsun!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}