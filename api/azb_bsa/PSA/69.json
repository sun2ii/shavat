{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["Məzmur 69"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Şoşannim» üstə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ay Allah, məni qurtar,","poem":1},{"lineBreak":true},{"text":"Su çıxıb boğazımacan,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dərin bataqlığa batmaqdayam,","poem":1},{"lineBreak":true},{"text":"Ayaq üstə durmağa yer yoxdur.","poem":1},{"lineBreak":true},{"text":"Dərin sulara qərq olmuşam,","poem":1},{"lineBreak":true},{"text":"Sellər məni aparır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fəryad etməkdən taqətim kəsildi,","poem":1},{"lineBreak":true},{"text":"Allahı gözləməkdən","poem":1},{"lineBreak":true},{"text":"Boğazım qurudu, gözümün nuru söndü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Boş yerə mənə nifrət edənlər","poem":1},{"lineBreak":true},{"text":"Başımın tükündən çoxdur.","poem":1},{"lineBreak":true},{"text":"Haqsız yerə mənə düşmən kəsilənlər,","poem":1},{"lineBreak":true},{"text":"Məni məhv etmək istəyənlər qüvvətlidir.","poem":1},{"lineBreak":true},{"text":"Oğurlamadığım şeyləri necə qaytara bilərəm?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Allah, ağılsızlıq etdiyimi bilirsən,","poem":1},{"lineBreak":true},{"text":"Günahlarım Səndən gizli deyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ey Ordular Rəbbi Xudavənd, Səni gözləyənlər","poem":1},{"lineBreak":true},{"text":"Mənə görə qoy utanmasınlar.","poem":1},{"lineBreak":true},{"text":"Ey İsrailin Allahı, Səni axtaranlar","poem":1},{"lineBreak":true},{"text":"Mənə görə qoy xəcalət içində qalmasınlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin uğrunda üzərimə rüsvayçılıq töküldü,","poem":1},{"lineBreak":true},{"text":"Üzümü xəcalət bürüdü.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qardaşlarıma yad oldum,","poem":1},{"lineBreak":true},{"text":"Anamın oğullarına özgə sayıldım.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Evinin qeyrəti məni yandırıb-yaxdı,","poem":1},{"lineBreak":true},{"text":"Səni təhqir edənlərin rüsvayçılıq təhqirləri altında qaldım.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Oruc tutub ağlamağımı belə,","poem":1},{"lineBreak":true},{"text":"Mənə rüsvayçılıq saydılar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mən çula bürünəndə","poem":1},{"lineBreak":true},{"text":"Onlara söz oldum.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Darvazadakı adamlar məndən qeybət edirlər,","poem":1},{"lineBreak":true},{"text":"Sərxoşların dilinin nəğməsinə çevrildim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mənsə, ya Rəbb, Sənə dua edirəm.","poem":1},{"lineBreak":true},{"text":"Ey Allah, münasib gördüyün zaman","poem":1},{"lineBreak":true},{"text":"Bol məhəbbətinə görə mənə cavab ver,","poem":1},{"lineBreak":true},{"text":"Çünki qurtuluşuna etibar etmişəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Məni qurtar, bataqlığa batmayım,","poem":1},{"lineBreak":true},{"text":"Qoy düşmənlərimdən,","poem":1},{"lineBreak":true},{"text":"Dərin sulardan xilas olum.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qoy sellər məni aparmasın,","poem":1},{"lineBreak":true},{"text":"Dərinlik məni udmasın,","poem":1},{"lineBreak":true},{"text":"Quyu üstümdə ağzını yummasın.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ya Rəbb, mənə cavab ver,","poem":1},{"lineBreak":true},{"text":"Çünki məhəbbətin yaxşıdır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Üzünü bu bəndəndən gizlətmə,","poem":1},{"lineBreak":true},{"text":"Tez cavab ver, çünki əzab çəkirəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yetiş, canımı azad et,","poem":1},{"lineBreak":true},{"text":"Məni düşmənlərimdən xilas et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Başıma gələn rüsvayçılığı,","poem":1},{"lineBreak":true},{"text":"Biabırçılığı, xəcaləti bilirsən,","poem":1},{"lineBreak":true},{"text":"Bütün yağılarım qarşındadır.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rüsvayçılıq qəlbimi qırdı,","poem":1},{"lineBreak":true},{"text":"Gör necə biçarəyəm.","poem":1},{"lineBreak":true},{"text":"Çox axtardım, halıma yanan tapılmadı,","poem":1},{"lineBreak":true},{"text":"Hey axtardım, təsəlli verən olmadı.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mənə yemək əvəzinə öd verdilər,","poem":1},{"lineBreak":true},{"text":"Susayanda sirkə içirtdilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Süfrələri onlar üçün tələ olsun,","poem":1},{"lineBreak":true},{"text":"Müttəfiqləri üçün tor olsun.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gözlərinə qara gəlsin, görməsinlər,","poem":1},{"lineBreak":true},{"text":"Belləri onları lərzəyə salsın.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qoy qəzəbin onların üzərinə yağsın,","poem":1},{"lineBreak":true},{"text":"Qoy hiddətinin qızğınlığı onları tutsun.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Düşərgələri viran olsun,","poem":1},{"lineBreak":true},{"text":"Çadırları boş qalsın.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Çünki Sənin vurduğun insanı təqib edirlər,","poem":1},{"lineBreak":true},{"text":"Yaraladıqlarının dərdini ona qaxınc edirlər.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bu təqsirkarları daha da təqsirkar çıxar,","poem":1},{"lineBreak":true},{"text":"Səndən bəraət almasınlar.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Qoy adları həyat kitabından silinsin,","poem":1},{"lineBreak":true},{"text":"Salehlərlə yanaşı yazılmasın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mən məzlumam, dərdliyəm,","poem":1},{"lineBreak":true},{"text":"Ey Allah, Sənin qurtuluşun məni ucaltsın.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Allahın isminə ilahilərlə həmd oxuyacağam,","poem":1},{"lineBreak":true},{"text":"Onu şükürlərlə ucaldacağam.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mal-qara qurbanından çox","poem":1},{"lineBreak":true},{"text":"Bu, Rəbbin xoşuna gələcək,","poem":1},{"lineBreak":true},{"text":"Buynuzlu, dırnaqlı buğadan çox","poem":1},{"lineBreak":true},{"text":"Bu Ona xoş gələcək.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bunu görən məzlumlar qoy sevinsin,","poem":1},{"lineBreak":true},{"text":"Ey Allahı axtaranlar, ürəyiniz dirçəlsin.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Çünki Rəbb fəqirləri eşidir,","poem":1},{"lineBreak":true},{"text":"Öz əsir xalqına xor baxmır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Göy, yer, dənizlər, oradakı canlılar","poem":1},{"lineBreak":true},{"text":"Qoy Rəbbə həmd oxusunlar.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Çünki Allah Sionu qurtaracaq,","poem":1},{"lineBreak":true},{"text":"O, Yəhuda şəhərlərini bərpa edəcək.","poem":1},{"lineBreak":true},{"text":"Onun xalqı oranı mülk edib məskən salacaq,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ora qullarının övladlarına irs olaraq qalacaq,","poem":1},{"lineBreak":true},{"text":"Allahın ismini sevənlər orada sakin olacaq!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}