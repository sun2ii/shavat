{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"heading","content":["Məzmur 7"]},{"type":"hebrew_subtitle","content":["Davudun Binyaminli Kuşa görə Allaha oxuduğu şiqqayon."]},{"type":"verse","number":1,"content":[{"text":"Ey Rəbb Allahım, Sənə sığınmışam,","poem":1},{"lineBreak":true},{"text":"Məni bütün təqibçilərimdən qurtar,","poem":1},{"lineBreak":true},{"text":"Məni xilas et.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yoxsa aslan kimi məni parçalayarlar,","poem":1},{"lineBreak":true},{"text":"Xilas edən olmasa, məni didib-dağıdarlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ya Rəbb Allahım, əgər günah etmişəmsə,","poem":1},{"lineBreak":true},{"text":"Əllərimdən haqsızlıq gəlibsə,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Əgər dostuma xəyanət etmişəmsə,","poem":1},{"lineBreak":true},{"text":"Düşmənimi nahaqdan qarət etmişəmsə,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qoy məni düşmən qovub tutsun,","poem":1},{"lineBreak":true},{"text":"Bədənimi təpik altına salsın,","poem":1},{"lineBreak":true},{"text":"Şərəfimi yerə vursun. Sela","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qəzəblə qalx, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Düşmənlərimin hiddətinə qarşı çıxıb yüksəl!","poem":1},{"lineBreak":true},{"text":"Mənə görə oyan,","poem":1},{"lineBreak":true},{"text":"Hökmünü bəyan et!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ümmətlər icması Sənin ətrafına yığılsın,","poem":1},{"lineBreak":true},{"text":"Sən onların başı üzərində ucal, hökmünü ver.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb xalqlar üzərində hakimlik edir;","poem":1},{"lineBreak":true},{"text":"Məni mühakimə et, ya Rəbb,","poem":1},{"lineBreak":true},{"text":"Salehliyimə, kamilliyimə görə mənə haqq qazandır!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pislərin pisliyi sona yetsin,","poem":1},{"lineBreak":true},{"text":"Salehlərsə möhkəmlənsin!","poem":1},{"lineBreak":true},{"text":"Ey adil Allah, çünki Sən düşüncələri, hissləri bilirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Allah mənim sipərimdir,","poem":1},{"lineBreak":true},{"text":"Ürəyidüz olanları xilas edir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allah adil hakimdir,","poem":1},{"lineBreak":true},{"text":"Hər gün haqsızlığa görə hökm verir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pislər yolundan dönməzsə,","poem":1},{"lineBreak":true},{"text":"O, qılıncını itilər,","poem":1},{"lineBreak":true},{"text":"Ox-kamanını qurar,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onlara qarşı ölüm silahları hazırlayar,","poem":1},{"lineBreak":true},{"text":"Yandırıcı oxları ilə nişan alar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pislər hiyləyə hamilə olar,","poem":1},{"lineBreak":true},{"text":"Şər üçün ağrı çəkər, yalan doğar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onlar başqasına quyu qazar, dərinləşdirər,","poem":1},{"lineBreak":true},{"text":"Qazdıqları quyuya özləri düşər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yamanlıqları öz üstlərinə dönər,","poem":1},{"lineBreak":true},{"text":"Zorakılıqları başlarına düşər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Rəbbə ədalətinə görə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Haqq-Taala Rəbbin ismini tərənnüm edəcəyəm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}