{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"heading","content":["Məzmur 71"]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, Sənə pənah gətirirəm,","poem":1},{"lineBreak":true},{"text":"Heç vaxt məni xəcalətdə qoyma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Məni ədalətinlə qurtar, xilas et,","poem":1},{"lineBreak":true},{"text":"Qulağını mənə sarı döndər, məni azad et.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mənə sığınacaq qaya ol,","poem":1},{"lineBreak":true},{"text":"Qoy əmrinlə hər vaxt ora girib qurtulum.","poem":1},{"lineBreak":true},{"text":"Çünki qayam da Sən, qalam da Sənsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey Allahım, şər insanın əlindən,","poem":1},{"lineBreak":true},{"text":"Haqsızın, zalımın pəncəsindən məni qurtar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, Sən mənim ümidimsən,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, gəncliyimdən bəri Sənə güvənmişəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Doğulduğum gündən bəri dayağımsan,","poem":1},{"lineBreak":true},{"text":"Məni ana bətnindən dünyaya gətirmisən,","poem":1},{"lineBreak":true},{"text":"Həmişə Sənə həmd edirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Çoxlarına qəribə bir şey oldum,","poem":1},{"lineBreak":true},{"text":"Amma Sən mənim möhkəm sığınacağım oldun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sənə həmd etmək dilimdən düşməz,","poem":1},{"lineBreak":true},{"text":"Daim Sənin izzətini düşünürəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaşa dolanda da məni rədd etmə,","poem":1},{"lineBreak":true},{"text":"Taqətdən düşəndə də məni tərk etmə.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mənim barəmdə düşmənlərim belə söyləyir,","poem":1},{"lineBreak":true},{"text":"Məni öldürmək istəyənlər belə məsləhətləşir,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Deyirlər ki, Allah onu tərk edib,","poem":1},{"lineBreak":true},{"text":"Gəlin onu təqib edərək tutaq,","poem":1},{"lineBreak":true},{"text":"Çünki onu xilas edən yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey Allah, məndən uzaq durma,","poem":1},{"lineBreak":true},{"text":"Ey Allahım, dadıma tez çat!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qoy məni ittiham edənlər utanıb məhv olsun,","poem":1},{"lineBreak":true},{"text":"Bədxahlarımı xəcalət, rüsvayçılıq bürüsün.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mənsə hər zaman Sənə ümid bağlayacağam,","poem":1},{"lineBreak":true},{"text":"Sənə həmd oxuduqca oxuyacağam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gün boyu salehliyini, qurtuluşunu dilim bəyan edir,","poem":1},{"lineBreak":true},{"text":"Onun ölçüsünü bilməsəm də.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ey Xudavənd Rəbb, qüdrətinlə dolanıb-gəzəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sənin, yalnız Sənin salehliyini bəyan edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ey Allah, gəncliyimdən bəri mənə təlim vermisən,","poem":1},{"lineBreak":true},{"text":"Sənin xariqələrini indiyədək elan edirəm.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaşa dolub saçıma dən düşənə qədər","poem":1},{"lineBreak":true},{"text":"Gələcək nəslə qüvvətini,","poem":1},{"lineBreak":true},{"text":"Gələcək nəslin hər birinə qüdrətini","poem":1},{"lineBreak":true},{"text":"Elan edəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ey Allah, məni tərk etmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ey Allah, salehliyin göylər qədər ucadır,","poem":1},{"lineBreak":true},{"text":"Böyük işlər görmüsən!","poem":1},{"lineBreak":true},{"text":"Ey Allah, Sənin kimisi varmı?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sən mənə çoxlu ağır əzablar versən də,","poem":1},{"lineBreak":true},{"text":"Yenə məni dirçəldirsən,","poem":1},{"lineBreak":true},{"text":"Yerin dibindən yenə məni çıxarırsan,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hörmətimi artırmaqla","poem":1},{"lineBreak":true},{"text":"Mənə yenə əmniyyət verirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ey Allahım, sədaqətinə görə","poem":1},{"lineBreak":true},{"text":"Çəng çalıb Sənə şükür edəcəyəm!","poem":1},{"lineBreak":true},{"text":"Ey İsrailin Müqəddəsi,","poem":1},{"lineBreak":true},{"text":"Səni lira ilə tərənnüm edəcəyəm!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dilim, azadlıq verdiyin qəlbim","poem":1},{"lineBreak":true},{"text":"Mədh oxuyub Səni tərənnüm edəcək,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dilim daim salehliyindən söyləyəcək,","poem":1},{"lineBreak":true},{"text":"Çünki bədxahlarımın xəcalətdən üzləri qızarıb.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}