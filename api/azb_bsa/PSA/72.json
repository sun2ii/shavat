{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["Məzmur 72"]},{"type":"hebrew_subtitle","content":["Süleymanın məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, padşaha ədalət ver,","poem":1},{"lineBreak":true},{"text":"Şah oğluna salehlik ver.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy Sənin xalqına salehliklə,","poem":1},{"lineBreak":true},{"text":"Məzlumlara ədalətlə hakimlik etsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xalqın firavanlığı dağlardan aşsın,","poem":1},{"lineBreak":true},{"text":"Salehlər təpələri dolaşsın.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Padşah xalq arasında olan məzlumları qorusun,","poem":1},{"lineBreak":true},{"text":"Fəqirləri xilas etsin,","poem":1},{"lineBreak":true},{"text":"Zalımları əzsin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nə qədər günəş və ay varsa,","poem":1},{"lineBreak":true},{"text":"Hər gələn nəsil qoy Səndən qorxsun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Biçilən tarlaya yağış kimi,","poem":1},{"lineBreak":true},{"text":"Torpağı suvaran gur yağış kimi tökülsün.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu padşahın ömrü boyu qoy salehlər çiçək açsın,","poem":1},{"lineBreak":true},{"text":"Göydə ay durduqca qoy firavanlıq artsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dənizdən-dənizə qədər,","poem":1},{"lineBreak":true},{"text":"Fəratdan yer üzünün qurtaracağınadək hər yerdə hökmranlıq etsin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onun qarşısında köçəri xalqlar diz çöksün,","poem":1},{"lineBreak":true},{"text":"Düşmənləri isə qoy yerə vurulsun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tarşişin və adaların padşahları ona xərac gətirsin,","poem":1},{"lineBreak":true},{"text":"Səba və Seva padşahları ona bəxşiş versin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qarşısında bütün padşahlar təzim etsin,","poem":1},{"lineBreak":true},{"text":"Qoy bütün millətlər ona xidmət etsin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Çünki o imdad deyib çağıran fəqirləri,","poem":1},{"lineBreak":true},{"text":"Məzlumları, köməksizləri qurtarır.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yoxsula, fəqirə rəhm edir,","poem":1},{"lineBreak":true},{"text":"Fəqirlərin canlarını azad edir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onları hədə-qorxudan, zorakılıqdan qurtarır,","poem":1},{"lineBreak":true},{"text":"Onun gözündə bunların qanı qiymətlidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yaşasın padşah!","poem":1},{"lineBreak":true},{"text":"Qoy ona Səba qızılı verilsin,","poem":1},{"lineBreak":true},{"text":"Qoy onun üçün durmadan dua edilsin,","poem":1},{"lineBreak":true},{"text":"Hər gün ona xeyir-dua verilsin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qoy ölkənin zəmiləri bol olsun,","poem":1},{"lineBreak":true},{"text":"Dağların başında dalğalansın.","poem":1},{"lineBreak":true},{"text":"Bu ölkə Livan kimi məhsul versin,","poem":1},{"lineBreak":true},{"text":"Qoy şəhərin əhalisi ot kimi bitsin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qoy padşahın adı əbədi qalsın,","poem":1},{"lineBreak":true},{"text":"Günəşin ömrü tək adı var olsun.","poem":1},{"lineBreak":true},{"text":"Onun vasitəsilə insanlar xeyir-dua alsın,","poem":1},{"lineBreak":true},{"text":"Onu bütün millətlər bəxtiyar adlandırsın!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Alqış olsun Rəbb Allaha, İsrailin Allahına,","poem":1},{"lineBreak":true},{"text":"Xariqələrin yeganə yaradanına!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onun şərəfli adına əbədi alqış olsun,","poem":1},{"lineBreak":true},{"text":"Bütün yer üzü Onun izzətinə bürünsün!","poem":1},"Amin! Amin!"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yessey oğlu Davudun duaları burada sona çatır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}