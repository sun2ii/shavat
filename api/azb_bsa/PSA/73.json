{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"heading","content":["Məzmur 73"]},{"type":"hebrew_subtitle","content":["Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Doğrudan da, İsrail üçün,","poem":1},{"lineBreak":true},{"text":"Ürəyitəmiz olanlar üçün","poem":1},{"lineBreak":true},{"text":"Allah xeyirxahdır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amma mənim ayaqlarım az qala büdrəmişdi,","poem":1},{"lineBreak":true},{"text":"Addımlarım məni yıxmışdı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pislərin firavanlığını görərkən","poem":1},{"lineBreak":true},{"text":"Bu məğrurlara həsəd aparırdım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ölənədək onların ağrıları yoxdur,","poem":1},{"lineBreak":true},{"text":"Vücudları ətə-cana gəlib.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlar başqaları kimi dərdə düşməzlər,","poem":1},{"lineBreak":true},{"text":"Əzab çəkməzlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Çünki təkəbbür onlar üçün boyunbağı kimidir,","poem":1},{"lineBreak":true},{"text":"Zorakılıq libas kimi əyinlərini örtür.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Köklükdən gözləri dombalıb çıxır,","poem":1},{"lineBreak":true},{"text":"Qəlblərinin pis məqsədləri aşıb-daşır.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pis niyyətli sözləri ilə insanlara istehza edirlər,","poem":1},{"lineBreak":true},{"text":"Onlara yuxarıdan baxıb hədə-qorxu gəlirlər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ağızlarını göylərin əleyhinə açırlar,","poem":1},{"lineBreak":true},{"text":"Dillərinin sözləri dünyanı gəzib-dolaşır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ona görə bütün xalq onların tərəfinə keçir,","poem":1},{"lineBreak":true},{"text":"Sözlərini axıradək su kimi içir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Deyirlər ki, Allah necə xəbər tutacaq?","poem":1},{"lineBreak":true},{"text":"Haqq-Taala bundan necə xəbərdar olacaq?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Belədir pis adamlar,","poem":1},{"lineBreak":true},{"text":"Daim arxayındırlar, var-dövlət artırırlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Məgər mən boş yerə qəlbimi təmizləmişdim,","poem":1},{"lineBreak":true},{"text":"Günahsızlıq içində əllərimi yumuşdum?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Həmişə əziyyətə düşürəm,","poem":1},{"lineBreak":true},{"text":"Hər səhər töhmətə rast gəlirəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Əgər «qoy mən də belə danışım» deyə düşünsəydim,","poem":1},{"lineBreak":true},{"text":"Sənin övladlarına xəyanət edərdim.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bunu anlamaq üçün düşünəndə","poem":1},{"lineBreak":true},{"text":"Çətin bir iş kimi gözümə durdu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yalnız Allahın Müqəddəs məkanına girərkən","poem":1},{"lineBreak":true},{"text":"Onların aqibətini dərk etdim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Doğrudan da, onları sürüşkən yerə qoymusan,","poem":1},{"lineBreak":true},{"text":"Onları məhvə yuvarlayırsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Onlar bir anda yox olacaqlar,","poem":1},{"lineBreak":true},{"text":"Dəhşət içində itib-batacaqlar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yuxudan ayılanda röyalar unudular,","poem":1},{"lineBreak":true},{"text":"Ey Xudavənd, Sənin oyanışınla bu adamlar boş sayılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"O vaxt könlüm zəhərlənmişdi,","poem":1},{"lineBreak":true},{"text":"Qəlbim dəlik-deşik olmuşdu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Necə axmaq idim, dərrakəm yox idi,","poem":1},{"lineBreak":true},{"text":"Qarşında sanki bir heyvan idim.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Amma daim Səninlə olmuşam,","poem":1},{"lineBreak":true},{"text":"Mənim sağ əlimdən tutmusan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nəsihətinlə mənə yol göstərirsən,","poem":1},{"lineBreak":true},{"text":"Sonra məni şərəfə çatdıracaqsan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Göylərdə Səndən başqa kimim var?","poem":1},{"lineBreak":true},{"text":"Yer üzündə də Səndən başqa heç nə istəmirəm.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Cismim və ürəyim taqətdən düşsə belə,","poem":1},{"lineBreak":true},{"text":"Daim, ey Allah, qəlbimin qüvvəti, nəsibimsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Budur, Səndən uzaq düşənlər məhv olurlar,","poem":1},{"lineBreak":true},{"text":"Sənə xəyanət edənləri yox edirsən.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mənim üçün Allaha yaxınlaşmaq yaxşıdır,","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbbə pənah gətirmişəm,","poem":1},{"lineBreak":true},{"text":"Ona görə bütün işlərini hamıya çatdıracağam!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}