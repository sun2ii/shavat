{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"heading","content":["Məzmur 74"]},{"type":"hebrew_subtitle","content":["Asəfin maskili."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, niyə bizi əbədilik tərk etmisən?","poem":1},{"lineBreak":true},{"text":"Otlağının sürüsünə niyə qəzəbin alovlanıb?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yada sal keçmişdə satın aldığın icmanı,","poem":1},{"lineBreak":true},{"text":"Özünə xalq etmək üçün azad etdiyin tayfanı,","poem":1},{"lineBreak":true},{"text":"Həm də məskənin olan Sion dağını.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Əbədi viranələrə doğru get,","poem":1},{"lineBreak":true},{"text":"Müqəddəs yerdə hər şeyi düşmən dağıdıb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Səcdəgahının ortasında düşmənlər nərə çəkdilər,","poem":1},{"lineBreak":true},{"text":"Bu yerə zəfər bayraqlarını keçirtdilər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sıx meşəni budamaq üçün","poem":1},{"lineBreak":true},{"text":"Balta qaldıran adamlara bənzəyirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Müqəddəs yerin bütün oyma işlərini","poem":1},{"lineBreak":true},{"text":"Baltalar və çəkiclərlə qırıb tökdülər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sənin Müqəddəs məkanına od vurdular,","poem":1},{"lineBreak":true},{"text":"Adının sakin olduğu yeri uçurub murdarladılar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Bu xalqı biz birgə əzməliyik» deyə düşünərək","poem":1},{"lineBreak":true},{"text":"Ölkədəki bütün səcdəgahları yandırdılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Heç bir rəmzimiz görünmür,","poem":1},{"lineBreak":true},{"text":"Daha peyğəmbərimiz yoxdur.","poem":1},{"lineBreak":true},{"text":"Kimsə bilmir, biz nə vaxtadək belə qalacağıq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ey Allah, nə vaxtadək düşmən Səni söyəcək?","poem":1},{"lineBreak":true},{"text":"Yağı əbədilikmi Sənin adına küfr edəcək?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Axı nə üçün əlini geri çəkirsən?","poem":1},{"lineBreak":true},{"text":"Çıxart qoynundan sağ əlini, onları məhv et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ey Allah, əzəldən Padşahımsan,","poem":1},{"lineBreak":true},{"text":"Yer üzünə qurtuluşlar verirsən.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sən dənizi Öz qüdrətinlə böldün,","poem":1},{"lineBreak":true},{"text":"Dəniz əjdahalarının başlarını əzdin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sən Livyatanın","poem":1},{"noteId":4},{"text":"başlarını əzdin,","poem":1},{"lineBreak":true},{"text":"Onu çöl heyvanlarına yem etdin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sən bulaqlar açıb sellər axıtdın,","poem":1},{"lineBreak":true},{"text":"Həmişəaxar çayları isə qurutdun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gündüz də Sənindir, gecə də Sənin,","poem":1},{"lineBreak":true},{"text":"Ayı və günəşi Sən yaratmısan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sən quru yerin bütün sərhədlərini qoydun,","poem":1},{"lineBreak":true},{"text":"Həm yayı, həm qışı yaratdın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ya Rəbb, unutma, düşmən Səni söyür,","poem":1},{"lineBreak":true},{"text":"Sənin adına axmaq bir xalq küfr edir.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Öz qumrunun canını yırtıcılara vermə,","poem":1},{"lineBreak":true},{"text":"Məzlumlarının həyatını əsla unutma.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Özün bizimlə bağladığın əhdə bax!","poem":1},{"lineBreak":true},{"text":"Zorakılıq yuvaları ölkənin hər zülmət yerinə dolub.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Qoyma əzabkeş yenə də rüsvay olsun,","poem":1},{"lineBreak":true},{"text":"Qoy sənin adına məzlumlar və fəqirlər həmd oxusun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Qalx, ey Allah, mübarizəni apar,","poem":1},{"lineBreak":true},{"text":"Unutma ki, axmaqlar həmişə Səni söyür.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Düşmənlərinin səsini,","poem":1},{"lineBreak":true},{"text":"Əleyhdarlarının daim yüksələn vəlvələsini unutma.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Livyatan – bu gün bizə məlum olmayan nəhəng su heyvanı.","reference":{"chapter":74,"verse":14}}]},"thisChapterLink":"/api/azb_bsa/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}