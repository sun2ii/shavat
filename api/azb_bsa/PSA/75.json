{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["Məzmur 75"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün Asəfin «Al-taşxet» üstə oxunan məzmuru."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, biz Sənə şükür edirik,","poem":1},{"lineBreak":true},{"text":"Bizə doğma olan isminə şükür olsun,","poem":1},{"lineBreak":true},{"text":"Xariqələrin bunu bəyan edir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Allah deyir: «Müəyyən etdiyim zaman","poem":1},{"lineBreak":true},{"text":"Mən insafla hakimlik edəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yer və üzərindəkilər lərzəyə gələrkən","poem":1},{"lineBreak":true},{"text":"Onu saxlayıb sütunlarından tutan Mənəm. Sela","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Məğrurlara dedim: “Daha məğrurluq etməyin”,","poem":1},{"lineBreak":true},{"text":"Pislərə dedim: “Gücünüzü göstərməyin,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buynuz çıxartmayın,","poem":1},{"lineBreak":true},{"text":"Dikbaş-dikbaş danışmayın”».","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"İnsanı yüksəltmək","poem":1},{"lineBreak":true},{"text":"Nə şərqdən, nə qərbdən, nə də çöllərdən gəlir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hökm verən Allah isə","poem":1},{"lineBreak":true},{"text":"Həm alçaldır, həm yüksəldir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb əlində bir cam tutub,","poem":1},{"lineBreak":true},{"text":"Onu ədviyyatlı, köpüklənən şərabla doldurub.","poem":1},{"lineBreak":true},{"text":"Şərabından töküb dünyanın bütün pislərinə paylayacaq,","poem":1},{"lineBreak":true},{"text":"Onlar da şərabı dibinə qədər içib-qurtaracaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mənsə daim bunu elan edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahına tərənnüm oxuyacağam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pis adamların buynuzları qırılacaq,","poem":1},{"lineBreak":true},{"text":"Amma salehlərin qüvvəti artacaq.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}