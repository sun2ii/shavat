{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Məzmur 76"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Asəfin simli alətlərin müşayiəti ilə oxunan məzmuru."]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Allah Yəhudada şöhrətlidir,","poem":1},{"lineBreak":true},{"text":"İsraildə Onun adı böyükdür.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Çardağı Salemdədir,","poem":1},{"lineBreak":true},{"text":"Məskəni Siondadır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allah orada alovlu oxları,","poem":1},{"lineBreak":true},{"text":"Qalxan-qılıncı və bütün silahları qırdı. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey Allah, şərəfli Sənsən,","poem":1},{"lineBreak":true},{"text":"Ulu dağlardan da əzəmətlisən!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cəsur ürəklilər talan oldu,","poem":1},{"lineBreak":true},{"text":"Ölüm yuxusuna daldı,","poem":1},{"lineBreak":true},{"text":"Bütün cəngavərlərin əlləri sustaldı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ey Yaqubun Allahı, Sənin məzəmmətindən","poem":1},{"lineBreak":true},{"text":"Arabaçılar və atlar uyumuş qaldı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sən zəhmlisən, Sən!","poem":1},{"lineBreak":true},{"text":"Qəzəblənəndə qarşında kim dura bilər?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Öz hökmünü göylərdən elan etdin,","poem":1},{"lineBreak":true},{"text":"Yer vahimələndi və səsini kəsdi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onda, ey Allah, hökm çıxarmaq üçün,","poem":1},{"lineBreak":true},{"text":"Dünyadakı məzlumların hamısını qurtarmaq üçün qalxdın. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Qəzəbli insanlar belə, Sənə şükür edir,","poem":1},{"lineBreak":true},{"text":"Qəzəbdən qurtulanları Özünə bağlayırsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Allahınız Rəbbə əhd edin və yerinə yetirin,","poem":1},{"lineBreak":true},{"text":"Ey bütün ətraf xalqlar, o Zəhmli Olana xərac gətirin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O, hökmdarların nəfəsini kəsər,","poem":1},{"lineBreak":true},{"text":"Dünya padşahlarını vahimələndirər.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}