{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["Məzmur 77"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri Yedutun üçün. Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Allahı səsləyirəm, fəryad edirəm,","poem":1},{"lineBreak":true},{"text":"Allahı səsləyirəm, O məni dinlər.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dar günümdə Xudavəndi axtarıram,","poem":1},{"lineBreak":true},{"text":"Bütün gecə durmadan,","poem":1},{"lineBreak":true},{"text":"Könlüm ovunmadan Ona əl açmışam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allahı yada salarkən təlaşa düşürəm,","poem":1},{"lineBreak":true},{"text":"Dərindən fikirləşəndə ruhdan düşürəm. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Qoymursan gözlərimi yumum,","poem":1},{"lineBreak":true},{"text":"Üzgünlükdən danışa bilmirəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Düşünürəm keçən günləri,","poem":1},{"lineBreak":true},{"text":"Ötən dövranı, illəri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oxuduğum ilahi gecələr yadıma düşür,","poem":1},{"lineBreak":true},{"text":"Ürəyimdə düşünəndə könlüm məndən soruşur:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Xudavənd məni əbədilikmi tərk edib?","poem":1},{"lineBreak":true},{"text":"Bir daha məndən razı qalmayacaqmı?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Məhəbbəti həmişəlik qurtardımı?","poem":1},{"lineBreak":true},{"text":"Vədi nəsildən-nəslə qədər sona çatdımı?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Allah rəhm etməyi unudubmu,","poem":1},{"lineBreak":true},{"text":"Mərhəmətinin yerini qəzəb tutdumu?» Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dedim: «Bu mənim üçün bəladır,","poem":1},{"lineBreak":true},{"text":"Haqq-Taala daha gücünü göstərmir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, Sənin əməllərini yada salıram,","poem":1},{"lineBreak":true},{"text":"Bəli, xatırlayıram, ta qədimdən xariqələr göstərmisən.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sənin bütün işlərini dərindən düşünürəm,","poem":1},{"lineBreak":true},{"text":"Əməllərin barədə xəyala dalıram.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Allahın yolu müqəddəsdir.","poem":1},{"lineBreak":true},{"text":"Allah kimi böyük hansı allah var?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xariqələr yaradan Allah Sənsən,","poem":1},{"lineBreak":true},{"text":"Xalqlar arasında qüdrətini göstərmisən.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Əl uzadıb xalqını,","poem":1},{"lineBreak":true},{"text":"Yaqub, Yusif övladlarını azad etmisən. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ey Allah, sular Səni gördü,","poem":1},{"lineBreak":true},{"text":"Səni görən sular qorxdu,","poem":1},{"lineBreak":true},{"text":"Hətta ümmanlar lərzəyə gəldi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Buludlar yağışa döndü,","poem":1},{"lineBreak":true},{"text":"Göylərdən gurultular eşidildi,","poem":1},{"lineBreak":true},{"text":"Hər tərəfə oxların töküldü.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qasırğanın içindən ildırım çaxdı,","poem":1},{"lineBreak":true},{"text":"Şimşəklər yer üzünə işıq saçdı,","poem":1},{"lineBreak":true},{"text":"Yer lərzəyə gəlib sarsıldı.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sən dənizdə, ümman sularda yol açdın,","poem":1},{"lineBreak":true},{"text":"Amma ayaq izlərin məlum olmadı.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sən Musa və Harunun əli ilə","poem":1},{"lineBreak":true},{"text":"Xalqını bir sürü kimi aparmışdın.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}