{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"heading","content":["Məzmur 78"]},{"type":"hebrew_subtitle","content":["Asəfin maskili."]},{"type":"verse","number":1,"content":[{"text":"Ey xalqım, təlimimi dinləyin,","poem":1},{"lineBreak":true},{"text":"Dilimdən çıxan sözləri eşidin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ağzımı bu məsəllə açıb","poem":1},{"lineBreak":true},{"text":"Keçmişdəki müəmmaları bəyan edəcəyəm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bunları eşitmişik, bilirik,","poem":1},{"lineBreak":true},{"text":"Bizə atalarımız nəql edib.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bunu onların nəvələrindən gizlətməyəcəyik;","poem":1},{"lineBreak":true},{"text":"Rəbbin həmdə layiq işlərini,","poem":1},{"lineBreak":true},{"text":"Onun qüdrətini, etdiyi xariqələri","poem":1},{"lineBreak":true},{"text":"Gələcək nəsillərə söyləyəcəyik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb öyüd vermək üçün Yaqub nəslinə –","poem":1},{"lineBreak":true},{"text":"İsrailə bir təlim qoydu.","poem":1},{"lineBreak":true},{"text":"Ata-babalarımıza əmr etdi ki,","poem":1},{"lineBreak":true},{"text":"Bu təlimi övladlarına öyrətsin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qoy gələcək nəsil də bilsin,","poem":1},{"lineBreak":true},{"text":"Gələcəkdə doğulacaq övladlar da","poem":1},{"lineBreak":true},{"text":"Balalarına bu təlimi verə bilsin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qoy ümidlərini Allaha bağlasınlar,","poem":1},{"lineBreak":true},{"text":"Allahın işlərini unutmasınlar,","poem":1},{"lineBreak":true},{"text":"Əmrlərini yerinə yetirsinlər.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qoy ata-babaları kimi olmasınlar,","poem":1},{"lineBreak":true},{"text":"Çünki onlar dikbaş, üsyankar bir nəsil idi.","poem":1},{"lineBreak":true},{"text":"Allaha ürəkləri dönük,","poem":1},{"lineBreak":true},{"text":"Könülləri vəfasız idi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Efrayim övladları ox-kamanla silahlandılar,","poem":1},{"lineBreak":true},{"text":"Amma döyüş günü tez geriyə qayıtdılar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Allahın əhdini pozanlar belə etdilər,","poem":1},{"lineBreak":true},{"text":"Sənin qanunlarınla yaşamaq istəmədilər.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allahın işlərini,","poem":1},{"lineBreak":true},{"text":"Göstərdiyi xariqələrini unutdular.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Allah Misir torpağında, Soan bölgəsində,","poem":1},{"lineBreak":true},{"text":"Ata-babalarının gözləri önündə xariqələr göstərmişdi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dənizi yarıb onları keçirmişdi,","poem":1},{"lineBreak":true},{"text":"Suları divar kimi saxlamışdı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onlara gündüz buludla,","poem":1},{"lineBreak":true},{"text":"Bütün gecə şəfəq saçan alovla yol göstərmişdi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Çöldə qayaları yarmışdı,","poem":1},{"lineBreak":true},{"text":"İçsinlər deyə ümman kimi bol su çıxarmışdı.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qayadan suları sel kimi çıxarmışdı,","poem":1},{"lineBreak":true},{"text":"Bu suları çaylar kimi axıtmışdı.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Amma onlar günah etməyi davam etdirdilər,","poem":1},{"lineBreak":true},{"text":"Səhrada Haqq-Taalaya qarşı üsyankar oldular.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"İştahaları artdı, yemək tələb etdilər,","poem":1},{"lineBreak":true},{"text":"Ürəklərində Allahı sınağa çəkdilər.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Allahın əleyhinə belə danışdılar:","poem":1},{"lineBreak":true},{"text":"«Məgər Allah çöldə süfrə qura bilər?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nə olsun qayaya vuranda sular axdı,","poem":1},{"lineBreak":true},{"text":"Sellər aşıb-daşdı.","poem":1},{"lineBreak":true},{"text":"Görəsən O, çörək verə bilərmi?","poem":1},{"lineBreak":true},{"text":"Xalqına ət verə bilərmi?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rəbb bunu eşidərkən qəzəbləndi,","poem":1},{"lineBreak":true},{"text":"Yaquba qarşı alovunu yerə tökdü,","poem":1},{"lineBreak":true},{"text":"İsrailə qarşı hiddəti artdı.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çünki onlar Allaha inanmırdılar,","poem":1},{"lineBreak":true},{"text":"Onun qurtuluşuna arxalanmırdılar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bununla belə, uca səmaya əmr etdi,","poem":1},{"lineBreak":true},{"text":"Göylərin qapılarını açdırdı.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onlara yemək üçün manna yağdırdı,","poem":1},{"lineBreak":true},{"text":"Göylərin taxılını verdi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"İnsan mələklərin çörəyindən yedi,","poem":1},{"lineBreak":true},{"text":"Onlara doyunca yemək verildi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Göylərdə şərq küləyini əsdirdi,","poem":1},{"lineBreak":true},{"text":"Qüdrəti ilə cənub küləyini gətirdi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Başlarına toz kimi ət yağdırdı,","poem":1},{"lineBreak":true},{"text":"Onlara dənizdəki qum qədər quşlar göndərdi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Düşərgələrinin ortasına,","poem":1},{"lineBreak":true},{"text":"Qaldıqları yerin ətrafına səpələdi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Onlar doyunca, çox yedi,","poem":1},{"lineBreak":true},{"text":"İştahaları çəkən şeyləri onlara verdi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Lakin iştahaları qurtarmamış,","poem":1},{"lineBreak":true},{"text":"Yemək ağızlarında olarkən","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Allah onlara qarşı hiddətini artırdı,","poem":1},{"lineBreak":true},{"text":"Ətli-canlılarını qırdı,","poem":1},{"lineBreak":true},{"text":"İsrail igidlərini vurub yerə sərdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Bununla belə, günahlarını davam etdirdilər,","poem":1},{"lineBreak":true},{"text":"Onun xariqələrinə inanmadılar.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Buna görə də günlərini puç etdi,","poem":1},{"lineBreak":true},{"text":"Dəhşətlə ömürlərini sona yetirdi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ölənləri görüb Allahı axtardılar,","poem":1},{"lineBreak":true},{"text":"Geri dönüb Allahı səylə aradılar.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yadlarına düşdü ki, Allah onların Qayası idi,","poem":1},{"lineBreak":true},{"text":"Allah-Taala onların Satınalanı idi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Lakin ağızları ilə Ona yaltaqlanırdılar,","poem":1},{"lineBreak":true},{"text":"Dilləri ilə Ona yalan danışırdılar.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Qəlblərində Ona qarşı dönük olmuşdular,","poem":1},{"lineBreak":true},{"text":"Əhdinə vəfasız çıxmışdılar.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Allah isə rəhmlidir, günahı bağışlayır,","poem":1},{"lineBreak":true},{"text":"Günahkarı yox etmir.","poem":1},{"lineBreak":true},{"text":"Dəfələrlə qəzəbini saxlayır,","poem":1},{"lineBreak":true},{"text":"Hiddətini tamamilə oyanmağa qoymayır.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Yada saldı ki, onlar yalnız bəşərdir,","poem":1},{"lineBreak":true},{"text":"Onlar əsən, geri dönməyən küləyə bənzəyir.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Neçə dəfə səhrada Ona qarşı üsyankar oldular,","poem":1},{"lineBreak":true},{"text":"Neçə dəfə çöllükdə Onu kədərləndirdilər!","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Allahı dönə-dönə sınadılar,","poem":1},{"lineBreak":true},{"text":"İsrailin Müqəddəsinin xətrinə dəydilər.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Xatırlamadılar Onun qüdrətini,","poem":1},{"lineBreak":true},{"text":"Düşməndən azad etdiyi günü,","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Misirdə göstərdiyi əlamətləri,","poem":1},{"lineBreak":true},{"text":"Soan bölgəsində göstərdiyi möcüzələri.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Misirlilər sulardan içə bilməsinlər deyə","poem":1},{"lineBreak":true},{"text":"Suları qana döndərib çaylardan axıtmışdı.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Onları göndərdiyi mozalanlara yem etmişdi,","poem":1},{"lineBreak":true},{"text":"Göndərdiyi qurbağalar ölkələrini xarabaya çevirmişdi.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Əkinlərini tırtıllara,","poem":1},{"lineBreak":true},{"text":"Zəhmətlərinin bəhərini çəyirtkələrə vermişdi.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Üzümlərini dolu ilə,","poem":1},{"lineBreak":true},{"text":"Firon ənciri ağaclarını şaxta ilə məhv etmişdi.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Naxırlarını dolu ilə,","poem":1},{"lineBreak":true},{"text":"Sürülərini şimşəklə qırmışdı.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Onların üzərinə qızğın qəzəbini,","poem":1},{"lineBreak":true},{"text":"Hirsini, hiddətini, dərdləri,","poem":1},{"lineBreak":true},{"text":"Bir qoşun ölüm mələklərini tökmüşdü.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Qızğın qəzəbinə yol açmışdı,","poem":1},{"lineBreak":true},{"text":"Əsirgəmədən canlarına ölüm vermişdi,","poem":1},{"lineBreak":true},{"text":"Həyatlarına bəla gətirmişdi.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Hər Misirlinin ilk oğlunu,","poem":1},{"lineBreak":true},{"text":"Ham nəslindən hər kişinin belindən gələn ilk oğlunu qırmışdı.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Öz xalqını isə qoyun kimi oradan çıxarmışdı,","poem":1},{"lineBreak":true},{"text":"Çöldən onları sürü kimi aparmışdı.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Onları qorxudan uzaq, asayiş içində aparmışdı,","poem":1},{"lineBreak":true},{"text":"Düşmənləri isə dənizdə qərq olmuşdu.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Onları Öz müqəddəs torpağına,","poem":1},{"lineBreak":true},{"text":"Sağ əli ilə aldığı dağlar diyarına gətirdi.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Onların qarşısından başqa millətləri qovdu,","poem":1},{"lineBreak":true},{"text":"Torpaqlarını da İsrail qəbilələrinə mülk olaraq payladı,","poem":1},{"lineBreak":true},{"text":"Yaşamaq üçün yurd-yuvalarını onlara verdi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Lakin onlar Allah-Taalanı sınadılar,","poem":1},{"lineBreak":true},{"text":"Ona qarşı üsyankar oldular,","poem":1},{"lineBreak":true},{"text":"Göstərişlərinə əməl etmədilər.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Ataları kimi dönüklük və xəyanət etdilər,","poem":1},{"lineBreak":true},{"text":"Xarab kamandan atılan ox kimi əyri getdilər.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Onu səcdəgahları ilə qəzəbləndirdilər,","poem":1},{"lineBreak":true},{"text":"Onu yonma bütləri ilə qısqandırdılar.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Bunları eşidən Allah çox hiddətləndi,","poem":1},{"lineBreak":true},{"text":"İsraili tamamilə rədd etdi.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"İnsanlar arasında qaldığı çadırını,","poem":1},{"lineBreak":true},{"text":"Şilodakı məskənini tərk etdi.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Qüdrətini","poem":1},{"noteId":5},{"text":"əsarətə,","poem":1},{"lineBreak":true},{"text":"Şərəfini düşmən əlinə təslim etdi.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Öz xalqını qılıncdan keçirtdi,","poem":1},{"lineBreak":true},{"text":"Öz irsini qəzəbinə düçar etdi.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"İgidləri alov uddu,","poem":1},{"lineBreak":true},{"text":"Nişanlı qızlara toy çalınmadı.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Kahinləri qılınclarla qırıldı,","poem":1},{"lineBreak":true},{"text":"Arvadları dul qaldı, gözlərinin yaşı qurudu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"O zaman Xudavənd yuxulu insan kimi oyandı,","poem":1},{"lineBreak":true},{"text":"Sanki şərabın təsirindən ayılan bir pəhləvandır.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Düşmənlərini vuraraq geri atdı,","poem":1},{"lineBreak":true},{"text":"Əbədi olaraq onları rüsvay etdi.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"Yusifin nəslini rədd etdi,","poem":1},{"lineBreak":true},{"text":"Efrayim qəbiləsini seçmədi.","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"Yəhuda qəbiləsini,","poem":1},{"lineBreak":true},{"text":"Sevdiyi Sion dağını seçdi.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"Öz Müqəddəs məkanını səma kimi,","poem":1},{"lineBreak":true},{"text":"Əbədi qurduğu dünya kimi tikdi.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"Çoban olan qulu Davudu seçdi,","poem":1},{"lineBreak":true},{"text":"Onu qoyun ağıllarından götürdü.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"Əmlik quzuların qayğısına qalanı gətirdi,","poem":1},{"lineBreak":true},{"text":"Xalqı Yaqub nəslinin və Öz irsi İsrailin çobanı etdi.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"Davud onları kamil ürəklə otardı,","poem":1},{"lineBreak":true},{"text":"Əlindən gələn məharətlə onları irəli apardı.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Qüdrət, şərəf – Əhd sandığının rəmzi. Bax: 1Şam. 4-cü fəsil.","reference":{"chapter":78,"verse":61}}]},"thisChapterLink":"/api/azb_bsa/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}