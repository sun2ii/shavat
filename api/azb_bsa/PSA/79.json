{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["Məzmur 79"]},{"type":"hebrew_subtitle","content":["Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, millətlər Sənin mülkünə giriblər,","poem":1},{"lineBreak":true},{"text":"Müqəddəs məbədini murdar ediblər,","poem":1},{"lineBreak":true},{"text":"Yerusəlimi viranəliyə çeviriblər.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qullarının cəsədini göydəki quşlara yem ediblər,","poem":1},{"lineBreak":true},{"text":"Möminlərinin ətini yerdəki heyvanlara veriblər.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yerusəlimin hər tərəfində onların qanı axıdılıb,","poem":1},{"lineBreak":true},{"text":"Onları dəfn edən yoxdur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qonşularımızın tənə hədəfinə döndük,","poem":1},{"lineBreak":true},{"text":"Ətrafdakılarımız tərəfindən ələ salınıb lağ edildik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, nə vaxtacan,","poem":1},{"lineBreak":true},{"text":"Yoxsa əbədilikmi bu qəzəbindən dönməyəcəksən,","poem":1},{"lineBreak":true},{"text":"Qısqanclıqdan od tutub yanacaqsan?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Səni tanımayan millətlərin,","poem":1},{"lineBreak":true},{"text":"İsmini çağırmayan ölkələrin üstünə hiddətini tök.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki onlar Yaqub nəslinin başını yeyiblər,","poem":1},{"lineBreak":true},{"text":"Yurd-yuvasını viranəyə çeviriblər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ata-babalarımızın günahını boynumuza qoyma,","poem":1},{"lineBreak":true},{"text":"Nə qədər alçalmışıq, mərhəmətini bizə tez göstər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey bizi qurtaran Allah,","poem":1},{"lineBreak":true},{"text":"İsmin şərəfinə Sən bizə yardım et,","poem":1},{"lineBreak":true},{"text":"Günahlarımızı kəffarə edərək","poem":1},{"lineBreak":true},{"text":"İsmin naminə Sən bizi xilas et.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niyə millətlər «Hanı onların Allahı?» desinlər?","poem":1},{"lineBreak":true},{"text":"Qullarının tökülən qan qisasının alınmasını","poem":1},{"lineBreak":true},{"text":"Qoy gözümüz görsün, millətlər də bilsinlər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Qoy əsirlərin ah-naləsi hüzuruna çatsın,","poem":1},{"lineBreak":true},{"text":"Ölümə aparılanları böyük qüdrətinlə qoru.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, Sənə tənə vuran bizim qonşuların","poem":1},{"lineBreak":true},{"text":"Tənələrini yeddi qat artıq kökslərinə qaytar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Biz Sənin xalqın, otlağının sürüsüyük,","poem":1},{"lineBreak":true},{"text":"Əbədilik Sənə şükür edərik,","poem":1},{"lineBreak":true},{"text":"Nəsildən-nəslə qədər həmdlərini bəyan edərik!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}