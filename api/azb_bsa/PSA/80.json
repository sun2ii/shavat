{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["Məzmur 80"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Asəfin «Şoşannim» üstə oxunan şəhadət məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey İsrailin Çobanı,","poem":1},{"lineBreak":true},{"text":"Yusif nəslinə sürü kimi Baxan, qulaq as!","poem":1},{"lineBreak":true},{"text":"Ey keruvlar üstündə Oturan, nurunu saç!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Efrayim, Binyamin, Menaşşe qəbilələrinin önündə","poem":1},{"lineBreak":true},{"text":"Qoy qüvvətin oyansın, gəl, bizi qurtar!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey Allah, bizi əvvəlki halımıza qaytar,","poem":1},{"lineBreak":true},{"text":"Üzündən nur saçıb bizi qurtar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ya Rəbb, ey Ordular Allahı, nə vaxtacan","poem":1},{"lineBreak":true},{"text":"Xalqının duasından qəzəblənəcəksən?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlara çörək yerinə göz yaşı yedirdin,","poem":1},{"lineBreak":true},{"text":"Onlara bolluca göz yaşı içirdin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qonşularımızla bizi çəkişməyə vadar etdin,","poem":1},{"lineBreak":true},{"text":"Düşmən bizi ələ salıb gülür.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey Ordular Allahı, bizi əvvəlki halımıza qaytar,","poem":1},{"lineBreak":true},{"text":"Üzündən nur saçıb bizi qurtar!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Misirdən tənək fidanı gətirərək","poem":1},{"lineBreak":true},{"text":"Qovduğun millətlərin torpağında əkdin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bunun üçün sahə hazırlamışdın,","poem":1},{"lineBreak":true},{"text":"Tənək rişələnib ölkəni bürüdü.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Budaqları dağlara,","poem":1},{"lineBreak":true},{"text":"Böyük sidr ağaclarına kölgə saldı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dənizə qədər qol-budaq atdı,","poem":1},{"lineBreak":true},{"text":"Zoğ atıb Fərat çayına çatdı.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bəs niyə ətrafdakı hasarını uçurdun?","poem":1},{"lineBreak":true},{"text":"Budur, yoldan keçən hər kəs məhsullarını qoparır,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tənəyi meşənin qabanları korlayır,","poem":1},{"lineBreak":true},{"text":"Onu çöl heyvanları çeynəyir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ey Ordular Allahı, dön, göydən bax,","poem":1},{"lineBreak":true},{"text":"Bu tənəyi gör, qayğısına qal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Axı bu fidanı sağ əlinlə əkmisən,","poem":1},{"lineBreak":true},{"text":"Kökünə","poem":1},{"noteId":6},{"text":"qüvvət vermisən.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tənəyini kəsib yandıranlar","poem":1},{"lineBreak":true},{"text":"Qəzəbli məzəmmətinlə qoy yox olsunlar!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sənin əlin, sağ əlin Öz seçdiyin adamı –","poem":1},{"lineBreak":true},{"text":"Qüvvət verdiyin bəşər oğlunu qorusun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Qoy Səndən dönüb ayrılmayaq,","poem":1},{"lineBreak":true},{"text":"Bizi elə yaşat ki, ismini çağıraq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ya Rəbb, ey Ordular Allahı, bizi əvvəlki halımıza qaytar,","poem":1},{"lineBreak":true},{"text":"Üzündən nur saçıb bizi qurtar!","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Kökünə – yaxud oğula.","reference":{"chapter":80,"verse":15}}]},"thisChapterLink":"/api/azb_bsa/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}