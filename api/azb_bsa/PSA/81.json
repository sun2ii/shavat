{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["Məzmur 81"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Asəfin «Gittit» üstə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Qüvvətimiz olan Allahı mədh edin,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahına cuşa gəlib nida edin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İlahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Dəfi, xoş avazlı liranı və çəngi çalın.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Təzə Ay mərasimində, ay bədirlənəndə,","poem":1},{"lineBreak":true},{"text":"Bizim bayram günündə","poem":1},{"lineBreak":true},{"text":"Şeypur çalın!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki bu, İsrail üçün verilən qaydadır,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahının hökmüdür.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O, Misir əleyhinə çıxanda","poem":1},{"lineBreak":true},{"text":"Yusif nəslinə belə bir öyüd verib.","poem":1},{"lineBreak":true},{"text":"Naməlum bir səs eşitdim:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Onun çiyinlərini bu yükdən qurtarıram,","poem":1},{"lineBreak":true},{"text":"Qoy əlləri bu ağır səbətdən azad olsun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dar günündə Məni çağırdın,","poem":1},{"lineBreak":true},{"text":"Mən də səni qurtardım.","poem":1},{"lineBreak":true},{"text":"Gurlayaraq tufan içindən sənə cavab verdim,","poem":1},{"lineBreak":true},{"text":"Meriva sularında səni sınadım. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey xalqım, dinlə, xəbərdarlıq edirəm,","poem":1},{"lineBreak":true},{"text":"Ey İsrail, kaş ki Məni dinləyəydin!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aranızda özgə allah olmasın,","poem":1},{"lineBreak":true},{"text":"Yad allaha kimsə səcdə qılmasın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbb Allahınız Mənəm,","poem":1},{"lineBreak":true},{"text":"Mən sizi Misir torpağından buraya gətirmişəm.","poem":1},{"lineBreak":true},{"text":"Ağzını yaxşı aç,","poem":1},{"lineBreak":true},{"text":"Doyunca yemək verirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakin xalqım səsimi eşitmədi,","poem":1},{"lineBreak":true},{"text":"İsrail nəsli Məni istəmədi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onların inadkar qəlblərinə izin verdim ki,","poem":1},{"lineBreak":true},{"text":"Necə istəyirlər, elə gəzsinlər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kaş ki xalqım Mənə qulaq asaydı,","poem":1},{"lineBreak":true},{"text":"İsrail nəsli Mənim yolumla gedəydi!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bir anda düşmənlərini yerə sərərdim,","poem":1},{"lineBreak":true},{"text":"Əlimi yağılarının üstünə qaldırardım.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən Rəbbə nifrət edənlər Mənə boyun əyərdi,","poem":1},{"lineBreak":true},{"text":"Əbədi olaraq vaxtları belə keçərdi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sizə taxılın əlasını yedirərdim,","poem":1},{"lineBreak":true},{"text":"Sizi qayadan axan balla bəsləyərdim».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}