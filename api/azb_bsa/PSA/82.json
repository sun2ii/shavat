{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Məzmur 82"]},{"type":"hebrew_subtitle","content":["Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Allah Öz toplantısında durub,","poem":1},{"lineBreak":true},{"text":"Hökmünü verərək allahlar arasında deyir:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Nə vaxtadək nahaq hökm verəcəksiniz,","poem":1},{"lineBreak":true},{"text":"Pislərə tərəfkeşlik edəcəksiniz? Sela","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yoxsulun və yetimin işinə ədalətlə baxın,","poem":1},{"lineBreak":true},{"text":"Məzlumun və fəqirin haqqını verin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yoxsul və möhtacları qurtarın,","poem":1},{"lineBreak":true},{"text":"Pislərin əlindən onları azad edin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nə bilirsiniz, nə də ki anlayırsınız!","poem":1},{"lineBreak":true},{"text":"Yerin təməlləri sarsılır, qaranlıqda dolanırsınız.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Demişəm: “Siz allahlarsınız,","poem":1},{"lineBreak":true},{"text":"Hər biriniz Haqq-Taala övladlarısınız”.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lakin insan kimi öləcəksiniz,","poem":1},{"lineBreak":true},{"text":"Adi bir hökmdar kimi torpağa düşəcəksiniz».","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey Allah, qalx, dünyaya hakim ol,","poem":1},{"lineBreak":true},{"text":"Çünki bütün millətlərə Sən sahib olacaqsan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}