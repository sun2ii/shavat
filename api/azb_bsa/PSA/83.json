{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["Məzmur 83"]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"hebrew_subtitle","content":["Asəfin məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Allah, susub səssiz durma!","poem":1},{"lineBreak":true},{"text":"Ey Allah, sakit olma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Budur, düşmənlər qiyamət qoparır,","poem":1},{"lineBreak":true},{"text":"Sənə nifrət edənlər Sənin əleyhinə qalxır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xalqına qarşı fənd işlədirlər,","poem":1},{"lineBreak":true},{"text":"Sənin qoruduqlarına qarşı birgə qərara gəlirlər.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deyirlər: «Gəlin, onları millət olmasın deyə məhv edək,","poem":1},{"lineBreak":true},{"text":"İsrailin adı xatırlanmasın deyə onları yox edək».","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ürəkləri bir olaraq qərara gəliblər,","poem":1},{"lineBreak":true},{"text":"Sənə qarşı bunlar əhd ediblər:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edomlular, İsmaillilər,","poem":1},{"lineBreak":true},{"text":"Moavlılar, Həcərlilər,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Geval, Ammon, Amaleq,","poem":1},{"lineBreak":true},{"text":"Filişt və Sur əhalisi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aşşur da onlara qoşulub,","poem":1},{"lineBreak":true},{"text":"Lutun övladlarına kömək edir. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Başlarına gətir Midyanlılara etdiklərini,","poem":1},{"lineBreak":true},{"text":"Qişon vadisində Sisranın, Yavinin başına gətirdiklərini.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onlar En-Dorda həlak oldular,","poem":1},{"lineBreak":true},{"text":"Torpaq üçün peyin oldular.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əsilzadələrini Orev və Zeev kimi et,","poem":1},{"lineBreak":true},{"text":"Bütün ağalarını Zevah və Salmunna kimi et.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onlar demişdilər:","poem":1},{"lineBreak":true},{"text":"«Allahın otlaqlarına sahib olaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ey Allahım, onları sovrulan toza,","poem":1},{"lineBreak":true},{"text":"Küləyin süpürdüyü saman qırıntısına çevir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Meşəni yandıran od kimi,","poem":1},{"lineBreak":true},{"text":"Dağları alışdıran alov kimi","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onları tufanınla qov,","poem":1},{"lineBreak":true},{"text":"Qasırğanla dəhşətə sal.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ya Rəbb, onların üzünü xəcalətə bürü,","poem":1},{"lineBreak":true},{"text":"Qoy Sənin ismini axtarsınlar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Əbədilik utanaraq vəlvələyə düşsünlər,","poem":1},{"lineBreak":true},{"text":"Rüsvay olub yox olsunlar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bilsinlər ki, Sənin ismin Rəbdir,","poem":1},{"lineBreak":true},{"text":"Bütün yer üzündə ancaq Sən Haqq-Taalasan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}