{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["Məzmur 84"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının «Gittit» üstə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ey Ordular Rəbbi, məskənin nə qədər əzizdir,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qəlbim Rəbbin həyətinin həsrətindədir,","poem":1},{"lineBreak":true},{"text":"Könlüm, cismim var olan Allaha mədh oxuyur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey Ordular Rəbbi, Padşahım, Allahım,","poem":1},{"lineBreak":true},{"text":"Qurbangahının yaxınında sərçələr yurd salar,","poem":1},{"lineBreak":true},{"text":"Qaranquş bala çıxartmaq üçün yuva qurar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nə bəxtiyardır evində yaşayanlar,","poem":1},{"lineBreak":true},{"text":"Daim Sənə həmd oxuyanlar! Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nə bəxtiyardır Səndən qüvvət alanlar,","poem":1},{"lineBreak":true},{"text":"Qəlbində Sionu ziyarət etməyi arzulayanlar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baka","poem":1},{"noteId":7},{"text":"vadisindən keçərkən","poem":1},{"lineBreak":true},{"text":"Onlara çağlayan bulaqlar görünər,","poem":1},{"lineBreak":true},{"text":"İlk yağışdan ora gölməçələrə bürünər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu adamlar getdikcə qüvvət alarlar,","poem":1},{"lineBreak":true},{"text":"Sionda Allahın hüzurunda olarlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb, ey Ordular Allahı, duamı dinlə,","poem":1},{"lineBreak":true},{"text":"Ey Yaqubun Allahı, qulaq as! Sela","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Allah, bizə sipər olana bax,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyinin üzünə bax!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sənin həyətində keçən bir günüm","poem":1},{"lineBreak":true},{"text":"Başqa yerdə keçən min günümdən yaxşıdır.","poem":1},{"lineBreak":true},{"text":"Allahımın evinin keşiyində dayanmağım","poem":1},{"lineBreak":true},{"text":"Pislərin çadırında rahat ömür sürməkdən yaxşıdır.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Axı Rəbb Allah günəşdir, sipərdir,","poem":1},{"lineBreak":true},{"text":"Rəbb lütf və şərəf verir,","poem":1},{"lineBreak":true},{"text":"Xeyirxahlığını düz yolla gedənlərdən əsirgəmir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey Ordular Rəbbi, Sənə güvənən nə bəxtiyardır!","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Baka – ibrani dilində ağlama.","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/azb_bsa/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}