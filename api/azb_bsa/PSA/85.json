{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["Məzmur 85"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Qorah övladlarının məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, ölkədən razı qaldın,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslini bəxtəvər günlərə qaytardın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xalqının təqsirlərini bağışladın,","poem":1},{"lineBreak":true},{"text":"Bütün günahlarını əfv etdin. Sela","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sən bütün hirsini uddun,","poem":1},{"lineBreak":true},{"text":"Qızğın qəzəbini yatırdın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey bizi qurtaran Allah,","poem":1},{"lineBreak":true},{"text":"Bizə bəxtəvər günlərimizi qaytar.","poem":1},{"lineBreak":true},{"text":"Bizə qarşı hiddətindən əl çək.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Əbədilikmi bizə acığın tutacaq?","poem":1},{"lineBreak":true},{"text":"Qəzəbin nəsildən-nəslə qədərmi uzanacaq?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xalqın Səndən sevinc alsın deyə","poem":1},{"lineBreak":true},{"text":"Bizi yenə dirçəltməyəcəksənmi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ya Rəbb, bizə məhəbbətini göstər,","poem":1},{"lineBreak":true},{"text":"Bizi xilas et.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Rəbb Allah nə söyləsə, dinləyirəm.","poem":1},{"lineBreak":true},{"text":"Sözləri xalqına, möminlərinə sülh bəyan edər ki,","poem":1},{"lineBreak":true},{"text":"Onlar öz cəhalətlərinə dönməsinlər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bəli, Rəbb Ondan qorxanları qurtarmaq üçün,","poem":1},{"lineBreak":true},{"text":"Ehtişamını ölkəmizdə saxlamaq üçün yaxınlaşır!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Məhəbbətlə həqiqət bir-birinə qovuşacaq,","poem":1},{"lineBreak":true},{"text":"Salehliklə əmin-amanlıq bir-biri ilə öpüşəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Həqiqət yerdə bitib-göyərəcək,","poem":1},{"lineBreak":true},{"text":"Ədalət göylərdən baxacaq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bəli, Rəbb ən yaxşı şeyləri göndərəcək,","poem":1},{"lineBreak":true},{"text":"Torpağımız bol məhsul verəcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ədalət Rəbbin önündə addımlayar,","poem":1},{"lineBreak":true},{"text":"Qədəmləri üçün cığır salar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}