{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["Məzmur 86"]},{"type":"hebrew_subtitle","content":["Davudun duası."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, mənə qulaq asıb cavab ver,","poem":1},{"lineBreak":true},{"text":"Çünki mən məzlumam, fəqirəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Möminəm, Sən Özün məni qoru,","poem":1},{"lineBreak":true},{"text":"Ey Allahım, Sənə güvənən bəndəni qurtar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəhm et mənə, ey Xudavənd,","poem":1},{"lineBreak":true},{"text":"Çünki bütün gün Səni səsləyirəm!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu bəndənin qəlbini sevindir,","poem":1},{"lineBreak":true},{"text":"Ey Xudavənd, Sənə ürəyimi təqdim edirəm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki Sən, ey Xudavənd, xeyirxahsan, bağışlayan Sənsən,","poem":1},{"lineBreak":true},{"text":"Səni səsləyənlərin hamısı üçün məhəbbətin boldur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya Rəbb, duamı dinlə,","poem":1},{"lineBreak":true},{"text":"Yalvarışlarımın səsinə qulaq as.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dar gündə Səni səsləyirəm,","poem":1},{"lineBreak":true},{"text":"Bilirəm ki, mənə cavab verərsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ey Xudavənd, allahlar arasında Sənin kimisi yoxdur,","poem":1},{"lineBreak":true},{"text":"Əməllərin kimi əməl yoxdur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, yaratdığın millətlərin hamısı hüzuruna gələcək,","poem":1},{"lineBreak":true},{"text":"Sənin ismini izzətləndirərək səcdə edəcək.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Çünki əzəmətli, xariqələr yaradan Sənsən,","poem":1},{"lineBreak":true},{"text":"Yeganə Allah Sənsən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, mənə yolunu göstər,","poem":1},{"lineBreak":true},{"text":"Sənin həqiqətinlə addımlayım.","poem":1},{"lineBreak":true},{"text":"Qəlbimi səmimi et,","poem":1},{"lineBreak":true},{"text":"Qoy Sənin ismindən qorxum.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey Xudavənd Allahım, bütün qəlbimlə Sənə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Daim ismini izzətləndirəcəyəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Çünki mənə olan məhəbbətin böyükdür,","poem":1},{"lineBreak":true},{"text":"Canımı ölülər diyarına enməkdən qurtardın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ey Allah, lovğalar əleyhimə qalxır,","poem":1},{"lineBreak":true},{"text":"Bir dəstə zalım canımı almaq üçün məni axtarır,","poem":1},{"lineBreak":true},{"text":"Səni qarşılarında görmür.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, Sən rəhmli, lütfkar Allahsan,","poem":1},{"lineBreak":true},{"text":"Hədsiz səbirlisən, məhəbbətin və sədaqətin boldur.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sən mənə baxıb rəhm et,","poem":1},{"lineBreak":true},{"text":"Bu bəndənə Öz gücündən ver,","poem":1},{"lineBreak":true},{"text":"Kənizinin oğlunu xilas et.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xeyirxahlığından mənə bir əlamət göstər,","poem":1},{"lineBreak":true},{"text":"Qoy mənə nifrət edənlər görüb utansınlar.","poem":1},{"lineBreak":true},{"text":"Çünki, ya Rəbb, mənə kömək edirsən,","poem":1},{"lineBreak":true},{"text":"Könlümə təsəlli verirsən.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}