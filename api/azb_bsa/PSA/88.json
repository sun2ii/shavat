{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["Məzmur 88"]},{"type":"hebrew_subtitle","content":["Bir ilahi."]},{"type":"hebrew_subtitle","content":["Qorah övladlarının məzmuru."]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün Ezrahlı Hemanın «Maxalat leannot» üstə oxunan maskili."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, ey məni qurtaran Allah,","poem":1},{"lineBreak":true},{"text":"Gecə-gündüz Sənə yalvarıram!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qoy duam Sənə çatsın,","poem":1},{"lineBreak":true},{"text":"Qulaq as naləmə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bəlalardan canım boğazıma gəldi,","poem":1},{"lineBreak":true},{"text":"Həyatım ölülər diyarına yaxınlaşır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qəbirə düşənlərin içində sayılıram,","poem":1},{"lineBreak":true},{"text":"Sanki məndə taqət qalmayıb.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Elə bil ölülər içinə düşmüşəm,","poem":1},{"lineBreak":true},{"text":"Yaddaşından silinmişəm,","poem":1},{"lineBreak":true},{"text":"Köməyindən əlimi üzmüşəm,","poem":1},{"lineBreak":true},{"text":"Məzarda yatan meyitlər kimiyəm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Məni dərin qəbirə,","poem":1},{"lineBreak":true},{"text":"Dərin, qaranlıq bir yerə saldın.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qəzəbin üstümə gəldi,","poem":1},{"lineBreak":true},{"text":"Təlatümün tamamilə məni əzdi. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tanışlarımı məndən uzaqlaşdırdın,","poem":1},{"lineBreak":true},{"text":"Onlarda mənə qarşı ikrah yaratdın.","poem":1},{"lineBreak":true},{"text":"Qapalı qalmışam, çıxa bilmirəm,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu zülmümdən gözlərimin nuru sönür.","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, hər gün Səni çağırıram,","poem":1},{"lineBreak":true},{"text":"Sənə əl açıram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xariqələrini ölülərəmi göstərəcəksən?","poem":1},{"lineBreak":true},{"text":"Kölgələrmi qalxıb Sənə şükür edəcək? Sela","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Məhəbbətin məzardamı,","poem":1},{"lineBreak":true},{"text":"Sədaqətin Həlak yerindəmi bəyan olunacaq?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xariqələrin qaranlıqdamı,","poem":1},{"lineBreak":true},{"text":"Ədalətin unudulma diyarındamı tanınacaq?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mən isə, ya Rəbb, Səni imdada çağırıram,","poem":1},{"lineBreak":true},{"text":"Duam hər səhər hüzuruna qalxır.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ya Rəbb, niyə məni rədd edirsən?","poem":1},{"lineBreak":true},{"text":"Niyə məndən üzünü gizlədirsən?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mən uşaqlıqdan məzlumam, ölümcül haldayam,","poem":1},{"lineBreak":true},{"text":"Göstərdiyin dəhşətlərdən çarəsiz qalmışam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Qəzəbin üzərimdən basır,","poem":1},{"lineBreak":true},{"text":"Verdiyin vahimələrdən məhv oluram.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bunlar sel kimi məni dövrəyə salır,","poem":1},{"lineBreak":true},{"text":"Bunlar birgə həmişə başımın üstünü alır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yarımı, yoldaşımı məndən uzaqlaşdırmısan,","poem":1},{"lineBreak":true},{"text":"Yalnız qaranlıqla həmdəm olmuşam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}