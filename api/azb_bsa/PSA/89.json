{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["Məzmur 89"]},{"type":"hebrew_subtitle","content":["Ezrahlı Etanın maskili."]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, daim məhəbbətindən nəğmə oxuyacağam,","poem":1},{"lineBreak":true},{"text":"Sənin sədaqətini dilim hər nəslə deyəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deyirəm ki, məhəbbətin əbədiyaşardır,","poem":1},{"lineBreak":true},{"text":"Sədaqətin göylər qədər sarsılmazdır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dedin: «Öz seçdiyimlə əhd kəsmişəm,","poem":1},{"lineBreak":true},{"text":"Qulum Davud üçün belə and içmişəm:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Mən nəslini əbədi sarsılmaz edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sülaləni taxtında sonsuzadək yaşadacağam”». Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, göylər Sənin xariqələrinə şükür etsin,","poem":1},{"lineBreak":true},{"text":"Müqəddəslər camaatı arasında sədaqətinə həmd edilsin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Göydə Rəbbin tayı-bərabəri varmı?","poem":1},{"lineBreak":true},{"text":"İlahi varlıqlar arasında Rəbbin bənzəri varmı?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Müqəddəslər məclisində Allah çox zəhmlidir,","poem":1},{"lineBreak":true},{"text":"Ətrafında olanların hamısından O heybətlidir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Ordular Allahı, Sənin tək qüdrətli varmı?","poem":1},{"lineBreak":true},{"text":"Səni sədaqətin bürüyüb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sən qabaran dənizə hökm edirsən,","poem":1},{"lineBreak":true},{"text":"Aşıb-daşan dalğaları yatırırsan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sən Rahavı","poem":1},{"noteId":9},{"text":"əzib leşini çıxartdın,","poem":1},{"lineBreak":true},{"text":"Qüvvətli qolunla düşmənləri dağıtdın.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Göylər Sənin, yer üzü Sənin,","poem":1},{"lineBreak":true},{"text":"Qurduğun yer üzündə hər şeyin təməlini qoymusan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sən şimalı, cənubu yaratmısan,","poem":1},{"lineBreak":true},{"text":"Tavor və Xermon adına mədh oxuyur.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Qolun nə qədər qüvvətlidir,","poem":1},{"lineBreak":true},{"text":"Sağ əlin ucadır, əllərin qüdrətlidir!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Salehlik və ədalət taxtının təməlidir,","poem":1},{"lineBreak":true},{"text":"Məhəbbət və sədaqət önündə gedir!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bayram şənliyində olan xalq nə bəxtiyardır!","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, onlar Sənin üzünün nurunda gəzər.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"İsminə görə daim sevinirlər,","poem":1},{"lineBreak":true},{"text":"Salehliyinə görə şərəfə çatırlar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Onların ehtişamı, qüvvəti Sənsən.","poem":1},{"lineBreak":true},{"text":"Sənin lütfündən gücümüz artır.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki sipərimiz Rəbdəndir,","poem":1},{"lineBreak":true},{"text":"Padşahımız İsrailin Müqəddəsidir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Keçmişdə bir görüntü ilə","poem":1},{"lineBreak":true},{"text":"Möminlərinə belə söylədin:","poem":1},{"lineBreak":true},{"text":"«Bir cəngavərə kömək etdim,","poem":1},{"lineBreak":true},{"text":"Xalqın içindən onu seçib yüksəltdim.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Qulum Davudu tapdım,","poem":1},{"lineBreak":true},{"text":"Müqəddəs yağımla onu məsh etdim.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əlim daim onu möhkəmləndirəcək,","poem":1},{"lineBreak":true},{"text":"Qolum ona qüvvət verəcək!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Düşmən ona qalib gələ bilməz,","poem":1},{"lineBreak":true},{"text":"Fitnəkarlar ona zülm edə bilməz.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Qarşısındakı düşmənləri qıracağam,","poem":1},{"lineBreak":true},{"text":"Ona nifrət edənləri vuracağam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yanında sədaqətim, məhəbbətim olacaq,","poem":1},{"lineBreak":true},{"text":"Gücü ismimlə artacaq.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dənizlərə əlini,","poem":1},{"lineBreak":true},{"text":"Çaylara sağ əlini çatdıracağam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Məni çağırıb deyəcək: “Atamsan, Allahımsan,","poem":1},{"lineBreak":true},{"text":"Məni xilas edən Qaya Sənsən!”","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mən də ilk oğul haqqını ona verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onu yer üzünün ən uca padşahı edəcəyəm.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ona daim məhəbbətimi göstərəcəyəm,","poem":1},{"lineBreak":true},{"text":"Sadiq qalıb əhdimi pozmayacağam.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Onun nəslini əbədi yaşadacağam,","poem":1},{"lineBreak":true},{"text":"Göylər durduqca taxtını saxlayacağam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Övladları qanunumu atsalar,","poem":1},{"lineBreak":true},{"text":"Hökmlərimə görə yaşamasalar,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Qaydalarımı pozsalar,","poem":1},{"lineBreak":true},{"text":"Əmrlərimə əməl etməsələr,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bu qanunsuzluqlarını kötəklə cəzalandıracağam,","poem":1},{"lineBreak":true},{"text":"Təqsirlərini qamçı ilə tənbeh edəcəyəm.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Amma yenə də məhəbbətimi atmaram,","poem":1},{"lineBreak":true},{"text":"Sədaqətimi yalan olmağa qoymaram.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Öz əhdimi pozmaram,","poem":1},{"lineBreak":true},{"text":"Dilimdən çıxan sözləri dəyişmərəm.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Müqəddəsliyim naminə bir dəfə and içmişəm:","poem":1},{"lineBreak":true},{"text":"Davuda yalandan söz verməyəcəyəm.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Sülaləsi taxtda əbədi qalacaq,","poem":1},{"lineBreak":true},{"text":"Taxtı hüzurumda günəş kimi duracaq.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ay kimi –","poem":1},{"lineBreak":true},{"text":"Göydəki etibarlı şahid kimi sabit qalacaq». Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Amma, ya Rəbb, məsh etdiyin padşaha qəzəblənmisən,","poem":1},{"lineBreak":true},{"text":"Sən onu rədd etmisən, ona arxa çevirmisən.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Qulunla bağladığın əhddən imtina etmisən,","poem":1},{"lineBreak":true},{"text":"Tacını toz-torpağa atıb bulaşdırmısan.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Bütün divarlarını yıxmısan,","poem":1},{"lineBreak":true},{"text":"Qalalarını viran etmisən.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Yoldan keçənlər oranı soyub-talayırlar,","poem":1},{"lineBreak":true},{"text":"Qonşuları ona tənə vururlar.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Onun düşmənlərinin sağ əlini yuxarı qaldırmısan,","poem":1},{"lineBreak":true},{"text":"Bütün yağılarını sevindirmisən.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Qılıncının ağzını kütləşdirmisən,","poem":1},{"lineBreak":true},{"text":"Onu döyüşdə qaldırmamısan.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Onu şərəfdən salmısan,","poem":1},{"lineBreak":true},{"text":"Taxtını yerlə yeksan etmisən.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Nə tez onu gəncliyindən saldın,","poem":1},{"lineBreak":true},{"text":"Onu xəcalətə bürüdün. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Ya Rəbb, nə vaxta qədər,","poem":1},{"lineBreak":true},{"text":"Yoxsa əbədilikmi bizdən gizlənəcəksən,","poem":1},{"lineBreak":true},{"text":"Od tutub qəzəbdən yanacaqsan?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Ömrümün nə tez keçdiyini xatırla,","poem":1},{"lineBreak":true},{"text":"Bütün bəşər övladlarını nə fani yaratmısan!","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"İnsanlar arasında ölüm görməyən kimdir?","poem":1},{"lineBreak":true},{"text":"Kim canını ölülər diyarının pəncəsindən qurtarar? Sela","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, əvvəlki məhəbbətin harada qaldı?","poem":1},{"lineBreak":true},{"text":"Çünki bu barədə Davuda sədaqətlə and içdin.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ey Xudavənd, unutma, gör bu bəndən necədir,","poem":1},{"lineBreak":true},{"text":"Köksümdə nə qədər xalqın tənəsini gəzdirirəm.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Ya Rəbb, düşmənlərinin etdiyi təhqirləri,","poem":1},{"lineBreak":true},{"text":"Məsh etdiyinin yoluna vurduqları tənələri daşıyıram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Rəbbə əbədilik alqış olsun!","poem":1},{"lineBreak":true},{"text":"Amin, Amin.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Rahav – burada dəniz əjdahası mənasında işlənir.","reference":{"chapter":89,"verse":10}}]},"thisChapterLink":"/api/azb_bsa/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}