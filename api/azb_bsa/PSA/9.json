{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["Məzmur 9"]},{"type":"hebrew_subtitle","content":["Musiqi rəhbəri üçün. Davudun «Mut-labben» üstə oxunan məzmuru."]},{"type":"verse","number":1,"content":[{"text":"Bütün ürəyimlə Rəbbə şükür edəcəyəm,","poem":1},{"lineBreak":true},{"text":"Bütün xariqələrini deyəcəyəm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sənə görə fərəhimdən sevinib cuşa gələcəyəm,","poem":1},{"lineBreak":true},{"text":"Ey Haqq-Taala, ismini tərənnüm edəcəyəm!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Düşmənlərim geri dönəndə","poem":1},{"lineBreak":true},{"text":"Sənin önündə səndələyərək yıxılıb məhv olurlar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünki Sən haqqımı və mübarizəmi gördün,","poem":1},{"lineBreak":true},{"text":"Taxtında oturub ədalətlə hökm etdin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sən millətləri məzəmmət, pisləri yox etdin,","poem":1},{"lineBreak":true},{"text":"Adlarını əbədilik sildin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Düşmənin sonu çatdı, o əbədi viran oldu,","poem":1},{"lineBreak":true},{"text":"Şəhərlərini təməlindən qopartdın,","poem":1},{"lineBreak":true},{"text":"Onların xatirəsi də məhv oldu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rəbb isə əbədi olaraq hökmranlıq edir,","poem":1},{"lineBreak":true},{"text":"O, taxtını hökm üçün qurub.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dünyaya ədalətlə hökm edir,","poem":1},{"lineBreak":true},{"text":"Ümmətlərə insafla hakimlik edir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbb məzlumların pənahgahıdır,","poem":1},{"lineBreak":true},{"text":"Sıxıntı anlarında müdafiə qalasıdır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"İsmini tanıyanlar Sənə güvənir,","poem":1},{"lineBreak":true},{"text":"Çünki, ya Rəbb, Səni axtaranları tərk etməzsən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sionun sakini olan Rəbbi tərənnüm edin!","poem":1},{"lineBreak":true},{"text":"Xalqlar arasında Onun işlərini bəyan edin!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O, tökülən qanın qisasını alır, yadda saxlayır,","poem":1},{"lineBreak":true},{"text":"Məzlumların fəryadını unutmur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, rəhm et!","poem":1},{"lineBreak":true},{"text":"Ey ölüm qapılarından məni qurtaran,","poem":1},{"lineBreak":true},{"text":"Mənə nifrət edənlərin üzündən çəkdiyim dərdə bax!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sion qızının darvazalarında","poem":1},{"lineBreak":true},{"text":"Qoy Sənə edilən həmdlərimdən danışım,","poem":1},{"lineBreak":true},{"text":"Səndə xilas taparaq şadlanım!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Millətlər qazdıqları quyuya özləri düşüb,","poem":1},{"lineBreak":true},{"text":"Qurduqları tələyə öz ayaqları ilişib.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rəbb Özünü göstərib hökmünü yeritdi,","poem":1},{"lineBreak":true},{"text":"Pislər öz əməlləri ilə tora düşdü. Hiqqayon,9:16 Hiqqayon – mənası bilinməyən musiqi termini. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Pis adamlar ölülər diyarına düşəcək,","poem":1},{"lineBreak":true},{"text":"Allahı unudan bütün millətlər də oraya gedəcək.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Çünki fəqir adam həmişəlik unudulmaz,","poem":1},{"lineBreak":true},{"text":"Məzlumun ümidi əbədi olaraq boşa çıxmaz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ya Rəbb, qalx, qoy insan qalib gəlməsin,","poem":1},{"lineBreak":true},{"text":"Sənin hüzurunda millətlər məhkum edilsin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ya Rəbb, qoy millətlər Səndən qorxsunlar,","poem":1},{"lineBreak":true},{"text":"Qoy onlar bilsinlər ki, yalnız insandırlar. Sela","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}