{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["Məzmur 90"]},{"type":"hebrew_subtitle","content":["Allah adamı Musanın duası."]},{"type":"verse","number":1,"content":[{"text":"Ey Xudavənd, bütün nəsillərdən bəri","poem":1},{"lineBreak":true},{"text":"Bizə pənah yeri olmusan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dağlara təvəllüd verməmişdən əvvəl,","poem":1},{"lineBreak":true},{"text":"Kainatı, dünyanı doğmazdan əvvəl","poem":1},{"lineBreak":true},{"text":"Əzəldən axıradək Allah Sənsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İnsanları torpağa çevirirsən,","poem":1},{"lineBreak":true},{"text":"Deyirsən: «Qoy bəşər övladları toza dönsün».","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sənin gözündə min il ötən bir günə,","poem":1},{"lineBreak":true},{"text":"Bir gecə növbəsinə bənzər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"İnsanları silirsən, çəkilirlər,","poem":1},{"lineBreak":true},{"text":"Elə bil ki yuxudurlar.","poem":1},{"lineBreak":true},{"text":"Sanki sübh çağı yerdə bitən otdurlar,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Səhər boy atar, çiçək açar,","poem":1},{"lineBreak":true},{"text":"Axşamsa solar, quruyar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Qəzəbindən məhv oluruq,","poem":1},{"lineBreak":true},{"text":"Hiddətindən vəlvələyə düşürük.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hüzurunda təqsirlərimizi üzə çıxarmısan,","poem":1},{"lineBreak":true},{"text":"Gizli günahlarımıza üzünün işığını salmısan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ömür-günümüz Sənin qəzəbin altında keçir,","poem":1},{"lineBreak":true},{"text":"İllərimiz bir nəfəs tək tükənir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yetmiş il ömür sürərik,","poem":1},{"lineBreak":true},{"text":"Sağlam olsaq, səksənə yetişərik.","poem":1},{"lineBreak":true},{"text":"Ən yaxşı çağımız belə, zəhmətlə, kədərlə keçir,","poem":1},{"lineBreak":true},{"text":"Ömrümüz tez bitir, uçub-gedir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Axı qəzəbinin gücünü kim dərk edə bilər?","poem":1},{"lineBreak":true},{"text":"Hirsinin vahiməsini kim duya bilər?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bizə öyrət nə qədər ömrümüz var,","poem":1},{"lineBreak":true},{"text":"Qoy qəlbimiz hikmətli olsun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Əl çək, ya Rəbb! Nə vaxtadək qəzəbindən dönməyəcəksən?","poem":1},{"lineBreak":true},{"text":"Sən qullarına rəhm et.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Səhər-səhər bizə doyunca məhəbbət göstər,","poem":1},{"lineBreak":true},{"text":"Qoy ömrümüz boyu sevinib fərəhlənək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bizi zülmə saldığın günlər qədər,","poem":1},{"lineBreak":true},{"text":"Bəlaya düşdüyümüz illər qədər sevindir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Əməllərin qullarına,","poem":1},{"lineBreak":true},{"text":"Əzəmətin övladlarına görünsün.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ey Xudavənd Allahımız, bizimlə xoş rəftar et,","poem":1},{"lineBreak":true},{"text":"Əllərimizin zəhmətini uğurlu et,","poem":1},{"lineBreak":true},{"text":"Bəli, bizim əllərimizin zəhmətini uğurlu et.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}