{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["Məzmur 91"]},{"type":"verse","number":1,"content":[{"text":"Haqq-Taalanın pənahında yaşayan,","poem":1},{"lineBreak":true},{"text":"Külli-İxtiyarın kölgəsində oturan insan","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb haqqında belə söyləyir:","poem":1},{"lineBreak":true},{"text":"«O mənim sığınacağımdır, qalamdır,","poem":1},{"lineBreak":true},{"text":"Allahımdır, Ona güvənirəm».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bil ki, O səni ovçunun tələsindən,","poem":1},{"lineBreak":true},{"text":"Ağır xəstəliyə düşüb ölməkdən qurtarar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Səni qanadlarının altına alar,","poem":1},{"lineBreak":true},{"text":"Pərlərinin altında sığınacaqsan.","poem":1},{"lineBreak":true},{"text":"Sədaqəti qalxanın, sipərin olar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nə gecənin kabusundan,","poem":1},{"lineBreak":true},{"text":"Nə də gündüz atılan oxdan,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nə zülmətdə dolanan ağır xəstəlikdən,","poem":1},{"lineBreak":true},{"text":"Nə də günorta məhvedici qırğından qorxmazsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yanında min nəfər,","poem":1},{"lineBreak":true},{"text":"Sağında on min nəfər qırılsa,","poem":1},{"lineBreak":true},{"text":"Sənə xətər dəyməz.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gözlərinlə baxacaqsan,","poem":1},{"lineBreak":true},{"text":"Pislərin cəzasını görəcəksən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ya Rəbb, sığınacağımsan!» dediyin üçün,","poem":1},{"lineBreak":true},{"text":"Haqq-Taalaya sığındığın üçün","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Şərə düçar olmazsan,","poem":1},{"lineBreak":true},{"text":"Bəla çadırından uzaq qaçar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Allah sənə görə mələklərinə əmr edər ki,","poem":1},{"lineBreak":true},{"text":"Gedəcəyin hər yerdə səni qorusunlar,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Səni əlləri üstündə aparsınlar,","poem":1},{"lineBreak":true},{"text":"Ayağın bir daşa dəyməsin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Şiri, gürzəni ayaqlayarsan,","poem":1},{"lineBreak":true},{"text":"Gənc aslanı, əfi ilanı tapdalayarsan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Mən Rəbbi sevdiyinə görə onu azad edəcəyəm,","poem":1},{"lineBreak":true},{"text":"İsmimi tanıdığına görə onu yüksəldəcəyəm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Məni çağırarkən ona cavab verəcəyəm,","poem":1},{"lineBreak":true},{"text":"Dar günündə ona yar olacağam,","poem":1},{"lineBreak":true},{"text":"Onu xilas edib şərəfə-şana çatdıracağam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onu uzun ömürlə doyduracağam,","poem":1},{"lineBreak":true},{"text":"Ona qurtuluşumu göstərəcəyəm».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}