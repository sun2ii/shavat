{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["Məzmur 92"]},{"type":"hebrew_subtitle","content":["Məzmur."]},{"type":"hebrew_subtitle","content":["Şənbə günü üçün bir ilahi."]},{"type":"verse","number":1,"content":[{"text":"Nə yaxşıdır Rəbbə şükür etmək,","poem":1},{"lineBreak":true},{"text":"Ey Haqq-Taala, isminə tərənnüm söyləmək,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hər səhər məhəbbətini elan etmək,","poem":1},{"lineBreak":true},{"text":"Hər gecə sədaqətini bəyan etmək,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"On telli alətin avazı ilə,","poem":1},{"lineBreak":true},{"text":"Çəngin, liranın sədası ilə oxumaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Çünki, ya Rəbb, əməllərinlə məni sevindirmisən,","poem":1},{"lineBreak":true},{"text":"Əllərinin işlərinə görə Səni mədh edirəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya Rəbb, Sənin işlərin nə qədər əzəmətlidir,","poem":1},{"lineBreak":true},{"text":"Sənin fikirlərin dərindən dərindir!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nadan insan bunu heç vaxt bilməz,","poem":1},{"lineBreak":true},{"text":"Axmaq insan bunu dərk etməz:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pislər ot kimi bitsə də,","poem":1},{"lineBreak":true},{"text":"Bütün şər iş görənlər çiçəklənsə də,","poem":1},{"lineBreak":true},{"text":"Əbədilik yox olacaqlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amma, ya Rəbb, Sən əbədi ucasan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ya Rəbb, düşmənlərin mütləq qırılacaq,","poem":1},{"lineBreak":true},{"text":"Bütün şər iş görənlər darmadağın olacaq.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sən mənə çöl öküzü kimi güc vermisən,","poem":1},{"lineBreak":true},{"text":"Başıma təzə zeytun yağı","poem":1},{"noteId":10},{"text":"çəkmisən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Düşmənlərimin yerə sərilməsini gözlərimlə gördüm,","poem":1},{"lineBreak":true},{"text":"Bədxahlarımın can verməsini qulaqlarımla eşitdim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Salehlər xurma ağacı kimi göyərir,","poem":1},{"lineBreak":true},{"text":"Livandakı sidr ağacı kimi böyüyür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Onlar Rəbbin evində əkilib,","poem":1},{"lineBreak":true},{"text":"Onlar Allahımızın həyətində göyərir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Qocalanda da bar verəcəklər,","poem":1},{"lineBreak":true},{"text":"Təravətli, yamyaşıl qalacaqlar,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Belə deyəcəklər: «Rəbb haqdır,","poem":1},{"lineBreak":true},{"text":"O mənim qayamdır, Onda haqsızlıq yoxdur».","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Təzə zeytun yağı – xoşbəxtlik rəmzi.","reference":{"chapter":92,"verse":10}}]},"thisChapterLink":"/api/azb_bsa/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}