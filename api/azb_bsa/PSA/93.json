e","number":5,"content":[{"lineBreak":true},{"text":"Ya Rəbb, öyüdlərin tamamilə etibarlıdır,","poem":1},{"lineBreak":true},{"text":"Evinə müqəddəslik əbədi olaraq yaraşır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}