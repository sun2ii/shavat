{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["Məzmur 94"]},{"type":"verse","number":1,"content":[{"text":"Ya Rəbb, qisas alan Allah!","poem":1},{"lineBreak":true},{"text":"Ey qisas alan Allah, nurunu saç!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey dünyanın Hakimi, qalx,","poem":1},{"lineBreak":true},{"text":"Təkəbbürlülərin əvəzini ödə!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya Rəbb, nə vaxtadək pislər –","poem":1},{"lineBreak":true},{"text":"Axı nə vaxtadək pislər sevincdən cuşa gələcəklər?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dillərindən lovğa sözlər tökülür,","poem":1},{"lineBreak":true},{"text":"Bütün şər iş görənlər öyünürlər.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya Rəbb, xalqını əzirlər,","poem":1},{"lineBreak":true},{"text":"Sənin irsindən olan adamlara zülm edirlər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dul qadını və qəribi öldürürlər,","poem":1},{"lineBreak":true},{"text":"Yetimləri qırırlar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Belə deyirlər: «Rəbb heç nə görmür,","poem":1},{"lineBreak":true},{"text":"Yaqubun Allahı heç nə dərk etmir».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dərk edin, ey xalqın nadanları!","poem":1},{"lineBreak":true},{"text":"Ey axmaqlar, nə vaxt ağla gələcəksiniz?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Qulaqları yaradan eşitməzmi?","poem":1},{"lineBreak":true},{"text":"Gözlərə quruluş verən görməzmi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Məgər millətlərə təlim verən,","poem":1},{"lineBreak":true},{"text":"İnsanlara bilik öyrədən tənbeh etməzmi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb insanın düşüncələrini görər,","poem":1},{"lineBreak":true},{"text":"Bunların boş olduğunu bilər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ya Rəbb, bəxtiyar o insandır ki, ona təlim vermisən,","poem":1},{"lineBreak":true},{"text":"Öz qanununu öyrətmisən!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pislər üçün qəbir qazılanadək","poem":1},{"lineBreak":true},{"text":"Onu dar gündən çıxarıb dinclik verəcəksən.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Çünki Rəbb xalqını Özündən ayırmaz,","poem":1},{"lineBreak":true},{"text":"İrsini Öz əlindən verməz.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yenə ədalətli hökmlər çıxarılacaq,","poem":1},{"lineBreak":true},{"text":"Ürəyidüz olanlar haqqın ardınca gedəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kim mənim üçün pislərə qarşı durar?","poem":1},{"lineBreak":true},{"text":"Şər iş görənlərə qarşı kim müdafiəçim olar?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Əgər Rəbb köməyim olmasaydı,","poem":1},{"lineBreak":true},{"text":"Canım sükut diyarına vaxtsız köçərdi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mən «ayağım büdrəyir» deyən zaman,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, mənə məhəbbətinlə dayaqsan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mən daxilən çox narahat olarkən","poem":1},{"lineBreak":true},{"text":"Təsəlli verərək məni fərəhləndirirsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Qanun bəhanəsi ilə şər quran","poem":1},{"lineBreak":true},{"text":"Əzazil hökmdarlardan Sənə yoldaş olarmı?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Əlbir olub salehlərin canına qəsd qururlar,","poem":1},{"lineBreak":true},{"text":"Məhkum edib təqsirsizin qanına bais olurlar.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amma Rəbb mənə qala oldu,","poem":1},{"lineBreak":true},{"text":"Allahım mənə sığınacaq bir qaya oldu!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Pislərin şər işlərini başlarına gətirəcək,","poem":1},{"lineBreak":true},{"text":"Pisliklərinə görə onları yox edəcək,","poem":1},{"lineBreak":true},{"text":"Bəli, Allahımız Rəbb onları yox edəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}