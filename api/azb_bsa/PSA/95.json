{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["Məzmur 95"]},{"type":"verse","number":1,"content":[{"text":"Gəlin Rəbbi mədh edək,","poem":1},{"lineBreak":true},{"text":"Bizi qurtaran Qayaya sevincdən cuşa gələrək nida edək,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Şükür edərək hüzuruna gedək,","poem":1},{"lineBreak":true},{"text":"Cuşa gəlib ilahilərlə Ona nida edək!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Axı Rəbb böyük Allahdır,","poem":1},{"lineBreak":true},{"text":"Bütün allahlar üzərində əzəmətli Padşahdır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yerin dərin qatları Onun əlindədir,","poem":1},{"lineBreak":true},{"text":"Həm də dağların zirvələri Onundur,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onunkudur dəniz, Özü yaratmış,","poem":1},{"lineBreak":true},{"text":"Torpağı əlləri qurmuş!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gəlin Ona səcdə edək, əyilək,","poem":1},{"lineBreak":true},{"text":"Bizi yaradan Rəbbin hüzurunda diz çökək.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Çünki O, Allahımızdır,","poem":1},{"lineBreak":true},{"text":"Biz Onun otlağının xalqıyıq,","poem":1},{"lineBreak":true},{"text":"Əlinin altındakı sürüsüyük.","poem":1},{"lineBreak":true},{"text":"Əgər bu gün Onun səsini eşitsəniz,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Qoy ürəkləriniz","poem":1},{"lineBreak":true},{"text":"Merivada olduğunuz kimi,","poem":1},{"lineBreak":true},{"text":"Səhradakı Massada keçən gündə olduğu kimi inadkar olmasın.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Orada atalarınız Məni sınadılar,","poem":1},{"lineBreak":true},{"text":"Əməllərimi görsələr də, Məni yoxladılar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qırx il o nəsildən zəhləm getdi.","poem":1},{"lineBreak":true},{"text":"Dedim: “Onlar azğın ürəkli xalqdır,","poem":1},{"lineBreak":true},{"text":"Yollarımı tanımır”.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buna görə qəzəblənib and içmişəm:","poem":1},{"lineBreak":true},{"text":"“Onlar Mənim rahatlıq diyarıma girməyəcəklər”».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}