{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"heading","content":["Məzmur 96"]},{"type":"verse","number":1,"content":[{"text":"Rəbbə yeni bir ilahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Ey bütün dünya, Rəbbə ilahi oxuyun,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"İsminə alqış edin, Rəbbə ilahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Xilaskar olduğunu hər gün müjdələyin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ehtişamını millətlərə elan edin,","poem":1},{"lineBreak":true},{"text":"Xariqələrini bütün xalqlara bəyan edin!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Axı Rəbb əzəmətlidir, bol həmdə layiqdir,","poem":1},{"lineBreak":true},{"text":"O bütün allahlardan daha zəhmlidir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bütün özgə xalqların allahları bütlərdir,","poem":1},{"lineBreak":true},{"text":"Lakin göyləri yaradan Rəbdir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ehtişam və əzəmət hüzurundadır,","poem":1},{"lineBreak":true},{"text":"Müqəddəs məkanında gözəlliklə qüdrət var.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ey xalqların tayfaları, Rəbbə verin –","poem":1},{"lineBreak":true},{"text":"İzzəti, qüdrəti Rəbbə verin,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Adına layiq izzəti Rəbbə verin,","poem":1},{"lineBreak":true},{"text":"Həyətinə girib təqdimlər verin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Müqəddəslik zinəti ilə Rəbbə səcdə edin,","poem":1},{"lineBreak":true},{"text":"Ey bütün dünya, Onun hüzurunda lərzəyə gəlin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Millətlərə belə elan edin:","poem":1},{"lineBreak":true},{"text":"«Rəbb hökmranlıq edir,","poem":1},{"lineBreak":true},{"text":"O, dünyanı sarsılmaz və möhkəm qurub,","poem":1},{"lineBreak":true},{"text":"O, insafla xalqların hökmünü verəcək».","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Göylər sevinsin, yer üzü şad olsun,","poem":1},{"lineBreak":true},{"text":"Dənizin və dənizdəki canlıların səsi ucalsın,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çöllər və çöldə yaşayanlar fərəhlənsin,","poem":1},{"lineBreak":true},{"text":"Meşədəki bütün ağaclar mədh söyləsin","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbbin hüzurunda!","poem":1},{"lineBreak":true},{"text":"O gəlir, dünyanın hökmünü vermək üçün gəlir,","poem":1},{"lineBreak":true},{"text":"Yer üzünün hökmünü ədalətlə,","poem":1},{"lineBreak":true},{"text":"Xalqların hökmünü həqiqətlə verəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}