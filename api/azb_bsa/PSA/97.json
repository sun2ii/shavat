{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["Məzmur 97"]},{"type":"verse","number":1,"content":[{"text":"Rəbb hökmranlıq edir, qoy yer üzü şadlıq etsin,","poem":1},{"lineBreak":true},{"text":"Qoy bütün adalar sevinsin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buludlar və zülmət Onun ətrafındadır,","poem":1},{"lineBreak":true},{"text":"Salehliklə ədalət taxtının təməlidir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onun önündən alov çıxar,","poem":1},{"lineBreak":true},{"text":"Ətrafındakı düşmənləri yandırıb-yaxar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Şimşəkləri dünyaya işıq saçar,","poem":1},{"lineBreak":true},{"text":"Yer üzü bunu görəndə sarsılar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dağlar Rəbbin hüzurunda –","poem":1},{"lineBreak":true},{"text":"Bütün yer üzünün Sahibinin hüzurunda mum tək əriyər.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Göylər salehliyini bəyan edər,","poem":1},{"lineBreak":true},{"text":"Əzəmətini bütün xalqlar görər.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bütün bütpərəstlər,","poem":1},{"lineBreak":true},{"text":"Xeyirsiz bütlərlə öyünənlər rüsvay olacaq!","poem":1},{"lineBreak":true},{"text":"Ey bütün allahlar, Rəbbə səcdə edin!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya Rəbb, Sənin hökmlərini","poem":1},{"lineBreak":true},{"text":"Sion eşidib sevinir,","poem":1},{"lineBreak":true},{"text":"Yəhuda qızları cuşa gəlir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki bütün yer üzərində,","poem":1},{"lineBreak":true},{"text":"Ya Rəbb, Haqq-Taala Sənsən!","poem":1},{"lineBreak":true},{"text":"Bütün allahların üzərində","poem":1},{"lineBreak":true},{"text":"Sən nə qədər yüksəksən!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ey Rəbbi sevənlər, şərə nifrət edin!","poem":1},{"lineBreak":true},{"text":"O, möminlərinin canını qoruyar,","poem":1},{"lineBreak":true},{"text":"Onları pislərin əlindən qurtarar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Salehlərin üstünə nur tökülər,","poem":1},{"lineBreak":true},{"text":"Ürəyidüz olanların üstünə sevinc səpilər.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ey salehlər, Rəbbə görə sevinin,","poem":1},{"lineBreak":true},{"text":"Onun müqəddəs adına şükür edin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}