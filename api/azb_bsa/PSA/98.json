{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Məzmur 98"]},{"type":"hebrew_subtitle","content":["Məzmur."]},{"type":"verse","number":1,"content":[{"text":"Rəbbə yeni bir ilahi oxuyun,","poem":1},{"lineBreak":true},{"text":"Çünki O, xariqələr yaratdı.","poem":1},{"lineBreak":true},{"text":"O, sağ əli ilə,","poem":1},{"lineBreak":true},{"text":"Öz müqəddəs qolu ilə zəfərlər qazandı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rəbb zəfərini bəyan etdi,","poem":1},{"lineBreak":true},{"text":"Millətlərin gözündə salehliyini aydın göstərdi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İsrail nəslinə","poem":1},{"lineBreak":true},{"text":"Göstərdiyi məhəbbətini və sədaqətini xatırladı.","poem":1},{"lineBreak":true},{"text":"Yer üzünün qurtaracağınadək hər yerdə","poem":1},{"lineBreak":true},{"text":"Allahımızın zəfərini gördü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ey bütün dünya, cuşa gəlib Rəbbə nida et,","poem":1},{"lineBreak":true},{"text":"Birdən nida edin, mədh, tərənnüm səsini ucaldın!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rəbbi lira ilə –","poem":1},{"lineBreak":true},{"text":"Lira ilə, ilahi bir səslə tərənnüm edin!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kərənay, şeypur səsi ilə,","poem":1},{"lineBreak":true},{"text":"Padşah olan Rəbbin hüzurunda cuşa gəlin,","poem":1},{"lineBreak":true},{"text":"Ona nida edin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Qoy dənizin və dənizdəki canlıların,","poem":1},{"lineBreak":true},{"text":"Yer üzü və orada yaşayanların səsi ucalsın.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onun hüzurunda qoy çaylar əl çalsın,","poem":1},{"lineBreak":true},{"text":"Dağlar birgə mədh oxusun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünki Rəbb dünyaya hökm etmək üçün gəlir.","poem":1},{"lineBreak":true},{"text":"Yer üzünə ədalətlə,","poem":1},{"lineBreak":true},{"text":"Xalqlara insafla hökm edəcək!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}