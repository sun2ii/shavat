{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"PSA","translationId":"azb_bsa","name":"ZƏBUR","commonName":"ZƏBUR","title":"ZƏBUR","order":19,"numberOfChapters":150,"sha256":"756ec278567fa149efd403b9c3d42c623b93ad7776ff89ca34bc42e9ee658e3b","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/azb_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Məzmur 99"]},{"type":"verse","number":1,"content":[{"text":"Rəbb hökmranlıq edir, qoy xalqlar titrəsin,","poem":1},{"lineBreak":true},{"text":"O, keruvlar üstündəki taxtındadır, qoy yer üzü lərzəyə gəlsin!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sionda olan Rəbb əzəmətlidir,","poem":1},{"lineBreak":true},{"text":"O bütün xalqların üzərindədir, yüksəkdədir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qoy böyük, zəhmli adına şükür etsinlər!","poem":1},{"lineBreak":true},{"text":"O müqəddəsdir!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey ədalətsevər güclü Padşah,","poem":1},{"lineBreak":true},{"text":"İnsafı bərqərar edən Sənsən,","poem":1},{"lineBreak":true},{"text":"Yaqub nəslinə ədalət və salehliyi göstərmisən.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allahımız Rəbbi ucaldın,","poem":1},{"lineBreak":true},{"text":"Ayaqlarına düşüb səcdə qılın,","poem":1},{"lineBreak":true},{"text":"O müqəddəsdir!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Onun kahinləri arasında Musa ilə Harun olub,","poem":1},{"lineBreak":true},{"text":"Onun adını çağıranlar arasında Şamuel olub.","poem":1},{"lineBreak":true},{"text":"Onlar Rəbbə yalvararkən","poem":1},{"lineBreak":true},{"text":"O cavab verərdi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bulud sütununun içindən onlarla danışdı,","poem":1},{"lineBreak":true},{"text":"Onun göstərişlərinə,","poem":1},{"lineBreak":true},{"text":"Onlara verdiyi qaydalarına bağlı qaldılar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ya Rəbb Allahımız, Sən onlara cavab verdin,","poem":1},{"lineBreak":true},{"text":"Pis əməllərinin cəzasını versən də,","poem":1},{"lineBreak":true},{"text":"Bağışlayan Allah olduğunu onlara göstərdin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Allahımız Rəbbi ucaldın,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağında Ona səcdə qılın,","poem":1},{"lineBreak":true},{"text":"Çünki Allahımız Rəbb müqəddəsdir!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}