{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"REV","translationId":"azb_bsa","name":"VƏHY","commonName":"VƏHY","title":"YƏHYAYA NAZİL OLAN VƏHY","order":66,"numberOfChapters":22,"sha256":"b3c90f3df99a1fdeaa4c84fb7df33983c7f5e4dc947fec2818533564944b3775","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/azb_bsa/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["Bəla gətirən yeddi mələk"]},{"type":"verse","number":1,"content":["Mən göydə başqa bir böyük və heyrətli əlamət – yeddi bəlanı gətirən yeddi mələk gördüm. Bunlar son bəlalardır, çünki Allahın hiddəti bunlarla tamamlanırdı."]},{"type":"verse","number":2,"content":["Sanki odla qarışıq şüşədən olan bir dəniz gördüm. Vəhşi heyvana, onun surətinə və adına aid saya qalib gələnlər əllərində Allahın verdiyi çənglərlə şüşə dənizin üstündə durub."]},{"type":"verse","number":3,"content":["Onlar Allahın qulu Musanın nəğməsini və Quzunun nəğməsini oxuyaraq deyir:",{"text":"«Ey Külli-İxtiyar Rəbb Allah,","poem":1},{"lineBreak":true},{"text":"Sənin işlərin böyük və heyrətlidir.","poem":1},{"lineBreak":true},{"text":"Ey millətlərin Padşahı,","poem":1},{"noteId":13},{"lineBreak":true},{"text":"Sənin yolların ədalətli və həqiqidir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ya Rəbb, kim Səndən qorxmaz,","poem":1},{"lineBreak":true},{"text":"Kim Sənin adını izzətləndirməz?","poem":1},{"lineBreak":true},{"text":"Çünki yalnız Sən müqəddəssən.","poem":1},{"lineBreak":true},{"text":"Bütün millətlər gəlib","poem":1},{"lineBreak":true},{"text":"Sənin önündə səcdə edəcək,","poem":1},{"lineBreak":true},{"text":"Çünki Sənin ədalətli hökmlərin aşkar oldu».","poem":1}]},{"type":"verse","number":5,"content":["Bundan sonra gördüm ki, göydəki məbəd, yəni Şəhadət çadırı açıldı"]},{"type":"verse","number":6,"content":["və yeddi bəlanı gətirən yeddi mələk məbəddən çıxdı. Onlar təmiz və parlaq kətan paltar geyinmiş, sinələrinə qızıl qurşaqlar bağlamışdı."]},{"type":"verse","number":7,"content":["Onda dörd canlı məxluqdan biri yeddi mələyə əbədi var olan Allahın hiddəti ilə dolu yeddi qızıl nimçə verdi."]},{"type":"verse","number":8,"content":["Məbəd Allahın izzət və qüdrətinə görə tüstü ilə doldu. Beləcə yeddi mələyin gətirdiyi yeddi bəla tamam olana qədər heç kəs məbədə girə bilmədi."]}],"footnotes":[{"noteId":13,"caller":"+","text":"Millətlərin Padşahı – bəzi əlyazmalarda əsrlərin Padşahı.","reference":{"chapter":15,"verse":3}}]},"thisChapterLink":"/api/azb_bsa/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}