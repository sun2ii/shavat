{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"REV","translationId":"azb_bsa","name":"VƏHY","commonName":"VƏHY","title":"YƏHYAYA NAZİL OLAN VƏHY","order":66,"numberOfChapters":22,"sha256":"b3c90f3df99a1fdeaa4c84fb7df33983c7f5e4dc947fec2818533564944b3775","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/azb_bsa/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilin dağılması"]},{"type":"verse","number":1,"content":["Bundan sonra göydən enən başqa bir mələyi gördüm. O, böyük səlahiyyətə malik idi. Yer üzü onun ehtişamı ilə işıqlandı."]},{"type":"verse","number":2,"content":["O, uca səslə nida edib dedi:",{"text":"«Dağıldı! Böyük Babil dağıldı!","poem":1},{"lineBreak":true},{"text":"O, cinlərin məskəni,","poem":1},{"lineBreak":true},{"text":"Hər cür natəmiz ruhun sığınacağı,","poem":1},{"lineBreak":true},{"text":"Hər cür murdar quşun yuvası,","poem":1},{"lineBreak":true},{"text":"Hər cür murdar və mənfur vəhşi heyvanın oylağı oldu.","poem":1},{"noteId":15}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünki bütün millətlər","poem":1},{"lineBreak":true},{"text":"O qadının coşğun əxlaqsızlıq şərabından içdi.","poem":1},{"noteId":16},{"lineBreak":true},{"text":"Yer üzünün padşahları","poem":1},{"lineBreak":true},{"text":"Onunla əxlaqsızlıq etdi.","poem":1},{"lineBreak":true},{"text":"Dünyanın tacirləri","poem":1},{"lineBreak":true},{"text":"Onun şəhvətpərəstliyi ilə qazanılan sərvətdən varlandı».","poem":1}]},{"type":"verse","number":4,"content":["Mən göydən belə deyən başqa bir səs də eşitdim:",{"text":"«Ey Mənim xalqım, oradan çıxın ki,","poem":1},{"lineBreak":true},{"text":"Onun günahlarına şərik olmayasınız,","poem":1},{"lineBreak":true},{"text":"Onun uğrayacağı bəlalara düçar olmayasınız.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Çünki onun günahları qalaqlanıb göyə çatdı,","poem":1},{"lineBreak":true},{"text":"Allah onun haqsız işlərini yada saldı.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O nə etdisə,","poem":1},{"noteId":17},{"lineBreak":true},{"text":"Siz də əvəzində ona belə edin.","poem":1},{"lineBreak":true},{"text":"Əməllərinin əvəzini ona ikiqat verin.","poem":1},{"lineBreak":true},{"text":"Tökdüyü kasadakı şərabın","poem":1},{"lineBreak":true},{"text":"İkiqatını töküb ona verin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Özünü nə qədər izzətləndirib","poem":1},{"lineBreak":true},{"text":"Şəhvətpərəstlik içində yaşadısa,","poem":1},{"lineBreak":true},{"text":"Ona o qədər də işgəncə və yas verin.","poem":1},{"lineBreak":true},{"text":"Çünki ürəyində deyir:","poem":1},{"lineBreak":true},{"text":"“Mən mələkə taxtında oturmuşam,","poem":1},{"lineBreak":true},{"text":"Dul deyiləm, əsla yas tutmayacağam”.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buna görə də bir günün içində","poem":1},{"lineBreak":true},{"text":"Onun üstünə bəlalar gələcək,","poem":1},{"lineBreak":true},{"text":"Azara, yasa, aclığa düçar olacaq, odda yandırılacaq.","poem":1},{"lineBreak":true},{"text":"Çünki onu mühakimə edən Rəbb Allah qüdrətlidir».","poem":1}]},{"type":"verse","number":9,"content":["Onunla əxlaqsızlıq edən və şəhvətpərəstlik içində yaşayan yer üzünün padşahları onun yanğınından çıxan tüstünü görəndə onun üçün ağlayıb ah-nalə edəcəklər."]},{"type":"verse","number":10,"content":["Onun çəkdiyi işgəncənin qorxusundan uzaqda dayanıb deyəcəklər:",{"text":"«Vay, vay halına, böyük şəhər,","poem":1},{"lineBreak":true},{"text":"Möhkəm şəhər Babil!","poem":1},{"lineBreak":true},{"text":"Çünki bir saat içində cəzan çatdı».","poem":1}]},{"type":"verse","number":11,"content":["Yer üzünün tacirləri də onun üçün ağlayıb yas tutur, çünki onların malını –"]},{"type":"verse","number":12,"content":["qızıl, gümüş, qiymətli daşlar və mirvariləri; incə kətan, ipək, tünd qırmızı və al rəngli parçaları; hər cür ətirli ağacı; fil sümüyündən, ən qiymətli ağacdan, tuncdan, dəmirdən və mərmərdən olan hər cür əşyanı;"]},{"type":"verse","number":13,"content":["darçın, hil,",{"noteId":18},"buxur, ətirli yağ və kündürü; şərab, zeytun yağı, narın un və buğdanı; mal-qara, qoyunlar, atlar və arabaları; insan bədənləri və canlarını da artıq heç kəs almır."]},{"type":"verse","number":14,"content":["Onlar deyirlər:",{"text":"«Ürəyinin arzuladığı bəhrələr əlindən çıxdı,","poem":1},{"lineBreak":true},{"text":"Bütün cah-calallı malların yox oldu.","poem":1},{"lineBreak":true},{"text":"Heç kəs onları bir daha tapmayacaq».","poem":1}]},{"type":"verse","number":15,"content":["Orada bu mallarla varlanan tacirlər bu şəhərin çəkdiyi işgəncənin qorxusundan uzaqda dayanacaq və ağlayıb yas tutaraq deyəcəklər:"]},{"type":"verse","number":16,"content":[{"text":"«Vay, vay halına,","poem":1},{"lineBreak":true},{"text":"İncə kətan, tünd qırmızı, al rəngli","poem":1},{"lineBreak":true},{"text":"Parçalardan paltar geyən,","poem":1},{"lineBreak":true},{"text":"Qızıl, qiymətli daşlar və mirvarilərlə","poem":1},{"lineBreak":true},{"text":"Bəzənən böyük şəhər!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki bu qədər var-dövlət","poem":1},{"lineBreak":true},{"text":"Bir saat içində viran oldu».","poem":1},"Bütün gəmi rəisləri, sərnişinlər, dənizçilər və dənizdə ticarət edənlərin hamısı uzaqda dayanaraq"]},{"type":"verse","number":18,"content":["onun yanğınından çıxan tüstüyə baxıb nida edirdilər: «Hansı şəhər bu böyük şəhərə tay ola bilər?»"]},{"type":"verse","number":19,"content":["Onlar başlarına toz töküb fəryad edir və ağlayıb yas tutaraq deyirdilər:",{"text":"«Vay, vay halına,","poem":1},{"lineBreak":true},{"text":"Dənizdə gəmisi olanların hamısının","poem":1},{"lineBreak":true},{"text":"Oranın çox qiymətli malları ilə","poem":1},{"lineBreak":true},{"text":"Varlandığı böyük şəhər!","poem":1},{"lineBreak":true},{"text":"Çünki bir saat içində viran oldun».","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ey göylər,","poem":1},{"lineBreak":true},{"text":"Müqəddəslər, həvarilər və peyğəmbərlər,","poem":1},{"lineBreak":true},{"text":"Onun halını bayram edin!","poem":1},{"lineBreak":true},{"text":"Onun sizin üçün çıxartdığı hökmü","poem":1},{"lineBreak":true},{"text":"Allah onun öz başına gətirdi.","poem":1}]},{"type":"verse","number":21,"content":["Bir güclü mələk dəyirman daşı boyda böyük bir daşı götürərək dənizə atıb dedi:",{"text":"«Böyük şəhər Babil də","poem":1},{"lineBreak":true},{"text":"Belə zorakılıqla yıxılacaq,","poem":1},{"lineBreak":true},{"text":"Bir daha görünməyəcək.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Çəng çalanların, müğənnilərin,","poem":1},{"lineBreak":true},{"text":"Tütək və şeypur çalanların səsi","poem":1},{"lineBreak":true},{"text":"Artıq səndən gəlməyəcək.","poem":1},{"lineBreak":true},{"text":"Hər cür sənətlə məşğul olan sənətkar","poem":1},{"lineBreak":true},{"text":"Artıq səndə olmayacaq.","poem":1},{"lineBreak":true},{"text":"Dəyirman səsi də","poem":1},{"lineBreak":true},{"text":"Artıq səndən gəlməyəcək.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Çıraq işığı","poem":1},{"lineBreak":true},{"text":"Artıq səndə görünməyəcək.","poem":1},{"lineBreak":true},{"text":"Bəy-gəlin sədası","poem":1},{"lineBreak":true},{"text":"Artıq səndən gəlməyəcək.","poem":1},{"lineBreak":true},{"text":"Çünki sənin tacirlərin","poem":1},{"lineBreak":true},{"text":"Yer üzünün böyük adamları idi,","poem":1},{"lineBreak":true},{"text":"Bütün millətlər","poem":1},{"lineBreak":true},{"text":"Sənin sehrbazlığınla aldanmışdı.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Peyğəmbərlərin, müqəddəslərin və","poem":1},{"lineBreak":true},{"text":"Yer üzündə kəsilənlərin hamısının qanı","poem":1},{"lineBreak":true},{"text":"O şəhərdə üzə çıxdı».","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Hər cür murdar quşun … oylağı oldu – bəzi əlyazmalarda Hər cür murdar və mənfur quşun yuvası oldu.","reference":{"chapter":18,"verse":2}},{"noteId":16,"caller":"+","text":"İçdi – bəzi əlyazmalarda içib dağıldı.","reference":{"chapter":18,"verse":3}},{"noteId":17,"caller":"+","text":"O nə etdisə – bəzi əlyazmalarda O sizə nə etdisə.","reference":{"chapter":18,"verse":6}},{"noteId":18,"caller":"+","text":"Hil – bəzi əlyazmalarda bu söz yoxdur.","reference":{"chapter":18,"verse":13}}]},"thisChapterLink":"/api/azb_bsa/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}