{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"REV","translationId":"azb_bsa","name":"VƏHY","commonName":"VƏHY","title":"YƏHYAYA NAZİL OLAN VƏHY","order":66,"numberOfChapters":22,"sha256":"b3c90f3df99a1fdeaa4c84fb7df33983c7f5e4dc947fec2818533564944b3775","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/azb_bsa/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["Möhürlənmiş şəxslər"]},{"type":"verse","number":1,"content":["Bundan sonra mən yer üzünün dörd küncündə dayanan dörd mələk gördüm. Onlar yer üzünün dörd küləyini tutmuşdular ki, nə quru, nə dəniz və nə də bir ağac üstünə yel əssin."]},{"type":"verse","number":2,"content":["Gündoğan tərəfdən qalxan başqa bir mələk də gördüm ki, var olan Allahın möhürünə malik idi. O, uca səslə quruya və dənizə ziyan vurmaq izni verilmiş dörd mələyi çağırıb dedi:"]},{"type":"verse","number":3,"content":["«Biz Allahımızın qullarının alnını möhürləyənə qədər quruya, dənizə və ağaclara ziyan vurmayın»."]},{"type":"verse","number":4,"content":["Möhürlənmiş şəxslərin sayını da eşitdim; İsrail övladlarının bütün qəbilələrindən 144 000 nəfər möhürlənmişdi:"]},{"type":"verse","number":5,"content":[{"text":"Yəhuda qəbiləsindən 12 000 möhürlənmiş nəfər;","poem":1},{"lineBreak":true},{"text":"Ruven qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Qad qəbiləsindən 12 000 nəfər;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aşer qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Naftali qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Menaşşe qəbiləsindən 12 000 nəfər;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şimeon qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Levi qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"İssakar qəbiləsindən 12 000 nəfər;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zevulun qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Yusif qəbiləsindən 12 000 nəfər;","poem":1},{"lineBreak":true},{"text":"Binyamin qəbiləsindən 12 000 möhürlənmiş nəfər.","poem":1}]},{"type":"verse","number":9,"content":["Bundan sonra mən gördüm ki, hər millətdən, hər tayfadan, hər xalqdan və hər dildən olan, heç kəsin saya bilməyəcəyi böyük bir kütlə taxtın və Quzunun önündə dayanıb. Onlar ağ xalat geyinib, əllərində xurma budaqları tutublar."]},{"type":"verse","number":10,"content":["Uca səslə nida edirdilər:",{"text":"«Xilas taxtda oturan Allahımıza və Quzuya məxsusdur!»","poem":1}]},{"type":"verse","number":11,"content":["Bütün mələklər də taxtın, ağsaqqalların və dörd canlı məxluqun ətrafında dayanmışdı. Onlar taxtın önündə üzüstə yerə qapanaraq Allaha səcdə edib dedilər:"]},{"type":"verse","number":12,"content":[{"text":"«Amin! Allahımıza əbədi olaraq","poem":1},{"lineBreak":true},{"text":"Alqış, izzət, hikmət, şükür, şərəf,","poem":1},{"lineBreak":true},{"text":"Qüdrət və qüvvət olsun! Amin!»","poem":1}]},{"type":"verse","number":13,"content":["Bu arada ağsaqqallardan biri məndən soruşdu: «Ağ xalat geyinmiş bu şəxslər kimdir və haradan gəliblər?»"]},{"type":"verse","number":14,"content":["Ona dedim: «Ağa, bunu sən bilərsən». O mənə dedi: «Bunlar böyük əziyyətdən keçib gələnlərdir. Onlar öz xalatlarını yuyub Quzunun qanı ilə ağartdılar."]},{"type":"verse","number":15,"content":["Buna görə də",{"text":"Onlar Allahın taxtının önündədir,","poem":1},{"lineBreak":true},{"text":"Gecə-gündüz məbədində Ona ibadət edirlər.","poem":1},{"lineBreak":true},{"text":"Taxtda Oturan da","poem":1},{"lineBreak":true},{"text":"Onların üzərində məskən salacaq.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Onlar bir daha nə ac,","poem":1},{"lineBreak":true},{"text":"Nə də susuz qalacaq,","poem":1},{"lineBreak":true},{"text":"Günəş və qızmar isti","poem":1},{"lineBreak":true},{"text":"Onları vurmayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Çünki taxtın ortasında olan Quzu","poem":1},{"lineBreak":true},{"text":"Onların Çobanı olacaq,","poem":1},{"lineBreak":true},{"text":"Onları həyat suyunun qaynaqlarına aparacaq,","poem":1},{"lineBreak":true},{"text":"Allah onların bütün göz yaşlarını siləcək».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}