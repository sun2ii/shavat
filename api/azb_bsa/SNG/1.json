{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Bu nəğmələr nəğməsi Süleymanındır.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Qoy dodaqların məni öpdükcə öpsün,","poem":1},{"lineBreak":true},{"text":"Çünki eşqin şərabdan da yaxşıdır.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vurduğun ətrin qoxusu nə gözəldir,","poem":1},{"lineBreak":true},{"text":"Adın belə, ətirqabıdan tökülən ətri xatırladır,","poem":1},{"lineBreak":true},{"text":"Ona görə qızların sevimlisi olmusan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bağrına bas məni, səninlə qaçaq,","poem":1},{"lineBreak":true},{"text":"Qoy padşah məni otağına aparsın.","poem":1},"Qızın rəfiqələri:",{"text":"Səninlə sevinib biz şadlanarıq,","poem":1},{"lineBreak":true},{"text":"Şərabdan da artıq eşqinizi anarıq.","poem":1},"Qız:",{"text":"Sənə heyran olanlar haqlıdır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ey Yerusəlimdəki qızlar,","poem":1},{"lineBreak":true},{"text":"Qedar çadırları tək,","poem":1},{"lineBreak":true},{"text":"Süleymanın pərdələri tək","poem":1},{"lineBreak":true},{"text":"Qaralsam da mən,","poem":1},{"lineBreak":true},{"text":"Yenə gözələm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baxmayın ki, mən qarayanızam,","poem":1},{"lineBreak":true},{"text":"Günəşdən qaralmışam,","poem":1},{"lineBreak":true},{"text":"Qardaşlarımın mənə qəzəbi tutarkən","poem":1},{"lineBreak":true},{"text":"Məni üzümlüklərinə qarovulçu qoydular.","poem":1},{"lineBreak":true},{"text":"Mən də öz üzümlüyümə baxa bilmədim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey könlümün sevgilisi, söylə mənə:","poem":1},{"lineBreak":true},{"text":"Sürünü harada otarırsan?","poem":1},{"lineBreak":true},{"text":"Günorta sürünü harada yatırırsan?","poem":1},{"lineBreak":true},{"text":"Niyə sənin dostlarının sürülərinin yanında gedən,","poem":1},{"lineBreak":true},{"text":"Üz-gözünü bürüyən bir qadına bənzəyim?","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ey gözəllər gözəli, əgər yerini tapa bilməsən,","poem":1},{"lineBreak":true},{"text":"Sürülərin izi ilə get,","poem":1},{"lineBreak":true},{"text":"Oğlaqlarını çoban çadırlarının yanında otar.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Ey yarım, sən","poem":1},{"lineBreak":true},{"text":"Fironun arabalarını çəkən","poem":1},{"lineBreak":true},{"text":"Gözəl madyana bənzəyirsən.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yanağına düşən bəzəklərlə,","poem":1},{"lineBreak":true},{"text":"Boynundakı daş-qaşdan olan boyunbağı ilə","poem":1},{"lineBreak":true},{"text":"Bax nə qədər gözəlsən.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sənə düymələri gümüşdən","poem":1},{"lineBreak":true},{"text":"Qızıl silsilə düzəldəcəyik.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Padşah süfrəsində oturarkən","poem":1},{"lineBreak":true},{"text":"Hər yanı nard çiçəyimin ətri bürüyür.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mənim üçün sevgilim","poem":1},{"lineBreak":true},{"text":"Döşlərimin arasında yatan mirra kisəsidir.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mənim üçün sevgilim","poem":1},{"lineBreak":true},{"text":"En-Gedinin üzüm bağlarındakı bir dəstə xınagülüdür.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Ey yarım, nə gözəlsən, nə gözəlsən!","poem":1},{"lineBreak":true},{"text":"Göyərçin gözlüsən!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ey sevgilim, nə gözəlsən,","poem":1},{"lineBreak":true},{"text":"Sən nə qədər şirinsən!","poem":1},{"lineBreak":true},{"text":"Yaşıldır yatağımız.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Evlərimizin dirəkləri sidr ağacındandır,","poem":1},{"lineBreak":true},{"text":"Tavanımızın oymaları şam ağacındandır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}