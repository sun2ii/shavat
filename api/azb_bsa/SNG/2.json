{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mən Şaron nərgiziyəm,","poem":1},{"lineBreak":true},{"text":"Dərələrdə bitən zanbağam.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mənim yarım qızlar arasındadır,","poem":1},{"lineBreak":true},{"text":"Elə bil bir zanbaq tikanlar arasındadır.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mənim sevgilim oğlanlar arasındadır,","poem":1},{"lineBreak":true},{"text":"Meşədəki ağaclar arasında alma ağacına oxşayır.","poem":1},{"lineBreak":true},{"text":"Kölgəsində oturmaqdan zövq alıram,","poem":1},{"lineBreak":true},{"text":"Meyvəsinin dadı damağımdan getmir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O məni ziyafət evinə apardı,","poem":1},{"lineBreak":true},{"text":"Sevgisi bayraq kimi üzərimdə dalğalanır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən eşq xəstəsiyəm,","poem":1},{"lineBreak":true},{"text":"Kişmiş verin, qüvvətlənim,","poem":1},{"lineBreak":true},{"text":"Alma verin, cana gəlim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sevgilim sol əlini başımın altına salır,","poem":1},{"lineBreak":true},{"text":"Sağ əli ilə məni qucağına alır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ey Yerusəlimdəki qızlar, sizi and verirəm","poem":1},{"lineBreak":true},{"text":"Dişi ceyranlara, çöldəki marallara!","poem":1},{"lineBreak":true},{"text":"Bizi bu sevgidən oyatmayın, ayıltmayın,","poem":1},{"lineBreak":true},{"text":"Qoy könül istəyənəcən qalsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bu, sevgilimin hənirtisidir!","poem":1},{"lineBreak":true},{"text":"O, dağlardan aşaraq, təpələrdən sıçrayaraq gəlir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sevgilim ahuya, maral balasına oxşayır,","poem":1},{"lineBreak":true},{"text":"Budur, hasarımızın o tayında dayanır,","poem":1},{"lineBreak":true},{"text":"Pəncərələrdən boylanır, barmaqlıqlardan baxır.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mənə belə dedi sevgilim:","poem":1},{"lineBreak":true},{"text":"«Dur gəl, yarım, gözəlim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Budur, artıq qış keçib,","poem":1},{"lineBreak":true},{"text":"Yağıntılar kəsilib.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hər yanda güllər bitib,","poem":1},{"lineBreak":true},{"text":"Nəğmə oxumağın zamanı yetib,","poem":1},{"lineBreak":true},{"text":"Qumrunun səsi torpağı bürüyüb.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Əncir yaşıl bar gətirib,","poem":1},{"lineBreak":true},{"text":"Üzüm çiçəklənib ətrini saçır.","poem":1},{"lineBreak":true},{"text":"Dur gəl, yarım, gözəlim!»","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ey gözəl göyərçinim,","poem":1},{"lineBreak":true},{"text":"Sanki sal qayalarda, sıldırımlarda gizlənmisən.","poem":1},{"lineBreak":true},{"text":"Qoy üzünü görüm, səsini eşidim,","poem":1},{"lineBreak":true},{"text":"Çünki şirin səsli, gözəl surətlisən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tülküləri, kiçik tülküləri tutun,","poem":1},{"lineBreak":true},{"text":"Üzümlükləri korlamağa qoymayın,","poem":1},{"lineBreak":true},{"text":"Çünki bağlarımız çiçəklənib.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Sevgilim mənimdir, mən də onunam,","poem":1},{"lineBreak":true},{"text":"O, sürüsünü zanbaqlıq içərisində otarır.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gün sərinləşənəcən, kölgələr düşənəcən,","poem":1},{"lineBreak":true},{"text":"Ey sevgilim, geri qayıt,","poem":1},{"lineBreak":true},{"text":"Şişuclu dağların qoynunda olan","poem":1},{"lineBreak":true},{"text":"Ahuya, maral balasına bənzərsən.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}