{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Yatağımda bütün gecə","poem":1},{"lineBreak":true},{"text":"Könlümün sevgilisini axtardım,","poem":1},{"lineBreak":true},{"text":"Axtardım, amma tapa bilmədim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dedim: «Qoy könlümün sevgilisini axtarım,","poem":1},{"lineBreak":true},{"text":"Durub şəhəri dolaşım,","poem":1},{"lineBreak":true},{"text":"Küçələrdə, meydanlarda axtarım».","poem":1},{"lineBreak":true},{"text":"Axtardım, amma tapa bilmədim.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Şəhər asayişini qoruyanlar məni tapdı,","poem":1},{"lineBreak":true},{"text":"Onlardan soruşdum: «Könlümün sevgilisini görməmisiniz ki?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onlardan ayrılanda könlümün sevgilisini tapdım,","poem":1},{"lineBreak":true},{"text":"Tutub onu buraxmadım.","poem":1},{"lineBreak":true},{"text":"Onu anamın evinə –","poem":1},{"lineBreak":true},{"text":"Məni doğan qadının otağına apardım.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ey Yerusəlimdəki qızlar, sizi and verirəm","poem":1},{"lineBreak":true},{"text":"Dişi ceyranlara, çöldəki marallara!","poem":1},{"lineBreak":true},{"text":"Bizi bu sevgidən oyatmayın, ayıltmayın,","poem":1},{"lineBreak":true},{"text":"Qoy könül istəyənəcən qalsın.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Səhradan keçən,","poem":1},{"lineBreak":true},{"text":"Tüstü sütunları kimi gələn,","poem":1},{"lineBreak":true},{"text":"Tacirlərin ətirli bitkiləri içərisində","poem":1},{"lineBreak":true},{"text":"Mirra və kündür ətri verən kimdir?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Budur Süleymanın taxt-rəvanı!","poem":1},{"lineBreak":true},{"text":"Ətrafını İsrail igidlərindən altmışı bürüyüb.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onların hamısı qılınc daşıyır,","poem":1},{"lineBreak":true},{"text":"Mahir döyüşçüdür,","poem":1},{"lineBreak":true},{"text":"Hər biri qılıncını belinə bağlayıb,","poem":1},{"lineBreak":true},{"text":"Təhlükəli gecələr üçün hazırlanıb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Taxt-rəvanını padşah Süleyman","poem":1},{"lineBreak":true},{"text":"Livanın ağaclarından düzəltdirib.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sütunları gümüşdən, söykənəcəyi qızıldan,","poem":1},{"lineBreak":true},{"text":"Oturacağı tünd qırmızı qumaşdan düzəltdirib,","poem":1},{"lineBreak":true},{"text":"Yerusəlim qızları bu qumaşa zövqlə naxış vurub.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey Sion qızları, çıxın,","poem":1},{"lineBreak":true},{"text":"Padşah Süleymana baxın!","poem":1},{"lineBreak":true},{"text":"O, toy günündə, ürəkdən sevindiyi gündə","poem":1},{"lineBreak":true},{"text":"Başına anasının verdiyi tacı qoyub!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}