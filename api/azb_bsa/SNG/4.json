{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ey yarım, nə gözəlsən, nə gözəlsən,","poem":1},{"lineBreak":true},{"text":"Yaşmaq altda gözlərin göyərçinə oxşayır,","poem":1},{"lineBreak":true},{"text":"Saçların Gilead dağının yamaclarından","poem":1},{"lineBreak":true},{"text":"Tökülən keçi sürüsü tək qapqaradır.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dişlərin qırxılmış, yenicə yuyunub çıxan qoyun sürüsü tək düzülüb,","poem":1},{"lineBreak":true},{"text":"Bu qoyunların hamısının əkiz balası var,","poem":1},{"lineBreak":true},{"text":"Aralarında balasız olanı yoxdur.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dodaqların qırmızı qaytan kimi aldır,","poem":1},{"lineBreak":true},{"text":"Dilin nə qədər şirindir,","poem":1},{"lineBreak":true},{"text":"Kəsilmiş nar kimi yaşmaqladığın yanaqlarından qan damır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boynun sursat üçün tikilmiş Davud qülləsi kimi vüqarlıdır,","poem":1},{"lineBreak":true},{"text":"Sanki buradan pəhləvan qalxanı olan min sipər asılmışdır.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Döşlərin cüt ceyran balası kimi qoşadır,","poem":1},{"lineBreak":true},{"text":"Zanbaqlıqda otlayan əkiz maral balasına oxşayır.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gün sərinləşənəcən, kölgələr düşənəcən,","poem":1},{"lineBreak":true},{"text":"Mirra dağına, kündür təpəsinə gedəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Təpədən dırnağa qədər gözəlsən,","poem":1},{"lineBreak":true},{"text":"Yarım, tamamilə eyibsizsən.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ay gəlin, Livan bölgəsindən mənimlə gəl,","poem":1},{"lineBreak":true},{"text":"Gəl, Livandan mənimlə gəl.","poem":1},{"lineBreak":true},{"text":"Amana təpəsindən, Senir, Xermon təpələrindən, dağlardan,","poem":1},{"lineBreak":true},{"text":"Aslanlar yurdundan, dağlardan, bəbirlər məskənindən en.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ay həmdəmim, ay gəlin!","poem":1},{"lineBreak":true},{"text":"Bir baxışınla qəlbimi aldın.","poem":1},{"lineBreak":true},{"text":"Ləl-cəvahiratı boynuna saldın,","poem":1},{"lineBreak":true},{"text":"Gözəlliyinlə qəlbimi aldın.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ay həmdəmim, ay gəlin!","poem":1},{"lineBreak":true},{"text":"Sevgin necə gözəldir,","poem":1},{"lineBreak":true},{"text":"Eşqin şərabdan da ləzzətlidir,","poem":1},{"lineBreak":true},{"text":"Sənin ətrin ətirlərin ən gözəlidir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ay gəlin, dodaqlarından şanı balı axır,","poem":1},{"lineBreak":true},{"text":"Bal və süd sənin dilinin altındadır.","poem":1},{"lineBreak":true},{"text":"Paltarlarından Livanın ətri gəlir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ay həmdəmim, ay gəlin!","poem":1},{"lineBreak":true},{"text":"Bir qapısı bağlı bağçasan,","poem":1},{"lineBreak":true},{"text":"Örtülü bir bulaq, möhürlənmiş bulaqsan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sənin fidanların nar bağçasına oxşayır,","poem":1},{"lineBreak":true},{"text":"Elə bil cənnətdir, orada seçmə meyvələr,","poem":1},{"lineBreak":true},{"text":"Xına və nard çiçəkləri var.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nard çiçəyi və zəfəran,","poem":1},{"lineBreak":true},{"text":"Ətirli qamışla darçınlar,","poem":1},{"lineBreak":true},{"text":"Hər cür buxur ağacı,","poem":1},{"lineBreak":true},{"text":"Mirralar və əzvaylar,","poem":1},{"lineBreak":true},{"text":"Hər cür seçmə ətriyyat var.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sən bağçaların bulağısan,","poem":1},{"lineBreak":true},{"text":"Canlı su qaynağısan,","poem":1},{"lineBreak":true},{"text":"Livanın axar suyusan.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Oyan, ey şimal küləyi,","poem":1},{"lineBreak":true},{"text":"Dur gəl, ey cənub küləyi,","poem":1},{"lineBreak":true},{"text":"Gəlin mənim bağçamda əsin,","poem":1},{"lineBreak":true},{"text":"Qoy o, ətrini hər yana versin.","poem":1},{"lineBreak":true},{"text":"Sevgilim öz bağçasına gəlsin,","poem":1},{"lineBreak":true},{"text":"Seçmə meyvələrdən yesin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}