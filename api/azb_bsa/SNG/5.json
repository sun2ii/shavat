{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ay həmdəmim, ay gəlin! Öz bağçama girmişəm,","poem":1},{"lineBreak":true},{"text":"Ətriyyatlarımla mirramı yığmışam.","poem":1},{"lineBreak":true},{"text":"Şanı balını – öz balımı yemişəm,","poem":1},{"lineBreak":true},{"text":"Şərabımı və südümü içmişəm.","poem":1},"Qızın rəfiqələri:",{"text":"Ay dostlar, yeyin,","poem":1},{"lineBreak":true},{"text":"Ay sevgililər, için, doyunca için!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Yatsam da, qəlbim oyaq idi.","poem":1},{"lineBreak":true},{"text":"Qapını döyən sevgilimin səsi gəldi:","poem":1},{"lineBreak":true},{"text":"«Qapını aç, ay həmdəmim, ay yarım!","poem":1},{"lineBreak":true},{"text":"Ay göyərçinim, ay eyibsizim!","poem":1},{"lineBreak":true},{"text":"İslandı başım şehdən,","poem":1},{"lineBreak":true},{"text":"Saçım gecənin nəmindən».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Soyunmuşam paltarımı,","poem":1},{"lineBreak":true},{"text":"Geyinimmi təzədən?","poem":1},{"lineBreak":true},{"text":"Yumuşam ayaqlarımı,","poem":1},{"lineBreak":true},{"text":"Bulaşdırımmı yenidən?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sevgilim əlini qapının deşiyindən uzatdı,","poem":1},{"lineBreak":true},{"text":"Onun üçün mənim köksüm oynadı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mən sevgilim üçün qapı açmağa qalxdım,","poem":1},{"lineBreak":true},{"text":"Əllərimə mirra damdı,","poem":1},{"lineBreak":true},{"text":"Barmaqlarımdan süzüldü,","poem":1},{"lineBreak":true},{"text":"Cəftə üstə töküldü.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mən sevgilimə qapı açanda","poem":1},{"lineBreak":true},{"text":"Sevgilim çıxıb getmişdi.","poem":1},{"lineBreak":true},{"text":"O məni çağıranda huşumu itirmişdim.","poem":1},{"lineBreak":true},{"text":"Mən onu axtardım, tapa bilmədim,","poem":1},{"lineBreak":true},{"text":"Mən onu çağırdım, lakin cavab gəlmədi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Şəhər asayişini qoruyanlar məni tapdılar,","poem":1},{"lineBreak":true},{"text":"Döyüb bədənimi yaraladılar,","poem":1},{"lineBreak":true},{"text":"Hasar keşikçiləri örpəyimi açdılar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ey Yerusəlimdəki qızlar, mən sizə and verirəm,","poem":1},{"lineBreak":true},{"text":"Tapsanız sevgilimi, deyin ona: «Mən eşq xəstəsiyəm».","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Ey gözəllər gözəli,","poem":1},{"lineBreak":true},{"text":"Sevgilinin digərlərindən fərqi nədir?","poem":1},{"lineBreak":true},{"text":"Onu fərqləndirən nədir?","poem":1},{"lineBreak":true},{"text":"Axı niyə bizə belə and verirsən?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Sevgilim nur saçır, əlvan rənglidir,","poem":1},{"lineBreak":true},{"text":"O, on minlərin arasından seçilir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Başı sanki saf qızıldır,","poem":1},{"lineBreak":true},{"text":"Qıvrım saçı qara qarğa tək qaradır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gözləri axar sular kənarındakı göyərçinlərə oxşayır,","poem":1},{"lineBreak":true},{"text":"Süd içində yuyunmuşlar,","poem":1},{"lineBreak":true},{"text":"Öz yuvasında cəvahir tək görünərlər.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yanaqları ətirli gülüstana oxşayır,","poem":1},{"lineBreak":true},{"text":"Hər yana ətir saçır,","poem":1},{"lineBreak":true},{"text":"Dodaqları zanbaqlara bənzəyir,","poem":1},{"lineBreak":true},{"text":"Ondan mirra tökülür.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Əlləri sanki sarı yaqutla bəzənən qızıl budaqdır,","poem":1},{"lineBreak":true},{"text":"Qaməti sanki yaqutlarla naxışlanan fil dişidir.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Qıçları saf qızıl ayaqlıqlar üstündə dayanan","poem":1},{"lineBreak":true},{"text":"Mərmər sütunlara oxşar.","poem":1},{"lineBreak":true},{"text":"Görkəmi Livanın dağları kimidir,","poem":1},{"lineBreak":true},{"text":"Nadir sidr ağacları kimidir.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Şirindillidir,","poem":1},{"lineBreak":true},{"text":"Təpədən dırnağadək gözəldir.","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlimdəki qızlar, mənim sevgilim budur,","poem":1},{"lineBreak":true},{"text":"Mənim yarım budur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}