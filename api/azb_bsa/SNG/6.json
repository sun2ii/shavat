{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Ey gözəllər gözəli, sevgilin hara gedib?","poem":1},{"lineBreak":true},{"text":"O hansı yana dönüb?","poem":1},{"lineBreak":true},{"text":"Səninlə birgə onu axtarmağa gedək.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Sevgilim öz bağçasına –","poem":1},{"lineBreak":true},{"text":"Ətirli gülüstana gedib,","poem":1},{"lineBreak":true},{"text":"Bağçalarda sürüsünü otarmağa,","poem":1},{"lineBreak":true},{"text":"Zanbaq gülü toplamağa gedib.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mən sevgilimin, sevgilim də mənimdir,","poem":1},{"lineBreak":true},{"text":"O, sürüsünü zanbaqlıq içərisində otarır.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Ey yarım, sən","poem":1},{"lineBreak":true},{"text":"Tirsa şəhəri qədər gözəlsən,","poem":1},{"lineBreak":true},{"text":"Yerusəlim kimi sevimlisən,","poem":1},{"lineBreak":true},{"text":"Müzəffər ordu kimi möhtəşəmsən.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gözlərini məndən ayır,","poem":1},{"lineBreak":true},{"text":"Onlar məni mat qoyur.","poem":1},{"lineBreak":true},{"text":"Saçların Gilead dağının yamaclarından","poem":1},{"lineBreak":true},{"text":"Tökülən keçi sürüsü tək qapqaradır.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dişlərin yenicə yuyunub çıxan qoyun sürüsü tək düzülüb,","poem":1},{"lineBreak":true},{"text":"Bu qoyunların hamısının əkiz balası var,","poem":1},{"lineBreak":true},{"text":"Aralarında balasız olanı yoxdur.","poem":1}]},{"type":"verse","number":7,"content":["Kəsilmiş nar kimi yaşmaqladığın yanaqlarından qan damır."]},{"type":"verse","number":8,"content":[{"text":"Altmış mələkə var,","poem":1},{"lineBreak":true},{"text":"Cariyələr səksənə çatır,","poem":1},{"lineBreak":true},{"text":"Kənizlər isə saysızdır.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Göyərçinimin, eyibsizimin tayı yoxdur,","poem":1},{"lineBreak":true},{"text":"Anasının yeganə qızıdır,","poem":1},{"lineBreak":true},{"text":"Onu doğanın canı-gözüdür.","poem":1},{"lineBreak":true},{"text":"Qızlar onu görərkən","poem":1},{"lineBreak":true},{"text":"Söyləyirlər: «Bəxtəvərsən!»","poem":1},{"lineBreak":true},{"text":"Mələkələr və cariyələr də onu mədh edir.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Şəfəq saçan,","poem":1},{"lineBreak":true},{"text":"Ay tək gözəl, gün tək parlayan,","poem":1},{"lineBreak":true},{"text":"Müzəffər ordu kimi möhtəşəm olan kimdir?","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Mən qoz bağına endim,","poem":1},{"lineBreak":true},{"text":"Yaşıllaşan vadini görmək istədim.","poem":1},{"lineBreak":true},{"text":"Üzüm tumurcuqlanıbmı, narlar çiçəklənibmi?","poem":1},{"lineBreak":true},{"text":"Bunu seyr edim.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Heç özüm də bilmədən ruhum məni apardı,","poem":1},{"lineBreak":true},{"text":"Şanlı xalqımın döyüş arabalarının üstünə qaldırdı.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Qayıt, ey Şulam qızı, qayıt,","poem":1},{"lineBreak":true},{"text":"Qayıt, səni görək, qayıt.","poem":1},"Oğlan:",{"text":"Maxanayim oyununa tamaşa etdiyiniz kimi","poem":1},{"lineBreak":true},{"text":"Niyə Şulam qızına baxmaq istəyirsiniz?","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}