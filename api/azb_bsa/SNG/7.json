{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ey əsilzadə qızı, başmaqlı ayaqların gözəldir,","poem":1},{"lineBreak":true},{"text":"Budlarını sanki heykəltəraş yonub, cəvahirə bənzəyir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Göbəyin cürbəcür şərabların tükənmədiyi","poem":1},{"lineBreak":true},{"text":"Dəyirmi piyaləyə bənzəyir.","poem":1},{"lineBreak":true},{"text":"Belin zanbaqlara bürünən","poem":1},{"lineBreak":true},{"text":"Bir dəstə sünbülə bənzəyir,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Döşlərin cüt ceyran balası kimi,","poem":1},{"lineBreak":true},{"text":"Əkiz maral balası kimi qoşadır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boynun fil dişi qülləsi kimi gözəldir.","poem":1},{"lineBreak":true},{"text":"Gözlərin Bat-Rabbim darvazası yanındakı","poem":1},{"lineBreak":true},{"text":"Xeşbon hovuzuna bənzəyir.","poem":1},{"lineBreak":true},{"text":"Burnun Dəməşqə baxan Livan qülləsi kimi gözəldir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Başın Karmel dağı kimi dik durur,","poem":1},{"lineBreak":true},{"text":"Başındakı tellər tünd qırmızı rəngə çalır,","poem":1},{"lineBreak":true},{"text":"Padşah zülfünün əsiri olur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nə qəşəngsən, nə şirinsən,","poem":1},{"lineBreak":true},{"text":"Ey məlahətli sevgilim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qamətin xurma ağacına,","poem":1},{"lineBreak":true},{"text":"Döşlərin salxımlara bənzəyir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dedim: «Qoy xurma ağacına çıxım,","poem":1},{"lineBreak":true},{"text":"Meyvəli budaqlarından yapışım».","poem":1},{"lineBreak":true},{"text":"Döşlərindən üzüm salxımları kimi dadım,","poem":1},{"lineBreak":true},{"text":"Nəfəsindən alma ətrini duyum.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dodaqların gözəl şərab dadı verir.","poem":1},"Qız:",{"text":"Bu şərab birbaşa sevgilim üçün tökülsün,","poem":1},{"lineBreak":true},{"text":"Biz yatanların dodaqlarına süzülsün.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən sevgiliminkiyəm,","poem":1},{"lineBreak":true},{"text":"Onun meyl etdiyi mənəm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sevgilim, gəl çölə gedək,","poem":1},{"lineBreak":true},{"text":"Kəndlərdə gecələyək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Səhər tezdən üzüm bağlarına gedək,","poem":1},{"lineBreak":true},{"text":"Üzüm tumurcuqlanıbmı, pöhrə veribmi?","poem":1},{"lineBreak":true},{"text":"Narlar çiçəklənibmi? Bunu seyr edək.","poem":1},{"lineBreak":true},{"text":"Qoy orada sevgimi sənə verim.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey sevgilim, məhəbbət otları ətir saçır,","poem":1},{"lineBreak":true},{"text":"Qapımızın yanında köhnə, təzə – cürbəcür meyvələr var,","poem":1},{"lineBreak":true},{"text":"Sənin üçün saxlanılıb.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}