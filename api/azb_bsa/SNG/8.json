{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"SNG","translationId":"azb_bsa","name":"NƏĞMƏLƏR NƏĞMƏSİ","commonName":"NƏĞMƏLƏR NƏĞMƏSİ","title":"NƏĞMƏLƏR NƏĞMƏSİ KİTABI","order":22,"numberOfChapters":8,"sha256":"ecb36657e4bf21ddde5a2926260cceae3c8f264f68fd4f2d4e056eb6b0d4495d","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/azb_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Kaş ki mənə ananın döşlərindən süd əmən","poem":1},{"lineBreak":true},{"text":"Bir qardaş kimi olaydın,","poem":1},{"lineBreak":true},{"text":"Küçədə səninlə rastlaşarkən səni öpərdim,","poem":1},{"lineBreak":true},{"text":"Heç kim məni qınamazdı.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qarşına düşəydim, mənə öyüd verən","poem":1},{"lineBreak":true},{"text":"Anamın evinə aparaydım.","poem":1},{"lineBreak":true},{"text":"Şirin şərabdan, narımın şirəsindən","poem":1},{"lineBreak":true},{"text":"Sənə içirəydim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sevgilim sol əlini başımın altına salır,","poem":1},{"lineBreak":true},{"text":"Sağ əli ilə məni qucağına alır.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey Yerusəlimdəki qızlar, sizi and verirəm","poem":1},{"lineBreak":true},{"text":"Dişi ceyranlara, çöldəki marallara!","poem":1},{"lineBreak":true},{"text":"Bizi bu sevgidən oyatmayın, ayıltmayın,","poem":1},{"lineBreak":true},{"text":"Qoy könül istəyənəcən qalsın.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Sevgilisinə söykənib çöldən gələn","poem":1},{"lineBreak":true},{"text":"Bu gözəl kimdir?","poem":1},"Qız:",{"text":"Alma ağacı altda səni oyatdım.","poem":1},{"lineBreak":true},{"text":"Sən orada ananın bətninə düşmüsən,","poem":1},{"lineBreak":true},{"text":"Orada anan ağrı çəkib, səni doğub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Məni qəlbinin başında, qolunun üstündə","poem":1},{"lineBreak":true},{"text":"Bir möhür kimi saxla.","poem":1},{"lineBreak":true},{"text":"Çünki sevgi ölüm qədər qüvvətlidir,","poem":1},{"lineBreak":true},{"text":"Qısqanclıq ölülər diyarı kimi möhkəmdir,","poem":1},{"lineBreak":true},{"text":"Onun odu alovlanır,","poem":1},{"lineBreak":true},{"text":"O, atəşdir, tamamilə yandırıb-yaxır.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sevgini ümman sular söndürə bilməz,","poem":1},{"lineBreak":true},{"text":"Onu çağlayan çaylar batıra bilməz.","poem":1},{"lineBreak":true},{"text":"Bir insan sevgisi uğrunda var-yoxunu versə belə,","poem":1},{"lineBreak":true},{"text":"Hamı ona xor baxar.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Bir kiçik bacımız var,","poem":1},{"lineBreak":true},{"text":"Hələ döşləri çıxmayıb.","poem":1},{"lineBreak":true},{"text":"Bacımıza elçi gələn gün","poem":1},{"lineBreak":true},{"text":"Onun üçün nə edək?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Əgər o, bir hasar olsaydı,","poem":1},{"lineBreak":true},{"text":"Biz üstünə gümüşdən bürc vurardıq.","poem":1},{"lineBreak":true},{"text":"Əgər o, bir qapı olsaydı,","poem":1},{"lineBreak":true},{"text":"Onu sidrdən xonça bağlayıb dövrəyə alardıq.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Mən bir hasaram,","poem":1},{"lineBreak":true},{"text":"Döşlərim qüllələrə oxşar,","poem":1},{"lineBreak":true},{"text":"Ona görə yarımın gözləri məndən razı qalar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Süleymanın Baal-Hamonda bir üzüm bağı var idi,","poem":1},{"lineBreak":true},{"text":"O bu bağı kirayəyə verirdi.","poem":1},{"lineBreak":true},{"text":"Məhsula görə hər kirayə alan","poem":1},{"lineBreak":true},{"text":"Ona min parça gümüş gətirməli idi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mənim də bağım var, onun sahibiyəm,","poem":1},{"lineBreak":true},{"text":"Ey Süleyman, min parça gümüş sənin olsun,","poem":1},{"lineBreak":true},{"text":"İki yüz gümüş kirayə alanlara qalsın.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Sən, ey bağçalarda məskən salan gözəl,","poem":1},{"lineBreak":true},{"text":"Dostlar səni dinləyir,","poem":1},{"lineBreak":true},{"text":"Mənə də səsini eşitdir.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ey sevgilim, qaç,","poem":1},{"lineBreak":true},{"text":"Ətir saçan dağların üstündə,","poem":1},{"lineBreak":true},{"text":"Bir ahu, bir maral balası kimi ol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}