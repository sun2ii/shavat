{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEC","translationId":"azb_bsa","name":"ZƏKƏRİYYƏ","commonName":"ZƏKƏRİYYƏ","title":"ZƏKƏRİYYƏ PEYĞƏMBƏRİN KİTABI","order":38,"numberOfChapters":14,"sha256":"6050e152fa7889a7965564e2b9dbf082f6752f31fb0ccafe6f2fd26aef30d477","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Yəhudanın xilası"]},{"type":"verse","number":1,"content":[{"text":"Yaz yağışı mövsümündə","poem":1},{"lineBreak":true},{"text":"Rəbdən, şimşək çaxdıran Rəbdən","poem":1},{"lineBreak":true},{"text":"Yağış istəyin.","poem":1},{"lineBreak":true},{"text":"O, insanlara bolluca yağış və","poem":1},{"lineBreak":true},{"text":"Hər kəsin tarlasına ot verəcək.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ancaq ev bütlərindən alınan vədlər boş şeydir.","poem":1},{"lineBreak":true},{"text":"Falçılar boş görüntülər görür,","poem":1},{"lineBreak":true},{"text":"Mənasız yuxular danışaraq","poem":1},{"lineBreak":true},{"text":"Əbəs yerə təsəlli verir.","poem":1},{"lineBreak":true},{"text":"Buna görə də xalq sürü kimi dağınıqdır,","poem":1},{"lineBreak":true},{"text":"Zəhmət çəkirlər, çünki bir çoban yoxdur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Çobanlara qarşı qəzəbim alovlandı,","poem":1},{"lineBreak":true},{"text":"Başçılarına cəza verəcəyəm.","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbi Öz sürüsü olan","poem":1},{"lineBreak":true},{"text":"Yəhuda nəslinin qayğısını çəkəcək.","poem":1},{"lineBreak":true},{"text":"Onlar əzəmətli döyüş atları kimi olacaq.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Künc daşı, çadır payası,","poem":1},{"lineBreak":true},{"text":"Döyüş kamanı ondan olacaq.","poem":1},{"lineBreak":true},{"text":"Bütün xalq başçıları ondan çıxacaq.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onlar döyüşdə","poem":1},{"lineBreak":true},{"text":"Düşməni küçələrdə palçıqda tapdalayan","poem":1},{"lineBreak":true},{"text":"İgidlər kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Rəbb onlarla olduğu üçün döyüşəcəklər,","poem":1},{"lineBreak":true},{"text":"Süvariləri utandıracaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yəhuda nəslini qüvvətləndirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Yusif xalqını qurtaracağam.","poem":1},{"lineBreak":true},{"text":"Sürgündən geri qaytaracağam,","poem":1},{"lineBreak":true},{"text":"Çünki onlara acıyıram.","poem":1},{"lineBreak":true},{"text":"Elə edəcəyəm ki, sanki onları","poem":1},{"lineBreak":true},{"text":"Heç əvvəlcədən rədd etməmişəm.","poem":1},{"lineBreak":true},{"text":"Çünki Mən onların Allahı Rəbbəm,","poem":1},{"lineBreak":true},{"text":"Onlara cavab verəcəyəm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Efrayimlilər igidlər kimi olacaq,","poem":1},{"lineBreak":true},{"text":"Şərab içmiş kimi ürəkləri coşacaq.","poem":1},{"lineBreak":true},{"text":"Övladları bunu görüb sevinəcək,","poem":1},{"lineBreak":true},{"text":"Ürəkləri Rəbdə sevinc tapacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fit çalıb onları toplayacağam,","poem":1},{"lineBreak":true},{"text":"Çünki Mən onları satın almışam.","poem":1},{"lineBreak":true},{"text":"Əvvəllər necə çoxalırdılarsa,","poem":1},{"lineBreak":true},{"text":"İndi də eləcə çoxalacaqlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onları xalqlar arasına səpələdimsə də,","poem":1},{"lineBreak":true},{"text":"Uzaq ölkələrdə Məni yada salacaqlar.","poem":1},{"lineBreak":true},{"text":"Övladları ilə birgə sağ qalacaq və","poem":1},{"lineBreak":true},{"text":"Geri qayıdacaqlar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mən onları yenə Misir ölkəsindən gətirəcək,","poem":1},{"lineBreak":true},{"text":"Aşşurdan toplayacağam.","poem":1},{"lineBreak":true},{"text":"Onları Gilead torpağına,","poem":1},{"lineBreak":true},{"text":"Livana gətirəcəyəm.","poem":1},{"lineBreak":true},{"text":"Onlara kifayət qədər yer tapılmayacaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Əziyyət dənizindən keçəcəklər,","poem":1},{"lineBreak":true},{"text":"Dənizin dalğaları sakitləşəcək,","poem":1},{"lineBreak":true},{"text":"Nilin bütün dərin suları quruyacaq.","poem":1},{"lineBreak":true},{"text":"Aşşurun qüruru alçaldılacaq,","poem":1},{"lineBreak":true},{"text":"Misirin padşahlıq əsası əlindən düşəcək.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onları Rəbdə qüvvətləndirəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar da Rəbbin adı ilə yaşayacaq»","poem":1},{"lineBreak":true},{"text":"Rəbb belə bəyan edir.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}