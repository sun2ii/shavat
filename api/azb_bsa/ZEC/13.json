{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEC","translationId":"azb_bsa","name":"ZƏKƏRİYYƏ","commonName":"ZƏKƏRİYYƏ","title":"ZƏKƏRİYYƏ PEYĞƏMBƏRİN KİTABI","order":38,"numberOfChapters":14,"sha256":"6050e152fa7889a7965564e2b9dbf082f6752f31fb0ccafe6f2fd26aef30d477","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["Günahdan təmizlənmə"]},{"type":"verse","number":1,"content":["O gün Davud nəslini və Yerusəlimdə yaşayanları günahdan və murdarlıqdan təmizləmək üçün bir bulaq açılacaq."]},{"type":"verse","number":2,"content":["O gün ölkədən bütlərin adını birdəfəlik siləcəyəm, onlar bir daha xatırlanmayacaq. Yalançı peyğəmbərləri də, natəmiz ruhu da ölkədən uzaqlaşdıracağam» bəyan edir Ordular Rəbbi."]},{"type":"verse","number":3,"content":["«Əgər kimsə yenə peyğəmbərlik etsə, onu dünyaya gətirmiş ata-anası ona deyəcək: “Sən yaşaya bilməzsən, çünki Rəbbin adı ilə yalan söyləmisən”. Sonra isə peyğəmbərlik edəndə öz ata-anası onun bədənini deşəcək."]},{"type":"verse","number":4,"content":["O gün hər peyğəmbər peyğəmbərlik edərkən ona nazil olan görüntüdən utanacaq. O daha insanları aldatmaq üçün tüklü paltar geyməyəcək."]},{"type":"verse","number":5,"content":["O deyəcək: “Mən peyğəmbər deyiləm, əkinçiyəm. Cavanlığımda bir adam məni özünə qul etdi”."]},{"type":"verse","number":6,"content":["O biri ondan soruşacaq: “Bəs sinəndəki bu yaralar nədir?” O isə “dostlarımın evində aldığım yaralardır” deyəcək."]},{"type":"heading","content":["Çobanın həlakı"]},{"type":"verse","number":7,"content":[{"text":"Oyan, ey qılınc,","poem":1},{"lineBreak":true},{"text":"Çobanımın, yaxınımın üstünə get»","poem":1},{"lineBreak":true},{"text":"Bəyan edir Ordular Rəbbi.","poem":1},{"lineBreak":true},{"text":"«Çobanı vur,","poem":1},{"lineBreak":true},{"text":"Qoyunları pərən-pərən olsun.","poem":1},{"lineBreak":true},{"text":"Mən də əlimi kiçiklərə qarşı qaldıracağam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bütün ölkədə","poem":1},{"lineBreak":true},{"text":"Xalqın üçdə ikisi vurulub-öldürüləcək,","poem":1},{"lineBreak":true},{"text":"Üçdə biri isə sağ qalacaq»","poem":1},{"lineBreak":true},{"text":"Bəyan edir Rəbb.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Qalan üçdə birini oda salacağam,","poem":1},{"lineBreak":true},{"text":"Onları gümüşü təmizləyən kimi təmizləyəcəyəm.","poem":1},{"lineBreak":true},{"text":"Qızılı yoxlayan kimi yoxlayacağam.","poem":1},{"lineBreak":true},{"text":"Onlar Mənim adımı çağıracaq,","poem":1},{"lineBreak":true},{"text":"Mən də onlara cavab verib","poem":1},{"lineBreak":true},{"text":"“Bunlar Mənim xalqımdır” deyəcəyəm,","poem":1},{"lineBreak":true},{"text":"Onlar da “Rəbb Allahımızdır” deyəcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}