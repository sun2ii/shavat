},{"type":"verse","number":6,"content":[{"text":"«Haydı, haydı! Şimal ölkəsindən qaçın» deyir Rəbb,","poem":1},{"lineBreak":true},{"text":"«Çünki sizi göydə dörd tərəfə əsən","poem":1},{"lineBreak":true},{"text":"Külək kimi dağıtmışdım» deyir Rəbb.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Haydı! Ey Sion, sən ki Babil şəhərində yaşayırsan, qaçıb qurtar!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Çünki Ordular Rəbbi deyir ki,","poem":1},{"lineBreak":true},{"text":"İzzəti üçün sizi qarət etmiş millətlərin yanına Məni göndərdi.","poem":1},{"lineBreak":true},{"text":"Sizə toxunan Onun göz bəbəyinə toxunmuş olur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mən o millətlərə qarşı əlimi qaldıracağam,","poem":1},{"lineBreak":true},{"text":"Əsarətlərində olanlar onları qarət edəcək.","poem":1},{"lineBreak":true},{"text":"Onda biləcəksiniz ki,","poem":1},{"lineBreak":true},{"text":"Məni Ordular Rəbbi göndərmişdir.","poem":1}]},{"type":"verse","number":10,"content":["«Şadlıq edib sevin, ey Sion qızı!",{"text":"Çünki aranızda yaşamağa gəlirəm» bəyan edir Rəbb.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"«O gün çoxlu millətlər Rəbbə bağlanacaq,","poem":1},{"lineBreak":true},{"text":"Mənim xalqım olacaq.","poem":1},{"lineBreak":true},{"text":"O zaman aranızda yaşayacağam.","poem":1},{"lineBreak":true},{"text":"Siz biləcəksiniz ki,","poem":1},{"lineBreak":true},{"text":"Məni yanınıza Ordular Rəbbi göndərib.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rəbb müqəddəs torpaqda","poem":1},{"lineBreak":true},{"text":"Yəhudanı Öz payı olaraq mülk alacaq,","poem":1},{"lineBreak":true},{"text":"Yenə Yerusəlimi seçəcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ey bütün bəşər, Rəbbin önündə susun!","poem":1},{"lineBreak":true},{"text":"Çünki O Öz müqəddəs məskənindən qalxıb gəlir!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ZEC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}