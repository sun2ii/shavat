{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEC","translationId":"azb_bsa","name":"ZƏKƏRİYYƏ","commonName":"ZƏKƏRİYYƏ","title":"ZƏKƏRİYYƏ PEYĞƏMBƏRİN KİTABI","order":38,"numberOfChapters":14,"sha256":"6050e152fa7889a7965564e2b9dbf082f6752f31fb0ccafe6f2fd26aef30d477","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/azb_bsa/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["İsrailin düşmənlərinə cəza"]},{"type":"verse","number":1,"content":["Bu xəbərdarlıq Xadrak ölkəsi və onun rahatlıq yeri Dəməşq şəhəri barəsində nazil olan Rəbbin sözüdür, çünki insanların və bütün İsrail qəbilələrinin gözü Rəbbə baxır."]},{"type":"verse","number":2,"content":["Bu söz oranın sərhədində olan Xamat şəhərinə, çox tərəqqi etmiş Sur və Sidon şəhərlərinə də aiddir."]},{"type":"verse","number":3,"content":["Sur özünə bir qala tikdi, torpaq qədər gümüş, küçə palçığı qədər saf qızıl yığdı."]},{"type":"verse","number":4,"content":["Amma Rəbb onu qovacaq, dənizdəki gücünü yox edəcək, od onu yandırıb-yaxacaq."]},{"type":"verse","number":5,"content":["Aşqelon bunu görüb qorxacaq, Qəzzə də çox ağrı çəkəcək, Eqron da eləcə, çünki ümidi sönəcək. Qəzzədə padşah olmayacaq, Aşqelon sakinsiz qalacaq."]},{"type":"verse","number":6,"content":["Aşdodda bic doğulanlar yaşayacaq, Filiştlilərin qürurunu qıracağam."]},{"type":"verse","number":7,"content":["Ağızlarından qanı daman əti, dişlərinin arasından haram yeməkləri alacağam. Onların sağ qalanları Allahımıza məxsus olub Yəhudanın bir nəsli kimi olacaq. Eqronlular da Yevuslular kimi olacaq."]},{"type":"verse","number":8,"content":["Hücum edən ordulara qarşı evimin ətrafında ordugah quracağam. Heç bir istilaçı daha xalqımın üzərinə tökülməyəcək. Çünki artıq xalqıma Mən keşik çəkirəm."]},{"type":"heading","content":["Rəbbin vədi"]},{"type":"verse","number":9,"content":[{"text":"Ey Sion qızı, böyük sevinclə coş,","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlim qızı, hayqır!","poem":1},{"lineBreak":true},{"text":"Bax padşahın sənə tərəf gəlir.","poem":1},{"lineBreak":true},{"text":"O ədalətli və xilaskardır.","poem":1},{"lineBreak":true},{"text":"O itaətkardır və bir eşşəyə –","poem":1},{"lineBreak":true},{"text":"Eşşəyin balası olan sıpaya minib gəlir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Döyüş arabalarını Efrayimdən,","poem":1},{"lineBreak":true},{"text":"Atları Yerusəlimdən uzaqlaşdıracağam.","poem":1},{"lineBreak":true},{"text":"Döyüş kamanları qırılacaq.","poem":1},{"lineBreak":true},{"text":"Padşahınız millətlərə sülh elan edəcək.","poem":1},{"lineBreak":true},{"text":"Onun hökmranlığı dənizdən dənizə,","poem":1},{"lineBreak":true},{"text":"Çaydan yer üzünün qurtaracağınadək hər yerə uzanacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sizə gəlincə, əhd qurbanının qanından ötrü","poem":1},{"lineBreak":true},{"text":"Sürgündəki xalqınızı","poem":1},{"lineBreak":true},{"text":"Susuz quyudan çıxarıb xilas edəcəyəm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Qalanıza qayıdın,","poem":1},{"lineBreak":true},{"text":"Ey ümid edən əsirlər!","poem":1},{"lineBreak":true},{"text":"Bu gün sizə bildirirəm ki,","poem":1},{"lineBreak":true},{"text":"Sizə zəhmətinizin ikiqat əvəzini verəcəyəm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yəhudanı Özüm üçün kaman kimi çəkəcəyəm,","poem":1},{"lineBreak":true},{"text":"Efrayimi ox kimi ona qoyacağam.","poem":1},{"lineBreak":true},{"text":"Ey Sion, övladlarını","poem":1},{"lineBreak":true},{"text":"Yunan övladlarının üstünə qaldıracağam.","poem":1},{"lineBreak":true},{"text":"Səni bir döyüşçü qılıncı tək edəcəyəm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Onda Rəbb xalqının üzərində görünəcək,","poem":1},{"lineBreak":true},{"text":"Onun oxu şimşək kimi çaxacaq.","poem":1},{"lineBreak":true},{"text":"Xudavənd Rəbb şeypur çalacaq,","poem":1},{"lineBreak":true},{"text":"Cənub qasırğaları ilə irəli gedəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Onları Ordular Rəbbi qoruyacaq.","poem":1},{"lineBreak":true},{"text":"Düşmənlərini tələf edəcəklər,","poem":1},{"lineBreak":true},{"text":"Sapand daşları ilə qırıb-çatacaqlar.","poem":1},{"lineBreak":true},{"text":"Onların qanını şərab kimi içib hay-küy salacaqlar.","poem":1},{"lineBreak":true},{"text":"Qurban qanı tökülən qablar kimi,","poem":1},{"lineBreak":true},{"text":"Qurbangahın künc-bucaqları kimi","poem":1},{"lineBreak":true},{"text":"Qanla dolu olacaqlar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"O gün özlərinin Allahı Rəbb","poem":1},{"lineBreak":true},{"text":"Xalqının sürüsü kimi onları xilas edəcək.","poem":1},{"lineBreak":true},{"text":"Onlar Onun torpağında","poem":1},{"lineBreak":true},{"text":"Tac daş-qaşı kimi parıldayacaq.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Necə yaraşıqlı, necə gözəl olacaqlar!","poem":1},{"lineBreak":true},{"text":"Oğlanlar taxılla,","poem":1},{"lineBreak":true},{"text":"Qızlar təzə şərabla gücə gələcək.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/azb_bsa/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}