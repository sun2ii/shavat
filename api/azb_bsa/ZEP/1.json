{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEP","translationId":"azb_bsa","name":"SEFANYA","commonName":"SEFANYA","title":"SEFANYA PEYĞƏMBƏRİN KİTABI","order":36,"numberOfChapters":3,"sha256":"3aff0b9a803c337feb18e80a9f8b7780bf7e1f11afc93913de848d72f135aee8","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yəhuda padşahı Amon oğlu Yoşiyanın hökm etdiyi dövrdə Xizqiya oğlu Amarya oğlu Gedalya oğlu Kuşi oğlu Sefanyaya Rəbbin sözü nazil oldu."]},{"type":"heading","content":["Rəbbin məhkəmə günü"]},{"type":"verse","number":2,"content":[{"text":"Rəbb belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Yer üzündən hər şeyi silib-süpürəcəyəm».","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Budur, Rəbb belə bəyan edir:","poem":1},{"lineBreak":true},{"text":"«İnsanları, heyvanları,","poem":1},{"lineBreak":true},{"text":"Göydəki quşları, dənizdəki balıqları,","poem":1},{"lineBreak":true},{"text":"Pis adamları ilə","poem":1},{"lineBreak":true},{"text":"Şər üçün qurulan tələlərini","poem":1},{"lineBreak":true},{"text":"Silib-süpürəcəyəm,","poem":1},{"lineBreak":true},{"text":"İnsanı yer üzündən yox edəcəyəm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Əlimi uzadıb Yəhuda və Yerusəlim sakinlərinin","poem":1},{"lineBreak":true},{"text":"Hamısını cəzalandıracağam,","poem":1},{"lineBreak":true},{"text":"Baal bütlərinə ibadətin qalıqlarını,","poem":1},{"lineBreak":true},{"text":"Kahinlərlə bütpərəst din xadimlərinin adlarını da buradan silib atacağam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Damlarda göy cisimlərinə səcdə edənləri,","poem":1},{"lineBreak":true},{"text":"Həm Rəbbin adına, həm də Milkom bütü adına","poem":1},{"lineBreak":true},{"text":"And içib səcdə edənləri,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rəbbin yolundan dönənləri,","poem":1},{"lineBreak":true},{"text":"Rəbbə müraciət etməyənləri,","poem":1},{"lineBreak":true},{"text":"Rəbdən məsləhət almayanları","poem":1},{"lineBreak":true},{"text":"Buradan yox edəcəyəm».","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Susun Xudavənd Rəbbin qarşısında,","poem":1},{"lineBreak":true},{"text":"Çünki Onun günü yaxınlaşır,","poem":1},{"lineBreak":true},{"text":"Rəbb qurban hazırlayıb, qonaqlarını dəvət edib.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rəbb deyir: «O qurban günü əmirləri, şahzadələri,","poem":1},{"lineBreak":true},{"text":"Əcnəbi dəbi ilə geyinənləri cəzalandıracağam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O gün kandarından tullanıb keçənləri,","poem":1},{"lineBreak":true},{"text":"Öz ağalarının evlərini zorakılıq və hiylə ilə","poem":1},{"lineBreak":true},{"text":"Dolduranları cəzalandıracağam».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«O gün Yerusəlimdə Balıqlar darvazasından fəğan səsi,","poem":1},{"lineBreak":true},{"text":"İkinci Məhəllədən fəryadlar,","poem":1},{"lineBreak":true},{"text":"Təpələrdən isə böyük gurultu eşidiləcək».","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ey bazar məhəlləsinin sakinləri, nalə çəkin!","poem":1},{"lineBreak":true},{"text":"Bütün tacirləriniz məhv olacaq,","poem":1},{"lineBreak":true},{"text":"Tərəzidə gümüş çəkənləriniz qırılacaq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"O zaman Yerusəlimin hər tərəfini","poem":1},{"lineBreak":true},{"text":"Çıraqlarla axtaracağam,","poem":1},{"lineBreak":true},{"text":"Firavan yaşayan qayğısızları,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Ürəklərində","poem":1},{"lineBreak":true},{"text":"«Rəbb nə yaxşılıq, nə də pislik –","poem":1},{"lineBreak":true},{"text":"Heç nə etməz»","poem":1},{"lineBreak":true},{"text":"Deyənləri cəzalandıracağam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Var-dövlətləri talan olacaq,","poem":1},{"lineBreak":true},{"text":"Evləri xaraba qalacaq,","poem":1},{"lineBreak":true},{"text":"Tikdikləri evlərdə yaşamayacaqlar,","poem":1},{"lineBreak":true},{"text":"Onlar saldıqları üzümlüklərin","poem":1},{"lineBreak":true},{"text":"Şərablarını içməyəcəklər.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rəbbin möhtəşəm günü yaxınlaşır,","poem":1},{"lineBreak":true},{"text":"Yaxınlaşır, tez gələcək.","poem":1},{"lineBreak":true},{"text":"Rəbbin günündə fəryad səsi çıxacaq,","poem":1},{"lineBreak":true},{"text":"İgid adam belə, fəryad edəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O gün qəzəb günüdür:","poem":1},{"lineBreak":true},{"text":"Hər tərəfi","poem":1},{"lineBreak":true},{"text":"Əziyyət və məşəqqətin,","poem":1},{"lineBreak":true},{"text":"Viran və talanın,","poem":1},{"lineBreak":true},{"text":"Qaranlıq və zülmətin,","poem":1},{"lineBreak":true},{"text":"Qara buludların bürüdüyü gündür!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O gün istehkamlı şəhərlərə,","poem":1},{"lineBreak":true},{"text":"Hündür künc qüllələrinə qarşı","poem":1},{"lineBreak":true},{"text":"Döyüş üçün çalınan şeypurların,","poem":1},{"lineBreak":true},{"text":"Döyüş nərələrinin səsləndiyi gündür!","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Rəbb deyir:","poem":1},{"lineBreak":true},{"text":"«Adamlara elə bəla göndərəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Kor kimi hara gedəcəklərini bilməyəcəklər,","poem":1},{"lineBreak":true},{"text":"Çünki Mən Rəbbə qarşı günah ediblər.","poem":1},{"lineBreak":true},{"text":"Qanları su kimi axacaq,","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Bədənləri yerdə çürüyüb peyin olacaq».","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rəbbin qəzəb günündə","poem":1},{"lineBreak":true},{"text":"Qızıl-gümüşləri","poem":1},{"lineBreak":true},{"text":"Onları qurtara bilməyəcək,","poem":1},{"lineBreak":true},{"text":"Onun qısqanc qəzəbinin alovunda","poem":1},{"lineBreak":true},{"text":"Bütün ölkə yanıb yox olacaq,","poem":1},{"lineBreak":true},{"text":"Çünki O, bir anda ölkənin sakinlərini qıracaq.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Firavan yaşayan qayğısızlar – hərfi tərcümədə çöküntüsü dibə çökmüş şərab kimi olanlar.","reference":{"chapter":1,"verse":12}},{"noteId":1,"caller":"+","text":"Qanları su kimi axacaq – hərfi tərcümədə qan toz kimi töküləcək.","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/azb_bsa/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}