{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEP","translationId":"azb_bsa","name":"SEFANYA","commonName":"SEFANYA","title":"SEFANYA PEYĞƏMBƏRİN KİTABI","order":36,"numberOfChapters":3,"sha256":"3aff0b9a803c337feb18e80a9f8b7780bf7e1f11afc93913de848d72f135aee8","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Tövbəyə çağırış"]},{"type":"verse","number":1,"content":[{"text":"Ey utanmaz millət, toplaşın!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fərman çıxmadan,","poem":1},{"lineBreak":true},{"text":"O gün saman çöpü tək uçmadan,","poem":1},{"lineBreak":true},{"text":"Rəbbin qızğın qəzəbi başınıza gəlmədən,","poem":1},{"lineBreak":true},{"text":"Rəbbin qəzəb günü sizə yetişmədən öncə toplaşın!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ey Rəbbin hökmünə əməl edən sizlər,","poem":1},{"lineBreak":true},{"text":"Ölkədəki itaətkar insanlar, Rəbbə meyl salın!","poem":1},{"lineBreak":true},{"text":"Salehliyə meyl salın!","poem":1},{"lineBreak":true},{"text":"İtaətkarlığa meyl salın!","poem":1},{"lineBreak":true},{"text":"Bəlkə siz Rəbbin qəzəb günündə qurtula bildiniz.","poem":1}]},{"type":"heading","content":["Rəbbin millətlərə cəzası"]},{"type":"verse","number":4,"content":[{"text":"Qəzzə bomboş qalacaq,","poem":1},{"lineBreak":true},{"text":"Aşqelon xarabalığa dönəcək,","poem":1},{"lineBreak":true},{"text":"Aşdod əhalisi günorta çağı qovulacaq,","poem":1},{"lineBreak":true},{"text":"Eqron özülündən söküləcək!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dəniz sahilində yaşayanların –","poem":1},{"lineBreak":true},{"text":"Keretlilərin","poem":1},{"noteId":2},{"text":"vay halına!","poem":1},{"lineBreak":true},{"text":"Ey Filiştlilərin torpağı Kənan,","poem":1},{"lineBreak":true},{"text":"Rəbbin hökmü sizə qarşıdır,","poem":1},{"lineBreak":true},{"text":"Rəbb hamınızı yox edəcək.","poem":1},{"lineBreak":true},{"text":"Ölkədə heç bir sakin sağ qalmayacaq!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dəniz sahilindəki ölkəniz otlaqlara,","poem":1},{"lineBreak":true},{"text":"Çoban daxmalarına və qoyun-keçi ağıllarına dönəcək!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ölkə Yəhuda nəslindən qalanların əlinə keçəcək,","poem":1},{"lineBreak":true},{"text":"Sürülərini orada otaracaqlar,","poem":1},{"lineBreak":true},{"text":"Axşam Aşqelondakı evlərində yatacaqlar,","poem":1},{"lineBreak":true},{"text":"Çünki özlərinin Allahı Rəbb onları yada salaraq","poem":1},{"lineBreak":true},{"text":"Yenə firavan edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Moavlıların rişxəndlərini,","poem":1},{"lineBreak":true},{"text":"Ammonluların təhqirlərini eşitdim.","poem":1},{"lineBreak":true},{"text":"Xalqıma rişxənd edib lovğalanaraq dedilər ki,","poem":1},{"lineBreak":true},{"text":"Xalqımın sərhədlərini keçəcəklər.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buna görə də İsrailin Allahı, Ordular Rəbbi bəyan edir.","poem":1},{"lineBreak":true},{"text":"Varlığıma and olsun ki,","poem":1},{"lineBreak":true},{"text":"Moav mütləq Sodom kimi,","poem":1},{"lineBreak":true},{"text":"Ammon Homorra kimi olacaq:","poem":1},{"lineBreak":true},{"text":"Oraları alaqlar və duzlu çalalar basacaq,","poem":1},{"lineBreak":true},{"text":"Əbədi viranəliyə dönəcək.","poem":1},{"lineBreak":true},{"text":"Xalqımın qalanları oranı talan edəcək,","poem":1},{"lineBreak":true},{"text":"Torpaqlarına millətimdən sağ qalanlar","poem":1},{"lineBreak":true},{"text":"Sahib olacaq».","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bu onların məğrurluğunun əvəzi olacaq,","poem":1},{"lineBreak":true},{"text":"Çünki bu xalqlar","poem":1},{"lineBreak":true},{"text":"Ordular Rəbbinin xalqına rişxənd edib lovğalandı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rəbb onları dəhşətə salacaq,","poem":1},{"lineBreak":true},{"text":"Yer üzünün bütün allahlarını yox edəcək.","poem":1},{"lineBreak":true},{"text":"Uzaqlarda yaşayan bütün millətlər","poem":1},{"lineBreak":true},{"text":"Olduqları yerlərdə Ona səcdə edəcək.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ey Kuşlular, siz də","poem":1},{"lineBreak":true},{"text":"Mənim qılıncımla öldürüləcəksiniz» Rəbb deyir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rəbb əlini şimala doğru uzadıb","poem":1},{"lineBreak":true},{"text":"Aşşuru yox edəcək,","poem":1},{"lineBreak":true},{"text":"Ninevanı viranəliyə,","poem":1},{"lineBreak":true},{"text":"Səhra kimi quruya çevirəcək,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ora sürülərin, hər cür heyvanın","poem":1},{"lineBreak":true},{"text":"Yatdığı yer olacaq.","poem":1},{"lineBreak":true},{"text":"Orada sütun başlarında,","poem":1},{"lineBreak":true},{"text":"Bayquşlar, yapalaqlar yuva quracaq,","poem":1},{"lineBreak":true},{"text":"Onlar pəncərələrdən ulayacaq,","poem":1},{"lineBreak":true},{"text":"Qarğalar kandarlardan qarıldayacaq","poem":1},{"lineBreak":true},{"text":"Evlərdə sidr tirləri görünəcək.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bu şəhər zövq-səfalı şəhər idi,","poem":1},{"lineBreak":true},{"text":"Əmin-amanlıq içində yaşayırdı.","poem":1},{"lineBreak":true},{"text":"Hey belə deyərdi:","poem":1},{"lineBreak":true},{"text":"«Mən mənəm, məndən başqası yoxdur!»","poem":1},{"lineBreak":true},{"text":"Necə də bu şəhər xarabalığa döndü,","poem":1},{"lineBreak":true},{"text":"Vəhşi heyvanların yuvası oldu!","poem":1},{"lineBreak":true},{"text":"Yanından keçən hər kəs vahimədən","poem":1},{"lineBreak":true},{"text":"Kənara çəkilir.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Keret – Krit adası nəzərdə tutulur.","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/azb_bsa/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}