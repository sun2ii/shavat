{"translation":{"id":"azb_bsa","name":"Azərbaycan dilində Müqəddəs Kitab","website":"https://ebible.org/Scriptures/details.php?id=azb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=azb","licenseNotes":null,"shortName":"BSA","englishName":"Azerbaijani Bible","language":"azb","textDirection":"ltr","sha256":"16c271e180bac82c3274e2f92e38051264fcfe738372c9afdcbd7e92ad28d7a4","availableFormats":["json"],"listOfBooksApiLink":"/api/azb_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"South Azerbaijani","languageEnglishName":"South Azerbaijani"},"book":{"id":"ZEP","translationId":"azb_bsa","name":"SEFANYA","commonName":"SEFANYA","title":"SEFANYA PEYĞƏMBƏRİN KİTABI","order":36,"numberOfChapters":3,"sha256":"3aff0b9a803c337feb18e80a9f8b7780bf7e1f11afc93913de848d72f135aee8","firstChapterNumber":1,"firstChapterApiLink":"/api/azb_bsa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/azb_bsa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusəlimin gələcəyi"]},{"type":"verse","number":1,"content":[{"text":"Üsyankar, pozğun, qəddar şəhərin vay halına!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Söz dinləmədi, ibrət dərsi almadı,","poem":1},{"lineBreak":true},{"text":"Rəbbə güvənmədi, Allahına yaxınlaşmadı.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Başçıları nərildəyən aslanlara bənzəyir,","poem":1},{"lineBreak":true},{"text":"Hakimləri axşam gəzən ac qurdlar kimi","poem":1},{"lineBreak":true},{"text":"Səhərə qədər bir şey qoymaz.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Peyğəmbərləri məsuliyyətsiz, xain adamlardır,","poem":1},{"lineBreak":true},{"text":"Kahinləri müqəddəs olanı murdarlayıb,","poem":1},{"lineBreak":true},{"text":"Qanunun mənasını pozur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amma şəhərin içində olan Rəbb salehdir,","poem":1},{"lineBreak":true},{"text":"O haqsızlıq etməz.","poem":1},{"lineBreak":true},{"text":"Hər yeni günün səhərində","poem":1},{"lineBreak":true},{"text":"Durmadan ədalətini zühur etdirər,","poem":1},{"lineBreak":true},{"text":"Amma haqsız adam utanmaq bilməz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rəbb belə deyir:","poem":1},{"lineBreak":true},{"text":"«Millətləri məhv etdim,","poem":1},{"lineBreak":true},{"text":"Künc qüllələri dağıldı.","poem":1},{"lineBreak":true},{"text":"Küçələrini viran qoydum,","poem":1},{"lineBreak":true},{"text":"O küçələrdən artıq gəlib-keçən yoxdur!","poem":1},{"lineBreak":true},{"text":"Şəhərləri xarabalığa döndü,","poem":1},{"lineBreak":true},{"text":"Orada heç bir sakin də qalmadı.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mən dedim:","poem":1},{"lineBreak":true},{"text":"“Xalqım Məndən qorxar,","poem":1},{"lineBreak":true},{"text":"İbrət dərsi alar”.","poem":1},{"lineBreak":true},{"text":"Onda məskənləri dağıdılmaz,","poem":1},{"lineBreak":true},{"text":"Verdiyim cəzaların hamısı üzərlərinə gəlməz,","poem":1},{"lineBreak":true},{"text":"Lakin onlar hər cür pozğun iş görməkdən zövq aldı».","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Buna görə Rəbb bəyan edir:","poem":1},{"lineBreak":true},{"text":"«Şahid kimi qalxdığım","poem":1},{"lineBreak":true},{"text":"Günə qədər Məni gözləyin.","poem":1},{"lineBreak":true},{"text":"Çünki Mən millətləri yığmağı","poem":1},{"lineBreak":true},{"text":"Padşahlıqları toplamağı qərara almışam.","poem":1},{"lineBreak":true},{"text":"Qoy üzərlərinə qeyzimi, qızğın qəzəbimi töküm.","poem":1},{"lineBreak":true},{"text":"Çünki qısqanc qəzəbimin odu ilə bütün yer üzü tələf olacaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O zaman Mən xalqların nitqini dəyişib,","poem":1},{"lineBreak":true},{"text":"Onlara pak dil verəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Hamı Rəbbin adını çağırsın,","poem":1},{"lineBreak":true},{"text":"Mənə çiyin-çiyinə xidmət etsinlər.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Qürbətə dağılmış,","poem":1},{"lineBreak":true},{"text":"Mənə səcdə edənlər","poem":1},{"lineBreak":true},{"text":"Kuş çaylarının o tayından","poem":1},{"lineBreak":true},{"text":"Mənə təqdimlər gətirəcək.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O gün sən, ey xalqım,","poem":1},{"lineBreak":true},{"text":"Mənə qarşı üsyankarlıq etdiyinə görə","poem":1},{"lineBreak":true},{"text":"Daha xəcalətli olmayacaqsan.","poem":1},{"lineBreak":true},{"text":"Çünki qürurlu, təkəbbürlü adamları","poem":1},{"lineBreak":true},{"text":"Sənin arandan uzaqlaşdıracağam,","poem":1},{"lineBreak":true},{"text":"Müqəddəs dağımda bir daha təkəbbürlü olmayacaqsan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sizin aranızda itaətkar və məzlum bir xalqı sağ qoyacağam,","poem":1},{"lineBreak":true},{"text":"Onlar Rəbbin adına pənah gətirəcək.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"İsraildən sağ qalanlar haqsızlıq etməyəcək!","poem":1},{"lineBreak":true},{"text":"Kimsəni aldadaraq yalan söyləməyəcəklər,","poem":1},{"lineBreak":true},{"text":"Çünki onlar qarnı tox yatacaq,","poem":1},{"lineBreak":true},{"text":"Onları qorxudan olmayacaq».","poem":1}]},{"type":"heading","content":["Sevinc nəğməsi"]},{"type":"verse","number":14,"content":[{"text":"Ey Sion qızı, tərənnüm elə,","poem":1},{"lineBreak":true},{"text":"Ey İsrail, uca səslə çığır!","poem":1},{"lineBreak":true},{"text":"Ey Yerusəlim qızı, bütün qəlbinlə sevin və fərəhlən!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rəbb sənin cəzanı ləğv etdi, düşmənlərini qovdu!","poem":1},{"lineBreak":true},{"text":"İsrailin padşahı Rəbb səninlədir,","poem":1},{"lineBreak":true},{"text":"Artıq pislikdən qorxmayacaqsan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"O gün Yerusəlimə deyiləcək:","poem":1},{"lineBreak":true},{"text":"«Qorxma, ey Sion, qoy əllərin taqətdən düşməsin!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Allahın Rəbb,","poem":1},{"lineBreak":true},{"text":"Qüvvətli Qurtarıcın səninlədir!","poem":1},{"lineBreak":true},{"text":"O sənin üçün sevinib şadlanacaq,","poem":1},{"lineBreak":true},{"text":"Səni məhəbbəti ilə yeniləşdirəcək,","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Sənin üçün tərənnümlə coşacaq!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bayram gününü qeyd edən kimi","poem":1},{"lineBreak":true},{"text":"Mən sənin üzərindən bəlaları götürəcəyəm ki,","poem":1},{"lineBreak":true},{"text":"Onlara görə xəcalətli olmayasan.","poem":1},{"noteId":4}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Budur, vaxt gəlir,","poem":1},{"lineBreak":true},{"text":"Mən sizə zülm edənlərin hamısını cəzalandıracağam,","poem":1},{"lineBreak":true},{"text":"Şikəstləri qurtaracağam, sürgünləri yığacağam,","poem":1},{"lineBreak":true},{"text":"Bütün dünyada çəkdikləri xəcaləti","poem":1},{"lineBreak":true},{"text":"Şan-şöhrətə çevirəcəyəm.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O zaman sizi toplayıb yurdunuza geri qaytaracağam.","poem":1},{"lineBreak":true},{"text":"Görəcəksiniz, Mən sizi yenə firavan edəndə","poem":1},{"lineBreak":true},{"text":"Bütün dünya xalqları arasında","poem":1},{"lineBreak":true},{"text":"Sizə şan-şöhrət verəcəyəm»","poem":1},{"lineBreak":true},{"text":"Rəbb deyir.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Səni məhəbbəti ilə yeniləşdirəcək – qədim yunan və süryani tərcümələrində belədir, ibrani mətnində isə məhəbbəti ilə susacaq.","reference":{"chapter":3,"verse":17}},{"noteId":4,"caller":"+","text":"Bayram gününü … olmayasan – qədim yunan tərcüməsində belədir, ibrani mətnində isə bayramlar üçün kədərlənənləri səndən yığacağam.","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/azb_bsa/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/azb_bsa/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/azb_bsa/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}