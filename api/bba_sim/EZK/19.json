{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"EZK","translationId":"bba_sim","name":"Esekiɛli","commonName":"Esekiɛli","title":"ESEKIƐLI","order":26,"numberOfChapters":48,"sha256":"eae6eec2dcc03441ca3d568cd04f2ce2be2d90c667c629b587068f40c9163256","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bba_sim/EZK/48.json","totalNumberOfVerses":1267},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Yinni Gusunɔ u nɛɛ, ɑ ɡɔɔ swĩiyɔ Isirelibɑn sinɑ bibun sɔ̃, ɑ nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"ben mɛro u sɑ̃ɑwɑ nɡe ɡbee sunɔ niu ɡeu","poem":1},{"lineBreak":true},{"text":"ɡe bɑ yɛ̃ ɡbee sinɑnsun suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Gɑ rɑ n ɡen binu kpunɛwɑ","poem":1},{"lineBreak":true},{"text":"ɡɑ n nu diisiɑmɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ ɡɑ ɡen buu teu seeyɑ","poem":1},{"lineBreak":true},{"text":"ɡɑ kuɑ kpɛmbu.","poem":1},{"lineBreak":true},{"text":"Gɑ ɡu yɑɑ mwɑɑbu sɔ̃ɔsi,","poem":1},{"lineBreak":true},{"text":"mɑ ɡɑ tɔmbu sɛ̃sukum wɔri.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ye sɔbɑ ɡen ɡɑri nuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ɡu yinɑ bɛriɑ.","poem":1},{"lineBreak":true},{"text":"Yerɑ bɑ ɡu mwɑ kɑ kɔkɔru","poem":1},{"lineBreak":true},{"text":"bɑ kɑ dɑ Eɡibitiɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑ ɡen mɛro ɡɑ mɑrɑ ɡu wurɑmɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ɡɑ tɛmɑnɑbu kpɑnɑ,","poem":1},{"lineBreak":true},{"text":"ɡɑ wɑ n ǹ koorɔ.","poem":1},{"lineBreak":true},{"text":"Yen biruwɑ ɡɑ mɑɑ ɡen buu teu suɑ","poem":1},{"lineBreak":true},{"text":"ɡɑ seeyɑ ɡɑ dɑm kuɑ,","poem":1},{"lineBreak":true},{"text":"ɡɑ kuɑ ɡbee sunɔ kpɛmbu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɑ ɡɑ wɔri ɡbee sinɑnsun wuuru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Gɑ yɑɑ mwɑɑbu mɛɛrɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ ɡɑ tɔmbu sɛ̃sukum wɔri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gɑ tem min sinɑ kpɑɑru wɔri ɡɑ surɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ mɛn wusu kuɑ bɑnsu.","poem":1},{"lineBreak":true},{"text":"Mɑ tɔmbu kɑ ye yɑ wɑ̃ɑ tem mɛ sɔɔ kpuro","poem":1},{"lineBreak":true},{"text":"yɑ bɛrum soorɑ ɡen kukiribun sɔ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ bwesenu nu mɛnnɑ","poem":1},{"lineBreak":true},{"text":"nu kɑ ɡu tɑbu kuɑ.","poem":1},{"lineBreak":true},{"text":"Bwese ni, nu nɑwɑ yɑm kpuron di.","poem":1},{"lineBreak":true},{"text":"Bɑ ɡu suurɑ kuɑ ɡɑ wɔri.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɑ bɑ ɡen wɛ̃ru yɑbɑ","poem":1},{"lineBreak":true},{"text":"bɑ tɑɑbu doke","poem":1},{"lineBreak":true},{"text":"bɑ ɡu sɔri diru ɡɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yen biru bɑ kɑ ɡu dɑ Bɑbilonin sinɑ bokon mi.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ ɡu kɛnusi","poem":1},{"lineBreak":true},{"text":"sere bɑ ǹ mɑɑ ɡen kukiribu nɔɔmɔ Isirelibɑn ɡuunɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u mɑɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"ben mɛro u sɑ̃ɑwɑ nɡe resɛm","poem":1},{"lineBreak":true},{"text":"ye bɑ duurɑ dɑɑ torɑn bɔkuɔ.","poem":1},{"lineBreak":true},{"text":"Resɛm ye, yɑ rɑ mɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ mɑɑ kɑ̃ɑsi yibɑ nim mɛ yɑ wɑɑmɔn sɔ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yɑ kɑ̃ɑsi dɑmɡii mɔ yi bɑ koo kpĩ bu kɑ sinɑ dɛki ko.","poem":1},{"lineBreak":true},{"text":"Yɑ wɑɑbu wɑ̃, yen ɡunum kɑ yen kɑ̃ɑsi dɑbinun sɔ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɑ ye wukɑ kɑ mɔru","poem":1},{"lineBreak":true},{"text":"bɑ surɑ temɔ.","poem":1},{"lineBreak":true},{"text":"Woo ɡe ɡɑ wee sɔ̃ɔ yɑri yerun di,","poem":1},{"lineBreak":true},{"text":"ɡɑ yen mɑrum ɡberɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Yen kɑ̃ɑsi dɑmɡii yi, yi ɡberɑ yi dɔ̃ɔ mwɑɑrɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tɛ̃ yɑ ɡire tem ɡbebum sɔɔ","poem":1},{"lineBreak":true},{"text":"mi ɡɑ̃ɑnu ku rɑ kpi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɑ dɔ̃ɔ u yɑrɑ sɑɑ yen kɑ̃ɑsin di","poem":1},{"lineBreak":true},{"text":"u yen mɑrum mwɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ ǹ mɑɑ kɑ̃ɑsɑ dɑmɡiɑ mɔ","poem":1},{"lineBreak":true},{"text":"ye yɑ koo ko sinɑ dɛkɑ.","poem":1},"Womu ɡeni ɡɑ sɑ̃ɑwɑ ɡɔɔ wuri. Geyɑ bɑ ko n dɑ ko bɑ̀ n ɡɔɔ wuri mɔ̀."]},{"type":"heading","content":["Isirelibɑ"]},{"type":"heading","content":["bɑ Yinni Gusunɔ seesi"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}