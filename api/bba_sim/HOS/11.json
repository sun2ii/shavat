{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"HOS","translationId":"bba_sim","name":"Osee","commonName":"Osee","title":"OSEE","order":28,"numberOfChapters":14,"sha256":"97cbb14a4000c30df8aa7f03914e95562525e66a838288db8bc3b5f1e267223f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bba_sim/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"sɑɑ Isirelin bweserun torubun diyɑ nɑ tu kĩɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ tu yɑrɑmɑ Eɡibitin di nɑ tu sokɑ nɛn bii.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɡe mɛ nɑ bu sokumɔ","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ bɑ kɑ mɑn tondɑmɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ dɑ bɑ bũu ni bɑ mɔ̀ Bɑɑli sɑ̃ɑmɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ nu turɑre dɔ̃ɔ dokeɑmmɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N deemɑ nɛnɑ nɑ bu kpɑre,","poem":1},{"lineBreak":true},{"text":"nɑ ben nɔmɑ nɛni.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ bɑ ǹ tubɑ","poem":1},{"lineBreak":true},{"text":"mɑ nɛnɑ nɑ bu nɔɔrimɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ bu ɡɑwɑmɑ nɛn mi kɑ kĩru","poem":1},{"lineBreak":true},{"text":"mɑ nɑ bu dĩɑnu wɛ̃","poem":1},{"lineBreak":true},{"text":"nɡe wi u yɑɑ sɑbenun suɡu yiiyɑmɔ u kɑ nu nɔɔri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɑ yinɑ bu nɑ nɛn mi.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɑ nɛɛ, bɑ koo dɑ Eɡibitiɔ","poem":1},{"lineBreak":true},{"text":"kpɑ Asiriɡii u ko ben sunɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɑ koo ben wusu tɑbu wɔri,","poem":1},{"lineBreak":true},{"text":"kpɑ bu ben dɑmɡibu kɔsuku","poem":1},{"lineBreak":true},{"text":"yèn sɔ̃ bɑ ben tiin kpunɑɑ swĩi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wee nɛn tɔmbu bɑ yɔ̃rɑri bu kɑ mɑn tondɑ.","poem":1},{"lineBreak":true},{"text":"Bɑ bu sokɑ bu ɡɔ̃ru ɡɔsiɑ bu wurɑmɑ nɛ, Wɔrukoon mi.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ben ɡoo kun wure.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɑ mɛ, bɛɛ Isirelibɑ,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ kpɛ̃ n bɛɛ deri,","poem":1},{"lineBreak":true},{"text":"n bɛɛ tɔnu kɑndu kuɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ kpɛ̃ n bɛɛ kɑm koosiɑ","poem":1},{"lineBreak":true},{"text":"nɡe mɛ nɑ wuu si bɑ mɔ̀ Adimɑ kɑ Seboimu kuɑ.","poem":1},{"lineBreak":true},{"text":"Wee nɛn ɡɔ̃ru ɡɑ sɑnkire,","poem":1},{"lineBreak":true},{"text":"nɛn bwɛ̃rɑ kun kpunɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ ǹ mɑɑ bɛɛ kpeerɑsiɑmɔ kɑ nɛn mɔru bɑkɑ ye.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ mɑɑ wee n bɛɛ kɑm koosiɑ.","poem":1},{"lineBreak":true},{"text":"Domi nɑ sɑ̃ɑwɑ Gusunɔ n ǹ mɔ tɔnu.","poem":1},{"lineBreak":true},{"text":"Nɑ sɑ̃ɑwɑ Dɛɛro bɛɛn suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ bɛɛ wɔrim wee kɑ mɔru.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛɛ nɛn bibu, i ko nɛ, Yinni Gusunɔ swĩi","poem":1},{"lineBreak":true},{"text":"nɑ̀ n kukurɑ nɡe ɡbee sunɔ","poem":1},{"lineBreak":true},{"text":"kpɑ i duki nɑ sɑɑ sɔ̃ɔ duu yerun di.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ko duki nɑ sɑɑ Eɡibitin di nɡe ɡunɔ mɔri","poem":1},{"lineBreak":true},{"text":"kpɑ i nɑ sɑɑ Asirin di nɡe totobɛrɛnu,","poem":1},{"lineBreak":true},{"text":"kpɑ n de i sinɑ bɛɛn yɛnusɔ.","poem":1},{"lineBreak":true},{"text":"Nɛ, Yinni Gusunɔwɑ nɑ yeni ɡeruɑ.","poem":1}]},{"type":"heading","content":["Sɑɑ yellun diyɑ Isirelibɑ"]},{"type":"heading","content":["bɑ Gusunɔn nuki sɑnkɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":11}