{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"HOS","translationId":"bba_sim","name":"Osee","commonName":"Osee","title":"OSEE","order":28,"numberOfChapters":14,"sha256":"97cbb14a4000c30df8aa7f03914e95562525e66a838288db8bc3b5f1e267223f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bba_sim/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Isirelibɑ bɑ sɔ̃ɔnɑ bɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"i nɑ su ɡɔsirɑ Yinni Gusunɔn mi.","poem":1},{"lineBreak":true},{"text":"Wee u sun so u mɛɛrɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ u koo bɛsɛn mɛɛrɑ ye nɔɔri u sun bɛkiɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ǹ mɑɑ tɛɛmɔ u kɑ sun wɑ̃ɑru wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ sɑ n wɑ̃ɑ win wuswɑɑɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I de su kɑsu su nùn ɡiɑ.","poem":1},{"lineBreak":true},{"text":"Nɡe mɛ sɑ rɑ n yɛ̃ kɑm kɑm mɑ sɔ̃ɔ u koo yɑri,","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ sɑ n mɑɑ yɛ̃ mɑ u koo nɑ.","poem":1},{"lineBreak":true},{"text":"U koo nɑwɑ nɡe tom buruku ɡurɑ ye yɑ rɑ tem yɛmiɑsie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"bɛɛ Yudɑbɑ kɑ Isirelibɑ, mbɑ kon bɛɛ kuɑ.","poem":1},{"lineBreak":true},{"text":"Wee bɛɛn kĩru nɛn sɔ̃ tɑ sɑ̃ɑwɑ nɡe bururun kɑkoru","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ nɡe dirum mɛ mu rɑ yɑrinɛ fuuku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ kon bɛɛ nɛn sɔmɔbu ɡɔriɑmɑ","poem":1},{"lineBreak":true},{"text":"bu bɛɛ sɔ̃ mɑ kon bɛɛ sɛɛyɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bu mɑɑ bɛɛ sɔ̃ mɑ kon bɛɛ ɡo.","poem":1},{"lineBreak":true},{"text":"Nɛn siribu bu koo sɔ̃ɔsirɑ nɡe yɑm bururɑm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi wɔnwɔndɑ nɑ kĩ, n ǹ mɔ yɑ̃kuru.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ nɑ mɑɑ kĩ nɛn tɔmbu bu mɑn ɡiɑ","poem":1},{"lineBreak":true},{"text":"n kere bu mɑn yɑ̃ku dɔ̃ɔ mwɑɑrɑruɡinu kuɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɑ nɛn ɑrukɑwɑni kusiɑ nɡe mɛ tɔmbu bɑ rɑ n kuɑnɑmmɛ.","poem":1},{"lineBreak":true},{"text":"Wee bɑ mɑn tɔnu kɑndu kuɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gɑlɑdiɡibu bɑ sɑ̃ɑwɑ tɔn kɔ̃sobu","poem":1},{"lineBreak":true},{"text":"mɑ bɑ yɛm yɑri bɑɑmɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɡe mɛ swɑɑ diobu bɑ rɑ n swɑɑ mɑrɑ,","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ yɑ̃ku kowobun wuuru tɑ wɑ̃ɑ Sikɛmun swɑɑɔ tɑ tɔmbu ɡoomɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɑ ɡɑ̃ɑ kɔ̃sunu wɑ Isireliɔ,","poem":1},{"lineBreak":true},{"text":"niyɑ bɑ bũnu ɡɑsirimɔ,","poem":1},{"lineBreak":true},{"text":"bɑ tii disi dokemɔ nɡe sɑkɑrɑ kowo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɑɑ yɑ sisi yè sɔɔ kon mɑɑ bɛɛ Yudɑbɑ sɛɛyɑsiɑ.","poem":1},"Isirelibɑ kɑ bwese tukunu",{"text":"Yinni Gusunɔ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"sɑnɑm mɛ nɑ kĩ nɛn tɔmbu Isirelibɑ bu wurɑmɑ yorun di,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}