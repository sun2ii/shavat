{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"HOS","translationId":"bba_sim","name":"Osee","commonName":"Osee","title":"OSEE","order":28,"numberOfChapters":14,"sha256":"97cbb14a4000c30df8aa7f03914e95562525e66a838288db8bc3b5f1e267223f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bba_sim/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"i kɔbɑ soowo.","poem":1},{"lineBreak":true},{"text":"Wee yibɛrɛbɑ bɑ nɛn sɑ̃ɑ yeru wuusimɑ nɡe kɑsi.","poem":1},{"lineBreak":true},{"text":"Domi Isirelibɑ bɑ nɛn ɑrukɑwɑni kusiɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ nɛn sɔ̃ɔsiru yinɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɑ koo mɑn nɔɔɡiru suemɑ bu nɛɛ,","poem":1},{"lineBreak":true},{"text":"bɑ nɛ ben Yinni yɛ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɑ ɡeɑ deri,","poem":1},{"lineBreak":true},{"text":"mɑ yibɛrɛbɑ bɑ koo bu nɑɑ swĩi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ tii sinɑmbu kuɑ","poem":1},{"lineBreak":true},{"text":"bɑ ǹ mɑn sɑɑwɑrɑ kue.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ bũnu sekɑ kɑ sii ɡeesu kɑ wurɑ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ bɑ koo kɑm ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛɛ Sɑmɑriɡibu, nɑ bɛɛn nɑɑ wurɑɡiɑ ye tusɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑɑ kɑ bɛɛ mɔru mɔ̀.","poem":1},{"lineBreak":true},{"text":"Sɑɑ yerɑ̀ i ko i sinɑ bɑ ku n bɛɛ tɑɑrɛ wɛ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wi u bwɑ̃ɑrokunun sɔmburu yɛ̃ Isirelibɑ sɔɔ","poem":1},{"lineBreak":true},{"text":"wiyɑ u nɑɑ wurɑɡiɑ ye kuɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ ǹ sɑ̃ɑ Gusunɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ bɑ koo ye kɔsuku muku muku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wee i woo duurɑ,","poem":1},{"lineBreak":true},{"text":"yen sɔ̃nɑ i ko i woo bɔkɔ ɡɛ̃.","poem":1},{"lineBreak":true},{"text":"Mɔndu ɡɑrɑ nɛɛ, dobi bɛm sɑri ku rɑ n som mɔ.","poem":1},{"lineBreak":true},{"text":"I n mɑɑ yɛ̃ mɑ bɛɛn ɡbeɑn dĩɑnu nù n dɑɑ ɡeɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"sɔbɑ bɑ koo nu ɡurɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Isirelibɑ bɑ derɑ bɑ bu mwɛ.","poem":1},{"lineBreak":true},{"text":"Be wee bwesenu sɔɔ nɡe weke te ɡoo kun mɑɑ kĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi bɑ dɑ Asiriɔ nɡe ɡbeeku kɛtɛku ɡe ɡɑ tii kpɑre.","poem":1},{"lineBreak":true},{"text":"Bɑ dɑ bɑ somiru kɑsu mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɑ bwese tukunu ɡobi kɔsiɑ bɑ n kɑ nɔɔ tiɑ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ kɑ mɛ, kon bu mɛnnɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ Asirin sinɑ boko u bu yoo sɔmɑ koosiɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isirelibɑ bɑ bũu turɑnu kuɑ nu dɑbi.","poem":1},{"lineBreak":true},{"text":"Niyɑ nu derɑ bɑ durum mɔ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɑɑ nɑ̀ n bu nɛn woodɑbɑ yoruɑ sere kɑ yen ɡɑri piiminɔ,","poem":1},{"lineBreak":true},{"text":"bɑ rɑ ye ɡɑrisiwɑ nɡe ye yɑ wee tɔn tukon min di.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bɑ rɑ yɛɛ ɡo bu kɑ mɑn yɑ̃kuru kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu yin yɑɑ tem.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ben yɑ̃ku ni, nu ǹ mɑn doremɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ben torɑnu duɑri.","poem":1},{"lineBreak":true},{"text":"Kon bu sɛɛyɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ bɑ koo ɡɔsirɑ bu dɑ Eɡibitiɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isirelibɑ bɑ tii sinɑ kpɑɑru bɑniɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ nɛ ben tɑkɑ kowo duɑri.","poem":1},{"lineBreak":true},{"text":"Yudɑbɑ bɑ mɑɑ ben wuu dɑbinu ɡbɑ̃rɑru toosi.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ kon ben wusu dɔ̃ɔ sɔkiri kpɑ u ben dii ɡeenu di.","poem":1}]},{"type":"heading","content":["Yinni Gusunɔn tɔmbu"]},{"type":"heading","content":["bɑ koo kpuro biɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}