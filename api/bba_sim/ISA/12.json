{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Sɔ̃ɔ teeru, be bɑ yɑkiɑrɑ bɑ koo nɛɛ,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, sɑ nun siɑrɑ,","poem":1},{"lineBreak":true},{"text":"domi ɑ rɑɑ kɑ sun mɔru kuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ wunɛn mɔru yɑ sure.","poem":1},{"lineBreak":true},{"text":"A sun nukuru yɛmiɑsiɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ sɑ̃ɑ bɛsɛn Yinni, ɑ sun fɑɑbɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Sɑ nun nɑɑnɛ sɑ̃ɑ, sɑ ǹ mɑɑ ɡɑ̃ɑnun bɛrum mɔ.","poem":1},{"lineBreak":true},{"text":"Domi wunɑ ɑ sɑ̃ɑ bɛsɛn dɑm, wunɑ sɑ siɑrɑmɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ sɑ̃ɑ bɛsɛn fɑɑbɑ kowo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɡe mɛ wi nim nɔru ɡɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"ù n nim wɑ, u rɑ n nuku dobu mɔ,","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ bɑ̀ n fɑɑbɑ wɑ bɑ koo nuku dobu ko,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kpɑ tɔ̃ɔ te sɔɔ, bu ɡere bu nɛɛ,","poem":1},{"lineBreak":true},{"text":"i Yinni Gusunɔ siɑro,","poem":1},{"lineBreak":true},{"text":"i win yĩsiru wɔlle suo.","poem":1},{"lineBreak":true},{"text":"I win sɔm bɑkɑ ni u kuɑ kpɑro bwesenu kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"I tɔmbu yɑɑyɑsio mɑ win yĩsirɑ kpɑ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔ tɔmɔ,","poem":1},{"lineBreak":true},{"text":"domi ɡɑ̃ɑ bɛɛrɛɡinɑ u kuɑ.","poem":1},{"lineBreak":true},{"text":"I nin ɡɑri kpɑro hɑnduniɑ kpuro sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Be bɑ wɑ̃ɑ Siɔniɔ, bu nuku dobun kuuki koowo,","poem":1},{"lineBreak":true},{"text":"domi Isirelibɑn Yinni Dɛɛro u kpɑ̃,","poem":1},{"lineBreak":true},{"text":"u mɑɑ wɑ̃ɑ ben suunu sɔɔ.","poem":1}]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["u koo Bɑbiloni sɛɛyɑsiɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}