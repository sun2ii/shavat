{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":15,"content":[{"type":"heading","content":["Mɔɑbubɑn nɔni swɑ̃ɑru"]},{"type":"verse","number":1,"content":[{"text":"Gɑri yiniwɑ bɑ ɡeruɑ Mɔɑbubɑn sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɔɑbun tem kpuro mu koo kɑm ko,","poem":1},{"lineBreak":true},{"text":"kpɑ bu Ari Mɔɑbu kɑ Kiri Mɔɑbu kɔsuku wɔ̃ku teeru.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Diboniɡibu bɑ dɑ bũu sɑ̃ɑ yerɔ","poem":1},{"lineBreak":true},{"text":"kɑ ɡuunu wɔllɔ bu kɑ swĩ.","poem":1},{"lineBreak":true},{"text":"Mɔɑbubɑ bɑ weeweenu mɔ̀ wuu si bɑ mɔ̀ Nɛbo kɑ Mɛdebɑn sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ ben winu kɑ ben tobunu kɔnɑ nuku sɑnkirɑnun sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɑ bɑ sɑɑkibɑ sebuɑ bɑ wɑ̃ɑ swɛɛ sɔɔ","poem":1},{"lineBreak":true},{"text":"kɑ dii tɛɛriɔ kɑ dii yɑɑriɔ nuku sɑnkirɑnun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ weeweenu mɔ̀ bɑ sumɔ kɑ nɔni yĩresu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hɛsiboniɡibu kɑ Eleɑleɡibu bɑ fɑɑbɑ kɑnɑmɔ","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ben nɔɔ nɔɔmɔ sere Yɑhɑsiɔ.","poem":1},{"lineBreak":true},{"text":"Bɑɑ Mɔɑbun tɑbu kowobun tii bɑ wuri mɔ̀wɑ bɛrum sɔ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ fɑɑbɑ kɑnɑmɔ Mɔɑbubɑn sɔ̃","poem":1},{"lineBreak":true},{"text":"be bɑ kpikiru suɔ bɑ dɔɔ Soɑriɔ kɑ Eɡɑlɑti Selisiyɑɔ.","poem":1},{"lineBreak":true},{"text":"Domi bɑ sumɔ bɑ kɑ Lusitin ɡuunu yɔɔmɔ,","poem":1},{"lineBreak":true},{"text":"bɑ wuri mɔ̀ Koronɑimun swɑɑɔ nuku sɑnkirɑnun sɔ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dɑɑ te bɑ mɔ̀ Nimurimu ten nim mu ɡberɑ.","poem":1},{"lineBreak":true},{"text":"Yɑkɑ si su wɑ̃ɑ ten ɡɑ̃ɑrɔ su ɡberɑ.","poem":1},{"lineBreak":true},{"text":"Gɑ̃ɑnu kun mɑɑ kpiɑ mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ bɑ ben ɑrumɑni ɡurɑ","poem":1},{"lineBreak":true},{"text":"ye yɑ bu tie","poem":1},{"lineBreak":true},{"text":"bɑ kɑ tɔburɑmɔ nim torɑn ɡuru ɡiɔ mi dɑ̃nu wɑ̃ɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɔɑbubɑn tem nɔɔ burɑ yenu","poem":1},{"lineBreak":true},{"text":"kpuro sɔɔ, wuri nɔɔrɑmɔ.","poem":1},{"lineBreak":true},{"text":"Ben weeweenu nu nɔɔrɑmɔ sere Eɡɑlɑimuɔ, kɑ mɑɑ Elimun dɔkɔwɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dɑɑ te tɑ wɑ̃ɑ Dimɔniɔ ten nim","poem":1},{"lineBreak":true},{"text":"mu yɛm yibɑ tɔn be bɑ ɡon sɔ̃.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ u koo kpɑm Dimɔni ye nɔni swɑ̃ɑru kpɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"U koo de yibɛrɛbɑ bu Mɔɑbun kpikobu,","poem":1},{"lineBreak":true},{"text":"kɑ be bɑ tie tem mɛ sɔɔ wɔri nɡe ɡbee sinɑnsu.","poem":1}]},{"type":"heading","content":["Mɔɑbubɑ bɑ Yerusɑlɛmuɡibu"]},{"type":"heading","content":["somiru kɑnɑmɔ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}