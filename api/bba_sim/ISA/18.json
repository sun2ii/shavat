{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Tem mu wɑ̃ɑ Etiopin dɑɑrun berɑ ɡiɔ,","poem":1},{"lineBreak":true},{"text":"mi tɑbun wurenu nɔɔrɑmɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛn tɔmbu bɑ ɡunu mɑ ben wɑsi bɑllimɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ bu nɑsie bɑɑmɑ kpuro,","poem":1},{"lineBreak":true},{"text":"yèn sɔ̃ bɑ rɑ kpuro kɔsuku.","poem":1},{"lineBreak":true},{"text":"Mɑ dɑɑnu ben tem burɑnɛ.","poem":1},{"lineBreak":true},{"text":"Beyɑ bɑ sɔmɔbu ɡɔrɑ kɑ ɡoo nimkuu si bɑ kuɑ kɑ ɡbĩi.","poem":1},{"lineBreak":true},{"text":"Goo nimkuu si, su dukɑ mɔ.","poem":1},{"lineBreak":true},{"text":"Tɛ̃, sɔmɔbu bɛɛ, i wuro bɛɛɡibun mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛɛ hɑnduniɑɡibu kpuro,","poem":1},{"lineBreak":true},{"text":"i ɡidi bɔrɑ mɛɛrio ye bɑ koo ɡirɑ ɡuuru wɔllɔ.","poem":1},{"lineBreak":true},{"text":"I kɔbɑn swĩi swɑɑ dɑkio ye bɑ koo so.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi ɑmɛniwɑ Yinni Gusunɔ u mɑn sɔ̃ɔwɑ. U nɛɛ,","poem":1},{"lineBreak":true},{"text":"u yɔ̃ sɛ̃ɛ u yɑm mɛɛrɑ kɑ lɑɑkɑri win wɑ̃ɑ yerun di","poem":1},{"lineBreak":true},{"text":"sɔ̃ɔ sɑ̃rerun sɑɑ kɑ wuburun sɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Resɛm yɑ̀ n wɛ̃su kuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ yɑ bɛm doke yɑ ye,","poem":1},{"lineBreak":true},{"text":"bu sere ye sɔri,","poem":1},{"lineBreak":true},{"text":"yibɛrɛ u koo nɑ u yen kɑ̃ɑsi bɔɔri kɑ woburu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kpɑ u ye ɡunɔsu kɑ ɡbeeku yɛɛ deriɑ yi di.","poem":1},{"lineBreak":true},{"text":"Gunɔsu su ko n wɑ̃ɑ mi, yɑm susurun sɑɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɡbeeku yɛɛ yi n wɑ̃ɑ mi purɑn sɑɑ.","poem":1},{"lineBreak":true},{"text":"Nɡe mɛyɑ bɑ koo Asiriɡibun tɑbu kowobun ɡonu kuɑ.","poem":1}]},{"type":"verse","number":7,"content":["Sɑɑ ye sɔɔ, tɔn be bɑ ɡunu mi, mɑ ben wɑsi bɑllimɔ bɑ bu nɑsie bɑɑmɑ kpuro yèn sɔ̃ bɑ rɑ kpuro kɔsuku, mɑ dɑɑnu ben tem burɑnɛ, tɔn be, bɑ koo kɑ Gusunɔ wɔllu kɑ tem Yinni kɛ̃nu nɑɑwɑ Siɔnin ɡuurɔ mi bɑ rɑ nùn sɑ̃."]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["u koo Eɡibitiɡibu sɛɛyɑsiɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}