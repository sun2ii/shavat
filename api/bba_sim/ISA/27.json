{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Tɔ̃ɔ te sɔɔ, Yinni Gusunɔ u koo wɑɑ kɔ̃sɑ ye yɑ dukɑ mɔ sɛɛyɑsiɑ kɑ win tɑkobi dɑmɡiɑ ye yɑ kpɑ̃, kpɑ u yɑɑ kɔ̃sɑ ye ɡo, ye yɑ wɑ̃ɑ nim wɔ̃ku sɔɔ."]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["kɑ win resɛm ɡbɑɑru"]},{"type":"verse","number":2,"content":[{"text":"Yen tɔ̃ɔ te, Yinni Gusunɔ u koo womu ko","poem":1},{"lineBreak":true},{"text":"win resɛm ɡbɑɑrun sɔ̃, te tɑ bii ɡeenu mɑrumɔ, u nɛɛ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"nɛ, Yinni Gusunɔwɑ nɑ tu nɔɔrimɔ.","poem":1},{"lineBreak":true},{"text":"Nɛnɑ nɑ tu nim yɛ̃kɑmɔ sɑɑ kpuro.","poem":1},{"lineBreak":true},{"text":"Nɑ tu kɔ̃su sɔ̃ɔ sɔɔ kɑ wɔ̃kuru,","poem":1},{"lineBreak":true},{"text":"ɡoo u ku rɑɑ kɑ tu wɔri u mwɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ ǹ mɑɑ kɑ nɛn resɛm ɡbɑɑ te mɔru sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ nɑ̀ n sɑ̃ki kɑ ɑwĩi wɑ mi,","poem":1},{"lineBreak":true},{"text":"kon yi wɔriwɑ n dɔ̃ɔ mɛni,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mɑ n kun mɔ yi mɑn kuɑ yin kuku yeru,","poem":1},{"lineBreak":true},{"text":"mɑ yi kɑ mɑn nɔɔ tiɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Yì n kuɑ mɛ, kon yi deri.","poem":1}]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["u koo Isirelibɑ suuru kuɑ"]},{"type":"verse","number":6,"content":[{"text":"Sɑɑ ɡɑɑ sisi yè sɔɔ","poem":1},{"lineBreak":true},{"text":"Isirelibɑ bɑ koo ɡbini ɡirɑ","poem":1},{"lineBreak":true},{"text":"bu kɛri ko nɡe dɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"bu wɛ̃su ko bu mɑ","poem":1},{"lineBreak":true},{"text":"kpɑ ben binu nu hɑnduniɑ yibu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u ǹ bu sɛɛyɑsie","poem":1},{"lineBreak":true},{"text":"nɡe mɛ u ben yibɛrɛbɑ sɛɛyɑsiɑ.","poem":1},{"lineBreak":true},{"text":"U ǹ mɑɑ bu ɡo nɡe mɛ u ben yibɛrɛbɑ ɡo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"U bu sɛɛyɑsiɑwɑ sɑkɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"U derɑ yibɛrɛbɑ bɑ nɑ","poem":1},{"lineBreak":true},{"text":"nɡe sɔ̃ɔ yɑri yerun woo dɑmɡuu,","poem":1},{"lineBreak":true},{"text":"bɑ bu ɡurɑ bɑ kɑ doonɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɡe mɛyɑ u kɑ Isirelibɑn durum wɔkɑ.","poem":1},{"lineBreak":true},{"text":"Wee ye n koorɑ yen biru.","poem":1},{"lineBreak":true},{"text":"U ben bũu turɑnu ɡɔsiɑ torom.","poem":1},{"lineBreak":true},{"text":"Bɑ ǹ mɑɑ Asitɑɑten bwɑ̃ɑrokunu kɑ sɔ̃ɔɡinu seeyɑmɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ben wuu dɑmɡuu ɡe,","poem":1},{"lineBreak":true},{"text":"ɡɑ kuɑ bɑnsu, bɑ ɡu deri.","poem":1},{"lineBreak":true},{"text":"Miyɑ n kuɑ yɑɑ sɑbenun kpɑrɑ yeru","poem":1},{"lineBreak":true},{"text":"kɑ nin kpin yeru.","poem":1},{"lineBreak":true},{"text":"Mɑ nu kiku si su tiɑrɑ dimɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dɑ̃ɑ yɑ̀ n ɡberɑ bɑ rɑ ye bɔɔriwɑ","poem":1},{"lineBreak":true},{"text":"kpɑ tɔn kurɔbu bu kɑ doo ko.","poem":1},{"lineBreak":true},{"text":"Wee nɛn tɔn be, bɑ ǹ bwisi mɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ Yinni Gusunɔ wi u bu tɑkɑ kuɑ","poem":1},{"lineBreak":true},{"text":"u ǹ bu wɔnwɔndu kue,","poem":1},{"lineBreak":true},{"text":"u ǹ mɑɑ bu durom kue.","poem":1}]},{"type":"heading","content":["Be bɑ rɑɑ yoru mwɛɛrɑ"]},{"type":"heading","content":["bɑ koo wurɑmɑ"]},{"type":"verse","number":12,"content":[{"text":"Sɑɑ ɡɑɑ sisi yè sɔɔ Yinni Gusunɔ u koo bɛɛ Isirelibɑ sirɑ nɡe dɑ̃ru,","poem":1},{"lineBreak":true},{"text":"kpɑ bu bɛɛ dɔbiri tiɑ tiɑ","poem":1},{"lineBreak":true},{"text":"sɑɑ Efɑrɑtin dɑɑrun di n kɑ ɡirɑri Eɡibitin dɑɑrɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yen tɔ̃ɔ te, bɑ koo kɔbi bɑkɑ so","poem":1},{"lineBreak":true},{"text":"kpɑ be bɑ rɑɑ yoru mwɛɛrɑ bɑ woo Asiriɔ","poem":1},{"lineBreak":true},{"text":"kɑ be bɑ kpikiru dɑ Eɡibitiɔ bu wurɑmɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bu yiirɑ bu Yinni Gusunɔ sɑ̃","poem":1},{"lineBreak":true},{"text":"ɡuu dɛɛrɑ ten mi, Yerusɑlɛmuɔ.","poem":1}]},{"type":"heading","content":["Bɑ Isirelibɑn bwese kɛri"]},{"type":"heading","content":["wɔku te kirɔ mɔ̀"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}