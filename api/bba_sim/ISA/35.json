{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"Sɑnɑm mɛ sɔɔ, tem mi ɡɑ̃ɑnu ku rɑ kpi,","poem":1},{"lineBreak":true},{"text":"mu koo tem wurɑmɑ","poem":1},{"lineBreak":true},{"text":"kpɑ mu biibii burɛ kpi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kpɑ nuku dobu bu sɔ̃ɔsirɑ mi,","poem":1},{"lineBreak":true},{"text":"kɑ womusu kɑ nɑsɑrɑn kuuki.","poem":1},{"lineBreak":true},{"text":"Mu ko n ɡirimɑ mɔ","poem":1},{"lineBreak":true},{"text":"nɡe Libɑnin dɑ̃ɑ sɔ̃ɔ.","poem":1},{"lineBreak":true},{"text":"Mu ko n bɛɛrɛ mɔ","poem":1},{"lineBreak":true},{"text":"nɡe ɡuu te bɑ mɔ̀ Kɑɑmɛli kɑ Sɑronin tem ɡem.","poem":1},{"lineBreak":true},{"text":"Sɑɑ ye sɔɔ, bɑ koo Yinni Gusunɔn yiiko wɑ","poem":1},{"lineBreak":true},{"text":"kɑ yen ɡirimɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yen sɔ̃ tɛ̃,","poem":1},{"lineBreak":true},{"text":"bɛɛ be i wɑsire, i nɔmɑ sɑ̃ɑre,","poem":1},{"lineBreak":true},{"text":"i tii tɑ̃sisio i nɔmɑ suɑ.","poem":1},{"lineBreak":true},{"text":"Bɛɛ be i diirimɔ,","poem":1},{"lineBreak":true},{"text":"i de bɛɛn dũɑ yi dɑm ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɛɛ bèn ɡɔ̃ru ɡɑ ǹ kpĩ,","poem":1},{"lineBreak":true},{"text":"i ku nɑndɑ. I tii dɑm kɛ̃ɔ.","poem":1},{"lineBreak":true},{"text":"Domi Gusunɔ bɛɛn Yinni u sisi u bɛɛ mɔru bɑrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u bɛɛn yibɛrɛbɑ kɔsie ye bɑ bɛɛ kuɑ.","poem":1},{"lineBreak":true},{"text":"Win tiiwɑ u koo nɑ u bɛɛ fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɑɑ yerɑ wɔ̃kobun nɔni koo wukiɑrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ sosobu bu ɡɑri nɔ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kpɑ kɔ̃ri kpirinuɡibu bɑ n yɔ̃ɔkumɔ nɡe kpɑsi.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ wi u ku rɑ kpĩ u ɡɑri ɡere,","poem":1},{"lineBreak":true},{"text":"win yɑrɑ koo kusiɑrɑ","poem":1},{"lineBreak":true},{"text":"kpɑ u n nɔɔɡiru mɔ̀ kɑ nuku dobu.","poem":1},{"lineBreak":true},{"text":"Nim mu koo yɑri mu koku","poem":1},{"lineBreak":true},{"text":"tem mi ɡɑ̃ɑnu ku rɑ kpi sɔɔ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kpɑ yɑni sɛɛri mi sɔ̃ɔ rɑ ɡɛm wɔ̃ yi ko yɛru,","poem":1},{"lineBreak":true},{"text":"kpɑ dɑru koki yi yɑri","poem":1},{"lineBreak":true},{"text":"mi tem mu ɡbere,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑɑ yɑri kɑ ɡbĩi yi kpi","poem":1},{"lineBreak":true},{"text":"mi ɡbeeku bɔ̃nu nu rɑ kuke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miyɑ bɑ koo swɑɑ yɑrɑ bu ye","poem":1},{"lineBreak":true},{"text":"soku dɛɛrobun swɑɑ.","poem":1},{"lineBreak":true},{"text":"Durumɡii ɡoo kun dɔɔ mi.","poem":1},{"lineBreak":true},{"text":"Be bɑ ye swĩi, bɑ ǹ kɔ̃ɔrɑmɔ,","poem":1},{"lineBreak":true},{"text":"bɑɑ be bɑ ǹ bwisi mɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbee sunɔ ǹ kun mɛ yɑɑ ɡɔbɑ ɡɑɑ kun swɑɑ ye sĩimɔ.","poem":1},{"lineBreak":true},{"text":"Be Yinni Gusunɔ u fɑɑbɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"beyɑ bɑ koo swɑɑ ye mwɑ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"bu kɑ dɑ Siɔniɔ kɑ nɑsɑrɑn womusu.","poem":1},{"lineBreak":true},{"text":"Ben wuswɑɑ yɑ n nuku dobu sɔ̃ɔsimɔ bɑɑdommɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ weeweenu kɑ nuku sɑnkirɑnu nu bu doonɑri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}