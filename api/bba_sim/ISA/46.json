{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Bũu wi bɑ mɔ̀ Bɛli, win dɑm kpeemɔ.","poem":1},{"lineBreak":true},{"text":"Wi bɑ mɑɑ mɔ̀ Nɛbo, u ǹ mɑɑ do.","poem":1},{"lineBreak":true},{"text":"Bɑ rɑ rɑɑ nu sɑ̃,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ tɛ̃, nu kuɑ kubɑ ni yɑɑ sɑbenu sɔɔwɑ.","poem":1},{"lineBreak":true},{"text":"Yɑɑ sɑbe ni, nu mɑɑ wɑsirɑ sɔmu nin sɔ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wee Bɛli kɑ Nɛbo bɑ wɔrukɑ","poem":1},{"lineBreak":true},{"text":"bɑ dɑm kpɑ sɑnnu sɑnnu.","poem":1},{"lineBreak":true},{"text":"Bɑ kpɑnɑ bu ben bwɑ̃ɑrokunu fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"Mɑ yibɛrɛbɑ bɑ nu ɡurɑ bɑ kɑ doonɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adɑmɑ i mɑn swɑɑ dɑkio,","poem":1},{"lineBreak":true},{"text":"bɛɛ Isirelibɑ, bɛɛ be i tie,","poem":1},{"lineBreak":true},{"text":"bɛɛ be nɑ nɛni nɑ nɔɔrimɔ sɑɑ bɛɛn mɑrubun di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ ǹ kɔsimɔ sere kɑ bɛɛn tɔkɔrɔ.","poem":1},{"lineBreak":true},{"text":"Ko nɑ n bɛɛ nɔɔrimɔwɑ bɑɑ ì n seri bururɑ.","poem":1},{"lineBreak":true},{"text":"Ko nɑ n bɛɛ kɔ̃suwɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ rɑɑ bɛɛ nɔɔri, kon mɑɑ wure n ye ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ n bɛɛ kɔ̃su n bɛɛ fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɑrɑ i ko kɑ mɑn sweenɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ i nùn ko nɛn sɑɑrɑ.","poem":1},{"lineBreak":true},{"text":"Wɑrɑ mɑɑ sɑ̃ɑ nɡe nɛ. Bũu?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wee bɑ rɑ wurɑ yɑre ben bɔɔrun di,","poem":1},{"lineBreak":true},{"text":"kpɑ bu sii ɡeesu yĩire kilo sɔɔ,","poem":1},{"lineBreak":true},{"text":"bu ye kpuro seko wɛ̃ u kɑ bu bwɑ̃ɑroku kuɑ","poem":1},{"lineBreak":true},{"text":"ɡe bɑ koo yiirɑ bu sɑ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɑ̀ n ɡu seru sɔndi bɑ kɑ dɑ","poem":1},{"lineBreak":true},{"text":"bɑ yi mi ɡɑ ko n wɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"ɡɑ ku rɑ kesi ɡen yii yerun di.","poem":1},{"lineBreak":true},{"text":"Bɑ̀ n nɔɔɡiru suɑ bɑ ɡu sokɑ,","poem":1},{"lineBreak":true},{"text":"ɡɑ ku rɑ wure.","poem":1},{"lineBreak":true},{"text":"Gɑ ku rɑ mɑɑ bu yɑre nɔni swɑ̃ɑrun di.","poem":1}]},{"type":"heading","content":["Fɑɑbɑ kun mɑɑ tomɑ"]},{"type":"verse","number":8,"content":[{"text":"Bɛɛ durumɡibu, i yenibɑ kpuro bwisikuo,","poem":1},{"lineBreak":true},{"text":"kpɑ i lɑɑkɑri ko ye nɑ kuɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I yɑɑyo ye yɑ rɑɑ koorɑ yellu.","poem":1},{"lineBreak":true},{"text":"Domi nɛnɑ Gusunɔ.","poem":1},{"lineBreak":true},{"text":"Goo mɑɑ sɑri nɡe nɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɑ ɡeruɑ yellun di ye yɑ koo koorɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ nɛɛ, nɛn himbɑ ye nɑ yi, yɑ koo koorɑ.","poem":1},{"lineBreak":true},{"text":"Kon mɑɑ nɛn kĩru kpuro yibiɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛnɑ nɑ durɔ ɡoo sokɑ","poem":1},{"lineBreak":true},{"text":"sɑɑ sɔ̃ɔ yɑri yerun di mi n tomɑ.","poem":1},{"lineBreak":true},{"text":"U koo nɑ nɡe kɑsɑ u nɛn himbɑ yibiɑ.","poem":1},{"lineBreak":true},{"text":"Ye nɑ ɡeruɑ, kon ye ko.","poem":1},{"lineBreak":true},{"text":"Himbɑ ye nɑ yi, kon mɑɑ ye yibiɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tɛ̃ i mɑn swɑɑ dɑkio,","poem":1},{"lineBreak":true},{"text":"bɛɛ bèn ɡɔ̃ru ɡɑ bɔɔbu,","poem":1},{"lineBreak":true},{"text":"mɑ i tɑmɑɑ nɛn fɑɑbɑ yɑ tomɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kon Yerusɑlɛmu fɑɑbɑ ko,","poem":1},{"lineBreak":true},{"text":"kpɑ n de Isirelibɑ bu bɛɛrɛ wɑ mi.","poem":1},{"lineBreak":true},{"text":"Ye wee, yɑ turuku kuɑ,","poem":1},{"lineBreak":true},{"text":"yɑ ǹ mɑɑ tomɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ ǹ tɛɛmɔ yu kɑ nɑ.","poem":1}]},{"type":"heading","content":["Bɑbiloni yɑ koo wɔrumɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}