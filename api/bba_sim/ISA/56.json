{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"Amɛniwɑ nɛ, Yinni Gusunɔ nɑ ɡeruɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ nɛɛ, i de i ɡem swĩi dee dee","poem":1},{"lineBreak":true},{"text":"kpɑ i n sɑ̃ɑ nɑɑnɛɡibu.","poem":1},{"lineBreak":true},{"text":"Domi nɑ kɑ fɑɑbɑ wee, nɑ ǹ tɛɛmɔ.","poem":1},{"lineBreak":true},{"text":"Kon sɔ̃ɔsi mɑ nɑ sɑ̃ɑ ɡemɡii.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u mɔ̀ ye nɑ ɡeruɑ,","poem":1},{"lineBreak":true},{"text":"mɑ u yɔ̃ dim dim u nɛn tɔ̃ɔ wɛ̃rɑruɡiru mɛm nɔɔwɑmmɛ,","poem":1},{"lineBreak":true},{"text":"mɑ u ku rɑ tu disi doke,","poem":1},{"lineBreak":true},{"text":"mɑ u tii nɛni u ku kɑ kɔ̃sɑ ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɔn tuko wi u nɛ, Yinni Gusunɔ sɑ̃ɑmɔ,","poem":1},{"lineBreak":true},{"text":"u ku ɡere u nɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ wurɑmɔ u du nɛn tɔmbun suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wi bɑ mɑɑ mɑtɑm kuɑ sinɑ kpɑɑrun sɔmburun sɔ̃,","poem":1},{"lineBreak":true},{"text":"u ku ɡere u nɛɛ,","poem":1},{"lineBreak":true},{"text":"wee, u kuɑ dɑ̃ɑ ɡbeburu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi ɑmɛniwɑ nɛ, Yinni Gusunɔ nɑ ɡeruɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ nɛɛ, sinɑ kpɑɑrun sɔm kowo be,","poem":1},{"lineBreak":true},{"text":"bɑ̀ n nɛn tɔ̃ɔ wɛ̃rɑruɡiru mɛm nɔɔwɑmmɛ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ mɔ̀ ye yɑ koo mɑn wɛ̃re,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ nɛn ɑrukɑwɑni nɛni dim dim,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kon bu ɑyeru wɛ̃ nɛn yɛnuɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu yĩsiru yɑri","poem":1},{"lineBreak":true},{"text":"n kere bɑ̀ n dɑɑ bibu mɑrɑ.","poem":1},{"lineBreak":true},{"text":"Kon bu yĩsiru kɛ̃","poem":1},{"lineBreak":true},{"text":"te tɑ ko n wɑ̃ɑ sere kɑ bɑɑdommɑɔ,","poem":1},{"lineBreak":true},{"text":"tɑ ǹ ɡbimɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɔn tuko be bɑ mɑn sɑ̃ɑmɔ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ nɛn yĩsiru kĩ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ sɑ̃ɑ nɛn sɔm kowobu,","poem":1},{"lineBreak":true},{"text":"be kpuro be bɑ tɔ̃ɔ wɛ̃rɑruɡiru mɛm nɔɔwɑmmɛ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ǹ tu disi dokemɔ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ nɛn ɑrukɑwɑni nɛni,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kon kɑ bu dɑ nɛn ɡuu dɛɛrɑrɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n de bu nuku dobu ko nɛn sɑ̃ɑ yerɔ.","poem":1},{"lineBreak":true},{"text":"Kon ben yɑ̃ku dɔ̃ɔ mwɑɑrɑruɡinu","poem":1},{"lineBreak":true},{"text":"kɑ ben yɑ̃ku ni nu tie mwɑ nɛn yɑ̃ku yerɔ.","poem":1},{"lineBreak":true},{"text":"Domi bɑ koo nɛn dii te sokuwɑ","poem":1},{"lineBreak":true},{"text":"bwesenu kpuron kɑnɑ yeru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛ, Yinni Gusunɔ,","poem":1},{"lineBreak":true},{"text":"nɛ wi nɑ Isireli be bɑ rɑɑ yɑrinɛ mɛnnɑ,","poem":1},{"lineBreak":true},{"text":"kon mɑɑ bwese tukunu mɛnnɑ","poem":1},{"lineBreak":true},{"text":"kɑ be, nɛn tɔmbu sɑnnu.","poem":1}]},{"type":"heading","content":["Gusunɔ u Isirelibɑn wiruɡibu"]},{"type":"heading","content":["ɡerusimɔ"]},{"type":"verse","number":9,"content":[{"text":"Bɛɛ ɡbeeku yɛɛ kpuro, i nɑ i di.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Domi be bɑ sɑ̃ɑ Isirelibɑn kɔ̃sobu,","poem":1},{"lineBreak":true},{"text":"bɑ sɑ̃ɑwɑ wɔ̃kobu, bɑ ǹ bwisi mɔ.","poem":1},{"lineBreak":true},{"text":"Be kpuro bɑ sɑ̃ɑwɑ nɡe bɔ̃ɔ","poem":1},{"lineBreak":true},{"text":"ni nu kun kpɛ̃ nu wori.","poem":1},{"lineBreak":true},{"text":"Bɑ rɑ kɑ̃wɑ bɑ n kpĩ","poem":1},{"lineBreak":true},{"text":"bɑ n do kpɑ bɑ n dosimɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɑ sɑ̃ɑwɑ nɡe bɔ̃ɔ","poem":1},{"lineBreak":true},{"text":"ni nù n di, nu ku rɑ debu.","poem":1},{"lineBreak":true},{"text":"Bɑ sɑ̃ɑwɑ nɡe kpɑro lɑɑkɑri sɑribɑ.","poem":1},{"lineBreak":true},{"text":"Swɑɑ ye ben bɑɑwure u kĩ,","poem":1},{"lineBreak":true},{"text":"yerɑ u rɑ swĩi win tiin ɑrufɑɑnin sɔ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɑ sokunɑmɔ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"bu mɛnnɑmɑ","poem":1},{"lineBreak":true},{"text":"bu tɑm bɔɔbɔm nɔ,","poem":1},{"lineBreak":true},{"text":"siɑ kpɑ bu mɑɑ ko mɛ","poem":1},{"lineBreak":true},{"text":"domi tɑm mu yibɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}