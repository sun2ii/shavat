{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"ISA","translationId":"bba_sim","name":"Esɑi","commonName":"Esɑi","title":"ESAI","order":23,"numberOfChapters":66,"sha256":"392f86c8d7b1a5316c3f20107a5ff95d1086a7a60b66601e29eade3518132fd3","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bba_sim/ISA/66.json","totalNumberOfVerses":1270},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Kɑɑ n sɑ̃ɑ nɡe dɔ̃ɔ wi u dɑ̃ɑ ɡbebɑ mwɑɑmɔ,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ wi u nim ɡbisisiɑmɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ wunɛn yibɛrɛbɑ bu ɡiɑ nɡe mɛ ɑ sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu diiri wunɛn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ,","poem":1},{"lineBreak":true},{"text":"sɑnɑm mɛ ɑ sɑrɑmɑ ɑ mɑɑmɑɑki kuɑ","poem":1},{"lineBreak":true},{"text":"ye sɑ ǹ kɑ yĩiyɔ,","poem":1},{"lineBreak":true},{"text":"ɡuunu diirɑ bɛrum sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑ ǹ ɡɑsɔ ɡoon ɡɑri nɔɔre.","poem":1},{"lineBreak":true},{"text":"Wunɛ bɑɑsi, sɑ ǹ mɑɑ ɡoo wɑɑre","poem":1},{"lineBreak":true},{"text":"wi u yen bweseru kuɑ","poem":1},{"lineBreak":true},{"text":"win tɔn be bɑ nùn nɑɑnɛ sɑ̃ɑn sɔ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wi u ɡem swĩi kɑ nuku dobu,","poem":1},{"lineBreak":true},{"text":"kɑ sere be bɑ wunɛn woodɑ yɑɑye,","poem":1},{"lineBreak":true},{"text":"bɑ sĩimɔ ye sɔɔ,","poem":1},{"lineBreak":true},{"text":"berɑ ɑ rɑ swɑɑ ɡbiiye.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ɑ kɑ sun mɔru kuɑ","poem":1},{"lineBreak":true},{"text":"yèn sɔ̃ sɑ durum kuɑ.","poem":1},{"lineBreak":true},{"text":"Kɑ mɛ, sɑ rɑ n durum ye mɔ̀wɑ sɑ n dɔɔ","poem":1},{"lineBreak":true},{"text":"sɑɑ yellun di.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɑ kuɑ nɡe disiɡibu,","poem":1},{"lineBreak":true},{"text":"mɑ bɛsɛn dɑɑ ɡeɑ yɑ sɑ̃ɑ nɡe yɑ̃ɑ disinuɡinu.","poem":1},{"lineBreak":true},{"text":"Sɑ ɡbere nɡe wurusu,","poem":1},{"lineBreak":true},{"text":"mɑ bɛsɛn durum kɑ sun doonɔ nɡe woo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Goo sɑri wi u wunɛn somiru kɑsu.","poem":1},{"lineBreak":true},{"text":"Goo mɑɑ sɑri wi u rɑ nun kɑnɛ bururu,","poem":1},{"lineBreak":true},{"text":"domi ɑ sun wunɛn wuswɑɑ beruɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ sun deri sɑ ɡɔɔ dɔɔ bɛsɛn durum sɔ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɑ yen de, Yinni,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ sɑ̃ɑ bɛsɛn bɑɑbɑ.","poem":1},{"lineBreak":true},{"text":"Sɑ sɑ̃ɑwɑ nɡe sɔndu,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ sun mɔmɑ kɑ wunɛn nɔmɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ ku mɔru ko too,","poem":1},{"lineBreak":true},{"text":"ɑ kun mɑɑ bɛsɛn durum ye yɑɑye sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ɑ n yɛ̃ mɑ sɑ sɑ̃ɑwɑ wunɛn tɔmbu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wee wunɛn wuu si ɑ ɡɔsɑ su kuɑ bɑnsu.","poem":1},{"lineBreak":true},{"text":"Yerusɑlɛmu yɑ wɔrukɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛsɛn sɑ̃ɑ yee burɑ dɛɛrɑ te,","poem":1},{"lineBreak":true},{"text":"mi bɛsɛn sikɑdobɑ bɑ rɑ rɑɑ nun sɑ̃,","poem":1},{"lineBreak":true},{"text":"tɑ dɔ̃ɔ mwɑɑrɑ.","poem":1},{"lineBreak":true},{"text":"Gɑ̃ɑ ɡee ni sɑ mɑɑ mɔ kpuro, nu kɑm kuɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɑɑ n yenibɑ kpuro mɛɛrɑwɑ ɑ n nɔɔ mɑɑri,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛsɛn nuki yi sɑnkirɑ n bɑndɑ?","poem":1}]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["u koo win yibɛrɛbɑ sɛɛyɑsiɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}