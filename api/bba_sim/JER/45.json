{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JER","translationId":"bba_sim","name":"Yeremi","commonName":"Yeremi","title":"YEREMI","order":24,"numberOfChapters":52,"sha256":"fccf675fea1cea9c1d34e719b96f3f3162e0a5732640166dbef93439c51cd0c6","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bba_sim/JER/52.json","totalNumberOfVerses":1348},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":["Sɑnɑm mɛ Bɑruku Nɛriyɑn bii u ɡɑri yi yoruɑ tireru sɔɔ yi Yeremi u nùn sɔ̃ɔwɑ Yoyɑkimu, Yosiɑsin bii, Yudɑbɑn sinɑ bokon bɑndun wɔ̃ɔ nnɛse sɔɔrɑ mi. Yen biru Yeremi u Bɑruku sɔ̃ɔwɑ u nɛɛ,"]},{"type":"verse","number":2,"content":["wee ye Gusunɔ Isirelibɑn Yinni, u ɡeruɑ wunɛn sɔ̃."]},{"type":"verse","number":3,"content":["U nɛɛ, ɑ ɡerumɔ ɑ mɔ̀, ɑ kɑm kuɑwɑ domi wi, Yinni Gusunɔ u wunɛn wɑhɑlɑ sosimɔ. Mɑ ɑ weeweenu mɔ̀ sere ɑ wɑsirɑ. Adɑmɑ ɑ biɑ mi kɑɑ wɛ̃rɑ."]},{"type":"verse","number":4,"content":["Wee, ye Yinni Gusunɔ u nɛɛ n nun sɔ̃. U nɛɛ,",{"text":"u koo ye u rɑɑ bɑnɑ kɔsukuwɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u ye u rɑɑ duurɑ wukiri.","poem":1},{"lineBreak":true},{"text":"Yen tubusiɑnɑ, u koo tem mɛ kpuro sɑnku.","poem":1}]},{"type":"verse","number":5,"content":["U mɑɑ nɛɛ,",{"text":"ɡɑ̃ɑ bɑkɑnɑ ɑ kɑsu wunɛn tiin sɔ̃?","poem":1},{"lineBreak":true},{"text":"A ku be nu kɑsu.","poem":1},{"lineBreak":true},{"text":"Domi u koo de kɔ̃sɑ yu nɑ yu tɔmbu kpuro wɔri.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ wunɛ u koo wunɛn wɑ̃ɑru yɑrɑ mi ɑ dɑ kpuro.","poem":1},{"lineBreak":true},{"text":"Terɑ tɑ ko n sɑ̃ɑ nɡe wunɛn ɑrumɑni ye ɑ ɡurɑ tɑbu sɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}