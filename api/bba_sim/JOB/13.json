{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Wee nɛn nɔni yi ye kpuro wɑ,","poem":1},{"lineBreak":true},{"text":"nɛn swɑsu su mɑɑ ye kpuro nuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ ye lɑɑkɑri kuɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ye i yɛ̃, yerɑ nɛn tii nɑ mɑɑ yɛ̃.","poem":1},{"lineBreak":true},{"text":"I ǹ mɑn bwisi kere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ Dɑm kpuroɡiiwɑ nɑ kĩ n ɡɑri sɔ̃.","poem":1},{"lineBreak":true},{"text":"Wiyɑ kon weeweenu koosi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi bɛɛ, weesɑ i rɑ n sekumɔ.","poem":1},{"lineBreak":true},{"text":"I sɑ̃ɑwɑ tim nɛmɔ weesuɡibu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N dɑɑ burɑm bo i n mɑɑri,","poem":1},{"lineBreak":true},{"text":"kpɑ bu bɛɛ ɡɑrisi nɡe bwisiɡibu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɛ̃, i nɛn weeweenu swɑɑ dɑkio,","poem":1},{"lineBreak":true},{"text":"kpɑ i nɔ ye nɑ ɡerumɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I tɑmɑɑ i ko i Gusunɔn biru yɔ̃rɑ kɑ weesu?","poem":1},{"lineBreak":true},{"text":"I ko i nùn mɔru bɑrɑ kɑ ɡɑri weesuɡii?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛɛyɑ i ko i kɑ nùn yinɑ?","poem":1},{"lineBreak":true},{"text":"Bɛɛyɑ i ko i nùn weeweenu kuɑ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ù n bɛɛ wɛ̃ɛrɑ i ko i nùn wɛ̃re?","poem":1},{"lineBreak":true},{"text":"I ko i nùn nɔni wɔ̃ke nɡe tɔnu?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɑɑ ì n win biru yɔ̃rɑ ɑsiri sɔɔ,","poem":1},{"lineBreak":true},{"text":"kɑ mɛ, u koo bɛɛ tɑɑrɛ wɛ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Win kpɑ̃ɑru tɑ ǹ bɛɛ bɛrum mɔ̀?","poem":1},{"lineBreak":true},{"text":"I ǹ nɑndɑmɔ win sɔ̃?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɛɛn ɡɑri sɑɑrinu nu sɑ̃ɑwɑ nɡe torom.","poem":1},{"lineBreak":true},{"text":"Ye i ɡerumɔ yɑ ǹ dɑm mɔ nɡe weke te bɑ kɑ sɔndu mɔmɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I mɑrio, kpɑ i de n ɡɑri ɡere,","poem":1},{"lineBreak":true},{"text":"kpɑ n mɑn deemɑ ye n ko n mɑn deemɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wee nɑ sɔɔru kpɑ, bɑɑ nɑ̀ n kon nɛn wɑ̃ɑru biɑn nɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gusunɔ ù n kĩ, u mɑn ɡoowo.","poem":1},{"lineBreak":true},{"text":"Kɑ mɛ, wiyɑ nɑ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Kon kɑ tii yinɑ win wuswɑɑɔ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yɑ koo kpĩ yu kɑ mɑn fɑɑbɑ nɑɑwɑ.","poem":1},{"lineBreak":true},{"text":"Domi tɔn kɔ̃so kun kpɛ̃ u terɑ win wuswɑɑɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I swɑɑ dɑkio i nɛn ɡɑri nɔ.","poem":1},{"lineBreak":true},{"text":"I swɑɑ tem kpĩiyɔ i nɔ ye kon ɡere.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wee nɑ sɔɔru kpɑ n kɑ nɛn ɡɑri ɡere.","poem":1},{"lineBreak":true},{"text":"Nɑ mɑɑ yɛ̃ mɑ nɑ ɡem mɔ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wɑrɑ u koo kɑ mɑn sikirinɑ nɛn ɡem sɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ sɔɔru kpɑ nɑ̀ n tɑɑrɛ mɔ n kɑ nɔɔ mɑri kpɑ n kpunɑ n ɡbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Gusunɔ, ɑ mɑn ɡɑ̃ɑnu yiru yeni kuo,","poem":1},{"lineBreak":true},{"text":"kpɑ n ku mɑɑ nun kukuɑ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A mɑn wunɛn nɔmu swɛnyɑrio,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ kun mɑɑ nɑnde.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A mɑn sokuo, kpɑ n nun wurɑri.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n nun kɑnɑ, ɑ mɑn wisio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Torɑnu nyewɑ nɑ nun torɑri.","poem":1},{"lineBreak":true},{"text":"A de n nu ɡiɑ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ ɑ mɑn biru kisi,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ mɑn kuɑ nɡe wunɛn yibɛrɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wɑrɑ ɑ nɑɑ ɡire. Wuru ɡe ɡɑ kɑ woo doonɔ?","poem":1},{"lineBreak":true},{"text":"Wɑrɑ ɑ nɑɑ swĩi. Yɑkɑ ɡbebusu?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ ɑ mɑn wɑhɑlɑ bɑkɑ yeni kpɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ mɑn sɛɛyɑsiɑmɔ nɛn ɑluwɑɑsirun torɑnun sɔ̃.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ ɑ mɑn yɔ̃rɑsiɑ nɡe wìn nɑɑsu bɑ bɔkuɑ kɑ sii yɔni,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ nɛn kookoosu kpuro mɛɛrɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ nɛn nɑɑ dɑbusɑnun ɡeeru yi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wee nɛn wɑsi yi dɑm dwiiyɑ yi sɑnkirɑ","poem":1},{"lineBreak":true},{"text":"nɡe yɑbe te kɔkɔnu di.","poem":1}]},{"type":"heading","content":["Tɔnun wɑ̃ɑrɑ sɑ̃ɑwɑ wɔnwɔndu"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}