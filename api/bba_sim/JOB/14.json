{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Yoobu u nɛɛ,","poem":1},{"lineBreak":true},{"text":"tɔnu wi bɑ ɡesi mɑrɑ, win wɑ̃ɑrɑ ku rɑ n dɛ̃u.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ tɑ rɑ n mɑɑ nɔni swɑ̃ɑru yibɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"U rɑ sewɑ nɡe dɑ̃ɑ wɛ̃su, kpɑ bu nùn burɑ.","poem":1},{"lineBreak":true},{"text":"U rɑ doonɛwɑ nɡe sɑɑru.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɔnu wiyɑ ɑ mɛɛrɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ nùn siribu sokɑ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɑrɑ u koo kpĩ u ɡɑ̃ɑ kɔ̃sunun di ɡɑ̃ɑ dɛɛrɑnu yɑrɑ.","poem":1},{"lineBreak":true},{"text":"Goo sɑri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À n tɔnun wɑ̃ɑrun tɔ̃ru yi ɑ ten suru ɡɑrɑ,","poem":1},{"lineBreak":true},{"text":"u ǹ mɑɑ sɑrɑmɔ mɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ n mɛn nɑ, ɑ ku mɑɑ nùn nɔni ɡirɑri,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ ɑ de u wɛ̃rɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u win sɔmburu ko, u win kɔsiɑru mwɑ kɑ nuku dobu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dɑ̃ru tɑ rɑ n yĩiyɔbu mɔ","poem":1},{"lineBreak":true},{"text":"mɑ tɑ koo se bɑ̀ n tu burɑ.","poem":1},{"lineBreak":true},{"text":"Domi tɑ koo kpɑrɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ten ɡbini yì n mɑɑ tɔkɔ kuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ten korɑ wɔrumɑ tɑ ɡu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ten ɡbinɑ ɡɑɑ rɑ mɑɑ kpɑrewɑ yɑ̀ n nim wɑ","poem":1},{"lineBreak":true},{"text":"kpɑ yu kpii pɔturɑ ko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Adɑmɑ tɔnu u rɑ ɡbiwɑ, kpɑ u kun mɑɑ wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Ù n ɡu, mɑnɑ u rɑ n wɑ̃ɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dɑɑ burerun nim mu rɑ ɡbere.","poem":1},{"lineBreak":true},{"text":"Dɑɑ bɑkɑnun nim mu rɑ mɑɑ kpe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɡe mɛyɑ tɔnu u rɑ kpunɛ u kun mɑɑ seewe.","poem":1},{"lineBreak":true},{"text":"U ǹ mɑɑ dom yɑndɑmɔ","poem":1},{"lineBreak":true},{"text":"sere wɔllu tu kɑ kpe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gusunɔ, nɑ kĩ ɑ mɑn bere ɡɔribun wɑ̃ɑ yerɔ,","poem":1},{"lineBreak":true},{"text":"nɑ n kukuɑ mi, sere wunɛn mɔru yu kɑ sure,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n wɑ̃ɑ mi sere dɔmɑ te kɑɑ mɑn yɑɑyɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɔnu ù n koo rɑɑ se sɑnɑm mɛ u ɡu,","poem":1},{"lineBreak":true},{"text":"nɑ kon yĩiyɔbu mɔ nɛn wɑhɑlɑ yeni sɔɔ","poem":1},{"lineBreak":true},{"text":"sere nɛn wɑ̃ɑru tu kɑ kɔsi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sɑɑ ye sɔɔ, Gusunɔ,","poem":1},{"lineBreak":true},{"text":"ɑ̀ n nɛn bɛkɛ bɑrɔ,","poem":1},{"lineBreak":true},{"text":"ɑ̀ n mɑn soku,","poem":1},{"lineBreak":true},{"text":"nɛ wi nɑ sɑ̃ɑ wunɛn tɑkɑ koorɑ, kon nun wurɑri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wee tɛ̃ ɑ mɑn swĩi mi nɑ nɑɑsu wukɑ kpuro.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ sɑɑ ɡɑɑ sisi yè sɔɔ ɑ ǹ mɑɑ nɛn durum ɡɑrisimɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɑɑ nɛn torɑnu doke sɑɑki sɔɔ ɑ bɔke.","poem":1},{"lineBreak":true},{"text":"Kpɑ ɑ mɑn nɛn durum kpuro wɔkɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Guunu koo wɔruku nu kɑm ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ kpenu nu swɛnyɑ mi nu rɑɑ wɑ̃ɑn di.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nim mu koo kpenu kɔsuku,","poem":1},{"lineBreak":true},{"text":"kpɑ mu mɑɑ kɑ tem kusɑnu doonɑ.","poem":1},{"lineBreak":true},{"text":"Nɡe mɛyɑ ɑ rɑ tɔnun yĩiyɔbu kɑm koosie win wɑ̃ɑru sɔɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kpɑ ɑ nùn nɔni swɑ̃ɑ dɑbinu kpɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"À n deemɑ u ǹ mɑɑ sɑ̃ɑ nɡe yellu,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nùn ɡirɑ u doonɑ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bɑɑ win bibu bɑ̀ n yĩsiru yɑrɑ,","poem":1},{"lineBreak":true},{"text":"win tii u ǹ mɑɑ kpɛ̃ u n yɛ̃.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ bɑ̀ n mɑɑ wɑ̃ɑ sekuru sɔɔ,","poem":1},{"lineBreak":true},{"text":"u ǹ kpɛ̃ u n yɛ̃.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Win wɑhɑlɑ tɔnɑwɑ yɑ koo nùn nɔni sɔ̃.","poem":1},{"lineBreak":true},{"text":"Wi turowɑ u ko n nuki sɑnkire win ɡɔ̃ruɔ.","poem":1}]},{"type":"heading","content":["Elifɑsi u Yoobu wisɑ u nɛɛ,"]},{"type":"heading","content":["tɔn kɔ̃so kun wɑhɑlɑ biɑmɔ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}