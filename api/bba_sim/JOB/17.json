{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["Yoobu u nɛɛ,",{"text":"nɑ wɛ̃siɑmɔ kɑ wɑhɑlɑ, nɛn wɑ̃ɑrɑ kpeeyɔ.","poem":1},{"lineBreak":true},{"text":"Siki wɔru ɡɑ mɑn mɑrɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tɔn yɑɑko kowobu bɑ mɑn kooro bure.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑn nɔɔ kuurimɔ beri berikɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ de wunɛn tii ɑ mɑn mɔru bɑrɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ n kun mɔ wunɛ, wɑrɑ u koo mɑn sɑnnɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ben bwisi wunɑ.","poem":1},{"lineBreak":true},{"text":"A ku de bu nɑsɑrɑ wɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɑ sɑ̃ɑwɑ nɡe tɔnu wi mɔn teni tɑ kɑ yɑ̃,","poem":1},{"lineBreak":true},{"text":"te tɑ nɛɛ, u win kpɑɑsibu dim sokɑ,","poem":1},{"lineBreak":true},{"text":"mɑ win bibu bɑ kɑ ɡɔ̃ɔru sɔ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bɑ mɑn womusu doke,","poem":1},{"lineBreak":true},{"text":"bɑ mɑn yɑ̃ɑtɑm siemɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛn nɔni yi ǹ mɑɑ do, nuku sɑnkirɑnun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ nɛn wɑsi yi dɑm dwiiyɑ, yi doonɔ nɡe sɑɑru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gemɡibu bɑ biti soore nɛn wɑhɑlɑ yenin sɔ̃.","poem":1},{"lineBreak":true},{"text":"Tɑɑrɛ sɑriruɡibu bɑ koo tɔn kɔ̃sobu seesi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi u sɑ̃ɑ ɡemɡii u koo yɔ̃rɑwɑ dim dim win swɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ wi u dɛɛre, u tii dɑm kɛ̃ u sosi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɛɛ nɛn kpɑɑsibu kpuro,","poem":1},{"lineBreak":true},{"text":"i wurɑmɑ i mɑɑ ɡɑri sɑɑri nɛn wuswɑɑɔ.","poem":1},{"lineBreak":true},{"text":"Kɑ mɛ, nɑ ǹ ɡoo wɑsi bɛɛ sɔɔ wi u bwisi mɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nɛn wɑ̃ɑru tɑ kpɑ.","poem":1},{"lineBreak":true},{"text":"Wee himbɑ ye nɑ rɑɑ sɑ̃ɑ ye kpuro yɑ kɑm kuɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛn kpɑɑsibɑ tɑmɑɑ wɔ̃kurɑ sɑ̃ɑwɑ sɔ̃ɔ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Sɔ̃ɔ ù n duɔ, kpɑ bu nɛɛ, yɑm sɑ̃rɑmɑwɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gɔribun wɑ̃ɑ yerɑ nɑ mɑrɑ tu ko nɛn wɑ̃ɑ yeru.","poem":1},{"lineBreak":true},{"text":"Yɑm wɔ̃kuru sɔɔrɑ kon nɛn kpin yeru yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kon siki wɔru sɔ̃ n nɛɛ,","poem":1},{"lineBreak":true},{"text":"ɡeyɑ ɡɑ sɑ̃ɑ nɛn tundo.","poem":1},{"lineBreak":true},{"text":"Kpɑ n mɑɑ kɔkɔnu sɔ̃ n nɛɛ,","poem":1},{"lineBreak":true},{"text":"niyɑ nu sɑ̃ɑ nɛn mɛro kɑ nɛn sesubu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɑnɑ nɑ mɑɑ yĩiyɔbu mɔ.","poem":1},{"lineBreak":true},{"text":"Wɑrɑ u koo kpĩ u bu wɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɑ koo sɑrɑ ɡɔribun wɑ̃ɑ yerɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ su dɑ tuɑ sɔɔ sɑnnu.","poem":1}]},{"type":"heading","content":["Yinɑ ye yɑ tɔn kɔ̃so mɑrɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}