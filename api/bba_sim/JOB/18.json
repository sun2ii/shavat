{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Bilidɑ Suɑɡii u Yoobu wisɑ u nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"sere dommɑ kɑɑ ɡɑri yini sɑɑrinu kpe.","poem":1},{"lineBreak":true},{"text":"A den mɑrio kpɑ su mɑɑ ɡere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ ɑ sun mɛɛrɑ ɡɑri bɑkɑsu.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ ɑ sun mɛɛrɑ nɡe yɑɑ sɑberu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wunɛ Yoobu, wunɛn mɔruwɑ yɑ nun wɑhɑlɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"A tɑmɑɑ yɑ koo de tɔmbu bu yɑrinɑ kpɑ wuu ɡu ko bɑnsu,","poem":1},{"lineBreak":true},{"text":"kpɑ kpenu nu doonɑ nin ɑyerun di?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A n yɛ̃ mɑ tɔn kɔ̃son yɑm bururɑmɑ mu koo ɡbi.","poem":1},{"lineBreak":true},{"text":"Mɛn dɔ̃ɔ yɑri kun mɑɑ bɑllimɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yɑm bururɑm mu koo ɡɔsiɑ yɑm wɔ̃kuru win wɑ̃ɑ yerɔ.","poem":1},{"lineBreak":true},{"text":"Domi u koo ɡbi nɡe fitilɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U ǹ mɑɑ sĩimɔ kɑ toro sindu.","poem":1},{"lineBreak":true},{"text":"Win tiin bwisi koo nùn surɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Domi u koo dɑ yinɑ ɡiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ win nɑɑsu su yen wɛ̃ɛ wuronu wɔri.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinɑ koo nùn mwɑ nɑɑ tokurɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ yen wɛ̃ɛ yi nùn tɛ̃ke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɑ nùn tɑɑ bɛrie temɔ, win swɑɑ sɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N wee nɔni swɑ̃ɑrɑ nùn mɑrɑ tɑ kɑ sikerenɛ.","poem":1},{"lineBreak":true},{"text":"Mɑ tɑ nùn swĩi birun di.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gɔ̃ɔrɑ nùn wɔri, tɑ win dɑm kpɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ sɑ̃ɑrɑ nùn deemɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tɑ koo win wɑsin ɡɔnɑ di beri berikɑn di.","poem":1},{"lineBreak":true},{"text":"Kpɑ bɑrɑ bɑkɑru tu nùn mwɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bɑ koo nùn wunɑ win wɑ̃ɑ yerun di,","poem":1},{"lineBreak":true},{"text":"tè sɔɔ u rɑɑ dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bu kɑ nùn dɑ ɡɔɔn sinɑ kpɑɑ bɑkɑrɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wiɡibɑ koo yɑrinɑ.","poem":1},{"lineBreak":true},{"text":"Win ɑrumɑnin tii yɑ koo kɑm ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ sɔ̃ɔ bisu su win yɛnu dɔ̃ɔ mɛni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tɔn kɔ̃so wi, u ko n sɑ̃ɑwɑ nɡe dɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Win ɡbini yi koo ɡberɑ temɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bu win kɑ̃ɑsi bɔɔri wɔllɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bɑ koo win ɡɑri duɑri hɑnduniɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ ǹ mɑɑ win yĩsiru yɑɑyɑmɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Domi bɑ nùn yɑrɑ yɑm bururɑm di,","poem":1},{"lineBreak":true},{"text":"bɑ sure yɑm wɔ̃kuru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ nùn ɡirɑ hɑnduniɑn di.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Win bii ɡoo kun nùn bibu mɑruɑmmɛ.","poem":1},{"lineBreak":true},{"text":"Domi win yɛnuɡibu kpuro bɑ koo ɡbi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tɔn be bɑ wɑ̃ɑ tɛ̃ bɑ koo bɛrum soorɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ be bɑ koo mɑrurɑ win biru","poem":1},{"lineBreak":true},{"text":"bu biti soorɑ win kɑm koo bin sɔ̃.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nɡe mɛyɑ tɔn kɔ̃sobu kɑ be bɑ ǹ Gusunɔ yɛ̃n wɑ̃ɑ yeru tɑ ko n sɑ̃ɑ.","poem":1}]},{"type":"heading","content":["Yoobu nɛɛ, win wɔro koo nùn nɑɑwɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}