{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Yoobu u wisɑ u nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"sere kɑ ɡisɔ nɑ Gusunɔ weeweenu koosimɔ.","poem":1},{"lineBreak":true},{"text":"Nɛn nɔni swɑ̃ɑru tɑ nɛn wuri kere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ̀ n dɑɑ yɛ̃ mi u wɑ̃ɑ kon dɑɑ dɑwɑ sere win mi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpɑ n nùn sɔ̃ ye yɑ mɑn wɑ̃ɑsi,","poem":1},{"lineBreak":true},{"text":"kɑ mɑɑ yèn sɔ̃ nɑ tii wɔrɑmɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kpɑ n win wisibu nɔ.","poem":1},{"lineBreak":true},{"text":"N nɔ ye n nùn nɛni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U koo mɑn dɑm sɔ̃ɔsi u kɑ mɑn siri?","poem":1},{"lineBreak":true},{"text":"Aɑwo, u koo yɔ̃rɑwɑ u mɑn swɑɑ dɑki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛ tɔn ɡeowɑ kon kpĩ n kɑ nùn wesiɑnɔ ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ wi, wi u sɑ̃ɑ nɛn siri kowo,","poem":1},{"lineBreak":true},{"text":"u mɑn yɑkiɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Adɑmɑ nɑ̀ n dɑ sɔ̃ɔ yɑri yeru ɡiɑ,","poem":1},{"lineBreak":true},{"text":"u ku rɑ n wɑ̃ɑ mi.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n mɑɑ dɑ sɔ̃ɔ duu yerɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ku rɑ nùn wɑ mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aɑ, u sɔmburu ɡɑru mɔ̀wɑ sɔ̃ɔ yɛ̃sɑn nɔm ɡeu ɡiɑ?","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n dɑ mi, u ku rɑ n wɑ̃ɑ mi.","poem":1},{"lineBreak":true},{"text":"U kukuɑwɑ sɔ̃ɔ yɛ̃sɑn nɔm dwɑru ɡiɑ?","poem":1},{"lineBreak":true},{"text":"Min tii, nɑ ku rɑ nùn wɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɑ mɛ, u nɛn swɛɛ kpuro yɛ̃ yi nɑ swĩi.","poem":1},{"lineBreak":true},{"text":"Ù n mɑn kpɛ̃ɛ lɑɑkɑri mɛɛribu sɔɔ, kon yɑriwɑ min di,","poem":1},{"lineBreak":true},{"text":"nɑ n dɛɛre nɡe wurɑ ye bɑ dɔ̃ɔ doke.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɑ win yirɑ swĩiwɑ dee dee.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ɡɛre win swɑɑn di.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɑ ǹ win woodɑ sɑre.","poem":1},{"lineBreak":true},{"text":"Ye u mɑn sɔ̃ɔwɑ kpuro,","poem":1},{"lineBreak":true},{"text":"nɑ ye mɛm nɔɔwɑwɑ ɡɔ̃ruɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ù n ɡɑ̃ɑnun himbɑ yi, wɑrɑ u koo ye sĩiyɑ.","poem":1},{"lineBreak":true},{"text":"Ye u kĩ yerɑ u rɑ ko.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ n mɛn nɑ, u koo ko ye u yi kpuro nɛn sɔ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ u mɑɑ mɑn himbɑ kpɑɑ yiiyɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɑ nɑnde wi Gusunɔn wuswɑɑɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n bwisikɑ nɑ rɑ nɑndewɑ win sɔ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gusunɔ u nɛn wɔruɡɔrun dɑm buɑ.","poem":1},{"lineBreak":true},{"text":"Wi, Dɑm kpuroɡii u mɑn bɛrum kpɛ̃ɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɑ yen de kpuro, nɑ ǹ nɔɔ mɑri,","poem":1},{"lineBreak":true},{"text":"bɑɑ mɛ n sɑ̃ɑre yɑm wɔ̃kurɑ mɑn wukiri.","poem":1}]},{"type":"heading","content":["Gusunɔ u rɑ tɔn kɔ̃so deriwɑ u n mɔ̀ ye u kĩ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}