nt":["Yoobu nɛɛ, Bilidɑn somiru tɑ ǹ ɑrufɑɑni mɔ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}