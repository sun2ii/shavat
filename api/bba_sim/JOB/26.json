{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOB","translationId":"bba_sim","name":"Yoobu","commonName":"Yoobu","title":"YOOBU","order":18,"numberOfChapters":42,"sha256":"75976c3e03dfdc7a0a5ced38a13471977f8d630f3c5678e93f9c305cfc700d78","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bba_sim/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Yoobu u Bilidɑ wisɑ u nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"Bilidɑ, wunɛn wisibu bu ǹ dɑm sɑriruɡii somimɔ.","poem":1},{"lineBreak":true},{"text":"Wunɛn dɑm kɛ̃ru tɑ ǹ ɑrufɑɑni ɡɑɑ mɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Annɑ ɑ bwisi kɛ̃ru wɑ te ɑ wi u kun bwisi mɔ kɛ̃mɔ.","poem":1},{"lineBreak":true},{"text":"Wunɛn bwisi yi, yi ǹ ɡoo somimɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɑrɑ ɑ ɡɑri yini sɔ̃ɔmɔ.","poem":1},{"lineBreak":true},{"text":"Wɑrɑ u nun ɡɑri yini ɡerusiɑ.","poem":1}]},{"type":"heading","content":["Gusunɔ u dɑm mɔ ɡɑ̃ɑnu kpuron wɔllɔ"]},{"type":"verse","number":5,"content":[{"text":"Be bɑ ɡu bɑ wɑ̃ɑ sere nim wɔ̃kun tem sɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"bɑ diirimɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi Gusunɔ u be kpuro wɑɑmɔ.","poem":1},{"lineBreak":true},{"text":"Gɑ̃ɑnu kun nùn ɡɑnuɑ ɡɔribun wɑ̃ɑ yeru mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wiyɑ u sɔ̃ɔ yɛ̃sɑn nɔm ɡeu doke wom dirum sɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ u tem bwɛ̃ kɑm dirum sɔɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɑ u nim bɑnisi ɡuru winu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kɑ mɛ, ɡuru wii ni,","poem":1},{"lineBreak":true},{"text":"nu ku rɑ ɡɛ̃ɛre nim bunum sɔ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wiyɑ u rɑ de ɡuru winu nu win sinɑ ɡɔnɑ wukiri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mɑ u bubenu kuɑ nim wɔ̃kun wɔllɔ,","poem":1},{"lineBreak":true},{"text":"mi yɑm bururɑm kɑ yɑm wɔ̃kurɑ kɑrɑnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gusunɔ ù n ɡbɑ̃rɑ,","poem":1},{"lineBreak":true},{"text":"wɔllun ɡbere yɑ rɑ diiriwɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ yɑ n wɑ̃ɑ biti sɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɑ win dɑmɑ u rɑ nim wɔ̃kun nim kɔsuku.","poem":1},{"lineBreak":true},{"text":"Kpɑ u kɑ win bwisi yɑɑ ɡɔbɑ ye bɑ mɔ̀ Rɑhɑbu kɑmiɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ù n wom wurɑ, wɔllu kpuro tɑ rɑ dɛɛrewɑ nɡe bɑ kurɑ.","poem":1},{"lineBreak":true},{"text":"Kɑ win nɔmɑ u rɑ wɑɑ ye yɑ dukɑ mɔ sɔkiri.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Adɑmɑ yeni kpuro yɑ sɑ̃ɑwɑ win kookoo piiminu.","poem":1},{"lineBreak":true},{"text":"Nin wɔkinun fiikowɑ sɑ rɑ n nɔɔmɔ.","poem":1},{"lineBreak":true},{"text":"Ǹ n mɛn nɑ, wɑrɑ u koo kpĩ u win dɑm ɑsɑnsi tubu ù n ɡbɑ̃rɑ nɡe ɡurɑ.","poem":1}]},{"type":"heading","content":["Toro u koo kpĩ u Gusunɔ somiru kɑnɑ?"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}