{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"JOL","translationId":"bba_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"0358fa5ac1e6f999c5bf31c122b2d012546722cf2fab587bbe31670efa8fcbf4","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bba_sim/JOL/4.json","totalNumberOfVerses":71},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Yen biru kon nɛn Hunde doke tɔmbu kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Bɛɛn bii tɔn durɔbu kɑ tɔn kurɔbu bɑ koo nɛn ɡɑri ɡere,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛɛn durɔ tɔkɔnu nu n dosusu mɔ̀,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛɛn ɑluwɑɑsibɑ bu kɑ̃sinu wɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɑɑ kɑ yobɔ, kon bu nɛn Hunde wɛ̃wɑ tɔ̃ɔ te.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yen tɔ̃ɔ te sɔɔ, kon mɑɑmɑɑkibɑ ko.","poem":1},{"lineBreak":true},{"text":"Kon de yɛm kɑ dɔ̃ɔ kɑ wii bɑkɑsu sɔ̃ɔsirɑ wɔllɔ kɑ temɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sɔ̃ɔ u koo yɑm tĩrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ suru u swɛ̃rɑ nɡe yɛm,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔn tɔ̃ɔ nɑnumɡii te, tu sere tunumɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ yen tɔ̃ɔ te,","poem":1},{"lineBreak":true},{"text":"wi u Yinni Gusunɔ sokɑ, u koo fɑɑbɑ wɑ.","poem":1},{"lineBreak":true},{"text":"Gɑbu bɑ koo kisirɑ nɔni swɑ̃ɑ ten di","poem":1},{"lineBreak":true},{"text":"Siɔnin ɡuurɔ Yerusɑlɛmuɔ","poem":1},{"lineBreak":true},{"text":"nɡe mɛ Yinni Gusunɔ u ɡeruɑ.","poem":1},{"lineBreak":true},{"text":"Beyɑ be u sokɑ bɑ n kɑ wɑ̃ɑru mɔ.","poem":1}]},{"type":"heading","content":["Yinni Gusunɔ"]},{"type":"heading","content":["u koo bwese tukunu siri"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}