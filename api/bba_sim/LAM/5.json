{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"LAM","translationId":"bba_sim","name":"Swĩi","commonName":"Swĩi","title":"YEREMIN SWĨI","order":25,"numberOfChapters":5,"sha256":"3ca128e7ae17b97c833d1bfa4eb56e4fd66d796db0c9f3e7c4e321c5bea93e14","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bba_sim/LAM/5.json","totalNumberOfVerses":152},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ, ɑ yɑɑyo ye n sun deemɑ.","poem":1},{"lineBreak":true},{"text":"A mɛɛrio ɑ wɑ nɡe mɛ sɑ wɑ̃ɑ sekuru sɔɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɛsɛn tem mɛ ɑ sun wɛ̃ mu kuɑ ɡɑbuɡim.","poem":1},{"lineBreak":true},{"text":"Tɔn tukobɑ bɑ wɑ̃ɑ bɛsɛn diɑɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛsɛn bɑɑbɑbɑ bɑ ɡu,","poem":1},{"lineBreak":true},{"text":"mɑ bɛsɛn mɛrobu bɑ ɡɔminiru sɔ̃.","poem":1},{"lineBreak":true},{"text":"Sɑ wɑ̃ɑ tundobu sɑri.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gobiyɑ sɑ rɑ kɔsie su sere bɛsɛn tiin dɔkɔn nim nɔ.","poem":1},{"lineBreak":true},{"text":"Gobiyɑ sɑ rɑ mɑɑ kɑ bɛsɛn tem dɑ̃ɑ dwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wee, bɛsɛn yibɛrɛbɑ bɑ sun yoru diisiɑmɔ.","poem":1},{"lineBreak":true},{"text":"Sɑ wɑsire, bɑ ǹ mɑɑ sun wɛ̃rɑbu wɛ̃ɛmɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sɑ Asiriɡibu kɑ Eɡibitiɡibu dĩɑnu kɑnɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wee, bɛsɛn bɑɑbɑbɑ bɑ kɔ̃sɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ bɑ ǹ mɑɑ kɑ sun wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Bɛsɛrɑ sɑ yen wɑhɑlɑ sɔɔwɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yobɑ bɑ kuɑ bɛsɛn yinnibu.","poem":1},{"lineBreak":true},{"text":"Goo mɑɑ sɑri wi u koo sun wɔrɑ ben nɔmɑn di.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sɑ rɑ bɛsɛn wɑ̃ɑru kɑri bɔriewɑ,","poem":1},{"lineBreak":true},{"text":"domi sɑ rɑ kɑ yibɛrɛbɑ tɑbu kowɑ ɡbɑburɔ","poem":1},{"lineBreak":true},{"text":"su sere wɑ su di.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gɔ̃ɔrun sɔ̃ bɛsɛn wɑsi swĩɑ nɡe pɛ̃ɛ wɔ̃ɔ yeru.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɑ tɔn kurɔbu kɑ wɔndiɑbɑ ɡɑbirimɔ","poem":1},{"lineBreak":true},{"text":"Yudɑn tem kpuro sɔɔ kɑ sere Yerusɑlɛmuɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɑ bɛsɛn wiruɡibu mwɛɛrɑ bɑ soorɑ doke.","poem":1},{"lineBreak":true},{"text":"Bɑ ǹ durɔ tɔkɔnu bɛɛrɛ wɛ̃.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bɑ bɛsɛn ɑluwɑɑsibɑ mwɛɛrɑ nɡe yobu bu kɑ som nɑm.","poem":1},{"lineBreak":true},{"text":"Mɑ bibɑ dɑ̃ɑ ɡurɑmɔ bɑ wɔrukumɔ yen bunum sɔ̃.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bɛsɛn bukurobu bɑ ku rɑ mɑɑ sinɛ","poem":1},{"lineBreak":true},{"text":"bu siribu ko siri yerɔ.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ bɛsɛn ɑluwɑɑsibɑ bɑ ku rɑ mɑɑ womusu ko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bɛsɛn nuku dobu bu kpɑ.","poem":1},{"lineBreak":true},{"text":"Bɛsɛn nuku dobun yɑɑbu ɡɔsirɑ nuku sɑnkirɑnu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɛsɛn bɛɛrɛ yɑ kpɑ.","poem":1},{"lineBreak":true},{"text":"Annɑ ɑ wɑhɑlɑ bɑkɑ wɑ torɑ ni sɑ kuɑn sɔ̃.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gisɔ sɑ nuki sɑnkire,","poem":1},{"lineBreak":true},{"text":"mɑ sɑ nɔni yĩresu kokumɔ,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"yèn sɔ̃ ɡuu te bɑ mɔ̀ Siɔni tɑ kuɑ bɑnsu,","poem":1},{"lineBreak":true},{"text":"mɑ tɑ kuɑ ɡbeeku bɔ̃nun wɑ̃ɑ yeru.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Adɑmɑ wunɛ Yinni Gusunɔ, ɑ sɑ̃ɑwɑ sunɔ.","poem":1},{"lineBreak":true},{"text":"Kɑɑ n bɑndu diiwɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kɑɑ n sun deriwɑ n kɑ tɛ?","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ kɑɑ n sun duɑri sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ̀ n nɛɛ, su wurɑmɑ wunɛn mi,","poem":1},{"lineBreak":true},{"text":"sɑ ko wurɑmɑ.","poem":1},{"lineBreak":true},{"text":"A de bɛsɛn wɑ̃ɑru tu wurɑmɑ nɡe yellu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kɑɑ n kɑ sun mɔru bɑkɑ sɑ̃ɑwɑ?","poem":1},{"lineBreak":true},{"text":"Kɑɑ n sun deriwɑ mɑm mɑm?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}