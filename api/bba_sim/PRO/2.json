{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PRO","translationId":"bba_sim","name":"Mɔnnu","commonName":"Mɔnnu","title":"MƆNNU","order":20,"numberOfChapters":31,"sha256":"3d2e0c4dd99801e9219371e40797abcd73830271476828490cdcd3d4de37e4d4","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bba_sim/PRO/31.json","totalNumberOfVerses":903},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nɛn bii, ɑ nɛn sɔ̃ɔsiru wuro,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nɛn woodɑ nɛnɛ wunɛn ɡɔ̃ruɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A bwisin sɔ̃ɔsiru swɑɑ dɑkio.","poem":1},{"lineBreak":true},{"text":"A kookɑri koowo yu kɑ nun yeeri.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A bwisi kɑsuo,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ lɑɑkɑri nɑɑ ɡirɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ye kpuro kɑsuo nɡe sii ɡeesu,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ nɡe ɑrumɑni ye yɑ beruɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À n kuɑ mɛ, kɑɑ tubu","poem":1},{"lineBreak":true},{"text":"nɡe mɛ kɑɑ kɑ Gusunɔ nɑsiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nùn ɡiɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔwɑ u rɑ tɔnu bwisi wɛ̃.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u rɑ mɑɑ nùn yɛ̃ru kɑ lɑɑkɑri wɛ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U rɑ tɑɑrɛ sɑriruɡibu nɑsɑrɑ wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ u n be bɑ ɡem swĩi kɔ̃su nɡe tɛrɛru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"U rɑ be bɑ ku rɑ ben berusebu kɔ̃sɑ kue kɔ̃su,","poem":1},{"lineBreak":true},{"text":"kpɑ u wiɡii be bɑ nùn mɛm nɔɔwɛ kpɑrɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɛn bii, ɑ̀ n nɛn ɡɑri wurɑ, kɑɑ ɡem tubu.","poem":1},{"lineBreak":true},{"text":"Kɑɑ n yɛ̃ ye yɑ sɑ̃ɑ dee dee.","poem":1},{"lineBreak":true},{"text":"Ye kpurowɑ yɑ koo de ɑ n ɡeɑ mɔ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɑɑ n bwisi mɔ, kpɑ yɛ̃ru tu nun nuku dobu wɛ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bwisi kɑ lɑɑkɑri yɑ koo nun kɔ̃su,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kpɑ yu kɑ nun ɡbɑrɑ swɑɑ kɔ̃sɑn di,","poem":1},{"lineBreak":true},{"text":"kpɑ yu nun yɑrɑ ɡɑri kɔ̃siɡiin nɔmɑn di,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"kɑ sere mɑɑ be bɑ swɑɑ ɡeɑ derin min di,","poem":1},{"lineBreak":true},{"text":"bɑ swɑɑ kɔ̃sɑ swĩi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɔ̃sɑn kobu bu rɑ bu nuku dobu wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n yɛ̃ɛrimɔ torɑnun sɔ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ben swɛɛ kɑ ben sɑnu sɑnusu ku rɑ n dɛɛre.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nɡe mɛyɑ yi koo mɑɑ de ɑ kurɔ tuko dukɑ suuri","poem":1},{"lineBreak":true},{"text":"wi u nun kɔkirimɔ kɑ ɡɑri dori.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wi, wi u win durɔ ɡbiikoo yinɑ,","poem":1},{"lineBreak":true},{"text":"u ɑrukɑwɑni duɑri ye u kɑ nùn bɔkuɑ Gusunɔn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɑ win yɛnu ɡɑ ɡɔɔ dɔɔ,","poem":1},{"lineBreak":true},{"text":"win swɛɛ yi kɑ nùn dɔɔ ɡɔribun wɑ̃ɑ yerɔ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tɔn durɔ wi u dɑ win mi, u ku rɑ wurɑmɛ.","poem":1},{"lineBreak":true},{"text":"U ku rɑ mɑɑ wɑ̃ɑrun swɑɑ wɑ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ǹ n mɛn nɑ, ɑ ɡemɡibun swɑɑ swĩiyɔ.","poem":1},{"lineBreak":true},{"text":"A ben dɑɑ sɑɑrio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Domi ɡemɡibu kɑ tɑɑrɛ sɑriruɡibu","poem":1},{"lineBreak":true},{"text":"bɑ ko n wɑ̃ɑ n kɑ tɛ tem mɛ sɔɔ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Adɑmɑ tɔn kɔ̃sobu kɑ mɛm nɔɔ sɑribɑrɑ","poem":1},{"lineBreak":true},{"text":"bɑ koo wunɑ min di.","poem":1}]},{"type":"heading","content":["Gusunɔn ɡeren mɛm nɔɔbu"]},{"type":"heading","content":["sɔɔrɑ bwisi wɑ̃ɑ"]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}