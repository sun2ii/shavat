{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Wi u sɑ̃ɑ doo nɔɔruɡii,","poem":1},{"lineBreak":true},{"text":"wiyɑ u ku rɑ tɔn kɔ̃sobun ɡɑri nɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ku rɑ durumɡibu swĩi.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ku rɑ n wɑ̃ɑ kɑ be bɑ Gusunɔ ɑtɑfiiru mɔ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wiyɑ u rɑ n nuku dobu mɔ̀ Gusunɔn ɡɑri sɔɔ sɔ̃ɔ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u rɑ n Gusunɔn ɡɑri bwisikumɔ wɔ̃kuru.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u rɑ n Gusunɔn ɡɑri kĩ sɑɑ kpuro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"U sɑ̃ɑ nɡe dɑ̃ɑ te tɑ yɔ̃ dɑɑrɔ.","poem":1},{"lineBreak":true},{"text":"Ten wurusu rɑ n bekusu sɑ̃ɑwɑ sɑɑ kpuro.","poem":1},{"lineBreak":true},{"text":"Tɑ rɑ mɑwɑ ten mɑrubun sɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Tɔnu wi u sɑ̃ɑ nɡe mɛ,","poem":1},{"lineBreak":true},{"text":"ye u seewɑ u wɔri kpuro, yɑ rɑ koorewɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ tɔn kɔ̃so kun doo nɔɔru wɑsi.","poem":1},{"lineBreak":true},{"text":"U ǹ sɑ̃ɑ nɡe dɑ̃ɑ te.","poem":1},{"lineBreak":true},{"text":"Yɑkɑ ɡbebusɑ u kɑ weenɛ si woo ɡɑ rɑ yɑrinɑsie.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U ǹ ɡem wɑsi Gusunɔ ù n nùn siri.","poem":1},{"lineBreak":true},{"text":"U ǹ mɑɑ kpɛ̃ u n wɑ̃ɑ ɡemɡibun wuurɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi win swɑɑ dɔɔwɑ kɑm koo yerɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔwɑ u ɡemɡibu swɑɑ ɡbiiye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}