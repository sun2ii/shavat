{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ. Ge wee.",{"text":"Wee kon womu ko ɡe ɡɑ kɑ siribu kɑ durom yɑ̃.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, kon ɡu kowɑ n kɑ nun bɛɛrɛ wɛ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kon nɛn lɑɑkɑri doke swɑɑ ɡeɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Sɑɑ yerɑ̀ kɑɑ mɑn nɑɑwɑ.","poem":1},{"lineBreak":true},{"text":"Kon sĩwɑ dee dee nɛn yɛnuɡibun suunu sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ ǹ wurɑmɔ n kɔ̃sɑ mɛɛri.","poem":1},{"lineBreak":true},{"text":"Nɑ mɛm nɔɔbu sɑribɑn dɑɑ tusɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ wurɑmɔ yu mɑn tiɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ ǹ wurɑmɔ kɔ̃sɑ yɑ n wɑ̃ɑ nɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kon kɑ tɔn kɔ̃sobu tondɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kon de wi u rɑ kpɑɑsi wĩi u kɑm ko.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ kɑ wi u tii sue nɔɔ tiɑ mɔ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kon mɛɛri n wɑ be bɑ nɑɑnɛ mɔ tem mɛ sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n wɑ̃ɑ nɛn bɔkuɔ.","poem":1},{"lineBreak":true},{"text":"Wi u sĩimɔ ɡem sɔɔ, wiyɑ u koo ko nɛn sɔm kowo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛnɔ kun ɑyeru wɑsi nɛn yɛnuɔ.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ mɑɑ wee kowo u ǹ yɔ̃rɑmɔ nɛn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bururu bɑɑtere, nɑ ko n dɑ tem mɛn tɔn kɔ̃sobu nɔɔ mɑrisiewɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ n wɑ n kɑ bu wunɑ mɑm mɑm Yinni Gusunɔn wuun di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}