{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. Ge wee.",{"text":"Yinni Gusunɔ u sɑ̃ɑwɑ nɛn kɑ̀rì.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i ku mɑɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"n yɔ̃ɔwɔ nɡe ɡunɔ n dɑ n kuke ɡuunɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wee tɔn kɔ̃so u win tɛndu bɛri,","poem":1},{"lineBreak":true},{"text":"u win sɛ̃u sɔri u kɑ tɑɑrɛ sɑriruɡii to yɑm wɔ̃kuru sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑnɑm mɛ duniɑ kpuro sɑnkirɑ,","poem":1},{"lineBreak":true},{"text":"mbɑ ɡemɡii u koo mɑɑ kpĩ u ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ i n yɛ̃ mɑ Yinni Gusunɔ u wɑ̃ɑ win sɑ̃ɑ yee dɛɛrɑrɔ,","poem":1},{"lineBreak":true},{"text":"mɑ u win sinɑ ɡɔnɑ swĩi wɔllɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U rɑ tɔn kɔ̃so kɑ mɑɑ tɔn ɡeon dɑɑ wɛ̃ɛri,","poem":1},{"lineBreak":true},{"text":"kpɑ u n dɑm diobu tusɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ben ɑre wee.","poem":1},{"lineBreak":true},{"text":"U rɑ bu sɛɛyɑsie kɑ dɔ̃ɔ kɑ sɔ̃ɔ bisu kɑ woo bɔkɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adɑmɑ u rɑ ɡemɡii dɑm koosie,","poem":1},{"lineBreak":true},{"text":"domi win tii u sɑ̃ɑwɑ ɡemɡii,","poem":1},{"lineBreak":true},{"text":"u rɑ mɑɑ dɑɑ ɡeɑ kɑ̃.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}