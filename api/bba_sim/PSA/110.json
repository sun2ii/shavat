{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ. U nɛɛ,",{"text":"Yinni Gusunɔ u nɛn Yinni sɔ̃ɔwɑ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"u sinɔ win nɔm ɡeuɔ sere u kɑ nùn win yibɛrɛbɑ tɑɑreɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛn Yinni, Yinni Gusunɔ u koo nun ko sunɔ dɑmɡii Siɔniɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ wunɛn wɛrɔbu tɑɑre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɔmɑ te kɑɑ wunɛn tɑbu kowobu mɛnnɑ","poem":1},{"lineBreak":true},{"text":"Gusunɔn ɑye dɛɛrɑru sɔɔ,","poem":1},{"lineBreak":true},{"text":"wunɛn tɔmbɑ koo nun ben tii wɛ̃ kɑ kĩru.","poem":1},{"lineBreak":true},{"text":"Wunɛn ɑluwɑɑsirun dɑm mu koo wurɑmɑ bururu bɑɑtere","poem":1},{"lineBreak":true},{"text":"nɡe mɛ dirum mu rɑ yɑri.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u bɔ̃ruɑ,","poem":1},{"lineBreak":true},{"text":"mɛyɑ u ǹ mɑɑ win ɡɑri seeyɑmɔ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"kɑɑ ko yɑ̃ku kowo kɑ bɑɑdommɑɔ nɡe Mɛɛkisidɛki","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gusunɔ u wɑ̃ɑ wunɛn nɔm ɡeuɔ.","poem":1},{"lineBreak":true},{"text":"U koo sinɑmbu kɑm koosiɑ dɔmɑ te win mɔru seewɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U koo bwesenu siri.","poem":1},{"lineBreak":true},{"text":"Sɑnɑm mɛyɑ ɡonu ko n yibɑ yɑm kpuro.","poem":1},{"lineBreak":true},{"text":"Kpɑ u sinɑmbu kpeerɑsiɑ tem kpuro sɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sunɔ u koo nim nɔ bwiɑɔ win sɑnum sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ u dɑm wɑ u kɑ nɑsɑrɑ suɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}