{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"Kon Yinni Gusunɔ siɑrɑ kɑ nɛn ɡɔ̃ru kpuro.","poem":1},{"lineBreak":true},{"text":"Kon nùn siɑrɑ tɔn dɛɛrobun suunu sɔɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔn nɔmɑn sɔmɑ yɑ kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ be bɑ ye kĩ bɑ kɑsu bu ye ɡiɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ye u kuɑ yɑ rɑ n ɡirimɑ kɑ bɛɛrɛ mɔwɑ.","poem":1},{"lineBreak":true},{"text":"Win ɡem mu rɑ n wɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"U rɑ de su win sɔm mɑɑmɑɑkiɡinu yɑɑyɑ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ u sɑ̃ɑwɑ duromɡii kɑ wɔnwɔnduɡii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U rɑ be bɑ nùn nɑsie dĩɑnu wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ u win ɑrukɑwɑni yɑɑyɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U win tɔmbu win sɔm mɑɑmɑɑkiɡinun dɑm sɔ̃ɔsi","poem":1},{"lineBreak":true},{"text":"ni u kɑ bu tɔn tukobun tem wɛ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Win sɔm mɑɑmɑɑkiɡii ni, nu sɑ̃ɑwɑ ɡem mɑm mɑm.","poem":1},{"lineBreak":true},{"text":"Win woodɑbɑ bɑ mɑɑ nɑɑnɛ mɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yɑ ko n sirerewɑ sere kɑ bɑɑdommɑɔ,","poem":1},{"lineBreak":true},{"text":"domi bɑ ye kuɑwɑ ɡem sɔɔ mɑm mɑm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U derɑ bɑ win tɔmbu yɑkiɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ u kɑ bu ɑrukɑwɑni bɔkuɑ sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Win yĩsiru tɑ dɛɛre, tɑ mɑɑ nɑnum mɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À n kĩ ɑ ko bwisiɡii, ɑ de ɑ ɡinɑ Gusunɔ nɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Be bɑ bwisi mɔ, beyɑ bɑ rɑ yirɑ ye swĩi.","poem":1},{"lineBreak":true},{"text":"Win bɛɛrɛ yɑ ko n wɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}