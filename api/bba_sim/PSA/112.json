{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u Yinni Gusunɔ nɑsie,","poem":1},{"lineBreak":true},{"text":"mɑ win woodɑbɑ bɑ nùn nuku dobu wɛ̃ɛmɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yɛ̃ron bweserɑ koo dɑm ko hɑnduniɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Geeɡibun bibu bɑ koo domɑru wɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alɑfiɑ kɑ dukiɑ ko n wɑ̃ɑ win yɛnuɔ.","poem":1},{"lineBreak":true},{"text":"Win ɡem kun kpeemɔ kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tɔn ɡeo wi u wɔnwɔndu mɔ, u rɑ kɑ tɔnu duure,","poem":1},{"lineBreak":true},{"text":"u mɑɑ sɑ̃ɑ ɡemɡii, wɔ̃kurɑ yɑm dɛɛrɑmɔ win sɔ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u rɑ bɔkure kɑ nuku tiɑ,","poem":1},{"lineBreak":true},{"text":"mɑ u ku rɑ ɡoo tɑki di win sɔmburu sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi ɡeeɡii kun sokurɑmɔ pɑi.","poem":1},{"lineBreak":true},{"text":"Bɑ ko n nùn yɑɑyewɑ kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lɑbɑɑri kɔ̃sɑ ku rɑ nùn nɑnde.","poem":1},{"lineBreak":true},{"text":"Win tororɑ rɑ n sɔ̃wɑ sim sim u n Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"U ku rɑ wurure, bɛrum kun nùn mɔ̀,","poem":1},{"lineBreak":true},{"text":"sere u kɑ win yibɛrɛbɑ kuɑ mɛ u kĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U rɑ sɑ̃ɑrobu kɛ̃nu kɛ̃ kɑ nuku tiɑ.","poem":1},{"lineBreak":true},{"text":"Win ɡem mu ko n wɑ̃ɑwɑ kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Win dɑm mu koo sosi kɑ bɛɛrɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɔn kɔ̃so ù n nùn wɑ, win mɔru rɑ sewɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u nùn wiru diirisi kɑ nuku ɡbisibu.","poem":1},{"lineBreak":true},{"text":"Tɔn kɔ̃sobun yĩiyɔbu kpuro bu sɑ̃ɑwɑ kɑm dirum.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}