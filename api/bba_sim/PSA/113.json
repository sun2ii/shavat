{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"Bɛɛ win sɔm kowobu, i nùn siɑro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Su win yĩsiru bɛɛrɛ wɛ̃ sɑɑ tɛ̃n di sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Su nùn siɑrɑ sɑɑ bururun di sere kɑ yokɑɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔwɑ u bwesenu kpuro kere.","poem":1},{"lineBreak":true},{"text":"Win yiiko yɑ wɑ̃ɑ sere wɔnwɔlleɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinnin wɑ̃ɑ yerɑ wɑ̃ɑ wɔllɔ.","poem":1},{"lineBreak":true},{"text":"Wɑrɑ u kɑ nùn weenɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U rɑ tukewɑ u kɑ wɔllu kɑ tem mɛɛri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U rɑ dɑm sɑriruɡii seeye tem di, kpɑ u wɔnwɔndo seeyɑ kubɑnun di.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kpɑ u de bu sinɑ kɑ win tɔmbun wiruɡibu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U rɑ wĩro yɛnu bɑniɛ u sinɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u nùn ko bii mɛro wi u nuku dobu mɔ win bibun suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}