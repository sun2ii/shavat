{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Sɑnɑm mɛ Isirelibɑ, Yɑkɔbun bibun bweseru","poem":1},{"lineBreak":true},{"text":"bɑ yɑrɑ Eɡibitin di, mɑ bɑ kɑ Eɡibitiɡibu tondɑ","poem":1},{"lineBreak":true},{"text":"bèn bɑrum bɑ ǹ nɔɔmɔ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yudɑ yɑ kuɑ Yinni Gusunɔn sɑ̃ɑ yeru,","poem":1},{"lineBreak":true},{"text":"mɑ Isireli yɑ kuɑ win tem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑnɑm mɛ nim wɔ̃ku ɡɑ bu wɑ, yerɑ ɡɑ dukɑ yɑkurɑ,","poem":1},{"lineBreak":true},{"text":"mɑ dɑɑ te bɑ mɔ̀ Yuudɛni tɑ biru wurɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guunu yɔ̃ɔkumɔ nɡe yɑ̃ɑ kinɛnu,","poem":1},{"lineBreak":true},{"text":"mɑ ɡunɡunu yɔ̃ɔkumɔ nɡe yɑ̃ɑ binu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbɑ n nun deemɑ nim wɔ̃ku ɑ kɑ dukɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Mbɑ n nun mɔ̀ Yuudɛni ɑ kɑ biru wurɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mbɑ n bɛɛ mɔ̀ ɡuunu i kɑ yɔ̃ɔkumɔ nɡe yɑ̃ɑ kinɛnu.","poem":1},{"lineBreak":true},{"text":"Mbɑ n bɛɛ deemɑ ɡunɡunu i kɑ yɔ̃ɔkumɔ nɡe yɑ̃ɑ binu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hɑnduniɑɡibu, i diirio Gusunɔ Yɑkɔbun Yinnin wuswɑɑɔ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wi, wi u rɑ kperu ɡɔsie yɛru,","poem":1},{"lineBreak":true},{"text":"kpɑ u de kpee sɑɑrɑ yu ko nim bweru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}