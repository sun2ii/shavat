{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ, n ǹ bɛsɛ sɑ bɛɛrɛ mɔ,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ bɛɛrɛ mɔ wunɛn tɔn ɡeeru kɑ wunɛn bɔrɔkinirun sɔ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ tɔn tukobu bɑ koo nɛɛ,","poem":1},{"lineBreak":true},{"text":"mɑnɑ Gusunɔ bɛsɛn Yinni u wɑ̃ɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinni u wɑ̃ɑ wɔllɔ, u mɔ̀ ye u kĩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ tɔn tukobɑ ben bũnun bwɑ̃ɑrokunu kuɑwɑ kɑ wurɑ kɑ sii ɡeesu.","poem":1},{"lineBreak":true},{"text":"Nu sɑ̃ɑwɑ tɔmbun nɔmɑn sɔmɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bwɑ̃ɑroku ni, nu nɔsu mɔ, ɑdɑmɑ nu ku rɑ ɡɑri ɡere.","poem":1},{"lineBreak":true},{"text":"Nu nɔni mɔ, ɑdɑmɑ nu ǹ yɑm wɑɑmɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nu swɑsu mɔ, ɑdɑmɑ nu ǹ ɡɑri nɔɔmɔ.","poem":1},{"lineBreak":true},{"text":"Nu wɛ̃ru mɔ, ɑdɑmɑ nu ǹ numiɑmɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nu nɔmɑ mɔ, ɑdɑmɑ nu ǹ kɑ ɡɑ̃ɑnu bɑbɑmɔ.","poem":1},{"lineBreak":true},{"text":"Nu nɑɑsu mɔ, ɑdɑmɑ nu ku rɑ sĩ.","poem":1},{"lineBreak":true},{"text":"Nin dɔkɔrɑ kun mɑɑ nɔɔrɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Be bɑ bwɑ̃ɑroku ni mɔ̀ kɑ be bɑ ben nɑɑnɛ doke ni sɔɔ,","poem":1},{"lineBreak":true},{"text":"bɑ sɑ̃ɑwɑ nɡe ni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛɛ Isirelibɑ, i bɛɛn nɑɑnɛ dokeo Yinni Gusunɔ sɔɔ.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑwɑ bɛɛn fɑɑbɑ kowo kɑ bɛɛn tɛrɛru.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛɛ yɑ̃ku kowobu Aronin bweseru,","poem":1},{"lineBreak":true},{"text":"i bɛɛn nɑɑnɛ dokeo Yinni Gusunɔ sɔɔ.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑwɑ bɛɛn fɑɑbɑ kowo kɑ bɛɛn tɛrɛru.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɛɛ be i Yinni Gusunɔ nɑsie,","poem":1},{"lineBreak":true},{"text":"i bɛɛn nɑɑnɛ dokeo wi sɔɔ.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑwɑ bɛɛn fɑɑbɑ kowo kɑ bɛɛn tɛrɛru.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u sun yɑɑye.","poem":1},{"lineBreak":true},{"text":"U koo sun domɑru kuɑ.","poem":1},{"lineBreak":true},{"text":"U koo Isirelibɑ domɑru kuɑ.","poem":1},{"lineBreak":true},{"text":"U koo Aronin bibun bweseru domɑru kuɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"U koo be bɑ nùn nɑsie domɑru kuɑ, bukurobu kɑ bibu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"U koo bɛɛ kɑ bɛɛn bibu win durom dɑbiɑsiɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u bɛɛ domɑru kuo wi, wi u wɔllu kɑ tem tɑkɑ kuɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wɔllu tɑ sɑ̃ɑwɑ wiɡiru,","poem":1},{"lineBreak":true},{"text":"mɑ u tɔmbu tem wɛ̃.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N ǹ ɡɔribu bɑ rɑ Yinni Gusunɔ sɑ̃","poem":1},{"lineBreak":true},{"text":"be, be bɑ wɑ̃ɑ mi yɑm dɑ n mɑɑri sɔ̃ɔ sɔ̃ɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɛsɛrɑ sɑ ko nùn sɑ̃ sɑɑ tɛ̃n di sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}