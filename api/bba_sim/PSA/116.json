{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Nɑ Yinni Gusunɔ kĩ,","poem":1},{"lineBreak":true},{"text":"domi u rɑ nɛn nɔɔ nɔ nɑ̀ n nùn sokɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"U rɑ nɛn ɡɑri swɑɑ dɑki.","poem":1},{"lineBreak":true},{"text":"Wiyɑ ko nɑ n dɑ soku nɛn wɑ̃ɑrun tɔ̃ru kpuro sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gɔɔn yɔni yi rɑɑ mɑn bɔkuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ɡɔribun wɑ̃ɑ yerun nuku sɑnkirɑnu mɑn nɛni.","poem":1},{"lineBreak":true},{"text":"Nɑ wɑ̃ɑ nɔni swɑ̃ɑru kɑ wuriribu sɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yerɑ nɑ Yinni Gusunɔ nɔɔɡiru sue nɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn wɑ̃ɑru wɔro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinni u sɑ̃ɑwɑ tɔn ɡeo kɑ ɡemɡii.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ win wɔnwɔndɑ kpɑ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u rɑ bwɛ̃ɛbwɛ̃ɛbu kɔ̃su.","poem":1},{"lineBreak":true},{"text":"Nɑ rɑɑ wɔnwɔndu soore,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ u mɑn fɑɑbɑ kuɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛn bwɛ̃rɑ, ɑ wɛ̃ro,","poem":1},{"lineBreak":true},{"text":"domi Yinni Gusunɔ u mɑn ɡeɑ kuɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Geemɑ, u mɑn wɔrɑ ɡɔɔn di,","poem":1},{"lineBreak":true},{"text":"mɑ u nɛn nɔni yĩresu wokɑ, u ǹ dere n sokurɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kon sĩ win wuswɑɑɔ hɑnduniɑ ye sɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nɑ nùn nɑɑnɛ doke, bɑɑ mɛ nɑ nɛɛ, nɑ wɔnwɔndu soore.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛn nuku sɑnkirɑru sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ nɛɛ, ɡoo sɑri wi u nɑɑnɛ mɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mbɑ kon Yinni Gusunɔ dibu kɔsiɑ ɡeɑ ye u mɑn kuɑn sɔ̃.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kon tɑm tɑ̃rɑ win wuswɑɑɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n win yĩsiru soku n kɑ nùn siɑrɑ","poem":1},{"lineBreak":true},{"text":"fɑɑbɑ ye u mɑn kuɑn sɔ̃.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nɔɔ mwɛɛ ni nɑ nùn kuɑ,","poem":1},{"lineBreak":true},{"text":"kon nu yibiɑ win tɔmbu kpuron nɔni biru.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Be bɑ Yinni Gusunɔ nɑɑnɛ sɑ̃ɑn ɡɔɔ u sɑ̃ɑwɑ ɡɑ̃ɑ bɑkɑnu win mi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛ, wunɛn sɔm kowo swɑɑ dɑkio.","poem":1},{"lineBreak":true},{"text":"Nɑ sɑ̃ɑwɑ wunɛn sɔm kowo tɔn kurɔn bii.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ nɛn yorun wɛ̃ɛ burɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ kon nun siɑrɑbun yɑ̃kuru kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ n wunɛn yĩsiru soku.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nɔɔ mwɛɛ ni nɑ nun kuɑ,","poem":1},{"lineBreak":true},{"text":"kon nu yibiɑ wunɛn tɔmbu kpuron nɔni biru,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"wunɛn sɑ̃ɑ yerɔ Yerusɑlɛmun suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}