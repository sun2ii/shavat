{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ nɑ ɑ sun fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"Wee ɡemɡibɑ doonɑ.","poem":1},{"lineBreak":true},{"text":"Nɑɑnɛɡii ɡoo mɑɑ sɑri hɑnduniɑ sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Weesɑ bɑɑwure u rɑ n win winsim kuɑmmɛ,","poem":1},{"lineBreak":true},{"text":"u n nùn nɔni wɔ̃kumɔ kɑ ɡɑri dori.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ be bɑ tɔmbu fufu mɔ̀n nɔsu kɔruo.","poem":1},{"lineBreak":true},{"text":"A be bɑ ɡɑri ɡerumɔ kɑ tii suɑbu mɑrisio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi bɑ ɡerumɔ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"bɑ rɑ wɑ ye bɑ kĩ ben nɔɔ dobun sɑɑbu,","poem":1},{"lineBreak":true},{"text":"bɑ ɡɑri ɡerubu yɛ̃,","poem":1},{"lineBreak":true},{"text":"bɑ ǹ ɡoon bɛrum mɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ, ɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"ɑ wɔnwɔndo be bɑ dɑm dɔremɔ wɑɑmɔ.","poem":1},{"lineBreak":true},{"text":"A sɑ̃ɑro be bɑ weeweenu mɔ̀ wɑɑmɔ.","poem":1},{"lineBreak":true},{"text":"A be bɑ yɑ̃ɑtɑm siemɔ wɑɑmɔ.","poem":1},{"lineBreak":true},{"text":"Tɛ̃, kɑɑ se ɑ be kpuro fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛn ɡɑri yi dɛɛrewɑ.","poem":1},{"lineBreak":true},{"text":"Yi sɑ̃ɑwɑ nɡe sii ɡee si bɑ sɔwɑ nɔn nɔɔbɑ yiru.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ yi nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wee tɔn kɔ̃sobu bɑ wɑ̃ɑ yɑm kpuro.","poem":1},{"lineBreak":true},{"text":"Mɑ tɔmbɑ sɑnkirɑmɔ bɑ dɔɔ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sun kɔ̃suo.","poem":1},{"lineBreak":true},{"text":"A sun ɡbɑro ben nɔmɑn di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}