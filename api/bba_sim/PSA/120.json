{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Sɑnɑm mɛ nɑ wɑ̃ɑ nuku sɑnkirɑnu sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ Yinni Gusunɔ sokɑ, mɑ u mɑn wurɑri.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn wɔro wee kowobun nɔmɑn di.","poem":1},{"lineBreak":true},{"text":"A mɑn yɑkio be bɑ tɔmbu nɔni wɔ̃kumɔn nɔmɑn di.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbɑ weesu koo kɑ bu nɑɑwɑ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mɑ n kun mɔ tɑbu sɛ̃ɛnu kɑ dɔ̃ɔ bokon ɡɛ̃ɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wee nɑ kuɑ kɑm koore,","poem":1},{"lineBreak":true},{"text":"nɑ wɑ̃ɑ Mɛsɛkiɔ Kedɑnin kuu bekuruɡirɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ sɔ̃ n tɛ kɑ be bɑ ku rɑ bɔri yɛndu kɑ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ̀ n bɔri yɛndun ɡɑri ɡerubu toruɑ,","poem":1},{"lineBreak":true},{"text":"bɑ rɑ n tɑbun sɔɔru mɔ̀wɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}