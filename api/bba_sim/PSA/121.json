{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Nɑ nɛn nɔni sue ɡuunu ɡiɑ.","poem":1},{"lineBreak":true},{"text":"Mɑn diyɑ kon somiru wɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛn somirɑ weewɑ sɑɑ Yinni Gusunɔn min di","poem":1},{"lineBreak":true},{"text":"wi u wɔllu kɑ tem tɑkɑ kuɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"U ǹ derimɔ wunɛn nɑɑsu su sokurɑ.","poem":1},{"lineBreak":true},{"text":"Wi u nun kɔ̃su, u ǹ dom yĩbirimɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wee wi u Isirelibɑ kɔ̃su u ku rɑ dom yĩbiri,","poem":1},{"lineBreak":true},{"text":"u ku rɑ mɑɑ dweeye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u sɑ̃ɑwɑ wunɛn kɔ̃so.","poem":1},{"lineBreak":true},{"text":"U wɑ̃ɑ wunɛn nɔn ɡeuɔ u nun sɑɑru sɑ̃ɑwɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sɔ̃ɔ sɔɔ, sɔ̃ɔ kun nun soomɔ.","poem":1},{"lineBreak":true},{"text":"Wɔ̃kuru, suru tɑrum kun mɑɑ nun soomɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u koo nun bere ɡɑ̃ɑ kɔ̃sunu kpuron di.","poem":1},{"lineBreak":true},{"text":"U koo wunɛn hunde kɔ̃su,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kpɑ u nun kpɑrɑ wunɛn dɑɑru kɑ weru","poem":1},{"lineBreak":true},{"text":"sɑɑ tɛ̃n di sere kɑ bɑɑdommɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}