{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu ɡe Dɑfidi u kuɑ. Ge wee.",{"text":"Bɑ̀ n nɛɛ, su dɑ Yinni Gusunɔn sɑ̃ɑ yerɔ,","poem":1},{"lineBreak":true},{"text":"nɛn nukurɑ rɑ dorewɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, bɛsɛn nɑɑsu su yɔ̃ wunɛn kɔnnɔsɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, ɑ sɑ̃ɑwɑ wuu ɡe bɑ bɑnɑ ɡeɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ɡu ɡbɑ̃rɑru toosi bɑ kɑ sikerenɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wunɛn miyɑ Isirelibɑ, Yinni Gusunɔn tɔmbu bɑ rɑ nɛ bu kɑ nùn siɑrɑ,","poem":1},{"lineBreak":true},{"text":"nɡe mɛ u bu woodɑ wɛ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wunɛn miyɑ siri ɡbɑburɑ wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn miyɑ Dɑfidin bibun bweserun sinɑ ɡɔnɑ wɑ̃ɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bɔri yɛndu kɑnɔ Yerusɑlɛmun sɔ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ be bɑ wunɛ Yerusɑlɛmu kĩ bɑ n wɑ̃ɑ bwɛ̃ɛ dorɑ sɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, bɔri yɛndɑ n wɑ̃ɑ wunɛn ɡbɑ̃rɑru sɔɔ kɑ wunɛn sinɑ kpɑɑrɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛn mɛro bisibu kɑ nɛn bɔrɔbɑn sɔ̃,","poem":1},{"lineBreak":true},{"text":"kon nɛɛ, Gusunɔ u de bɔri yɛndɑ n wɑ̃ɑ Yerusɑlɛmuɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, wunɛn ɡeɑ nɑ kɑsu, Gusunɔ bɛsɛn Yinnin sɑ̃ɑ yerun sɔ̃.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}