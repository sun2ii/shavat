{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu ɡe Dɑfidi u kuɑ. U nɛɛ,",{"text":"Gusunɔ Isirelibɑn Yinni ù kun dɑɑ kɑ sun wɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"wɑrɑ u koo sun kɔ̃su.","poem":1},{"lineBreak":true},{"text":"Isirelibɑ bu wureo bu ɡere bu nɛɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sɑnɑm mɛ tɔn kɔ̃sobun mɔru yɑ seewɑ, mɑ bɑ sun seesi,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ ù kun dɑɑ kɑ sun wɑ̃ɑ, bɑ koo sun mwɛ wɑsiru,","poem":1},{"lineBreak":true},{"text":"kpɑ bu sun wukiri nɡe nim mɛ mu kokumɔ dɑɑ torɑɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nim kure dɑmɡinɑ nu koo sun tɑɑre.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sɑ Yinni Gusunɔ siɑrɑ,","poem":1},{"lineBreak":true},{"text":"domi u ǹ dere bɛsɛn yibɛrɛbɑ bu sun nɔɔ bɛri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U derɑ bɛsɛn hunde yɑ kisirɑ sɑɑ tɑɑn di nɡe ɡunɔ.","poem":1},{"lineBreak":true},{"text":"Tɑɑ yɑ kɑsikirɑ mɑ sɑ yɑrɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔwɑ u sɑ̃ɑ bɛsɛn fɑɑbɑ kowo.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u wɔllu kɑ tem tɑkɑ kuɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":6}