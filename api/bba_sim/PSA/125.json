{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Be bɑ Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"bɑ rɑ n yɔ̃wɑ dim dim nɡe Siɔnin ɡuuru.","poem":1},{"lineBreak":true},{"text":"Tɑ ku rɑ bɑ̃ɑri. Tɑ ko n yɔ̃wɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɡe mɛ ɡuunu kɑ Yerusɑlɛmu sikerenɛ,","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ Gusunɔ u kɑ win tɔmbu sikerenɛ sɑɑ tɛ̃n di sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɔn kɔ̃so kun bɑndu dimɔ ɡemɡibun temɔ.","poem":1},{"lineBreak":true},{"text":"Domi ù n tu di, ben tii bɑ koo kɔ̃sɑ ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ be bɑ ɡeɑ mɔ̀ ɡeɑ sɔ̃ɔsio.","poem":1},{"lineBreak":true},{"text":"A bèn ɡɔ̃ru ɡɑ dɛɛre durom kuo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ be bɑ swɑɑ mwɑɑmɔ ye yɑ ǹ dɛnde","poem":1},{"lineBreak":true},{"text":"ɑ bu yɑrinɑsio kɑ kɔ̃sɑn kowobu sɑnnu.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ de bɔri yɛndɑ n wɑ̃ɑ Isireliɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}