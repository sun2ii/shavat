{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Sɑnɑm mɛ Yinni Gusunɔ u kɑ bɛsɛɡii be bɑ yoru mwɛɛrɑ wurɑmɑ Siɔniɔ,","poem":1},{"lineBreak":true},{"text":"yɑ sun sɑ̃ɑwɛwɑ nɡe dosu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɑ sɑ nuku dobu mɔ̀ sɑ yɛ̃ɛmɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ sɑ nɑsɑrɑn kuuki mɔ̀.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ ɡerumɔ bwesenun suunu sɔɔ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ u sun ɡɑ̃ɑ bɑkɑnu kuɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɛyɑ u sun ɡɑ̃ɑ bɑkɑnu kuɑ.","poem":1},{"lineBreak":true},{"text":"Wee sɑ wɑ̃ɑ tɛ̃ nuku dobu sɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ kɑ bɛsɛɡii be bɑ rɑɑ yoru mwɛɛrɑ wurɑmɑ","poem":1},{"lineBreak":true},{"text":"bɑ n kokumɔ nɡe dɑɑ tori sɔ̃ɔ yɛ̃sɑn nɔm dwɑru ɡiɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be bɑ duurumɔ kɑ nɔni yĩresu,","poem":1},{"lineBreak":true},{"text":"bɑ koo ɡɛ̃ kɑ nuku dobun kuuki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wi u duurubu dɔɔ kɑ wuri,","poem":1},{"lineBreak":true},{"text":"u koo wurɑmɑ kɑ nuku dobu,","poem":1},{"lineBreak":true},{"text":"u n doo bɔkunu sɔɔwɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}