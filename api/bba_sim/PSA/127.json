{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu ɡe Sɑlomɔɔ u kuɑ. Ge wee.",{"text":"Yinni Gusunɔ ù kun diru bɑnimɔ,","poem":1},{"lineBreak":true},{"text":"be bɑ tu bɑnimɔ sɔmburu kɑmɑ bɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ ù kun wuu kɔ̃su,","poem":1},{"lineBreak":true},{"text":"be bɑ ɡu kɔ̃su bɑ dom serɑwɑ kɑm.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kɑm sɔɔrɑ kɑɑ wɑhɑlɑ ko ɑ kɑ wunɛn dĩɑnu wɑ ɑ di.","poem":1},{"lineBreak":true},{"text":"Kɑɑ se buru buru yellu kpɑ ɑ kpunɑ sere wɔ̃ku suunu sɔmburun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ wi Gusunɔ u kĩ,","poem":1},{"lineBreak":true},{"text":"u rɑ nùn dĩɑnu wɛ̃wɑ bɑɑ yɛ̃ro ù n dò.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wee, bibu bɑ sɑ̃ɑwɑ tubi ye yɑ wee Gusunɔn min di.","poem":1},{"lineBreak":true},{"text":"Bɑ sɑ̃ɑwɑ soseru te tɑ wee Gusunɔn min di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bii be bɑ mɑrɑ ɑluwɑɑsiru sɔɔ,","poem":1},{"lineBreak":true},{"text":"bɑ sɑ̃ɑwɑ nɡe sɛ̃ɛnu tɑbu durɔ dɑmɡiin nɔmɑɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u bu wɑ n dɑbi.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑwɑ nɡe wìn sɛ̃ɛ bwɑ̃ɑrɑ sɛ̃ɛnu yibɑ.","poem":1},{"lineBreak":true},{"text":"U ǹ sekuru wɑsi sɑnɑm mɛ u koo kɑ win yibɛrɛbɑ yinnɑ wuun ɡbɑ̃rɑrun kɔnnɔwɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}