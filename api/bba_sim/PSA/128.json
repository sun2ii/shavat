ɛ Yerusɑlɛmu yɑ kuurɑmɔ wunɛn wɑ̃ɑrun tɔ̃ru kpuro sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɑɑ wunɛn bibun bibu wɑ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ u de bɔri yɛndɑ n wɑ̃ɑ Isireliɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}