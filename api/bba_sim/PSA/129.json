{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Isirelibɑ bu ɡeruo sɑnnu sɑnnu bu nɛɛ,","poem":1},{"lineBreak":true},{"text":"ɡeemɑ, tɔn kɔ̃sobu bɑ rɑ n sun dɑm dɔremɔwɑ","poem":1},{"lineBreak":true},{"text":"sɑɑ bɛsɛn bweserun toren di.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɑ sun nɔni sɔ̃ɔwɑ bɛsɛn bweserun toren di.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ bɑ ǹ nɑsɑrɑ wɑ bɛsɛn wɔllɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɑ wukɑ bɛsɛn birusun wɔllɔ bɑ kpĩi wunɑ wunɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ u sɑ̃ɑwɑ ɡemɡii,","poem":1},{"lineBreak":true},{"text":"u ben wɛ̃ɛ kɑsukɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ de be bɑ Yerusɑlɛmu tusɑ bu sekuru wɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu biruku yirɑ wurɑ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bɑ n sɑ̃ɑ nɡe yɑkɑ si su rɑ kpi diru wɔllɔ.","poem":1},{"lineBreak":true},{"text":"Su rɑ ɡberewɑ bɑ kun su wukurɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wi u su ɡɛ̃ɛmɔ, su ku rɑ win nɔmu yibu.","poem":1},{"lineBreak":true},{"text":"Wi u mɑɑ su ɡurɑmɔ, su ku rɑ win nɔm koto teeru turi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Be bɑ sɑrɔ mi, bu ku bu domɑru kuɑ bu nɛɛ,","poem":1},{"lineBreak":true},{"text":"Gusunɔn domɑru tɑ n kɑ bu wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Bu ku rɑɑ mɑɑ nɛɛ, bɑ bu domɑru kuɑ kɑ Yinni Gusunɔn yĩsiru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}