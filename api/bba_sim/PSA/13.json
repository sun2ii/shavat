{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, sere dommɑ kɑɑ n mɑn duɑri.","poem":1},{"lineBreak":true},{"text":"Sere dommɑ kɑɑ n mɑn wuswɑɑ berue.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sere dommɑ kɑɑ n derɑ nɑ n bwisikumɔ nɛn ɡɔ̃ruɔ.","poem":1},{"lineBreak":true},{"text":"Sere dommɑ kɑɑ n derɑ nɑ n nuki sɑnkire.","poem":1},{"lineBreak":true},{"text":"Sere dommɑ kɑɑ n derɑ nɛn yibɛrɛ u n mɑn tɑɑre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ suuru koowo.","poem":1},{"lineBreak":true},{"text":"A mɑn wisio. A mɑn dɑm kɛ̃ɛyɔ.","poem":1},{"lineBreak":true},{"text":"A de nɛn nɔni yi ɡɛllɑ.","poem":1},{"lineBreak":true},{"text":"A ku de n ɡbi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A ku de nɛn yibɛrɛbɑ bu mɑn kɑmiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu woo kɑnɑ.","poem":1},{"lineBreak":true},{"text":"A ku de nɑ n bɑ̃ɑrimɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n nuku dobu mɔ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ nun nɑɑnɛ sɑ̃ɑ domi ɑ mɑn kĩ sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ nun nɑɑnɛ sɑ̃ɑ domi ɑ mɑn ɡeɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ nun nɑɑnɛ sɑ̃ɑ domi ɑ mɑn fɑɑbɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɑ nuku dobu mɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ kon siɑrɑ kɑ womusu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}