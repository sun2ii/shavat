{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Yinni Gusunɔ, sɑɑ wɔru bɑkɔn diyɑ nɑ nun nɔɔɡiru sue.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni, ɑ nɛn nɔɔ nɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"A swɑɑ tem kpĩiyɔ ɑ nɛn kɑnɑru nɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ̀ n dɑ tɔmbun torɑnu yɑɑye,","poem":1},{"lineBreak":true},{"text":"wɑrɑ u ko n mɑɑ wɑ̃ɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ rɑ tɔmbu suuru kue bu kɑ nun nɑsiɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ win nɔɔ mwɛɛru mɑrɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ Yinni Gusunɔ mɑrɑ","poem":1},{"lineBreak":true},{"text":"n kere nɡe mɛ wuu kɔ̃so u rɑ n yɑm sɑ̃reru mɑrɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Isirelibɑ, i bɛɛn nɑɑnɛ dokeo Yinni Gusunɔ sɔɔ,","poem":1},{"lineBreak":true},{"text":"domi u wɔnwɔndu mɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u rɑ tɔmbu yɑkie kɑ swɑɑ dɑbinu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wiyɑ u koo bɛɛ Isirelibɑ yɑkiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u bɛɛn torɑnu kpuro suuru ko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}