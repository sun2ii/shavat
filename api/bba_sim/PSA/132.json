{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":132,"content":[{"type":"verse","number":1,"content":["Sɑ̃ɑ dɑɑrun womu. Ge wee.",{"text":"Yinni Gusunɔ, ɑ Dɑfidi yɑɑyo","poem":1},{"lineBreak":true},{"text":"win wɑhɑlɑ ye u kuɑ kpuron sɔ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Domi u wunɛ Yɑkɔbun Yinni dɑmɡii nɔɔ mwɛɛru kuɑ u nɛɛ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"u ǹ duɔ win kuu bekuruɡirɔ u sere nɛɛ,","poem":1},{"lineBreak":true},{"text":"u koo kpunɑ win kpin yerɔ mi u rɑ wɛ̃re.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"U ǹ dom yĩbirimɔ, u ǹ mɑɑ doyɑmɔ","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mɑ n kun mɔ u wunɛ Yɑkɔbun Yinni dɑmɡii wɑ̃ɑ yeru kuɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wee sɑ nuɑ mɑ woodɑn kpɑkororu tɑ wɑ̃ɑ Efɑrɑtɑɔ,","poem":1},{"lineBreak":true},{"text":"mɑ sɑ tu deemɑ Yɑɑrin ɡberɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Su du Yinni Gusunɔn sɑ̃ɑ yerɔ, kpɑ su nùn kpunɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ seewo kpɑ ɑ nɑ mi ɑ rɑ wɛ̃re","poem":1},{"lineBreak":true},{"text":"wunɛ kɑ wunɛn woodɑn kpɑkororu","poem":1},{"lineBreak":true},{"text":"tèn wɔllɔ ɑ rɑ wunɛn yiiko sɔ̃ɔsi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A de wunɛn yɑ̃ku kowobu bɑ n ɡem swĩi,","poem":1},{"lineBreak":true},{"text":"kpɑ be bɑ nun nɑɑnɛ sɑ̃ɑ bɑ n nuku dobun kuuki mɔ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A ku wi ɑ ɡɔsɑ yinɑ Dɑfidi wunɛn sɔm kowon sɔ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u Dɑfidi ɡem sɔ̃ɔwɑ kɑ bɔ̃ri u nɛɛ,","poem":1},{"lineBreak":true},{"text":"u koo win nɔɔ mwɛɛru yibiɑwɑ kɑm kɑm te u nɛɛ,","poem":1},{"lineBreak":true},{"text":"Dɑfidin bibun turowɑ u koo nùn kɔsire ko win bɑndu sɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bii be, bɑ̀ n win ɑrukɑwɑni yibiɑ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ win woodɑbɑ mɛm nɔɔwɑ be u bu wɛ̃,","poem":1},{"lineBreak":true},{"text":"ben bibun bweserɑ tɑ ko n bɑndu dii sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u Siɔni ɡɔsɑ.","poem":1},{"lineBreak":true},{"text":"U ye ɡɔsɑ yɑ n kɑ sɑ̃ɑ win wɑ̃ɑ yeru.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɑ u nɛɛ, yɑ ko n sɑ̃ɑ win wɛ̃rɑ yeru sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"U koo sinɑ mi, domi wiyɑ u ye ɡɔsɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"U koo ye domɑru kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u ye dĩɑnu wɛ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"U koo yen yɑ̃ku kowobu fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ be bɑ nùn nɑɑnɛ sɑ̃ɑ bu nuku dobun kuuki ko.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Miyɑ u koo Dɑfidi wi u ɡɔsɑn dɑm sosi,","poem":1},{"lineBreak":true},{"text":"kpɑ u win bweserun ɡoo swĩi, u n sɑ̃ɑ nɡe fitilɑ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"U koo de win yibɛrɛbɑ bu sekuru wɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ wi, win sinɑ furɔ ɡɑ ko n bɑllimɔwɑ win wiru wɔllɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}