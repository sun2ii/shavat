{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro domi u sɑ̃ɑ tɔn ɡeo.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I Gusunɔ siɑro, u bũnu kpuro kere.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I yinnibun Yinni siɑro.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wi turowɑ u rɑ sɔm mɑɑmɑɑkiɡii bɑkɑnu ko.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wiyɑ u wɔllu kɑ tem tɑkɑ kuɑ kɑ win bwisi.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U tem tɛriɑ nim wɔllɔ, mɑ u sɔ̃ɔ kɑ suru kuɑ.","poem":1},{"lineBreak":true},{"text":"U sɔ̃ɔ kuɑwɑ u kɑ yɑm bururɑsiɑ sɔ̃ɔ sɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ u suru kɑ kperi kuɑ ye kpuro yu kɑ yɑm bururɑsiɑ wɔ̃kuru.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wiyɑ u Eɡibitiɡibun bii ɡbiikobu ɡo.","poem":1},{"lineBreak":true},{"text":"Mɑ u Isirelibɑ yɑrɑ Eɡibitiɡii ben suunu sɔɔn di.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɑ win dɑmɑ u kɑ nim wɔ̃ku ɡe bɑ mɔ̀ Nɑɑ yɑri burɑnɑ yiru,","poem":1},{"lineBreak":true},{"text":"mɑ u derɑ Isirelibɑ bɑ tɔburɑ ɡen suunu sɔɔn di.","poem":1},{"lineBreak":true},{"text":"Mɑ u Eɡibitin sinɑ boko kɑ win tɑbu kowobu sure nim wɔ̃ku ɡe sɔɔ.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wiyɑ u win tɔmbu kpɑrɑ ɡbɑburɔ.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wiyɑ u sinɑmbu ɡo be bɑ dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Beyɑ, Sihoni Amɔrebɑn sunɔ kɑ Oɡu Bɑsɑnin sunɔ.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wiyɑ u tɔn ben tem win sɔm kowobu Isirelibɑ wɛ̃ bɑ tubi di.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wiyɑ u sun yɑɑyɑ sɑnɑm mɛ sɑ wɑ̃ɑ sekuru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ u sun wɔrɑ be bɑ sun dɑm dɔremɔn nɔmɑn di.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wiyɑ u rɑ hunde koni bɑɑyere dĩɑnu wɛ̃.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I Wɔrukoo siɑro.","poem":1},{"lineBreak":true},{"text":"Win wɔnwɔndu tɑ ku rɑ kpe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":14}