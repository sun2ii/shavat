{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Sɑ sɔ̃wɑ Bɑbilonin dɑɑrun ɡoorɔ","poem":1},{"lineBreak":true},{"text":"mɑ sɑ sumɔ sɑ kɑ Siɔni yɑɑyɑmɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sɑ bɛsɛn mɔrɔkunu bwɛ̃ dɑ̃ɑɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Be bɑ sun tɑbu di bɑ nɛɛ, su womu koowo.","poem":1},{"lineBreak":true},{"text":"Be bɑ sun dɑm dɔremɔ bɑ nɛɛ, su Siɔnin womusu ko kɑ nuku dobu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ ɑmɔnɑ sɑ ko kpĩ su Yinni Gusunɔ womusu kuɑ tem tukumɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, nɑ̀ n nun duɑri, nɛn nɔm ɡeu ɡu ɡbio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ̀ kun nun yɑɑye kpɑ ɑ n sɑ̃ɑ nɛn nuku dobun nuuru,","poem":1},{"lineBreak":true},{"text":"nɛn yɑrɑ yu nɛn dɑro mɑniɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ de ɑ Edɔmubɑn ɡɑri yɑɑyɑ","poem":1},{"lineBreak":true},{"text":"yi bɑ ɡeruɑ sɑnɑm mɛ bɑ Yerusɑlɛmu kɑm koosiɑmɔ","poem":1},{"lineBreak":true},{"text":"bɑ nɛɛ, bu ye kɛro mɑm mɑm sere kɑ yen kpɛɛkpɛɛkuɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɑbiloniɡibu, i sɑ̃ɑwɑ be bɑ koo kɑm koosiɑ.","poem":1},{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u koo bɛɛ kɔ̃sɑ yèn bweseru i rɑɑ sun kuɑ kɔsie.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u koo bɛɛn bibu sɛ̃re u kɔsuku kperu wɔllɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}