{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":138,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ. Ge wee.",{"text":"Yinni Gusunɔ, nɑ nun siɑrɑmɔ kɑ nɛn ɡɔ̃ru kpuro.","poem":1},{"lineBreak":true},{"text":"Kon nun tɔmɑ wɔllun tɔmbun wuswɑɑɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kon nun kpunɑ wunɛn sɑ̃ɑ yee dɛɛrɑrɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n nun tɔmɑ wunɛn tɔn ɡeeru kɑ wunɛn bɔrɔkinirun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Domi ɑ yĩsiru yɑrɑ wunɛn nɔɔ mwɛɛ te ɑ rɑ yibien sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑɑ ye nɑ nun sokɑ, ɑ mɑn wurɑri.","poem":1},{"lineBreak":true},{"text":"A mɑn dɑm kɑ̃, ɑ mɑn toro sindu wɛ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, sinɑmbu kpurowɑ bɑ koo nun siɑrɑ.","poem":1},{"lineBreak":true},{"text":"Domi bɑ wunɛn ɡɑri nuɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɑ koo wunɛn kookoosu siɑrɑ.","poem":1},{"lineBreak":true},{"text":"Domi wunɛn bɛɛrɛ yɑ kpɑ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, bɑɑ mɛ ɑ kpɑ̃, ɑ be bɑ tii kɑwe wɑɑmɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ rɑ be bɑ tii sue tubu sɑɑ tontonden di.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ̀ n sĩimɔ nuku sɑnkirɑnun swɑɑ sɔɔ,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ mɑn wɑ̃ɑru wɛ̃.","poem":1},{"lineBreak":true},{"text":"A rɑ nɛn yibɛrɛbɑ nɔmu dɛmiɛ bɑ̀ n kɑ mɑn mɔru seewɑ.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ wunɛn dɑm mu rɑ mɑn fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, kɑɑ mɑn sɑnnɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn tɔn ɡeeru tɑ ǹ nɔru mɔ.","poem":1},{"lineBreak":true},{"text":"Be ɑ tɑkɑ kuɑ, ɑ ku bu deri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}