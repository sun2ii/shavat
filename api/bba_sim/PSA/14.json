{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ. Ge wee.",{"text":"Wee nɡe mɛ ɡɑri bɑkɑsu su sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Su rɑ nɛɛ, Gusunɔ sɑri.","poem":1},{"lineBreak":true},{"text":"Su sɑnkire.","poem":1},{"lineBreak":true},{"text":"Su kom kɔ̃sum mɔ̀.","poem":1},{"lineBreak":true},{"text":"Sin ɡɑɡu sɑri ɡe ɡɑ ɡeɑ mɔ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u tɔmbu mɛɛrimɑ sɑɑ wɔllun di,","poem":1},{"lineBreak":true},{"text":"u kɑ wɑ ɡoo ù n wɑ̃ɑ u bwisi mɔ,","poem":1},{"lineBreak":true},{"text":"u kɑ wɑ ɡoo ù n wɑ̃ɑ u nùn sɑ̃ɑmɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adɑmɑ u wɑ, be kpurowɑ bɑ kɔ̃ɔre,","poem":1},{"lineBreak":true},{"text":"be kpurowɑ bɑ sɑnkire,","poem":1},{"lineBreak":true},{"text":"be kpurowɑ bɑ kɔ̃sɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Bɑɑ ben turo kun ɡeɑ mɔ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ye u wɑ mɛ, yerɑ u tii bikiɑ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"kɔ̃sɑn kowo be, bɑ ǹ yɛ̃ru mɔ?","poem":1},{"lineBreak":true},{"text":"Wee bɑ nɛn tɔmbu ɡbɛnimɔ,","poem":1},{"lineBreak":true},{"text":"ben ɡoo kun mɑn sɑ̃ɑmɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yen sɔ̃, kon de bu diiri ɡem ɡem","poem":1},{"lineBreak":true},{"text":"domi ko nɑ n wɑ̃ɑ be bɑ mɑn mɛm nɔɔwɑmmɛn suunu sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛɛ kɔ̃sɑn kowobu, i sɑ̃ɑrobun himbɑ sɑnkumɔ,","poem":1},{"lineBreak":true},{"text":"i bu sekuru dokemɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ u bu kɔ̃su.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ nun kɑnɑmɔ,","poem":1},{"lineBreak":true},{"text":"ɑ de fɑɑbɑ kowo ɡoo u yɑri Siɔnin di","poem":1},{"lineBreak":true},{"text":"u Isirelibɑ, Yɑkɔbun bweseru yɑrɑ dɛsirun di,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n wɑ̃ɑ bɔri yɛndu sɔɔ.","poem":1},{"lineBreak":true},{"text":"À n kuɑ mɛ,","poem":1},{"lineBreak":true},{"text":"ɑnnɑ ɑ nuku dobu wɑ bi bɑ koo ko mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}