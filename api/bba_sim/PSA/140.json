{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ mɑn wɔro tɔn kɔ̃sobun nɔmɑn di.","poem":1},{"lineBreak":true},{"text":"A mɑn ɡbɑro ɡbɑnɑɡibun nɔmɑn di.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi kɔ̃sɑ bɑ rɑ n bwisikumɔ ben ɡɔ̃ruɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bɑ n sɔɔru kpeere bɑɑdommɑ bu kɑ tɑbu ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ rɑ ben yɑrɑ derewɑ nɡe wɑɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ ben nɔɔ ɡɑ n dɛ̃ɛ mɔ nɡe surɔkɔru.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn tɔn kɔ̃so ɡbɑro.","poem":1},{"lineBreak":true},{"text":"A mɑn ɡbɑnɑɡibu ɡiro be bɑ kɑsu bu mɑn surɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wee tii suobu bɑ mɑn yinɑ bɛriɑmmɛ.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑn tɑɑ yinuɑmmɛ swɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ mɑn yɔɔru bwɛ̃ɛyɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɑ nɛɛ, Gusunɔ, wunɑ ɑ sɑ̃ɑ nɛn Yinni.","poem":1},{"lineBreak":true},{"text":"A swɑɑ tem kpĩiyɔ ɑ nɛn kɑnɑru nɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ ɡbɑ̃rɑru tèn mi nɑ rɑ kuke n kɑ fɑɑbɑ wɑ.","poem":1},{"lineBreak":true},{"text":"A rɑ nɛn wiru bere tɑbun sɑɑ sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A ku de tɔn kɔ̃son kĩru tu koorɑ.","poem":1},{"lineBreak":true},{"text":"A ku de ye u niɑ sɑ̃ɑ yu koorɑ, kpɑ u ku rɑɑ tii suɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be bɑ mɑn kooro buremɔ","poem":1},{"lineBreak":true},{"text":"ɑ de ben torɑnu nu wɔri ben wiru wɔllɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A bu dɔ̃ɔ wisio kpɑ ɑ de bu wɔri wɔru bɔkɔ sɔɔ","poem":1},{"lineBreak":true},{"text":"ɡèn min di bɑ ǹ mɑɑ kpɛ̃ bu yɑri.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wi u weesu mɔ̀ u ǹ tɑ̃simɔ tem mɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kɔ̃sɑ yɑ ko n mɑɑ ɡbɑnɑɡii swĩiwɑ sere u kɑ kɑm ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɑ yɛ̃ mɑ Yinni Gusunɔ u rɑ wɔnwɔndo siriewɑ dee dee.","poem":1},{"lineBreak":true},{"text":"Kpɑ u mɑɑ sɑ̃ɑro nùn win ɡem wɛ̃.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Geemɑ, ɡemɡibu bɑ koo nun tɔmɑ kpɑ bɑ n wɑ̃ɑ wunɛn wuswɑɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}