{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ. Ge wee.",{"text":"Yinni Gusunɔ, nɑ nun soku, ɑ nɑ fuuku nɛn mi.","poem":1},{"lineBreak":true},{"text":"A nɛn nɔɔ swɑɑ dɑkio nɑ̀ n nun sokumɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A de nɛn kɑnɑru tu nun ɡirɑri nɡe turɑre nubu duroruɡiɑn wiisu.","poem":1},{"lineBreak":true},{"text":"Kpɑ nɔmɑ ye nɑ yiiye yɑ n sɑ̃ɑ nɡe kɛ̃ru","poem":1},{"lineBreak":true},{"text":"te bɑ rɑ kɑ nun nɑɑwɛ wunɛn sɑ̃ɑ yerɔ yokɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn nɔɔ bɔkuo.","poem":1},{"lineBreak":true},{"text":"A nɛn nɔɔ sɑrusu kɔ̃suo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ku de nɛn ɡɔ̃ru ɡu dɑ kɔ̃sɑ ɡiɑ.","poem":1},{"lineBreak":true},{"text":"A ku de n kom kɔ̃sum ko kɑ be bɑ ɡem sɑriru swĩi.","poem":1},{"lineBreak":true},{"text":"A ku de n kɑ bu tɔ̃ɔ bɑkɑ dim di.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gemɡii ù n mɑn so, kĩrɑ u mɑn sɔ̃ɔsi.","poem":1},{"lineBreak":true},{"text":"Ù n mɑn ɡerusi, u mɑn ɡum tɑ̃rewɑ nɛn wirɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ye yinɑmɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ nɑ ǹ nɛn kɑnɑru mɑrimɔ tɔn kɔ̃sobun sɔ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gusunɔ, ɑ ben siri kowobu sureo kpenu sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu nɛn ɡɑri swɑɑ dɑki,","poem":1},{"lineBreak":true},{"text":"domi yi sɑ̃ɑwɑ ɡɑri dori.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɡe mɛ bɑ̀ n kɔrɔ mɔ̀ tem mu rɑ nɔɔ bɑɑre,","poem":1},{"lineBreak":true},{"text":"nɡe mɛyɑ ɡɔribun wɑ̃ɑ yerɑ koo nɔɔ bɑɑrɑ","poem":1},{"lineBreak":true},{"text":"tu ben kukunu mwɛ ni nu yɑrinɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ nɑ mɛɛrɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn miyɑ nɑ kukuɑ.","poem":1},{"lineBreak":true},{"text":"A ku nɛn wɑ̃ɑru doke kɑri sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A mɑn ɡbɑro tɔn kɔ̃sobun yinɑ ye bɑ mɑn bɛrien di.","poem":1},{"lineBreak":true},{"text":"A mɑn ɡbɑro ben tɑɑ ye bɑ mɑn bɛrien di.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A de tɔn kɔ̃so be, bu wɔri ben yinɑ sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ nɛ, n kisirɑ min di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}