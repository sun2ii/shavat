{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u kuɑ sɑnɑm mɛ u kɑnɑru kuɑ kpee wɔru sɔɔ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Nɑ Yinni Gusunɔ nɔɔɡiru sue nɑ nùn suuru kɑnɑmɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ nùn nɛn nuku sɑnkirɑnu sɔ̃ɔmɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ nùn nɛn wɑhɑlɑ sɑɑriɑmmɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ̀ n mwiɑ kpɑnɑ, wunɑ rɑ n yɛ̃ ye kon ko.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑn yinɑ bɛriɑ swɑɑ yè sɔɔ nɑ sĩimɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A mɛɛrio nɔm ɡeuɔ ɑ wɑ mɑ ɡoo sɑri wi u kɑ mɑn yɔ̃.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ kuku yeru mɔ.","poem":1},{"lineBreak":true},{"text":"Goo sɑri wi u mɑɑ nɛn bwisikunu mɔ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ nɑ sokumɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ nɛɛ, wunɑ ɑ sɑ̃ɑ nɛn kuku yeru.","poem":1},{"lineBreak":true},{"text":"Wunɛ turowɑ ɑ sɑ̃ɑ nɛɡii duniɑ ye sɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A nɛn wuri swɑɑ dɑkio, domi nɑ nuki sɑnkire too.","poem":1},{"lineBreak":true},{"text":"A mɑn yɑkio be bɑ mɑn nɔni sɔ̃ɔmɔn nɔmɑn di,","poem":1},{"lineBreak":true},{"text":"domi bɑ mɑn dɑm kere.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mɑn yɑro dɛsirun di, kpɑ n nun tɑkɑru ko.","poem":1},{"lineBreak":true},{"text":"À n mɑn durom kuɑ, ɡeeɡibɑ koo nɑ bu mɑn sikerenɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}