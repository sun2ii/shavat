{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ. Ge wee.",{"text":"Yinni Gusunɔ, ɑ nɛn kɑnɑru nɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ ɑ nɛn bikiɑbu swɑɑ dɑki.","poem":1},{"lineBreak":true},{"text":"A mɑn wisio wunɛn bɔrɔkiniru kɑ wunɛn ɡem sɔɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A ku nɛ, wunɛn sɔm kowo siri,","poem":1},{"lineBreak":true},{"text":"domi ɡoo sɑri wi u koo ɡem wɑ wunɛn mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɛn yibɛrɛ u mɑn nɑɑ swĩi.","poem":1},{"lineBreak":true},{"text":"U nɛn wɑ̃ɑru tem tɑɑre.","poem":1},{"lineBreak":true},{"text":"U derɑ nɑ wɑ̃ɑ yɑm wɔ̃kurɔ nɡe be bɑ ɡu n tɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɛn hunde yɑ dɑm dwiiyɑ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ nuki sɑnkire too.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ ɡɑsɔn wɑ̃ɑru yɑɑye.","poem":1},{"lineBreak":true},{"text":"Nɑ wunɛn sɔmɑ kpuro lɑsɑbu mɔ̀,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ wunɛn nɔmɑn sɔmburu bwisikumɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wunɑ nɑ nɔmɑ tĩi.","poem":1},{"lineBreak":true},{"text":"Nɛn ɡɔ̃ru ɡɑ wunɛn bɛkɛ bɑrɔ","poem":1},{"lineBreak":true},{"text":"nɡe mɛ tem ɡbebɑ rɑ n nim kĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ mwiɑ kpɑnɑ.","poem":1},{"lineBreak":true},{"text":"A mɑn wisio kpɑɑkɑ.","poem":1},{"lineBreak":true},{"text":"A ku mɑn biru kisi kpɑ n ku ko nɡe be bɑ wɑ̃ɑ ɡɔriɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mɑn wunɛn tɔn ɡeeru sɔ̃ɔsio bururu kɑ yokɑ,","poem":1},{"lineBreak":true},{"text":"wunɑ nɑ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A mɑn swɑɑ sɔ̃ɔsio ye kon swĩi,","poem":1},{"lineBreak":true},{"text":"wunɑ nɑ nɛn hunde nɔmu sɔndiɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn wɔro sɑɑ nɛn yibɛrɛbɑn nɔmɑn di,","poem":1},{"lineBreak":true},{"text":"wunɛn miyɑ nɑ kuku yeru kɑsu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wunɑ sɑ̃ɑ nɛn Yinni.","poem":1},{"lineBreak":true},{"text":"A mɑn sɔ̃ɔsio mɛ ko nɑ n dɑ wunɛn kĩru ko.","poem":1},{"lineBreak":true},{"text":"A de wunɛn Hunde ɡeo wi, u mɑn kpɑrɑ swɑɑ ye yɑ nɔɔ nɛ sɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn wɔro nɡe mɛ ɑ nɔɔ mwɛɛru kuɑ.","poem":1},{"lineBreak":true},{"text":"A nɛn hunde wunɔ wɑhɑlɑn di wunɛn ɡem sɔ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A nɛn yibɛrɛbɑ kɑm koosio,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nɛn wɛrɔbu kpuro kpeerɑsiɑ yèn sɔ̃ ɑ mɑn kĩ.","poem":1},{"lineBreak":true},{"text":"Nɑ sɑ̃ɑwɑ wunɛn sɔm kowo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}