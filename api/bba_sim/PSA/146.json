{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"Nɛn bwɛ̃rɑ, ɑ Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kon wunɛ Yinni Gusunɔ siɑrɑ nɛn wɑ̃ɑrun tɔ̃nu kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kon wunɛ Gusunɔ nɛn Yinni womu kuɑ nɛn wɑ̃ɑrun tɔ̃nu kpuro sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ku bɛɛn nɑɑnɛ doke sinɑmbu sɔɔ,","poem":1},{"lineBreak":true},{"text":"bɑ sɑ̃ɑwɑ tɔmbu,","poem":1},{"lineBreak":true},{"text":"bɑ ǹ kpɛ̃ bu bɛɛ fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ben wɛ̃siɑru tɑ rɑ doonɛwɑ kpɑ bu wurɑ bu ko tem.","poem":1},{"lineBreak":true},{"text":"Yen tɔ̃ɔ te, ben himbɑ kpuro yɑ kɑm kuɑwɑ mi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wìn yĩiyɔbu wɑ̃ɑ wunɛ Gusunɔ Yɑkɔbun Yinni sɔɔ.","poem":1},{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wi u win nɑɑnɛ doke Gusunɔ win Yinni sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wiyɑ u wɔllu kɑ tem kuɑ kɑ nim wɔ̃ku","poem":1},{"lineBreak":true},{"text":"kɑ ye yɑ wɑ̃ɑ ye kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑwɑ ɡemɡii sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U rɑ be bɑ dɑm dɔremɔ ben ɡem wɛ̃.","poem":1},{"lineBreak":true},{"text":"Kpɑ u be bɑ ɡɔ̃ɔru soore dĩɑnu wɛ̃.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ u rɑ yobu yɑkie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"U rɑ wɔ̃kobu nɔni wukie.","poem":1},{"lineBreak":true},{"text":"U rɑ be bɑ tɑɑre seeye. U rɑ ɡemɡibu kɑ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U rɑ sɔbu kɔ̃su. U rɑ mɑɑ ɡɔminibu kɑ ɡobekubɑ nɔɔri.","poem":1},{"lineBreak":true},{"text":"Kpɑ u tɔn kɔ̃sobun himbɑ kɑm koosiɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, u ko n bɑndu diiwɑ sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ Siɔnin Yinni, u ko n wɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}