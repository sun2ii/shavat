{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔ siɑro sɑɑ wɔllun di.","poem":1},{"lineBreak":true},{"text":"I nùn siɑro sɑɑ wɔllun sɔɔ sɔɔn di.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɛɛ win ɡɔrɑdobɑ kpuro, i nùn siɑro.","poem":1},{"lineBreak":true},{"text":"Bɛɛ win tɑbu kowobu kpuro, i nùn siɑro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɔ̃ɔ kɑ suru, i nùn siɑro.","poem":1},{"lineBreak":true},{"text":"Bɛɛ kperi kpuro, bɛɛ be i bɑllimɔ, i nùn siɑro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɛɛ be i wɑ̃ɑ wɔllun sɔɔ sɔɔwɔ, i nùn siɑro.","poem":1},{"lineBreak":true},{"text":"Bɛɛ nim mɛ mu wɑ̃ɑ wɔllɔ, i nùn siɑro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U woodɑ wɛ̃, ye kpuro yɑ koorɑ.","poem":1},{"lineBreak":true},{"text":"Ye kpuro yu nùn siɑro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U ye tɑ̃sisiɑ sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"U koo woodɑ yi, win tii kun mɑɑ ye sɑrɑmɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sɑɑ tem sɔɔn di, i Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"Bɛɛ nim wɔ̃ku kɑ nim bwee bɑkɑnu kɑ yɛɛ nɑnumɡii yi yi wɑ̃ɑ sɔɔ, i Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dɔ̃ɔ kɑ ɡuru kpenu kɑ ɡuri bɑkɑ kɑ bukɔ kɑ woo bɔkɔ,","poem":1},{"lineBreak":true},{"text":"bɛɛ be i win woodɑbɑ mɛm nɔɔwɑmmɛ, i Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛɛ ɡuunu kɑ ɡunɡunu kɑ dɑ̃ɑ ye yɑ rɑ mɑ kɑ sɛdurubɑ,","poem":1},{"lineBreak":true},{"text":"i Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbeeku yɛɛ kɑ yɑɑ sɑbenu kpuro kɑ yɛɛ yi yi kɑbirimɔ kɑ ɡunɔsu,","poem":1},{"lineBreak":true},{"text":"i Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hɑnduniɑn sinɑmbu kɑ bwesenu kpuro kɑ sinɑ bibu kɑ hɑnduniɑn siri kowobu kpuro,","poem":1},{"lineBreak":true},{"text":"i Yinni Gusunɔ siɑro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aluwɑɑsibɑ kɑ wɔndiɑbɑ, tɔkɔnu kɑ bibu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"bɛɛ kpuro, i Yinni Gusunɔn yĩsiru bɛɛrɛ wɛ̃ɛyɔ.","poem":1},{"lineBreak":true},{"text":"Win yĩsirɑ kpɑ̃. Win ɡirimɑ yɑ wɔllu kɑ tem sɑre.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"U win tɔmbu Isirelibɑ be, be bɑ nun nɑɑnɛ sɑ̃ɑ","poem":1},{"lineBreak":true},{"text":"bɑ wɑ̃ɑ win bɔkuɔ dɑm wesiɑ mɑ n kuɑ bɛɛrɛ bɑkɑ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}