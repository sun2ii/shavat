{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ siɑro.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔ wom kpɔɔ kuo.","poem":1},{"lineBreak":true},{"text":"I nùn tɔmɔ tɔmbun suunu sɔɔ be bɑ nùn nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isireli, ɑ yɛ̃ɛrio wi u nun tɑkɑ kuɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Siɔniɡibu, i yɛ̃ɛrio bɛɛn sinɑ bokon sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nùn siɑro kɑ yɑɑbu.","poem":1},{"lineBreak":true},{"text":"I nùn siɑro kɑ bɑrɑnu kɑ mɔrɔkunu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u win tɔmbu kĩ.","poem":1},{"lineBreak":true},{"text":"U rɑ wɔnwɔndobu bɛɛrɛ wɛ̃ u bu fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be bɑ Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ, bu nɑsɑrɑ suo kɑ bɛɛrɛ bɑkɑ.","poem":1},{"lineBreak":true},{"text":"Bu nuku dobun kuuki koowo ben kpin yenu wɔllɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɑ n dɑ Gusunɔ siɑre kɑ bɑɑdommɑ","poem":1},{"lineBreak":true},{"text":"kpɑ tɑkobi ye bɑ dɛ̃ɛrɑ biru kɑ wuswɑɑ yɑ n wɑ̃ɑ ben nɔmɑɔ","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"bu kɑ bwese tukunu mɔru kɔsie,","poem":1},{"lineBreak":true},{"text":"kpɑ bu nu sɛɛyɑsiɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kpɑ bu nin sinɑmbu bɔke kɑ yɔni,","poem":1},{"lineBreak":true},{"text":"kpɑ bu mɑɑ nin wiruɡibu bɔke kɑ sisu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kpɑ bu nu siri nɡe mɛ bɑ yoruɑ.","poem":1},{"lineBreak":true},{"text":"Yɑ ko n sɑ̃ɑwɑ bɛɛrɛ bɑkɑ win tɔmbun mi be bɑ nùn nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔ siɑro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}