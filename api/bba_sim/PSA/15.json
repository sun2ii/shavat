lineBreak":true},{"text":"u ku rɑ kɛ̃ru mwɛ u kɑ seedɑ weesuɡiɑ di.","poem":1},{"lineBreak":true},{"text":"Wi u sĩimɔ nɡe mɛ, u ǹ sokurɑmɔ pɑi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}