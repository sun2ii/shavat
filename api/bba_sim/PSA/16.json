{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ, wunɑ nɑ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn miyɑ kon kuku yeru wɑ.","poem":1},{"lineBreak":true},{"text":"A mɑn kɔ̃suo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wunɑ nɑ sɔ̃ɔmɔ mɑ ɑ sɑ̃ɑ nɛn Yinni.","poem":1},{"lineBreak":true},{"text":"Wunɛ turowɑ ɑ rɑ mɑn ɡɑ̃ɑ ɡeenu wɛ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Be bɑ nun mɛm nɔɔwɑmmɛ tem mɛ sɔɔ, berɑ bɑ bɛɛrɛ mɔ.","poem":1},{"lineBreak":true},{"text":"Be sɔɔrɑ nɛn kĩru kpuro wɑ̃ɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ be bɑ bũnu sɑ̃ɑmɔ, bɑ tii nuku sɑnkirɑnu sosiɑmmɛwɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ kɑ bu bũu yɑ̃kunu mɔ̀.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ bũu nin yĩsiru sokumɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ ɑ rɑ mɑn wɛ̃ yèn bukɑtɑ nɑ mɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ mɑɑ yɛ̃ ye n koo mɑn deemɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wunɑ kɑɑ mɑn tubi ɡeɑ wɛ̃.","poem":1},{"lineBreak":true},{"text":"Kɑ ɡem nɑ nuku dobu mɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ nɑ siɑrɑmɔ yèn sɔ̃ ɑ rɑ mɑn bwisi kɛ̃.","poem":1},{"lineBreak":true},{"text":"Wunɑ nɑ siɑrɑmɔ yèn sɔ̃ ɑ rɑ mɑn kirɔ ko bɑɑ kɑ wɔ̃kurɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wunɑ nɑ rɑ n mɛɛrɑ bɑɑdommɑ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ n wɑ̃ɑ kɑ nɛ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ n mɑn kɔ̃su.","poem":1},{"lineBreak":true},{"text":"Gɑ̃ɑnu kun kpɛ̃ nu mɑn surɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɛn nukurɑ do.","poem":1},{"lineBreak":true},{"text":"Nɛn bwɛ̃rɑ yɛmiɑ.","poem":1},{"lineBreak":true},{"text":"Nɛn wɑsi koo wɛ̃rɑ bɔri yɛndu sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Domi ko nɑ n kɑ nun wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A ǹ nɛn hunde derimɔ ɡɔribun wɑ̃ɑ yerɔ.","poem":1},{"lineBreak":true},{"text":"A ǹ wurɑmɔ wunɛn kĩnɑsin wɑsi yi kɔ̃si.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adɑmɑ kɑɑ mɑn wɑ̃ɑrun swɑɑ sɔ̃ɔsi.","poem":1},{"lineBreak":true},{"text":"Wunɛn miyɑ kon yɛ̃ɛri.","poem":1},{"lineBreak":true},{"text":"Wunɛn miyɑ kon nuku dobu ko bi bu ǹ kpeemɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}