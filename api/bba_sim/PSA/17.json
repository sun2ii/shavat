{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["Dɑfidin kɑnɑru.",{"text":"Yinni Gusunɔ, ɑ nɛn weeweenu nɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"nɑ kĩwɑ ɑ mɑn ɡem wɛ̃.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ swɑɑ tem kpĩiyɔ ɑ nɔ,","poem":1},{"lineBreak":true},{"text":"wunɛn somirɑ nɑ kĩ.","poem":1},{"lineBreak":true},{"text":"A nɛn kɑnɑru nɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"nɛn ɡɔ̃run diyɑ tɑ wee.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A mɑn sirio,","poem":1},{"lineBreak":true},{"text":"ɑ yɛ̃ mɑ nɑ ɡem mɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɔ̃kuru, ɑ nɑ nɛn mi,","poem":1},{"lineBreak":true},{"text":"ɑ wɛ̃ɛrɑ ye nɑ bwisikumɔ,","poem":1},{"lineBreak":true},{"text":"ɑ wɛ̃ɛrɑ ye nɑ ɡerumɔ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ ɑ ǹ torɑru ɡɑru wɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A wɑ mɑ nɛn dɑɑ yɑ ǹ tiɑ kɑ ɡɑbuɡiɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ wunɛn ɡɑri mɛm nɔɔwɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ tɔn kɔ̃sobun yirɑ swĩi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ yɔ̃rɑwɑ dim dim wunɛn swɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ɡɛrɑre yen min di.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɛ̃, wunɑ nɑ soku, Yinni Gusunɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn wisio.","poem":1},{"lineBreak":true},{"text":"A nɛn ɡɑri nɔɔwɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A mɑn wunɛn durom bɑkɑm sɔ̃ɔsio,","poem":1},{"lineBreak":true},{"text":"domi ɑ rɑ be bɑ nun nɑɑnɛ sɑ̃ɑ wɔre ben yibɛrɛbɑn nɔmɑn di.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A nɛn lɑɑkɑri koowo","poem":1},{"lineBreak":true},{"text":"nɡe mɛ tɔnu u rɑ n win nɔnin lɑɑkɑri mɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn beruo","poem":1},{"lineBreak":true},{"text":"nɡe mɛ ɡuɑ yɑ rɑ yen binu bere yen kɑsɑ sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi tɔn kɔ̃sobɑ mɑn nɔni sɔ̃ɔmɔ,","poem":1},{"lineBreak":true},{"text":"yibɛrɛbɑ bɑ mɑn sikerenɛ, bɑ kĩ bu mɑn ɡo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɑ nuki sosu bɑ ǹ wɔnwɔndu mɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ ɡɑri mɔ̀ kɑ tii suɑbu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Be wee bɑ sɑ̃ɑ nɡe ɡbee sunɔ ɡe ɡɑ yɑɑ mɑrɑ ɡu kɑsuku.","poem":1},{"lineBreak":true},{"text":"Bɑ nɛn yirɑ swĩi.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑn nɑɑmwɛ bɑ kooro bure,","poem":1},{"lineBreak":true},{"text":"bɑ mɑn nɔni ɡirɑri bu kɑ mɑn ɡɑbɑ bu surɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ seewo ɑ bu wɔri,","poem":1},{"lineBreak":true},{"text":"ɑ ben dɑm buo.","poem":1},{"lineBreak":true},{"text":"A mɑn wɔro ben nɔmɑn di.","poem":1},{"lineBreak":true},{"text":"A bu ɡoowo kɑ wunɛn tɑkobi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A ben wɑ̃ɑrun dɛ̃ɛbu kɑwo.","poem":1},{"lineBreak":true},{"text":"A de bu ben dɑɑ kɔ̃sɑ kpuron ɑre wɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ yi n bu wɑ̃ɑsi sere kɑ ben bibun bibɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, nɑ̀ n seewɑ, kon wunɛn wuswɑɑ wɑ yèn sɔ̃ nɑ dɛɛre,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n nuku dobu yibɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}