{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ u ɡoo ɡɔsɑ u bɑndu wɛ̃.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ sinɑmbu bɑ nùn seesimɔ.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ tem yɛ̃robu bɑ nùn seesimɔ.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ tem wiruɡibu bɑ tɑbun sɔɔru mɔ̀.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ bwesenu nu ɑrukɑwɑni bɔkumɔ.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ tɔmbɑ nɔɔ tiɑ mɔ̀ bɑ mɔ̀,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"su ben dɑm buɑ, su tii yɑkiɑ ben yorun di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ n yɛ̃ mɑ kɑmɑ mi,","poem":1},{"lineBreak":true},{"text":"domi Gusunɔ u bu yɛ̃ɛmɔ.","poem":1},{"lineBreak":true},{"text":"Yinni u sɔ̃ wɔllɔ u bu yɑɑkoru mɔ̀.","poem":1},{"lineBreak":true},{"text":"U sunɔ wi u ɡɔsɑ swĩi kɔ win ɡuurɔ te bɑ mɔ̀ Siɔni.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, i n tii sɛ,","poem":1},{"lineBreak":true},{"text":"kpɑ u ku bɛɛ sɛɛyɑsiɑ kɑ mɔru,","poem":1},{"lineBreak":true},{"text":"kpɑ i nɑndɑ win mɔru bɑkɑn sɔ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sunɔ wi, u nɛɛ, kon kpɑrɑ ye Yinni Gusunɔ u mɑn sɔ̃ɔwɑ.","poem":1},{"lineBreak":true},{"text":"U nɛɛ, ɡisɔ nɑ kuɑ win bii.","poem":1},{"lineBreak":true},{"text":"Gisɔ u kuɑ nɛn tundo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"U mɑn sɔ̃ɔwɑ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"nɑ̀ n nùn bwesenu kpuro kɑnɑ,","poem":1},{"lineBreak":true},{"text":"u koo mɑn nu wɛ̃.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n nùn hɑnduniɑn ɡoonu nnɛ kɑnɑ,","poem":1},{"lineBreak":true},{"text":"u koo mɑn ye wɛ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U mɑɑ mɑn sɔ̃ɔwɑ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"kon kpĩ n bu kpɑrɑ nɡe wi u kpɑrɑmɔ kɑ sii bokuru,","poem":1},{"lineBreak":true},{"text":"kon kpĩ n bu kɔsuku nɡe weke te bɑ mɔmɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɛ̃, bɛɛ sinɑmbu, bɛɛ be i tem kpɑre,","poem":1},{"lineBreak":true},{"text":"i kirɔ yeni swɑɑ dɑkio.","poem":1},{"lineBreak":true},{"text":"Bɛɛ sinɑmbu, bɛɛ be i tem kpɑre, i yɛ̃ru kɑsuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔ sɑ̃ɑwɔ kɑ bɛɛrɛ.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔ wiru kpĩiyɔ kɑ nɑsiɑru,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kpɑ u ku rɑɑ mɔru ko subɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Domi win mɔru yɑ̀ n seewɑ, u koo de i kɑm ko.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ doo nɔɔruɡibɑ be bɑ nùn nɑɑnɛ sɑ̃ɑ kpuro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":9}