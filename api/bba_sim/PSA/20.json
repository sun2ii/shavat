{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Kɑnɑ te wom kowobun wiruɡii u kuɑ Dɑfidin sɔ̃."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, Yɑkɔbun Yinni, ɑ sinɑ boko swɑɑ dɑkio sɑnɑm mɛ u kɑnɑru mɔ̀.","poem":1},{"lineBreak":true},{"text":"A nùn kɔ̃suo sɑnɑm mɛ u wɑ̃ɑ nɔni swɑ̃ɑru sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛ wi ɑ wɑ̃ɑ wunɛn sɑ̃ɑ yee dɛɛrɑrɔ te tɑ wɑ̃ɑ Siɔniɔ,","poem":1},{"lineBreak":true},{"text":"ɑ sinɑ boko somimɑ, kpɑ ɑ n yɔ̃ win biruɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A win kɛ̃nu kpuro yɑɑyo,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ win yɑ̃kunu kpuro mwɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A nùn wɛ̃ɛyɔ ye win ɡɔ̃ru ɡɑ kĩ kpuro,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ de win himbɑ kpuro yu koorɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A de ye u nun bikiɑ kpuro yu koorɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛsɛ kpuro su yɛ̃ɛri sinɑ bokon nɑsɑrɑn sɔ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ su wunɛn yĩsiru wɔlle suɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tɛ̃, nɑ yɛ̃ mɑ wunɑ ɑ sinɑ boko ɡɔsɑ,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ mɑɑ nùn somi.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ win kɑnɑru nɔ sɑɑ wɔllun di,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nùn nɑsɑrɑ wɛ̃ kɑ wunɛn dɑm bɑkɑm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gɑbɑ ben tɑbu kɛkɛbɑ kɑ ben dumi nɑɑnɛ sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ bɛsɛ, wunɛ Yinni Gusunɔwɑ sɑ nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A de tɔn be, bu dɑm biɑ bu wɔruku,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ ɑ sun dɑm sosio bɛsɛ, su kɑ yɔ̃rɑ dim dim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ bɛsɛn nɔɔ nɔɔwɔ sɑnɑm mɛ sɑ nun soku.","poem":1},{"lineBreak":true},{"text":"A sinɑ boko somiɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}