{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Womu ɡe wom kowobun wiruɡii u kuɑ Dɑfidin sɔ̃."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, sinɑ boko u nuku dobu mɔ wunɛn dɑm sɔ̃.","poem":1},{"lineBreak":true},{"text":"U rɑ yɛ̃ɛri wunɛn somirun sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi ɑ nùn wɛ̃ ye win ɡɔ̃ru ɡɑ kĩ.","poem":1},{"lineBreak":true},{"text":"A ǹ nùn yinɑri ye u nun bikiɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wee, ɑ kɑ nùn domɑ ɡeeru nɑɑwɑ.","poem":1},{"lineBreak":true},{"text":"A nùn furɔ wurɑɡuu dokeɑ ɑ kuɑ sinɑ boko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U nun bikiɑ ɑ win wɑ̃ɑru dɑkɑɑ dɑɑsiɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ tu dɑkɑɑ dɑɑsiɑ n kɑ tɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wunɛn somirun sɑɑbuwɑ win bɛɛrɛ yɑ kɑ kpɛ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn fɑɑbɑn sɑɑbuwɑ u kɑ ɡirimɑ bɑkɑ wɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wunɛn domɑrɑ ko n wɑ̃ɑ kɑ wi sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"A rɑ n wɑ̃ɑ kɑ wi bɑɑdommɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u n nuku dobu mɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Wɔrukoo, sinɑ boko u nun nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn durom sɑɑbu ɑ ǹ derimɔ u sokurɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sinɑ boko, dɔmɑ te kɑɑ tii sɔ̃ɔsi,","poem":1},{"lineBreak":true},{"text":"kɑɑ wunɛn yibɛrɛbɑ nɔmɑ turi,","poem":1},{"lineBreak":true},{"text":"kɑɑ be bɑ nun tusɑ nɔmɑ turi,","poem":1},{"lineBreak":true},{"text":"kɑɑ bu doke dɔ̃ɔ bwee bɑkɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔn mɔru yɑ sɑ̃ɑwɑ nɡe dɔ̃ɔ boko.","poem":1},{"lineBreak":true},{"text":"Dɔ̃ɔ wi, u koo bu mwɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɑɑ de ben bibu bu ɡbi.","poem":1},{"lineBreak":true},{"text":"Kɑɑ de ben bweseru tu nɔru ko hɑnduniɑ yeni sɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɑ̀ n nɔɔ tiɑ kuɑ bu kɑ nun kɔ̃sɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"yɑ ǹ koorɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A wunɛn tɛndu bɛrio ɑ bu twee.","poem":1},{"lineBreak":true},{"text":"Bɑ koo nun biru kisi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ seewo.","poem":1},{"lineBreak":true},{"text":"Sɑ ko nun womu kuɑ wunɛn dɑm sɔ̃.","poem":1},{"lineBreak":true},{"text":"Sɑ ko nun tɔmɑ wunɛn yiikon sɔ̃.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ seewo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}