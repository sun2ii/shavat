{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ wunɑ ɑ sɑ̃ɑ nɛn kpɑro,","poem":1},{"lineBreak":true},{"text":"nɑ sɑ̃ɑwɑ nɡe wunɛn yɑ̃ɑru.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ɡɑ̃ɑnu bie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ rɑ kɑ mɑn de mi yɑkɑ bekusu wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ kɑ mɑn de mi nim mu mɑɑri.","poem":1},{"lineBreak":true},{"text":"Kpɑ ɑ mɑn wɛ̃rɑsiɑ mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A rɑ de nɛn dɑm mu wurɑmɑ,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ mɑn sure swɑɑ ɡeɑ sɔɔ,","poem":1},{"lineBreak":true},{"text":"wunɛn yĩsirun bɛɛrɛn sɔ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ̀ n sĩimɔ yɑm wɔ̃ku bɑkɑru sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ kɔ̃sɑ nɑsie,","poem":1},{"lineBreak":true},{"text":"yèn sɔ̃, ɑ kɑ mɑn wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn dɛkɑ yɑ rɑ mɑn kpɑre.","poem":1},{"lineBreak":true},{"text":"Wunɛn bokurɑ tɑ rɑ mɑn ɡbɑre.","poem":1},{"lineBreak":true},{"text":"Yeniwɑ yɑ rɑ mɑn dɑm kɛ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni, bɑɑ yibɛrɛbɑ bɑ̀ n mɑn sikerenɛ,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ mɑn dɑm koosie kɑ bɛɛrɛ,","poem":1},{"lineBreak":true},{"text":"ɑ turɑre ɡumɡiɑ wisi nɛn wirɔ,","poem":1},{"lineBreak":true},{"text":"ɑ dĩɑ bwese bwesekɑ yi nɛn wuswɑɑɔ,","poem":1},{"lineBreak":true},{"text":"ɑ nɛn nɔrɑ yibiɑ pɛrɛrɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ yɛ̃ mɑ tɔ̃ɔ bɑɑtere","poem":1},{"lineBreak":true},{"text":"kɑɑ mɑn tɔn ɡeeru sɔ̃ɔsi nɛn wɑ̃ɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Tɔ̃ɔ bɑɑtere kɑɑ mɑn ɡeɑ kuɑ nɛn wɑ̃ɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ nɑ n wɑ̃ɑ wunɛn mi sere kɑ nɛn ɡɔɔwɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}