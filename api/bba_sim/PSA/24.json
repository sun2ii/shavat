{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ, wunɑ ɑ tem mɔ kɑ ye yɑ wɑ̃ɑ mɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ hɑnduniɑ mɔ kɑ yen hunde konibɑ kpuro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ tem kpɛɛkpɛɛku swĩi nim wɔ̃ku sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ mu bɔnu kuɑ kɑ dɑɑnu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɑrɑ u koo kpĩ u yɔ wunɛn ɡuurɔ","poem":1},{"lineBreak":true},{"text":"mi wunɛn wɑ̃ɑ yee dɛɛrɑrɑ wɑ̃ɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wi u koo yɔ mi,","poem":1},{"lineBreak":true},{"text":"wiyɑ wìn ɡɔ̃ru ɡɑ dɛɛre.","poem":1},{"lineBreak":true},{"text":"Wiyɑ wìn nɔmɑ yɑ sɑ̃re.","poem":1},{"lineBreak":true},{"text":"Wiyɑ wi u ku rɑ weesu swĩi.","poem":1},{"lineBreak":true},{"text":"Wiyɑ wi u ku rɑ bɔ̃re u kɑ tɔnu nɔni wɔ̃ke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wiyɑ wi u wunɛ Gusunɔ, Yɑkɔbun Yinni soku.","poem":1},{"lineBreak":true},{"text":"Wi u sɑ̃ɑ nɡe mɛ,","poem":1},{"lineBreak":true},{"text":"wiyɑ kɑɑ domɑru kuɑ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ kɑɑ fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"Wiyɑ kɑɑ ɡem wɛ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛɛ wuun kɔ̃sobu, i kɔnnɔ ɡunum sosio.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔn sɑ̃ɑ yerun kɔnnɔ kɛniɔ.","poem":1},{"lineBreak":true},{"text":"I de sinɑ boko bɛɛrɛɡii u du.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wɑrɑ u sɑ̃ɑ sinɑ boko wi.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔwɑ.","poem":1},{"lineBreak":true},{"text":"U dɑm mɔ, u yiiko mɔ,","poem":1},{"lineBreak":true},{"text":"u sɑ̃ɑwɑ tɑbu durɔ dɑmɡii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛɛ wuun kɔ̃sobu, i kɔnnɔ ɡunum sosio.","poem":1},{"lineBreak":true},{"text":"I Yinni Gusunɔn sɑ̃ɑ yerun kɔnnɔ kɛniɔ.","poem":1},{"lineBreak":true},{"text":"I de sinɑ boko bɛɛrɛɡii u du.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wɑrɑ u sɑ̃ɑ sinɑ boko wi.","poem":1},{"lineBreak":true},{"text":"Gusunɔ, wɔllu kɑ tem Yinniwɑ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ sinɑ boko bɛɛrɛɡii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":9}