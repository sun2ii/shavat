{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ, wunɑ nɑ soku.","poem":1},{"lineBreak":true},{"text":"Wee nɑ yiire nɑ nun kɑnɑmɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɑ nun nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A ku de n sekuru wɑ.","poem":1},{"lineBreak":true},{"text":"A ku de nɛn yibɛrɛbɑ bu mɑn yɛ̃ɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Be bɑ nun nɑɑnɛ sɑ̃ɑ bɑ ǹ sekuru wɑsi,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ be bɑ ǹ kɑ nun yɔ̃, bɑ koo sekuru wɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ nun kɑnɑmɔ,","poem":1},{"lineBreak":true},{"text":"ɑ mɑn wunɛn swɑɑ sɔ̃ɔsio.","poem":1},{"lineBreak":true},{"text":"A mɑn sɔ̃ɔsio nɡe mɛ kon sĩ ye sɔɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɛn Fɑɑbɑ kowo, ɑ mɑn kpɑro ɡem swɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn keu koowo.","poem":1},{"lineBreak":true},{"text":"Domi wunɑ nɑ nɑɑnɛ sɑ̃ɑ bɑɑdommɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ nun kɑnɑmɔ,","poem":1},{"lineBreak":true},{"text":"ɑ wunɛn durom kɑ wunɛn wɔnwɔndu yɑɑyo,","poem":1},{"lineBreak":true},{"text":"ye ɑ mɑn sɔ̃ɔsi yellun di.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A ku mɑɑ yɑɑyɑ durum ye nɑ kuɑ nɛn ɑluwɑɑsiru sɔɔ.","poem":1},{"lineBreak":true},{"text":"A ku nɛn mɛm nɔɔbu sɑriru mɛɛri.","poem":1},{"lineBreak":true},{"text":"A mɑn yɑɑyo wunɛn wɔnwɔndu kɑ wunɛn tɔn ɡeerun sɔ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ tɔn ɡeo.","poem":1},{"lineBreak":true},{"text":"A mɑɑ sɑ̃ɑwɑ ɡemɡii.","poem":1},{"lineBreak":true},{"text":"A rɑ durumɡii swɑɑ ɡeɑ sɔ̃ɔsi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A rɑ be bɑ tii kɑwe swɑɑ ɡeɑ sɔ̃ɔsi,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ bu kpɑrɑ ye sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Domi be bɑ wunɛn ɑrukɑwɑni nɛni,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ wunɛn woodɑbɑ swĩi,","poem":1},{"lineBreak":true},{"text":"ɑ bu kĩ, ɑ mɑɑ sɑ̃ɑ nɑɑnɛɡii ben mi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni, wunɛn yĩsirun sɔ̃,","poem":1},{"lineBreak":true},{"text":"ɑ nɛn durum wɔko domi yɑ kpɑ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɑ yɛ̃ mɑ wi u nun nɑsie,","poem":1},{"lineBreak":true},{"text":"wiyɑ ɑ rɑ swɑɑ sɔ̃ɔsi ye u koo kpe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wiyɑ u ko n wɑ̃ɑ bɔri yɛndu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Win bweserɑ tɑ koo tem mɛ tubi di.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wi u nun nɑsie,","poem":1},{"lineBreak":true},{"text":"wiyɑ ɑ rɑ wunɛn ɑsiri sɔ̃.","poem":1},{"lineBreak":true},{"text":"Wiyɑ ɑ rɑ wunɛn ɑrukɑwɑnin woodɑbɑ ɡiɑsie.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nɑ yɛ̃ mɑ wunɑ ɑ rɑ nɛn nɑɑsu yɑre sɑɑ yinɑn di.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ ko nɑ n nun mɛɛrɑ bɑɑdommɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn wɔnwɔndu wɑɑwo.","poem":1},{"lineBreak":true},{"text":"Wee, bɑ mɑn deri, nɑ wɑ̃ɑ nuku sɑnkirɑnu sɔɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A mɑn tu wunɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn yɑro nɔni swɑ̃ɑrun di.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A nɛn wɑhɑlɑ mɛɛrio.","poem":1},{"lineBreak":true},{"text":"Wee, nɑ wɔnwɔndu soore.","poem":1},{"lineBreak":true},{"text":"A nɛn durum wɔko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A mɛɛrio nɡe mɛ nɛn yibɛrɛbɑ bɑ dɑbi,","poem":1},{"lineBreak":true},{"text":"bɑ mɑn tusɑ bɑ kɔ̃ruɑ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mɑn wɔro, ɑ mɑn kɔ̃suo.","poem":1},{"lineBreak":true},{"text":"A ku de n sekuru wɑ domi nɑ kukuɑ wunɛn mi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A mɑn somiɔ nɑ n kɑ dɛɛre.","poem":1},{"lineBreak":true},{"text":"A mɑn somiɔ nɑ n kɑ wɑ̃ɑ ɡem sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ nɑ nɑɑnɛ sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"kɑɑ mɑn kɔ̃su.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gusunɔ, ɑ wunɛn tɔmbu Isirelibɑ yɑro ben nɔni swɑ̃ɑru kpuron di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}