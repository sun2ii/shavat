{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ, wunɑ nɑ nɑɑnɛ sɑ̃ɑ mɑm mɑm.","poem":1},{"lineBreak":true},{"text":"Nɑ sĩimɔwɑ dee dee wunɛn woodɑbɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn ɡem wɛ̃ɛyɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A nɛn bwisikunu kɑ nɛn bwɛ̃rɑ sirio.","poem":1},{"lineBreak":true},{"text":"A mɑn wɛ̃ɛrio kpɑ ɑ mɑn ɡiɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi wunɛn kĩrɑ nɑ nɔni ɡirɑri.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ sĩimɔ wunɛn durom sɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɑ ku rɑ kɑ tɔn kɔ̃sobu sinɛ.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ nɑ ku rɑ mɑɑ kɑ murɑfitibɑ sĩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ kɔ̃sɑn kowobu tusɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ ku rɑ kɑ bu sinɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ rɑ nɛn nɔmɑ niɛwɑ n kɑ sɔ̃ɔsi mɑ nɑ ǹ tɑɑrɛ mɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ rɑ de n nun sɑ̃ nɑ n wunɛn yɑ̃ku yeru sikerenɑmɔ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nɑ n nun siɑrɑmɔ,","poem":1},{"lineBreak":true},{"text":"nɑ n wunɛn sɔm mɑɑmɑɑkiɡinun ɡɑri kpɑrɑmɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɑ rɑ kɑ̃ n dɑ wunɛn sɑ̃ɑ yerɔ","poem":1},{"lineBreak":true},{"text":"domi miyɑ ɑ rɑ n wɑ̃ɑ wunɛn yiikon ɡirimɑ sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ ku de n ɡbi kɑ durumɡibu sɑnnu.","poem":1},{"lineBreak":true},{"text":"A ku de n kɑm ko kɑ be bɑ tɔmbun yɛm yɑrimɔ sɑnnu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A ku mɑn siri kɑ be bɑ dɑɑ kɔ̃sɑ mɔ̀ sɑnnu.","poem":1},{"lineBreak":true},{"text":"A ku mɑn siri kɑ be bɑ rɑ nɔm birɑn kɛ̃nu mwɛ sɑnnu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɑ sĩimɔwɑ dee dee wunɛn woodɑbɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn durom kuo, ɑ mɑn fɑɑbɑ koowo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɑ yɔ̃wɑ dim dim swɑɑ ɡeɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ kon nun siɑrɑ mi wunɛn tɔmbɑ mɛnnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}