{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔwɑ u rɑ nɛn swɑɑ yɑm bururɑsie,","poem":1},{"lineBreak":true},{"text":"u mɑn fɑɑbɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ɡoon bɛrum mɔ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ u sɑ̃ɑwɑ nɛn kuku yeru.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ ɡɑ̃ɑnun bɛrum mɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛn yibɛrɛbɑ bɑ̀ n mɑn wɔrimɑ bu kɑ mɑn ɡo,","poem":1},{"lineBreak":true},{"text":"bɑ ǹ mɑn wɑsi.","poem":1},{"lineBreak":true},{"text":"Kɔ̃sɑn kowobu bɑ̀ n mɑn susimɑ bu kɑ mɑn nɔni sɔ̃,","poem":1},{"lineBreak":true},{"text":"ɡɑ̃ɑnu kun mɑn mɔ̀.","poem":1},{"lineBreak":true},{"text":"Be kpurowɑ bɑ koo wɔruku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɛn yibɛrɛbɑ bɑ̀ n mɑn sikerenɑ bɑ mɑn tɑbu wɔrimɑ,","poem":1},{"lineBreak":true},{"text":"nɛn tororɑ kun kɑrɑmɔ.","poem":1},{"lineBreak":true},{"text":"Gusunɔwɑ ko nɑ n nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gɑ̃ɑ teenɑ nɑ Gusunɔ kɑnɑmɔ ni nu mɑn nɛni ɡem ɡem.","poem":1},{"lineBreak":true},{"text":"Niyɑ, nɑ n wɑ̃ɑ kɑ wi, win wɑ̃ɑ yerɔ","poem":1},{"lineBreak":true},{"text":"nɛn wɑ̃ɑrun tɔ̃ru kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ n win durom dendɑ","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n nùn sɑ̃ɑmɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi u koo mɑn bere win wɑ̃ɑ yerɔ nɔni swɑ̃ɑrun sɑnɑm,","poem":1},{"lineBreak":true},{"text":"kpɑ u kɑ mɑn dɑ kperu wɔllɔ mi ɡoo kun mɑn nɑɑ turi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ kon kpĩ n nɛn yibɛrɛbɑ yɛ̃ɛ be bɑ kɑ mɑn sikerenɛ.","poem":1},{"lineBreak":true},{"text":"Kon dɑ Yinni Gusunɔn wɑ̃ɑ yee dɛɛrɑru mi,","poem":1},{"lineBreak":true},{"text":"kpɑ n nùn yɑ̃kunu kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ n nùn siɑrɑ kɑ womusu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, nɑ nun soku.","poem":1},{"lineBreak":true},{"text":"A nɛn nɔɔ nɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"A nɛn wɔnwɔndu wɑɑwo.","poem":1},{"lineBreak":true},{"text":"A mɑn wurɑrio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ nɛɛ, bu nun sɑ̃ɑwɔ.","poem":1},{"lineBreak":true},{"text":"Wee, nɑ nun sɑ̃ɑmɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ sɑ̃ɑwɑ wunɛn sɔmɔ.","poem":1},{"lineBreak":true},{"text":"A ku mɑn biru kisi.","poem":1},{"lineBreak":true},{"text":"A ku mɑn ɡirɑ kɑ mɔru.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ mɑn somi.","poem":1},{"lineBreak":true},{"text":"A ku mɑn deri.","poem":1},{"lineBreak":true},{"text":"Gusunɔ nɛn Fɑɑbɑ kowo,","poem":1},{"lineBreak":true},{"text":"ɑ ku mɑn yinɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɑ yɛ̃ mɑ bɑɑ nɛn tundo kɑ nɛn mɛro bɑ̀ n mɑn yinɑ,","poem":1},{"lineBreak":true},{"text":"wunɛ Yinni Gusunɔ, kɑɑ mɑn mwɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn wunɛn swɑɑ sɔ̃ɔsio","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ de n sĩ dee dee ye sɔɔ,","poem":1},{"lineBreak":true},{"text":"domi nɛn yibɛrɛbɑ bɑ dɑbi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A ku mɑn bɛri yibɛrɛbɑn nɔmɑɔ.","poem":1},{"lineBreak":true},{"text":"A ku de bu mɑn kuɑ ye nɑ ǹ kĩ.","poem":1},{"lineBreak":true},{"text":"Domi seedɑ dio weesuɡibu bɑ mɑn seesimɔ,","poem":1},{"lineBreak":true},{"text":"be, be bɑ dɑm dɔrebun wɑsikirɑnu mɔ̀.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɑ yĩiyɔbu mɔ mɑ kon Yinnin durom dendɑ,","poem":1},{"lineBreak":true},{"text":"wɑsobun suunu sɔɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yen sɔ̃, ɑ n Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A ku mwiɑ kpɑnɑ.","poem":1},{"lineBreak":true},{"text":"A de wunɛn tororu tɑ n sɔ̃ sim sim.","poem":1},{"lineBreak":true},{"text":"A n Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}