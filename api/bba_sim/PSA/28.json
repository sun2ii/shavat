{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Yinni Gusunɔ, wunɑ nɑ wuri koosimɔ.","poem":1},{"lineBreak":true},{"text":"Wunɛ wi ɑ sɑ̃ɑ nɡe nɛn kpee bɑɑ mi nɑ rɑ kuke,","poem":1},{"lineBreak":true},{"text":"ɑ ku mɑn duɑri.","poem":1},{"lineBreak":true},{"text":"Domi ɑ̀ n mɑɑri mɛsum,","poem":1},{"lineBreak":true},{"text":"ko nɑ n sɑ̃ɑwɑ nɡe wi u ɡɔɔ dɔɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɑ̀ n nɔmɑ yiiyɑ nɑ kɑnɑru mɔ̀ sɑ̃ɑ yee dɛɛrɑ ten mi,","poem":1},{"lineBreak":true},{"text":"ɑ nɛn kɑnɑru swɑɑ dɑkio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ku mɑn ɡɑrisi tiɑ kɑ tɔn kɔ̃sobu,","poem":1},{"lineBreak":true},{"text":"kɑ be bɑ mɑɑ kɑ ben winsim ɡɑri mɔ̀ nɡe kĩru,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ ben ɡɔ̃ruɔ kɔ̃sɑ yɑ yibɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A bu ben kookoosun ɑre wɛ̃ɛyɔ nɡe mɛ yi nɛ.","poem":1},{"lineBreak":true},{"text":"Ye bɑ ɡɑbu kuɑ, ɑ de yu wɔri ben wirɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi bɑ ǹ ɡɑrɑ ye wunɛ Gusunɔ ɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, ɑ bu kɔsukuo kpɑ bu ku rɑɑ mɑɑ se.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ kon siɑrɑ,","poem":1},{"lineBreak":true},{"text":"domi ɑ rɑ nɛn kɑnɑru nɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ mɑn ɡɑnuɑ nɡe tɛrɛru,","poem":1},{"lineBreak":true},{"text":"ɑ sɑ̃ɑwɑ nɛn dɑm.","poem":1},{"lineBreak":true},{"text":"Wunɛ sɔɔrɑ nɛn nɑɑnɛ wɑ̃ɑ, domi ɑ mɑn fɑɑbɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ nuku dobu mɔ,","poem":1},{"lineBreak":true},{"text":"nɑ nun siɑrɑmɔ kɑ womusu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ wunɛn tɔmbun dɑm.","poem":1},{"lineBreak":true},{"text":"Domi ɑ sɑ̃ɑwɑ nɡe kɑ̀rì, ɑ kɑ wi ɑ ɡɔsɑ fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A wunɛn tɔmbu fɑɑbɑ koowo kpɑ ɑ bu domɑru kuɑ,","poem":1},{"lineBreak":true},{"text":"be, be bɑ sɑ̃ɑ wunɛn ɑrumɑni.","poem":1},{"lineBreak":true},{"text":"A bu kpɑro kpɑ ɑ bu nɔɔri sere kɑ bɑɑdommɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}