{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Bɛɛ be i wɑ̃ɑ wɔllɔ, i Yinni Gusunɔ siɑro","poem":1},{"lineBreak":true},{"text":"win yiiko kɑ win dɑm sɔ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I win yĩsiru wɔlle suo,","poem":1},{"lineBreak":true},{"text":"kpɑ i yiirɑ win wuswɑɑɔ win dɛɛrɑrun sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ yiiko kpuroɡii","poem":1},{"lineBreak":true},{"text":"u derɑ ɡurɑ yɑ ɡbɑ̃rɑmɔ.","poem":1},{"lineBreak":true},{"text":"Win nɔɔ ɡɑ nɔɔrɑ ɡuru winu sɔɔ.","poem":1},{"lineBreak":true},{"text":"U dɑm mɔ nim bɑkɑm wɔllɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Win nɔɔ ɡɑ nɔɔrɑ kɑ dɑm kɑ yiiko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Win nɔɔ ɡe, ɡɑ Libɑnin dɑ̃ɑ dɑmɡinu bɛsukumɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U derɑ Libɑnin ɡuunu nu yɔ̃ɔkumɔ","poem":1},{"lineBreak":true},{"text":"nɡe kɛtɛ kpɛmminu.","poem":1},{"lineBreak":true},{"text":"Mɑ ɡuu te bɑ mɔ̀ Hɛɛmɔɔ tɑ suɑrɑ dikɑ","poem":1},{"lineBreak":true},{"text":"nɡe kɛtɛ ɡbeeku kpɛmbu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Win nɔɔ ɡɑ derɑ ɡuru mɑɑkinu koorɑmɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Win nɔɔ ɡɑ nɔɔrɑ,","poem":1},{"lineBreak":true},{"text":"mɑ ye yɑ wɑ̃ɑ Kɑdɛsin ɡbɑburɔ kpuro yɑ diirɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U ɡbɑ̃rɑ sere nɛm ɡurɑɡinu nu nɑndɑ nu mɑrɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ dɑ̃nu kpuron wurusu dɛllɑ sɔ̃ɔwɔ.","poem":1},{"lineBreak":true},{"text":"Yerɑ win sinɑ kpɑɑrun di bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"yiikoɡiiwɑ Yinni Gusunɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wiyɑ u dɑm mɔ nim wɔllɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ko n sɑ̃ɑ sunɔ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wiyɑ u koo mɑɑ tɔmbu dɑm kɛ̃.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u koo bu domɑru kuɑ u bu bɔri yɛndu wɛ̃.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}