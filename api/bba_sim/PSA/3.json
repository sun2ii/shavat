{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡeni ɡɑ kɑ kpikiru yɑ̃ te u suɑ win bii Abusɑlɔmun sɔ̃. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, nɛn yibɛrɛbɑ bɑ dɑbi.","poem":1},{"lineBreak":true},{"text":"Be bɑ mɑn seesi bɑ dɑbi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Geemɑ dɑbirɑ tɑ ɡerumɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ somiru wɑsi wunɛn min di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, nɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ rɑ mɑn ɡɑnɛ nɡe tɛrɛru,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ rɑ mɑn nɑsɑrɑ wɛ̃,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ rɑ mɑn sekuru yɑre.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ̀ n nun nɔɔɡiru sue nɑ somiru kɑnɑ,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ nɛn nɔɔ nɔ wunɛn ɡuurun di mi ɑ wɑ̃ɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ̀ n kpunɑ nɑ dweeyɑ wɔ̃ku ɡiriru,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ rɑ n mɑn kɔ̃su.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n yɑndɑ nɑ rɑ deemɛwɑ","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ mɑn kɔ̃su.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yibɛrɛ dɑbinu nu mɑn kooro bure,","poem":1},{"lineBreak":true},{"text":"yibɛrɛ dɑbinu nu mɑn sikerenɑ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ nɑ ǹ ben bɛrum mɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ nɛn Yinni, ɑ seewo ɑ mɑn fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"A seewo ɑ nɛn yibɛrɛbɑ wiru kɔsuku.","poem":1},{"lineBreak":true},{"text":"A seewo ɑ ben nɔsu kɔsuku.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ rɑ tɔnu fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"A de wunɛn domɑru tɑ n kɑ wunɛn tɔmbu wɑ̃ɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}