{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ bu kɑ Yinni Gusunɔn sɑ̃ɑ yeru wukiɑ. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, kon wunɛn kpɑ̃ɑru kpɑrɑ.","poem":1},{"lineBreak":true},{"text":"Domi ɑ mɑn yɑrɑ sɑɑ wɔrun di.","poem":1},{"lineBreak":true},{"text":"A ǹ mɑɑ dere nɛn yibɛrɛbɑ bu mɑn yɛ̃ɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gusunɔ nɛn Yinni, nɑ nun nɔɔɡiru sue","poem":1},{"lineBreak":true},{"text":"nɑ fɑɑbɑ kɑnɑ, mɑ ɑ mɑn bɛkiɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mɑn wɔrɑ ɡɔɔn nɔmɑn di,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ derɑ sɑ tondinɛ kɑ be bɑ ɡu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔ siɑro kɑ womusu,","poem":1},{"lineBreak":true},{"text":"bɛɛ be i kɑ nùn yɔ̃ dim dim.","poem":1},{"lineBreak":true},{"text":"I win yĩsi dɛɛrɑ te wɔlle suo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi win mɔru ku rɑ tɛ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ u rɑ tɔnu durom kuewɑ win wɑ̃ɑru kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Nuku sɑnkirɑnu nù n nùn deemɑ yokɑ,","poem":1},{"lineBreak":true},{"text":"sisiru bururu, u rɑ deemɛ nuku doo bɑkɑbɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ rɑɑ nɛɛ, nɛn nuku doo bini sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ sokurɑmɔ pɑi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛn sɑɑbuwɑ nɑ kɑ wɑ̃ɑ bɔri yɛndu sɔɔ","poem":1},{"lineBreak":true},{"text":"nɡe wi u kukuɑ kpee bɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ye ɑ wunɛn wuswɑɑ beruɑ,","poem":1},{"lineBreak":true},{"text":"nɛn lɑɑkɑri yɑ burisinɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yen biruwɑ nɑ nɔɔɡiru suɑ","poem":1},{"lineBreak":true},{"text":"nɑ nun somiru kɑnɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɑ nɛɛ, mbɑ kɑɑ wɑ ɑ̀ n mɑn ɡo,","poem":1},{"lineBreak":true},{"text":"ɑ mɑn doke siki wɔruɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n ɡɔsirɑ tuɑ, kon kpĩ n nun sɑ̃?","poem":1},{"lineBreak":true},{"text":"Kon kpĩ n wunɛn ɡem ɡɑri kpɑrɑ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn swɑɑ dɑkio,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ mɑn durom kuɑ. Yinni, ɑ mɑn somiɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wee tɛ̃, nɛn nuku sɑnkirɑru tɑ kuɑ nuku dobu.","poem":1},{"lineBreak":true},{"text":"A nɛn sɑɑki ye nɑ wukiri nuku sɑnkirɑrun sɔ̃ wunɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ mɑn tɔ̃ɔ bɑkɑ yɑ̃nu sebusiɑ n kɑ nuku dobu ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛn bwɛ̃rɑ yɑ koo nun bɛɛrɛ wɛ̃ kɑ womusu,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ nɔɔ mɑrimɔ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ nɛn Yinni,","poem":1},{"lineBreak":true},{"text":"wunɑ kon siɑrɑ sere kɑ bɑɑdommɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}