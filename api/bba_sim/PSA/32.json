{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu.",{"text":"Doo nɔɔruɡiiwɑ wìn torɑnu bɑ suuru kuɑ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ win durum wunɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Doo nɔɔruɡiiwɑ wìn kɔ̃sɑ Yinni Gusunɔ kun ɡɑrisi,","poem":1},{"lineBreak":true},{"text":"mɑ u ǹ mɑɑ keetɑ mɔ win ɡɔ̃ruɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑnɑm mɛ nɑ ǹ nɛn durum wure, nɛn kukunu ɡbisɑ,","poem":1},{"lineBreak":true},{"text":"nɑ weeweenu kuɑ tɔ̃ɔ ɡiriru,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"domi wunɛn nɔmu ɡɑ mɑn sɛ̃re bururu kɑ yokɑ.","poem":1},{"lineBreak":true},{"text":"Nɛn dɑm mu dɛllɑ nɡe mɛ dɑ̃ɑ wurusu su rɑ ko sɔ̃ɔ sɑ̃rerun sɑɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ nɛɛ, kon nɛn torɑnu wurɑ","poem":1},{"lineBreak":true},{"text":"wunɛ Yinni Gusunɔn mi.","poem":1},{"lineBreak":true},{"text":"Nɑ nɛn durum tuubɑ kuɑ wunɛn mi,","poem":1},{"lineBreak":true},{"text":"nɑ ǹ nɛn kɔ̃sɑ beruɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ mɑn nɛn durum tɑɑrɛ wunɑri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yen sɔ̃, n weenɛ bɑɑwure wi u nun nɑɑnɛ sɑ̃ɑ","poem":1},{"lineBreak":true},{"text":"u nun kɑnɑ wɑhɑlɑn sɑɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Bɑɑ nim bɑkɑm mù n yibɑ mu sɑrɑ,","poem":1},{"lineBreak":true},{"text":"mu ǹ yɛ̃ro turi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wunɑ sɑ̃ɑ nɛn kuku yeru,","poem":1},{"lineBreak":true},{"text":"ɑ rɑ mɑn ɡbɑre wɑhɑlɑn di.","poem":1},{"lineBreak":true},{"text":"A derɑ nɑ womusu mɔ̀ wunɛn fɑɑbɑn sɔ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛɛ, kɑɑ mɑn keu ko,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ mɑn swɑɑ sɔ̃ɔsi ye n weenɛ n swĩi.","poem":1},{"lineBreak":true},{"text":"Kɑɑ mɑn bwisi kɛ̃, kpɑ ɑ n mɑn kɔ̃su.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A mɑɑ nɛɛ, n ku ko bwisi sɑriruɡii nɡe dumɑ,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ nɡe birɑkɔ,","poem":1},{"lineBreak":true},{"text":"yìn nɔɔwɔ bɑ ǹ koo ko bɑ kun yɑrukɑ","poem":1},{"lineBreak":true},{"text":"kɑ kɑrɑbɑsuuru doke,","poem":1},{"lineBreak":true},{"text":"bɑ n kɑ yi ɡɑwe, kpɑ yi ku rɑɑ tɔnu wɔri.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɔn kɔ̃sobun wɑhɑlɑ kpɑ̃,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ wi u Yinni Gusunɔ nɑɑnɛ sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"win durom mu rɑ n yɛ̃ro wɑ̃ɑsiwɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yen sɔ̃, bɛɛ ɡemɡibu, i ɡɔ̃ru doro Yinni Gusunɔ sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ i dɛsinu kɑrɑ.","poem":1},{"lineBreak":true},{"text":"Bɛɛ bèn ɡɔ̃ru ɡɑ dɛɛre,","poem":1},{"lineBreak":true},{"text":"i ɡuudɑ koowo kɑ nuku dobu, bɛɛ kpuro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}