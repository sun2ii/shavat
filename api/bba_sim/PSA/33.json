{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Bɛɛ be i sɑ̃ɑ ɡemɡibu, i Gusunɔ siɑro kɑ womusu.","poem":1},{"lineBreak":true},{"text":"Bɛɛ be i dɛɛre, i nùn siɑro bɑɑdommɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I nùn siɑro kɑ mɔrɔkunu","poem":1},{"lineBreak":true},{"text":"kpɑ i womusu ko kɑ ɡɔ̃ɔɡenu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nùn bɛɛrɛ wɛ̃ɛyɔ kɑ wom kpɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ i ɡɑ̃ɑsu torɑ i kɑ nùn siɑrɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u rɑ ɡem ɡerewɑ.","poem":1},{"lineBreak":true},{"text":"Ye u mɑɑ ɡeruɑ kpuro yɑ rɑ koorewɑ mɑm mɑm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U rɑ ye yɑ woodɑ kɑ ɡem swĩi kɑ̃.","poem":1},{"lineBreak":true},{"text":"Win durom mu yibɑ tem kpuro sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Win nɔɔn ɡɑriyɑ wɔllɑ kɑ tɑkɑ koorɑ,","poem":1},{"lineBreak":true},{"text":"kɑ ɡɑ̃ɑ ni nu wɑ̃ɑ te sɔɔ kpuro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɑ u derɑ nim wɔ̃kun nim mu mɛnnɑ yɑ̃ɑtem.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛɛ hɑnduniɑɡibu, i Yinni Gusunɔ nɑsio.","poem":1},{"lineBreak":true},{"text":"I diirio win wuswɑɑɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi ye u ɡeruɑ kpuro, yerɑ yɑ rɑ koore.","poem":1},{"lineBreak":true},{"text":"Ù n woodɑ wɛ̃ kpɑ yu koorɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u rɑ bwesenun himbɑ ɡɔsie,","poem":1},{"lineBreak":true},{"text":"kpɑ yu kɑm ko mɑm mɑm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adɑmɑ win himbɑ yɑ ku rɑ ɡɔsiɑre,","poem":1},{"lineBreak":true},{"text":"yɑ ko n wɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bwese te tɑ Gusunɔ mɔ Yinni,","poem":1},{"lineBreak":true},{"text":"tɑ ko n nuku dobu mɔwɑ.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ bwese te u mɑɑ ɡɔsɑ win tiin sɔ̃","poem":1},{"lineBreak":true},{"text":"tɑ koo yɛ̃ɛriwɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sɑɑ wɔllun diyɑ Yinni Gusunɔ u tɔmbu kpuro mɛɛrɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sɑɑ win wɑ̃ɑ yerun di, u hɑnduniɑɡibu kpuro mɛɛrɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wi, wi u tɔmbu kpuro bwisikunu wɛ̃,","poem":1},{"lineBreak":true},{"text":"u mɑɑ ben kookoosu kpuron lɑɑkɑri mɔ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sinɑ boko ù n nɑsɑrɑ wɑ tɑbu sɔɔ,","poem":1},{"lineBreak":true},{"text":"n ǹ mɔ yèn sɔ̃ u tɑbu kowo dɑbiru mɔ.","poem":1},{"lineBreak":true},{"text":"N ǹ mɑɑ tɑbu durɔn dɑm","poem":1},{"lineBreak":true},{"text":"mu rɑ nùn yɑre win yibɛrɛn nɔmɑn di.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wi u win nɑɑnɛ doke dumɑ sɔɔ,","poem":1},{"lineBreak":true},{"text":"u ǹ nɑsɑrɑ wɑsi.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ kɑ yen dɑm kpuro","poem":1},{"lineBreak":true},{"text":"yɑ ǹ kpɛ̃ yu nùn wɔrɑ kɑrin di.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Adɑmɑ be bɑ Yinni Gusunɔ nɑsie,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ben yĩiyɔbu doke win durom sɔɔ,","poem":1},{"lineBreak":true},{"text":"beyɑ u kɔ̃su,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"u kɑ ben hunde wɔrɑ ɡɔɔn di,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n wɑsi bɑɑ ɡɔ̃ɔru tɑ̀ n duɑ ben tem sɔɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bɛsɛ, Yinni Gusunɔn miyɑ bɛsɛn yĩiyɔbu wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u koo sun somi kpɑ u sun kɔ̃su nɡe tɛrɛru.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bɛsɛn ɡɔ̃ru ɡɑ do win sɔ̃.","poem":1},{"lineBreak":true},{"text":"Sɑ mɑɑ nùn nɑɑnɛ sɑ̃ɑ win dɛɛrɑrun sɔ̃.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ de wunɛn durom mu n wɑ̃ɑ kɑ bɛsɛ.","poem":1},{"lineBreak":true},{"text":"Domi wunɛ sɔɔrɑ bɛsɛn yĩiyɔbu wɑ̃ɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}