{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi Gusunɔn sɔm kowo u wom kowobun wiruɡii kuɑ. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"tɔn kɔ̃so wi u ǹ kɑ Gusunɔ yɔ̃n ɡɑri mɑn sɔkumɔ nɛn ɡɔ̃ruɔ,","poem":1},{"lineBreak":true},{"text":"domi u ǹ bwisikumɔ mɑ n weenɛ u Gusunɔ nɑsiɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"U win tii sue too.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ u ǹ win torɑru wurɑmɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ u tu tusi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Win ɡɑri kpuro, weesɑ yi sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"U ku rɑ wure u ɡɑ̃ɑnu ko kɑ lɑɑkɑri u sere ɡeɑ ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɔ̃sɑ u rɑ n bwisikumɔ win kpin yerɔ.","poem":1},{"lineBreak":true},{"text":"Yen swɑɑ sɔɔrɑ u rɑ n mɑɑ wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"U ku rɑ ye dukɑ suuri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adɑmɑ Yinni Gusunɔ, wunɛn durom mu wɑ̃ɑwɑ sere kɑ wɔllɔ.","poem":1},{"lineBreak":true},{"text":"Wunɛn bɔrɔkiniru tɑ mɑɑ sɔ̃ɔsire sere kɑ ɡuru winɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛyɑ mɑɑ wunɛn ɡem mu kpɑ̃ nɡe ɡuu bɑkɑnu.","poem":1},{"lineBreak":true},{"text":"Wunɛn siribu bu duku nɡe nim wɔ̃kun bweru.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ ɑ rɑ tɔmbu kɑ yɛɛ nɔɔri,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"domi wunɛn kĩru tɑ kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Wunɛn kɑsenun kɔkɔrɔwɑ tɔmbɑ kuku yenu kɑsu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A rɑ wunɛn durom yibie nɡe be bɑ di bɑ debɑ.","poem":1},{"lineBreak":true},{"text":"A rɑ bu nuku dobu wɛ̃ nɡe be bɑ nim ɡem wɑ bɑ nɔrɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Domi wunɑ ɑ sɑ̃ɑ wɑ̃ɑrun nuuru.","poem":1},{"lineBreak":true},{"text":"Wunɛn yɑm bururɑm sɑɑbuwɑ sɑ kɑ wɑ̃ɑrun ɑsɑnsi tubumɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A be bɑ nun yɛ̃ durom kuo.","poem":1},{"lineBreak":true},{"text":"A bèn ɡɔ̃ru ɡɑ dɛɛre bɔrɔkiniru sɔ̃ɔsio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A ku de tii suobu bu mɑn nɑɑ turi,","poem":1},{"lineBreak":true},{"text":"kpɑ tɔn kɔ̃sobu bu de n dukɑ yɑkurɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wee be bɑ kɔ̃sɑ mɔ̀, bɑ wɔrukumɔ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ kpɑnɛ bu se.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}