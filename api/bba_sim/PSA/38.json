{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u kuɑ Gusunɔ u kɑ nùn yɑɑyɑ."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ ku mɑn sɛɛyɑsiɑ wunɛn mɔru sɔɔ.","poem":1},{"lineBreak":true},{"text":"A ku mɑn so sɑnɑm mɛ ɑ mɔru bɛsire.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi wunɛn sɛ̃ɛnu nu mɑn ɡirɑri,","poem":1},{"lineBreak":true},{"text":"mɑ wunɛn nɔmu ɡɑ mɑn so ɡɑ surɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wunɛn mɔrun sɑɑbu, nɛn wɑsin ɡɑm sɑri mi n bwɑ̃ɑ do.","poem":1},{"lineBreak":true},{"text":"Nɛn durum sɑɑbu nɑ ǹ mɑɑ dɑm ɡɑm mɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi nɛn torɑnu kpɛ̃ɑ sere nu mɑn ɡunum kerɑ.","poem":1},{"lineBreak":true},{"text":"Nu sɑ̃ɑ nɡe sɔmu bɑkɑnu ni nu mɑn bunum kere.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛn booboosu kɔ̃sɑ sere su numiɑ nɛn ɡɑri bɑkɑrun sɔ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ dɛbɑrɑ, nɑ wɑsirɑ sere nɑ ǹ mɑɑ dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Bɑɑdommɑ, nɑ rɑ n sĩimɔwɑ kɑ nuku sɑnkirɑnu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Domi bɑrɑrɑ nɛn wɑsi kpuro mwɑ.","poem":1},{"lineBreak":true},{"text":"Yin ɡɑm mɑɑ sɑri mi n bwɑ̃ɑ do.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ kɔsikirɑwɑ muku muku, nɑ ǹ mɑɑ dɑm ɡɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Nɛn ɡɔ̃ru ɡɑ burisinɛ sere nɑ weeweenu mɔ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni, ye nɑ kĩ kpuro, wunɑ ɑ yɛ̃.","poem":1},{"lineBreak":true},{"text":"Nɛn weeweenu kun mɑɑ nun berue.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛn ɡɔ̃ru ɡɑ ǹ sɔ̃ sɛ̃ɛ, nɛn dɑm mɑn doonɑrimɔ.","poem":1},{"lineBreak":true},{"text":"Wee nɛn nɔni kun mɑɑ wɑ̃ɑru tere.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛn kpɑɑsibu kɑ be bɑ mɑn yɛ̃ kpuro","poem":1},{"lineBreak":true},{"text":"bɑ mɑn duki suurimɔ nɛn bɑrɑrun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ be bɑ mɑɑ wɑ̃ɑ nɛn turuku,","poem":1},{"lineBreak":true},{"text":"bɑ tii mɛnɑ nɛnɛm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Be bɑ kɑsu bu mɑn ɡo,","poem":1},{"lineBreak":true},{"text":"bɑ mɑn yɛ̃ri bɛriɑmmɛ bɑɑdommɑ.","poem":1},{"lineBreak":true},{"text":"Be bɑ nɛn kɔ̃sɑ kɑsu, bɑ mɑn kɔ̃sɑ siemɔ,","poem":1},{"lineBreak":true},{"text":"bɑ kɑsu bu mɑn nɔni wɔ̃ke.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, nɑ mɑɑriwɑ piti nɡe soso","poem":1},{"lineBreak":true},{"text":"wi u kun ɡɑ̃ɑnu nɔɔmɔ,","poem":1},{"lineBreak":true},{"text":"u ǹ mɑɑ ɡɑ̃ɑnu ɡerumɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛyɑ nɑ sɑ̃ɑ nɡe soso.","poem":1},{"lineBreak":true},{"text":"Nɑ ǹ bu ɡɑ̃ɑnu wisɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛ sɔɔrɑ nɛn yĩiyɔbu wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ nɛn Yinni, ɑ de ɑ mɑn wisi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A ku de bu nuku dobu ko nɛn sɔ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ bu mɑn seesi sɑnɑm mɛ nɑ sokurɑmɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wee nɑ wɔrumɑɑ dɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ nɛn wɑhɑlɑ yɑ mɑn wɑ̃ɑsi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɑ nɛn torɑnu tuubɑ mɔ̀.","poem":1},{"lineBreak":true},{"text":"Torɑ ni, nu mɑn bɛrum mɔ̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wee nɛn yibɛrɛbɑ bɑ bwɑ̃ɑ do,","poem":1},{"lineBreak":true},{"text":"bɑ mɑɑ dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Be bɑ mɑn tusɑ kɑm sɔɔ, bɑ dɑbi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kɔ̃sɑ bɑ mɑn kɔsiemɔ, ye nɑ bu ɡeɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Bɑ nɛn kɔ̃sɑ kɑsu yèn sɔ̃ nɑ rɑ n ɡeɑ mɔ̀.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ ku mɑn deri.","poem":1},{"lineBreak":true},{"text":"Nɛn Yinni, ɑ ku kɑ mɑn tondɑ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A nɑ fuuku ɑ mɑn yɑkiɑ,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ sɑ̃ɑ nɛn fɑɑbɑ kowo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}