{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u Yedutum, wom kowobun wiruɡii kuɑ. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"nɑ rɑɑ nɛɛ, kon nɛn sɑnu sɑnusu lɑɑkɑri ko","poem":1},{"lineBreak":true},{"text":"kpɑ n ku durum ko nɛn ɡɑri ɡerubu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kon nɛn nɔɔ kpĩ sɑnɑm mɛ nuku kɔ̃suruɡii wɑ̃ɑ nɛn bɔkuɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɑ rɑɑ mɑɑri, nɑ ǹ ɡɑ̃ɑnu ɡeruɑ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ deemɑ n kuɑ kɑm,","poem":1},{"lineBreak":true},{"text":"domi nɛn nɔni swɑ̃ɑru tɑ sosiwɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɛn lɑɑkɑri yɑ seewɑ.","poem":1},{"lineBreak":true},{"text":"Ye nɑ bwisikumɔ yɑ mɑn nɛni nɡe dɔ̃ɔ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ ɡeruɑ nɑ nɛɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn nɛn wɑ̃ɑrun sɑkɑ sɔ̃ɔsio","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n yɛ̃ nɡe mɛ nɑ ǹ dɑm mɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N wee ɑ nɛn tɔ̃ru yĩirɑ kɑ wunɛn nɔmɑn yɑsum,","poem":1},{"lineBreak":true},{"text":"mɑ nɛn wɑ̃ɑrun sɑnɑm kun ɡɑ̃ɑnu turɑ wunɛn nɔni sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kɑ ɡeemɑ tɔnu bɑɑwure koo doonɑ nɡe woo tiɑ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ǹ kun mɛ nɡe tiro.","poem":1},{"lineBreak":true},{"text":"Ye u mɔ̀ kpuro kɑmɑ.","poem":1},{"lineBreak":true},{"text":"U ɑrumɑni mɛnnɑmɔ, u ǹ yɛ̃ wɑrɑ koo ye di.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tɛ̃ Yinni, mbɑ nɑ mɑɑ mɑrɑ.","poem":1},{"lineBreak":true},{"text":"Nɛn yĩiyɔbu wɑ̃ɑ wunɛ sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A mɑn yɑkio nɛn durum kpuron di.","poem":1},{"lineBreak":true},{"text":"A ku de ɡɑri bɑkɑsu su n mɑn yɑɑkoru mɔ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kon mɑri, nɑ ǹ ɡɑri ɡerumɔ,","poem":1},{"lineBreak":true},{"text":"domi wunɑ ɑ derɑ yɑ koorɑ mɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A ku mɑɑ mɑn wɑhɑlɑ ko.","poem":1},{"lineBreak":true},{"text":"Nɑ wɑsikirɑmɔ wunɛn nɔm ɡɛrɑn sɔ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A rɑ tɔnu ɡerusi","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nùn sɛɛyɑsiɑ win torɑnun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Ye tɔnu u kĩ, yerɑ ɑ rɑ di nɡe kɔkɔbu.","poem":1},{"lineBreak":true},{"text":"Geemɑ, tɔnu bɑɑwure u koo doonɑwɑ nɡe woo tiɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn kɑnɑru nɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nɛn sokuru swɑɑ dɑki.","poem":1},{"lineBreak":true},{"text":"A ku nɛn wuri ɑtɑfiiru ko,","poem":1},{"lineBreak":true},{"text":"domi nɑ sɑ̃ɑwɑ sɔɔ wunɛn mi nɡe nɛn sikɑdobɑ kpuro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A mɑn derio sɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"kpɑ n wom wɑ n sere sɑriru ko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}