{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, nɑ̀ n wɑ̃ɑ nɔni swɑ̃ɑru sɔɔ,","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ rɑ mɑn somi.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n nun sokɑ, ɑ mɑn wurɑrio.","poem":1},{"lineBreak":true},{"text":"A nɛn wɔnwɔndu wɑɑwo,","poem":1},{"lineBreak":true},{"text":"ɑ nɛn kɑnɑru nɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"wunɛ wi ɑ rɑ mɑn sirie.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛɛ tɔmbu, sere sɑɑ yerɑ̀ i ko i n mɑn wɔmmɔ.","poem":1},{"lineBreak":true},{"text":"Bɛɛ tɔmbu, sere sɑɑ yerɑ̀ i ko i n kɑm ɡire.","poem":1},{"lineBreak":true},{"text":"Bɛɛ tɔmbu, sere sɑɑ yerɑ̀ i ko i n weesu swĩi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I n yɛ̃ mɑ Gusunɔ u rɑ tii nɑɑnɛɡii ɡɔsie.","poem":1},{"lineBreak":true},{"text":"I n yɛ̃ mɑ Gusunɔ u rɑ nɛn nɔɔ nɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bwisikuo ɡɔ̃ruɔ bɛɛn kpin yenɔ kpɑ i mɑri.","poem":1},{"lineBreak":true},{"text":"I diirio bɛrum sɔ̃ kpɑ i durum deri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔ nɑɑnɛ dokeo.","poem":1},{"lineBreak":true},{"text":"I yɑ̃kunu koowo ni u bikiɑmɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tɔn dɑbirɑ weeweenu mɔ̀ tɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"Gusunɔ, ɑ kɑ sun bɔri yɛndu nɑɑwɔ.","poem":1},{"lineBreak":true},{"text":"Yinni, ɑ kɑ sun nɔnu ɡeu mɛɛrio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, nɑ rɑ n nuku dobu mɔ","poem":1},{"lineBreak":true},{"text":"n kere be bɑ dĩɑnu yibɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ rɑ n yɛ̃ɛrimɔ n kere be bɑ tɑm yibɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ̀ n kpunɑ nɑ rɑ dweeye kɑ bɔri yɛndu,","poem":1},{"lineBreak":true},{"text":"domi wunɛ turowɑ ɑ mɑn kɔ̃su, Yinni Gusunɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}