{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"doo nɔɔruɡiiwɑ wi u rɑ sɑ̃ɑron bwisikunu ko.","poem":1},{"lineBreak":true},{"text":"Ù n wɑ̃ɑ wɑhɑlɑ sɔɔ, Yinni Gusunɔ u koo nùn yɑrɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u koo nùn kɔ̃su,","poem":1},{"lineBreak":true},{"text":"kpɑ u n win wɑ̃ɑru nɛni.","poem":1},{"lineBreak":true},{"text":"Mɛyɑ u ko n nuku dobu mɔ win wɑ̃ɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"U ǹ mɑɑ derimɔ u wɔri win yibɛrɛbɑn nɔmɑɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔwɑ u koo nùn kɔ̃su","poem":1},{"lineBreak":true},{"text":"kpɑ u nùn nɔɔri sɑnɑm mɛ u bɑrɔ u kpĩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wee, nɑ ɡerumɔ nɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn wɔnwɔndu wɑɑwo,","poem":1},{"lineBreak":true},{"text":"ɑ nɛn hunde bɛkio.","poem":1},{"lineBreak":true},{"text":"Domi nɑ nun torɑri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuku kɔ̃surun sɔ̃, nɛn yibɛrɛbɑ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"sɑɑ yerɑ̀ kon ɡbi.","poem":1},{"lineBreak":true},{"text":"Kpɑ bu wɑ bu nɛn yĩsiru duɑri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Goo ù n nɑ nɛn mi, weesɑ yɛ̃ro u rɑ mɑn kue,","poem":1},{"lineBreak":true},{"text":"kpɑ u nɛn ɡɑri ɡurɑ u kɑ dɑ u nɛn kɔ̃sɑ ɡere tɔɔwɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛn yibɛrɛbɑ kpuro bɑ ɡunnu ɡunnu ɡɑri mɔ̀.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑn kɔ̃sɑ bwisikusimɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi bɑ mɔ̀, wɑhɑlɑ ye, yɑ mɑn nɛni ɡem kɑ tiɑ.","poem":1},{"lineBreak":true},{"text":"Nɛ wee nɑ kpĩ, n ǹ koorɔ n mɑɑ se.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɛn bɔrɔ kĩnɑsi, kɑ wì sɑ wɑ̃ɑ sɑnnu bɔri yɛndu sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ mɑɑ nùn nɑɑnɛ sɑ̃ɑ, mɑ sɑ dimɔ sɑnnu,","poem":1},{"lineBreak":true},{"text":"wiyɑ u kuɑ nɛn yibɛrɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yen sɔ̃, Yinni Gusunɔ, ɑ nɛn wɔnwɔndu wɑɑwo,","poem":1},{"lineBreak":true},{"text":"ɑ mɑn wɔro, kpɑ n bu kuɑ ye n weenɛ n bu kuɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛn yibɛrɛ ù kun mɑn kɑmiɛ,","poem":1},{"lineBreak":true},{"text":"sɑɑ ye sɔɔrɑ kon ɡiɑ mɑ ɑ mɑn kĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A mɑn kɔ̃su nɛn mɛm nɔɔbun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ derɑ nɑ wɑ̃ɑ wunɛn mi sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nɑ Gusunɔ Isirelibɑn Yinni siɑrɑ.","poem":1},{"lineBreak":true},{"text":"U ko n wɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ. Ami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}