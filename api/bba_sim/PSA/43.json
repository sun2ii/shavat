{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"A mɑn ɡem wɛ̃ɛyɔ Gusunɔ nɛn Yinni.","poem":1},{"lineBreak":true},{"text":"A kɑ mɑn yinɔ be bɑ ǹ nun nɑsien wuswɑɑɔ.","poem":1},{"lineBreak":true},{"text":"A mɑn yɑkio wee kowobu kɑ tɔn kɔ̃sobun min di.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gusunɔ, wunɛ wi ɑ mɑn kɔ̃su, mbɑn sɔ̃nɑ ɑ mɑn yinɑmɔ.","poem":1},{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ kɑɑ de nɛn yibɛrɛbɑ bɑ n mɑn dɑm dɔremɔ","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n nuki sɑnkire.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A de wunɛn yɑm bururɑm kɑ wunɛn bɔrɔkinirɑ n mɑn kpɑre.","poem":1},{"lineBreak":true},{"text":"A kɑ mɑn doo sere wunɛn ɡuu dɛɛrɑ ten mi, mi ɑ wɑ̃ɑ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kpɑ n dɑ wunɛn yɑ̃ku yerɔ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ, wunɛ wì sɔɔ nɑ nuku dobu mɔ,","poem":1},{"lineBreak":true},{"text":"kon nun siɑrɑ kɑ womusu, kɑ mɔrɔku.","poem":1},{"lineBreak":true},{"text":"Gusunɔ, wunɑ ɑ sɑ̃ɑ nɛn Yinni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbɑn sɔ̃nɑ nɑ kon nuki sɑnkire,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n weeweenu mɔ̀ nɛn ɡɔ̃ruɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ kon nɛn nɑɑnɛ dokewɑ wunɛ sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n wure n nun siɑrɑ.","poem":1},{"lineBreak":true},{"text":"A sɑ̃ɑwɑ nɛn Yinni kɑ nɛn Fɑɑbɑ kowo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}