{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Womu ɡe Koren bibu bɑ wom kowobun wiruɡii kuɑ. Bɑ ɡu kuɑwɑ kɑ ɡɔ̃ru yɑ̃kɑ. Bɑ nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"Gusunɔwɑ u sɑ̃ɑ bɛsɛn kuku yee nɑɑnɛɡiru","poem":1},{"lineBreak":true},{"text":"kɑ bɛsɛn tɑ̃si yeru.","poem":1},{"lineBreak":true},{"text":"Bɑɑ nuku sɑnkirɑnu sɔɔ,","poem":1},{"lineBreak":true},{"text":"u rɑ n sɔɔru sɑ̃ɑwɑ u kɑ tɔnu somi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ sɑ ǹ bɛrum mɔ̀ sɑnɑm mɛ tem mu yĩirimɔ,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ sɑnɑm mɛ ɡuunu diirimɔ nim wɔ̃kun sɔɔwɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sɑ ǹ nɑnde sɑnɑm mɛ nim wɔ̃kun nim kurenu nu wɔki nu yɑkɑ mɔ̀","poem":1},{"lineBreak":true},{"text":"sɑnɑm mɛ nu ɡuunu yĩirimɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɑɑru ɡɑrɑ wɑ̃ɑ tèn nim mu kɑ nuku dobu nɑɑmɔ Wɔrukoon wɑ̃ɑ yerɔ,","poem":1},{"lineBreak":true},{"text":"dii dɛɛrɑ ten mi, mi wi, Gusunɔ u wɑ̃ɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gusunɔ u wɑ̃ɑ te sɔɔ, yen sɔ̃nɑ tɑ ǹ wɔrumɛ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ u rɑ tu ɡɑbewɑ sɑɑ buru buru yellun di.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bwesenu nu burisinɛ, mɑ bɑnnu wɔrukumɔ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ u ɡbɑ̃rɑ, mɑ tem mu yɑndɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ wɔllu kɑ tem Yinni u kɑ sun wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Yɑkɔbun Yinni, u sɑ̃ɑwɑ bɛsɛn kuku yee nɑɑnɛɡiru.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I nɑ i wɑ ye Yinni Gusunɔ u kuɑ.","poem":1},{"lineBreak":true},{"text":"U sɔm mɑɑmɑɑkiɡinu kuɑ hɑnduniɑ sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"U tɑbu kpeesiɑ yen ɡoonu nnɛ ye sɔɔ.","poem":1},{"lineBreak":true},{"text":"U tɛnnu kɑ yɑɑsi bɔɔkɑ,","poem":1},{"lineBreak":true},{"text":"mɑ u tɑbu kɛkɛ yi dumi ɡɑwe dɔ̃ɔ mɛni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"U nɛɛ, i yɔ̃ro, kpɑ i ɡiɑ mɑ wiyɑ Gusunɔ.","poem":1},{"lineBreak":true},{"text":"U bɑndu dii bwesenu kpuro sɔɔ, kɑ tem kpuro sɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gusunɔ wɔllu kɑ tem Yinni u kɑ sun wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wi, Yɑkɔbun Yinni u sɑ̃ɑwɑ bɛsɛn kuku yee nɑɑnɛɡiru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}