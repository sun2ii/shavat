rue},{"text":"U ɡbiɑ u dɔɔ, mɑ bɑ kɔbɑ soomɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Gusunɔ womu kuo, i Gusunɔ womu kuo.","poem":1},{"lineBreak":true},{"text":"I Yinni, sinɑ boko siɑro kɑ womu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Domi wiyɑ u sɑ̃ɑ hɑnduniɑ kpuron sunɔ.","poem":1},{"lineBreak":true},{"text":"I nùn womu kuo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wiyɑ u bɑndu dii bwesenu kpuro sɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ u sɔ̃ win sinɑ ɡɔni dɛɛrɑ sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bwese tukunun sinɑ bibɑ mɛnnɑmɔ kɑ Gusunɔ Aburɑhɑmun Yinnin tɔmbu.","poem":1},{"lineBreak":true},{"text":"Domi wiyɑ u kɑ be bɑ tem kɔ̃su wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u kpuro kere.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}