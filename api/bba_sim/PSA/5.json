{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ kɑ ɡɑɑsirɑru. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ mɑn swɑɑ dɑkio.","poem":1},{"lineBreak":true},{"text":"Gusunɔ, ɑ nɛn weeweenu nɔɔwɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn wuri swɑɑ dɑkio.","poem":1},{"lineBreak":true},{"text":"Yinni, nɛn sinɑ boko, wunɑ nɑ kɑnɑmɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ rɑ nɛn kɑnɑru nɔ bururu.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ rɑ nɛn nɔɔ nɔ sɔ̃ɔ ù n yɑrɑ.","poem":1},{"lineBreak":true},{"text":"Wee nɑ wunɛn wisibu mɑrɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ ku rɑ kɔ̃sɑ kɑ̃.","poem":1},{"lineBreak":true},{"text":"Kɔ̃sɑn kowobu bɑ ǹ wɑ̃ɑ yeru wɑsi wunɛn mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tii suobu bɑ ǹ kpɛ̃ bu yɔ̃rɑ wunɛn mi.","poem":1},{"lineBreak":true},{"text":"A kɔ̃sɑn kowobu tusɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A tɔn ɡowobu tusɑ.","poem":1},{"lineBreak":true},{"text":"A tɑki diobu tusɑ.","poem":1},{"lineBreak":true},{"text":"A rɑ wee kowobu kpeerɑsie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, wunɛn durom bɑkɑm sɔ̃nɑ","poem":1},{"lineBreak":true},{"text":"kon kpĩ n dɑ wunɛn sɑ̃ɑ yerɔ.","poem":1},{"lineBreak":true},{"text":"Wunɛn durom bɑkɑm sɔ̃nɑ","poem":1},{"lineBreak":true},{"text":"kon kpĩ n yiirɑ mi ɑ wɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Miyɑ kon kpĩ n nun bɛɛrɛ wɛ̃.","poem":1},{"lineBreak":true},{"text":"Miyɑ kon kpĩ n nun sɑ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ bɔrɔkini.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑn swɑɑ sɔ̃ɔsio ye ɑ kĩ n swĩi.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn yibɛrɛbɑ sɔ̃ɔsio mɑ","poem":1},{"lineBreak":true},{"text":"wunɑ ɑ mɑn kpɑre.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ben ɡɑri kun nɑɑnɛ mɔ.","poem":1},{"lineBreak":true},{"text":"Ben yɑrɑ yɑ rɑ n tɔmbu fufu mɔ̀wɑ.","poem":1},{"lineBreak":true},{"text":"Kɔ̃sɑ ben bwisikunu nu rɑ n nɑɑ ɡire.","poem":1},{"lineBreak":true},{"text":"Kɑm kobɑ ben ɡere yɑ rɑ kɑ nɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A bu nɔni sɔ̃ɔwɔ ben tɑɑrɛn sɔ̃.","poem":1},{"lineBreak":true},{"text":"A bu sureo ben tiin yinɑ sɔɔ.","poem":1},{"lineBreak":true},{"text":"A bu ɡiro wunɛn wuswɑɑn di,","poem":1},{"lineBreak":true},{"text":"domi ben durum yɑ kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Bɑ mɑɑ nun seesi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Be bɑ sɑ̃ɑ wunɛɡibu, kɑɑ de bu nuku dobu wɑ.","poem":1},{"lineBreak":true},{"text":"Kɑɑ de bu kɑtinu kɑrɑ.","poem":1},{"lineBreak":true},{"text":"Kɑɑ de bu yɛ̃ɛri. Kɑɑ bu kɔ̃su.","poem":1},{"lineBreak":true},{"text":"Kɑɑ bu domɑru kuɑ.","poem":1},{"lineBreak":true},{"text":"Kɑɑ bu ɡɑnɛ nɡe tɛrɛru wunɛn kĩrun sɑɑbu,","poem":1},{"lineBreak":true},{"text":"domi bɑ nun kĩ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ nun mɛm nɔɔwɑmmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}