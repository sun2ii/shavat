{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ kɑ mɔrɔku"]},{"type":"verse","number":2,"content":["sɑnɑm mɛ Sifuɡibu bɑ nɑ Sɔɔlun mi bu kɑ nùn sɔ̃ mɑ Dɑfidi u kukuɑ ben temɔ. Ge wee."]},{"type":"verse","number":3,"content":[{"text":"Gusunɔ, ɑ mɑn fɑɑbɑ koowo wunɛn yĩsirun sɔ̃.","poem":1},{"lineBreak":true},{"text":"A de ɑ mɑn siriɑ kɑ wunɛn dɑm bɑkɑm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ swɑɑ tem kpĩiyɔ kpɑ ɑ nɛn kɑnɑru nɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi tɔn tukobu bɑ mɑn seesi.","poem":1},{"lineBreak":true},{"text":"Tɔn kɔ̃sobu bɑ kɑsu bu mɑn ɡo.","poem":1},{"lineBreak":true},{"text":"Ben bwisikunu sɔɔ, bɑ nɛɛ, wunɛ Gusunɔ ɑ sɑri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛn mi, wunɑ ɑ sɑ̃ɑ nɛn fɑɑbɑ kowo.","poem":1},{"lineBreak":true},{"text":"Be bɑ kɑ mɑn yɔ̃, berɑ ɑ mɑɑ kɑ yɔ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A nɛn yibɛrɛbɑ kɔ̃sɑ kɔsio.","poem":1},{"lineBreak":true},{"text":"A mɑn bɔrɔkiniru sɔ̃ɔsio, ɑ bu ɡo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kon nun yɑ̃kunu kuɑ kɑ nuku tiɑ.","poem":1},{"lineBreak":true},{"text":"Kon womu ko kɑ wunɛn yĩsiru n nun tɔmɑ,","poem":1},{"lineBreak":true},{"text":"domi ɑ sɑ̃ɑ tɔn ɡeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ rɑ mɑn nuku sɑnkirɑru wunɑri,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n nuku dobu mɔ nɑ̀ n nɛn yibɛrɛbɑ wɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}