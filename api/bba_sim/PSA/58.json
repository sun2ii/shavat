{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Bɛɛ Wɔrukoon tɔmbu,","poem":1},{"lineBreak":true},{"text":"i ko kpĩ i bɑɑwure siri dee dee i n kɑ sere nɔɔ mɑɑri?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aɑwo, i kɔ̃sɑ mɔ̀wɑ ɡɔ̃ruɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ i bɔbunu ɑyeru kɛ̃mɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dɑɑ kɔ̃sɑɡii u rɑ sɔ̃ɔsirewɑ sɑɑ win mɛron nukurun di.","poem":1},{"lineBreak":true},{"text":"Wee kowo u rɑ kɔ̃ɔrewɑ sɑɑ win birun di.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ben nɔɔ ɡɑ rɑ n dɛ̃ɛ yibɑwɑ nɡe wɑɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n ben swɑsu kɔruɑ nɡe surɔkɔru","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"te tɑ kun kĩ tu dobo doboɡibun ɡɑri nɔ,","poem":1},{"lineBreak":true},{"text":"bɑɑ mɑm wi u dobo dobo yɛ̃ru bon ɡɑri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ bu nɔɔ kɔsukuo.","poem":1},{"lineBreak":true},{"text":"Be, be bɑ sɑ̃ɑ nɡe ɡbee sinɑn kpɛmminu mi,","poem":1},{"lineBreak":true},{"text":"ɑ ben bɑɑ sɑburosu yɑkirio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A de bu yɑrinɑ nɡe nim mɛ mu kokumɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ bu twee bu ko kpɑnɔbu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu ɡbio bu yɑndɑ nɡe sokoro,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ ku de bu sɔ̃ɔ wɑ","poem":1},{"lineBreak":true},{"text":"nɡe bii wìn suru kun yibɑ bɑ kɑ mɑrɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɑɑ bu ɡurɑwɑ fuuku kɑ woo ɡunɑ sere bu kɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"weke te bɑ swɛ̃n koru tɑ dɔ̃ɔ wɑ tɑ swĩɑ, bɑɑ dɑ̃ɑ yɑ̀ n ɡbere.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adɑmɑ ɡemɡii u ko n nuku dobu mɔwɑ","poem":1},{"lineBreak":true},{"text":"ù n wɑ bɑ nùn mɔru bɑrɑ.","poem":1},{"lineBreak":true},{"text":"U koo win nɑɑsu kpɑkiɑ tɔn kɔ̃sobun yɛm sɔɔ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kpɑ tɔmbu bu nɛɛ, ɡemɡiiwɑ u koo ɑre wɑ.","poem":1},{"lineBreak":true},{"text":"Domi Gusunɔwɑ u hɑnduniɑn tɔmbu kpuro sirimɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}