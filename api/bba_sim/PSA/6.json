{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ kɑ mɑn mɔru sɑ̃ɑ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ nɑ nun kɑnɑmɔ,","poem":1},{"lineBreak":true},{"text":"ɑ ku mɑn ɡerusi, ɑ ku mɑn sɛɛyɑsiɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A nɛn wɔnwɔndu wɑɑwo, ɑ mɑn bɛkio,","poem":1},{"lineBreak":true},{"text":"domi nɛn wɑsi kun dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Wee nɑ ɡɔɔ dɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɛn bwɛ̃rɑ kun kpĩ.","poem":1},{"lineBreak":true},{"text":"Yinni, sere sɑɑ yerɑ̀ kɑɑ mɑn deri mɛ.","poem":1},{"lineBreak":true},{"text":"Sɑɑ yerɑ̀ kɑɑ mɑn somiru nɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A wurɑmɑ ɑ mɑn fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"A mɑn wɔro wunɛn durom sɔ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi wi u ɡu u ǹ mɑɑ wunɛn bwisikunu mɔ̀.","poem":1},{"lineBreak":true},{"text":"Wi bɑ sikɑ u ǹ mɑɑ kpɛ̃ u nun sɑ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, weeweenu derɑ nɑ ǹ dɑm mɔ.","poem":1},{"lineBreak":true},{"text":"Wɔ̃kuru bɑɑtere nɛn nɔni yĩresu rɑ n kokumɔwɑ.","poem":1},{"lineBreak":true},{"text":"Wɔ̃kuru bɑɑtere nɛn kpin yerɑ rɑ n wɑɑrewɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛn nɔni mɔsɑ swĩin sɔ̃.","poem":1},{"lineBreak":true},{"text":"Yibɛrɛbɑrɑ bɑ mɑn yeni kpuro koosiɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛɛ be i kɔ̃sɑ mɔ̀ kpuro, i doonɔ nɛn min di,","poem":1},{"lineBreak":true},{"text":"domi nɑ fɑɑbɑ kɑnɑ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ u nɛn wuri nuɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"U nɛn weeweenu nuɑ.","poem":1},{"lineBreak":true},{"text":"U nɛn kɑnɑru mwɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u koo nɛn yibɛrɛbɑ kɑmiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu sekuru wɑ.","poem":1},{"lineBreak":true},{"text":"U koo bu ɡirɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bu biruku yirɑ wurɑ kɑ sekuru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}