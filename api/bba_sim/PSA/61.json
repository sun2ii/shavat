{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, ɑ nɛn weeweenu nɔɔwɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ nɛn kɑnɑru nɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sɑɑ tontonden diyɑ nɑ nun nɔɔɡiru sue kɑ nuku sɑnkirɑnu.","poem":1},{"lineBreak":true},{"text":"A kɑ mɑn ɡuuru yɔɔwo te nɑ ǹ kpɛ̃ n kɑ tii yɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi ɑ sɑ̃ɑwɑ nɛn kuku yeru.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ mɑɑ sɑ̃ɑ nɛn ɡbɑ̃rɑru nɛn yibɛrɛbɑn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɑ kĩ nɑ n wɑ̃ɑ wunɛn kuu bekuruɡirɔ sere kɑ bɑɑdommɑɔ,","poem":1},{"lineBreak":true},{"text":"nɑ n kukuɑ wunɛn kɑserun kɔkɔrɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Domi ɑ rɑ mɑn kue ye nɑ kĩ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ mɑn tubi wɛ̃ ye ɑ rɑ be bɑ wunɛn yĩsiru nɑsie wɛ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gusunɔ, ɑ bɛsɛn sinɑ bokon wɑ̃ɑru dɑkɑɑ dɑɑsio.","poem":1},{"lineBreak":true},{"text":"A de win wɑ̃ɑru tu dɛnyɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kpɑ ɑ de u n bɑndu dii sere kɑ bɑɑdommɑɔ wunɛn wuswɑɑɔ.","poem":1},{"lineBreak":true},{"text":"A de wunɛn bɔrɔkiniru kɑ wunɛn tɔn ɡeerɑ n wɑ̃ɑ wi sɔɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sɑɑ yerɑ kon nun tɔmɑ sere kɑ bɑɑdommɑɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ nɑ n nɛn nɔɔ mwɛɛru yibiɑmɔ tɔ̃ɔ bɑɑtere.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}