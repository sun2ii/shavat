{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu. U ɡu kuɑwɑ sɑnɑm mɛ u wɑ̃ɑ Yudɑn ɡbɑburɔ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, ɑ sɑ̃ɑwɑ nɛn Yinni.","poem":1},{"lineBreak":true},{"text":"Wunɑ nɑ soku.","poem":1},{"lineBreak":true},{"text":"Nɑ wunɛn bɛkɛ bɑrɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ nɛn wɑsi kpuro bɛsikirɑmɔ wunɛn sɑrirun sɔ̃","poem":1},{"lineBreak":true},{"text":"nɡe mɛ tem ɡbebum mu rɑ n bɛsikirɑmɔ nim sɑrirun sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wee nɑ wɑ̃ɑ wunɛn sɑ̃ɑ yerɔ nɑ nun mɛɛrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ n kɑ wunɛn dɑm kɑ wunɛn yiiko wɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi wunɛn tɔn ɡeeru tɑ ɡisɔn wɑ̃ɑru kere.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ kon nun tɔmɑ kɑ womusu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kon nun siɑrɑ nɛn wɑ̃ɑru kpuro sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n nɔmɑ suɑ wɔllɔ n kɑ nun sɑ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛn hunde koo debu","poem":1},{"lineBreak":true},{"text":"nɡe wi u dĩɑ duronu kɑ yɑɑ ɡumɡiɑ di.","poem":1},{"lineBreak":true},{"text":"Kon nun siɑrɑ kɑ nuku dobun kuuki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɑ̀ n kpĩ, nɑ rɑ n nun yɑɑyewɑ nɑ n wunɛn bwisikunu mɔ̀ wɔ̃kuru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Domi ɑ sɑ̃ɑwɑ nɛn somiɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ̀ n kukuɑ wunɛn kɑsenun kɔkɔrɔ,","poem":1},{"lineBreak":true},{"text":"nɑ rɑ n nuku dobu mɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɑ kɑ nun mɑninɛwɑ dim dim,","poem":1},{"lineBreak":true},{"text":"mɑ wunɛn nɔm ɡeu ɡɑ mɑn nɛni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be bɑ kɑsu bu mɑn ɡo","poem":1},{"lineBreak":true},{"text":"bɑ koo dɑwɑ sere tem sɔɔ sɔɔwɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɑkobiwɑ bɑ koo kɑ bu ɡo,","poem":1},{"lineBreak":true},{"text":"kpɑ purukɑnu nu ben ɡonu tem.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛ, sinɑ boko kon yɛ̃ɛri wunɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wi u kɑ nun bɔ̃ruɑ u koo tii siɑrɑ,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ kɑɑ wee kowobun nɔsu kɔre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}