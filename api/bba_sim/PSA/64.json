{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, ɑ nɛn nɔɔ nɔɔwɔ sɑnɑm mɛ nɑ weeweenu mɔ̀.","poem":1},{"lineBreak":true},{"text":"A mɑn kɔ̃suo nɛn yibɛrɛ wi nɑ nɑsien sɔ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mɑn yɑro tɔn kɔ̃sobun wesiɑnɔsun di.","poem":1},{"lineBreak":true},{"text":"Kpɑ ɑ mɑn yɑrɑ dɑɑ kɔ̃sɑɡibun suunun di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ ben yɑrɑ nɔɔ derɑmɔ nɡe tɑkobi,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n ɡɑri kɔ̃si kɑsukumɔ nɡe sɛ̃ɛnu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"bu kɑ wi u kun ɡɑ̃ɑnu kue to ɑsiri sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɑ tii dɑm kɛ̃mɔwɑ kɔ̃sɑn kobu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ rɑ nɔɔ tiɑ ko bu kɑ tɔmbu yinɑ bɛriɑ","poem":1},{"lineBreak":true},{"text":"bɑ n mɔ̀, ɡoo kun bu wɑsi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɔ̃sɑ bɑ himbɑ mɔ̀ bɑ mɔ̀, ben kpunɑɑ ye, yɑ wɑ̃wɑ mɑm mɑm.","poem":1},{"lineBreak":true},{"text":"Domi ɡoo kun kpɛ̃ u tɔnun ɡɔ̃run ɡɑri tubu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ u bu sɛ̃ɛnu twee.","poem":1},{"lineBreak":true},{"text":"Wee nu bu ɡirɑri.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"U bu mwɑ kɑ ben tii tiin ɡɑri.","poem":1},{"lineBreak":true},{"text":"Be bɑ bu wɑ kpuro bɑ rɑ wii ɡimɑnu kowɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kpɑ bɛrum mu be kpuro mwɑ bɑ n kpɑrɑmɔ ye Gusunɔ u kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n yen bwisikunu mɔ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔn miyɑ ɡemɡii u rɑ kuku yeru kɑ nuku dobu wɑ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bèn ɡɔ̃ru ɡɑ dɛɛre bu bɛɛrɛ wɑ win mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}