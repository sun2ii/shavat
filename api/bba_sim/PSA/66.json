{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":66,"content":[{"type":"verse","number":1,"content":["Womu ɡe bɑ wom kowobun wiruɡii kuɑ. Ge wee.",{"text":"Bɛɛ hɑnduniɑn tɔmbu kpuro,","poem":1},{"lineBreak":true},{"text":"i Gusunɔ nɔɔɡiru sueyo kɑ nuku dobu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I womu koowo win yĩsirun yiikon sɔ̃.","poem":1},{"lineBreak":true},{"text":"I win yĩsiru wɔlle suo kɑ womusu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kpɑ i nùn sɔ̃ mɑ win sɔmɑ yɑ nɑnum mɔ,","poem":1},{"lineBreak":true},{"text":"domi win dɑm mu kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃nɑ win yibɛrɛbɑ bɑ nùn wiru kpĩiyɑmmɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hɑnduniɑɡibu kpuro bɑ nùn yiirɑmmɛ.","poem":1},{"lineBreak":true},{"text":"Bɑ nùn tɔmɑmɔ kɑ womusu,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ win yĩsiru bɛɛrɛ wɛ̃ɛmɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I nɑ i Gusunɔn sɔmɑ mɛɛri ye u kuɑ.","poem":1},{"lineBreak":true},{"text":"U nɑnum mɔ ù n sɔmburu mɔ̀ tɔmbun suunu sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"U derɑ dɑɑrɑ ɡberɑ,","poem":1},{"lineBreak":true},{"text":"mɑ sɑ tɔburɑ bɛsɛn nɑɑsu kun nim wɑ,","poem":1},{"lineBreak":true},{"text":"mɑ sɑ nuku dobu kuɑ wi sɔɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U bɑndu diiwɑ sere kɑ bɑɑdommɑɔ win dɑm sɑɑbu.","poem":1},{"lineBreak":true},{"text":"U bwesenu kpuro mɛɛrɑ kɑ lɑɑkɑri,","poem":1},{"lineBreak":true},{"text":"kpɑ mɛm nɔɔ sɑribɑ bu ku rɑɑ nùn seesi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I Gusunɔ siɑro bɛɛ bwesenu kpuro.","poem":1},{"lineBreak":true},{"text":"I nùn tɔmɔ bu nɔ bɑɑmɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi u bɛsɛn wɑ̃ɑru wɔrɑ.","poem":1},{"lineBreak":true},{"text":"U ǹ dere su sokurɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gusunɔ, ɑ sun doke lɑɑkɑri mɛɛribu sɔɔ.","poem":1},{"lineBreak":true},{"text":"A derɑ sɑ wɑ̃ɑ dɔ̃ɔ sɔɔ nɡe sii ɡeesu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A sun kpɛ̃ɛ yinɑ sɔɔ mɑ ɑ sun sɔmu bɑkɑnu sɔbi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A derɑ bɛsɛn yibɛrɛbɑ bɑ sun sɔni,","poem":1},{"lineBreak":true},{"text":"mɑ sɑ dɔ̃ɔ kɑ nim sɑrɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ɑ sun yɑrɑ min di sɑ n kɑ bɔri yɛndu mɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kon du wunɛn sɑ̃ɑ yerɔ n kɑ nun yɑ̃kuru kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ n nɛn nɔɔ mwɛɛnu yibiɑ","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ni nɑ nun kuɑ nɛn wɑhɑlɑn sɑɑ sɔɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kon kɑ nun kɛtɛbɑ kɑ bonu yɑ̃kuru kuɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ n kɑ nun yɑ̃ɑ ni nu ɡum mɔ yɑ̃ku dɔ̃ɔ mwɑɑrɑruɡinu kuɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɛɛ be i Gusunɔ nɑsie, i nɑ i nɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n bɛɛ sɔ̃ ye u mɑn kuɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nɑ nùn nɔɔɡiru sue u mɑn somi,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ nùn siɑrɑ kɑ womusu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nɑ̀ n dɑɑ torɑru ɡɑru mɔ nɛn ɡɔ̃ruɔ,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ kun dɑɑ mɑn wurɑrimɔ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Adɑmɑ u nɛn kɑnɑru swɑɑ dɑki u mɑn wurɑri.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nɑ nùn siɑrɑ domi u nɛn kɑnɑru mwɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ u ǹ mɑn win durom wunɑri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}