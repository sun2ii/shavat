{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, ɑ bɛsɛn wɔnwɔndu wɑɑwo,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ sun domɑru kuɑ.","poem":1},{"lineBreak":true},{"text":"A de ɑ kɑ sun nɔnu ɡeu mɛɛri,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kpɑ tɔmbu bu wunɛn swɑɑ ɡiɑ hɑnduniɑ sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n yɛ̃ mɑ wunɑ ɑ rɑ tɔnu fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gusunɔ, bwesenu kpuro nu nun siɑrɑmɔ","poem":1},{"lineBreak":true},{"text":"mɑ nu nun tɔmɑmɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nu wɑ̃ɑ nuku dobu sɔɔ, domi ɑ rɑ nu siriewɑ dee dee.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ mɑɑ nu kpɑre tem mɛ sɔɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bwesenu kpuro nu nun siɑrɑmɔ mɑ nu nun tɔmɑmɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Domi ɑ rɑ de tem mu dĩɑnu mɑ.","poem":1},{"lineBreak":true},{"text":"Gusunɔ, wunɑ ɑ sɑ̃ɑ bɛsɛn Yinni.","poem":1},{"lineBreak":true},{"text":"A rɑ sun domɑru kue.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A sun domɑru kuo. Hɑnduniɑɡibu kpuro bɑ nun nɑsie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}