{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Womu ɡe Dɑfidi u kuɑ sɑnɑm mɛ u nuki sɑnkire Kusi Bɛnyɑmɛɛɡiin sɔ̃. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ nɛn Yinni, wunɑ nɑ nɑɑnɛ sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A mɑn wɔro be bɑ mɑn nɑɑ ɡiren nɔmɑn di.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kpɑ bu ku rɑɑ mɑn mwɑ bu kɑsuku","poem":1},{"lineBreak":true},{"text":"nɡe mɛ ɡbee sunɔ ɡɑ rɑ yɑɑ kɑsuku,","poem":1},{"lineBreak":true},{"text":"ɡoo u kun ye wɔre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gusunɔ, nɛn Yinni, wee bɑ mɑn tɑɑrɛ wɛ̃ɛmɔ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"nɑ ɡoo torɑri,","poem":1},{"lineBreak":true},{"text":"nɑ nɛn kĩnɑsi bɔrɔ kɔ̃ɔru kuɑ,","poem":1},{"lineBreak":true},{"text":"nɑ nɛn yibɛrɛ wɔri,","poem":1},{"lineBreak":true},{"text":"nɑ win yɑ̃nu wɔrɑ kɑ wɔbiɑ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ nɑ̀ n yen ɡɑɑ kuɑn nɑ kɑ ɡem,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ɑ de nɛn yibɛrɛ u mɑn sɛ̃re u ɡo.","poem":1},{"lineBreak":true},{"text":"A de u nɛn ɡoru deri mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɛn yibɛrɛ wɔrio kɑ mɔru.","poem":1},{"lineBreak":true},{"text":"Be bɑ kɔ̃ruɑ, ɑ bu sɛɛyɑsio kɑ mɔru.","poem":1},{"lineBreak":true},{"text":"A de ɑ n wɑ̃ɑ nɛn bɔkuɔ.","poem":1},{"lineBreak":true},{"text":"A de ɑ mɑn siriɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wee ɑ sɔ̃ wunɛn sinɑ ɡɔnɑɔ.","poem":1},{"lineBreak":true},{"text":"A de bwesenu nu mɛnnɑmɑ mi.","poem":1},{"lineBreak":true},{"text":"A de ɑ nu siri mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ kɑɑ tɔmbu siri.","poem":1},{"lineBreak":true},{"text":"A mɑn sirio nɡe mɛ nɛn dɛɛrɑrɑ nɛ.","poem":1},{"lineBreak":true},{"text":"A mɑn nɛn ɡem wɛ̃ɛyɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A de tɔn kɔ̃sobun dɑɑ yu nɔru ko,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ de ɡemɡibu bu kuurɑ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ ɡemɡii.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ tɔnun ɡɔ̃run ɡɑri wɛ̃ɛri.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wunɑ ɑ rɑ mɑn ɡɑnɛ nɡe tɛrɛru.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ bèn ɡɔ̃ru ɡɑ dɛɛre fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wunɛ, ɑ rɑ siriwɑ dee dee.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ mɑɑ sɛ̃.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kɑ mɛ, tɔn kɔ̃so u ku rɑ win dɑɑ deri.","poem":1},{"lineBreak":true},{"text":"U rɑ win tɑkobi nɔɔ dɛrewɑ.","poem":1},{"lineBreak":true},{"text":"U rɑ win tɛndu bɛriwɑ.","poem":1},{"lineBreak":true},{"text":"U win sɛ̃u sɔre u yĩisi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"U tɑbu yɑ̃ɑ ɡɔɔɡinu kuɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ u sɛ̃ɛ dɔ̃ɔɡinu kuɑ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"U win sɔmburu seewɑ.","poem":1},{"lineBreak":true},{"text":"U kɔ̃sɑ bwisikumɔ. U weesu wĩimɔ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"U suurɑ ɡbɑ ɡɑbun sɔ̃,","poem":1},{"lineBreak":true},{"text":"ɑdɑmɑ win tiiwɑ u koo ye wɔri.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɔ̃sɑ ye u rɑɑ kuɑ kpuro,","poem":1},{"lineBreak":true},{"text":"win wirɔwɑ yɑ koo wɔri.","poem":1},{"lineBreak":true},{"text":"Win dɑmɡii te u rɑɑ dɔrɑmɔ,","poem":1},{"lineBreak":true},{"text":"win wirɑ tɑ koo kɔrɑ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, kon nun siɑrɑ,","poem":1},{"lineBreak":true},{"text":"domi ɑ sɑ̃ɑ nɑɑnɛɡii.","poem":1},{"lineBreak":true},{"text":"Yinni Wɔrukoo, kon nun tɔmɑ kɑ womu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}