{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u kuɑ u kɑ Gusunɔ yɑɑyɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ nɑ fuuku ɑ mɑn wɔrɑ.","poem":1},{"lineBreak":true},{"text":"A ku tɛ ɑ kɑ mɑn fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A de be bɑ kɑsu bu mɑn ɡo bu burisinɑ kpɑ bu sekuru wɑ.","poem":1},{"lineBreak":true},{"text":"A de be bɑ kɑsu n kɑm ko bu sekuru wɑ kpɑ bu biruku yirɑ wurɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A de be bɑ mɑn yɛ̃ɛmɔ mi, bu biru wurɑ seku ten sɔ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A de be bɑ nun kɑsu bɑ n wɑ̃ɑ nuku dobu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Kpɑ bɑ n yɛ̃ɛrimɔ wunɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"A de be bɑ mɑɑ wunɛn fɑɑbɑ kĩ bɑ n kpɑrɑmɔ sɑɑ kpuro mɑ ɑ kpɑ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gusunɔ, nɑ sɑ̃ɑwɑ sɑ̃ɑro kɑ wɔnwɔndo.","poem":1},{"lineBreak":true},{"text":"Yen sɔ̃, ɑ nɑ nɛn bɔkuɔ fuuku.","poem":1},{"lineBreak":true},{"text":"Domi wunɑ ɑ rɑ mɑn somi kpɑ ɑ mɑn wɔrɑ.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ ku tɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}