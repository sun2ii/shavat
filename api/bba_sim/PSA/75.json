{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":["Womu ɡe Asɑfu u wom kowobun wiruɡii kuɑ ɡe bɑ mɔ̀, ɑ ku kɑm koosiɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, sɑ nun siɑrɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn yĩsiru tɑ yibɑ bɛsɛn nɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"Sɑ wunɛn sɔm ɡeerun ɡɑri kpɑrɑmɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wunɛ, Yinni Gusunɔ, ɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"sɑɑ ye ɑ yi yɑ̀ n tunumɑ, kɑɑ tɔmbu siri ɡem sɔɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tem mu koo kpĩ mu yĩiri kɑ ye yɑ wɑ̃ɑ mɛ sɔɔ.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ wunɑ ɑ yen ɡberebɑ nɛni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A nɛɛ, be bɑ tii sue bu ku mɑɑ tii suɑ.","poem":1},{"lineBreak":true},{"text":"A mɑɑ tɔn kɔ̃sobu sɔ̃ɔmɔ bu tii suɑbu derio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu ku tii wɔlle suɑ, kpɑ bu tɔn biɑ ɡɑri de.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Domi wɔlle suɑbu kun wee sɑɑ sɔ̃ɔ yɑri yerun di,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ sɔ̃ɔ duu yerun di,","poem":1},{"lineBreak":true},{"text":"bu ǹ mɑɑ wee sɔ̃ɔ yɛ̃sɑn nɔm dwɑru ɡiɑn di.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wunɛ Gusunɔwɑ ɑ rɑ tɔmbu siri.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ rɑ ɡɑbu kɑwe kpɑ ɑ ɡɑbu wɔlle suɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ nɔrɑ","poem":1},{"noteId":2},{"text":"nɛni yɑ tɑm yibɑ mu ɡbisimɔ,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ mu hɑnduniɑn tɔn kɔ̃sobu wɛ̃ɛmɔ.","poem":1},{"lineBreak":true},{"text":"Bɑ koo mu nɔwɑ mɑm mɑm sere kɑ mɛn kɔtɔrɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Adɑmɑ nɛ, nɑ ǹ nɔɔ mɑrimɔ.","poem":1},{"lineBreak":true},{"text":"Kon Gusunɔ Yɑkɔbun Yinni tɔmɑwɑ kɑ womusu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"U koo tɔn kɔ̃sobun tii suɑbu kpeerɑsiɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ u be bɑ nùn mɛm nɔɔwɑmmɛ kuurɑsiɑ.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"nɔrɑ - Nɔrɑ ye bɑ kɑ yɑ̃ mini yɑ sɑ̃ɑwɑ Gusunɔn mɔru ye u koo kɑ tɔn kɔ̃sobu siri.","reference":{"chapter":75,"verse":9}}]},"thisChapterLink":"/api/bba_sim/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}