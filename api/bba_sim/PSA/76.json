{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":["Womu ɡe Asɑfu u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Bɑ Gusunɔ tubɑ Yudɑɔ,","poem":1},{"lineBreak":true},{"text":"mɑ u yĩsiru yɑrɑ Isireliɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Win wɑ̃ɑ yerɑ wɑ̃ɑwɑ Sɑlɛmuɔ ye bɑ mɔ̀ Siɔni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miyɑ u tɑbu yɑ̃nu bɔɔkɑ.","poem":1},{"lineBreak":true},{"text":"Niyɑ, sɛ̃ɛnu kɑ tɛrɛnu kɑ tɑkobibɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sɑ̃ɑwɑ wi bɑ koo nɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn nɑnum mu kpɑ̃ mu kere ɡuu ni nu wɑ̃ɑ sɑɑ yellun di.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɑ tɑbu durɔ wɔruɡɔbɑn yɑ̃nu potirɑ.","poem":1},{"lineBreak":true},{"text":"Wee bɑ kpunɑ bɑ ɡu.","poem":1},{"lineBreak":true},{"text":"Bɑ kpɑnɑ bu kɑ tii yinɑ be, be bɑ rɑɑ dɑm mɔ mi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gusunɔ Yɑkɔbun Yinni, ye ɑ ɡbɑ̃rɑ,","poem":1},{"lineBreak":true},{"text":"yerɑ mɑɑsɔbɑ wɔrukɑ kɑ ben dumi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ, wunɑ bɑ koo nɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Wunɛn mɔru yɑ̀ n seewɑ wɑrɑ u koo kpĩ u yɔ̃rɑ wunɛn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wunɛn siribu nɔɔrɑ sɑɑ wɔllun di.","poem":1},{"lineBreak":true},{"text":"Sɑnɑm mɛ ɑ seewɑ ɑ tɔmbu siri,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ be bɑ tii kɑwe fɑɑbɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"yerɑ hɑnduniɑn tɔmbu kpuro bɑ bɛrum soorɑ mɑ bɑ tii deri sɛ̃ɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɑɑ tɔnun mɔru yɑ̀ n seewɑ, wunɛn yiikowɑ yɑ koo sɔ̃ɔsirɑ.","poem":1},{"lineBreak":true},{"text":"Be bɑ mɑɑ yɑrɑ wunɛn mɔrun di, bɑ koo yen tɔ̃ɔ bɑkɑru diwɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I Gusunɔ bɛɛn Yinni nɔɔ mwɛɛnu kuo kpɑ i nu yibiɑ.","poem":1},{"lineBreak":true},{"text":"Bɛɛ be i kɑ nùn sikerenɛ i nùn nɑsie, i kɑ nùn kɛ̃nu nɑɑwɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wiyɑ u rɑ sinɑm be bɑ tii sue kɑwe.","poem":1},{"lineBreak":true},{"text":"Sinɑmbu kpuro bɑ nùn nɑsie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}