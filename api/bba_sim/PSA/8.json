{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Dɑfidin womu ɡe u wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ bɛsɛn Yinni,","poem":1},{"lineBreak":true},{"text":"wunɛn yĩsirɑ kpɑ̃ hɑnduniɑ kpuro sɔɔ,","poem":1},{"lineBreak":true},{"text":"nɑ nun tɔmɑmɔ wunɛn kpɑ̃ɑrun sɔ̃","poem":1},{"lineBreak":true},{"text":"te tɑ wɔllu ɡunum kere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɑɑ bii piiminu kɑ bii wɛ̃ɛnu nu nun siɑrɑmɔ kɑ womusu.","poem":1},{"lineBreak":true},{"text":"Nin womu si, su kuɑ nɡe ɡbɑ̃rɑru.","poem":1},{"lineBreak":true},{"text":"Tɑ wunɛn yibɛrɛbɑ ɡɑnuɑ,","poem":1},{"lineBreak":true},{"text":"ɑ kɑ be bɑ nun seesimɔ kɑmiɑ,","poem":1},{"lineBreak":true},{"text":"ɑ kɑ be bɑ mɔru kɔsiɑmɔ kɑmiɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɑ wɔllun kpɑ̃ɑru mɛɛrɑ te ɑ kuɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ suru kɑ kperi wɑ yi wɑ̃ɑ yin ɑyenɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɑ nɑ bwisikɑ nɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"mbɑ tɔnu u sɑ̃ɑ ɑ n sere kɑ nùn yɑɑye,","poem":1},{"lineBreak":true},{"text":"wɑrɑ rɑ n tɔnu ɑ n sere kɑ nùn nɔɔrimɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wee, ɑ nùn tɑkɑ kuɑ u kɑ nun ɡɛrɛrɛm dɑ.","poem":1},{"lineBreak":true},{"text":"Wee, ɑ nùn yiiko kɑ bɛɛrɛ wɛ̃ nɡe sunɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wee, ɑ nùn kuɑ wiruɡii tɑkɑ koorɑ kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u kpɑɑku yɛɛ nɔmɑ sikerenɛ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ɡbeeku yɛɛ nɔmɑ sikerenɛ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ɡunɔsu nɔmɑ sikerenɛ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u swɛ̃ɛ nɔmɑ sikerenɛ,","poem":1},{"lineBreak":true},{"text":"kɑ hunde konibɑ kpuro nim sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinni, wunɛn yĩsirɑ kpɑ̃","poem":1},{"lineBreak":true},{"text":"hɑnduniɑ kpuro sɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":8}