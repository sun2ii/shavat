{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":["Womu ɡe Asɑfu u wom kowobun wiruɡii kuɑ kɑ mɔrɔku. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔwɑ u sɑ̃ɑ bɛsɛn dɑm.","poem":1},{"lineBreak":true},{"text":"I nùn womu kuo kɑ nuku dobu.","poem":1},{"lineBreak":true},{"text":"I Gusunɔ Yɑkɔbun Yinni tɑkɑru koowo kɑ nuku dobu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I womusu koowo.","poem":1},{"lineBreak":true},{"text":"I ɡɑ̃ɑsu kɑ mɔrɔkunu kɑ ɡɔ̃ɔɡenu soowo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kɔbɑ soowo suru kpɑon tɔ̃ɔ bɑkɑru sɔɔ.","poem":1},{"lineBreak":true},{"text":"I kɔbɑ wureo Kunun tɔ̃ɔ bɑkɑru sɔɔ suru ù n tɑrum kuɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi woodɑ yerɑ Yɑkɔbun Yinni u Isirelibɑ wɛ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Woodɑ yerɑ u Yosɛfun yɛnuɡibu wɛ̃","poem":1},{"lineBreak":true},{"text":"sɑnɑm mɛ u Eɡibiti wɔri.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ nɔɔ ɡɑɡu nuɑ ɡe nɑ ǹ tubɑ. Gɑ nɛɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nɑ bɛɛ sɔmunu swɛnyɑ bɛɛn senun di,","poem":1},{"lineBreak":true},{"text":"nɑ derɑ i yoo sɔmɑ deri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɑnɑm mɛ i wɑ̃ɑ nɔni swɑ̃ɑru sɔɔ,","poem":1},{"lineBreak":true},{"text":"i mɑn sokɑ, mɑ nɑ bɛɛ yɑkiɑ.","poem":1},{"lineBreak":true},{"text":"Nɑ bɛɛ wisɑ ɡuru mɑɑkinu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ bɛɛn lɑɑkɑri mɛɛrɑ Mɛribɑn bwiɑɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛɛ nɛn tɔmbu Isirelibɑ,","poem":1},{"lineBreak":true},{"text":"i mɑn swɑɑ dɑkio i nɔ ye kon bɛɛ sɔ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I ku de bũu ɡoo u n mɑɑ wɑ̃ɑ bɛɛn suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"I ku mɑɑ nu yiirɑ i sɑ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛnɑ Gusunɔ bɛɛn Yinni wi u bɛɛ yɑrɑ Eɡibitin di.","poem":1},{"lineBreak":true},{"text":"I bɛɛn nɔɔ wukio kpɑ n bɛɛ diisiɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɛɛ nɛn tɔmbu, i ǹ mɑn swɑɑ dɑki,","poem":1},{"lineBreak":true},{"text":"i ǹ mɑɑ mɑn mɛm nɔɔwɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɑ derɑ i wɔri bɛɛn ɡɔ̃ru bɔbunu sɔɔ,","poem":1},{"lineBreak":true},{"text":"mɑ i bɛɛn tiin bwisi swĩi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bɛɛ nɛn tɔmbu, ì n dɑɑ mɑn swɑɑ dɑki i sĩimɔ nɛn swɑɑ sɔɔ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kon dɑɑ bɛɛn yibɛrɛbɑ sekuru doke,","poem":1},{"lineBreak":true},{"text":"kpɑ n bu nɑɑ swĩi n ɡo ɡo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sɑɑ ye sɔɔrɑ nɛ, Yinni Gusunɔn yibɛrɛbɑn tii suɑbu koo nɔru ko,","poem":1},{"lineBreak":true},{"text":"kpɑ Isirelibɑn doo nɔɔru tu tɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kon bu dĩɑ ɡeenu wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ bu kperun tim ɡem di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}