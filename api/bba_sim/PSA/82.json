{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":["Womu ɡe Asɑfu u kuɑ. Ge wee.",{"text":"Gusunɔ u wɑ̃ɑ wɔllun tɔmbun suunu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Miyɑ u wɑ̃ɑ u kɑ sirimɔ. U nɛɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sere sɑɑ yerɑ̀ i ko i n wɑ̃ɑ i n sirimɔ kɑ weesu,","poem":1},{"lineBreak":true},{"text":"i n yɔ̃ tɑɑrɛɡibun biruɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I dɑm sɑriruɡibu kɑ ɡobekubɑ ben ɡem wɛ̃ɛyɔ.","poem":1},{"lineBreak":true},{"text":"I wɔnwɔndobu kɑ sɑ̃ɑrobu ben ɡem wɛ̃ɛyɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I dɑm sɑriruɡibu kɑ be bɑ dɑm dɔremɔ fɑɑbɑ koowo.","poem":1},{"lineBreak":true},{"text":"I bu wɔro tɔn kɔ̃sobun nɔmɑn di.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ bɛɛ, i ǹ ɡɑ̃ɑnu ɡɑnu yɛ̃.","poem":1},{"lineBreak":true},{"text":"I ǹ mɑɑ bwisi ɡɛɛ mɔ. I kom kɔ̃sum mɔ̀wɑ,","poem":1},{"lineBreak":true},{"text":"mɑ yɑ derɑ ɡem mu doonɑ hɑnduniɑn di.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɑ rɑɑ nɛɛ, i sɑ̃ɑwɑ wɔllun tɔmbu.","poem":1},{"lineBreak":true},{"text":"I sɑ̃ɑwɑ Wɔrukoon bibu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adɑmɑ i ko i ɡbiwɑ nɡe tɔn dirobu.","poem":1},{"lineBreak":true},{"text":"I ko i ɡbiwɑ nɡe sinɑmbu kpuro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ, ɑ seewo ɑ hɑnduniɑ siri.","poem":1},{"lineBreak":true},{"text":"Domi wunɑ ɑ bwesenu kpuro mɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}