{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":["Womu ɡe Asɑfu u kuɑ. U nɛɛ,"]},{"type":"verse","number":2,"content":[{"text":"Gusunɔ, ɑ ku mɑri, ɑ ku mɑɑ wɛ̃rɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi wee wunɛn yibɛrɛbɑ bɑ seewɑ,","poem":1},{"lineBreak":true},{"text":"be, be bɑ nun tusɑ bɑ wiru yɔ̃rɑsie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wee bɑ kɔ̃sɑ wesiɑnɑmɔ wunɛn tɔmbun sɔ̃.","poem":1},{"lineBreak":true},{"text":"Bɑ nɔɔ tiɑ mɔ̀ be ɑ kɔ̃sun sɔ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɑ ɡerumɔ bɑ mɔ̀,","poem":1},{"lineBreak":true},{"text":"bu nɑ bu sun kpeerɑsiɑ bwesenu kpuron suunu sɔɔn di,","poem":1},{"lineBreak":true},{"text":"kpɑ bu ku mɑɑ bɛsɛ Isirelibɑn yĩsiru yɑɑyɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wee bɑ wesiɑnɑ,","poem":1},{"lineBreak":true},{"text":"mɑ be kpuro bɑ nɔɔ tiɑ kuɑ bu kɑ nun wɔri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beyɑ, Edɔmubɑ kɑ Isimɛɛlibɑ kɑ Mɔɑbubɑ kɑ Aɡɑribɑ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kɑ Gebɑlibɑ kɑ Amɔnibɑ kɑ Amɑlɛkibɑ","poem":1},{"lineBreak":true},{"text":"kɑ Filisitibɑ kɑ sere Tiriɡibu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asiriɡibun tii bɑ nɑ bɑ kɑ bu nɔɔ tiɑ kuɑ,","poem":1},{"lineBreak":true},{"text":"bɑ Lɔtun bibun bweseru, Amɔnibɑ kɑ Mɔɑbubɑ nɔmɑ kɑ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ bu kuo nɡe mɛ bɑ Siserɑ kɑ Yɑbini kɑ Mɑdiɑnibɑ kuɑ Kisionin dɑɑrɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɑ bu kpeerɑsiɑwɑ Eni Doriɔ,","poem":1},{"lineBreak":true},{"text":"mɑ bɑ ben ɡonu deri mi, nu tem kɔ̃sisiɑ nɡe nɑɑ bisu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A de ben sinɑmbu bu ɡbi nɡe sinɑm beni,","poem":1},{"lineBreak":true},{"text":"Orɛbu kɑ Seebu kɑ Sebɑ kɑ Sɑlumunɑ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"be, be bɑ rɑɑ ɡerunɑ bɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"bu dɑ bu Gusunɔn ɑrumɑni ɡurɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ bu suo ɑ kɑ doonɑ","poem":1},{"lineBreak":true},{"text":"nɡe mɛ woo ɡunɑ yɑ rɑ kɑ yɑkɑsu doonɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A de bu dɔ̃ɔ mwɑɑrɑ nɡe mɛ dɔ̃ɔ u rɑ dɑ̃ɑ sɔ̃ɔ mwɛ,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ nɡe mɛ dɔ̃ɔ yɑrɑ yɑ rɑ ɡuunu dɑbiri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A bu nɑɑ ɡiro kɑ ɡuru woo bɔkɔ.","poem":1},{"lineBreak":true},{"text":"A bu nɑndɑsio kɑ woo ɡunɑ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ bu sekuru dokeo,","poem":1},{"lineBreak":true},{"text":"kpɑ bu wɑ bu ɡɔsirɑmɑ wunɛn mi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A de bu sekuru wɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n nɑnde sere kɑ bɑɑdommɑɔ.","poem":1},{"lineBreak":true},{"text":"A ben yĩiyɔbu wunɔ, kpɑ bu kɑm ko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kpɑ bu ɡiɑ mɑ wunɛ turowɑ ɑ sɑ̃ɑ Yinni Wɔrukoo hɑnduniɑ ye sɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}