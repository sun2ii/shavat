{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":["Womu ɡe Koren bibu bɑ wom kowobun wiruɡii kuɑ. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yinni Gusunɔ, ɑ wunɛn tem durom kuɑ.","poem":1},{"lineBreak":true},{"text":"Wee ɑ kɑ bɛsɛ Isireli be sɑ sɑ̃ɑ Yɑkɔbun bweseru wurɑmɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A bɛsɛ wunɛn tɔmbun torɑnu wɔkɑ.","poem":1},{"lineBreak":true},{"text":"A bɛsɛn durum kpuro wukiri.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ǹ mɑɑ kɑ sun mɔru sɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"A derɑ wunɛn mɔru kpuro yɑ sure.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn fɑɑbɑ kowo, ɑ sun wesio nɡe yellu.","poem":1},{"lineBreak":true},{"text":"A ku mɑɑ kɑ sun mɔru ko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɡe kɑɑ n kɑ sun mɔru sɑ̃ɑwɑ sere kɑ bɑɑdommɑɔ?","poem":1},{"lineBreak":true},{"text":"Nɡe kɑɑ n mɔru sɑ̃ɑwɑ sere kɑ bɛsɛn bibun bibu sɔɔ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A ǹ sun wɑ̃ɑru wesiɑmɔ","poem":1},{"lineBreak":true},{"text":"kpɑ bɛsɛ wunɛn tɔmbu su wɑ su nuku dobu ko wunɛn sɔ̃?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ɑ sun wunɛn durom sɔ̃ɔsio","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ sun fɑɑbɑ ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, kon swɑɑ dɑki n nɔ ye ɑ ɡerumɔ.","poem":1},{"lineBreak":true},{"text":"Domi bɔri yɛndun ɡɑriyɑ ɑ rɑ n wunɛn tɔmbu sɔ̃ɔmɔ","poem":1},{"lineBreak":true},{"text":"be bɑ nun nɑɑnɛ sɑ̃ɑ","poem":1},{"lineBreak":true},{"text":"mɑ bɑ kun wure wiirɑ ɡɑri sɔɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Be bɑ nun nɑsiewɑ ɑ rɑ fɑɑbɑ ko.","poem":1},{"lineBreak":true},{"text":"Kpɑ ɑ de bɛɛrɛ yɑ n wɑ̃ɑ bɛsɛn tem sɔɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɔn ɡeeru kɑ bɔrɔkinirɑ koo wurɑmɑ","poem":1},{"lineBreak":true},{"text":"kpɑ ɡem kɑ bɔri yɛndɑ n wɑ̃ɑ tem mɛ sɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɔrɔkiniru tɑ koo se tem mɛ sɔɔ nɡe dĩɑ bwese te bɑ duurɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɡem mu sɑrɑmɑ wɔllun di.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔn tiiwɑ u koo sun bɔri yɛndu wɛ̃,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛsɛn tem mu binu mɑ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gemɑ mu ko n nùn ɡbiiye, kpɑ mu win swɑɑ sɔmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}