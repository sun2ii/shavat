{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["Womu ɡeniwɑ Koren bibu bɑ kuɑ. Bɑ nɛɛ,",{"text":"Yinni Gusunɔ u Yerusɑlɛmun kpɛɛkpɛɛku swĩiwɑ","poem":1},{"lineBreak":true},{"text":"ɡuu te win tii u ɡɔsɑ u dɛɛrɑsiɑn wɔllɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"U Yerusɑlɛmu ye kĩ n kere wuu si su wɑ̃ɑ Yɑkɔbun bweserun tem kpuro sɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yerusɑlɛmu, Gusunɔn wuu,","poem":1},{"lineBreak":true},{"text":"bɑ wunɛn bɛɛrɛ bɑkɑn ɡɑri ɡerumɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɛ, Yinni Gusunɔ, nɑ̀ n bwesenun yĩsinu yorumɔ ni nu mɑn yɛ̃,","poem":1},{"lineBreak":true},{"text":"kon Eɡibitiɡibu kɑ Bɑbiloniɡibu kɑ Filisitibɑ kɑ Tiriɡibu kɑ Etiopiɡibun yĩsinu yore.","poem":1},{"lineBreak":true},{"text":"Domi bɑ bu mɑrɑwɑ Yerusɑlɛmu mini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ Yerusɑlɛmuɡibu bɑ koo nɛɛ, ben temɑ mi kɑ ɡem.","poem":1},{"lineBreak":true},{"text":"Wɔrukoowɑ u mɛn kpɛɛkpɛɛku swĩi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u koo bwesenun yĩsinu yore kpɑ u nɛɛ,","poem":1},{"lineBreak":true},{"text":"Yerusɑlɛmuɔrɑ bɑ bu mɑrɑ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Be bɑ womusu mɔ̀ bɑ yɑɑmɔ, bɑ koo nɔɔɡiru suɑ bɑ n mɔ̀,","poem":1},{"lineBreak":true},{"text":"Yinni, bɛsɛn nuuru kpuro tɑ woowɑ wunɛn mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}