{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Wunɛ wi Wɔrukoo u kɔ̃su,","poem":1},{"lineBreak":true},{"text":"ɑ wɛ̃rewɑ Dɑm kpuroɡiin tɔbuɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kon Yinni Gusunɔ sɔ̃ mɑ wiyɑ nɛn kuku yeru kɑ nɛn kɑ̀rì.","poem":1},{"lineBreak":true},{"text":"Wiyɑ nɛn Yinni wi nɑ nɑɑnɛ sɑ̃ɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi wiyɑ u nun wɔrɑmɔ sɑɑ tɑɑn di.","poem":1},{"lineBreak":true},{"text":"Wiyɑ mɑɑ nun wɔrɑmɔ sɑɑ kɛ̃si kɛ̃si ɡɔɔ kɑ win wɑhɑlɑn di.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"U koo nun win sɑnsu wukiri.","poem":1},{"lineBreak":true},{"text":"Kɑɑ kuku yeru wɑ win kɑsɑn sɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"Win bɔrɔkinirɑ sɑ̃ɑwɑ nɡe tɛrɛru kɑ tɑrɑkpe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɔ̃kurun kɑri ǹ kun mɛ sɛ̃u ɡe ɡɑ wee sɔ̃ɔ sɔɔ,","poem":1},{"lineBreak":true},{"text":"yen ɡɑɑ kun nun bɛrum mɔ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ̃si kɛ̃si ɡɔɔ wi u bɔsu wɔ̃kuru,","poem":1},{"lineBreak":true},{"text":"ǹ kun mɛ bɑrɑ te tɑ tɔmbu ɡoomɔ sɔ̃ɔ sɔɔ ɡbɑ̃ɑrɑ,","poem":1},{"lineBreak":true},{"text":"yen ɡɑɑ kun nun bɛrum mɔ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɑɑ bɑrɑ ni, nù n tɔmbu nɔrɔbu (1.000) ɡo wunɛn bɔkuɔ,","poem":1},{"lineBreak":true},{"text":"mɑ nu tɔmbu nɔrɔbun subɑ wɔkuru (10.000) wɔri wunɛn nɔm ɡeuɔ,","poem":1},{"lineBreak":true},{"text":"ɡɑ̃ɑnu kun nun bɑbɑmɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɔniyɑ kɑɑ kɑ mɛɛri tɔnɑ kpɑ ɑ tɔn kɔ̃sobun ɑre wɑ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yèn sɔ̃ Yinni Gusunɔ u kuɑ wunɛn kuku yeru,","poem":1},{"lineBreak":true},{"text":"mɑ wi, Wɔrukoo u kuɑ wunɛn wɑ̃ɑ yeru,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yen sɔ̃nɑ nɔni swɑ̃ɑru ɡɑrɑ kun nun sisie,","poem":1},{"lineBreak":true},{"text":"bɑrɑru ɡɑrɑ kun mɑɑ wunɛn yɛnu susiɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Domi u koo win ɡɔrɑdobɑ nɔɔ kɛ̃ wunɛn sɔ̃,","poem":1},{"lineBreak":true},{"text":"bɑ n nun kɔ̃su wunɛn swɛɛ kpuro sɔɔ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"bu nun nɛnɛ kɑ ben nɔmɑ","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ ku rɑ kɑ wunɛn nɑɑsu kperu sokurɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kɑɑ ɡbee sunɔ kɑ surɔkɔru yɔ ɑ sɑrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ ɑ ɡbee sunɔ kpɛmu kɑ yɑɑ ɡɔbɑ tem tɑɑre.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u nɛɛ, yèn sɔ̃ u mɑn kĩ,","poem":1},{"lineBreak":true},{"text":"kon nùn yɑkiɑ kpɑ n nùn kɔ̃su domi u nɛn yĩsiru yɛ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ù n mɑn sokɑ kon nùn wurɑri.","poem":1},{"lineBreak":true},{"text":"Ko nɑ n wɑ̃ɑ kɑ wi nɔni swɑ̃ɑrun sɑɑ.","poem":1},{"lineBreak":true},{"text":"Kon nùn yɑkiɑ kpɑ n nùn bɛɛrɛ wɛ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kon de u tɔkɔru ko bɔri yɛndu sɔɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ n nùn nɛn fɑɑbɑ sɔ̃ɔsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}