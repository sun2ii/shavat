{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":["Womu ɡe bɑ kuɑ tɔ̃ɔ wɛ̃rɑruɡirun sɔ̃. Ge wee."]},{"type":"verse","number":2,"content":[{"text":"Yɑ rɑ n do bɑ n nun tɔmɑmɔ Yinni Gusunɔ,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n wunɛn yĩsiru bɛɛrɛ wɛ̃ɛmɔ, wunɛ Wɔrukoo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bɑ n wunɛn durom ɡɑri kpɑrɑmɔ bururu,","poem":1},{"lineBreak":true},{"text":"kpɑ bɑ n wunɛn bɔrɔkinirun ɡɑri kpɑrɑmɔ wɔ̃kuru","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kɑ mɔrɔku kɑ ɡɔ̃ɔɡeru.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, ye ɑ kuɑ yɑ mɑn nuku dobu wɛ̃.","poem":1},{"lineBreak":true},{"text":"Mɑ nɑ ye kpuro siɑrɑmɔ kɑ womusu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛn sɔmɑ ye ɑ kuɑ yɑ kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Wunɛn bwisikunu nu duku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gɑri bɔkɔ ɡɑ ǹ kpɛ̃ ɡu nu tubu,","poem":1},{"lineBreak":true},{"text":"mɛyɑ nu ǹ mɑɑ kpɛ̃ nu nùn yeeri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Geemɑ, tɔn kɔ̃sobu bɑ seemɔ nɡe yɑkɑsu,","poem":1},{"lineBreak":true},{"text":"mɑ nuku kɔ̃suruɡibu bɑ kpɑrɑmɔ nɡe dɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Kɑ mɛ, sɔ̃ɔ teeru bɑ koo bu kpeerɑsiɑ sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Adɑmɑ wunɛ Yinni Gusunɔ, wunɑ ɑ kpuro kere sere kɑ bɑɑdommɑɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wunɛn yibɛrɛbɑ kpuro bɑ koo kɑm ko.","poem":1},{"lineBreak":true},{"text":"Be bɑ kɔ̃sɑ mɔ̀ kpuro bɑ koo yɑrinɑ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A mɑn ɡbeeku kɛtɛn dɑm kɑ̃,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ mɑn domɑru kuɑ ɑ mɑn ɡum yɑrum tɑ̃re.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tɛ̃, nɑ wɑɑmɔ nɛn yibɛrɛbɑ bɑ wɔrukumɔ.","poem":1},{"lineBreak":true},{"text":"Nɑ nɔɔmɔ bɑ kuuki mɔ̀.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gemɡibu bɑ koo kpɛ̃ɑ nɡe kpɑkpɑ bɑ̃ɑ.","poem":1},{"lineBreak":true},{"text":"Bɑ koo se nɡe Libɑnin dɑ̃ɑ ye bɑ mɔ̀ sɛduru.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bɑ ko n sɑ̃ɑwɑ nɡe dɑ̃ɑ te bɑ ɡirɑ tɑ kpɑrɑmɔ","poem":1},{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinnin sɑ̃ɑ yerɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bɑɑ tɑ̀ n tɔkɔ kuɑ, tɑ ko n binu mɑrumɔwɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ tɑ n bɔrɔm mɔ tɑ n wurusu sɔɔwɑ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yeyɑ yɑ koo sɔ̃ɔsi mɑ Yinni Gusunɔ u sɑ̃ɑwɑ ɡemɡii.","poem":1},{"lineBreak":true},{"text":"U mɑɑ sɑ̃ɑwɑ nɛn kpee bɑɑ mi nɑ rɑ kuke.","poem":1},{"lineBreak":true},{"text":"Wi sɔɔ, durum ɡɑɑ sɑri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}