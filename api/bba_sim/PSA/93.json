{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ, ɑ bɑndu dii,","poem":1},{"lineBreak":true},{"text":"mɑ ɑ wunɛn yiiko sebuɑ nɡe yɑberu.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ dɑm sɛ̃ke nɡe kpɑkɑ.","poem":1},{"lineBreak":true},{"text":"A mɑɑ derɑ tem mu dɑm mɔ, mu ǹ yĩirimɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sɑɑ yee yellun diyɑ ɑ wunɛn bɑndu swĩi.","poem":1},{"lineBreak":true},{"text":"Sɑɑ yee yellun diyɑ ɑ wɑ̃ɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, dɑɑnu nu rɑ n nɔɔɡiru sue nu n wɔki,","poem":1},{"lineBreak":true},{"text":"kpɑ nu n kuuki mɔ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adɑmɑ wunɛ, ɑ dɑm mɔ ɑ ni kpuro kere.","poem":1},{"lineBreak":true},{"text":"A bɑndu dii wɔllɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɛn ɡɑri yi sɑ̃ɑwɑ ɡem.","poem":1},{"lineBreak":true},{"text":"Wunɛn sɑ̃ɑ yeru tɑ ko n sɑ̃ɑwɑ dɛɛrɑru sere kɑ bɑɑdommɑɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}