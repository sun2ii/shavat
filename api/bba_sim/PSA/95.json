{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"I nɑ su Yinni Gusunɔ womu kuɑ.","poem":1},{"lineBreak":true},{"text":"Su nùn nɔɔɡiru sue kɑ nuku dobu","poem":1},{"lineBreak":true},{"text":"wi, wi u sɑ̃ɑ fɑɑbɑ kowo dɑmɡii nɡe kpee bɑkɑru.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I de su dɑ win wuswɑɑɔ su nùn siɑrɑ.","poem":1},{"lineBreak":true},{"text":"Su nùn bɛɛrɛ wɛ̃ kɑ siɑrɑbun womusu kɑ nuku dobu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Domi u kpɑ̃.","poem":1},{"lineBreak":true},{"text":"U sɑ̃ɑ sinɑ boko wi u ye bɑ sɑ̃ɑmɔ kpuro kere.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Win nɔmɑ yɑ kpuro nɛni ye yɑ wɑ̃ɑ tem sɔɔwɔ.","poem":1},{"lineBreak":true},{"text":"Guunun wii kpiinu nu mɑɑ sɑ̃ɑ wiɡinu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nim wɔ̃ku ɡɑ sɑ̃ɑwɑ wiɡuu.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u ɡu kuɑ.","poem":1},{"lineBreak":true},{"text":"Win nɔmɑ yɑ mɑɑ tem kuɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nɑ su kpunɑ su tii kɑwɑ.","poem":1},{"lineBreak":true},{"text":"Su yiirɑ Yinni Gusunɔ bɛsɛn tɑkɑ kowon wuswɑɑɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Domi u sɑ̃ɑwɑ bɛsɛn Yinni.","poem":1},{"lineBreak":true},{"text":"Sɑ mɑɑ sɑ̃ɑ win tɔmbu be u kpɑre nɡe nɑɑ ɡɔ̃ɔ.","poem":1},{"lineBreak":true},{"text":"I de i win nɔɔ nɔ ɡisɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I ku de bɛɛn ɡɔ̃rusu su bɔbiɑ","poem":1},{"lineBreak":true},{"text":"nɡe mɛ bɛɛn bɑɑbɑbɑ bɑ kuɑ Mɛribɑɔ","poem":1},{"lineBreak":true},{"text":"kɑ mɑɑ dɔmɑ te bɑ wɑ̃ɑ Mɑsɑɔ ɡbɑburɔ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mi bɑ mɑn wɛ̃ɛrɑ,","poem":1},{"lineBreak":true},{"text":"bɑ nɛn lɑɑkɑri mɛɛrɑ bɑɑ mɛ bɑ nɛn sɔmɑ wɑɑre.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wɔ̃ɔ weeruwɑ nɑ bwese te bwɛ̃rɑ yɑrɑ,","poem":1},{"lineBreak":true},{"text":"mɑ nɑ nɛɛ, tɔn ben ɡɔ̃rusu kɑ mɑn tondɑ.","poem":1},{"lineBreak":true},{"text":"Bɑ yinɑ bu nɛn woodɑbɑ swĩi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yen sɔ̃nɑ nɑ mɔru kuɑ mɑ nɑ bɔ̃ruɑ nɑ nɛɛ,","poem":1},{"lineBreak":true},{"text":"bɑ ǹ sisi bu kɑ mɑn wɛ̃rɑ mi nɑ wɛ̃re.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}