{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ wom kpɔɔ kuo.","poem":1},{"lineBreak":true},{"text":"Bɛɛ hɑnduniɑɡibu, i nùn womu kuo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔ womu kuo.","poem":1},{"lineBreak":true},{"text":"I nùn bɛɛrɛ wɛ̃ɛyɔ.","poem":1},{"lineBreak":true},{"text":"I win fɑɑbɑn lɑbɑɑri kpɑro tɔ̃ɔ bɑɑtere.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bwesenu win yiikon fɑɑɡi kuo.","poem":1},{"lineBreak":true},{"text":"Kpɑ i win mɑɑmɑɑkin ɡɑri ɡere.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Domi wi, Yinni Gusunɔ u kpɑ̃.","poem":1},{"lineBreak":true},{"text":"Wiyɑ bɑ koo bɛɛrɛ wɛ̃. U bũnu kpuro dɑm kere.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Domi nu sɑ̃ɑwɑ kɑm dirum.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u wɔllu tɑkɑ kuɑ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yɑm bururɑm kɑ yiiko bɑkɑ yɑ rɑ n nùn wɑ̃ɑsi.","poem":1},{"lineBreak":true},{"text":"Dɑm kɑ ɡirimɑ yɑ wɑ̃ɑ win sɑ̃ɑ yerɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bwesenu kpuro, i nɑ i Yinni Gusunɔ bɛɛrɛ wɛ̃.","poem":1},{"lineBreak":true},{"text":"I nɑ i win dɑm kɑ win yiikon ɡɑri kpɑrɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔn yĩsiru bɛɛrɛ wɛ̃ɛyɔ.","poem":1},{"lineBreak":true},{"text":"I duo win sɑ̃ɑ yerɔ kɑ kɛ̃nu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I nɑ i nùn kpunɑ kɑ bɛɛn sɑ̃ɑ yɑ̃nu.","poem":1},{"lineBreak":true},{"text":"Bɛɛ hɑnduniɑɡibu kpuro, i diirio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I bwesenu kpuro sɔ̃ɔwɔ i nɛɛ, Yinni Gusunɔ u bɑndu di.","poem":1},{"lineBreak":true},{"text":"U tem swĩi mu dɑm mɔ, mu ǹ mɑɑ yĩirimɔ.","poem":1},{"lineBreak":true},{"text":"U rɑ tɔmbu siriwɑ dee dee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wɔllu tu nukuru doro. Tem mu yɛ̃ɛrio.","poem":1},{"lineBreak":true},{"text":"Nim wɔ̃ku kɑ ye yɑ wɑ̃ɑ ɡe sɔɔ kpuro yu kukirio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gberu kpɑɑnɛ yu nukuru doro kɑ ye yɑ wɑ̃ɑ ye sɔɔ kpuro.","poem":1},{"lineBreak":true},{"text":"Dɑ̃nu nu tɑki koowo Yinni Gusunɔn wuswɑɑɔ, domi u wee.","poem":1},{"lineBreak":true},{"text":"U wee u hɑnduniɑ siri, kpɑ u yen tɔmbu siriɑ dee dee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":12}