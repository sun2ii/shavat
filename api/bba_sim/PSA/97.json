{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ u bɑndu dii.","poem":1},{"lineBreak":true},{"text":"Tem mu nukuru doro.","poem":1},{"lineBreak":true},{"text":"Be bɑ wɑ̃ɑ n tomɑ bu yɛ̃ɛrio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Guru wii wuroru kɑ yɑm wɔ̃kurɑ rɑ n kɑ nùn sikerenɛwɑ.","poem":1},{"lineBreak":true},{"text":"Gem wɔllɔwɑ u win sinɑ ɡɔnɑ tɛrie.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɔ̃ɔwɑ u rɑ n nùn swɑɑ ɡbiiye.","poem":1},{"lineBreak":true},{"text":"Kpɑ u n win yibɛrɛbɑ mwɑɑmɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"U rɑ de ɡuru mɑɑkinu nu hɑnduniɑ yɑm bururɑsiɑ.","poem":1},{"lineBreak":true},{"text":"Tem mù n nu wɑ, mu rɑ diiriwɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guunu nu rɑ yɑndewɑ nɡe ɡum win wuswɑɑɔ,","poem":1},{"lineBreak":true},{"text":"wi, wi u sɑ̃ɑ tem kpuron Yinni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wɔllu tɑ win ɡem sɔ̃ɔsimɔ.","poem":1},{"lineBreak":true},{"text":"Mɑ bwesenu kpuro nu win yiiko wɑɑmɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Be bɑ bwɑ̃ɑrokunu sɑ̃ɑmɔ, bɑ koo sekuru wɑ.","poem":1},{"lineBreak":true},{"text":"Be bɑ bũnu siɑrɑmɔ, bɑ koo yɔ̃rɑ kɑ dukiri.","poem":1},{"lineBreak":true},{"text":"Bũnu kpuro nu koo yiirɑ win wuswɑɑɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ, Siɔniɡibu bɑ ye nuɑ mɑ bɑ nukuru dorɑ.","poem":1},{"lineBreak":true},{"text":"Yudɑbɑ bɑ nuku dobu mɔ̀ wunɛn siribun sɔ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi wunɑ ɑ kpɑ̃ɑru bo hɑnduniɑ kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ mɑɑ bũnu kpuro dɑm kere.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛɛ be i Yinni Gusunɔ kĩ, i kɔ̃sɑ tusio.","poem":1},{"lineBreak":true},{"text":"U rɑ be bɑ nùn nɑɑnɛ sɑ̃ɑ wɔre tɔn kɔ̃sobun nɔmɑn di.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yɑm bururɑm mu wɑ̃ɑwɑ ɡemɡiin sɔ̃.","poem":1},{"lineBreak":true},{"text":"Nuku dobu bu wɑ̃ɑwɑ bèn ɡɔ̃ru ɡɑ dɛɛren sɔ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɛɛ ɡemɡibu, i nuku dobu koowo Yinni Gusunɔn sɔ̃.","poem":1},{"lineBreak":true},{"text":"Kpɑ i win yĩsi dɛɛrɑ te wɔlle suɑ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}