{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"I Yinni Gusunɔ wom kpɔɔ kuo,","poem":1},{"lineBreak":true},{"text":"domi u sɔm mɑɑmɑɑkiɡinu kuɑ.","poem":1},{"lineBreak":true},{"text":"Win dɑm sɑɑbu u nɑsɑrɑ wɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u tɔmbu win fɑɑbɑn ɡɑri tubusiɑ.","poem":1},{"lineBreak":true},{"text":"U sɔ̃ɔsi mɑ u sɑ̃ɑ ɡemɡii.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"U win durom kɑ win bɔrɔkiniru yɑɑyɑ Isirelibɑn sɔ̃.","poem":1},{"lineBreak":true},{"text":"Hɑnduniɑn ɡoonu nnɛ kpuro sɔɔ bɑ win fɑɑbɑ ye wɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɛɛ hɑnduniɑɡibu kpuro, i nɔɔɡiru suo kɑ nuku dobu.","poem":1},{"lineBreak":true},{"text":"I nuku dobun kuuki koowo i kɑ nùn siɑrɑ i nùn tɔmɑ kɑ womusu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I nùn womusu kuo kɑ mɔrɔkunu.","poem":1},{"lineBreak":true},{"text":"I nùn tɔmɔ kɑ ɡɔ̃ɔɡenu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nùn womusu kuo kɑ kɔbi kɑ ɡuunu.","poem":1},{"lineBreak":true},{"text":"I tɑki koowo wi, sinɑ bokon wuswɑɑɔ kɑ nuku dobu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nim wɔ̃ku kɑ ye yɑ wɑ̃ɑ ɡe sɔɔ, yu nɔɔɡiru suo.","poem":1},{"lineBreak":true},{"text":"Tem kɑ ye yɑ wɑ̃ɑ mɛ sɔɔ, yu womu koowo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dɑɑ bɑkɑnu nu tɑki koowo.","poem":1},{"lineBreak":true},{"text":"Guunu nu nuku dobun kuuki koowo","poem":1},{"lineBreak":true},{"text":"sɑnnu sɑnnu Yinni Gusunɔn wuswɑɑɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Domi u wee u hɑnduniɑɡibu siri.","poem":1},{"lineBreak":true},{"text":"U koo bu siriwɑ ɡem sɔɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}