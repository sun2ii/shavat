{"translation":{"id":"bba_sim","name":"Bibeli Gusunɔn Gari","website":"https://ebible.org/Scriptures/details.php?id=bba","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bba","licenseNotes":null,"shortName":"SIM","englishName":"Bariba Bible","language":"bba","textDirection":"ltr","sha256":"d7480e6b1bfe11bb312a9453e220ec223ad76f365cd8256f33b2af91fb87df53","availableFormats":["json"],"listOfBooksApiLink":"/api/bba_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30587,"languageName":"Baatonum","languageEnglishName":"Baatonum"},"book":{"id":"PSA","translationId":"bba_sim","name":"Womusu","commonName":"Womusu","title":"WOMU SI BA GUSUNƆ KUA","order":19,"numberOfChapters":150,"sha256":"f6c41c19a4355d05dab28b15ffa15b12847657d6de2dc28a20d719a0dfa7112f","firstChapterNumber":1,"firstChapterApiLink":"/api/bba_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bba_sim/PSA/150.json","totalNumberOfVerses":2487},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yinni Gusunɔ u bɑndu dii mɑ tɔmbɑ diirimɔ.","poem":1},{"lineBreak":true},{"text":"U sɔ̃ wɔllun kɔ̃sobun suunu sɔɔ mɑ tem mu yĩirimɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u kpɑ̃ Siɔniɔ.","poem":1},{"lineBreak":true},{"text":"Wiyɑ u bwesenu kpuro mɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔn yĩsiru wɔlle suo.","poem":1},{"lineBreak":true},{"text":"Tɑ kpɑ̃, tɑ nɑnum mɔ. U dɛɛrewɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I Yinni Gusunɔn dɑm wɔlle suo.","poem":1},{"lineBreak":true},{"text":"Domi u sɑ̃ɑwɑ sinɑ boko wi u rɑ ɡem kɑ̃.","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔ, wunɑ ɑ sun sɔ̃ɔsi nɡe mɛ sɑ ko kɑ bɛsɛn wɑ̃ɑru diisinɑ.","poem":1},{"lineBreak":true},{"text":"Wunɑ ɑ Yɑkɔbun bweseru woodɑ wɛ̃ Isireliɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yinni Gusunɔ u dɛɛre.","poem":1},{"lineBreak":true},{"text":"I nùn wɔlle suo.","poem":1},{"lineBreak":true},{"text":"I nɑ i yiirɑ win sinɑ kitɑrun nuurɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɔwisi kɑ Aroni bɑ wɑ̃ɑwɑ win yɑ̃ku kowobu sɔɔ.","poem":1},{"lineBreak":true},{"text":"Sɑmuɛli u sɑ̃ɑwɑ be bɑ rɑ nùn sokun turo.","poem":1},{"lineBreak":true},{"text":"Be kpurowɑ bɑ nùn sokɑ mɑ u bu wurɑri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"U kɑ bu ɡɑri kuɑ sɑɑ ɡuru wii wurorun di.","poem":1},{"lineBreak":true},{"text":"Mɑ bɑ win woodɑbɑ mɛm nɔɔwɑ ye u bu wɛ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gusunɔ bɛsɛn Yinni, wunɑ ɑ bu wisɑ.","poem":1},{"lineBreak":true},{"text":"Mɑ ɑ kuɑ ben Yinni wi u rɑ bu torɑru suuru kue.","poem":1},{"lineBreak":true},{"text":"Adɑmɑ ɑ bu sɛɛyɑsiɑ ben kɔ̃sɑn sɔ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I Gusunɔ bɛsɛn Yinni siɑro.","poem":1},{"lineBreak":true},{"text":"I yiiro win ɡuu dɛɛrɑrɔ i nùn bɛɛrɛ wɛ̃.","poem":1},{"lineBreak":true},{"text":"Domi u sɑ̃ɑwɑ Dɛɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bba_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bba_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bba_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}