/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bbb_tbl/NUM/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bbb_tbl/NUM/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}