{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"ISA","translationId":"bel_jfc","name":"ІСАЯ","commonName":"ІСАЯ","title":"КНІГА ПРАРОКА ІСАІ","order":23,"numberOfChapters":66,"sha256":"7b30309083a3aca42306f47359510c4e91352d78f2c3944336e1b48531a72311","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bel_jfc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["І ты скажаш у той дзень: «Слаўлю Цябе, ГОСПАДЗЕ, бо Ты гневаўся на мяне, але гнеў Твой адвярнуўся [ад мяне], і Ты пацешыў мяне."]},{"type":"verse","number":2,"content":["Вось Бог — збаўленьне маё! Спадзяюся на Яго і ня буду баяцца, бо ГОСПАД, ГОСПАД — моц мая і песьня мая, Ён стаўся збаўленьнем маім»."]},{"type":"verse","number":3,"content":["І вы з радасьцю будзеце чэрпаць ваду з крыніцаў збаўленьня."]},{"type":"verse","number":4,"content":["І скажаце ў дзень гэты: «Слаўце ГОСПАДА! Клічце імя Ягонае! Абвяшчайце сярод народаў дзеяньні Ягоныя! Узгадвайце, якое ўзьвялічанае імя Ягонае!"]},{"type":"verse","number":5,"content":["Выслаўляйце ГОСПАДА, бо Ён зрабіў велічнае! Няхай гэта будзе вядома па ўсёй зямлі."]},{"type":"verse","number":6,"content":["Гамані і крычы з радасьці, жыхарка Сыёну, бо вялікі пасярод цябе Сьвяты Ізраіля!»"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}