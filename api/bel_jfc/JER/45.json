{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"JER","translationId":"bel_jfc","name":"ЯРЭМІЯ","commonName":"ЯРЭМІЯ","title":"КНІГА ПРАРОКА ЯРЭМІІ","order":24,"numberOfChapters":52,"sha256":"ec9d1d2326f716da2a39c2e2a9ff8818285c6175682f78fffa6f8b6d99459591","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bel_jfc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":["Слова, якое прамовіў Ярэмія прарок да Баруха, сына Нэрыі, калі ён запісаў словы гэтыя ў кнігу з вуснаў Ярэміі ў чацьвёртым годзе Егаякіма, сына Ёсіі, валадара Юды, кажучы:"]},{"type":"verse","number":2,"content":["«Гэта кажа ГОСПАД, Бог Ізраіля, да цябе, Барух."]},{"type":"verse","number":3,"content":["Ты кажаш: “Гора мне, бо ГОСПАД дадае смутку да болю майго. Я змучыўся ад уздыханьняў, не знаходжу супачыну!”"]},{"type":"verse","number":4,"content":["Так скажаш яму: “Гэта кажа ГОСПАД. Вось, Я руйную тое, што пабудаваў, а тое, што пасадзіў, вырываю, усю зямлю гэтую."]},{"type":"verse","number":5,"content":["А ты шукаеш для сябе вялікага? Не шукай! Бо вось, Я прыводжу ліха на кожнае цела, кажа ГОСПАД, а табе дам душу тваю як здабычу ў кожным месцы, куды ты пойдзеш”»."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}