{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":["Псальм падзякі. Усклікай ГОСПАДУ, уся зямля!"]},{"type":"verse","number":2,"content":["Служыце ГОСПАДУ з радасьцю, прыходзьце перад аблічча Ягонае з хвалою!"]},{"type":"verse","number":3,"content":["Ведайце, што ГОСПАД ёсьць Бог! Ён Сам нас зрабіў, і мы — Ягоныя, народ Ягоны і авечкі чарады Ягонай."]},{"type":"verse","number":4,"content":["Уваходзьце ў брамы Ягоныя з падзякай, у панадворкі Ягоныя — з праслаўленьнем! Слаўце Яго, дабраслаўляйце імя Ягонае!"]},{"type":"verse","number":5,"content":["Бо добры ёсьць ГОСПАД, на вякі міласэрнасьць Ягоная і з пакаленьня ў пакаленьне вернасьць Ягоная!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}