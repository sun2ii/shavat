{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. Да ГОСПАДА я клікаў у бядзе маёй, і Ён адказаў мне."]},{"type":"verse","number":2,"content":["ГОСПАДЗЕ, вызваль душу маю ад вуснаў хлусьлівых, ад языка здрадлівага."]},{"type":"verse","number":3,"content":["Што дасьць табе і якую карысьць прынясе язык здрадлівы?"]},{"type":"verse","number":4,"content":["Вострыя стрэлы волата і вугольле ядлоўцавае."]},{"type":"verse","number":5,"content":["Гора мне, што я жыву ў Мэшэха, што я пасяліўся каля намётаў Кедару!"]},{"type":"verse","number":6,"content":["Вельмі доўга душа мая жыла сярод тых, што ненавідзяць супакой."]},{"type":"verse","number":7,"content":["Я — [сам] супакой; але, як толькі прамоўлю, яны [пачынаюць] вайну."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/119.json","previousChapter