{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. Давіда. Узрадаваўся я, калі мне сказалі: «Хадзем у Дом ГОСПАДА!»"]},{"type":"verse","number":2,"content":["Вось, ногі нашыя стаяць у брамах тваіх, Ерусаліме!"]},{"type":"verse","number":3,"content":["Ерусаліме! Ты пабудаваны, як горад, які злучаны разам,"]},{"type":"verse","number":4,"content":["куды ўваходзяць калены, калены ГОСПАДА, як сьведчаньне для Ізраіля, каб славіць імя ГОСПАДА,"]},{"type":"verse","number":5,"content":["бо там стаяць пасады судовыя, пасады дому Давіда."]},{"type":"verse","number":6,"content":["Прасіце пра супакой для Ерусаліму! Няхай маюць даб­радзенства тыя, якія любяць цябе."]},{"type":"verse","number":7,"content":["Супакой няхай будзе ў мурах тваіх, дабрабыт — у палацах тваіх."]},{"type":"verse","number":8,"content":["Дзеля братоў маіх і бліжніх маіх кажу цяпер: «Супакой табе!»"]},{"type":"verse","number":9,"content":["Дзеля Дому ГОСПАДА, Бога нашага, буду шукаць дабра для цябе."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}