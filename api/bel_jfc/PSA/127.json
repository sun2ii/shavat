{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. Салямона. Калі ГОСПАД не збудуе дом, надарэмна цяжка працуюць будаўнікі; калі ГОСПАД не захоўвае горад, надарэмна чуваюць вартаўнікі."]},{"type":"verse","number":2,"content":["Надарэмна для вас рана ўставаць, позна сядзець і есьці хлеб у смутку, бо Свайму ўлюбёнаму Ён дае ў сьне."]},{"type":"verse","number":3,"content":["Вось, спадчына ад ГОСПАДА — дзеці, узнагарода Ягоная — плод чэрава."]},{"type":"verse","number":4,"content":["Быццам стрэлы ў руцэ магутнай, гэтак сыны маладыя."]},{"type":"verse","number":5,"content":["Шчасьлівы той чалавек, які напоўніў імі сагайдак свой. Ня будуць яны асаромленыя, калі з ворагамі ў браме будуць гаварыць."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/126.json","previousChapterAudioLinks":{},"numberOfV