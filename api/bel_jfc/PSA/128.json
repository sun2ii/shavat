{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. Шчасьлівы кожны, хто баіцца ГОС­ПАДА, хто ходзіць шляхамі Ягонымі."]},{"type":"verse","number":2,"content":["Ты будзеш працу рук тваіх есьці, ты шчасьлівы, і добра табе!"]},{"type":"verse","number":3,"content":["Жонка твая ў доме тваім будзе плодная, быццам лаза вінаградная; сыны твае — як галіны аліўкавыя, наўкола стала твайго."]},{"type":"verse","number":4,"content":["Вось, гэтак будзе дабраслаўлёны чалавек, які баіцца ГОСПАДА."]},{"type":"verse","number":5,"content":["І дабраславіць цябе ГОСПАД з Сыёну, і ты будзеш бачыць дабрабыт Ерусаліму ў-ва ўсе дні жыцьця твайго,"]},{"type":"verse","number":6,"content":["і будзеш бачыць сыноў ад сыноў тваіх. Супакой над Ізраілем!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/127.json","previousC