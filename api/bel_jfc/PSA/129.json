{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. Шмат уціскалі мяне з маладосьці маёй, — няхай скажа Ізраіль, —"]},{"type":"verse","number":2,"content":["шмат уціскалі мяне з маладосьці маёй, але мяне не перамаглі."]},{"type":"verse","number":3,"content":["На хрыбце маім аралі аратыя, праганяючы доўгія барозны свае."]},{"type":"verse","number":4,"content":["ГОСПАД праведны, Ён расьсек вяроўкі бязбожнікаў."]},{"type":"verse","number":5,"content":["Няхай будуць асаромленыя і адступяцца назад усе, што ненавідзяць Сыён!"]},{"type":"verse","number":6,"content":["Няхай будуць яны, як трава на даху, якая раней, чым вырвуць яе, засыхае,"]},{"type":"verse","number":7,"content":["і жнец не напоўніць ёю рукі сваёй, і вязальнік снапоў — жменяў сваіх."]},{"type":"verse","number":8,"content":["I ня скажа той, што міма праходзіць: «Дабраслаўленьне ГОСПАДА няхай будзе над вамі! Дабраслаўляем вас імем ГОСПАДА!»"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/P