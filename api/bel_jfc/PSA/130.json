{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":["Сьпеў узыходжаньня. З глыбіні я клічу Цябе, ГОСПАДЗЕ!"]},{"type":"verse","number":2,"content":["Госпадзе, пачуй голас мой! Няхай вушы Твае зважаюць на голас маленьня майго!"]},{"type":"verse","number":3,"content":["Калі Ты будзеш памятаць пра беззаконьні, ГОСПАДЗЕ, Госпадзе мой, хто ўстаіць?"]},{"type":"verse","number":4,"content":["Бо ў Цябе прабачэньне, каб мелі страх [перад Табою]."]},{"type":"verse","number":5,"content":["Спадзяюся на ГОСПАДА, спадзяецца душа мая, і ў слове Ягоным маю спадзяваньне."]},{"type":"verse","number":6,"content":["Душа мая [чакае на] Госпада больш, чым стораж раніцы, чым стораж раніцы."]},{"type":"verse","number":7,"content":["Спадзявайся, Ізраілю, на ГОСПАДА, бо ў ГОСПАДА міласэрнасьць і шчодрасьць збаўленьня,"]},{"type":"verse","number":8,"content":["і Ён выбавіць Ізраіль ад усіх беззаконьняў ягоных."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}