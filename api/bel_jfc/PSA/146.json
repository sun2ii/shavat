{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["Альлелюя! Хвалі, душа мая, ГОСПАДА!"]},{"type":"verse","number":2,"content":["Хваліць буду ГОСПАДА, пакуль жыву; выслаўляць буду Бога майго, пакуль існую."]},{"type":"verse","number":3,"content":["Не спадзявайцеся на магнатаў, на сына чалавечага, у якім няма выратаваньня!"]},{"type":"verse","number":4,"content":["Выйдзе дух з яго, і ён вернецца ў зямлю; у той самы дзень зьнікнуць і задумы ягоныя."]},{"type":"verse","number":5,"content":["Шчасьлівы той, у каго Бог Якуба — дапамога, у каго надзея на ГОСПАДА, Бога ягонага,"]},{"type":"verse","number":6,"content":["Які стварыў неба і зямлю, мора і ўсё, што ў ім, Які захоўвае праўду на вякі,"]},{"type":"verse","number":7,"content":["Які ўчыняе суд для пакрыўджаных, дае хлеба галодным. ГОСПАД разьвязвае зьвязаных,"]},{"type":"verse","number":8,"content":["ГОСПАД расплюшчвае [вочы] сьляпых, ГОСПАД падымае прыгнечаных, ГОСПАД любіць праведных."]},{"type":"verse","number":9,"content":["ГОСПАД захоўвае прыхадняў, дапамагае сіротам і ўдовам, але шлях бязбожнікаў блытае."]},{"type":"verse","number":10,"content":["Валадарыць ГОСПАД на вякі; Бог твой, Сыёне, — з пакаленьня ў пакаленьне! Альлелюя!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}