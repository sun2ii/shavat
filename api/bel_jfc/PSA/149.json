{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":["Альлелюя! Сьпявайце ГОС­ПАДУ новы сьпеў; хвала Яму ў царкве багабойных!"]},{"type":"verse","number":2,"content":["Весяліся, Ізраілю, у Творцы тваім; радуйцеся, сыны Сыёну, у Валадару вашым!"]},{"type":"verse","number":3,"content":["Хвалеце імя Ягонае карагодамі, на бубнах і на гусьлях выслаўляйце Яго!"]},{"type":"verse","number":4,"content":["Бо даспадобы ГОСПАДУ народ Ягоны; уцісканым Ён зьявіць збаўленьне."]},{"type":"verse","number":5,"content":["Будуць цешыцца багабойныя ў славе [Ягонай], будуць весяліцца на ложках сваіх."]},{"type":"verse","number":6,"content":["Праслаўленьне Богу няхай будзе ў вуснах іхніх, а меч двусечны — у руцэ іхняй,"]},{"type":"verse","number":7,"content":["каб зьдзейсьніць помсту над паганамі, кару над народамі,"]},{"type":"verse","number":8,"content":["каб вязаць валадароў іхніх ланцугамі, і шляхту іхнюю — кайданамі жалезнымі,"]},{"type":"verse","number":9,"content":["каб учыніць для іх суд, як напісана. Гэткая велічнасьць для ўсіх багабойных Ягоных! Альлелюя!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}