{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Псальм Давіда. ГОСПАД ёсьць Пастыр мой, ні ў чым ня буду мець нястачы!"]},{"type":"verse","number":2,"content":["На пашах зялёных Ён пасьвіць мяне, да водаў спакойных накіроўвае мяне."]},{"type":"verse","number":3,"content":["Ён аднаўляе душу маю, на сьцежкі праведнасьці вядзе мяне дзеля імя Свайго."]},{"type":"verse","number":4,"content":["Нават калі буду ісьці далінаю ценю сьмерці, ня буду баяцца ліха, бо Ты — са мною, кій Твой і падпора Твая, яны пацяшаюць мяне."]},{"type":"verse","number":5,"content":["Ты накрываеш перад абліччам маім стол насуперак тым, якія ўціскаюць мяне; галаву маю Ты памазаў алеем, і келіх мой да верху наліты."]},{"type":"verse","number":6,"content":["Толькі добрасьць і міласэр­насьць Твая будуць ісьці са мною ўсе дні жыцьця майго; і ў Доме ГОСПАДА буду жыць доўгія дні."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}