{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Псальм Давіда. Аддайце ГОСПАДУ, сыны Божыя, аддайце ГОСПАДУ славу і моц!"]},{"type":"verse","number":2,"content":["Аддайце ГОСПАДУ славу імя Ягонага, пакланіцеся ГОСПАДУ ў велічы сьвятасьці!"]},{"type":"verse","number":3,"content":["Голас ГОСПАДА над водамі; Бог славы загрымеў, ГОСПАД над водамі шматлікімі."]},{"type":"verse","number":4,"content":["Голас ГОСПАДА магутны, голас ГОСПАДА велічны."]},{"type":"verse","number":5,"content":["Голас ГОСПАДА крышыць кедры, ГОСПАД крышыць кедры Лібанскія,"]},{"type":"verse","number":6,"content":["і прымушае іх скакаць, быццам цялятаў, Лібан і Сірыён, як маладых аднарогаў."]},{"type":"verse","number":7,"content":["Голас ГОСПАДА выкрасае полымя агню."]},{"type":"verse","number":8,"content":["Голас ГОСПАДА ўстрасае пустыняй, ГОСПАД устрасае пустыняй Кадэш."]},{"type":"verse","number":9,"content":["Ад голасу ГОСПАДА лані зьлягаюць і лясы асыпаюцца, і ў сьвятыні Ягонай усё кажа: «Слава!»"]},{"type":"verse","number":10,"content":["Над патопам сядзеў ГОСПАД, і будзе сядзець ГОСПАД, як Валадар, на вякі!"]},{"type":"verse","number":11,"content":["ГОСПАД дасьць сілу народу Свайму, ГОСПАД дабраславіць народ Свой супакоем."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}