{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Псальм Давіда, калі ён уцякаў ад аблічча Абсалома, сына свайго."]},{"type":"verse","number":2,"content":["ГОСПАДЗЕ, як шматлікія сталі прыгнятальнікі мае! Шмат іх паўстае супраць мяне!"]},{"type":"verse","number":3,"content":["Шмат тых, якія кажуць пра душу маю: «Няма для яго збаўленьня ў Бога». (Сэлях)"]},{"type":"verse","number":4,"content":["Але Ты, ГОСПАДЗЕ, — шчыт для мяне, Ты — слава мая, і Ты падымаеш галаву маю."]},{"type":"verse","number":5,"content":["Голасам маім я клікаў да ГОСПАДА, і Ён адказаў мне з гары Сваёй сьвятой. (Сэлях)"]},{"type":"verse","number":6,"content":["Я лёг і заснуў, і абудзіўся, бо ГОСПАД падтрымлівае мяне."]},{"type":"verse","number":7,"content":["Не палохаюся я многіх тысячаў народу, што абступілі мяне наўкола."]},{"type":"verse","number":8,"content":["Паўстань, ГОСПАДЗЕ! Збаў мяне, Божа мой! Бо Ты даў ворагам маім па сківіцах, Ты скрышыў зубы бязбожнікаў."]},{"type":"verse","number":9,"content":["У ГОСПАДА збаўленьне і для народу Твайго дабраслаўленьне Тваё. (Сэлях)"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}