{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Судзі мяне, Божа, і барані мяне ў справе маёй супраць народу небагабойнага! Ад чалавека крывадушнага і беззаконнага збаў Ты мяне!"]},{"type":"verse","number":2,"content":["Бо Ты — Бог мой, апора мая. Чаму Ты пакінуў мяне? Чаму я ў суме хаджу ад уціску ворагаў?"]},{"type":"verse","number":3,"content":["Спашлі сьвятло Тваё і праўду Тваю, каб вялі мяне і прывялі на гару сьвятую Тваю і да сялібы Тваёй,"]},{"type":"verse","number":4,"content":["каб я прыйшоў да ахвярніка Божага, да Бога радасьці і пацяшэньня майго, і на гусьлях буду славіць Цябе, Божа, мой Божа!"]},{"type":"verse","number":5,"content":["Чаму ты сумуеш, душа мая? Чаму ў-ва мне ты трывожышся? Бо яшчэ будзеш славіць Яго, збаўленьне аблічча майго і Бога майго!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}