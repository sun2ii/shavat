{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["Кіраўніку хору. Сыноў Караха. Псальм."]},{"type":"verse","number":2,"content":["Усе народы, пляскайце рукамі, усклікайце Богу голасам радасьці!"]},{"type":"verse","number":3,"content":["Бо страшны ГОСПАД Найвышэйшы, Валадар вялікі над усёй зямлёю."]},{"type":"verse","number":4,"content":["Ён скарыў народы, і [кінуў] паганаў пад ногі нашыя."]},{"type":"verse","number":5,"content":["Ён выбраў для нас спадчыну нашую, гонар Якуба, якога Ён палюбіў. (Сэлях)"]},{"type":"verse","number":6,"content":["Узьняўся Бог з гукам гучным, ГОСПАД [узьняўся] пры голасе трубы."]},{"type":"verse","number":7,"content":["Выслаўляйце Бога, выслаўляйце! Выслаўляйце Валадара нашага, выслаўляйце!"]},{"type":"verse","number":8,"content":["Бо Валадар над усёй зямлёй — [гэта] Бог; выслаўляйце [Яго] з разуменьнем."]},{"type":"verse","number":9,"content":["Валадарыць Бог над усімі народамі; Бог сядзіць на пасадзе сьвятасьці Сваёй."]},{"type":"verse","number":10,"content":["Магнаты народаў сабраліся разам з народам Бога Абрагама, бо шчыты зямлі — Божыя; Ён высока ўзьняты."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}