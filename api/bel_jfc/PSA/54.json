{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Кіраўніку хору: на струнных інструмэнтах. Навучаньне Давіда,"]},{"type":"verse","number":2,"content":["калі прыйшлі Зіфеі і сказалі Саўлу: «Ці ж гэта не Давід схаваўся ў нас?»"]},{"type":"verse","number":3,"content":["Божа, імем Тваім збаў мяне, і магутнасьцю Тваёю вядзі справу маю!"]},{"type":"verse","number":4,"content":["Божа, пачуй малітву маю, прыхілі вуха да словаў вуснаў маіх!"]},{"type":"verse","number":5,"content":["Бо чужынцы паўсталі супраць мяне, і моцныя шукаюць душы маёй; яны ня маюць Бога перад сабою. (Сэлях)"]},{"type":"verse","number":6,"content":["Вось, Бог — дапамога мая; Госпад падтрымлівае душу маю."]},{"type":"verse","number":7,"content":["Зьвяртаючыся, зьвернецца ліха на ворагаў маіх. У праўдзе Тваёй Ты вынішчы іх!"]},{"type":"verse","number":8,"content":["Тады ахвотна буду скла­даць ахвяры Табе; буду славіць імя Тваё, ГОСПА­ДЗЕ, бо Ты — добры!"]},{"type":"verse","number":9,"content":["Бо Ты вызваліў мяне ад усіх трывогаў, і на [загубу] ворагаў маіх глядзелі вочы мае."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}