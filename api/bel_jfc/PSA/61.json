{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["Кіраўніку хору: на струнных інструмэнтах. Давіда."]},{"type":"verse","number":2,"content":["Пачуй, Божа, галашэньне маё, зваж на малітву маю!"]},{"type":"verse","number":3,"content":["Ад краю зямлі да Цябе клічу, калі зьнемагае сэрца маё; на скалу, што ўзвышаецца нада мною, узьвядзі мяне!"]},{"type":"verse","number":4,"content":["Бо Ты быў прыстанішчам маім, вежай моцы маёй супраць ворага."]},{"type":"verse","number":5,"content":["Буду жыць у намёце Тваім вечна, маю надзею пад заслонаю крылаў Тваіх. (Сэлях)"]},{"type":"verse","number":6,"content":["Бо Ты, Божа, чуў абяцаньні мае, Ты даў валоданьне тым, што баяцца імя Твайго."]},{"type":"verse","number":7,"content":["Дадай дні да дзён валадара, няхай гады яго [будуць] з пакаленьня ў пакаленьне,"]},{"type":"verse","number":8,"content":["Няхай жыве вечна перад абліччам Божым; прызнач міласэрнасьць і праўду, каб захоўвалі яго!"]},{"type":"verse","number":9,"content":["Дык буду выслаўляць імя Тваё на вякі, буду спаўняць абяцаньні мае кожны дзень."]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}