{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["Сыноў Караха. Псальм. Сьпеў. Угрунтаваньне ягонае на гарах сьвятых."]},{"type":"verse","number":2,"content":["Любіць ГОСПАД брамы Сыёну больш за ўсе іншыя сялібы Якуба."]},{"type":"verse","number":3,"content":["Слаўныя [рэчы] сказаныя пра цябе, горад Божы! (Сэлях)"]},{"type":"verse","number":4,"content":["Узгадаю пра Рагаў і Бабілон перад тымі, што ведаюць мяне. Вось, Філістына і Тыр разам з Кушам [скажуць]: «Гэты нарадзіўся там»."]},{"type":"verse","number":5,"content":["А пра Сыён будуць казаць: «Той чалавек і той чалавек нарадзіўся ў ім, і Найвышэйшы ўзмацняе яго»."]},{"type":"verse","number":6,"content":["ГОСПАД палічыць, запісваючы народы: «Гэты нарадзіўся там». (Сэлях)"]},{"type":"verse","number":7,"content":["І тыя, што сьпяваюць, і тыя, што таньчаць, [скажуць]: «Усе крыніцы мае ў Табе!»"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}