{"translation":{"id":"bel_jfc","name":"Біблія (пераклад А.Бокуна)","website":"https://ebible.org/Scriptures/details.php?id=bel","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bel","licenseNotes":null,"shortName":"JFC","englishName":"Belarusan Bible, A. Boken","language":"bel","textDirection":"ltr","sha256":"c5584fc20529cd84dca566d8400accd94d77d9b394093e5fd93b3422adbcecd4","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_jfc/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31170,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_jfc","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"d47679e6963e82dcd802a440c96cb5822d0901b13bef216d5cad0a37994040a2","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_jfc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_jfc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["ГОСПАД валадарыць, апрануўся ў веліч, апрануўся ГОСПАД у моц і падперазаўся. Ён сусьвет умацаваў, што не захістаецца."]},{"type":"verse","number":2,"content":["Умацаваны пасад Твой спрадвеку; і Ты — спакон вякоў!"]},{"type":"verse","number":3,"content":["Узьнімаюць рэкі, ГОСПАДЗЕ, узьнімаюць рэкі голас свой, узьнімаюць рэкі хвалі свае."]},{"type":"verse","number":4,"content":["Слаўнейшы за голас водаў вялікіх, за хвалі марскія — слаўны на вышынях ГОСПАД."]},{"type":"verse","number":5,"content":["Сьведчаньні Твае вельмі верныя; сьвятасьць аздабляе Дом Твой, ГОСПАДЗЕ, на вечныя дні!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_jfc/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_jfc/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_jfc/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}