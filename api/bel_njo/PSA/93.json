{"translation":{"id":"bel_njo","name":"Новы Запавет і Кнігі Старога Запавету","website":"https://ebible.org/Scriptures/details.php?id=beln","licenseUrl":"https://ebible.org/Scriptures/details.php?id=beln","licenseNotes":null,"shortName":"NJO","englishName":"Belarusian New Testament and Books of Old Testament","language":"bel","textDirection":"ltr","sha256":"977b5d76392c1d12b24d36c2b730fb9ff4f10827030d277b9703167990df500a","availableFormats":["json"],"listOfBooksApiLink":"/api/bel_njo/books.json","numberOfBooks":31,"totalNumberOfChapters":503,"totalNumberOfVerses":13154,"languageName":"беларуская","languageEnglishName":"Belarusian"},"book":{"id":"PSA","translationId":"bel_njo","name":"ПСАЛЬМЫ","commonName":"ПСАЛЬМЫ","title":"КНІГА ПСАЛЬМАЎ","order":19,"numberOfChapters":150,"sha256":"e1a508a5bee2b312223cc502c26e192ecbcea978a46eb9ab7d4963aaec80fa4e","firstChapterNumber":1,"firstChapterApiLink":"/api/bel_njo/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bel_njo/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["ГОСПАД валадарыць, апрануўся ў веліч, апрануўся ГОСПАД у моц і падперазаўся. Ён сусьвет умацаваў, што не захістаецца."]},{"type":"verse","number":2,"content":["Умацаваны пасад Твой ад спрадвечных часоў; і Ты — спакон вякоў!"]},{"type":"verse","number":3,"content":["Узьнімаюць рэкі, ГОСПАДЗЕ, узьнімаюць рэкі голас свой, узьнімаюць рэкі хвалі свае."]},{"type":"verse","number":4,"content":["Слаўнейшы за голас водаў вялікіх, за хвалі марскія — слаўны на вышынях ГОСПАД."]},{"type":"verse","number":5,"content":["Сьведчаньні Твае вельмі верныя; сьвятасьць аздабляе дом Твой, ГОСПАДЗЕ, на вечныя дні!"]}],"footnotes":[]},"thisChapterLink":"/api/bel_njo/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bel_njo/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bel_njo/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}