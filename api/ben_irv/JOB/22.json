Break":true},{"text":"কারণ তুমি তোমার ভাইয়ের কাছ থেকে অকারণে বন্দক দাবি করতে;","poem":1},{"lineBreak":true},{"text":"তুমি উলঙ্গদের প্রয়োজনের কাপড় তুমি ছিনতাই করতে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তুমি ক্লান্তদের জল দিতে না;","poem":1},{"lineBreak":true},{"text":"তুমি ক্ষুদিতদের খাবার দিতে অস্বীকার করতে,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যদিও তুমি একজন ক্ষমতাশালী লোক,","poem":1},{"lineBreak":true},{"text":"পৃথিবী অধিকার করেছ,","poem":1},{"lineBreak":true},{"text":"যদিও তুমি, একজন সম্মানিত ব্যক্তি,","poem":1},{"lineBreak":true},{"text":"এতে বাস করতে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তুমি বিধবাদের খালি হাতে বিদায় দিয়েছ;","poem":1},{"lineBreak":true},{"text":"পিতৃহীনের হাত ভেঙ্গেছ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"এই জন্য, তোমার চারিদিকে ফাঁদ আছে","poem":1},{"lineBreak":true},{"text":"এবং হঠাৎ ভয় তোমায় কষ্ট দেয়;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"সেখানে অন্ধকার,","poem":1},{"lineBreak":true},{"text":"যাতে তুমি দেখতে না পাও,","poem":1},{"lineBreak":true},{"text":"অনেক জল তোমায় ঢেকে রেখেছে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ঈশ্বর কি সর্বোচ্চ স্বর্গে থাকেন না?","poem":1},{"lineBreak":true},{"text":"তারাদের উচ্চতা দেখ, সেগুলো কত উঁচু!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"তুমি বলছ, ‘ঈশ্বর কি জানে?","poem":1},{"lineBreak":true},{"text":"তিনি কি ঘন অন্ধকার থেকে বিচার করতে পারেন?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ঘন মেঘ তাঁকে ঢেকে দিচ্ছে,","poem":1},{"lineBreak":true},{"text":"যাতে তিনি আমাদের দেখতে না পান;","poem":1},{"lineBreak":true},{"text":"তিনি স্বর্গের চারিদিকে হাঁটেন।’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তুমি কি সেই পুরানো পথেই চলবে,","poem":1},{"lineBreak":tr