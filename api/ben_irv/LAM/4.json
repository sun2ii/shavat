{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"LAM","translationId":"ben_irv","name":"বিলাপ","commonName":"বিলাপ","title":"বিলাপ","order":25,"numberOfChapters":5,"sha256":"2351ae74afa404b8564d8af346d6a64165fcb4989c1b1b7a2cfb0d5110f021f7","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/ben_irv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["সব শ্রেণীর ইহুদীদের দুঃখ।"]},{"type":"verse","number":1,"content":[{"text":"হায়! সোনা কেমনভাবে উজ্জ্বলতা হারিয়েছে,","poem":1},{"lineBreak":true},{"text":"খাঁটি সোনা পরিবর্তিত হয়েছে।","poem":1},{"lineBreak":true},{"text":"পবিত্র পাথরগুলি প্রতিটি রাস্তার মাথায় ছড়িয়ে আছে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সিয়োনের মূল্যবান ছেলেগুলো,","poem":1},{"lineBreak":true},{"text":"যারা খাঁটি সোনার থেকে দামী,","poem":1},{"lineBreak":true},{"text":"কিন্তু এখন তারা কুমোরের হাতে তৈরী","poem":1},{"lineBreak":true},{"text":"মাটির পাত্রের মতো গণ্য হয়েছে,","poem":1},{"lineBreak":true},{"text":"তা ছাড়া আর কিছুই নয়।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"এমন কি শিয়ালেরাও","poem":1},{"lineBreak":true},{"text":"তাদের বাচ্চাদেরকে দুধ পান করায়;","poem":1},{"lineBreak":true},{"text":"আমার লোকের মেয়েরা","poem":1},{"lineBreak":true},{"text":"মরুপ্রান্তের উটপাখির মত নিষ্ঠুর হয়েছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"স্তন্যপায়ী শিশুর জিভ পিপাসায়","poem":1},{"lineBreak":true},{"text":"মুখের তালুতে লেগে আছে;","poem":1},{"lineBreak":true},{"text":"ছেলেমেয়েরা রুটি চাইছে,","poem":1},{"lineBreak":true},{"text":"কিন্তু তাদের জন্য কিছুই নেই।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যারা সুস্বাদু খাবার খেত,","poem":1},{"lineBreak":true},{"text":"তারা পরিত্যক্ত অন্নহীন অবস্থায় রাস্তায় রয়েছে;","poem":1},{"lineBreak":true},{"text":"যাদেরকে টকটকে লাল রঙের পোশাক পরিয়ে প্রতিপালিত করা যেত,","poem":1},{"lineBreak":true},{"text":"তারা আবর্জনার স্তূপ আলিঙ্গন করছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"প্রকৃত পক্ষে আমার লোকের মেয়ের অপরাধ","poem":1},{"lineBreak":true},{"text":"সেই সদোমের পাপের থেকেও বেশি,","poem":1},{"lineBreak":true},{"text":"যা এক মুহূর্তে উপড়ে ফেলেছিল,","poem":1},{"lineBreak":true},{"text":"অথচ তার ওপরে মানুষের হাত পড়েনি।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তাদের যিরুশালেমের নেতারা","poem":1},{"noteId":2},{"lineBreak":true},{"text":"তুষারের থেকেও উজ্জ্বল,","poem":1},{"lineBreak":true},{"text":"দুধের থেকেও সাদা ছিলেন;","poem":1},{"lineBreak":true},{"text":"প্রবালের থেকেও লালবর্ণ অঙ্গ তাঁদের ছিল;","poem":1},{"lineBreak":true},{"text":"নীলকান্তমণির মতো তাঁদের চেহারা ছিল।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"এখন তাঁদের মুখ কালির থেকেও কালো হয়েছে;","poem":1},{"lineBreak":true},{"text":"রাস্তায় তাঁদেরকে চেনা যায় না;","poem":1},{"lineBreak":true},{"text":"তাঁদের চামড়া হাড়ে লেগে গিয়েছে;","poem":1},{"lineBreak":true},{"text":"তা কাঠের মতো শুকনো হয়েছে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ক্ষিদেতে মরে যাওয়া লোকের থেকে","poem":1},{"lineBreak":true},{"text":"তরোয়ালের মাধ্যমে মরে যাওয়া লোক ভালো,","poem":1},{"lineBreak":true},{"text":"কারণ এরা মাঠের শস্যের অভাবে যেন আহত হয়ে ক্ষয় পাচ্ছে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"দয়াবতী স্ত্রীদের হাত নিজের নিজের শিশু রান্না করেছে;","poem":1},{"lineBreak":true},{"text":"আমার লোকের মেয়েদের ধ্বংসের জন্য এরা তাদের খাবার হয়েছে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"সদাপ্রভু নিজের রাগ সম্পূর্ণ করেছেন,","poem":1},{"lineBreak":true},{"text":"নিজের প্রচণ্ড রাগ ঢেলে দিয়েছেন;","poem":1},{"lineBreak":true},{"text":"তিনি সিয়োনে আগুন জ্বালিয়েছেন,","poem":1},{"lineBreak":true},{"text":"তা তার ভিত্তিমূল গ্রাস করেছে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"পৃথিবীর রাজারা, বিশ্বের সব লোক,","poem":1},{"lineBreak":true},{"text":"বিশ্বাস করত না যে, যিরূশালেমের দরজায় কোনো বিপক্ষ","poem":1},{"lineBreak":true},{"text":"ও শত্রু প্রবেশ করতে পারবে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"এর কারণ তার ভাববাদীদের পাপ ও যাজকদের অপরাধ;","poem":1},{"lineBreak":true},{"text":"যারা তার মধ্যে ধার্ম্মিকদের রক্তপাত করত।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তারা অন্ধদের মতো রাস্তায় রাস্তায় ঘুরে বেড়িয়েছে,","poem":1},{"lineBreak":true},{"text":"তাদের রক্ত দূষিত হয়েছে,","poem":1},{"lineBreak":true},{"text":"লোকেরা তাদের কাপড় স্পর্শ করতে পারে না।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"লোকে তাদেরকে চেঁচিয়ে বলেছে,","poem":1},{"lineBreak":true},{"text":"“চলে যাও; অশুচি, চলে যাও, চলে যাও,","poem":1},{"lineBreak":true},{"text":"আমাকে স্পর্শ কর না,” তারা পালিয়ে গিয়েছে,","poem":1},{"lineBreak":true},{"text":"ঘুরে বেড়িয়েছে; জাতিদের মধ্যে লোকে বলেছে,","poem":1},{"lineBreak":true},{"text":"“ওরা এই জায়গায় আর কখনো বিদেশী হিসেবে বাস করতে পারবে না।”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর মুখ তাদেরকে তার সামনে থেকে ছড়িয়ে দিয়েছেন,","poem":1},{"lineBreak":true},{"text":"তিনি তাদেরকে আর দেখেন না;","poem":1},{"lineBreak":true},{"text":"লোকে যাজকদের সম্মান করে না,","poem":1},{"lineBreak":true},{"text":"প্রাচীনদের প্রতি দয়া দেখান না।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"এখনও আমাদের চোখ সর্বদা ব্যর্থ হয়ে যাচ্ছে,","poem":1},{"lineBreak":true},{"text":"মূল্যহীন সাহায্যের আশায়;","poem":1},{"lineBreak":true},{"text":"যদিও আমরা অধীর আগ্রহে এমন এক জাতির অপেক্ষায় আছি,","poem":1},{"lineBreak":true},{"text":"যে রক্ষা করতে পারে না।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"শত্রুরা আমাদের পদক্ষেপ অনুসরণ করে,","poem":1},{"lineBreak":true},{"text":"আমরা আমাদের নিজের রাস্তায় হাঁটতে পারি না;","poem":1},{"lineBreak":true},{"text":"আমাদের শেষকাল কাছাকাছি,","poem":1},{"lineBreak":true},{"text":"আমাদের দিন শেষ কারণ আমাদের শেষকাল উপস্থিত।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"আমাদের তাড়নাকারীরা আকাশের ঈগল পাখির চেয়ে দ্রুতগামী ছিল;","poem":1},{"lineBreak":true},{"text":"তারা পর্বতের ওপরে আমাদের পিছনে পিছনে দৌড়াত,","poem":1},{"lineBreak":true},{"text":"মরুপ্রান্তে আমাদের জন্য ঘাঁটি বসাত।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"যিনি আমাদের নাকের নিঃশ্বাস-প্রশ্বাস,","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুর অভিষিক্ত, তিনি তাদের ফাঁদে ধরা পড়লেন,","poem":1},{"lineBreak":true},{"text":"যাঁর বিষয়ে বলেছিলাম, আমরা তাঁর সুরক্ষায় জাতিদের মধ্যে বাস করব।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"হে ঊষদেশ নিবাসিনী ইদোমের মেয়ে,","poem":1},{"lineBreak":true},{"text":"তুমি আনন্দ কর ও খুশি হও! তোমার কাছেও সেই পানপাত্র আসবে,","poem":1},{"lineBreak":true},{"text":"তুমি মাতাল হবে এবং উলঙ্গিনী হবে।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"সিয়োনের মেয়ে, তোমার অপরাধ শেষ হল;","poem":1},{"lineBreak":true},{"text":"তিনি তোমাকে আর কখনো নির্বাসিত করবেন না;","poem":1},{"lineBreak":true},{"text":"হে ইদোমের মেয়ে, তিনি তোমার অপরাধের শাস্তি দেবেন,","poem":1},{"lineBreak":true},{"text":"তোমার পাপ প্রকাশ করবে।","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"নাজারেথ","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/ben_irv/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}