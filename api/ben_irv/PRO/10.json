":"যখন ঘূর্ণবায়ু বয়ে যায়, দুষ্ট আর নেই;","poem":1},{"lineBreak":true},{"text":"কিন্তু ধার্মিক চিরস্থায়ী ভিত্তিমূলের মত।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"যেমন দাঁতের পক্ষে অম্লরস ও চোখের পক্ষে ধোঁয়া,","poem":1},{"lineBreak":true},{"text":"তেমনি নিজের প্রেরণ কর্তাদের পক্ষে অলস।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর ভয় আয়ুবৃদ্ধি করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টদের বছরের সংখ্যা কমবে।","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ধার্ম্মিকদের প্রত্যাশা আনন্দজনক;","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টদের আশ্বাস কম হবে।","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর পথ সততার পক্ষে দুর্গ,","poem":1},{"lineBreak":true},{"text":"কিন্তু তা অধর্মাচারীদের পক্ষে সর্বনাশ।","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ধার্মিক লোক কখনও নিপাতিত হবে না;","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টরা দেশে থাকবে না।","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ধার্ম্মিকের মুখ প্রজ্ঞার ফলে ফলবান্;","poem":1},{"lineBreak":true},{"text":"কিন্তু বিপথগামীদের জিভ কাটা যাবে।","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ধার্ম্মিকের ঠোঁট গ্রহণযোগ্যতার বিষয় জানে,","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টদের মুখ কুটিলতামাত্র।","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"যে সামনা সামনি তিরষ্কার করে সে শান্তি স্থাপন করে","reference":{"chapter":10,"verse":10}}]},"thisChapterLink":"/api/ben_irv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}