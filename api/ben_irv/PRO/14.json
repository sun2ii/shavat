em":1},{"lineBreak":true},{"text":"কিন্তু মিথ্যাসাক্ষী অসত্য কথা বলে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"উপহাসক প্রজ্ঞার খোঁজ করে, আর তা পায় না;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে উপলব্ধি করে তার পক্ষে জ্ঞান সহজ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তুমি নির্বোধ লোকের থেকে দূরে যাও,","poem":1},{"lineBreak":true},{"text":"কারণ তার ঠোঁটে জ্ঞান পাবে না।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"নিজের রাস্তা বুঝে নেওয়া বিচক্ষণের প্রজ্ঞা,","poem":1},{"lineBreak":true},{"text":"কিন্তু নির্বোধদের নির্বোধমিতা ছলনা।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"নির্বোধেরা দোষকে উপহাস করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু ধার্ম্মিকদের কাছে অনুগ্রহ থাকে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"হৃদয় নিজের তিক্ততা জানে","poem":1},{"lineBreak":true},{"text":"এবং অপর লোক তার আনন্দের ভাগী হতে পারে না।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"দুষ্টদের বাড়ি ধ্বংস হবে,","poem":1},{"lineBreak":true},{"text":"কিন্তু সরলদের তাঁবু সতেজ হবে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"একটি রাস্তা আছে, যা মানুষের দৃষ্টিতে ঠিক,","poem":1},{"lineBreak":true},{"text":"কিন্তু তার শেষ মৃত্যুর পথ।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"হাঁসার দিনের ও হৃদয়ে দুঃখ হয়,","poem":1},{"lineBreak":true},{"text":"আর আনন্দের পরিণাম বিষাদ।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"যে মনে বিপথগামী,","poem":1},{"lineBreak":true},{"text":"সে নিজ আচরণে পূর্ণ হয়;","poem":1},{"lineBreak":true},{"text":"কিন্তু সৎ লোক নিজে থেকে তৃপ্ত হয়।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যে অবোধ, সে সব কিছুতে বিশ্বাস করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু বুদ্ধিমান লোক নিজের পদক্ষেপের বিষয়ে ভাবে।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"জ্ঞানবান সতর্ক","poem":1},{"noteId":4},{"text":"থাকে, তারা খারাপ থেকে সরে যায়;","poem":1},{"lineBreak":true},{"text":"কিন্তু নির্বোধ অভিমানী ও সাবধানী।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"যে তাড়াতাড়ি রেগে যায় সে নির্বোধের কাজ করে,","poem":1},{"lineBreak":true},{"text":"আর খারাপ পরিকল্পনাকারী","poem":1},{"noteId":5},{"text":"ঘৃণিত হয়।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"মূর্খদের অধিকার অজ্ঞানতা;","poem":1},{"lineBreak":true},{"text":"কিন্তু বিচক্ষণেরা জ্ঞানে পরিবেষ্টিত হয়।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"খারাপরা ভালোদের সামনে নত হয়","poem":1},{"lineBreak":true},{"text":"এবং দুষ্টেরা ধার্ম্মিকের দরজায় নত হয়।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"গরিব লোক নিজের প্রতিবেশীর মাধ্যমে ঘৃণিত,","poem":1},{"lineBreak":true},{"text":"কিন্তু ধনী লোকের অনেক বন্ধু আছে।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"যে প্রতিবেশীকে অবজ্ঞা করে, সে পাপ করে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে গরিবদের প্রতি দয়া করে, সে সুখী।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"যারা খারাপ চক্রান্ত করে,","poem":1},{"lineBreak":true},{"text":"তারা কি ভ্রান্ত হয় না? কিন্তু যারা ভালো পরিকল্পনা করে,","poem":1},{"lineBreak":true},{"text":"তারা চুক্তির বিশ্বস্ততা ও বিশ্বাসযোগ্যতা পায়।","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"সমস্ত পরিশ্রমেই লাভ হয়,","poem":1},{"lineBreak":true},{"text":"কিন্তু শুধু কথাবার্তায় অভাব ঘটায়।","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"জ্ঞানবানদের ধনই তাদের মুকুট;","poem":1},{"lineBreak":true},{"text":"কিন্তু নির্বোধদের নির্বোধমিতা মূর্খতামাত্র।","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"সত্য সাক্ষ্য লোকের জীবন রক্ষা করে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে মিথ্যা সাক্ষ্যের কথা বলে, সে ছলনা করে।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর ভয় দৃঢ় আত্মবিশ্বাস;","poem":1},{"lineBreak":true},{"text":"তাঁর সন্তানরা আশ্রয় স্থান পাবে।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর ভয় জীবনের ঝরনা,","poem":1},{"lineBreak":true},{"text":"তা মৃত্যুর ফাঁদ থেকে দূরে সরে যাবার রাস্তা।","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"প্রচুর লোকের জন্যে রাজার আনন্দ আসে;","poem":1},{"lineBreak":true},{"text":"কিন্তু লোকদের অভাবে ভূপতির সর্বনাশ ঘটে।","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"একজন ধৈর্য্যশীল মানুষ প্রচুর বোধশক্তিসম্পন্ন,","poem":1},{"lineBreak":true},{"text":"কিন্তু উগ্র মেজাজি নির্বোধমিতা তুলে ধরে।","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"শান্ত হৃদয় শরীরের জীবন;","poem":1},{"lineBreak":true},{"text":"কিন্তু হিংসা হাড়ের পচনস্বরূপ।","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"যে গরিবের প্রতি অত্যাচার করে,","poem":1},{"lineBreak":true},{"text":"সে তার নির্মাতাকে অভিশাপ দেয়;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে দরিদ্রের প্রতি দয়া করে,","poem":1},{"lineBreak":true},{"text":"সে তাঁকে সম্মান করে।","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"দুষ্ট লোক নিজের খারাপ কাজে পড়ে যায়,","poem":1},{"lineBreak":true},{"text":"কিন্তু ধার্মিক তাদের সত্যতায়","poem":1},{"noteId":6},{"text":"আশ্রয় পায়।","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"জ্ঞানবানের হৃদয় প্রজ্ঞা বিশ্রাম করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু নির্বোধদের মধ্যে যা থাকে, তা জানা।","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ধার্ম্মিকতা জাতিকে উন্নত করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু পাপে যে কোনো লোকের মর্যাদাহানি হয়।","poem":1}]},{"typ