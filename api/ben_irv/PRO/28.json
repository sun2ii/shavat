{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PRO","translationId":"ben_irv","name":"হিতোপদেশ","commonName":"হিতোপদেশ","title":"হিতোপদেশ","order":20,"numberOfChapters":31,"sha256":"16d53c3a964334ea842898d1751e9e51e74b7a740809ed8ed4f4f6941e186dde","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ben_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"কেউ তাড়না না করলেও দুষ্ট পালায়;","poem":1},{"lineBreak":true},{"text":"কিন্তু ধার্মিকরা সিংহের মত সাহসিক।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"দেশের অধর্মে তার অনেক কর্তা হয়;","poem":1},{"lineBreak":true},{"text":"কিন্তু বুদ্ধিমান ও জ্ঞানবান লোক দিয়ে কর্তৃত্ব স্থায়ী হয়।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"যে দরিদ্র লোক","poem":1},{"noteId":15},{"text":"দীনহীনদের প্রতি উপদ্রব করে,","poem":1},{"lineBreak":true},{"text":"সে এমন ভাসিয়ে নিয়ে যাওয়া বৃষ্টির মত,","poem":1},{"lineBreak":true},{"text":"যার পরে খাবার থাকে না।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ব্যবস্থা পালন না করা দুষ্টের প্রশংসা করে;","poem":1},{"lineBreak":true},{"text":"কিন্তু ব্যবস্থা পালনকারীরা দুষ্টদের প্রতিরোধ করে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"দুরাচারেরা বিচার বোঝে না,","poem":1},{"lineBreak":true},{"text":"কিন্তু সদাপ্রভুর অন্বেষনকারীরা সকলই বোঝে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"বরং সেই দরিদ্র লোক ভাল,","poem":1},{"lineBreak":true},{"text":"যে নিজের সিদ্ধতায় চলে,","poem":1},{"lineBreak":true},{"text":"তবু দ্বিপথগামী কুটিল লোক ধনী হলেও ভাল নয়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যে ব্যবস্থা মানে, সেই জ্ঞানবান ছেলে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে পেটুকদের সঙ্গী সে বাবার লজ্জাজনক।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যে সুদ ও বৃদ্ধি নিয়ে নিজের ধন বাড়ায়,","poem":1},{"lineBreak":true},{"text":"সে দীনহীনদের প্রতি দয়াকারীর জন্য সঞ্চয় করে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যে ব্যবস্থা শোনা থেকে নিজের কান সরিয়ে নেয়,","poem":1},{"lineBreak":true},{"text":"তার প্রার্থনাও ঘৃণাস্পদ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যে সরলদের কে খারাপ পথে নিয়ে ভ্রান্ত করে,","poem":1},{"lineBreak":true},{"text":"সে নিজের গর্তে নিজে পড়বে;","poem":1},{"lineBreak":true},{"text":"কিন্তু সাধুরা মঙ্গলের অধিকার পায়।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ধনী নিজের চোখে জ্ঞানবান,","poem":1},{"lineBreak":true},{"text":"কিন্তু বুদ্ধিমান দরিদ্র তার পরীক্ষা করে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ধার্ম্মিকদের আনন্দে মহাগৌরব হয়,","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টদের উন্নতি হলেও লোকদের দেখতে পাওয়া যায় না।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যে নিজের অধর্ম্ম সব ঢেকে রাখে,","poem":1},{"lineBreak":true},{"text":"সে কৃতকার্য্য হইবে না;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে তা স্বীকার করে ত্যাগ করে,","poem":1},{"lineBreak":true},{"text":"সে করুণা পাবে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ধন্য সেই ব্যক্তি,","poem":1},{"lineBreak":true},{"text":"যে সব দিন মন্দ কাজ করতে ভয়","poem":1},{"noteId":16},{"text":"করে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে হৃদয় কঠিন করে, সে বিপদে পড়বে।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"যেমন গর্জনকারী সিংহ ও পর্যটনকারী ভল্লুক,","poem":1},{"lineBreak":true},{"text":"তেমনি দীনহীন প্রজার উপরে দুষ্ট শাসনকর্ত্তা।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"যে অধ্যক্ষের বুদ্ধির অভাব,","poem":1},{"lineBreak":true},{"text":"সে নিষ্ঠুর অত্যাচারী;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে লোভ ঘৃণা করে,","poem":1},{"lineBreak":true},{"text":"সে দীর্ঘজীবী হবে।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"যে লোক মানুষের রক্তভারে ভারাক্রান্ত,","poem":1},{"lineBreak":true},{"text":"সে গর্ত পর্যন্ত পালাবে,","poem":1},{"lineBreak":true},{"text":"কেউ তাকে থাকতে না দিক।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"যে ন্যায়ের পথে চলে,","poem":1},{"lineBreak":true},{"text":"সে রক্ষা পাবে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে বিপথগামী দুই পথে চলে,","poem":1},{"lineBreak":true},{"text":"সে একটায় পড়বে।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"যে নিজের জমি চাষ করে,","poem":1},{"lineBreak":true},{"text":"সে যথেষ্ট খাবার পায়;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে অসারদের পিছনে পিছনে দৌড়য়,","poem":1},{"lineBreak":true},{"text":"তার যথেষ্ট কম হয়।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"বিশ্বস্ত লোক অনেক আশীর্বাদ পাবে;","poem":1},{"lineBreak":true},{"text":"কিন্তু যে ধনী হবার জন্য","poem":1},{"lineBreak":true},{"text":"তাড়াতাড়ি করে, সে দন্ডিত হবে।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"মানুষের ওপর নির্ভর করা ভাল নয়,","poem":1},{"lineBreak":true},{"text":"এক টুকরো রুটীর জন্য অধর্ম্ম করাও ভাল নয়।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"যার চোখ মন্দ, সে ধনের চেষ্টায় ব্যস্ত থাকে;","poem":1},{"lineBreak":true},{"text":"সে জানে না যে, তার দ্রারিদ্রতা আসবে।","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"কোনো লোককে যে তিরস্কার করে,","poem":1},{"lineBreak":true},{"text":"শেষে তাকে তিরস্কার করা হবে,","poem":1},{"lineBreak":true},{"text":"যে জিভে চাটুবাদ করে, সে নয়।","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"যে বাবা মায়ের ধন চুরি করে বলে,","poem":1},{"lineBreak":true},{"text":"এ তো অধর্ম্ম নয়, সে ব্যক্তি ধ্বংসের পাত্র।","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"যে বেশী আশা করে, সে ঝগড়ার সৃষ্টি করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু যে সদাপ্রভুতে বিশ্বাস করে, সে পুষ্ট হবে।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"যে নিজ হৃদয়কে বিশ্বাস করে,","poem":1},{"lineBreak":true},{"text":"সে নির্বোধ; কিন্তু যে প্রজ্ঞা-পথে চলে, সে রক্ষা পাবে।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"যে দরিদ্রদের দিকে তাকিয়েও","poem":1},{"noteId":17},{"text":"দান না করে,","poem":1},{"lineBreak":true},{"text":"সে অভিশপ্ত হবে, কিন্তু যে চোখ বন্ধ করে থাকে,","poem":1},{"lineBreak":true},{"text":"সে অনেক অভিশাপ পাবে।","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"দুষ্টদের উন্নতি হলে লোকেরা লুকায়;","poem":1},{"lineBreak":true},{"text":"তারা ধ্বংস হলে ধার্ম্মিকেরা বৃদ্ধি পায়।","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"অধিপতি বা শাসক","reference":{"chapter":28,"verse":3}},{"noteId":16,"caller":"+","text":"সর্বদা সদাপ্রভুকে ভয় করে","reference":{"chapter":28,"verse":14}},{"noteId":17,"caller":"+","text":"সে সাহায্য করতে প্রত্যাখ্যান করে","reference":{"chapter":28,"verse":27}}]},"thisChapterLink":"/api/ben_irv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiL