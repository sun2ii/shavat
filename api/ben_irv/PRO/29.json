ak":true},{"text":"সে তার পায়ের নীচে জাল পাতে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"দুর্বৃত্তের অধর্মে ফাঁদ থাকে,","poem":1},{"lineBreak":true},{"text":"কিন্তু ধার্মিক আনন্দিত হয়ে গান করে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ধার্মিক দীনহীনদের বিচার বোঝে;","poem":1},{"lineBreak":true},{"text":"দুষ্ট লোক জ্ঞান বোঝে না।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"নিন্দাপ্রিয়েরা নগরে আগুন লাগিয়ে দেয়;","poem":1},{"lineBreak":true},{"text":"কিন্তু জ্ঞানবানেরা রাগ ফিরিয়ে দেয়।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"অজ্ঞানের সঙ্গে জ্ঞানবানের ঝগড়া হলে,","poem":1},{"lineBreak":true},{"text":"সে রাগ করুক কি হাঁসুক,","poem":1},{"lineBreak":true},{"text":"কিছুই শান্তি হয় না।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"রক্তপাতকারীরা সিদ্ধ লোককে ঘৃণা করে;","poem":1},{"lineBreak":true},{"text":"আর সরল লোকের প্রাণনাশের চেষ্টা করে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"নির্বোধ নিজের সব রাগ প্রকাশ করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু জ্ঞানী তা সম্বরণ করে রাগ কমায়।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"যে শাসনকর্ত্তা মিথ্যা কথায় কান দেয়,","poem":1},{"lineBreak":true},{"text":"তার পরিচারকেরা সকলে দুষ্ট।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"দরিদ্র ও উপদ্রবী এক সঙ্গে মেলে;","poem":1},{"lineBreak":true},{"text":"সদাপ্রভু উভয়েরই চোখ আলোকিত করেন।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"যে রাজা বিশ্বস্তভাবে দীনহীনদের বিচার করেন,","poem":1},{"lineBreak":true},{"text":"তাঁর সিংহাসন চিরকাল স্থির থাকবে।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"দন্ড ও তিরস্কার প্রজ্ঞা দেয়;","poem":1},{"lineBreak":true},{"text":"কিন্তু অশাসিত বালক মায়ের লজ্জাজনক।","poem":1}]},{"type":"verse","