},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"এক বংশ আছে, তাদের দৃষ্টি কেমন উঁচুঁ।","poem":1},{"lineBreak":true},{"text":"তাদের চোখের পাতা উন্নত।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"এক বংশ আছে,","poem":1},{"lineBreak":true},{"text":"তাদের দাঁত খড়গ ও চোয়াল ছুরি,","poem":1},{"lineBreak":true},{"text":"যেন দেশ থেকে দুঃখীদেরকে,","poem":1},{"lineBreak":true},{"text":"মানুষদের মধ্য থেকে দরিদ্রদেরকে গ্রাস করে।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"জোঁকের দুটো মেয়ে আছে,","poem":1},{"lineBreak":true},{"text":"“দাও এবং দাও।” তিনটা কখনও তৃপ্ত হয় না,","poem":1},{"lineBreak":true},{"text":"চারটা কখনও বলে না, “যথেষ্ট হল”:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"পাতাল; বন্ধ্যা গর্ভ;","poem":1},{"lineBreak":true},{"text":"জলের জন্য তৃষ্ণার্ত ভূমি","poem":1},{"lineBreak":true},{"text":"এবং আগুন যা কখনো বলে না, “যথেষ্ট।”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"যে চোখ নিজের বাবাকে পরিহাস করে,","poem":1},{"lineBreak":true},{"text":"নিজের মায়ের আদেশ মানতে অবহেলা করে,","poem":1},{"lineBreak":true},{"text":"উপত্যকার কাকেরা তা তুলে নেবে,","poem":1},{"lineBreak":true},{"text":"ঈগল পাখির বাচ্চারা তা খেয়ে ফেলবে।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"তিনটে আমার জ্ঞানের বাইরে,","poem":1},{"lineBreak":true},{"text":"চারটে আমি বুঝতে পারি না;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ঈগল পাখির পথ আকাশে,","poem":1},{"lineBreak":true},{"text":"সাপের পথ পাহাড়ের ওপরে,","poem":1},{"lineBreak":true},{"text":"জাহাজের পথ সমুদ্রের মাঝখানে,","poem":1},{"lineBreak":true},{"text":"পুরুষের পথ যুবতীতে।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ব্যভিচারিনীর পথও সেরকম;","poem":1},{"lineBreak":true},{"text":"সে খেয়ে মুখ মোছে, আর বলে,","poem":1},{"lineBreak":true},{"text":"আমি অধর্ম্ম করিনি।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"তিনটের ভারে ভূমি কাঁপে,","poem":1},{"lineBreak":true},{"text":"চারটের ভারে কাঁপে,","poem":1},{"lineBreak":true},{"text":"সইতে পারে না;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"দাসের ভার,","poem":1},{"lineBreak":true},{"text":"যখন সে রাজত্ব প্রাপ্ত হয়,","poem":1},{"lineBreak":true},{"text":"মূর্খের ভার, যখন সে খেয়ে পরিতৃপ্ত হয়,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ঘৃণিত স্ত্রীর ভার,","poem":1},{"lineBreak":true},{"text":"যখন সে পত্নীর পদ প্রাপ্ত হয়,","poem":1},{"lineBreak":true},{"text":"আর দাসীর ভার,","poem":1},{"lineBreak":true},{"text":"যখন সে নিজের কর্ত্রীর জায়গা লাভ করে।","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"পৃথিবীতে চারটে খুব ছোট,","poem":1},{"lineBreak":true},{"text":"তাছাড়া তারা বড় বুদ্ধি ধরে;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"পিপড়ে শক্তিমান্ জাতি নয়,","poem":1},{"lineBreak":true},{"text":"তবু গ্রীষ্মকালে নিজের নিজের খাবারের আয়োজন কর;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"শাফন জন্তু বলবান জাতি নয়,","poem":1},{"lineBreak":true},{"text":"তবুও পাহাড়ে ঘর বাঁধে;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"পঙ্গপালদের রাজা নেই,","poem":1},{"lineBreak":true},{"text":"তবুও তারা দল বেঁধে যায়;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"টিকটিকি","poem":1},{"noteId":19},{"text":"কে তোমার হাতে নিতে পার,","poem":1},{"lineBreak":true},{"text":"তবুও রাজার প্রাসাদে থাকে।","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"তিনটে সুন্দরভাবে যায়,","poem":1},{"lineBreak":true},{"text":"চারটে সুন্দরভাবে চলে;","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"সিংহ, যে পশুদের মধ্যে বিক্রমী,","poem":1},{"lineBreak":true},{"text":"যে কাকেও দেখেও ফিরে যায় না;","poem":1}]}