{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PRO","translationId":"ben_irv","name":"হিতোপদেশ","commonName":"হিতোপদেশ","title":"হিতোপদেশ","order":20,"numberOfChapters":31,"sha256":"16d53c3a964334ea842898d1751e9e51e74b7a740809ed8ed4f4f6941e186dde","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ben_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["ব্যাভিচারিনীর বিরুদ্ধে সাবধানবাণী।"]},{"type":"verse","number":1,"content":[{"text":"আমার পুত্র, আমার কথা সব পালন কর,","poem":1},{"lineBreak":true},{"text":"আমার আদেশ সব তোমার কাছে সঞ্চয় কর।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আমার আদেশ সব পালন কর, জীবন পাবে","poem":1},{"lineBreak":true},{"text":"এবং চোখের তারার মত আমার ব্যবস্থা রক্ষা কর;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমার আঙ্গুলে সেগুলো বেঁধে রাখ,","poem":1},{"lineBreak":true},{"text":"তোমার হৃদয় ফলকে তা লিখে রাখ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"প্রজ্ঞাকে বল, “তুমি আমার বোন","poem":1},{"lineBreak":true},{"text":"এবং সুবিবেচনাকে তোমার সখী বল,”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তাতে তুমি পরস্ত্রী থেকে রক্ষা পাবে,","poem":1},{"lineBreak":true},{"text":"ব্যাভিচারিনীর স্বছন্দ শব্দ থেকে রক্ষা পাবে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আমি নিজের ঘরের জানালা থেকে","poem":1},{"lineBreak":true},{"text":"জালি দিয়ে দেখছিলাম;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"নির্বোধদের মধ্যে আমার চোখ পড়ল,","poem":1},{"lineBreak":true},{"text":"আমি যুবকদের মধ্যে এক জনকে দেখলাম,","poem":1},{"lineBreak":true},{"text":"সে বুদ্ধিহীন যুবক।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"সে গলিতে গেল, ঐ স্ত্রীর কোণের কাছে আসল,","poem":1},{"lineBreak":true},{"text":"তার বাড়ীর পথে চলল।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তখন সন্ধ্যাবেলা, দিন শেষ হয়েছিল,","poem":1},{"lineBreak":true},{"text":"রাত অন্ধকার হয়েছিল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তখন দেখ, এক স্ত্রী তার সামনে আসল,","poem":1},{"lineBreak":true},{"text":"সে বেশ্যার পোশাক পরেছিল ও অভিসন্ধির হৃদয় ছিল;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"সে ঝগড়াটে ও অবাধ্যা, তার পা ঘরে থাকে না;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"সে কখনও সড়কে, কখনও রাস্তায়,","poem":1},{"lineBreak":true},{"text":"কোণে কোণে অপেক্ষা করতে থাকে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"সে তাকে ধরে চুমু খেল,","poem":1},{"lineBreak":true},{"text":"নির্লজ্জ মুখে তাকে বলল,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"আমাকে মঙ্গলের জন্য বলিদান করতে হয়েছে,","poem":1},{"lineBreak":true},{"text":"আজ আমি নিজের মানত পূর্ণ করেছি;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তাই তোমার সঙ্গে দেখা করতে বাইরে এসেছি,","poem":1},{"lineBreak":true},{"text":"সযত্নে তোমার মুখ দেখতে এসেছি, তোমাকে পেয়েছি।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"আমি খাটে বুটাদার চাদর পেতেছি,","poem":1},{"lineBreak":true},{"text":"মিশরের সূতোর্ চিত্রবিচিত্র পর্দার কাপড় লাগিয়েছি।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"আমি গন্ধরস, অগুরু ও দারুচিনি দিয়ে","poem":1},{"lineBreak":true},{"text":"নিজের বিছানা গন্ধে ভরিয়ে দিয়েছি।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"চল, আমরা সকাল পর্যন্ত কামরসে মত্ত হই,","poem":1},{"lineBreak":true},{"text":"আমরা প্রেমের বাহুল্যে আমোদ করি।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"কারণ কর্তা ঘরে নেই, তিনি দূরে গেছেন;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"টাকার তোড়া সঙ্গে নিয়ে গেছেন,","poem":1},{"lineBreak":true},{"text":"পূর্ণিমার দিন ঘরে আসবেন।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"অনেক মিষ্টি কথায় সে তার মন চুরি করল,","poem":1},{"lineBreak":true},{"text":"ঠোটের চাটুকরিতে তাকে আকর্ষণ করল।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"তখনি সে তার পেছনে গেল,","poem":1},{"lineBreak":true},{"text":"যেমন গরু মরতে যায়,","poem":1},{"lineBreak":true},{"text":"যেমন শেকলে বাঁধা ব্যক্তি বকর শাস্তি পেতে যায়;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"শেষে তার যকৃত বানে বিধল;","poem":1},{"lineBreak":true},{"text":"যেমন পাখি ফাঁদে পড়তে বেগে ধাবিত হয়,","poem":1},{"lineBreak":true},{"text":"আর জানে না যে, তার জীবন বিপদগ্রস্ত।","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"এখন আমার পুত্ররা,","poem":1},{"lineBreak":true},{"text":"আমার কথা শোন,","poem":1},{"lineBreak":true},{"text":"আমার মুখের কথায় মন দাও।","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"তোমার মন ওর পথে না যাক,","poem":1},{"lineBreak":true},{"text":"তুমি ওর পথে যেও না।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"কারণ সে অনেককে আঘাত করে মেরে ফেলেছে,","poem":1},{"lineBreak":true},{"text":"তারা গণনা করতে পারবে না।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"তার ঘর পাতালের পথ,","poem":1},{"lineBreak":true},{"text":"যে পথ মৃত্যুর কক্ষে নেমে যায়।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}