{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PRO","translationId":"ben_irv","name":"হিতোপদেশ","commonName":"হিতোপদেশ","title":"হিতোপদেশ","order":20,"numberOfChapters":31,"sha256":"16d53c3a964334ea842898d1751e9e51e74b7a740809ed8ed4f4f6941e186dde","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ben_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["প্রজ্ঞার আহ্বান।"]},{"type":"verse","number":1,"content":[{"text":"প্রজ্ঞা কি ডাকে না? বুদ্ধি কি চিত্কার করে না?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সে পথের পাশে উঁচু জায়গার চূড়োয়,","poem":1},{"lineBreak":true},{"text":"মার্গ সকলের সংযোগ স্থানে দাঁড়ায়;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সে প্রবেশ দরজার কাছে,","poem":1},{"lineBreak":true},{"text":"নগরের দরজার কাছে সে চিত্কার করে বলে,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“হে মানুষেরা, আমি তোমাদেরকে ডাকি","poem":1},{"lineBreak":true},{"text":"এবং মানবজাতির সন্তানদের কাছে আমি আমার রব তুলি।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে নির্বোধেরা, চতুরতা শিক্ষা কর;","poem":1},{"lineBreak":true},{"text":"হে নির্বোধ সব, সুবুদ্ধি হৃদয় হও।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"শোনো, কারণ আমি উত্কৃষ্ট কথা বলব","poem":1},{"lineBreak":true},{"text":"এবং যখন আমার ঠোঁট খুলবে যা সঠিক তা বলব।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"আমার মুখ সত্য কথা বলবে","poem":1},{"lineBreak":true},{"text":"এবং দুষ্টতা আমার ঠোঁটের ঘৃণার বস্তু।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"আমার মুখের সব বাক্য ধর্ম্মময়;","poem":1},{"lineBreak":true},{"text":"তার মধ্যে বাঁকা বা খারাপ কিছুই নেই।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"বুদ্ধিমানের কাছে সে সব স্পষ্ট,","poem":1},{"lineBreak":true},{"text":"জ্ঞানীদের কাছে সে সব সরল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"আমার শাসনই গ্রহণ কর,","poem":1},{"lineBreak":true},{"text":"রূপা নয়, উত্কৃষ্ট সোনার থেকে জ্ঞান নাও।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কারণ আমি, প্রজ্ঞা, মুক্তোর থেকেও ভালো,","poem":1},{"lineBreak":true},{"text":"কোনো ইচ্ছার বস্তু তার সমান নয়।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"আমি প্রজ্ঞা, চতুরতার ঘরে বাস করি","poem":1},{"lineBreak":true},{"text":"এবং আমি বিচক্ষণ ও জ্ঞানের অধিকারী।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"সদাপ্রভুর ভয় দুষ্টদের প্রতি ঘৃণা;","poem":1},{"lineBreak":true},{"text":"অহঙ্কার, দাম্ভিকতা ও খারাপ পথ","poem":1},{"lineBreak":true},{"text":"এবং কুটিল কথা আমি ঘৃণা করি।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"পরামর্শ ও বুদ্ধিকৌশল আমার,","poem":1},{"lineBreak":true},{"text":"আমিই সুবিবেচনা, পরাক্রম আমার।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"আমার জন্য রাজারা রাজত্ব করেন,","poem":1},{"lineBreak":true},{"text":"মন্ত্রিরা ধর্ম্মব্যবস্থা স্থাপন করেন।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"আমার জন্য শাসনকর্তারা শাসন করেন,","poem":1},{"lineBreak":true},{"text":"অধিপতিরা, পৃথিবীর সব বিচারকর্তারা, করেন।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"যারা আমাকে প্রেম করে,","poem":1},{"lineBreak":true},{"text":"আমিও তাদেরকে প্রেম করি,","poem":1},{"lineBreak":true},{"text":"যারা সযত্নে আমাকে খোঁজে তারা আমাকে পায়।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"আমার কাছে আছে ঐশ্বর্য্য ও সম্মান,","poem":1},{"lineBreak":true},{"text":"অক্ষয় সম্পত্তি ও ধার্ম্মিকতা।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"সোনা ও বিশুদ্ধ সোনার থেকেও আমার ফল ভালো,","poem":1},{"lineBreak":true},{"text":"আমি যা উত্পাদন করি তা বিশুদ্ধ রূপার থেকে ভালো।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"আমি ধার্মিকতার পথে চলি, ন্যায়ের মধ্য দিয়ে যাই,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"যেন, যারা আমাকে প্রেম করে,","poem":1},{"lineBreak":true},{"text":"তাদেরকে সম্পদ দিই,","poem":1},{"lineBreak":true},{"text":"তাদের ভান্ডার সব পরিপূর্ণ করি।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"সদাপ্রভু নিজের পথের শুরুতে আমাকে রেখে ছিলেন,","poem":1},{"lineBreak":true},{"text":"তাঁর কাজ সকলের আগে, আগে থেকে।","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"আমি স্থাপিত হয়েছি অনাদিকাল থেকে,","poem":1},{"lineBreak":true},{"text":"আদি থেকে, পৃথিবী সৃষ্টির আগে থেকে।","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"সেখানে সমুদ্রের আগে,","poem":1},{"lineBreak":true},{"text":"তখন আমি জন্মেছিলাম,","poem":1},{"lineBreak":true},{"text":"যখন জলভর্তি ঝরনা সব হয়নি।","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"পর্বত সব বসানোর আগে,","poem":1},{"lineBreak":true},{"text":"উপপর্বত সবার আগে আমি জন্মেছিলাম;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"তখন তিনি স্থল ও মাঠ সৃষ্টি করেননি,","poem":1},{"lineBreak":true},{"text":"জগতের ধূলোর প্রথম অণুও সৃষ্টি করেননি।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"যখন তিনি আকাশমন্ডল প্রতিষ্ঠা করেন,","poem":1},{"lineBreak":true},{"text":"তখন আমি সেখানে ছিলাম;","poem":1},{"lineBreak":true},{"text":"যখন তিনি জলধিপৃষ্ঠের ওপর চক্রাকার সীমা নির্ধারন করলেন,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"যখন তিনি ওপরের আকাশ দৃঢ়রূপে তৈরী করলেন,","poem":1},{"lineBreak":true},{"text":"যখন জলের ঢেউ সব শক্তিশালী হল,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"যখন তিনি সমুদ্রের সীমা ঠিক করলেন,","poem":1},{"lineBreak":true},{"text":"যেন জল তাঁর আদেশ অমান্য না করে,","poem":1},{"lineBreak":true},{"text":"যখন তিনি পৃথিবীর মূল নির্ধারণ করলেন;","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"সেই দিন আমি তার কাছে","poem":1},{"noteId":1},{"text":"কৌশলী কারিগর ছিলাম;","poem":1},{"lineBreak":true},{"text":"আমি দিনের র পর দিন আনন্দময় ছিলাম,","poem":1},{"lineBreak":true},{"text":"তার সামনে প্রতিদিন আমোদ করতাম;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"আমি তাঁর ভূমন্ডলে আমোদ করতাম,","poem":1},{"lineBreak":true},{"text":"মানুষের ছেলেদের নিয়ে আনন্দ করতাম।","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"এবং এখন, আমার পুত্ররা,","poem":1},{"lineBreak":true},{"text":"এখন আমার কথা শোনো;","poem":1},{"lineBreak":true},{"text":"কারণ তারা ধন্য, যারা আমার পথে চলে।","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"তোমরা শাসনের কথা শোনো,","poem":1},{"lineBreak":true},{"text":"জ্ঞানবান হও; তা অগ্রাহ্য কোরো না।","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ধনী সেই ব্যক্তি, যে আমার কথা শোনে,","poem":1},{"lineBreak":true},{"text":"যে দিন দিন আমার দরজায় জেগে থাকে,","poem":1},{"lineBreak":true},{"text":"আমার দরজার পাশে অপেক্ষা করে।","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"কারণ যে আমাকে পায়, সে জীবন পায়","poem":1},{"lineBreak":true},{"text":"এবং সদাপ্রভুর অনুগ্রহ লাভ করে।","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"কিন্তু যে আমার বিরুদ্ধে পাপ করে,","poem":1},{"lineBreak":true},{"text":"সে নিজেকে করে; সে সব লোক ঘৃণা করে,","poem":1},{"lineBreak":true},{"text":"তারা মৃত্যুকে ভালবাসে।”","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"প্রিয় পুত্র","reference":{"chapter":8,"verse":30}}]},"thisChapterLink":"/api/ben_irv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}