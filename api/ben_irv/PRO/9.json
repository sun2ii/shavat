{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PRO","translationId":"ben_irv","name":"হিতোপদেশ","commonName":"হিতোপদেশ","title":"হিতোপদেশ","order":20,"numberOfChapters":31,"sha256":"16d53c3a964334ea842898d1751e9e51e74b7a740809ed8ed4f4f6941e186dde","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ben_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["প্রজ্ঞা"]},{"type":"verse","number":1,"content":[{"lineBreak":true},{"text":"প্রজ্ঞা নিজের ঘর তৈরী করেছে,","poem":1},{"lineBreak":true},{"text":"সে কুঠার দিয়ে কেটে সাতটা স্তম্ভ খোদাই করেছে;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সে নিজের পশুর মাংস প্রস্তুত করেছে;","poem":1},{"lineBreak":true},{"text":"সে আঙ্গুর রস মিশিয়েছে","poem":1},{"lineBreak":true},{"text":"এবং সে নিজের মেজও সাজিয়েছে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সে নিজের দাসীদেরকে পাঠিয়েছে,","poem":1},{"lineBreak":true},{"text":"সে নগরের সবচেয়ে উঁচু জায়গা থেকে ডেকে বলে,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“যে সরল, সে এই জায়গায় আসুক;","poem":1},{"lineBreak":true},{"text":"যার বুদ্ধি নেই সে তাকে বলে,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"এস, আমার খাদ্য দ্রব্য খাও,","poem":1},{"lineBreak":true},{"text":"আমার মেশানো আঙ্গুর রস পান কর।”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"নির্বোধদের সঙ্গ ছেড়ে জীবন ধারণ কর,","poem":1},{"lineBreak":true},{"text":"সুবিবেচনার পথে চলো।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"যে নিন্দককে শিক্ষা দেয়, সে লজ্জা পায়,","poem":1},{"lineBreak":true},{"text":"যে দুষ্টকে তিরস্কার করে, সে কলঙ্ক পায়।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"নিন্দককে অনুযোগ কোরো না,","poem":1},{"lineBreak":true},{"text":"পাছে সে তোমাকে ঘৃণা করে;","poem":1},{"lineBreak":true},{"text":"জ্ঞানবানকেই অনুযোগ কর,","poem":1},{"lineBreak":true},{"text":"সে তোমাকে প্রেম করবে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"জ্ঞানবানকে [শিক্ষা] দাও,","poem":1},{"lineBreak":true},{"text":"সে আরও জ্ঞানবান হইবে;","poem":1},{"lineBreak":true},{"text":"ধার্ম্মিককে জ্ঞান দাও, তার পাণ্ডিত্য বাড়বে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"পবিত্র সদাপ্রভুকে ভয় করাই প্রজ্ঞার শুরু,","poem":1},{"lineBreak":true},{"text":"পবিত্রতম-বিষয়ের জ্ঞানই সুবিবেচনা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"কারণ আমার থেকেই তোমার আয়ু বাড়বে,","poem":1},{"lineBreak":true},{"text":"তোমার জীবনের বছরের সংখ্যা বাড়বে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তুমি যদি জ্ঞানবান হও,","poem":1},{"lineBreak":true},{"text":"নিজেরই মঙ্গলের জন্য জ্ঞানবান হবে,","poem":1},{"lineBreak":true},{"text":"যদি নিন্দা কর, একাই তা বহন করবে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"বুদ্ধিহীন স্ত্রীলোক ঝগড়াটি,","poem":1},{"lineBreak":true},{"text":"সে অবোধ, কিছুই জানে না।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"সে নিজের ঘরের দরজায় বসে,","poem":1},{"lineBreak":true},{"text":"নগরের উঁচু জায়গায় আসন পেতে বসে;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"সে পথিকদেরকে ডাকে,","poem":1},{"lineBreak":true},{"text":"সরলপথগামীদেরকে ডাকে,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"যে অবোধ, সে এই জায়গায় আসুক,","poem":1},{"lineBreak":true},{"text":"যে বুদ্ধিহীন, সে তাকে বলে,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"চুরি করা জল মিষ্টি,","poem":1},{"lineBreak":true},{"text":"নিরালার খাবার সুস্বাদু।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"কিন্তু সে জানে না যে,","poem":1},{"lineBreak":true},{"text":"মৃতরাই সেখানে থাকে,","poem":1},{"lineBreak":true},{"text":"ওরা অতিথিরা পাতালের নীচে থাকে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}