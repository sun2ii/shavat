{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুুর প্রশংসা কর।","poem":1},{"lineBreak":true},{"text":"ধন্য সে লোক যে সদাপ্রভুুকে মান্য করে,","poem":1},{"lineBreak":true},{"text":"যে তাঁর আদেশে অত্যন্ত আনন্দিত হয়।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তাঁর বংশ পৃথিবীতে শক্তিশালী হবে;","poem":1},{"lineBreak":true},{"text":"ধার্ম্মিকেরা ধন্য হবে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তার ঘরে সম্পদ এবং ঐশ্বর্য্য থাকে;","poem":1},{"lineBreak":true},{"text":"তার ধার্ম্মিকতা নিত্যস্থায়ী হবে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"অন্ধকারে আলোর জ্যোতি হবে ধার্মিক লোকেদের জন্য;","poem":1},{"lineBreak":true},{"text":"সে","poem":1},{"noteId":29},{"text":"করুণাময়, ক্ষমাশীল এবং ধার্মিক।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"এটা সেই মানুষদের ভালো হবে যে করুণা করে","poem":1},{"lineBreak":true},{"text":"এবং টাকা ধার দেয়,","poem":1},{"lineBreak":true},{"text":"যে সততার সঙ্গে তার ব্যপারে ভালো আচরন করে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"কারণ তাকে কখনো সরানো যাবে না;","poem":1},{"lineBreak":true},{"text":"ধার্ম্মিকদের চিরকাল মনে রাখবে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"সে খারাপ খবরে ভয় পায় না,","poem":1},{"lineBreak":true},{"text":"সে সুনিশ্চিত, সদাপ্রভুুতে নির্ভর করে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তার হৃদয় শান্ত, ভয় নেই,","poem":1},{"lineBreak":true},{"text":"যতক্ষণ না সে তার বিপক্ষদের ওপর বিজয় দেখে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"সে উদারভাবে গরিবদের দেয় তার ধার্ম্মিকতা চিরকালীন;","poem":1},{"lineBreak":true},{"text":"সে বলবান এবং সম্মানে উচ্চ হবে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"দুষ্টলোক এটা দেখবে এবং রাগ করবে;","poem":1},{"lineBreak":true},{"text":"সে দাঁতে দাঁত ঘষবে এবং গলে যাবে;","poem":1},{"lineBreak":true},{"text":"দুষ্টলোকের ইচ্ছা বিনষ্ট হবে।","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"সদাপ্রভু","reference":{"chapter":112,"verse":4}}]},"thisChapterLink":"/api/ben_irv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}