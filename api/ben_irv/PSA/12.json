{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["প্রধান বাদ্যকরের জন্য। স্বর, শমীনীৎ। দায়ূদের একটি গীত।"]},{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুু, সাহায্য কর,","poem":1},{"lineBreak":true},{"text":"কারণ ধার্ম্মিকেরা অদৃশ্য হয়ে গেছে;","poem":1},{"lineBreak":true},{"text":"বিশ্বস্তরা বিলুপ্ত হয়ে গেছে।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সবাই তার প্রতিবেশীকে অনর্থক কথা বলে;","poem":1},{"lineBreak":true},{"text":"যারা দুমনা ও তোষামোদের সঙ্গে কথা বলে।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, তোষামোদকারীদের,","poem":1},{"lineBreak":true},{"text":"প্রত্যেক জিভ যারা বড় কথা বলে তাদের উচ্ছিন্ন করবেন।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"এরা তারা যারা বলে,","poem":1},{"lineBreak":true},{"text":"“আমাদের জিহ্বা দিয়ে আমরা জয়ী হব,","poem":1},{"lineBreak":true},{"text":"যখন আমাদের মুখ কথা বলবে,","poem":1},{"lineBreak":true},{"text":"কে আমাদের উপর প্রভুত্ব করতে পারে?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু বলেন,","poem":1},{"lineBreak":true},{"text":"দরিদ্রের বিরুদ্ধে হিংস্রতার কারণে,","poem":1},{"lineBreak":true},{"text":"অভাবগ্রস্তদের গভীর আর্তনাদের কারণে,","poem":1},{"lineBreak":true},{"text":"আমি উঠব, আমি তাদের নিরাপত্তা প্রদান করব","poem":1},{"lineBreak":true},{"text":"কারণ যার জন্য তারা আকাঙ্খা করে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সদাপ্রভুুর বাক্য বিশুদ্ধ বাক্য,","poem":1},{"lineBreak":true},{"text":"মাটির ধাতু গলানোর পাত্রে শুদ্ধ করা রূপার মত,","poem":1},{"lineBreak":true},{"text":"সাত বার পরিশোধিত।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তুমি সদাপ্রভুু, তুমি আমাদের রক্ষা কর","poem":1},{"lineBreak":true},{"text":"এবং সবদিন এই দুষ্ট প্রজন্ম থেকে আমাদের রক্ষা করবে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"দুষ্টরা চারিদিকে ঘুরে বেড়ায়,","poem":1},{"lineBreak":true},{"text":"যখন মানুষের সন্তানদের মধ্যে মন্দতা সম্মানিত হয়।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}