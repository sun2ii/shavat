":4,"content":[{"lineBreak":true},{"text":"যেমন সৈনিকের হাতে বান,","poem":1},{"lineBreak":true},{"text":"সেরকম যৌবনের সন্তানরা।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ধন্য সেই মানুষ, যার তূন এরকম বানে পূর্ণ;","poem":1},{"lineBreak":true},{"text":"তারা লজ্জিত হবে না,","poem":1},{"lineBreak":true},{"text":"যখন তারা দরজায় শত্রুদের সঙ্গে মুখোমুখি হয়।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}