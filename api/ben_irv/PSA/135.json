ue},{"text":"আমি জানি, সদাপ্রভুু মহান,","poem":1},{"lineBreak":true},{"text":"আমাদের প্রভু সব দেবতাদের ওপরে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু যা ইচ্ছা করেন,","poem":1},{"lineBreak":true},{"text":"তাই তিনি স্বর্গে, পৃথিবীতে, সমুদ্রে","poem":1},{"lineBreak":true},{"text":"এবং সব মহা সমুদ্রের মধ্যে করেন।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তিনি দূর থেকে মেঘ আনেন,","poem":1},{"lineBreak":true},{"text":"তিনি বৃষ্টির সঙ্গে বিদ্যুৎ তৈরী করেন","poem":1},{"lineBreak":true},{"text":"এবং তার ভান্ডার থেকে বাতাস বের করে আনেন।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তিনি মিশরের প্রথম জাতককে হত্যা করেছিলেন,","poem":1},{"lineBreak":true},{"text":"মানুষ এবং পশু উভয়ের মধ্যে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তিনি চিহ্ন এবং বিস্ময়কর ঘটনা","poem":1},{"lineBreak":true},{"text":"মিশরের মধ্যে পাঠিয়েছিলেন, ফরৌণের","poem":1},{"lineBreak":true},{"text":"এবং তাঁর সব দাসের বিরুদ্ধে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তিনি অনেক জাতিকে আক্রমণ করেছিলেন","poem":1},{"lineBreak":true},{"text":"এবং শক্তিশালী রাজাদের হত্যা করেছিলেন,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ইমোরীয়দের রাজা সীহোনকে","poem":1},{"lineBreak":true},{"text":"এবং বাশনের রাজা ওগকে","poem":1},{"lineBreak":true},{"text":"এবং কনানের সব রাজ্যকে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তিনি দিলেন তাদের দেশ অধিকারের জন্য","poem":1},{"lineBreak":true},{"text":"ইস্রায়েলের লোকেদেরকে অধিকারের জন্য দিলেন।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"তোমার নাম, সদাপ্রভুু, অনন্তকালস্থায়ী,","poem":1},{"lineBreak":true},{"text":"তোমার সুনাম, সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"বংশানুক্রমে স্থায়ী।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"কারণ সদাপ্র