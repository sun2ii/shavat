{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"বাবিলীয় নদীর ধারে আমরা বসতাম এবং কাঁদতাম,","poem":1},{"lineBreak":true},{"text":"তখন আমরা সিয়োন সম্বন্ধে চিন্তা করতাম।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"সেখানে ঝাউ গাছের ওপরে আমাদের বীণা টাঙিয়ে রাখতাম।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"সেখানে আমাদের বন্দিকারীরা আমাদের কাছে গান শুনতে চাইত","poem":1},{"lineBreak":true},{"text":"এবং আমাদের উপদ্রবকারীরা আমাদের আওয়াজ শুনতে চাইত,","poem":1},{"lineBreak":true},{"text":"বলত, “আমাদের কাছে সিয়োনের একটা গান গাও।”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"আমরা কেমন করে বিজাতীয় দেশে সদাপ্রভুুর গান করব?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"যিরুশালেম, যদি আমি তোমাকে মনে করতে অস্বীকার করি,","poem":1},{"lineBreak":true},{"text":"আমার ডান হাত কৌশল ভুলে যাক।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আমার জিভ তালুতে আটকে থাক,","poem":1},{"lineBreak":true},{"text":"যদি আমি তোমার সম্বন্ধে চিন্তা না করি,","poem":1},{"lineBreak":true},{"text":"যদি আমি পরম আনন্দ থেকে যিরুশালেমকে বেশী ভাল না বাসি।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"মনে কর, সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"ইদোম-সন্তানদের বিরুদ্ধে যিরুশালেমের দিন;","poem":1},{"lineBreak":true},{"text":"তারা বলেছিল, “এটা বিচ্ছিন্ন কর,","poem":1},{"lineBreak":true},{"text":"আমি পুনরায় যেন গীত না গাইতে পারি।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"বাবিলের মেয়ে,","poem":1},{"lineBreak":true},{"text":"তাড়াতাড়ি তুমি ধ্বংস হবে, ধন্য সে হবে,","poem":1},{"lineBreak":true},{"text":"যে তোমাকে সেরকম প্রতিফল দেবে,","poem":1},{"lineBreak":true},{"text":"যেমন তুমি আমাদের ওপরে করেছ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ধন্য সে হবে, যে তোমার শিশুদেরকে ধরে,","poem":1},{"lineBreak":true},{"text":"আর পাথরের ওপরে আছাড় মারে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}