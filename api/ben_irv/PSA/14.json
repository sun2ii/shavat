se","number":4,"content":[{"lineBreak":true},{"text":"যারা অপরাধ করে,","poem":1},{"lineBreak":true},{"text":"তারা কি কিছু জানে না?","poem":1},{"lineBreak":true},{"text":"যেমনভাবে তারা খাবার খায়,","poem":1},{"lineBreak":true},{"text":"ঠিক তেমন তারা আমার লোকদের গ্রাস করে,","poem":1},{"lineBreak":true},{"text":"কিন্তু তারা সদাপ্রভুুকে ডাকেনা?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তারা ভয়ের সঙ্গে কাঁপে,","poem":1},{"lineBreak":true},{"text":"কারণ কিন্তু ঈশ্বর ধার্মিক সমাজের সঙ্গে থাকেন!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তুমি দরিদ্র ব্যক্তিকে লজ্জিত করেছ,","poem":1},{"lineBreak":true},{"text":"যদিও সদাপ্রভুু তাঁর আশ্রয়।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"আঃ! ইস্রায়েলের পরিত্রান সিয়োন থেকে আসবে!","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু যখন তাঁর লোকেদের বন্দিত্ব থেকে ফিরিয়ে আনবেন,","poem":1},{"lineBreak":true},{"text":"তখন যাকোব আনন্দ করবে","poem":1},{"lineBreak":true},{"text":"এবং ইস্রায়েল আনন্দিত হবে!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}