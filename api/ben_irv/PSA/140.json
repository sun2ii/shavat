{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["প্রধান বাদ্যকরের জন্য। দায়ূদের সঙ্গীত।"]},{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুু, দুষ্টদের থেকে আমাকে উদ্ধার কর,","poem":1},{"lineBreak":true},{"text":"হিংস্র মানুষ থেকে আমাকে বাঁচিয়ে রাখ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তারা হৃদয়ে খারাপ পরিকল্পনা করে,","poem":1},{"lineBreak":true},{"text":"তারা প্রতিদিন বিবাদকে নাড়িয়ে দেয়।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তাদের জিভের ক্ষত বিষধর সাপের মত;","poem":1},{"lineBreak":true},{"text":"তাদের ঠোঁটে সাপের বিষ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, দুষ্টের হাত থেকে আমাকে দূরে রাখ,","poem":1},{"lineBreak":true},{"text":"হিংস্র মানুষ থেকে আমাকে বাঁচিয়ে রাখ","poem":1},{"lineBreak":true},{"text":"যারা আমাকে ধাক্কা দেবার পরিকল্পনা করেছে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"অহঙ্কারীরা আমার জন্য ফাঁদ পেতেছে;","poem":1},{"lineBreak":true},{"text":"তারা জাল পেতে রেখেছে,","poem":1},{"lineBreak":true},{"text":"তারা আমার জন্য ফাঁদ পেতেছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আমি সদাপ্রভুুকে বললাম,","poem":1},{"lineBreak":true},{"text":"“তুমি আমার ঈশ্বর;","poem":1},{"lineBreak":true},{"text":"ক্ষমা করার জন্য আমার প্রার্থনা শোনো।”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, আমার প্রভু,","poem":1},{"lineBreak":true},{"text":"তুমি পরিত্রানের শক্তি,","poem":1},{"lineBreak":true},{"text":"তুমি যুদ্ধের দিনের আমাকে রক্ষা করেছ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, দুষ্টের ইচ্ছা পূর্ণ কোরো না;","poem":1},{"lineBreak":true},{"text":"তাদের চক্রান্ত সফল হতে দিও না।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যারা আমাকে ঘেরে তাদের মাথা উঁচু করে;","poem":1},{"lineBreak":true},{"text":"তাদের হুমকিকে তাদের ওপর এনে দেওয়া হোক;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তাদের ওপরে জ্বলন্ত কয়লা পড়ুক,","poem":1},{"lineBreak":true},{"text":"তাদের আগুনে,","poem":1},{"lineBreak":true},{"text":"গভীর খাতে ছুঁড়ে দাও,","poem":1},{"lineBreak":true},{"text":"কখনো যেন উঠতে না পারে।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"মন্দ বক্তা পৃথিবীতে নিরাপদে থাকতে পারবে না;","poem":1},{"lineBreak":true},{"text":"হিংস্র মানুষ মন্দকে শিকার করে ছুঁড়ে ফেলে দেবে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"আমি জানি যে সদাপ্রভুু বিবাদের কারণ বজায় রাখবে","poem":1},{"lineBreak":true},{"text":"এবং দরিদ্রদের বিচার নিস্পন্ন করবেন।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"অবশ্যই ধার্মিক লোকেরা তোমার নামে ধন্যবাদ দেবে;","poem":1},{"lineBreak":true},{"text":"সরল লোকেরা তোমার সামনে বাস করবে।","poem":1}]}],"footnotes"