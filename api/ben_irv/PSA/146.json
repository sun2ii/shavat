{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুুর প্রশংসা কর, আমার প্রাণ,","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা কর।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আমি সদাপ্রভুুর প্রশংসা করব যতদিন বাঁচবো;","poem":1},{"lineBreak":true},{"text":"আমার ঈশ্বরের প্রশংসা গান করব যতদিন আমি বেঁচে থাকবো।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমরা রাজাদের ওপর আস্থা রেখো না বা মানুষের সন্তানের ওপর,","poem":1},{"lineBreak":true},{"text":"যাদের কাছে পরিত্রান নেই।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"যখন তাঁর জীবনের শ্বাস থেমে যায়,","poem":1},{"lineBreak":true},{"text":"সে মাটির মধ্যে ফিরে যায়;","poem":1},{"lineBreak":true},{"text":"সেই দিনের ই তার পরিকল্পনা শেষ।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ধন্য সে, যার সাহায্যের জন্য যাকোবের ঈশ্বর সহায়,","poem":1},{"lineBreak":true},{"text":"যার আশা সদাপ্রভুু তার ঈশ্বর।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"সদাপ্রভু আকাশমণ্ডল ও পৃথিবী সৃষ্টি করেছেন,","poem":1},{"lineBreak":true},{"text":"সমুদ্র এবং সব কিছু তার মধ্যে আছে;","poem":1},{"lineBreak":true},{"text":"তিনি অনন্তকাল বিশ্বাসযোগ্যতা পালন করেন।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তিনি নিপীড়িতদের পক্ষে ন্যায় বিচার করেন","poem":1},{"lineBreak":true},{"text":"এবং তিনি ক্ষুধার্তদের খাদ্য দেন;","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু বন্দিদের মুক্ত করেন।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু অন্ধদের চোখ খুলে দেন,","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু অবনতদের ওঠান;","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু ধার্ম্মিকদেরকে প্রেম করেন।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু দেশের মধ্যে বিদেশীদের রক্ষা করেন;","poem":1},{"lineBreak":true},{"text":"তিনি পিতৃহীন এবং বিধবাকে ওপরে ওঠান","poem":1},{"lineBreak":true},{"text":"কিন্তু দুষ্টদের বিরোধিতা করেন।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু অনন্তকাল রাজত্ব করবেন;","poem":1},{"lineBreak":true},{"text":"তোমার ঈশ্বর, হে সিয়োন,","poem":1},{"lineBreak":true},{"text":"বংশানুক্রমে করবেন। সদাপ্রভুুর প্রশংসা কর।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}