xt":"এবং তাঁর ক্রোধে তাদের আতঙ্কিত করবেন, বলবেন,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“আমি নিজেই আমার রাজাকে অভিষিক্ত করেছি সিয়োনের উপর,","poem":1},{"lineBreak":true},{"text":"আমার পবিত্র পর্বতে।”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"আমি সদাপ্রভুুর একটি আদেশ ঘোষণা করব;","poem":1},{"lineBreak":true},{"text":"তিনি আমাকে বললেন,","poem":1},{"lineBreak":true},{"text":"“তুমি আমার পুত্র!","poem":1},{"lineBreak":true},{"text":"আজ আমি তোমার জন্ম দিয়েছি।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"আমার কাছে চাও","poem":1},{"lineBreak":true},{"text":"এবং আমি তোমার উত্তরাধিকারের জন্য সমস্ত জাতিকে","poem":1},{"lineBreak":true},{"text":"এবং তোমাদের অধিকারের জন্য","poem":1},{"lineBreak":true},{"text":"এবং পৃথিবীর দূরবর্তী অঞ্চলগুলোকে দেব।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তুমি একটি লোহার রাজদণ্ড দিয়ে তাদের ভাঙ্গবে,","poem":1},{"lineBreak":true},{"text":"তুমি তাদের কুমোরের পাত্রের মত সম্পূর্ণ ধ্বংস করবে।”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"তাই এখন, তোমরা রাজারা,","poem":1},{"lineBreak":true},{"text":"সতর্ক হও, সংশোধন হও,","poem":1},{"lineBreak":true},{"text":"তোমরা পৃথিবীর শাসকেরা।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ভয়ে সদাপ্রভুুর আরাধনা কর","poem":1},{"lineBreak":true},{"text":"এবং কম্পনের সঙ্গে আনন্দ কর।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তাঁর পুত্রকে প্রকৃত সম্মান দাও,","poem":1},{"lineBreak":true},{"text":"যেন ঈশ্বর তোমাদের উপরে ক্রুদ্ধ না হন","poem":1},{"lineBreak":true},{"text":"এবং যাতে তুমি মারা না যাও,","poem":1},{"lineBreak":true},{"text":"যখন তাঁর ক্রোধ দ্রুত প্রজ্জ্বলিত হয়।","poem":1},{"lineBreak":true},{"text":"ধন্য তারা,","poem":1},{"lineBreak":true},{"text":"যারা তাঁর আশ্রয় গ্রহণ করে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/2.json","thisChapt