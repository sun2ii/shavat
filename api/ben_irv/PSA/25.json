{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["দায়ূদের একটি গীত।"]},{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুু, তোমারই দিকে আমি আমার প্রাণ তুলে ধরি!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আমার ঈশ্বর, আমি তোমাকে বিশ্বাস করি।","poem":1},{"lineBreak":true},{"text":"আমাকে হতাশ হতে দিয়ো না;","poem":1},{"lineBreak":true},{"text":"আমার শত্রুদের আমার উপর জয়ী হতে দিয়ো না।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তোমার মধ্যে যারা আশা করে তারা কেউই লজ্জিত হবে না,","poem":1},{"lineBreak":true},{"text":"কিন্তু যারা অকারণে বিশ্বাসঘাতকতা করে তারাই লজ্জিত হবে!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, আমাকে তোমার পথ দেখাও;","poem":1},{"lineBreak":true},{"text":"তোমার পথের বিষয়ে আমাকে শিক্ষা দাও।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তোমার সত্য