{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"ধার্ম্মিকেরা, সদাপ্রভুুতে আনন্দ কর;","poem":1},{"lineBreak":true},{"text":"প্রশংসা করা ন্যায়পরায়ণদের জন্য উপযুক্ত।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"বীণার সাথে সদাপ্রভুুকে ধন্যবাদ দাও;","poem":1},{"lineBreak":true},{"text":"দশটি তারের বাদ্যযন্ত্রের সঙ্গে তাঁর প্রশংসা কর।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"তাঁর উদ্দেশ্যে নতুন গান গাও;","poem":1},{"lineBreak":true},{"text":"মধুর বাদ্য কর, জয়ধ্বনি কর","poem":1},{"lineBreak":true},{"text":"এবং আনন্দের সাথে গান কর।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"কারণ সদাপ্রভুুর বাক্য ন্যায়পরায়ণ","poem":1},{"lineBreak":true},{"text":"এবং তিনি যা কিছু করেন তা ন্যায্য।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তিনি ধার্ম্মিকতা এবং ন্যায়বিচার ভালোবাসেন।","poem":1},{"lineBreak":true},{"text":"পৃথিবীতে সদাপ্রভুুর চুক্তির বিশ্বস্ততা পূর্ণ হয়।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"স্বর্গে তৈরি করা হয় সদাপ্রভুুর বাক্যে","poem":1},{"lineBreak":true},{"text":"এবং সমস্ত তারা তাঁর মুখের শ্বাসের দ্বারা তৈরি হয়েছিল।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তিনি সমুদ্রের জলকে একসঙ্গে একটি স্তূপের মত সংগ্রহ করেন;","poem":1},{"lineBreak":true},{"text":"তিনি মহাসাগরকে ভান্ডারের মধ্যে রাখেন।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"সমস্ত পৃথিবী সদাপ্রভুুকে ভয় করুক;","poem":1},{"lineBreak":true},{"text":"জগতের সমস্ত নিবাসীরা তাঁর ভয়ে থাকো।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"কারণ তিনি কথা বললেন","poem":1},{"lineBreak":true},{"text":"এবং তার উত্পত্তি হল;","poem":1},{"lineBreak":true},{"text":"তিনি আদেশ দিলেন ও এটি একটি জায়গায় দাঁড়িয়ে রইল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু জাতিগুলোর ঐক্য ব্যর্থ করেন;","poem":1},{"lineBreak":true},{"text":"তিনি লোকেদের পরিকল্পনা বাতিল করেন।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"সদাপ্রভুুর পরিকল্পনা চিরকাল থাকে,","poem":1},{"lineBreak":true},{"text":"তাঁর হৃদয়ের পরিকল্পনা সমস্ত প্রজন্মের জন্য।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ধন্য সেই জাতি, যাঁর ঈশ্বর সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"যাদের তিনি নিজের অধিকার হিসাবে মনোনীত করেছেন।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, স্বর্গ থেকে দেখেন,","poem":1},{"lineBreak":true},{"text":"তিনি সমস্ত লোককে দেখেন।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"সে যেখানে অবস্থান করে সেখান থেকে,","poem":1},{"lineBreak":true},{"text":"পৃথিবীতে যারা বেঁচে আছে তাদের দেখেন।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তিনি যিনি তাদের হৃদয়কে গঠন করেছেন,","poem":1},{"lineBreak":true},{"text":"যা তাদের সমস্ত কাজ দেখায়।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"কোন রাজা বিশাল সেনাবাহিনীর দ্বারা রক্ষা পায় না;","poem":1},{"lineBreak":true},{"text":"একটি যোদ্ধা তার মহান শক্তির দ্বারা রক্ষা পায় না।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"জয়ের জন্য একটি ঘোড়ার আশা মিথ্যা,","poem":1},{"lineBreak":true},{"text":"তার মহান শক্তি সত্বেও,","poem":1},{"lineBreak":true},{"text":"সে উদ্ধার করতে পারবে না।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"দেখ, যারা তাঁকে ভয় করে তাদের উপরে সদাপ্রভুু চোখ থাকে,","poem":1},{"lineBreak":true},{"text":"যারা তাঁর চুক্তির বিশ্বস্ততার ওপর নির্ভর করে।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"মৃত্যুর হাত থেকে তাদের প্রাণ বাঁচাতে","poem":1},{"lineBreak":true},{"text":"এবং দূর্ভিক্ষের মাধ্যমে তাদের জীবিত রাখতে।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"আমরা সদাপ্রভুুর জন্য অপেক্ষায় রয়েছি;","poem":1},{"lineBreak":true},{"text":"তিনি আমাদের সাহায্য","poem":1},{"lineBreak":true},{"text":"এবং আমাদের ঢাল।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"আমাদের হৃদয় তাঁর মধ্যে আনন্দিত,","poem":1},{"lineBreak":true},{"text":"কারণ আমরা তাঁর পবিত্র নামের উপর বিশ্বাস করি।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, তোমার চুক্তির বিশ্বস্ততা আমাদের সাথে থাকুক।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}