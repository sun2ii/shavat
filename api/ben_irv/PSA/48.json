neBreak":true},{"text":"তিনি চিরকাল আমাদের পথ পথদর্শক হবে।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}