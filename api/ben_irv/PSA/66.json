ntent":[{"lineBreak":true},{"text":"চল, ঈশ্বরের কাজ দেখ;","poem":1},{"lineBreak":true},{"text":"মানবসন্তানদের কাজের বিষয়ে তিনি ভয়ঙ্কর।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তিনি সমুদ্রকে শুকনো ভূমিতে পরিণত করলেন;","poem":1},{"lineBreak":true},{"text":"তারা পায়ে হেঁটে নদীর মধ্যে দিয়ে গিয়েছিল;","poem":1},{"lineBreak":true},{"text":"তাতে সেই স্থানে আমরা আনন্দ করলাম।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তিনি নিয়মের দ্বারা চিরকাল কর্তৃত্ব করেন;","poem":1},{"lineBreak":true},{"text":"তাঁর চোখ জাতিদের নিরীক্ষণ করে;","poem":1},{"lineBreak":true},{"text":"বিদ্রোহীরা নিজেকে উচ্চ প্রশংসা না করুক। সেলা","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে, জাতিরা,","poem":1},{"lineBreak":true},{"text":"আমাদের ঈশ্বরের প্রশংসা কর","poem":1},{"lineBreak":true},{"text":"এবং তাঁর প্রশংসাধ্বনি শোনা উচিত।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তিনিই আমাদের জীবনের মধ্যে আমার প্রাণ রক্ষা করেন","poem":1},{"lineBreak":true},{"text":"এবং আমাদের পা টলতে দেন না।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কারণ তুমি, ঈশ্বর,","poem":1},{"lineBreak":true},{"text":"তুমি আমাদের পরীক্ষা করেছ;","poem":1},{"lineBreak":true},{"text":"রৌপ্য যেমন পরীক্ষা করা হয়","poem":1},{"lineBreak":true},{"text":"তেমনি আমাদেরকে পরীক্ষা করেছ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তুমি আমাদেরকে একটি জালের মধ্যে এনেছ;","poem":1},{"lineBreak":true},{"text":"আমাদের কোমরের উপরে বোঝা রেখেছ।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"তুমি আমাদের মাথার উপরে তুলেছ;","poem":1},{"lineBreak":true},{"text":"আমরা আগুন ও জলের মধ্যে দিয়ে গিয়েছিলাম,","poem":1},{"lineBreak":true},{"text":"কিন্তু তুমি আমাদেরকে সমৃদ্ধি স্থানে নিয়ে আস।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"আমি হোমবলি নিয়ে তোমার গৃহে প্রবেশ করব,","poem":1},{"