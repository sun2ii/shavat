:"verse","number":5,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, তোমার সমস্ত কাজ কত মহৎ।","poem":1},{"lineBreak":true},{"text":"তোমার সঙ্কল্প সমস্ত অতি গভীর।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"নরপশু জানে না,","poem":1},{"lineBreak":true},{"text":"নির্বোধ তা বোঝেনা।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"দুষ্টরা যখন ঘাসের মতন অঙ্কুরিত হয়,","poem":1},{"lineBreak":true},{"text":"অধর্মচারী সবাই যখন আনন্দিত হয়,","poem":1},{"lineBreak":true},{"text":"তখন তাদের চির বিনাশের জন্য এই রকম হয়।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"কিন্তু সদাপ্রভুু, তুমি অনন্তকাল রাজত্বকারী।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"কারণ দেখ, তোমার শত্রুরা, হে সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"দেখ, তোমার শত্রুরা বিনষ্ট হবে;","poem":1},{"lineBreak":true},{"text":"অধর্মচারীরা সকলে ছিন্ন ভিন্ন হবে।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"কিন্তু আমার শিং,","poem":1},{"lineBreak":true},{"text":"বুনো ষাঁড়ের শিংএর মত উঁচু করেছ;","poem":1},{"lineBreak":true},{"text":"তুমি আমাকে খুশির দ্বারা আশীষ দাও","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"আর আমার চোখ আমার শত্রুদের দশা দেখেছে;","poem":1},{"lineBreak":true},{"text":"আমার কান আমার বিরোধী দূরাচারদের দশা শুনতে পেয়েছে।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ধার্মিক লোক তালতরুর মত উৎফুল্ল হবে।","poem":1},{"lineBreak":true},{"text":"সে লিবানোনের এরস গাছের মত বাড়বে।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যারা সদাপ্রভুুর বাগানে রোপিত,","poem":1},{"lineBreak":true},{"text":"তারা আমাদের ঈশ্বরের প্রাঙ্গণে বৃদ্ধি পাবে।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তারা বৃদ্ধ বয়সেও ফল উৎপন্ন করবে,","poem":1},{"lineBreak":true},{"text":"তারা সরস ও তেজস্বী হবে;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"তার মাধ্যমে প্রচারিত হবে যে,","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু সরল; তিনি আমার শৈল","poem":1},{"lineBreak":true},{"text":"এবং তাতে অন্যায় নাই।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}