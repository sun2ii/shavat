{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুু রাজত্ব করেন; তিনি মহিমাতে সজ্জিত;","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু সজ্জিত, তিনি পরাক্রমে বদ্ধকটি;","poem":1},{"lineBreak":true},{"text":"আর জগৎও অটল, তা বিচলিত হইবে না।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"তোমার সিংহাসন প্রাচীন দিন থেকে স্থাপিত;","poem":1},{"lineBreak":true},{"text":"অনাদিকাল থেকে তুমি বিদ্যমান।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"হে সদাপ্রভুু, মহাসাগরগুলি উঠেছে,","poem":1},{"lineBreak":true},{"text":"তারা তাদের ধ্বনি উঠিয়েছে,","poem":1},{"lineBreak":true},{"text":"মহাসাগরগুলির তরঙ্গ সশব্দে ভেঙে পড়ছে","poem":1},{"lineBreak":true},{"text":"এবং গর্জন করছে।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"জলসমূহের কল্লোল ধ্বনির থেকে,","poem":1},{"lineBreak":true},{"text":"সমুদ্রের প্রবল তরঙ্গমালার থেকে,","poem":1},{"lineBreak":true},{"text":"উর্ধস্থ সদাপ্রভুু বলবান।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"তোমার সাক্ষ্য সকল অতি বিশ্বসনীয়","poem":1},{"lineBreak":true},{"text":"পবিত্রতা তোমার গৃহের শোভা,","poem":1},{"lineBreak":true},{"text":"হে সদাপ্রভুু, চিরদিনের জন্য।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}