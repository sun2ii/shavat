{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"হে প্রতিফল দানকারী ঈশ্বর সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"ঈশ্বর আপনার ক্রো","poem":1},{"noteId":27},{"text":"ধ প্রকাশ করুন।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ওঠ, হে পৃথিবীর বিচারকর্ত্তা,","poem":1},{"lineBreak":true},{"text":"অহঙ্কারীদেরকে অপকারের প্রতিফল দাও।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"দুষ্টরা কত কাল, হে সদাপ্রভু,","poem":1},{"lineBreak":true},{"text":"দুষ্টরা কত কাল উল্লাস করবে?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তারা বকবক করছে, সগর্বে কথা বলছে,","poem":1},{"lineBreak":true},{"text":"অধর্মচারী সবাই অহঙ্কার করছে।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"হে সদাপ্রভুু, তোমার প্রজাদেরকেই তারা চূর্ণ করছে,","poem":1},{"lineBreak":true},{"text":"তোমার অধিকারকে দুঃখ দিচ্ছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তারা বিধবা ও প্রবাসীকে বধ করছে;","poem":1},{"lineBreak":true},{"text":"পিতৃহীনদেরকে মেরে ফেলছে।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"তারা বলছে সদাপ্রভুু দেখবেন না,","poem":1},{"lineBreak":true},{"text":"যাকোবের ঈশ্বর বিবেচনা করবেন না।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"হে লোকদের মধ্যবর্ত্তী নরপশুরা,","poem":1},{"lineBreak":true},{"text":"বিবেচনা কর; হে নির্বোধেরা,","poem":1},{"lineBreak":true},{"text":"কবে তোমাদের সুবুদ্ধি হবে?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"যিনি কান সৃষ্টি করেছেন,","poem":1},{"lineBreak":true},{"text":"তিনি কি শুনবেন না?","poem":1},{"lineBreak":true},{"text":"যিনি চোখ গঠন করেছেন,","poem":1},{"lineBreak":true},{"text":"তিনি কি দেখবেন না?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"যিনি জাতিদের শিক্ষাদাতা,","poem":1},{"lineBreak":true},{"text":"তিনি কি ভর্ত্সনা করবেন না?","poem":1},{"lineBreak":true},{"text":"তিনিই তো মানুষকে জ্ঞান শিক্ষা দেন।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু, মানুষের কল্পনাগুলি জানেন,","poem":1},{"lineBreak":true},{"text":"সেগুলো সবই ভ্রষ্ট।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ধন্য সেই ব্যক্তি যাকে তুমি শাসন কর,","poem":1},{"lineBreak":true},{"text":"হে সদাপ্রভুু যাকে তুমি আপন ব্যবস্থা থেকে শিক্ষা দাও,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"যেন তুমি তাকে বিপদের দিনের র থেকে বিশ্রাম দাও,","poem":1},{"lineBreak":true},{"text":"দুষ্টের জন্য যতক্ষণ পর্যন্ত কুয়ো খোঁড়া না হয়।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"কারণ সদাপ্রভুু নিজের প্রজাদেরকে দূর করবেন না,","poem":1},{"lineBreak":true},{"text":"নিজের অধিকার ছাড়বেন না।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"রাজ শাসন আবার ধার্মিকতার কাছে আসবে;","poem":1},{"lineBreak":true},{"text":"সরলমনা সকলেই তার অনুগামী হবে।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"কে আমার পক্ষ হয়ে দূরাচারদের বিরুদ্ধে উঠবে?","poem":1},{"lineBreak":true},{"text":"কে আমার পক্ষে দুষ্টদের বিরুদ্ধে দাড়াবে?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু যদি আমায় সাহায্য না করতেন,","poem":1},{"lineBreak":true},{"text":"আমার প্রাণ তাড়াতাড়ি নিঃশব্দ জায়গায় বসবাস করত।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"যখন আমি বলতাম, আমার পা বিচলিত হল,","poem":1},{"lineBreak":true},{"text":"তখন, হে সদাপ্রভুু,","poem":1},{"lineBreak":true},{"text":"তোমার দয়া আমাকে সুস্থির রাখত।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"আমার মনের চিন্তা বাড়ার দিনের,","poem":1},{"lineBreak":true},{"text":"তোমার দেওয়া সান্ত্বনা আমার প্রাণকে আহ্লাদিত করে","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"দুষ্টতার সিংহাসন কি তোমার সখা হতে পারে?","poem":1},{"lineBreak":true},{"text":"যারা সংবিধানের মাধ্যমে অন্যায় তৈরী করে?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"তারা ধার্ম্মিকের প্রাণের বিরুদ্ধে দলবদ্ধ হয়,","poem":1},{"lineBreak":true},{"text":"নির্দোষের রক্তকে দোষী করে।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"কিন্তু সদাপ্রভুু আমার উচ্চ দূর্গ হয়েছেন,","poem":1},{"lineBreak":true},{"text":"আমার ঈশ্বর আমার আশ্রয়-শৈল হয়েছেন।","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"তিনি তাদের অধর্ম্ম তাদেরই উপরে দিয়েছেন,","poem":1},{"lineBreak":true},{"text":"তাদের দুষ্টতায় তাদের উচ্ছিন্ন করবেন;","poem":1},{"lineBreak":true},{"text":"সদাপ্রভুু আমাদের ঈশ্বর,","poem":1},{"lineBreak":true},{"text":"তাদেরকেই উচ্ছিন্ন করবেন।","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"হে ঈশ্বর তোমার দীপ্তি প্রকাশ কর","reference":{"chapter":94,"verse":1}}]},