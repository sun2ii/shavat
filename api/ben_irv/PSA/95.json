{"translation":{"id":"ben_irv","name":"ইন্ডিয়ান রিভাইজড ভার্সন (IRV) - বেঙ্গলী","website":"https://ebible.org/Scriptures/details.php?id=benirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benirv","licenseNotes":null,"shortName":"IRV","englishName":"Bengali Indian Revised Version Bible: ইনডিযান রিভাইজড ভারসন (IRV) - বেঙগলী","language":"ben","textDirection":"ltr","sha256":"2a2b2ff90ae5be551be326fb4ef17ad7a685478522937c7968e99fb41af6de39","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_irv","name":"গীতসংহিতা","commonName":"গীতসংহিতা","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"f844489d1c3c250e740e940e64c36661d902723ca465a692454eea00cc3d5614","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"এস, আমরা সদাপ্রভুুর উদ্দেশ্যে আনন্দ গান করি,","poem":1},{"lineBreak":true},{"text":"আমাদের পরিত্রানের শৈলর জন্য জয়ধ্বনি করি।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আমরা ধন্যবাদ দিতে দিতে তার উপস্থিতিতে প্রবেশ করি,","poem":1},{"lineBreak":true},{"text":"গান গেয়ে তার উদ্দেশ্যে জয়ধ্বনি করি।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"কারণ সদাপ্রভুু, মহান ঈশ্বর,","poem":1},{"lineBreak":true},{"text":"তিনি সমস্ত দেবতাদের উপরে মহান রাজা,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"পৃথিবীর গভীরতম স্থানগুলো তার হাতের মধ্যে,","poem":1},{"lineBreak":true},{"text":"পর্বতের চূড়াগুলো তারই।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"সমুদ্র তার, তিনিই তা নির্মাণ করেছেন,","poem":1},{"lineBreak":true},{"text":"তার হাত শুকনো জমি গঠন করেছে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"এস, আমরা আরাধনা করি ও নত হই,","poem":1},{"lineBreak":true},{"text":"আমাদের সৃষ্টিকর্ত্তা সদাপ্রভুুর সামনে হাঁটু পাতি।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"কারণ তিনিই আমাদের ঈশ্বর,","poem":1},{"lineBreak":true},{"text":"আমরা তার চরানির প্রজা ও তার নিজের মেষ। আহা আজই,","poem":1},{"lineBreak":true},{"text":"তোমরা তার স্বর শুনবে।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"তোমরা নিজেদের হৃদয়কে কঠিন করনা,","poem":1},{"lineBreak":true},{"text":"যেমন মরীরায়, যেমন মরুপ্রান্তের মধ্যে মঃসার দিনের, করেছিলে।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"তখন তোমাদের পিতৃপুরুষেরা আমার পরীক্ষা করল,","poem":1},{"lineBreak":true},{"text":"আমার বিচার করল, আমার কাজও দেখল।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"চল্লিশ বছর পর্যন্ত আমি সেই জাতির প্রতি অসন্তুষ্ট ছিলাম,","poem":1},{"lineBreak":true},{"text":"আমি বলেছিলাম এদের মন উদ্ভ্রান্ত;","poem":1},{"lineBreak":true},{"text":"তারা আমার আজ্ঞা মানলো না।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"তাই আমি রেগে শপথ করলাম,","poem":1},{"lineBreak":true},{"text":"এরা আমার বিশ্রামের জায়গায় কখনো ঢুকবে না।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}