ber":4,"content":[{"lineBreak":true},{"text":"সমস্ত পৃথিবী; সদাপ্রভুুর উদ্দেশ্যে আনন্দের জন্য চিত্কার কর।","poem":1},{"lineBreak":true},{"text":"জয়গান কর, আনন্দগান কর। প্রশংসা গাও।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"বীণার সঙ্গে সদাপ্রভুুর উদ্দেশ্যে প্রশংসা গান কর,","poem":1},{"lineBreak":true},{"text":"বীণা ও সুমধুর গানের সঙ্গে।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"তূরী ও শিঙার আওয়াজের সঙ্গে","poem":1},{"lineBreak":true},{"text":"রাজা সদাপ্রভুুর সামনে আনন্দময় শব্দ কর।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"সমুদ্র ও তার মধ্যেকার সবই গর্জন করুক,","poem":1},{"lineBreak":true},{"text":"পৃথিবী ও যারা তার মধ্যে বাস করে তারাও করুক;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"নদীরা তাদের হাতে হাততালি দিক","poem":1},{"lineBreak":true},{"text":"এবং পর্বতরা আনন্দের জন্য চিত্কার করুক;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"সদাপ্রভুু পৃথিবীর বিচার করতে আসছেন;","poem":1},{"lineBreak":true},{"text":"তিনি ধার্ম্মিকতায় পৃথিবীকে ও জাতিদের সুবিচারে বিচার করবেন।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_irv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_irv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_irv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}