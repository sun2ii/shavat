e},{"text":"আমার কনে, আমার বোন,","poem":1},{"lineBreak":true},{"text":"আমার ঘুঘু, আমার নিষ্কলঙ্কিত সেই জন।","poem":1},{"lineBreak":true},{"text":"শিশিরে আমার মাথা ভিজে গেছে,","poem":1},{"lineBreak":true},{"text":"রাতের কুয়াশায় আমার চুল ভরে গেছে।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“আমি আমার পোশাক খুলে ফেলেছি;","poem":1},{"lineBreak":true},{"text":"আমি আবার কিভাবে তা পরব? আমি আমার পা ধুয়েছি;","poem":1},{"lineBreak":true},{"text":"আমি আবার কিভাবে তা নোংরা করব?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"দরজার ছিদ্র দিয়ে আমার প্রিয়তম তাঁর হাত রাখলেন,","poem":1},{"lineBreak":true},{"text":"আমার মন তাঁর জন্য ব্যাকুল হয়ে উঠলো।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"আমি আমার প্রিয়তমকে দরজা খুলে দেওয়ার জন্য উঠলাম,","poem":1},{"lineBreak":true},{"text":"আমার হাত থেকে গন্ধরস ঝরছিল,","poem":1},{"lineBreak":true},{"text":"আমার আঙ্গুল গন্ধরসে ভেজা ছিল।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"আমি আমার প্রিয়তমের জন্য দরজা খুললাম,","poem":1},{"lineBreak":true},{"text":"কিন্তু আমার প্রিয় ফিরে গিয়েছিলেন,","poem":1},{"lineBreak":true},{"text":"চলে গিয়েছিলেন। আমার অন্তর নিরাশায় ডুবে গিয়েছিল।","poem":1},{"lineBreak":true},{"text":"আমি তাঁকে খুঁজলাম, কিন্তু পেলাম না;","poem":1},{"lineBreak":true},{"text":"আমি তাঁকে ডাকলাম,","poem":1},{"lineBreak":true},{"text":"কিন্তু তিনি উত্তর দিলেন না।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"শহরে ঘুরে বেড়ানো","poem":1},{"lineBreak":true},{"text":"পাহারাদারেরা আমাকে দেখতে পেল;","poem":1},{"lineBreak":true},{"text":"তারা আমাকে আঘাত করলো এবং ক্ষতবিক্ষত করলো;","poem":1},{"lineBreak":true},{"text":"প্রাচীরের পাহারাদারেরা আমার পোশাক কেড়ে নিল।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"যিরূশালেমের মেয়েরা,","poem":1},{"lineBreak":true},{"text":"আমি তোমাদের বলছি,","poem":1},{"lineBreak":true},{"text":"যদি তোমরা আম