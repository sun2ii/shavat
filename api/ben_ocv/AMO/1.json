{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"AMO","translationId":"ben_ocv","name":"আমোষ","commonName":"আমোষ","title":"আমোষ","order":30,"numberOfChapters":9,"sha256":"a779a1c0072de8e48c62dfcad80b61407224283d68b4f6299fc28ea262bf10d9","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ben_ocv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["আমোষের বাণী। তিনি ছিলেন তকোয়ের একজন মেষপালক",{"noteId":0},"। তিনি যিহূদার রাজা উষিয়ের সময়ে ও যিহোয়াশের",{"noteId":1},"পুত্র ইস্রায়েলের রাজা যারবিয়ামের রাজত্বকালে, ভূমিকম্পের দুই বছর আগে ইস্রায়েল সম্পর্কে এই দর্শন পান।"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["তিনি বললেন,",{"text":"“সদাপ্রভু সিয়োন থেকে গর্জন করছেন,","poem":1},{"text":"তিনি জেরুশালেম থেকে শোনাচ্ছেন বজ্রধ্বনি;","poem":2},{"text":"মেষপালকদের চারণভূমিগুলি শুকিয়ে যাচ্ছে,","poem":1},{"text":"কর্মিলের শিখরস্থান শুকনো হচ্ছে।”","poem":2}]},{"type":"heading","content":["ইস্রায়েলের প্রতিবেশী রাজ্যগুলির বিচার"]},{"type":"verse","number":3,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“দামাস্কাসের তিনটি পাপের জন্য,","poem":1},{"text":"এমনকি, চারটির জন্য, আমি আমার ক্রোধ ফিরিয়ে নেব না।","poem":2},{"text":"কারণ সে লোহার দাঁতযুক্ত শস্য মাড়াই কল দিয়ে","poem":1},{"text":"গিলিয়দকে চূর্ণ করেছে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"আমি হসায়েল কুলের উপরে আগুন পাঠাব,","poem":1},{"text":"তা বিন্‌হদদের দুর্গগুলি গ্রাস করবে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"আমি দামাস্কাসের তোরণদ্বার ভেঙে ফেলব;","poem":1},{"text":"আমি আবন-উপত্যকায়","poem":2},{"noteId":2},{"text":"স্থিত রাজাকে ধ্বংস করব","poem":2},{"lineBreak":true},{"text":"এবং তাকেও করব, যে বেথ-এদনে রাজদণ্ড ধারণ করে।","poem":2},{"text":"অরাম দেশের লোকেরা কীরে নির্বাসিত হবে,”","poem":1},{"text":"সদাপ্রভু বলেন।","poem":2}]},{"type":"verse","number":6,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“গাজার তিনটি পাপের জন্য,","poem":1},{"text":"এমনকি, চারটির জন্য, আমি আমার ক্রোধ ফিরিয়ে নেব না।","poem":2},{"text":"কারণ সে সমস্ত সমাজকে বন্দি করে","poem":1},{"text":"ইদোমের কাছে তাদের বিক্রি করেছিল।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমি গাজার প্রাচীরগুলির উপরে আগুন পাঠাব,","poem":1},{"text":"তা তার দুর্গগুলিকে গ্রাস করবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আমি অস্‌দোদের রাজাকে ধ্বংস করব,","poem":1},{"text":"অস্কিলোনের রাজদণ্ডধারীকেও করব।","poem":2},{"text":"আমি ইক্রোণের বিপক্ষে আমার হাত প্রসারিত করব,","poem":1},{"text":"যতক্ষণ না শেষতম ফিলিস্তিনীর মৃত্যু হয়,”","poem":2},{"lineBreak":true},{"text":"সার্বভৌম সদাপ্রভু বলেন।","poem":2}]},{"type":"verse","number":9,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“সোরের তিনটি পাপের জন্য,","poem":1},{"text":"এমনকি চারটির জন্য, আমি আমার ক্রোধ ফিরিয়ে নেব না।","poem":2},{"text":"যেহেতু সে ভ্রাতৃত্বের চুক্তি অগ্রাহ্য করে","poem":1},{"text":"বন্দিদের সবাইকে ইদোমের কাছে বিক্রি করেছিল,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তাই আমি সোরের প্রাচীরগুলিতে আগুন পাঠাব,","poem":1},{"text":"তা তার দুর্গগুলিকে গ্রাস করবে।”","poem":2}]},{"type":"verse","number":11,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“ইদোমের তিনটি পাপের জন্য,","poem":1},{"text":"এমনকি, চারটির জন্য, আমি আমার ক্রোধ ফিরিয়ে নেব না।","poem":2},{"text":"যেহেতু সে তরোয়াল নিয়ে তার ভাইকে তাড়া করেছিল","poem":1},{"text":"এবং দেশের মহিলাদের হত্যা করেছিল,","poem":2},{"text":"কারণ তার ক্রোধ অবিরাম বৃদ্ধি পেয়েছিল,","poem":1},{"text":"তার কোপ অবারিতভাবে জ্বলে উঠেছিল।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"আমি তৈমনের উপরে আগুন পাঠাব,","poem":1},{"text":"তা বস্রার সমস্ত দুর্গকে গ্রাস করবে।”","poem":2}]},{"type":"verse","number":13,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“অম্মোনের তিনটি পাপের জন্য,","poem":1},{"text":"এমনকি, চারটির জন্য, আমি আমার ক্রোধ ফিরিয়ে নেব না।","poem":2},{"text":"যেহেতু সে গিলিয়দের গর্ভবতী নারীদের উদর বিদীর্ণ করেছিল,","poem":1},{"text":"যেন সে নিজের সীমানা বৃদ্ধি করতে পারে,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তাই আমি রব্বার প্রাচীরগুলিতে আগুন পাঠাব,","poem":1},{"text":"তা তার সমস্ত দুর্গকে গ্রাস করবে","poem":2},{"text":"যুদ্ধের দিনে রণনাদের কালে,","poem":1},{"text":"ঝড়ের সময়ে প্রবল ঘূর্ণিবায়ুর কালে,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তার রাজা নির্বাসিত হবে,","poem":1},{"text":"একইসঙ্গে নির্বাসিত হবে তার কর্মকর্তারাও,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু বলেন।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"পাঠন্তরে, পশুপালক বা গোপালক।","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"বা যোয়াশ।","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"আবন-এর অর্থ, দুষ্টতা।","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/ben_ocv/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}