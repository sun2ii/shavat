{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"AMO","translationId":"ben_ocv","name":"আমোষ","commonName":"আমোষ","title":"আমোষ","order":30,"numberOfChapters":9,"sha256":"a779a1c0072de8e48c62dfcad80b61407224283d68b4f6299fc28ea262bf10d9","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ben_ocv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["ইস্রায়েলের বিরুদ্ধে সাক্ষীদের তলব"]},{"type":"verse","number":1,"content":["ওহে ইস্রায়েলের লোকেরা, সদাপ্রভু তোমাদের বিরুদ্ধে যা বলেছেন, তোমরা সেই বাক্য শোনো। আমি যাদের মিশর থেকে মুক্ত করে এনেছি, সেই সমস্ত গোষ্ঠীর বিরুদ্ধে বলা বাক্য শোনো:"]},{"type":"verse","number":2,"content":[{"text":"“পৃথিবীর সমস্ত গোষ্ঠীর মধ্যে,","poem":1},{"text":"আমি কেবলমাত্র তোমাদেরই মনোনীত করেছি;","poem":2},{"text":"তাই তোমাদের সব পাপের জন্য,","poem":1},{"text":"আমি তোমাদের শাস্তি দেব।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"দুজন মানুষ এক পরামর্শ না হলে","poem":1},{"text":"তারা কি পথে একসঙ্গে চলতে পারে?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ঘন জঙ্গলে শিকার না পেলে","poem":1},{"text":"কোনো সিংহ কি গর্জন করে?","poem":2},{"text":"কোনো শিকার না ধরে","poem":1},{"text":"সে কি তার গহ্বরে হুংকার দেয়?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"কোনো ফাঁসকল পাতা না থাকলে,","poem":1},{"text":"পাখি কি মাটিতে ফাঁদে ধরা পড়ে?","poem":2},{"text":"কিছু না ধরা পড়লে,","poem":1},{"text":"মাটি থেকে কোনো কল কি আপনা-আপনি ছোটে?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"নগরের মধ্যে তূরী বাজলে,","poem":1},{"text":"লোকেরা কি ভয়ে কাঁপে না?","poem":2},{"text":"যখন কোনো নগরে বিপর্যয় উপস্থিত হয়,","poem":1},{"text":"তা কি সদাপ্রভু থেকে হয় না?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"নিশ্চয়ই সদাপ্রভু, তাঁর দাস ভাববাদীদের কাছে","poem":1},{"text":"নিজের পরিকল্পনা প্রকাশ না করে,","poem":2},{"lineBreak":true},{"text":"সার্বভৌম সদাপ্রভু কিছুই করেন না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"সিংহ গর্জন করলে—","poem":1},{"text":"কে না ভয় করবে?","poem":2},{"text":"সার্বভৌম সদাপ্রভু কথা বলেন—","poem":1},{"text":"কে না ভবিষ্যদ্‌বাণী করবে?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"তোমরা অস্‌দোদের দুর্গগুলিতে,","poem":1},{"text":"ও মিশরের দুর্গগুলির কাছে এই বার্তা ঘোষণা করো:","poem":2},{"text":"“তোমরা শমরিয়ার পাহাড়গুলির কাছে সমবেত হও;","poem":1},{"text":"আর তার মধ্যে মহা অস্থিরতা দেখো,","poem":2},{"lineBreak":true},{"text":"তার প্রজাদের মধ্যে সংঘটিত নিপীড়ন দেখো।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“তারা জানে না ন্যায়সংগত কাজ কীভাবে করতে হয়,”","poem":1},{"text":"সদাপ্রভু এই কথা ঘোষণা করেন,","poem":2},{"text":"“তারা তাদের দুর্গগুলিতে","poem":1},{"text":"অত্যাচার ও লুটের জিনিস সঞ্চিত করেছে।”","poem":2}]},{"type":"verse","number":11,"content":["অতএব, সার্বভৌম সদাপ্রভু এই কথা বলেন:",{"text":"“এক শত্রু দেশকে ছারখার করে দেবে,","poem":1},{"text":"সে তোমার ঘাঁটিগুলি ভেঙে ফেলবে","poem":2},{"lineBreak":true},{"text":"ও তোমার দুর্গগুলি লুট করবে।”","poem":2}]},{"type":"verse","number":12,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“মেষপালক যেমন সিংহের মুখ থেকে","poem":1},{"text":"দুটি পায়ের হাড় বা একটি কানের টুকরো উদ্ধার করে,","poem":2},{"lineBreak":true},{"text":"তেমনই ইস্রায়েলীরাও রক্ষা পাবে,","poem":2},{"text":"যারা শমরিয়ায় তাদের বিছানার প্রান্তে","poem":1},{"text":"বা দামাস্কাসে তাদের পালঙ্কের কোণে বসে থাকে।”","poem":2}]},{"type":"verse","number":13,"content":["“তোমরা এই কথা শোনো ও যাকোবের কুলের বিপক্ষে সাক্ষ্য দাও,” বলেন প্রভু, সর্বশক্তিমান ঈশ্বর সদাপ্রভু।"]},{"type":"verse","number":14,"content":[{"text":"“যেদিন আমি ইস্রায়েলের সব পাপের জন্য তাদের শাস্তি দিই,","poem":1},{"text":"আমি বেথেলের সব বেদি ধ্বংস করব;","poem":2},{"text":"বেদির শৃঙ্গগুলি কেটে ফেলা হবে","poem":1},{"text":"ও সেগুলি মাটিতে পতিত হবে।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"আমি শীতযাপনের গৃহ","poem":1},{"text":"ও গ্রীষ্মযাপনের গৃহকে ভেঙে ফেলব;","poem":2},{"text":"হাতির দাঁতে সুসজ্জিত গৃহগুলি ধ্বংস হবে","poem":1},{"text":"এবং অট্টালিকাগুলি ভূমিসাৎ করা হবে,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু ঘোষণা করেন।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}