{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ECC","translationId":"ben_ocv","name":"উপদেশক","commonName":"উপদেশক","title":"উপদেশক","order":21,"numberOfChapters":12,"sha256":"b2ffcd4f21423bf7390f656c3fc00fdde200987b7ede7de5908fe631db4256c2","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ben_ocv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"তোমার যৌবনকালে","poem":1},{"text":"তোমার সৃষ্টিকর্তাকে স্মরণ করো,","poem":2},{"text":"দুঃখের দিনগুলি আসার আগে","poem":1},{"text":"আর সেই বছর সকল কাছে আসার সময় তুমি যখন বলবে,","poem":2},{"lineBreak":true},{"text":"“এই সবে আমার কোনো আনন্দ নেই”—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তখন সূর্য ও আলো","poem":1},{"text":"আর চাঁদ ও তারা যখন অন্ধকার হবে,","poem":2},{"lineBreak":true},{"text":"আর বৃষ্টির পরে মেঘ ফিরে আসে;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"সেদিনে বাড়ির রক্ষাকারীরা কাঁপবে,","poem":1},{"text":"আর শক্তিশালী লোকেরা নত হবে,","poem":2},{"text":"যারা পেষণ করে তারা অল্প সংখ্যক বলে কাজ ছেড়ে দেবে।","poem":1},{"text":"আর যারা জানালার ভিতর থেকে দেখে তাদের দৃষ্টি অস্পষ্ট হবে;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যখন রাস্তার দিকের দরজা বন্ধ হয়ে যাবে","poem":1},{"text":"আর জাঁতার আওয়াজ কমে যাবে;","poem":2},{"text":"যখন পাখির আওয়াজে লোকে উঠবে,","poem":1},{"text":"কিন্তু তাদের সব গান ক্ষীণ হয়ে যাবে;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"যখন লোকেরা উঁচু জায়গাকে","poem":1},{"text":"আর রাস্তার বিপদকে ভয় পাবে;","poem":2},{"text":"যখন কাঠবাদাম গাছে ফুল ফুটবে","poem":1},{"text":"আর ফড়িং টেনে টেনে হাঁটবে","poem":2},{"lineBreak":true},{"text":"এবং বাসনা আর উত্তেজিত হবে না।","poem":2},{"text":"তখন লোকে তাদের অনন্তকালের বাড়িতে চলে যাবে","poem":1},{"text":"আর বিলাপকারীরা পথে পথে ঘুরবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"রুপোর তার ছিঁড়ে যাওয়ার আগে,","poem":1},{"text":"কিংবা সোনার পাত্র ভেঙে যাওয়ার আগে;","poem":2},{"text":"ফোয়ারার কাছে কলশি চুরমার করার আগে,","poem":1},{"text":"কিংবা কুয়োর জল তোলার চাকা ভেঙে যাওয়ার আগে—তাকে স্মরণ করো।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আর ধুলো মাটিতেই ফিরে যাবে যেখান থেকে সে এসেছে,","poem":1},{"text":"এবং আত্মা যাঁর দান, সেই ঈশ্বরের কাছেই ফিরে যাবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"উপদেশক বললেন, “অসার! অসার!","poem":1},{"text":"সবকিছুই অসার!”","poem":2}]},{"type":"heading","content":["এই বিষয়ের উপসংহার"]},{"type":"verse","number":9,"content":["উপদেশক নিজেই কেবল জ্ঞানবান ছিলেন না, কিন্তু তিনি লোকদের জ্ঞান শিক্ষা দিয়েছেন। তিনি চিন্তা করে ও পরীক্ষা করে অনেক প্রবাদ সাজিয়েছেন।"]},{"type":"verse","number":10,"content":["উপদেশক উপযুক্ত শব্দের খোঁজ করেছেন, আর তিনি যা লিখেছেন তা খাঁটি ও সত্যিকথা।"]},{"type":"verse","number":11,"content":["জ্ঞানবান লোকদের কথা রাখালের অঙ্কুশের মতো, তাদের কথাগুলি একত্র করলে মনে হয় যেন সেগুলি সব শক্ত করে গাঁথা পেরেক—যা একজন রাখাল বলেছেন।"]},{"type":"verse","number":12,"content":["হে আমার সন্তান, এর সঙ্গে কিছু যোগ করা হচ্ছে কি না সেই বিষয় সতর্ক থেকো। বই লেখার শেষ নেই আর অনেক পড়াশোনায় শরীর ক্লান্ত হয়।"]},{"type":"verse","number":13,"content":[{"text":"এখন সবকিছু তো শোনা হল;","poem":1},{"text":"তবে শেষ কথা এই যে","poem":2},{"text":"ঈশ্বরকে ভয় করো এবং তাঁর আজ্ঞাসকল পালন করো,","poem":1},{"text":"কেননা এটাই সমস্ত মানুষের কর্তব্য।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"কারণ ঈশ্বর প্রত্যেকটি কাজের বিচার করবেন,","poem":1},{"text":"এমনকি সমস্ত গুপ্ত বিষয়,","poem":2},{"lineBreak":true},{"text":"তা ভালো হোক বা মন্দ হোক।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}