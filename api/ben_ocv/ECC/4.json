{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ECC","translationId":"ben_ocv","name":"উপদেশক","commonName":"উপদেশক","title":"উপদেশক","order":21,"numberOfChapters":12,"sha256":"b2ffcd4f21423bf7390f656c3fc00fdde200987b7ede7de5908fe631db4256c2","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ben_ocv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["নিপীড়ন, পরিশ্রম, বন্ধুহীনতা"]},{"type":"verse","number":1,"content":["পরে আমি তাকালাম আর দেখলাম সূর্যের নিচে যেসব অত্যাচার হয়",{"text":"আমি নিপীড়িতদের চোখের জল দেখলাম—","poem":1},{"text":"আর তাদের কোনো সান্ত্বনাকারী নেই;","poem":2},{"text":"সমস্ত ক্ষমতা তাদের নিপীড়নকারীদের পক্ষে—","poem":1},{"text":"আর তাদের কোনো সান্ত্বনাকারী নেই।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"এবং আমি ঘোষণা করলাম যে মৃতেরা,","poem":1},{"text":"যারা আগেই মারা গেছে,","poem":2},{"text":"তারা জীবিতদের থেকে আনন্দে আছে,","poem":1},{"text":"যারা এখনও জীবিত।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"কিন্তু উভয়ের চেয়েও ভালো হল","poem":1},{"text":"যার এখনও জন্ম হয়নি,","poem":2},{"text":"যে কখনও মন্দ দেখেনি","poem":1},{"text":"যা কিছু সূর্যের নিচে করা হয়।","poem":2}]},{"type":"verse","number":4,"content":["আর আমি দেখলাম একজনের প্রতি হিংসার দরুনই মানুষ সব পরিশ্রম করে এবং সফলতা লাভ করে। এটাও অসার, কেবল বাতাসের পিছনে দৌড়ানো।"]},{"type":"verse","number":5,"content":[{"text":"বোকারা হাত গুটিয়ে রাখে","poem":1},{"text":"এবং নিজেদের ধ্বংস করে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"দুই মুঠো পরিশ্রম পাওয়া","poem":1},{"text":"এবং কেবল বাতাসের পিছনে দৌড়ানোর চেয়ে","poem":2},{"lineBreak":true},{"text":"এক হাত শান্তি পাওয়া ভালো।","poem":2}]},{"type":"verse","number":7,"content":["আবার আমি সূর্যের নিচে অসারতা দেখতে পেলাম"]},{"type":"verse","number":8,"content":[{"text":"কোনো একজন লোক একেবারে একা;","poem":1},{"text":"তার ছেলেও নেই কিংবা ভাইও নেই,","poem":2},{"text":"তার পরিশ্রমের শেষ নেই,","poem":1},{"text":"তবুও তার ধনসম্পদে তার চোখ তৃপ্ত নয়।","poem":2},{"text":"সে জিজ্ঞাসা করল, “আমি কার জন্য পরিশ্রম করছি,","poem":1},{"text":"আর আমি কেন নিজেকে আনন্দ থেকে বঞ্চিত করছি?”","poem":2},{"text":"এটাও অসার—","poem":1},{"text":"ভারী কষ্টজনক!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"একজনের চেয়ে দুজন ভালো,","poem":1},{"text":"কারণ তাদের কাজে অনেক ভালো ফল হয়","poem":2}]},{"type":"verse","number":10,"content":[{"text":"যদি একজন পড়ে যায়,","poem":1},{"text":"তবে তার সঙ্গী তাকে উঠাতে পারে।","poem":2},{"text":"কিন্তু হায় সেই লোক যে পড়ে যায়","poem":1},{"text":"আর কেউ তাকে উঠাবার জন্য নেই।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"আরও, যদি দুজন শুয়ে থাকে, তারা উষ্ণ থাকে।","poem":1},{"text":"কিন্তু একজন কী করে নিজেকে একা উষ্ণ রাখতে পারবে?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"যদিও একা ব্যক্তি হেরে যেতে পারে,","poem":1},{"text":"দুজন নিজেদের প্রতিরোধ করতে পারে।","poem":2},{"text":"তিনটে দড়ি একসঙ্গে পাকানো হলে তাড়াতাড়ি ছেঁড়ে না।","poem":1}]},{"type":"heading","content":["শ্রীবৃদ্ধি অসার"]},{"type":"verse","number":13,"content":["একজন বুড়ো বোকা রাজা, যিনি আর পরামর্শ গ্রহণ করতে চান না তাঁর চেয়ে গরিব অথচ বুদ্ধিমান যুবক ভালো।"]},{"type":"verse","number":14,"content":["সেই যুবক হয়তো কারাগার থেকে এসে রাজা হয়েছে, কিংবা সে হয়তো সেই রাজ্যে অভাবের মধ্যে জন্মেছে।"]},{"type":"verse","number":15,"content":["আমি দেখলাম যারা সূর্যের নিচে বসবাস করত ও চলাফেরা করত তারা সেই যুবককে অনুসরণ করল, সেই রাজার উত্তরাধিকারী।"]},{"type":"verse","number":16,"content":["সেই লোকদের কোনো সীমা ছিল না যারা তাদের আগে ছিল। কিন্তু যারা পরে এসেছিল তারা সেই উত্তরাধিকারীর উপরে সন্তুষ্ট হল না। এটাও অসার, কেবল বাতাসের পিছনে দৌড়ানো।"]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}