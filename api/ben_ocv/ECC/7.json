{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ECC","translationId":"ben_ocv","name":"উপদেশক","commonName":"উপদেশক","title":"উপদেশক","order":21,"numberOfChapters":12,"sha256":"b2ffcd4f21423bf7390f656c3fc00fdde200987b7ede7de5908fe631db4256c2","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ben_ocv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["প্রজ্ঞা"]},{"type":"verse","number":1,"content":[{"text":"ভালো সুগন্ধির চেয়ে সুনাম ভালো,","poem":1},{"text":"জন্মের দিনের চেয়ে মৃত্যুর দিন ভালো।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ভোজের বাড়ি যাওয়ার চেয়ে","poem":1},{"text":"শোকের বাড়ি যাওয়া ভালো,","poem":2},{"text":"কারণ সকলেরই নিয়তি হল মৃত্যু;","poem":1},{"text":"জীবিতদের এই কথা মনে রাখা উচিত।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"আনন্দ করার চেয়ে কষ্টভোগ করা ভালো,","poem":1},{"text":"কারণ মুখের বিষণ্ণতা হৃদয়ের জন্য ভালো।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"জ্ঞানবানদের হৃদয় শোকের বাড়িতে থাকে,","poem":1},{"text":"কিন্তু বোকাদের হৃদয় আমোদের বাড়িতে থাকে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"বোকাদের গান শোনার চেয়ে","poem":1},{"text":"জ্ঞানী লোকের বকুনি শোনা ভালো।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যেমন হাঁড়ির নিচে কাঁটার শব্দ,","poem":1},{"text":"বোকাদের হাসিও ঠিক তেমনি।","poem":2},{"lineBreak":true},{"text":"এটাও অসার।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"জ্ঞানী লোক যদি জুলুম করে সে বোকা হয়ে যায়,","poem":1},{"text":"আর ঘুস হৃদয় নষ্ট করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কোনো কাজের শুরুর চেয়ে শেষ ভালো,","poem":1},{"text":"আর অহংকারের চেয়ে ধৈর্য ভালো।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তোমার অন্তরকে তাড়াতাড়ি রেগে উঠতে দিয়ো না,","poem":1},{"text":"কারণ ক্রোধ বোকাদেরই কোলে বাস করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"বোলো না যে, “এখনকার চেয়ে আগেকার কাল কেন ভালো ছিল?”","poem":1},{"text":"কারণ এই প্রশ্ন করা বুদ্ধিমানের কাজ নয়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"প্রজ্ঞা, উত্তরাধিকারের মতো, যা ভালো","poem":1},{"text":"এবং যারা সূর্য দেখে","poem":2},{"noteId":0},{"text":"তাদের উপকার করে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"প্রজ্ঞা এক আশ্রয়স্থল","poem":1},{"text":"যেমন অর্থও এক আশ্রয়স্থল,","poem":2},{"text":"কিন্তু জ্ঞানের সুবিধা হল এই যে","poem":1},{"text":"প্রজ্ঞা তার অধিকারীর জীবন রক্ষা করে।","poem":2}]},{"type":"verse","number":13,"content":["ঈশ্বরের কাজ ভেবে দেখো",{"text":"তিনি যা বাঁকা করেছেন","poem":1},{"text":"কে তা সোজা করতে পারে?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"যখন সুখের সময়, তখন সুখী হও;","poem":1},{"text":"কিন্তু যখন দুঃখের সময়, এই কথা ভেবে দেখো","poem":2},{"text":"ঈশ্বর একটি সৃষ্টি করেছেন","poem":1},{"text":"পাশাপাশি আরেকটিও করেছেন।","poem":2},{"text":"কিন্তু, কেউ আবিষ্কার করতে পারবে না","poem":1},{"text":"তাদের ভবিষ্যতের কিছুই।","poem":2}]},{"type":"verse","number":15,"content":["আমার এই অসার জীবনকালে আমি এই দুটোই দেখেছি",{"text":"কোনো ধার্মিক লোক নিজের ধার্মিকতায় ধ্বংস হয়,","poem":1},{"text":"এবং কোনো দুষ্টলোক নিজের দুষ্টতায় অনেক দিন পর্যন্ত বেঁচে থাকে।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"অতি ধার্মিক হোয়ো না,","poem":1},{"text":"কিংবা অতি জ্ঞানবান হোয়ো না—","poem":2},{"lineBreak":true},{"text":"কেন নিজেকে ধ্বংস করবে?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"অতি দুষ্ট হোয়ো না,","poem":1},{"text":"আর বোকামিও কোরো না—","poem":2},{"lineBreak":true},{"text":"কেন তুমি অসময়ে মারা যাবে?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"একটি ধরে রাখা","poem":1},{"text":"আর অন্যটা না ছাড়া ভালো।","poem":2},{"lineBreak":true},{"text":"যে ঈশ্বরকে ভয় করে সে কোনো কিছুই অতিরিক্ত করে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"প্রজ্ঞা একজন জ্ঞানবান লোককে","poem":1},{"text":"নগরের দশজন শাসকের থেকে বেশি শক্তিশালী করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"বাস্তবিক, পৃথিবীতে একজনও ধার্মিক নেই,","poem":1},{"text":"কেউ নেই যে সঠিক কাজ করে এবং কখনও পাপ করে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"লোকে যা বলে তার সব কথায় কান দিয়ো না,","poem":1},{"text":"হয়তো শুনবে যে, তোমার চাকর তোমাকে অভিশাপ দিচ্ছে—","poem":2}]},{"type":"verse","number":22,"content":[{"text":"কারণ তুমি তোমার নিজের হৃদয় জানো","poem":1},{"text":"অনেকবার তুমি নিজেই অন্যকে অভিশাপ দিয়েছ।","poem":2}]},{"type":"verse","number":23,"content":["এসব আমি প্রজ্ঞা দিয়ে পরীক্ষা করে দেখে বললাম,",{"text":"“আমি জ্ঞানী হবই হব”—","poem":1},{"text":"কিন্তু তা আমার নাগালের বাইরে।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"যা কিছু আছে তা দূরে আছে এবং খুবই গভীরে—","poem":1},{"text":"কে তা খুঁজে পেতে পারে?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"সেইজন্য বুঝবার জন্য আমি আমার মনস্থির করলাম,","poem":1},{"text":"যাতে প্রজ্ঞা ও সবকিছুর পিছনে যে পরিকল্পনা আছে তা জানতে পারি","poem":2},{"text":"আর বুঝতে পারি দুষ্টতার বোকামি","poem":1},{"text":"আর মূর্খতার উন্মত্ততা।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"আমি দেখলাম মৃত্যুর চেয়েও তেতো","poem":1},{"text":"হল সেই স্ত্রীলোক যে একটি ফাঁদ,","poem":2},{"text":"তার হৃদয় একটি জাল","poem":1},{"text":"এবং তার হাত হল শিকল।","poem":2},{"text":"যে লোক ঈশ্বরকে সন্তুষ্ট করে সে তা থেকে রক্ষা পাবে,","poem":1},{"text":"কিন্তু পাপীকে সে ফাঁদে ফেলবে।","poem":2}]},{"type":"verse","number":27,"content":["উপদেশক বলছেন, “দেখো, আমি এটি আবিষ্কার করেছি",{"text":"“সব জিনিসের পরিকল্পনা আবিষ্কার করার জন্য একটির সঙ্গে একটি যোগ করে—","poem":1}]},{"type":"verse","number":28,"content":[{"text":"যখন আমি তখনও খুঁজছিলাম","poem":2},{"lineBreak":true},{"text":"কিন্তু পাচ্ছিলাম না—","poem":2},{"text":"আমি হাজার জনের মধ্যে একজন খাঁটি পুরুষকে পেলাম,","poem":1},{"text":"কিন্তু তাদের মধ্যে একজন স্ত্রীলোককেও খাঁটি দেখতে পাইনি।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"আমি কেবল এই জানতে পারলাম যে","poem":1},{"text":"ঈশ্বর মানুষকে খাঁটিই তৈরি করেছিলেন,","poem":2},{"lineBreak":true},{"text":"কিন্তু তারা অনেক কল্পনার অন্বেষণ করেছে।”","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"যারা জীবিত","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/ben_ocv/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}