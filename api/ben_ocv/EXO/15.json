ext":"ফরৌণের সেরা কর্মকর্তারা","poem":1},{"text":"লোহিত সাগরে","poem":2},{"noteId":28},{"text":"ডুবে গেল।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"গভীর জলরাশি তাদের ঢেকে দিল;","poem":1},{"text":"এক পাথরের মতো তারা গভীরে তলিয়ে গেল।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমার ডান হাত, হে সদাপ্রভু,","poem":1},{"text":"পরাক্রমে অত্যুন্নত।","poem":2},{"text":"তোমার ডান হাত, হে সদাপ্রভু,","poem":1},{"text":"শত্রুকে করেছে চূর্ণবিচূর্ণ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“তোমার মহত্ত্বের গরিমায়","poem":1},{"text":"তোমার বিরোধীদের তুমি নিক্ষেপ করেছ।","poem":2},{"text":"তোমার জ্বলন্ত ক্রোধ তুমি ছড়িয়ে দিয়েছ;","poem":1},{"text":"তা তাদের নাড়ার মতো গ্রাস করেছে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তোমার নাকের বিস্ফোরণে","poem":1},{"text":"জলরাশি স্তূপাকার হল।","poem":2},{"text":"উথাল জলরাশি, এক প্রাচীর হয়ে দাঁড়াল;","poem":1},{"text":"গভীর জলরাশি সমুদ্র-গহ্বরে জমাট বেঁধে গেল।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"শত্রু দম্ভভরে বলল,","poem":1},{"text":"‘আমি তাদের পশ্চাদ্ধাবন করব, তাদের ধরে ফেলব।","poem":2},{"text":"আমি লুটের মাল ভাগাভাগি করব;","poem":1},{"text":"আমি তাদের উপর ঘাটি গাড়ব।","poem":2},{"text":"আমি আমার তরোয়াল টেনে আনব","poem":1},{"text":"আর আমার হাত তাদের ধ্বংস করবে।’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"কিন্তু তুমি তোমার শ্বাস দিয়ে ফুঁ দিলে,","poem":1},{"text":"আর সাগর তাদের ঢেকে দিল।","poem":2},{"text":"তারা প্রবল জলরাশিতে","poem":1},{"text":"সীসার মতো ডুবে গেল।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"দেবতাদের মধ্যে কে","poem":1},{"text":"তোমার মতো, হে সদাপ্রভু?","poem":2},{"text":"তোমার মতো কে—","poem":1},{"text":"পবিত্রতায় মহিমান্বিত,","poem":2},{"text":"প্রতাপে অসাধারণ,","poem":1},{"text":"অলৌকিক কর্মকারী?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“তোমার ডান হাত তুমি প্রসারিত করলে,","poem":1},{"text":"আর পৃথিবী তোমার শত্রুদের গ্রাস করল।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তোমার চিরস্থায়ী প্রেমে করবে তুমি পরিচালনা","poem":1},{"text":"তোমার মুক্তিপ্রাপ্ত জাতিকে।","poem":2},{"text":"তোমার শক্তিতে তুমি তাদের পথ দেখাবে","poem":1},{"text":"তোমার পবিত্র বাসস্থানের দিকে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"জাতিরা শুনবে ও থরথরাবে;","poem":1},{"text":"ফিলিস্তিনী প্রজারা যন্ত্রণায় কাতর হবে।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ইদোমের নেতারা আতঙ্কিত হবে,","poem":1},{"text":"মোয়াবের নায়কেরা হবে কম্পন-কবলিত।","poem":2},{"text":"কনানের প্রজারা","poem":1},{"noteId":29},{"text":"গলে যাবে;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"আতঙ্ক ও শঙ্কা তাদের উপর এসে পড়বে।","poem":2},{"text":"তোমার বাহুবলে","poem":1},{"text":"তারা পাথরের মতো স্থির হয়ে যাবে—","poem":2},{"text":"যতক্ষণ না তোমার প্রজারা পেরিয়ে যায়, হে সদাপ্রভু,","poem":1},{"text":"যতক্ষণ না সেই প্রজারা পেরিয়ে যায়, যাদের তুমি কিনে","poem":2},{"noteId":30},{"text":"নিয়েছ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"তুমি তাদের ভিতরে আনবে ও রোপণ করবে,","poem":1},{"text":"তোমার উত্তরাধিকারের পাহাড়ে—","poem":2},{"text":"সেই স্থান, হে সদাপ্রভু, তুমি করে তোমার বাসস্থান রচেছ,","poem":1},{"text":"হে সদাপ্রভু, তোমার দুটি হাত সেই পবিত্রস্থান প্রতিষ্ঠিত করেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“সদাপ্রভু করলেন রাজত্ব","poem":1},{"text":"করলেন অনন্তকাল ধরে।”","poem":2}]},{"type":"verse","number":19,"content":["ফরৌণের ঘোড়া, রথ ও ঘোড়সওয়ারেরা",{"noteId":31},"যখন সমুদ্রে তলিয়ে গেল, তখন সদাপ্রভু তাদের উপর সমুদ্রের জলরাশি ফিরিয়ে আনলেন, কিন্তু ইস্রায়েলীরা সমুদ্রের একদিক থেকে অন্যদিকে শুকনো জমির উপর দিয়ে হেঁটে চলে গেল।"]},{"type":"verse","number":20,"content":["তখন মহিলা ভাববাদী মরিয়ম, হারোণের দিদি, নিজের হাতে একটি খঞ্জনি তুলে নিলেন, এবং সব মহিলা তাঁর দেখাদেখি খঞ্জনি বাজিয়ে নেচেছিল।"]},{"type":"verse","number":21,"content":["মরিয়ম তাদের কাছে গান গাইলেন:",{"text":"“সদাপ্রভুর উদ্দেশে গাও গান,","poem":1},{"text":"কারণ তিনি অত্যন্ত মহিমান্বিত।","poem":2},{"text":"ঘোড়া ও সওয়ার উভয়কেই","poem":1},{"text":"তিনি করেছেন সমুদ্রে নিক্ষিপ্ত।”","poem":2}]},{"type":"heading","content":["মারা ও এলীমের জলরাশি"]},{"type":"verse","number":22,"content":["পরে মোশি লোহিত সাগর থেকে ইস্রায়েলীদের চালিত করলেন এবং তারা শূর মরুভূমিতে চলে গেল। তিন দিন ধরে তারা মরুভূমিতে জল না পেয়ে ভ্রমণ করল।"]},{"type":"verse","number":23,"content":["তারা যখন মারায় পৌঁছাল, তারা সেখানকার জলপান করতে পারেনি কারণ তা ছিল তেতো। (সেজন্যই সেই স্থানটির নাম রাখা হল মারা",{"noteId":32},")"]},{"type":"verse","number":24,"content":["অতএব লোকেরা মোশির বিরুদ্ধে অভিযোগ জানিয়ে বলল, “আমরা কী পান করব?”"]},{"type":"verse","number":25,"content":["তখন মোশি সদাপ্রভুর কাছে কেঁদে ফেললেন, এবং সদাপ্রভু তাঁকে এক টুকরো কাঠ দেখিয়ে দিলেন। তিনি সেটি জলে ছুঁড়ে দিলেন, এবং সেই জল পানের উপযুক্ত হয়ে গেল। সেখানেই সদাপ্রভু তাদের জন্য এক বিধিনির্দেশ ও অনুশাসন দিলেন এবং তাদের পরীক্ষায় ফেলে দিলেন।"]},{"type":"verse","number":26,"content":["তিনি বললেন, “তোমরা যদি তোমাদের ঈশ্বর সদাপ্রভুর কথা যত্নসহকারে শোনো, এবং তাঁর দৃষ্টিতে যা ন্যায্য তাই করো, তোমরা যদি তাঁর আদেশগুলির প্রতি মনোযোগ দাও ও তাঁর সব হুকুম পালন করো, তবে তোমাদের উপর আমি সেইসব রোগব্যাধির মধ্যে একটিও আনব না, যেগুলি আমি মিশরীয়দের উপরে এনেছিলাম, কারণ আমি সেই সদাপ্রভু, যিনি তোমাদের সুস্থ করেছেন।”"]},{"type":"verse","number":27,"content":["পরে তারা সেই এলীমে এল, যেখানে বারোটি জলের উৎস ও সত্তরটি খেজুর গাছ ছিল, এবং সেখানে তারা জলের কাছেই শিবির স্থাপন করল।"]}],"footnotes":[{"noteId":27,"caller":"+","text":"অথবা, সংগীত","reference":{"chapter":15,"verse":2}},{"noteId":28,"caller":"+","text":"অথবা, নলখাগড়ার সাগরে; 22 পদের ক্ষেত্রেও একই কথা প্রযোজ্য","reference":{"chapter":15,"verse":4}},{"noteId":29,"caller":"+","text":"অথবা, শাসকেরা","reference":{"chapter":15,"verse":15}},{"noteId":30,"caller":"+","text":"অথবা, সৃষ্টি করেছ","reference":{"chapter":15,"verse":16}},{"noteId":31,"caller":"+","text":"অথবা, সারথিরা","reference":{"chapter":15,"verse":19}},{"noteId":32,"caller":"+","text":"মারা শব্দের অর্থ তেতো","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/ben_ocv/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}