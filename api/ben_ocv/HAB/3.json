{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"HAB","translationId":"ben_ocv","name":"হবক্‌কূক","commonName":"হবক্‌কূক","title":"হবক্‌কূক","order":35,"numberOfChapters":3,"sha256":"06d1b1316ebfa7454274e26ec78c7af181bf70310d19a3b0a295bb6a34d8b955","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["হবক্‌কূকের প্রার্থনা"]},{"type":"verse","number":1,"content":[{"text":"ভাববাদী হবক্‌কূকের প্রার্থনা। স্বর, শিগিয়োনোৎ","descriptive":true},{"noteId":4}]},{"type":"verse","number":2,"content":[{"text":"হে সদাপ্রভু, আমি তোমার খ্যাতি শুনেছি;","poem":1},{"text":"আমি তোমার আশ্চর্য কাজে সম্ভ্রমে দাঁড়িয়ে আছি, হে সদাপ্রভু।","poem":2},{"text":"আমাদের দিনে এই সবের পুনরাবৃত্তি করো,","poem":1},{"text":"আমাদের সময়ে তা প্রকাশিত করো;","poem":2},{"lineBreak":true},{"text":"তোমার ক্রোধে করুণা স্মরণ করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ঈশ্বর তৈমন থেকে এসেছেন,","poem":1},{"text":"পবিত্রতম এসেছেন পারণ পর্বত থেকে।","poem":2},{"text":"স্বর্গ তার মহিমায় আচ্ছাদিত","poem":1},{"text":"আর পৃথিবী তার প্রশংসায় পরিপূর্ণ।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তাঁর প্রভা সূর্যোদয়ের মতো;","poem":1},{"text":"তাঁর হাত থেকে আলোকরশ্মি নির্গত হয়,","poem":2},{"lineBreak":true},{"text":"যেখানে তাঁর শক্তি লুকিয়ে ছিল।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"মহামারি তাঁর সামনে গেল;","poem":1},{"text":"সংক্রামক ব্যাধি তার পথ অনুসরণ করল।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তিনি দাঁড়ালেন এবং পৃথিবী নাড়িয়ে দিলেন;","poem":1},{"text":"তিনি দৃষ্টিপাত করলেন এবং সমগ্র জাতিদের কাঁপিয়ে দিলেন।","poem":2},{"text":"তিনি প্রাচীন পর্বতসকল ভেঙে গুঁড়িয়ে দেন","poem":1},{"text":"এবং পুরাতন পাহাড় ধ্বংস করেন;","poem":2},{"lineBreak":true},{"text":"কিন্তু তিনি অনন্তকালস্থায়ী।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমি দেখলাম কুশানের তাঁবুসকল দৈন্য,","poem":1},{"text":"মিদিয়নের ঘরবাড়ি দুর্দশায় পূর্ণ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"হে সদাপ্রভু, তুমি কি নদনদীর প্রতি ক্রুদ্ধ ছিলে?","poem":1},{"text":"তোমার ক্রোধ কি জলধারার প্রতি?","poem":2},{"text":"তুমি কি সমুদ্রের বিরুদ্ধে ক্রোধ প্রকাশ করেছ","poem":1},{"text":"যখন তুমি তোমার ঘোড়ায় চড়লে","poem":2},{"lineBreak":true},{"text":"এবং বিজয় রথে জয়লাভ করলে?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তুমি নিজের ধনুক অনাবৃত করলে,","poem":1},{"text":"আর অনেক তির দাবি করলে।","poem":2},{"text":"তুমি নদীর দ্বারা পৃথিবী ভাগ করেছ;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"পর্বতমালা তোমাকে দেখল ও ভয়ে কাঁপল।","poem":2},{"text":"প্রচণ্ড জলরাশি প্রবাহিত হল;","poem":1},{"text":"গভীর সমুদ্র গর্জে উঠল","poem":2},{"lineBreak":true},{"text":"আর নিজের ঢেউ উত্তোলন করল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"সূর্য ও চন্দ্র আকাশে স্থির হয়ে রইল","poem":1},{"text":"যখন তোমার উজ্জ্বল তির উড়ল,","poem":2},{"lineBreak":true},{"text":"এবং তোমার বজ্ররূপ বর্শা ঝলক দিল।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ক্রোধে তুমি পৃথিবীতে অগ্রবর্তী হলে","poem":1},{"text":"এবং কোপে তুমি জাতিগণকে মাড়িয়ে দিলে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তুমি তোমার প্রজাগণের উদ্ধারের জন্য বাইরে গেলে,","poem":1},{"text":"তোমার অভিষিক্ত-জনের উদ্ধারের জন্য।","poem":2},{"text":"তুমি দুষ্টদেশের রাজাকে ধ্বংস করলে,","poem":1},{"text":"তার মাথা থেকে পা পর্যন্ত তাকে অনাবৃত করলে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তুমি তার বর্শা দিয়ে তার নিজের মাথা বিদ্ধ করলে","poem":1},{"text":"যখন তার যোদ্ধারা আমাদের ছিন্নভিন্ন করতে ঘূর্ণিবায়ুর মতো আক্রমণ করেছিল,","poem":2},{"text":"গ্রাস করার অপেক্ষায় উল্লসিত ছিল","poem":1},{"text":"হতভাগ্য যারা লুকিয়ে ছিল।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তোমার ঘোড়াদের দিয়ে তুমি সমুদ্র মাড়িয়ে গেলে,","poem":1},{"text":"আর মহা জলরাশিকে তোলপাড় করলে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"আমি শুনলাম এবং আমার হৃদয় কাঁপল,","poem":1},{"text":"শব্দ শুনে আমার ঠোঁট কাঁপল;","poem":2},{"text":"আমার শরীরের হাড়গুলি ক্ষয় হতে শুরু করল,","poem":1},{"text":"এবং আমার পা কাঁপতে লাগল।","poem":2},{"text":"তবুও আমি সেই বিপত্তির দিনের জন্য ধৈর্য ধরে অপেক্ষা করব","poem":1},{"text":"যেদিন বিপত্তি আমাদের আক্রমণকারী জাতির উপরে নেমে আসবে।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"যদিও ডুমুর গাছে কুঁড়ি ধরবে না","poem":1},{"text":"এবং আঙুর লতায় কোনো আঙুর ধরবে না,","poem":2},{"text":"যদিও জলপাই গাছ ফলহীন হবে","poem":1},{"text":"এবং ক্ষেতে খাবারের জন্য শস্য ধরবে না,","poem":2},{"text":"যদিও মেষের খোঁয়াড়ে কোনো মেষ থাকবে না","poem":1},{"text":"এবং গোয়ালঘরে গবাদি পশুরা থাকবে না,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"তবুও আমি সদাপ্রভুতে আনন্দ করব,","poem":1},{"text":"আমার ঈশ্বর উদ্ধারকর্তায় উল্লসিত হব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"সার্বভৌম সদাপ্রভুই আমার শক্তি;","poem":1},{"text":"তিনি আমার পা হরিণীর পায়ের মতো করেন,","poem":2},{"lineBreak":true},{"text":"তিনি আমাকে উচ্চ স্থানে চলতে ক্ষমতা দেন।","poem":2},{"text":"প্রধান বাদকের জন্য; আমার তারযুক্ত যন্ত্রে।","descriptive":true}]}],"footnotes":[{"noteId":4,"caller":"+","text":"একটি সংগীত বিষয়ক","reference":{"chapter":3,"verse":1}}]},"thisChapt