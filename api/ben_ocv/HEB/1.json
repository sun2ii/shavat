{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"HEB","translationId":"ben_ocv","name":"ইব্রীয়","commonName":"ইব্রীয়","title":"ইব্রীয়দের প্রতি পত্র","order":58,"numberOfChapters":13,"sha256":"0a0ee6807814b1d83c7470120074c67dd10e09fdc406c2bbdc5add9a25a8870b","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ben_ocv/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["খ্রীষ্ট: ঐশ-মহিমার বিচ্ছুরণ"]},{"type":"verse","number":1,"content":["অতীতে ঈশ্বর ভাববাদীদের",{"noteId":0},"মাধ্যমে আমাদের পূর্বপুরুষদের সঙ্গে বহুবার বিভিন্নভাবে কথা বলেছেন,"]},{"type":"verse","number":2,"content":["কিন্তু এই শেষ যুগে, তিনি তাঁর পুত্রের মাধ্যমেই আমাদের কাছে কথা বলেছেন, যাঁকে তিনি সবকিছুর উত্তরাধিকারী করেছেন, এবং যাঁর মাধ্যমে তিনি সমগ্র বিশ্ব সৃষ্টি করেছেন।"]},{"type":"verse","number":3,"content":["সেই পুত্রই ঈশ্বরের মহিমার বিচ্ছুরণ এবং তাঁর সত্তার যথার্থ প্রতিরূপ, যিনি তাঁর তেজোদৃপ্ত বাক্যের দ্বারা সবকিছুই ধারণ করে আছেন। সব পাপ ক্ষমা করার কাজ সম্পন্ন করার পর, তিনি স্বর্গে ঐশ-মহিমার ডানদিকে উপবেশন করেছেন।"]},{"type":"heading","content":["খ্রীষ্ট স্বর্গদূতদের থেকে মহান"]},{"type":"verse","number":4,"content":["তিনি উত্তরাধিকার বলে স্বর্গদূতদের তুলনায় যে উচ্চতর পদের অধিকারী হয়েছেন, সেই অনুযায়ী তাদের থেকেও মহান হয়ে উঠেছেন।"]},{"type":"verse","number":5,"content":["কারণ স্বর্গদূতদের মধ্যে কাকে ঈশ্বর কখন বলেছেন,",{"text":"“তুমি আমার পুত্র,","poem":1},{"text":"আজ আমি তোমার পিতা হয়েছি?”","poem":2},{"noteId":1},"অথবা আবার,",{"text":"“আমি তার পিতা হব,","poem":1},{"text":"আর সে হবে আমার পুত্র?”","poem":2},{"noteId":2}]},{"type":"verse","number":6,"content":["আবারও, ঈশ্বর যখন তাঁর প্রথমজাতকে এই পৃথিবীতে নিয়ে আসেন, তিনি বললেন,",{"text":"“ঈশ্বরের সব দূত তাঁর উপাসনা করুক।”","poem":1},{"noteId":3}]},{"type":"verse","number":7,"content":["আর স্বর্গদূতদের সম্পর্কে তিনি বলেন,",{"text":"“তিনি তাঁর দূতদের করেন বায়ুসদৃশ,","poem":1},{"text":"তাঁর সেবকদের করেন আগুনের শিখার মতো।”","poem":2},{"noteId":4}]},{"type":"verse","number":8,"content":["কিন্তু পুত্র সম্পর্কে তিনি বলেন,",{"text":"“হে ঈশ্বর, তোমার সিংহাসন অনন্তকালস্থায়ী;","poem":1},{"text":"ধার্মিকতার রাজদণ্ড হবে তোমার রাজ্যের রাজদণ্ড।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তুমি ধার্মিকতাকে ভালোবেসেছ,","poem":1},{"text":"আর দুষ্টতাকে ঘৃণা করেছ;","poem":2},{"text":"সেই কারণে ঈশ্বর, তোমার ঈশ্বর,","poem":1},{"text":"আনন্দের তেল দিয়ে অভিষিক্ত করে,","poem":2},{"lineBreak":true},{"text":"তোমাকে তোমার সহচরদের ঊর্ধ্বে স্থাপন করেছেন।”","poem":2},{"noteId":5}]},{"type":"verse","number":10,"content":["তিনি আরও বলেন,",{"text":"“হে প্রভু, আদিকালে তুমি এই পৃথিবীর ভিত্তিমূল স্থাপন করেছ,","poem":1},{"text":"আর আকাশমণ্ডলও তোমারই হাতের রচনা।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"সেসব বিলুপ্ত হবে, কিন্তু তুমি স্থায়ী হবে;","poem":1},{"text":"সেগুলি ছেঁড়া কাপড়ের মতো হবে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"পরিচ্ছদের মতো তুমি সেসব গুটিয়ে রাখবে,","poem":1},{"text":"পরনের পোশাকের মতো সেগুলি পরিবর্তিত হবে।","poem":2},{"text":"কিন্তু তুমি থাকবে সেই একইরকম,","poem":1},{"text":"তোমার আয়ুর কখনও শেষ হবে না।”","poem":2},{"noteId":6}]},{"type":"verse","number":13,"content":["স্বর্গদূতদের মধ্যে কাকে ঈশ্বর কখন বলেছেন,",{"text":"“তুমি আমার ডানদিকে বসো,","poem":1},{"text":"যতক্ষণ না আমি তোমার শত্রুদের","poem":2},{"lineBreak":true},{"text":"তোমার পাদপীঠে পরিণত করি?”","poem":2},{"noteId":7}]},{"type":"verse","number":14,"content":["স্বর্গদূতেরা সবাই কি পরিচর্যাকারী আত্মা নন? যারা পরিত্রাণের অধিকারী হবে, তাদের সেবা করার জন্যই কি তারা প্রেরিত হননি?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ভাববাদী—এর সমার্থক শব্দগুলি হল, নবী, ভবিষ্যৎ বক্তা, ক্রান্তদর্শী।","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"গীত 2:7","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"2 শমূয়েল 7:14; 1 বংশাবলি 17:13","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"দ্বিতীয় বিবরণ 32:43","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"গীত 104:4","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"গীত 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"গীত 102:25-27","reference":{"chapter":1,"verse":12}},{"noteId":7,"caller":"+","text":"গীত 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/ben_ocv/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}