{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"HOS","translationId":"ben_ocv","name":"হোশেয়","commonName":"হোশেয়","title":"হোশেয়","order":28,"numberOfChapters":14,"sha256":"affd3681e02dd160475bfc30d0e2cdf5ad0246278aaacc9d76f5af8dce5e25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ben_ocv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"ইস্রায়েল ছিল শাখাপ্রশাখা সমন্বিত এক দ্রাক্ষালতা;","poem":1},{"text":"সে নিজের জন্যই ফল উৎপন্ন করত।","poem":2},{"text":"তার ফল যখন বৃদ্ধি পেল,","poem":1},{"text":"সে তখন আরও বেশি যজ্ঞবেদি নির্মাণ করল;","poem":2},{"text":"তার দেশ যেই সমৃদ্ধ হল,","poem":1},{"text":"সে তার পবিত্র পাথর স্তম্ভগুলি সুশোভিত করল।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তাদের হৃদয় প্রবঞ্চনায় পূর্ণ,","poem":1},{"text":"তাই এখন তারা অবশ্যই তাদের অপরাধ বহন করবে।","poem":2},{"text":"সদাপ্রভু তাদের যজ্ঞবেদিগুলি ভেঙে ফেলবেন","poem":1},{"text":"ও তাদের পবিত্র পাথরের স্তম্ভগুলি ধ্বংস করবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"তখন তারা বলবে, “আমাদের কোনো রাজা নেই,","poem":1},{"text":"তাই আমরা সদাপ্রভুকে ভয় করিনি।","poem":2},{"text":"আর যদিও আমাদের কোনো রাজা থাকতেন,","poem":1},{"text":"তাহলে তিনিই বা আমাদের জন্য কী করতেন?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তারা বহু প্রতিশ্রুতি দেয়,","poem":1},{"text":"চুক্তি করার সময়","poem":2},{"lineBreak":true},{"text":"তারা মিথ্যা শপথ করে;","poem":2},{"text":"সেই কারণে মোকদ্দমা গজিয়ে ওঠে","poem":1},{"text":"চাষ করা জমিতে বিষাক্ত আগাছার মতো।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"শমরিয়ায় বসবাসকারী লোকদের কাছে","poem":1},{"text":"বেথ-আবনের বাছুর-প্রতিমা ভীতিপ্রদ।","poem":2},{"text":"কিন্তু এর অধিবাসীরা তার জন্য বিলাপ করবে,","poem":1},{"text":"যেমনটা করবে তার মূর্তিপূজক যাজকেরা,","poem":2},{"text":"যারা তার আড়ম্বরে আনন্দিত হয়েছিল,","poem":1},{"text":"কেননা সেই গৌরবকে তাদের কাছ থেকে নিয়ে নির্বাসনে পাঠানো হবে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তা আসিরিয়ার মহারাজের কাছে উপঢৌকন স্বরূপ","poem":1},{"text":"তা বহন করে নিয়ে যাওয়া হবে।","poem":2},{"text":"ইফ্রয়িম অপমানিত হবে;","poem":1},{"text":"ইস্রায়েল তার বিদেশি জোটের জন্য লজ্জিত হবে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"জলরাশির উপরে কচি শাখার মতো","poem":1},{"text":"শমরিয়া ও তার রাজা ভেসে যাবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"দুষ্টতার","poem":1},{"noteId":12},{"text":"উচ্চ স্থানগুলি ধ্বংস করা হবে,","poem":1},{"text":"কারণ এ হল ইস্রায়েলের পাপ।","poem":2},{"text":"সেখানে কাঁটাগাছ ও শিয়ালকাঁটার জন্ম হবে,","poem":1},{"text":"এবং সেগুলি তাদের যজ্ঞবেদিগুলিকে ঢেকে ফেলবে।","poem":2},{"text":"তখন তারা পর্বতসকলের উদ্দেশে বলবে, “আমাদের ঢেকে ফেলো!”","poem":1},{"text":"আর পাহাড়গুলিকে বলবে, “আমাদের উপরে পড়ো!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“হে ইস্রায়েল, গিবিয়ার সময় থেকে তোমরা পাপ করেছ,","poem":1},{"text":"আর তোমরা সেখানেই থেকে গিয়েছ।","poem":2},{"text":"তাই যুদ্ধ গিবিয়ার দুষ্কর্মকারীদের","poem":1},{"text":"নাগাল কি পাবে না?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"আমার যখন ইচ্ছা হবে, আমি তাদের শাস্তি দেব;","poem":1},{"text":"তাদের দ্বিগুণ পাপের জন্য তাদের বেঁধে ফেলতে।","poem":2},{"lineBreak":true},{"text":"জাতিসমূহ তাদের বিরুদ্ধে একত্র হবে,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ইফ্রয়িম এক প্রশিক্ষিত বকনা-বাছুর,","poem":1},{"text":"সে শস্যমর্দন করতে ভালোবাসে;","poem":2},{"text":"তাই আমি তার সুন্দর ঘাড়ে","poem":1},{"text":"একটি জোয়াল দেব।","poem":2},{"text":"আমি ইফ্রয়িমকে বিতাড়িত করব,","poem":1},{"text":"যিহূদাকে অবশ্যই ভূমি কর্ষণ করতে হবে,","poem":2},{"lineBreak":true},{"text":"আর যাকোব অবশ্যই মাটির ঢেলা ভাঙবে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তোমরা নিজেদের জন্য ধার্মিকতার বীজবপন করো,","poem":1},{"text":"অনিঃশেষ ভালোবাসার ফসল তোলো,","poem":2},{"text":"তোমাদের পতিত জমি চাষ করো;","poem":1},{"text":"কারণ এখনই সদাপ্রভুকে অন্বেষণ করার সময়,","poem":2},{"text":"যতক্ষণ তিনি এসে","poem":1},{"text":"তোমাদের উপরে ধার্মিকতা বর্ষণ না করেন।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"কিন্তু তোমরা তো দুষ্টতার বীজবপন করেছ,","poem":1},{"text":"তোমরা মন্দতার শস্যচয়ন করেছ,","poem":2},{"lineBreak":true},{"text":"তোমরা প্রতারণার ফল ভক্ষণ করেছ।","poem":2},{"text":"এসবের কারণ, তোমরা নিজেদের শক্তি","poem":1},{"text":"ও তোমাদের অসংখ্য বীর যোদ্ধাদের উপর নির্ভর করেছিলে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তোমার প্রজাদের বিরুদ্ধে রণনাদ গর্জিত হবে,","poem":1},{"text":"যাতে তোমাদের সব দুর্গ বিধ্বস্ত হয়;","poem":2},{"text":"ঠিক যেভাবে শল্‌মন যুদ্ধের সময় বেথ-অর্বেলকে ধ্বংস করেছিল,","poem":1},{"text":"সন্তানসহ মায়েদের আছাড় মেরে খণ্ড খণ্ড করেছিল।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ওহে বেথেল, তোমার প্রতি এরকমই করা হবে,","poem":1},{"text":"কারণ তোমার দুষ্টতা বিপুল।","poem":2},{"text":"সেদিন যখন ঘনিয়ে আসবে,","poem":1},{"text":"তখন ইস্রায়েলের রাজা সম্পূর্ণরূপে বিনষ্ট হবে।","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"হিব্রু আবন হল বেথ-আবনের একটি উল্লেখ (বেথেল-এর এক মর্যাদাহানিকর নাম)","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/ben_ocv/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}