{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"HOS","translationId":"ben_ocv","name":"হোশেয়","commonName":"হোশেয়","title":"হোশেয়","order":28,"numberOfChapters":14,"sha256":"affd3681e02dd160475bfc30d0e2cdf5ad0246278aaacc9d76f5af8dce5e25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ben_ocv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"heading","content":["স্ত্রীর সঙ্গে হোশেয়ের পুনর্মিলন"]},{"type":"verse","number":1,"content":["সদাপ্রভু আমাকে বললেন, “যাও, তোমার স্ত্রীর কাছে গিয়ে তাকে আবার ভালোবাসো, যদিও তার প্রেমিক অন্য একজন এবং সে ব্যভিচারিণী। তাকে তেমনই ভালোবাসো, যেমন সদাপ্রভু ইস্রায়েলীদের ভালোবাসেন, যদিও তারা অন্য দেবতাদের প্রতি মুখ ফিরায় এবং কিশমিশের পিঠে ভালোবাসে।”"]},{"type":"verse","number":2,"content":["তাই আমি তাকে 170 গ্রাম",{"noteId":7},"ওজনের রৌপ্যমুদ্রা ও প্রায় 195 কিলোগ্রাম",{"noteId":8},"যব দিয়ে কিনে আনলাম।"]},{"type":"verse","number":3,"content":["তারপর আমি তাকে বললাম, “তোমাকে অনেক দিনের জন্য আমার কাছে থাকতে হবে; তুমি অবশ্যই আর বেশ্যাবৃত্তি করবে না বা কোনো পুরুষের সঙ্গে ঘনিষ্ঠ সম্পর্ক স্থাপন করবে না এবং আমি তোমার সঙ্গে বাস করব।”"]},{"type":"verse","number":4,"content":["কারণ ইস্রায়েলীরা বহুদিন রাজা বা শাসনকর্তা ছাড়া, বলি উৎসর্গ বা পবিত্র পাথরের খণ্ড ছাড়া, এফোদ বা প্রতিমা ছাড়াই বসবাস করবে।"]},{"type":"verse","number":5,"content":["এরপর ইস্রায়েলীরা ফিরে আসবে ও তাদের ঈশ্বর সদাপ্রভুর ও তাদের রাজা দাউদের অন্বেষণ করবে। উত্তরকালে তারা সভয়ে সদাপ্রভুর কাছে ও তাঁর আশীর্বাদ লাভের জন্য আসবে।"]}],"footnotes":[{"noteId":7,"caller":"+","text":"হিব্রু: 15 শেকল রৌপ্যমুদ্রা।","reference":{"chapter":3,"verse":2}},{"noteId":8,"caller":"+","text":"হিব্রু: এক হোমর ও অর্ধ হোমর।","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/ben_ocv/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}