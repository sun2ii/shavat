{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"HOS","translationId":"ben_ocv","name":"হোশেয়","commonName":"হোশেয়","title":"হোশেয়","order":28,"numberOfChapters":14,"sha256":"affd3681e02dd160475bfc30d0e2cdf5ad0246278aaacc9d76f5af8dce5e25c7","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ben_ocv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["ইস্রায়েলের শাস্তি"]},{"type":"verse","number":1,"content":[{"text":"ইস্রায়েল, তুমি আনন্দিত হোয়ো না;","poem":1},{"text":"অন্যান্য জাতিদের মতো উল্লাসে মেতে উঠো না।","poem":2},{"text":"কারণ তোমার ঈশ্বরের কাছে তুমি অবিশ্বস্ত হয়েছ;","poem":1},{"text":"প্রত্যেকটি শস্য মাড়াইয়ের খামারে","poem":2},{"text":"বেশ্যাবৃত্তির পারিশ্রমিক তোমার প্রীতিজনক।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"শস্য মাড়াইয়ের খামার কিংবা দ্রাক্ষাপেষাই কল লোকেদের খাদ্য জোগাবে না;","poem":1},{"text":"নতুন দ্রাক্ষারস লোকেদের জন্য অপ্রতুল হবে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তারা সদাপ্রভুর দেশে থাকতে পারবে না;","poem":1},{"text":"ইফ্রয়িম মিশরে ফিরে যাবে","poem":2},{"lineBreak":true},{"text":"এবং আসিরিয়ায় গিয়ে অশুচি খাবার খাবে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তারা সদাপ্রভুর উদ্দেশে পেয়-নৈবেদ্য উৎসর্গ করবে না,","poem":1},{"text":"কিংবা তাদের দেওয়া বিভিন্ন বলিও তাঁকে সন্তুষ্ট করতে পারবে না।","poem":2},{"text":"এসব বলি তাদের কাছে বিলাপকারীদের খাদ্যের মতো হবে;","poem":1},{"text":"যারাই সেগুলি খাবে, তারাই অশুচি হবে।","poem":2},{"text":"এই খাবার হবে তাদের নিজেদের জন্য;","poem":1},{"text":"এগুলি সদাপ্রভুর মন্দিরে আসবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তোমাদের নির্ধারিত উৎসবগুলির দিনে যেগুলি সদাপ্রভুর উৎসবের দিন,","poem":1},{"text":"সেই দিনগুলিতে তোমরা কী করবে?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তারা যদিও বিনাশ এড়িয়ে যায়,","poem":1},{"text":"মিশর তাদের একত্র করবে","poem":2},{"lineBreak":true},{"text":"এবং মোফ তাদের কবর দেবে।","poem":2},{"text":"তাদের রুপোর পাত্রগুলি হবে বিছুটি গাছের অধিকার,","poem":1},{"text":"তাদের তাঁবুগুলি ছেয়ে যাবে কাঁটাঝোপে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাদের দণ্ডদানের দিন এগিয়ে আসছে,","poem":1},{"text":"হিসেব নেওয়ার দিনও সমাগত;","poem":2},{"lineBreak":true},{"text":"ইস্রায়েল জানুক একথা।","poem":2},{"text":"যেহেতু তোমার পাপসকল অত্যন্ত বেশি","poem":1},{"text":"এবং তোমার হিংস্রতা এত বিশাল যে,","poem":2},{"text":"ভাববাদীও মূর্খ বিবেচিত হয়,","poem":1},{"text":"অনুপ্রাণিত মানুষকে বাতিকগ্রস্ত মনে হয়।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ভাববাদী, আমাদের ঈশ্বরের সঙ্গে","poem":1},{"text":"ইফ্রয়িমের উপরে প্রহরা দেন,","poem":2},{"text":"তা সত্ত্বেও তার সমস্ত পথে ফাঁদ পাতা থাকে,","poem":1},{"text":"আর তার ঈশ্বরের গৃহে বিদ্বেষ বিরাজ করে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তারা ডুবে গেছে দুর্নীতির গভীরে,","poem":1},{"text":"যা এক সময় গিবিয়াতে হত।","poem":2},{"text":"ঈশ্বর তাদের দুষ্টতার কথা স্মরণ করবেন","poem":1},{"text":"এবং তাদের পাপের জন্য তাদের শাস্তি দেবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“আমি যখন ইস্রায়েলকে খুঁজে পেয়েছিলাম,","poem":1},{"text":"তখন মনে হয়েছিল মরুপ্রান্তরে আঙুর খুঁজে পেয়েছি;","poem":2},{"text":"আমি যখন তোমাদের পূর্বপুরুষদের দেখেছিলাম,","poem":1},{"text":"তখন মনে হয়েছিল ডুমুর গাছে অগ্রিম ফল এসেছে।","poem":2},{"text":"কিন্তু তারা যখন বায়াল-পিয়োরে উপস্থিত হল,","poem":1},{"text":"তখন তারা সেই ন্যক্কারজনক মূর্তির কাছে নিজেদের উৎসর্গ করল","poem":2},{"lineBreak":true},{"text":"এবং তাদের সেই প্রিয়পাত্রের মতোই জঘন্য হয়ে উঠল।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ইফ্রয়িমের গৌরব পাখির মতো উড়ে যাবে,","poem":1},{"text":"প্রসব, গর্ভাবস্থা, গর্ভধারণ কিছুই হবে না।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তা সত্ত্বেও যদি তারা শিশুদের লালনপালন করে,","poem":1},{"text":"তাহলে আমি তাদের প্রত্যেককে মৃত্যুশোক দেব।","poem":2},{"text":"ধিক্ তাদের,","poem":1},{"text":"যখন আমি তাদের পরিত্যাগ করি!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"আমি ইফ্রয়িমকে সোরের","poem":1},{"noteId":11},{"text":"মতো দেখেছি,","poem":1},{"text":"যে এক মনোরম স্থানে রোপিত।","poem":2},{"text":"কিন্তু ইফ্রয়িম তার ছেলেমেয়েদের","poem":1},{"text":"ঘাতকের কাছে নিয়ে আসবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"হে সদাপ্রভু, তুমি তাদের দাও—","poem":1},{"text":"তুমি তাদের কী দেবে?","poem":2},{"text":"তুমি তাদের গর্ভস্রাবী জঠর","poem":1},{"text":"ও শুষ্ক স্তন দাও।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“গিল্‌গলে তাদের প্রতিটি দুষ্টতার জন্য,","poem":1},{"text":"আমি সেখানে তাদের ঘৃণা করেছিলাম।","poem":2},{"text":"তাদের পাপপূর্ণ সমস্ত কাজের জন্য","poem":1},{"text":"আমার গৃহ থেকে আমি তাদের বিতাড়িত করব।","poem":2},{"text":"আমি আর তাদের ভালোবাসব না;","poem":1},{"text":"কারণ তাদের নেতারা সবাই বিদ্রোহী।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ইফ্রয়িম ব্যাধিগ্রস্ত হয়েছে,","poem":1},{"text":"তাদের শিকড় শুকিয়ে গেছে;","poem":2},{"lineBreak":true},{"text":"তাই তারা কোনো ফল উৎপন্ন করে না।","poem":2},{"text":"এমনকি তারা যদি সন্তানের জন্মও দেয়,","poem":1},{"text":"তাহলে আমি তাদের স্নেহচ্ছায়ায় লালিত বংশধরদের মেরে ফেলব।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"আমার ঈশ্বর তাদের অগ্রাহ্য করবেন,","poem":1},{"text":"কারণ তারা তাঁর আদেশ পালন করেনি;","poem":2},{"lineBreak":true},{"text":"তাই বিভিন্ন জাতির মধ্যে তারা ইতস্তত ঘুরে বেড়াবে।","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":11,"caller":"+","text":"পুরোনো সংস্করণ: সোরের","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/ben_ocv/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}