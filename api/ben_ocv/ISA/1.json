{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"heading","content":["যিশাইয়ের দর্শন"]},{"type":"verse","number":1,"content":["এই দর্শন যিহূদা ও জেরুশালেমের বিষয়ে, যা আমোষের পুত্র যিশাইয়, যিহূদার রাজা উষিয়, যোথম, আহস ও হিষ্কিয়ের সময়ে দেখতে পান।"]},{"type":"line_break"},{"type":"heading","content":["এক বিদ্রোহী জাতি"]},{"type":"verse","number":2,"content":[{"text":"আকাশমণ্ডল শোনো! পৃথিবী কর্ণপাত করো!","poem":1},{"text":"কারণ এই কথা সদাপ্রভু বলেছেন,","poem":2},{"text":"“আমি ছেলেমেয়েদের লালনপালন ও ভরণ-পোষণ করেছি,","poem":1},{"text":"কিন্তু তারা আমার বিরুদ্ধে বিদ্রোহ করেছে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"গরু তার মনিবকে জানে,","poem":1},{"text":"গর্দভ তার মালিকের জাবপাত্র চেনে,","poem":2},{"text":"কিন্তু ইস্রায়েল তার মনিবকে জানে না,","poem":1},{"text":"আমার প্রজারা কিছু বোঝে না।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"আহা পাপিষ্ঠ জাতি,","poem":1},{"text":"এমন এক প্রজাসমাজ যারা অপরাধে ভারগ্রস্ত,","poem":2},{"text":"তারা কুকর্মীদের বংশ,","poem":1},{"text":"যত ভ্রষ্টাচারীর সন্তান!","poem":2},{"text":"তারা সদাপ্রভুকে ত্যাগ করেছে;","poem":1},{"text":"তারা ইস্রায়েলের পবিত্রতমকে অবজ্ঞা করেছে,","poem":2},{"lineBreak":true},{"text":"এবং তাঁর প্রতি তারা পিঠ ফিরিয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তোমরা আর কেন মার খাবে?","poem":1},{"text":"কেন তোমরা বিদ্রোহ করেই চলেছ?","poem":2},{"text":"মাথার সমস্ত অংশ তোমাদের আহত হয়েছে,","poem":1},{"text":"তোমাদের হৃদয় দুর্বল হয়ে পড়েছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমাদের পায়ের পাতা থেকে মাথার তালু পর্যন্ত,","poem":1},{"text":"কোথাও কোনো সুস্থ স্থান নেই,","poem":2},{"text":"কেবলমাত্র ক্ষত আর প্রহারের চিহ্ন","poem":1},{"text":"এবং টাটিয়ে ওঠা ঘা,","poem":2},{"text":"তা পরিষ্কার করা কিংবা ব্যাণ্ডেজ বাঁধাও হয়নি,","poem":1},{"text":"বা জলপাই তেল দিয়ে তা কোমলও করা হয়নি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"তোমাদের দেশ পরিত্যক্ত,","poem":1},{"text":"তোমাদের নগরগুলি অগ্নিদগ্ধ হয়েছে;","poem":2},{"text":"তোমাদের মাঠগুলি বিদেশিরা","poem":1},{"text":"তোমাদের চোখের সামনেই লুট করেছে,","poem":2},{"lineBreak":true},{"text":"তারা পর্যুদস্ত করা মাত্র সেগুলি ছারখার হয়ে গেছে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"দ্রাক্ষাকুঞ্জের কুটিরের মতো,","poem":1},{"text":"শসা ক্ষেতের পাহারা দেওয়া কুঁড়েঘরের মতো,","poem":2},{"text":"কোনো অবরুদ্ধ নগরীর মতো,","poem":1},{"text":"সিয়োন-কন্যা পরিত্যক্ত পড়ে আছে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সর্বশক্তিমান সদাপ্রভু যদি আমাদের জন্য","poem":1},{"text":"কয়েকজন অবশিষ্ট মানুষ না রাখতেন,","poem":2},{"text":"তাহলে আমাদের অবস্থা হত সদোমের মতো,","poem":1},{"text":"আমরা হতাম ঘমোরার মতো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তোমরা যারা সদোমের শাসক,","poem":1},{"text":"তোমরা সদাপ্রভুর বাণী শোনো;","poem":2},{"text":"তোমরা যারা ঘমোরার মানুষ,","poem":1},{"text":"তোমরা আমাদের ঈশ্বরের বিধান শোনো!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“কী তোমাদের ভাবিয়েছে যে,","poem":1},{"text":"তোমাদের অগণ্য সব বলি উৎসর্গ আমার প্রয়োজন?” সদাপ্রভু একথা বলেন।","poem":2},{"text":"“আমার কাছে প্রয়োজনেরও বেশি হোমের পশু আছে,","poem":1},{"text":"সব মেষ ও নধর পশুদের চর্বি আছে;","poem":2},{"text":"ষাঁড়, মেষশাবক ও ছাগলের রক্তে","poem":1},{"text":"আমার কোনও আনন্দ নেই।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তোমরা যখন আমার সামনে উপস্থিত হও,","poem":1},{"text":"কে তোমাদের কাছে এরকম চেয়েছে যে,","poem":2},{"lineBreak":true},{"text":"তোমরা আমার প্রাঙ্গণ পা দিয়ে মাড়াও?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"অর্থহীন সব বলিদান আমার কাছে আর এনো না!","poem":1},{"text":"তোমাদের ধূপদাহ আমার কাছে ঘৃণ্য মনে হয়।","poem":2},{"text":"অমাবস্যা, সাব্বাথের দিন ও ধর্মীয় সভাগুলি—","poem":1},{"text":"আমি তোমাদের এসব মন্দ জমায়েত সহ্য করতে পারি না।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তোমাদের অমাবস্যার উৎসবগুলি ও নির্ধারিত সব পর্ব,","poem":1},{"text":"আমার প্রাণ ঘৃণা করে।","poem":2},{"text":"সেগুলি আমার পক্ষে এক বোঝাস্বরূপ,","poem":1},{"text":"যেগুলির ভার বয়ে বয়ে আমি ক্লান্ত হয়েছি।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তোমরা প্রার্থনার উদ্দেশে যখন হাত প্রসারিত করো,","poem":1},{"text":"তোমাদের কাছ থেকে আমি আমার দৃষ্টি লুকাব;","poem":2},{"text":"তোমরা যদিও বহু প্রার্থনা উৎসর্গ করো,","poem":1},{"text":"আমি তা শুনব না।","poem":2},{"lineBreak":true},{"text":"কারণ তোমাদের হাত রক্তে পূর্ণ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"তোমরা সেইসব ধুয়ে ফেলো ও নিজেদের শুচিশুদ্ধ করো।","poem":1},{"text":"তোমাদের সব মন্দ কর্ম আমার দৃষ্টিপথ থেকে দূর করো!","poem":2},{"lineBreak":true},{"text":"অন্যায় সব কর্ম করা থেকে নিবৃত্ত হও।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"যা ন্যায়সংগত, তাই করতে শেখো; ন্যায়বিচার অনুধাবন করো।","poem":1},{"text":"অত্যাচারিত লোকেদের পাশে দাঁড়াও।","poem":2},{"text":"পিতৃহীনদের পক্ষসমর্থন করো,","poem":1},{"text":"বিধবাদের সপক্ষে ওকালতি করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“এবারে এসো, আমরা পরস্পর যুক্তিবিচার করি,”","poem":1},{"text":"সদাপ্রভু একথা বলেন।","poem":2},{"text":"“তোমাদের পাপের রং টকটকে লাল হলেও","poem":1},{"text":"সেগুলি বরফের মতো সাদা হবে;","poem":2},{"text":"যদিও তা গাঢ় লাল রংয়ের হয়,","poem":1},{"text":"সেগুলি পশমের মতোই শুভ্র হবে।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"যদি তোমরা ইচ্ছুক ও বাধ্য হও,","poem":1},{"text":"তোমরা দেশের উৎকৃষ্ট সব ফল ভোজন করবে;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"কিন্তু যদি তোমরা প্রতিরোধ ও বিদ্রোহ করো,","poem":1},{"text":"তরোয়াল তোমাদের গ্রাস করবে,”","poem":2},{"text":"কারণ সদাপ্রভুর মুখ একথা বলেছে।","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"দেখো, একদা বিশ্বস্ত জেরুশালেম নগরী,","poem":1},{"text":"কেমন বেশ্যার মতো হয়েছে!","poem":2},{"text":"এক সময়, সে ন্যায়বিচারে পূর্ণ ছিল;","poem":1},{"text":"তার মধ্যে অবস্থান করত ধার্মিকতা,","poem":2},{"lineBreak":true},{"text":"কিন্তু এখন যত খুনির দল আছে!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"তোমাদের রুপোয় এখন খাদ ধরেছে,","poem":1},{"text":"তোমাদের পছন্দসই দ্রাক্ষারসে জল মেশানো হয়েছে।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"তোমাদের শাসকেরা বিদ্রোহী হয়েছে,","poem":1},{"text":"তারা হয়েছে চোরদের সঙ্গী;","poem":2},{"text":"তারা সবাই ঘুস খেতে ভালোবাসে","poem":1},{"text":"এবং পারিতোষিকের পিছনে দৌড়ায়।","poem":2},{"text":"তারা পিতৃহীনের পক্ষসমর্থন করে না;","poem":1},{"text":"বিধবার মোকদ্দমা তাদের সামনে আসে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"তাই প্রভু, সর্বশক্তিমান সদাপ্রভু,","poem":1},{"text":"যিনি ইস্রায়েলের পরাক্রমী জন, তিনি ঘোষণা করেন:","poem":2},{"text":"“আহা! আমি আমার বিপক্ষদের হাত থেকে নিস্তার পাব,","poem":1},{"text":"আমার শত্রুদের কাছে প্রতিশোধ নেব।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"আমি তোমার বিরুদ্ধে আমার মুষ্টিবদ্ধ হাত তুলব;","poem":1},{"text":"আমি তোমার খাদ আগাগোড়া পরিষ্কার করব","poem":2},{"lineBreak":true},{"text":"এবং তোমার সব অশুদ্ধতা দূর করব।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"আমি পুরোনো দিনের মতো তোমার বিচারকদের পুনঃস্থাপিত করব,","poem":1},{"text":"যেমন প্রথমে ছিল, তেমনই নিয়ে আসব পরামর্শদাতাদের।","poem":2},{"text":"পরে তোমাকে বলা হবে","poem":1},{"text":"ধার্মিকতার পুরী,","poem":2},{"lineBreak":true},{"text":"এক বিশ্বাসভাজন নগরী।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"সিয়োনকে ন্যায়বিচারের দ্বারা ও","poem":1},{"text":"তার অনুতপ্ত জনেদের ধার্মিকতার দ্বারা উদ্ধার করা হবে।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"কিন্তু বিদ্রোহী ও পাপীরা, উভয়েই ভগ্ন হবে,","poem":1},{"text":"যারা সদাপ্রভুকে পরিত্যাগ করে, তারা বিনষ্ট হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“তোমরা তোমাদের পবিত্র ওক","poem":1},{"noteId":0},{"text":"গাছগুলির জন্য লজ্জিত হবে,","poem":1},{"text":"যেগুলির জন্য তোমরা আনন্দিত হতে;","poem":2},{"text":"তোমাদের মনোনীত পূজার উদ্যানগুলির জন্য","poem":1},{"text":"তোমরা অপমানিত হবে।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"তোমরা সেই ওক গাছের মতো হবে, যার পাতা শুকিয়ে যাচ্ছে,","poem":1},{"text":"তোমরা জলহীন কোনো উদ্যানের মতো হবে।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"শক্তিশালী মানুষ যেন খড়কুটোর মতো হবে,","poem":1},{"text":"তার কাজ অগ্নিস্ফুলিঙ্গের মতো হবে;","poem":2},{"text":"সেগুলি উভয়েই একত্র দগ্ধ হবে,","poem":1},{"text":"সেই আগুন নিভানোর জন্য কেউই থাকবে না।”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"পুরোনো সংস্করণ: এলা বা অলোন বৃক্ষ।","reference":{"chapter":1,"verse":29}}]},"thisChapterLink":"/api/ben_ocv/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}