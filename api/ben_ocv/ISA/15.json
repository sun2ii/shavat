{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["মোয়াবের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী"]},{"type":"verse","number":1,"content":["মোয়াবের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী,",{"text":"মোয়াবের আর্ নগরী বিনষ্ট হল,","poem":1},{"text":"এক রাত্রির মধ্যে তা ধ্বংস হল!","poem":2},{"text":"মোয়াবের কীর্ নগরীও বিনষ্ট হল,","poem":1},{"text":"এক রাত্রির মধ্যে সেটিও ধ্বংস হল!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"দীবোনের লোকেরা তার মন্দিরে গিয়েছে,","poem":1},{"text":"কাঁদবার জন্য উঁচু স্থানগুলিতে গিয়েছে;","poem":2},{"lineBreak":true},{"text":"মোয়াব নেবো ও মেদ্‌বার জন্য বিলাপ করছে।","poem":2},{"text":"প্রত্যেকের মস্তক মুণ্ডিত হয়েছে","poem":1},{"text":"ও প্রত্যেকের দাড়ি কামানো হয়েছে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"পথে পথে তারা শোকের বস্ত্র পরে;","poem":1},{"text":"সব ছাদের উপরে ও প্রকাশ্য চকগুলিতে","poem":2},{"text":"তারা সকলে বিলাপ করে,","poem":1},{"text":"কাঁদতে কাঁদতে তারা দণ্ডবৎ হয়।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"হিষ্‌বোন ও ইলিয়ালী ক্রন্দন করে,","poem":1},{"text":"তাদের কণ্ঠস্বর যহস পর্যন্ত শোনা যায়।","poem":2},{"text":"তাই সশস্ত্র মোয়াবের লোকেরা চিৎকার করে,","poem":1},{"text":"তাদের হৃদয় মূর্ছিত হয়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"আমার হৃদয় মোয়াবের জন্য কেঁদে ওঠে;","poem":1},{"text":"তার পলাতকেরা সোয়র পর্যন্ত,","poem":2},{"lineBreak":true},{"text":"এমনকি, ইগ্লৎ-শলিশীয়া পর্যন্ত পলায়ন করে।","poem":2},{"text":"তারা লূহীতের আরোহণ পথে উঠে যায়,","poem":1},{"text":"যাওয়ার সময় তারা কাঁদতে থাকে;","poem":2},{"text":"হোরোণয়িমে যাওয়ার পথে","poem":1},{"text":"তারা নিজেদের ধ্বংসের বিষয়ে বিলাপ করে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"নিম্রীমের জলরাশি শুকিয়ে গেছে","poem":1},{"text":"সেখানকার সব ঘাস শুকনো হয়েছে;","poem":2},{"text":"শাকসবজি সব শেষ,","poem":1},{"text":"সবুজ আর কিছুই অবশিষ্ট নেই।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাই যে ঐশ্বর্য তারা আহরণ ও সঞ্চিত করেছে,","poem":1},{"text":"তারা তা ঝাউবন-গিরিখাতের ওপারে নিয়ে যায়।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তাদের হাহাকার-ধ্বনি মোয়াবের সীমানায় প্রতিধ্বনিত হয়;","poem":1},{"text":"তাদের বিলাপের স্বর সুদূর ইগ্লয়িম পর্যন্ত ও","poem":2},{"lineBreak":true},{"text":"তাদের হা-হুতাশের শব্দ বের্-এলীম পর্যন্ত পৌঁছে গেছে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"দীমোনের জলরাশি রক্তে পূর্ণ,","poem":1},{"text":"কিন্তু আমি আরও বিপর্যয় দীমোনের উপরে নিয়ে আসব,","poem":2},{"text":"মোয়াবের পলাতকদের উপরে এবং যারা দেশে","poem":1},{"text":"অবশিষ্ট থাকে, তাদের উপরে একটি সিংহ নিয়ে আসব।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}