{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"দেশের শাসনকর্তার কাছে","poem":1},{"text":"উপহাররূপে কতগুলি মেষশাবক পাঠাও,","poem":2},{"text":"মরুভূমির ওপারে, সেলা থেকে","poem":1},{"text":"সিয়োন-কন্যার পর্বতে পাঠাও।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"বাসা থেকে ফেলে দেওয়া","poem":1},{"text":"পাখির পালিয়ে যাওয়া শব্দের মতো,","poem":2},{"text":"অর্ণোন নদীর পারঘাটাগুলিতে","poem":1},{"text":"মোয়াবের নারীদের অবস্থা তেমনই হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“আমাদের পরামর্শ দাও,","poem":1},{"text":"এক সিদ্ধান্তের কথা বিবেচনা করো।","poem":2},{"text":"মধ্যাহ্নে তোমাদের ছায়াকে","poem":1},{"text":"রাত্রির মতো অন্ধকারময় করো।","poem":2},{"text":"পলাতকদের লুকিয়ে রাখো,","poem":1},{"text":"শরণার্থীদের সঙ্গে বিশ্বাসঘাতকতা কোরো না।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"মোয়াবের পলাতকেরা তোমাদের সঙ্গে বসবাস করুক;","poem":1},{"text":"ধ্বংসকারীর হাত থেকে তোমরা তাদের আশ্রয়স্বরূপ হও।”","poem":2},{"lineBreak":true},{"text":"অত্যাচারীদের সময় শেষ হয়ে আসবে,","poem":1},{"text":"বিনাশের সময় নিবৃত্ত হবে;","poem":2},{"lineBreak":true},{"text":"আক্রমণকারী দেশ থেকে উধাও হবে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ভালোবাসায় এক সিংহাসন স্থাপিত হবে;","poem":1},{"text":"বিশ্বস্ততায় একজন তার উপরে উপবিষ্ট হবেন—","poem":2},{"lineBreak":true},{"text":"দাউদের কুল","poem":2},{"noteId":31},{"text":"থেকে একজন তার উপরে বসবেন।","poem":2},{"text":"তিনি ন্যায়পরায়ণতায় বিচার করবেন","poem":1},{"text":"এবং দ্রুততার সঙ্গে ধার্মিকতা প্রতিষ্ঠা করবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আমরা মোয়াবের অহংকারের কথা শুনেছি,","poem":1},{"text":"তার অতি ঔদ্ধত্য ও অহমিকার কথা,","poem":2},{"text":"তার গর্ব ও তার দাম্ভিকতার বিষয়","poem":1},{"text":"কিন্তু তার দর্প নিতান্তই শূন্যগর্ভ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"সেই কারণে, মোয়াবীয়েরা বিলাপ করে,","poem":1},{"text":"তারা মোয়াবের জন্য একসঙ্গে বিলাপ করে।","poem":2},{"text":"তারা কীর্-হেরসের কিশমিশের পিঠের জন্য","poem":1},{"text":"বিলাপ ও ক্রন্দন করে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"হিষ্‌বোনের মাঠগুলি শুকিয়ে যায়,","poem":1},{"text":"সিব্‌মার আঙুর গাছগুলিও শুকিয়ে যায়।","poem":2},{"text":"জাতিসমূহের শাসকেরা","poem":1},{"text":"উৎকৃষ্ট আঙুরগাছগুলিকে পদদলিত করেছে,","poem":2},{"text":"যেগুলি একদিন যাসের পর্যন্ত","poem":1},{"text":"ও মরুভূমির দিকে ছড়িয়ে যেত।","poem":2},{"text":"তাদের শাখাগুলি ছড়িয়ে পড়েছিল,","poem":1},{"text":"আর সুদূর সমুদ্র","poem":2},{"noteId":32},{"text":"পর্যন্ত বিস্তৃত হয়েছিল।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তাই সিব্‌মার আঙুর গাছগুলির জন্য","poem":1},{"text":"আমি কাঁদি, যেমন যাসেরও কাঁদে।","poem":2},{"text":"হিষ্‌বোন ও ইলিয়ালী,","poem":1},{"text":"আমি চোখের জলে তোমাদের ভেজাব!","poem":2},{"text":"তোমাদের পাকা ফল ও তোমাদের শস্যচয়নের জন্য","poem":1},{"text":"আনন্দের স্বর আমি স্তব্ধ করব।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ফলবাগিচাগুলি থেকে আনন্দ ও খুশি সরিয়ে নেওয়া হবে;","poem":1},{"text":"আঙুরক্ষেতে কেউই গান বা হৈ-হল্লা করবে না।","poem":2},{"text":"কুণ্ডগুলিতে কেউই দ্রাক্ষারস মাড়াই করবে না,","poem":1},{"text":"কারণ আনন্দের চিৎকার আমি একেবারেই বন্ধ করেছি।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"বীণার করুণ সুরের মতো আমার হৃদয় মোয়াবের জন্য বিলাপ করে,","poem":1},{"text":"আমার অন্তর কীর্-হেরসের জন্য করে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"মোয়াব যখন তার উঁচু স্থানে দেখা দেয়,","poem":1},{"text":"সে কেবলমাত্র নিজেকে ক্লান্ত করে তোলে;","poem":2},{"text":"সে যখন তার অর্চনার স্থানে প্রার্থনা করতে যায়,","poem":1},{"text":"তা কোনও কাজে আসে না।","poem":2}]},{"type":"verse","number":13,"content":["সদাপ্রভু এই বাণী ইতিমধ্যে মোয়াবের সম্পর্কে বলেছেন।"]},{"type":"verse","number":14,"content":["কিন্তু এখন সদাপ্রভু বলেন: “চুক্তি দ্বারা আবদ্ধ দাস যেমন দিন গোণে, তিন বছরের মধ্যে তেমনই মোয়াবের সমারোহ ও তার বহুসংখ্যক লোক তুচ্ছীকৃত হবে এবং তার অবশিষ্ট বেঁচে থাকা লোকেরা সংখ্যায় অল্প ও দুর্বল হবে।”"]}],"footnotes":[{"noteId":31,"caller":"+","text":"হিব্রু: শিবির বা তাঁবু থেকে।","reference":{"chapter":16,"verse":5}},{"noteId":32,"caller":"+","text":"হতে পারে সূফ সাগর","reference":{"chapter":16,"verse":8}}]},"thisChapterLink":"/api/ben_ocv/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}