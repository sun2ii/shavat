{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["সদাপ্রভুর পর্বত"]},{"type":"verse","number":1,"content":["যিহূদা ও জেরুশালেম সম্পর্কে আমোষের পুত্র যিশাইয় এই দর্শন পান:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["শেষের সময়ে",{"text":"সদাপ্রভুর মন্দিরের পর্বত অন্য সব পর্বতের উপরে","poem":1},{"text":"প্রধানরূপে প্রতিষ্ঠিত হবে;","poem":2},{"text":"তাকে সব পাহাড়ের উপরে তুলে ধরা হবে","poem":1},{"text":"এবং সমস্ত জাতি তার দিকে স্রোতের মতো প্রবাহিত হবে।","poem":2}]},{"type":"verse","number":3,"content":["অনেক লোক এসে বলবে,",{"text":"“চলো, আমরা সদাপ্রভুর পর্বতে উঠে যাই,","poem":2},{"lineBreak":true},{"text":"যাকোবের ঈশ্বরের গৃহে যাই।","poem":2},{"text":"তিনি আমাদের তাঁর পথের বিষয়ে শিক্ষা দেবেন,","poem":1},{"text":"যেন আমরা তাঁর পথসমূহে চলতে পারি।”","poem":2},{"text":"সিয়োন থেকে বিধান নির্গত হবে,","poem":1},{"text":"জেরুশালেম থেকে সদাপ্রভুর বাণী নির্গত হবে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তিনি অনেক জাতির মধ্যে বিচার করবেন","poem":1},{"text":"এবং অনেক লোকেদের বিবাদ মীমাংসা করবেন।","poem":2},{"text":"তারা নিজের তরোয়াল পিটিয়ে চাষের লাঙল","poem":1},{"text":"এবং বল্লমগুলিকে কাস্তেতে পরিণত করবে।","poem":2},{"text":"এক জাতি অন্য জাতির বিরুদ্ধে আর তরোয়াল ব্যবহার করবে না,","poem":1},{"text":"তারা আর যুদ্ধ করতেও শিখবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ওহে যাকোবের কুল, তোমরা এসো,","poem":1},{"text":"এসো, আমরা সদাপ্রভুর আলোয় পথ চলি।","poem":2}]},{"type":"heading","content":["সদাপ্রভুর দিন"]},{"type":"verse","number":6,"content":[{"text":"সদাপ্রভু, তুমি তো তোমার প্রজা,","poem":1},{"text":"যাকোবের কুলকে ত্যাগ করেছ।","poem":2},{"text":"তারা প্রাচ্যদেশীয় কুসংস্কারের অভ্যাসে পূর্ণ;","poem":1},{"text":"তারা ফিলিস্তিনীদের মতো গণকবিদ্যা ব্যবহার করে","poem":2},{"lineBreak":true},{"text":"এবং পৌত্তলিকদের সঙ্গে হাতে হাত মেলায়।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাদের দেশ সোনা ও রুপোয় পূর্ণ","poem":1},{"text":"তাদের ঐশ্বর্যের যেন কোনও শেষ নেই।","poem":2},{"text":"তাদের দেশ অশ্বেও পরিপূর্ণ,","poem":1},{"text":"তাদের রথেরও যেন কোনো শেষ নেই।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তাদের দেশ প্রতিমায় পূর্ণ;","poem":1},{"text":"নিজেদের হাতে তৈরি জিনিসের কাছে তারা প্রণিপাত করে,","poem":2},{"lineBreak":true},{"text":"যেগুলি তাদেরই আঙুল নির্মাণ করেছে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ইতর মানুষ তাদের কাছে প্রণত হয়,","poem":1},{"text":"মহৎ যারা, তারাও অধোমুখ হয়,","poem":2},{"lineBreak":true},{"text":"তাই তুমি তাদের ক্ষমা কোরো না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তোমরা পাথরের ফাটলে যাও, মাটিতে লুকাও","poem":1},{"text":"সদাপ্রভুর ভয়ংকরতা থেকে ও","poem":2},{"lineBreak":true},{"text":"তাঁর মহিমার ঔজ্জ্বল্য থেকে!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"উদ্ধত মানুষের দৃষ্টি নত করা হবে,","poem":1},{"text":"গর্বিত মানুষেরা অবনত হবে;","poem":2},{"text":"সেদিন কেবলমাত্র সদাপ্রভুই উন্নীত হবেন।","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"যত গর্বিত ও উদ্ধত মানুষ,","poem":1},{"text":"যত লোক নিজেদের উচ্চ করে,","poem":2},{"text":"তাদের জন্য সর্বশক্তিমান সদাপ্রভু একটি দিন স্থির করে রেখেছেন,","poem":1},{"text":"(তাদের সবাইকে নত করা হবে),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"সব লেবাননের যত উঁচু ও লম্বা সিডার গাছ","poem":1},{"text":"এবং বাশনের সমস্ত ওক গাছকে,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"সব উঁচু পর্বত","poem":1},{"text":"এবং সমস্ত উঁচু পাহাড়কে,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"প্রত্যেকটি উঁচু মিনার","poem":1},{"text":"ও প্রত্যেকটি দৃঢ় প্রাচীরকে,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"প্রত্যেকটি বাণিজ্যিক জাহাজ","poem":1},{"noteId":1},{"text":"এবং প্রত্যেকটি চমৎকার শিল্পকর্মকে।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"মানুষের ঔদ্ধত্যকে নত করা হবে,","poem":1},{"text":"সব মানুষের অহংকার অবনত হবে;","poem":2},{"text":"সেদিন, কেবলমাত্র সদাপ্রভুই উচ্চ হবেন,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"আর যত প্রতিমা সেদিন অন্তর্হিত হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"মানুষেরা সেদিন পালিয়ে পাহাড়ের গুহাগুলিতে","poem":1},{"text":"ও মাটির গর্তগুলিতে গিয়ে লুকাবে,","poem":2},{"text":"সদাপ্রভুর ভয়ংকরতা থেকে","poem":1},{"text":"এবং তাঁর রাজকীয় প্রতাপের শৌর্য থেকে,","poem":2},{"lineBreak":true},{"text":"যখন তিনি পৃথিবীকে কম্পান্বিত করার জন্য উঠে দাঁড়াবেন।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"সেদিন লোকেরা,","poem":1},{"text":"ইঁদুর ও বাদুড়ের কাছে ফেলে দেবে,","poem":2},{"text":"তাদের রুপোর ও সোনার প্রতিমাগুলি","poem":1},{"text":"যেগুলি তারা পুজো করার জন্য নির্মাণ করেছিল।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"তারা পাহাড়-পর্বতের গুহাগুলিতে","poem":1},{"text":"ও ঝুলে থাকা পাহাড়ের খাঁজে খাঁজে গিয়ে লুকাবে,","poem":2},{"text":"সদাপ্রভুর ভয়ংকরতা থেকে","poem":1},{"text":"এবং তাঁর রাজকীয় প্রতাপের শৌর্য থেকে,","poem":2},{"lineBreak":true},{"text":"যখন তিনি পৃথিবীকে কম্পান্বিত করার জন্য উঠে দাঁড়াবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"তোমরা মানুষের উপরে নির্ভর করা ছেড়ে দাও,","poem":1},{"text":"যার নাকে তো কেবলমাত্র প্রাণবায়ু বয়।","poem":2},{"lineBreak":true},{"text":"সে কীসের মধ্যে গণ্য?","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"তর্শীশের প্রত্যেকটি জাহাজ","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/ben_ocv/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}