{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["ব্যাবিলনের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী"]},{"type":"verse","number":1,"content":["সমুদ্রের তীরবর্তী মরুপ্রান্তর সম্পর্কিত এক ভবিষ্যদ্‌বাণী:",{"text":"দক্ষিণাঞ্চল","poem":1},{"noteId":38},{"text":"থেকে যেমন ঘূর্ণিবায়ু প্রবল বেগে বয়ে যায়,","poem":1},{"text":"মরুপ্রান্তর থেকে, এক আতঙ্কস্বরূপ দেশ থেকে","poem":2},{"lineBreak":true},{"text":"তেমনই এক আক্রমণকারী উঠে আসছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"এক নিদারুণ দর্শন আমাকে দেখানো হয়েছে:","poem":1},{"text":"বিশ্বাসঘাতক বিশ্বাসঘাতকতা করে, লুণ্ঠনকারী লুট গ্রহণ করে।","poem":2},{"text":"এলম, আক্রমণ করো! মাদিয়া, তোমরা অবরোধ করো!","poem":1},{"text":"তার দেওয়া যত শোকবিলাপের আমি নিবৃত্তি ঘটাব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"এতে আমার শরীর বেদনায় জর্জরিত হল,","poem":1},{"text":"প্রসববেদনাগ্রস্ত নারীর মতো আমার শরীরে ব্যথা হল;","poem":2},{"text":"আমি যা শুনি, তাতে হত-বিহ্বল হই,","poem":1},{"text":"আমি যা শুনি, তাতে চমকিত হই।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"আমার হৃদয় ধুকধুক করে,","poem":1},{"text":"ভয়ে আমি কাঁপতে থাকি;","poem":2},{"text":"যে গোধূলিবেলার আমি অপেক্ষা করি,","poem":1},{"text":"তা আমার কাছে হয়েছে বিভীষিকার মতো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তারা টেবিলে খাবার সাজায়,","poem":1},{"text":"তারা বসার জন্য মাদুর বিছিয়ে দেয়,","poem":2},{"lineBreak":true},{"text":"তারা প্রত্যেকেই ভোজনপান করতে থাকে!","poem":2},{"text":"ওহে সেনাপতিরা, তোমরা ওঠো,","poem":1},{"text":"ঢালগুলিতে তেল মাখাও!","poem":2}]},{"type":"verse","number":6,"content":["সদাপ্রভু আমাকে এই কথা বলেন:",{"text":"“তুমি যাও ও গিয়ে একজন প্রহরী নিযুক্ত করো,","poem":1},{"text":"সে যা দেখে, তার সংবাদ দিতে বলো।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"যখন সে অনেক রথ দেখে","poem":1},{"text":"যেগুলির সঙ্গে পাল পাল অশ্ব থাকে,","poem":2},{"text":"গর্দভ বা উটের পিঠে আরোহীদের","poem":1},{"text":"যখন সে দেখে,","poem":2},{"text":"সে যেন সজাগ থাকে,","poem":1},{"text":"সম্পূর্ণরূপে সজাগ থাকে।”","poem":2}]},{"type":"verse","number":8,"content":["সেই সিংহরূপী প্রহরী চিৎকার করে বলল,",{"text":"“দিনের পর দিন, আমার প্রভু, আমি প্রহরীদুর্গে দাঁড়িয়ে থাকি;","poem":1},{"text":"রোজ রাত্রে আমি আমার প্রহরাস্থানেই থাকি।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"দেখুন, একজন মানুষ রথে চড়ে আসছে,","poem":1},{"text":"তার সঙ্গে আছে অশ্বের পাল।","poem":2},{"text":"আর সে প্রত্যুত্তরে বলছে,","poem":1},{"text":"‘ব্যাবিলনের পতন হয়েছে, পতন হয়েছে!","poem":2},{"text":"তার সব দেবদেবীর মূর্তিগুলি","poem":1},{"text":"মাটিতে যেখানে সেখানে ছড়িয়ে আছে!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ও আমার প্রজারা, তোমাদের খামারে মাড়াই করে চূর্ণ করা হয়েছে,","poem":1},{"text":"আমি সর্বশক্তিমান সদাপ্রভু,","poem":2},{"text":"ইস্রায়েলের ঈশ্বরের কাছ থেকে যা শুনেছি,","poem":1},{"text":"তাই তোমাদের বলি।","poem":2}]},{"type":"heading","content":["ইদোমের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী"]},{"type":"verse","number":11,"content":["দূমার",{"noteId":39},"বিরুদ্ধে এক ভবিষ্যদ্‌বাণী,",{"text":"কেউ আমাকে সেয়ীর থেকে ডেকে বলছে,","poem":1},{"text":"“প্রহরী, রাতের আর কত বাকি আছে?","poem":2},{"text":"প্রহরী, রাতের আর কত বাকি আছে?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"প্রহরী উত্তর দিল,","poem":1},{"text":"“সকাল হয়ে আসছে, কিন্তু রাতও আসছে।","poem":2},{"text":"তুমি যদি জিজ্ঞাসা করতে চাও, তো জিজ্ঞাসা করো","poem":1},{"text":"এবং আবার ফিরে এসো।”","poem":2}]},{"type":"heading","content":["আরবের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী"]},{"type":"verse","number":13,"content":["আরবের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী,",{"text":"দদানের মরুযাত্রী তোমরা,","poem":1},{"text":"যারা আরবীয় ঘন জঙ্গল এলাকায় তাঁবু স্থাপন করো,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"তোমরা তৃষ্ণার্ত মানুষদের জন্য জল নিয়ে এসো;","poem":2},{"text":"আর তোমরা যারা টেমায় বসবাস করো,","poem":1},{"text":"তোমরা পলাতকদের জন্য খাবার নিয়ে এসো।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তারা তরোয়াল থেকে পলায়ন করে,","poem":1},{"text":"নিষ্কোষ তরোয়াল থেকে পলায়ন করে,","poem":2},{"text":"তারা পলায়ন করে চাড়া দেওয়া ধনুক থেকে","poem":1},{"text":"এবং রণভূমির উত্তাপ থেকে।","poem":2}]},{"type":"verse","number":16,"content":["প্রভু আমাকে এই কথা বললেন: “যেভাবে কোনো দাস তার চুক্তির মেয়াদ গুনতে থাকে, তেমনই এক বছরের মধ্যে কেদরের সমস্ত সমারোহের অন্ত হবে।"]},{"type":"verse","number":17,"content":["ধনুর্ধারীদের অবশিষ্ট লোকেরা, কেদরের যোদ্ধারা সংখ্যায় অল্পই হবে।” একথা সদাপ্রভু, ইস্রায়েলের ঈশ্বর বলেছেন।"]}],"footnotes":[{"noteId":38,"caller":"+","text":"মূল পাণ্ডুলিপিতে নেগেভ উল্লিখিত হয়েছে।","reference":{"chapter":21,"verse":1}},{"noteId":39,"caller":"+","text":"দূমার অর্থ নীরবতা বা নিশ্চুপ অবস্থা। এটি “ইদোম” শব্দটির এক শ্লেষ-অলংকার।","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/ben_ocv/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/22.json","nextChapterAudioLinks":{},"