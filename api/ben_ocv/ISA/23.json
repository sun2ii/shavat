{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["সোরের বিরুদ্ধে এক ভবিষ্যদ্‌বাণী"]},{"type":"verse","number":1,"content":["সোরের",{"noteId":42},"বিরুদ্ধে এক ভবিষ্যদ্‌বাণী,",{"text":"তর্শীশের জাহাজগুলি, তোমরা বিলাপ করো!","poem":1},{"text":"কারণ সোর ধ্বংস হয়েছে,","poem":2},{"lineBreak":true},{"text":"সেখানে আর ঘরবাড়ি নেই, বন্দরও নেই।","poem":2},{"text":"সাইপ্রাসের","poem":1},{"noteId":43},{"text":"দেশ থেকে","poem":1},{"text":"তাদের কাছে এই সংবাদ এসে পৌঁছেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ওহে দ্বীপনিবাসীরা, তোমরা","poem":1},{"text":"এবং সীদোনের বণিকেরা, সমুদ্র পারাপারকারীরা যাদের সমৃদ্ধ করেছে,","poem":2},{"lineBreak":true},{"text":"তোমরা নীরব হও।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"কারণ মহাজলরাশির উপরে এসেছে","poem":1},{"text":"শীহোর নদীর শস্য;","poem":2},{"text":"নীলনদের ফসল ছিল সোরের রাজস্ব,","poem":1},{"text":"সে হয়েছিল জাতিসমূহের বাজারসদৃশ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ওহে সীদোন, তোমরা লজ্জিত হও, আর সমুদ্রের দুর্গ, তোমরাও হও,","poem":1},{"text":"কারণ সমুদ্র কথা বলেছে:","poem":2},{"text":"“আমি কখনও প্রসবযন্ত্রণা ভোগ করিনি, কাউকে জন্মও দিইনি;","poem":1},{"text":"আমি পুত্রদের প্রতিপালন করিনি, কন্যাদেরও মানুষ করিনি।”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"যখন মিশরের কাছে সংবাদ আসে,","poem":1},{"text":"সোরের কাছ থেকে প্রাপ্ত সংবাদে তাদের মনস্তাপ হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"তোমরা তর্শীশে পার হয়ে যাও;","poem":1},{"text":"দ্বীপনিবাসী তোমরা বিলাপ করো।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"এই কি তোমাদের কোলাহলপূর্ণ নগরী,","poem":1},{"text":"পুরোনো, সেই প্রাচীন পুরী,","poem":2},{"text":"যার পাগুলি তাকে দূরবর্তী দেশগুলিতে","poem":1},{"text":"বসতি করার জন্য নিয়ে গেছে?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"যে অন্যদের মাথায় মুকুট পরাত, সেই","poem":1},{"text":"সোরের বিরুদ্ধে কে এমন পরিকল্পনা করেছে?","poem":2},{"text":"যার বণিকেরা সবাই সম্ভ্রান্ত জন,","poem":1},{"text":"যার ব্যবসায়ীরা পৃথিবীতে বিখ্যাত ছিল?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সর্বশক্তিমান সদাপ্রভু এই পরিকল্পনা করেছেন,","poem":1},{"text":"তার সমস্ত প্রতাপের গর্ব খর্ব করার জন্য","poem":2},{"lineBreak":true},{"text":"এবং পৃথিবীতে বিখ্যাত লোকদের অবনমিত করার জন্য।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ওহে তর্শীশের কন্যা,","poem":1},{"text":"নীলনদের তীরে ভূমি কর্ষণ করো,","poem":2},{"lineBreak":true},{"text":"কারণ তোমার বন্দরটি আর নেই।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"সদাপ্রভু সমুদ্রের উপরে তাঁর হাত প্রসারিত করেছেন","poem":1},{"text":"এবং তার রাজ্যগুলিকে প্রকম্পিত করেছেন।","poem":2},{"text":"তিনি ফিনিসিয়া","poem":1},{"noteId":44},{"text":"সম্পর্কে এক আদেশ দিয়েছেন,","poem":1},{"text":"যে তার দুর্গগুলি ধ্বংস হবে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তিনি বলেছেন, “ওহে মানভ্রষ্ট কুমারী সীদোন-কন্যা,","poem":1},{"text":"তুমি আর উল্লসিত হোয়ো না!","poem":2},{"lineBreak":true},{"text":"“তুমি ওঠো, সাইপ্রাসে পার হয়ে যাও;","poem":1},{"text":"এমনকি, সেখানেও তুমি কোনো বিশ্রাম পাবে না।”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ব্যাবিলনীয়দের","poem":1},{"noteId":45},{"text":"দেশের দিকে তাকাও,","poem":1},{"text":"এই লোকেরা আর হিসেবের মধ্যে আসে না!","poem":2},{"text":"আসিরীয়রা এই দেশকে","poem":1},{"text":"মরুপ্রাণীদের বাসভূমি করেছে;","poem":2},{"text":"তারা তাদের অবরোধ-মিনার গড়ে তুলেছিল,","poem":1},{"text":"তারা এর দুর্গগুলিকে অনাবৃত করেছে","poem":2},{"lineBreak":true},{"text":"এবং ব্যাবিলনকে ধ্বংসস্তূপে পরিণত করেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"তর্শীশের জাহাজগুলি, তোমরা বিলাপ করো,","poem":1},{"text":"কারণ তোমাদের দুর্গগুলি ধ্বংস হয়েছে!","poem":2}]},{"type":"verse","number":15,"content":["সেই সময়ে, সোর একজন রাজার জীবনকাল, অর্থাৎ সত্তর বছরের জন্য বিস্মৃত হবে। কিন্তু এই সত্তর বছরের শেষে বেশ্যাদের এই গানের মতো সোরের অবস্থা হবে:"]},{"type":"verse","number":16,"content":[{"text":"“ওহে ভুলে যাওয়া বেশ্যা,","poem":1},{"text":"তোমার বীণা তুলে নগরের মধ্য দিয়ে যাও;","poem":2},{"text":"ভালো করে বীণা বাজাও, অনেক গান গাও,","poem":1},{"text":"যেন তোমাকে স্মরণ করা হয়।”","poem":2}]},{"type":"verse","number":17,"content":["সত্তর বছরের শেষে সদাপ্রভু সোরের সঙ্গে বোঝাপড়া করবেন। সে পূর্বের মতোই বেশ্যাবৃত্তির পথে ফিরে যাবে এবং ভূপৃষ্ঠের সমস্ত রাজ্যের সঙ্গে তার ব্যবসা চালাবে।"]},{"type":"verse","number":18,"content":["তবুও তার লাভ ও উপার্জন সদাপ্রভুর উদ্দেশে পৃথক করে রাখা হবে; সেগুলি সঞ্চয় বা মজুত করে রাখা হবে না। তার লাভের টাকা সদাপ্রভুর সাক্ষাতে বসবাসকারী লোকদের কাছে যাবে; তাদের খাদ্যদ্রব্য ও সুন্দর পোশাকের প্রাচুর্য হবে।"]}],"footnotes":[{"noteId":42,"caller":"+","text":"পুরোনো সংস্করণে, “সোর”","reference":{"chapter":23,"verse":1}},{"noteId":43,"caller":"+","text":"হিব্রু: কিত্তীম।","reference":{"chapter":23,"verse":1}},{"noteId":44,"caller":"+","text":"হিব্রু: কনান।","reference":{"chapter":23,"verse":11}},{"noteId":45,"caller":"+","text":"বা কলদীয়দের।","reference":{"chapter":23,"verse":13}}]},"thisChapterLink":"/api/ben_ocv/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}