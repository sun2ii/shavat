{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["পৃথিবীকে সদাপ্রভুর ধ্বংসকরণ"]},{"type":"verse","number":1,"content":[{"text":"দেখো, সদাপ্রভু পৃথিবীকে পরিত্যক্ত করে","poem":1},{"text":"তা ধ্বংস করতে চলেছেন;","poem":2},{"text":"তিনি ভূপৃষ্ঠ ধ্বংস করে","poem":1},{"text":"এবং তার অধিবাসীদের ছিন্নভিন্ন করবেন,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"সবার অবস্থা একইরকম হবে","poem":1},{"text":"যাজকদের ও সাধারণ লোকদের,","poem":2},{"lineBreak":true},{"text":"মনিব ও দাসদের,","poem":2},{"lineBreak":true},{"text":"কর্ত্রী ও দাসীর,","poem":2},{"lineBreak":true},{"text":"বিক্রয়কারী ও ক্রেতার,","poem":2},{"lineBreak":true},{"text":"ঋণগ্রহীতার ও ঋণদাতার,","poem":2},{"lineBreak":true},{"text":"উত্তমর্ণ ও অধমর্ণ, সকলের।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"পৃথিবী সম্পূর্ণ জন পরিত্যক্ত হবে","poem":1},{"text":"ও সম্পূর্ণরূপে লুন্ঠিত হবে।","poem":2},{"text":"সদাপ্রভু এই কথা বলেছেন।","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"পৃথিবী শুকিয়ে যাবে ও নিস্তেজ হবে,","poem":1},{"text":"জগৎ অবসাদগ্রস্ত হয়ে নিস্তেজ হবে,","poem":2},{"lineBreak":true},{"text":"পৃথিবীর মহিমান্বিত ব্যক্তিরা অবসন্ন হবে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"পৃথিবী তার অধিবাসীদের দ্বারা কলুষিত হয়েছে;","poem":1},{"text":"তারা বিধান অমান্য করেছে,","poem":2},{"text":"তারা বিধিবিধান লঙ্ঘন করে","poem":1},{"text":"চিরস্থায়ী চুক্তির অবমাননা করেছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"সেই কারণে, এক অভিশাপ পৃথিবীকে গ্রাস করেছে;","poem":1},{"text":"এর লোকেরা অবশ্য তাদের অপরাধ বহন করবে।","poem":2},{"text":"তাই পৃথিবীর অধিবাসীরা দগ্ধ হয়,","poem":1},{"text":"অতি অল্প মানুষই বেঁচে থাকে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"নতুন দ্রাক্ষারস শুকিয়ে যায় ও দ্রাক্ষালতা নিস্তেজ হয়;","poem":1},{"text":"আমোদ-আহ্লাদকারী সকলে আর্তনাদ করে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"খঞ্জনির উচ্চশব্দ শান্ত হয়ে গেছে,","poem":1},{"text":"ফূর্তিবাজদের হৈ হট্টগোল স্তব্ধ হয়েছে,","poem":2},{"lineBreak":true},{"text":"আনন্দমুখর বীণার রব শোনা যায় না।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"আর তারা গান গেয়ে সুরা পান করে না,","poem":1},{"text":"পানকারীদের মুখে সুরা তেঁতো লাগে।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ধ্বংসিত নগরটি জনশূন্য পড়ে আছে;","poem":1},{"text":"প্রত্যেকটি গৃহের দুয়ারের প্রবেশপথে দরজা লাগানো আছে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"পথে পথে তারা সুরার জন্য চিৎকার করে;","poem":1},{"text":"সমস্ত আনন্দ বিষাদে পরিণত হয়,","poem":2},{"lineBreak":true},{"text":"পৃথিবী থেকে সমস্ত হৈ-হল্লা দূর হয়ে গেছে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"নগর ধ্বংসস্তূপ হয়ে পড়ে আছে,","poem":1},{"text":"এর তোরণদ্বারগুলি টুকরো টুকরো হয়ে পড়ে আছে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"পৃথিবীতে ও জাতিসমূহের মধ্যে","poem":1},{"text":"এরকমই ঘটনা ঘটবে,","poem":2},{"text":"যেমন, যখন কোনো জলপাই গাছ ঝাড়ার পরে হয়","poem":1},{"text":"কিংবা দ্রাক্ষাচয়নের পরে কিছু ফল অবশিষ্ট পড়ে থাকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"তারা তাদের কণ্ঠস্বর উচ্চগ্রামে তোলে, তারা আনন্দে চিৎকার করে;","poem":1},{"text":"পশ্চিমদিক থেকে তারা সদাপ্রভুর মহিমাকীর্তন করবে।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"সেই কারণে, পূর্বদিকের লোকেরা সদাপ্রভুর মহিমা করুক;","poem":1},{"text":"সমুদ্রের দ্বীপগুলির মধ্যে,","poem":2},{"text":"তারা সদাপ্রভুর, ইস্রায়েলের ঈশ্বরের নামের প্রশংসা করুক।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"পৃথিবীর প্রান্তসীমা থেকে আমরা গানের শব্দ শুনছি:","poem":1},{"text":"“সেই ধার্মিক ব্যক্তির মহিমা হোক।”","poem":2},{"lineBreak":true},{"text":"কিন্তু আমি বললাম, “আমি ক্ষয়ে যাচ্ছি, আমি ক্ষয়ে যাচ্ছি,","poem":1},{"text":"ধিক্ আমাকে!","poem":2},{"text":"বিশ্বাসঘাতকেরা বিশ্বাসঘাতকতা করছে!","poem":1},{"text":"হ্যাঁ, বিশ্বাসঘাতকেরা নিদারুণ বিশ্বাসঘাতকতা করছে!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ওহে পৃথিবীর জনগণ,","poem":1},{"text":"সন্ত্রাস, গর্ত ও ফাঁদ তোমাদের জন্য অপেক্ষা করছে।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"সন্ত্রাসের চিৎকারে যে পলায়ন করবে,","poem":1},{"text":"সে কোনো গর্তে পতিত হবে;","poem":2},{"text":"আর যে কেউ গর্ত থেকে উঠে আসে,","poem":1},{"text":"সে ফাঁদে ধৃত হবে।","poem":2},{"lineBreak":true},{"text":"ঊর্ধ্বাকাশের জলধির উৎস সকল মুক্ত হয়েছে,","poem":1},{"text":"পৃথিবীর ভিত্তিমূলগুলি কেঁপে উঠছে।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"পৃথিবী ভগ্ন হয়েছে,","poem":1},{"text":"পৃথিবী ভেঙে টুকরো টুকরো হয়েছে,","poem":2},{"lineBreak":true},{"text":"পৃথিবী সম্পূর্ণরূপে প্রকম্পিত হয়েছে।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"পৃথিবী যেন কোনো মাতালের মতো টলোমলো করছে,","poem":1},{"text":"প্রবল বাতাসে যেমন কুঁড়ে ঘর, এ তেমনই দোদুল্যমান হচ্ছে;","poem":2},{"text":"এর বিদ্রোহের মাত্রা এতই গুরুভার যে,","poem":1},{"text":"এর পতন হবে আর কখনও উঠে দাঁড়াতে পারবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"সেদিন সদাপ্রভু, ঊর্ধ্বস্থ আকাশমণ্ডলের সমস্ত পরাক্রমকে","poem":1},{"text":"ও নিচে পৃথিবীর সমস্ত রাজাকে দণ্ড দেবেন।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"অন্ধকূপে যেমন বন্দিদের আবদ্ধ রাখা হয়,","poem":1},{"text":"তাদেরও তেমনই একত্র করে রাখা হবে;","poem":2},{"text":"তাদের কারাগারে রুদ্ধ করে রাখা হবে,","poem":1},{"text":"আর অনেক দিন পরে তাদের মুক্ত করা","poem":2},{"noteId":46},{"text":"হবে।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"তখন চাঁদ মলিন হবে,","poem":1},{"text":"সূর্য লজ্জিত হবে;","poem":2},{"text":"কারণ সর্বশক্তিমান সদাপ্রভু রাজত্ব করবেন","poem":1},{"text":"সিয়োন পর্বতে ও জেরুশালেমে","poem":2},{"lineBreak":true},{"text":"এবং তার প্রাচীনদের সাক্ষাতে—মহান মহিমার সঙ্গে।","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"বা শাস্তি দেওয়া হবে।","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/ben_ocv/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}