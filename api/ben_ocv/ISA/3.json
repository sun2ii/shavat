{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["যিহূদা ও জেরুশালেমের বিরুদ্ধে সদাপ্রভুর বিচার"]},{"type":"verse","number":1,"content":[{"text":"এখন দেখো, প্রভু,","poem":1},{"text":"সর্বশক্তিমান সদাপ্রভু,","poem":2},{"text":"জেরুশালেম ও যিহূদা থেকে","poem":1},{"text":"জোগান ও সহায়তা প্রদান, উভয়ই দূর করতে চলেছেন:","poem":2},{"text":"খাদ্যের সব জোগান ও জলের সব জোগান,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"বীর ও যোদ্ধা,","poem":2},{"text":"বিচারক ও ভাববাদী,","poem":1},{"text":"গণক ও প্রাচীন,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"পঞ্চাশ-সেনাপতি ও পদস্থ ব্যক্তি,","poem":1},{"text":"পরামর্শদাতা, নিপুণ কারিগর ও চতুর জাদুকর সবাইকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“আমি বালকদের তাদের নেতা করব,","poem":1},{"text":"সামান্য শিশুরা তাদের শাসন করবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"লোকেরা পরস্পরের প্রতি অত্যাচার করবে,","poem":1},{"text":"মানুষ মানুষের বিরুদ্ধে, প্রতিবেশী প্রতিবেশীর বিরুদ্ধে।","poem":2},{"text":"যুবকেরা বৃদ্ধদের বিরুদ্ধে উঠে দাঁড়াবে,","poem":1},{"text":"ইতরজনেরা উঠবে সম্মানিতদের বিরুদ্ধে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"কোনো মানুষ তার বাবার গৃহে,","poem":1},{"text":"কোনো একজন ভাইকে ধরে বলবে,","poem":2},{"text":"“তোমার একটি আলখাল্লা আছে, তুমি আমাদের নেতা হও;","poem":1},{"text":"এই ধ্বংসস্তূপের তুমিই তত্ত্বাবধান করো!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"কিন্তু সেদিন, সে চিৎকার করে বলবে,","poem":1},{"text":"“আমার কাছে প্রতিকার নেই।","poem":2},{"text":"আমার বাড়িতে খাবার বা পরার কাপড় নেই;","poem":1},{"text":"আমাকে লোকদের নেতা কোরো না।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কারণ জেরুশালেম হোঁচট খেয়েছে,","poem":1},{"text":"যিহূদা পতিত হচ্ছে;","poem":2},{"text":"তাদের কথা ও সমস্ত কাজ সদাপ্রভুরই বিরুদ্ধে,","poem":1},{"text":"তারা তাঁর মহিমাময় উপস্থিতিকে অগ্রাহ্য করে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তাদের মুখমণ্ডলের দৃষ্টি তাদের বিরুদ্ধে সাক্ষ্য দেয়;","poem":1},{"text":"তারা সদোমের মতো তাদের পাপের প্রদর্শন করে;","poem":2},{"lineBreak":true},{"text":"তারা তা ঢেকে রাখে না।","poem":2},{"text":"ধিক্ তাদের!","poem":1},{"text":"তারা নিজেদেরই উপরে বিপর্যয় ডেকে এনেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তোমরা ধার্মিক লোকদের বলো, তাদের মঙ্গল হবে,","poem":1},{"text":"কারণ তারা তাদের কৃতকর্মের সুফল ভোগ করবে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"দুষ্টদের ধিক্!","poem":1},{"text":"তাদের উপরে বিপর্যয় নেমে আসবে!","poem":2},{"text":"তারা যা করেছে,","poem":1},{"text":"তার প্রতিফল তাদের দেওয়া হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"যুবকেরা আমার প্রজাদের প্রতি অত্যাচার করে,","poem":1},{"text":"স্ত্রীলোকেরা তাদের উপরে শাসন করে।","poem":2},{"text":"ওহে আমার প্রজারা, তোমাদের পথপ্রদর্শকেরাই তোমাদের বিপথে চালিত করে;","poem":1},{"text":"প্রকৃত পথ থেকে তারা তোমাদের বিপথগামী করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"সদাপ্রভু তাঁর দরবারে অবস্থান গ্রহণ করেছেন;","poem":1},{"text":"তিনি জাতিসমূহের বিচার করার জন্য উঠে দাঁড়িয়েছেন।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"সদাপ্রভু প্রাচীনদের ও তাঁর প্রজাদের নেতৃগণের বিরুদ্ধে বিচার করতে চলেছেন:","poem":1},{"lineBreak":true},{"text":"“তোমরাই আমার দ্রাক্ষাকুঞ্জ নষ্ট করেছ;","poem":1},{"text":"দরিদ্র মানুষদের কাছ থেকে লুট করা জিনিস তোমাদেরই বাড়িতে আছে।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"আমার প্রজাদের চূর্ণ করে এবং","poem":1},{"text":"দরিদ্রদের মুখ ঘষে দিয়ে তোমরা কী বলতে চাইছ?”","poem":2},{"text":"প্রভু, সর্বশক্তিমান সদাপ্রভু এই কথা বলেন।","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"সদাপ্রভু বলেন,","poem":1},{"text":"“সিয়োনের নারীরা উদ্ধত,","poem":2},{"text":"তারা ঘাড় উঁচু করে চোখের ইশারায়","poem":1},{"text":"পথে পথে চোখ দিয়ে প্রেমের ভান করে।","poem":2},{"text":"তারা ছোটো ছোটো পা ফেলে চলে,","poem":1},{"text":"পায়ের নূপুরের রিনিঝিনি শব্দ তোলে।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"সেই কারণে, সিয়োনের নারীদের মাথায় প্রভু দুষ্টক্ষত সৃষ্টি করবেন;","poem":1},{"text":"সদাপ্রভু তাদের মাথার খুলি টাকপড়া করবেন।”","poem":2}]},{"type":"verse","number":18,"content":["সেদিন, প্রভু তাদের জমকালো বেশভূষা কেড়ে নেবেন: হাতের চুড়ি ও মাথার টায়রা এবং চন্দ্রহার,"]},{"type":"verse","number":19,"content":["কানের দুল, বালা ও জালি আবরণ,"]},{"type":"verse","number":20,"content":["কপালের আভূষণ, পায়ের মল ও কোমরবন্ধনী, সুগন্ধি আতরের শিশি ও বাজু,"]},{"type":"verse","number":21,"content":["সিলমোহর আঁকা আংটি ও নাকের নোলক,"]},{"type":"verse","number":22,"content":["সুন্দর সব পোশাক, উপরের হাতহীন জামা ও ওড়না, টাকার থলি"]},{"type":"verse","number":23,"content":["ও আয়না, মসিনার অন্তর্বাস, উষ্ণীষ ও শাল।"]},{"type":"verse","number":24,"content":[{"text":"সুগন্ধের পরিবর্তে হবে দুর্গন্ধ,","poem":1},{"text":"কোমর বন্ধনীর পরিবর্তে দেওয়া হবে দড়ি;","poem":2},{"text":"কায়দা করা কেশবিন্যাসের পরিবর্তে টাক;","poem":1},{"text":"দামি পোশাকের পরিবর্তে চটের পোশাক,","poem":2},{"lineBreak":true},{"text":"সৌন্দর্যের পরিবর্তে পোড়া দাগ।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"তোমার পুরুষেরা তরোয়ালের দ্বারা পতিত হবে,","poem":1},{"text":"তোমার যোদ্ধাদের যুদ্ধে পতন হবে।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"সিয়োনের তোরণদ্বারগুলি বিলাপ ও শোক করবে;","poem":1},{"text":"একা পরিত্যক্ত হয়ে সে মাটিতে বসে থাকবে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}