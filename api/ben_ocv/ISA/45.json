{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“সদাপ্রভু তাঁর অভিষিক্ত জন কোরস সম্পর্কে এই কথা বলেন,","poem":1},{"text":"আমি তার ডান হাত ধরে আছি,","poem":2},{"text":"যেন সব জাতিকে তার সামনে নত করি","poem":1},{"text":"এবং সব রাজার রণসাজ খুলে ফেলি,","poem":2},{"text":"যেন তার সামনে সব দরজা উন্মুক্ত হয়,","poem":1},{"text":"যেন কোনও দুয়ার বন্ধ না থাকে।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমি তোমার আগে আগে যাব","poem":1},{"text":"এবং সব পাহাড়-পর্বতকে সমভূমি করব;","poem":2},{"text":"আমি পিতলের সব দুয়ার ভেঙে ফেলব","poem":1},{"text":"ও লোহার সব অর্গল কেটে দেব।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"আমি অন্ধকারে রাখা সব ঐশ্বর্য তোমাকে দেব,","poem":1},{"text":"দেব সেইসব সম্পদ, যেগুলি গুপ্ত স্থানে রাখা আছে,","poem":2},{"text":"যেন তুমি জানতে পারো যে, আমিই সদাপ্রভু,","poem":1},{"text":"আমি ইস্রায়েলের ঈশ্বর, যিনি তোমার নাম ধরে ডাকেন।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"আমার দাস যাকোব ও","poem":1},{"text":"আমার মনোনীত ইস্রায়েলের কারণে,","poem":2},{"text":"আমি তোমার নাম ধরে তোমাকে ডাকি","poem":1},{"text":"ও তুমি আমাকে না জানলেও","poem":2},{"lineBreak":true},{"text":"আমি তোমাকে সম্মানের উপাধি দিয়েছি।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"আমিই সদাপ্রভু, অন্য আর কেউ নয়;","poem":1},{"text":"আমি ছাড়া আর কোনো ঈশ্বর নেই।","poem":2},{"text":"তুমি আমাকে না জানা সত্ত্বেও","poem":1},{"text":"আমি তোমাকে শক্তিশালী করব।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যেন সূর্যোদয়ের স্থান থেকে","poem":1},{"text":"তার অস্তস্থান পর্যন্ত,","poem":2},{"text":"লোকেরা জানতে পারে যে, আমি ছাড়া আর কেউ নেই।","poem":1},{"text":"আমিই সদাপ্রভু, আর কেউ নয়।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমিই আলো গঠন ও অন্ধকার সৃষ্টি করি,","poem":1},{"text":"আমি সমৃদ্ধি নিয়ে আসি ও বিপর্যয় সৃষ্টি করি;","poem":2},{"lineBreak":true},{"text":"আমি সদাপ্রভুই এই সমস্ত কাজ করি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ঊর্ধ্বাকাশ, তুমি ধার্মিকতা বর্ষণ করো;","poem":1},{"text":"মেঘমালা তা নিচে বর্ষণ করুক।","poem":2},{"text":"পৃথিবীর ভূমি উন্মুক্ত হোক,","poem":1},{"text":"অঙ্কুরিত হোক পরিত্রাণ,","poem":2},{"text":"তার সঙ্গে ধার্মিকতা বৃদ্ধি পাক;","poem":1},{"text":"আমি সদাপ্রভু তা সৃষ্টি করেছি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ধিক্ সেই লোককে যে তার নির্মাতার সঙ্গে বিবাদ করে,","poem":1},{"text":"যার কাছে সে মাটির খাপরাগুলির মধ্যে","poem":2},{"lineBreak":true},{"text":"একটি খাপরা মাত্র।","poem":2},{"text":"মাটি কি কুমোরকে বলতে পারে,","poem":1},{"text":"‘তুমি কী তৈরি করছ?’","poem":2},{"text":"তোমার কর্ম কি বলতে পারে,","poem":1},{"text":"‘তোমার কোনো হাত নেই?’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ধিক্ সেই মানুষ, যে তার বাবাকে বলে,","poem":1},{"text":"‘তুমি কী জন্ম দিয়েছ?’","poem":2},{"text":"কিংবা তার মাকে বলে,","poem":1},{"text":"‘তুমি কী প্রসব করেছ?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“সদাপ্রভু, ইস্রায়েলের সেই পবিত্রতম জন, যিনি তার স্রষ্টা,","poem":1},{"text":"তিনি এই কথা বলেন,","poem":2},{"text":"ভাবীকালে যা ঘটবে,","poem":1},{"text":"আমার সন্তানদের প্রসঙ্গে তোমরা কি প্রশ্ন করছ,","poem":2},{"lineBreak":true},{"text":"অথবা, আমার হাতের কাজ সম্পর্কে তোমরা আমাকে আদেশ দিচ্ছ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"আমি পৃথিবীকে সৃষ্টি করেছি,","poem":1},{"text":"তার উপরে সৃষ্টি করেছি সমস্ত মানুষ।","poem":2},{"text":"আমার নিজের হাত আকাশমণ্ডলকে প্রসারিত করেছে,","poem":1},{"text":"আমি তাদের নক্ষত্রবাহিনীকে বিন্যস্ত করেছি।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"আমি আমার ধার্মিকতায় সাইরাসকে তুলে ধরব:","poem":1},{"text":"আমি তার সব পথ সরল করব।","poem":2},{"text":"সে আমার নগর পুনর্নির্মাণ করবে","poem":1},{"text":"এবং আমার নির্বাসিতদের মুক্ত করে দেবে,","poem":2},{"text":"কিন্তু কোনো মূল্য বা পুরস্কারের জন্য নয়,","poem":1},{"text":"সর্বশক্তিমান সদাপ্রভু এই কথা বলেন।”","poem":2}]},{"type":"verse","number":14,"content":["সদাপ্রভু এই কথা বলেন,",{"text":"“মিশরের সমস্ত উৎপন্ন দ্রব্য ও কূশের পণ্যসামগ্রী,","poem":1},{"text":"আর সেই দীর্ঘকায় সবায়িয়েরা,","poem":2},{"text":"তারা তোমার কাছে আসবে","poem":1},{"text":"এবং তারা তোমারই হবে;","poem":2},{"text":"তারা তোমার পিছনে ক্লান্ত পায়ে আসবে,","poem":1},{"text":"শৃঙ্খলিত অবস্থায় তোমার কাছে আসবে।","poem":2},{"text":"তারা তোমার সামনে প্রণত হবে","poem":1},{"text":"এবং এই কথা বলে তোমার কাছে অনুনয় করবে,","poem":2},{"text":"‘ঈশ্বর নিশ্চয়ই তোমার সঙ্গে আছেন, তিনি ছাড়া","poem":1},{"text":"আর কোনো ঈশ্বর নেই।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ও ঈশ্বর এবং ইস্রায়েলের পরিত্রাতা,","poem":1},{"text":"সত্যিই তুমি নিজেকে লুকিয়ে রাখো।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"যারা প্রতিমা নির্মাণকারী, তারা সকলেই লজ্জিত ও অপমানিত হবে,","poem":1},{"text":"তারা একসঙ্গে অপমানিত হয়ে বিদায় নেবে।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"কিন্তু সদাপ্রভু চিরস্থায়ী পরিত্রাণের দ্বারা","poem":1},{"text":"ইস্রায়েলের পরিত্রাণ করবেন;","poem":2},{"text":"তোমরা অনন্তকালেও আর কখনও","poem":1},{"text":"লজ্জিত বা অপমানিত হবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"কারণ সদাপ্রভু এই কথা বলেন,","poem":1},{"lineBreak":true},{"text":"যিনি আকাশমণ্ডল সৃষ্টি করেছেন,","poem":1},{"text":"তিনি ঈশ্বর;","poem":2},{"text":"যিনি পৃথিবীকে আকার দিয়ে নির্মাণ করেছেন,","poem":1},{"text":"তিনি তার প্রতিষ্ঠা করেছেন;","poem":2},{"text":"তিনি তা শূন্য রাখার জন্য সৃষ্টি করেননি,","poem":1},{"text":"কিন্তু তা বসতিস্থান হওয়ার জন্যই গঠন করেছেন।","poem":2},{"text":"তিনি বলেন,","poem":1},{"lineBreak":true},{"text":"“আমি সদাপ্রভু,","poem":1},{"text":"আর অন্য কেউই নয়।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"আমি গোপনে কথা বলিনি,","poem":1},{"text":"কোনো অন্ধকারময় দেশের কোনো প্রান্ত থেকে;","poem":2},{"text":"আমি যাকোবের বংশধরদের বলিনি,","poem":1},{"text":"‘বৃথাই আমার অন্বেষণ করো।’","poem":2},{"text":"আমি সদাপ্রভু, আমি সত্যিকথা বলি;","poem":1},{"text":"যা ন্যায়সংগত, সেকথাই ঘোষণা করি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“তোমরা একসঙ্গে জড়ো হও ও এসো;","poem":1},{"text":"বিভিন্ন দেশ থেকে পলাতকেরা, তোমরা সমবেত হও।","poem":2},{"text":"তারা অজ্ঞ, যারা কাঠের মূর্তি বয়ে নিয়ে বেড়ায়,","poem":1},{"text":"যারা সেই দেবতাদের কাছে প্রার্থনা করে, যারা রক্ষা করতে পারে না।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"কী ঘটবে তা ঘোষণা করো, উপস্থাপিত করো—","poem":1},{"text":"তারা সবাই একসঙ্গে মন্ত্রণা করুক।","poem":2},{"text":"কে পূর্ব থেকে একথা বলেছে,","poem":1},{"text":"কে সুদূর অতীতকালে তা ঘোষণা করেছে?","poem":2},{"text":"আমি সদাপ্রভু, তা কি করিনি?","poem":1},{"text":"আর আমি ছাড়া অন্য কোনো ঈশ্বর নেই,","poem":2},{"text":"আমিই ধর্মময় ঈশ্বর ও পরিত্রাতা;","poem":1},{"text":"আমি ছাড়া আর কেউ নেই।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ওহে পৃথিবীর প্রান্তনিবাসী সকলে,","poem":1},{"text":"আমার দিকে ফেরো ও পরিত্রাণ পাও;","poem":2},{"lineBreak":true},{"text":"কারণ আমিই ঈশ্বর, আর কেউ নয়।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"আমি নিজেই শপথ নিয়েছি,","poem":1},{"text":"সম্পূর্ণ সততার সঙ্গে আমার মুখ তা উচ্চারণ করেছে,","poem":2},{"lineBreak":true},{"text":"এমন এক বাণী যা প্রত্যাহৃত হবে না:","poem":2},{"text":"প্রত্যেকের জানু আমার সামনে পাতিত হবে;","poem":1},{"text":"আমার নামে সমস্ত জিভ শপথ করবে।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"তারা আমার বিষয়ে বলবে, ‘কেবলমাত্র সদাপ্রভুতেই","poem":1},{"text":"আছে ধার্মিকতা ও শক্তি।’ ”","poem":2},{"text":"যারাই তাঁর বিরুদ্ধে ক্রুদ্ধ হয়েছে,","poem":1},{"text":"তারা তাঁর কাছে এসে লজ্জিত হবে।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"কিন্তু সদাপ্রভুতে ইস্রায়েলের সমস্ত বংশধর","poem":1},{"text":"ধার্মিক গণিত হবে","poem":2},{"lineBreak":true},{"text":"ও গৌরব লাভ করবে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}