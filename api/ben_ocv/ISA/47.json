{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["ব্যাবিলনের পতন"]},{"type":"verse","number":1,"content":[{"text":"“ওহে ব্যাবিলনের কুমারী-কন্যা,","poem":1},{"text":"তুমি নিচে নেমে ধুলোয় বসো;","poem":2},{"text":"ওহে কলদীয়দের কন্যা,","poem":1},{"text":"সিংহাসন ছাড়াই তুমি মাটিতে বসো।","poem":2},{"text":"আর তোমাকে বলা হবে না","poem":1},{"text":"কোমল ও সুখভোগী।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তুমি জাঁতা নিয়ে শস্য পেষণ করো,","poem":1},{"text":"তোমার ঘোমটা খুলে ফেলো।","poem":2},{"text":"তোমার পরনের কাপড় তুলে নাও, তোমার দুই পা অনাবৃত করো,","poem":1},{"text":"আর নদনদীর মধ্য দিয়ে হেঁটে পার হয়ে যাও।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তোমার নগ্নতা প্রকাশিত হবে,","poem":1},{"text":"তোমার লজ্জা আবৃত থাকবে না।","poem":2},{"text":"আমি প্রতিশোধ গ্রহণ করব,","poem":1},{"text":"কাউকে রেহাই দেব না।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"আমাদের মুক্তিদাতা—সর্বশক্তিমান সদাপ্রভু তাঁর নাম—","poem":1},{"text":"তিনিই ইস্রায়েলের সেই পবিত্রতম জন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ওহে ব্যাবিলনীয়দের কন্যা,","poem":1},{"text":"তুমি নীরব হয়ে বসো, অন্ধকারে যাও;","poem":2},{"text":"আর তোমাকে বলা যাবে না","poem":1},{"text":"রাজ্যসমূহের রানি।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"আমি আমার প্রজাদের প্রতি ক্রুদ্ধ ছিলাম,","poem":1},{"text":"আমার অধিকারকে অপবিত্র করেছিলাম;","poem":2},{"text":"আমি তোমার হাতে তাদের সমর্পণ করেছিলাম,","poem":1},{"text":"কিন্তু তুমি তাদের প্রতি কোনো করুণা প্রদর্শন করোনি।","poem":2},{"text":"এমনকি, বয়স্ক মানুষদের উপরেও","poem":1},{"text":"তুমি অত্যন্ত ভারী জোয়াল চাপিয়েছ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তুমি বলেছ, ‘আমি চিরন্তন রানি,","poem":1},{"text":"চিরকালের জন্য আমি তাই থাকব!’","poem":2},{"text":"কিন্তু এসব বিষয় তুমি বিবেচনা করোনি,","poem":1},{"text":"কিংবা যা ঘটতে চলেছে তার প্রতি মনোযোগ দাওনি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“তাহলে এখন, ওহে বিলাসিনী শোনো,","poem":1},{"text":"তোমার নিশ্চিন্ত আসনে বসে","poem":2},{"text":"তুমি মনে মনে ভাবছ,","poem":1},{"text":"‘একা আমি, আমি ছাড়া আর কেউ নেই।","poem":2},{"text":"আমি কখনও বিধবা হব না,","poem":1},{"text":"কিংবা আমার ছেলেমেয়েরা মারা যাবে না।’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"এক মুহূর্তে, একদিনের মধ্যে,","poem":1},{"text":"এই উভয়ই তোমার প্রতি ঘটবে:","poem":2},{"lineBreak":true},{"text":"সন্তান হারানো ও বিধবা হওয়া।","poem":2},{"text":"সেগুলি পূর্ণমাত্রায় তোমার উপরে নেমে আসবে,","poem":1},{"text":"তা যতই তুমি জাদু কিংবা মন্ত্রতন্ত্র","poem":2},{"lineBreak":true},{"text":"ব্যবহার করে থাকো না কেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তুমি তোমার দুষ্টতার উপরে নির্ভর করেছ,","poem":1},{"text":"তুমি বলেছ, ‘কেউ আমাকে দেখতে পায় না।’","poem":2},{"text":"তোমার জ্ঞান ও বুদ্ধি তোমাকে বিপথগামী করেছে","poem":1},{"text":"যখন তুমি নিজেই নিজেকে বলেছ,","poem":2},{"lineBreak":true},{"text":"‘একা আমি, আমি ছাড়া আর কেউ নেই।’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"বিপর্যয় তোমার উপরে নেমে আসবে,","poem":1},{"text":"মন্ত্রবলে তা তুমি দূর করতে পারবে না।","poem":2},{"text":"এক দুর্যোগ তোমার উপরে পতিত হবে,","poem":1},{"text":"মুক্তিপণ দিয়ে তা তুমি ঝেড়ে ফেলতে পারবে না।","poem":2},{"text":"এক সর্বনাশ তোমার উপরে হঠাৎ এসে উপস্থিত হবে,","poem":1},{"text":"যা তুমি আগাম জানতেও পারবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“তাহলে তুমি তোমার মন্ত্রতন্ত্র ও","poem":1},{"text":"বহু জাদুবিদ্যা চালিয়ে যাও,","poem":2},{"lineBreak":true},{"text":"যা বাল্যকাল থেকে তুমি পরিশ্রম করে অভ্যাস করেছ।","poem":2},{"text":"হয়তো তুমি সফল হবে,","poem":1},{"text":"হয়তো তুমি আতঙ্কের পরিবেশ সৃষ্টি করতে পারবে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তোমার পাওয়া যত পরামর্শ তোমাকে কেবলই বিধ্বস্ত করেছে!","poem":1},{"text":"তোমার জ্যোতিষীরা সব এগিয়ে আসুক,","poem":2},{"text":"ওইসব জ্যোতিষী, যারা মাসের পর মাস ধরে পূর্বঘোষণা করে যায়,","poem":1},{"text":"তোমার প্রতি যা ঘটতে চলেছে, তা থেকে তারা তোমাকে রক্ষা করুক।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তারা প্রকৃতই খড়কুটোর মতো,","poem":1},{"text":"আগুন তাদের পুড়িয়ে ফেলবে।","poem":2},{"text":"আগুনের শিখার ক্ষমতা থেকে","poem":1},{"text":"তারা তো নিজেদেরও রক্ষা করতে পারে না।","poem":2},{"text":"কাউকে উত্তপ্ত করার মতো এখানে কোনো অঙ্গার নেই;","poem":1},{"text":"পাশে বসার মতো এখানে কোনো আগুন নেই।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তারা তো সব থেকে বেশি এইমাত্র তোমার প্রতি করতে পারে,","poem":1},{"text":"এগুলির জন্য তুমি পরিশ্রম করেছ,","poem":2},{"lineBreak":true},{"text":"বাল্যকাল থেকে তুমি লেনদেন করেছ।","poem":2},{"text":"তাদের প্রত্যেকেই নিজের নিজের ভ্রান্তপথে চলছে;","poem":1},{"text":"এমন কেউ নেই, যে তোমাকে রক্ষা করতে পারে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}