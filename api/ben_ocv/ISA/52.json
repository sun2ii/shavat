{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"জাগো, জাগো, ওহে সিয়োন,","poem":1},{"text":"তুমি নিজেকে শক্তি পরিহিত করো!","poem":2},{"text":"ওহে পবিত্র নগরী জেরুশালেম,","poem":1},{"text":"তোমার সৌন্দর্যের পোশাকগুলি পরে নাও।","poem":2},{"text":"ত্বকছেদহীন ও কলুষিত লোকেরা","poem":1},{"text":"আর তোমার মধ্যে প্রবেশ করবে না।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তোমার গায়ের ধুলো ঝেড়ে ফেলো;","poem":1},{"text":"ওহে জেরুশালেম, ওঠো, সিংহাসনে বসো।","poem":2},{"text":"ওহে সিয়োনের বন্দি কন্যা,","poem":1},{"text":"তোমার ঘাড়ের শৃঙ্খল থেকে নিজেকে মুক্ত করো।","poem":2}]},{"type":"verse","number":3,"content":["কারণ সদাপ্রভু এই কথা বলেন,",{"text":"“তোমাকে বিনামূল্যে বিক্রি করা হয়েছে,","poem":1},{"text":"অর্থ ছাড়াই তোমাকে মুক্ত করা হবে।”","poem":2}]},{"type":"verse","number":4,"content":["কারণ সার্বভৌম সদাপ্রভু এই কথা বলেন:",{"text":"“আমার প্রজারা প্রথমে মিশরে প্রবাস করতে গিয়েছিল;","poem":1},{"text":"পরে আসিরিয়া তাদের উপরে অত্যাচার করেছে।","poem":2}]},{"type":"verse","number":5,"content":["“আর এখন এখানে আমার আর কী আছে?” বলেন সদাপ্রভু।",{"text":"“কারণ আমার প্রজারা বিনামূল্যে নীত হয়েছে,","poem":1},{"text":"যারা তাদের শাসন করে, তারা উপহাস করে,”","poem":2},{"text":"একথা বলেন সদাপ্রভু।","poem":4},{"text":"“সমস্ত দিন ধরে,","poem":1},{"text":"আমার নাম প্রতিনিয়ত নিন্দিত হয়।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"সেই কারণে আমার প্রজারা আমার নাম জানতে পারবে;","poem":1},{"text":"সেই কারণে সেদিন তারা জানতে পারবে","poem":2},{"text":"যে আমিই একথা পূর্বঘোষণা করেছিলাম,","poem":1},{"text":"হ্যাঁ, আমিই একথা বলেছিলাম।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"আহা, পর্বতগণের উপরে যারা সুসমাচার প্রচার করে,","poem":1},{"text":"তাদের চরণ কতই না সুন্দর,","poem":2},{"text":"যে শান্তির বার্তা ঘোষণা করে,","poem":1},{"text":"যে মঙ্গলের সমাচার নিয়ে আসে,","poem":2},{"lineBreak":true},{"text":"যে পরিত্রাণের বার্তা ঘোষণা করে,","poem":2},{"text":"যে সিয়োনকে বলে,","poem":1},{"text":"“তোমার ঈশ্বর রাজত্ব করেন!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"শোনো! তোমার প্রহরীরা তাদের কণ্ঠস্বর উচ্চগ্রামে তুলেছে;","poem":1},{"text":"তারা একসঙ্গে আনন্দে চিৎকার করে।","poem":2},{"text":"যখন সদাপ্রভু সিয়োনে ফিরে আসবেন,","poem":1},{"text":"তারা স্বচক্ষে তা দেখতে পাবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"জেরুশালেমের ধ্বংসস্তূপগুলি,","poem":1},{"text":"তোমরা একসঙ্গে আনন্দগানে ফেটে পড়ো,","poem":2},{"text":"কারণ সদাপ্রভু তাঁর প্রজাদের সান্ত্বনা দিয়েছেন,","poem":1},{"text":"তিনি জেরুশালেমকে মুক্ত করেছেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"সদাপ্রভু সমস্ত জাতির দৃষ্টিতে,","poem":1},{"text":"তাঁর পবিত্র হাত অনাবৃত করবেন,","poem":2},{"text":"আর পৃথিবীর সমস্ত প্রান্ত","poem":1},{"text":"আমাদের ঈশ্বরের পরিত্রাণ দেখতে পাবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"বের হও, বের হও, ওই স্থান ছেড়ে চলে যাও!","poem":1},{"text":"কোনো অশুচি বস্তু স্পর্শ কোরো না!","poem":2},{"text":"তোমরা যারা সদাপ্রভুর পাত্রসকল বহন করো,","poem":1},{"text":"তোমরা ওর মধ্য থেকে বেরিয়ে এসো ও পবিত্র হও।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"কিন্তু তোমরা দ্রুত স্থান ত্যাগ করবে না","poem":1},{"text":"বা সেখান থেকে পালিয়ে যাবে না;","poem":2},{"text":"কারণ সদাপ্রভু তোমাদের সামনে সামনে যাবেন,","poem":1},{"text":"ইস্রায়েলের ঈশ্বর তোমাদের পিছনে প্রহরা দেবেন।","poem":2}]},{"type":"heading","content":["সদাপ্রভুর দাসের কষ্টভোগ ও মহিমা"]},{"type":"verse","number":13,"content":[{"text":"দেখো, আমার দাস প্রজ্ঞাপূর্বক ব্যবহার করবেন;","poem":1},{"noteId":68},{"text":"তিনি উন্নীত হবেন, তাঁকে উচ্চে তুলে ধরা হবে ও তিনি হবেন অপার মহিমান্বিত।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তাঁর অবয়ব এমন বিকৃত করা হয়েছিল, যেমন কোনো মানুষের করা হয়নি,","poem":1},{"text":"তাঁকে এমন শ্রীভ্রষ্ট করা হয়েছিল যে, মানুষ বলে চেনা যাচ্ছিল না,","poem":2},{"lineBreak":true},{"text":"তাই, অনেকে তাঁকে দেখে মর্মাহত হয়েছিল।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"সেই কারণে, তিনি অনেক জাতিকে হতচকিত করবেন,","poem":1},{"text":"তার কারণে রাজারা তাদের মুখ বন্ধ করবে।","poem":2},{"text":"কারণ যা তাদের বলা হয়নি, তা তারা দেখবে","poem":1},{"text":"এবং যা তারা শোনেননি, তা তারা বুঝতে পারবে।","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":68,"caller":"+","text":"অন্য সংস্করণে: সফল হবেন।","reference":{"chapter":52,"verse":13}}]},"thisChapterLink":"/api/ben_ocv/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}