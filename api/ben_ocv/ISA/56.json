{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["অন্যদের জন্য পরিত্রাণ"]},{"type":"verse","number":1,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“তোমরা ন্যায়বিচার মেনে চলো","poem":1},{"text":"এবং যা ন্যায়সংগত, তাই করো,","poem":2},{"text":"কারণ আমার পরিত্রাণ অতি নিকটবর্তী,","poem":1},{"text":"আমার ধার্মিকতা সত্বর প্রকাশিত হবে।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ধন্য সেই মানুষ, যে এইরকম করে,","poem":1},{"text":"সেই মানুষ, যে তা আঁকড়ে ধরে রাখে,","poem":2},{"text":"যে সাব্বাথ-দিন অপবিত্র না করে তা পালন করে,","poem":1},{"text":"যে মন্দ কাজ করা থেকে তার হাত সরিয়ে রাখে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"সদাপ্রভুর প্রতি সমর্পিত কোনো বিদেশি না বলুক,","poem":1},{"text":"“সদাপ্রভু নিশ্চয়ই তাঁর প্রজাদের মধ্য থেকে আমাকে বাদ দেবেন।”","poem":2},{"text":"আবার কোনো নপুংসকও অভিযোগ না করুক যে,","poem":1},{"text":"“আমি তো একটি শুষ্ক বৃক্ষ মাত্র।”","poem":2}]},{"type":"verse","number":4,"content":["কারণ সদাপ্রভু এই কথা বলেন,",{"text":"“যে নপুংসকেরা আমার সাব্বাথ-দিন পালন করে,","poem":1},{"text":"যা আমার প্রীতিজনক, তাই বেছে নেয়","poem":2},{"lineBreak":true},{"text":"এবং আমার নিয়মের প্রতি অবিচল থাকে,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তাদের আমি আমার মন্দির ও তার প্রাচীরগুলির মধ্যে","poem":1},{"text":"পুত্রকন্যাদের থেকেও উৎকৃষ্ট","poem":2},{"lineBreak":true},{"text":"এক স্মারক চিহ্ন ও একটি নাম দেব;","poem":2},{"text":"আমি তাদের মধ্যে এক চিরস্থায়ী নাম দেব,","poem":1},{"text":"যা কখনও মুছে ফেলা হবে না।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যে বিদেশিরা সদাপ্রভুর সেবা করার জন্য,","poem":1},{"text":"তাঁকে ভালোবাসার জন্য ও তাঁর আরাধনা করার জন্য তাঁর কাছে প্রতিজ্ঞাবদ্ধ হয়,","poem":2},{"text":"যারাই সাব্বাথ-দিন অপবিত্র না করে তা পালন করে","poem":1},{"text":"ও যারা আমার নিয়ম অবিচলভাবে পালন করে—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাদের আমি আমার পবিত্র পর্বতে নিয়ে আসব","poem":1},{"text":"এবং আমার প্রার্থনা-গৃহে তাদের আনন্দ দেব।","poem":2},{"text":"তাদের দেওয়া হোমবলি ও অন্যান্য নৈবেদ্য","poem":1},{"text":"আমার বেদিতে গ্রহণ করা হবে;","poem":2},{"text":"কারণ আমার গৃহ আখ্যাত হবে","poem":1},{"text":"সর্বজাতির প্রার্থনা-গৃহ বলে।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"সার্বভৌম সদাপ্রভু ঘোষণা করেন,","poem":1},{"text":"যিনি ইস্রায়েলের নির্বাসিতদের সংগ্রহ করেন:","poem":2},{"text":"“যাদের সংগ্রহ করা হয়েছে, তাদের ছাড়াও,","poem":1},{"text":"আমি আরও অন্যদের সংগ্রহ করব।”","poem":2}]},{"type":"heading","content":["দুষ্টদের বিরুদ্ধে সদাপ্রভুর অভিযোগ"]},{"type":"verse","number":9,"content":[{"text":"মাঠের সমস্ত পশু, তোমরা এসো,","poem":1},{"text":"বনের সমস্ত পশু, তোমরা এসে গ্রাস করো!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ইস্রায়েলের প্রহরীরা অন্ধ,","poem":1},{"text":"তাদের প্রত্যেকের জ্ঞানের অভাব আছে;","poem":2},{"text":"তারা সকলেই বোবা কুকুর,","poem":1},{"text":"তারা ঘেউ ঘেউ করতে জানে না;","poem":2},{"text":"তারা শুয়ে শুয়ে স্বপ্ন দেখে,","poem":1},{"text":"তারা ঘুমাতে ভালোবাসে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তারা প্রবল ক্ষুধাবিশিষ্ট কুকুর,","poem":1},{"text":"তাদের কখনও তৃপ্তি হয় না।","poem":2},{"text":"তারা বুদ্ধিবিহীন মেষপালক;","poem":1},{"text":"তারা সবাই নিজের নিজের পথের দিকে ফেরে,","poem":2},{"lineBreak":true},{"text":"প্রত্যেকেই নিজের নিজের লাভের চেষ্টা করে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"প্রত্যেকে চিৎকার করে বলে, “এসো, আমি দ্রাক্ষারস আনি!","poem":1},{"text":"এসো আমরা সুরাপানে মত্ত হই!","poem":2},{"text":"আগামীকালও আজকের মতো হবে,","poem":1},{"text":"এমনকি, এর থেকেও ভালো হবে।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}