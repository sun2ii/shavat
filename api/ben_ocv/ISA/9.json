{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ISA","translationId":"ben_ocv","name":"যিশাইয়","commonName":"যিশাইয়","title":"যিশাইয়","order":23,"numberOfChapters":66,"sha256":"409752707e077c768e8934b43246727cb376f6d4eccc4c23a31891733a034e9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ben_ocv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["আমাদের জন্য এক শিশুর জন্ম হয়েছে"]},{"type":"verse","number":1,"content":["তবুও, যারা বিপর্যস্ত হয়েছিল, তাদের মধ্যে বিষাদ আর থাকবে না। অতীতকালে তিনি সবূলূনের ভূমি ও নপ্তালির ভূমিকে অবনত করেছিলেন; কিন্তু পরবর্তীকালে তিনি সমুদ্রের নিকটবর্তী সেই পথ থেকে, জর্ডন নদীর তীরে স্থিত পরজাতিদের",{"noteId":17},"গালীলকে সম্মানিত করবেন।"]},{"type":"verse","number":2,"content":[{"text":"যে জাতি অন্ধকারে বসবাস করত,","poem":1},{"text":"তারা এক মহাজ্যোতি দেখতে পেয়েছে;","poem":2},{"text":"যারা মৃত্যুচ্ছায়ার দেশে বসবাস করত,","poem":1},{"text":"তাদের উপরে এক জ্যোতির উদয় হয়েছে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তুমি সেই জাতির বৃদ্ধি করেছ","poem":1},{"text":"এবং তাদের আনন্দ বর্ধিত হয়েছে;","poem":2},{"text":"তারা তোমার সামনে আনন্দিত হয়","poem":1},{"text":"যেমন লোকে শস্যচয়নের সময়ে করে,","poem":2},{"text":"যেমন যোদ্ধারা আনন্দ করে,","poem":1},{"text":"যখন তারা লুন্ঠিত বস্তু বিভাগ করে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যেমন তোমরা মিদিয়নকে পরাস্ত করার সময়ে করেছিলে,","poem":1},{"text":"তাদের দাসত্বের জোয়াল","poem":2},{"text":"তোমরা ভেঙে ফেলবে,","poem":1},{"text":"তাদের কাঁধ থেকে ভারী বোঝা তুলে ফেলবে,","poem":2},{"lineBreak":true},{"text":"তোমরা নিপীড়নকারীদের লাঠি ভেঙে ফেলবে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"যুদ্ধে ব্যবহৃত প্রত্যেক যোদ্ধার জুতো","poem":1},{"text":"ও রক্তে ভেজা প্রত্যেকটি পোশাক","poem":2},{"text":"অবশ্য দগ্ধ করা হবে,","poem":1},{"text":"সেগুলি আগুনের জ্বালানিস্বরূপ হবে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"কারণ আমাদের জন্য এক শিশুর জন্ম হয়েছে,","poem":1},{"text":"আমাদের কাছে এক পুত্রসন্তান দেওয়া হয়েছে,","poem":2},{"lineBreak":true},{"text":"শাসনভার","poem":2},{"noteId":18},{"text":"তাঁরই কাঁধে দেওয়া হবে।","poem":2},{"text":"আর তাঁকে বলা হবে","poem":1},{"text":"আশ্চর্য পরামর্শদাতা,","poem":2},{"noteId":19},{"text":"পরাক্রমী ঈশ্বর,","poem":2},{"lineBreak":true},{"text":"চিরন্তন পিতা, শান্তিরাজ।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাঁর শাসনক্ষমতা বৃদ্ধির ও শান্তির","poem":1},{"text":"কোনো সীমা থাকবে না।","poem":2},{"text":"তিনি দাউদের সিংহাসনে অধিষ্ঠিত হয়ে","poem":1},{"text":"তাঁর রাজ্যের উপরে কর্তৃত্ব করবেন,","poem":2},{"text":"ন্যায়বিচার ও ধার্মিকতার সঙ্গে","poem":1},{"text":"তিনি তা প্রতিষ্ঠিত করে সুস্থির করবেন,","poem":2},{"lineBreak":true},{"text":"সেই সময় থেকে অনন্তকাল পর্যন্ত করবেন।","poem":2},{"text":"সর্বশক্তিমান সদাপ্রভুর উদ্যোগই","poem":1},{"text":"তা সম্পাদন করবে।","poem":2}]},{"type":"heading","content":["ইস্রায়েলের বিরুদ্ধে সদাপ্রভুর ক্রোধ"]},{"type":"verse","number":8,"content":[{"text":"প্রভু যাকোবের বিরুদ্ধে একটি বার্তা প্রেরণ করেছেন;","poem":1},{"text":"তা ইস্রায়েলের উপরে পতিত হবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ইফ্রয়িম ও শমরিয়ায় বসবাসকারী","poem":1},{"text":"সব লোকই তা জানতে পারবে,","poem":2},{"text":"যারা গর্বিত মনে ও","poem":1},{"text":"উদ্ধত হৃদয়ের সঙ্গে একথা বলে,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ইটগুলি তো পতিত হয়েছে,","poem":1},{"text":"কিন্তু আমরা তক্ষিত পাথরে তা আবার গাঁথব;","poem":2},{"text":"ডুমুর গাছগুলি কেটে ফেলা হয়েছে,","poem":1},{"text":"কিন্তু সেগুলির জায়গায় আমরা সিডার গাছ লাগাব।”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"কিন্তু সদাপ্রভু রৎসীনের বিরুদ্ধে, তার শত্রুদের শক্তিশালী করেছেন,","poem":1},{"text":"আর তার বিরুদ্ধে তাদের উদ্দীপিত করেছেন।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"পূর্বদিক থেকে অরামীয়রা ও পশ্চিমদিক থেকে ফিলিস্তিনীরা","poem":1},{"text":"মুখ হা করে ইস্রায়েলকে গ্রাস করেছে।","poem":2},{"lineBreak":true},{"text":"তবুও, এ সকলের জন্য তাঁর ক্রোধ প্রশমিত হয়নি,","poem":1},{"text":"তাঁর হাত এখনও উপরে উঠে আছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"কিন্তু, যিনি তাদের আঘাত করেছেন, তাঁর কাছে তারা ফিরে আসেনি,","poem":1},{"text":"তারা সর্বশক্তিমান সদাপ্রভুর অন্বেষণও করেনি।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তাই সদাপ্রভু ইস্রায়েল থেকে মাথা ও লেজ, দুটিই কেটে ফেলবেন,","poem":1},{"text":"খেজুরডাল ও নলখাগড়া মাত্র একদিনে কেটে দেবেন;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"প্রাচীনেরা ও প্রমুখ লোকেরা হলেন মস্তক,","poem":1},{"text":"আর যে ভাববাদীরা মিথ্যা কথা শিক্ষা দেয়, তারা হল লেজ।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"যারা লোকদের পথ প্রদর্শন করে, তারাই তাদের বিপথে চালিত করে,","poem":1},{"text":"আর যারা চালিত হয়, তারা বিপথগামী হয়ে পড়ে।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"সেই কারণে প্রভু যুবকদের জন্য আর আনন্দ করবেন না,","poem":1},{"text":"পিতৃহীন ও বিধবাদের প্রতি তিনি মমতা প্রদর্শন করবেন না,","poem":2},{"text":"কারণ তারা সবাই ভক্তিহীন ও দুষ্ট,","poem":1},{"text":"তারা প্রত্যেকেই অশালীন কথা বলে।","poem":2},{"lineBreak":true},{"text":"তবুও, এ সকলের জন্য তাঁর ক্রোধ প্রশমিত হয়নি,","poem":1},{"text":"তাঁর হাত এখনও উপরে উঠে আছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"সত্যিই দুষ্টতা আগুনের মতো প্রজ্বলিত হয়;","poem":1},{"text":"তা শিয়ালকাঁটা ও কাঁটাঝোপকে পুড়িয়ে ফেলে,","poem":2},{"text":"তা বনের ঘন জঙ্গলকে দাউদাউ করে প্রজ্বলিত করে,","poem":1},{"text":"ফলে উপরের দিকে ঘন ধোঁয়ার কুণ্ডলী উঠে যায়।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"সর্বশক্তিমান সদাপ্রভুর ক্রোধে","poem":1},{"text":"সমস্ত দেশ আগুনে ঝলসে যাবে,","poem":2},{"text":"আর লোকেরা হবে সেই আগুনের জ্বালানিস্বরূপ;","poem":1},{"text":"কেউ তার ভাইকেও অব্যাহতি দেবে না।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ডানদিকে তারা গ্রাস করবে,","poem":1},{"text":"তবুও তারা ক্ষুধার্ত থেকে যাবে;","poem":2},{"text":"বাঁদিকে তারা খেতে থাকবে,","poem":1},{"text":"তবুও তারা তৃপ্ত হবে না।","poem":2},{"text":"প্রত্যেকে তার নিজের সন্তানের","poem":1},{"noteId":20},{"text":"মাংস খাবে:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"মনঃশি ইফ্রয়িমের মাংস খাবে এবং ইফ্রয়িম খাবে মনঃশিকে;","poem":2},{"lineBreak":true},{"text":"তারা উভয়ে একত্রে যিহূদার বিরুদ্ধে উঠবে।","poem":2},{"lineBreak":true},{"text":"তবুও, এ সকলের জন্য তাঁর ক্রোধ প্রশমিত হয়নি,","poem":1},{"text":"তাঁর হাত এখনও উপরে উঠে আছে।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":17,"caller":"+","text":"ইহুদি ছাড়া অন্য যে কোনো জাতিকে ইহুদিরা পরজাতি বলে মনে করতে। তাই, পরজাতির অর্থ, অইহুদি জাতি।","reference":{"chapter":9,"verse":1}},{"noteId":18,"caller":"+","text":"রাজ্যের শাসনভার","reference":{"chapter":9,"verse":6}},{"noteId":19,"caller":"+","text":"বা আশ্চর্য, পরামর্শদাতা","reference":{"chapter":9,"verse":6}},{"noteId":20,"caller":"+","text":"হিব্রু: বাহু বা হাতের","reference":{"chapter":9,"verse":20}}]},"thisChapterLink":"/api/ben_ocv/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}