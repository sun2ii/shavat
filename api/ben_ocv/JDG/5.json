{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JDG","translationId":"ben_ocv","name":"বিচারকর্তৃগণ","commonName":"বিচারকর্তৃগণ","title":"বিচারকর্তৃগণ","order":7,"numberOfChapters":21,"sha256":"4aa10b82f1d4777b7ecf234d26fa354c98d85c4f85ab2b8e4252a1b913ee2e6f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/ben_ocv/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["দবোরার সংগীত"]},{"type":"verse","number":1,"content":["সেদিন দবোরা এবং অবীনোয়মের ছেলে বারক এই গানটি গাইলেন:"]},{"type":"verse","number":2,"content":[{"text":"“ইস্রায়েলের নেতারা যখন নেতৃত্বভার হাতে নিলেন,","poem":1},{"text":"প্রজারা যখন স্বেচ্ছায় নিজেদের উৎসর্গ করল—","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা করো!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“হে রাজারা, একথা শোনো! হে শাসকেরা, কর্ণপাত করো!","poem":1},{"text":"আমি, আমিই সদাপ্রভুর উদ্দেশে","poem":2},{"noteId":13},{"text":"গান গাইব;","poem":2},{"lineBreak":true},{"text":"গানে গানে ইস্রায়েলের ঈশ্বর সদাপ্রভুর প্রশংসা করব।","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“হে সদাপ্রভু, তুমি যখন সেয়ীর থেকে চলে গেলে,","poem":1},{"text":"ইদোমের দেশ থেকে কুচকাওয়াজ করলে,","poem":2},{"text":"পৃথিবী কম্পিত হল, আকাশমণ্ডলও বর্ষণ করল,","poem":1},{"text":"মেঘমালা জলধারা ঢেলে দিল।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"পর্বতগুলি সীনয়ের সেই সদাপ্রভুর সামনে কম্পিত হল,","poem":1},{"text":"ইস্রায়েলের ঈশ্বর সেই সদাপ্রভুর সামনেই হল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“অনাতের পুত্র শম্‌গরের সময়ে,","poem":1},{"text":"রাজপথগুলি যায়েলের সময়ে পরিত্যক্ত হল;","poem":2},{"lineBreak":true},{"text":"ভ্রমণকারীরা ঘুরপথে যেত।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ইস্রায়েলের গ্রামবাসীরা যুদ্ধ করতে চায়নি;","poem":1},{"text":"তারা ক্ষান্ত ছিল, যতদিন না আমি, দবোরা উঠে দাঁড়ালাম,","poem":2},{"lineBreak":true},{"text":"যতদিন না আমি, ইস্রায়েলের এক মাতৃস্থানীয়া উঠে দাঁড়ালাম।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ঈশ্বর নতুন নেতৃবৃন্দ","poem":1},{"noteId":14},{"text":"মনোনীত করলেন","poem":1},{"text":"যুদ্ধ যখন নগর-প্রবেশদ্বারে ঘনিয়ে এল,","poem":2},{"text":"কিন্তু একটিও ঢাল অথবা বর্শা দেখা গেল না,","poem":1},{"text":"ইস্রায়েলে হাজার চল্লিশ সেই সেনানীর হাতে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"আমার হৃদয় ইস্রায়েলী নেতৃবৃন্দের প্রতি আসক্ত হল,","poem":1},{"text":"জনতার মধ্যে ইচ্ছুক স্বেচ্ছাসেবকদের প্রতি।","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা করো!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“তোমরা যারা সাদা গাধার পিঠে চেপে যাও,","poem":1},{"text":"জিন কম্বলের উপর বসে থাকো,","poem":2},{"lineBreak":true},{"text":"আর তোমরা যারা পথযাত্রা করো,","poem":2},{"text":"বিবেচনা করো","poem":1}]},{"type":"verse","number":11,"content":[{"text":"জলসেচনের স্থানে সেই গায়কদের রব।","poem":1},{"text":"তারা সদাপ্রভুর বিজয় বর্ণনা করে,","poem":2},{"lineBreak":true},{"text":"ইস্রায়েলের গ্রামবাসীদের বিজয়।","poem":2},{"lineBreak":true},{"text":"“তখন সদাপ্রভুর প্রজাসকল","poem":1},{"text":"নগরদ্বারে নেমে গেল।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘জাগো, জাগো হে দবোরা!","poem":1},{"text":"জাগো, জাগো, গানে মুখরিত হও!","poem":2},{"text":"হে বারক, ওঠো!","poem":1},{"text":"হে অবীনোয়মের পুত্র, বন্দি করো তোমার বন্দিদের।’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“পরিষদবর্গের অবশিষ্টাংশ নেমে এল;","poem":1},{"text":"সদাপ্রভুর প্রজারা আমার কাছে বিক্রমীদের বিরুদ্ধাচারী হয়ে নেমে এল।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"কেউ ইফ্রয়িম থেকে এল, যাদের মূল অমালেকেতে ছিল;","poem":1},{"text":"বিন্যামীন তোমার অনুগামীদের সহবর্তী ছিল।","poem":2},{"text":"অধিনায়কেরা মাখীর থেকে নেমে এলেন,","poem":1},{"text":"সেই রণ-দণ্ডধারীরা সবূলূন থেকে এলেন।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ইষাখরের নেতারা দবোরার সঙ্গী ছিলেন;","poem":1},{"text":"হ্যাঁ, ইষাখর বারকেরও সঙ্গী ছিল,","poem":2},{"lineBreak":true},{"text":"তাঁর আদেশে তাঁরা উপত্যকায় সবেগে ছুটে গেলেন।","poem":2},{"text":"রূবেণের জেলাগুলিতে","poem":1},{"text":"খুব অন্তর অনুসন্ধান হল।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"কেন তোমরা মেষ-খোঁয়াড়ের","poem":1},{"noteId":15},{"text":"মাঝে বসে রইলে","poem":1},{"text":"শুধু মেষপালকদের বাঁশির সুর শুনবে বলে?","poem":2},{"text":"রূবেণের জেলাগুলিতে","poem":1},{"text":"খুব অন্তর অনুসন্ধান হল।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"গিলিয়দ জর্ডনের ওপারে থেকে গেল।","poem":1},{"text":"আর দান, কেনই বা সে জাহাজের পাশে গড়িমসি করল?","poem":2},{"text":"আশের সমুদ্র উপকূলে থেকে গেল","poem":1},{"text":"আর তার সেই উপসাগরে বসবাস করল।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"সবূলূন-প্রজারা নিজ জীবনের ঝুঁকি নিল;","poem":1},{"text":"নপ্তালিও তাদের দেখাদেখি সোপানক্ষেত্রে তা করল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“রাজারা এলেন, যুদ্ধ করলেন,","poem":1},{"text":"কনানের রাজারা যুদ্ধ করলেন।","poem":2},{"text":"তানকে, মগিদ্দোর নদীতীরে,","poem":1},{"text":"তারা রুপোর কোনো লুন্ঠিত জিনিসপত্র নেয়নি।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"আকাশমণ্ডল থেকে নক্ষত্রেরা যুদ্ধ করল,","poem":1},{"text":"তাদের কক্ষপথ থেকে সীষরার বিরুদ্ধে তারা যুদ্ধ করল।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"কীশোন নদী তাদের ভাসিয়ে দিল,","poem":1},{"text":"যুগবাহিত সেই নদী, সেই কীশোন নদী।","poem":2},{"lineBreak":true},{"text":"হে আমার প্রাণ, এগিয়ে যাও; বলীয়ান হও!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"তখন অশ্ব-ক্ষুরের বজ্রনিনাদ হল—","poem":1},{"text":"তাঁর সবল ঘোড়ার জোরে ছোটার শব্দ।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"সদাপ্রভুর দূত বললেন ‘মেরোসকে অভিশাপ দাও।’","poem":1},{"text":"‘তার প্রজাদের দারুণ অভিশাপ দাও,","poem":2},{"text":"কারণ তারা সদাপ্রভুকে সাহায্য করতে আসেনি,","poem":1},{"text":"সদাপ্রভুকে বলশালীদের বিরুদ্ধে সাহায্য করতে।’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“নারীকুলে যায়েল পরমধন্যা,","poem":1},{"text":"কেনীয় হেবরের স্ত্রী,","poem":2},{"lineBreak":true},{"text":"তাঁবু-নিবাসী নারীকুলে পরমধন্যা।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"সীষরা জল চেয়েছিলেন, আর তিনি তাঁকে দুধ দিলেন;","poem":1},{"text":"অভিজাতদের জন্য উপযুক্ত পাত্রে তিনি দধি এনে দিলেন।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"তিনি তাঁবু-খুটা হাতে তুলে নিলেন,","poem":1},{"text":"ডান হাতে শ্রমিকদের হাতুড়ি নিলেন।","poem":2},{"text":"তিনি সীষরাকে আঘাত করলেন, তাঁর মাথা চূর্ণ করলেন,","poem":1},{"text":"তিনি তাঁর রগ চুরমার ও বিদ্ধ করলেন।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"তিনি যায়েলের পদাবনত হলেন,","poem":1},{"text":"পতিত হলেন;","poem":2},{"text":"যেখানে তিনি পদাবনত হলেন,","poem":1},{"text":"সেখানেই মরে পতিত হয়ে রইলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“খোলা জানালা দিয়ে সীষরার মা তাকিয়েছিলেন;","poem":1},{"text":"জাফরির পিছন থেকে তিনি চিৎকার করেছিলেন,","poem":2},{"text":"‘তার রথ আসতে কেন এত দেরি হচ্ছে?","poem":1},{"text":"কেন তার রথের ঘর্ঘর-ধ্বনি বিলম্বিত?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"তাঁর জ্ঞানবতী সহচরীরা তাঁকে উত্তর দিল;","poem":1},{"text":"তিনি নিজেও আপনমনে কথা বললেন,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘ওরা কি লুন্ঠিত জিনিসপত্র পায়নি? ভাগাভাগি কি করেনি?","poem":1},{"text":"প্রত্যেক পুরুষের জন্য একটি বা দুটি করে রমণী,","poem":2},{"text":"সীষরার জন্য লুন্ঠিত রঙিন পোশাক,","poem":1},{"text":"দোরোখা রঙিন পোশাক,","poem":2},{"text":"আমার গ্রীবার জন্য উচ্চমানের দোরোখা পোশাক—","poem":1},{"text":"লুন্ঠিত জিনিসপত্ররূপে এসবই?’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“হে সদাপ্রভু, তোমার সব শত্রু এভাবেই বিনষ্ট হোক!","poem":1},{"text":"কিন্তু যারা তোমায় ভালোবাসে তারা সব সেই সূর্যের মতো হোক","poem":2},{"lineBreak":true},{"text":"যখন তা সপ্রতাপে উদিত হয়।”","poem":2},"পরে চল্লিশ বছর দেশে শান্তি বজায় ছিল।"]}],"footnotes":[{"noteId":13,"caller":"+","text":"অথবা, সদাপ্রভুর","reference":{"chapter":5,"verse":3}},{"noteId":14,"caller":"+","text":"অথবা, ইস্রায়েল যখন করল মনোনীত নতুন দেবতাদের","reference":{"chapter":5,"verse":8}},{"noteId":15,"caller":"+","text":"অথবা, শিবিরের; বা রসদ-ভাণ্ডারের","reference":{"chapter":5,"verse":16}}]},"thisChapterLink":"/api/ben_ocv/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}