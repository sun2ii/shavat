{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JER","translationId":"ben_ocv","name":"যিরমিয়","commonName":"যিরমিয়","title":"যিরমিয়","order":24,"numberOfChapters":52,"sha256":"e6e34ef04d5147a15937ae157118f2197b116b7cab1459581959699c3e9ec524","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ben_ocv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["ফিলিস্তিনীদের সম্পর্কে একটি বার্তা"]},{"type":"verse","number":1,"content":["ফরৌণ গাজা আক্রমণ করার পূর্বে, ফিলিস্তিনীদের সম্পর্কে ভাববাদী যিরমিয়ের কাছে সদাপ্রভুর এই বাক্য উপস্থিত হল:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["সদাপ্রভু এই কথা বলেন,",{"text":"“দেখো, উত্তর দিকের জলরাশি কেমন ফেঁপে উঠছে;","poem":1},{"text":"তা এক উপচে পড়া স্রোতে পরিণত হবে।","poem":2},{"text":"তা সেই দেশ, তার নগরগুলি ও সেগুলির মধ্যে বসবাসকারী","poem":1},{"text":"সব কিছুকেই প্লাবিত করবে।","poem":2},{"text":"লোকেরা চিৎকার করে উঠবে,","poem":1},{"text":"দেশে বসবাসকারী সকলেই বিলাপ করবে","poem":2}]},{"type":"verse","number":3,"content":[{"text":"দ্রুততম গতিতে ছুটে আসা অশ্বদের খুরের শব্দে,","poem":1},{"text":"শত্রুপক্ষের রথসমূহের কোলাহলে","poem":2},{"lineBreak":true},{"text":"ও তাদের চাকাগুলির ঘরঘরানিতে।","poem":2},{"text":"বাবারা তাদের সন্তানদের সাহায্য করতে ফিরে আসবে না,","poem":1},{"text":"তাদের হাতগুলি অবশ হয়ে ঝুলে থাকবে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কারণ সব ফিলিস্তিনীকে ধ্বংস করার,","poem":1},{"text":"যারা সোর ও সীদোনের সাহায্য করত,","poem":2},{"text":"সেই সমস্ত অবশিষ্ট লোককে উচ্ছিন্ন করার দিন,","poem":1},{"text":"এসে পড়েছে।","poem":2},{"text":"সদাপ্রভু ফিলিস্তিনীদের ধ্বংস করতে চলেছেন,","poem":1},{"text":"কপ্তোরের","poem":2},{"noteId":77},{"text":"উপকূল থেকে আসা অবশিষ্টদের তিনি ধ্বংস করবেন।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"গাজা বিলাপ করে তার মস্তক মুণ্ডন করবে;","poem":1},{"text":"অস্কিলোন নীরব হবে।","poem":2},{"text":"হে সমতলভূমির অবশিষ্ট লোকেরা,","poem":1},{"text":"তোমরা কত কাল নিজেদের শরীর কাটাকুটি করবে?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘আহ্, সদাপ্রভুর তরোয়াল,","poem":1},{"text":"আর কত কাল পরে তুমি ক্ষান্ত হবে?","poem":2},{"text":"তুমি নিজের কোষে প্রবেশ করো,","poem":1},{"text":"নিবৃত্ত হও ও শান্ত হও।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"কিন্তু তা কেমন করে ক্ষান্ত হবে,","poem":1},{"text":"যখন সদাপ্রভু তাকে আদেশ দিয়েছেন?","poem":2},{"text":"যখন তাঁর আদেশ নির্গত হয়েছে","poem":1},{"text":"অস্কিলোন ও উপকূল এলাকা আক্রমণ করার?”","poem":2}]}],"footnotes":[{"noteId":77,"caller":"+","text":"অর্থাৎ, ক্রীট দ্বীপের।","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/ben_ocv/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}