{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JER","translationId":"ben_ocv","name":"যিরমিয়","commonName":"যিরমিয়","title":"যিরমিয়","order":24,"numberOfChapters":52,"sha256":"e6e34ef04d5147a15937ae157118f2197b116b7cab1459581959699c3e9ec524","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ben_ocv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["মোয়াব দেশ সম্পর্কে একটি বার্তা"]},{"type":"verse","number":1,"content":["মোয়াব সম্পর্কে:",{"lineBreak":true},"বাহিনীগণের সদাপ্রভু, ইস্রায়েলের ঈশ্বর, এই কথা বলেন:",{"text":"“ধিক্ নেবোকে, কারণ তা ধ্বংস হবে।","poem":1},{"text":"কিরিয়াথয়িম অপমানিত ও পরহস্তগত হবে;","poem":2},{"lineBreak":true},{"text":"সেই দুর্গ","poem":2},{"noteId":78},{"text":"অবনমিত ও ভেঙে ফেলা হবে।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"মোয়াবের আর প্রশংসা করা হবে না;","poem":1},{"text":"হিষ্‌বোনে লোকেরা তার পতনের ষড়যন্ত্র করবে:","poem":2},{"lineBreak":true},{"text":"‘এসো, আমরা ওই জাতিকে শেষ করে দিই।’","poem":2},{"text":"ম্যাদমেন,","poem":1},{"noteId":79},{"text":"তোমারও মুখ বন্ধ করা হবে;","poem":1},{"text":"তরোয়াল তোমার পশ্চাদ্ধাবন করবে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"হোরোণয়িম থেকে কান্নার শব্দ শোনো,","poem":1},{"text":"সর্বনাশ ও মহাবিনাশের কান্না।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"মোয়াবকে ভেঙে ফেলা হবে;","poem":1},{"text":"তার ছোটো শিশুরা","poem":2},{"noteId":80},{"text":"কেঁদে উঠবে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তারা লূহীতের আরোহণ পথে উঠে যায়,","poem":1},{"text":"ওঠার সময় তারা তীব্র রোদন করে;","poem":2},{"text":"হোরোণয়িমের নেমে যাওয়ার পথে","poem":1},{"text":"বিনাশের জন্য মনস্তাপের কান্না শোনা যাচ্ছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমরা পালাও! তোমাদের প্রাণ বাঁচানোর জন্য দৌড়াও;","poem":1},{"text":"তোমরা প্রান্তরের ঝোপঝাড়ের","poem":2},{"noteId":81},{"text":"মতো হও।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তোমাদের নির্ভরতা ছিল তোমাদের কৃতকর্ম ও ঐশ্বর্যের উপর,","poem":1},{"text":"তোমাদেরও বন্দি করে নিয়ে যাওয়া হবে,","poem":2},{"text":"কমোশ-দেবতা নির্বাসনে যাবে","poem":1},{"text":"তার পুরোহিত ও কর্মকর্তা সমেত।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"বিনাশক সব নগরের বিরুদ্ধে আসবে,","poem":1},{"text":"কোনো নগরই রক্ষা পাবে না,","poem":2},{"text":"তলভূমি বিনষ্ট হবে","poem":1},{"text":"এবং সমভূমি উচ্ছিন্ন হবে,","poem":2},{"lineBreak":true},{"text":"কারণ সদাপ্রভু এই কথা বলেছেন।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"মোয়াবের ভূমিতে লবণ ছড়িয়ে দাও,","poem":1},{"text":"কারণ সে পরিত্যক্ত পড়ে থাকবে;","poem":2},{"noteId":82},{"text":"তার নগরগুলি হবে জনমানবহীন,","poem":1},{"text":"আর কেউই তার মধ্যে বসবাস করবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“অভিশপ্ত হোক সেই মানুষ, যে শিথিলভাবে সদাপ্রভুর কাজ করে!","poem":1},{"text":"অভিশপ্ত হোক সেই জন, যে তার তরোয়ালকে রক্তপাত করতে না দেয়!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“মোয়াব তার যৌবনকাল থেকে বিশ্রাম ভোগ করেছে,","poem":1},{"text":"যেভাবে দ্রাক্ষারস তার তলানির উপরে স্থির থাকে,","poem":2},{"text":"যখন এক পাত্র থেকে অন্য পাত্রে তা ঢালা হয় না,","poem":1},{"text":"সে কখনও নির্বাসনে যায়নি।","poem":2},{"text":"তাই তার স্বাদ পূর্বের মতোই থেকে গেছে,","poem":1},{"text":"তার সুগন্ধের পরিবর্তন হয়নি।”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"সদাপ্রভু ঘোষণা করেন, “কিন্তু সেদিন আসন্ন,","poem":1},{"lineBreak":true},{"text":"আমি তাদের প্রেরণ করব, যারা পাত্র থেকে ঢেলে দেয়,","poem":1},{"text":"আর তারা তাকে ঢেলে দেবে;","poem":2},{"text":"তারা তার পাত্রগুলি খালি করবে","poem":1},{"text":"ও ঢালবার জগগুলি চুরমার করবে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তখন মোয়াব কমোশ-দেবতার জন্য লজ্জিত হবে,","poem":1},{"text":"যেমন ইস্রায়েলের কুল লজ্জিত হয়েছিল","poem":2},{"lineBreak":true},{"text":"যখন তারা বেথেলে স্থাপিত দেবতায় নির্ভর করেছিল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“তোমরা কেমন করে বলতে পারো, ‘আমরা যোদ্ধা,","poem":1},{"text":"যুদ্ধে আমরা বীরত্ব দেখিয়েছি’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"মোয়াব ধ্বংস করা হবে ও তার নগরগুলি আক্রান্ত হবে;","poem":1},{"text":"তাদের সেরা যুবকেরা বধ্যস্থানে নেমে যাবে,”","poem":2},{"lineBreak":true},{"text":"রাজা এই কথা বলেন, যাঁর নাম বাহিনীগণের সদাপ্রভু।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“মোয়াবের পতন এসে পড়েছে;","poem":1},{"text":"দ্রুত এসে পড়বে তার দুর্যোগ।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"তার চারপাশে থাকা লোকেরা, যারা তার খ্যাতির কথা জানো,","poem":1},{"text":"তোমরা সবাই মোয়াবের জন্য বিলাপ করো।","poem":2},{"text":"বলো, ‘পরাক্রমী রাজদণ্ড কেমন ভেঙে গেছে,","poem":1},{"text":"সেই মহিমাময় কর্তৃত্ব কেমন ভেঙে পড়েছে!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“দীবোন-কন্যার অধিবাসীরা,","poem":1},{"lineBreak":true},{"text":"তোমরা মহিমার আসন থেকে নেমে এসো","poem":1},{"text":"ও শুকনো মাটির উপরে বসে পড়ো,","poem":2},{"text":"কারণ যিনি মোয়াবকে ধ্বংস করেন,","poem":1},{"text":"তিনি তোমাদের বিরুদ্ধে আসবেন","poem":2},{"lineBreak":true},{"text":"ও তোমাদের সুরক্ষিত নগরগুলি ধ্বংস করবেন।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"তোমরা, যারা অরোয়েরে বসবাস করো,","poem":1},{"text":"তোমরা রাস্তায় এসে দাঁড়াও ও দেখো।","poem":2},{"text":"পলায়মান পুরুষ ও পলাতক স্ত্রীকে জিজ্ঞাসা করো,","poem":1},{"text":"তাদের কাছে জানতে চাও, ‘কী হয়েছে?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"মোয়াব অপমানিত হয়েছে, কারণ সে ভেঙে পড়েছে।","poem":1},{"text":"তোমরা বিলাপ করো ও কান্নায় ভেঙে পড়ো!","poem":2},{"text":"অর্ণোন নদীর তীরে ঘোষণা করো,","poem":1},{"text":"মোয়াব ধ্বংস হয়েছে।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"সমভূমিতে বিচারদণ্ড এসে গেছে—","poem":1},{"text":"হোলন, যহস ও মেফাতে,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"দীবোন, নেবো ও বেথ-দিব্লাথয়িমে,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"কিরিয়াথয়িম, বেথ-গামূল ও বেথ-মিয়োনে,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"করিয়োৎ ও বস্রায়—","poem":2},{"lineBreak":true},{"text":"দূরে ও নিকটে, মোয়াবের সব নগরে।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"মোয়াবের শৃঙ্গ","poem":1},{"noteId":83},{"text":"কেটে ফেলা হয়েছে;","poem":1},{"text":"তার হাত ভেঙে গেছে,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“তাকে মত্ত করো,","poem":1},{"text":"কারণ সে সদাপ্রভুর বিরুদ্ধে বড়াই করেছে।","poem":2},{"text":"মোয়াব তার বমিতে গড়াগড়ি দিক,","poem":1},{"text":"সে সকলের বিদ্রুপের পাত্র হোক।","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ইস্রায়েল কি তোমার বিদ্রুপের পাত্র ছিল না?","poem":1},{"text":"সে কি চোরদের মধ্যে ধরা পড়েছিল","poem":2},{"text":"যে নিন্দাসূচক অবজ্ঞায় তুমি মাথা নাড়িয়েছিলে,","poem":1},{"text":"যখনই তার সম্পর্কে বলতে কোনও কথা?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"তোমরা যারা মোয়াবে বসবাস করো,","poem":1},{"text":"তোমরা নগরগুলি ছেড়ে বড়ো বড়ো পাথরের মধ্যে গিয়ে থাকো।","poem":2},{"text":"তোমরা কপোতের মতো হও,","poem":1},{"text":"যে তার বাসা গুহার মুখে তৈরি করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“আমরা মোয়াবের অহংকারের কথা শুনেছি,","poem":1},{"text":"তার লাগামছাড়া দম্ভ ও কল্পনার কথা,","poem":2},{"text":"তার অশিষ্টতা, অহংকার ও ঔদ্ধত্য","poem":1},{"text":"এবং তার তাচ্ছিল্যপূর্ণ মনোভাবের কথা।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"আমি তার অশিষ্টতার কথা জানি, কিন্তু তা কিছুই নয়,” সদাপ্রভু এই কথা বলেন,","poem":1},{"text":"“তার দর্প কোনো কাজের নয়।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"তাই আমি মোয়াবের জন্য বিলাপ করি,","poem":1},{"text":"সমস্ত মোয়াবের জন্য আর্তনাদ করি,","poem":2},{"lineBreak":true},{"text":"কীর্-হেরসের লোকদের জন্য কাতরোক্তি করি।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ওহে সিব্‌মার দ্রাক্ষালতা সব,","poem":1},{"text":"আমি তোমার জন্য কাঁদি, যেমন যাসের কাঁদে।","poem":2},{"text":"তোমার শাখাগুলি তো সাগর পর্যন্ত বিস্তৃত;","poem":1},{"text":"সেগুলি যাসের সমুদ্র পর্যন্ত পৌঁছেছে।","poem":2},{"text":"বিনাশকারীরা হামলে পড়েছে","poem":1},{"text":"তোমার পাকা ফল ও আঙুরগুলির উপর।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"মোয়াবের ফলের বাগান ও মাঠ থেকে","poem":1},{"text":"আনন্দ ও আমোদ অন্তর্হিত হয়েছে।","poem":2},{"text":"আমি মাড়াই যন্ত্রগুলি থেকে আঙুররসের প্রবাহ বন্ধ করেছি;","poem":1},{"text":"কেউই তা আনন্দরবের সঙ্গে মাড়াই করে না।","poem":2},{"text":"যদিও সেখানে চিৎকারের শব্দ শোনা যায়,","poem":1},{"text":"সেগুলি কিন্তু আনন্দের ধ্বনি নয়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“তাদের কান্নার শব্দ বৃদ্ধি পাচ্ছে","poem":1},{"text":"হিষ্‌বোন থেকে ইলিয়ালী ও যহস পর্যন্ত,","poem":2},{"text":"সোয়র থেকে হোরোণয়িম ও ইগ্লৎ-শলিশীয়া পর্যন্ত,","poem":1},{"text":"কারণ এমনকি, নিম্রীমের জলও শুকিয়ে গেছে।","poem":2}]},{"type":"verse","number":35,"content":[{"text":"মোয়াবে যারা উঁচু স্থানগুলিতে নৈবেদ্য উৎসর্গ করে,","poem":1},{"text":"যারা তাদের দেবদেবীর উদ্দেশ্যে ধূপদাহ করে,","poem":2},{"lineBreak":true},{"text":"আমি তাদের শেষ করে দেব,” সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“তাই আমার প্রাণ মোয়াবের জন্য বাঁশির সুরের মতো বিলাপ করে;","poem":1},{"text":"তা কীর্-হেরসের লোকদের জন্য বাঁশির সুরের মতো বিলাপ করে।","poem":2},{"text":"তাদের আহরিত ঐশ্বর্য শেষ হয়েছে।","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"সবার মস্তক মুণ্ডন করা,","poem":1},{"text":"প্রত্যেকের দাড়ি কামানো হয়েছে;","poem":2},{"text":"প্রত্যেকের হাত অস্ত্রের আঘাতে ফালাফালা করা হয়েছে,","poem":1},{"text":"তাদের সবার কোমরে রয়েছে শোকের কাপড় জড়ানো।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"মোয়াবের সমস্ত গৃহের ছাদে","poem":1},{"text":"এবং প্রকাশ্য স্থানের চকগুলিতে,","poem":2},{"text":"কেবলমাত্র শোকের ধ্বনি ছাড়া আর কিছু নেই,","poem":1},{"lineBreak":true},{"text":"কারণ আমি মোয়াবকে ভেঙে ফেলেছি,","poem":1},{"text":"কোনো পাত্রের মতো, যা আর কেউ চায় না,”","poem":2},{"lineBreak":true},{"text":"একথা সদাপ্রভু বলেন।","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“সে কেমন চূর্ণ হয়েছে! তারা কেমন বিলাপ করে!","poem":1},{"text":"মোয়াব কেমন লজ্জায় তার পিঠ ফেরায়!","poem":2},{"text":"মোয়াব হয়েছে এক উপহাসের পাত্র,","poem":1},{"text":"তার চারপাশের লোকদের কাছে এক বিভীষিকার মতো।”","poem":2}]},{"type":"verse","number":40,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“দেখো, মোয়াবের উপরে ডানা বিস্তার করে","poem":1},{"text":"এক ঈগল নিচে নেমে আসছে।","poem":2}]},{"type":"verse","number":41,"content":[{"text":"এর নগরগুলি","poem":1},{"noteId":84},{"text":"অধিকৃত হবে,","poem":1},{"text":"এর দুর্গগুলির দখল নেওয়া হবে।","poem":2},{"text":"সেদিন মোয়াবের যোদ্ধাদের হৃদয়","poem":1},{"text":"প্রসববেদনাগ্রস্ত নারীর মতো হবে।","poem":2}]},{"type":"verse","number":42,"content":[{"text":"মোয়াব জাতিগতভাবে বিনষ্ট হবে,","poem":1},{"text":"কারণ সে সদাপ্রভুর বিরুদ্ধে বড়াই করেছে।","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ওহে মোয়াবের জনগণ,","poem":1},{"text":"আতঙ্ক, গর্ত ও ফাঁদ তোমাদের জন্য অপেক্ষা করছে,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“আতঙ্ক থেকে যে পালায়,","poem":1},{"text":"সে গর্তে পড়ে যাবে,","poem":2},{"text":"যে গর্ত থেকে উঠে আসে,","poem":1},{"text":"সে ফাঁদে ধরা পড়বে;","poem":2},{"text":"কারণ আমি মোয়াবের উপরে","poem":1},{"text":"তার শাস্তির বছর নিয়ে আসব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“পলাতকেরা হিষ্‌বোনের ছায়াতলে","poem":1},{"text":"অসহায়ের মতো দাঁড়িয়ে থাকবে,","poem":2},{"text":"কারণ হিষ্‌বোন থেকে একটি আগুন বের হয়েছে,","poem":1},{"text":"সীহোনের মধ্য থেকে নির্গত হয়েছে এক আগুনের শিখা;","poem":2},{"text":"তা দগ্ধ করবে মোয়াবের কপাল","poem":1},{"text":"ও কোলাহলকারী দাম্ভিকদের মাথার খুলি।","poem":2}]},{"type":"verse","number":46,"content":[{"text":"হে মোয়াব, ধিক্ তোমাকে!","poem":1},{"lineBreak":true},{"text":"কমোশ-দেবতার লোকেরা ধ্বংস হয়েছে;","poem":1},{"lineBreak":true},{"text":"তোমার পুত্রেরা নির্বাসিত হয়েছে","poem":1},{"text":"ও তোমার কন্যারা বন্দি হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“তবুও, ভবিষ্যৎকালে","poem":1},{"text":"আমি মোয়াবের অবস্থার পরিবর্তন ঘটাব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2},"মোয়াবের বিচারদণ্ডের কথা এই পর্যন্ত।"]},{"type":"line_break"}],"footnotes":[{"noteId":78,"caller":"+","text":"হিব্রু: মিস্‌গব।","reference":{"chapter":48,"verse":1}},{"noteId":79,"caller":"+","text":"ম্যাদমেন শব্দটি হিব্রু “নীরব” শব্দটির মতো শোনায়। শব্দটি ইংরেজি “ম্যাড্‌মেন” শব্দের সঙ্গে গুলিয়ে ফেলা ঠিক হবে না।","reference":{"chapter":48,"verse":2}},{"noteId":80,"caller":"+","text":"গ্রিক সংস্করণে বলা হয়েছে: তার কান্না সুদূর সোয়র পর্যন্ত শোনা যাচ্ছে।","reference":{"chapter":48,"verse":4}},{"noteId":81,"caller":"+","text":"বা, অরোয়েরের মতো হও। মূল হিব্রু শব্দটির অর্থ অনিশ্চিত।","reference":{"chapter":48,"verse":6}},{"noteId":82,"caller":"+","text":"অথবা, “মোয়াবকে দুটি ডানা দাও, কারণ সে উড়ে পালিয়ে যাবে।”","reference":{"chapter":48,"verse":9}},{"noteId":83,"caller":"+","text":"“শৃঙ্গ” এখানে শক্তির প্রতীক।","reference":{"chapter":48,"verse":25}},{"noteId":84,"caller":"+","text":"হিব্রু: করিয়োৎ","reference":{"chapter":48,"verse":41}}]},"thisChapterLink":"/api/ben_ocv/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}