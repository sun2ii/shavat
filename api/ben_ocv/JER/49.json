{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JER","translationId":"ben_ocv","name":"যিরমিয়","commonName":"যিরমিয়","title":"যিরমিয়","order":24,"numberOfChapters":52,"sha256":"e6e34ef04d5147a15937ae157118f2197b116b7cab1459581959699c3e9ec524","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ben_ocv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["অম্মোনীয়দের সম্পর্কে ভাববাণী"]},{"type":"verse","number":1,"content":["অম্মোনীয়দের সম্পর্কে:",{"lineBreak":true},"সদাপ্রভু এই কথা বলেন:",{"text":"“ইস্রায়েলের কি কোনো পুত্র নেই?","poem":1},{"text":"তার কি কোনো উত্তরাধিকারী নেই?","poem":2},{"text":"তাহলে মোলক-দেবতা কেন গাদের এলাকা হস্তগত করেছে?","poem":1},{"text":"কেন তার লোকেরা এর নগরগুলিতে বসবাস করে?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"কিন্তু সেই দিনগুলি আসছে,” সদাপ্রভু এই কথা বলেন,","poem":1},{"lineBreak":true},{"text":"“যখন অম্মোনীয়দের রব্বা নগরের বিরুদ্ধে","poem":1},{"text":"আমি রণহুঙ্কার শোনাব;","poem":2},{"text":"তা তখন এক ধ্বংসস্তূপ হবে,","poem":1},{"text":"আর চারপাশের গ্রামগুলিতে আগুন লাগিয়ে দেওয়া হবে।","poem":2},{"text":"তখন ইস্রায়েল তাদের তাড়িয়ে দেবে,","poem":1},{"text":"একদিন যারা তাদের তাড়িয়ে দিয়েছিল,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“হে হিষ্‌বোন, বিলাপ করো, কারণ অয় নগর ধ্বংস হল!","poem":1},{"text":"ওহে রব্বার অধিবাসীরা, তোমরা হাহাকার করো!","poem":2},{"text":"শোকবস্ত্র পরে তোমরা শোকপ্রকাশ করো;","poem":1},{"text":"প্রাচীরগুলির ভিতরে এদিক-ওদিক ছুটোছুটি করো,","poem":2},{"text":"কারণ মোলক-দেবতা তার যাজক","poem":1},{"text":"ও কর্মকর্তাদের সঙ্গে নির্বাসনে যাবে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কেন তোমরা তোমাদের উপত্যকাগুলির জন্য,","poem":1},{"text":"তোমাদের উর্বর উপত্যকাগুলির জন্য গর্ব করো?","poem":2},{"text":"হে অবিশ্বস্ত অম্মোন কন্যা,","poem":1},{"text":"তুমি তোমার ঐশ্বর্যে নির্ভর করে বলো,","poem":2},{"lineBreak":true},{"text":"‘কে আমাকে আক্রমণ করবে?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তোমার চারপাশে যারা আছে,","poem":1},{"text":"তাদের কাছ থেকে আমি তোমার উপরে আতঙ্ক সৃষ্টি করব,”","poem":2},{"lineBreak":true},{"text":"প্রভু, বাহিনীগণের সদাপ্রভু এই কথা বলেন।","poem":2},{"text":"“তোমাদের সবাইকেই তাড়িয়ে দেওয়া হবে,","poem":1},{"text":"কেউই আর পলাতকদের সংগ্রহ করবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“তবুও পরবর্তী সময়ে, আমি অম্মোনীয়দের","poem":1},{"text":"দুর্দশার পরিবর্তন করব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"heading","content":["ইদোম সম্পর্কে ভাববাণী"]},{"type":"verse","number":7,"content":["ইদোম সম্পর্কে:",{"lineBreak":true},"বাহিনীগণের সদাপ্রভু এই কথা বলেন:",{"text":"“তৈমনে কি আর প্রজ্ঞা নেই?","poem":1},{"text":"বিচক্ষণেরা কি পরামর্শ দেওয়া শেষ করেছেন?","poem":2},{"lineBreak":true},{"text":"তাদের প্রজ্ঞা কি ক্ষয়প্রাপ্ত হয়েছে?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তোমরা যারা দদানে বসবাস করো,","poem":1},{"text":"পিছন ফিরে পালাও, গভীর গুহায় গিয়ে লুকাও,","poem":2},{"text":"কারণ আমি এষৌকে শাস্তি দেওয়ার সময়,","poem":1},{"text":"তার কুলে বিপর্যয় নিয়ে আসব।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"যদি আঙুর চয়নকারীরা তোমার কাছে আসত,","poem":1},{"text":"তারা কি কয়েকটি আঙুর রেখে যেত না?","poem":2},{"text":"যদি চোরেরা রাত্রিবেলা আসত,","poem":1},{"text":"তাদের যতটা প্রয়োজন, তারা ততটাই কি চুরি করত না?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"আমি কিন্তু এষৌর এলাকা জনমানবহীন করব;","poem":1},{"text":"আমি তার লুকানোর জায়গাগুলি প্রকাশ করে দেব,","poem":2},{"lineBreak":true},{"text":"যেন সে নিজেকে লুকিয়ে রাখতে না পারে।","poem":2},{"text":"তার সহযোগীরা ও প্রতিবেশীরা","poem":1},{"text":"এবং তার সশস্ত্র পুরুষেরা বিনষ্ট হবে,","poem":2},{"lineBreak":true},{"text":"আর তার বিষয় বলার আর কেউ থাকবে না।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‘তোমার অনাথ ছেলেমেয়েদের ছেড়ে যাও; আমি তাদের প্রাণরক্ষা করব।","poem":1},{"text":"তোমার বিধবারাও আমার উপরে নির্ভর করতে পারে।’ ”","poem":2}]},{"type":"verse","number":12,"content":["সদাপ্রভু এই কথা বলেন: “যদি নির্দোষ মানুষরা কষ্টভোগ করে, তাহলে তোমরা অবশ্যই আরও কত না কষ্টভোগ করবে?",{"noteId":85},"বিচারদণ্ডের এই পেয়ালা তোমাদের নিশ্চয়ই পান করতে হবে।”"]},{"type":"verse","number":13,"content":["সদাপ্রভু বলেন, “আমি নিজের নামেই শপথ করে বলছি, বস্রা ধ্বংসস্তূপে পরিণত হবে। তা হবে বিভীষিকার, দুর্নামের ও অভিশাপের আস্পদ। এর সব নগর চিরকালের জন্য ধ্বংস হয়ে পড়ে থাকবে।”"]},{"type":"verse","number":14,"content":[{"text":"আমি সদাপ্রভুর কাছ থেকে এক বাক্য শুনেছি:","poem":1},{"text":"জাতিগুলির কাছে এক দূত একথা বলার জন্য প্রেরিত হয়েছে,","poem":2},{"text":"“ইদোমের বিরুদ্ধে এক মিত্রবাহিনী গড়ে তোলো!","poem":1},{"text":"তোমরা যুদ্ধের জন্য প্রস্তুত হও!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“এবার আমি তোমাকে সব জাতির মধ্যে ক্ষুদ্র করব,","poem":1},{"text":"তুমি মানবসমাজে অবজ্ঞাত হবে।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"তুমি যে বড়ো বড়ো পাথরের ফাটলে বসবাস করো,","poem":1},{"text":"তোমরা যারা পাহাড়ের উঁচু উঁচু স্থানের অধিকারী,","poem":2},{"text":"তোমরা অন্যদের মধ্যে যে আতঙ্ক ছড়িয়ে থাকো","poem":1},{"text":"সেই কারণে ও তোমার অহংকারের জন্য, তুমি নিজেই প্রতারিত হয়েছ।","poem":2},{"text":"যদিও তুমি ঈগলের মতো অনেক উঁচুতে তোমার বাসস্থান নির্মাণ করো,","poem":1},{"text":"সেখান থেকে আমি তোমাকে নামিয়ে আনব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ইদোম হবে এক বিভীষিকার পাত্র;","poem":1},{"text":"যারাই তার পাশ দিয়ে যাবে,","poem":2},{"lineBreak":true},{"text":"তারা তার ক্ষতসকলের জন্য বিস্মিত হয়ে তার নিন্দা করবে।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"যেমন সদোম ও ঘমোরা","poem":1},{"text":"তাদের চারপাশের নগরগুলি সমেত উৎপাটিত হয়েছিল,” সদাপ্রভু এই কথা বলেন,","poem":2},{"text":"“সেইরকম, ইদোমেও কেউ বেঁচে থাকবে না,","poem":1},{"text":"কোনো মানুষই সেখানে বসবাস করবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“জর্ডনের জঙ্গলের মধ্য থেকে সিংহের মতো","poem":1},{"text":"সে সমৃদ্ধ চারণভূমির উপরে আসবে।","poem":2},{"text":"আমি ইদোমকে এক নিমেষে তারই দেশে তাড়া করব,","poem":1},{"text":"কে সেই মনোনীত জন যাকে আমি তার উপরে নিযুক্ত করব?","poem":2},{"text":"আমার মতো আর কে আছে? কে আমার প্রতিদ্বন্দ্বী হতে পারে?","poem":1},{"text":"কোনো মেষপালক আমার বিরুদ্ধে দাঁড়াতে পারে?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"সেই কারণে শোনো, সদাপ্রভু ইদোমের বিরুদ্ধে কী পরিকল্পনা করেছেন,","poem":1},{"text":"যারা তৈমনে বসবাস করে, তাদের জন্য তাঁর অভিপ্রায় কী:","poem":2},{"text":"পালের শাবকদের টেনে নিয়ে যাওয়া হবে;","poem":1},{"text":"তাদের কারণেই তিনি তাদের চারণভূমি সম্পূর্ণরূপে ধ্বংস করা হবে।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"তাদের পতনের কারণে সমস্ত পৃথিবী কম্পিত হবে;","poem":1},{"text":"তাদের কান্না লোহিত সাগর","poem":2},{"noteId":86},{"text":"পর্যন্ত প্রতিধ্বনিত হবে।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"দেখো! একটি ঈগল উঁচুতে উড়বে ও চকিতে আক্রমণ হানবে,","poem":1},{"text":"সে তার ডানা বস্রার উপরে মেলে ধরবে।","poem":2},{"text":"সেদিন, ইদোমের যোদ্ধাদের হৃদয়,","poem":1},{"text":"প্রসববেদনাগ্রস্ত স্ত্রীর হৃদয়ের মতো হবে।","poem":2}]},{"type":"heading","content":["দামাস্কাস সম্পর্কে ভাববাণী"]},{"type":"verse","number":23,"content":["দামাস্কাস সম্পর্কে:",{"text":"“হমাৎ ও অর্পদ ভয়ে ব্যাকুল হয়েছে,","poem":1},{"text":"কারণ তারা মন্দ সংবাদ শুনেছে।","poem":2},{"text":"তারা হতাশ হয়েছে,","poem":1},{"text":"অশান্ত সমুদ্রের মতো তারা অধীর হয়েছে।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"দামাস্কাস অক্ষম হয়েছে,","poem":1},{"text":"সে পিছন ফিরে পালিয়েছে","poem":2},{"lineBreak":true},{"text":"কারণ আতঙ্ক তাকে ঘিরে ধরেছে;","poem":2},{"text":"মনস্তাপ ও মর্মবেদনায় সে আচ্ছন্ন হয়েছে","poem":1},{"text":"যেমন কোনো প্রসববেদনাগ্রস্ত নারী হয়।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"সুখ্যাতিপূর্ণ এই নগর, যে আমার আনন্দের কারণস্বরূপ,","poem":1},{"lineBreak":true},{"text":"কেন এ পরিত্যক্ত হয়নি?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"নিশ্চয়ই, তার যুবকেরা পথে পথে পড়ে থাকবে,","poem":1},{"text":"সেদিন তার সব সৈন্য নিথর পড়ে থাকবে,”","poem":2},{"text":"বাহিনীগণের সদাপ্রভু এই কথা বলেন।","poem":3}]},{"type":"verse","number":27,"content":[{"text":"“আমি দামাস্কাসের সব প্রাচীরে আগুন লাগাব;","poem":1},{"text":"তা বিন্‌হদদের দুর্গগুলিকে গ্রাস করবে।”","poem":2}]},{"type":"heading","content":["কেদর ও হাৎসোর সম্পর্কে ভাববাণী"]},{"type":"verse","number":28,"content":["ব্যাবিলনের রাজা নেবুখাদনেজার যাদের আক্রমণ করেছিলেন, সেই কেদর ও হাৎসোরের রাজ্যগুলি সম্পর্কে:",{"lineBreak":true},"সদাপ্রভু এই কথা বলেন:",{"text":"“ওঠো, ও কেদরকে আক্রমণ করো","poem":1},{"text":"এবং পূর্বদিকের সব লোককে ধ্বংস করো।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"তাদের তাঁবুগুলি ও তাদের পশুপাল হরণ করা হবে;","poem":1},{"text":"তাদের সব জিনিসপত্র ও উটগুলি সমেত","poem":2},{"lineBreak":true},{"text":"তারা তাদের সঙ্গে নিয়ে যাবে।","poem":2},{"text":"লোকেরা চিৎকার করে তাদের বলবে,","poem":1},{"text":"‘চারদিকেই ভয়ের পরিবেশ!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“তাড়াতাড়ি পালিয়ে যাও!","poem":1},{"text":"হাৎসোরে বসবাসকারী তোমরা দুর্গম গুহাগুলিতে গিয়ে থাকো,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2},{"text":"“ব্যাবিলনের রাজা নেবুখাদনেজার তোমার বিরুদ্ধে ষড়যন্ত্র করেছে;","poem":1},{"text":"সে তোমার বিরুদ্ধে এক পরিকল্পনা রচনা করেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“ওঠো ও সেই নিশ্চিন্ত জাতিকে আক্রমণ করো,","poem":1},{"text":"যে নির্ভয়ে বসবাস করে,”","poem":2},{"text":"সদাপ্রভু এই কথা বলেন,","poem":3},{"text":"“সেই জাতির নগরে কোনো ফটক নেই, অর্গলও নেই,","poem":1},{"text":"তার লোকেরা নিরিবিলিতে বসবাস করে।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"তাদের উটগুলি হবে লুটের বস্তু,","poem":1},{"text":"তাদের বিশাল পশুপাল লুট করা হবে।","poem":2},{"text":"দূরবর্তী স্থানে","poem":1},{"noteId":87},{"text":"থাকা লোকেদের আমি চারপাশে ছড়িয়ে দেব,","poem":1},{"text":"সবদিক থেকে আমি তাদের উপরে বিপর্যয় নিয়ে আসব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“হাৎসোর হবে শিয়ালদের বাসস্থান,","poem":1},{"text":"চিরকালের জন্য পরিত্যক্ত এক স্থান।","poem":2},{"text":"কেউ সেখানে থাকবে না;","poem":1},{"text":"কোনো মানুষই সেখানে বসবাস করবে না।”","poem":2}]},{"type":"heading","content":["এলম সম্পর্কে ভাববাণী"]},{"type":"verse","number":34,"content":["যিহূদার রাজা সিদিকিয়ের রাজত্বের প্রথমদিকে, এলম সম্পর্কে সদাপ্রভুর এই বাক্য ভাববাদী যিরমিয়ের কাছে উপস্থিত হল।"]},{"type":"line_break"},{"type":"verse","number":35,"content":["সর্বশক্তিমান সদাপ্রভু এই কথা বলেন:",{"text":"“দেখো, আমি এলমের শক্তির মুখ্য অবলম্বন,","poem":1},{"text":"তাদের ধনুক ভেঙে ফেলব।","poem":2}]},{"type":"verse","number":36,"content":[{"text":"আমি আকাশমণ্ডলের চার প্রান্ত থেকে","poem":1},{"text":"এলমের বিরুদ্ধে চার বায়ু প্রেরণ করব;","poem":2},{"text":"আমি চার বায়ুর উদ্দেশে তাদের ছড়িয়ে ফেলব,","poem":1},{"text":"এমন কোনো জাতি থাকবে না,","poem":2},{"lineBreak":true},{"text":"যেখানে এলমের নির্বাসিত কেউ যাবে না।","poem":2}]},{"type":"verse","number":37,"content":[{"text":"আমি এলমের শত্রুদের সামনে,","poem":1},{"text":"যারা তাদের প্রাণনাশ করতে চায়,","poem":2},{"lineBreak":true},{"text":"তাদের সামনে আমি তাদের চূর্ণ করব;","poem":2},{"text":"আমি তাদের উপরে বিপর্যয়,","poem":1},{"text":"এমনকি, আমার ভয়ংকর ক্রোধ বর্ষণ করব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2},{"text":"“আমি তরোয়াল নিয়ে তাদের পিছনে তাড়া করে যাব,","poem":1},{"text":"যতক্ষণ না আমি তাদের শেষ করে দিই।","poem":2}]},{"type":"verse","number":38,"content":[{"text":"আমি এলমে আমার সিংহাসন স্থাপন করব,","poem":1},{"text":"তাদের রাজা ও সব কর্মচারীকে ধ্বংস করব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“তবুও, ভবিষ্যৎকালে আমি","poem":1},{"text":"এলমের অবস্থার পরিবর্তন ঘটাব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]}],"footnotes":[{"noteId":85,"caller":"+","text":"হিব্রু: যাদের ওই পেয়ালায় পান করার কথা নয়, তারা যদি পান করে থাকে, তাহলে তোমরা কেন অদণ্ডিত থাকবে?","reference":{"chapter":49,"verse":12}},{"noteId":86,"caller":"+","text":"হিব্রু: ইয়াম-সূফ, অর্থাৎ নলখাগড়ার সাগর।","reference":{"chapter":49,"verse":21}},{"noteId":87,"caller":"+","text":"হিব্রু: যারা নিজেদের কেশের প্রান্ত মুণ্ডন করে।","reference":{"chapter":49,"verse":32}}]},"thisChapterLink":"/api/ben_ocv/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}