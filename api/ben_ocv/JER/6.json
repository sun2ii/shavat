{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JER","translationId":"ben_ocv","name":"যিরমিয়","commonName":"যিরমিয়","title":"যিরমিয়","order":24,"numberOfChapters":52,"sha256":"e6e34ef04d5147a15937ae157118f2197b116b7cab1459581959699c3e9ec524","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ben_ocv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["জেরুশালেম অবরুদ্ধ"]},{"type":"verse","number":1,"content":[{"text":"“ওহে বিন্যামীন গোষ্ঠীর লোকেরা, তোমরা সুরক্ষার জন্য পলায়ন করো!","poem":1},{"text":"তোমরা জেরুশালেম থেকে পালিয়ে যাও!","poem":2},{"text":"তকোয় নগরে তূরী বাজাও!","poem":1},{"text":"বেথ-হক্কেরম থেকে সংকেত দেখাও!","poem":2},{"text":"কারণ বিপর্যয় ও বিধ্বংসের জন্য","poem":1},{"text":"উত্তর দিক থেকে আসছে এক ভয়ংকর ত্রাস।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"কমনীয় ও সুন্দরী সিয়োন-কন্যাকে","poem":1},{"noteId":11},{"text":"আমি ধ্বংস করব।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"মেষপালকেরা তাদের পশুপাল নিয়ে তার বিরুদ্ধে আসবে;","poem":1},{"text":"তারা তার চারপাশে তাদের তাঁবু স্থাপন করবে,","poem":2},{"lineBreak":true},{"text":"প্রত্যেকে নিজের নিজের অংশে তাদের পশুপাল চরাবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“তার বিরুদ্ধে যুদ্ধের জন্য প্রস্তুত হও।","poem":1},{"text":"ওঠো, আমরা মধ্যাহ্নেই তাদের আক্রমণ করি।","poem":2},{"text":"কিন্তু হায়, দিনের আলো ম্লান হয়ে আসছে,","poem":1},{"text":"আর সন্ধ্যের ছায়া দীর্ঘতর হচ্ছে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তাই ওঠো, চলো আমরা রাত্রিবেলা আক্রমণ করি","poem":1},{"text":"এবং তার দুর্গগুলি ধ্বংস করে দিই!”","poem":2}]},{"type":"verse","number":6,"content":["বাহিনীগণের সদাপ্রভু এই কথা বলেন:",{"text":"“সব গাছ কেটে ফেলো","poem":1},{"text":"আর জেরুশালেমের বিরুদ্ধে অবরোধ সৃষ্টি করো।","poem":2},{"text":"এই নগরকে অবশ্য শাস্তি দিতে হবে;","poem":1},{"text":"এরা উপদ্রবে পূর্ণ হয়েছে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"যেভাবে কোনো উৎস বেগে জল নির্গত করে,","poem":1},{"text":"তেমনই সে ক্রমাগত দুষ্টতা বের করে থাকে।","poem":2},{"text":"তার মধ্যে হিংস্রতা ও ধ্বংসের বাক্য প্রতিধ্বনিত হয়,","poem":1},{"text":"তার রোগব্যাধি ও ক্ষতগুলি সবসময়ই আমার সামনে থাকে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ওহে জেরুশালেম, সতর্ক হও,","poem":1},{"text":"নইলে আমি তোমার কাছ থেকে ফিরে যাব","poem":2},{"text":"এবং তোমার ভূমিকে উৎসন্ন করব,","poem":1},{"text":"যেন কেউ এর মধ্যে বসবাস করতে না পারে।”","poem":2}]},{"type":"verse","number":9,"content":["বাহিনীগণের সদাপ্রভু এই কথা বলেন:",{"text":"“যেভাবে আঙুর খুঁটে খুঁটে চয়ন করা হয়,","poem":1},{"text":"ইস্রায়েলের অবশিষ্ট লোকদেরও তারা তেমনই চয়ন করবে;","poem":2},{"text":"আঙুর শাখাগুলিতে তোমরা আবার হাত দাও,","poem":1},{"text":"যেন অবশিষ্ট আঙুরগুলিও তুলে নেওয়া যায়।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"কার সঙ্গে আমি কথা বলব, কাকে সতর্কবাক্য দেব?","poem":1},{"text":"কে শুনবে আমার কথা?","poem":2},{"text":"তাদের কান বন্ধ","poem":1},{"noteId":12},{"text":"হয়েছে","poem":1},{"text":"তাই তারা পায় না শুনতে।","poem":2},{"text":"সদাপ্রভুর বাক্য তাদের কাছে আপত্তিকর;","poem":1},{"text":"তারা তাতে কোনও আনন্দ পায় না।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"কিন্তু আমি সদাপ্রভুর ক্রোধে পূর্ণ,","poem":1},{"text":"আমি আর তা ধরে রাখতে পারছি না।","poem":2},{"lineBreak":true},{"text":"“রাস্তায় জড়ো হওয়া ছেলেমেয়েদের উপরে এবং","poem":1},{"text":"একসঙ্গে একত্র হওয়া যুবকদের উপরে তা ঢেলে দাও।","poem":2},{"text":"ঢেলে দাও তা স্বামী-স্ত্রীর উপরে","poem":1},{"text":"এবং তাদের উপরে, যারা বৃদ্ধ ও বয়সের ভারে জর্জরিত।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তাদের খেতের জমি ও স্ত্রীদের সঙ্গে","poem":1},{"text":"তাদের বসতবাড়িগুলিও আমি অন্যদের হাতে তুলে দেব,","poem":2},{"text":"যখন আমি আমার হাত প্রসারিত করব,","poem":1},{"text":"তাদের বিরুদ্ধে, যারা দেশের মধ্যে করবে বসবাস,”","poem":2},{"text":"সদাপ্রভু এই কথা বলেন।","poem":3}]},{"type":"verse","number":13,"content":[{"text":"“নগণ্যতম জন থেকে মহান ব্যক্তি পর্যন্ত,","poem":1},{"text":"সকলেই লোভ-লালসায় লিপ্ত;","poem":2},{"text":"ভাববাদী ও যাজকেরা সব এক রকম,","poem":1},{"text":"তারা সকলেই প্রতারণার অনুশীলন করে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"তারা আমার প্রজাদের ক্ষত এভাবে নিরাময় করে,","poem":1},{"text":"যেন তা একটুও ক্ষতিকর নয়।","poem":2},{"text":"যখন কোনো শান্তি নেই,","poem":1},{"text":"তখন ‘শান্তি, শান্তি,’ বলে তারা আশ্বাস দেয়।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তাদের এই জঘন্য আচরণের জন্য তারা কি লজ্জিত?","poem":1},{"text":"না, তাদের কোনও লজ্জা নেই;","poem":2},{"lineBreak":true},{"text":"লজ্জারুণ হতে তারা জানেই না।","poem":2},{"text":"তাই, পতিতদের মধ্যে তারাও পতিত হবে;","poem":1},{"text":"আমি যখন তাদের শাস্তি দেব, তখন তাদেরও ভূপাতিত করব,”","poem":2},{"text":"সদাপ্রভু এই কথা বলেন।","poem":3}]},{"type":"verse","number":16,"content":["সদাপ্রভু এই কথা বলেন:",{"text":"“তোমরা চৌমাথায় গিয়ে দাঁড়াও ও তাকিয়ে দেখো;","poem":1},{"text":"পুরোনো পথের কথা জিজ্ঞাসা করো,","poem":2},{"text":"জেনে নাও, উৎকৃষ্ট পথ কোন দিকে এবং সেই পথে চলো,","poem":1},{"text":"তাহলে তোমরা নিজের নিজের প্রাণের জন্য বিশ্রাম পাবে।","poem":2},{"lineBreak":true},{"text":"কিন্তু তোমরা বললে, ‘আমরা এই পথ মাড়াব না।’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"আমি তোমাদের উপরে প্রহরী নিযুক্ত করে বললাম,","poem":1},{"text":"‘তোমরা তূরীর