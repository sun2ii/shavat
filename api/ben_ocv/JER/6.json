"poem":1},{"text":"মনস্তাপে আমরা জর্জরিত হয়েছি।","poem":2}]},{"type":"verse","number":25,"content":[{"text":"তোমরা মাঠে যেয়ো না,","poem":1},{"text":"বা রাস্তায়ও হাঁটাচলা কোরো না,","poem":2},{"text":"কারণ শত্রুর কাছে অস্ত্র আছে,","poem":1},{"text":"আর চতুর্দিকেই আছে আতঙ্কের পরিবেশ।","poem":2}]},{"type":"verse","number":26,"content":[{"text":"আমার প্রজারা, চটের পোশাক পরে নাও","poem":1},{"text":"এবং ছাইয়ের মধ্যে গড়াগড়ি দাও;","poem":2},{"text":"একমাত্র পুত্রবিয়োগের মতো","poem":1},{"text":"শোক ও তিক্ত বিলাপ করো,","poem":2},{"text":"কারণ ধ্বংসকারী হঠাৎই আমাদের উপরে","poem":1},{"text":"এসে পড়বে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“আমি তোমাকে ধাতু যাচাইকারীর পরীক্ষক","poem":1},{"text":"এবং আমার প্রজাদের আকরিক করেছি,","poem":2},{"text":"যেন তুমি তাদের পথসকল নিরীক্ষণ","poem":1},{"text":"ও পরীক্ষা করতে পারো।","poem":2}]},{"type":"verse","number":28,"content":[{"text":"তারা হল কঠিন হৃদয় বিশিষ্ট বিদ্রোহী,","poem":1},{"text":"তারা কেবলই নিন্দা করে বেড়ায়।","poem":2},{"text":"তারা পিতল আর লোহার মতো;","poem":1},{"text":"তারা সবাই ভ্রষ্টাচার করে।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"হাপরগুলি ভীষণভাবে বাতাস দিচ্ছে,","poem":1},{"text":"যেন আগুনে সীসা গলে যায়,","poem":2},{"text":"কিন্তু এই পরিশোধন প্রক্রিয়া বিফল হয়,","poem":1},{"text":"দুষ্টদের শোধন হয় না।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"তাদের বাতিল করা রুপো বলা হয়,","poem":1},{"text":"কারণ সদাপ্রভু তাদের বাতিল গণ্য করেছেন।”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"অর্থাৎ, জেরুশালেমকে।","reference":{"chapter":6,"verse":2}},{"noteId":12,"caller":"+","text":"হিব্রু: অচ্ছিন্নত্বক","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/ben_ocv/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}