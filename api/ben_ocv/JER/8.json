{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JER","translationId":"ben_ocv","name":"যিরমিয়","commonName":"যিরমিয়","title":"যিরমিয়","order":24,"numberOfChapters":52,"sha256":"e6e34ef04d5147a15937ae157118f2197b116b7cab1459581959699c3e9ec524","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ben_ocv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘সদাপ্রভু বলেন, সেই সময় যিহূদার রাজা ও রাজকর্মচারীদের হাড়, যাজক ও ভাববাদীদের হাড় এবং জেরুশালেমের লোকদের হাড়, তাদের কবর থেকে অপসারিত করা হবে।"]},{"type":"verse","number":2,"content":["সেগুলি সূর্য, চাঁদ ও আকাশের সেইসব তারার সাক্ষাতে খোলা পড়ে থাকবে, যাদের তারা ভালোবাসত ও সেবা করত, যাদের অনুসারী হয়ে তারা তাদের সঙ্গে পরামর্শ করত ও উপাসনা করত। সেই হাড়গুলি আর একত্র সংগ্রহ করা হবে না বা কবর দেওয়া হবে না, কিন্তু আবর্জনার মতো মাটিতে পড়ে থাকবে।"]},{"type":"verse","number":3,"content":["বাহিনীগণের সদাপ্রভু এই কথা বলেন, আমি যেখানেই তাদের নির্বাসিত করি, সেখানে এই মন্দ জাতির অবশিষ্ট জীবিত লোকেরা জীবনের চেয়ে মৃত্যুই বেশি পছন্দ করবে।’"]},{"type":"heading","content":["পাপ ও শাস্তি"]},{"type":"verse","number":4,"content":["“তাদের বলো, ‘সদাপ্রভু এই কথা বলেন:",{"text":"“ ‘মানুষ যখন পড়ে যায়, তখন তারা কি ওঠে না?","poem":1},{"text":"কোনো মানুষ বিপথগামী হলে, সে কি ফিরে আসে না?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তাহলে কেন এসব লোক বিপথে গিয়েছে?","poem":1},{"text":"কেন জেরুশালেম সবসময় বিপথগামী হয়?","poem":2},{"text":"তারা ছলনার বাক্যকে আঁকড়ে ধরে,","poem":1},{"text":"তারা ফিরে আসতে চায় না।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"আমি মনোযোগ দিয়ে শুনেছি,","poem":1},{"text":"কিন্তু সঠিক বিষয় কি, তারা তা বলে না।","poem":2},{"text":"কেউই তার দুষ্টতার জন্য অনুতাপ করে না,","poem":1},{"text":"বলে, “আমি কী করেছি?”","poem":2},{"text":"অশ্ব যেমন যুদ্ধের জন্য দৌড়ায়,","poem":1},{"text":"তারা সবাই তেমনই নিজের নিজের পথে যায়।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"এমনকি, আকাশের সারসও","poem":1},{"text":"তার নির্ধারিত সময় জানে,","poem":2},{"text":"এবং ঘুঘু, ফিঙে ও ময়না","poem":1},{"text":"তাদের গমনকাল রক্ষা করে।","poem":2},{"text":"কিন্তু আমার প্রজারা জানে না","poem":1},{"text":"তাদের সদাপ্রভুর বিধিনিয়ম।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘তোমরা কীভাবে বলো, “আমরা জ্ঞানবান,","poem":1},{"text":"কারণ আমাদের কাছে আছে সদাপ্রভুর বিধান,”","poem":2},{"text":"যখন শাস্ত্রবিদদের মিথ্যা লেখনী,","poem":1},{"text":"তা মিথ্যা করে লিখেছে?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"জ্ঞানবানেরা লজ্জিত হবে;","poem":1},{"text":"তারা হতাশ হয়ে ফাঁদে ধরা পড়বে।","poem":2},{"text":"তারা যেহেতু সদাপ্রভুর বাক্য অগ্রাহ্য করেছে,","poem":1},{"text":"তাহলে তাদের কী ধরনের প্রজ্ঞা আছে?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"সেই কারণে, আমি তাদের স্ত্রীদের নিয়ে অন্য লোকদের দেব,","poem":1},{"text":"তাদের খেতগুলি নতুন সব মালিককে দেব।","poem":2},{"text":"নগণ্যতম জন থেকে মহান ব্যক্তি পর্যন্ত,","poem":1},{"text":"সকলেই লোভ-লালসায় লিপ্ত;","poem":2},{"text":"ভাববাদী ও যাজকেরা সব এক রকম,","poem":1},{"text":"তারা সকলেই প্রতারণার অনুশীলন করে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তারা আমার প্রজাদের ক্ষত এভাবে নিরাময় করে,","poem":1},{"text":"যেন তা একটুও ক্ষতিকর নয়।","poem":2},{"text":"যখন কোনো শান্তি নেই,","poem":1},{"text":"তখন “শান্তি, শান্তি,” বলে তারা আশ্বাস দেয়।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তাদের এই জঘন্য আচরণের জন্য তারা কি লজ্জিত?","poem":1},{"text":"না, তাদের কোনও লজ্জা নেই;","poem":2},{"lineBreak":true},{"text":"লজ্জাবনত হতে তারা জানেই না।","poem":2},{"text":"তাই, পতিতদের মধ্যে তারাও পতিত হবে;","poem":1},{"text":"আমি যখন তাদের শাস্তি দিই, তখন তাদেরও ভূপতিত করব,","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘আমি তাদের সব শস্য শেষ করে দেব,","poem":1},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2},{"lineBreak":true},{"text":"তাদের দ্রাক্ষালতায় কোনো আঙুর থাকবে না।","poem":2},{"text":"ডুমুর গাছে থাকবে না কোনো ডুমুর,","poem":1},{"text":"তাদের পাতাগুলি শুকিয়ে যাবে।","poem":2},{"text":"আমি যা কিছু তাদের দিয়েছিলাম,","poem":1},{"text":"সব তাদের কাছ থেকে ফিরিয়ে নেব।","poem":2},{"noteId":13},{"text":"’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"কেন আমরা এখানে বসে আছি?","poem":1},{"text":"এসো, সবাই একত্র হই!","poem":2},{"text":"এসো আমরা সুরক্ষিত নগরগুলিতে পালিয়ে যাই","poem":1},{"text":"এবং সেখানে ধ্বংস হই!","poem":2},{"text":"কারণ আমাদের ঈশ্বর সদাপ্রভু আমাদের ধ্বংস হওয়ার জন্য নিরূপণ করেছেন","poem":1},{"text":"এবং আমাদের পান করার জন্য বিষাক্ত জল দিয়েছেন,","poem":2},{"lineBreak":true},{"text":"কারণ আমরা তাঁর বিরুদ্ধে পাপ করেছি।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"আমরা শান্তির আশা করলাম","poem":1},{"text":"কিন্তু কোনো মঙ্গল হল না,","poem":2},{"text":"আমরা রোগনিরাময়ের অপেক্ষা করেছিলাম,","poem":1},{"text":"কিন্তু কেবলমাত্র আতঙ্কের সম্মুখীন হলাম।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"দান অঞ্চল থেকে","poem":1},{"text":"শত্রুদের অশ্বের নাসারব শোনা যাচ্ছে;","poem":2},{"text":"তাদের অশ্বগুলির হ্রেষারবে","poem":1},{"text":"সমস্ত দেশ কম্পিত হচ্ছে।","poem":2},{"text":"এই দেশ ও এর ভিতরের সবকিছু,","poem":1},{"text":"এই নগর ও এর মধ্যে বসবাসকারী সবাইকে,","poem":2},{"lineBreak":true},{"text":"তারা গ্রাস করার জন্য এসেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“দেখো, আমি তোমাদের মধ্যে বিষধর সাপ প্রেরণ করব,","poem":1},{"text":"সেই কালসাপগুলিকে মন্ত্রমুগ্ধ করা যাবে না,","poem":2},{"lineBreak":true},{"text":"আর তারা তোমাদের দংশন করবে,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা বলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"আমার দুঃখ নিরাময়ের ঊর্ধ্বে,","poem":1},{"text":"আমার অন্তর ভগ্নচূর্ণ হয়েছে।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"এক দূরবর্তী দেশ থেকে","poem":1},{"text":"আমার প্রজাদের কান্না শ্রবণ করো:","poem":2},{"text":"“সদাপ্রভু কি সিয়োনে নেই?","poem":1},{"text":"তার রাজা কি আর সেখানে থাকেন না?”","poem":2},{"lineBreak":true},{"text":"“তাদের দেবমূর্তিগুলির দ্বারা, তাদের সেই অসার বিজাতীয় দেবপ্রতিমাগুলির দ্বারা,","poem":1},{"text":"তারা কেন আমার ক্রোধের উদ্রেক করেছে?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“শস্যচয়নের কাল অতীত হয়েছে,","poem":1},{"text":"গ্রীষ্মকাল শেষ হয়েছে,","poem":2},{"lineBreak":true},{"text":"কিন্তু আমাদের উদ্ধারলাভ হয়নি।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"আমার জাতির লোকেরা যেহেতু চূর্ণ হয়েছে, আমিও চূর্ণ হয়েছি;","poem":1},{"text":"আমি শোক করি, আতঙ্ক আমাকে ঘিরে ধরেছে।","poem":2}]},{"type":"verse","number":22,"content":[{"text":"গিলিয়দে কি কোনো ব্যথার মলম নেই?","poem":1},{"text":"সেখানে কি কোনো চিকিৎসক নেই?","poem":2},{"text":"তাহলে কেন আমার জাতির লোকেদের ক্ষত","poem":1},{"text":"নিরাময় হয় না?","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"হিব্রু ভাষায় এই বাক্যের অর্থ অনিশ্চিত","reference":{"chapter":8,"verse":13}}]},"thisChapterLink":"/api/ben_ocv/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}