{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JOL","translationId":"ben_ocv","name":"যোয়েল","commonName":"যোয়েল","title":"যোয়েল","order":29,"numberOfChapters":3,"sha256":"f44162b5b75086e3cd86ffd49d2b823b8ad31e0ee7cf6f98d4128be23ca04cf2","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["সদাপ্রভুর এই বাক্য পথূয়েলের পুত্র যোয়েলের কাছে উপস্থিত হল।"]},{"type":"line_break"},{"type":"heading","content":["পঙ্গপালের আক্রমণ"]},{"type":"verse","number":2,"content":[{"text":"আপনারা যারা প্রাচীন, একথা শুনুন;","poem":1},{"text":"দেশে বসবাসকারী তোমরা সকলেই শোনো।","poem":2},{"text":"তোমাদের সময়কালে, কিংবা তোমাদের পিতৃপুরুষদের সময়ে,","poem":1},{"text":"এরকম ঘটনা কখনও কি ঘটেছে?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তোমাদের সন্তানদের কাছে একথা বলো,","poem":1},{"text":"তোমাদের সন্তানেরা তাদের সন্তানদের কাছে একথা বলুক,","poem":2},{"lineBreak":true},{"text":"আর তাদের সন্তানেরা বলুক পরবর্তী প্রজন্মের কাছে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"পঙ্গপালের ঝাঁক যা ছেড়ে গিয়েছে,","poem":1},{"text":"তা বড়ো পঙ্গপালেরা খেয়ে ফেলেছে;","poem":2},{"text":"বড়ো পঙ্গপালের যা ছেড়ে দিয়েছে,","poem":1},{"text":"তরুণ পঙ্গপালেরা তা খেয়ে ফেলেছে;","poem":2},{"text":"আর তরুণ পঙ্গপালেরা যা ছেড়ে দিয়েছে,","poem":1},{"text":"তা অন্য পঙ্গপালেরা খেয়ে ফেলেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ওহে মাতাল ব্যক্তিরা, তোমরা ওঠো ও কাঁদো!","poem":1},{"text":"যারা সুরা পান করো, তোমরা বিলাপ করো;","poem":2},{"text":"নতুন দ্রাক্ষারসের জন্য বিলাপ করো,","poem":1},{"text":"কারণ তা তোমাদের মুখ থেকে কেড়ে নেওয়া হয়েছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"এক জাতি আমার দেশকে আক্রমণ করেছে,","poem":1},{"text":"তারা শক্তিশালী ও সংখ্যায় অগণ্য;","poem":2},{"text":"তার আছে সিংহের মতো দাঁত,","poem":1},{"text":"আছে সিংহীর মতো কশের দাঁত।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"সে আমার দ্রাক্ষালতা নষ্ট করেছে,","poem":1},{"text":"আমার ডুমুর গাছগুলি ধ্বংস করেছে।","poem":2},{"text":"সে তাদের ছালগুলি খুলে দূরে ফেলে দিয়েছে,","poem":1},{"text":"তাদের শাখাপ্রশাখা ত্বকশূন্য সাদা দেখা যায়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"তোমরা শোকবস্ত্র পরে যুবতী নারীর মতো বিলাপ করো,","poem":1},{"text":"যে যৌবনেই তার স্বামীর মৃত্যুতে শোক করে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"শস্য-নৈবেদ্য ও পেয়-নৈবেদ্য সকল","poem":1},{"text":"সদাপ্রভুর গৃহ থেকে অপহৃত হয়েছে।","poem":2},{"text":"যারা সদাপ্রভুর সামনে পরিচর্যা করেন,","poem":1},{"text":"সেই যাজকেরা সবাই শোক করছেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"মাঠগুলি সব বিধ্বস্ত হয়েছে,","poem":1},{"text":"জমি শুকিয়ে গেছে;","poem":2},{"text":"শস্যরাশি ধ্বংস করা হয়েছে,","poem":1},{"text":"নতুন দ্রাক্ষারস শুকিয়ে গেছে,","poem":2},{"lineBreak":true},{"text":"তেল সব শেষ হতে চলেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ওহে কৃষকেরা, তোমরা হতাশ হও,","poem":1},{"text":"দ্রাক্ষাচাষিরা, তোমরা বিলাপ করো;","poem":2},{"text":"তোমরা গম ও যবের জন্য দুঃখ প্রকাশ করো,","poem":1},{"text":"কারণ মাঠের সব উৎপন্ন শস্য ধ্বংস হয়েছে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"দ্রাক্ষালতা শুকিয়ে গেছে","poem":1},{"text":"ও ডুমুর গাছ জীর্ণ হয়েছে;","poem":2},{"text":"ডালিম, খেজুর ও আপেল গাছ—","poem":1},{"text":"মাঠের যত গাছপালা—শুকিয়ে গেছে।","poem":2},{"text":"সত্যিই মানবজাতির সব আনন্দ","poem":1},{"text":"ফুরিয়ে গেছে।","poem":2}]},{"type":"heading","content":["মনপরিবর্তনের জন্য আহ্বান"]},{"type":"verse","number":13,"content":[{"text":"ওহে যাজকেরা, তোমরা শোকের বস্ত্র পরে বিলাপ করো;","poem":1},{"text":"যারা বেদির সামনে পরিচর্যা করো, তোমরা হাহাকার করো।","poem":2},{"text":"তোমরা, যারা আমার ঈশ্বরের সামনে পরিচর্যা করো,","poem":1},{"text":"তোমরাও এসো, সমস্ত রাত্রি শোকের বস্ত্র পরে কাটাও;","poem":2},{"text":"কারণ ভক্ষ্য-নৈবেদ্য ও পেয়-নৈবেদ্য","poem":1},{"text":"তোমাদের ঈশ্বরের গৃহে আনা হয়নি।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"এক পবিত্র উপবাস-পর্ব ঘোষণা করো,","poem":1},{"text":"এক পবিত্র সভার আহ্বান করো।","poem":2},{"text":"প্রাচীনদের ও যারা দেশে বসবাস করে,","poem":1},{"text":"তাদের সবাইকে তলব করো,","poem":2},{"text":"তারা যেন তোমাদের ঈশ্বর সদাপ্রভুর গৃহে আসে","poem":1},{"text":"ও সদাপ্রভুর কাছে ক্রন্দন করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"হায় হায়, সে কেমন দিন!","poem":1},{"text":"কারণ সদাপ্রভুর দিন সন্নিকট;","poem":2},{"lineBreak":true},{"text":"এ যেন সর্বশক্তিমানের কাছ থেকে বিনাশের মতো আসছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"আমাদের চোখের সামনে থেকেই কি খাবার,","poem":1},{"text":"আনন্দ ও উল্লাস আমাদের ঈশ্বরের গৃহ থেকে নিয়ন্ত্রিত করা হয়নি?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"যত শস্যবীজ মাটির ঢেলার নিচে","poem":1},{"text":"পচে গেছে।","poem":2},{"text":"শস্যভাণ্ডারের গৃহগুলি ধ্বংস হয়েছে,","poem":1},{"text":"গোলাঘরগুলি ভেঙে ফেলা হয়েছে,","poem":2},{"lineBreak":true},{"text":"কারণ শস্য সব শুকিয়ে গেছে।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"পশুপাল কেমন আর্তস্বর করছে!","poem":1},{"text":"বলদের পাল দিশেহারা হয়ে পড়েছে,","poem":2},{"text":"কারণ তাদের জন্য কোনো চারণভূমি নেই।","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"হে সদাপ্রভু, আমি তোমাকেই ডাকি,","poem":1},{"text":"কারণ আগুন খোলা চারণভূমিকে গ্রাস করেছে","poem":2},{"lineBreak":true},{"text":"আর আগুনের শিখা মাঠের সমস্ত গাছপালা দগ্ধ করেছে।","poem":2}]},{"type":"verse","number":20,"content":[{"text":"এমনকি, বুনো পশুরাও হাঁপাতে হাঁপাতে তোমার দিকে চেয়ে আছে;","poem":1},{"text":"জলের সমস্ত উৎস শুকিয়ে গেছে","poem":2},{"lineBreak":true},{"text":"আর আগুন খোলা চারণভূমিগুলি ধ্বংস করেছে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}