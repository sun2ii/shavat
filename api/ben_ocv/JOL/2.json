{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JOL","translationId":"ben_ocv","name":"যোয়েল","commonName":"যোয়েল","title":"যোয়েল","order":29,"numberOfChapters":3,"sha256":"f44162b5b75086e3cd86ffd49d2b823b8ad31e0ee7cf6f98d4128be23ca04cf2","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["পঙ্গপালের ঝাঁক"]},{"type":"verse","number":1,"content":[{"text":"তোমরা সিয়োনে তূরী বাজাও;","poem":1},{"text":"আমার পবিত্র পর্বতে সিংহনাদ তোলো।","poem":2},{"lineBreak":true},{"text":"দেশে বসবাসকারী সকলে ভয়ে কাঁপুক,","poem":1},{"text":"কারণ সদাপ্রভুর দিন এসে পড়েছে।","poem":2},{"text":"হ্যাঁ, সেদিন কাছে এসে পড়েছে—","poem":1}]},{"type":"verse","number":2,"content":[{"text":"তা অন্ধকার ও নিরানন্দের দিন,","poem":2},{"lineBreak":true},{"text":"মেঘের ও গাঢ় অন্ধকারের দিন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"তাদের সামনে আগুন গ্রাস করে,","poem":1},{"text":"তাদের পিছনে আগুনের শিখা জ্বলে।","poem":2},{"text":"তাদের সামনে দেশ হয় যেন এদন উদ্যানের মতো,","poem":1},{"text":"তাদের পিছনে থাকে এক পরিত্যক্ত মরুপ্রান্তর—","poem":2},{"text":"কোনো কিছুই তাদের কাছ থেকে রেহাই পায় না।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"তাদের আকার অশ্বের মতো,","poem":1},{"text":"তারা অশ্বারোহী সৈন্যদের মতো ছুটে চলে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"বহু রথের শব্দের মতো ধ্বনি তুলে,","poem":1},{"text":"নাড়া গ্রাসকারী আগুনের মতো শব্দ তুলে,","poem":2},{"lineBreak":true},{"text":"তারা পাহাড়ের চূড়ায় লাফ দেয়,","poem":2},{"text":"তারা যেন যুদ্ধের উদ্দেশে শ্রেণীভূত পরাক্রমী সৈন্যদলের মতো।","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"তাদের দেখামাত্র জাতিসমূহ মনস্তাপে দগ্ধ হয়;","poem":1},{"text":"প্রত্যেকের মুখ বিবর্ণ হয়ে যায়।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তারা বীর যোদ্ধাদের মতো দৌড়ায়,","poem":1},{"text":"সৈন্যদের মতো তারা প্রাচীর পরিমাপ করে।","poem":2},{"text":"তারা সুশৃঙ্খলভাবে সমরাভিযান করে,","poem":1},{"text":"কেউই তার স্থান থেকে বিচ্যুত হয় না।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তারা একে অন্যের উপরে চাপাচাপি করে পড়ে না,","poem":1},{"text":"প্রত্যেকেই সোজা চলাপথে অগ্রসর হয়।","poem":2},{"text":"প্রতিরোধ ব্যবস্থা তারা ভেদ করে,","poem":1},{"text":"কেউই তার লাইন ভেঙে ফেলে না।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তারা নগরের মধ্যে দ্রুত দৌড়ে যায়,","poem":1},{"text":"তারা প্রাচীরের উপরে দৌড়াতে থাকে।","poem":2},{"text":"তারা ঘরবাড়ির উপরে চড়ে,","poem":1},{"text":"চোরের মতো জানালা দিয়ে ভিতরে প্রবেশ করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তাদের সামনে পৃথিবী কম্পিত হয়,","poem":1},{"text":"আকাশমণ্ডল কাঁপতে থাকে,","poem":2},{"text":"সূর্য ও চাঁদ অন্ধকার হয়ে যায়,","poem":1},{"text":"নক্ষত্রেরা আর দীপ্তি দেয় না।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"সদাপ্রভু তাঁর সৈন্যদলের পুরোভাগে","poem":1},{"text":"বজ্রধ্বনি করেন;","poem":2},{"text":"তাঁর সৈন্যসংখ্যা গণনার অতীত,","poem":1},{"text":"যারা তাঁর আদেশ পালন করে, তারা পরাক্রমী বীর।","poem":2},{"text":"সদাপ্রভুর দিন অতি মহৎ;","poem":1},{"text":"তা ভয়ংকর।","poem":2},{"lineBreak":true},{"text":"কে তা সহ্য করতে পারে?","poem":2}]},{"type":"heading","content":["তোমাদের হৃদয় চিরো"]},{"type":"verse","number":12,"content":[{"text":"সদাপ্রভু ঘোষণা করেন, “তোমরা এখনই,","poem":1},{"text":"তোমাদের সম্পূর্ণ মনেপ্রাণে আমার কাছে ফিরে এসো,","poem":2},{"lineBreak":true},{"text":"তোমরা উপবাস ও কান্নার সঙ্গে, শোক করতে করতে ফিরে এসো।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"তোমাদের পোশাক নয়,","poem":1},{"text":"কিন্তু তোমরা নিজের নিজের হৃদয় বিদীর্ণ করো।","poem":2},{"text":"তোমরা তোমাদের ঈশ্বর সদাপ্রভুর কাছে ফিরে এসো,","poem":1},{"text":"কারণ তিনি অনুগ্রহকারী ও সহানুভূতিশীল,","poem":2},{"text":"বিলম্বে ক্রোধ করেন ও সীমাহীন তাঁর ভালোবাসা।","poem":1},{"text":"তিনি বিপর্যয় প্রেরণ করে দয়ার্দ্র হন।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"কে জানে? তিনি ফিরে আবার করুণা করবেন","poem":1},{"text":"এবং পিছনে আশীর্বাদ রেখে যাবেন—","poem":2},{"text":"ভক্ষ্য-নৈবেদ্য ও পেয়-নৈবেদ্য,","poem":1},{"text":"তোমাদের ঈশ্বর সদাপ্রভুর জন্য।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"তোমরা সিয়োনে তূরী বাজাও,","poem":1},{"text":"পবিত্র উপবাস-পর্ব ঘোষণা করো,","poem":2},{"lineBreak":true},{"text":"এক পবিত্র সভার করো আহ্বান।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"লোকেদের সমবেত করো,","poem":1},{"text":"জনসমাজকে পবিত্র করো;","poem":2},{"text":"প্রবীণদের এক স্থানে নিয়ে এসো,","poem":1},{"text":"স্তন্যপায়ী শিশুদেরও এক স্থানে সমবেত করো।","poem":2},{"text":"বর তার বাসগৃহ ও কনে তার নিবাস-কক্ষ","poem":1},{"text":"ত্যাগ করুক।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"সদাপ্রভুর সাক্ষাতে পরিচর্যাকারী যাজকেরা,","poem":1},{"text":"মন্দিরের বারান্দা ও বেদির মাঝখানে ক্রন্দন করুক।","poem":2},{"text":"তারা বলুক, “হে সদাপ্রভু, তোমার প্রজাদের নিষ্কৃতি দাও।","poem":1},{"text":"তোমার অধিকারকে নিন্দার পাত্র হতে","poem":2},{"lineBreak":true},{"text":"ও জাতিসমূহের মধ্যে প্রবাদের আস্পদ হতে দিয়ো না।","poem":2},{"text":"তারা কেন জাতিবৃন্দের কাছে বলবে,","poem":1},{"text":"‘তোমার ঈশ্বর কোথায়?’ ”","poem":2}]},{"type":"heading","content":["সদাপ্রভুর উত্তর"]},{"type":"verse","number":18,"content":[{"text":"তারপরে সদাপ্রভু তাঁর দেশের বিষয়ে উদ্যোগী হলেন","poem":1},{"text":"এবং তাঁর প্রজাদের প্রতি দয়া করলেন।","poem":2}]},{"type":"verse","number":19,"content":["সদাপ্রভু তাদের প্রত্যুত্তর করবেন:",{"text":"“আমি তোমাদের কাছে শস্য, নতুন দ্রাক্ষারস ও তেল প্রেরণ করতে চলেছি,","poem":2},{"lineBreak":true},{"text":"যা তোমাদের পরিতৃপ্ত করার জন্য পর্যাপ্ত হবে;","poem":2},{"text":"আমি আর কখনও তোমাদের","poem":1},{"text":"অন্যান্য জাতির কাছে নিন্দার পাত্র করব না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“উত্তরের সৈন্যদলকে আমি তোমাদের কাছ থেকে তাড়িয়ে দেব,","poem":1},{"text":"তাদের এক শুকনো ও অনুর্বর দেশে নিক্ষেপ করব,","poem":2},{"text":"পূর্ব সমুদ্রের","poem":1},{"noteId":0},{"text":"দিকে তার সামনের ভাগ","poem":1},{"text":"ও পশ্চিম সমুদ্রের","poem":2},{"noteId":1},{"text":"দিকে তার পেছনের ভাগ নিক্ষেপ করব।","poem":2},{"text":"তার দুর্গন্ধ উপরে উঠে যাবে,","poem":1},{"text":"তার পূতিগন্ধ উঠতে থাকবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ওহে দেশ, ভয় কোরো না;","poem":1},{"text":"আনন্দিত হও ও উল্লাস করো।","poem":2},{"text":"সদাপ্রভু নিশ্চয়ই মহৎ সব কাজ করেছেন।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ওহে বুনো পশুরা, তোমরা ভয় কোরো না,","poem":1},{"text":"কারণ খোলা চারণভূমিগুলি সবুজ হয়ে উঠছে।","poem":2},{"text":"গাছগুলি তাদের ফল উৎপন্ন করছে,","poem":1},{"text":"ডুমুর গাছ ও দ্রাক্ষালতা তাদের ফলভারে সমৃদ্ধ হচ্ছে।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ওহে সিয়োনের অধিবাসীরা, তোমরা আনন্দিত হও,","poem":1},{"text":"আমাদের ঈশ্বর সদাপ্রভুতে আনন্দিত হও,","poem":2},{"text":"কারণ তিনি তাঁর ধর্মশীলতায়","poem":1},{"text":"তোমাদের অগ্রিম বৃষ্টি দান করবেন।","poem":2},{"text":"তিনি তোমাদের কাছে প্রচুর বৃষ্টি প্রেরণ করবেন,","poem":1},{"text":"পূর্বের মতোই প্রথম ও শেষ বর্ষা প্রেরণ করবেন।","poem":2}]},{"type":"verse","number":24,"content":[{"text":"খামারগুলি শস্যে পরিপূর্ণ হবে;","poem":1},{"text":"ভাঁটিগুলি নতুন দ্রাক্ষারসে ও তেলে উপচে পড়বে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“বছর বছর ধরে পঙ্গপালে যা খেয়েছে, তা আমি ফিরিয়ে দেব—","poem":1},{"text":"অর্থাৎ বড়ো পঙ্গপাল, ও অল্পবয়স্ক পঙ্গপাল,","poem":2},{"lineBreak":true},{"text":"অন্যান্য পঙ্গপাল ও পঙ্গপালের ঝাঁক","poem":2},{"noteId":2},{"text":"—","poem":2},{"text":"আমার মহা সৈন্যদল, যাদের আমি প্রেরণ করেছিলাম।","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"যতক্ষণ না তোমরা তৃপ্ত হবে, তোমরা পর্যাপ্ত পরিমাণে আহার করবে,","poem":1},{"text":"আর তোমরা তোমাদের ঈশ্বর সদাপ্রভুর প্রশংসা করবে,","poem":2},{"lineBreak":true},{"text":"যিনি তোমাদের জন্য বিস্ময়কর সব কর্ম করেছেন;","poem":2},{"text":"আমার প্রজারা আর কখনও লজ্জিত হবে না।","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"তখন তোমরা জানতে পারবে যে আমি ইস্রায়েলের মধ্যবর্তী আছি,","poem":1},{"text":"যে আমিই সদাপ্রভু, তোমাদের ঈশ্বর,","poem":2},{"lineBreak":true},{"text":"আর কোনো ঈশ্বর নেই;","poem":2},{"text":"আমার প্রজারা আর কখনও লজ্জিত হবে না।","poem":1}]},{"type":"heading","content":["সদাপ্রভুর দিন"]},{"type":"verse","number":28,"content":[{"text":"“আর তারপর,","poem":1},{"text":"আমি সমস্ত মানুষের উপরে আমার আত্মা ঢেলে দেব।","poem":2},{"text":"তোমাদের ছেলে ও মেয়েরা ভাববাণী বলবে,","poem":1},{"text":"তোমাদের প্রবীণেরা স্বপ্ন দেখবে,","poem":2},{"lineBreak":true},{"text":"তোমাদের যুবকেরা দর্শন পাবে।","poem":2}]},{"type":"verse","number":29,"content":[{"text":"এমনকি, আমার দাস-দাসীদেরও উপরে,","poem":1},{"text":"সেইসব দিনে আমি আমার আত্মা ঢেলে দেব।","poem":2}]},{"type":"verse","number":30,"content":[{"text":"আমি আকাশমণ্ডলে ও পৃথিবীর উপরে","poem":1},{"text":"আশ্চর্য সব নিদর্শন দেখাব,","poem":2},{"lineBreak":true},{"text":"রক্ত ও আগুন এবং ধোঁয়ার কুণ্ডলী দেখাব।","poem":2}]},{"type":"verse","number":31,"content":[{"text":"সদাপ্রভুর সেই মহৎ ও ভয়ংকর দিনের আগমনের পূর্বে,","poem":1},{"text":"সূর্য অন্ধকার ও চাঁদ রক্তবর্ণ হয়ে যাবে।","poem":2}]},{"type":"verse","number":32,"content":[{"text":"আর যে কেউ সদাপ্রভুর নামে ডাকবে,","poem":1},{"text":"সেই পরিত্রাণ পাবে;","poem":2},{"text":"কারণ সদাপ্রভুর কথামতো সিয়োন পর্বত ও জেরুশালেমে,","poem":1},{"text":"কিছু মুক্তিপ্রাপ্ত লোকের দল থাকবে;","poem":2},{"text":"আর অবশিষ্ট লোকেদের মধ্যেও থাকবে,","poem":1},{"text":"যাদের সদাপ্রভু আহ্বান করেছেন।”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"অর্থাৎ মরুসাগর।","reference":{"chapter":2,"verse":20}},{"noteId":1,"caller":"+","text":"অর্থাৎ ভূমধ্যসাগর।","reference":{"chapter":2,"verse":20}},{"noteId":2,"caller":"+","text":"এই পদ উল্লিখিত পতঙ্গগুলির হিব্রু প্রতিশব্দগুলির অর্থ অনিশ্চিত।","reference":{"chapter":2,"verse":25}}]},"thisChapterLink":"/api/ben_ocv/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}