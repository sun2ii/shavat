{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"JON","translationId":"ben_ocv","name":"যোনা","commonName":"যোনা","title":"যোনা","order":32,"numberOfChapters":4,"sha256":"63adfb93e0b11caafec933fca1b83bc1a9bc2257faefe0f442ade66afe43b813","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/ben_ocv/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["সেই মাছের পেটের মধ্যে থেকে যোনা, তার ঈশ্বর সদাপ্রভুর কাছে এই প্রার্থনা করলেন।"]},{"type":"verse","number":2,"content":["তিনি বললেন:",{"text":"“আমার দুর্দশার সময়ে আমি সদাপ্রভুকে ডাকলাম,","poem":1},{"text":"আর তিনি আমাকে উত্তর দিলেন।","poem":2},{"text":"পাতালের গভীরতম স্থান থেকে আমি সাহায্য চাইলাম,","poem":1},{"text":"আর তুমি আমার কান্না শুনলে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তুমি আমাকে গভীর জলে,","poem":1},{"text":"সমুদ্রের গর্ভে নিক্ষেপ করলে,","poem":2},{"lineBreak":true},{"text":"আর প্রকাণ্ড জলস্রোত আমাকে ঘিরে ধরল;","poem":2},{"text":"তোমার সকল ঢেউ, তোমার সমস্ত তরঙ্গ,","poem":1},{"text":"আমাকে বয়ে নিয়ে গেল।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"আমি বললাম, ‘আমাকে তোমার দৃষ্টি থেকে","poem":1},{"text":"দূর করা হয়েছে;","poem":2},{"text":"তবুও আমি আবার","poem":1},{"text":"তোমার পবিত্র মন্দিরের দিকে তাকাব।’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"আমার চারপাশের জলরাশি আমাকে ভীত করল,","poem":1},{"text":"অগাধ জলরাশি আমাকে ঘিরে ধরল;","poem":2},{"lineBreak":true},{"text":"সাগরের আগাছা আমার মাথায় জড়িয়ে গেল।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"আমি সমুদ্রে পর্বতসমূহের তলদেশ পর্যন্ত ডুবে গেলাম;","poem":1},{"text":"নিচের পৃথিবী চিরতরে আমাকে বন্দি করল।","poem":2},{"text":"কিন্তু হে সদাপ্রভু, আমার ঈশ্বর,","poem":1},{"text":"তুমি গভীর গর্ত থেকে আমার প্রাণকে তুলে ধরলে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“আমার প্রাণ যখন আমার মধ্যে ক্ষীণ হচ্ছিল,","poem":1},{"text":"সদাপ্রভু, আমি তোমাকে স্মরণ করলাম,","poem":2},{"text":"আর আমার প্রার্থনা তোমার কাছে গেল","poem":1},{"text":"তোমার পবিত্র মন্দিরে উপস্থিত হল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“যারা অসার প্রতিমাদের প্রতি আসক্ত থাকে,","poem":1},{"text":"নিজেদের প্রতি ঈশ্বরের প্রেম তারা পরিত্যাগ করে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"কিন্তু আমি, ধন্যবাদের গান গেয়ে,","poem":1},{"text":"তোমার কাছে নৈবেদ্য উৎসর্গ করব।","poem":2},{"text":"আমি যা মানত করেছি, তা আমি পূর্ণ করব।","poem":1},{"text":"আমি বলব, পরিত্রাণ সদাপ্রভুর কাছ থেকেই আসে।”","poem":2}]},{"type":"verse","number":10,"content":["পরে সদাপ্রভু সেই মাছকে আদেশ দিলে, তা যোনাকে বমি করে শুকনো ভূমিতে ফেলে দিল।"]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}