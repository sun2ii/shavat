{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"LAM","translationId":"ben_ocv","name":"বিলাপ","commonName":"বিলাপ","title":"বিলাপ","order":25,"numberOfChapters":5,"sha256":"5e4868a5f8adcbbc52740802b5064b4f6d0c58609be70318fb2fd173be70a9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/ben_ocv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"হায়! যে নগরী একদিন ছিল মানুষজনে পরিপূর্ণ,","poem":1},{"text":"সে আজ পরিত্যক্ত হয়ে পড়ে আছে!","poem":2},{"text":"যে ছিল একদিন জাতিসমূহের মধ্যে মহান,","poem":1},{"text":"তার দশা আজ বিধবার মতো!","poem":2},{"text":"একদিন যে ছিল প্রদেশগুলির রানি,","poem":1},{"text":"সে আজ পরিণত হয়েছে ক্রীতদাসীতে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"রাত্রিবেলা সে তীব্র রোদন করে,","poem":1},{"text":"তার দুই গাল বেয়ে অশ্রু বয়ে যায়।","poem":2},{"text":"তার সব প্রেমিকের মধ্যে,","poem":1},{"text":"তাকে সান্ত্বনা দেওয়ার মতো কেউই নেই।","poem":2},{"text":"তার সব বন্ধু তার সঙ্গে বিশ্বাসঘাতকতা করেছে;","poem":1},{"text":"তারা আজ সবাই তার শত্রু হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"যন্ত্রণাভোগ ও কঠোর পরিশ্রমের পর,","poem":1},{"text":"যিহূদা নির্বাসিত হয়েছে।","poem":2},{"text":"সে জাতিসমূহের মধ্যে বাস করে;","poem":1},{"text":"সে কোনো বিশ্রামের স্থান খুঁজে পায় না।","poem":2},{"text":"যারা তাকে তাড়া করছিল,","poem":1},{"text":"তার বিপর্যয়ের মাঝে তারা তাকে ধরে ফেলেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"সিয়োনগামী পথগুলি শোকে ম্রিয়মাণ,","poem":1},{"text":"কারণ নির্ধারিত উৎসবগুলিতে আর কেউ আসে না।","poem":2},{"text":"তার সবকটি তোরণদ্বারের প্রবেশপথ নির্জন,","poem":1},{"text":"তার যাজকেরা আর্তনাদ করে।","poem":2},{"text":"তার কুমারী-কন্যারা শোকার্ত,","poem":1},{"text":"এবং সে নিজে তিক্ত মনোবেদনায় আচ্ছন্ন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তার প্রতিপক্ষরা তার মনিব হয়েছে;","poem":1},{"text":"তার শত্রুরা আজ নিশ্চিন্ত।","poem":2},{"text":"তার অনেক অনেক পাপের জন্য","poem":1},{"text":"সদাপ্রভু তাকে ক্লিষ্ট করেছেন।","poem":2},{"text":"তার ছেলেমেয়েরা নির্বাসনে গেছে,","poem":1},{"text":"শত্রুদের চোখের সামনে তারা বন্দি হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"সিয়োন-কন্যার মধ্য থেকে","poem":1},{"text":"সমস্ত জৌলুস অন্তর্হিত হয়েছে।","poem":2},{"text":"তার রাজপুরুষেরা এমন সব হরিণ হয়েছেন,","poem":1},{"text":"যারা কোনো চারণভূমির সন্ধান পায় না।","poem":2},{"lineBreak":true},{"text":"তারা শক্তিহীন হয়ে বিতাড়কদের আগে আগে পলায়ন করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"তার ক্লেশ ও অস্থির বিচরণের দিনগুলিতে,","poem":1},{"text":"জেরুশালেম তার সব ঐশ্বর্যের কথা স্মরণ করে যা পুরোনো দিনে তার ছিল।","poem":2},{"text":"যখন তার লোকেরা শত্রুদের হাতে ধরা পড়ল,","poem":1},{"text":"তখন তাকে সাহায্য করার জন্য কেউই ছিল না।","poem":2},{"text":"তার শত্রুরা তার দিকে তাকিয়েছিল","poem":1},{"text":"এবং তার বিনাশের জন্য ব্যঙ্গবিদ্রুপ করেছিল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"জেরুশালেম প্রচুর পাপ করেছে,","poem":1},{"text":"এবং তাই সে অশুচি হয়েছে।","poem":2},{"text":"যারা তাকে সম্মান করত, তারা তাকে অবজ্ঞা করছে,","poem":1},{"text":"কারণ তারা সবাই তাকে উলঙ্গ দেখেছে;","poem":2},{"text":"সে নিজেও আর্তনাদ করে","poem":1},{"text":"ও উল্টোদিকে মুখ ফিরায়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"তার জঘন্যতা তার বসনপ্রান্তে লেগে আছে;","poem":1},{"text":"সে তার ভবিষ্যতের কথা ভাবেনি।","poem":2},{"text":"তার পতন ছিল হতবুদ্ধিকর,","poem":1},{"text":"তাকে সান্ত্বনা দেওয়ার জন্য কেউই ছিল না।","poem":2},{"text":"“হে সদাপ্রভু, আমার দুঃখ দেখো,","poem":1},{"text":"কারণ শত্রু বিজয়ী হয়েছে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তার সমস্ত ধনসম্পদের উপরে","poem":1},{"text":"শত্রু হাত দিয়েছে;","poem":2},{"text":"সে দেখেছে, পৌত্তলিক জাতিগুলি","poem":1},{"text":"তার ধর্মধামে প্রবেশ করেছে—","poem":2},{"text":"তোমার সমাজে প্রবেশ করতে যাদের তুমি নিষেধ করেছিলে।","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"তার সব লোকজন খাদ্যের খোঁজে","poem":1},{"text":"আর্তনাদ করে;","poem":2},{"text":"নিজেদের বাঁচিয়ে রাখার জন্য","poem":1},{"text":"তারা তাদের সম্পদ বিনিময় করেছে।","poem":2},{"text":"“হে সদাপ্রভু, দেখো ও বিবেচনা করো,","poem":1},{"text":"কেননা আমি অবজ্ঞাত হয়েছি।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ওহে পথিকেরা, এতে কি তোমাদের কিছু এসে যায় না?","poem":1},{"text":"চারপাশে তাকিয়ে দেখো,","poem":2},{"text":"আমাকে যে ধরনের যন্ত্রণা দেওয়া হয়েছে,","poem":1},{"text":"তার মতো যন্ত্রণা আর কি কোথাও আছে,","poem":2},{"text":"যা সদাপ্রভু তাঁর প্রচণ্ড ক্রোধের দিনে","poem":1},{"text":"আমার উপরে নিয়ে এসেছেন?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ঊর্ধ্ব থেকে তিনি অগ্নিপ্রদাহ প্রেরণ করেছেন,","poem":1},{"text":"তিনি তা প্রেরণ করেছেন আমার হাড়গুলির মধ্যে।","poem":2},{"text":"আমার পা দুটির জন্য তিনি জাল পেতেছেন","poem":1},{"text":"এবং আমাকে পিছন-পানে ঘুরিয়ে দিয়েছেন,","poem":2},{"text":"তিনি আমাকে জনশূন্য করেছেন,","poem":1},{"text":"যে সমস্ত দিন মূর্ছিত হয়ে পড়ে থাকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“আমার পাপগুলিকে একটি জোয়ালে বাঁধা হয়েছে;","poem":1},{"text":"তাঁর দুটি হাত সেগুলি একত্র বুনেছে।","poem":2},{"text":"সেগুলি আমার ঘাড় থেকে ঝুলছে,","poem":1},{"text":"এবং প্রভু আমার জীবনীশক্তি নিঃশেষ করেছেন।","poem":2},{"text":"যাদের আমি সহ্য করতে পারি না,","poem":1},{"text":"তাদের হাতেই তিনি আমাকে সমর্পণ করেছেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“আমার মধ্যে যেসব যোদ্ধা ছিল,","poem":1},{"text":"প্রভু তাদের অগ্রাহ্য করেছেন;","poem":2},{"text":"তিনি আমার বিরুদ্ধে এক সৈন্যদল তলব করেছেন,","poem":1},{"text":"যেন আমার যুবকদের চূর্ণ করেন।","poem":2},{"text":"প্রভু তাঁর আঙুর মাড়াই-কল,","poem":1},{"text":"কুমারী-কন্যা যিহূদাকে মর্দন করেছেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“এই কারণে আমি ক্রন্দন করি,","poem":1},{"text":"এবং আমার চোখদুটি অশ্রুপ্লাবিত হয়।","poem":2},{"text":"আমাকে সান্ত্বনা দেওয়ার জন্য কাছে কেউই নেই,","poem":1},{"text":"কেউ আমার প্রাণ সঞ্জীবিত করে না।","poem":2},{"text":"আমার ছেলেমেয়েরা আজ সহায়সম্বলহীন,","poem":1},{"text":"কারণ শত্রুরা বিজয়ী হয়েছে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"সিয়োন তার দু-হাত প্রসারিত করেছে,","poem":1},{"text":"কিন্তু তাকে সান্ত্বনা দেওয়ার কেউ নেই।","poem":2},{"text":"সদাপ্রভু যাকোব কুলের বিরুদ্ধে রায় ঘোষণা করেছেন যে,","poem":1},{"text":"তার প্রতিবেশীরাই তার শত্রু হবে;","poem":2},{"text":"তাদের মধ্যে জেরুশালেম","poem":1},{"text":"এক অশুচি বস্তুতে পরিণত হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“সদাপ্রভু ধর্মময়,","poem":1},{"text":"তা সত্ত্বেও আমি তাঁর আজ্ঞার বিদ্রোহী হয়েছি।","poem":2},{"text":"সমস্ত জাতিগণ, তোমরা শোনো;","poem":1},{"text":"আমার কষ্টভোগের প্রতি দৃষ্টি দাও।","poem":2},{"text":"আমার যুবকেরা ও কুমারী-কন্যারা","poem":1},{"text":"নির্বাসনে চলে গেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“আমি আমার মিত্রবাহিনীকে ডেকেছিলাম,","poem":1},{"text":"কিন্তু তারা আমার সঙ্গে বিশ্বাসঘাতকতা করেছে।","poem":2},{"text":"আমার যাজকেরা ও প্রাচীনবর্গ","poem":1},{"text":"নিজেদের বাঁচিয়ে রাখার জন্য,","poem":2},{"text":"যখন খাদ্যদ্রব্যের অন্বেষণ করেছে,","poem":1},{"text":"তখন তারা নগরের মধ্যে বিনষ্ট হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“হে সদাপ্রভু, দেখো, আমি কতটা যাতনাগ্রস্ত!","poem":1},{"text":"আমার অন্তরে মর্মবেদনা প্রবল,","poem":2},{"text":"এবং অন্তরে আমি দুশ্চিন্তাগ্রস্ত,","poem":1},{"text":"কারণ আমি প্রচণ্ড বিদ্রোহী ছিলাম।","poem":2},{"text":"বাইরে, তরোয়াল শোকাহত করছে,","poem":1},{"text":"ভিতরে, কেবলই মৃত্যু।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“লোকেরা আমার আর্তনাদ শুনেছে,","poem":1},{"text":"কিন্তু আমাকে সান্ত্বনা দেওয়ার কেউই নেই।","poem":2},{"text":"আমার প্রতিটি শত্রু আমার দুর্দশার কথা শুনেছে;","poem":1},{"text":"তুমি যা করেছ, তার জন্য তারা উল্লসিত।","poem":2},{"text":"তোমার ঘোষিত সেদিনকে তুমি নিয়ে এসো,","poem":1},{"text":"যাতে তাদের অবস্থাও যেন আমারই মতো হয়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“তাদের সমস্ত দুষ্টতা তোমার দৃষ্টিগোচর হোক;","poem":1},{"text":"তুমি তাদের সঙ্গে তেমনই আচরণ করো","poem":2},{"text":"যেমনটি আমার কৃত সব পাপের জন্য","poem":1},{"text":"তুমি আমার সঙ্গে করেছ।","poem":2},{"text":"আমার দীর্ঘশ্বাস অসংখ্য","poem":1},{"text":"এবং আমার হৃদয় মূর্ছিত।”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}