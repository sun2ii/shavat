{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"LAM","translationId":"ben_ocv","name":"বিলাপ","commonName":"বিলাপ","title":"বিলাপ","order":25,"numberOfChapters":5,"sha256":"5e4868a5f8adcbbc52740802b5064b4f6d0c58609be70318fb2fd173be70a9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/ben_ocv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"হায়! সোনা কেমন তার উজ্জ্বলতা হারিয়েছে,","poem":1},{"text":"উজ্জ্বল সোনা মলিন হয়েছে!","poem":2},{"text":"পবিত্র মণিরত্নগুলি ছত্রাকার হয়ে","poem":1},{"text":"প্রতি পথের মোড়ে পড়ে আছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"বহুমূল্য সিয়োন-সন্তানেরা,","poem":1},{"text":"যারা একদিন সোনার মতো গুরুত্বপূর্ণ ছিল,","poem":2},{"text":"এখন তাদের অবস্থা মাটির পাত্রের মতো,","poem":1},{"text":"যা কুমোরের হাতে নির্মিত!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"এমনকি শিয়ালেরাও তাদের শাবকদের","poem":1},{"text":"প্রতিপালনের জন্য স্তন্যপান করায়,","poem":2},{"text":"কিন্তু আমার প্রজারা মরুভূমির উটপাখির","poem":1},{"text":"মতো হৃদয়হীন হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"পিপাসিত হওয়ার কারণে কোলের শিশুদের","poem":1},{"text":"জিভ মুখের তালুতে আটকে যায়;","poem":2},{"text":"শিশুরা রুটি ভিক্ষা চায়,","poem":1},{"text":"কিন্তু কেউই তাদের তা দেয় না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"একদিন যারা উৎকৃষ্ট আহার্য গ্রহণ করত","poem":1},{"text":"আজ তারা পথে পথে অসহায় হয়ে পড়ে আছে।","poem":2},{"text":"যারা রাজকীয় বেগুনিয়া পোশাক পরে প্রতিপালিত হয়েছে,","poem":1},{"text":"তারা এখন ভস্মস্তূপে শুয়ে আছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আমার প্রজাদের শাস্তি","poem":1},{"text":"সদোমের লোকদের চেয়েও বেশি,","poem":2},{"text":"যারা মুহূর্তমধ্যে উৎপাটিত হয়েছিল,","poem":1},{"text":"একটি সাহায্যকারী হাতও তারা পায়নি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"তাদের অমাত্যরা ছিল তুষারের চেয়েও উজ্জ্বল","poem":1},{"text":"এবং দুধের চেয়েও শুভ্র,","poem":2},{"text":"তাদের অঙ্গ ছিল প্রবালের চেয়েও লাল,","poem":1},{"text":"তাদের কান্তি ছিল নীলকান্তমণির মতো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কিন্তু এখন তারা হয়েছে ভুষোকালির চেয়েও কালো;","poem":1},{"text":"পথে পথে তাদের চেনা যায় না।","poem":2},{"text":"তাদের চামড়া কুঁচকে হাড়ের সঙ্গে লেগে রয়েছে,","poem":1},{"text":"তা কাঠির মতোই শুকনো হয়ে গেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"যারা তরোয়ালের আঘাতে নিহত হয় তারা বরং","poem":1},{"text":"দুর্ভিক্ষের কারণে মৃতদের চেয়ে ভালো;","poem":2},{"text":"মাঠ থেকে কোনো শস্য না পেয়ে,","poem":1},{"text":"তারা ক্ষুধার জ্বালায় ক্ষয় পেয়ে উৎখাত হচ্ছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"স্নেহশীলা নারীরা তাদের নিজেদের হাতে,","poem":1},{"text":"তাদেরই ছেলেমেয়েদের রান্না করেছে,","poem":2},{"text":"তারা তখন তাদের খাদ্যে পরিণত হয়েছে,","poem":1},{"text":"যখন আমার প্রজারা ধ্বংস হয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"সদাপ্রভু তাঁর ক্রোধ পূর্ণরূপে সম্পন্ন করেছেন;","poem":1},{"text":"তিনি তাঁর ভয়ংকর ক্রোধ ঢেলে দিয়েছেন।","poem":2},{"text":"তিনি সিয়োনে এক আগুন প্রজ্বলিত করেছেন,","poem":1},{"text":"যা গ্রাস করেছে তার সমস্ত ভিত্তিমূলকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"পৃথিবীর রাজারা বা জগতের কোনো","poem":1},{"text":"লোকও বিশ্বাস করেনি যে,","poem":2},{"text":"বিপক্ষেরা ও শত্রুরা","poem":1},{"text":"জেরুশালেমের তোরণদ্বারগুলি দিয়ে প্রবেশ করতে পারবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"কিন্তু তার ভাববাদীদের পাপের জন্য এইরকম ঘটেছে,","poem":1},{"text":"এবং তার যাজকদের শঠতার জন্য,","poem":2},{"text":"যারা তারই মধ্যে বসে","poem":1},{"text":"ধার্মিক লোকদের রক্তপাত করেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"এখন তারা অন্ধ লোকদের মতো","poem":1},{"text":"পথে পথে হাতড়ে বেড়ায়।","poem":2},{"text":"রক্তে তারা এমনভাবে কলুষিত যে,","poem":1},{"text":"কেউই তাদের পোশাক ছুঁতে চায় না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"লোকেরা চিৎকার করে তাদের বলে, “দূর হও! তোমরা অশুচি!","poem":1},{"text":"দূর হও! দূর হও! আমাদের স্পর্শ কোরো না!”","poem":2},{"text":"যখন তারা পালিয়ে এবং ঘুরে বেড়ায়,","poem":1},{"text":"তখন অন্যান্য জাতির লোকেরা বলে,","poem":2},{"lineBreak":true},{"text":"“ওরা এখানে কখনও থাকতে পারবে না।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"সদাপ্রভু স্বয়ং তাদের ছিন্নভিন্ন করেছেন;","poem":1},{"text":"তিনি আর তাদের দেখেন না।","poem":2},{"text":"যাজকদের কেউ আর সম্মান করে না,","poem":1},{"text":"প্রাচীনদের কেউ আর কৃপা করে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"এছাড়া, মিথ্যা সাহায্যের প্রত্যাশায়","poem":1},{"text":"আমাদের দৃষ্টি ক্ষীণ হয়েছে;","poem":2},{"text":"আমাদের উচ্চগৃহগুলি থেকে এক জাতির দিকে তাকিয়েছিলাম,","poem":1},{"text":"কিন্তু তারা আমাদের রক্ষা করতে পারেনি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"লোকেরা চুপিসাড়ে আমাদের প্রতিটি পদক্ষেপ অনুসরণ করে,","poem":1},{"text":"তাই আমরা পথে হাঁটতে পারি না।","poem":2},{"text":"আমাদের শেষকাল নিকটবর্তী, আমাদের আয়ু সম্পূর্ণ,","poem":1},{"text":"কেননা আমাদের শেষকাল উপস্থিত।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"আকাশের ঈগল পাখিদের চেয়েও","poem":1},{"text":"আমাদের পশ্চাদ্ধাবনকারীরা দ্রুতগতিসম্পন্ন ছিল;","poem":2},{"text":"তারা পর্বতগুলির উপরেও আমাদের তাড়া করে গেছে,","poem":1},{"text":"আর মরুভূমিতে আমাদের জন্য ওৎ পেতে থেকেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"যিনি সদাপ্রভুর অভিষিক্ত, আমাদের জাতির প্রাণস্বরূপ,","poem":1},{"text":"তিনি তাদের ফাঁদে ধরা পড়েছিলেন।","poem":2},{"text":"আমরা ভেবেছিলাম যে তাঁরই ছায়ায়","poem":1},{"text":"আমরা জাতিগুলির মধ্যে জীবনযাপন করব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ঊষ দেশে বসবাসকারী, ইদোম-কন্যা,","poem":1},{"text":"আনন্দ করো ও উল্লসিত হও।","poem":2},{"text":"কিন্তু তোমার কাছেও সেই পানপাত্র আসবে;","poem":1},{"text":"তুমিও মত্ত হবে ও নগ্ন হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"সিয়োন-কন্যা, তোমার শাস্তির দিন শেষ হবে;","poem":1},{"text":"তোমার নির্বাসনের দিন তিনি আর বিলম্বিত করবেন না।","poem":2},{"text":"কিন্তু ইদোম-কন্যা, তোমার পাপের শাস্তি তিনি দেবেন","poem":1},{"text":"ও তোমার সমস্ত দুষ্টতা অনাবৃত করবেন।","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}