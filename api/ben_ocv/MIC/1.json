{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"MIC","translationId":"ben_ocv","name":"মীখা","commonName":"মীখা","title":"মীখা","order":33,"numberOfChapters":7,"sha256":"7646ed2f2c9216f93b999f698e1eb795ea2172b76c00b9b4d09dbdd1a674d10d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ben_ocv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["যিহূদার রাজগণ যোথম, আহস এবং হিষ্কিয়ের শাসনকালে সদাপ্রভুর বাক্য মোরেষৎ-নিবাসী মীখার কাছে আসে—তিনি শমরিয়া এবং জেরুশালেমের উদ্দেশে এক দর্শন পান।"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"শোনো, হে জাতিগণ, তোমরা সকলে,","poem":1},{"text":"হে পৃথিবী ও যারা সেখানে বাস করে, শোনো,","poem":2},{"text":"সদাপ্রভু তাঁর পবিত্র মন্দির থেকে,","poem":1},{"text":"সার্বভৌম সদাপ্রভু তোমাদের বিরুদ্ধে সাক্ষ্য দেন।","poem":2}]},{"type":"heading","content":["শমরিয় ও জেরুশালেমের বিরুদ্ধে বিচার"]},{"type":"verse","number":3,"content":[{"text":"দেখো! সদাপ্রভু নিজ বাসস্থান থেকে আসছেন;","poem":1},{"text":"তিনি নেমে এসে পৃথিবীর সব উচ্চস্থানের উপর দিয়ে গমনাগমন করবেন।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যেমন মোম আগুনের সংস্পর্শে গলে যায়,","poem":1},{"text":"পাহাড়গুলি তাঁর নিচে গলে যায়","poem":2},{"text":"এবং উপত্যকায় ফাটল ধরে,","poem":1},{"text":"ঢালু জায়গায় জল গড়িয়ে পড়ে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"এইসবই যাকোবের অপরাধের জন্য","poem":1},{"text":"এবং ইস্রায়েলের পরিবারের পাপের কারণেই ঘটেছে।","poem":2},{"text":"যাকোবের অপরাধ কি?","poem":1},{"text":"কি সেইসব শমরিয়ার নয়?","poem":2},{"text":"যিহূদার উঁচু স্থান কি?","poem":1},{"text":"সেইসব কি জেরুশালেমের নয়?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“সুতরাং আমি সদাপ্রভু শমরিয়াকে পাথরের স্তূপ,","poem":1},{"text":"দ্রাক্ষালতা রোপণের ক্ষেত্রে পরিবর্তিত করব।","poem":2},{"text":"সেখানকার পাথরগুলি উপত্যকায় বইয়ে দেব","poem":1},{"text":"এবং তার ভিত্তিমূল খোলা রাখব।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তার সব প্রতিমাগুলি টুকরো টুকরো করে ভেঙে ফেলা হবে;","poem":1},{"text":"তার সকল মন্দিরের উপহার আগুনে পোড়ানো হবে;","poem":2},{"lineBreak":true},{"text":"আমি তার সমস্ত প্রতিমাগুলি ধ্বংস করব।","poem":2},{"text":"কারণ বেশ্যাবৃত্তির মজুরির থেকে সে তার উপহার সঞ্চয় করেছে,","poem":1},{"text":"বেশ্যাবৃত্তির মজুরির মতোই সেইগুলি ব্যবহার করা হবে।”","poem":2}]},{"type":"heading","content":["কান্না এবং শোক"]},{"type":"verse","number":8,"content":[{"text":"এই কারণেই আমি কাঁদব আর বিলাপ করব;","poem":1},{"text":"আমি উলঙ্গ হয়ে খালি পায়ে ঘুরে বেড়াব।","poem":2},{"text":"আমি শিয়ালের মতো চিৎকার করব","poem":1},{"text":"এবং প্যাঁচার মতো বিলাপ করব।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"কেননা শমরিয়ার ক্ষত আর ভালো হবে না;","poem":1},{"text":"তা যিহূদার কাছে এসে গেছে।","poem":2},{"text":"তা আমার লোকদের পর্যন্ত পৌঁছেছে,","poem":1},{"text":"এমনকি জেরুশালেম পর্যন্ত।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"গাতে এই কথা জানিও না,","poem":1},{"text":"একটুও কান্নাকাটি করো না।","poem":2},{"text":"বেথ-লি-অফ্রাতে","poem":1},{"text":"ধুলোয় গড়াগড়ি দাও।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"হে শাফীরের বাসকারী লোকেরা,","poem":1},{"text":"তোমরা উলঙ্গ ও লজ্জিত হয়ে চলে যাও।","poem":2},{"text":"যারা সাননে বাস করে","poem":1},{"text":"তারা বের হয়ে আসতে পারবে না।","poem":2},{"text":"বেথ-এৎসল শোক করছে;","poem":1},{"text":"সে আর তোমাদের পক্ষে দাঁড়াবে না।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"যারা মারোতে বাস করে তারা ব্যাকুল হয়ে,","poem":1},{"text":"রেহাই পাবার জন্য অপেক্ষা করছে,","poem":2},{"text":"কারণ সদাপ্রভুর কাছে থেকে বিপদ এসে গেছে,","poem":1},{"text":"এমনকি জেরুশালেমের দ্বার পর্যন্ত পৌঁছেছে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তোমরা যারা লাখীশে বসবাস করো,","poem":1},{"text":"দ্রুতগামী ঘোড়াগুলি তোমরা রথের সঙ্গে বেঁধে দাও।","poem":2},{"text":"ইস্রায়েলের অন্যায় প্রথমে তোমাদের মধ্যে পাওয়া গিয়েছিল,","poem":1},{"text":"সেইজন্য সিয়োন-কন্যাকে তোমরাই পাপের পথে নিয়ে গিয়েছিলে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"সুতরাং মোরেষৎ-গাৎকে","poem":1},{"text":"নিজের বিদায়ের উপহার তুমি নিজেই দেবে।","poem":2},{"text":"ইস্রায়েলের রাজাদের জন্য","poem":1},{"text":"অক্‌ষীব নগর প্রতারক হবে।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তোমরা যারা মারেশায় বসবাস করো,","poem":1},{"text":"আমি তোমাদের বিরুদ্ধে এক দখলকারীকে নিয়ে আসব।","poem":2},{"text":"ইস্রায়েলের গণ্যমান্য লোকেরা","poem":1},{"text":"অদুল্লমে পালিয়ে যাবে।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"তোমাদের সন্তানদের যাদের তোমরা ভালোবাসো","poem":1},{"text":"তাদের শোকে ন্যাড়া হও;","poem":2},{"text":"নিজেকে শকুনের মতো ন্যাড়া করো,","poem":1},{"text":"কেননা তারা তোমাদের কাছ থেকে নির্বাসনে যাবে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}