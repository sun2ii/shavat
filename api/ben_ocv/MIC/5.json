{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"MIC","translationId":"ben_ocv","name":"মীখা","commonName":"মীখা","title":"মীখা","order":33,"numberOfChapters":7,"sha256":"7646ed2f2c9216f93b999f698e1eb795ea2172b76c00b9b4d09dbdd1a674d10d","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ben_ocv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["বেথলেহেম থেকে প্রতিজ্ঞাত শাসক"]},{"type":"verse","number":1,"content":[{"text":"ওহে সৈন্যদলের নগর, এখন তোমার সৈন্যদল নিয়ে যাও,","poem":1},{"text":"কারণ আমাদের বিরুদ্ধে অবরোধ হচ্ছে।","poem":2},{"text":"ইস্রায়েলের শাসনকর্তার গালে","poem":1},{"text":"লাঠি দিয়ে আঘাত করবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“কিন্তু তুমি, হে বেথলেহেম ইফ্রাথা,","poem":1},{"text":"যদিও তুমি যিহূদার শাসকদের মধ্যে ছোটো,","poem":2},{"text":"তোমার মধ্যে দিয়ে আমার জন্যে","poem":1},{"text":"ইস্রায়েলের এক শাসক বেরিয়ে আসবে,","poem":2},{"text":"যাঁর শুরু প্রাচীনকাল থেকে","poem":1},{"text":"অনাদিকাল থেকে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"সুতরাং ইস্রায়েল পরিত্যক্ত হবে","poem":1},{"text":"যতক্ষণ না প্রসবকারিণীর সন্তান হচ্ছে,","poem":2},{"text":"এবং অবশিষ্ট ভাইয়েরা ফিরে আসে","poem":1},{"text":"ইস্রায়েলীদের সঙ্গে যুক্ত হবার জন্য।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"তিনি দাঁড়িয়ে সদাপ্রভুর শক্তিতে","poem":1},{"text":"তাঁর ঈশ্বর সদাপ্রভুর নামের মহিমাতে,","poem":2},{"lineBreak":true},{"text":"রাখালের মতো তাঁর লোকদের চালাবেন।","poem":2},{"text":"এবং তারা নিরাপদে বাস করবে, কারণ তখন তাঁর মহত্ত্ব","poem":1},{"text":"পৃথিবীর শেষ সীমা পর্যন্ত পৌঁছাবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"আর তিনি আমাদের পক্ষে শান্তি হবেন","poem":1},{"text":"যখন আসিরীয়রা আমাদের দেশ আক্রমণ করবে","poem":2},{"lineBreak":true},{"text":"এবং আমাদের দুর্গগুলি পদদলিত করবে","poem":2},{"text":"তখন আমরা তাদের বিরুদ্ধে সাতজন মেষপালক,","poem":1},{"text":"এমনকি আটজন দলপতি নিযুক্ত করব।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"সেই সময় তারা আসিরিয়ার দেশ তরোয়াল দ্বারা,","poem":1},{"text":"নিম্রোদের দেশকে খোলা তরোয়াল দ্বারা শাসন করবে।","poem":2},{"text":"তারা যখন আমাদের দেশ আক্রমণ করবে","poem":1},{"text":"এবং আমাদের দেশের সীমানার মধ্যে দিয়ে যাবে","poem":2},{"lineBreak":true},{"text":"তিনি আমাদের আসিরীয়দের হাত থেকে রক্ষা করবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"অনেক জাতির মধ্যে","poem":1},{"text":"যাকোবের বেঁচে থাকা লোকেরা","poem":2},{"text":"সদাপ্রভুর কাছ থেকে আসা শিশিরের মতো হবে,","poem":1},{"text":"ঘাসের উপরে পড়া বৃষ্টির মতো,","poem":2},{"text":"যা মানুষের আদেশে পড়ে না","poem":1},{"text":"কিংবা তার উপর নির্ভর করে না।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"অনেক জাতির মধ্যে","poem":1},{"text":"যাকোবের বেঁচে থাকা লোকেরা হবে","poem":2},{"text":"জঙ্গলের বুনো পশুর মধ্যে সিংহের মতো,","poem":1},{"text":"মেষপালের মধ্যে যুবক সিংহের মতো,","poem":2},{"text":"সে যখন পালের মধ্যে দিয়ে যায় তখন তাদের টুকরো টুকরো করে ছিঁড়ে ফেলে,","poem":1},{"text":"কেউ তাদের উদ্ধার করতে পারে না।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তোমরা তোমাদের শত্রুদের উপর জয়লাভ করবে,","poem":1},{"text":"এবং তোমার সমস্ত শত্রু ধ্বংস হবে।","poem":2}]},{"type":"verse","number":10,"content":["“সেইদিন,” স