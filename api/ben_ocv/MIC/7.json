ntent":[{"text":"তাদের মধ্যে সব থেকে ভালো লোকেরা কাঁটাঝোপের মতো,","poem":1},{"text":"সবচেয়ে সৎলোকেরা কাঁটাগাছের বেড়ার চেয়েও খারাপ।","poem":2},{"text":"তোমার কাছে ঐশ্বরিক দণ্ডের দিন এসে গেছে,","poem":1},{"text":"যেদিন তোমার প্রহরীরা ঘোষণা করবে।","poem":2},{"lineBreak":true},{"text":"এখনই তোমাদের বিশৃঙ্খল হওয়ার সময়।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তোমাদের প্রতিবেশীদের বিশ্বাস করো না;","poem":1},{"text":"তোমাদের মিত্রদের উপরও নির্ভর করো না।","poem":2},{"text":"যে স্ত্রী তোমার বুকের মধ্যে শুয়ে থাকে","poem":1},{"text":"তার কাছে সাবধানতার সঙ্গে কথা বোলো।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"কারণ ছেলে তার নিজের বাবাকে অসম্মান করে,","poem":1},{"text":"মেয়ে নিজের মায়ের বিরুদ্ধে,","poem":2},{"text":"ছেলের বৌ নিজের শ্বাশুড়ীর বিরুদ্ধে উঠে","poem":1},{"text":"মানুষের নিজের পরিবারের লোকেরাই তার শত্রু।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"কিন্তু আমি সদাপ্রভুর উপর আশা রাখব,","poem":1},{"text":"আমি উদ্ধারকারী ঈশ্বরের জন্য অপেক্ষা করব;","poem":2},{"lineBreak":true},{"text":"আমার সদাপ্রভু আমার কথা শুনবেন।","poem":2}]},{"type":"heading","content":["ইস্রায়েলের উদ্ধার"]},{"type":"verse","number":8,"content":[{"text":"হে আমার শত্রু, আমাকে নিয়ে খুশি হোয়ো না!","poem":1},{"text":"আমি পড়ে গেলেও, আমি আবার উঠব।","poem":2},{"text":"যদি আমি অন্ধকারেও বসি,","poem":1},{"text":"সদাপ্রভু আমার জ্যোতি হবেন।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"যেহেতু আমি সদাপ্রভুর বিরুদ্ধে পাপ করেছি,","poem":1},{"text":"তাই আমি তাঁর ক্রোধ বহন করছি,","poem":2},{"text":"যতক্ষণ না তিনি আমাদের পক্ষে কথা বলেন","poem":1},{"text":"এবং আমার উদ্দেশ্য সমর্থন করেন।","poem":2},{"text":"তিনি আমাকে জ্যোতিতে নিয়ে আসবেন;","poem":1},{"text":"আমি তাঁর ধার্মিকতা দেখব।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তখন আমার শত্রুরা তা দেখবে","poem":1},{"text":"এবং লজ্জিত হয়ে নিজেকে ঢাকবে,","poem":2},{"text":"সে আমাকে বলেছিল,","poem":1},{"text":"“তোমাদের ঈশ্বর সদাপ্রভু কোথায়?”","poem":2},{"tex