{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"NAM","translationId":"ben_ocv","name":"নহূম","commonName":"নহূম","title":"নহূম","order":34,"numberOfChapters":3,"sha256":"cc2cecadd7e30a84694b43d79b1e30c9dd3fdc13b7d509b2b25eb913df1bff95","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["নীনবীর পতন"]},{"type":"verse","number":1,"content":[{"text":"হে নীনবী, তোমার বিরুদ্ধে এক আক্রমণকারী এগিয়ে আসছে।","poem":1},{"text":"দুর্গ পাহারা দাও,","poem":2},{"lineBreak":true},{"text":"পথে নজরদারি চালাও,","poem":2},{"lineBreak":true},{"text":"কোমর বাঁধো,","poem":2},{"lineBreak":true},{"text":"তোমার সব শক্তি একত্রিত করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ইস্রায়েলের সমারোহের মতো","poem":1},{"text":"সদাপ্রভু যাকোবের সমারোহও ফিরিয়ে আনবেন,","poem":2},{"text":"যদিও বিনাশকারীরা তাদের ধ্বংস করেছে","poem":1},{"text":"এবং তাদের দ্রাক্ষালতাগুলি নষ্ট করে দিয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"সৈনিকদের ঢালগুলির রং লাল;","poem":1},{"text":"যোদ্ধারা টকটকে লাল রংয়ের পোশাকে সুসজ্জিত।","poem":2},{"text":"রথ সাজিয়ে তোলার দিনে","poem":1},{"text":"রথের ধাতু চকচক করে উঠেছে;","poem":2},{"lineBreak":true},{"text":"দেবদারু কাঠে তৈরি বর্শাগুলি আস্ফালিত হয়েছে।","poem":2},{"noteId":1}]},{"type":"verse","number":4,"content":[{"text":"রথগুলি জোর কদমে রাস্তায় ছুটে বেড়ায়,","poem":1},{"text":"চকের এদিক-ওদিক তীব্র গতিতে এগিয়ে যায়।","poem":2},{"text":"সেগুলি দেখে মনে হয় সেগুলি বুঝি জ্বলন্ত মশাল;","poem":1},{"text":"সেগুলি বজ্রের মতো আছড়ে পড়ে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"নীনবী তার শ্রেষ্ঠ সৈন্যদলকে তলব করল,","poem":1},{"text":"তাও তারা পথে হোঁচট খেলো।","poem":2},{"text":"তারা নগর-প্রাচীরে ধাক্কা খেলো;","poem":1},{"text":"প্রতিরক্ষামূলক ঢাল স্বস্থানে রাখা হল।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"নদীমুখ খুলে গেল","poem":1},{"text":"এবং রাজপ্রাসাদের পতন হল।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"হুকুম দেওয়া হল যে নীনবী","poem":1},{"text":"নির্বাসিত ও দূরে নীত হবে।","poem":2},{"text":"তার দাসীরা ঘুঘুর মতো বিলাপ করবে","poem":1},{"text":"ও বুক চাপড়াবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"নীনবী এমন এক পুকুরের মতো","poem":1},{"text":"যার জল শুকিয়ে যাচ্ছে।","poem":2},{"text":"“দাঁড়াও! দাড়াও!” তারা চিৎকার করে,","poem":1},{"text":"কিন্তু কেউই পিছু ফেরে না।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"রুপো লুট করো!","poem":1},{"text":"সোনা লুট করো!","poem":2},{"text":"সরবরাহ অসীম!","poem":1},{"text":"তার সব কোষাগারের ধনসম্পদ প্রাচুর্যময়!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"সে লুন্ঠিত, অপহৃত, নগ্ন হয়েছে!","poem":1},{"text":"তার হৃদয় গলে গিয়েছে, হাঁটু ঠকঠক করেছে,","poem":2},{"lineBreak":true},{"text":"শরীর কেঁপে উঠেছে, প্রত্যেকের মুখ ম্লান হয়ে গিয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"এখন কোথায় সিংহদের সেই গুহা,","poem":1},{"text":"সেই স্থান যেখানে তারা যুবসিংহদের খাওয়াতো,","poem":2},{"text":"যেখানে সিংহ ও সিংহী চলে যেত,","poem":1},{"text":"ও শাবকেরা নির্ভয়ে বসবাস করত?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"সিংহ তার শাবকদের জন্য পর্যাপ্ত পশু হত্যা করত","poem":1},{"text":"ও তার সঙ্গিনীর জন্য শিকার করা পশুদের শ্বাসরোধ করত,","poem":2},{"text":"তার ডেরাগুলি নিহত পশুদের দিয়ে","poem":1},{"text":"ও গুহাগুলি শিকার করা পশু দিয়ে পরিপূর্ণ করে রাখত।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“আমি তোমার বিপক্ষ,”","poem":1},{"text":"সর্বশক্তিমান সদাপ্রভু ঘোষণা করছেন।","poem":2},{"text":"“আমি তোমার রথগুলি পুড়িয়ে ধোঁয়ায় পরিণত করব,","poem":1},{"text":"ও তরোয়াল তোমার যুবসিংহদের গ্রাস করবে।","poem":2},{"lineBreak":true},{"text":"পৃথিবীতে আমি তোমার জন্য কোনও শিকার ছেড়ে রাখব না।","poem":2},{"text":"তোমার দূতদের রব","poem":1},{"text":"আর কখনও শোনা যাবে না।”","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"অথবা, অশ্বারোহীরা এদিক-ওদিক ছুটে বেড়িয়েছে","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/ben_ocv/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}