{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"NAM","translationId":"ben_ocv","name":"নহূম","commonName":"নহূম","title":"নহূম","order":34,"numberOfChapters":3,"sha256":"cc2cecadd7e30a84694b43d79b1e30c9dd3fdc13b7d509b2b25eb913df1bff95","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["ধিক্ নীনবী!"]},{"type":"verse","number":1,"content":[{"text":"ধিক্ সেই রক্তপাতকারী নগর,","poem":1},{"text":"যা মিথ্যায় পরিপূর্ণ,","poem":2},{"text":"যা লুঠতরাজে পরিপূর্ণ,","poem":1},{"text":"যেখানে কখনোই ক্ষতিগ্রস্তের অভাব হয় না!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"চাবুকের জোরালো শব্দ,","poem":1},{"text":"চাকার ঝনঝনানি,","poem":2},{"text":"দ্রুতগতি ঘোড়ার ক্ষুরের শব্দ","poem":1},{"text":"ও ধুলো ওড়ানো রথের শব্দ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"অশ্বারোহী সৈন্যদলের আক্রমণ!","poem":1},{"text":"তরোয়ালের ঝলকানি","poem":2},{"lineBreak":true},{"text":"ও বর্শার ঝনঝনানি!","poem":2},{"text":"প্রচুর মানুষের মৃত্যু,","poem":1},{"text":"মৃতদেহের স্তূপ,","poem":2},{"text":"অসংখ্য মৃতদেহ,","poem":1},{"text":"মানুষজন শবে হোঁচট খায়—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"এসবই সেই এক বেশ্যার উচ্ছৃঙ্খল লালসার,","poem":1},{"text":"লোভনীয়, ডাকিনীবিদ্যায় নিপুণ মহিলার কারণে হয়েছে,","poem":2},{"text":"যে তার বেশ্যাবৃত্তি দ্বারা জাতিদের","poem":1},{"text":"এবং তার জাদুবিদ্যা দ্বারা মানুষজনকে বন্দি করে রেখেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“আমি তোমার বিপক্ষ,” সর্বশক্তিমান সদাপ্রভু ঘোষণা করেন।","poem":1},{"text":"“আমি তোমার মুখের উপর তোমার ঘাঘরা তুলে ধরব।","poem":2},{"text":"আমি জাতিদের তোমার উলঙ্গতা দেখাব","poem":1},{"text":"ও রাজ্যগুলির কাছে তোমার লজ্জা প্রকাশ করব।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"আমি অশ্লীলতা দিয়ে তোমাকে আঘাত করব,","poem":1},{"text":"আমি তোমাকে ঘৃণার দৃষ্টিতে দেখব","poem":2},{"lineBreak":true},{"text":"এবং তোমাকে এক প্রদর্শনীতে পরিণত করব।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"যারা তোমাকে দেখবে তারা সবাই তোমার কাছ থেকে পালাবে ও বলবে,","poem":1},{"text":"‘নীনবী ধ্বংসাবশেষে পরিণত হয়েছে—তার জন্যে কে বিলাপ করবে?’","poem":2},{"text":"তোমাকে সান্তনা দেওয়ার জন্য আমি কোথায় লোক খুঁজে পাব?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"তুমি কি সেই থিব্‌সের চেয়ে শ্রেষ্ঠ,","poem":1},{"text":"যা নীলনদের তীরে অবস্থিত,","poem":2},{"lineBreak":true},{"text":"ও যার চতুর্দিক জলে ঘেরা?","poem":2},{"text":"নদী তার সুরক্ষাবলয়,","poem":1},{"text":"জলরাশি তার প্রাচীর ছিল।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"কূশ","poem":1},{"noteId":2},{"text":"ও মিশর ছিল তার অপার শক্তি;","poem":1},{"text":"পূট ও লিবিয়া তার মিত্রশক্তির মধ্যে গণ্য হত।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তাও তাকে বন্দি করা হল","poem":1},{"text":"ও সে নির্বাসনে গেল।","poem":2},{"text":"তার শিশু সন্তানদের প্রত্যেকটি রাস্তার মোড়ে মোড়ে","poem":1},{"text":"ছুঁড়ে ফেলে দিয়ে ছিন্নভিন্ন করা হল।","poem":2},{"text":"তার গণ্যমান্য লোকদের জন্য গুটিকাপাত করা হল,","poem":1},{"text":"এবং তার সব মহান লোককে শিকল দিয়ে বাঁধা হল।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তুমিও মাতাল হয়ে যাবে;","poem":1},{"text":"তুমি আত্মগোপন করবে","poem":2},{"lineBreak":true},{"text":"ও শত্রুর নাগাল এড়িয়ে থাকার জন্য আশ্রয়স্থল খুঁজবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"তোমার সব দুর্গ এমন ডুমুর গাছের মতো,","poem":1},{"text":"যেগুলির ফল পাকতে চলেছে;","poem":2},{"text":"যখন সেগুলিকে নাড়ানো হয়,","poem":1},{"text":"তখন ডুমুরগুলি ভক্ষকদের মুখে গিয়ে পড়ে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তোমার সৈন্যদলের দিকে তাকাও—","poem":1},{"text":"তারা সবাই দুর্বল প্রাণী।","poem":2},{"text":"তোমার দেশের প্রবেশদ্বারগুলি","poem":1},{"text":"তোমার শত্রুদের জন্য হাট করে খুলে রাখা হয়েছে;","poem":2},{"lineBreak":true},{"text":"তোমার ফটকের খিলগুলি আগুন গ্রাস করে নিয়েছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"অবরোধকালের জন্য জল তুলে রাখো,","poem":1},{"text":"তোমার দুর্গগুলি অভেদ্য করো!","poem":2},{"text":"কাদা মেখে রাখো,","poem":1},{"text":"চুন বালির মিশ্রণ তৈরি করো,","poem":2},{"lineBreak":true},{"text":"ইটের গাঁথনি মেরামত করো!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"সেখানেই আগুন তোমাকে গ্রাস করবে;","poem":1},{"text":"তরোয়াল তোমাকে কেটে ফেলবে—","poem":2},{"lineBreak":true},{"text":"সেগুলি তোমাকে পঙ্গপালের ঝাঁকের মতো গিলে খাবে।","poem":2},{"text":"গঙ্গাফড়িং-এর মতো সংখ্যায় বৃদ্ধি পাও,","poem":1},{"text":"পঙ্গপালের মতো সংখ্যায় বৃদ্ধি পাও!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"তোমার বণিকদের সংখ্যা তুমি বাড়িয়েই গিয়েছ","poem":1},{"text":"যতক্ষণ না তারা আকাশের তারাদের চেয়েও সংখ্যায় বেশি হয়েছে,","poem":2},{"text":"কিন্তু পঙ্গপালের মতো তারা দেশকে ন্যাড়া করে দেয়","poem":1},{"text":"ও পরে উড়ে চলে যায়।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"তোমার রক্ষীবাহিনী পঙ্গপালের মতো,","poem":1},{"text":"তোমার কর্মকর্তারা পঙ্গপালের সেই ঝাঁকের মতো","poem":2},{"lineBreak":true},{"text":"যা এক শীতল দিনে প্রাচীরের উপর এসে বসে—","poem":2},{"text":"কিন্তু যখন সূর্য ওঠে তখন তারা উড়ে চলে যায়,","poem":1},{"text":"ও কেউ জানে না তারা কোথায় যায়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"হে আসিরিয়ার রাজা, তোমার মেষপালকেরা","poem":1},{"noteId":3},{"text":"তন্দ্রাচ্ছন্ন হয়েছে;","poem":1},{"text":"তোমার গণ্যমান্য লোকেরা শুয়ে বিশ্রাম করছে।","poem":2},{"text":"তোমার প্রজারা পর্বতমালায় ছিন্নভিন্ন হয়ে আছে","poem":1},{"text":"ও তাদের একত্রিত করার কেউ নেই।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"কোনো কিছুই তোমাকে সুস্থ করতে পারবে না;","poem":1},{"text":"তোমার আঘাতটি মারাত্মক।","poem":2},{"text":"যতজন তোমার খবর শোনে","poem":1},{"text":"তারা সবাই তোমার পতনের খুশিতে হাততালি দেয়,","poem":2},{"text":"যেহেতু তোমার অপার নিষ্ঠুরতার আঁচ","poem":1},{"text":"কে না পেয়েছে?","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"অর্থাৎ, নীলনদের উচ্চতর এলাকা","reference":{"chapter":3,"verse":9}},{"noteId":3,"caller":"+","text":"অর্থাৎ, শাসনকর্তারা","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/ben_ocv/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}