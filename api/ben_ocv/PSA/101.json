{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["দাউদের গীত।"]},{"type":"verse","number":1,"content":[{"text":"আমি তোমার প্রেম ও ন্যায়পরায়ণতার সম্পর্কে গাইব;","poem":1},{"text":"তোমার উদ্দেশে, হে সদাপ্রভু, আমি স্তবগান করব।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"সতর্ক হয়ে আমি নির্দোষ জীবন কাটাব—","poem":1},{"text":"কখন তুমি আমার কাছে আসবে?","poem":2},{"lineBreak":true},{"text":"আমি নিজের গৃহে","poem":1},{"text":"সততার সঙ্গে জীবন কাটাব।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"যা কিছু জঘন্য ও কুরুচিপূর্ণ","poem":1},{"text":"তা দেখতে আমি অস্বীকার করব।","poem":2},{"lineBreak":true},{"text":"আমি ভ্রষ্টাচারীদের কাজকর্ম ঘৃণা করি;","poem":1},{"text":"তাদের সঙ্গে আমি কোনও সম্বন্ধ রাখব না।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যে হৃদয়ে বিকৃত সে আমার কাছ থেকে দূরে থাকবে;","poem":1},{"text":"আমি সব ধরনের মন্দ থেকে দূরে সরে থাকব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"যে কেউ গোপনে প্রতিবেশীর অপবাদ করে,","poem":1},{"text":"আমি তাকে উচ্ছেদ করব;","poem":2},{"text":"যার দৃষ্টি উদ্ধত ও হৃদয় অহংকারী,","poem":1},{"text":"আমি তাকে সহ্য করব না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"দেশের বিশ্বস্তদের প্রতি আমার দৃষ্টি থাকবে,","poem":1},{"text":"যেন তারা আমার সঙ্গে বসবাস করতে পারে;","poem":2},{"text":"যে সিদ্ধ পথে চলে","poem":1},{"text":"সে আমার পরিচর্যা করবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"যারা প্রতারক","poem":1},{"text":"তারা কেউ আমার গৃহে বসবাস করবে না;","poem":2},{"text":"যারা মিথ্যা কথা বলে","poem":1},{"text":"তারা আমার সামনে দাঁড়াবে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"প্রতি সকালে, দেশের সব দুষ্টকে","poem":1},{"text":"আমি নাশ করব;","poem":2},{"text":"সদাপ্রভুর নগর থেকে","poem":1},{"text":"আমি সব অনিষ্টকারীকে উচ্ছেদ করব।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}