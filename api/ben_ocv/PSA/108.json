{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["দাউদের সংগীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বর, আমার হৃদয় তোমাতে অবিচল;","poem":1},{"text":"আমি আমার সমস্ত প্রাণ দিয়ে গান গাইব ও সংগীত রচনা করব।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"জেগে ওঠো, বীণা ও সুরবাহার!","poem":1},{"text":"আমি প্রত্যুষকে জাগিয়ে তুলব।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"হে সদাপ্রভু, জাতিদের মাঝে আমি তোমার প্রশংসা করব;","poem":1},{"text":"লোকেদের মাঝে আমি তোমার স্তব করব।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কারণ তোমার অবিচল প্রেম আকাশমণ্ডলের ঊর্ধ্বে;","poem":1},{"text":"তোমার বিশ্বস্ততা গগনচুম্বী।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"হে ঈশ্বর, আকাশমণ্ডলের ঊর্ধ্বে গৌরবান্বিত হও;","poem":1},{"text":"তোমার মহিমা সারা পৃথিবীতে ব্যাপ্ত হোক।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"তোমার ডান হাত দিয়ে তুমি আমাদের রক্ষা করো ও সাহায্য করো,","poem":1},{"text":"যেন তারা উদ্ধার পায় যাদের তুমি ভালোবাসো।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ঈশ্বর তাঁর পবিত্রস্থান থেকে কথা বলেছেন:","poem":1},{"text":"“জয়ধ্বনিতে আমি শিখিম বিভক্ত করব,","poem":2},{"lineBreak":true},{"text":"সুক্কোতের উপত্যকা আমি পরিমাপ করে দেব।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"গিলিয়দ আমার, মনঃশিও আমার;","poem":1},{"text":"ইফ্রয়িম আমার শিরস্ত্রাণ,","poem":2},{"lineBreak":true},{"text":"যিহূদা আমার রাজদণ্ড।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"মোয়াব আমার হাত ধোয়ার পাত্র,","poem":1},{"text":"ইদোমের উপরে আমি আমার চটি নিক্ষেপ করব;","poem":2},{"lineBreak":true},{"text":"ফিলিস্তিয়ার উপরে আমি জয়ধ্বনি করব।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"কে আমাকে সুরক্ষিত নগরের মধ্যে নিয়ে যাবে?","poem":1},{"text":"কে ইদোম পর্যন্ত আমাকে পথ দেখাবে?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"হে ঈশ্বর, তুমি কি আমাদের ত্যাগ করেছ?","poem":1},{"text":"তুমি কি আমাদের সৈন্যদলের সাথে আর যাবে না?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"আমাদের শত্রুদের বিরুদ্ধে সাহায্য করো,","poem":1},{"text":"কারণ মানুষের সাহায্য নিষ্ফল।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ঈশ্বরের সাথে আমরা জয়লাভ করব,","poem":1},{"text":"এবং তিনি আমাদের শত্রুদের পদদলিত করবেন।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}