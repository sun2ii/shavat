{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভুর প্রশংসা করো।","poem":1},{"lineBreak":true},{"text":"ধন্য সেই ব্যক্তি, যে সদাপ্রভুকে সম্ভ্রম করে,","poem":1},{"text":"যে তাঁর আজ্ঞা পালনে মহা আনন্দ পায়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"তাদের সন্তানসন্ততিরা এ জগতে শক্তিশালী হবে,","poem":1},{"text":"ন্যায়পরায়ণদের প্রজন্ম ধন্য হবে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ধনসম্পদ ও ঐশ্বর্য তার গৃহে আছে,","poem":1},{"text":"এবং তার ধার্মিকতা চিরস্থায়ী হয়।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ন্যায়পরায়ণের জন্য অন্ধকারের মাঝে আলো উদয় হয়,","poem":1},{"text":"সে কৃপাময়, স্নেহশীল ও ধার্মিক।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"যে উদার ও মুক্তহস্তে দান করে, তার মঙ্গল হবে,","poem":1},{"text":"সে নিজের বিষয়গুলি ন্যায়ের সঙ্গে নিষ্পত্তি করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"নিশ্চয় সে কখনও বিচলিত হবে না;","poem":1},{"text":"কিন্তু ধার্মিককে চিরকাল মনে রাখা হবে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"অশুভ সংবাদে সে ভয় করবে না;","poem":1},{"text":"তার হৃদয় অবিচল, তা সদাপ্রভুতে আস্থা রাখে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তার হৃদয় সুস্থির, সে ভয় করবে না;","poem":1},{"text":"অবশেষে সে বিজয়ীর মতো তার শত্রুদের দিকে তাকাবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সে অবাধে দরিদ্রদের মাঝে দান বিতরণ করেছে,","poem":1},{"text":"তার ধার্মিকতা চিরস্থায়ী;","poem":2},{"lineBreak":true},{"text":"তার শিং","poem":2},{"noteId":54},{"text":"গৌরবে উন্নত হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"দুষ্টলোক এসব দেখবে আর উত্ত্যক্ত হবে,","poem":1},{"text":"সে ক্রোধে দন্তঘর্ষণ করবে আর নিঃশেষ হবে;","poem":2},{"lineBreak":true},{"text":"দুষ্টদের আকাঙ্ক্ষা বিনষ্ট হবে।","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"শিং এখানে মর্যাদার অর্থ বহনকারী।","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/ben_ocv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}