{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"আমাদের নয়, হে সদাপ্রভু, আমাদের নয়,","poem":1},{"text":"কিন্তু তোমারই নাম গৌরবান্বিত করো,","poem":2},{"lineBreak":true},{"text":"তোমার প্রেম ও বিশ্বস্ততার কারণে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"জাতিরা কেন বলে,","poem":1},{"text":"“তাদের ঈশ্বর কোথায়?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"আমাদের ঈশ্বর স্বর্গে আছেন;","poem":1},{"text":"তিনি তাঁর ইচ্ছামতোই কাজ করেন।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কিন্তু তাদের প্রতিমাগুলি রুপো ও সোনা দিয়ে তৈরি,","poem":1},{"text":"মানুষের হাতে গড়া।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তাদের মুখ আছে, কিন্তু তারা কথা বলতে পারে না,","poem":1},{"text":"চোখ আছে, কিন্তু তারা দেখতে পায় না।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তাদের কান আছে, কিন্তু তারা শুনতে পায় না,","poem":1},{"text":"নাক আছে, কিন্তু তারা গন্ধ পায় না।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"হাত আছে, কিন্তু তারা অনুভব করতে পারে না,","poem":1},{"text":"পা আছে, কিন্তু তারা চলতে পারে না,","poem":2},{"lineBreak":true},{"text":"এমনকি তারা মুখ দিয়ে একটি শব্দও উচ্চারণ করতে পারে না।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"যারা প্রতিমা তৈরি করে তারা তাদের মতোই হবে,","poem":1},{"text":"আর যারা সেগুলির উপর আস্থা রাখে তারাও তেমনই হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"হে ইস্রায়েল, সদাপ্রভুর উপর আস্থা রাখো—","poem":1},{"text":"তিনি তাদের সহায় ও ঢাল।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"হে হারোণের কুল, সদাপ্রভুর উপর আস্থা রাখো—","poem":1},{"text":"তিনি তাদের সহায় ও ঢাল।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তোমরা যারা তাঁকে সম্ভ্রম করো, সদাপ্রভুর উপর আস্থা রাখো—","poem":1},{"text":"তিনি তাদের সহায় ও ঢাল।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"সদাপ্রভু আমাদের মনে রাখেন আর আমাদের আশীর্বাদ করবেন:","poem":1},{"text":"তিনি তাঁর ইস্রায়েল কুলকে আশীর্বাদ করবেন,","poem":2},{"lineBreak":true},{"text":"তিনি হারোণের কুলকে আশীর্বাদ করবেন,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তিনি তাদের আশীর্বাদ করবেন যারা সদাপ্রভুকে সম্ভ্রম করে—","poem":1},{"text":"ক্ষুদ্র বা মহান সবাইকে করবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"সদাপ্রভু তোমাদের সমৃদ্ধি করুন,","poem":1},{"text":"তোমাদের ও তোমাদের ছেলেমেয়েদের প্রতি।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তোমরা সদাপ্রভুর আশীর্বাদপ্রাপ্ত,","poem":1},{"text":"তিনি স্বর্গ ও পৃথিবীর সৃষ্টিকর্তা।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"সর্বোচ্চ আকাশমণ্ডল সদাপ্রভুর,","poem":1},{"text":"কিন্তু তিনি এই পৃথিবী মানুষের হাতে তুলে দিয়েছেন।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"যারা মৃত, যারা নীরবতার স্থানে নেমেছে","poem":1},{"text":"তারা সদাপ্রভুর প্রশংসা করে না।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"কিন্তু আমরা সদাপ্রভুর উচ্চপ্রশংসা করব,","poem":1},{"text":"এখন ও অনন্তকাল পর্যন্ত।","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা করো।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}