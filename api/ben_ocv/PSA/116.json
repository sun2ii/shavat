{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"আমি সদাপ্রভুকে ভালোবাসি, কারণ তিনি আমার কণ্ঠস্বর শুনেছেন;","poem":1},{"text":"তিনি আমার বিনতি প্রার্থনা শুনেছেন।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তিনি আমার প্রতি কর্ণপাত করেছেন,","poem":1},{"text":"সেই কারণে আমি সারা জীবন তাঁর কাছে প্রার্থনা করব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"মৃত্যুর দড়ি আমাকে বেঁধে ফেলল,","poem":1},{"text":"পাতালের যন্ত্রণা আমার উপর নেমে এল,","poem":2},{"lineBreak":true},{"text":"দুর্দশায় ও দুঃখে আমি জর্জরিত হলাম।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তখন আমি সদাপ্রভুর নামে ডাকলাম:","poem":1},{"text":"“হে সদাপ্রভু, আমাকে রক্ষা করো!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"সদাপ্রভু কৃপাবান ও ধর্মময়,","poem":1},{"text":"আমাদের ঈশ্বর করুণায় পরিপূর্ণ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যারা সরলচিত্ত, সদাপ্রভু তাদের রক্ষা করেন;","poem":1},{"text":"গভীর সংকটকালে তিনি আমাকে রক্ষা করেছিলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"হে আমার প্রাণ, তুমি বিশ্রামে ফিরে যাও,","poem":1},{"text":"কারণ সদাপ্রভু তোমার মঙ্গল করেছেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কারণ তুমি, হে সদাপ্রভু, মৃত্যু থেকে আমাকে উদ্ধার করেছ,","poem":1},{"text":"চোখের জল থেকে আমার চোখ,","poem":2},{"lineBreak":true},{"text":"পতন থেকে আমার পা, উদ্ধার করেছ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"যেন আমি জীবিতদের দেশে","poem":1},{"text":"সদাপ্রভুর সামনে গমনাগমন করি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"আমি তোমাকে বিশ্বাস করেছিলাম যখন আমি বলেছিলাম,","poem":1},{"text":"“হে সদাপ্রভু, আমি অত্যন্ত পীড়িত”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"উদ্বেগে আমি বলেছিলাম,","poem":1},{"text":"“সবাই মিথ্যাবাদী।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"আমি সদাপ্রভুর কাছ থেকে যেসব মঙ্গল পেয়েছি","poem":1},{"text":"তার প্রতিদানে তাঁকে কী ফিরিয়ে দেবো?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"আমি পরিত্রাণের পাত্রখানি তুলে নেবো","poem":1},{"text":"আর সদাপ্রভুর নামে ডাকব।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"সদাপ্রভুর সব প্রজার সমাবেশে","poem":1},{"text":"তাঁর প্রতি আমার শপথ আমি পূর্ণ করব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"সদাপ্রভুর বিশ্বস্ত সেবাকারীদের মৃত্যু","poem":1},{"text":"তাঁর চোখে বহুমূল্য।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"সত্যিই আমি তোমার দাস, হে সদাপ্রভু;","poem":1},{"text":"যেমন আমার মা করেছিলেন, আমিও তোমার সেবা করব;","poem":2},{"lineBreak":true},{"text":"আমার শিকল থেকে তুমি আমাকে মুক্ত করেছ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"আমি তোমার উদ্দেশে ধন্যবাদের নৈবেদ্য নিবেদন করব,","poem":1},{"text":"আর সদাপ্রভুর নামে ডাকব।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"সদাপ্রভুর সব প্রজার সমাবেশে","poem":1},{"text":"তাঁর প্রতি আমার শপথ আমি পূর্ণ করব,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"সদাপ্রভুর গৃহের প্রাঙ্গণে—","poem":1},{"text":"হে জেরুশালেম, তোমারই মাঝে করব।","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা করো।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}