{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["প্রধান সংগীত পরিচালকের জন্য। শমীনীৎ",{"noteId":13},"অনুসারে। দাউদের গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে সদাপ্রভু, সাহায্য করো, কারণ কেউ আর বিশ্বস্ত নয়;","poem":1},{"text":"যারা অনুগত তারা মানুষের মধ্য থেকে হারিয়ে গেছে।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"সবাই প্রতিবেশীদের কাছে মিথ্যা কথা বলে;","poem":1},{"text":"তাদের মুখ দিয়ে তারা তোষামোদ করে","poem":2},{"lineBreak":true},{"text":"কিন্তু হৃদয়ে প্রতারণা ধারণ করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"সদাপ্রভু সব তোষামোদকারীর মুখ নীরব করেন","poem":1},{"text":"এবং সব অহংকারী জিভ—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যারা বলে,","poem":1},{"text":"“আমাদের জিভ দিয়েই আমাদের জয় হবে;","poem":2},{"lineBreak":true},{"text":"আমাদের মুখ আমাদের রক্ষা করবে—কে আমাদের উপর প্রভু হবে?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“দীনহীনদের লুটপাট করা হচ্ছে ও দরিদ্ররা আর্তনাদ করছে,","poem":1},{"text":"সেই কারণে আমি এবার জাগ্রত হব,” সদাপ্রভু বলেন।","poem":2},{"lineBreak":true},{"text":"“অনিষ্টকারীদের হাত থেকে আমি তাদের রক্ষা করব।”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ধাতু গলাবার পাত্রে পরিষ্কৃত রুপোর মতো,","poem":1},{"text":"সাতবার শোধিত সোনার মতো,","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর বাক্যসকল নিখুঁত।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"হে সদাপ্রভু, তুমি দরিদ্রদের নিরাপদে রাখবে","poem":1},{"text":"এবং দুষ্টদের হাত থেকে চিরকাল আমাদের রক্ষা করবে,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"যদিও দুষ্টরা অবাধে ঘুরে বেড়ায়","poem":1},{"text":"এবং মানবজাতির মধ্যে অধর্মের প্রশংসা করা হয়।","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"অজানা সংগীত জগতের শব্দ","reference":{"chapter":12,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}