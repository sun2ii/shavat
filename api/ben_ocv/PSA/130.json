{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["একটি আরোহণ সংগীত।"]},{"type":"verse","number":1,"content":[{"text":"হে সদাপ্রভু, আমি অতল থেকে তোমার সাহায্য চেয়েছি;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"হে সদাপ্রভু, আমার কণ্ঠস্বর শোনো।","poem":2},{"text":"আমার বিনতি প্রার্থনার প্রতি","poem":1},{"text":"তোমার কান মনযোগী হোক।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"হে সদাপ্রভু, যদি তুমি পাপের হিসেব রাখতে,","poem":1},{"text":"তবে প্রভু, কে বাঁচতে পারত?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কিন্তু তোমার কাছে ক্ষমা আছে,","poem":1},{"text":"যেন আমরা, সম্ভ্রমে তোমার সেবা করতে পারি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"আমি সদাপ্রভুর প্রতীক্ষায় থাকি, আমার সমস্ত অন্তর প্রতীক্ষা করে,","poem":1},{"text":"এবং তাঁর বাক্যে আমি আশা রাখি।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"প্রত্যুষের জন্য প্রহরী যেমন প্রতীক্ষায় থাকে","poem":1},{"text":"হ্যাঁ, প্রত্যুষের জন্য প্রহরী যেমন প্রতীক্ষায় থাকে,","poem":2},{"lineBreak":true},{"text":"আমার প্রাণ, প্রভুর জন্য, তার থেকেও বেশি প্রতীক্ষায় থাকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"হে ইস্রায়েল, সদাপ্রভুর উপর আশা রাখো,","poem":1},{"text":"কারণ সদাপ্রভুর কাছে অবিচল প্রেম আছে,","poem":2},{"lineBreak":true},{"text":"এবং তাঁর কাছে পূর্ণ মুক্তি আছে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তিনি নিজেই ইস্রায়েলকে","poem":1},{"text":"সব পাপ থেকে মুক্ত করবেন।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}