1},{"text":"সমুদ্রে ও সমস্ত জলধির মধ্যে,","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর যা ইচ্ছা তাই করেন।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তিনি পৃথিবীর প্রান্তদেশ থেকে মেঘ উত্থাপন করেন;","poem":1},{"text":"তিনি বৃষ্টির সঙ্গে বিদ্যুৎ প্রেরণ করেন,","poem":2},{"lineBreak":true},{"text":"আর তাঁর ভাণ্ডার থেকে বায়ু বের করে আনেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"তিনি মিশরের প্রথমজাতদের বিনাশ করেছিলেন,","poem":1},{"text":"মানুষ ও পশুর প্রথমজাতদের।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"হে মিশর, ফরৌণ ও তার অনুচরদের বিপক্ষে,","poem":1},{"text":"তিনি তোমার মাঝে চিহ্ন ও আশ্চর্য কাজ পাঠিয়েছিলেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তিনি বহু জাতিকে আঘাত করেছিলেন","poem":1},{"text":"এবং শক্তিশালী রাজাদের বধ করেছিলেন—","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ইমোরীয়দের রাজা সীহোনকে,","poem":1},{"text":"বাশনের রাজা ওগকে","poem":2},{"lineBreak":true},{"text":"এবং কনানের সমস্ত রাজাকে—","poem":2}]},{"type":"verse","number":12,"content":[{"text":"এবং তিনি তাদের দেশ অধিকারস্বরূপ দিলেন,","poem":1},{"text":"তাঁর প্রজা ইস্রায়েলকে অধিকার দিলেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"তোমার নাম, হে সদাপ্রভু, অনন্তকালস্থায়ী,","poem":1},{"text":"তোমার খ্যাতি, হে সদাপ্রভু, সব প্রজন্মের কাছে পরিচিত।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"সদাপ্রভু তাঁর প্রজাদের ন্যায়বিচার করবেন","poem":1},{"text":"আর তাঁর দাসদের প্রতি করুণা করবেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"জাতিদের প্রতিমাগুলি রুপো ও সোনা দিয়ে তৈরি,","poem":1},{"text":"মানুষের হাতে গড়া।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"তাদের মুখ আছে, কিন্তু তারা কথা বলতে পারে না,","poem":1},{"text":"চোখ আছে, কিন্তু তারা দেখতে পায় না।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"তাদের কান আছে, কিন্তু তারা শুনতে পায় না,","poem":1},{"text":"এমনকি তাদের মুখে প্রাণের নিঃশ্বাস নেই।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"যারা প্রতিমা তৈরি করে তারা তাদের মতোই হবে,","poem":1},{"text":"আর যারা সেগুলির উপর আস্থা রাখে তারাও তেমনই হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"হে ইস্রায়েলের কুল, সদাপ্রভুর প্রশংসা করো;","poem":1},{"text":"হে হারোণের কুল, সদাপ্রভুর প্রশংসা করো;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"হে লেবীয় কুল, সদাপ্রভুর প্রশংসা করো;","poem":1},{"text":"তোমরা যারা তাঁকে সম্ভ্রম করো, সদাপ্রভুর প্রশংসা করো।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"সিয়োন থেকে সদাপ্রভুর প্রশংসা হোক,","poem":1},{"text":"কারণ তিনি জেরুশালেমে বসবাস করেন।","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর প্রশংসা করো।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}