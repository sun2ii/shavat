{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"যখন সিয়োনের কথা আমাদের মনে পড়ত","poem":1},{"text":"ব্যাবিলনের নদীতীরে বসে আমরা কাঁদতাম।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমরা সেখানে চিনার গাছে","poem":1},{"text":"বীণাগুলি ঝুলিয়ে রাখতাম,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"কারণ সেখানে আমাদের বন্দিকারীরা গান শুনতে চাইত,","poem":1},{"text":"আমাদের অত্যাচারীরা আনন্দগানের দাবি করত;","poem":2},{"lineBreak":true},{"text":"তারা বলত “সিয়োনের গান, একটি গান আমাদের শোনাও!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"কিন্তু কীভাবে আমরা সদাপ্রভুর গান গাইব","poem":1},{"text":"যখন আমরা বিদেশে বসবাস করছি?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"হে জেরুশালেম, আমি যদি তোমাকে ভুলে যাই,","poem":1},{"text":"তবে যেন আমার ডান হাত তার দক্ষতা হারিয়ে ফেলে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যদি আমি তোমাকে ভুলে যাই,","poem":1},{"text":"আর যদি আমি জেরুশালেমকে","poem":2},{"text":"আমার সর্বাধিক আনন্দ বলে গণ্য না করি,","poem":1},{"text":"তবে যেন আমার জিভ মুখের তালুতে আটকে যায়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"হে সদাপ্রভু, মনে রেখো, যেদিন জেরুশালেমকে বন্দি করা হয়েছিল","poem":1},{"text":"সেদিন ইদোমীয়রা যা করেছিল।","poem":2},{"text":"তারা জোর গলায় বলেছিল, “উপড়ে ফেলো,","poem":1},{"text":"সমূলে উপড়ে ফেলো!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"হে ব্যাবিলনের কন্যা, তুমি ধ্বংস হবে,","poem":1},{"text":"ধন্য সেই যে তোমাকে সেরকম প্রতিফল দেবে","poem":2},{"lineBreak":true},{"text":"যে রকম তুমি আমাদের প্রতি করেছিলে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ধন্য সেই যে তোমাদের শিশুদের ধরে","poem":1},{"text":"আর পাথরের উপরে আছড়ায়।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}