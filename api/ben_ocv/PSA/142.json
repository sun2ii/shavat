{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["দাউদের মস্কীল",{"noteId":58},"। যখন তিনি গুহার মধ্যে ছিলেন। একটি প্রার্থনা।"]},{"type":"verse","number":1,"content":[{"text":"আমি জোর গলায় সদাপ্রভুর কাছে বিনতি করি;","poem":1},{"text":"সদাপ্রভুর দয়ার জন্য আমি অনুনয় করি।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমি তাঁর কাছে আমার অভিযোগের কথা প্রকট করি;","poem":1},{"text":"তোমার সামনে আমার সংকটের কথা বলি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"যখন আমার আত্মা আমার অন্তরে ক্ষীণ হয়,","poem":1},{"text":"তখন তুমিই আমার চলার পথে লক্ষ্য রাখো।","poem":2},{"text":"যে পথে আমি চলি,","poem":1},{"text":"লোকেরা সেই পথে আমার জন্য এক ফাঁদ পেতেছে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তুমি চেয়ে দেখো, আমার ডানদিকে কেউ নেই;","poem":1},{"text":"আমার জন্য কারও ভাবনা নেই,","poem":2},{"text":"আমার কোনও আশ্রয় নেই;","poem":1},{"text":"কেউই আমার জীবনের জন্য চিন্তা করে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"হে সদাপ্রভু, আমি তোমার কাছে কাঁদি,","poem":1},{"text":"আমি বলি, “তুমিই আমার আশ্রয়,","poem":2},{"lineBreak":true},{"text":"জীবিতদের দেশে তুমিই আমার অধিকার।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আমার কাতর প্রার্থনা শোনো,","poem":1},{"text":"কারণ আমি নিদারুণ প্রয়োজনে রয়েছি;","poem":2},{"text":"যারা আমাকে তাড়না করে, তাদের হাত থেকে আমাকে উদ্ধার করো,","poem":1},{"text":"কারণ তারা আমার থেকেও বেশি শক্তিশালী।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমাকে কারাগার থেকে মুক্ত করো,","poem":1},{"text":"যেন আমি তোমার নামের প্রশংসা করতে পারি।","poem":2},{"text":"তখন ধার্মিকেরা আমাকে ঘিরে ধরবে","poem":1},{"text":"কারণ তুমি আমার প্রতি মঙ্গলময়।","poem":2}]}],"footnotes":[{"noteId":58,"caller":"+","text":"সম্ভবত সাহিত্যের অথবা সংগীতের প্রতিশব্দ","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}