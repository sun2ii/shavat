{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["দাউদের মিকতাম",{"noteId":15},"।"]},{"type":"verse","number":1,"content":[{"text":"হে আমার ঈশ্বর, তুমি আমাকে নিরাপদে রাখো,","poem":1},{"text":"কারণ আমি তোমাতেই আশ্রয় নিয়েছি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"আমি সদাপ্রভুকে বললাম, “তুমিই আমার প্রভু;","poem":1},{"text":"তুমি ছাড়া আমার কোনো মঙ্গল নেই।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"জগতে যত পবিত্রজন আছেন তাঁদের সম্বন্ধে আমি বলি,","poem":1},{"text":"“তাঁরা বিশিষ্ট ব্যক্তিসকল, আর আমি তাঁদের নিয়ে আমোদ করি।”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"যারা অন্য দেবতাদের পিছনে ছোটে তারা আরও বেশি কষ্ট পাবে;","poem":1},{"text":"আমি সেই দেবতাদের উদ্দেশে রক্তের নৈবেদ্য উৎসর্গ করব না","poem":2},{"lineBreak":true},{"text":"এমনকি তাদের নামও উচ্চারণ করব না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"হে সদাপ্রভু, একমাত্র তুমিই আমার উত্তরাধিকার ও আশীর্বাদের পানপাত্র;","poem":1},{"text":"তুমি আমার অধিকার সুরক্ষিত করেছ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যে দেশ তুমি আমাকে দিয়েছ তা মনোরম দেশ;","poem":1},{"text":"সত্যিই কত সুন্দর আমার উত্তরাধিকার।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমি সদাপ্রভুর প্রশংসা করি, যিনি আমায় সুমন্ত্রণা দেন;","poem":1},{"text":"রাত্রিতেও আমার হৃদয় আমায় উপদেশ দেয়।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আমি সর্বদা আমার চোখ সদাপ্রভুতে স্থির রাখি।","poem":1},{"text":"তিনি আমার ডানপাশে আছেন, তাই আমি কখনও বিচলিত হব না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"তাই আমার হৃদয় আনন্দিত এবং আমার জিভ উল্লাস করে;","poem":1},{"text":"আমার দেহ নিরাপদে বিশ্রাম নেবে,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"কারণ তুমি কখনও আমাকে পাতালের গর্ভে পরিত্যাগ করবে না,","poem":1},{"text":"তুমি তোমার বিশ্বস্তদের","poem":2},{"noteId":16},{"text":"ক্ষয় দেখতে দেবে না।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তুমি আমাকে জীবনের পথ দেখাও;","poem":1},{"text":"তোমার সান্নিধ্য আমাকে আনন্দ দিয়ে পূর্ণ করবে,","poem":2},{"lineBreak":true},{"text":"তোমার ডান হাতে আছে অনন্ত সুখ।","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"সম্ভবত সাহিত্য বা সংগীতের প্রতিশব্দ","reference":{"chapter":16,"verse":0}},{"noteId":16,"caller":"+","text":"অথবা পবিত্র","reference":{"chapter":16,"verse":10}}]},"thisChapterLink":"/api/ben_ocv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}