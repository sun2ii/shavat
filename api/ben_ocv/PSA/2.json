{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"কেন জাতিরা চক্রান্ত","poem":1},{"noteId":0},{"text":"করে","poem":1},{"text":"আর লোকেরা কেন বৃথাই সংকল্প করে?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"পৃথিবীর রাজারা উদিত হয়","poem":1},{"text":"এবং শাসকেরা সংঘবদ্ধ হয়","poem":2},{"lineBreak":true},{"text":"সদাপ্রভুর বিরুদ্ধে ও তাঁর অভিষিক্ত ব্যক্তির বিরুদ্ধে, এই বলে,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“এসো আমরা তাদের শিকল ভেঙে ফেলি","poem":1},{"text":"ও তাদের হাতকড়া ফেলে দিই।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"যিনি স্বর্গের সিংহাসনে উপবিষ্ট তিনি হাসেন;","poem":1},{"text":"প্রভু তাদের প্রতি বিদ্রুপ করেন।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"রাগে তিনি তাদের তিরস্কার করেন","poem":1},{"text":"ও তাঁর ক্রোধে তিনি তাদের আতঙ্কিত করেন।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"কারণ প্রভু ঘোষণা করেন, “আমার পবিত্র সিয়োন পর্বতে","poem":1},{"text":"আমি আমার রাজাকে প্রতিষ্ঠিত করেছি।”","poem":2}]},{"type":"verse","number":7,"content":["আমি সদাপ্রভুর আদেশ ঘোষণা করব:",{"text":"তিনি আমায় বললেন, “তুমি আমার পুত্র;","poem":1},{"text":"আজ আমি তোমার পিতা হয়েছি।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আমাকে জিজ্ঞাসা করো,","poem":1},{"text":"আর আমি জাতিদের তোমার অধিকার করব,","poem":2},{"lineBreak":true},{"text":"পৃথিবীর শেষ প্রান্ত তোমার অধীনস্থ হবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তুমি তাদের লোহার","poem":1},{"noteId":1},{"text":"দণ্ড দিয়ে চূর্ণ করবে;","poem":1},{"text":"মাটির পাত্রের মতো তুমি তাদের ভেঙে টুকরো করবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"অতএব, হে রাজারা, তোমরা বিচক্ষণ হও;","poem":1},{"text":"হে পৃথিবীর শাসকবর্গ, সাবধান হও।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"সম্ভ্রমে সদাপ্রভুর আরাধনা করো","poem":1},{"text":"আর কম্পিত হৃদয়ে তাঁর শাসন উদ্‌যাপন করো।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তাঁর পুত্রকে চুম্বন করো, নতুবা তিনি ক্রুদ্ধ হবেন","poem":1},{"text":"এবং তোমার পথ তোমাকে ধ্বংসের দিকে নিয়ে যাবে,","poem":2},{"text":"কারণ তাঁর ক্রোধ মুহূর্তে জ্বলে উঠতে পারে।","poem":1},{"text":"ধন্য তারা, যারা তাঁর শরণাপন্ন।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"হিব্রু ভাষায় ক্রোধ","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"+","text":"অথবা লোহার রাজদণ্ড দিয়ে শাসন করবে","reference":{"chapter":2,"verse":9}}]},"thisChapterLink":"/api/ben_ocv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}