{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["প্রধান সংগীত পরিচালকের জন্য। দাউদের গীত।"]},{"type":"verse","number":1,"content":[{"text":"সদাপ্রভু সংকটের দিনে তোমাকে উত্তর দেবেন;","poem":1},{"text":"যাকোবের ঈশ্বরের নাম তোমাকে রক্ষা করবেন।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তিনি পবিত্রস্থান থেকে তোমাকে সাহায্য করবেন,","poem":1},{"text":"আর সিয়োন থেকে তোমাকে শক্তি জোগাবেন।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তিনি তোমার সমস্ত বলি স্মরণে রাখবেন","poem":1},{"text":"ও তোমার হোমবলি গ্রহণ করবেন।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তিনি তোমার হৃদয়ের সমস্ত অভিলাষ পূর্ণ করবেন,","poem":1},{"text":"এবং তোমার সকল পরিকল্পনা সার্থক করবেন।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তোমার জয়ে আমরা আনন্দগান করব","poem":1},{"text":"আর আমাদের ঈশ্বরের নামে আমরা বিজয় পতাকা উড়াব।","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু তোমার সমস্ত নিবেদন মঞ্জুর করুন।","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"এখন আমি জানি:","poem":1},{"text":"যে, সদাপ্রভু তাঁর অভিষিক্ত ব্যক্তিকে বিজয় প্রদান করেন।","poem":2},{"text":"তিনি নিজের ডান হাতের বিজয়ী শক্তিতে","poem":1},{"text":"স্বর্গীয় পবিত্রস্থান থেকে তাকে উত্তর দেন।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"কেউ রথে এবং কেউ ঘোড়ায় আস্থা রাখে,","poem":1},{"text":"কিন্তু আমরা আমাদের ঈশ্বর সদাপ্রভুর নামে আস্থা রাখি।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তাদের নতজানু করা হবে ও পতন ঘটবে;","poem":1},{"text":"কিন্তু আমরা উঠে দাঁড়াব ও দৃঢ়ভাবে দাঁড়াব।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"হে সদাপ্রভু, রাজাকে বিজয় প্রদান করো!","poem":1},{"text":"যখন আমরা সাহায্যের জন্য আর্তনাদ করি, আমাদের উত্তর দিয়ো!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}