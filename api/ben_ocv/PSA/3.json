ext":"যে শত সহস্র লোক আমাকে চতুর্দিকে ঘিরে রেখেছে","poem":1},{"text":"আমি তাদের ভয় করব না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"হে সদাপ্রভু, জেগে ওঠো!","poem":1},{"text":"আমার ঈশ্বর, আমাকে উদ্ধার করো!","poem":2},{"text":"আমার সব শত্রুর মুখে আঘাত করো;","poem":1},{"text":"দুষ্টদের দাঁত ভেঙে দাও।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"সদাপ্রভুর কাছ থেকে পরিত্রাণ আসে।","poem":1},{"text":"তোমার আশীর্বাদ তোমার লোকেদের উপর বর্তাক।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}