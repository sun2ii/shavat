ne_break"},{"type":"verse","number":5,"content":[{"text":"তখন আমি তোমার কাছে আমার পাপস্বীকার করলাম","poem":1},{"text":"আর আমার কোনও অপরাধ আমি গোপন করলাম না।","poem":2},{"text":"আমি বললাম, “সদাপ্রভুর কাছে আমার সব অপরাধ","poem":1},{"text":"আমি স্বীকার করব।”","poem":2},{"text":"আর তুমি আমার","poem":1},{"text":"পাপের দোষ ক্ষমা করলে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"তাই সময় থাকতে","poem":1},{"text":"সব বিশ্বস্ত লোক তোমার কাছে প্রার্থনা করুক;","poem":2},{"text":"তারা যেন বিচারের বন্যার জলে","poem":1},{"text":"ডুবে না যায়।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তুমি আমার আশ্রয়স্থল;","poem":1},{"text":"তুমি আমাকে বিপদ থেকে সুরক্ষিত করবে","poem":2},{"lineBreak":true},{"text":"এবং মুক্তির গানে আমাকে চারপাশে ঘিরে রাখবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"সদাপ্রভু বলেন, “আমি তোমাকে উপদেশ দেব এবং উপযুক্ত পথে চলতে তোমাকে শিক্ষা দেবো;","poem":1},{"text":"তোমার উপর প্রেমময় দৃষ্টি রেখে আমি তোমাকে পরামর্শ দেবো।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তোমরা ঘোড়া বা খচ্চরের মতো হোয়ো না,","poem":1},{"text":"যাদের বোধশক্তি নেই","poem":2},{"text":"কিন্তু যাদের বল্গা ও লাগাম দিয়ে বশে রাখতে হয়,","poem":1},{"text":"নইলে তারা তোমার কাছে আসে না।”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"দুষ্টের অনেক দুর্দশা হয়,","poem":1},{"text":"কিন্তু সদাপ্রভুর অবিচল প্রেম","poem":2},{"lineBreak":true},{"text":"সেই ব্যক্তিকে ঘিরে রাখে যে তাঁর উপর নির্ভর করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"হে ধার্মিক, সদাপ্রভুতে আনন্দ করো ও উল্লাস করো;","poem":1},{"text":"তোমরা যারা অন্তরে ন্যায়পরায়ণ, আনন্দধ্বনি করো।","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"সম্ভবত সাহিত্য অথবা সংগীতের প্রতিশব্দ","reference":{"chapter":32,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/33.json","nextChapterAudioLinks":{},"previousC