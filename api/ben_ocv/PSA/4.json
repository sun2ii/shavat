{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["দাউদের গীত। প্রধান পরিচালকের জন্য। তারের যন্ত্র।"]},{"type":"verse","number":1,"content":[{"text":"হে আমার ধার্মিক ঈশ্বর,","poem":1},{"text":"আমি ডাকলে আমাকে উত্তর দিয়ো।","poem":2},{"text":"সংকটে আমায় অব্যাহতি দিয়ো;","poem":1},{"text":"আমার প্রতি দয়া করো ও আমার প্রার্থনা শোনো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"হে মানুষেরা, কত কাল আমার সম্মান অপমানে পরিণত করবে?","poem":1},{"text":"আর কত কাল তোমরা অলীকতা ভালোবাসবে ও ভুয়ো দেবতার","poem":2},{"noteId":2},{"text":"সন্ধান করবে","poem":2}]},{"type":"verse","number":3,"content":[{"text":"জানো যে সদাপ্রভু তাঁর বিশ্বস্ত ভক্তদের নিজের জন্য পৃথক করে রেখেছেন;","poem":1},{"text":"আমি ডাকলেই সদাপ্রভু আমার কথা শোনেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"কম্পিত হও কিন্তু","poem":1},{"noteId":3},{"text":"পাপ কোরো না;","poem":1},{"text":"যখন নিজের বিছানায় শুয়ে থাকো,","poem":2},{"lineBreak":true},{"text":"নিজের হৃদয় অনুসন্ধান করো ও নীরব থাকো।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ধার্মিকতার বলি উৎসর্গ করো","poem":1},{"text":"এবং সদাপ্রভুতে বিশ্বাস করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"সদাপ্রভু, অনেকে প্রশ্ন করছে, “কে আমাদের উন্নতি ঘটাবে?”","poem":1},{"text":"তোমার মুখের জ্যোতি আমাদের উপর উজ্জ্বল হোক।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তাদের ফসল ও নতুন দ্রাক্ষারসের প্রাচুর্য থেকেও","poem":1},{"text":"তুমি আমার হৃদয় আনন্দে পূর্ণ করেছ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"শান্তিতে আমি শুয়ে থাকব ও ঘুমাব,","poem":1},{"text":"কারণ একমাত্র তুমিই, হে সদাপ্রভু,","poem":2},{"lineBreak":true},{"text":"আমায় নিরাপদে বসবাস করতে দিয়েছ।","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"অথবা মিথ্যার সন্ধান করবে","reference":{"chapter":4,"verse":2}},{"noteId":3,"caller":"+","text":"অথবা ক্রোধে","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/ben_ocv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}