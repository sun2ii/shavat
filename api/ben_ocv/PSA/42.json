,{"text":"এক শোভাযাত্রাকে ঈশ্বরের গৃহের দিকে এগিয়ে নিয়ে যেতাম।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"হে আমার প্রাণ, কেন তুমি অবসন্ন?","poem":1},{"text":"কেন তুমি অন্তরে এত হতাশ?","poem":2},{"text":"ঈশ্বরে তুমি আশা রাখো,","poem":1},{"text":"কারণ আমি আবার তাঁর প্রশংসা করব","poem":2},{"lineBreak":true},{"text":"যিনি আমার পরিত্রাতা ও আমার ঈশ্বর।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আমার প্রাণ আমার অন্তরে অবসন্ন;","poem":1},{"text":"কিন্তু জর্ডনের দেশ থেকে,","poem":2},{"text":"হর্মোণের উচ্চতা—মিৎসিয়র পর্বত থেকে,","poem":1},{"text":"আমি তোমাকে স্মরণ করব।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তোমার জলপ্রপাতের গর্জনে","poem":1},{"text":"অতল অতলকে ডাকে;","poem":2},{"text":"তোমার সমস্ত ঢেউ ও তরঙ্গ","poem":1},{"text":"আমার উপর দিয়ে বয়ে গেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কিন্তু সদাপ্রভু প্রতিদিন তাঁর অবিচল প্রেম আমার উপর ঢেলে দেন,","poem":1},{"text":"এবং প্রত্যেক রাত্রে আমি তাঁর গান করি,","poem":2},{"lineBreak":true},{"text":"ও ঈশ্বরের কাছে প্রার্থনা করি যিনি আমাকে জীবন দেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"আমার শৈল ঈশ্বরকে আমি বলি,","poem":1},{"text":"“কেন তুমি আমায় ভুলে গিয়েছ?","poem":2},{"text":"কেন আমি আমার শত্রুর অত্যাচারে","poem":1},{"text":"বিষণ্ণ মনে এদিক-ওদিক ঘুরে বেড়াব?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"যখন আমার বিপক্ষ আমাকে ব্যঙ্গ করে","poem":1},{"text":"আমার হাড়গোড় সব চূর্ণ হয়","poem":2},{"text":"তারা সারাদিন আমাকে অবজ্ঞা করে বলে,","poem":1},{"text":"“তোমার ঈশ্বর কোথায়?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"হে আমার প্রাণ, কেন তুমি অবসন্ন?","poem":1},{"text":"কেন তুমি অন্তরে এত হতাশ?","poem":2},{"text":"ঈশ্বরে তুমি আশা রাখো,","poem":1},{"text":"কারণ আমি আবার তাঁর প্রশংসা করব","poem":2},{"lineBreak":true},{"text":"যিনি আমার পরিত্রাতা ও আমার ঈশ্বর।","poem":2}]}],"footnotes":[