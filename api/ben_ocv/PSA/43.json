{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বর, আমাকে নির্দোষ ঘোষণা করো,","poem":1},{"text":"এক অবিশ্বস্ত জাতির বিরুদ্ধে,","poem":2},{"lineBreak":true},{"text":"আমার পক্ষসমর্থন করো।","poem":2},{"text":"যারা ছলনাকারী ও দুর্নীতিপরায়ণ","poem":1},{"text":"তাদের হাত থেকে আমাকে উদ্ধার করো।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তুমিই আমার ঈশ্বর, আমার আশ্রয় দুর্গ,","poem":1},{"text":"কেন তুমি আমাকে পরিত্যাগ করেছ?","poem":2},{"text":"কেন আমি আমার শত্রুর অত্যাচারে","poem":1},{"text":"বিষণ্ণ মনে এদিক-ওদিক ঘুরে বেড়াব?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তোমার জ্যোতি ও তোমার সত্য আমার কাছে পাঠাও,","poem":1},{"text":"তারা আমাকে পথ দেখাক;","poem":2},{"text":"তারা তোমার পবিত্র পর্বতে আমাকে নিয়ে যাক","poem":1},{"text":"সেই স্থানে যেখানে তুমি বসবাস করো।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তখন আমি ঈশ্বরের বেদির কাছে যাব,","poem":1},{"text":"ঈশ্বরের সান্নিধ্যে—যিনি আমার সব আনন্দের উৎস।","poem":2},{"text":"হে ঈশ্বর, আমার ঈশ্বর","poem":1},{"text":"সুরবাহারের ঝংকারে আমি তোমার স্তুতি করব।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"হে আমার প্রাণ, কেন তুমি অবসন্ন?","poem":1},{"text":"কেন তুমি অন্তরে এত হতাশ?","poem":2},{"text":"ঈশ্বরে তুমি আশা রাখো,","poem":1},{"text":"কারণ আমি আবার তাঁর প্রশংসা করব","poem":2},{"lineBreak":true},{"text":"যিনি আমার পরিত্রাতা ও আমার ঈশ্বর।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}