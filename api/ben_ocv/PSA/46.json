{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। কোরহ বংশের সন্তানদের গীত। অলামোৎ",{"noteId":25},"অনুসারে।"]},{"type":"verse","number":1,"content":[{"text":"ঈশ্বর আমাদের আশ্রয় ও বল,","poem":1},{"text":"সংকটকালে সদা উপস্থিত সহায়।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"অতএব আমরা ভয় করব না, যদিও পৃথিবী কম্পিত হয়","poem":1},{"text":"এবং সমুদ্রের বুকে পর্বতসকল পতিত হয়,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"যদিও সমুদ্র গর্জন করে ও প্রচণ্ড হয়,","poem":1},{"text":"এবং উথাল জলে পর্বতসকল কেঁপে উঠে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"এক নদী আছে যার জলস্রোত ঈশ্বরের নগরীকে,","poem":1},{"text":"পরাৎপরের আবাসের পবিত্র স্থানকে আনন্দিত করে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ঈশ্বর সেই নগরীর মধ্যে আছেন, তার পতন হবে না;","poem":1},{"text":"দিনের শুরুতেই ঈশ্বর তাকে সাহায্য করবেন।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"জাতিরা বিশৃঙ্খলতায় পূর্ণ এবং তাদের রাজ্যগুলি পতিত হয়;","poem":1},{"text":"ঈশ্বরের কণ্ঠস্বর গর্জন করে এবং পৃথিবী গলে যায়!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"সর্বশক্তিমান সদাপ্রভু আমাদের সঙ্গে আছেন;","poem":1},{"text":"যাকোবের ঈশ্বর আমাদের উচ্চদুর্গ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"এসো এবং দেখো, সদাপ্রভু কী করেন,","poem":1},{"text":"দেখো, কীভাবে তিনি এই জগতে ধ্বংস নিয়ে আসেন।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তিনি পৃথিবীর প্রান্ত পর্যন্ত","poem":1},{"text":"যুদ্ধ বন্ধ করেন।","poem":2},{"text":"তিনি ধনুক ভেঙে দেন ও বর্শা চূর্ণ করেন;","poem":1},{"text":"তিনি ঢালগুলি আগুনে পুড়িয়ে দেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তিনি বলেন, “শান্ত হও, আর জানো, আমিই ঈশ্বর;","poem":1},{"text":"সমস্ত জাতিতে আমি মহিমান্বিত হব,","poem":2},{"lineBreak":true},{"text":"সমস্ত পৃথিবীতে আমি মহিমান্বিত হব।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"সর্বশক্তিমান সদাপ্রভু আমাদের সঙ্গে আছেন;","poem":1},{"text":"যাকোবের ঈশ্বর আমাদের উচ্চদুর্গ।","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"সম্ভবত সংগীতের একটি প্রতিশব্দ","reference":{"chapter":46,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}