{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। দাউদের মস্কীল",{"noteId":28},"। যখন ইদোমীয় দোয়েগ শৌলের কাছে গিয়ে বলেছিল: “দাউদ অহীমেলকের গৃহে গিয়েছে।”"]},{"type":"verse","number":1,"content":[{"text":"ওহে মহাবীর, কেন তুমি অপকর্মের দম্ভ করো?","poem":1},{"text":"কেন তুমি সারাদিন দম্ভ করো,","poem":2},{"lineBreak":true},{"text":"তুমি যে ঈশ্বরের চোখে এক অবজ্ঞার বস্তু?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তুমি মিথ্যা কথা বলতে দক্ষ,","poem":1},{"text":"তোমার জিভ ধ্বংসের পরিকল্পনা করে;","poem":2},{"lineBreak":true},{"text":"এবং তা ধারালো ক্ষুরের মতো।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তুমি ভালোর চেয়ে মন্দ,","poem":1},{"text":"আর সত্য বলার চেয়ে মিথ্যা বলতে বেশি ভালোবাসো।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তুমি মিথ্যাবাদী!","poem":1},{"text":"তোমার বাক্য দিয়ে তুমি অপরকে বিনাশ করতে ভালোবাসো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"নিশ্চয় ঈশ্বর তোমাকে চিরকালীন ধ্বংসে অবনত করবেন:","poem":1},{"text":"তিনি তোমাকে ছিনিয়ে নিয়ে তোমার তাঁবু থেকে উপড়ে ফেলবেন;","poem":2},{"lineBreak":true},{"text":"আর তোমাকে জীবিতদের দেশ থেকে নির্মূল করবেন।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ধার্মিকেরা এসব দেখবে ও ভীত হবে;","poem":1},{"text":"তারা তোমায় পরিহাস করবে, আর বলবে,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“এই যে সেই লোক,","poem":1},{"text":"যে কখনও ঈশ্বরকে নিজের আশ্রয় দুর্গ করেনি,","poem":2},{"text":"কিন্তু নিজের মহা ঐশ্বর্যে আস্থা রেখেছে,","poem":1},{"text":"এবং অপরদের ধ্বংস করে নিজে শক্তিশালী হয়েছে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কিন্তু আমি, ঈশ্বরের গৃহে,","poem":1},{"text":"উদীয়মান জলপাই গাছের মতো;","poem":2},{"text":"যুগ যুগান্ত ধরে","poem":1},{"text":"ঈশ্বরের অবিচল প্রেমে আস্থা রাখি।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তুমি যা কিছু করেছ, তার জন্য আমি,","poem":1},{"text":"তোমার বিশ্বস্ত প্রজাদের সামনে, সর্বদা তোমার ধন্যবাদ করব।","poem":2},{"text":"এবং আমি তোমার নামে আশা রাখব","poem":1},{"text":"কারণ তোমার নাম মঙ্গলময়।","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"সম্ভবত সাহিত্য অথবা সংগীতের প্রতিশব্দ","reference":{"chapter":52,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}