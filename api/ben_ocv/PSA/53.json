rue},{"text":"তারা আমার ভক্তদের রুটি খাওয়ার মতো গ্রাস করে;","poem":1},{"text":"ঈশ্বরের কাছে তারা কখনও সাহায্য প্রার্থনা করে না।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"নিদারুণ আতঙ্কে তারা বিহ্বল হয়েছে,","poem":1},{"text":"এমন আতঙ্ক যা তারা আগে জানেনি।","poem":2},{"text":"ঈশ্বর তোমার শত্রুদের হাড়গোড় চারিদিকে ছড়িয়ে দেবেন।","poem":1},{"text":"তুমি তাদের লজ্জিত করবে কারণ ঈশ্বর তাদের প্রত্যাখ্যান করেছেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আহা, ইস্রায়েলের পরিত্রাণ আসবে সিয়োন থেকে!","poem":1},{"text":"যখন ঈশ্বর তাঁর ভক্তজনদের পুনরুদ্ধার করবেন,","poem":2},{"lineBreak":true},{"text":"তখন যাকোব উল্লসিত হবে আর ইস্রায়েল আনন্দ করবে।","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"সম্ভবত সংগীতের প্রতিশব্দ","reference":{"chapter":53,"verse":0}},{"noteId":30,"caller":"+","text":"সম্ভবত সাহিত্যের অথবা সংগীতের প্রতিশব্দ","reference":{"chapter":53,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}