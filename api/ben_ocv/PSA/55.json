{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। তারযন্ত্র সহযোগে দাউদের মস্কীল",{"noteId":32},"।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বর, আমার প্রার্থনা শোনো,","poem":1},{"text":"আমার নিবেদন উপেক্ষা কোরো না;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"আমার কথা শোনো আর আমাকে উত্তর দাও।","poem":2},{"text":"আমার ভাবনা আমাকে কষ্ট দেয় আর আমি ক্ষিপ্ত হয়েছি কারণ","poem":1}]},{"type":"verse","number":3,"content":[{"text":"আমার শত্রুরা আমার প্রতি চিৎকার করে,","poem":2},{"lineBreak":true},{"text":"উচ্চস্বরে অন্যায় হুমকি দেয়।","poem":2},{"text":"তারা আমার উপর কষ্ট নিয়ে আসে","poem":1},{"text":"আর রাগে আমার পশ্চাদ্ধাবন করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"আমার হৃদয় দুঃখে জর্জরিত;","poem":1},{"text":"মৃত্যুর সন্ত্রাস আমার উপর এসে পড়েছে।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ভয় আর কাঁপুনি আমাকে আচ্ছন্ন করেছে;","poem":1},{"text":"আতঙ্ক আমাকে অভিভূত করেছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"আমি বলি, “হ্যাঁ! যদি আমার ঘুঘুর মতো ডানা থাকত!","poem":1},{"text":"আমি উড়ে চলে যেতাম আর বিশ্রাম পেতাম।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমি দূরে চলে যেতাম","poem":1},{"text":"আর মরুভূমিতে বসবাস করতাম।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"প্রচণ্ড বায়ু আর ঝড় থেকে,","poem":1},{"text":"আমার আশ্রয়স্থানে তাড়াতাড়ি চলে যেতাম।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"হে সদাপ্রভু, দুষ্টদের বিহ্বল করো, তাদের বাক্য হতবুদ্ধি করো,","poem":1},{"text":"কেননা আমি নগরে হিংসা আর শত্রুতা দেখি।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"দিনরাত তারা প্রাচীরের উপর দিয়ে নগর প্রদক্ষিণ করে;","poem":1},{"text":"আক্রোশ আর অবমাননা তার মধ্যে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"বিধ্বংসী শক্তি নগরের মধ্যে কাজ করে চলেছে;","poem":1},{"text":"হুমকি আর মিথ্যা কখনও তার রাস্তা ছেড়ে যায় না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"যদি কোনও শত্রু আমাকে অপমান করত,","poem":1},{"text":"তা আমি সহ্য করতে পারতাম;","poem":2},{"text":"যদি কোনও বিপক্ষ আমার বিরোধিতা করত,","poem":1},{"text":"আমি তা লুকাতে পারতাম;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"কিন্তু এত তুমিই, আমার সমকক্ষ মানুষ,","poem":1},{"text":"আমার সঙ্গী, আমার ঘনিষ্ঠ বন্ধু,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"যার সঙ্গে, ঈশ্বরের গৃহে,","poem":1},{"text":"একদিন আমি মধুর সহভাগিতা উপভোগ করেছি,","poem":2},{"text":"উপাসকদের মধ্যে","poem":1},{"text":"আমরা হেঁটে বেড়িয়েছি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"মৃত্যু আমার শত্রুদের বিস্মিত করুক;","poem":1},{"text":"তারা জীবিত অবস্থায় পাতালের গর্ভে নেমে যাক,","poem":2},{"lineBreak":true},{"text":"কারণ অন্যায় তাদের গৃহে ও তাদের অন্তরে আছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"কিন্তু আমি ঈশ্বরকে ডাকব,","poem":1},{"text":"এবং সদাপ্রভু আমাকে রক্ষা করেন।","poem":2}]},{"type":"verse","number":17,"content":[{"text":"সন্ধ্যা, সকাল আর দুপুরে,","poem":1},{"text":"আমি আমার যন্ত্রণায় কাঁদি,","poem":2},{"lineBreak":true},{"text":"আর তিনি আমার কণ্ঠস্বর শোনেন।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"আমার বিরুদ্ধে যে যুদ্ধ শুরু হয়েছে তা থেকে","poem":1},{"text":"তিনি আমাকে অক্ষত অবস্থায় মুক্ত করেন,","poem":2},{"lineBreak":true},{"text":"যদিও অনেকে এখনও আমার বিরোধিতা করে।","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ঈশ্বর, যিনি পূর্বকাল থেকে শাসন করেন,","poem":1},{"text":"যার কোনও পরিবর্তন নেই,","poem":2},{"text":"তিনি তাদের কথা শুনবেন আর তাদের নম্র করবেন,","poem":1},{"text":"কারণ তাদের ঈশ্বরভয় নেই।","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"আমার সঙ্গী তার বন্ধুদের আক্রমণ করে;","poem":1},{"text":"সে তার নিয়ম ভঙ্গ করে।","poem":2}]},{"type":"verse","number":21,"content":[{"text":"মাখনের মতো তার কথা মসৃণ,","poem":1},{"text":"কিন্তু তার হৃদয়ে রয়েছে যুদ্ধ;","poem":2},{"text":"তার কথা তেলের চেয়েও মনোরম,","poem":1},{"text":"কিন্তু সে সকল উন্মুক্ত তরোয়ালের মতো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"সদাপ্রভুতে নিজের ভার অর্পণ করো","poem":1},{"text":"আর তিনি তোমাকে বাঁচিয়ে রাখবেন;","poem":2},{"text":"তিনি কখনও ধার্মিকদের","poem":1},{"text":"বিচলিত হতে দেবেন না।","poem":2}]},{"type":"verse","number":23,"content":[{"text":"কিন্তু তুমি, হে ঈশ্বর, দুষ্টদের পতনের গর্তে","poem":1},{"text":"নামিয়ে দেবে;","poem":2},{"text":"যারা রক্তপিপাসু আর প্রতারক","poem":1},{"text":"জীবনের অর্ধেক দিনও তারা বাঁচবে না।","poem":2},{"lineBreak":true},{"text":"কিন্তু আমি তোমাতে আস্থা রাখি।","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"সম্ভবত সাহিত্য অথবা সংগীতের প্রতিশব্দ","reference":{"chapter":55,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/56.json","nextChapterAudioLinks":{},"pr