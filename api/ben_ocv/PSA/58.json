{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। দাউদের মিকতাম",{"noteId":35},"। সুর “ধ্বংস কোরো না।”"]},{"type":"verse","number":1,"content":[{"text":"শাসকেরা, তোমরা কি সত্যিই ন্যায্যভাবে কথা বলো?","poem":1},{"text":"তোমরা কি সমতার সঙ্গে লোকেদের বিচার করো?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"না, তোমাদের হৃদয়ে তোমরা অন্যায় পরিকল্পনা করো,","poem":1},{"text":"আর তোমাদের হাত দিয়ে তোমরা পৃথিবীতে হিংসা ছড়াও।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"জন্ম থেকেই দুষ্টরা বিপথে যায়;","poem":1},{"text":"মাতৃগর্ভ থেকেই তারা বিপথগামী ও মিথ্যাবাদী।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"সাপের বিষের মতোই তাদের বিষ,","poem":1},{"text":"ওরা কালসাপের মতো, যা শুনতে চায় না,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"এবং সাপুড়েদের সুর উপেক্ষা করে","poem":1},{"text":"যতই তারা দক্ষতার সঙ্গে বাজাক না কেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"হে ঈশ্বর, তাদের মুখের দাঁতগুলি ভেঙে দাও;","poem":1},{"text":"হে সদাপ্রভু, সেই সিংহদের বিষদাঁত উপড়ে ফেলো।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"শুকনো জমিতে জলের মতো তারা যেন মিলিয়ে যায়;","poem":1},{"text":"তাদের অস্ত্রশস্ত্র তাদের হাতেই ব্যর্থ করে তোলো।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"পথে চলার সময় তারা যেন শামুকের মতো গলে পাঁকে পরিণত হয়;","poem":1},{"text":"মৃতাবস্থায় জাত শিশুর মতো হোক যে কখনও সূর্যের মুখ দেখেনি।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ঈশ্বর, তরুণ কি প্রবীণ, সবাইকে উড়িয়ে নিয়ে যাবেন","poem":1},{"text":"কাঁটাগাছের আগুনের আঁচ তোমাদের পাত্রের গায়ে লাগার আগেই।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"অন্যায়ের প্রতিকার দেখে ধার্মিকেরা উল্লসিত হবে।","poem":1},{"text":"দুষ্টদের রক্তে তারা তাদের পা ধুয়ে নেবে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তখন সবাই বলবে,","poem":1},{"text":"“ধার্মিকেরা নিশ্চয় পুরস্কার পায়;","poem":2},{"lineBreak":true},{"text":"নিশ্চয় ঈশ্বর আছেন, যিনি জগতের বিচার করেন।”","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"সম্ভবত সাহিত্যের বা সংগীতের একটি প্রতিশব্দ","reference":{"chapter":58,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}