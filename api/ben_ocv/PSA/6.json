{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। আট-তারের যন্ত্র সহযোগে। শমীনীৎ",{"noteId":4},"অনুসারে। দাউদের গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে সদাপ্রভু, রাগে আমায় তিরস্কার কোরো না","poem":1},{"text":"তোমার ক্রোধে আমায় শাসন কোরো না।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমার প্রতি দয়া করো, হে সদাপ্রভু, কারণ আমি দুর্বল;","poem":1},{"text":"আমায় সুস্থ করো, হে সদাপ্রভু, কারণ আমার হাড়গোড় ব্যথায় পূর্ণ।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"আমার প্রাণ গভীর বেদনায় পূর্ণ,","poem":1},{"text":"কত কাল, হে সদাপ্রভু, আর কত কাল?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"হে সদাপ্রভু, আমার দিকে দেখো, ও আমায় রক্ষা করো;","poem":1},{"text":"তোমার অবিচল প্রেমের গুণে আমায় রক্ষা করো।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"মৃতদের মধ্যে কেউ তোমাকে স্মরণ করে না।","poem":1},{"text":"পাতাল থেকে কে তোমার প্রশংসা করে?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"আমি আর্তনাদ করে ক্লান্ত হয়ে পড়েছি।","poem":1},{"lineBreak":true},{"text":"সারারাত ধরে কেঁদে আমি বিছানা ভিজিয়েছি","poem":1},{"text":"এবং চোখের জলে আমার খাট ভিজিয়েছি।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"গভীর দুঃখে আমার দৃষ্টি দুর্বল হয়;","poem":1},{"text":"আমার সব শত্রুদের নির্যাতনে চোখ জীর্ণ হয়।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"তোমরা সবাই যারা অধর্ম করো, আমার কাছ থেকে দূর হও,","poem":1},{"text":"কারণ সদাপ্রভু আমার কান্না শুনেছেন।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সদাপ্রভু আমার বিনতি শুনেছেন;","poem":1},{"text":"সদাপ্রভু আমার প্রার্থনা গ্রহণ করেন।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"আমার সব শত্রু লজ্জিত ও বিহ্বল হবে;","poem":1},{"text":"তারা পিছু ফিরবে এবং হঠাৎ লজ্জিত হবে।","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"অজানা সংগীত জগতের শব্দ","reference":{"chapter":6,"verse":0}}]},"thisChapterLink":"/api/ben_ocv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}