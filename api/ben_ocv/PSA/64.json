{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। দাউদের গীত।"]},{"type":"verse","number":1,"content":[{"text":"আমার কথা শোনো, হে আমার ঈশ্বর, আমার অভিযোগ শোনো;","poem":1},{"text":"শত্রুর হুমকি থেকে আমার জীবন রক্ষা করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"দুষ্টদের ষড়যন্ত্র থেকে আর অনিষ্টকারীদের চক্রান্ত থেকে,","poem":1},{"text":"আমার জীবনকে লুকিয়ে রাখো।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তারা তরোয়ালের মতো নিজেদের জিভে ধার দিয়েছে","poem":1},{"text":"আর বিষাক্ত তিরের মতো নির্মম বাক্য দিয়ে তাদের লক্ষ্যস্থির করেছে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তারা আড়াল থেকে নির্দোষ মানুষের উপর তির ছোঁড়ে;","poem":1},{"text":"হঠাৎ তির ছোঁড়ে, ভয় করে না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তারা একে অপরকে কুটিল মন্ত্রণায় প্ররোচিত করে,","poem":1},{"text":"এবং কীভাবে গোপনে ফাঁদ পাতা যায় তার সংকল্প করে;","poem":2},{"lineBreak":true},{"text":"তারা বলে, “কে এটি দেখবে?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তারা অন্যায় ষড়যন্ত্র করে আর বলে,","poem":1},{"text":"“আমরা এক নিখুঁত পরিকল্পনা করেছি!”","poem":2},{"lineBreak":true},{"text":"নিশ্চয়, মানুষের মন ও হৃদয় ধূর্ত!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"কিন্তু ঈশ্বর তাঁর তির তাদের দিকে নিক্ষেপ করবেন,","poem":1},{"text":"হঠাৎ আঘাতে তারা ভূপতিত হবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"তিনি তাদের জিভ তাদের বিরুদ্ধেই চালনা করবেন","poem":1},{"text":"এবং তাদের ধ্বংস করবেন;","poem":2},{"lineBreak":true},{"text":"তাদের এই দশা দেখে সকলে উপহাসে মাথা নাড়াবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সব মানুষ ভীত হবে;","poem":1},{"text":"তারা ঈশ্বরের ক্রিয়াকলাপ ঘোষণা করবে","poem":2},{"lineBreak":true},{"text":"এবং তাঁর কর্মসকলে মনোনিবেশ করবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ধার্মিক সদাপ্রভুতে আনন্দ করবে","poem":1},{"text":"ও তাঁতে শরণ নেবে;","poem":2},{"lineBreak":true},{"text":"যারা হৃদয়ে ন্যায়পরায়ণ তারা তাঁর জয়গান করবে।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}