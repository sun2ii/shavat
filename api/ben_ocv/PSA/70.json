{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। দাউদের গীত। একটি নিবেদন।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বর, আমাকে তাড়াতাড়ি উদ্ধার করো!","poem":1},{"text":"হে সদাপ্রভু, তুমি তাড়াতাড়ি এসো আর আমাকে সাহায্য করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"যারা আমার প্রাণনাশের চেষ্টা করে,","poem":1},{"text":"তারা যেন লজ্জিত ও অপমানিত হয়;","poem":2},{"text":"যারা আমার ধ্বংস কামনা করে","poem":1},{"text":"তারা যেন লাঞ্ছনায় পিছু ফিরে যায়।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"যারা আমাকে বলে, “হা! হা!”","poem":1},{"text":"তারা যেন লজ্জায় পিছু ফিরে যায়।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কিন্তু যারা তোমার অন্বেষণ করে তারা","poem":1},{"text":"তোমাতে আনন্দ করুক ও খুশি হোক;","poem":2},{"text":"যারা তোমার পরিত্রাণ ভালোবাসে তারা সর্বদা বলুক,","poem":1},{"text":"“সদাপ্রভু মহান!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"কিন্তু আমি দরিদ্র ও অভাবী;","poem":1},{"text":"হে ঈশ্বর, আমাকে সাহায্য করতে তাড়াতাড়ি এসো,","poem":2},{"text":"তুমিই আমার সহায় এবং আমার মুক্তিদাতা,","poem":1},{"text":"হে সদাপ্রভু, দেরি কোরো না।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}