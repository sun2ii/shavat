{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। সুর: “ধ্বংস কোরো না।” আসফের গীত। একটি সংগীত।"]},{"type":"verse","number":1,"content":[{"text":"হে ঈশ্বর, আমরা তোমার প্রশংসা করি,","poem":1},{"text":"আমরা তোমার প্রশংসা করি, কারণ তুমি নিকটবর্তী;","poem":2},{"lineBreak":true},{"text":"লোকেরা তোমার আশ্চর্য ক্রিয়াকলাপ বর্ণনা করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ঈশ্বর বলেন, “আমার নির্ধারিত সময়ে","poem":1},{"text":"আমি ন্যায়বিচার করব।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"যখন পৃথিবী কাঁপে এবং সব মানুষ অশান্তিতে বাঁচে,","poem":1},{"text":"আমি তার সব স্তম্ভ সুদৃঢ় রাখি।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"আমি দাম্ভিককে সতর্ক করি, ‘অহংকার কোরো না,’","poem":1},{"text":"দুষ্টকে বলি, ‘তোমার শিং উঁচু কোরো না।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"স্বর্গের বিরুদ্ধে তোমার শিং উঁচু কোরো না;","poem":1},{"text":"এত উদ্ধতভাবে কথা বোলো না।’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"কেউ, পূর্ব বা পশ্চিম থেকে,","poem":1},{"text":"অথবা মরুভূমি থেকে, নিজেকে উন্নত করতে পারে না।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ঈশ্বর একমাত্র বিচার করেন:","poem":1},{"text":"তিনি কাউকে নত করেন বা কাউকে উন্নীত করেন।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"সদাপ্রভুর হাতে এক পানপাত্র আছে,","poem":1},{"text":"যা মশলা মিশ্রিত ফেনিয়ে ওঠা সুরাতে পূর্ণ;","poem":2},{"text":"তিনি তা ঢেলে দেন, আর পৃথিবীর সমস্ত দুষ্টলোক","poem":1},{"text":"পাত্রের তলানি পর্যন্ত পান করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"কিন্তু আমি একথা চিরকাল ঘোষণা করে যাব;","poem":1},{"text":"যাকোবের ঈশ্বরের উদ্দেশে স্তুতিগান করব।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"কারণ ঈশ্বর বলেন, “আমি সব দুষ্টের শক্তি চূর্ণ করব,","poem":1},{"text":"কিন্তু আমি ধার্মিকদের শক্তিবৃদ্ধি করব।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}