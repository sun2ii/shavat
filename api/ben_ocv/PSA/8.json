ে, তার তুমি যত্ন করো?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"তুমি তাদের","poem":1},{"noteId":9},{"text":"স্বর্গদূতদের","poem":1},{"noteId":10},{"text":"চেয়ে সামান্য ছোটো করেছ","poem":1},{"text":"এবং তাদের","poem":2},{"noteId":11},{"text":"গৌরব ও সম্মানের মুকুটে ভূষিত করেছ।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমার হাতের সকল সৃষ্টির উপর তাদের কর্তৃত্ব দিয়েছ;","poem":1},{"text":"এসব কিছু তাদের","poem":2},{"noteId":12},{"text":"পায়ের নিচে রেখেছ:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"সব মেষপাল ও গোপাল,","poem":1},{"text":"ও যত বন্যপশু;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আকাশের যত পাখি,","poem":1},{"text":"সমুদ্রের যত মাছ,","poem":2},{"lineBreak":true},{"text":"যা সমুদ্র প্রবাহে সাঁতার কাটে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"হে সদাপ্রভু, আমাদের প্রভু,","poem":1},{"text":"সমস্ত পৃথিবীতে তোমার নাম মহিমান্বিত!","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"সম্ভবত সংগীতের প্রতিশব্দ","reference":{"chapter":8,"verse":0}},{"noteId":9,"caller":"+","text":"অথবা তাকে","reference":{"chapter":8,"verse":5}},{"noteId":10,"caller":"+","text":"অথবা ঈশ্বরের চেয়ে","reference":{"chapter":8,"verse":5}},{"noteId":11,"caller":"+","text":"অথবা তাকে","reference":{"chapter":8,"verse":5}},{"noteId":12,"caller":"+","text":"অথবা তাকে কর্তৃত্ব দিয়েছ; তার","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/ben_ocv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}