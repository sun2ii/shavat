]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“আমি বলি, ‘তোমরা “ঈশ্বর”","poem":1},{"text":"তোমরা সবাই পরাৎপরের সন্তান।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"কিন্তু সামান্য মানুষের মতো তোমাদের মৃত্যু হবে;","poem":1},{"text":"অন্যান্য সব শাসকের মতো তোমাদেরও পতন হবে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ওঠো, হে ঈশ্বর, এই জগতের বিচার করো,","poem":1},{"text":"কারণ সমস্ত জাতি তোমার উত্তরাধিকার।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}