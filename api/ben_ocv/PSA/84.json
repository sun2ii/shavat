{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["সংগীত পরিচালকের জন্য। স্বর, গিত্তীৎ",{"noteId":43},"। কোরহ বংশের সন্তানদের একটি গীত।"]},{"type":"verse","number":1,"content":[{"text":"হে সর্বশক্তিমান সদাপ্রভু,","poem":1},{"text":"তোমার আবাস কত মনোরম!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমার প্রাণ সদাপ্রভুর প্রাঙ্গণের জন্য আকুল হয়,","poem":1},{"text":"এমনকি মূর্চ্ছিতপ্রায় হয়;","poem":2},{"text":"জীবন্ত ঈশ্বরের জন্য","poem":1},{"text":"আমার হৃদয় আর আমার দেহ কেঁদে ওঠে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"এমনকি চড়ুইপাখিও আশ্রয় খুঁজে পেয়েছে,","poem":1},{"text":"দোয়েল নিজের জন্য বাসা পেয়েছে,","poem":2},{"lineBreak":true},{"text":"যেখানে সে তার শাবকদের জন্ম দিতে পারে—","poem":2},{"text":"এমন স্থান, যা তোমার বেদির নিকটে,","poem":1},{"text":"হে সদাপ্রভু, আমার রাজা, আমার ঈশ্বর।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ধন্য সেই ব্যক্তি, যে তোমার গৃহে বসবাস করে,","poem":1},{"text":"সে সর্বক্ষণ তোমার গুণকীর্তন করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ধন্য সেই ব্যক্তি, যার শক্তি সদাপ্রভু থেকে আসে,","poem":1},{"text":"যে সদাপ্রভুর গৃহে যাওয়ার জন্য তার হৃদয় স্থির রেখেছে।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যখন তারা অশ্রুর","poem":1},{"noteId":44},{"text":"উপত্যকার মধ্য দিয়ে যায়,","poem":1},{"text":"তারা সেই স্থান জলধারায় পরিণত করে;","poem":2},{"lineBreak":true},{"text":"প্রথম বৃষ্টি","poem":2},{"noteId":45},{"text":"সেই প্রান্তরকে আশীর্বাদে আবৃত করে।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তারা ক্রমাগত শক্তিশালী হয়ে উঠবে,","poem":1},{"text":"এবং সিয়োনে ঈশ্বরের সামনে প্রত্যেকে হাজির হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"হে সর্বশক্তিমান সদাপ্রভু, আমার প্রার্থনা শোনো;","poem":1},{"text":"হে যাকোবের ঈশ্বর, আমার কথা শোনো।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"দেখো, হে ঈশ্বর, আমাদের ঢাল;","poem":1},{"text":"তোমার অভিষিক্ত-জনের প্রতি অনুগ্রহের দৃষ্টিতে দেখো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"তোমার প্রাঙ্গণে একদিন","poem":1},{"text":"অন্যত্র হাজার দিনের চেয়েও শ্রেয়;","poem":2},{"text":"দুষ্টদের তাঁবুতে বাস করার থেকে","poem":1},{"text":"আমি আমার ঈশ্বরের গৃহের দ্বাররক্ষী হয়ে থাকতে চাই।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"কারণ সদাপ্রভু ঈশ্বর ঢাল ও সূর্যের মতো;","poem":1},{"text":"তিনি দয়া ও সম্মান দান করেন;","poem":2},{"text":"যাদের চলার পথ সিদ্ধ","poem":1},{"text":"তাদের তিনি কোনো প্রকার মঙ্গল থেকে বঞ্চিত করেন না।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"হে সর্বশক্তিমান সদাপ্রভু,","poem":1},{"text":"ধন্য সেই ব্যক্তি যে তোমার উপর আস্থা রাখে।","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"সম্ভবত সংগীতের প্রতিশব্দ","reference":{"chapter":84,"verse":0}},{"noteId":44,"caller":"+","text":"হিব্রু ভাষায় বাকা উপত্যকা","reference":{"chapter":84,"verse":6}},{"noteId":45,"caller"