2}]},{"type":"verse","number":7,"content":[{"text":"যে যদিও দুষ্টরা ঘাসের মতো গজিয়ে ওঠে","poem":1},{"text":"আর সব অনিষ্টকারী বৃদ্ধি পায়,","poem":2},{"lineBreak":true},{"text":"তারা চিরকালের জন্য ধ্বংস হবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"কিন্তু তুমি, হে সদাপ্রভু, চিরকালের জন্য মহিমান্বিত।","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"হে সদাপ্রভু, নিশ্চয় আমাদের শত্রুরা","poem":1},{"text":"নিশ্চয়ই আমাদের শত্রুরা বিনষ্ট হবে;","poem":2},{"lineBreak":true},{"text":"সব অনিষ্টকারী ছিন্নভিন্ন হবে।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"তুমি আমার শিং","poem":1},{"noteId":51},{"text":"বন্য ষাঁড়ের মতো উন্নীত করেছ;","poem":1},{"text":"খাঁটি তেল আমার মাথায় ঢেলে দিয়েছ।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"আমার চোখ আমার প্রতিপক্ষদের পরাজয় দেখেছে;","poem":1},{"text":"আমার কান আমার দুষ্ট বিপক্ষদের পতনের কথা শুনেছে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ধার্মিক তাল গাছের মতো সমৃদ্ধ হবে,","poem":1},{"text":"লেবাননের দেবদারু গাছের মতো তারা বৃদ্ধি পাবে;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"যাদের সদাপ্রভুর গৃহে লাগানো হয়েছে,","poem":1},{"text":"তারা আমাদের ঈশ্বরের প্রাঙ্গণে সমৃদ্ধ হয়ে উঠবে।","poem":2}]},{"type":"verse","number":14,"content":[{"text":"বৃদ্ধ বয়সেও তারা ফল প্রদান করবে,","poem":1},{"text":"তারা সতেজ ও সবুজ হয়ে রইবে,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"এই প্রচার করবে, “সদাপ্রভু ন্যায়পরায়ণ;","poem":1},{"text":"তিনি আমার শৈল এবং তাতে কোনও অন্যায় নেই।”","poem":2}]}],"footnotes":[{"noteId":51,"caller":"+","text":"শিং এখানে শক্তির অর্থ বহনকারী","reference":{"chapter":92,"verse":10}}]},"thisChapterLink":"/api/ben_ocv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}