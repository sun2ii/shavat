{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভু রাজত্ব করেন, তিনি মহিমায় সজ্জিত;","poem":1},{"text":"সদাপ্রভু গৌরবে আবৃত ও পরাক্রমে সজ্জিত;","poem":2},{"lineBreak":true},{"text":"সত্যিই, এই পৃথিবী প্রতিষ্ঠিত, সুদৃঢ় ও সুরক্ষিত।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তোমার সিংহাসন প্রাচীনকাল থেকে বিদ্যমান;","poem":1},{"text":"তুমি স্বয়ং অনন্তকাল থেকে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"হে সদাপ্রভু, সমুদ্রেরা উঠেছে,","poem":1},{"text":"সমুদ্রেরা তাদের আওয়াজ তুলেছে;","poem":2},{"lineBreak":true},{"text":"সমুদ্রেরা তাদের উত্তাল ঢেউ তুলেছে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"মহাজলধির গর্জন থেকেও,","poem":1},{"text":"সমুদ্রের উত্তাল ঢেউ থেকেও","poem":2},{"lineBreak":true},{"text":"উচ্চে অবস্থিত সদাপ্রভু বলবান।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"হে সদাপ্রভু, তোমার বিধিবিধান, সুদৃঢ়;","poem":1},{"text":"অনন্তকাল ধরে","poem":2},{"lineBreak":true},{"text":"পবিত্রতাই তোমার গৃহের শোভা।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}