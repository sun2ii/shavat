"number":7,"content":[{"text":"যারা সবাই প্রতিমার আরাধনা করে,","poem":1},{"text":"যারা মূর্তিতে গর্ব করে, তারা লজ্জিত হয়;","poem":2},{"lineBreak":true},{"text":"দেবতারা সবাই, তোমরা সদাপ্রভুর আরাধনা করো।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"তোমার বিচার হে সদাপ্রভু,","poem":1},{"text":"সিয়োন শোনে আর আনন্দিত হয়","poem":2},{"lineBreak":true},{"text":"আর যিহূদার সকল গ্রাম উল্লসিত হয়।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"কারণ, হে সদাপ্রভু, তুমি সমস্ত জগতের ঊর্ধ্বে পরাৎপর;","poem":1},{"text":"সব দেবতার ঊর্ধ্বে তুমি মহিমান্বিত।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"যারা সদাপ্রভুকে ভালোবাসে তারা অধর্মকে ঘৃণা করুক,","poem":1},{"text":"কারণ তিনি তাঁর বিশ্বস্তজনেদের প্রাণরক্ষা করেন,","poem":2},{"lineBreak":true},{"text":"এবং দুষ্টদের কবল থেকে তাদের উদ্ধার করেন।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ধার্মিকের জন্য আলো","poem":1},{"text":"আর হৃদয়ে ন্যায়পরায়ণের জন্য আনন্দ, উদিত হয়।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তোমরা যারা ধার্মিক, সদাপ্রভুতে আনন্দ করো,","poem":1},{"text":"আর তাঁর পবিত্র নামের প্রশংসা করো।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}