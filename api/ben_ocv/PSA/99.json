{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"PSA","translationId":"ben_ocv","name":"গীত","commonName":"গীত","title":"গীতসংহিতা","order":19,"numberOfChapters":150,"sha256":"45734f058be15aab45c148849c3e90c6912dcbbd5aa957110d3d635fe5acd45f","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ben_ocv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"সদাপ্রভু রাজত্ব করেন,","poem":1},{"text":"জাতিরা কম্পিত হোক;","poem":2},{"text":"করূবের মাঝে তিনি সিংহাসনে অধিষ্ঠিত,","poem":1},{"text":"পৃথিবী কেঁপে উঠুক।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"সদাপ্রভু সিয়োনে মহান;","poem":1},{"text":"সব জাতির ঊর্ধ্বে তিনি উন্নীত।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তারা তোমার মহান ও ভয়াবহ নামের প্রশংসা করুক—","poem":1},{"text":"তিনি পবিত্র।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"রাজা শক্তিশালী, তিনি ন্যায় ভালোবাসেন—","poem":1},{"text":"তুমি ন্যায় প্রতিষ্ঠা করেছ;","poem":2},{"text":"তুমি যাকোবের মধ্যে ন্যায় ও ধার্মিকতা","poem":1},{"text":"প্রতিষ্ঠা করেছ।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"সদাপ্রভু আমাদের ঈশ্বরের গৌরব করো,","poem":1},{"text":"তাঁর পাদপীঠে আরাধনা করো;","poem":2},{"lineBreak":true},{"text":"তিনি পবিত্র।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"মোশি ও হারোণ তাঁর যাজকদের মধ্যে ছিলেন,","poem":1},{"text":"শমূয়েল তাঁদের মধ্যে একজন ছিলেন যাঁরা সদাপ্রভুর নামে ডাকতেন","poem":2},{"text":"তাঁরা সদাপ্রভুর কাছে সাহায্যের প্রার্থনা করতেন,","poem":1},{"text":"এবং তিনি তাঁদের উত্তর দিতেন।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"তিনি মেঘস্তম্ভের আড়াল থেকে তাঁদের উদ্দেশে কথা বলতেন,","poem":1},{"text":"তিনি যে বিধিবিধান এবং আদেশ তাঁদের দিয়েছিলেন সেসব তাঁরা মেনে চলতেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"হে সদাপ্রভু, আমাদের ঈশ্বর,","poem":1},{"text":"তুমি তাঁদের উত্তর দিয়েছিলে;","poem":2},{"text":"যদিও তুমি তাঁদের দুষ্কর্মের শাস্তি দিয়েছিলে,","poem":1},{"text":"ইস্রায়েলের প্রতি তুমি ক্ষমাশীল ঈশ্বর।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"আমাদের ঈশ্বর সদাপ্রভুকে মহিমান্বিত করো","poem":1},{"text":"এবং তাঁর পবিত্র পর্বতে আরাধনা করো,","poem":2},{"lineBreak":true},{"text":"কারণ আমাদের ঈশ্বর সদাপ্রভু, পবিত্র।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}