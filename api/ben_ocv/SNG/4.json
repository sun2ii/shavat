{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"SNG","translationId":"ben_ocv","name":"পরমগীত","commonName":"পরমগীত","title":"পরমগীত","order":22,"numberOfChapters":8,"sha256":"90c67dd5c66c0a9eefe25e07cb1b233879dda6033903d0ee29df4c749c635b0b","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ben_ocv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"প্রিয়তমা আমার, অপূর্ব সুন্দরী তুমি!","poem":1},{"text":"আহা, কী অপরূপ তুমি!","poem":2},{"lineBreak":true},{"text":"তোমার ঘোমটার আড়ালে তোমার দুটি চোখ কপোতের মতো।","poem":2},{"text":"তোমার কেশরাশি একপাল ছাগলের মতো,","poem":1},{"text":"যারা গিলিয়দ পর্বতের ঢাল বেয়ে নেমে আসে।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"তোমার দন্তপঙক্তি যেন সদ্য পশম ছাঁটা মেষপালের মতো,","poem":1},{"text":"যাদের সদ্য ধৌত করা হয়েছে,","poem":2},{"text":"ওরা কেউ একা নয়,","poem":1},{"text":"প্রত্যেকের সঙ্গে তার যমজ শাবক রয়েছে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তোমার ওষ্ঠাধর রক্তিম ফিতের মতো;","poem":1},{"text":"তোমার মুখশ্রী চমৎকার।","poem":2},{"text":"ঘোমটা আবৃত তোমার কপোল","poem":1},{"text":"অর্ধ কর্তিত ডালিম ফলের মতো।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"তোমার গলা দাউদের দুর্গের মতো,","poem":1},{"text":"অসামান্য সুষমামণ্ডিত যার পাথরের নির্মাণসৌকর্য,","poem":2},{"text":"যার উপরে টাঙানো থাকে এক হাজার ঢাল,","poem":1},{"text":"যেগুলির প্রত্যেকটি যোদ্ধাদের ঢাল।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"তোমার দুটি স্তন যেন দুটি হরিণশাবক,","poem":1},{"text":"যেন গজলা হরিণীর যমজ শাবক,","poem":2},{"lineBreak":true},{"text":"যারা লিলি ফুলে ভরা মাঠে নেচে বেড়ায়।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"বেলা শেষ হওয়ার আগে","poem":1},{"text":"এবং ছায়া মুছে যাওয়ার আগে","poem":2},{"text":"আমি গন্ধরসের পর্বতে","poem":1},{"text":"এবং কুন্দুরুর পাহাড়ে যাব।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"আমার প্রিয়া, সর্বাঙ্গ সুন্দরী তুমি;","poem":1},{"text":"তোমাতে কোনও খুঁত নেই।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ও আমার বধূ লেবানন ছেড়ে আমার সঙ্গে চলো,","poem":1},{"text":"লেবানন ছেড়ে আমার সঙ্গে চলো।","poem":2},{"text":"অমানার শৃঙ্গ থেকে, শনীর চূড়া থেকে, হর্মোণের শীর্ষদেশ থেকে,","poem":1},{"lineBreak":true},{"text":"সিংহদের গুহা থেকে","poem":1},{"text":"এবং পর্বতে বাসা বাঁধা চিতাবাঘদের আস্তানা থেকে অবতরণ করো।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"তুমি আমার হৃদয় হরণ করেছ, মম ভগিনী, মম বধূ;","poem":1},{"text":"তোমার এক মুহূর্তের চাহনি,","poem":2},{"text":"তোমার জড়োয়ার একটিমাত্র","poem":1},{"text":"রত্ন আমার হৃদয় হরণ করেছে।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"কী মধুর তোমার প্রেম, মম ভগিনী, মম বধূ!","poem":1},{"text":"তোমার প্রেম সুরার চেয়েও এবং তোমার সুগন্ধির সৌরভ","poem":2},{"text":"যে কোনও সুগন্ধি মশলার চেয়েও","poem":1},{"text":"কত বেশি আনন্দদায়ক!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ওগো মোর বধূ, তোমার ওষ্ঠাধর থেকে মৌচাকের মতো মধু ঝরে পড়ে,","poem":1},{"text":"তোমার জিহ্বার নিচে দুধ ও মধু আছে।","poem":2},{"text":"তোমার পোশাকের","poem":1},{"text":"সুবাস লেবাননের মতো।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"মম ভগিনী, মম বধূ, তুমি অর্গলবদ্ধ এক বাগিচা;","poem":1},{"text":"এক মুদ্রাঙ্কিত, অবরুদ্ধ ঝরনা।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তোমার চারাগাছগুলি ডালিমের উপবন,","poem":1},{"text":"যেখানে আছে উৎকৃষ্ট ফল,","poem":2},{"lineBreak":true},{"text":"আছে মেহেদি ও জটামাংসী","poem":2}]},{"type":"verse","number":14,"content":[{"text":"জটামাংসী আর জাফরান, বচ,","poem":1},{"text":"দারুচিনি ও সর্বপ্রকার সুগন্ধি ধুনোর গাছ,","poem":2},{"lineBreak":true},{"text":"আছে গন্ধরস,","poem":2},{"lineBreak":true},{"text":"অগুরু ও উৎকৃষ্ট মশলার গাছ।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"তুমি বাগিচায় ঘেরা এক ঝরনা,","poem":1},{"text":"প্রবাহিত জলের এক উৎস,","poem":2},{"lineBreak":true},{"text":"যার স্রোত সেই লেবানন থেকে বইছে।","poem":2}]},{"type":"verse","number":16,"content":[{"text":"জাগো, হে উত্তুরে বায়ু,","poem":1},{"text":"এসো হে দখিনা বাতাস!","poem":2},{"text":"বয়ে যাও আমার এই বাগিচায়,","poem":1},{"text":"যাতে এর সৌরভ চারদিকে ছড়িয়ে যায়।","poem":2},{"text":"আমার প্রেমিককে আসতে দাও তাঁর আপন বাগিচায়","poem":1},{"text":"এবং তাঁর পছন্দসই ফলের স্বাদ গ্রহণ করতে দাও।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}