{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"SNG","translationId":"ben_ocv","name":"পরমগীত","commonName":"পরমগীত","title":"পরমগীত","order":22,"numberOfChapters":8,"sha256":"90c67dd5c66c0a9eefe25e07cb1b233879dda6033903d0ee29df4c749c635b0b","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ben_ocv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"হে পরমাসুন্দরী, তোমার প্রেমিক","poem":1},{"text":"কোথায় চলে গেছেন?","poem":2},{"text":"তোমার প্রেমিক কোনও দিকে গেছেন, তোমার সঙ্গে আমরাও","poem":1},{"text":"তো তাঁকে সেখানে খুঁজতে যেতে পারি?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমার প্রেমিক তাঁর বাগানে,","poem":1},{"text":"সুগন্ধি মশলার কেয়ারিতে নেমে গেছেন,","poem":2},{"text":"বাগানগুলিতে পদচারণা করতে","poem":1},{"text":"আর লিলি ফুল চয়ন করতে।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"আমি আমার প্রেমিকের এবং আমার প্রেমিক আমারই;","poem":1},{"text":"তিনি লিলিফুলের বাগিচায় পদচারণা করেন।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ওগো মোর প্রিয়া, তুমি তির্সার মতো রূপসী,","poem":1},{"text":"জেরুশালেমের মতো লাবণ্যময়,","poem":2},{"lineBreak":true},{"text":"পতাকাবাহী সেনাবাহিনীর মতো জমকালো।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"আমার দিক থেকে তোমার দুই নয়ন সরাও;","poem":1},{"text":"ওরা আমাকে বিহ্বল করে দেয়;","poem":2},{"text":"তোমার কেশরাশি এমন ছাগপালের মতো,","poem":1},{"text":"যারা গিলিয়দের ঢাল বেয়ে নেমে আসে","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমার দন্তপঙক্তি যেন একপাল মেষ,","poem":1},{"text":"যাদের সদ্য ধৌত করা হয়েছে,","poem":2},{"text":"ওরা কেউ একা নয়,","poem":1},{"text":"প্রত্যেকের সঙ্গে রয়েছে তার যমজ শাবক।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ঘোমটায় আবৃত তোমার কপোল","poem":1},{"text":"অর্ধ কর্তিত ডালিম ফলের মতো।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"রানি সম্ভবত ষাটজন,","poem":1},{"text":"আর উপপত্নী আশি জন,","poem":2},{"lineBreak":true},{"text":"আর কুমারীর সংখ্যা অগণ্য;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"কিন্তু আমার কবুতর, আমার নিখুঁত প্রিয়া অনন্যা, সে তাঁর মায়ের একমাত্র দুহিতা,","poem":1},{"text":"তাঁর জন্মদাত্রীর প্রিয়পাত্রী। কুমারীরা তাঁকে দেখে ধন্যা বলে সম্বোধন করেছে;","poem":2},{"lineBreak":true},{"text":"রানি ও উপপত্নীরা তাঁর প্রশংসা করেছে।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"উনি কে, যিনি ভোরের আলোর মতো আবির্ভূত হচ্ছেন,","poem":1},{"text":"যিনি চন্দ্রের মতো শুভ্র, সূর্যের মতো উজ্জ্বল,","poem":2},{"lineBreak":true},{"text":"নক্ষত্রদের শোভাযাত্রার মতো ঐশ্বর্যময়?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"আমি আখরোটের বাগিচায় নেমে গেছিলাম দেখতে যে,","poem":1},{"text":"উপত্যকায় নবীন কোনও তরু অঙ্কুরিত হল কি না,","poem":2},{"text":"দ্রাক্ষালতা কতটা কুঁড়ি হল","poem":1},{"text":"কিংবা ডালিম গাছে ফুল এল কি না।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"বিষয়টি ভালো করে বোঝার আগেই","poem":1},{"text":"আমার বাসনা আমাকে বসিয়ে দিল আমার জাতির রাজকীয় রথরাজির মধ্যে।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ফিরে এসো, ফিরে এসো, হে শূলম্মীয়ে; ফিরে এসো,","poem":1},{"text":"ফিরে এসো, যাতে আমরা অপলকে তোমাকে দেখতে পাই।","poem":2},"প্রেমিক",{"text":"মহনয়িমের নৃত্যের মতো করে তোমরা কেন","poem":1},{"text":"শূলম্মীয়েকে অপলকে দেখতে চাইছ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}