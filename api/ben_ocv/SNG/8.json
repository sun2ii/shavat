{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"SNG","translationId":"ben_ocv","name":"পরমগীত","commonName":"পরমগীত","title":"পরমগীত","order":22,"numberOfChapters":8,"sha256":"90c67dd5c66c0a9eefe25e07cb1b233879dda6033903d0ee29df4c749c635b0b","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ben_ocv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"তুমি যদি আমার মায়ের স্তন্যপান করা হতে","poem":1},{"text":"আমার সহোদর ভাইয়ের মতো!","poem":2},{"text":"তাহলে তোমাকে ঘরের বাইরে দেখতে পেলে,","poem":1},{"text":"আমি তোমাকে চুম্বন করতাম,","poem":2},{"lineBreak":true},{"text":"তখন আর কেউ আমাকে তুচ্ছতাচ্ছিল্য করতে পারত না।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"আমি তোমাকে পথ দেখাতাম","poem":1},{"text":"আর নিয়ে যেতাম","poem":2},{"text":"আমার মায়ের ঘরে—","poem":1},{"text":"যে মা আমার শিক্ষাদাত্রী।","poem":2},{"text":"আমি তোমাকে পান করার জন্য সুগন্ধি মশলা মিশ্রিত সুরা দিতাম,","poem":1},{"text":"দিতাম আমার ডালিম ফলের নির্যাস।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"তাঁর বাম বাহু আমার মস্তকের নিচে,","poem":1},{"text":"আর তাঁর ডান বাহু আমাকে আলিঙ্গন করে।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"জেরুশালেমের কন্যারা, আমি তোমাদের দিব্যি দিয়ে বলছি,","poem":1},{"text":"যতক্ষণ না বাসনা জেগে উঠছে,","poem":2},{"lineBreak":true},{"text":"ততক্ষণ প্রেমকে জাগিও না বা তাকে উত্তেজিত কোরো না।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"মরুপ্রান্তর পার হয়ে আপন প্রেমিকার কাঁধে মাথা রেখে ওই কে আসে?","poem":1},"প্রেমিকা",{"text":"যেখানে তোমার মা তোমাকে প্রসব করেছিলেন","poem":1},{"text":"সেই আপেল গাছের তলায় আমি","poem":2},{"lineBreak":true},{"text":"তোমাকে জাগালাম; ওখানে","poem":2},{"lineBreak":true},{"text":"তোমার মা তোমার জন্মকালীন প্রসববেদনা সয়েছিলেন।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"তোমার হৃদয়ে আমাকে অভিজ্ঞানস্বরূপ করে রাখো,","poem":1},{"text":"তোমার বাহুর উপরে আমাকে অভিজ্ঞানস্বরূপ করে রাখো;","poem":2},{"text":"কেননা প্রেম মৃত্যুর মতোই শক্তিশালী,","poem":1},{"text":"এর অর্ন্তজ্বালা কবরের মতো নিষ্ঠুর সত্য।","poem":2},{"text":"এ যেন এক জ্বলন্ত আগুন,","poem":1},{"text":"এক লেলিহান আগুনের শিখা।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"অজস্র জলও প্রেমের তৃষ্ণা মিটাতে পারে না;","poem":1},{"text":"নদীরাও তাকে মুছে দিতে পারে না।","poem":2},{"text":"কেউ যদি প্রেমের বিনিময়ে","poem":1},{"text":"তাঁর ঘরের যাবতীয় ধনসম্পদ দিয়ে দেয়,","poem":2},{"lineBreak":true},{"text":"তবে তা ধিক্কারজনক হবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আমাদের একটি অল্পবয়সি বোন আছে,","poem":1},{"text":"তার বক্ষদেশ এখনও প্রস্ফুটিত হয়নি।","poem":2},{"text":"আমাদের এই বোনটির জন্য আমরা কী যে করি,","poem":1},{"text":"কারণ একদিন তো তাকে সর্বসমক্ষে তার কথা বলতে হবে?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সে যদি প্রাচীরস্বরূপা হয়,","poem":1},{"text":"তাহলে আমরা তার উপরে রুপোর মিনার নির্মাণ করব,","poem":2},{"text":"সে যদি দুয়ারস্বরূপা হয়,","poem":1},{"text":"তাহলে আমরা সিডার কাঠ দিয়ে তার ভিত্তিমূলকে ঘিরে দেব।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"আমি প্রাচীরস্বরূপা","poem":1},{"text":"এবং আমার দুটি স্তন গম্বুজের মতো।","poem":2},{"text":"এভাবেই আমি তাঁর চোখে","poem":1},{"text":"পরম তৃপ্তিদায়ক হয়ে উঠলাম।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"বায়াল-হামনে শলোমনের এক দ্রাক্ষাক্ষেত্র ছিল;","poem":1},{"text":"যা তিনি তার ভাগচাষিদের চাষ করতে দিয়েছেন।","poem":2},{"text":"এর ফলের জন্য তাদের মাথাপিছু","poem":1},{"text":"দিতে হবে এক সহস্র রৌপ্যমুদ্রা।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"কিন্তু আমার নিজের দ্রাক্ষাকুঞ্জ দিতে পারি শুধু আমিই;","poem":1},{"text":"হে শলোমন, এই 1,000 শেকল রৌপ্যমুদ্রা","poem":2},{"noteId":0},{"text":"তোমার জন্য,","poem":2},{"lineBreak":true},{"text":"আর আমার দ্রাক্ষাকুঞ্জের উৎপাদিত ফলের পরিচর্যাকারী কৃষকেরা পাবে মাথাপিছু","poem":2},{"lineBreak":true},{"text":"200 শেকল","poem":2},{"noteId":1},{"text":"রৌপ্যমুদ্রা।","poem":2}]},{"type":"verse","number":13,"content":[{"text":"প্রতীক্ষারত বন্ধুদের নিয়ে","poem":1},{"text":"ওগো কাননচারিনী,","poem":2},{"lineBreak":true},{"text":"তোমার কণ্ঠস্বর আমাকে শুনতে দাও!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ওগো মোর প্রেমিক, চলে এসো,","poem":1},{"text":"এবং সুগন্ধি মশলায় ছেয়ে","poem":2},{"text":"যাওয়া পর্বতমালায় বিচরণরত হরিণী","poem":1},{"text":"কিংবা হরিণশাবক সদৃশ হও।","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"অর্থাৎ, প্রায় 12 কিলোগ্রাম; 12 পদের ক্ষেত্রেও একই কথা প্রযোজ্য","reference":{"chapter":8,"verse":12}},{"noteId":1,"caller":"+","text":"অর্থাৎ, প্রায় 2.3 কিলোগ্রাম","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/ben_ocv/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}