{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ZEC","translationId":"ben_ocv","name":"সখরিয়","commonName":"সখরিয়","title":"সখরিয়","order":38,"numberOfChapters":14,"sha256":"b23c1b08d24e09e960d3fca7aee6d3b7cd9445a111f07cdcc60eebbdd28479bd","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ben_ocv/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["সদাপ্রভু যিহূদার যত্ন নেবেন"]},{"type":"verse","number":1,"content":[{"text":"বসন্তকালে সদাপ্রভুর কাছে বর্ষা চাও;","poem":1},{"text":"সদাপ্রভুই ঝড়ের মেঘ তৈরি করেন।","poem":2},{"text":"তিনি লোকদের প্রচুর বৃষ্টি দেন,","poem":1},{"text":"আর সকলের ক্ষেতে উদ্ভিদ জন্মান।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"প্রতিমাগুলি ছলনার কথা বলে,","poem":1},{"text":"গণকেরা মিথ্যা দর্শন দেখে;","poem":2},{"text":"তারা যে স্বপ্নের কথা বলে তা মিথ্যা,","poem":1},{"text":"তারা বৃথাই সান্ত্বনা দেয়।","poem":2},{"text":"সেইজন্য লোকেরা মেষপালের মতো ঘুরে বেড়ায়","poem":1},{"text":"মেষপালকের অভাবে তারা অত্যাচারিত।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“পালকদের বিরুদ্ধে আমার ক্রোধ জ্বলে উঠছে,","poem":1},{"text":"এবং আমি নেতাদের শাস্তি দেব;","poem":2},{"text":"কারণ সার্বভৌম সদাপ্রভু যত্ন নেন","poem":1},{"text":"তাঁর পালের, যিহূদা কুলের,","poem":2},{"lineBreak":true},{"text":"এবং তাদের যুদ্ধের অহংকারী ঘোড়ার মতো করব।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"কারণ যিহূদা থেকে আসবে কোণার পাথর,","poem":1},{"text":"তাঁর থেকে আসবে তাঁবু-খুটা,","poem":2},{"lineBreak":true},{"text":"তাঁর থেকে আসবে যুদ্ধের ধনুক,","poem":2},{"lineBreak":true},{"text":"তাঁর থেকে আসবে প্রত্যেক শাসনকর্তা।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"একসঙ্গে তারা হবে যুদ্ধের যোদ্ধাদের মতো","poem":1},{"text":"যারা কাদা ভরা রাস্তায় শত্রুদের পায়ে মাড়াবে।","poem":2},{"text":"তারা যুদ্ধ করবে কারণ সদাপ্রভু তাদের সঙ্গে আছেন,","poem":1},{"text":"তারা শত্রুর অশ্বারোহীদের লজ্জিত করবে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“আমি যিহূদা কুলকে শক্তিশালী করব","poem":1},{"text":"আর যোষেফ-কুলকে রক্ষা করব।","poem":2},{"text":"আমি তাদের ফিরিয়ে আনব","poem":1},{"text":"কেননা তাদের প্রতি আমার করুণা আছে।","poem":2},{"text":"তারা এমন হবে যেন","poem":1},{"text":"আমি তাদের অগ্রাহ্য করিনি।","poem":2},{"text":"কারণ আমি সদাপ্রভু তাদের ঈশ্বর","poem":1},{"text":"এবং আমি তাদের উত্তর দেব।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ইফ্রয়িমীয়েরা যোদ্ধাদের মতো হবে,","poem":1},{"text":"দ্রাক্ষারস পান করার মতো তাদের অন্তর খুশি হবে।","poem":2},{"text":"তা দেখে তাদের সন্তানেরা আনন্দিত হবে;","poem":1},{"text":"তাদের অন্তর সদাপ্রভুতে আনন্দ করবে।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"আমি তাদের সংকেত দেব","poem":1},{"text":"এবং তাদের একসঙ্গে জড়ো করব।","poem":2},{"text":"তাদের আমি নিশ্চয়ই মুক্ত করব;","poem":1},{"text":"তারা আগের মতোই সংখ্যায় অনেক হবে।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"আমি যদিও তাদের লোকদের মধ্যে ছড়িয়ে দেব,","poem":1},{"text":"তবুও দূরদেশে তারা আমাকে মনে করবে।","poem":2},{"text":"তারা ও তাদের সন্তানেরা বেঁচে থাকবে,","poem":1},{"text":"এবং তারা ফিরে আসবে।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"মিশর দেশ থেকে আমি তাদের ফিরিয়ে নিয়ে আসব","poem":1},{"text":"এবং আসিরিয়া থেকে তাদের একত্র করব।","poem":2},{"text":"আমি তাদের গিলিয়দ ও লেবাননে নিয়ে আসব,","poem":1},{"text":"এবং সেখানে তাদের জায়গা কুলাবে না।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"তারা কষ্টের-সাগরের মধ্যে দিয়ে যাবে;","poem":1},{"text":"সাগরের ঢেউকে দমন করা হবে","poem":2},{"lineBreak":true},{"text":"এবং নীলনদের সমস্ত গভীর জায়গা শুকিয়ে যাবে।","poem":2},{"text":"আসিরিয়ার অহংকার ভেঙে দেওয়া হবে","poem":1},{"text":"এবং মিশরের রাজদণ্ড দূর হয়ে যাবে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"আমি তাদের সদাপ্রভুতে শক্তিশালী করব","poem":1},{"text":"এবং তাঁর নামে তারা নিরাপদে বাস করবে,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু এই কথা ঘোষণা করেন।","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}