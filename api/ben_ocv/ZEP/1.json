{"translation":{"id":"ben_ocv","name":"Biblica® মুক্তভাবে বাংলা সমকালীন সংস্করণের","website":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=benobcv","licenseNotes":null,"shortName":"OCV","englishName":"Open Bengali Contemporary Version Bible","language":"ben","textDirection":"ltr","sha256":"04d1a6ff0dd177a2fb75d2f095c7d17a8738e23c14942530aa5181f032473ce4","availableFormats":["json"],"listOfBooksApiLink":"/api/ben_ocv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"বাংলা","languageEnglishName":"Bangla"},"book":{"id":"ZEP","translationId":"ben_ocv","name":"সফনিয়","commonName":"সফনিয়","title":"সফনিয়","order":36,"numberOfChapters":3,"sha256":"028731218245654f727c6db2bd00d3dd53a6129bee9a5d1ce0ab9f23c5786087","firstChapterNumber":1,"firstChapterApiLink":"/api/ben_ocv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ben_ocv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["যিহূদার রাজা, আমোনের পুত্র যোশিয়ের রাজত্বকালে সদাপ্রভুর বাক্য কূশির পুত্র সফনিয়ের কাছে আসে, কূশি গদলিয়ের পুত্র, গদলিয় অমরিয়ের পুত্র, অমরিয় হিষ্কিয়ের পুত্র:"]},{"type":"line_break"},{"type":"heading","content":["সদাপ্রভুর বিচারের দিন"]},{"type":"verse","number":2,"content":[{"text":"“আমি পৃথিবীর বুক থেকে সবকিছু","poem":1},{"text":"নষ্ট করে দেব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু বলেন।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“আমি মানুষ এবং পশু উভয়কেই নষ্ট করে দেব;","poem":1},{"text":"আকাশের পাখিদেরকেও আমি নষ্ট করে দেব","poem":2},{"lineBreak":true},{"text":"আর সমুদ্রের মাছেদের—","poem":2},{"lineBreak":true},{"text":"আর যে মূর্তিরা দুষ্টদের হোঁচট করাবে।”","poem":2},{"lineBreak":true},{"text":"“তখন পৃথিবীর বুক থেকে","poem":1},{"text":"সমগ্র মানবজাতিকে আমি ধ্বংস করব,”","poem":2},{"lineBreak":true},{"text":"সদাপ্রভু বলেন,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“আমি যিহূদার বিরুদ্ধে আমার হাত উঠাব","poem":1},{"text":"আর জেরুশালেমবাসীদের বিরুদ্ধেও।","poem":2},{"text":"আমি এই দেশ থেকে অবশিষ্ট বায়াল-দেবতার প্রতিমা","poem":1},{"text":"এবং সমস্ত পৌত্তলিক পুরোহিতদের নাম ধ্বংস করে দেব—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"যারা ছাদের উপর উঠে","poem":1},{"text":"আকাশ-বাহিনীর উপাসনা করে,","poem":2},{"text":"যারা সদাপ্রভুর নামে নত হয়ে প্রতিশ্রুতি নেয়","poem":1},{"text":"এবং মালাকামের নামেও শপথ করে,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"যারা সদাপ্রভুকে অনুসরণ করা ছেড়ে দিয়েছে","poem":1},{"text":"না তারা সদাপ্রভুকে অন্বেষণ করে, না তাঁর অনুসন্ধান করে।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"সার্বভৌম সদাপ্রভুর সামনে নীরব হও,","poem":1},{"text":"কারণ সদাপ্রভুর দিন সন্নিকট।","poem":2},{"text":"সদাপ্রভু একটি উৎসর্গের আয়োজন করেছেন;","poem":1},{"text":"তিনি নিমন্ত্রিত জনদের শুচিশুদ্ধ করেছেন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“সদাপ্রভুর সেই বলিদানের দিনে","poem":1},{"text":"আমি কর্মকর্তাদের","poem":2},{"lineBreak":true},{"text":"রাজপুত্রদের","poem":2},{"text":"এবং যারা বিদেশি রীতিনীতি মানে","poem":1},{"text":"তাদের শাস্তি দেব।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"সেদিন আমি তাদের শাস্তি দেব","poem":1},{"text":"যারা পরজাতিদের দেবতাদের উপাসনায় সম্মিলিত হয়,","poem":2},{"text":"যারা নিজের দেবতার মন্দির","poem":1},{"text":"অত্যাচার আর ছলনার দ্বারা লুন্ঠিত দ্রব্যে পূর্ণ করে।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“সেদিনে,”","poem":1},{"text":"সদাপ্রভু বলেন,","poem":2},{"text":"“মাছ-ফটকের থেকে কান্নার শব্দ,","poem":1},{"text":"নগরের নতুন অংশ থেকে বিলাপের ধ্বনি,","poem":2},{"lineBreak":true},{"text":"এবং পাহাড়ের চারদিক সশব্দে ভেঙে পড়ার আওয়াজ শোনা যাবে।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"হে ব্যবসাকেন্দ্রের বসবাসকারীরা তোমরা বিলাপ করো,","poem":1},{"text":"কারণ তোমাদের সমস্ত বণিকেরা নিশ্চিহ্ন হয়ে যাবে,","poem":2},{"lineBreak":true},{"text":"যারা রুপোর ব্যবসায়ী, তারাও বিনষ্ট হবে।","poem":2}]},{"type":"verse","number":12,"content":[{"text":"তখন আমি বাতি নিয়ে জেরুশালেমেতে অন্বেষণ করব","poem":1},{"text":"যারা সন্তুষ্ট থাকে তাদের শাস্তি দেব,","poem":2},{"lineBreak":true},{"text":"যারা দ্রাক্ষারসের তলানির মতো,","poem":2},{"text":"আর ‘যারা মনে করে সদাপ্রভু কিছুই করবেন না,","poem":1},{"text":"ভালো বা মন্দ।’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"তাদের ধনসম্পত্তি লুট করা হবে,","poem":1},{"text":"তাদের ঘরগুলি ধ্বংস করা হবে।","poem":2},{"text":"তারা নতুন ঘর নির্মাণ করলেও,","poem":1},{"text":"তাতে তারা বসবাস করতে পারবে না;","poem":2},{"text":"তারা দ্রাক্ষালতা লাগালেও,","poem":1},{"text":"তার রস পান করতে পারবে না।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"সদাপ্রভুর মহান বিচারের দিন নিকটে—","poem":1},{"text":"সন্নিকট আর শীঘ্রই আসছে।","poem":2},{"text":"সদাপ্রভুর সেদিনে ক্রন্দনের শব্দ খুবই তিক্ত;","poem":1},{"text":"যুদ্ধে বীর যোদ্ধারা যন্ত্রণায় কাতর।","poem":2}]},{"type":"verse","number":15,"content":[{"text":"সেদিন হবে ক্রোধের দিন—","poem":1},{"text":"ভীষণ দুর্দশা ও কষ্টের দিন,","poem":2},{"text":"ধ্বংস এবং বিনাশের দিন,","poem":3},{"text":"দিন ঘন অন্ধকারের,","poem":2},{"text":"কালো মেঘাচ্ছন্ন দিন—","poem":3}]},{"type":"verse","number":16,"content":[{"text":"চারদিকে ঘেরা নগরের বিরুদ্ধে","poem":2},{"text":"আর কোণের সব উঁচু জায়গায় পাহারা এবং ঘরের বিরুদ্ধে","poem":1},{"text":"শিঙার রব ও যুদ্ধের হাঁকের দিন।","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“আমি সমস্ত লোকেদের উপর এমন বিপত্তি আনব","poem":1},{"text":"ফলে তারা অন্ধ লোকের মতো হাঁটবে,","poem":2},{"lineBreak":true},{"text":"কারণ তারা সদাপ্রভুর বিরুদ্ধে পাপ করেছে।","poem":2},{"text":"তাদের রক্ত ধুলোর মতো ফেলা হবে","poem":1},{"text":"আর দেহ গোবরের মতো পড়ে থাকবে।","poem":2}]},{"type":"verse","number":18,"content":[{"text":"সদাপ্রভুর ক্রোধের দিনে","poem":1},{"text":"তাদের রুপো বা তাদের সোনা","poem":2},{"lineBreak":true},{"text":"কোনো কিছুই তাদের বাঁচাতে পারবে না।”","poem":2},{"lineBreak":true},{"text":"তার অগ্নিময় ক্রোধে","poem":1},{"text":"সমগ্র পৃথিবী পুড়ে যাবে,","poem":2},{"text":"তিনি জগতে বসবাসকারী সকলকে","poem":1},{"text":"হঠাৎ নষ্ট করে দেবেন।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ben_ocv/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ben_ocv/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ben_ocv/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}