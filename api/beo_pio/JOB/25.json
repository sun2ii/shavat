{"translation":{"id":"beo_pio","name":"GODE EA SIA: IDA:IWANE GALA","website":"https://ebible.org/Scriptures/details.php?id=beo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=beo","licenseNotes":null,"shortName":"PIO","englishName":"Bedamuni Bible","language":"beo","textDirection":"ltr","sha256":"9b208d27549c517c13df1a38fbfeb3fe42b48f08c2403b5189df00ad0d0048cb","availableFormats":["json"],"listOfBooksApiLink":"/api/beo_pio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30059,"languageName":"Beami","languageEnglishName":"Beami"},"book":{"id":"JOB","translationId":"beo_pio","name":"Yoube","commonName":"Yoube","title":"Yoube","order":18,"numberOfChapters":42,"sha256":"7e3a01fdeb28346fef35ddec6dc5b632c306365da05585e82797c3df578306f6","firstChapterNumber":1,"firstChapterApiLink":"/api/beo_pio/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/beo_pio/JOB/42.json","totalNumberOfVerses":1061},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Bilida:de da amane sia:i,"]},{"type":"verse","number":2,"content":[{"text":"“Gode da gasa bagadedafa!","poem":1},{"text":"Dunu huluanedafa da Ema beda:mu da defea.","poem":2},{"lineBreak":true},{"text":"E da Ea Hebene Hinadafa Hou olofolewane ouligilala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dunu afae da a:igele dunu amo da Ema hawa: hamonana,","poem":1},{"text":"amo idima:ne, dunu afae da defele esalala:? Hame mabu!","poem":2},{"lineBreak":true},{"text":"Soge afae amoga Gode Ea hadigi amoga hame diga:i da ganabela:?","poem":2},{"lineBreak":true},{"text":"Hame mabu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dunu afae da Ea siga ba:ma:ne, moloidafa esalabala? Hame mabu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gode Ea siga ba:ma:ne, oubi amolawane da gugumi gala.","poem":1},{"text":"Amola gasumuni da fofoloi hame ba:sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amaiba:le, E da osobo bagade dunu habodane ba:ma:bela:?","poem":1},{"text":"Dunu da daba: amola sage agoai ba:sa.","poem":2},{"lineBreak":true},{"text":"Gode Ea siga ba:sea, dunu ea esalusu da haboda:i ganabela:?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/beo_pio/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/beo_pio/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/beo_pio/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}