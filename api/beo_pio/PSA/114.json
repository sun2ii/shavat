obo bagade! Hina Gode da mabeba:le, Ya:igobe ea Gode Ea midadi yaguguma."]},{"type":"verse","number":8,"content":[{"noteId":166},"Bai E da igi amo afadenene hano wayabo hamosa, amola magufu adobo amo hano bubuga:su agoane hamosa."]}],"footnotes":[{"noteId":164,"caller":"+","text":"Gadili Asi 12:51","reference":{"chapter":114,"verse":1}},{"noteId":165,"caller":"+","text":"Gadili Asi 14:21; Yosiua 3:16","reference":{"chapter":114,"verse":3}},{"noteId":166,"caller":"+","text":"Gadili Asi 17:1-7; Idisu 20:2-13","reference":{"chapter":114,"verse":8}}]},"thisChapterLink":"/api/beo_pio/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/beo_pio/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/beo_pio/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}