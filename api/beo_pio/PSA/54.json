{"translation":{"id":"beo_pio","name":"GODE EA SIA: IDA:IWANE GALA","website":"https://ebible.org/Scriptures/details.php?id=beo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=beo","licenseNotes":null,"shortName":"PIO","englishName":"Bedamuni Bible","language":"beo","textDirection":"ltr","sha256":"9b208d27549c517c13df1a38fbfeb3fe42b48f08c2403b5189df00ad0d0048cb","availableFormats":["json"],"listOfBooksApiLink":"/api/beo_pio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30059,"languageName":"Beami","languageEnglishName":"Beami"},"book":{"id":"PSA","translationId":"beo_pio","name":"Gesami Hea:su","commonName":"Gesami Hea:su","title":"Gesami Hea:su","order":19,"numberOfChapters":150,"sha256":"66750755ddd2af5d6c6673092c6399c5bb8f63005b1b80b9792a81fe2d229f55","firstChapterNumber":1,"firstChapterApiLink":"/api/beo_pio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/beo_pio/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":54,"content":[{"type":"heading","content":["Gaga:ma:ne Sia:ne Gadosu"]},{"type":"verse","number":1,"content":[{"noteId":49},"Gode! Dia gasa bagade hou amoga na gaga:ma! Dia gasa bagade hou amoga na udigili halegale laloma:ma!"]},{"type":"verse","number":2,"content":["Gode! Na sia:ne gadobe nabima! Na sia:be nabima!"]},{"type":"verse","number":3,"content":["Gasa fi dunu da hidale nama doagala:musa: maha! Dodona:gi dunu, amo da Gode fada:ne hame dawa:su dunu Ilia da na fane legemusa: maha."]},{"type":"verse","number":4,"content":["Be Gode da na Fidisu esala! Hina Gode da na Gaga:sudafa!"]},{"type":"verse","number":5,"content":["Gode da ilila: wadela:i hou amogawane nama ha lai dunu ilima se dabe imunu da defea. E da ili wadela:lesimu. Bai E da Ea fi dunu fisimu hame dawa:."]},{"type":"verse","number":6,"content":["Hina Gode! Na da Dima nodonewane gobele salasu hamomu. Na da Dima nodone sia:mu. Bai Di da noga:idafa."]},{"type":"verse","number":7,"content":["Di da nama bidi hamosu amo huluane gaga:i. Amola na da nama ha lai dunu huluane hasali dagoi ba:i."]}],"footnotes":[{"noteId":49,"caller":"+","text":"1 Sa:miuele 23:19; 26:1","reference":{"chapter":54,"verse":1}}]},"thisChapterLink":"/api/beo_pio/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/beo_pio/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/beo_pio/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}