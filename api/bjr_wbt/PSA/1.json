{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":1,"content":[{"type":"heading","content":["Kuqaa qira asasirafa."]},{"type":"verse","number":1,"content":[{"text":"Manda oosana maree mariasa iriranamau sia","poem":1},{"text":"fimariasa faqa Anutuna ufa rukiee mariasa faqa","poem":2},{"text":"sia moodaanaki kimariasa faqa andeeqara","poem":1},{"text":"oosanara fidiaqaa imariasa faqa sia ooqu maria","poem":2},{"text":"fasiqausa mi manda oosanausara rufiee","poem":1},{"text":"mariasa misa asasiranaki maridaqa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Miqi maria andeeqara fasiqa anaaseesa Anutuna","poem":1},{"text":"sandufamau fuanara asasirana maraidaqa.","poem":2},{"text":"Misa faasaana faqa eendanaki faqa mi sandufana","poem":1},{"text":"asaana rumasee irimaree fidaqa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Miqi maria fasiqa anaaseesa saqari nammari aaqa","poem":1},{"text":"ummaqirafara foora iqa mariasa maridaqa narí","poem":2},{"text":"qanaa mina aqama amiqimmasee iraidanoo","poem":1},{"text":"mina amanee sia kakasidanoo.","poem":2},{"text":"Miqira fasiqa anaasee nana ainainee auqaafanoo","poem":1},{"text":"anoonaikidanoo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Manda oosana maree marisa sia miqidaqa.","poem":1},{"lineBreak":true},{"text":"Misa anaaqmaarara foora ufai uqinoo fuaqaqidanoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaaweena ufa rukiee marisa Anutufa narí ufannai","poem":1},{"text":"rumbannimaqaseenoo narí faiqí anaasee","poem":2},{"text":"mariaqooqari nianai naaduma mara","poem":1},{"text":"quqannisaannoo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaaweefa andeeqarausa nirana mariranasaa","poem":1},{"text":"rakisidanoo itita nimaqaidanoo.","poem":2},{"text":"Manda oosana maree mariasa kuridiranaki maaniki","poem":1},{"text":"fifaranoo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/EST/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}