{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":113,"content":[{"type":"heading","content":["Anutuna andeeqara oosanara amooqia."]},{"type":"verse","number":1,"content":[{"text":"Yaaweena amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Innee Yaaweena ainainira faiqiuqa mina amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Yaaweena auqu amooqiaqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maqee faqa naaru naaru faqa Yaaweena auqu amooqirafa kai mariani.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Suani ururee marinnai mariasa faqa suani keeqee marinnai mariasa faqa aiqamausa Yaaweena auqu amooqimamaqaaqa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mifa Yaaweefa aiqama maa maqa maaqanaki mariasa urinnaaqaranoo maridanoo rakisi nimaqaidanoo, mina qareenarafa innaaruna uriaaqaranoo maridanoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sia moo fannoo Yaaweena maasa Anutuna fooqaafa maridanoo.","poem":1},{"lineBreak":true},{"text":"Mifa meerai innaaruna uraaqaranoo maridanoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miqooqari mifa mara miami innaaruna faqa maqa faqa qafaidanoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaaweefa ainaina siaisa nikuqara madaanai marisa uqeereeqeenoo amiqiraqoo quqannisaidanoo.","poem":1},{"lineBreak":true},{"text":"Mifa sarau imariasa nári aupuraranakinaana uqeerannisaidanoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Uqeeraseenoo misa mareeqee uriqararausa faiqi namu aqoondikamma nimaqaidanoo.","poem":1},{"lineBreak":true},{"text":"Uqeerasaifaqa Yaaweena faiqi anaasee (Isaraee maqannaasa) uriqararausa misa aqoondi kidaqa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aafaikinoo marinna anaaseena Yaaweefa amiqimma amaqaseenoo.","poem":1},{"lineBreak":true},{"text":"Faiqi aanaaqi aranandaki rumasaifanoo minara asasidanoo.","poem":1},{"lineBreak":true},{"text":"Yaaweena amooqiaqa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}