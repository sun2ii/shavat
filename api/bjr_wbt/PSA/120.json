{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":120,"content":[{"type":"heading","content":["Dadaaqiani fee innaaru."]},{"type":"verse","number":1,"content":[{"text":"Qinee manda ummaaraki maridaqa Yaaweena aaraunanoo mifa eedoo qimasee dadaaqinoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oo Yaawee unnaqimariasa faqa ueeqee mariasa faqa nisaukukinaana mareeqee kaqinni quqaqisaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Innee unna qimariasa Anutufa inni naqaa fee mannimaqaannoo.","poem":1},{"lineBreak":true},{"text":"Mifa naqimmaseenoo fee inni aupurarana nimiannoo fee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sundia rakira feefannoo faqa fidika arira idaurunnai faqa naruannoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inni qambaanai marirafa kaasau maqannaa aamina maqannaasa qambaanara foora mandaikiqa maridaqa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Qinee asooaranara fidiaqaa imariasaki kisaaqasaa uqanna mariaafanausa maridaqa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Qinee asooaranara qimarunaqa misa rakiranara kai qidaqa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}