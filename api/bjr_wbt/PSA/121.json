{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":121,"content":[{"type":"heading","content":["Yaaweefa maasa itita qimaqee marifa."]},{"type":"verse","number":1,"content":[{"text":"Qinee aaqanai qifu maqasee, qini dadaaqirafa yaindari fee aniannoo fee qidaqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qini dadaaqirafa Yaawee finaindari kai aniannoo.","poem":1},{"lineBreak":true},{"text":"Maa maqana faqa innaaruna faqa auqu quqoo finnaindari kai aniannoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mifa sia aniara qinana aqufinnaranoo.","poem":1},{"lineBreak":true},{"text":"Ani rakisi amaqee marifa aiqama kari afu maqaida maridanoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isaraee maqannaasasaa rakisinnimaqee marifa sia moo kari qaunduarinoo sia faiqaidannoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaaweefa ani rakisi amaqaannoo.","poem":1},{"lineBreak":true},{"text":"Mifa ani itita amaqarara ani aaqa maridanoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Suani fannoo faasaana sia naruannoo.","poem":1},{"lineBreak":true},{"text":"Kafaa eendaki quqoona fannoo sia naruannoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaaweefa aiqama mandainainaki innisaa ititamma nimaqaannoo.","poem":1},{"lineBreak":true},{"text":"Mifa inni nariranasaa itita nimaqasee innisaa rakisiannoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mifa kai inni firannai anirannaira rakisi nimaqaannoo.","poem":1},{"lineBreak":true},{"text":"Maqee faqa naaru naaru faqa rakisi nimaqaannoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}