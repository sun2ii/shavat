{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":122,"content":[{"type":"heading","content":["Yeerusaree maqusa amooqia."]},{"type":"verse","number":1,"content":[{"text":"Yaaweena amaana maaqai firaree qimasee qimaqimiafaqa qinee asasiqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maqee maasa maaqoo Yeerusaree faandaamura kooqiki keeqafi afuqaki maridaqa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yeerusaree maqusa usakasoofanoo kaaqa amiqirafa atiuqa amana amana kai inoo maridanoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isaraeena akeeku akaaku miqimmasee aniree Yaaweena naamuaqira ufa amana kai dufi dufi qirana amidaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maaqoo Yeerusaree maqannaa karaambaiqauqa nariqa faiqí anaasee ufa andeeqa nimaqararee qimasee ooqu mariqau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yeerusaree maqusa asooaranaki marianifeera innaaruqiaqa.","poem":1},{"lineBreak":true},{"text":"Yeerusaree maqusara rimariasa aiqama ainaina rairaa iani","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oo Yeerusaree maqusa ani faandaamura afuqaki asooarafa kai mariani.","poem":1},{"lineBreak":true},{"text":"Ani karaambaiqauqa nári maaqaki amiqimmasee mariaqa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Qeeqa ainainara faqa qeeqa qiqoondiuqara faqa irisee Yeerusaree maqusara maaqi qidaqa.","poem":1},{"lineBreak":true},{"text":"Asooarafa aniki mariani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaaweena maasa Anutuna amaana maaqara irisee inni Yeerusaree maqannaasee irairaamma nimaqaranara innaaru qidaqa.","poem":1},{"lineBreak":true},{"text":"Anutufa qimudaoo qirana amiani fee innaaru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}