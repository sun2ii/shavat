{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":124,"content":[{"type":"heading","content":["Anutufa narí faiqí anaasee itita nimaqee marifa maridanoo."]},{"type":"verse","number":1,"content":[{"text":"Yaaweefa maasa sia dadaaqinaqau naqaa fee unaiqini.","poem":1},{"lineBreak":true},{"text":"Oo Isaraee maqannaasa minara qima qimifaqa iria.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaaweefa maasa sia dadaaqinaqau namuqaa nári aanoo qiranannai maasa qumarasee kaqi kasi marunaqa nambiqaa qini.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miqinanoofau nammari aufirafa maasa maree fiqini.","poem":1},{"lineBreak":true},{"text":"Kaifaa nammari maasa rafaaqafu qisaiqini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nammari aufinoo firaaqoo aiai qimarifa maasa ukuqnama qimaqaiqini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaaweefa maasa namuqaara qifaqa sia maasa mandaikamma qimaqaanara maasa mina dufi dufi qimamaqaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maasa ufiniara foora faiqí ufini ufanaki arurudukaki fiara foommiqa.","poem":1},{"lineBreak":true},{"text":"Mi fasiqana ufaana raudafifaqa maasa qifaaqa quqasee mana mana idaqa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maasa dadaaqirafa Yaawee finnaindari anidanoo.","poem":1},{"lineBreak":true},{"text":"Maqa faqa innaaruna faqa auqu finnaindari anidanoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}