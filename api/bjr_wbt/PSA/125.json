{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":125,"content":[{"type":"heading","content":["Anutuna faiqí aanaaseesa rakisirafa."]},{"type":"verse","number":1,"content":[{"text":"Yaaweena saqariki mariasa Sioona aaqanara foora maridaqa.","poem":1},{"lineBreak":true},{"text":"Sia amana kasi annoo sia moo fannoo mina mareeqee moosaa quqaannoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aaqanauqa Yeerusaree maqusa fiqu fiqumma datinoo marindee inoo Yaaweefa narí faiqí anaasee fiqu fiqumma ititannimaqasee maqee faqa naaru faqa rakisi nimaqaidanoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mandoosana maree mariasa sia amana andeeqarausa maqasaa aiqama kari rakisifaranoo.","poem":1},{"lineBreak":true},{"text":"Misa miqifaqa andeeqarausa misasaaqaraa aaqara oosana maree foora.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo Yaawee andeeqara oosana maree mariasa amiqi amiqimmannimaqaa.","poem":1},{"lineBreak":true},{"text":"Ani naamuaqira ufamau fimariasa amiqi amiqimma nimaqaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miqidana anee manda oosana maree mariasa aupurarana nimidana ani ufa minnisee kaqi runna fimariasa faqa aupurarana nimia.","poem":1},{"lineBreak":true},{"text":"Asooarafa Isaraee maqannaaki mariani.","poem":1},{"lineBreak":true},{"text":"Manda ainainakinaana mara kaqinni uqannisaani fee innaaru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}