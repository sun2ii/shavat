{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Yaaweefa maasa Yeerusareenni qifiqee anufa qainasaara foora marinau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maasa firaaqoo naanaidara qida asasida idiree mariqau.","poem":1},{"lineBreak":true},{"text":"Miqi mariafanaqa akaqa maqannaasa maasara maaqi qiqau.","poem":1},{"lineBreak":true},{"text":"Yaaweefa firaa ainaina dadaaqinoo fee qiqau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuqaa mifa firaa ainaina maasa dadaaqufaqa maasa minara firaaqoo asasiqiafana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aadaturunna aaku rifanoo nammari qumi marindee inana kaifaa maasa amiqi amiqimma qimaqaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naukuna namu faqa ummaqi mariasa asasira idi namu faqa unakuaqanani.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asumu ainaina ummaqiraree qimasee naukunu namufaqa maree munu ummaqusee mariifaqa nara aukuana unaku maree asasira idi namu faqa maree anifaranoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}