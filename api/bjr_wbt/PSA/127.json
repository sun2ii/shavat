{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":127,"content":[{"type":"heading","content":["Anutuna amiqira oosana amooqia."]},{"type":"verse","number":1,"content":[{"text":"Yaaweefa sia maaqa usakaifanoo, usakara saika fannoo anoona siaifa mariqini.","poem":1},{"lineBreak":true},{"text":"Yaaweefa sia maqusasaa ititee marifanoo aufari mari fasiqafa kikiqinoo marida rakisi mari oosanafa sia amanaikiqini.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fifau kananaana eendai uqanna findifi ainaina kadaapirina fifiina eendi mariananoo.","poem":1},{"lineBreak":true},{"text":"Yaaweefa narí aidi marisa faiqaqee iafanoo narana nimidanoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Faiqi asumu Yaaweefa kaqi nimi mari ainainafa maridanoo.","poem":1},{"lineBreak":true},{"text":"Mifa kaaqa afaaramasee amiqi amiqimma qimaqaidanoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kumaaraasaa maqainna faiqisa nári nikoona asaukuki rakira fasiqauqa duru feefara foora maridaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miqira fasiqa moomoo faiqi duru feefara foora mina asaukuki karariqa mariafanoo asasidanoo.","poem":1},{"lineBreak":true},{"text":"Mifa ufa iriranaki mina namuqaauqa sia mina rafaaqa fifaranoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}