{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":128,"content":[{"type":"heading","content":["Yaaweena ufa qaindusi mariana akiiqara nimirafa."]},{"type":"verse","number":1,"content":[{"text":"Yaaweena ufamau fimariasa asasidaqa.","poem":1},{"lineBreak":true},{"text":"Mina naamuaqira ufasaa mariasa faqa asasidaqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anee miqi marianafa aiqama kari ani kadaapirirafa narana ainaina amiannoo.","poem":1},{"lineBreak":true},{"text":"Ani ainaina reemindeemirinoo marinana asasinnarannoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ani anaaqa fannoo wainna sandara foora maaqaki mariranaki moomoo qaqama iraannoo.","poem":1},{"lineBreak":true},{"text":"Ani akoonaiqi faiqiuqa oorifa amiqira saqariara foora ani narana nee marianna difaanina fiqu fiquiqa marifaranoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Faiqí Yaaweena ufamau fimarifa miqimmaseenoo kaaqa amiqi amiqiannoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaaweefa Sioonna maqusakiqari inni amiqi amiqimma nimaqaani.","poem":1},{"lineBreak":true},{"text":"Inneeqa kaqi marinna kamu Yeerusaree maqusaki aiqama ainaina reemindee mirirana qafaaqanani.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Innee kisaaqasaa marida inneeqa ninaiqimara niqafaaqanani.","poem":1},{"lineBreak":true},{"text":"Asooarafa Isaraee maqannaasaki mariani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}