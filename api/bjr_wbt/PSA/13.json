{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":13,"content":[{"type":"heading","content":["Dadaaqiani fee innaaru."]},{"type":"verse","number":1,"content":[{"text":"Oo Yaawee kisaaqasaa fee anee qiniara qauninnaree.","poem":1},{"lineBreak":true},{"text":"Naaruara naaruara miqi fee imarinnaree.","poem":1},{"lineBreak":true},{"text":"Anee kisaaqasaa fee qini qifusaaqari kukeeqana marinnaree.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kisaaqasaa fee qinee aupurarana uaqee maridaqee.","poem":1},{"text":"Daunduraki rairai qimari umaaranara oonu mafi irianauree.","poem":2},{"text":"Aiqama eendaki faasaana kisaaqasaa fee qini aiaaee qirafa mariannoo fee.","poem":1},{"lineBreak":true},{"text":"Kisaaqasaa fee qinee namuqaa nimeemaanai marianuree.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oo Yaawee qini Anutu anee amiqimasee qini qiqafamasee qini ufa anoona qimaqimia.","poem":1},{"lineBreak":true},{"text":"Anee kafaa qini afeeka qiminaqa sia kuqua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo Yaawee anee sia qini namuqaara qinaqa qiniara mina doo rafaaqafusee fee qiaqa.","poem":1},{"lineBreak":true},{"text":"Anee sia qini namuqaara qinaqa qinee saamuruannanara nasuriaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anee maqee maqee qiniara aidimariannanasaa qinee mundidaqa.","poem":1},{"lineBreak":true},{"text":"Anee qini asumu marainnanara qinee asasianaura.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oo Yaawee anee qini amiqi amiqimma qimaqoonnanara ani amooqira idi raanaura.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}