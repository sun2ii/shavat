{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":149,"content":[{"type":"heading","content":["Anutuna amooqira idi."]},{"type":"verse","number":1,"content":[{"text":"Yaaweena amooqia.","poem":1},{"lineBreak":true},{"text":"Yaaweena fuka idi ramamaqaaqa.","poem":1},{"lineBreak":true},{"text":"Mina ufa mau fimariasa ufa suqiranaki mina amooqimamaqaaqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isaraee maqannaasa inni auqu nisoonara irisee asasiaqa.","poem":1},{"lineBreak":true},{"text":"Sioona maqusaki mariasa inneeqa karaambaiqara susumma amaqaaqa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Innee idi raida niqoori raqaranannai faqa dukaanaannai faqa piripunnannai faqa mina auqu amooqiaqa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaaweefa narí faiqí aanaaseera asasidanoo.","poem":1},{"lineBreak":true},{"text":"Nári mara maree qumimariasa rakirana uriqararanannai amiqimma nimaqaidanoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaaweena faiqí anaasee nariqa rakiranara qufoonaridaqa asasira idi eendaki raqa fifi iaqaaqa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Misa firaaqoo faaq rumasee Anutuna amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Misa nisaukuki dinni dinni raiqarana rakira paipana kaqi marinaqa mina namu faqa amooqiaqa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kaqi marifaqa misa minannai aanaamuru rafaaqa firara uaqee idaqa.","poem":1},{"lineBreak":true},{"text":"Anaamuru fasiqa anaasee narirara uaqee idaqa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Misa karaambaiqauqa sainandannai rumbarana uaqee idaqa.","poem":1},{"lineBreak":true},{"text":"Misa karaambaiqauqa qainna sainandannai rumbarara uaqee idaqa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anutufa naamuaqundee iqa moo maqannaasa narirara uaqee idaqa.","poem":1},{"lineBreak":true},{"text":"Anutuna faiqí anaasee rakirana uriqararafa miqimminoo maridanoo.","poem":1},{"lineBreak":true},{"text":"Yaaweena amooqia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}