{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":150,"content":[{"type":"heading","content":["Yaaweena amooqia."]},{"type":"verse","number":1,"content":[{"text":"aaweena amooqia.","poem":1},{"lineBreak":true},{"text":"Anutuna naaquqara amaana maqaki mina amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Mina uriqarara afeeka innaaru nai marina amooqiaqa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mifa afeeka ainaina auqoo nara amooqima amaqaaqa.","poem":1},{"lineBreak":true},{"text":"Mina amiqira uriqararanara amooqiaqa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ukeena fuaqaidaqa minannai mina amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Kaqikaa piripunnannai faqa firaa piripunnannai faqa mina amooqiaqa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dukaanaannai faqa idi raida niqoori raqaranannai faqa mina amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Piripunnannai faqa ufireenannai faqa mina amooqiaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Innee qumiandau qaqama kaqikaa qanda faqa firaa qanda faqa qumaree narisaa narisaa ramoo ramoo idaqa Yaaweena amooqiaqa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},"Oosana oosana piripunna idi raidaqa arimariafa maridanoo.",{"text":"Aiqama naanna faqaa ainaina Yaaweena amooqiaqa. Yaaweena amooqia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}