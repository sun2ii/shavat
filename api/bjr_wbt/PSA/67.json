{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":67,"content":[{"type":"heading","content":["Anutuna dufi dufi qimamaqara idi."]},{"type":"verse","number":1,"content":[{"text":"Anutu anee maasara qimudaoo qimasee amiqi amiqimmaqisaa.","poem":1},{"lineBreak":true},{"text":"Aneenna oori afiri kaaqa qarana maasiannai ubeekamasee dadaaqia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miqinaqa ani oosana aiqama maqa maaqakinaasa iriaqa.","poem":1},{"lineBreak":true},{"text":"Aiqama maqannaasa ani asumu mariranara faqa iriaqa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oo Anutu aiqama faiqí anaasee ani amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Aiqama faiqí anaasee ani amooqiaqa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo Anutu, anee faiqí anaasee aiqama amana amana kai andeeqasee rakisi mariannana faqa amiqimmasee naamua qimasee nifiqee fimariannanara faqa aiqama maqannaasa asasammasee idi raidaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oo Anutu faiqí anaasee ani amooqiaqa.","poem":1},{"lineBreak":true},{"text":"Aiqama faiqí anaasee ani auqu uqeeraaqa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miqifanoo maqakiqari aiqama narana kambiqanoo.","poem":1},{"lineBreak":true},{"text":"Kambiqainanoo Anutufa maasa Anutufa amiqi amiqimma qimaqaannoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anutufa maasa amiqi amiqimma qimaqanau.","poem":1},{"lineBreak":true},{"text":"Aiqama maa maqanasaaqaraa fasiqa anaasee minara uriqarara fee qimasee qeerairiaqa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}