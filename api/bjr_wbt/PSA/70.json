{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":70,"content":[{"type":"heading","content":["Dadaaqiani fee innaaru."]},{"type":"verse","number":1,"content":[{"text":"Oo Anutu, anee qini mandainainakinaana mara aquqisaa.","poem":1},{"lineBreak":true},{"text":"Oo Yaawee, kai kaqi aniree qini dadaaqia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Qini marirana taika qimaqarara randeemariasa rafaaqafu saina nisauriranaki faqa furufariranaki faqa mariaqa.","poem":1},{"lineBreak":true},{"text":"Qini ummaarara irisee asasimariasa mara quandasainaqa nisauruaqa","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Qiniara uteeti qimariasa nariqa nisaurirana firaafa marina qafaifanoo firaaqoo naaquqaani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo Yaawee anee iannannai ani mariasa asasidaqa nasuriaqa.","poem":1},{"lineBreak":true},{"text":"Ani asumu mariranara nidimarisa, maaqi qiaqa.","poem":1},{"lineBreak":true},{"text":"Yaaweefa uriqararafa maridanoo fee qiaqa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qinee Dafidisa qimudaani radukirausa marunausa saraui marunna fasiqausa marunnanara oo Yaawee anee sia qiniara qaunuananoo.","poem":1},{"lineBreak":true},{"text":"Anee qini asumu maree marianafa faqa qini Anutufa faqa mariannanara kai kaqi aniree qini dadaaqia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}