{"translation":{"id":"bjr_wbt","name":"Fúka Moodaanaki Kira Ufa Afaqínaasa Ufa","website":"https://ebible.org/Scriptures/details.php?id=bjr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bjr","licenseNotes":null,"shortName":"WBT","englishName":"Binumarien Bible","language":"bjr","textDirection":"ltr","sha256":"b32a086bfb83b4bd3ddec33c4262cdf51f151266ef51e6f8c7fa3f8a5e9fe028","availableFormats":["json"],"listOfBooksApiLink":"/api/bjr_wbt/books.json","numberOfBooks":32,"totalNumberOfChapters":541,"totalNumberOfVerses":13378,"languageName":"Binumarien","languageEnglishName":"Binumarien"},"book":{"id":"PSA","translationId":"bjr_wbt","name":"IDI UFA","commonName":"IDI UFA","title":"IDI UFA","order":19,"numberOfChapters":150,"sha256":"144f63a8fc13f7dc86e3e3fac530ba772a4cb1fed2eaaefe7e4e346c2a52ee67","firstChapterNumber":1,"firstChapterApiLink":"/api/bjr_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bjr_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":87,"content":[{"type":"heading","content":["Yeerusaree maqusa amooqiqau."]},{"type":"verse","number":1,"content":[{"text":"Sioona aaqanasaa naaquqarana saa Yaaweefa narí maqusa auqusee maridanoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaaweena Yeerusaree maqusara aidirafa aiqama Isaraee maqa maaqakinaa maqusauqara aidirna uriaaqaranoo maridanoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oo Anutuna maqusa iria, mifa aniara amiqira ufa kai qidanoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Qinni ufa irimariasa nisaanariqa Firistia maqannaasa faqa Tiree maqannaasa faqa Eetioopia maqannaasa faqa mara Yeerusaree maqannaasa namufaqa moodaanaki quqasee nisaana ruanaura.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sioona maqusara maaqi qifaranoo.","poem":1},{"lineBreak":true},{"text":"Aiqama maqannaasara mi maqusaanaasee qifaranoo.","poem":1},{"lineBreak":true},{"text":"Miqi qifanoo uriqarara afeeka faqaafa mi maqusana afeekaikamma saannoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anutufa aiqama fasiqa anaasee nuqu narí papiqaki akara ruannoo.","poem":1},{"lineBreak":true},{"text":"Misakiqari akaqausara narí ufa irimariasa Sioona maqusanaasa namufaqa nisaana ruannoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sioona maqusaki maria fasiqa anaaseesa maaqi qimasee idi reefaranoo.","poem":1},{"lineBreak":true},{"text":"Maasa aiqama amiqi amiqirana oosana Sioona maqusa maridanoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bjr_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bjr_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bjr_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}