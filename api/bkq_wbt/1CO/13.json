{"translation":{"id":"bkq_wbt","name":"Deus Itaumbyry","website":"https://ebible.org/Scriptures/details.php?id=bkqNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bkqNT","licenseNotes":null,"shortName":"WBT","englishName":"Bakairí NT","language":"bkq","textDirection":"ltr","sha256":"500b9d387b197175ca162daf58e13544e7503c9a00656b25cac36bc4263251b5","availableFormats":["json"],"listOfBooksApiLink":"/api/bkq_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7821,"languageName":"Bakairí","languageEnglishName":"Bakairí"},"book":{"id":"1CO","translationId":"bkq_wbt","name":"1 CORÍNTIOS","commonName":"1 CORÍNTIOS","title":"1 CORÍNTIOS Paulo Saguho Kata Inweniby Corinto Donro Modoram","order":46,"numberOfChapters":16,"sha256":"2d08d81b88ce4c749988048f12b09e276bac12ac5110059d0aed315da2308624","firstChapterNumber":1,"firstChapterApiLink":"/api/bkq_wbt/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bkq_wbt/1CO/16.json","totalNumberOfVerses":427},"chapter":{"number":13,"content":[{"type":"heading","content":["Âdara kydâpynedyly wâgâ agueho"]},{"type":"verse","number":1,"content":[{"text":"Xirâ onro anaym tâjitanru idânârâ auguely,","poem":1},{"text":"anju kau odano modo agueho tâjitanru auguely lelâlâ wâne,","poem":2},{"text":"augueho idani modo kâinwynebyra kulâ auguely-ro watay,","poem":1},{"text":"ytaumbyry modo âdyem nitaymba tâise.","poem":2},{"text":"Sinu, gongu warâ koendâ tydyzenry ipyru ara kulâ tâise.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tâwâlâ lelâlâ wâne koendâ Deus aguehobyry kâengatuly,","poem":1},{"text":"âdy mâkeba awârâ, ydataynrim modo kâinwynebyra kulâ auguely watay.","poem":2},{"text":"Tâwâlâ lelâlâ wâne koendâ kâuntuly saguhoem kyam Deus nhutuen-hondânrybyry,","poem":1},{"lineBreak":true},{"text":"idânârâ wâgâ koendâ kâuntuly warâ,","poem":1},{"text":"âdy mâkeba awârâ, ydataynrim modo kâinwynebyra kulâ auguely watay.","poem":2},{"text":"Kâinwândylygue iwy ejidydâpa tâjikehonze lelâlâ wâne urâ,","poem":1},{"text":"âdy keba olâ awârâ, yagonro modo kâinwynebyra urâ-ro watay.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Idânârâ tâlâ wato modo âdy pebaom modoram tuduwâse wâne tâise urâ;","poem":1},{"lineBreak":true},{"text":"tâwâlâ wâne tâise kâsenagazedyly, Jesus eynynâbaom modoram kâdyoly,","poem":1},{"text":"wodo âjiaduân-honly warâ,","poem":2},{"lineBreak":true},{"text":"xurâmoem koendâ awito âdyem nipyra olâ Deus xurâem,","poem":2},{"lineBreak":true},{"text":"kâinwynebyramo kulâ awidyly-ro watay.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Idânârâ agâ tâpyneze kurâ-ro watay,","poem":1},{"text":"idânârâ tâmaenze kurâ kydâpeâmbyralâ;","poem":2},{"lineBreak":true},{"text":"kytyenilâ kurâ;","poem":2},{"lineBreak":true},{"text":"âsewâninri keba kurâ;","poem":2},{"lineBreak":true},{"text":"sawo keba kurâ;","poem":2},{"lineBreak":true},{"text":"âkelo modo takaze koendonro kydawyly wâgâ âdutuim keba kurâ warâ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"kywypado aguykeba, aguiempyra warâ kurâ.","poem":2},{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"âkelo wâgâ tâpaunzeze kurâ, kywâgâ kulelâ inkâba kydâpaunzedyly;","poem":2},{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"alâ kulâ kyewiâpadyly kitaymba kurâ.","poem":2},{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"kurâem inakanhe aitobyry inepa kienanânehonly.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"tâjityenze kurâ, iozepa kulâ kagonro aituo;","poem":2},{"lineBreak":true},{"text":"ioze lelâ aituo olâ tohomaenze kurâ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tâpyneze kurâ-ro watay,","poem":1},{"text":"âdara awyly umelâ kagonro keon-hondâdyly.","poem":2},{"lineBreak":true},{"text":"Kyam nhegatuly tâinwânse lelâ kurâ.","poem":2},{"text":"Deus izepa ato aienibyryem awyly kiuntuduo,","poem":1},{"lineBreak":true},{"text":"Deus nheinwântondyly kinwânwâmpyra kipyra kurâ;","poem":1},{"text":"kynynâ anhekyly kyzemaenre lelâ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tâlâ Deus itaumbyry koendâ egatuho,","poem":1},{"text":"adainze olâ awârâ,","poem":2},{"text":"Tâlâ âkelo tâjitanru Deus Ispiriturydâba âenigue aguehoem enomedâdo,","poem":1},{"text":"adainze lâpylâ olâ awârâ,","poem":2},{"text":"Tâlâ toenzepa âdydo imeom xutuho,","poem":1},{"text":"adainze lâpylâ olâ awârâ.","poem":2},{"text":"Tâdâpynedyly olâ ise âdaunloenlâ nadaimpa!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Âdydo imeom xuturin-em Deus Ispiritury nhenomedâdyby modo","poem":1},{"text":"idânârâ koendâ kuru âdakeze aguely awyly nutuwâbyramo;","poem":2},{"lineBreak":true},{"text":"tâlâlâ nhutudânrymo.","poem":2},{"text":"Deus itaumbyry egaturin-em Deus Ispiritury nhenomedâdyby modo","poem":1},{"text":"idânârâ koendâ kuru nutuwâbyramo,","poem":2},{"lineBreak":true},{"text":"âdiempa kulâ nhutulymo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Târâ Deus eydâ atodâ Deus agâ kydoxioduo olâ,","poem":1},{"text":"idânârâ mâkâ kiuntudyze ato ara xutuze kurâ,","poem":2},{"lineBreak":true},{"text":"mâkâ kyize ato ara lelâ ise kurâ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iamudoem wawyly ume, iamudo agueho aralâ kâinane auguely;","poem":1},{"text":"iamudo tyangahu oday xunâgo aralâ kâinane unâgu yangahu oday;","poem":2},{"lineBreak":true},{"text":"iamudo ize atolâ kâinane ize wato warâ.","poem":2},{"text":"Xutuybyem olâ urâ iwerâ; iamudoemba itybyem.","poem":1},{"text":"Iamudo ara inkâba awidyly iwerâ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ispelhu tywykeim oday, koendâ kydâzetaymba kurâ;","poem":1},{"text":"tâzese wâne kurâ, koendâ kuruba olâ, koendâpa awylygue,","poem":2},{"lineBreak":true},{"text":"myara lâpylâ, Deus wâgâ koendâ kehoem kuru kiuntuba kydawyly iwerâ.","poem":2},{"text":"Deus agâ kydoxioduo olâ, koendâ kehoem ese, xutuze warâ kurâ.","poem":1},{"lineBreak":true},{"text":"Iwerâ âdiempa kulâ kiuntuly.","poem":1},{"lineBreak":true},{"text":"Ilâ ume olâ mâkâ koendâ xutuze kurâ, iwerâ kutuho ara.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Deus kieinwândyly,","poem":1},{"text":"Deus idânârâ “Xuduze urâ” kehobyry kinwânwândyly,","poem":2},{"text":"Kydâpynedyly warâ nadainwâpyra ise.","poem":1},{"text":"Kydâpynedyly olâ mârâ kuru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bkq_wbt/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bkq_wbt/1CO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bkq_wbt/1CO/12.json","previousChapterAudioLinks":{},"numberOfVerses":13}