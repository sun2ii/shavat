{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":11,"content":[{"type":"heading","content":["དཱ་བིད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":1,"content":["དེའི་དུས་སུ་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཧེབ་རོན་དུ་དཱ་བིད་ཀྱི་དྲུང་དུ་འདུས་ནས་འདི་ལྟར། གཟིགས་དང་། བདག་ཅག་ནི་ཁྱེད་ཀྱི་ཤ་དང་རུས་པའི་གཉེན་ཉེ་ཡིན་ཏེ།"]},{"type":"verse","number":2,"content":["སྔར་སོ་ལོ་རྒྱལ་པོར་བཞུགས་དུས་སུ། ཁྱེད་ནི་ཡེས་ར་ཨེལ་པའི་དམག་དཔུང་གི་འགྲོ་འོང་ལ་སྣེ་ཁྲིད་བྱེད་མཁན་ཡིན། ཡང་ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ལ། ཁྱོད་ཀྱིས་བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་པར་བདག་སྐྱོང་བྱེད་ཅིང་། ཡེས་ར་ཨེལ་པའི་འགོ་དཔོན་དུ་འགྱུར་དགོས་ཞེས་གསུངས་པ་ཡིན་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ཧེབ་རོན་དུ་རྒྱལ་པོའི་དྲུང་དུ་འོངས་པ་དང་། རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཧེབ་རོན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དེ་དག་དང་ཆད་དོན་བཞག་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་སཱ་མུ་ཨེལ་བརྒྱུད་ནས་གསུངས་པ་བཞིན་དུ། དཱ་བིད་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་ཆེད་སྣུམ་གྱིས་བྱུགས་སོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་བླངས་པ།"]},{"type":"verse","number":4,"content":["དཱ་བིད་དང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཡེ་རུ་སཱ་ལེམ་སྟེ་ཡེ་བུ་སི་རུ་ཕྱིན་པ་དང་། དུས་དེར་ཡུལ་དེའི་ཡུལ་མི་སྟེ་ཡེ་བུ་སི་པ་རྣམས་དེར་གནས་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ཡེ་བུ་སི་ཡི་ཡུལ་མི་རྣམས་ཀྱིས་དཱ་བིད་ལ་འདི་ལྟར། ཁྱོད་གྲོང་ཁྱེར་འདིའི་ནང་དུ་འོང་མི་ནུས་ཞེས་སྨྲས་མོད། དཱ་བིད་ཀྱིས་ཛ་ཡན་གྱི་བཙན་རྫོང་བཟུང་བ་སྟེ། ཛ་ཡན་ནི་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་འབོད་པ་དེ་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["དཱ་བིད་ན་རེ། སུ་ཞིག་གིས་སྔོན་ལ་ཡེ་བུ་སི་པ་རྣམས་དང་འཐབ་ན། དེ་ནི་དམག་སྤྱི་ཆེན་མོར་བྱའོ་ཞེས་བསྒོས་པས། ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་བྱ་བ་ཐོག་མར་སྔོན་དུ་ཕྱིན་པས་ཁོ་འགོ་དཔོན་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":7,"content":["དཱ་བིད་ནི་བཙན་རྫོང་དེའི་ནང་དུ་བཞུགས་པའི་རྐྱེན་གྱིས། དེའི་མིང་ལ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་དཱ་བིད་ཀྱིས་འཛིངས་རགས་ཀྱི་ཕྱོགས་བཞི་ནས་མཁར་གྱང་བརྩིགས་པ་དང་། ཁག་ལྷག་མ་རྣམས་ཡོ་ཨབ་ཀྱིས་བརྩིགས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཱ་བིད་དང་མཉམ་དུ་བཞུགས་པས། དཱ་བིད་ཉིན་རེ་བཞིན་དར་ཞིང་རྒྱས་པར་གྱུར་ཏོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱི་དཔའ་རྒོད་རྣམས།"]},{"type":"verse","number":10,"content":["དཱ་བིད་ཀྱི་དཔའ་རྒོད་རྣམས་ཀྱི་འགོ་དཔོན་དག་ནི་འདི་ལྟ་སྟེ། དེ་དག་གིས་ཁོང་ལ་རྒྱབ་རོགས་ཆེན་པོ་བྱས་ནས་རྒྱལ་ས་བླངས་པ་དང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གསུངས་པ་བཞིན་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་དང་མཉམ་དུ་ཁོང་རྒྱལ་པོར་བསྐོས་པའོ། །"]},{"type":"verse","number":11,"content":["དཱ་བིད་ཀྱི་དཔའ་རྒོད་དག་གི་གྲངས་ཀ་ནི་འདི་ལྟ་སྟེ། ཧག་མོན་གྱི་བུ་ཡ་ཤོ་བེ་ཨམ་བྱ་བ་དེ་ནི་དཔའ་རྒོད་སུམ་ཅུའི་",{"noteId":7},"འགོ་དཔོན་ཡིན་ཏེ། སྔར་མདུང་བསྐོར་ནས་འཐབ་ཐེངས་གཅིག་ལ་སྐྱེས་པ་སུམ་བརྒྱ་བསད་པ་ཡིན།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཨ་ཧོ་པ་དོ་དོ་ཡི་བུ་ཨེ་ལི་ཨ་ཟར་ཡིན་ལ། དེ་ནི་དཔའ་རྒོད་གསུམ་པོ་ནང་གི་གཅིག་སྟེ།"]},{"type":"verse","number":13,"content":["ཁོ་ནི་སྔར་དཱ་བིད་དང་མཉམ་དུ་ཕཱ་སི་དམ་མིམ་དུ་ཕྱིན་པ་དང་། དེར་ཕེ་ལེ་ཤེད་པ་རྣམས་འཐབ་ཏུ་འདུས་ཡོད་པ་ཡིན། ཡང་གནས་དེར་ནས་ཀྱིས་ཁེངས་པའི་ཞིང་ཞིག་ཡོད་དེ། མི་རྣམས་ཕེ་ལེ་ཤེད་པའི་མདུན་ནས་བྲོས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཁོ་རྣམས་",{"noteId":8},"ཞིང་དེའི་དཀྱིལ་དུ་ལངས་ནས་ཞིང་དེ་བསྲུངས་པ་དང་ཕེ་ལེ་ཤེད་པ་རྣམས་ཕམ་པར་བརྒྱབ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་བསྐྱབས་ཤིང་ཁོ་རྣམས་ལ་རྒྱལ་ཁ་ཆེན་པོ་ཐོབ་པར་མཛད་དོ། །"]},{"type":"verse","number":15,"content":["ཡང་འགོ་དཔོན་སུམ་ཅུ་ལས་གསུམ་ནི་ཨ་དུལ་ལཱམ་བྲག་ཕུག་ཉེ་འགྲམ་གྱི་ཕ་བོང་རྩར་དཱ་བིད་ཀྱི་དྲུང་དུ་ཕྱིན་པ་དང་། ཕེ་ལེ་ཤེད་པའི་དམག་དཔུང་གིས་རེ་པཱ་པའི་ལུང་པ་རུ་སྒར་བཏབ་བོ། །"]},{"type":"verse","number":16,"content":["དེའི་དུས་སུ་དཱ་བིད་ནི་བཙན་རྫོང་ནང་དུ་ཡོད་པ་དང་། ཕེ་ལེ་ཤེད་པའི་འགོག་སྲུང་དམག་དཔུང་པེད་ལེ་ཧེམ་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["དེར་དཱ་བིད་ཤིན་ཏུ་སྐོམ་ནས་ན་རེ། ཀྱེ་ཧོ། སུ་ཞིག་གིས་པེད་ལེ་ཧེམ་གྱི་མཁར་སྒོའི་འགྲམ་གྱི་ཁྲོན་པ་ལས་ཆུ་ཁུར་འོངས་ནས་ང་ལ་བླུད་ན་ཅི་མ་རུང་ཞེས་པར།"]},{"type":"verse","number":18,"content":["དཔའ་རྒོད་འདི་གསུམ་པོས་ཕེ་ལེ་ཤེད་པའི་དམག་སྒར་བརྒལ་ནས་སོང་སྟེ། པེད་ལེ་ཧེམ་གྱི་མཁར་སྒོའི་འགྲམ་གྱི་ཁྲོན་པ་ལས་ཆུ་བཅུས་ནས་ཁུར་འོངས་ཏེ་དཱ་བིད་ལ་ཕུལ་ནའང་། ཁོང་གིས་དེ་མ་འཐུང་བར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མཆོད་དེ་ན་རེ།"]},{"type":"verse","number":19,"content":["ང་ཡི་དཀོན་མཆོག་གི་དྲུང་དུ་ངས་འདི་འདྲའི་ལས་གཏན་ནས་བྱེད་མི་རུང་། ཆུ་འདི་ནི་མི་དེ་དག་གིས་རང་སྲོག་ལ་མ་འཛེམ་པར་ཁྱེར་འོངས་པ་ཡིན་པས། ངས་རང་སྲོག་ལ་མི་འཛེམ་པ་འདི་དག་གི་ཁྲག་འཐུང་ག་ལ་རུང་ཞེས་ཞུས་ཤིང་། དཱ་བིད་ཀྱིས་ཆུ་དེ་མ་འཐུང་ངོ་། །དེ་ནི་དཔའ་རྒོད་དེ་གསུམ་པོས་བྱས་པའི་ལས་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཡོ་ཨབ་ཀྱི་ནུ་བོ་ཨ་བི་ཤཱ་ཨི་ནི་དཔའ་རྒོད་གསུམ་པོའི་",{"noteId":9},"འགོ་དཔོན་ཡིན་ཏེ། སྔར་དེ་ཡིས་མི་སུམ་བརྒྱ་ལ་མདུང་གིས་བརྒྱབ་ནས་བསད་པས། དཔའ་རྒོད་གསུམ་པོའི་ནང་དུ་མིང་ལ་གྲགས་སོ། །"]},{"type":"verse","number":21,"content":["ཁོ་ནི་དཔའ་རྒོད་གསུམ་པོའི་ཁྲོད་དུ་ཆེས་མཆོག་ཏུ་གྱུར་པ་ཡིན་པས་དེ་དག་གི་འགོ་དཔོན་དུ་གྱུར་མོད། འོན་ཀྱང་དཔའ་རྒོད་སྔ་མ་གསུམ་པོར་མི་དོའོ། །"]},{"type":"verse","number":22,"content":["ཡང་ཡེ་ཧོ་ཡ་དཱའི་བུ་པེ་ནཱ་ཡ་ཞེས་པ་ནི་ཀབ་ཟེ་ཨེལ་ནས་ཐོན་པའི་དཔའ་རྒོད་ཡིན་པ་སྟེ། སྔར་དོན་ཆེན་པོ་བསྒྲུབས་ཏེ། ཁོས་མོ་ཨབ་པ་ཨ་རི་ཨེལ་གྱི་བུ་གཉིས་བསད་པ་དང་། ཡང་ཁ་བ་འབབ་པའི་ཉིན་མོར་ས་དོང་ནང་དུ་བབས་ནས་སེང་གེ་ཞིག་ཀྱང་བསད་པ་ཡིན།"]},{"type":"verse","number":23,"content":["ཡང་དེས་ཨེ་ཅིབ་པ་གཟུགས་པོའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་ཡོད་པ་ཞིག་ཀྱང་བསད། ཨེ་ཅིབ་པ་དེའི་ལག་ཏུ་ཐགས་འཐག་བྱེད་ཀྱི་འཁོར་བརྟེན་ལྟ་བུའི་མདུང་བཟུང་ནའང་། པེ་ནཱ་ཡས་དབྱུག་པ་ཞིག་བཟུང་ནས་དེ་ལ་རྒོལ་དུ་སོང་ཞིང་། ཨེ་ཅིབ་པའི་ལག་ནས་མདུང་ཕྲོགས་ཏེ། མདུང་དེས་ཁོ་བསད་པའོ། །"]},{"type":"verse","number":24,"content":["འདི་ནི་ཡེ་ཧོ་ཡ་དཱའི་བུ་པེ་ནཱ་ཡ་ཡིས་བྱས་པའི་ལས་ཡིན་ལ། དེ་དཔའ་རྒོད་གསུམ་པོའི་ཁྲོད་དུ་མིང་ལ་གྲགས་སོ། །"]},{"type":"verse","number":25,"content":["ཁོ་ནི་དཔའ་རྒོད་སུམ་ཅུ་དེ་ལས་མིང་ཆེ་ཡང་དཔའ་རྒོད་སྔ་མ་གསུམ་པོར་མི་དོའོ། །དཱ་བིད་ཀྱིས་དེ་ནི་སྐུ་སྲུང་པ་དག་གི་འགོ་དཔོན་དུ་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":26,"content":["དམག་དཔུང་གི་དཔའ་རྒོད་རྣམས་ནི། ཡོ་ཨབ་ཀྱི་ནུ་བོ་ཨ་སཱ་ཧེལ་དང་། པེད་ལེ་ཧེམ་པ་དོ་དོའི་བུ་ཨེལ་ཧ་ནན།"]},{"type":"verse","number":27,"content":["ཧ་རོར་པ་ཤམ་མོད། ཕེ་ལོན་པ་ཧེ་ལེ་ཙི།"]},{"type":"verse","number":28,"content":["ཐེ་ཀོ་ཨ་པ་ཨིག་ཀེ་སིའི་བུ་ཨི་རཱ། ཨ་ན་ཐོད་པ་ཨ་བི་ཨེ་ཟཱེར།"]},{"type":"verse","number":29,"content":["ཧུ་ཤཱ་པ་སིབ་བེ་ཀཱ་ཨི། ཨ་ཧོ་པ་ཨི་ལཱ་ཨི།"]},{"type":"verse","number":30,"content":["ནེ་ཏོ་ཕཱ་པ་མ་ཧ་རཱ་ཨི། ནེ་ཏོ་ཕཱ་པ་པ་ཨ་ནཱ་ཡི་བུ་ཧེ་ལེད།"]},{"type":"verse","number":31,"content":["པེན་ཡཱ་མེན་གྱི་བུ་རབས་ཚ་རྒྱུད་དེ་གིབ་ཨ་པ་རི་བཱ་ཨི་ཡི་བུ་ཨི་ཐ་ཨི། ཕི་ར་ཐོན་པ་པེ་ནཱ་ཡ།"]},{"type":"verse","number":32,"content":["གཱ་ཨ་སི་གྲོག་མོའི་ཧུ་ར་ཨི། ཨ་རཱབ་པ་ཨ་བི་ཨེལ།"]},{"type":"verse","number":33,"content":["པ་ཧ་རུམ་པ་ཨས་མ་ཝེད། ཤ་ཨལ་བོན་པ་ཨེལ་ཡ་བཱ།"]},{"type":"verse","number":34,"content":["གི་ཟོན་པ་ཧ་ཤེམ་གྱི་བུ་རྣམས་དང་། ཧ་རར་པ་ཤཱ་གེ་ཡི་བུ་ཡོ་ནཱ་ཐན།"]},{"type":"verse","number":35,"content":["ཧ་རར་པ་སཱ་ཀར་གྱི་བུ་ཨ་ཧི་ཨམ། ཨུར་གྱི་བུ་ཨེ་ལི་ཕལ།"]},{"type":"verse","number":36,"content":["མེ་ཀེ་རཱ་པ་ཧེ་ཕེར། ཕེ་ལོན་པ་ཨ་ཧི་ཡཱ།"]},{"type":"verse","number":37,"content":["ཀར་མེལ་པ་ཧེ་ཙི་རོ། ཨེ་སི་པཱ་ཨི་ཡི་བུ་ན་ཨ་རཱ་ཨི།"]},{"type":"verse","number":38,"content":["ནཱ་ཐན་གྱི་སྤུན་ཡོ་ཨེལ། ཧག་རིའི་བུ་མིབ་ཧར།"]},{"type":"verse","number":39,"content":["ཨམ་མོན་པ་ཙེ་ལེག པེ་རོད་པ་ན་ཧ་རཱ་ཨི་སྟེ། ན་ཧ་རཱ་ཨི་ནི་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་ཀྱི་གོ་མཚོན་འཁུར་མཁན་ཡིན་པ་དང་།"]},{"type":"verse","number":40,"content":["ཡེད་རཱ་པ་ཨི་རཱ་དང་། ཡེད་རཱ་པ་ག་རེབ།"]},{"type":"verse","number":41,"content":["ཧེད་པ་ཨུ་རི་ཡཱ། ཨ་ཧ་ལཱ་ཨིའི་བུ་ཟཱ་བད།"]},{"type":"verse","number":42,"content":["རུ་བེན་ཚོ་པའི་ཤི་ཟཱ་ཡི་བུ་ཨ་དི་ནཱ་སྟེ། ཁོ་ནི་རུ་བེན་ཚོ་པའི་འགོ་དཔོན་ཞིག་ཡིན་ལ་རྗེས་འབྲང་པ་མི་སུམ་ཅུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":43,"content":["མ་ཨ་ཀཱ་ཡི་བུ་ཧ་ནན། མིད་ནི་པ་ཡོ་ཤ་ཕད།"]},{"type":"verse","number":44,"content":["ཨ་ཤ་ཐེ་རཱ་པ་ཨུ་ཟི་ཡཱ། ཨ་རོ་ཨེར་པ་ཧོ་ཐམ་གྱི་བུ་ཤ་མཱ་དང་ཡེ་ཨི་ཨེལ།"]},{"type":"verse","number":45,"content":["ཐི་ཙཱ་པ་ཤིམ་རིའི་བུ་ཡེ་དི་ཡཱ་ཨེལ་དང་། དེའི་སྤུན་ཡོ་ཧ།"]},{"type":"verse","number":46,"content":["མཱ་ཧབ་པ་ཨེ་ལི་ཨེལ། ཨེལ་ན་ཨམ་གྱི་བུ་ཡེ་རི་བ་ཨི། ཡོ་ཤབ་ཡཱ། མོ་ཨབ་པ་ཡེད་མཱ།"]},{"type":"verse","number":47,"content":["ཨེ་ལི་ཨེལ། ཨོ་བེད། མེ་ཙོ་བ་ཡཱ་པ་ཡ་ཨ་སི་ཨེལ་དང་བཅས་པའོ། །"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འདིར་དཔའ་རྒོད་སུམ་ཅུ་ཞེས་པ་འདིར་འགྱུར་ལ་ལའི་ནང་དུ་དཔའ་རྒོད་གསུམ་ཞེས་དང་འགྱུར་ལ་ལར་དཔའ་རྒོད་རྩེ་གྲས་ཞེས་འབྱུང་།","reference":{"chapter":11,"verse":11}},{"noteId":8,"caller":"+","text":"ཁོ་རྣམས་ཞེས་པར་འགྱུར་གཞན་ལས་ཁོ་ཞེས་ཀྱང་མཐོང་།","reference":{"chapter":11,"verse":14}},{"noteId":9,"caller":"+","text":"དཔའ་རྒོད་གསུམ་པོ་ཞེས་པར་གནའ་བོའི་འགྱུར་ལས་དཔའ་རྒོད་སུམ་ཅུ་ཞེས་འབྱུང་།","reference":{"chapter":11,"verse":20}}]},"thisChapterLink":"/api/bod_ntb/1CH/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/10.json","previousChapterAudioLinks":{},"numberOfVerses":47}