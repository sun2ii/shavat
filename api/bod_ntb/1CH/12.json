{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":12,"content":[{"type":"heading","content":["ཙིག་ལག་ཏུ་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་བའི་དཔའ་བོ་རྣམས།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཁི་སིའི་བུ་སོ་ལོའི་རྐྱེན་ཀྱིས་དཱ་བིད་ནི་ཙིག་ལག་ཏུ་ཡིབ་ནས་སྡོད་པའི་ཚེ། མི་འདི་རྣམས་དཱ་བིད་ཀྱི་རྩར་འོངས་པ་དང་། ཐམས་ཅད་དཔའ་བོ་ཡིན་ལ་འཐབ་མོའི་ཁྲོད་དུ་དཱ་བིད་ལ་རོགས་བྱས་སོ། །"]},{"type":"verse","number":2,"content":["དེ་རྣམས་ལ་མདའ་གཞུ་ཡོད་ཅིང་། ལག་པ་གཡས་གཡོན་གཉིས་ཀས་འུར་རྡོ་དང་མདའ་འཕེན་ནུས་པ་སྟེ། དེ་དག་ནི་པེན་ཡཱ་མེན་གྱི་ཚོ་བར་གཏོགས་ཤིང་སོ་ལོའི་གཉེན་ཉེ་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["དེ་དག་གི་འགོ་དཔོན་ནི་ཨ་ཧི་ཨེ་ཟེར་དང་ཡོ་ཨ་སི་གཉིས་ཡིན་ཏེ། དེ་གཉིས་ནི་གིབ་ཨ་པ་ཤེ་མཱ་ཨ་ཡི་བུ་ཡིན། ད་དུང་ཨས་མ་ཝེད་ཀྱི་བུ་ཡེ་ཟི་ཨེལ་དང་། ཕེ་ལེད། པེ་རཱ་ཀ ཨ་ན་ཐོད་པ་ཡེ་ཧུ།"]},{"type":"verse","number":4,"content":["གིབ་ཡོན་པ་ཡིས་མ་ཡཱ་བཅས་ཡོད་ཅིང་། ཁོ་ནི་མི་སུམ་ཅུའི་ཁྲོད་ཀྱི་དཔའ་བོ་ཡིན་པར་མ་ཟད། མི་སུམ་ཅུ་བོ་དེའི་འགོ་དཔོན་ཡང་ཡིན། ཡང་ཡེ་རེམ་ཡཱ་དང་། ཡ་ཧ་ཟི་ཨེལ། ཡོ་ཧ་ནན། གེ་དེ་རཱ་པ་ཡོ་ཟཱ་བད།"]},{"type":"verse","number":5,"content":["ཨེལ་ཨུ་ཟཱ་ཨི། ཡེ་རི་མོད། པེ་ཨལ་ཡཱ། ཤེ་མར་ཡཱ། ཧ་རོབ་པ་ཤེ་ཕད་ཡཱ།"]},{"type":"verse","number":6,"content":["ཀོ་རཱག་པ་ཨེལ་ཁ་ནཱ། ཡིས་ཤི་ཡཱ། ཨ་ཟར་ཨེལ། ཡོ་ཨེ་ཟེར། ཡ་ཤོ་བེ་ཨམ།"]},{"type":"verse","number":7,"content":["གེ་དོར་པ་ཡེ་རོ་ཧམ་གྱི་བུ་ཡོ་ཨེ་ལཱ་དང་། ཟེ་བད་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":8,"content":["གཱ་རྡུའི་ཚོ་པ་ལས་མི་ཁ་ཤས་དབེན་སྟོང་གི་རི་རྫོང་དུ་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་དུ་སོང་ཞིང་། དེ་ཐམས་ཅད་དཔའ་རྩལ་ཆེ་ལ་འཐབ་མོ་འགྱེད་པར་མཁས་པ། ཕུབ་དང་མདུང་སྤྱོད་ཤེས་པ་བཅས་ཡིན་ལ། དེ་ཚོའི་གདོང་ནི་སེང་གེ་བཞིན་དང་། རྒྱུགས་ན་རི་མགོའི་དགོ་བ་ལྟར་མྱུར་བ་ཡིན།"]},{"type":"verse","number":9,"content":["དང་པོ་ནི་ཨེ་ཟེར་དང་། གཉིས་པ་ཨོ་བད་ཡཱ། གསུམ་པ་ཨེ་ལི་ཨབ།"]},{"type":"verse","number":10,"content":["བཞི་པ་མི་སི་མན་ནཱ། ལྔ་པ་ཡེ་རེམ་ཡཱ།"]},{"type":"verse","number":11,"content":["དྲུག་པ་ཨད་ཏ་ཨི། བདུན་པ་ཨེ་ལི་ཨེལ།"]},{"type":"verse","number":12,"content":["བརྒྱད་པ་ཡོ་ཧ་ནན། དགུ་པ་ཨེལ་ཟཱ་བད།"]},{"type":"verse","number":13,"content":["བཅུ་པ་ཡེ་རེམ་ཡཱ། བཅུ་གཅིག་པ་མག་པན་ནཱ་ཨི་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["དེ་ཐམས་ཅད་ནི་གཱ་རྡུ་ཚོ་པའི་དམག་དཔོན་ཡིན་ཏེ། ཆུང་ཤོས་ཀྱིས་མི་བརྒྱ་ཁོག་པ་དང་། ཆེ་ཤོས་ཀྱིས་མི་སྟོང་ཁོག་པའོ། །"]},{"type":"verse","number":15,"content":["ཟླ་དང་པོར་ཡོར་དན་གཙང་པོའི་འགྲམ་གཉིས་ལ་ཆུ་འཕེལ་དུས་ཁོ་ཚོ་ཕ་རོལ་ཏུ་བརྒལ་ནས། ལུང་པར་གནས་པ་རྣམས་སྐྲག་ནས་ཤར་ནུབ་གང་སར་བྲོས་སོ། །"]},{"type":"verse","number":16,"content":["པེན་ཡཱ་མེན་དང་ཡ་ཧུ་དཱའི་བུ་རྒྱུད་ལས་ཀྱང་མི་ཁ་ཤས་རི་རྫོང་དུ་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་དུ་འོངས་པ་དང་།"]},{"type":"verse","number":17,"content":["དཱ་བིད་དེ་དག་བསུ་རུ་ཐོན་ནས་དེ་དག་ལ་ན་རེ། གལ་ཏེ་ཁྱོད་ཅག་ནི་ཞི་བདེ་ངང་ང་ལ་རོགས་བྱེད་དུ་འདིར་འོངས་པ་ཡིན་ན། ངས་ཁྱོད་ཅག་དང་མནའ་འབྲེལ་འཛུགས་པར་འགྱུར། ཡིན་ཡང་ཁྱོད་ཚོས་ཉེས་མེད་ང་རང་དགྲའི་ལག་ཏུ་གཏོད་ཕྱིར་འོངས་པ་ཡིན་ན། རང་ཅག་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་གིས་དེ་གཟིགས་ཤིང་ཉེས་ཆད་གཅོད་པར་ཤོག་ཅིག་ཅེས་སྨྲས་པ་ན།"]},{"type":"verse","number":18,"content":["སྐབས་དེར་དཀོན་མཆོག་གི་ཐུགས་ཉིད་ནི་དཔའ་བོ་སུམ་ཅུའི་འགོ་དཔོན་ཨ་མ་སཱ་ཨིའི་སྟེང་བབས་པ་དང་ཁོ་ན་རེ། ཀྱེ་དཱ་བིད་ལགས། ངེད་ཅག་ཁྱེད་ལ་དབང་བ་ཡིན། ཡེ་སེའི་སྲས་ལགས། ངེད་ཅག་ཁྱེད་ཀྱི་རྗེས་སུ་འབྲང་བར་འོངས་པ་ཡིན། ཁྱེད་རང་བདེ་བར་ཤོག ཁྱེད་ཀྱི་དཀོན་མཆོག་གིས་ཁྱེད་ལ་རོགས་རམ་མཛད་པས། ཁྱེད་ལ་རོགས་རམ་བྱེད་མཁན་དག་ཀྱང་བདེ་བར་གྱུར་ཅིག་ཅེས་སྨྲས་པ་ན། དཱ་བིད་ཀྱིས་དེ་དག་ནང་དུ་བསུས་ཏེ་དམག་དཔོན་དུ་བསྐོས་སོ། །"]},{"type":"verse","number":19,"content":["སྔར་དཱ་བིད་ནི་ཕེ་ལེ་ཤེད་པ་དང་མཉམ་དུ་སོ་ལོ་དང་དམག་རྒྱག་ཏུ་སོང་དུས། མཱ་ན་ཤེ་ཚོ་པའི་མི་འགའ་ཞིག་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་དུ་འོངས། ཡིན་ནའང་དེ་ཚོས་ཕེ་ལེ་ཤེད་པར་རོགས་རམ་མ་བྱས། གང་ལ་ཞེ་ན། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་གྲོས་བྱས་ནས་ཁོང་ཕྱིར་ལོག་ཏུ་བཅུག་སྟེ་ན་རེ། དཱ་བིད་ཀྱིས་རང་ཅག་གི་མགོ་བླངས་ནས་ཁོའི་བདག་པོ་སོ་ལོའི་ཕྱོགས་སུ་འགྲོ་ཉེན་ཆེ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":20,"content":["ཡང་དཱ་བིད་ནི་ཙིག་ལག་ཏུ་ཕྱིར་ལོག་པ་ན། མཱ་ན་ཤེ་ཚོ་པའི་ཨད་ནཱ་དང་། ཡོ་ཟཱ་བད། ཡེ་དི་ཡཱ་ཨེལ། མེའ་ཀཱ་ཨེལ། ཡོ་ཟཱ་བད། ཨེ་ལི་ཧུ། ཙིལ་ལེ་ཐ་ཨི་བཅས་ཁོང་ལ་རྒྱབ་བརྟེན་བཅོལ་དུ་འོངས་པ་དང་། དེ་ཐམས་ཅད་ནི་མཱ་ན་ཤེའི་ཚོ་པ་ནང་གི་སྟོང་དཔོན་ཡིན་ནོ། །"]},{"type":"verse","number":21,"content":["དེ་དག་གིས་དཱ་བིད་ལ་རོགས་བྱས་ནས་ཁོང་དང་མཉམ་དུ་ཇག་རྐུན་ལ་འཐབ་ཅིང་། ཐམས་ཅད་དམག་མི་དཔའ་རྩལ་ཅན་དང་དམག་དཔུང་གི་འགོ་དཔོན་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["དུས་དེར་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་ནས་དཔུང་གྲོགས་བྱེད་མཁན་ཉིན་རེ་བཞིན་འོངས་པས། དཀོན་མཆོག་གི་དམག་དཔུང་དང་འདྲ་བའི་དམག་དཔུང་ཆེན་པོ་ཞིག་ཏུ་གྱུར་ཏོ། །"]},{"type":"heading","content":["ཧེབ་རོན་དུ་དཱ་བིད་ལ་རྒྱབ་བརྟེན་བཅོལ་བའི་དམག་མིའི་གྲངས་ཀ"]},{"type":"verse","number":23,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་བཞིན་དུ་སོ་ལོའི་རྒྱལ་ཁྲི་དཱ་བིད་ལ་སྤྲོད་པའི་ཕྱིར། དམག་འཐབ་ལ་ཞུགས་གྲབས་ཡོད་པའི་འགོ་དཔོན་རྣམས་ཧེབ་རོན་དུ་དཱ་བིད་ཀྱི་དྲུང་དུ་འོངས་པ་དང་ཁོ་ཚོའི་མི་གྲངས་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":24,"content":["ཡ་ཧུ་དཱ་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་ཕུབ་དང་མདུང་ཐོགས་མཁན་བསྡོམས་པས་དྲུག་སྟོང་བརྒྱད་བརྒྱ་ཡོད་པ་དང་། ཐམས་ཅད་དམག་འཐབ་ལ་ཞུགས་གྲབས་ཡོད་དོ། །"]},{"type":"verse","number":25,"content":["སི་མུ་ཨོན་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་དམག་འཐབ་ལ་ཞུགས་ནུས་པའི་དམག་མི་དཔའ་རྩལ་ཅན་བསྡོམས་པས་བདུན་སྟོང་བརྒྱ་ཡོད།"]},{"type":"verse","number":26,"content":["ལེ་ཝི་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་བསྡོམས་པས་བཞི་སྟོང་དྲུག་བརྒྱ་ཡོད།"]},{"type":"verse","number":27,"content":["ཡེ་ཧོ་ཡ་དཱ་ནི་ཨ་རོན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ཡིན་ལ་ཁོའི་རྗེས་སུ་འབྲངས་པ་བསྡོམས་པས་སུམ་སྟོང་བདུན་བརྒྱ་ཡོད།"]},{"type":"verse","number":28,"content":["ན་གཞོན་དམག་མི་དཔའ་རྩལ་ཅན་ཟཱ་ཏོག་དང་། ཁོའི་ཁྱིམ་རྒྱུད་ཀྱི་དམག་དཔོན་ཉེར་གཉིས་ཀྱང་ཡོད་དོ། །"]},{"type":"verse","number":29,"content":["པེན་ཡཱ་མེན་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ཁྲོད་སོ་ལོའི་གཉེན་ཉེ་ཡང་མི་སུམ་སྟོང་ཡོད་པ་དང་། ཁོ་རྣམས་ལས་མང་ཤོས་ནི་ད་ལྟའི་བར་དུ་སོ་ལོའི་ཁྱིམ་རྒྱུད་ཀྱི་ཕྱོགས་ཡིན།"]},{"type":"verse","number":30,"content":["ཨེ་ཕཱར་ཡིམ་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ཁྲོད་རང་གི་ཁྱིམ་རྒྱུད་དུ་མིང་གྲགས་ཆེ་བའི་དམག་མི་དཔའ་རྩལ་ཅན་བསྡོམས་པས་ཉིས་ཁྲི་བརྒྱད་བརྒྱ་ཡོད།"]},{"type":"verse","number":31,"content":["མཱ་ན་ཤེའི་ཚོ་པ་ཕྱེད་ཀ་ལས་མིང་ཐོ་བཀོད་པ་བསྡོམས་པས་ཆིག་ཁྲི་བརྒྱད་སྟོང་ཡོད་པ་དང་། ཐམས་ཅད་དཱ་བིད་རྒྱལ་པོར་བསྐོ་རུ་འོངས་སོ། །"]},{"type":"verse","number":32,"content":["ཡང་ཡེས་སི་ཀཱར་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་དུས་སྐབས་ཤེས་མཁན་དང་། ཡེས་ར་ཨེལ་གྱིས་གང་བྱེད་རུང་བ་ཤེས་མཁན་བསྡོམས་པས་འགོ་དཔོན་ཉིས་བརྒྱ་ཡོད་པ་དང་། དེ་དག་གི་གཉེན་ཉེ་ཐམས་ཅད་ཀྱིས་དེ་དག་གི་བཀའ་ལ་ཉན་པ་ཡིན།"]},{"type":"verse","number":33,"content":["ཟེ་བུ་ལུན་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་ཕྱི་ལ་སོང་ནས་དམག་འཐབ་ལ་ཞུགས་ནུས་པ་དང་། མཚོན་ཆ་སྣ་ཚོགས་སྤྱོད་ཐུབ་པ། རྩེ་གཅིག་གིས་དམག་ལ་ཐོན་པ་བསྡོམས་པས་ཁྲི་ལྔ་ཡོད།"]},{"type":"verse","number":34,"content":["ཡང་ནཱབ་ཐ་ལི་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་དམག་དཔོན་ཆིག་སྟོང་ཡོད་ལ། དེ་དག་གི་རྗེས་སུ་འབྲངས་ཤིང་ཕུབ་དང་མདུང་ཐོགས་མཁན་བསྡོམས་པས་སུམ་ཁྲི་བདུན་སྟོང་ཡོད།"]},{"type":"verse","number":35,"content":["དཱན་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་དམག་འཐབ་ལ་ཞུགས་ནུས་པ་བསྡོམས་པས་ཉིས་ཁྲི་བརྒྱད་སྟོང་དྲུག་བརྒྱ་ཡོད།"]},{"type":"verse","number":36,"content":["ཨ་ཤེར་ཚོ་པའི་བུ་རབས་ཚ་རྒྱུད་ལས་གཡུལ་ངོར་སོང་ནས་དམག་འཐབ་ལ་ཞུགས་ནུས་པ་བསྡོམས་པས་ཁྲི་བཞི་ཡོད།"]},{"type":"verse","number":37,"content":["ཡང་ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་ཀྱི་རུ་བེན་གྱི་ཚོ་པ་དང་། གཱ་རྡུའི་ཚོ་པ། མཱ་ན་ཤེའི་ཚོ་པ་ཕྱེད་ཀ་བཅས་ལས་མཚོན་ཆ་རིགས་སྣ་ཚོགས་ཐོགས་པ་བསྡོམས་པས་ཆིག་འབུམ་ཉིས་ཁྲི་ཡོད།"]},{"type":"verse","number":38,"content":["གོང་གི་དམག་མི་ཐམས་ཅད་རུ་བསྒྲིགས་ཏེ་བློ་སེམས་རྩེ་གཅིག་གིས་དཱ་བིད་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་བར་ཧེབ་རོན་དུ་འོངས་པ་དང་། ཡེས་ར་ཨེལ་པ་གཞན་ཀུན་ཡང་དཱ་བིད་རྒྱལ་པོར་བསྐོ་བར་བློ་སེམས་རྩེ་གཅིག་ཡིན་ནོ། །"]},{"type":"verse","number":39,"content":["དེ་དག་ཉིན་ཞག་གསུམ་གྱི་རིང་ལ་དཱ་བིད་དང་ལྷན་ཅིག་བཟའ་བཏུང་རོལ་ནས་བསྡད་པ་ཡིན་ཏེ། དེ་དག་གི་གཉེན་ཉེ་རྣམས་ཀྱིས་དེ་དག་གི་ཆེད་དུ་ཁ་ཟས་གཡོས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":40,"content":["དེ་དག་གི་ཉེ་སར་ཡོད་པའི་ཡེས་སི་ཀཱར་དང་། ཟེ་བུ་ལུན། ནཱབ་ཐ་ལི་བཅས་ཚོ་པའི་མི་རྣམས་ཀྱིས་བག་ལེབ་དང་། སེ་ཡབ་ལེབ་མོ་དང་། རྒུན་འབྲུམ་སྐམ་པོ་ལེབ་མོ་དང་། རྒུན་ཆང་དང་། སྣུམ་བཅས་ཁ་ཟས་མང་པོ་བོང་བུ་དང་རྔ་མོང་། དྲེལ། བ་གླང་བཅས་ལ་བཀལ་ནས་བསྐྱལ་འོངས་པ་དང་། ཡང་བ་གླང་དང་ར་ལུག་མོད་པོ་ཁྲིད་འོངས་པ་སྟེ། ཡེས་ར་ཨེལ་ཡུལ་ཡོངས་ལ་དགའ་སྤྲོས་ཁེངས་པས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/11.json","previousChapterAudioLinks":{},"numberOfVerses":40}