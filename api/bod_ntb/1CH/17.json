{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":17,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་དཱ་བིད་ལ་གནང་བའི་ཞལ་བཞེས།"]},{"type":"verse","number":1,"content":["དཱ་བིད་རང་གི་ཕོ་བྲང་ནང་དུ་བསྡད་པའི་རྗེས་སུ། ཁོང་གིས་ལུང་སྟོན་པ་ནཱ་ཐན་ལ་ན་རེ། ལྟོས་དང་། ང་ནི་ཐང་ཤིང་གིས་བཟོས་པའི་ཕོ་བྲང་དུ་སྡོད་མོད། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་གུར་གྱི་ནང་དུ་མཆིས་སོ་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":2,"content":["ནཱ་ཐན་གྱིས་དཱ་བིད་ལ་ན་རེ། དཀོན་མཆོག་ཁྱེད་དང་མཉམ་དུ་བཞུགས་པས། ཁྱེད་ཀྱི་ཐུགས་དགོངས་བཞིན་བྱོས་ཤིག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":3,"content":["མཚན་མོ་དེར་དཀོན་མཆོག་གི་བཀའ་ནཱ་ཐན་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":4,"content":["ཁྱོད་སོང་ནས་བདག་གི་ཞབས་ཕྱི་དཱ་བིད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བདག་གནས་སའི་མཆོད་ཁང་བཞེང་མི་རུང་།"]},{"type":"verse","number":5,"content":["གང་ལ་ཞེ་ན། བདག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཡར་ཁྲིད་འོངས་པའི་ཉིན་ནས་དེ་རིང་བར་དུ་བདག་ནི་མཆོད་ཁང་དུ་གནས་མ་མྱོང་སྟེ། བདག་ནི་གུར་མཆོག་གཅིག་ནས་གུར་མཆོག་གཞན་ཞིག་ལ་སྤར་ནས་གནས་པ་ཡིན།"]},{"type":"verse","number":6,"content":["བདག་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་དང་ལྷན་ཅིག་ཏུ་གང་སར་རྒྱུ་རུང་། ངས་རང་གི་མི་རྣམས་འཚོ་སྐྱོང་བྱེད་པར་བཀའ་བསྒོས་པའི་ཁྲིམས་དཔོན་སུ་ལ་ཡང་། ཁྱོད་ཚོས་ངའི་དོན་དུ་ཐང་ཤིང་གི་མཆོད་ཁང་མི་བཞེང་བ་ཅི་ཡིན་ཞེས་སྨྲས་མྱོང་ངམ་གསུངས་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":7,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་བདག་གི་ཞབས་ཕྱི་དཱ་བིད་ལ་འདི་ལྟར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་འགོ་དཔོན་དུ་གྱུར་ནས་བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་བདག་སྐྱོང་བྱེད་པའི་ཕྱིར། ངས་ཁྱོད་རང་ལུག་ར་ནས་ཕྱི་རུ་བླངས་པ་དང་ལུག་ཁྱུའི་རྗེས་སུ་མི་འདེད་པར་བྱས།"]},{"type":"verse","number":8,"content":["ཁྱོད་གང་ལ་སོང་ཡང་ང་རང་ཁྱོད་དང་མཉམ་དུ་གནས་ཏེ། དགྲ་བོ་ཐམས་ཅད་ཁྱོད་ཀྱི་མདུན་ནས་མེད་པར་གཏོང་ཞིང་། ས་སྟེང་གི་མི་རླབས་ཆེན་དག་གི་མཚན་སྙན་དང་འདྲ་བར་ངས་ཁྱོད་ཀྱི་མཚན་སྙན་གྲགས་རྒྱས་པར་བྱའོ། །"]},{"type":"verse","number":9,"content":["ཡང་ངས་རང་གི་འབངས་མི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་དོན་དུ་ས་ཆ་ཞིག་བདམས་ནས། ཁོ་རྣམས་དེར་ཚུགས་སུ་འཇུག་པ་དང་། ཁོ་རྣམས་རང་གནས་སུ་སྡོད་ཅིང་གཞན་གྱི་བར་ཆད་མི་འཕོག་ལ། བུ་རྒྱུད་ངན་པ་རྣམས་ཀྱིས་ཀྱང་སྔར་བཞིན་དེ་དག་ལ་འཚེ་བར་མི་འགྱུར་ཞིང་།"]},{"type":"verse","number":10,"content":["བདག་གིས་རང་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་ཁྲིམས་དཔོན་བསྐོས་པའི་དུས་དང་འདྲ་བར་ཡང་མི་འགྱུར། བདག་གིས་ཁྱོད་ཀྱི་དགྲ་ཐམས་ཅད་འདུལ་བར་མ་ཟད་ངས་ཁྱོད་ལ་སྨྲ་བར་བྱ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེ་བདག་གིས་ཁྱོད་ཀྱི་དོན་དུ་ཁྱིམ་རྒྱུད་འཛུགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་རང་ཚེ་ལོ་མཐར་ཕྱིན་ཏེ་རང་གི་མེས་པོ་རྣམས་ཀྱི་གྲས་སུ་ཚུད་པའི་དུས་སུ། བདག་གིས་ཁྱོད་ཀྱི་བུ་རྒྱུད་རྣམས་ལས་གཅིག་ཡར་འདེགས་ཤིང་ཁྱོད་ཀྱི་རྗེས་སྐྱོང་བར་བྱ་སྟེ། དེའི་རྒྱལ་སྲིད་བརྟན་པར་བྱའོ། །"]},{"type":"verse","number":12,"content":["དེས་བདག་ལ་མཆོད་ཁང་ཞིག་བཞེང་བ་དང་། བདག་གིས་དེའི་རྒྱལ་ཁྲི་ཇི་སྲིད་བར་དུ་བརྟན་པར་བྱའོ། །"]},{"type":"verse","number":13,"content":["བདག་ནི་ཁོ་ཡི་ཕ་དང་ཁོ་ནི་བདག་གི་བུ་རུ་འགྱུར་ཏེ། བདག་གིས་རང་གི་བྱམས་བརྩེ་ནི་ཁྱོད་ཀྱི་གོང་མ་དང་འབྲལ་དུ་བཅུག་པ་བཞིན་དུ་ནམ་ཡང་དེ་དང་འབྲལ་བར་མི་བྱའོ། །"]},{"type":"verse","number":14,"content":["བདག་གིས་དེ་ནི་ཇི་སྲིད་བར་དུ་ངའི་ཁྱིམ་རྒྱུད་དང་རྒྱལ་སྲིད་བསྐྱང་བར་འཇོག་ཅིང་། དེའི་རྒྱལ་ཁྲི་ནི་རྟག་ཏུ་བརྟན་པར་འགྱུར་རོ་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ནཱ་ཐན་གྱིས་བཀའ་དེ་དང་ཁོས་ཅི་མཐོང་བ་ཐམས་ཅད་ཇི་བཞིན་དུ་དཱ་བིད་ལ་སྨྲས་པའོ། །"]},{"type":"heading","content":["བཀའ་དྲིན་ཞུ་བའི་སྨོན་ལམ།"]},{"type":"verse","number":16,"content":["དེ་ནས་རྒྱལ་པོ་དཱ་བིད་ནང་ལ་སོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བསྡད་དེ་འདི་ལྟར། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། བདག་ནི་སུ་ཡིན་ནམ། བདག་གི་ཁྱིམ་རྒྱུད་ནི་ཅི་ཡིན་ནམ། ཁྱེད་ཀྱིས་ད་དུང་བདག་འདི་ཙམ་གྱི་བར་དུ་བསྐྱངས་པའོ། །"]},{"type":"verse","number":17,"content":["ཀྱེ་དཀོན་མཆོག་ལགས། དོན་འདི་ཁྱེད་ཀྱི་གཟིགས་ངོར་ཆུང་བར་སྣང་ཞིང་། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱིའི་ཁྱིམ་རྒྱུད་ཀྱི་མ་འོངས་འབྱུང་འགྱུར་ཐད་བཀའ་ལུང་གནང་བའོ། །ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་བདག་ནི་མི་མཆོག་ཏུ་གྱུར་པ་ཞིག་གི་ཚད་དུ་བཞག་གོ །"]},{"type":"verse","number":18,"content":["ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་ལ་བཀུར་སྟི་བསྩལ་བར་ངས་ཁྱེད་ལ་ད་དུང་ཅི་ཞིག་ཞུ་བར་བྱའམ། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་མཁྱེན་ནོ། །"]},{"type":"verse","number":19,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཉིད་ཀྱི་ཞབས་ཕྱིའི་དོན་དུ་ཁྱེད་ཀྱི་ཐུགས་དགོངས་བཞིན་དུ། ཁྱེད་ཀྱིས་འཕྲིན་ལས་ཆེན་པོ་དེ་རྣམས་མཛད་ཅིང་ཡང་དོན་ཆེན་དེ་ཐམས་ཅད་མི་རྣམས་ལ་མངོན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ངེད་རྣམས་ཀྱི་རྣ་བས་ཐོས་པ་བཞིན་དུ་ཁྱེད་ལ་འགྲན་ཟླ་སུ་ཡང་མེད། ཁྱེད་མ་གཏོགས་དཀོན་མཆོག་གཞན་སུ་ཡང་མེད།"]},{"type":"verse","number":21,"content":["ས་སྟེང་དུ་མི་རིགས་གང་ཞིག་ཁྱེད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་དོའམ། དཀོན་མཆོག་གིས་དངོས་སུ་ཁོ་རྣམས་བསྐྱབས་ཤིང་ཉིད་ཀྱི་འབངས་མིར་མཛད་པ་དང་། ཡང་དཀོན་མཆོག་གིས་ཨེ་ཅིབ་ཡུལ་ནས་བླུས་པའི་མི་རྣམས་ཀྱི་མདུན་དུ་མི་གཞན་རྣམས་བསྐྲད་ཅིང་། དོན་ཆེན་འཇིགས་རུང་རྣམས་ཀྱིས་ཉིད་ཀྱི་མཚན་ཚུགས་པར་མཛད་དོ། །"]},{"type":"verse","number":22,"content":["ཁྱེད་ཀྱིས་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་ནི་ཇི་སྲིད་བར་དུ་ཉིད་ཀྱི་མི་རུ་མཛད། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱང་དེ་དག་གི་དཀོན་མཆོག་ཏུ་གྱུར་པ་ཡིན།"]},{"type":"verse","number":23,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ད་ནི་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་དང་དེའི་ཁྱིམ་རྒྱུད་ལ་གནང་བའི་ཞལ་བཞེས་དེ་ནི་ཇི་སྲིད་བར་དུ་བརྟན་པོར་མཛད་ཅིང་། ཅི་གསུངས་བཞིན་དུ་བསྒྲུབ་པར་མཛོད་ཅིག"]},{"type":"verse","number":24,"content":["ཁྱེད་ཀྱི་མཚན་ནི་རྟག་ཏུ་བརྟན་ཞིང་རབ་ཏུ་འཕགས་པ་དང་། མི་ཐམས་ཅད་ཀྱིས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡིན་པ་དང་། དངོས་གནས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ལགས་སོ་ཞེས་བརྗོད་པར་ཤོག དེ་ནས་ཁྱེད་ཀྱི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་དེ་ཡང་ཁྱེད་ཀྱི་སྤྱན་སྔར་བརྟན་པོར་ཚུགས་པའོ། །"]},{"type":"verse","number":25,"content":["ཀྱེ་བདག་གི་དཀོན་མཆོག་ལགས། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་ལ། ཁྱེད་ཀྱིས་ཁོ་བོའི་དོན་དུ་ཁྱིམ་རྒྱུད་འཛུགས་པར་བྱའོ་ཞེས་མངོན་པར་མཛད་པས། ཞབས་ཕྱི་བདག་ལ་ད་གཟོད་སེམས་ནས་འདི་བཞིན་གསོལ་བ་འདེབས་པའི་སྙིང་སྟོབས་ཡོད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཁོ་ན་དཀོན་མཆོག་ཡིན་ལ། ཁྱེད་ཀྱིས་དེ་སྔར་ཉིད་ཀྱི་ཞབས་ཕྱི་ལ་གཡང་འདི་དག་གནང་བར་ཁས་བླངས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["ད་ནི་ཉིད་ཀྱི་ཞབས་ཕྱིའི་ཁྱིམ་ལ་བྱིན་རླབས་གནང་ནས་དེ་ནི་དུས་རྒྱུན་དུ་ཁྱེད་ཀྱི་སྤྱན་སྔར་གནས་པར་མཛོད་ཅིག ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱིའི་ཁྱིམ་རྒྱུད་ལ་བྱིན་རླབས་གནང་བ་ཡིན་པས། དེ་ལ་ཇི་སྲིད་བར་དུ་བྱིན་རླབས་འཐོབ་པར་འགྱུར་རོ་ཞེས་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}