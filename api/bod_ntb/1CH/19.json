{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":19,"content":[{"type":"heading","content":["ཨམ་མོན་པ་དང་ཨ་རམ་པ་རྣམས་ཕམ་པར་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་ཨམ་མོན་པའི་རྒྱལ་པོ་ནཱ་ཧ་སི་ཚེ་ལས་འདས་པ་དང་། ཁོའི་སྲས་ཧ་ནུན་ནི་ཕ་ཡི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར།"]},{"type":"verse","number":2,"content":["དེར་དཱ་བིད་ན་རེ། ཧ་ནུན་གྱི་ཡབ་ཀྱིས་སྔར་ང་རང་དྲིན་གྱིས་བསྐྱངས་པས། ངས་ནཱ་ཧ་སི་ཡི་སྲས་ཧ་ནུན་ལ་ཡང་དྲིན་གཟོ་བར་བྱའོ་གསུངས་ནས། དཱ་བིད་ཀྱིས་དེའི་ཡབ་གྲོངས་པ་ལ་སེམས་གསོ་བྱེད་དུ་རང་གི་བང་ཆེན་མངགས། དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ཨམ་མོན་པའི་མངའ་ཁོངས་སུ་སླེབས་ཤིང་ཧ་ནུན་ལ་སེམས་གསོ་བྱེད་དུ་སོང་ཙ་ན།"]},{"type":"verse","number":3,"content":["ཨམ་མོན་པའི་འགོ་དཔོན་རྣམས་ཀྱིས་ཧ་ནུན་ལ་འདི་ལྟར། དཱ་བིད་ཀྱིས་ཁྱེད་ལ་སེམས་གསོ་བྱེད་མཁན་མངགས་པ་འདི་ནི་ཁྱེད་ཀྱི་ཡབ་ལ་གུས་བཀུར་བྱེད་པ་ཡིན་འདོད་དམ། ཁོའི་འཁོར་གཡོག་དག་ཡུལ་འདིར་ལྟ་ཉུལ་བྱེད་པ་དང་། ཡུལ་འདི་འཇོམས་པ། ཡུལ་འདིར་མྱུལ་ཞིབ་བྱེད་པ་བཅས་སུ་མངགས་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":4,"content":["ཧ་ནུན་གྱིས་དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་བཟུང་ནས་སྨ་ར་བྲེགས་ཤིང་། ཕྱི་གོས་བཅད་ནས་འཕོངས་ཚོས་ཕྱི་རུ་མངོན་ཞིང་དེ་དག་འགྲོ་རུ་བཅུག་གོ །"]},{"type":"verse","number":5,"content":["དེར་མི་ཞིག་སོང་ནས་དཱ་བིད་ལ་མི་དེ་ཚོ་ཕྲད་པའི་དོན་རྣམས་བཤད་པ་དང་། ཁོང་གིས་བང་ཆེན་རྣམས་དེ་དག་བསུ་རུ་མངགས་སོ། །ཡང་དེ་དག་རབ་ཏུ་ངོ་ཚ་བར་གྱུར་པས། རྒྱལ་པོས་དེ་ཚོར་ན་རེ། ཁྱོད་ཅག་གི་སྨ་ར་སྐྱེ་བའི་བར་དུ་ཡེ་རུ་ཀོ་རུ་སྒུག་སྡོད་ལ་དེ་ནས་ཤོག་ཅིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་ཨམ་མོན་པ་རྣམས་ཀྱིས་དཱ་བིད་ཁོ་ཚོ་ལ་ཞེ་སྡང་ལངས་པ་རྟོགས་ནས། ཧ་ནུན་དང་ཨམ་མོན་པ་རྣམས་ཀྱིས་མེ་སོ་པོ་ཐེམ་ཡཱ་དང་། ཨ་རམ་གྱི་མ་ཨ་ཀཱ་དང་། ཙོ་བཱ་བཅས་ལས་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་གླ་བའི་ཕྱིར་དངུལ་རྡོ་ཚད་ཆིག་སྟོང་བསྐུར་ནས།"]},{"type":"verse","number":7,"content":["དེ་དག་གིས་ཤིང་རྟ་སུམ་ཁྲི་ཉིས་སྟོང་དང་། ཡང་མ་ཨ་ཀཱ་ཡི་རྒྱལ་པོ་དང་དེའི་དམག་དཔུང་བཅས་གླས་ཤིང་། དེ་ཐམས་ཅད་འོངས་ནས་མེ་དེ་བཱ་ཡི་མདུན་དུ་སྒར་བཏབ་པ་དང་། ཨམ་མོན་པ་རྣམས་ཀྱང་རང་རང་གི་གྲོང་ཁྱེར་ནས་ཕྱོགས་གཅིག་ཏུ་འདུས་ཏེ་འཐབ་ཏུ་འོངས།"]},{"type":"verse","number":8,"content":["དཱ་བིད་ཀྱིས་གཏམ་དེ་ཐོས་ནས། ཡོ་ཨབ་དང་དམག་མི་དཔའ་རྩལ་ཅན་ཐམས་ཅད་མངགས་པ་ལ།"]},{"type":"verse","number":9,"content":["ཨམ་མོན་པ་རྣམས་ཕྱི་རུ་ཐོན་ནས་མཁར་སྒོའི་མདུན་དུ་དམག་བཤམས་པ་དང་། དེར་དཔུང་གྲོགས་སུ་འོངས་པའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཀྱང་སོ་སོར་མཁར་ཕྱི་རུ་དམག་བཀྲམས་ནས་བསྡད།"]},{"type":"verse","number":10,"content":["ཡོ་ཨབ་ཀྱིས་རང་གི་མདུན་རྒྱབ་གཉིས་པོར་དགྲ་བོ་ཡོད་པ་མཐོང་ནས། ཡེས་ར་ཨེལ་གྱི་དམག་མི་དཔའ་རྩལ་ཅན་ཐམས་ཅད་ལས་སྐོར་ཞིག་བདམས་ཏེ་ཨ་རམ་པར་འཐབ་ཏུ་དམག་བཤམས་པའོ། །"]},{"type":"verse","number":11,"content":["ཁོས་དམག་གཞན་དག་རང་གི་གཅུང་པོ་ཨ་བི་ཤཱ་ཨི་ཡི་ལག་ཏུ་གཏད་ནས། ཨམ་མོན་པར་འཐབ་ཏུ་དམག་བཤམ་དུ་བཅུག"]},{"type":"verse","number":12,"content":["ཡོ་ཨབ་ཀྱིས་ཨ་བི་ཤཱ་ཨི་ལ་ན་རེ། གལ་ཏེ་ཨ་རམ་པ་ང་ལས་དྲག་ན་ཁྱོད་ང་ལ་རོགས་བྱེད་དུ་ཤོག གལ་ཏེ་ཨམ་མོན་པ་ཁྱོད་ལས་དྲག་ན་ང་ཁྱོད་ལ་རོགས་བྱེད་དུ་འོང་།"]},{"type":"verse","number":13,"content":["རང་ཅག་གིས་སྙིང་སྟོབས་བསྐྱེད་དགོས། བདག་ཅག་གི་ཡུལ་མི་དང་རང་རེའི་དཀོན་མཆོག་གི་གྲོང་ཁྱེར་རྣམས་ཀྱི་དོན་དུ་སྙིང་སྟོབས་བསྐྱེད་དགོས། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་ལམ་དུ་གང་ཞིག་ལེགས་པ་དེ་སྒྲུབས་པར་ཤོག་ཅེས་གདམས་པས།"]},{"type":"verse","number":14,"content":["ཡོ་ཨབ་འཁོར་དང་བཅས་པ་རྣམས་སོང་སྟེ་ཨ་རམ་པ་ལ་རྒོལ་བ་དང་། དེ་དག་ཁོའི་མདུན་ནས་བྲོས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་ཨམ་མོན་པ་དག་གིས་ཨ་རམ་པ་རྣམས་བྲོས་སོང་བ་མཐོང་བས། དེ་དག་ཀྱང་ཡོ་ཨབ་ཀྱི་གཅུང་པོ་ཨ་བི་ཤཱ་ཨིའི་མདུན་ནས་བྲོས་ཏེ་གྲོང་ཁྱེར་ནང་དུ་འཛུལ་ཞིང་། དེ་ནས་ཡོ་ཨབ་ནི་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":16,"content":["ཨ་རམ་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་མདུན་དུ་རང་ཕམ་པ་མཐོང་ནས། བང་ཆེན་མངགས་ནས་གཙང་པོའི་ཕ་རོལ་ཏུ་ཡོད་པའི་ཨ་རམ་པ་རྣམས་སྤར་འོངས་ཏེ། ཧ་དད་ཨི་སེར་གྱི་དམག་དཔོན་ཤོ་ཕག་བྱ་བས་དེ་དག་ལ་འགོ་ཁྲིད་བྱས།"]},{"type":"verse","number":17,"content":["མི་ཞིག་གིས་དོན་དེ་དཱ་བིད་ལ་ཞུས་པས། ཁོང་གིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་བསྡུས་ནས་ཡོར་དན་གཙང་བོའི་ཕ་རོལ་ཏུ་ཨ་རམ་པའི་རྩར་ཕྱིན་ཅིང་དེ་རྣམས་ལ་དམག་བཤམས། ཁོང་གིས་ཨ་རམ་པ་ལ་འཐབ་ཏུ་དམག་བཤམས་པ་ལ། ཨ་རམ་པས་ཁོང་དང་འཐབ།"]},{"type":"verse","number":18,"content":["ཨ་རམ་པ་རྣམས་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་བྲོས་སོང་བས། དཱ་བིད་ཀྱིས་ཨ་རམ་པའི་ཤིང་རྟ་བདུན་སྟོང་སྟེང་གི་སྐྱ་དམག་དང་རྐང་དམག་བཞི་ཁྲི་བསད་པ་དང་། ཨ་རམ་པའི་དམག་དཔོན་ཤོ་ཕག་ཀྱང་བསད་དོ། །"]},{"type":"verse","number":19,"content":["དེར་ཧ་དད་ཨི་སེར་གྱི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་མདུན་དུ་རང་ཕམ་པ་མཐོང་ནས། དཱ་བིད་དང་འདུམ་ཐབས་བྱས་ཏེ་ཁོང་གི་མངའ་འོག་ཏུ་གྱུར་པ་དང་། དེ་ནས་ཨ་རམ་པ་རྣམས་ཀྱིས་ཡང་བསྐྱར་ཨམ་མོན་པ་ལ་རོགས་བྱེད་མ་ཕོད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/18.json","previousChapterAudioLinks":{},"numberOfVerses":19}