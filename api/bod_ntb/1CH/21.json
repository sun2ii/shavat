{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":21,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་མི་གྲངས་བླངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་བདུད་སཱ་ཏན་གྱིས་ཡེས་ར་ཨེལ་གྱི་དགྲ་རུ་ལངས་ནས། དཱ་བིད་ལ་ཡེས་ར་ཨེལ་པའི་མི་གྲངས་ལེན་པར་ངན་སྐུལ་བྱས་པས།"]},{"type":"verse","number":2,"content":["དཱ་བིད་ཀྱིས་ཡོ་ཨབ་དང་མི་རྣམས་ཀྱི་འགོ་དཔོན་རྣམས་ལ་ན་རེ། ཁྱོད་ཅག་སོང་ལ་དཱན་ནས་པེར་ཤ་བཱའི་བར་དུ་ཡེས་ར་ཨེལ་པའི་མི་གྲངས་ལོངས་ཤིག དེ་ནས་ཕྱིར་ཤོག་ལ་ཁོ་རྣམས་ཀྱི་མི་གྲངས་ང་ལ་ཤོད་ཅིག་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":3,"content":["ཡོ་ཨབ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་འབངས་མི་ད་ལྟ་ཡོད་པ་ལས་ལྡབ་བརྒྱ་ཡིས་མང་དུ་འཕེལ་བར་མཛོད་ཅིག ཀྱེ་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལགས། དེ་ཐམས་ཅད་ངའི་གཙོ་བོའི་ཞབས་ཕྱི་མ་ཡིན་ནམ། ངའི་གཙོ་བོས་དེ་ལྟར་བྱས་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་སྡིག་པའི་ནང་དུ་ལྷུང་བར་བྱེད་དོན་ཅི་ཡིན་ནམ་ཞེས་ཞུས་མོད།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་རྒྱལ་པོས་རང་གི་བཀའ་མཁྲེགས་འཛིན་བྱས་པས་ཡོ་ཨབ་ཀྱིས་དེ་བཟློག་མ་ནུས་པར། ཁོ་ཕྱི་རུ་སོང་སྟེ་ཡེས་ར་ཨེལ་ཡུལ་ཀུན་བརྒྱུད་ནས་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་གོ །"]},{"type":"verse","number":5,"content":["ཡོ་ཨབ་ཀྱིས་མི་མང་གི་གྲངས་ཀ་བླངས་པའི་མི་གྲངས་ཀྱི་ཐོ་དཱ་བིད་ལ་ཕུལ་ཏེ། ཡེས་ར་ཨེལ་ཀུན་ཏུ་རལ་གྲི་འཛིན་ཐུབ་པའི་སྐྱེས་པ་བསྡོམས་པས་འབུམ་བཅུ་གཅིག་དང་། ཡ་ཧུ་དཱ་རུ་རལ་གྲི་འཛིན་ཐུབ་པའི་སྐྱེས་པ་འབུམ་བཞི་དང་ཁྲི་བདུན་ཡོད་པ་རེད།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་ཡོ་ཨབ་རྒྱལ་པོའི་བཀའ་འདི་ལ་ཞེན་ཁ་ལོག་པས། ཁོས་ལེ་ཝི་པ་དང་པེན་ཡཱ་མེན་པའི་མི་གྲངས་དེ་དག་གི་ཁྲོད་དུ་མ་བརྩིས་སོ། །"]},{"type":"verse","number":7,"content":["ཡང་དཀོན་མཆོག་དོན་འདི་ལ་ཐུགས་མ་མཉེས་པས། ཁོང་གིས་ཡེས་ར་ཨེལ་ལ་གནོད་འཚེ་བཏང་ངོ་། །"]},{"type":"verse","number":8,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ལ་འདི་ལྟར། བདག་གིས་དོན་འདི་བྱས་པས་སྡིག་པ་ཆེན་པོ་བསགས་པ་དང་། བདག་གིས་ཤིན་ཏུ་གླེན་པའི་དོན་བྱས་པས། ཁྱེད་ཀྱི་ཞབས་ཕྱིའི་སྡིག་ཉེས་བསལ་བར་མཛོད་ཅེས་གསོལ་ཏོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་དཱ་བིད་ཀྱི་མངོན་ཤེས་པ་གཱ་རྡུ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":10,"content":["ཁྱོད་སོང་ནས་དཱ་བིད་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་འདི་སྐད་དུ། ངས་ཁྱོད་ལ་དོན་གསུམ་འདོན་ཏེ་ཁྱོད་ཀྱིས་དེ་རྣམས་ལས་གཅིག་འདེམས་ཤིག་དང་། ངས་དེ་བཞིན་དུ་ཁྱོད་ལ་བྱའོ་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་པ་དང་།"]},{"type":"verse","number":11,"content":["གཱ་རྡུ་ནི་དཱ་བིད་ཀྱི་དྲུང་དུ་འོངས་ནས་ཁོང་ལ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་འདེམས་ཤིག"]},{"type":"verse","number":12,"content":["ལོ་གསུམ་གྱི་མུ་གེའམ། ཡང་ན་ཟླ་བ་གསུམ་གྱི་རིང་ལ་ཁྱོད་རང་གི་དགྲ་བོའི་མདུན་ནས་འབྲོ་ཞིང་དེ་རྣམས་ཀྱི་རལ་གྲིས་ཁྱོད་རང་འདེད་པའམ། ཡང་ན་ཉིན་ཞག་གསུམ་ལ་ཡུལ་འདིར་རིམས་ནད་འབྱུང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཕྱོགས་ཀུན་ཏུ་ཚར་གཅོད་བྱེད་པ་བཅས་ལས་གང་འདོད་དམ་ཞེས་གསུངས། ད་ང་རང་མངགས་མཁན་ལ་ཞུ་ལན་གང་ཞིག་འབུལ་བར་ཁྱོད་ཀྱིས་བསམ་བློ་ཐོངས་ཤིག་བསྒོས་པ་དང་།"]},{"type":"verse","number":13,"content":["དཱ་བིད་ཀྱིས་གཱ་རྡུ་ལ་ན་རེ། བདག་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཐུགས་རྗེ་འཛད་མཐའ་མེད་པ་མངའ་བས་ན་ང་རང་མི་ཡི་ལག་ཏུ་མི་ལྷུང་བར་ཁོང་གི་ཕྱག་ནང་ལྷུང་བར་དགའོ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་སྟེང་དུ་རིམས་ནད་ཕབ་ནས། ཡེས་ར་ཨེལ་པ་ལས་མི་ཁྲི་བདུན་ཚེ་ལས་འདས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་དཀོན་མཆོག་གིས་ཕོ་ཉ་ཞིག་ཡེ་རུ་སཱ་ལེམ་ཚར་གཅོད་བྱེད་དུ་མངགས་ནས། དེས་ཚར་གཅོད་བྱེད་པར་བརྩམས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་གཟིགས་ནས་བར་ཆད་དེའི་ཕྱིར་ཐུགས་འགྱོད་ཅིང་། ཚར་གཅོད་བྱེད་མཁན་ཕོ་ཉ་དེ་ལ་འདི་སྐད་དུ། ད་ཆོག་སོང་། མཚམས་ཞོག་ཅིག་ཅེས་བསྒོས་སོ། །དེའི་ཚེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ནི་ཡེ་བུ་སི་པ་ཨོར་ནན་གྱི་གཡུལ་ཁའི་ཉེ་འགྲམ་དུ་འགྲེང་བསྡད་ཡོད་པ་ཡིན།"]},{"type":"verse","number":16,"content":["དཱ་བིད་ཀྱིས་མགོ་ཡར་བཏེགས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་དེ་གནམ་ས་གཉིས་ཀྱི་བར་དུ་ལག་ལ་ཤུབས་ནས་ཕྱུང་བའི་རལ་གྲི་ཐོགས་ཤིང་། ཡེ་རུ་སཱ་ལེམ་ཕྱོགས་སུ་བརྐྱངས་ནས་འགྲེང་ཡོད་པ་མཐོང་བ་དང་། དཱ་བིད་དང་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ཀྱིས་རྩིད་རས་གྱོན་ནས་ཕྱག་བཙལ་ཏེ།"]},{"type":"verse","number":17,"content":["དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ལ། མིའི་གྲངས་ཀ་ལེན་པར་བསྒོ་མཁན་བདག་མ་ཡིན་ནམ། ངས་སྡིག་པ་བྱས་ནས་དོན་ངན་ཆེན་པོ་འདི་བསྒྲུབས་པའོ། །ལུག་ཁྱུ་འདིས་ཅི་བྱས་སམ། ཀྱེ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱི་ཕྱག་གིས་བདག་དང་བདག་གི་ཁྱིམ་རྒྱུད་ལ་རྒོལ་བར་མཛད་དུ་གསོལ། ཁྱེད་ཀྱི་འབངས་མིའི་སྟེང་ལ་རིམས་ནད་འབེབ་མི་རུང་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་གཱ་རྡུ་མངགས་ནས་དཱ་བིད་ལ། ཡར་ཡེ་བུ་སི་པ་ཨོར་ནན་གྱི་གཡུལ་ཁ་རུ་སོང་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བཞེང་དགོས་ཞེས་བསྒོས་པ་དང་།"]},{"type":"verse","number":19,"content":["དཱ་བིད་ནི་གཱ་རྡུས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ལ་བརྟེན་ནས་ཅི་གསུངས་པ་བཞིན་དུ་ཡར་སོང་བ་དང་།"]},{"type":"verse","number":20,"content":["དུས་དེར་ཨོར་ནན་གྱིས་གྲོ་ཡི་སྙེ་མ་རྡུང་བཞིན་ཡོད་པ་དང་ཁ་ཕྱིར་འཁོར་ནས་བལྟས་པ་ལ་ཕོ་ཉ་དེ་མཐོང་བ་དང་། རང་གི་བུ་བཞི་པོ་དང་མཉམ་དུ་ཡིབ།"]},{"type":"verse","number":21,"content":["དཱ་བིད་ཨོར་ནན་གྱི་རྩར་སླེབས་པ་དང་ཨོར་ནན་གྱིས་ཁོང་མཐོང་ནས་གཡུལ་ཁ་ནས་ཐོན་ཏེ། དཱ་བིད་ལ་ཕྱག་བཙལ་ཏོ། །"]},{"type":"verse","number":22,"content":["དེར་དཱ་བིད་ཀྱིས་ཨོར་ནན་ལ་ན་རེ། ངས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བརྩིག་པའི་ཕྱིར་གཡུལ་ཁའི་ས་འདི་ང་ལ་སྟེར་བར་མཛོད། དེ་ནས་མི་རྣམས་ཀྱི་རིམས་ནད་འགོག་ཐུབ་བོ། །ཁྱོད་ཀྱིས་རིན་ཁ་ཚང་བརྩིས་ནས་ང་ལ་སྟེར་བར་མཛོད་ཅེས་སྨྲས།"]},{"type":"verse","number":23,"content":["ཨོར་ནན་གྱིས་དཱ་བིད་ལ་ལན་དུ། ཁྱེད་ཀྱིས་བཞེས་ཤིག ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོའི་གཟིགས་ངོར་གང་ལེགས་ན་དེ་བཞིན་མཛོད་ཅིག ཁྱེད་ཀྱིས་གཟིགས་དང་། ངས་བ་གླང་རྣམས་སྦྱིན་སྲེག་གི་ཕྱིར་དང་། གཡུལ་ཁ་གཅོག་བྱེད་ཡོ་ཆས་རྣམས་བུད་ཤིང་དུ་བྱེད་པ་དང་། གྲོ་ནི་འབྲུ་རིགས་ཀྱི་མཆོད་པའི་ཕྱིར་ཐམས་ཅད་ཁྱེད་ལ་འབུལ་ལོ་ཞུས་པར།"]},{"type":"verse","number":24,"content":["རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཨོར་ནན་ལ་འདི་ལྟར། དེ་ལྟར་མི་བྱ། ངས་དེ་ལ་རིན་ཁ་ཚང་བཅལ་ནས་ཉོ་ངེས་ཡིན། ངས་ཁྱོད་ཀྱི་དངོས་པོ་བླངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་མི་རུང་ལ། ངས་རིན་མ་སྤྲད་པའི་སྦྱིན་སྲེག་ཀྱང་འབུལ་མི་རུང་ཞེས་སྨྲས་ནས།"]},{"type":"verse","number":25,"content":["དཱ་བིད་ཀྱིས་གསེར་སྲང་དྲུག་བརྒྱ་བཅལ་ནས་ཨོར་ནན་ལ་སྤྲད་ཅིང་ས་དེ་ཉོས་པ་དང་།"]},{"type":"verse","number":26,"content":["ཁོང་གིས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བཞེངས་ནས་སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་ཕུལ་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་པ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ལན་གནང་སྟེ། ནམ་མཁའ་ནས་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་སྟེང་མེ་ཕབ་པའོ། །"]},{"type":"verse","number":27,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ཕོ་ཉ་དེ་ལ་བཀའ་བསྩལ་ནས། ཕོ་ཉ་དེས་རལ་གྲི་ཤུབས་ཀྱི་ནང་དུ་བཅུག་གོ །"]},{"type":"verse","number":28,"content":["དེའི་དུས་སུ་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་བུ་སི་པ་ཨོར་ནན་གྱི་གཡུལ་ཁ་རུ་རང་ལ་བཀའ་ལན་གནང་བ་མཐོང་ནས་དེ་རུ་མཆོད་པ་ཕུལ།"]},{"type":"verse","number":29,"content":["མོ་ཤེས་དབེན་སྟོང་དུ་བཟོས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་དང་སྦྱིན་སྲེག་གི་མཆོད་ཁྲི་ནི་དེའི་དུས་སུ་གིབ་ཡོན་གྱི་མཐོ་གླིང་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":30,"content":["འོན་ཀྱང་དཱ་བིད་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་དེའི་རལ་གྲིར་འཇིགས་པས། ཡར་དཀོན་མཆོག་ལ་བཀའ་འདྲི་ཞུ་རུ་འགྲོ་མ་སྤོབས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/20.json","previousChapterAudioLinks":{},"numberOfVerses":30}