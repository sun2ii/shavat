{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["དེ་ནས་དཱ་བིད་ལོ་ན་བགྲེས་ཤིང་ཚེ་ལོ་མཐར་ཕྱིན་པའི་དུས་སུ། རང་གི་བུ་སོ་ལོ་མོན་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་སོ། །"]},{"type":"heading","content":["ལེ་ཝི་པའི་ལས་བགོས་དང་མི་གྲངས།"]},{"type":"verse","number":2,"content":["ཡང་དཱ་བིད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་འགོ་དཔོན་རྣམས་དང་། མཆོད་དཔོན་རྣམས་དང་ལེ་ཝི་པ་བཅས་ཚང་མ་བསྡུས་ནས།"]},{"type":"verse","number":3,"content":["ལེ་ཝི་པ་ལོ་སུམ་ཅུ་ལོན་པ་རྣམས་རྩིས་བླངས་པ་དང་། བསྡོམས་རྩིས་བྱས་པ་ལྟར་ན་ཁོ་ཚོའི་སྐྱེས་པ་རྣམས་ཀྱི་གྲངས་ཀ་སུམ་ཁྲི་བརྒྱད་སྟོང་ཡོད་ཅིང་།"]},{"type":"verse","number":4,"content":["དེ་དག་ལས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་བདག་གཉེར་བྱེད་མཁན་མི་ཉིས་ཁྲི་བཞི་སྟོང་དང་། འགོ་དཔོན་དང་ཁྲིམས་དཔོན་མི་དྲུག་སྟོང་དང་།"]},{"type":"verse","number":5,"content":["ཡང་སྒོ་སྲུང་མི་བཞི་སྟོང་དང་། དཱ་བིད་",{"noteId":12},"ཀྱིས་བཟོས་པའི་རོལ་ཆས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་དབྱངས་འབུལ་མཁན་མི་བཞི་སྟོང་བཅས་ཡོད།"]},{"type":"verse","number":6,"content":["དཱ་བིད་ཀྱིས་ལེ་ཝིའི་བུ་གེར་ཤོན་དང་། ཀོ་ཧད་དང་། མཱ་རཱ་རེའེ་ཡི་བུ་རྒྱུད་རྣམས་ལ་ལས་ཚན་བགོས་སོ། །"]},{"type":"heading","content":["གེར་ཤོན་གྱི་ལས་ཚན།"]},{"type":"verse","number":7,"content":["གེར་ཤོན་ལ་གཏོགས་པ་ལཱ་དན་དང་ཤིམ་ཨི་ཡོད་ཅིང་།"]},{"type":"verse","number":8,"content":["ལཱ་དན་གྱི་བུ་སྐྱེས་འགོ་ནི་ཡེ་ཧི་ཨེལ་དང་། ད་དུང་ཟེ་ཐམ་དང་ཡོ་ཨེལ་བཅས་བསྡོམས་པས་གསུམ་ཡོད།"]},{"type":"verse","number":9,"content":["ཤིམ་ཨི་ཡི་བུ་ནི་ཤེ་ལོ་མོད་དང་། ཧ་ཟི་ཨེལ། ཧཱ་རན་བཅས་བསྡོམས་པས་གསུམ་ཡོད་ལ། དེ་རྣམས་ནི་ལཱ་དན་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་རྣམས་ཡིན།"]},{"type":"verse","number":10,"content":["ཤིམ་ཨི་ཡི་བུ་ནི་ཡ་ཧད་དང་། ཟི་ནཱ།",{"noteId":13},"ཡེ་ཨུ་སི། པེ་རེ་ཡཱ་བཅས་ཡིན་ལ། དེ་བཞི་པོ་ནི་ཤིམ་ཨི་ཡི་བུའོ། །"]},{"type":"verse","number":11,"content":["ཡ་ཧད་ནི་བུ་སྐྱེས་འགོ་དང་། ཟི་ཟཱ་བུ་གཉིས་པ་ཡིན་ལ། ཡེ་ཨུ་སི་དང་པེ་རེ་ཡཱ་གཉིས་ལ་བུ་རབས་ཚ་རྒྱུད་ཉུང་བས། དེ་གཉིས་པོ་ཁྱིམ་རྒྱུད་གཅིག་ཏུ་བརྩིས་ནས་ལས་ཚན་གཅིག་ཏུ་བྱས་སོ། །"]},{"type":"heading","content":["ཀོ་ཧད་ཀྱི་ལས་ཚན།"]},{"type":"verse","number":12,"content":["ཀོ་ཧད་ཀྱི་བུ་ནི་ཨམ་རམ་དང་། ཡེས་ཧར། ཧེབ་རོན། ཨུ་ཟི་ཨེལ་བཅས་བསྡོམས་པས་བཞི་ཡིན།"]},{"type":"verse","number":13,"content":["ཨམ་རམ་གྱི་བུ་ནི་ཨ་རོན་དང་མོ་ཤེ་ཡིན་ལ། ཨ་རོན་དང་དེའི་བུ་རྒྱུད་རྣམས་གཏན་དུ་ལོགས་སུ་བཀར་ནས་རྫས་རབ་ཏུ་དམ་པ་རྣམས་འབུལ་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྤོས་བདུག་པ་དང་། ཁོང་ལ་ཞབས་ཕྱི་བསྒྲུབ་པ་དང་། ཁོང་གི་མཚན་ལ་བརྟེན་ནས་ཇི་སྲིད་བར་དུ་བྱིན་རླབས་གཏོང་བའོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་མོ་ཤེ་ལ་མཚོན་ན། ཁོང་གི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ནི་ལེ་ཝི་ཚོ་པའི་ཁོངས་སུ་བརྩིས་སོ། །"]},{"type":"verse","number":15,"content":["མོ་ཤེའི་བུ་ནི་གེར་ཤོམ་དང་ཨེ་ལི་ཨེ་བཟིར་ཡིན།"]},{"type":"verse","number":16,"content":["གེར་ཤོམ་གྱི་བུ་སྐྱེས་འགོ་ནི་ཤེ་བུ་ཨེལ་ཡིན།"]},{"type":"verse","number":17,"content":["ཨེ་ལི་ཨེ་བཟིར་གྱི་བུ་སྐྱེས་འགོ་ནི་རེ་ཧབ་ཡཱ་ཡིན། ཨེ་ལི་ཨེ་བཟིར་ལ་བུ་གཞན་མེད་ནའང་རེ་ཧབ་ཡཱ་ལ་བུ་ཤིན་ཏུ་མང་པོ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཡེས་ཧར་གྱི་བུ་སྐྱེས་འགོ་ནི་ཤེ་ལོ་མིད་ཡིན།"]},{"type":"verse","number":19,"content":["ཧེབ་རོན་གྱི་བུ་སྐྱེས་འགོ་ནི་ཡེ་རི་ཡཱ་དང་། བུ་གཉིས་པ་ཨ་མར་ཡཱ། བུ་གསུམ་པ་ཡ་ཧ་ཟི་ཨེལ། བུ་བཞི་པ་ཡེ་ཀཱ་མེ་ཨམ་བཅས་ཡིན།"]},{"type":"verse","number":20,"content":["ཨུ་ཟི་ཨེལ་གྱི་བུ་སྐྱེས་འགོ་ནི་མི་ཀཱ་དང་། བུ་གཉིས་པ་ཡིས་ཤི་ཡཱ་ཡིན།"]},{"type":"heading","content":["མཱ་རཱ་རེའེ་ཡི་ལས་ཚན།"]},{"type":"verse","number":21,"content":["མཱ་རཱ་རེའེ་ཡི་བུ་ནི་མཱ་ལི་དང་མུ་ཤི་ཡིན། མཱ་ལིའི་བུ་ནི་ཨེ་ལི་ཨ་ཟར་དང་ཁི་སི་ཡིན།"]},{"type":"verse","number":22,"content":["ཡང་ཨེ་ལི་ཨ་ཟར་ཚེ་ལས་འདས་པ་དང་། བུ་མོ་འབའ་ཞིག་ལས་བུ་མེད་པའོ། །དེ་དག་དང་གཉེན་ཉེ་ཁི་སིའི་བུ་རྣམས་ཀྱིས་དེ་རྣམས་མནའ་མར་བླངས།"]},{"type":"verse","number":23,"content":["མུ་ཤིའི་བུ་ནི་མཱ་ལི་དང་། ཨེ་དེར། ཡེ་རེ་མོད་བཅས་བསྡོམས་པས་གསུམ་ཡིན་ནོ། །"]},{"type":"verse","number":24,"content":["དེ་རྣམས་ནི་ལེ་ཝིའི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཡིན་ལ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཁྱིམ་རྒྱུད་རེ་རེའི་འགོ་དཔོན་རྣམས་ནི། སྐྱེས་པ་རྣམས་ཀྱི་མིང་གི་གྲངས་ཀ་བཞིན་རྩིས་བླངས་པ་དང་། ལོ་ཉི་ཤུའམ་དེའི་ཡན་ལ་སླེབས་པ་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་བདག་གཉེར་པ་ཡིན།"]},{"type":"verse","number":25,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྔར་དཱ་བིད་ཀྱིས་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་འབངས་མི་བདེ་ལ་བཀོད་པ་དང་། ཁོང་ཉིད་གཏན་དུ་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས་པར་འགྱུར།"]},{"type":"verse","number":26,"content":["ལེ་ཝི་པ་རྣམས་ཀྱིས་ཕྱིན་ཆད་གུར་མཆོག་དང་ཞབས་ཕྱི་སྒྲུབ་བྱེད་སྣོད་ཆས་རྣམས་འཁུར་མི་དགོས་ཞེས་གསུངས་པས་སོ། །"]},{"type":"verse","number":27,"content":["དཱ་བིད་ཀྱི་ཞལ་ཆེམས་བཞིན་དུ་ལེ་ཝི་པ་རྣམས་ལོ་ཉི་ཤུའམ་དེའི་ཡན་ལ་སླེབས་པ་རྣམས་རྩིས་བླངས་པའོ། །"]},{"type":"verse","number":28,"content":["དེ་དག་གི་ལས་འགན་ནི་ཨ་རོན་གྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ལ་རོགས་བྱས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་བདག་གཉེར་བྱེད་པ་དང་། ཁྱམས་ར་དང་ལོགས་ཁང་རྣམས་ལ་བལྟ་བ་དང་། མཆོད་རྫས་དམ་པ་ལ་བྱི་དོར་བྱེད་པ་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་ལ་བདག་གཉེར་བྱེད་པ་བཅས་དང་།"]},{"type":"verse","number":29,"content":["ཡང་སྤྱན་བསྟར་བག་ལེབ་དང་། འབྲུ་མཆོད་ཀྱི་གྲོ་ཞིབ་དང་། ཡང་ན་སྐྱུར་མེད་བག་སྲབ་དང་། ཡང་ན་བསྲེགས་གོར་དང་། ཡང་ན་སྣུམ་འཁུར་བཅས་ལ་བདག་གཉེར་བྱེད་པ་དང་། ཚད་འཇལ་བྱེད་ཡོ་བྱད་སྣ་ཚོགས་ལ་བདག་བྱེད་དགོས་པ་དང་།"]},{"type":"verse","number":30,"content":["ཉིན་རེའི་ནངས་དགོང་ཡར་འགྲེང་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏང་རག་དང་བསྟོད་པ་འབུལ་བ་དང་།"]},{"type":"verse","number":31,"content":["ངལ་གསོ་བའི་ཉིན་མོ་དང་། ཟླ་རེའི་ཚེས་གཅིག་དང་གཏན་ལ་ཁེལ་བའི་དུས་ཆེན་གྱི་དུས་སུ་གྲངས་ཀ་ལྟར་སྒྲིག་སྲོལ་བཞིན་དུ། སྦྱིན་སྲེག་གི་མཆོད་པ་རྣམས་མཚམས་མེད་པར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འབུལ་དགོས་ལ།"]},{"type":"verse","number":32,"content":["མཇལ་འཕྲད་གུར་མཆོག་དང་གནས་དམ་པ་བསྲུང་བ་དང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཞབས་ཕྱི་སྒྲུབ་པའི་རང་གི་གཉེན་ཉེ་སྟེ་ཨ་རོན་གྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ལ་ལྟ་སྐྱོང་བྱེད་དགོས་པའོ། །"]}],"footnotes":[{"noteId":12,"caller":"+","text":"དཱ་བིད་ཅེས་པར་མ་ཕྱི་ལས་བདག་ཅེས་འབྱུང་།","reference":{"chapter":23,"verse":5}},{"noteId":13,"caller":"+","text":"ཟི་ནཱ་ཞེས་པར་འགྱུར་གཞན་ལས་ཟི་ཟཱ་ཞེས་ཀྱང་འབྱུང་།","reference":{"chapter":23,"verse":10}}]},"thisChapterLink":"/api/bod_ntb/1CH/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/22.json","previousChapterAudioLinks":{},"numberOfVerses":32}