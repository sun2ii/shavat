{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":24,"content":[{"type":"heading","content":["མཆོད་དཔོན་གྱི་ལས་ཚན།"]},{"type":"verse","number":1,"content":["ཡང་ཨ་རོན་གྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཀྱི་ལས་ཚན་ནི་འདི་ལྟ་སྟེ། ཨ་རོན་གྱི་བུ་ནི་ནཱ་དབ་དང་། ཨ་བི་ཧུ། ཨེ་ལི་ཨ་ཟར། ཨི་ཐ་མཱར་བཅས་ཡིན།"]},{"type":"verse","number":2,"content":["ནཱ་དབ་དང་ཨ་བི་ཧུ་ནི་རང་གི་ཕ་ཡི་སྔོན་དུ་ཚེ་ལས་འདས་ཤིང་བུ་ཡང་མེད་པས། ཨེ་ལི་ཨ་ཟར་དང་ཨི་ཐ་མཱར་གཉིས་མཆོད་དཔོན་བྱས་པ་ཡིན།"]},{"type":"verse","number":3,"content":["དེ་ནས་དཱ་བིད་དང་ཨེ་ལི་ཨ་ཟར་གྱི་བུ་རྒྱུད་ལས་ཟཱ་ཏོག་དང་། ཨི་ཐ་མཱར་གྱི་བུ་རྒྱུད་ལས་ཨ་ཧི་མེ་ལེག་བཅས་ཀྱིས་ཁོ་ཚོའི་གཉེན་ཉེ་རྣམས་ཀྱི་འོས་འགན་བཞིན་ལས་ཚན་བགོས་པའོ། །"]},{"type":"verse","number":4,"content":["ཕྱིས་སུ་ཨེ་ལི་ཨ་ཟར་གྱི་བུ་རྒྱུད་ཁྲོད་དུ་ཨི་ཐ་མཱར་གྱི་བུ་རྒྱུད་ལས་ཀྱང་འགོ་དཔོན་མང་པོ་ཡོད་པ་ཤེས་ཏེ། ཁོ་རྣམས་ཀྱི་ལས་ཚན་བགོས། ཨེ་ལི་ཨ་ཟར་གྱི་བུ་རྒྱུད་ལས་ཁོ་ཚོའི་ཁྱིམ་རྒྱུད་བཞིན་དུ་འགོ་དཔོན་བཅུ་དྲུག་དང་། ཨི་ཐ་མཱར་གྱི་བུ་རྒྱུད་ལས་ཁོ་ཚོའི་ཁྱིམ་རྒྱུད་བཞིན་དུ་འགོ་དཔོན་བརྒྱད་ཡོད་པའོ། །"]},{"type":"verse","number":5,"content":["ཡང་གནས་དམ་པ་དང་དཀོན་མཆོག་གི་དྲུང་དུ་འགོ་དཔོན་བྱེད་པ་ནི་ཨེ་ལི་ཨ་ཟར་གྱི་བུ་རབས་ཚ་རྒྱུད་དང་། ཨི་ཐ་མཱར་གྱི་བུ་རབས་ཚ་རྒྱུད་གཉིས་ཀའི་ཁྲོད་དུ་ཡོད་པས། ཁོ་ཚོས་རྒྱན་བླངས་ནས་ཁོ་རྣམས་ཆ་སྙོམས་ཀྱིས་བགོས་པའོ། །"]},{"type":"verse","number":6,"content":["དྲུང་ཡིག་སྟེ་ལེ་ཝི་པ་ནེ་ཐན་ཨེལ་གྱི་བུ་ཤེ་མ་ཡཱས་རྒྱལ་པོ་དང་། འགོ་དཔོན་རྣམས་དང་། མཆོད་དཔོན་ཟཱ་ཏོག་དང་། ཨབ་ཡཱ་ཐར་གྱི་བུ་ཨ་ཧི་མེ་ལེག་དང་། མཆོད་དཔོན་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ལེ་ཝི་པའི་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་རྣམས་ཀྱི་མདུན་དུ། དེ་དག་གི་མིང་ཡི་གེར་བཀོད་པ་སྟེ། ཨེ་ལི་ཨ་ཟར་གྱི་བུ་རབས་ཚ་རྒྱུད་ལས་ཁྱིམ་རྒྱུད་གཅིག་བདམས་པ་དང་། ཨི་ཐ་མཱར་གྱི་བུ་རབས་ཚ་རྒྱུད་ལས་ཀྱང་ཁྱིམ་རྒྱུད་གཅིག་བདམས་པ་ཡིན།"]},{"type":"verse","number":7,"content":["དེ་ནས་རྒྱན་དང་པོ་ཡེ་ཧོ་ཡ་རིབ་ལ་བབས་པ་དང་། གཉིས་པ་ཡེ་དཱ་ཡ་དང་།"]},{"type":"verse","number":8,"content":["གསུམ་པ་ཧ་རིམ་དང་། བཞི་པ་སེ་ཨོ་རིམ་དང་།"]},{"type":"verse","number":9,"content":["ལྔ་པ་མལ་ཀི་ཡཱ་དང་། དྲུག་པ་མི་ཡ་མིན་དང་།"]},{"type":"verse","number":10,"content":["བདུན་པ་ཧག་ཀོས་དང་། བརྒྱད་པ་ཨ་བི་ཡཱ་དང་།"]},{"type":"verse","number":11,"content":["དགུ་པ་ཡེ་ཤུ་ཨ་དང་། བཅུ་པ་ཤེ་ཀན་ཡཱ་དང་།"]},{"type":"verse","number":12,"content":["བཅུ་གཅིག་པ་ཨེལ་ཡཱ་ཤིབ་དང་། བཅུ་གཉིས་པ་ཡཱ་ཀིམ་དང་།"]},{"type":"verse","number":13,"content":["བཅུ་གསུམ་པ་ཧུབ་ཕཱ་དང་། བཅུ་བཞི་པ་ཡེ་ཤེ་བེ་ཨབ་དང་།"]},{"type":"verse","number":14,"content":["བཅོ་ལྔ་པ་པིལ་གཱ་དང་། བཅུ་དྲུག་པ་ཨིམ་མེར་དང་།"]},{"type":"verse","number":15,"content":["བཅུ་བདུན་པ་ཧེ་ཟིར་དང་། བཅོ་བརྒྱད་པ་ཧབ་པི་ཙེ་ཟི་དང་།"]},{"type":"verse","number":16,"content":["བཅུ་དགུ་པ་ཕེ་ཐཱ་ཡ་དང་། ཉི་ཤུ་པ་ཡེ་ཧེ་ཀེལ་དང་།"]},{"type":"verse","number":17,"content":["ཉེར་གཅིག་པ་ཡཱ་ཀིན་དང་། ཉེར་གཉིས་པ་གཱ་མུལ་དང་།"]},{"type":"verse","number":18,"content":["ཉེར་གསུམ་པ་དི་ལཱ་ཡ་དང་། ཉེར་བཞི་པ་མ་ཨ་ཟི་ཡཱ་ལ་བབས་པའོ། །"]},{"type":"verse","number":19,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་གི་ཕ་མེས་ཨ་རོན་ལ་བཀའ་བསྩལ་པའི་སྒྲིག་སྲོལ་བཞིན་དུ། དེ་དག་རེ་རེ་རང་གི་ལས་རེས་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་ཞབས་ཕྱི་བྱེད་དུ་འོངས་པའོ། །"]},{"type":"heading","content":["ལེ་ཝི་པའི་མིང་ཐོ།"]},{"type":"verse","number":20,"content":["ལེ་ཝི་པའི་བུ་རྒྱུད་གཞན་དག་ནི། ཨམ་རམ་གྱི་བུ་རྒྱུད་ལས་ཤུ་བཱ་ཨེལ་དང་། ཤུ་བཱ་ཨེལ་གྱི་བུ་རྒྱུད་ལས་ཡེ་དེ་ཡཱའོ། །"]},{"type":"verse","number":21,"content":["རེ་ཧབ་ཡཱ་ལ་མཚོན་ན། རེ་ཧབ་ཡཱའི་བུ་རྣམས་ལས་བུ་སྐྱེས་འགོ་ཡིས་ཤི་ཡཱ་ཡིན་པ་དང་།"]},{"type":"verse","number":22,"content":["ཡེས་ཧར་གྱི་བུ་རྣམས་ལས་ཤེ་ལོ་མོད་དང་ཤེ་ལོ་མོད་ཀྱི་བུ་རྣམས་ལས་ཡ་ཧད་ཡོད།"]},{"type":"verse","number":23,"content":["ཧེབ་རོན་གྱི་བུ་རྣམས་ནི་བུ་སྐྱེས་འགོ་ཡེ་རི་ཡཱ་དང་། བུ་གཉིས་པ་ཨ་མར་ཡཱ། བུ་གསུམ་པ་ཡ་ཧ་ཟི་ཨེལ། བུ་བཞི་པ་ཡེ་ཀཱ་མེ་ཨམ་བཅས་ཡིན།"]},{"type":"verse","number":24,"content":["ཨུ་ཟི་ཨེལ་གྱི་བུ་རྣམས་ལས་མི་ཀཱ་ཡོད་པ་དང་། མི་ཀཱའི་བུ་རྣམས་ལས་ཤཱ་མིར་ཡོད།"]},{"type":"verse","number":25,"content":["མི་ཀཱའི་སྤུན་ནི་ཨིས་ཤི་ཡཱ་ཡིན་ལ། ཨིས་ཤི་ཡཱ་ཡི་བུ་རྣམས་ལས་ཟཱ་ཀར་ཡ་ཡོད།"]},{"type":"verse","number":26,"content":["མཱ་རཱ་རེའེ་ཡི་བུ་ནི་མཱ་ལི་དང་མུ་ཤི། ཡ་ཨ་ཟི་ཡཱ་བཅས་ཡིན་ལ། ཡ་ཨ་ཟི་ཡཱའི་བུ་ནི་བེ་ནོའོ། །"]},{"type":"verse","number":27,"content":["མཱ་རཱ་རེའེ་ཡི་བུ་རྣམས་ལས་ཡ་ཨ་ཟི་ཡཱའི་བུ་བེ་ནོ་དང་། ཤོ་ཧམ། ཟག་ཀུར། ཨིབ་རི་བཅས་ཡོད།"]},{"type":"verse","number":28,"content":["མཱ་ལི་ཡི་བུ་ནི་ཨེ་ལི་ཨ་ཟར་ཡིན་པ་དང་། ཨེ་ལི་ཨ་ཟར་ལ་བུ་མ་སྐྱེས་སོ། །"]},{"type":"verse","number":29,"content":["ཁི་སི་ལ་མཚོན་ན། ཁི་སིའི་བུ་རྣམས་ལས་ཡེ་ར་མེ་ཨེལ་ཡོད།"]},{"type":"verse","number":30,"content":["མུ་ཤིའི་བུ་ནི་མཱ་ལི་དང་། ཨེ་དེར། ཡེ་རི་མོད་བཅས་ཡིན། དེ་རྣམས་ནི་ལེ་ཝི་པའི་བུ་རྒྱུད་ཡིན་ལ། ཁོ་ཚོའི་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཐོ་བརྒྱབ་པའོ། །"]},{"type":"verse","number":31,"content":["དེ་རྣམས་ཀྱིས་ཀྱང་རང་གི་གཉེན་ཉེ་ཨ་རོན་གྱི་བུ་རྒྱུད་ལྟར་དུ་རྒྱལ་པོ་དཱ་བིད་དང་། ཟཱ་ཏོག་དང་། ཨ་ཧི་མེ་ལེག་དང་། མཆོད་དཔོན་དང་ལེ་ཝི་པའི་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་རྣམས་ཀྱི་མདུན་དུ་རྒྱན་བླངས་པ་སྟེ། ཁྱིམ་རྒྱུད་རེ་རེའི་འགོ་དཔོན་དང་ཁོ་ཚོའི་སྤུན་ན་གཞོན་ཀུན་གྱིས་རྒྱན་བླངས་པ་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/23.json","previousChapterAudioLinks":{},"numberOfVerses":31}