{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":26,"content":[{"type":"heading","content":["སྒོ་སྲུང་རྣམས་ཀྱི་ལས་ཚན།"]},{"type":"verse","number":1,"content":["སྒོ་སྲུང་རྣམས་ཀྱི་ལས་ཚན་ནི། ཀོ་རཱག་པ་ཨ་སབ་ཀྱི་བུ་རབས་ཚ་རྒྱུད་ལས་ཀོ་རེད་ཀྱི་བུ་མེ་ཤེ་ལེམ་ཡཱ་ཡོད་པ་དང་།"]},{"type":"verse","number":2,"content":["ཡང་མེ་ཤེ་ལེམ་ཡཱ་ལ་བུ་འགའ་ཡོད་པ་སྟེ། བུ་སྐྱེས་འགོ་ཟཱ་ཀར་ཡ་དང་། བུ་གཉིས་པ་ཡེ་དི་ཡཱ་ཨེལ། བུ་གསུམ་པ་ཟེ་བད་ཡཱ། བུ་བཞི་པ་ཡད་ནི་ཨེལ།"]},{"type":"verse","number":3,"content":["བུ་ལྔ་པ་ཨེ་ལཱམ། བུ་དྲུག་པ་ཡེ་ཧོ་ཧ་ནན། བུ་བདུན་པ་ཨེ་ལི་ཧོ་ཨེ་ན་ཨི་བཅས་སོ། །"]},{"type":"verse","number":4,"content":["ཨོ་བེད་ཨེ་དོམ་ལ་བུ་འགའ་ཡོད་པ་སྟེ། བུ་སྐྱེས་འགོ་ཤེ་མཱ་ཡ། བུ་གཉིས་པ་ཡེ་ཧོ་ཟ་བད། བུ་གསུམ་པ་ཡོ་ཨག བུ་བཞི་པ་སཱ་ཀར། བུ་ལྔ་པ་ནེ་ཐན་ཨེལ།"]},{"type":"verse","number":5,"content":["བུ་དྲུག་པ་ཨམ་མེ་ཨེལ། བུ་བདུན་པ་ཡེས་སི་ཀཱར། བུ་བརྒྱད་པ་ཕེ་ཨུལ་ལེ་ཐ་ཨི་བཅས་ཡིན་ལ། དཀོན་མཆོག་གིས་དངོས་གནས་ཨོ་བེད་ཨེ་དོམ་ལ་བྱིན་རླབས་གནང་བའོ། །"]},{"type":"verse","number":6,"content":["དེའི་བུ་ཤེ་མཱ་ཡ་ལས་ཀྱང་བུ་འགའ་མཆེད་ཡོད་པ་སྟེ། དེ་རྣམས་ནི་དམག་མི་དཔའ་རྩལ་ཅན་ཡིན་པས། ཐམས་ཅད་རང་རང་གི་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་བྱས་པ་ཡིན།"]},{"type":"verse","number":7,"content":["ཤེ་མཱ་ཡའི་བུ་རྣམས་ནི་ཨོད་ནི་དང་རེ་ཕཱ་ཨེལ། ཨོ་བེད། ཨེལ་ཟཱ་བད་བཅས་ཡིན་ལ། ཨེལ་ཟཱ་བད་ཀྱི་སྤུན་ཨེ་ལི་ཧུ་དང་ཤེ་མག་ཡཱ་ནི་དཔའ་རྩལ་ཅན་ཡིན།"]},{"type":"verse","number":8,"content":["དེ་ཐམས་ཅད་ནི་ཨོ་བེད་ཨེ་དོམ་གྱི་བུ་རབས་ཚ་རྒྱུད་ཡིན་ལ། དེ་དག་དང་དེ་དག་གི་བུ་དང་སྤུན་རྣམས་ནི་ལས་ཀ་སྒྲུབ་ནུས་པ་ཡིན་ཏེ། ཨོ་བེད་ཨེ་དོམ་གྱི་བུ་རྒྱུད་བསྡོམས་པས་མི་དྲུག་ཅུ་རེ་གཉིས་ཡོད་དོ། །"]},{"type":"verse","number":9,"content":["མེ་ཤེ་ལེམ་ཡཱ་ལ་བུ་དང་སྤུན་ཡོད་ཅིང་། ཐམས་ཅད་དཔའ་རྩལ་ཅན་ཡིན་ཏེ་བསྡོམས་པས་མི་བཅོ་བརྒྱད་ཡོད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཡང་མཱ་རཱ་རེའེ་ཡི་བུ་རབས་ཚ་རྒྱུད་ལས་ཧོ་སཱ་ལ་ཡང་བུ་འགའ་ཡོད་དེ། བུ་སྐྱེས་འགོ་ཤིམ་རི་ནི་མ་གཞི་སྐྱེས་འགོ་མིན་ན་ཡང་། ཁོའི་ཕ་ཡིས་ཁོ་འགོ་བར་བྱས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["བུ་གཉིས་པ་ཧིལ་ཀི་ཡཱ་དང་། བུ་གསུམ་པ་ཏེ་བལ་ཡཱ། བུ་བཞི་པ་ཟཱ་ཀར་ཡ་བཅས་ཡིན། ཧོ་སཱའི་བུ་དང་སྤུན་ཐམས་ཅད་བསྡོམས་པས་མི་བཅུ་གསུམ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":12,"content":["འདི་རྣམས་ནི་སྒོ་སྲུང་བའི་ལས་ཚན་ཡིན་ལ། འགོ་དཔོན་དང་དེ་དག་གི་གཉེན་ཉེ་སུ་ཡིན་ཡང་ཀུན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ལས་རེས་བཞིན་ཞབས་ཕྱི་བསྒྲུབས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["དེ་དག་གིས་རྒན་གཞོན་སུ་ཡིན་ཡང་སྒོ་རེ་རེ་བསྲུང་བར་རང་རང་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྒྱན་བླངས་པ་སྟེ།"]},{"type":"verse","number":14,"content":["ཤར་སྒོ་སྲུང་བའི་རྒྱན་ནི་ཤེ་ལེམ་ཡཱ་ལ་བབས། དེའི་བུ་ཟཱ་ཀར་ཡ་ནི་གྲོས་ལ་མཁས་པ་ཞིག་ཡིན་ཞིང་། ཁོ་རྣམས་ཀྱིས་ཟཱ་ཀར་ཡའི་དོན་དུ་རྒྱན་བླངས་པ་ལ་དེར་བྱང་སྒོ་སྲུང་བའི་རྒྱན་བབས།"]},{"type":"verse","number":15,"content":["ཨོ་བེད་ཨེ་དོམ་གྱིས་ལྷོ་སྒོ་བསྲུང་བ་དང་། དེའི་བུ་རྣམས་ཀྱིས་མཛོད་ཁང་བསྲུང་དགོས་བྱུང་བ་རེད།"]},{"type":"verse","number":16,"content":["ཤུབ་ཕིམ་དང་ཧོ་སཱ་གཉིས་ཀྱིས་ནུབ་སྒོ་དང་གྱེན་དུ་འཛེག་པའི་ལམ་གྱི་ཤལ་ལེ་ཁེད་སྒོ་བསྲུང་དགོས་པ་དང་། སྒོ་སྲུང་རྣམས་ཕན་ཚུན་ཁ་གཏད་ནས་བསྡད།"]},{"type":"verse","number":17,"content":["ཤར་སྒོ་སྲུང་མཁན་ལེ་ཝི་པ་མི་དྲུག་ཡོད་པ་དང་། བྱང་སྒོ་སྲུང་མཁན་ཉིན་རེར་མི་བཞི་དང་། ལྷོ་སྒོ་སྲུང་མཁན་ཉིན་རེར་མི་བཞི་ཡོད་ལ། མཛོད་ཁང་སྲུང་མཁན་མི་གཉིས་རེ་ཡོད་པའོ། །"]},{"type":"verse","number":18,"content":["ཡང་ནུབ་ཕྱོགས་ཀྱི་བར་ཁྱམས་སུ་མི་བཞི་ལམ་ཆེན་ཁ་རུ་ཡོད་པ་དང་། བར་ཁྱམས་སུ་མི་གཉིས་ཡོད་པའོ། །"]},{"type":"verse","number":19,"content":["འདི་རྣམས་ནི་ཀོ་རཱག་པའི་བུ་རྒྱུད་དང་མཱ་རཱ་རེའེ་ཡི་བུ་རྒྱུད་གཉིས་ཀྱི་སྒོ་སྲུང་རྣམས་ཀྱི་ལས་ཚན་ཡིན་ནོ། །"]},{"type":"heading","content":["ལེ་ཝི་པའི་ལས་བགོས་གཞན་རྣམས།"]},{"type":"verse","number":20,"content":["ཡང་དེ་དག་གི་གཉེན་ཉེ་ལེ་ཝི་པ་གཞན་རྣམས་ནི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་དཀོར་མཛོད་རྣམས་དང་རྫས་དམ་པའི་གཏེར་མཛོད་དག་གི་གཉེར་པ་ཡིན།"]},{"type":"verse","number":21,"content":["གེར་ཤོན་ཁྱིམ་རྒྱུད་ཀྱི་ལཱ་དན་ལ་གཏོགས་པའི་བུ་རྒྱུད་ལས་འགོ་དཔོན་བྱེད་པ་ནི། གེར་ཤོན་ཁྱིམ་རྒྱུད་ཀྱི་ལཱ་དན་ལ་གཏོགས་པའི་བུ་རྒྱུད་ཡེ་ཧི་ཨེ་ལི་ཡིན།"]},{"type":"verse","number":22,"content":["ཡེ་ཧི་ཨེ་ལི་ཡི་བུ་ཟེ་ཐམ་དང་དེའི་ནུ་བོ་ཡོ་ཨེལ་གཉིས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་དཀོར་མཛོད་ལ་བདག་གཉེར་བྱེད་པ་ཡིན།"]},{"type":"verse","number":23,"content":["ཡང་ཨམ་རཱམ་ཁྱིམ་རྒྱུད་དང་། ཡེས་ཧར་ཁྱིམ་རྒྱུད། ཧེབ་རོན་ཁྱིམ་རྒྱུད། ཨུ་ཟི་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་བཅས་ལ་རང་རང་གི་ལས་གནས་ཡོད།"]},{"type":"verse","number":24,"content":["མོ་ཤེའི་ཚ་བོ་སྟེ་གེར་ཤོམ་གྱི་བུ་ཤེ་བུ་ཨེལ་ནི་དཀོར་མཛོད་ཀྱི་སྤྱི་གཉེར་ཡིན།"]},{"type":"verse","number":25,"content":["ཡང་ཤེ་བུ་ཨེལ་གྱི་སྤུན་ཨེ་ལི་ཨེ་བཟིར་ཡིན་ལ། ཨེ་ལི་ཨེ་བཟིར་གྱི་བུ་ནི་རེ་ཧབ་ཡཱ་དང་། རེ་ཧབ་ཡཱའི་བུ་ནི་ཡེ་ཤཱ་ཡ་དང་། ཡེ་ཤཱ་ཡའི་བུ་ནི་ཡོ་རཱམ་དང་། ཡོ་རཱམ་གྱི་བུ་ནི་ཟིག་རི་དང་། ཟིག་རིའི་བུ་ནི་ཤེ་ལོ་མོད་ཡིན་པའོ། །"]},{"type":"verse","number":26,"content":["ཤེ་ལོ་མོད་དང་དེའི་སྤུན་རྣམས་ཀྱིས་བང་མཛོད་ནང་གི་རྫས་དམ་པ་ཐམས་ཅད་དེ། རྒྱལ་པོ་དཱ་བིད་དང་། ཁྱིམ་རྒྱུད་རྣམས་ཀྱི་འགོ་དཔོན་དང་། སྟོང་དཔོན་དང་བརྒྱ་དཔོན། དམག་དཔོན་བཅས་ཀྱིས་བསྔོས་པའི་རྫས་དམ་པ་ཐམས་ཅད་ལ་བདག་གཉེར་བྱེད་པ་ཡིན།"]},{"type":"verse","number":27,"content":["དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཡང་བསྐྱར་བཞེང་བའི་ཕྱིར་དུ། འཐབ་མོའི་བཅོམ་ནོར་དམ་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":28,"content":["མངོན་ཤེས་པ་སཱ་མུ་ཨེལ་དང་། ཁི་སིའི་བུ་སོ་ལོ་དང་། ནེར་གྱི་བུ་ཨབ་ནེར་དང་། ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་བཅས་ཀྱིས་དམ་པར་བྱས་པ་ཐམས་ཅད་དང་། དམ་པར་བྱས་པའི་རྫས་ཐམས་ཅད་ཤེ་ལོ་མོད་དང་དེའི་སྤུན་དག་གི་ལག་ཏུ་བཅོལ་བ་ཡིན།"]},{"type":"verse","number":29,"content":["ཡེས་ཧར་ཁྱིམ་རྒྱུད་ལས་ཀེ་ནན་ཡཱ་དང་དེའི་བུ་རྣམས་ཀྱིས་མཆོད་ཁང་གི་ཕྱི་རུ་འགོ་དཔོན་དང་ཁྲིམས་དཔོན་བྱས་ཏེ། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བདག་སྐྱོང་བྱེད་པ་ཡིན།"]},{"type":"verse","number":30,"content":["ཡང་ཧེབ་རོན་ཁྱིམ་རྒྱུད་ལས་ཧ་ཤབ་ཡཱ་དང་དེའི་གཉེན་ཉེ་རྣམས་བསྡོམས་པས་མི་ཆིག་སྟོང་བདུན་བརྒྱ་ཡོད་དེ། ཐམས་ཅད་དཔའ་རྩལ་ཅན་ཡིན་ལ། དེ་དག་གིས་ཡོར་དན་གཙང་པོའི་ནུབ་ཕྱོགས་ཀྱི་ཡེས་ར་ཨེལ་གྱི་ཡུལ་རྣམས་སུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ལས་ཐམས་ཅད་དང་རྒྱལ་པོའི་ལས་འགན་རྣམས་སྒྲུབ་པ་ཡིན།"]},{"type":"verse","number":31,"content":["ཧེབ་རོན་ཁྱིམ་རྒྱུད་ལས་ཡེ་རི་ཡཱ་བྱ་བ་ནི་འགོ་དཔོན་ཡིན་ཏེ། ཁོ་ཚོའི་ཁྱིམ་རྒྱུད་ཀྱི་ཁྱིམ་རབས་བཞིན་ཧེབ་རོན་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་དུ་གྱུར་པ་ཡིན། དཱ་བིད་ཀྱིས་སྲིད་སྐྱོང་བའི་ལོ་བཞི་བཅུ་པར་བརྟག་དཔྱད་བྱས་པ་དང་། གིལ་ཨད་ཀྱི་ཡཱ་ཟེར་བྱ་བར་ཁྱིམ་རྒྱུད་དེ་ལས་དཔའ་བོ་མཐུ་སྟོབས་ཅན་རྙེད་ནས།"]},{"type":"verse","number":32,"content":["ཡེ་རི་ཡཱ་ལ་གཉེན་ཉེ་དུ་ཉིས་སྟོང་བདུན་བརྒྱ་ཡོད་ཅིང་ཐམས་ཅད་དཔའ་རྩལ་ཅན་དང་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་ཡིན་ལ། རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཁོ་རྣམས་ནི་རུ་བེན་གྱི་ཚོ་པ་དང་། གཱ་རྡུའི་ཚོ་པ་དང་། མཱ་ན་ཤེའི་ཚོ་པ་ཕྱེད་ཀ་བཅས་ཀྱི་དཀོན་མཆོག་དང་རྒྱལ་པོར་འབྲེལ་བའི་བྱ་བ་ཐམས་ཅད་ལ་བདག་གཉེར་བྱེད་པར་བསྐོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/25.json","previousChapterAudioLinks":{},"numberOfVerses":32}