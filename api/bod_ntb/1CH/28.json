{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":28,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་མཆོད་ཁང་བཞེང་བར་མཛུབ་སྟོན་གནང་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་འགོ་དཔོན་ཐམས་ཅད་དེ། ཚོ་པ་ཁག་གི་འགོ་དཔོན་དང་། རེས་སྐོར་ནས་རྒྱལ་པོར་ཞབས་ཏོག་སྒྲུབ་པའི་རུ་དཔོན་དང་། སྟོང་དཔོན། བརྒྱ་དཔོན། རྒྱལ་པོ་དང་རྒྱལ་སྲས་རྣམས་ཀྱི་ནོར་རྫས་དང་ཕྱུགས་ཐམས་ཅད་ལ་བདག་གཉེར་བྱེད་པའི་ཕྱག་མཛོད་རྣམས་དང་། ཉུག་རུམ་པ། མཐུ་སྟོབས་ཅན། དམག་མི་དཔའ་རྩལ་ཅན་ཐམས་ཅད་ཡེ་རུ་སཱ་ལེམ་དུ་བསྡུས་ཏེ།"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་དཱ་བིད་ཡར་བཞེངས་ནས་ན་རེ། ངའི་སྤུན་དང་ངའི་མི་རྣམས། ཁྱོད་ཅག་གིས་ངའི་གཏམ་ལ་ཉོན་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཇོག་སའི་བསྟི་གནས་ཤིག་བཞེངས་ཏེ། རང་ཅག་གི་དཀོན་མཆོག་གི་ཞབས་སྟེགས་སུ་འགོད་པའི་འདུན་པ་ངའི་སེམས་སུ་བྱུང་ནས། མཆོད་ཁང་བཞེང་བའི་ཕྱིར་ཐམས་ཅད་བཤམས་མོད།"]},{"type":"verse","number":3,"content":["འོན་ཀྱང་དཀོན་མཆོག་གིས་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་ནི་དམག་མི་ཞིག་ཡིན་ལ་མི་བསད་ནས་ཁྲག་ཕོས་པས། ངའི་མིང་གི་ཕྱིར་ཁྱོད་ཀྱིས་མཆོད་ཁང་བརྩིག་མི་རུང་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡིན་ནའང་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ཡབ་ཀྱི་ཁྱིམ་རྒྱུད་ཡོངས་ནས་ང་རང་ཇི་སྲིད་བར་དུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བདམས་པར་མཛད། ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་གིས་ཡ་ཧུ་དཱ་ནི་འགོ་དཔོན་དུ་བདམས་པ་དང་། ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ལས་ངའི་ཕ་གཞིས་བདམས་ཤིང་། ངའི་ཡབ་ཀྱི་བུ་རྣམས་ལས་ཁོང་ནི་ང་ལ་ཐུགས་མཉེས་པས་ང་རང་ཡེས་ར་ཨེལ་ཡོངས་ཀྱི་རྒྱལ་པོར་བསྐོས་པའོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བུ་མང་པོ་གནང་ཞིང་། ངའི་བུ་རྣམས་ལས་ཡེས་ར་ཨེལ་ལ་རྒྱལ་སྲིད་བྱེད་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་རྒྱལ་ཁམས་ཀྱི་རྒྱལ་ཁྲིར་བཞུགས་པ་ལ་ངའི་བུ་སོ་ལོ་མོན་བདམས་པ་ཡིན།"]},{"type":"verse","number":6,"content":["ཁོང་གིས་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་བུ་སོ་ལོ་མོན་གྱིས་ངའི་མཆོད་ཁང་དང་ཁྱམས་ར་རྣམས་བརྩིག་པར་འགྱུར། ཅིའི་ཕྱིར་ཞེ་ན། བདག་གིས་དེ་ནི་ངའི་བུ་རུ་འགྱུར་བར་བདམས་པ་དང་། ང་ཡང་དེའི་ཕ་རུ་འགྱུར་བས་སོ། །"]},{"type":"verse","number":7,"content":["གལ་སྲིད་ཁོས་ད་ལྟ་བཞིན་དུ་བློ་བརྟན་འགྱུར་མེད་ངང་ངའི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས་རྣམས་བསྲུང་བར་བྱེད་ན། ངས་ཀྱང་ཇི་སྲིད་བར་དུ་ཁོའི་རྒྱལ་སྲིད་བརྟན་པར་བྱའོ་གསུངས་བྱུང་།"]},{"type":"verse","number":8,"content":["དེའི་ཕྱིར་ད་ལྟ་དཀོན་མཆོག་ཡ་ཝཱེའི་མི་ཚོགས་ཡེས་ར་ཨེལ་ཡོངས་ཀྱི་མཐོང་ངོར། ང་ཚོའི་དཀོན་མཆོག་གིས་ཀྱང་གསན་སར། ཡུལ་སྐྱིད་པོ་འདི་ཁྱོད་རྣམས་ལ་དབང་བར་མ་ཟད། ཁྱོད་ཅག་གི་རྗེས་སུ་ཁྱོད་ཅག་གི་བུ་རྒྱུད་ལ་ཡང་གཏན་དུ་ས་སྐལ་དུ་ལུས་པའི་ཕྱིར། རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་ཐམས་ཅད་བསྲུང་བ་དང་དེ་བཙལ་དགོས།"]},{"type":"verse","number":9,"content":["ངའི་བུ་སོ་ལོ་མོན་ཁྱོད་ལ་མཚོན་ན། ཁྱོད་ཀྱིས་རང་གི་ཕ་ཡི་དཀོན་མཆོག་ངོ་ཟིན་པར་གྱིས། བློ་གཅིག་སེམས་གཅིག་གིས་དགའ་མོས་ངང་ཁོང་ལ་ཞབས་ཏོག་སྒྲུབས་ཤིག ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་མི་ཀུན་གྱི་སེམས་ལ་ཞིབ་དཔྱོད་མཛད་ཅིང་། བསམ་ཚུལ་ཡོད་ཚད་མཁྱེན་པས་ཁྱོད་ཀྱིས་ཁོང་བཙལ་ན་རྙེད་པར་འགྱུར་ཏེ། ཁྱོད་ཀྱིས་ཁོང་སྤངས་ན་ཁོང་གིས་ཁྱོད་དུས་རྒྱུན་དུ་འདོར་བར་འགྱུར་བས།"]},{"type":"verse","number":10,"content":["དོགས་ཟོན་གྱིས་ཤིག གནས་དམ་པའི་ཕྱིར་མཆོད་ཁང་ཞིག་བཞེང་བར་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་བདམས་པ་ཡིན་པས། སྙིང་སྟོབས་བསྐྱེད་ནས་དེ་ལས་ཤིག་ཅེས་གདམས་པའོ། །"]},{"type":"verse","number":11,"content":["དཱ་བིད་ཀྱིས་མཆོད་ཁང་གི་བར་ཁྱམས་དང་། ཁང་མིག བང་མཛོད། སྟེང་ཁང་། ནང་གི་ཁང་མིག ཐུགས་རྗེའི་བཞུགས་ཁྲི་འཇོག་སའི་གནས་དམ་པ་བཅས་ཀྱི་དཔེ་རིས་ཐམས་ཅད་རང་གི་སྲས་སོ་ལོ་མོན་ལ་སྤྲད་ཅིང་།"]},{"type":"verse","number":12,"content":["ཡང་ཁོང་གི་ཐུགས་ལ་ཡོད་པའི་དཔེ་རིས་ཐམས་ཅད་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ར་སྐོར་དང་། མཐའ་འཁོར་གྱི་ཁང་མིག་རྣམས་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་གི་དཀོར་མཛོད་དང་། རྫས་དམ་པ་རྣམས་ཀྱི་གཏེར་མཛོད་བཅས་ཀྱི་དཔེ་རིས་ཁོ་ལ་བསྟན་པ་དང་།"]},{"type":"verse","number":13,"content":["ཡང་མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱི་ལས་ཚན་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཞབས་ཕྱིའི་ལས་འགན་སྣ་ཚོགས་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་མཁོ་བའི་སྣོད་ཆས་མཐའ་དག་ཁོ་ལ་བསྟན།"]},{"type":"verse","number":14,"content":["ཡང་དཱ་བིད་ཀྱིས་གསེར་ག་ཚད་ཀྱིས་ཞབས་ཕྱིའི་རིགས་སྣ་ཚོགས་ལ་མཁོ་བའི་གསེར་ཆས་བཟོ་དགོས་པ་དང་། དངུལ་ཆས་སོ་སོ་དངུལ་ག་ཚད་ཀྱིས་བཟོ་དགོས་པ་དང་།"]},{"type":"verse","number":15,"content":["གསེར་ག་ཚད་ཀྱིས་གསེར་གྱི་སྒྲོན་སྟེགས་རྣམས་དང་སྒྲོན་སྟེགས་སྟེང་གི་གསེར་གྱི་སྒྲོན་མེ་རྣམས་བཟོ་དགོས་པ་དང་། གསེར་ག་ཚད་ཀྱིས་སྒྲོན་སྟེགས་རེ་རེ་དང་སྒྲོན་སྟེགས་སྟེང་གི་གསེར་གྱི་སྒྲོན་མེ་རེ་རེ་བཟོ་དགོས་པ་དང་། དངུལ་ག་ཚད་ཀྱིས་དངུལ་གྱི་སྒྲོན་སྟེགས་དང་སྒྲོན་སྟེགས་སྟེང་གི་དངུལ་གྱི་སྒྲོན་མེ་རྣམས་བཟོ་དགོས་པ་དང་། དངུལ་གྱི་སྒྲོན་སྟེགས་རེ་རེ་དང་སྒྲོན་སྟེགས་སྟེང་གི་དངུལ་གྱི་སྒྲོན་མེ་རེ་རེ་ནི་དངུལ་ག་ཚད་ཀྱིས་བཟོ་དགོས་པ་བསྟན་ཞིང་། དེ་ཐམས་ཅད་ནི་སྒྲོན་སྟེགས་རེ་རེའི་སྤྱོད་ཡུལ་བཞིན་ཡིན་ནོ། །"]},{"type":"verse","number":16,"content":["ཡང་གསེར་ག་ཚད་ཀྱིས་སྤྱན་བསྟར་བག་ལེབ་ཀྱི་ཅོག་ཙེ་བཟོ་དགོས་པ་དང་། དངུལ་ག་ཚད་ཀྱིས་དངུལ་གྱི་ཅོག་ཙེ་བཟོ་དགོས་པ་དང་།"]},{"type":"verse","number":17,"content":["གསེར་བཙོ་མ་ག་ཚད་ཀྱིས་ཤ་འཛིན་དང་། མཆོད་སྡེར། བུམ་པ་བཅས་བཟོ་དགོས་པ་དང་། གསེར་ག་ཚད་ཀྱིས་གསེར་ཏིང་བཟོ་དགོས་པ་དང་། ཏིང་ཕོར་རེ་རེའི་ལྗིད་ཚད་ག་འདྲ་ཡིན་དགོས་པ། དངུལ་ག་ཚད་ཀྱིས་དངུལ་ཏིང་བཟོ་དགོས་པ་དང་། ཏིང་ཕོར་རེ་རེའི་ལྗིད་ཚད་ག་འདྲ་ཡིན་དགོས་པ་དང་།"]},{"type":"verse","number":18,"content":["གསེར་བཙོ་མ་ག་ཚད་ཀྱིས་སྤོས་ཁྲི་བཟོ་དགོས་པ་དང་། ཡང་ཤིང་རྟ་དང་མཚུངས་ཤིང་གཤོག་པ་བརྐྱངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འགེབས་པའི་གསེར་གྱི་ཀེ་རུབ་བཟོ་དགོས་པ་བཅས་བསྟན་ནོ། །"]},{"type":"verse","number":19,"content":["ཡང་དཱ་བིད་ཀྱིས་འདི་ལྟར། འདི་ཐམས་ཅད་ནི་ལས་ཀ་མཐའ་དག་གི་དཔེ་རིས་ཡིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ཉིད་ཀྱི་ཕྱག་གིས་བདག་ལ་དཔེ་རིས་བཀོད་ཅིང་ཤེས་པར་མཛད་པའོ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":20,"content":["ཡང་དཱ་བིད་ཀྱིས་རང་གི་སྲས་སོ་ལོ་མོན་ལ་འདི་ལྟར། ཁྱོད་ཀྱིས་བློ་བརྟན་པོས་སྙིང་སྟོབས་བསྐྱེད་ནས་དེ་སྒྲུབས་དང་། མ་འཇིགས་མ་འཚབ་ཅིག ང་ཡི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་དང་མཉམ་དུ་བཞུགས་པས་སོ། །དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལས་ཀ་ཐམས་ཅད་རྫོགས་པའི་བར་དུ། ཁོང་གིས་ཁྱོད་མི་བསྐྱུར་མི་འདོར་རོ། །"]},{"type":"verse","number":21,"content":["ཡང་ལྟོས་དང་། མཆོད་དཔོན་དང་ལེ་ཝི་པའི་ལས་ཚན་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཞབས་ཏོག་ཐམས་ཅད་བསྒྲུབ་པ་དང་། ཡང་ལག་ཤེས་པ་སོ་སོས་ལས་རིགས་སྣ་ཚོགས་ཐད་དགའ་མོས་ངང་ཁྱོད་ལ་རོགས་འདེགས་བྱེད་པར་མ་ཟད། འགོ་དཔོན་རྣམས་དང་མི་ཡོད་དོ་ཅོག་གིས་ཀྱང་ཁྱོད་ཀྱི་བཀའ་ལ་མཉན་པ་ཡིན་ཞེས་གདམས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/27.json","previousChapterAudioLinks":{},"numberOfVerses":21}