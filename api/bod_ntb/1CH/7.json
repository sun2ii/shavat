{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":7,"content":[{"type":"heading","content":["ཡེས་སི་ཀཱར་གྱི་ཚོ་པ།"]},{"type":"verse","number":1,"content":["ཡེས་སི་ཀཱར་གྱི་བུ་ནི་ཐོ་ལཱ་དང་ཕུ༌བཱ། ཡ་ཤུབ། ཤིམ་རོན་བཅས་བསྡོམས་པས་བཞིའོ། །"]},{"type":"verse","number":2,"content":["ཐོ་ལཱའི་བུ་ནི་ཨུ་ཟི་དང་རེ་ཕཱ་ཡ། ཡེ་རི་ཨེལ། ཡ་མ་ཨི། ཡིབ་སམ། སཱ་མུ་ཨེལ་བཅས་ཡིན་ལ། དེ་ཐམས་ཅད་ནི་ཐོ་ལཱ་ཁྱིམ་རྒྱུད་ཀྱི་འགོ་དཔོན་ཡིན་པ་དང་། ཁོ་རྣམས་ཀྱི་མི་རབས་དེའི་དམག་མི་དཔའ་རྩལ་ཅན་རྣམས་ཡིན། དཱ་བིད་ཀྱི་དུས་སུ་སླེབས་པ་ན་དེ་དག་གི་མི་གྲངས་བསྡོམས་པས་ཉིས་ཁྲི་ཉིས་སྟོང་དྲུག་བརྒྱ་ཡོད།"]},{"type":"verse","number":3,"content":["ཡང་ཨུ་ཟིའི་བུ་ནི་ཡིས་རག་ཡཱ་ཡིན་ལ། ཡིས་རག་ཡཱའི་བུ་ནི་མེའ་ཀཱ་ཨེལ་དང་ཨོ་བད་ཡཱ། ཡོ་ཨེལ། ཡིས་ཤི་ཡཱ་བཅས་བསྡོམས་པས་ལྔ་ཡོད། དེ་ཐམས་ཅད་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["ད་དུང་དེ་དག་གི་ཁྲོད་དུ་རང་རང་གི་རུས་རྒྱུད་དང་ཁྱིམ་རྒྱུད་བཞིན་དུ། དམག་འཐབ་ལ་ཞུགས་ནུས་པའི་དམག་དཔུང་མི་སུམ་ཁྲི་དྲུག་སྟོང་ཡོད་ཅིང་། གང་ལ་ཞེ་ན། དེ་རྣམས་ལ་ཆུང་མ་དང་བུ་ཧ་ཅང་མང་པོ་ཡོད་པས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་དག་གི་སྤུན་རྣམས་ནི་ཡེས་སི་ཀཱར་གྱི་རིགས་རྒྱུད་ཐམས་ཅད་ཀྱི་ཁྲོད་དུ་དམག་མི་དཔའ་རྩལ་ཅན་ཡིན་ལ། ཁྱིམ་རབས་བཞིན་ཐོ་བརྒྱབ་པ་བསྡོམས་པས་བརྒྱད་ཁྲི་བདུན་སྟོང་ཡོད་དོ། །"]},{"type":"heading","content":["པེན་ཡཱ་མེན་གྱི་ཚོ་པ།"]},{"type":"verse","number":6,"content":["པེན་ཡཱ་མེན་གྱི་བུ་ནི་པེ་ལཱ་དང་པེ༌ཀེར། ཡེ་དི་ཡཱ་ཨེལ་བཅས་བསྡོམས་པས་གསུམ་མོ། །"]},{"type":"verse","number":7,"content":["པེ་ལཱ་ཡི་བུ་ནི་ཨེ་ཙེ་བོན་དང་ཨུ་ཟི། ཨུ་ཟི་ཨེལ། ཡེ་རི་མོད། ཨི་རི་བཅས་བསྡོམས་པས་ལྔའོ། །དེ་ཐམས་ཅད་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་དང་དམག་མི་དཔའ་རྩལ་ཅན་རྣམས་ཡིན་ལ། ཁྱིམ་རབས་བཞིན་ཐོ་བརྒྱབ་པ་བསྡོམས་པས་མི་ཉིས་ཁྲི་ཉིས་སྟོང་སོ་བཞི་ཡོད་དོ། །"]},{"type":"verse","number":8,"content":["པེ༌ཀེར་གྱི་བུ་ནི་ཟེ་མི་རཱ་དང་ཡོ་ཨ་སི། ཨེ་ལི་ཨེ་བཟིར། ཨེལ་ཡོ་ཨེ་ན་ཨི། ཨོམ་རི། ཡེ་རེ་མོད། ཨ་བི་ཡཱ། ཨ་ན་ཐོད། ཨ་ལེ་མེད་བཅས་ཡིན་ལ། དེ་ཐམས་ཅད་ནི་པེ་ཀེར་གྱི་བུའོ། །"]},{"type":"verse","number":9,"content":["དེ་ཐམས་ཅད་ནི་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་དང་དམག་མི་དཔའ་རྩལ་ཅན་རྣམས་ཡིན་ལ། ཁྱིམ་རབས་བཞིན་ཐོ་བརྒྱབ་པ་བསྡོམས་པས་མི་ཉིས་ཁྲི་ཉིས་བརྒྱ་ཡོད་དོ། །"]},{"type":"verse","number":10,"content":["ཡེ་དི་ཡཱ་ཨེལ་གྱི་བུ་ནི་པིལ་ཧན་ཡིན་ལ། པིལ་ཧན་གྱི་བུ་ནི་ཡེ་ཨུ་སི་དང་པེན་ཡཱ་མེན། ཡེ་ཧུད། ཀེ་ན་ཨ་ནཱ། ཟེ་ཐན། ཐཱར་ཞིས། ཨ་ཧི་ཤ་ཧར་བཅས་ཡིན་ལ།"]},{"type":"verse","number":11,"content":["དེ་ཐམས་ཅད་ནི་ཡེ་དི་ཡཱ་ཨེལ་གྱི་བུ་ཡིན་པ་དང་། ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་དང་དམག་མི་དཔའ་རྩལ་ཅན་རྣམས་ཡིན་ལ། དམག་འཐབ་ལ་ཞུགས་ནུས་པ་བསྡོམས་པས་མི་ཆིག་ཁྲི་བདུན་སྟོང་ཉིས་བརྒྱ་ཡོད་དོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཨིར་གྱི་བུ་ཤུབ་ཕིམ་དང་ཧུ༌ཕིམ་གཉིས་དང་། ཨ་ཧེར་གྱི་བུ་ཧུ་ཤིམ་བཅས་ཡོད་དོ། །"]},{"type":"heading","content":["ནཱབ་ཐ་ལིའི་ཚོ་པ།"]},{"type":"verse","number":13,"content":["ཡང་ནཱབ་ཐ་ལིའི་བུ་ནི་ཡ་ཙི་ཨེལ་དང་གུ༌ནེ། ཡེ༌ཚིར། ཤལ་ལུམ་བཅས་ཡིན་ལ། དེ་ཐམས་ཅད་ནི་པིལ་ཧའི་བུ་རབས་ཚ་རྒྱུད་དོ། །"]},{"type":"heading","content":["མཱ་ན་ཤེའི་ཚོ་པ།"]},{"type":"verse","number":14,"content":["མཱ་ན་ཤེའི་བུ་ཨ་སི་རི་ཨེལ་ནི་ཁོའི་ཆུན་མ་ཨ་རམ་པའི་བུད་མེད་ལས་སྐྱེས་ཤིང་། མོས་གིལ་ཨད་ཀྱི་ཕ་མཱ་ཀིར་ཞེས་པའང་བཙས་པའོ། །"]},{"type":"verse","number":15,"content":["མཱ་ཀིར་གྱིས་ཆུང་མ་ཞིག་བླངས་པ་ནི་ཧུ༌ཕིམ་དང་ཤུབ་ཕིམ་གཉིས་ཀྱི་སྲིང་མོ་ཡིན་ཞིང་མིང་ལ་མ་ཨ་ཀཱ་ཞེས་བྱའོ། །མཱ་ན་ཤེའི་བུ་གཉིས་པའི་མིང་ལ་ཚེ་ལོ་ཕེ་ཧད་ཅེས་བྱ་སྟེ་ཚེ་ལོ་ཕེ་ཧད་ལ་བུ་མོ་འགའ་ལས་མ་སྐྱེས་སོ། །"]},{"type":"verse","number":16,"content":["མཱ་ཀིར་གྱི་ཆུང་མ་མ་ཨ་ཀཱ་ལ་བུ་ཞིག་སྐྱེས་ཏེ། མོས་དེའི་མིང་ལ་ཕེ་རེ་སི་ཞེས་བཏགས་ཤིང་། དེའི་ནུ་བོའི་མིང་ལ་ཤེ་རེ་སི་ཞེས་བྱའོ། །ཤེ་རེ་སིའི་བུ་ནི་ཨུ་ལམ་དང་རཱ་ཀེམ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ཨུ་ལམ་གྱི་བུ་ནི་པེ་དན་ཡིན་ལ། དེ་ཐམས་ཅད་གིལ་ཨད་ཀྱི་བུ་རབས་ཚ་རྒྱུད་ཡིན་པ་དང་། གིལ་ཨད་ནི་མཱ་ཀིར་གྱི་བུ་ཡིན་ལ། མཱ་ཀིར་ནི་མཱ་ན་ཤེའི་བུའོ། །"]},{"type":"verse","number":18,"content":["ཡང་གིལ་ཨད་ཀྱི་སྲིང་མོ་ཧམ་མོ་ལེ་ཁེད་ལས་ཨི་སི་ཧོད་དང་ཨ་བི་ཨེ་ཟཱེར། མཱ་ལཱ་བཅས་སྐྱེས་སོ། །"]},{"type":"verse","number":19,"content":["ཤེ་མི་ད་ཡི་བུ་ནི་ཨ་ཧ་ཡན་དང་ཤེ་ཀེམ། ལིག་ཧི། ཨ་ནི་ཡམ་བཅས་ཡིན་ནོ། །"]},{"type":"heading","content":["ཨེ་ཕཱར་ཡིམ་གྱི་ཚོ་པ།"]},{"type":"verse","number":20,"content":["ཨེ་ཕཱར་ཡིམ་གྱི་བུ་ནི་ཤུ་ཏེ་ལཱ་ཡིན་པ་དང་། ཤུ་ཏེ་ལཱ་ཡི་བུ་ནི་པེ་རེད་ཡིན་ལ། པེ་རེད་ཀྱི་བུ་ནི་ཐ་ཧད་དང་། ཐ་ཧད་ཀྱི་བུ་ནི་ཨེལ་ཨ་ཐ་དང་། ཨེལ་ཨ་ཐ་ཡི་བུ་ནི་ཐ་ཧད་ཡིན།"]},{"type":"verse","number":21,"content":["ཐ་ཧད་ཀྱི་བུ་ནི་ཟཱ་བད་ཡིན་པ་དང་། ཟཱ་བད་ཀྱི་བུ་ནི་ཤུ་ཏེ་ལཱ་ཡིན་ནོ། །ཨེ་ཕཱར་ཡིམ་",{"noteId":6},"གྱི་བུ་ཨེ་ཟེར་དང་ཨེལ་ཨད་གཉིས་མར་སོང་ནས་གཱད་པའི་ཕྱུགས་ཟོག་ཕྲོགས་པས། ཡུལ་དེའི་གཞིས་སྐྱེས་གཱད་པ་རྣམས་ཀྱིས་བསད་པ་ཡིན།"]},{"type":"verse","number":22,"content":["དེ་དག་གི་ཕ་ཨེ་ཕཱར་ཡིམ་གྱིས་ཉིན་མང་པོར་མྱ་ངན་བྱས་པ་དང་། དེའི་སྤུན་རྣམས་འོངས་ནས་ཁོ་ལ་སེམས་གསོ་བྱས་པའོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཨེ་ཕཱར་ཡིམ་རང་གི་ཆུང་མ་དང་འགྲོགས་ནས་མོ་མངལ་དང་ལྡན་པར་གྱུར་ཏེ་བུ་ཞིག་བཙས་པ་ལ། ཨེ་ཕཱར་ཡིམ་གྱིས་བུ་ཡི་མིང་ལ་པེ་རེ་ཡཱ་ཞེས་བཏགས་པ་སྟེ། ཅི་ལ་ཞེ་ན། ཁོའི་ཁྱིམ་དུ་རྐྱེན་ངན་བྱུང་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":24,"content":["ཁོའི་བུ་མོ་ནི་ཤེ་ཨེ་རཱ་ཡིན་ལ། པེད་ཧོ་རོན་གོང་འོག་དང་། ཨུ་ཟེན་ཤེ་ཨེ་རཱ་བཅས་རྩིག་མཁན་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["པེ་རེ་ཡཱ་ཡི་བུ་ནི་རེ་ཕཱ་དང་རེ་ཤེབ་ཡིན་ལ། རེ་ཤེབ་ཀྱི་བུ་ནི་ཏེ་ལཱ་དང་། ཏེ་ལཱའི་བུ་ནི་ཐ་ཧན་ཡིན།"]},{"type":"verse","number":26,"content":["ཐ་ཧན་གྱི་བུ་ནི་ལཱ་དན་ཡིན་ལ། ལཱ་དན་གྱི་བུ་ནི་ཨམ་མེ་ཧུད་ཡིན་པ་དང་། ཨམ་མེ་ཧུད་ཀྱི་བུ་ནི་ཨེ་ལི་ཤ་མཱ་ཡིན།"]},{"type":"verse","number":27,"content":["ཨེ་ལི་ཤ་མཱའི་བུ་ནི་ནུན་ཡིན་པ་དང་། ནུན་གྱི་བུ་ནི་ཡོ་ཤུ་ཨ་ཡིན་ནོ། །"]},{"type":"verse","number":28,"content":["ཨེ་ཕཱར་ཡིམ་པའི་ཡུལ་དང་སྡོད་གནས་ནི་པེད་ཨེལ་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། ཤར་དུ་ན་ཨ་རན་དང་། ནུབ་ཏུ་གེ་ཟེར་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། སི་ཀེམ་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། ཨ་ཡཱ་དང་དེའི་གྲོང་ཚོ་རྣམས་ཡིན་ལ།"]},{"type":"verse","number":29,"content":["ད་དུང་མཱ་ན་ཤེ་ཚོ་པའི་ས་མཚམས་དང་ཉེ་སར། པེད་ཤེ་ཨན་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། ཐ་ཨ་ནག་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། མེ་གིད་དོ་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། དཱོར་དང་དེའི་གྲོང་ཚོ་རྣམས་ཡོད་པའོ། །ཡེས་ར་ཨེལ་གྱི་བུ་ཡོ་སེབ་ཀྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཡུལ་དེ་རྣམས་སུ་བསྡད་པ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཨ་ཤེར་གྱི་ཚོ་པ།"]},{"type":"verse","number":30,"content":["ཨ་ཤེར་གྱི་བུ་ནི་ཡིམ་ནཱ་དང་ཡེས་བཱ། ཡེས་བི། པེ་རེ་ཡཱ་བཅས་ཡིན་ལ། ད་དུང་དེ་དག་གི་སྲིང་མོ་སེ་རཱ་ཡང་ཡོད།"]},{"type":"verse","number":31,"content":["པེ་རེ་ཡཱའི་བུ་ནི་ཧེ་བེར་དང་མཱལ་ཀི་ཨེལ་ཡིན་ལ། མཱལ་ཀི་ཨེལ་ནི་པིར་ཟ་ཡིད་ཀྱི་ཕའོ། །"]},{"type":"verse","number":32,"content":["ཧེ་བེར་ལས་ཡབ་ལེད་དང་ཤོ་མེར། ཧོ་ཐམ། དེ་དག་གི་སྲིང་མོ་ཤུ་ཨ་བཅས་མཆེད་པའོ། །"]},{"type":"verse","number":33,"content":["ཡབ་ལེད་ཀྱི་བུ་ནི་ཕཱ་སག་དང་པིམ་ཧལ། ཨ་ཤ་ཝད་བཅས་ཡིན་ལ། དེ་དག་ནི་ཡབ་ལེད་ཀྱི་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":34,"content":["ཤེ་མེར་གྱི་བུ་ནི་ཨ་ཧི་དང་རོ་གཱ། ཡེ་ཧུབ་བཱ། ཨ་རམ་བཅས་ཡིན།"]},{"type":"verse","number":35,"content":["ཤེ་མེར་གྱི་སྤུན་ཧེ་ལེམ་གྱི་བུ་ནི་ཙོ་ཕཱ་དང་ཡིམ་ནཱ། ཤེ་ལེ་སི། ཨ་མལ་བཅས་ཡིན།"]},{"type":"verse","number":36,"content":["ཙོ་ཕཱ་ཡི་བུ་ནི་སུ་ཨ་དང་ཧར་ནེ་ཕེར། ཤུ་ཨལ། པེ་རི། ཡིམ་རཱ།"]},{"type":"verse","number":37,"content":["པེ་ཙེར། ཧོད། ཤམ་མཱ། ཤིལ་ཤུ། ཡིད་རཱན། པེ་ཨེ་རཱ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":38,"content":["ཡེ་ཐེར་གྱི་བུ་ནི་ཡེ་ཕུན་ནེ་དང་ཕི་སི་ཕཱ། ཨ་རཱ་བཅས་ཡིན།"]},{"type":"verse","number":39,"content":["ཡུལ་ལཱའི་བུ་ནི་ཨ་རཱ་དང་ཧན་ནི་ཨེལ། རི་ཟི་ཡཱ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":40,"content":["དེ་ཐམས་ཅད་ནི་ཨ་ཤེར་གྱི་བུ་རབས་ཚ་རྒྱུད་དེ། ཁོ་ཚོའི་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་དང་དམག་མི་ཕུལ་བྱུང་དཔའ་རྩལ་ཅན་དང་། འགོ་དཔོན་རྣམས་ཀྱི་གཙོ་བོར་གྱུར་པ་ཡིན། ཁྱིམ་རབས་བཞིན་ཐོ་བརྒྱབ་པའི་མི་གྲངས་ཏེ། དམག་འཐབ་ལ་ཞུགས་ནུས་པ་བསྡོམས་པས་མི་ཉིས་ཁྲི་དྲུག་སྟོང་ཡོད་པའོ། །"]}],"footnotes":[{"noteId":6,"caller":"+","text":"ཨེ་ཕཱར་ཡིམ་ནི་མཐོ་སྒང་དུ་གནས་ཤིང་ཕྱུགས་ཁྱུ་རྣམས་ལུང་པའི་གཞོངས་ལ་གནས་པ་ཡིན།","reference":{"chapter":7,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/1CH/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/6.json","previousChapterAudioLinks":{},"numberOfVerses":40}