{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CH","translationId":"bod_ntb","name":"སྔོན་རབས་དང་པོ།","commonName":"སྔོན་རབས་དང་པོ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་དང་པོ།","order":13,"numberOfChapters":29,"sha256":"5d3814b8b4470421660eea358d576e614a6fe637fdf36efb2dc079b2b21ba513","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bod_ntb/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":8,"content":[{"type":"heading","content":["པེན་ཡཱ་མེན་པ་སོ་ལོའི་ཁྱིམ་རབས།"]},{"type":"verse","number":1,"content":["ཡང་པེན་ཡཱ་མེན་ལས་བུ་སྐྱེས་འགོ་པེ་ལཱ་དང་། བུ་གཉིས་པ་ཨ་ཤ༌བེལ། བུ་གསུམ་པ་ཨ་ཧ་རཱ།"]},{"type":"verse","number":2,"content":["བུ་བཞི་པ་ནོ་ཧཱ། བུ་ལྔ་པ་ར་ཕཱ་བཅས་མཆེད་དོ། །"]},{"type":"verse","number":3,"content":["ཡང་པེ་ལཱ་ཡི་བུ་ནི་ཨད་དར་དང་། གེ་རཱ། ཨ་བི་ཧུད།"]},{"type":"verse","number":4,"content":["ཨ་བི་ཤུ་ཨ། ནཱ་ཨ༌མཱན། ཨ་ཧོ་ཨ།"]},{"type":"verse","number":5,"content":["གེ་རཱ། ཤེ་ཕུ་ཕན། ཧུ་རཱམ་བཅས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་འདི་རྣམས་ནི་ཨེ་ཧུད་ཀྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཡིན་ཏེ། ཁོ་རྣམས་ནི་གེ་བཱ་རུ་གཞིས་ཆགས་པའི་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་ཡིན་ལ། སྔར་མཱ་ན་ཧད་དུ་སྤྱུགས་པའོ། །"]},{"type":"verse","number":7,"content":["ཨེ་ཧུད་ཀྱི་བུ་ནི་ནཱ་ཨ༌མཱན་དང་། ཨ་ཧི་ཡཱ། གེ་རཱ་བཅས་ཡིན་ལ། གེ་རཱ་ཡིས་ཁོ་རྣམས་སྤྱུགས་པ་ཡིན་ནོ། །དེ་ལས་ཨུ་ཟཱ་དང་ཨ་ཧི་ཧུད་མཆེད་དོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཤཱ་ཧ་ར་ཨིམ་གྱིས་རང་གི་ཆུང་མ་ཧུ་ཤིམ་དང་པཱ་ཨ་ར་གཉིས་དོར་རྗེས། མོ་ཨབ་ཡུལ་དུ་བུ་རྣམས་སྐྱེས་སོ། །"]},{"type":"verse","number":9,"content":["དེའི་ཆུང་མ་ཧོ་དེ་སི་ལས་ཡོ་བཱབ་དང་། ཙིབ་ཡཱ། མེ་ཤཱ། མཱལ་ཀམ།"]},{"type":"verse","number":10,"content":["ཡེ་ཨུ་ཟི། སག་ཡཱ། མིར་མཱ་བཅས་མཆེད་དེ། དེའི་བུ་འདི་ཐམས་ཅད་ནི་ཁྱིམ་རྒྱུད་དག་གི་འགོ་དཔོན་ཡིན།"]},{"type":"verse","number":11,"content":["ཧུ་ཤིམ་ལས་ཁོ་ལ་ཨ་བི་ཏུབ་དང་ཨེལ་ཕཱ་ཨལ་གཉིས་མཆེད་དེ།"]},{"type":"verse","number":12,"content":["ཨེལ་ཕཱ་ཨལ་གྱི་བུ་ནི་ཨེ་བེར་དང་། མེ་ཤཱམ། ཤེ་མེད་བཅས་ཡིན་ལ། ཤེ་མེད་ཀྱིས་ཨོ་ནོ་དང་ལོད་གཉིས་དང་། གྲོང་ཁྱེར་དེ་གཉིས་ཀའི་གྲོང་ཚོ་རྣམས་བརྩིགས་སོ། །"]},{"type":"verse","number":13,"content":["ད་དུང་པེ་རེ་ཡཱ་དང་ཤེ་མཱ་གཉིས་ཀྱང་ཡོད་ལ། ཁོ་རྣམས་ནི་ཨ་ཡཱ་ལོན་དུ་གཞིས་ཆགས་པའི་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་ཡིན་ཞིང་། དེ་གཉིས་ཀྱིས་གཱད་པ་རྣམས་ཕྱིར་བསྐྲད་པ་ཡིན།"]},{"type":"verse","number":14,"content":["ཡང་པེ་རེ་ཡཱ་ཡི་བུ་ནི་ཨ་ཧི་ཡོ་དང་། ཤཱ་ཤག ཡེ་རེ་མོད།"]},{"type":"verse","number":15,"content":["ཟེ་བད་ཡཱ། ཨ་རད། ཨེ་དེར།"]},{"type":"verse","number":16,"content":["མེའ་ཀཱ་ཨེལ། ཡིས་ཕཱ། ཡོ་ཧ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ཡང་ཨེལ་ཕཱ་ཨལ་གྱི་བུ་ནི་ཟེ་བད་ཡཱ་དང་། མཱེ་ཤུལ་ལིམ། ཧི་སི་ཀི། ཧེ་བེར།"]},{"type":"verse","number":18,"content":["ཡིས་མེ་ར་ཨི། ཡི་ཟ་ལི་ཡཱ། ཡོ་བཱབ་བཅས་སོ། །"]},{"type":"verse","number":19,"content":["ཤིམ་ཨི་ཡི་བུ་ནི་ཡཱ་ཀིམ་དང་། ཟིག་རི། ཟབ་དི།"]},{"type":"verse","number":20,"content":["ཨེ་ལི་ཨེ་ན་ཨི། ཙིལ་ལེ་ཐ་ཨི། ཨེ་ལི་ཨེལ།"]},{"type":"verse","number":21,"content":["ཨ་དཱ་ཡ། པེ་ར་ཡཱ། ཤིམ་རད་བཅས་སོ། །"]},{"type":"verse","number":22,"content":["ཤཱ་ཤག་གི་བུ་ནི་ཡིས་པན་དང་། ཨེ་བེར། ཨེ་ལི་ཨལ།"]},{"type":"verse","number":23,"content":["ཨབ་དོན། ཟིག་རི། ཧ་ནན།"]},{"type":"verse","number":24,"content":["ཧ་ནན་ཡཱ། ཨེ་ལཱམ། ཨན་ཐོ་ཐི་ཡཱ།"]},{"type":"verse","number":25,"content":["ཡིབ་དེ་ཡཱ། ཕེ་ནུ་ཨེལ་བཅས་སོ། །"]},{"type":"verse","number":26,"content":["ཡེ་རོ་ཧམ་གྱི་བུ་ནི་ཤམ་ཤེ་ར་ཨི་དང་། ཤེ་ཧར་ཡཱ། ཨ་ཐལ་ཡཱ།"]},{"type":"verse","number":27,"content":["ཡ་ཨ་རེ་ཤི་ཡཱ། ཨེ་ལི་ཡཱ། ཟིག་རི་བཅས་སོ། །"]},{"type":"verse","number":28,"content":["དེ་རྣམས་ནི་ཁྱིམ་རབས་བཞིན་དུ་ཐམས་ཅད་རང་རང་གི་ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་འགོ་དཔོན་རྣམས་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["ཡང་གིབ་ཡོན་ཡུལ་དུ་སྡོད་པ་ནི་གིབ་ཡོན་གྱི་ཕ་ཡེ་ཨི་ཨེལ་ཡོད་པ་དང་། དེའི་ཆུང་མའི་མིང་ལ་མ་ཨ་ཀཱ་ཟེར་རོ། །"]},{"type":"verse","number":30,"content":["དེའི་བུ་སྐྱེས་འགོ་ནི་ཨབ་དོན་ཡིན་ལ། དེ་ནས་ཙུར་དང་། ཁི་སི། པཱ་ཨལ། ནཱ་དབ།"]},{"type":"verse","number":31,"content":["གེ་དོར། ཨ་ཧི་ཡོ། ཟེ་ཀེར། མིག་ལོད་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":32,"content":["ཡང་མིག་ལོད་ལས་ཤི་མེ་ཨ་མཆེད་དེ། དེ་དག་ཀྱང་རང་གི་གཉེན་ཉེ་དང་མཉམ་དུ་ཡེ་རུ་སཱ་ལེམ་ལ་གནས་ཤིང་། ཕན་ཚུན་ཉེ་བར་གནས་པའོ། །"]},{"type":"verse","number":33,"content":["ནེར་ལས་ཁི་སི་མཆེད། ཁི་སི་ལས་སོ་ལོ་དང་། སོ་ལོ་ལས་ཡོ་ནཱ་ཐན་དང་། མལ་ཀི་ཤུ་ཨ། ཨ་བི་ནཱ་དབ། ཨིས་པོ་ཤེད་བཅས་མཆེད་དོ། །"]},{"type":"verse","number":34,"content":["ཡོ་ནཱ་ཐན་གྱི་བུ་ནི་མེ་ཕི་པོ་ཤེད་ཡིན་ལ། མེ་ཕི་པོ་ཤེད་ལས་མི་ཀཱ་མཆེད་དོ། །"]},{"type":"verse","number":35,"content":["མི་ཀཱ་ཡི་བུ་ནི་ཕི་ཐོན་དང་། མེ་ལེག ཐ་རེ་ཨ། ཨ་ཧ་ཟཱ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":36,"content":["ཨ་ཧ་ཟཱ་ལས་ཡེ་ཧོ་ཨ་དད་མཆེད་ཅིང་། ཡེ་ཧོ་ཨ་དད་ལས་ཨ་ལེ་མེད་དང་། ཨས་མ་ཝེད། ཟིམ་རེ་བཅས་མཆེད་པ་དང་། ཟིམ་རེ་ལས་མོ་ཟི་མཆེད་དོ། །"]},{"type":"verse","number":37,"content":["མོ་ཟི་ལས་པི་ནེ་ཨ་མཆེད་པ་དང་། པི་ནེ་ཨ་ཡི་བུ་ནི་ར་ཕཱ་ཡིན་ལ། ར་ཕཱའི་བུ་ནི་ཨེལ་ཨ་སཱ་ཡིན། ཨེལ་ཨ་སཱའི་བུ་ནི་ཨ་ཙེལ་ཡིན།"]},{"type":"verse","number":38,"content":["ཡང་ཨ་ཙེལ་ལ་བུ་དྲུག་ཡོད་དེ། དེ་དག་གི་མིང་ནི་ཨས་རི་ཀམ་དང་། པོ་ཀེ་རུ། ཡེས་མ་ཨེལ། ཤེ་ཨར་ཡཱ། ཨོ་བད་ཡཱ། ཧ་ནན་བཅས་ཡིན་ལ། དེ་ཐམས་ཅད་ནི་ཨ་ཙེལ་གྱི་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":39,"content":["ཡང་ཨ་ཙེལ་གྱི་ནུ་བོ་ཨེ་ཤེག་གི་བུ་རྣམས་ནི། བུ་སྐྱེས་འགོ་ཨུ་ལམ་དང་། བུ་གཉིས་པ་ཡེ་ཨུ་སི། བུ་གསུམ་པ་ཨེ་ལི་ཕེ་ལེད་བཅས་སོ། །"]},{"type":"verse","number":40,"content":["ཨུ་ལམ་གྱི་བུ་ཐམས་ཅད་དམག་མི་དཔའ་བོ་མདའ་རྩལ་ཅན་ཡིན། དེ་དག་ལ་བུ་རབས་ཚ་རྒྱུད་མང་ཞིང་བསྡོམས་པས་བརྒྱ་དང་ལྔ་བཅུ་ཡོད་ལ། དེ་ཐམས་ཅད་པེན་ཡཱ་མེན་ཚོ་པའི་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":40}