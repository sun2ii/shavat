{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":10,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་ལོ་རྒྱུས་དྲངས་ནས་ཉེན་བརྡ་གཏོང་བ།"]},{"type":"verse","number":1,"content":["སྤུན་ཟླ༌རྣམས། བདག་གིས་ཁྱོད་རྣམས་ལ་ཤེས་སུ་འཇུག་འདོད་པ་ནི། སྔོན་ཆད་བདག་ཅག་གི་ཕ་མེས་ཡང་མེས་ཐམས་ཅད་སྤྲིན་འོག་ཏུ་གནས་ཤིང་ཐམས་ཅད་རྒྱ་མཚོ་བརྒྱུད་ནས་སོང་སྟེ།"]},{"type":"verse","number":2,"content":["ཐམས་ཅད་སྤྲིན་དང་རྒྱ་མཚོ་བརྒྱུད་ནས་ཁྲུས་གསོལ་ལ་ཞུགས་ཤིང་མོ་ཤེ་ལ་གཏོགས་པར་གྱུར་པ་དང་།"]},{"type":"verse","number":3,"content":["ཡང་ཐམས་ཅད་ཀྱིས་ཐུགས་ཉིད་ཀྱི་ཁ་ཟས་གཅིག་མཚུངས་ཟོས༌ཤིང༌།"]},{"type":"verse","number":4,"content":["ཡང་ཐམས་ཅད་ཀྱིས་ཐུགས་ཉིད་ཀྱི་བཏུང་བྱ་གཅིག་མཚུངས་བཏུངས་མྱོང༌བ་ཡིན། ཐུགས་ཉིད་ཀྱི་བཏུང་བྱ་དེ་ནི་ཁོ་རྣམས་དང་ལྷན་དུ་བྱོན་པའི་ཐུགས་ཉིད་ཀྱི་བྲག་རྡོ་ལས་བྱུང་བ་ཡིན༌ཏེ། བྲག་རྡོ་དེ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ལགས་སོ།།"]},{"type":"verse","number":5,"content":["འོན༌ཀྱང༌། ཕ་མེས་ཡང་མེས་ཁྲོད་ཀྱི་མི་མང་ཤོས་ལ་དཀོན་མཆོག་ཐུགས་མ་དགྱེས་པས་དེ་དག་གི་བེམ་པོ་དབེན་སྟོང་དུ་བསྐྱུར་བ་ཡིན་ནོ།།"]},{"type":"verse","number":6,"content":["དོན་དེ་དག་ནི་བདག་ཅག་གི་ཕྱི་འདོམས་ཀྱི་མེ་ལོང་ཡིན༌ཏེ། བདག་ཅག་གིས་འདོད་ངན་མི་བྱེད་པའི༌ཕྱིར། ཁོ་རྣམས་ཀྱིས་འདོད་ངན་བྱེད་པ་བཞིན་བྱ་མི་རུང་ངོ༌།།"]},{"type":"verse","number":7,"content":["མི་དེ་དག་ལས་འགའ་ཞིག་གིས་སྐུ་འདྲར་བརྟེན་པ༌བཞིན། ཁྱོད་ཅག་གིས་སྐུ་འདྲར་བརྟེན་མི་རུང་། དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"འབངས་རྣམས་བཟའ་བཏུང་རོལ་ཕྱིར༌བསྡད།།","poem":1},{"lineBreak":true},{"text":"རྩེད་མོར་གཡེང་ཕྱིར་ཡར་ལངས༌སོ།།","poem":1},"ཞེས་བཀོད་པ་བཞིན༌ཡིན།"]},{"type":"verse","number":8,"content":["མི་དེ་རྣམས་ལས་ཁ་ཤས་ཀྱིས་ལོག་གཡེམ་བྱས་པས་ཉིན་གཅིག་ལ་མི་ཉིས་ཁྲི་སུམ་སྟོང་ཤི་བ༌བཞིན། བདག་ཅག་གིས་ལོག་གཡེམ་མི༌བྱའོ།།"]},{"type":"verse","number":9,"content":["ཡང་མི་ཁ་ཤས་ཀྱིས་གཙོ་བོ་ལ་ཚོད་བགམ་བྱས་པས་དེ་རྣམས་དུག་སྦྲུལ་དག་གིས་བསད་པ༌བཞིན། བདག་ཅག་གིས་ཁོང་ལ་ཚོད་བགམ་མི༌བྱའོ།།"]},{"type":"verse","number":10,"content":["ཡང་མི་འགའ་ཞིག་གིས་འཁང་ར་བྱས་པས་ཁོ་རྣམས་སྲོག་གཅོད་མཁན་གྱིས་བསད་པ༌བཞིན། བདག་ཅག་གིས་འཁང་ར་མི༌བྱའོ།།"]},{"type":"verse","number":11,"content":["དོན་དམ་དུ་མི་དེ་རྣམས་ཕྲད་པའི་དོན་འདི་དག་ནི་བདག་ཅག་གི་ཕྱི་འདོམས་ཀྱི་མེ་ལོང་ཡིན༌ཏེ། གསུང་རབ་ཀྱི་ནང་དུ་བཀོད་ཅིང་བདག་ཅག་ལ་བསྐལ་པའི་མཐའ་མ་དེ་སླེབས་པར་ཉེན་བརྡ་བརྒྱབ་པའང་ཡིན་ནོ།།"]},{"type":"verse","number":12,"content":["དེའི༌ཕྱིར། སུ་ཞིག་གིས་རང་ཉིད་ཀྱི་དད་པ་བརྟན་པོ་ཡིན་སྙམ༌ན། རང་ཉིད་སྡིག་པའི་ནང་དུ་མི་ལྷུང་བའི་ཕྱིར་གཟབ་གཟབ་བྱ་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཅག་ལ་ཐེབས་པའི་ཉམས་ཚོད་ནི་མི་གཞན་རྣམས་ལའང་ཐེབས་མྱོང༌བ་ཡིན། དཀོན་མཆོག་ནི་ཡིད་རྟོན་རུང་བ་ཡིན༌ཏེ། ཁྱོད་རྣམས་ལ་བཟོད་བསྲན་བྱ་མི་ནུས་པའི་ཉམས་ཚོད་ཐེབས་སུ་མི་འཇུག ཉམས་ཚོད་ཐེབས་པའི་དུས༌སུ། ཁྱོད་ཅག་གིས་བཟོད་བསྲན་བྱེད་ཐུབ་པའི༌ཕྱིར། ཁྱོད་རྣམས་ལ་ཐར་པའི་ལམ་ཞིག་གནང་ངེས༌སོ།།"]},{"type":"heading","content":["གཙོ་བོ་ཡེ་ཤུའི་རྗེས་དྲན་གྱི་ཞལ་ཟས་དང་མཆོད༌རྫས།"]},{"type":"verse","number":14,"content":["དེ་བས་ན། བདག་གི་སྙིང་ཉེ་བའི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་གིས་སྐུ་འདྲ་ལ་ཅི་ནས་ཀྱང་མ་བརྟེན༌ཅིག"]},{"type":"verse","number":15,"content":["བདག་གིས་ཤེས་རབ་ཅན་རྣམས་ལ་དོན་འདི་སྨྲས་པ་ཡིན༌ཏེ། ཁྱོད་རྣམས་ཀྱིས་བདག་གི་གཏམ་ལ་ལེགས་ཉེས་འབྱེད་པར༌གྱིས།"]},{"type":"verse","number":16,"content":["བདག་ཅག་གིས་བཀའ་དྲིན་ཞུས་པའི་ཕོར་བ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཁྲག་ལྷན་དུ་འཐུང་བ་མ་ཡིན་ནམ། བདག་ཅག་གིས་བག་ལེབ་དུམ་བུར་བགོས་པ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ལུས་མཉམ་དུ་དང་ལེན་བྱེད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":17,"content":["བདག་ཅག་གི་མི་གྲངས་ཇི་འདྲ་མང་ཡང་བག་ལེབ་གཅིག་ཡོད༌པས། བདག་ཅག་ནི་སྐུ་ལུས་གཅིག་ཡིན༌ཏེ། བདག་ཅག་ཡོངས་ལ་བག་ལེབ་དེ་དུམ་བུར་བགོས་ནས་ཐོབ༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ལྟོས་དང་། མཆོད་རྫས་ཟ༌མཁན་དེ་རྣམས་མཆོད་ཁྲི་ནས་བགོ་སྐལ་འཐོབ་མཁན་མ་ཡིན༌ནམ།"]},{"type":"verse","number":19,"content":["བདག་གིས་འདི་ལྟར་སྨྲས་པའི་དོན་ཅི་ཡིན་ཟེར༌ན། སྐུ་འདྲར་ཕུལ་བའི་མཆོད་རྫས་ལ་སྙིང་པོ་ལྡན༌ནམ། ཡང་ན་སྐུ་འདྲ་དེ་ལ་སྙིང་པོ་ཡོད་དམ་ཞེ་ན་མེད༌པ་ཡིན།"]},{"type":"verse","number":20,"content":["བདག་གིས་འདི་ལྟར་སྨྲ་བ་ནི། ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ལ་མཆོད་པ་ཕུལ་བ་མ་ཡིན༌པར། གདོན་འདྲེ་ལ་མཆོད་པ་ཡིན། ཁྱོད་རྣམས་གདོན་འདྲེ་དང་འབྲེལ་བ་བྱེད་པར་ང་རང་མི༌དགའོ།།"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱིས་གཙོ་བོའི་ཕོར་བ་དང་གདོན་འདྲེའི་ཕོར་བ་གཉིས་ཀ་ལས་འཐུང་མི་རུང༌ལ། གཙོ་བོའི་ཞལ་ཟས་དང་གདོན་འདྲེའི་ཁ་ཟས་གཉིས་ཀ་མཉམ་དུ་ཟ་མི་རུང༌།"]},{"type":"verse","number":22,"content":["བདག་ཅག་གིས་གཙོ་བོ་ལ་ཕྲག་དོག་སློང་བར་མི་འགྱུར་རམ། བདག་ཅག་ཁོང་ལས་ཀྱང་མཐུ་སྟོབས་ཆེའམ་ཞེ་ན་མི་ཆེའོ།།"]},{"type":"heading","content":["དད་ལྡན་གྱི་རང་དབང༌སྐོར།"]},{"type":"verse","number":23,"content":["ལས་ཅི་ཡང་བྱེད་རུང་ཟེར་ཡང་། ལས་ཐམས་ཅད་ལ་ཕན་ཐོགས་ཡོད་པ་མིན། ལས་ཅི་ཡང་བྱེད་རུང་ཟེར་ཡང་། ལས་ཐམས་ཅད་ཀྱིས་མི་གསོ་སྐྱོང་བྱེད་པ་མིན་ནོ།།"]},{"type":"verse","number":24,"content":["མི་སུ་ཡིན་ཡང་རང་གི་ཁེ་ཕན་མི་སེམས་པར་མི་གཞན་གྱི་ཁེ་ཕན་བསམ་དགོས།"]},{"type":"verse","number":25,"content":["ཤ་བཙོང་བའི་ཁྲོམ་ར་ནས་ཉོས་པ་ཐམས་ཅད་བཟའ་རུང༌བ་ཡིན། དེ་ལ་སེམས་ཀྱི་རྐྱེན་གྱིས་དོན་ཅི་ཡང་འདྲི་བར་མི༌བྱེད་དོ།།"]},{"type":"verse","number":26,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཇི་སྐད༌དུ། ས་གཞི་དང་ནི་སྣོད་བཅུད་མ་ལུས་པ་ཐམས་ཅད་གཙོ་བོ་ལ་དབང་བ་ཡིན་ཞེས་གསུངས་ཡོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":27,"content":["གལ༌ཏེ། དད་པ་མེད་པ་ཞིག་གིས་ཁྱོད་ཅག་མགྲོན་དུ་བོས་པ༌དང༌། ཁྱོད་རྣམས་ཀྱང་མགྲོན་ལ་འགྲོ་འདོད་པ་ཡིན༌ན། ཁྱོད་ཅག་གིས་རང་གི་མདུན་དུ་བཤམས་པ་ཐམས་ཅད་བཟའ་རུང༌། དེ་ལ་སེམས་ཀྱི་རྐྱེན་གྱིས་དོན་ཅི་ཡང་འདྲི་བར་མི༌བྱའོ།།"]},{"type":"verse","number":28,"content":["གལ༌ཏེ། མི་ཞིག་གིས་ཁྱོད་རྣམས་ལ་འདི་ནི་མཆོད་པར་ཕུལ་བའི་མཆོད་རྫས་ཡིན་ཟེར༌ན། དེ་ལྟར་སྨྲ་མཁན་དང་དེའི་སེམས་ཀྱི་ཕྱིར་བཟའ་བར་མི༌བྱའོ།།"]},{"type":"verse","number":29,"content":["བདག་གིས་སེམས་ཞེས་སྨྲས་པ་ནི་ཁྱོད་ཅག་གི་ཆེད་དུ་མ་ཡིན་པར་མི་གཞན་གྱི་ཕྱིར་ཡིན། ཅིའི་ཕྱིར་བདག་གི་རང་དབང་འདི་ལ་མི་གཞན་གྱི་སེམས་ཀྱིས་ཚོད་འཛིན་བྱེད༌དམ།"]},{"type":"verse","number":30,"content":["གལ༌ཏེ། བདག་གིས་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས་རྗེས་མཆོད་རྫས་ཟོས་པར་གྱུར༌ན། ཅིའི་ཕྱིར་མི་གཞན་གྱིས་བདག་ལ་སྡིགས་དམོད་བྱེད་པ་ཡིན༌ནམ།"]},{"type":"verse","number":31,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་བཟའ་བཏུང་ངམ་ལས་གང་ཞིག་བྱེད་ཀྱང་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་ཕྱིར་བསྒྲུབ་པར༌བྱའོ།།"]},{"type":"verse","number":32,"content":["ཡ་ཧུ་དཱ་པའམ་གྷི་རིག་པ། ཡང་ན་དཀོན་མཆོག་གི་ཆོས་ཚོགས་བཅས་གང་ཡིན༌ཡང༌། ཁྱོད་ཅག་གིས་དེ་རྣམས་སར་འགྱེལ་དུ་འཇུག་པར་མི༌བྱའོ།།"]},{"type":"verse","number":33,"content":["དེ་ནི་བདག་གིས་ལས་གང་ཞིག་བྱེད་ཀྱང་མི་གཞན་ཐམས་ཅད་དགའ་བར་བྱེད་པ༌དང༌། མི་དེ་རྣམས་ལ་ཐར་པ་འཐོབ་པའི་ཕྱིར། རང་གི་ཁེ་ཕན་མི་སེམས་པར་མི་གཞན་ཐམས་ཅད་ཀྱི་ཁེ་ཕན་བསམས༌པ་བཞིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/9.json","previousChapterAudioLinks":{},"numberOfVerses":33}