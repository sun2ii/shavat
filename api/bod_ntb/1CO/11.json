{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":11,"content":[{"type":"heading","content":["ཆོས་ཚོགས་ནང་གི་ཚོགས་མིའི་བྱ༌སྤྱོད།"]},{"type":"verse","number":1,"content":["དེ་ཡང་བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་མིག་ལྟོས་སུ་བཟུང་བ༌ལྟར། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ང་རང་མིག་ལྟོས་སུ་འཛིན་པར༌གྱིས།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་དོན་ཀུན་གྱི་ཐད་ནས་ང་རང་དྲན༌ཞིང༌། བདག་གིས་ཁྱོད་ཅག་ལ་གནང་བའི་སྲོལ་རྒྱུན་རྣམས་ཀྱང་བརྟན་པོར་སྲུང་བའི༌ཕྱིར། ངས་ཁྱོད་ཅག་ལ་བསྔགས་བརྗོད༌བྱེད་པའོ།།"]},{"type":"verse","number":3,"content":["བདག་གིས་དོན་འདི་ཁྱོད་རྣམས་ལ་ཤེས་སུ་འཇུག་འདོད༌དེ། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་སྐྱེས་པ་རྣམས་ཀྱི་དབུ་ཡིན༌ཞིང༌། སྐྱེས་པ་ནི་སྐྱེས་མ་རྣམས་ཀྱི་མགོ་ཡིན༌ལ། དཀོན་མཆོག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་དབུ་ཡིན་ནོ།།"]},{"type":"verse","number":4,"content":["སྐྱེས་པ་རྣམས་ཀྱིས་གསོལ་བ་འདེབས་པའམ་ལུང་བསྟན་གནང་བའི་དུས༌སུ། རང་གི་མགོའི་སྐྲ་བཏུམས་པར་བྱེད༌ན། དེ་ནི་རང་གི་མགོ་ངོ་གནོང་བར་བྱེད༌པ་ཡིན།"]},{"type":"verse","number":5,"content":["སྐྱེས་མ་རྣམས་ཀྱིས་གསོལ་བ་འདེབས་པའམ་ལུང་བསྟན་གནང་བའི་དུས༌སུ། རང་གི་མགོའི་སྐྲ་མ་བཏུམས༌ན། དེ་ནི་རང་གི་མགོ་ངོ་གནོང་བར་བྱེད༌པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་སྐྲ་བཞར་བ་དང་མཚུངས་",{"noteId":2},"པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":6,"content":["གལ༌ཏེ། སྐྱེས་མ་རྣམས་ཀྱིས་མགོའི་སྐྲ་བཏུམ་པར་མི་བྱེད༌ན། ཁོ་མོའི་སྐྲ་ནི་བཞར་འོས༌ཏེ། སྐྱེས་མ་རྣམས་ཀྱིས་སྐྲ་འབྲེག་པའམ་སྐྲ་བཞར་བ་ནི་ངོ་ཚ་ཞིག་ཏུ་འདོད་ན་མགོའི་སྐྲ་བཏུམ་དགོས་སོ།།"]},{"type":"verse","number":7,"content":["སྐྱེས་པ་རྣམས་ནི་དཀོན་མཆོག་གི་སྣང་བརྙན་དང་གཟི་བརྗིད་ཡིན༌པས། སྐྱེས་པ་རྣམས་ཀྱིས་མགོའི་སྐྲ་བཏུམ་པར་མི་འོས་སོ།། འོན༌ཀྱང༌། སྐྱེས་མ་རྣམས་ནི་སྐྱེས་པའི་གཟི་བརྗིད་ཡིན༌ཏེ།"]},{"type":"verse","number":8,"content":["ཐོག་མར་སྐྱེས་པ་ནི་སྐྱེས་མ་ལས་བྱུང་བ་མ་ཡིན༌པར། སྐྱེས་མ་ནི་སྐྱེས་པ་ལས་བྱུང་བ་ཡིན༌ལ།"]},{"type":"verse","number":9,"content":["སྐྱེས་པ་ནི་སྐྱེས་མའི་ཆེད་དུ་བཀོད་པ་མ་ཡིན༌པར། སྐྱེས་མ་ནི་སྐྱེས་པའི་ཆེད་དུ་བཀོད༌པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེའི༌ཕྱིར། སྐྱེས་མ་དག་ནི་ཕོ་ཉའི་རྐྱེན༌གྱིས། ཁོ་མོ་རྣམས་ཀྱི་མགོ་ལ་དབང་ཆར་གཏོགས་པའི་རྟགས་ཤིག་བརྒྱན་ན་འོས༌སོ།།"]},{"type":"verse","number":11,"content":["འོན༌ཀྱང༌། གཙོ་བོའི་ཐུགས་བཀོད་ལྟར་ན་སྐྱེས་མ་ནི་སྐྱེས་པ་དང་འབྲེལ་བ་མེད་པ་མིན༌ལ། སྐྱེས་པའང་སྐྱེས་མ་དང་འབྲེལ་བ་མེད་པ་མིན་ནོ།།"]},{"type":"verse","number":12,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྐྱེས་མ་ནི་སྐྱེས་པ་ལས་བྱུང་བ༌དང༌། སྐྱེས་པ་ནི་བུད་མེད་ཀྱིས་བཙས་པ་ཡིན༌མོད། འོན་ཀྱང་དངོས་པོ་ཐམས་ཅད་ནི་དཀོན་མཆོག་ནས་བྱུང་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":13,"content":["དེས་ན་ཁྱོད་ཅག་གིས་བརྟག་པར་བྱ༌སྟེ། སྐྱེས་མ་རྣམས་ཀྱིས་དཀོན་མཆོག་ལ་གསོལ་བ་འདེབས་པའི་དུས༌སུ། མགོའི་སྐྲ་མ་བཏུམས་ན་འོས༌སམ།"]},{"type":"verse","number":14,"content":["རང་གཤིས་ཀྱིས་ཀྱང་ཁྱོད་ཅག་ལ་བསྟན་པ་བཞིན། སྐྱེས་པ་རྣམས་ཀྱི་མགོའི་སྐྲ་རིང་ན་དེ་ནི་ཁོ་རྣམས་ཀྱི་ངོ་ཚ་མ་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["འོན༌ཀྱང༌། སྐྱེས་མ་རྣམས་ལ་སྐྲ་རིང་པོ་ཡོད༌ན། དེ་ནི་སྐྱེས་མ་རྣམས་ཀྱི་གཟི་བརྗིད་ཡིན༌ཏེ། སྐྲ་རིང་པོ་ནི་སྐྱེས་མ་རྣམས་ལ་མགོ་བཏུམ་བྱེད་དུ་གནང་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":16,"content":["གལ༌ཏེ། མི་ཞིག་གིས་འདིའི་སྐོར་ལ་རྩོད་པ་བྱེད་འདོད༌ན། ངེད་ཅག་ལ་ལུགས་སྲོལ་དེ་ལྟ་བུ་མེད༌ལ། དཀོན་མཆོག་གི་ཆོས་ཚོགས་དག་ལའང་ལུགས་སྲོལ་དེ་ལྟ་བུ་མེད༌དོ།།"]},{"type":"heading","content":["གཙོ་བོ་ཡེ་ཤུའི་རྗེས་དྲན་གྱི་ཞལ་ཟས༌སྐོར།"]},{"type":"verse","number":17,"content":["ད་ལྟ་བདག་གིས་ཁྱོད་རྣམས་ལ་ཁ་བསྒོ་གནང་བ་ནི་ཁྱོད་ཅག་ལ་བསྔགས་པ་མིན༌ཏེ། ཁྱོད་ཅག་མཉམ་དུ་འཚོགས་པ་ལ་དགེ་མཚན་ལས་གནོད་པ་ཡོད་དོ།།"]},{"type":"verse","number":18,"content":["བདག་གིས་གོ་ཐོས་ལྟར༌ན། ཁྱོད་རྣམས་ཀྱི་ཆོས་ཚོགས་མཉམ་དུ་འཚོགས་པའི་དུས་སུ་ནང་མཐུན་མེད་ཟེར། བདག་ཀྱང་དོན་དེར་ཅུང་ཙམ་ཡིད་ཆེས་པ་ཡིན།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་གི་ཁྲོད་དུ་ཚོད་བགམ་འཐེག་པའི་དད་ལྡན་རྣམས་གསལ་པོར་མངོན་པའི༌ཕྱིར། ཕྱོགས་ཁག་སྒྲིག་པའི་དོན་དེ་འབྱུང་ངེས༌པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེ་ལྟར་ཡིན་པས། ཁྱོད་ཅག་མཉམ་དུ་འཚོགས་པའི་དུས༌སུ། ཁྱོད་ཅག་གིས་ཟ་བ་ནི་གཙོ་བོའི་རྗེས་དྲན་གྱི་ཞལ་ཟས་མིན།"]},{"type":"verse","number":21,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁ་ཟས་བཟའ་བའི་དུས་སུ་མི་རྣམས་ཀྱིས་རང་གི་ཁ་ཟས་སྔོན་ལ་ཟ་བ༌དང༌། ཐ་ན་མི་ལ་ལ་ལྟོགས་ཤིང་ལ་ལ་ཆང་གིས་བཟི་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་བཟའ་བཏུང་ལ་རོལ་ན་ཁྱོད་ཅག་ལ་ཁྱིམ་ཚང་མེད༌དམ། ཡང་ན་དཀོན་མཆོག་གི་ཆོས་ཚོགས་ལ་མཐོང་ཆུང་དང་དབུལ་པོ་རྣམས་ངོ་ཚ་བར་བྱེད་དམ། བདག་གིས་ཁྱོད་ཅག་ལ་ཅི་ལྟར་སྨྲའམ། བདག་གིས་ཁྱོད་ཅག་ལ་བསྟོད་བསྔགས་བྱེད་དམ་ཞེ༌ན། བསྟོད་བསྔགས་གཏན་ནས་མི་བྱེད༌དོ།།"]},{"type":"verse","number":23,"content":["དེ་ཡང་བདག་གིས་སྔོན་ཆད་ཁྱོད་ཅག་ལ་ཆོས་གསུངས་མྱོང་བ་དེ་ནི་གཙོ་བོ་ནས་ཐོབ་པ་ཡིན༌ཏེ། གཙོ་བོ་ཡེ་ཤུ་ལ་ངོ་ལོག་བྱེད་པའི་མཚན་མོ་དེར་ཁོང་གིས་ཕྱག་ཏུ་བག་ལེབ་བསྣམས༌ཤིང༌།"]},{"type":"verse","number":24,"content":["བཀའ་དྲིན་ཞུས་རྗེས་དུམ་བུར་བགོས་ཏེ་འདི་སྐད༌དུ། འདི་ནི་བདག་གི་ལུས་པོ་ཡིན་ཏེ་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་སྦྱིན་པ༌ཡིན། ང་རང་རྗེས་སུ་དྲན་པའི་ཕྱིར་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་འདི་ལྟར་བྱོས་ཤིག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":25,"content":["དེ་ནས་ཁོང་གིས་ཞལ་ཟས་བཞེས་ཚར་རྗེས་སྔར་བཞིན་ཕོར་བ་ཕྱག་ཏུ་བསྣམས་ཏེ་འདི་སྐད༌དུ། ཕོར་བ་འདི་ནི་བདག་གི་ཁྲག་གིས་བཞག་པའི་ཞལ་ཆད་གསར་པ་ཡིན༌ལ། ཁྱོད་རྣམས་ཀྱིས་འཐུང་ཐེངས་རེ་རེར་ང་རང་རྗེས་སུ་དྲན་པའི་ཕྱིར་འདི་ལྟར་བྱོས་ཤིག་ཅེས་གསུངས༌པའོ།།"]},{"type":"verse","number":26,"content":["དེ་ནི་གཙོ་བོ་ཡེ་ཤུ་ཁོང་ཉིད་ཕེབས་ཡོང་བའི་བར༌དུ། ཁྱོད་ཅག་གིས་བག་ལེབ་འདི་ཉིད་ཟ་ཞིང་ཕོར་བ་འདི་ལས་འཐུང་ཐེངས་རེ༌རེར་གཙོ་བོ་སྐུ་གྲོངས་པའི་གནས་ཚུལ་དེ་གསལ་པོར་སྟོན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":27,"content":["དེའི༌ཕྱིར། མི་སུས་ཀྱང་ལུགས་དང་མི་མཐུན་པར་གཙོ་བོའི་བག་ལེབ་ཟ་ཞིང་ཕོར་བ་ལས་འཐུང་བ་ཡིན༌ན། མི་དེ་གཙོ་བོའི་སྐུ་ལུས་དང་སྐུ་ཁྲག་གཉིས་ཀྱི་དོན་དང་འགལ༌བའོ།།"]},{"type":"verse","number":28,"content":["མི་སུས་ཀྱང་རང་ལ་བརྟགས་རྗེས་བག་ལེབ་དེ་ཟ་ཞིང་ཕོར་བ་དེ་ལས་འཐུང་འོས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["ཅིའི་ཕྱིར་ཞེ་ན། གཙོ་བོའི་སྐུ་ལུས་ཡིན་པ་མ་རྟོགས༌པར། བག་ལེབ་ཟ་ཞིང་ཕོར་བ་ལས་འཐུངས་ན་རང་ལ་ཉེས་ཆད་འཕོག་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":30,"content":["དེ་བས་ཁྱོད་ཅག་གི་ཁྲོད་དུ་ལུས་སྟོབས་ཞན་པ་དང་ནད༌པ། ཚེ་ལས་འདས་པའང་མང་ངོ་།།"]},{"type":"verse","number":31,"content":["བདག་ཅག་གིས་སྔོན་དུ་རང་ལ་བརྟགས་ན་ཉེས་ཆད་འཕོག་པར་མི་འགྱུར་རོ།།"]},{"type":"verse","number":32,"content":["འོན༌ཀྱང༌། བདག་ཅག་ལ་ཁྲིམས་ཐག་གཅོད་པའི་དུས༌སུ། གཙོ་བོས་འཇིག་རྟེན་པ་དང་བདག་ཅག་ལ་མཉམ་དུ་ཉེས་ཆད་མི་གཅོད་པའི་ཕྱིར། ཁོང་གིས་བདག་ཅག་ལ་ཆད་པ་གནང་ངོ་།།"]},{"type":"verse","number":33,"content":["བདག་གི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་མཉམ་དུ་འཚོགས་ནས་གཙོ་བོའི་རྗེས་དྲན་གྱི་ཞལ་ཟས་ལ་རོལ་བའི་དུས༌སུ། ཕན་ཚུན་ལའང་སྒུག་དགོས་སོ།།"]},{"type":"verse","number":34,"content":["གལ༌ཏེ། མི་ལ་ལ་བཀྲེས་ཤིང་ལྟོགས་པ་ཡིན༌ན། ཁྱོད་ཅག་མཉམ་དུ་འཚོགས་ནས་དཀོན་མཆོག་གི་ཉེས་ཆད་མི་འཕོག་པའི༌ཕྱིར། རང་ཁྱིམ་དུ་སྔོན་ལ་ཁ་ཟས་བཟའ་རུང༌། དོན་གཞན་དག་ནི་ང་རང་ཁྱོད་ཅག་གི་གམ་དུ་ཡོང་བའི་དུས་སུ་བཀོད་སྒྲིག༌བྱའོ།།"]}],"footnotes":[{"noteId":2,"caller":"+","text":"སྐྲ་བཞར་བ་དང་མཚུངས་ཞེས་པར་འགྲེལ་ཚུལ་དུ་མ་ཡོད༌ཀྱང༌། འདིར་སྐུ་ཚབ་པ་ཕོལ་ལོལ་གྱི་དུས་སུ་བུད་མེད་རྣམས་ཀྱིས་མགོའི་སྐྲ་མ་བཏུམས་པར་ཚོགས་རར་སོང་ན་སྨད་འཚོང་མ་ཡིན་པར་གོ༌སྟེ། རྒྱུ་མཚན་ནི་སྨད་འཚོང་མ་རྣམས་ཀྱིས་སྐྲ་བཞར་ནས་མགོ་རྗེན་ཡིན་པའི་ཕྱིར་ཡིན།","reference":{"chapter":11,"verse":5}}]},"thisChapterLink":"/api/bod_ntb/1CO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/10.json","previousChapterAudioLinks":{},"numberOfVerses":34}