{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":12,"content":[{"type":"heading","content":["དམ་པའི་ཐུགས་ཉིད་ཀྱི་གནང༌སྦྱིན།"]},{"type":"verse","number":1,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱི་གནང་སྦྱིན་སྐོར་ལེགས་པར་ཤེས་སུ་འཇུག་འདོད་དོ།།"]},{"type":"verse","number":2,"content":["དེ་ཡང་ཁྱོད་རྣམས་ཀླ་ཀློ་ཡིན་པའི་དུས༌སུ། གཞན་གྱིས་ཁྲིད་ཅིང་བསླུ་བྲིད་ཐེབས་པ༌དང༌། སྐུ་འདྲ་ལྐུགས་པ་དག་ལ་བསྙེན་བཀུར་བྱས་པ་ནི་ཁྱོད་ཅག་གིས་ཤེས༌པ་ཡིན།"]},{"type":"verse","number":3,"content":["དེའི༌ཕྱིར། ངས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན་ནས་སྨྲ་མཁན་སུ་ཞིག་གིས་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་དམོད་པ་བྱའོ་ཞེས་སྨྲ་མི་ནུས༌ལ། ཡང་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན་ནས་སྨྲ་བ་ལས་གཞན། སུ་ཞིག་གིས་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་ནི་གཙོ་བོ་ལགས་ཞེས་སྨྲ་མི་ནུས་སོ།།"]},{"type":"verse","number":4,"content":["གནང་སྦྱིན་གྱི་རྣམ་པ་ཐ་དད་ཡིན༌ཡང༌། དམ་པའི་ཐུགས་ཉིད་ནི་གཅིག་པུ་ལགས།"]},{"type":"verse","number":5,"content":["ཞབས་ཕྱི་སྒྲུབ་ཚུལ་གྱི་རྣམ་པ་ཐ་དད་ཡིན༌ཡང༌། གཙོ་བོ་ནི་གཅིག་པུ་ཡིན།"]},{"type":"verse","number":6,"content":["ཕན་ནུས་ཀྱི་རྣམ་པ་ཐ་དད་ཡིན༌ཡང༌། དཀོན་མཆོག་ནི་གཅིག་པུ་ལགས༌པས། མི་ཚོགས་ཀྱི་ནང་དུ་འཕྲིན་ལས་ཐམས་ཅད་མཛད༌པའོ།།"]},{"type":"verse","number":7,"content":["མི་རེ་རེ་ལ་དམ་པའི་ཐུགས་ཉིད་མངོན་པ་ནི་མི་ཐམས་ཅད་ལ་ཕན་ཐོགས་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":8,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་ཞིག་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཤེས་རབ་ལྡན་པའི་སྨྲ་བརྗོད་གནང་བ༌དང༌། མི་གཞན་ཞིག་ལ་དམ་པའི་ཐུགས་ཉིད་གཅིག་ཁོ་ནས་ཤེས་རྟོགས་ལྡན་པའི་སྨྲ་བརྗོད་གནང༌བ་དང་།"]},{"type":"verse","number":9,"content":["མི་གཞན་ཞིག་ལ་དམ་པའི་ཐུགས་ཉིད་གཅིག་ཁོ་ནས་དད་པ་བརྟན་པོ་གནང་བ༌དང༌། མི་གཞན་ཞིག་ལ་དམ་པའི་ཐུགས་ཉིད་གཅིག་ཁོ་ནས་ནད་གསོ་བའི་གནང་སྦྱིན་བསྩལ༌པ་དང་།"]},{"type":"verse","number":10,"content":["མི་གཞན་ཞིག་ལ་དོན་ངོ་མཚར་ཅན་སྒྲུབ་པའི་ནུས་མཐུ་གནང་བ༌དང༌། མི་གཞན་ཞིག་ལ་ལུང་བསྟན་གནང་བའི་ནུས་པ་བསྩལ་པ་དང་། མི་གཞན་ཞིག་ལ་སེམས་ཉིད་སྣ་ཚོགས་ལ་རྣམ་པར་བརྟག་པའི་ནུས་པ་གནང་བ༌དང༌། མི་གཞན་ཞིག་ལ་སྐད་སྣ་ཚོགས་སྨྲ་བའི་ནུས་པ་གནང་ཞིང༌། མི་གཞན་ཞིག་ལ་སྐད་སྒྱུར་བའི་ནུས་པ་གནང་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["དེ་དག་ཐམས་ཅད་ནི་དམ་པའི་ཐུགས་ཉིད་གཅིག་ཁོ་ན་ཡིས་མཛད་ཅིང་ཁོང་གི་ཐུགས་དགོངས་བཞིན་དུ་མི་སོ་སོར་གནང༌བའོ།།"]},{"type":"heading","content":["ལུས་པོ་གཅིག་ལ་ཡན་ལག་མང་བའི༌དཔེ།"]},{"type":"verse","number":12,"content":["དེ་ཡང་ལུས་པོ་ནི་གཅིག་ཡིན་ཡང་དེ་ལ་ཡན་ལག་དུ་མ་ཡོད༌ཅིང༌། ཡན་ལག་ཐམས་ཅད་ནི་མང་ཡང་ལུས་པོ་གཅིག་གི་ཆ་ཤས་ཡིན༌ཏེ། སྐྱབས་མགོན་མཱ་ཤི་ཀའང་དེ་བཞིན་ལགས་སོ།།"]},{"type":"verse","number":13,"content":["བདག་ཅག་ནི་ཡ་ཧུ་དཱ༌པའམ། གྷི་རིག་པའམ། བྲན་གཡོག༌གམ། རང་དབང་ཅན་བཅས་གང་ཞིག་ཡིན༌ཡང༌། ཐམས་ཅད་ལ་དམ་པའི་ཐུགས་ཉིད་གཅིག་ནས་སྐུ་ལུས་གཅིག་གི་ནང་ཁྲུས་གསོལ་ལ་ཞུགས་ཤིང་དམ་པའི་ཐུགས་ཉིད་གཅིག་ཁོ་ནའི་བཏུང་བྱ་གནང་བའོ༎"]},{"type":"verse","number":14,"content":["དེ་ཡང་ལུས་པོ་ནི་ཡན་ལག་གཅིག་ཁོ་ན་མ་ཡིན་པར་དེ་ལ་ཡན་ལག་མང་པོ་ཡོད༌དེ།"]},{"type":"verse","number":15,"content":["རྐང་པ་ན༌རེ། བདག་ནི་ལག་པ་མིན༌པས། ལུས་པོར་མི་གཏོགས་ཞེས་ཟེར༌བའི་དབང་དུ་བཏང་ན། དེའི་རྐྱེན་གྱིས་རྐང་པ་དེ་ནི་ལུས་པོར་མི་གཏོགས་པ་ཞིག་མིན་ནོ།།"]},{"type":"verse","number":16,"content":["ཡང་རྣ་བ་ན༌རེ། བདག་ནི་མིག་མིན༌པས། ལུས་པོར་མི་གཏོགས་ཞེས་ཟེར༌བའི་དབང་དུ་བཏང་ན། དེའི་རྐྱེན་གྱིས་རྣ་བ་དེ་ནི་ལུས་པོར་མི་གཏོགས་པ་ཞིག་མིན།"]},{"type":"verse","number":17,"content":["ཡང་ལུས་ཧྲིལ་པོ་མིག་ཡིན༌ན། སྒྲ་ལ་ཉན་པའི་དབང་པོ་གང་དུ་ཡོད༌དམ། ཡང་ལུས་ཧྲིལ་པོ་རྣ་བ་ཡིན༌ན། དྲི་མ་སྣོམ་པའི་དབང་པོ་གང་དུ་ཡོད༌དམ།"]},{"type":"verse","number":18,"content":["འོན༌ཀྱང༌། དཀོན་མཆོག་གིས་རང་ཉིད་ཀྱི་ཐུགས་དགོངས༌ལྟར། ཡན་ལག་རེ་རེ་བཞིན་ལུས་ཀྱི་གནས་སོ་སོར་བཞག༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":19,"content":["གལ༌ཏེ། ཡན་ལག་ཐམས་ཅད་ནི་ཡན་ལག་གཅིག་ཡིན༌ན། ལུས་པོ་ནི་གང་དུ་ཡོད༌དམ།"]},{"type":"verse","number":20,"content":["འོན༌ཀྱང༌། ད་ལྟ་ཡན་ལག་ནི་མང་པོ་ཡོད་ཀྱང་ལུས་པོ་ནི་གཅིག་པུ་ལགས༌སོ།།"]},{"type":"verse","number":21,"content":["ཡང་མིག་ན༌རེ། བདག་ལ་ཁྱོད་དགོས་དོན་མེད་ཅེས་ལག་པ་ལ་དེ་ལྟར་ཟེར་མི་ནུས༌ལ། མགོ་བོ་ན༌རེ། བདག་ལ་ཁྱོད་དགོས་དོན་མེད་ཅེས་རྐང་པ་ལའང་དེ་ལྟར་ཟེར་མི་ནུས་སོ།།"]},{"type":"verse","number":22,"content":["དེ་ལས་ལྡོག་སྟེ། མི་རྣམས་ཀྱིས་ལུས་སྟེང་གི་ཡན་ལག་ཁ་ཤས་ལ་ནུས་པ་མེད་པར་བསམས༌ཀྱང༌། དོན་ལ་ཡན་ལག་དེ་དག་ནི་ལྷག་ཏུ་མེད་མི་རུང་བ་ཞིག་ཡིན།"]},{"type":"verse","number":23,"content":["བདག་ཅག་གིས་ལུས་སྟེང་གི་ངོ་ཚར་རྩི་བའི་ཡན་ལག་ནི་དེ་ལས་ཀྱང་མཛེས་པར་བརྩིས་པ་དང་། ཡན་ལག་མི་མཛེས་པ་དག་ནི་ལྷག་ཏུ་མཛེས་ཤིང་སྡུག་པར་བྱེད་པ་ཡིན།"]},{"type":"verse","number":24,"content":["བདག་ཅག་གི་མཛེས་ཤིང་སྡུག་པའི་ཡན་ལག་ལ་རྒྱན་ཆས་བརྒྱན་དགོས་དོན་མེད་མོད། འོན༌ཀྱང༌དཀོན་མཆོག་གིས་ལུས་པོ་ལེགས་པར་བསྒྲིགས་ཤིང་། ཡན་ལག་ཉམས་ཞན་ཡིན་པ་དེ་ལྡབ་འགྱུར་གྱིས་མཛེས་ཤིང་སྡུག་པར་མཛད་དེ།"]},{"type":"verse","number":25,"content":["ལུས་པོའི་ནང་དུ་རིགས་མི་མཐུན་པ་མི་འབྱུང༌ཞིང༌། ཡན་ལག་དང་ཡན་ལག་བར་ལ་གཟིགས་སྐྱོང་བྱེད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":26,"content":["གལ༌ཏེ། ཡན་ལག་གཅིག་གིས་སྡུག་བསྔལ་མྱོང་ན། ཡན་ལག་ཐམས་ཅད་ཀྱིས་ཀྱང་ལྷན་དུ་སྡུག་བསྔལ་མྱོང་བ་ཡིན། གལ༌ཏེ། ཡན་ལག་གཅིག་ལ་གཟི་བརྗིད་ཐོབ་ན། ཡན་ལག་ཐམས་ཅད་ཀྱང་མཉམ་དུ་སྤྲོ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":27,"content":["ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ལུས་ཡིན༌ཞིང༌། མི་རེ་རེ་ནི་ཁོང་གི་ཡན་ལག་ཡིན་ནོ།།"]},{"type":"verse","number":28,"content":["དེ་ཡང་དཀོན་མཆོག་གིས་ཆོས་ཚོགས་ནང་དུ་བསྐོས་པ་དང་པོ་ནི་སྐུ་ཚབ་པ༌དང༌། གཉིས་པ་ནི་ལུང་སྟོན༌པ། གསུམ་པ་ནི་སློབ་དཔོན་བཅས་ཡིན༌ལ། དེ་ནས་རིམ་བཞིན་ངོ་མཚར་བའི་དོན་བྱེད་མཁན༌དང༌། ནད་གསོ་བའི་གནང་སྦྱིན་ཐོབ་མཁན། རོགས་རམ་བྱེད༌མཁན། བྱ་བ་གཉེར་མཁན། སྐད་སྣ་ཚོགས་སྨྲ་མཁན་བཅས་ལགས་སོ།།"]},{"type":"verse","number":29,"content":["འོན༌ཀྱང༌། དེ་དག་ཐམས་ཅད་ནི་སྐུ་ཚབ་པ་ཡིན༌ནམ། དེ་དག་ཐམས་ཅད་ནི་ལུང་སྟོན་པ་ཡིན༌ནམ། དེ་དག་ཐམས་ཅད་ནི་སློབ་དཔོན་ཡིན༌ནམ། དེ་དག་ཐམས་ཅད་ནི་ངོ་མཚར་བའི་དོན་བྱེད་མཁན་ཡིན་ནམ་ཞེ་ན་མ་ཡིན།"]},{"type":"verse","number":30,"content":["ཡང་དེ་དག་ཐམས་ཅད་ལ་ནད་གསོ་བའི་གནང་སྦྱིན་ཐོབ་ཡོད༌དམ། དེ་དག་ཐམས་ཅད་ནི་སྐད་གཞན་སྨྲ་བ་ཡིན༌ནམ། དེ་དག་ཐམས་ཅད་ནི་སྐད་སྒྱུར་པ་ཡིན་ནམ་ཞེ་ན་མ་ཡིན་ནོ།།"]},{"type":"verse","number":31,"content":["འོན༌ཀྱང༌། ཁྱོད་ཅག་གིས་ངེས་པར་གནང་སྦྱིན་ཆེན་པོར་དམིགས་དགོས་ལ། བདག་གིས་ད་ལྟ་ཁྱོད་ཅག་ལ་ལམ་ཕུལ་དུ་བྱུང་བ་ཞིག་སྟོན་པར༌བྱའོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/11.json","previousChapterAudioLinks":{},"numberOfVerses":31}