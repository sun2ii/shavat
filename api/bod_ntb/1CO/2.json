{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":2,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་ཆོས་བསྒྲགས༌ཚུལ།"]},{"type":"verse","number":1,"content":["སྤུན་ཟླ༌རྣམས། སྔོན་ཆད་ང་རང་ཁྱོད་ཅག་གི་གམ་དུ་ཡོང་བའི་དུས༌སུ། ཁྱོད་ཅག་ལ་དཀོན་མཆོག་གི་གསང་བ་ནི་མཁས་པའི་གཏམ་དང་ཤེས་རབ་ཀྱི་སྒོ་ནས་བསྒྲགས་པ་མིན་ནོ།།"]},{"type":"verse","number":2,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ངས་སྔར་ནས་ཡེ་ཤུ་མཱ་ཤི་ཀ་དང་ཁོང་ཉིད་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པའི་དོན་དེ་ཤེས་པ་ལས༌གཞན། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་ཅི་ཡང་མི་ཤེས་ཞེས་སེམས་ཐག་བཅད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":3,"content":["བདག་ནི་ཁྱོད་ཅག་དང་མཉམ་དུ་ཡོད་པའི་དུས༌སུ། ཉམ་ཐག་པ༌དང༌། འཇིགས་ཤིང་སྐྲག༌པ། འདར་འདར་ཞུམ་ཞུམ་གྱི་ངང་ནས་བསྡད་པ༌དང༌།"]},{"type":"verse","number":4,"content":["བདག་གིས་གཏམ་སྨྲས་པ་དང་ཆོས་བསྒྲགས་པ་ནི་ཤེས་རབ་དང་གནས་ལུགས་ལ་བརྟེན་པ་མ་ཡིན༌པར། དམ་པའི་ཐུགས་ཉིད་དང་མཐུ་སྟོབས་ཆེན་པོའི་བདེན་དཔང་ཡིན༌ལ།"]},{"type":"verse","number":5,"content":["དེ་ནི་ཁྱོད་ཅག་གི་དད་པ་ནི་མིའི་ཤེས་རབ་ལ་རག་མི་ལས༌པར། དཀོན་མཆོག་གི་མཐུ་སྟོབས་ཆེན་པོར་རག་ལས་པའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["དམ་པའི་ཐུགས་ཉིད་ནས་བྱུང་བའི་ཤེས་རབ༌སྐོར།"]},{"type":"verse","number":6,"content":["དེ་ལྟར་སྨྲས༌ནའང༌། ངེད་ཅག་གིས་དད་པ་བརྟན་པོ་རྣམས་ཀྱི་ཁྲོད་ནས་ཤེས་རབ་སྐོར༌སྨྲ་བ་ཡིན་མོད། འོན་ཀྱང་དེ་ནི་འཇིག་རྟེན་འདིའི་ཤེས་རབ་མ་ཡིན༌ལ། འཇིག་རྟེན་འདིའི་དབང་དང་གོ་གནས་ཡོད་ཀྱང་ཕྱིས་སུ་ཕམ་ཞིང་འཇིག་པར་འགྱུར་བ་རྣམས་ཀྱི་ཤེས་རབ་ཀྱང་མིན༌ཏེ།"]},{"type":"verse","number":7,"content":["ངེད་ཅག་གིས་སྨྲ་བའི་ཤེས་རབ་ནི་ཐོག་མ་ཉིད་ཀྱི་སྔ་རོལ་ནས་དཀོན་མཆོག་གིས་ཐག་གིས་བཅད་ཅིང་། བདག་ཅག་ལ་གཟི་བརྗིད་འཐོབ་པའི༌ཕྱིར། ཁོང་གིས་གསང་བར་མཛད་པའི་ཤེས་རབ་དེ་ཉིད་ཡིན་ནོ།།"]},{"type":"verse","number":8,"content":["འཇིག་རྟེན་འདིའི་དབང་དང་གོ་གནས་ཡོད་པ་རྣམས་ལས་ཤེས་རབ་དེ་ཉིད་རྟོགས་མཁན་གཅིག་ཀྱང་མ་མཆིས། གལ༌ཏེ། དེ་རྣམས་ཀྱིས་རྟོགས་པ་ཡིན༌ན། གཟི་བརྗིད་ལྡན་པའི་གཙོ་བོ་ནི་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་མེད་དོ།།"]},{"type":"verse","number":9,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དཀོན་མཆོག་གིས་ནི་རང་ཉིད༌ལ།།","poem":1},{"lineBreak":true},{"text":"གཅེས་མཁན་དག་ལ་སྟ་གོན༌མཛད།།","poem":1},{"lineBreak":true},{"text":"དེ་ནི་མིག་གིས་མ་མཐོང་ཞིང་།།","poem":1},{"lineBreak":true},{"text":"རྣ་བས་ཐོས་པར་མ་གྱུར་ལ།།","poem":1},{"lineBreak":true},{"text":"སེམས་སུ་དྲན་ཡང་མ་མྱོང་ངོ་།།","poem":1},"ཞེས་བཀོད་པ་བཞིན་ནོ།།"]},{"type":"verse","number":10,"content":["འོན༌ཀྱང༌། དོན་དེ་རྣམས་ནི་དཀོན་མཆོག་གིས་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ངང་ནས་བདག་ཅག་ལ་གསལ་པོར་མངོན་པར་མཛད༌པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། དམ་པའི་ཐུགས་ཉིད་ཀྱིས་དོན་ཀུན་མཁྱེན༌ཞིང་། དཔོག་པར་དཀའ་བའི་དཀོན་མཆོག་གི་གསང་བའི་དོན་རྣམས་ཀྱང་མཁྱེན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["མིའི་སེམས་ནང་གི་སེམས་ཉིད་ལས༌གཞན། སུ་ཞིག་གིས་མི་དེའི་བསམ་པ་ཤེས༌སམ། དེ་བཞིན་དུ་དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་ལས༌གཞན། སུ་ཞིག་གིས་ཀྱང་དཀོན་མཆོག་གི་ཐུགས་དགོངས་མི་རྟོགས་སོ།།"]},{"type":"verse","number":12,"content":["བདག་ཅག་ལ་ཐོབ་པ་ནི་འཇིག་རྟེན་གྱི་སེམས་ཉིད་མ་ཡིན༌པར། དཀོན་མཆོག་ནས་བྱུང་བའི་ཐུགས་ཉིད་ཡིན༌ཏེ། དཀོན་མཆོག་གིས་བདག་ཅག་ལ་གནང་བའི་གནང་སྦྱིན་དེ་དག་བདག་ཅག་གིས་རྟོགས་ཐུབ་པའི་ཕྱིར་ཡིན༌ལ།"]},{"type":"verse","number":13,"content":["ངེད་ཅག་གིས་དོན་དེ་རྣམས་སྨྲ་བ་ཡིན་ཞིང་། དེ་ནི་མིའི་ཤེས་རབ་ཀྱིས་བསྟན་པའི་ཚིག་བཞིན་མ་ཡིན༌པར། དམ་པའི་ཐུགས་ཉིད་ཀྱིས་བསྟན་པ༌བཞིན། དམ་པའི་ཐུགས་ཉིད་དང་ལྡན་པའི་མི་རྣམས་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱི་དོན་འགྲེལ་བ་ཡིན་ནོ།།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཤ་ཁྲག་གི་ཕུང་བོར་གཏོགས་པའི་མི་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་ཀྱི་དོན་རྣམས་ཁས་མི་ལེན་ཞིང་། དེ་ནི་རྨོངས་པར་འདོད་པ་ལས་ཅི་ཡང་ཤེས་མི་ནུས་སོ།། ཅིའི་ཕྱིར་ཞེ་ན། དོན་དེ་དག་ནི་དམ་པའི་ཐུགས་ཉིད་ཁོ་ནར་བརྟེན་ནས་རྟོགས་ཐུབ་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":15,"content":["འོན༌ཀྱང༌། དམ་པའི་ཐུགས་ཉིད་ལྡན་པའི་མི་རྣམས་ཀྱིས་དོན་ཀུན་གསལ་པོར་རྟོགས་ཐུབ༌ནའང༌། གཞན་སུས་ཀྱང་མི་དེ་ནི་གསལ་པོར་རྟོགས་མི་ནུས་ལ།"]},{"type":"verse","number":16,"content":["དེ་ལ་ཇི་སྐད༌དུ། གཙོ་བོའི་ཐུགས་ནི་སུ་ཡིས༌རྟོགས། ཁོང་ལ་བསླབ་བྱ་སུ་ཡིས༌སྟོན་ཞེས་གསུངས་པ་ལྟར༌ཡིན། འོན༌ཀྱང༌། བདག་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཐུགས་དང་ལྡན་པར་གྱུར༌པའོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}