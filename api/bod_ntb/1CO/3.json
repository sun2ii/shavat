{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":3,"content":[{"type":"heading","content":["ཆོས་ཚོགས་ནང་གི་རྩོད་གཞི༌སྐོར།"]},{"type":"verse","number":1,"content":["སྤུན་ཟླ༌རྣམས། ངས་སྔོན་ཆད་ཁྱོད་རྣམས་དམ་པའི་ཐུགས་ཉིད་ལྡན་པའི་མི་རྣམས་དང་འདྲ་བར་སྨྲ་མ་ནུས་ལ། ཁྱོད་ཅག་ནི་ཤ་གཟུགས་ཀྱི་ཕུང་བོར་གཏོགས་ཤིང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ཕྲུ་གུ་དང་འདྲ་བར་སྨྲས་སོ།།"]},{"type":"verse","number":2,"content":["བདག་གིས་ཁྱོད་རྣམས་འོ་མས་གསོས་པ་ལས་བཟའ་བཏུང་གིས་གསོས་པ་མ་ཡིན། དེའི་དུས་སུ་ཁྱོད་རྣམས་ཀྱིས་ཟས་ཟ་བར་མ་ནུས༌ལ། ད་ལྟའང་སྔར་བཞིན་ཟ་བར་མི་ནུས་སོ།།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཅག་ནི་ད་དུང་ཤ་གཟུགས་ཀྱི་ཕུང་བོར་གཏོགས་ཏེ། ཁྱོད་ཅག་གི་ཁྲོད་དུ་ཕྲག་དོག་དང་རྩོད་གླེང་ཡོད༌པས། དེ་ནི་ཤ་གཟུགས་ཀྱི་ཕུང་བོ་དང་མཚུངས་ཤིང་། འཇིག་རྟེན་གྱི་མིའི་སྤྱོད་ཚུལ་བཞིན་དུ་བྱེད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":4,"content":["མི་ལ་ལ་ན༌རེ། ང་ནི་ཕོལ་ལོལ་གྱི་ཡིན་ཞེས༌དང༌། ཡང་མི་ལ་ལ་ན༌རེ། ང་ནི་ཨ་པོལ་ལོའི་ཡིན་ཞེས་ཟེར༌ན། ཁྱོད་རྣམས་ནི་འཇིག་རྟེན་གྱི་མི་དང་མཚུངས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":5,"content":["ཨ་པོལ་ལོ་དང་ཕོལ་ལོལ་གཉིས་ནི་མི་ག་འདྲ་ཞིག་ཡིན་ཞེ༌ན། དེ་ནི་གཙོ་བོས་ངེད་ཅག་མི་རེ་རེར་ལས་འགན་གནང་བ༌བཞིན། ཁྱོད་རྣམས་དད་པའི་ལམ་དུ་ཁྲིད་པའི་ཞབས་ཕྱི་པ་ཡིན།"]},{"type":"verse","number":6,"content":["བདག་གིས་ས་བོན་བཏབ་ཅིང་ཨ་པོལ་ལོ་ཡིས་ཆུ་བཏང༌ནའང༌། ས་བོན་སྐྱེ་རུ་འཇུག་མཁན་ནི་དཀོན་མཆོག་ཡིན་ནོ།།"]},{"type":"verse","number":7,"content":["དེའི༌ཕྱིར། ས་བོན་འདེབས་མཁན་ནམ་ཆུ་གཏོང་མཁན་ནི་ཅི་ཡང་མིན༌ཏེ། ས་བོན་སྐྱེ་རུ་འཇུག་མཁན་དཀོན་མཆོག་ནི་གལ་ཆེའོ།།"]},{"type":"verse","number":8,"content":["ས་བོན་འདེབས་མཁན་དང་ཆུ་གཏོང་མཁན་གཉིས་ནི་གཅིག་མཚུངས་ཡིན༌ཡང༌། ཕྱིས་སུ་རང་རང་གི་རྩོལ་བ་བཞིན་དུ་བྱ་དགའ་འཐོབ་པར་འགྱུར་རོ།།"]},{"type":"verse","number":9,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ངེད་ཅག་ནི་དཀོན་མཆོག་གི་ལས་གྲོགས་ཡིན༌ལ། ཁྱོད་རྣམས་ནི་དཀོན་མཆོག་གིས་རྨོས་པའི་ས་ཞིང༌དང༌། ཁོང་གིས་བཀོད་པ་དེ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་གིས་བདག་ལ་གནང་བའི་ཐུགས་རྗེ་བཞིན༌དུ། བདག་གིས་སྤྱང་གྲུང་ལྡན་པའི་བཟོ་དཔོན་ཞིག་དང་འདྲ་བར་རྨང་གཞི་བཙུགས་པ༌དང༌། རྨང་གཞི་དེའི་སྟེང་ནས་མི་གཞན་ཞིག་གིས་བཟོ༌བཞིན་ཡོད། འོན༌ཀྱང༌། མི་སོ་སོས་རྨང་གཞིའི་སྟེང་ནས་ཅི་ལྟར་བཟོ་བར་གཟབ་དགོས་སོ།།"]},{"type":"verse","number":11,"content":["ཅིའི་ཕྱིར་ཞེ་ན། རྨང་གཞི་བཏིངས་ཟིན་པ་དེ་ནི་ཡེ་ཤུ་མཱ་ཤི་ཀ་འབའ་ཞིག༌ཡིན། ཁོང་ཉིད་ལས་གཞན་མི་སུས་ཀྱང་རྨང་གཞི་གཞན་འཛུགས་མི་ནུས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":12,"content":["གལ༌ཏེ། སུ་ཞིག་གིས་རྨང་གཞི་དེའི་སྟེང་དུ་གསེར༌རམ། ཡང་ན་དངུལ། རིན་པོ༌ཆེ། ཤིང༌། རྩྭ། སོག་མ་བཅས་ཀྱིས་བཟོས༌ན།"]},{"type":"verse","number":13,"content":["མི་རྣམས་ཀྱིས་བཟོས་པ་དེ་ནི་ག་འདྲ་ཡིན་པ་གསལ་པོར་མངོན་པར་འགྱུར་ངེས༌ཡིན། རྒྱུ་མཚན་ནི་ཉིན་མོ་དེ་ཡིས་མངོན་པར་མཛད་པ་དང་། མེ་བྱུང་ནས་མི་རེ་རེས་བཟོས་པའི་བཟོ་བཀོད་དེ་ཅི་འདྲ་ཡིན་པར་མེ་ཡིས་ཚོད་བགམ་བྱེད་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":14,"content":["གལ༌ཏེ། སུ་ཞིག་གིས་རྨང་གཞི་དེའི་སྟེང་དུ་བསྐྲུན་པའི་བཟོ་བཀོད་གནས་པ་ཡིན༌ན། ཁོ་རང་ལ་བྱ་དགའ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["འོན༌ཀྱང༌། སུ་ཞིག་གིས་བསྐྲུན་པའི་བཟོ་བཀོད་དེ་མེར་ཚིག་པ་ཡིན༌ན། གྱོང་གུད་ཐེབས་ཀྱང་ཁོ་རང་ནི་ཐར་བར་འགྱུར། དེ་ནི་མེ་ཕུང་བརྒྱུད་ནས་འགྲོ་བ་ལྟར་ཐར་བར་འགྱུར་རོ།།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ནི་དཀོན་མཆོག་གི་མཆོད་ཁང་ཡིན༌ཞིང༌། དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་ཁྱོད་ཅག་གི་ནང་དུ་བཞུགས་པ་མི་ཤེས༌སམ།"]},{"type":"verse","number":17,"content":["གལ༌ཏེ། སུ་ཞིག་གིས་མཆོད་ཁང་དེ་བཤིག༌ན། དཀོན་མཆོག་གིས་མི་དེའང་མེད་པར་མཛད་ངེས༌ཡིན། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གི་མཆོད་ཁང་ནི་དམ་པ་ཡིན༌ལ། མཆོད་ཁང་དེ་ནི་ཁྱོད་རྣམས་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":18,"content":["མི་སུས་ཀྱང་རང་མགོ་རང་གིས་གཡོག་མི་འོས་སོ།། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་སུ་ཞིག་གིས་འཇིག་རྟེན་འདིར་རང་ཉིད་ནི་མཁས་པ་ཡིན་པར་འདོད་ན། ཤེས་རབ་ལྡན་པར་འགྱུར་བའི༌ཕྱིར། བླུན་པོ་ཞིག་ཏུ་བྱས་ན་ལེགས།"]},{"type":"verse","number":19,"content":["ཅིའི་ཕྱིར་ཞེ་ན། འཇིག་རྟེན་འདིའི་ཤེས་རབ་ནི་དཀོན་མཆོག་གི་སྤྱན་སྔར་བླུན་རྨོངས་ཡིན༌ཏེ། གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དཀོན་མཆོག་གིས་ནི་ཤེས་རབ་ཅན་དེ་རྣམས།།","poem":1},{"lineBreak":true},{"text":"རང་ཉིད་རང་གི་གཡོ་སྒྱུར་ཚུད་པར༌མཛད།།","poem":1},"ཅེས་བཀོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":20,"content":["ཡང་ཇི་སྐད༌དུ།",{"text":"ཤེས་རབ་ཅན་གྱི་འདོད་བློ་སྟོང་བ༌དེ།།","poem":1},{"lineBreak":true},{"text":"གཙོ་བོ་ལགས་ཀྱིས་ཇི་བཞིན༌མཁྱེན་པའོ། །","poem":1},"ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":21,"content":["དེའི༌ཕྱིར། སུས་ཀྱང་མི་གཞན་ལ་བསྔགས་བརྗོད་བྱ་མི་རུང་སྟེ། དངོས་པོ་མཐའ་དག་ནི་ཁྱོད་ཅག་ལ་གཏོགས་པས་སོ།།"]},{"type":"verse","number":22,"content":["ཕོལ་ལོལ༌ལམ། ཡང་ན་ཨ་པོལ་ལོ། ཀེ་ཕཱ། འཇིག་རྟེན། གསོན་པ། འཆི༌བ། ད་ལྟའི་དོན། མ་འོངས་པའི་དོན་བཅས་ཐམས་ཅད་ཁྱོད་ཅག་ལ་གཏོགས་ཤིང༌།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀར་གཏོགས་པ༌དང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་དཀོན་མཆོག་ལ་གཏོགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/2.json","previousChapterAudioLinks":{},"numberOfVerses":23}