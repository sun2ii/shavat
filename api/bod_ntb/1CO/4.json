{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":4,"content":[{"type":"heading","content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཚབ༌པ།"]},{"type":"verse","number":1,"content":["མི་སུས་ཀྱང་ངེད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཞབས་ཕྱི་པ་དང་དཀོན་མཆོག་གི་གསང་བའི་དོན་རྣམས་ཀྱི་གཉེར་པ་རུ་བརྩི་རུང༌ཞིང༌།"]},{"type":"verse","number":2,"content":["ལྷག་པར་གཉེར་པ་ནི་བསམ་པ་རྣམ་དག་ཡིན་དགོས་སོ།།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཅག་གམ་མིའི་ཁྲིམས་ར་གང་ཞིག་གིས་བདག་ལ་ཁ་ཚོན་བཅད༌ཀྱང༌། བདག་གིས་དེ་ནི་དོན་ཆུང་ངུ་ཞིག་ཏུ་རྩི་ཞིང་རང་གིས་ཀྱང་རང་ལ་ཁ་ཚོན་མི་གཅོད་དེ།"]},{"type":"verse","number":4,"content":["ངས་རང་ཉིད་ལ་ནོར་འཁྲུལ་ཡོད་པ་མ་ཚོར༌ཡང༌། དེའི་རྐྱེན་གྱིས་ང་རང་ནི་སྐྱོན་མེད་པ་ཞིག་མིན༌ཏེ། བདག་ལ་བརྡར་ཤ་གཅོད་པར་མཛད་མཁན་ནི་གཙོ་བོ་ལགས་སོ།།"]},{"type":"verse","number":5,"content":["དེའི༌ཕྱིར། དུས་མ་རན་པར་མི་སུས་ཀྱང་ཁ་ཚོན་གཅོད་པར་མི༌བྱའོ།། གཙོ་བོ་ཁོང་ཉིད་ཕེབས་ཡོང་བར་སྒུག༌སྟེ། ཁོང་གིས་མུན་པའི་ནང་གི་གསང་བའི་གནས་ཚུལ་ཐམས་ཅད་ཕྱིར་མངོན་པར་མཛད་ཅིང༌། མིའི་སེམས་ནང་གི་དམིགས་ཡུལ་ཡང་ཕྱིར་མངོན་པར་མཛད། དེའི་དུས༌སུ། མི་རེ་རེར་དཀོན་མཆོག་ནས་གཟེངས་བསྟོད་འཐོབ་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":6,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་གི་ཕྱིར་དུ། ངས་དོན་དེ་རྣམས་ང་རང་དང་ཨ་པོལ་ལོ་གཉིས་ལ་སྦྱར་བ་ཡིན༌ཏེ། ཁྱོད་རྣམས་ཀྱིས་ངེད་གཉིས་མིག་དཔེར་འཛིན་དགོས༌ཤིང༌། གསུང་རབ་ཀྱི་ནང་དུ་གསུངས་ཡོད་པ་དེ་ལས་བརྒལ་མི་རུང་། དེ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་ང་རྒྱལ་ཁེངས་དྲེགས་མི་བྱེད་པ༌དང༌། ཕྱོགས་རིས་མི་འཛིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་མི་གཞན་དང་མི་འདྲ་བར་བྱེད་མཁན་ནི་སུ་ཡིན༌ནམ། ཁྱོད་ཅག་ལ་ཡོད་པ་ཐམས་ཅད་ཐོབ་ནས་ཡོང་བ་མ་ཡིན༌ནམ། ཐོབ་ནས་ཡོང་བ་ཡིན༌ན། ཅིའི་ཕྱིར་ཐོབ་ནས་ཡོང་བ་མ་ཡིན་པ་ལྟར་རང་རློམ་བྱེད་པ་ཡིན༌ནམ།"]},{"type":"verse","number":8,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཡིད་ཚིམ་པ་དང་ཕུན་སུམ་ཚོགས་པར་གྱུར་ལ། ངེད་ཅག་ལ་མི་བརྟེན་པར་རང་ཉིད་རྒྱལ་པོ་བཞིན་སྡོད་པ་མ་ཡིན༌ནམ། ངེད་ཅག་གིས་ཁྱོད་རྣམས་ནི་དངོས་གནས་རྒྱལ་པོར་བྱེད༌ཅིང༌། ངེད་ཅག་གིས་ཀྱང་ཁྱོད་རྣམས་དང་མཉམ་དུ་རྒྱལ་པོའི་སྲིད་དབང་བཟུང་ན་ཅི་མ་རུང་སྙམ།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་གིས་སྐུ་ཚབ་པ་ངེད་རྣམས་ནི་མི་ཀུན་ལས་ཐ་མ་དང་སྲོག་ཆད་བཅད་པའི་བཙོན་པ་ལྟ་བུར་མཛད་ཅེས་བདག་གིས་བསམས་སོ།། ཅིའི་ཕྱིར་ཞེ་ན། ངེད་ཅག་ནི་འཇིག་རྟེན་གྱི་མི་རྣམས་དང་ཕོ་ཉ་དག་གི་ལྟད་མོར་གྱུར་པས་སོ།།"]},{"type":"verse","number":10,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི༌ཕྱིར། ངེད་ཅག་ནི་བླུན་པོ་ཡིན་ཡང་ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ཤེས་རབ་ལྡན༌པ་ཡིན། ངེད་ཅག་ནི་ཉམ་ཐག་ཀྱང་ཁྱོད་ཅག་ནི་སྟོབས་དང་ལྡན་པ་ཡིན། ཁྱོད་ཅག་ལ་གཟི་བརྗིད་ཐོབ་ཀྱང་ངེད་ཅག་ལ་མཐོང་ཆུང་བྱེད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":11,"content":["ད་ལྟའི་བར༌དུ། ངེད་ཅག་ནི་བཀྲེས་ཤིང་སྐོམ་ལ། གོས་ཧྲལ་ཧྲུལ་གྱོན་པ༌དང༌། གཅར་རྡུང་མྱངས་པ༌དང༌། སྡོད་སའི་ཁང་པ་མེད་པ༌དང༌།"]},{"type":"verse","number":12,"content":["དཀའ་སྡུག་ཆེན་པོའི་ངང་རང་གི་ལག་པར་བརྟེན་ནས་ལས་ཀ་བྱེད༌པ་དང་། མི་གཞན་གྱིས་སྡིགས་དམོད་བྱེད་དུས་ངེད་ཅག་གིས་བྱིན་རླབས་ཞུ་ཞིང༌། མི་གཞན་གྱིས་གཉའ་གནོན་བྱེད་དུས་ངེད་ཅག་གིས་བཟོད་བསྲན་བྱེད༌པ་ཡིན།"]},{"type":"verse","number":13,"content":["མི་གཞན་གྱིས་འཕྱ་སྨོད་བྱེད་དུས། ངེད་ཅག་གིས་སེམས་པ་བཟང་པོས་འདུམ་པར་བསྐུལ་བ་ཡིན། ད་ལྟའི་བར༌དུ། ད་དུང་མི་གཞན་དག་གིས་ངེད་ཅག་ནི་འཇིག་རྟེན་གྱི་གད་སྙིགས་དང་དངོས་པོ་ནང་གི་སྙིགས་མར་བརྩིས༌པའོ།།"]},{"type":"verse","number":14,"content":["བདག་གིས་དོན་འདི་རྣམས་ཡི་གེར་འགོད་པའི་དམིགས་ཡུལ་ནི་ཁྱོད་རྣམས་ལ་ངོ་གནོང་དུ་འཇུག་པ་མ་ཡིན༌ཏེ། ངས་སྙིང་ནས་གཅེས་པའི་བུ་ཕྲུག་ལ་བསྐུལ་བ༌བཞིན། ཁྱོད་ཅག་ལ་ཉེན་བརྡ་གཏོང་བའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":15,"content":["བདག་ནི་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཁོང་གི་འཕྲིན་བཟང་བརྒྱུད་ནས་ཁྱོད་ཅག་གི་ཕ་རུ་གྱུར་པས། ཁྱོད་རྣམས་ལ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཆོས་གཞུང་གི་ཟུར་ཁྲིད་སློབ་དཔོན་ཆིག་ཁྲི་ཙམ་ཡོད་ཀྱང་ཕ་ལ་རུང་བ་ནི་མང་པོ་མེད༌དོ།།"]},{"type":"verse","number":16,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ང་རང་མིག་དཔེར་འཛིན་པར་བདག་གིས་བསྐུལ༌བ་ཡིན།"]},{"type":"verse","number":17,"content":["དེའི་རྐྱེན༌གྱིས། ངས་ཐི་མོ་ཐེ་ཁྱོད་ཅག་གི་གམ་དུ་མངགས༌ཤིང༌། ཁོ་རང་ནི་གཙོ་བོའི་ནང་དུ་བདག་གིས་སྙིང་ནས་གཅེས་ཤིང་བློ་སེམས་དཀར་བའི་བུ་ཕྲུག་ཅིག་ཀྱང་ཡིན། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ཅི་ལྟར་སྤྱད་པ་སྤྱོད་པ༌དང༌། ཡུལ་ཀུན་དང་ཆོས་ཚོགས་སོ་སོ་ནས་ཅི་ལྟར་སློབ་སྟོན་བྱས་པའི་ཚུལ༌ནི། ཁོས་ཁྱོད་རྣམས་ལ་དྲན་སྐུལ་བྱེད་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ལས་འགའ་ཞིག་གིས་རང་རློམ་བྱེད༌ཅིང༌། བདག་ནི་ཁྱོད་ཅག་གི་གམ་དུ་མི་ཡོང་བར་བསམས༌མོད།"]},{"type":"verse","number":19,"content":["འོན་ཀྱང་གཙོ་བོའི་ཐུགས་དགོངས་བཞིན་ཡིན༌ན། ང་རང་མྱུར་བ་མྱུར་དུ་ཁྱོད་ཅག་གི་གམ་དུ་ཡོང་ངེས་པར་མ༌ཟད། བདག་གིས་ཤེས་འདོད་པ་ནི་རང་རློམ་བྱེད་མཁན་རྣམས་ཀྱི་ངག་ཚིག་མ་ཡིན་པར། ཁོ་རྣམས་ཀྱི་དབང་ཤུགས་ནི་ཅི་ལྟ་བུ་ཡིན་པ་དེའོ།།"]},{"type":"verse","number":20,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ནི་སྨྲ་བརྗོད་ལ་རག་ལས་པ་མ་ཡིན་པར་མཐུ་སྟོབས་ལ་རག་ལས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཅག་གིས་ཅི་ཞིག་བྱེད་འདོད༌དམ། བདག་གིས་དབྱུག་པ་བཟུང་ནས་ཁྱོད་ཅག་གི་གམ་དུ་ཡོང་འདོད༌དམ། ཡང་ན་བྱམས་བརྩེ་དང་ཞི་འཇམ་གྱི་བསམ་པ་བཅངས་ནས་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་ཡོང་འདོད༌པ་ཡིན།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}