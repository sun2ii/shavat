{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":6,"content":[{"type":"heading","content":["དད་ལྡན་ཕན་ཚུན་ཁྲིམས་རར་གཏུག་མི་རུང་བའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཁྱོད་ཅག་གི་ཁྲོད་དུ་ཕན་ཚུན་བར་ལ་རྩོད་གཞི་བྱུང་ན་དད་ལྡན་དམ་པ་རྣམས་ལ་མི་ཞུ༌བར། དྲང་བདེན་མིན་པའི་མི་རྣམས་ཀྱི་མདུན་ནས་ཁྲིམས་རར་གཏུག་ནུས༌སམ།"]},{"type":"verse","number":2,"content":["མ་འོངས་པའི་དུས༌སུ། དད་ལྡན་དམ་པ་རྣམས་ཀྱིས་འཇིག་རྟེན་ལ་ཁྲིམས་ཐག་གཅོད་པར་འགྱུར་བ་ཁྱོད་ཅག་གིས་མི་ཤེས༌སམ། ཁྱོད་ཅག་གིས་འཇིག་རྟེན་ལ་ཁྲིམས་ཐག་གཅོད་པར་བྱེད༌ན། ཁྱོད་ཅག་གིས་ཀྱང་རྩོད་གཞི་ཆུང་ངུ་ཞིག་ཐག་གཅོད་བྱེད་མི་ཐུབ་བམ།"]},{"type":"verse","number":3,"content":["མ་འོངས་པའི་དུས༌སུ། བདག་ཅག་གིས་ཕོ་ཉ་དག་ལ་ཁྲིམས་ཐག་གཅོད་པར་འགྱུར་བ་དེ་ཁྱོད་ཅག་གིས་མི་ཤེས༌སམ། དེ་ལྟར་ཡིན༌ན། ད་ལྟའི་དོན་རྣམས་སྨོས་ཅི༌དགོས།"]},{"type":"verse","number":4,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་གིས་ད་ལྟའི་དོན་རྣམས་ལ་ཁྲིམས་ཐག་གཅོད༌ན། ཆོས་ཚོགས་ཀྱིས་མཐོང་ཆུང་བྱེད་པའི་མི་ཞིག་བདམས་ནས་ཁྲིམས་ཐག་གཅོད་པར་མངག༌གམ།"]},{"type":"verse","number":5,"content":["བདག་གིས་འདི་སྐད་སྨྲས་པ༌ནི། ཁྱོད་རྣམས་ལ་ངོ་གནོང་དུ་འཇུག་པའི་ཕྱིར་ཡིན༌ཏེ། ཁྱོད་ཅག་གི་ཁྲོད་དུ་སྤུན་ཟླའི་བར་གྱི་རྩོད་གཞི་རྣམས་ཐག་གིས་གཅོད་ནུས་པའི་ཤེས་རབ་ཅན་གཅིག་ཀྱང་མེད༌དམ།"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱིས་སྤུན་ཟླ་དང་སྤུན་ཟླའི་བར་དུ་གཏུག་རེས་བྱེད་པར་མ༌ཟད། དད་མེད་རྣམས་ཀྱི་མདུན་ནས་གཏུག་པར་བྱེད༌དོ།།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་ཕན་ཚུན་གཏུག་རེས་བྱེད་པ་ནི་རྩ་བ་ནས་ནོར་བ་ཡིན། ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་བརྙས་བཅོས་དང་གྱོང་གུད་འཁུར་མི་རུང་ངམ།"]},{"type":"verse","number":8,"content":["དེ་ལས་ལྡོག་སྟེ། ཁྱོད་ཅག་གིས་མི་གཞན་ལ་བརྙས་བཅོས་བྱེད་པ་དང་གྱོང་གུད་བཟོ་བར་མ་ཟད། དེ་ལྟར་བྱེད་ཡུལ་ནི་རང་གི་སྤུན་ཟླ་རྣམས་ཡིན༌ནོ།།"]},{"type":"verse","number":9,"content":["དྲང་བདེན་མིན་པའི་མི་རྣམས་ལ་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་འཐོབ་མི་སྲིད་པ་ནི་ཁྱོད་ཅག་གིས་མི་ཤེས༌སམ། རང་གིས་རང་ལ་མགོ་སྐོར་མི་གཏོང་བར༌གྱིས། མི་ཚངས་སྤྱོད་པ༌དང༌། སྐུ་འདྲར་བརྟེན་པ། ལོག་གཡེམ་བྱེད༌པ། སྐྱེས་པ་སྨད་འཚོང་མཁན།",{"noteId":0},"ཕོ་ཡིས་ཕོ་ལ་འཁྲིག་པ་སྤྱོད་པ།"]},{"type":"verse","number":10,"content":["རྐུ་བྱེད༌པ། འདོད་རྔམ་བཅངས༌པ། ཆང་གིས་ར་རོར་གྱུར༌པ། ཚིག་ངན་སྨྲ༌བ། མགོ་སྐོར་གཏོང་མཁན་རྣམས་ལ་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་འཐོབ་པར་མི་འགྱུར་རོ།།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཅག་གི་ཁྲོད་དུའང་མི་ཁ་ཤས་ནི་སྔོན་ཆད་དེ་ལྟ་བུ་ཡིན༌མོད། འོན་ཀྱང་ད་ལྟ་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་མཚན་ལ་བརྟེན་པ༌དང༌། བདག་ཅག་གི་དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན༌ནས། ཁྱོད་ཅག་ནི་གཙང་མར་བཀྲུས་པ༌དང༌། དམ་པར་གྱུར༌པ། མི་རྣམ་དག་ཏུ་གྱུར༌པའོ།།"]},{"type":"heading","content":["ལོག་གཡེམ་གྱི་སྐོར་བཤད༌པ།"]},{"type":"verse","number":12,"content":["ངས་ལས་ཅི་ཡང་བྱ་རུང་བ་ཡིན་ཟེར་ཡང་། ལས་ཐམས་ཅད་ལ་ཕན་ཐོགས་ཡོད་པ་མ་ཡིན། ངས་ལས་ཅི་ཡང་བྱ་རུང་བ་ཡིན་ཟེར་ཡང་། ལས་གང་ཞིག་ཡིན་ཡང་བདག་ནི་དེའི་དབང་དུ་མི༌འགྲོའོ།།"]},{"type":"verse","number":13,"content":["ཟས་ནི་ལྟོ་བའི་ཕྱིར་དང་ལྟོ་བ་ནི་ཟས་ཀྱི་ཕྱིར་ཡིན་ཟེར༌ནའང་། དཀོན་མཆོག་གིས་དེ་གཉིས་མེད་པར་མཛད་ངེས་སོ།། འོན༌ཀྱང༌། ལུས་པོ་ནི་ལོག་གཡེམ་བྱེད་པའི་ཕྱིར་མ་ཡིན་པར་གཙོ་བོའི་ཕྱིར་ཡིན༌ལ། གཙོ་བོ་ཁོང་ཉིད་ཀྱང་ལུས་པོའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":14,"content":["དེར་མ༌ཟད། དཀོན་མཆོག་གིས་གཙོ་བོ་སླར་གསོན་པར་མཛད་པ༌དང༌། བདག་ཅག་ཀྱང་ཁོང་གི་མཐུ་སྟོབས་ཀྱིས་སླར་གསོན་པར་མཛད་ངེས༌ཡིན།"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ལུས་པོ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཡན་ལག་ཡིན་པ་མི་ཤེས༌སམ། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཡན་ལག་དེ་ནི་སྨད་འཚོང་མའི་ཡན་ལག་ཏུ་བྱེད་རུང་ངམ་ཞེ༌ན། གཏན་ནས་མི་རུང༌ངོ་།།"]},{"type":"verse","number":16,"content":["དེ་ཡང་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁོ་གཉིས་ཀྱི་ལུས་པོ་གཅིག་ཏུ་འགྱུར་བ་ཡིན་ཞེས་གསུངས་ཡོད༌པས། མི་ཞིག་སྨད་འཚོང་མ་དང་འགྲོགས༌ན། དེ་གཉིས་ཀྱི་ལུས་པོ་གཅིག་ཏུ་འགྱུར་བའང་ཁྱོད་ཅག་གིས་མི་ཤེས༌སམ།"]},{"type":"verse","number":17,"content":["འོན༌ཀྱང༌། མི་ཞིག་གིས་གཙོ་བོ་ལ་འབྲེལ་བ་བཙུགས༌ན། མི་དེ་ནི་ཁོང་གི་ཐུགས་ཉིད་དང་གཅིག་ཏུ་གྱུར༌པའོ།།"]},{"type":"verse","number":18,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་ལོག་གཡེམ་རྩ་བ་ནས་སྤོངས༌ཤིག མི་རྣམས་ཀྱིས་ནག་ཉེས་གང་ཞིག་བྱེད་ཀྱང་དེ་དག་ཐམས་ཅད་ནི་ལུས་པོའི་ཕྱི་རོལ་ཡིན༌མོད། འོན་ཀྱང་ལོག་གཡེམ་བྱས་ན་རང་གི་ལུས་པོར་འགལ་བའི་སྡིག་པ་བྱེད༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་གི་ལུས་པོ་ནི་དམ་པའི་ཐུགས་ཉིད་ཀྱི་མཆོད་ཁང་ཡིན་པ་མི་ཤེས༌སམ། དམ་པའི་ཐུགས་ཉིད་ནི་དཀོན་མཆོག་གིས་གནང་ཞིང་ཁྱོད་ཅག་གི་སེམས་ནང་དུ་བཞུགས་པ་ཡིན། ཁྱོད་ཅག་ནི་རང་ཉིད་ལ་དབང་བ་མ་ཡིན༌ཏེ།"]},{"type":"verse","number":20,"content":["རིན་ཆེན་པོ་བཏང་ནས་ཉོས་པ་ཡིན༌པས། ཁྱོད་ཅག་གི་ལུས་སྟེང་ནས་དཀོན་མཆོག་ལ་བཀུར་སྟི་བྱེད་པར་གྱིས་ཤིག།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"སྐྱེས་པ་སྨད་འཚོང་མཁན་ཞེས་པར་མ་ཕྱི་ལས་སྒེག་ཉམས་ལྡན་པ་ཞེས་བཀོད་ཡོད་ཅིང་། ཧ་ལམ་ལྷ་ཁང་ནང་གི་སྐྱེས་པ་སྨད་འཚོང་མཁན་ལ་གོ་དགོས།","reference":{"chapter":6,"verse":9}}]},"thisChapterLink":"/api/bod_ntb/1CO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/5.json","previousChapterAudioLinks":{},"numberOfVerses":20}