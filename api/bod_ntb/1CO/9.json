{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་དང་པོ།","commonName":"ཀོ་རིན་ཐུ་པ་དང་པོ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":46,"numberOfChapters":16,"sha256":"095f716f44668e220a839d0f61e0eb89c36521068ed5533f272f03c76f52f4ec","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":9,"content":[{"type":"heading","content":["སྐུ་ཚབ་པའི་དབང་ཆ་དང་ལས་འགན༌གྱི་སྐོར།"]},{"type":"verse","number":1,"content":["བདག་ལ་རང་དབང་ཡོད་པ་མིན༌ནམ། བདག་ནི་སྐུ་ཚབ་པ་མ་ཡིན༌ནམ། བདག་ནི་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུར་མཇལ་མྱོང་བ་མིན༌ནམ། ཁྱོད་ཅག་ནི་གཙོ་བོའི་ནང་དུ་ང་ཡི་ལེགས་པར་བཅོས་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":2,"content":["མི་གཞན་ལ་མཚོན་ན་བདག་ནི་སྐུ་ཚབ་པ་མིན༌ནའང༌། ཁྱོད་ཅག་ལ་མཚོན་ན་བདག་ནི་སྐུ་ཚབ་པ་ཡིན་ཏེ། ཁྱོད་ཅག་ནི་གཙོ་བོའི་ནང་དུ་ང་རང་སྐུ་ཚབ་པ་ཡིན་པའི་དཔང་རྟགས་ཡིན༌ནོ།།"]},{"type":"verse","number":3,"content":["ངས་རང་ལ་འདྲི་རྩད་བྱེད་པའི་མི་རྣམས་ལ་འདི་ལྟར་དག་འབུད་བྱེད་པ༌སྟེ།"]},{"type":"verse","number":4,"content":["ངེད་ཅག་ལ་བཟའ་བཏུང་སྤྱོད་པའི་དབང་ཆ་ཡོད་པ་མིན༌ནམ།"]},{"type":"verse","number":5,"content":["ངེད་ཅག་ལ་སྐུ་ཚབ་པ་གཞན་དག་དང་གཙོ་བོའི་སྤུན་ཟླ་རྣམས། ཀེ་ཕཱ་བཅས་དང་འདྲ་བར་དད་ལྡན་ཆུང་མ་ཁྲིད་ནས་མཉམ་དུ་འགྲོ་བའི་དབང་ཆ་ཡོད་པ་མིན༌ནམ།"]},{"type":"verse","number":6,"content":["བདག་དང་པཱར་ན་པཱ་ཁོ་ནར་ངལ་རྩོལ་མི་བྱེད་པའི་དབང་ཆ་མེད་པ་ཡིན༌ནམ།"]},{"type":"verse","number":7,"content":["སུ་ཞིག་དམག་ལ་ཞུགས་ཤིང་འགྲོ་སོང་རང་གིས་གཏོང༌ངམ། སུ་ཞིག་གིས་རྒུན་ཚལ་བཙུགས་ཀྱང་འབྲས་བུ་མི༌ཟའམ། སུ་ཞིག་གིས་ཕྱུགས་ཁྱུ་འཚོས་ཀྱང་དེའི་འོ་མ་མི་འཐུང༌ངམ།"]},{"type":"verse","number":8,"content":["བདག་གིས་དེ་ལྟར་སྨྲས་པ་ནི་མིའི་བསམ་ཚུལ་བཞིན་སྨྲས་པ་ཡིན༌ནམ། བཀའ་ཁྲིམས་ལས་ཀྱང་དེ་ལྟར་གསུངས་པ་མིན༌ནམ།"]},{"type":"verse","number":9,"content":["མོ་ཤེའི་བཀའ་ཁྲིམས་ལས་ཇི་སྐད༌དུ།",{"text":"གཡུལ་ཁ་གཅོག་པའི་དུས༌སུ། །","poem":1},{"lineBreak":true},{"text":"བ་གླང་མཆུ་ཏོ་མ༌སྡོམ། །","poem":1},"ཞེས་བཀོད་པའི་དཔེ་དེ༌ལས། དཀོན་མཆོག་གིས་བ་གླང་ལ་ཐུགས་ཁུར་མཛད་པ་ཡིན༌ནམ།"]},{"type":"verse","number":10,"content":["དེ་ཐམས་ཅད་ནི་བདག་ཅག་གི་དོན་དུ་གསུངས་པ་མ་ཡིན་ནམ་ཞེ་ན་ཡིན་ཏེ། ཞིང་རྨོ་མཁན་དང་གཡུལ་གཅོག་མཁན་གྱིས་ལོ་ཏོག་གི་སྐལ་འཐོབ་པར་རེ་བ་བཅངས་ནས་ཞིང་རྨོ་བ་དང་གཡུལ་གཅོག་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["དེ་བཞིན་དུ་ངེད་ཅག་གིས་ཐུགས་ཉིད་དང་ལྡན་པའི་ས་བོན་དེ་ཁྱོད་ཅག་གི་སེམས་སུ་བཏབ༌ཅིང༌། ཁྱོད་ཅག་ལས་འཇིག་རྟེན་གྱི་རྒྱུ་ནོར་བསྡུས་པ་དེ་ནི་དོན་ཆེན་ཞིག་མ་ཡིན།"]},{"type":"verse","number":12,"content":["མི་གཞན་ལ་ཁྱོད་རྣམས་ལས་འཇིག་རྟེན་གྱི་རྒྱུ་ནོར་འཐོབ་པའི་དབང་ཆ་ཡོད༌ན། ངེད་ཅག་ལ་དབང་ཆ་དེ་ལྟ་བུ་ནི་ལྷག་པར་ཡོད། འོན༌ཀྱང༌། ངེད་ཅག་གིས་དབང་ཆ་དེ་ནི་བཀོལ་མ་མྱོང༌སྟེ། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་འཕྲིན་བཟང་སྒྲོག་པར་བར་ཆད་མི་བཟོ་བའི༌ཕྱིར། ངེད་ཅག་གིས་དོན་ཀུན་ལའང་བཟོད་བསྲན་བྱས་སོ༎"]},{"type":"verse","number":13,"content":["དེ་ཡང་མཆོད་ཁང་གི་གཉེར་པས་མཆོད་རྫས་ཟས་སུ་བྱེད་པ༌དང༌། མཆོད་རྫས་འབུལ་མཁན་ལ་མཆོད་ཁྲི་ནས་བགོ་སྐལ་འཐོབ་པ་ནི་ཁྱོད་རྣམས་ཀྱིས་མི་ཤེས༌སམ།"]},{"type":"verse","number":14,"content":["དེ་བཞིན་དུ་གཙོ་བོས་ཀྱང་འཕྲིན་བཟང་སྒྲོག་མཁན་རྣམས་ནི་འཕྲིན་བཟང་སྒྲོག་པའི་ལས་ལ་བརྟེན་ནས་འཚོ་དགོས་པའི་བཀའ་གནང༌ངོ༌།།"]},{"type":"verse","number":15,"content":["འོན༌ཀྱང༌། བདག་གིས་དབང་ཆ་དེ་དག་བཀོལ་མ་མྱོང༌། ཁྱོད་རྣམས་ཀྱིས་བདག་ལ་དེ་ལྟར་བྱེད་པའི༌ཕྱིར། ངས་དོན་དེ་རྣམས་བྲིས་པ་མིན༌ཏེ། བདག་གིས་བསྔགས་པའི་དོན་དེ་མི་གཞན་གྱིས་སྟོང་བར་བྱེད་པ༌ལས། ང་རང་འཆི་བར་གྱུར་ན་ལེགས་པས༌སོ།།"]},{"type":"verse","number":16,"content":["འོན༌ཀྱང༌། བདག་གིས་འཕྲིན་བཟང་སྒྲོག་ན་ང་ལ་ངོམ་པའི་རྒྱུ་མེད༌དེ། བདག་ནི་དེ་ལྟར་མི་བྱེད་ཐབས་མེད་ཡིན། བདག་གིས་འཕྲིན་བཟང་མ་བསྒྲགས་ན་བདག་ལ་ཆག་སྒོ་འབྱུང་ངེས༌ཡིན།"]},{"type":"verse","number":17,"content":["ང་རང་འཕྲིན་བཟང་སྒྲོག་པར་འཐད་པ་བྱུང༌ན་བདག་ལ་བྱ་དགའ་འཐོབ་སྲིད༌ཅིང༌། ང་རང་དོན་དེར་འཐད་པ་མ་བྱུང༌ཡང་ལས་འགན་བདག་ལ་བཅོལ༌ཟིན་པ་ཡིན།"]},{"type":"verse","number":18,"content":["དེའི༌ཕྱིར། བདག་གི་བྱ་དགའ་ནི་ཅི་ཡིན་ཞེ༌ན། ངས་འཕྲིན་བཟང་སྒྲོག་པའི་དུས༌སུ། འཕྲིན་བཟང་སྒྲོག་པའི་དབང་ཆ་དེ་ཉིད་མི་ཟད་པའི༌ཕྱིར། རིན་མེད་པར་མི་རྣམས་ལ་འཕྲིན་བཟང་འཐོབ་པར་བྱེད་པ༌དེའོ།།"]},{"type":"verse","number":19,"content":["བདག་ལ་རང་དབང་ཡོད་ཅིང་མི་གཞན་གྱི་མངའ་འོག་ཏུ་མེད༌མོད། འོན་ཀྱང་མི་མང་པོའི་སེམས་འགུག་པའི༌ཕྱིར། བདག་ནི་དགའ་བའི་ངང་མི་རྣམས་ཀྱི་གཡོག་པོར་གྱུར་པ༌དང་།"]},{"type":"verse","number":20,"content":["ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་སེམས་འགུག་པའི༌ཕྱིར། བདག་གིས་ཡ་ཧུ་དཱ་པ་དང་འདྲ་བར་བྱས༌ཤིང་། བཀའ་ཁྲིམས་ཀྱི་འོག་ཏུ་ཡོད་པ་རྣམས་ཀྱི་སེམས་འགུག་པའི༌ཕྱིར། བདག་ནི་བཀའ་ཁྲིམས་འོག་ཏུ་མེད་ཀྱང་བཀའ་ཁྲིམས་འོག་ཏུ་ཡོད་པ་ལྟར་བྱས༌པ་དང་།"]},{"type":"verse","number":21,"content":["བཀའ་ཁྲིམས་མེད་པ་རྣམས་ཀྱི་སེམས་འགུག་པའི༌ཕྱིར། བདག་གིས་བཀའ་ཁྲིམས་མེད་པའི་མི་ལྟར་བྱས༌པ་ཡིན། དོན་དམ་དུ་བདག་ནི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་མེད་པ་མིན༌ཏེ། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བཀའ་ཁྲིམས་འོག་ཏུ་གནས༌པ་ཡིན།"]},{"type":"verse","number":22,"content":["ཉམ་ཆུང་རྣམས་ཀྱི་སེམས་འགུག་པའི༌ཕྱིར། བདག་གིས་ཉམ་ཆུང་ལྟར་བྱས་སོ།། ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་མི་ཁ་ཤས་སྐྱོབ་པའི༌ཕྱིར། བདག་གིས་མི་གང་དང་ཅི་ལྟ་བུ་ཡིན་པ་དེ་བཞིན་དུ་བྱས༌པ་ཡིན།"]},{"type":"verse","number":23,"content":["བདག་གིས་ལས་བྱེད་པ་ཐམས་ཅད་ནི་འཕྲིན་བཟང་གི་རྐྱེན༌དང༌། མི་གཞན་རྣམས་དང་མཉམ་དུ་འཕྲིན་བཟང་གི་དགེ་མཚན་འཐོབ་པའི་ཕྱིར་ཡིན༌ནོ།།"]},{"type":"verse","number":24,"content":["དེ་ཡང་རྒྱུགས་ར་ནས་འགྲན་རྒྱུག་བྱེད་མཁན་ཐམས་ཅད་བརྒྱུགས༌ནའང༌། བྱ་དགའ་འཐོབ་མཁན་ནི་གཅིག་ཁོ་ན་ཡིན་པ་ཁྱོད་ཅག་གིས་མི་ཤེས༌སམ། ཁྱོད་རྣམས་ཀྱང་བྱ་དགའ་འཐོབ་པའི་ཕྱིར་དེ་ལྟར་རྒྱུགས༌ཤིག"]},{"type":"verse","number":25,"content":["འགྲན་སྡུར་ལ་ཞུགས་མཁན་ཐམས་ཅད་ཀྱིས་རྒྱལ་ཁ་ལེན་པའི༌ཕྱིར། བྱ་བ་ཀུན་ལ་རང་ཚོད་ཟིན་པར་བྱེད༌ཅིང༌། དེ་རྣམས་ཀྱིས་འཇིག་པར་འགྱུར་བའི་ཅོད་པན་འཐོབ་པའི་ཕྱིར་དེ་ལྟར་བྱེད༌མོད། འོན་ཀྱང་བདག་ཅག་གིས་འཇིག་པ་མེད་པའི་ཅོད་པན་འཐོབ་ཕྱིར་དེ་ལྟར་བྱེད༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":26,"content":["དེའི༌ཕྱིར། ང་རང་རྒྱུགས་པ་ལ་དམིགས་འབེན་མེད་པ་མིན༌ཞིང༌། ཁུ་ཚུར་གྱིས་རྒྱག་པའང་བར་སྣང་ལ་རྒྱག་པ་ལྟར་མིན༌ཏེ།"]},{"type":"verse","number":27,"content":["བདག་གི་ལུས་པོ་རང་ལ་བསྟུན་པའི༌ཕྱིར། རང་གིས་རང་ཉིད་འདུལ་བར་བྱེད། དེ་ནི་བདག་གིས་མི་གཞན་རྣམས་ལ་འཕྲིན་བཟང་བསྒྲགས་རྗེས་རང་ཉིད་མི་འདོར་བའི་ཕྱིར་ལགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1CO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1CO/8.json","previousChapterAudioLinks":{},"numberOfVerses":27}