{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1JN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན་དང་པོ།","commonName":"ཡོ་ཧ་ནན་དང་པོ།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་ཡིག་དང་པོ།","order":62,"numberOfChapters":5,"sha256":"666ff51e932aeb08c1b09ee682d8649117bb07f434cc0b668950ae7a1b5c2f6e","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་བུ་ཕྲུག་སྐོར།"]},{"type":"verse","number":1,"content":["ལྟོས་དང་། ཡབ་ཀྱིས་བདག་ཅག་ལ་གནང་བའི་ཐུགས་བརྩེ་ནི་ཅི་འདྲ་ཆེ་ཨང༌། བདག་ཅག་ནི་དཀོན་མཆོག་གི་བུ་དང་བུ་མོར་འབོད༌ཅིང༌། བདག་ཅག་ནི་དངོས་གནས་ཁོང་གི་བུ་ཕྲུག་ཡིན་ནོ།། འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་བདག་ཅག་ངོ་མི་ཤེས་པའི་རྒྱུ་མཚན་ནི། ཁོ་རྣམས་ཀྱིས་ཁོང་ཉིད་ངོ་མ་ཤེས་པའི་རྐྱེན་ཡིན།"]},{"type":"verse","number":2,"content":["སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ་རྣམས། ད་ལྟ་བདག་ཅག་ནི་དཀོན་མཆོག་གི་བུ་ཕྲུག་ཡིན༌ལ། མ་འོངས་པར་ཅི་འདྲ་ཡིན་པ་ད་དུང་གསལ་པོར་མ་མངོན་མོད། འོན་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་མངོན་སུམ་དུ་ཕེབས་པའི་དུས༌སུ། བདག་ཅག་གིས་ཁོང་ཉིད་ཇི་ལྟར་ཡིན་པ་དེ་ལྟར་མཐོང་བར་འགྱུར་བས། བདག་ཅག་ནི་ཁོང་དང་མཚུངས་པར་འགྱུར་བ་བདག་ཅག་གིས་ཤེས་སོ།།"]},{"type":"verse","number":3,"content":["ཁོང་ལ་དེ་ལྟ་བུའི་རེ་སྨོན་བཅང་མཁན་ཐམས་ཅད་ཀྱིས་ཁོང་ཉིད་གཙང་མ་ཡིན་པ་བཞིན་རང་ཉིད་ཀྱང་གཙང་མར་བྱེད་པའོ།།"]},{"type":"verse","number":4,"content":["སྡིག་པ་བྱས་དང་བྱེད་བཞིན་ཡོད་ན། དེ་ནི་བཀའ་ཁྲིམས་དང་འགལ་བ་ཡིན༌ལ། བཀའ་ཁྲིམས་དང་འགལ་བ་ཡིན་ན། དེ་ནི་སྡིག་པ་ཡིན་ནོ།།"]},{"type":"verse","number":5,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མངོན་མྱོང་ཞིང་། དེ་ནི་མིའི་སྡིག་པ་བསལ་ཆེད་ཡིན་པ་ཁྱོད་ཅག་གིས་ཤེས་པ་ཡིན། སྐྱབས་མགོན་ཡེ་ཤུར་སྡིག་པ་ཅི་ཡང་མེད།"]},{"type":"verse","number":6,"content":["སུ་ཞིག་ཁོང་གི་ནང་དུ་གནས་པ་ཡིན་ན། དེ་ཡིས་རྟག་ཏུ་སྡིག་པ་མི་བྱེད༌ལ། སུ་ཞིག་གིས་རྟག་ཏུ་སྡིག་པ་བྱེད་པ་ཡིན་ན། དེ་ཡིས་ཁོང་ཉིད་མཐོང་མ་མྱོང་ཞིང་ངོ་ཡང་མི་ཤེས༌སོ།།"]},{"type":"verse","number":7,"content":["བུ་ཕྲུག༌རྣམས། མིའི་སླུ་བྲིད་ཀྱི་འོག་ཏུ་འཚུད༌པར་མི་བྱའོ།། དྲང་བདེན་གྱིས་ལས་བསྒྲུབས་ཤིང་སྒྲུབ་བཞིན་པ་ནི་དྲང་བདེན་ཅན་ཡིན་ཏེ། སྐྱབས་མགོན་ཡེ་ཤུ་དྲང་བདེན་ཡིན་པ་བཞིན་ནོ།།"]},{"type":"verse","number":8,"content":["སྡིག་པ་བྱས་ཤིང་བྱེད་བཞིན་པ་ནི་བདུད་ཀྱི་ཁོངས་སུ་གཏོགས། ཅིའི་ཕྱིར་ཞེ་ན། བདུད་ཀྱིས་ཐོག་མ་ནས་སྡིག་པ་བྱས་ཤིང་བྱེད་བཞིན་པས་སོ། །དཀོན་མཆོག་གི་སྲས་མངོན་པར་གྱུར་པ་ནི། བདུད་ཀྱི་ལས་རྣམས་འཇོམས་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":9,"content":["སུ་ཞིག་དཀོན་མཆོག་ནས་སྐྱེས་པ་ཡིན་ན། དེ་ཡིས་རྟག་ཏུ་སྡིག་པ་མི་བྱེད། ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་ས་བོན་ནི་མི་དེའི་སེམས་སུ་བཞུགས་པས་སོ།། མི་དེ་ནི་དཀོན་མཆོག་ནས་སྐྱེས་པའི་རྐྱེན་གྱིས། དེ་ཡིས་རྟག་ཏུ་སྡིག་པ་བྱེད་མི་སྲིད།"]},{"type":"verse","number":10,"content":["དེ་ལས་སུ་ཞིག་ནི་དཀོན་མཆོག་གི་བུ་ཕྲུག་ཡིན་པ་དང་། གང་ཞིག་ནི་བདུད་ཀྱི་བུ་ཕྲུག་ཡིན་པ་གསལ་པོར་མངོན་ཏེ། དྲང་བདེན་གྱི་ལས་མི་བྱེད་པ་ནི་དཀོན་མཆོག་ལ་མི་གཏོགས་ཤིང་། རང་གི་སྤུན་ཟླར་མི་གཅེས་པའང་དེ་བཞིན་ཡིན་ནོ།།"]},{"type":"heading","content":["ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་པའི༌སྐོར།"]},{"type":"verse","number":11,"content":["བདག་ཅག་གིས་ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་དགོས་སོ།། དེ་ནི་ཁྱོད་ཅག་གིས་ཐོག་མ་ནས་ཐོས་པའི་འཕྲིན་ཡིན།"]},{"type":"verse","number":12,"content":["ཀཱ་ཡན་བཞིན་དུ་བྱ་མི་རུང་སྟེ། ཁོ་ནི་བདུད་ངན་དེ་ལ་གཏོགས་པས་རང་གི་གཅུང་པོ་བསད། གཅུང་པོ་བསད་པའི་རྒྱུ་མཚན་ཅི་ཞེ་ན། ཁོའི་སྤྱོད་ལམ་ངན་ཞིང་གཅུང་པོའི་སྤྱོད་ལམ་དྲང་བའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":13,"content":["སྤུན་ཟླ༌རྣམས། འཇིག་རྟེན་གྱི་མི་རྣམས་ཁྱོད་ཅག་ལ་སྡང་བ་ཡིན་ན། དེ་ནི་ཡ་མཚན་དུ་འདོད་པར་མི་བྱའོ།།"]},{"type":"verse","number":14,"content":["བདག་ཅག་གིས་སྤུན་ཟླ་གཅེས་སུ་བཟུང་བའི་ཕྱིར། འཆི་བ་ནས་གསོན་པའི་ནང་དུ་ཞུགས་པ་ཤེས་ཤིང་། གཅེས་སེམས་མེད་ན་སྔར་བཞིན་འཆི་བའི་ནང་དུ་གནས་པ་ཡིན།"]},{"type":"verse","number":15,"content":["རང་གི་སྤུན་ཟླར་སྡང་མཁན་ཐམས་ཅད་ནི་ལག་དམར༌ཡིན། ལག་དམར་རྣམས་ཀྱི་སེམས་ནང་དུ་མཐའ་མེད་པའི་ཚེ་སྲོག་མེད་པ་ཁྱོད་ཅག་གིས་ཤེས༌པའོ།།"]},{"type":"verse","number":16,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་བདག་ཅག་གི་ཆེད་དུ་རང་སྲོག་བློས་བཏང་བའི་དོན་དེ་ལས། བདག་ཅག་གིས་བྱམས་པ་ནི་ཅི་ཡིན་པ་ཤེས་པས། བདག་ཅག་གིས་ཀྱང་སྤུན་ཟླའི་ཆེད་དུ་རང་སྲོག་བློས་གཏོང་འོས་སོ།།"]},{"type":"verse","number":17,"content":["སུ་ཞིག་ལ་འཇིག་རྟེན་གྱི་རྒྱུ་ནོར་ཡོད་ཅིང་སྤུན་ཟླའི་དགོས་མཁོ་མཐོང་ཡང་སྙིང་རྗེ་མི་སྐྱེས༌ན། དཀོན་མཆོག་གི་བྱམས་པ་ནི་ཁོའི་སེམས་ནང་དུ་ཅི་ལྟར་གནས༌སམ།"]},{"type":"verse","number":18,"content":["བུ་ཕྲུག༌རྣམས། བདག་ཅག་གིས་ཕན་ཚུན་གཅེས་སུ་འཛིན་པ་ནི་ངག་ནས་སྨྲ་བ་ཙམ་མ་ཡིན་པར་བྱ་སྤྱོད་དང་གཞུང་དྲང་གི་ཐད་ནས་མཚོན༌དགོས་ལ།"]},{"type":"verse","number":19,"content":["དོན་དེ་ལས་བདག་ཅག་ནི་བདེན་པ་ཉིད་ལ་གཏོགས་པ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞིང་། བདག་ཅག་གི་སེམས་ནི་དཀོན་མཆོག་གི་སྤྱན་དྲུང་དུ་བདེ་བར་གནས་ཐུབ་ངེས།"]},{"type":"verse","number":20,"content":["གལ་ཏེ། བདག་ཅག་གི་སེམས་ཀྱིས་བདག་ཅག་ལ་གཤེ་གཤེ་གཏོང་བ་ཡིན་ན། དཀོན་མཆོག་ནི་བདག་ཅག་གི་སེམས་ལས་ཀྱང་ཆེན་པོ་ཡིན་ལ། མི་མཁྱེན༌པའི་དོན་ཅི་ཡང་མེད་དོ།།"]},{"type":"verse","number":21,"content":["སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ༌རྣམས། གལ་ཏེ། བདག་ཅག་གི་སེམས་ཀྱིས་བདག་ཅག་ལ་གཤེ་གཤེ་མི་གཏོང༌ན། བདག་ཅག་དཀོན་མཆོག་གི་དྲུང་དུ་བག་ཕེབས་ཞུམ་མེད་ངང་གནས་ཐུབ་པར་མ་ཟད།"]},{"type":"verse","number":22,"content":["བདག་ཅག་གིས་ཁོང་གི་བཀའ་རྣམས་སྲུང་ཞིང་ཁོང་གི་སྤྱན་སྔར་ཐུགས་དགྱེས་པའི་དོན་རྣམས་སྒྲུབ་པ་ཡིན་པས། བདག་ཅག་གིས་གང་ཞིག་ཞུས་པ་ཁོང་ནས་འཐོབ་པར༌འགྱུར་རོ།།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་གི་བཀའ་ནི་བདག་ཅག་གིས་ཁོང་གི་སྲས་ཡེ་ཤུ་མཱ་ཤི་ཀའི་མཚན་ལ་དད་པ་བྱེད་པ༌དང༌། ཁོང་གིས་བདག་ཅག་ལ་གནང་བའི་བཀའ་བཞིན་དུ་ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་པར་བྱེད་པ་དེ་ཡིན།"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་གི་བཀའ་རྣམས་བརྩི་སྲུང་བྱེད་མཁན་ནི་དཀོན་མཆོག་གི་ནང་དུ་གནས་ཤིང༌། དཀོན་མཆོག་ཀྱང་མི་དེའི་ནང་དུ་བཞུགས་པ་ཡིན། བདག་ཅག་ལ་གནང་བའི་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན་ནས། བདག་ཅག་གིས་དཀོན་མཆོག་ནི་བདག་ཅག་གི་ནང་དུ་བཞུགས་པ་ཤེས་སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1JN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1JN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1JN/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}