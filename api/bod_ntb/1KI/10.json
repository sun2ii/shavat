{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":10,"content":[{"type":"heading","content":["ཤེ་བཱ་ཡུལ་གྱི་རྒྱལ་མོས་སོ་ལོ་མོན་ལ་ཚོད་བགམ་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཤེ་བཱ་ཡུལ་གྱི་རྒྱལ་མོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ལ་བརྟེན་ནས་བྱུང་བའི་སོ་ལོ་མོན་གྱི་སྙན་གྲགས་ཐོས་ཏེ། དཀའ་གནད་དང་བཅས་ཁོང་ལ་ཚོད་བགམ་བྱེད་དུ་འོངས་པ་སྟེ།"]},{"type":"verse","number":2,"content":["འཁོར་གཡོག་ཤིན་ཏུ་མང་པོ་ཁྲིད་ནས། བསུང་རྫས་དང་གསེར་དང་རྡོ་རིགས་ཀྱི་རིན་པོ་ཆེ་བཅས་ཤིན་ཏུ་མང་པོ་རྔ་མོང་ལ་བཀལ་ཏེ་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས་ནས་སོ་ལོ་མོན་གྱི་དྲུང་དུ་ཕྱིན་ཅིང་། སེམས་ནང་གི་དཀའ་གནད་ཐམས་ཅད་ཀྱིས་ཁོང་ལ་ཚོད་བགམ་བྱས་པ་ན།"]},{"type":"verse","number":3,"content":["སོ་ལོ་མོན་གྱིས་མོའི་དྲི་བ་ཀུན་ལ་ལན་བཏབ་པ་དང་། དྲི་བ་གང་ལའང་རྒྱལ་པོས་ལན་མ་ཐེབས་པ་ཅི་ཡང་མེད་པས།"]},{"type":"verse","number":4,"content":["ཤེ་བཱའི་རྒྱལ་མོས་སོ་ལོ་མོན་གྱི་ཤེས་རབ་ཐམས་ཅད་དང་། ཁོང་གིས་བཞེངས་པའི་ཕོ་བྲང་དང་།"]},{"type":"verse","number":5,"content":["གསོལ་ལྕོག་སྟེང་གི་ཁ་ཟས། བློན་པོ་རྣམས་ཀྱི་བཞུགས་གྲལ། ཞབས་ཕྱི་རྣམས་ཀྱི་འགྲེང་ལུགས། དེ་དག་གི་གྱོན་གོས་དང་ཁོང་གི་ཆང་གཉེར་བློན་ཆེན་རྣམས། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕུལ་བའི་སྦྱིན་སྲེག་བཅས་མཐོང་བ་དང་ཤིན་ཏུ་ངོ་མཚར་བར་གྱུར།"]},{"type":"verse","number":6,"content":["དེ་ནས་མོས་རྒྱལ་པོ་ལ། ངས་རང་གི་ཡུལ་དུ་ཐོས་པའི་ཁྱེད་ཀྱི་མཛད་པ་དང་ཁྱེད་ཀྱི་ཤེས་རབ་ཐད་ཀྱི་གཏམ་ནི་ཐམས་ཅད་བདེན་འདུག"]},{"type":"verse","number":7,"content":["ང་རང་འདིར་འོངས་ཏེ་མིག་གིས་དངོས་སུ་མཐོང་བའི་བར་དུ་གཏམ་དེ་དག་བདེན་པར་མ་བཟུང་བ་ཡིན། ཀྱེ་ཧོ། ངས་ཐོས་པ་ནི་དེའི་ཕྱེད་ཀ་ཙམ་ལའང་སླེབས་མེད། ཁྱེད་ཀྱི་ཤེས་རབ་དང་ལོངས་སྤྱོད་ནི་ངས་ཐོས་པ་ལས་རབ་ཏུ་འཕགས་སོ། །"]},{"type":"verse","number":8,"content":["ཁྱེད་ཀྱི་མི་རྣམས་བདེའོ། །རྒྱུན་དུ་ཁྱེད་ཀྱི་དྲུང་དུ་འགྲེངས་ནས་ཁྱེད་ཀྱི་ཤེས་རབ་ཐོས་ཐུབ་པའི་འཁོར་གཡོག་འདི་རྣམས་བདེའོ། །"]},{"type":"verse","number":9,"content":["ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་ཅིང་བསྔགས་པར་གྱིས། ཁོང་ཉིད་ཁྱེད་ལ་མཉེས་ཤིང་ཁྱེད་རང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲིར་བཀོད་པ་ཡིན། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡེས་ར་ཨེལ་ལ་རྟག་ཏུ་བྱམས་པས། ཁྱེད་ཀྱིས་ཁྲིམས་དྲང་པོར་གཅོད་པའི་དོན་དུ་ཁོང་གིས་ཁྱེད་ནི་རྒྱལ་པོར་བསྐོས་པ་ལགས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཤེ་བཱ་ཡི་རྒྱལ་མོས་རྒྱལ་པོ་ལ་གསེར་རྡོ་ཚད་ཆིག་བརྒྱ་ཉི་ཤུ་དང་། བསུང་རྫས་དང་རྡོ་རིགས་ཀྱི་རིན་པོ་ཆེ་མང་པོ་ཕུལ་ཏོ། །ཤེ་བཱའི་རྒྱལ་མོས་རྒྱལ་པོ་སོ་ལོ་མོན་ལ་ཕུལ་བའི་བསུང་རྫས་དེ་འདྲའི་འབོར་ཆེན་ནི་ཕྱིས་སུ་གཞན་སུས་ཀྱང་མ་ཕུལ་ཏོ། །"]},{"type":"verse","number":11,"content":["དེ་མིན་ཧི་རཱམ་གྱི་གྲུ་རྣམས་ཀྱིས་ཨོ་ཕིར་ཡུལ་གྱི་གསེར་དང་ཙན་དན་གྱི་ཤིང་མང་པོ་དང་། རྡོ་རིགས་ཀྱི་རིན་པོ་ཆེ་བཅས་བཀལ་ནས་སླེབས་པས།"]},{"type":"verse","number":12,"content":["རྒྱལ་པོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་རང་གི་ཕོ་བྲང་གི་ཕྱིར་ཙན་དན་གྱི་རྒྱུག་ཁྲ་རྣམས་བཟོ་རུ་བཅུག་པ་དང་། ཡང་མགུར་ལེན་མཁན་རྣམས་ཀྱི་ཆེད་དུ་པི་ཝང་དང་རྒྱུད་མངས་ཀྱང་བཟོས་སོ། །ཕྱིས་སུ་དེ་འདྲའི་ཙན་དན་གྱི་ཤིང་ནི་ནམ་ཡང་མ་སླེབས་ཏེ། དེ་རིང་གི་བར་དུ་དེ་འདྲ་མཐོང་མྱོང་བའང་མེད་དོ། །"]},{"type":"verse","number":13,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཤེ་བཱའི་རྒྱལ་མོར་ཁོ་མོའི་འདོད་པ་བཞིན་ཞུས་ཚད་ཀུན་སྤྲད་པར་མ་ཟད། གཏོང་ཕོད་ཆེན་པོས་རྫོང་བ་མང་པོ་བརྫངས་པ་དང་། དེ་ནས་རྒྱལ་མོ་དང་མོའི་བློན་འཁོར་རྣམས་ཕྱིར་རང་ཡུལ་དུ་ལོག་གོ །"]},{"type":"heading","content":["སོ་ལོ་མོན་གྱི་བརྗིད་ཉམས།"]},{"type":"verse","number":14,"content":["སོ་ལོ་མོན་ལ་ལོ་རེར་ཐོབ་པའི་གསེར་ནི་རྡོ་ཚད་དྲུག་བརྒྱ་དྲུག་ཅུ་རེ་དྲུག་གོ །"]},{"type":"verse","number":15,"content":["དེར་མ་ཟད། ཚོང་པ་རྣམས་དང་ཚོང་འགྲིམ་པའི་དཔྱ་ཁྲལ་དང་། ཨ་རབ་ཀྱི་རྒྱལ་པོ་རྣམས་དང་ཡུལ་དེ་གའི་གྲོང་དཔོན་བཅས་ནས་ཀྱང་ཐོབ་འབབ་ཡོད་པའོ། །"]},{"type":"verse","number":16,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་གསེར་ལྗང་རྡུང་གིས་ཕུབ་ཆེན་ཉིས་བརྒྱ་བཟོས་པ་དང་། ཕུབ་རེ་རེར་གསེར་རྒྱ་མ་བཅུ་བཞི་རེ་སོང་ངོ་། །"]},{"type":"verse","number":17,"content":["ཡང་ཁོང་གིས་གསེར་ལྗང་རྡུང་གིས་ཕུབ་ཆུང་སུམ་བརྒྱ་བཟོས་པ་དང་། ཕུབ་ཆུང་རེ་རེར་གསེར་མཱེ་ན་",{"noteId":17},"གསུམ་རེ་སོང་། རྒྱལ་པོས་དེ་རྣམས་ལེ་པཱ་ནོན་གླིང་ཀའི་ཕོ་བྲང་དུ་བཞག་གོ །"]},{"type":"verse","number":18,"content":["ཡང་རྒྱལ་པོས་བ་སོའི་ཁྲི་ཆེན་པོ་ཞིག་བཟོས་པ་དང་དེ་ནི་གསེར་བཙོ་མས་གཡོགས་སོ། །"]},{"type":"verse","number":19,"content":["རྒྱལ་ཁྲི་དེ་ལ་ཐེམ་སྐས་རིམ་པ་དྲུག་དང་རྒྱབ་རྟེན་གྱི་དབུ་གོར་དང་། བཞུགས་སའི་གཡས་གཡོན་གཉིས་ལ་ལག་སྐྱོར་དང་། ལག་སྐྱོར་རེ་རེའི་རྩར་སེང་གེ་རེ་འགྲེངས་ཡོད་པ་ཡིན།"]},{"type":"verse","number":20,"content":["ཡང་ཐེམ་སྐས་རིམ་པ་དྲུག་པོའི་གཡས་ཕྱོགས་སུ་སེང་གེ་དྲུག་དང་། གཡོན་ཕྱོགས་སུ་སེང་གེ་དྲུག་བཅས་སེང་གེ་བཅུ་གཉིས་ཡོད་པ་ཡིན། དེ་འདྲ་བ་ཞིག་རྒྱལ་ཁམས་གང་དུ་ཡང་མ་བཟོས་སོ། །"]},{"type":"verse","number":21,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་སྐྱོགས་ཐམས་ཅད་གསེར་ཡིན་པ་དང་། ལེ་པཱ་ནོན་གླིང་ཀའི་ཕོ་བྲང་ནང་གི་སྣོད་ཆས་ཐམས་ཅད་ཀྱང་གསེར་བཙོ་མས་བཟོས་ཡོད། སོ་ལོ་མོན་གྱི་དུས་སུ་དངུལ་ལ་རིན་ཐང་ཅི་ཡང་མེད་པས། དངུལ་ལས་བཟོས་པ་གཅིག་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":22,"content":["ཅིའི་ཕྱིར་ཞེ་ན། རྒྱལ་པོའི་གྲུ་གཟིངས་རྣམས་ཧི་རཱམ་གྱི་གྲུ་དང་མཉམ་དུ་ཐཱར་ཞིས་ལ་བསྐྱོད་པ་དང་། ལོ་གསུམ་རེའི་ནང་དུ་ཐེངས་གཅིག་ལ་ཐཱར་ཞིས་ཀྱི་གྲུ་དག་གིས་གསེར་དང་། དངུལ་དང་། བ་སོ་དང་། སྤྲེའུ་དང་། རྨ་བྱ་སོགས་བསྐྱལ་འོངས་སོ། །"]},{"type":"verse","number":23,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་འབྱོར་བ་དང་ཤེས་རབ་ནི་ས་གཞིའི་རྒྱལ་པོ་ཐམས་ཅད་ལས་བརྒལ་བ་ཡིན།"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་གིས་སོ་ལོ་མོན་གྱི་སེམས་སུ་གནང་བའི་ཤེས་རབ་ཐོས་པའི་ཕྱིར་དུ། ས་གཞི་ཡོངས་ཀྱི་མི་རྣམས་ཁོང་འཚོལ་དུ་བསྙེགས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་དག་རེ་རེས་ཁྱེར་འོངས་པའི་ཕྱག་རྟེན་ལ་དངུལ་ཆས་དང་གསེར་ཆས། གྱོན་གོས། མཚོན་ཆ། བསུང་རྫས། རྟ། དྲེལ་བཅས་ཡོད་ཅིང་། ལོ་ནས་ལོ་ལ་གྲངས་མང་པོ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ཡང་སོ་ལོ་མོན་གྱིས་ཤིང་རྟ་དང་སྐྱ་དམག་བསྡུས་ཏེ། ཁོང་ལ་ཤིང་རྟ་ཆིག་སྟོང་བཞི་བརྒྱ་དང་། སྐྱ་དམག་ཆིག་ཁྲི་ཉིས་སྟོང་ཡོད་ལ། རྒྱལ་པོས་དེ་དག་ཤིང་རྟའི་གྲོང་ཁྱེར་རྣམས་དང་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་དུ་བཞག་པ་སྟེ། ཁོང་དང་མཉམ་དུ་ཡོད་པའོ། །"]},{"type":"verse","number":27,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་པོས་དངུལ་ནི་རྡོ་ལྟར་མོད་པ་དང་ཐང་ཤིང་ནི་རི་ཀླུང་དུ་སྐྱེས་པའི་འོ་སེ་ཤིང་ལྟར་མོད་པར་མཛད།"]},{"type":"verse","number":28,"content":["སོ་ལོ་མོན་གྱི་རྟ་རྣམས་ནི་ཨེ་ཅིབ་དང་ཀི་ཝེ་ཡུལ་ནས་དྲངས་པ་སྟེ། རྒྱལ་པོའི་ཚོང་པ་དག་གིས་ཀི་ཝེ་ཡུལ་ནས་རིན་གོང་ལྟར་ཉོས་འོངས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["ཤིང་རྟ་རེ་ལ་དངུལ་སྒོར་དྲུག་བརྒྱ་དང་། རྟ་རེ་ལ་དངུལ་སྒོར་བརྒྱ་དང་ལྔ་བཅུའི་གོང་ཐག་གིས་བཅད་དེ་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པ་ཡིན་པས། ཧེད་པའི་རྒྱལ་པོ་རྣམས་དང་ཨ་རམ་པའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཀྱང་ཚོང་པ་རྣམས་བརྒྱུད་ནས་རྟ་རྣམས་ཉོས་པའོ། །"]}],"footnotes":[{"noteId":17,"caller":"+","text":"མཱེ་ན་ཞེས་པ་ནི་དངོས་རྫས་ཀྱི་ལྗིད་ཚད་འཇལ་བའི་ཡོ་བྱད་ཅིག་གི་མིང་སྟེ། མཱེ་ན་གཅིག་ནི་རྒྱ་མ་གཅིག་དང་སྲང་གཉིས་ཙམ་ཡིན།","reference":{"chapter":10,"verse":17}}]},"thisChapterLink":"/api/bod_ntb/1KI/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/9.json","previousChapterAudioLinks":{},"numberOfVerses":29}