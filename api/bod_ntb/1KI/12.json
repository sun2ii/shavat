{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":12,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རེ་ཧབ་ཨམ་ལ་ངོ་རྒོལ་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་རེ་ཧབ་ཨམ་ནི་སི་ཀེམ་དུ་ཕྱིན་ཏོ། །ཅིའི་ཕྱིར་ཞེ་ན། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ཁོང་རྒྱལ་པོར་བསྐོ་བའི་ཆེད་དུ་སི་ཀེམ་དུ་ཕྱིན་པ་རེད།"]},{"type":"verse","number":2,"content":["སྐབས་དེར་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་ནི་སྔར་སོ་ལོ་མོན་གྱི་དྲུང་ནས་ཨེ་ཅིབ་ཡུལ་དུ་བྲོས་སོང་སྟེ་གནས་དེར་བསྡད་ཡོད་པ་དང་ཁོས་འཕྲིན་དེ་ཐོས། དེར་ཡེས་ར་ཨེལ་པས་མི་མངགས་ཏེ་ཁོ་བོས་པ་ལ། ཁོ་དང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་རེ་ཧབ་ཨམ་གྱི་དྲུང་དུ་འོངས་ནས་ཁོང་ལ་ན་རེ།"]},{"type":"verse","number":4,"content":["ཁྱེད་ཀྱི་ཡབ་ཀྱིས་ངེད་ཅག་ལ་གཉའ་ཤིང་ཤིན་ཏུ་ལྕི་མོ་བཀལ་བྱུང་། ད་ལྟ་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཡབ་ཀྱིས་ངེད་ཅག་ལ་བཀལ་བའི་ངལ་ལས་དང་གཉའ་ཤིང་ལྕི་མོ་ཇེ་ཡང་དུ་གཏོང་བར་མཛོད་ཅིག དེ་ནས་ངེད་ཅག་གིས་ཁྱེད་ལ་ཞབས་ཕྱི་བསྒྲུབ་པར་བྱ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":5,"content":["རེ་ཧབ་ཨམ་གྱིས་དེ་དག་ལ་ན་རེ། ཁྱོད་རྣམས་སྐབས་སུ་ཕྱིར་སོང་ལ། ཉིན་གསུམ་འགོར་རྗེས་ཕྱིར་ངའི་རྩར་ལོག་ཤོག་ཅེས་སྨྲས་པས་དེ་རྣམས་སོང་ངོ་། །"]},{"type":"verse","number":6,"content":["རྒྱལ་པོ་རེ་ཧབ་ཨམ་གྱིས་རང་གི་ཡབ་སོ་ལོ་མོན་བཞུགས་པའི་དུས་སུ་ཁོང་གི་དྲུང་དུ་ཞབས་ཕྱི་སྒྲུབ་མཁན་རྒན་པ་རྣམས་ལ་བློ་དྲིས་ནས་ན་རེ། ངས་མི་རྣམས་ལ་ལན་འདེབས་པར་ཁྱེད་རྣམ་པར་དགོངས་འཆར་ཅི་ཡོད་ཅེས་དྲིས་པར།"]},{"type":"verse","number":7,"content":["དེ་དག་གིས་ལན་དུ། གལ་སྲིད་དེ་རིང་ཉིན་མོར་རྒྱལ་པོ་ཁྱེད་རང་མི་འདི་རྣམས་ཀྱི་ཞབས་ཕྱི་བྱས་ནས་ཁོ་རྣམས་ལ་ཞབས་ཕྱི་སྒྲུབ་པ་དང་། གཏམ་བཟང་པོ་སྨྲས་ན། ཁོ་ཚོ་རྒྱུན་ནས་རྒྱུན་དུ་ཁྱེད་ཀྱི་ཞབས་ཕྱི་བྱེད་པར་འགྱུར་ཞེས་ཞུས་མོད།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་རྒྱལ་པོས་རྒན་པ་ཚོའི་བཏོན་པའི་བསམ་འཆར་དང་དུ་མ་བླངས་པར། ཁོ་དང་མཉམ་དུ་ནར་སོན་ཞིང་ཁོའི་མདུན་དུ་ཞབས་ཕྱི་སྒྲུབ་པའི་གཞོན་ནུ་དག་ལ་གྲོས་འདྲི་བྱས་ཏེ།"]},{"type":"verse","number":9,"content":["དེ་དག་ལ་ན་རེ། མི་རྣམས་ཀྱིས་བདག་ལ་འདི་ལྟར། ཁྱེད་ཀྱི་ཡབ་ཀྱིས་བདག་ཅག་ལ་བཀལ་བའི་གཉའ་ཤིང་ལྕི་མོ་དེ་ཇེ་ཡང་དུ་གཏོང་བར་མཛོད་ཅིག་ཅེས་ཞུས་པས། ངས་མི་འདི་རྣམས་ལ་ལན་འདེབས་པར་ཁྱོད་རྣམས་ལ་བསམ་ཚུལ་ཅི་ཡོད་ཅེས་དྲིས་པར།"]},{"type":"verse","number":10,"content":["ཁོ་དང་མཉམ་དུ་ནར་སོན་པའི་གཞོན་ནུ་དག་གིས་ཁོ་ལ་འདི་ལྟར། མི་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱི་ཡབ་ཀྱིས་ངེད་ཅག་ལ་གཉའ་ཤིང་ལྕི་མོ་བཀལ་བྱུང་། ད་ལྟ་ཁྱེད་ཀྱིས་དེ་ཇེ་ཡང་དུ་གཏོང་བར་མཛོད་ཅེས་ཞུས་པར། རྒྱལ་པོས་ཁོ་རྣམས་ལ་འདི་ལྟར། ངའི་ཡབ་ཀྱི་རྐེད་པ་ལས་ངའི་མཐེབ་ཆུང་སྦོམ་པས་ན།"]},{"type":"verse","number":11,"content":["ངའི་ཡབ་ཀྱིས་ཁྱོད་ཚོར་གཉའ་ཤིང་ལྕི་མོ་གཅིག་བཀལ་བ་དང་། བདག་གིས་ཁྱོད་ཚོར་དེ་ལས་ལྕི་བའི་གཉའ་ཤིང་འགེལ་ངེས། ངའི་ཡབ་ཀྱིས་ཁྱོད་ཚོར་རྟ་ལྕག་གིས་གཞུས་པ་དང་། ངས་ཁྱོད་ཚོར་སྡིག་པ་ར་ཙ་ཅན་གྱི་ལྕག་གིས་གཞུ་བར་བྱ་ཞེས་པའི་བཀའ་ལན་གནང་བར་མཛོད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":12,"content":["ཡང་རྒྱལ་པོས་ཉིན་གསུམ་པར་ངའི་རྩར་ལོག་ཤོག་ཅེས་བསྒོས་པ་ལྟར་དུ། ཡེ་རོབ་ཨམ་དང་མི་ཐམས་ཅད་ཉིན་གསུམ་པར་རེ་ཧབ་ཨམ་གྱི་དྲུང་དུ་འོངས་པ་ལ།"]},{"type":"verse","number":13,"content":["རྒྱལ་པོས་དེ་དག་ལ་ལན་རྩུབ་པོ་མཛད་དེ། ཁོང་གིས་རྒན་པ་དག་གི་གཏམ་ལ་མ་མཉན་པར།"]},{"type":"verse","number":14,"content":["གཞོན་ནུ་དག་གི་གྲོས་བཞིན་དུ་དེ་དག་ལ་ན་རེ། ངའི་ཡབ་ཀྱིས་ཁྱོད་ཚོར་གཉའ་ཤིང་ལྕི་མོ་བཀལ་བ་དང་། བདག་གིས་ཁྱོད་ཚོར་དེ་ལས་ལྕི་བའི་གཉའ་ཤིང་འགེལ་ངེས། ངའི་ཡབ་ཀྱིས་ཁྱོད་ཚོར་རྟ་ལྕག་གིས་གཞུས་པ་དང་། ངས་ཁྱོད་ཚོར་སྡིག་པ་ར་ཙ་ཅན་གྱི་ལྕག་གིས་གཞུ་བར་བྱ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["རྒྱལ་པོས་མི་རྣམས་ཀྱི་ཞུ་བར་མ་མཉན་པ་སྟེ། ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཞི་ལོ་པ་ཨ་ཧི་ཡཱའི་ངག་བརྒྱུད་ནས་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་ལ་གསུངས་པའི་བཀའ་དེ་འགྲུབ་པའི་ཕྱིར་དུ། འགྱུར་བ་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ནས་བྱུང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":16,"content":["དེར་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རྒྱལ་པོས་ཁོ་རྣམས་ཀྱི་ཞུ་བར་མི་མཉན་པ་མཐོང་བས། རྒྱལ་པོར་ལན་བཟློགས་ཏེ་འདི་ལྟར། ངེད་རྣམས་ལ་དཱ་བིད་ལས་སྐལ་ཅི་ཡོད། ངེད་རྣམས་ལ་ཡེ་སེ་ཡི་བུ་ལས་ནོར་སྐལ་ཅི་ཡང་མེད། ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། རང་རང་གི་ཁྱིམ་དུ་ལོག་ཅིག ཀྱེ་དཱ་བིད་ལགས། ད་ནི་རང་གི་ཁྱིམ་ལ་བདག་སྐྱོང་གྱིས་ཤིག་ཅེས་སྨྲས་ནས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་རང་རང་གི་ཁྱིམ་དུ་ལོག"]},{"type":"verse","number":17,"content":["རེ་ཧབ་ཨམ་ནི་སྔར་བཞིན་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་དག་ཏུ་སྡོད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྒྱལ་པོར་བྱས།"]},{"type":"verse","number":18,"content":["ཡང་རེ་ཧབ་ཨམ་གྱིས་སྡུག་ལས་རྒྱག་མཁན་རྣམས་ལ་ལྟ་སྐུལ་བྱེད་པའི་ཨ་དོ་རམ་མངགས་ནས་སོང་བ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་རྡོ་རུབ་བཏང་ནས་བསད། དེར་རྒྱལ་པོ་རེ་ཧབ་ཨམ་ནི་རྟབ་རྟབ་པོར་ཤིང་རྟར་བསྡད་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་བྲོས།"]},{"type":"verse","number":19,"content":["དེ་བཞིན་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་རིང་གི་བར་དུ་དཱ་བིད་ཚང་ལ་ངོ་ལོག་བྱས་པའོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་ཡོངས་ཀྱིས་ཡེ་རོབ་ཨམ་ཕྱིར་ལོག་པ་ཐོས་ནས། མི་ཚོགས་ཀྱི་མདུན་དུ་འོང་བའི་ཕྱིར་འབོད་མཁན་བཏང་ཞིང་། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་རྒྱལ་པོར་བསྐོས་པས། ཡ་ཧུ་དཱའི་ཚོ་པ་ལས་གཞན་དཱ་བིད་ཚང་གི་རྗེས་སུ་འབྲང་མཁན་མེད་དོ། །"]},{"type":"verse","number":21,"content":["རེ་ཧབ་ཨམ་ནི་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་པ་དང་། ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་དང་འཐབ་ནས་རྒྱལ་སྲིད་ཕྱིར་བླངས་ཏེ་སོ་ལོ་མོན་གྱི་སྲས་རེ་ཧབ་ཨམ་ལ་འཐོབ་པའི་ཕྱིར། ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་དང་པེན་ཡཱ་མེན་གྱི་ཚོ་པ་ལས་དམག་མི་དཔའ་རྩལ་ཅན་བསྡོམས་པས་མི་ཆིག་འབུམ་བརྒྱད་ཁྲི་བསྡུས་པའོ། །"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཤེ་མ་ཡཱ་བྱ་བ་ལ་དཀོན་མཆོག་གི་བཀའ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":23,"content":["ཁྱོད་སོང་ནས་རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་སྲས་ཏེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རེ་ཧབ་ཨམ་དང་། ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གྱི་ཁྱིམ་རྒྱུད་ཡོངས་དང་། དེའི་འཕྲོའི་མི་ཐམས་ཅད་ལ་འདི་ལྟར་སྦྲོན་ཅིག"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོ་ཡར་སོང་ནས་རང་གི་སྤུན་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དམག་རྒྱག་མི་རུང་། དོན་འདི་ནི་བདག་ལས་བྱུང་བ་ཡིན་པས། ཁྱོད་རྣམས་རང་རང་གི་ཁྱིམ་དུ་ལོག་ཅིག་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་པ་དང་། དེ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མཉན་ཏེ་ཕྱིར་རང་ཡུལ་དུ་ལོག་པའོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱིས་གསེར་གྱི་བ་ཕྲུག་གཉིས་ལྷ་རྟེན་བྱས་པ།"]},{"type":"verse","number":25,"content":["དེ་ནས་ཡེ་རོབ་ཨམ་གྱིས་ཨེ་ཕཱར་ཡིམ་རི་བོར་སི་ཀེམ་གྲོང་ཁྱེར་བརྩིགས་ནས་དེར་གཞིས་ཕབ་པ་དང་། ཡང་ཡུལ་དེ་ནས་ཕྱི་རུ་ཐོན་ཏེ་ཕཱ་ནེ་ཨེལ་གྲོང་ཁྱེར་བརྩིགས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ཡེ་རོབ་ཨམ་གྱི་སེམས་སུ། ད་ལྟ་རྒྱལ་སྲིད་ནི་སྔར་བཞིན་དཱ་བིད་ཀྱི་ཁྱིམ་ལ་དབང་བར་འགྱུར་སྲིད།"]},{"type":"verse","number":27,"content":["གལ་ཏེ་མི་འདི་རྣམས་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་སོང་ནས་མཆོད་པ་ཕུལ་ན། ཁོ་རྣམས་ཀྱི་སེམས་ནི་ཕྱིར་རང་གི་བདག་པོ་སྟེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རེ་ཧབ་ཨམ་གྱི་ཕྱོགས་སུ་འཁོར་ཞིང་བདག་གསོད་པར་འགྱུར་སྙམ་པས།"]},{"type":"verse","number":28,"content":["རྒྱལ་པོས་སེམས་ཐག་བཅད་ནས་གསེར་གྱི་བ་ཕྲུག་གཉིས་བཟོས་ཏེ་མི་རྣམས་ལ། ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། ཁྱོད་ཅག་ཡེ་རུ་སཱ་ལེམ་དུ་ཡར་འགྲོ་བར་དཀའ་སྡུག་ཡོད། ལྟོས་དང་། ཁྱོད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པའི་ལྷ་ནི་འདི་རུ་ཡོད་ཅེས་སྨྲས་ནས།"]},{"type":"verse","number":29,"content":["ཁོས་བ་ཕྲུག་གཅིག་པེད་ཨེལ་དུ་བཞག་པ་དང་བ་ཕྲུག་ཅིག་ཤོས་དེ་དཱན་ཞེས་པར་བཞག་གོ །"]},{"type":"verse","number":30,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་དཱན་ཡུལ་གྱི་གསེར་གྱི་བ་ཕྲུག་ལ་བསྙེན་བཀུར་བྱེད་དུ་ཕྱིན་པས་དེ་ནི་ཁོ་རྣམས་ཀྱི་སྡིག་པའི་རྒྱུ་རུ་གྱུར་ཏོ། །"]},{"type":"verse","number":31,"content":["ཡང་ཁོས་མཐོ་གླིང་རྣམས་སུ་མཆོད་ཁང་བཞེངས་པ་དང་། ལེ་ཝི་པ་མ་ཡིན་པའི་སྐྱེ་བོ་ཕལ་བ་རྣམས་མཆོད་དཔོན་དུ་བསྐོས་སོ། །"]},{"type":"verse","number":32,"content":["ཡང་ཡེ་རོབ་ཨམ་གྱིས་ཡ་ཧུ་དཱ་ཡི་དུས་ཆེན་དང་འདྲ་བའི་དུས་ཆེན་ཞིག་ཟླ་བརྒྱད་པའི་ཚེས་བཅོ་ལྔ་ལ་བཙུགས་ཤིང་། ཁོ་རང་གིས་མཆོད་ཁྲིའི་སྟེང་སྦྱིན་སྲེག་ཕུལ་ཏོ། །དེ་བཞིན་དུ་པེད་ཨེལ་དུའང་རང་གིས་བཟོས་པའི་བ་ཕྲུག་གཉིས་ཀྱི་མདུན་དུ་དམར་མཆོད་ཕུལ་ཞིང་། ཁོས་པེད་ཨེལ་དུ་བརྩིགས་པའི་མཐོ་གླིང་རྣམས་ཀྱི་ཕྱིར་མཆོད་དཔོན་རྣམས་ཀྱང་བསྐོས་སོ། །"]},{"type":"verse","number":33,"content":["ཟླ་བ་བརྒྱད་པའི་ཚེས་བཅོ་ལྔའི་ཉིན་ཏེ། རང་གི་སེམས་ནས་རང་དགར་ཡེས་ར་ཨེལ་གྱི་དུས་ཆེན་དུ་བཙུགས་པའི་ཉིན་མོ་དེ་ལ། པེད་ཨེལ་དུ་ཁོ་རང་གིས་བཞེངས་པའི་མཆོད་ཁྲིའི་ཁར་མཆོད་པ་ཕུལ་ནས་བསང་བཏང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1KI/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/11.json","previousChapterAudioLinks":{},"numberOfVerses":32}