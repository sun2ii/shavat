{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":13,"content":[{"type":"heading","content":["ལུང་སྟོན་པ་ཞིག་གིས་རྒྱལ་པོ་ཡེ་རོབ་ཨམ་ལ་བཀའ་བཀྱོན་གནང་བ།"]},{"type":"verse","number":1,"content":["ཡེ་རོབ་ཨམ་གྱིས་མཆོད་ཁྲིའི་མདུན་དུ་ལངས་ནས་བསང་གཏོང་བའི་སྐབས་སུ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཞིག་ཡ་ཧུ་དཱ་ནས་པེད་ཨེལ་དུ་སླེབས་པ་དང་།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་བརྟེན་ནས་མཆོད་ཁྲི་ལ་སྐད་ཆེན་པོས་འདི་ལྟར། ཀྱེ་མཆོད་ཁྲི། ཀྱེ་མཆོད་ཁྲི། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཧོ། དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་ལས་ཡོ་ཤི་ཡཱ་",{"noteId":18},"བྱ་བའི་བུ་ཞིག་འཁྲུང་བར་འགྱུར་བ་དང་། ཁོང་གིས་ཁྱོད་ཀྱི་སྟེང་དུ་མཐོ་གླིང་གི་སྤོས་གདུག་མཁན་མཆོད་དཔོན་རྣམས་ནི་མཆོད་པར་འབུལ་ཞིང་ཁྱོད་ཀྱི་སྟེང་དུ་མིའི་རུས་པ་བསྲེག་པར་བྱའོ་ཞེས་གསུངས་སོ་ཞེས་བསྒྲགས་སོ། །"]},{"type":"verse","number":3,"content":["ཡང་ཉིན་དེ་ལ་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་རྟགས་ཤིག་བསྟན་ནས་འདི་ལྟར། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་རྟགས་ཡིན། ཀྱེ་ཧོ། མཆོད་ཁྲི་གས་ནས། དེའི་སྟེང་དུ་ཡོད་པའི་ཐལ་བ་འབོ་བར་འགྱུར་རོ་",{"noteId":19},"ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་པེད་ཨེལ་གྱི་མཆོད་ཁྲི་ལ་བསྒྲགས་པའི་འབོད་ཚིག་དེ་རྒྱལ་པོ་ཡེ་རོབ་ཨམ་གྱིས་ཐོས་པས། ཁོས་མཆོད་ཁྲིའི་སྟེང་ནས་ལག་པ་བརྐྱངས་ཏེ། མི་དེ་ཟུངས་ཤིག་བསྒོས་པ་དང་། ཕྱི་རུ་བརྐྱངས་པའི་ལག་པ་དེ་བསྐམས་པར་གྱུར་ཏེ་རང་གི་ཕྱོགས་སུ་འགུག་མ་ནུས་སོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་བརྟེན་ནས་མངོན་པར་ཕྱུང་བའི་རྟགས་ནང་བཞིན། མཆོད་ཁྲི་གས་ནས་ཐལ་བ་འཕོས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་རྒྱལ་པོས་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལ། ཁྱེད་ཀྱིས་ཕྲན་གྱི་དོན་དུ་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་བ་བྱས་ཏེ། ཕྲན་གྱི་ལག་པ་སླར་གསོ་བའི་ཕྱིར་ངའི་དོན་དུ་སྨོན་ལམ་འདེབས་རོགས་ཞེས་ཞུས་པ་དང་། དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ནས་རྒྱལ་པོའི་ལག་པ་སླར་སོས་ནས་སྔར་བཞིན་གྱུར་ཏོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་རྒྱལ་པོས་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལ། ང་དང་མཉམ་དུ་རྒྱལ་པོའི་ཕོ་བྲང་ལ་ཤོག་དང་། ཁ་ཟས་ཉུང་ཙམ་སྤྱད་ནས་ལུས་ལ་སྟོབས་ཤུགས་རྒྱས་པར་མཛོད། ངས་ཁྱེད་ལ་རྔན་པ་ཞིག་ཀྱང་སྦྱིན་ཡོང་ཞེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་དེས་རྒྱལ་པོ་ལ། གལ་ཏེ་ཁྱོད་ཀྱིས་ང་ལ་རང་གི་ཕོ་བྲང་གི་ཕྱེད་ཀ་སྦྱིན་ཡང་ང་རང་ཁྱོད་དང་མཉམ་དུ་མི་འགྲོ། ཡུལ་འདིར་ངས་ཟས་མི་བཟའ་ལ་ཆུ་ཡང་མི་འཐུང་།"]},{"type":"verse","number":9,"content":["གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཟས་ཀྱང་མ་བཟའ། ཆུ་ཡང་མ་འཐུང་ཞིག ལམ་གང་ནས་ཕྱིན་པ་དེར་ཕྱིར་མ་ལོག་ཅིག་ཅེས་ནན་གྱིས་བསྐུལ་ཏོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ནི་པེད་ཨེལ་དུ་འོངས་པའི་ལམ་ནས་ཕྱིར་མ་ལོག་པར་ལམ་གཞན་དུ་ཞུགས་སོ། །"]},{"type":"verse","number":11,"content":["དེའི་དུས་སུ་ལུང་སྟོན་པ་རྒན་པ་ཞིག་པེད་ཨེལ་དུ་བཞུགས་ཡོད་ལ། ཁོང་གི་བུ་རྣམས་འོངས་ནས། དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་ཉིན་དེར་པེད་ཨེལ་ནས་མཛད་པའི་དོན་རྣམས་ཁོང་ལ་ཞུས་ཤིང་། རྒྱལ་པོ་ལ་སྨྲས་པའི་ཚིག་རྣམས་ཀྱང་ཕ་ལ་སྨྲས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་དེ་དག་གི་ཕ་ཡིས་ཁོ་རྣམས་ལ། དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལམ་གང་དུ་ཞུགས་སམ་ཞེས་དྲིས་པས། ཁོང་གི་བུ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་ནས་འོངས་པའི་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལམ་གང་ནས་ལོག་སོང་བ་དེ་བསྟན་པ་རེད།"]},{"type":"verse","number":13,"content":["དེར་ཁོང་གིས་རང་གི་བུ་རྣམས་ལ། ངའི་དོན་དུ་བོང་བུར་སྒ་སྟོད་ཅིག་ཅེས་སྨྲས་པ་དང་། དེ་དག་གིས་ཁོང་གི་དོན་དུ་བོང་བུར་སྒ་བསྟད་པ་དང་ཁོ་དེ་ལ་བཞོན་ཏེ།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུའི་རྗེས་སུ་སོང་བ་དང་། ཁོང་བེ་ཤིང་གི་འོག་ཏུ་བསྡད་ཡོད་པར་ཕྲད་ཅིང་ཁོང་ལ་ན་རེ། ཁྱེད་རང་ཡ་ཧུ་དཱ་ནས་བྱོན་པའི་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ཡིན་ནམ་ཞེས་དྲིས་པ་ན། ཁོང་གིས་བདག་ནི་དེ་ཡིན་ཞེས་ལན་བཏབ་བོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ལུང་སྟོན་པ་རྒན་པ་དེས་ཁོང་ལ། ཁྱེད་རང་བདག་དང་མཉམ་དུ་ཁྱིམ་ལ་ཕེབས་ནས་ཁ་ཟས་བཞེས་རོགས་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":16,"content":["ཁོང་ན་རེ། བདག་ཁྱོད་དང་མཉམ་དུ་ཕྱིར་ལོག་པར་མི་འོས། ནང་དུ་ཡང་འགྲོ་མི་འོས། ཡུལ་འདིར་བདག་གིས་ཁྱོད་དང་ལྷན་དུ་ཟས་མི་བཟའ་ལ་ཆུ་ཡང་མི་འཐུང་།"]},{"type":"verse","number":17,"content":["གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་དེ་རུ་ཟས་ཀྱང་མ་བཟའ་ཆུ་ཡང་མ་འཐུང་ཞིག ལམ་གང་ནས་ཕྱིན་པ་དེར་ཕྱིར་མ་ལོག་ཅིག་ཅེས་བཀའ་གནང་ངོ་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":18,"content":["ལུང་སྟོན་པ་རྒན་པ་དེས་ཁོང་ལ། ང་ཡང་ཁྱེད་དང་འདྲ་བའི་ལུང་སྟོན་པ་ཞིག་ཡིན། ཕོ་ཉ་ཞིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་བརྟེན་ནས་ང་ལ་འདི་ལྟར། མི་དེས་ཟས་བཟའ་བ་དང་ཆུ་འཐུང་བར་ཁོང་ཁྱོད་དང་མཉམ་དུ་ཁྲིད་ནས་རང་གི་ཁྱིམ་ལ་ལོག་ཅིག་ཅེས་གསུངས་སོ་ཞེས་རྫུན་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["དེ་བས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ནི་ཁོང་དང་མཉམ་དུ་ཕྱིར་ལོག་ནས། ཁོང་གི་ཁྱིམ་དུ་ཁ་ཟས་སྤྱད་དེ་ཆུ་ཡང་འཐུང་བའོ། །"]},{"type":"verse","number":20,"content":["ཁོང་གཉིས་ཀ་གསོལ་ལྕོག་མདུན་དུ་བསྡད་ནས་བཟའ་བཏུང་ལ་རོལ་བཞིན་པའི་སྐབས་སུ། དཀོན་མཆོག་གི་སྐྱེས་བུ་ཕྱིར་ཁྲིད་འོངས་པའི་ལུང་སྟོན་པ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བྱུང་བ་དང་།"]},{"type":"verse","number":21,"content":["ཁོང་གིས་ཡ་ཧུ་དཱ་ནས་འོངས་པའི་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལ་སྐད་ཆེན་པོས། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་འགལ་ཞིང་། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྒྱ་ཡང་མ་བསྲུངས་པར།"]},{"type":"verse","number":22,"content":["དེ་ལས་ལྡོག་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་ཟས་མ་བཟའ་ཆུ་ཡང་མ་འཐུང་ཞེས་བསྒོས་པའི་གནས་འདི་རུ་ཟས་ཀྱང་སྤྱད་ལ་ཆུ་ཡང་འཐུང་བས། ཁྱོད་ཀྱི་བེམ་པོ་ནི་ཁྱོད་ཀྱི་ཕ་མེས་རྣམས་ཀྱི་དུར་ས་རུ་སླེབས་པར་མི་འགྱུར་ཞེས་གསུངས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":23,"content":["ཁོང་གིས་ཟས་སྤྱད་དེ་ཆུ་ཡང་འཐུང་ཟིན་པ་དང་། ལུང་སྟོན་པ་རྒན་པ་དེས་རང་གིས་ཕྱིར་ཁྲིད་འོངས་པའི་ལུང་སྟོན་པ་དེའི་དོན་དུ་བོང་བུར་སྒ་བསྟད་ཅིང་།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཁོང་ལམ་དུ་ཞུགས་པ་དང་། ལམ་བར་དུ་སེང་གེ་ཞིག་དང་ཕྲད་ནས། དེས་ཁོང་ལ་སོ་བཏབ་ནས་བསད་པས་ཁོང་གི་བེམ་པོ་ལམ་ཁར་འཕངས་ཏེ། བོང་བུ་བེམ་པོའི་རྩར་ཀྲོང་ངེར་བསྡད། སེང་གེ་ཡང་བེམ་པོའི་རྩར་ཙོག་གེར་བསྡད་དོ། །"]},{"type":"verse","number":25,"content":["ཀྱེ་ཧོ། དེའི་མཐའ་འཁོར་ནས་མི་རྣམས་ཆས་ཤིང་། བེམ་པོ་ལམ་ཁར་འཕངས་ཏེ། དེའི་རྩར་སེང་གེ་ཞིག་ཙོག་གེར་བསྡད་ཡོད་པ་མཐོང་ནས་མི་དེ་རྣམས་ལུང་སྟོན་པ་རྒན་པ་དེའི་གྲོང་ཁྱེར་དུ་ཕྱིན་ནས་གཏམ་སྨྲས་པས།"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་ལམ་ནས་ཕྱིར་ཁྲིད་འོངས་པའི་ལུང་སྟོན་པ་དེས་གཏམ་དེ་ཐོས་ནས་ན་རེ། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་འགལ་བའི་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ཡིན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ལ་གསུངས་པའི་བཀའ་བཞིན་དུ། ཁོང་སེང་གེ་ལ་གཏད་པ་དང་། སེང་གེས་ཁོང་རལ་ཏེ་བསད་པ་ལགས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":27,"content":["ཡང་ལུང་སྟོན་པ་རྒན་པ་དེས་རང་གི་བུ་རྣམས་ལ། ངའི་དོན་དུ་བོང་བུར་སྒ་སྟོད་ཅིག་ཅེས་སྨྲས་ནས་དེ་དག་གིས་སྒ་བསྟད་དོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་ཁོང་ལམ་དུ་ཆས་པ་དང་། དཀོན་མཆོག་གི་སྐྱེས་བུ་དེའི་བེམ་པོ་ལམ་ཁར་འཕངས་ནས་ཡོད་པ་རྙེད་ཅིང་། བོང་བུ་དང་སེང་གེ་གཉིས་བེམ་པོའི་རྩར་ཀྲོང་ངེར་ལངས་བསྡད་ཡོད་པ་དང་། སེང་གེས་བེམ་པོ་མ་ཟོས་ལ་བོང་བུར་གནོད་ཀྱང་མ་བསྐྱལ་བ་མཐོང་ངོ་། །"]},{"type":"verse","number":29,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་ལ་མྱ་ངན་བྱས་ཏེ་དུར་ལ་འཇུག་པའི་ཆེད་དུ་ལུང་སྟོན་པ་རྒན་པ་དེས་ཁོང་གི་བེམ་པོ་བླངས་ཏེ་བོང་བུ་ལ་བཀལ་ནས་གྲོང་ཁྱེར་དུ་ཁྱེར་བའོ། །"]},{"type":"verse","number":30,"content":["ལུང་སྟོན་པ་རྒན་པ་དེས་ཁོང་གི་བེམ་པོ་རང་གི་དུར་ཁུང་དུ་བཞག་པ་དང་། མི་རྣམས་ཀྱིས་ངེད་ཅག་གི་སྤུན། ཀྱེ་ཧུད་ཅེས་སྨྲས་ཤིང་། ཁོང་གི་ཆེད་དུ་མྱ་ངན་བྱས་སོ། །"]},{"type":"verse","number":31,"content":["ཁོང་དུར་ལ་སྦས་རྗེས་ལུང་སྟོན་པ་རྒན་པས་རང་གི་བུ་རྣམས་ལ། ང་ཚེ་ལས་འདས་པའི་ཚེ་ཁྱོད་ཅག་གིས་ང་རང་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེའི་དུར་ཁུང་ལ་སྦོས་ཤིག ངའི་རུས་པ་རྣམས་ཀྱང་ཁོང་གི་རུས་པའི་རྩར་ཞོག་ཅིག"]},{"type":"verse","number":32,"content":["ཅིའི་ཕྱིར་ཞེ་ན། པེད་ཨེལ་ཡུལ་གྱི་མཆོད་ཁྲི་དང་། སཱ་མར་ཡ་ཡུལ་གྱི་གྲོང་ཁྱེར་ཐམས་ཅད་དུ་ཡོད་པའི་མཐོ་གླིང་སྟེང་གི་མཆོད་ཁང་རྣམས་ལ་ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལྟར་གཏམ་བསྒྲགས་པ་བཞིན་ངེས་པར་འབྱུང་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":33,"content":["དོན་དེའི་རྗེས་སུ་ཡེ་རོབ་ཨམ་གྱིས་རང་གི་སྤྱོད་པ་ངན་པའི་ལམ་མ་སྤངས་ཏེ། སླར་ཡང་སྐྱེ་བོ་ཕལ་བ་རྣམས་མཐོ་གླིང་གི་མཆོད་དཔོན་དུ་བསྐོས་ཤིང་། འདོད་མོས་ཅན་རྣམས་ཁོས་དམ་པར་བྱས་ནས་མཐོ་གླིང་གི་མཆོད་དཔོན་དུ་བསྐོས་སོ། །"]},{"type":"verse","number":34,"content":["དོན་དེ་ནི་ཡེ་རོབ་ཨམ་ཁྱིམ་རྒྱུད་ཀྱི་སྡིག་པའི་རྒྱུ་རུ་གྱུར་ནས། དེ་དག་ནི་ས་སྟེང་ནས་མེད་པ་དང་སྟོང་པར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":18,"caller":"+","text":"ཡོ་ཤི་ཡཱ་ཞེས་བྱ་བ་ནི་དཱ་བིད་ཀྱི་རྒྱལ་རྒྱུད་ལས་ཡ་ཧུ་དཱ་ཡུལ་གྱི་རྒྱལ་པོ་ཡིན་ཏེ། ཁོ་ནི་སྤྱི་ལོའི་སྔོན་གྱི་640ལོར་སྐྱེས་པ་རེད། རྒྱལ་པོ་ཡོ་ཤི་ཡཱའི་ལོ་རྒྱུས་ནི་རྒྱལ་རབས་གཉིས་པའི་ལེའུ་ཉེར་གཉིས་དང་ཉེར་གསུམ། སྔོན་རབས་གཉིས་པའི་ལེའུ་སོ་བཞི་དང་སོ་ལྔ་བཅས་སུ་བཀོད་ཡོད་པས་དེར་གཟིགས་རོགས།","reference":{"chapter":13,"verse":2}},{"noteId":19,"caller":"+","text":"རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་ཡིས་ཡེ་རོབ་ཨམ་གྱིས་བརྩིགས་པའི་མཆོད་ཁྲི་འགས་གཏོར་བྱས་པའི་ལོ་རྒྱུས་ནི་རྒྱལ་རབས་གཉིས་པའི་ལེའུ་ཉེར་གསུམ་པའི་ཚིག་རྐང་བཅོ་ལྔ་དང་བཅུ་དྲུག་པ་བཅས་སུ་བཀོད་ཡོད།","reference":{"chapter":13,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/1KI/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/12.json","previousChapterAudioLinks":{},"numberOfVerses":34}