{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":14,"content":[{"type":"heading","content":["ལུང་སྟོན་པ་ཨ་ཧི་ཡཱ་ཡིས་ཡེ་རོབ་ཨམ་ལ་ལུང་བསྟན་པ།"]},{"type":"verse","number":1,"content":["སྐབས་དེར་ཡེ་རོབ་ཨམ་གྱི་བུ་ཨ་བི་ཡཱ་ཞེས་པ་ན་བར་གྱུར་པ་དང་།"]},{"type":"verse","number":2,"content":["ཡེ་རོབ་ཨམ་གྱིས་རང་གི་ཆུང་མ་ལ་ཡར་ལོངས་ཤིག ཁྱོད་ཡེ་རོབ་ཨམ་གྱི་ཆུང་མ་ཡིན་པ་གཞན་ལ་ཤེས་སུ་མི་འཇུག་པའི་ཕྱིར་དུ། རང་གི་གྱོན་ཆས་བསྒྱུར་ཏེ་ཞི་ལོ་གྲོང་ཁྱེར་དུ་སོང་དང་། དེ་རུ་ང་ལ་ཁྱོད་ནི་མི་འདི་རྣམས་ཀྱི་རྒྱལ་པོར་འགྱུར་རོ་ཞེས་གསུངས་པའི་ལུང་སྟོན་པ་ཨ་ཧི་ཡཱ་ཡོད་དེ།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱིས་བག་ལེབ་བཅུ་དང་། སྣུམ་འཁུར་འགའ་རེ་དང་། སྦྲང་རྩི་བུམ་པ་གང་བཅས་ཁྱེར་ཏེ་ཁོའི་མདུན་དུ་སོང་དང་། ཁོས་ཕྲུ་གུ་ལ་ཅི་འབྱུང་བར་འགྱུར་བ་དེ་ཁྱོད་ལ་འཆད་པར་འགྱུར་རོ་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":4,"content":["ཡེ་རོབ་ཨམ་གྱི་ཆུང་མས་དེ་བཞིན་བྱས་ཏེ་ཞི་ལོ་རུ་སོང་བ་དང་། ཨ་ཧི་ཡཱའི་ཁྱིམ་དུ་སླེབས་པ་རེད། ཨ་ཧི་ཡཱ་ནི་ལོ་ན་རྒས་པའི་རྐྱེན་གྱིས་མིག་གིས་མཐོང་བར་མ་ནུས།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་ཧི་ཡཱ་ལ་འདི་སྐད་དུ། ཡེ་རོབ་ཨམ་གྱི་ཆུང་མ་རང་གི་བུ་ལ་བྱུང་བའི་ནད་དེའི་ཆེད་དུ་དོན་ཞིག་འདྲི་བར་ཁྱོད་ཀྱི་རྩར་འོང་གིན་འདུག ཁྱོད་ཀྱིས་མོ་ལ་འདི་བཞིན་དེ་བཞིན་སྨྲོས་ཤིག ཅི་ལ་ཞེ་ན། ཁོ་མོ་ནང་དུ་སླེབས་ཚེ་བུད་མེད་གཞན་ཞིག་ཏུ་བརྫུས་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཨ་ཧི་ཡཱས་མོ་སྒོ་འགྲམ་དུ་སླེབས་པའི་གོམ་སྒྲ་ཐོས་པ་ན། ཁོ་ན་རེ། ཡེ་རོབ་ཨམ་གྱི་ཆུང་མ་ནང་དུ་ཤོག་ཅིག ཁྱོད་རང་གཞན་ཞིག་ལ་བརྫུས་དོན་ཅི་ཡིན་ནམ། ང་ཁྱོད་ལ་གཏམ་ངན་ཞིག་སྒྲོག་ཏུ་མངགས་པ་ཡིན།"]},{"type":"verse","number":7,"content":["ད་ནི་སོང་ལ་ཡེ་རོབ་ཨམ་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། བདག་གིས་ཁྱོད་རང་མི་རྣམས་ཀྱི་ཁྲོད་ནས་ཡར་འཐེན་ཏེ། བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":8,"content":["དཱ་བིད་ཀྱི་རྒྱུད་ལས་རྒྱལ་སྲིད་བླངས་ནས་ཁྱོད་ལ་སྤྲད་ནའང་། ཁྱོད་ནི་བདག་གི་ཞབས་ཕྱི་དཱ་བིད་དང་འདྲ་བར་གྱུར་མ་སོང་། ཁོས་བདག་གི་བཀའ་རྒྱ་རྣམས་བསྲུངས་པ་དང་། རྩེ་གཅིག་གིས་ངའི་རྗེས་སུ་འབྲངས་ཤིང་། བདག་གི་མིག་ལམ་དུ་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་ཁྱོད་ཀྱིས་རང་གི་སྔོན་མ་ཐམས་ཅད་ལས་ཀྱང་ལྷག་པར་ལོག་སྤྱོད་བྱས་ཤིང་། ཡང་གཞན་པའི་ལྷ་དང་བླུགས་སྐུ་རྣམས་བཟོས་ཏེ་བདག་ལ་ཁོང་ཁྲོ་བསླངས་པ་དང་བདག་ནི་རྒྱབ་ཏུ་གཡུགས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་བས་ན། ལྟོས་དང་། བདག་གིས་ཡེ་རོབ་ཨམ་གྱི་ཁྱིམ་རྒྱུད་ལ་ཆག་སྒོ་འབེབ་བོ། །ཡེ་རོབ་ཨམ་གྱི་ཁྱིམ་རྒྱུད་ལས་སྐྱེས་པ་",{"noteId":20},"ཐམས་ཅད་དེ། ཡེས་ར་ཨེལ་དུ་རང་དབང་ཅན་ནམ་ཡང་ན་རང་དབང་མེད་པ་གང་ཡིན་ཡང་ཚང་མ་ཚར་གཅོད་བྱ་ཞིང་ཐམས་ཅད་རྩ་མེད་འགྲོ་བའི་བར་དུ། ཡེ་རོབ་ཨམ་གྱི་ཁྱིམ་རྒྱུད་ལྷག་མ་རྣམས་ཀྱང་ལྕི་བ་ལྟར་ཕྱག་པར་བྱའོ། །"]},{"type":"verse","number":11,"content":["ཡེ་རོབ་ཨམ་ལ་གཏོགས་པའི་མི་རྣམས་ལས་གྲོང་ཁྱེར་དུ་ཤི་བ་རྣམས་ནི་ཁྱིས་འཆའ་བ་དང་། ས་སྟོང་དུ་ཤི་བ་རྣམས་ནི་ནམ་མཁའི་བྱ་ཡིས་བཟའ་བར་འགྱུར་རོ། །ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལྟར་གསུངས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":12,"content":["དེ་བས་ཁྱོད་རང་ཡར་ལོངས་ལ་རང་གི་ཁྱིམ་དུ་སོང་ཞིག ཁྱོད་ཀྱི་རྐང་པ་གྲོང་ཁྱེར་གྱི་ནང་དུ་སྤོས་པ་ཙམ་དུ་བུ་ནི་འཆི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ཡང་ཡེས་ར་ཨེལ་ཐམས་ཅད་ཀྱིས་ཁོའི་ཆེད་དུ་མྱ་ངན་བྱེད་ཅིང་ཁོ་དུར་ལ་སྦ་བར་བྱེད་པ་དང་། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ། ཡེ་རོབ་ཨམ་གྱི་ཁྱིམ་ལས་ཁོ་འབའ་ཞིག་གི་ནང་དུ་བཟང་པོ་རྙེད་པས། ཡེ་རོབ་ཨམ་ལ་གཏོགས་པའི་མི་རྣམས་ལས་ཁོ་རང་གཅིག་པུ་དུར་ལ་སྦ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཕྱིར་དུ་ཡེས་ར་ཨེལ་ལ་རྒྱལ་པོ་ཞིག་བསྐོ་བར་བྱ་སྟེ། ཁོས་ཉིན་མོ་དེར་ཡེ་རོབ་ཨམ་གྱི་རིགས་རྒྱུད་མེད་པར་གཏོང་བར་བྱ་",{"noteId":21},"ཞིང་། དུས་དེ་ནི་དེ་རིང་ངམ་ད་ལྟ་ཉིད་དུའོ། །"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བརྡེགས་ནས་ཁོ་རྣམས་ནི་འདམ་རྩྭ་ཆུའི་ནང་དུ་གཡོ་བ་བཞིན་གཡོ་བར་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་ཕ་མེས་ལ་གནང་བའི་ཡུལ་ཁམས་ཡིད་དུ་འོང་བ་འདི་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་རྩ་ནས་བཏོན་ཏེ། ཕི་རཱད་ཆུ་བོའི་ཕ་རོལ་ཏུ་གཏོར་བར་བྱའོ། །ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གིས་ལྷ་མོ་ཨ་ཤེ་རཱ་ཡི་སྐུ་བཟོས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":16,"content":["ཡེ་རོབ་ཨམ་རང་གིས་བྱས་པའི་སྡིག་པ་དང་། ཁོས་ཡེས་ར་ཨེལ་ལ་བྱེད་དུ་བཅུག་པའི་སྡིག་པ་ཡི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་སྤང་བར་བྱའོ་ཞེས་སྦྲན་ཏོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་ཡེ་རོབ་ཨམ་གྱི་ཆུང་མ་ཡར་ལངས་ནས་ཕྱིར་ཐིར་ཙ་རུ་ཕྱིན་ཏེ་ཁྱིམ་གྱི་སྒོ་ཐེམ་ལ་སླེབས་མ་ཐག་ཏུ་བུ་དེ་ཤིའོ། །"]},{"type":"verse","number":18,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞབས་ཕྱི་སྟེ་ལུང་སྟོན་པ་ཨ་ཧི་ཡཱ་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་བཞིན་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ཀྱིས་ཁོ་དུར་ལ་སྦས་ཤིང་ཁོའི་དོན་དུ་མྱ་ངན་བྱས་སོ། །"]},{"type":"verse","number":19,"content":["ཡང་ཡེ་རོབ་ཨམ་གྱི་བྱས་རྗེས་གཞན་རྣམས་དང་། ཁོས་ཇི་ལྟར་དམག་བརྒྱབ་ནས་སྲིད་བསྐྱངས་པ་བཅས་ནི། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་རབས་ཀྱི་མདོ་ལ་བཀོད་ཡོད་པ་དང་།"]},{"type":"verse","number":20,"content":["ཡེ་རོབ་ཨམ་གྱིས་ལོ་ཉེར་གཉིས་ཀྱི་རིང་ལ་སྲིད་བསྐྱངས་པ་དང་། དེ་ནས་ཁོ་ནི་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་ཤིང་། ཁོའི་བུ་ནཱ་དབ་ཀྱིས་དེའི་ཚབ་ཏུ་སྲིད་བསྐྱངས་པའོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རེ་ཧབ་ཨམ།"]},{"type":"verse","number":21,"content":["ཡང་སོ་ལོ་མོན་གྱི་སྲས་རེ་ཧབ་ཨམ་གྱིས་ཡ་ཧུ་དཱ་ཡུལ་ལ་སྲིད་བྱས་པ་དང་། ཁོ་རང་རྒྱལ་པོར་སྡོད་དུས་ལོ་ཞེ་གཅིག་ཡིན། རེ་ཧབ་ཨམ་གྱིས་ལོ་བཅུ་བདུན་གྱི་རིང་ལ་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་དུ་སྲིད་བསྐྱངས་ཤིང་། ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཉིད་ཀྱི་མཚན་འཇོག་པའི་ཕྱིར་དུ་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཀུན་ལས་བདམས་པ་ཡིན། རེ་ཧབ་ཨམ་གྱི་མ་ནི་ཨམ་མོན་པ་ཡིན་ཞིང་མིང་ལ་ནཱ་མཱ་ཞེས་བྱའོ། །"]},{"type":"verse","number":22,"content":["ཡ་ཧུ་དཱ་པས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་ཅིང་། དེ་དག་གིས་སྡིག་ཉེས་བསགས་ཏེ་རང་གི་ཕ་མེས་ལས་ཀྱང་ལྷག་པར་ཁོང་གི་ཕྲག་དོག་དང་ཐུགས་ཁྲོ་བསྐྱེད་དོ། །"]},{"type":"verse","number":23,"content":["དེ་དག་གིས་རང་གི་ཕྱིར་དུ་མཐོ་གླིང་རེ་རེའི་སྟེང་དང་། ལྗོན་ཤིང་རེ་རེའི་འོག་ཏུ་མཆོད་ཁྲི་རྣམས་བརྩིགས་ཤིང་། རྡོ་སྐུ་དང་ལྷ་མོ་ཨ་ཤེ་རཱའི་སྐུ་རྣམས་བཞེངས་པ་དང་།"]},{"type":"verse","number":24,"content":["རྒྱལ་ཁམས་ནང་རོལ་དུ་མཆོད་གཤོམ་གྱི་ཆོས་རྫུ་གཞང་འཚོང་ཡང་ཡོད་དེ། སྔར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་ནས་བཏོན་པའི་མི་རིགས་གཞན་པས་ཅི་བྱས་པ་བཞིན་དུ་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་སྐྱུག་བྲོ་བའི་ལས་བྱས་སོ། །"]},{"type":"verse","number":25,"content":["རྒྱལ་པོ་རེ་ཧབ་ཨམ་གྱི་སྲིད་ལོ་ལྔ་པར། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཤི་ཤག་གིས་ཡེ་རུ་སཱ་ལེམ་དུ་དམག་དྲངས་པ་དང་།"]},{"type":"verse","number":26,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་དཀོར་མཛོད་དང་། རྒྱལ་པོའི་ཕོ་བྲང་གི་གཏེར་མཛོད་རྣམས་བཅོམ་སྟེ་གང་ཡོད་པ་ཐམས་ཅད་ཁྱེར་བ་དང་། སོ་ལོ་མོན་གྱིས་བཟོས་པའི་གསེར་གྱི་ཕུབ་རྣམས་ཀྱང་ཕྲོགས་ནས་ཁྱེར་བས།"]},{"type":"verse","number":27,"content":["རེ་ཧབ་ཨམ་གྱིས་གསེར་ཕུབ་ཀྱི་ཚབ་ཏུ་ལི་ཡི་ཕུབ་བཟོས་ནས། རྒྱལ་པོའི་ཕོ་བྲང་གི་སྐུ་སྲུང་དཔོན་པོ་རྣམས་ཀྱི་ལག་ཏུ་བཅོལ།"]},{"type":"verse","number":28,"content":["ཐེངས་རེར་རྒྱལ་པོ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འགྲོ་དུས་སུ། སྐུ་སྲུང་པ་རྣམས་འོངས་ནས་ཕུབ་དེ་དག་ཁྱེར་ཅིང་། ཕྱིས་སུ་སླར་སྐུ་སྲུང་པའི་ཁང་པར་འཇོག་པ་ཡིན།"]},{"type":"verse","number":29,"content":["རེ་ཧབ་ཨམ་གྱི་བྱས་རྗེས་གཞན་རྣམས་དང་། ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་རྒྱལ་རབས་ཀྱི་མདོ་ལ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":30,"content":["རེ་ཧབ་ཨམ་དང་ཡེ་རོབ་ཨམ་གཉིས་ཀྱི་བར་ལ་ནམ་རྒྱུན་དམག་འཁྲུག་བྱུང་བ་དང་།"]},{"type":"verse","number":31,"content":["རེ་ཧབ་ཨམ་ནི་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་ནས་དཱ་བིད་གྲོང་ཁྱེར་དུ་རང་གི་ཕ་མེས་རྣམས་ཀྱི་ཁྲོད་དུ་དུར་ལ་སྦས་པ་དང་། ཁོའི་མ་ནི་ཨམ་མོན་པ་ཡིན་ལ་མིང་དུ་ནཱ་མཱ་ཞེས་ཟེར། ཁོའི་བུ་ཨ་བི་ཡཱས་",{"noteId":22},"ཁོའི་ཚབ་ཏུ་རྒྱལ་སྲིད་བཟུང་ངོ་། །"]}],"footnotes":[{"noteId":20,"caller":"+","text":"འདིར་སྐྱེས་པ་ཞེས་པ་ནི་མ་ཕྱི་ལས་མཁར་ངོས་སུ་གཅིན་པ་གཏོང་མཁན་ཞེས་མཐོང་ལ། དོན་གྱིས་སྐྱེས་པ་ཡིན་པས་དོན་སྒྱུར་བྱས་པ་ཡིན།","reference":{"chapter":14,"verse":10}},{"noteId":21,"caller":"+","text":"ལུང་བསྟན་དེ་གྲུབ་པའི་སྐོར་ནི་ལེའུ་བཅོ་ལྔ་པའི་ཚིག་རྐང་ཉེར་བདུན་པ་ནས་ཉེར་དགུ་པའི་བར་དུ་བཀོད་ཡོད་པས་དེར་གཟིགས་རོགས།","reference":{"chapter":14,"verse":14}},{"noteId":22,"caller":"+","text":"འདིར་ཨ་བི་ཡཱ་ཞེས་པར་འགྱུར་ཁ་ཤས་སུ་ཨ་བི་ཡཱམ་ཞེས་ཀྱང་མཐོང་། དེ་ནི་ཨ་བི་ཡཱ་ཞེས་པའི་མིང་གཞན་ཡིན།","reference":{"chapter":14,"verse":31}}]},"thisChapterLink":"/api/bod_ntb/1KI/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/13.json","previousChapterAudioLinks":{},"numberOfVerses":31}