{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":17,"content":[{"type":"heading","content":["ཨེ་ལི་ཡཱས་ཐན་པ་འབྱུང་བའི་ལུང་བསྟན་གནང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཐི་ཞི་པ་ཨེ་ལི་ཡཱ་སྟེ། གིལ་ཨད་ཡུལ་གྱི་ཐི་ཞི་ནས་འོངས་པའི་ཨེ་ལི་ཡཱ་བྱ་བས་ཨ་ཧབ་ལ། ངས་རང་གིས་ཞབས་ཏོག་སྒྲུབ་པའི་ཡེས་ར་ཨེལ་གྱི་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། ངས་གསོལ་བ་བཏབ་པ་མིན་ན་ལོ་འདི་དག་གི་ནང་དུ་ཟིལ་བའམ་ཆར་བ་གང་ཡང་འབབ་པར་མི་འགྱུར་རོ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":2,"content":["དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བབས་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":3,"content":["ཁྱོད་རང་འདི་ནས་ཤར་ཕྱོགས་སུ་སོང་ལ། ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་སུ་ཡོད་པའི་ཀེ་རིད་ཆུ་བོའི་འགྲམ་ལ་ཡིབ་ནས་སྡོད་ཅིག"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་ཆུ་བོ་དེ་ལས་ཆུ་འཐུང་བར་འགྱུར་ཞིང་བདག་གིས་ཕོ་རོག་རྣམས་ལ་ཁྱོད་ལ་ཁ་ཟས་སྟེར་བའི་བཀའ་བསྒོས་ཡོད་ཅེས་གསུངས་པས།"]},{"type":"verse","number":5,"content":["ཨེ་ལི་ཡཱ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་ཆས་ཏེ། ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་སུ་ཡོད་པའི་ཀེ་རིད་ཆུ་བོའི་འགྲམ་དུ་སོང་ནས་བསྡད་དོ། །"]},{"type":"verse","number":6,"content":["ཕོ་རོག་རྣམས་ཀྱིས་ཞོགས་པ་ཁོང་ལ་བག་ལེབ་དང་ཤ་དྲངས་ཤིང་དགོང་མོ་ཡང་བག་ལེབ་དང་ཤ་དྲངས་པ་དང་། ཁོང་གིས་ཀྱང་ཆུ་བོ་དེའི་ཆུ་འཐུང་བའོ། །"]},{"type":"heading","content":["སཱ་རེ་ཕད་གྲོང་རྡལ་གྱི་ཡུགས་མོ་ཞིག"]},{"type":"verse","number":7,"content":["ཡང་ཡུལ་དེར་ཆར་མ་བབས་པས། དུས་ཡུན་ངེས་ཅན་ཞིག་གི་རྗེས་སུ་ཆུ་བོ་དེ་བསྐམས་པ་དང་།"]},{"type":"verse","number":8,"content":["ཨེ་ལི་ཡཱ་ལ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བབས་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":9,"content":["ཁྱོད་ཡར་ལོངས་ལ། ཚི་ཏུན་ཡུལ་གྱི་སཱ་རེ་ཕད་དུ་སོང་ནས་དེར་སྡོད་ཅིག དེ་རུ་ཁྱོད་ལ་འཚོ་བ་སྦྱོར་བའི་ཕྱིར་བདག་གིས་ཡུགས་མོ་ཞིག་ལ་བཀའ་བསྒོས་ཡོད་ཅེས་གསུངས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཁོང་ཡར་ལངས་ཏེ་སཱ་རེ་ཕད་དུ་ཕྱིན་ཅིང་མཁར་སྒོ་རུ་སླེབས་པའི་ཚེ། ཡུགས་མོ་ཞིག་གིས་དེ་རུ་བུད་ཤིང་བཏུ་བཞིན་ཡོད་པ་དང་། ཁོང་གིས་མོ་བོས་ནས། ཁྱོད་ཀྱིས་སྣོད་ཅིག་གི་ནང་དུ་ང་ལ་ཆུ་ཅུང་ཟད་ཁུར་འོང་རོགས་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":11,"content":["ཁོ་མོ་ཕར་དེ་ལེན་དུ་སོང་བ་ན། ཁོང་གིས་ཡང་མོ་བོས་ནས། ང་ལ་བག་ལེབ་དུམ་བུ་ཞིག་ཀྱང་ཁྱེར་འོང་རོགས་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":12,"content":["མོས་ཁོང་ལ། ངས་ཁྱེད་ཀྱི་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན། ང་ལ་བག་ལེབ་ནི་མེད། རྫ་མའི་ནང་དུ་ཕྱེ་སྤར་བ་གང་དང་། སྣོད་ཀྱི་ནང་དུ་སྣུམ་ཅུང་ཟད་ཙམ་ལས་མེད་དོ། །གཟིགས་དང་། ངས་བུད་ཤིང་རེ་གཉིས་ཙམ་བཏུས་ཏེ་ཁྱིམ་དུ་སོང་ནས་ང་དང་ངའི་བུ་ལ་ཁ་ཟས་གཡོས་ནས། དེ་ཟོས་རྗེས་འཆི་བར་སྒུག་པ་ཡིན་ཞེས་ཞུས།"]},{"type":"verse","number":13,"content":["དེར་ཨེ་ལི་ཡཱས་བུད་མེད་དེ་ལ། མ་འཇིགས་ཤིག སོང་ལ་ཁྱོད་ཀྱིས་སྨྲས་པ་བཞིན་དུ་བྱོས་ཤིག འོན་ཀྱང་ཐོག་མར་བག་ལེབ་ཆུང་ངུ་ཞིག་བསྲེགས་ནས་ང་ལ་ཁྱེར་ཤོག དེ་ནས་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་ལ་བག་ལེབ་སྲེགས་ཤིག"]},{"type":"verse","number":14,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དཀོན་མཆོག་ཡ་ཝཱེས་ས་གཞི་རུ་ཆར་བ་གནང་བའི་ཉིན་དེའི་བར་དུ། རྫ་མའི་ཕྱེ་མི་ཚར་ལ། སྣོད་ཀྱི་སྣུམ་ཡང་རྫོགས་པར་མི་འགྱུར་ཞེས་གསུངས་སོ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":15,"content":["ཁོ་མོ་སོང་ནས་ཨེ་ལི་ཡཱས་བསྒོས་པ་ལྟར་བྱས་ཏེ། མོ་རང་དང་། ཨེ་ལི་ཡཱ་དང་། མོའི་ནང་མི་རྣམས་ཀྱིས་ཉིན་མང་པོར་ཁ་ཟས་སྤྱད་པའོ། །"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་སྟེ་ཨེ་ལི་ཡཱའི་ངག་བརྒྱུད་ནས་གསུངས་པ་བཞིན་དུ། རྫ་མའི་ཕྱེ་ནི་མ་ཚར་ལ། སྣོད་ཀྱི་སྣུམ་ཡང་མ་རྫོགས་སོ། །"]},{"type":"verse","number":17,"content":["དེའི་རྗེས་སུ་ཁྱིམ་བདག་མ་དེའི་བུ་ལ་ནད་ཅིག་ཕོག་པ་དང་། ནད་ཇེ་སྡུག་ཏུ་སོང་ནས་ཐ་ན་དབུགས་ཀྱང་ཆད།"]},{"type":"verse","number":18,"content":["དེ་ནས་བུད་མེད་ཀྱིས་ཨེ་ལི་ཡཱ་ལ། ཀྱེ་དཀོན་མཆོག་གི་སྐྱེས་བུ་ལགས། བདག་ཁྱེད་དང་འབྲེལ་བ་ཅི་ཡོད་དམ། ཁྱེད་ནི་དཀོན་མཆོག་ལ་ངའི་སྡིག་པ་དྲན་དུ་འཇུག་པ་དང་། ངའི་བུ་གསོད་དུ་འོངས་པ་ཡིན་ནམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":19,"content":["ཨེ་ལི་ཡཱས་ཁོ་མོ་ལ། ཁྱོད་ཀྱི་བུ་ང་ལ་སྤྲོད་ཅིག་ཅེས་སྨྲས་ནས། བུ་དེ་མོའི་པང་ནས་བླངས་ཏེ་ཁོ་རང་སྡོད་སའི་ཐོག་ཁང་གི་གཟིམ་ཁང་དུ་ཁྱེར་ནས་ཪང་གི་མལ་ཁྲི་སྟེང་དུ་བཞག་པ་དང་།"]},{"type":"verse","number":20,"content":["ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་བོས་ནས། ཀྱེ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། བདག་ལ་གནས་ཚང་གཡར་བའི་ཡུགས་མོ་འདི་ལ་ཡང་ཁྱེད་ཀྱིས་བར་ཆད་གནང་སྟེ། ཁོ་མོའི་བུ་ཤི་རུ་འཇུག་པ་ཡིན་ནམ་ཞེས་གསོལ་ཞིང་།"]},{"type":"verse","number":21,"content":["དེ་ནས་ཁོང་གིས་རང་གི་ལུས་པོ་ཕྲུ་གུ་དེའི་སྟེང་དུ་ཐེངས་གསུམ་ལ་བཀབ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་བོས་ནས། ཀྱེ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཕྲུ་གུ་འདིའི་སྲོག་ཡང་བསྐྱར་ཁོ་ལ་གནང་བར་མཛོད་ཅེས་གསོལ་ཏོ། །"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ལི་ཡཱ་ཡི་གསོལ་འདེབས་ལ་གསན་པ་དང་། ཕྲུ་གུ་དེ་ལ་ཡང་བསྐྱར་སྲོག་ཐོབ་ནས་གསོན་པར་གྱུར།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཨེ་ལི་ཡཱས་ཕྲུ་གུ་དེ་ཐོག་ཁང་གི་གཟིམ་ཁང་ནས་བླངས་ཏེ། ཁྱིམ་དུ་ཁྱེར་ནས་དེའི་མ་ཡི་ལག་ཏུ་སྤྲད་པ་དང་། ཁོང་ན་རེ། ལྟོས་དང་། ཁྱོད་ཀྱི་བུ་གསོན་ནོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་བུད་མེད་ཀྱིས་ཨེ་ལི་ཡཱ་ལ། ཁྱེད་རང་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིན་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ཀྱི་ངག་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་ནི་བདེན་པ་ཡིན་པ་ངས་རྟོགས་སོ་ཞེས་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1KI/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/16.json","previousChapterAudioLinks":{},"numberOfVerses":24}