{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":2,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་སོ་ལོ་མོན་ལ་བཀའ་གནང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཱ་བིད་སྐུ་གཤེགས་ལ་ཉེ་བའི་སྐབས་སུ་རང་གི་སྲས་སོ་ལོ་མོན་ལ་བཀའ་གནང་བ་སྟེ།"]},{"type":"verse","number":2,"content":["བདག་ནི་འཇིག་རྟེན་པ་ཐམས་ཅད་ཀྱི་ལམ་དུ་འགྲོ་བས་ཁྱོད་སྟོབས་དང་ལྡན་པར་བྱས་ཏེ། རང་ཉིད་ཕོ་རབ་ཅིག་ཡིན་པ་སྟོན་ཅིག"]},{"type":"verse","number":3,"content":["རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བསྩལ་པ་བཞིན་དུ་བྱོས་དང་། ཁོང་གིས་བསྟན་པའི་ལམ་དུ་འགྲོ་བ་དང་ཁོང་གི་སྒྲིག་ཁྲིམས་དང་། བཀའ་རྒྱ། སྒྲིག་སྲོལ། དཔང་ཡིག་བཅས་མོ་ཤེའི་བཀའ་ཁྲིམས་",{"noteId":0},"ནང་དུ་བཀོད་པ་བཞིན་དུ་སྲུངས་ཤིག་དང་། དེ་ལྟར་བྱས་ན་ཁྱོད་ཀྱིས་ཅི་ཞིག་བསྒྲུབས་ནས་གང་དུ་ཕྱོགས་ནའང་དོན་ཐམས་ཅད་འགྲུབ་པ་དང་།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དཱ་བིད་བདག་ལ། གལ་ཏེ་ཁྱོད་ཀྱི་བུ་རྒྱུད་ཀྱིས་རང་གི་བགྲོད་ལམ་ལ་གཟབ་གཟབ་བྱས་ནས། བློ་གཅིག་སེམས་གཅིག་དང་གཞུང་རྒྱུད་དྲང་པོས་ངའི་ལམ་དུ་འགྲུལ་ན། ཁྱོད་ཀྱི་བུ་རྒྱུད་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲི་ལས་ནམ་ཡང་འབྲལ་བར་མི་འགྱུར་ཞེས་ཁོང་གིས་ཞལ་བཞེས་གནང་བ་དེ་འགྲུབ་པར་མཛད་ངེས་ཡིན།"]},{"type":"verse","number":5,"content":["དེར་མ་ཟད་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་ཀྱིས་ང་ལ་ཅི་བྱས་པ་ཁྱོད་ཀྱིས་ཤེས་དགོས་ཏེ། ཁོས་ཡེས་ར་ཨེལ་གྱི་དམག་དཔོན་ཏེ་ནེར་གྱི་བུ་ཨབ་ནེར་དང་། ཡེ་ཐེར་གྱི་བུ་ཨ་མ་སཱ་གཉིས་ལ་ཅི་བྱས་པ་ཁྱོད་ཀྱིས་ཤེས་དགོས། ཁོས་དེ་གཉིས་ཀ་བསད་པ་",{"noteId":1},"དང་། ཞི་འཇགས་ཀྱི་དུས་སུ་དམག་འཁྲུག་གི་སྐབས་དང་མཚུངས་པར་དེ་དག་གི་ཁྲག་བཏོན་ཏེ་ཁོའི་རྐེད་པར་བཅིངས་པའི་སྐ་རགས་དང་། རྐང་པར་གྱོན་པའི་ལྷམ་རྣམས་ལ་འཐབ་མོའི་ཁྲག་འགོས་སུ་བཅུག་པ་ཡིན།"]},{"type":"verse","number":6,"content":["དེ་བས་ཁྱོད་ཀྱིས་རང་གི་ཤེས་རབ་ཀྱི་ནུས་ཚོད་བཞིན་དུ་བྱེད་དགོས་ཤིང་ཁོ་རང་མ་རྒས་སྔོན་ལ་གཤིན་ཡུལ་དུ་རྫོངས་ཤིག"]},{"type":"verse","number":7,"content":["འོན་ཀྱང་གིལ་ཨད་ཡུལ་གྱི་པཱར་ཟིལ་ལ་ཨིའི་བུ་རྣམས་དྲིན་གྱིས་བསྐྱངས་ནས་ཁྱོད་ཀྱི་གསོལ་ལྕོག་སྟེང་ཁ་ཟས་ལ་རོལ་དུ་འཇུག་དགོས། གང་ལ་ཞེ་ན། སྔར་ཁྱོད་ཀྱི་ཕུ་བོ་ཨབ་ཤཱ་ལོམ་གྱི་རྐྱེན་གྱིས་ང་རང་ཡུལ་གྱར་དུ་ཕྱིན་སྐབས། དེ་དག་གིས་ཁ་ཟས་ཁྱེར་ནས་ང་བསུ་རུ་འོངས་",{"noteId":2},"པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":8,"content":["ཡང་ལྟོས་ཤིག པཱ་ཧུ་རིམ་གྱི་པེན་ཡཱ་མེན་པའི་གེ་རཱ་ཡི་བུ་ཤིམ་ཨི་ཞེས་བྱ་བ་ཁྱོད་དང་མཉམ་དུ་ཡོད་ལ། ང་རང་མཱ་ཧ་ནཱ་ཡིམ་དུ་འགྲོ་བའི་དུས་སུ་ཁོས་ང་ལ་འཇིགས་སུ་རུང་བའི་དམོད་མོ་བཏབ",{"noteId":3},"། འོན་ཀྱང་། ཁོ་ཡོར་དན་གཙང་པོའི་འགྲམ་དུ་ང་བསུ་བར་འོངས་པས། ངས་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་རལ་གྲིས་ཁྱོད་གསོད་པར་མི་བྱའོ་ཞེས་",{"noteId":4},"མནའ་བསྐྱལ་བ་ཡིན་མོད།"]},{"type":"verse","number":9,"content":["ད་ནི་ཁྱོད་རང་མི་བློ་གྲོས་ཅན་ཡིན་པས། ཁོ་ལ་ཉེས་པ་མེད་པར་མ་སེམས་ཤིག ཁོ་ལ་ཅི་ལྟར་བྱེད་དགོས་པ་ཁྱོད་ཀྱིས་ཤེས་ཏེ། ཁོ་མགོ་དཀར་པོར་ཁྲག་བཞུར་བཞིན་གཤིན་ཡུལ་དུ་སྐྱོལ་ཅིག་ཅེས་བསྐུལ་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་དཱ་བིད་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་པ་དང་། དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་དུར་ལ་སྦས།"]},{"type":"verse","number":11,"content":["དཱ་བིད་ལོ་ངོ་བཞི་བཅུའི་རིང་ལ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བཞུགས་པ་སྟེ། ཧེབ་རོན་ཡུལ་དུ་ལོ་བདུན་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་སུམ་ཅུ་སོ་གསུམ་ལ་སྲིད་བསྐྱངས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་སོ་ལོ་མོན་རང་གི་ཡབ་དཱ་བིད་ཀྱི་རྒྱལ་ཁྲིར་བཞུགས་ཤིང་། དེའི་རྒྱལ་སྲིད་རབ་ཏུ་བརྟན་པར་གྱུར་ཏོ། །"]},{"type":"heading","content":["རྒྱལ་སྲིད་སོ་ལོ་མོན་ལ་དབང་བར་གྱུར་པ།"]},{"type":"verse","number":13,"content":["ཡང་ཧག་གིད་ཀྱི་བུ་ཨ་དོ་ནེ་ཡཱ་ནི། སོ་ལོ་མོན་གྱི་མ་ཡུམ་པད་ཤེ་བཱའི་དྲུང་དུ་འོངས་པ་དང་། མོས་དེ་ལ། ཁྱོད་རང་བདེ་བར་འོང་ངམ་ཞེས་དྲིས་པའི་ལན་དུ་ཁོས། ཡིན་ལགས། བདེ་བར་འོང་ངོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་ཁོས། ང་ཁྱེད་ལ་ཞུ་རྒྱུ་ཞིག་ཡོད་ཅེས་སྨྲས་པ་ན། མོས་ཁྱོད་ཀྱིས་སྨྲོས་ཤིག་ཅེས་ཟེར་རོ། །"]},{"type":"verse","number":15,"content":["དེར་ཁོ་ན་རེ། རྒྱལ་སྲིད་ནི་ངའི་ཡིན་པ་དང་། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ང་རང་རྒྱལ་པོར་སྡོད་པའི་རེ་བ་བཅངས་པ་ཁྱེད་ཀྱིས་མཁྱེན་ནོ། །འོན་ཀྱང་རྒྱལ་སྲིད་ནི་དེ་ལས་ལྡོག་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དགོངས་བཞིན་དུ་ངའི་ནུ་བོར་དབང་ངོ་། །"]},{"type":"verse","number":16,"content":["ད་ལྟ་ང་ཁྱེད་ལ་ཞུ་བ་ཞིག་འབུལ་རྒྱུ་ཡོད་པས་ཁྱེད་ཀྱིས་མིན་མི་གསུང་རོགས་ཞེས་ཞུས་པ་ན། ཁོ་མོས་སྨྲོས་ཤིག་ཅེས་པའི་ལན་དུ།"]},{"type":"verse","number":17,"content":["ཁོ་ན་རེ། རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཁྱེད་ལ་མིན་མི་གསུང་བས། ཁྱེད་ཀྱིས་ཁོང་ལ་ཤུ་ནེམ་གྱི་ཨ་བི་ཤག་ང་ལ་བག་མར་གནང་བའི་ཞུ་བ་འབུལ་བར་ཐུགས་རྗེས་གཟིགས་ཞེས་ཞུས་པ་ན།"]},{"type":"verse","number":18,"content":["པད་ཤེ་བཱས་ཁོ་ལ། ལེགས་སོ། །ངས་ཁྱོད་ཀྱི་དོན་དུ་རྒྱལ་པོར་ཞུ་བར་བྱའོ་ཞེས་སྨྲས།"]},{"type":"verse","number":19,"content":["དེ་ནས་པད་ཤེ་བཱ་ནི་ཨ་དོ་ནེ་ཡཱའི་ཆེད་དུ་ཞུ་བ་འབུལ་བར་རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་དྲུང་དུ་ཕྱིན་པ་དང་། རྒྱལ་པོས་ཁོ་མོ་བསུ་བར་བཞེངས་ཏེ་དབུ་བསྒུར་བསྒུར་བྱས་ནས་སླར་ཡང་རྒྱལ་ཁྲིར་བཞུགས་ཤིང་། ཡང་རང་གི་ཡུམ་གྱི་ཕྱིར་བཞུགས་ཁྲི་ཞིག་འཇོག་ཏུ་བཅུག་ནས། ཁོ་མོ་ཁོང་གི་གཡས་སུ་བསྡད་པ་དང་།"]},{"type":"verse","number":20,"content":["ཁོ་མོ་ན་རེ། ང་ཁྱེད་ལ་ཞུ་བ་ཆུང་ངུ་ཞིག་འབུལ་རྒྱུ་ཡོད་དེ། ཁྱེད་ཀྱིས་ང་ལ་མིན་མ་གསུང་རོགས་ཞེས་ཞུས་པར། རྒྱལ་པོས་ཁོ་མོར་ངའི་ཡུམ་གྱིས་གསུང་བར་མཛོད། ངས་ཁྱེད་ལ་མིན་མི་ཟེར་ཞུས་པས།"]},{"type":"verse","number":21,"content":["ཁོ་མོ་ན་རེ། ཁྱེད་ཀྱི་ཕུ་བོ་ཨ་དོ་ནེ་ཡཱ་ལ་ཤུ་ནེམ་གྱི་ཨ་བི་ཤག་བག་མར་གནོངས་ཤིག་ཅེས་ཞུས་པས།"]},{"type":"verse","number":22,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་རང་གི་ཡུམ་ལ་ལན་དུ། ཁྱེད་ཀྱིས་ཨ་དོ་ནེ་ཡཱའི་དོན་དུ་ཤུ་ནེམ་གྱི་ཨ་བི་ཤག་ཞུ་བ་དེ་ཅི་ཡིན་ནམ། ཁོ་ངའི་ཕུ་བོ་ཡིན་ལ། མཆོད་དཔོན་ཨབ་ཡཱ་ཐར་དང་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་གཉིས་ཀྱང་ཁོའི་ཕྱོགས་སུ་ཡོད་པས་ཁྱེད་ཀྱིས་ཁོའི་དོན་དུ་རྒྱལ་སྲིད་ཀྱང་ཞུས་ཆོག་གོ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":23,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་འདི་ལྟར། གལ་ཏེ་ཨ་དོ་ནེ་ཡཱས་གཏམ་དེ་སྨྲས་པའི་རྐྱེན་གྱིས་རང་སྲོག་འཆོར་བ་མིན་ཚེ། དཀོན་མཆོག་གིས་བདག་ལ་འདིའམ་འདི་ལས་ལྷག་པ་ཞིག་མཛད་པར་ཤོག"]},{"type":"verse","number":24,"content":["ད་ནི་ངས་རང་གི་རྒྱལ་སྲིད་བརྟན་པོར་འཛུག་མཁན་དང་། ང་རང་ཡབ་དཱ་བིད་ཀྱི་ཁྲི་ལ་བསྐོ་མཁན་དང་། ཞལ་བཞེས་བཞིན་དུ་ང་ལ་རྒྱལ་རབས་གནང་མཁན་གྱི་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཏེ། དེ་རིང་གི་ཉིན་མོར་ཨ་དོ་ནེ་ཡཱ་སྲོག་དང་འབྲལ་བར་འགྱུར་རོ་ཞེས་མནའ་བསྐྱལ་ཞིང་།"]},{"type":"verse","number":25,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཡེ་ཧོ་ཡ་དཱའི་བུ་པེ་ནཱ་ཡ་མངགས་པ་དང་དེས་ཨ་དོ་ནེ་ཡཱ་བཀྲོངས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་རྒྱལ་པོས་མཆོད་དཔོན་ཨབ་ཡཱ་ཐར་ལ། ཁྱོད་རང་ཨ་ན་ཐོད་དུ་ཡོད་པའི་རང་གི་གཞིས་གར་སོང་ཞིག ཁྱོད་ནི་གསོད་འོས་པ་ཡིན་མོད། འོན་ཀྱང་ཁྱོད་ཀྱིས་ངའི་ཡབ་དཱ་བིད་ཀྱི་དྲུང་དུ་གཙོ་བོ་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཁུར་མྱོང་སྟེ། ཡང་ངའི་ཡབ་དང་ལྷན་ཅིག་ཏུ་སྡུག་བསྔལ་ཐམས་ཅད་མྱངས་པས་དེ་རིང་ངས་ཁྱོད་མི་གསོད་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":27,"content":["སོ་ལོ་མོན་ཀྱིས་ཨབ་ཡཱ་ཐར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་དཔོན་མི་བྱེད་པའི་ཕྱིར་བསྐྲད་དོ། །གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཞི་ལོ་རུ་ཨེ་ལིའི་ཁྱིམ་རྒྱུད་ཀྱི་ཕྱིར་གསུངས་པའི་བཀའ་དེ་འགྲུབ་པའི་ཕྱིར་རོ། །",{"noteId":5}]},{"type":"verse","number":28,"content":["སྐད་ཆ་དེ་ཡོ་ཨབ་ཀྱིས་ཐོས་ནས། ཁོ་རང་དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་ཏུ་བྲོས་ཏེ། མཆོད་ཁྲིའི་རུ་ཐུར་རྣམས་ལ་འཐམས་ནས་བསྡད་དོ། །ཡོ་ཨབ་ནི་ཨབ་ཤཱ་ལོམ་",{"noteId":6},"གྱི་ཕྱོགས་མ་བྱས་ཀྱང་། ཨ་དོ་ནེ་ཡཱ་ཡི་ཕྱོགས་བྱས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["དེ་ནས་རྒྱལ་པོ་སོ་ལོ་མོན་ལ། ཡོ་ཨབ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་ཏུ་བྲོས་ནས་མཆོད་ཁྲིའི་མདུན་ལོགས་སུ་འདུག་ཅེས་ཞུས་པས། སོ་ལོ་མོན་གྱིས་ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡ་ལ། ཁྱོད་སོང་ནས་ཁོ་སོད་ཅིག་ཅེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":30,"content":["དེ་བས་པེ་ནཱ་ཡ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་ཏུ་སོང་ནས་ཡོ་ཨབ་ལ། རྒྱལ་པོས་ཕྱི་རུ་ཐོན་ཤོག་གསུངས་ཞེས་སྨྲས་པར། ཁོས་མིན། ང་རང་འདིར་འཆི་དགོས་ཞེས་སྨྲས་པས། པེ་ནཱ་ཡས་ཕྱིར་ལོག་ནས་རྒྱལ་པོ་ལ། ཡོ་ཨབ་ཀྱིས་ང་ལ་འདི་ལྟར་ལན་བཏབ་བོ་ཞེས་ཞུས་པ་ན།"]},{"type":"verse","number":31,"content":["རྒྱལ་པོས་དེ་ལ། ཁོས་སྨྲས་པ་བཞིན་དུ་གྱིས་ཤིག ཁོ་བསད་དེ་དུར་དུ་སྦས་ཤིག དེ་ལྟར་བྱས་ན། ཡོ་ཨབ་ཀྱིས་ཉེས་མེད་བསད་པའི་སྡིག་པ་དེ་ང་དང་ངའི་ཡབ་ཀྱི་རྒྱུད་ནས་མེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":32,"content":["ཡོ་ཨབ་ཀྱིས་ཉེས་མེད་བསད་པའི་སྡིག་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རང་གི་སྟེང་བླུག་པར་འགྱུར། ཅི་ལ་ཟེར་ན། ཡོ་ཨབ་ཀྱིས་རང་ལས་དྲང་ཞིང་བཟང་བའི་མི་གཉིས་བསད་པ་སྟེ། ཡེས་ར་ཨེལ་གྱི་དམག་དཔོན་ནེར་གྱི་བུ་ཨབ་ནེར་དང་། ཡ་ཧུ་དཱའི་དམག་དཔོན་ཡེ་ཐེར་གྱི་བུ་ཨ་མ་སཱ་གཉིས་རལ་གྲིས་བསད་པ་དང་། ངའི་ཡབ་དཱ་བིད་ཀྱིས་དེ་མ་ཤེས་སོ། །"]},{"type":"verse","number":33,"content":["དེ་བས་དེ་གཉིས་ཀྱི་ཁྲག་བཞུར་བའི་སྡིག་པ་ནི་ཕྱིར་ཡོ་ཨབ་དང་ཁོའི་བུ་རྒྱུད་རྣམས་ཀྱི་མགོ་ལ་རྟག་ཏུ་འབབ་པར་གྱུར་ཅིག འོན་ཀྱང་དཱ་བིད་དང་ཁོང་གི་བུ་རྒྱུད་དང་ཁྱིམ་གཞིས། ཁོང་གི་རྒྱལ་ཁྲི་བཅས་ལ་དུས་རྒྱུན་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ནས་ཞི་བདེ་འཐོབ་པར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":34,"content":["དེ་ནས་ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡ་ཡར་སོང་སྟེ་ཁོ་ལ་རྒོལ་ནས་བསད་པ་དང་། ཡོ་ཨབ་རང་གི་ཁྱིམ་ཡོད་སའི་དབེན་སྟོང་དུ་དུར་ལ་སྦས་སོ། །"]},{"type":"verse","number":35,"content":["རྒྱལ་པོས་ཡོ་ཨབ་ཀྱི་ཤུལ་དུ་ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡ་དམག་དཔོན་དུ་བསྐོས་པ་དང་། ཨབ་ཡཱ་ཐར་གྱི་ཤུལ་དུ་མཆོད་དཔོན་ཟཱ་ཏོག་བསྐོས་སོ། །"]},{"type":"verse","number":36,"content":["ཡང་རྒྱལ་པོས་མི་མངགས་ཏེ་ཤིམ་ཨི་བོས་ནས་དེ་ལ། ཁྱོད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་རང་ཉིད་ལ་ཁང་པ་ཞིག་བརྩིགས་ནས་དེར་སྡོད་ཅིག དེ་ནས་གང་དུའང་མ་འགྲོ་ཞིག"]},{"type":"verse","number":37,"content":["ཁྱོད་ཀྱིས་ཤེས་དགོས་པ་ནི། ཁྱོད་རང་ནམ་ཞིག་ལ་ཕྱི་རུ་ཐོན་ནས་ཀིད་རོན་གྲམ་པ་བརྒལ་ན། ཉིན་མོ་དེར་ཁྱོད་རང་འཆི་ངེས་ཡིན། དེ་ནས་ཁྱོད་ཀྱི་ཁྲག་ནི་ཁྱོད་རང་གི་མགོ་རུ་འབབ་པར་འགྱུར་རོ་ཞེས་གསུངས་པའི་ལན་དུ།"]},{"type":"verse","number":38,"content":["ཤིམ་ཨི་ཡིས་རྒྱལ་པོ་ལ། གསུང་འདི་ལེགས་སོ། །ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོས་ཇི་ལྟར་གསུངས་པ་ཡིན་ན། ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་གིས་དེ་ལྟར་བྱེད་ངེས་ཡིན་ཞེས་སྨྲས་པ་དང་། ཤིམ་ཨི་ཡུན་རིང་ཞིག་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་བསྡད་དོ། །"]},{"type":"verse","number":39,"content":["འོན་ཀྱང་ལོ་གསུམ་གྱི་རྗེས་སུ་ཤིམ་ཨི་ཡི་བྲན་གཡོག་རྣམས་ལས་མི་གཉིས་གཱད་ཀྱི་རྒྱལ་པོ་མ་ཨ་ཀཱ་ཡི་བུ་ཨ་ཀི་སིའི་རྩར་བྲོས་ཤིང་། མི་རྣམས་ཀྱིས་ཤིམ་ཨི་ལ། ལྟོས་ཤིག་ཁྱོད་ཀྱི་བྲན་གཡོག་རྣམས་གཱད་ཡུལ་དུ་འདུག་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":40,"content":["ཤིམ་ཨི་ཡར་ལངས་ནས། རང་གི་བོང༌བུ་ལ་སྒ་བསྟད་དེ་གཱད་གྱི་རྒྱལ་པོ་ཨ་ཀི་སིའི་རྩར་རང་གི་བྲན་གཡོག་གཉིས་འཚོལ་དུ་སོང་། ཤིམ་ཨི་དེ་ལྟར་ཕྱིན་ཏེ། གཱད་ཡུལ་ནས་རང་གི་བྲན་གཡོག་གཉིས་ཁྲིད་འོངས་པའོ། །"]},{"type":"verse","number":41,"content":["ཤིམ་ཨི་ཁོ་རང་ཡེ་རུ་སཱ་ལེམ་ནས་གཱད་ཡུལ་དུ་སོང་ནས་ཕྱིར་ལོག་པའི་སྐད་ཆ་སོ་ལོ་མོན་ལ་འབྱོར་བ་དང་།"]},{"type":"verse","number":42,"content":["རྒྱལ་པོས་མི་མངགས་ཏེ་ཤིམ་ཨི་རང་གི་གམ་དུ་བོས་ནས་དེ་ལ། ངས་ཁྱོད་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ཏེ་མནའ་བསྐྱལ་དུ་བཅུག་པར་མ་ཟད། ཁྱོད་ཀྱིས་ཤེས་དགོས་པ་ནི་ཁྱོད་རང་ནམ་ཞིག་ལ་ཕྱི་རུ་ཐོན་ནས་ཡུལ་གཞན་གང་དུ་སོང་ན། ཉིན་མོ་དེར་ཁྱོད་རང་འཆི་ངེས་ཡིན་ཞེས་ནན་གྱིས་མ་བསྐུལ་ལམ། ཡང་ཁྱོད་ཀྱིས་ང་ལ་ལན་དུ་དེ་ལེགས་སོ་ངས་དེ་བཞིན་བྱའོ་ཞེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":43,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྐྱལ་བའི་མནའ་དང་། ངས་ཁྱོད་ལ་ཕབ་པའི་བཀའ་དེ་ཅིའི་ཕྱིར་མ་བསྲུངས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":44,"content":["ཡང་རྒྱལ་པོས་ཤིམ་ཨི་ལ། ཁྱོད་ཀྱིས་ངའི་ཡབ་དཱ་བིད་ལ་བྱས་པའི་དོན་ངན་ཐམས་ཅད་ཁྱོད་རང་གི་སེམས་ལ་ངེས་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་ཉེས་པ་དེ་ནི་ཕྱིར་ཁྱོད་རང་གི་མགོ་ལ་འབེབ་པར་འགྱུར།"]},{"type":"verse","number":45,"content":["འོན་ཀྱང་རྒྱལ་པོ་སོ་ལོ་མོན་ལ་བྱིན་རླབས་འཐོབ་ཅིང་། དཱ་བིད་ཀྱི་རྒྱལ་ཁྲི་ནི་དུས་རྒྱུན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་གནས་པར་འགྱུར་རོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":46,"content":["རྒྱལ་པོས་ཡེ་ཧོ་ཡ་དཱའི་བུ་པེ་ནཱ་ཡ་ལ་བཀའ་གནང་བས། དེ་ཕྱི་རོལ་ཏུ་ཐོན་ནས་ཤིམ་ཨི་ལ་རྒོལ་ཏེ་བསད་ཅིང་། དེ་བཞིན་སོ་ལོ་མོན་གྱིས་རྒྱལ་སྲིད་བརྟན་པོར་མཛད་པའོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"མོ་ཤེའི་བཀའ་ཁྲིམས་ཞེས་པ་ནི། དམ་པའི་གསུང་རབ་ཀྱི་ཞལ་ཆད་རྙིང་པའི་བཀོད་པ་དང་ཨེ་ཅིབ་ནས་ཐོན་པ། ལེ་ཝིའི་ཚུལ་ཁྲིམས། གྲངས་ཀ བཀའ་ལུང་བཅས་ཀྱི་མདོ་ལྔ་ལ་ཟེར།","reference":{"chapter":2,"verse":3}},{"noteId":1,"caller":"+","text":"གནས་ཚུལ་ཞིབ་མོ་སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་གསུམ་པའི་ཚིག་རྐང་ཉེར་བདུན་པ་དང་སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་ཉི་ཤུ་ཡི་ཚིག་རྐང་བཅུ་བར་གསལ།","reference":{"chapter":2,"verse":5}},{"noteId":2,"caller":"+","text":"དོན་འདི་སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་བཅུ་བདུན་གྱི་ཚིག་རྐང་ཉེར་བདུན་ནས་ཉེར་དགུའི་བར་གསལ།","reference":{"chapter":2,"verse":7}},{"noteId":3,"caller":"+","text":"དོན་འདི་སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་བཅུ་དྲུག་པའི་ཚིག་རྐང་ལྔ་ནས་བཅུ་གསུམ་བར་གསལ།","reference":{"chapter":2,"verse":8}},{"noteId":4,"caller":"+","text":"སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་བཅུ་དགུ་ཡི་ཚིག་རྐང་བཅུ་དྲུག་ནས་ཉེར་གསུམ་བར་གཟིགས་རོགས།","reference":{"chapter":2,"verse":8}},{"noteId":5,"caller":"+","text":"སཱ་མུ་ཨེལ་དང་པོའི་ལེའུ་གཉིས་པའི་ཚིག་རྐང་ཉེར་བདུན་པ་ནས་སོ་དྲུག་པའི་བར་དུ་གསལ།","reference":{"chapter":2,"verse":27}},{"noteId":6,"caller":"+","text":"ཨབ་ཤཱ་ལོམ་ནི་དཱ་བིད་ཀྱི་སྲས་ཡིན་ཞིང་། སྔར་དཱ་བིད་རྒྱལ་པོ་ཡིན་དུས་ཨབ་ཤཱ་ལོམ་གྱིས་ཁོང་ལ་ངོ་ལོག་བྱས། ཨབ་ཤཱ་ལོམ་གྱི་སྐོར་མང་དུ་ཤེས་འདོད་ན་སཱ་མུ་ཨེལ་གཉིས་པའི་ལེའུ་བཅུ་དྲུག་ནས་བཅོ་བརྒྱད་བར་དུ་གསལ།","reference":{"chapter":2,"verse":28}}]},"thisChapterLink":"/api/bod_ntb/1KI/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/1.json","previousChapterAudioLinks":{},"numberOfVerses":46}