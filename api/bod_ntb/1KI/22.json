{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":22,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":1,"content":["ཨ་རམ་པ་དང་ཡེས་ར་ཨེལ་པ་གཉིས་ཀྱི་བར་ལ་དམག་འཁྲུག་མེད་པར་ལོ་གསུམ་སོང་བ་དང་།"]},{"type":"verse","number":2,"content":["ལོ་གསུམ་པར་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་བྱ་བ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན།"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་རང་གི་འཁོར་གཡོག་རྣམས་ལ། གིལ་ཨད་ཀྱི་རཱ་མོད་ནི་འོ་སྐོལ་གྱི་ཡིན་པ་ཁྱོད་ཚོས་ཤེས་སམ། དེ་ཨ་རམ་རྒྱལ་པོའི་ལག་ནས་ཕྱིར་མི་ལེན་པར་ཁ་རོག་ལ་སྡོད་རུང་ངམ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":4,"content":["ཨ་ཧབ་ཀྱིས་ཡེ་ཧོ་ཤ་ཕད་ལ། ཁྱོད་རང་ང་དང་མཉམ་དུ་གིལ་ཨད་ཀྱི་རཱ་མོད་ལ་དམག་རྒྱག་ཏུ་འགྲོའམ་ཞེས་དྲིས་པར། ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། ཁྱོད་དང་ང་གཉིས་གཅིག་ཡིན་ཏེ། ངའི་འབངས་ཀྱང་ཁྱེད་ཀྱི་འབངས་དང་འདྲ་བ་དང་། ངའི་རྟ་རྣམས་ཀྱང་ཁྱེད་ཀྱི་རྟ་དང་འདྲ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":5,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱིས་སྔོན་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བཀའ་འདྲི་ཞུས་ཤིག་ཅེས་བསྐུལ་ཏོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ལུང་སྟོན་པ་བཞི་བརྒྱ་ཙམ་བསྡུས་ནས་དེ་དག་ལ། བདག་ནི་གིལ་ཨད་ཀྱི་རཱ་མོད་ལ་འཐབ་ཏུ་སོང་ན་འོས་སམ་མི་འོས། ཡང་ན་ངས་དེར་བཟོད་དགོས་སམ་ཞེས་དྲིས་པ་ལ། དེ་དག་གིས། གཙོ་བོས་ཡུལ་དེ་ནི་རྒྱལ་པོའི་ཕྱག་ཏུ་གནང་འོང་བས་ཡར་ཕེབས་ནས་དམག་བརྒྱབ་ཆོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":7,"content":["དེར་ཡེ་ཧོ་ཤ་ཕད་ཀྱིས། འདིར་དཀོན་མཆོག་ཡ་ཝཱེའི་ལུང་སྟོན་པ་གཞན་ཡང་ཡོད་པ་མ་ཡིན་ནམ། རང་ཅག་གིས་ཁོང་ལ་བཀའ་འདྲི་ཞུས་མི་ཆོག་གམ་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":8,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཡེ་ཧོ་ཤ་ཕད་ལ། ད་དུང་མི་ཞིག་ཡོད་དེ། ཁོ་ནི་ཨིམ་ལཱའི་བུ་མི་ཀ་ཡཱ་བྱ་བ་ཡིན་ནོ། །ང་ཚོས་ཁོ་རང་བརྒྱུད་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བཀའ་འདྲི་ཞུས་ཆོག་ཀྱང་། དེས་ང་ལ་གནང་བའི་ལུང་བསྟན་ནི་ནམ་ཡིན་ཡང་གཏམ་ངན་ལས་གཏམ་བཟང་མེད་པས། ང་དེ་ལ་སྡང་ངོ་ཞེས་སྨྲས་པར། ཡེ་ཧོ་ཤ་ཕད་ཀྱིས། རྒྱལ་པོ་ཁྱེད་ཀྱིས་འདི་འདྲ་མ་གསུང་ཞིག་ཅེས་སྨྲས།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཉུག་རུམ་པ་ཞིག་བོས་ནས་ན་རེ། མྱུར་དུ་སོང་ལ་ཨིམ་ལཱའི་བུ་མི་ཀ་ཡཱ་ཁྲིད་ཤོག་ཅེས་བསྒོས།"]},{"type":"verse","number":10,"content":["དེའི་དུས་སུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་གཉིས་རང་རང་གི་ཁྲིར་བཞུགས་ཤིང་། རྒྱལ་པོའི་ན་བཟའ་མནབས་ཏེ་སཱ་མར་ཡའི་མཁར་སྒོ་མདུན་གྱི་ཐང་ཆེན་ཞིག་ཏུ་བཞུགས་པ་དང་། ལུང་སྟོན་པ་ཐམས་ཅད་ཀྱིས་དེ་གཉིས་ཀྱི་དྲུང་ནས་ལུང་སྟོན་གྱིན་ཡོད་དེ།"]},{"type":"verse","number":11,"content":["ཀེ་ནཱ་ནའི་བུ་ཚིད་ཀི་ཡཱས་རང་ལ་ལྕགས་ཀྱི་རྭ་ཅོ་འགའ་བཟོས་ཏེ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ལྕགས་ཀྱི་རྭ་ཅོ་འདི་དག་གིས་ཨ་རམ་པ་རྣམས་ཚར་གཅོད་པའི་བར་དུ་བསྣུན་པར་བྱ་གསུངས་ཞེས་སྨྲས།"]},{"type":"verse","number":12,"content":["ལུང་སྟོན་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་དེ་བཞིན་ལུང་བསྟན་ཏེ་ན་རེ། ཁྱེད་རང་ཡར་གིལ་ཨད་ཀྱི་རཱ་མོད་ལ་དམག་རྒྱག་ཏུ་བསྐྱོད་ཅིག་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་གྲོང་ཁྱེར་དེ་རྒྱལ་པོའི་ཕྱག་ཏུ་གཏོད་པར་འགྱུར་བས་རྒྱལ་ཁ་ལོན་ངེས་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":13,"content":["ཡང་མི་ཀ་ཡཱ་འབོད་དུ་སོང་བའི་བང་ཆེན་གྱིས་ཁོང་ལ། གཟིགས་དང་། ལུང་སྟོན་པ་ཐམས་ཅད་ཁ་མཐུན་ནས་རྒྱལ་པོ་ལ་ལུང་བསྟན་བཟང་པོ་སྨྲ་བ་སྟེ། ཁྱེད་ཀྱིས་ཀྱང་དེ་དག་དང་འདྲ་བར་གཏམ་བཟང་གསུང་བར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":14,"content":["མི་ཀ་ཡཱས་འདི་ལྟར། བདག་གིས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་ཅི་གསུངས་ན་བདག་གིས་ཀྱང་དེ་ལྟར་སྨྲ་བར་བྱའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་མི་ཀ་ཡཱ་རྒྱལ་པོའི་དྲུང་དུ་སླེབས་པ་དང་། རྒྱལ་པོས་དེ་ལ། ཀྱེ་མི་ཀ་ཡཱ། རང་ཅག་གིལ་ཨད་ཀྱི་རཱ་མོད་ལ་འཐབ་ཏུ་སོང་ན་འོས་སམ་མི་འོས། ཡང་ན་ངས་དེར་བཟོད་དགོས་སམ་ཞེས་དྲིས་པ་ལ། ཁོང་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ནི་རྒྱལ་པོའི་ལག་ཏུ་གནང་བར་ངེས་པས་དམག་རྒྱོབས་དང་རྒྱལ་བར་འགྱུར་རོ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":16,"content":["རྒྱལ་པོ་ན་རེ། བདག་གིས་ཁྱོད་ལ་མནའ་དུ་འགེལ་བར་བྱས་ན། ཁྱོད་ཀྱིས་ད་གཟོད་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་སྒོ་ནས་བདག་ལ་བདེན་པ་ཁོ་ན་སྨྲའམ་ཞེས་དྲིས་པར།"]},{"type":"verse","number":17,"content":["མི་ཀ་ཡཱ་ན་རེ། བདག་གིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ནི་རྫི་བོ་མེད་པའི་ལུག་ལྟར་རི་ལ་འཐོར་ཡོད་པ་མཐོང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། འདི་རྣམས་ལ་བདག་པོ་གང་ཡང་མེད་པས་ཞི་བདེའི་ངང་རང་རང་གི་ཡུལ་ལ་འགྲོ་རུ་ཆུག་ཅེས་གསུངས་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":18,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཡེ་ཧོ་ཤ་ཕད་ལ། འདིས་ང་ལ་ལུང་བསྟན་ངན་པ་མ་གཏོགས་བཟང་པོ་ཞིག་སྟོན་པར་མི་འགྱུར་ཞེས་ངས་ཁྱེད་ལ་བཤད་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["དེར་མི་ཀ་ཡཱ་ན་རེ། དེ་བས་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་ཀྱི་བཞུགས་ཁྲི་ལ་བཞུགས་པ་དང་། ནམ་མཁའི་དཔུང་ཚོགས་ཐམས་ཅད་ནི་ཁོང་གི་གཡས་གཡོན་དུ་འགྲེང་འདུག་པ་ངས་མཐོང་སྟེ།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཨ་ཧབ་ནི་ཡར་གིལ་ཨད་ཀྱི་རཱ་མོད་དུ་སོང་ནས་འགྱེལ་བའི་ཕྱིར་སུས་ཁོ་བསླུ་བར་བྱའམ་ཞེས་གསུངས་པའི་ལན་དུ། འདི་ལྟར་བརྗོད་མཁན་དང་དེ་ལྟར་བརྗོད་མཁན་བྱུང་ངོ་། །"]},{"type":"verse","number":21,"content":["དེ་ནས་སེམས་ཉིད་ཅིག་ཐོན་ཞིང་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འགྲེངས་ནས་འདི་ལྟར། ངས་ཁོ་བསླུ་བར་བྱ་ཞེས་ཞུས་པར། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་ཇི་ལྟར་བསླུ་བར་བྱའམ་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":22,"content":["ཁོས་འདི་ལྟར། ང་རང་སོང་ནས་ཨ་ཧབ་ཀྱི་ལུང་སྟོན་པ་ཐམས་ཅད་ཀྱི་ཁ་རུ་རྫུན་སྨྲ་བའི་སེམས་ཉིད་དུ་བྱའོ་ཞེས་ཞུས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཁོ་བསླུས་ནས་དོན་འགྲུབ་པར་འགྱུར་བས་སོང་ལ་དེ་བཞིན་བྱོས་ཤིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":23,"content":["ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་ལུང་སྟོན་པ་འདི་དག་གི་ཁ་རུ་རྫུན་སྨྲ་བའི་སེམས་ཉིད་བཅུག་པར་མ་ཟད། ཁོང་གིས་ཁྱོད་ལ་ཆག་སྒོ་འབེབ་པའི་ཐུགས་ཐག་བཅད་པའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་ཀེ་ནཱ་ནའི་བུ་ཚིད་ཀི་ཡཱ་ཉེ་བར་འོངས་ནས། མི་ཀ་ཡཱ་ལ་འགྲམ་ལྕག་གཞུས་ཏེ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཉིད་དེ་ཇི་ལྟར་ང་དང་བྲལ་ནས་ཁྱོད་ལ་གཏམ་བྱས་པ་ཡིན་ནམ་ཞེས་དྲིས་པ་དང་།"]},{"type":"verse","number":25,"content":["མི་ཀ་ཡཱ་ན་རེ། ཉོན་ཅིག ཁྱོད་སྦུག་ཁང་དུ་འཛུལ་ནས་ཡིབ་པའི་ཉིན་མོར་དེ་མཐོང་བར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":26,"content":["དེར་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་འདི་ལྟར། མི་ཀ་ཡཱ་བཟུང་སྟེ་གྲོང་དཔོན་ཨ་མོན་དང་རྒྱལ་སྲས་ཡོ་ཨ་སི་ཡི་རྩར་ཁྲིད་ནས་དེ་དག་ལ།"]},{"type":"verse","number":27,"content":["རྒྱལ་པོས་འདི་ལྟར། ང་རང་བདེ་བར་ཕྱིར་སླེབས་པའི་བར་དུ་མི་འདི་བཙོན་ལ་བཅུག་སྟེ། བཟའ་བཏུང་ཉུང་ཙམ་ལས་གང་ཡང་མ་སྟེར་ཞེས་བསྒོས་སོང་སྨྲོས་ཤིག་ཅེས་སྨྲས།"]},{"type":"verse","number":28,"content":["མི་ཀ་ཡཱ་ན་རེ། གལ་ཏེ་ཁྱོད་རང་དངོས་གནས་བདེ་བར་ཕྱིར་འོངས་ཐུབ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ང་བརྒྱུད་དེ་ཅི་ཡང་མ་གསུངས་པ་ཡིན་ཞེས་སྨྲས་པ་དང་། ཡང་མི་ཐམས་ཅད་ཀྱིས་ཉོན་ཅིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":29,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་གཉིས་ཡར་གིལ་ཨད་ཀྱི་རཱ་མོད་དུ་སོང་ནས།"]},{"type":"verse","number":30,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཡེ་ཧོ་ཤ་ཕད་ལ་འདི་ལྟར། ངས་གོས་ཆས་བསྒྱུར་ཏེ་གཡུལ་ལ་ཞུགས་དགོས། ཁྱེད་ཀྱིས་རང་གི་ན་བཟའ་གྱོན་ནས་སྡོད་ཅིག་ཅེས་སྨྲས་ཏེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་གོས་ཆས་བསྒྱུར་ནས་གཡུལ་ལ་ཞུགས་སོ། །"]},{"type":"verse","number":31,"content":["ཨ་རམ་གྱི་རྒྱལ་པོས་ཤིང་རྟའི་འགོ་དཔོན་སུམ་ཅུ་སོ་གཉིས་ལ་བཀའ་བབས་ཏེ་ན་རེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་འབའ་ཞིག་ལ་མ་གཏོགས་དམག་ཆེ་ཆུང་གང་ལ་ཡང་མ་འཐབ་ཅིག་ཅེས་བསྒོས་པས།"]},{"type":"verse","number":32,"content":["ཤིང་རྟའི་འགོ་དཔོན་ཚོས་ཡེ་ཧོ་ཤ་ཕད་མཐོང་བ་དང་འདི་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡིན་སྙམ་ནས་ཁ་ཕྱིར་འཁོར་ནས་ཁོ་ལ་རྒོལ་ཞིང་། ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་སྐད་ཆེན་པོ་བརྒྱབ་པས།"]},{"type":"verse","number":33,"content":["ཤིང་རྟའི་འགོ་དཔོན་རྣམས་ཀྱིས་དེ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་མིན་པ་ཤེས་ནས་ཁོ་མ་བདས་པར་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":34,"content":["དེ་ནས་མི་ཞིག་གིས་བྱུང་རྒྱལ་དུ་མདའ་འཕངས་པ་ན། མ་བསམ་ས་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་གོ་ཁྲབ་ཀྱི་མཐུད་མཚམས་སུ་ཕོག་པས། ཁོས་ཤིང་རྟའི་དེད་དཔོན་ལ། ང་རྨས་བྱུང་བས་ཁྱོད་ཀྱིས་ཤིང་རྟ་ཁ་ལོ་སྒྱུར་ལ་ང་གཡུལ་ས་ནས་ཁྲིད་ཅིག་ཅེས་བསྒོས།"]},{"type":"verse","number":35,"content":["ཉིན་དེར་དམག་འཐབ་ཛ་དྲག་ཏུ་སོང་སྟེ། མི་ཞིག་གིས་རྒྱལ་པོ་སྐྱོར་ནས་ཤིང་རྟའི་སྟེང་ལངས་ཅི་ཐུབ་བྱས་ཏེ་ཨ་རམ་པ་ལ་འགོག་རྒོལ་བྱས་པ་དང་། དགོང་མོའི་དུས་སུ་རྒྱལ་པོ་ཚེ་ལས་འདས་ཤིང་། ཤིང་རྟའི་མཐིལ་ཞབས་དུ་ཁོའི་ཁྲག་འཛགས་སོ། །"]},{"type":"verse","number":36,"content":["ཉི་མ་ནུབ་པའི་དུས་ཙམ་ལ་དམག་སྒར་དུ་བཀའ་བབས་ནས། མི་ཐམས་ཅད་རང་རང་གི་གྲོང་ཁྱེར་དང་རང་རང་གི་ཡུལ་དུ་ལོག་ཅིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":37,"content":["དེ་ལྟར་རྒྱལ་པོ་ཚེ་ལས་འདས་ནས་སཱ་མར་ཡ་རུ་ཁྱེར་ཏེ། དེ་དག་གིས་ཁོང་སཱ་མར་ཡ་རུ་དུར་ལ་སྦས་སོ། །"]},{"type":"verse","number":38,"content":["དེ་དག་གིས་སཱ་མར་ཡའི་ཁྲོན་པ་སྟེ་སྨད་འཚོང་མ་རྣམས་ཀྱིས་ཁྲུས་བྱེད་ས་རུ་ཤིང་རྟ་བཀྲུས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་ལྟར་ཁྱི་རྣམས་ཀྱིས་ཁོའི་ཁྲག་བལྡགས་པའོ། །"]},{"type":"verse","number":39,"content":["ཨ་ཧབ་ཀྱི་བྱས་རྗེས་གཞན་རྣམས་དང་ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་དང་། ཁོས་བ་སོས་བཞེངས་པའི་ཕོ་བྲང་དང་། ཁོས་ཞིག་གསོ་བྱས་པའི་གྲོང་ཁྱེར་ཐམས་ཅད་ཀྱི་སྐོར་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་རབས་ཀྱི་མདོ་ཡི་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":40,"content":["ཨ་ཧབ་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་པ་དང་། ཁོའི་བུ་ཨ་ཧ་ཟི་ཡཱ་ཡིས་དེའི་ཚབ་ཏུ་རྒྱལ་སྲིད་བཟུང་ངོ་། །"]},{"type":"heading","content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་ཡ་ཧུ་དཱའི་རྒྱལ་སྲིད་བཟུང་བ།"]},{"type":"verse","number":41,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་སྲིད་ལོ་བཞི་པར། ཨ་སཱ་ཡི་སྲས་ཡེ་ཧོ་ཤ་ཕད་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོར་བཞུགས་སོ། །"]},{"type":"verse","number":42,"content":["ཡེ་ཧོ་ཤ་ཕད་རྒྱལ་པོར་བཞུགས་དུས་དགུང་ལོ་སོ་ལྔ་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་ཉེར་ལྔའི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ཁོང་གི་ཡུམ་ནི་ཤིལ་ཧིའི་སྲས་མོ་ཨ་ཟུ་བཱ་ཞེས་པ་ཡིན།"]},{"type":"verse","number":43,"content":["ཡེ་ཧོ་ཤ་ཕད་ནི་རང་གི་ཡབ་ཨ་སཱ་ཡི་ལམ་གྱི་ནང་དུ་འགྲུལ་ཞིང་དེ་ལས་མ་འཁྱར་བར། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད། འོན་ཀྱང་མཐོ་གླིང་རྣམས་ད་དུང་མ་བཤིག་པར་བཞག་ཅིང་། མི་རྣམས་ཀྱིས་སྔར་བཞིན་མཐོ་གླིང་རྣམས་སུ་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་ནས་བསང་ཡང་བཏང་བ་རེད།"]},{"type":"verse","number":44,"content":["རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་དང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་གཉིས་ཀྱི་བར་ལ་ཞི་མཐུན་ཡོང་བ་རེད།"]},{"type":"verse","number":45,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱི་བྱས་རྗེས་གཞན་རྣམས་དང་། ཁོང་གིས་ངོམས་པའི་དཔའ་རྩལ་དང་དམག་ཅི་ལྟར་བརྒྱབ་པ་རྣམས་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་རབས་ཀྱི་མདོ་ཡི་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":46,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་ཁོང་གི་ཡབ་ཨ་སཱའི་དུས་ནས་ལུས་པའི་མཆོད་གཤོམ་གྱི་ཆོས་རྫུ་གཞང་འཚོང་རྣམས་ཡུལ་ཁོངས་ནས་བསྐྲད་ཅིང་བདས་སོ། །"]},{"type":"verse","number":47,"content":["དེའི་དུས་སུ་ཨེ་དོམ་ཡུལ་དུ་རྒྱལ་པོ་གང་ཡང་མེད་དེ། མཁར་དཔོན་ཞིག་གིས་སྲིད་བསྐྱངས་སོ། །"]},{"type":"verse","number":48,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་ཨོ་ཕིར་ནས་གསེར་འདྲེན་དུ་ཐཱར་ཞིས་གྲུ་གཟིངས་བཟོས་ཀྱང་། གྲུ་རྣམས་ཨེ་ཙི་ཡོན་གེ་བེར་དུ་ཆག་གྲུམ་བྱུང་བས་ཁ་ལོ་བསྒྱུར་མ་ཐུབ་བོ། །"]},{"type":"verse","number":49,"content":["དེའི་ཚེ་ཨ་ཧབ་ཀྱི་སྲས་ཨ་ཧ་ཟི་ཡཱས་ཡེ་ཧོ་ཤ་ཕད་ལ། ངའི་ཞབས་ཕྱི་རྣམས་ཀྱང་ཁྱེད་ཀྱི་ཞབས་ཕྱི་དང་མཉམ་དུ་གྲུ་གཟིངས་ལ་བསྡད་ནས་འགྲོ་བར་གནོངས་ཤིག་ཅེས་ཞུས་ཀྱང་། ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་དེ་ལྟར་མ་གནང་ངོ་། །"]},{"type":"verse","number":50,"content":["དེ་ནས་ཡེ་ཧོ་ཤ་ཕད་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་ནས། ཡབ་མེས་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་ཕ་མེས་རྣམས་དང་མཉམ་དུ་དུར་ལ་སྦས་ཤིང་། ཁོང་གི་སྲས་ཡེ་ཧོ་རཱམ་གྱིས་ཁོང་གི་ཚབ་ཏུ་རྒྱལ་སྲིད་བཟུང་ངོ་། །"]},{"type":"heading","content":["ཨ་ཧ་ཟི་ཡཱ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྡད་པ།"]},{"type":"verse","number":51,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ཀྱི་སྲིད་ལོ་བཅུ་བདུན་པར། ཨ་ཧབ་ཀྱི་བུ་ཨ་ཧ་ཟི་ཡཱ་ནི་སཱ་མར་ཡ་རུ་རྒྱལ་པོར་བསྡད་ནས་ལོ་གཉིས་ཀྱི་རིང་ལ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་སྲིད་བསྐྱངས་སོ། །"]},{"type":"verse","number":52,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཅིང་། རང་གི་ཕ་མ་གཉིས་ཀྱི་སྤྱོད་ལམ་དུ་འགྲུལ་པ་དང་། ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་སྡིག་པར་ལྷུང་དུ་བཅུག་པའི་ལམ་དུའང་འགྲུལ་པའོ། །"]},{"type":"verse","number":53,"content":["དེར་མ་ཟད་ཁོས་རང་གི་ཕ་ཡིས་བྱས་པ་ནང་བཞིན་ལྷ་པཱ་ཨལ་ལ་བརྟེན་ཅིང་དེར་ཕྱག་བཙལ་ནས། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས་པའོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1KI/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/21.json","previousChapterAudioLinks":{},"numberOfVerses":53}