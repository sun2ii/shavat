{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":3,"content":[{"type":"heading","content":["སོ་ལོ་མོན་གྱིས་ཤེས་རབ་ཞུས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སོ་ལོ་མོན་གྱིས་ཨེ་ཅིབ་ཡུལ་གྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་དང་གཉེན་འབྲེལ་བཙུགས་ཏེ་ཕཱར་ཨོལ་གྱི་སྲས་མོ་ཆུང་མར་བཞེས་ནས། རང་གི་ཕོ་བྲང་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་། ཡེ་རུ་སཱ་ལེམ་གྱི་ཕྱོགས་བཞིའི་མཁར་གྱང་རྣམས་བརྩིགས་ཚར་བའི་བར་དུ་ཁོ་མོ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":2,"content":["དུས་དེའི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་ཕྱིར་མཆོད་ཁང་ཞིག་ད་དུང་བཞེངས་མེད་པས། མི་རྣམས་ཀྱིས་མཐོ་གླིང་རྣམས་སུ་མཆོད་པ་ཕུལ་བ་ཡིན།"]},{"type":"verse","number":3,"content":["སོ་ལོ་མོན་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དགའ་ཞིང་། རང་གི་ཡབ་དཱ་བིད་ཀྱི་སྒྲིག་ཁྲིམས་བཞིན་དུ་བསྒྲུབས་མོད། འོན་ཀྱང་ཁོང་གིས་སྔར་བཞིན་མཐོ་གླིང་རྣམས་སུ་སྦྱིན་སྲེག་གི་མཆོད་པའི་ཕྱུགས་རྣམས་བཤས་ནས་མེ་རུ་བསྲེགས་པའོ། །"]},{"type":"verse","number":4,"content":["ཡང་གིབ་ཡོན་ཡུལ་དུ་ཆེས་ཆེ་བའི་མཐོ་གླིང་ཡོད་པས། རྒྱལ་པོ་དེར་མཆོད་པ་འབུལ་བར་གཤེགས་ཏེ། སོ་ལོ་མོན་གྱིས་མཆོད་ཁྲི་དེའི་ཁར་སྦྱིན་སྲེག་གི་མཆོད་པ་ཆིག་སྟོང་ཕུལ་ཏོ། །"]},{"type":"verse","number":5,"content":["མཚན་མོ་དེར་གིབ་ཡོན་ཡུལ་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་སོ་ལོ་མོན་གྱི་རྨི་ལམ་དུ་མངོན་པར་གྱུར་ཏེ། དཀོན་མཆོག་གིས་ཁོང་ལ། ཁྱོད་ཀྱིས་ཅི་ཞུས་ཀྱང་བདག་གིས་ཁྱོད་ལ་སྦྱིན་ངེས་ཡིན་ཞེས་གསུངས་པའི་ལན་དུ།"]},{"type":"verse","number":6,"content":["སོ་ལོ་མོན་གྱིས། ཁྱེད་རང་གི་ཞབས་ཕྱི་སྟེ། ངའི་ཡབ་དཱ་བིད་ཀྱིས་ཁྱེད་ཀྱི་སྤྱན་སྔར་བློ་དཀར་བ་དང་། དྲང་གཞག་དང་གཞུང་དྲང་གི་སེམས་དང་བཅས་སྤྱོད་པ་སྤྱད་པས། ཁྱེད་ཀྱིས་ཁོང་ལ་བྱམས་བརྩེ་ཆེན་པོས་གཟིགས་སྐྱོང་གནང་བ་ཡིན། ཡང་ཉིན་མོ་འདི་བཞིན་དུ། ཁྱེད་ཀྱིས་ཁོང་ལ་བྱམས་བརྩེ་ཆེན་པོ་གནང་ཞིང་ཁོང་གི་རྒྱལ་ཁྲིར་འགོད་པའི་བུ་ཞིག་གནང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ཀྱེ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ད་ནི་ཁྱེད་ཀྱིས་རང་གི་ཞབས་ཕྱི་སྟེ། བདག་ནི་ཡབ་དཱ་བིད་ཀྱི་ཚབ་ཏུ་རྒྱལ་པོར་བསྐོས། འོན་ཀྱང་བདག་ནི་ལོ་ན་ཕྲ་བས་ཕྱི་ནང་གི་འགྲོ་ལུགས་ཀྱང་མི་ཤེས།"]},{"type":"verse","number":8,"content":["ཡང་ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་ནི་ཁྱེད་ཀྱིས་བདམས་པའི་འབངས་མིའི་ཁྲོད་དུ་ཡོད་དེ། འབངས་དེ་ནི་ཤིན་ཏུ་མང་བའི་རྐྱེན་གྱིས་བགྲང་གིས་མི་ལང་བ་ཞིག་ཡིན།"]},{"type":"verse","number":9,"content":["དེའི་ཕྱིར་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་ལ་འབངས་མིའི་སྲིད་སྐྱོང་བ་དང་། ལེགས་ཉེས་ཀྱི་དབྱེ་བ་རྟོགས་པའི་ཕྱིར་དུ། ཤེས་རབ་དང་ལྡན་པའི་སེམས་ཤིག་གནང་རོགས་ཞུ། ཅིའི་ཕྱིར་ཞེ་ན། སུ་ཞིག་གིས་ཁྱེད་ཀྱི་འབངས་མི་འདི་འདྲ་མང་པོར་སྲིད་བྱེད་ནུས་སམ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":10,"content":["སོ་ལོ་མོན་གྱིས་དེ་བཞིན་ཞུས་པ་ལ་གཙོ་བོ་ཐུགས་དགྱེས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་གིས་ཁོ་ལ། ཁྱོད་ཀྱིས་དེ་བཞིན་ཞུས་ཤིང་རང་གི་ཆེད་དུ་ཚེ་ཐག་རིང་པོའམ། རྒྱུ་ནོར་རམ། དགྲ་བོ་རྣམས་ཀྱི་སྲོག་གཅོད་པ་བཅས་ཀྱི་ཕྱིར་ཞུས་པ་མིན་པར། ལེགས་ཉེས་འབྱེད་པའི་ཤེས་རབ་ཀྱི་ཕྱིར་དུ་ཞུས་པས་ན།"]},{"type":"verse","number":12,"content":["ངས་ཁྱོད་ཀྱིས་ཞུས་པ་བཞིན་དུ་བསྒྲུབ་པར་བྱ་ཞིང་། ངས་ཁྱོད་ལ་ཤེས་རབ་དང་ཡེ་ཤེས་ཀྱི་སེམས་ཤིག་སྦྱིན་པར་བྱ་སྟེ། ཁྱོད་དང་འདྲ་བ་ཞིག་སྔོན་ཆད་བྱུང་མ་མྱོང་ལ། ཕྱིན་ཆད་ཀྱང་འབྱུང་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["དེར་མ་ཟད། ཁྱོད་ཀྱིས་མ་ཞུས་པ་དག་ཀྱང་སྦྱིན་པར་བྱ་སྟེ། རྒྱུ་ནོར་དང་བཀུར་སྟི་གཉིས་སྦྱིན་ཞིང་། ཁྱོད་ཀྱི་ཚེ་གང་པོར་རྒྱལ་པོ་གཞན་རྣམས་ཀྱི་ཁྲོད་དུ་ཁྱོད་འདྲ་བ་ཞིག་འབྱུང་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":14,"content":["གལ་ཏེ་ཁྱོད་ཀྱིས་རང་གི་ཕ་དཱ་བིད་ཀྱིས་ཅི་བྱས་པ་བཞིན་དུ། ངས་བསྟན་པའི་ལམ་ལ་འགྲོ་ཞིང་། ངའི་སྒྲིག་ཁྲིམས་དང་བཀའ་རྒྱ་རྣམས་བསྲུངས་ཚེ། བདག་གིས་ཁྱོད་ཀྱི་ཚེ་ཐག་རིང་བར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་སོ་ལོ་མོན་གཉིད་ལས་སད་པ་དང་། ཀྱེ་ཧོ། མ་གཞི་དེ་ནི་རྨི་ལམ་ཡིན་ནོ། །དེ་ནས་ཁོ་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་མདུན་དུ་ཡར་ལངས་ཏེ། སྦྱིན་སྲེག་གི་མཆོད་པ་དང་ཞི་བདེའི་མཆོད་པ་ཕུལ་ནས་རང་གི་བློན་འཁོར་རྣམས་ལ་གསོལ་སྟོན་བཤམས་སོ། །"]},{"type":"heading","content":["ཤེས་རབ་ལ་བརྟེན་ནས་གྱོད་དོན་འདུམ་པ།"]},{"type":"verse","number":16,"content":["ཉིན་ཞིག་ལ་སྨད་འཚོང་མ་གཉིས་རྒྱལ་པོའི་དྲུང་དུ་འོངས་ནས་ལངས་བསྡད་དེ།"]},{"type":"verse","number":17,"content":["བུད་མེད་གཅིག་གིས། ཀྱེ་ང་ཡི་བདག་པོ་ལགས། ང་རང་བུད་མེད་འདི་དང་མཉམ་དུ་ཁྱིམ་གཅིག་ལ་གནས་པ་ཡིན། ངེད་གཉིས་མཉམ་དུ་ཁང་པའི་ནང་དུ་ཡོད་དུས་ང་ལ་བུ་ཞིག་སྐྱེས་ཤིང་།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཉིན་གསུམ་པར་བུད་མེད་འདི་ལའང་བུ་ཞིག་སྐྱེས་ཏེ། ངེད་གཉིས་མཉམ་དུ་བསྡད་ཡོད་ཅིང་ཁྱིམ་དེར་ངེད་གཉིས་ལས་གཞན་སུ་ཡང་མེད།"]},{"type":"verse","number":19,"content":["མཚན་མོར་བུད་མེད་འདི་གཉིད་ལ་ཡུར་བའི་དུས་སུ་རང་གི་བུ་འོག་ཏུ་མནན་པས་བུ་དེ་ཤིའོ། །"]},{"type":"verse","number":20,"content":["མཚན་ཕྱེད་དུ་ཁྱེད་ཀྱི་ཞལ་ཏ་མ་བདག་གཉིད་ལ་ཡུར་བའི་སྐབས་དང་བསྟུན་ནས། ཁོ་མོ་ཡར་ལངས་ཏེ་བདག་གི་བུ་རང་གི་པང་ལ་བཞག་ཅིང་། ཁོ་མོའི་བུ་ཤི་རོ་ནི་བདག་གི་པང་དུ་བཞག་གོ །"]},{"type":"verse","number":21,"content":["ཕྱི་ཉིན་ཞོགས་པར་ང་རང་བུ་ལ་ནུ་མ་སྣུན་དུ་ཡར་ལངས་པའི་ཚེ་ན། ཀྱེ་ཧོ། ཁོ་ནི་ཤིའོ། །ཉིན་དེའི་ཞོགས་པར་བདག་གིས་ཞིབ་ཏུ་བལྟས་པའི་ཚེ། དེ་ནི་བདག་ལས་སྐྱེས་པའི་བུ་མིན་པ་མཐོང་ངོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་བུད་མེད་ཅིག་ཤོས་ན་རེ། དེ་འདྲ་གཏན་ནས་མ་ཡིན། གསོན་པོ་འདི་ངའི་བུ་ཡིན་པ་དང་། ཤི་རོ་དེ་ནི་ཁྱོད་ཀྱི་བུ་ཡིན་ཞེས་སྨྲས་ཤིང་། ཡང་བུད་མེད་དེ་ན་རེ། དེ་ལྟར་མིན། ཤི་རོ་དེ་ནི་ཁྱོད་ཀྱི་བུ་ཡིན་ལ། གསོན་པོ་འདི་ངའི་བུ་ཡིན་ནོ་ཞེས་དེ་གཉིས་ཀྱིས་རྒྱལ་པོའི་དྲུང་དུ་རྩོད་གླེང་བྱས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་རྒྱལ་པོས་འདི་ལྟར། བུད་མེད་གཅིག་གིས་ནི། གསོན་པོ་འདི་ངའི་བུ་ཡིན་པ་དང་། ཤི་རོ་དེ་ནི་ཁྱོད་ཀྱི་བུ་ཡིན་ཟེར་ཞིང་། བུད་མེད་གཞན་དེས། དེ་ལྟར་མིན། ཤི་རོ་དེ་ནི་ཁྱོད་ཀྱི་བུ་ཡིན་ལ། གསོན་པོ་འདི་ངའི་བུ་ཡིན་ཟེར་རོ་ཞེས་གསུངས།"]},{"type":"verse","number":24,"content":["དེ་ནས་རྒྱལ་པོས། བདག་ལ་རལ་གྲི་ཞིག་ཁྱེར་ཤོག་ཅེས་གསུངས་པ་དང་རྒྱལ་པོའི་དྲུང་དུ་རལ་གྲི་ཞིག་ཁྱེར་འོངས་པ་དང་།"]},{"type":"verse","number":25,"content":["རྒྱལ་པོས་ཕྲུ་གུ་གསོན་པོ་འདི་དུམ་བུ་གཉིས་སུ་ཆོད་ལ་ཕྱེད་ཀ་བུད་མེད་འདི་དང་ཕྱེད་ཀ་བུད་མེད་དེ་ལ་བྱིན་ཅིག་ཅེས་བསྒོས་པར།"]},{"type":"verse","number":26,"content":["ཕྲུ་གུ་གསོན་པོ་དེའི་མ་ནི་ཕྲུ་གུར་གདུང་སེམས་སྐྱེས་ནས་རྒྱལ་པོ་ལ། ཀྱེ་ང་ཡི་བདག་པོ་ལགས། ཕྲུ་གུ་གསོན་པོ་འདི་ཁོ་མོར་སྟེར་རོགས། ཁོ་ནི་ཅི་ནས་ཀྱང་གསོད་མི་རུང་ཞེས་ཞུས་ན་ཡང་། བུད་མེད་གཞན་དེས་ཕྲུ་གུ་འདི་ཁྱོད་ལ་ཡང་མི་འཐོབ། ང་ལ་ཡང་མི་འཐོབ་པས་ཆོད་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་རྒྱལ་པོས། ཕྲུ་གུ་གསོན་པོ་དེ་བུད་མེད་འདི་ལ་བྱིན་ཅིག་དང་། བུད་མེད་འདི་ནི་དངོས་གནས་ཕྲུ་གུའི་མ་ཡིན་ཏེ། ཕྲུ་གུ་གཏན་ནས་གསོད་མི་རུང་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":28,"content":["ཡང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་རྒྱལ་པོས་འདུམས་པའི་གྱོད་དོན་དེ་ཐོས་པས་རྒྱལ་པོར་གུས་ཤིང་འཇིགས་སོ། །ཅིའི་ཕྱིར་ཞེ་ན། ལེགས་ཉེས་འབྱེད་པའི་ཕྱིར་དུ་དཀོན་མཆོག་གི་ཡེ་ཤེས་ཁོང་གི་ནང་དུ་གནས་པ་དེ་དག་གིས་མཐོང་བའི་ཕྱིར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1KI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/2.json","previousChapterAudioLinks":{},"numberOfVerses":28}