{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":5,"content":[{"type":"heading","content":["སོ་ལོ་མོན་གྱིས་མཆོད་ཁང་བཞེང་བའི་རྒྱུ་ཆ་གྲ་སྒྲིག་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཐཱར་གྱི་རྒྱལ་པོ་ཧི་རཱམ་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་སོ་ལོ་མོན་ནི་རང་གི་ཡབ་ཀྱི་ཚབ་ཏུ་རྒྱལ་པོར་བསྐོས་པ་ཐོས་ནས། རང་གི་བློན་འཁོར་རྣམས་སོ་ལོ་མོན་གྱི་དྲུང་དུ་མངགས་སོ། །ཅིའི་ཕྱིར་ཞེ་ན། རྒྱལ་པོ་ཧི་རཱམ་ནི་སྔར་ནས་རྒྱལ་པོ་དཱ་བིད་ལ་དགའ་བས་སོ། །"]},{"type":"verse","number":2,"content":["སོ་ལོ་མོན་གྱིས་ཀྱང་ཧི་རཱམ་གྱི་རྩར་མི་མངགས་ནས་འདི་ལྟར།"]},{"type":"verse","number":3,"content":["ངའི་ཡབ་དཱ་བིད་ཀྱིས་ཉིད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ལ་མཆོད་ཁང་ཞིག་བཞེང་མ་ནུས་ཏེ། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དགྲ་རྣམས་ཁོང་གི་ཞབས་འོག་ཏུ་འཇུག་པའི་བར་དུ་ཁོང་ལ་ཕྱོགས་བཞི་ནས་དམག་འཁྲུག་བྱུང་བ་ཁྱེད་ཀྱིས་ཀྱང་ཤེས་པས་སོ། །"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་ད་ལྟ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་གི་ཕྱོགས་བཞི་བདེ་ལ་བཀོད་པས། ང་ལ་དགྲ་དང་བར་ཆད་མེད།"]},{"type":"verse","number":5,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་ངའི་ཡབ་དཱ་བིད་ལ་འདི་སྐད་དུ། བདག་གིས་ཁྱོད་ཀྱི་ཚབ་ཏུ་ཁྱོད་ཀྱི་རྒྱལ་ཁྲིར་བསྐོ་བར་འགྱུར་བའི་བུ་དེས་ངའི་མིང་གི་ཕྱིར་མཆོད་ཁང་ཞིག་བཞེང་བར་བྱའོ་ཞེས་གསུངས་པ་བཞིན་དུ། གཟིགས་དང་། ངས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་ཕྱིར་མཆོད་ཁང་ཞིག་བཞེང་འདོད་པས།"]},{"type":"verse","number":6,"content":["ཁྱེད་ཀྱིས་དེའི་དོན་དུ་ལེ་པཱ་ནོན་ནས་ཐང་ཤིང་གཅོད་པའི་བཀའ་གནོངས་ཤིག ཡང་ངའི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཁྱེད་ཀྱི་འཁོར་གཡོག་རྣམས་དང་མཉམ་དུ་ལས་ཀ་བསྒྲུབ་བོ། །ཁྱེད་ཀྱི་འཁོར་གཡོག་རྣམས་ཀྱི་གླ་ཆ་ནི་ཁྱེད་ཀྱིས་གཏན་ལ་ཁེལ་བ་བཞིན་དུ་ངས་སྟེར་བར་བྱ། ཅིའི་ཕྱིར་ཞེ་ན། ངེད་རྣམས་ཀྱི་ཁྲོད་དུ་ཚི་ཏུན་པ་རྣམས་དང་འདྲ་བར་ཤིང་གཅོད་ཤེས་མཁན་གཅིག་ཀྱང་མེད་པ་ཁྱེད་ཀྱིས་མཁྱེན་ནོ་ཞེས་འཕྲིན་བསྐུར་ཏོ། །"]},{"type":"verse","number":7,"content":["ཧི་རཱམ་གྱིས་སོ་ལོ་མོན་གྱི་འཕྲིན་ཐོས་པ་ཙམ་གྱིས་སྤྲོ་བར་གྱུར་ཏེ་འདི་ལྟར། མི་ཚོགས་འདི་འདྲ་ཆེན་པོའི་རྗེ་བོར་འགྱུར་བའི་ཆེད་དུ། དཱ་བིད་ལ་འདི་འདྲའི་སྲས་ཤེས་རབ་ཅན་ཞིག་གནང་བས་ན། དེ་རིང་ཉིན་མོ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་ཅིང་བསྔགས་པར་གྱིས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་ཧི་རཱམ་གྱིས་སོ་ལོ་མོན་ལ་འཕྲིན་ལན་བསྐུར་བ་འདི་ལྟར། ཁྱེད་ཀྱིས་མི་མངགས་ནས་བདག་ལ་བསྐུར་བའི་འཕྲིན་རྣམས་ངས་ཐོས་པ་ཡིན། ཉིད་ཀྱི་ཐུགས་འདོད་ནང་བཞིན་ཐང་ཤིང་དང་གསོམ་ཤིང་གིས་རོགས་བྱེད་དོ། །"]},{"type":"verse","number":9,"content":["ངའི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཤིང་རྣམས་ལེ་པཱ་ནོན་ནས་རྒྱ་མཚོའི་འགྲམ་དུ་འབེབ་པར་བྱ། དེ་ནས་བདག་གིས་རྫིངས་བཟོས་ཏེ་ཆུ་ཐོག་བརྒྱུད་ནས་ཁྱེད་ཀྱིས་གཏན་ལ་ཁེལ་བའི་ཡུལ་དུ་བསྐྱལ་བར་བྱའོ། །དེར་བདག་གིས་རྫིངས་རྣམས་གཏོར་བར་བྱ་ཞིང་ཁྱེད་ཀྱིས་ཤིང་རྣམས་ཕར་འཁྱེར་ཆོག ཡང་ཁྱེད་ཀྱིས་ངའི་འདོད་མོས་བཞིན་དུ་བསྒྲུབས་ནས་བདག་གི་ཕོ་བྲང་གི་མི་རྣམས་ལ་འཚོ་ཆས་གནང་བར་མཁྱེན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཧི་རཱམ་གྱིས་སོ་ལོ་མོན་གྱིས་ཅི་འདོད་པ་བཞིན་དུ་ཁོ་ལ་ཐང་ཤིང་དང་གསོམ་ཤིང་བཏང་བ་དང་།"]},{"type":"verse","number":11,"content":["སོ་ལོ་མོན་གྱིས་ཀྱང་ཧི་རཱམ་གྱི་ཕོ་བྲང་གི་མི་རྣམས་ཀྱི་འཚོ་ཆས་ལ་གྲོ་ཁལ་ཉིས་ཁྲི་དང་། སྐྱུ་རུ་རའི་ཤིང་ལས་སྣུམ་བརྡུངས་མ་ཁལ་ཉི་ཤུ་བཅས་བཏང་ངོ་། །སོ་ལོ་མོན་གྱིས་ལོ་རེ་བཞིན་ཧི་རཱམ་ལ་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":12,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་སོ་ལོ་མོན་ལ་ཞལ་གྱིས་བཞེས་པ་བཞིན་དུ་ཤེས་རབ་གནང་སྟེ། ཧི་རཱམ་དང་སོ་ལོ་མོན་གཉིས་ཀྱི་བར་ལ་ཞི་བདེ་ཡོད་པས། དེ་གཉིས་ཀྱིས་ཕན་ཚུན་བར་ཆིངས་ཡིག་བཞག་གོ །"]},{"type":"verse","number":13,"content":["དེ་ནས་སོ་ལོ་མོན་གྱིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལས་ངལ་ལས་བྱེད་མཁན་བསྡུས་ཤིང་། ངལ་ལས་བྱེད་མཁན་བསྡོམས་པས་མི་སུམ་ཁྲི་ཡོད་པ་དང་།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་དེ་དག་ལས་རེས་བཞིན་དུ་ཟླ་བ་རེར་མི་ཆིག་ཁྲི་རེ་ལེ་པཱ་ནོན་དུ་བཏང་བས། དེ་དག་ལེ་པཱ་ནོན་དུ་ཟླ་གཅིག་དང་། ཁྱིམ་དུ་ཟླ་གཉིས་ལ་བསྡད་པ་དང་། ཨ་དོ་ནི་རཱམ་ནི་ངལ་ལས་པ་དེ་རྣམས་ཀྱི་སྤྱི་དཔོན་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["སོ་ལོ་མོན་ལ་རྡོག་ཁྲེས་ཁུར་མཁན་མི་བདུན་ཁྲི་དང་། རྡོ་བརྐོ་མཁན་མི་བརྒྱད་ཁྲི་ཡོད་པ་ཡིན་ལ།"]},{"type":"verse","number":16,"content":["དེ་མིན་སོ་ལོ་མོན་ལ་ད་དུང་ལས་ཀར་བལྟ་བའི་འགོ་དཔོན་སུམ་སྟོང་སུམ་བརྒྱ་ཡོད་པ་དེ་དག་གིས་ལས་ཀ་བྱེད་མཁན་རྣམས་ལ་ལྟ་རྟོག་བྱེད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["རྒྱལ་པོས་བཀའ་གནང་བ་དང་དེ་དག་གིས་རྡོ་ཆེན་པོ་རྩ་ཆེན་རྣམས་བཅད་ཅིང་གཏུབ་ནས། འཇམ་ཤ་བཏོད་པའི་རྡོ་ནི་མཆོད་ཁང་གི་རྨང་གཞི་བྱས་སོ། །"]},{"type":"verse","number":18,"content":["སོ་ལོ་མོན་གྱི་ལག་ཤེས་དང་། ཧི་རཱམ་གྱི་ལག་ཤེས། གེ་བལ་ཡུལ་གྱི་མི་རྣམས་བཅས་ཀྱིས་རྡོ་རྣམས་ལ་འཇམ་ཤ་བཏོད་པ་དང་། མཆོད་ཁང་བཞེང་བར་གདུང་མ་དང་རྡོ་རྣམས་གྲ་སྒྲིག་བྱས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1KI/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/4.json","previousChapterAudioLinks":{},"numberOfVerses":18}