{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":8,"content":[{"type":"heading","content":["ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་མཆོད་ཁང་ནང་དུ་གདན་དྲངས་པ།"]},{"type":"verse","number":1,"content":["སྐབས་དེར། སོ་ལོ་མོན་གྱིས་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་ཏེ་ཛ་ཡན་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཡར་གདན་འདྲེན་པའི་ཕྱིར་དུ། ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་དང་ཚོ་པ་སོ་སོའི་འགོ་དཔོན་རྣམས་དང་། ཁྱིམ་རྒྱུད་སོ་སོའི་འགོ་དཔོན་བཅས་ཐམས་ཅད་ཡེ་རུ་སཱ་ལེམ་དུ་རང་གི་དྲུང་དུ་བསྡུས་ཤིང་།"]},{"type":"verse","number":2,"content":["ཨེ་ཐན་ཟླ་བ་སྟེ་ཟླ་བདུན་པའི་དུས་ཆེན་ལ་",{"noteId":14},"ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་དྲུང་དུ་འཛོམས།"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་སླེབས་པ་ཙམ་གྱིས་མཆོད་དཔོན་རྣམས་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཁུར་ཏེ།"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་མཇལ་འཕྲད་གུར་མཆོག་དང་དེའི་ནང་དུ་ཡོད་པའི་ཡོ་བྱད་དམ་པ་ཐམས་ཅད་ཡར་གདན་དྲངས།"]},{"type":"verse","number":5,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་དང་དེར་འཛོམས་པའི་ཡེས་ར་ཨེལ་གྱི་མི་ཚོགས་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་མདུན་དུ་གླང་དང་ལུག་བགྲང་གིས་མི་ལང་བ་མཆོད་པར་ཕུལ་ཏོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་མཆོད་དཔོན་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དེ་མཆོད་ཁང་སྦུག་མ་སྟེ་གནས་དམ་མཆོག་གི་ནང་དུ། ཀེ་རུབ་གཉིས་ཀྱི་གཤོག་པའི་འོག་ཏུ་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཇོག་སའི་གནས་སུ་བཞག"]},{"type":"verse","number":7,"content":["ཀེ་རུབ་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་སྟེང་དུ་གཤོག་པ་བརྐྱངས་ནས། ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་དེ་ཁུར་བྱེད་ཀྱི་རྒྱུག་ཤིང་གཡོགས་སོ། །"]},{"type":"verse","number":8,"content":["རྒྱུག་ཤིང་དེ་གཉིས་ནི་ཤིན་ཏུ་རིང་བས། མཆོད་ཁང་སྦུག་མའི་མདུན་གྱི་གནས་དམ་པ་ནས་དེ་དག་གི་སྣེ་མོ་མཐོང་ཐུབ་པ་དང་། མཆོད་ཁང་ཕྱི་རོལ་ནས་མཐོང་མི་ཐུབ་ཅིང་། རྒྱུག་ཤིང་དེ་གཉིས་ནི་ད་ལྟའི་བར་དུ་དེར་ཡོད་པ་ཡིན།"]},{"type":"verse","number":9,"content":["ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནང་དུ་རྡོ་ལེབ་གཉིས་ལས་གཞན་ཅི་ཡང་མེད་དེ། རྡོ་ལེབ་དེ་གཉིས་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་རྗེས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ལ་ཞལ་ཆད་མཛད་པའི་དུས་སུ། མོ་ཤེ་ཡིས་རི་བོ་ཧོ་རེབ་ཏུ་དེའི་ནང་ལ་བཞག་པ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["མཆོད་དཔོན་རྣམས་གནས་དམ་པ་ནས་ཕྱི་རུ་ཐོན་པའི་ཚེ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་སྤྲིན་ཕུང་ཞིག་གིས་ཁྱབ་པར་གྱུར།"]},{"type":"verse","number":11,"content":["ཡང་སྤྲིན་ཕུང་དེའི་རྐྱེན་གྱིས་མཆོད་དཔོན་རྣམས་ཡར་ལངས་ནས་ཞབས་ཕྱི་བྱེད་མ་ཕོད་དེ། ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ཀྱིས་མཆོད་ཁང་དེར་ཁྱབ་པས་སོ། །"]},{"type":"verse","number":12,"content":["སྐབས་དེར་སོ་ལོ་མོན་ན་རེ། སྔར་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ནི་སྤྲིན་ནག་སྟུག་པོའི་ནང་དུ་གནས་པར་འགྱུར་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":13,"content":["ད་ནི་བདག་གིས་ཁྱེད་ལ་མཆོད་ཁང་བརྗིད་ཆགས་ཤིག་བཞེངས་ཏེ། ཁྱེད་དུས་གཏན་དུ་གནས་པའི་བཞུགས་གནས་ཡིན་ནོ་ཞེས་ཞུས་པའོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་རྒྱལ་པོ་ཞལ་ཚུར་འཁོར་ནས་ཡེས་ར་ཨེལ་གྱི་མི་ཚོགས་ལ་བྱིན་རླབས་གནང་བ་དང་དེ་རྣམས་ལངས་ནས་བསྡད།"]},{"type":"verse","number":15,"content":["སོ་ལོ་མོན་ན་རེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པར་འོས་སོ། །ཁོང་གིས་ངའི་ཡབ་དཱ་བིད་ལ་དངོས་སུ་ཞལ་བཞེས་གནང་བ་གང་ཞིག་ད་ནི་ཁོང་གི་ཕྱག་གིས་བསྒྲུབས་པར་མཛད་པའོ། །ཁོང་གིས་འདི་སྐད་དུ།"]},{"type":"verse","number":16,"content":["བདག་གིས་རང་གི་འབངས་མི་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པའི་ཉིན་མོ་ནས་བཟུང་། བདག་གི་མིང་དེར་གནས་པའི་ཆེད་དུ་མཆོད་ཁང་ཞིག་བཞེང་བར་ཡེས་ར་ཨེལ་པའི་ཚོ་པ་ཁག་གི་གྲོང་ཁྱེར་རྣམས་ལས་གང་ཡང་མ་འདེམས་མོད། འོན་ཀྱང་བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་དབང་སྒྱུར་བའི་ཆེད་དུ་དཱ་བིད་བདམས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":17,"content":["བདག་གི་ཡབ་དཱ་བིད་ཀྱི་སེམས་སུ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་ཕྱིར་མཆོད་ཁང་ཞིག་བཞེང་བའི་འདུན་པ་ཡོད་མོད།"]},{"type":"verse","number":18,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ཡབ་དཱ་བིད་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་སེམས་སུ་བདག་གི་མིང་ལ་མཆོད་ཁང་ཞིག་བཞེང་བའི་འདུན་པ་ཡོད་པ་ནི་ལེགས་སོ། །"]},{"type":"verse","number":19,"content":["འོན་ཀྱང་ཁྱོད་རང་གིས་མཆོད་ཁང་དེ་བཞེང་བར་མི་འགྱུར་ཏེ། ཁྱོད་ལས་སྐྱེས་པའི་བུ་ཡིས་བདག་གི་མིང་ལ་མཆོད་ཁང་དེ་བཞེང་བར་འགྱུར་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":20,"content":["ད་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་ནང་བཞིན་འགྲུབ་པར་མཛད་དེ། བདག་ནི་རང་གི་ཡབ་དཱ་བིད་ཀྱི་ཚབ་ཏུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲིར་བསྡད་ནས། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ལ་མཆོད་ཁང་འདི་བཞེངས་པ་ཡིན།"]},{"type":"verse","number":21,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་གི་ཕ་མེས་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་སྐབས་སུ་ཁོང་གིས་གནང་བའི་ཞལ་ཆད་ཡོད་པའི་ཤུར་སྒམ་དེའི་ཕྱིར་དུ། བདག་གིས་གནས་ཤིག་གྲ་སྒྲིག་བྱས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["སོ་ལོ་མོན་གྱིས་མཆོད་ཁང་བསྔོ་བའི་གསོལ་འདེབས།"]},{"type":"verse","number":22,"content":["དེ་ནས་སོ་ལོ་མོན་ནི་ཡེས་ར་ཨེལ་མི་ཚོགས་ཀྱི་མདུན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁྲིའི་དྲུང་དུ་ལངས་ནས་ལག་ཟུང་ནམ་མཁར་བཏེགས་ཏེ།"]},{"type":"verse","number":23,"content":["འདི་ལྟར། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། གནམ་ས་གཉིས་སུ་ཁྱེད་ལྟ་བུའི་དཀོན་མཆོག་སུ་ཡང་མེད། ཁྱེད་ཀྱི་སྤྱན་སྔར་བསམ་པ་རྩེ་གཅིག་གིས་ཁྱེད་ཀྱི་དྲུང་དུ་འགྲུལ་བའི་ཞབས་ཕྱི་རྣམས་ལ་ཁྱེད་ཀྱིས་ཞལ་ཆད་སྲུང་ཞིང་ཐུགས་རྗེས་གཟིགས་པ་ཡིན།"]},{"type":"verse","number":24,"content":["ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་སྟེ་བདག་གི་ཡབ་དཱ་བིད་ལ་གནང་བའི་ཞལ་བཞེས་བསྲུངས་ཏེ། ཁྱེད་ཀྱིས་ཅི་གསུངས་བཞིན་དེ་རིང་གི་ཉིན་མོར་ཉིད་ཀྱི་ཕྱག་གིས་བསྒྲུབས་པར་མཛད་དོ། །"]},{"type":"verse","number":25,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་སྟེ་བདག་གི་ཡབ་དཱ་བིད་ལ་ཞལ་བཞེས་གནང་སྟེ་འདི་སྐད་དུ། གལ་ཏེ་ཁྱོད་ཀྱི་བུ་རྒྱུད་ཀྱིས་རང་ཉིད་ཀྱི་ལམ་མ་ནོར་བར་ཁྱོད་ཀྱིས་བདག་གི་མདུན་དུ་ཅི་ལྟར་བྱས་པ་བཞིན་བྱེད་ན། ཁྱོད་ཀྱི་བུ་རྒྱུད་ལས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲིར་སྡོད་མཁན་ནམ་ཡང་མཚམས་མི་ཆད་ཅེས་གསུངས་པ་དེ་ཐུགས་སུ་འཛིན་པར་གསོལ།"]},{"type":"verse","number":26,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ལགས། ད་ལྟ་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་སྟེ་བདག་གི་ཡབ་དཱ་བིད་ལ་གནང་བའི་ཞལ་བཞེས་བསྒྲུབ་པར་མཛོད་ཅིག"]},{"type":"verse","number":27,"content":["འོན་ཀྱང་དཀོན་མཆོག་ནི་དངོས་སུ་ས་སྟེང་དུ་བཞུགས་པ་ཡིན་ནམ། གཟིགས་དང་། ནམ་མཁའ་དང་ནམ་མཁའི་ཡང་སྟེང་གི་ནམ་མཁར་ཡང་ཁྱེད་མི་ཤོང་བས། བདག་གིས་བཞེངས་པའི་མཆོད་ཁང་འདི་ནི་ལྟ་ཅི་སྨོས།"]},{"type":"verse","number":28,"content":["ཀྱེ་ང་ཡི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱིའི་སྨོན་ལམ་དང་ཞུ་བ་ལ་གསན་པར་མཛོད། དེ་རིང་ཉིན་མོར་ཁྱེད་ཀྱི་དྲུང་དུ་ཞུ་བའི་གསོལ་འདེབས་དང་འོ་དོད་ལ་གསན་དུ་གསོལ།"]},{"type":"verse","number":29,"content":["ཁྱེད་ཀྱི་སྤྱན་གྱིས་ཉིན་མཚན་དབྱེར་མེད་དུ་མཆོད་ཁང་འདི་ལ་གཟིགས་པར་མཛོད། ཁྱེད་ཀྱིས་བདག་གི་མིང་ནི་དེ་རུ་གནས་པར་འགྱུར་ཞེས་གསུངས་པའི་གནས་འདི་ལ་གཟིགས་པར་མཛོད། ཁྱེད་ཀྱི་ཞབས་ཕྱིས་གནས་འདིའི་ཕྱོགས་སུ་བཏབ་པའི་གསོལ་འདེབས་ལ་ཡང་གསན་པར་མཛོད།"]},{"type":"verse","number":30,"content":["དེ་ཡང་ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་དང་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་གྱིས་གནས་འདིའི་ཕྱོགས་སུ་གསོལ་བ་འདེབས་པའི་དུས་སུ། ཁྱེད་ཀྱིས་དེ་དག་གི་ཞུ་བར་གསན་དུ་གསོལ། ཁྱེད་ཀྱི་བཞུགས་གནས་ཏེ་ནམ་མཁའི་ཞིང་ཁམས་ནས་གསན་ཞིང་། གསན་པ་ཙམ་གྱིས་སྡིག་པ་བསལ་བར་མཛོད།"]},{"type":"verse","number":31,"content":["གལ་ཏེ་མི་ཞིག་གིས་རང་གི་ཁྱིམ་མཚེས་དང་འགལ་བའི་སྡིག་པ་བྱས་ཤིང་། གཞན་ཞིག་གིས་དེ་ལ་མནའ་འཁུར་དུ་འཇུག་པའི་ཕྱིར་མི་དེས་མཆོད་ཁང་འདིར་འོངས་ནས་ཁྱེད་ཀྱི་མཆོད་ཁྲིའི་མདུན་དུ་མནའ་སྐྱེལ་བའི་དུས་སུ།"]},{"type":"verse","number":32,"content":["ཁྱེད་ཀྱིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་དེར་གསན་ཏེ་ཞབས་ཕྱི་རྣམས་ལ་ཁྲིམས་ཐག་གཅོད་པར་མཛོད། ངན་པར་ཉེས་ཆད་བཅད་ནས་ཁོའི་ཉེས་པ་ཁོ་རང་གི་མགོ་ལ་འབེབ་པར་མཛོད། ཡང་ཉེས་མེད་ལ་དག་འབུད་མཛད་དེ་ཁོའི་དྲང་བདེན་བཞིན་གསོལ་རས་གནང་རོགས།"]},{"type":"verse","number":33,"content":["ཁྱེད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་གྱིས་ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་བྱས་པའི་རྐྱེན་གྱིས་ཕ་རོལ་དགྲ་ཡི་མདུན་དུ་ཕམ་པར་གྱུར་པའི་ཚེ། དེ་དག་ཕྱིར་འཁོར་ནས་ཁྱེད་ཀྱི་ཕྱོགས་སུ་ལོག་ཅིང་ཁྱེད་ཀྱི་མཚན་ཁས་བླངས་ཏེ། མཆོད་ཁང་འདི་རུ་ཁྱེད་ལ་གསོལ་བ་བཏབ་ནས་ཞུ་བ་འབུལ་བའི་དུས་སུ།"]},{"type":"verse","number":34,"content":["ཁྱེད་ཀྱིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་དེར་གསན་ཏེ་འབངས་མི་ཡེས་ར་ཨེལ་གྱི་སྡིག་པར་གུ་ཡངས་མཛད་ཅིང་། དེ་དག་གི་ཕ་མེས་རྣམས་ལ་གནང་བའི་ཡུལ་འདིར་ཕྱིར་འཁྲིད་པར་མཛོད།"]},{"type":"verse","number":35,"content":["དེ་དག་གིས་ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་བྱས་པའི་རྐྱེན་གྱིས་གནམ་གྱི་སྒོ་འགགས་ནས་ཆར་བ་འབབ་མཚམས་ཆད་པ་དང་། ཁོ་ཚོས་གནས་འདིའི་ཕྱོགས་སུ་སྨོན་ལམ་བཏབ་ནས་ཁྱེད་ཀྱི་མཚན་ཁས་བླངས་ཏེ། ཡང་ཁྱེད་ཀྱིས་ཁོ་རྣམས་སྡུག་ལ་སྦྱར་བས་རང་གི་སྡིག་པའི་ལམ་ནས་སེམས་བསྒྱུར་ན།"]},{"type":"verse","number":36,"content":["ཁྱེད་ཀྱིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་གསན་ཏེ། ཁྱེད་ཀྱི་ཞབས་ཕྱི་དང་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་པའི་སྡིག་པར་གུ་ཡངས་མཛད་པ་དང་། ཁོ་རྣམས་ལ་བགྲོད་འོས་པའི་ལམ་དྲང་པོ་དེ་སྟོན་ཞིང་། ཁྱེད་ཀྱི་འབངས་མི་ལ་ས་སྐལ་དུ་གནང་བའི་གནས་སུ་ཆར་བ་འབབ་པར་མཛོད་ཅིག"]},{"type":"verse","number":37,"content":["གལ་ཏེ་ཡུལ་འདིར་མུ་གེའམ་རིམས་ནད་དམ། སྐམ་རླུང་། གཡའ་སྤུ། ཆ་ག་པ། ཨ་ཚག་ཚག་པ་བཅས་ཡོད་པའམ། ཡང་ན་དགྲ་བོས་ཡུལ་ལྗོངས་བསྐོར་བ་དང་། བར་ཆད་དམ་ནད་ཡམས་ཅི་རིགས་འབྱུང་བའི་ཚེ།"]},{"type":"verse","number":38,"content":["མི་ཚོགས་སམ་མི་གང་རུང་སྟེ། ཁྱེད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་གྱིས་རང་གི་སེམས་ཀྱི་གདུང་བ་རྟོགས་ཏེ། མཆོད་ཁང་འདིའི་ཕྱོགས་སུ་ལག་པ་བཏེགས་ནས་སྨོན་ལམ་དང་འོ་དོད་འདོན་ན།"]},{"type":"verse","number":39,"content":["ཁྱེད་ཉིད་བཞུགས་སའི་ནམ་མཁའི་ཞིང་ཁམས་ནས་དེར་གསན་ཏེ་སྡིག་པ་བསལ་བར་མཛོད། ཁྱེད་ཀྱིས་མི་རེ་རེའི་སེམས་མཁྱེན་པས་དེའི་སྤྱོད་ལམ་བཞིན་དུ་བསྒྲུབས་ནས་ལན་གནོངས་ཤིག ཅིའི་ཕྱིར་ཞེ་ན། ཁྱེད་ཉིད་གཅིག་པུས་འཇིག་རྟེན་མིའི་རིགས་ཀྱི་སེམས་པ་མཁྱེན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":40,"content":["དེ་ལྟ་ན་ཁྱེད་ཀྱིས་ངེད་ཅག་གི་ཕ་མེས་རྣམས་ལ་གནང་བའི་ཡུལ་འདིར་ཁོ་རྣམས་ནམ་འཚོའི་བར་དུ་ཁྱེད་ལ་གུས་ཤིང་འཇིགས་པར་འགྱུར།"]},{"type":"verse","number":41,"content":["ཡང་ཁྱེད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་ལས་གཞན་པའི་མི་རིགས་ཤིག་ཀྱང་ཡུལ་ཐག་རིང་པོ་ནས་ཁྱེད་ཀྱི་མཚན་གྱི་དབང་གིས་འོངས་ཏེ།"]},{"type":"verse","number":42,"content":["ཅི་ལ་ཞེ་ན། དེ་དག་གིས་ཁྱེད་ཀྱི་རབ་ཏུ་འཕགས་པའི་མཚན་དང་། ཁྱེད་ཀྱི་ནུས་མཐུ་ལྡན་པའི་ཕྱག་དང་། ཁྱེད་ཀྱི་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་བའི་སྐོར་ཐོས་ནས་ཁོ་རྣམས་འོངས་ཏེ་མཆོད་ཁང་འདིའི་ཕྱོགས་སུ་སྨོན་ལམ་འདེབས་པའི་ཚེ།"]},{"type":"verse","number":43,"content":["ཁྱེད་ཉིད་བཞུགས་སའི་ནམ་མཁའི་ཞིང་ཁམས་ནས་དེར་གསན་ཏེ། མི་རིགས་གཞན་དེའི་ཞུ་བ་ཐམས་ཅད་བཞིན་དུ་མཛོད་ཅིག དེ་ལྟ་ན་ས་གཞི་འདིའི་མི་རིགས་ཀུན་གྱིས་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་བཞིན་དུ་ཁྱེད་ཀྱི་མཚན་རྟོགས་ཤིང་ཁྱེད་ལ་གུས་ཤིང་འཇིགས་པ་དང་། བདག་གིས་བཞེངས་པའི་མཆོད་ཁང་འདི་ནི་ཁྱེད་ཀྱི་མཚན་དང་ལྡན་པ་ཤེས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":44,"content":["ཡང་ཁྱེད་ཀྱིས་རང་གི་འབངས་མི་ཡུལ་ཕྱོགས་གང་དུ་མངགས་ཀྱང་ཁོ་རྣམས་ཕྱི་རུ་སོང་སྟེ་སོ་སོའི་དགྲ་བོར་གཡུལ་འགྱེད་ཅིང་། ཁོ་རྣམས་ཀྱིས་ཁྱེད་ཀྱིས་བདམས་པའི་གྲོང་ཁྱེར་དང་བདག་གིས་ཁྱེད་ཀྱི་མཚན་གྱི་དོན་དུ་བཞེངས་པའི་མཆོད་ཁང་འདིའི་ཕྱོགས་སུ་འཁོར་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱེད་ལ་སྨོན་ལམ་འདེབས་ན།"]},{"type":"verse","number":45,"content":["ཁྱེད་ཀྱིས་ནམ་མཁའ་ནས་དེ་དག་གི་གསོལ་འདེབས་དང་འོ་དོད་ལ་གསན་ཏེ་ཁོ་རྣམས་རྒྱལ་བར་མཛོད་ཅིག"]},{"type":"verse","number":46,"content":["གལ་ཏེ་ཁྱེད་ཀྱི་འབངས་མིས་ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་བྱེད་ཅིང་། སྡིག་པ་མི་བྱེད་པའི་མི་ནི་གང་དུའང་མེད་པས། ཁྱེད་ཉིད་ཁོ་རྣམས་ལ་ཐུགས་ཁྲོས་ཏེ་ཁོ་རྣམས་དགྲ་ཡི་ལག་ཏུ་སྤྲད་པ་དང་། དགྲ་བོས་ཁོ་རྣམས་ཐག་ཉེ་རིང་གང་དུ་བཙོན་ལ་ཁྲིད་ནས།"]},{"type":"verse","number":47,"content":["ཁོ་ཚོས་བཙོན་དུ་ཡོད་པའི་ཡུལ་ནས་བློ་ཁ་ཚུར་འཁོར་ཏེ། བཙོན་ལ་ཡོད་པའི་ཡུལ་དུ་ཁྱེད་ལ་འདི་ལྟར། ངེད་ཅག་གིས་སྡིག་པ་བྱས་ཤིང་། ངེད་ཅག་གིས་ཉེས་པ་བཟོས་པ་དང་། ངེད་ཅག་གིས་ལས་ངན་པ་བྱས་སོ་ཞེས་ཞུ་བ་ཕུལ་ན།"]},{"type":"verse","number":48,"content":["ཁོ་ཚོ་བཙོན་དུ་ཁྲིད་པའི་དགྲ་བོའི་ཡུལ་ནས་བློ་གཅིག་སེམས་གཅིག་གིས་ཁྱེད་ཀྱི་ཕྱོགས་སུ་འཁོར་ཏེ། ཁྱེད་ཀྱིས་ཁོ་ཚོའི་ཕ་མེས་རྣམས་ལ་གནང་བའི་ཡུལ་དང་། ཁྱེད་ཀྱིས་བདམས་པའི་གྲོང་ཁྱེར་དང་། བདག་གིས་ཁྱེད་ཀྱི་མཚན་གྱི་ཕྱིར་བཞེངས་པའི་མཆོད་ཁང་གི་ཕྱོགས་སུ་སྨོན་ལམ་འདེབས་ཚེ།"]},{"type":"verse","number":49,"content":["ཁྱེད་ཉིད་བཞུགས་སའི་ནམ་མཁའི་ཞིང་ཁམས་ནས་དེ་དག་གི་གསོལ་འདེབས་དང་ཞུ་བར་གསན་ཏེ། ཁོ་ཚོའི་དོན་དུ་ཁྲིམས་ཐག་གཅོད་པར་མཛོད་ཅིག"]},{"type":"verse","number":50,"content":["ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་བྱས་པའི་ཉིད་ཀྱི་འབངས་མི་དང་། ཁྱེད་དང་འགལ་བའི་ལས་ངན་པ་ཐམས་ཅད་ལ་དགོངས་དག་གནང་ནས། ཁོ་ཚོ་བཙོན་དུ་འཁྲིད་མཁན་གྱི་མདུན་དུ་ཁོ་ཚོར་ཐུགས་རྗེས་གཟིགས་པར་མཛོད།"]},{"type":"verse","number":51,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོ་རྣམས་ནི་ཁྱེད་ཀྱིས་ཨེ་ཅིབ་ཡུལ་ནས་མེ་ལྕགས་ཞུན་ཐབ་ཀྱི་དཀྱིལ་ནས་བཏོན་ཏེ་ཕྱི་རུ་ཁྲིད་འོངས་པ་དང་། ཁྱེད་ཀྱིས་བདག་ཏུ་མཛད་པའི་འབངས་མི་ལགས་སོ། །"]},{"type":"verse","number":52,"content":["ཁྱེད་ཀྱི་སྤྱན་ཟུང་གིས་ཉིད་ཀྱི་ཞབས་ཕྱིའི་ཞུ་བ་དང་། ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་གྱི་ཞུ་བར་གཟིགས་པར་མཛོད། དེ་དག་གིས་འོ་དོད་ཞུ་བ་ཐམས་ཅད་ལ་ཁྱེད་ཀྱིས་གསན་པར་མཛོད།"]},{"type":"verse","number":53,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་བདག་ཅག་གི་ཕ་མེས་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོང་བའི་དུས་སུ། ཉིད་ཀྱི་ཞབས་ཕྱི་མོ་ཤེ་བརྒྱུད་ནས་ཞལ་བཞེས་གནང་བ་བཞིན་དུ། ཁོ་རྣམས་ས་སྟེང་གི་མི་ཀུན་གྱི་ཁྲོད་ནས་ཉིད་ཀྱི་བདག་ཏུ་མཛད་པའི་འབངས་མི་བྱས་པའི་ཕྱིར་རོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":54,"content":["དེ་ནས་སོ་ལོ་མོན་གྱིས་མཆོད་ཁྲིའི་མདུན་དུ་པུས་མོ་སར་བཙུགས་ནས་ལག་པ་གནམ་ལ་བརྐྱངས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྨོན་ལམ་དང་ཞུ་བ་འདི་ཐམས་ཅད་ཕུལ་ནས་རྫོགས་པ་ན།"]},{"type":"verse","number":55,"content":["ཁོ་རང་ཡར་ལངས་ནས་དེར་འཛོམས་པའི་ཡེས་ར་ཨེལ་གྱི་མི་ཚོགས་ལ་བྱིན་གྱིས་བརླབས་ཤིང་སྐད་ཆེན་པོས་འདི་ལྟར།"]},{"type":"verse","number":56,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་ཅིང་བསྔགས་པར་གྱིས། ཁོང་གིས་ཉིད་ཀྱི་ཞབས་ཕྱི་མོ་ཤེ་བརྒྱུད་ནས་མཛད་པའི་ཞལ་བཞེས་བཟང་པོ་ལས་གསུང་གཅིག་ཀྱང་མ་ཆད་པར། ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་ངལ་གསོ་གནང་བ་ཡིན།"]},{"type":"verse","number":57,"content":["བདག་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་རང་ཅག་གི་ཕ་མེས་རྣམས་དང་མཉམ་དུ་བཞུགས་པ་ལྟར་བདག་ཅག་དང་མཉམ་དུ་བཞུགས་པར་ཤོག ཁོང་གིས་བདག་ཅག་མི་འདོར་མི་བསྐྱུར་བར་ཤོག"]},{"type":"verse","number":58,"content":["ཡང་བདག་ཅག་ཁོང་གི་སྤྱོད་ལམ་དུ་འགྲུལ་བ་དང་ཕ་མེས་རྣམས་ལ་གནང་བའི་བཀའ་རྒྱ་དང་། སྒྲིག་ཁྲིམས་དང་། ཁྲིམས་སྲོལ་རྣམས་བསྲུང་བའི་ཕྱིར་དུ། ཁོང་གིས་བདག་ཅག་གི་སེམས་ནི་ཉིད་ཀྱི་ཕྱོགས་སུ་བསྒྱུར་བར་གྱུར་ཅིག"]},{"type":"verse","number":59,"content":["བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཕུལ་བའི་ཞུ་ཚིག་འདི་རྣམས་ཉིན་མཚན་ཀུན་ཏུ་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་མི་འབྲལ་བར་གྱུར་ཅིག ཁོང་གིས་ཉིད་ཀྱི་ཞབས་ཕྱི་བདག་དང་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་པའི་དོན་དུ་ཉིན་རེ་བཞིན་ཁྲིམས་ཐག་གཅོད་པར་མཛོད་ཅིག"]},{"type":"verse","number":60,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ས་སྟེང་གི་མི་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཀོན་མཆོག་ལགས་ཤིང་། ཁོང་མ་གཏོགས་དཀོན་མཆོག་གཞན་སུ་ཡང་མེད་པ་རྟོགས་པའི་ཕྱིར་དུའོ། །"]},{"type":"verse","number":61,"content":["དེའི་ཕྱིར་ཁྱོད་ཅག་ཁོང་གི་སྒྲིག་ཁྲིམས་བཞིན་དུ་འགྲུལ་བ་དང་། དེ་རིང་ནང་བཞིན་ཁོང་གི་བཀའ་རྒྱ་རྣམས་བསྲུང་བའི་དོན་དུ། ཁྱོད་ཅག་གི་སེམས་ནི་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཡོངས་སུ་འབུལ་བར་གྱིས་ཤིག་ཅེས་བསྐུལ་བའོ། །"]},{"type":"heading","content":["མཆོད་ཁང་དམ་པར་བསྔོ་བ།"]},{"type":"verse","number":62,"content":["རྒྱལ་པོ་དང་ཁོང་དང་ལྷན་དུ་གནས་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མཆོད་པ་ཕུལ་ཞིང་།"]},{"type":"verse","number":63,"content":["སོ་ལོ་མོན་གྱིས་གླང་ཉིས་ཁྲི་ཉིས་སྟོང་དང་། ར་ལུག་ཆིག་འབུམ་ཉིས་ཁྲི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞི་བདེའི་མཆོད་པར་ཕུལ་བ་དང་། རྒྱལ་པོ་དང་ཡེས་ར་ཨེལ་གྱི་མི་ཚོགས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བསྔོ་བའི་མཛད་སྒོ་སྤེལ་ཏོ། །"]},{"type":"verse","number":64,"content":["ཉིན་དེར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཡོད་པའི་ལི་ཡི་མཆོད་ཁྲི་དེ་ཆུང་དྲགས་པས། སྦྱིན་སྲེག་དང་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། ཞི་བདེའི་མཆོད་པའི་ཚིལ་རྣམས་མ་ཤོང་བ་རེད། དེ་ནས་རྒྱལ་པོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་མདུན་དུ་ཡོད་པའི་ར་སྐོར་གྱི་དཀྱིལ་དབུས་དེ་དམ་པར་བྱས་པ་དང་། གནས་དེར་སྦྱིན་སྲེག་དང་འབྲུ་རིགས་ཀྱི་མཆོད་པ། ཞི་བདེའི་མཆོད་པ་རྣམས་ཀྱི་ཚིལ་བཅས་ཕུལ་ཏོ། །"]},{"type":"verse","number":65,"content":["དེའི་དུས་སུ་སོ་ལོ་མོན་དང་ལེ་བོ་ཧ་མཱད་ནས་ཨེ་ཅིབ་ཡུལ་གྱི་གཙང་པོའི་བར་གྱི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས། རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་བདུན་ཕྲག་གཉིས་ཏེ་ཉི་མ་བཅུ་བཞིའི་རིང་ལ་དགའ་སྟོན་གཟབ་རྒྱས་བྱས།"]},{"type":"verse","number":66,"content":["ཉིན་བརྒྱད་པར་",{"noteId":15},"རྒྱལ་པོས་མི་ཚོགས་འགྲོ་རུ་བཅུག་པ་ལ། ཁོ་ཚོས་རྒྱལ་པོར་སྨོན་འདུན་ཞུས་ནས་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་རང་རང་གི་ཡུལ་དུ་ལོག་གོ །ཁོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞབས་ཕྱི་དཱ་བིད་དང་། ཁོང་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་མཛད་པའི་བཀའ་དྲིན་རྣམས་མཇལ་ཞིང་སེམས་ལ་དགའ་སྤྲོ་སྐྱེས་སོ། །"]}],"footnotes":[{"noteId":14,"caller":"+","text":"ཚིག་རྐང་འདིའི་ནང་གི་ཟླ་བདུན་པ་ཞེས་པ་དེ་ཡེས་ར་ཨེལ་པའི་ལུགས་ཀྱི་ཟླ་བདུན་པར་གོ་བ་ལས་རྒྱ་རྩིས་དང་བོད་རྩིས་ཀྱི་ཟླ་བདུན་པར་གོ་བ་མིན། ཟླ་བདུན་པ་ནི་རྒྱ་རྩིས་ཀྱི་ཟླ་དགུ་བ་ནས་བཅུ་པའི་བར་ཡིན།","reference":{"chapter":8,"verse":2}},{"noteId":15,"caller":"+","text":"ཚིག་རྐང་འདིའི་ནང་གི་ཉིན་བརྒྱད་པ་ནི་གཟའ་འཁོར་གཉིས་ཀྱི་རིང་ལ་བྱས་པའི་དགའ་སྟོན་གྱི་ཉིན་མོ་ཐ་མའམ་ཉིན་གྲངས་བརྒྱད་པ་སྟེ། དགའ་སྟོན་རྗེས་ཀྱི་ཉིན་མོ་དེ་ལ་གོ་བ་ཡིན།","reference":{"chapter":8,"verse":66}}]},"thisChapterLink":"/api/bod_ntb/1KI/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/7.json","previousChapterAudioLinks":{},"numberOfVerses":66}