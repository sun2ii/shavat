{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་དང་པོ།","commonName":"རྒྱལ་རབས་དང་པོ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་དང་པོ།","order":11,"numberOfChapters":22,"sha256":"2db003c8e72fc25c95e7933ab8c51de5fb6eddbd7a51ad7d4b92cb3244aea3aa","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/1KI/22.json","totalNumberOfVerses":815},"chapter":{"number":9,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཡང་བསྐྱར་སོ་ལོ་མོན་ལ་མངོན་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་རྒྱལ་པོའི་ཕོ་བྲང་། དེ་མིན་བསྒྲུབ་འདོད་པ་ཐམས་ཅད་བསྒྲུབས་ཚར་རྗེས།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་སྔོན་ཆད་གིབ་ཡོན་ཡུལ་དུ་སོ་ལོ་མོན་ལ་མངོན་པ་ལྟར། ཐེངས་གཉིས་པར་ཁོང་ལ་མངོན་པ་སྟེ།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བདག་གི་མདུན་དུ་སྨོན་ལམ་བཏབ་པ་དང་ཞུ་བ་ཕུལ་བ་རྣམས་བདག་གིས་ཐོས་བྱུང་། བདག་གི་མིང་མཆོད་ཁང་འདིའི་ནང་རྟག་ཏུ་གནས་པའི་ཕྱིར། ཁྱོད་ཀྱིས་བཞེངས་པའི་མཆོད་ཁང་འདི་བདག་གིས་དམ་པར་བྱས་ཤིང་བདག་གི་མིག་དང་སེམས་གཉིས་རྟག་ཏུ་འདི་རུ་གནས་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["ཡང་ཁྱོད་ལ་མཚོན་ན། ཁྱོད་ཀྱི་ཕ་དཱ་བིད་ཀྱིས་གཞུང་རྒྱུད་དྲང་པོ་དང་དྲང་བདེན་གྱི་ངང་ནས་སྤྱད་པ་ལྟར། ཁྱོད་ཀྱིས་ཀྱང་ངའི་མདུན་དུ་དེ་ལྟར་བྱས་ནས། བདག་གིས་ཁྱོད་ལ་བསྒོས་པ་ཐམས་ཅད་དང་མཐུན་པར་སྤྱོད་ཅིང་། བདག་གི་སྒྲིག་ཁྲིམས་དང་ཁྲིམས་སྲོལ་རྣམས་བསྲུངས་ན།"]},{"type":"verse","number":5,"content":["བདག་གིས་ཁྱོད་ཀྱི་ཕ་དཱ་བིད་ལ་འདི་ལྟར། ཁྱོད་ཀྱི་བུ་རྒྱུད་ལས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲིར་སྡོད་པའི་རྒྱལ་རྒྱུད་ནམ་ཡང་རྒྱུན་ཆད་པར་མི་འགྱུར་རོ་ཞེས་ཁས་བླངས་པ་བཞིན་དུ། བདག་གིས་ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་ལ་དབང་སྒྱུར་བའི་རྒྱལ་ཁྲི་རྟག་ཏུ་བརྟན་པོ་འོང་བར་བྱའོ། །"]},{"type":"verse","number":6,"content":["གལ་ཏེ་ཁྱོད་རང་ངམ་ཁྱོད་ཀྱི་བུ་རྒྱུད་རྣམས་ང་དང་ཁ་བྲལ་ནས་བདག་གི་རྗེས་སུ་མི་འབྲང་བ་དང་། བདག་གིས་ཁྱོད་རྣམས་ལ་བསྩལ་བའི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས་རྣམས་མི་བསྲུང་བར། ལྷ་གཞན་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབས་ནས་དེ་དག་ལ་བསྙེན་བཀུར་བྱས་ན།"]},{"type":"verse","number":7,"content":["བདག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གནང་བའི་ཡུལ་འདི་ནས་ཁོ་ཚོ་མེད་པར་བཟོ་བ་དང་། ཐ་ན་བདག་གི་མིང་གི་ཕྱིར་དམ་པར་བྱས་པའི་མཆོད་ཁང་འདི་ཡང་བདག་གི་མིག་ལམ་ནས་འདོར་བར་བྱ་ཞིང་། ཡེས་ར་ཨེལ་པ་རྣམས་ནི་མི་ཐམས་ཅད་ཀྱི་ནང་དུ་གད་མོའི་གནས་དང་འཕྱ་དམོད་བྱ་ཡུལ་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":8,"content":["ཡང་མཆོད་ཁང་འདི་ཞིག་རལ་དུ་འགྱུར་ཞིང་། དེའི་མདུན་ནས་འགྲོ་མཁན་ཐམས་ཅད་ཧ་ལས་ནས་འཕྱ་དགོད་བྱེད་ཀྱིན་དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་འདི་དང་མཆོད་ཁང་འདི་ལ་འདི་ལྟར་མཛད་དོན་ཅི་ཡིན་ནམ་ཞེས་སྨྲ་ཞིང་།"]},{"type":"verse","number":9,"content":["མི་རྣམས་ཀྱིས་དེའི་ལན་དུ། ཁོ་ཚོས་རང་གི་ཕ་མེས་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོང་མཁན་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་ཤིང་། ལྷ་རྣམས་ལ་བརྟེན་ནས་དེ་དག་ལ་ཕྱག་བཙལ་བ་དང་ཞབས་ཏོག་བསྒྲུབས་པའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེས་བར་ཆད་འདི་ཐམས་ཅད་ཁོ་ཚོའི་ཐོག་ཏུ་ཕབ་པ་རེད་ཅེས་སྨྲ་བར་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["སོ་ལོ་མོན་གྱི་འཕྲིན་ལས་གཞན་དག"]},{"type":"verse","number":10,"content":["སོ་ལོ་མོན་གྱིས་བགྲང་བྱ་ཉི་ཤུའི་རིང་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་རྒྱལ་པོའི་ཕོ་བྲང་གཉིས་ཀ་བཞེངས་པ་དང་།"]},{"type":"verse","number":11,"content":["ཐཱར་གྱི་རྒྱལ་པོ་ཧི་རཱམ་གྱིས་སོ་ལོ་མོན་གྱི་འདོད་པ་བཞིན་དུ་ཐང་ཤིང་དང་། གསོམ་པ། གསེར་བཅས་ཀྱིས་ཁོང་ལ་རོགས་བྱས་པས། ཁོང་གིས་ག་ལིལ་ཡུལ་གྱི་གྲོང་ཁྱེར་ཉི་ཤུ་ཧི་རཱམ་ལ་སྤྲད་དོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་ཧི་རཱམ་ནི་ཐཱར་ནས་ཐོན་ཏེ་སོ་ལོ་མོན་གྱིས་སྤྲད་པའི་གྲོང་ཁྱེར་རྣམས་ལ་བལྟས་པའི་ཚེ། དེ་རྣམས་ཁོའི་མིག་ལ་མ་རན་པ་རེད།"]},{"type":"verse","number":13,"content":["དེ་བས་ཁོས་འདི་ལྟར། ངའི་མཆེད་གྲོགས་ལགས། འདི་དག་ནི་ཁྱེད་ཀྱིས་ང་ལ་སྤྲད་པའི་གྲོང་ཁྱེར་རྣམས་ཡིན་ནམ་ཞེས་དྲིས་ཤིང་། དེ་དག་གི་མིང་ལ་ཀ་བུལ་",{"noteId":16},"ཞེས་མིང་བཏགས་པ་དེ་རིང་བར་དུ་ལུས་པ་ཡིན།"]},{"type":"verse","number":14,"content":["ཧི་རཱམ་གྱིས་སོ་ལོ་མོན་ལ་གསེར་རྡོ་ཚད་ཆིག་བརྒྱ་ཉི་ཤུ་བརྫངས་སོ། །"]},{"type":"verse","number":15,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་། རྒྱལ་པོ་རང་གི་ཕོ་བྲང་དང་། འཛིངས་རགས་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་མཁར་གྱང་དང་། ཧ་ཟོར་དང་། མེ་གིད་དོ་དང་། གེ་ཟེར་བཅས་བརྩིག་པར་ངལ་རྩོལ་པ་བསྡུས་པ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":16,"content":["སྔར་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱིས་དམག་བཏང་ནས་གེ་ཟེར་བླངས་ཏེ་མེ་ལ་བསྲེགས་པ་དང་། གྲོང་ཁྱེར་དེར་གནས་པའི་ཀ་ན་ཨན་པ་རྣམས་བསད་དེ། སོ་ལོ་མོན་གྱི་བཙུན་མོ་སྟེ་རང་གི་སྲས་མོ་ལ་གྲོང་ཁྱེར་དེ་གསོལ་རས་སུ་བཏང་བས།"]},{"type":"verse","number":17,"content":["སོ་ལོ་མོན་གྱིས་གེ་ཟེར་དང་། པེད་ཧོ་རོན་འོག་མ་དང་།"]},{"type":"verse","number":18,"content":["པཱ་ཨ་ལད་དང་། ཡ་ཧུ་དཱའི་དབེན་སྟོང་གི་ཐད་མོར་བྱ་བ་དང་།"]},{"type":"verse","number":19,"content":["སོ་ལོ་མོན་ལ་མངའ་བའི་བང་མཛོད་ཀྱི་གྲོང་ཁྱེར་དང་། ཤིང་རྟའི་གྲོང་ཁྱེར་དང་། སྐྱ་དམག་གི་གྲོང་ཁྱེར་བཅས་ཐམས་ཅད་དང་། ཡེ་རུ་སཱ་ལེམ་དང་ལེ་པཱ་ནོན་དང་། རང་གི་སྲིད་འོག་གི་ཡུལ་ཀུན་ཏུ་སོ་ལོ་མོན་གྱིས་བརྩིག་འདོད་པ་ཐམས་ཅད་བསྐྱར་གསོ་བགྱིས་པའོ། །"]},{"type":"verse","number":20,"content":["ཡང་ཡེས་ར་ཨེལ་པ་མ་ཡིན་པའི་ཨེ་མོར་པ་དང་། ཧེད་པ་དང་། ཕེ་རེ་ཟི་པ་དང་། ཧེ་བི་པ་དང་། ཡེ་བུ་སི་པ་བཅས་ཀྱི་ལྷག་ལུས་ཐམས་ཅད་དེ།"]},{"type":"verse","number":21,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཁྱོན་ནས་འཇོམ་མ་ནུས་པའི་དེ་དག་གི་བུ་རྒྱུད་རྣམས་ནི། སོ་ལོ་མོན་གྱིས་ངལ་ལས་བྱེད་པའི་བྲན་གཡོག་ཏུ་བསྡུས་པ་དང་། དེ་རིང་གི་བར་དུ་དེ་ལྟར་ཡིན།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་སོ་ལོ་མོན་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ནི་བྲན་གཡོག་བྱེད་དུ་མ་བཅུག་པར་དེ་རྣམས་ནི་དམག་མི་དང་། བློན་འཁོར། དམག་དཔོན། དེད་དཔོན། ཁོང་གི་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་ཀྱི་འགོ་དཔོན་བཅས་བྱེད་དུ་བཅུག་གོ །"]},{"type":"verse","number":23,"content":["སོ་ལོ་མོན་གྱི་ལས་ཀ་བྱེད་མཁན་དག་གི་གོང་དུ་འགོ་དཔོན་ལྔ་བརྒྱ་ལྔ་བཅུ་ཡོད་ལ། དེ་དག་གིས་ལས་ཀ་བྱེད་པའི་མི་རྣམས་ལ་བལྟས་སོ། །"]},{"type":"verse","number":24,"content":["ཕཱར་ཨོལ་གྱི་སྲས་མོ་ནི་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་ནས་སོ་ལོ་མོན་གྱིས་མོའི་དོན་དུ་བཞེངས་པའི་གླིང་ཀ་རུ་སྤར་རྗེས། སོ་ལོ་མོན་གྱིས་འཛིངས་རགས་བསྐྱར་གསོ་མཛད་དོ། །"]},{"type":"verse","number":25,"content":["སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་བཞེངས་པའི་མཆོད་ཁྲིའི་ཁར་ལོ་རེར་ཐེངས་གསུམ་ལ་སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་ཕུལ་ཞིང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་བདུག་སྤོས་ཀྱང་བདུགས་ཤིང་མཆོད་ཁང་དེ་འགྲུབ་པར་བྱས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཨེ་དོམ་ཡུལ་གྱི་རྒྱ་མཚོ་དམར་པོའི་འགྲམ་ནས་ཨེ་ལོད་དང་ཐག་ཉེ་བའི་ཨེ་ཙི་ཡོན་གེ་བེར་ཞེས་པར་གྲུ་གཟིངས་རྣམས་བཟོས་པའོ། །"]},{"type":"verse","number":27,"content":["ཧི་རཱམ་གྱིས་རང་གི་ཞབས་ཕྱི་སྟེ་རྒྱ་མཚོར་རྒྱུས་ཡོད་པའི་གྲུ་པ་རྣམས་སོ་ལོ་མོན་གྱི་ཞབས་ཕྱི་དང་མཉམ་དུ་བཏང་བ་དང་།"]},{"type":"verse","number":28,"content":["དེ་དག་ཨོ་ཕིར་བྱ་བར་ཕྱིན་ཏེ། ཡུལ་དེ་ནས་གསེར་རྡོ་ཚད་བཞི་བརྒྱ་ཉི་ཤུ་བླངས་ནས་རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་དྲུང་དུ་བསྐྱལ་ཏོ། །"]}],"footnotes":[{"noteId":16,"caller":"+","text":"ཀ་བུལ་ཞེས་པ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་སྐད་ཡིན་ལ། རིན་ཐང་ཅི་ཡང་མེད་པ་ཞེས་པའི་དོན་ལ་འཇུག","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/bod_ntb/1KI/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/8.json","previousChapterAudioLinks":{},"numberOfVerses":28}