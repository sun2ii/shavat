{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1PE","translationId":"bod_ntb","name":"པེ་ཏྲོ་དང་པོ།","commonName":"པེ་ཏྲོ་དང་པོ།","title":"༄༅། །པེ་ཏྲོའི་འཕྲིན་ཡིག་དང་པོ།","order":60,"numberOfChapters":5,"sha256":"1fe3f5562d188ec552374aae577c049ce9055d9cf12ef3212a6cd9e1faf8ddf4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1PE/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/1PE/5.json","totalNumberOfVerses":104},"chapter":{"number":1,"content":[{"type":"heading","content":["འཕྲིན་ཡིག་འབྱོར༌ཡུལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་པེ་ཏྲོ་ང་རང་ནི་ཡེ་ཤུ་མཱ་ཤི་ཀའི་སྐུ་ཚབ་པ་ཞིག་ཡིན་ཞིང་། འཕྲིན་ཡིག་འདི་ནི་ཕོན་ཐུ་དང༌། ག་ལད༌ཡཱ། ཀ་པ་ཏོ་ཡཱ། ཨེ་ཞི༌ཡཱ། པི་ཐིན་ཡཱ་ཡུལ་བཅས་ལ་ཐར་ཐོར་དུ་བྱེས་སུ་སྡོད་པ་རྣམས་ལ་སྤྲིངས་པའོ།།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཅག་ནི་ཡེ་ཤུ་མཱ་ཤི་ཀའི་བཀའ་བརྩི་བ་དང་ཁོང་གི་སྐུ་ཁྲག་གཏོར་ཡུལ་ཡིན་པའི༌ཕྱིར། ཡབ་དཀོན་མཆོག་གིས་སྔ་མོ་ནས་མཁྱེན་པ་བཞིན་དུ་བདམས་ཤིང་། དམ་པའི་ཐུགས་ཉིད་བརྒྱུད་ནས་དམ་པར་མཛད་པའི་མི་རྣམས་ཡིན། ཁྱོད་ཅག་ལ་ཐུགས་རྗེ་དང་ཞི་བདེ་མང་དུ་གནང་བར༌སྨོན།"]},{"type":"heading","content":["དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པ།"]},{"type":"verse","number":3,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཡབ་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པར༌བྱའོ།། ཁོང་གིས་རང་ཉིད་ཀྱི་ཐུགས་རྗེ་ཆེན་པོ་བཞིན། ཡེ་ཤུ་མཱ་ཤི་ཀ་སྐུ་གྲོངས་པ་ནས་སླར་གསོན་པར་མཛད་པ་བརྒྱུད་ནས། བདག་ཅག་ལ་རེ་བ་གསོན་པོ་ལྡན་པའི་ཆེད་དུ། བདག་ཅག་ཡང་བསྐྱར་སྐྱེས་པར་མཛད་དེ།"]},{"type":"verse","number":4,"content":["བདག་ཅག་ལ་འཇིག་པ་མེད་པ་དང་། ནག་ནོག་གི་དྲི་མས་མ་གོས༌པ། ཉམས་པར་མི་འགྱུར༌བ། ནམ་མཁའི་ཞིང་ཁམས་སུ་ཉར་ཚགས་བྱས་ཡོད་པ་བཅས་ཀྱི་བགོ་སྐལ་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ལ་སྟ་གོན་མཛད་པ་དང་དུས་ཀྱི་མཐའ་མར་མངོན་པར་འགྱུར་བའི་ཐར་པ་དེ་འཐོབ་པའི་ཆེད་དུ། ད་ལྟ་ཁྱོད་ཅག་ནི་དད་པའི་སྒོ་ནས་དཀོན་མཆོག་གི་ནུས་མཐུས་སྲུང་བར་མཛད་དོ།།"]},{"type":"verse","number":6,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་ལ་དགའ་སྤྲོ་ཆེན་པོ་ལྡན་ཡང་། ད་ལྟ་དཀའ་སྡུག་སྣ་ཚོགས་ཀྱི་ཁྲོད་དུ་གནས་སྐབས་སུ་ཡིད་གདུང་དགོས་པ་ཡིན།"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱི་དད་པར་ཚོད་བརྟག་བྱེད་པ་དེ་ནི། མེས་བཙོ་སྦྱང་བྱས་ནའང་འཇིག་པར་འགྱུར་བའི་གསེར་ལས་ཀྱང་རིན་ཆེན་པོར་སྣང༌ཞིང༌། ཡེ་ཤུ་མཱ་ཤི་ཀ་མངོན་སུམ་དུ་ཕེབས་པའི་དུས་སུ། དད་པ་དེ་ལ་བསྔགས་བརྗོད་དང་། གཟི༌བརྗིད། བརྩི་མཐོང་བཅས་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁོང་ཉིད་དངོས་སུ་མཐོང་མ་མྱོང་ཡང་གཅེས་སུ་འཛིན་པར་བྱེད། ད་ལྟ་ཁོང་ཉིད་མ་མཐོང་ཡང་ཁོང་ལ་དད་པ་བྱས་པའི་རྐྱེན་གྱིས། བརྗོད་ཀྱིས་མི་ལང་བ་དང་གཟི་བརྗིད་ལྡན་པའི་དགའ་སྤྲོ་ཆེན་པོ་ཡོད་པར་མ༌ཟད།"]},{"type":"verse","number":9,"content":["ཁྱོད་ཅག་གི་དད་པའི་འབྲས་བུ་སྟེ། རྣམ་ཤེས་ལ་ཐར་པ་འཐོབ་པར་འགྱུར་རོ།།"]},{"type":"verse","number":10,"content":["ཐར་པ་འདིའི་སྐོར་གླེང་བ་ཡིན་ན། སྔོན་ཆད་ཁྱོད་ཅག་ལ་ཐུགས་རྗེ་འཐོབ་པར་འགྱུར་ཞེས་གསུང་མཁན་ཏེ། ལུང་སྟོན་པ་རྣམས་ཀྱིས་སྔར་ནས་འཚོལ་རྟོག་དང་བརྟག་དཔྱད་ཞིབ་མོ་བྱས་མྱོང་ངོ་།།"]},{"type":"verse","number":11,"content":["དེ་ནི་ཁོ་རྣམས་ཀྱི་སེམས་ཁོང་དུ་ཡོད་པའི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཐུགས་ཉིད་ཀྱིས། སྐྱབས་མགོན་མཱ་ཤི་ཀས་སྡུག་བསྔལ་མྱང་བར་འགྱུར་བ་དང་ཕྱིས་སུ་གཟི་བརྗིད་འཐོབ་པར་འགྱུར་བར་སྔ་མོ་ནས་བདེན་དཔང་བྱས་ཏེ། དུས་ནམ་ཞིག་དང་དུས་ཅི་ལྟ་བུ་ཞིག་ཡིན་པ་ལ་བརྟག་དཔྱད་བྱས་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ཡང་ཁོ་རྣམས་ལ་མངོན་པར་མཛད་པ༌བཞིན། ཁོ་རྣམས་ཀྱིས་རང་གི་དོན་དུ་མ་ཡིན་པར་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་ཞབས་ཕྱི་བསྒྲུབས་ཤིང་། ནམ་མཁའི་ཞིང་ཁམས་ནས་མངགས་ཡོང་བའི་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན༌ནས་ཁྱོད་རྣམས་ལ་འཕྲིན་བཟང་སྒྲོག་མཁན་རྣམས་ཀྱིས། ད་ལྟ་དོན་དེ་རྣམས་ཁྱོད་ཅག་ལ་བསྒྲགས་པ་དང༌། ཐ་ན་ཕོ་ཉ་རྣམས་ཀྱིས་ཀྱང་དོན་འདི་དག་ལ་ཞིབ་ཏུ་བརྟག་པར་དགོངས་སོ།།"]},{"type":"heading","content":["དམ་པ་ཡིན་དགོས་པའི༌སྐོར།"]},{"type":"verse","number":13,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་གིས་རང་གི་སེམས་གཅུན་ཞིང་རང་ཚོད་ཟིན་དགོས་པ༌དང༌། ཡེ་ཤུ་མཱ་ཤི་ཀ་མངོན་སུམ་དུ་ཕེབས་པའི་དུས༌སུ། ཁྱོད་རྣམས་ལ་གནང་ངེས་པའི་ཐུགས་རྗེ་ལ་བློ་སེམས་རྩེ་གཅིག་གིས་རེ་བ་གཟུང་དགོས་སོ།།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ནི་བཀའ་བརྩི་བའི་བུ་ཕྲུག་ཡིན་པ་བཞིན། སྔོན་ཆད་རྨོངས་པའི་དུས་ཀྱི་འདོད་ཆགས་བཞིན་དུ་མ་བྱེད༌ཅིག"]},{"type":"verse","number":15,"content":["དེ་ལས་ལྡོག་སྟེ་ཁྱོད་ཅག་ལ་ཞལ་འབོད་གནང་མཁན་ནི་དམ་པ་ཡིན་པ་བཞིན། ཁྱོད་རྣམས་ཀྱང་སྤྱོད་ལམ་ཀུན་ནས་དམ་པ་ཡིན་དགོས༌ཏེ།"]},{"type":"verse","number":16,"content":["གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། བདག་ནི་དམ་པ་ཡིན་པའི༌ཕྱིར་ཁྱོད་རྣམས་ཀྱང་དམ་པ་ཡིན་དགོས༌སོ། །ཞེས་བཀོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":17,"content":["དེ་ཡང་མི་ལ་ཕྱོགས་རིས་མི་འཛིན་པར་མི་རེ་རེའི་སྤྱོད་ལམ་བཞིན་དུ་ཁྲིམས་ཐག་གཅོད་མཁན་ལ་ཁྱོད་རྣམས་ཀྱིས་ཡབ་ལགས་ཞེས་འབོད་པས། ཁྱོད་རྣམས་བྱེས་སུ་སྡོད་དུས་གུས་ཤིང་འཇིགས་པའི་སེམས་བཅང་དགོས་སོ།།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་རང་གི་ཕ་མེས་ཡང་མེས་ནས་བརྒྱུད་ཅིང་སྙིང་པོ་མེད་པའི་སྤྱོད་ལམ་དག་ལས་བླུས་ནས་ཐར་བར་མཛད་པ༌ནི། འཇིག་པར་འགྱུར་བའི་གསེར་དངུལ་ལ་སོགས་པའི་དངོས་པོར་བརྟེན་པ་མ་ཡིན༌པར།"]},{"type":"verse","number":19,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཁྲག་རིན་ཆེན་ཏེ། ནག་ནོག་མ་འདྲེས་པ་དང་། དྲི་མས་མ་གོས་པའི་ལུ་གུའི་ཁྲག་དང་མཚུངས་པ་དེ་ལ་བརྟེན་པ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཤེས༌སོ།།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་གིས་འཇིག་རྟེན་ཁམས་མ་བཀོད་པའི་ཡར་སྔོན་ལ་སྐྱབས་མགོན་ཡེ་ཤུ་སྔ་མོ་ནས་མཁྱེན་པ་ཡིན༌ཡང༌། དུས་ཀྱི་མཐའ་མ་འདིར་ད་གཟོད་ཁྱོད་རྣམས་ཀྱི་དོན་དུ་མངོན༌པར་མཛད།"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཁོང་ཉིད་བརྒྱུད་ནས་དཀོན་མཆོག་ལ་དད་པ་བྱས༌ཤིང༌། དཀོན་མཆོག་གིས་ཁོང་ཉིད་སྐུ་གྲོངས་པ་ནས་སླར་གསོན་པ་དང་གཟི་བརྗིད་དང་ལྡན་པར་མཛད་དོ།། དེ་ནི་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ལ་དད་པ་དང་རེ་བ་བྱེད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":22,"content":["ཡང་ཁྱོད་ཅག་གིས་བདེན་པ་ཉིད་བརྩིས་ནས་རང་གི་སེམས་གཙང་མར་བྱས་པ་དང་སྤུན་ཟླ་རྣམས་ལ་ཟོལ་གྱིས་གཅེས་པ་མ་ཡིན་པས། སེམས་གཏིང་ནས་ཕན་ཚུན་ལ་གཅེས་དགོས་སོ།།"]},{"type":"verse","number":23,"content":["ཁྱོད་རྣམས་ཡང་བསྐྱར་སྐྱེས་པ་ནི་འཇིག་པར་འགྱུར་བའི་ས་བོན་ལས་བྱུང་བ་མ་ཡིན་པར། འཇིག་པ་མེད་པའི་ས་བོན༌ཏེ། དཀོན་མཆོག་གི་སྲོག་དང་ལྡན་ཞིང་གཏན་དུ་བཞུགས་པའི་བཀའ་ལ་བརྟེན་ནས་བྱུང་བའོ།།"]},{"type":"verse","number":24,"content":["ཅིའི་ཕྱིར་ཞེ་ན།",{"text":"ལུས་ཅན་ཐམས་ཅད་རྩྭ་དང༌འདྲ།།","poem":1},{"lineBreak":true},{"text":"གཟི་བརྗིད་རྩྭ་ཡི་མེ་ཏོག༌འདྲ།།","poem":1},{"lineBreak":true},{"text":"རྩྭ་ནི་བསྐམས་ནས་མེ་ཏོག༌ཡལ།།","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"གཙོ་བོའི་བཀའ་ནི་རྟག་ཏུ་གནས།།","poem":1},"ཞེས་གསུངས་པའི་ཕྱིར༌ཡིན་ཞིང་། ཁྱོད་རྣམས་ལ་བསྒྲགས་པའི་འཕྲིན་བཟང་ཡང་བཀའ་འདི་ཡིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1PE/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1PE/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JAS/5.json","previousChapterAudioLinks":{},"numberOfVerses":25}