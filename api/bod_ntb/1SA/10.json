{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":10,"content":[{"type":"heading","content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་སྣོད་ཅིག་བླངས་ནས་སོ་ལོའི་མགོ་ལ་སྣུམ་བླུགས་ཏེ་འོ་བྱས་ཤིང་སྨྲས་པ། ད་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་ཁོང་གི་འབངས་མིའི་རྗེ་དཔོན་དུ་བྱུགས་པར་མཛད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":2,"content":["དེ་རིང་ཁྱོད་ངའི་མདུན་ནས་ཕྱིན་ཏེ་པེན་ཡཱ་མེན་གྱི་ས་མཚམས་ཀྱི་ཙེལ་ཙེག་ཏུ་སླེབས་ཚེ། རཱ་ཧེལ་གྱི་དུར་སའི་གནས་སུ་མི་གཉིས་དང་འཕྲད་ངེས་ལ། དེ་གཉིས་ཀྱིས་ཁྱོད་ལ་འདི་ལྟར་སྨྲས་འོང་། ཁྱོད་ཀྱིས་བཙལ་བའི་བོང་བུ་རྣམས་རྙེད་ཟིན་ལ། ཁྱོད་ཀྱི་ཕ་ཡིས་བོང་བུའི་ཆེད་དུ་སེམས་ཁུར་མི་བྱེད་པར། རང་གི་བུ་ཡི་ཆེད་དུ་ཅི་ལྟར་བྱའམ་ཞེས་སྨྲ་ཞིང་སེམས་འཚེར་བཞིན་འདུག་ཅེས་པའོ། །"]},{"type":"verse","number":3,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་འདི་ལྟར། གནས་དེ་ནས་ཁྱོད་རང་ཕར་ཕྱིན་ཏེ་ཐ་པོར་ཡུལ་གྱི་བེ་ཤིང་གི་མདུན་དུ་སླེབས་པ་ཙམ་གྱིས། པེད་ཨེལ་གྲོང་ཁྱེར་གྱི་ཕྱོགས་སུ་དཀོན་མཆོག་ལ་ཞུ་བར་འགྲོ་བའི་མི་གསུམ་དང་འཕྲད་པར་འགྱུར། མི་དེ་གསུམ་ལས་གཅིག་གིས་རེའུ་གསུམ་དང་གཞན་དེས་བག་ལེབ་གསུམ་དང་། གསུམ་པས་རྒུན་ཆང་གི་རྐྱལ་བུ་ཞིག་འཁུར་འོང་བར་བྱ།"]},{"type":"verse","number":4,"content":["དེ་དག་གིས་ཁྱོད་ལ་ཁམས་བཟང་ངམ་ཞེས་ཞུས་ནས་བག་ལེབ་གཉིས་འབུལ་བ་དང་། ཁྱོད་ཀྱིས་དེ་དག་གི་ལག་ནས་ལེན་རུང་ངོ་། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁྱོད་ཕེ་ལེ་ཤེད་པའི་སོ་པ་ཡོད་སའི་དཀོན་མཆོག་གི་རི་མདུན་དུ་སླེབས་ནས་དེ་རུ་གྲོང་ཁྱེར་དུ་འགྲོ་བ་ཙམ་གྱིས། ལུང་སྟོན་པའི་ཚོགས་གནས་མཐོ་ས་ནས་འབབ་པ་ཞིག་དང་འཕྲད་པར་འགྱུར། དེ་དག་གིས་རྒྱུད་མངས་དང་སིལ་རྔ་དང་གླིང་བུ་དང་པི་ཝང་བཅས་འཁྲོལ་ཞིང་ལུང་སྟོན་པར་བྱ།"]},{"type":"verse","number":6,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཉིད་དབང་དང་ལྡན་པར་ཁྱོད་ལ་ཁྱབ་ཅིང་། དེ་དག་དང་བཅས་སུ་ལུང་སྟོན་ཞིང་། ཁྱོད་རང་མི་གསར་པ་ཞིག་ཏུ་འགྱུར་འོང་།"]},{"type":"verse","number":7,"content":["ཡང་ངས་ཁྱོད་ལ་བསྟན་པའི་རྟགས་དེ་རྣམས་ཐོན་པའི་ཚེ། དཀོན་མཆོག་ཁྱོད་དང་མཉམ་དུ་བཞུགས་པས་ཁྱོད་ལ་བྱུང་བ་བཞིན་བྱོས་ཤིག"]},{"type":"verse","number":8,"content":["ཁྱོད་རང་ངའི་སྔོན་དུ་གིལ་གལ་གྲོང་ཁྱེར་དུ་སོང་ཞིག་དང་། ངས་དེ་རུ་སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་འབུལ་བའི་ཕྱིར་ཁྱོད་ཀྱི་མདུན་དུ་འོང་བར་འགྱུར། ང་རང་ཁྱོད་ཀྱི་མདུན་དུ་མ་སླེབས་བར་དུ་ཉིན་བདུན་ལ་སྒུག་དགོས། དེ་ནས་ཁྱོད་ཀྱིས་ཅི་བྱ་འོས་པ་དེ་ངས་སྟོན་པར་བྱ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་སོ་ལོ་ཁ་ཕྱིར་འཁོར་ཏེ་སཱ་མུ་ཨེལ་དང་བྲལ་བའི་ཚེ། དཀོན་མཆོག་གིས་ཁོ་ལ་སེམས་གཞན་པ་ཞིག་གནང་བ་དང་། དེའི་ཉིན་མོར་སྔར་བསྟན་པའི་མངོན་རྟགས་ཐམས་ཅད་འགྲུབ་པར་གྱུར།"]},{"type":"verse","number":10,"content":["ཡང་སོ་ལོ་གཙོ་འཁོར་གཉིས་རི་མདུན་དུ་སླེབས་པའི་ཚེ་ལུང་སྟོན་པའི་ཚོགས་ཤིག་དང་ཕྲད་དེ། དཀོན་མཆོག་གི་ཐུགས་ཉིད་དེ་ལ་དབང་དང་ལྡན་པར་ཁྱབ་པས། ཁོས་དེ་དག་གི་ཁྲོད་དུ་ལུང་བསྟན་པ་རེད།"]},{"type":"verse","number":11,"content":["དེ་ནས་སྔར་ཁོ་རང་ངོ་ཤེས་པའི་མི་རྣམས་ཀྱིས་ཁོས་ལུང་སྟོན་པའི་ཁྲོད་དུ་ལུང་བསྟན་པ་མཐོང་བས། ཕན་ཚུན་ལ། ལྟོས་ཤིག ཁི་སིའི་བུ་ལ་བྱུང་བ་འདི་ཅི་ཡིན། སོ་ལོ་ཡང་ལུང་སྟོན་པའི་ཁྲོད་དུ་ཡོད་དམ་ཞེས་དྲིས་པ་དང་།"]},{"type":"verse","number":12,"content":["ཡང་ཡུལ་དེའི་མི་ཞིག་གིས་ལན་དུ། དེ་དག་གི་ཕ་སུ་ཡིན་ནམ་ཞེས་སྨྲས། དེའི་ཕྱིར། སོ་ལོ་ཡང་ལུང་སྟོན་པའི་ཁྲོད་དུ་ཡོད་དམ་ཞེས་པའི་གཏམ་དཔེ་ཞིག་བྱུང་བ་རེད།"]},{"type":"verse","number":13,"content":["དེ་ནས་སོ་ལོས་ལུང་བསྟན་ཟིན་ནས་གནས་མཐོ་སར་སླེབས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་སོ་ལོའི་ཁུ་བོས་ཁོ་དང་ཁོའི་ཞབས་ཕྱི་གཉིས་ལ། ཁྱོད་གཉིས་གང་དུ་ཕྱིན་པ་ཡིན་ཞེས་དྲིས་པས། ཁོས་ལན་དུ། ངེད་གཉིས་བོང་བུ་རྣམས་འཚོལ་བར་སོང་བ་ཡིན། བོང་བུ་རྣམས་མ་རྙེད་པས་སཱ་མུ་ཨེལ་གྱི་དྲུང་དུ་བཅར་བ་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":15,"content":["སོ་ལོའི་ཁུ་བོས། སཱ་མུ་ཨེལ་གྱིས་ཁྱོད་ལ་ཅི་སྨྲས་པ་དེ་ང་ལ་ཤོད་ཅེས་དྲིས་པས།"]},{"type":"verse","number":16,"content":["སོ་ལོས་རང་གི་ཁུ་བོ་ལ། སཱ་མུ་ཨེལ་གྱིས་ང་ཚོར་བོང་བུ་རྣམས་རྙེད་པའི་གཏམ་གསལ་པོར་སྨྲས་བྱུང་ཞེས་སྨྲས་ཀྱང་། རྒྱལ་ཁམས་ཀྱི་དོན་སཱ་མུ་ཨེལ་གྱིས་ཅི་གསུངས་པ་དེ་ནི་མ་བཤད་དོ། །"]},{"type":"verse","number":17,"content":["དེའི་རྗེས་སུ་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བོས་ནས།"]},{"type":"verse","number":18,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ངས་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་དེ། ཨེ་ཅིབ་པ་དང་ཁྱོད་རྣམས་ལ་གཉའ་གནོན་བྱེད་པའི་རྒྱལ་ཁམས་ཐམས་ཅད་ལས་བསྒྲལ་ཟིན།"]},{"type":"verse","number":19,"content":["དེ་རིང་ཁྱོད་རྣམས་ཀྱིས་རང་ཉིད་ཀྱི་དཀོན་མཆོག་སྟེ། སྡུག་བསྔལ་དང་དཀའ་ཚེགས་ཐམས་ཅད་ནས་སྒྲོལ་བར་མཛད་མཁན་དེ་སྤངས་ནས་ཁོང་ལ་འདི་ལྟར་སྨྲས་པ། ངེད་རྣམས་ལ་རྒྱལ་པོ་ཞིག་བསྐོ་བར་མཛོད་ཅིག་ཅེས་པས། ད་ལྟ་ཁྱོད་རྣམས་ནི་ཚོ་པ་དང་ཁྱིམ་རྒྱུད་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འཛོམ་པར་གྱིས་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཐམས་ཅད་ཉེ་བར་འཛོམས་སུ་བཅུག་ནས། པེན་ཡཱ་མེན་གྱི་ཚོ་པ་བདམས།"]},{"type":"verse","number":21,"content":["པེན་ཡཱ་མེན་གྱི་ཚོ་པ་ནི་དེའི་ཁྱིམ་རྒྱུད་བཞིན་དུ་འོང་བར་བཅུག་ནས། མུལ་ཐི་རུའི་ཁྱིམ་རྒྱུད་བསྐོས། དེ་ནས་ཁི་སིའི་བུ་སོ་ལོ་བསྐོས་ཀྱང་ཁོ་རང་བཙལ་ནས་མ་རྙེད།"]},{"type":"verse","number":22,"content":["ཡང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ། མི་དེ་འདི་རུ་ཡོད་དམ་ཞེས་ཞུས་པས། དཀོན་མཆོག་ཡ་ཝཱེས། ལྟོས་དང་། ཁོ་ནི་ཅ་ལག་རྣམས་ཀྱི་ཁྲོད་དུ་ཡིབ་འདུག་ཅེས་གསུངས།"]},{"type":"verse","number":23,"content":["དེའི་ཕྱིར་མི་རྣམས་བརྒྱུགས་ནས་ཁོ་རང་ཁྲིད་འོངས་པ་དང་། ཁོ་མི་རྣམས་ཀྱི་ཁྲོད་དུ་ལངས་སྐབས་མི་ཐམས་ཅད་ལས་མགོ་གཅིག་གིས་མཐོ་བ་ཡིན།"]},{"type":"verse","number":24,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་མི་ཐམས་ཅད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་བསྐོ་བར་མཛད་པ་དེ་ལ་ལྟོས་ཤིག དེ་དང་འདྲ་བ་མི་ཐམས་ཅད་ཀྱི་ཁྲོད་དུ་གཅིག་ཀྱང་མི་འདུག་ཅེས་སྨྲས་པས། མི་ཐམས་ཅད་ཀྱིས་སྐད་ཆེན་པོ་བརྒྱབ་ཅིང་། རྒྱལ་པོ་ཁྲི་ལོར་བརྟན་པར་ཤོག་ཅེས་འབོད་སྒྲ་བསྒྲགས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་ལ་རྒྱལ་ཁམས་ཀྱི་ཁྲིམས་ལུགས་བརྗོད་དེ་གླེགས་བམ་ཞིག་གི་ནང་དུ་བཀོད་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བཞག ཡང་སཱ་མུ་ཨེལ་གྱིས་མི་ཐམས་ཅད་རང་རང་སོ་སོའི་ཁྱིམ་དུ་ཕྱིར་འགྲོ་རུ་བཅུག"]},{"type":"verse","number":26,"content":["ཡང་སོ་ལོ་ནི་གིབ་ཨ་གྲོང་ཚོ་རུ་རང་གི་ཁྱིམ་དུ་ཕྱིན་པ་དང་། ཁོ་དང་མཉམ་དུ་དཀོན་མཆོག་གིས་སེམས་འགུལ་ཐེབས་པར་མཛད་པའི་དཔའ་བོའི་ཚོགས་ཤིག་ཀྱང་ཕྱིན་པ་རེད།"]},{"type":"verse","number":27,"content":["འོན་ཀྱང་མི་ངན་ལ་ལས། མི་འདིས་ངེད་རྣམས་ཅི་ལྟར་སྒྲོལ་བར་བྱ་ཞེས་སྨྲས་ཤིང་ཁོ་ལ་སྨད་པ་དང་། འབུལ་བ་གང་ཡང་མ་ཕུལ་ན་ཡང་སོ་ལོ་ཁུ་སིམ་མེར་བཞུགས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/9.json","previousChapterAudioLinks":{},"numberOfVerses":27}