{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":11,"content":[{"type":"heading","content":["སོ་ལོས་ཡཱ་བེ་སི་གིལ་ཨད་གྲོང་ཁྱེར་བསྐྱབས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨམ་མོན་པའི་རྒྱལ་པོ་ནཱ་ཧ་སི་འོངས་ནས་གིལ་ཨད་ཡུལ་གྱི་ཡཱ་བེ་སི་གྲོང་ཚོ་ཡི་མདུན་དུ་དམག་སྒར་བཏབ་པ་དང་། གྲོང་ཁྱེར་དེའི་ཡཱ་བེ་སི་པ་རྣམས་ཀྱིས་ནཱ་ཧ་སི་ལ། ངེད་ཅག་དང་མཉམ་དུ་ཁ་ཆད་ཅིག་མཛོད་དང་། ངེད་ཅག་གིས་ཁྱེད་ལ་ཞབས་ཕྱི་བསྒྲུབ་པར་བྱ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":2,"content":["ཨམ་མོན་པ་ནཱ་ཧ་སི་ན་རེ། ཁྱོད་ཅག་མི་རེ་རེའི་མིག་གཡས་པ་དེ་བཏོན་ནས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་བརྙས་བཅོས་བྱེད་དུ་བཅུག་ན། ངས་ཁྱོད་ཅག་དང་མཉམ་དུ་འདི་ལྟ་བུའི་ཁ་ཆད་འཇོག་པར་བྱ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":3,"content":["ཡཱ་བེ་སི་པ་ཡི་རྒན་པོ་རྣམས་ཀྱིས་ངེད་ཅག་གིས་ཡེས་ར་ཨེལ་གྱི་ས་མཚམས་ཐམས་ཅད་ཀྱི་བར་དུ་བང་ཆེན་མངག་པའི་ཕྱིར། ཉིན་བདུན་གྱི་རིང་ལ་གནོད་པ་མི་བྱེད་རོགས། ཉིན་དེའི་བར་དུ་སྲོག་སྐྱོབ་མཁན་གཅིག་ཀྱང་མ་བྱུང་ན། ངེད་ཅག་ཡུལ་ནས་ཐོན་ཏེ་ཁྱེད་ཀྱི་དྲུང་དུ་འོང་བར་བྱ་ཞེས་ཞུས།"]},{"type":"verse","number":4,"content":["དེ་ནས་བང་ཆེན་རྣམས་སོ་ལོའི་གྲོང་ཚོ་རྒི་བེ་ཨ་རུ་སླེབས་ཏེ་འབངས་མི་ཐམས་ཅད་ལ་གཏམ་དེ་སྨྲས་པས། ཐམས་ཅད་ཀྱིས་སྐད་ཆེན་པོ་བརྒྱབ་ནས་བཤུམས།"]},{"type":"verse","number":5,"content":["སོ་ལོས་ཞིང་ཁ་ནས་བ་གླང་དེད་དེ་འོངས་པ་དང་། ཁོས་མི་རྣམས་ཅིའི་ཕྱིར་ངུ་བ་ཡིན་ཞེས་དྲིས་པར་དེ་དག་གིས་ཁོ་ལ་ཡཱ་བེ་སི་པའི་གཏམ་སྨྲས་པ་རེད།"]},{"type":"verse","number":6,"content":["སོ་ལོས་གཏམ་དེ་ཐོས་པའི་ཚེ་དཀོན་མཆོག་གི་ཐུགས་ཉིད་དབང་དང་ལྡན་པ་ཁོ་ལ་བབས་ནས་ཁོང་ཁྲོ་ཤིན་ཏུ་ཆེན་པོ་ལངས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཁོས་བ་གླང་དོར་གཅིག་བཟུང་སྟེ་བསད་ནས་དུམ་བུར་གཏུབས་ཤིང་། བང་ཆེན་གྱིས་ཡེས་ར་ཨེལ་གྱི་ས་མཚམས་བར་དུ་བཀྲམས་ཤིང་འདི་ལྟར་སྨྲས་པ། མི་སུ་ཞིག་སོ་ལོ་དང་སཱ་མུ་ཨེལ་གཉིས་ཀྱི་རྗེས་སུ་མི་འོང་ན། མི་དེའི་བ་གླང་རྣམས་ལ་ཡང་འདི་ལྟར་བྱེད་པར་འགྱུར་ཞེས་པའོ། །དེ་ནས་མི་ཐམས་ཅད་ལ་དཀོན་མཆོག་ཡ་ཝཱེར་འཇིགས་པའི་སེམས་བྱུང་བས་ཀུན་པོ་མི་གཅིག་ལྟར་འོངས་པ་རེད།"]},{"type":"verse","number":8,"content":["པེ་ཟེག་གྲོང་ཚོ་རུ་མི་གྲངས་བརྩི་བའི་ཚེ་ཡེས་ར་ཨེལ་པ་འབུམ་གསུམ་དང་ཡ་ཧུ་དཱ་པ་ཁྲི་གསུམ་ཡོད་དོ། །"]},{"type":"verse","number":9,"content":["ཡེས་ར་ཨེལ་པ་དང་ཡ་ཧུ་དཱ་པ་གཉིས་ཀྱིས་དེ་རུ་འོངས་པའི་གིལ་ཨད་ཡུལ་གྱི་བང་ཆེན་རྣམས་ལ་ཁྱོད་ཅག་གིས་ཡཱ་བེ་སི་པ་རྣམས་ལ་འདི་ལྟར་ཤོད་ཅིག སང་ཉིན་ཉིན་གུང་སླེབས་ལ་ཉེ་བའི་དུས་སུ་ཁྱོད་རྣམས་སྐྱོབ་པར་འགྱུར་ཞེས་སྨྲས་པ་དང་། བང་ཆེན་རྣམས་ཕྱིན་ཏེ་ཡཱ་བེ་སི་པ་རྣམས་ལ་གཏམ་དེ་སྨྲས་པས་དགའ་བར་གྱུར།"]},{"type":"verse","number":10,"content":["དེའི་ཕྱིར་ཡཱ་བེ་སི་པ་རྣམས་ཀྱིས་ཨམ་མོན་པ་རྣམས་ལ། སང་ཉིན་ངེད་ཅག་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་འོང་སྐབས། ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་ཅི་ལྟར་བྱེད་སྙམ་ན་དེ་ལྟར་བྱོས་ཤིག་ཅེས་སྨྲས།"]},{"type":"verse","number":11,"content":["ཡང་ཕྱི་ཉིན་སོ་ལོས་འབངས་མི་རྣམས་དམག་དཔུང་གསུམ་དུ་བསྒྲིལ་ཏེ། མཚན་ཐུན་ཕྱི་མའི་དུས་སུ་ཨམ་མོན་པའི་དམག་སྒར་གྱི་དཀྱིལ་དུ་འོངས་ནས་ཉིན་གུང་བར་དུ་ཁོ་རྣམས་དང་དམག་བརྒྱབ་ཅིང་། མ་ཤི་བ་ཐམས་ཅད་ཁ་འཐོར་བས་མི་གཉིས་མཉམ་གཅིག་ཏུ་ལུས་པའང་མེད་དོ། །"]},{"type":"heading","content":["སོ་ལོ་སླར་ཡང་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":12,"content":["དེ་ནས་མི་རྣམས་ཀྱིས་སཱ་མུ་ཨེལ་ལ། སོ་ལོས་ངེད་རྣམས་ཀྱི་སྟེང་དུ་སྲིད་བྱེད་རུང་ངམ་ཞེས་ཟེར་བའི་མི་དེ་སུ་ཡིན། མི་དེ་རྣམས་འདི་རུ་འཁྲིད་ཤོག དེ་རྣམས་གསོད་པར་རིགས་ཞེས་སྨྲས།"]},{"type":"verse","number":13,"content":["ཡང་སོ་ལོས། དེ་རིང་ཉིན་མོར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་སྲོག་བསྐྱབས་པར་མཛད་པས་མི་གཅིག་ཀྱང་གསོད་མི་རུང་ཞེས་བཀའ་བསྩལ།"]},{"type":"verse","number":14,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་ལ། ད་ཤོག་དང་། ངེད་རྣམས་གིལ་གལ་གྲོང་ཁྱེར་དུ་སླར་ཡང་རྒྱལ་པོ་ཁས་ལེན་པའི་ཕྱིར་འགྲོ་བར་བྱ་ཞེས་བསྐུལ་བས།"]},{"type":"verse","number":15,"content":["མི་ཐམས་ཅད་གིལ་གལ་གྲོང་ཁྱེར་དུ་ཕྱིན་ནས། སོ་ལོ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་གིལ་གལ་གྲོང་ཁྱེར་དུ་རྒྱལ་པོར་བསྐོས། དེ་ནས་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཞི་བདེའི་མཆོད་པ་ཕུལ་ཞིང་། སོ་ལོ་དང་ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཤིན་ཏུ་དགའ་བར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/10.json","previousChapterAudioLinks":{},"numberOfVerses":15}