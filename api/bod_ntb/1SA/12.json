{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":12,"content":[{"type":"heading","content":["སཱ་མུ་ཨེལ་གྱིས་མཇུག་མཐའི་གཏམ་སྨྲས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སཱ་མུ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་འདི་ལྟར། ལྟོས་དང་། ཁྱོད་ཅག་གིས་ང་ལ་ཅི་ཞིག་ཞུས་པ་བཞིན། ངས་ཁྱོད་ཅག་གི་གཏམ་ལ་མཉན་ཅིང་ཁྱོད་ཅག་ལ་རྒྱལ་པོ་ཞིག་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["ད་ལྟ་རྒྱལ་པོ་ཁྱོད་ཅག་གི་མདུན་དུ་བཞུགས་ཡོད་ཅིང་། ང་རང་ལོ་ན་རྒས་ཤིང་སྐྲ་ཡང་དཀར་པོར་གྱུར། ངའི་བུ་རྣམས་ཁྱོད་ཅག་གི་ཁྲོད་དུ་གནས་ཏེ། ང་ནི་གཞོན་ནུའི་དུས་ནས་ད་ལྟའི་བར་དུ་ཁྱོད་ཅག་གི་མདུན་དུ་བསྐྱོད་པ་ཡིན།"]},{"type":"verse","number":3,"content":["ང་འདི་རུ་ཡོད་དེ་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁོང་གི་སྣུམ་གྱིས་བྱུགས་པ་",{"noteId":3},"གཉིས་ཀྱི་དྲུང་དུ་ཁྱོད་ཚོས་ང་ལ་དཔང་པོ་བྱོས་ཤིག ངས་སུ་ཞིག་གི་བ་གླང་ངམ་བོང་བུ་ཕྲོགས་པ་ཡིན་ནམ། ངས་སུ་ཞིག་བསླུས་པའམ་མནན་པ་ཡིན་ནམ། ངས་སུ་ཞིག་གི་ལག་ནས་མིག་ལོང་བ་ལྟར་བྱས་ཏེ་ལྐོག་རྔན་བླངས་མྱོང་ངམ། གལ་སྲིད་དེ་ལྟར་ཕྲོགས་པའམ་བསླུས་པ་སོགས་ཡོད་ན་ཕྱིར་སྤྲོད་དགོས་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":4,"content":["དེ་དག་ན་རེ། ཁྱེད་ཀྱིས་བདག་ཅག་བསླུས་ཤིང་མནན་པ་མ་ཡིན་ལ། མི་སུ་ཞིག་གི་ལག་ནས་ཁྱེད་ཀྱིས་གང་ཡང་མ་བླངས་ཞེས་ཞུས་པས།"]},{"type":"verse","number":5,"content":["ཡང་དེ་དག་ལ། དེ་རིང་ཉིན་མོར་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁོང་གི་སྣུམ་གྱིས་བྱུགས་པ་གཉིས་ཀྱིས་ངའི་ལག་ཏུ་གང་ཡང་མ་རྙེད་པ་ཁྱོད་ཅག་གི་མདུན་དུ་དཔང་པོ་མཛད་པ་ཡིན་ཞེས་སྨྲས་པར། དེ་དག་གིས་ཁོང་ནི་དཔང་པོ་ལགས་ཞེས་སྨྲས།"]},{"type":"verse","number":6,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་ལ་འདི་ལྟར། མོ་ཤེ་དང་ཨ་རོན་གཉིས་བསྐོས་ཤིང་། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་མཁན་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས་སོ། །"]},{"type":"verse","number":7,"content":["དེའི་ཕྱིར་འདི་རུ་སྡོད་ཅིག ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་མེས་པོའི་དོན་དུ་ཡ་ཝཱེས་མཛད་པའི་འཕྲིན་ལས་བཟང་པོ་ཐམས་ཅད་ངས་ཁྱོད་རྣམས་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྟོན་པར་བྱ།"]},{"type":"verse","number":8,"content":["ཡ་ཀོབ་ཨེ་ཅིབ་ཡུལ་དུ་སླེབས་པའི་ཚེ། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་ཕུལ་བས། དཀོན་མཆོག་ཡ་ཝཱེས་མེས་པོ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་འཁྲིད་པའི་ཕྱིར་མོ་ཤེ་དང་ཨ་རོན་གཉིས་བསྐོས་ནས་དེ་དག་ཡུལ་འདི་རུ་གནས་པར་བྱས།"]},{"type":"verse","number":9,"content":["ཡང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་རང་གི་དཀོན་མཆོག་བརྗེད་པས་ཁོང་གིས་དེ་དག་ཧ་ཟོར་གྱི་དམག་དཔོན་སི་སེ་རཱ་དང་། ཕེ་ལེ་ཤེད་པ་དང་མོ་ཨབ་ཀྱི་རྒྱལ་པོར་བཙོངས་ནས། དེ་དག་གིས་དེ་རྣམས་ལ་དམག་བརྒྱབ།"]},{"type":"verse","number":10,"content":["ཡང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་འབོད་ཀྱིན་ན་རེ། བདག་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་ནས་པཱ་ཨལ་དང་ལྷ་མོ་ཨ་ཤཱ་ཏ་རོད་ཀྱི་ལྷ་སྐུ་རྣམས་ལ་ཕྱག་ཕུལ་བ་ནི་སྡིག་པ་བྱས་པ་ཡིན། ད་ལྟ་ཁྱེད་ཀྱིས་བདག་ཅག་དགྲ་བོའི་ལག་ནས་སྒྲོལ་བར་མཛོད་ཅིག བདག་ཅག་གིས་ཁྱེད་གཅིག་པོ་ལ་བསྙེན་བཀུར་བྱའོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རུབ་པཱ་ཨལ་དང་པི་ཏཱན་དང་ཡེབ་ཐཱ་དང་སཱ་མུ་ཨེལ་བཅས་མངགས་ཤིང་། ཁྱོད་ཅག་ཕྱོགས་བཞིའི་དགྲ་བོ་རྣམས་ཀྱི་ལག་ནས་བསྐྱབས་ཏེ་ཁྱོད་རྣམས་ད་གཟོད་བདེ་བར་གནས་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ཡང་ཁྱོད་ཅག་གིས་ཨམ་མོན་པའི་རྒྱལ་པོ་ནཱ་ཧ་སི་འོང་བ་མཐོང་བའི་ཚེ་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་ཅག་གི་རྒྱལ་པོ་ཡིན་ན་ཡང་། ཁྱོད་ཅག་གིས་ང་ལ། དེ་ལྟར་མིན། རྒྱལ་པོ་ཞིག་གིས་བདག་ཅག་ལ་སྲིད་བྱེད་རུང་བ་ཡིན་ཞེས་སྨྲ་བར་བྱས།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཅག་གིས་བདམས་པ་དང་དེའི་སྐོར་ང་ལ་ཞུས་པའི་རྒྱལ་པོར་ལྟོས་ཤིག དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་རྒྱལ་པོ་དེ་བསྐོ་བར་གནང་བ་ཡིན།"]},{"type":"verse","number":14,"content":["གལ་ཏེ་ཁྱོད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འཇིགས་ཏེ་ཁོང་ལ་བསྙེན་བཀུར་ཞུས་ཤིང་། ཁོང་གི་བཀའ་ལ་མཉན་ནས་ཁོང་གི་བཀའ་རྒྱ་དང་ནམ་ཡང་མི་འགལ་བ་དང་། ཁྱོད་ཅག་དང་ཁྱོད་ཅག་ལ་སྲིད་བྱེད་པའི་རྒྱལ་པོ་ཡ་ཝཱེ་རང་གི་དཀོན་མཆོག་གི་རྗེས་སུ་འབྲངས་ན་ལེགས་སོ། །"]},{"type":"verse","number":15,"content":["གལ་ཏེ་ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མི་མཉན་པར་ཁོང་གི་བཀའ་རྒྱ་དང་འགལ་ན། ཁྱོད་ཅག་གི་ཕ་མེས་ཀྱི་སྟེང་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ལྕི་བར་གྱུར་པ་བཞིན་ཁྱོད་ཅག་གི་སྟེང་དུ་ཡང་ལྕི་བར་འགྱུར་བ་ཡིན།"]},{"type":"verse","number":16,"content":["དེའི་ཕྱིར་ད་ལྟ་འདི་རུ་སྡོད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་མིག་མདུན་དུ་བྱ་བ་ཆེན་པོ་ཅི་ཞིག་མཛད་འོང་བར་ལྟོས་ཤིག"]},{"type":"verse","number":17,"content":["དེ་རིང་གྲོ་རྔ་བའི་ཉིན་མོ་མ་ཡིན་ནམ། ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་བརྗོད་ཅིང་ཁོང་གིས་འབྲུག་སྒྲ་དང་ཆར་བ་གནང་བར་འགྱུར། ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར། བདག་ཅག་ལ་རྒྱལ་པོ་ཞིག་གནང་རོགས་ཞེས་ཞུས་པས། སྡིག་པ་ཅི་ལྟར་ཆེན་པོ་བྱས་པའི་ངོ་བོ་རྟོགས་ཤིང་མཐོང་བར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":18,"content":["སཱ་མུ་ཨེལ་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་བརྗོད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཉིན་དེ་ལ་འབྲུག་སྒྲ་དང་ཆར་བ་གནང་བས། མི་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེ་དང་སཱ་མུ་ཨེལ་གཉིས་ལ་ཤིན་ཏུ་འཇིགས་ཤིང་སྐྲག་པར་གྱུར།"]},{"type":"verse","number":19,"content":["ཡང་མི་ཐམས་ཅད་ཀྱིས་སཱ་མུ་ཨེལ་ལ། ངེད་ཅག་གིས་སྔར་སྡིག་པ་མང་པོ་བྱས་ཤིང་། ད་ལྟ་ཡང་རྒྱལ་པོ་ཞིག་བསྐོ་དགོས་པར་ཞུས་པའི་སྡིག་པ་ཤིན་ཏུ་ཆེ་བས། ངེད་ཅག་མི་འཆི་བའི་ཕྱིར་ཁྱེད་ཀྱིས་རང་གི་ཞབས་ཕྱི་པ་རྣམས་ཀྱི་ཆེད་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་འདེབས་རོགས་ཞེས་ཞུས།"]},{"type":"verse","number":20,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་ལ་འདི་ལྟར། མ་འཇིགས་ཤིག ཁྱོད་ཅག་གིས་ཉེས་པ་འདི་ཐམས་ཅད་བྱས་ཀྱང་། དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲང་བ་ལས་ཁ་ཕྱོགས་མི་ནོར་བར་སེམས་ཧྲིལ་པོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་གྱིས་ཤིག"]},{"type":"verse","number":21,"content":["དོན་མེད་ཀྱི་རྗེས་སུ་མ་འགྲོ་ཞིག དེ་དག་ནི་ཕན་མེད་ཀྱི་དངོས་པོ་ཡིན་པས་སྐྱོབ་པར་མི་ནུས་སོ། །"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ཆེན་པོ་ཡིན་པས་ན་ཁོང་གིས་རང་ཉིད་ཀྱི་འབངས་མི་སྤང་བར་མི་བྱའོ། །གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་རྣམས་ཁོང་གི་འབངས་མིར་འདེམས་པར་ཐུགས་མཉེས་པའོ། །"]},{"type":"verse","number":23,"content":["བདག་ལ་མཚོན་ན། ཁྱོད་རྣམས་ཀྱི་དོན་དུ་སྨོན་ལམ་འདེབས་པ་རྒྱུན་ཆད་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་གཏན་ནས་མི་བྱའོ། །ངས་ཁྱོད་ཅག་ལ་ལམ་བཟང་པོ་དང་དྲང་པོ་དེ་སྟོན་པར་བྱ།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཅག་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་གཅིག་པོ་ལ་འཇིགས་ཏེ། བདེན་པ་བདེན་དྲང་ངང་སེམས་ཧྲིལ་པོས་ཁོང་ལ་བསྙེན་བཀུར་བྱོས་ཤིག ཁོང་གིས་ཁྱོད་ཅག་གི་དོན་དུ་འཕྲིན་ལས་ཆེན་པོ་རྣམས་མཛད་པ་དེ་དྲན་པར་གྱིས།"]},{"type":"verse","number":25,"content":["ཡང་ཁྱོད་ཅག་གིས་ད་དུང་ལས་ངན་པ་བྱེད་ན་ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་རྒྱལ་པོ་དེ་ཡང་མེད་པར་འགྱུར་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[{"noteId":3,"caller":"+","text":"བྱུགས་པ་ཞེས་པ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་བསྐོ་བའི་ཚེ་མགོ་ལ་སྣུམ་བྱུགས་པ་ཡིན་ཞིང་། དེ་ནི་གང་དེར་དཀོན་མཆོག་གི་དམ་པའི་ཐུགས་ཉིད་གནང་བའི་རྟགས་སམ་མཚན་མར་ངོས་འཛིན་པ་རེད།","reference":{"chapter":12,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/1SA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}