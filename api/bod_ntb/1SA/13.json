{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":13,"content":[{"type":"heading","content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོར་བཀའ་བཀྱོན་གནང་བ།"]},{"type":"verse","number":1,"content":["སོ་ལོས་ལོ་གཅིག་ལ་རྒྱལ་སྲིད་བསྐྱངས་པ་དང་ལོ་གཉིས་",{"noteId":4},"ཀྱི་རིང་དུ་ཡེས་ར་ཨེལ་ལ་སྲིད་བྱས་ཤིང་།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་རང་གི་དོན་དུ་ཡེས་ར་ཨེལ་པ་རྣམས་ལས་མི་སུམ་སྟོང་བདམས་པ་དང་། དེ་རྣམས་ལས་མི་ཉིས་སྟོང་སོ་ལོ་རང་དང་མཉམ་དུ་མིགས་མཱ་སི་གྲོང་རྡལ་དང་པེད་ཨེལ་གྲོང་ཁྱེར་གྱི་རི་ཁུལ་དུ་གནས་ཤིང་། མི་ཆིག་སྟོང་སོ་ལོའི་སྲས་ཡོ་ནཱ་ཐན་དང་མཉམ་དུ་པེན་ཡཱ་མེན་ཡུལ་གྱི་རྒི་བེ་ཨ་གྲོང་ཚོ་རུ་གནས་པ་རེད། དེ་རུ་ལུས་པའི་མི་རྣམས་ནི་རེ་རེ་རང་གི་གུར་དུ་ལོག"]},{"type":"verse","number":3,"content":["དེ་ནས་ཡོ་ནཱ་ཐན་གྱིས་ཕེ་ལེ་ཤེད་པའི་སོ་པ་གེ་བཱ་རུ་གནས་པ་རྣམས་བསད་པས། ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་དེ་ཐོས་པ་རེད། ཡང་སོ་ལོས་ཡུལ་ཐམས་ཅད་དུ་རྭ་དུང་བུས་ཤིང་དོན་ལ་ཨིབ་རི་པ་རྣམས་ལ་ཐོས་སུ་ཆུག་ཅེས་པའོ། །"]},{"type":"verse","number":4,"content":["སོ་ལོས་ཕེ་ལེ་ཤེད་པའི་སོ་པ་བསད་པས་ཕེ་ལེ་ཤེད་པ་རྣམས་ཡེས་ར་ཨེལ་ལ་སྡང་བར་གྱུར། དེ་ནས་མི་ཐམས་ཅད་སོ་ལོའི་རྗེས་སུ་འབྲང་བའི་ཕྱིར་གིལ་གལ་ལ་འབོད་འགུགས་བྱས།"]},{"type":"verse","number":5,"content":["ཡང་ཕེ་ལེ་ཤེད་པ་རྣམས་ཡེས་ར་ཨེལ་ལ་དམག་བརྒྱག་པར་འཛོམས་པ་སྟེ། ཁོ་རྣམས་ཀྱི་གྲངས་ཀ་ནི། དམག་གི་ཤིང་རྟ་ཁྲི་གསུམ་དང་། རྟ་དམག་སྟོང་དྲུག་དང་། རྐང་དམག་ནི་རྒྱ་མཚོའི་མཐའ་རུ་ཡོད་པའི་བྱེ་མ་དང་འདྲ་བར་གྱུར། དེ་རྣམས་ཡར་འོངས་ནས་པེད་ཨ་ཝེན་གྱི་ཤར་ཕྱོགས་ཏེ་མིགས་མཱ་སི་རུ་གུར་ཕུབ།"]},{"type":"verse","number":6,"content":["ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱིས་ཉེན་ཁ་འབྱུང་བ་ཤེས་པས། མི་ཐམས་ཅད་བྲག་ཕུག་དང་། ཚེར་ཕུང་དང་། བྲག་དང་། ས་དོང་དང་། ཆུ་རྫིང་ནང་ལ་ཡིབ་ཏུ་སོང་།"]},{"type":"verse","number":7,"content":["ཡང་ཨིབ་རི་པའི་ཁྲོད་ནས་འགའ་ཞིག་ཡོར་དན་གཙང་པོ་བརྒྱུད་དེ་གཱ་རྡུ་དང་གིལ་ཨད་ས་ཆར་སོང་སྟེ། སོ་ལོ་ནི་གིལ་གལ་དུ་གནས་ཤིང་མི་ཐམས་ཅད་སྐྲག་ནས་འདར་བཞིན་ཁོང་གི་རྗེས་སུ་འབྲངས།"]},{"type":"verse","number":8,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་བཀའ་བསྩལ་པ་བཞིན་དུ་སོ་ལོ་ཉིན་བདུན་བར་དུ་དེ་རུ་བསྡད་ནས་སྒུག་པའི་ཚེ། ཁོང་ཉིད་གིལ་གལ་དུ་ད་དུང་མ་ཕེབས་པས་མི་རྣམས་སོ་ལོའི་ཕྱོགས་ནས་སོ་སོར་ཁ་འཐོར་བའི་འགོ་བརྩམས།"]},{"type":"verse","number":9,"content":["དེའི་ཕྱིར་སོ་ལོས། སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་གཉིས་ངའི་མདུན་དུ་ཁུར་ཤོག་ཅེས་བཀའ་བསྒོས་པས་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་བ་རེད།"]},{"type":"verse","number":10,"content":["ཡང་སོ་ལོས་སྦྱིན་སྲེག་ཕུལ་ཚར་མ་ཐག་ཏུ། སཱ་མུ་ཨེལ་ཕེབས་པ་ན་སོ་ལོ་ཁོང་ལ་མཇལ་དུ་སོང་ནས་ཕྱག་བྱས་ཤིང་།"]},{"type":"verse","number":11,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས། ཁྱོད་ཀྱིས་ཅི་བྱས་པ་ཡིན་ཞེས་དྲིས་པས། སོ་ལོས་མི་ཐམས་ཅད་ངའི་ཕྱོགས་ནས་སོ་སོར་ཁ་འཐོར་བའི་འགོ་བརྩམས་པ་དང་། ཁྱེད་ནི་སྔར་བསྟན་པའི་དུས་བཅད་ལྟར་མ་ཕེབས་པར་མ་ཟད། ཕེ་ལེ་ཤེད་པ་རྣམས་མིགས་མཱ་སི་རུ་འཛོམས་ཡོད་པ་རེད།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར་ངའི་སེམས་སུ། བདག་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་མ་བཏབ་པའི་སྔོན་དུ་ཕེ་ལེ་ཤེད་པ་རྣམས་གིལ་གལ་དུ་བདག་གི་སྟེང་དུ་སླེབས་པར་འགྱུར་སྙམ་པས། བདག་གིས་སྤོབས་པ་བསྐྱེད་ནས་སྦྱིན་སྲེག་ཕུལ་བ་ཡིན་ཞེས་ཞུས།"]},{"type":"verse","number":13,"content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ་ཁྱོད་ཀྱིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེས་གནང་བའི་བཀའ་མ་བསྲུངས་ཤིང་གླེན་པའི་ལུགས་སུ་བྱས་པ་རེད། གལ་ཏེ་ཁོང་གི་བཀའ་ཇི་བཞིན་བསྲུངས་པ་ཡིན་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་རྒྱལ་སྲིད་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་རྒྱུན་ནས་རྒྱུན་དུ་བརྟན་པོར་མཛད་མོད། འོན་ཀྱང་ད་ལྟ་ཁྱོད་ཀྱི་རྒྱལ་སྲིད་ཡུན་རིང་གནས་མི་ཐུབ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ཉིད་ཀྱི་ཐུགས་སུ་འབྱོན་པའི་མི་ཞིག་བཙལ་བར་མཛད་དེ། དེ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་འབངས་མིའི་འགོ་དཔོན་དུ་བསྐོ་བར་མཛད་དོ། །གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་གནང་བའི་བཀའ་མ་བསྲུངས་པའི་རྐྱེན་གྱིས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":15,"content":["སཱ་མུ་ཨེལ་ཡར་ལངས་ཏེ་གིལ་གལ་ནས་པེན་ཡཱ་མེན་གྱི་རྒི་བེ་ཨ་རུ་ཕྱིན། དེ་ནས་སོ་ལོས་རང་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་བརྩིས་པར་དྲུག་བརྒྱ་ཙམ་ཡོད་པ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་པར་མཚོན་ཆས་དཀོན་པ།"]},{"type":"verse","number":16,"content":["དེ་ནས་སོ་ལོ་དང་དེའི་སྲས་ཡོ་ནཱ་ཐན་དང་། དེ་གཉིས་དང་མཉམ་དུ་ཡོད་པའི་མི་ཐམས་ཅད་པེན་ཡཱ་མེན་གྱི་གེ་བཱ་རུ་གནས་ཏེ། ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་མིགས་མཱ་སི་རུ་སྒར་བཏབ།"]},{"type":"verse","number":17,"content":["དེ་ནས་འཕྲལ་རྒོལ་རུ་ཁག་ཅིག་ཕེ་ལེ་ཤེད་པའི་དམག་སྒར་ལས་ཐོན་ཏེ་རུ་དཔུང་གསུམ་དུ་བྱས། རུ་དཔུང་དང་པོ་ཨོབ་རཱ་རུ་འགྲོ་བའི་ལམ་ལ་ཞུགས་ནས་ཤུ་ཨལ་ཡུལ་ཕྱོགས་སུ་སོང་།"]},{"type":"verse","number":18,"content":["རུ་དཔུང་གཉིས་པ་པེད་ཧོ་རོན་གྱི་ལམ་དུ་ཞུགས་པ་དང་། རུ་དཔུང་གསུམ་པ་དབེན་སྟོང་གི་ཕྱོགས་སུ་ལུང་པ་ཙེ་བོ་ཡིམ་ཞེས་པའི་ཁ་གཏད་ཀྱི་ས་མཚམས་ཀྱི་ལམ་དུ་ཞུགས།"]},{"type":"verse","number":19,"content":["སྐབས་དེར་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཐམས་ཅད་དུ་མགར་བ་གཅིག་ཀྱང་མ་རྙེད་དོ། །གང་ལ་ཞེ་ན། ཕེ་ལེ་ཤེད་པས། ཨིབ་རི་པ་རྣམས་གྱིས་རལ་གྲིའམ་མདུང་རྣམས་རང་དོན་དུ་བཟོ་བར་བྱ་བསམ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":20,"content":["དེའི་ཕྱིར་ཡེས་ར་ཨེལ་པ་རྣམས་ནི་རང་གི་ཐོང་གཤོལ་ལམ། འཇོར་རམ། སྟ་རེའམ། ཟོར་བ་ལ་ཁ་འཕུད་པའི་ཕྱིར་ཕེ་ལེ་ཤེད་པའི་མདུན་དུ་སོང་།"]},{"type":"verse","number":21,"content":["དེ་དུས་གཤོལ་ལྕགས་དང་རྒྱ་ཟོར་ལ་རྣོ་བཏོན་པའི་རིན་གོང་ནི་དངུལ་ཞོ་གཅིག་གི་གསུམ་ཆའི་གཉིས་དང་། སྟ་རེ་དང་ཟོར་བ་ལ་རྣོ་བཏོན་པའི་རིན་གོང་ནི་དངུལ་ཞོ་གཅིག་གི་གསུམ་ཆའི་གཅིག་ཡིན།"]},{"type":"verse","number":22,"content":["དེའི་ཕྱིར་དམག་བརྒྱབ་པའི་ཉིན་ལ། སོ་ལོ་དང་དེའི་སྲས་ཡོ་ནཱ་ཐན་གཉིས་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་ཀྱི་ལག་ཏུ་རལ་གྲིའམ་མདུང་མེད་པ་དང་། སོ་ལོ་དང་ཁོང་གི་སྲས་ཡོ་ནཱ་ཐན་ཁོ་ནའི་ལག་ཏུ་ཡོད་པ་རེད།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པའི་དམག་ཚོགས་དམག་སྒར་ནས་ཐོན་ཏེ་མིགས་མཱ་སི་རུ་སླེབས་པའོ། །"]}],"footnotes":[{"noteId":4,"caller":"+","text":"ལོ་གཉིས་ཞེས་པའི་དོན་ནི། དཀོན་མཆོག་གིས་དཱ་བིད་རྒྱལ་པོར་ལུང་མ་བསྟན་པའི་སྔོན་དུ་སོ་ལོས་ལོ་གཉིས་ལ་སྲིད་བྱས་ཤིང་། དཱ་བིད་ལུང་བསྟན་པའི་རྗེས་སུའང་ལོ་སོ་བརྒྱད་ལ་སྲིད་བྱས། དེའི་རྐྱེན་གྱིས་མཛད་འཕྲིན་གྱི་ལེའུ་བཅུ་གསུམ་པའི་ཚིག་རྐང་ཉེར་གཅིག་པར་ལོ་བཞི་བཅུ་ཞེས་བྲིས་ཡོད་པ་ཡིན།","reference":{"chapter":13,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/1SA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}