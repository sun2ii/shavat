{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":14,"content":[{"type":"heading","content":["ཡོ་ནཱ་ཐན་གྱིས་ཕེ་ལེ་ཤེད་པར་དམག་འཁྲུག་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཉིན་ཞིག་སོ་ལོ་ཡི་སྲས་ཡོ་ནཱ་ཐན་གྱིས་རང་གི་གོ་མཚོན་འཁུར་བའི་གཞོན་ནུ་ལ། ད་ཤོག་དང་། ངེད་གཉིས་ཕ་རོལ་ཏུ་ཕེ་ལེ་ཤེད་པའི་སོ་པའི་རྩར་འགྲོ་བར་བྱ་ཞེས་སྨྲས་ཀྱང་དེ་རང་གི་ཕ་ལ་མ་སྨྲས་པ་རེད།"]},{"type":"verse","number":2,"content":["སོ་ལོ་ནི་གིབ་ཨ་ཡི་ས་མཚམས་སུ་མག་རོན་དུ་ཡོད་པའི་སེ་འབྲུ་ཤིང་གི་འོག་ཏུ་བསྡད་དེ། ཁོང་དང་མཉམ་དུ་མི་དྲུག་བརྒྱ་ཡོད་པ་དང་།"]},{"type":"verse","number":3,"content":["དེ་རྣམས་ལས་བེར་ཐུལ་གྱོན་པའི་མཆོད་དཔོན་ཨ་ཧི་ཡཱ་བྱ་བ་དེ་ཡོད་ཅིང་། ཨ་ཧི་ཡཱ་ནི་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཡིན། ཨ་ཧི་ཏུབ་དང་ཨི་ཁ་རྦོད་གཉིས་ནི་ཕེ་ནེ་ཧཱ་ཡི་བུ་ཡིན། ཕེ་ནེ་ཧཱ་ནི་སྔར་ཞི་ལོ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་དཔོན་ཡིན་པ་ཨེ་ལི་ཡི་བུ་ཡིན། སོ་ལོ་དང་མཉམ་དུ་ཡོད་པའི་མི་དེ་དག་གིས་ཡོ་ནཱ་ཐན་སོང་བ་མ་ཤེས་སོ། །"]},{"type":"verse","number":4,"content":["ཕེ་ལེ་ཤེད་པའི་སོ་པ་རྣམས་ཀྱི་རྩར་འགྲོ་བའི་ཕྱིར་ཡོ་ནཱ་ཐན་འགག་འཕྲང་བརྒལ་ནས་ཕྱིན་ཅིང་། ལོགས་གཉིས་སུ་གཡང་གཟར་ཡོད་པ་དང་། གཅིག་གི་མིང་ལ་འོད་འཕྲོ་བའི་གཡང་གཟར་ཟེར་ལ། གཞན་དེའི་མིང་ལ་གཡང་གཟར་ཚེར་མ་ཅན་",{"noteId":5},"ཞེས་ཟེར།"]},{"type":"verse","number":5,"content":["གཡང་གཟར་གཅིག་ནི་བྱང་དུ་མིགས་མཱ་སི་ཡི་ཕྱོགས་སུ་གཏད་ཡོད་པ་དང་། ཅིག་ཤོས་དེ་ལྷོ་རུ་གེ་བཱ་ཡི་ཕྱོགས་སུ་གཏད་ཡོད་པ་ཡིན།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡོ་ནཱ་ཐན་གྱིས་གོ་མཚོན་འཁུར་བའི་གཞོན་ནུ་ལ། ད་ཤོག་དང་། ངེད་གཉིས་ཕ་རོལ་ཏུ་མཚན་སྐྱི་བཅད་མེད་པའི་སོ་པ་རྣམས་ཀྱི་རྩར་འགྲོ་བར་བྱ། དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་ཀྱི་དོན་དུ་འཕྲིན་ལས་མཛད་སྲིད། དཀོན་མཆོག་ཡ་ཝཱེས་མི་མང་པོའམ་འགའ་ཞིག་བརྒྱུད་ནས་སྐྱབས་མཛད་པ་གང་ཡིན་ཡང་འགོག་ཐུབ་མཁན་གཅིག་ཀྱང་མེད་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":7,"content":["གོ་མཚོན་འཁུར་བའི་གཞོན་ནུ་དེས་ཁྱེད་ཀྱི་ཐུགས་འདོད་བཞིན་དུ་མཛོད་ཅིག གཟིགས་དང་བདག་ནི་ཁྱེད་དང་སེམས་པ་གཅིག་མཐུན་ངང་མཉམ་དུ་འགྲོ་བར་བྱ་ཞེས་ཞུས།"]},{"type":"verse","number":8,"content":["ཡོ་ནཱ་ཐན་གྱིས། ངེད་གཉིས་མི་དེ་རྣམས་ཀྱི་མདུན་དུ་སོང་སྟེ་སུ་ཡིན་པ་སྟོན་པར་བྱ།"]},{"type":"verse","number":9,"content":["གལ་ཏེ་དེ་དག་གིས་ང་ཚོ་ཁྱོད་རྣམས་ཡོད་སར་སླེབས་པའི་བར་དུ་སྡོད་ཅིག་ཟེར་ན། ངེད་གཉིས་དེ་དག་གི་མདུན་དུ་མི་འགྲོ་སྟེ་རང་གནས་སུ་སྡོད་པར་བྱ།"]},{"type":"verse","number":10,"content":["འོན་ཀྱང་དེ་དག་གིས་ང་ཚོའི་མདུན་དུ་ཤོག་ཅིག་ཟེར་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ངེད་གཉིས་ཀྱི་ལག་ཏུ་སྤྲོད་པར་འགྱུར་བས་ངེད་གཉིས་ཡར་འགྲོ་དགོས། གང་ལ་ཞེ་ན། གཏམ་དེ་ནི་ངེད་གཉིས་ཀྱི་ཕྱིར་རྟགས་ཤིག་ཡིན་པས་སོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་ཁོ་གཉིས་ཀྱིས་ཕེ་ལེ་ཤེད་པའི་སོ་པ་རྣམས་ལ་རང་གི་ལུས་བསྟན་ནས། ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས། ས་ཁུང་དུ་ཡིབ་སྟེ་ཡོད་པའི་ཨིབ་རི་པ་རྣམས་སླེབས་བྱུང་ཞེས་སྨྲས།"]},{"type":"verse","number":12,"content":["དེ་ནས་སོ་པ་རྣམས་ཀྱིས་ཡོ་ནཱ་ཐན་དང་དེའི་གོ་མཚོན་འཁུར་བའི་གཞོན་ནུ་གཉིས་ལ། ང་ཚོའི་མདུན་དུ་ཤོག་ཅིག ང་ཚོས་ཁྱོད་གཉིས་ལ་དོན་ཞིག་སྟོན་པར་བྱ་ཞེས་ཟེར་བས། ཡོ་ནཱ་ཐན་གྱིས་གོ་མཚོན་འཁུར་མཁན་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་མི་དེ་ཐམས་ཅད་ཡེས་ར་ཨེལ་གྱི་ལག་ཏུ་གནང་བའི་ཕྱིར་ཁྱོད་ངའི་རྗེས་སུ་འབྲོངས་ཤིག་ཅེས་བསྐུལ།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཡོ་ནཱ་ཐན་གོག་ནས་རི་དེའི་གྱེན་དུ་འགོས་པ་དང་། གོ་མཚོན་འཁུར་མཁན་ཁོའི་རྗེས་སུ་འབྲངས་པ་རེད། དེ་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས་ཡོ་ནཱ་ཐན་གྱི་མདུན་དུ་འགྱེལ་ཞིང་། གོ་མཚོན་འཁུར་མཁན་ཀྱིས་ཀྱང་ཁོའི་རྗེས་འབྲངས་ཏེ་ཁོ་ཚོ་བསད།"]},{"type":"verse","number":14,"content":["ཡོ་ནཱ་ཐན་དང་ཁོའི་གོ་མཚོན་འཁུར་མཁན་གཉིས་ཀྱིས་ཞིང་ཚིགས་ཕྱེད་ཀ་ཙམ་གྱི་ནང་དུ་བསད་པའི་མི་གྲངས་ནི་ཉི་ཤུ་ཙམ་ཡོད་པ་ཡིན། འདི་ནི་ཁོ་གཉིས་མཉམ་བརྒྱུགས་ཀྱིས་འཐབ་འཁྲུག་བྱས་པ་ཐེངས་དང་པོ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱིས་ཕེ་ལེ་ཤེད་པ་ལས་རྒྱལ་ཁ་བླངས་པ།"]},{"type":"verse","number":15,"content":["དེ་ནས་དམག་སྒར་དང་ཞིང་ཚིགས་ཀྱི་མི་དང་། མང་ཚོགས་དང་། གཞན་སོ་པ་དང་། ཨར་ཇག་རྣམས་འཇིགས་པར་གྱུར་ཏེ་ས་ཡང་འགུལ་བས་དཀོན་མཆོག་གིས་གནང་བའི་འཇིགས་སྐྲག་དེ་ནི་དྲག་པོར་གྱུར།"]},{"type":"verse","number":16,"content":["དེ་ནས་པེན་ཡཱ་མེན་གྱི་རྒི་བེ་ཨ་ནས་སོ་ལོ་ཡི་སོ་པ་རྣམས་ཀྱིས་བལྟས་པར། དམག་ཚོགས་ཁ་ཐོར་ནས་ཕར་ཚུར་བརྒྱུགས་པ་མཐོང་ངོ་། །"]},{"type":"verse","number":17,"content":["སོ་ལོས་རང་གི་དྲུང་དུ་ཡོད་པའི་མི་རྣམས་ལ། ད་ནི་མི་རྩིས་ཤིག་དང་། ངེད་རྣམས་ཀྱི་ཕྱོགས་ནས་སུ་ཞིག་སོང་བ་མཐོང་བར་འགྱུར་ཞེས་བཀའ་བསྒོས་པས། ཁོ་ཚོས་མི་རྩིས་བླངས་པ་ན། ཡོ་ནཱ་ཐན་དང་དེའི་གོ་མཚོན་འཁུར་བའི་གཞོན་ནུ་གཉིས་མེད་པ་ཤེས་པ་རེད།"]},{"type":"verse","number":18,"content":["དེ་ནས་སོ་ལོས་ཨ་ཧི་ཡཱ་ལ། དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འདི་རུ་ཁུར་ཤོག་ཅེས་བཀའ་བསྩལ། དེའི་དུས་སུ་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":19,"content":["དེ་ལྟར་མཆོད་དཔོན་ལ་གཏམ་གླེང་བའི་ཚེ། ཕེ་ལེ་ཤེད་པའི་དམག་སྒར་དུ་འུར་སྒྲ་སྔར་ལས་ཇེ་ཆེ་ནས་ཇེ་ཆེར་ཕྱིན་པས། སོ་ལོས་མཆོད་དཔོན་དེ་ལ་ཁྱོད་སྡོད་ཅིག་ཅེས་བཀའ་བསྩལ་ནས།"]},{"type":"verse","number":20,"content":["སོ་ལོ་དང་མཉམ་དུ་ཡོད་པ་ཐམས་ཅད་འཛོམས་ཏེ་དམག་རྒྱག་ཏུ་སོང་། དེ་རུ་ཕེ་ལེ་ཤེད་པ་ཐམས་ཅད་ཡོངས་སུ་མགོ་འཐོམ་སྟེ། ཀྱེ་ཧོ། ཁོ་ཚོས་རལ་གྲིས་ཕན་ཚུན་ལ་བསྣུན་པ་རེད།"]},{"type":"verse","number":21,"content":["ཡང་སྔོན་ཆད་ཕྱོགས་བཞི་ནས་འོངས་ཏེ་ཕེ་ལེ་ཤེད་པ་དག་གི་རྗེས་སུ་འབྲངས་པའི་ཨིབ་རི་པ་རྣམས་ནི་ད་ལྟ་སོ་ལོ་དང་ཡོ་ནཱ་ཐན་གཉིས་ཀྱི་རྗེས་སུ་འབྲང་བའི་ཡེས་ར་ཨེལ་པའི་ཕྱོགས་སུ་གྱུར།"]},{"type":"verse","number":22,"content":["ཡང་ཨེ་ཕཱར་ཡིམ་རི་ཁུལ་དུ་ཡིབ་ནས་སྡོད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཕེ་ལེ་ཤེད་པ་ཐམས་ཅད་བྲོས་པ་ཐོས་པས། དེ་དག་གིས་ཀྱང་དམག་བརྒྱབ་ཅིང་ཕེ་ལེ་ཤེད་པའི་ར་མདར་བརྒྱུགས།"]},{"type":"verse","number":23,"content":["དེ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་སྒྲོལ་བར་མཛད་དེ། གསོད་གཅོད་དེ་ནི་པེད་ཨ་ཝེན་གྱི་བར་དུ་བྱུང་ངོ་། །"]},{"type":"heading","content":["ཡོ་ནཱ་ཐན་ནི་སོ་ལོའི་བཀའ་དང་འགལ་བ།"]},{"type":"verse","number":24,"content":["ཉིན་མོ་དེར་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གཉའ་གནོན་བཏང་སྟེ། སོ་ལོས་དགོང་མོ་རང་གི་དགྲ་བོ་རྣམས་ལ་དགྲ་ཤ་ལེན་པའི་བར་དུ་ཁ་ཟས་སྤྱོད་མཁན་ཡོད་ན་མི་དེར་དམོད་མོ་འབྱུང་ཞེས་མནའ་བསྐྱལ་དུ་བཅུག་པས། མི་རྣམས་ཀྱིས་ཅི་ཡང་མ་ཟོས་སོ། །"]},{"type":"verse","number":25,"content":["མི་རྣམས་ནགས་ཚལ་ཞིག་ཏུ་སོང་ཞིང་། དེའི་ས་ཁར་སྦྲང་རྩི་ཡོད་པ་མཐོང་།"]},{"type":"verse","number":26,"content":["ཁོ་ཚོས་སྦྲང་རྩི་བཞུར་བ་མཐོང་ན་ཡང་དམ་བཅའ་དེ་ལ་འཇིགས་པས་མི་སུས་ཀྱང་རང་གི་ལག་པས་ཁ་རུ་རེག་མ་ཕོད་པ་རེད།"]},{"type":"verse","number":27,"content":["ཡོ་ནཱ་ཐན་གྱིས་རང་གི་ཕ་ཡིས་མི་རྣམས་ལ་མནའ་བསྐྱལ་དུ་བཅུག་པ་མ་ཐོས་པས། རང་གི་ལག་ཏུ་ཡོད་པའི་འཁར་བའི་རྩེ་མོ་སྦྲང་མའི་ཚང་ནང་དུ་བསྒྲེས་ཏེ། རང་གི་ལག་པས་ཁ་རུ་རེག་པ་དང་ཁོའི་མིག་གསལ་པོར་གྱུར་ཏོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་མི་རྣམས་ཀྱི་ཁྲོད་ནས་གཅིག་གིས། མི་ཐམས་ཅད་ངལ་ན་ཡང་ཁྱེད་ཀྱི་ཡབ་ཀྱིས་མི་རྣམས་ལ་མནའ་བསྐྱལ་དུ་བཅུག་ནས་དེ་དག་ལ། དེ་རིང་ཉིན་མོར་ཁ་ཟས་སྤྱོད་པའི་མི་དེར་དམོད་མོ་འབྱུང་སྨྲས་སོ་ཞེས་ཞུས།"]},{"type":"verse","number":29,"content":["དེ་ལྟར་ཞུས་པའི་ལན་དུ་ཡོ་ནཱ་ཐན་གྱིས། ངའི་ཕ་ཡིས་ཀུན་ལ་འཚེ་བར་བྱས། ད་ནི་ངས་སྦྲང་རྩི་ཕྲན་བུ་ཞིག་མྱངས་པས་མིག་ཅི་ལྟར་གསལ་པོར་གྱུར་པར་ལྟོས་ཤིག"]},{"type":"verse","number":30,"content":["གལ་ཏེ་མི་ཐམས་ཅད་ཀྱིས་དགྲ་བོ་ནས་ཅི་ཞིག་ཕྲོགས་པ་ཟོས་པ་ཡིན་ན། ཕེ་ལེ་ཤེད་པ་ཕམ་པར་གྱུར་པ་ནི་འདི་ལས་ལྷག་པར་འགྱུར་བ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":31,"content":["ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཤིན་ཏུ་ངལ་ཡང་། ཉིན་དེ་ལ་ཕེ་ལེ་ཤེད་པ་རྣམས་མིགས་མཱ་སི་ནས་ཨ་ཡཱ་ལོན་གྱི་བར་དུ་ཕམ་པར་བརྒྱབ་བོ། །"]},{"type":"verse","number":32,"content":["དེ་ནས་མཚན་མོར་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་དག་གི་བཅོམ་ནོར་ཏེ། ལུག་དང་། བ་གླང་དང་། བ་ཕྲུག་ཁྱེར་ཅིང་དེ་དག་བསད་ནས་ཁྲག་དང་ལྡན་པའི་ཤ་ཟོས་པ་རེད།"]},{"type":"verse","number":33,"content":["དེ་ནས་མི་འགའ་ཞིག་གིས་སོ་ལོ་ལ། ལྟོས་དང་། མི་རྣམས་ཀྱིས་ཁྲག་དང་ལྡན་པའི་ཤ་ཟ་ཞིང་། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱེད་པ་ཡིན་ཞེས་སྨྲས་པས། སོ་ལོས་ཁྱོད་རྣམས་ཀྱིས་གཡོ་ཟོལ་བྱས་པས་རྡོ་རྒན་ཞིག་ངའི་མདུན་དུ་སྒྲིལ་བར་གྱིས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":34,"content":["དེ་ནས་སོ་ལོས། ཁྱོད་ཅག་མི་རྣམས་ཀྱི་ཁྲོད་དུ་སོང་ནས་ཁོ་རྣམས་ལ། མི་རེ་རེས་རང་རང་གི་སྒོ་ཕྱུགས་ཁྲིད་དེ་འདི་རུ་བསད་ནས་ཤ་ཟོ་དང་། ཁྲག་དང་ལྡན་པའི་ཤ་ཟོས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱེད་མི་རུང་ཞེས་བསྐུལ་བར་གྱིས་ཞེས་སྨྲས། དེའི་ཕྱིར་མི་རྣམས་ཀྱིས་རང་གི་སྒོ་ཕྱུགས་ཁྲིད་དེ་མཚན་གྱི་དུས་སུ་དེ་རུ་བསད།"]},{"type":"verse","number":35,"content":["དེ་ནས་སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བརྩིགས་པ་དང་། དེ་ནི་སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྩིགས་པའི་མཆོད་ཁྲི་དང་པོ་ལགས་སོ། །"]},{"type":"verse","number":36,"content":["དེ་ནས་སོ་ལོས་མཚན་གྱི་དུས་སུ་ཕེ་ལེ་ཤེད་པའི་རྗེས་དེད་ནས་ཐོ་རངས་བར་དུ་བཅོམ་ན་ལེགས། དེ་དག་ལས་མི་གཅིག་ཀྱང་ཐར་དུ་མ་འཇུག་ཅེས་བསྐུལ་བས། མི་ཐམས་ཅད་གྱིས། ཁྱེད་ཀྱི་སྤྱན་དྲུང་དུ་གང་ཞིག་ལེགས་ན་དེ་བཞིན་དུ་མཛོད་ཅིག་ཅེས་ཞུས་པ་དང་། མཆོད་དཔོན་གྱིས། ཀྱེ། ད་ལྟ་ངེད་རྣམས་དཀོན་མཆོག་གི་དྲུང་དུ་འདུ་བར་བྱ་ཞེས་བསྐུལ་བས།"]},{"type":"verse","number":37,"content":["སོ་ལོས་དཀོན་མཆོག་ལ། བདག་ནི་ཕེ་ལེ་ཤེད་པའི་རྗེས་སུ་འདེད་རུང་ངམ། ཁྱེད་ཀྱིས་དེ་དག་ཡེས་ར་ཨེལ་གྱི་ལག་ཏུ་གནང་བར་མཛད་དམ་ཞེས་ཞུས་ཀྱང་། ཉིན་དེ་ལ་གསུང་ལན་གང་ཡང་མ་བྱུང་བ་རེད།"]},{"type":"verse","number":38,"content":["དེའི་ཕྱིར་སོ་ལོས། དེ་རིང་གི་སྡིག་པ་ནི་གང་ནས་བྱུང་བར་བལྟས་ཏེ་རྟོགས་པའི་ཕྱིར་མི་རྣམས་ཀྱི་རྗེ་བོ་རྣམས་འདིར་འདུ་བར་གྱིས།"]},{"type":"verse","number":39,"content":["བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་སྐྱབས་མགོན་གཏན་དུ་བཞུགས་པ་ཁོང་ཉིད་དཔང་དུ་བཙུགས་པ་ཡིན། མི་དེ་ནི་ང་རང་གི་བུ་ཡོ་ནཱ་ཐན་ཡིན་པའི་དབང་དུ་བཏང་ན་ཡང་། ཁོ་ངེས་པར་འཆི་དགོས་ཞེས་སྨྲས་ཀྱང་། མི་རྣམས་ཀྱི་ཁྲོད་ནས་གཅིག་གིས་ཀྱང་ཅི་ཡང་མ་ཞུས་སོ། །"]},{"type":"verse","number":40,"content":["དེ་ནས་ཁོང་གིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ། ཁྱོད་རྣམས་ཕྱོགས་གཅིག་ཏུ་སྡོད་དང་། ང་ནི་རང་གི་བུ་ཡོ་ནཱ་ཐན་དང་ཕྱོགས་གཅིག་ཏུ་སྡོད་པར་བྱ་ཞེས་སྨྲས་པས། མི་རྣམས་ཀྱིས་སོ་ལོ་ལ། ཁྱེད་ཀྱི་སྤྱན་དྲུང་དུ་གང་ཞིག་ལེགས་ན་དེ་བཞིན་དུ་མཛོད་ཅིག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":41,"content":["ཡང་སོ་ལོས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་སུ་ཉེས་མེད་ཡིན་པ་སྟོན་པར་མཛོད་ཅིག་ཅེས་ཞུས་པ་དང་། ཡོ་ནཱ་ཐན་དང་སོ་ལོ་གཉིས་ལ་རྒྱན་བབས་ཤིང་ཡེས་ར་ཨེལ་པ་རྣམས་ཐར་ཏོ། །"]},{"type":"verse","number":42,"content":["དེ་ནས་སོ་ལོས། ད་ལྟ་ངའི་བུ་ཡོ་ནཱ་ཐན་དང་ང་རང་གཉིས་ཀྱི་བར་དུ་རྒྱན་ཕོངས་ཤིག་སྨྲས་ནས་ཡོ་ནཱ་ཐན་ལ་བབས་པ་རེད།"]},{"type":"verse","number":43,"content":["དེ་ནས་སོ་ལོས་ཡོ་ནཱ་ཐན་ལ། ཁྱོད་ཀྱིས་ཅི་བྱས་པ་ང་ལ་ཤོད་ཅིག་ཅེས་སྨྲས་པས། ཡོ་ནཱ་ཐན་གྱིས་ཁོང་ལ། ངས་ནི་རང་གི་ལག་ཏུ་ཡོད་པའི་འཁར་བའི་རྩེ་མོ་ལ་འབྱར་བའི་སྦྲང་རྩི་ནས་ཅུང་ཙམ་མྱངས་པས་ང་འཆི་བར་ངེས་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":44,"content":["སོ་ལོས་ཀྱེ་ཡོ་ནཱ་ཐན། ཁྱོད་ནི་འཆི་བར་ངེས། དེ་ལྟར་མ་ཡིན་ཚེ་དཀོན་མཆོག་གིས་བདག་ལ་འདིའམ་འདི་ལས་ལྷག་པ་ཞིག་མཛད་པར་ཤོག་ཅེས་སྨྲས།"]},{"type":"verse","number":45,"content":["དེའི་ཕྱིར་མི་རྣམས་ཀྱིས་སོ་ལོ་ལ། ཡེས་ར་ཨེལ་ལ་མགོན་སྐྱབས་ཆེན་པོ་མཛད་མཁན་ཡོ་ནཱ་ཐན་ནི་འཆི་བར་འགྱུར་རམ། དཀོན་མཆོག་གིས་དེ་ལྟར་འབྱུང་བར་གནང་ག་ལ་སྲིད། ང་ཚོས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་པ་ཡིན་ཏེ། དེའི་མགོའི་སྐྲ་ཉག་གཅིག་ཀྱང་མི་ལེན་རོགས། ཁོང་གིས་དེ་རིང་ཉིན་མོར་དཀོན་མཆོག་དང་མཉམ་དུ་འཕྲིན་ལས་མཛད་པ་ཡིན་ཞེས་ཞུས་པས། མི་རྣམས་ཀྱིས་ཡོ་ནཱ་ཐན་འཆི་བ་ལས་ཐར་དུ་བཅུག"]},{"type":"verse","number":46,"content":["དེ་ནས་སོ་ལོ་ནི་ཕེ་ལེ་ཤེད་པའི་ར་མདར་རྒྱུག་པ་ནས་ལོག་སྟེ་ཕྱིར་ཕྱིན་པ་དང་། ཕེ་ལེ་ཤེད་པ་རྣམས་རང་གི་ཡུལ་དུ་སོང་།"]},{"type":"verse","number":47,"content":["དེ་ལྟར་སོ་ལོར་ཡེས་ར་ཨེལ་གྱི་སྲིད་དབང་ཐོབ་སྟེ། ཕྱོགས་བཞི་རུ་གནས་པའི་དགྲ་བོ་མོ་ཨབ་དང་། ཨམ་མོན་པ་རྣམས་དང་། ཨེ་དོམ་དང་། ཙོ་བཱ་ཡི་རྒྱལ་པོ་རྣམས་དང་། ཕེ་ལེ་ཤེད་པ་བཅས་ལ་དམག་དྲངས་ཤིང་གང་དུ་སོང་ན་དེར་ཆད་པ་བཅད་དོ། །"]},{"type":"verse","number":48,"content":["ཡང་སོ་ལོས་སྤོབས་པ་བསྐྱེད་ནས་ཨ་མཱད་ལེག་པ་རྣམས་ལས་རྒྱལ་བར་གྱུར་ཏེ། ཡེས་ར་ཨེལ་བཅོམ་མཁན་གྱི་ལག་ནས་བསྒྲལ་ལོ། །"]},{"type":"heading","content":["སོ་ལོ་ཡི་ཁྱིམ་མིའི་སྐོར།"]},{"type":"verse","number":49,"content":["སོ་ལོ་ཡི་སྲས་རྣམས་ནི། ཡོ་ནཱ་ཐན་དང་། ཨིས་པོ་ཤེད་",{"noteId":6},"དང་། མལ་ཀི་ཤུ་ཨ་གསུམ་ཡིན། ཡང་ཁོང་གི་སྲས་མོ་གཉིས་ནི། ཆེ་བའི་མིང་ལ་མེ་རཱབ་དང་། ཆུང་བའི་མིང་ལ་མི་ཀལ་བྱའོ། །"]},{"type":"verse","number":50,"content":["སོ་ལོ་ཡི་ཆུང་མ་སྟེ་མིང་ལ་ཨ་ཧི་ནོ་ཨམ་ཞེས་བྱ་བ་དེ་ནི་ཨ་ཧི་མཱ་སི་ཡི་བུ་མོ་ཡིན་ལ། དམག་ཚོགས་ཀྱི་འགོ་དཔོན་མིང་ལ་ཨབ་ནེར་ཞེས་བྱ་བ་ནི་སོ་ལོ་ཡི་ཁུ་བོ་ནེར་གྱི་བུ་ཡིན།"]},{"type":"verse","number":51,"content":["སོ་ལོ་ཡི་ཕ་ཁི་སི་དང་། ཨབ་ནེར་གྱི་ཕ་ནེར་བྱ་བ་དེ་གཉིས་ཨ་བེ་ཨེལ་ཞེས་པའི་བུ་ཡིན།"]},{"type":"verse","number":52,"content":["སོ་ལོ་ཡི་མི་ཚེ་གང་པོར་ཕེ་ལེ་ཤེད་པ་དང་དམག་འཁྲུག་དྲག་པོ་རྒྱག་དགོས་བྱུང་ཞིང་། སོ་ལོས་མི་སྟོབས་ཆེན་དང་ཡང་ན་སྙིང་རུས་ཅན་ཞིག་མཐོང་ན་མི་དེ་རང་དང་མཉམ་དུ་ཁྲིད་པའོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"བྲག་འདི་གཉིས་ཀྱི་མིང་འགྱུར་ལ་ལར་སྒྲ་བསྒྱུར་བྱས་ཡོད་མོད། འདིར་དོན་བསྒྱུར་བྱས་པ་ཡིན།","reference":{"chapter":14,"verse":4}},{"noteId":6,"caller":"+","text":"ཨིས་པོ་ཤེད་ཅེས་པའི་མིང་གཞན་དུ་ཨིས་བི་ཞེས་ཀྱང་བྱ།","reference":{"chapter":14,"verse":49}}]},"thisChapterLink":"/api/bod_ntb/1SA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/13.json","previousChapterAudioLinks":{},"numberOfVerses":52}