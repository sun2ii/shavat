{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":15,"content":[{"type":"heading","content":["ཡ་ཝཱེས་སོ་ལོ་རྒྱལ་པོ་ཡིན་པ་ཁས་མ་བླངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་མངགས་ཏེ་ཁྱོད་ཁོང་གི་འབངས་མི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་བར་བཀའ་གནང་བས། ད་ལྟ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":2,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་ཚེ། ཨ་མཱད་ལེག་མི་རིགས་ཀྱིས་དེ་ལ་ཆོམ་པོ་ལྟར་བསྒུགས་ཏེ་ཅི་ལྟར་བྱས་པ་དེ་ངས་དྲན་ནོ། །"]},{"type":"verse","number":3,"content":["དེའི་ཕྱིར་ཁྱོད་སོང་ནས་ཨ་མཱད་ལེག་པ་ལ་འཐབ་འཛིང་བྱོས་ཤིག སྙིང་རྗེ་མི་བསྐྱེད་པར་དེ་དག་ལ་ཅི་ཡོད་པ་ཐམས་ཅད་མེད་པར་བྱེད་ཅིང་སྐྱེས་པ་དང་བུད་མེད་དང་། ཕྲུ་གུ་འོ་འཐུང་དང་། བ་གླང་དང་ལུག་དང་རྔ་མོང་དང་བོང་བུ་ཐམས་ཅད་སོད་ཅིག་ཅེས་གསུངས་སོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":4,"content":["སོ་ལོས་མི་རྣམས་ལ་སྐད་བཏང་སྟེ་ཐི་ལཱ་ཨིམ་དུ་བསྡུས་ཤིང་། དེ་དག་གི་གྲངས་ཀ་བརྩིས་པ་ལ་རྐང་དམག་འབུམ་གཉིས་དང་ཡ་ཧུ་དཱ་པ་ཁྲི་ཚོ་གཅིག་ཡོད་དོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་སོ་ལོ་འཁོར་དང་བཅས་པ་ཡོང་ནས་ཨ་མཱད་ལེག་པ་དག་གི་རྒྱལ་ས་རུ་ཕྱིན་ཅིང་ལུང་པ་ཞིག་ནས་འཇབ་སྒུག་བྱས།"]},{"type":"verse","number":6,"content":["སོ་ལོས་ཀེ་ནེ་པ་རྣམས་ལ་འདི་ལྟར། ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་ཚེ་ཁྱོད་རྣམས་ཀྱིས་དེ་དག་ལ་སྙིང་རྗེ་བསྐྱེད་པས། ཁྱོད་རྣམས་ཨ་མཱད་ལེག་པའི་ཁྲོད་ནས་ཤོག་ཅིག གལ་ཏེ་མ་ཐོན་ན་དེ་དག་དང་མཉམ་དུ་མེད་པར་འགྱུར་ཞེས་བསྐུལ་བས་ཀེ་ནེ་པ་རྣམས་ཨ་མཱད་ལེག་པའི་ཁྲོད་ནས་ཐོན་པ་རེད།"]},{"type":"verse","number":7,"content":["དེ་ནས་སོ་ལོས་ཨ་མཱད་ལེག་པ་རྣམས་ལ་ཧ་བེ་ལཱ་ནས་ཨེ་ཅིབ་ཡུལ་གྱི་ཤར་ཕྱོགས་ཤུར་ཞེས་པའི་ཡུལ་དུ་འཐབ་འཛིང་བྱས་ཏེ།"]},{"type":"verse","number":8,"content":["ཨ་མཱད་ལེག་པའི་རྒྱལ་པོ་ཨ་གག་ཅེས་བྱ་བ་དེ་གསོན་བཟུང་བྱས་ཤིང་མི་ཐམས་ཅད་རལ་གྲིས་མེད་པར་བྱས་མོད།"]},{"type":"verse","number":9,"content":["སོ་ལོ་དང་མི་རྣམས་ཀྱིས་ཨ་གག་དང་ལུག་བཟང་པོ་དང་བ་གླང་བཟང་པོ། བ་ཕྲུག་བཟང་པོ། ལུ་གུ་བཟང་པོ་བཅས་ལེགས་པོ་ཐམས་ཅད་མེད་པར་མ་བཏང་ཞིང་། བློར་མི་འབབ་པ་དང་རིན་ཐང་མེད་པ་ཐམས་ཅད་མེད་པར་བྱས།"]},{"type":"verse","number":10,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་སཱ་མུ་ཨེལ་ལ་བྱུང་ཞིང་འདི་སྐད་དུ།"]},{"type":"verse","number":11,"content":["སོ་ལོ་རྒྱལ་པོར་བསྐོས་པའི་ཕྱིར་ང་རང་འགྱོད་པ་སྐྱེས་ཏེ། ཁོ་ང་དང་བྲལ་ནས་བཀའ་བཞིན་དུ་མི་བསྒྲུབ་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པས། སཱ་མུ་ཨེལ་སེམས་འཁྲུགས་ཏེ་མཚན་གང་པོར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་ཞུས་པ་རེད།"]},{"type":"verse","number":12,"content":["ཕྱི་ཉིན་ཞོགས་པར་སཱ་མུ་ཨེལ་ལངས་ནས་སོ་ལོ་དང་འཕྲད་པར་སོང་ཙ་ན། མི་ཞིག་གིས་སཱ་མུ་ཨེལ་ལ། སོ་ལོ་ནི་ཀར་མེལ་དུ་སོང་སྟེ་རང་གི་ཆེད་དུ་རྗེས་དྲན་གྱི་རྡོ་རིང་ཞིག་བཙུགས་ཤིང་ད་ལྟ་ཕར་འགྲུལ་ནས་གིལ་གལ་དུ་སོང་བ་ཡིན་ཞེས་ཞུས།"]},{"type":"verse","number":13,"content":["དེ་ནས་སཱ་མུ་ཨེལ་ནི་སོ་ལོ་ཡི་མདུན་དུ་ཕྱིན་པ་ན། སོ་ལོ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་བྱིན་རླབས་གནང་ངོ་། །ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་བསྒྲུབས་པ་ཡིན་ཞུས་པས།"]},{"type":"verse","number":14,"content":["སཱ་མུ་ཨེལ་གྱིས་ལུག་དང་བ་གླང་གིས་སྐད་རྒྱག་པའི་སྒྲ་ངའི་རྣ་བས་ཐོས་པ་དེ་ཅི་ཡིན་ཞེས་དྲིས་པའི་ལན་དུ།"]},{"type":"verse","number":15,"content":["སོ་ལོ་ན་རེ། ཁོ་རྣམས་ཀྱིས་དེ་དག་ཨ་མཱད་ལེག་པ་ནས་བཟུང་བ་རེད། དེའི་དམིགས་ཡུལ་ནི། ལུག་དང་བ་གླང་ཐམས་ཅད་ལས་ལེགས་པོ་རྣམས་ནི་མི་རྣམས་ཀྱིས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པར་འབུལ་འདོད་པ་ཡིན་ཞིང་། གཞན་ཐམས་ཅད་ང་ཚོས་མེད་པར་བྱས་པ་ཡིན་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":16,"content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ། ཁ་རོག་སྡོད་ཅིག མཚན་མོ་འདི་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་གསུངས་པའི་བཀའ་དེ་འཆད་པར་བྱ་ཞེས་པའི་ལན་དུ་དེ་ཡིས། འཆད་པར་མཛོད་ཅིག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས། ཁྱོད་ཀྱིས་རང་ཉིད་ཆུང་བར་བརྩིས་ནའང་། ཁྱོད་རང་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཁག་གི་འགོ་འདྲེན་དུ་གྱུར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པར་མཛད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལམ་དུ་མངགས་ཤིང་འདི་སྐད་དུ། ཁྱོད་སོང་ལ་ཨ་མཱད་ལེག་པ་སྡིག་ཅན་དེ་རྣམས་ཁྱོན་ནས་མེད་པར་བྱོས་ཤིག དེ་དག་ཚར་མ་བཅད་བར་དུ་འཐབ་འཛིང་བྱོས་ཤིག་ཅེས་བསྐུལ་ན་ཡང་།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མ་མཉན་པར། ནོར་ལ་ཧབ་ཐོབ་བརྒྱབ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་བྱེད་དོན་ཅི་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":20,"content":["སོ་ལོས་སཱ་མུ་ཨེལ་ལ། ཀྱེ་ཧོ། ངས་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མཉན་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་མངགས་པའི་ལམ་དུ་འགྲུལ་བ་ཡིན། ཨ་མཱད་ལེག་པའི་རྒྱལ་པོ་ཨ་གག་བཟུང་ནས་ཨ་མཱད་ལེག་པ་ཐམས་ཅད་ཡོངས་སུ་མེད་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":21,"content":["མི་རྣམས་ཀྱིས་ཁོ་ཚོས་ཕྲོགས་པའི་ལུག་དང་བ་གླང་ལེགས་པོ་ཀུན་གིལ་གལ་དུ་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པར་འབུལ་ངེས་ཞེས་སྨྲས།"]},{"type":"verse","number":22,"content":["སཱ་མུ་ཨེལ་ན་རེ།",{"text":"སྦྱིན་སྲེག་དང་ནི་མཆོད་པ་གཉིས་ཀ་ལས། །","poem":1},{"lineBreak":true},{"text":"ཡ་ཝཱེ་ཁོང་གི་བཀའ་ལ་མཉན་པར་དགའ། །","poem":1},{"lineBreak":true},{"text":"བཀའ་ལ་ཚུལ་བཞིན་མཉན་པ་དེ་ཉིད་ནི། །","poem":1},{"lineBreak":true},{"text":"ལུག་ཐུག་ཚིལ་ལས་བཟང་པོ་ཡོད་པ་ལགས། །","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ངོ་ལོག་སེམས་ནི་མོ་པའི་སྡིག་པ་དང་། །","poem":1},{"lineBreak":true},{"text":"མི་མཉན་སེམས་ནི་ངན་ཞིང་སྐུ་འདྲར་མཚུངས། །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱིས་ཡ་ཝཱེ་ཁོང་གི་བཀའ་དོར་བས། །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱང་ཁོང་གིས་རྒྱལ་པོ་བྱེད་ལས་དོར། །","poem":1},"ཞེས་སྨྲས་པའི་ལན་དུ།"]},{"type":"verse","number":24,"content":["སོ་ལོས་སཱ་མུ་ཨེལ་ལ། བདག་ནི་མི་རྣམས་ལ་འཇིགས་ནས་དེ་དག་གི་གཏམ་ལ་མཉན་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་དང་ཁྱེད་ཀྱི་གཏམ་ལས་འགལ་ཏེ་སྡིག་པ་བྱས་པ་ཡིན།"]},{"type":"verse","number":25,"content":["ད་ལྟ་ཁྱེད་ཀྱིས་བདག་གི་སྡིག་པ་སེལ་བར་མཛོད། བདག་དང་མཉམ་དུ་ཕྱིར་ཤོག་དང་བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕྱག་འབུལ་བར་བྱ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":26,"content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ། ང་ཁྱོད་དང་མཉམ་དུ་ཕྱིར་མི་འགྲོ་སྟེ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་དོར་བས་དཀོན་མཆོག་ཡ་ཝཱེས་ཀྱང་ཁྱོད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་བྱེད་དུ་མི་འཇུག་ཅེས་སྨྲས་ནས།"]},{"type":"verse","number":27,"content":["སཱ་མུ་ཨེལ་ཁ་ཕྱིར་འཁོར་ནས་འགྲོ་བར་བརྩམས་པ་ལ། སོ་ལོས་ཁོང་གི་གོས་ཀྱི་ཐུ་བ་བཟུང་བས་གོས་རལ་བར་གྱུར།"]},{"type":"verse","number":28,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་ཁོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རིང་ཉིན་མོར་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་སྲིད་ཁྱོད་ཀྱི་ལག་ནས་བླངས་ཏེ། རྒྱལ་སྲིད་འདི་ཁྱོད་ལས་བཟང་པོ་ཞིག་ལ་གནང་བར་འགྱུར།"]},{"type":"verse","number":29,"content":["ཡེས་ར་ཨེལ་གྱི་ནུས་མཐུ་ཆེན་པོ་ལགས་ཀྱིས་རྫུན་མི་གསུང་ལ། ཐུགས་འགྱོད་ཀྱང་མི་སྐྱེས། གང་ལ་ཞེ་ན། ཁོང་ནི་འགྱོད་པ་སྐྱེས་པའི་མི་དང་འདྲ་བ་མིན་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":30,"content":["ཡང་སོ་ལོ་ན་རེ། བདག་གིས་སྡིག་པ་བྱས་པ་ཡིན། དེ་ལྟ་ནའང་། ད་ལྟ་ཁྱེད་ཀྱིས་བདག་གི་མི་རྣམས་ཀྱི་རྒན་པོ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་དུ་བདག་ལ་བཀུར་སྟི་མཛད་ཅིང་། བདག་དང་མཉམ་དུ་ལོག་པར་མཛོད། བདག་གིས་ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕྱག་འབུལ་བར་བྱ་ཞེས་ཞུས་ནས།"]},{"type":"verse","number":31,"content":["སཱ་མུ་ཨེལ་ནི་སོ་ལོའི་རྗེས་སུ་འབྲངས་ཏེ་སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕྱག་ཕུལ་ཏོ། །"]},{"type":"verse","number":32,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས། ཨ་མཱད་ལེག་པའི་རྒྱལ་པོ་ཨ་གག་ངའི་མདུན་དུ་ཁྲིད་ཤོག་ཅེས་བཀའ་བསྩལ་པས། ཨ་གག་གིས་སེམས་སུ་འཆི་བའི་སྡུག་བསྔལ་ངེས་པར་རྫོགས་ཟིན་ནོ་ཞེས་སྨྲས་ཤིང་སྤྲོ་དགའི་ངང་དེར་སོང་ངོ་། །"]},{"type":"verse","number":33,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས། ཁྱོད་གྱིས་རལ་གྲིས་བུད་མེད་མང་པོ་ཞིག་ལ་ཕྲུ་གུ་མེད་པར་བྱས་པ་ལྟར། ཁྱོད་ཀྱི་མ་ཡང་ཕྲུ་གུ་མེད་པར་གྱུར་ཅིག་ཅེས་སྨྲས་ནས། སཱ་མུ་ཨེལ་གྱིས་ཨ་གག་ནི་གིལ་གལ་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དུམ་བུར་བཅད་པ་རེད།"]},{"type":"verse","number":34,"content":["དེ་ནས་སཱ་མུ་ཨེལ་ནི་རཱ་མ་ཡུལ་དུ་ཕྱིན་ཏེ་སོ་ལོ་ནི་གིབ་ཨ་རུ་རང་གི་ཁྱིམ་དུ་ཡར་སོང་།"]},{"type":"verse","number":35,"content":["ཡང་སཱ་མུ་ཨེལ་ཚེ་ལས་འདས་པའི་བར་དུ་སོ་ལོ་ལ་བལྟ་བར་མ་འོངས་ཏེ། སཱ་མུ་ཨེལ་གྱིས་སོ་ལོའི་དོན་དུ་མྱ་ངན་ཆེན་པོ་བྱས་ཤིང་སོ་ལོ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཡང་ཐུགས་འགྱོད་བྱུང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}