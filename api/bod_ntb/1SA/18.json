{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":18,"content":[{"type":"heading","content":["སོ་ལོས་དཱ་བིད་ལ་ཕྲག་དོག་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཱ་བིད་ཀྱིས་སོ་ལོ་དང་གཏམ་སྨྲས་ཚར་བ་ན། སོ་ལོའི་སྲས་ཡོ་ནཱ་ཐན་གྱི་སེམས་ནི་དཱ་བིད་ཀྱི་སེམས་དང་འདྲིས་པ་དང་། ཡོ་ནཱ་ཐན་གྱིས་དཱ་བིད་ལ་རང་གི་སྲོག་དང་འདྲ་བར་བྱམས་པོ་བྱས།"]},{"type":"verse","number":2,"content":["ཉིན་དེ་ལ་སོ་ལོས་དཱ་བིད་རང་གི་ཞབས་ཕྱི་པར་བསྐོས་ཏེ་ཕ་གཞིས་སུ་ཕྱིར་ལོག་ཏུ་མ་བཅུག་པ་དང་།"]},{"type":"verse","number":3,"content":["ཡོ་ནཱ་ཐན་གྱིས་དཱ་བིད་ལ་རང་དང་འདྲ་བར་བྱམས་པས་ཁོ་དང་མཉམ་དུ་ཁ་ཆད་བཞག་ཅིང་།"]},{"type":"verse","number":4,"content":["ཡོ་ནཱ་ཐན་གྱིས་རང་གི་ཕྱི་གོས་དང་གོ་མཚོན་དང་རལ་གྲི་དང་གཞུ་དང་སྐ་རགས་བཅས་དཱ་བིད་ལ་སྤྲད།"]},{"type":"verse","number":5,"content":["སོ་ལོས་དཱ་བིད་གང་དུ་མངགས་ཀྱང་ཁོ་དེར་འགྲོ་ཞིང་བྱ་བ་ཐམས་ཅད་འཇོན་པས། སོ་ལོས་དེ་ནི་དམག་དཔུང་གི་འགོ་དཔོན་དུ་བསྐོས་ནས་འབངས་མི་ཐམས་ཅད་དང་སོ་ལོའི་བློན་འཁོར་རྣམས་དེའི་ཕྱིར་ཤིན་ཏུ་དགའ་བར་གྱུར།"]},{"type":"verse","number":6,"content":["ཡང་དཱ་བིད་ཀྱིས་ཕེ་ལེ་ཤེད་པ་དེ་བསད་ནས་འཁོར་དང་བཅས་པ་ཕྱིར་ལོག་པའི་ཚེ། རྒྱལ་པོ་སོ་ལོ་བསུ་བའི་ཕྱིར་ཡེས་ར་ཨེལ་གྱི་གྲོང་ཁྱེར་སོ་སོ་ནས་བུད་མེད་རྣམས་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་གླུ་ལེན་གར་རྩེད་དང་སིལ་རྔ་བརྡུངས་པ་བཅས་རོལ་ཆ་གཞན་རྣམས་ཁུར་ནས་འོངས་ཏེ།"]},{"type":"verse","number":7,"content":["བུད་མེད་རྣམས་ཀྱིས་གར་འཆམ་བཞིན་འདི་ལྟར།",{"text":"སོ་ལོ་ཡིས་བསད་པ་སྟོང་ཕྲག་སྟེ། །","poem":1},{"lineBreak":true},{"text":"དཱ་བིད་ཀྱིས་བསད་པ་ཁྲི་ཕྲག་གོ །","poem":1},"ཅེས་གླུ་བླངས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་སོ་ལོ་ཤིན་ཏུ་ཁྲོས་ཤིང་གླུ་དེ་ལ་མ་དགའ་བར་དཱ་བིད་ཀྱིས་མི་ཁྲི་ཕྲག་བསད་ཀྱང་ངས་སྟོང་ཕྲག་གཅིག་འབའ་ཞིག་བསད། དེ་བས་ལྷག་པ་ཞིག་ཅི་ལུས་ཏེ་རྒྱལ་སྲིད་འབའ་ཞིག་ལུས་ཞེས་སྨྲས།"]},{"type":"verse","number":9,"content":["ཉིན་དེ་ནས་བཟུང་སོ་ལོ་ནི་དཱ་བིད་ལ་ཕྲག་དོག་སྐྱེས་པ་རེད།"]},{"type":"verse","number":10,"content":["ཕྱི་ཉིན་ཞོགས་པར་དཀོན་མཆོག་གི་གམ་ནས་བྱུང་བའི་སེམས་ཉིད་ངན་པ་དེ་སོ་ལོའི་སྟེང་དུ་བབས་པས་ཁོས་ཁྱིམ་དུ་གང་བྱུང་སྨྲས། སྐབས་དེར་དཱ་བིད་ཀྱིས་ཉིན་བཞིན་སྒྲ་སྙན་དཀྲོལ་ཞིང་སོ་ལོའི་ལག་ཏུ་མདུང་ཡོད་པ་དང་།"]},{"type":"verse","number":11,"content":["སོ་ལོས་མདུང་དེ་གཡུགས་ནས་ངས་དཱ་བིད་གྱང་ངོར་སྦྱོར་བར་བྱ་བསམས་པ་ན། དཱ་བིད་ཐེངས་གཉིས་ལ་གཡོལ་བ་རེད།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཱ་བིད་དང་མཉམ་དུ་བཞུགས་ཤིང་སོ་ལོ་དང་ཁ་བྲལ་བས་སོ་ལོ་ཁོ་ལ་འཇིགས་ཏེ།"]},{"type":"verse","number":13,"content":["དཱ་བིད་རང་གི་དྲུང་ནས་བཏང་སྟེ་སྟོང་དཔོན་བྱེད་དུ་བཅུག་ཅིང་དེ་ནས་དཱ་བིད་ཀྱིས་མི་ཚོགས་ཁྲོད་དུ་འགྲོ་འོང་བྱས།"]},{"type":"verse","number":14,"content":["བྱ་བ་ཐམས་ཅད་ལམ་ལྷོང་བྱུང་། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཁོ་དང་མཉམ་དུ་བཞུགས་པས་སོ། །"]},{"type":"verse","number":15,"content":["སོ་ལོས་ཁོའི་སྤྱོད་ཚུལ་ལས་ཁོ་ནི་ཤིན་ཏུ་བློ་རིག་ཅན་ཞིག་ཡིན་པ་ཤེས་ཏེ་འཇིགས་པ་རེད།"]},{"type":"verse","number":16,"content":["དཱ་བིད་ཀྱིས་ཡེས་ར་ཨེལ་པ་དང་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཁྲོད་དུ་འགྲོ་འོང་བྱས་པས་དེ་དག་གིས་ཁོ་གཅེས་སུ་བཟུང་ངོ་། །"]},{"type":"heading","content":["དཱ་བིད་ནི་སོ་ལོའི་སྲས་མོར་གཉེན་བསྒྲིགས་པ།"]},{"type":"verse","number":17,"content":["དེ་ནས་སོ་ལོས་དཱ་བིད་ལ། ངས་བུ་མོ་ཆེ་བ་མེ་རཱབ་བྱ་བ་ནི་ཁྱོད་ཀྱི་ཆུང་མར་གཏོང་བར་བྱ། ཁྱོད་ནི་ང་ཡི་ཕྱིར་དུ་དཔའ་རྩལ་ཅན་ཡིན་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་འཐབ་འཛིང་བྱོས་ཤིག་ཅེས་སྨྲས་ཤིང་། སོ་ལོའི་སེམས་སུ་ང་རང་གི་ལག་པ་ཁོ་ལ་མི་འཕོག་པར་ཕེ་ལེ་ཤེད་པའི་ལག་པ་ཁོ་ལ་འཕོག་པར་གྱུར་ཅིག་ཅེས་དྲན་ནོ། །"]},{"type":"verse","number":18,"content":["ཡང་དཱ་བིད་གྱིས་སོ་ལོ་ལ། བདག་གི་གཉེན་དང་བདག་གི་མེས་པོའི་ཁྱིམ་རྒྱུད་ནི་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་གོ་ཐོབ་ཅན་ཞིག་མིན་པས་བདག་རྒྱལ་པོའི་མག་པར་ཅི་ལྟར་འགྱུར་རམ་ཞེས་ཞུས།"]},{"type":"verse","number":19,"content":["ཡང་སོ་ལོའི་སྲས་མོ་མེ་རཱབ་ཅེས་པ་དཱ་བིད་ལ་ཆུང་མར་གཏོང་བའི་དུས་སུ་སླེབས་པའི་ཚེ། སྲས་མོ་དེ་ནི་མེ་ཧོ་ལད་པ་ཨད་རི་ཨེལ་བྱ་བ་དེ་ལ་ཆུང་མར་བཏང་ངོ་། །"]},{"type":"verse","number":20,"content":["ཡང་སོ་ལོའི་སྲས་མོ་མི་ཀལ་ནི་དཱ་བིད་ལ་ཆགས་སོ་ཞེས་པའི་གཏམ་སོ་ལོ་ལ་སྨྲས་པས་ཁོ་དགའ་སྟེ།"]},{"type":"verse","number":21,"content":["བུ་མོ་དེ་ཁོའི་ཕྱིར་རྙི་ལྟ་བུར་འགྱུར་ཡོང་བསམས་ནས་ཕེ་ལེ་ཤེད་པའི་ལག་པ་ཁོ་ལ་འཕོག་ཕྱིར་བུ་མོ་དེ་ཁོ་ལ་གཏོང་བར་བྱ་བསམས་པས། སོ་ལོས་དཱ་བིད་ལ་དེ་རིང་ཁྱོད་ལན་གཉིས་པར་ངའི་མག་པ་རུ་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":22,"content":["སོ་ལོས་རང་གི་བློན་འཁོར་རྣམས་ལ་བཀའ་གནང་སྟེ་ན་རེ། ཁྱོད་ཅག་གིས་ཟུར་དུ་དཱ་བིད་ལ་གཏམ་འདི་ལྟར་བྱོས་ཤིག རྒྱལ་པོ་ཁྱོད་ལ་དགའ་ཞིང་ཁོང་གི་བློན་འཁོར་ཐམས་ཅད་ཀྱང་ཁྱོད་ལ་ཆགས་པས། ད་ལྟ་རྒྱལ་པོའི་མག་པར་གྱུར་ཅིག་ཅེས་ཟེར་རུང་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":23,"content":["སོ་ལོའི་བློན་འཁོར་རྣམས་ཀྱིས་དེ་བཞིན་དུ་དཱ་བིད་ཀྱི་རྣ་བར་གཏམ་རྣམས་སྨྲས་པས། དཱ་བིད་ཀྱིས་ཁྱོད་ཅག་གིས་རྒྱལ་པོའི་མག་པར་འགྱུར་བ་ནི་ལས་སླ་མོ་ཡིན་པར་འདོད་དམ། ང་ནི་དབུལ་ཞིང་མཚན་སྙན་གྲགས་མེད་པ་ཞིག་ཡིན་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":24,"content":["བློན་འཁོར་རྣམས་ཀྱིས་སོ་ལོ་ལ་དཱ་བིད་ཀྱིས་སྨྲས་པ་ལྟར་བཤད་དོ། །"]},{"type":"verse","number":25,"content":["སོ་ལོ་ན་རེ། ཁྱོད་ཅག་གིས་དཱ་བིད་ལ་འདི་ལྟར། རྒྱལ་པོ་ནི་རྒྱུ་ནོར་ལ་མི་དགའ་བར་རང་གི་དགྲ་བོ་ལ་ཡ་ལན་སློག་པའི་ཕྱིར་ཕེ་ལེ་ཤེད་པའི་མཚན་སྐྱི་བརྒྱ་ལ་དགའ་བ་རེད་སྨྲོས་ཤིག་ཅེས་སྨྲས། མ་གཞི་སོ་ལོས་དཱ་བིད་ནི་ཕེ་ལེ་ཤེད་པའི་ལག་ནས་འཆི་བར་འགྱུར་རོ་བསམས་པ་རེད།"]},{"type":"verse","number":26,"content":["གཏམ་དེ་ནི་བློན་འཁོར་རྣམས་ཀྱིས་དཱ་བིད་ལ་སྨྲས་པས་ཁོ་རྒྱལ་པོའི་མག་པར་འགྱུར་བ་ལ་ཤིན་ཏུ་དགའ་བར་གྱུར། གཏན་འཁེལ་གྱི་ཉིན་མོར་མ་སླེབས་པས།"]},{"type":"verse","number":27,"content":["དཱ་བིད་ཁོ་རང་དང་ཁོའི་མི་རྣམས་ལངས་ནས་སོང་བ་དང་ཕེ་ལེ་ཤེད་པ་མི་ཉིས་བརྒྱ་བསད་དེ་ཁོ་ཚོའི་མཚན་སྐྱི་བཅད་ནས། དཱ་བིད་རྒྱལ་པོའི་མག་པར་འགྱུར་ཕྱིར་ཁོས་དེ་རྣམས་ཁ་ཚང་རྒྱལ་པོ་ལ་ཕུལ་ཞིང་། སོ་ལོས་རང་གི་སྲས་མོ་མི་ཀལ་ཞེས་པ་ཁོ་ལ་ཆུང་མར་བཏང་ངོ་། །"]},{"type":"verse","number":28,"content":["ཡང་སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཱ་བིད་དང་མཉམ་དུ་བཞུགས་ཡོད་པ་དང་རང་གི་སྲས་མོ་མི་ཀལ་ཡང་དཱ་བིད་ལ་ཆགས་པ་མཐོང་སྟེ།"]},{"type":"verse","number":29,"content":["སོ་ལོ་ལྷག་པར་དཱ་བིད་ལ་འཇིགས་ཏེ་རྟག་ཏུ་དཱ་བིད་ལ་གནོད་པ་བྱས་སོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པའི་རྗེ་བོ་རྣམས་སླེབས་པ་དང་དེ་དག་ནམ་འོངས་ན་ཡང་སོ་ལོའི་བློན་འཁོར་ཐམས་ཅད་དང་བསྡུར་ན་དཱ་བིད་ཀྱིས་བྱ་བ་རྣམས་ལེགས་པོར་བསྒྲུབས་པས། ཁོ་མཚན་སྙན་གྲགས་ཅན་དུ་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/17.json","previousChapterAudioLinks":{},"numberOfVerses":30}