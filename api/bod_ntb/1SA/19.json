{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":19,"content":[{"type":"heading","content":["སོ་ལོས་དཱ་བིད་གསོད་གྲབས་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སོ་ལོས་ཪང་གི་སྲས་ཡོ་ནཱ་ཐན་དང་བློན་འཁོར་ཐམས་ཅད་ལ་དཱ་བིད་གསོད་དགོས་པར་སྨྲས། ཡིན་ནའང་ཡོ་ནཱ་ཐན་ནི་དཱ་བིད་ལ་ཤིན་ཏུ་དགའ་བས།"]},{"type":"verse","number":2,"content":["ཡོ་ནཱ་ཐན་གྱིས་དཱ་བིད་ལ་སྨྲས་ཏེ་ན་རེ། ངའི་ཕ་སོ་ལོས་ཁྱོད་གསོད་འདོད་པས། སང་ཉིན་ཞོགས་པར་ཁྱོད་ཀྱིས་དོགས་ཟོན་བྱེད་དགོས་ཤིང་། མིས་མི་ཚོར་བའི་གནས་ཤིག་ཏུ་ཡིབ་པར་གྱིས་དང་།"]},{"type":"verse","number":3,"content":["ང་ནི་ཁྱོད་ཡིབ་སའི་ས་སྟོང་དུ་རང་གི་ཕ་ཡི་གཞོགས་སུ་འདུག་ཅིང་། ཕ་དང་མཉམ་དུ་ཁྱོད་ཀྱི་དོན་དུ་གཏམ་བྱེད་པ་དང་། དེ་ནས་ཅི་མཐོང་བ་དེ་ནི་ངས་ཁྱོད་ལ་འཆད་པར་བྱ་ཞེས་སྨྲས།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡོ་ནཱ་ཐན་གྱིས་རང་གི་ཕ་སོ་ལོའི་དྲུང་དུ་དཱ་བིད་ཀྱི་དོན་དུ་གཏམ་བཟང་པོ་སྨྲས་པ་ནི། རྒྱལ་པོས་རང་ཉིད་ཀྱི་ཞབས་ཕྱི་དཱ་བིད་ལ་འགལ་བའི་སྡིག་པ་མི་བྱེད་པར་མཛོད། གང་ལ་ཞེ་ན། ཁོས་ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་གང་ཡང་མ་བྱས་ཤིང་། ཁོས་ཅི་བྱས་ཐམས་ཅད་ཁྱེད་ལ་ཕན་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ཁོས་རང་སྲོག་འབེན་ལ་བཞག་ནས་ཕེ་ལེ་ཤེད་པ་དེ་བསད་པར་མ་ཟད། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་དོན་དུ་སྐྱབས་ཆེན་པོ་ཞིག་མཛད་ཅིང་། ཁྱེད་ཀྱིས་དེ་གཟིགས་ནས་དགའ་བར་གྱུར་ཏོ། །ཅིའི་ཕྱིར་མི་ཉེས་མེད་ལ་ཁྲག་བཞུར་དུ་འཇུག་གམ། དཱ་བིད་དོན་མེད་དུ་ཅི་ལ་གསོད་ཅེས་ཞུས་པས།"]},{"type":"verse","number":6,"content":["སོ་ལོས་ཡོ་ནཱ་ཐན་གྱི་གཏམ་དེ་ལ་མཉན་ནས། གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ཏེ། དཱ་བིད་མི་གསོད་ཁོ་ཐག་ཡིན་ཞེས་མནའ་བསྐྱལ་བ་རེད།"]},{"type":"verse","number":7,"content":["ཡང་ཡོ་ནཱ་ཐན་གྱིས་དཱ་བིད་བོས་ནས་དོན་དེ་ཁོ་ལ་སྨྲས་ཤིང་སོ་ལོའི་དྲུང་དུ་ཁྲིད་ནས། དཱ་བིད་སྔར་བཞིན་སོ་ལོའི་དྲུང་དུ་གནས་སོ། །"]},{"type":"verse","number":8,"content":["དེའི་རྗེས་སུ་ཡང་འཐབ་འཁྲུག་ཅིག་བྱུང་བས། དཱ་བིད་སོང་སྟེ་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་འཐབ་འཛིང་བྱས་ཤིང་། གསོད་གཅོད་དྲག་པོས་བཏུལ་ནས་དེ་དག་ཁོའི་དྲུང་ནས་བྲོས་པ་རེད།"]},{"type":"verse","number":9,"content":["ཡང་སོ་ལོས་རང་གི་མདུང་ལག་ཏུ་ཁྱེར་ནས་ཁང་པའི་ནང་བསྡད་ཡོད་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་གམ་ནས་བྱུང་བའི་སེམས་ཉིད་ངན་པ་སོ་ལོའི་སྟེང་དུ་བབས་ཤིང་དཱ་བིད་ཀྱིས་སྒྲ་སྙན་དཀྲོལ།"]},{"type":"verse","number":10,"content":["ཁོས་དཱ་བིད་མདུང་མགོར་བླངས་ཏེ་གྱང་ངོར་སྦྱོར་བའི་གོ་སྐབས་བཙལ་ཡང་། དཱ་བིད་ནི་སོ་ལོའི་དྲུང་ནས་བྱོལ་བ་དང་མདུང་རྩིག་པའི་ནང་ཟུག་ཅིང་། ཡང་མཚན་མོ་དེར་དཱ་བིད་བྲོས་ནས་ཐར་བ་རེད།"]},{"type":"verse","number":11,"content":["དེ་ནས་སོ་ལོས་དམག་འགའ་དཱ་བིད་ཀྱི་ཁྱིམ་དུ་མངགས་ཏེ་ཁོ་བསྲུངས་པ་དང་། དེ་ནི་ཕྱི་ཉིན་ཞོགས་པར་ཁོ་གསོད་པའི་ཕྱིར་རོ། །དཱ་བིད་ཀྱི་ཆུང་མ་མི་ཀལ་གྱིས་ཁོ་ལ། མཚན་མོ་འདི་ལ་ཁྱོད་ཀྱིས་རང་གི་སྲོག་སྐྱོབ་པར་མི་བྱེད་ན་སང་ཉིན་གསོད་པར་འགྱུར་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":12,"content":["མི་ཀལ་གྱིས་དཱ་བིད་སྒེའུ་ཁུང་ནས་ཕབ་སྟེ་ཁོ་བྲོས་སོང་བས་སྲོག་ཐར་བའོ། །"]},{"type":"verse","number":13,"content":["མི་ཀལ་གྱིས་ཁྱིམ་གྱི་སྐུ་འདྲ་དེ་བླངས་ནས་མལ་སའི་ནང་དུ་བཞག་པ་དང་། ར་སྤུས་བཟོས་པའི་སྔས་འབོལ་ཞིག་དེའི་མགོ་འོག་ཏུ་བཞག་ནས་གྱོན་གོས་ཀྱིས་བཀབ།"]},{"type":"verse","number":14,"content":["དེ་ནས་སོ་ལོས་དམག་རྣམས་དཱ་བིད་འཛིན་པར་མངགས་པས། ཆུང་མས་ཁོ་རང་ན་བཞིན་འདུག་ཅེས་སྨྲས།"]},{"type":"verse","number":15,"content":["སོ་ལོས་དཱ་བིད་ལ་བལྟ་རུ་ཡང་བསྐྱར་དམག་མངགས་ཤིང་། ངས་དེ་གསོད་པའི་ཕྱིར་ཁོ་མལ་ས་དང་བཅས་ངའི་མདུན་དུ་ཁྱེར་ཤོག་ཅིག་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་དམག་རྣམས་སླེབས་ཏེ་བལྟས་པས། མལ་སའི་ནང་གི་སྐུ་འདྲ་དེའི་མགོ་འོག་ཏུ་ར་སྤུས་བཟོས་པའི་སྔས་འབོལ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["དེ་ནས་སོ་ལོས་མི་ཀལ་ལ། ངའི་དགྲ་བོ་དེ་ཐར་བའི་ཕྱིར་ཁྱོད་ཀྱིས་ཁོ་ལམ་དུ་བཅུག་པ་སྟེ། ང་ལ་བསླུ་བྲིད་བཏང་བ་ཅི་ཡིན་ནམ་སྨྲས་པས། མི་ཀལ་གྱིས་ཁོས་ང་ལ། ང་འགྲོ་རུ་ཆུག་དང་། དེ་མིན་ཚེ་ངས་ཁྱོད་གསོད་ངེས་ཟེར་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་དཱ་བིད་བྲོས་ཏེ་སྲོག་ཐར་ནས། རཱ་མ་ཡུལ་དུ་སཱ་མུ་ཨེལ་གྱི་དྲུང་དུ་སླེབས་ཏེ་སོ་ལོས་ཁོ་ལ་ཅི་བྱས་པ་ཐམས་ཅད་སྨྲས། དེ་ནས་ཁོ་དང་སཱ་མུ་ཨེལ་གཉིས་ཀ་ནཱ་ཡོད་དུ་སོང་སྟེ་བསྡད་པ་རེད།"]},{"type":"verse","number":19,"content":["དེ་ནས་སོ་ལོ་ལ། ཀྱེ་ཧོ། དཱ་བིད་རཱ་མ་ཡུལ་གྱི་ནཱ་ཡོད་དུ་འདུག་ཅེས་པའི་གཏམ་སྨྲས་པས།"]},{"type":"verse","number":20,"content":["སོ་ལོས་དཱ་བིད་འཛིན་པའི་ཕྱིར་དམག་མངགས་ཤིང་། མི་དེ་རྣམས་ཀྱིས། ལུང་སྟོན་པའི་ཚོགས་ཀྱིས་ལུང་བསྟན་པ་དང་། དེ་དག་གི་ཁྲོད་དུ་སཱ་མུ་ཨེལ་གྱིས་འགོ་བྱེད་ཀྱིན་ཡོད་པ་མཐོང་བའི་ཚེ། སོ་ལོའི་དམག་རྣམས་ལ་དཀོན་མཆོག་གི་ཐུགས་ཉིད་བབས་པ་དང་ལུང་བསྟན་ཏོ། །"]},{"type":"verse","number":21,"content":["བྱུང་ཚུལ་དེ་ནི་སོ་ལོ་ལ་སྨྲས་པས། དམག་གཞན་དག་མངགས་ནས་དེ་དག་གིས་ཀྱང་ལུང་བསྟན་ཞིང་། ལན་གསུམ་པར་སོ་ལོས་དམག་མངགས་པ་དང་དེ་དག་གིས་ཀྱང་ལུང་བསྟན་པ་རེད།"]},{"type":"verse","number":22,"content":["དེ་ནས་སོ་ལོ་རང་ཉིད་ཀྱང་རཱ་མ་ཡུལ་དུ་སོང་སྟེ། སེ་གུ་རུ་ཡོད་པའི་ཆུ་དོང་ཆེན་པོའི་རྩར་སླེབས་ནས། སཱ་མུ་ཨེལ་དང་དཱ་བིད་གཉིས་གང་དུ་འདུག་ཅེས་དྲིས་པས། མི་ཞིག་གིས་ལྟོས་དང་དེ་གཉིས་རཱ་མ་ཡུལ་གྱི་ནཱ་ཡོད་དུ་འདུག་ཅེས་ཞུས།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཁོ་རང་རཱ་མ་ཡུལ་གྱི་ནཱ་ཡོད་དུ་འགྲོ་བའི་ཚེ། དཀོན་མཆོག་གི་ཐུགས་ཉིད་ཁོ་ལ་བབས་ནས་རཱ་མ་ཡུལ་གྱི་ནཱ་ཡོད་དུ་སླེབས་པའི་བར་དུ་ལུང་བསྟན་ཏེ་སོང་བ་དང་།"]},{"type":"verse","number":24,"content":["དེ་ནས་གོས་ཕུད་ནས་སཱ་མུ་ཨེལ་གྱི་དྲུང་དུ་ལུང་བསྟན་ཏེ་ཉིན་ཞག་གཅིག་ལ་གཅེར་བུར་ཉལ་ནས་བསྡད། དེའི་ཕྱིར་མི་ཐམས་ཅད་ཀྱིས་སོ་ལོ་ཡང་ལུང་སྟོན་པའི་ཁྲོད་དུ་འདུག་གམ་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/18.json","previousChapterAudioLinks":{},"numberOfVerses":24}