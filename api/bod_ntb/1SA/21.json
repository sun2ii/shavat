{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":21,"content":[{"type":"heading","content":["དཱ་བིད་མཆོད་དཔོན་ཨ་ཧི་མེ་ལེག་དང་ཕྲད་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཱ་བིད་ནོབ་ཅེས་པའི་ས་ཆ་ཡི་མཆོད་དཔོན་ཨ་ཧི་མེ་ལེག་བྱ་བའི་དྲུང་དུ་སླེབས་ནས། ཨ་ཧི་མེ་ལེག་སྐྲག་སྐྲག་འདར་འདར་ངང་དཱ་བིད་དང་འཕྲད་དུ་འོངས་ནས་དེ་ལ། ཁྱེད་གཅིག་པུ་འོངས་ཤིང་མཉམ་དུ་མི་གཅིག་ཀྱང་མེད་པ་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པར།"]},{"type":"verse","number":2,"content":["དཱ་བིད་ཀྱིས་མཆོད་དཔོན་ཨ་ཧི་མེ་ལེག་ལ། རྒྱལ་པོས་ལས་ཤིག་བསྒོས་ཏེ་འདི་ལྟར། ངས་ཁྱོད་གང་དུ་མངགས་པ་དང་ལས་ཅི་ཞིག་བསྒོས་པ་མི་སུ་ལ་ཡང་མངོན་པར་མ་བྱེད་ཅིག་ཅེས་བཀའ་གནང་བས། ངས་ནི་གཡོག་པོ་འགའ་གནས་ཤིག་ཏུ་མངགས་པ་ཡིན།"]},{"type":"verse","number":3,"content":["ད་ལྟ་ཁྱེད་ཀྱི་ལག་ཏུ་ཅི་ཡོད། བག་ལེབ་ལྔའམ་གང་ཡོད་པ་དེ་ང་ལ་གནང་རོགས་ཞེས་པའི་ལན་དུ།"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་གྱིས་དཱ་བིད་ལ། བག་ལེབ་དཀྱུས་མ་ངའི་ལག་ཏུ་མེད་དེ། འདི་རུ་བག་ལེབ་དམ་པ་ཡོད། གལ་ཏེ་གཡོག་པོ་དག་གིས་རང་རང་གི་ལུས་བུད་མེད་ལས་བསྲུངས་ཡོད་ན་སྤྲད་ཆོག་ཅེས་སྨྲས།"]},{"type":"verse","number":5,"content":["དཱ་བིད་ཀྱིས་མཆོད་དཔོན་ལ། ནམ་རྒྱུན་དམག་ལ་ཆས་པའི་སྐབས་བཞིན། ད་རེས་ཀྱང་ངེད་ཅག་བུད་མེད་དང་མ་འགྲོགས་པ་སྟེ། རྒྱུན་ལྡན་གྱི་དུས་སུ་གཡོག་པོ་ཐམས་ཅད་གཙང་མ་ཡིན་ན། དེ་རིང་ནི་སྔར་བས་ཀྱང་གཙང་མ་མ་ཡིན་ནམ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":6,"content":["མཆོད་དཔོན་གྱིས་ཁོ་ལ་བག་ལེབ་དམ་པ་གནང་ངོ་། །གང་ལ་ཞེ་ན། སྤྱན་བསྟར་བག་ལེབ་མ་གཏོགས་མེད་པས་བག་ལེབ་གསར་པ་ཡར་འབུལ་བའི་སྐབས་སུ། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་དྲུང་ནས་ཕྱིར་བླངས་པའི་བག་ལེབ་རྙིང་པ་དེ་དཱ་བིད་ལ་སྤྲད་དོ། །"]},{"type":"verse","number":7,"content":["ཉིན་དེར། སོ་ལོའི་ཞབས་ཕྱི་ཞིག་དེ་རུ་ཡོད་ཅིང་། ཁོ་རང་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འདུག་སྟེ། མི་དེའི་མིང་ལ་དོ་ཨེག་ཟེར་ཞིང་ཨེ་དོམ་པ་ཡིན། སོ་ལོའི་ཕྱུགས་རྫི་དག་གི་འགོ་དཔོན་ཡང་ཡིན།"]},{"type":"verse","number":8,"content":["ཡང་དཱ་བིད་ཀྱིས་ཨ་ཧི་མེ་ལེག་ལ། ཁྱེད་ཀྱི་ལག་ཏུ་མདུང་ངམ་རལ་གྲི་མེད་དམ། བདག་རྒྱལ་པོའི་ལས་ལ་བྲེལ་མྱུར་ཆེ་བས། འདིར་རལ་གྲིའམ་མཚོན་ཆ་ཅི་ཡང་ཁྱེར་མེད་ཅེས་ཞུས་པས།"]},{"type":"verse","number":9,"content":["མཆོད་དཔོན་གྱིས། ཨེ་ལཱ་ཞེས་པའི་ལུང་པའི་ནང་དུ་ཁྱོད་ཀྱིས་བསད་པའི་ཕེ་ལེ་ཤེད་པ་གོལ་ཡད་ཀྱི་རལ་གྲི་ཡོད། དེ་རས་ཀྱིས་བཏུམས་ནས་བེར་ཐུལ་གྱི་རྒྱབ་ཏུ་བཞག་ཡོད། ཁྱོད་ལ་དགོས་ན་ལོངས་ཤིག དེ་མ་གཏོགས་གཞན་གང་ཡང་འདི་རུ་མེད་ཟེར་བས། དཱ་བིད་ཀྱིས། འདི་དང་འདྲ་བ་གཞན་གང་ཡང་མེད་པས་དེ་ང་ལ་གནང་རོགས་ཞེས་ཞུས་སོ། །"]},{"type":"heading","content":["དཱ་བིད་ནི་གཱད་ཅེས་པའི་གྲོང་ཁྱེར་དུ་བྲོས་པ།"]},{"type":"verse","number":10,"content":["ཡང་དཱ་བིད་ཉིན་དེར་སོ་ལོ་ལ་གཡོལ་ནས་གཱད་ཀྱི་རྒྱལ་པོ་ཨ་ཀི་སི་ཡི་དྲུང་དུ་ཕྱིན།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཨ་ཀི་སི་ཡི་བློན་པོ་རྣམས་ཀྱིས་ཁོང་ལ། མི་འདི་ནི་དཱ་བིད་ཟེར་བ་ཡུལ་དེའི་རྒྱལ་པོ་མ་ཡིན་ནམ། སྔར་ནས་མི་རྣམས་ཀྱིས། སོ་ལོ་ཡིས་བསད་པ་སྟོང་ཕྲག་སྟེ། །དཱ་བིད་ཀྱིས་བསད་པ་ཁྲི་ཕྲག་གོ །ཞེས་གར་རྩེས་ནས་གླུ་ལེན་ཡུལ་དེ་མ་ཡིན་ནམ་ཞེས་ཞུས།"]},{"type":"verse","number":12,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་གཏམ་དེ་ཡིད་ལ་བཟུང་སྟེ་གཱད་ཀྱི་རྒྱལ་པོ་ཨ་ཀི་སི་ལ་ཤིན་ཏུ་འཇིགས་པ་དང་།"]},{"type":"verse","number":13,"content":["དེ་དག་གི་མིག་ལམ་དུ་ནམ་རྒྱུན་གྱི་སྤྱོད་ལམ་བསྒྱུར་ནས་སྨྱོ་ཁུལ་བྱས་པ་དང་རྒྱལ་སྒོར་གང་བྱུང་དུ་བྲིས་ཤིང་། མཆིལ་མ་སྨ་རའི་སྟེང་ལ་བཞུར་དུ་བཅུག"]},{"type":"verse","number":14,"content":["དེ་ནས་ཨ་ཀི་སི་ཡིས་རང་གི་བློན་པོ་རྣམས་ལ། མི་དེ་ནི་སྨྱོན་པ་ཡིན་ཏེ་ཅིའི་ཕྱིར་ངའི་མདུན་དུ་ཁྲིད་འོངས་པ་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["ང་ལ་མི་སྨྱོན་པ་ཉུང་འདུག་གམ། སྨྱོ་རྟགས་སྟོན་ཕྱིར་ཁྱོད་ཅག་གིས་མི་དེ་ངའི་མདུན་དུ་ཁྲིད་འོངས་པ་ཡིན་ནམ། མི་འདི་ངའི་ཁྱིམ་དུ་འཇུག་འོས་སམ་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/20.json","previousChapterAudioLinks":{},"numberOfVerses":15}