{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":22,"content":[{"type":"heading","content":["སོ་ལོས་མཆོད་དཔོན་དམར་གསོད་བྱས་པ།"]},{"type":"verse","number":1,"content":["དཱ་བིད་ས་ཆ་དེ་ནས་ཐོན་ཏེ་བྲག་ཕུག་ཨ་དུལ་ལཱམ་ཞེས་བྱ་བ་དེར་བྲོས་ཤིང་། གཏམ་དེ་ཁོའི་སྤུན་རྣམས་དང་ཕ་ཡི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་ཀྱིས་ཐོས་པ་དང་ཁོ་ཚོ་ཡང་དཱ་བིད་ཀྱི་རྩར་ཕྱིན་པ་རེད།"]},{"type":"verse","number":2,"content":["ཡང་འཚོ་བ་དཀའ་སྡུག་ཅན་དང་བུ་ལོན་ཅན། སེམས་སྡུག་ཅན་ཐམས་ཅད་དེར་འཛོམས་ནས་ཁོ་དེ་དག་གི་འགོ་དཔོན་དུ་གྱུར་ཅིང་ཁོ་དང་མཉམ་དུ་མི་བཞི་བརྒྱ་ཙམ་ཡོད།"]},{"type":"verse","number":3,"content":["ཡང་དཱ་བིད་ཡུལ་དེ་ནས་མོ་ཨབ་ཡུལ་གྱི་མི་ཙི་ཕེ་ཞེས་པའི་གྲོང་ཁྱེར་དུ་སོང་སྟེ། མོ་ཨབ་ཀྱི་རྒྱལ་པོ་ལ་དཀོན་མཆོག་གིས་བདག་ལ་ཅི་མཛད་པ་རྟོགས་པའི་བར་དུ་བདག་གི་ཕ་མ་གཉིས་ཀ་ཁྱེད་ཅག་དང་མཉམ་དུ་གནས་སུ་འཇུག་རོགས་ཞེས་ཞུས།"]},{"type":"verse","number":4,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཕ་མ་གཉིས་རྒྱལ་པོའི་དྲུང་དུ་ཁྲིད་ནས། ཁོ་རང་རི་རྫོང་དུ་སྡོད་པའི་རིང་དུ་ཕ་མ་གཉིས་ཀྱང་མོ་ཨབ་ཀྱི་རྒྱལ་པོ་དང་མཉམ་དུ་གནས་ཤིང་།"]},{"type":"verse","number":5,"content":["ཡང་ལུང་སྟོན་པ་གཱ་རྡུ་ཡིས་དཱ་བིད་ལ། རི་གསེབ་ཏུ་གནས་པར་མ་བྱེད་ཅིག ཁྱོད་ཡ་ཧུ་དཱ་ཡུལ་དུ་འགྲོ་དགོས་ཞེས་བསྐུལ་བས། དཱ་བིད་ལངས་ཏེ་ཧེ་རེད་ཅེས་བྱ་བའི་ནགས་ཁྲོད་དུ་ཕྱིན་ཏོ། །"]},{"type":"verse","number":6,"content":["སོ་ལོ་ནི་གིབ་ཨ་ས་ཆའི་རི་རྩེ་ཡི་འོམ་བུ་ཤིང་ཡོད་སར་བསྡད་པ་དང་། ལག་ཏུ་མདུང་ཐོགས་ཤིང་བློན་འཁོར་རྣམས་ཁོའི་མདུན་དུ་འགྲེངས་ནས་བསྡད། ཡང་སོ་ལོས་དཱ་བིད་དང་བཅས་པའི་མི་རྣམས་ཐག་ཉེ་ཞིག་ཏུ་ཡོད་པ་ཐོས་པས།"]},{"type":"verse","number":7,"content":["བློན་འཁོར་རྣམས་ལ། ཀྱེ་པེན་ཡཱ་མེན་པ་ཀུན། ཉོན་དང་། ཡེ་སེའི་བུ་དེས་ཁྱོད་ཅག་མི་རེ་རེ་ལ་ཞིང་དང་རྒུན་ཚལ་གཏོང་བར་བྱའམ། ཁྱོད་ཅག་མི་རེ་རེ་སྟོང་དཔོན་དང་བརྒྱ་དཔོན་དུ་འཇོག་པར་བྱའམ།"]},{"type":"verse","number":8,"content":["ཁྱོད་ཅག་ཐམས་ཅད་ཀྱིས་ང་ལ་ཅིའི་ཕྱིར་གནག་པ་ཡིན། ངའི་བུ་དང་ཡེ་སེའི་བུ་གཉིས་ཀྱིས་ཁ་ཆད་བྱས་པ་སུ་ཞིག་གིས་ཀྱང་ང་ལ་སྨྲས་མ་སོང་ལ། ངའི་བུ་ཡིས་ཞབས་ཕྱི་དང་ངའི་བར་དཀྲུག་ཤིང་འཕེན་སྐབས་སུའང་དེ་རིང་ནང་བཞིན་སུ་ཞིག་གིས་ཀྱང་ང་ལ་མ་སྨྲས་ཤིང་། སུ་ཞིག་གིས་ཀྱང་ང་ལ་གདུང་སེམས་མཉམ་སྐྱེད་མ་བྱས་ཞེས་སྨྲས།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཨེ་དོམ་པ་དོ་ཨེག་བྱ་བ་སོ་ལོ་ཡི་བློན་འཁོར་རྣམས་ཀྱི་ཁྲོད་དུ་འགྲེངས་ནས་ན་རེ། ངས་ནི་ཡེ་སེའི་བུ་དེ་ནོབ་བྱ་བའི་ཡུལ་དུ་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཨ་ཧི་མེ་ལེག་གི་མདུན་དུ་འགྲོ་བ་མཐོང་བྱུང་།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཨ་ཧི་མེ་ལེག་གིས་ཡེ་སེའི་བུ་ཡི་དོན་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ཅིང་ཁོ་ལ་རྒྱགས་དང་ཕེ་ལེ་ཤེད་པ་གོལ་ཡད་ཀྱི་རལ་གྲི་ཡང་བཏང་བྱུང་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་རྒྱལ་པོས་ཨ་ཧི་ཏུབ་ཀྱི་བུ་སྟེ་མཆོད་དཔོན་ཨ་ཧི་མེ་ལེག་དང་། དེའི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་དང་ནོབ་ཅེས་པའི་ས་ཆར་གནས་པའི་མཆོད་དཔོན་ཐམས་ཅད་ལ་འབོད་མཁན་མངགས་ཤིང་དེ་དག་རྒྱལ་པོའི་དྲུང་དུ་འོངས་ནས།"]},{"type":"verse","number":12,"content":["སོ་ལོས། ཀྱེ་ཨ་ཧི་ཏུབ་ཀྱི་བུ། ཁྱོད་ཀྱིས་ཉོན་ཅིག་ཅེས་བསྐུལ་བར། དེས་ནི། ངའི་བདག་པོ་ལགས། ང་རང་འདི་རུ་ཡོད་ཅེས་ལན་ཞུས།"]},{"type":"verse","number":13,"content":["སོ་ལོས་ཁོ་ལ། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ཡེ་སེའི་བུ་དང་ལྐོག་འབྲེལ་བྱས་ནས་ང་ལ་གནག་པ་ཡིན་ནམ། དེ་རིང་ནང་བཞིན་ཁོས་ང་ལ་འཇབ་སྒུག་བྱེད་པའི་ཆེད་དུ། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ཁོ་ལ་བག་ལེབ་དང་རལ་གྲི་བཏང་ནས་ཁོའི་དོན་དུ་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ་བམ་ཞེས་དྲིས།"]},{"type":"verse","number":14,"content":["ཨ་ཧི་མེ་ལེག་གིས་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱི་བློན་འཁོར་རྣམས་ཀྱི་ཁྲོད་དུ་གཡོ་སྒྱུ་མེད་པའི་དཱ་བིད་འདྲ་བ་སུ་ཡང་མེད། ཁོ་ནི་རྒྱལ་པོའི་མག་པ་དང་སྐུ་སྲུང་པའི་འགོ་དཔོན་དང་། ཁྱེད་ཀྱི་བློན་པོའི་ཁྲོད་དུ་བཀུར་སྟི་ཐོབ་པ་ཞིག་མ་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["བདག་གིས་དེ་རིང་ཐེངས་དང་པོར་ཁོའི་དོན་དུ་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ་པ་ཡིན་ནམ་ཟེར་ན་མ་ཡིན་ནོ། །རྒྱལ་པོས་ཉིད་ཀྱི་མི་སེར་ང་རང་དང་ངའི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ལ་དེ་ལྟ་བུའི་ལས་མ་འགེལ་ཞིག ལས་ཆེ་ཆུང་ཅི་ཡོད་ཀྱང་ཉིད་ཀྱི་ཞབས་ཕྱི་བདག་གིས་གང་ཡང་མི་ཤེས་ཞེས་ཞུས།"]},{"type":"verse","number":16,"content":["ལན་དུ་རྒྱལ་པོ་ན་རེ། ཀྱེ་ཨ་ཧི་མེ་ལེག ཁྱོད་དང་ཁྱོད་ཀྱི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་འཆི་དགོས་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":17,"content":["རྒྱལ་པོས་གཡས་གཡོན་དུ་སྡོད་པའི་སྐུ་སྲུང་པ་རྣམས་ལ། ཁྱོད་ཚོས་འཕྲལ་མར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་དཔོན་རྣམས་སོད་ཅིག དེ་དག་གིས་དཱ་བིད་ལ་རོགས་བྱས་པར་མ་ཟད། ཁོ་ཚོས་དཱ་བིད་བྲོས་པ་ཤེས་ཀྱང་ང་ལ་འཕྲིན་མ་བཏང་ཞེས་སྨྲས་ཀྱང་། རྒྱལ་པོའི་བློན་འཁོར་རྣམས་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་དཔོན་རྣམས་གསོད་པའི་ཕྱིར་ལག་པ་བརྐྱང་བར་མ་འཐད་དོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་རྒྱལ་པོས་དོ་ཨེག་ལ། ཁྱོད་ཀྱིས་འཕྲལ་མར་མཆོད་དཔོན་རྣམས་སོད་ཅིག་ཅེས་བཀའ་བསྒོས་པ་ལ། ཨེ་དོམ་པ་དོ་ཨེག་གིས་ཉིན་དེ་ལ་སོ་རས་ཀྱིས་བཟོས་པའི་བེར་ཐུལ་གྱོན་པའི་མི་བརྒྱད་ཅུ་གྱ་ལྔ་བསད་པ་རེད།"]},{"type":"verse","number":19,"content":["ཡང་མཆོད་དཔོན་གྱི་གྲོང་ཁྱེར་ནོབ་བྱ་བ་དེ་ནས་སྐྱེས་པ་དང་བུད་མེད། ཕྲུ་གུ་འོ་འཐུང་། བ་གླང་དང་བོང་བུ། ལུག་སོགས་རལ་གྲིས་བསད་དོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཨ་ཧི་མེ་ལེག་གི་བུ་རྣམས་ལས་ཨབ་ཡཱ་ཐར་ཞེས་བྱ་བ་དེ་དཱ་བིད་ཀྱི་མདུན་དུ་བྲོས།"]},{"type":"verse","number":21,"content":["ཨབ་ཡཱ་ཐར་གྱིས་སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་དཔོན་ཐམས་ཅད་བསད་པའི་དོན་དེ་དཱ་བིད་ལ་སྨྲས་པ་དང་།"]},{"type":"verse","number":22,"content":["དཱ་བིད་ཀྱིས་ཨབ་ཡཱ་ཐར་ལ། ངས་ཉིན་མོ་དེར་ཨེ་དོམ་པ་དོ་ཨེག་དེར་ཡོད་པ་མཐོང་ཞིང་། ཁོས་སོ་ལོ་ལ་ཡོངས་སུ་སྨྲ་བར་འགྱུར་བ་ངས་ཤེས། ཁྱོད་ཀྱི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་ཤི་བའི་རྒྱུ་ནི་ང་ཡིན།"]},{"type":"verse","number":23,"content":["ཁྱོད་མ་འཇིགས་ཤིག ང་དང་མཉམ་དུ་སྡོད་ཅིག སུ་ཁྱོད་ཀྱི་སྲོག་ལེན་དུ་ཡོང་ན་དེ་ནི་ངའི་སྲོག་ཀྱང་ལེན་དུ་ཡོང་བས། ངས་ཁྱོད་ཀྱི་སྲོག་བསྲུང་ཐུབ་པར་འགྱུར་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":23}