{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":24,"content":[{"type":"heading","content":["དཱ་བིད་ནི་སོ་ལོ་ལས་ཐར་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སོ་ལོ་ནི་ཕེ་ལེ་ཤེད་པ་དག་གི་རྗེས་སུ་དེད་ནས་ཕྱིར་ལོག་པའི་ཚེ། མི་རྣམས་གྱིས་ཁོང་ལ། ལྟོས་དང་དཱ་བིད་ནི་ཨེན་གེ་དི་བྱ་བའི་བྱེ་ཐང་དུ་འདུག་ཅེས་ཞུས་པས།"]},{"type":"verse","number":2,"content":["སོ་ལོས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ནས་བདམས་པའི་མི་སྟོང་ཕྲག་གསུམ་ཁྲིད་ཅིང་། དཱ་བིད་དང་དེའི་མི་རྣམས་འཚོལ་བའི་ཕྱིར་གནའ་བའི་བྲག་རྡོ་ཞེས་པར་ཕྱིན་པ་དང་།"]},{"type":"verse","number":3,"content":["ལམ་དུ་ཡོད་པའི་ལུག་རར་སླེབས་ཏེ། བྲག་ཕུག་ཅིག་ཡོད་སར་སོ་ལོ་བཙོག་པ་གཏོང་བའི་ཕྱིར་དེའི་ནང་ཕྱིན་པར་དཱ་བིད་སོགས་བྲག་ཕུག་དེའི་སྦུག་ཏུ་བསྡད་ཡོད་པ་རེད།"]},{"type":"verse","number":4,"content":["དེ་ནས་དཱ་བིད་ཀྱི་མི་རྣམས་ཀྱིས་ཁོ་ལ། ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་དགྲ་བོ་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲོད་ཅིང་། ཁྱོད་ཀྱིས་དེ་ལ་ཅི་འདོད་བཞིན་བྱས་ཆོག་ཅེས་གསུངས་པ་དང་། ད་ནི་ཉིན་དེ་སླེབས་བྱུང་ཞེས་སྨྲས་པ་ལ། དཱ་བིད་ལངས་ཏེ་གསང་བའི་སྒོ་ནས་སོ་ལོའི་གོས་ཀྱི་ཐུ་བ་བཅད།"]},{"type":"verse","number":5,"content":["ཡང་དེའི་རྗེས་སུ་ལས་དེ་བྱས་པར་དཱ་བིད་ཀྱི་སེམས་ནས་རང་ལ་སྨད་དོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་རང་གི་མི་རྣམས་ལ། ངའི་རྗེ་བོ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པ་དེ་ལགས་པས། ངས་ཁོང་གི་ཕྱོགས་སུ་ལག་པ་བརྐྱངས་ནས་ཁོང་ལ་རྒོལ་བར་གཏན་ནས་མི་བྱའོ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱིས་རང་གི་མི་རྣམས་བཀག་སྟེ་སོ་ལོ་ལ་རྒོལ་བར་མ་བྱས་ཤིང་། ཡང་སོ་ལོ་ལངས་ནས་བྲག་ཕུག་ནས་སྒོར་བུད་དེ་རང་གི་ལམ་དུ་ཞུགས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་དཱ་བིད་བྲག་ཕུག་ནས་ཐོན་ཏེ། ཀྱེ་བདག་གི་ཇོ་བོ་བདག་གི་རྒྱལ་པོ་ལགས་ཞེས་སོ་ལོ་བོས་པ་ན། སོ་ལོས་ཕྱི་མིག་བལྟས་ཤིང་དེར་དཱ་བིད་ཀྱིས་མར་བསྒུར་ནས་གདོང་སར་བཏུད་དེ་ཕྱག་བཙལ་བ་རེད།"]},{"type":"verse","number":9,"content":["ཡང་དཱ་བིད་ཀྱིས་སོ་ལོ་ལ། མི་རྣམས་ཀྱིས་ཁྱེད་ལ་ཀྱེ་ཧོ་དཱ་བིད་ཀྱིས་རྒྱལ་པོ་ཁྱེད་ལ་གནག་པར་འདོད་ཅེས་པའི་གཏམ་དེ་ལ་ཅིའི་ཕྱིར་གསན་པ་ཡིན་ནམ།"]},{"type":"verse","number":10,"content":["ལྟོས་དང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ནི་དེ་རིང་བྲག་ཕུག་ནང་དུ་ངའི་ལག་ལ་སྤྲད་པ་ཁྱེད་ཀྱི་སྤྱན་གྱིས་གཟིགས་པ་ཡིན། མི་འགའ་ཞིག་གིས་ང་ལ་ཁྱེད་སོད་ཅིག་ཟེར་ཡང་ངས་ཁྱེད་རང་མ་བསད། ངས་དེ་དག་ལ་ངའི་རྗེ་བོ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པ་དེ་ལགས་པས། ངའི་ལག་པ་བརྐྱངས་ནས་རང་གི་རྗེ་བོར་གནག་མི་ཕོད་ཅེས་སྨྲས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["ངའི་ཡབ་ལགས། ལྟོས་དང་། ངའི་ལག་ཏུ་ཡོད་པའི་གོས་ཀྱི་ཐུ་བ་འདི་ཁྱེད་ཀྱི་གོས་ནས་བཅད་ཀྱང་ཁྱེད་རང་མ་བསད་པས་འདི་ལ་གཟིགས་ཤིང་དེ་རྟོགས་པར་གྱིས། ང་ལ་ངན་དང་ཉེས་པ་ཅི་ཡང་མེད་དེ། ཁྱེད་ཀྱིས་ངའི་སྲོག་ལེན་པར་འདོད་ནའང་ངས་ཁྱེད་ལ་སྡིག་པ་མ་བྱས།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་དང་ངེད་གཉིས་ཀྱི་བར་ལ་ཤན་འབྱེད་པར་མཛོད་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ཀྱི་མདུན་ནས་ང་ལ་དཀར་འདོན་པར་མཛོད་ཅིག ངའི་ལག་པས་གཏན་ནས་ཁྱེད་ལ་གནག་མི་སྲིད།"]},{"type":"verse","number":13,"content":["སྔ་མ་རྣམས་ཀྱི་གཏམ་དཔེར། ངན་པ་ལས་ངན་པ་འབྱུང་ཟེར་ཡང་ངའི་ལག་པས་ཁྱེད་ལ་གནག་མི་སྲིད།"]},{"type":"verse","number":14,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ནི་སུའི་ཕྱིར་དུ་ཐོན་ནམ། ཁྱེད་སུའི་རྗེས་སུ་འདེད་དམ། ཁྱི་ཤི་རོའམ་ཁྱི་ཤིག་ཅིག་གི་རྗེས་སུ་འདེད་དམ།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རང་རེའི་བར་ཁྲིམས་ཐག་གཅོད་ཅིང་ལེགས་ཉེས་འབྱེད་པ་དང་། ཁོང་གིས་གཟིགས་ཏེ་ང་ལ་དཀར་འདོན་པར་མཛད་ནས། ང་ཁྱེད་ཀྱི་ལག་ནས་སྐྱོབ་པར་མཛོད་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་སོ་ལོ་ལ་གཏམ་བྱས་ཟིན་པ་ན་སོ་ལོས། ཀྱེ་དཱ་བིད། ངའི་བུ། འདི་ནི་ཁྱོད་ཀྱི་སྐད་ཡིན་ནམ་ཞེས་དྲིས་ཤིང་དྲག་ཏུ་ངུས་པ་རེད།"]},{"type":"verse","number":17,"content":["ཡང་ཁོང་གིས་དཱ་བིད་ལ། ཁྱོད་ང་ལས་ལྷག་པར་དྲང་བདེན་ཡིན། ངས་ཁྱོད་ལ་ངན་བྱས་མོད་ཁྱོད་ཀྱིས་ང་ལ་བཟང་བྱས་སོང་།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་ང་ལ་ཇི་ལྟ་བུའི་ལས་བཟང་པོ་བྱས་པ་དེ་ནི་ཁྱོད་ཀྱིས་ང་ལ་ཉིན་མོ་འདིར་སྨྲས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲོད་པར་མཛད་ཀྱང་ཁྱོད་ཀྱིས་ང་མ་བསད་དོ། །"]},{"type":"verse","number":19,"content":["གལ་ཏེ་མི་ཞིག་གིས་རང་གི་དགྲ་བོ་རྙེད་ན་ཁོས་དེ་ནི་བདེ་བར་གཏོང་ངམ། དེ་རིང་ཁྱོད་ཀྱིས་ང་ལ་དེ་ལྟར་མ་བྱས་པས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་བཟང་ལན་གནང་བར་ཤོག"]},{"type":"verse","number":20,"content":["ཡང་ད་ལྟ་ལྟོས་ཤིག ཁྱོད་ནི་ངེས་པར་རྒྱལ་པོར་འགྱུར་བ་དང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་སྲིད་ཁྱོད་ཀྱི་ལག་ཏུ་བརྟན་པོར་ཚུགས་པར་འགྱུར།"]},{"type":"verse","number":21,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་ངའི་རྗེས་སུ་ངའི་ཁྱིམ་རྒྱུད་མེད་པར་མི་བྱེད་པ་དང་ངའི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ནས་ངའི་མིང་མེད་པར་མི་བྱེད་པའི་མནའ་སྐྱོལ་ཞིག་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":22,"content":["དཱ་བིད་ཀྱིས་སོ་ལོ་ལ་མནའ་བསྐྱལ་ཏེ་སོ་ལོ་རང་གི་ཁྱིམ་དུ་ལོག་ཅིང་དཱ་བིད་དང་ཁོའི་མི་རྣམས་རི་རྫོང་ལ་ཕྱིན་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/23.json","previousChapterAudioLinks":{},"numberOfVerses":22}