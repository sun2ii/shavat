{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":25,"content":[{"type":"heading","content":["དཱ་བིད་དང་ནཱ་རྦལ། ཨ་བི་གཱ་ཡིལ་བཅས་ཀྱི་སྐོར།"]},{"type":"verse","number":1,"content":["ཡང་སཱ་མུ་ཨེལ་གྲོངས་ནས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་འཛོམས་པ་དང་། མྱ་ངན་བྱས་ཤིང་ཁོང་གི་སྐུ་གདུང་རཱ་མ་ཡུལ་དུ་རང་གི་ཁྱིམ་ནས་དུར་དུ་བཅུག ཡང་དཱ་བིད་ལངས་ཏེ་མར་ཕཱ་རན་བྱ་བའི་བྱེ་ཐང་དུ་སོང་།"]},{"type":"verse","number":2,"content":["མཱ་ཨོན་ཡུལ་དུ་མི་ཞིག་ཡོད་པ་དང་དེའི་རྒྱུ་ནོར་ཀར་མེལ་ཞེས་བྱ་བའི་ཡུལ་དུ་ཡོད་པ་ཡིན། མི་དེ་ནི་རྒྱུ་འབྱོར་བ་ཤིན་ཏུ་ཆེ་ཞིང་ཁོ་ལ་ལུག་སྟོང་ཕྲག་གསུམ་དང་། ར་སྟོང་ཕྲག་གཅིག་ཡོད་ཅིང་ཀར་མེལ་ཡུལ་དུ་མི་དེས་ལུག་གི་བལ་འབྲེག་པའི་སྒང་ལ།"]},{"type":"verse","number":3,"content":["མི་དེའི་མིང་ལ་ནཱ་རྦལ་",{"noteId":8},"ཞེས་ཟེར་ཞིང་ཁོ་ནི་ཀཱ་ལེབ་ཀྱི་རྒྱུད་ཡིན་ལ། ཁོའི་ཆུང་མའི་མིང་ལ་ཨ་བི་གཱ་ཡིལ་ཟེར། བུད་མེད་དེ་ནི་བློ་གྲོས་ལྡན་ཞིང་བྱད་གཟུགས་མཛེས་པ་ཞིག་ཡིན། ཁོ་ནི་གཤིས་ཀ་གྱོང་ཞིང་བྱ་སྤྱོད་ངན་པ་ཞིག་གོ །"]},{"type":"verse","number":4,"content":["དཱ་བིད་བྱེ་ཐང་དུ་གནས་པའི་ཚེ་ནཱ་རྦལ་གྱིས་རང་གི་ལུག་བལ་འབྲེག་པའི་གཏམ་ཐོས་ནས།"]},{"type":"verse","number":5,"content":["འཁོར་གཡོག་བཅུ་མངགས་ནས་དེ་རྣམས་ལ། ཁྱོད་ཅག་ཀར་མེལ་དུ་ནཱ་རྦལ་གྱི་མདུན་དུ་སོང་སྟེ་ཁོ་ལ་ངའི་མིང་བརྗོད་དེ་ཕྱག་བྱོས་ཤིག"]},{"type":"verse","number":6,"content":["ད་དུང་འདི་ལྟར། ཁྱེད་རང་ལོ་ནས་ལོར་བདེ་བར་ཤོག ཁྱེད་དང་ཁྱེད་ཀྱི་ཁྱིམ་དང་ཅི་ཡོད་པ་ཐམས་ཅད་ལ་ཞི་བདེ་འབྱུང་བར་ཤོག་ཅིག"]},{"type":"verse","number":7,"content":["ད་ལྟ་ཁྱེད་ཚང་གི་བལ་འབྲེག་པའི་སྐད་ཆ་ངས་ཐོས་ཤིང་ཁྱེད་ཀྱི་ལུག་རྫི་རྣམས་ང་ཚོ་དང་མཉམ་དུ་ཀར་མེལ་དུ་སྡོད་པའི་ཚེ། ང་ཚོས་དེ་དག་ལ་བརྙས་བཅོས་ཅི་ཡང་མ་བྱས་པ་དང་། ཁོ་ཚོའི་དངོས་པོ་ཅི་ཡང་མ་སྟོར་བ་ཡིན།"]},{"type":"verse","number":8,"content":["ཁྱེད་ཀྱིས་རང་གི་ཞབས་ཕྱི་རྣམས་ལ་དྲིས་ཤིག་དང་། དེ་དག་གིས་ཇི་བཞིན་འཆད་པར་བྱའོ། །དེའི་ཕྱིར་ངའི་ཞབས་ཕྱི་རྣམས་ལ་ཁྱེད་ཀྱི་སྤྱན་དྲུང་དུ་ཐུགས་རྗེ་འཐོབ་པར་གནང་སྟེ། ང་ཚོ་ཉིན་བཟང་ཞིག་ལ་སླེབས་པས་ཁྱེད་ཀྱི་ཕྱག་ཏུ་གང་ཡོད་ན། དེ་ནི་ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་ཅག་དང་ཁྱེད་ཀྱི་བུ་དཱ་བིད་ལ་གནང་བར་མཛོད་སྨྲོས་ཤིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["ཡང་དཱ་བིད་ཀྱི་ཞབས་ཕྱི་རྣམས་གནས་དེར་སླེབས་པའི་ཚེ། དེ་དག་གིས་གཏམ་དེ་བཞིན་དུ་དཱ་བིད་ཀྱི་མིང་བརྗོད་ནས་ནཱ་རྦལ་ལ་སྨྲས་པ་དང་ཁ་རོག་བསྡད།"]},{"type":"verse","number":10,"content":["དེ་ནས་ནཱ་རྦལ་གྱིས་དཱ་བིད་ཀྱི་ཞབས་ཕྱི་རྣམས་ལ། དཱ་བིད་སུ་ཡིན་ནམ། ཡེ་སེའི་བུ་སུ་ཡིན་ནམ། ད་ལྟ་རང་གི་འགོ་དཔོན་ནས་ཤོར་བའི་ཞབས་ཕྱིའི་གྲངས་འཕེལ་བཞིན་འདུག"]},{"type":"verse","number":11,"content":["ཡང་ངས་རང་གི་བག་ལེབ་དང་། ཆུ་དང་། བལ་འབྲེག་མཁན་གྱི་ཕྱིར་ལུག་བཤས་པའི་ཤ་བླངས་ཏེ་གང་ནས་ཡིན་པ་མི་ཤེས་པའི་མི་རྣམས་ལ་གཏོང་བར་བྱའམ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":12,"content":["དཱ་བིད་ཀྱི་ཞབས་ཕྱི་རྣམས་ཕྱིར་ལོག་ཅིང་རང་གི་ལམ་དུ་ཞུགས་ཏེ་སླེབས་ནས། ཁོང་ལ་གཏམ་དེ་ཐམས་ཅད་སྨྲས་པ་རེད།"]},{"type":"verse","number":13,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་རང་གི་མི་རྣམས་ལ། ད་མི་རེ་རེས་རང་རང་གི་རལ་གྲི་སྟ་གོན་བྱོས་ཤིག་ཅེས་སྨྲས་པས་མི་རེ་རེས་རལ་གྲི་བཏགས་པ་དང་། དཱ་བིད་ཀྱིས་ཀྱང་ཉིད་ཀྱི་རལ་གྲི་བཏགས། དཱ་བིད་ཀྱི་རྗེས་སུ་མི་བཞི་བརྒྱ་འབྲངས་པ་དང་། མི་ཉིས་བརྒྱ་ཡིས་དམག་ཆས་བསྲུངས་ནས་བསྡད་དོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་ནཱ་རྦལ་གྱི་ཞབས་ཕྱི་རྣམས་ལས་གཅིག་གིས་ནཱ་རྦལ་གྱི་ཆུང་མ་ཨ་བི་གཱ་ཡིལ་ལ། ལྟོས་དང་། དཱ་བིད་ཀྱིས་བྱེ་ཐང་ནས་བང་ཆེན་འགའ་ཞིག་ངེད་ཀྱི་འགོ་དཔོན་གྱི་དྲུང་དུ་འཚམས་འདྲི་བྱེད་པར་མངགས་མོད། ཁོས་དེ་དག་ལ་སྐུར་བ་བཏབ་པ་རེད།"]},{"type":"verse","number":15,"content":["མི་དེ་རྣམས་ངེད་ཅག་ལ་བཟང་པོ་ཡིན་ཏེ། ང་ཚོ་དབེན་སྟོང་དུ་དེ་དག་དང་མཉམ་དུ་གནས་པའི་ཚེ། ང་ཚོ་ལ་བརྙས་བཅོས་གང་ཡང་མ་བྱུང་ཞིང་། ང་ཚོའི་གྲས་ནས་གང་ཡང་མ་སྟོར་བ་ཡིན།"]},{"type":"verse","number":16,"content":["ང་ཚོས་དེ་དག་དང་མཉམ་དུ་ལུག་འཚོ་སྐབས། དེ་དག་ཉིན་མཚན་མེད་པར་ང་ཚོ་སྲུང་བའི་རྩིག་པ་ལྟ་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ངེད་ཀྱི་འགོ་དཔོན་དང་དེའི་ཁྱིམ་ཐམས་ཅད་ལ་སྡུག་བསྔལ་འབྱུང་བར་འགྱུར་བ་ཐག་གིས་ཆོད། ཁོ་མི་གདུག་རྩུབ་ཅན་ཡིན་ཏེ། མི་སུས་ཀྱང་ཁོ་ལ་གཏམ་བྱེད་པར་མི་ནུས་པས། ད་ལྟ་ཁྱེད་ཀྱིས་ཅི་བྱས་ན་ལེགས་པར་བསམ་མནོ་བཏང་ནས་རྟོགས་པར་གྱིས་ཤིག་ཅེས་ཞུས་པས།"]},{"type":"verse","number":18,"content":["ཨ་བི་གཱ་ཡིལ་གྱིས་མྱུར་དུ་བག་ལེབ་ཉིས་བརྒྱ་དང་། རྒུན་ཆང་རྐྱལ་བ་གཉིས། ལུག་གི་ཤ་ཁོག་ལྔ། ཡོས་བྲེ་ལྔ།",{"noteId":9},"རྒུན་འབྲུམ་སྐམ་པོ་ལེབ་མོ་བརྒྱ། སེ་ཡབ་ལེབ་མོ་ཉིས་བརྒྱ་བཅས་ཁྱེར་ཏེ་བོང་བུར་བཀལ་ཞིང་།"]},{"type":"verse","number":19,"content":["ཞབས་ཕྱི་རྣམས་ལ། ཁྱོད་ཅག་མདུན་བསུ་རུ་སོང་དང་། ང་ཁྱོད་ཅག་གི་རྗེས་སུ་འོང་བར་འགྱུར་ཞེས་སྨྲས་ཀྱང་། རང་གི་ཁྱོ་ག་ནཱ་རྦལ་ལ་ཅི་ཡང་མ་བཤད་པ་རེད།"]},{"type":"verse","number":20,"content":["ཡང་མོ་བོང་བུར་ཞོན་ཏེ་གྲོག་མོའི་ནང་དུ་འབབ་པའི་ཚེ། ཀྱེ་ཧོ། དཱ་བིད་དང་དེའི་མི་རྣམས་ཀྱང་ཁོ་མོའི་མདུན་དུ་མར་འོངས་པས་མོ་དེ་དག་དང་ཕྲད་དོ། །"]},{"type":"verse","number":21,"content":["ཡང་དཱ་བིད་ཀྱིས་སྔར་འདི་ལྟར། ངས་མི་འདིའི་ནོར་ཐམས་ཅད་བྱེ་ཐང་དུ་བསྲུངས་ཏེ་ཁོའི་ནོར་ནས་ཅི་ཡང་སྟོར་དུ་མ་བཅུག་པ་ནི་དངོས་གནས་དོན་མེད་རེད། ཁོས་བཟང་ལན་ངན་འཇལ་བྱས་སོང་།"]},{"type":"verse","number":22,"content":["སང་ཉིན་སྐྱ་རེངས་ཀྱི་བར་དུ་ཁོའི་མངའ་འོག་གི་མི་ཐམས་ཅད་ལས་སྐྱེས་པ་གཅིག་ཙམ་ལུས་བཅུག་ན། དཀོན་མཆོག་གིས་བདག་",{"noteId":10},"ལ་འདིའམ་འདི་ལས་ལྷག་པ་ཞིག་མཛད་པར་གྱུར་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཁོ་མོས་དཱ་བིད་མཐོང་སྟེ་མྱུར་དུ་བོང་བུ་ལས་བབས་ནས། དཱ་བིད་ཀྱི་དྲུང་དུ་རང་གི་གདོང་ས་ལ་བཏུད་དེ།"]},{"type":"verse","number":24,"content":["ཁོའི་ཞབས་དྲུང་དུ་ཕྱག་བཙལ་ནས་འདི་ལྟར། ཀྱེ་བདག་གི་ཇོ་བོ། སྐྱོན་དེ་ནི་བདག་གི་ཐོག་ཏུ་འབབ་པར་གྱུར་ཅིག ཡང་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་གཡོག་མོ་བདག་ལ་ཁྱེད་ཀྱི་སྙན་ལམ་དུ་གཏམ་བྱེད་པར་གནོངས་ཤིག དེ་ལས་ཀྱང་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་གཡོག་མོའི་གཏམ་ལ་གསན་རོགས།"]},{"type":"verse","number":25,"content":["ཀྱེ་བདག་གི་ཇོ་བོ། མི་ངན་པ་ནཱ་རྦལ་ལ་ཁ་ཡ་མི་བྱེད་པར་མཛོད། ཁོ་ནི་ཁོའི་མིང་ལྟར་གླེན་པ་ཞིག་ཡིན། འོན་ཀྱང་ཁྱེད་ཀྱི་གཡོག་མོ་བདག་གིས་ནི་ཁྱེད་ཀྱིས་མངགས་པའི་ཞབས་ཕྱི་རྣམས་མཐོང་བ་མ་ཡིན།"]},{"type":"verse","number":26,"content":["ད་ལྟ་བདག་གི་ཇོ་བོ་ལགས། ཁྱེད་ཀྱིས་དངོས་སུ་དགྲ་ཤ་བླངས་ཏེ་ཁྲག་བཞུར་བའི་ལས་བྱེད་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་འགོག་པར་མཛད་པས། ངས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་འཛུགས་པ་དང་ཁྱེད་རང་ཡང་དཔང་དུ་བཙུགས་པ་ཡིན་ཏེ། ཁྱེད་ཀྱི་དགྲ་བོའམ་ཁྱེད་ལ་གནོད་བསྐྱལ་བའི་མི་ཐམས་ཅད་ནཱ་རྦལ་དང་འདྲ་བར་གྱུར་ཅིག"]},{"type":"verse","number":27,"content":["ད་ལྟ་ཁྱེད་ཀྱི་གཡོག་མོས་རང་གི་ཇོ་བོའི་ཕྱིར་ཁྱེར་འོངས་པའི་ཞུ་རྟེན་འདི་ནི་ཉིད་ཀྱི་རྗེས་སུ་འབྲང་བའི་ཞབས་ཕྱི་རྣམས་ལ་གནང་བར་མཛོད་ཅིག"]},{"type":"verse","number":28,"content":["ཁྱེད་ཀྱི་གཡོག་མོས་བྱས་པའི་སྡིག་ཉེས་འདི་སེལ་བར་མཛོད་ཅིག ཀྱེ་བདག་གི་ཇོ་བོ་ལགས། ཁྱེད་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དམག་འཐབ་ཏུ་འགྲོ་བས། དཀོན་མཆོག་ཡ་ཝཱེས་ངེས་པར་དུ་ཁྱེད་ཀྱི་རྒྱུད་བརྟན་པོར་འཛུགས་པར་འགྱུར་ལ། ཁྱེད་ལས་ཇི་སྲིད་འཚོ་བའི་བར་དུ་མི་ལེགས་པ་ཅི་ཡང་རྙེད་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":29,"content":["ད་ལྟ་ཁྱེད་ཀྱི་རྗེས་འདེད་མཁན་དང་ཁྱེད་ཀྱི་སྲོག་འཚོལ་བའི་མི་ཞིག་བྱུང་ན་ཡང་། བདག་གི་ཇོ་བོའི་ཚེ་སྲོག་ནི་ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བསྲུངས་ཡོད་པ་དང་ཚེ་སྲོག་གི་རིན་ཆེན་གཏེར་མཛོད་དུ་སྦས་པ་ནང་བཞིན་ཡིན་ལ། ཁྱེད་ཀྱི་དགྲ་བོ་རྣམས་ཀྱི་མི་ཚེ་འུར་རྡོ་འཕངས་པ་བཞིན་གཡུག་པར་འགྱུར།"]},{"type":"verse","number":30,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་གི་ཇོ་བོ་ལ་གནང་བའི་ཞལ་བཞེས་བཟང་པོ་ཐམས་ཅད་བསྒྲུབས་ནས་ཁྱེད་ཉིད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་བའི་ཚེ།"]},{"type":"verse","number":31,"content":["ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་བ་དང་རང་གིས་དགྲ་ཤ་བླངས་པའི་སྡིག་པ་ནི་རང་གི་ཇོ་བོའི་སེམས་སུ་སྐྱོན་ལྟ་བུར་འབྱུང་མི་འགྱུར། རྗེས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ལ་བྱིན་རླབས་གནང་བའི་ཚེ། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་གཡོག་མོ་དྲན་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":32,"content":["དཱ་བིད་ཀྱིས་ཨ་བི་གཱ་ཡིལ་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་བསྟོད་འོས་པ་ཡིན་ཏེ། རྒྱུ་མཚན་ནི་དེ་རིང་ཁོང་གིས་ཁྱོད་མངགས་ནས་ང་བསུས་པས་སོ། །"]},{"type":"verse","number":33,"content":["ཁྱོད་དང་ཁྱོད་ཀྱི་མཐོང་རྒྱ་ལའང་བསྟོད་པ་འབུལ་འོས་ཏེ། རྒྱུ་མཚན་ནི་ངས་དངོས་སུ་དགྲ་ཤ་ལེན་པ་དང་གཞན་གྱི་ཁྲག་བཞུར་བ་ལ་ཁྱོད་ཀྱིས་བར་བཤོལ་བས་སོ། །"]},{"type":"verse","number":34,"content":["ཁྱོད་བརྒྱུགས་ཏེ་ང་དང་འཕྲད་དུ་མ་ཡོང་ཚེ། སྔ་མོ་སྐྱ་རེངས་ཀྱི་དུས་སུ་ནཱ་རྦལ་མངའ་འོག་གི་སྐྱེས་པ་གཅིག་ཀྱང་མི་ལུས་པ་ཡིན་ཏེ། ངས་ཁྱོད་ལ་གནོད་བྱེད་པ་འགོག་པར་མཛད་པའི་གཏན་དུ་བཞུགས་པའི་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་འཛུགས་པར་བྱ་ཞེས་སྨྲས།"]},{"type":"verse","number":35,"content":["དཱ་བིད་ཀྱིས་ཁོ་མོས་ཁྱེར་འོངས་པའི་ནོར་རྫས་ཐམས་ཅད་བླངས་ནས་དེ་ལ། ཁྱོད་རང་སེམས་ཁྲལ་མེད་པར་རང་གི་ཁྱིམ་དུ་སོང་ཞིག ལྟོས་དང་། ངས་ཁྱོད་ཀྱི་ངོ་སོ་ལ་བལྟས་ཏེ་གཏམ་ལ་མཉན་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":36,"content":["ཨ་བི་གཱ་ཡིལ་ནི་ནཱ་རྦལ་གྱི་དྲུང་དུ་ལོག་འོང་བའི་ཚེ་རྒྱལ་པོའི་དགའ་སྟོན་དང་འདྲ་བར་ཁོས་རང་གི་ཁྱིམ་ལ་དགའ་སྟོན་བྱས་ཤིང་། ནཱ་རྦལ་ནི་ཤིན་ཏུ་ར་བཟི་བས་སེམས་དགའ་བར་གྱུར། དེའི་ཕྱིར། སྔ་མོ་སྐྱ་རེངས་ཀྱི་བར་དུ་ཨ་བི་གཱ་ཡིལ་གྱིས་ཁོ་ལ་བྱ་བ་ཆེ་ཆུང་གང་ཡང་མ་སྨྲས་པ་རེད།"]},{"type":"verse","number":37,"content":["ཞོགས་པའི་དུས་སུ་ནཱ་རྦལ་བཟི་དྭངས་པ་དང་ཁོའི་ཆུང་མས་སྐད་ཆ་ཐམས་ཅད་སྨྲས་པས། ཁོའི་སྙིང་ཁྲག་འགག་ནས་ལུས་པོ་རྡོ་ལྟར་རེངས་པོར་གྱུར།"]},{"type":"verse","number":38,"content":["དེ་ནས་ཞག་བཅུ་ཙམ་སོང་བ་དང་དཀོན་མཆོག་ཡ་ཝཱེས་ནཱ་རྦལ་ལ་བརྡུངས་པས་ཁོ་ཤིའོ། །"]},{"type":"verse","number":39,"content":["དཱ་བིད་ཀྱིས་ནཱ་རྦལ་ཤི་ཟིན་པའི་གཏམ་ཐོས་ནས་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་བསྟོད་འོས་པ་ཡིན་ཏེ། ནཱ་རྦལ་གྱི་ལག་ནས་ང་ལ་གནོད་པ་བྱུང་བའི་ཚེ་དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་དོན་དུ་ཁོ་ལ་ཁྲིམས་བཅད་པ་དང་། ཁོང་ཉིད་ཀྱི་ཞབས་ཕྱི་བདག་གིས་སྡིག་པ་བྱེད་པ་འགོག་པར་མཛད། ཁོང་གིས་ནཱ་རྦལ་གྱི་ཉེས་པ་ནཱ་རྦལ་རང་གི་མགོ་ལ་བཞག་ཅེས་སྨྲས་ཤིང་། དཱ་བིད་ཀྱིས་ཨ་བི་གཱ་ཡིལ་རང་གི་ཆུང་མར་ལེན་འདོད་ནས་དེ་དང་གཏམ་བྱེད་དུ་མི་མངགས་པ་རེད།"]},{"type":"verse","number":40,"content":["དཱ་བིད་ཀྱི་ཞབས་ཕྱི་རྣམས་ཀར་མེལ་དུ་ཨ་བི་གཱ་ཡིལ་གྱི་མདུན་དུ་སླེབས་ནས་དེ་དག་གིས། ཁྱེད་དཱ་བིད་ཀྱི་ཆུང་མར་འགྱུར་བའི་ཕྱིར་ཁོང་གིས་བདག་ཅག་ཁྱེད་ཀྱི་མདུན་དུ་མངགས་པ་ཡིན་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":41,"content":["ཨ་བི་གཱ་ཡིལ་ལངས་ནས་ལུས་སར་བཏུད་དེ་ཕྱག་བཙལ་ཞིང་ན་རེ། ཁྱེད་ཀྱི་གཡོག་མོ་བདག་ནི་ཇོ་བོའི་ཞབས་ཕྱི་རྣམས་ཀྱི་རྐང་པ་བཀྲུ་བའི་གཡོག་མོ་ཞིག་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":42,"content":["ཡང་ཨ་བི་གཱ་ཡིལ་མྱུར་དུ་ལངས་ནས་བོང་བུར་ཞོན་ཏེ་རང་གི་གཡོག་མོ་ལྔ་དང་བཅས་ཏེ་དཱ་བིད་ཀྱི་བང་ཆེན་གྱི་རྗེས་སུ་སོང་ནས་ཁོའི་ཆུང་མར་གྱུར་ཏོ། །"]},{"type":"verse","number":43,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཡེ་སི་རེ་ཨེལ་ནས་ཨ་ཧི་ནོ་ཨམ་ཡང་བླངས་ནས་དེ་གཉིས་ནི་ཁོའི་ཆུང་མ་ཡིན།"]},{"type":"verse","number":44,"content":["ཡང་སོ་ལོས་རང་གི་སྲས་མོ་མི་ཀལ་ཏེ། སྔར་དཱ་བིད་ཀྱི་ཆུང་མ་ཡིན་པ་དེ་ནི་ལཱ་ཨི་སི་ཡི་བུ་ཕཱལ་ཏི་ལ་བག་མར་བཏང་ཞིང་། ཕཱལ་ཏི་ནི་གཱལ་ལིམ་གྲོང་རྡལ་གྱི་མི་ཡིན་ནོ། །"]}],"footnotes":[{"noteId":8,"caller":"+","text":"ནཱ་རྦལ་ཞེས་པ་ནི་བོད་སྐད་དུ་གླེན་པའི་དོན་ཡིན།","reference":{"chapter":25,"verse":3}},{"noteId":9,"caller":"+","text":"མ་ཕྱི་ལས་སེ་ཡ་ལྔ་ཞེས་བྲིས་ཡོད་པ་དང་བོད་ཀྱི་དབང་དུ་བྱས་ན་སེ་ཡ་གཅིག་ནི་བྲེ་གཅིག་ཡིན་པ་རེད།","reference":{"chapter":25,"verse":18}},{"noteId":10,"caller":"+","text":"གྷི་རིག་གི་མ་ཕྱི་ལས་དཱ་བིད་ཅེས་བྲིས་ཡོད་མོད་ཨིབ་རིའི་མ་ཕྱི་ལས་དཱ་བིད་ཀྱི་དགྲ་བོ་ཞེས་བྲིས་ཡོད། བརྟགས་ན་དཱ་བིད་རང་ཟེར་བ་འདྲ་བས་འདི་ལྟར་བསྒྱུར།","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/bod_ntb/1SA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/24.json","previousChapterAudioLinks":{},"numberOfVerses":44}