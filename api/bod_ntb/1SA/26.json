{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":26,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཡང་བསྐྱར་སོ་ལོ་སྲོག་ཐར་བཏང་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཟིབ་པ་རྣམས་གིབ་ཨ་རུ་སོ་ལོའི་དྲུང་དུ་འོངས་ནས། དཱ་བིད་ནི་ཡེ་ཤི་མོན་ཁ་གཏད་དུ་ཡོད་པའི་རི་ཧ་ཀི་ལཱ་དེར་ཡིབ་འདུག་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":2,"content":["སོ་ལོ་ལངས་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལས་བདམས་པའི་མི་སྟོང་ཕྲག་གསུམ་ཁྲིད་དེ་དཱ་བིད་འཚོལ་བའི་ཕྱིར་ཟིབ་ཀྱི་བྱེ་ཐང་དུ་མར་སོང་བ་རེད།"]},{"type":"verse","number":3,"content":["དེ་ནས་སོ་ལོས་ཡེ་ཤི་མོན་ཁ་གཏད་དུ་ཡོད་པའི་རི་ཧ་ཀི་ལཱའི་གམ་གྱི་ལམ་འགྲམ་ལ་དམག་སྒར་བཏབ། དཱ་བིད་བྱེ་ཐང་དུ་གནས་པ་དང་། ཁོས་སོ་ལོ་བྱེ་ཐང་དུ་རང་གི་རྗེས་དེད་ནས་འོངས་པ་མཐོང་བས།"]},{"type":"verse","number":4,"content":["དཱ་བིད་ཀྱིས་མྱུལ་མ་མངགས་ཤིང་སོ་ལོ་དངོས་གནས་སླེབས་པ་ཤེས།"]},{"type":"verse","number":5,"content":["དེ་ནས་དཱ་བིད་ལངས་ནས་སོ་ལོས་དམག་སྒར་བཏབ་པའི་གནས་སུ་སླེབས་པ་དང་དཱ་བིད་ཀྱིས་སོ་ལོ་ཉལ་སའི་གནས་དང་། སོ་ལོ་ཡི་དམག་དཔོན་ནེར་གྱི་བུ་ཨབ་ནེར་བྱ་བ་དེ་མཐོང་། སོ་ལོ་དམག་སྒར་ལ་ཉལ་ཏེ་དམག་ཚོགས་ཀྱིས་དེའི་མཐའ་འཁོར་ལ་དམག་གུར་ཕུབ་བོ། །"]},{"type":"verse","number":6,"content":["དཱ་བིད་ཀྱིས་ཧེད་པ་ཨ་ཧི་མེ་ལེག་དང་ཟེ་རུ་ཡཱ་ཡི་བུ་ཨ་བི་ཤཱ་ཨི་སྟེ་ཡོ་ཨབ་གྱི་ནུ་བོ་ཡིན་པ་དེ་གཉིས་ལ། སུ་ཞིག་ང་དང་མཉམ་དུ་དམག་སྒར་ལ་སོ་ལོའི་གམ་དུ་འགྲོ་ཞེས་དྲིས་པར། ཨ་བི་ཤཱ་ཨི་ཡིས། ང་ཁྱེད་དང་མཉམ་དུ་འགྲོ་ཞེས་ཞུས་ནས།"]},{"type":"verse","number":7,"content":["དཱ་བིད་དང་ཨ་བི་ཤཱ་ཨི་གཉིས་མཚན་གྱི་དུས་སུ་དམག་ཚོགས་ཀྱི་དཀྱིལ་དུ་སླེབས་ཏེ། སོ་ལོ་དམག་སྒར་ལ་གཉིད་ནས་བསྡད་ཡོད་ཅིང་ཁོའི་མདུང་ནི་ས་རུ་མགོ་ཡི་ཕྱོགས་སུ་བཙུགས་ཏེ། ཨབ་ནེར་དང་དམག་ཚོགས་ནི་རྒྱལ་པོའི་མཐའ་བསྐོར་ནས་ཉལ་ཡོད་པ་རེད།"]},{"type":"verse","number":8,"content":["དེ་ནས་ཨ་བི་ཤཱ་ཨི་ཡིས་དཱ་བིད་ལ། དཀོན་མཆོག་གིས་ཁྱེད་ཀྱི་དགྲ་བོ་ཁྱེད་ཀྱི་ལག་ཏུ་སྤྲད་པས། ད་ལྟ་ང་ལ་ཁོ་གསོད་དུ་ཆུག་ཅིག ངས་ཁོ་མདུང་དང་མཉམ་དུ་ལན་གཅིག་གིས་ས་རུ་འབིགས་པར་བྱ་སྟེ། ལན་གཉིས་པར་རྒྱག་མི་དགོས་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":9,"content":["དཱ་བིད་ཀྱིས་ཨ་བི་ཤཱ་ཨི་ལ། ཁོ་མ་གསོད་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པའི་སྟེང་ལག་པ་བརྐྱངས་ན་ཆད་པ་མེད་པར་སུ་ལུས་སམ་ཞེས་དྲིས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཡང་དཱ་བིད་ཀྱིས། ངས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་པ་ཡིན་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རང་གསོད་ངེས་པའམ་ཡང་ན་ཁོའི་འཆི་བ་སླེབས་འོང་། ཡང་ན་ཁོ་འཐབ་མོར་སོང་སྟེ་འཆི་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ལག་པ་ནི་ཁོང་གིས་བྱུགས་པའི་སྟེང་དུ་རྐྱོང་བ་འགོག་པར་མཛོད་ཅིག ད་ལྟ་ཁྱོད་ཀྱིས་སོ་ལོའི་མགོ་ཡི་ལོགས་སུ་ཡོད་པའི་མདུང་དང་ཆུ་སྣོད་གཉིས་ལོངས་ཤིག་དང་ངེད་གཉིས་འགྲོ་བར་བྱ་སྨྲས་ནས།"]},{"type":"verse","number":12,"content":["དཱ་བིད་ཀྱིས་སོ་ལོའི་མགོ་ཡི་ལོགས་ནས་མདུང་དང་ཆུ་སྣོད་བླངས་ཏེ་སོང་། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལ་གཉིད་ལྕི་མོ་ཞིག་ཕབ་པས་མི་སུས་ཀྱང་བྱ་བ་དེ་མ་མཐོང་། མི་སུས་ཀྱང་མ་ཤེས། མི་སུ་ཡང་གཉིད་ལས་མ་སད་པར། ཐམས་ཅད་གཉིད་ནས་བསྡད་དོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་དཱ་བིད་ཕྱོགས་གཞན་ཞིག་ཏུ་སོང་སྟེ། རྒྱང་རིང་དུ་ཡོད་པའི་རི་ཞིག་གི་རྩེ་མོར་འགོས་ཤིང་དེ་དག་གི་བར་ཐག་ཤིན་ཏུ་རིང་བ་ཡིན།"]},{"type":"verse","number":14,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་དམག་དཔུང་དང་ནེར་གྱི་བུ་ཨབ་ནེར་གཉིས་ཀ་བོས་ནས་འདི་ལྟར། ཀྱེ་ཨབ་ནེར་ཁྱེད་ཀྱིས་ལན་མི་འདེབས་པ་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པ་ན། ཨབ་ནེར་གྱིས་ལན་དུ། རྒྱལ་པོ་འབོད་མཁན་ཁྱོད་སུ་ཡིན་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":15,"content":["དཱ་བིད་ཀྱིས་ཨབ་ནེར་ལ། ཁྱེད་ནི་དཔའ་རྒོད་མ་ཡིན་ནམ། ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་ཁྱེད་དང་འདྲ་བ་སུ་ཡོད། འབངས་རྣམས་ཁྲོད་ནས་མི་ཞིག་ཁྱེད་ཀྱི་ཇོ་བོ་སྟེ་རྒྱལ་པོ་གསོད་དུ་འོངས། རྒྱལ་པོ་སྟེ་ཁྱེད་ཀྱི་ཇོ་བོ་ནི་ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་མ་བསྲུངས་པ་ཡིན།"]},{"type":"verse","number":16,"content":["ཁྱེད་ཀྱིས་བྱས་པའི་བྱ་བ་དེ་ནི་བཟང་པོ་མིན་ལ། གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་འདི་ལྟར་སྨྲའོ། །དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པའི་ཁྱེད་ཅག་གི་ཇོ་བོ་དེ་མ་བསྲུངས་པས། ཁྱེད་ཅག་འཆི་འོས་པ་ཡིན། ཡང་རྒྱལ་པོའི་མདུང་དང་མགོའི་ལོགས་སུ་ཡོད་པའི་ཆུ་སྣོད་གང་དུ་ཡོད་པར་ལྟོས་ཤིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["སོ་ལོས་དཱ་བིད་ཀྱི་སྐད་ཤེས་ཏེ། ཀྱེ་ངའི་བུ་དཱ་བིད། འདི་ཁྱོད་ཀྱི་སྐད་ཡིན་ནམ་ཞེས་དྲིས་ནས། དཱ་བིད་ཀྱིས་ཀྱེ་རྒྱལ་པོ་བདག་གི་ཇོ་བོ་ལགས། འདི་ངའི་སྐད་ཡིན་ཏེ།"]},{"type":"verse","number":18,"content":["ཇོ་བོ་ཁྱེད་ཀྱིས་རང་གི་ཞབས་ཕྱི་བདག་ཅིའི་ཕྱིར་འདེད་དམ། བདག་གིས་ཅི་བྱས་སམ། བདག་གི་ལག་ནས་བྱ་བ་ངན་པ་ཅི་ཞིག་བྱུང་ངམ།"]},{"type":"verse","number":19,"content":["ཀྱེ་རྒྱལ་པོ་བདག་གི་ཇོ་བོ་ལགས། ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་གི་གཏམ་ལ་གསན་རོགས། གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ལ་ངར་བསླངས་ནས་བདག་ལ་རྒོལ་དུ་བཅུག་པ་ཡིན་ན། ཁོང་ལ་དགྱེས་པའི་མཆོད་པར་གྱུར་ཅིག གལ་ཏེ་མིའི་བུ་རྣམས་ཀྱིས་རྒོལ་དུ་བཅུག་པ་ཡིན་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དེ་དག་ལ་དམོད་མོ་ཐེབས་པར་གྱུར་ཅིག དེ་རིང་ཉིན་མོར་བདག་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ནོར་སྐལ་མི་འཐོབ་པའི་ཆེད་དུ། དེ་དག་གིས་བདག་ལ་ད་སོང་ནས་ལྷ་གཞན་ལ་ཕྱག་ཕུལ་ཞིག་ཟེར།"]},{"type":"verse","number":20,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེ་དང་རྒྱང་ཐག་རིང་སར་བདག་གི་ཁྲག་སར་བཞུར་དུ་མི་འཇུག་རོགས། སུ་ཞིག་རི་ལ་བྱ་སྲེག་པ་བརྔོན་དུ་འོངས་པ་ལྟར། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ནི་ཁྱི་ཤིག་བཙལ་དུ་འོངས་པ་རེད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":21,"content":["སོ་ལོས་ངས་སྡིག་པ་བྱས་པ་ཡིན། ཀྱེ་ངའི་བུ་དཱ་བིད་དེ་རིང་ཁྱོད་ཀྱིས་ངའི་ཚེ་སྲོག་རིན་ཐང་ཅན་དུ་བརྩིས་པས། ངས་ཁྱོད་ལ་ཡང་བསྐྱར་གནོད་པར་མི་བྱ། ང་སྨྱོས་ནས་ཤིན་ཏུ་ནོར་བ་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":22,"content":["དཱ་བིད་ཀྱིས་ལན་དུ། ཀྱེ། འཁོར་གཡོག་རྣམས་ལས་གཅིག་འདི་རུ་མངགས་ཏེ་རྒྱལ་པོའི་མདུང་ཕྱིར་ཁྱེར་ཅིག"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དྲང་པོ་དང་ཟོལ་མེད་ཡིན་པ་དེར་ལན་གནང་བ་ཡིན་ཞིང་དེ་རིང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ངའི་ལག་ཏུ་སྤྲོད་པར་མཛད་ཀྱང་། བདག་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པའི་སྟེང་དུ་རང་གི་ལག་པ་རྐྱོང་བར་མ་དགའོ། །"]},{"type":"verse","number":24,"content":["ཡང་གཟིགས་དང་། དེ་རིང་ཉིན་མོར་ཁྱེད་ཀྱི་སྲོག་ངའི་མིག་མདུན་དུ་ཇི་ལྟར་རིན་ཐང་ཅན་ཡིན་པ་བཞིན། བདག་གི་སྲོག་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་དྲུང་དུ་རིན་ཐང་ཅན་དུ་འགྱུར་བར་མ་ཟད་ཁོང་གིས་བདག་སྡུག་བསྔལ་ཐམས་ཅད་ལས་སྐྱོབ་པར་མཛོད་ཅིག་ཅེས་ཞུས་པས།"]},{"type":"verse","number":25,"content":["སོ་ལོས་དཱ་བིད་ལ། ཀྱེ་ངའི་བུ་དཱ་བིད་ཁྱོད་བདེ་བར་གྱུར་ཅིག ཁྱོད་ཀྱིས་ངོ་མཚར་ཆེ་བའི་ལས་བསྒྲུབ་པར་བྱའོ། །ཅིས་ཀྱང་རྒྱལ་བར་འགྱུར་ཞེས་སྨྲས་ནས་དཱ་བིད་རང་གི་ལམ་ལ་ཞུགས་པ་དང་སོ་ལོ་རང་གི་གནས་སུ་ཕྱིར་ལོག་གོ །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/25.json","previousChapterAudioLinks":{},"numberOfVerses":25}