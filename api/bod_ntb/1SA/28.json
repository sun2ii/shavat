{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":28,"content":[{"type":"heading","content":["སོ་ལོ་བུད་མེད་གཤིན་པོ་འགུག་མཁན་ཞིག་ལ་བལྟ་རུ་ཕྱིན་པ།"]},{"type":"verse","number":1,"content":["སྐབས་དེར། ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་དང་དམག་རྒྱག་པའི་ཕྱིར་དམག་ཚོགས་བསྡུ་བའི་ཚེ། ཨ་ཀི་སི་ཡིས་དཱ་བིད་ལ། ཁྱོད་དང་ཁྱོད་ཀྱི་མི་རྣམས་ང་དང་ལྷན་ཅིག་དམག་ཏུ་འགྲོ་དགོས་པ་ངེས་པར་ཤེས་དགོས་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":2,"content":["དཱ་བིད་ཀྱིས་ཨ་ཀི་སི་ལ། དེ་ནས་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡིས་ཅི་བྱེད་ནུས་པ་ཁྱེད་ཀྱིས་མཁྱེན་པར་འགྱུར་ཞེས་ཞུས་ཤིང་། ཨ་ཀི་སི་ཡིས་དཱ་བིད་ལ། དེའི་ཕྱིར་ཁྱོད་རང་རྒྱུན་དུ་ངའི་སྐུ་སྲུང་པར་བསྐོ་བ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":3,"content":["སྔར་སཱ་མུ་ཨེལ་ཚེ་ལས་འདས་པའི་སྐབས་སུ། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ཁོང་གི་ཕྱིར་མྱ་ངན་བྱས་ནས། ཁོང་གི་སྐུ་གདུང་ཁོང་ཉིད་ཀྱི་གྲོང་ཁྱེར་རཱ་མ་ཡུལ་དུ་དུར་ལ་བཅུག སོ་ལོས་གཤིན་པོ་འགུག་མཁན་དང་རྫུ་འཕྲུལ་ཅན་དག་ཡུལ་ནས་བཏོན་ཚར་བ་ཡིན།"]},{"type":"verse","number":4,"content":["ད་ལྟ་ཕེ་ལེ་ཤེད་པ་རྣམས་འཛོམས་ནས་ཤུ་ནེམ་དུ་འོངས་ཏེ་སྒར་བཏབ། ཡང་སོ་ལོས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་བསྡུས་ནས་གིལ་བོ་ཨ་རུ་སྒར་བཏབ་པ་རེད།"]},{"type":"verse","number":5,"content":["སོ་ལོས་ཕེ་ལེ་ཤེད་པའི་དམག་དཔུང་མཐོང་བས་སྙིང་འདར་ཞིང་འགུལ།"]},{"type":"verse","number":6,"content":["སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ཀྱང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་རྨི་ལམ་མམ་ཨུའུ་རིམ་ཞེས་པའི་བརྟག་རིལ་ལམ། ལུང་སྟོན་པ་བཅས་གསུམ་གྱི་སྒོ་ནས་བཀའ་ལན་གང་ཡང་མ་གནང་ངོ་། །"]},{"type":"verse","number":7,"content":["དེའི་ཕྱིར་སོ་ལོས་རང་གི་བློན་འཁོར་རྣམས་ལ། ངའི་དོན་དུ་གཤིན་པོ་འགུག་པའི་བུད་མེད་ཅིག་ཚོལ་ཞིག ང་དེའི་མདུན་དུ་སོང་ནས་འདྲི་བར་བྱའོ་ཞེས་སྨྲས་པར། བློན་འཁོར་རྣམས་ཀྱིས། ལྟོས་དང་གཤིན་པོ་འགུག་པའི་བུད་མེད་ཅིག་ཨེན་དོར་གྲོང་ཁྱེར་དུ་གནས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["སོ་ལོས་ཆས་གོས་བསྒྱུར་ཏེ་གྱོན་པ་གཞན་ཞིག་གྱོན་ནས་ཁོང་དང་མི་གཉིས་མཉམ་དུ་སོང་སྟེ། མཚན་ལ་བུད་མེད་དེའི་མདུན་དུ་སླེབས་ནས། སོ་ལོས། ཀྱེ། གཤིན་པོ་སུ་ཞིག་གི་མིང་ངས་གླེང་ན། དེ་ངའི་ཆེད་དུ་ཡར་དྲོངས་ཤིག་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":9,"content":["བུད་མེད་དེས་ལན་དུ། ལྟོས་ཤིག སོ་ལོས་གཤིན་པོ་འགུག་མཁན་དང་རྫུ་འཕྲུལ་ཅན་རྣམས་ཡུལ་ནས་ཅི་ལྟར་བཏོན་པ་དེ་ནི་ཁྱོད་ཀྱིས་ཤེས་པ་ཡིན། ང་རང་གསོད་པར་རྒྱ་རྙི་ཅིའི་ཕྱིར་འཛུག་གམ་ཞེས་དྲིས་པས།"]},{"type":"verse","number":10,"content":["སོ་ལོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་སྒོ་ནས་མནའ་བསྐྱལ་ཞིང་། གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་པ་ཡིན་ཏེ། བྱ་བ་འདིའི་ཕྱིར་ཁྱོད་ལ་ཆད་པ་མི་གཅོད་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":11,"content":["བུད་མེད་དེས། ངས་ཁྱོད་ཀྱི་ཕྱིར་སུ་ཡར་འགུག་པར་བྱའམ་ཞེས་སྨྲས་པར། སོ་ལོས། སཱ་མུ་ཨེལ་ཡར་དྲོངས་ཤིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་བུད་མེད་ཀྱིས་སཱ་མུ་ཨེལ་མཐོང་བས་སྐད་ཆེན་པོས་བོས་ཤིང་། བུད་མེད་ཀྱིས་སོ་ལོ་ལ། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་ང་རང་བསླུ་བར་བྱེད་དམ། ཁྱེད་ནི་སོ་ལོ་རེད་ཅེས་སྨྲས།"]},{"type":"verse","number":13,"content":["དེ་ནས་རྒྱལ་པོ་ན་རེ། མ་འཇིགས་ཤིག ཁྱོད་ཀྱིས་ཅི་མཐོང་ཞེས་དྲིས་པ་དང་། བུད་མེད་ཀྱིས་སོ་ལོ་ལ། ངས་ནི་ལྷ་ཞིག་ས་གཞི་ནས་ཡར་འོང་བ་མཐོང་བྱུང་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":14,"content":["རྒྱལ་པོས་ཁོ་མོར། དེའི་གཟུགས་དབྱིབས་ཇི་ལྟ་བུ་ཞིག་འདུག་ཅེས་དྲིས་པ་དང་། བུད་མེད་ཀྱིས། རྒད་པོ་གོས་རིང་གྱོན་པ་ཞིག་འདུག་ཅེས་སྨྲས་པས། སོ་ལོས་དེ་ནི་སཱ་མུ་ཨེལ་ཡིན་པ་ཤེས་ཏེ། ལུས་པོ་བསྒུར་ནས་གདོང་ས་ལ་བཏུད་དེ་ཕྱག་བཙལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ། ཁྱོད་ཀྱིས་ང་ཡར་བཀུག་ནས་མི་བདེ་བར་བྱེད་དོན་ཅི་ཞེས་དྲིས་པར། སོ་ལོས། ང་ལ་དཀའ་ལས་ཁག་པོ་ཡོད། ཕེ་ལེ་ཤེད་པས་ང་ལ་དམག་འདྲེན་ཞིང་། དཀོན་མཆོག་ང་དང་བྲལ། ལུང་སྟོན་པ་དང་རྨི་ལམ་གྱི་སྒོ་ནས་ཁོང་གིས་ང་ལ་བཀའ་ལན་གང་ཡང་མ་གནང་བས། ཁྱེད་ཀྱིས་ང་ལ་ཅི་བྱེད་རུང་བ་སྟོན་པའི་ཕྱིར་ངས་ཁྱེད་བོས་པ་ཡིན་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་དང་བྲལ་ནས་ཁྱོད་ཀྱི་དགྲ་བོར་གྱུར་ཡོད་ན། ཁྱོད་ཀྱིས་ང་ལ་འདྲི་དགོས་དོན་ཅི་ཡོད།"]},{"type":"verse","number":17,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ཁ་བརྒྱུད་ནས་ཇི་ལྟར་སྨྲས་པ་བཞིན་བསྒྲུབས་པ་སྟེ། ཁོང་གིས་ཁྱོད་ཀྱི་ལག་ནས་རྒྱལ་སྲིད་བླངས་ཏེ་ཁྱོད་ཀྱི་ཁྱིམ་མཚེས་དཱ་བིད་ལ་གནང་བ་ཡིན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མ་མཉན་ཏེ། ཨ་མཱད་ལེག་པའི་མི་རིགས་ལ་ཁོང་ཁྲོ་སྟོན་པའི་བཀའ་ལྟར་མ་བསྒྲུབས་པས། དེ་རིང་ཉིན་མོར་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་དོན་འདི་ཐམས་ཅད་མཛད་དོ། །"]},{"type":"verse","number":19,"content":["དེར་མ་ཟད། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཕེ་ལེ་ཤེད་པའི་ལག་ཏུ་སྤྲོད་པར་འགྱུར་ཞིང་། སང་ཉིན་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྣམས་ང་དང་མཉམ་དུ་གནས་པར་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་དམག་དཔུང་ཕེ་ལེ་ཤེད་པའི་ལག་ཏུ་སྤྲོད་པར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":20,"content":["སོ་ལོ་གློ་བུར་ཉིད་ལ་ལུས་ཧྲིལ་པོ་སར་འགྱེལ་བ་སྟེ། རྒྱུ་མཚན་ནི་ཁོ་རང་སཱ་མུ་ཨེལ་གྱི་སྐད་ཆར་ཤིན་ཏུ་འཇིགས་པ་དང་། ཉིན་གང་དང་མཚན་གང་ལ་ཅི་ཡང་མ་ཟོས་པས་སྟོབས་ཟད་པར་གྱུར་པ་རེད།"]},{"type":"verse","number":21,"content":["དེ་ནས་བུད་མེད་དེ་སོ་ལོའི་དྲུང་དུ་འོངས་པ་ན། ཁོ་ཤིན་ཏུ་འཇིགས་པ་མཐོང་བས། བུད་མེད་ཀྱིས། ལྟོས་དང་ཁྱེད་ཀྱི་གཡོག་མོས་ཉིད་ཀྱི་བཀའ་ལ་མཉན་ཏེ་རང་གི་སྲོག་ལའང་མ་འཛེམ་པ་ཡིན།"]},{"type":"verse","number":22,"content":["ད་ལྟ་ཁྱེད་ཀྱིས་ཀྱང་ཉིད་ཀྱི་གཡོག་མོའི་གཏམ་ལ་གསན་པར་མཛོད། ངས་ཁྱེད་ཀྱི་སྐུ་མདུན་དུ་བག་ལེབ་དུམ་བུ་ཞིག་འཇོག་པར་གནང་རོགས། རྗེས་སུ་ལམ་དུ་ཞུགས་པའི་ཚེ། ཁྱེད་ལ་སྟོབས་ཤུགས་ཡོད་པའི་ཕྱིར་ད་ལྟ་བཞེས་རོགས་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":23,"content":["ཁོས་མི་འཐད་པའི་ཚུལ་གྱིས་བཟའ་བར་མི་བྱ་ཞེས་སྨྲས། འཁོར་གཡོག་རྣམས་ཀྱིས་བུད་མེད་དང་མཉམ་དུ་ཁོ་ལ་བསྐུལ་མ་བྱས། དེ་ནས་ཁོས་དེ་དག་གི་གཏམ་ལ་མཉན་ཏེ་ལངས་ནས་ཉལ་ཁྲི་སྟེང་དུ་བསྡད།"]},{"type":"verse","number":24,"content":["བུད་མེད་དེ་ལ་ཁྱིམ་དུ་བ་ཕྲུག་ཤ་ཤེད་ཅན་ཞིག་ཡོད་པ་མྱུར་དུ་བཤས་ནས་བག་ཕྱེ་བླངས་ཏེ་བརྫིས་ནས་སྐྱུར་མེད་བག་ལེབ་བསྲེགས་ཤིང་།"]},{"type":"verse","number":25,"content":["དེ་ནི་སོ་ལོ་དང་ཁོའི་འཁོར་གཡོག་གི་མདུན་དུ་ཁྱེར་འོངས་པ་དང་། དེ་དག་གིས་ཁ་ཟས་སྤྱད་ནས་ལངས་ཏེ་མཚན་མོ་དེ་ལ་སོང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/27.json","previousChapterAudioLinks":{},"numberOfVerses":25}