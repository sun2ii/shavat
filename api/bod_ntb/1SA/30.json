{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":30,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཨ་མཱད་ལེག་པ་བསྣུབས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཉིན་གསུམ་པར་དཱ་བིད་དང་ཁོའི་མི་རྣམས་ཙིག་ལག་གྲོང་ཁྱེར་དུ་སླེབས་ཤིང་། སྔོན་ཆད་ཨ་མཱད་ལེག་པ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་ཡུལ་གྱི་ནེ་གུབ་དང་ཙིག་ལག་ཏུ་དམག་དྲངས་ནས། ཙིག་ལག་གཏོར་ནས་མེ་ལ་བསྲེགས་ཤིང་།"]},{"type":"verse","number":2,"content":["གྲོང་ཁྱེར་དེ་རུ་གནས་པའི་བུད་མེད་ཐམས་ཅད་བཟུང་ནས། ཆེ་ཆུང་གཅིག་ཀྱང་མ་བསད་པར་བཟུང་ཞིང་ཁྲིད་ནས་ལམ་དུ་ཞུགས་པ་རེད།"]},{"type":"verse","number":3,"content":["དཱ་བིད་དང་དེའི་མི་རྣམས་གྲོང་ཁྱེར་དེར་སླེབས་པའི་སྐབས་སུ། ཀྱེ་ཧོ། གྲོང་ཁྱེར་མེ་ལ་བསྲེགས་ཏེ། དེ་དག་གི་བུད་མེད་རྣམས་དང་། བུ་རྣམས་དང་། བུ་མོ་རྣམས་བཟུང་ནས་བཙོན་དུ་ཁྱེར་བ་མཐོང་ནས།"]},{"type":"verse","number":4,"content":["དཱ་བིད་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་ཀྱིས་སྐད་ཆེན་པོ་བཏོན་ནས་སྟོབས་ཟད་པའི་བར་དུ་ངུས།"]},{"type":"verse","number":5,"content":["ཡང་དཱ་བིད་ཀྱི་ཆུང་མ་སྟེ། ཡེ་སི་རེ་ཨེལ་གྱི་ཨ་ཧི་ནོ་ཨམ་དང་། སྔར་ཀར་མེལ་པ་ནཱ་རྦལ་གྱི་ཆུང་མ་ཡིན་པའི་ཨ་བི་གཱ་ཡིལ་གཉིས་ཀྱང་བཙོན་དུ་བཟུང་སྟེ་ཁྱེར།"]},{"type":"verse","number":6,"content":["མི་དེ་དག་གིས་དཱ་བིད་རྡོ་རུབ་གཏོང་བའི་གཏམ་བྱེད་པས་དཱ་བིད་ཤིན་ཏུ་འཇིགས་ཤིང་། མི་ཐམས་ཅད་ཀྱིས་རང་རང་གི་བུ་དང་བུ་མོའི་ཕྱིར་སེམས་སྡུག་བྱས་ཀྱང་། དཱ་བིད་ཀྱིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེར་བརྟེན་ནས་སྤོབས་པ་བསྐྱེད་དོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཨ་ཧི་མེ་ལེག་གི་བུ་སྟེ་མཆོད་དཔོན་ཨབ་ཡཱ་ཐར་ལ། འདིར་ང་ལ་བེར་ཐུལ་ཁྱེར་ཤོག་ཅེས་ཟེར་བས། ཨབ་ཡཱ་ཐར་གྱིས་དཱ་བིད་ལ་བེར་ཐུལ་ཁུར་འོངས་ནས།"]},{"type":"verse","number":8,"content":["དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ནས་ཁོང་ལ། བདག་ནི་དམག་དཔུང་འདིའི་ར་མདར་བརྒྱུགས་ན་རྗེས་ཆོད་པར་འགྱུར་རམ་ཞེས་ཞུས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ལན་དུ། ཐེད་ཅིག ཁྱོད་ཀྱིས་དེ་དག་གི་རྗེས་ཆོད་དེ་ཐམས་ཅད་སྐྱོབ་པར་འགྱུར་ཞེས་གསུངས་པས།"]},{"type":"verse","number":9,"content":["དཱ་བིད་དང་ཁོ་དང་མཉམ་དུ་ཡོད་པའི་མི་དྲུག་བརྒྱ་ཕྱིན་པ་དང་། བེ་སོར་ཞེས་པའི་གྲོག་མོར་སླེབས་ཤིང་དེར་མི་འགའ་ཞིག་རྒྱབ་ཏུ་ལུས།"]},{"type":"verse","number":10,"content":["མི་ཉིས་བརྒྱ་ཤིན་ཏུ་ངལ་ནས་བེ་སོར་གྲོག་མོ་བརྒལ་མ་ནུས་པས་རྒྱབ་ཏུ་ལུས་ཤིང་། དཱ་བིད་དང་མི་བཞི་བརྒྱ་བཅས་ར་མདར་ཕྱིན་ཏོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་ཐང་དུ་ཨེ་ཅིབ་པ་ཞིག་དང་ཕྲད་པས་དཱ་བིད་ཀྱི་དྲུང་དུ་ཁྲིད་ཅིང་། མི་དེ་ལ་བག་ལེབ་བཏང་ནས་ཟོས་ཏེ་ཆུ་ཡང་འཐུང་བར་སྤྲད་པ་རེད།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཁོ་ལ་སེ་ཡབ་ལེབ་མོ་ཞིག་དང་། རྒུན་འབྲུམ་སྐམ་པོ་ལེབ་མོ་གཉིས་བཏང་ནས་དེ་ཟོས་པ་ན། ཁོ་ལ་ཡང་བསྐྱར་སྟོབས་ཤུགས་རྒྱས་པ་སྟེ། མི་དེས་ཉིན་ཞག་གསུམ་ལ་ཁ་ཟས་མ་སྤྱད་ཆུ་ཡང་མ་འཐུང་བ་ཡིན།"]},{"type":"verse","number":13,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཁོ་ལ། ཁྱོད་སུའི་མི་ཡིན། གང་ནས་འོངས་ཞེས་དྲིས་པར། མི་དེས། ང་ཨེ་ཅིབ་ཡུལ་གྱི་གཞོན་ནུ་ཡིན་པ་དང་། ཨ་མཱད་ལེག་པ་ཞིག་གི་གཡོག་པོ་ཡིན་ཏེ། ཞག་གསུམ་གྱི་སྔོན་དུ་ང་ན་བས་བདག་པོས་ང་སྤངས་སོ། །"]},{"type":"verse","number":14,"content":["ང་ཚོས་ཀེ་རེད་པའི་ནེ་གུབ་དང་ཡ་ཧུ་དཱ་ཡུལ་ལ་གཏོགས་པ་དང་། ཀཱ་ལེབ་ཡུལ་གྱི་ནེ་གུབ་ཏུ་དམག་བརྒྱབ་ནས་ཙིག་ལག་མེ་ལ་བསྲེགས་པ་ཡིན་ཞེས་ཞུས་པར།"]},{"type":"verse","number":15,"content":["དཱ་བིད་ཀྱིས་ཁོ་ལ། ཁྱོད་ཀྱིས་ང་རང་དམག་དཔུང་དེའི་རྩར་འཁྲིད་པར་བྱའམ་ཞེས་དྲིས་ཤིང་། མི་དེས། ཁྱེད་ཀྱིས་དཀོན་མཆོག་དཔང་དུ་བཙུགས་ནས་བདག་མི་གསོད་པ་དང་། ངའི་བདག་པོའི་ལག་ཏུ་མི་གཏོང་བའི་མནའ་བཞེས་ཤིག དེ་ལྟར་བྱས་ན་བདག་གིས་ཁྱེད་དམག་དཔུང་དེའི་མདུན་དུ་འཁྲིད་པར་བྱ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["མི་དེས་དཱ་བིད་མར་ཁྲིད་ནས། ཀྱེ་ཧོ། ཨ་མཱད་ལེག་པ་དེ་དག་ཡུལ་ཐམས་ཅད་དུ་ཐོར་ནས་བཟའ་བཏུང་ལོངས་སུ་སྤྱོད་ཅིང་གར་འཆམ་བཞིན་འདུག་གོ །གང་ལ་ཞེ་ན། དེ་དག་གིས་ཕེ་ལེ་ཤེད་དང་ཡ་ཧུ་དཱ་ཡུལ་གཉིས་ནས་བཅོམ་ནོར་ཆེན་པོ་ཁྱེར་བས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཐོ་རངས་ནས་བཟུང་ཕྱི་ཉིན་མཚན་མོའི་བར་དུ་དེ་དག་དང་འཐབ་འཛིང་བྱས་ཤིང་། རྔ་མོང་ལ་ཞོན་ཏེ་བྲོས་པའི་གཞོན་ནུ་བཞི་བརྒྱ་མ་གཏོགས་དེ་དག་ལས་གཅིག་ཀྱང་མ་ཐར་རོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཨ་མཱད་ལེག་པ་རྣམས་ཀྱིས་ཁྱེར་བ་ཐམས་ཅད་དཱ་བིད་ཀྱིས་ཕྱིར་བླངས་ཏེ། དཱ་བིད་ཀྱིས་རང་གི་ཆུང་མ་གཉིས་ཀྱང་བསྐྱབས་པ་རེད།"]},{"type":"verse","number":19,"content":["ཁ་རྒན་གཞོན་དང་། བུ་བུ་མོ་དང་། བཅོམ་ནོར་སོགས་དེ་དག་གིས་ཅི་དང་ཅི་ཁྱེར་བ་ཐམས་ཅད་ཀྱི་ནང་ནས་གང་ཡང་མ་སྟོར་བར། དཱ་བིད་ཀྱིས་ནོར་དེ་ཐམས་ཅད་ཕྱིར་བླངས་པ་དང་།"]},{"type":"verse","number":20,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ར་ལུག་གི་ཁྱུ་དང་བ་ཁྱུ་རྣམས་བླངས་ནས་མི་དེ་དག་གིས་ཁྲིད་དེ་ན་རེ། འདི་ནི་དཱ་བིད་ཀྱི་བཅོམ་ནོར་ཡིན་ཞེས་བརྗོད་དོ། །"]},{"type":"verse","number":21,"content":["ཤིན་ཏུ་ངལ་བས་དཱ་བིད་ཀྱི་རྗེས་སུ་འབྲང་བར་མ་ནུས་པའི་མི་ཉིས་བརྒྱ་སྟེ། བེ་སོར་གྲོག་མོའི་འགྲམ་དུ་ལུས་པ་དེ་དག་གི་མདུན་དུ་སླེབས་ཤིང་། དེ་དག་ནི་དཱ་བིད་དང་ཁོང་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་བསུ་བར་འོངས། དཱ་བིད་དེ་དག་དང་ཉེ་བར་སླེབས་པ་དང་ཁམས་འདྲི་བྱས།"]},{"type":"verse","number":22,"content":["དེ་ནས་དཱ་བིད་དང་མཉམ་དུ་ཕྱིན་པའི་མི་ངན་རྣམས་ཀྱིས། མི་དེ་དག་ནི་ངེད་ཅག་དང་མཉམ་དུ་མ་ཕྱིན་པས། ངེད་རྣམས་ཀྱིས་ཕྱིར་བླངས་པའི་བཅོམ་ནོར་འདི་ལས་དེ་དག་ལ་ཅི་ཡང་གཏོང་བར་མི་བྱ། དེ་དག་གིས་རང་གི་ཆུང་མ་དང་ཕྲུ་གུ་རྣམས་ཁྲིད་ནས་ཕར་སོང་ཆོག་ཅེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":23,"content":["དཱ་བིད་ཀྱིས། ངའི་སྤུན་ཟླ་རྣམས། དེ་ལྟར་མ་བྱེད་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་ལ་འདི་ཐམས་ཅད་གནང་སྟེ་རང་ཅག་སྲུང་བར་མཛད་ཅིང་། རང་ཅག་གི་སྟེང་དུ་བྱུང་བའི་དམག་དཔུང་འདི་རང་རེའི་ལག་ཏུ་སྤྲད་པས།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཅག་གི་གཏམ་ལ་སུས་མཉན་པར་བྱ། དམག་ཏུ་འགྲོ་མཁན་གྱི་ཐོབ་སྐལ་དང་འདྲ་བར་དམག་ཆས་སྲུང་མཁན་རྣམས་ལའང་སྐལ་ཡོད་པར་འགྱུར། ཐམས་ཅད་ལ་སྐལ་འདྲ་བར་འཐོབ་འོང་ཞེས་སྨྲས།"]},{"type":"verse","number":25,"content":["ཡང་ཉིན་དེ་ནས་བཟུང་དེ་རིང་གི་བར་དུ་ཁོས་དེ་ནི་ཡེས་ར་ཨེལ་གྱི་ཁྲིམས་དང་ལུགས་སྲོལ་དུ་བཙུགས་སོ། །"]},{"type":"verse","number":26,"content":["ཡང་དཱ་བིད་ཙིག་ལག་ཏུ་སླེབས་པ་དང་། བཅོམ་ནོར་གྱི་ཁག་ཅིག་རང་གི་གྲོགས་པོ་ཡིན་པའི་ཡ་ཧུ་དཱ་པའི་རྒན་པོ་རྣམས་ལ་བཏང་ནས་ན་རེ། ལྟོས་དང་། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དགྲ་བོ་ནས་བླངས་པའི་བཅོམ་ནོར་ཏེ། ཁྱེད་ལ་ཕུལ་བའི་ཕྱག་རྟགས་ཡིན་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":27,"content":["ཕྱག་རྟགས་དེ་ནི་པེད་ཨེལ་དང་། ནེ་གུབ་ཡུལ་གྱི་རཱ་མོད་དང་། ཡད་ཏིར་དང་།"]},{"type":"verse","number":28,"content":["ཨ་རོ་ཨེར་དང་། སིབ་མོད་དང་། ཨེ་སི་ཏེ་མོ་ཨ་དང་།"]},{"type":"verse","number":29,"content":["ར་ཀལ་དང་། ཡིར་ཧིམ་ཨེལ་པའི་གྲོང་ཁྱེར་རྣམས་དང་། ཀེ་ནེ་པའི་གྲོང་ཁྱེར་རྣམས་དང་།"]},{"type":"verse","number":30,"content":["ཧོར་མཱ་དང་། པོར་ཨ་སན་དང་། ཨ་ཐག་དང་།"]},{"type":"verse","number":31,"content":["ཧེབ་རོན་དང་། སྔར་དཱ་བིད་དང་དེའི་མི་རྣམས་སོང་བའི་གནས་ཐམས་ཅད་དུ་ཕུལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}