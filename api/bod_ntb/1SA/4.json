{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":4,"content":[{"type":"heading","content":["ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཕྲོགས་པ།"]},{"type":"verse","number":1,"content":["སཱ་མུ་ཨེལ་གྱིས་རང་གི་བཀའ་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཀུན་ལ་ཁྱབ་པར་མཛད་ཅིང་། ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་དམག་འཐབ་ཏུ་ཆས་ནས། ཨེ་བེན་ཨེ་ཟིར་ཞེས་པའི་ས་ཆ་རུ་གུར་ཕུབ་པ་དང་། ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཨ་ཕེག་ཏུ་གུར་ཕུབ་པ་རེད།"]},{"type":"verse","number":2,"content":["ཡང་དེ་དག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དམག་རྒྱག་པའི་ཕྱིར་རུ་བསྒྲིགས་ནས་དམག་བརྒྱབ་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཕེ་ལེ་ཤེད་པའི་མདུན་དུ་ཕམ་ཞིང་། དེའི་དམག་དཔུང་ནས་མི་བཞི་སྟོང་ཙམ་གཡུལ་ས་རུ་བསད།"]},{"type":"verse","number":3,"content":["དེ་ནས་འབངས་མི་ཐམས་ཅད་དམག་སྒར་ནང་དུ་སླེབས་ཙ་ན། ཡེས་ར་ཨེལ་པའི་རྒན་པོ་རྣམས་ན་རེ། དེ་རིང་དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་རྣམས་ཕེ་ལེ་ཤེད་པའི་མདུན་དུ་ཅིའི་ཕྱིར་ཕམ་པར་མཛད་དམ། ཞི་ལོ་གྲོང་ཁྱེར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དེ་ལེན་དུ་སོང་ཞིག་དང་། ཁོང་ནི་ངེད་རྣམས་ཀྱི་ཁྲོད་དུ་བཞུགས་པ་ཡིན་ཚེ། ངེད་རྣམས་དགྲ་བོའི་ལག་ནས་ཐར་བར་འགྱུར་ཞེས་སྨྲས།"]},{"type":"verse","number":4,"content":["དེའི་ཕྱིར་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཀེ་རུབ་ཀྱི་གོང་དུ་བཞུགས་པའི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཞི་ལོ་ནས་ལེན་པའི་ཕྱིར་མི་འགའ་ཞིག་མངགས། སྐབས་དེར་ཨེ་ལིའི་བུ་ཧོ་ཕེ་ནིས་དང་ཕེ་ནེ་ཧཱ་གཉིས་ནི་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་ལྷན་དུ་ཡོད་དོ། །"]},{"type":"verse","number":5,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དམག་སྒར་དུ་སླེབས་པ་ཙམ་གྱིས། ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཀྱིས་ས་གཞི་གཡོ་བའི་འབོད་སྒྲ་ཆེན་པོ་བསྒྲགས།"]},{"type":"verse","number":6,"content":["ཡང་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་འུར་སྒྲ་དེ་ཐོས་པས། ཨིབ་རི་པའི་དམག་སྒར་ནང་དུ་འུར་སྒྲ་ཆེན་པོ་འབྱུང་དོན་ཅི་ཡིན་ཞེས་དྲིས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཨིབ་རི་པའི་དམག་སྒར་དུ་སླེབས་ཡོད་པ་ཤེས་སོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས་འཇིགས་ཤིང་སྐྲག་པར་གྱུར། གང་ལ་ཞེ་ན། དེ་དག་གིས་དཀོན་མཆོག་ནི་དམག་སྒར་དུ་ཕེབས་པ་ཤེས་པས་སོ། །ཡང་ཁོ་རྣམས་ཀྱིས། ང་ཚོར་ཆག་སྒོ་བྱུང་བ་རེད། དོན་འདི་ལྟ་བུ་སྔོན་ཆད་ནམ་ཡང་མ་བྱུང་ངོ་། །"]},{"type":"verse","number":8,"content":["ང་ཚོར་ཆག་སྒོ་བྱུང་བ་རེད། སུ་ཞིག་གིས་ལྷ་མཐུ་སྟོབས་ཅན་རྣམས་ཀྱི་ལག་ནས་ང་ཚོ་སྒྲོལ་བར་བྱའམ། སྔོན་ཆད་དབེན་སྟོང་དུ་ཨེ་ཅིབ་པ་རྣམས་གནོད་འཚེ་སྣ་ཚོགས་ཀྱིས་ཕམ་པར་བྱེད་མཁན་ནི་ལྷ་འདི་དག་ཡིན།"]},{"type":"verse","number":9,"content":["ང་ཚོ་སྟོབས་ཅན་དུ་གྱུར་ཅིག མི་དཔའ་བོའི་ཚུལ་དུ་གྱུར་ཅིག ཀྱེ་ཕེ་ལེ་ཤེད་པ་རྣམས། སྔར་ཨིབ་རི་པ་རྣམས་ཁྱོད་ཅག་གི་གཡོག་པོ་བྱས་པ་ལྟར། ཁྱོད་ཅག་དེ་དག་གི་གཡོག་པོ་རུ་མི་འགྱུར་བའི་ཕྱིར་སྤོབས་པ་བསྐྱེད་ནས་དམག་རྒྱོབ་ཅིག་ཅེས་བསྐུལ་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་དམག་བརྒྱབ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཕམ་སྟེ། མི་རེ་རེ་རང་གི་གུར་དུ་བྲོས་པ་དང་མི་ཤིན་ཏུ་མང་པོ་བསད་ཅིང་། ཡེས་ར་ཨེལ་གྱི་རྐང་དམག་རྣམས་ལས་མི་ཁྲི་གསུམ་དེར་ཤི་བ་རེད།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཕེ་ལེ་ཤེད་པས་ཕྲོགས་ཤིང་། ཨེ་ལིའི་བུ་ཧོ་ཕེ་ནིས་དང་ཕེ་ནེ་ཧཱ་གཉིས་ཀྱང་བསད་དོ། །"]},{"type":"heading","content":["ཨེ་ལི་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":12,"content":["དེ་ནས་པེན་ཡཱ་མེན་ཚོ་པའི་མི་ཞིག་དམག་དཔུང་ནས་བྲོས་ཏེ་ཐོན་པ་དང་ཉིན་དེར་ཞི་ལོ་གྲོང་ཁྱེར་དུ་སླེབས། མི་དེའི་གོས་ཧྲུལ་ཞིང་མགོ་ལ་ས་རྡུལ་གྱིས་ཁེངས།"]},{"type":"verse","number":13,"content":["མི་དེ་ཞི་ལོ་གྲོང་ཁྱེར་དུ་སླེབས་ཚེ། ཨེ་ལི་ཡིས་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཆེད་དུ་སེམས་ཁུར་བྱས་ཏེ། འདུག་སྟེགས་ཤིག་གི་སྟེང་ལམ་འགྲམ་དུ་བསྒུགས་ནས་བསྡད་པ་ལ། མི་དེ་གྲོང་ཁྱེར་དུ་འོངས་ནས་དོན་ཅི་བྱུང་བ་སྨྲས་པ་ཙམ་གྱིས། གྲོང་ཁྱེར་གྱི་མི་རྣམས་ཀྱིས་མྱ་ངན་གྱི་སྐད་ངན་བཏོན་ནོ། །"]},{"type":"verse","number":14,"content":["ཨེ་ལིས་མྱ་ངན་གྱི་སྐད་དེ་ཐོས་པས། སྐད་ངན་ཆེན་པོ་འདིའི་དོན་ཅི་ཡིན་ཞེས་དྲིས་པ་དང་། མི་དེ་རྒྱུག་འོངས་ནས་དོན་ཐམས་ཅད་ཨེ་ལི་ལ་སྨྲས།"]},{"type":"verse","number":15,"content":["སྐབས་དེར་ཨེ་ལི་དགུང་ལོ་དགུ་བཅུ་གོ་བརྒྱད་ལ་སོན་ཡོད་པ་དང་། མིག་དབང་ཉམས་ནས་མཐོང་མི་ཐུབ་པ་རེད།"]},{"type":"verse","number":16,"content":["མི་དེས་ཨེ་ལི་ལ། ང་ནི་དམག་དཔུང་ནས་འོངས་པ་དང་། དེ་རིང་གཡུལ་ས་ནས་བྲོས་འོངས་པའི་མི་ཞིག་ཡིན་ཞེས་སྨྲས་པས། ཁོས་དེ་ལ། ངའི་བུ། དེ་རུ་ཅི་བྱུང་ངམ་ཞེས་དྲིས་པ་དང་།"]},{"type":"verse","number":17,"content":["སྐད་ཆ་ཁྱེར་འོངས་པའི་མི་དེས་ལན་དུ་ན་རེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཕེ་ལེ་ཤེད་པའི་མདུན་ནས་བྲོས་ཏེ་མི་ཤིན་ཏུ་མང་པོ་ཞིག་བསད་ནས། ཁྱོད་ཀྱི་བུ་ཧོ་ཕེ་ནིས་དང་ཕེ་ནེ་ཧཱ་གཉིས་ཀྱང་ཤི་སྟེ། དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཕྲོགས་སོང་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["མི་དེས་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྲོགས་པའི་གཏམ་སྨྲས་པ་ཙམ་གྱིས། ཨེ་ལི་འདུག་སྟེགས་ནས་གན་རྐྱལ་དུ་སྒོ་འགྲམ་དུ་འགྲིལ་བས་སྐེ་ཚིགས་ལོག་ནས་ཤིའོ། །གང་ལ་ཞེ་ན། ཁོ་ལུས་ལྕི་ཞིང་ལོ་ན་རྒས་པས་སོ། །ཁོས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ལོ་བཞི་བཅུའི་རིང་དུ་ཁྲིམས་དཔོན་བྱས་སོ། །"]},{"type":"verse","number":19,"content":["ཁོའི་མནའ་མ་སྟེ་ཕེ་ནེ་ཧཱའི་ཆུང་མར་མངལ་ཆགས་ཏེ་ཕྲུ་གུ་སྐྱེ་བའི་དུས་ལ་ཉེ། མོས་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྲོགས་པ་དང་། ཁྱོ་ག་དང་གྱོས་པོ་གཉིས་ཤི་བའི་གཏམ་ཐོས་པ་ཙམ་གྱིས། ཟུག་གཟེར་བྱུང་སྟེ་ལུས་པོ་བསྒུར་ནས་ཕྲུ་གུ་སྐྱེས་པ་རེད།"]},{"type":"verse","number":20,"content":["ཡང་ཁོ་མོ་འཆི་ལ་ཉེ་བའི་དུས་སུ། མོ་དང་ཉེ་བར་ཡོད་པའི་བུད་མེད་རྣམས་ཀྱིས། མ་འཇིགས་ཤིག ཁྱོད་ལ་བུ་ཞིག་སྐྱེས་བྱུང་ཞེས་སྨྲས་ཀྱང་། མོས་ལན་གང་ཡང་མ་བཏབ་སྟེ། གཏམ་དེ་ལ་དོ་སྣང་མ་བྱས་སོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཁོ་མོ་ན་རེ། གཟི་བརྗིད་ཐམས་ཅད་ཡེས་ར་ཨེལ་དང་བྲལ་བ་རེད་ཅེས་སྨྲས་ནས། ཕྲུ་གུ་དེའི་མིང་ལ་ཨི་ཁ་རྦོད་",{"noteId":0},"ཅེས་བཏགས། གང་ལ་ཞེ་ན། དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྲོགས་པ་དང་། ཁྱོ་ག་དང་གྱོས་པོ་གཉིས་ཤི་བས་སོ། །"]},{"type":"verse","number":22,"content":["ཡང་ཁོ་མོས། དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྲོགས་པའི་ཕྱིར། གཟི་བརྗིད་ཡེས་ར་ཨེལ་པ་རྣམས་དང་བྲལ་བ་ཡིན་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ཨི་ཁ་རྦོད་ཅེས་པ་ནི་གཟི་བརྗིད་མེད་པའི་དོན་ཡིན།","reference":{"chapter":4,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/1SA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}