{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":6,"content":[{"type":"heading","content":["ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྱིར་བསྐྱལ་ནས་དགོངས་དག་ཞུས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཟླ་བདུན་གྱི་རིང་ལ་ཕེ་ལེ་ཤེད་པའི་ཡུལ་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":2,"content":["ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་མཆོད་དཔོན་དང་མོ་པ་དག་བོས་ནས་ཁོ་ཚོ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ལ་ངེད་རྣམས་ཀྱིས་ཅི་ཞིག་བྱ། རང་གནས་སུ་ཇི་ལྟར་བསྐྱལ་བ་སྟོན་རོགས་ཞེས་སྨྲས།"]},{"type":"verse","number":3,"content":["ཡང་མཆོད་དཔོན་དང་མོ་པ་དག་གིས། ཁྱོད་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་བསྐྱལ་བའི་ཚེ། དེ་དང་ལྷན་དུ་དགོངས་དག་གི་མཆོད་པ་ཞིག་ཐོངས་ཤིག དེ་ནས་ཁྱོད་རྣམས་སོས་པར་འགྱུར་ཏེ། ཁོང་གི་ཕྱག་ནི་ཅིའི་ཕྱིར་ཁྱོད་ཅག་གི་སྟེང་ནས་མ་འཐེན་པའང་ཤེས་པར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་ཕེ་ལེ་ཤེད་པ་དག་གིས། དགོངས་དག་གི་མཆོད་པ་དེ་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པའི་ལན་དུ་མོ་པ་ཚོ་ན་རེ། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཀྱི་གྲངས་ཀ་བཞིན་དུ། གསེར་གྱི་གཞང་འབྲུམ་ལྔ་དང་། གསེར་ནས་བཟོས་པའི་བྱི་བ་ལྔ་ཕུལ་ཞིག གང་ལ་ཞེ་ན། ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་འགོ་དཔོན་ལ་ནད་ཡམས་གཅིག་མཚུངས་ཕོག་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":5,"content":["དེའི་ཕྱིར་གཞང་འབྲུམ་གྱི་དཔེ་གཟུགས་དང་ཁྱོད་ཚོའི་ལོ་ཏོག་ལ་གནོད་བྱེད་པའི་བྱི་བའི་དཔེ་གཟུགས་བཟོས་ཏེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ལ་བསྟོད་པ་ཕུལ་ཞིག དེའི་སྒོ་ནས་ཁོང་ཉིད་ཀྱི་བཀའ་ཆད་ནི་ཁྱོད་རྣམས་དང་། ཁྱོད་རྣམས་ཀྱི་ལྷ་དང་། ཁྱོད་རྣམས་ཀྱི་ཡུལ་ལ་མི་འཕོག་ཀྱང་སྲིད་དོ། །"]},{"type":"verse","number":6,"content":["ཨེ་ཅིབ་པ་དང་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱིས་སེམས་གྱོང་པོ་བྱས་པ་ལྟར་ཁྱོད་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་སེམས་གྱོང་པོ་བྱེད་དམ། དཀོན་མཆོག་གིས་འཕྲིན་ལས་ཡ་མཚན་ཅན་མཛད་ནས། ཨེ་ཅིབ་པ་དང་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱིས་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་འགྲོ་རུ་བཅུག་པ་མ་ཡིན་ནམ། ཁོ་རྣམས་སོང་བ་མ་ཡིན་ནམ།"]},{"type":"verse","number":7,"content":["དེའི་ཕྱིར་ཁྱོད་རྣམས་ཀྱིས་ཤིང་རྟ་གསར་པ་ཞིག་བཟོས་ནས། གཉའ་ཤིང་གིས་ད་དུང་མ་མནན་པའི་བ་མོ་འོ་མ་ཅན་གཉིས་ལ་ཤིང་རྟ་བརྒྱབ་ནས། བ་ཕྲུག་རྣམས་ཕྱིར་ཡུལ་དུ་ཁྲིད་ཅིག"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་བླངས་ཏེ་ཤིང་རྟ་དེའི་སྟེང་འཇོག་དགོས་པ་དང་། དགོངས་དག་གི་མཆོད་པར་འབུལ་འོས་པའི་གསེར་གྱི་རིན་པོ་ཆེ་རྣམས་ནི་ཟ་མ་ཏོག་ཅིག་གི་ནང་དུ་བསྡུས་ཏེ་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གམ་དུ་ཞོག་ལ་འགྲོ་བར་བཅུག་ནས།"]},{"type":"verse","number":9,"content":["དེ་ལ་ལྟོས་ཤིག ཤིང་རྟ་དེ་ཡེས་ར་ཨེལ་གྱི་ས་མཚམས་བརྒྱུད་དེ་པེད་ཤེ་མེ་སིའི་ཕྱོགས་སུ་འགྲོ་ན། དཀོན་མཆོག་གིས་ངེད་རྣམས་ལ་གོད་ཆག་ཆེན་པོ་འདི་བྱུང་དུ་བཅུག་པ་ཤེས་དགོས་ཤིང་། གལ་ཏེ་མི་འགྲོ་ན། ཁོང་གི་ཕྱག་གིས་ངེད་རྣམས་ལ་རྡུང་བ་མིན་པར། ངེད་རྣམས་ལ་སྟེས་དབང་གིས་བྱུང་བ་ཞིག་ཡིན་པ་ཅིས་ཀྱང་ངེས་དགོས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་མི་རྣམས་ཀྱིས་དེ་ལྟར་བྱས་ཏེ། བ་མོ་གཉིས་ཁྲིད་ནས་ཤིང་རྟ་བརྒྱབ་སྟེ་བ་ཕྲུག་རྣམས་ཁྱིམ་དུ་བཀག་པ་དང་།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་གསེར་ལས་བཟོས་པའི་གཞང་འབྲུམ་དང་བྱི་བའི་དཔེ་གཟུགས་ཡོད་པའི་ཟ་མ་ཏོག་གཉིས་ཤིང་རྟའི་སྟེང་བཞག"]},{"type":"verse","number":12,"content":["བ་མོ་དེ་གཉིས་ནི་དྲང་པོར་པེད་ཤེ་མེ་སིའི་ལམ་དུ་ཞུགས་ཤིང་། ངུར་བཞིན་རྒྱ་ལམ་གྱི་ཁར་འགྲུལ་ཏེ་གཡས་གཡོན་གང་དུ་ཡང་མ་འཆོལ་ལོ། །ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་བེད་ཤེ་མེ་སི་ཡུལ་གྱི་ས་མཚམས་བར་རྗེས་སུ་ཕྱིན་ཏོ། །"]},{"type":"verse","number":13,"content":["ཉིན་དེ་ལ་པེད་ཤེ་མེ་སིའི་མི་རྣམས་ཀྱིས་ཀླུང་ཐང་དུ་སྟོན་ཐོག་རྔ་བཞིན་ཡོད་ཅིང་། ཡར་བལྟས་པ་ན་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་མཐོང་བས་དགའ་བར་གྱུར།"]},{"type":"verse","number":14,"content":["ཤིང་རྟ་དེ་ནི་པེད་ཤེ་མེ་སིའི་ཡོ་ཤུ་ཨ་ཡི་ཞིང་སར་སླེབས་ཏེ། ཕ་བོང་ཆེན་པོ་ཞིག་གི་མདུན་དུ་བསྡད། དེ་ནས་པེད་ཤེ་མེ་སིའི་མི་རྣམས་ཀྱིས་ཤིང་རྟའི་ཤིང་གཤགས་ནས། བ་མོ་དེ་གཉིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་ཏུ་ཕུལ་བ་རེད།"]},{"type":"verse","number":15,"content":["དོན་དེ་མ་བྱུང་སྔོན་དུ་ལེ་ཝི་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་དེར་ཡོད་པའི་གསེར་གྱི་རིན་པོ་ཆེ་རྣམས་ཟ་མ་ཏོག་ལས་ཕབ་ཅིང་། ཕ་བོང་ཆེན་པོ་དེའི་སྟེང་བཞག་ཡོད། ཉིན་དེ་ལ་པེད་ཤེ་མེ་སིའི་མི་རྣམས་ཀྱིས་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་གི་མཆོད་པ་དང་དམར་མཆོད་ཀྱང་ཕུལ།"]},{"type":"verse","number":16,"content":["ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་ལྔ་ཡིས་གནས་ཚུལ་དེ་མཐོང་ནས་ཉིན་དེར་ཨེག་རོན་དུ་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":17,"content":["ཡང་ཕེ་ལེ་ཤེད་པས་གསེར་གྱི་གཞང་འབྲུམ་གྱི་དཔེ་གཟུགས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དགོངས་དག་གི་མཆོད་པར་ཕུལ་བ་ནི། ཨ་སི་དོད་ཅེས་པའི་གྲོང་ཁྱེར་དང་གཱ་ཟཱ་གྲོང་ཁྱེར། ཨ་ཤཱ་ཀེ་ལོན་གྲོང་ཁྱེར། གཱད་གྲོང་ཁྱེར། ཨེག་རོན་གྲོང་ཁྱེར་བཅས་ཀྱི་ཕྱིར་མཆོད་པ་རེ་རེ་ཕུལ།"]},{"type":"verse","number":18,"content":["ཡང་གསེར་གྱི་བྱི་བ་ནི་ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་ལྔ་ཡིས་བཟུང་བའི་ལྕགས་རིས་བསྐོར་བའི་གྲོང་ཁྱེར་དང་གྲོང་རྡལ་རྣམས་ཀྱི་གྲངས་ཀ་བཞིན་དུ་ཕུལ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་བཞག་པའི་ཕ་བོང་ཆེན་པོ་དེ་ནི་དེ་རིང་གི་བར་དུ་ཡང་པེད་ཤེ་མེ་སིའི་ཡོ་ཤུ་ཨ་ཡི་ཞིང་ས་རུ་ཡོད་དོ། །"]},{"type":"verse","number":19,"content":["དེ་ནས་པེད་ཤེ་མེ་སིའི་མི་རྣམས་ཀྱིས་རང་འདོད་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་ནང་བལྟས་པས། ཁོང་གིས་མི་བདུན་ཅུ་བསད་པ་རེད། སྐབས་དེར་མི་ཁྲི་ལྔ་ས་དེ་རུ་ཡོད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་མི་རྣམས་ལ་འདི་ལྟར་གསོད་གཅོད་ཆེན་པོས་བརྡུངས་པས་ཁོ་ཚོས་མྱ་ངན་བྱས།"]},{"type":"verse","number":20,"content":["ཡང་པེད་ཤེ་མེ་སིའི་མི་རྣམས་ན་རེ། དཀོན་མཆོག་དམ་པ་ཡ་ཝཱེའི་སྤྱན་སྔར་སུ་ཞིག་གནས་ཐུབ་བམ། ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ངེད་ཅག་གི་ཕྱོགས་ནས་སུའི་རྩར་བསྐྱལ་ལམ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":21,"content":["པེད་ཤེ་མེ་སིའི་མི་རྣམས་ཀྱིས། ཀིར་ཡཱད་ཡེ་ཨ་རིམ་གྲོང་ཁྱེར་ལ་བང་ཆེན་འགའ་མངགས་ནས་མི་དེ་ཚོར། ཕེ་ལེ་ཤེད་པས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཕྱིར་ཁྱེར་འོངས་འདུག ཁྱོད་ཅག་འོངས་ནས་ཕྱིར་རང་གི་ཡུལ་དུ་ཁྱེར་ཅིག་ཅེས་བསྐུལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/5.json","previousChapterAudioLinks":{},"numberOfVerses":21}