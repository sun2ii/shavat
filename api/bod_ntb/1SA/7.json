{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["ཡང་ཀིར་ཡཱད་ཡེ་ཨ་རིམ་པ་རྣམས་འོངས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཡར་གདན་དྲངས་ནས་རི་ལ་གནས་པའི་ཨ་བི་ནཱ་དབ་ཀྱི་ཁྱིམ་དུ་ཁྱེར་ཏེ། དེའི་བུ་ཨེ་ལི་ཨ་ཟར་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དེ་བསྲུང་ཆེད་དམ་པར་བྱས་སོ། །"]},{"type":"heading","content":["ཕེ་ལེ་ཤེད་པ་དང་ཡེས་ར་ཨེལ་པའི་བར་འཐབ་འཁྲུག་བྱུང་བ།"]},{"type":"verse","number":2,"content":["ཉིན་དེ་ནས་བཟུང་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཀིར་ཡཱད་ཡེ་ཨ་རིམ་དུ་ཡུན་རིང་ཞིག་ལ་ལུས་ཏེ། ཇི་ཙམ་ཞེ་ན། ལོ་ཉི་ཤུའི་རིང་ལ་དེ་རུ་ལུས། ཡང་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མྱ་ངན་བྱས།"]},{"type":"verse","number":3,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། གལ་ཏེ་ཁྱོད་རྣམས་སེམས་གཏིང་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ལོག་འདོད་ན། ཕྱི་ཕྱོགས་ཀྱི་ལྷ་རྣམས་ཀྱི་སྐུ་འདྲ་དང་ལྷ་མོ་ཨ་ཤཱ་ཏ་རོད་ཀྱི་འདྲ་གཟུགས་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ཕུད་དེ། སེམས་ཡོངས་སུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་ཞིང་། ཁོང་ཉིད་འབའ་ཞིག་ལ་ཞབས་ཏོག་བསྒྲུབས་ན། ཁོང་གིས་ཁྱོད་རྣམས་ཕེ་ལེ་ཤེད་པའི་ལག་ནས་སྒྲོལ་ངེས་ཡིན་ཞེས་པའོ། །"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་པཱ་ཨལ་དང་ལྷ་མོ་ཨ་ཤཱ་ཏ་རོད་ཀྱི་འདྲ་གཟུགས་རྣམས་བཏོན་ནས། དཀོན་མཆོག་ཡ་ཝཱེ་འབའ་ཞིག་ལ་བསྙེན་བཀུར་ཞུས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས། ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་ལ་འཛོམ་དུ་ཆུག་དང་། ངས་ཁྱོད་ཅག་གི་དོན་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་འདེབས་པར་བྱ་ཞེས་སྨྲས།"]},{"type":"verse","number":6,"content":["དེ་དག་མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་དུ་འདུས་པ་དང་། ཆུ་བཅུས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བླུགས། ཉིན་དེ་ལ་སྨྱུང་གནས་བསྲུངས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཁོ་རྣམས་ན་རེ། ངེད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱས་པ་ཡིན་ཞེས་ཞུས། དེ་ལྟར་སཱ་མུ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་མིལ་ཚི་པཱ་ཞེས་པའི་གྲོང་ཁྱེར་ནས་སྲིད་བྱས་པའོ། །"]},{"type":"verse","number":7,"content":["ཡང་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་དག་མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་དུ་འཛོམས་ཡོད་པ་ཐོས་པས། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱོགས་སུ་དམག་དྲངས། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དོན་དེ་ཐོས་པས་ཕེ་ལེ་ཤེད་པ་ལ་འཇིགས་པར་གྱུར།"]},{"type":"verse","number":8,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་སཱ་མུ་ཨེལ་ལ། ངེད་ཅག་ཕེ་ལེ་ཤེད་པའི་དབང་འོག་ནས་སྒྲོལ་བའི་ཕྱིར། བདག་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་འབོད་མཚམས་མ་གཅོད་ཅིག་ཅེས་ཞུས།"]},{"type":"verse","number":9,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་ལུ་གུ་འོ་འཐུང་ཞིག་བླངས་ནས། ཡོངས་སུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་གི་མཆོད་པར་ཕུལ་ཏེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་དོན་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྐྱབས་འབོད་བྱས་པས་ཁོང་གིས་དེ་ལ་གསན་ཏོ། །"]},{"type":"verse","number":10,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་སྦྱིན་སྲེག་འབུལ་བའི་སྐབས་སུ། ཕེ་ལེ་ཤེད་པ་རྣམས་ཡེས་ར་ཨེལ་པ་དག་ལ་དམག་རྒྱག་ཏུ་འོངས། ཉིན་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཕེ་ལེ་ཤེད་པའི་སྟེང་དུ་འབྲུག་སྒྲ་ཆེན་པོ་ལྡིར་དུ་བཅུག་པས། དེ་དག་སྐྲག་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་ནས་ཕམ་པར་གྱུར།"]},{"type":"verse","number":11,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ནི་མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་ནས་ཐོན་ཏེ། པེད་ཀར་གྲོང་ཚོ་དང་ཉེ་བའི་བར་དུ་ཕེ་ལེ་ཤེད་པའི་རྗེས་སུ་དེད་ནས་ཁོ་ཚོ་བསད་དོ། །"]},{"type":"verse","number":12,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་རྡོ་ཞིག་བླངས་ནས། མཱས་ཟི་ཕཱ་གྲོང་ཁྱེར་དང་ཤེན་ཞེས་པའི་བྲག་གཡང་གཉིས་ཀྱི་བར་ལ་བཞག་སྟེ། དུས་འདིའི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་ལ་སྐྱབས་མཛད་པ་ཡིན་ཞེས་སྨྲས་ཏེ། རྡོ་དེའི་མིང་ལ་ཨེ་བེན་ཨེ་ཟིར་",{"noteId":2},"ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་ལྟར་ཕེ་ལེ་ཤེད་པ་རྣམས་ཕམ་ནས། དེ་དག་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ས་ཆར་སླེབས་རྒྱུ་མ་བྱུང་བ་རེད། སཱ་མུ་ཨེལ་གྱི་མི་ཚེ་གང་པོར་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་གིས་ཕེ་ལེ་ཤེད་པ་རྣམས་བཀག་པར་མཛད།"]},{"type":"verse","number":14,"content":["ཕེ་ལེ་ཤེད་པས་བཟུང་བའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་གྲོང་ཁྱེར་ཨེག་རོན་ནས་གཱད་ཀྱི་བར་དུ་ཕྱིར་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དབང་བར་གྱུར། ཁོ་ཚོས་རང་གི་ས་ཆ་ཕེ་ལེ་ཤེད་པའི་དབང་འོག་ནས་བླངས་ཤིང་། ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་དང་ཨེ་མོར་པ་ནི་མཐུན་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":15,"content":["སཱ་མུ་ཨེལ་གྱིས་མི་ཚེ་གང་པོར་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་སྲིད་ཀྱི་བྱ་བ་བསྒྲུབས།"]},{"type":"verse","number":16,"content":["ཁོང་ལོ་རེ་བཞིན་པེད་ཨེལ་དང་གིལ་གལ་དང་མཱས་ཟི་ཕཱ་བཅས་པའི་གྲོང་ཁྱེར་རྣམས་སུ་སོང་སྟེ། གནས་དེ་ཐམས་ཅད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྲིད་ཀྱི་བྱ་བ་བསྒྲུབས།"]},{"type":"verse","number":17,"content":["རཱ་མ་གྲོང་ཁྱེར་དུ་སཱ་མུ་ཨེལ་གྱི་ཁྱིམ་ཡོད་པས། ཁོང་དེར་ལོག་སྟེ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྲིད་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བརྩིགས་སོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ཨེ་བེན་ཞེས་པ་ནི་རྡོ་དང་ཨེ་ཟིར་ཞེས་པ་རོགས་རམ་གྱི་དོན་ཡིན།","reference":{"chapter":7,"verse":12}}]},"thisChapterLink":"/api/bod_ntb/1SA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}