{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":8,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རྒྱལ་པོ་ཞིག་འཐོབ་པར་ཞུས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སཱ་མུ་ཨེལ་ལོ་ན་རྒས་པའི་ཚེ། རང་གི་བུ་གཉིས་ཡེས་ར་ཨེལ་གྱི་ཁྲིམས་དཔོན་དུ་བསྐོས་པ་དང་།"]},{"type":"verse","number":2,"content":["བུ་ཆེ་བའི་མིང་ལ་ཡོ་ཨེལ་ཞེས་དང་། བུ་ཆུང་བའི་མིང་ལ་ཨ་བི་ཡཱ་ཞེས་བྱ་ཞིང་། དེ་གཉིས་ཀྱིས་པེར་ཤ་བཱ་གྲོང་ཁྱེར་དུ་ཁྲིམས་དཔོན་བྱས།"]},{"type":"verse","number":3,"content":["ཡང་བུ་དེ་གཉིས་ནི་ཁོའི་ལམ་ལ་མ་འགྲུལ་ཞིང་། ནོར་ལ་བརྣབ་སེམས་ཅན་ཞིག་ཡིན་ཏེ། ལྐོག་ནོར་བླངས་ནས་དྲང་གཞག་ལོག་སྒྲུབ་བྱས།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་ཐམས་ཅད་འཛོམས་ནས་རཱ་མ་གྲོང་ཁྱེར་དུ་སཱ་མུ་ཨེལ་གྱི་དྲུང་དུ་སླེབས་ཏེ།"]},{"type":"verse","number":5,"content":["དེ་དག་གིས་ཁོ་ལ། ལྟོས་དང་། ཁྱེད་ནི་ལོ་ན་རྒས་ཤིང་ཁྱེད་ཀྱི་བུ་གཉིས་ནི་ཁྱེད་ཀྱི་ལམ་ལ་མི་འགྲོ་བས། ད་ནི་ངེད་ཅག་ལ་རྒྱལ་ཁབ་གཞན་ཐམས་ཅད་བཞིན་དུ་སྲིད་སྐྱོང་བའི་རྒྱལ་པོ་ཞིག་གནང་བར་མཛོད་ཅེས་ཞུས།"]},{"type":"verse","number":6,"content":["དེ་དག་གིས་ངེད་ཅག་ལ་སྲིད་སྐྱོང་བའི་རྒྱལ་པོ་ཞིག་གནང་བར་མཛོད་ཅེས་ཞུས་པས། སཱ་མུ་ཨེལ་གཏམ་དེ་ལ་མི་དགའ་བར་གྱུར་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་བཏབ།"]},{"type":"verse","number":7,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་སཱ་མུ་ཨེལ་ལ་འདི་སྐད་དུ། མི་རྣམས་ཀྱིས་ཁྱོད་ལ་ཇི་ལྟར་སྨྲས་པ་བཞིན་དུ་སྒྲུབས་ཤིག རྒྱུ་མཚན་ནི། དེ་དག་གིས་ཁྱོད་རང་གཡུགས་པ་མ་ཡིན་པར། ང་རང་རྒྱལ་པོའི་གོ་ས་དེར་མ་བཞག་པར་དོར་བ་ཡིན།"]},{"type":"verse","number":8,"content":["བདག་གིས་མི་འདི་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པ་ནས་དེ་རིང་གི་བར་དུ་དེ་དག་གིས་ང་རང་སྤངས་ཏེ་ལྷ་གཞན་རྣམས་བསྟེན་པ་ཡིན། བྱ་བ་དེ་ལྟ་བུ་དེ་དག་གིས་ཁྱོད་ལ་ཡང་བྱེད་ངེས།"]},{"type":"verse","number":9,"content":["དེའི་ཕྱིར་མི་རྣམས་ཀྱི་སྐད་ལ་ཉོན་ཅིག འོན་ཀྱང་མ་འོངས་པ་ན་དེ་དག་ལ་སྲིད་བྱེད་པའི་རྒྱལ་པོའི་བྱེད་སྟངས་ཐམས་ཅད་གསལ་པོར་འཆད་དགོས་ལ་ཉེན་བརྡ་ཡང་ཐོངས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":10,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ཐམས་ཅད་ནི་རྒྱལ་པོ་དགོས་ཞུ་མཁན་གྱི་མི་རྣམས་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ལ་སྲིད་བྱེད་པར་འགྱུར་བའི་རྒྱལ་པོ་དག་གི་བྱེད་སྟངས་ནི་འདི་ལྟར་ཡིན། ཁོང་གིས་ཁྱོད་ཅག་གི་བུ་རྣམས་བསྡུས་ནས་རང་གི་ཤིང་རྟ་འདེད་མཁན་ནམ་རྟ་པར་བསྐོས་ཏེ། རྒྱལ་པོའི་སྲོག་སྲུང་བའི་ཆེད་དུ་ཁོང་གི་ཤིང་རྟའི་མདུན་དུ་རྒྱུག་པར་འགྱུར།"]},{"type":"verse","number":12,"content":["ཡང་རྒྱལ་པོ་དེ་དག་གིས་མི་སྟོང་རེ་ལ་སྟོང་དཔོན་དང་མི་ལྔ་བཅུ་རེ་ལ་ལྔ་བཅུ་དཔོན་རེ་བསྐོ་བ་དང་། ཁྱོད་ཅག་གི་བུ་རྒྱུད་ཀྱིས་ཁོང་གི་ཞིང་ས་རྨོ་བ་དང་། སྟོན་ཐོག་རྔ་བ་དང་། དམག་ཆས་བཟོ་བ་དང་། ཤིང་རྟའི་ལྷུ་ལག་བཟོ་བར་བྱེད་དོ། །"]},{"type":"verse","number":13,"content":["ཡང་ཁོང་གིས་ཁྱོད་ཅག་གི་བུ་མོ་རྣམས་ནི་སྤོས་ཆུ་བཟོ་མཁན་དང་། གསོལ་ཐབ་མཁན་དང་། བག་ལེབ་སྲེག་མཁན་བཅས་སུ་བྱེད་དོ། །"]},{"type":"verse","number":14,"content":["ད་དུང་ཁྱོད་རྣམས་ཀྱི་ཞིང་དང་རྒུན་འབྲུམ་ར་བ་དང་སྐྱུ་རུ་རའི་ཚལ་ཤིན་ཏུ་བཟང་པོ་རྣམས་ཕྲོགས་ནས། ཁོང་གི་བློན་པོ་རྣམས་ལ་གཏོང་བར་བྱེད།"]},{"type":"verse","number":15,"content":["ཡང་ཁྱོད་རྣམས་ཀྱི་ས་བོན་དང་རྒུན་འབྲུམ་ར་བ་ནས་བཅུ་ཆའི་གཅིག་བླངས་ཏེ། རང་གི་འཁོར་གྱི་ཉུག་རུམ་པ་དང་ཞབས་ཕྱི་པ་རྣམས་ལ་གཏོང་བར་བྱེད།"]},{"type":"verse","number":16,"content":["ཡང་ཁྱོད་ཅག་གི་ཞབས་ཕྱི་དང་གཡོག་མོ། བྱད་གཟུགས་ལེགས་པའི་གཞོན་ནུ། བོང་བུ་བཅས་ཕྲོགས་ཏེ་ཁོང་གི་ལས་ཀ་བྱེད་མཁན་དུ་འཇུག་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["ཡང་ཁོང་གིས་ཁྱོད་ཚོའི་ར་ལུག་གི་ཁྱུ་ལས་བཅུ་ཆའི་གཅིག་བླངས་ཏེ་ཁྱོད་རྣམས་ནི་ཁོང་གི་གཡོག་པོར་འགྱུར།"]},{"type":"verse","number":18,"content":["ཉིན་དེ་ལ་ཁྱོད་རྣམས་ཀྱིས་རང་གིས་བསྐོས་པའི་རྒྱལ་པོའི་ཕྱིར་དུ་ངུ་འབོད་བྱེད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཉིན་དེར་ཁྱོད་རྣམས་ལ་གསན་པར་མི་བྱའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["སཱ་མུ་ཨེལ་གྱིས་དེ་ལྟར་སྨྲས་ཀྱང་མི་རྣམས་ཀྱིས་ཁོའི་སྐད་ཆ་ལ་མ་མཉན་པར་ན་རེ། ངེད་ཅག་གི་གོང་དུ་རྒྱལ་པོ་ཞིག་ཡོད་པར་དགའ།"]},{"type":"verse","number":20,"content":["ངེད་ཅག་ནི་མི་རིགས་གཞན་ཐམས་ཅད་དང་འདྲ་བར་འགྱུར་ཞིང་ངེད་ཅག་ལ་རང་གི་རྒྱལ་པོས་སྲིད་སྐྱོང་བ་དང་། ཁོ་རང་ངེད་ཅག་གི་མདུན་དུ་འགྲོ་ཞིང་ང་ཚོའི་དོན་དུ་དམག་རྒྱག་པར་བྱའོ་ཞེས་སྨྲས།"]},{"type":"verse","number":21,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་མི་རྣམས་ཀྱི་གཏམ་ཐམས་ཅད་ཐོས་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་སྙན་ལམ་དུ་ཡང་བསྐྱར་ཞུས་པ་དང་།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་སཱ་མུ་ཨེལ་ལ་འདི་སྐད་དུ། ཁོ་ཚོའི་སྐད་ཆར་མཉན་ནས་དེ་དག་ལ་རྒྱལ་པོ་ཞིག་སྐོས་ཤིག་ཅེས་གསུངས་པས། སཱ་མུ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ། ཁྱོད་ཅག་མི་རེ་རེ་རང་རང་གི་གྲོང་ཁྱེར་དུ་ཕྱིར་ལོག་ཅིག་ཅེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}