{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་དང་པོ།","commonName":"སཱ་མུ་ཨེལ་དང་པོ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་དང་པོ།","order":9,"numberOfChapters":31,"sha256":"a4776f7c1bcc9fe168f84ef9c85ff7c1dcc4ee390aef8cb01a86e680dda0cbc6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/1SA/31.json","totalNumberOfVerses":809},"chapter":{"number":9,"content":[{"type":"heading","content":["སཱ་མུ་ཨེལ་དང་སོ་ལོ་གཉིས་ཕྲད་པ།"]},{"type":"verse","number":1,"content":["དེའི་ཚེ་པེན་ཡཱ་མེན་ཚོ་པར་མིང་ལ་ཁི་སི་ཞེས་འབོད་པའི་ཕྱུག་བདག་ཅིག་ཡོད་པ་དང་། དེ་ནི་ཨ་བེ་ཨེལ་གྱི་བུ་དང་། ཨ་བེ་ཨེལ་ནི་ཙེ་རོར་གྱི་བུ། ཙེ་རོར་ནི་པི་ཀོ་རད་ཀྱི་བུ། པི་ཀོ་རད་ནི་པེན་ཡཱ་མེན་པའི་ཨ་ཕེ་ཨག་གི་བུ་བཅས་ཡིན།"]},{"type":"verse","number":2,"content":["མིང་ལ་སོ་ལོ་ཞེས་འབོད་པ་ནི་ཁི་སིའི་བུ་ཡིན་པ་དང་། དེ་ནི་གཞོན་ནུ་བྱད་གཟུགས་ལེགས་པ་ཞིག་ཡིན་ཏེ། དེ་ལྟ་བུའི་བྱད་གཟུགས་ལེགས་པའི་མི་ཞིག་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་མེད་ཅིང་། ཁོ་རང་མི་ཐམས་ཅད་ཀྱི་གཟུགས་ལས་མགོ་གཅིག་གིས་མཐོ་བ་ཡིན།"]},{"type":"verse","number":3,"content":["ཡང་སོ་ལོ་ཡི་ཕ་ཁི་སིའི་བོང་བུ་རྣམས་བོར་བས། ཁི་སི་ཡིས་རང་གི་བུ་སོ་ལོ་ལ། ཞབས་ཕྱི་རྣམས་ལས་གཅིག་ཁྲིད་དེ་བོང་བུ་རྣམས་བཙལ་དུ་སོང་ཞིག་ཅེས་བསྒོས་པས།"]},{"type":"verse","number":4,"content":["དེ་གཉིས་ཨེ་ཕཱར་ཡིམ་རི་བོའི་ཡུལ་དང་ཤཱ་ལི་ཤཱ་ཡུལ་བརྒྱུད་དེ་སོང་ནའང་མ་རྙེད་པ་རེད། དེ་ནས་སཱ་ཨ་ལེམ་ཡུལ་བརྒྱུད་དེ་སོང་བ་ན་བོང་བུ་དེ་རུའང་མེད་པ་དང་། པེན་ཡཱ་མེན་པའི་ཡུལ་བརྒྱུད་དེ་ཕྱིན་ན་ཡང་མ་རྙེད་དོ། །"]},{"type":"verse","number":5,"content":["དེ་གཉིས་ཙུབ་ཡུལ་གྱི་བར་དུ་སླེབས་ཙ་ན། སོ་ལོས་ཁོ་དང་མཉམ་དུ་ཡོད་པའི་ཞབས་ཕྱི་ལ། ད་ཤོག་དང་ངེད་གཉིས་ཕྱིར་འགྲོ་བར་བྱ། ཕྱིར་མ་སོང་ན་ཕ་ཡིས་བོང་བུའི་ཆེད་དུ་སེམས་ཁུར་བྱེད་པ་ལས་ལྡོག་སྟེ། ངེད་གཉིས་ཀྱི་ཆེད་དུ་སེམས་ཁུར་བྱེད་པར་འགྱུར་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":6,"content":["ཞབས་ཕྱིས་སོ་ལོ་ལ། གཟིགས་དང་། གྲོང་ཁྱེར་འདི་རུ་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཞིག་བཞུགས། མི་རྣམས་ཀྱིས་དེ་ལ་གུས་བཀུར་བྱེད་ཅིང་། མི་དེས་ཅི་ཞིག་གསུངས་ན་ཡང་བདེན་པར་འགྱུར། ད་ངེད་གཉིས་དེ་རུ་འགྲོ་སྟེ། མི་དེས་ངེད་གཉིས་ལ་འགྲོ་འོས་པའི་ལམ་སྟོན་ཡང་སྲིད་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":7,"content":["སོ་ལོས་རང་གི་ཞབས་ཕྱི་ལ། ལྟོས་དང་། ངེད་གཉིས་དེ་རུ་སོང་ན་མི་དེ་ལ་ཅི་འབུལ་ལམ། ངེད་གཉིས་ཀྱི་སྣོད་ཀྱི་ནང་དུ་ཡོད་པའི་བག་ལེབ་ནི་རྫོགས་ཚར་ལ། དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལ་འབུལ་བའི་ནོར་གཅིག་ཀྱང་མེད། ད་དུང་ངེད་གཉིས་ལ་ཅི་ཡོད་དམ་ཞེས་དྲིས་པས།"]},{"type":"verse","number":8,"content":["ཞབས་ཕྱིས་སོ་ལོ་ལ་འདི་ལྟར། གཟིགས་དང་། འདིར་བདག་གི་ལག་ཏུ་དངུལ་སྲང་བཞི་ཆའི་གཅིག་ཡོད། དེ་ནི་ངེད་གཉིས་ལ་འགྲོ་འོས་པའི་ལམ་སྟོན་ཕྱིར་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ལ་འབུལ་བར་བྱ་ཞེས་ལན་ཞུས།"]},{"type":"verse","number":9,"content":["སྔོན་ཆད་ཡེས་ར་ཨེལ་པའི་ཁྲོད་དུ་མི་ཞིག་དཀོན་མཆོག་ལ་ཞུ་བ་བྱེད་དུ་འགྲོ་བའི་ཚེ་འདི་ལྟར་སྨྲ་བ་ཡིན་ཏེ། ཤོག་དང་། ངེད་རྣམས་མངོན་ཤེས་པ་དེའི་དྲུང་དུ་འགྲོ་བར་བྱའོ་ཟེར། དེང་གི་ལུང་སྟོན་པ་ཞེས་པར་སྔོན་ཆད་མངོན་ཤེས་པ་ཞེས་འབོད་དོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་སོ་ལོས་རང་གི་ཞབས་ཕྱི་ལ། ཁྱོད་ཀྱིས་སྨྲས་པ་ལེགས་སོ། །ཤོག་དང་། ངེད་གཉིས་འགྲོ་བར་བྱ་ཞེས་སྨྲས་པ་དང་། དེ་ལྟར་ཁོ་གཉིས་དཀོན་མཆོག་གི་སྐྱེས་བུ་བཞུགས་སའི་གྲོང་ཁྱེར་དུ་སོང་ངོ་། །"]},{"type":"verse","number":11,"content":["གྲོང་ཁྱེར་དེའི་རི་བོ་ལ་ཡར་འགོས་པ་དང་གཞོན་ནུ་མ་ཆུ་ལེན་པའི་ཕྱིར་ཡོང་བ་རྣམས་དང་ཕྲད་པས། དེ་དག་ལ་མངོན་ཤེས་པ་འདི་རུ་བཞུགས་སམ་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་ལན་དུ། ཁོང་བཞུགས་ཏེ། ལྟོས་ཤིག ཁོང་ནི་ཁྱེད་ཀྱི་མདུན་དུ་བཞུགས་འདུག་སྟེ། མྱུར་དུ་སོང་དང་། དེ་རིང་གནས་མཐོ་ས་རུ་ཡུལ་མི་རྣམས་ཀྱི་ཆེད་དུ་མཆོད་པ་འབུལ་བའི་ཕྱིར་ཁོང་ནི་གྲོང་ཁྱེར་དུ་ཕེབས་སོ། །"]},{"type":"verse","number":13,"content":["ཁྱེད་གཉིས་གྲོང་ཁྱེར་དུ་སླེབས་པ་ཙམ་གྱིས། ཁོང་གནས་མཐོ་སར་ཞལ་ཟས་བཞེས་སུ་མ་ཕེབས་སྔོན་ལ་ཁོང་དང་འཕྲད་པར་འགྱུར། མི་ཚོགས་ཀྱིས་ཁོང་མ་ཕེབས་བར་དུ་ཁ་ཟས་བཟའ་མི་འོང་། རྗེས་སུ་ཁོང་གིས་མཆོད་པ་ལ་བྱིན་རླབས་གནང་ན། མགྲོན་དུ་བོས་པ་རྣམས་ཀྱིས་བཟའ་བར་འགྱུར། དེའི་ཕྱིར། དུས་འདི་ཉིད་དུ་ཁོང་དང་མཇལ་བར་སོང་ཞིག་ཅེས་སྨྲས།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཁོ་གཉིས་ཡར་གྲོང་ཁྱེར་ནང་འཛུལ་དུས། སཱ་མུ་ཨེལ་ཁོ་གཉིས་ཀྱི་མདུན་ནས་འོང་བཞིན་པ་དང་། གནས་མཐོ་སའི་ཕྱོགས་སུ་འགྲོ་བཞིན་ཡོད་དོ། །"]},{"type":"verse","number":15,"content":["སོ་ལོ་མ་སླེབས་པའི་ཉིན་གཅིག་གི་སྔོན་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་སཱ་མུ་ཨེལ་ལ་མཛུབ་སྟོན་གནང་སྟེ་འདི་སྐད་དུ།"]},{"type":"verse","number":16,"content":["སང་ཉིན་དུས་ཚོད་འདི་ལ་ངས་ཁྱོད་ཀྱི་མདུན་དུ་པེན་ཡཱ་མེན་ཡུལ་གྱི་མི་ཞིག་མངག་པར་བྱ། བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་ནི་ཕེ་ལེ་ཤེད་པའི་ལག་ནས་སྒྲོལ་བའི་ཕྱིར་ཁྱོད་ཀྱིས་མི་དེ་འགོ་དཔོན་དུ་བསྐོ་དགོས། བདག་གིས་རང་གི་འབངས་མིར་གཟིགས་སྐྱོང་བྱས་པ་ཡིན། གང་ལ་ཞེ་ན། དེ་དག་གི་ངུ་སྐད་ང་ཡི་མདུན་དུ་སླེབས་པས་སོ་ཞེས་གསུངས་པའོ། །"]},{"type":"verse","number":17,"content":["ཡང་སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་མཐོང་བ་ཙམ་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ། དེ་སྔར་ངས་ཁྱོད་ལ་སྨྲས་པའི་མི་འདི་ཡིན། དེས་ངའི་མི་སྡེ་ལ་སྲིད་སྐྱོང་བར་བྱ་ཞེས་གསུངས་པ་རེད།"]},{"type":"verse","number":18,"content":["དེ་ནས་སོ་ལོ་རྒྱལ་སྒོ་ནང་སཱ་མུ་ཨེལ་གྱི་གམ་དུ་འོངས་སྐབས། ཁོ་ན་རེ། མངོན་ཤེས་པའི་ཁང་པ་གང་དུ་ཡོད་པ་ང་ལ་སྟོན་པར་མཛོད་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":19,"content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ་ལན་དུ། མངོན་ཤེས་པ་དེ་ནི་ང་རང་ཡིན། ཁྱོད་རང་ངའི་སྔོན་དུ་གནས་མཐོ་སར་སོང་ཞིག་དང་། དེ་རིང་ཁྱོད་ཀྱིས་ང་དང་མཉམ་དུ་ཁ་ཟས་བཟའ་བར་འགྱུར། ཞོགས་པ་སྔ་མོ་ངས་ཁྱོད་རང་ལ་སྐྱེལ་མ་བྱེད་དེ། ཁྱོད་ཀྱི་སེམས་ལ་གང་ཡོད་པ་ཁྱོད་ལ་འཆད་པར་བྱ།"]},{"type":"verse","number":20,"content":["ཡང་ཁྱོད་ཀྱིས་ཉིན་གསུམ་གྱི་སྔོན་དུ་བོང་བུ་བོར་བ་དེའི་ཕྱིར་སེམས་ཁུར་མ་བྱེད་ཅིག བོང་བུ་དེ་རྣམས་རྙེད་ཟིན། ཡང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ནི་སུའི་ཕྱིར་དགའ་ཟེར་ན། ཁྱོད་དང་ཁྱོད་ཀྱི་ཁྱིམ་རྒྱུད་ཀྱི་ཕྱིར་དགའ་བ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":21,"content":["སོ་ལོས་དེའི་ལན་དུ། བདག་ནི་ཡེས་ར་ཨེལ་གྱི་ཚོ་པའི་ཁྲོད་དུ་ཐམས་ཅད་ལས་ཆུང་བའི་པེན་ཡཱ་མེན་གྱི་ཚོ་པའི་མི་ཞིག་མ་ཡིན་ནམ། བདག་གི་ཁྱིམ་རྒྱུད་ནི་པེན་ཡཱ་མེན་གྱི་ཚོ་པའི་ཁྲོད་དུ་ཐམས་ཅད་ལས་དམའ་བ་མ་ཡིན་ནམ། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་བདག་ལ་གཏམ་དེ་ལྟ་བུ་སྨྲའམ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":22,"content":["སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་དང་དེའི་ཞབས་ཕྱི་གཉིས་ཁྲིད་ནས་གསོལ་ཁང་དུ་སོང་བ་དང་། མགྲོན་དུ་བོས་པ་རྣམས་ཀྱི་ཁྲོད་དུ་གྲལ་མགོ་རུ་སྡོད་དུ་བཅུག དེ་དག་གི་མི་གྲངས་ནི་སུམ་ཅུ་ཙམ་ཡིན་ནོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་སཱ་མུ་ཨེལ་གྱིས་གསོལ་དཔོན་ལ། སྔར་ངས་ཁྱོད་རང་ལ་ཟུར་དུ་ཞོག་ཅིག་ཅེས་སྨྲས་པའི་ཤ་སྐལ་འདི་རུ་ཁྱེར་ཤོག་ཅེས་བསྐུལ་བས།"]},{"type":"verse","number":24,"content":["གསོལ་དཔོན་གྱིས་བརླ་རྐང་ལ་སོགས་པའི་ཤ་བླངས་ནས་སོ་ལོའི་མདུན་དུ་བཞག་ཅིང་། ཡང་སཱ་མུ་ཨེལ་ན་རེ། ད་ལྟོས་ཤིག འདི་ནི་ཁྱོད་ལ་བཞག་པ་ཡིན། ད་ལོངས་ལ་ཟོ་ཞིག བདག་གིས་མི་རྣམས་མགྲོན་དུ་བོས་པ་ཡིན་ཞེས་སྨྲས་པའི་དུས་ནས་ད་ལྟའི་བར་དུ་འདི་ནི་ཁྱོད་ཀྱི་ཕྱིར་བཞག་པ་ཡིན་ཞེས་སྨྲས་པས། དེའི་ཉིན་མོར་སོ་ལོས་སཱ་མུ་ཨེལ་དང་མཉམ་དུ་ཁ་ཟས་སྤྱད་དོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་ཁོ་ཚོ་གནས་མཐོ་ས་ནས་གྲོང་ཁྱེར་དུ་བབས་པ་དང་། ཡང་སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་དང་མཉམ་དུ་ཁང་ཐོག་ནས་གཏམ་བྱས་སོ། །"]},{"type":"verse","number":26,"content":["སྐྱ་རེངས་ཀྱི་དུས་སུ་སཱ་མུ་ཨེལ་གྱིས་ཁང་ཐོག་ཏུ་ཉལ་བའི་སོ་ལོ་ལ། ད་ལོངས་ཤིག ངས་ཁྱོད་ལ་སྐྱེལ་མ་བྱེད་ཅེས་སྨྲས་པས། སོ་ལོ་ལངས་ནས་སཱ་མུ་ཨེལ་དང་མཉམ་དུ་ཕྱི་རོལ་ཏུ་སོང་།"]},{"type":"verse","number":27,"content":["དེ་གཉིས་གྲོང་ཁྱེར་གྱི་མཐའ་ལ་སླེབས་པའི་ཚེ། སཱ་མུ་ཨེལ་གྱིས་སོ་ལོ་ལ། ཁྱོད་ཀྱིས་ཞབས་ཕྱི་ལ་ངེད་གཉིས་ཀྱི་སྔོན་དུ་སོང་ཞེས་སྐུལ་ཞིག་སྨྲས་པ་དང་། ཡང་སོ་ལོ་ལ་ད་ལྟ་ཁྱོད་རང་ཅུང་ཟད་སྡོད་དང་། ངས་ཁྱོད་ལ་དཀོན་མཆོག་གི་གསུང་ཞིག་འཆད་པར་བྱ་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1SA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1SA/8.json","previousChapterAudioLinks":{},"numberOfVerses":27}