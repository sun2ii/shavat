{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1TH","translationId":"bod_ntb","name":"ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་དང་པོ།","commonName":"ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་དང་པོ།","title":"༄༅། །ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":52,"numberOfChapters":5,"sha256":"072ef5681e5ada2bb5b7f35bebbf916ccc0393b1c2ebbb51c064fe554bcacf83","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1TH/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/1TH/5.json","totalNumberOfVerses":89},"chapter":{"number":2,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་དད་ལྡན་རྣམས་གཅེས་པར་བཟུང་བ།"]},{"type":"verse","number":1,"content":["སྤུན་ཟླ༌རྣམས། ངེད་རྣམས་དེ་སྔར་ཁྱོད་ཅག་གི་གམ་དུ་ཕྱིན་པ་ནི་སྙིང་པོ་མེད་པ་ཞིག་མིན་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་སོ།།"]},{"type":"verse","number":2,"content":["སྔོན་ཆད་ཕི་ལིབ་པི་རུ་ངེད་ཅག་ལ་གནོད་འཚེ་དང་བརྙས་བཅོས་ཐེབས་པའང་ཁྱོད་ཅག་གིས་ཤེས༌པ་ཡིན། འོན༌ཀྱང༌། ངེད་རྣམས་ཀྱིས་བདག་ཅག་གི་དཀོན་མཆོག་ལ་བརྟེན་ནས་སྙིང་སྟོབས་བསྐྱེད༌ཅིང༌། འཁྲུག་རྩོད་ཆེན་པོའི་ཁྲོད་ནས་དཀོན་མཆོག་གི་འཕྲིན་བཟང་ཁྱོད་རྣམས་ལ་བསྒྲགས་མྱོང༌བས།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་གི་སྐུལ་སློང་ནི་ནོར་འཁྲུལ་ཅན༌དང༌། མི་གཙང༌བ། གཡོ་སྒྱུ་བཅས་ལས་བྱུང་བ་མ་ཡིན༌པར།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་གིས་ངེད་རྣམས་ལ་བརྟགས་ཤིང་གཟིགས་ཏེ་འཕྲིན་བཟང་བཅོལ་བ༌བཞིན། ངེད་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་སྒྲོག༌ཅིང་། དེ་ནི་མི་རྣམས་དགའ་བར་བྱེད་པའི་ཕྱིར་མ་ཡིན༌པར། ངེད་ཅག་གི་སེམས་ལ་བརྟག་མཁན་དཀོན་མཆོག་ཁོང་ཉིད་ཐུགས་དགྱེས་པའི་ཕྱིར༌ཡིན་ནོ།།"]},{"type":"verse","number":5,"content":["རྒྱུ་མཚན་ནི་ངེད་ཅག་གིས་ནམ་ཡང་ངོ་དགའི་གཏམ་སྨྲས་མ་མྱོང་བ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པ༌དང༌། ཧམ་པའི་ཐབས་ཀྱང་མ་སྤྱད་པར་དཀོན་མཆོག་གིས་བདེན་དཔང་མཛད་དོ།།"]},{"type":"verse","number":6,"content":["ངེད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཚབ་པ་ཡིན་པས་ཁྱོད་རྣམས་ལས་བརྩི་བཀུར་འཐོབ་འོས་ནའང༌། ཁྱོད་ཅག་གམ་མི་གཞན་སུ་ལས་ཀྱང་བཀུར་སྟི་བཙལ་མ་མྱོང༌ལ།"]},{"type":"verse","number":7,"content":["མ་ཡིས་རང་གི་བུ་ཕྲུག་སྐྱོང་བ་ལྟར་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་ངེད་ཅག་ཞི་ཞིང་དུལ་བར་གནས་ཏེ།"]},{"type":"verse","number":8,"content":["ངེད་ཅག་གིས་ཁྱོད་རྣམས་ལ་དེ་ལྟར་གཅེས༌ཤིང༌། དཀོན་མཆོག་གི་འཕྲིན་བཟང་ཡང་ཁྱོད་ཅག་ལ་གནང་བ༌དང༌། ཁྱོད་རྣམས་ལ་ཤིན་ཏུ་བརྩེ་བའི༌ཕྱིར། ཐ་ན་རང་ཉིད་ཀྱི་ཚེ་སྲོག་ཀྱང་ཁྱོད་རྣམས་ལ་སྦྱིན་བསམས༌སོ།།"]},{"type":"verse","number":9,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་སུ་ལའང་འོ་བརྒྱལ་མི་བཟོ་བའི༌ཕྱིར། ཁྱོད་ཅག་ལ་དཀོན་མཆོག་གི་འཕྲིན་བཟང་བསྒྲགས་པའི་དུས༌སུ། ངེད་རྣམས་ཀྱིས་འབད་བརྩོན་བྱས་ཤིང་དཀའ་སྡུག་མྱངས༌པ་དང་། ཉིན་མཚན་མེད་པར་ལས་ཀ་བསྒྲུབས་པ་བཅས་ནི་ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་བཟུང་ཡོད༌དོ།།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཅག་དད་ལྡན་རྣམས་ཀྱི་དྲུང་དུ་ངེད་ཅག་གི་སྤྱོད་ལམ་ནི་ཅི་འདྲའི་རྣམ་པར་དག༌པ་དང༌། གཞུང་དྲང༌། སྐྱོན་བརྗོད་རྒྱུ་མེད་པ་ཞིག་ཡིན་པར་ཁྱོད་ཅག་གིས་བདེན་དཔང་བྱས་ཆོག་ལ། དཀོན་མཆོག་གིས་ཀྱང་བདེན་དཔང་མཛད་ཆོག་གོ།"]},{"type":"verse","number":11,"content":["ཡང་ཕ་ཡིས་རང་གི་བུ་ཕྲུག་ལ་ཅི་ལྟར་བྱེད་པ༌བཞིན། ངེད་ཅག་གིས་ཇི་ལྟར་ཁྱོད་རྣམས་ལ་སྐུལ་སློང་དང་སེམས་གསོ་བྱས༌པ། ཁྱོད་ཅག་མི་རེ་རེར་ཇི་ལྟར་གདམས་པའང་ཁྱོད་རྣམས་ཀྱིས་ཤེས་སོ།།"]},{"type":"verse","number":12,"content":["དེ་ནི་ཁྱོད་ཅག་གི་སྤྱོད་ལམ་ནི་དཀོན་མཆོག་དང་མཐུན་འོས་པའི་ཕྱིར༌ཡིན། དཀོན་མཆོག་ནི་ཁྱོད་རྣམས་ཁོང་གི་རྒྱལ་སྲིད་དུ་ཞུགས་པ་དང་ཁོང་གི་གཟི་བརྗིད་འཐོབ་པར་ཞལ་འབོད་གནང་མཁན་ལགས༌སོ།།"]},{"type":"verse","number":13,"content":["དེའི༌ཕྱིར། ངེད་རྣམས་ཀྱིས་བསྒྲགས་པའི་དཀོན་མཆོག་གི་བཀའ་ནི་ཁྱོད་ཅག་གིས་ཐོས་ཤིང་དང་དུ་བླངས༌པས། ངེད་ཅག་གིས་ཀྱང་རྒྱུན་ཆད་མེད་པར་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་བ་དང་། ཁྱོད་རྣམས་ཀྱིས་བཀའ་དེ་ནི་མི་ཡི་ངག་ལྟར་དང་དུ་མ་བླངས༌པར། ཁྱོད་ཅག་དད་ལྡན་རྣམས་ཀྱི་སེམས་སུ་འཕྲིན་ལས་མཛད་པ་དང་དཀོན་མཆོག་གི་བཀའ་དངོས་ཡིན་པ་བཞིན་དང་དུ་བླངས་སོ།།"]},{"type":"verse","number":14,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཧུ་དཱའི་ཡུལ་དུ་གནས་ཤིང་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཡོད་པའི་དཀོན་མཆོག་གི་ཆོས་ཚོགས་སོ་སོར་ཡ་ཧུ་དཱ་པས་གནོད་འཚེ་བྱས་མྱོང་བ༌བཞིན། སྤུན་ཟླ་ཁྱོད་རྣམས་ལའང་རང་གི་ཡུལ་མི་རྣམས་ཀྱི་གནོད་འཚེ་ཐེབས་མྱོང༌བས། ཆོས་ཚོགས་དེ་དག་གི་དཔེ་རྣམས་ཁྱོད་ཅག་ལ་སྦྱར་བ་ཡིན།"]},{"type":"verse","number":15,"content":["ཡ་ཧུ་དཱ་པ་དེ་དག་གིས་གཙོ་བོ་ཡེ་ཤུ་དང་ལུང་སྟོན་པ་རྣམས་བཀྲོངས་ཤིང་ངེད་ཅག་ཀྱང་ཕྱི་རུ་བསྐྲད་པ༌དང༌། དཀོན་མཆོག་གི་ཐུགས་མཉེས་པར་མི་བྱེད་ཅིང་མི་ཐམས་ཅད་ལ་ངོ་རྒོལ་བྱེད་པ་རེད།"]},{"type":"verse","number":16,"content":["ཕྱི་ཕྱོགས་པ་རྣམས་ལ་ཐར་པ་འཐོབ་པའི་ཆེད༌དུ། ངེད་ཅག་གིས་དེ་རྣམས་ལ་ཆོས་བཤད་ཀྱང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་བཀག་འགོག་བྱེད༌པས། དེ་དག་གིས་རྒྱུན་དུ་སྡིག་པ་བསགས་ཤིང་སྡིག་པས་གང༌ངོ་།། འོན་ཀྱང་དཀོན་མཆོག་གི་ཐུགས་ཁྲོ་ཁོ་རྣམས་ཀྱི་སྟེང་དུ་ཡོངས་སུ་འཕོག་པར་གྱུར་ཏོ།།"]},{"type":"heading","content":["དད་ལྡན་རྣམས་ལ་འཕྲད་པར་རེ་སྨོན་བྱས༌པ།"]},{"type":"verse","number":17,"content":["སྤུན་ཟླ༌རྣམས། ངེད་རྣམས་རེ་ཞིག་ཁྱོད་ཅག་དང་ཁ་འབྲལ་དུ་བཅུག་པ་ནི་ལུས་སོ་སོར་བྲལ་བ་ལས་སེམས་སོ་སོར་བྲལ་བ་མིན༌ལ། ངེད་ཅག་གིས་གང་ནུས་ཅི་ཐུབ་སྒོས་ཐབས་བཙལ་ནས་ཁྱོད་ཅག་དང་འཕྲད་འདོད་ཤིན་ཏུ་ཆེ༌བས།"]},{"type":"verse","number":18,"content":["ངེད་རྣམས་ཁྱོད་ཅག་གི་གམ་དུ་ཡོང་འདོད༌དེ། ཕོལ་ལོལ་ང་རང་ཡང་ཡང་འགྲོ་རྩིས་བྱས༌མོད། འོན་ཀྱང་བདུད་སཱ་ཏན་གྱིས་ངེད་རྣམས་བཀག༌བྱུང༌།"]},{"type":"verse","number":19,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་ཕེབས་ཡོང་བའི་དུས༌སུ། ཁོང་གི་སྤྱན་སྔར་ངེད་ཅག་གི་འདུན་པ༌དང༌། དགའ༌སྤྲོ། གཙུག་རྒྱན་བཅས་ནི་ཅི་ཡིན་ཞེ༌ན། དེ་ནི་ཁྱོད་རྣམས་ཡིན་པ་ཤ་སྟག་གོ།"]},{"type":"verse","number":20,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་རྣམས་ནི་ངེད་ཅག་གི་གཟི་བརྗིད་དང་དགའ་སྤྲོ་ཡིན་པའི་ཕྱིར༌རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1TH/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1TH/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1TH/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}