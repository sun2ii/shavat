{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1TH","translationId":"bod_ntb","name":"ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་དང་པོ།","commonName":"ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་དང་པོ།","title":"༄༅། །ཐེ་སཱ་ལོ་ནེ་ཀེ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":52,"numberOfChapters":5,"sha256":"072ef5681e5ada2bb5b7f35bebbf916ccc0393b1c2ebbb51c064fe554bcacf83","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1TH/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/1TH/5.json","totalNumberOfVerses":89},"chapter":{"number":5,"content":[{"type":"heading","content":["གཙོ་བོའི་ཉིན་མོའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དུས་དང་ཟླ་ཚེས་ཀྱི་སྐོར་སྤུན་ཟླ་ཁྱོད་རྣམས་ལ་ཅི་ཡང་བྲི་མི་དགོས༌ཏེ།"]},{"type":"verse","number":2,"content":["མཚན་མོའི་དུས་སུ་རྐུན་པོ་ཇི་ལྟར་གློ་བུར་སླེབས་པ༌བཞིན། གཙོ་བོའི་ཉིན་མོའང་དེ་ལྟར་སླེབ་ངེས་པ་ཁྱོད་ཅག་གིས་གསལ་པོར་ཤེས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":3,"content":["མི་རྣམས་ཀྱིས་བདེ་འཇགས་ཡིན་ཞེས་སྨྲ་བའི་དུས༌སུ། བུད་མེད་མངལ་དང་ལྡན་པ་ལ་ན་ཟུག་འབྱུང་བ་བཞིན་དེ་རྣམས་ལ་འཕྲལ་དུ་ཆག་སྒོ་འབྱུང་ཞིང་དེ་ལས་གཏན་ནས་ཐར་མི་ནུས་སོ།།"]},{"type":"verse","number":4,"content":["འོན༌ཀྱང༌། སྤུན་ཟླ་ཁྱོད་རྣམས་ནི་མུན་པའི་ནང་དུ་མི་གནས༌པས། ཉིན་མོ་དེ་ནི་རྐུན་པོ་གློ་བུར་སླེབས་པ༌ལྟར་ཁྱོད་རྣམས་ཀྱི་སྟེང་དུ་སླེབ་པར་མི་འགྱུར།"]},{"type":"verse","number":5,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཅག་ཐམས་ཅད་ནི་འོད་ཟེར་དང་ཉིན་མོ་ལ་གཏོགས་པའི་མི་ཡིན་པ༌ལས། མཚན་མོ་དང་མུན་པར་གཏོགས་པའི་མི་མ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":6,"content":["དེ་བས་བདག་ཅག་མི་གཞན་དག་དང་འདྲ་བར་གཉིད་ལ་མི་ཤོར༌བར། རྟག་ཏུ་དོགས་ཟོན་དང་གཟབ་གཟབ་བྱ་འོས་པ་ཡིན།"]},{"type":"verse","number":7,"content":["རྒྱུ་མཚན་ནི་གཉིད་དུ་ལོག་པ་རྣམས་མཚན་མོར་གཉིད་ལ་ཡུར་བ༌དང༌། ཆང་གིས་བཟི་བ་རྣམས་ནི་མཚན་མོར་བཟི་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":8,"content":["འོན༌ཀྱང༌། བདག་ཅག་ནི་ཉིན་མོ་ལ་གཏོགས་པས་གཟབ་གཟབ་བྱེད་དགོས༌ཏེ། དད་པ་དང་བྱམས་པའི་བྲང་ཁྲབ་ལུས་ལ་གྱོན་པ༌དང༌། ཐར་པའི་རེ་སྨོན་གྱི་རྨོག་ཞྭ་མགོ་ལ་གྱོན་དགོས།"]},{"type":"verse","number":9,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་བདག་ཅག་ཁོང་གི་ཐུགས་ཁྲོ་མྱོང་བར་བསྐོས་པ་མ་ཡིན༌པར། གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་བརྒྱུད་ནས་ཐར་པ་འཐོབ་པར་བསྐོས་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":10,"content":["བདག་ཅག་གསོན་པོར་གནས་པའམ་ཚེ་ལས་འདས་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་དང་ལྷན་ཅིག་ཏུ་གནས་པར་འགྱུར་བའི་ཕྱིར། ཁོང་ནི་བདག་ཅག་གི་དོན་དུ་སྐུ་གྲོངས༌པའོ།།"]},{"type":"verse","number":11,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་དུས་རྒྱུན་ནང་བཞིན་ཕན་ཚུན་ལ་སེམས་གསོ་བྱེད་པ༌དང༌། ཕན་ཚུན་གྱི་དད་པ་ཇེ་བརྟན་དུ་གཏོང་བར་གྱིས༌ཤིག།"]},{"type":"heading","content":["མཇུག་མཐའི་གདམས༌པ།"]},{"type":"verse","number":12,"content":["སྤུན་ཟླ༌རྣམས། ངེད་ཅག་གིས་ཁྱོད་རྣམས་ལ་གདམས་པར༌བྱ་སྟེ། ཁྱོད་རྣམས་ཁྲོད་ཀྱི་ངལ་རྩོལ་བྱེད་མཁན་རྣམས་ལ་ཁྱོད་ཅག་གིས་བརྩི་བཀུར་བྱེད་དགོས༌ཤིང༌། དེ་རྣམས་ཀྱིས་གཙོ་བོའི་ཕྱོགས་ནས་ཁྱོད་རྣམས་ལ་འགོ་ཁྲིད་མཛད་པ་དང་བསླབ་བྱ་གནང༌བ་ཡིན་ནོ།།"]},{"type":"verse","number":13,"content":["ཡང་དེ་དག་གིས་ལས་ཀ་བྱེད་པའི༌ཕྱིར། ཁྱོད་ཅག་གིས་ཁོང་རྣམས་ལ་བྱམས་པ་བཅངས་ནས་ལྷག་ཏུ་བརྩི་བཀུར་བྱོས༌དང༌། ཡང་ཁྱོད་རྣམས་ཕན་ཚུན་འགྲིག་མཐུན་ཡོང་བར༌གྱིས།"]},{"type":"verse","number":14,"content":["ཡང་ངེད་ཅག་གིས་སྤུན་ཟླ་ཁྱོད་རྣམས་ལ་བསྐུལ་བར་བྱ༌སྟེ། འགྲིག་ལམ་མི་བརྩི་བ་དག་ལ་གདམས་པ་དང་། རེ་ཐག་ཆད་པ་རྣམས་ལ་སེམས་གསོ་བྱེད༌པ། གཉོམ་ཆུང་རྣམས་ལ་རོགས་རམ་དང་མི་ཐམས་ཅད་ལ་བཟོད་པ་བསྒོམ་དགོས་སོ།།"]},{"type":"verse","number":15,"content":["ཡང་ཁྱོད་ཅག་གིས་གཟབ་ནན་གྱིས༌ཏེ། མི་སུས་ཀྱང་ངན་ལན་ངན་འཇལ་བྱེད་མི་རུང༌ཞིང༌། ཁྱོད་ཅག་ཕན་ཚུན་བར༌དུའམ། ཡང་ན་རྟག་ཏུ་མི་གཞན་ཐམས་ཅད་ལ་ལས་བཟང་པོ་སྒྲུབ་པར་བརྩོན་དགོས༌སོ།།"]},{"type":"verse","number":16,"content":["ཡང་རྟག་ཏུ་དགའ་ཞིང་སྤྲོ་བར༌གྱིས།"]},{"type":"verse","number":17,"content":["རྒྱུན་ཆད་མེད་པར་གསོལ་བ་ཐོབས།"]},{"type":"verse","number":18,"content":["དོན་གང་ལ་ཕྲད་ནའང་བཀའ་དྲིན་ཞུ་དགོས། ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་དཀོན་མཆོག་གིས་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཁྱོད་རྣམས་ལ་མཛད་པའི་ཐུགས་དགོངས་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":19,"content":["ཡང་དམ་པའི་ཐུགས་ཉིད་ཞི་བར་མི༌བྱའོ།།"]},{"type":"verse","number":20,"content":["ཡང་ལུང་སྟོན་པ་རྣམས་ཀྱི་གསུང་གླེང་ལ་མཐོང་ཆུང་མི་བྱའོ།།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང༌། ཐམས་ཅད་ལ་ལེགས་པར་བརྟགས་ནས་བཟང་པོ་གང་ཡིན་པ་དེ་རྒྱུན་འཁྱོངས༌དང༌།"]},{"type":"verse","number":22,"content":["ལས་ངན་པ་ཐམས་ཅད་རྩ་བ་ནས་སྤང་བར༌གྱིས།"]},{"type":"verse","number":23,"content":["ཞི་བདེ་གནང་མཁན་དཀོན་མཆོག་གིས་སྐུ་དངོས་སུ་ཁྱོད་རྣམས་ཡོངས་སུ་དམ་པར་མཛད་པར༌སྨོན། ཡང་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ཕེབས་ཡོང་བའི་དུས༌སུ། ཁྱོད་ཅག་གི་སེམས་ཉིད༌དང་རྣམ༌ཤེས། ལུས་པོ་བཅས་ལ་སྐྱོན་ཅི་ཡང་མེད་པར་བསྲུང་བར༌སྨོན།"]},{"type":"verse","number":24,"content":["ཁྱོད་རྣམས་ལ་ཞལ་འབོད་གནང་མཁན་ནི་ཡིད་རྟོན་རུང་བ་ཡིན༌པས། ཁོང་གིས་དེ་བཞིན་དུ་མཛད་ངེས༌སོ།།"]},{"type":"verse","number":25,"content":["སྤུན་ཟླ་ཁྱོད་རྣམས་ཀྱིས་ངེད་ཅག་གི་དོན་དུ་གསོལ་བ་ཐོབས༌ཤིག"]},{"type":"verse","number":26,"content":["སྤུན་ཟླ་ཐམས་ཅད་ལ་དམ་པའི་འོ་བྱས་ནས་འཚམས་འདྲི་བྱེད་པར༌གྱིས།"]},{"type":"verse","number":27,"content":["ངས་གཙོ་བོ་ལ་བརྟེན་ནས་ཁྱོད་རྣམས་ལ་འཕྲིན་ཡིག་འདི་སྤུན་ཟླ་གཞན་ཐམས་ཅད་ལ་བཀླག་པར་གྱིས་ཞེས་བསྐུལ༌བའོ།།"]},{"type":"verse","number":28,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཐུགས་རྗེ་ནམ་ཡང་ཁྱོད་ཅག་དང་མཉམ་དུ་གནས་པར༌སྨོན།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1TH/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2TH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1TH/4.json","previousChapterAudioLinks":{},"numberOfVerses":28}