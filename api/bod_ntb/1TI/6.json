{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"1TI","translationId":"bod_ntb","name":"ཐི་མོ་ཐེ་དང་པོ།","commonName":"ཐི་མོ་ཐེ་དང་པོ།","title":"༄༅། །ཐི་མོ་ཐེ་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་དང་པོ།","order":54,"numberOfChapters":6,"sha256":"3bc7c7674255c747a4b85590f9713b048653cb21724fd081969e70b549e40029","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bod_ntb/1TI/6.json","totalNumberOfVerses":112},"chapter":{"number":6,"content":[{"type":"heading","content":["གཡོག་པོའི་སྐོར་ལ་གདམས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་གི་མཚན་དང་བསྟན་པ་ལ་སྐུར་བ་མི་འདེབས་པའི༌ཕྱིར། གཉའ་ཤིང་གི་འོག་ཏུ་ཡོད་པའི་གཡོག་པོ་ཐམས་ཅད་ཀྱིས་རང་རང་གི་བདག་པོ་རྣམས་ལ་ཕྱོགས་ཀུན་ནས་བརྩི་བཀུར་བྱེད་འོས་པར་རྩིས་ཤིག"]},{"type":"verse","number":2,"content":["གཡོག་པོ་སུ་ཞིག་ལ་དད་པ་དང་ལྡན་པའི་བདག་པོ་ཡོད༌ན། ཁོ་རང་སྤུན་ཟླ་ཡིན་པའི་དབང་གིས་བདག་པོར་མཐོང་ཆུང་མི་བྱེད༌པར། ཞབས་ཕྱི་ལས་ཕན་ཐོགས་པའི་བདག་པོ་རྣམས་ནི་དད་པ་ཅན་དང་གཅེས་སུ་འོས་པའི་མི་ཡིན༌པས། དེ་རྣམས་ལ་ལྷག་པར་ཞབས་ཕྱི་བསྒྲུབ་དགོས། ཁྱོད་ཀྱིས་དོན་དེ་རྣམས་མི་གཞན་དག་ལ་བསླབ་པ་དང་བསྐུལ་བར་བྱའོ།།"]},{"type":"heading","content":["རྒྱུ་ནོར་ལ་རྔམ་པའི་ལོག་ལྟ་ཅན་གྱི༌སྐོར།"]},{"type":"verse","number":3,"content":["གལ༌ཏེ། སུ་ཞིག་གིས་ལྟ་བ་མི་མཐུན་པ་བསྒྲགས་ནས་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཡང་དག་པའི་གསུང་དང་དད་གུས་དང་མཐུན་པའི་ཆོས་དེ་ཁས་མི་ལེན༌ན།"]},{"type":"verse","number":4,"content":["མི་དེ་ནི་ང་རྒྱལ་ཆེ་བ་དང་ཅི་ཡང་མི་ཤེས་ཤིང་ནན་འདྲི་བྱེད་པ་དང་ཁ་རྩོད་ཚིག་རྩོད་བྱེད་པ་ཁོ་ནར་དགའ་བ་ཞིག་ཡིན། དེ་ལས་ཕྲག་དོག༌དང༌། རྩོད༌པ། དམོད༌ཚིག དོགས་པ་ངན་པ་བཅས་འབྱུང་བ༌དང༌།"]},{"type":"verse","number":5,"content":["བསམ་པ་ངན་པར་གྱུར་ཅིང་བདེན་པ་ཉིད་དང་བྲལ་བའི་རྩོད་པའང་རྒྱུན་ཆད་མེད་པར་འབྱུང༌། མི་དེ་དག་གིས་དད་གུས་བྱེད་པ་ནི་རྒྱུ་ནོར་འཐོབ་པའི་ཐབས་ལམ་ཡིན་པར་བསམས་སོ།།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང༌། དད་གུས་བྱེད་པ་ལ་འདོད་ཆུང་ཆོག་ཤེས་ལྡན་ན་ཕན་ཐོགས་ཤིན་ཏུ་ཆེའོ།།"]},{"type":"verse","number":7,"content":["རྒྱུ་མཚན་ནི་བདག་ཅག་གིས་འཇིག་རྟེན་འདིར་ཅི་ཡང་ཁྱེར་མ་འོངས༌ལ། འཇིག་རྟེན་ནས་ཀྱང་ཅི་ཡང་འཁྱེར་མི་ནུས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":8,"content":["དེ་བས་ཁ་ལ་ཟས་དང་རྒྱབ་ལ་གོས་ཡོད་ན་ཡིད་ཚིམ་དགོས་སོ།།"]},{"type":"verse","number":9,"content":["འོན་ཀྱང༌། ཕྱུག་པོར་འགྱུར་འདོད་པ་རྣམས་ནི་ཉམས་ཚོད་དང་རྙི་རྒྱ་རུ་ཚུད༌པ་དང༌། བླུན་ཞིང་རྨོངས་པ་དང་གནོད་པ་ཆེ་བའི་འདོད་རྔམ་སྣ་ཚོགས་ཀྱི་ནང་དུ་ལྷུང་སྟེ་རང་ཉིད་བརླག་ཅིང་འཇིག་པར་འགྱུར་རོ།།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། རྒྱུ་ནོར་ལ་རྔམ་པ་ནི་ལས་ངན་པ་སྣ་ཚོགས་ཀྱི་འབྱུང་རྩ་ཡིན༌ལ། མི་ཁ་ཤས་རྒྱུ་ནོར་ལ་ཞེན་ཆགས་ཏེ་དད་པ་དང་ཁ་བྲལ་ནས་རང་གིས་རང་ཉིད་སྡུག་བསྔལ་མང་པོས་བརྟོལ་བར་བྱེད་པའི་ཕྱིར་རོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་ཐི་མོ་ཐེ་ལ་བསླབ་བྱ་གནང༌བ།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་། ཁྱོད་ནི་དཀོན་མཆོག་ལ་གཏོགས་པའི་མི་ཡིན་པས་གོང་གི་དོན་འདི་དག་དང་འབྲལ་བར༌གྱིས། དྲང་བདེན་དང་དད་གུས། དད་སེམས། བྱམས༌པ། བཟོད༌བསྲན། ཞི་དུལ་བཅས་བསྙེག་པར་བྱོས།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་དད་པའི་ཆེད་དུ་འཐབ་འཛིང་བཟང་པོ་བྱེད་པ་དང་། མཐའ་མེད་པའི་ཚེ་སྲོག་ཀྱང་གཟུང་བར་གྱིས་ཤིག ཁྱོད་ནི་དེའི་ཆེད་དུ་ཞལ་འབོད་གནང་བ༌དང༌། ཁྱོད་ཀྱིས་ཀྱང་དཔང་པོ་བྱེད་མཁན་མང་པོའི་ཁྲོད་ནས་བདེན་དཔང་བཟང་པོ་བྱས་མྱོང༌བ་ཡིན།"]},{"type":"verse","number":13,"content":["བདག་གིས་སྲོག་ལྡན་ཐམས་ཅད་ལ་ཚེ་སྲོག་གནང་མཁན་དཀོན་མཆོག་གི་སྤྱན་དྲུང༌དང༌། ཕོན་ཏིའུ་པི་ལ་ཏུའི་མདུན༌དུ་བདེན་དཔང་བཟང་པོ་མཛད་མྱོང་མཁན་མཱ་ཤི་ཀ་ཡེ་ཤུའི་སྤྱན་སྔ་ནས་ཁྱོད་ལ་གདམས་པར་བྱ༌སྟེ།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཀྱིས་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་མངོན་སུམ་དུ་ཕེབས་ཡོང་བའི་བར༌དུ། བཀའ་དེ་ལ་སྐྱོན་དང་དྲི་མས་མ་གོས་པར་བསྲུང་བར་བྱའོ།།"]},{"type":"verse","number":15,"content":["དུས་ལ་བབས༌པ་ན། དཀོན་མཆོག་གིས་ཐམས་ཅད་མངོན་པར་མཛད་ངེས༌ཡིན་ལ། དཀོན་མཆོག་ནི་བསྟོད་པར་འོས་པ༌དང༌། ཀུན་ལ་དབང་མཛད་མཁན་ཁོ་ན༌ཉིད། རྒྱལ་པོ་རྣམས་ཀྱི་རྒྱལ་པོ་དང་གཙོ་བོ་རྣམས་ཀྱི་གཙོ་བོ༌སྟེ།"]},{"type":"verse","number":16,"content":["ཁོང་ནི་ནམ་ཡང་འཆི་བ་མེད་པ་ཁོ་ན༌ཉིད། མི་རྣམས་ཉེ་སར་ཙམ་ཡང་འགྲོ་ཐབས་མེད་པའི་འོད་ཟེར་ནང་དུ་བཞུགས་པ༌དང༌། མི་སུས་ཀྱང་མཐོང་མ་མྱོང་ཞིང་མཐོང་ཡང་མི་ནུས་པ་དེ་ཉིད་ལགས་སོ།། ཁོང་ལ་བཀུར་བསྟི་དང་རྫོགས་མཐའ་མེད་པའི་མངའ་ཐང་ལྡན་པར༌ཤོག ཨ༌མེན།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་འཇིག་རྟེན་འདིར་ཕྱུག་པོ་ཡིན་པ་རྣམས་ལ་ང་རྒྱལ་མི་བྱེད་པ་དང་མི་རྟག་པའི་རྒྱུ་ནོར་ལ་བློ་མི་གཏོད༌པར། བདག་ཅག་ལ་རྒྱུ་ནོར་ལོངས་སྤྱོད་ཚད་མེད་གནང་མཁན་ཏེ་དཀོན་མཆོག་ཁོ་ནར་བརྟེན་འོས་པའི་བཀའ་བསྒོ་བར་བྱའོ།།"]},{"type":"verse","number":18,"content":["ཡང་ཁོ་རྣམས་ལ་ལས་བཟང་པོ་བྱེད་པ༌དང༌། དོན་བཟང་མང་དུ་བསྒྲུབ༌པ། གཏོང་ཕོད་ཆེ༌བ། མི་གཞན་ལ་སྦྱིན་པ་གཏོང་བར་དགའ་དགོས་པ་དང་།"]},{"type":"verse","number":19,"content":["དེ་བཞིན་དུ་ཚེ་སྲོག་དངོས་མ་དེ་ཉིད་འཛིན་པའི་ཕྱིར། རང་གི་ཆེད་དུ་མ་འོངས་པར་རྨང་གཞི་བརྟན་པོའི་ནོར་བུ་གསོག་དགོས་པ་བཅས་ཀྱི་བཀའ་བསྒོ་བར་བྱའོ།།"]},{"type":"verse","number":20,"content":["ཀྱེ། ཐི་མོ༌ཐེ། ཁྱོད་ལ་བཅོལ་ཞིང་གདམས་པ་རྣམས་བསྲུང་བར་བྱའོ།། འཇིག་རྟེན་གྱི་སྙིང་པོ་མེད་པའི་འཆལ་གཏམ༌དང༌། བདེན་པ་ཉིད་དང་འགལ་ཞིང་ཡོན་ཏན་དུ་རློམ་པའི་འཁྲུལ་ཤེས་བཅས་ལ་ཁ་འབྲལ་བར༌གྱིས།"]},{"type":"verse","number":21,"content":["མི་འགའ་ཞིག་གིས་རང་ཉིད་ལ་ཡོན་ཏན་དེ་ལྟ་བུ་ལྡན་པར་སྨྲ་ཞིང་དད་པ་དང་ཁ་བྲལ་བའོ།། ཐུགས་རྗེ་ནི་རྟག་ཏུ་ཁྱོད་ཅག་དང་མཉམ་དུ་གནས་པར༌སྨོན།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/1TI/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2TI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1TI/5.json","previousChapterAudioLinks":{},"numberOfVerses":21}