{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["དེ་ནས་རེ་ཧབ་ཨམ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་ནས་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གྱི་ཁྱིམ་རྒྱུད་བསྡུས་པ་སྟེ། བསྡོམས་པས་མི་ཆིག་འབུམ་བརྒྱད་ཁྲི་ཡོད་པ་ཐམས་ཅད་དམག་མི་དཔའ་རྩལ་ཅན་ཡིན་ལ། ཡེས་ར་ཨེལ་དང་འཐབ་ནས་རྒྱལ་སྲིད་ཕྱིར་བླངས་ཏེ་རང་ལ་འཐོབ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":2,"content":["ཡིན་ཡང་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཤེ་མ་ཡཱ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":3,"content":["ཁྱོད་སོང་ནས་སོ་ལོ་མོན་གྱི་སྲས་ཏེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རེ་ཧབ་ཨམ་དང་། ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་དུ་སྡོད་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་འདི་ལྟར་སྨྲོས་ཤིག"]},{"type":"verse","number":4,"content":["ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོ་ཡར་སོང་ནས་རང་གི་སྤུན་ཟླ་དང་དམག་རྒྱག་མི་རུང་། དོན་འདི་ནི་བདག་ལས་བྱུང་བ་ཡིན་པས། ཁྱོད་རྣམས་རང་རང་གི་ཁྱིམ་དུ་ལོག་ཅིག་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་པ་དང་། དེ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མཉན་ཏེ་ཡེ་རོབ་ཨམ་ལ་འཐབ་ཏུ་མ་སོང་ངོ་། །"]},{"type":"heading","content":["རེ་ཧབ་ཨམ་གྱིས་མཁར་རྣམས་བརྩིགས་པ།"]},{"type":"verse","number":5,"content":["རེ་ཧབ་ཨམ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས་ཤིང་ཡ་ཧུ་དཱ་ཡུལ་དུ་འགོག་སྲུང་གྲོང་ཁྱེར་མང་པོ་བརྩིགས་པ་སྟེ།"]},{"type":"verse","number":6,"content":["ཁོང་གིས་པེད་ལེ་ཧེམ་དང་ཨེ་ཏམ་དང་། ཐེ་ཀོ་ཨ་དང་།"]},{"type":"verse","number":7,"content":["པེད་ཚུར་དང་། སོ་ཀོ་དང་། ཨ་དུལ་ལཱམ་དང་།"]},{"type":"verse","number":8,"content":["གཱད་དང་། མཱ་རེ་ཤ་དང་། ཟིབ་དང་།"]},{"type":"verse","number":9,"content":["ཨ་དོ་རཱ་ཡིམ་དང་། ལཱ་ཀི་སི་དང་། ཨ་ཟེ་ཀཱ་དང་།"]},{"type":"verse","number":10,"content":["ཚོར་ཨ་དང་། ཨ་ཡཱ་ལོན་དང་། ཧེབ་རོན་བཅས་བརྩིགས་ཏེ། དེ་ཐམས་ཅད་ནི་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གྱི་འགོག་སྲུང་གྲོང་ཁྱེར་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["ཡང་རེ་ཧབ་ཨམ་གྱིས་འགོག་སྲུང་གྲོང་ཁྱེར་དེ་རྣམས་བརྟན་པོར་བྱས་ཤིང་། དེ་དག་གི་ནང་དུ་དམག་དཔོན་བཞག་པ་དང་། རྒྱགས་ཆས་དང་སྣུམ། རྒུན་ཆང་བཅས་གྲ་སྒྲིག་བྱས་པ་རེད།"]},{"type":"verse","number":12,"content":["གྲོང་ཁྱེར་སོ་སོའི་ནང་དུ་ཕུབ་ཆེན་དང་མདུང་གྲ་སྒྲིག་བྱས་ནས་གྲོང་ཁྱེར་རབ་ཏུ་བརྟན་པོར་བྱས། དེ་བཞིན་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གཉིས་ལ་ཁོང་གིས་དབང་སྒྱུར་བའོ། །"]},{"type":"heading","content":["རེ་ཧབ་ཨམ་གྱི་ཁྱིམ་གཞིས།"]},{"type":"verse","number":13,"content":["ཡེས་ར་ཨེལ་ཡོངས་ཀྱི་མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཡུལ་སོ་སོ་ནས་རེ་ཧབ་ཨམ་གྱི་ཕྱོགས་སུ་འོངས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཡེ་རོབ་ཨམ་དང་དེའི་བུ་རྣམས་ཀྱིས་ལེ་ཝི་པ་རྣམས་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མཆོད་དཔོན་གྱི་ཞབས་ཏོག་བྱེད་དུ་མ་བཅུག་པར་ཕྱིར་བཏོན་པས། དེ་དག་གིས་རང་གི་རྩྭ་ར་དང་ནོར་སྐལ་སྤངས་ཏེ་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས།"]},{"type":"verse","number":15,"content":["ཡེ་རོབ་ཨམ་གྱིས་མཐོ་གླིང་དང་། ར་ཕོའི་རྟེན་དང་། ཁོས་བཟོས་པའི་བ་ཕྲུག་རྣམས་ཀྱི་ཕྱིར་མཆོད་དཔོན་བཞག་པ་དང་།"]},{"type":"verse","number":16,"content":["ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཁག་ལས་སེམས་བསམ་པས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་བཙལ་འདོད་པ་རྣམས་ནི། ལེ་ཝི་པའི་རྗེས་སུ་འབྲངས་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡ་ཝཱེ་སྟེ་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ལ་མཆོད་པ་འབུལ་དུ་འོངས།"]},{"type":"verse","number":17,"content":["དེ་བཞིན་ཁོ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་རྒྱལ་སྲིད་ཤུགས་ཆེ་རུ་བཏང་ཞིང་། སོ་ལོ་མོན་གྱི་སྲས་རེ་ཧབ་ཨམ་ལོ་གསུམ་གྱི་རིང་ལ་ཤིན་ཏུ་དར་བར་བྱས། ཅིའི་ཕྱིར་ཞེ་ན། ལོ་གསུམ་པོ་དེའི་རིང་ལ་ཁོ་རྣམས་དཱ་བིད་དང་སོ་ལོ་མོན་གྱི་ལམ་དུ་འབྲངས་སོ། །"]},{"type":"verse","number":18,"content":["རེ་ཧབ་ཨམ་གྱིས་དཱ་བིད་ཀྱི་སྲས་ཡེ་རི་མོད་ཀྱི་སྲས་མོ་མཱ་ཧ་ལད་བྱ་བ་ཁབ་ཏུ་བཞེས། ཡང་མོ་ནི་ཡེ་སེ་ཡི་སྲས་ཨེ་ལི་ཨབ་ཀྱི་སྲས་མོ་ཨ་བི་ཧ་ཡིལ་གྱི་སྲས་མོ་ཡིན་ནོ། །"]},{"type":"verse","number":19,"content":["མཱ་ཧ་ལད་ལས་རེ་ཧབ་ཨམ་ལ་སྲས་འགའ་ཞིག་འཁྲུངས་པ་ནི། ཡེ་ཨུ་སི་དང་། ཤེ་མར་ཡཱ་དང་། ཟཱ་ཧམ་བཅས་སོ། །"]},{"type":"verse","number":20,"content":["དེའི་རྗེས་སུ་རེ་ཧབ་ཨམ་གྱིས་ཡང་ཨབ་ཤ་ལོམ་གྱི་བུ་མོ་མ་ཨ་ཀཱ་བླངས་པ་དང་། དེ་ལས་ཁོང་ལ་སྲས་ཨ་བི་ཡཱ་དང་། ཨད་ཐ་ཨི་དང་། ཟི་ཟཱ་དང་། ཤེ་ལོ་མིད་བཅས་འཁྲུངས།"]},{"type":"verse","number":21,"content":["རེ་ཧབ་ཨམ་ལ་ཆུང་མ་བཅོ་བརྒྱད་དང་ཆུན་མ་དྲུག་ཅུ་ཡོད་དེ། དེ་རྣམས་ལས་སྲས་ཉེར་བརྒྱད་དང་སྲས་མོ་དྲུག་ཅུ་འཁྲུངས། ཁོང་གིས་ཨབ་ཤ་ལོམ་གྱི་སྲས་མོ་མ་ཨ་ཀཱ་ནི་ཆུང་མ་དང་ཆུན་མ་གཞན་རྣམས་ལས་གཅེས་སུ་བཟུང་པ་ཡིན།"]},{"type":"verse","number":22,"content":["རེ་ཧབ་ཨམ་གྱིས་མ་ཨ་ཀཱའི་སྲས་ཨ་བི་ཡཱ་བྱ་བ་དེ་རྒྱལ་ཁྲིར་འགོད་འདོད་པས། དེ་ཁོའི་སྤུན་རྣམས་ཀྱི་འགོ་དཔོན་བྱེད་ཆེད་རྒྱལ་སྲས་སུ་བཞག་ནས།"]},{"type":"verse","number":23,"content":["རེ་ཧབ་ཨམ་གྱིས་ཤེས་རབ་ལྡན་པའི་སྒོ་ནས་རང་གི་སྲས་རྣམས་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གྱི་འགོག་སྲུང་གྲོང་ཁྱེར་སོ་སོར་བཞག་ནས། དེ་དག་ལ་རྒྱགས་ཆས་མོད་པོ་བཏང་ཞིང་ཆུང་མའང་མང་པོ་བླངས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/10.json","previousChapterAudioLinks":{},"numberOfVerses":23}