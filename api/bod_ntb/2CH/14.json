{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":14,"content":[{"type":"heading","content":["ཨ་སཱ་ཁོང་ཉིད་ཡ་ཧུ་དཱའི་རྒྱལ་པོར་བཞུགས་པ།"]},{"type":"verse","number":1,"content":["ཨ་བི་ཡཱ་རང་གི་ཕ་མེས་དང་ལྷན་ཅིག་གཟིམས་པ་དང་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་དུར་ལ་སྦས། ཁོང་གི་སྲས་ཨ་སཱ་ཁོང་གི་ཚབ་ཏུ་རྒྱལ་པོར་གྱུར། ཁོང་གི་སྐུ་རིང་ལ་ལོ་བཅུའི་རིང་ཡུལ་དེར་དུས་བདེ་བར་གྱུར།"]},{"type":"verse","number":2,"content":["ཨ་སཱ་ཡིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་དྲུང་དུ་གང་ཞིག་ལེགས་ཤིང་བདེན་པ་དེ་སྤྱད་ནས།"]},{"type":"verse","number":3,"content":["ཕྱི་རོལ་པའི་མཆོད་ཁྲི་དང་མཐོ་གླིང་རྣམས་མེད་པར་བཟོས་ཤིང་། རྡོ་སྐུ་རྣམས་བཅག་པ་དང་ཨ་ཤེ་རཱའི་ཀ་བ་",{"noteId":4},"རྣམས་བཅད་དེ།"]},{"type":"verse","number":4,"content":["ཡ་ཧུ་དཱ་པ་རྣམས་ལ་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་འཚོལ་བ་དང་། ཁོང་གི་བཀའ་ཁྲིམས་དང་བཀའ་རྒྱ་རྣམས་བསྲུང་དགོས་པའི་བཀའ་བསྩལ།"]},{"type":"verse","number":5,"content":["ཡང་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་སོ་སོ་ནས་མཐོ་གླིང་དང་སྤོས་ཁྲི་རྣམས་མེད་པར་བྱས་པ་དང་། དེའི་དུས་སུ་རྒྱལ་ཁམས་ཡོངས་ཁོང་གི་དབང་འོག་ཏུ་དུས་བདེ་བར་གྱུར།"]},{"type":"verse","number":6,"content":["ཁོང་གིས་ཡ་ཧུ་དཱ་རུ་འགོག་སྲུང་གྲོང་ཁྱེར་འགའ་ཡང་བརྩིགས། གང་ལ་ཞེ་ན། རྒྱལ་ཁབ་དེ་དུས་བདེ་ཞིང་ལོ་མང་པོར་དམག་འཁྲུག་མ་བྱུང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་བདེ་ལ་བཀོད་པས་སོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ཁོང་གིས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འདི་ལྟར། རང་ཅག་གིས་གྲོང་ཁྱེར་འདི་རྣམས་བརྩིག་དགོས་ལ། དེའི་ཕྱོགས་བཞི་རུ་ལྕགས་རི་བསྐོར་ནས་མཁར་ལྕོག་བཟོ་བ་དང་། མཁར་སྒོ་འཛུགས་པ། སྒོ་གཏན་འཛུགས་པར་བྱ་དགོས། རང་ཅག་གིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་བཙལ་བས། ཡུལ་འདི་ད་དུང་རང་ཅག་ལ་གཏོགས་པ་དང་། རང་ཅག་གིས་ཁོང་བཙལ་བས་ཁོང་གིས་རང་ཅག་ཕྱོགས་ཀུན་ནས་བདེ་ལ་བཀོད་པའོ་ཞེས་གསུངས་ཤིང་། དེ་དག་གིས་བརྩིགས་ཏེ་དོན་ཀུན་འགྲུབ་པར་གྱུར།"]},{"type":"verse","number":8,"content":["ཨ་སཱའི་དམག་དཔུང་ལ་ཕུབ་ཆེན་དང་མདུང་ཐོགས་མཁན་ཡ་ཧུ་དཱ་པ་བསྡོམས་པས་ཁྲི་སུམ་ཅུ་ཡོད་པ་དང་། ཕུབ་ཆུང་ཐོགས་པ་དང་གཞུ་འཐེན་མཁན་པེན་ཡཱ་མེན་པ་བསྡོམས་པས་ཁྲི་ཉེར་བརྒྱད་ཡོད་ལ། དེ་ཐམས་ཅད་ནི་དམག་མི་དཔའ་རྩལ་ཅན་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["དེའི་དུས་སུ་གུ་ཤ་པ་ཟེ་རག་གིས་དམག་མི་ཁྲི་བརྒྱ་དང་ཤིང་རྟ་སུམ་བརྒྱ་ཁྲིད་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འཐབ་པའི་ཕྱིར་མཱ་རེ་ཤ་རུ་འོངས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཨ་སཱ་དེའི་ཕྱོགས་སུ་ཆས་ཏེ། མཱ་རེ་ཤའི་ཙེ་ཕཱ་ཏ་བྱ་བའི་ལུང་པ་རུ་ཕན་ཚུན་དམག་བཀྲམས།"]},{"type":"verse","number":11,"content":["ཨ་སཱ་ཡིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ནས་འདི་ལྟར། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། སྟོབས་ཆུང་རྣམས་ལ་རོགས་རམ་གནང་ནས་མཐུ་ལྡན་དག་ལས་རྒྱལ་བར་མཛད་མཁན་ནི་ཁྱེད་ལས་གཞན་མེད། ཀྱེ་ཡ་ཝཱེ་ངེད་ཅག་གི་དཀོན་མཆོག་ལགས། ཁྱེད་ཀྱིས་ངེད་ཅག་ལ་རོགས་རམ་གནང་བར་མཛོད། གང་ལ་ཞེ་ན། ངེད་རྣམས་ཁྱེད་ལ་བརྟེན་ཞིང་ཁྱེད་ཀྱི་མཚན་བརྗོད་བཞིན་དམག་དཔུང་འདི་ལ་འཐབ་ཏུ་འགྲོ་བས། ཀྱེ་ཡ་ཝཱེ་ཁྱེད་ནི་ངེད་ཅག་གི་དཀོན་མཆོག་ཡིན་ལ། འགྲོ་བ་མིའི་རིགས་ཁྱེད་ལས་རྒྱལ་བར་མི་འཇུག་པར་མཛོད་ཅེས་ཞུས་པས།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་སཱ་དང་ཡ་ཧུ་དཱ་པའི་མདུན་དུ་གུ་ཤ་པ་རྣམས་ཕམ་པར་མཛད་ནས་དེ་རྣམས་བྲོས་སོ། །"]},{"type":"verse","number":13,"content":["ཨ་སཱ་དང་ཁོང་གི་རྗེས་སུ་འབྲངས་པའི་མི་རྣམས་ཀྱིས་དེ་དག་གེ་རཱར་བར་དུ་བདས། གུ་ཤ་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁོང་གི་དམག་དཔུང་གི་དྲུང་དུ་ཕམ་པས། ཁོ་རྣམས་ལས་ཤིན་ཏུ་མང་པོ་བསད་ནས་ཡང་བསྐྱར་སྟོབས་ཤུགས་རྒྱས་མ་ནུས། ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་བཅོམ་ནོར་ཤིན་ཏུ་མང་པོ་ཕྲོགས།"]},{"type":"verse","number":14,"content":["ཡང་དེ་དག་གིས་གེ་རཱར་མཐའ་འཁོར་གྱི་གྲོང་ཚོ་ཡོངས་རྫོགས་བཅོམ་པ་སྟེ། རྒྱུ་མཚན་ནི་གྲོང་ཚོ་སོ་སོའི་མི་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འཇིགས་པས་སོ། །ཡང་གྲོང་ཚོ་ནང་གི་རྒྱུ་ནོར་དཔག་ཏུ་མེད་པས་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་གྲོང་ཚོ་སོ་སོ་ཡོངས་སུ་ཕྲོགས།"]},{"type":"verse","number":15,"content":["དེར་མ་ཟད་ཁོ་རྣམས་ཀྱིས་ཕྱུགས་ར་རྣམས་ཀྱང་བཤིགས་ནས་ལུག་དང་རྔ་མོང་མོད་པོ་ཁྲིད་དེ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་གོ །"]}],"footnotes":[{"noteId":4,"caller":"+","text":"འདིར་ཨ་ཤེ་རཱའི་ཀ་བ་ཞེས་པ་ནི་ཤིང་གི་ཀ་བ་ཞིག་སྟེ་ལྷ་མོ་ཨ་ཤེ་རཱའི་རྟགས་མཚན་ཡིན།","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/2CH/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/13.json","previousChapterAudioLinks":{},"numberOfVerses":15}