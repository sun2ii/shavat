{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":22,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟི་ཡཱ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡེ་རུ་སཱ་ལེམ་པ་རྣམས་ཀྱིས་ཡེ་ཧོ་རཱམ་གྱི་བུ་ཐ་ཆུང་ཨ་ཧ་ཟི་ཡཱ་ཁོའི་ཚབ་ཏུ་རྒྱལ་པོར་བཞག་པ་རེད། གང་ལ་ཞེ་ན། དེའི་ཕུ་བོ་ཐམས་ཅད་ནི་ཨ་རབ་པ་དང་ལྷན་ཅིག་ཏུ་དམག་སྒར་ལ་དཔུང་འཇུག་བྱེད་དུ་འོངས་པ་དག་གིས་བསད་པའི་རྐྱེན་གྱིས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་གྱི་བུ་ཨ་ཧ་ཟི་ཡཱ་རྒྱལ་པོར་བསྡད་པ་རེད།"]},{"type":"verse","number":2,"content":["ཨ་ཧ་ཟི་ཡཱ་ཡིས་རྒྱལ་སྲིད་བཟུང་དུས་ཁོ་ལོ་ཉེར་གཉིས་ལ་སོན་ཡོད་དེ། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་གཅིག་རིང་རྒྱལ་སྲིད་བསྐྱངས། ཁོའི་ཡུམ་ནི་ཨོམ་རིའི་ཚ་མོ་",{"noteId":5},"ཨ་ཐལ་ཡཱ་བྱ་བའོ། །"]},{"type":"verse","number":3,"content":["ཨ་ཧ་ཟི་ཡཱ་ཡི་ཡུམ་གྱིས་ཁོ་ལ་ངན་པ་སྤྱོད་པར་བསྐུལ་བའི་རྐྱེན་གྱིས། ཁོ་ཡང་ཨ་ཧབ་ཁྱིམ་རྒྱུད་ཀྱི་ལམ་དུ་ཞུགས།"]},{"type":"verse","number":4,"content":["དེ་ལྟར་ཁོས་ཨ་ཧབ་ཀྱི་ཁྱིམ་རྒྱུད་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད། གང་ལ་ཞེ་ན། ཁོའི་ཕ་ཚེ་ལས་འདས་རྗེས། དེ་དག་གིས་ཁོ་རང་མེད་པར་འགྲོ་བའི་ཕྱིར་ཁོ་ལ་གྲོས་ངན་བཏབ་པ་རེད།"]},{"type":"verse","number":5,"content":["ཁོས་དེ་དག་གི་གྲོས་ངན་དང་བསྟུན་ནས། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་དང་མཉམ་དུ་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་དང་འཐབ་ཏུ་གིལ་ཨད་ཀྱི་རཱ་མོད་དུ་ཕྱིན། དེར་ཨ་རམ་པས་ཡོ་རཱམ་རྨས་པ་རེད།"]},{"type":"verse","number":6,"content":["དེར་ཡོ་རཱམ་ནི་རཱ་མ་དུ་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་དང་འཐབ་པའི་དུས་སུ་ཕོགས་པའི་རྨ་ཁར་སྨན་བཅོས་བྱེད་དུ་ཡེ་སི་རེ་ཨེལ་དུ་ལོག་འོངས་པ་ལ། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་གྱི་སྲས་ཨ་ཧ་ཟི་ཡཱ་ནི་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་ལ་རྨས་ཕོག་པས་ན་ཁོ་ལ་བལྟ་རུ་ཡེ་སི་རེ་ཨེལ་ལ་ཕྱིན་པ་རེད།"]},{"type":"verse","number":7,"content":["ཨ་ཧ་ཟི་ཡཱ་ཁོ་རང་ཡོ་རཱམ་ལ་བལྟ་རུ་ཕྱིན་པ་དང་འཆི་བར་གྱུར་ཅིང་དེ་ནི་དཀོན་མཆོག་ལས་བྱུང་། ཅིའི་ཕྱིར་ཞེ་ན། ཁོ་རང་ཡོ་རཱམ་གྱི་རྩར་སླེབས་པ་དང་། ཡོ་རཱམ་དང་མཉམ་དུ་སོང་ནས་ནིམ་ཤིའི་ཚ་བོ་ཡེ་ཧུ་བསུ་བ་རེད། ཡེ་ཧུ་ཞེས་པ་འདི་ནི་ཨ་ཧབ་ཀྱི་ཁྱིམ་རྒྱུད་ཚར་གཅོད་པའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་སྣུམ་གྱིས་བྱུགས་པའོ། །",{"noteId":6}]},{"type":"verse","number":8,"content":["ཡེ་ཧུས་ཨ་ཧབ་ཀྱི་ཁྱིམ་རྒྱུད་ལ་ཉེས་ཆད་གཅོད་པའི་དུས་སུ། ཡ་ཧུ་དཱའི་འགོ་དཔོན་རྣམས་དང་ཨ་ཧ་ཟི་ཡཱའི་ཚ་བོ་དག་ལ་ཕྲད་ཅིང་། དེ་ཐམས་ཅད་ཨ་ཧ་ཟི་ཡཱ་ལ་ཞབས་ཏོག་སྒྲུབ་མཁན་ཡིན་ལ། ཡེ་ཧུས་དེ་ཐམས་ཅད་ཀྱི་སྲོག་བཅད།"]},{"type":"verse","number":9,"content":["ཡེ་ཧུ་ཡིས་ཨ་ཧ་ཟི་ཡཱ་བཙལ་བ་དང་། ཨ་ཧ་ཟི་ཡཱ་ནི་སཱ་མར་ཡ་རུ་ཡིབ་ནས་བསྡད་ཀྱང་། མི་རྣམས་ཀྱིས་ཁོ་བཟུང་ནས་ཡེ་ཧུའི་དྲུང་དུ་ཁྲིད་ཅིང་ཁོ་བསད་དེ་དུར་དུ་སྦས་སོ། །ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གིས་འདི་ནི་ཡེ་ཧོ་ཤ་ཕད་ཀྱི་བུ་རྒྱུད་ཡིན་ལ། ཡེ་ཧོ་ཤ་ཕད་ནི་སེམས་ཧྲིལ་པོས་དཀོན་མཆོག་ཡ་ཝཱེ་འཚོལ་མཁན་ཡིན་ཞེས་སྨྲས་པས་སོ། །ཨ་ཧ་ཟི་ཡཱ་ཁྱིམ་རྒྱུད་ལས་རྒྱལ་སྲིད་འཛིན་ཐུབ་པ་གང་ཡང་མ་རྙེད་དོ། །"]},{"type":"heading","content":["ཨ་ཐལ་ཡཱས་རྒྱལ་སྲིད་ཕྲོགས་པ།"]},{"type":"verse","number":10,"content":["དེར་ཨ་ཧ་ཟི་ཡཱའི་མ་ཡུམ་ཨ་ཐལ་ཡཱ་ཡིས་རང་གི་བུ་ཤི་ཟིན་པ་མཐོང་བ་དང་། ལངས་ནས་ཡ་ཧུ་དཱ་ཁྱིམ་རྒྱུད་ཀྱི་རྒྱལ་སྲས་ཐམས་ཅད་བསད།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་རྒྱལ་པོའི་སྲས་མོ་ཡོ་ཤ་བེ་ཨད་ཀྱིས་ཨ་ཧ་ཟི་ཡཱའི་སྲས་ཡོ་ཨ་སི་བྱ་བ་དེ་གསོད་པར་འགྱུར་བའི་རྒྱལ་སྲས་ཁྲོད་ནས་བརྐུས་ཁྱེར་ཏེ། ཁོ་དང་ཁོའི་མ་མ་གཉིས་པོ་གཟིམས་ཆུང་ཞིག་གི་ནང་དུ་སྦས། ཡེ་ཧོ་རཱམ་རྒྱལ་པོའི་སྲས་མོ་ཡོ་ཤ་བེ་ཨད་ནི་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱའི་ཆུང་མ་ཡིན་ནོ། །ཡང་མོ་ནི་ཨ་ཧ་ཟི་ཡཱ་ཡི་གཅུང་མོ་ཡིན་པས། ཡོ་ཨ་སི་ནི་ཨ་ཐལ་ཡཱ་ཡིས་མི་གསོད་པའི་ཕྱིར་སྦས་ཏེ་བཞག་པའོ། །"]},{"type":"verse","number":12,"content":["ཡོ་ཨ་སི་དེ་རྣམས་དང་མཉམ་དུ་དཀོན་མཆོག་གི་མཆོད་ཁང་ནང་དུ་ལོ་དྲུག་ལ་ཡིབ་ནས་བསྡད། སྐབས་དེར་ཨ་ཐལ་ཡཱས་ཡ་ཧུ་དཱ་རུ་རྒྱལ་སྲིད་བསྐྱངས་པ་ཡིན།"]}],"footnotes":[{"noteId":5,"caller":"+","text":"ཡེས་ར་ཨེལ་གྱི་སྐད་ཡིག་ཏུ་ཨོམ་རིའི་བུ་མོ་ཞེས་བྲིས་ཡོད། ཨོམ་རིའི་ཚ་མོ་དང་རིགས་རྒྱུད་གཅིག་ཡིན། ཁོ་མོ་ནི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་བུ་མོ་དང་ཨོམ་རི་ཡི་ཚ་མོ་ཡིན།","reference":{"chapter":22,"verse":2}},{"noteId":6,"caller":"+","text":"དཀོན་མཆོག་ཡ་ཝཱེས་ལུང་སྟོན་པ་ཨེ་ལི་ཤཱ་མངགས་ནས་ཡེ་ཧུ་ཞེས་པ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བྱུགས་པ་ཡིན།","reference":{"chapter":22,"verse":7}}]},"thisChapterLink":"/api/bod_ntb/2CH/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/21.json","previousChapterAudioLinks":{},"numberOfVerses":12}