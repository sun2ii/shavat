{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":24,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི།"]},{"type":"verse","number":1,"content":["ཡོ་ཨ་སི་རྒྱལ་པོར་བཞུགས་དུས་སུ་དགུང་ལོ་བདུན་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་བཞི་བཅུའི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། དེའི་ཡུམ་གྱི་མིང་ལ་ཙིབ་ཡཱ་ཟེར་ཏེ་པེར་ཤ་བཱ་ཞེས་པའི་གྲོང་ཁྱེར་གྱི་མི་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱའི་ཉིན་མོ་རྣམས་ལ། ཡོ་ཨ་སི་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་པ་ཡིན།"]},{"type":"verse","number":3,"content":["ཡེ་ཧོ་ཡ་དཱས་དེ་ལ་བཙུན་མོ་གཉིས་བླངས་པ་དང་སྲས་དང་སྲས་མོ་རྣམས་འཁྲུངས།"]},{"type":"verse","number":4,"content":["དེའི་རྗེས་སུ་ཡོ་ཨ་སི་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་གསོ་བྱེད་འདོད་ནས།"]},{"type":"verse","number":5,"content":["མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་བསྡུས་ནས་དེ་དག་ལ་ན་རེ། ཁྱོད་རྣམས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ཀུན་ཏུ་སོང་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་ལོ་རེ་བཞིན་ཞིག་གསོ་བྱེད་དུ་དེ་རྣམས་ལས་དངུལ་བསྡུས་ཤིག ལས་ཀ་འདི་གང་མྱུར་སྒོས་སྒྲུབས་ཤིག་ཅེས་བསྒོས་ན་ཡང་། ལེ་ཝི་པས་མྱུར་དུ་མ་བསྒྲུབས་པ་དང་།"]},{"type":"verse","number":6,"content":["རྒྱལ་པོས་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱ་བོས་ནས་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་མོ་ཤེ་དང་ཡེས་ར་ཨེལ་ཚོགས་སྤྱིས་དཔང་པོའི་གུར་མཆོག་གི་ཕྱིར་གཏན་ལ་ཁེལ་བའི་ཁྲལ་དེ་ནི། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་ནས་བསྡུ་བར་ཁྱོད་ཀྱིས་ལེ་ཝི་པ་རྣམས་ལ་ཅིའི་ཕྱིར་མ་བསྒོས་སམ་ཞེས་དྲིས་སོ། །"]},{"type":"verse","number":7,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བུད་མེད་ངན་པ་ཨ་ཐལ་ཡཱའི་བུ་རྣམས་སྔར་དཀོན་མཆོག་གི་མཆོད་ཁང་ནང་དུ་བཙན་གྱིས་འཛུལ་ནས། དེའི་ནང་གི་རྫས་དམ་པ་ཐམས་ཅད་ཀྱིས་པཱ་ཨལ་ལ་གསོལ་མཆོད་ཕུལ་བ་རེད།"]},{"type":"verse","number":8,"content":["དེའི་ཕྱིར་དེ་དག་གིས་རྒྱལ་པོའི་བཀའ་བཞིན་དུ་སྒྲོམ་ཞིག་བཟོས་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་སྒོའི་ཕྱི་རོལ་ཏུ་བཞག་ཅིང་།"]},{"type":"verse","number":9,"content":["ཡང་དཀོན་མཆོག་གི་ཞབས་ཕྱི་མོ་ཤེས་དབེན་སྟོང་དུ་ཡེས་ར་ཨེལ་ལ་བཀལ་བའི་ཁྲལ་དེ་ཁྱེར་འོངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་བའི་ཕྱིར། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་དུ་བརྡ་ཁྱབ་བཏང་བ་དང་།"]},{"type":"verse","number":10,"content":["འགོ་དཔོན་རྣམས་དང་མི་ཡོངས་ཀྱིས་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་དངུལ་ཁྱེར་འོངས་ནས་སྒྲོམ་དེ་གང་བའི་བར་དུ་ཕུལ་ཏོ། །"]},{"type":"verse","number":11,"content":["ཡང་དངུལ་གྱི་སྒྲོམ་དེ་ལེ་ཝི་པས་ཁྱེར་ནས་རྒྱལ་པོའི་ལས་སྣེ་པའི་རྩར་སླེབས་དུས་སུ། དེའི་ནང་དུ་དངུལ་མང་པོ་ཡོད་པ་མཐོང་སྟེ། རྒྱལ་པོའི་དྲུང་ཡིག་དང་། མཆོད་དཔོན་ཆེན་པོའི་ཞིབ་དཔྱོད་པ་འོངས་ནས་སྒྲོམ་དེ་སྟོང་བར་ཕུད་པ་དང་། ཡང་ཕྱིར་རང་གནས་སུ་བཞག ཉིན་རེ་བཞིན་དེ་ལྟར་བྱས་ནས། དངུལ་ཤིན་ཏུ་མང་པོ་བསྡུས་པ་རེད།"]},{"type":"verse","number":12,"content":["རྒྱལ་པོ་དང་ཡེ་ཧོ་ཡ་དཱ་གཉིས་ཀྱིས་དངུལ་དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཞབས་ཏོག་སྒྲུབ་མཁན་རྣམས་ལ་སྤྲད་ནས། དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་གསོ་བྱེད་ཆེད་རྡོ་བཟོ་དང་ཤིང་བཟོ་གླས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་གསོ་བྱེད་པའི་ལྕགས་བཟོ་དང་ལི་བཟོ་ཡང་གླས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["དེ་ལྟར་ལག་ཤེས་པ་རྣམས་ཀྱིས་ལས་ཀ་བྱས་ཏེ་ཞིག་གསོའི་ཨར་ལས་རིམ་བཞིན་གྲུབ་ཅིང་། དཀོན་མཆོག་གི་མཆོད་ཁང་ནི་སྔོན་ཆད་བཞིན་ཞིག་གསོ་བྱས་པར་མ་ཟད་ཧ་ཅང་བརྟན་པོར་གྱུར་ཏོ། །"]},{"type":"verse","number":14,"content":["ཡང་དེ་དག་གིས་ལས་ཀ་བསྒྲུབས་ཚར་རྗེས། དངུལ་འཕྲོ་མ་རྣམས་རྒྱལ་པོ་དང་ཡེ་ཧོ་ཡ་དཱ་གཉིས་ལ་སྤྲད་པ་དང་། དེ་ལས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་གི་ཡོ་བྱད་དང་། ཞབས་ཏོག་སྒྲུབ་བྱེད་དང་མཆོད་པ་འབུལ་བྱེད་ཡོ་བྱད་དང་། སྡེར་མ་དང་། གསེར་དངུལ་གྱི་ཡོ་བྱད་སྣ་ཚོགས་བཅས་བཟོས་ནས། ཡེ་ཧོ་ཡ་དཱའི་སྐུ་རིང་དུ་དེ་དག་གིས་རྒྱུན་ཆད་མེད་པར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་བ་ཡིན།"]},{"type":"verse","number":15,"content":["ཡེ་ཧོ་ཡ་དཱ་བགྲེས་ནས་ཚེ་ལོ་མཐར་ཕྱིན་ཏེ་ཚེ་ལས་འདས་ཤིང་། ཁོང་ཚེ་ལས་འདས་པའི་དུས་སུ་དགུང་ལོ་བརྒྱ་དང་སུམ་ཅུ་ཡིན་ནོ། །"]},{"type":"verse","number":16,"content":["ཁོང་གིས་དཀོན་མཆོག་དང་ཁོང་གི་མཆོད་ཁང་གཉིས་ཀྱི་ཕྱིར། ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ལས་བཟང་པོ་བྱས་པའི་ཕྱིར་དུ། མི་རྣམས་ཀྱིས་ཁོང་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་རྒྱལ་པོ་རྣམས་ཀྱི་ཁྲོད་དུ་དུར་ལ་སྦས་སོ། །"]},{"type":"verse","number":17,"content":["ཡང་ཡེ་ཧོ་ཡ་དཱ་ཚེ་ལས་འདས་པའི་རྗེས་སུ། ཡ་ཧུ་དཱ་ཡི་འགོ་དཔོན་རྣམས་རྒྱལ་པོ་ཡོ་ཨ་སི་ལ་མཇལ་དུ་འོངས་པ་ལ། རྒྱལ་པོས་དེ་དག་གི་གཏམ་ལ་མཉན་ཏེ།"]},{"type":"verse","number":18,"content":["དེ་དག་གིས་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བསྐྱུར་ནས། ཨ་ཤེ་རཱ་དང་སྐུ་འདྲ་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབས་པ་དང་། སྡིག་པ་དེའི་རྐྱེན་གྱིས་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་ལ་དཀོན་མཆོག་གི་ཐུགས་ཁྲོ་ཕོག་པ་རེད།"]},{"type":"verse","number":19,"content":["ཡིན་ཡང་ཁོ་རྣམས་ཡང་བསྐྱར་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་བའི་ཆེད་དུ། དཀོན་མཆོག་གིས་དེ་དག་གི་རྩར་ལུང་སྟོན་པ་རྣམས་བཏང་ནས། དེ་རྣམས་ཀྱིས་དེ་དག་ལ་ཉེན་བརྡ་བཏང་ཡང་མཉན་པར་མ་དགའོ། །"]},{"type":"verse","number":20,"content":["དུས་དེར་དཀོན་མཆོག་གི་ཐུགས་ཉིད་ནི་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱའི་བུ་ཟཱ་ཀར་ཡ་ཡི་སྟེང་ལ་བབས་ཤིང་། ཁོ་ནི་མཐོ་སར་ལངས་ཏེ་མི་རྣམས་ལ་ན་རེ། དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ཁྱོད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་འགལ་ནས་བྱ་བ་ལམ་འགྲོ་ཡོང་བར་མི་བྱེད་དོན་ཅི་ཡིན་ནམ། ཁྱོད་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་པས་ཁོང་གིས་ཀྱང་ཁྱོད་ཚོ་སྤངས་པ་ཡིན་གསུངས་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":21,"content":["མི་རྣམས་ཀྱིས་ཟཱ་ཀར་ཡ་གསོད་པར་ཇུས་ངན་བཤམས་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ར་སྐོར་དུ་རྒྱལ་པོའི་བཀའ་བཞིན་དུ་དེར་རྡོ་ཡིས་བརྒྱབ་སྟེ་བསད་དོ། །"]},{"type":"verse","number":22,"content":["དེ་ལྟར་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡིས་ཟཱ་ཀར་ཡའི་ཕ་ཡེ་ཧོ་ཡ་དཱས་རང་ལ་བཅངས་པའི་བྱམས་བརྩེ་མ་དྲན་པར་དེའི་བུ་བསད་པས། ཟཱ་ཀར་ཡ་འཆི་བའི་དུས་སུ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་གཟིགས་ཤིང་ལན་འཇལ་བར་མཛོད་ཅིག་ཅེས་ཞུས།"]},{"type":"heading","content":["ཡོ་ཨ་སི་གྲོངས་པ།"]},{"type":"verse","number":23,"content":["ལོ་སར་གྱི་རྗེས་སུ་ཨ་རམ་གྱི་དམག་ཚོགས་ཡར་འོངས་ཏེ་ཡོ་ཨ་སི་ལ་དམག་དྲངས་ནས། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་ལ་བཙན་འཛུལ་བྱས་ཤིང་། མི་རྣམས་ཀྱི་འགོ་དཔོན་རྣམས་བསད་དེ། དེ་དག་གི་བཅོམ་ནོར་ཐམས་ཅད་དཱ་མེ་སེག་གི་རྒྱལ་པོའི་མདུན་དུ་བསྐྱལ་ཏོ། །"]},{"type":"verse","number":24,"content":["ཨ་རམ་པའི་དམག་དཔུང་ལ་དམག་མི་ཉུང་ན་ཡང་། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་གི་ལག་ཏུ་དམག་ཚོགས་རབ་ཏུ་ཆེན་པོ་ཞིག་གཏད་པ་སྟེ། གང་ལ་ཞེ་ན། ཡ་ཧུ་དཱ་པས་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་པས། དེ་དག་གིས་ཡོ་ཨ་སི་ལ་ཉེས་ཆད་བཅད།"]},{"type":"verse","number":25,"content":["ཨ་རམ་པ་རྣམས་ཡོ་ཨ་སི་དང་འབྲལ་དུས་སུ་ཁོང་ལ་རྨས་ལྗིད་མོ་ཕོག་ཡོད་པ་དང་། ཁོང་གི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཁོང་གསོད་པར་ཇུས་ངན་བཤམས་པ་སྟེ། རྒྱུ་མཚན་ཁོང་གིས་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱའི་བུ་བསད་པའི་རྐྱེན་གྱིས་དེ་རྣམས་ཀྱིས་དགྲ་ཤ་ལེན་པའི་ཕྱིར་ཡིན་ལ། དེ་ནི་རང་གི་མལ་སར་བསད་ནས་ཤི། དེ་དག་གིས་ཁོང་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་དུར་ལ་སྦས་ནའང་། རྒྱལ་པོ་རྣམས་ཀྱི་དུར་ཁྲོད་ནང་དུ་མ་སྦས་སོ། །"]},{"type":"verse","number":26,"content":["ཁོང་ལྐོག་གསོད་བྱེད་མཁན་དག་ནི། ཨམ་མོན་པའི་བུད་མེད་ཤིམ་ཨད་ཀྱི་བུ་ཟཱ་བད་དང་། མོ་ཨབ་པའི་བུད་མེད་ཤིམ་རིད་ཀྱི་བུ་ཡེ་ཧོ་ཟཱ་བད་བྱ་བ་གཉིས་སོ། །"]},{"type":"verse","number":27,"content":["ཡང་ཡོ་ཨ་སིའི་སྲས་རྣམས་དང་། དེའི་སྐོར་གྱི་ལུང་བསྟན་མང་པོ་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་ཞིག་གསོ་བྱས་པའི་སྐོར་རྣམས་ནི་རྒྱལ་རབས་ཀྱི་གླེགས་བམ་ནང་དུ་ཡི་གེར་བཀོད་ཡོད། ཡང་དེའི་སྲས་ཨ་མཱ་ཙི་ཡ་ཁོའི་ཚབ་ཏུ་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/23.json","previousChapterAudioLinks":{},"numberOfVerses":27}