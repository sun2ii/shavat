{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":28,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟཱ།"]},{"type":"verse","number":1,"content":["ཨ་ཧ་ཟཱ་རྒྱལ་པོར་སྡོད་དུས་སུ་ལོ་ཉི་ཤུ་ཡིན་ལ། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་བཅུ་དྲུག་གི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ཁོས་རང་གི་མེས་པོ་དཱ་བིད་དང་འདྲ་བར་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་མ་སྤྱད་དེ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་སྤྱོད་ལམ་བཞིན་སྤྱད་དེ། པཱ་ཨལ་རྣམས་ཀྱི་ཕྱིར་བླུགས་སྐུ་བཟོས།"]},{"type":"verse","number":3,"content":["ཡང་པེན་ཧིན་ནོམ་ལུང་པ་རུ་བསང་བཏང་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་ནས་བསྐྲད་པའི་ཕྱི་རོལ་པའི་ཞེན་ལོག་གི་ལུགས་བཞིན་དུ་རང་གི་བུ་བུ་མོ་རྣམས་སྦྱིན་སྲེག་ཏུ་ཕུལ།"]},{"type":"verse","number":4,"content":["ཡང་མཐོ་གླིང་དང་། རིའི་སྟེང་དང་། ལྗོན་ཤིང་རེ་རེའི་འོག་ཏུ་མཆོད་པ་ཕུལ་ཏེ་བསང་བཏང་བ་རེད།"]},{"type":"verse","number":5,"content":["དེའི་རྐྱེན་གྱིས་ཨ་ཧ་ཟཱ་ཡི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རང་ཨ་རམ་པའི་རྒྱལ་པོའི་ལག་ཏུ་གཏད་པས། དེས་ཁོ་ཕམ་པར་བརྒྱབ་ཅིང་ཁོའི་མི་ཚོགས་ཆེན་པོ་ཞིག་བཙན་ཁྲིད་བྱས་ཏེ་དཱ་མེ་སེག་ཏུ་དྲངས། ཡང་དཀོན་མཆོག་གིས་ཁོ་རང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏད་ནས། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཡ་ཧུ་དཱ་རུ་གསོད་གཏུབ་ཆེན་པོ་བྱས།"]},{"type":"verse","number":6,"content":["རེ་མལ་ཡཱའི་བུ་ཕེ་ཀཱས་",{"noteId":8},"ཉིན་གཅིག་གི་རིང་ཡ་ཧུ་དཱ་རུ་དམག་མི་དཔའ་རྩལ་ཅན་ཁྲི་བཅུ་གཉིས་བསད་པ་ཡིན། གང་ལ་ཞེ་ན། དེ་དག་གིས་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":7,"content":["ཡང་ཟིག་རི་ཞེས་པའི་ཨེ་ཕཱར་ཡིམ་གྱི་དཔའ་བོ་ཞིག་ཡོད་པ་དེས་རྒྱལ་སྲས་མ་ཨ་སེ་ཡཱ་དང་། རྒྱལ་པོའི་ཕོ་བྲང་གི་ཕྱག་མཛོད་ཨས་རི་ཀམ་དང་། རྒྱལ་པོའི་བློན་ཆེན་ཨེལ་ཁ་ནཱ་བཅས་བསད་དོ། །"]},{"type":"heading","content":["ལུང་སྟོན་པ་ཨོ་དེད།"]},{"type":"verse","number":8,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རང་གི་སྤུན་ཡ་ཧུ་དཱ་པའི་ནང་ནས་བུད་མེད་དང་བུ་དང་བུ་མོ་བཅས་ཁྲི་ཉི་ཤུ་བཙན་ཁྲིད་བྱས་པར་མ་ཟད། དེ་དག་ལས་ནོར་མང་པོ་བཅོམ་ནས། བཅོམ་ནོར་དེ་རྣམས་སཱ་མར་ཡ་རུ་ཁྱེར་ཏོ། །"]},{"type":"verse","number":9,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེའི་ལུང་སྟོན་པ་ཨོ་དེད་བྱ་བ་ཞིག་ཡོད་པ་སཱ་མར་ཡ་རུ་ལོག་འོངས་པའི་དམག་ཚོགས་བསུ་བར་ཕྱིན་ཏེ་ན་རེ། ལྟོས་ཤིག ཁྱོད་ཅག་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡ་ཧུ་དཱ་ལ་ཐུགས་ཁྲོས་ཏེ། ཁོ་རྣམས་ཁྱོད་ཅག་གི་ལག་ཏུ་གཏད་པ་ཡིན་མོད། འོན་ཀྱང་ཁྱོད་ཚོས་ཁོང་ཁྲོའི་མེ་ལྕེ་དགུང་དུ་འཕྱུར་ནས་དེ་རྣམས་བསད་པ་རེད།"]},{"type":"verse","number":10,"content":["ད་ནི་ཁྱོད་ཚོས་ཡ་ཧུ་དཱ་པ་དང་ཡེ་རུ་སཱ་ལེམ་པ་རྣམས་བཙན་གྱིས་རང་གི་བྲན་པོ་དང་བྲན་མོ་རུ་འགོད་འདོད་པ་རེད། ཁྱོད་ཚོས་ཀྱང་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྡིག་ཉེས་བསགས་པ་མིན་ནམ།"]},{"type":"verse","number":11,"content":["དེ་བས་བདག་ལ་ཉོན་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་དྲག་པོ་ནི་ཁྱོད་ཅག་གི་སྟེང་བབས་པས། ཁྱོད་ཚོས་བཙན་ཁྲིད་བྱས་འོངས་པའི་རང་གི་སྤུན་རྣམས་ཐོངས་ཤིག་ཅེས་གདམས་པ་དང་།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཨེ་ཕཱར་ཡིམ་པའི་འགོ་དཔོན་རྣམས་ལས་ཡེ་ཧོ་ཧ་ནན་གྱི་བུ་ཨ་ཟར་ཡཱ་དང་། མེ་ཟིལ་ལེ་མོད་ཀྱི་བུ་པེ་རེག་ཡཱ་དང་། ཤལ་ལུམ་གྱི་བུ་ཡེ་ཧི་ཟག་ཡཱ་དང་། ཧད་ལ་ཨིའི་བུ་ཨ་མ་སཱ་བཅས་ཀྱིས་གཡུལ་ས་ནས་འོངས་པའི་དམག་རྣམས་བཀག་ནས་དེ་དག་ལ་ན་རེ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཚོས་བཙོན་མ་འདི་དག་ནང་དུ་ཁྲིད་མི་རུང་སྟེ། ང་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཉེས་པ་བསགས་ཟིན་ལ། ཁྱོད་ཚོས་ཀྱང་དེའི་སྟེང་དུ་སྡིག་ཉེས་བསག་འདོད་པའོ། །རང་ཅག་གི་ཉེས་སྐྱོན་ཤིན་ཏུ་ཚབས་ཆེ་ལ། ཡེས་ར་ཨེལ་གྱི་སྟེང་དུ་ཐུགས་ཁྲོ་ཆེན་པོ་ཡོད་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":14,"content":["དམག་དཔུང་གིས་འགོ་དཔོན་དང་མི་ཚོགས་ཀྱི་མདུན་དུ་བཙོན་མ་རྣམས་བཅོམ་ནོར་དང་བཅས་བཏང་བ་རེད།"]},{"type":"verse","number":15,"content":["དེར་གོང་ནས་བརྗོད་པའི་སྐྱེ་བོ་རྣམས་ལངས་ནས་བཙོན་མ་རྣམས་ཁྲིད་དེ། དེ་དག་གི་ནང་ནས་གཅེར་བུར་ཡོད་པ་ཐམས་ཅད་ལ་བཅོམ་ནོར་ལས་གོས་དང་ལྷམ་བླངས་ནས་བསྐོན་ཏེ། བཟའ་བཏུང་སྤྲད་ཅིང་སྣུམ་གྱིས་བྱུགས་པ་དང་། དེ་དག་ཁྲོད་ཀྱི་སྟོབས་ཞན་པ་རྣམས་བོང་བུར་བསྐྱོན་ཏེ། ཁ་ཟུར་ཤིང་གི་གྲོང་ཁྱེར་ཡེ་རུ་ཀོ་རུ་དེ་དག་གི་སྤུན་གྱི་དྲུང་དུ་བསྐྱལ་ནས་ཕྱིར་སཱ་མར་ཡ་རུ་ལོག"]},{"type":"heading","content":["ཨ་ཧ་ཟཱས་ཨ་སུར་གྱི་རྒྱལ་པོར་སྐྱབས་ཞུ་བ།"]},{"type":"verse","number":16,"content":["དེའི་ཚེ་རྒྱལ་པོ་ཨ་ཧ་ཟཱས་ཨ་སུར་གྱི་རྒྱལ་པོ་རྣམས་ལ་སྐྱབས་ཞུ་རུ་བང་ཆེན་བཏང་བ་རེད།"]},{"type":"verse","number":17,"content":["གང་ལ་ཞེ་ན། ཨེ་དོམ་པ་རྣམས་ཡང་བསྐྱར་ཡ་ཧུ་དཱ་ལ་རྒོལ་དུ་འོངས་ཏེ་མི་མང་པོ་བཟུང་ནས་ཁྲིད།"]},{"type":"verse","number":18,"content":["ཕེ་ལེ་ཤེད་པས་ཀྱང་རི་ཀླུང་དང་ཡ་ཧུ་དཱའི་ནེ་གུབ་ཡུལ་གྱི་གྲོང་ཁྱེར་རྣམས་ལ་བཙན་འཛུལ་བྱས་ནས་བཟུང་སྟེ། པེད་ཤེ་མེ་སི་དང་། ཨ་ཡཱ་ལོན་དང་། གེ་དེ་རོད་དང་། སོ་ཀོ་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། ཐིམ་ནཱ་དང་དེའི་གྲོང་ཚོ་རྣམས་དང་། གིམ་ཟོ་དང་དེའི་གྲོང་ཚོ་རྣམས་བཅས་བླངས་ནས་དེར་གཞིས་ཕབ།"]},{"type":"verse","number":19,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟཱས་ཡ་ཧུ་དཱ་རུ་ངན་པ་བག་མེད་དུ་སྤྱད་དེ། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྡིག་པ་ཚབས་ཆེན་བྱས་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཧུ་དཱ་དམའ་སར་ཕབ་པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེར་ཨ་སུར་གྱི་རྒྱལ་པོ་ཏིལ་གད་པིལ་ནེ་བཟིར་ཁོའི་རྩར་འོངས་པ་དང་། ཁོ་ལ་རོགས་བྱེད་པ་ཕར་ཞོག དེ་ལས་ལྡོག་སྟེ་ཁོ་ལ་བརྙས་བཅོས་བྱས།"]},{"type":"verse","number":21,"content":["ཨ་ཧ་ཟཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་རྒྱལ་པོའི་ཕོ་བྲང་དང་། འགོ་དཔོན་རྣམས་ཀྱི་ཁྱིམ་བཅས་ནས་རྒྱུ་ནོར་ཁྱེར་ཏེ་ཨ་སུར་རྒྱལ་པོར་ཕུལ་ནའང་ཕན་ཅི་ཡང་མ་ཐོགས་སོ། །"]},{"type":"heading","content":["ཨ་ཧ་ཟཱའི་སྡིག་པ།"]},{"type":"verse","number":22,"content":["འུ་ཐུག་གི་དུས་དེ་ལ་རྒྱལ་པོ་ཨ་ཧ་ཟཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྡིག་པ་ལྷག་པར་བྱས་ཏེ།"]},{"type":"verse","number":23,"content":["རང་ཉིད་ཕམ་པར་བཅུག་པའི་དཱ་མེ་སེག་གི་ལྷ་རྣམས་ལ་མཆོད་པ་ཕུལ་ནས་ན་རེ། ཨ་རམ་རྒྱལ་པོའི་ལྷ་རྣམས་ཀྱིས་དེ་དག་ལ་སྐྱབས་བྱས་པས། ལྷ་དེ་རྣམས་ཀྱིས་ང་ལ་ཡང་སྐྱབས་བྱེད་པའི་ཆེད་དུ། ངས་མཆོད་པ་འབུལ་བར་བྱའོ་སྨྲས་ཀྱང་། ལྷ་དེ་རྣམས་ཀྱིས་ཁོ་དང་ཡེས་ར་ཨེལ་ཐམས་ཅད་ཕམ་པར་བཅུག"]},{"type":"verse","number":24,"content":["ཡང་ཨ་ཧ་ཟཱས་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཡོ་བྱད་རྣམས་བསྡུས་ནས། དཀོན་མཆོག་གི་མཆོད་ཁང་ནང་གི་སྣོད་ཆས་ཐམས་ཅད་དུམ་བུར་བཅག་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་སྒོ་རྣམས་བརྒྱབ་ནས། ཡེ་རུ་སཱ་ལེམ་གྱི་གྲུ་ཟུར་རེ་རེར་མཆོད་ཁྲི་བརྩིགས།"]},{"type":"verse","number":25,"content":["ཡང་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རེ་རེའི་ནང་དུ་མཐོ་གླིང་རྣམས་བརྩིགས་ནས་ལྷ་གཞན་རྣམས་ལ་བསང་བཏང་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཐུགས་ཁྲོ་རུ་བཅུག་པ་རེད།"]},{"type":"verse","number":26,"content":["ཨ་ཧ་ཟཱའི་བྱས་རྗེས་གཞན་རྣམས་དང་། སྤྱོད་པ་ཐམས་ཅད་འགོ་ནས་མཇུག་བར་དུ་ཡ་ཧུ་དཱ་དང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་གླེགས་བམ་ནང་དུ་བཀོད་ཡོད།"]},{"type":"verse","number":27,"content":["ཨ་ཧ་ཟཱ་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་གཉིད་ནས། ཡེ་རུ་སཱ་ལེམ་རྒྱལ་ས་རུ་དུར་ལ་སྦས་མོད། འོན་ཀྱང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་དུར་ཁྲོད་དུ་མ་བཞག དེའི་སྲས་ཧི་ཟི་ཀི་ཡཱ་ཁོའི་ཚབ་ཏུ་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":8,"caller":"+","text":"འདིར་ཕེ་ཀཱ་ཞེས་པ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཞིག་ཡིན།","reference":{"chapter":28,"verse":6}}]},"thisChapterLink":"/api/bod_ntb/2CH/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/27.json","previousChapterAudioLinks":{},"numberOfVerses":27}