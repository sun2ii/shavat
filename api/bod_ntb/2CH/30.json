{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":30,"content":[{"type":"heading","content":["པེ་སག་དུས་ཆེན་བསྲུང་བར་སྟ་གོན་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཧི་ཟི་ཀི་ཡཱ་ཡིས་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱའི་ཡུལ་ཀུན་ཏུ་མི་མངགས་ཤིང་། ཨེ་ཕཱར་ཡིམ་དང་མཱ་ན་ཤེ་པ་དག་ལ་འཕྲིན་ཡིག་སྤྲིངས་ཏེ། དེ་རྣམས་ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དུ་པེ་སག་དུས་ཆེན་བསྲུང་དུ་འོང་དགོས་པའི་བཀའ་བསྒོས་པ་རེད།"]},{"type":"verse","number":2,"content":["དེའི་རྒྱུ་མཚན་ནི། རྒྱལ་པོ་དང་འགོ་དཔོན་རྣམས་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་མི་ཚོགས་ཡོངས་ཀྱིས་ཟླ་གཉིས་པར་པེ་སག་དུས་ཆེན་བསྲུང་བར་གྲོས་བྱས་སོ། །"]},{"type":"verse","number":3,"content":["ཡིན་ཡང་སྐབས་དེར་ཁོ་ཚོས་པེ་སག་དུས་ཆེན་སྲུང་མ་ཐུབ་སྟེ། རྒྱུ་མཚན་རང་ཉིད་དམ་པར་བཟོས་པའི་མཆོད་དཔོན་མི་འདང་བར་མ་ཟད། མི་རྣམས་ཀྱང་ཡེ་རུ་སཱ་ལེམ་དུ་མ་འཛོམས་པས་སོ། །"]},{"type":"verse","number":4,"content":["རྒྱལ་པོ་དང་མི་ཚོགས་ཡོངས་ཀྱིས་འཆར་གཞི་དེ་ཤིན་ཏུ་ལེགས་པར་འདོད་དེ།"]},{"type":"verse","number":5,"content":["ཁོ་ཚོས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་པེ་སག་གི་དུས་ཆེན་བསྲུང་བར་ཡེ་རུ་སཱ་ལེམ་དུ་འོང་བ་ལ། པེར་ཤ་བཱ་ནས་དཱན་གྱི་བར་དུ་ཡེས་ར་ཨེལ་ཡོངས་ལ་འཕྲིན་བསྐུར་ནས་བཀའ་བབས་པ་རེད། གང་ལ་ཞེ་ན། དེ་དག་གིས་གསུང་རབ་ནང་བཀོད་པ་བཞིན་དུ་པེ་སག་དུས་ཆེན་སྲུང་མཁན་ཉུང་བས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་བང་ཆེན་རྣམས་ཀྱིས་རྒྱལ་པོ་དང་འགོ་དཔོན་རྣམས་ཀྱི་འཕྲིན་ཡིག་ཁྱེར་ནས། རྒྱལ་པོའི་བཀའ་བཞིན་དུ་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱའི་ཡུལ་ཀུན་ཏུ་ཕྱིན་པ་དང་། འཕྲིན་ཡིག་ནང་དུ་འདི་ལྟར། ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། ཁྱོད་ཅག་ཨབ་ར་ཧམ་དང་། ཨི་སཱག་དང་། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་ཕྱིར་འཁོར་ཅིག དེ་ནས་ཡ་ཝཱེ་ཁོང་ཉིད་ཨ་སུར་རྒྱལ་པོ་རྣམས་ཀྱི་ལག་ནས་ཐར་བའི་ལྷག་ལུས་རྣམས་ཀྱི་ཕྱོགས་སུ་ཕྱིར་འབྱོན་པར་འགྱུར།"]},{"type":"verse","number":7,"content":["རང་གི་ཕ་མེས་དང་སྤུན་རྣམས་བཞིན་དུ་མ་བྱེད་ཅིག ཁོ་ཚོ་རང་གི་ཕ་མེས་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་འགལ་བ་དང་། ཁྱོད་ཚོས་མཐོང་བ་ལྟར། དེའི་རྐྱེན་གྱིས་ཡ་ཝཱེས་དེ་དག་འཇིགས་སུ་རུང་བའི་གནས་སུ་བྱས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་བས་ན་ཁྱོད་ཅག་གིས་རང་གི་ཕ་མེས་ལྟར་གཉའ་རེངས་མི་བྱེད་པར། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟུན་ནས་ཁོང་གིས་དུས་གཏན་དུ་དམ་པར་མཛད་པའི་གནས་དམ་པ་རུ་ཤོག་ཅིག ཁོང་གི་ཐུགས་ཁྲོ་ཆེན་པོ་ཁྱོད་རྣམས་དང་འབྲལ་བའི་ཕྱིར་དུ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞབས་ཕྱི་སྒྲུབས་ཤིག"]},{"type":"verse","number":9,"content":["གལ་ཏེ་ཁྱོད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་ན། ཁྱོད་ཅག་གི་སྤུན་དང་བུ་བུ་མོ་རྣམས་བྲན་ཏུ་བཀོལ་མཁན་རྣམས་ཀྱི་མདུན་དུ་སྙིང་རྗེ་གནང་ཞིང་། ཡུལ་འདིར་ལོག་སྟེ་སླེབ་པར་འགྱུར། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཐུགས་རྗེ་ཅན་དང་སྙིང་རྗེ་ཆེན་པོ་མངའ་བ་ཡིན་པས། གལ་ཏེ་ཁྱོད་ཅག་ཁོང་གི་ཕྱོགས་སུ་ལོག་འོངས་ན། ཁོང་གིས་ཀྱང་ཁྱོད་ཅག་སྣང་མེད་དུ་བསྐྱུར་མི་སྲིད་ཅེས་བྲིས་ཡོད་དོ། །"]},{"type":"verse","number":10,"content":["བང་ཆེན་རྣམས་ཨེ་ཕཱར་ཡིམ་དང་མཱ་ན་ཤེ་ཡུལ་ནས་ཟེ་བུ་ལུན་གྱི་བར་དུ་གྲོང་ཁྱེར་ནས་གྲོང་ཁྱེར་དུ་འཁོར་ནའང་། ཡུལ་དེའི་མི་རྣམས་ཀྱིས་ཁོ་ཚོ་ཁྱད་དུ་བསད་ནས་འཕྱས་སོ། །"]},{"type":"verse","number":11,"content":["ཡིན་ཡང་ཨ་ཤེར་དང་མཱ་ན་ཤེ་དང་ཟེ་བུ་ལུན་བཅས་ནས་ལ་ལས་ཁེངས་སྐྱུང་བྱས་ཏེ་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་སེམས་གཏིང་ནས་རྒྱལ་པོ་དང་འགོ་དཔོན་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་བསྒོས་པ་ནང་ལྟར་བྱེད་པའི་ཕྱིར། དཀོན་མཆོག་གིས་ཡ་ཧུ་དཱའི་སྟེང་དུ་ཕྱག་བཞག་པ་ཡིན།"]},{"type":"heading","content":["པེ་སག་གི་དུས་ཆེན་བསྲུངས་པ།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཟླ་གཉིས་པར་སྐྱུར་མེད་བག་ལེབ་ཀྱི་དུས་ཆེན་བསྲུང་ཕྱིར། ཡེ་རུ་སཱ་ལེམ་དུ་འཛོམས་པའི་མི་ཚོགས་ནི་ཤིན་ཏུ་མང་པོར་གྱུར།"]},{"type":"verse","number":14,"content":["ཡང་དེ་རྣམས་ཡར་ལངས་ཏེ། ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་མཆོད་ཁྲི་དང་བསང་ཁྲི་ཐམས་ཅད་བཤིགས་ཏེ་ཀིད་རོན་གྲོག་མོ་ལ་གཡུགས།"]},{"type":"verse","number":15,"content":["ཟླ་གཉིས་པའི་ཚེས་བཅུ་བཞི་ཉིན་དེ་རྣམས་ཀྱིས་པེ་སག་དུས་ཆེན་གྱི་ཆེད་དུ་ལུ་གུ་བཤས་པ་དང་། མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ངོ་ཚ་ཞིང་རང་ཉིད་དམ་པར་བྱས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་བ་རེད།"]},{"type":"verse","number":16,"content":["ཁོ་ཚོས་དཀོན་མཆོག་གི་སྐྱེས་བུ་མོ་ཤེའི་བཀའ་ཁྲིམས་བཞིན་དུ། རྒྱུན་སྲོལ་ལྟར་རང་རང་གི་གནས་སུ་ལངས་ཏེ། མཆོད་དཔོན་རྣམས་ཀྱིས་ལེ་ཝི་པའི་ལག་ནས་ཁྲག་བླངས་ཏེ་མཆོད་ཁྲིའི་ཁར་གཏོར་ཏོ། །"]},{"type":"verse","number":17,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་ཚོགས་ཀྱི་ཁྲོད་དུ་དམ་པར་མ་བྱས་པ་མང་པོ་ཡོད་པས། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དམ་པར་མ་བྱས་པ་ཐམས་ཅད་ཀྱི་ཚབ་ཏུ་ལེ་ཝི་པ་རྣམས་ཀྱིས་པེ་སག་དུས་ཆེན་གྱི་ལུ་གུ་བཤས་པ་རེད།"]},{"type":"verse","number":18,"content":["གང་ལ་ཞེ་ན། ཨེ་ཕཱར་ཡིམ་དང་མཱ་ན་ཤེ་དང་། ཡེས་སི་ཀཱར་དང་། ཟེ་བུ་ལུན་བཅས་ནས་འོངས་པའི་མི་མང་པོ་ཞིག་གིས་རང་ཉིད་གཙང་མར་མ་བྱས་པར་པེ་སག་གི་ལུ་གུ་ཟོས་པ་དང་། བྱ་སྤྱོད་དེ་ནི་བྲིས་པའི་བཀའ་དང་མ་མཐུན་པར། ཧི་ཟི་ཀི་ཡཱས་དེ་དག་གི་དོན་དུ་གསོལ་བ་བཏབ་པ་སྟེ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་བཟང་པོ་ལགས་ཀྱིས་གུ་ཡངས་གཏོང་རོགས།"]},{"type":"verse","number":19,"content":["བློ་གཅིག་སེམས་གཅིག་གིས་ཕ་མེས་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་འཚོལ་མཁན་ཐམས་ཅད་ནི། གནས་དམ་པའི་གཙང་སྦྲ་བཞིན་དུ་གཙང་མར་གྱུར་མེད་ནའང་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱེད་ཀྱིས་གུ་ཡངས་གནང་བར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཧི་ཟི་ཀི་ཡཱ་ལ་གསན་ནས་མི་རྣམས་ལ་གུ་ཡངས་གནང་བའོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཡེ་རུ་སཱ་ལེམ་དུ་འཛོམས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་རབ་ཏུ་དགའ་ཞིང་ཉིན་བདུན་ལ་སྐྱུར་མེད་བག་ལེབ་ཀྱི་དུས་ཆེན་བཏང་སྟེ། ལེ་ཝི་པ་དང་མཆོད་དཔོན་རྣམས་ཀྱིས་ཉིན་རེར་སྐད་གདངས་ཆེན་པོའི་རོལ་མོ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་བསྔགས་ཕུལ།"]},{"type":"verse","number":22,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞབས་ཕྱི་སྒྲུབ་པར་བྱང་བའི་ལེ་ཝི་པ་རྣམས་ལ་ཧི་ཟི་ཀི་ཡཱས་སེམས་ཤུགས་བསྐྱེད་པའི་གཏམ་སྨྲས་ཏེ། མི་རྣམས་ཀྱིས་ཉིན་བདུན་ལ་སྟོན་མོར་རོལ་ཞིང་། ཞི་བདེའི་མཆོད་པ་ཕུལ་བ་དང་། རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་བསྔགས་བརྗོད་དོ། །"]},{"type":"heading","content":["ཡང་བསྐྱར་དུས་ཆེན་བསྲུངས་པ།"]},{"type":"verse","number":23,"content":["དེ་ནས་མི་ཚོགས་ཡོངས་ཀྱིས་ཡང་ཉིན་བདུན་ལ་དུས་ཆེན་བསྲུང་བར་གྲོས་བྱས་ནས། ཡང་ཉིན་བདུན་ལ་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་དུས་ཆེན་ལ་རོལ་བ་རེད།"]},{"type":"verse","number":24,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་མི་ཚོགས་ལ་བ་གླང་ཆིག་སྟོང་དང་ལུག་བདུན་སྟོང་སྤྲད་པ་དང་། འགོ་དཔོན་རྣམས་ཀྱིས་ཀྱང་མི་ཚོགས་ལ་བ་གླང་ཆིག་སྟོང་དང་ལུག་ཆིག་ཁྲི་སྤྲད་པར་མ་ཟད། མཆོད་དཔོན་མང་པོ་ཞིག་གིས་རང་ཉིད་དམ་པར་བྱས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་ཡ་ཧུ་དཱའི་མི་ཚོགས་ཀུན་དང་། མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས། ཡེས་ར་ཨེལ་ནས་འོངས་པའི་མི་ཚོགས་ཡོངས། ཡེས་ར་ཨེལ་ཡུལ་དུ་གཞིས་ཕབ་པའི་བྱེས་པ་རྣམས། ཡ་ཧུ་དཱ་རུ་གཞིས་ཕབ་པའི་བྱེས་པ་རྣམས་བཅས་ཐམས་ཅད་ཤིན་ཏུ་དགའ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":26,"content":["དེ་ལྟར་ཡེ་རུ་སཱ་ལེམ་དུ་བདེ་སྐྱིད་ཆེན་པོ་ཞིག་བྱུང་བ་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དཱ་བིད་ཀྱི་སྲས་སོ་ལོ་མོན་གྱི་དུས་ཚུན་ཆད་དུ་ཡེ་རུ་སཱ་ལེམ་ནས་དེ་འདྲ་བ་ཞིག་བྱུང་མ་མྱོང་ངོ་། །"]},{"type":"verse","number":27,"content":["སྐབས་དེར་ལེ་ཝི་ཚོ་པའི་མཆོད་དཔོན་རྣམས་ཡར་ལངས་ནས་མི་ཚོགས་ལ་བྱིན་རླབས་མཛད་ཅིང་། དེ་དག་གི་སྐད་ལ་གསན་པ་དང་དེ་དག་གི་གསོལ་འདེབས་ནི་ནམ་མཁའི་དཀོན་མཆོག་གི་བཞུགས་གནས་དམ་པ་རུ་སླེབས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/29.json","previousChapterAudioLinks":{},"numberOfVerses":27}