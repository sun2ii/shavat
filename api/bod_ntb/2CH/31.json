{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":31,"content":[{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱའི་བཅོས་བསྒྱུར།"]},{"type":"verse","number":1,"content":["དོན་དེ་ཐམས་ཅད་རྫོགས་པ་དང་། དེར་ཚོགས་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་སོ་སོར་ཕྱིན་ཏེ། ལྷ་རྟེན་རྣམས་བཅག་ནས་ཨ་ཤེ་རཱ་རྣམས་བཅད་པ་དང་། ཡང་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་དང་། ཨེ་ཕཱར་ཡིམ་དང་། མཱ་ན་ཤེའི་བཅས་ཡུལ་ཀུན་ཏུ་ཡོད་པའི་མཐོ་གླིང་དང་། མཆོད་ཁྲི་ཐམས་ཅད་ཡོངས་སུ་བཤིགས། དེ་ནས་ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་རང་རང་གི་གྲོང་ཁྱེར་དང་རང་གནས་སུ་ལོག་སོང་།"]},{"type":"verse","number":2,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་རང་རང་གི་ལས་རེས་བཞིན་དུ་ཞབས་ཏོག་བསྒྲུབ་པར་བསྐོས་ཏེ། མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱིས་རང་རང་གི་ལས་འགན་བཞིན་སྦྱིན་སྲེག་གི་མཆོད་པ་དང་། ཞི་བདེའི་མཆོད་པ་འབུལ་བ་དང་། ཞབས་ཏོག་བསྒྲུབ་པ་དང་། གཏང་རག་དང་བསྟོད་དབྱངས་འབུལ་བའི་ཕྱིར། དཀོན་མཆོག་ཡ་ཝཱེའི་བཞུགས་གནས་ཀྱི་སྒོ་སོ་སོར་བཞག་སྟེ།"]},{"type":"verse","number":3,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་ནང་བཀོད་པ་བཞིན་དུ། རྒྱལ་པོས་རང་གི་རྒྱུ་ནོར་ལས་ནངས་དགོང་གཉིས་ཀའི་སྦྱིན་སྲེག་གི་མཆོད་པ་དང་། ངལ་གསོ་བའི་ཉིན་མོ། ཚེས་གཅིག དུས་ཆེན་བཅས་ཀྱི་སྦྱིན་སྲེག་གི་ཕྱིར་འབུལ་བྱའི་སྐལ་གཏན་ལ་ཕབ་ཅིང་།"]},{"type":"verse","number":4,"content":["ཡང་རྒྱལ་པོས་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་མི་ཀུན་ལ། མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱིས་བསམ་པ་རྩེ་གཅིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་ལག་ལེན་དུ་འདེབས་པའི་ཕྱིར། དེ་དག་ལ་འཐོབ་འོས་པའི་སྐལ་དེ་སྟེར་བར་བསྒོས་སོ། །"]},{"type":"verse","number":5,"content":["བཀའ་དེ་བབས་མ་ཐག་ཏུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་འབྲུ་རིགས་ཀྱི་ཐོག་ཕུད་དང་། རྒུན་ཆང་གསར་པ་དང་། སྣུམ་དང་། སྦྲང་རྩི་དང་། ཞིང་གི་ལོ་ཏོག་ཐམས་ཅད་ཀྱི་ཕུད་མང་དུ་དྲངས་ཏེ། ཡང་དངོས་པོ་ཐམས་ཅད་ཀྱི་བཅུ་ཆའི་གཅིག་འབོར་ཆེན་ཕུལ་བའོ། །"]},{"type":"verse","number":6,"content":["ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་སུ་གནས་པའི་ཡེས་ར་ཨེལ་པ་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་ཀྱང་བ་གླང་དང་ར་ལུག་གི་བཅུ་ཆའི་གཅིག་དང་། རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྔོས་པའི་རྫས་དམ་པ་རྣམས་ཀྱི་བཅུ་ཆའི་གཅིག་ཕུལ་ནས་མང་པོ་སྤུངས།"]},{"type":"verse","number":7,"content":["དེ་དག་ཟླ་གསུམ་པ་ནས་སྤུང་བར་ཚུགས་ནས། ཟླ་བདུན་པར་ད་གཟོད་མཇུག་རྫོགས།"]},{"type":"verse","number":8,"content":["ཧི་ཟི་ཀི་ཡཱ་དང་འགོ་དཔོན་རྣམས་འོངས་ཏེ་ཕུང་པོ་དེ་རྣམས་མཐོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་བསྔགས་བརྗོད་པ་དང་། ཡང་ཁོང་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་བྱིན་གྱིས་བརླབས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཧི་ཟི་ཀི་ཡཱས་མཆོད་དཔོན་དང་ལེ་ཝི་པ་ལ་ཕུང་པོ་དེ་རྣམས་ཀྱི་སྐོར་དྲིས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཟཱ་ཏོག་ཁྱིམ་རྒྱུད་ཀྱི་མཆོད་དཔོན་ཆེན་པོ་ཨ་ཟར་ཡཱས་ལན་དུ། མི་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་དངོས་པོ་མང་པོ་ཁྱེར་འོངས་ཏེ། ངེད་རྣམས་ལ་ཚིམ་པར་ཟ་རྒྱུ་བྱུང་བར་མ་ཟད། ལྷག་མ་ཡང་མང་པོ་ལུས་ཡོད་དེ། ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་འབངས་མི་ལ་བྱིན་གྱིས་བརླབས་པས། ཕུང་པོ་ཆེན་པོ་འདི་ནི་ལྷག་ནས་ལུས་པ་ཡིན་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":11,"content":["ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་བང་མཛོད་གྲ་སྒྲིག་བྱེད་པར་བསྒོས་པ་ལ། དེ་དག་གིས་དེ་ལྟར་གྲ་སྒྲིག་བྱས།"]},{"type":"verse","number":12,"content":["ཡང་དེ་དག་གིས་ལྷག་བསམ་རྣམ་དག་གིས་འབུལ་བ་དང་དངོས་པོ་སྣ་ཚོགས་ཀྱི་བཅུ་ཆའི་གཅིག་དང་། བསྔོས་པའི་རྫས་དམ་པ་བཅས་ཐམས་ཅད་བང་མཛོད་དུ་བསྐྱལ་ཏེ། དེའི་ཕྱག་མཛོད་དུ་ལེ་ཝི་པ་ཀོ་ནན་ཡཱ་དང་། ལག་གཡོག་ཏུ་དེའི་སྤུན་ཤིམ་ཨི་གཉིས་ཡོད་དོ། །"]},{"type":"verse","number":13,"content":["ཡང་ཡེ་ཧི་ཨེལ་དང་། ཨ་ཟས་ཡཱ། ནཱ་ཧད། ཨ་སཱ་ཧེལ། ཡེ་རི་མོད། ཡོ་ཟཱ་བད། ཨེ་ལི་ཨེལ། ཨིས་མག་ཡཱ། མ་ཧད། པེ་ནཱ་ཡ་བཅས་ནི། རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་གི་འགོ་དཔོན་ཨ་ཟར་ཡཱའི་བཀའ་བསྩལ་པ་བཞིན་དུ། ཀོ་ནན་ཡཱ་དང་དེའི་སྤུན་ཤིམ་ཨི་ཡི་ལག་འོག་ཏུ་ལྟ་སྐུལ་གྱི་ལས་བྱེད་མཁན་ཡིན།"]},{"type":"verse","number":14,"content":["ཤར་སྒོ་སྲུང་མཁན་ལེ་ཝི་པ་ཡིམ་ནཱ་ཡི་བུ་ཀོ་རེད་བྱ་བ་དེས་དཀོན་མཆོག་ལ་ཡིད་མོས་ངང་ཕུལ་བའི་ཕྱག་རྟེན་ལ་བདག་གཉེར་བྱེད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་མཆོད་པ་དང་རྫས་དམ་མཆོག་རྣམས་བགོ་བཤའ་རྒྱག་པ་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["མཆོད་དཔོན་རྣམས་ཀྱི་གྲོང་ཁྱེར་སོ་སོར་དེའི་ལག་འོག་ཏུ་ཨེ་དེན་དང་། མིན་ཡ་མིན་དང་། ཡེ་ཤུ་ཨ་དང་། ཤེ་མ་ཡཱ་དང་། ཨ་མར་ཡཱ་དང་། ཤེ་ཀན་ཡཱ་བཅས་ཡོད་ལ། རང་རང་གི་སྤུན་ཆེ་ཆུང་ཚང་མ་ལ་ལས་རེས་བཞིན་དུ་ཟ་སྐལ་སྟེར་བ་ཡིན།"]},{"type":"verse","number":16,"content":["གཞན་ཡང་ཁྱིམ་ཐོ་བཞིན་དུ་ལོ་གསུམ་ལོན་པ་དང་དེའི་ཡན་གྱི་སྐྱེས་པ་ནི་སུ་ཡིན་ཡང་། ཉིན་རེར་ལས་རེས་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་འོངས་ནས་ལས་འགན་སྒྲུབ་པ་ཐམས་ཅད་ལའང་བགོ་བཤའ་བརྒྱབ་པ་ཡིན།"]},{"type":"verse","number":17,"content":["ཡང་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཁྱིམ་ཐོ་ནང་དུ་བཀོད་ཡོད་པའི་མཆོད་དཔོན་རྣམས་ལ་བགོ་བཤའ་བརྒྱབ་པ་དང་། ལས་རེས་དང་ལས་འགན་བཞིན་དུ་ལོ་ཉི་ཤུ་ལོན་པ་དང་དེའི་ཡན་གྱི་ལེ་ཝི་པ་རྣམས་ལའང་བགོས་པའོ། །"]},{"type":"verse","number":18,"content":["ཡང་དེ་དག་གིས་བསམ་པ་རྩེ་གཅིག་གིས་རང་ཉིད་དམ་པར་བྱས་པས། ཁྱིམ་ཐོ་བཞིན་དུ་དེ་དག་ཐམས་ཅད་ཀྱི་ཕྲུ་གུ་དང་། ཆུང་མ་དང་། བུ་དང་བུ་མོ་བཅས་ལ་བགོས་པའོ། །"]},{"type":"verse","number":19,"content":["ཡང་གྲོང་ཁྱེར་སོ་སོའི་མཐའ་འཁོར་དུ་གནས་པའི་ཨ་རོན་གྱི་བུ་རྒྱུད་མཆོད་དཔོན་རྣམས་ལ་གྲོང་ཁྱེར་སོ་སོར་མིང་བཏོན་ནས་བསྐོས་པའི་མི་ཡོད་དེ། མཆོད་དཔོན་ཁྲོད་ཀྱི་སྐྱེས་པ་ཐམས་ཅད་དང་། ཁྱིམ་ཐོ་རུ་བཀོད་ཡོད་པའི་ལེ་ཝི་པ་ཐམས་ཅད་ལ་འཐོབ་འོས་པའི་སྐལ་བགོས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཧི་ཟི་ཀི་ཡཱས་ཡ་ཧུ་དཱ་ཐམས་ཅད་དུ་དེ་བཞིན་བྱས་ཏེ། རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བཟང་པོ་དང་ལེགས་པོ། དྲང་པོ་བཅས་གང་ཡིན་པ་དེ་སྤྱད་ཅིང་།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཞབས་ཏོག་སྒྲུབ་པ་དང་། ཡང་ན་བཀའ་ཁྲིམས་དང་། བཀའ་རྒྱ་སྲུང་བ་སོགས་གང་ཡིན་ཡང་ཁོང་གིས་རང་གི་དཀོན་མཆོག་བཙལ་ཞིང་། ཁོང་གིས་སེམས་ཧྲིལ་པོས་བྱས་པས་དོན་ཐམས་ཅད་ལྷུན་གྱིས་གྲུབ་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/30.json","previousChapterAudioLinks":{},"numberOfVerses":21}