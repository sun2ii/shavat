{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":32,"content":[{"type":"heading","content":["ཨ་སུར་པས་ཡེ་རུ་སཱ་ལེམ་ལེན་འདོད་པ།"]},{"type":"verse","number":1,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་བློ་སེམས་དྲང་པོའི་ལས་དེ་དག་བྱས་པའི་མཐར། ཨ་སུར་གྱི་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་འོངས་ནས་ཡ་ཧུ་དཱའི་ནང་དུ་འཛུལ་ཏེ། གྲོང་ཁྱེར་བཙན་པོ་རྣམས་ཀྱི་མཐའ་འཁོར་དུ་དམག་སྒར་ཕབ་ནས་དེ་དག་ལེན་འདོད་པ་རེད།"]},{"type":"verse","number":2,"content":["ཧི་ཟི་ཀི་ཡཱས་སེན་ན་ཧེ་རིབ་དངོས་གནས་ཡེ་རུ་སཱ་ལེམ་ལ་འཐབ་ཏུ་འོང་འདོད་པ་མཐོང་ནས།"]},{"type":"verse","number":3,"content":["འགོ་དཔོན་དང་དཔའ་བོ་རྣམས་ལ་གྲོས་བཏབ་ནས། རྒྱལ་སའི་ཕྱི་རོལ་ཏུ་ཡོད་པའི་ཆུ་མིག་རྣམས་འགོག་རྒྱུ་བྱས་པ་ལ། དེ་དག་ཐམས་ཅད་ཀྱིས་ཁོང་ལ་རོགས་བྱས་པ་སྟེ།"]},{"type":"verse","number":4,"content":["མི་མང་པོ་འཛོམས་ཏེ་ཆུ་མིག་དང་ཡུལ་དེར་བཞུར་བའི་ཆུ་ཕྲན་ཡོད་ཚད་བཀག་སྟེ་ན་རེ། ཨ་སུར་གྱི་རྒྱལ་པོར་ཆུ་མོད་པོ་རྙེད་དུ་འཇུག་དོན་ཅི་ཡོད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་བརྩོན་པ་བསྐྱེད་དེ། ལྕགས་རི་ཞིག་རལ་དུ་སོང་བ་ཐམས་ཅད་ཞིག་གསོ་མཛད་ཅིང་། ལྕགས་རིའི་སྟེང་དུ་ལྕོག་མཁར་རྣམས་བཞེངས། མཁར་དེའི་ཕྱི་རོལ་ཏུ་ཡང་མཁར་ཞིག་བརྩིགས་ཏེ། དཱ་བིད་གྲོང་ཁྱེར་གྱི་འཛིངས་རགས་ཀྱང་ཞིག་གསོ་མཛད་ནས། མཚོན་ཆ་དང་ཕུབ་མང་པོ་བཟོས།"]},{"type":"verse","number":6,"content":["ཡང་མི་རྣམས་ལ་དམག་དཔོན་བཞག་སྟེ། མཁར་སྒོའི་ཐང་ཆེན་དུ་དེ་དག་རང་གི་དྲུང་དུ་བསྡུས་ནས། དེ་དག་ལ་སེམས་ཤུགས་བསྐྱེད་ཅིང་ན་རེ།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཚོས་སྙིང་སྟོབས་དང་དཔའ་སེམས་སྐྱེད་ཅིག ཨ་སུར་རྒྱལ་པོ་དང་ཁོས་བཀོད་འདོམས་བྱེད་པའི་དམག་དཔུང་ཆེན་པོའི་རྐྱེན་གྱིས་མ་འཇིགས་མ་ཚབས་ཤིག གང་ལ་ཞེ་ན། རང་ཅག་དང་མཉམ་དུ་ཡོད་པ་ནི་དེ་དག་དང་མཉམ་དུ་ཡོད་པ་ལས་ལྷག་ཏུ་མང་སྟེ།"]},{"type":"verse","number":8,"content":["དེ་དག་དང་མཉམ་དུ་ཡོད་པ་ནི་ཤ་ཁྲག་གདོས་བཅས་ཀྱི་དཔུང་པ་ཡིན་མོད། རང་ཅག་དང་མཉམ་དུ་བཞུགས་པ་ནི་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ལ། ཁོང་གིས་རང་ཅག་ལ་རོགས་རམ་མཛད་པ་དང་། རང་ཅག་གི་ཚབ་ཏུ་འཐབ་མོ་མཛད་ངེས་ཡིན་ཞེས་སྨྲས་པས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་གཏམ་དེའི་རྐྱེན་གྱིས་མི་ཚོགས་ལ་སྐུལ་སློང་ཐོབ།"]},{"type":"verse","number":9,"content":["དེའི་རྗེས་སུ་ཨ་སུར་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱིས་རང་གི་དམག་དཔུང་ཐམས་ཅད་ཁྲིད་ནས་ལཱ་ཀི་སི་ལ་དམག་རྒྱག་པའི་ཚེ། རང་གི་འཁོར་ནས་འགའ་ཞིག་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་དང་། དེར་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་ཚང་མའི་མདུན་དུ་བཏང་ནས་དེ་དག་ལ་འདི་ལྟར།"]},{"type":"verse","number":10,"content":["ཨ་སུར་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱིས་འདི་ལྟར་གསུངས་ཏེ། ད་ནི་ཁྱོད་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་དམག་གིས་བསྐོར་བས་ཁྱོད་རྣམས་སུ་ལ་བརྟེན་པར་བྱའམ།"]},{"type":"verse","number":11,"content":["ཧི་ཟི་ཀི་ཡཱས་ཁྱོད་ཅག་ལ། རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་འོ་སྐོལ་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ནས་སྐྱོབ་པར་འགྱུར་རོ་སྨྲ་ཞིང་། འདི་ནི་ཁྱོད་ཅག་བཀྲེས་སྐོམ་གྱིས་འཆི་བའི་ཕྱིར་བསླུ་བ་མིན་ནམ།"]},{"type":"verse","number":12,"content":["ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཐོ་གླིང་དང་མཆོད་ཁྲི་རྣམས་བཤིགས་ནས། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་ལ་འདི་ལྟར། ཁྱོད་ཅག་གིས་མཆོད་ཁྲི་གཅིག་གི་མདུན་དུ་བསྙེན་བཀུར་བྱེད་ཅིང་། དེའི་ཁར་བསང་ཐོངས་ཤིག་ཅེས་བསྒོས་པ་མིན་ནམ།"]},{"type":"verse","number":13,"content":["བདག་དང་བདག་གི་མེས་པོ་རྣམས་ཀྱིས་ས་གཞིའི་མི་ཐམས་ཅད་ལ་ཅི་བྱས་པའི་ཆ་ཁྱོད་ཅག་ལ་མེད་དམ། ཡུལ་དེ་དག་གི་མི་སོ་སོའི་ལྷ་རྣམས་ཀྱིས་རང་རང་གི་ཡུལ་བདག་ལས་སྐྱོབ་ནུས་སམ།"]},{"type":"verse","number":14,"content":["ངའི་ཡབ་མེས་ཀྱིས་ཚར་བཅད་པའི་མི་སོ་སོའི་ལྷ་ཐམས་ཅད་ལས། ལྷ་གང་ཞིག་གིས་རང་གི་འབངས་མི་བདག་གི་ལག་ནས་བསྒྲལ་ནུས་པ་ཡིན་ནམ། དེས་ན་ཁྱོད་ཚོའི་དཀོན་མཆོག་གིས་ཁྱོད་ཅག་ངའི་ལག་ནས་བསྒྲལ་ནུས་སམ།"]},{"type":"verse","number":15,"content":["དེའི་ཕྱིར་ད་ནི་ཧི་ཟི་ཀི་ཡཱ་ལ་ཁྱོད་ཅག་ལ་མགོ་བསྐོར་ནས་བསླུ་བར་མ་འཇུག ཁོ་ལ་ཡིད་ཆེས་མ་བྱེད་ཅིག གང་ལ་ཞེ་ན། མི་རིགས་སམ་རྒྱལ་སྲིད་གང་གི་ལྷ་ཡིས་ཀྱང་རང་གི་འབངས་མི་ནི་བདག་གི་ལག་དང་ངའི་ཡབ་མེས་ཀྱི་ལག་ནས་སྐྱོབ་མ་ནུས་པས། ཁྱོད་ཚོའི་དཀོན་མཆོག་གིས་ཁྱོད་ཚོ་ངའི་ལག་ནས་དེ་ལས་ཀྱང་སྐྱོབ་མི་ནུས་པ་མ་ཡིན་ནམ་ཞེས་པའོ་ཞེས་འཕྲིན་བསྐུར་བར་མ་ཟད།"]},{"type":"verse","number":16,"content":["སེན་ན་ཧེ་རིབ་ཀྱི་བློན་འཁོར་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་དང་། ཁོང་གི་ཞབས་ཕྱི་ཧི་ཟི་ཀི་ཡཱ་གཉིས་ལ་སྐུར་འདེབས་ཀྱི་གཏམ་མང་པོ་སྨྲས་པ་དང་།"]},{"type":"verse","number":17,"content":["སེན་ན་ཧེ་རིབ་ཀྱིས་ཡང་འཕྲིན་ཡིག་བྲིས་ཏེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམའ་འབེབས་བྱས་ཤིང་། ཁོང་ལ་འཕྱས་ནས་འདི་ལྟར། མི་རིགས་གཞན་དག་གི་ཡུལ་གྱི་ལྷ་སོ་སོས་རང་གི་འབངས་མི་བདག་གི་ལག་ནས་སྐྱོབ་མ་ནུས་པ་བཞིན་དུ། ཧི་ཟི་ཀི་ཡཱའི་དཀོན་མཆོག་གིས་ཀྱང་རང་གི་འབངས་མི་ངའི་ལག་ནས་སྐྱོབ་མི་ནུས་སོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཨ་སུར་རྒྱལ་པོའི་བློན་འཁོར་རྣམས་ཀྱིས་མཁར་སྟེང་གི་ཡེ་རུ་སཱ་ལེམ་པ་རྣམས་ལ་འཇིགས་སྐུལ་བ་དང་དངང་སྐྲག་བསྐྱེད་ནས། མཁར་ལོན་པའི་ཆེད་དུ་ཡ་ཧུ་དཱའི་སྐད་ཀྱིས་ཅ་ཅོ་ཆེན་པོས་གཏམ་སྨྲས་ཤིང་།"]},{"type":"verse","number":19,"content":["ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་གི་སྐོར་གླེང་བའི་སྐབས་སུ། འཇིག་རྟེན་གྱི་མི་ཀུན་གྱི་ལྷ་རྣམས་ཏེ་མིས་བཟོས་པའི་ལྷ་སྐུ་རྣམས་དང་འདྲ་བའི་ལྟ་སྟངས་བཟུང་བའོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་དང་ཨ་མོ་ཟིའི་བུ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་གཉིས་ཀྱིས་དེའི་ཕྱིར་ནམ་མཁའི་ཕྱོགས་སུ་འོ་དོད་བོས་ནས་གསོལ་བ་བཏབ་པ་ལ།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཕོ་ཉ་ཞིག་དེར་མངགས་ནས། དེས་ཨ་སུར་རྒྱལ་པོའི་དམག་སྒར་གྱི་དཔའ་རྒོད་དང་དམག་དཔོན་ཐམས་ཅད་ཚར་བཅད་ཅིང་། ཨ་སུར་གྱི་རྒྱལ་པོ་ནི་ངོ་གནོངས་ནས་རང་ཡུལ་དུ་ལོག་སྟེ། རང་གི་ལྷ་ཁང་དུ་ཕྱིན་པ་ན། ཁོའི་བུ་རྣམས་ལས་འགའ་ཞིག་གིས་ཁོ་རལ་གྲིས་བསད་དོ། །"]},{"type":"verse","number":22,"content":["དེ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེས་ཧི་ཟི་ཀི་ཡཱ་དང་། ཡེ་རུ་སཱ་ལེམ་པ་ཐམས་ཅད་ཨ་སུར་གྱི་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་དང་གཞན་ཀུན་གྱི་ལག་ནས་བསྒྲལ་བར་མཛད་དེ། ཕྱོགས་ཀུན་ནས་ཁོ་ཚོ་བདེ་ལ་བཀོད་པ་རེད།"]},{"type":"verse","number":23,"content":["དེ་ནས་མི་མང་པོ་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞལ་འདེབས་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་ལ་རིན་པོ་ཆེའི་ཕྱག་རྟེན་ཕུལ་བ་དང་། དེ་ནས་བཟུང་མི་ཐམས་ཅད་ཀྱིས་ཧི་ཟི་ཀི་ཡཱ་ལ་བཀུར་བ་བྱས་སོ། །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱའི་ནད་དང་ང་རྒྱལ།"]},{"type":"verse","number":24,"content":["དེའི་དུས་སུ་ཧི་ཟི་ཀི་ཡཱར་འཆི་བར་ཐུག་པའི་ནད་བྱུང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་པ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ་བཀའ་ལན་གནང་ནས་རྟགས་ངོ་མཚར་ཅན་ཞིག་བསྟན་མོད།"]},{"type":"verse","number":25,"content":["ཁོང་གིས་རང་ལ་ཐོབ་པའི་བཀའ་དྲིན་དང་འཚམ་པའི་གཏང་རག་མ་ཕུལ་བར་སེམས་སུ་ང་རྒྱལ་སྐྱེས་པས། ཡ་ཝཱེའི་ཐུགས་ཁྲོ་ནི་ཁོ་དང་ཡ་ཧུ་དཱ། ཡེ་རུ་སཱ་ལེམ་བཅས་ཀྱི་སྟེང་ལ་བབས།"]},{"type":"verse","number":26,"content":["ཡིན་ཡང་ཧི་ཟི་ཀི་ཡཱས་རང་གི་ང་རྒྱལ་གྱི་རྐྱེན་གྱིས་འགྱོད་བཤགས་བྱས་ཤིང་། ཁོང་དང་ཡེ་རུ་སཱ་ལེམ་པ་ཐམས་ཅད་ཀྱིས་འགྱོད་བཤགས་བྱས་པས། ཧི་ཟི་ཀི་ཡཱའི་སྐུ་རིང་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་དེ་དག་ལ་མ་བབས་སོ། །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱའི་རྒྱུ་ནོར་དང་གཟི་བརྗིད།"]},{"type":"verse","number":27,"content":["ཧི་ཟི་ཀི་ཡཱ་ལ་རྒྱུ་ནོར་དང་གཟི་བརྗིད་ཆེན་པོ་ལྡན་ཏེ། དེས་གསེར་དངུལ་དང་། གཏེར་རྡོ། བསུང་རྫས། ཕུབ། རིན་པོ་ཆེ་རིགས་སྣ་ཚོགས་བཅས་ཀྱི་ཕྱིར་རང་ཉིད་ལ་གཏེར་མཛོད་བརྩིགས་ཤིང་།"]},{"type":"verse","number":28,"content":["ཡང་འབྲུ་དང་། རྒུན་ཆང་དང་། སྣུམ་བཅས་ཀྱི་ཕྱིར་མཛོད་ཁང་དང་། ཕྱུགས་རིགས་སྣ་ཚོགས་ཀྱི་ཕྱིར་ཕྱུགས་ར་དང་ལུག་ར་བཟོས་པ་རེད།"]},{"type":"verse","number":29,"content":["གཞན་ཡང་ཁོང་གིས་རང་གི་ཕྱིར་དུ་གྲོང་ཁྱེར་བརྩིགས་ཏེ། དཀོན་མཆོག་གིས་ཁོང་ལ་རྒྱུ་ནོར་མང་པོ་གནང་བས། བ་གླང་དང་ར་ལུག་གི་ཕྱུགས་ཁྱུ་རབ་ཏུ་མང་པོ་འཕེལ་བའོ། །"]},{"type":"verse","number":30,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་གེ་ཧོན་གྱི་ཆུ་མགོ་བཅད་དེ། ཆུ་དེ་དཱ་བིད་གྲོང་ཁྱེར་གྱི་ནུབ་ཕྱོགས་སུ་ཐུར་དུ་ཕབ་པ་རེད། ཧི་ཟི་ཀི་ཡཱས་ཅི་བྱས་པ་ཐམས་ཅད་ལྷུན་གྱིས་གྲུབ།"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་འགོ་དཔོན་རྣམས་ཧི་ཟི་ཀི་ཡཱའི་རྩར་བང་ཆེན་དུ་མངགས་ནས་ཡུལ་དེར་འོངས་ཏེ། ཡ་ཧུ་དཱ་རུ་བྱུང་བའི་དོན་ངོ་མཚར་ཅན་རྣམས་ལ་རྩད་བཅད་པ་ན། དཀོན་མཆོག་གིས་ཁོང་ལ་ཚོད་བརྟག་མཛད་པ་དང་ཁོོང་གི་སེམས་སུ་ཅི་ཡོད་པ་ཐམས་ཅད་གཟིགས་པའི་ཕྱིར་ཁོང་དང་ཁ་བྲལ་ཏོ། །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱ་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":32,"content":["ཧི་ཟི་ཀི་ཡཱའི་མཛད་རྗེས་གཞན་རྣམས་དང་སྤྱོད་བཟང་རྣམས་ནི། ཨ་མོ་ཟིའི་བུ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་ཞལ་གཟིགས་ཀྱི་མདོ་དང་། ཡ་ཧུ་དཱ་དང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་རབས་ནང་དུ་བཀོད་ཡོད།"]},{"type":"verse","number":33,"content":["ཧི་ཟི་ཀི་ཡཱ་རང་གི་ཕ་མེས་དང་མཉམ་དུ་གཟིམས་ནས། དཱ་བིད་ཀྱི་བུ་རྒྱུད་ཀྱི་དུར་ཁུང་རྣམས་ཀྱི་མཐོ་སར་སྦས་སོ། །ཁོང་སྐུ་གཤེགས་པ་དང་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་ཀུན་གྱིས་ཁོང་ལ་བསྙེན་བཀུར་ཆེན་པོ་བྱས། ཁོང་གི་སྲས་མཱ་ན་ཤེ་ཁོང་གི་ཚབ་ཏུ་རྒྱལ་པོར་བསྡད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/31.json","previousChapterAudioLinks":{},"numberOfVerses":33}