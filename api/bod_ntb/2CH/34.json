{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":34,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱ།"]},{"type":"verse","number":1,"content":["ཡོ་ཤི་ཡཱ་རྒྱལ་པོར་བཞུགས་དུས་དགུང་ལོ་བརྒྱད་ཡིན་ཏེ། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་སུམ་ཅུ་སོ་གཅིག་གི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་ཅིང་། རང་གི་ཡབ་མེས་དཱ་བིད་ཀྱི་ལམ་ནང་འགྲུལ་ཏེ། གཡས་གཡོན་གང་དུའང་མ་གཟུར།"]},{"type":"verse","number":3,"content":["ཁོང་གི་སྲིད་ལོ་བརྒྱད་པར་ད་དུང་ལོ་ན་ཕྲ་བའི་དུས་སུ། ཁོང་གིས་རང་གི་ཡབ་མེས་དཱ་བིད་ཀྱི་དཀོན་མཆོག་འཚོལ་བར་བརྩམས་ཤིང་། ལོ་བཅུ་གཉིས་པ་ནས་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གཙང་མར་མཛད་དེ། མཐོ་གླིང་དང་། ཨ་ཤེ་རཱ། སྐུ་འདྲ། བླུགས་སྐུ་ཐམས་ཅད་མེད་པར་བྱེད་འགོ་ཚུགས་པ་དང་།"]},{"type":"verse","number":4,"content":["མི་རྣམས་ཀྱིས་ཁོང་གི་དྲུང་ནས་པཱ་ཨལ་གྱི་མཆོད་ཁྲི་རྣམས་བཤིགས། ཁོང་གིས་དངོས་སུ་མཆོད་ཁྲི་སྟེང་གི་སྤོས་ཁྲི་མཐོན་པོ་རྣམས་བཅག་པ་དང་། ཡང་ཨ་ཤེ་རཱ་དང་། སྐུ་འདྲ་དང་། བླུགས་སྐུ་རྣམས་བཅག་སྟེ་རྡུལ་དུ་བརླགས་ནས། དེ་དག་ལ་མཆོད་པ་ཕུལ་མྱོང་བ་རྣམས་ཀྱི་དུར་ས་ཐོག་ཏུ་གཏོར།"]},{"type":"verse","number":5,"content":["མཆོད་དཔོན་",{"noteId":9},"རྣམས་ཀྱི་རུས་པ་ནི་དེ་དག་གི་མཆོད་ཁྲིའི་ཁར་བསྲེགས་ནས། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གཙང་མར་མཛད།"]},{"type":"verse","number":6,"content":["ཡང་ཁོང་གིས་མཱ་ན་ཤེ་དང་། ཨེ་ཕཱར་ཡིམ་དང་། སི་མུ་ཨོན་དང་། ནཱབ་ཐ་ལི་བཅས་ཀྱི་གྲོང་ཁྱེར་སོ་སོ་དང་དེ་དག་མཐའ་འཁོར་གྱི་ཡུལ་རྣམས་སུའང་དེ་བཞིན་བྱས།"]},{"type":"verse","number":7,"content":["ཁོང་གིས་མཆོད་ཁྲི་རྣམས་བཤིགས་པ་དང་། ཨ་ཤེ་རཱ་དང་སྐུ་འདྲ་རྣམས་བཅག་ནས་རྡུལ་དུ་བརླགས་པ་དང་། ཡེས་ར་ཨེལ་ཡུལ་ཀུན་གྱི་སྤོས་ཁྲི་རྣམས་བཤིགས་ཏེ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག"]},{"type":"heading","content":["བཀའ་ཁྲིམས་ཀྱི་མདོ་རྙེད་པ།"]},{"type":"verse","number":8,"content":["ཡོ་ཤི་ཡཱའི་སྲིད་ལོ་བཅོ་བརྒྱད་པར། ཡ་ཧུ་དཱའི་ཡུལ་དང་མཆོད་ཁང་གཙང་མར་མཛད་ཟིན་པ་དང་། ཨ་ཙལ་ཡཱའི་བུ་ཤཱ་ཕན་དང་། གྲོང་དཔོན་མ་ཨ་སེ་ཡཱ་དང་། ལོ་རྒྱུས་འགོད་མཁན་ཡོ་ཨ་ཧཱ་ཟིའི་བུ་ཡོ་ཨག་བཅས་ནི་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་གསོ་བྱེད་པའི་ལས་སྒྲུབ་པར་བཏང་ནས།"]},{"type":"verse","number":9,"content":["དེ་དག་མཆོད་དཔོན་ཆེན་པོ་ཧིལ་ཀི་ཡཱའི་དྲུང་དུ་ཕྱིན་ཏེ། དཀོན་མཆོག་གི་མཆོད་ཁང་ལ་ཕུལ་བའི་དངུལ་ཡོད་ཚད་དེར་གཏད་པ་དང་། དངུལ་དེ་ཐམས་ཅད་ནི་ལེ་ཝི་པ་སྒོ་སྲུང་རྣམས་ཀྱིས་མཱ་ན་ཤེ་དང་། ཨེ་ཕཱར་ཡིམ་དང་། ཡེས་ར་ཨེལ་པ་ལྷག་ལུས་ཡོངས་དང་། ཡ་ཧུ་དཱ་དང་། པེན་ཡཱ་མེན་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་བཅས་ལས་བསྡུས་པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཡང་དེ་དག་གིས་དངུལ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་ལྟ་རྟོགས་བྱེད་མཁན་གྱི་ལག་ཏུ་གཏད་དེ། ཡང་ཁོ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་གསོ་བྱེད་པའི་ལག་ཤེས་པ་རྣམས་ཀྱི་ལག་ཏུ་གཏད་དོ། །"]},{"type":"verse","number":11,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱིས་བཤིགས་པའི་ཕོ་བྲང་རྣམས་ཞིག་གསོ་བྱེད་པའི་ཕྱིར་། དེ་དག་གིས་ཤིང་བཟོ་དང་རྡོ་བཟོའི་ལག་ཏུ་དངུལ་གཏད་དེ། འཇམ་ཤ་བཏོད་པའི་རྡོ་དང་སྐྱོར་ཤིང་དང་གདུང་མའི་ཕྱིར་ཤིང་ཆ་བཅས་ཉོས།"]},{"type":"verse","number":12,"content":["མི་དེ་དག་གིས་གཞུང་དྲང་སྒོས་ལས་ཀ་བྱས་ཤིང་། དེ་དག་གི་ལས་དཔོན་ནི་ལེ་ཝི་པ་མཱ་རཱ་རེའེ་ཡི་བུ་རྒྱུད་ཡཱ་ཧད་དང་ཨོ་བད་ཡཱ་ཡིན་པ་དང་། དེ་དག་གི་ལྟ་སྐུལ་ནི་ཀོ་ཧད་ཀྱི་བུ་རྒྱུད་ཟཱ་ཀར་ཡ་དང་མཱེ་ཤུལ་ལིམ་བྱ་བ་ཡིན། དེ་མིན་ད་དུང་རོལ་མོར་མཁས་པའི་ལེ་ཝི་པ་ཐམས་ཅད་ཡོད་ལ།"]},{"type":"verse","number":13,"content":["ཡང་དེ་དག་གིས་ཁུར་མཁན་དང་། ཞབས་ཏོག་གི་ལས་གང་རུང་སྒྲུབ་མཁན་ལ་ལྟ་སྐུལ་བྱེད་པ་དང་། ལེ་ཝི་པའི་ནང་དུ་དྲུང་ཡིག་དང་འགོ་དཔོན། སྒོ་སྲུང་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":14,"content":["ཁོ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་ཕུལ་བའི་དངུལ་ཕྱུང་དུས་སུ། མཆོད་དཔོན་ཧིལ་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་དེ་བཀོད་པའི་བཀའ་ཁྲིམས་ཀྱི་མདོ་རྙེད་ཅིང་།"]},{"type":"verse","number":15,"content":["ཧིལ་ཀི་ཡཱས་དྲུང་ཡིག་པ་ཤཱ་ཕན་ལ་ན་རེ། ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནས་བཀའ་ཁྲིམས་ཀྱི་མདོ་རྙེད་བྱུང་ཞེས་སྨྲས་ནས། ཧིལ་ཀི་ཡཱས་དེ་ཤཱ་ཕན་གྱི་ལག་ཏུ་གཏད།"]},{"type":"verse","number":16,"content":["ཤཱ་ཕན་གྱིས་མདོ་དེ་རྒྱལ་པོའི་དྲུང་དུ་ཕུལ་ནས་རྒྱལ་པོ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་འཁོར་གཡོག་དག་གི་ལག་ཏུ་བཅོལ་བའི་ལས་ཀ་ཡོད་ཚད་དེ་དག་གིས་སྒྲུབ་ཀྱིན་ཡོད།"]},{"type":"verse","number":17,"content":["ཁོ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལས་རྙེད་པའི་དངུལ་དག་བསྡུས་ནས། ལས་དཔོན་དང་ལག་ཤེས་པ་རྣམས་ཀྱི་ལག་ཏུ་གཏད་པ་ཡིན་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་དྲུང་ཡིག་ཤཱ་ཕན་གྱིས་རྒྱལ་པོ་ལ་འདི་ལྟར། མཆོད་དཔོན་ཧིལ་ཀི་ཡཱས་ང་ལ་ཤོག་སྒྲིལ་གྱི་མདོ་འདིའང་སྤྲད་བྱུང་ཞེས་ནས་རྒྱལ་པོའི་དྲུང་དུ་མདོ་དེ་བཀླགས།"]},{"type":"verse","number":19,"content":["ཡང་རྒྱལ་པོས་བཀའ་ཁྲིམས་ཀྱི་གསུང་རྣམས་ཐོས་པ་ཙམ་གྱིས་རང་གི་གོས་བཤགས་ཏེ།"]},{"type":"verse","number":20,"content":["རྒྱལ་པོ་ཧིལ་ཀི་ཡཱ་དང་། ཤཱ་ཕན་གྱི་བུ་ཨ་ཧི་ཀམ་དང་། མི་ཀཱ་ཡི་བུ་ཨབ་དོན་དང་། དྲུང་ཡིག་ཤཱ་ཕན་དང་། རྒྱལ་པོའི་ཞབས་ཕྱི་ཨ་སཱ་ཡཱ་བཅས་ལ་བཀའ་བསྩལ་ནས་ན་རེ།"]},{"type":"verse","number":21,"content":["སོང་ལ། བདག་དང་ཡེས་ར་ཨེལ། ཡ་ཧུ་དཱ་རུ་ལུས་པའི་མི་རྣམས་ཀྱི་དོན་དུ། རང་ཅག་གིས་རྙེད་པའི་མདོ་འདིའི་གསུང་གི་སྐོར་ནས་ཐུགས་བརྟག་ཞུས་ཤིག ཅིའི་ཕྱིར་ཞེ་ན། འོ་སྐོལ་གྱི་ཕ་མེས་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྣམས་མ་བསྲུངས་ལ། མདོ་འདི་ནང་བྲིས་པ་ཐམས་ཅད་བཞིན་དུའང་མ་བྱས་པས། དཀོན་མཆོག་ཡ་ཝཱེ་རང་ཅག་ལ་ཐུགས་རབ་ཏུ་ཁྲོས་པ་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཧིལ་ཀི་ཡཱ་དང་། རྒྱལ་པོས་མངགས་པའི་མི་རྣམས་བུད་མེད་ལུང་སྟོན་པ་ཧུལ་དཱའི་རྩར་ཕྱིན་ཏེ། མོ་ནི་གོས་ཁང་གི་གཉེར་བ་ཤལ་ལུམ་གྱི་ཆུང་མ་ཡིན་ལ། ཡང་ཤལ་ལུམ་ནི་ཧས་རཱའི་ཚ་བོ་དང་། ཐོག་ཧད་ཀྱི་བུའོ། །མོ་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་ཁུལ་གཉིས་པར་སྡོད་པ་དང་། ཁོ་ཚོས་ཡོང་དོན་མོ་ལ་བཤད་ཅིང་།"]},{"type":"verse","number":23,"content":["ཁོ་མོས་དེ་དག་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་ངའི་རྩར་མངག་མཁན་དེ་ལ་འདི་ལྟར་སྦྲོན་ཅིག"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོའི་མདུན་དུ་བཀླགས་པའི་མདོ་ནང་དུ་བྲིས་པའི་དམོད་མོ་ཐམས་ཅད་བཞིན་དུ། ངས་གནས་འདི་དང་འདིར་གནས་པའི་ཡུལ་མིའི་སྟེང་དུ་ཆག་སྒོ་གཏོང་བར་བྱའོ། །"]},{"type":"verse","number":25,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོ་ཚོས་ང་རང་དོར་ནས་ལྷ་གཞན་ལ་སྤོས་བསྒྲོན་པ་དང་། རང་གི་བྱས་པའི་ལས་ཀུན་གྱིས་ངའི་ཁོང་ཁྲོ་བསྐྱེད་པས། ངའི་ཁོང་ཁྲོའི་མེ་ལྕེ་གནས་འདིར་འབབ་ངེས་ཤིང་ནམ་ཡང་ཞི་བར་མི་འགྱུར།"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནས་བརྟག་པ་ཞུ་བར་ཁྱོད་རྣམས་མངགས་མཁན་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཁྱོད་ཀྱིས་ཐོས་པའི་བཀའ་ཡི་སྐོར་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ།"]},{"type":"verse","number":27,"content":["བདག་གིས་གནས་འདི་དང་གནས་འདིར་སྡོད་པ་རྣམས་ལ་གནང་བའི་བཀའ་ཐོས་པ་ཙམ་གྱིས། ཁྱོད་ཀྱི་སེམས་སྙི་མོར་གྱུར་པ་དང་། བདག་གི་མདུན་ནས་ཁེངས་སྐྱུང་བྱས་ཏེ་གོས་གཤགས་ནས་ངུས་པ་ན་ངས་ཀྱང་ཁྱོད་ཀྱི་ཞུ་བར་མཉན་པ་ཡིན། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྱབ་སྟེ།"]},{"type":"verse","number":28,"content":["ལྟོས་དང་། བདག་གིས་ཁྱོད་ནི་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་བསྡུ་བར་བྱ་སྟེ། ཞི་བདེའི་ངང་རང་གི་དུར་ལ་འཇུག་པར་འགྱུར། ངས་གནས་འདི་དང་གནས་འདིའི་ཡུལ་མི་རྣམས་ཀྱི་སྟེང་དུ་འབེབ་པར་བྱ་བའི་ཆག་སྒོ་ཐམས་ཅད་ཁྱོད་ཀྱི་མིག་གིས་མཐོང་བར་མི་འགྱུར་ཞེས་གསུངས་ཞེས་སྨྲས་པ་དང་། ཁོ་ཚོས་བཀའ་དེ་རྒྱལ་པོ་ལ་བསྐྱལ་ཏོ། །"]},{"type":"heading","content":["ཡོ་ཤི་ཡཱས་གཙོ་བོའི་བཀའ་བསྲུང་བར་ཞལ་ཆད་མཛད་པ།"]},{"type":"verse","number":29,"content":["དེ་ནས་རྒྱལ་པོས་བང་ཆེན་བཏང་ནས། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་རྒན་པོ་ཐམས་ཅད་བསྡུས་ཏེ།"]},{"type":"verse","number":30,"content":["རྒྱལ་པོ་དང་ཡ་ཧུ་དཱ་པ་དང་། ཡེ་རུ་སཱ་ལེམ་པ་ཐམས་ཅད་དང་། མཆོད་དཔོན་རྣམས་དང་ལེ་ཝི་པ་དང་མི་རིགས་ཆེ་ཆུང་ཡོད་དོ་ཅོག་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཡར་སོང་ནས། རྒྱལ་པོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནས་རྙེད་པའི་ཞལ་ཆད་ཀྱི་མདོ་ཡི་བཀའ་ཐམས་ཅད་དེ་རྣམས་ཀྱི་མདུན་དུ་བསྒྲགས་ནས།"]},{"type":"verse","number":31,"content":["རྒྱལ་པོ་རང་གི་འདུག་སར་བཞེངས་ཏེ། བློ་གཅིག་སེམས་གཅིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲང་བ་དང་། ཁོང་གི་བཀའ་རྒྱ་དང་དཔང་ཡིག ཁྲིམས་སྲོལ་བཅས་པ་གཟབ་ནན་གྱིས་བསྲུངས་ནས། མདོ་འདིའི་ནང་དུ་བཀོད་པའི་ཞལ་ཆད་ཀྱི་བཀའ་བཞིན་དུ་སྤྱོད་པའི་ཐད་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཞལ་ཆད་མཛད་དོ། །"]},{"type":"verse","number":32,"content":["ཡང་ཁོང་གིས་ཡེ་རུ་སཱ་ལེམ་དང་པེན་ཡཱ་མེན་དུ་སྡོད་པའི་མི་ཐམས་ཅད་ལ་ཞལ་ཆད་དེ་བསྲུང་དུ་བཅུག་པ་དང་། དེ་ནས་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་ཐམས་ཅད་ཀྱིས་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་གི་ཞལ་ཆད་བཞིན་དུ་སྤྱོད་པ་སྤྱད་དོ། །"]},{"type":"verse","number":33,"content":["དེ་ནས་ཡོ་ཤི་ཡཱས་ཡེས་ར་ཨེལ་པ་ལ་གཏོགས་པའི་ཡུལ་ཀུན་ནས་ཞེན་ལོག་གི་སྐུ་འདྲ་ཐམས་ཅད་མེད་པར་བཟོས་ནས། ཡེས་ར་ཨེལ་ཡུལ་ཁམས་སུ་གནས་པ་ཀུན་ལ་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞབས་ཕྱི་སྒྲུབ་ཏུ་བཅུག་པས། ཡོ་ཤི་ཡཱའི་སྐུ་རིང་ལ་མི་རྣམས་རང་གི་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲངས་པ་ལས་མ་བྱོལ་ཏོ། །"]}],"footnotes":[{"noteId":9,"caller":"+","text":"འདིར་མཆོད་དཔོན་ཞེས་པ་ནི་ཆོས་ལོག་པའི་མཆོད་དཔོན་རྣམས་ལ་འཇུག","reference":{"chapter":34,"verse":5}}]},"thisChapterLink":"/api/bod_ntb/2CH/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/33.json","previousChapterAudioLinks":{},"numberOfVerses":33}