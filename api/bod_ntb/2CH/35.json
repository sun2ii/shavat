{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":35,"content":[{"type":"heading","content":["ཡོ་ཤི་ཡཱ་ཡིས་པེ་སག་དུས་ཆེན་བསྲུངས་པ།"]},{"type":"verse","number":1,"content":["ཡོ་ཤི་ཡཱ་ཡིས་ཡེ་རུ་སཱ་ལེམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་པེ་སག་དུས་ཆེན་བསྲུངས་པ་དང་། ཟླ་དང་པོའི་ཚེས་བཅུ་བཞི་ཉིན་དེ་དག་གིས་པེ་སག་དུས་ཆེན་གྱི་ལུ་གུ་བཤས་ཏེ།"]},{"type":"verse","number":2,"content":["རྒྱལ་པོས་མཆོད་དཔོན་རྣམས་ལ་རང་རང་གི་ལས་འགན་བསྐོས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལས་ཀ་རྣམས་བསྒྲུབ་པར་བསྐུལ།"]},{"type":"verse","number":3,"content":["ཡང་ཁོང་གིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་བསླབ་བྱ་གནང་མཁན་དང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དམ་པར་བྱས་པའི་ལེ་ཝི་པ་དག་ལ་འདི་ལྟར། ཁྱོད་ཚོས་དཀོན་མཆོག་གི་དམ་པའི་ཤུར་སྒམ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དཱ་བིད་ཀྱི་སྲས་སོ་ལོ་མོན་གྱིས་བཞེངས་པའི་མཆོད་ཁང་དུ་འཇོག་པ་ལས་ཡང་བསྐྱར་ཕྲག་ལ་འཁུར་མི་དགོས་ཏེ། ད་ལྟ་ཁྱོད་ཚོས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁོང་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་ཞབས་ཕྱི་བསྒྲུབ་དགོས།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཚོས་རང་གི་ཁྱིམ་རྒྱུད་དང་ལས་རེས་བཞིན་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དཱ་བིད་ཀྱི་མདོ་དང་ཁོང་གི་སྲས་སོ་ལོ་མོན་གྱིས་ཡི་གེར་བཀོད་པ་ལྟར་གྲ་སྒྲིག་བྱེད་དགོས།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཚོ་རང་རང་གི་ཉེ་འབྲེལ་ཏེ། མི་སེར་དཀྱུས་མའི་ཁྱིམ་རྒྱུད་ཀྱི་ལས་རེས་ལྟར་དམ་པའི་གནས་སུ་ལངས་སྡོད་དགོས་ལ། ལས་རེས་རེ་རེར་ལེ་ཝིའི་ཁྱིམ་རྒྱུད་ཀྱི་མི་ཁ་ཤས་ཡོད་དགོས།"]},{"type":"verse","number":6,"content":["ཁྱོད་ཚོས་པེ་སག་དུས་ཆེན་གྱི་ལུ་གུ་བཤས་ནས་རང་ཉིད་དམ་པར་བྱེད་དགོས་ལ། རང་གི་ཉེ་འབྲེལ་གྱི་ཆེད་དུ་ཐམས་ཅད་གྲ་སྒྲིག་བྱེད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་བརྩི་དགོས་ཞེས་སྨྲས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཡོ་ཤི་ཡཱ་ཡིས་ལུ་གུ་དང་རེའུ་བསྡོམས་པས་ཁྲི་གསུམ་དང་། གླང་ཐུག་སུམ་སྟོང་བཅས་གནས་དེར་ཡོད་པའི་མི་ཐམས་ཅད་ལ་པེ་སག་གི་མཆོད་པ་འབུལ་བའི་ཆེད་དུ་གནང་སྟེ། འདི་ཐམས་ཅད་ནི་རྒྱལ་པོ་རང་ཉིད་ཀྱི་རྒྱུ་ནོར་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཡོ་ཤི་ཡཱའི་ལག་འོག་གི་འགོ་དཔོན་རྣམས་ཀྱིས་ཀྱང་མཆོད་རྫས་དག་མི་རྣམས་དང་མཆོད་དཔོན། ལེ་ཝི་པ་བཅས་ལ་རང་མོས་ཀྱིས་སྤྲད་ཅིང་། ཡང་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་སྤྱི་གཉེར་ཏེ་ཧིལ་ཀི་ཡཱ་དང་ཟཱ་ཀར་ཡ། ཡེ་ཧི་ཨེལ་བཅས་ཀྱིས་ཀྱང་ལུ་གུ་ཉིས་སྟོང་དྲུག་བརྒྱ་དང་གླང་ཐུག་སུམ་བརྒྱ་པེ་སག་དུས་ཆེན་གྱི་མཆོད་རྫས་སུ་མཆོད་དཔོན་ལག་ཏུ་བཞག"]},{"type":"verse","number":9,"content":["ལེ་ཝི་པའི་འགོ་དཔོན་ཀོ་ནན་ཡཱ་དང་། དེའི་སྤུན་ཤེ་མ་ཡཱ་དང་ནེ་ཐན་ཨེལ་བཅས་དང་། ཧ་ཤབ་ཡཱ་དང་ཡེ་ཨི་ཨེལ། ཡོ་ཟཱ་བད་བཅས་ཀྱིས་ཀྱང་ལུ་གུ་ལྔ་སྟོང་དང་གླང་ཐུག་ལྔ་བརྒྱ་པེ་སག་དུས་ཆེན་གྱི་མཆོད་རྫས་སུ་ལེ་ཝི་པའི་ལག་ཏུ་བཞག"]},{"type":"verse","number":10,"content":["དེ་ལྟར་ཞབས་ཕྱི་སྒྲུབ་པའི་ལས་ཡོངས་གྲ་སྒྲིག་བྱས་ཚར་རྗེས། རྒྱལ་པོའི་བཀའ་བཞིན་ཏུ་མཆོད་དཔོན་རྣམས་རང་རང་གི་ལས་གནས་སུ་འགྲེང་པ་དང་། ལེ་ཝི་པ་རྣམས་ཀྱང་རང་རང་གི་ལས་རེས་བཞིན་ལངས་ནས་བསྡད།"]},{"type":"verse","number":11,"content":["ལེ་ཝི་པ་རྣམས་ཀྱིས་པེ་སག་དུས་ཆེན་ལ་གྲ་སྒྲིག་བྱས་བའི་ལུ་གུ་བཤས་ཏེ། ལེ་ཝི་པས་པགས་པ་བཤུས་པ་དང་། མཆོད་དཔོན་རྣམས་ཀྱིས་དེ་ཚོའི་ལག་ནས་ལུ་གུའི་ཁྲག་བླངས་ཏེ་མཆོད་ཁྲིའི་ཁར་གཏོར་རྗེས།"]},{"type":"verse","number":12,"content":["སྦྱིན་སྲེག་གི་ཤ་རྣམས་ཁྱེར་ནས་ཁྱིམ་རྒྱུད་སོ་སོའི་ནང་ཚན་བཞིན་མི་ཀུན་ལ་བགོས་ཏེ། མོ་ཤེས་བཀོད་པའི་བཀའ་ཁྲིམས་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་ཕུལ་བ་དང་། གླང་ཐུག་རྣམས་ཀྱང་དེ་ལྟར་ཕུལ་ཏོ། །"]},{"type":"verse","number":13,"content":["ཡང་ལུགས་སྲོལ་ལྟར་པེ་སག་དུས་ཆེན་ལ་བཤས་པའི་ལུ་གུ་མེས་བསྲེགས་ཏེ། མཆོད་རྫས་དམ་པ་གཞན་དག་ནི་ཁོ་ཚོས་རྫ་ཁོག་དང་སླ་ང་དང་། བསྲེགས་སླང་སོགས་ཀྱི་ནང་དུ་བཙོས་ནས་མྱུར་བ་མྱུར་དུ་མི་རྣམས་ལ་སྤྲད།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཁོ་ཚོས་ད་གཟོད་རང་ཉིད་དང་མཆོད་དཔོན་རྣམས་ཀྱི་ཆེད་དུ་མཆོད་རྫས་གྲ་སྒྲིག་བྱས་ཏེ། ཅི་ལ་ཞེ་ན། མཆོད་དཔོན་ཨ་རོན་གྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཀྱིས་དགོང་མོའི་བར་དུ་སྦྱིན་སྲེག་དང་ཚིལ་འབུལ་དགོས་པས། ལེ་ཝི་པ་རྣམས་ཀྱིས་རང་ཉིད་དང་མཆོད་དཔོན་ཨ་རོན་གྱི་བུ་རབས་ཚ་རྒྱུད་དག་ལ་མཆོད་རྫས་གྲ་སྒྲིག་བྱས།"]},{"type":"verse","number":15,"content":["བསྟོད་དབྱངས་འབུལ་མཁན་ཨ་སབ་ཀྱི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཀྱིས་དཱ་བིད་དང་ཨ་སབ། ཧེ་མཱན། རྒྱལ་པོའི་མངོན་ཤེས་པ་ཡེ་དུ་ཐུན་བཅས་ཀྱིས་བསྒོས་པ་བཞིན། རང་རང་གི་ལས་གནས་སུ་བསྡད་ཅིང་། སྒོ་སྲུང་རྣམས་ཀྱིས་སྒོ་རྣམས་སྲུང་བ་ལས་རང་ཉིད་ཀྱི་ལས་འགན་དང་འབྲལ་མི་དགོས་ཏེ། ཅི་ལ་ཞེ་ན། ཁོ་ཚོའི་ཉེ་འབྲེལ་ལེ་ཝི་པ་རྣམས་ཀྱིས་ཁོ་ཚོའི་དོན་དུ་མཆོད་རྫས་གྲ་སྒྲིག་བྱས་པ་རེད།"]},{"type":"verse","number":16,"content":["དེ་བཞིན་ཉིན་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞབས་ཏོག་སྒྲུབ་པའི་ལས་འགན་ཐམས་ཅད་བཀོད་སྒྲིག་བརྒྱབ་པ་དང་། རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་ཡིས་བསྒོས་པ་བཞིན་པེ་སག་དུས་ཆེན་བསྲུངས་ཤིང་། ད་དུང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁྲི་སྟེང་དུ་སྦྱིན་སྲེག་ཕུལ།"]},{"type":"verse","number":17,"content":["སྐབས་དེར་གནས་དེ་རུ་ཡོད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་པེ་སག་དུས་ཆེན་བསྲུངས་པ་དང་། ཡང་ཉིན་བདུན་ལ་སྐྱུར་མེད་བག་ལེབ་ཀྱི་དུས་ཆེན་བསྲུངས།"]},{"type":"verse","number":18,"content":["ལུང་སྟོན་པ་སཱ་མུ་ཨེལ་བྱུང་བ་ནས་བཟུང་། ཡེས་ར་ཨེལ་གྱི་ནང་དུ་སུས་ཀྱང་པེ་སག་དུས་ཆེན་དེ་ལྟ་བུ་བསྲུངས་མ་མྱོང་སྟེ། ཡོ་ཤི་ཡཱ་དང་མཆོད་དཔོན་རྣམས། ལེ་ཝི་པ་རྣམས། ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་དང་གནས་དེར་འཛོམས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་བཅས་དང་། ད་དུང་ཡེ་རུ་སཱ་ལེམ་དུ་སྡོད་པའི་ཡུལ་མི་དག་གིས་པེ་སག་དུས་ཆེན་བསྲུངས་པ་ལྟར་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཀྱང་བསྲུངས་མ་མྱོང་ངོ་། །"]},{"type":"verse","number":19,"content":["པེ་སག་དུས་ཆེན་དེ་ནི་ཡོ་ཤི་ཡཱ་རྒྱལ་པོར་བསྡད་པའི་ལོ་བཅོ་བརྒྱད་པ་ལ་བསྲུངས་པ་ཡིན།"]},{"type":"heading","content":["ཡོ་ཤི་ཡཱ་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":20,"content":["ཡོ་ཤི་ཡཱ་ཡིས་མཆོད་ཁང་གི་ཆེད་དུ་ལས་ཀ་ཡོད་ཚད་བསྒྲུབས་ཚར་རྗེས། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ནེ་ཀོ་ཡར་འོངས་ཏེ། ཕི་རཱད་ཆུ་བོ་དང་ཉེ་བའི་ཀར་ཀེ་མི་སི་གྲོང་ཁྱེར་ལ་དམག་དྲངས་པ་དང་། ཡོ་ཤི་ཡཱ་ཕྱི་རུ་ཁོ་དང་འགྲན་དུ་སོང་།"]},{"type":"verse","number":21,"content":["ནེ་ཀོ་ཡིས་ཡོ་ཤི་ཡཱ་ཡི་རྩར་བང་ཆེན་མངགས་ཏེ་ན་རེ། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ལགས། བདག་ནི་ཁྱོད་དང་འབྲེལ་བ་ཅི་ཡོད་དམ། བདག་ནི་དེ་རིང་ཁྱོད་དང་དམག་རྒྱག་ཏུ་འོངས་པ་མིན་ལ། བདག་དང་འཐབ་པའི་རྒྱལ་ཁམས་ལ་དམག་རྒྱག་ཏུ་འོངས་ཏེ། དེ་ནི་དཀོན་མཆོག་གིས་བདག་ལ་བསྐུལ་བ་ཡིན་པས། ཁྱོད་ཀྱིས་བདག་དང་མཉམ་དུ་བཞུགས་པའི་དཀོན་མཆོག་ལ་ངོ་རྒོལ་མ་བྱེད་ཅིག ཅི་ལ་ཞེ་ན། ཁོང་གིས་ཁྱོད་རང་མེད་པར་མི་མཛད་པའི་ཆེད་དུ་ཡིན་ནོ་ཞེས་སྨྲས་ནའང་།"]},{"type":"verse","number":22,"content":["ཡོ་ཤི་ཡཱ་ཁོ་དང་མི་འབྲལ་བར་མ་ཟད། ཆས་གོས་བསྒྱུར་ནས་ཁོ་དང་དམག་རྒྱག་པར་བརྩམས་ཤིང་དཀོན་མཆོག་གིས་ནེ་ཀོ་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་ལ་མ་མཉན་པར། མེ་གིད་དོ་བདེ་ཐང་དུ་འོངས་ཏེ་ནེ་ཀོ་དང་དམག་བརྒྱབ།"]},{"type":"verse","number":23,"content":["མདའ་བའི་མདའ་ཡོ་ཤི་ཡཱ་ལ་ཕོག་སྟེ། རྒྱལ་པོས་རང་གི་འཁོར་གཡོག་ལ་འདི་ལྟར། བདག་ལ་རྨས་སྐྱོན་ཚབས་ཆེན་བྱུང་བས་ཁྱོད་ཚོས་ང་རང་གཡུལ་ས་ནས་ཁྱེར་ཅིག་ཅེས་བསྒོས་པ་ན།"]},{"type":"verse","number":24,"content":["ཁོང་གི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཁོ་རང་བསྐྱོར་ནས་ཤིང་རྟ་ལས་འབབ་དུ་བཅུག་སྟེ། ཡང་ཤིང་རྟ་གཞན་ཞིག་ལ་བསྡད་དེ་ཡེ་རུ་སཱ་ལེམ་དུ་བསྐྱལ་བ་ན། ཁོང་ཚེ་ལས་འདས་པ་དང་རང་གི་ཕ་མེས་ཀྱི་དུར་ལ་སྦས། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་ཐམས་ཅད་ཀྱིས་ཡོ་ཤི་ཡཱའི་ཆེད་དུ་མྱ་ངན་བྱས་སོ། །"]},{"type":"verse","number":25,"content":["ཡེ་རེམ་ཡཱ་ཡིས་ཡོ་ཤི་ཡཱའི་དོན་དུ་སྐྱོ་གླུ་བརྩམས་པ་དང་། མགུར་ལེན་མཁན་སྐྱེས་ཕོ་མོ་ཡོད་ཚད་ཀྱིས་སྐྱོ་གླུ་ལངས་ནས་དེ་རིང་གི་བར་དུ་ཡོ་ཤི་ཡཱ་ལ་མྱ་ངན་བྱས། དེ་ནི་ཐ་ན་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་རྒྱུན་སྲོལ་ཞིག་ཏུ་ཆགས། ལྟོས་ཤིག དེ་དག་ནི་སྐྱོ་གླུའི་མདོ་རུ་བཀོད་ཡོད།"]},{"type":"verse","number":26,"content":["ཡང་ཡོ་ཤི་ཡཱའི་མཛད་རྗེས་གཞན་དག་དང་། ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་ལྟར་བསྒྲུབས་པའི་ལས་བཟང་པོ་ཐམས་ཅད་དང་།"]},{"type":"verse","number":27,"content":["ད་དུང་ཁོང་གི་མཛད་རྗེས་རྣམས་འགོ་ནས་མཇུག་བར་དུ་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱའི་རྒྱལ་རབས་ནང་དུ་བཀོད་ཡོད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/34.json","previousChapterAudioLinks":{},"numberOfVerses":27}