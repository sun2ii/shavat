{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CH","translationId":"bod_ntb","name":"སྔོན་རབས་གཉིས་པ།","commonName":"སྔོན་རབས་གཉིས་པ།","title":"༄༅། །སྔོན་རབས་ཀྱི་མདོ་གཉིས་པ།","order":14,"numberOfChapters":36,"sha256":"74fbc854ad0c02d7ce90ded5f64624f764ae936b503b406ab59fbdef96d8dc21","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":9,"content":[{"type":"heading","content":["ཤེ་བཱ་ཡི་རྒྱལ་མོ་སོ་ལོ་མོན་ལ་མཇལ་དུ་འོངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཤེ་བཱ་ཡི་རྒྱལ་མོས་སོ་ལོ་མོན་གྱི་སྙན་གྲགས་ཐོས་ནས། དཀའ་གནད་ཀྱིས་སོ་ལོ་མོན་ལ་ཚོད་བགམ་བྱེད་དགོས་བསམས་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས། མོར་རྗེས་འབྲང་མང་པོ་ཡོད་པ་དང་། ཡང་བསུང་རྫས་དང་། གསེར་མང་པོ་དང་། རིན་པོ་ཆེ་རྣམས་རྔ་མོང་ལ་བཀལ་ནས་འོངས་པ་དང་། མོ་རང་སོ་ལོ་མོན་ཡོད་སར་སླེབས་ཏེ་སེམས་སུ་ཅི་ཡོད་པ་ཐམས་ཅད་ཁོང་ལ་སྨྲས།"]},{"type":"verse","number":2,"content":["སོ་ལོ་མོན་གྱིས་མོའི་དྲི་བ་ཐམས་ཅད་ལ་ལན་བཏབ་ཅིང་། ཁོང་གིས་དོན་མི་རྟོགས་པ་དང་ལན་འདེབས་མི་ནུས་པ་གཅིག་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":3,"content":["ཤེ་བཱ་ཡི་རྒྱལ་མོས་སོ་ལོ་མོན་གྱི་ཤེས་རབ་དང་ཁོང་གིས་བཞེངས་པའི་ཕོ་བྲང་དང་།"]},{"type":"verse","number":4,"content":["ཁོང་གི་གསོལ་ལྕོག་སྟེང་གི་ཁ་ཟས་དང་། བློན་པོ་རྣམས་ཀྱི་བཞུགས་གྲལ་དང་། ཞབས་ཕྱི་རྣམས་ཀྱི་ཞབས་ཏོག་དང་དེ་དག་གི་གྱོན་གོས་དང་། ཆང་གཉེར་བློན་ཆེན་དང་དེ་དག་གི་གྱོན་གོས་དང་། སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕུལ་བའི་སྦྱིན་སྲེག་བཅས་མཐོང་བ་དང་ཤིན་ཏུ་ངོ་མཚར་བར་གྱུར།"]},{"type":"verse","number":5,"content":["དེ་ནས་མོས་རྒྱལ་པོ་ལ། ངས་རང་གི་ཡུལ་དུ་ཐོས་པའི་ཁྱེད་ཀྱི་མཛད་པ་དང་ཁྱེད་ཀྱི་ཤེས་རབ་ཐད་ཀྱི་གཏམ་ནི་ཐམས་ཅད་བདེན་འདུག"]},{"type":"verse","number":6,"content":["ང་རང་སྔོན་ཆད་གཏམ་དེ་དག་ལ་ཡིད་མ་ཆེས། འོན་ཀྱང་ང་འདིར་སླེབས་ནས་དངོས་སུ་མཐོང་བས། ད་གཟོད་ཁྱེད་ཀྱི་ཤེས་རབ་རླབས་ཆེ་ཞིང་མི་ཡིས་སྨྲས་པ་ནི་དེའི་ཕྱེད་ཀ་ཙམ་ལ་ཡང་སླེབས་མེད་པ་རྟོགས་བྱུང་། ཁྱེད་རང་མཇལ་བ་ནི་ཁྱེད་ཀྱི་སྙན་གྲགས་ཐོས་པ་ལས་དངོས་གནས་ལྷག་པའོ། །"]},{"type":"verse","number":7,"content":["ཁྱེད་ཀྱི་འཁོར་གཡོག་རྣམས་བདེའོ། །ཁྱེད་ཀྱི་བློན་པོ་རྣམས་བདེའོ། །ཅི་ལ་ཞེ་ན། ཁོ་རྣམས་དུས་རྒྱུན་དུ་ཁྱེད་ཀྱི་དྲུང་དུ་ལངས་བསྡད་ནས་ཁྱེད་ཀྱི་ཤེས་རབ་ལ་མཉན་ཐུབ་པའོ། །"]},{"type":"verse","number":8,"content":["ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་བསྟོད་བསྔགས་བརྗོད་འོས་པ་ཡིན་ཏེ། ཁོང་ཁྱེད་ལ་མཉེས་པས་ཁྱེད་རང་ཁོང་གི་རྒྱལ་ཁྲིར་བཀོད་ཅིང་། ཁྱེད་ནི་ཡ་ཝཱེ་སྟེ་ཁྱེད་ཀྱི་དཀོན་མཆོག་གི་ཕྱིར་དུ་རྒྱལ་པོར་བསྐོས། ཁྱེད་ཀྱི་དཀོན་མཆོག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བྱམས་ཤིང་ཁོ་རྣམས་རྒྱུན་ནས་རྒྱུན་དུ་བརྟན་པོར་མཛད་པའི་ཕྱིར་དུ། དྲང་གཞག་དང་དྲང་བདེན་སྐྱོང་བར་ཁྱེད་རང་དེ་དག་གི་རྒྱལ་པོར་བསྐོས་པ་ཡིན་ཞེས་བརྗོད་ནས།"]},{"type":"verse","number":9,"content":["ཤེ་བཱ་ཡི་རྒྱལ་མོས་རྒྱལ་པོ་སོ་ལོ་མོན་ལ་གསེར་རྡོ་ཚད་བརྒྱ་དང་ཉི་ཤུ་དང་། བྲོ་སྨན་མོད་པོ་དང་རིན་པོ་ཆེ་མང་པོ་ཕུལ། ཤེ་བཱ་ཡི་རྒྱལ་མོས་རྒྱལ་པོ་སོ་ལོ་མོན་ལ་ཕུལ་བའི་བྲོ་སྨན་སྤུས་ལེགས་དེ་འདྲ་སྔར་ཡོད་མ་མྱོང་བ་ཞིག་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["ཧི་རཱམ་དང་སོ་ལོ་མོན་གྱི་ཞབས་ཕྱི་དག་གིས་ཨོ་ཕིར་ནས་གསེར་དང་། ཙན་དན་གྱི་གདུང་མ་དང་། རིན་པོ་ཆེ་རྣམས་དྲངས་འོངས་པ་དང་།"]},{"type":"verse","number":11,"content":["རྒྱལ་པོས་ཙན་དན་ཤིང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་རྒྱལ་པོའི་ཕོ་བྲང་གི་ཕྱིར་དུ་ཐེམ་སྐས་ལས་པ་དང་། ཡང་མགུར་ལེན་མཁན་རྣམས་ཀྱི་ཕྱིར་པི་ཝང་དང་རྒྱུད་མངས་བཟོ་རུ་བཅུག་སྟེ། དེ་ལྟ་བུ་རྣམས་སྔར་ཡ་ཧུ་དཱ་ཡུལ་དུ་མཐོང་མྱོང་བ་མེད་དོ། །"]},{"type":"verse","number":12,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཤེ་བཱ་ཡི་རྒྱལ་མོས་ཁོང་ལ་ཅི་ཕུལ་བ་བཞིན་དུ་ཕྱིར་ཕྱག་རྟེན་ཕུལ་ཞིང་། ཡང་དེའི་ཁར་རྒྱལ་མོའི་འདོད་པ་བཞིན་ཅི་དང་ཅི་ཞུས་པ་ཐམས་ཅད་མོ་ལ་ཕུལ་ནས། རྒྱལ་མོ་འཁོར་དང་བཅས་པ་ཕྱིར་རང་ཡུལ་དུ་ལོག་གོ །"]},{"type":"heading","content":["སོ་ལོ་མོན་གྱི་རྒྱུ་ནོར།"]},{"type":"verse","number":13,"content":["ཡང་རྒྱལ་པོ་སོ་ལོ་མོན་ལ་ལོ་རེར་ཐོབ་པའི་གསེར་གྱི་ལྗིད་ཚད་ནི་རྡོ་ཚད་དྲུག་བརྒྱ་དང་དྲུག་ཅུ་རེ་དྲུག་ཡིན་ལ།"]},{"type":"verse","number":14,"content":["གཞན་ཡང་ཚོང་པ་དང་ཚོང་འགྲིམ་པ་དག་གིས་ཕུལ་བ་དང་། ཨ་རབ་ཡུལ་གྱི་རྒྱལ་པོ་རྣམས་དང་རང་རྒྱལ་གྱི་སྤྱི་དཔོན་རྣམས་ཀྱིས་ཀྱང་སོ་ལོ་མོན་ལ་གསེར་དངུལ་ཕུལ་བ་ཡིན།"]},{"type":"verse","number":15,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་གསེར་བརྡུངས་མས་ཕུབ་ཆེན་ཉིས་བརྒྱ་བཟོས་ཤིང་། ཕུབ་ཆེན་རེ་ལ་གསེར་སྲང་དྲུག་བརྒྱ་རེ་སོང་།"]},{"type":"verse","number":16,"content":["ཡང་གསེར་བརྡུངས་མས་ཕུབ་ཆུང་སུམ་བརྒྱ་བཟོས་ཤིང་། ཕུབ་ཆུང་རེ་ལ་གསེར་སྲང་སུམ་བརྒྱ་རེ་སོང་། རྒྱལ་པོས་ཕུབ་དེ་དག་ནི་ལེ་པཱ་ནོན་གླིང་གའི་ཕོ་བྲང་དུ་བཞག"]},{"type":"verse","number":17,"content":["རྒྱལ་པོས་བ་སོས་བཞུགས་ཁྲི་ཆེན་པོ་ཞིག་བཟོས་ནས་དེ་གསེར་བཙོ་མས་གཡོགས།"]},{"type":"verse","number":18,"content":["བཞུགས་ཁྲི་དེ་ལ་ཐེམ་སྐས་དྲུག་ཡོད་ཅིང་། གསེར་གྱི་ཞབས་སྟེགས་ཤིག་ཁྲི་ལ་སྦྱར་ཏེ་ཡོད། ཡང་བཞུགས་སའི་ཕྱོགས་གཉིས་སུ་ལག་སྐྱོར་ཡོད་ལ། ལག་སྐྱོར་རེའི་འགྲམ་དུ་སེང་གེ་རེ་ལངས་ཡོད་དོ། །"]},{"type":"verse","number":19,"content":["ཡང་ཐེམ་སྐས་རིམ་པ་དྲུག་པོའི་གཡས་ཕྱོགས་སུ་སེང་གེ་དྲུག་དང་། གཡོན་ཕྱོགས་སུ་སེང་གེ་དྲུག་བཅས་སེང་གེ་བཅུ་གཉིས་ཡོད་པ་ཡིན། དེ་འདྲ་བ་ཞིག་རྒྱལ་ཁམས་གང་དུ་ཡང་མ་བཟོས་སོ། །"]},{"type":"verse","number":20,"content":["ཡང་རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་སྐྱོགས་ཐམས་ཅད་གསེར་གྱིས་བཟོས་པ་དང་། ལེ་པཱ་ནོན་གླིང་གའི་ཕོ་བྲང་ནང་གི་ཡོ་བྱད་མཐའ་དག་གསེར་བཙོ་མས་བཟོས་པ་ཡིན། སོ་ལོ་མོན་གྱི་སྐུ་རིང་དུ་དངུལ་ལ་རིན་ཐང་ཅི་ཡང་མེད་དོ། །"]},{"type":"verse","number":21,"content":["གང་ལ་ཞེ་ན། རྒྱལ་པོའི་གྲུ་གཟིངས་རྣམས་ཧི་རཱམ་གྱི་ཞབས་ཕྱི་དག་དང་ལྷན་དུ་ཐཱར་ཞིས་ལ་འགྲོ་བ་དང་། ཐཱར་ཞིས་ལ་ཕྱིན་པའི་གྲུ་གཟིངས་རྣམས་ལོ་གསུམ་རེའི་ནང་དུ་གསེར་དང་། དངུལ་དང་། བ་སོ་དང་། སྤྲེའུ་དང་། རྨ་བྱ་བཅས་བཀལ་ནས་ཐེངས་གཅིག་ལ་ཕྱིར་སླེབས་པ་ཡིན།"]},{"type":"verse","number":22,"content":["རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་འབྱོར་བ་དང་ཤེས་རབ་ནི་ས་གཞིའི་རྒྱལ་པོ་ཐམས་ཅད་ལས་བརྒལ་བ་ཡིན།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་གིས་སོ་ལོ་མོན་ལ་གནང་བའི་ཤེས་རབ་ཐོས་པའི་ཕྱིར་དུ། ས་གཞིའི་རྒྱལ་པོ་ཐམས་ཅད་ཁོང་གི་ཞལ་མཇལ་དུ་བསྙེགས་པ་ཡིན།"]},{"type":"verse","number":24,"content":["དེ་དག་རེ་རེས་ཁྱེར་འོངས་པའི་ཕྱག་རྟེན་ལ་དངུལ་ཆས་དང་གསེར་ཆས། གྱོན་གོས། མཚོན་ཆ། བསུང་རྫས། རྟ། དྲེལ་བཅས་ཡོད་ཅིང་། ལོ་ནས་ལོ་ལ་གྲངས་མང་པོ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":25,"content":["སོ་ལོ་མོན་ལ་རྟ་ར་བཞི་སྟོང་གི་རྟ་དང་ཤིང་རྟ་ཡོད་པ་དང་། ད་དུང་བཞོན་རྟ་ཆིག་ཁྲི་ཉིས་སྟོང་ཡོད་ལ། ཁོང་གིས་དེ་རྣམས་ཤིང་རྟའི་གྲོང་ཁྱེར་དང་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་པོ་བཞུགས་སར་བཞག"]},{"type":"verse","number":26,"content":["སོ་ལོ་མོན་གྱིས་ཕི་རཱད་ཆུ་བོ་ནས་ཕེ་ལེ་ཤེད་མི་རིགས་ཀྱི་ཡུལ་དང་། དེ་ནས་ཨེ་ཅིབ་ཡུལ་གྱི་ས་མཚམས་བར་དུ་རྒྱལ་པོ་ཐམས་ཅད་ལ་དབང་སྒྱུར་ཏོ། །"]},{"type":"verse","number":27,"content":["རྒྱལ་པོས་ཡེ་རུ་སཱ་ལེམ་ལ་དངུལ་ནི་རྡོ་བཞིན་དང་། ཐང་ཤིང་ནི་རི་ཀླུང་དུ་སྐྱེས་པའི་འོ་སེ་ཤིང་ལྟར་མོད་པར་མཛད།"]},{"type":"verse","number":28,"content":["མི་རྣམས་ཀྱིས་ཨེ་ཅིབ་དང་ཡུལ་སོ་སོ་ནས་སོ་ལོ་མོན་གྱི་ཕྱིར་རྟ་རྣམས་དྲངས་པའོ། །"]},{"type":"heading","content":["སོ་ལོ་མོན་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":29,"content":["སོ་ལོ་མོན་གྱི་མཛད་རྗེས་གཞན་རྣམས་འགོ་ནས་མཇུག་བར་དུ་ལུང་སྟོན་པ་ནཱ་ཐན་གྱི་གསུང་འབུམ་དང་། ཞི་ལོ་པ་ཨ་ཧི་ཡཱ་ཡི་ལུང་བསྟན་དང་། མངོན་ཤེས་པ་ཨིད་དོ་ཡིས་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྐོར་གླེང་བའི་མངོན་པའི་མདོ་བཅས་སུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":30,"content":["སོ་ལོ་མོན་གྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡེས་ར་ཨེལ་ཡོངས་ལ་ལོ་བཞི་བཅུའི་རིང་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":31,"content":["སོ་ལོ་མོན་ནི་ཉིད་ཀྱི་ཕ་མེས་དང་མཉམ་དུ་གཟིམས་ནས། ཁོང་གི་ཡབ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་དུར་ལ་སྦས། དེ་ནས་ཁོང་གི་སྲས་རེ་ཧབ་ཨམ་ཁོང་གི་ཚབ་ཏུ་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CH/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}