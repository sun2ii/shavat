{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":10,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་རང་གི་ལས་འགན་ལ་བདེན་དཔང་བྱེད༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཕོལ་ལོལ་བདག་ནི་ཁྱོད་རྣམས་དང་ངོ་ཕྲད་པའི་དུས་སུ་ཁེངས་ཆུང་ཡིན༌ལ། ཁྱོད་ཅག་གི་གམ་དུ་མེད་པའི་དུས་སུ་ཁྱོད་ཅག་ལ་སྤོབས་པ་ཆེ་བ༌དང༌། ད་ལྟ་རང་གིས་དངོས་སུ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཞི་ཞིང་དུལ་བའི་རང་བཞིན་ལ་བརྟེན་ནས་ཁྱོད་ཅག་ལ་སྐུལ་མ་གཏོང་ངོ་།།"]},{"type":"verse","number":2,"content":["མི་ལ་ལས་ངེད་ཅག་གིས་ངར་ཤུགས་ལ་བརྟེན་ནས་སྤྱད་པ་སྤྱོད་པར་སྙམ་ལ། ངས་མི་དེའི་རིགས་ལ་ངེས་པར་སྤོབས་པར་བརྟེན་ནས་སྐུལ་ལྕག་གཏོང་དགོས་པར༌བསམས་མོད། འོན་ཀྱང་ང་རང་ཁྱོད་ཅག་དང་མཉམ་དུ་ཡོད་དུས། དེ་ལྟར་སྤོབས་པ་ལྡན་མི་དགོས་པའི་ཚུལ་ཁྱོད་ཅག་ལ་ཞུའོ།།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་གིས་ངར་ཤུགས་ལ་བརྟེན་ནས་སྤྱད་པ་སྤྱོད༌ནའང༌། ངར་ཤུགས་ལ་བརྟེན་ནས་འཐབ་པར་མི་བྱེད།"]},{"type":"verse","number":4,"content":["ངེད་ཅག་གིས་འཐབ་པར་བྱེད་པའི་གོ་མཚོན་ནི་ངར་ཤུགས་ཀྱི་གོ་མཚོན་མ་ཡིན༌པར། དཀོན་མཆོག་གི་མཐུ་སྟོབས་དང་ལྡན་པས་བཙན་རྫོང་རྣམས་ཀྱང་གཏོར་ནུས༌ཤིང༌།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཤེས་པར་བཀག་འགོག་བྱེད་པའི་ཇུས་ངན་སྣ་ཚོགས་དང་ང་རྒྱལ་ཅན་གྱི་དོན་ཐམས་ཅད་ཀྱང་ངེད་ཅག་གིས་འཇོམས་པ་དང་། བསམ་པ་ཐམས་ཅད་ཕྱིར་བཀུག་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ལ་བསྟུན་དུ་འཇུག་པ་ཡིན།"]},{"type":"verse","number":6,"content":["ཡང་ཁྱོད་ཅག་གིས་བཀའ་ཡོངས་སུ་བརྩི་བའི་དུས༌སུ། ངེད་ཅག་གིས་བཀའ་མི་བརྩི་བ་ཐམས་ཅད་ལ་ཉེས་ཆད་གཅོད་པར་སྟ་གོན་བྱས་ཟིན༌ཏོ།།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་ཕྱིའི་རྣམ་པ་ཁོ་ནར༌ལྟའམ། གལ༌ཏེ། མི་ཞིག་ལ་རང་ཉིད་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀར་གཏོགས་པར་ཡིད་ཆེས་བརྟན་པོ་ཡོད༌ན། ད་དུང་བསམ་བློ་གཏོང་དགོས༌ཏེ། ཁོ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀར་ཇི་ལྟར་གཏོགས་པ༌བཞིན། ངེད་ཅག་ཀྱང་དེ་ལྟར་སྐྱབས་མགོན་མཱ་ཤི་ཀར་གཏོགས༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":8,"content":["གཙོ་བོས་ངེད་ཅག་ལ་དབང་ཆ་གནང༌བ་ནི་ཁྱོད་རྣམས་སྐྱེད་སྲིང་བྱེད་པ་ལས་ཉམས་དམས་སུ་གཏོང་ཕྱིར་མ་ཡིན། ངས་དབང་ཆ་འདི་ལ་བསྔགས་བརྗོད་ཅུང་ཙམ་བྱས་ཀྱང་ང་རང་ངོ་གནོང་བར་མི་འགྱུར།"]},{"type":"verse","number":9,"content":["ངས་དེ་ལྟར་སྨྲས་དོན༌ནི། བདག་གིས་འཕྲིན་ཡིག་བྲིས་ནས་ཁྱོད་ཅག་ལ་འཇིགས་སྣང་བསྐུལ་བའི་ཕྱིར་མ་ཡིན།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་འགའ་ཤས་ན༌རེ། ཁོའི་འཕྲིན་ཡིག་གི་ནང་དོན་ལྕི་ཞིང་དྲག་རྩུབ་ཆེ༌ཡང༌། ཁོ་དང་ངོ་ཕྲད་ན། ཁོ་རང་ནི་སྐྱེས་གཟུགས་ཞན་ཞིང་ཚིག་ཐ་མལ་སྨྲ་མཁན་ཡིན་ཞེས་ཟེར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["མི་འདི་ལྟ་བུ་རྣམས་ཀྱིས་ངེད་ཅག་གནས་དེར་མེད་པའི་དུས་སུ་འཕྲིན་ཡིག་གི་རྗོད་བྱེད་ཀྱི་ཚིག་ཇི་ལྟར་ཡིན༌ན། ངོ་འཕྲད་པའི་དུས་སུའང་དོན་དེ་བཞིན་དུ་བསྒྲུབ་ངེས་པར་བསམ་བློ་གཏོང་དགོས༌སོ།།"]},{"type":"verse","number":12,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ངེད་ཅག་གིས་རང་ཉིད་ནི་རང་བསྟོད་བྱེད་པའི་མི་རྣམས་ལ་བརྩི་བའམ་བསྡུར་མི་ཕོད༌དེ། མི་དེ་རྣམས་ཀྱིས་རང་གིས་རང་ལ་ཚད་འཇལ་ཞིང་རང་གིས་རང་ལ་བསྡུར་བར་བྱེད་པ་ནི་བློ་དམན༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":13,"content":["ངེད་ཅག་གིས་ཚད་ལས་འདས་པར་བསྔགས་བརྗོད་བྱ་མི་འདོད༌དེ། དཀོན་མཆོག་གིས་ངེད་ཅག་ལ་བསྩལ་པའི་དབྱེ་མཚམས་ལྟར་བསྔགས་བརྗོད་བྱ་ཞིང་ཁྱོད་ཅག་ཀྱང་དེའི་ནང་དུ་གནས་སོ།།"]},{"type":"verse","number":14,"content":["ངེད་ཅག་ཐོག་མ་ནས་ཁྱོད་ཅག་གི་གམ་དུ་སླེབས་ཏེ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་འཕྲིན་བཟང་བསྒྲགས་པ་ཡིན་པས། ངེད་རྣམས་ཀྱི་དབྱེ་མཚམས་ནི་ཁྱོད་རྣམས་ཀྱི་བར་དུ་མ་སླེབས་པ་ལྟར། ངེད་ཅག་ནི་རང་གི་དབྱེ་མཚམས་ལས་བརྒལ་བ་མ་ཡིན།"]},{"type":"verse","number":15,"content":["ངེད་ཅག་གིས་མི་གཞན་གྱི་དཀའ་ཚེགས་ལ་བརྟེན་ནས་བསྔགས་བརྗོད་ཚད་བརྒལ་མི་བྱེད༌ནའང༌། ཁྱོད་ཅག་གི་དད་པ་ཇེ་བརྟན་དུ་འགྲོ་བའི་དུས༌སུ། ངེད་ཅག་གི་དབྱེ་མཚམས་ནི་ཁྱོད་ཅག་གི་རྐྱེན་གྱིས་རྒྱ་ཆེ་རུ་འགྲོ་བ་དང༌།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཅག་གི་ཡུལ་ལས་གཞན་པའི་ཡུལ་རྣམས་ལ་འཕྲིན་བཟང་སྒྲོག་ནུས་པར་རེ་བ་བྱེད། དེ་ནི་མི་གཞན་གྱི་དབྱེ་མཚམས་ནང་དུ་བསྒྲུབས་ཟིན་པའི་དོན་ལ་བརྟེན་ནས་བསྔགས་བརྗོད་བྱེད་པའང་མིན་ནོ།།"]},{"type":"verse","number":17,"content":["འོན༌ཀྱང༌། བསྔགས་བརྗོད་བྱེད་མཁན་སུས་ཀྱང་གཙོ་བོ་ལ་བསྔགས་འོས༌སོ།།"]},{"type":"verse","number":18,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་ཐུགས་ལ་ལྡན་པ་ནི་རང་བསྟོད་བྱེད་མཁན་གྱིས་བསྟོད་པ་མ་ཡིན༌པར། གཙོ་བོས་བསྟོད་ཅིང་བསྔགས་པ་དེ་ཡིན་པའི་ཕྱིར༌རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}