{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":11,"content":[{"type":"heading","content":["ཕོལ་ལོལ་དང་སྐུ་ཚབ་པ་རྫུས་མའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་བདག་གི་གླེན་རྟགས་ཕྲན་བུ་འདིར་ཁྱོད་རྣམས་ཀྱིས་བཟོད་སྒོམ་གནང་བར༌སྨོན། དོན་དངོས་སུ་ཁྱོད་ཅག་གིས་བདག་ལ་བཟོད་སྒོམ་གནང༌བ་ཡིན་ནོ།།"]},{"type":"verse","number":2,"content":["བདག་གིས་དཀོན་མཆོག་གི་ཕྲག་དོག་སྤྱད་ནས་ཁྱོད་རྣམས་ལ་གཅེས་པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། སྔོན་ཆད་བདག་གིས་ཁྱོད་རྣམས་མག་གསར་གཅིག་ལ་གཉེན་རྟགས་བརྒྱབ་པ༌དང༌། ཁྱོད་ཅག་ན་ཆུང་བུ་མོ་གཙང་མ་ཞིག་ཡིན་པ་བཞིན་དུ་སྐྱབས་མགོན་མཱ་ཤི་ཀར་འབུལ་ཐུབ་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":3,"content":["འོན༌ཀྱང༌། སྦྲུལ་གྱིས་གཡོ་སྒྱུར་བརྟེན་ནས་ཧ་ཝཱ་བསླུས་པ༌ལྟར། ཁྱོད་ཅག་གི་བསམ་པའང་སྐྱབས་མགོན་མཱ་ཤི་ཀར་བཅངས་པའི་དད་སེམས་དྲང་པོ་དང་གཙང་མ་དེ་ནས་ངན་ཕྱོགས་སུ་འཁོར་བར་ང་རང་འཇིགས༌པ་ཡིན།"]},{"type":"verse","number":4,"content":["རྒྱུ་མཚན་ནི་མི་ཞིག་ཡོང་ནས་ཁྱོད་རྣམས་ལ་ངེད་ཅག་གིས་བསྒྲགས་པ་མ་ཡིན་པའི་ཡེ་ཤུ་གཞན་ཞིག་བསྒྲགས༌པའམ། ཡང་ན་ཁྱོད་ཅག་ལ་སྔར་ཐོབ་མ་མྱོང་བའི་ཐུགས་ཉིད་གཞན་ཞིག་ཐོབ༌པ། ཡང་ན་ཁྱོད་རྣམས་ལ་སྔར་ཐོབ་མ་མྱོང་བའི་འཕྲིན་བཟང་གཞན་ཞིག་ཐོབ༌ན། ཁྱོད་རྣམས་དགའ་ཞིང་དེའི་དབང་དུ་འགྲོ་བའོ།།"]},{"type":"verse","number":5,"content":["འོན༌ཀྱང༌། ངས་རང་ཉིད་ནི་མཆོག་ཏུ་གྱུར་པའི་སྐུ་ཚབ་པ་ཞེས་པ་དག་ལས་ཅུང་ཙམ་ཡང་མི་དམན་སྙམ།"]},{"type":"verse","number":6,"content":["བདག་གི་སྨྲ་བརྗོད་ནི་ཕལ་བ་ཡིན༌ཡང༌། བདག་གི་ཡོན་ཏན་ནི་ཕལ་བ་མ་ཡིན། འདི་ནི་ངེད་ཅག་གིས་ལས་ཀུན་ནས་ཁྱོད་རྣམས་ལ་གསལ་པོར་བསྟན་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":7,"content":["བདག་གིས་དཀོན་མཆོག་གི་འཕྲིན་བཟང་ནི་རིན་མེད་པར་ཁྱོད་རྣམས་ལ་བསྒྲགས༌ཤིང༌། ཁྱོད་ཅག་མཐོ་སར་འཕར་བའི༌ཕྱིར་ང་རང་དམའ་སར་བསྡད་པ་ནི་བདག་གིས་སྡིག་པ་བྱས་པ་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["བདག་གིས་ཆོས་ཚོགས་གཞན་ལ་གྱོང་གུད་བཟོས་ཤིང༌། ཁོ་རྣམས་ལས་གླ་ཕོགས་བླངས་ཏེ་ཁྱོད་ཅག་ལ་ཞབས་ཕྱི་སྒྲུབ༌པ་ཡིན།"]},{"type":"verse","number":9,"content":["ང་རང་ལ་ཁྱོད་ཅག་གི་གམ་དུ་དགོས་མཁོ་བྱུང་བའི་དུས༌སུ། མ་ཀེ་དོན་ཡཱ་ཡུལ་ནས་ཡོང་བའི་སྤུན་ཟླ་རྣམས་ཀྱིས་བདག་གི་དགོས་མཁོ་བསྐངས༌པས། ངས་ཁྱོད་རྣམས་སུ་ལའང་དཀའ་ལས་མ་གཏད། བདག་གིས་དེ་སྔར་ལས་ཀུན་ནས་གཟབ་གཟབ་བྱས་ཤིང་ཕྱིས་སུའང་དེ་ལྟར་བྱས་ཏེ་ཁྱོད་རྣམས་ལ་ཅིས་ཀྱང་དཀའ་ལས་མི་གཏོད།"]},{"type":"verse","number":10,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཐུགས་རྒྱུད་དྲང་པོ་དེ་ཉིད་བདག་གི་སེམས་ཁོང་དུ་བཞུགས༌པས། མི་སུས་ཀྱང་ཨ་ཀ་ཡཱ་ཡུལ་ནས་བདག་གི་རང་བསྟོད་དེ་ནི་འགོག་མི་ནུས་སོ།།"]},{"type":"verse","number":11,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ངས་ཁྱོད་རྣམས་ལ་མི་གཅེས་པའི་རྐྱེན་གྱིས་མིན༌ཏེ། དོན་དེ་ནི་དཀོན་མཆོག་གིས་མཁྱེན་ནོ།།"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་། མི་གཞན་རྣམས་ཀྱིས་རང་བསྟོད་བྱེད་པའི་ཐད་ནས་ངེད་ཅག་དང་འདྲ་བར་འདོད༌ཀྱང༌། གོ་སྐབས་འཚོལ་བ་དེ་དག་གི་གོ་སྐབས་མེད་པར་བཟོ་བའི༌ཕྱིར། བདག་གིས་ད་ལྟ་ཅི་ལྟར་བྱེད་པ༌བཞིན། ཕྱིས་སུའང་དེ་ལྟར་བྱེད་པར་བྱའོ༎"]},{"type":"verse","number":13,"content":["མི་དེ་ལྟ་བུ་རྣམས་ནི་སྐུ་ཚབ་པ་རྫུས་མ་ཡིན༌ཏེ། ལས་ཀུན་སྒྲུབ་པར་གཡོ་སྒྱུ་ཆེ་ཞིང་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཚབ་པ་ཡིན་ཁུལ་བྱེད་པ་ཡིན།"]},{"type":"verse","number":14,"content":["དེ་ལ་ངོ་མཚར་བ་མེད༌དེ། བདུད་སཱ་ཏན་གྱིས་ཀྱང་འོད་སྣང་གི་ཕོ་ཉ་ཡིན་ཁུལ་བྱེད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":15,"content":["དེ་བས་བདུད་ཀྱི་གཡོག་པོ་དག་གིས་ཀྱང་དྲང་བདེན་གྱི་ཞབས་ཕྱི་པ་ཡིན་ཁུལ་བྱེད༌པས། དེ་ལའང་ངོ་མཚར་བ་མེད། དེ་དག་གི་མཐའ་འབྲས་ནི་དེ་དག་གི་སྤྱོད་ལམ་བཞིན་དུ་འབྱུང་ངེས༌སོ།།"]},{"type":"heading","content":["སྐུ་ཚབ་པ་ཕོལ་ལོལ་གྱི་དཀའ༌ཚེགས།"]},{"type":"verse","number":16,"content":["བདག་གིས་ཡང་བསྐྱར་སྨྲ་བར་བྱ༌སྟེ། མི་སུས་ཀྱང་བདག་ནི་བླུན་པོར་བརྩི་བར་མི༌བྱའོ། །གལ༌ཏེ། བླུན་པོར་བརྩིས་པའི་དབང་དུ་བཏང༌ནའང༌། བདག་གིས་ཀྱང་རང་བསྟོད་ཅུང་ཙམ་བྱེད་ཐུབ་པའི༌ཕྱིར། ང་རང་བླུན་པོར་བརྩིས་ཀྱང་སྣེ་ལེན་བྱེད་པར་རིགས་སོ།།"]},{"type":"verse","number":17,"content":["གཏམ་འདི་ནི་བདག་གིས་གཙོ་བོའི་བཀའ་ལྟར་སྨྲས་པ་མ་ཡིན༌ལ། མི་གླེན་པ་ཞིག་དང་མཚུངས་པར་ཅི་མི་སྙམ་པར་རང་བསྟོད་བྱས༌པ་ཡིན།"]},{"type":"verse","number":18,"content":["མི་མང་པོས་རང་གི་ངར་ཤུགས་ལ་བརྟེན་ནས་རང་བསྟོད་བྱེད༌པས། ངས་ཀྱང་རང་བསྟོད་བྱའོ།།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་ནི་མཁས་མཛངས་ཅན་ཡིན་པས་བླུན་པོ་རྣམས་ལའང་བཟོད་པ་སྒོམ་པར་དགའ་བ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":20,"content":["གལ༌ཏེ། མི་ཞིག་གིས་ཁྱོད་རྣམས་བཙན་གྱིས་བྲན་དུ་བཀོལ༌བའམ། ཡང་ན་ཁྱོད་ཅག་ཧམ་བཟུང་བྱེད༌པ། ཡང་ན་ཁྱོད་རྣམས་འཕྲོག་བཅོམ་བྱེད་པ། ཡང་ན་ཁྱོད་ཅག་ལ་བརྙས་བཅོས་བྱེད༌པ། ཡང་ན་ཁྱོད་རྣམས་ལ་འགྲམ་ལྕག་གིས་གཞུ་བ་བཅས་བྱེད༌ཀྱང༌། ཁྱོད་ཅག་གིས་ཁོ་རྣམས་ལ་བཟོད་བསྲན་བྱེད་པ་ཡིན།"]},{"type":"verse","number":21,"content":["གཏམ་འདི་ནི་རང་གིས་རང་ལ་ངོ་གནོང་བའི་ཕྱིར་སྨྲས་པ་ཡིན༌ལ། སྔོན་ཆད་ངེད་ཅག་ནི་གཉོམ་ཆུང་ཡིན་པ༌འདྲ་མོད། འོན༌ཀྱང༌། མི་སུ་ཞིག་དོན་གང་གི་ཆ་ནས་སྤོབས་པ་ཅན་ཡིན༌ན། ངས་ཀྱང་བླུན་གཏམ་ཞིག་སྨྲ་བར་བྱ༌སྟེ། ང་རང་ཡང་སྤོབས་པ་ཅན་ཡིན་ནོ།།"]},{"type":"verse","number":22,"content":["དེ་རྣམས་ནི་ཨིབ་རི་པ་མ་ཡིན༌ནམ། ང་རང་ཡང་ཨིབ་རི་པ་ཡིན། དེ་རྣམས་ནི་ཡེས་ར་ཨེལ་པ་མ་ཡིན༌ནམ། ང་ཪང་ཡང་ཡེས་ར་ཨེལ་པ་ཡིན། དེ་རྣམས་ནི་ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་མ་ཡིན༌ནམ། ང་རང་ཡང་ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་ཡིན།"]},{"type":"verse","number":23,"content":["དེ་རྣམས་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཞབས་ཕྱི་པ་མ་ཡིན༌ནམ། ཡང་ངས་སྨྱོ་གཏམ་ལྟ་བུ་ཞིག་སྨྲ་བར་བྱ༌སྟེ། ང་རང་ཡང་ལྷག་ཏུ་ཞབས་ཕྱི་པ་ཡིན། བདག་གིས་ཁོ་རྣམས་ལས་ཀྱང་དཀའ་ངལ་མང་དུ་མྱངས༌ཤིང༌། བཙོན་ཁང་དུ་ཐེངས་མང་པོར་བཅུག་པ༌དང༌། གཅར་རྡུང་ཚབས་ཆེན༌མྱངས། ཐེངས་དུ་མར་འཆི་བའི་ཉེན་ཁར་ཐུག"]},{"type":"verse","number":24,"content":["ཡ་ཧུ་དཱ་པས་བདག་ལ་གཅར་རྡུང་ཐེངས་ལྔ་བྱས༌པ་དང་། ཐེངས་རེར་རྟ་ལྕག་བཞི་བཅུ་གཞུས་ཤིང་དེའི་ནང་ནས་རྟ་ལྕག་གཅིག་བླངས།"]},{"type":"verse","number":25,"content":["ཡང་དབྱུག་པས་ཐེངས་གསུམ་ལ་བརྒྱབ། རྡོ་རུབ་ཐེངས་གཅིག་ལ་བཏང་། གྲུ་གཟིངས་ཐེངས་གསུམ་ལ་ཆག་གྲུམ་བྱུང༌སྟེ། ཉིན་ཞག་གཅིག་ལ་རྒྱ་མཚོའི་འཇིངས་སུ་ལུས།"]},{"type":"verse","number":26,"content":["ཡང་ཐེངས་དུ་མར་ལམ་ཐག་རིང་པོར་འགྲོ༌དུས། ཆུ་བོའི་ཉེན་ཁ༌དང༌། ཇག་པའི་ཉེན༌ཁ། ཡུལ་མི་རྣམས་ཀྱི་ཉེན༌ཁ། ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་ཉེན༌ཁ། གྲོང་ཁྱེར་གྱི་ཉེན༌ཁ། དབེན་སྟོང་གི་ཉེན༌ཁ། རྒྱ་མཚོའི་ནང་གི་ཉེན༌ཁ། སྤུན་ཟླ་རྫུས་མའི་ཉེན་ཁ་བཅས་དང་ཕྲད།"]},{"type":"verse","number":27,"content":["ཡང་དཀའ་ཚེགས་དང་ངལ་བ་མྱངས་ཤིང་ཐེངས་མང་པོར་གཉིད་མ་ཁུག་པ༌དང༌། ཟས་མེད་པར་བཀྲེས་སྐོམ༌མྱངས། གྲངས་ངར་མྱངས་ཤིང་གཅེར་བུར་ལུས།"]},{"type":"verse","number":28,"content":["དོན་དེ་དག་ལས༌གཞན། བདག་གིས་ཆོས་ཚོགས་ཐམས་ཅད་ཀྱི་དོན་ལ་སེམས་ཁྲལ་བྱས་པས། ཉིན་རེར་སེམས་ཀྱི་ཁུར་བོའང་ཤིན་ཏུ༌ལྕི་མོ་ཡིན།"]},{"type":"verse","number":29,"content":["སུ་ཞིག་སྟོབས་ཞན་པར་གྱུར༌ན། ང་རང་ཞན་པར་མི་འགྱུར༌རམ། སུ་ཞིག་སར་འགྱེལ་ན། ང་རང་སེམས་འཚབ་པར་མི་འགྱུར༌རམ།"]},{"type":"verse","number":30,"content":["གལ༌ཏེ། བདག་གིས་ངེས་པར་རང་བསྟོད་བྱེད་དགོས༌ན། ང་རང་གཉོམ་ཆུང་ཡིན་པའི་ཐད་ལ་བསྟོད་པར་བྱ༌སྟེ།"]},{"type":"verse","number":31,"content":["ངས་རྫུན་མི་སྨྲ་བ་ནི་དུས་རྟག་ཏུ་བསྔགས་པར་འོས་པའི་གཙོ་བོ་ཡེ་ཤུའི་ཡབ་དཀོན་མཆོག་གིས་མཁྱེན༌ཏོ།།"]},{"type":"verse","number":32,"content":["དཱ་མེ་སེག་གི་རྒྱལ་པོ་ཨ་རེ་ཏའི་བློན་ཆེན་གྱིས་དཱ་མེ་སེག་མཁར་གྲོང་བསྲུངས་ནས་ང་རང་འཛིན་འདོད་པ༌ལ།"]},{"type":"verse","number":33,"content":["བདག་ནི་སླེ་བོའི་ནང་དུ་བསྡད་ཅིང་མཁར་གྱི་སྒེའུ་ཁུང་ལས་མར་དཔྱངས་ཏེ་བློན་ཆེན་གྱི་ལག་ནས་ཐར་བར་གྱུར༌ཏོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/10.json","previousChapterAudioLinks":{},"numberOfVerses":33}