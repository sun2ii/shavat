{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":12,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱི་ཞལ་གཟིགས་དང་ལུས་ཀྱི་ཚེར་མའི༌དཔེ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་རང་བསྟོད་བྱས་ན་ཕན་ཐོགས་མེད་ཀྱང་བདག་གིས་དེ་ལྟར་མི་བྱེད་ཀ་མེད་བྱུང༌ངོ་༎ ད་ལྟ་བདག་གིས་གཙོ་བོའི་ཞལ་གཟིགས་དང་ཁོང་གི་མངོན་པར་གསལ་བའི་དོན་རྣམས་སྨྲ་བར༌བྱ་སྟེ།"]},{"type":"verse","number":2,"content":["བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་གནས་པའི་མི་ཞིག་ངོ་ཤེས༌ཏེ། ཁོ་རང་ནི་ལོ་བཅུ་བཞིའི་སྔོན་ལ་ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་རིམ་པ་གསུམ་པར་དྲངས། ཁོ་རང་ནི་ལུས་ཕྱི་ནང་གང་དུ་ཡོད་པ་བདག་གིས་མི་ཤེས་ཀྱང་དཀོན་མཆོག་གིས་མཁྱེན༌ཏོ།།"]},{"type":"verse","number":3,"content":["ངས་མི་དེ་ངོ་ཤེས་པ་དང་ཁོ་རང་ལུས་ཕྱི་ནང་གང་དུ་ཡོད་པ་མི་ཤེས༌ཀྱང༌། དཀོན་མཆོག་གིས་མཁྱེན་ཏེ།"]},{"type":"verse","number":4,"content":["ཁོ་རང་ནི་ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་དགའ་བདེའི་ལྡུམ་རར་དྲངས༌ཤིང༌། གསང་བའི་སྐད་ཆ་ཐོས་པ༌དང༌། དེ་ནི་མིས་སྨྲ་མི་རུང་བ་ཞིག་ཡིན།"]},{"type":"verse","number":5,"content":["བདག་གིས་མི་དེའི་དོན་དུ་བསྔགས་པར༌བྱའོ།། འོན་ཀྱང་བདག་གི་དོན་དུ་རང་ཉིད་གཉོམ་ཆུང་ཡིན་པ་དེ་ལས༌གཞན། བདག་ལ་བསྔགས་པར་བྱ་བ་ཅི་ཡང་མེད།"]},{"type":"verse","number":6,"content":["བདག་གིས་བདེན་གཏམ་སྨྲ་ངེས༌པས། རང་བསྟོད་བྱེད་འདོད་ནའང་དེ་ནི་བླུན་རྟགས་མ་ཡིན། མི་གཞན་གྱིས་བདག་ལས་བྱུང་བའི་མཐོང་ཐོས་བརྒལ་ནས་ང་རང་ཆེན་པོར་མི་བརྩི་བའི༌ཕྱིར། བདག་གིས་རང་བསྟོད་མི༌བྱའོ།།"]},{"type":"verse","number":7,"content":["ཡང་བདག་ལ་མངོན་པར་གསལ་བའི་དོན་རྣམས་རླབས་ཤིན་ཏུ་ཆེ་བས། ང་རྒྱལ་མི་སྐྱེ་བའི༌ཕྱིར། ངའི་ལུས་སྟེང་དུ་ཚེར་མ་ཞིག་གནང་བ་ཡིན་ལ། དེ་ནི་བདུད་སཱ་ཏན་གྱི་ཕོ་ཉས་བདག་ལ་རྡུང་རྡེག་བཏང༌བ་ཡིན་ཏེ་བདག་ང་རྒྱལ་མི་སྐྱེ་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":8,"content":["དོན་འདིའི་ཆེད་དུ་བདག་གིས་གཙོ་བོར་ཐེངས་གསུམ་ལ་ཚེར་མ་དེ་བདག་ལས་ལེན་པར་ཞུ་བ་བྱས༌པ་དང་།"]},{"type":"verse","number":9,"content":["ཁོང་གིས་བདག་ལ་འདི་སྐད༌དུ། ཁྱོད་ལ་བདག་གི་ཐུགས་རྗེ་ཡོད་པས་འདང༌སྟེ། བདག་གི་ནུས་མཐུ་ནི་མི་གཉོམ་ཆུང་རྣམས་ལ་ཡོངས་སུ་རྫོགས་པར་མངོན་པ་ཡིན་ཞེས་གསུངས༌པས། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནུས་མཐུ་བདག་གི་སྟེང་དུ་བཞུགས་པའི༌ཕྱིར། བདག་ནི་རང་ཉིད་ཀྱི་གཉོམ་ཆུང་ལ་བསྔགས་པར་ལྷག་ཏུ༌དགའོ།།"]},{"type":"verse","number":10,"content":["དེའི་ཕྱིར་བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཆེད་དུ། གཉོམ་ཆུང༌དང༌། བརྙས༌བཅོས། དཀའ༌སྡུག གཉའ་གནོན། དཀའ་ཚེགས་བཅས་ནི་དགའ་འོས་པར་བརྩིས། རྒྱུ་མཚན་ནི་ང་རང་དུས་ནམ་ཞིག་ལ་གཉོམ་ཆུང་ཡིན༌ན། དུས་དེ་ལ་བདག་ནི་སྟོབས་ཅན་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་ཆོས་ཚོགས་ལ་གཟིགས་སྐྱོང་མཛད༌པ།"]},{"type":"verse","number":11,"content":["སྤྱིར་ཁྱོད་ཅག་གིས་བདག་ལ་བཟང་སྨྲས་ན་འགྲིག༌མོད། འོན་ཀྱང་ད་ལྟ་ང་རང་བླུན་པོར་གྱུར་པ་ནི་ཁྱོད་ཅག་གིས་བཙན་སྐུལ་བྱས༌པ་ཡིན། བདག་ནི་ཅི་ཡང་མིན་ནའང་མཆོག་ཏུ་གྱུར་པའི་སྐུ་ཚབ་པ་ཞེས་པ་དག་ལས་དོན་གང་གི་ཐད་ནས་ཀྱང་མི་དམན་ནོ།།"]},{"type":"verse","number":12,"content":["བདག་གིས་ཁྱོད་ཅག་གི་ཁྲོད་དུ་བཟོད་བསྲན་ཚད་མེད་བྱས༌ནས། གྲུབ་རྟགས༌དང༌། དོན་ངོ་མཚར༌ཅན། ངོ་མཚར་བའི་ནུས་མཐུ་བཅས་ལ་བརྟེན་ནས་སྐུ་ཚབ་པ་དངོས་མའི་རྟགས་བསྟན༌པ་ཡིན།"]},{"type":"verse","number":13,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་དཀའ་ལས་མ་གཏད་པ་འདི་ལས༌གཞན། ཁྱོད་རྣམས་དོན་གང་གི་ཆ་ནས་ཆོས་ཚོགས་གཞན་ལ་མི་དོའམ། འདྲ་མཉམ་མིན་པའི་ཆ་དེ་ལ་ཁྱོད་ཅག་གིས་གུ་ཡངས་གཏོང་བར༌ཞུའོ།།"]},{"type":"verse","number":14,"content":["ད་ལྟ་བདག་ནི་ཐེངས་གསུམ་པར་ཁྱོད་ཅག་གི་གམ་དུ་འགྲོ་རྩིས་ཡོད༌ཀྱང༌། ཁྱོད་རྣམས་ལ་དཀའ་ལས་གཏོད་མི་སྲིད་དོ།། ཅིའི་ཕྱིར་ཞེ་ན། བདག་གི་རེ་བ་ནི་ཁྱོད་ཅག་ཡིན་པ་ལས་ཁྱོད་ཅག་གི་རྒྱུ་ནོར་མ་ཡིན། ཕ་མས་བུ་ཕྲུག་གི་དོན་དུ་རྒྱུ་ནོར་གསོག་དགོས་པ༌ལས། བུ་ཕྲུག་གིས་ཕ་མའི་དོན་དུ་རྒྱུ་ནོར་གསོག་དགོས་པ་མ་ཡིན།"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་ཀྱི་ཚེ་སྲོག་གི་ཆེད༌དུ། བདག་ནི་རྒྱུ་ནོར་དང་ནུས་ཤུགས་གཉིས་ཀ་ཕུད་པར་ཤིན་ཏུ༌དགའོ།། ངས་ཁྱོད་རྣམས་ལ་ལྷག་ཏུ་བྱམས་ཤིང་གཅེས་པ་ཡིན༌ན། བདག་ལ་ཁྱོད་ཅག་གི་བྱམས་བརྩེ་དེ་བས་ཉུང་བ་ཞིག་འཐོབ༌བམ།"]},{"type":"verse","number":16,"content":["བདག་གིས་ཁྱོད་རྣམས་དཀའ་ལས་ལ་མ་སྦྱར༌ཡང༌། མི་ལ་ལས་བདག་ནི་གཡོ་སྒྱུ་ཅན་ཡིན་པས། གཡོ་ཐབས་ཀྱིས་ཁྱོད་རྣམས་དྲ་བར་ཚུད་དུ་བཅུག་ཟེར།"]},{"type":"verse","number":17,"content":["ངས་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་མངགས་པའི་མི་སུ་ཞིག་ལ་བརྟེན་ནས་ཁྱོད་ཅག་ལས་ཁེ་བཟང་བླངས༌མྱོང་ངམ།"]},{"type":"verse","number":18,"content":["བདག་གིས་ཐེ་ཏུ་ཁྱོད་ཅག་གི་གམ་དུ་འགྲོ་བར་བསྐུལ༌ཞིང༌། སྤུན་ཟླ་གཞན་ཡང་ཁོ་དང་མཉམ་དུ་འགྲོ་བར་མངགས་མྱོང༌། ཐེ་ཏུས་ཁྱོད་རྣམས་ལས་ཁེ་བཟང་བླངས་མྱོང༌ངམ། ངེད་ཅག་གིས་སེམས་གཅིག་དང་སྤྱོད་ལམ་གཅིག་གི་སྒོ་ནས་དོན་བསྒྲུབས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱིས་ད་ལྟའི་བར་དུ་ངེད་ཅག་གིས་ཁྱོད་རྣམས་ཀྱི་མདུན་དུ་རང་ཉིད་ལ་དག་འབུད་བྱེད་པ་རེད་སྙམ༌མམ། ངེད་ཅག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀར་བརྟེན་ནས་དཀོན་མཆོག་གི་སྤྱན་སྔ་ནས་གཏམ་སྨྲས༌པ་ཡིན། སྙིང་ཉེ་བའི་སྤུན་ཟླ༌རྣམས། དོན་འདི་ཐམས་ཅད་ནི་ཁྱོད་ཅག་སྐྱེད་སྲིང་བྱེད་པའི་ཆེད་དུ་ཡིན་ནོ།།"]},{"type":"verse","number":20,"content":["ང་རང་ཡོང་བའི་དུས༌སུ། ངས་ཁྱོད་རྣམས་མཐོང་ན་ཁྱོད་ཅག་ནི་བདག་གི་རེ་བ་དང་མི་མཐུན༌ཞིང༌། ཁྱོད་རྣམས་ཀྱིས་ང་རང་མཐོང་ན་བདག་ནི་ཁྱོད་ཅག་གི་རེ་བ་དང་མི་མཐུན་པར་སྙམ་པ་ལ་བདག་ནི་འཇིགས༌ཏེ། ཁྱོད་ཅག་ནང་ཁུལ་དུའང་རྩོད་པ༌དང༌། ཕྲག༌དོག ཁོང༌ཁྲོ། སྒེར་སེམས། འཕྱ༌སྨོད། ཕྲ༌མ། ང༌རྒྱལ། རྙོག་འཛིང་ཆེ་བ་བཅས་ཀྱི་དོན་དག་འབྱུང་བར་ཡང་འཇིགས་སོ།།"]},{"type":"verse","number":21,"content":["ང་རང་ཡོང་བའི་དུས༌སུ། བདག་གི་དཀོན་མཆོག་གིས་ང་ནི་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་ངོ་གནོང་དུ་འཇུག་པ་ལའང་ང་རང་འཇིགས་པ༌དང༌། ཡང་མི་མང་པོས་སྔོན་ཆད་མི་གཙང་བ༌དང༌། ལོག༌གཡེམ། འདོད་ཆགས་བཅས་སྡིག་པའི་ལས་བྱས་ཀྱང་འགྱོད་བཤགས་མི་བྱེད༌པས། ང་རང་ཡིད་སྐྱོ་བར་ཡང་འཇིགས་སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/11.json","previousChapterAudioLinks":{},"numberOfVerses":21}