{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":5,"content":[{"type":"heading","content":["ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་སྡོད༌གནས།"]},{"type":"verse","number":1,"content":["དེ་ལྟར་ཡིན་པས། བདག་ཅག་གི་ས་སྟེང་གི་ཁང་པ་ཡིན་པའི་གུར་འདི་བཤིག་པར་འགྱུར༌ཚེ། དཀོན་མཆོག་གིས་བསྐྲུན་པའི་སྡོད་གནས་ཤིག་བདག་ཅག་ལ་ཡོད་པ་དང་། དེ་ནི་མིའི་ལག་པས་བསྐྲུན་པ་མ་ཡིན༌ཞིང༌། ནམ་མཁའི་ཞིང་ཁམས་སུ་གཏན་དུ་གནས་པའི་ཁང་པ་ཞིག་འཐོབ་ངེས་པ་བདག་ཅག་གིས་ཤེས་སོ།།"]},{"type":"verse","number":2,"content":["བདག་ཅག་གིས་གུར་འདིའི་ནང་དུ་ཤུགས་རིང་འབྱིན་ཞིང་། ནམ་མཁའི་ཞིང་ཁམས་ནས་འཐོབ་པའི་སྡོད་གནས་དེ་ནི་གོས་བཞིན་དུ་གྱོན་འདོད༌པ་དང་།"]},{"type":"verse","number":3,"content":["གོས་དེ་གྱོན་པ་ཡིན་ན་གཅེར་བུར་མི་ལུས་སོ།།"]},{"type":"verse","number":4,"content":["བདག་ཅག་གིས་གུར་འདིའི་ནང་དུ་དཀའ་སྡུག་མྱོང་བཞིན་ཤུགས་རིང་འབྱིན༌མོད། འོན་ཀྱང་མི་རྟག་པ་ནི་མཐའ་མེད་པའི་ཚེ་སྲོག་གིས་ཁྱུར་མིད་བྱེད་པའི༌ཕྱིར། གོས་འདི་ཕུད་འདོད་པ་མ་ཡིན་པར་གོས་དེ་གྱོན་འདོད༌པ་ཡིན།"]},{"type":"verse","number":5,"content":["དོན་འདི་བདག་ཅག་གི་ཕྱིར་དུ་སྟ་གོན་མཛད་མཁན་ནི་དཀོན་མཆོག་ཡིན༌ལ། ཁོང་གིས་དམ་པའི་ཐུགས་ཉིད་བདག་ཅག་ལ་གཏའ་མར་གནང༌ངོ༌།།"]},{"type":"verse","number":6,"content":["དེའི༌ཕྱིར། བདག་ཅག་རྒྱུན་དུ་སྙིང་སྟོབས་ཆེ་བར་མ༌ཟད། ལུས་པོའི་ནང་སྡོད༌པ་ན་གཙོ་བོ་དང་ཁ་གྱེས་པའང་ཤེས་སོ།།"]},{"type":"verse","number":7,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་ཅག་གིས་དད་པར་བརྟེན་ནས་སྤྱོད་པ༌ལས། མིག་གིས་མཐོང་བ་ལ་བརྟེན་ནས་སྤྱོད་པ་མ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":8,"content":["བདག་ཅག་དཔའ་ངར་ཞུམ་མེད་དུ་གནས༌ཤིང༌། དེ་ལས་ཀྱང་ལུས་པོ་དང་ཁ་བྲལ་ནས་གཙོ་བོ་དང་ལྷན་དུ་སྡོད་འདོད༌པས།"]},{"type":"verse","number":9,"content":["ལུས་པོའི་ཕྱི་ནང་གང་དུ་བསྡད་ཀྱང་བདག་ཅག་གིས་ཕུགས་འདུན་བཅངས་ཏེ། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཐུགས་དགྱེས་པ་དེ་ཉིད་འཐོབ་པར་བརྩོན༌པ་ཡིན།"]},{"type":"verse","number":10,"content":["རྒྱུ་མཚན་ནི་བདག་ཅག་ཐམས་ཅད་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ལེགས་ཉེས་ཀྱི་ཁྲིམས་ཐག་གཅོད་པའི་བཞུགས་ཁྲིའི་མདུན་དུ་ལང་དགོས་ཤིང་། ལུས་པོའི་ནང་གསོན་པའི་དུས་སུ་རང་རང་གིས་ཅི་བྱས་བཞིན་མི་རེ་རེར་བཟང་ངན་གང་རུང་གི་འབྲས་བུ་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["འདུམ་སྒྲིག་གི་ལས་འགན།"]},{"type":"verse","number":11,"content":["དེ་བས་ན། ངེད་ཅག་གིས་གཙོ་བོ་ལ་འཇིགས་པ་ཤེས་པས་མི་རྣམས་ལ་བསྐུལ་བར༌བྱའོ།། འོན་ཀྱང་ངེད་རྣམས་དཀོན་མཆོག་གི་སྤྱན་སྔར་མངོན་པར་གསལ་བ་བཞིན༌དུ། ཁྱོད་ཅག་གི་བསམ་པ་ལའང་མངོན་པར་གསལ་བའི་རེ་བ་བྱའོ།།"]},{"type":"verse","number":12,"content":["ངེད་ཅག་གིས་ཁྱོད་རྣམས་ལ་རང་གིས་རང་ལ་འུད་བསྟོད་བྱེད་པ་མིན༌ཏེ། སེམས་ལ་མི་བརྟེན་པར་ཕྱིའི་རྣམ་པར་བརྟེན་ནས་འུད་བསྟོད་བྱེད་མཁན་དག་ལ་ལན་ཡོད་པར་འགྱུར་བའི༌ཕྱིར་དུ། ཁྱོད་ཅག་གིས་ངེད་ཅག་ལ་བསྟོད་པ་བྱ་བའི་གོ་སྐབས་ཤིག་སྟེར་རོ།།"]},{"type":"verse","number":13,"content":["གལ༌ཏེ། ངེད་ཅག་སྨྱོས་པ་ཡིན་ན་དཀོན་མཆོག་གི་ཆེད་དུ་ཡིན༌ལ། དྭངས་གསལ་ཡིན་ན་ཁྱོད་ཅག་གི་དོན་དུ་ཡིན།"]},{"type":"verse","number":14,"content":["ངེད་ཅག་གི་སེམས་སུ་མི་ཐམས་ཅད་ཀྱི་ཚབ་ཏུ་མི་གཅིག་སྐུ་གྲོངས་པ་ཡིན་ན་མི་ཐམས་ཅད་ཀྱང་ཤི་བ་ཐག་གིས་ཆོད་པས། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བྱམས་པས་ངེད་ཅག་ལ་ངར་ཤུགས་སློང་བ་ཡིན།"]},{"type":"verse","number":15,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མི་ཐམས་ཅད་ཀྱི་ཆེད་དུ་སྐུ་གྲོངས་པ་ཡིན༌ཏེ། གསོན་པོར་གནས་པ་རྣམས་ནི་དེང་ཕྱིན་རང་ཉིད་ཀྱི་དོན་དུ་མི་གསོན༌པར། ཁོ་རྣམས་ཀྱི་ཆེད་དུ་སྐུ་གྲོངས་ཤིང་སླར་གསོན་པ་ཁོང་ཉིད་ཀྱི་དོན་དུ་གསོན་དགོས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":16,"content":["དེའི༌ཕྱིར། བདག་ཅག་གིས་ད་ནས་བཟུང་མིའི་ཕྱི་ཡི་རྣམ་པར་མི༌བལྟའོ།། དེ་སྔོན་ཕྱིའི་རྣམ་པར་བལྟས་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ངོས་བཟུང་མྱོང་ཡང་ད་ལྟ་དེ་ལྟར་ངོས་མི་འཛིན་པས།"]},{"type":"verse","number":17,"content":["སུ་ཞིག་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ཡོད༌ན། མི་དེ་ནི་གསར་དུ་བསྐྲུན་པའི་མི་ཡིན༌ལ། འདས་དོན་ཚང་མ་མེད་པར་གྱུར་ཅིང་། ལྟོས་དང་། གསར་པ་དེ་བྱུང་འདུག་གོ།"]},{"type":"verse","number":18,"content":["དོན་ཐམས་ཅད་ནི་དཀོན་མཆོག་ནས་བྱུང་བ༌སྟེ། ཁོང་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་བརྒྱུད་ནས་བདག་ཅག་ཁོང་དང་འདུམ་པར་མཛད་པ༌དང༌། མི་རྣམས་ཁོང་དང་འདུམ་པར་མཛད་པའི་ལས་འགན་ཡང་བདག་ཅག་ལ་གནང༌བ་ཡིན།"]},{"type":"verse","number":19,"content":["དེ་ནི་དཀོན་མཆོག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་འཇིག་རྟེན་གྱི་མི་རྣམས་ཁོང་ཉིད་དང་འདུམ་པར་མཛད༌ཅིང༌། ཁོ་རྣམས་ཀྱི་ཉེས་སྐྱོན་ཁོ་རྣམས་ལ་མི་འགེལ༌བར། འདུམ་པར་མཛད་པའི་བཀའ་ཡང་བདག་ཅག་ལ་བཅོལ་བ་ཡིན།"]},{"type":"verse","number":20,"content":["དེ་བས་ངེད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ཚབ་པ་ཡིན༌ལ། དཀོན་མཆོག་གིས་ངེད་ཅག་བརྒྱུད་ནས་ཁྱོད་རྣམས་ལ་བསྐུལ་བ༌བཞིན། ངེད་ཅག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཚབ་བྱས་ནས་ཁྱོད་རྣམས་དཀོན་མཆོག་དང་འདུམ་པར༌ཞུའོ།།"]},{"type":"verse","number":21,"content":["བདག་ཅག་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་ནས་དཀོན་མཆོག་གི་མི་རྣམ་དག་ཏུ་འགྱུར་བའི༌ཕྱིར། དཀོན་མཆོག་གིས་སྡིག་པ་མེད་པ་དེ་ཉིད་བདག་ཅག་གི་ཚབ་ཏུ་སྡིག་པར་མཛད༌དོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/4.json","previousChapterAudioLinks":{},"numberOfVerses":21}