{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":7,"content":[{"type":"heading","content":["སྐུ་ཚབ་པ་ཕོལ་ལོལ་གྱི་དགའ༌སྤྲོ།"]},{"type":"verse","number":1,"content":["དེ་བས་ན། སྙིང་ཉེ་བའི་སྤུན་ཟླ༌རྣམས། བདག་ཅག་ལ་དེ་ལྟ་བུའི་ཞལ་བཞེས་ཡོད་པས་རང་ཉིད་གཙང་མར་བྱས༌ཏེ། ལུས་སེམས་ཀྱི་མི་གཙང་བ་ཐམས་ཅད་དོར་ནས་དཀོན་མཆོག་ལ་གུས་ཤིང་འཇིགས་པའི་ངང་ནས་དམ་པ་རུ་འགྱུར་བར་བྱེད་དགོས་སོ།།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་སེམས་རྒྱ་བསྐྱེད་ནས་ངེད་ཅག་དང་ལེན་བྱེད་པར༌གྱིས། ངེད་ཅག་གིས་མི་སུ་ལའང་གྱོང་གུད་མ༌བཟོས། སུ་ཡང་ཉམས་དམས་སུ་མ་བཏང་། སུ་ལས་ཀྱང་ཁེ་བཟང་མ་བླངས་སོ།།"]},{"type":"verse","number":3,"content":["བདག་གིས་འདི་ལྟར་སྨྲས་པ་ནི་ཁྱོད་རྣམས་ལ་སྐྱོན་སྨྲ་བའི་ཕྱིར་མིན༌ཏེ། ཁྱོད་རྣམས་རྟག་ཏུ་ངེད་ཅག་གི་སེམས་སུ་གནས༌ཤིང༌། བདག་ཅག་གསོན་ན་མཉམ་གསོན་དང་ཤི་ན་མཉམ་ཤི་བྱེད་པར་དགའ་ཞེས་དེ་སྔར་བདག་གིས་སྨྲས་མྱོང༌།"]},{"type":"verse","number":4,"content":["བདག་གིས་སྤོབས་པ་ཆེན་པོས་ཁྱོད་རྣམས་ལ་གཏམ་སྨྲས༌ཤིང༌། ཁྱོད་ཅག་གི་རྐྱེན་གྱིས་བསྟོད་པ་མང་པོ་བརྗོད་ཅིང་སེམས་གསོ་ཆེན་པོ་ཐོབ༌པ་དང་། ངེད་ཅག་ལ་དཀའ་སྡུག་ཐམས་ཅད་ཀྱི་ཁྲོད་ནས་དགའ་སྤྲོ་དཔག་མེད་བྱུང༌ངོ༌།།"]},{"type":"verse","number":5,"content":["དེ་ཡང་སྔོན་ཆད་ངེད་ཅག་མ་ཀེ་དོན་ཡཱ་ཡུལ་དུ་སླེབས་པའི་དུས༌སུ། རང་གི་ལུས་པོར་ངལ་གསོ་གང་ཡང་མ་བྱུང་བར། ཕྱོགས་བཞི་ནས་དཀའ་སྡུག་སྣ་ཚོགས་ལ༌ཕྲད་ཅིང་། ཕྱི་རུ་འཁྲུག་རྩོད་དང་ནང་དུ་འཇིགས་པ༌ཡོད་དོ།།"]},{"type":"verse","number":6,"content":["འོན༌ཀྱང༌། ཡིད་སྐྱོ་བ་རྣམས་ལ་སེམས་གསོ་གནང་མཁན་དཀོན་མཆོག་གིས་ཐེ་ཏུ་སླེབས་པ་བརྒྱུད་ནས་ངེད་ཅག་ལ་སེམས་གསོ་མཛད་པར་མ༌ཟད།"]},{"type":"verse","number":7,"content":["ཐེ་ཏུ་ཡིས་ཁྱོད་ཅག་ནས་ཐོབ་པའི་སེམས་གསོར་བརྟེན་ནས་ངེད་ཅག་ལ་སེམས་གསོ་བྱས་པ་ཡིན། ཁོས་ཁྱོད་ཅག་གི་དུང་སེམས༌དང༌། སེམས་སྡུག བདག་ལ་བཅངས་པའི་སྤྲོ་སེམས་ཐམས་ཅད་བདག་ལ་སྨྲས༌པས། ང་རང་སྔར་ལས་ལྷག་ཏུ་དགའ་བར་གྱུར་ཏོ།།"]},{"type":"verse","number":8,"content":["དེ་སྔར་བདག་གིས་འཕྲིན་ཡིག་བྲིས་ཏེ་ཁྱོད་རྣམས་ལ་སེམས་སྐྱོ་རུ་བཅུག་པས་ང་རང་རེ་ཞིག་འགྱོད་བྱུང་ལ། འཕྲིན་ཡིག་དེས་ཁྱོད་རྣམས་ལ་སེམས་སྐྱོ་རུ་བཅུག་པ་ནི་གནས་སྐབས་ཙམ་ཡིན་པ་བདག་གིས་ཤེས༌པས། ད་ནི་བདག་ལ་འགྱོད་པ་མེད་དོ།།"]},{"type":"verse","number":9,"content":["ད་ལྟ་ང་རང་དགའ་བ་ནི་ཁྱོད་ཅག་གི་སེམས་སྐྱོ་བའི་ཕྱིར་མིན༌ཏེ། ཁྱོད་ཅག་གིས་སྐྱོ་སེམས་ཀྱི་ཁྲོད་ནས་འགྱོད་བཤགས་བྱས་པའི་ཕྱིར༌ཡིན། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་ཁྱོད་ཅག་གི་སེམས་སྐྱོ༌ཞིང༌། ལས་གང་ལའང་ངེད་ཅག་གི་རྐྱེན་གྱིས་གྱོང་གུད་ཐེབས་མི་སྲིད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་སེམས་སྐྱོ་བ་ཡིས་ཐར་ལམ་ལ་འཁྲིད་པའི་འགྱོད་བཤགས་འབྱུང་དུ་འཇུག་ཅིང་། དོན་དེར་འགྱོད་པ་གཅིག་ཀྱང་མེད་དོ།། འོན་ཀྱང་། འཇིག་རྟེན་གྱི་སྐྱོ་གདུང་གིས་མི་རྣམས་འཆི་བར་བྱེད་པ་ཡིན།"]},{"type":"verse","number":11,"content":["ལྟོས༌དང༌། དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་ཁྱོད་ཅག་གི་སེམས་སྐྱོ་བར་གྱུར་པ་ནས༌བཟུང༌། ཁྱོད་རྣམས་ལ་བརྩོན་འགྲུས༌དང༌། ཉེས་སྐྱོན་མེད་པ། ཁྲོ་གཏུམ། འཇིགས༌སྣང༌། དུང༌སེམས། སྤྲོ༌སེམས། རང་ལ་ཆད་པ་གཅོད་པ་བཅས་བྱུང་བ༌དང༌། དོན་དེ་ཐམས་ཅད་ལས་ཁྱོད་ཅག་གཙང་མ་ཡིན་པ་གསལ་པོར་མངོན་ནོ།།"]},{"type":"verse","number":12,"content":["བདག་གིས་སྔོན་ཆད་ཁྱོད་རྣམས་ལ་འཕྲིན་ཡིག་བྲིས༌ཤིང༌། དེ་ནི་ཉེས་སྐྱོན་བཟོ་མཁན་དེའི་ཆེད་དུ་མིན༌ལ། ཉེས་སྐྱོན་ཐེབས་མཁན་གྱི་དོན་དུའང་མ་ཡིན༌པར། དཀོན་མཆོག་གི་སྤྱན་སྔར་ཁྱོད་རྣམས་ཀྱིས་ངེད་ཅག་ལ་སེམས་ཁུར་བྱས་པའི་སྤྲོ་སེམས་དེ་ཉིད་ཁྱོད་ཅག་ལ་གསལ་པོར་མངོན་པའི་ཕྱིར་ཡིན༌པས།"]},{"type":"verse","number":13,"content":["ངེད་ཅག་ལ་སེམས་གསོ་ཐོབ་པར་མ༌ཟད། ཁྱོད་རྣམས་ཀྱིས་ཐེ་ཏུའི་ཡིད་སེམས་སྤྲོ་བར་བྱས་ཤིང་ཁོ་རང་དགའ་བར་གྱུར་པས་ངེད་ཅག་ལྷག་ཏུ་དགའ་ཞིང་སྤྲོ་བར་གྱུར་ཏོ།།"]},{"type":"verse","number":14,"content":["བདག་གིས་ཐེ་ཏུའི་མདུན་ནས་ཁྱོད་རྣམས་ལ་བསྔགས་བརྗོད་གང་ཞིག་བྱས་པ་ཡིན༌ན། བདག་ལ་ངོ་གནོང་བའི་དོན་མེད༌དེ། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲས་པ་ཐམས་ཅད་བདེན་པ་ཡིན་པ༌ལྟར། ཐེ་ཏུའི་མདུན་ནས་ཁྱོད་རྣམས་ལ་བསྔགས་བརྗོད་བྱས་པའང་བདེན་པ་ཡིན།"]},{"type":"verse","number":15,"content":["ཐེ་ཏུས་ཁྱོད་རྣམས་ཐམས་ཅད་ཀྱིས་ཁོའི་ངག་ལ་མཉན་པ་དང་སྐྲག་ཅིང་འདར་བའི་ངང་ནས་ཁོ་ལ་སྣེ་ལེན་བྱས་པ་དྲན༌པས། ཁོ་རང་ཁྱོད་རྣམས་ལ་ལྷག་ཏུ༌དགའ་བར་གྱུར་པ་ཡིན།"]},{"type":"verse","number":16,"content":["དོན་ཀུན་ནས་ང་རང་ཁྱོད་རྣམས་ལ་ཡིད་ཆེས་པས་དགའོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}