{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2CO","translationId":"bod_ntb","name":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","commonName":"ཀོ་རིན་ཐུ་པ་གཉིས་པ།","title":"༄༅། །ཀོ་རིན་ཐུ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":47,"numberOfChapters":13,"sha256":"643ae582bf6c414b615f75709a972995908d60e64cd54a0c37a666148ad80ae2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":8,"content":[{"type":"heading","content":["ཞལ་འདེབས་འབུལ་མཁན་ལ་སྐུལ་མ་གནང་བའི༌སྐོར།"]},{"type":"verse","number":1,"content":["ཀྱེ། སྤུན་ཟླ༌རྣམས། དཀོན་མཆོག་གིས་མ་ཀེ་དོན་ཡཱ་ཡུལ་གྱི་ཆོས་ཚོགས་དག་ལ་གནང་བའི་ཐུགས་རྗེ་དེ་ངེད་ཅག་གིས་ཁྱོད་རྣམས་ལ་འཆད་པར༌བྱའོ།།"]},{"type":"verse","number":2,"content":["ཆོས་ཚོགས་དེ་དག་ལ་དཀའ་སྡུག་གི་ཁྲོད་དུ་ཚོད་བགམ་ཆེན་པོ་ཐེབས་པའི་དུས་སུའང་དགའ་སྤྲོ་དཔག་མེད་ཡོད་པ༌དང༌། ཁོ་རྣམས་ཤིན་ཏུ་དབུལ་བའི་དུས་སུའང་ཞལ་འདེབས་འབུལ་བར་དགའ་བས་ཁོ་རྣམས་ཀྱི་བཀའ་དྲིན་ལྷག་ཏུ་ཆེའོ།།"]},{"type":"verse","number":3,"content":["ཁོ་རྣམས་ཀྱིས་རང་གི་ནུས་པ་བཞིན་བསྒྲུབས་པར་མ༌ཟད། ནུས་པ་ལས་བརྒལ་ནའང་ཞལ་འདེབས་འབུལ་བར་སེམས་དགའ་བ༌དང༌།"]},{"type":"verse","number":4,"content":["དད་ལྡན་དམ་པ་གཞན་དག་ལ་འབུལ་བ་ཕུལ་བའི་ཐུགས་རྗེའི་ནང་དུ་ཞུགས་པའི་རེ་བ་ཡང་ཡང་ཞུས་མྱོང་བར་བདག་གིས་བདེན་དཔང་བྱ་ནུས༌པ་ཡིན།"]},{"type":"verse","number":5,"content":["གཞན༌ཡང༌། ཁོ་རྣམས་ཀྱིས་ངེད་ཅག་གི་རེ་བ་ལས་ལྷག་པ་བསྒྲུབས་པར་མ༌ཟད། དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་ཐོག་མར་རང་ཉིད་གཙོ་བོ་ལ་ཕུལ་བ༌དང༌། ངེད་ཅག་ལའང་གཏོགས་པར་བྱས་སོ།།"]},{"type":"verse","number":6,"content":["དེའི༌ཕྱིར། ངེད་རྣམས་ཀྱིས་ཐེ་ཏུ་ལ། ཁོས་སྔར་ནས་འགོ་བརྩམས་པ་ལྟར་ཁྱོད་ཅག་གི་ཁྲོད་དུ་བྱམས་སྙིང་རྗེའི་དོན་དེ་ཉིད་ཀྱང་སྒྲུབས་ཤིག་ཅེས་སྐུལ་མ་གནང༌བ་ཡིན་ལ།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་དད་སེམས༌དང༌། སྨྲ༌བརྗོད། ཤེས༌བྱ། བརྩོན༌སེམས། ངེད་ཅག་ལ་བཅངས་པའི་བྱམས་པ་བཅས་ལས་ཕུན་སུམ་ཚོགས་པ་མངོན༌པ་བཞིན། བྱམས་སྙིང་རྗེའི་དོན་འདིའི་སྟེང་དུའང་ཕུན་སུམ་ཚོགས་པར་གྱུར་ཅིག།"]},{"type":"verse","number":8,"content":["བདག་གིས་དེ་ལྟར་སྨྲས་པ་ནི་ཁྱོད་རྣམས་ལ་བཀའ་ཕབ་པ་མིན༌ཏེ། མི་གཞན་གྱི་བརྩོན་སེམས་ལ་བརྟེན་ནས་ཁྱོད་ཅག་གི་བྱམས་པ་དངོས་མ་ཡིན་མིན་ལ་ཚོད་བགམ་བྱེད༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":9,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཐུགས་རྗེ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཤེས༌ཏེ། ཁོང་ནི་ཕྱུག་པོ་ཡིན༌ཡང༌། ཁྱོད་ཅག་གི་ཆེད་དུ་དབུལ་ཞིང་ཕོངས་པར་གྱུར་པ༌དང༌། དེ་ནི་ཁོང་ཉིད་དབུལ་བར་བརྟེན་ནས་ཁྱོད་རྣམས་འབྱོར་བ་དང་ལྡན་པར་འགྱུར་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":10,"content":["བདག་གིས་དོན་འདིའི་སྟེང་ནས་རང་གི་དྲན་འཆར་ཁྱོད་ཅག་ལ་སྨྲ་ཞིང་དེ་ནི་ཁྱོད་རྣམས་ལ་ཕན་ཐོགས་ཡོད་དེ། ཁྱོད་ཅག་གིས་དོན་དེ་འགོ་བརྩམས་ཤིང་དེ་བསྒྲུབ་འདོད་ཀྱི་སེམས་ཀྱང་བྱུང་ནས་ལོ་གཅིག་ཙམ་འགོར༌བས།"]},{"type":"verse","number":11,"content":["སྔོན་ལ་ཇི་ལྟར་བསྒྲུབ་འདོད་པའི་སེམས་ཡོད༌ན། ད་ལྟ་དོན་དེ་བསྒྲུབ་འོས༌ཏེ། ཁྱོད་ཅག་གིས་ནུས་པ་བཞིན་དུ་བསྒྲུབ་འོས་སོ།།"]},{"type":"verse","number":12,"content":["མི་ལ་བསྒྲུབ་འདོད་ཀྱི་སེམས་ཡོད༌ན། དེ་ནི་རང་ལ་ཅི་ཡོད་པ་བཞིན་འབུལ་བས་ཆོག་སྟེ། རང་ལ་གང་ཞིག་མེད་པ་ལྟར་འབུལ་བ་མིན།"]},{"type":"verse","number":13,"content":["བདག་གིས་སྨྲས་པའི་དོན་ནི་མི་གཞན་དག་གི་ཁུར་པོ་ཇེ་ཡང་དུ་གཏོང་བ་དང་། ཁྱོད་ཅག་ལ་དཀའ་སྡུག་མྱང་དུ་འཇུག་པའི་ཕྱིར་མ་ཡིན་པར་ཆ་སྙོམས་ཡོང་བའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":14,"content":["མ་འོངས་པར་ཁྱོད་རྣམས་ཀྱི་མི་འདང་ས་དེ་ཁོ་རྣམས་ཀྱི་འབྱོར་བ་ལས་ཁ་བསྐང་བར་འགྱུར་བའི་ཕྱིར། ད་ལྟ་ཁྱོད་ཅག་གི་འབྱོར་བས་ཁོ་རྣམས་ཀྱི་དགོས་མཁོ་སྐོང་འོས༌ཤིང༌། དེ་ལྟར་བྱས་ན་ཆ་སྙོམས་སུ་འགྱུར་རོ།།"]},{"type":"verse","number":15,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"མང་པོ་བསྡུས་ཀྱང་ཁོ་ལ་ལྷག་མ་མེད༎","poem":1},{"lineBreak":true},{"text":"ཉུང་ངུ་བསྡུས་ཀྱང་ཁོ་ལ་མི་འདང་མེད།།","poem":1},"ཅེས་བཀོད་པ་བཞིན༌ནོ།།"]},{"type":"heading","content":["ཀོ་རིན་ཐུ་གྲོང་ཁྱེར་དུ་ཐེ་ཏུ་མངགས༌པ།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་གིས་ཐེ་ཏུ་ལ་སེམས་འགུལ་ཐེབས་པར་མཛད་དེ་བདག་དང་མཚུངས་པར་ཁྱོད་ཅག་ལ་སྤྲོ་སེམས་བཅངས༌ཡོད་པས། དཀོན་མཆོག་ལ་ཐུགས་རྗེ་ཆེ༌ཞུའོ།།"]},{"type":"verse","number":17,"content":["ཐེ་ཏུས་བདག་གི་ངག་ལ་མཉན་པ་དང་དེ་ལས་ཀྱང་སྤྲོ་སེམས་ཆེ་ཞིང་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་ཕྱིན་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ངེད་ཅག་གིས་སྤུན་ཟླ་གཞན་ཞིག་ཀྱང་ཁོ་དང་མཉམ་དུ་མངགས་ཤིང༌། སྤུན་ཟླ་དེ་ནི་འཕྲིན་བཟང་གི་ཕྱོགས་ནས་ཆོས་ཚོགས་ཀུན་གྱི་བསྔགས་བརྗོད་ཐོབ་མྱོང་བ་ཞིག་ཡིན༌པར་མ་ཟད།"]},{"type":"verse","number":19,"content":["ཁོ་རང་ཡང་ཆོས་ཚོགས་དག་གིས་བདམས་ནས་ངེད་རྣམས་དང་མཉམ་དུ་འགྲོ་བར་མཛད་པ༌དང༌། ངེད་རྣམས་ལ་བཅོལ་བའི་ཞལ་འདེབས་ཁྱེར་ནས་སླེབ་དགོས་པ་སྟེ། གཙོ་བོ་ལ་གཟི་བརྗིད་མང་དུ་འབུལ་བ་དང་ངེད་ཅག་གི་བསྒྲུབ་པར་དགའ་བའི་སེམས་པའང་གསལ་པོར་མངོན༌པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":20,"content":["དེ་ནི་ངེད་ཅག་གིས་ཞལ་འདེབས་དངུལ་སྒོར་མང་པོ་བསྡུས་པས་སུས་ཀྱང་ངེད་ཅག་ལ་སྐྱོན་མི་འཛུགས་པའི་ཆེད་དུ་ཡིན༌ལ།"]},{"type":"verse","number":21,"content":["ངེད་ཅག་གིས་ནན་ཏན་གྱི་ངང་ནས་དོན་ལེགས་པོར་བསྒྲུབ༌པར་དམིགས་ཤིང༌། གཙོ་བོའི་སྤྱན་སྔར་དེ་ལྟར་སྒྲུབ་པ་དང་མི་རྣམས་ཀྱི་མིག་མདུན་དུའང་དེ་ལྟར་སྒྲུབ་བཞིན་ཡོད་དོ།།"]},{"type":"verse","number":22,"content":["ཡང་ངེད་ཅག་གིས་སྤུན་ཟླ་གཞན་ཞིག་ཀྱང་ཁོ་གཉིས་དང་མཉམ་དུ་མངགས་སོ།། ངེད་ཅག་གིས་དོན་དག་མང་པོ་ཞིག་ནས་ཁོ་ལ་ཚོད་བགམས་མྱོང༌ལ། ཁོ་ནི་བརྩོན་སེམས་ཆེ་བ་ཞིག་ཡིན། ད་ལྟ་ཁོས་ཁྱོད་རྣམས་ལ་ཡིད་ཆེས་ཆེན་པོ་བྱེད་པས་ཁོའི་བརྩོན་སེམས་ནི་སྔར་ལས་ཀྱང༌ཆེའོ།།"]},{"type":"verse","number":23,"content":["ཐེ་ཏུ་གླེང་ན། ཁོ་ནི་བདག་གི་ལས་གྲོགས་ཡིན༌ལ། བདག་དང་མཉམ་དུ་ཁྱོད་ཅག་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཞིག་ཀྱང་ཡིན། སྤུན་ཟླ་གཞན་གཉིས་ཀ་གླེང་ན། ཁོ་གཉིས་ནི་ཆོས་ཚོགས་དག་གི་བང་ཆེན་དང་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་གཟི་བརྗིད་ཀྱང་ཡིན།"]},{"type":"verse","number":24,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་གིས་ངེས་པར་ཆོས་ཚོགས་དག་གི་དྲུང་དུ་མངོན་པའི་བྱམས་པ་ལ་བདེན་དཔང་བྱེད་པ༌དང༌། ངེད་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་བསྔགས་བརྗོད་བྱས་པའི་རྒྱུ་མཚན་ཡང་སྟོན་དགོས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2CO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2CO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2CO/7.json","previousChapterAudioLinks":{},"numberOfVerses":24}