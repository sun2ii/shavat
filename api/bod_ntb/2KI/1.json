{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":1,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཨ་ཧ་ཟི་ཡཱ་ལ་ཉེས་ཆད་བཅད་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨ་ཧབ་ཚེ་ལས་འདས་རྗེས། མོ་ཨབ་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་ལ་ངོ་ལོག་བྱས་པ་དང་།"]},{"type":"verse","number":2,"content":["དེ་ནས་ཨ་ཧ་ཟི་ཡཱ་ཞེས་བྱ་བ་སཱ་མར་ཡ་རུ་ཡོད་པའི་ཁོའི་ཐོག་ཁང་གི་སྒེའུ་ཁུང་ལས་མར་འགྱེལ་ནས་ན་བར་གྱུར་པས། ཨེག་རོན་གྱི་ལྷ་པཱ་ཨལ་ཟེ་བུབ་",{"noteId":0},"ལ། ང་ནི་ནད་འདི་ལས་དྲག་པར་འགྱུར་རམ་མི་འགྱུར་བཀའ་འདྲི་ཞུ་རུ་སོང་ཞིག་ཅེས་སྨྲས་ནས་བང་ཆེན་རྣམས་མངགས་སོ། །"]},{"type":"verse","number":3,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཐི་ཞི་ཡུལ་ནས་འོངས་པའི་ཨེ་ལི་ཡཱ་ཞེས་བྱ་བ་ལ་འདི་སྐད་དུ། ཡར་ལོངས་ལ་སཱ་མར་ཡའི་རྒྱལ་པོའི་བང་ཆེན་དང་འཕྲད་དུ་སོང་། དེ་དག་ལ་འདི་ལྟར་ཤོད་ཅིག ཁྱོད་རྣམས་ཨེག་རོན་གྱི་ལྷ་པཱ་ཨལ་ཟེ་བུབ་རྩར་བཀའ་འདྲི་ཞུ་རུ་འགྲོ་བ་དེ་ཅི་ཡིན། ཡེས་ར་ཨེལ་ལ་དཀོན་མཆོག་མེད་པའི་རྐྱེན་ཡིན་ནམ།"]},{"type":"verse","number":4,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཡར་འགོས་ཡོད་པའི་མལ་ཁྲི་ལས་མར་འབབ་པར་མི་འགྱུར་ཏེ། ཁྱོད་རང་འཆི་བར་ངེས་པས་སོ་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་པ་ན། ཨེ་ལི་ཡཱ་ལམ་དུ་ཆས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་བང་ཆེན་རྣམས་ཨ་ཧ་ཟི་ཡཱའི་གམ་དུ་ཕྱིར་ལོག་འོངས་པས། རྒྱལ་པོས་དེ་དག་ལ་ཁྱོད་ཚོ་ཕྱིར་འོངས་པ་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":6,"content":["དེ་དག་གིས་རྒྱལ་པོ་ལ། མི་ཞིག་ངེད་ཅག་དང་འཕྲད་དུ་འོངས་ནས་ང་ཚོར་ན་རེ། ཁྱོད་ཚོ་མངག་མཁན་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིར་སོང་ནས་ཁོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨེག་རོན་གྱི་ལྷ་པཱ་ཨལ་ཟེ་བུབ་ལ་བཀའ་འདྲི་ཞུ་རུ་མངགས་པ་དེ་ཅི་ཡིན་ནམ། ཡེས་ར་ཨེལ་ལ་དཀོན་མཆོག་མེད་པས་ཡིན་ནམ། དེའི་ཕྱིར་ཁྱོད་ཡར་འགོས་ཡོད་པའི་མལ་ཁྲི་ལས་མར་འབབ་པར་མི་འགྱུར་ཏེ། ཁྱོད་རང་འཆི་བར་ངེས་པས་སོ་ཞེས་གསུངས་སྨྲོས་ཤིག་ཅེས་གསུངས་བྱུང་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":7,"content":["རྒྱལ་པོས་དེ་དག་ལ། ཁྱོད་ཚོ་ལ་ཕྲད་ནས་གཏམ་བྱས་པའི་མི་ཅི་འདྲ་ཡིན་ནམ་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":8,"content":["དེ་དག་ན་རེ། ཁོའི་ལུས་ལ་ལྭ་བ་སྤུ་རིང་ཅན་གྱོན་པ་དང་ཀོ་བའི་སྐ་རགས་བཅིངས་འདུག་ཅེས་ཞུས་པ་ལ། ཁོས་དེ་ནི་ཐི་ཞི་པ་ཨེ་ལི་ཡཱ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་རྒྱལ་པོས་ལྔ་བཅུ་དཔོན་པོ་ཞིག་དང་ཁོའི་ལག་འོག་མི་ལྔ་བཅུ་དང་བཅས་པ་ཨེ་ལི་ཡཱ་ཡི་གམ་དུ་མངགས། དེ་དག་ཁོང་ཡོད་སར་ཕྱིན་པ་ན། ལྟོས་དང་། ཨེ་ལི་ཡཱ་རི་རྩེར་བཞུགས་འདུག་པ་དང་། དེས་ཁོང་ལ། ཀྱེ་དཀོན་མཆོག་གི་སྐྱེས་བུ། རྒྱལ་པོས་ཁྱོད་མར་འབབ་པའི་བཀའ་བསྒོས་སོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":10,"content":["ཨེ་ལི་ཡཱས་ལྔ་བཅུ་དཔོན་པོ་ལ། ང་རང་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིན་ན་ནམ་མཁའ་ནས་མེ་བབས་ཏེ་ཁྱོད་དང་ཁྱོད་ཀྱི་ལག་འོག་ལྔ་བཅུ་པོ་དེ་མེ་ཡིས་འཇོམས་པར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་། ནམ་མཁའ་ནས་མེ་བབས་ཏེ་ལྔ་བཅུ་དཔོན་པོ་དང་ཁོའི་ལག་འོག་ལྔ་བཅུ་མེ་ཡིས་བཅོམ་པའོ། །"]},{"type":"verse","number":11,"content":["ཡང་རྒྱལ་པོས་ལྔ་བཅུ་དཔོན་པོ་གཞན་ཞིག་དང་ཁོའི་ལག་འོག་མི་ལྔ་བཅུ་དང་བཅས་པ་ཨེ་ལི་ཡཱ་ཡི་གམ་དུ་མངགས་ཤིང་། དེས་ཁོང་ལ། ཀྱེ་དཀོན་མཆོག་གི་སྐྱེས་བུ། རྒྱལ་པོས་ཁྱོད་མྱུར་དུ་མར་འབབ་པའི་བཀའ་བསྒོས་སོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":12,"content":["ཨེ་ལི་ཡཱས་དེ་རྣམས་ལ་ལན་དུ། ང་རང་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིན་ན་ནམ་མཁའ་ནས་མེ་བབས་ཏེ་ཁྱོད་དང་ཁྱོད་ཀྱི་ལག་འོག་ལྔ་བཅུ་པོ་དེ་མེ་ཡིས་འཇོམས་པར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་། དཀོན་མཆོག་ནས་བྱུང་བའི་མེ་ནམ་མཁའ་ལས་བབས་ཏེ་ལྔ་བཅུ་དཔོན་པོ་དང་ཁོའི་ལག་འོག་ལྔ་བཅུ་མེ་ཡིས་བཅོམ་པའོ། །"]},{"type":"verse","number":13,"content":["ཡང་རྒྱལ་པོས་ལྔ་བཅུ་དཔོན་པོ་གསུམ་པ་དང་ཁོའི་ལག་འོག་ལྔ་བཅུ་དང་བཅས་པ་མངགས་ཤིང་། ལྔ་བཅུ་དཔོན་པོ་གསུམ་པ་དེ་ཡར་སོང་ནས་ཨེ་ལི་ཡཱ་ཡི་མདུན་དུ་པུས་མོ་སར་བཙུགས་ཏེ་ཁོང་ལ་ཞུ་བ་ཕུལ་ནས་ན་རེ། ཀྱེ་དཀོན་མཆོག་གི་སྐྱེས་བུ་ལགས། བདག་གི་སྲོག་དང་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ལྔ་བཅུ་པོ་འདི་རྣམས་ཀྱི་སྲོག་ནི་ཉིད་ཀྱི་སྤྱན་སྔར་གཙིགས་ཆེན་དུ་བརྩི་བར་མཛོད་ཅིག"]},{"type":"verse","number":14,"content":["གཟིགས་དང་། སྔར་ནམ་མཁའ་ནས་མེ་བབས་ཏེ། དེ་སྔར་འོངས་པའི་ལྔ་བཅུ་དཔོན་པོ་གཉིས་པོ་དང་དེ་དག་སོ་སོའི་ལག་འོག་ལྔ་བཅུ་དང་བཅས་པ་མེ་ཡིས་བཅོམ་པ་ཡིན། ད་ནི་བདག་གི་སྲོག་འདི་ཁྱེད་ཀྱི་སྤྱན་སྔར་གཙིགས་ཆེན་དུ་བརྩི་བར་མཛོད་ཅེས་གསོལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཨེ་ལི་ཡཱ་ལ། ཁོ་དང་མཉམ་དུ་མར་སོང་དང་དེ་ལ་མ་འཇིགས་ཤིག་ཅེས་བསྒོས་པས། ཁོང་ཡར་ལངས་ནས་དེ་དང་མཉམ་དུ་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན།"]},{"type":"verse","number":16,"content":["ཨེ་ལི་ཡཱས་རྒྱལ་པོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨེག་རོན་གྱི་ལྷ་པཱ་ཨལ་ཟེ་བུབ་རྩར་བང་ཆེན་མངགས་ནས་བཀའ་འདྲི་ཞུ་བའི་རྒྱུ་མཚན་ཅི་ཡིན། ཡེས་ར་ཨེལ་ལ་བཀའ་འདྲི་ཞུ་སའི་དཀོན་མཆོག་མེད་པས་ཡིན་ནམ། དེའི་ཕྱིར་ཁྱོད་ཡར་འགོས་ཡོད་པའི་མལ་ཁྲི་ལས་མར་འབབ་པར་མི་འགྱུར་བར་འཆི་ངེས་ཡིན་གསུངས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་རྒྱལ་པོ་ནི་ཨེ་ལི་ཡཱས་སྦྲན་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་ཤི་སྟེ། ཁོ་ལ་སྲས་མེད་པས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ཀྱི་སྲས་ཡེ་ཧོ་རཱམ་གྱིས་སྲིད་བསྐྱངས་པའི་ལོ་གཉིས་པར། ཨ་ཧ་ཟི་ཡཱ་ཡི་ནུ་བོ་ཡོ་རཱམ་",{"noteId":1},"དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་བཞུགས་སོ། །"]},{"type":"verse","number":18,"content":["ཨ་ཧ་ཟི་ཡཱའི་ལས་དོན་གཞན་རྣམས་ནི། ཡེས་ར་ཨེལ་པའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"པཱ་ཨལ་ཟེ་བུབ་ནི་རུལ་སུངས་ལ་རྒོལ་བའི་ཟུར་ཟའི་མིང་སྟེ། སྦྲང་ཚོགས་ཀྱི་འཇིག་རྟེན་དབང་དུ་སྒྱུར་བའི་གཏེ་བོ་ཞེས་པའི་བརྙས་བཅོས་ཀྱི་བརྡ་མཚོན་ཞིག་ཡིན།","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"ཡེས་ར་ཨེལ་གྱི་སྐད་དུ་ཡེ་ཧོ་རཱམ་ཞེས་བྲིས་ཡོད། འོན་ཀྱང་ཡོ་རཱམ་རྒྱལ་པོ་ཞེས་པ་དང་ཡེ་ཧོ་རཱམ་རྒྱལ་པོ་ཞེས་པ་གཉིས་ནི་མི་གཅིག་ཡིན། ལེའུ་དང་པོའི་ཚིག་རྐང་བཅུ་བདུན་པ་དང་ལེའུ་བརྒྱད་པའི་ཚིག་རྐང་བཅུ་དྲུག་པ་ནས་ཚིག་རྐང་ཉེར་ལྔ་པ་དང་ཚིག་རྐང་ཉེར་དགུ་པ། ལེའུ་བཅུ་གཉིས་པའི་ཚིག་རྐང་བཅོ་བརྒྱད་པ་བཅས་སུ་ཡེས་ར་ཨེལ་གྱི་སྐད་དུ་ཡེ་ཧོ་རཱམ་ཞེས་བྲིས་ཡོད། ལེའུ་བརྒྱད་པའི་ཚིག་རྐང་ཉེར་གཅིག་པ་དང་ཚིག་རྐང་ཉེར་གསུམ་པ་དང་ཚིག་རྐང་ཉེར་བཞི་པ་བཅས་སུ་ཡེ་ཧོ་རཱམ་གྱི་ཚབ་ཏུ་ཡོ་རཱམ་ཞེས་བྲིས་ཡོད། གསལ་བཤད་གཞན་ཞིག་ནི། ཡེས་ར་ཨེལ་གྱི་ས་ཆ་སཱ་མར་ཡ་ཞེས་པའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་གཉིས་ནི་མིང་གཅིག་ཀྱང་མི་གཉིས་ཡིན། དེ་གཉིས་མི་འཁྲུལ་བ་གལ་ཆེ།","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/bod_ntb/2KI/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/1KI/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}