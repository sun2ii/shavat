{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":10,"content":[{"type":"heading","content":["ཡེ་ཧུས་ཨ་ཧབ་ཀྱི་བཟའ་མི་བཀྲོངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སཱ་མར་ཡ་རུ་ཨ་ཧབ་ཀྱི་བུ་བདུན་ཅུ་ཡོད་པས། ཡེ་ཧུས་འཕྲིན་ཡིག་བྲིས་ཏེ་སཱ་མར་ཡ་རུ་སྤྲིངས་པ་དང་། ཡེ་སི་རེ་ཨེལ་གྱི་འགོ་དཔོན་རྣམས་དང་། རྒན་པོ་རྣམས་དང་། ཨ་ཧབ་ཀྱི་སྲས་ལ་ལྟ་སྐྱོང་བྱེད་མཁན་རྣམས་ལ་འདི་ལྟར།"]},{"type":"verse","number":2,"content":["རང་གི་བདག་པོའི་བུ་རྣམས་ཁྱོད་ཅག་གི་རྩར་ཡོད་པ་དང་། ཁྱོད་རྣམས་ལ་ཤིང་རྟ་དང་རྟ་རྣམས་དང་། ལྕགས་རིས་བསྐོར་བའི་གྲོང་ཁྱེར་དང་། མཚོན་ཆ་བཅས་ཀྱང་ཡོད་པས། ཁྱོད་ཚོར་འཕྲིན་ཡིག་འདི་འབྱོར་འཕྲལ།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཅག་གི་བདག་པོའི་བུ་རྣམས་ལས་ལེགས་ཤིང་འོས་པ་ཞིག་བཙལ་ནས་དེའི་ཕ་ཡི་རྒྱལ་ཁྲིར་འཁོད་ཅིག ཡང་ཁྱོད་ཅག་གི་བདག་པོའི་ཁྱིམ་རྒྱུད་ཀྱི་དོན་དུ་འཐབ་མོ་འགྱེད་པར་བྱོས་ཤིག་ཅེས་སྤྲིངས་མོད།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་དེ་རྣམས་རབ་ཏུ་སྐྲག་སྟེ། ལྟོས་དང་། རྒྱལ་པོ་གཉིས་ཀྱང་ཁོའི་མདུན་དུ་ཚུགས་མ་ཐུབ་ན། ངེད་ཅག་ཁོའི་མདུན་དུ་ཇི་ལྟར་འགྲེང་ནུས་སམ་ཞེས་སྨྲས་ནས།"]},{"type":"verse","number":5,"content":["ཕོ་བྲང་གི་གཙོ་དཔོན་དང་གྲོང་ཁྱེར་གྱི་སྤྱི་དཔོན། རྒན་པོ་རྣམས། ཨ་ཧབ་ཀྱི་སྲས་ལ་ལྟ་སྐྱོང་བྱེད་མཁན་རྣམས་ཀྱིས་ཡེ་ཧུ་ལ་འཕྲིན་ཡིག་བསྐུར་ཏེ། བདག་ཅག་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡིན། ཁྱེད་ཀྱིས་ཅི་དང་ཅི་བསྒོ་བ་ཐམས་ཅད་བསྒྲུབ་པར་བྱ། བདག་ཅག་གིས་གཞན་སུ་ཡང་རྒྱལ་པོར་བསྐོ་བར་མི་བྱ། ཁྱེད་ཀྱི་སྤྱན་ལམ་དུ་ཅི་ལེགས་པ་དེ་མཛོད་ཅིག་ཞུས་པ་ལ།"]},{"type":"verse","number":6,"content":["ཡེ་ཧུས་དེ་དག་ལ་འཕྲིན་ཡིག་གཉིས་པ་བྲིས་ནས་འདི་ལྟར། གལ་ཏེ་ཁྱོད་ཅག་ངའི་ཕྱོགས་སུ་འཁོར་ནས་ངའི་སྐད་ལ་མཉན་ན། ཁྱོད་ཅག་གི་བདག་པོའི་བུ་རྣམས་ཀྱི་མགོ་བོ་བཅད་དེ། སང་ཉིན་ད་ཚོད་ངའི་རྩར་ཡེ་སི་རེ་ཨེལ་དུ་ཁྱེར་ཤོག་ཅེས་བསྒོས། དེའི་དུས་སུ་རྒྱལ་པོའི་བུ་བདུན་ཅུ་ནི་གྲོང་ཁྱེར་གྱི་བློན་ཆེན་རྣམས་དང་མཉམ་དུ་ཡོད་ལ། དེ་དག་གིས་ཁོ་རྣམས་ལ་ལྟ་སྐྱོང་བྱེད་པའོ། །"]},{"type":"verse","number":7,"content":["འཕྲིན་ཡིག་ལག་ཏུ་འབྱོར་མ་ཐག་དེ་དག་གིས་རྒྱལ་པོའི་བུ་རྣམས་བཟུང་ཞིང་མི་བདུན་ཅུ་བོ་དེ་བསད་ནས་མགོ་བོ་རྣམས་སླེ་པོའི་ནང་དུ་བཅུག་སྟེ། ཡེ་སི་རེ་ཨེལ་དུ་ཡེ་ཧུའི་གམ་དུ་བསྐྱལ།"]},{"type":"verse","number":8,"content":["དེ་ནས་བང་ཆེན་ཞིག་འོངས་ཏེ་ཡེ་ཧུ་ལ། རྒྱལ་པོའི་བུ་རྣམས་ཀྱི་མགོ་བོ་འདིར་ཁྱེར་ནས་སླེབས་སོ་ཞེས་འཕྲིན་བསྐྱལ་བ་ལ། ཁོ་ན་རེ། དེ་རྣམས་ཕུང་པོ་གཉིས་སུ་བྱས་ཏེ། གྲོང་ཁྱེར་གྱི་རྒྱ་སྒོའི་འགྲམ་ནས་ཞོགས་པའི་བར་དུ་ཞོག་ཅིག་ཅེས་བསྒོས།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཕྱི་ཉིན་ཞོགས་པའི་དུས་སུ་ཡེ་ཧུ་ཕྱི་རོལ་ཏུ་ཐོན་ནས་ལངས་ཏེ་མི་ཐམས་ཅད་ལ། ཁྱོད་ཅག་དྲང་པོ་འདུག ལྟོས་དང་། ངས་རང་གི་བདག་པོ་ལ་ངོ་ལོག་བྱས་ནས་བསད་པ་ཡིན། འོན་ཀྱང་མི་འདི་ཐམས་ཅད་ནི་སུས་བསད་པ་ཡིན་ནམ།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་སྟེ། ཁོང་གིས་ཨ་ཧབ་ཀྱི་ཁྱིམ་རྒྱུད་ལ་གསུངས་པའི་བཀའ་ཐམས་ཅད་སྟོང་པར་མ་ལུས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ཉིད་ཀྱི་ཞབས་ཕྱི་ཨེ་ལི་ཡཱ་བརྒྱུད་ནས་གསུངས་པ་དེ་བསྒྲུབས་པར་མཛད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ལྟར་ཡེ་ཧུས་ཨ་ཧབ་ཀྱི་རྒྱུད་འཛིན་ཡེ་སི་རེ་ཨེལ་དུ་ལུས་པ་ཐམས་ཅད་དང་། ཁོའི་བློན་ཆེན་རྣམས་དང་། གྲོགས་པོ་རྣམས་དང་། མཆོད་དཔོན་རྣམས་ལས་གཅིག་ཀྱང་མ་ལུས་པར་སྲོག་དང་ཕྲལ་ཏོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་ཡེ་ཧུ་ལངས་ཏེ་སཱ་མར་ཡ་རུ་ཕྱིན་པ་དང་། བེད་ཨེ་ཀེད་བྱ་བ་ལུག་རྫི་ཡོད་སའི་ལམ་དུ།"]},{"type":"verse","number":13,"content":["ཡེ་ཧུ་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟི་ཡཱའི་སྤུན་རྣམས་དང་ཕྲད་ཅིང་། ཁྱོད་ཅག་སུ་ཡིན་དྲིས་པ་ན། དེ་དག་གིས་ལན་དུ། བདག་ཅག་ཨ་ཧ་ཟི་ཡཱའི་སྤུན་མཆེད་ཡིན་ཏེ་རྒྱལ་སྲས་རྣམས་དང་རྒྱལ་ཡུམ་གྱི་བུ་རྣམས་ལ་བདེ་འཚམས་ཞུ་རུ་འགྲོའོ་ཞུས་ཤིང་།"]},{"type":"verse","number":14,"content":["ཁོས་འདི་དག་གསོན་པོར་ཟུངས་ཤིག་ཅེས་བསྒོས་པར། ཁོའི་ལག་འོག་གི་མི་རྣམས་ཀྱིས་དེ་དག་གསོན་པོར་བཟུང་ནས་མི་བཞི་བཅུ་ཞེ་གཉིས་ལས་གཅིག་ཀྱང་མ་བཏང་བར། པེད་ཨེ་ཀེད་ཀྱི་ས་དོང་གི་འགྲམ་དུ་བསད་དོ། །"]},{"type":"verse","number":15,"content":["ཡང་ཡེ་ཧུ་དེ་ནས་ཆས་པ་ན། ཁོ་བསུ་རུ་འོངས་པའི་རེ་ཁབ་ཀྱི་བུ་ཡེ་ཧོ་ན་དབ་དང་ཕྲད་ཅིང་། ཁོས་དེ་ལ་ཁམས་འདྲི་ཞུས་རྗེས། ངའི་སེམས་ཁྱེད་ལ་དྲང་བ་ལྟར་ཁྱེད་ཀྱི་སེམས་ཀྱང་ང་ལ་དྲང་པོ་ཡིན་ནམ་ཞེས་པའི་ལན་དུ། ཡེ་ཧོ་ན་དབ་ཀྱིས་དྲང་པོ་ཡིན་སྨྲས་པ་ན། ཡེ་ཧུ་ན་རེ། དེ་འདྲ་ཡིན་ན་ཁྱོད་ཀྱི་ལག་པ་སྲོངས་ཤིག་ཅེས་པར། དེས་ལག་པ་བསྲིངས་པ་དང་ཡེ་ཧུས་ཁོ་ནི་རང་གི་ཤིང་རྟ་རུ་འཐེན།"]},{"type":"verse","number":16,"content":["ཡེ་ཧུ་ན་རེ། ཁྱོད་རང་ང་དང་མཉམ་དུ་འགྲོ་ལ་ངས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བཅངས་པའི་ལྷག་སེམས་ལ་ལྟོས་ཤིག་སྨྲས་ཏེ། དེ་ནི་ཁོའི་ཤིང་རྟར་ཁྱེར་ནས་ལྷན་དུ་ཆས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་ཁོ་སཱ་མར་ཡ་རུ་ཕྱིན་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ལི་ཡཱ་ལ་གསུངས་པ་བཞིན་དུ། ཁོས་སཱ་མར་ཡ་རུ་ཤུལ་དུ་ལུས་པའི་ཨ་ཧབ་ཀྱི་མི་ཐམས་ཅད་བསད་དེ་མེད་པར་བྱས་སོ། །"]},{"type":"heading","content":["ཡེ་ཧུས་པཱ་ཨལ་བསྟེན་མཁན་རྣམས་བཀྲོངས་པ།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཡེ་ཧུས་མི་ཐམས་ཅད་བསྡུས་ནས་དེ་དག་ལ། ཨ་ཧབ་ཀྱིས་པཱ་ཨལ་ལ་ཉུང་ཙམ་དད་མོས་བྱས་ཀྱང་། ཡེ་ཧུས་དེ་ལས་ལྷག་པར་དད་མོས་བྱའོ། །"]},{"type":"verse","number":19,"content":["ད་ལྟ་པཱ་ཨལ་གྱི་ལུང་སྟོན་པ་ཐམས་ཅད་དང་། ཁོ་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཐམས་ཅད་དང་། ཁོའི་མཆོད་དཔོན་ཐམས་ཅད་གཅིག་ཀྱང་མ་ལུས་པར་ངའི་མདུན་དུ་བོས་ཤིག ངས་པཱ་ཨལ་ལ་མཆོད་པ་ཆེན་པོ་ཞིག་འབུལ་རྒྱུ་ཡིན་པས། སུ་ཞིག་མ་འོངས་ན་གསོན་པོར་ལུས་པར་མི་འགྱུར་རོ་ཞེས་བསྒོས། ཡེ་ཧུས་དེ་ལྟར་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་བ་ནི་པཱ་ཨལ་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཐམས་ཅད་མེད་པར་གཏོང་བའི་ཕྱིར་དུ་ཡིན།"]},{"type":"verse","number":20,"content":["ཡང་ཡེ་ཧུ་ན་རེ། པཱ་ཨལ་ལ་གུས་པ་བྱེད་དུ་མི་ཀུན་སྡུས་ཤིག་ཅེས་བསྒོས་པས། མི་རྣམས་ཀྱིས་དེ་གསལ་བསྒྲགས་བྱས།"]},{"type":"verse","number":21,"content":["ཡེ་ཧུས་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཀུན་ཏུ་བང་ཆེན་མངགས་པས། པཱ་ཨལ་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཐམས་ཅད་འོངས་པ་སྟེ། མི་ཡོང་བ་གཅིག་ཀྱང་མེད་ལ། དེ་རྣམས་པཱ་ཨལ་གྱི་མཆོད་ཁང་དུ་འཛུལ་ཏེ། པཱ་ཨལ་གྱི་མཆོད་ཁང་ནི་ཚུར་རོལ་ནས་ཕ་རོལ་བར་དུ་བཀང་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":22,"content":["ཡེ་ཧུས་མཆོད་གོས་གཉེར་དཔོན་ལ། པཱ་ཨལ་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཐམས་ཅད་ཀྱི་དོན་དུ་མཆོད་གོས་ཁྱེར་ཤོག་ཅེས་བསྒོས་པ་དང་། ཁོས་མཆོད་གོས་ཁྱེར་འོངས་ནས་དེ་དག་ལ་བསྐོན་པ་རེད།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཡེ་ཧུ་དང་རེ་ཁབ་ཀྱི་བུ་ཡེ་ཧོ་ན་དབ་གཉིས་པཱ་ཨལ་གྱི་མཆོད་ཁང་དུ་འཛུལ་ཏེ། པཱ་ཨལ་གྱི་ཞབས་ཕྱི་རྣམས་ལ། ཞིབ་ཏུ་ལྟོས་དང་། འདིར་ཁྱོད་ཅག་གི་ཁྲོད་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་གཅིག་ཀྱང་ཡོད་མི་རུང་སྟེ། པཱ་ཨལ་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་འབའ་ཞིག་ཡོད་རུང་བ་ཡིན་ཞེས་བསྒོས།"]},{"type":"verse","number":24,"content":["དེ་ནས་མི་རྣམས་དམར་མཆོད་དང་སྦྱིན་སྲེག་འབུལ་བར་ནང་དུ་སོང་བ་དང་། ཡེ་ཧུས་ཕྱི་རོལ་ཏུ་མི་བརྒྱད་ཅུ་བཞག་ནས་དེ་དག་ལ། ཁྱོད་ཅག་གི་ལག་ཏུ་གཏད་པའི་མི་རྣམས་ལས་གཅིག་འབྲོ་རུ་བཅུག་ན། དེའི་ཚབ་ཏུ་སྲོག་ལན་འཇལ་དགོས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་ཡེ་ཧུས་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་ཚར་བ་ཙམ་གྱིས། སྲུང་དམག་དང་དམག་དཔོན་རྣམས་ལ། ནང་དུ་འཛུལ་ནས་དེ་དག་སོད་ཅིག གཅིག་ཀྱང་ཕྱི་རོལ་ཏུ་འཐོན་པར་མི་བྱའོ་ཞེས་སྨྲས་པས། སྲུང་དམག་དང་དམག་དཔོན་རྣམས་ཀྱིས་མི་དེ་དག་རལ་གྲིས་བསྣུན་ཏེ། དེ་དག་གི་རོ་རྣམས་ཕྱི་རོལ་ཏུ་འཕངས་པ་དང་པཱ་ཨལ་མཆོད་ཁང་གི་སྦུག་ཏུ་ཕྱིན་ནས།"]},{"type":"verse","number":26,"content":["པཱ་ཨལ་མཆོད་ཁང་ལས་རྡོ་སྐུ་རྣམས་བཏོན་ནས་མེ་ལ་བསྲེགས།"]},{"type":"verse","number":27,"content":["པཱ་ཨལ་གྱི་ལྷ་རྟེན་བཅག་སྟེ། པཱ་ཨལ་མཆོད་ཁང་བཤིག་ཅིང་དེ་རིང་གི་བར་དུ་གསང་སྤྱོད་བྱས་སོ། །"]},{"type":"heading","content":["ཡེ་ཧུས་ཡེས་ར་ཨེལ་ལ་དབང་བསྒྱུར་པ།"]},{"type":"verse","number":28,"content":["དེ་ལྟར་ཡེ་ཧུས་པཱ་ཨལ་ནི་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་ནས་མེད་པར་བྱས་ཀྱང་།"]},{"type":"verse","number":29,"content":["ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པ་མ་སྤངས་ཏེ། པེད་ཨེལ་དང་དཱན་དུ་ཡོད་པའི་གསེར་གྱི་བ་ཕྲུག་གཉིས་ལས་ཕྱིར་མ་འཁོར་རོ། །"]},{"type":"verse","number":30,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་ཧུ་ལ། ཁྱོད་ཀྱིས་བདག་གི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་བསྒྲུབས་ཤིང་། ངའི་སེམས་ལ་ཅི་ཡོད་པ་ལྟར་ཨ་ཧབ་ལ་བྱས་པས། མི་རབས་བཞིའི་རིང་དུ་ཁྱོད་ཀྱི་བུ་རྣམས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་ཁྲིར་འགོད་པར་འགྱུར་ཞེས་གསུངས་ཀྱང་།"]},{"type":"verse","number":31,"content":["ཡེ་ཧུས་སེམས་ཧྲིལ་པོས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་མ་བསྲུངས་ཏེ། ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པ་རྣམས་མ་སྤངས་སོ། །"]},{"type":"verse","number":32,"content":["དེའི་ཚེ་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ཉམས་དམས་སུ་མཛད་ཅིང་། ཧ་ཟཱ་ཨེལ་གྱིས་ཡེས་ར་ཨེལ་གྱི་ས་མཚམས་ཐམས་ཅད་ནས་དེ་དག་ལ་རྒོལ་བ་སྟེ།"]},{"type":"verse","number":33,"content":["ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་ནས་གིལ་ཨད་ཀྱི་ཡུལ་ཀུན་དང་། གཱ་རྡུ་པ་དང་རུ་བེན་པ། མཱ་ན་ཤེ་པ་རྣམས་ཀྱི་ཡུལ་དང་། ཨར་ནོན་གྲམ་པ་དང་ཉེ་བའི་ཨ་རོ་ཨེར་ནས་གིལ་ཨད་དང་པཱ་ཤན་བར་དུའོ། །"]},{"type":"verse","number":34,"content":["དེ་ཡང་ཡེ་ཧུ་ཡི་དོན་གཞན་རྣམས་དང་ཁོས་ཅི་དང་ཅི་བྱས་པ་ཐམས་ཅད་དང་། ཁོའི་དཔའ་བོའི་མཛད་རྗེས་སོགས་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":35,"content":["དེ་ནས་ཡེ་ཧུ་རང་གི་ཕ་མེས་རྣམས་ཀྱི་ཁྲོད་དུ་གཟིམས་པ་དང་། དེ་དག་གིས་ཁོ་སཱ་མར་ཡ་རུ་དུར་ལ་སྦས་ཤིང་ཁོའི་སྲས་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོ་བྱས།"]},{"type":"verse","number":36,"content":["ཡེ་ཧུས་སཱ་མར་ཡ་རུ་ལོ་ཉེར་བརྒྱད་ཀྱི་རིང་ཡེས་ར་ཨེལ་ལ་རྒྱལ་སྲིད་བསྐྱངས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/9.json","previousChapterAudioLinks":{},"numberOfVerses":36}