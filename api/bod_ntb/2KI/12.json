{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["དེ་ཡང་ཡེ་ཧུས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་བདུན་པར། ཡོ་ཨ་སི་རྒྱལ་པོར་གྱུར་ཏེ་ལོ་བཞི་བཅུའི་རིང་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་སྲིད་བསྐྱངས། ཁོའི་ཡུམ་གྱི་མིང་ལ་ཙིབ་ཡཱ་ཟེར་ཏེ་པེར་ཤ་བཱ་ཞེས་པའི་གྲོང་ཁྱེར་གྱི་མི་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱ་ཡིས་མཛུབ་ཁྲིད་གནང་བའི་ཉིན་དག་ལ། ཡོ་ཨ་སི་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"verse","number":3,"content":["འོན་ཀྱང་མཐོ་གླིང་རྣམས་བརླག་པར་མ་གྱུར་པས། མི་རྣམས་ཀྱིས་སྔར་བཞིན་མཐོ་གླིང་གི་སྟེང་དུ་མཆོད་པ་ཕུལ་ནས་བསང་བཏང་བ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཡོ་ཨ་སི་ཡིས་མཆོད་ཁང་བསྐྱར་གསོ་བྱས་པ།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡོ་ཨ་སི་ཡིས་མཆོད་དཔོན་རྣམས་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་དམ་པར་ཕུལ་བའི་དངུལ་ཐམས་ཅད་དེ། མི་རེ་རེས་ཁྲལ་དུ་འཇལ་བའི་དངུལ་དང་། མི་རེ་ལ་དཔྱ་ཁྲལ་དུ་ཕོག་པའི་དངུལ་དང་། སེམས་ལ་སྐུལ་སློང་ཐེབས་ཏེ་རང་མོས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་ཕུལ་བའི་དངུལ་ཚང་མ།"]},{"type":"verse","number":5,"content":["ཁྱོད་མཆོད་དཔོན་རྣམས་ཀྱིས་རང་ལ་ཞལ་འདེབས་འབུལ་མཁན་དག་ལས་བླངས་ཏེ། མཆོད་ཁང་གང་དུ་ཞིག་རལ་དུ་སོང་ཡོད་ན་དེར་ཞིག་གསོ་བྱེད་པར་སྤྱོད་ཅིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡིས་སྲིད་བསྐྱངས་ནས་ལོ་ཉེར་གསུམ་པ་ལ་སླེབས་པའི་དུས་སུ། མཆོད་དཔོན་རྣམས་ཀྱིས་མཆོད་ཁང་ཞིག་རལ་དུ་སོང་ཡོད་ས་རྣམས་ད་དུང་ཞིག་གསོ་མ་བྱས་པ་རེད།"]},{"type":"verse","number":7,"content":["དེ་བས་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡིས་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱ་དང་། མཆོད་དཔོན་གཞན་རྣམས་བོས་ནས་དེ་དག་ལ། ཁྱོད་ཚོས་ཅིའི་ཕྱིར་མཆོད་ཁང་ཞིག་རལ་དུ་སོང་ཡོད་ས་རྣམས་ཞིག་གསོ་མ་བྱས་སམ། ད་ནི་རང་གིས་ཞལ་འདེབས་འབུལ་མཁན་ནས་དངུལ་མི་ལེན་པར། བླངས་ཟིན་པ་རྣམས་མཆོད་ཁང་ཞིག་རལ་དུ་སོང་ཡོད་ས་རྣམས་ཞིག་གསོ་བྱེད་པར་ཐོངས་ཤིག་ཅེས་བསྒོས་པ་ལ།"]},{"type":"verse","number":8,"content":["མཆོད་དཔོན་རྣམས་ཀྱིས་མི་རྣམས་ལས་དངུལ་མི་ལེན་པ་དང་། མཆོད་ཁང་ཡང་ཞིག་གསོ་མི་བྱེད་པ་ཁས་བླངས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་མཆོད་དཔོན་ཡེ་ཧོ་ཡ་དཱ་ཡིས་སྒྲོམ་བུ་ཞིག་ཁྱེར་འོངས་ཤིང་། དེའི་སྟེང་དུ་བུ་ག་བཏོད་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འོང་སའི་གཡས་ཕྱོགས་ཀྱི་མཆོད་ཁྲིའི་འགྲམ་དུ་བཞག མཆོད་དཔོན་སྒོ་སྲུང་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕུལ་བའི་དངུལ་ཚང་མ་དེའི་ནང་དུ་བཅུག"]},{"type":"verse","number":10,"content":["ཡང་དེ་དག་གིས་སྒྲོམ་བུ་ནང་གི་དངུལ་ཇེ་མང་ཡིན་པ་མཐོང་བའི་ཚེ་ན། རྒྱལ་པོའི་དྲུང་ཡིག་དང་མཆོད་དཔོན་ཆེན་པོ་བཅས་ཡར་འོངས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནས་རྙེད་པའི་དངུལ་རྣམས་བརྩིས་ནས་སྒྱེ་མོ་ནང་དུ་བཅུག་པ་དང་།"]},{"type":"verse","number":11,"content":["དངུལ་དེ་རྣམས་སྲང་ལ་བཏེགས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བསྐྱར་བཞེངས་བྱེད་མཁན་ཚོའི་ལས་དཔོན་གྱི་ལག་ཏུ་སྤྲད་པ་དང་། དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཤིང་བཟོ་དང་རྩིག་བཟོ་དང་།"]},{"type":"verse","number":12,"content":["འཇིམ་བཟོ་དང་རྡོ་བཟོ་བཅས་རྣམས་ལ་གླ་ཆ་སྤྲད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་རལ་དུ་སོང་ཡོད་ས་རྣམས་ཞིག་གསོ་བྱེད་པའི་ཕྱིར་དུ་གདུང་མ་དང་འཇམ་ཤ་བཏོད་པའི་རྡོ་ཉོ་བྱེད་དང་། མཆོད་ཁང་ཞིག་གསོ་བྱེད་པའི་འགྲོ་སོང་དུ་བཏང་བ་རེད།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕུལ་བའི་དངུལ་དེ་ལས་ནི། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཆེད་དུ་དངུལ་སྐྱོགས་དང་ཅེམ་ཙེ། ཕོར་བ་དང་དུང་། གསེར་རམ་དངུལ་གྱི་སྣོད་ཆས་གང་ཡང་མ་བཟོས་པ་ཡིན།"]},{"type":"verse","number":14,"content":["དངུལ་དེ་ལས་བཟོ་རྣམས་ལ་སྤྲད་ནས་དེ་དག་གིས་དངུལ་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ཞིག་རལ་དུ་སོང་ཡོད་ས་རྣམས་ཞིག་གསོ་བྱེད་པར་བཀོལ་བ་དང་།"]},{"type":"verse","number":15,"content":["ལས་མི་དེ་དག་གིས་གཞུང་དྲང་སྒོས་དོན་བསྒྲུབས་པའི་རྐྱེན་གྱིས་དེ་དག་ལ་སྤྲོད་རྒྱུར་དངུལ་གཏད་ཡོད་པ་རྣམས་རྩིས་མ་བརྒྱབ་པ་རེད།"]},{"type":"verse","number":16,"content":["འོན་ཀྱང་ཉེས་སེལ་མཆོད་པ་དང་སྡིག་བཤགས་མཆོད་པའི་དངུལ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་མ་བླངས་ཏེ། དེ་ནི་མཆོད་དཔོན་རྣམས་ལ་གཏོགས་སོ། །"]},{"type":"verse","number":17,"content":["དེའི་ཚེ། ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་ཡར་འོངས་ཤིང་གཱད་ཅེས་པར་དམག་འཁྲུག་བརྒྱབ་ནས་བདག་ཏུ་བཟུང་། ཡང་ཧ་ཟཱ་ཨེལ་གྱིས་ཡར་འོངས་ནས་ཡེ་རུ་སཱ་ལེམ་ལ་དམག་འཁྲུག་རྒྱག་པའི་སེམས་ཐག་བཅད་པ་དང་།"]},{"type":"verse","number":18,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡིས་རང་གི་མེས་པོ་སྟེ། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་དང་ཡེ་ཧོ་རཱམ། ཨ་ཧ་ཟི་ཡཱ་གསུམ་གྱིས་བསྔོས་པའི་རྫས་དམ་པ་རྣམས་དང་རང་གིས་བསྔོས་པའི་རྫས་དམ་པ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་དཀོར་མཛོད་དང་། རྒྱལ་པོའི་ཕོ་བྲང་དུ་ཡོད་པའི་གསེར་ཐམས་ཅད་བླངས་ནས་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་ལ་ཕུལ་བ་ན། ཧ་ཟཱ་ཨེལ་ནི་ཡེ་རུ་སཱ་ལེམ་དང་བྲལ་ནས་སོང་ངོ་། །"]},{"type":"heading","content":["ཡོ་ཨ་སི་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":19,"content":["དེ་ཡང་ཡོ་ཨ་སི་ཡི་དོན་གཞན་རྣམས་དང་། ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":20,"content":["ཡོ་ཨ་སི་ཡི་འཁོར་གཡོག་རྣམས་ལངས་ནས་ལྐོག་ཇུས་བྱས་ཏེ། ཁོ་རང་མར་སིལ་ལཱ་རུ་སླེབས་པའི་ལམ་དུ་མིལ་ལོའི་ཁང་པ་རུ་བསྣུན་ནས་བསད།"]},{"type":"verse","number":21,"content":["ཁོའི་འཁོར་གཡོག་ནང་གི་ཤིམ་ཨད་ཀྱི་བུ་ཡོ་ཟཱ་བད་དང་། ཤོ་མེར་གྱི་བུ་ཡེ་ཧོ་ཟཱ་བད་གཉིས་ཀྱིས་ཡོ་ཨ་སི་ལ་བསྣུན་པས་ཤི་བ་དང་། ཁོ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་ཁོའི་མེས་པོ་རྣམས་དང་ལྷན་དུ་དུར་ལ་སྦས་ཤིང་། ཁོའི་སྲས་ཨ་མཱ་ཙི་ཡ་ཡིས་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་སྲིད་བཟུང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/11.json","previousChapterAudioLinks":{},"numberOfVerses":21}