{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":13,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟི་ཡཱའི་སྲས་ཡོ་ཨ་སི་ཡིས་རྒྱལ་སྲིད་བཟུང་ནས་ལོ་ཉེར་གསུམ་པར། ཡེ་ཧུའི་སྲས་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་བྱ་བ་དེས་སཱ་མར་ཡ་རུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་སྲིད་ལོ་བཅུ་བདུན་ལ་བསྐྱངས།"]},{"type":"verse","number":2,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་དེ། ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པའི་རྗེས་སུ་འབྲངས་ཤིང་། དེ་རྣམས་ལས་བྱོལ་བར་མ་གྱུར་ཏོ། །"]},{"type":"verse","number":3,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་ཡེས་ར་ཨེལ་པའི་ཐོག་ཏུ་བབས་ཏེ། ཁོང་གིས་དེ་རྣམས་རྒྱུན་དུ་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་དང་དེའི་བུ་པེན་ཧ་དཱད་ཀྱི་ལག་ཏུ་གཏད།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གདོང་ཕྱོགས་ཏེ་ཞུ་འབོད་བྱས་པར་ཁོང་གིས་གསན་པར་མཛད། ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་གིས་ཡེས་ར་ཨེལ་ལ་ཐེབས་པའི་མནར་གཅོད་དེ། ཨ་རམ་གྱི་རྒྱལ་པོས་དེ་རྣམས་ཇི་ལྟར་སྡུག་ལ་སྦྱར་བའི་མནར་གཅོད་དེ་གཟིགས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་སྐྱབས་མགོན་ཞིག་གནང་ནས་ཨ་རམ་པའི་ལག་ནས་བསྐྱབས་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་སྔར་བཞིན་རང་རང་གི་གུར་དུ་གནས་སོ། །"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་དེ་རྣམས་ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ཡེ་རོབ་ཨམ་པའི་ཁྱིམ་གྱི་སྡིག་པ་རྣམས་ལས་མ་བྱོལ་བར་དེའི་ནང་དུ་འགྲུལ་ཞིང་། སཱ་མར་ཡ་རུ་ཨ་ཤེ་རཱ་ནི་ད་དུང་བསླངས་ཡོད་པ་རེད།"]},{"type":"verse","number":7,"content":["ཡང་ཨ་རམ་གྱི་རྒྱལ་པོས་དེ་རྣམས་མེད་པར་བཟོས་ཏེ་གཡུལ་ཁའི་རྡུལ་ལྟར་བརྫིས་པའི་རྐྱེན་གྱིས། དམག་སྡེ་ལས་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ལ་སྐྱ་དམག་ལྔ་བཅུ་དང་། ཤིང་རྟ་བཅུ་དང་། རྐང་དམག་སྟོང་ཕྲག་བཅུ་མ་གཏོགས་ལུས་སུ་མ་བཅུག་གོ །"]},{"type":"verse","number":8,"content":["ཡེ་ཧོ་ཨ་ཧཱ་ཟིའི་དོན་གཞན་རྣམས་དང་ཁོས་ཅི་དང་ཅི་བྱས་པ་ཐམས་ཅད། ཁོའི་དཔའ་བོའི་མཛད་རྗེས་བཅས་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":9,"content":["ཡེ་ཧོ་ཨ་ཧཱ་ཟི་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་གཟིམས་ནས་སཱ་མར་ཡ་རུ་དུར་ལ་སྦས་པ་དང་། ཁོའི་སྲས་ཡེ་ཧོ་ཨ་སི་ནི་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི།"]},{"type":"verse","number":10,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་སོ་བདུན་པར། ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡི་སྲས་ཡེ་ཧོ་ཨ་སི་བྱ་བ་སཱ་མར་ཡ་རུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་བྱས་ཏེ། ལོ་བཅུ་དྲུག་གི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":11,"content":["ཁོས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་པ་དང་། ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་གྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པ་རྣམས་ལས་ཕྱིར་མ་བཟློགས་པར། ཁོ་སྡིག་པ་དེའི་ནང་དུ་འགྲུལ་ཏོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཡོ་ཨ་སི་ཡི་དོན་གཞན་རྣམས་དང་ཁོས་ཅི་དང་ཅི་བྱས་པ་ཐམས་ཅད། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་དང་དམག་འཁྲུག་བརྒྱབ་པའི་དཔའ་བོའི་མཛད་རྗེས་བཅས་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":13,"content":["ཡེ་ཧོ་ཨ་སི་རང་གི་མེས་པོའི་ཁྲོད་དུ་གཟིམས་པ་དང་། ཡེ་རོབ་ཨམ་ནི་ཁོའི་རྒྱལ་ཁྲིར་བཀོད་ཅིང་། ཡེ་ཧོ་ཨ་སི་ནི་སཱ་མར་ཡ་རུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ཁྲོད་དུ་དུར་ལ་སྦས་སོ། །"]},{"type":"heading","content":["ཨེ་ལི་ཤཱ་སྐུ་གཤེགས་པ།"]},{"type":"verse","number":14,"content":["དེའི་དུས་སུ་ཨེ་ལི་ཤཱ་ལ་ཁོང་འཆི་བར་འཇུག་པའི་སྙུང་གཞི་བྱུང་བས། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི་ཁོང་གི་དྲུང་དུ་མར་འོངས་ནས་ཁོང་གི་ཞལ་ངོར་བཤུམས་ཤིང་། ངའི་ཡབ་ལགས། ངའི་ཡབ་ལགས། ཡེས་ར་ཨེལ་གྱི་དམག་འཐབ་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":15,"content":["ཨེ་ལི་ཤཱས་དེ་ལ། མདའ་གཞུ་ཁྱེར་ཤོག་ཅེས་བསྒོས་ཤིང་། ཁོས་མདའ་གཞུ་ལག་ཏུ་བླངས་པ་དང་།"]},{"type":"verse","number":16,"content":["ཁོང་གིས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། ཁྱོད་ཀྱི་ལག་པས་གཞུ་སྐྱིལ་ཞིག་ཅེས་པ་ན་། རྒྱལ་པོས་གཞུ་བསྐྱིལ་བ་དང་ཨེ་ལི་ཤཱས་རང་གི་ལག་པ་ཡང་རྒྱལ་པོའི་ལག་པའི་སྟེང་བཞག་སྟེ།"]},{"type":"verse","number":17,"content":["ཤར་ཕྱོགས་ཀྱི་དཀར་ཁུང་ཕྱེས་ཤིག་གསུངས་པ་དང་ཁོས་དེ་ཕྱེས་པ་ན། ཨེ་ལི་ཤཱས་མདའ་ཕོངས་ཤིག་ཅེས་བསྒོས་པ་དང་ཁོས་མདའ་འཕངས། དེར་ཨེ་ལི་ཤཱ་ཡིས། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་རྒྱལ་ཁའི་མདའ་མོ་ཡིན་ཏེ། ཨ་རམ་པ་ལས་རྒྱལ་བའི་མདའ་མོ་ཡིན་པས་ན། ཨ་རམ་པ་ཚར་མ་བཅད་བར་དུ། ཁྱེད་ཀྱིས་ཨ་ཕེག་ཏུ་དེ་རྣམས་གསོད་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཁོང་གིས། མདའ་ཁྱེར་ཤོག་གསུངས་ནས་ཁོས་མདའ་རྣམས་ཁྱེར་ཡོང་ཞིང་། ཁོང་གིས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། མདའ་ཡིས་ས་ལ་རྒྱོབས་ཤིག་བསྒོས་པར། ཁོས་ས་ལ་ཐེངས་གསུམ་བརྒྱབ་ནས་ཡར་ལངས་པ་དང་།"]},{"type":"verse","number":19,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་ཁྲོས་ནས་ཁོ་ལ། ཁྱོད་ཀྱིས་ཐེངས་ལྔ་ནས་དྲུག་ལ་བརྒྱབ་ན། ཨ་རམ་པ་རྣམས་ཕམ་པར་བརྒྱབ་ནས་རྩ་མེད་གཏོང་ཐུབ་མོད། འོན་ཀྱང་ད་ནི་ཁྱོད་རང་ཨ་རམ་པ་ལས་ཐེངས་གསུམ་མ་གཏོགས་རྒྱལ་བར་མི་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཨེ་ལི་ཤཱ་སྐུ་གཤེགས་པ་དང་དུར་དུ་བཅུག་གོ །མོ་ཨབ་པའི་ཤོག་ཁག་ལོ་རེའི་དཔྱིད་ཀ་ཡུལ་དེར་བཙན་རྒོལ་བྱེད་དུ་འོངས་པ་དང་།"]},{"type":"verse","number":21,"content":["མི་འགའ་ཡིས་གཤིན་པོ་དུར་དུ་སྦས་པའི་དུས་སུ། ལྟོས་དང་། ཇག་དཔུང་ཞིག་མཐོང་བས། བེམ་པོ་དེ་ཨེ་ལི་ཤཱའི་དུར་སར་གཡུགས་པ་དང་། བེམ་པོ་དེ་ཨེ་ལི་ཤཱའི་གདུང་རུས་ལ་ཐུག་པ་ན། དེ་ནི་གསོན་པོར་གྱུར་ཏེ་ཡར་ལངས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ཡང་ཨ་རམ་པའི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་གྱིས་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡིས་རྒྱལ་སྲིད་སྐྱོང་བའི་སྐུ་ཚེ་ཧྲིལ་པོར་ཡེས་ར་ཨེལ་ལ་མནར་གཅོད་བྱས་མོད།"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལ་ཐུགས་རྗེ་གནང་ཞིང་སྙིང་རྗེ་དགོངས་པ་དང་། གཟིགས་སྐྱོང་མཛད་པ་སྟེ། ཁོང་གིས་ཨབ་ར་ཧམ་དང་ཨི་སཱག ཡ་ཀོབ་བཅས་ལ་ཞལ་ཆད་གནང་ཡོད་པས། དེ་རྣམས་མེད་པར་མཛད་པ་དང་ཁོང་ཉིད་ཀྱི་ཞལ་དྲུང་ནས་འདོར་བར་ད་ལྟའི་བར་དུ་ཐུགས་མ་དགྱེས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་ཚེ་ལས་འདས་པ་དང་། ཁོའི་སྲས་པེན་ཧ་དཱད་ཀྱིས་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":25,"content":["དེར་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡི་སྲས་ཡེ་ཧོ་ཨ་སི་ཡིས། ཧ་ཟཱ་ཨེལ་གྱི་བུ་པེན་ཧ་དཱད་ཀྱི་ལག་ནས་ཁོའི་ཡབ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ལ་དམག་འཁྲུག་བརྒྱབ་སྟེ་ཕྲོགས་པའི་གྲོང་ཁྱེར་རྣམས་ཕྱིར་བླངས། ཡེ་ཧོ་ཨ་སི་ཡིས་པེན་ཧ་དཱད་ལན་གསུམ་དུ་ཕམ་པར་བརྒྱབ་ནས་ཡེས་ར་ཨེལ་གྱི་གྲོང་ཁྱེར་རྣམས་ཕྱིར་བླངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}