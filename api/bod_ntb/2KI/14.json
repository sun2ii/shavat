{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":14,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡི་སྲས་ཡེ་ཧོ་ཨ་སི་ཡི་སྲིད་ལོ་གཉིས་པར། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡི་སྲས་ཨ་མཱ་ཙི་ཡས་རྒྱལ་སྲིད་བཟུང་།"]},{"type":"verse","number":2,"content":["ཁོས་རྒྱལ་སྲིད་འཛིན་དུས་ལོ་ཉེར་ལྔ་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་ཉེར་དགུའི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ཁོང་གི་ཡུམ་གྱི་མིང་ལ་ཡེ་ཧོ་ཨད་དིན་ཞེས་ཟེར། མོ་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་སྤྱད་པ་དང་། རང་གི་མེས་པོ་དཱ་བིད་ལྟར་དུ་མ་བྱས་ཀྱང་སྒོ་ཀུན་ནས་རང་གི་ཡབ་ཡོ་ཨ་སི་ཡིས་བསྒྲུབས་པ་ལྟར་བྱས་མོད།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་མཐོ་གླིང་རྣམས་མེད་པར་མ་བཟོས་པར། མི་རྣམས་ཀྱིས་སྔར་བཞིན་མཐོ་གླིང་རྣམས་སུ་མཆོད་པ་ཕུལ་ནས་བསང་བཏང་བ་ཡིན།"]},{"type":"verse","number":5,"content":["དེ་ཡང་ཁོའི་ཕྱག་ཏུ་རྒྱལ་སྲིད་བརྟན་པོར་ཆགས་མ་ཐག་ཏུ། ཁོའི་ཡབ་རྒྱལ་པོར་སྣུན་མཁན་གྱི་འཁོར་གཡོག་རྣམས་བསད་པ་དང་།"]},{"type":"verse","number":6,"content":["མོ་ཤེའི་བཀའ་ཁྲིམས་ཀྱི་མདོ་ཡི་ནང་དུ་བཀོད་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ནི་འདི་ལྟ་སྟེ། བུ་རྣམས་ཀྱི་རྐྱེན་གྱིས་ཕ་དང་། ཕ་ཡི་རྐྱེན་གྱིས་བུ་རྣམས་གསོད་པར་མི་བྱ་བར། མི་རེ་རེ་རང་རང་གི་སྡིག་པའི་ཕྱིར་དུ་གསོད་པར་རིགས་སོ་ཞེས་གདམས་པ་བཞིན་དུ་ཁོས་མི་གསོད་མཁན་དག་གི་བུ་རྣམས་མ་བསད་དོ། །"]},{"type":"verse","number":7,"content":["ཁོས་ཚྭའི་ལུང་པ་རུ་ཨེ་དོམ་པ་སྟོང་ཕྲག་བཅུ་བསད་ནས་སེ་ལཱ་དམག་འཁྲུག་གིས་བླངས་པ་དང་། དེ་ཡི་མིང་ལ་ཡོག་ཐི་ཨེལ་ཞེས་བཏགས་ནས་དེ་རིང་གི་བར་དུ་ལུས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་ཨ་མཱ་ཙི་ཡ་ཡིས་ཡེ་ཧུའི་ཚ་བོའམ། ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡི་སྲས་ཡེ་ཧོ་ཨ་སི་བྱ་བ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་དྲུང་དུ་བང་ཆེན་མངགས་ནས་དེ་ལ། ཤོག་དང་། ངེད་གཉིས་གཡུལ་སར་འཕྲད་པར་བྱ་ཞེས་སྦྲན་པ་དང་།"]},{"type":"verse","number":9,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི་ཡིས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་ལ་འཕྲིན་ལན་སྤྲིངས་ཏེ་ན་རེ། ལེ་པཱ་ནོན་གྱི་ཚེར་སྡོང་གིས་ལེ་པཱ་ནོན་གྱི་ཐང་ཤིང་ལ། ཁྱོད་ཀྱི་བུ་མོ་དེ་ངའི་བུ་ལ་མནའ་མར་ཐོངས་ཤིག་ཅེས་འཕྲིན་བསྐུར་ཞིང་། ཕྱིས་སུ་ལེ་པཱ་ནོན་དུ་ཡོད་པའི་རི་དྭགས་ཤིག་ཚེར་སྡོང་གི་སྟེང་དུ་འགྲུལ་ནས་དེ་རྐང་པས་བརྫིས་སོ། །"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་ཨེ་དོམ་པ་འཇོམས་པས་ཁྱོད་ཀྱི་སེམས་སུ་ཁེངས་དྲེགས་སྐྱེས་པ་བདེན། རང་བསྟོད་བྱོས་ལ་རང་ཁྱིམ་དུ་བདེ་བར་སྡོད་ཅིག ཅིའི་ཕྱིར་ཆག་སྒོ་བསླངས་ནས་རང་ཉིད་རྩ་མེད་གཏོང་ཞིང་། ཡ་ཧུ་དཱ་ཡང་ཁྱོད་དང་ལྷན་ཅིག་རྩ་མེད་གཏོང་ངམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་ཨ་མཱ་ཙི་ཡས་དེ་ལ་མ་མཉན་པས། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི་ཡར་འོངས་པ་དང་། ཡ་ཧུ་དཱར་གཏོགས་པའི་པེད་ཤེ་མེ་སི་བྱ་བའི་ཡུལ་དུ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་དང་ཕྲད།"]},{"type":"verse","number":12,"content":["ཡ་ཧུ་དཱ་ནི་ཡེས་ར་ཨེལ་གྱིས་ཕམ་པར་བརྒྱབ་པས་ཕྱིར་རང་རང་གི་གུར་དུ་བྲོས་སོ། །"]},{"type":"verse","number":13,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི་ཡིས་ཨ་ཧ་ཟི་ཡཱའི་ཚ་བོའམ། ཡོ་ཨ་སི་ཡི་སྲས་ཏེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་བྱ་བ་པེད་ཤེ་མེ་སི་རུ་འཛིན་བཟུང་བྱས་པ་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་ནས་ཨེ་ཕཱར་ཡིམ་གྱི་རྒྱ་སྒོ་ནས་གྲུ་གའི་རྒྱ་སྒོའི་བར་དུ། རིང་ཚད་ལ་ཁྲུ་བཞི་བརྒྱ་ཡོད་པའི་ཡེ་རུ་སཱ་ལེམ་གྱི་ལྕགས་རི་དེ་བཤིགས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་། རྒྱལ་པོའི་གཏེར་མཛོད་ཀྱི་ནང་དུ་རྙེད་པའི་གསེར་དངུལ་ཐམས་ཅད་དང་། ཡོ་བྱད་ཡོད་དོ་ཅོག་ཁྱེར་ཞིང་། མི་གཏའ་མར་ཁྲིད་ནས་སཱ་མར་ཡ་རུ་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":15,"content":["ཡེ་ཧོ་ཨ་སི་ཡིས་དོན་གཞན་ཅི་དང་ཅི་བྱས་པ་དང་། དེའི་དཔའ་བོའི་མཛད་རྗེས་རྣམས་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་དང་ཇི་ལྟར་དམག་འཁྲུག་བརྒྱབ་པ་བཅས་ཐམས་ཅད་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":16,"content":["ཡེ་ཧོ་ཨ་སི་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་གཟིམས་པ་དང་། སཱ་མར་ཡ་རུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ཁྲོད་དུ་དུར་ལ་སྦས། ཁོའི་སྲས་ཡེ་རོབ་ཨམ་གྱིས་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་སྲིད་བཟུང་ངོ་། །"]},{"type":"verse","number":17,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཡི་སྲས་ཡེ་ཧོ་ཨ་སི་ཚེ་ལས་འདས་རྗེས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡི་སྲས་ཨ་མཱ་ཙི་ཡ་ཡང་ལོ་བཅོ་ལྔ་ལ་གསོན་པ་རེད།"]},{"type":"verse","number":18,"content":["ཨ་མཱ་ཙི་ཡ་ཡི་དོན་གཞན་རྣམས་ནི། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":19,"content":["མི་རྣམས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཁོ་ལ་ངོ་ལོག་བྱས་པས། ཁོ་ནི་ལཱ་ཀི་སི་རུ་བྲོས་ཤིང་། དེ་དག་གིས་ཁོའི་རྗེས་སུ་ལཱ་ཀི་སི་རུ་མི་མངགས་ནས་ཁོ་དེར་བསད་པ་དང་།"]},{"type":"verse","number":20,"content":["ཁོའི་བེམ་པོ་རྟའི་རྒྱབ་ཏུ་བཀལ་ནས་ཁྱེར་འོངས་ཏེ། ཡེ་རུ་སཱ་ལེམ་གྱི་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་དུ་ཁོའི་ཕ་མེས་རྣམས་ཀྱི་ཁྲོད་དུ་དུར་ལ་སྦས།"]},{"type":"verse","number":21,"content":["དེ་ནས་ཡ་ཧུ་དཱའི་འབངས་ཡོངས་ཀྱིས་ལོ་བཅུ་དྲུག་ལོན་པའི་ཨ་ཟར་ཡཱ་བྱ་བ་དེ་ཁྲིད་ནས་ཁོའི་ཡབ་ཨ་མཱ་ཙི་ཡ་ཡི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་བསྐོས།"]},{"type":"verse","number":22,"content":["ཁོས་ཨེ་ལད་བྱ་བའི་གྲོང་ཁྱེར་བཙུགས་པ་དང་། རྒྱལ་པོ་ཨ་མཱ་ཙི་ཡ་རང་གི་ཕ་མེས་རྣམས་ཀྱི་ཁྲོད་དུ་གཟིམས་རྗེས་སུ། གྲོང་ཁྱེར་དེ་ཡ་ཧུ་དཱ་ལ་ཕྱིར་བསྐོར་ཏོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་རོབ་ཨམ་གཉིས་པ།"]},{"type":"verse","number":23,"content":["དེ་ཡང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཨ་སི་ཡི་སྲས་ཨ་མཱ་ཙི་ཡས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་བཅོ་ལྔ་པར། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་སི་ཡི་སྲས་ཡེ་རོབ་ཨམ་གྱིས་སཱ་མར་ཡ་རུ་རྒྱལ་སྲིད་བཟུང་ཞིང་ལོ་ཞེ་གཅིག་གི་རིང་དུ་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":24,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཅིང་། ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པ་ཐམས་ཅད་ལས་མ་བྲལ་ཏོ། །"]},{"type":"verse","number":25,"content":["ཁོས་ལེ་པོ་ཧ་མཱད་ནས་བཟུང་སྟེ། ཨ་ར་པཱ་ཞེས་པའི་རྒྱ་མཚོའི་བར་དུ་ཡེས་ར་ཨེལ་ཡུལ་གྱི་ས་མཚམས་རྣམས་ཕྱིར་བླངས། དེ་ནི་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཞབས་ཕྱི་སྟེ་གཱད་ཧེ་ཕེར་གྱི་ཨ་མི་ཐཱ་ཨི་ཡི་བུ་ལུང་སྟོན་པ་ཡོ་ནཱའི་ངག་ནས་གསུངས་པ་བཞིན་ནོ། །"]},{"type":"verse","number":26,"content":["དེ་ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་སྡུག་བསྔལ་ཆེན་པོ་གཟིགས་པ་དང་། དེ་རྣམས་ཀྱི་ཁྲོད་ནས་བཀག་བསྐྱིལ་ཐེབས་པ་དང་རང་དབང་ཅན་ཐམས་ཅད་མེད་པར་གྱུར་ཅིང་། ཡེས་ར་ཨེལ་ལ་རོགས་བྱེད་མཁན་གཅིག་ཀྱང་མ་བྱུང་ངོ་། །"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་གནམ་འོག་ནས་ཡེས་ར་ཨེལ་གྱི་མིང་རྟགས་མེད་པར་བྱེད་པའི་ཐུགས་ཐག་མ་བཅད་པས། ཁོང་གིས་དེ་རྣམས་ཡེ་ཧོ་ཨ་སི་ཡི་སྲས་ཡེ་རོབ་ཨམ་གྱི་ལག་བརྒྱུད་ནས་ཐར་བར་མཛད་དོ། །"]},{"type":"verse","number":28,"content":["ཡེ་རོབ་ཨམ་གྱི་དོན་གཞན་རྣམས་དང་ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་དང་། ཇི་ལྟར་འཐབ་འཁྲུག་བརྒྱབ་པའི་དཔའ་བོའི་མཛད་རྗེས་དང་། དཱ་མེ་སེག་དང་སྔར་ཡ་ཧུ་དཱར་གཏོགས་པའི་ཧ་མཱད་གཉིས་ཡེས་ར་ཨེལ་གྱི་དོན་དུ་ཕྱིར་བླངས་པ་བཅས་ནི། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":29,"content":["ཡེ་རོབ་ཨམ་རང་གི་ཕ་མེས་ཏེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ཁྲོད་དུ་གཟིམས་པར་གྱུར། ཡང་ཁོའི་སྲས་ཟཱ་ཀར་ཡ་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/13.json","previousChapterAudioLinks":{},"numberOfVerses":29}