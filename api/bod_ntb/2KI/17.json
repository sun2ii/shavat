{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":17,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཧོ་ཤེ་ཨ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟཱ་ཡིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་བཅུ་གཉིས་པར། ཨེ་ལཱ་ཡི་སྲས་ཧོ་ཤེ་ཨ་བྱ་བ་དེས་སཱ་མར་ཡ་རུ་ལོ་དགུའི་རིང་དུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":2,"content":["ཁོས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཀྱང་། ཁོའི་སྔོན་དུ་བྱུང་བའི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ལྟར་མ་བྱས་སོ། །"]},{"type":"verse","number":3,"content":["ཨ་སུར་གྱི་རྒྱལ་པོ་ཤལ་མན་ཨེ་སེར་ནི་ཁོ་ལ་རྒོལ་དུ་ཡར་འོངས་པ་དང་། ཧོ་ཤེ་ཨ་ནི་དེའི་མངའ་འོག་ཏུ་གྱུར་ནས་ཁོ་ལ་དཔྱ་ཁྲལ་བཅལ་ཏོ། །"]},{"type":"verse","number":4,"content":["ཕྱིས་སུ་ཨ་སུར་གྱི་རྒྱལ་པོས་ཧོ་ཤེ་ཨ་ཡི་གཡོ་ཐབས་རྙེད། ཅིའི་ཕྱིར་ཞེ་ན། དེས་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་སོ་ཞེས་པར་བང་ཆེན་མངགས་ཏེ། ཨ་སུར་གྱི་རྒྱལ་པོར་ལོ་རེ་བཞིན་དུ་དཔྱ་ཁྲལ་མ་ཕུལ་བས་ཨ་སུར་གྱི་རྒྱལ་པོས་ཁོ་བཟུང་ནས་བཙོན་དུ་བཅུག་གོ །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་བཟུང་བ།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཨ་སུར་གྱི་རྒྱལ་པོ་ཡར་འོངས་ཏེ་ཡུལ་ཁམས་ཐམས་ཅད་ལ་བཙན་འཛུལ་བྱས་པ་དང་། ཡར་སཱ་མར་ཡ་རུ་སོང་ནས་ལོ་གསུམ་གྱི་རིང་ལ་ཡུལ་དེ་དམག་གིས་བསྐོར་ཏོ། །"]},{"type":"verse","number":6,"content":["ཧོ་ཤེ་ཨ་ཡིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་དགུ་པར། ཨ་སུར་གྱི་རྒྱལ་པོས་སཱ་མར་ཡ་བླངས་ཤིང་ཡེས་ར་ཨེལ་པ་རྣམས་ཨ་སུར་ཡུལ་དུ་བཙན་ཁྲིད་བྱས་ཏེ། ཧ་ལཱ་དང་གོ་ཟན་ཡུལ་གྱི་ཆུ་བོ་ཧ་བོར་དང་། མཱ་ཏི་པ་རྣམས་ཀྱི་གྲོང་ཁྱེར་རྣམས་སུ་སྡོད་དུ་བཅུག་གོ །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་པས་སྐུ་འདྲར་མཆོད་པས་ཡུལ་ནས་ཕུད་པ།"]},{"type":"verse","number":7,"content":["དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཨེ་ཅིབ་ཀྱི་ཡུལ་དང་། ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་ལག་འོག་ནས་ཐར་དུ་བཅུག་པའི་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱས་ཏེ། ལྷ་གཞན་རྣམས་ལ་ཞེད་པར་གྱུར་པས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་ནས་མཐར་བསྐྲད་པའི་མི་རྣམས་ཀྱི་གོམས་སྲོལ་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལུགས་སྲོལ་བཞིན་དུ་འགྲུལ་པ་རེད།"]},{"type":"verse","number":9,"content":["དེ་ལྟར་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཀྱིས་གསང་བའི་ངང་ནས་ཁོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མི་འོས་པའི་ལས་བྱས་ཏེ། བྱ་རའི་ལྕོག་མཁར་ནས་གྲོང་ཁྱེར་བརྟན་པོའི་བར་དུ་རང་གི་ཕྱིར་ཁོ་ཚོའི་གྲོང་རྡལ་ཐམས་ཅད་དུ་མཐོ་གླིང་བརྩིགས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཡང་རི་མཐོན་པོ་རྣམས་ཀྱི་རྩེ་མོ་དང་། ལྗོན་ཤིང་སྔོན་པོ་ཀུན་གྱི་འོག་ཏུ་ལྷ་རྟེན་དང་ཨ་ཤེ་རཱ་བཙུགས་སོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ཀྱི་མདུན་ནས་མཐར་བསྐྲད་པའི་མི་རྣམས་ཀྱི་ལུགས་སྲོལ་ལྟར། དེ་རྣམས་ཀྱིས་ཀྱང་མཐོ་གླིང་ཐམས་ཅད་ཀྱི་སྟེང་དུ་བསང་བཏང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས་པའི་དོན་ངན་པ་བྱས་སོ། །"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་དེ་དག་ལ་ཁྱོད་ཅག་གིས་དེ་འདྲ་མ་བྱེད་ཅིག་ཅེས་གསུངས་ཀྱང་། དེ་དག་གིས་སྐུ་འདྲ་བསྟེན་ཅིང་དེར་ཞབས་ཏོག་བསྒྲུབས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ལུང་སྟོན་པ་དང་མངོན་ཤེས་པ་ཐམས་ཅད་བརྒྱུད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་ཉེན་བརྡ་བཏང་ཞིང་འདི་སྐད་དུ། ཁྱོད་ཅག་གི་ལམ་ངན་པ་རྣམས་སྤོངས་ཤིག ངས་ཁྱོད་རྣམས་ཀྱི་མེས་པོ་ལ་གནང་བའི་བཀའ་རྒྱ་དང་བཀའ་ཁྲིམས་དང་། བདག་གི་སྒྲིག་ཁྲིམས་ཐམས་ཅད་བཞིན་དུ། རང་གི་ཞབས་ཕྱི་ལུང་སྟོན་པ་རྣམས་བརྒྱུད་ནས་ཁྱོད་ཅག་ལ་བསྒྲགས་པའི་དོན་རྣམས་བསྲུང་བར་བྱོས་ཤིག་ཅེས་གསུངས་མོད།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཁོ་ཚོས་མ་མཉན་པར། ཁོ་ཚོའི་ཕ་མེས་དང་འདྲ་བར་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཡིད་མ་མོས་པར་གཉའ་རེངས་བྱས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་ཁོང་གིས་དེ་དག་གི་མེས་པོ་རྣམས་ལ་མཛད་པའི་ཞལ་ཆད་དང་བཀའ་ཁྲིམས། དེ་དག་ལ་མཛད་པའི་ཉེན་བརྡ་བཅས་སྤངས་ནས། དོན་མེད་ཀྱི་སྐུ་འདྲའི་རྗེས་སུ་འབྲངས་པས་སྙིང་པོ་མེད་པར་གྱུར། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལ། ཕྱི་རོལ་པ་རྣམས་ཀྱི་རྗེས་སུ་མི་འབྲང་བར་གྱིས་ཞེས་བསྒོས་ཀྱང་། དེ་དག་ནི་རང་གི་མཐའ་འཁོར་དུ་ཡོད་པའི་ཕྱི་རོལ་པ་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས།"]},{"type":"verse","number":16,"content":["ཁོ་ཚོས་དེ་ལྟར་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་ཐམས་ཅད་སྤངས་ཏེ། རང་གི་ཕྱིར་དུ་ཟངས་ཀྱི་བླུགས་སྐུ་བ་ཕྲུག་གཉིས་བཟོས་པ་དང་། ཨ་ཤེ་རཱ་ཡང་བརྩིགས་ནས་ནམ་མཁའི་སྐར་ཚོགས་ཐམས་ཅད་ལ་ཕྱག་བཙལ་ཞིང་པཱ་ཨལ་བསྟེན་ཏོ། །"]},{"type":"verse","number":17,"content":["ཡང་དེ་དག་གིས་རང་གི་བུ་དང་བུ་མོ་མེའི་དཀྱིལ་དུ་སྦྱིན་སྲེག་བཏང་ནས་མོ་བཏབ་སྟེ་རྫུ་འཕྲུལ་བསྟན་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་ནས་རང་ཉིད་བཙོངས་པ་དང་ཁོང་ཐུགས་ཁྲོ་བར་བྱས།"]},{"type":"verse","number":18,"content":["དེའི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་ཡེས་ར་ཨེལ་ལ་ཐུགས་རབ་ཏུ་ཁྲོས་ཏེ། དེ་དག་ཁོང་གི་སྤྱན་སྔ་ནས་ཕར་བསྐྲད་པས། ཡ་ཧུ་དཱའི་ཚོ་པ་མ་གཏོགས་གཞན་གང་ཡང་མ་ལུས་སོ། །"]},{"type":"verse","number":19,"content":["དེ་ཡང་ཡ་ཧུ་དཱ་པས་ཀྱང་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་རྣམས་མ་བསྲུངས་པར། ཡེས་ར་ཨེལ་གྱིས་བྱས་པའི་ལུགས་སྲོལ་བཞིན་དུ་འགྲུལ།"]},{"type":"verse","number":20,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཐམས་ཅད་སྤངས་ནས་མནར་གཅོད་མྱང་དུ་བཅུག་སྟེ། ཉིད་ཀྱི་སྤྱན་སྔ་ནས་མ་དོར་བར་དུ་ཇག་ཚོགས་ཀྱི་ལག་ཏུ་གཏད་དོ། །"]},{"type":"verse","number":21,"content":["དེ་ཡང་ཁོང་གིས་དཱ་བིད་ཀྱི་གདུང་རྒྱུད་ནས་ཡེས་ར་ཨེལ་ཕྲལ་བར་མཛད་པའི་རྗེས་སུ། དེ་དག་གིས་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་རྒྱལ་པོར་བསྐོས་པ་དང་། ཡེ་རོབ་ཨམ་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲང་དུ་མ་བཅུག་པར་སྡིག་པ་ཆེན་པོ་བྱེད་དུ་བཅུག"]},{"type":"verse","number":22,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ནི་ཡེ་རོབ་ཨམ་གྱིས་བྱས་པའི་སྡིག་པ་ཐམས་ཅད་ཀྱི་ལམ་དུ་འགྲུལ་ཞིང་། དེ་དག་ལས་མ་བྱོལ་བ་དང་།"]},{"type":"verse","number":23,"content":["མཇུག་མཐར་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞབས་ཕྱི་ལུང་སྟོན་པ་ཐམས་ཅད་བརྒྱུད་ནས་གསུངས་པ་བཞིན་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཉིད་ཀྱི་སྤྱན་སྔ་ནས་ཕྱི་རུ་བསྐྲད། ཡེས་ར་ཨེལ་པ་རྣམས་རང་ཡུལ་ནས་ཨ་སུར་ཡུལ་དུ་ད་ལྟའི་བར་བཙན་བྱོལ་དུ་བསྐྱལ་ཏོ། །"]},{"type":"heading","content":["སཱ་མར་ཡ་ནས་བསྐྱར་དུ་གཞིས་ཆགས་པ།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཨ་སུར་གྱི་རྒྱལ་པོས་པཱ་པེལ་ལོན་དང་། ཀུ་ཐཱ་དང་། ཨ་ཝཱ་དང་། ཧ་མཱད་དང་། སེ་ཕར་ཝ་ཨིམ་གྱི་མི་རྣམས་ཁྲིད་དེ། ཡེས་ར་ཨེལ་གྱི་མི་སྡེའི་ཚབ་ཏུ་སཱ་མར་ཡའི་གྲོང་ཁྱེར་རྣམས་སུ་བཞག་པས། དེ་དག་ལ་སཱ་མར་ཡ་བགོ་སྐལ་དུ་ཐོབ་ཅིང་དེ་གའི་གྲོང་ཁྱེར་དག་ཏུ་གཞིས་ཕབ།"]},{"type":"verse","number":25,"content":["ཁོ་ཚོ་ཐོག་མར་གནས་དེར་སྡོད་སྐབས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པ་མེད་པས། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ཀྱི་ཁྲོད་དུ་སེང་གེ་བཏང་ནས་ཁོ་ཚོ་ལས་མི་ཁ་ཤས་ཀྱི་སྲོག་བཅད་དོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ཁོ་ཚོས་ཨ་སུར་གྱི་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱིས་སཱ་མར་ཡའི་གྲོང་ཁྱེར་དུ་བཙན་ཁྲིད་བྱས་ནས་བཞག་པའི་མི་སྡེ་རྣམས་ཀྱིས་ཡུལ་དེའི་དཀོན་མཆོག་གི་ཁྲིམས་སྲོལ་མ་ཤེས་སྟབས། ཁོང་གིས་དེ་དག་གི་ཁྲོད་དུ་སེང་གེ་བཏང་། ལྟོས་དང་། མི་དེ་ཚོས་དཀོན་མཆོག་གི་ཁྲིམས་སྲོལ་མ་ཤེས་པའི་རྐྱེན་གྱིས་སེང་གེས་དེ་དག་གི་སྲོག་བཅད་དོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":27,"content":["ཨ་སུར་གྱི་རྒྱལ་པོས་བཀའ་གནང་སྟེ་ན་རེ། ཁྱོད་རྣམས་ཀྱིས་ཡུལ་དེ་ནས་བཙན་ཁྲིད་བྱས་འོངས་པའི་མཆོད་དཔོན་རྣམས་ལས་གཅིག་ཕྱིར་ཁྲིད་ཅིག ཁོང་གནས་དེར་བསྡད་ནས་དེ་རྣམས་ལ་ཡུལ་དེའི་དཀོན་མཆོག་གི་ཁྲིམས་སྲོལ་སློབ་དགོས་ཞེས་བསྒོས།"]},{"type":"verse","number":28,"content":["དེ་ནས་སཱ་མར་ཡ་ནས་བཙན་ཁྲིད་བྱས་འོངས་པའི་མཆོད་དཔོན་རྣམས་ལས་གཅིག་ཕྱིར་ལོག་ནས་པེད་ཨེལ་དུ་གཞིས་ཕབ་སྟེ། ཁོང་གིས་དེ་དག་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཅི་ལྟར་གུས་ཤིང་འཇིགས་པར་བྱེད་དགོས་ཚུལ་བསླབས་སོ། །"]},{"type":"verse","number":29,"content":["འོན་ཀྱང་རིགས་རྒྱུད་རེ་རེས་རང་ཉིད་ལ་ལྷ་སྐུ་རྣམས་བཞེངས་ཏེ་སཱ་མར་ཡ་པས་བརྩིགས་པའི་མཐོ་གླིང་གི་ལྷ་ཁང་དག་ཏུ་བཞག་ཅིང་། རིགས་རྒྱུད་རེ་རེས་རང་ཉིད་གནས་པའི་གྲོང་ཁྱེར་གྱི་ནང་དུ་དེ་ལྟར་བྱས།"]},{"type":"verse","number":30,"content":["པཱ་པེལ༌པ་རྣམས་ཀྱིས་སོའུ་ཀོད་བེ་ནོད་བྱ་བའི་སྐུ་འདྲ་དང་། ཀུད་པ་རྣམས་ཀྱིས་ནེར་གལ་བྱ་བའི་སྐུ་འདྲ་དང་། ཧ་མཱད་པ་རྣམས་ཀྱིས་ཨ་ཤི་མཱ་བྱ་བའི་སྐུ་འདྲ་དང་།"]},{"type":"verse","number":31,"content":["ཨ་ཝཱ་པ་རྣམས་ཀྱིས་ནིབ་ཧ་ཟི་དང་ཐཱར་ཐག་བྱ་བའི་སྐུ་འདྲ་བཅས་བཟོས་ཤིང་། སེ་ཕར་ཝི་པས་སེ་ཕར་ཝ་ཨིམ་གྱི་ལྷ་ཨད་རམ་མེ་ལེག་དང་ཨ་ནམ་མེ་ལེག་བྱ་བ་གཉིས་ཀྱི་ཆེད་དུ་རང་གི་བུ་རྣམས་མེའི་ནང་དུ་བསྲེགས་སོ། །"]},{"type":"verse","number":32,"content":["དེ་རྣམས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྐྲག་པས། རང་གི་ནང་ནས་མཐོ་གླིང་རྣམས་སུ་མཆོད་དཔོན་བསྐོས་པ་དང་། མཐོ་གླིང་དག་གི་ལྷ་ཁང་ནང་དུ་མི་རྣམས་ཀྱི་ཆེད་དུ་ཕྱག་ལས་གནང་།"]},{"type":"verse","number":33,"content":["ཁོ་ཚོ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྐྲག་ནའང་། དེ་དག་གིས་རང་རང་རིགས་རྒྱུད་གང་ནས་བཙན་ཁྲིད་བྱས་འོངས་པའི་ལུགས་སྲོལ་གང་དེའི་ལྷ་རྣམས་ལ་ཞབས་ཕྱི་བསྒྲུབས་པའོ། །"]},{"type":"verse","number":34,"content":["ཁོ་ཚོས་ད་ལྟའི་བར་དུ་སྔོན་གྱི་ལུགས་སྲོལ་བཞིན་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པར་ཡང་མ་བྱས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ཞེས་བཏགས་པའི་ཡ་ཀོབ་ཀྱི་བུ་རྒྱུད་རྣམས་ལ་གནང་བའི་བཀའ་ཁྲིམས་དང་། སྒྲིག་ཁྲིམས་དང་། སྲོལ་ཡིག་དང་། བཀའ་རྒྱ་རྣམས་ཀྱང་མ་བསྲུངས་སོ། །"]},{"type":"verse","number":35,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ལ་ཞལ་ཆད་མཛད་ཅིང་བཀའ་གནང་སྟེ་འདི་སྐད་དུ། ཁྱོད་ཅག་ལྷ་གཞན་རྣམས་ལ་སྐྲག་མི་དགོས། དེ་དག་ལ་ཕྱག་མ་འཚལ། ཞབས་ཕྱི་མ་བསྒྲུབ། མཆོད་པ་ཡང་འབུལ་བར་མི་བྱའོ། །"]},{"type":"verse","number":36,"content":["འོན་ཀྱང་། མཐུ་སྟོབས་ཆེན་པོའི་ཕྱག་བརྐྱངས་ཏེ་ཁྱོད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཁྲིད་མཁན་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ནི། ཁྱོད་རྣམས་གུས་ཤིང་འཇིགས་པ་དང་། ཁོང་ལ་ཕྱག་བཙལ་ནས་མཆོད་པ་འབུལ་འོས་ལ།"]},{"type":"verse","number":37,"content":["ཁོང་གིས་ཁྱོད་ཅག་གི་དོན་དུ་ཡི་གེར་བཀོད་པའི་སྒྲིག་ཁྲིམས་དང་། སྲོལ་ཡིག་དང་། བཀའ་ཁྲིམས་དང་། བཀའ་རྒྱ་དེ་རྣམས་དུས་ནམ་ཡང་སྒྲུབས་ལ་སྲུངས་ཤིག ལྷ་གཞན་ལ་མ་འཇིགས་ཤིག"]},{"type":"verse","number":38,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་མཛད་པའི་ཞལ་ཆད་དེ་བརྗེད་པར་མི་བྱའོ། །ལྷ་གཞན་རྣམས་ལའང་འཇིགས་པར་མ་བྱེད་ཅིག"]},{"type":"verse","number":39,"content":["འོན་ཀྱང་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པར་གྱིས་ཤིག ཁོང་གིས་ཁྱོད་ཅག་དགྲ་ཐམས་ཅད་ཀྱི་ལག་ནས་སྐྱོབ་པར་འགྱུར་རོ་ཞེས་གསུངས་མོད།"]},{"type":"verse","number":40,"content":["འོན་ཀྱང་དེ་དག་གིས་མ་མཉན་པར་སྔར་བཞིན་རང་རང་གི་ཐོག་མའི་ལུགས་སྲོལ་ལྟར་བྱས་པའོ། །"]},{"type":"verse","number":41,"content":["དེར་མི་རིགས་འདི་དག་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་ནའང་། ཁོ་ཚོས་རང་གི་སྐུ་འདྲ་ལའང་ཞབས་ཕྱི་བསྒྲུབས། དེ་དག་གི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ཀྱིས་ཀྱང་དེ་རིང་གི་བར་དུ་ཁོ་ཚོའི་ཕ་མེས་རྣམས་དང་མཚུངས་པར་བྱས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/16.json","previousChapterAudioLinks":{},"numberOfVerses":41}