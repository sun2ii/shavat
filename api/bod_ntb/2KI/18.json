{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":18,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨེ་ལཱའི་སྲས་ཧོ་ཤེ་ཨ་ཡིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་གསུམ་པར། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟཱ་ཡི་བུ་ཧི་ཟི་ཀི་ཡཱས་རྒྱལ་སྲིད་བཟུང་།"]},{"type":"verse","number":2,"content":["ཁོས་རྒྱལ་སྲིད་བཟུང་དུས་ཁོ་ལོ་ཉེར་ལྔ་ཡིན་པ་དང་། ལོ་ཉེར་དགུའི་རིང་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་སྲིད་བསྐྱངས། ཟཱ་ཀར་ཡའི་བུ་མོ་ཨ་བི་བྱ་བ་ནི་ཁོའི་ཡུམ་མོ། །"]},{"type":"verse","number":3,"content":["ཁོས་རང་གི་ཡབ་མེས་དཱ་བིད་ཀྱིས་གང་མཛད་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་སྤྱད་དེ།"]},{"type":"verse","number":4,"content":["མཐོ་གླིང་རྣམས་བརླགས། རྡོ་སྐུ་རྣམས་བཅག་ཅིང་ཨ་ཤེ་རཱ་རྣམས་བཅད། མོ་ཤེ་ཡིས་བཟོས་པའི་ལི་ཡི་སྦྲུལ་དེ་ཡང་དུམ་བུར་བཅག་གོ །ཅི་ལ་ཞེ་ན། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དུས་དེའི་བར་དུ་དེ་ལ་བསང་བཏང་ཞིང་། དེའི་མིང་ལ་ནེ་ཧུ་ཤཱ་ཏན་ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":5,"content":["ཁོ་ནི་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྟེན་ཞིང་། ཁོའི་སྔ་རྗེས་སུ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱི་ནང་ནས་ཁོ་ལྟ་བུ་གཅིག་ཀྱང་མ་བྱུང་ངོ་། །"]},{"type":"verse","number":6,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེ་དམ་དུ་འཆིང་བ་དང་། ཁོང་གི་ཕྱི་བཞིན་འབྲངས་པ་ལས་མ་བྱོལ་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་གནང་བའི་བཀའ་རྒྱ་ཐམས་ཅད་བསྲུངས་སོ། །"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཁོ་དང་མཉམ་དུ་བཞུགས་པས། ཁོ་ནི་གར་སོང་ཐམས་ཅད་དུ་དོན་འགྲུབ་པ་དང་། ཨ་སུར་གྱི་རྒྱལ་པོ་ལ་ངོ་ལོག་བྱས་ནས་དེའི་གཡོག་པོ་མ་བྱས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཁོས་གཱ་ཟཱ་དང་། དེའི་ས་མཚམས་དག་གི་བར་དུའམ། བྱ་རའི་ལྕོག་མཁར་ནས་གྲོང་ཁྱེར་བརྟན་པོའི་བར་དུ་ཕེ་ལེ་ཤེད་པ་རྣམས་ཕམ་པར་བརྒྱབ་བོ། །"]},{"type":"verse","number":9,"content":["དེ་ཡང་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་སྲིད་ལོ་བཞི་པའམ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨེ་ལཱ་ཡི་སྲས་ཧོ་ཤེ་ཨ་ཡིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་བདུན་པར། ཨ་སུར་གྱི་རྒྱལ་པོ་ཤལ་མན་ཨེ་སེར་ཡར་སཱ་མར་ཡ་རུ་འོངས་ནས་གྲོང་ཁྱེར་དེའི་མཐའ་བསྐོར་བ་དང་།"]},{"type":"verse","number":10,"content":["ལོ་གསུམ་གྱི་རྗེས་སུ་དེ་དག་གིས་སཱ་མར་ཡ་བླངས་པ་སྟེ། ཧི་ཟི་ཀི་ཡཱས་རྒྱལ་སྲིད་བསྐྱངས་ནས་ལོ་དྲུག་པའམ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཧོ་ཤེ་ཨ་ཡི་སྲིད་ལོ་དགུ་པར་སཱ་མར་ཡ་བླངས།"]},{"type":"verse","number":11,"content":["ཨ་སུར་གྱི་རྒྱལ་པོས་ཡེས་ར་ཨེལ་པ་རྣམས་ཨ་སུར་ཡུལ་དུ་བཙན་ཁྲིད་བྱས་པ་དང་། དེ་རྣམས་ཧ་ལཱ་དང་། གོ་ཟན་ཡུལ་གྱི་ཧ་བོར་གཙང་པོ་དང་། མཱ་ཏི་པའི་གྲོང་ཁྱེར་སོ་སོར་བཞག་གོ །"]},{"type":"verse","number":12,"content":["དེའི་རྒྱུ་རྐྱེན་ནི། དེ་ཚོས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་མ་མཉན་པར་ཁོང་གི་ཞལ་ཆད་དང་འགལ་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་མོ་ཤེ་ཡིས་བསྒོས་པ་ཐམས་ཅད་ལ་མ་མཉན་པ་དང་དེ་བཞིན་མ་བསྒྲུབས་པས་ཡིན་ནོ། །"]},{"type":"heading","content":["སེན་ན་ཧེ་རིབ་ཀྱིས་ཡ་ཧུ་དཱ་ལ་འཇིགས་སྐུལ་བ།"]},{"type":"verse","number":13,"content":["ཡང་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་རྒྱལ་སྲིད་བཟུང་ནས་ལོ་བཅུ་བཞི་པར། ཨ་སུར་གྱི་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱིས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ལྕགས་རིས་བསྐོར་ཡོད་པ་ཐམས་ཅད་ལ་དཔུང་འཇུག་བྱས་ནས་བླངས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་ལཱ་ཀི་སི་བྱ་བར་ཨ་སུར་གྱི་རྒྱལ་པོར་བང་ཆེན་མངགས་ཏེ་ཁོ་ལ། བདག་གིས་སྡིག་པ་བྱས་ཡོད། བདག་དང་འབྲལ་བར་མཛོད། དེ་ལྟར་བྱས་ན་ཁྱེད་ཀྱིས་བདག་ལ་ཅི་དང་ཅི་བཀལ་ཡང་འཁུར་ངེས་ཡིན་ཞེས་ཞུས་པས། ཨ་སུར་གྱི་རྒྱལ་པོས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་ལ་དངུལ་རྡོ་ཚད་སུམ་བརྒྱ་དང་གསེར་རྡོ་ཚད་སུམ་ཅུ་བཀལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་། རྒྱལ་པོའི་ནོར་མཛོད་རྣམས་ལས་རྙེད་པའི་དངུལ་ཐམས་ཅད་ཁོ་ལ་སྤྲད།"]},{"type":"verse","number":16,"content":["དེའི་དུས་སུ་ཧི་ཟི་ཀི་ཡཱས་ནི། སྔར་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་སྒོ་དང་སྒོ་ཆེན་རྣམས་བཏུམས་ཡོད་པའི་གསེར་རྣམས་བཀོག་ནས་ཨ་སུར་གྱི་རྒྱལ་པོར་ཕུལ་ཏོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་ཨ་སུར་གྱི་རྒྱལ་པོས་ལཱ་ཀི་སི་ནས་ཏར་ཏན་དང་། རབ་སཱ་རེ་ཟི་དང་། རབ་ཤཱ་ཀེ་གསུམ་ནི་དམག་དཔུང་འབོར་ཆེན་དང་བཅས་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་བརྫངས་ཏེ། དེ་དག་ཡར་ཕྱིན་ཅིང་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་པའི་ཚེ། གོས་འཁྲུད་མཁན་གྱི་ཞིང་ཁའི་ལམ་དུ་ཡོད་པའི་རྫིང་བུ་གོང་མའི་ཆུ་ཡུར་འགྲམ་དུ་ལངས་ནས་བསྡད།"]},{"type":"verse","number":18,"content":["རྒྱལ་པོ་བོས་པ་ན། ཧིལ་ཀི་ཡཱའི་བུ་སྟེ་རྒྱལ་པོའི་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་། དྲུང་ཡིག་ཤེབ་ནཱ་དང་། ཨ་སབ་ཀྱི་བུ་སྟེ་ལོ་རྒྱུས་འགོད་མཁན་ཡོ་ཨག་བཅས་དེ་དག་གི་མདུན་དུ་འོངས་སོ། །"]},{"type":"verse","number":19,"content":["དེར་རབ་ཤཱ་ཀེས་དེ་དག་ལ། ཁྱོད་ཅག་གིས་ཧི་ཟི་ཀི་ཡཱ་ལ་སྦྲོན་ཅིག རྒྱལ་པོ་ཆེན་པོ་ཨ་སུར་གྱི་རྒྱལ་པོས་འདི་སྐད་གསུངས། ཁྱོད་ཀྱིས་བློ་བཅོལ་བའི་འགོག་སྲུང་དེ་ཅི་ཡིན།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་གཡུལ་འགྱེད་པའི་བློ་བཀོད་དང་སྟོབས་ཤུགས་ཡོད་ཅེས་པ་ནི་སྟོང་བཤད་ཙམ་ཡིན་ལ། ད་ལྟ་ཁྱོད་ཀྱིས་སུ་ལ་བརྟེན་ནས་བདག་ལ་ངོ་ལོག་བྱེད་དམ།"]},{"type":"verse","number":21,"content":["ལྟོས་དང་། ཁྱོད་ཀྱིས་འདམ་རྩྭའི་དབྱུག་པ་ཆག་པོ་སྟེ་ཨེ་ཅིབ་ལ་བློ་བཅོལ་བ་རེད། སུ་ཞིག་དེ་ལ་བརྟེན་ན་དེ་ནི་ཁོའི་ལག་པར་ཟུག་ནས་འབུག་པར་བྱེད། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱིས་རང་ལ་བློ་གཏད་བཅོལ་མཁན་ཐམས་ཅད་ལ་དེ་བཞིན་བྱེད་དོ། །"]},{"type":"verse","number":22,"content":["ཡང་གལ་ཏེ་ཁྱོད་ཀྱིས་ང་ལ། ངེད་ཅག་ནི་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྟེན་པ་ཡིན་ཟེར་ན། ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཐོ་གླིང་དང་མཆོད་ཁྲི་རྣམས་བཤིགས་ནས། ཡ་ཧུ་དཱ་པ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་ལ། ཁྱོད་ཅག་གིས་ཡེ་རུ་སཱ་ལེམ་གྱི་མཆོད་ཁྲི་འདིའི་མདུན་དུ་བསྙེན་བཀུར་ཞུ་དགོས་ཞེས་བསྒོས་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":23,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་ངའི་བདག་པོ་ཨ་སུར་གྱི་རྒྱལ་པོ་དང་གྲོས་མཐུན་འཇོག་པར་ཞུ། གལ་ཏེ་ཁྱོད་ཀྱིས་ཞོན་པ་ཉིས་སྟོང་མངག་ནུས་ན། ངས་ཁྱོད་ལ་དམག་རྟ་སྟོང་ཕྲག་གཉིས་སྟེར་བར་བྱའོ། །"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་ཀྱི་ཕྱིར་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོར་བློ་བཅོལ་ཡང་། ངའི་བདག་པོའི་འཁོར་འབངས་ཆུང་ཤོས་གཅིག་གི་ངོ་གདོང་དེ་ཡང་ཇི་ལྟར་བཟློག་ནུས་སམ།"]},{"type":"verse","number":25,"content":["ད་ལྟ་ང་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་འཁྲོལ་མེད་པར་ས་ཆ་འདི་འཇིག་པར་བྱེད་དུ་ཡར་འོངས་པ་ཡིན་ནམ། དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ལ་ཡུལ་དེར་ཡར་སོང་ལ་དེ་མེད་པར་བྱོས་ཤིག་གསུངས་ཞེས་པའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ཧིལ་ཀི་ཡཱ་ཡི་བུ་ཨེལ་ཡ་ཀིམ་དང་། ཤེབ་ནཱ་དང་། ཡོ་ཨག་བཅས་ཀྱིས་རབ་ཤཱ་ཀེ་ལ་ན་རེ། ང་ཚོས་ཨ་རམ་པའི་སྐད་ཤེས་པས་ཁྱོད་ཀྱི་ཞབས་ཕྱི་ཚོར་ཨ་རམ་པའི་སྐད་སྨྲ་བར་མཛོད་ཅིག ལྕགས་རིའི་སྟེང་གི་མི་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་སྐད་གོ་བས་དེ་མི་གསུང་རོགས་ཞེས་ཞུས་མོད།"]},{"type":"verse","number":27,"content":["འོན་ཀྱང་རབ་ཤཱ་ཀེ་ན་རེ། ང་ཡི་བདག་པོས་ཁྱོད་ཀྱི་བདག་པོ་དང་ཁྱོད་ཁོ་ནར་གཏམ་འདི་དག་སྨྲ་བའི་ཕྱིར་ང་འདིར་མངགས་པ་ཡིན་ནམ། ཁོང་གིས་ལྕགས་རིའི་སྟེང་སྡོད་པའི་མི་རྣམས་ཏེ། ཁྱོད་དང་མཉམ་དུ་རང་གི་སྐྱག་པ་ཟ་ཞིང་རང་གི་གཅིན་པ་འཐུང་བ་རྣམས་ལའང་སྨྲ་བའི་ཕྱིར་བདག་མངགས་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":28,"content":["དེར་རབ་ཤཱ་ཀེ་ཡར་ལངས་ནས་སྐད་ཆེན་པོས་ཡ་ཧུ་དཱའི་སྐད་དུ། རྒྱལ་པོ་ཆེན་པོ་ཨ་སུར་གྱི་རྒྱལ་པོའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":29,"content":["རྒྱལ་པོས་འདི་སྐད་གསུངས་ཏེ། ཧི་ཟི་ཀི་ཡཱས་ཁྱོད་ཅག་ངའི་ལག་ནས་ཐར་བར་བྱ་མི་ནུས་པས། ཁྱོད་ཅག་ཁོའི་གཡོ་འོག་ཏུ་མ་ཚུད་ཅིག"]},{"type":"verse","number":30,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་ཁྱོད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེར་བརྟེན་དགོས་པའི་ཐད། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ཚོ་སྐྱོབ་ངེས་ཤིང་། གྲོང་ཁྱེར་འདིའང་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་པར་མི་བྱའོ་ཞེས་པའི་ཚིག་ལ་མ་མཉན་ཅིག"]},{"type":"verse","number":31,"content":["ཧི་ཟི་ཀི་ཡཱའི་གཏམ་ལ་མཉན་མི་རུང་། རྒྱུ་མཚན་ནི་ཨ་སུར་གྱི་རྒྱལ་པོས་འདི་སྐད་གསུངས་ཏེ། ཁྱོད་ཅག་བདག་དང་མཐུན་པོ་ཡོང་ཆེད་ཕྱི་རུ་ཤོག་དང་། ཁྱོད་ཚོ་མི་རེ་རེས་རང་རང་གི་རྒུན་ཤིང་དང་། སེ་ཡབ་ཤིང་གི་འབྲས་བུ་བཟའ་ཞིང་། རང་རང་གི་ཁྲོན་པའི་ཆུ་འཐུང་བར་འགྱུར།"]},{"type":"verse","number":32,"content":["ཁྱོད་རྣམས་གསོན་པོར་ལུས་ཤིང་མི་འཆི་བའི་ཕྱིར་དུ། རྗེས་སུ་ང་འོངས་ནས་ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་ཡུལ་ཁམས་ལྟ་བུའི་ཡུལ་ཁམས་ཤིག་ཏུ་འཁྲིད་པར་བྱ་སྟེ། ཡུལ་དེར་འབྲུ་དང་རྒུན་ཆང་། བག་ལེབ་དང་རྒུན་ཚལ། སྐྱུ་རུ་ཤིང་དང་སྦྲང་རྩི་བཅས་ཡོད་པ་ཡིན། ཧི་ཟི་ཀི་ཡཱས། ངེད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེས་སྐྱོབ་ངེས་ཡིན་ཞེས་སྨྲ་ཞིང་ཁྱོད་ཅག་ལོག་ལམ་དུ་འཁྲིད་པས་དེར་མ་མཉན་ཅིག"]},{"type":"verse","number":33,"content":["རྒྱལ་ཁམས་སོ་སོའི་ལྷ་རྣམས་ལས་སུ་ཞིག་གིས་དངོས་གནས་རང་གི་ཡུལ་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ནས་བསྐྱབས་པ་ཡིན་ནམ།"]},{"type":"verse","number":34,"content":["ཧ་མཱད་དང་ཨར་ཕད་ཀྱི་ལྷ་རྣམས་གང་དུ་ཡོད་དམ། སེ་ཕར་ཝ་ཨིམ་དང་ཧེ་ནཱ། ཨི་ཝཱ་བཅས་ཀྱི་ལྷ་རྣམས་གང་དུ་ཡོད་དམ། དེ་དག་གིས་ངའི་ལག་ནས་སཱ་མར་ཡ་བསྐྱབས་ཡོད་དམ།"]},{"type":"verse","number":35,"content":["ཡུལ་དེ་དག་གི་ལྷ་རྣམས་ལས་སུ་ཞིག་གིས་རང་གི་ས་ཆ་ངའི་ལག་ནས་བླངས་པ་ཡིན་ནམ། དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ལག་ནས་ཡེ་རུ་སཱ་ལེམ་སྐྱོབ་ནུས་སམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":36,"content":["འོན་ཀྱང་། རྒྱལ་པོས་དེ་དག་ལ་ལན་མ་འདེབས་ཤིག་ཅེས་བཀའ་བསྒོས་ཡོད་པས། མི་དེ་དག་ཁ་རོག་གེར་བསྡད་ཅིང་། ཁོ་ལ་ཚིག་ལན་གཅིག་ཀྱང་མ་སྨྲས་སོ། །"]},{"type":"verse","number":37,"content":["དེ་ནས་ཧིལ་ཀི་ཡཱའི་བུ་སྟེ་རྒྱལ་པོའི་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་། དྲུང་ཡིག་ཤེབ་ནཱ་དང་། ཨ་སབ་ཀྱི་བུ་སྟེ་ལོ་རྒྱུས་འགོད་མཁན་ཡོ་ཨག་བཅས་ཀྱིས་རང་རང་གི་གྱོན་གོས་གཤགས་ཏེ། ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་འོངས་ནས་རབ་ཤཱ་ཀེའི་གཏམ་རྣམས་ཁོང་ལ་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/17.json","previousChapterAudioLinks":{},"numberOfVerses":37}