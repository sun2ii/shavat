{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":19,"content":[{"type":"heading","content":["ཡེ་ཤ་ཡཱ་ཡིས་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་ལ་སྐུལ་ལྕགས་བཏང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་དེ་ཐོས་པ་ཙམ་གྱིས་རང་གི་ན་བཟའ་གཤགས་ནས་ལུས་པོར་རྩིད་རས་གཡོགས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕྱིན།"]},{"type":"verse","number":2,"content":["ཡང་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་། དྲུང་ཡིག་ཤེབ་ནཱ་དང་མཆོད་དཔོན་རྣམས་ལས་རྒན་པོ་བཅས་རྩིད་རས་ཀྱིས་གཡོགས་ཏེ། ཨ་མོ་ཟིའི་བུ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་དྲུང་དུ་མངགས།"]},{"type":"verse","number":3,"content":["དེ་དག་གིས་ཁོང་ལ། ཧི་ཟི་ཀི་ཡཱ་ན་རེ། དེ་རིང་ནི་སྡུག་བསྔལ་ཆེ་ཞིང་ཉེས་ཆད་ཕོག་པ་དང་། བརྙས་བཅོས་ཐེབས་པའི་ཉིན་མོ་ཡིན། དེ་ནི་བུ་བཙའ་རན་ལ་སླེབས་ནའང་བཙའ་བའི་སྟོབས་ཟད་པ་དང་འདྲའོ། །"]},{"type":"verse","number":4,"content":["ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་རབ་ཤཱ་ཀེའི་གཏམ་ཐམས་ཅད་གསན་ཡོད་ཀྱང་སྲིད་དེ། མི་དེ་ནི་ཁོའི་བདག་པོ་ཨ་སུར་གྱི་རྒྱལ་པོས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ལ་སྨོད་ཅིང་སྐུར་བ་འདེབས་པའི་དོན་དུ་འདིར་མངགས་པ་ཡིན། ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསན་པའི་ཚིག་རྣམས་ཀྱི་རྐྱེན་གྱིས་ཉེས་ཆད་གཏོང་བར་བྱ། དེ་བས་ན། ཁྱེད་ཀྱིས་ཤུལ་དུ་ལུས་ཡོད་པ་རྣམས་ཀྱི་དོན་དུ་གསོལ་བ་འདེབས་རོགས་ཟེར་ཞེས་སྦྲན་ཏོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་འཁོར་གཡོག་རྣམས་ཡེ་ཤ་ཡཱའི་དྲུང་དུ་སླེབས་པའི་ཚེ།"]},{"type":"verse","number":6,"content":["ཡེ་ཤ་ཡཱས་དེ་དག་ལ། ཁྱོད་ཅག་གི་བདག་པོ་ལ་འདི་ལྟར་སྦྲོན་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཨ་སུར་རྒྱལ་པོའི་འཁོར་གཡོག་རྣམས་ཀྱིས་བདག་ལ་སྐུར་བ་བཏབ་པའི་གཏམ་ཁྱོད་ཀྱིས་ཐོས་ཀྱང་། དེ་ལ་མ་འཇིགས་ཤིག"]},{"type":"verse","number":7,"content":["ལྟོས་དང་། བདག་གིས་ཁོའི་ནང་དུ་སེམས་ཉིད་ཅིག་འཇོག་པ་དང་།",{"noteId":13},"ཁོས་འཆལ་གཏམ་ཞིག་ཐོས་ནས་རང་ཡུལ་དུ་ལོག་པར་འགྱུར་བ་དང་། ངས་ཁོ་ནི་རང་གི་ཡུལ་དུ་རལ་གྲིའི་ཁ་ནས་འཆི་བར་བྱེད་ངེས་གསུངས་ཞེས་ཞུས་སོ། །"]},{"type":"heading","content":["སེན་ན་ཧེ་རིབ་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་རྒོལ་བ།"]},{"type":"verse","number":8,"content":["ཡང་རབ་ཤཱ་ཀེས་ཨ་སུར་གྱི་རྒྱལ་པོ་ལཱ་ཀི་སི་ནས་ཆས་ཟིན་པར་ཐོས་པས། ཁོ་ཕྱིར་ལོག་པ་ན། ཨ་སུར་གྱི་རྒྱལ་པོས་ལིབ་ནཱ་དང་དམག་འཐབ་བྱེད་བཞིན་པ་དང་ཕྲད་དོ། །"]},{"type":"verse","number":9,"content":["ཨ་སུར་གྱི་རྒྱལ་པོས། ལྟོས་དང་། ཁོ་རང་ཁྱེད་ལ་དམག་འཐབ་ཏུ་འོངས་སོ་ཞེས་པའི་གུ་ཤ་ཡི་རྒྱལ་པོ་ཐིར་ཧ་ཀཱའི་སྐོར་ཐོས་པས། ཁོས་ཧི་ཟི་ཀི་ཡཱའི་རྩར་བང་ཆེན་མངགས་ནས་དེ་དག་ལ།"]},{"type":"verse","number":10,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་ལ་འདི་ལྟར། ཁྱོད་ཀྱིས་བློ་བཅོལ་བའི་དཀོན་མཆོག་གིས་ཡེ་རུ་སཱ་ལེམ་ནི་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ཏུ་ཚུད་པར་མི་འགྱུར་ཞེས་ཁྱོད་རང་བསླུ་བར་མ་གྱུར་ཅིག"]},{"type":"verse","number":11,"content":["ལྟོས་དང་། ཨ་སུར་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཡུལ་ཡོད་དོ་ཅོག་ལ་ཅི་བྱས་པ་དང་། ཐམས་ཅད་རྩ་ནས་བརླགས་པ་དེ་ཁྱོད་ཀྱིས་ཐོས་པས། ཁྱོད་རང་ཅི་ལྟར་ཐར་ནུས་སམ།"]},{"type":"verse","number":12,"content":["ངའི་ཡབ་མེས་ཀྱིས་ཚར་བཅད་པའི་གོ་ཟན་དང་། ཧཱ་རན་དང་། རེ་ཙེབ་དང་། ཐེ་ལཱ་སར་དུ་ཡོད་པའི་ཨེ་དེན་གྱི་བུ་རྒྱུད་དང་བཅས་པའི་མི་རིགས་སོ་སོའི་ལྷ་རྣམས་ཀྱིས་དེ་དག་བསྐྱབས་སམ།"]},{"type":"verse","number":13,"content":["ཧ་མཱད་ཀྱི་རྒྱལ་པོ་དང་ཨར་ཕད་ཀྱི་རྒྱལ་པོ། སེ་ཕར་ཝ་ཨིམ་གྲོང་ཁྱེར་དང་ཧེ་ནཱ། ཨི་ཝཱ་བཅས་ཀྱི་རྒྱལ་པོ་རྣམས་གང་དུ་ཡོད་དམ་ཞེས་སྨྲོས་ཤིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":14,"content":["དེ་ཡང་ཧི་ཟི་ཀི་ཡཱས་བང་ཆེན་རྣམས་ཀྱི་ལག་ནས་འབྱོར་བའི་འཕྲིན་ཡིག་དེ་བཀླགས་རྗེས། ཡར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་སོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འཕྲིན་ཡིག་ཁ་ཕྱེས་ནས་བཞག་གོ །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱས་སྨོན་ལམ་བཏབ་པ།"]},{"type":"verse","number":15,"content":["དེ་ཡང་ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་གསོལ་བ་བཏབ་ཅིང་འདི་སྐད་དུ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག ཀེ་རུབ་རྣམས་ཀྱི་གོང་དུ་བཞུགས་པ་ལགས། ཁྱེད་གཅིག་པུ་ས་གཞིའི་རྒྱལ་ཁམས་ཐམས་ཅད་ཀྱི་དཀོན་མཆོག་ལགས་ཤིང་། ཁྱེད་ཀྱིས་གནམ་ས་གཉིས་བཀོད་པ་ཡིན།"]},{"type":"verse","number":16,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་སྙན་དབང་གཏད་ནས་གསན་དུ་གསོལ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་སྤྱན་ཟུང་ཕྱེས་ནས་གཟིགས་པར་མཛོད། སེན་ན་ཧེ་རིབ་ཀྱིས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ལ་སྐུར་བ་བཏབ་པའི་དོན་དུ་འཕྲིན་བསྐུར་བའི་གཏམ་རྣམས་ལ་གསན་དུ་གསོལ།"]},{"type":"verse","number":17,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཨ་སུར་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་མི་རིགས་དེ་རྣམས་དང་། དེ་དག་གི་ས་ཆ་ཀུན་རྡུལ་དུ་བརླགས་པ་ནི་བདེན་ཏེ།"]},{"type":"verse","number":18,"content":["དེ་དག་གི་ལྷ་རྣམས་མེ་ལ་གཡུགས། ཅི་ལ་ཞེ་ན། དེ་དག་ནི་དཀོན་མཆོག་མ་ཡིན་པར་མིའི་ལག་བཟོས་ཀྱི་ཤིང་སྐུ་དང་རྡོ་སྐུ་ཡིན་པས། ཁོ་ཚོས་དེ་དག་མེད་པར་བཏང་བ་རེད།"]},{"type":"verse","number":19,"content":["ཀྱེ་བདག་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ས་གཞིའི་རྒྱལ་ཁམས་ཐམས་ཅད་ཀྱིས་ཡ་ཝཱེ་ཁྱེད་གཅིག་པུ་ནི་དཀོན་མཆོག་ཡིན་པ་རྟོགས་པའི་ཆེད་དུ། ད་ལྟ་བདག་ཅག་ཁོའི་ལག་ནས་སྐྱོབ་པར་མཛོད་ཅེས་གསོལ་ཏོ། །"]},{"type":"heading","content":["ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་ཡིས་སེན་ན་ཧེ་རིབ་མེད་པར་འགྲོ་བའི་ལུང་བསྟན་པ།"]},{"type":"verse","number":20,"content":["དེ་ནས་ཨ་མོ་ཟིའི་བུ་ཡེ་ཤ་ཡཱས་ཧི་ཟི་ཀི་ཡཱ་ལ་འཕྲིན་བསྐུར་ཏེ་ན་རེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས། ཁྱོད་ཀྱིས་ང་ལ་ཨ་སུར་གྱི་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་སྐོར་གྱི་གསོལ་བ་བཏབ་པ་དེ་ངས་གསན་བྱུང་ཞེས་པའོ། །"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ་རྒོལ་ལན་གསུངས་པ་འདི་ལྟར།",{"text":"ཛ་ཡན་","poem":1},{"noteId":14},{"text":"བུ་མོ་ན་ཆུང་མས་ཁྱོད་ལ་བརྙས་ཤིང་ཁྲེལ་རྒོད་བྱས།","poem":1},{"lineBreak":true},{"text":"ཡེ་རུ་སཱ་ལེམ་གྱི་བུ་མོས་ཁྱོད་ཀྱི་རྒྱབ་ནས་མགོ་བོ་གཡུག་གོ །","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ཁྱོད་ཀྱིས་སུ་ལ་དམའ་འབེབས་བྱས་ཤིང་སྐུར་བ་བཏབ་པ་ཡིན་ནམ།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱིས་ཀི་སྒྲ་བསྒྲགས་ནས་སུ་ལ་རྒོལ་བ་ཡིན་ནམ།","poem":1},{"lineBreak":true},{"text":"མིག་ཟུང་མཐོན་པོར་བཏེགས་ནས་སུ་ལ་ང་རྒྱལ་བསྐྱེད་དམ། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ལ་རྒོལ་བ་ཡིན་ནོ། །","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ཁྱོད་ཀྱིས་རང་གི་བང་ཆེན་བརྒྱུད་ནས་གཙོ་བོར་འཕྱ་སྨོད་བྱེད་བཞིན་ན་རེ།","poem":1},{"lineBreak":true},{"text":"ང་ནི་རང་གི་ཤིང་རྟའི་དཔུང་ཚོགས་དང་མཉམ་དུ།","poem":1},{"lineBreak":true},{"text":"རི་བོ་མཐོན་པོ་དག་གི་རྩེ་ལ་འགོས་ཤིང་།","poem":1},{"lineBreak":true},{"text":"རྒྱང་ཐག་རིང་བའི་ལེ་པཱ་ནོན་གྱི་བར་དུ་སླེབས་པ་དང་།","poem":1},{"lineBreak":true},{"text":"དེ་རུ་ཡོད་པའི་ཐང་ཤིང་རིང་པོ་དང་། གསོམ་ཤིང་ལེགས་པོ་རྣམས་བཅད་པ་ཡིན།","poem":1},{"lineBreak":true},{"text":"ནགས་ཚལ་སྟུག་པོ་བརྒྱུད་ནས་རྒྱང་ཐག་རིང་བའི་ཞག་མལ་གཏོང་ས་དེར་ཞུགས་པའོ། །","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ངས་དོང་ཆུ་བྲུས་ཏེ་ཡུལ་གཞན་པའི་བཏུང་ཆུ་འཐུང་ཞིང་།","poem":1},{"lineBreak":true},{"text":"རང་གི་རྐང་མཐིལ་གྱིས་ཨེ་ཅིབ་ཀྱི་ཆུ་ཀླུང་ཐམས་ཅད་སྐེམ་དུ་བཅུག་ཅེས་སྨྲས་སོ། །","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་གནའ་ནས་བཀོད་སྒྲིག་བྱས་ཤིང་། སྔོན་ནས་འཆར་བཀོད་བཟོས་ཡོད་པ་ཁྱོད་ཀྱིས་མ་ཐོས་སམ།","poem":1},{"lineBreak":true},{"text":"ད་ནི་བདག་གིས་ཁྱོད་ཀྱི་ལྕགས་རིས་བསྐོར་བའི་གྲོང་ཁྱེར་རྣམས་བཤིགས་ནས་ས་རོར་བསྒྱུར་བ་དེ་བདག་གིས་བསྒྲུབས་པ་ཡིན།","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ཡུལ་དེར་གནས་པའི་མི་རྣམས་སྟོབས་ཤུགས་ཟད་དེ།","poem":1},{"lineBreak":true},{"text":"དཔའ་ཞུམ་པ་དང་ཁ་སྐྱེངས་པར་གྱུར་ཏོ། །","poem":1},{"lineBreak":true},{"text":"དེ་དག་ནི་རི་ཐང་གི་རྩྭ་སྔོན་དང་སྔོ་ཚོད་སྙི་མོ་དང་།","poem":1},{"lineBreak":true},{"text":"ཁང་ཐོག་གི་རྩྭ་བཞིན་དུ་ད་དུང་མ་སྐྱེས་སྔོན་ལ་རྙིད་པ་ལྟ་བུ་ཡིན་ནོ། །","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ཁྱོད་རང་མར་སྡོད་པ་དང་། ཁྱོད་རང་ཕྱི་ནང་དུ་འགྲོ་འོང་བྱེད་པ།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་རང་ང་ལ་རབ་ཏུ་ཁྲོས་པ་བཅས་ཐམས་ཅད་བདག་གིས་རྟོགས་ཡོད་དོ། །","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"དེར་བརྟེན། ཁྱོད་རང་ང་ལ་རབ་ཏུ་ཁྲོས་ཤིང་།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཁེངས་དྲེགས་ཀྱི་གཏམ་དེ་ངའི་རྣ་ལམ་དུ་ཆུད་བྱུང་བས།","poem":1},{"lineBreak":true},{"text":"ངས་རང་གི་ལྕགས་ཀྱུ་ཁྱོད་ཀྱི་སྣ་རུ་བསྐོན་པ་དང་།","poem":1},{"lineBreak":true},{"text":"རང་གི་སྲབ་ཁྱོད་ཀྱི་མཆུ་ཏོར་བསྐོན་ནས། ཁྱོད་འོངས་པའི་ལམ་དེ་ནས་ཕྱིར་ལྡོག་པར་བྱའོ། །","poem":1}]},{"type":"verse","number":29,"content":["དེ་ཡང་རྟགས་འདི་ནི་ཁྱོད་ཀྱི་ཕྱིར་དུ་ཡིན་ཏེ། ལོ་འདིར་ཁྱོད་ཀྱིས་རང་བཞིན་དུ་སྐྱེས་པ་དེ་བཟའ་བར་འགྱུར། ལོ་གཉིས་པར་ཅི་སྨིན་པ་དེ་བཟའ་བར་འགྱུར། ཡང་ལོ་གསུམ་པར་ཁྱོད་ཅག་གིས་ཞིང་རྨོ་ཞིང་བརྔ་བ་སྟེ། རྒུན་ཚལ་བཙུགས་པ་དེའི་འབྲས་བུ་བཟའ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":30,"content":["ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ལས་སྐྱབས་རྙེད་པའི་ལྷག་མ་དེ་ནི། སླར་ཡང་མར་རྩ་བ་ཟུག་ཅིང་སྟེང་དུ་འབྲས་བུ་འབྱུང་བར་འགྱུར་ངེས།"]},{"type":"verse","number":31,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ལྷག་མ་རྣམས་ཡེ་རུ་སཱ་ལེམ་ནས་ཕྱི་རུ་ཐོན་ཞིང་། སྲོག་ཐར་བ་རྣམས་རི་བོ་ཛ་ཡན་ནས་ཕྱི་ལ་སླེབ་པར་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་འཁྲེན་གྱིས་དེ་ལྟར་མཛད་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":32,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་སུར་རྒྱལ་པོའི་སྐོར་ལ་འདི་སྐད་དུ། ཁོ་རང་གྲོང་ཁྱེར་འདིར་འོང་བར་མི་འགྱུར་ཞིང་། དེ་གར་མདའ་ཡང་འཕེན་པར་མི་འགྱུར། ཕུབ་ཐོགས་ནས་དེའི་ཕྱོགས་སུ་འོང་བར་མི་འགྱུར་ལ། དེའི་མཐའ་ལ་འཐབ་ར་ཡང་བརྩིག་པར་མི་འགྱུར།"]},{"type":"verse","number":33,"content":["ཁོ་སྔར་འོངས་པའི་ལམ་དེ་ནས་ཕྱིར་ལོག་འགྲོ་བ་དང་། གྲོང་ཁྱེར་དེའི་ནང་དུ་འོང་བར་མི་འགྱུར་བ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":34,"content":["ང་དང་ངའི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་དོན་དུ། ངས་གྲོང་ཁྱེར་འདི་སྐྱོབ་པའི་ཕྱིར་སྲུང་བར་བྱ་ཞེས་པའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":35,"content":["དེ་ཡང་མཚན་མོ་དེར་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཐོན་ཏེ། ཨ་སུར་པའི་དམག་སྒར་ལས་མི་ཆིག་འབུམ་བརྒྱད་ཁྲི་ལྔ་སྟོང་བསད་པ་དང་། མི་རྣམས་ཐོ་རངས་མལ་ལས་ལངས་དུས། ཀྱེ་ཧོ། བམ་རོས་གང་སར་ཁྱབ་པའོ། །"]},{"type":"verse","number":36,"content":["དེ་ནས་ཨ་སུར་གྱི་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ནི་ཕྱིར་ཐོན་ཏེ་འགྲུལ་བཞུད་བྱས་ཤིང་ཡུལ་དུ་ཆིབས་ཁ་བསྒྱུར་པ་དང་ནིན་ཝེ་ནས་བསྡད་དོ། །"]},{"type":"verse","number":37,"content":["ཡང་ཉིན་ཞིག་ཁོས་རང་གི་ལྷ་ནིས་རོག་གི་ལྷ་ཁང་དུ་ཕྱག་འཚལ་བའི་ཚེ། དེའི་བུ་ཨད་རམ་མེ་ལེག་དང་སཱར་ཨེ་ཚེར་གཉིས་ཀྱིས་ཁོ་རལ་གྲིས་བསད་ནས་ཨ་ར་རད་ཡུལ་དུ་བྲོས་པ་དང་། དེ་ནས་ཁོའི་བུ་ཨེ་སར་ཧད་ཏོན་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":13,"caller":"+","text":"ངས་ནི་ཁོའི་སེམས་སྐྲག་ནས་འདར་བར་བྱེད་ཅེས་པའི་ནང་དོན་ལའང་འཇུག","reference":{"chapter":19,"verse":7}},{"noteId":14,"caller":"+","text":"ཛ་ཡན་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་མིང་གཞན་ཡིན།","reference":{"chapter":19,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/2KI/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/18.json","previousChapterAudioLinks":{},"numberOfVerses":37}