{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":20,"content":[{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱ་སྙུང་བར་གྱུར་པ།"]},{"type":"verse","number":1,"content":["དུས་དེར་ཧི་ཟི་ཀི་ཡཱ་ལ་ནད་ལྗིད་མོ་ཞིག་ཕོག་སྟེ་འཆི་ལ་ཉེ་བ་དང་། ཨ་མོ་ཟིའི་བུ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་ཁོའི་དྲུང་དུ་འོངས་ཏེ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་གསོན་མི་ཐུབ་པར་འཆི་བར་འགྱུར་བས། ཁྱོད་ཀྱིས་རང་གི་ཁྱིམ་ལ་བཀོད་སྒྲིག་ལེགས་པོ་གྱིས་ཤིག་གསུངས་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":2,"content":["ཧི་ཟི་ཀི་ཡཱས་རང་གི་ངོ་གདོང་རྩིག་པའི་ཕྱོགས་སུ་འཁོར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་བཏབ་ནས་ན་རེ།"]},{"type":"verse","number":3,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ང་རང་ཁྱེད་ཀྱི་སྤྱན་སྔར་བློ་དཀར་བ་དང་བསམ་པ་ལྷད་མེད་ཀྱིས་འགྲུལ་ཞིང་། ཁྱེད་ཀྱི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་བསྒྲུབས་པ་ཁྱེད་ཀྱིས་ཐུགས་སུ་དྲན་པར་མཛོད་ཅེས་ཞུས་ཏེ་དྲག་ཏུ་ངུས་སོ། །"]},{"type":"verse","number":4,"content":["ཡེ་ཤ་ཡཱ་ཚོམས་དཀྱིལ་ནས་ཁ་མ་བྲལ་གོང་དུ། ཁོ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཕྱིར་སོང་ནས་བདག་གི་འབངས་མིའི་འགོ་དཔོན་ཧི་ཟི་ཀི་ཡཱ་ལ། ཁྱོད་ཀྱི་ཡབ་མེས་དཱ་བིད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་ཁྱོད་ཀྱི་གསོལ་འདེབས་ཐོས་པ་ཡིན། ཁྱོད་ཀྱི་མཆི་མའང་མཐོང་བ་ཡིན། ལྟོས་དང་། བདག་གིས་ཁྱོད་ཀྱི་ནད་གསོ་བར་བྱེད་ཅིང་། ཉིན་གསུམ་པར་ཁྱོད་རང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འགྲོ་བར་འགྱུར།"]},{"type":"verse","number":6,"content":["བདག་གིས་ཁྱོད་ཀྱི་ཚེ་ཚད་ལ་ལོ་བཅོ་ལྔ་སྣོན་པར་བྱའོ། །ཡང་བདག་གིས་ཁྱོད་དང་གྲོང་ཁྱེར་འདི་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ནས་སྐྱོབ་ཅིང་། བདག་དང་བདག་གི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་དོན་དུ་གྲོང་ཁྱེར་འདི་བསྲུང་བར་བྱ་གསུངས་ཞེས་སྨྲོས་ཤིག་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["དེ་ཡང་ཡེ་ཤ་ཡཱ་ཡིས་སེ་ཡབ་ལེབ་མོ་ཞིག་ཁྱེར་ཤོག་ཅེས་བསྒོས་པར། དེ་དག་གིས་བླངས་ནས་ཤ་འབུར་གྱི་ཁར་བསླན་པས་ཁོ་གསོན་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":8,"content":["དེར་ཧི་ཟི་ཀི་ཡཱས་ཡེ་ཤ་ཡཱ་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ནད་གསོ་བར་འགྱུར་བ་དང་། ཉིན་གསུམ་པར་ང་རང་ཡར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འགྲོ་བར་རྟགས་མཚན་ཅི་ཡོད་དམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":9,"content":["ཡེ་ཤ་ཡཱ་ཡིས་འདི་སྐད་དུ། དཀོན་མཆོག་ཡ་ཝཱེས་ཅི་གསུངས་པ་དེ་མཛད་པར་ཁོང་གིས་རྟགས་འདི་གནང་བ་སྟེ། གྲིབ་མ་གོམ་པ་བཅུ་མདུན་དུ་འགྲོ་བའམ། ཡང་ན་གོམ་པ་བཅུ་རྒྱབ་ཏུ་ལོག་པ་ལས་གང་འདོད་དམ་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":10,"content":["ཧི་ཟི་ཀི་ཡཱས་ལན་དུ། གྲིབ་མ་གོམ་པ་བཅུ་མདུན་དུ་འགྲོ་བ་ནི་སླ་བས་དེ་མི་འདོད། གྲིབ་མ་གོམ་པ་བཅུ་རྒྱབ་ཏུ་ལོག་དགོས་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":11,"content":["ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་པ་དང་། ཁོང་གིས་ཨ་ཧ་ཟཱ་ཡི་དུས་ཚོད་འཇལ་ཆས་སྟེང་གི་གྲིབ་མ་དེ་ནི་གོམ་པ་བཅུ་རྒྱབ་ཏུ་ཟློག་པར་མཛད་དོ། །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱ་དང་པཱ་པེལ་ལོན་གྱི་སྐུ་ཚབ་པ།"]},{"type":"verse","number":12,"content":["དེའི་དུས་སུ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་པལ་ཨ་དན་གྱི་བུ་སྟེ། མེ་རོ་དག་པལ་ཨ་དན་གྱིས་ཧི་ཟི་ཀི་ཡཱ་ལ་སྙུང་གཞི་བྱུང་བ་ཐོས་ནས། ཁོས་འཕྲིན་ཡིག་དང་ཕྱག་རྟེན་བསྐུར་ཏོ། །"]},{"type":"verse","number":13,"content":["ཧི་ཟི་ཀི་ཡཱས་བང་ཆེན་གྱི་གཏམ་ལ་མཉན་པ་དང་། རང་གི་གཏེར་མཛོད་ཀྱི་གསེར་དངུལ་དང་། སྤོས་དང་སྤོས་ཆུ་རིན་ཐང་ཅན། མཚོན་ཆའི་མཛོད་དང་། གཏེར་མཛོད་ནང་དུ་ཅི་ཡོད་པ་ཐམས་ཅད་དེ་དག་ལ་བསྟན་ཏོ། །ཧི་ཟི་ཀི་ཡཱས་ཁོའི་ཕོ་བྲང་དང་ཁོའི་རྒྱལ་ཁམས་ཡོངས་སུ་ནོར་རྫས་གང་ཡོད་ཐམས་ཅད་ལས་དེ་དག་ལ་མ་བསྟན་པ་གང་ཡང་མེད་དོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་འོངས་ནས་ཁོ་ལ། མི་འདི་དག་གིས་ཅི་ཟེར། ཁྱེད་ཀྱི་དྲུང་དུ་ཡུལ་གང་ནས་འོངས་ཞེས་དྲིས་པར། ཧི་ཟི་ཀི་ཡཱས། དེ་དག་ནི་རྒྱང་ཐག་རིང་བའི་པཱ་པེལ་ལོན་ཡུལ་ནས་འོངས་པ་རེད་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":15,"content":["ཡེ་ཤ་ཡཱ་ཡིས་དེ་དག་གིས་ཁྱོད་ཀྱི་ཕོ་བྲང་ནས་ཅི་མཐོང་བ་ཡིན་ནམ་ཞེས་དྲིས་པའི་ལན་དུ། ཧི་ཟི་ཀི་ཡཱས་དེ་དག་གིས་ངའི་ཕོ་བྲང་དུ་ཅི་ཡོད་པ་ཐམས་ཅད་མཐོང་བ་ཡིན་ཏེ། དེ་དག་ལ་མ་བསྟན་པའི་ནོར་རྫས་གང་ཡང་ངའི་གཏེར་མཛོད་ནང་ལུས་མེད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["དེར་ཡེ་ཤ་ཡཱས་ཧི་ཟི་ཀི་ཡཱ་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":17,"content":["ལྟོས་དང་། ཁྱོད་ཀྱི་ཕོ་བྲང་དུ་ཡོད་པ་ཐམས་ཅད་དང་། ཁྱོད་ཀྱི་ཕ་མེས་རྣམས་ཀྱིས་དེ་རིང་གི་བར་དུ་བསགས་པ་ཐམས་ཅད་ཅི་ཡང་མ་ལུས་པར་པཱ་པེལ་ལོན་དུ་འཁྱེར་བའི་དུས་ཤིག་སླེབས་འོང་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":18,"content":["ཡང་ཁྱོད་ལས་མཆེད་ཅིང་ཁྱོད་ལས་སྐྱེས་པའི་བུ་རྒྱུད་རྣམས་ལས་ཁ་ཅིག་བཙོན་དུ་ཁྲིད་ནས་པཱ་པེལ་ལོན་རྒྱལ་པོའི་ཕོ་བྲང་དུ་ཉུག་རུམ་པར་འགྱུར་རོ་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":19,"content":["ཧི་ཟི་ཀི་ཡཱས་ཡེ་ཤ་ཡཱ་ལ། ཁྱོད་ཀྱིས་གསུངས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ནི་ལེགས་སོ་ཞེས་སྨྲས་པ་དང་། ཁོའི་སེམས་སུ་ངའི་ཉིན་མོ་རྣམས་ཞི་བདེ་དང་བརྟན་འཇགས་ཡོད་པ་མིན་ནམ་སྙམ་མོ། །"]},{"type":"verse","number":20,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱའི་དོན་གཞན་རྣམས་དང་ཁོའི་དཔའ་བོའི་མཛད་རྗེས་དང་། ཁོས་ཇི་ལྟར་ཆུ་རྫིང་དང་སྦུག་ལམ་བཟོས་ནས་གྲོང་ཁྱེར་དུ་ཆུ་དྲངས་པ་རྣམས་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":21,"content":["ཧི་ཟི་ཀི་ཡཱ་རང་གི་ཡབ་མེས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་པ་དང་། ཁོའི་སྲས་མཱ་ན་ཤེ་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/19.json","previousChapterAudioLinks":{},"numberOfVerses":21}