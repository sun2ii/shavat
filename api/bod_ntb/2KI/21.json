{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":21,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་མཱ་ན་ཤེ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་མཱ་ན་ཤེ་ཡིས་རྒྱལ་སྲིད་བཟུང་དུས་ཁོ་ལོ་བཅུ་གཉིས་ལ་སོན་ཡོད་དེ། ཁོས་ལོ་ལྔ་བཅུ་ང་ལྔའི་རིང་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་སྲིད་བསྐྱངས་པ་དང་། ཁོའི་ཡུམ་གྱི་མིང་ལ་ཧབ་ཚི་བཱ་ཞེས་ཟེར་རོ། །"]},{"type":"verse","number":2,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་སྐྲོད་པར་མཛད་པའི་མི་རིགས་རྣམས་ཀྱིས་སྤྱད་པའི་སྐྱུག་བྲོ་བའི་དོན་རྣམས་སྤྱད་ཅིང་།"]},{"type":"verse","number":3,"content":["རང་གི་ཡབ་ཧི་ཟི་ཀི་ཡཱས་བཤིགས་པའི་མཐོ་གླིང་རྣམས་ཡང་བསྐྱར་བརྩིགས་ཏེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱིས་བགྱིས་པ་ལྟར་དུ་པཱ་ཨལ་གྱི་ཕྱིར་མཆོད་ཁྲི་བཞེངས་པ་དང་། ཨ་ཤེ་རཱ་ཡང་བཟོས་ཤིང་ནམ་མཁའི་སྐར་ཚོགས་ཐམས་ཅད་ལ་ཕྱག་བཙལ་ནས་ཞབས་ཕྱི་བསྒྲུབས།"]},{"type":"verse","number":4,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་མཆོད་ཁྲི་རྣམས་བཞེངས་པ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་མཆོད་ཁང་དེ་བསྟན་ནས་འདི་སྐད་དུ། བདག་གིས་ཡེ་རུ་སཱ་ལེམ་དུ་རང་གི་མཚན་གནས་པར་བྱ་ཞེས་གསུངས་པའོ། །"]},{"type":"verse","number":5,"content":["ཡང་ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཁྱམས་ར་གཉིས་ཀྱི་ནང་དུ་ནམ་མཁའི་སྐར་ཚོགས་ཀུན་གྱི་ཆེད་དུ་མཆོད་ཁྲི་རྣམས་བཞེངས།"]},{"type":"verse","number":6,"content":["ཁོས་རང་གི་བུ་མེ་མཆོད་དུ་ཕུལ་བ་དང་། རྩིས་པ་དང་མོ་པ་ལས་རྟགས་མཚན་ཞུས་ཤིང་། ལྷ་པ་དང་གཤིན་འདྲེ་འགུག་མཁན་རྣམས་བསྟེན་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པའི་དོན་རྣམས་སྤྱད་དེ་ཁོང་ཐུགས་ཁྲོ་བར་བྱས།"]},{"type":"verse","number":7,"content":["ཡང་ཁོ་རང་གིས་བཟོས་པའི་ཨ་ཤེ་རཱ་ཡི་ལྷ་སྐུ་དེ་མཆོད་ཁང་དུ་བཞག དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་དཱ་བིད་དང་ཁོའི་བུ་སོ་ལོ་མོན་གཉིས་ལ། བདག་གིས་མཆོད་ཁང་འདི་དང་ཡེས་ར་ཨེལ་གྱི་སྡེ་ཐམས་ཅད་ལས་བདམས་པའི་ཡེ་རུ་སཱ་ལེམ་དུ་རང་གི་མཚན་ནི་དུས་རྟག་ཏུ་འཇོག་པར་བྱའོ། །"]},{"type":"verse","number":8,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་བདག་གིས་བསྩལ་པའི་བཀའ་ཐམས་ཅད་དེ། བདག་གི་ཞབས་ཕྱི་མོ་ཤེ་ཡིས་ཁོ་ཚོར་བསྟན་པའི་བཀའ་ཁྲིམས་ཐམས་ཅད་བསྲུངས་ན། བདག་གིས་ཁོ་རྣམས་ཀྱི་རྐང་པ་ནི་ངས་ཁོ་ཚོའི་ཕ་མེས་ལ་གནང་བའི་ཡུལ་ཁམས་ནས་འཁྱར་དུ་མི་འཇུག་ཅེས་གསུངས་མོད།"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་དེ་དག་གིས་མ་མཉན་པ་དང་། མཱ་ན་ཤེ་ཡིས་དེ་དག་ལོག་ལམ་དུ་ཁྲིད་ནས་དོན་ངན་སྤྱད་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་མེད་པར་མཛད་པའི་མི་རྣམས་ལས་ཀྱང་ཐུའོ། །"]},{"type":"heading","content":["མཱ་ན་ཤེ་ཡི་སྐུ་བརྙན་ལ་དགག་པ།"]},{"type":"verse","number":10,"content":["དེ་བས་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ཉིད་ཀྱི་ཞབས་ཕྱི་ལུང་སྟོན་པའི་ངག་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":11,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་མཱ་ན་ཤེ་ཡིས་སྐྱུག་བྲོ་བའི་དོན་འདི་རྣམས་བྱས་པ་ནི། ཁོའི་སྔོན་དུ་ཡོད་པའི་ཨེ་མོར་པ་རྣམས་ཀྱིས་སྤྱད་པའི་ངན་པ་ལས་ཀྱང་ཐུ་ལ། ཁོས་ལྷ་སྐུ་བསྟེན་པ་དང་མཉམ་དུ་ཡ་ཧུ་དཱ་ལ་ཡང་སྡིག་པ་བྱེད་དུ་བཅུག་པ་ཡིན།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གིས་ཡེ་རུ་སཱ་ལེམ་དང་ཡ་ཧུ་དཱ་རུ་ཆག་སྒོ་འབྱུང་བར་བྱེད་ཅིང་། སུ་ཞིག་གི་རྣ་བས་ཐོས་ན་རྣ་བ་གཉིས་ལ་ཟུག་རྔུ་བསྐྱེད་དོ། །"]},{"type":"verse","number":13,"content":["བདག་གིས་ཡེ་རུ་སཱ་ལེམ་གྱི་ཐོག་ཏུ་སཱ་མར་ཡའི་ཐིག་སྐུད་དང་ཨ་ཧབ་ཀྱི་ཁང་པའི་དཔྱང་རྡོ་བཀོལ་ནས་མེད་པར་བྱ་སྟེ། མི་ཞིག་གིས་སྡེར་མ་ཞིག་ཕྱིས་ནས་མར་སྐོར་བ་ལྟར། བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ཡང་དབྱི་བར་བྱའོ། །"]},{"type":"verse","number":14,"content":["བདག་གིས་རང་ཉིད་ཀྱི་ནོར་སྐལ་ལས་ལྷག་ལུས་རྣམས་སྤངས་ནས་ཁོ་ཚོའི་དགྲ་བོའི་ལག་ཏུ་གཏོད་པ་དང་། ཁོ་རྣམས་རང་གི་དགྲ་བོའི་བཅོམ་ནོར་དང་དམག་ཐོབ་དངོས་རྫས་སུ་འགྱུར་ངེས།"]},{"type":"verse","number":15,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གི་མེས་པོ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་ཉིན་མོ་ནས་དེ་རིང་གི་བར་དུ། དེ་དག་གིས་བདག་གི་མིག་མདུན་ནས་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཅིང་། བདག་ཁྲོ་བར་བྱས་པ་ཡིན་གསུངས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ཡང་མཱ་ན་ཤེ་ཡིས་ཡ་ཧུ་དཱ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་པའི་སྟེང་དུ། ཡེ་རུ་སཱ་ལེམ་གྱི་མགོ་ནས་མཇུག་བར་དུ་ཉེས་མེད་མང་པོའི་ཁྲག་བཞུར་དུ་བཅུག་གོ །"]},{"type":"verse","number":17,"content":["མཱ་ན་ཤེའི་དོན་གཞན་རྣམས་དང་ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་དང་། ཁོས་བྱས་པའི་སྡིག་པ་ཐམས་ཅད་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":18,"content":["དེ་ནས་མཱ་ན་ཤེ་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་གཟིམས་པ་དང་། ཁོའི་ཕོ་བྲང་གི་སྐྱེད་མོས་ཚལ་ཨུ་ཟཱ་ཞེས་པར་དུར་ལ་སྦས་ཤིང་། ཁོའི་བུ་ཨ་མོན་བྱ་བ་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མོན།"]},{"type":"verse","number":19,"content":["དེ་ཡང་ཨ་མོན་གྱིས་རྒྱལ་སྲིད་བཟུང་བའི་དུས་སུ་ཁོ་ལོ་ཉེར་གཉིས་ཡིན་ཏེ། ཁོས་ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་གཉིས་ཀྱི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། དེའི་ཡུམ་མེ་ཤུལ་ལེ་མིད་བྱ་བ་ནི་ཡོག་པཱ་རྡལ་གྱི་ཧ་རུ་ཟིའི་བུ་མོ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཁོས་ཀྱང་རང་གི་ཕ་མཱ་ན་ཤེ་ཡིས་བྱས་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་ཅིང་།"]},{"type":"verse","number":21,"content":["རང་གི་ཕ་འགྲུལ་བའི་ལམ་ཐམས་ཅད་ཀྱི་ནང་དུ་འགྲུལ་ཞིང་། ཁོའི་ཕ་ཡིས་བསྟེན་པའི་ལྷ་སྐུ་རྣམས་ལ་ཞབས་ཕྱི་བསྒྲུབས་ནས་ཕྱག་བཙལ་བ་དང་།"]},{"type":"verse","number":22,"content":["ཁོས་རང་གི་ཡབ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ལམ་དུ་མ་འགྲུལ་ཏོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཨ་མོན་གྱི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཁོ་ལ་ལྐོག་ཇུས་བཤམས་ནས་རྒྱལ་པོ་ཁོ་རང་གི་ཕོ་བྲང་དུ་བསད།"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་། ཡུལ་དེའི་མངའ་འབངས་ཀྱིས་རྒྱལ་པོ་ཨ་མོན་ལ་ལྐོག་ཇུས་ཤོམ་མཁན་ཐམས་ཅད་བསད་པ་དང་། ཁོང་གི་བུ་ཡོ་ཤི་ཡཱ་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་བསྐོས་སོ། །"]},{"type":"verse","number":25,"content":["ཨ་མོན་གྱིས་བྱས་པའི་དོན་གཞན་རྣམས་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":26,"content":["ཁོ་རང་ནི་ཨུ་ཟཱ་ཞེས་པའི་སྐྱེད་ཚལ་ནང་རང་གི་དུར་ཁུང་དུ་སྦས་པ་དང་། ཁོའི་བུ་ཡོ་ཤི་ཡཱ་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/20.json","previousChapterAudioLinks":{},"numberOfVerses":26}