{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":22,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡོ་ཤི་ཡཱ་རྒྱལ་པོར་གྱུར་དུས་སུ་ལོ་བརྒྱད་ཙམ་ཡིན་ཏེ། ཁོས་ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་སོ་གཅིག་གི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། དེའི་ཡུམ་གྱི་མིང་ལ་ཡེ་དི་དཱ་ཟེར་ཞིང་། དེ་ནི་པོ་ཚཱ་ཀད་ཡི་ཨ་ད་ཡཱའི་བུ་མོ་ཡིན།"]},{"type":"verse","number":2,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་པ་དང་། རང་གི་ཡབ་མེས་དཱ་བིད་ཀྱི་ལམ་ཐམས་ཅད་ནང་འགྲུལ་ཞིང་། གཡས་གཡོན་གང་དུའང་མ་གཟུར་ཏོ། །"]},{"type":"heading","content":["ཡོ་ཤི་ཡཱས་མཆོད་ཁང་བསྐྱར་གསོ་བྱས་པ།"]},{"type":"verse","number":3,"content":["དེ་ནས་རྒྱལ་པོ་ཡོ་ཤི་ཡཱས་སྲིད་བསྐྱངས་པའི་ལོ་བཅོ་བརྒྱད་པར། རྒྱལ་པོས་མཱེ་ཤུལ་ལིམ་གྱི་ཚ་བོའམ། ཨ་ཙལ་ཡཱ་ཧོའི་བུ་ཤཱ་ཕན་བྱ་བའི་དྲུང་ཡིག་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་བརྫངས་ནས་དེ་ལ།"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་ཆེན་པོ་ཧིལ་ཀི་ཡཱ་ཡི་དྲུང་དུ་ཡར་སོང་ནས་དེ་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕུལ་བའི་དངུལ་ཏེ་སྒོ་སྲུང་གིས་མི་རྣམས་ལས་བསྡུས་པ་བསྡོམས་རྩིས་རྒྱག་ཏུ་བཅུག་ལ།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལས་དཔོན་གྱི་ལག་ཏུ་ཐོངས་ཤིག ཡང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་གས་ཆག་ཞིག་གསོ་བྱེད་པའི་ལས་བཟོ་རྣམས་ལ་སྟེར་བར་རིགས།"]},{"type":"verse","number":6,"content":["མཆོད་ཁང་གི་གས་ཆག་ཞིག་གསོ་བྱེད་དུ་ལག་ཤེས་པ་རྣམས་དང་། རྩིག་བཟོ་དང་། རྡོ་བཟོ་རྣམས་ཀྱི་ཕྱིར་དང་། གདུང་མ་དང་འཇམ་ཤ་བཏོད་པའི་རྡོ་རྣམས་ཉོ་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":7,"content":["དེ་དག་གི་ལག་ཏུ་གཏད་པའི་དངུལ་གྱི་རྩིས་གྲངས་ལེན་པར་མ་བྱེད་ཅིག གང་ལ་ཞེ་ན། དེ་དག་གིས་བློ་དྲང་པོས་ལས་ཀ་བྱེད་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཧིལ་ཀི་ཡཱས་བཀའ་ཁྲིམས་ཀྱི་མདོ་རྙེད་པ།"]},{"type":"verse","number":8,"content":["དེ་ནས་མཆོད་དཔོན་ཆེན་པོ་ཧིལ་ཀི་ཡཱས་དྲུང་ཡིག་ཤཱ་ཕན་ལ། བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལས་བཀའ་ཁྲིམས་ཀྱི་དཔེ་ཆ་འདི་རྙེད་བྱུང་ཞེས་སྨྲས་ཤིང་། ཧིལ་ཀི་ཡཱས་དཔེ་ཆ་དེ་ཤཱ་ཕན་ལ་སྤྲད་པ་དང་། ཤཱ་ཕན་གྱིས་དེ་བཀླགས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་དྲུང་ཡིག་ཤཱ་ཕན་རྒྱལ་པོའི་དྲུང་དུ་ཡོང་ནས་ཁོ་ལ་གཏམ་རྣམས་ཕྱིར་སྨྲས་ཏེ། མཆོད་ཁང་དུ་ཡོད་པའི་དངུལ་རྣམས་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཚོས་བསྡུས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལས་དཔོན་གྱི་ལག་ཏུ་གཏད་དོ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":10,"content":["དྲུང་ཡིག་ཤཱ་ཕན་གྱིས་ཡང་རྒྱལ་པོ་ལ། མཆོད་དཔོན་ཧིལ་ཀི་ཡཱས་ང་ལ་ཤོག་དྲིལ་ཞིག་གནང་བྱུང་ཞུས་ནས། ཁོས་དེ་ནི་རྒྱལ་པོའི་དྲུང་དུ་བཀླགས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ཡང་རྒྱལ་པོས་བཀའ་ཁྲིམས་ཀྱི་དཔེ་ཆ་ལས་གསུངས་པ་རྣམས་ཐོས་པ་ཙམ་གྱིས། རང་གི་གོས་གཤགས་པ་དང་།"]},{"type":"verse","number":12,"content":["རྒྱལ་པོས་མཆོད་དཔོན་ཧིལ་ཀི་ཡཱ་དང་ཤཱ་ཕན་གྱི་བུ་ཨ་ཧི་ཀམ། མི་ཀཱ་ཡའི་བུ་ཨག་པོར་དང་དྲུང་ཡིག་ཤཱ་ཕན། རྒྱལ་པོའི་ཞབས་ཕྱི་ཨ་སཱ་ཡ་བཅས་ལ་འདི་ལྟར།"]},{"type":"verse","number":13,"content":["ང་དང་མི་ཐམས་ཅད་དང་ཡ་ཧུ་དཱ་ཡོངས་ཀྱི་ཕྱིར་དུ། ཁྱོད་ཅག་སོང་ལ་རྙེད་པའི་དཔེ་ཆ་འདིའི་གསུང་རྣམས་ཀྱི་སྐོར་དཀོན་མཆོག་ཡ་ཝཱེ་ལས་ཐུགས་བརྟག་ཞུས་ཤིག ཅི་ལ་ཟེར་ན། བདག་ཅག་གི་ཕ་མེས་ཀྱིས་རྣ་བ་མ་བླགས་ཏེ། དཔེ་ཆ་འདིར་གསུངས་པ་བཞིན་དུ་མ་བྱས་པའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་བདག་ཅག་གི་སྟེང་དུ་ཐུགས་རབ་ཏུ་ཁྲོས་པ་རེད་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་མཆོད་དཔོན་ཧིལ་ཀི་ཡཱ་དང་། ཨ་ཧི་ཀམ་དང་། ཨག་པོར་དང་ཤཱ་ཕན་དང་ཨ་སཱ་ཡ་བཅས་ནི། གོས་དཔོན་ཡིན་པའི་ཧར་ཧཱ་ཟིའི་བུ་ཐིག་ཝ་ཡི་བུ་ཤལ་ལུམ་གྱི་ཆུང་མ་ལུང་སྟོན་པ་ཧུལ་དཱ་ཞེས་པའི་དྲུང་དུ་སོང་ནས་དེ་ལ་གཏམ་བྱས། དེའི་དུས་སུ་ཁོ་མོ་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་གྲོང་ཁྱེར་ཁག་གཉིས་པའི་ནང་བསྡད་ཡོད་པ་ཡིན།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཁོ་མོས་དེ་དག་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་ངའི་རྩར་མངགས་མཁན་དེ་ལ་འདི་ལྟར་སྦྲོན་ཅིག"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོས་དཔེ་ཆ་དེའི་ནང་བཀླགས་པའི་གསུང་ཐམས་ཅད་བཞིན་དུ། བདག་གིས་གནས་འདི་དང་གནས་འདི་རུ་སྡོད་པ་དག་གི་སྟེང་དུ་ཆག་སྒོ་གཏོང་བར་བྱ་སྟེ།"]},{"type":"verse","number":17,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གིས་བདག་སྤངས་ཏེ་ལྷ་གཞན་དག་ལ་བསང་བཏང་བ་དང་། དེ་དག་གི་ལག་པས་བྱས་ཚད་ཀུན་གྱིས་བདག་ཁྲོ་བར་བྱས་པས། བདག་གི་ཁོང་ཁྲོ་གནས་འདི་རུ་འབར་ཞིང་ཞི་བར་མི་འགྱུར།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནས་ཐུགས་བརྟག་ཞུ་བར་ཁྱོད་ཅག་མངགས་མཁན་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ལ་འདི་ལྟར་ཤོད་ཅིག ཁྱོད་ཀྱིས་ཐོས་པའི་བཀའ་ཡི་སྐོར་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ།"]},{"type":"verse","number":19,"content":["བདག་གིས་གནས་འདི་དང་། གནས་འདིར་སྡོད་པ་རྣམས་སྟོངས་ཤིང་དམོད་པ་འཕོག་མཁན་དུ་འགྱུར་བར་ངེས་སྨྲས་པ་དེ་ཁྱོད་ཀྱིས་ཐོས་ཚེ། ཁྱོད་ཀྱི་སེམས་སྙི་མོར་གྱུར་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་སྙེམས་ཆུང་བྱས་ཤིང་བདག་གི་མདུན་དུ་རང་གི་གོས་གཤགས་ནས་ངུས་པ་ནི་ངས་ཐོས་པ་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ཁྱབ་གནང་ངོ་། །"]},{"type":"verse","number":20,"content":["དེའི་ཕྱིར། ལྟོས་དང་། བདག་གིས་ཁྱོད་ནི་རང་གི་ཕ་མེས་ཀྱི་ཁྲོད་དུ་བསྡུ་བར་བྱ་སྟེ། ཞི་བདེའི་ངང་རང་གི་དུར་ལ་འཇུག་པར་འགྱུར་གྱི། བདག་གིས་གནས་འདིར་འབེབ་པར་བྱ་བའི་ཆག་སྒོ་ཐམས་ཅད་ཁྱོད་ཀྱི་མིག་གིས་མཐོང་བར་མི་འགྱུར་ཞེས་གསུངས་ཞེས་པའི་བཀའ་དེ་ཁོ་ཚོས་རྒྱལ་པོར་བསྐྱལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/21.json","previousChapterAudioLinks":{},"numberOfVerses":20}