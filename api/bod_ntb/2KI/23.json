{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":23,"content":[{"type":"heading","content":["ཡོ་ཤི་ཡཱས་བཏང་བའི་བཅོས་སྒྱུར།"]},{"type":"verse","number":1,"content":["དེ་ནས་རྒྱལ་པོས་བང་ཆེན་མངགས་ཏེ་ཡ་ཧུ་དཱ་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་རྒན་པོ་ཚང་མ་ཁོང་གི་དྲུང་དུ་བསྡུས་སོ། །"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཡར་ཕྱིན་པ་དང་། ཁོང་དང་མཉམ་དུ་ཡ་ཧུ་དཱའི་མི་ཐམས་ཅད་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་གཞིས་སྡོད་པ་ཀུན། མཆོད་དཔོན་དང་ལུང་སྟོན་པ་རྣམས། མི་སྡེའི་མཆོག་དམན་ཐམས་ཅད་དེར་སོང་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་རྙེད་པའི་ཞལ་ཆད་ཀྱི་མདོའི་ནང་གསུངས་པ་ཐམས་ཅད་རྒྱལ་པོས་དེ་དག་གི་རྣ་ལམ་དུ་བཀླགས་སོ། །"]},{"type":"verse","number":3,"content":["ཡང་རྒྱལ་པོ་ཀ་བའི་མདུན་དུ་ལངས་ནས། བློ་གཅིག་སེམས་གཅིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲང་བ་དང་། ཁོང་གི་བཀའ་རྣམས་དང་དཔང་ཡིག སྒྲིག་ཁྲིམས་རྣམས་བསྲུངས་ནས་མདོ་དེའི་ནང་དུ་བཀོད་པའི་ཞལ་ཆད་ཀྱི་གསུང་བཞིན་བསྒྲུབ་པའི་ཕྱིར་དུ། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དམ་བཅའ་བཞག་པ་ལ། མི་ཚང་མ་ཞལ་ཆད་ལ་བརྟེན་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":4,"content":["དེ་ནས་རྒྱལ་པོས་མཆོད་དཔོན་ཆེན་པོ་ཧིལ་ཀི་ཡཱ་དང་། མཆོད་དཔོན་རིམ་པ་གཉིས་པ་རྣམས་དང་སྒོ་སྲུང་རྣམས་ལ། པཱ་ཨལ་དང་ཨ་ཤེ་རཱ། ནམ་མཁའི་སྐར་ཚོགས་བཅས་ཀྱི་དོན་དུ་བཟོས་པའི་ཡོ་བྱད་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནས་ཕྱི་རོལ་ཏུ་འདོན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་ཕྱི་རོལ་གྱི་ཀིད་རོན་ལུང་པའི་ས་ཞིང་དུ་བསྲེག་པར་བསྒོས་ཤིང་། དེའི་ཐལ་བ་ནི་པེད་ཨེལ་དུ་བསྐྱལ་ཏོ། །"]},{"type":"verse","number":5,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་དང་ཡེ་རུ་སཱ་ལེམ་སོ་སོར་བརྩིགས་པའི་མཐོ་གླིང་རྣམས་དང་། ཡེ་རུ་སཱ་ལེམ་མཐའ་འཁོར་དུ་བསང་བཏང་ནས་སྐུ་འདྲ་བསྟེན་མཁན་གྱི་མཆོད་དཔོན་ལ་བསྐོས་པ་རྣམས་དང་། ཡང་པཱ་ཨལ་དང་། ཉི་མ་དང་། ཟླ་བ་དང་། རྒྱུ་སྐར་དང་། ནམ་མཁའི་སྐར་ཚོགས་ཐམས་ཅད་ལ་བསང་གཏོང་མཁན་རྣམས་ཀྱང་ཡོ་ཤི་ཡཱས་མེད་པར་བཟོས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནས་ཨ་ཤེ་རཱ་དེ་ཡེ་རུ་སཱ་ལེམ་ཕྱི་རོལ་གྱི་ཀིད་རོན་གྲོག་ཆུའི་འགྲམ་དུ་ཕྱུང་སྟེ། ཀིད་རོན་དུ་བསྲེགས་ཤིང་བརྫིས་ནས་ཕྱེ་མར་བཏགས་པ་དང་། ཕྱེ་མ་དེ་མི་རྣམས་ཀྱི་དུར་ཁྲོད་དུ་གཏོར་བ་རེད།"]},{"type":"verse","number":7,"content":["ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཡོད་པའི་མཆོད་གཤོམ་གྱི་ཆོས་རྫུ་གཞང་འཚོང་རྣམས་ཀྱི་ཁང་པ་བཤིགས་པ་དང་། དེ་ནི་བུད་མེད་རྣམས་ཀྱིས་ཨ་ཤེ་རཱའི་དོན་དུ་རས་གོས་འཐག་ས་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཁོང་གིས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་ལས་མཆོད་དཔོན་ཐམས་ཅད་བསྡུས་ནས། གེ་བཱ་ནས་པེར་ཤ་བཱ་ཡི་བར་དུ་མཆོད་དཔོན་རྣམས་ཀྱིས་བསང་གཏོང་སའི་མཐོ་གླིང་རྣམས་མི་གཙང་བར་བྱས་པ་དང་། གྲོང་ཁྱེར་གྱི་རྒྱ་སྒོའི་གཡོན་ཕྱོགས་སུ་གྲོང་དཔོན་ཡོ་ཤུ་ཨ་ཡི་སྒོ་འགག་ཏུ་ཡོད་པའི་མཐོ་གླིང་རྣམས་ཀྱང་མར་བཤིགས་སོ། །"]},{"type":"verse","number":9,"content":["དོན་དམ་དུ། མཐོ་གླིང་གི་མཆོད་དཔོན་རྣམས་ནི་ཡེ་རུ་སཱ་ལེམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁྲིའི་དྲུང་དུ་མི་འོངས་ཀྱང་། དེ་དག་གིས་སྤུན་རྣམས་དང་ལྷན་དུ་སྐྱུར་མེད་བག་ལེབ་ཟོས་པ་ཡིན།"]},{"type":"verse","number":10,"content":["མི་སུས་ཀྱང་རང་གི་བུ་དང་བུ་མོ་རྣམས་མོ་ལེག་གི་ཕྱིར་མེ་ནང་དུ་སྦྱིན་སྲེག་མི་གཏོང་བའི་དོན་དུ། ཁོང་གིས་པེན་ཧིན་ནོམ་ལུང་པའི་ཐོ་ཕེད་ཀྱང་མི་གཙང་བར་བྱས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་འཛུལ་སའི་སྒོ་མདུན་དུ། ཉུག་རུམ་པ་ནཱ་ཐན་མེ་ལེག་གི་ར་སྐོར་ནང་གི་གཟིམ་ཆུང་གི་ཉེ་སར་ཡོད་པའི་རྟ་ཡི་སྐུ་འདྲ་རྣམས་ཏེ། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཉི་མ་ལ་ཕུལ་བ་རྣམས་མེད་པར་བྱས་ཤིང་། ཉི་མར་ཕུལ་བའི་ཤིང་རྟ་རྣམས་ཀྱང་མེ་རུ་བསྲེགས་སོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཁོང་གིས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཨ་ཧ་ཟཱ་ཡི་གཟིམ་ཁང་གི་མཁར་སྟེང་དུ་བཟོས་པའི་མཆོད་ཁྲི་དང་། མཱ་ན་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ར་སྐོར་གཉིས་ཀྱི་ནང་བཞེངས་པའི་མཆོད་ཁྲི་རྣམས་རྡུལ་དུ་བརླགས་ཏེ། དེ་དག་གི་ཐལ་བ་ཀིད་རོན་གྲོག་ཆུའི་ནང་དུ་བཏབ།"]},{"type":"verse","number":13,"content":["ཡང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཤར་ཕྱོགས་དང་། ཞིག་རལ་དུ་གྱུར་པའི་རི་བོའི་ལྷོ་ཕྱོགས་སུ་ཡོད་པའི་མཐོ་གླིང་རྣམས་ཏེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཚི་ཏུན་པའི་སྐྱུག་བྲོ་བའི་ཨ་ཤཱ་ཏ་རོད་དང་། མོ་ཨབ་པའི་སྐྱུག་བྲོ་བའི་ཀེ་མོ་སི་དང་། ཨམ་མོན་པའི་སྐྱུག་བྲོ་བའི་མིལ་ཀོམ་བཅས་ཀྱི་ཕྱིར་བཞེངས་པའི་མཐོ་གླིང་རྣམས་རྒྱལ་པོས་མི་གཙང་བར་བྱས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཡང་ཁོང་གིས་རྡོ་སྐུ་རྣམས་དུམ་བུར་བཅགས་པ་དང་ཨ་ཤེ་རཱ་རྣམས་སོ་སོར་བཅད་ཅིང་། ཡུལ་དེར་མི་ཤི་རོའི་རུས་པས་བཀང་བར་བྱས་སོ། །"]},{"type":"verse","number":15,"content":["དེར་མ་ཟད། ཐ་ན་པེད་ཨེལ་གྱི་མཆོད་ཁྲི་དང་ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱིས་བརྩིགས་པའི་མཐོ་གླིང་མར་བཤིགས་ནས་མེ་རུ་བསྲེགས་པ་དང་། འཐག་ནས་རྡུལ་དུ་བརླགས་ཤིང་། ཨ་ཤེ་རཱ་ཡང་མེ་རུ་བསྲེགས་སོ། །"]},{"type":"verse","number":16,"content":["དེར་ཡོ་ཤི་ཡཱ་ཕྱིར་འཁོར་བ་ན། རི་ལ་ཡོད་པའི་དུར་ཁུང་རྣམས་མཐོང་བ་དང་། དུར་ཁུང་དེ་དག་ལས་རུས་པ་འདོན་དུ་བཅུག་སྟེ། སྔར་དཀོན་མཆོག་གི་སྐྱེས་བུས་ཁྱབ་བསྒྲགས་བྱས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་བཞིན་དུ། རུས་པ་རྣམས་མཆོད་ཁྲིའི་སྟེང་དུ་བསྲེགས་ནས་མཆོད་ཁྲི་མི་གཙང་བར་བྱས།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཡོ་ཤི་ཡཱ་ཡིས། ངས་མཐོང་བའི་རྡོ་རིང་དེ་ཅི་ཡིན་ཞེས་དྲིས་པ་ན། ལན་དུ་གྲོང་ཁྱེར་གྱི་མི་ཚོས། འདི་ནི་སྔར་ཡ་ཧུ་དཱ་ནས་ཐོན་ཏེ། ཁྱེད་ཀྱིས་པེད་ཨེལ་གྱི་མཆོད་ཁྲི་ལ་མཛད་པའི་དོན་འདི་དག་གསལ་བསྒྲགས་བྱས་པའི་དཀོན་མཆོག་གི་སྐྱེས་བུའི་དུར་ས་དེ་རེད་ཞུས་པས།"]},{"type":"verse","number":18,"content":["ཁོང་གིས། དེ་བསྐྱུར་དང་། སུ་ལའང་ཁོའི་རུས་པར་རེག་ཏུ་མ་འཇུག་ཅེས་བསྒོས་པར། མི་རྣམས་ཀྱིས་དེའི་གདུང་རུས་དང་སཱ་མར་ཡ་ནས་ཐོན་པའི་ལུང་སྟོན་པ་དེའི་གདུང་རུས་ལ་མ་རེག་གོ །"]},{"type":"verse","number":19,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་སཱ་མར་ཡའི་གྲོང་ཁྱེར་རྣམས་སུ་བརྩིགས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་བསླངས་པའི་མཐོ་གླིང་གི་ལྷ་ཁང་ཐམས་ཅད་ཡོ་ཤི་ཡཱས་བརླགས་ནས། པེད་ཨེལ་དུ་བྱས་པ་བཞིན་དུ་དེ་དག་ལའང་དེ་ལྟར་བྱས།"]},{"type":"verse","number":20,"content":["དེར་ཡོད་པའི་མཐོ་གླིང་རྣམས་ཀྱི་མཆོད་དཔོན་ཀུན་མཆོད་ཁྲིའི་ཁར་སྦྱིན་སྲེག་བཏང་ཞིང་། དེའི་སྟེང་དུ་མི་ཡི་རུས་པ་བསྲེགས་པ་དང་། དེ་ནས་ཁོ་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིར་ལོག་གོ །"]},{"type":"heading","content":["ཡོ་ཤི་ཡཱས་པེ་སག་གི་དུས་ཆེན་བསྐྱར་དུ་བཙུགས་པ།"]},{"type":"verse","number":21,"content":["དེ་ནས་རྒྱལ་པོས་འབངས་རྣམས་ལ་བཀའ་བསྩལ་ཏེ་འདི་སྐད་དུ། ཞལ་ཆད་ཀྱི་མདོ་འདིའི་ནང་དུ་བཀོད་པ་བཞིན་དུ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་པེ་སག་གི་དུས་ཆེན་སྲུངས་ཤིག་ཅེས་བསྒོས།"]},{"type":"verse","number":22,"content":["ཡེས་ར་ཨེལ་གྱི་ཁྲིམས་ཐག་གཅོད་པའི་ཁྲིམས་དཔོན་རྣམས་ཀྱི་དུས་ནས་བཟུང་སྟེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་དུས་སྐབས་བར་དུ། འདི་འདྲའི་པེ་སག་གི་དུས་ཆེན་ཞིག་ནམ་ཡང་སྲུང་བ་མེད་དོ། །"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་། རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་ཡིས་སྲིད་བཟུང་བའི་ལོ་བཅོ་བརྒྱད་པར་ཡེ་རུ་སཱ་ལེམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་པེ་སག་གི་དུས་ཆེན་འདི་བསྲུངས་པ་རེད།"]},{"type":"verse","number":24,"content":["དེར་མ་ཟད། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་དུ་ཡོད་པའི་གདོན་འདྲེ་འགུག་མཁན་དང་མོ་འདེབས་མཁན། ལྷ་སྐུ། འདྲ་སྐུ། དེ་མིན་སྐྱུག་བྲོ་བ་ཐམས་ཅད་ནི་ཡོ་ཤི་ཡཱས་མེད་པར་བཟོས། ཅིའི་ཕྱིར་ཞེ་ན། མཆོད་དཔོན་ཧིལ་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་རྙེད་པའི་མདོ་ནང་བཀོད་པའི་བཀའ་ཁྲིམས་ཀྱི་གསུང་རྣམས་བསྒྲུབ་པའི་ཕྱིར་དུའོ། །"]},{"type":"verse","number":25,"content":["ཡང་ཁོང་དང་འདྲ་བར་མོ་ཤེའི་བཀའ་ཁྲིམས་ཐམས་ཅད་དང་བསྟུན་ཏེ། རང་གི་སེམས་ཧྲིལ་པོ་དང་ཡིད་ཧྲིལ་པོ། སྟོབས་ཧྲིལ་པོ་བཅས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་མཁན་གྱི་རྒྱལ་པོ་ཞིག་སྔར་མ་བྱུང་ལ། ཕྱིས་སུ་ཡང་ཁོང་ལྟ་བུ་ཞིག་མ་ཐོན་ནོ། །"]},{"type":"verse","number":26,"content":["འོན་ཀྱང་མཱ་ན་ཤེ་ཡིས་ངན་པ་སྣ་ཚོགས་སྤྱད་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་བསླངས་པའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཧུ་དཱའི་སྟེང་དུ་འབར་བའི་ཐུགས་ཁྲོ་ཆེན་པོ་ཕྱིར་མ་སློག་པ་དང་།"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་ཡེས་ར་ཨེལ་དོར་བ་ལྟར། ཡ་ཧུ་དཱ་ཡང་ངའི་མདུན་ནས་འདོར་ཞིང་། བདག་གིས་བདམས་པའི་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་འདི་དང་། ངའི་མཚན་དེ་རུ་འཇོག་པར་བྱ་གསུངས་པའི་མཆོད་ཁང་འདིའང་འདོར་བར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡོ་ཤི་ཡཱ་གཡུལ་ནས་ཤི་བ།"]},{"type":"verse","number":28,"content":["དེ་ཡང་ཡོ་ཤི་ཡཱ་ཡི་དོན་གཞན་དག་དང་། ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":29,"content":["ཡོ་ཤི་ཡཱ་ཡི་སྐུ་རིང་དུ་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་ནེ་ཀོ་བྱ་བ་དེ་ཕི་རཱད་ཆུ་བོའི་ཕྱོགས་སུ་ཨ་སུར་གྱི་རྒྱལ་པོ་དང་འཕྲད་དུ་སོང་བ་དང་། རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་ནི་ཁོ་དང་འཐབ་ཏུ་ཕྱིན་པ་ན། ཕཱར་ཨོལ་གྱིས་ཁོ་མཐོང་བ་ཙམ་གྱིས་མེ་གིད་དོ་རུ་བསད་དོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ཁོའི་འཁོར་རྣམས་ཀྱིས་སྤུར་ཤིང་རྟའི་ནང་དུ་བཞག་སྟེ་མེ་གིད་དོ་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་དྲངས་ཤིང་། དེ་ཁོ་རང་གི་སྤུར་ཁང་དུ་དུར་ལ་སྦས་སོ། །དེ་ནས་འབངས་རྣམས་ཀྱིས་ཡོ་ཤི་ཡཱའི་བུ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་ཕྱུང་ནས་སྣུམ་གྱིས་བྱུགས་ཏེ་ཁོའི་ཡབ་ཀྱི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་བསྐོས་སོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་བཙོན་དུ་བཅུག་པ།"]},{"type":"verse","number":31,"content":["དེ་ཡང་ཡེ་ཧོ་ཨ་ཧཱ་ཟི་རྒྱལ་ཁྲིར་བཞུགས་པའི་དུས་སུ་ལོ་ཉེར་གསུམ་ཡིན་པ་དང་ཡེ་རུ་སཱ་ལེམ་དུ་ཟླ་བ་གསུམ་གྱི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ཁོའི་ཡུམ་ནི་ལིབ་ནཱ་ནས་ཡིན་པའི་ཡེ་རེམ་ཡཱའི་བུ་མོ་ཧ་མུ་ཏལ་བྱ་བ་ཡིན་ནོ། །"]},{"type":"verse","number":32,"content":["ཁོས་རང་གི་ཡབ་མེས་རྣམས་ཀྱིས་སྤྱད་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"verse","number":33,"content":["ཕཱར་ཨོལ་ནེ་ཀོ་ཡིས་ཧ་མཱད་ཡུལ་དུ་ཡོད་པའི་རིབ་ལཱ་རུ་ཁོ་བཙོན་དུ་བཅུག་པ་དང་། ཁོས་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་སྲིད་སྐྱོང་མི་ཐུབ་པར་བྱས། ཡང་ཡ་ཧུ་དཱ་ལ་དངུལ་རྡོ་ཚད་བརྒྱ་དང་གསེར་རྡོ་ཚད་གཅིག་གི་ཆད་པ་བཅད་དོ། །"]},{"type":"verse","number":34,"content":["ཡང་ཕཱར་ཨོལ་ནེ་ཀོ་ཡིས་ཡོ་ཤི་ཡཱའི་བུ་ཨེལ་ཡ་ཀིམ་ནི་ཁོའི་ཡབ་ཡོ་ཤི་ཡཱའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་བཀོད་ཅིང་། ཁོའི་མིང་བརྗེས་ནས་ཡེ་ཧོ་ཡཱ་ཀིམ་ཞེས་བཏགས། ཡེ་ཧོ་ཨ་ཧཱ་ཟི་བཟུང་ནས་ཨེ་ཅིབ་ཏུ་ཁྲིད་ཅིང་ཁོ་རང་དེར་ཚེ་ལས་འདས།"]},{"type":"verse","number":35,"content":["ཡེ་ཧོ་ཡཱ་ཀིམ་གྱིས་ཕཱར་ཨོལ་ལ་གསེར་དངུལ་བསྐྱལ་ཏེ། ཕཱར་ཨོལ་གྱི་བཀའ་བཞིན་དུ་དངུལ་སྤྲོད་པར་རྒྱལ་ཁམས་ཡོངས་ནས་དཔྱ་ཁྲལ་བསྡུས་ཤིང་། ཕཱར་ཨོལ་ནེ་ཀོ་ལ་སྤྲོད་པའི་ཆེད་དུ་འབངས་མི་རེ་རེར་འཕོག་པ་བཞིན་དུ་གསེར་དང་དངུལ་བླངས་སོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིམ།"]},{"type":"verse","number":36,"content":["དེ་ཡང་ཡེ་ཧོ་ཡཱ་ཀིམ་རྒྱལ་ཁྲིར་བཞུགས་པའི་དུས་སུ་ལོ་ཉེར་ལྔ་ཡིན་ཏེ། ལོ་བཅུ་གཅིག་གི་རིང་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་སྲིད་བསྐྱངས། རུ་མཱ་པ་ཕེ་ད་ཡཱའི་བུ་མོ་ཟེ་བི་དཱ་བྱ་བ་ནི་ཁོའི་ཡུམ་མོ། །"]},{"type":"verse","number":37,"content":["ཁོས་ཀྱང་རང་གི་ཡབ་མེས་རྣམས་ཀྱིས་སྤྱད་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/22.json","previousChapterAudioLinks":{},"numberOfVerses":37}