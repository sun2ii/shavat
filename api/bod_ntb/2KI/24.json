{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["དེ་ཡང་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་དུས་སུ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ཡར་འོངས་ཏེ། ཡེ་ཧོ་ཡཱ་ཀིམ་ལོ་གསུམ་གྱི་རིང་ལ་ཁོའི་མངའ་འོག་ཏུ་བཅུག དེ་ནས་ཁོས་དེ་ལ་ངོ་ལོག་བྱས།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཞབས་ཕྱི་ལུང་སྟོན་པ་རྣམས་བརྒྱུད་ནས་གསུངས་པ་བཞིན་དུ། ཁོང་གིས་ཡ་ཧུ་དཱ་པ་རྣམས་ཚར་གཅོད་བྱེད་ཆེད། ཀལ་དི་པའི་དམག་དཔུང་དང་ཨ་རམ་པའི་དམག་དཔུང་དང་། མོ་ཨབ་པའི་དམག་དཔུང་དང་། ཨམ་མོན་པའི་དམག་དཔུང་རྣམས་ཡ་ཧུ་དཱ་རུ་མངགས་སོ། །"]},{"type":"verse","number":3,"content":["དོན་དམ་དུ་མཱ་ན་ཤེ་ཡིས་བྱས་པའི་སྡིག་ཉེས་ཐམས་ཅད་ཀྱི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ། ཁོང་གི་སྤྱན་སྔ་ནས་དེ་རྣམས་འདོར་བའི་ཕྱིར་ཡ་ཧུ་དཱའི་སྟེང་དུ་དེ་ལྟར་བྱུང་བར་མ་ཟད།"]},{"type":"verse","number":4,"content":["ཡང་མཱ་ན་ཤེས་ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་དུ་བཅུག་སྟེ། ཡེ་རུ་སཱ་ལེམ་ཉེས་མེད་ཀྱི་ཁྲག་གིས་བསྐངས་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེ་དེ་བཤགས་པར་ཐུགས་མ་དགྱེས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ཡང་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་དོན་གཞན་དང་། ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་ནི་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":6,"content":["ཡེ་ཧོ་ཡཱ་ཀིམ་རང་གི་ཕ་མེས་དང་ལྷན་ཅིག་ཏུ་གཟིམས་པ་དང་། ཁོའི་བུ་ཡེ་ཧོ་ཡཱ་ཀིན་ནི་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་ཨེ་ཅིབ་ཆུ་བོ་ནས་ཕི་རཱད་ཆུ་བོའི་བར་དུ། ཨེ་ཅིབ་རྒྱལ་པོ་ལ་གཏོགས་པ་ཐམས་ཅད་བླངས་པས། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་རང་གི་ཡུལ་ནས་ཡང་བསྐྱར་ཕྱི་རོལ་ཏུ་མ་ཡོང་ངོ་། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིན།"]},{"type":"verse","number":8,"content":["དེ་ཡང་ཡེ་ཧོ་ཡཱ་ཀིན་གྱིས་རྒྱལ་སྲིད་བཟུང་དུས་ཁོ་ལོ་བཅོ་བརྒྱད་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ཟླ་བ་གསུམ་གྱི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ཡེ་རུ་སཱ་ལེམ་གྱི་ཨེལ་ནཱ་ཐན་གྱི་བུ་མོ་ནེ་ཧོ་ཤུ་ཐཱ་བྱ་བ་ནི་ཁོའི་ཡུམ་མོ། །"]},{"type":"verse","number":9,"content":["ཁོས་ཀྱང་རང་གི་ཡབ་མེས་ཀྱིས་གང་སྤྱད་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་བདག་ཏུ་བཟུང་བ།"]},{"type":"verse","number":10,"content":["དེའི་ཚེ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་འཁོར་གཡོག་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡར་སོང་སྟེ་གྲོང་ཁྱེར་དམག་གིས་བསྐོར་བ་དང་།"]},{"type":"verse","number":11,"content":["ནེ་བོ་ཀད་ནེ་ཙར་གྱི་འཁོར་གཡོག་རྣམས་ཀྱིས་གྲོང་ཁྱེར་སྐོར་བའི་དུས་སུ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་དངོས་སུ་གྲོང་ཁྱེར་དེར་འོངས།"]},{"type":"verse","number":12,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིན་དང་ཁོའི་ཡུམ། འཁོར་གཡོག་རྣམས། སྐུ་དྲག་རྣམས། ཉུག་རུམ་པ་བཅས་ཐོན་ནས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་མགོ་བཏགས་པས། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་སྲིད་བྱས་པའི་ལོ་བརྒྱད་པར་ཁོ་འཛིན་བཟུང་བྱས་ཤིང་།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་བཞིན་དུ། ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་། རྒྱལ་པོའི་ཕོ་བྲང་གི་གཏེར་ཐམས་ཅད་བཏོན་ཏེ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་དོན་དུ་བཟོས་པའི་གསེར་གྱི་ཡོ་བྱད་ཐམས་ཅད་དུམ་བུར་བཅག་པ་དང་།"]},{"type":"verse","number":14,"content":["ཡང་ཁོས་ཡེ་རུ་སཱ་ལེམ་པ་ཚང་མ་དང་། སྐུ་དྲག་ཐམས་ཅད་དང་། དམག་གི་དཔའ་བོ་མཐའ་དག་དང་བཅས་བསྡོམས་པས་མི་སྟོང་ཕྲག་བཅུ་དང་། དེར་མ་ཟད་ལས་བཟོ་དང་མགར་བ་ཐམས་ཅད་བཙན་ཁྲིད་བྱས་ཤིང་། ཡུལ་གྱི་དབུལ་ཕོངས་རྣམས་མ་གཏོགས་དེར་སུ་ཡང་ལུས་སུ་མ་བཅུག་གོ །"]},{"type":"verse","number":15,"content":["ཡང་ཁོས་ཡེ་ཧོ་ཡཱ་ཀིན་དང་། རྒྱལ་པོའི་ཡུམ་དང་རྒྱལ་པོའི་ལྕམ་རྣམས། ཉུག་རུམ་པ་རྣམས་དང་ཡུལ་གྱི་སྐུ་དྲག་རྣམས་ཡེ་རུ་སཱ་ལེམ་ནས་པཱ་པེལ་ལོན་དུ་བཙན་ཁྲིད་བྱས།"]},{"type":"verse","number":16,"content":["དེར་མ་ཟད་དམག་མི་སྟོང་ཕྲག་བདུན་དང་། ལས་བཟོ་དང་མགར་པ་སྟོང་ཕྲག་གཅིག་བཅས་ཡོད་པ་ཐམས་ཅད་དམག་འགྱེད་ཀྱི་དཔའ་རྒོད་ཡིན་ལ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་དེ་རྣམས་བཟུང་ནས་པཱ་པེལ་ལོན་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་ཡེ་ཧོ་ཡཱ་ཀིན་གྱི་ཁུ་བོ་མད་ཐན་ཡཱ་ནི་ཁོའི་ཚབ་ཏུ་རྒྱལ་པོར་བསྐོས་ཤིང་མིང་བརྗེས་ནས་ཚིད་ཀི་ཡཱ་ཞེས་བཏགས་སོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ།"]},{"type":"verse","number":18,"content":["དེ་ཡང་ཚིད་ཀི་ཡཱ་རྒྱལ་པོར་བཞུགས་དུས་ལོ་ཉེར་གཅིག་ལ་སོན་ཡོད་དེ། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་བཅུ་གཅིག་གི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས། ལིབ་ནཱ་པ་ཡེ་རེམ་ཡཱའི་བུ་མོ་ཧ་མུ་ཏལ་བྱ་བ་ནི་ཁོའི་ཡུམ་མོ། །"]},{"type":"verse","number":19,"content":["ཁོས་ཀྱང་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱིས་གང་སྤྱད་པ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད།"]},{"type":"verse","number":20,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དང་ཡ་ཧུ་དཱ་ལ་ཐུགས་ཁྲོས་ཤིང་། ཁོང་གིས་དེ་དག་ཁོང་གི་དྲུང་ནས་ཕར་བསྐྲད་པ་དང་། ཕྱིས་སུ་ཚིད་ཀི་ཡཱ་ཡིས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ལ་ངོ་ལོག་བྱས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/23.json","previousChapterAudioLinks":{},"numberOfVerses":20}