{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":25,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱ་འཛིན་བཟུང་བྱས་ཤིང་གཞན་དུ་སྤྱུགས་པ།"]},{"type":"verse","number":1,"content":["ཡང་ཟཱ་ཏི་ཁི་ཡཱས་རྒྱལ་སྲིད་བཟུང་ནས་ལོ་དགུ་པའི་ཟླ་བ་བཅུ་པའི་ཚེས་བཅུ་ཉིན། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ནི་རང་གི་དམག་དཔུང་དང་བཅས་ཡེ་རུ་སཱ་ལེམ་ལ་འོངས་པ་དང་། མཁར་ཕྱི་རུ་དམག་སྒར་བརྒྱབ་ཅིང་ས་རགས་བརྩིགས་ནས་མཐའ་བསྐོར་ཏོ། །"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་ཚིད་ཀི་ཡཱའི་སྲིད་ལོ་བཅུ་གཅིག་པའི་བར་དུ་གྲོང་ཁྱེར་དམག་གིས་བསྐོར།"]},{"type":"verse","number":3,"content":["ཟླ་བཞི་པའི་ཚེས་དགུ་ཉིན་གྲོང་ཁྱེར་ནང་དུ་མུ་གེ་བྱུང་བ་ཤིན་ཏུ་ཚབས་ཆེ་ཞིང་། ཐ་ན་ཡུལ་མི་རྣམས་ལ་ཁ་ཟས་ཀྱང་མེད་པར་གྱུར།"]},{"type":"verse","number":4,"content":["དེ་ནས་གྲོང་ཁྱེར་གཏོར་བཅོམ་བཏང་སྟེ། དམག་མི་ཐམས་ཅད་རྒྱལ་པོའི་ལྡུམ་རའི་མདུན་དུ་ཡོད་པའི་ལྕགས་རི་གཉིས་བར་གྱི་རྒྱ་སྒོའི་ལམ་ནས་བྲོས། འོན་ཀྱང་། ཀལ་དི་པ་རྣམས་ཀྱིས་གྲོང་ཁྱེར་བསྐོར་ཡོད་པས། ཁོ་ཚོ་ཨ་ར་པཱའི་ལམ་ནས་སོང་ངོ་། །"]},{"type":"verse","number":5,"content":["དེར་ཀལ་དི་པའི་དམག་དཔུང་གིས་རྒྱལ་པོ་བདས་ནས་ཡེ་རུ་ཀོའི་ཐང་ནས་བཟུང་བ་དང་། ཁོའི་དམག་མི་ཐམས་ཅད་ཁོ་ལས་ཕྱོགས་སུ་གྱེས་པ་རེད།"]},{"type":"verse","number":6,"content":["ཀལ་དི་པའི་དམག་དཔུང་གིས་རྒྱལ་པོ་བཟུང་ནས་པཱ་པེལ་ལོན་རྒྱལ་པོའི་དྲུང་དུ་རིབ་ལཱ་རུ་ཡར་འགྲོ་རུ་བཅུག་ནས་དེ་རྣམས་ཀྱིས་ཁོ་ལ་ཁྲིམས་ཐག་བཅད།"]},{"type":"verse","number":7,"content":["ཡང་ཚིད་ཀི་ཡཱའི་བུ་རྣམས་ཡབ་ཀྱི་མིག་མདུན་དུ་བསད་ཅིང་། ཚིད་ཀི་ཡཱའི་མིག་གཉིས་ལོང་བར་བྱས་ཏེ་ལི་ཡི་ཐག་པས་བཅིངས་ནས་པཱ་པེལ་ལོན་དུ་ཁྱེར་ཏོ། །"]},{"type":"verse","number":8,"content":["དེ་ཡང་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་རྒྱལ་སྲིད་བཟུང་བའི་ལོ་བཅུ་དགུ་པའི་ཟླ་ལྔ་པའི་ཚེས་བདུན་ཉིན། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་བློན་ཆེན་ཏེ་སྐུ་སྲུང་དཔོན་པོ་ནེ་བོ་ཟར་ཨ་དན་བྱ་བ་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས་པ་དང་།"]},{"type":"verse","number":9,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་། རྒྱལ་པོའི་ཕོ་བྲང་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་ཁང་པ་ཐམས་ཅད་དང་ཁང་བརྩེགས་ཐམས་ཅད་མེར་བསྲེགས་ཤིང་།"]},{"type":"verse","number":10,"content":["སྐུ་སྲུང་དཔོན་པོ་དང་མཉམ་དུ་ཡོད་པའི་ཀལ་དི་པའི་དམག་དཔུང་ཀུན་གྱིས་ཡེ་རུ་སཱ་ལེམ་གྱི་མཐའ་བཞི་བསྐོར་བའི་ལྕགས་རི་རྣམས་བརླགས་སོ། །"]},{"type":"verse","number":11,"content":["གྲོང་ཁྱེར་གྱི་ནང་དུ་ལུས་པའི་མི་རྣམས་དང་པཱ་པེལ་ལོན་རྒྱལ་པོར་མགོ་བཏགས་པ་རྣམས། དེ་མིན་ཡུལ་མི་ལྷག་ལུས་དང་བཅས་པ་སྐུ་སྲུང་དཔོན་པོ་ནེ་བོ་ཟར་ཨ་དན་གྱིས་བཙན་ཁྲིད་བྱས།"]},{"type":"verse","number":12,"content":["ཡིན་ནའང་སྐུ་སྲུང་དམག་དཔོན་གྱིས་ཡུལ་དེའི་དབུལ་པོ་དབུལ་རྐྱང་རྣམས་བསྐྱུར་ནས། དེ་རྣམས་ལ་རྒུན་འབྲུམ་ར་བ་ལེགས་བཅོས་བྱེད་པ་དང་ཞིང་རྨོ་རུ་བཅུག"]},{"type":"verse","number":13,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཡོད་པའི་ལི་ཡི་ཀ་བ་རྣམས་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་ཡོད་པའི་སྟེགས་བུ་རྣམས། ལི་ཡི་རྒྱ་མཚོ་ཞེས་པའི་འཁྲུད་གཞོང་བཅས་ནི་ཀལ་དི་པས་དུམ་བུར་བཅག་ནས་ལི་རྣམས་པཱ་པེལ་ལོན་དུ་ཁྱེར།"]},{"type":"verse","number":14,"content":["དེར་ཡོད་པའི་སྣོད་དང་། མེ་ཁྱེམ། ཅེམ་ཙེ། སྡེར་མ་བཅས་དེར་བསྙེན་བཀུར་འབུལ་བྱའི་ལི་ཡི་མཆོད་ཆས་ཐམས་ཅད་ཁྱེར་ཞིང་།"]},{"type":"verse","number":15,"content":["མེ་ཕོར་དང་གཞོང་པ་ནི་གསེར་དངུལ་གང་ཡིན་ཐམས་ཅད་སྐུ་སྲུང་དཔོན་པོས་ཁྱེར་ཏོ། །"]},{"type":"verse","number":16,"content":["སོ་ལོ་མོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་དོན་དུ་བཟོས་པའི་ཀ་བ་གཉིས་དང་། རྒྱ་མཚོ་ཞེས་པའི་འཁྲུད་གཞོང་གཅིག་དང་ཁྲི་རྣམས། ལི་ཡི་ཡོ་བྱད་ཐམས་ཅད་རིན་ཐང་གཞལ་དུ་མེད་པའོ། །"]},{"type":"verse","number":17,"content":["ཀ་བ་གཅིག་གི་མཐོ་ཚད་ལ་ཁྲུ་བཅོ་བརྒྱད་དང་། དེའི་སྟེང་དུ་ཡོད་པའི་ཀ་གཞུ་ཡང་ལི་ཡིན་ཏེ། ཀ་གཞུ་དེའི་མཐོ་ཚད་ལ་ཁྲུ་གསུམ་ཡོད་པ་ཡིན། ཀ་གཞུ་དེའི་དཀྱིལ་འཁོར་དུ་ཡོད་པའི་དྲ་བ་དྲ་ཕྱེད་དང་སེ་འབྲུ་ཀུན་ཡང་ལི་ཡིས་བཟོས་ཡོད། ཀ་བ་གཉིས་པ་ལ་ཡང་དེ་འདྲའི་དྲ་བ་དྲ་ཕྱེད་ཡོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["སྐུ་སྲུང་དམག་དཔོན་གྱིས་མཆོད་དཔོན་ཆེན་པོ་སེ་ར་ཡཱ་དང་། མཆོད་དཔོན་གཉིས་པ་ཟེ་ཕན་ཡཱ་དང་། སྒོ་སྲུང་མི་གསུམ་བཅས་བཙན་ཁྲིད་བྱས།"]},{"type":"verse","number":19,"content":["ཡང་གྲོང་ཁྱེར་ནས་དམག་མིའི་བཀོད་འདོམས་པ་ཞིག་དང་། གྲོང་ཁྱེར་དུ་རྒྱལ་པོའི་སློབ་སྟོན་པ་མི་ལྔ་དང་། ཡུལ་མིའི་དམག་དཔོན་གྱི་དྲུང་ཡིག་པ་རྣམས་དང་། དེ་མིན་གྲོང་ཁྱེར་ནང་རྙེད་པའི་མི་རྣམས་ལས་སྐྱེས་པ་དྲུག་ཅུ་བཅས་བཙན་ཁྲིད་བྱས།"]},{"type":"verse","number":20,"content":["སྐུ་སྲུང་དམག་དཔོན་ནེ་བོ་ཟར་ཨ་དན་གྱིས་དེ་དག་བཟུང་ནས་རིབ་ལཱ་རུ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་དྲུང་དུ་ཁྲིད།"]},{"type":"verse","number":21,"content":["ཧ་མཱད་ཡུལ་གྱི་རིབ་ལཱ་བྱ་བར་པཱ་པེལ་ལོན་རྒྱལ་པོས་དེ་དག་ལ་བསྣུན་ནས་བསད་པ་དང་། དེ་ལྟར་ཡ་ཧུ་དཱ་པ་རྣམས་རང་གི་ཡུལ་ནས་བཙན་གྱིས་གཞན་དུ་བཏང་ངོ་། །"]},{"type":"heading","content":["གེ་དལ་ཡཱ་ནི་ཡ་ཧུ་དཱའི་སྤྱི་དཔོན་དུ་བསྐོས་པ།"]},{"type":"verse","number":22,"content":["ཡ་ཧུ་དཱའི་ཡུལ་དུ་ལུས་པའི་མི་རྣམས་ཏེ་པཱ་པེལ་ལོན་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་བསྐྱུར་བ་རྣམས་ལ། པཱ་པེལ་ལོན་རྒྱལ་པོས་ཤཱ་ཕན་གྱི་ཚ་བོའམ་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱ་བྱ་བ་སྤྱི་དཔོན་དུ་བསྐོས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་དམག་དཔོན་ཐམས་ཅད་དང་དེ་དག་གི་དམག་མི་དག་གིས་པཱ་པེལ་ལོན་རྒྱལ་པོས་གེ་དལ་ཡཱ་སྤྱི་དཔོན་དུ་བསྐོ་མངགས་བྱས་པ་ཐོས་རྗེས་སུ། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་དང་། ཀཱ་རེ་ཨའི་བུ་ཡོ་ཧ་ནན་དང་། ནེ་ཏོ་ཕཱ་པ་ཐན་ཧུ་མེད་ཀྱི་བུ་སེ་ར་ཡཱ་དང་། མ་ཨ་ཀཱ་པའི་བུ་ཡ་ཨ་ཟན་ཡཱ་བཅས་རང་གི་དམག་མི་རྣམས་དང་མཉམ་དུ་མཱས་ཟི་ཕཱ་རུ་གེ་དལ་ཡཱའི་དྲུང་དུ་འོངས་པ་དང་།"]},{"type":"verse","number":24,"content":["གེ་དལ་ཡཱས་དེ་དག་དང་དེ་དག་གི་དམག་མི་རྣམས་ལ་མནའ་བསྐྱལ་ནས་འདི་ལྟར། ཀལ་དི་པའི་ཞབས་ཕྱི་བྱེད་པར་མ་སྐྲག་ཅིག ཡུལ་འདིར་བསྡད་ནས་པཱ་པེལ་ལོན་རྒྱལ་པོར་ཞབས་ཕྱི་བསྒྲུབས་ན་ཁྱོད་ཅག་ལེགས་པར་འགྱུར་འོང་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":25,"content":["འོན་ཀྱང་། ཟླ་བདུན་པར་རྒྱལ་རྒྱུད་ཡིན་པ་ཨེ་ལི་ཤཱ་མའི་ཚ་བོའམ་ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་མི་བཅུ་ཁྲིད་འོངས་ཏེ། གེ་དལ་ཡཱ་དང་། མཱས་ཟི་ཕཱ་རུ་ཁོའི་དྲུང་དུ་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་དང་ཀལ་དི་པ་རྣམས་ལ་བསྣུན་ནས་བསད།"]},{"type":"verse","number":26,"content":["དེ་ནས་མི་ཆེ་ཆུང་ཀུན་དང་དམག་དཔོན་རྣམས་ཀལ་དི་པ་ལ་འཇིགས་པར་གྱུར་པས། དེ་དག་ལངས་ནས་ཨེ་ཅིབ་ཡུལ་དུ་བྲོས་སོ། །"]},{"type":"heading","content":["ཡེ་ཧོ་ཡཱ་ཀིན་བཙོན་གྲོལ་བཏང་བ།"]},{"type":"verse","number":27,"content":["དེ་ཡང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིན་བཙན་ཁྲིད་བྱས་ནས་ལོ་སོ་བདུན་པའི་ཟླ་བ་བཅུ་གཉིས་པའི་ཚེས་ཉེར་བདུན་ཉིན་ལ། པཱ་པེལ་ལོན་རྒྱལ་པོ་ཨེ་ཝིལ་མེ་རོ་དག་གིས་རྒྱལ་སྲིད་བཟུང་བའི་ལོ་དང་པོར། ཁོས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིན་བཙོན་ལས་ཕྱུང་སྟེ་གོ་ས་ཆེན་པོ་གནང་བ་དང་།"]},{"type":"verse","number":28,"content":["ཡང་ཁོ་ལ་བརྩེ་བའི་གཏམ་སྨྲས་ཤིང་། ཁོའི་གོ་ས་ནི་ཁོང་དང་མཉམ་དུ་པཱ་པེལ་ལོན་དུ་ཡོད་པའི་རྒྱལ་པོ་རྣམས་ལས་མཐོ་བར་བྱས་པ་དང་།"]},{"type":"verse","number":29,"content":["ཡང་ཡེ་ཧོ་ཡཱ་ཀིན་གྱི་བཙོན་གྱི་གོས་རྣམས་བརྗེས་ཏེ། ཁོ་རང་ལ་ཚེ་གང་པོར་ཉིན་རེ་བཞིན་རྒྱལ་པོའི་དྲུང་དུ་ཁ་ཟས་སྤྱོད་དུ་བཅུག"]},{"type":"verse","number":30,"content":["ཡང་ཁོའི་ཚེ་གང་པོར་ཉིན་རེའི་དགོས་མཁོ་ལྟར་རྒྱལ་པོས་ཆད་མེད་དུ་ཁོ་ལ་གནང་བའོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1CH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/24.json","previousChapterAudioLinks":{},"numberOfVerses":30}