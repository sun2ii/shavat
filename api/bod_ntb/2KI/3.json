{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":3,"content":[{"type":"heading","content":["མོ་ཨབ་པས་ཡེས་ར་ཨེལ་ལ་ངོ་ལོག་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ཀྱིས་སྲིད་བསྐྱངས་པའི་ལོ་བཅོ་བརྒྱད་པར། ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་བྱ་བ་སཱ་མར་ཡ་རུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་གྱུར་ནས་ལོ་བཅུ་གཉིས་ཀྱི་རིང་དུ་རྒྱལ་སྲིད་བསྐྱངས་སོ། །"]},{"type":"verse","number":2,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་ཀྱང་། རང་གི་ཕ་མས་ཅི་བྱས་པའི་ཚད་དེ་འདྲར་མ་སླེབས་པ་སྟེ། རང་གི་ཕ་ཡིས་བཟོས་པའི་པཱ་ཨལ་གྱི་ལྷ་རྟེན་དེ་ཁོས་དོར་བར་བྱས་སོ། །"]},{"type":"verse","number":3,"content":["འོན་ཀྱང་ཡེས་ར་ཨེལ་ལ་སྡིག་པ་བྱེད་དུ་བཅུག་པའི་ནེ་བཱད་ཀྱི་བུ་ཡེ་རོབ་ཨམ་གྱི་སྡིག་པ་ལ་འབྱར་ཏེ།",{"noteId":2},"དེ་དང་བྲལ་བར་མ་གྱུར་ཏོ། །"]},{"type":"verse","number":4,"content":["ཡང་མོ་ཨབ་ཀྱི་རྒྱལ་པོ་མེ་ཤཱ་ནི་ལུག་འཚོ་བའི་ཕྱུགས་བདག་ཅིག་ཡིན་ཏེ། ཁོས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ་ལུ་གུ་འབུམ་གཅིག་དང་། ལུག་ཐུག་འབུམ་གཅིག་བལ་དང་བཅས་པ་འབུལ་བཞིན་ཡོད་པ་ལ།"]},{"type":"verse","number":5,"content":["ཨ་ཧབ་ཚེ་ལས་འདས་རྗེས། མོ་ཨབ་པའི་རྒྱལ་པོས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་ངོ་ལོག་བྱས་སོ། །"]},{"type":"verse","number":6,"content":["ཉིན་དེ་ཉིད་དུ་རྒྱལ་པོ་ཡོ་རཱམ་ནི་སཱ་མར་ཡ་ནས་ཐོན་ཏེ། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་བསྡུས་ཤིང་དམག་བསྐྱོད་བྱས་པ་དང་།"]},{"type":"verse","number":7,"content":["ཁོ་འགྲོ་ཞོར་དུ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ལ་ངག་འཕྲིན་བསྐུར་བ་འདི་ལྟ་སྟེ། མོ་ཨབ་པའི་རྒྱལ་པོས་ང་ལ་ངོ་ལོག་བྱས་པས། ཁྱོད་བདག་དང་མཉམ་དུ་མོ་ཨབ་ལ་འཐབ་པར་འགྲོའམ་ཞེས་པར། ཡེ་ཧོ་ཤ་ཕད་ན་རེ། ང་ནི་ཡར་འགྲོ་བར་བྱའོ། །ཁྱོད་དང་ང་གཉིས་གཅིག་ཡིན་ཏེ། ངའི་འབངས་ཀྱང་ཁྱེད་ཀྱི་འབངས་དང་འདྲ་ཞིང་། ངའི་རྟ་རྣམས་ཀྱང་ཁྱེད་ཀྱི་རྟ་དང་འདྲ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཡེ་ཧོ་ཤ་ཕད་ཀྱིས། ངེད་ཅག་ལམ་གང་ནས་ཡར་འགྲོའམ་ཞེས་དྲིས་པར། ཡོ་རཱམ་གྱིས། ཨེ་དོམ་ཡུལ་གྱི་ས་སྟོང་བརྒྱུད་ནས་འགྲོ་བར་བྱ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོ། ཨེ་དོམ་གྱི་རྒྱལ་པོ་གསུམ་མཉམ་དུ་ཐོན་ཏེ། ཉིན་བདུན་གྱི་རིང་ལ་སྐོར་བསྐྱོད་བྱས་པས་དམག་དཔུང་དང་དེའི་རྗེས་སུ་འབྲངས་པའི་སྒོ་ཕྱུགས་རྣམས་ལ་ཆུ་མེད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས། ཀྱེ་མ། དོན་དངོས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་རྒྱལ་པོ་གསུམ་པོ་མོ་ཨབ་པའི་ལག་ཏུ་གཏད་པར་ཞལ་གསུང་གནང་བ་ལགས་སོ་ཞེས་སྨྲས་པར།"]},{"type":"verse","number":11,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས། འདིར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བཀའ་འདྲི་ཞུ་བར་དཀོན་མཆོག་ཡ་ཝཱེའི་ལུང་སྟོན་པ་ཡོད་པ་མིན་ནམ་ཞེས་པ་ན། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་འཁོར་གྱི་ནང་ནས་གཅིག་གིས། ཤ་ཕད་ཀྱི་བུ་ཨེ་ལི་ཤཱ་སྟེ། ཨེ་ལི་ཡཱའི་ལག་པར་ཆུ་ལྡུག་མཁན་དེ་འདི་རུ་འདུག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":12,"content":["ཡེ་ཧོ་ཤ་ཕད་ཀྱིས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཁོང་དང་ལྷན་དུ་བཞུགས་ཞེས་སྨྲས་པ་ན། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དང་ཡེ་ཧོ་ཤ་ཕད། ཨེ་དོམ་གྱི་རྒྱལ་པོ་བཅས་པ་མར་ཁོང་གི་དྲུང་དུ་ཕྱིན་ཏོ། །"]},{"type":"verse","number":13,"content":["ཨེ་ལི་ཤཱས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། ང་དང་ཁྱོད་གཉིས་ལ་འབྲེལ་བ་ཅི་ཡོད། ཁྱོད་ཀྱི་ཕ་དང་མ་ཡི་ལུང་སྟོན་པ་རྣམས་ཀྱི་གམ་དུ་སོང་ཞིག་གསུངས་པ་ན། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས། དེ་ལྟར་མི་གསུང་བར་འཚལ། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ཅག་རྒྱལ་པོ་གསུམ་མོ་ཨབ་པའི་ལག་ཏུ་གཏད་པར་ཞལ་གསུང་གནང་ཡོད་ཅེས་ཞུས་ཤིང་།"]},{"type":"verse","number":14,"content":["ཨེ་ལི་ཤཱ་ཡིས། ངས་རང་གིས་ཞབས་ཕྱི་སྒྲུབ་པའི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་གཏན་དུ་གསོན་པོར་བཞུགས་པ་ཁོང་ཉིད་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། གལ་སྲིད་ངས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ཀྱི་ཞལ་ངོར་བལྟས་པ་མིན་ན། ངས་ཁྱོད་ལ་ཁ་ཡ་བྱེད་པ་ལྟ་ཞོག མིག་གིས་ཀྱང་མི་བལྟ།"]},{"type":"verse","number":15,"content":["ད་ནི་རོལ་མོ་དཀྲོལ་མཁན་ཞིག་ངའི་གམ་དུ་ཁྲིད་ཤོག་ཅེས་བསྒོས་པ་དང་། རོལ་མོ་དཀྲོལ་མཁན་དེས་རོལ་མོ་དཀྲོལ་སྐབས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ཁོང་གི་སྟེང་ལ་བབས་པ་དང་།"]},{"type":"verse","number":16,"content":["ཁོང་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོས་ལུང་པ་འདིའི་གང་སར་རྫིང་བུ་བསྐྱིལ་ཏེ་འོབས་དོང་གཤག་དགོས།"]},{"type":"verse","number":17,"content":["གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ཁྱོད་ཀྱིས་རླུང་གཡུག་པ་མི་མཐོང་ལ། ཆར་འབབ་པའང་མི་མཐོང་མོད། འོན་ཀྱང་ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་ཁལ་མ་དང་སྒོ་ཕྱུགས་རྣམས་ལ་འཐུང་ཆུ་ཡོད་པའི་ཕྱིར་ལུང་པ་དེ་ཆུས་ཁེངས་ངེས་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དོན་ཆུང་ཆུང་ཞིག་སྟེ། ཁོང་གིས་མོ་ཨབ་པ་རྣམས་ཀྱང་ཁྱོད་ཅག་གི་ལག་ཏུ་གཏོད་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཚོས་གྲོང་ཁྱེར་བརྟན་པོའི་མཁར་སྒོ་དང་། གྲོང་ཁྱེར་ཡག་པོ་ཐམས་ཅད་གཏོར་བར་བྱ་ཞིང་། ལྗོན་ཤིང་ལྟ་ན་སྡུག་པ་ཐམས་ཅད་གཅོད་པ་དང་། ཆུ་མིག་ཐམས་ཅད་བཀག་ནས་ས་ཞིང་ཡག་པོ་ཐམས་ཅད་རྡོ་སྤུང་རྒྱག་པར་བྱའོ་ཞེས་སྦྲན།"]},{"type":"verse","number":20,"content":["དེའི་ཕྱི་ཉིན་ཞོགས་པར་སྦྱིན་སྲེག་གི་མཆོད་པ་འབུལ་དུས་སུ། ལྟོས་དང་། ཨེ་དོམ་གྱི་ཕྱོགས་ནས་ཆུ་འོངས་ཏེ་ཡུལ་དེ་ནི་ཆུས་ཁེངས་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":21,"content":["དེ་ནས་མོ་ཨབ་པ་ཀུན་གྱིས་རྒྱལ་པོ་དེ་དག་ཁོ་ཚོ་དང་དམག་འཁྲུག་རྒྱག་ཏུ་ཡར་འོངས་པ་ཐོས་པས། ཁྲབ་རྨོག་གྱོན་ཐུབ་པ་རྒན་གཞོན་གང་ཡིན་ཡང་ཐམས་ཅད་བོས་ནས་ས་མཚམས་སུ་ལངས་པ་དང་།"]},{"type":"verse","number":22,"content":["དེའི་ཕྱི་ཉིན་ཞོགས་པར་ཁོ་ཚོ་ཡར་ལངས་དུས། ཉི་མའི་འོད་མདངས་ཆུ་ལ་ཕོག་པ་ན། མོ་ཨབ་པ་རྣམས་ཀྱིས་ཕ་རོལ་ནས་ཆུ་ནི་ཁྲག་ལྟར་དམར་པོ་ཡིན་པ་མཐོང་བས།"]},{"type":"verse","number":23,"content":["ཁོ་ཚོས་འདི་ནི་ཁྲག་ཡིན་ཏེ། རྒྱལ་པོ་དེ་རྣམས་ཀྱིས་ནང་འཁྲུག་བརྒྱབ་ནས་ཕན་ཚུན་གསོད་རེས་བྱས་པ་རེད། ཀྱེ་མོ་ཨབ་པ་རྣམས། ད་ནི་འཕྲོག་བཅོམ་བྱེད་དུ་འགྲོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":24,"content":["དེ་རྣམས་ཡེས་ར་ཨེལ་གྱི་དམག་སྒར་དུ་ཕྱིན་པའི་ཚེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཡར་ལངས་ཏེ་མོ་ཨབ་པ་རྣམས་བསད་པས། མོ་ཨབ་པ་རྣམས་ཁོ་ཚོའི་མདུན་ནས་བྲོས། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཁོ་ཚོར་རྒོལ་ཏེ་བསད་དོ། །"]},{"type":"verse","number":25,"content":["དེ་དག་གིས་གྲོང་ཁྱེར་རྣམས་བརླགས་ཤིང་། མི་རེས་ས་ཞིང་ཡག་པོ་ཐམས་ཅད་ལ་རྡོ་འཕངས་པ་དང་ས་ཞིང་རྡོ་ཡིས་བཀང་བར་བྱས། ཡང་ཆུ་མིག་ཐམས་ཅད་བཀག་སྟེ་ལྗོན་ཤིང་ལྟ་ན་སྡུག་པ་ཐམས་ཅད་བཅད། ཀིར་ཧ་རེ་ཤེད་འབའ་ཞིག་གི་རྡོ་ལྷག་ཀྱང་དམག་མི་འུར་རྡོ་ཐོགས་པ་རྣམས་ཀྱིས་དེ་ཡང་མཐའ་ནས་བསྐོར་ཏེ་རྒོལ་བ་རེད།"]},{"type":"verse","number":26,"content":["དེ་ནས་མོ་ཨབ་ཀྱི་རྒྱལ་པོས་དམག་འཐབ་ཛ་དྲག་ཡིན་པ་མཐོང་བས། ཨེ་དོམ་གྱི་རྒྱལ་པོའི་ཕྱོགས་སུ་འཕྲལ་རྒོལ་བྱེད་པར་རལ་གྲི་ཐོགས་པའི་མི་བདུན་བརྒྱ་ཁོ་དང་མཉམ་དུ་ཁྲིད་ཀྱང་ཁོ་ཚོས་ཐུབ་པ་མ་བྱུང་།"]},{"type":"verse","number":27,"content":["དེ་ནས་ཁོས་རང་གི་རྗེས་སུ་རྒྱལ་པོར་བསྐོ་རྒྱུ་ཡིན་པའི་སྲས་ཐོག་མ་དེ་ལྕགས་རིའི་སྟེང་དུ་སྦྱིན་སྲེག་གི་མཆོད་པར་ཕུལ་བས། ཡེས་ར་ཨེལ་ལ་ཁོང་ཁྲོ་དྲག་པོ་བྱུང་སྟེ་ཁོ་དང་བྲལ་ནས་ཕྱིར་རང་ཡུལ་དུ་ལོག་གོ །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ཡེ་རོབ་ཨམ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཐོག་མ་དེ་ཡིན། ཁོས་གསེར་གྱི་བ་ཕྲུག་གཉིས་ཀྱི་སྐུ་བརྙན་བཞེངས་པ་ལ་བརྟེན་ནས། མི་རྣམས་ལ་སྐུ་བརྙན་དེ་ཚོར་ཕྱག་འཚལ་དུ་བཅུག","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/2KI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/2.json","previousChapterAudioLinks":{},"numberOfVerses":27}