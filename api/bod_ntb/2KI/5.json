{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":5,"content":[{"type":"heading","content":["ནཱ་ཨ་མན་གྱི་མཛེ་ནད་བཅོས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨ་རམ་རྒྱལ་པོའི་དམག་དཔོན་ནཱ་ཨ་མན་ནི། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་བརྒྱུད་ནས་ཨ་རམ་ལ་རྒྱལ་ཁ་གནང་བས། རང་གི་བདག་པོའི་མདུན་དུ་མི་རླབས་ཆེན་ཞིག་ཡིན་ལ་རྩིས་མཐོང་ཆེན་པོ་ཐོབ་བོ། །མི་དེ་དཔའ་བོ་སྟོབས་ཆེན་ཞིག་ཡིན་ཡང་ཁོ་ལ་མཛེ་ནད་བྱུང་ཡོད།"]},{"type":"verse","number":2,"content":["དེ་སྔར་ཨ་རམ་པ་རྣམས་སོང་ནས་དཔུང་འཇུག་འཕྲོག་བཅོམ་བྱས་ཏེ། ཡེས་ར་ཨེལ་གྱི་ཡུལ་ནས་བུ་མོ་ཆུང་ཆུང་ཞིག་བཟུང་འོངས་པ་དང་། ཁོ་མོས་ནཱ་ཨ་མན་གྱི་ཆུང་མར་ཞབས་ཕྱི་བསྒྲུབས་པ་རེད།"]},{"type":"verse","number":3,"content":["ཁོ་མོས་རང་གི་བདག་མོ་ལ། ང་ཡི་བདག་པོ་འདི་སཱ་མར་ཡ་རུ་བཞུགས་པའི་ལུང་སྟོན་པ་དེའི་དྲུང་དུ་ཕེབས་ན། ཁོང་གིས་ཁོའི་མཛེ་ནད་གསོ་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":4,"content":["དེ་ནས་ནཱ་ཨ་མན་སོང་ནས་རང་གི་བདག་པོ་ལ། ཡེས་ར་ཨེལ་གྱི་བུ་མོ་དེས་འདི་འདྲ་འདི་འདྲ་ཟེར་གྱི་འདུག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":5,"content":["ཨ་རམ་གྱི་རྒྱལ་པོས་དེ་ལ། ཁྱོད་རང་སོང་ཞིག ངས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ་འཕྲིན་ཡིག་ཅིག་སྤྲིང་བར་བྱ་ཞེས་སྨྲས་ཤིང་། ཁོས་དངུལ་རྡོ་ཚད་བཅུ་དང་། གསེར་སྲང་སྟོང་དྲུག་དང་གོས་ཁ་ཚང་བཅུ་བཅས་ལག་ཏུ་ཁྱེར་ནས་ཆས་སོ། །"]},{"type":"verse","number":6,"content":["ཁོས་འཕྲིན་ཡིག་དེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་དྲུང་དུ་བསྐྱལ་བ་དང་། དེའི་ནང་དུ། ད་ལྟ་འཕྲིན་ཡིག་འདི་ཁྱེད་ལ་འཕྲོད་པའི་ཚེ། གཟིགས་དང་། ངའི་ཞབས་ཕྱི་ནཱ་ཨ་མན་གྱི་མཛེ་ནད་གསོ་བའི་ཕྱིར་ཁྱེད་ཀྱི་དྲུང་དུ་མངགས་པ་ཡིན་ཞེས་བྲིས་ཡོད་དོ། །"]},{"type":"verse","number":7,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་འཕྲིན་ཡིག་དེ་བཀླགས་རྗེས། རང་གི་གོས་གཤགས་ཏེ་འདི་ལྟར། མི་འདིས་མི་ཞིག་གི་མཛེ་ནད་གསོ་བའི་ཕྱིར་ངའི་གམ་དུ་མངགས་པས། ང་ནི་སྲོག་ལེན་པ་དང་སྲོག་སྦྱིན་པའི་དཀོན་མཆོག་ཡིན་ནམ། ཁྱོད་ཚོས་བསམ་བློ་ཐོངས་དང་། ཁོས་ང་ལ་རྒོལ་བའི་གླགས་འཚོལ་བ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཨེ་ལི་ཤཱས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་རང་གི་གོས་གཤགས་པ་ཐོས་ནས་མི་མངགས་ཏེ་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ན་བཟའ་གཤགས་པ་ཅི་ཡིན། མི་དེ་ངའི་རྩར་འོང་དུ་ཆུག་དང་། དེ་ནས་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་ལུང་སྟོན་པ་ཞིག་ཡོད་པ་ཁོས་རྟོགས་པར་འགྱུར་ཞེས་འཕྲིན་བསྐུར་བ་དང་།"]},{"type":"verse","number":9,"content":["ནཱ་ཨ་མན་ཁོའི་རྟ་རྣམས་དང་། ཁོའི་ཤིང་རྟ་རྣམས་བཅས་འོངས་ནས་ཨེ་ལི་ཤཱའི་ཁང་པའི་སྒོ་ཁར་བསྡད་ཅིང་།"]},{"type":"verse","number":10,"content":["ཨེ་ལི་ཤཱས་བང་ཆེན་མངགས་ནས་ཁོ་ལ། ཁྱོད་རང་སོང་ནས་ཡོར་དན་གཙང་པོའི་ནང་དུ་ཐེངས་བདུན་ལ་ཁྲུས་ཤིག དེ་ནས་ཁྱོད་ཀྱི་ལུས་སྔར་མུས་ལྟར་འགྱུར་ཞིང་གཙང་མར་འགྱུར་ངེས་ཞེས་གསུངས་ནའང་།"]},{"type":"verse","number":11,"content":["ནཱ་ཨ་མན་ཁྲོས་ནས་སོང་སྟེ། ལྟོས་དང་། བདག་གིས་ཁོང་ཕྱི་རུ་ཐོན་ནས་ལངས་བསྡད་དེ་ཁོང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་ལ་ཞུས་ཏེ། རྨ་ནད་ཡོད་སར་ཕྱག་གཡུག་ནས་མཛེ་ནད་གསོ་བར་བསམ་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ཡེས་ར་ཨེལ་གྱི་ཆུ་ཐམས་ཅད་ལས་ཀྱང་དཱ་མེ་སེག་གི་ཨི་ཨ་བ་ནཱ་དང་ཕར་ཕར་གཙང་པོ་གཉིས་ནི་ལྷག་ཏུ་མི་ལེགས་སམ། ང་རང་དེ་དག་གི་ནང་དུ་བཀྲུས་ན་གཙང་མར་མི་འགྱུར་རམ་ཞེས་སྨྲས་ནས། ཕྱིར་འཁོར་ནས་ཁོང་ཁྲོ་དང་བཅས་ཆས་སོ། །"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་ཁོའི་ཞབས་ཕྱི་རྣམས་འོངས་ནས་ཁོ་ལ། ཀྱེ་ངའི་ཡབ་ཆེན་ལགས། ཅི་སྟེ་ལུང་སྟོན་པས་ཁྱེད་ལ་དོན་ཆེན་ཞིག་བྱེད་པར་བསྒོས་ན་དེ་བཞིན་དུ་མི་མཛད་དམ། ད་ནི་ཁོང་གིས་ཁྱེད་ལ་ཁྲུས་བྱོས་དང་གཙང་མར་འགྱུར་ངེས་གསུངས་ན་ལྟ་ཅི་སྨོས་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཁོ་མར་སོང་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་བསྒོས་པ་བཞིན། ཡོར་དན་གཙང་པོའི་ནང་དུ་ལན་བདུན་སྦངས་པས། ཁོའི་ལུས་ནི་བྱིས་པའི་ལུས་ལྟར་གཙང་མར་གྱུར་ཏོ། །"]},{"type":"heading","content":["གེ་ཧ་ཟིའི་བརྣབ་སེམས་དང་ཉེས་ཆད།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཁོ་དང་ཞབས་ཕྱི་འཁོར་དང་བཅས་པ་དཀོན་མཆོག་གི་སྐྱེས་བུའི་མདུན་དུ་ཕྱིར་ལོག་ཅིང་ཁོང་གི་དྲུང་དུ་ལངས་བསྡད་དེ། གཟིགས་དང་། ས་གཞི་ཐམས་ཅད་དུ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་མ་གཏོགས་མི་བཞུགས་པ་དེ་ནི་ད་ལྟ་ངས་ཤེས་བྱུང་བས། ད་ལྟ་ཁྱེད་ཀྱིས་ཞབས་ཕྱི་བདག་གི་ཕྱག་རྟེན་འདི་བཞེས་སུ་གསོལ་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":16,"content":["ཨེ་ལི་ཤཱས་ལན་དུ། བདག་གིས་རང་གིས་ཞབས་ཕྱི་སྒྲུབ་བཞིན་པ་དང་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཏེ། ངས་ཕྱག་རྟེན་ཅི་ཡང་ལེན་པར་མི་བྱ་གསུངས་པ་དང་། ནཱ་ཨ་མན་གྱིས་ལེན་དགོས་པར་ནན་གྱིས་ཞུས་ཀྱང་ཁོང་གིས་མ་བླངས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་ནཱ་ཨ་མན་གྱིས། ཁྱེད་ཀྱིས་ཞབས་ཕྱི་བདག་ལ་དྲེལ་གཉིས་ཀྱིས་ཐེག་པའི་ས་རྡུལ་གནང་བར་མཛོད། ཁྱེད་ཀྱི་ཞབས་ཕྱི་བདག་གིས་ད་ཕྱིན་ཆད་དཀོན་མཆོག་ཡ་ཝཱེ་འབའ་ཞིག་མ་གཏོགས་ལྷ་གཞན་ལ་སྦྱིན་སྲེག་དང་མཆོད་པ་འབུལ་བར་མི་བྱ།"]},{"type":"verse","number":18,"content":["འོན་ཀྱང་། དོན་འདི་ལ་ཁྱེད་ཀྱི་ཞབས་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་དགོངས་དག་གནང་བར་མཛོད། ངའི་བདག་པོ་ནི་རིམ་མཱོན་ལྷ་ཁང་དུ་སོང་སྟེ་ཕྱག་འཚལ་བའི་ཕྱིར། ངའི་ལག་པས་བསྐྱོར་ནས་ཁོས་ཕྱག་འཚལ་བ་ཡིན་པས། བདག་གིས་ཀྱང་རིམ་མཱོན་གྱི་ལྷ་ཁང་དུ་ཕྱག་འཚལ་བ་ཡིན། སྐབས་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ཀྱི་ཞབས་ཕྱིའི་དོན་འདིར་དགོངས་དག་གནང་བར་མཛོད་ཅེས་ཞུས་པས།"]},{"type":"verse","number":19,"content":["ཨེ་ལི་ཤཱས་དེ་ལ། ཞི་བདེའི་ངང་སོང་ཞིག་ཅེས་སྨྲས་པ་ན། ནཱ་ཨ་མན་ཁོང་དང་བྲལ་ཏེ་ལམ་ཐག་ཅུང་ཙམ་ཏུ་ཕྱིན་ཏོ། །"]},{"type":"verse","number":20,"content":["དེའི་ཚེ་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཨེ་ལི་ཤཱའི་ཞབས་ཕྱི་གེ་ཧ་ཟིས། ཀྱེ་ཧོ། ཨ་རམ་པ་ནཱ་ཨ་མན་གྱིས་ཅི་ཞིག་ཁྱེར་འོངས་པ་དེ་ངའི་བདག་པོས་མ་བླངས་ནའང་། བདག་གིས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཏེ། ང་ནི་ཁོའི་རྗེས་སུ་རྒྱུགས་ནས་གང་ཞིག་ལེན་པར་བྱ་དགོས་སམ་ཞེས་སྨྲས།"]},{"type":"verse","number":21,"content":["དེ་ནས་གེ་ཧ་ཟི་མྱུར་དུ་ནཱ་ཨ་མན་གྱི་རྗེས་སུ་འབྲངས་པ་དང་། ནཱ་ཨ་མན་གྱིས་མི་ཞིག་རྒྱབ་ཕྱོགས་ནས་རྒྱུགས་འོང་བ་མཐོང་སྟེ། དེ་བསུ་བའི་ཕྱིར་ཤིང་རྟ་ལས་བབས་ཤིང་ཐམས་ཅད་བདེའམ་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":22,"content":["ཁོས་ལན་དུ། བདེའོ། །ངའི་བདག་པོས་ང་རང་བརྫངས་ཏེ་ཁྱེད་ལ། ལྟོས་དང་། ད་ལྟ་ལུང་སྟོན་པའི་སློབ་བུ་རྣམས་ལས་གཞོན་ནུ་གཉིས་ཨེ་ཕཱར་ཡིམ་གྱི་རི་ནས་ངའི་རྩར་སླེབས་པས། དེ་དག་གི་ཕྱིར་དངུལ་རྡོ་ཚད་གཅིག་དང་གོས་ཁ་ཚང་གཉིས་སྦྱིན་པར་མཛོད་ཅིག་ཅེས་གསུངས་སོ་ཞུས་པས།"]},{"type":"verse","number":23,"content":["ནཱ་ཨ་མན་གྱིས། རྡོ་ཚད་གཉིས་ཁྱེར་ཞིག་ཅེས་ཁོ་ལ་ནན་བསྐུལ་བྱས་པ་དང་། དངུལ་རྡོ་ཚད་གཉིས་ཁུག་མ་གཉིས་ཀྱི་ནང་དུ་བཅུག་ཅིང་། གོས་ཁ་ཚང་གཉིས་ཀྱང་ཞབས་ཕྱི་གཉིས་ཀྱི་ལག་ཏུ་སྤྲད་པ་དང་། དེ་དག་གིས་ཁྱེར་ནས་གེ་ཧ་ཟིའི་མདུན་དུ་སོང་།"]},{"type":"verse","number":24,"content":["རི་ཁར་སླེབས་པའི་ཚེ། ཁོས་དེ་དག་གི་ལག་ནས་དངོས་པོ་བླངས་ཏེ་ཁྱིམ་ནང་དུ་བཞག་རྗེས། དེ་གཉིས་འགྲོ་རུ་བཅུག་པས་ཕྱིན་ཏོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་ཁོ་སོང་སྟེ་རང་གི་བདག་པོའི་དྲུང་དུ་ལངས་བསྡད་པ་ལ། ཨེ་ལི་ཤཱས་ཁོ་ལ། གེ་ཧ་ཟི། ཁྱོད་རང་གང་ནས་ཡོང་ངམ་ཞེས་དྲིས་པའི་ལན་དུ། ཁོས་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ནི་གང་དུའང་མ་སོང་ཞུས་པས།"]},{"type":"verse","number":26,"content":["ཨེ་ལི་ཤཱས་དེ་ལ། མི་དེ་རང་གི་ཤིང་རྟ་ལས་བབས་ཏེ་ཚུར་འཁོར་ནས་ཁྱོད་རང་བསུ་བའི་དུས་སུ། ངའི་སེམས་ཉིད་ནི་ཁྱོད་དང་མཉམ་དུ་མ་སོང་ངམ། ད་ལྟའི་དུས་འདི་ནི་དངུལ་དང་གོས། སྐྱུ་རུ་རའི་ཚལ་དང་རྒུན་ཚལ། ལུག་དང་གླང་། ཞབས་ཕྱི་དང་ཞལ་ཏ་མ་རྣམས་ལེན་པའི་དུས་ཤིག་ཡིན་ནམ།"]},{"type":"verse","number":27,"content":["དེའི་ཕྱིར། ནཱ་ཨ་མན་གྱི་མཛེ་ནད་དེ་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྒྱུད་རྣམས་ལ་འབྱར་ནས་ཇི་སྲིད་བར་དུ་ལུས་པར་འགྱུར་རོ་ཞེས་གསུངས་པས། གེ་ཧ་ཟི་ཁོ་རང་ཨེ་ལི་ཤཱ་དང་བྲལ་ནས་འགྲོ་བའི་དུས་སུ་མཛེ་ནད་བྱུང་ཞིང་ཁ་བ་ལྟར་དཀར་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2KI/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}