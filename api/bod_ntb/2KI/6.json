{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":6,"content":[{"type":"heading","content":["སྟ་རེའི་མགོ་ཆུ་ཁར་གཡེང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ལུང་སྟོན་པ་རྣམས་ཀྱི་སློབ་བུ་དག་གིས་ཨེ་ལི་ཤཱ་ལ། གཟིགས་དང་། ཁྱེད་དང་བཅས་པའི་འོ་སྐོལ་གྱི་གཞིས་ཀ་དེ་རང་ཅག་ལ་མཚོན་ན་ཁོད་ཆུང་བས།"]},{"type":"verse","number":2,"content":["ཡོར་དན་གཙང་པོར་སོང་སྟེ། མི་རེ་རེས་གདུང་མ་རེ་ཕབ་ནས་གནས་དེར་གཞིས་ཀ་བྱེད་པའི་དགོངས་པ་གནང་རོགས་ཞེས་ཞུས་པ་ན། ཨེ་ལི་ཤཱས་ཁོ་ཚོར་སོང་ཞེས་ལན་བཏབ་བོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་སློབ་བུ་ཞིག་ན་རེ། ཁྱེད་ཀྱང་ཞབས་ཕྱི་རྣམས་དང་ལྷན་དུ་ཕེབས་པར་མཛོད་ཅེས་ཞུས་པར། ཨེ་ལི་ཤཱས་ང་འགྲོ་བར་བྱ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":4,"content":["ཁོང་དེ་དག་དང་ལྷན་དུ་ཕྱིན་ཏེ་ཡོར་དན་གཙང་པོར་སླེབས་ནས་སྡོང་པོ་བཅད།"]},{"type":"verse","number":5,"content":["སློབ་བུ་ཞིག་གིས་གདུང་མ་གཅོད་སྐབས་སྟ་རེའི་མགོ་ཆུའི་ནང་དུ་ལྷུང་ཞིང་། དེས་སྐད་ཆེན་པོས་ཀྱེ་ཧུད་ང་ཡི་བདག་པོ། སྟ་རེ་དེ་ནི་གཡར་མ་ཡིན་ཞེས་འུར་བརྒྱབ་པས།"]},{"type":"verse","number":6,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་གང་དུ་ལྷུང་ངམ་ཞེས་དྲིས་པ་ན། སློབ་བུ་དེས་སྟ་རེའི་མགོ་ལྷུང་སའི་གནས་དེ་བསྟན་ཅིང་། ཨེ་ལི་ཤཱས་ཤིང་ཕྲན་ཞིག་བཅད་ནས་དེའི་ནང་དུ་བསྐྱུར་མ་ཐག་སྟ་རེའི་མགོ་ཆུ་ཁར་གཡེང་པ་རེད།"]},{"type":"verse","number":7,"content":["ཨེ་ལི་ཤཱས་ཁྱོད་རང་གིས་ཡར་ལོངས་ཤིག་ཅེས་གསུངས་པས། མི་དེས་ལག་པ་བརྐྱངས་ནས་སྟ་རེའི་མགོ་ཡར་བླངས་སོ། །"]},{"type":"heading","content":["མེ་རྟ་དང་ཤིང་རྟ།"]},{"type":"verse","number":8,"content":["ཡང་ཨ་རམ་གྱི་རྒྱལ་པོས་ཡེས་ར་ཨེལ་ལ་དམག་དྲངས་ཤིང་། རང་གི་འཁོར་གཡོག་རྣམས་དང་གྲོས་བཏབ་སྟེ་ན་རེ། ངས་གནས་ཆེ་གེ་མོར་དམག་སྒར་རྒྱག་པར་བྱ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་མི་མངགས་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ། དོགས་ཟོན་གྱིས་ཤིག ཨ་རམ་པའི་དམག་ཡུལ་དེ་རུ་མར་འབབ་བཞིན་ཡོད་པས། དེ་བརྒྱུད་ནས་མ་འགྲོ་ཞེས་ངག་འཕྲིན་བསྐུར་ཏོ། །"]},{"type":"verse","number":10,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་དཀོན་མཆོག་གི་སྐྱེས་བུས་ཁོང་ལ་ཉེན་བརྡ་བཏང་ནས་སྨྲས་པའི་གནས་དེར་མི་མངགས་པ་དང་། ཐེངས་གཅིག་གཉིས་ཙམ་མིན་པར་གནས་དེ་ཉེན་སྲུང་བརྒྱབ་བོ། །"]},{"type":"verse","number":11,"content":["དོན་དེའི་དབང་གིས། ཨ་རམ་གྱི་རྒྱལ་པོའི་སེམས་ཤིན་ཏུ་འཁྲུགས་ནས་རང་གི་འཁོར་གཡོག་རྣམས་བོས་ཤིང་དེ་དག་ལ་འདི་ལྟར། ངེད་ཅག་གི་ཁྲོད་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོའི་ཕྱོགས་ཡ་དེ་སུ་ཡིན་པ་ང་ལ་མི་སྨྲའམ་ཞེས་སྨྲས་པའི་ལན་དུ།"]},{"type":"verse","number":12,"content":["ཁོའི་འཁོར་གཡོག་ཅིག་གིས། ཀྱེ་ངའི་ཇོ་བོ་ངའི་རྒྱལ་པོ་ལགས། དེ་བཞིན་མ་ཡིན། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་གཟིམ་ཁང་ནང་དུ་གླེང་བ་དེ། ཡེས་ར་ཨེལ་དུ་ཡོད་པའི་ལུང་སྟོན་པ་ཨེ་ལི་ཤཱས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལ་འཆད་དོ་ཞུས་པས།"]},{"type":"verse","number":13,"content":["ཁོ་ན་རེ། ཁྱོད་ཅག་སོང་ལ་ཁོ་གང་དུ་འདུག་པར་ལྟོས་དང་། ངས་མི་མངགས་ནས་ཁོ་འཛིན་པར་བྱ་ཞེས་བསྒོས་པ་ན། དེ་དག་གིས། ཀྱེ། ཁོ་ནི་དོའུ་ཐཱན་དུ་འདུག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཁོས་རྟ་དང་ཤིང་རྟ་དང་། དམག་འབོར་ཆེན་ཞིག་དང་བཅས་བརྫངས་པ་དང་། དེ་ཚོ་མཚན་མོར་སླེབས་ནས་གྲོང་ཁྱེར་གྱི་མཐའ་བསྐོར་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུའི་ཞབས་ཕྱི་དེ་སྔ་མོ་ལངས་ནས་ཕྱི་རོལ་ཏུ་ཐོན་པ་ན། ལྟོས་དང་། དམག་དཔུང་དང་རྟ། ཤིང་རྟ་རྣམས་ཀྱིས་གྲོང་ཁྱེར་བསྐོར་ཡོད་པ་མཐོང་བས། ཁོང་གི་ཞབས་ཕྱིས་ཁོང་ལ། ཀྱེ་ཧུད་ང་ཡི་བདག་པོ་ལགས། ངེད་ཅག་གིས་ཅི་བྱས་ན་ལེགས་སམ་ཞུས་པའི་ལན་དུ།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས། མ་འཇིགས་ཤིག དེ་དག་དང་མཉམ་དུ་ཡོད་པ་རྣམས་ལས་ངེད་ཅག་དང་མཉམ་དུ་ཡོད་པ་མང་ངོ་ཞེས་གསུངས།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཨེ་ལི་ཤཱས་སྨོན་ལམ་བཏབ་སྟེ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁོའི་མིག་གིས་མཐོང་ཐུབ་པའི་ཕྱིར་དུ་མིག་འབྱེད་པར་མཛོད་ཅིག་ཅེས་ཞུས་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཞབས་ཕྱི་དེའི་མིག་ཕྱེས་པ་དང་ཁོས་བལྟས་པའི་ཚེ། ཀྱེ། ཨེ་ལི་ཤཱའི་མཐའ་འཁོར་གྱི་རི་བོ་དེ་ནི་མེ་རྟ་དང་ཤིང་རྟས་བཀང་ཡོད་པ་མཐོང་ངོ་། །"]},{"type":"verse","number":18,"content":["ཡང་ཨ་རམ་པ་རྣམས་ཨེ་ལི་ཤཱའི་ཕྱོགས་སུ་མར་འབབ་པའི་ཚེ་ན། ཨེ་ལི་ཤཱས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་བཏབ་སྟེ། མི་འདི་རྣམས་ཀྱི་མིག་ལ་བསྣུན་ཏེ་ལོང་བར་མཛོད་ཅིག་ཅེས་ཞུས་པས། ཨེ་ལི་ཤཱས་ཞུས་པ་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ལོང་བར་མཛད།"]},{"type":"verse","number":19,"content":["དེར་ཨེ་ལི་ཤཱས་ཁོ་ཚོ་ལ། འདི་ནི་ལམ་དེ་མིན། གྲོང་ཁྱེར་དེ་ཡང་མིན་པས་ངའི་རྗེས་སུ་ཤོག་དང་། ཁྱོད་ཚོས་འཚོལ་བའི་མི་དེའི་མདུན་དུ་ངས་ཁྱོད་རྣམས་འཁྲིད་པར་བྱའོ་གསུངས་ཏེ་ཁོ་རྣམས་སཱ་མར་ཡ་",{"noteId":5},"རུ་ཁྲིད་དོ། །"]},{"type":"verse","number":20,"content":["དེ་ཡང་ཁོ་ཚོ་སཱ་མར་ཡ་རུ་སླེབས་པའི་ཚེ། ཨེ་ལི་ཤཱ་ཡིས། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། འདི་དག་གིས་མཐོང་ཐུབ་པའི་ཕྱིར་མིག་འབྱེད་པར་མཛོད་ཅིག་ཅེས་ཞུས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ཀྱི་མིག་ཕྱེས་པ་ན་དེ་དག་གིས་མཐོང་བར་གྱུར་ཅིང་། ལྟོས་དང་། དེ་རྣམས་སཱ་མར་ཡ་གྲོང་ཁྱེར་དུ་སླེབས་ཡོད་པ་མཐོང་ངོ་། །"]},{"type":"verse","number":21,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་དེ་རྣམས་མཐོང་བ་དང་ཨེ་ལི་ཤཱ་ལ། ཀྱེ་ངའི་ཡབ་ལགས། ངས་འདི་རྣམས་གསོད་ཆོག་གམ་ཞེས་དྲིས་པར།"]},{"type":"verse","number":22,"content":["ཨེ་ལི་ཤཱས་ལན་དུ། ཁྱོད་ཀྱིས་འདི་དག་གསོད་མི་རུང་། ཁྱོད་ཀྱིས་རང་གི་རལ་གྲི་དང་མདའ་གཞུ་ལ་བརྟེན་ནས་བཟུང་པ་རྣམས་གསོད་རུང་ངམ། འདི་རྣམས་ཀྱིས་བཟའ་བཏུང་སྤྱོད་པའི་ཕྱིར་ཁོ་ཚོའི་མདུན་དུ་བག་ལེབ་དང་ཆུ་ཞོག་དང་། དེ་ནས་ཁོ་རྣམས་རང་གི་བདག་པོའི་དྲུང་དུ་འགྲོ་རུ་ཆུག་ཅེས་བསྐུལ་བས།"]},{"type":"verse","number":23,"content":["རྒྱལ་པོས་དེ་དག་གི་ཕྱིར་གསོལ་སྟོན་ཆེན་པོ་ཞིག་གཡོས་པ་དང་དེ་ཚོས་བཟའ་བཏུང་སྤྱད་པ་ན། ཁོ་ཚོ་འགྲོ་རུ་བཅུག་པ་དང་དེ་རྣམས་རང་གི་བདག་པོའི་དྲུང་དུ་སོང་ཞིང་། དེ་ནས་བཟུང་ཨ་རམ་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཁམས་སུ་དཔུང་འཇུག་ཀྱང་མ་བྱས་སོ། །"]},{"type":"heading","content":["པེན་ཧ་དཱད་ཀྱིས་སཱ་མར་ཡ་དམག་གིས་བསྐོར་བ།"]},{"type":"verse","number":24,"content":["དེའི་རྗེས་སུ་ཨ་རམ་གྱི་རྒྱལ་པོ་པེན་ཧ་དཱད་ཀྱིས་རང་གི་དམག་མི་མཐའ་དག་བསྡུས་ཤིང་ཡར་སྐྱོད་པ་དང་སཱ་མར་ཡ་དམག་གིས་བསྐོར།"]},{"type":"verse","number":25,"content":["དེ་ནས་སཱ་མར་ཡ་རུ་མུ་གེ་ཆེན་པོ་ཞིག་བྱུང་བ་དང་། དགྲའི་དམག་གིས་མུ་མཐུད་དུ་དེ་མཐའ་ནས་བསྐོར་བའི་རྐྱེན་གྱིས་བོང་བུའི་མགོ་ཞིག་དངུལ་སྲང་བརྒྱད་ཅུ་དང་། ཕུག་རོན་གྱི་སྟུག་པ་བྲེ་",{"noteId":6},"བཞི་ཆ་གཅིག་ནི་དངུལ་སྲང་ལྔའི་རིན་ལ་སླེབས་པ་རེད།"]},{"type":"verse","number":26,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ལྕགས་རིའི་སྟེང་ནས་བརྒལ་བཞིན་པའི་ཚེ་ན། བུད་མེད་ཅིག་གིས་ཁོང་ལ། ཀྱེ་ངའི་བདག་པོ་ངའི་རྒྱལ་པོ་ལགས། ང་རང་སྐྱོབ་པར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":27,"content":["རྒྱལ་པོས་ཁོ་མོ་ལ། གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་སྐྱོབ་པར་མི་མཛད་ན། ངས་ཁྱོད་རང་གང་ནས་སྐྱོབ་པར་བྱའམ། གཡུལ་ཁའམ་ཡང་ན་རྒུན་འབྲུམ་འཚིར་གཞོང་གང་ནས་སྐྱོབ་པར་བྱའམ་ཞེས་གསུངས།"]},{"type":"verse","number":28,"content":["ཡང་རྒྱལ་པོས་ཁོ་མོར་དོན་དམ་དུ་ཁྱོད་ལ་ཅི་བྱུང་ཞེས་དྲིས་པར། ཁོ་མོ་ན་རེ། བུད་མེད་འདིས་ང་ལ། ཁྱོད་ཀྱི་བུ་ཁྲིད་ཤོག་དང་དེ་རིང་རང་ཅག་གིས་ཁོ་ཟ་བར་བྱའོ། །སང་ཉིན་རང་ཅག་གིས་ངའི་བུ་ཟོས་ཆོག་ཟེར་བས།"]},{"type":"verse","number":29,"content":["ངེད་ཅག་གིས་ངའི་བུ་དེ་བཙོས་ནས་ཟོས་པ་ཡིན། དེའི་ཕྱི་ཉིན་ངས་ཁོ་མོར། ད་ཁྱོད་ཀྱི་བུ་ཁྲིད་ཤོག་དང་རང་ཅག་གིས་ཁོ་ཟ་བར་བྱའོ་ཞེས་སྨྲས་ནའང་། ཁོ་མོས་རང་གི་བུ་སྦས་ནས་བཞག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":30,"content":["རྒྱལ་པོས་བུད་མེད་ཀྱི་གཏམ་དེ་ཐོས་པ་དང་། རང་གི་གོས་གཤགས་ཤིང་། སྐབས་དེར་ཁོ་རང་ལྕགས་རིའི་སྟེང་དུ་ཡོད་ཅིང་མི་རྣམས་ཀྱིས་ཁོ་རང་མཐོང་སྟེ། ཀྱེ་ཧོ། ཁོས་གྱོན་པའི་ནང་གོས་ནི་རྩིད་རས་ཡིན་པ་མཐོང་ངོ་། །"]},{"type":"verse","number":31,"content":["རྒྱལ་པོ་ན་རེ། གལ་སྲིད་དེ་རིང་ཤ་ཕད་ཀྱི་བུ་ཨེ་ལི་ཤཱའི་མགོ་ནི་ཁོའི་ཕྲག་གོང་ཁར་ལུས་པ་ཡིན་ན། དཀོན་མཆོག་གིས་བདག་ལ་འདིའམ་འདི་ལས་ལྷག་པ་ཞིག་མཛད་པར་ཤོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":32,"content":["དེ་ཡང་ཨེ་ལི་ཤཱ་རང་གི་ཁྱིམ་དུ་བཞུགས་ཏེ། རྒན་པོ་རྣམས་ཀྱང་ཁོང་དང་མཉམ་དུ་བསྡད་ཡོད་པ་དང་། རྒྱལ་པོས་རང་གི་འཁོར་མི་ཞིག་མངགས་ཀྱང་། བང་ཆེན་དེ་ཨེ་ལི་ཤཱའི་དྲུང་དུ་མ་སླེབས་གོང་དུ། ཁོང་གིས་རྒན་པོ་རྣམས་ལ། མི་གསོད་མཁན་གྱིས་ངའི་མགོ་གཅོད་པར་མི་ཞིག་མངགས་པ་ཁྱོད་ཚོས་མཐོང་ངམ། ད་ལྟོས་དང་། བང་ཆེན་དེ་སླེབས་མ་ཐག་ཏུ་སྒོ་གཏན་པར་གྱིས། ཁོ་སྒོའི་ཕྱི་རོལ་ཏུ་ཁོགས་ཤིག དེའི་རྒྱབ་ཏུ་ཁོའི་བདག་པོའི་གོམ་སྒྲ་ཡོད་པ་མིན་ནམ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":33,"content":["ཁོང་གིས་རྒན་པོ་རྣམས་ལ་གཏམ་གླེང་སྐབས། ཀྱེ་མ། བང་ཆེན་ཁོང་གི་གམ་དུ་སླེབས་ཤིང་། ལྟོས་དང་། ཆག་སྒོ་འདི་དཀོན་མཆོག་ཡ་ཝཱེ་ནས་བྱུང་། ངས་ཅིའི་ཕྱིར་ད་དུང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྒུག་གམ་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"སཱ་མར་ཡ་ནི་ཡེས་ར་ཨེལ་གྱི་བྱང་ཕྱོགས་ཀྱི་རྒྱལ་སའི་གྲོང་ཁྱེར་ཞིག་ཡིན།","reference":{"chapter":6,"verse":19}},{"noteId":6,"caller":"+","text":"འདིར་བྲེ་ཞེས་པར་མ་ཕྱི་ལས་ཡ་ཧུ་དཱའི་སྐད་དོད་དེ་ཁཱ་ཝུ་ཞེས་མཐོང་། དེ་ནི་ཡ་ཧུ་དཱའི་སྐད་ཀྱི་ལྗིད་ཚད་འཇལ་བྱེད་ཅིག་གི་མིང་ཡིན་ཞིང་། ཁཱ་ཝུ་གཅིག་ནི་སྤྱི་རྒྱ་གང་གི་སྟོང་ཆ་བརྒྱ་ཙམ་ཡིན་པར་གསུངས།","reference":{"chapter":6,"verse":25}}]},"thisChapterLink":"/api/bod_ntb/2KI/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/5.json","previousChapterAudioLinks":{},"numberOfVerses":33}