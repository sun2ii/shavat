{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":7,"content":[{"type":"heading","content":["ཨེ་ལི་ཤཱས་ཁ་ཟས་ཡོད་པར་དམ་བཅས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཨེ་ལི་ཤཱས། ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་ཉོན་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། སང་ཉིན་དུས་ཚོད་འདི་ཙམ་དུ་སཱ་མར་ཡའི་མཁར་སྒོར་དངུལ་སྲང་གཅིག་ལ་གྲོ་ཞིབ་བྲེ་",{"noteId":7},"གཅིག་དང་། དངུལ་སྲང་གཅིག་ལ་ནས་བྲེ་གཉིས་རེ་བཙོང་བར་འགྱུར་གསུངས་སོ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་བསྐྱོར་བའི་དམག་དཔོན་གྱིས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ལ། ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ནམ་མཁའི་དཀར་ཁུང་ཕྱེས་པར་མཛད་ཀྱང་དེ་འདྲ་འབྱུང་སྲིད་དམ་ཞེས་སྨྲས་པ་ལ། ཨེ་ལི་ཤཱས། ལྟོས་དང་། ཁྱོད་ཀྱི་མིག་གིས་དེ་མཐོང་ཡང་། དེ་ལས་བཟའ་བར་མི་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཨ་རམ་པའི་དམག་དཔུང་ཕྱིར་བྲོས་པ།"]},{"type":"verse","number":3,"content":["དེ་ཡང་མཁར་སྒོའི་ཕྱི་རོལ་ཏུ་མཛེ་བོ་བཞི་ཡོད་ཅིང་ཕན་ཚུན་ན་རེ། རང་ཅག་གིས་ཅིའི་ཕྱིར་འདི་རུ་འཆི་བར་སྒུག་སྡོད་པ་ཡིན་ནམ།"]},{"type":"verse","number":4,"content":["གལ་ཏེ་རང་ཅག་གྲོང་ཁྱེར་ནང་དུ་འགྲོ་བར་བྱ་ཟེར་ན། གྲོང་ཁྱེར་ནང་དུ་མུ་གེ་བྱུང་ཡོད་པས་རང་ཅག་དེར་འཆི་བར་འགྱུར། གལ་ཏེ་འདིར་བསྡད་ན་ཡང་འཆི་བར་འགྱུར་བས། ད་ནི་རང་ཅག་ཨ་རམ་པའི་དམག་སྒར་དུ་འགྲོ་བར་བྱ། གལ་སྲིད་དེ་དག་གིས་རང་ཅག་སྲོག་ཐར་བཏང་ན་ང་ཚོ་གསོན་པར་འགྱུར། གལ་ཏེ་སྲོག་དང་འཕྲལ་ན་རང་ཅག་འཆི་བར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":5,"content":["ས་སྲོས་ཀྱི་དུས་སུ་ཁོ་ཚོ་ལངས་ནས་ཨ་རམ་པའི་དམག་སྒར་དུ་ཆས་པ་དང་། དེ་དག་ཨ་རམ་པའི་དམག་སྒར་གྱི་མཐའ་མཚམས་སུ་སླེབས་པ་ན། ལྟོས་དང་། དེར་མི་གཅིག་ཀྱང་མི་འདུག"]},{"type":"verse","number":6,"content":["ཅི་ལ་ཞེ་ན། གཙོ་བོས་",{"noteId":8},"ཨ་རམ་པ་ལ་ཤིང་རྟའི་སྒྲ་དང་། རྟའི་རྨིག་སྒྲ་དང་། དམག་དཔུང་ཆེན་པོའི་སྒྲ་ཐོས་སུ་བཅུག་པ་ལ། དེ་རྣམས་ཀྱིས་ཕན་ཚུན་ན་རེ། ལྟོས་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོས་ཧེད་པའི་རྒྱལ་པོ་རྣམས་དང་། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་རྣམས་གླས་ནས་རང་ཅག་ལ་རྒོལ་དུ་འོངས་པ་རེད་ཅེས་སྨྲས་ཏེ།"]},{"type":"verse","number":7,"content":["མི་དེ་དག་ས་སྲོས་ཀྱི་དུས་སུ་ཡར་ལངས་ནས་བྲོས་ཤིང་། ཁོ་ཚོས་རང་གི་གུར་དང་། རྟ་དང་བོང་བུ་རྣམས་དམག་སྒར་དུ་བཞག་ནས་སྲོག་ཐར་དུ་བྲོས་པ་རེད།"]},{"type":"verse","number":8,"content":["དེ་ནས་མཛེ་བོ་དེ་དག་དམག་སྒར་གྱི་མཐའ་མཚམས་སུ་ཕྱིན་པ་དང་། གུར་ཞིག་ཏུ་འཛུལ་ནས་ཟོས་ཤིང་འཐུངས་ཏེ། དེའི་ནང་ནས་གསེར་དངུལ་དང་གོས་སོགས་ཁྱེར་སོང་སྟེ་གཞོགས་ཤིག་ཏུ་སྦས་པ་དང་། ཡང་ཕྱིར་ལོག་ཅིང་གུར་གཞན་ཞིག་ཏུ་འཛུལ་ནས་དངོས་པོ་ཁྱེར་ཏེ་སྦས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཁོ་ཚོས་ཕན་ཚུན་ལ། རང་ཅག་གིས་བྱས་པ་འདི་མི་འགྲིག་ལ། དེ་རིང་ནི་འཕྲིན་བཟང་སྒྲོག་པའི་ཉིན་མོ་ཡིན་ནའང་རང་ཅག་གིས་ཅི་ཡང་མ་སྨྲས། ཞོགས་པ་སླེབས་པའི་བར་དུ་སྒུག་བསྡད་ན་རང་ཅག་ལ་ཉེས་ཆད་འཕོག་ངེས་པས། ད་ནི་ཤོག་དང་། རྒྱལ་པོའི་ཕོ་བྲང་དུ་འཕྲིན་བསྐྱལ་བར་བྱ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":10,"content":["དེ་དག་སོང་ནས་གྲོང་ཁྱེར་གྱི་སྒོ་སྲུང་བོས་ཏེ་ཁོ་རྣམས་ལ། ངེད་ཅག་ཨ་རམ་པའི་དམག་སྒར་དུ་ཕྱིན་པ་ཡིན། ལྟོས་དང་། དེར་མི་ཡང་མི་འདུག་ལ་མི་སྐད་ཀྱང་ཐོས་རྒྱུ་མི་འདུག འོན་ཀྱང་རྟ་དང་བོང་བུ་རྣམས་བཏགས་ནས་འདུག གུར་རྣམས་ཀྱང་རང་གནས་སུ་འདུག་ཅེས་སྨྲས་པ་ན།"]},{"type":"verse","number":11,"content":["མཁར་སྒོ་སྲུང་མཁན་རྣམས་ཀྱིས་སྐད་ཅོར་བརྒྱབ་ནས་རྒྱལ་པོའི་ཕོ་བྲང་དུ་འཕྲིན་བསྐྱལ་ཏོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་རྒྱལ་པོ་མཚན་མོར་ཡར་ལངས་ནས་རང་གི་དྲུང་འཁོར་རྣམས་ལ། ཨ་རམ་པས་རང་ཅག་ལ་ཅི་བྱས་པ་དེ་ངས་འཆད་པར་བྱ་སྟེ། རང་ཅག་ལ་མུ་གེ་བྱུང་ཡོད་པ་ཁོ་ཚོར་གསལ་བས། ཁོ་ཚོ་གྲོང་ཁྱེར་ནས་འཐོན་ཚེ། ངེད་ཅག་གིས་དེ་དག་གསོན་པོར་བཟུང་སྟེ་གྲོང་ཁྱེར་ནང་དུ་འགྲོའོ་སྨྲས་ནས། རང་གི་དམག་སྒར་ལས་ཕྱིན་ཏེ་རི་ཐང་དུ་འཇབ་སྒུག་བྱེད་པར་སོང་བ་ཡིན་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":13,"content":["ཁོང་གི་དྲུང་འཁོར་རྣམས་ལས་གཅིག་གིས་དེའི་ལན་དུ། གྲོང་ཁྱེར་དུ་ལུས་ཡོད་པའི་རྟ་རྣམས་ལས་རྟ་ལྔ་ཕར་ཐོངས་ཤིག འདི་ལྔ་པོ་ནི་ཤུལ་དུ་ལུས་ནས་འཆི་ལ་ཡོད་པའི་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་དང་འདྲ་སྟེ། ཐམས་ཅད་ཚེ་ལས་འདས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་དང་འདྲའོ། །རང་ཅག་གིས་མི་མངགས་ནས་བལྟ་བར་བྱ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":14,"content":["དེ་དག་གིས་ཤིང་རྟ་གཉིས་དང་རྟ་བཅས་ཁྲིད་འོངས་ཤིང་། རྒྱལ་པོས་དེ་དག་ཨ་རམ་པའི་དམག་དཔུང་གི་ར་མདར་བཏང་སྟེ། སོང་ལ་ལྟོས་ཤིག་ཅེས་བསྒོས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ཁོ་ཚོ་དེ་དག་གི་རྗེས་སུ་ཡོར་དན་གཙང་པོའི་བར་དུ་སོང་སྟེ། ལྟོས་དང་། ལམ་ཧྲིལ་པོར་ཨ་རམ་པས་རྟབ་རྟབ་པོར་འཕངས་པའི་གོས་དང་ཡོ་བྱད་ཀྱིས་གང་ཡོད་པ་རེད། དེ་ནས་བང་ཆེན་རྣམས་ཕྱིར་ལོག་ནས་རྒྱལ་པོར་འཕྲིན་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["དེར་མི་རྣམས་ཕྱི་རོལ་ཏུ་ཐོན་ནས་ཨ་རམ་པའི་དམག་སྒར་འཕྲོག་བཅོམ་བྱས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་བཞིན་དུ། དངུལ་སྲང་རེ་ལ་གྲོ་ཞིབ་བྲེ་རེ་དང་། ནས་བྲེ་གཉིས་དངུལ་སྲང་རེ་བྱས་ནས་བཙོངས་པའོ། །"]},{"type":"verse","number":17,"content":["ཡང་རྒྱལ་པོས་ཁོ་རང་བསྐྱོར་ཡོད་པའི་དམག་དཔོན་དེ་མཁར་སྒོ་རུ་ཞིབ་བཤེར་བྱེད་པར་བསྐོས་པ་དང་། དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་རྒྱལ་པོ་ཁོང་དང་ཐུག་ཕྲད་དུ་འོངས་དུས་སུ་ཁོ་ལ་གསུངས་པ་བཞིན་དུ། མི་རྣམས་ཀྱིས་དེ་ནི་སྒོ་འགྲམ་དུ་རྡོག་རྫིས་བཏང་བས་ཚེ་ལས་འདས།"]},{"type":"verse","number":18,"content":["དེ་ནི་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་རྒྱལ་པོ་ལ། སང་ཉིན་དུས་ཚོད་འདིར་སཱ་མར་ཡ་ཡི་མཁར་སྒོར་དངུལ་སྲང་རེ་ལ་ནས་བྲེ་གཉིས་རེ་དང་། གྲོ་ཞིབ་བྲེ་གཅིག་དངུལ་སྲང་རེ་ལ་བཙོང་བར་འགྱུར་ཞེས་གསུངས་པ་བཞིན་དུ་གྲུབ་པ་ལ།"]},{"type":"verse","number":19,"content":["དམག་དཔོན་གྱིས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ལ་ལན་བཟློག་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ནམ་མཁའི་དཀར་ཁུང་ཕྱེས་པར་མཛད་ན་ཡང་དེ་འདྲ་འབྱུང་སྲིད་དམ་ཞེས་སྨྲས་པས། དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་ཁོ་ལ། ལྟོས་དང་། ཁྱོད་ཀྱི་མིག་གིས་དེ་མཐོང་ཡང་དེ་ལས་བཟའ་བར་མི་འགྱུར་རོ་ཞེས་གསུངས་པས་ཡིན་ལ།"]},{"type":"verse","number":20,"content":["དོན་དེ་དངོས་གནས་ཁོ་ལ་བྱུང་བར་གྱུར་ཏེ། མི་རྣམས་ཀྱིས་ཁོ་སྒོ་འགྲམ་དུ་རྡོག་བརྫིས་བཏང་ནས་ཚེ་ལས་འདས་སོ། །"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འདིར་མ་ཕྱི་ལས་སེ་ཡ་ཞེས་བྲིས་ཡོད་པ་དང་བོད་ཀྱི་དབང་དུ་བྱས་ན་སེ་ཡ་གཅིག་ནི་བྲེ་གཅིག་ཡིན་པ་རེད།","reference":{"chapter":7,"verse":1}},{"noteId":8,"caller":"+","text":"འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་ཡིན།","reference":{"chapter":7,"verse":6}}]},"thisChapterLink":"/api/bod_ntb/2KI/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}