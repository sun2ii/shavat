{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2KI","translationId":"bod_ntb","name":"རྒྱལ་རབས་གཉིས་པ།","commonName":"རྒྱལ་རབས་གཉིས་པ།","title":"༄༅། །རྒྱལ་རབས་ཀྱི་མདོ་གཉིས་པ།","order":12,"numberOfChapters":25,"sha256":"c16da40aedb05f550dcb5cfde0a378cb2856d42f72fa92671865c1b851c0527b","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/bod_ntb/2KI/25.json","totalNumberOfVerses":719},"chapter":{"number":8,"content":[{"type":"heading","content":["ཤུ་ནེམ་གྱི་བུད་མེད་དེའི་ས་ཞིང་ཕྱིར་ཐོབ་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨེ་ལི་ཤཱས་སྔར་གསོན་དུ་བཅུག་པའི་བུ་དེའི་ཨ་མ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་འདིར་ལོ་བདུན་གྱི་རིང་ལ་མུ་གེ་འབྱུང་བའི་གསུང་བརྡ་བརྒྱབ་ཡོད་པས། ཁྱོད་དང་ཁྱོད་ཀྱི་བཟའ་མི་རྣམས་ཡར་ལོངས་ལ། ཡུལ་འདིར་ཁ་བྲལ་ནས་བྱེས་སུ་སྡོད་ནུས་པའི་ས་ཆ་ཞིག་ཏུ་སྡོད་ཅིག་ཅེས་བསྒོས་པ་དང་།"]},{"type":"verse","number":2,"content":["བུད་མེད་དེ་ཡར་ལངས་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཡིས་བསྒོས་པ་བཞིན་དུ་བྱས་ཤིང་། རང་གི་བཟའ་མི་རྣམས་ཁྲིད་ནས་སོང་བ་དང་། ཕེ་ལེ་ཤེད་པའི་ཡུལ་དུ་ལོ་བདུན་གྱི་རིང་ལ་བསྡད་དོ། །"]},{"type":"verse","number":3,"content":["དེ་ཡང་ལོ་བདུན་འགོར་རྗེས་བུད་མེད་དེ་ཕེ་ལེ་ཤེད་པའི་ཡུལ་ནས་ཕྱིར་ལོག་པ་དང་། རང་གི་ཁང་པ་དང་ས་ཞིང་གི་དོན་དུ་འོ་དོད་ཞུ་བར་རྒྱལ་པོའི་དྲུང་དུ་སོང་བ་ན།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོས་དཀོན་མཆོག་གི་སྐྱེས་བུའི་ཞབས་ཕྱི་གེ་ཧ་ཟི་དང་གླེང་མོལ་མཛད་ཀྱིན་ཁོ་ལ། ཁྱོད་ཀྱིས་ཨེ་ལི་ཤཱས་མཛད་པའི་དོན་ཆེན་ཐམས་ཅད་ང་ལ་ཤོད་ཅིག་ཅེས་སྨྲས་པར།"]},{"type":"verse","number":5,"content":["ཁོས་རྒྱལ་པོ་ལ་ཨེ་ལི་ཤཱས་ཇི་ལྟར་གཤིན་པོ་ཞིག་གསོན་དུ་བཅུག་ཚུལ་དེ་འཆད་པའི་ཚེ། ལྟོས་དང་། སྔར་སྲོག་བསྐྱབས་པའི་བུ་དེའི་མ་ཡིས་རྒྱལ་པོ་ལ་རང་གི་ས་ཞིང་དང་ཁང་པའི་དོན་དུ་འོ་དོད་ཞུས་པས། གེ་ཧ་ཟི་ན་རེ། ཀྱེ་བདག་གི་ཇོ་བོ་བདག་གི་རྒྱལ་པོ་ལགས། བུད་མེད་དེ་ནི་འདི་ཡིན་ཏེ། ཨེ་ལི་ཤཱས་གསོན་དུ་བཅུག་པའི་བུ་ཡང་འདི་རང་ཡིན་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":6,"content":["རྒྱལ་པོས་ཀྱང་བུད་མེད་ལ་དྲིས་པ་ན་ཁོ་མོས་ཁོང་ལ་སྨྲས་སོ། །དེ་བས་རྒྱལ་པོས་འགོ་དཔོན་",{"noteId":9},"ཞིག་མངགས་ནས་དེ་ལ་ཁོ་མོའི་ཡིན་ཚད་དང་། ཁོ་མོས་རང་ཡུལ་བསྐྱུར་བའི་ཉིན་ནས་བཟུང་ད་ལྟའི་བར་གྱི་ས་ཞིང་དང་ཐོན་རྫས་བཅས་ཡོད་ཚད་ཁོ་མོར་ཕྱིར་སྤྲོད་ཅིག་ཅེས་བསྒོས་སོ། །"]},{"type":"heading","content":["ཧ་ཟཱ་ཨེལ་གྱིས་པེན་ཧ་དཱད་བཀྲོངས་པ།"]},{"type":"verse","number":7,"content":["ཡང་ཨེ་ལི་ཤཱ་ཁོང་ཉིད་དཱ་མེ་སེག་ལ་ཕྱིན་པ་དང་། ཨ་རམ་གྱི་རྒྱལ་པོ་པེན་ཧ་དཱད་ནད་ཀྱིས་ཟིན་ཡོད་དེ། མི་ཞིག་གིས་ཁོང་ལ། དཀོན་མཆོག་གི་སྐྱེས་བུ་འདིར་ཡོང་ཡོད་ཅེས་ཞུས་པར།"]},{"type":"verse","number":8,"content":["རྒྱལ་པོས་ཧ་ཟཱ་ཨེལ་ལ། ཁྱོད་ཀྱིས་རང་གི་ལག་ཏུ་ཞུ་རྟེན་ཞིག་ཁྱེར་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་བསུ་རུ་སོང་སྟེ། ང་ནད་འདི་ལས་གསོན་ཐུབ་མིན་དྲིས་ཤིག ཁོང་ལས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་བརྟག་ཞུས་ཤིག་ཅེས་བཀའ་གནང་བ་དང་།"]},{"type":"verse","number":9,"content":["ཧ་ཟཱ་ཨེལ་བྱ་བ་ཨེ་ལི་ཤཱ་བསུ་རུ་ཕྱིན་ཏེ། ཁོས་དཱ་མེ་སེག་གི་བཟང་ནོར་ཐམས་ཅད་ལས་ཞུ་རྟེན་རྔ་མོང་བཞི་བཅུར་བཀལ་ཏེ་མཉམ་དུ་ཁྱེར་ཅིང་། ཁོང་གི་དྲུང་དུ་ལངས་ཏེ་ན་རེ། ཨ་རམ་གྱི་རྒྱལ་པོ་ཁྱེད་ཀྱི་བུ་པེན་ཧ་དཱད་ཀྱིས་བདག་ཁྱེད་ཀྱི་དྲུང་དུ་མངགས་ཏེ། ང་ནད་འདི་ལས་གསོན་པར་འགྱུར་རམ་ཞེས་འདྲིའོ་ཞུས་པ་ན།"]},{"type":"verse","number":10,"content":["ཨེ་ལི་ཤཱས་ལན་དུ། ཁྱོད་སོང་སྟེ་ཁོ་ལ། ཁྱོད་ནི་ཏག་ཏག་གསོན་པར་འགྱུར་ཞེས་སྦྲོན་ཅིག འོན་ཀྱང་ཁོ་ནི་འཆི་བར་ངེས་པ་དེ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་མངོན་པར་མཛད་དོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["ཨེ་ལི་ཤཱས་ཁོ་རང་བག་འཁུམས་ནས་སྡོད་མི་བདེ་བའི་བར་དུ་མིག་ཧུར་རེར་ཁོ་ལ་བལྟས་ཤིང་། དེ་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་ཁོང་བཤུམས་པར་གྱུར།"]},{"type":"verse","number":12,"content":["དེར་ཧ་ཟཱ་ཨེལ་གྱིས། བདག་གི་ཇོ་བོ་ལགས་ཅི་ལ་བཤུམས་པ་ཡིན་ཞུས་པས། ཁོང་གིས་དེ་ལ། ཅི་ལ་ངུ་ཟེར་ན། ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྤྱོད་པར་འགྱུར་བའི་དོན་ངན་རྣམས་ངས་ཤེས་ཟིན་པས་ཡིན། ཁྱོད་ཀྱིས་ཁོ་ཚོའི་གྲོང་ཁྱེར་བརྟན་པོ་རྣམས་མེར་བསྲེགས་ཏེ། དེའི་ན་གཞོན་རྣམས་རལ་གྲིས་གསོད་ཅིང་། དེ་དག་གི་ཕྲུ་གུ་རྣམས་སར་བསྒྱེལ་ནས་གསོད་པ་དང་། སྦྲུམ་མ་རྣམས་ཀྱི་གྲོད་པ་གཤག་པར་འགྱུར་རོ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":13,"content":["ཧ་ཟཱ་ཨེལ་གྱིས། ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཁྱི་ལྟ་བུ་བདག་གིས་དོན་ཆེན་པོ་དེ་ཅི་ལྟར་བྱེད་དམ་ཞུས་པས། ཨེ་ལི་ཤཱས་ལན་དུ། ཁྱོད་རང་ཨ་རམ་གྱི་རྒྱལ་པོར་འགྱུར་བ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བསྟན་བྱུང་གསུངས་སོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་ཁོ་ཨེ་ལི་ཤཱ་དང་བྲལ་ནས་ཕྱིར་རང་གི་བདག་པོའི་རྩར་ཕྱིན་པ་དང་། པེན་ཧ་དཱད་ཀྱིས་ཁོ་ལ། ཨེ་ལི་ཤཱས་ཁྱོད་ལ་ཅི་ཟེར་ཞེས་པར་ཁོ་ན་རེ། ཁོང་གིས་ཁྱེད་ངེས་པར་གསོན་པར་འགྱུར་ཞེས་ང་ལ་བཤད་བྱུང་ཞེས་སྨྲས།"]},{"type":"verse","number":15,"content":["དེའི་ཕྱི་ཉིན་ཧ་ཟཱ་ཨེལ་གྱིས་མལ་གོས་མཐུག་པོ་ཞིག་བླངས་ནས་ཆུར་སྦངས་ཏེ་པེན་ཧ་དཱད་ཀྱི་གདོང་ལ་བཀབ་པས། ཁོ་ནི་ཚེ་ལས་འདས་པ་དང་ཧ་ཟཱ་ཨེལ་ཁོའི་ཚབ་ཏུ་རྒྱལ་པོར་གྱུར་ཏོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ།"]},{"type":"verse","number":16,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་གྱིས་སྲིད་བསྐྱངས་པའི་ལོ་ལྔ་པར། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཤ་ཕད་ད་དུང་བཞུགས་པ་དང་། ཡེ་ཧོ་ཤ་ཕད་ཀྱི་སྲས་ཡེ་ཧོ་རཱམ་རྒྱལ་པོར་བསྡད།"]},{"type":"verse","number":17,"content":["ཁོ་རྒྱལ་པོར་སྡོད་དུས་སུ་ལོ་སུམ་ཅུ་སོ་གཉིས་ཡིན་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་བརྒྱད་ཀྱི་རིང་ལ་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":18,"content":["ཁོས་ཀྱང་ཨ་ཧབ་ཀྱི་བུ་རྒྱུད་ཀྱིས་སྤྱད་པ་ལྟར་དུ། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལམ་ལ་འགྲུལ། གང་ལ་ཞེ་ན། ཁོས་ཨ་ཧབ་ཀྱི་བུ་མོ་ཆུང་མར་བླངས་པར་མ་ཟད། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"verse","number":19,"content":["ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་རྐྱེན་གྱིས་ཡ་ཧུ་དཱ་མེད་པར་མཛད་པ་ལ་ཐུགས་མ་མཉེས་སོ། །ཁོང་གིས་དཱ་བིད་ལ་ཞལ་བཞེས་གནང་ཡོད་པ་བཞིན་མཛད་དེ། ཁོང་དང་ཁོང་གི་བུ་རྒྱུད་རྣམས་ལ་དུས་གཏན་དུ་སྒྲོན་མེ་ལྟར་འོད་ཡོད་པར་གནང་བའོ། །"]},{"type":"verse","number":20,"content":["ཡེ་ཧོ་རཱམ་རྒྱལ་པོ་ཡིན་པའི་དུས་སུ་ཨེ་དོམ་པ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་མངའ་འོག་ནས་ངོ་ལོག་བྱས་ཤིང་ཁོ་ཚོས་རང་ལ་རྒྱལ་པོ་ཞིག་བསྐོས་སོ། །"]},{"type":"verse","number":21,"content":["དེའི་ཕྱིར་ཡེ་ཧོ་རཱམ་ནི་ཤིང་རྟ་ཐམས་ཅད་དང་བཅས་ཙ་ཨིར་དུ་ཕྱིན་ཏེ། ཁོ་མཚན་མོར་ལངས་ནས་ཁོ་རང་དང་ཤིང་རྟའི་དམག་དཔོན་རྣམས་བསྐོར་ནས་ཡོད་པའི་ཨེ་དོམ་པ་རྣམས་འཇོམས་པར་བྱས་ནའང་། ཁོའི་དམག་མི་རྣམས་རང་རང་གི་གུར་དུ་བྲོས།"]},{"type":"verse","number":22,"content":["དེ་ལྟར་ཨེ་དོམ་པས་ངོ་ལོག་བྱས་ཏེ། ཡ་ཧུ་དཱའི་མངའ་འོག་ནས་དེ་རིང་བར་དུ་ངོ་ལོག་བྱས་པ་དང་། དུས་དེར་ལིབ་ནཱ་པས་ཀྱང་ངོ་ལོག་བྱས་སོ། །"]},{"type":"verse","number":23,"content":["ཡེ་ཧོ་རཱམ་གྱི་དོན་གཞན་དག་དང་། ཁོས་ཅི་བྱས་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་རྣམས་ཀྱི་ལོ་རབས་ནང་དུ་བཀོད་ཡོད་པ་མིན་ནམ།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡེ་ཧོ་རཱམ་རང་གི་ཕ་མེས་རྣམས་དང་ལྷན་ཅིག་གཟིམས་པ་དང་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་",{"noteId":10},"ནས་དུར་དུ་སྦས། ཁོའི་སྲས་ཨ་ཧ་ཟི་ཡཱ་ཡིས་དེའི་རྒྱུན་མཐུད་ནས་རྒྱལ་སྲིད་བསྐྱངས་སོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་ཧ་ཟི་ཡཱ།"]},{"type":"verse","number":25,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་གྱིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་བཅུ་གཉིས་པར། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་གྱི་སྲས་ཨ་ཧ་ཟི་ཡཱ་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོར་གྱུར་ཏོ། །"]},{"type":"verse","number":26,"content":["ཨ་ཧ་ཟི་ཡཱ་ཡིས་རྒྱལ་སྲིད་བཟུང་དུས། ཁོ་ལོ་ཉེར་གཉིས་ལ་སོན་ཡོད་དེ། ཡེ་རུ་སཱ་ལེམ་དུ་ལོ་གཅིག་རིང་རྒྱལ་སྲིད་བསྐྱངས། ཁོའི་ཡུམ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཨོམ་རིའི་ཚ་མོ་",{"noteId":11},"ཨ་ཐལ་ཡཱ་བྱ་བའོ། །"]},{"type":"verse","number":27,"content":["ཁོ་ནི་ཨ་ཧབ་ཚང་གི་མག་པ་ཡིན་པའི་རྐྱེན་གྱིས། ཁོ་ཡང་ཨ་ཧབ་ཁྱིམ་རྒྱུད་ཀྱི་ལམ་དུ་ཞུགས་ཤིང་། ཨ་ཧབ་ཀྱི་ཁྱིམ་རྒྱུད་བཞིན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་དོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་ཨ་ཧ་ཟི་ཡཱ་ནི་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་དང་མཉམ་དུ་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་ལ་དམག་འགྱེད་དུ་གིལ་ཨད་ཀྱི་རཱ་མོད་དུ་སོང་ཞིང་། ཨ་རམ་པས་ཡོ་རཱམ་བསྣད་པ་རེད།"]},{"type":"verse","number":29,"content":["ཡང་རྒྱལ་པོ་ཡོ་རཱམ་ནི་ཨ་རམ་གྱི་རྒྱལ་པོ་ཧ་ཟཱ་ཨེལ་དང་གཡུལ་འགྱེད་པའི་དུས་སུ། ཨ་རམ་པས་རཱ་མ་རུ་ཁོ་བསྣད་པའི་རྨ་དེ་གསོ་བར་ཡེ་སི་རེ་ཨེལ་དུ་ཕྱིར་ལོག་པ་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་རཱམ་གྱི་སྲས་ཨ་ཧ་ཟི་ཡཱ་ནི་ཨ་ཧབ་ཀྱི་སྲས་ཡོ་རཱམ་རྨས་ཡོད་པས། དེ་ལ་བལྟ་རུ་མར་ཡེ་སི་རེ་ཨེལ་དུ་སོང་ངོ་། །"]}],"footnotes":[{"noteId":9,"caller":"+","text":"ཡེས་ར་ཨེལ་གྱི་སྐད་དུ་ཉུག་རུམ་པ་ཡིན།","reference":{"chapter":8,"verse":6}},{"noteId":10,"caller":"+","text":"དེ་ནི་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་གྱི་མིང་གཞན་ཏེ་དཱ་བིད་ཀྱི་རྒྱལ་ས་ཡིན། ལེའུ་བརྒྱད་པའི་ཚིག་རྐང་ཉེར་བཞི་པ་དང་། ལེའུ་དགུ་པའི་ཚིག་རྐང་ཉེར་བརྒྱད་པ། ལེའུ་བཅུ་གཉིས་པའི་ཚིག་རྐང་ཉེར་གཅིག་པ། ལེའུ་བཅུ་བཞི་པའི་ཚིག་རྐང་ཉི་ཤུ་པ། ལེའུ་བཅོ་ལྔ་པའི་ཚིག་རྐང་བདུན་པ། ལེའུ་བཅོ་བརྒྱད་པའི་ཚིག་རྐང་བཅུ་དྲུག་པ་དང་ཚིག་རྐང་ཉི་ཤུ་པ་བཅས་སུ་གསལ་བས་གཟིགས་རོགས།","reference":{"chapter":8,"verse":24}},{"noteId":11,"caller":"+","text":"ཡེས་ར་ཨེལ་གྱི་སྐད་ཡིག་ཏུ་ཨོམ་རིའི་བུ་མོ་ཞེས་བྲིས་ཡོད། ཨོམ་རིའི་ཚ་མོ་དང་རིགས་རྒྱུད་གཅིག་ཡིན། ཁོ་མོ་ནི་རྒྱལ་པོ་ཨ་ཧབ་ཀྱི་བུ་མོ་དང་ཨོམ་རི་ཡི་ཚ་མོ་ཡིན།","reference":{"chapter":8,"verse":26}}]},"thisChapterLink":"/api/bod_ntb/2KI/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2KI/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2KI/7.json","previousChapterAudioLinks":{},"numberOfVerses":29}