{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":10,"content":[{"type":"heading","content":["ཨམ་མོན་པ་དང་ཨ་རམ་པ་གཉིས་ཕམ་པར་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཡང་དེའི་རྗེས་སུ་ཨམ་མོན་པའི་རྒྱལ་པོ་གྲོངས་ནས་ཁོའི་སྲས་ཧ་ནུན་ནི་ཕ་ཡི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར།"]},{"type":"verse","number":2,"content":["དཱ་བིད་ཀྱིས་ནཱ་ཧ་སི་ཡིས་ང་རང་དྲིན་གྱིས་བསྐྱངས་པ་བཞིན་དུ། ངས་ཀྱང་ནཱ་ཧ་སི་ཡི་སྲས་ཧ་ནུན་དྲིན་གྱིས་བསྐྱང་བར་བྱ་ཞེས་གསུངས་ཤིང་། དེའི་ཡབ་ཀྱི་ཆེད་དུ་དེ་ལ་སེམས་གསོ་གཏོང་བར་དཱ་བིད་ཀྱིས་རང་གི་བློན་འཁོར་རྣམས་མངགས་ཤིང་། དཱ་བིད་ཀྱི་བློན་འཁོར་རྣམས་ཨམ་མོན་པའི་ཡུལ་དུ་ཕྱིན་པ་དང་།"]},{"type":"verse","number":3,"content":["ཨམ་མོན་པའི་འགོ་དཔོན་རྣམས་ཀྱིས་རང་གི་བདག་པོ་ཧ་ནུན་ལ། དཱ་བིད་ཀྱིས་ཁྱོད་ཅག་གི་སེམས་གསོ་བར་མི་མངགས་པ་དེ་ནི་ཁྱོད་ཅག་གི་ཡབ་ལ་བརྩི་བཀུར་བྱེད་པའི་ཕྱིར་ཡིན་པར་དགོངས་སམ། དཱ་བིད་ཀྱིས་རང་གི་བློན་འཁོར་འདི་དག་ནི་གྲོང་ཁྱེར་འདིར་ལྐོག་ལྟ་དང་ཉུལ་ཞིབ་བྱས་ནས་དབང་བསྒྱུར་བའི་ཕྱིར་བཏང་བ་མ་ཡིན་ནམ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":4,"content":["ཧ་ནུན་གྱིས་དཱ་བིད་ཀྱི་བློན་འཁོར་རྣམས་བཟུང་ནས་སྨ་ར་ཕྱེད་ཀ་བྲེགས་པ་དང་། ཕྱི་གོས་བཅད་ནས་འཕོངས་ཚོས་ཕྱི་རུ་མངོན་ཞིང་དེ་དག་འགྲོ་རུ་བཅུག་གོ །"]},{"type":"verse","number":5,"content":["མི་ཞིག་གིས་དོན་དེ་དཱ་བིད་ལ་ཞུས་པ་དང་ཁོང་གིས་དེ་དག་བསུ་མཁན་མངགས་སོ། །གང་ལ་ཞེ་ན། དེ་དག་ཤིན་ཏུ་ངོ་ཚ་བའི་ཕྱིར་རོ། །རྒྱལ་པོས་དེ་དག་ལ་ཁྱོད་ཅག་གི་སྨ་ར་སྐྱེས་པའི་བར་དུ་ཡེ་རུ་ཀོ་རུ་སྒུགས་ལ་དེ་ནས་ཕྱིར་ལོག་ཤོག་ཅེས་བསྒོས།"]},{"type":"verse","number":6,"content":["ཡང་ཨམ་མོན་པ་རྣམས་ཀྱིས་དཱ་བིད་ཁོ་རྣམས་ལ་ཤིན་ཏུ་སྡང་བ་ཤེས་པས། པེད་རེ་ཧོབ་ཀྱི་ཨ་རམ་པ་དང་། ཙོ་བཱ་ཡི་ཨ་རམ་པ་གཉིས་ལས་རྐང་དམག་མི་ཁྲི་གཉིས་དང་མ་ཨ་ཀཱ་ཡི་རྒྱལ་པོ་ལས་མི་ཆིག་སྟོང་དང་། ཏོབ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་བཅས་གླས་པའོ། །"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱིས་གཏམ་དེ་ཐོས་ནས་ཡོ་ཨབ་དང་དམག་མི་དཔའ་རྩལ་ཅན་ཐམས་ཅད་མཉམ་དུ་མངགས།"]},{"type":"verse","number":8,"content":["ཡང་ཨམ་མོན་པ་རྣམས་ཕྱི་རུ་ཐོན་ནས་མཁར་སྒོའི་མདུན་དུ་དམག་བཀྲམས་པ་དང་། ཙོ་བཱ་དང་རེ་ཧོབ་ཀྱི་ཨ་རམ་པ་དང་། ཏོབ་པ་དང་མ་ཨ་ཀཱ་པ་རྣམས་ཀྱིས་ཀྱང་སོ་སོར་མཁར་ཕྱི་རུ་དམག་བཀྲམས་ནས་བསྡད།"]},{"type":"verse","number":9,"content":["ཡོ་ཨབ་ཀྱིས་རང་གི་མདུན་རྒྱབ་གཉིས་སུ་དགྲ་ཡོད་པར་མཐོང་བས། ཡེས་ར་ཨེལ་གྱི་དམག་ཧྲག་ཐམས་ཅད་ལས་ཁག་ཅིག་བདམས་ནས་ཨ་རམ་པ་རྣམས་ལ་འཐབ་པར་དམག་བཀྲམས།"]},{"type":"verse","number":10,"content":["ཡང་མི་གཞན་ཐམས་ཅད་རང་གི་གཅུང་པོ་ཨ་བི་ཤཱ་ཨི་ལག་ཏུ་གཏད་ཅིང་། དེ་དག་ཨམ་མོན་པ་རྣམས་ལ་འཐབ་པར་དམག་བཀྲམས།"]},{"type":"verse","number":11,"content":["དེར་ཡོ་ཨབ་ཀྱིས་ཨ་བི་ཤཱ་ཨི་ལ། གལ་ཏེ་ཨ་རམ་པ་རྣམས་ང་ལས་སྟོབས་ཆེ་ན། ཁྱོད་ཀྱིས་ང་ལ་རོགས་བྱེད་དགོས་པ་དང་། གལ་ཏེ་ཨམ་མོན་པ་རྣམས་ཁྱོད་ལས་སྟོབས་ཆེ་ན་ང་ཁྱོད་ལ་རོགས་བྱེད་དུ་འོང་།"]},{"type":"verse","number":12,"content":["རང་ཅག་གིས་སྙིང་སྟོབས་བསྐྱེད་དགོས། བདག་ཅག་གི་ཡུལ་མི་དང་རང་རེའི་དཀོན་མཆོག་གི་གྲོང་ཁྱེར་རྣམས་ཀྱི་དོན་དུ་སྙིང་སྟོབས་བསྐྱེད་དགོས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་སྤྱན་ལམ་དུ་གང་ཞིག་ལེགས་པ་དེ་མཛད་པར་ཤོག་ཅེས་གདམས་པས།"]},{"type":"verse","number":13,"content":["ཡོ་ཨབ་འཁོར་དང་བཅས་པ་རྣམས་སོང་སྟེ་ཨ་རམ་པ་ལ་རྒོལ་བ་དང་། དེ་དག་ཁོའི་མདུན་ནས་བྲོས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་ཨམ་མོན་པ་རྣམས་ཀྱིས་ཨ་རམ་པ་རྣམས་བྲོས་ཟིན་པ་མཐོང་བས། དེ་དག་ཀྱང་ཨ་བི་ཤཱ་ཨིའི་མདུན་ནས་གྲོང་ཁྱེར་དུ་བྲོས། དེ་ནས་ཡོ་ཨབ་ནི་ཨམ་མོན་པ་རྣམས་དང་བྲལ་ནས་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིན་པ་རེད།"]},{"type":"verse","number":15,"content":["ཨ་རམ་པ་རྣམས་ཀྱིས་རང་ཉིད་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་ཕམ་པར་གྱུར་པ་ཤེས་ཏེ་ཡང་བསྐྱར་ལྷན་དུ་འདུས།"]},{"type":"verse","number":16,"content":["ཧ་དད་ཨི་སེར་གྱིས་བང་ཆེན་མངགས་ཤིང་། གཙང་པོའི་ཕ་རོལ་གྱི་ཨ་རམ་པ་རྣམས་སྦྲན་ནས་དེ་དག་ཧེ་ལཱམ་ཡུལ་དུ་སླེབས་པ་དང་། ཧ་དད་ཨི་སེར་གྱི་དམག་དཔོན་ཤོ་བག་བྱ་བ་ཡིས་དེ་དག་ལ་འགོ་ཁྲིད་བྱས།"]},{"type":"verse","number":17,"content":["མི་ཞིག་གིས་དོན་དེ་དཱ་བིད་ལ་ཞུས་པ་དང་ཁོང་གིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་བསྡུས་ཤིང་། ཡོར་དན་གཙང་པོ་བརྒལ་ནས་ཧེ་ལཱམ་དུ་སླེབས་ཏེ། ཨ་རམ་པ་རྣམས་ཀྱིས་དཱ་བིད་ལ་འཐབ་པར་དམག་བཀྲམས་པ་དང་དེ་ལ་འཐབ་འཛིང་བྱས་སོ། །"]},{"type":"verse","number":18,"content":["ཨ་རམ་པ་རྣམས་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་བྲོས་ཤིང་དཱ་བིད་ཀྱིས་ཨ་རམ་པའི་ཤིང་རྟ་བདུན་བརྒྱ་དང་སྐྱ་དམག་ཁྲི་བཞི་མེད་པར་བྱས་པ་དང་། ཨ་རམ་པའི་དཔུང་ཚོགས་ཀྱི་དམག་དཔོན་ཤོ་བག་ཀྱང་འགེམས་ནས་ཁོ་དེ་རུ་ཤིའོ། །"]},{"type":"verse","number":19,"content":["དེར་ཧ་དད་ཨི་སེར་གྱི་མངའ་འོག་ཏུ་ཡོད་པའི་རྒྱལ་པོ་རྣམས་ཀྱིས་རང་ཉིད་ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་ཕམ་ཟིན་པ་མཐོང་བས། ཡེས་ར་ཨེལ་པ་དང་མཐུན་པར་བྱས་ཤིང་དེའི་གཡོག་ཀྱང་བྱས། དེ་ལྟར་ཨ་རམ་པ་རྣམས་འཇིགས་ནས་ཡང་བསྐྱར་ཨམ་མོན་པ་རྣམས་ལ་རོགས་བྱེད་མ་ཕོད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2SA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/9.json","previousChapterAudioLinks":{},"numberOfVerses":19}