{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":11,"content":[{"type":"heading","content":["དཱ་བིད་དང་པད་ཤེ་བཱ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ལོ་གཅིག་འགོར་རྗེས་རྒྱལ་པོ་རྣམས་དམག་ལ་སྐྱོད་པའི་དུས་སུ། དཱ་བིད་ཀྱིས་ཡོ་ཨབ་དང་རང་གི་བློན་འཁོར་རྣམས་དང་། ཡེས་ར་ཨེལ་གྱི་དམག་དཔུང་ཐམས་ཅད་དམག་ལ་མངགས་ཤིང་། དེ་དག་གིས་ཨམ་མོན་པ་རྣམས་མེད་པར་བྱས་ནས་རབ་བཱ་དམག་གིས་བསྐོར་བ་དང་། དཱ་བིད་སྔར་བཞིན་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས་སོ། །"]},{"type":"verse","number":2,"content":["ཡང་ས་སྲོས་ཀྱི་དུས་སུ་དཱ་བིད་མལ་ནས་ལངས་ཏེ་ཕོ་བྲང་གི་ཁང་ཐོག་ནས་འཆམ་འཆམ་དུ་འགྲོ་སྐབས། ཁོང་གིས་འཁྲུད་བྱེད་པའི་བུད་མེད་ཅིག་མཐོང་ཞིང་། བུད་མེད་དེ་ནི་ཤིན་ཏུ་ཡིད་དབང་འཕྲོག་པ་ཞིག་ཡོད་པ་དང་།"]},{"type":"verse","number":3,"content":["དཱ་བིད་ཀྱིས་མི་མངགས་ནས་བུད་མེད་དེ་སུ་ཡིན་དྲིས་པ་ལ་མི་ཞིག་གིས། བུད་མེད་དེ་ནི་ཨེ་ལི་ཨམ་གྱི་བུ་མོ་སྟེ། ཧེད་པ་ཨུ་རི་ཡཱ་ཡི་ཆུང་མ་པད་ཤེ་བཱ་མ་ཡིན་ནམ་ཞེས་ཞུས།"]},{"type":"verse","number":4,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་མི་མངགས་ནས་བུད་མེད་དེ་ཁྲིད་འོངས་ཤིང་། ཁོ་མོ་དཱ་བིད་ཀྱི་རྩར་སླེབས་པ་དང་དཱ་བིད་མོ་དང་ལུས་འབྲེལ་བྱས་ཏེ། སྐབས་དེ་ནི་ཁོ་མོ་ཟླ་མཚན་ནས་གཙང་མར་གྱུར་པ་",{"noteId":10},"དང་འཁེལ། དེ་ནས་ཁོ་མོ་རང་ཁྱིམ་དུ་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":5,"content":["ཕྱིས་སུ་བུད་མེད་དེ་མངལ་དང་ལྡན་པར་གྱུར་པས་དཱ་བིད་ཀྱི་དྲུང་དུ་མི་མངགས་ནས་བདག་མངལ་དང་ལྡན་ནོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":6,"content":["དཱ་བིད་ཀྱིས་ཡོ་ཨབ་ཀྱི་མདུན་དུ་མི་མངགས་ནས་འདི་ལྟར། ཧེད་པ་ཨུ་རི་ཡཱ་ངའི་རྩར་ཐོངས་ཤིག་ཅེས་བཀའ་བསྩལ་པས། ཡོ་ཨབ་ཀྱིས་ཨུ་རི་ཡཱ་དཱ་བིད་ཀྱི་དྲུང་དུ་བརྫངས།"]},{"type":"verse","number":7,"content":["ཨུ་རི་ཡཱ་ཁོང་གི་དྲུང་དུ་ཕྱིན་ཅིང་ཁོང་གིས་ཡོ་ཨབ་དང་དམག་མི་རྣམས་དང་། གཡུལ་སའི་གནས་ཚུལ་ཅི་འདྲ་ཡིན་པ་དྲིས།"]},{"type":"verse","number":8,"content":["ཡང་དཱ་བིད་ཀྱིས་ཨུ་རི་ཡཱ་ལ། དེ་རིང་ཁྱིམ་དུ་སོང་ནས་རྐང་པ་ཁྲུས་ཤིག་",{"noteId":11},"ཅེས་བསྒོས་པར། ཨུ་རི་ཡཱ་རྒྱལ་པོའི་ཕོ་བྲང་ནས་ཐོན་ཞིང་། རྒྱལ་པོས་ཁོ་ལ་ལེགས་སྐྱེས་ཤིག་ཀྱང་གནང་ངོ་། །"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་ཨུ་རི་ཡཱ་རང་གི་ཇོ་བོའི་ཞབས་ཕྱི་དང་ལྷན་ཅིག་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྒོ་ཁ་རུ་གཉིད་དེ་རང་ཁྱིམ་དུ་མ་སོང་ངོ་། །"]},{"type":"verse","number":10,"content":["དེ་ནས་མི་དེ་དག་གིས་དཱ་བིད་ལ། ཨུ་རི་ཡཱ་མར་རང་ཁྱིམ་དུ་མ་སོང་བ་རེད་ཅེས་ཞུས་པ་དང་། དཱ་བིད་ཀྱིས་ཨུ་རི་ཡཱ་ལ། ཁྱོད་རྒྱང་རིང་ནས་འོངས་པ་མིན་ནམ། ཅིའི་ཕྱིར་མར་རང་ཁྱིམ་དུ་མ་སོང་ངམ་ཞེས་དྲིས་པའི་ལན་དུ།"]},{"type":"verse","number":11,"content":["ཨུ་རི་ཡཱས་དཱ་བིད་ལ། ཤུར་སྒམ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་དང་། ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་སྤྱིལ་བུའི་ནང་དུ་གནས་ཤིང་། བདག་གི་འགོ་དཔོན་ཡོ་ཨབ་དང་བདག་གི་ཇོ་བོའི་འཁོར་གཡོག་རྣམས་ཐང་རྒོད་དུ་སྒར་བཏབ་ནས་བསྡད་ཡོད་པས། བདག་ནི་རང་ཁྱིམ་དུ་ལོག་སྟེ་བཟའ་བཏུང་ལ་རོལ་འོས་སམ། ཆུང་མ་དང་མཉམ་དུ་འགྲོགས་རུང་ངམ། བདག་གིས་རྒྱལ་པོ་ཁྱེད་དང་ཁྱེད་ཀྱི་སྐུ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། བདག་གིས་དེ་ལྟ་བུ་གཏན་ནས་བྱ་མི་ཕོད་ཅེས་ཞུས།"]},{"type":"verse","number":12,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་ཨུ་རི་ཡཱ་ལ། ཁྱོད་དེ་རིང་ཡང་འདིར་ཞག་སྡོད་གྱིས་ཤིག སང་ཉིན་ངས་ཁྱོད་མངག་པར་བྱ་ཞེས་བཀའ་བསྩལ་ཅིང་། ཨུ་རི་ཡཱ་ཉིན་དེ་དང་དེའི་ཕྱི་ཉིན་ཡེ་རུ་སཱ་ལེམ་དུ་ལུས་སོ། །"]},{"type":"verse","number":13,"content":["དེའི་ཕྱི་ཉིན་དཱ་བིད་ཀྱིས་ཨུ་རི་ཡཱ་བོས་པ་དང་། དེས་ཁོང་གི་དྲུང་དུ་བཟའ་བཏུང་ལ་རོལ་ཞིང་ཁོང་གིས་དེ་བཟི་རུ་བཅུག མཚན་མོར་ཁོ་རང་གི་ཇོ་བོའི་ཞབས་ཕྱི་རྣམས་དང་མཉམ་དུ་རང་གི་མལ་སར་གཉིད་ནས་སྔར་བཞིན་རང་ཁྱིམ་དུ་མ་སོང་ངོ་། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཨུ་རི་ཡཱ་ལྐོག་ནས་བསད་པ།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཞོགས་པར་དཱ་བིད་ཀྱིས་ཡོ་ཨབ་ལ་འཕྲིན་ཡིག་ཅིག་བྲིས་ཤིང་ཨུ་རི་ཡཱའི་ལག་ཏུ་སྤྲད་ནས་བསྐུར་ཏོ། །"]},{"type":"verse","number":15,"content":["འཕྲིན་ཡིག་དེའི་ནང་འདི་ལྟར། འཐབ་འཛིང་ཤིན་ཏུ་ཛ་དྲག་ཆེ་བའི་དུས་སུ་ཨུ་རི་ཡཱ་མདུན་དུ་ཐོངས་ཤིག ཁྱོད་ཅག་དེ་ལས་ཕྱི་སྣུར་བྱས་ནས་ཁོ་རང་རྨས་ཏེ་འཆི་བར་གྱིས་ཞེས་བྲིས་སོ། །"]},{"type":"verse","number":16,"content":["སྐབས་དེར་ཡོ་ཨབ་ཀྱིས་གྲོང་ཁྱེར་བསྐོར་ཞིང་། ཁོས་སྲུང་དམག་དཔའ་སྟོབས་ཅན་རྣམས་གནས་གང་དུ་ཡོད་པ་ཤེས་པས། ཨུ་རི་ཡཱ་གནས་དེ་རུ་མངགས་པ་རེད།"]},{"type":"verse","number":17,"content":["ཡང་གྲོང་ཁྱེར་གྱི་མི་རྣམས་ཕྱི་རུ་ཐོན་ཏེ་ཡོ་ཨབ་འཁོར་དང་བཅས་པར་འཐབ་ཅིང་། དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ལས་འགའ་ཤས་འཆི་བར་གྱུར་པ་དང་། ཧེད་པ་ཨུ་རི་ཡཱ་ཡང་ཤིའོ། །"]},{"type":"verse","number":18,"content":["དེར་ཡོ་ཨབ་ཀྱིས་མི་མངགས་ནས་དམག་འཁྲུག་གི་གནས་ཚུལ་ཐམས་ཅད་དཱ་བིད་ལ་ཞུས་ཤིང་།"]},{"type":"verse","number":19,"content":["ཡང་བང་ཆེན་དེ་ལ་བཀའ་བསྩལ་ཏེ་འདི་ལྟར། ཁྱོད་ཀྱིས་དམག་འཁྲུག་གི་གནས་ཚུལ་ཐམས་ཅད་རྒྱལ་པོར་ཞུས་རྗེས།"]},{"type":"verse","number":20,"content":["གལ་ཏེ་རྒྱལ་པོ་ཐུགས་ཁྲོས་ནས་ཁྱོད་ལ། ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་གྲོང་ཁྱེར་དེའི་ཉེ་སར་དམག་འཁྲུག་བརྒྱབ་པ་ཡིན་ནམ། དེ་དག་གིས་མཁར་ཁ་ནས་མདའ་འཕེན་པ་མི་ཤེས་སམ།"]},{"type":"verse","number":21,"content":["སྔར་ཡེ་རུབ་བེ་ཤེད་ཀྱི་བུ་ཨ་བི་མེ་ལེག་གསོད་མཁན་དེ་སུ་ཡིན་ནམ། བུད་མེད་ཅིག་གིས་མཁར་ཁ་ནས་ཁོའི་སྟེང་དུ་འཐག་རྡོ་འཕངས་ནས་ཁོ་ཐེ་བེ་སི་ཡུལ་དུ་ཤི་བ་མ་ཡིན་ནམ། ཁྱོད་རྣམས་མཁར་གྱི་ཉེ་སར་བཅར་བ་ཅི་ཞེས་དྲིས་ན། ཁྱོད་ཀྱིས་ཁོང་ལ་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཧེད་པ་ཨུ་རི་ཡཱ་ཡང་ཚེ་ལས་འདས་སོང་ཞེས་ཞུ་བར་གྱིས་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":22,"content":["བང་ཆེན་སོང་སྟེ་སླེབས་པ་དང་། ཡོ་ཨབ་ཀྱིས་ཁོ་རང་མངགས་ནས་འཕྲིན་ཇི་དང་ཇི་བསྐུར་བ་ཐམས་ཅད་དཱ་བིད་ལ་ཞུས།"]},{"type":"verse","number":23,"content":["ཡང་བང་ཆེན་དེས་དཱ་བིད་ལ། མི་དེ་དག་ནི་ངེད་ཅག་ལས་སྟོབས་ཆེ་ཞིང་། ཁོ་རྣམས་ཐང་རྒོད་དུ་སླེབས་ནས་ངེད་ཅག་ལ་འཐབ་པ་དང་། ངེད་ཅག་གིས་དེ་དག་མཁར་སྒོ་རུ་དེད་ནས་སོང་བ་ལ།"]},{"type":"verse","number":24,"content":["མདའ་པས་མཁར་ཁ་ནས་ཁྱེད་ཀྱི་ཞབས་ཕྱི་རྣམས་ལ་མདའ་ཡིས་བརྒྱབ་པས། རྒྱལ་པོའི་ཞབས་ཕྱི་འགའ་ཞིག་སྟེ། ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཧེད་པ་ཨུ་རི་ཡཱ་ཡང་བསད་དོ་ཞེས་ཞུས།"]},{"type":"verse","number":25,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་བང་ཆེན་དེ་ལ། ཁྱོད་ཀྱིས་ཡོ་ཨབ་ལ་འདི་ལྟར། རལ་གྲིས་མི་སུ་དང་སུ་ཡང་གསོད་ངེས་ལ། བྱ་བ་དེའི་ཕྱིར་དུ་ཁྱོད་རང་སེམས་མི་སྡུག་པར་བྱའོ། །ཁྱོད་ཀྱིས་གྲོང་ཁྱེར་དེར་དམག་འཁྲུག་རྒྱག་ཤུགས་ཆེ་རུ་བཏང་ནས་དེ་རྩ་མེད་དུ་གཏོང་དགོས་ཞེས་ཁོ་ལ་སྐུལ་སློང་གྱིས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ཨུ་རི་ཡཱ་ཡི་ཆུང་མས་རང་གི་ཁྱོ་ག་ཤི་བའི་གཏམ་ཐོས་པས་རང་གི་ཁྱོ་གའི་དོན་དུ་མྱ་ངན་བྱས།"]},{"type":"verse","number":27,"content":["སྡུག་གི་ཉི་མ་རྫོགས་པ་དང་དཱ་བིད་ཀྱིས་མི་མངགས་ཤིང་། བུད་མེད་དེ་རང་གི་ཕོ་བྲང་དུ་བླངས་ནས་དེ་ཁོང་གི་ཆུང་མར་གྱུར་ཏེ་བུ་ཞིག་བཙས་མོད། དཱ་བིད་ཀྱིས་བྱས་པའི་བྱ་བ་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་མ་དགྱེས་སོ། །"]}],"footnotes":[{"noteId":10,"caller":"+","text":"ཡེས་ར་ཨེལ་པའི་སྲོལ་ལྟར་ན། བུད་མེད་ཅིག་ལ་ཟླ་མཚན་ཡོང་ནས་ཆད་རྗེས་ཉིན་བདུན་འགོར་བ་ན་ད་གཟོད་བུད་མེད་དེ་གཙང་མར་རྩི་བ་ཡིན།","reference":{"chapter":11,"verse":4}},{"noteId":11,"caller":"+","text":"འདིར་རྐང་པ་ཁྲུས་ཤིག་ཅེས་པ་ནི་ལྷོད་ལྷོད་ངང་རང་གི་ཆུང་མ་དང་མཉམ་དུ་འདུག་པའི་དོན་ཡིན།","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/bod_ntb/2SA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/10.json","previousChapterAudioLinks":{},"numberOfVerses":27}