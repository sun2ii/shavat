{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":12,"content":[{"type":"heading","content":["ནཱ་ཐན་གྱིས་དཱ་བིད་ལ་བཀའ་བཀྱོན་གནང་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ནཱ་ཐན་བྱ་བ་དཱ་བིད་ཀྱི་མདུན་དུ་མངགས་པ་དང་། ནཱ་ཐན་ཁོའི་རྩར་ཕྱིན་ནས་ཁོང་ལ། གྲོང་ཁྱེར་ཞིག་ཏུ་མི་གཉིས་ཡོད་ཅིང་། གཅིག་ནི་ཕྱུག་པོ་དང་གཞན་དེ་དབུལ་པོ་ཡིན།"]},{"type":"verse","number":2,"content":["ཕྱུག་པོ་དེ་ལ་ར་ལུག་དང་བ་གླང་གི་ཁྱུ་ཤིན་ཏུ་མང་པོ་ཡོད་པ་དང་།"]},{"type":"verse","number":3,"content":["དབུལ་པོ་དེ་ལ་ཉོས་ནས་གསོས་པའི་ལུ་གུ་མོ་ཆུང་ཆུང་གཅིག་ལས་གཞན་ཅི་ཡང་མེད་པ་ཡིན། ལུ་གུ་དེ་ནི་མི་དེའི་ཁྱིམ་ནས་རང་གི་ཕྲུ་གུ་རྣམས་དང་མཉམ་དུ་འཚར་ལོངས་བྱུང་། ལུ་གུ་དེས་ཁོའི་ཁ་ཟས་སྤྱད་ཅིང་ཕོར་བ་ལས་འཐུང་བ་དང་པང་ནས་ཉལ་ཏེ། མི་དེའི་བུ་མོ་ལྟ་བུ་ཡིན།"]},{"type":"verse","number":4,"content":["དེར་མི་ཕྱུག་པོའི་ཁྱིམ་དུ་མགྲོན་པོ་ཞིག་སླེབས་པ་དང་། ཁོས་རང་གི་བ་ཁྱུ་དང་ལུག་ཁྱུ་ནས་གཅིག་བཟུང་སྟེ་རང་གི་རྩར་སླེབས་པའི་མགྲོན་པོ་དེར་མགྲོན་བྱེད་པར་བློས་མ་ཐོངས་པས། མི་དབུལ་པོ་དེའི་ལུ་གུ་མོ་བཟུང་ནས་མགྲོན་པོ་དེར་ཟས་སུ་གཡོས་སོ་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":5,"content":["དཱ་བིད་མི་དེ་ལ་རབ་ཏུ་ཁྲོས་ནས་ནཱ་ཐན་ལ། ངས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། ལས་དེ་ལྟ་བུ་བྱེད་མཁན་ནི་འཆི་བར་འོས།"]},{"type":"verse","number":6,"content":["ཡང་མི་དེས་སྙིང་རྗེ་མེད་པར་ལས་འདི་ལྟ་བུ་བྱས་པས། ལུ་གུ་དེའི་སྐྱིན་ཚབ་ཏུ་ལྡབ་བཞི་འཇལ་དགོས་ཞེས་གསུངས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ནཱ་ཐན་གྱིས་དཱ་བིད་ལ། མི་དེ་ཁྱོད་རང་ཡིན་ནོ། །ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ངས་ཁྱོད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བྱུགས་ཏེ་སོ་ལོའི་ལག་ནས་བསྐྱབས་པ་དང་།"]},{"type":"verse","number":8,"content":["ངས་ཁྱོད་ཀྱི་བདག་པོའི་ཁང་པ་དང་། བདག་པོའི་ཆེན་ཆུན་རྣམས་ཁྱོད་ལ་གནང་ཞིང་། ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་ཁྱིམ་རྒྱུད་གཉིས་ཁྱོད་ལ་སྤྲད་དོ། །གལ་ཏེ་ད་དུང་མི་འདང་ཚེ། ངས་ཁྱོད་ལ་དེ་ལས་ལྷག་པ་སྤྲད་ཆོག་ཆོག་ཡིན།"]},{"type":"verse","number":9,"content":["ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་སྣང་མེད་དུ་བཏང་སྟེ། ཁོང་གིས་ངན་པར་གཟིགས་པའི་ལས་སྤྱད་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་ཧེད་པ་ཨུ་རི་ཡཱ་རལ་གྲིས་བསད་ནས་ཁོའི་ཆུང་མ་རང་གི་ཆུང་མར་བླངས་ཏེ། ཁྱོད་ཀྱིས་ཨམ་མོན་པ་རྣམས་ཀྱི་རལ་གྲིས་ཁོ་བསད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེའི་ཕྱིར་ད་ནས་བཟུང་ཁྱོད་ཀྱི་ཁྱིམ་དུ་རལ་གྲི་རྒྱུན་ཆད་པར་མི་འགྱུར་རོ། །དེ་ནི་ཁྱོད་ཀྱིས་ང་རང་སྣང་མེད་དུ་བཏང་བར་མ་ཟད། ཧེད་པ་ཨུ་རི་ཡཱ་ཡི་ཆུང་མ་དེ་ཁྱོད་རང་གི་ཆུང་མར་བླངས་པའི་རྐྱེན་གྱིས་སོ་ཞེས་དང་།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ཁྱོད་རང་གི་ཁྱིམ་ནས་ཆག་སྒོ་བསླངས་ཏེ་ཁྱོད་ལ་རྒོལ་བར་བྱའོ། །ངས་ཁྱོད་ཀྱི་ཆུང་མ་རྣམས་ཁྱོད་རང་གི་མིག་མདུན་ནས་ཁྱེར་ཏེ་ཁྱོད་ཀྱི་འགྲོགས་ཡ་ལ་གནང་བར་མ་ཟད། དེས་ཉི་མ་ཁ་དཀར་ངོ་དཀར་ལ་ཁྱོད་ཀྱི་ཆུང་མ་རྣམས་དང་ལུས་འབྲེལ་བྱའོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་ལྐོག་ནས་དེ་ལྟར་བྱས་ཤིང་། ངས་ཡེས་ར་ཨེལ་གྱི་མདུན་དུ་ཉི་མ་ཁ་དཀར་ངོ་དཀར་ལ་དེ་བཞིན་བྱས་ཏེ་ཁྱོད་ལ་ལན་སློག་པར་བྱ་ཞེས་གསུངས་ཞེས་སྦྲན་པ་དང་།"]},{"type":"verse","number":13,"content":["དཱ་བིད་ཀྱིས་ནཱ་ཐན་ལ། བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་སྡིག་པ་བྱས་པ་ཡིན་ཞེས་ཞུས་པར། ནཱ་ཐན་གྱིས་དཱ་བིད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་སྡིག་པ་སེལ་བས། ཁྱོད་ནི་འཆི་བར་མི་འགྱུར།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཁྱོད་ཀྱིས་ལས་དེ་བྱས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དགྲ་རྣམས་ལ་ཁོང་ལ་སྐུར་བ་འདེབས་པའི་གླགས་སྤྲད་པས། ཁྱོད་ལ་བཙས་པའི་བུ་དེ་འཆི་བར་འགྱུར་རོ་ཞེས་གསུངས།"]},{"type":"verse","number":15,"content":["དེ་ནས་ནཱ་ཐན་རང་གི་ཁྱིམ་དུ་བཞུད་ཅིང་། ཨུ་རི་ཡཱ་ཡི་ཆུང་མས་བཙས་པའི་དཱ་བིད་ཀྱི་བུ་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་བརྡེགས་པ་དང་དེར་ན་ཚ་ལྗིད་མོ་ཕོག་པ་རེད།"]},{"type":"heading","content":["དཱ་བིད་ཀྱི་བུ་ཤི་བ།"]},{"type":"verse","number":16,"content":["དཱ་བིད་ཀྱིས་བུ་དེའི་དོན་དུ་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ་ནས་སྨྱུང་གནས་བསྲུངས་པ་དང་། ཁང་པའི་ནང་དུ་སོང་ནས་མཚན་གང་པོར་ས་རུ་ཉལ་བསྡད་དོ། །"]},{"type":"verse","number":17,"content":["དེར་ཁོང་གི་ཞབས་ཕྱི་རྒན་པ་ཞིག་ཁོང་གི་གམ་དུ་ལངས་བསྡད་ནས་ཁོང་ས་ནས་ཡར་སློང་འདོད་ཀྱང་། ཁོང་ཡར་ལངས་མ་འདོད་ལ་དེ་དག་དང་ལྷན་ཅིག་ཏུ་ཁ་ཟས་ཀྱང་མ་སྤྱད་དོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་ཉིན་བདུན་པ་ལ་བུ་དེ་ཤིའོ། །དཱ་བིད་ཀྱི་བློན་འཁོར་རྣམས་ཀྱིས་ཕྲུ་གུ་ཤི་བའི་གཏམ་ཁོང་ལ་ཞུ་བར་མ་ཕོད་དེ། དེ་དག་གིས། ལྟོས་དང་། ཕྲུ་གུ་དེ་གསོན་པོར་ཡོད་པའི་ཚེ་བདག་ཅག་གིས་ཁོང་ལ་གཏམ་བྱས་ཀྱང་ཁོང་གིས་མི་མཉན་པས། ད་ནི་བདག་ཅག་གིས་ཁོང་ལ་བུ་ཤི་ཟིན་ཞེས་ཅི་ལྟར་ཞུ་ཕོད་དམ། ཁོང་གིས་གཞན་ལ་གནོད་བསྐྱལ་ཡང་སྲིད་ཅེས་གཏམ་བྱས་སོ། །"]},{"type":"verse","number":19,"content":["དཱ་བིད་ཀྱིས་རང་གི་བློན་འཁོར་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་སྐད་ཆ་ཤབ་ཤུབ་སྨྲ་བ་མཐོང་ནས་བུ་ཤི་ཟིན་པ་ཤེས་ཤིང་། རང་གི་བློན་འཁོར་རྣམས་ལ། བུ་ཤི་ཟིན་ནམ་ཞེས་དྲིས་པ་ལ་དེ་དག་གིས། ཤི་ཟིན་ནོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":20,"content":["དེར་དཱ་བིད་ས་ནས་ཡར་ལངས་ཏེ་ཁྲུས་བྱས་ཤིང་སྣུམ་བྱུགས་པ་དང་། ན་བཟའ་བརྗེས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཞུགས་གནས་སུ་ཕེབས་ཏེ་ཕྱག་ཕུལ་ཏོ། །དེ་ནས་རང་གི་ཁྱིམ་དུ་ལོག་སྟེ་མི་ཡིས་ཁོང་གི་བཀའ་བཞིན་ཁ་ཟས་དྲངས་པ་ལ་ཁོང་གིས་བཞེས་སོ། །"]},{"type":"verse","number":21,"content":["དེར་ཁོང་གི་བློན་འཁོར་རྣམས་ཀྱིས་ཁོང་ལ། ཁྱེད་ཀྱིས་མཛད་པ་དེ་ཅི་ལགས། བུ་གསོན་པོར་ཡོད་པའི་ཚེ་ཁྱེད་ཀྱིས་བུ་ཡི་ཕྱིར་དུ་སྨྱུང་གནས་བསྲུངས་ནས་ངུས་པ་དང་། བུ་ཤི་ཟིན་པའི་ཚེ་ན། ཁྱེད་ཡར་བཞེངས་ནས་གསོལ་བ་བཞེས་སོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":22,"content":["ཁོང་གིས་དེའི་ལན་དུ། ཕྲུ་གུ་ད་དུང་གསོན་པའི་ཚེ་ངས་སྨྱུང་གནས་བསྲུངས་ནས་ངུ་བཞིན་བསྡད་པ་ནི། ངས་སེམས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ལ་སྙིང་རྗེ་དགོངས་ནས་ཕྲུ་གུ་གསོན་པོར་བསྐྱུར་ཡང་སྲིད་སྙམ་པ་ཡིན།"]},{"type":"verse","number":23,"content":["ད་ནི་ཕྲུ་གུ་ཤི་ཟིན་པས། བདག་གིས་ཅིའི་ཕྱིར་སྨྱུང་གནས་སྲུང་ངམ། ངས་ཁོ་རང་ཕྱིར་འགུག་ནུས་སམ། ང་ཁོའི་རྩར་འགྲོ་རྒྱུ་ཡིན་མོད། འོན་ཀྱང་ཁོ་ནི་ཕྱིར་ངའི་རྩར་འོང་མི་ནུས་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["སོ་ལོ་མོན་འཁྲུངས་པ།"]},{"type":"verse","number":24,"content":["དཱ་བིད་ཀྱིས་རང་གི་ཆུང་མ་པད་ཤེ་བཱ་ལ་སེམས་གསོ་བྱས་ཤིང་། ཁོ་མོའི་རྩར་སོང་ནས་མཉམ་དུ་འགྲོགས་པ་ལ། བུད་མེད་དེས་བུ་ཞིག་བཙས་པ་དང་དེའི་མིང་ལ་སོ་ལོ་མོན་ཞེས་བཏགས་སོ། །དཀོན་མཆོག་ཡ་ཝཱེས་ཀྱང་དེ་ལ་གཅེས་པར་གྱུར་ཏེ།"]},{"type":"verse","number":25,"content":["ལུང་སྟོན་པ་ནཱ་ཐན་མངགས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ། དེའི་མིང་ལ་ཨེ་དིད་ཡཱ་",{"noteId":12},"ཞེས་བཏགས་སོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་རབ་བཱ་ཞེས་པའི་གྲོང་ཁྱེར་བླངས་པ།"]},{"type":"verse","number":26,"content":["དེའི་དུས་སུ་ཡོ་ཨབ་ཀྱིས་ཨམ་མོན་པའི་གྲོང་ཁྱེར་རབ་བཱ་ལ་དམག་དྲངས་ནས་རྒྱལ་ས་དེ་བཟུང་ངོ་། །"]},{"type":"verse","number":27,"content":["དེ་ནས་ཡོ་ཨབ་ཀྱིས་དཱ་བིད་ཀྱི་དྲུང་དུ་བང་ཆེན་མངགས་ནས་ཁོང་ལ། ངས་རབ་བཱ་ལ་དམག་བརྒྱབ་སྟེ་ཆུ་མཛོད་རྣམས་ཀྱང་བླངས་ཟིན་པས།"]},{"type":"verse","number":28,"content":["ད་ལྟ་ཁྱེད་ཀྱིས་འབངས་གཞན་དག་བསྡུས་ཤིག སྒར་བཏབ་སྟེ་གྲོང་ཁྱེར་དེ་ལ་རྒོལ་ནས་དེ་ལེན་ཐབས་གྱིས་ཤིག དེ་མིན་ན་གྲོང་ཁྱེར་དེ་ངས་བླངས་པའི་ཚེ། མི་རྣམས་ཀྱིས་ངའི་མིང་དེ་ལ་འདོགས་པར་འགྱུར་རོ་ཞེས་འཕྲིན་བསྐུར་བ་དང་།"]},{"type":"verse","number":29,"content":["དཱ་བིད་ཀྱིས་འབངས་ཐམས་ཅད་བསྡུས་ཤིང་རབ་བཱ་ལ་དམག་དྲངས་པ་དང་དེར་རྒོལ་ནས་རྒྱལ་ཁ་བླངས་སོ། །"]},{"type":"verse","number":30,"content":["དཱ་བིད་ཀྱིས་ཡུལ་དེའི་རྒྱལ་པོའི་",{"noteId":13},"མགོ་ནས་ཅོད་པན་ཕྲོགས། རྒྱལ་པོའི་ཅོད་པན་སྟེང་གི་གསེར་ནི་རྡོ་ཚད་གཅིག་ཡོད་པ་དང་དེའི་སྟེང་ལ་རིན་པོ་ཆེའི་ཕྲ་བཏབ་ཡོད་ལ། མི་རྣམས་ཀྱིས་ཅོད་པན་དེ་དཱ་བིད་ཀྱི་དབུ་ལ་བསྐོན། དཱ་བིད་ཀྱིས་གྲོང་ཁྱེར་དེ་ལས་ད་དུང་བཅོམ་ནོར་དཔག་མེད་ཁྱེར་ཏོ། །"]},{"type":"verse","number":31,"content":["ཡང་ཁོང་གིས་གྲོང་ཁྱེར་དེའི་མི་རྣམས་ཕྱི་རུ་ཁྲིད་ནས། དེ་དག་ལ་སོག་ལེ་དང་། ལྕགས་སྤར་དང་། ལྕགས་ཀྱི་སྟ་རེ་བཅས་བཀོལ་དུ་བཅུག་པ་དང་། ཡང་ན་སོ་ཕག་སྲེག་ཁུང་དུ་ལས་ཀ་བྱེད་དུ་བཅུག",{"noteId":14},"ཁོང་གིས་ཨམ་མོན་པ་རྣམས་ཀྱི་གྲོང་ཁྱེར་ཐམས་ཅད་ལ་དེ་བཞིན་བྱས་ནས། དཱ་བིད་དང་འབངས་ཐམས་ཅད་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་གོ །"]}],"footnotes":[{"noteId":12,"caller":"+","text":"ཨེ་དིད་ཡཱ་ཞེས་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གཅེས་པའི་མི་ཞེས་པའི་དོན་ཡིན།","reference":{"chapter":12,"verse":25}},{"noteId":13,"caller":"+","text":"འདིར་རྒྱལ་པོ་ཞེས་པ་ནི་ཁོ་ཚོའི་ལྷ་མའོ་ལག་ཅེས་པར་གོ་དགོས།","reference":{"chapter":12,"verse":30}},{"noteId":14,"caller":"+","text":"འདིར་མ་ཕྱི་ལས་དེ་དག་སོག་ལེ་དང་ལྕགས་སྤར། ལྕགས་ཀྱི་སྟ་རེ་བཅས་ཀྱི་འོག་ཏུ་བཞག་པ་དང་། ཡང་ན་སོ་ཕག་སྲེག་ཁུང་བརྒྱུད་ནས་འགྲོ་རུ་བཅུག་ཅེས་མཐོང་།","reference":{"chapter":12,"verse":31}}]},"thisChapterLink":"/api/bod_ntb/2SA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/11.json","previousChapterAudioLinks":{},"numberOfVerses":31}