{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":13,"content":[{"type":"heading","content":["ཨམ་ནོན་དང་ཐལ་མཱར།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་དོན་ཞིག་བྱུང་བ་འདི་ལྟ་སྟེ། དཱ་བིད་ཀྱི་བུ་ཨབ་ཤཱ་ལོམ་ལ་སྲིང་མོ་བཞིན་བཟང་མ་ཐལ་མཱར་བྱ་བ་ཞིག་ཡོད་པ་ལ། དཱ་བིད་ཀྱི་བུ་ཨམ་ནོན་གྱི་སེམས་དེ་ལ་འཕྲེང་བར་གྱུར།"]},{"type":"verse","number":2,"content":["ཨམ་ནོན་རང་གི་ཕ་གཅིག་མ་མི་གཅིག་པའི་སྲིང་མོ་ཐལ་མཱར་ལ་སེམས་འཕྲེང་བའི་སྡུག་བསྔལ་གྱིས་ན་བར་གྱུར་ཏོ། །ཐལ་མཱར་ནི་ད་དུང་ན་ཆུང་བུ་མོ་ཡིན་པས་ཨམ་ནོན་གྱིས་དེ་ལ་གང་ཞིག་བྱེད་འདོད་ཀྱང་དཀའ་བའི་གནས་སུ་ལྷུང་།"]},{"type":"verse","number":3,"content":["ཨམ་ནོན་ལ་མཛའ་གྲོགས་ཤིག་ཡོད་དེ་མིང་ལ་ཡོ་ན་དབ་ཅེས་ཟེར་ཞིང་། དེ་ནི་དཱ་བིད་ཀྱི་གཅེན་པོ་ཤིམ་ཨ་ཡི་བུ་ཡིན་ཏེ་མི་ཤིན་ཏུ་སྤྱང་པོ་ཞིག་ཡིན།"]},{"type":"verse","number":4,"content":["དེས་ཨམ་ནོན་ལ། རྒྱལ་སྲས་ལགས། ཁྱེད་རང་ཞོགས་པ་རེ་རེ་བཞིན་རིད་པ་དེ་ཅི་ཡིན། ཁྱེད་ཀྱིས་ང་ལ་སྨྲ་བར་མི་མཛད་དམ་ཞེས་ཞུས་པར། ཨམ་ནོན་ན་རེ། ང་ནི་རང་གི་གཅེན་པོ་ཨབ་ཤཱ་ལོམ་གྱི་སྲིང་མོ་ཐལ་མཱར་ལ་དགའ་བྱུང་ཞེས་སྨྲས།"]},{"type":"verse","number":5,"content":["དེར་ཡོ་ན་དབ་ཀྱིས་ཁོ་ལ། ཁྱེད་མལ་སའི་ནང་ཉལ་ཏེ་ན་ཁུལ་གྱིས་ཤིག ཁྱེད་ཀྱི་ཡབ་ཁྱེད་ལ་གཟིགས་པར་འོངས་སྐབས་ཁྱེད་ཀྱིས་ཁོང་ལ། ངའི་སྲིང་མོ་ཐལ་མཱར་འདིར་མངགས་ནས་ང་ལ་ཁ་ཟས་སྟེར་བར་མཛོད་དང་། ཡང་ངས་དངོས་སུ་མཐོང་བ་དང་དེའི་ལག་ནས་ཁ་ཟས་བླངས་ཏེ་བཟའ་བའི་ཕྱིར་མོས་ངའི་མཐོང་སར་ཁ་ཟས་སྟ་གོན་བྱེད་པར་མཛད་རོགས་ཞེས་ཞུས་ཤིག་ཅེས་བསླབས་པ་དང་།"]},{"type":"verse","number":6,"content":["ཨམ་ནོན་ཉལ་བསྡད་ནས་ན་རྫུ་བཏབ་ཅིང་། རྒྱལ་པོ་ཁོ་ལ་གཟིགས་པར་འོངས་པའི་ཚེ། ཨམ་ནོན་གྱིས་རྒྱལ་པོ་ལ། ངའི་སྲིང་མོ་ཐལ་མཱར་འདིར་འོང་བར་གནོངས་ཤིག་དང་། དེས་ངའི་མཐོང་ས་རུ་བདག་ལ་བག་ལེབ་གཉིས་བསྲེགས་ན་ངས་དེའི་ལག་ནས་བླངས་ཏེ་བཟའ་བར་བྱ་ཞེས་ཞུས་པར།"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱིས་ཕོ་བྲང་ནང་མི་མངགས་ཏེ་ཐལ་མཱར་གྱི་རྩར་སོང་ནས་དེ་ལ། ཁྱོད་རང་གི་ཕུ་བོ་ཨམ་ནོན་གྱི་ཁང་པར་སོང་སྟེ་ཁོ་ལ་ཁ་ཟས་གཡོས་ཤིག་ཅེས་བསྒོས་པས།"]},{"type":"verse","number":8,"content":["ཐལ་མཱར་རང་གི་ཕུ་བོ་ཨམ་ནོན་གྱི་ཁང་པར་ཕྱིན་ཏེ་ཁོ་རང་མལ་སར་ཉལ་ཡོད་པ་མཐོང་། དེ་ནས་ཁོ་མོས་ཕྱེ་བླངས་ནས་བརྫིས་ཏེ་ཁོའི་མཐོང་ས་རུ་བག་ལེབ་བསྲེགས་ཤིང་ཚོས་པ་ལ།"]},{"type":"verse","number":9,"content":["ཁོ་མོས་སླ་ང་ནས་བག་ལེབ་བླངས་ཏེ་ཨམ་ནོན་ལ་དྲངས་པ་ན་ཁོས་མ་ཟོས་པ་དང་། ཁོ་ན་རེ། མི་ཐམས་ཅད་ངའི་མདུན་ནས་ཕྱི་རུ་སོང་ཞིག་ཅེས་སྨྲས་པར། མི་ཐམས་ཅད་ཁོ་དང་བྲལ་ནས་སོང་།"]},{"type":"verse","number":10,"content":["དེར་ཨམ་ནོན་གྱིས་ཐལ་མཱར་ལ། ངས་ཁྱོད་ཀྱི་ལག་ནས་བླངས་ཏེ་བཟའ་ཕྱིར་ཁ་ཟས་གཟིམ་ཁང་དུ་འཁྱེར་ཤོག་སྨྲས་པས། ཐལ་མཱར་གྱིས་རང་གིས་བསྲེགས་པའི་བག་ལེབ་རྣམས་བླངས་ནས། གཟིམ་ཁང་དུ་རང་གི་ཕུ་བོ་ཨམ་ནོན་གྱི་གམ་དུ་སླེབས་ཏེ།"]},{"type":"verse","number":11,"content":["མདུན་དུ་བཅར་ནས་ཁོ་ལ་ཁ་ཟས་དྲངས་པའི་ཚེ། ཁོས་མོ་ལ་འཇུས་ནས་ན་རེ། ངའི་སྲིང་མོ། ང་དང་མཉམ་དུ་ཉོལ་ཞིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":12,"content":["ཁོ་མོས་ལན་དུ། ཕུ་བོ་ལགས། དེ་ལྟར་བྱེད་མི་རུང་། ང་ལ་བཙན་མི་བཀོལ་རོགས། ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ལས་དེ་ལྟ་བུ་བྱེད་མི་རུང་། ཁྱོད་ཀྱིས་སྐྱུག་བྲོ་བའི་ལས་འདི་མ་བྱེད་ཅིག"]},{"type":"verse","number":13,"content":["ཡང་ངས་རང་གི་ངོ་ཚ་ཁུར་ནས་གང་དུ་འགྲོའམ། ཁྱོད་ལ་མཚོན་ནའང་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་མི་བླུན་རྨོངས་ཤིག་ཏུ་འགྱུར་ངེས་ཡིན། ད་ལྟ་ཁྱོད་ཀྱིས་རྒྱལ་པོ་ལ་ཞུ་བ་ཕུལ་དང་། ཁོང་གིས་ང་ཁྱོད་ལ་གནང་བར་གདོན་མི་ཟ་ཞེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":14,"content":["ཨམ་ནོན་གྱིས་མོའི་གཏམ་ལ་མ་མཉན་པར། ཁོ་ནི་མོ་ལས་ཤུགས་ཆེ་བས་ཁོ་མོར་བཙན་གཡེམ་བྱས་ཤིང་མཉམ་དུ་ཉལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ཨམ་ནོན་མོ་ལ་ཤིན་ཏུ་སྡང་བ་སྟེ། ཁོ་མོར་སྡང་བའི་སེམས་ནི་སྔར་དེ་ལ་འཕྲེང་བའི་གདུང་བ་ལས་ཀྱང་ཐུ་ཞིང་ཁོ་མོར་ན་རེ། ཁྱོད་ཡར་ལོངས་ལ་ཕར་སོང་ཞིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":16,"content":["ཐལ་མཱར་གྱིས་ཨམ་ནོན་ལ། འདི་ལྟར་མི་བྱེད་རོགས། ཁྱོད་ཀྱིས་ང་ཕྱི་རུ་འདོན་པའི་ཉེས་པ་འདི་ནི་ཁྱོད་ཀྱིས་ང་ལ་བྱས་པའི་ཉེས་པ་ལས་ཀྱང་ཚབས་ཆེའོ་ཞེས་སྨྲས་ཀྱང་། ཨམ་ནོན་གྱིས་ཁོ་མོའི་ཚིག་ལ་མ་མཉན་པར།"]},{"type":"verse","number":17,"content":["རང་གི་ཞབས་ཕྱི་བོས་ནས་དེ་ལ། བུད་མེད་འདི་ངའི་ཁྱིམ་ནས་བཏོན་ཞིག ཁོ་མོ་ཕྱི་རུ་སོང་མ་ཐག་སྒོ་ལ་སྒོ་གཏན་རྒྱོབ་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":18,"content":["སྐབས་དེར་ཐལ་མཱར་གྱིས་གོས་ཁྲ་བོ་གྱོན་ཡོད་པ་ཡིན། གང་ལ་ཞེ་ན། རྒྱལ་པོའི་སྲས་མོ་ན་ཆུང་མ་ཡིན་པ་ཐམས་ཅད་ཀྱིས་ཕྱི་གོས་དེ་ལྟ་བུ་གྱོན་པ་ཡིན། ཨམ་ནོན་གྱི་ཞབས་ཕྱི་ཡིས་ཁོ་མོ་ཕྱི་རུ་བཏོན་ཞིང་། ཁོ་མོ་ཕྱི་རུ་སོང་མ་ཐག་ཁོས་སྒོ་ལ་སྒོ་གཏན་བརྒྱབ་པ་རེད།"]},{"type":"verse","number":19,"content":["དེར་ཐལ་མཱར་གྱིས་རང་གི་མགོ་ལ་ཐལ་བ་གཏོར་ནས་ལུས་ཀྱི་གོས་ཁྲ་གཤགས་ཏེ། མགོ་ལག་པས་བསྐྱོར་ནས་ངུ་བཞིན་སོང་བ་དང་།"]},{"type":"verse","number":20,"content":["ཁོ་མོའི་མིང་པོ་ཨབ་ཤཱ་ལོམ་ན་རེ། ཁྱོད་ཀྱི་ཕུ་བོ་ཨམ་ནོན་ཁྱོད་དང་འགྲོགས་པ་ཡིན་ནམ། ངའི་སྲིང་མོ། ད་གནས་སྐབས་སུ་ཁ་མི་གྲགས་པར་གྱིས། ཁོ་རང་ཁྱོད་ཀྱི་ཕུ་བོ་ཡིན་པས་སེམས་སུ་མ་འཛིན་ཞིག་ཅེས་སྨྲས་ཤིང་། ཐལ་མཱར་ནི་རང་གི་མིང་པོ་ཨབ་ཤཱ་ལོམ་གྱི་ཁྱིམ་ནས་གྲོགས་མེད་ཁེར་རྐྱང་དུ་བསྡད་དོ། །"]},{"type":"verse","number":21,"content":["རྒྱལ་པོ་དཱ་བིད་ཀྱིས་དོན་དེ་ཐམས་ཅད་ཐོས་པ་ཙམ་གྱིས་ཐུགས་རབ་ཏུ་ཁྲོས་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":22,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་ཨམ་ནོན་ལ་གཏམ་བཟང་ངན་གང་ཡང་མ་ལབ་སྟེ། གང་ལ་ཞེ་ན། དེས་ཁོའི་སྲིང་མོ་ཐལ་མཱར་ལ་བཙན་གཡེམ་བྱས་པས་ཨབ་ཤཱ་ལོམ་ནི་ཨམ་ནོན་ལ་ཤིན་ཏུ་སྡང་ངོ་། །"]},{"type":"heading","content":["ཨབ་ཤཱ་ལོམ་གྱིས་སྲིང་མོའི་ཆེད་དུ་དགྲ་ཤ་བླངས་པ།"]},{"type":"verse","number":23,"content":["དེ་ནས་ལོ་གཉིས་འགོར་རྗེས། མི་རྣམས་ཀྱིས་ཨེ་ཕཱར་ཡིམ་ཉེ་འདབས་ཀྱི་པཱ་ཨལ་ཧ་ཟོར་ཡུལ་དུ་ཨབ་ཤཱ་ལོམ་གྱི་ལུག་བལ་འབྲེག་སྐབས་",{"noteId":15},"སུ། ཨབ་ཤཱ་ལོམ་གྱིས་རྒྱལ་སྲས་ཐམས་ཅད་དེ་རུ་མགྲོན་དུ་བོས་སོ། །"]},{"type":"verse","number":24,"content":["ཡང་ཨབ་ཤཱ་ལོམ་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན་ཏེ་ཁོང་ལ། གཟིགས་དང་། མི་རྣམས་ཀྱིས་ཁྱེད་ཀྱི་ཞབས་ཕྱིའི་ལུག་བལ་འབྲེག་གིན་ཡོད་པས། རྒྱལ་པོ་འཁོར་དང་བཅས་པ་ཉིད་ཀྱི་ཞབས་ཕྱི་མཉམ་དུ་ཕེབས་ཤིག་ཞུས་ཀྱང་།"]},{"type":"verse","number":25,"content":["རྒྱལ་པོས་ཨབ་ཤཱ་ལོམ་ལ། མི་འགྲོ་བར་བྱ་ངའི་བུ། ཁྱོད་ལ་ཚེགས་མི་བྱེད་པའི་ཕྱིར་ཚང་མ་འགྲོ་དགོས་དོན་མེད་ཅེས་སྨྲས། དེས་ཁོང་ལ་ཡང་ཡང་ཞུས་ཀྱང་ཁོང་སྔར་བཞིན་འགྲོ་མ་འདོད་པས་དེ་ལ་བྱིན་རླབས་མཛད་དོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས། གལ་ཏེ་ཁྱེད་མི་ཕེབས་ན། ངའི་ནུ་བོ་ཨམ་ནོན་ང་དང་མཉམ་དུ་མངག་པར་མཛོད་ཅེས་ཞུས་པའི་ལན་དུ་རྒྱལ་པོས། ཁོ་ཁྱོད་དང་མཉམ་དུ་འགྲོ་དགོས་དོན་ཅི་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":27,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་རྒྱལ་པོ་ལ་ཡང་ནས་ཡང་དུ་ཞུ་བ་ཞུས་པས་ཁོང་གིས་ཨམ་ནོན་དང་རྒྱལ་སྲས་ཐམས་ཅད་ཁོ་དང་མཉམ་དུ་འགྲོ་བའི་དགོངས་པ་གནང་ངོ་། །"]},{"type":"verse","number":28,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས་རང་གི་འཁོར་གཡོག་རྣམས་ལ། མཉམ་ཞོག་ཅིག ཨམ་ནོན་གྱིས་རྒུན་ཆང་འཐུང་ནས་དགའ་བ་འབུམ་གྱིས་མཉེས་པའི་དུས་སུ་ངས་ཁྱོད་ཅག་ལ། ཨམ་ནོན་ལ་རྒྱོབ་ཅིག་ཅེས་སྨྲས་པ་ཙམ་གྱིས། ཁྱོད་ཅག་གིས་ཨམ་ནོན་གསོད་དགོས་ཏེ། མ་འཇིགས་ཤིག ངས་ཁྱོད་ཅག་ལ་བཀའ་བསྒོས་པ་མ་ཡིན་ནམ། དེ་བས་སྙིང་སྟོབས་དང་དཔའ་ངར་བསྐྱེད་ཅིག་ཅེས་སྨྲས་པར།"]},{"type":"verse","number":29,"content":["ཨབ་ཤཱ་ལོམ་གྱི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཁོའི་བསྒོ་བ་བཞིན་དུ་ཨམ་ནོན་ལ་དེ་བཞིན་བྱས་ཤིང་། རྒྱལ་སྲས་ཐམས་ཅད་ལངས་ནས་རང་རང་གི་དྲེའུ་ལ་ཞོན་ཏེ་བྲོས་སོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ཁོ་རྣམས་ད་དུང་ལམ་བར་དུ་འབྲོ་སྐབས་སུ། ཨབ་ཤཱ་ལོམ་གྱིས་རྒྱལ་སྲས་ཐམས་ཅད་བསད་ནས་གཅིག་ཀྱང་མ་ལུས་སོ་ཞེས་པའི་འཕྲིན་དཱ་བིད་ལ་སླེབས་པ་དང་།"]},{"type":"verse","number":31,"content":["རྒྱལ་པོ་ཧར་གྱིས་བཞེངས་ཤིང་། ན་བཟའ་གཤགས་ནས་ས་སྟེང་དུ་ཉལ། ཁོང་གི་བློན་འཁོར་ཐམས་ཅད་ཀྱིས་ཀྱང་ལུས་གོས་གཤགས་ནས་ཁོང་གི་དྲུང་དུ་ལངས་བསྡད་པ་རེད།"]},{"type":"verse","number":32,"content":["དེ་ནས་དཱ་བིད་ཀྱི་གཅེན་པོ་ཤིམ་ཨ་ཡི་བུ་ཡོ་ན་དབ་ཀྱིས། ཀྱེ་ཇོ་བོ་ལགས། དེ་དག་གིས་རྒྱལ་སྲས་དར་ལ་བབ་པ་ཐམས་ཅད་བཀུམ་པར་མ་དགོངས་ཤིག ཨམ་ནོན་འབའ་ཞིག་བཀུམ་པའོ། །ཨམ་ནོན་གྱིས་ཨབ་ཤཱ་ལོམ་གྱི་སྲིང་མོ་ཐལ་མཱར་ལ་བཙན་གཡེམ་བྱས་པའི་ཉིན་ནས་བཟུང་། ཨབ་ཤཱ་ལོམ་གྱིས་འདི་ལྟར་བགྱི་བའི་སེམས་ཐག་བཅད་པ་རེད།"]},{"type":"verse","number":33,"content":["དེའི་ཕྱིར་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལགས། རྒྱལ་སྲས་ཐམས་ཅད་བཀུམ་པ་རེད་ཅེས་ཁྱེད་ཀྱི་ཐུགས་སུ་མི་དགོངས་པར་མཁྱེན། ཨམ་ནོན་འབའ་ཞིག་བཀུམ་མོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":34,"content":["ཨབ་ཤཱ་ལོམ་བྲོས་སོང་ངོ་། །སོ་པ་གཞོན་ནུ་ཡིས་མགོ་ཡར་བཏེགས་ནས་བལྟས་པ་དང་། ལྟོས་ཤིག མི་མང་པོ་ཞིག་རི་ངོས་ཀྱི་ལམ་ནས་ཁོའི་རྗེས་སུ་འོང་བ་མཐོང་ངོ་། །"]},{"type":"verse","number":35,"content":["དེར་ཡོ་ན་དབ་ཀྱིས་རྒྱལ་པོ་ལ། གཟིགས་དང་། ཁྱེད་ཀྱི་ཞབས་ཕྱིས་ཞུས་པ་བཞིན་རྒྱལ་སྲས་རྣམས་འབྱོན་ནོ་ཞེས་ཞུས་ཤིང་།"]},{"type":"verse","number":36,"content":["དེ་ལྟར་ཞུས་པ་ཙམ་གྱིས། ལྟོས་ཤིག རྒྱལ་སྲས་རྣམས་སླེབས་ནས་སྐད་ཆེན་པོས་བཤུམས། རྒྱལ་པོ་དང་ཁོང་གི་བློན་འཁོར་རྣམས་ཀྱིས་ཀྱང་ངུ་སྐད་ཤིན་ཏུ་ཆེན་པོ་བཏོན་ཏོ། །"]},{"type":"verse","number":37,"content":["ཨབ་ཤཱ་ལོམ་བྲོས་ནས་གེ་ཤུར་གྱི་རྒྱལ་པོ་ཨམ་མེ་ཧུད་ཀྱི་སྲས་ཏལ་མཱ་ཨི་བྱ་བའི་དྲུང་དུ་ཕྱིན། དཱ་བིད་ཀྱིས་ཉིན་རེ་བཞིན་ཉིད་ཀྱི་སྲས་ཀྱི་ཕྱིར་མྱ་ངན་བྱས།"]},{"type":"verse","number":38,"content":["ཨབ་ཤཱ་ལོམ་བྲོས་ནས་གེ་ཤུར་དུ་ཕྱིན་ཏེ་དེར་ལོ་གསུམ་ལ་བསྡད།"]},{"type":"verse","number":39,"content":["ཡང་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཨབ་ཤཱ་ལོམ་གསོད་མ་འདོད་དེ།",{"noteId":16},"ཨམ་ནོན་གྲོངས་རྗེས་ད་ནི་ཁོང་ལ་སེམས་གསོ་ཐོབ་པའི་ཕྱིར་རོ། །"]}],"footnotes":[{"noteId":15,"caller":"+","text":"ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལོ་རེའི་དཔྱིད་ཀར་དྲོད་བབས་རྗེས་ལུག་བལ་འབྲེག་པ་དང་། བལ་འབྲེག་པའི་སྐབས་སུ་གསོལ་སྟོན་གཤམ་པའི་དཔེ་ཡོད།","reference":{"chapter":13,"verse":23}},{"noteId":16,"caller":"+","text":"ཡང་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཨབ་ཤཱ་ལོམ་གསོད་མ་འདོད་དེ་ཞེས་པའི་མ་ཕྱིའི་དོན་ནི་དཱ་བིད་ཀྱིས་ཨབ་ཤཱ་ལོམ་འཚོལ་བ་མཚམས་བཞག་ཅེས་པ་ཡིན།","reference":{"chapter":13,"verse":39}}]},"thisChapterLink":"/api/bod_ntb/2SA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/12.json","previousChapterAudioLinks":{},"numberOfVerses":39}