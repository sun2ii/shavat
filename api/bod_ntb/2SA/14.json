{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":14,"content":[{"type":"heading","content":["ཡོ་ཨབ་ཀྱིས་ཨབ་ཤཱ་ལོམ་ཕྱིར་ཡོང་བར་བཅུག་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་ཀྱིས་རྒྱལ་པོའི་སེམས་ནས་ཨབ་ཤཱ་ལོམ་དྲན་པ་ཤེས་པས།"]},{"type":"verse","number":2,"content":["ཁོས་ཐེ་ཀོ་ཨ་རུ་མི་མངགས་པ་དང་། དེ་ནས་བུད་མེད་མཁས་པ་ཞིག་བོས་ནས་དེ་ལ། ཁྱོད་ཀྱིས་རང་གི་མགོར་སྡུག་ལྷུང་ཁུལ་བྱས་ཏེ་སྡུག་གོས་གྱོན་ལ། ལུས་ལ་སྣུམ་ཡང་མི་སྐུད་པར། དུས་ཡུན་རིང་པོར་གཤིན་པོའི་དོན་དུ་སྡུག་འཁུར་བའི་བུད་མེད་ལྟ་བུར་བྱས་ཏེ།"]},{"type":"verse","number":3,"content":["རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན་ཏེ་ཁོང་ལ་འདི་བཞིན་ཞུ་དགོས་ཞེས་སྨྲས་ནས། ཡོ་ཨབ་ཀྱིས་བུད་མེད་ལ་ཅི་ལྟར་ཞུ་དགོས་པའི་ཚིག་ཐམས་ཅད་སྨྲས་སོ། །"]},{"type":"verse","number":4,"content":["དེ་ནས་ཐེ་ཀོ་ཨ་ཡུལ་གྱི་བུད་མེད་རྒྱལ་པོའི་དྲུང་དུ་འོངས་ནས་ཕྱག་བཙལ་ཏེ་ན་རེ། རྒྱལ་པོ་ལགས། ཁྱེད་ཀྱིས་སྐྱབས་མཛོད་ཅིག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":5,"content":["རྒྱལ་པོས་དེ་ལ། ཁྱོད་ལ་ཅི་ཞིག་བྱུང་ཞེས་དྲིས་པའི་ལན་དུ་མོ་ན་རེ། བདག་ནི་ཡུགས་མོ་ཞིག་ཡིན་ཏེ། བདག་གི་ཁྱོ་ག་ཤི་སོང་བ་དང་།"]},{"type":"verse","number":6,"content":["ཁྱེད་ཀྱི་གཡོག་མོ་བདག་ལ་བུ་གཉིས་ཡོད་ཅིང་། དེ་གཉིས་ཞིང་ཁར་འཛིངས་པ་དང་བར་འབྱེད་མཁན་གང་ཡང་མེད་པས། གཅིག་གིས་གཞན་དེ་ལ་བརྡུངས་ནས་བསད་དོ། །"]},{"type":"verse","number":7,"content":["གཟིགས་དང་། ནང་མི་ཐམས་ཅད་ཁྱེད་ཀྱི་གཡོག་མོའི་དགྲ་རུ་ལངས་ནས་འདི་ལྟར། ཁྱོད་ཀྱིས་རང་གི་སྤུན་ཟླ་གསོད་མཁན་དེ་སྤྲོད་ཤོག སྤུན་བསད་པའི་སྲོག་ལན་དུ་ངེད་རྣམས་ཀྱིས་ཁོ་བསད་ནས་ཕ་ཤུལ་འཛིན་མཁན་མེད་པར་བྱའོ་ཞེས་སྨྲས་སོ། །དེ་ལྟར་ཁོ་ཚོས་བདག་ལ་ལུས་པའི་བུ་གཅིག་པོ་དེ་ཡང་གསོད་ཅིང་། ས་གཞིའི་ངོས་སུ་བདག་གི་ཁྱོ་གའི་མིང་ངམ་གང་ཡང་མི་ལུས་པའི་ཕྱིར་དེ་བཞིན་བྱེད་དོ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":8,"content":["རྒྱལ་པོས་བུད་མེད་ལ། ད་ལྟ་རང་ཁྱིམ་དུ་སོང་ཞིག ངས་ཁྱོད་ཀྱི་དོན་དུ་བཀའ་གནང་བར་བྱ་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":9,"content":["ཐེ་ཀོ་ཨ་ཡུལ་གྱི་བུད་མེད་ཀྱིས་རྒྱལ་པོ་ལ། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལགས། ཉེས་སྡིག་ཐམས་ཅད་བདག་དང་བདག་གི་ཕ་རྒྱུད་ལ་འབབ་པར་ཤོག་ཅིག རྒྱལ་པོ་དང་རྒྱལ་ཁྲི་གཉིས་ལ་ཉེས་སྐྱོན་མི་འཕོག་པར་ཤོག་ཅིག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":10,"content":["རྒྱལ་པོས་དེ་ལ། སུ་ཞིག་གིས་ཁྱོད་ལ་ཅི་ཞིག་སྨྲས་ནས་སྡུག་ལ་གཏོད་ན་དེ་ངའི་མདུན་དུ་འཁྲིད་ཤོག་དང་། དེས་ཁྱོད་ལ་ཡང་བསྐྱར་དཀའ་ལས་མི་བཟོའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་བུད་མེད་ན་རེ། ཡང་དགྲ་ཤ་ལེན་མཁན་དག་གིས་ངའི་བུ་རྩ་མེད་དུ་མི་གཏོང་བའི་ཕྱིར། རྒྱལ་པོ་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་དམ་བཅའ་བར་མཛོད་ཅེས་ཞུས་པ་ན། རྒྱལ་པོས་འདི་ལྟར། བདག་གིས་གཙོ་བོ་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་དམ་བཅའ་འཇོག་སྟེ། ཁྱོད་ཀྱི་བུ་ཡི་སྐྲ་ཉག་མ་གཅིག་ཀྱང་སར་ལྷུང་བར་མི་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":12,"content":["དེར་བུད་མེད་ཀྱིས། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ཁྱེད་ཀྱིས་གཡོག་མོ་བདག་ལ་ཡང་ཚིག་གཅིག་ཞུ་བར་གནོངས་ཤིག་ཅེས་ཞུས་པ་ལ། རྒྱལ་པོས་སྨྲོས་ཤིག་གསུངས་ཤིང་།"]},{"type":"verse","number":13,"content":["བུད་མེད་ཀྱིས། རྒྱལ་པོ་ཁྱེད་ཀྱིས་དཀོན་མཆོག་གི་འབངས་མི་ལ་གནོད་བསྐྱལ་བའི་ཐུགས་སེམས་དེ་ལྟ་བུ་ཅིའི་ཕྱིར་བཅངས་པ་ཡིན་ནམ། རྒྱལ་པོས་བྲོས་བྱོལ་དུ་ཕྱིན་པ་དེ་ཕྱིར་འོང་དུ་མ་བཅུག་ན། རྒྱལ་པོས་དེ་བཞིན་གསུངས་པ་ནི་རང་ཉིད་ནོར་བར་ར་སྤྲོད་མཛད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["ངེད་ཅག་ཐམས་ཅད་འཆི་བར་ངེས་ཤིང་། དེ་ནི་སར་ཕོ་བའི་ཆུ་སླར་སྡུད་ཐབས་མེད་པ་དང་འདྲའོ། །དཀོན་མཆོག་གིས་མི་ཡི་འཆི་བ་མེད་པར་མི་མཛད་མོད། འོན་ཀྱང་བྲོས་བྱོལ་དུ་ཕྱིན་པ་དེ་ནི་མཐར་བསྐྲད་དེ་ཕྱིར་ལོག་མི་ནུས་པའི་མི་རུ་མི་འགྱུར་བའི་ཕྱིར་ཐབས་མཛད་དོ། །"]},{"type":"verse","number":15,"content":["མི་རྣམས་ཀྱིས་བདག་འཇིགས་སུ་བཅུག་པས། ང་རང་ད་ལྟ་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོར་གཏམ་འདི་ཞུ་བར་འོངས་པ་ཡིན། ཁྱེད་ཀྱི་གཡོག་མོས། བདག་གིས་རྒྱལ་པོ་ལ་ཞུས་ན་རྒྱལ་པོས་ཉིད་ཀྱི་གཡོག་མོའི་ཞུ་བ་བཞིན་མཛད་ཀྱང་སྲིད།"]},{"type":"verse","number":16,"content":["མི་ཡིས་བདག་དང་བདག་གི་བུ་གཉིས་མཉམ་དུ་དཀོན་མཆོག་གི་ནོར་སྐལ་ལས་མེད་པར་བྱེད་འདོད་པ་དང་། རྒྱལ་པོས་འདི་གསན་ནས་གཡོག་མོ་བདག་མི་རྣམས་ཀྱི་ལག་ནས་སྐྱོབ་ངེས་ཡིན་སྙམ་པ་དང་།"]},{"type":"verse","number":17,"content":["ཡང་ཁྱེད་ཀྱི་གཡོག་མོས། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོའི་གསུང་གིས་ང་ལ་སེམས་གསོ་གནང་བར་ངེས་སྙམ་པ་ཡིན། གང་ལ་ཞེ་ན། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ནི་ལེགས་ཉེས་འབྱེད་པའི་ཐད་དཀོན་མཆོག་གི་ཕོ་ཉ་དང་འདྲ་བ་ལགས། ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱེད་དང་མཉམ་དུ་བཞུགས་པར་ཤོག་ཅེས་ཞུས་པའི་ལན་དུ།"]},{"type":"verse","number":18,"content":["རྒྱལ་པོས་བུད་མེད་དེ་ལ། ངས་ཁྱོད་ལ་ཚིག་གཅིག་འདྲི་བར་བྱ་སྟེ། ཁྱོད་ཀྱིས་གསང་བར་མི་བྱའོ་ཞེས་བསྐུལ་བར། བུད་མེད་ཀྱིས། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོས་གསུང་བར་མཛོད་ཅེས་ཞུས་ཤིང་།"]},{"type":"verse","number":19,"content":["རྒྱལ་པོས། འདི་ཐམས་ཅད་ནི་ཡོ་ཨབ་ཀྱིས་ཁྱོད་ལ་བསྟན་པ་མིན་ནམ་ཞེས་དྲིས་པའི་ལན་དུ་བུད་མེད་ཀྱིས། བདག་གིས་རང་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོའི་མདུན་དུ་མནའ་སྐྱེལ་ཏེ། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོས་གནང་བའི་གསུང་ནི་གཡས་གཡོན་གང་དུའང་གཟུར་མེད། དེ་ནི་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡོ་ཨབ་ཀྱིས་བདག་ལ་བསྒོས་ཤིང་། ཚིག་འདི་ཐམས་ཅད་ཁོས་གཡོག་མོ་བདག་གི་སྨྲ་སྒོ་རུ་བཞག་པ་ཡིན།"]},{"type":"verse","number":20,"content":["ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡོ་ཨབ་ཀྱིས་འདི་ལྟར་བྱེད་པ་ནི་གནས་ཚུལ་ཇེ་ལེགས་སུ་གཏོང་བའི་ཆེད་དུ་ཡིན་ཏེ། བདག་གི་ཇོ་བོའི་ཤེས་རབ་ནི་དཀོན་མཆོག་གི་ཕོ་ཉའི་ཤེས་རབ་དང་མཚུངས་ལ། ས་སྟེང་གི་དོན་ཐམས་ཅད་མཁྱེན་ནུས་པའོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":21,"content":["དེར་རྒྱལ་པོས་ཡོ་ཨབ་ལ། ལྟོས་ཤིག ངས་དེ་བཞིན་དུ་གནང་བས། སོང་ལ་ཨབ་ཤཱ་ལོམ་འདི་རུ་འཁྲིད་ཤོག་ཅེས་བསྒོས་པ་དང་།"]},{"type":"verse","number":22,"content":["ཡོ་ཨབ་ཀྱིས་ལུས་སར་བཏུད་ནས་ཕྱག་བཙལ་ཏེ་རྒྱལ་པོའི་ཆེད་དུ་སྨོན་འདུན་ཞུས་ཤིང་འདི་ལྟར། རྒྱལ་པོས་ཞབས་ཕྱི་བདག་གི་ཞུ་བ་བཞིན་དུ་མཛད་པས། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ཁྱེད་ཀྱི་སྤྱན་སྔར་ཐུགས་རྗེ་བརྙེད་པ་ཞབས་ཕྱིས་དེ་རིང་མཐོང་བ་ཡིན་ཞེས་ཞུས་ནས།"]},{"type":"verse","number":23,"content":["ཡོ་ཨབ་ཡར་ལངས་ཏེ་གེ་ཤུར་དུ་སོང་ནས་ཨབ་ཤཱ་ལོམ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ཁྲིད་འོངས་ནའང་།"]},{"type":"verse","number":24,"content":["རྒྱལ་པོས་ཁོ་ནི་རང་གི་ཁྱིམ་ལ་འགྲོ་རུ་ཆུག་དང་། ངའི་མཐོང་སར་འོང་མི་རིགས་སོ་ཞེས་བཀའ་བསྩལ་པས། ཨབ་ཤཱ་ལོམ་རང་ཁྱིམ་དུ་སོང་ནས་རྒྱལ་པོ་མཇལ་བར་མ་གྱུར་ཏོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་ཨབ་ཤཱ་ལོམ་གུ་ཡངས་སུ་བཏང་བ།"]},{"type":"verse","number":25,"content":["ཡེས་ར་ཨེལ་ཡུལ་ཐམས་ཅད་དུ་ཨབ་ཤཱ་ལོམ་དང་འདྲ་བའི་སྐྱེས་ཡག་བསྔགས་བརྗོད་བྱ་རུང་བ་གཅིག་ཀྱང་མེད་དེ། དེའི་རྐང་མཐིལ་ནས་སྤྱི་བོའི་བར་དུ་སྐྱོན་གང་ཡང་མེད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ཁོའི་མགོ་ཡི་སྐྲ་ནི་ཧ་ཅང་ལྗིད་དེ། ལོ་རེའི་མཇུག་ཏུ་སྐྲ་ཐེངས་གཅིག་ལ་འབྲེག་པ་དང་། དེའི་སྐྲ་ཡི་ལྗིད་ཚད་ནི་རྒྱལ་པོའི་རྒྱ་མར་ཚད་ན་སྲང་ཉིས་བརྒྱ་",{"noteId":17},"ཡོད་པ་རེད།"]},{"type":"verse","number":27,"content":["ཨབ་ཤཱ་ལོམ་ལ་བུ་གསུམ་དང་བུ་མོ་གཅིག་སྐྱེས་པ་དང་། བུ་མོའི་མིང་ལ་ཐལ་མཱར་",{"noteId":18},"ཞེས་བཏགས་ཤིང་དེ་ནི་བུད་མེད་མཛེས་མ་ཞིག་ཡོད་པ་ཡིན།"]},{"type":"verse","number":28,"content":["ཨབ་ཤཱ་ལོམ་ལོ་ཧྲིལ་པོ་གཉིས་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་ཀྱང་རྒྱལ་པོའི་ཞལ་མ་མཇལ་ལོ། །"]},{"type":"verse","number":29,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས་ཡོ་ཨབ་རྒྱལ་པོའི་དྲུང་དུ་མངག་ཆེད་བོས་ཀྱང་། ཡོ་ཨབ་མ་འོངས་པ་དང་། ཐེངས་གཉིས་པར་འབོད་དུ་མངགས་ཀྱང་མ་འོངས་པ་རེད།"]},{"type":"verse","number":30,"content":["དེའི་ཕྱིར་ཨབ་ཤཱ་ལོམ་གྱིས་རང་གི་ཞབས་ཕྱི་རྣམས་ལ། ལྟོས་ཤིག ཡོ་ཨབ་ཀྱི་ཞིང་ངའི་ཞིང་གི་འགྲམ་དུ་ཡོད་ཅིང་དེ་རུ་ནས་བཏབ་ཡོད། སོང་ལ་དེ་མེ་རུ་བསྲེག་པར་གྱིས་ཤིག་ཅེས་བསྒོས་པ་དང་། ཨབ་ཤཱ་ལོམ་གྱི་ཞབས་ཕྱི་རྣམས་སོང་ནས་ཞིང་དེ་མེར་བསྲེགས་སོ། །"]},{"type":"verse","number":31,"content":["དེར་ཡོ་ཨབ་ཡར་ལངས་ཏེ་ཨབ་ཤཱ་ལོམ་གྱི་ཁྱིམ་དུ་འོངས་ནས་དེ་ལ། ཁྱེད་ཀྱི་ཞབས་ཕྱི་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་ངའི་ཞིང་བསྲེགས་པ་ཡིན་ཞེས་པའི་ལན་དུ།"]},{"type":"verse","number":32,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་ཡོ་ཨབ་ལ། ལྟོས་དང་། ངས་མི་མངགས་ནས་ཁྱོད་འདིར་བོས་ཏེ། ཁྱོད་རྒྱལ་པོའི་དྲུང་དུ་མངགས་ནས་ཁོང་ལ། བདག་གེ་ཤུར་ནས་ཕྱིར་འོངས་དོན་ཅི་ཡོད། བདག་སྔར་བཞིན་དེ་རུ་གནས་ན་ལེགས་པ་ཡིན་ཞེས་ཞུ་བའི་ཕྱིར་ཡིན། ད་བདག་ལ་རྒྱལ་པོའི་ཞལ་མཇལ་དུ་གནོངས་ཤིག གལ་ཏེ་བདག་ལ་ཉེས་སྐྱོན་ཡོད་ན་ཁོང་གིས་བདག་སྲོག་དང་འཕྲལ་བར་རུང་ངོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":33,"content":["ཡོ་ཨབ་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན་ནས་ཁོང་ལ་ཞུས་པ་དང་རྒྱལ་པོས་ཨབ་ཤཱ་ལོམ་བོས་ཤིང་། དེ་རྒྱལ་པོའི་དྲུང་དུ་འོངས་ནས་ལུས་སར་བཏུད་ཅིང་རྒྱལ་པོས་ཁོ་ལ་འོ་བྱས་སོ། །"]}],"footnotes":[{"noteId":17,"caller":"+","text":"འདིར་མ་ཕྱི་ལས་ཤེ་ཀེལ་ཉིས་བརྒྱ་ཞེས་མཐོང་ཞིང་དེང་གི་རྒྱ་མ་ལྔ་ཙམ་ཡིན།","reference":{"chapter":14,"verse":26}},{"noteId":18,"caller":"+","text":"འདིར་ཐལ་མཱར་ཞེས་འབྱུང་བ་ནི་ཨབ་ཤཱ་ལོམ་གྱི་བུ་མོ་ཡིན་པ་ལས་ཁོའི་སྲིང་མོ་ཐལ་མཱར་མ་ཡིན།","reference":{"chapter":14,"verse":27}}]},"thisChapterLink":"/api/bod_ntb/2SA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/13.json","previousChapterAudioLinks":{},"numberOfVerses":33}