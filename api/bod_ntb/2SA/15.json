{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":15,"content":[{"type":"heading","content":["ཨབ་ཤཱ་ལོམ་གྱིས་ལྐོག་ནས་རྒྱལ་པོར་ངོ་རྒོལ་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་ཨབ་ཤཱ་ལོམ་གྱིས་རང་གི་དོན་དུ་ཤིང་རྟ་དང་རྟ་རྣམས་གྲ་སྒྲིག་བྱས་ཤིང་། ཡང་མི་ལྔ་བཅུ་མངགས་ཏེ་ཁོའི་མདུན་ནས་རྒྱུག་ཏུ་བཅུག"]},{"type":"verse","number":2,"content":["ཨབ་ཤཱ་ལོམ་དུས་རྒྱུན་ནངས་སྔ་མོ་ཡར་ལངས་ནས་མཁར་སྒོའི་ལམ་འགྲམ་དུ་ལངས་བསྡད་ཅིང་། ཡང་སུ་དང་སུ་ཞིག་རྩོད་གཞི་ལ་ཁྲིམས་ཐག་གཅོད་པའི་ཕྱིར་རྒྱལ་པོའི་དྲུང་དུ་འོང་སྐབས་སུ། ཨབ་ཤཱ་ལོམ་གྱིས་མི་དེ་བོས་ནས་དེ་ལ། ཁྱོད་རང་གྲོང་ཁྱེར་གང་ནས་ཡིན་ཞེས་འདྲི་ཞིང་། མི་དེས། ཞབས་ཕྱི་བདག་ནི་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ག་གེ་མོའི་ཡིན་ཞེས་ཞུ་བ་དང་།"]},{"type":"verse","number":3,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་དེ་ལ། ལྟོས་དང་། ཁྱོད་ཀྱི་གྱོད་དོན་ནི་ལེགས་ཤིང་ལུགས་དང་མཐུན་མོད་ཀྱང་། རྒྱལ་པོས་ཁྱོད་ཀྱི་ཚིག་ལ་མཉན་པར་མི་གང་ཡང་མ་མངགས་པས་ཕངས་པ་ལ་ཞེས་དང་།"]},{"type":"verse","number":4,"content":["ཡང་ཨབ་ཤཱ་ལོམ་ན་རེ། གལ་ཏེ་ང་རང་ཡུལ་འདིའི་ཁྲིམས་དཔོན་ཡིན་ན་ཅི་མ་རུང་། དེ་ནས་རྩོད་གཞི་ཡོད་པ་ཐམས་ཅད་ངའི་རྩར་སླེབས་ན། ངས་དྲང་གཞག་ངང་ཁྲིམས་ཐག་གཅོད་པར་བྱ་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":5,"content":["ཡང་གལ་ཏེ་སུ་ཞིག་ཨབ་ཤཱ་ལོམ་ལ་ཕྱག་བཙལ་དུ་ཉེ་བར་འོང་སྐབས་སུ། ཁོས་ལག་པ་བརྐྱངས་ནས་མི་དེའི་ལག་པར་འཇུས་ནས་འོ་བྱེད་པའོ། །"]},{"type":"verse","number":6,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་རྒྱལ་པོའི་དྲུང་དུ་གཏུག་བཤེར་ལ་འོང་བའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་དེ་ལྟར་བྱས་ནས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་སེམས་ཕྲོགས་པ་རེད།"]},{"type":"verse","number":7,"content":["དེ་ནས་ལོ་བཞི་",{"noteId":19},"འགོར་རྗེས་ཨབ་ཤཱ་ལོམ་གྱིས་རྒྱལ་པོ་ལ། བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཁས་བླངས་པ་བཞིན་དུ་བསྒྲུབ་པའི་ཕྱིར་བདག་ཧེབ་རོན་དུ་འགྲོ་བར་གནོངས་ཤིག"]},{"type":"verse","number":8,"content":["ཞབས་ཕྱི་བདག་ཨ་རམ་ཡུལ་གྱི་གེ་ཤུར་དུ་གནས་པའི་དུས་སུ། བདག་གིས་འདི་ལྟར་དམ་བཅའ་བཞག་པ་སྟེ། གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་བསྐྱལ་ན། བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞབས་ཕྱི་བསྒྲུབ་པར་བྱ་ཞེས་ཞུས་པར།"]},{"type":"verse","number":9,"content":["རྒྱལ་པོས་དེ་ལ། བདེ་བར་སོང་ཞིག་གསུངས་པ་དང་ཁོ་ལངས་ནས་ལམ་ལ་ཆས་ཏེ་ཧེབ་རོན་དུ་སོང་ངོ་། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཐམས་ཅད་དུ་གསང་ཉུལ་པ་རྣམས་བཏང་སྟེ་འདི་ལྟར། དུས་ནམ་ཞིག་ལ་ཁྱོད་ཚོས་རྭ་དུང་གི་སྒྲ་ཐོས་ན། ཨབ་ཤཱ་ལོམ་གྱིས་ཧེབ་རོན་དུ་རྒྱལ་སྲིད་སྐྱོང་ངོ་ཞེས་སྨྲ་བར་རིགས་ཞེས་བསྒྲགས་སོ། །"]},{"type":"verse","number":11,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་ཡེ་རུ་སཱ་ལེམ་ནས་མི་ཉིས་བརྒྱ་རང་དང་མཉམ་དུ་ཁྲིད་ནས་ཕྱིན་ཏེ། དེ་དག་ནི་ལྷག་བསམ་རྣམ་དག་ཡིན་ཏེ་ཅི་ཡང་མི་ཤེས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས་མཆོད་པ་འབུལ་སྐབས་སུ། མི་མངགས་ཏེ་དཱ་བིད་ཀྱི་བློ་འདོན་མཁན་གེ་ལོ་པ་ཨ་ཧི་ཐོ་ཕེལ་བོས་འོངས་པ་དང་། ཨབ་ཤཱ་ལོམ་གྱི་རྗེས་སུ་འབྲང་མཁན་ཉིན་རེ་བཞིན་འཕེལ་ཏེ་གྱེན་ལོག་གི་ཤུགས་ཆེ་རུ་སོང་ངོ་། །"]},{"type":"heading","content":["དཱ་བིད་ཡེ་རུ་སཱ་ལེམ་ནས་བྲོས་པ།"]},{"type":"verse","number":13,"content":["ཡང་མི་ཞིག་དཱ་བིད་ཀྱི་དྲུང་དུ་སླེབས་ནས་ཁོང་ལ། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་སེམས་ཨབ་ཤཱ་ལོམ་གྱི་ཕྱོགས་སུ་འཁོར་འདུག་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":14,"content":["དཱ་བིད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཁོང་དང་ལྷན་ཅིག་ཏུ་ཡོད་པའི་བློན་འཁོར་ཐམས་ཅད་ལ། ལོངས་དང་འབྲོའོ། །མ་བྲོས་ན་བདག་ཅག་ཨབ་ཤཱ་ལོམ་གྱི་ལག་ནས་ཐར་ཐབས་མེད། ཁོ་མྱུར་དུ་འོངས་ནས་བདག་ཅག་བཟུང་སྟེ་གནོད་འཚེ་བཏང་ནས། གྲོང་ཁྱེར་ནང་གི་མི་རྣམས་རལ་གྲིས་མི་གསོད་པའི་ཕྱིར་འཕྲལ་དུ་འབྲལ་བར་གྱིས་ཤིག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":15,"content":["རྒྱལ་པོའི་བློན་འཁོར་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ། གཟིགས་དང་། ཁྱེད་ཀྱི་ཞབས་ཕྱི་རྣམས་ཀྱིས་ཇོ་བོ་རྒྱལ་པོས་ཅི་ལྟར་ཐུགས་ཐག་བཅད་ན་དེ་བཞིན་བྱའོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་རྒྱལ་པོ་ཕྱི་རོལ་ཏུ་ཕྱིན་པ་དང་། ཁོང་གི་ཁྱིམ་མི་ཐམས་ཅད་ཁོང་གི་རྗེས་སུ་འབྲངས་སོ། །ཡང་རྒྱལ་པོས་ཆུན་མ་བཅུ་ནི་ཕོ་བྲང་བསྲུང་བར་དེ་རུ་བཞག་གོ །"]},{"type":"verse","number":17,"content":["རྒྱལ་པོ་ཕྱི་རོལ་ཏུ་ཕྱིན་པ་དང་། མི་ཐམས་ཅད་ཀྱང་ཁོང་གི་རྗེས་སུ་འབྲངས་ཏེ་ཆེས་མཇུག་གི་ཁང་པར་སླེབས་ནས་དེར་ཡུད་ཙམ་བསྡད་པ་དང་།"]},{"type":"verse","number":18,"content":["རྒྱལ་པོའི་བློན་འཁོར་ཐམས་ཅད་ཁོང་གི་མདུན་ནས་ཕར་ཕྱིན་པ་དང་། ཡང་ཀེ་རེད་པ་དང་། ཕེ་ལེད་པ་ཐམས་ཅད་དང་། གཱད་ནས་རྒྱལ་པོའི་རྗེས་སུ་འོངས་པའི་གཱད་པ་མི་དྲུག་བརྒྱ་བཅས་ཐམས་ཅད་རྒྱལ་པོའི་མདུན་ནས་ཕར་ཕྱིན་ཏོ། །"]},{"type":"verse","number":19,"content":["རྒྱལ་པོས་གཱད་པ་ཨིད་ཏ་ཨི་བྱ་བ་ལ། ཁྱོད་ནི་ཕྱི་ཕྱོགས་པ་ཞིག་དང་རང་ཡུལ་ནས་བྲོས་འོངས་པ་ཡིན་པས་ངེད་རྣམས་དང་མཉམ་དུ་ཅིའི་ཕྱིར་འགྲོའམ། ཁྱོད་རང་ཕྱིར་ལོག་ནས་རྒྱལ་པོ་གསར་པ་དང་མཉམ་དུ་སྡོད་ཅིག"]},{"type":"verse","number":20,"content":["ཁྱོད་ནི་ཁ་སང་འདིར་སླེབས་ཤིང་། དེ་རིང་ངས་ཁྱོད་ངེད་རྣམས་དང་མཉམ་དུ་ཡུལ་འཁྱམ་དུ་འཇུག་ག་ལ་རུང་། ང་ནི་ག་ས་གང་དུ་འཁྱམ་པར་འགྱུར་རོ། །ཁྱོད་རང་ཕྱིར་ལོག་ཅིག རང་གི་སྤུན་རྣམས་ཁྲིད་ནས་ཕྱིར་ལོག་ཅིག གཙོ་བོས་བྱམས་བརྩེ་དང་དྲང་བདེན་ངང་ཁྱོད་རང་སྐྱོང་བར་ཤོག་ཅེས་གསུངས་པ་ལ།"]},{"type":"verse","number":21,"content":["ཨིད་ཏ་ཨི་ཡིས་ལན་དུ་རྒྱལ་པོ་ལ། བདག་གིས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་རྒྱལ་པོའི་དྲུང་དུ་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། འཆི་གསོན་གང་ལ་ཐུག་ནའང་། ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོ་ཁྱེད་ཉིད་གང་དུ་བཞུགས་ན་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡང་དེར་འདུག་པར་དགའོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":22,"content":["དཱ་བིད་ཀྱིས་ཨིད་ཏ་ཨི་ལ། ཕ་རོལ་ཏུ་སོང་ཞིག་གསུངས་ནས། གཱད་པ་ཨིད་ཏ་ཨི་ཡིས་རང་གི་རྗེས་སུ་འབྲང་བའི་མི་དང་བྱིས་པ་ཐམས་ཅད་ཁྲིད་ནས་ཕར་ཕྱིན་ཏོ། །"]},{"type":"verse","number":23,"content":["ཡང་འབངས་མི་ཐམས་ཅད་ཕར་འགྲོ་བའི་དུས་སུ། ཡུལ་མི་ཐམས་ཅད་སྐད་ཆེན་པོས་ངུས་ཤིང་། ཡང་རྒྱལ་པོ་ཉིད་ཀྱང་ཀིད་རོན་གྲོག་མོ་བརྒལ་ནས་ཕེབས་པ་དང་། མི་ཐམས་ཅད་དབེན་སྟོང་གི་ལམ་དུ་ཆས་པ་རེད།"]},{"type":"verse","number":24,"content":["ཡང་ལྟོས་དང་། ཟཱ་ཏོག་དང་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་མཁན་ལེ་ཝི་པ་ཐམས་ཅད་དེ་རུ་འོངས་པ་དང་། དེ་དག་གིས་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གནས་དེར་བཞག ཨབ་ཡཱ་ཐར་ཡང་ཡར་འོངས་ནས་མི་ཐམས་ཅད་རྒྱལ་ས་ནས་ཐོན་ཏེ་ཕར་ཕྱིན་པའི་བར་དུ་དེར་བཞུགས་སོ། །"]},{"type":"verse","number":25,"content":["དེར་རྒྱལ་པོས་ཟཱ་ཏོག་ལ། དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དེ་སླར་རྒྱལ་ས་རུ་འཁྱེར་ཞིག གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་བདག་ལ་ཐུགས་རྗེ་ཐོབ་ན། ཁོང་གིས་བདག་ཕྱིར་ལོག་པར་མཛད་ཅིང་། ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་ཁོང་གི་བཞུགས་གནས་ཀྱང་བདག་གིས་སླར་ཡང་མཇལ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":26,"content":["གལ་ཏེ་ཁོང་གིས། ང་ཁྱོད་ལ་མི་དགའ་ཞེས་གསུངས་ན། ཀྱེ་ཧོ། ང་རང་འདི་རུ་ཡོད་དེ། ཁོང་གི་སྤྱན་སྔར་གང་ལེགས་པར་གཟིགས་པ་བཞིན་བདག་ལ་མཛོད་ཅིག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":27,"content":["ཡང་རྒྱལ་པོས་མཆོད་དཔོན་ཟཱ་ཏོག་ལ། ཁྱེད་ནི་མངོན་ཤེས་པ་ཞིག་མིན་ནམ། བདེ་བར་རྒྱལ་ས་རུ་ལོག་ཅིག ཡང་ཁྱོད་ཀྱི་བུ་ཨ་ཧི་མཱ་ཨ་སི་དང་། ཨབ་ཡཱ་ཐར་གྱི་བུ་ཡོ་ནཱ་ཐན། ཁྱོད་གཉིས་ཀྱི་བུ་དེ་གཉིས་ཁྱོད་རྣམས་དང་མཉམ་དུ་ཕྱིར་སོང་ཞིག"]},{"type":"verse","number":28,"content":["ལྟོས་དང་། ཁྱོད་ཅག་གིས་ང་ལ་ལན་བསྐུར་བའི་བར་དུ་ངས་དབེན་སྟོང་གི་རབ་ཁ་རུ་སྒུག་པར་བྱའོ་ཞེས་བསྐུལ་བས།"]},{"type":"verse","number":29,"content":["ཟཱ་ཏོག་དང་ཨབ་ཡཱ་ཐར་གཉིས་ཀྱིས་དཀོན་མཆོག་གི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དེ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་གདན་དྲངས་ནས་དེར་བསྡད་དོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་དཱ་བིད་དབུ་བཏུམས་ནས་ཞབས་རྗེན་པར་སྐྱུ་རུ་རའི་རི་བོར་འགོས་ཤིང་། སྤྱན་ཆབ་བསིལ་བཞིན་འགྲུལ་པ་དང་། ཁོང་གི་རྗེས་སུ་འབྲངས་པའི་མི་ཀུན་གྱིས་ཀྱང་མགོ་བཏུམས་ནས་ངུ་བཞིན་ཡར་འགོས་སོ། །"]},{"type":"verse","number":31,"content":["ཡང་མི་ཞིག་གིས་དཱ་བིད་ལ། ཨ་ཧི་ཐོ་ཕེལ་ཡང་འབངས་གྱེན་ལོག་བྱེད་མཁན་མཉམ་དུ་ཨབ་ཤཱ་ལོམ་གྱི་རྗེས་སུ་འབྲང་ཡོད་ཅེས་ཞུས་པར། དཱ་བིད་ན་རེ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཨ་ཧི་ཐོ་ཕེལ་གྱི་གྲོས་དེ་ནི་བླུན་གྲོས་སུ་འགྱུར་བར་མཛོད་ཅིག་ཅེས་གསོལ་ཏོ། །"]},{"type":"verse","number":32,"content":["དེ་ནས་དཱ་བིད་དཀོན་མཆོག་ལ་ཕྱག་འཚལ་ཡུལ་རི་མགོར་སླེབས་པ་ཙམ་གྱིས། ལྟོས་དང་། ཨ་རག་པ་ཧུ་ཤཱ་ཨི་ནི་གྱོན་གོས་གཤགས་ནས་མགོ་ལ་ས་རྡུལ་གཡོགས་ཏེ་ཁོང་བསུ་བར་འོངས་པ་དང་།"]},{"type":"verse","number":33,"content":["དཱ་བིད་ཀྱིས་དེ་ལ། ཁྱོད་ང་དང་མཉམ་དུ་སོང་ཚེ་ང་ལ་དཀའ་ལས་བཟོ་ངེས་ཡིན།"]},{"type":"verse","number":34,"content":["ཁྱོད་རྒྱལ་ས་རུ་སོང་སྟེ་ཨབ་ཤཱ་ལོམ་ལ། ཀྱེ་རྒྱལ་པོ་ལགས། བདག་ནི་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡིན། ང་རང་ཇི་ལྟར་ཁྱེད་ཀྱི་ཡབ་ཀྱི་ཞབས་ཕྱི་ཡིན་པ་བཞིན་ད་ལྟ་ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཡིན་ཞེས་སྨྲས་ན། ཁྱེད་ཀྱིས་ངའི་དོན་དུ་ཨ་ཧི་ཐོ་ཕེལ་གྱི་གྲོས་ངན་བཟློག་སྲིད་དོ། །"]},{"type":"verse","number":35,"content":["ཟཱ་ཏོག་དང་ཨབ་ཡཱ་ཐར་མཆོད་དཔོན་གཉིས་ནི་ཁྱོད་དང་མཉམ་དུ་ཡོད་པ་མ་ཡིན་ནམ། ཁྱོད་ཀྱིས་རྒྱལ་པོའི་ཕོ་བྲང་ནས་ཅི་ཐོས་པ་དེ་མཆོད་དཔོན་ཟཱ་ཏོག་དང་ཨབ་ཡཱ་ཐར་གཉིས་ལ་འཆད་དགོས།"]},{"type":"verse","number":36,"content":["ལྟོས་དང་། ཟཱ་ཏོག་གི་བུ་ཨ་ཧི་མཱ་ཨ་སི་དང་། ཨབ་ཡཱ་ཐར་གྱི་བུ་ཡོ་ནཱ་ཐན་གཉིས་ཀྱང་ཁོང་རྣམས་མཉམ་དུ་ཡོད་པས། ཁྱོད་ཀྱིས་ཅི་ཐོས་པ་དེ་དག་བརྒྱུད་ནས་ང་ལ་འཕྲིན་བསྐུར་ཞིག་ཅེས་གདམས་པས།"]},{"type":"verse","number":37,"content":["དཱ་བིད་ཀྱི་མཛའ་བོ་ཧུ་ཤཱ་ཨི་རྒྱལ་ས་རུ་ཕྱིན་པ་དང་། ཨབ་ཤཱ་ལོམ་ཡང་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་སོ། །"]}],"footnotes":[{"noteId":19,"caller":"+","text":"ལོ་བཞི་ཞེས་པར་མ་ཕྱི་ལས་ལོ་བཞི་བཅུ་ཞེས་དང་གནའ་ཡིག་ལ་ལར་ཉིན་བཞི་བཅུ་ཞེས་བཀོད་ཡོད།","reference":{"chapter":15,"verse":7}}]},"thisChapterLink":"/api/bod_ntb/2SA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/14.json","previousChapterAudioLinks":{},"numberOfVerses":37}