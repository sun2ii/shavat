{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":16,"content":[{"type":"heading","content":["དཱ་བིད་དང་ཙི་བཱ།"]},{"type":"verse","number":1,"content":["དཱ་བིད་རི་རྩེ་ལས་བརྒལ་བའི་ཚེ། ལྟོས་དང་། མེ་ཕི་པོ་ཤེད་ཀྱི་གཡོག་པོ་ཙི་བཱ་ཡིས་སྒ་གཏད་པའི་བོང་བུ་གཉིས་ཁྲིད་ནས་དེ་ལ་བག་ལེབ་ཉིས་བརྒྱ་དང་། རྒུན་འབྲུམ་སྐམ་པོ་ལེབ་མོ་བརྒྱ་དང་ཤིང་འབྲས་ལེབ་མོ་བརྒྱ་དང་། རྒུན་ཆང་རྐྱལ་བ་གང་བཅས་བཀལ་ནས་ཁོང་ཉིད་བསུ་བར་འོངས་སོ། །"]},{"type":"verse","number":2,"content":["དེར་རྒྱལ་པོས་ཙི་བཱ་ལ། འདི་དག་ཅི་ཡིན་ལགས་ཞེས་དྲིས་པའི་ལན་དུ་ཙི་བཱ་ན་རེ། བོང་བུ་ནི་རྒྱལ་པོའི་ཁྱིམ་མི་རྣམས་ཀྱི་ཞོན་པ་ཡིན་ལ། བག་ལེབ་དང་ཤིང་འབྲས་ལེབ་མོ་རྣམས་ནི་གཞོན་ནུ་རྣམས་ཀྱི་ཁ་ཟས་དང་། རྒུན་ཆང་ནི་དབེན་སྟོང་དུ་ཐང་ཆད་པ་རྣམས་ཀྱི་བཏུང་བྱ་ཡིན་ཞུས་པ་དང་།"]},{"type":"verse","number":3,"content":["རྒྱལ་པོས་དེ་ལ། ཁྱོད་ཀྱི་ཇོ་བོའི་བུ་གང་དུ་ཡོད་དམ་ཞེས་དྲིས་པར། ཁོ་ན་རེ། གཟིགས་དང་། ཁོང་གིས་དེ་རིང་ཉིན་མོར་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཀྱིས་ངའི་ཡབ་ཀྱི་རྒྱལ་སྲིད་ང་ལ་སླར་སྦྱིན་པར་བྱ་ཞེས་གསུངས་པས། ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས་པ་ཡིན་ཞེས་ཞུས་ཤིང་།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོས་ཙི་བཱ་ལ། ལྟོས་ཤིག མེ་ཕི་པོ་ཤེད་ལ་ཡོད་པ་ཐམས་ཅད་ཁྱོད་ལ་དབང་བར་འགྱུར་རོ་ཞེས་གསུངས་ཤིང་། ཙི་བཱ་ཡིས། ངས་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལ་གུས་ཕྱག་ཕུལ་ཏེ། ཁྱེད་ཀྱི་དྲུང་དུ་བདག་ལ་ཐུགས་རྗེ་འཐོབ་པར་ཤོག་ཅེས་ཞུས་སོ། །"]},{"type":"heading","content":["དཱ་བིད་དང་ཤིམ་ཨི།"]},{"type":"verse","number":5,"content":["དེ་ནས་རྒྱལ་པོ་དཱ་བིད་པཱ་ཧུ་རིམ་དུ་ཕེབས་པའི་ཚེ་ན། སོ་ལོའི་ཁྱིམ་མི་ནང་གི་གེ་རཱ་ཡི་བུ་ཤིམ་ཨི་བྱ་བ་དེ་དམོད་མོ་འདེབས་ཀྱིན་ཐོན་ཏེ།"]},{"type":"verse","number":6,"content":["རྒྱལ་པོ་དཱ་བིད་དང་ཁོང་གི་བློན་འཁོར་ཀུན་ལ་རྡོས་བརྒྱབ་ཅིང་། འབངས་རྣམས་དང་དཔའ་བོ་ཐམས་ཅད་ཁོང་གི་གཡས་གཡོན་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":7,"content":["ཤིམ་ཨི་ཡིས་དམོད་མོ་བཏབ་ནས་འདི་ལྟར། ཁྲག་གིས་ཚོས་པ་ཁྱོད། ཁྲེལ་མེད་ཁྱོད། མར་སོང་ཞིག མར་སོང་ཞིག"]},{"type":"verse","number":8,"content":["ཁྱོད་ཀྱིས་སོ་ལོ་ཁྱིམ་མི་གང་པོ་བཀྲོངས་ཏེ་ཁོང་གི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་སྡིག་པ་དེ་ཁྱོད་ཀྱི་སྟེང་ལ་བཀལ་ཞིང་། ཁྱོད་ཀྱི་རྒྱལ་སྲིད་ཁྱོད་ཀྱི་བུ་ཨབ་ཤཱ་ལོམ་གྱི་ལག་ཏུ་གཏད་དོ། །ལྟོས་དང་། ཁྱོད་ནི་ལག་དམར་ཡིན་པས་རང་སྡུག་རང་གིས་ཉོས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["ཟེ་རུ་ཡཱ་ཡི་བུ་ཨ་བི་ཤཱ་ཨི་ཡིས་རྒྱལ་པོ་ལ། ཁྱི་ཤི་རོ་འདིས་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལ་ཅིའི་ཕྱིར་དམོད་མོ་འདེབས་སམ། བདག་ཕར་སོང་ནས་ཁོའི་མགོ་ལེན་པར་གནང་རོགས་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":10,"content":["རྒྱལ་པོས། ཀྱེ་ཟེ་རུ་ཡཱ་ཡི་བུ། ང་རང་ཁྱོད་དང་འབྲེལ་བ་ཅི་ཡོད་དམ། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ། དཱ་བིད་ལ་དམོད་མོ་ཐོབས་ཤིག་ཅེས་གསུངས་པས་ཁོས་འདི་ལྟར་དམོད་པ་ཡིན་ལ། དེས་ན་སུ་ཞིག་གིས་ཁོ་ལ། ཁྱོད་ཀྱིས་འདི་ལྟར་བྱེད་པ་ཅི་ཡིན་ཟེར་ཐུབ་བམ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་དཱ་བིད་ཀྱིས་ཨ་བི་ཤཱ་ཨི་དང་ཉིད་ཀྱི་བློན་འཁོར་ཐམས་ཅད་ལ། ལྟོས་ཤིག ང་རང་གི་བུ་ཡང་ངའི་སྲོག་ལ་རྔམ་པས། པེན་ཡཱ་མེན་པ་འདི་ནི་ལྟ་ཅི་སྨོས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་བཀའ་བསྩལ་པས་དེར་དམོད་མོ་འདེབས་ན་འདེབས་སུ་ཆུག་དང་།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་སྡུག་བསྔལ་གཟིགས་ཤིང་། དེ་རིང་ཉིན་མོར་མི་འདིས་དམོད་མོ་བཏབ་པའི་རྐྱེན་གྱིས་ང་ལ་ཐུགས་རྗེས་གཟིགས་ཀྱང་སྲིད་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["ཡང་དཱ་བིད་དང་ཁོང་གི་མི་རྣམས་ལམ་ནས་འགྲུལ་བ་དང་། ཤིམ་ཨི་ནི་དཱ་བིད་དང་ཁ་གཏད་ཀྱི་རི་ངོར་སྐྱོད་ཅིང་། འགྲོ་ཞོར་དུ་དམོད་མོ་བཏབ་པ་དང་། ཡང་ཁོང་ལ་རྡོ་ཡིས་བརྒྱབ་ནས་ས་རྡུལ་འཕྱར།"]},{"type":"verse","number":14,"content":["རྒྱལ་པོ་དང་ཁོང་གི་རྗེས་སུ་འབྲངས་པའི་མི་ཐམས་ཅད་དེར་སླེབས་ནས་ཐང་ཆད་དེ་ངལ་གསོས་སོ། །"]},{"type":"heading","content":["ཨབ་ཤཱ་ལོམ་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པ།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་དང་ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིན་ཏེ། ཨ་ཧི་ཐོ་ཕེལ་ཡང་དེ་དང་མཉམ་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":16,"content":["ཡང་དཱ་བིད་ཀྱི་མཛའ་བོ་ཨ་རག་པ་ཧུ་ཤཱ་ཨི་བྱ་བ་དེ་ཨབ་ཤཱ་ལོམ་གྱི་དྲུང་དུ་སོང་ནས་དེ་ལ། རྒྱལ་པོ་སྐུ་ཚེ་བརྟན་པར་ཤོག རྒྱལ་པོ་སྐུ་ཚེ་བརྟན་པར་ཤོག་ཅེས་ཞུས་པར།"]},{"type":"verse","number":17,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་ཧུ་ཤཱ་ཨི་ལ། ཁྱོད་ཀྱིས་འདི་ལྟར་བྱེད་པ་ནི་གཞུང་དྲང་ངང་རང་གི་མཛའ་བོ་དྲིན་གྱིས་སྐྱོང་བ་ཡིན་ནམ། ཁྱོད་རང་ཅིའི་ཕྱིར་རང་གི་མཛའ་བོ་མཉམ་དུ་མ་སོང་ངམ་ཞེས་དྲིས་ཤིང་།"]},{"type":"verse","number":18,"content":["ཧུ་ཤཱ་ཨི་ཡིས་ཨབ་ཤཱ་ལོམ་ལ། དེ་བཞིན་མ་ཡིན། དཀོན་མཆོག་ཡ་ཝཱེ་དང་མི་རྣམས་དང་། ཡེས་ར་ཨེལ་པ་ཡོངས་ཀྱིས་སུ་ཞིག་བདམས་པར་མཛད་ན། བདག་ནི་ཁོང་ལ་གཏོགས་ཤིང་ཁོང་དང་མཉམ་དུ་གནས་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["དེར་མ་ཟད། བདག་གིས་སུ་ལ་ཞབས་ཏོག་བསྒྲུབ་འོས་སམ། རྒྱལ་རབས་སྔོན་མའི་སྲས་མ་ཡིན་ནམ། བདག་གིས་ཇི་ལྟར་ཁྱེད་ཀྱི་ཡབ་ལ་ཞབས་ཏོག་བསྒྲུབས་པ་ཡིན་ན་ཁྱེད་ཀྱི་སྐུ་དྲུང་དུའང་དེ་བཞིན་བྱའོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":20,"content":["ཨབ་ཤཱ་ལོམ་གྱིས་ཨ་ཧི་ཐོ་ཕེལ་ལ། ད་བདག་ཅག་གིས་གང་འདྲ་བྱེད་དགོས་སམ། ཁྱོད་རྣམས་ཀྱིས་བློ་བཀོད་བཏོན་ཞིག་ཅེས་བསྒོས་པ་ལ།"]},{"type":"verse","number":21,"content":["ཨ་ཧི་ཐོ་ཕེལ་གྱིས་ཨབ་ཤཱ་ལོམ་ལ། ཁྱེད་ཀྱི་ཡབ་ཀྱིས་ཕོ་བྲང་བསྲུང་བར་བཞག་པའི་ཆུན་མ་རྣམས་ཀྱི་གམ་དུ་ཕྱིན་དང་། ཁྱེད་ཀྱིས་རང་གི་ཡབ་ཀྱང་རང་ལ་ཞེན་ཁ་ལོག་ཏུ་འཇུག་ཕོད་པ་དེ་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ཐོས་ན། ཁྱེད་ཀྱི་རྗེས་སུ་འབྲང་བ་ཐམས་ཅད་ཀྱི་སྟོབས་ཤུགས་ཆེ་བར་འགྱུར་འགྲོ་ཞེས་སྨྲས་ནས།"]},{"type":"verse","number":22,"content":["དེ་དག་གིས་ཕོ་བྲང་གི་སྟེང་དུ་ཨབ་ཤཱ་ལོམ་གྱི་ཕྱིར་གུར་ཕུབ་ཅིང་། ཁོ་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་མཐོང་ས་རུ་རང་གི་ཡབ་ཀྱི་ཆུན་མ་རྣམས་ཀྱི་གམ་དུ་སོང་ངོ་། །"]},{"type":"verse","number":23,"content":["དེའི་དུས་སུ་ཨ་ཧི་ཐོ་ཕེལ་གྱིས་བཏོན་པའི་བློ་བཀོད་ནི། མི་ཡིས་དཀོན་མཆོག་ལ་ཐུགས་བརྟག་ཞུས་ནས་ཐོབ་པའི་བཀའ་བཞིན་སྣང་བ་ཡིན་ལ། ཁོས་དཱ་བིད་དང་ཨབ་ཤཱ་ལོམ་གཉིས་ལ་བཏོན་པའི་བློ་བཀོད་ཐམས་ཅད་དེ་བཞིན་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2SA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/15.json","previousChapterAudioLinks":{},"numberOfVerses":23}