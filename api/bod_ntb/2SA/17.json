{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":17,"content":[{"type":"heading","content":["ཧུ་ཤཱ་ཨི་ཡིས་ཨ་ཧི་ཐོ་ཕེལ་གྱི་ཐབས་ཇུས་ལ་གཏོར་བརླག་བྱས་པ།"]},{"type":"verse","number":1,"content":["ཡང་ཨ་ཧི་ཐོ་ཕེལ་གྱིས་ཨབ་ཤཱ་ལོམ་ལ། བདག་ལ་མི་ཆིག་ཁྲི་ཉིས་སྟོང་གདམ་གསེས་བྱེད་པར་གནོངས་ཤིག དོ་དགོང་ལངས་ནས་དཱ་བིད་ཀྱི་ར་མདར་རྒྱུག་པར་བྱ།"]},{"type":"verse","number":2,"content":["ཁོ་རང་ཉམ་ཐག་ནས་སྟོབས་ཞན་པའི་དུས་སུ། བདག་ཁོའི་རྗེས་ཆོད་ནས་ཁོ་སྐྲག་པར་བྱ། ཁོ་དང་མཉམ་དུ་ཡོད་པའི་མི་ཐམས་ཅད་འབྲོ་ངེས་ཤིང་། བདག་གིས་རྒྱལ་པོ་འབའ་ཞིག་གསོད་པར་བྱའོ། །"]},{"type":"verse","number":3,"content":["ཡང་བདག་གིས་མི་ཐམས་ཅད་ཁྱེད་ཀྱི་ཕྱོགས་སུ་འགུག་པར་བྱ་སྟེ། ཁྱེད་ཀྱིས་སྙེག་པའི་མི་དེ་ལས་གཞན་ཐམས་ཅད་ཁྱེད་ཕྱོགས་འཁོར་འོང་བའི་དུས་སུ། མི་ཐམས་ཅད་བདེ་ཞིང་འཇགས་པར་འགྱུར་ཞེས་སྨྲས།"]},{"type":"verse","number":4,"content":["ཨབ་ཤཱ་ལོམ་དང་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་གཏམ་དེ་ལ་ཤིན་ཏུ་དགའ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཨབ་ཤཱ་ལོམ་གྱིས། ཨ་རག་པ་ཧུ་ཤཱ་ཨི་ཡང་འདི་རུ་བོས་ཤོག་དང་། དེས་ཅི་ལྟར་སྨྲ་བ་ལ་ཡང་མཉན་པར་བྱ་ཞེས་བཀའ་བསྩལ།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཧུ་ཤཱ་ཨི་ཁོང་ཉིད་ཨབ་ཤཱ་ལོམ་གྱི་དྲུང་དུ་འོངས་པའི་ཚེ། ཨབ་ཤཱ་ལོམ་གྱིས་དེ་ལ། ཨ་ཧི་ཐོ་ཕེལ་གྱིས་འདི་ལྟར་སྨྲས་པས། རང་ཅག་གིས་དེའི་གྲོས་བཞིན་དུ་བྱེད་རུང་ངམ་མི་རུང་། ཁྱོད་ཀྱིས་གཏམ་བྱོས་ཤིག་ཅེས་བསྐུལ་བས།"]},{"type":"verse","number":7,"content":["ཧུ་ཤཱ་ཨི་ཡིས་ཨབ་ཤཱ་ལོམ་ལ། ད་རེས་ཨ་ཧི་ཐོ་ཕེལ་གྱིས་བཏོན་པའི་བློ་བཀོད་ནི་མི་ལེགས་ཞེས་དང་།"]},{"type":"verse","number":8,"content":["ཡང་ཧུ་ཤཱ་ཨི་ན་རེ། ཁྱེད་ཀྱི་ཕ་དང་དེའི་མི་རྣམས་ནི་དཔའ་རྩལ་ཅན་ཡིན་པ་དང་། རི་ཐང་གི་དོམ་ཕྲུག་ཕྲོགས་ནས་ཁྱེར་བའི་དོམ་དང་འདྲ་བར། དེ་དག་གི་སེམས་ནི་ཞེ་སྡང་གིས་ཁེངས་པ་ཁྱེད་ཀྱིས་ཤེས་སོ། །ཡང་ཁྱེད་ཀྱི་ཕ་ནི་དམག་ཅིག་ཡིན་པས་མི་རྣམས་ཀྱི་ཁྲོད་དུ་གནས་མི་སྲིད།"]},{"type":"verse","number":9,"content":["གཟིགས་དང་། ཁོ་ནི་ད་ལྟ་ས་ཁུང་ངམ་གནས་གཞན་ཞིག་ཏུ་ཡིབ་ནས་བསྡད་ཡོད་ཀྱང་སྲིད། གལ་ཏེ་བདག་ཅག་ལས་མི་ཞིག་ཐོག་མར་བསད་པ་ཡིན་ན། དེ་ཐོས་མཁན་རྣམས་ཀྱིས། ཨབ་ཤཱ་ལོམ་གྱི་རྗེས་སུ་འབྲངས་པ་རྣམས་འགེམས་སོ་ཞེས་བརྗོད་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["ཁྱེད་ཀྱི་ཕ་ནི་དཔའ་བོ་ཡིན་པ་དང་དེ་དང་མཉམ་དུ་ཡོད་པ་རྣམས་ཀྱང་དཔའ་རྩལ་ཅན་ཡིན་པ་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ཤེས་པས། སེང་གེ་ལྟ་བུའི་སྙིང་སྟོབས་ཅན་རྣམས་ཀྱི་སེམས་ཀྱང་ཕམ་པར་འགྱུར།"]},{"type":"verse","number":11,"content":["དེ་བས་བདག་གི་བྱུས་ལྟར་ན། དཱན་ནས་བཟུང་སྟེ་པེར་ཤ་བཱ་ཡི་བར་དུ། རྒྱ་མཚོའི་འགྲམ་གྱི་བྱེ་མ་བཞིན་མང་བའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཁྱེད་ཀྱི་ཕྱོགས་སུ་བསྡུས་ནས། ཁྱེད་ཀྱིས་སྐུ་དངོས་སུ་དེ་རྣམས་ཁྲིད་ནས་འཐབ་མོར་ཞུགས་དགོས།"]},{"type":"verse","number":12,"content":["དེ་ལྟར་ཁོ་གང་དུ་སོང་ནའང་། ས་ལ་ཟིལ་བ་འབབ་པ་ལྟར་རང་ཅག་ཁོའི་ཐོག་ཏུ་འབབ་པ་དང་། ཁོ་རང་དང་ཁོའི་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་ལས་གཅིག་ཀྱང་ལུས་པར་མི་འགྱུར།"]},{"type":"verse","number":13,"content":["གལ་ཏེ་ཁོ་རང་གྲོང་ཁྱེར་ཞིག་གི་ནང་དུ་ཕྱི་བསྣུར་བྱས་ན། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ཐག་པ་ཁུར་ནས་གྲོང་ཁྱེར་དེ་རུ་སོང་སྟེ། རང་ཅག་གིས་གྲོང་ཁྱེར་དེ་གྲོག་མོའི་ནང་དུ་དྲུད་ནས་ཐ་ན་རྡོ་ཕྲུག་གཅིག་ཀྱང་མི་ལུས་པར་བྱེད་ངེས་ཡིན་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":14,"content":["ཨབ་ཤཱ་ལོམ་དང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས། ཨ་རག་པ་ཧུ་ཤཱ་ཨི་ཡི་ཐབས་ཇུས་ནི་ཨ་ཧི་ཐོ་ཕེལ་གྱི་ཐབས་ཇུས་ལས་ལྷག་པ་ཡིན་ཞེས་སྨྲས་སོ། །གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཨབ་ཤཱ་ལོམ་གྱི་སྟེང་དུ་བར་ཆད་འབེབ་པའི་ཕྱིར། ཨ་ཧི་ཐོ་ཕེལ་གྱི་ཐབས་བཟང་དེ་མེད་པར་མཛད་པའི་ཐུགས་ཐག་བཅད་པ་ཡིན་ནོ། །"]},{"type":"heading","content":["དཱ་བིད་བྲོས་པ།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཧུ་ཤཱ་ཨི་ཡིས་མཆོད་དཔོན་ཟཱ་ཏོག་དང་ཨབ་ཡཱ་ཐར་གཉིས་ལ། ཨ་ཧི་ཐོ་ཕེལ་གྱིས་ཨབ་ཤཱ་ལོམ་དང་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ལ་འདི་དང་དེ་བཞིན་གྲོས་བཏབ་པ་དང་། ངས་ཀྱང་འདི་དང་དེ་བཞིན་གྲོས་བཏབ་པ་ཡིན།"]},{"type":"verse","number":16,"content":["ད་ལྟ་ཁྱོད་ཅག་གིས་གང་མྱུར་གྱིས་བང་ཆེན་མངགས་ནས་དཱ་བིད་ལ། དོ་དགོང་དབེན་སྟོང་གི་རབ་ཁ་རུ་མི་བཞུགས་པར་ཅི་ནས་ཀྱང་གཙང་པོའི་ཕ་རོལ་ཏུ་བརྒལ་དགོས། དེ་མིན་ཚེ་རྒྱལ་པོ་དང་ཁོང་གི་རྗེས་འབྲང་ཐམས་ཅད་འགེམ་པར་འགྱུར་རོ་ཞུ་དགོས་ཞེས་གདམས་སོ། །"]},{"type":"verse","number":17,"content":["ཡོ་ནཱ་ཐན་དང་ཨ་ཧི་མཱ་ཨ་སི་གཉིས་ཀྱིས་ཨེན་རོ་གེལ་",{"noteId":20},"དུ་སྒུག་བསྡད་ཅིང་། གཞན་གྱིས་མཐོང་བར་དོགས་ནས་གྲོང་ཁྱེར་ནང་དུ་འགྲོ་མ་ཕོད་པ་རེད། དེ་ནས་གཡོག་མོ་ཞིག་འོངས་ནས་ཁོ་གཉིས་ལ་གནས་ཚུལ་སྨྲས་པ་ལ། དེ་གཉིས་སོང་སྟེ་རྒྱལ་པོ་དཱ་བིད་ལ་འཕྲིན་བསྐྱལ་ཏོ། །"]},{"type":"verse","number":18,"content":["ཡིན་ཡང་གཞོན་ནུ་ཞིག་གིས་ཁོ་གཉིས་མཐོང་བ་དང་སོང་ནས་ཨབ་ཤཱ་ལོམ་ལ་ཞུས་ཤིང་། ཁོ་གཉིས་མྱུར་དུ་སོང་སྟེ་པཱ་ཧུ་རིམ་དུ་མི་ཞིག་གི་ཁྱིམ་ལ་སླེབས་པ་དང་། ར་སྐོར་ནང་དུ་དོང་ཆུ་ཞིག་ཡོད་པ་དེའི་ནང་དུ་བབས།"]},{"type":"verse","number":19,"content":["ཡང་ཁྱིམ་དེའི་བུད་མེད་ཀྱིས་ཁ་གཅོད་ཅིག་བླངས་ནས་དོང་ཆུའི་ཁ་བཅད་པ་དང་། དེའི་ཁར་འབྲུ་རིགས་བརྡལ་བས་དོན་དེ་ཕྱི་རུ་མ་ཤོར་བ་རེད།"]},{"type":"verse","number":20,"content":["ཨབ་ཤཱ་ལོམ་གྱི་འཁོར་གཡོག་རྣམས་བུད་མེད་དེའི་ཁྱིམ་དུ་འོངས་ནས། ཨ་ཧི་མཱ་ཨ་སི་དང་ཡོ་ནཱ་ཐན་གཉིས་གང་དུ་ཡོད་དམ་ཞེས་དྲིས་པར། བུད་མེད་ཀྱིས། དེ་གཉིས་ཆུ་བོ་བརྒལ་ཚར་རོ་ཞེས་སྨྲས་ཤིང་། དེ་དག་གིས་ཁོ་གཉིས་བཙལ་ཡང་མ་རྙེད་པས་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་གོ །"]},{"type":"verse","number":21,"content":["དེ་དག་སོང་རྗེས་ཁོ་གཉིས་དོང་ཆུ་ལས་ཡར་འོངས་ནས་སོང་སྟེ་རྒྱལ་པོ་དཱ་བིད་ལ། ཨ་ཧི་ཐོ་ཕེལ་གྱིས་ཁྱེད་ལ་གནོད་བསྐྱལ་བའི་ཐབས་འདི་བཞིན་བྱས་པས། ཁྱེད་རྣམས་གང་མྱུར་གྱིས་ཡར་ལངས་ནས་གཙང་པོ་བརྒལ་དགོས་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":22,"content":["དཱ་བིད་དང་ཁོང་གི་རྗེས་འབྲང་ཐམས་ཅད་ཡར་ལངས་ནས་ཡོར་དན་གཙང་པོ་བརྒལ་ཞིང་། ནམ་ལངས་དུས་གཅིག་ཀྱང་མ་ལུས་པར་ཡོར་དན་གཙང་པོ་བརྒལ་བ་རེད།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཨ་ཧི་ཐོ་ཕེལ་གྱིས་རང་གི་ཐབས་ཇུས་ལ་མ་བསྟུན་པ་མཐོང་བས། བོང་བུར་སྒ་བསྟད་ནས་རང་གི་གྲོང་ཁྱེར་དུ་ལོག་སྟེ་ཁྱིམ་དུ་སླེབས་ཙ་ན། ཁོས་དེ་རུ་ཁ་ཆེམས་བཞག་ནས་ལྕེབས་པ་དང་། ཁོའི་བེམ་པོ་ནི་ཁོའི་ཕ་ཡི་དུར་དུ་བསྐུངས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་དཱ་བིད་མཱ་ཧ་ནཱ་ཡིམ་དུ་སླེབས་པ་དང་། ཨབ་ཤཱ་ལོམ་དང་ཁོའི་རྗེས་སུ་འབྲངས་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱང་ཡོར་དན་གཙང་པོ་བརྒལ་ཏེ་སོང་ངོ་། །"]},{"type":"verse","number":25,"content":["དེར་ཨབ་ཤཱ་ལོམ་གྱིས་ཡོ་ཨབ་ཀྱི་ཚབ་ཏུ་ཨ་མ་སཱ་དམག་དཔོན་དུ་བསྐོས་སོ། །ཨ་མ་སཱ་ནི་ཡེས་ར་ཨེལ་པ་ཡེད་རཱ་བྱ་བའི་བུ་ཡིན་ཏེ། ཡེད་རཱ་ནི་ནཱ་ཧ་སིའི་བུ་མོ་ཨ་བི་གཱ་ཡིལ་བྱ་བར་འགྲོགས་མྱོང་བ་ཡིན། ཨ་བི་གཱ་ཡིལ་ནི་ཡོ་ཨབ་ཀྱི་མ་ཟེ་རུ་ཡཱ་ཡི་མིང་སྲིང་ཡིན་ནོ། །"]},{"type":"verse","number":26,"content":["ཨབ་ཤཱ་ལོམ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་གིལ་ཨད་ཡུལ་དུ་སྒར་བཏབ་བོ། །"]},{"type":"verse","number":27,"content":["ཡང་དཱ་བིད་མཱ་ཧ་ནཱ་ཡིམ་དུ་སླེབས་དུས་སུ། ཨམ་མོན་རིགས་ཀྱི་རབ་བཱ་ནས་ཐོན་པའི་ནཱ་ཧ་སིའི་བུ་ཤོ་བི་དང་། ལོ་རྡེ་བཱར་པ་ཨམ་མེ་ཨེལ་གྱི་བུ་མཱ་ཀིར་དང་། རོ་གེ་ལིམ་ནས་ཐོན་པའི་གིལ་ཨད་པ་པཱར་ཟིལ་ལ་ཨི་གསུམ་པོས།"]},{"type":"verse","number":28,"content":["མལ་ཆས་དང་གཞོང་པ། རྫ་མ། གྲོ། ནས། བག་ཕྱེ། ཡོས། སྲན་མ། སྲན་དམར། སྲན་ཡོས།"]},{"type":"verse","number":29,"content":["སྦྲང་རྩི། མར། ལུག བ་མོའི་འོ་ཕྱུར་བཅས་ཁྱེར་ཡོང་ནས་དཱ་བིད་དང་ཁོང་གི་རྗེས་འབྲང་རྣམས་ཀྱི་ཟས་སུ་དྲངས་ཏེ། དེ་དག་གིས་མི་ཚོགས་ནི་དབེན་སྟོང་དུ་བཀྲེས་སྐོམ་མྱངས་ཤིང་དུབ་པ་ཡིན་ནོ་སྙམ་པས་སོ། །"]}],"footnotes":[{"noteId":20,"caller":"+","text":"འདིར་ཨེན་རོ་གེལ་ཞེས་པ་ནི་རོ་གེལ་ཆུ་མིག་ཅེས་པ་ཡིན་ཏེ། ཡེ་རུ་སཱ་ལེམ་གྱི་ཤར་ལྷོའི་མཚམས་སུ་ཡོད་ཅིང་བུད་མེད་རྣམས་ཆུ་ལེན་དུ་འགྲོ་ས་ཡིན།","reference":{"chapter":17,"verse":17}}]},"thisChapterLink":"/api/bod_ntb/2SA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/16.json","previousChapterAudioLinks":{},"numberOfVerses":29}