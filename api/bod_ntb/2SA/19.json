{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":19,"content":[{"type":"heading","content":["ཡོ་ཨབ་ཀྱིས་རྒྱལ་པོའི་སྐྱོན་བརྗོད་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་མི་ཞིག་གིས་ཡོ་ཨབ་ལ། གཟིགས་དང་། རྒྱལ་པོས་ཨབ་ཤཱ་ལོམ་གྱི་དོན་དུ་ངུ་ཞིང་མྱ་ངན་བྱེད་དོ་ཞེས་སྨྲས།"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་ཉིད་ཀྱི་སྲས་ཀྱི་ཕྱིར་ཐུགས་སྐྱོ་བ་དམག་དཔུང་ཡོངས་ཀྱིས་ཐོས་པས། རྒྱལ་ཁ་ཐོབ་པའི་ཉིན་དེ་ནི་ཁོ་ཚོར་མཚོན་ན་སྡུག་བསྔལ་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":3,"content":["ཉིན་མོ་དེར་དམག་རྣམས་ནི་གཡུལ་ལས་བྲོས་ཤིང་ངོ་གནོང་བའི་དམག་མི་བཞིན་དུ། ལྐོག་ནས་གྲོང་ཁྱེར་དུ་ཞུགས་པ་རེད།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོས་ཞལ་ངོ་བཏུམས་ཏེ་སྐད་ཆེན་པོས་ངུས་ཤིང་། ཀྱེ་ངའི་བུ་ཨབ་ཤཱ་ལོམ། ཀྱེ་ཨབ་ཤཱ་ལོམ། ངའི་བུ། ངའི་བུ་ཞེས་བོས་པ་དང་།"]},{"type":"verse","number":5,"content":["ཡོ་ཨབ་རྒྱལ་པོའི་དྲུང་དུ་ཕོ་བྲང་ནང་སོང་སྟེ་འདི་ལྟར། དེ་རིང་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་འཁོར་གཡོག་ཐམས་ཅད་ངོ་ཚར་གཏད་པ་ཡིན། དེ་དག་གིས་ཁྱེད་ཀྱི་སྲོག་དང་། ཁྱེད་ཀྱི་སྲས་དང་སྲས་མོའི་སྲོག་དང་། ཁྱེད་ཀྱི་ཆེན་ཆུན་རྣམས་ཀྱི་སྲོག་བསྐྱབས་ཀྱང་།"]},{"type":"verse","number":6,"content":["ཁྱེད་ཀྱིས་ཉིད་ལ་འཁོན་པ་རྣམས་ལ་བྱམས་པ་དང་། ཁྱེད་ལ་བརྩེ་བ་རྣམས་ལ་སྡང་བར་མཛད་དོ། །དེ་རིང་ཁྱེད་ཀྱིས་དམག་དཔོན་དང་འཁོར་གཡོག་གཉིས་ཀ་ཐུགས་སུ་མེད་པ་དེ་བསྟན་པ་ཡིན། གལ་ཏེ་ཨབ་ཤཱ་ལོམ་གསོན་ཞིང་། བདག་ཅག་ཐམས་ཅད་ཤི་བ་ཡིན་ན་ཁྱེད་ཐུགས་དགྱེས་པ་དེ་རིང་བདག་གིས་རྟོགས་སོང་།"]},{"type":"verse","number":7,"content":["ད་ལྟ་ཁྱེད་རང་ཡར་བཞེངས་ནས་ཕྱི་རུ་ཕེབས་ཏེ་ཁྱེད་ཀྱི་འཁོར་གཡོག་རྣམས་ལ་སེམས་གསོ་གནོངས་ཤིག ངས་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་ཏེ། གལ་ཏེ་ཁྱེད་རང་ཕྱི་རུ་མི་འགྲོ་ན། དོ་དགོང་ཁྱེད་དང་མཉམ་དུ་མི་གཅིག་ཀྱང་འདུག་མི་སྲིད་དེ། གེགས་བར་ཆད་འདི་ནི་ཁྱེད་རང་སྐུ་ན་ཕྲ་མོ་ནས་ད་བར་དུ་ཕྲད་པའི་སྡུག་བསྔལ་ཐམས་ཅད་ལས་ལྷག་པར་ཚབས་ཆེའོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":8,"content":["རྒྱལ་པོ་ཡར་བཞེངས་ནས་མཁར་སྒོར་བཞུགས་པ་ལ། མི་ཐམས་ཅད་ཀྱིས་རྒྱལ་པོ་མཁར་སྒོར་བཞུགས་པ་ཐོས་པས་ཐམས་ཅད་རྒྱལ་པོའི་དྲུང་དུ་འོངས་སོ། །སྐབས་དེར་ཡེས་ར་ཨེལ་པ་རྣམས་བྲོས་ནས་རང་རང་གི་གུར་དུ་ཕྱིན་ཏོ། །"]},{"type":"heading","content":["དཱ་བིད་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་པ།"]},{"type":"verse","number":9,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཐམས་ཅད་ཀྱི་མི་རྣམས་ཀྱི་ཁྲོད་དུ་རྩོད་གླེང་བྱུང་སྟེ་ན་རེ། རྒྱལ་པོས་བདག་ཅག་ནི་དགྲ་བོ་རྣམས་ཀྱི་ལག་ནས་ཐར་བར་མཛད་པ་དང་། ཕེ་ལེ་ཤེད་པའི་ལག་ནས་ཀྱང་ཐར་བར་མཛད་ཀྱང་། ད་ལྟ་ཨབ་ཤཱ་ལོམ་གྱི་ཕྱིར་རང་རེའི་ཡུལ་འདི་ནས་འབྲོ་དགོས་བྱུང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["འོ་སྐོལ་ཚོས་རྒྱལ་པོར་བྱུགས་པའི་ཨབ་ཤཱ་ལོམ་ནི་གཡུལ་ངོར་ཤིའོ། །ད་ལྟ་ཁྱོད་ཚོས་རྒྱལ་པོ་སླར་སྤྱན་འདྲེན་པའི་སྐོར་ཚིག་གཅིག་ཀྱང་མི་ལབ་པ་ཅི་ཞེས་གཏམ་བྱས་སོ། །"]},{"type":"verse","number":11,"content":["དེར་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་མཆོད་དཔོན་ཟཱ་ཏོག་དང་ཨབ་ཡཱ་ཐར་གཉིས་ལ་ངག་འཕྲིན་བསྐུར་ནས་འདི་ལྟར། ཁྱོད་གཉིས་ཀྱིས་ཡ་ཧུ་དཱ་ཡི་རྒན་པོ་རྣམས་ལ་འདི་སྐད་སྨྲ་དགོས་ཏེ། རྒྱལ་པོ་ཕྱིར་ཕོ་བྲང་དུ་སྤྱན་འདྲེན་པའི་དོན་གྱི་ཐད་ཁྱོད་རྣམས་གཞན་པའི་རྗེས་སུ་ལུས་པ་ཅི་ཡིན་ནམ། ཡེས་ར་ཨེལ་པ་ཡོངས་ཀྱིས་རྒྱལ་པོ་ཕྱིར་སྤྱན་འདྲེན་པའི་གཏམ་ནི་རྒྱལ་པོའི་དྲུང་དང་རྒྱལ་པོའི་ཕོ་བྲང་དུ་སླེབས་ཚར།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ངའི་སྤུན་ཟླ་དང་ཤ་རུས་ཡིན་པས། རྒྱལ་པོ་ཕྱིར་སྤྱན་འདྲེན་པར་ཁྱོད་རྣམས་རྗེས་སུ་ལུས་པ་ཅི་ཡིན་ཞེས་དང་།"]},{"type":"verse","number":13,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་ཨ་མ་སཱ་ལ་འདི་ལྟར། ཁྱོད་ངའི་ཤ་རུས་མ་ཡིན་ནམ། གལ་ཏེ་ངས་ཁྱོད་ནི་ཡོ་ཨབ་ཀྱི་ཚབ་ལ་བདག་གི་དྲུང་ནས་གཏན་དུ་དམག་དཔོན་དུ་མི་བྱེད་ན། དཀོན་མཆོག་གིས་བདག་ལ་འདིའམ་འདི་ལས་ལྷག་པ་ཞིག་མཛད་པར་ཤོག་ཅེས་སྨྲ་དགོས་ཞེས་བསྒོས།"]},{"type":"verse","number":14,"content":["དེ་ལྟར་ཁོང་གིས་མི་གཅིག་གི་སེམས་བཀུག་པ་ལྟར་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་སེམས་བཀུག་པར་མཛད་ཅིང་། དེ་དག་གིས་རྒྱལ་པོའི་དྲུང་དུ་མི་མངགས་ནས། རྒྱལ་པོ་དང་རྒྱལ་པོའི་བློན་འཁོར་རྣམས་ཕྱིར་ཕེབས་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་རྒྱལ་པོ་ཕྱིར་ཕེབས་ནས་ཡོར་དན་གཙང་པོའི་འགྲམ་དུ་སླེབས། ཡ་ཧུ་དཱ་པ་རྣམས་རྒྱལ་པོ་ཡོར་དན་གཙང་པོའི་ཚུར་ཕྱོགས་ལ་བསུ་བར་གིལ་གལ་དུ་སླེབས།"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་དགྲ་རྣམས་ལ་དགོངས་སེལ་གནང་བ།"]},{"type":"verse","number":16,"content":["ཡང་པེན་ཡཱ་མེན་པ་གེ་རཱ་ཡི་བུ་སྟེ། པཱ་ཧུ་རིམ་ནས་ཐོན་པའི་ཤིམ་ཨི་བྱ་བ་དེ་རྟབ་རྟབ་པོར་ཡ་ཧུ་དཱ་པ་རྣམས་དང་མཉམ་དུ་མར་སོང་ནས་རྒྱལ་པོ་དཱ་བིད་ལ་བསུ་བ་བྱས།"]},{"type":"verse","number":17,"content":["ཤིམ་ཨི་དང་མཉམ་དུ་པེན་ཡཱ་མེན་པ་མི་ཆིག་སྟོང་དང་། སོ་ལོ་ཚང་གི་གཡོག་པོ་ཙི་བཱ་དང་དེའི་བུ་བཅོ་ལྔ་དང་ཞབས་ཕྱི་ཉི་ཤུ་བཅས་ཡོད་པ་ཡིན། དེ་དག་བྲེལ་མྱུར་གྱིས་ཡོར་དན་གཙང་པོ་བརྒལ་ཏེ་རྒྱལ་པོའི་དྲུང་དུ་སོང་ཞིང་།"]},{"type":"verse","number":18,"content":["མི་རྣམས་རབ་ཁ་བརྒྱུད་ནས་རྒྱལ་པོའི་ཐུགས་དགོངས་བཞིན་རྒྱལ་པོ་དང་ཁོང་གི་ཁྱིམ་མི་རྣམས་གཙང་པོ་བརྒལ་དུ་བཅུག་པ་དང་། དཱ་བིད་ཡོར་དན་གཙང་པོ་བརྒལ་ནས་ཕེབས་པར་བརྩམས་པའི་ཚེ། གེ་རཱ་ཡི་བུ་ཤིམ་ཨི་ཡིས་རྒྱལ་པོའི་དྲུང་དུ་ལུས་སར་བཏུད་ནས་ཕྱག་བཙལ་བ་དང་།"]},{"type":"verse","number":19,"content":["རྒྱལ་པོ་ལ་འདི་ལྟར། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ཡེ་རུ་སཱ་ལེམ་དང་བྲལ་བའི་ཉིན་མོར་ཞབས་ཕྱི་བདག་གིས་ཉེས་པ་བཟོས་ཟིན། ད་ནི་བདག་གི་ཇོ་བོས་བདག་ལ་ཉེས་པ་མི་འགེལ་བ་དང་། རྒྱལ་པོའི་ཡིད་ལ་མི་དྲན་ཞིང་ཐུགས་སུའང་མི་འཛིན་པར་མཁྱེན།"]},{"type":"verse","number":20,"content":["གཟིགས་དང་། ཞབས་ཕྱིས་རང་ལ་སྡིག་ཉེས་ཡོད་པ་ཤེས་བཞིན་དུ། ཡོ་སེབ་ཀྱི་ཁྱིམ་རྒྱུད་ཡོངས་ཀྱི་ཁྲོད་ནས་དེ་རིང་ཉིན་མོར་ང་རང་ཐོག་མར་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་བསུ་བར་འདིར་འོངས་པ་ཡིན་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":21,"content":["ཟེ་རུ་ཡཱ་ཡི་བུ་ཨ་བི་ཤཱ་ཨི་ཡིས་དེའི་ལན་དུ། ཤིམ་ཨི་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པ་ལ་དམོད་མོ་བཏབ་པས་ཁོ་གསོད་པར་མི་འོས་སམ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":22,"content":["དཱ་བིད་ཀྱིས། ཟེ་རུ་ཡཱ་ཡི་བུ་རྣམས། ཁྱོད་ཅག་ང་དང་འབྲེལ་བ་ཅི་ཡོད། ཁྱོད་ཅག་གིས་དེ་རིང་ང་ལ་རྒོལ་ལན་སྤྲོད་དམ། དེ་རིང་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་ནས་སུ་ཞིག་གསོད་རུང་ངམ། བདག་གིས་རང་ཉིད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡིན་པ་མི་ཤེས་སམ་ཞེས་གསུངས་ནས།"]},{"type":"verse","number":23,"content":["རྒྱལ་པོས་ཤིམ་ཨི་ལ། ཁྱོད་འཆི་བར་མི་འགྱུར་རོ་ཞེས་བསྒོས་ཤིང་ཁོ་ལ་མནའ་བསྐྱལ་ཏོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་མེ་ཕི་པོ་ཤེད་གཅེས་སུ་བཟུང་བ།"]},{"type":"verse","number":24,"content":["དེར་སོ་ལོའི་ཚ་བོ་མེ་ཕི་པོ་ཤེད་ཀྱང་རྒྱལ་པོ་བསུ་བར་འོངས། དེས་རྒྱལ་པོ་ཕྱིན་པའི་ཉིན་ནས་བཟུང་ཁོང་བདེ་བར་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིར་ཕེབས་པའི་བར་དུ། རྐང་པ་མ་བཀྲུས་ཤིང་སྨ་ར་མ་བཞར་ལ། གོས་ཀྱང་མ་བཀྲུས་སོ། །"]},{"type":"verse","number":25,"content":["ཡང་ཁོ་རང་ཡེ་རུ་སཱ་ལེམ་དུ་རྒྱལ་པོ་བསུ་བར་འོངས་པའི་ཚེ། རྒྱལ་པོས་དེ་ལ། ཀྱེ་མེ་ཕི་པོ་ཤེད། ཁྱོད་ང་དང་མཉམ་དུ་ཅིའི་ཕྱིར་མ་སོང་ངམ་ཞེས་དྲིས་པའི་ལན་དུ།"]},{"type":"verse","number":26,"content":["ཁོ་ན་རེ། ཀྱེ་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལགས། བདག་གི་ཞབས་ཕྱིས་",{"noteId":21},"བདག་ལ་མགོ་བསྐོར་བཏང་བ་རེད། ཞབས་ཕྱི་བདག་ནི་ཞ་བོ་ཡིན་པས། ཉིན་དེར་ཞབས་ཕྱི་བདག་གིས་བོང་བུར་སྒ་བསྟད་ནས་རྒྱལ་པོ་མཉམ་དུ་འགྲོ་བར་བསམ་པ་ཡིན་མོད།"]},{"type":"verse","number":27,"content":["འོན་ཀྱང་མི་དེས་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོའི་དྲུང་དུ་ཞབས་ཕྱིར་སྐུར་འདེབས་བྱས་པ་རེད། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ནི་དཀོན་མཆོག་གི་ཕོ་ཉ་དང་འདྲ་བས། ཁྱེད་ཀྱི་སྤྱན་སྔར་གང་ཞིག་ལེགས་ན་དེ་བཞིན་མཛོད་ཅིག"]},{"type":"verse","number":28,"content":["བདག་གི་ཕ་རྒྱུད་ཐམས་ཅད་ནི་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོའི་དྲུང་དུ་ཤི་འོས་པའི་མི་ལྟ་བུ་ཡིན་ཡང་། རྒྱལ་པོ་ཁྱེད་ཀྱིས་ཞབས་ཕྱི་བདག་ནི་ཁྱེད་ཀྱི་གསོལ་ལྕོག་ལས་ཟས་སྤྱོད་པའི་གྲལ་དུ་བཅུག་པས། ད་ནི་བདག་ལ་རྒྱལ་པོར་འོ་དོད་འབོད་པའི་དབང་ཞིག་གང་དུ་ཡོད་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":29,"content":["རྒྱལ་པོས་དེ་ལ། ཁྱོད་ཀྱིས་ད་དུང་རང་གི་དོན་རྣམས་གླེང་བ་དེ་ཅི་ཡིན། ངས་ནི་ཁྱོད་དང་ཙི་བཱ་གཉིས་ཀྱིས་ས་ཞིང་བགོ་བར་བྱོས་ཤིག་ཅེས་བསྒོའོ་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":30,"content":["མེ་ཕི་པོ་ཤེད་ཀྱིས་རྒྱལ་པོ་ལ། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་བདེ་བར་རང་གི་ཕོ་བྲང་དུ་སླེབས་བྱུང་བས། ཐ་ན་ཐམས་ཅད་ཙི་བཱ་ཡིས་ཁྱེར་ཡང་ཆོག་ཅེས་གསོལ་ཏོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱིས་པཱར་ཟིལ་ལ་ཨི་གཅེས་སུ་བཟུང་བ།"]},{"type":"verse","number":31,"content":["གཞན་ཡང་གིལ་ཨད་པ་པཱར་ཟིལ་ལ་ཨི་ནི་རོ་གེ་ལིམ་ནས་མར་འོངས་ཤིང་། རྒྱལ་པོ་སྲུང་སྐྱེལ་བགྱི་བའི་ཕྱིར་ཁོང་དང་ལྷན་ཅིག་ཡོར་དན་གཙང་པོ་བརྒལ་བའོ། །"]},{"type":"verse","number":32,"content":["པཱར་ཟིལ་ལ་ཨི་ནི་ཤིན་ཏུ་རྒས་ཤིང་ལོ་བརྒྱད་ཅུར་སོན་པ་ཞིག་ཡིན་ཏེ། ཡང་ཁོ་ནི་ཕྱུག་བདག་ཅིག་ཡིན་པས་རྒྱལ་པོ་མཱ་ཧ་ནཱ་ཡིམ་དུ་ལུས་པའི་ཚེ་ཁོས་ཁ་ཟས་བསྐྱལ་ཏོ། །"]},{"type":"verse","number":33,"content":["དེར་རྒྱལ་པོས་པཱར་ཟིལ་ལ་ཨི་ལ། ཁྱེད་རང་ང་དང་མཉམ་དུ་ཕར་འགྲོ་དང་། ངས་ཡེ་རུ་སཱ་ལེམ་དུ་རང་གི་རྩར་ཁྱེད་ཉིད་གསོ་སྐྱོང་བྱའོ་ཞེས་གསུངས་ཀྱང་།"]},{"type":"verse","number":34,"content":["པཱར་ཟིལ་ལ་ཨི་ཡིས་རྒྱལ་པོ་ལ། ཕྲན་ཆུང་བདག་རྒྱལ་པོ་དང་མཉམ་དུ་ཡེ་རུ་སཱ་ལེམ་ནས་ད་དུང་ལོ་ཅི་ཙམ་ལ་སྡོད་ཐུབ་བམ།"]},{"type":"verse","number":35,"content":["དེ་རིང་བདག་ནི་ལོ་བརྒྱད་ཅུ་ལོན་པས། ད་དུང་ཡག་བཙོག་ཤེས་སམ། ད་དུང་བཟའ་བཏུང་གི་བྲོ་བ་མྱོང་ཐུབ་བམ། ད་དུང་གླུ་བ་ཕོ་མོའི་གླུ་སྐད་ཐོས་ནུས་སམ། ཞབས་ཕྱི་བདག་གིས་ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོར་འོ་བརྒྱལ་གཏོད་དགོས་དོན་ཅི་ཡོད།"]},{"type":"verse","number":36,"content":["ཞབས་ཕྱི་བདག་གིས་རྒྱལ་པོ་ཁྱེད་ཉིད་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་སྲུང་སྐྱེལ་བྱེད་པ་ནི་བྱ་བ་ཕྲན་བུ་ཞིག་ཡིན་ལ། རྒྱལ་པོས་བདག་ལ་དེ་ལྟ་བུའི་གསོལ་རས་གནང་དགོས་སམ།"]},{"type":"verse","number":37,"content":["ཁྱེད་ཀྱིས་ང་རང་ཕྱིར་ལོག་པར་གནོངས་ཤིག དེ་ནས་བདག་རང་གི་གྲོང་ཁྱེར་དུ་ཚེ་ལས་འདས་ཏེ་རང་གི་ཕ་མའི་དུར་ཁུང་དུ་བསྐུང་བར་འགྱུར་རོ། །ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཀིམ་ཧམ་ལ་གཟིགས་དང་། ཁོ་རང་བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་མཉམ་དུ་ཕར་འགྲོ་བར་མཛོད། ཁྱེད་ཀྱི་སྤྱན་སྔར་གང་ལེགས་ན་ཁོ་ལ་དེ་བཞིན་མཛོད་ཅིག་ཅེས་ཞུས་པའི་ལན་དུ།"]},{"type":"verse","number":38,"content":["རྒྱལ་པོས། ཀིམ་ཧམ་ནི་ང་དང་མཉམ་དུ་ཕར་སོང་ཆོག་སྟེ། ཁྱེད་ཀྱིས་གང་ལེགས་པར་འདོད་ན་ངས་ཁོ་ལ་དེ་བཞིན་བྱའོ། །ཁྱེད་ཀྱིས་ང་ལ་གང་ཞུས་ཀྱང་ངས་ཁྱེད་ཀྱི་ཕྱིར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":39,"content":["མི་ཚོགས་ཐམས་ཅད་ཡོར་དན་གཙང་པོ་བརྒལ་ཟིན་ཏེ། རྒྱལ་པོའང་ཚུར་འབྱོན་པའི་ཚེ། ཁོང་གིས་པཱར་ཟིལ་ལ་ཨི་ལ་འོ་བྱས་ཤིང་ཁོ་ལ་བྱིན་རླབས་མཛད་ནས་དེ་རང་ཡུལ་དུ་ལོག་གོ །"]},{"type":"verse","number":40,"content":["དེ་ནས་རྒྱལ་པོ་གཙང་པོ་བརྒལ་ཏེ་གིལ་གལ་དུ་སླེབས་པ་དང་། ཀིམ་ཧམ་ཡང་ཁོང་དང་མཉམ་དུ་སོང་ངོ་། །དེར་ཡ་ཧུ་དཱ་ཡི་མི་ཐམས་ཅད་དང་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱི་ཕྱེད་ཀས་རྒྱལ་པོར་སྐྱེལ་མ་བྱས།"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་ཡི་མི་རྣམས་བར་རྒྱལ་པོའི་ཆེད་དུ་རྩོད་པ་བྱུང་བ།"]},{"type":"verse","number":41,"content":["ལྟོས་དང་། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་རྒྱལ་པོའི་དྲུང་དུ་འོངས་ནས་རྒྱལ་པོ་ལ། རང་རེའི་སྤུན་ཟླ་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་རྒྱལ་པོ་དང་ཁོང་གི་ཁྱིམ་མི་རྣམས་དང་། ཁོང་གི་རྗེས་སུ་འབྲངས་པའི་མི་ཐམས་ཅད་ལ་ལྐོག་ནས་སྐྱེལ་མ་བྱས་ཏེ་ཡོར་དན་གཙང་པོ་བརྒལ་བ་ཡིན་ནམ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":42,"content":["ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ། ངེད་རྣམས་རྒྱལ་པོའི་གཉེན་ཉེ་ཡིན་པས་དེ་ལྟར་བྱས་ཏེ། ཁྱོད་རྣམས་ཅིའི་ཕྱིར་དེའི་དོན་དུ་ཁྲོའམ། ངེད་རྣམས་ཀྱིས་རྒྱལ་པོར་བརྟེན་ནས་ཅི་ཞིག་ཟོས་སམ། ཁོང་གིས་ངེད་རྣམས་ལ་གསོལ་རས་གང་ཞིག་གནང་བ་ཡིན་ནམ་ཞེས་ལན་སྨྲས་ཤིང་།"]},{"type":"verse","number":43,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་ལན་དུ། ངེད་རྣམས་ནི་རྒྱལ་པོ་དང་ལྡབ་བཅུ་",{"noteId":22},"ཡིས་ཉེ་ཞིང་། དཱ་བིད་ཀྱི་སྟེང་དུའང་ཁྱོད་ཚོ་ལས་ངེད་རྣམས་ལ་དབང་ཆེ་བ་ཡིན། ཁྱོད་ཚོས་ཅིའི་ཕྱིར་ངེད་རྣམས་ལ་མཐོང་ཆུང་བྱེད་དམ། རྒྱལ་པོ་ཕྱིར་གདན་འདྲེན་ཞུ་བའི་གྲོས་ནི་ཐོག་མར་ངེད་རྣམས་ཀྱིས་བཏབ་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་ནའང་། ཡ་ཧུ་དཱ་པའི་གཏམ་ནི་ཡེས་ར་ཨེལ་གྱི་གཏམ་ལས་ཀྱང་མཁྲེགས་པར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":21,"caller":"+","text":"འདིར་ཞབས་ཕྱི་ཞེས་པ་ནི་ཙི་བཱ་ལ་གོ་བ་ཡིན་ཏེ། སྔར་དཱ་བིད་ཡེ་རུ་སཱ་ལེམ་དུ་འབྲོ་བའི་སྐབས་སུ། ཁོས་ལམ་བར་དུ་དཱ་བིད་ལ་བསུ་བ་བྱས་ཤིང་ཁ་ཟས་སྣ་ཚོགས་ཕུལ་བར་མ་ཟད། རང་གི་བདག་པོ་སྟེ་མེ་ཕི་པོ་ཤེད་ལ་སྐུར་འདེབས་བཏང་བ་ཡིན།","reference":{"chapter":19,"verse":26}},{"noteId":22,"caller":"+","text":"འདིར་ལྡབ་བཅུ་ཞེས་པ་ནི་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཡེས་ར་ཨེལ་པའི་ཚོ་པ་བཅུ་གཉིས་པོ་ལ་སྲིད་བྱེད་ཅིང་། དེ་ལས་ཡེས་ར་ཨེལ་ནི་ཚོ་པ་བཅུ་ཡིན་པ་དང་། ཡ་ཧུ་དཱ་ནི་ཚོ་པ་གཅིག་རང་ཡིན་པར་གོ་དགོས།","reference":{"chapter":19,"verse":43}}]},"thisChapterLink":"/api/bod_ntb/2SA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/18.json","previousChapterAudioLinks":{},"numberOfVerses":43}