{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":2,"content":[{"type":"heading","content":["དཱ་བིད་བྱ་བ་ཡ་ཧུ་དཱའི་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར། བདག་ནི་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་དུ་འགྲོ་རུང་ངམ་ཞེས་ཞུས་པར། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ་ཁྱོད་སོང་ཞིག་ཅེས་གསུངས། ཡང་དཱ་བིད་ཀྱིས། བདག་གང་དུ་འགྲོའམ་ཞུས་པ་དང་ཁོང་གིས། ཧེབ་རོན་དུ་སོང་ཞིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":2,"content":["དེའི་ཕྱིར་དཱ་བིད་ཀྱིས་རང་གི་ཆུང་མ་གཉིས་ཀ་སྟེ་ཡེ་སི་རེ་ཨེལ་པ་ཨ་ཧི་ནོ་ཨམ་དང་། ཀར་མེལ་པ་ནཱ་རྦལ་གྱི་ཡུགས་མོར་ལུས་པའི་ཆུང་མ་ཨ་བི་གཱ་ཡིལ་བྱ་བ་གཉིས་ཁྲིད་ནས་ཕྱིན་ཏོ། །"]},{"type":"verse","number":3,"content":["ཡང་དཱ་བིད་ཀྱིས་རང་གི་དྲུང་དུ་ཡོད་པའི་མི་རྣམས་དང་དེ་དག་གི་ཁྱིམ་མི་རྣམས་ཁྲིད་དེ་ཧེབ་རོན་ཉེ་འདབས་ཀྱི་གྲོང་རྡལ་དག་ཏུ་གནས་སོ། །"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་འོངས་ནས་དཱ་བིད་ནི་ཡ་ཧུ་དཱ་ཁྱིམ་རྒྱུད་ཀྱི་རྒྱལ་པོར་བསྐོས་ཤིང་། ཡང་མི་ཞིག་གིས་དཱ་བིད་ལ་སོ་ལོའི་བེམ་པོ་དུར་དུ་འཇུག་མཁན་ནི་ཡཱ་བེ་སི་གིལ་ཨད་པ་རྣམས་ཡིན་ནོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":5,"content":["དཱ་བིད་གྱིས་ཡཱ་བེ་སི་གིལ་ཨད་པ་རྣམས་ལ་བང་ཆེན་མངགས་ནས་དེ་དག་ལ་ཁྱོད་ཅག་གིས་རང་གི་ཇོ་བོ་སོ་ལོ་ལ་དྲིན་བསྟན་ཅིང་དུར་དུ་བཅུག་པའི་ཕྱིར། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་བར་ཤོག"]},{"type":"verse","number":6,"content":["ཡང་དེ་ལྟར་བྱས་པས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་བྱམས་བརྩེ་དང་དྲང་བདེན་གྱིས་སྐྱོང་བར་མ་ཟད་ངས་ཀྱང་ཁྱོད་རྣམས་ལ་དྲིན་ལན་འཇལ་ལོ། །"]},{"type":"verse","number":7,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཀྱི་ཇོ་བོ་སྟེ་སོ་ལོ་གྲོངས་པ་དང་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ཀྱིས་ང་ནི་རྒྱལ་པོར་བསྐོས་པས་ཁྱོད་རྣམས་སྟོབས་ཤུགས་ཅན་དང་སྤོབས་པ་ཅན་དུ་འགྱུར་བར་ཤོག་ཅེས་སྨྲས་སོ། །"]},{"type":"heading","content":["ཨིས་པོ་ཤེད་བྱ་བ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":8,"content":["དེ་ནས་ནེར་གྱི་བུ་སྟེ། སོ་ལོའི་དམག་དཔུང་གི་དམག་དཔོན་ཨབ་ནེར་གྱིས་སྔར་སོ་ལོའི་སྲས་ཨིས་པོ་ཤེད་ཁྲིད་ནས་མཱ་ཧ་ནཱ་ཡིམ་གྱི་ཕ་རོལ་ཏུ་དྲངས་ཏེ།"]},{"type":"verse","number":9,"content":["གིལ་ཨད་དང་ཨ་ཤུར་པ་རྣམས་དང་། ཡེ་སི་རེ་ཨེལ་དང་། ཨེ་ཕཱར་ཡིམ་དང་། པེན་ཡཱ་མེན་དང་། ཡེས་ར་ཨེལ་ཡོངས་ཀྱི་རྒྱལ་པོར་བསྐོས་ཤིང་།"]},{"type":"verse","number":10,"content":["ཨིས་པོ་ཤེད་བྱ་བ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་བའི་དུས་སུ་ལོ་བཞི་བཅུ་ལོན་ཡོད་དེ། དེས་ལོ་གཉིས་ལ་སྲིད་བསྐྱངས་ནའང་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ནི་དཱ་བིད་ཀྱི་རྗེས་སུ་འབྲངས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་དཱ་བིད་ཀྱིས་ཧེབ་རོན་དུ་ལོ་བདུན་དང་ཟླ་དྲུག་གི་རིང་ལ་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ལ་སྲིད་བསྐྱངས་པའོ། །"]},{"type":"heading","content":["གིབ་ཡོན་ཡུལ་གྱི་དམག་འཁྲུག"]},{"type":"verse","number":12,"content":["དེ་ནས་ནེར་གྱི་བུ་ཨབ་ནེར་གྱིས་སོ་ལོའི་སྲས་ཨིས་པོ་ཤེད་འཁོར་དང་བཅས་པ་ཁྲིད་ནས་མཱ་ཧ་ནཱ་ཡིམ་ནས་ཐོན་ཞིང་གིབ་ཡོན་གྲོང་ཁྱེར་དུ་ཕྱིན།"]},{"type":"verse","number":13,"content":["ཡང་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་དང་དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ཀྱང་ཐོན་ཏེ། གིབ་ཡོན་གྱི་རྫིང་བུའི་འགྲམ་དུ་དེ་དག་དང་ཕྲད་ཅིང་། དཔུང་ཁག་གཅིག་ནི་རྫིང་བུའི་ཚུར་རོལ་དང་གཞན་དེ་རྫིང་བུའི་ཕ་རོལ་ཏུ་བསྡད་དོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་ཨབ་ནེར་གྱིས་ཡོ་ཨབ་ལ། གཞོན་ནུ་རྣམས་ཡར་ལངས་ཏེ་ངེད་ཅག་གི་མདུན་དུ་རྩལ་འགྲན་པར་བཀའ་གནོངས་ཤིག་ཅེས་སྨྲས་པར། ཡོ་ཨབ་ཀྱིས་ལེགས་སོ་དེ་དག་འགྲན་དུ་ཆུག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":15,"content":["པེན་ཡཱ་མེན་དང་སོ་ལོའི་སྲས་ཨིས་པོ་ཤེད་གཉིས་ཀྱི་ཕྱོགས་ནས་མི་བཅུ་གཉིས་དང་དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ལས་མི་བཅུ་གཉིས་རྩིས་བླངས་པ་ལྟར་ཡར་ལངས་ཏེ་ཐོན།"]},{"type":"verse","number":16,"content":["དེ་རྣམས་ཀྱིས་རང་རང་གི་འགྲན་ཟླའི་མགོ་བོར་འཇུས་པ་དང་རལ་གྲི་འགྲན་ཟླའི་རྩིབ་གཞོགས་སུ་བཙུགས་པས། དེ་དག་ལྷན་ཅིག་ས་རུ་འགྱེལ་ཏོ། །དེའི་ཕྱིར་གིབ་ཡོན་གྱི་ས་ཆ་དེ་ལ་ཧེལ་ཀད་ཧ་ཙུ་རིམ་",{"noteId":2},"ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":17,"content":["དེའི་ཉིན་མོར་དམག་འཁྲུག་ཆེན་པོ་བརྒྱབ་པ་དང་ཨབ་ནེར་དང་ཡེས་ར་ཨེལ་པ་རྣམས་དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ཀྱི་མདུན་དུ་ཕམ་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་དང་ཨ་བི་ཤཱ་ཨི་དང་ཨ་སཱ་ཧེལ་གསུམ་དེ་རུ་ཡོད་དེ། ཨ་སཱ་ཧེལ་ནི་རི་དྭགས་དགོ་བ་ལྟར་མྱུར་བའོ། །"]},{"type":"verse","number":19,"content":["ཨ་སཱ་ཧེལ་གྱིས་གཡས་གཡོན་གང་ལའང་མ་གཟུར་བར་ཨབ་ནེར་བདས་ཤིང་།"]},{"type":"verse","number":20,"content":["ཨབ་ནེར་གྱིས་ཕྱི་མིག་བལྟས་པ་དང་། ཁྱོད་ཨ་སཱ་ཧེལ་ཡིན་ནམ་དྲིས་པར། དེས་ནི་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":21,"content":["ཡང་ཨབ་ནེར་གྱིས་དེ་ལ། ཁྱོད་རང་གཡས་གཡོན་གང་རུང་དུ་འཁོར་ནས་གཞོན་ནུ་ནང་གི་གཅིག་བཟུང་སྟེ། དེའི་མཚོན་ཆ་ཕྲོགས་ནས་ཁྱེར་ཞིག་ཅེས་སྨྲས་ཀྱང་། ཨ་སཱ་ཧེལ་ཁོའི་རྗེས་སུ་དེད་ནས་མ་བྲལ་ཏོ། །"]},{"type":"verse","number":22,"content":["ཨབ་ནེར་གྱིས་སླར་ཡང་ཨ་སཱ་ཧེལ་ལ། ཁྱོད་ཀྱིས་ངའི་རྗེས་མ་འདེད་ཅིག ངས་ཁྱོད་རང་ཅིའི་ཕྱིར་ས་རུ་བརྡབ་དགོས་སམ། ངས་དེ་ལྟར་བྱས་ཚེ་ཁྱོད་ཀྱི་ཕུ་བོ་ཡོ་ཨབ་ཀྱི་གདོང་ལ་ཅི་ལྟར་བལྟའམ་ཞེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":23,"content":["ཁོ་རང་ཁ་མ་བྲལ་བས་ཨབ་ནེར་གྱིས་མདུང་གི་རྩེ་མོ་",{"noteId":3},"དེའི་ཕོ་བར་བཙུགས་པས། མདུང་རྒྱབ་ནས་ཐོན་ཏེ་ཨ་སཱ་ཧེལ་སར་འགྱེལ་ཞིང་གནས་དེ་རུ་ཤིའོ། །ཨ་སཱ་ཧེལ་ཤི་བའི་གནས་སུ་སླེབས་པའི་མི་ཐམས་ཅད་དེར་ལངས་ནས་བསྡད།"]},{"type":"verse","number":24,"content":["ཡང་ཡོ་ཨབ་དང་ཨ་བི་ཤཱ་ཨི་གཉིས་ཀྱིས་ཨབ་ནེར་བདས་ཤིང་། གིབ་ཡོན་ཐང་སྟོང་དུ་འགྲོ་བའི་ལམ་དང་། གི་ཨ་ཞེས་པའི་ཁ་གཏད་དུ་ཡོད་པའི་ཨམ་མཱ་རི་བོར་སླེབས་པ་ཙམ་གྱིས་ཉི་མ་ནུབ་པ་རེད།"]},{"type":"verse","number":25,"content":["དེར་པེན་ཡཱ་མེན་པ་རྣམས་ཨབ་ནེར་གྱི་རྗེས་སུ་ཕྱོགས་གཅིག་ཏུ་འཛོམས་ནས་དཔུང་གཅིག་ཏུ་བསྒྲིགས་ཏེ་རི་མགོ་ཞིག་ཏུ་ལངས་བསྡད་དོ། །"]},{"type":"verse","number":26,"content":["ཡང་ཨབ་ནེར་གྱིས་ཡོ་ཨབ་ལ། རལ་གྲིས་མཚམས་མེད་པར་མི་གསོད་དགོས་སམ། དེའི་མཐའ་མ་ནི་སྡུག་བསྔལ་ཡིན་པ་མི་ཤེས་སམ། ཁྱོད་ཀྱིས་མི་རྣམས་ལ་རང་རང་གི་སྤུན་འདེད་པ་ལས་ཕྱིར་ལོག་པའི་བཀའ་དུས་ནམ་ཞིག་ལ་སྩོལ་ལམ་ཞེས་དྲིས་པར།"]},{"type":"verse","number":27,"content":["ཡོ་ཨབ་ཀྱིས། ངས་གཏན་དུ་བཞུགས་པའི་དཀོན་མཆོག་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཏེ། ཁྱོད་ཀྱིས་རྩལ་འགྲན་པའི་གཏམ་སྨྲས་པ་མིན་ན་མི་རྣམས་ནངས་སྔ་མོ་ནས་ཕྱིར་ལོག་ཚར་ཞིང་། རང་གི་སྤུན་འདེད་པ་སྤང་བའོ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":28,"content":["དེ་ནས་ཡོ་ཨབ་ཀྱིས་རྭ་དུང་བུས་པ་དང་མི་རྣམས་ལངས་བསྡད་ཅིང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྗེས་སུ་མ་དེད་པ་དང་དམག་ཀྱང་མ་བརྒྱབ་ཏོ། །"]},{"type":"verse","number":29,"content":["ཡང་ཨབ་ནེར་དང་དེའི་མི་རྣམས་མཚན་གང་པོར་ཨ་ར་པཱ་བརྒྱུད་དེ་ཕྱིན་པ་དང་། ཡོར་དན་གཙང་པོ་བརྒལ་ནས་བིད་རོན་ཡུལ་ཐམས་ཅད་བརྒྱུད་ནས་ཆས་ཏེ་མཱ་ཧ་ནཱ་ཡིམ་དུ་སླེབས།"]},{"type":"verse","number":30,"content":["ཡོ་ཨབ་བྱ་བ་ཨབ་ནེར་བདས་ནས་ཕྱིར་ལོག་པ་དང་མི་ཐམས་ཅད་བསྡུས་པའི་སྐབས་སུ། དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ལས་ཨ་སཱ་ཧེལ་ལས་གཞན་ད་དུང་མི་བཅུ་དགུ་མ་ཚང་ངོ་། །"]},{"type":"verse","number":31,"content":["དཱ་བིད་ཀྱི་འཁོར་གཡོག་རྣམས་ཀྱིས་པེན་ཡཱ་མེན་པ་དང་ཨབ་ནེར་གྱི་འཁོར་རྣམས་ལས་མི་སུམ་བརྒྱ་དང་དྲུག་ཅུ་བསད་དོ། །"]},{"type":"verse","number":32,"content":["དེ་ནས་ཁོ་ཚོས་ཨ་སཱ་ཧེལ་གྱི་བེམ་པོ་ཁྱེར་ནས་པེད་ལེ་ཧེམ་དུ་ཡོད་པའི་རང་གི་ཕ་ཡི་དུར་ཁུང་དུ་བཞག་པ་དང་། ཡང་ཡོ་ཨབ་དང་དེའི་འཁོར་རྣམས་མཚན་གང་པོར་འགྲུལ་ཏེ་སྐྱ་རེངས་ཤར་དུས་ཧེབ་རོན་དུ་སླེབས་སོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ཧེལ་ཀད་ཧ་ཙུ་རིམ་ཞེས་པ་ནི་བོད་སྐད་དུ་གྲི་རྣོ་བའི་ཞིང་ཞེས་པའི་དོན་ལ་འཇུག","reference":{"chapter":2,"verse":16}},{"noteId":3,"caller":"+","text":"མདུང་གི་རྩེ་མོ་ཞེས་པར་མདུང་གི་རྔ་མ་ཞེས་ཀྱང་བསྒྱུར་རུང་།","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/bod_ntb/2SA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}