{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":21,"content":[{"type":"heading","content":["སོ་ལོའི་མི་རྣམས་བསད་པ།"]},{"type":"verse","number":1,"content":["དཱ་བིད་རྒྱལ་པོར་བཞུགས་དུས་སུ་ལོ་གསུམ་ལ་མུ་གེ་བྱུང་ཞིང་། དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཐུགས་བརྟག་ཞུས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། སོ་ལོ་དང་ཁོའི་ཁྱིམ་རྒྱུད་ཀྱིས་གིབ་ཡོན་པ་རྣམས་བསད་ནས་ཁྲག་བཞུར་བའི་སྡིག་པ་བསགས་པའི་རྐྱེན་གྱིས་དེ་ལྟར་བྱུང་ངོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་དཱ་བིད་ཀྱིས་གིབ་ཡོན་པ་རྣམས་བོས་ཡོང་སྟེ་ཁོ་རྣམས་ལ་གསུང་མོལ་གནང་། གིབ་ཡོན་པ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱུད་མ་ཡིན་གྱི་ཨེ་མོར་པའི་ལྷག་ལུས་རྣམས་ཡིན་ནོ། །ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་དག་ལ་ཁོ་རྣམས་མི་གསོད་པའི་མནའ་བསྐྱལ་ནའང་། སོ་ལོས་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་དོན་དུ་བརྩོན་སེམས་བསྐྱེད་ནས་དེ་དག་གསོད་དུ་བསྙེགས་པ་རེད།"]},{"type":"verse","number":3,"content":["དཱ་བིད་ཀྱིས་གིབ་ཡོན་པ་རྣམས་ལ་འདི་ལྟར། ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ནོར་སྐལ་ལ་བྱིན་གྱིས་བརླབ་པའི་ཕྱིར་ངས་ཁྱོད་ཅག་ལ་ཅི་བྱེད་དགོས་སམ། སྡིག་བཤགས་སུ་ངས་ཅི་གཏོང་བར་བྱའམ་ཞེས་དྲིས་པར།"]},{"type":"verse","number":4,"content":["གིབ་ཡོན་པས་ཁོང་ལ། ངེད་རྣམས་ནི་སོ་ལོ་དང་དེའི་ཁྱིམ་གྱི་དོན་དང་གསེར་དངུལ་ལ་འབྲེལ་བ་ཅི་ཡང་མེད། ཡང་ང་ཚོའི་རྐྱེན་གྱིས་ཡེས་ར་ཨེལ་པ་གང་རུང་ཞིག་མི་གསོད་པར་མཛོད་ཅེས་ཞུས་པ་དང་། ཁོང་གིས། ཁྱོད་རྣམས་ཀྱིས་ཅི་ལྟར་སྨྲས་ན་བདག་གིས་དེ་བཞིན་བྱ་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":5,"content":["དེ་དག་གིས་རྒྱལ་པོ་ལ། ང་ཚོ་བསད་ནས་རྩ་མེད་དུ་གཏོང་འདོད་མཁན་དང་། ང་ཚོ་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ལ་སྡོད་དུ་མི་འཇུག་མཁན།"]},{"type":"verse","number":6,"content":["མི་དེའི་བུ་རབས་ཚ་རྒྱུད་ལས་མི་བདུན་ང་ཚོར་སྤྲོད་ཅིག་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་སོ་ལོ་བདམས་སའི་ཡུལ་ཏེ་གིབ་ཨ་རུ། ང་ཚོས་དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དཔྱང་བར་བྱའོ་ཞེས་ཞུས་པར། རྒྱལ་པོས། ངས་དེ་བཞིན་གཏོང་བར་བྱ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["ཡང་དཱ་བིད་དང་སོ་ལོའི་བུ་ཡོ་ནཱ་ཐན་གཉིས་ཀྱི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་པའི་མནའ་ཡོད་པས། རྒྱལ་པོས་སོ་ལོའི་ཚ་བོ་དང་ཡོ་ནཱ་ཐན་གྱི་བུ་མེ་ཕི་པོ་ཤེད་གཅེས་སུ་བཟུང་བ་དང་།"]},{"type":"verse","number":8,"content":["ཨ་ཡཱ་ཡི་བུ་མོ་རི་ཚི་ཕཱ་ལས་ཆད་པའི་སོ་ལོའི་བུ་ཨར་མོ་ནི་དང་། མེ་ཕི་པོ་ཤེད་",{"noteId":23},"བྱ་བ་གཉིས་དང་། སོ་ལོའི་བུ་མོ་མི་ཀལ་",{"noteId":24},"དང་མེ་ཧོ་ལད་པ་པཱར་ཟིལ་ལ་ཨི་ཡི་བུ་ཨད་རི་ཨེལ་གཉིས་ལ་སྐྱེས་པའི་བུ་ལྔ་ནི།"]},{"type":"verse","number":9,"content":["གིབ་ཡོན་པ་རྣམས་ཀྱི་ལག་ཏུ་སྤྲད་ནས། དེ་དག་གིས་ཁོ་རྣམས་རི་མགོར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དཔྱངས་ཏེ། མི་བདུན་པོ་དེ་མཉམ་དུ་ཤི་བ་རེད། ཁོ་ཚོ་བསད་པའི་དུས་ནི་བཙས་མ་བརྔ་བའི་ཉིན་ཐོག་མ་རྣམས་ཏེ། ནས་འབྲེག་འགོ་ཚུགས་པའི་དུས་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་ཨ་ཡཱ་ཡི་བུ་མོ་རི་ཚི་ཕཱ་ཡིས་རྩིད་རས་ཁུར་ཏེ་ཕ་བོང་སྟེང་བཏིངས་ནས་སྤྱིལ་བུ་བཟོས་ཤིང་། བཙས་མ་བརྔ་བའི་དུས་ཀྱི་ཐོག་མ་ནས་གནམ་ལས་ཆར་ཆུ་བེམ་པོའི་སྟེང་གཤོ་བའི་བར་དུ། ཉིན་དཀར་ནམ་མཁའི་བྱ་རྣམས་དང་། མཚན་མོར་ཐང་གི་གཅན་གཟན་རྣམས་འབབ་ཏུ་མ་བཅུག་པར་བེམ་པོ་བསྲུངས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་མི་ཞིག་གིས་སོ་ལོའི་ཆུན་མ་ཨ་ཡཱ་ཡི་བུ་མོ་རི་ཚི་ཕཱ་ཡིས་ཅི་བྱས་པ་དེ་དཱ་བིད་ལ་སྨྲས་པས།"]},{"type":"verse","number":12,"content":["དཱ་བིད་སོང་སྟེ་གིལ་ཨད་ཀྱི་ཡཱ་བེ་སི་པ་རྣམས་ནས་སོ་ལོའི་རུས་པ་དང་དེའི་བུ་ཡོ་ནཱ་ཐན་གྱི་རུས་པ་སྤོས་སོ། །སྔར་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་གིལ་བོ་ཨ་རུ་སོ་ལོ་བསད་ནས་བེམ་པོ་ནི་པེད་ཤན་གྱི་ཐང་ཆེན་དུ་དཔྱངས་པ་དང་། ཕྱིས་སུ་གིལ་ཡད་ཀྱི་ཡཱ་པིས་པ་རྣམས་ཀྱིས་བེམ་པོ་བརྐུས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["དཱ་བིད་ཀྱིས་སོ་ལོ་དང་དེའི་བུ་ཡོ་ནཱ་ཐན་གཉིས་ཀྱི་རུས་པ་རྣམས་གནས་དེ་ནས་ཁྱེར་ཅིང་། དེ་དག་གིས་དཔྱངས་པ་རྣམས་ཀྱི་རུས་པ་ཡང་བསྡུས་སོ། །"]},{"type":"verse","number":14,"content":["དེར་ཁོ་རྣམས་ཀྱིས་སོ་ལོ་དང་དེའི་བུ་ཡོ་ནཱ་ཐན་གཉིས་ཀྱི་རུས་པ་རྣམས་པེན་ཡཱ་མེན་གྱི་ས་ཆ་ཙེ་ལཱ་རུ། སོ་ལོའི་ཕ་ཁི་སིའི་དུར་དུ་བསྐུངས་པ་དང་། དེ་རྣམས་ཀྱིས་རྒྱལ་པོས་བཀའ་བསྩལ་པ་ཐམས་ཅད་བསྒྲུབས་པ་དང་། དེ་ནས་དཀོན་མཆོག་གིས་ཡུལ་དེའི་ཞུ་བར་གསན་ཏོ། །"]},{"type":"heading","content":["ཕེ་ལེ་ཤེད་པའི་མི་ཆེན་དང་དམག་བརྒྱབ་པ།"]},{"type":"verse","number":15,"content":["ཕེ་ལེ་ཤེད་པ་དང་ཡེས་ར་ཨེལ་པའི་བར་ལ་དམག་འཁྲུག་བྱུང་། དཱ་བིད་ཀྱིས་རང་གི་འཁོར་གཡོག་རྣམས་ཁྲིད་ནས་མར་སོང་སྟེ་ཕེ་ལེ་ཤེད་པ་དང་འཐབ་ཅིང་ཁོང་ཐང་ཆད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":16,"content":["མི་གཟུགས་རིང་གི་བུ་རྒྱུད་རྣམས་ལས་ཡེ་པི་བེ་ནོབ་བྱ་བ་དེས་དཱ་བིད་གསོད་དགོས་པར་སྨྲ་ཞིང་། དེའི་ལི་ཡི་མདུང་རྩེའི་ལྗིད་ཚད་ལ་སྲང་སུམ་བརྒྱ་ཡོད་ལ། རྐེད་པར་རལ་གྲི་གསར་པ་ཞིག་ཀྱང་བཏགས་ཡོད།"]},{"type":"verse","number":17,"content":["ཟེ་རུ་ཡཱ་ཡི་བུ་ཨ་བི་ཤཱ་ཨིས་ཁོང་ལ་རོགས་བྱས་ཏེ་ཕེ་ལེ་ཤེད་པར་བརྡུངས་ནས་བསད་དོ། །ཉིན་དེར་དཱ་བིད་ཀྱི་མི་རྣམས་ཀྱིས་མནའ་བསྐྱལ་ནས་ཁོང་ལ། ཡེས་ར་ཨེལ་གྱི་རྒྱུད་མི་ཆད་པའི་ཕྱིར་དེང་ཕྱིན་ཆད་ཁྱེད་ང་ཚོ་དང་མཉམ་དུ་འཐབ་མོར་མི་ཞུགས་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["དེའི་རྗེས་སུ་ཡང་གོབ་ཡུལ་དུ་ཕེ་ལེ་ཤེད་པ་རྣམས་དང་འཐབ་མོ་བྱུང་བ་དང་། ཧུ་ཤཱ་པ་སིབ་བེ་ཀཱ་ཨི་བྱ་བ་དེས་མི་གཟུགས་རིང་གི་བུ་རྒྱུད་རྣམས་ལས་སབ་བྱ་བ་དེ་བསད་དོ། །"]},{"type":"verse","number":19,"content":["ཡང་དེ་རྣམས་གོབ་ཡུལ་དུ་སླར་ཡང་ཕེ་ལེ་ཤེད་པ་དང་འཐབ་ཅིང་། པེད་ལེ་ཧེམ་པ་ཡཱ་རེ་ཨོར་གིན་གྱི་བུ་ཨེལ་ཧ་ནན་གྱིས་གཱད་པ་གོལ་ཡད་བྱ་བ་དེ་བསད་པ་དང་། མི་དེའི་མདུང་ནི་འཐག་འཁོར་གྱི་གདུང་མ་ལྟ་བུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེ་ནས་ཡང་ཐེངས་ཤིག་ལ་ཁོ་རྣམས་གཱད་ཡུལ་དུ་འཐབ་ཅིང་། དེ་རུ་མི་ཆེན་ཞིག་ཡོད་ཅིང་དེའི་ལག་པ་དང་རྐང་པ་རེ་རེར་མཛུབ་མོ་དྲུག་རེ་ཡོད་པས་ཁྱོན་སྡོམ་མཛུབ་མོ་ཉེར་བཞི་ཡོད་པ་ཡིན། མི་དེ་ཡང་མི་གཟུགས་རིང་གི་རྒྱུད་ཡིན་ནོ། །"]},{"type":"verse","number":21,"content":["དེས་ནི་ཡེས་ར་ཨེལ་ལ་སྐུར་བ་བཏབ་པའི་ཚེ། དཱ་བིད་ཀྱི་སྐུ་མཆེད་ཤིམ་ཨི་ཡི་བུ་ཡོ་ནཱ་ཐན་གྱིས་ཁོ་བསད་དོ། །"]},{"type":"verse","number":22,"content":["མི་དེ་བཞི་པོ་གཱད་པའི་མི་གཟུགས་རིང་ལས་ཆད་ཅིང་། དཱ་བིད་དང་དེའི་འཁོར་གཡོག་གི་ལག་ནས་ཤིའོ། །"]}],"footnotes":[{"noteId":23,"caller":"+","text":"འདི་ནི་མིང་ལ་མེ་ཕི་པོ་ཤེད་ཅེས་པའི་མི་གཞན་ཞིག་ཡིན།","reference":{"chapter":21,"verse":8}},{"noteId":24,"caller":"+","text":"མི་ཀལ་ཞེས་པར་མ་ཕྱི་ལས་མི་ག་ཞེས་བཀོད་ཡོད།","reference":{"chapter":21,"verse":8}}]},"thisChapterLink":"/api/bod_ntb/2SA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/20.json","previousChapterAudioLinks":{},"numberOfVerses":22}