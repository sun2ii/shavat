{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":23,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱི་མཇུག་གི་གཏམ།"]},{"type":"verse","number":1,"content":["ཡང་འདི་ནི་དཱ་བིད་ཀྱི་གཏམ་ཕྱི་མ་སྟེ། ཡ་ཀོབ་ཁོང་གི་དཀོན་མཆོག་གིས་བྱུགས་ཤིང་། །གོ་གནས་མཐོན་པོར་སྡོད་པར་མཛད་པའི་མི། །ཡེས་ར་ཨེལ་རྣམས་མཉེས་པའི་གླུ་བ་སྟེ། །ཡེ་སེའི་བུ་སྟེ་དཱ་བིད་འདི་ལྟར་གསུངས། །"]},{"type":"verse","number":2,"content":["ཡ་ཝཱེའི་ཐུགས་ཉིད་བདག་བརྒྱུད་གསུང་གླེང་མཛད། །ཁོང་གི་བཀའ་རྣམས་བདག་གི་ངག་ལས་ཐོན། །"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་བཀའ་བྱོན་ཏེ། །ཡེས་ར་ཨེལ་གྱི་བྲག་རྡོས་འདི་སྐད་དུ། །དྲང་གཞག་སྒོ་ནས་བདག་སྐྱོང་བྱེད་པ་དང་། །དཀོན་མཆོག་ཉིད་ལ་འཇིགས་ཤིང་གུས་པའི་ངང་། །རྒྱལ་སྲིད་སྐྱོང་མཁན་དེ་ནི་འདི་འདྲ་སྟེ། །"]},{"type":"verse","number":4,"content":["དེ་ནི་ཞོགས་པའི་སྐྱ་རེངས་ཤར་བ་དང་། །གཡའ་དག་དགུང་གི་ཉི་རྩེ་བརྒྱབ་འདྲ་སྟེ། །ཆར་རྗེས་འོད་ཟེར་སྤྲོས་ནས་རྩྭ་སྔོན་སྐྱེད། །"]},{"type":"verse","number":5,"content":["བདག་ཁྱིམ་དཀོན་མཆོག་དྲུང་དུ་དེ་བཞིན་ཡིན། །ཁོང་གིས་བདག་ལ་གཏན་གྱི་ཞལ་ཆད་མཛད། །དེ་ནི་ཡོངས་སུ་རྫོགས་ཤིང་བརྟན་བརླིང་ཡིན། །བདག་གི་ཐར་པ་དང་ནི་རེ་སྨོན་རྣམས། །ཁོང་གིས་འགྲུབ་པར་མཛད་པ་མ་ཡིན་ནམ། །"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་ཁྲམ་པ་ཐམས་ཅད་ཚེར་མ་བཞིན། །གཡུག་ཅིང་མི་ཡིས་རེག་པར་མི་ནུས་ཏེ། །"]},{"type":"verse","number":7,"content":["རེག་འདོད་མི་ཡིས་ལྕགས་དང་མདུང་བཟུང་སྟེ། །དེ་དག་རང་གི་གནས་སུ་བསྲེག་པར་འགྱུར། །ཞེས་པའོ། །"]},{"type":"heading","content":["དཱ་བིད་ཀྱི་དཔའ་རྒོད་རྣམས།"]},{"type":"verse","number":8,"content":["དཱ་བིད་ཀྱི་དཔའ་རྒོད་རྣམས་ཀྱི་མིང་ནི་འདི་ལྟ་སྟེ། ཐ་ཀེ་མོན་པ་ཡོ་ཤེབ་པ་ཤེ་བེད་བྱ་བ་དེ་ནི་དཔའ་རྒོད་གསུམ་པོའི་འགོ་དཔོན་ཡིན་ནོ། །ཁོའི་མིང་ལ་ཡེས་པ་ཨལ་ནོ་ཞེས་ཀྱང་བྱ་སྟེ། དེས་གཡུལ་འགྱེད་ཐེངས་གཅིག་གི་ཁྲོད་མི་བརྒྱད་བརྒྱ་བསད་པའོ། །"]},{"type":"verse","number":9,"content":["དེའི་འཕྲོར་ཨ་ཧོ་པ་དོ་དོའི་བུ་ཨེ་ལི་ཨ་ཟར་བྱ་བ་ཡིན་ཏེ། དཱ་བིད་ཀྱི་རྗེས་སུ་འབྲངས་པའི་དཔའ་རྒོད་གསུམ་པོ་ནང་གི་གཅིག་ལགས་སོ། །སྔར་ཕེ་ལེ་ཤེད་པ་རྣམས་འཐབ་མོའི་ཕྱིར་འདུས་པ་ལ། དེ་དག་གིས་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་འགོག་རྒོལ་བྱས་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་གྱེན་དུ་འགྲོ་བའི་ཚེ།"]},{"type":"verse","number":10,"content":["མི་དེ་ལངས་ནས་ཐང་ཆད་དེ་ལག་པ་རལ་གྲིར་འབྱར་བའི་བར་དུ་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་བརྒྱབ་སྟེ། ཉིན་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ཕྱོགས་ལས་རྣམ་པར་རྒྱལ་བས། མི་རྣམས་ཨེ་ལི་ཨ་ཟར་གྱི་རྗེས་སུ་འབྲངས་ནས་བཅོམ་ནོར་འཕྲོག་པའི་ལས་ཁོ་ནར་བྲེལ་ཏོ། །"]},{"type":"verse","number":11,"content":["ཡང་དེའི་འཕྲོར་ཧ་རར་པ་ཨ་གེའི་བུ་ཤམ་མཱ་བྱ་བ་ཡིན་ཏེ། ཐེངས་ཤིག་ཕེ་ལེ་ཤེད་པ་རྣམས་ལེ་ཧི་ཞེས་པའི་ཡུལ་དུ་སྲན་དམར་གྱིས་ཁེངས་པའི་ཞིང་ཞིག་ཏུ་འདུས་ཡོད་པ་ལ། འབངས་རྣམས་ཕེ་ལེ་ཤེད་པའི་མདུན་ནས་བྲོས་སོང་བའི་ཚེ།"]},{"type":"verse","number":12,"content":["ཁོ་རང་ཞིང་དེའི་དཀྱིལ་དུ་ལངས་ནས་ཞིང་དེ་བསྲུངས་པ་དང་། ཕེ་ལེ་ཤེད་པ་རྣམས་ཕམ་པར་བརྒྱབ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་རྒྱལ་ཁ་ཆེན་པོ་ཐོབ་པར་མཛད་དོ། །"]},{"type":"verse","number":13,"content":["བཙས་མ་བརྔ་འགོ་ཚུགས་པའི་དུས་སུ། འགོ་དཔོན་སུམ་ཅུ་ལས་འདི་གསུམ་པོ་ཨ་དུལ་ལཱམ་བྲག་ཕུག་ཏུ་དཱ་བིད་ཀྱི་དྲུང་དུ་ཕྱིན་པའི་ཚེ། ཕེ་ལེ་ཤེད་པའི་དམག་དཔུང་གིས་རེ་པཱ་པའི་ལུང་པ་རུ་སྒར་བཏབ་བོ། །"]},{"type":"verse","number":14,"content":["དེའི་དུས་སུ་དཱ་བིད་ནི་བཙན་རྫོང་ནང་དུ་ཡོད་པ་དང་། ཕེ་ལེ་ཤེད་པའི་འགོག་སྲུང་དམག་དཔུང་པེད་ལེ་ཧེམ་དུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":15,"content":["དེར་དཱ་བིད་ཤིན་ཏུ་སྐོམ་ནས་ན་རེ། ཀྱེ་ཧོ། སུ་ཞིག་གིས་པེད་ལེ་ཧེམ་གྱི་མཁར་སྒོའི་འགྲམ་དུ་ཡོད་པའི་ཁྲོན་པ་ལས་ཆུ་ཁུར་འོངས་ནས་ང་ལ་བླུད་ན་ཅི་མ་རུང་ཞེས་པར།"]},{"type":"verse","number":16,"content":["དཔའ་རྒོད་འདི་གསུམ་པོས་ཕེ་ལེ་ཤེད་པའི་དམག་སྒར་བརྒལ་ནས་སོང་སྟེ། པེད་ལེ་ཧེམ་གྱི་མཁར་སྒོའི་འགྲམ་དུ་ཡོད་པའི་ཁྲོན་པ་ལས་ཆུ་བཅུས་ནས་ཁུར་འོངས་ཏེ་དཱ་བིད་ལ་ཕུལ་ནའང་། ཁོང་གིས་དེ་མ་འཐུང་བར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མཆོད་ནས་ན་རེ།"]},{"type":"verse","number":17,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། བདག་གིས་འདི་ལྟ་བུ་གཏན་ནས་མི་བྱེད་དེ། འདི་ནི་མི་དེ་གསུམ་པོས་རང་སྲོག་འབེན་དུ་བཞག་ནས་སོང་བས། འདི་ནི་ཁོ་ཚོའི་ཁྲག་མ་ཡིན་ནམ་ཞེས་ཞུས་ནས། ཁོང་གིས་དེ་ལས་མ་འཐུང་ངོ་། །དཔའ་རྒོད་འདི་གསུམ་པོས་ལས་དེ་ལྟ་བུ་བྱས་སོ། །"]},{"type":"verse","number":18,"content":["ཟེ་རུ་ཡཱ་ཡི་བུ་ཨ་བི་ཤཱ་ཨི་སྟེ་ཡོ་ཨབ་ཀྱི་ནུ་བོ་ནི་དཔའ་རྒོད་གསུམ་པོའི་འགོ་དཔོན་ཡིན་ཞིང་། དེས་ནི་མི་སུམ་བརྒྱ་ལ་མདུང་གིས་བརྒྱབ་ནས་བསད་པས་དཔའ་རྒོད་གསུམ་པོའི་ཁྲོད་དུ་མིང་གྲགས་རྒྱས་སོ། །"]},{"type":"verse","number":19,"content":["ཁོ་ནི་དཔའ་རྒོད་གསུམ་པོ་དེའི་ཁྲོད་དུ་མིང་གྲགས་ཆེས་ཆེ་བ་ཡིན་པས་འགོ་དཔོན་དུ་གྱུར་ན་ཡང་། དཔའ་རྒོད་སྔོན་མ་གསུམ་པོར་མི་དོའོ། །"]},{"type":"verse","number":20,"content":["ཡང་ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡ་བྱ་བ་ནི་ཀབ་ཟེ་ཨེལ་ནས་ཐོན་པའི་དཔའ་རྒོད་ཡིན་ཞིང་། སྔར་དོན་ཆེན་རྣམས་བྱས་མྱོང་སྟེ། དེས་ནི་མོ་ཨབ་པ་ཨ་རི་ཨེལ་གྱི་བུ་གཉིས་བསད་པ་དང་། ཡང་ཁ་བ་འབབ་དུས་དོང་ཞིག་ཏུ་སོང་སྟེ་སེང་གེ་ཞིག་བསད་དོ། །"]},{"type":"verse","number":21,"content":["ཡང་པེ་ནཱ་ཡ་ཡིས་ཨེ་ཅིབ་པ་སྟོབས་ཅན་ཞིག་བསད་པ་དང་། ཨེ་ཅིབ་པ་དེའི་ལག་ཏུ་མདུང་ཡོད་དེ། ཁོས་དབྱུག་པ་བཟུང་ནས་ཨེ་ཅིབ་པ་དེའི་ཕྱོགས་སུ་མར་སོང་སྟེ། དེ་ལག་ནས་མདུང་ཕྲོགས་ཤིང་མདུང་དེས་མི་དེ་བསད་དོ། །"]},{"type":"verse","number":22,"content":["ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡས་ལས་དེ་ལྟ་བུ་བྱས་པས། ཁོ་རང་དཔའ་རྒོད་གསུམ་པོའི་ཁྲོད་དུ་མིང་གྲགས་ཅན་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":23,"content":["ཁོ་ནི་དཔའ་རྒོད་སུམ་ཅུ་ལས་མིང་གྲགས་ཆེ་ནའང་། དཔའ་རྒོད་སྔོན་མ་གསུམ་པོར་མི་དོའོ། །དཱ་བིད་ཀྱིས་དེ་ནི་སྐུ་སྲུང་པ་རྣམས་ཀྱི་འགོ་དཔོན་དུ་བཞག"]},{"type":"verse","number":24,"content":["དཔའ་རྒོད་སུམ་ཅུའི་གྲས་སུ་ཡོ་ཨབ་ཀྱི་ནུ་བོ་ཨ་སཱ་ཧེལ་བྱ་བ་དང་། པེད་ལེ་ཧེམ་པ་དོ་དོ་ཡི་བུ་ཨེལ་ཧ་ནན་དང་།"]},{"type":"verse","number":25,"content":["ཧ་རོད་པ་ཤམ་མཱ་དང་། ཧ་རོད་པ་ཨེ་ལི་ཀཱ་དང་།"]},{"type":"verse","number":26,"content":["ཕེ་ལེད་པ་ཧེ་ལེ་ཙི་དང་། ཐེ་ཀོ་ཨ་པ་ཨིག་ཀེ་སི་ཡི་བུ་ཨི་རཱ་དང་།"]},{"type":"verse","number":27,"content":["ཨ་ན་ཐོད་པ་ཨ་བི་ཨེ་ཟཱེར་དང་། ཧུ་ཤཱ་པ་མེ་བུན་ན་ཨི་དང་།"]},{"type":"verse","number":28,"content":["ཨ་ཧོ་པ་ཙལ་མོན་དང་། ནེ་ཏོ་ཕཱ་པ་མ་ཧ་རཱ་ཨི་དང་།"]},{"type":"verse","number":29,"content":["ནེ་ཏོ་ཕཱ་པ་པ་ཨ་ནཱ་ཡི་བུ་ཧེ་ལེབ་དང་། པེན་ཡཱ་མེན་གྱི་བུ་རབས་ཚ་རྒྱུད་དེ་གིབ་ཨ་པ་རི་བཱ་ཨི་ཡི་བུ་ཨིད་ཏ་ཨི།"]},{"type":"verse","number":30,"content":["ཕི་ར་ཐོན་པ་པེ་ནཱ་ཡ་དང་། གཱ་ཨ་སི་གྲོག་མོའི་ཧིད་དཱ་ཨི་དང་།"]},{"type":"verse","number":31,"content":["ཨ་རཱབ་པ་ཨ་བི་ཨལ་བོན་དང་། བར་ཧུམ་པ་ཨས་མ་ཝེད་དང་།"]},{"type":"verse","number":32,"content":["ཤ་ཨལ་བོན་པ་ཨེལ་ཡ་བཱ་དང་། ཡཱ་ཤེན་གྱི་བུ་རྣམས་ཀྱི་ཁྲོད་ནས་ཡོ་ནཱ་ཐན་དང་།"]},{"type":"verse","number":33,"content":["ཧ་རར་པ་ཤམ་མཱ་དང་། ཧ་རར་པ་ཤཱ་རར་གྱི་བུ་ཨ་ཧི་ཨམ་དང་།"]},{"type":"verse","number":34,"content":["མ་ཨ་ཀཱ་པ་ཨ་ཧས་པ་ཨི་ཡི་བུ་ཨེ་ལི་ཕེ་ལེད་ཤེད་དང་། གེ་ལོ་པ་ཨ་ཧི་ཐོ་ཕེལ་གྱི་བུ་ཨེ་ལི་ཨམ་དང་།"]},{"type":"verse","number":35,"content":["ཀར་མེལ་པ་ཧེ་ཚེ་རོ་དང་། ཨར་པཱ་པ་ཕ་ཨ་རཱ་ཨི་དང་།"]},{"type":"verse","number":36,"content":["ཙོ་བཱ་པ་ནཱ་ཐན་གྱི་བུ་ཡིག་ཨལ་དང་། གཱ་རྡུ་པ་པཱ་ནི་དང་།"]},{"type":"verse","number":37,"content":["ཨམ་མོན་པ་ཙེ་ལེག་དང་། ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་ཀྱི་གོ་མཚོན་འཁུར་མཁན་པེ་ཨེ་རཱོད་པ་ན་ཧ་རཱ་ཨི་དང་།"]},{"type":"verse","number":38,"content":["ཡེད་རཱ་པ་ཨི་རཱ་དང་། ཡེད་རཱ་པ་ག་རེབ་དང་།"]},{"type":"verse","number":39,"content":["ཧེད་པ་ཨུ་རི་ཡཱ་བཅས་བསྡོམས་པས་སུམ་ཅུ་སོ་བདུན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2SA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/22.json","previousChapterAudioLinks":{},"numberOfVerses":39}