{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":24,"content":[{"type":"heading","content":["དཱ་བིད་ཀྱིས་མི་གྲངས་བླངས་པ།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡེས་ར་ཨེལ་གྱི་སྟེང་དུ་ཐུགས་ཁྲོས་པ་དང་། ཁོང་གིས་དཱ་བིད་ཀྱི་སེམས་སུ་དེ་དག་ལ་ཁོང་ཁྲོ་བསྐྱེད་ནས་འདི་སྐད་དུ། སོང་ལ་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་ཡི་མི་གྲངས་ལོངས་ཤིག་ཅེས་སྐུལ་བར་མཛད་དོ། །"]},{"type":"verse","number":2,"content":["དེ་ནས་རྒྱལ་པོས་ཁོང་གི་རྗེས་སུ་འབྲངས་པའི་དམག་དཔོན་ཡོ་ཨབ་ལ། ཁྱོད་རང་དཱན་ནས་པེར་ཤ་བཱ་ཡི་བར་ཡེས་ར་ཨེལ་གྱི་ཚོ་ཁག་ཀུན་ཏུ་སོང་ནས། ངས་མི་གྲངས་ཤེས་པའི་ཕྱིར་འབངས་རྣམས་ཀྱི་གྲངས་ཀ་ལོངས་ཤིག་ཅེས་བཀའ་བསྩལ་པ་ལ།"]},{"type":"verse","number":3,"content":["ཡོ་ཨབ་ཀྱིས་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ད་ལྟ་ཡོད་པའི་འབངས་རྣམས་ལྡབ་བརྒྱ་མང་དུ་མཛོད་ཅིག ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོའི་སྤྱན་གྱིས་དེ་གཟིགས་པར་ཤོག་ཅིག འོན་ཀྱང་ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོས་འདི་ལྟར་མཛད་དགོས་དོན་ཅི་ལགས་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོས་ཡོ་ཨབ་དང་དམག་དཔོན་རྣམས་ལ་བབས་པའི་བཀའ་དེ་མཁྲེགས་འཛིན་བྱས་པས། ཡོ་ཨབ་དང་དམག་དཔོན་རྣམས་རྒྱལ་པོའི་དྲུང་ནས་ཕྱི་རུ་ཐོན་ཏེ་ཡེས་ར་ཨེལ་གྱི་མི་གྲངས་བླངས་པ་རེད།"]},{"type":"verse","number":5,"content":["དེ་དག་ཡོར་དན་གཙང་པོ་བརྒལ་ནས། གཱ་རྡུ་ལུང་པ་རུ་ཡོད་པའི་གྲོང་ཁྱེར་གཡས་ཕྱོགས་ཀྱི་ཨ་རོ་ཨེར་དུ། ཡཱ་ཟེར་གྱི་ཁ་གཏད་དུ་གུར་ཕུབ་བོ། །"]},{"type":"verse","number":6,"content":["ཁོ་རྣམས་གིལ་ཨད་དང་ཐ་ཏིམ་ཧོད་ཤི་ཡུལ་དུ་སླེབས་ཤིང་། ཡང་དཱན་ཡ་ཨན་དུ་ཕྱིན་པ་དང་། ཚི་ཏུན་ཡུལ་དུ་བསྐོར་ནས་སོང་ངོ་། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ཐཱར་བྱ་བའི་བཙན་རྫོང་དང་། ཧེ་བི་པ་དང་ཀ་ན་ཨན་པའི་གྲོང་ཁྱེར་རྣམས་ལ་སླེབས་ནས་ཡང་ཕྱི་རུ་ཐོན་ཞིང་། ཡ་ཧུ་དཱ་ཡི་ལྷོ་ཕྱོགས་ཡུལ་གྱི་པེར་ཤ་བཱ་རུ་སླེབས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་ཡུལ་ཀུན་ཏུ་བརྒྱུད་ནས། ཟླ་བ་དགུ་དང་ཉིན་ཞག་ཉི་ཤུ་འགོར་རྗེས་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་གོ །"]},{"type":"verse","number":9,"content":["དེར་ཡོ་ཨབ་ཀྱིས་རྒྱལ་པོ་ལ་མི་གྲངས་ཀྱི་ཐོ་ཕུལ་ཏེ། ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་རལ་གྲི་ཐོགས་པའི་དཔའ་བོ་འབུམ་བརྒྱད་དང་། ཡ་ཧུ་དཱའི་ཁྲོད་དུ་འབུམ་ལྔ་ཡོད་པའོ། །"]},{"type":"verse","number":10,"content":["མི་གྲངས་བརྩིས་རྗེས། དཱ་བིད་ཀྱི་སེམས་མི་བདེ་བར་གྱུར་ཏེ། དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ། བདག་གིས་ལས་འདི་བྱས་པས་སྡིག་པ་ཤིན་ཏུ་ཆེའོ། །ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། བདག་གིས་ཤིན་ཏུ་གླེན་པའི་དོན་བྱས་པས། ད་ལྟ་ཁྱེད་ཀྱིས་ཞབས་ཕྱི་བདག་གི་ཉེས་པ་བསལ་བར་མཛོད་ཅེས་གསོལ་ཏོ། །"]},{"type":"verse","number":11,"content":["དཱ་བིད་ཞོགས་པ་ཡར་ལངས་པའི་དུས་སུ། དཱ་བིད་ཀྱི་མངོན་ཤེས་པ་གཱ་རྡུ་བྱ་བའི་ལུང་སྟོན་པ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བྱུང་སྟེ་འདི་སྐད་དུ།"]},{"type":"verse","number":12,"content":["སོང་ནས་དཱ་བིད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཁྱོད་ཀྱི་མདུན་དུ་གདམ་གསེས་གསུམ་འཇོག་སྟེ། དེའི་ནང་ནས་གཅིག་འདེམས་ཤིག་དང་ངས་ཁྱོད་ལ་དེ་བཞིན་བྱའོ་ཞེས་སྦྲོན་ཞིག་གསུངས་པ་དང་།"]},{"type":"verse","number":13,"content":["གཱ་རྡུ་ནི་དཱ་བིད་ཀྱི་དྲུང་དུ་འོངས་ནས་སྦྲན་ཅིང་དེ་ལ། ཁྱོད་ཀྱིས་ལོ་བདུན་གྱི་རིང་རྒྱལ་ཁབ་ཏུ་མུ་གེ་འབྱུང་བར་འདོད་དམ། ཡང་ན་ཟླ་བ་གསུམ་ཀྱི་རིང་དགྲ་བོས་ཁྱོད་འདེད་དགོས་སམ། ཡང་ན་ཁྱོད་ཀྱི་རྒྱལ་ཁབ་ཏུ་ཉིན་གསུམ་ལ་རིམས་ནད་འབྱུང་བར་འདོད་དམ། ད་ནི་བདག་མངག་མཁན་ལ་གཏམ་ལན་ཅི་འཁྱེར་དགོས་པར་བསམ་བློ་ཐོངས་ཤིག་ཅེས་དྲིས་པ་དང་།"]},{"type":"verse","number":14,"content":["དཱ་བིད་ཀྱིས་གཱ་རྡུ་ལ། བདག་ནི་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཐུགས་རྗེ་འཛད་མཐའ་མེད་པ་མངའ་བས་ན། མིའི་ལག་པར་ལྷུང་བ་ལས་ཁོང་གི་ཕྱག་ཏུ་ལྷུང་བ་ལེགས་སོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་རིམས་ནད་ཕབ་ཅིང་། ཞོགས་པ་ནས་ཐུགས་ཐག་བཅད་པའི་དུས་ཀྱི་བར་དུ། དཱན་ནས་པེར་ཤ་བཱ་ཡི་བར་དུ་འབངས་རྣམས་ལས་མི་ཁྲི་བདུན་ཚེ་ལས་འདས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་ཕོ་ཉ་དེས་ཡེ་རུ་སཱ་ལེམ་འཇོམས་པར་ཕྱག་བརྐྱངས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་བར་ཆད་དེའི་ཕྱིར་ཐུགས་འགྱོད་ཅིང་། མི་སྡེ་གསོད་པའི་ཕོ་ཉ་དེ་ལ། ད་ནི་ཆོག་གོ །མཚམས་ཞོག་ཅིག་ཅེས་བཀའ་བསྩལ་ཏོ། །དེའི་ཚེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་དེ་ནི་ཡེ་བུ་སི་པ་ཨ་རབ་ནཱ་ཡི་གཡུལ་ཁར་ཡོད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["དཱ་བིད་ཀྱིས་འབངས་མི་རྣམས་གསོད་པའི་ཕོ་ཉ་དེ་མཇལ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་བ་ཕུལ་ཞིང་འདི་ལྟར། གཟིགས་དང་། སྡིག་པ་ནི་བདག་གིས་བྱས་ཏེ། ལས་ངན་པ་བདག་གིས་བྱས་པ་ཡིན། ལུག་ཁྱུ་འདིས་ཅི་བྱས་སམ། བདག་དང་བདག་གི་ཕ་གཞིས་སྟེང་དུ་ཕྱག་འདེགས་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["ཉིན་དེར་གཱ་རྡུ་ནི་དཱ་བིད་ཀྱི་དྲུང་དུ་འོངས་ནས་དེ་ལ། ཡར་ཕེབས་ནས་ཡེ་བུ་སི་པ་ཨ་རབ་ནཱ་ཡི་གཡུལ་ཁ་རུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བཞེངས་པར་གྱིས་ཞེས་བསྐུལ་བ་ལ།"]},{"type":"verse","number":19,"content":["དཱ་བིད་ཀྱིས་གཱ་རྡུ་ཡིས་བསྒོས་པ་བཞིན་དུ་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་ཡར་ཕྱིན་ཏོ། །"]},{"type":"verse","number":20,"content":["དེར་ཨ་རབ་ནཱ་ཡིས་བལྟས་པ་ལ་རྒྱལ་པོ་འཁོར་དང་བཅས་པ་རང་གི་ཕྱོགས་སུ་འོང་བཞིན་པ་མཐོང་བས། ཨ་རབ་ནཱ་ཕྱི་རུ་ཐོན་ཏེ་ལུས་པོ་སར་བཏུད་ནས་རྒྱལ་པོར་ཕྱག་བཙལ་ཏོ། །"]},{"type":"verse","number":21,"content":["ཨ་རབ་ནཱས། ང་ཡི་ཇོ་བོ་དང་ང་ཡི་རྒྱལ་པོ་སྐུ་ཉིད་ཞབས་ཕྱིའི་རྩར་བྱོན་པ་ཅི་ཡིན་ལགས་ཞེས་ཞུས་པས། དཱ་བིད་ཀྱིས། འབངས་རྣམས་ཀྱི་ཁྲོད་དུ་རིམས་ནད་ཆད་པའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བཞེང་བར་ཁྱོད་ཀྱི་གཡུལ་ཁ་ཉོ་རུ་འོངས་པ་ཡིན་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":22,"content":["ཨ་རབ་ནཱས་དཱ་བིད་ལ། བདག་གི་ཇོ་བོ་དང་བདག་གི་རྒྱལ་པོ་ལགས། ཁྱེད་ཀྱི་སྤྱན་སྔར་གང་ལེགས་པ་དེ་བླངས་ནས་མཆོད་པར་ཕུལ་ཞིག གཟིགས་དང་། འདིར་སྦྱིན་སྲེག་གི་དོན་དུ་བ་གླང་དང་། བུད་ཤིང་ལ་གཡུལ་ཁ་གཅོག་བྱེད་ཡོ་ཆས་དང་བ་གླང་གི་གཉའ་ཤིང་ཡོད།"]},{"type":"verse","number":23,"content":["ཀྱེ་རྒྱལ་པོ་ལགས། ཨ་རབ་ནཱས་དེ་ཐམས་ཅད་རྒྱལ་པོ་ལ་འབུལ་བ་ཡིན་ཞེས་ཞུས་པ་དང་། ཡང་ཁོ་ན་རེ། ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱེད་ལ་ཐུགས་མཉེས་པར་ཤོག་ཅེས་རྒྱལ་པོར་ཞུས་སོ། །"]},{"type":"verse","number":24,"content":["རྒྱལ་པོས་ཨ་རབ་ནཱ་ལ། དེ་ལྟར་མིན། དེ་ཐམས་ཅད་ཁྱོད་ལས་རིན་གྱིས་ཉོ་བར་ང་རང་དགའོ། །ངས་རིན་མེད་པར་ཐོབ་པ་དེ་བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་ཏུ་འབུལ་མི་རུང་ཞེས་གསུངས་ནས། དཱ་བིད་ཀྱིས་གཡུལ་ཁ་དེ་དང་བ་གླང་རྣམས་དངུལ་སྲང་ལྔ་བཅུས་ཉོས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བཞེངས་ནས་སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་རྣམས་ཕུལ་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་དེའི་ཞུ་བར་གསན་ཞིང་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་ནས་རིམས་ནད་ཆད་པར་གྱུར་ཏོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2SA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1KI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}