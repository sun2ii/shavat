{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":5,"content":[{"type":"heading","content":["དཱ་བིད་བྱ་བ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པ།"]},{"type":"verse","number":1,"content":["ཡང་དེ་ནས་ཡེས་ར་ཨེལ་པའི་ཚོ་ཁག་ཐམས་ཅད་ཧེབ་རོན་དུ་དཱ་བིད་ཀྱི་དྲུང་དུ་འོངས་ནས་ཁོང་ལ། གཟིགས་དང་བདག་ཅག་ནི་ཁྱེད་ཀྱི་ཤ་དང་རུས་པའི་གཉེན་ཉེ་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["སྔར་སོ་ལོ་བདག་ཅག་གི་རྒྱལ་པོར་བཞུགས་པའི་ཚེ། ཁྱེད་ནི་ཡེས་ར་ཨེལ་པའི་དམག་དཔུང་གི་འགྲོ་འོང་ལ་སྣེ་ཁྲིད་བྱེད་མཁན་ཡིན། དཀོན་མཆོག་ཡ་ཝཱེས་ཀྱང་ཁྱེད་ལ། ཁྱོད་ཀྱིས་བདག་གི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་བདག་སྐྱོང་བྱས་ནས་དེའི་འགོ་དཔོན་དུ་གྱུར་ཅིག་ཅེས་གསུངས་མྱོང་ངོ་ཞེས་ཞུས།"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ཧེབ་རོན་དུ་རྒྱལ་པོའི་དྲུང་དུ་འོངས་པ་དང་། རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ཧེབ་རོན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དེ་དག་དང་ཆད་དོན་མཛད་ཅིང་། དེ་དག་གིས་དཱ་བིད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོ་ཆེད་སྣུམ་གྱིས་བྱུགས།"]},{"type":"verse","number":4,"content":["དཱ་བིད་ཀྱིས་རྒྱལ་སྲིད་འཛིན་པའི་ཚེ་ལོ་སུམ་ཅུ་ལོན་ཞིང་ཁོང་གིས་ལོ་བཞི་བཅུའི་རིང་དུ་རྒྱལ་སྲིད་བསྐྱངས།"]},{"type":"verse","number":5,"content":["ཁོང་གིས་ཧེབ་རོན་དུ་ཡ་ཧུ་དཱ་ལ་ལོ་བདུན་དང་ཟླ་བ་དྲུག་དང་། ཡང་ཡེ་རུ་སཱ་ལེམ་དུ་ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་གཉིས་ལ་ལོ་སུམ་ཅུ་སོ་གསུམ་གྱི་རིང་རྒྱལ་སྲིད་བསྐྱངས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་རྒྱལ་པོ་དང་ཁོང་གི་རྗེས་འབྲང་པ་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་ཤིང་། ཡུལ་དེར་གནས་པའི་ཡེ་བུ་སི་པ་རྣམས་ལ་རྒོལ་བར་བསམས་པ་ལ། ཡེ་བུ་སི་པ་རྣམས་ཀྱིས་དཱ་བིད་ལ། ལོང་བ་དང་ཞ་བོ་འདི་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་བཟློག་པར་བྱེད་པས་ཁྱོད་གྲོང་ཁྱེར་འདིའི་ནང་དུ་འོང་མི་ནུས་སོ་ཞེས་སྨྲས་ཤིང་། དེ་དག་གི་སེམས་སུ་དཱ་བིད་ཅི་ནས་ཀྱང་དེར་འོང་མི་ནུས་བསམས་ནའང་།"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱིས་ཛ་ཡན་གྱི་བཙན་རྫོང་སྟེ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་བླངས་པའོ། །"]},{"type":"verse","number":8,"content":["དེའི་ཉིན་དཱ་བིད་ཀྱིས། ཡེ་བུ་སི་པ་རྣམས་ལ་རྒོལ་མཁན་དག་གིས། ཡུར་བ་ནས་ཡར་སོང་སྟེ་དཱ་བིད་སེམས་ནས་སྡང་བའི་ལོང་བ་དང་ཞ་བོ་རྣམས་ལ་རྒོལ་ཞིག་ཅེས་བཀའ་བསྩལ་པས། ལོང་བ་དང་ཞ་བོ་རྣམས་ཕོ་བྲང་ནང་དུ་འོང་མི་རུང་ཞེས་པའི་ངག་རྒྱུན་བྱུང་བའོ། །"]},{"type":"verse","number":9,"content":["ཕྱིས་སུ་དཱ་བིད་ནི་བཙན་རྫོང་དེའི་ནང་དུ་བཞུགས་ཤིང་དེའི་མིང་ལ་དཱ་བིད་ཀྱི་གྲོང་ཁྱེར་ཞེས་བཏགས་པ་དང་། ཡང་དཱ་བིད་ཀྱིས་འཛིངས་རགས་ནས་ནང་རོལ་དུ་གྱང་བརྩིགས་པ་རེད།"]},{"type":"verse","number":10,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཱ་བིད་དང་མཉམ་དུ་བཞུགས་པས་དཱ་བིད་ཉིན་རེ་བཞིན་དར་ཞིང་རྒྱས་པར་གྱུར།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཐཱར་གྱི་རྒྱལ་པོ་ཧི་རཱམ་གྱིས་དཱ་བིད་ཀྱི་དྲུང་དུ་བང་ཆེན་མངགས་པ་དང་། ཡང་ཐང་ཤིང་དང་ཤིང་བཟོ་དང་རྡོ་བཟོ་རྣམས་བརྫངས་ཤིང་དེ་དག་གིས་དཱ་བིད་ལ་ཕོ་བྲང་བཞེངས།"]},{"type":"verse","number":12,"content":["དེར་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཉིད་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བསྐོས་པ་དང་། ཡང་ཁོང་གི་འབངས་མི་ཡེས་ར་ཨེལ་གྱི་དོན་དུ་ཁོའི་རྒྱལ་སྲིད་དར་བར་མཛད་པ་རྟོགས་སོ། །"]},{"type":"verse","number":13,"content":["དཱ་བིད་ཁོང་ཉིད་ཧེབ་རོན་ནས་ཐོན་རྗེས་ཡེ་རུ་སཱ་ལེམ་དུ་ཆུན་མ་དང་བཙུན་མོ་མང་པོ་བཞེས་ཤིང་། སྲས་དང་སྲས་མོའང་ཤིན་ཏུ་མང་པོ་བལྟམས་སོ། །"]},{"type":"verse","number":14,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་བལྟམས་པ་རྣམས་ཀྱི་མིང་ནི་འདི་ལྟ་སྟེ། ཤམ་མུ་ཨ་དང་ཤོ་བབ། ནཱ་ཐན། སོ་ལོ་མོན།"]},{"type":"verse","number":15,"content":["ཡིབ་ཧར། ཨེ་ལི་ཤུ་ཨ། ནེ་ཕེག ཡཱ་ཕི་ཨ།"]},{"type":"verse","number":16,"content":["ཨེ་ལི་ཤཱ་མ། ཨེལ་ཡཱ་ད། ཨེ་ལི་ཕེ་ལེད་བཅས་སོ། །"]},{"type":"heading","content":["ཕེ་ལེ་ཤེད་པ་རྣམས་ལས་རྒྱལ་བ།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་དཱ་བིད་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་བྱུགས་པའི་གཏམ་ཐོས་པས། ཐམས་ཅད་དཱ་བིད་འཚོལ་དུ་ཡར་ཕྱིན་པ་དང་། དཱ་བིད་ཀྱིས་དེ་ཐོས་པ་ཙམ་གྱིས་མར་བཙན་རྫོང་དུ་བབས་སོ། །"]},{"type":"verse","number":18,"content":["ཕེ་ལེ་ཤེད་པ་རྣམས་འོངས་ནས་རེ་པཱ་པའི་ལུང་པར་ཁྱབ།"]},{"type":"verse","number":19,"content":["དེར་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ། བདག་ཡར་སོང་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་རྒོལ་བར་བྱའམ། ཁྱེད་ཀྱིས་དེ་དག་བདག་གི་ལག་ཏུ་གཏོད་པར་མཛད་དམ་ཞུས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་དཱ་བིད་ལ་འདི་སྐད་དུ། ཡར་སོང་ཞིག་དང་ངས་ཕེ་ལེ་ཤེད་པ་རྣམས་ཁྱོད་ཀྱི་ལག་ཏུ་གཏོད་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་དཱ་བིད་ནི་པཱ་ཨལ་ཕེ་ར་ཙིམ་དུ་འོངས་པ་དང་། ཁོས་ཕེ་ལེ་ཤེད་པ་རྣམས་དེ་རུ་འཇོམས་པར་བྱས་ཏེ་འདི་ལྟར། ཆུས་རགས་བརྟོལ་བ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེས་དགྲ་བོ་རྣམས་ངའི་མདུན་དུ་བརྟོལ་བ་ཡིན་ཞེས་སྨྲས་ཤིང་། ཁོང་གིས་ཡུལ་དེའི་མིང་ལ་པཱ་ཨལ་ཕེ་ར་ཙིམ་ཞེས་བཏགས།"]},{"type":"verse","number":21,"content":["ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་རང་གི་སྐུ་འདྲ་རྣམས་དེ་རུ་བསྐྱུར་ཅིང་། དཱ་བིད་དང་ཁོའི་ཞབས་འབྲང་རྣམས་ཀྱིས་དེ་དག་བླངས་ནས་ཁྱེར་ཏོ། །"]},{"type":"verse","number":22,"content":["ཕེ་ལེ་ཤེད་པ་རྣམས་སླར་ཡང་ཡར་འོངས་པ་དང་རེ་པཱ་པའི་ལུང་པར་ཁྱབ།"]},{"type":"verse","number":23,"content":["དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེར་ཞུས་པ་ན། ཁོང་གིས་ཁྱོད་ཐད་ཀར་ཡར་མི་འགྲོ་བར། དེ་དག་རྒྱབ་ནས་བསྐོར་ཏེ་སྤོས་ཤིང་གི་ནགས་ཚལ་གྱི་ཁ་གཏད་ནས་དེ་དག་ལ་རྒོལ་ཞིག"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་སྤོས་ཤིང་གི་རྩེ་ནས་དཔུང་ཚོགས་ཀྱི་གོམ་སྒྲ་ཐོས་པ་ཙམ་གྱིས་ཡར་ལོངས་ཤིག གང་ལ་ཞེ་ན། དུས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་ཀྱི་སྔོན་དུ་གཤེགས་ཏེ། ཕེ་ལེ་ཤེད་པའི་དམག་ཚོགས་ལ་རྒོལ་བ་ཡིན་ནོ་ཞེས་གསུངས།"]},{"type":"verse","number":25,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་བསྩལ་པ་ཇི་བཞིན་བསྒྲུབས་པ་དང་ཕེ་ལེ་ཤེད་པ་རྣམས་གེ་བཱ་ནས་གེ་ཟེར་བར་དུ་བཅོམ་མོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2SA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}