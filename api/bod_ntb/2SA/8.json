{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2SA","translationId":"bod_ntb","name":"སཱ་མུ་ཨེལ་གཉིས་པ།","commonName":"སཱ་མུ་ཨེལ་གཉིས་པ།","title":"༄༅། །སཱ་མུ་ཨེལ་གྱི་མདོ་གཉིས་པ།","order":10,"numberOfChapters":24,"sha256":"7e8c0501aa5d6522faa2b3f5d696e4fd7c2d0e242d0ab1b0366bfbbea2b99bcd","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":8,"content":[{"type":"heading","content":["ཡ་ཝཱེས་དཱ་བིད་དགྲ་ལས་རྒྱལ་བར་མཛད་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་དཱ་བིད་ཀྱིས་ཕེ་ལེ་ཤེད་པ་རྣམས་ལ་འཐབ་ནས་བཏུལ་ཞིང་། ཡང་ཁོང་གིས་མེ་ཐེག་ཨམ་མཱ་ཞེས་བྱ་བའི་གྲོང་ཁྱེར་ཕེ་ལེ་ཤེད་པའི་ལག་ནས་བླངས་ཏེ་དབང་དུ་བཅུག"]},{"type":"verse","number":2,"content":["ཡང་མོ་ཨབ་པ་རྣམས་ཕམ་པར་བརྒྱབ་ནས་དེ་རྣམས་ས་རུ་བསྙལ་ཏེ། ཐག་པས་ཚད་ཐིག་བླངས་པ་དང་། ཐག་ཚད་གཉིས་ཡོད་པ་རྣམས་བསད་ཅིང་། ཐག་ཚད་གཅིག་ཡོད་པ་རྣམས་ཚེ་ཐར་དུ་བཏང་། དེ་ནས་མོ་ཨབ་པ་རྣམས་དཱ་བིད་ཀྱི་མངའ་འོག་ཏུ་གྱུར་ཏེ་འབུལ་བ་རྣམས་དྲངས་སོ། །"]},{"type":"verse","number":3,"content":["ཡང་ཙོ་བཱ་ཡི་རྒྱལ་པོ་རེ་ཧོབ་ཀྱི་བུ་ཧ་དད་ཨི་སེར་ཞེས་པ་ཕི་རཱད་གཙང་པོའི་ཕྱོགས་སུ་རང་གི་དབང་ཤུགས་ཕྱིར་ལེན་པར་འགྲོ་བའི་སྐབས་སུ། དཱ་བིད་ཀྱིས་ཁོ་ལ་དམག་བརྒྱབ་པ་དང་།"]},{"type":"verse","number":4,"content":["དཱ་བིད་ཀྱིས་དེ་ལས་སྐྱ་དམག་ཆིག་སྟོང་བདུན་བརྒྱ་དང་རྐང་དམག་ཉིས་ཁྲི་བཟུང་ནས། ཤིང་རྟ་བརྒྱ་འཐེན་པའི་རྟ་མ་གཏོགས་ཤིང་རྟ་འཐེན་པའི་རྟ་ཐམས་ཅད་ཀྱི་སུག་རྒྱུས་བཅད་དོ། །"]},{"type":"verse","number":5,"content":["ཡང་དཱ་མེ་སེག་གི་ཨ་རམ་པ་རྣམས་ཙོ་བཱ་ཡི་རྒྱལ་པོ་ཧ་དད་ཨི་སེར་ལ་རོགས་བྱེད་དུ་འོངས་པ་ལ། དཱ་བིད་ཀྱིས་ཨ་རམ་པའི་མི་ཉིས་ཁྲི་ཉིས་སྟོང་བསད་དོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་དཱ་བིད་ཀྱིས་དཱ་མེ་སེག་གི་ཨ་རམ་ཡུལ་དུ་སྲུང་དམག་བཞག་པ་དང་། ཨ་རམ་པ་རྣམས་དཱ་བིད་ཀྱི་བྲན་དུ་གྱུར་ཏེ་འབུལ་བ་རྣམས་དྲངས་ཤིང་། དཱ་བིད་གང་དུ་སོང་ན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ་རྒྱལ་ཁ་གནང་ངོ་། །"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱིས་ཧ་དད་ཨི་སེར་གྱི་བློན་འཁོར་རྣམས་ལ་ཡོད་པའི་གསེར་གྱི་ཕུབ་ཐམས་ཅད་ཕྲོགས་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་ཁྱེར།"]},{"type":"verse","number":8,"content":["ཡང་ཧ་དད་ཨི་སེར་གྱི་གྲོང་ཁྱེར་པེ་ཏཱ་དང་པེ་རོ་ཐ་ཨི་གཉིས་ནས་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་ལི་དཔག་ཏུ་མེད་པ་ཕྲོགས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཧ་མཱད་ཀྱི་རྒྱལ་པོ་ཏོ་ཨི་བྱ་བས་དཱ་བིད་ཀྱིས་ཧ་དད་ཨི་སེར་གྱི་དམག་དཔུང་ཐམས་ཅད་ཕམ་པར་བརྒྱབ་པའི་གཏམ་ཐོས་པ་ཙམ་གྱིས།"]},{"type":"verse","number":10,"content":["རང་གི་སྲས་ཡོ་རཱམ་",{"noteId":8},"བྱ་བ་དེ་རྒྱལ་པོ་དཱ་བིད་ལ་བདེ་འཚམས་ཞུ་བ་དང་རྟེན་འབྲེལ་ཞུ་བའི་ཆེད་དུ་ཁོང་གི་དྲུང་དུ་མངགས། གང་ལ་ཞེ་ན། ཏོ་ཨི་རྒྱུན་དུ་ཧ་དད་ཨི་སེར་དང་འཐབ་ཅིང་། དཱ་བིད་ཀྱིས་ཧ་དད་ཨི་སེར་ལ་འཐབ་ནས་ཕམ་པར་བརྒྱབ་པས་སོ། །ཡང་ཡོ་རཱམ་གྱི་ལག་ཏུ་དངུལ་གྱི་སྣོད་ཆས་དང་། གསེར་གྱི་སྣོད་ཆས་དང་། ལི་ཡི་སྣོད་ཆས་མང་པོ་ཁྱེར་འོངས་ནས་ཕུལ་ཏོ། །"]},{"type":"verse","number":11,"content":["རྒྱལ་པོ་དཱ་བིད་ཀྱིས་སྣོད་ཆས་དེ་དག་ནི་ཁོང་གིས་བཏུལ་བའི་རྒྱལ་ཁམས་ཐམས་ཅད་ནས་རྙེད་པའི་གསེར་དངུལ་དང་མཉམ་དུ་དམ་པར་བརྩིས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བ་སྟེ།"]},{"type":"verse","number":12,"content":["དེ་ནི་ཨ་རམ་དང་། མོ་ཨབ་དང་། ཨམ་མོན་པ་དང་། ཕེ་ལེ་ཤེད་པ་དང་། ཨ་མཱད་ལེག་པ་དང་། ཙོ་བཱ་ཡི་རྒྱལ་པོ་རེ་ཧོབ་ཀྱི་བུ་ཧ་དད་ཨི་སེར་བཅས་ནས་བླངས་པའི་བཅོམ་ནོར་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["ཡང་དཱ་བིད་ཀྱིས་ཨེ་དོམ་པ་ཆིག་ཁྲི་བརྒྱད་སྟོང་ཚྭའི་ལུང་པར་འགེམས་ནས་ཕྱིར་ལོག་རྗེས་ཁོང་གི་མཚན་སྙན་གྲགས་རྒྱས་པ་རེད།"]},{"type":"verse","number":14,"content":["ཡང་དཱ་བིད་ཀྱིས་ཨེ་དོམ་ཡུལ་དུ་སྲུང་དམག་བཞག་སྟེ། ཨེ་དོམ་ཡུལ་ཀུན་ཏུ་སྲུང་དམག་གིས་ཁྱབ་པས། ཨེ་དོམ་པ་རྣམས་དཱ་བིད་ཀྱི་མངའ་འོག་ཏུ་གྱུར། ཡང་དཱ་བིད་ཡུལ་གང་དུ་སོང་ན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་ལ་རྒྱལ་ཁ་གནང་ངོ་། །"]},{"type":"verse","number":15,"content":["དཱ་བིད་རྒྱལ་པོར་བཞུགས་ནས་ཡེས་ར་ཨེལ་ཐམས་ཅད་ལ་དབང་བསྒྱུར་ཅིང་། མི་ཐམས་ཅད་ལ་འདྲ་མཉམ་དྲང་གཞག་གི་ལྟ་སྟངས་བཟུང་བ་རེད།"]},{"type":"verse","number":16,"content":["དམག་ཚོགས་ཀྱི་འགོ་དཔོན་དུ་ཟེ་རུ་ཡཱ་ཡི་བུ་ཡོ་ཨབ་དང་ལོ་རྒྱུས་འགོད་མཁན་དུ་ཨ་ཧི་ལུད་ཀྱི་བུ་ཡེ་ཧོ་ཤ་ཕད།"]},{"type":"verse","number":17,"content":["མཆོད་དཔོན་དུ་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཟཱ་ཏོག་དང་། ཨབ་ཡཱ་ཐར་གྱི་བུ་ཨ་ཧི་མེ་ལེག་གཉིས་དང་། དྲུང་ཡིག་ཏུ་སེ་རཱ་ཡ་དང་།"]},{"type":"verse","number":18,"content":["ཀེ་རེད་པ་དང་ཕེ་ལེད་པ་རྣམས་ཀྱི་འགོ་དཔོན་དུ་ཡེ་ཧོ་ཡ་དཱ་ཡི་བུ་པེ་ནཱ་ཡ་དང་། དཱ་བིད་ཀྱི་སྲས་རྣམས་བཀའ་བློན་",{"noteId":9},"དུ་བཞག་གོ །"]}],"footnotes":[{"noteId":8,"caller":"+","text":"ཡོ་རཱམ་ཞེས་པར་གནའ་ཡིག་ལ་ལར་ཡེ་ཧོ་རཱམ་ཞེས་བཀོད་འདུག","reference":{"chapter":8,"verse":10}},{"noteId":9,"caller":"+","text":"འདིར་བཀའ་བློན་ཞེས་པར་མ་ཕྱི་ལས་མཆོད་དཔོན་ཞེས་མཐོང་།","reference":{"chapter":8,"verse":18}}]},"thisChapterLink":"/api/bod_ntb/2SA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/2SA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2SA/7.json","previousChapterAudioLinks":{},"numberOfVerses":18}