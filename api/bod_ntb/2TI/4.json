{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"2TI","translationId":"bod_ntb","name":"ཐི་མོ་ཐེ་གཉིས་པ།","commonName":"ཐི་མོ་ཐེ་གཉིས་པ།","title":"༄༅། །ཐི་མོ་ཐེ་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག་གཉིས་པ།","order":55,"numberOfChapters":4,"sha256":"a318eb75cebfe6701f51a925b02f08d45650479011dc1b7a2763e84c33f4e303","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/2TI/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/2TI/4.json","totalNumberOfVerses":83},"chapter":{"number":4,"content":[{"type":"heading","content":["འཕྲིན་བཟང་སྒྲོག་པར་བསྐུལ༌བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་བདག་གིས་དཀོན་མཆོག་དང་མ་འོངས་པར་ཤི་གསོན་གཉིས་ལ་ལེགས་ཉེས་མཛད་མཁན་མཱ་ཤི་ཀ་ཡེ་ཤུའི་སྤྱན་དྲུང༌དུ། ཁོང་ཉིད་མངོན་སུམ་དུ་ཕེབས་ཡོང་བ་དང་ཁོང་གི་རྒྱལ་སྲིད་ལ་བརྟེན་ནས་ཁྱོད་ལ་གདམས་པར་བྱ༌སྟེ།"]},{"type":"verse","number":2,"content":["དུས་དང་དུས་མིན་ཐམས་ཅད་དུ་བསམ་པ་རྩེ་གཅིག་གིས་དཀོན་མཆོག་གི་བཀའ་སྒྲོག་པར་གྱིས། གཞན༌ཡང༌། བཟོད་བསྲན་ཆེན་པོ་དང་སློབ་སྟོན་སྣ་ཚོགས་ཀྱི་ངང་ནས་མི་རྣམས་ལ་བཀའ་བཀྱོན་གནང་བ་དང་། ཁ་ཏ་བྱེད་པ། སྐུལ་སློང་གནང་བ་བཅས་བྱེད་པར་གྱིས།"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཕྱིས་སུ་མི་རྣམས་ཀྱིས་ཡང་དག་པའི་བསྟན་པ་ལ་སུན་སྣང་སྐྱེས་ཤིང་། རྣ་བར་ཟ་འཕྲུག་ལངས་པ་ལྟར་རང་རང་གི་འདོད་པ་བཞིན་དགེ་རྒན་གཞན་དག་བསྡུས༌ཏེ།"]},{"type":"verse","number":4,"content":["རང་གི་རྣ་བ་བཀབ་ནས་བདེན་པ་ཉིད་ལ་མི་མཉན་པར་ཁུངས་ལུང་མེད་པའི་གཏམ་རྒྱུད་ཀྱི་ཕྱོགས་སུ་འཁོར་བར་འགྱུར་བ་ཡིན་ནོ།།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང༌། ཁྱོད་ཀྱིས་དོན་ཀུན་ལ་གཟབ་པ་དང་། དཀའ་ངལ་ལ་བཟོད་པ། འཕྲིན་བཟང་སྒྲོག་མཁན་གྱི་བྱ་བ་སྒྲུབ་པ། རང་གི་ལས་འགན་སྒྲུབ་པ་བཅས་བྱོས༌ཤིག།"]},{"type":"verse","number":6,"content":["བདག་ནི་ཚེ་ལས་འདའ་བའི་དུས་ལ་སླེབས་ཤིང༌། རྒུན་ཆང་གཏོར་ནས་མཆོད་པ་འབུལ་བ་དང་མཚུངས༌པར། ད་ལྟ་ང་རང་ཡང་དེ་ལྟར་ཕུལ་ཟིན་ཏོ།།"]},{"type":"verse","number":7,"content":["བདག་གིས་འཐབ་འཛིང་བཟང་པོ་ནི་བརྒྱབ༌ཟིན། རྒྱུག་དགོས་པའི་ལམ་ཡང་བརྒྱུགས༌ཟིན། དད་པའང་རྟག་ཏུ་བསྲུངས༌པའོ།།"]},{"type":"verse","number":8,"content":["དུས་ད་ནས༌བཟུང༌། བདག་གི་ཆེད་དུ་དྲང་བདེན་གྱི་གཙུག་རྒྱན་བསྐྱུར་ཡོད༌དེ། ཉིན་མོ་དེ་ལ་དྲང་བདེན་ངང་ནས་ཁྲིམས་ཐག་གཅོད་མཁན་གཙོ་བོས་གཙུག་རྒྱན་དེ་ཉིད་བདག་ལ་གནང་བར་མ་ཟད། ཁོང་ཉིད་དངོས་སུ་མངོན་པར་རེ་སྨོན་ཆེན་པོ་བཅངས་པའི་མི་ཐམས་ཅད་ལའང་གནང་བར་འགྱུར༌རོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་རང་དོན་གླེང༌བ།"]},{"type":"verse","number":9,"content":["ཁྱོད་རང་མྱུར་བ་མྱུར་བར་བདག་གི་གམ་དུ་ཡོང་བར༌གྱིས།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཏི་མཱ་འཇིག་རྟེན་འདི་ལ་ཆགས་སྲེད་སྐྱེས་པའི་དབང༌གིས། ང་རང་བསྐྱུར་ནས་ཐེ་སཱ་ལོ་ནེ་ཀེ་རུ་སོང༌ཚར། ཀཱ་རེས་ཀེན་ནི་ག་ལད་ཡཱ་ཡུལ་དང༌། ཐེ་ཏུ་ནི་དཱལ་མད་ཡཱ་ཡུལ་ལ་ཕྱིན་ཏོ།།"]},{"type":"verse","number":11,"content":["ལོ་ཀུ་གཅིག་པུ་བདག་དང་མཉམ་དུ་ཡོད༌ལ། མཱར་ཀུ་ནི་ཞབས་ཕྱི་སྒྲུབ་པའི་ཕྱོགས་ནས་ང་རང་ལ་ཕན་ཐོགས་ཡོད༌པས། ཁྱོད་རང་འདིར་ཡོང་བའི་དུས་སུ་ཁོ་རང་ཡང་འཁྲིད་ཡོང་བར་གྱིས།"]},{"type":"verse","number":12,"content":["བདག་གིས་ཐི་ཀེ་ཀུ་ནི་ཨེ་ཕེ་སི་རུ་མངགས༌པ་ཡིན།"]},{"type":"verse","number":13,"content":["ཁྱོད་རང་འདིར་ཡོང་བའི་དུས༌སུ། བདག་གིས་ཏྲོ་ཡཱ་ནས་ཀར་པུ་ལ་བཅོལ་བའི་ཕྱི་གོས་དེ་འཁྱེར་ཡོང་བར༌ཤོག གཞན༌ཡང༌། དཔེ་ཆ་དང་ལྷག་པར་པགས་ཤོག་དེ་དག་ཀྱང་འཁྱེར་ཡོང་བར་གྱིས།"]},{"type":"verse","number":14,"content":["མགར་པ་ཨ་ལིག་སན་དིར་གྱིས་ང་རང་ལ་གནོད་འཚེ་གང་མང་བྱས་མྱོང༌བས། ཁོས་ཅི་བྱས་པ་བཞིན་དུ་གཙོ་བོས་ཁོ་རང་ལའང་ལན་གནང་བར༌ངེས།"]},{"type":"verse","number":15,"content":["ཁོས་གང་ནུས་ཅི་ཐུབ་ངང་བདག་ཅག་གིས་ཆོས་བཤད་པ་ལ་ངོ་རྒོལ་ཆེན་པོ་བྱས་པས། ཁྱོད་ཀྱིས་ཀྱང་ཁོ་རང་ལ་དོགས་ཟོན་བྱེད་པར༌གྱིས།"]},{"type":"verse","number":16,"content":["བདག་གིས་ཐེངས་དང་པོར་རང་ཉིད་ལ་དག་འབུད་བྱེད་པའི་དུས༌སུ། བདག་ལ་རོགས་རམ་བྱེད་མཁན་གཅིག་ཀྱང་མེད་པར་ཐམས་ཅད་ཀྱིས་ང་རང་སྤངས༌པ་ཡིན། དོན་དེ་ནི་མི་དེ་རྣམས་ལ་ཁག་མི་དཀྲི་བར༌སྨོན།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང༌། གཙོ་བོས་ང་རང་བརྒྱུད་ནས་འཕྲིན་བཟང་སྒྲོག་པའི་དོན་ཡོངས་སུ་བསྒྲུབས་པ་དང་ཕྱི་ཕྱོགས་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་ཐོས་པའི༌ཕྱིར། ཁོང་ཉིད་བདག་གི་འགྲམ་དུ་ཡར་བཞེངས་ཏེ་ང་རང་ལ་སྟོབས་ཤུགས་བསྩལ་པ་དང༌། ང་རང་ཡང་གཅན་གཟན་སེང་གེའི་ཁ་ནས་སྲོག་བསྐྱབས༌པའོ།།"]},{"type":"verse","number":18,"content":["གཙོ་བོས་དོན་ངན་པ་ཐམས་ཅད་ལས་ང་རང་ཐར་བར་མཛད་ངེས༌ཤིང༌། ནམ་མཁའི་རྒྱལ་སྲིད་དུའང་ང་རང་བདེ་བར་འདྲེན་ངེས༌ཡིན། ཁོང་ལ་ཇི་སྲིད་བར་དུ་བསྟོད་བསྔགས་བརྗོད་པར༌སྨོན། ཨ༌མེན།"]},{"type":"heading","content":["མཇུག་མཐའི་འཚམས༌འདྲི།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱིས་ཕུར་སི་ལཱ་དང་ཨ་ཀུ་ལཱ་གཉིས༌དང༌། ཨོ་ནེ་སི་ཕུ་རུའི་ཁྱིམ་མི་རྣམས་ལའང་འཚམས་འདྲི་ཞུ་བར༌གྱིས།"]},{"type":"verse","number":20,"content":["ཨེ་རས་ཏི་ནི་ཀོ་རིན་ཐུ་རུ་བསྡད་པ༌དང༌། ཏྲོ་ཕེ་མུ་ལ་ན་ཚ་བྱུང་བས། ངས་ཁོ་རང་མུ་ལེ་ཐུ་རུ་བསྐྱུར་བ༌ཡིན།"]},{"type":"verse","number":21,"content":["ཁྱོད་རང་དགུན་དུས་མ་སླེབས་སྔོན་དུ་མྱུར་བ་མྱུར་བར་བདག་གི་གམ་དུ་ཡོང་བར༌གྱིས། འདིར་ཨིའུ་པུ་ལུ༌དང༌། པུ༌དེན། ལི༌ནུ། ཀ་ལུ་དི་ཡཱ་བཅས་དང༌། གཞན༌ཡང༌། སྤུན་ཟླ་ཐམས་ཅད་ཀྱིས་ཀྱང་ཁྱོད་ལ་འཚམས་འདྲི༌ཞུའོ།།"]},{"type":"verse","number":22,"content":["གཙོ་བོ་ནི་ཁྱོད་ཀྱི་སེམས་སུ་བཞུགས་པ་དང་། ཐུགས་རྗེ་ནི་རྟག་ཏུ་ཁྱོད་རྣམས་དང་མཉམ་དུ་གནས་པར༌སྨོན།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/2TI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/TIT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/2TI/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}