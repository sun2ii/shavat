{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":11,"content":[{"type":"heading","content":["སྐུ་ཚབ་པ་པེ་ཏྲོས་རང་གི་མཛད་དོན་གསུངས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སྐུ་ཚབ་པ་དང་ཡ་ཧུ་དཱའི་ཡུལ་དུ་ཡོད་པའི་སྤུན་ཟླ་རྣམས་ཀྱིས་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་ཀྱང་དཀོན་མཆོག་གི་བཀའ་དང་དུ་བླངས་པ་ཐོས༌ཤིང༌།"]},{"type":"verse","number":2,"content":["སྐུ་ཚབ་པ་པེ་ཏྲོ་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་པ་དང་མཚན་སྐྱི་བཅད་པའི་དད་ལྡན་འགའ་ཞིག་ན༌རེ།"]},{"type":"verse","number":3,"content":["ཁྱོད་རང་ཕྱི་ཕྱོགས་པའི་ཁྱིམ་དུ་སོང་བ་དང་དེ་དག་དང་མཉམ་དུ་ཁ་ཟས་ལ་རོལ་བ་རེད་ཅེས་རྩོད་པ་བྱས་སོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་པེ་ཏྲོས་དོན་དེ་རིམ་བཞིན་ཁོ་རྣམས་ལ་འགྲེལ་བཤད་བྱས་པ་འདི་ལྟ༌སྟེ།"]},{"type":"verse","number":5,"content":["ངས་ཡོ་ཕཱ་གྲོང་ཁྱེར་ནས་གསོལ་བ་བཏབ་པའི་དུས༌སུ། དྲན་པ་འཆལ་ཞིང་ངོ་མཚར་བའི་ཞལ་གཟིགས་བྱུང་བ་འདི༌ལྟར། སྣེ་བཞི་བསྡམས་པའི་རས་གྲུ་བཞི་ཆེན་པོ་དང་འདྲ་བའི་དངོས་པོ་ཞིག་ནམ་མཁའ་ནས་མར་དཔྱངས་པ་དང་ངའི་མདུན་དུ་བབས་པ་མཐོང༌བྱུང་།"]},{"type":"verse","number":6,"content":["ངས་ཞིབ་ཏུ་བལྟས་པ་ན་དེའི་ནང་དུ་ས་སྟེང་གི་སུག་བཞི་ཅན་གྱི་སྲོག་ཆགས་དང་། གཅན་གཟན། ལྟོ་འགྲོའི༌རིགས། གཞན་ཡང་ནམ་མཁའི་བྱ་རྣམས་ཡོད༌ཅིང༌།"]},{"type":"verse","number":7,"content":["ཡང་སྐད་སྒྲ་ཞིག་གྲགས༌ཏེ། པེ༌ཏྲོ། ཡར་ལོངས་ལ་དེ་དག་བཤས་ནས་ཟོ་ཞིག་ཅེས་བདག་ལ་གསུངས་པ་ཐོས༌བྱུང་ངོ་།།"]},{"type":"verse","number":8,"content":["དེ་ནས་ངས་གཙོ་བོ༌ལགས། དེ་ལྟར་བྱེད་ག་ལ༌རུང༌། ཟས་སུ་མི་རུང་བའམ་མི་གཙང་བ་ཞིག་ངའི་ཁ་ནང་དུ་གཏན་ནས་སོང་མ་མྱོང་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":9,"content":["ཡང་ནམ་མཁའ་ནས་སྐད་སྒྲ་ཞིག་བྱུང༌སྟེ། དཀོན་མཆོག་གིས་གཙང་མར་མཛད་པ་རྣམས་ཁྱོད་ཀྱིས་མི་གཙང་བར་བརྩི་མི་འོས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":10,"content":["དེ་ལྟར་བསྟུད་མར་ཐེངས་གསུམ་ལ་སྐད་སྒྲ་བྱུང་རྗེས་ཐམས་ཅད་ཕྱིར་ནམ་མཁར་དྲངས་སོ།།"]},{"type":"verse","number":11,"content":["དུས་དེ་ཉིད་ལ། ཀེ་སར་ཡཱ་ནས་བདག་གི་གམ་དུ་མངགས་པའི་མི་གསུམ་པོའང་ངེད་ཅག་སྡོད་སའི་ཁང་པའི་སྒོ་མདུན་དུ་སླེབས་ཤིང༌།"]},{"type":"verse","number":12,"content":["དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ང་རང་ལ་ཐེ་ཚོམ་མི་བྱེད་པར་དེ་རྣམས་དང་མཉམ་དུ་འགྲོ་དགོས་པའི་བཀའ་བསྩལ་པ༌དང༌། སྤུན་ཟླ་དྲུག་པོ་འདི་དག་ཀྱང་བདག་དང་མཉམ་དུ་ཀོར་ནེ་ལིའུ་ཡི་ཁྱིམ་དུ་སོང༌ངོ་༎"]},{"type":"verse","number":13,"content":["དེ་ནས་ཁོས་ཕོ་ཉ་ཞིག་རང་གི་ཁང་པའི་ནང་དུ་ཇི་ལྟར་ལངས་བསྡད་ཡོད་པ་མཐོང་བ༌དང༌། ཕོ་ཉས་ཁོ་རང་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ཡོ་ཕཱ་རུ་མི་མངགས་ཏེ་པེ་ཏྲོ་ཞེས་ཀྱང་འབོད་པའི་སི་མོན་གདན་དྲོངས༌ཤིག"]},{"type":"verse","number":14,"content":["ཁོང་གིས་ཁྱོད་དང་ཁྱོད་ཀྱི་ཁྱིམ་མི་ཐམས་ཅད་ཐར་བར་བྱེད་པའི་གཏམ་ཁྱོད་ལ་སྨྲ་བར་འགྱུར་ཞེས་གསུངས་པའི་གཏམ་དེ་ངེད་རྣམས་ལ་སྨྲས།"]},{"type":"verse","number":15,"content":["ངས་དེ་རྣམས་ལ་གཏམ་སྨྲ་བར་བརྩམས་པའི༌ཚེ། དམ་པའི་ཐུགས་ཉིད་ཐོག་མར་ངེད་ཅག་གི་སྟེང་དུ་ཅི་ལྟར་བབས་པ་བཞིན་ཁོ་རྣམས་ཀྱི་སྟེང་དུའང་བབས་སོ།།"]},{"type":"verse","number":16,"content":["དེ་སྔར་གཙོ་བོས་འདི་སྐད༌དུ། ཡོ་ཧ་ནན་གྱིས་ཆུས་ཁྲུས་གསོལ་བྱས༌མོད། འོན་ཀྱང་ཁྱོད་རྣམས་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ཁྲུས་གསོལ་འཐོབ་པར་འགྱུར་ཞེས་གསུངས་པ་བདག་གིས་དྲན་ནོ།།"]},{"type":"verse","number":17,"content":["བདག་ཅག་གིས་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ལ་དད་པ་བྱེད་པའི༌ཚེ། དཀོན་མཆོག་གིས་བདག་ཅག་ལ་ཇི་ལྟར་གནང་སྦྱིན་གནང་བ་བཞིན་དེ་རྣམས་ལའང་གནང་བ་ཡིན༌པས། ངས་དཀོན་མཆོག་ཅི་ལྟར་འགོག་ནུས་སམ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":18,"content":["མི་རྣམས་ཀྱིས་གསུང་དེ་ཐོས་ནས་གཏམ་ཅི་ཡང་མི་སྨྲ༌བར། དཀོན་མཆོག་གིས་ད་ལྟ་ཕྱི་ཕྱོགས་པ་རྣམས་ལའང་མཐའ་མེད་པའི་ཚེ་སྲོག་འཐོབ་པའི༌ཕྱིར། འགྱོད་བཤགས་ཀྱི་སེམས་གནང་བ་རེད་ཅེས་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད༌དོ།།"]},{"type":"heading","content":["ཨན་ཏི་ཡོག་ཡཱ་གྲོང་ཁྱེར་གྱི་ཆོས༌ཚོགས།"]},{"type":"verse","number":19,"content":["དེ་ཡང་སི་ཏེ་ཕཱན་གྱི་དོན་རྐྱེན་གྱི་དབང་གིས་གནོད་འཚེ་མྱངས་ཤིང་ཕྱོགས་བཞིར་ཐོར་བའི་དད་ལྡན་རྣམས་ཕོའོ་ནེ་ཀེ་དང་ཀིབ་རིས། གཞན་ཡང་ཨན་ཏི་ཡོག་ཡཱ་རུ་ཕྱིན༌ནས། གཞན་སུ་ལའང་དཀོན་མཆོག་གི་བཀའ་མ་བསྒྲགས་པར་ཡ་ཧུ་དཱ་པ་ཁོ་ནར་བསྒྲགས་སོ།"]},{"type":"verse","number":20,"content":["འོན༌ཀྱང༌། དེ་དག་གི་ཁྲོད་དུ་ཡོད་པའི་ཀིབ་རིས་དང་ཀི་རེ་ནེ་ཡི་མི་ཁ་ཤས་ཨན་ཏི་ཡོག་ཡཱ་རུ་སླེབས༌ཏེ། གྷི་རིག་པ་རྣམས་ལའང་གཙོ་བོ་ཡེ་ཤུའི་སྐོར་བསྒྲགས་པ༌དང༌།"]},{"type":"verse","number":21,"content":["གཙོ་བོའི་ཕྱག་ནི་མི་དེ་རྣམས་དང་ལྷན་དུ་བཞུགས༌ཤིང༌། མི་ཤིན་ཏུ་མང་པོའང་དད་ཅིང་གཙོ་བོའི་ཕྱོགས་སུ་འཁོར་བར་གྱུར་ཏོ།།"]},{"type":"verse","number":22,"content":["དོན་དེ་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་ཆོས་ཚོགས་ཀྱི་རྣ་བས་ཐོས་ཏེ་པཱར་ན་པཱ་བྱ་བ་ཨན་ཏི་ཡོག་ཡཱ་རུ་མངགས༌པ་དང་།"]},{"type":"verse","number":23,"content":["ཁོ་རང་ཡུལ་དེར་སླེབས་ནས་དཀོན་མཆོག་གིས་མི་རྣམས་ལ་གནང་བའི་ཐུགས་རྗེ་མཐོང་སྟེ་སེམས་དགའ་བར་གྱུར་ནས། མི་རྣམས་ལ་བློ་སེམས་འགྱུར་མེད་ཀྱིས་གཙོ་བོ་ལ་བརྟེན་པར་སྐུལ་མ་གནང་ངོ༌།།"]},{"type":"verse","number":24,"content":["པཱར་ན་པཱ་ནི་རང་གཤིས་བཟང་ཞིང་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱབ་ཡོད་པ་དང་དད་སེམས་ཆེ་བ་ཞིག་ཡིན་པས་མི་མང་པོས་ཀྱང་གཙོ་བོ་ལ་དད་པ་བྱས༌པ་རེད།"]},{"type":"verse","number":25,"content":["དེ་ནས་ཁོ་རང་ཐཱར་ཟི་ཞེས་པར་སོ་ལོ་འཚོལ་དུ་སོང༌ཞིང༌།"]},{"type":"verse","number":26,"content":["ཁོང་བཙལ་ནས་རྙེད་པ་དང་ཨན་ཏི་ཡོག་ཡཱ་རུ་ཁྲིད་ཡོང་ཞིང་། དེ་ནས་ཁོང་གཉིས་ལོ་གཅིག་གི་རིང་ལ་ཆོས་ཚོགས་དང་མཉམ་དུ་འཚོགས་ཏེ་མི་མང་པོར་ཆོས་གསུངས་སོ།། རྗེས་འབྲང་པ་རྣམས་ལ་མཱ་ཤི་ཀ་པ་ཞེས་པའི་མིང་ནི་ཐོག་མར་ཨན་ཏི་ཡོག་ཡཱ་ནས་ཐོགས༌པའོ།།"]},{"type":"verse","number":27,"content":["ཉིན་དེ་དག་གི་རིང༌ལ། ལུང་སྟོན་པ༌ཁ་ཤས་ཡེ་རུ་སཱ་ལེམ་ནས་མར་ཨན་ཏི་ཡོག་ཡཱ་རུ་བྱོན་པ༌དང༌།"]},{"type":"verse","number":28,"content":["དེ་རྣམས་ཀྱི་ཁྲོད་དུ་ཨ་གཱ་པུ་བྱ་བ་ཞིག་ཡོད་པ་དེས་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ནུས་མཐུར་བརྟེན་ནས་ས་གཞི་ཐམས་ཅད་ལ་མུ་གེ་ཆེན་པོ་འབྱུང་ངེས་པའི་ལུང་བསྟན་གནང༌། དོན་དེ་ཀཱ་ལོ་དི་རྒྱལ་པོའི་དུས་སུ་དངོས་གནས་བྱུང་མྱོང༌བ་ཡིན་ནོ།།"]},{"type":"verse","number":29,"content":["དེ་ནས་རྗེས་འབྲང་པ་རྣམས་ཀྱིས་རང་རང་གི་ཅི་ནུས་བཞིན་ཞལ་འདེབས་ཕུལ་ནས་ཡ་ཧུ་དཱའི་ཡུལ་དུ་གནས་པའི་སྤུན་ཟླ་རྣམས་ལ་རོགས་སྐྱོར་བྱེད་རྒྱུ་ཐག་གིས་བཅད༌ཅིང༌།"]},{"type":"verse","number":30,"content":["ཁོ་རྣམས་ཀྱིས་རྒྱུ་ནོམ་པ་ཅི་ཙམ་བསྡུས་པ་ཐམས་ཅད་པཱར་ན་པཱ་དང་སོ་ལོ་གཉིས་ལ་བཅོལ༌ཏེ། ཆོས་ཚོགས་ཀྱི་རྒན་པོ་རྣམས་ལ་སྤྲོད་དུ་བཅུག༌གོ།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ACT/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/10.json","previousChapterAudioLinks":{},"numberOfVerses":30}