{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":18,"content":[{"type":"heading","content":["ཀོ་རིན་ཐུ་གྲོང་ཁྱེར་དུ་ཕེབས༌པ།"]},{"type":"verse","number":1,"content":["དོན་དེའི་རྗེས༌སུ། ཕོལ་ལོལ་བྱ་བ་ཡ་ཏེན་དང་ཁ་བྲལ་ནས་ཀོ་རིན་ཐུ་རུ་ཕྱིན་པ༌ལ།"]},{"type":"verse","number":2,"content":["མིང་ལ་ཨ་ཀུ་ལཱ་ཞེས་པའི་ཡ་ཧུ་དཱ་པ་ཞིག་དང་ཕྲད་ཅིང་ཁོ་ནི་ཕོན་ཐུ་ཡུལ་ནས་སྐྱེས༌ཤིང་། དེ་ཡང་ཀཱ་ལོ་དི་ཞེས་པ་དེས་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་རོ་མཱ་རུ་སྡོད་མི་ཆོག་པའི་བཀའ་ཕབ་པས། ཨ་ཀུ་ལཱ་ཞེས་པས་རང་གི་ཆུང་མ་ཕུར་སི་ལཱ་ཁྲིད་དེ་ཨི་ཏ་ལི་ཡུལ་ནས་ཀོ་རིན་ཐུ་རུ་ཡོང་ངོ༌།། དེ་ནས་ཕོལ་ལོལ་བཟའ་ཟླ་དེ་གཉིས་ཀྱི་གམ་དུ་ཕྱིན་པ་རེད།"]},{"type":"verse","number":3,"content":["ཁྱོ་ཤུག་དེ་གཉིས་གུར་བཟོ་མཁན་ཡིན་ཞིང་ཕོལ་ལོལ་ཡང་དེ་གཉིས་དང་ལས་རིགས་མཚུངས་པས་ན་མཉམ་དུ་བསྡད་ནས་ལས་ཀ་བསྒྲུབས་སོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཕོལ་ལོལ་གྱིས་ངལ་གསོ་བའི་ཉིན་རེ་རེར་ཆོས་ཁང་ནས་ཡ་ཧུ་དཱ་པ་དང་གྷི་རིག་པ་རྣམས་ལ་རྩོད་གླེང་བྱས་ཏེ་སྐུལ་མ་མཛད༌དོ།།"]},{"type":"verse","number":5,"content":["དེ་ནས་སི་ལཱ་དང་ཐི་མོ་ཐེ་གཉིས་མ་ཀེ་དོན་ཡཱ་ཡུལ་ནས་སླེབས་པ༌ལ། ཕོལ་ལོལ་ནི་དཀོན་མཆོག་གི་བཀའ་སྒྲོག་པ་ཁོ་ནར་བྲེལ༌ཞིང༌། ཡ་ཧུ་དཱ་པ་རྣམས་ལ་ཡེ་ཤུ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་པར་བདེན་དཔང་མཛད་ཀྱིན་འདུག"]},{"type":"verse","number":6,"content":["འོན༌ཀྱང༌། མི་དེ་རྣམས་ཀྱིས་ཁོང་ལ་ངོ་རྒོལ་དང་འཕྱ་དམོད་བྱས་པ༌ན། ཕོལ་ལོལ་གྱིས་རང་གི་གྱོན་གོས་སྤྲུགས་ཀྱིན་འདི་སྐད༌དུ། ཁྱོད་ཅག་གི་ཁྲག་རང་རང་གི་མགོ་ལ་འཕོག་པར་གྱུར༌ཅིག བདག་ལ་ཉེས་པ་ཅི་ཡང༌མེད།",{"noteId":17},"དུས་ད་ནས༌བཟུང༌། ང་རང་ཕྱི་ཕྱོགས་པ་རྣམས་ཡོད་སར་འགྲོ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཕོལ་ལོལ་གནས་དེ་དང་ཁ་བྲལ་ནས་མིང་ལ་ཐེ་ཏུ་ཡུས་ཐོ་ཞེས་འབོད་པའི་མི་ཞིག་གི་ཁྱིམ་དུ་སོང་བ༌དང༌། མི་དེ་ནི་དཀོན་མཆོག་ལ་བསྙེན་བཀུར་བྱེད་མཁན་ཞིག་ཡིན༌ཞིང༌། ཁོའི་ཁྱིམ་ཚང་ཡང་ཆོས་ཁང་དེའི་འགྲམ་དུ་ཡོད།"]},{"type":"verse","number":8,"content":["ཡང་ཆོས་ཁང་དེའི་དབུ་འཛིན་པ་ཀཱ་རིས་པི་ཞེས་པ་ཞིག་ཡོད་པ་དེ་དང་ཁོའི་ཁྱིམ་མི་ཐམས་ཅད་གཙོ་བོ་ལ་དད་པར་གྱུར་པ༌དང༌། གཞན༌ཡང༌། ཀོ་རིན་ཐུ་པ་མང་པོས་ཀྱང་ཆོས་ལ་མཉན་ནས་དད་པར་གྱུར་ཅིང་ཁྲུས་གསོལ་ལ་ཞུགས་སོ།།"]},{"type":"verse","number":9,"content":["ཡང་མཚན་མོ་ཞིག༌ལ། ཞལ་གཟིགས་གནང་བ་ལས་གཙོ་བོས་ཕོལ་ལོལ་ལ་འདི་སྐད༌དུ། མ་འཇིགས༌ཤིག ཁ་རོག་ཏུ་མི་འདུག་པར་བདག་གི་བཀའ་མཚམས་མེད་པར་སྒྲོགས༌ཤིག"]},{"type":"verse","number":10,"content":["གྲོང་ཁྱེར་འདི་རུ་བདག་ལ་མི་མང་པོ་ཡོད་ཅིང་ང་རང་ཡང་ཁྱོད་དང་མཉམ་དུ་གནས༌པས། སུ་ཞིག་གིས་ཀྱང་ཁྱོད་ལ་རྒོལ་བ་དང་གནོད་འཚེ་བྱ་མི་ནུས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":11,"content":["ཕོལ་ལོལ་ཡང་ལོ་གཅིག་དང་ཟླ་བ་དྲུག་གི་རིང༌ལ་གནས་དེར་བསྡད་ནས་མི་རྣམས་ལ་དཀོན་མཆོག་གི་བཀའ་བསླབས༌སོ།།"]},{"type":"verse","number":12,"content":["དེ་ཡང་གལ་ལེ་ཨོན་བྱ་བ་ཨ་ཀ་ཡཱ་ཡུལ་གྱི་སྤྱི་དཔོན་ཡིན་པའི་དུས༌སུ། ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་ངན་སེམས་གཅིག་མཐུན་གྱིས་ཕོལ་ལོལ་ལ་ངོ་རྒོལ་བྱས་ནས་ཁྲིམས་དཔོན་གྱི་ཁྲིའི་མདུན་དུ་ཁྲིད་དེ་ན༌རེ།"]},{"type":"verse","number":13,"content":["འདིས་མི་རྣམས་ལ་བཀའ་ཁྲིམས་དང་མི་མཐུན་པའི་སྒོ་ནས་དཀོན་མཆོག་ལ་བསྙེན་བཀུར་བྱེད་པར་བསྐུལ་བ་རེད་ཅེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":14,"content":["ཕོལ་ལོལ་གྱིས་གཏམ་བརྗོད་པར་རྩོམ་པ༌ལ། གལ་ལེ་ཨོན་གྱིས་ཡ་ཧུ་དཱ་པ་དེ་རྣམས་ལ་འདི་ལྟར། ཀྱེ། ཡ་ཧུ་དཱ་པ་ཁྱོད༌རྣམས། གལ་ཏེ་གཏུགས་བཤེར་བྱས་པའི་དོན་འདི་ངན་པའམ་ཡང་ན་ཉེས་སྐྱོན་ཆེ་ཆུང་གང་ཞིག་ཡིན་ན་ཁྱོད་ཅག་གི་ཞུ་བར་ངས་མཉན་སྲིད་མོད།"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་ཁྱོད་ཅག་གི་རྩོད་གཞི་ནི་ཚིག་རྩོད༌དང༌། མིང༌ངམ། ཡང་ན་ཁྱོད་ཅག་གི་ཆོས་ཁྲིམས་བཅས་ཀྱི་སྐོར་ཡིན༌ན། དོན་དེ་ཁྱོད་ཅག་རང་གིས་སྒྲུབས༌ཤིག བདག་གིས་དོན་འདི་ལྟ་བུ་ལ་ཁྲིམས་གཅོད་བྱེད་མི་འདོད་ཅེས་སྨྲས༌ཏེ།"]},{"type":"verse","number":16,"content":["མི་དེ་རྣམས་ཁྲིམས་དཔོན་གྱི་ཁྲིའི་རྩ་ནས་ཕྱི་རོལ་ཏུ་བསྐྲད་དོ།།"]},{"type":"verse","number":17,"content":["དེ་ནས་མི་དེ་རྣམས་ཀྱིས་ཆོས་ཁང་གི་དབུ་འཛིན་པ་སའོ་ཐེ་ནེ་ཞེས་པ་བཙན་བཟུང་བྱས་ཏེ་ཁྲིམས་དཔོན་གྱི་ཁྲིའི་མདུན་དུ་གཅར་རྡུང་བྱས། འོན་ཀྱང་གལ་ལེ་ཨོན་གྱིས་དོན་དེ་རྣམས་ལ་དོ་སྣང་མ་བྱས༌སོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་ཕྱིར་སིར་ཡཱ་ཡུལ་གྱི་ཨན་ཏི་ཡོག་ཡཱ་གྲོང་ཁྱེར་དུ་ཕེབས༌པ།"]},{"type":"verse","number":18,"content":["ཡང་ཕོལ་ལོལ་ཁོང་ཉིད་ཀོ་རིན་ཐུ་རུ་ཉིན་མང་པོར་བཞུགས་རྗེས་སྤུན་ཟླ་རྣམས་དང་ཁ་གྱེས༌ཏེ། གྲུ་གཟིངས་ལ་བསྡད་ནས་སིར་ཡཱ་ཡུལ་གྱི་ལམ་ལ་ཆས་ཤིང་། ཕུར་སི་ལཱ་དང་ཨ་ཀུ་ལཱ་གཉིས་ཀྱང་ཁོང་དང་མཉམ་དུ་ཕྱིན་ཏོ།། ཁོང་གིས་དེ་སྔར་དམ་བཅས་པ་བཞིན་ཀེན་གྲེ་ཞེས་པའི་གྲུ༌ཁ་ནས་དབུ་སྐྲ་བྲེགས་པ་རེད།"]},{"type":"verse","number":19,"content":["དེ་ནས་ཨེ་ཕེ་སི་རུ་སླེབས་པ་དང་ཕོལ་ལོལ་གྱིས་ཁོ་གཉིས་གནས་དེར་བསྐྱུར༌ཏེ། རང་ཁོ་ན་ཡ་ཧུ་དཱ་པའི་ཆོས་ཁང་དུ་ཕྱིན་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་རྩོད་གླེང་བྱས་སོ།།"]},{"type":"verse","number":20,"content":["མི་རྣམས་ཀྱིས་ཁོང་ཉིད་ཉིན་འགར་བཞུགས་པར་ཞུས་ཀྱང་ཁོང་འཐད༌པ་མ་བྱུང་།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་ཁོང་ཉིད་དེ་རྣམས་དང་ཁ་འབྲལ་སྐབས་འདི་སྐད༌དུ། གལ་ཏེ་དཀོན་མཆོག་གི་ཐུགས་དགོངས་ཡིན་ན་ང་རང་སླར་ཡང་གནས་འདིར་ཡོང་ངེས་པ་ཡིན་ཞེས་གསུངས་རྗེས་གྲུ་གཟིངས་ལ་བསྡད་དེ་ཨེ་ཕེ་སི་དང་བྲལ་ཏོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཀེ་སར་ཡཱ་རུ་སླེབས་པ་དང་ཁོང་ཉིད་གྲུ་ལས་བབས་ཏེ་ཡར་ཆོས་ཚོགས་ལ་འཚམས་འདྲི་ཞུ་བར་ཕྱིན་པ༌དང༌། དེ་རྗེས་མར་ཨན་ཏི་ཡོག་ཡཱ་རུ་བྱོན༌ཏོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་ཐེངས་གསུམ་པར་ཆོས་སྤེལ་དུ་ཕྱིན་པ།"]},{"type":"verse","number":23,"content":["གནས་དེར་ཉིན་འགར་བསྡད༌རྗེས། དེ་དང་ཁ་བྲལ་ནས་རིམ་བཞིན་ག་ལད་ཡཱ་དང་ཕུ་ཀེ་ཡཱ་ཡུལ་བརྒྱུད་ནས་རྗེས་འབྲང་པ་རྣམས་ཀྱི་དད་སེམས་བརྟན་པོར་བྱས༌སོ།།"]},{"type":"verse","number":24,"content":["དེ་ཡང་མིང་ལ་ཨ་པོལ་ལོ་ཟེར་བའི་ཡ་ཧུ་དཱ་པ་ཞིག་ཡོད་པ་དེ་ཨེ་ཕེ་སི་རུ་སླེབས། ཁོང་ནི་ཨ་ལིག་སན་དྲི་ཡཱ་ནས་སྐྱེས་ཤིང་ཁ་ལྕེ་ཅན་ཞིག་སྟེ་གསུང་རབ་ལའང་མཁས༌པ་རེད།"]},{"type":"verse","number":25,"content":["ཁོང་གིས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཆོས་ཀྱི་སྐོར་བསླབས༌པས། སེམས་ལ་སྟོབས་ཤུགས་རྒྱས་ཤིང་སྐྱབས་མགོན་ཡེ་ཤུའི་མཛད་དོན་སྐོར་མི་གཞན་ལ་ཞིབ་ཏུ་སྨྲས་ཤིང་བསྟན་མོད། འོན༌ཀྱང༌། ཁོང་གིས་ཡོ་ཧ་ནན་གྱི་ཁྲུས་གསོལ་ཁོ་ན་ཤེས༌པ་རེད།"]},{"type":"verse","number":26,"content":["དེ་ནས་ཁོང་གིས་ཡ་ཧུ་དཱ་པའི་ཆོས་ཁང་ནས་སྤོབས་པ་ཆེན་པོས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཆོས་གསུངས་པ༌ན། ཕུར་སི་ལཱ་དང་ཨ་ཀུ་ལཱ་གཉིས་ཀྱིས་གསུང་དེ་ཐོས་ནས་ཁོང་ཉིད་རང་ཁྱིམ་དུ་གདན་དྲངས༌ཏེ། དཀོན་མཆོག་གི་ཆོས་དེ་ཉིད་སྔར་ལས་ཀྱང་ཁོང་ལ་ཞིབ་ཏུ་སྨྲས་སོ།།"]},{"type":"verse","number":27,"content":["དེ་ནས་ཁོང་ཉིད་ཨ་ཀ་ཡཱ་ཡུལ་དུ་འགྲོ་འདོད་པ༌ན། སྤུན་ཟླ་རྣམས་ཀྱིས་ཀྱང་སྐུལ་མ་མཛད་པ་དང་ཡུལ་དེའི་རྗེས་འབྲང་པ་རྣམས་ལ་ཁོང་ལ་སྣེ་ལེན་བྱེད་དགོས་པའི་འཕྲིན་ཡིག་བྲིས་སོ།། དེ་ནས་ཁོང་ཉིད་ཡུལ་དེར་སླེབས་ཏེ་ཐུགས་རྗེ་བརྒྱུད་ནས་དད་པར་གྱུར་པ་རྣམས་ལ་རོགས་རམ་མང་དུ་མཛད།"]},{"type":"verse","number":28,"content":["རྒྱུ་མཚན་ནི་ཁོང་གིས་མི་ཚོགས་ཀྱི་མདུན་དུ་མཐུ་སྟོབས་ལྡན་པའི་ངང་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་དགག་པས་བཏུལ་ཏེ། གསུང་རབ་ལས་ལུང་དྲངས་ནས་ཡེ་ཤུ་ཁོང་ཉིད་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་པ་གསལ་པོར་བསྟན་ཏོ།།"]}],"footnotes":[{"noteId":17,"caller":"+","text":"ཚིག་འབྲུ་འདིར་མ་ཕྱི་ལས་ཁྱོད་ཅག་གི་ཁྲག་རང་རང་གི་མགོ་ལ་ཡོད་པར་གྱུར༌ཅིག བདག་ནི་གཙང་ངོ་ཞེས༌འབྱུང༌། དོན་ནི་ཆོས་ལ་ཉན་མཁན་དེ་དག་གིས་ཡེ་ཤུར་དད་པ་མ་བྱས༌པས། ཁྱོད་ཅག་གི་ཁྲག་རང་རང་གི་མགོ་ལ་ཡོད་པར་གྱུར་ཅིག་ཅེས་ཁྱོད་ཅག་ལ་དཀོན་མཆོག་གི་ཆད་པ་འཕོག་ངེས་པ་དེ་ཁྱོད་ཅག་གིས་འགན་འཁུར་དགོས་པར་བསྟན༌ཅིང༌། བདག་ནི་གཙང་ངོ་ཞེས་པ་ནི་བདག་ལ་ཉེས་པ་མེད་ཅེས་པའི་དོན༌ཡིན།","reference":{"chapter":18,"verse":6}}]},"thisChapterLink":"/api/bod_ntb/ACT/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/17.json","previousChapterAudioLinks":{},"numberOfVerses":28}