{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":23,"content":[{"type":"heading","content":["ཕོལ་ལོལ་ལ་འདྲི་གཅོད་བྱེད༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཕོལ་ལོལ་གྱིས་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་རྣམས་ལ་མིག་གིས་ཕུར་ཚུགས་སུ་གཟིགས་ཏེ་འདི་སྐད༌དུ། སྤུན་ཟླ༌རྣམ་པ། ངས་དཀོན་མཆོག་གི་སྤྱན་སྔ་ནས་བྱ་བ་ཀུན་ལ་ད་ལྟའི་བར་དུ་བསམ་པ་རྣམ་དག་བཅངས་པ་ཡིན་ཞེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":2,"content":["མཆོད་དཔོན་ཆེན་པོ་ཨ་ནན་ཡཱ་ཡིས་ཕོལ་ལོལ་གྱི་ཉེ་འགྲམ་དུ་ལངས་ནས་སྡོད་པའི་མི་རྣམས༌ལ། ཕོལ་ལོལ་གྱི་ཞལ་ལ་རྡེག་དགོས་པའི་བཀའ་བསྒོས༌ཤིང༌།"]},{"type":"verse","number":3,"content":["ཕོལ་ལོལ་གྱིས་ཁོ་རང་ལ་འདི་སྐད༌དུ། ཚོན་རྩི་དཀར་པོས་བརྒྱན་པའི་རྩིག་ངོས་དང་འདྲ་བ་ཁྱོད་ལའང་དཀོན་མཆོག་གིས་རྡེག་པར་འགྱུར༌ཏེ། ཁྱོད་རང་བཀའ་ཁྲིམས་ལྟར་བདག་ལ་འདྲི་གཅོད་བྱེད་པར་བསྡད་ཡོད་དམ། ཡང་ན་བཀའ་ཁྲིམས་དང་འགལ་ནས་བདག་ལ་རྡུང་བའི་བཀའ་བསྒོ་བ་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":4,"content":["ཉེ་འགྲམ་དུ་ལངས་སྡོད་པའི་མི་རྣམས་ན༌རེ། ཁྱོད་ཀྱིས་དཀོན་མཆོག་གི་མཆོད་དཔོན་ཆེན་པོ་ལ་དམའ་འབེབས་བྱེད་དམ་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":5,"content":["ཡང་ཕོལ་ལོལ་གྱིས་འདི་སྐད༌དུ། སྤུན་ཟླ༌རྣམ་པ། ངས་ཁོ་རང་མཆོད་དཔོན་ཆེན་པོ་ཡིན་པ་མ་ཤེས༌ལ། གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁྱོད་ཀྱིས་རང་གི་ཡུལ་མིའི་འགོ་དཔོན་ལ་འཕྱ་དམོད་བྱ་མི་འོས་ཞེས་བཀོད་ཡོད་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཕོལ་ལོལ་གྱིས་མི་དེ་རྣམས་ལས་འགའ་ཤས་ནི་སཱ་ཅུ་སེ་པ་དང་འགའ་ཤས་ནི་ཕ་རུ་ཤི་པ་ཡིན་པ་ཤེས༌ཏེ། དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མིའི་ཁྲོད་དུ་སྐད་ཆེན་པོས་འདི་སྐད༌དུ། སྤུན་ཟླ༌རྣམ་པ། ང་རང་ནི་ཕ་རུ་ཤི་པ་ཡིན་པ་དང་ཕ་རུ་ཤི་པའི་བུ་རྒྱུད་ཀྱང་ཡིན༌ཏེ། ངས་ད་ལྟ་འདྲི་གཅོད་མྱོང་བ་ནི་གཤིན་པོ་རྣམས་སླར་གསོན་པར་འགྱུར་བའི་དོན་དེ་ལ་རེ་སྨོན་བྱེད་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":7,"content":["ཕ་རུ་ཤི་པ་དང་སཱ་ཅུ་སེ་པ་གཉིས་ཀྱི་བར་ལ་རྩོད་པ་བྱུང་སྟེ་ཚོགས་པ་འདི་ཕྱོགས་ཁག་གཉིས་སུ་གྱུར་ཏོ།།"]},{"type":"verse","number":8,"content":["རྒྱུ་མཚན་ནི་སཱ་ཅུ་སེ་པ་རྣམས་ཀྱིས་གཤིན་པོ་རྣམས་སླར་གསོན་པར་འགྱུར་བའི་དོན་དེ་མེད༌ཅིང༌། ཕོ་ཉ་དང་སེམས་ཉིད་ཀྱང་མེད་ཅེས་སྨྲ་བ༌དང༌། ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་དོན་དེ་ཐམས་ཅད་ཡོད་པར་སྨྲ་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":9,"content":["དེ་ནས་རྩོད་པའི་འུར་སྒྲ་ཇེ་ཆེར་སོང་ཞིང་ཕ་རུ་ཤི་པའི་ཕྱོགས་ཀྱི་མཁན་པོ་འགའ་ཡར་ལངས་ཏེ་ན༌རེ། ངེད་ཅག་གིས་མི་འདི་ལས་ཉེས་སྐྱོན་ཅི་ཡང་མ་རྙེད། གལ་ཏེ་སེམས་ཉིད་དམ་ཕོ་ཉ་ཞིག་གིས་ཁོ་རང་ལ་གཏམ་སྨྲས་ན་ག་འདྲ་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":10,"content":["སྐབས༌དེར། རྩོད་པ་ཆེན་པོ་བྱུང་བས་སྟོང་དཔོན་གྱིས་ཕོལ་ལོལ་རས་བཞིན་དུམ་བུར་གཤག་པར་དོགས་ནས། དམག་མི་རྣམས་ལ་ཁོང་ཉིད་མི་ཚོགས་ལས་བཙན་གྱིས་ཕྲོགས་ཏེ་དམག་སྒར་དུ་འཁྲིད་དགོས་པའི་བཀའ་གནང༌ངོ༌།།"]},{"type":"verse","number":11,"content":["མཚན་མོ༌དེར། གཙོ་བོ་ཁོང་ཉིད་ཕོལ་ལོལ་གྱི་གམ་དུ་ཕེབས་ཏེ་འདི་སྐད༌དུ། སེམས་བདེ་བར༌གྱིས། ཁྱོད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་ནས་བདག་ལ་ཇི་ལྟར་བདེན་དཔང་བྱས་པ་བཞིན་རོ་མཱ་རུའང་དེ་བཞིན་དུ་བདེན་དཔང་བྱེད་དགོས་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གསོད་པའི་ཇུས༌ངན།"]},{"type":"verse","number":12,"content":["དེ་ཡང་ནམ་ལངས་པ་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་མཉམ་དུ་གྲོས་བྱས༌ཏེ། ཕོལ་ལོལ་མ་བསད་ན་བཟའ་བཏུང་ཅི་ཡང་མི་སྤྱོད་ཅེས་དམ་བཅས༌པ་རེད།"]},{"type":"verse","number":13,"content":["དེ་ལྟར་བློ་སེམས་གཅིག་མཐུན་སྒོས་དམ་བཅའ་འཇོག་མཁན་མི་བཞི་བཅུ་ལྷག་ཡོད་དོ།།"]},{"type":"verse","number":14,"content":["དེ་ནས་མི་དེ་རྣམས་མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་ཀྱི་གམ་དུ་སོང་སྟེ་ན༌རེ། ངེད་ཅག་གིས་ཕོལ་ལོལ་མ་བསད་ན་ཟས་ཅི་ཡང་མི་སྤྱོད་ཅེས་དམ་བཅའ་ཆེན་པོ་བཞག་ཅིང་།"]},{"type":"verse","number":15,"content":["ད་ལྟ་ཁྱོད་ཅག་དང་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་རྣམས་ཀྱིས་སྟོང་དཔོན༌ལ། ཕོལ་ལོལ་ལ་ཞིབ་ཏུ་རྟོག་དཔྱོད་བྱ་ཁུལ་བྱེད་པའི་ཆེད་དུ་འདིར་འཁྲིད་ཡོང་དགོས་པའི་སྐད་གཏོང་བར༌གྱིས། ངེད་ཅག་གིས་གྲ་སྒྲིག་བྱས་ཟིན་པས་ཁོ་རང་གནས་འདིར་མ་སླེབས་པའི་སྔོན་ལ་གསོད་པར་བྱའོ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":16,"content":["འོན་ཀྱང་། ཕོལ་ལོལ་གྱི་ཚ་བོས་དེ་དག་གིས་ལྐོག་འཇབ་བྱེད་རྩིས་ཡོད་པ་ཐོས་ཏེ་དམག་སྒར་དུ་སོང་ནས་དོན་དེ་ཕོལ་ལོལ་ལ་སྨྲས་པ་རེད།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཕོལ་ལོལ་གྱིས་བརྒྱ་དཔོན་ཞིག་བོས་ཏེ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ན་གཞོན་འདི་སྟོང་དཔོན་གྱི་དྲུང་དུ་ཁྲིད༌ཅིག ཁོ་ལ་ཞུ་རྒྱུའི་དོན་ཞིག་ཡོད་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":18,"content":["དེས་ཀྱང་ན་གཞོན་དེ་སྟོང་དཔོན་གྱི་དྲུང་དུ་ཁྲིད་དེ་ན༌རེ། བཙོན་པ་ཕོལ་ལོལ་གྱིས་ང་རང་ཁོའི་གམ་དུ་བོས་ཏེ་ན་གཞོན་འདི་ཁྱེད་ཀྱི་དྲུང་དུ་ཁྲིད༌ཅིག ཁོ་ལ་ཞུ་རྒྱུའི་དོན་ཞིག་ཡོད་པར་ཞུས་བྱུང་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":19,"content":["སྟོང་དཔོན་གྱིས་ན་གཞོན་དེའི་ལག་པར་འཇུས་ནས་ཟུར་དུ་ཁྲིད་དེ་ན༌རེ། བདག་ལ་ཞུ་རྒྱུའི་དོན་ཅི་ཞིག་ཡོད་ཅེས་ལྐོག་ཏུ་དྲིས་པ༌ལ།"]},{"type":"verse","number":20,"content":["ན་གཞོན་ན༌རེ། ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་སང་ཉིན་ཁྱེད་ལ་ཕོལ་ལོལ་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་རྣམས་ཀྱི་གམ་དུ་འཁྲིད༌པའི་རེ་བ་ཞུས་ནས། ཁོང་གི་དོན་ལ་ཞིབ་ཏུ་རྟོག་དཔྱོད་བྱ་ཁུལ་བྱེད་པར་གྲོས་བྱས༌ཟིན།"]},{"type":"verse","number":21,"content":["མི་བཞི་བཅུ་ལྷག་གིས་ཕོལ་ལོལ་མ་བསད་ན་བཟའ་བཏུང་ཅི་ཡང་མི་སྤྱོད་ཅེས་དམ་བཅས་ནས་ལྐོག་འཇབ་བྱེད་རྩིས་ཡོད༌ཅིང༌། ད་ལྟ་གྲ་སྒྲིག་ཀྱང་བྱས་ཚར་ནས་ཁྱེད་ཀྱིས་ཆོག་མཆན་འགོད་པ་ཁོ་ནར་བསྒུགས་ཡོད༌པས། ཁྱེད་ཀྱིས་དེ་དག་གི་འདོད་ལ་མི་བསྟུན་པར་འཚལ་ཞེས་ཞུས་སོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་སྟོང་དཔོན་གྱིས་ན་གཞོན་དེ༌ལ། ཁྱོད་ཀྱིས་དོན་འདི་བདག་ལ་སྨྲས་པ་ནི་མི་གཞན་སུ་ལའང་སྨྲ་བར་མི་བྱའོ་ཞེས་གདམས་ཏེ་འགྲོ་རུ་བཅུག༌གོ།"]},{"type":"heading","content":["ཕོལ་ལོལ་ཁོང་ཉིད་ཀེ་སར་ཡཱ་གྲོང་ཁྱེར་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":23,"content":["དེ་ནས་སྟོང་དཔོན་གྱིས་བརྒྱ་དཔོན་གཉིས་བོས་ཏེ་ན༌རེ། རྐང་དམག་ཉིས་བརྒྱ༌དང༌། རྟ་དམག་བདུན༌ཅུ། མདུང་རིང་ཐོགས་པའི་རྐང་དམག་ཉིས་བརྒྱ་བཅས་སྟ་གོན་བྱོས༌དང༌། མཚན་མོའི་ཆུ་ཚོད་དགུའི་སྟེང་དུ་ཀེ་སར་ཡཱ་རུ་སྐྱོད༌ཅིག"]},{"type":"verse","number":24,"content":["གཞན༌ཡང༌། ཕོལ་ལོལ་ལ་ཞོན་པ་འགའ་གྲ་སྒྲིག་བྱས་ནས་སྤྱི་དཔོན་ཕེ་ལིག་གི་དྲུང་དུ་བདེ་བར་སྐྱོལ་ཅིག་ཅེས་བཀའ་བསྒོས་པ༌དང༌།"]},{"type":"verse","number":25,"content":["འཕྲིན་ཡིག་ཅིག་བྲིས་ཤིང་ནང་དོན་མདོར་བསྡུས་འདི་ལྟ༌སྟེ། ༄༅། །གུས་པར་འོས་པའི་སྤྱི་དཔོན་ཕེ་ལིག་གི་སྤྱན་དྲུང༌དུ། ཐོག་མར་ཁྱེད་ལ་འཚམས་འདྲི་ཞུ་ཞེས་ཀཱ་ལོ་དི་ལི་སི་ཨ་ནས་སྤྲིངས༌དོན།"]},{"type":"verse","number":27,"content":["དེ་ཡང་མི་འདི་ནི་ཡ་ཧུ་དཱ་པ་དག་གིས་བཙན་གྱིས་བཟུང་ཞིང་གསོད་པར་རྩོམ་པའི་དུས༌སུ། བདག་གིས་ཁོ་རང་ནི་རོ་མཱ་པ་ཞིག་ཡིན་པ་ཤེས་ནས་དམག་མི་དང་བཅས་པ་གནས་དེར་སོང་སྟེ་ཁོ་རང་བསྐྱབས༌པ་དང་།"]},{"type":"verse","number":28,"content":["ཡ་ཧུ་དཱ་པ་དག་གིས་ཁོ་རང་གཏུག་བཤེར་བྱེད་པའི་རྒྱུ་མཚན་ཅི་ཡིན་པ་བདག་གིས་ཤེས་འདོད༌དེ། ཡ་ཧུ་དཱ་པའི་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མིའི་མདུན་དུ་ཁྲིད་པ༌ན།"]},{"type":"verse","number":29,"content":["ཁོ་རང་གཏུགས་དོན་ནི་ཡ་ཧུ་དཱ་པའི་ཆོས་ཀྱི་བཀའ་ཁྲིམས་ཐད་ལ་རྩོད་པ་བྱུང་བ་ཙམ༌ལས། བཙོན་དུ་འཇུག་པའམ་སྲོག་ཆད་གཅོད་དགོས་པའི་ཉེས་སྐྱོན་ཅི་ཡང་མེད་པ་ཤེས་སོ།།"]},{"type":"verse","number":30,"content":["ཕྱིས་སུ་ཁོ་རང་ལྐོག་གསོད་བྱེད་པའི་ཇུས་ངན་དེ་མི་ཞིག་གིས་བདག་ལ་སྨྲས་པ་དང་ངས་ཀྱང་འཕྲལ་དུ་ཁོ་རང་ཁྱེད་ཀྱི་དྲུང་དུ་བསྐྱལ༌ཞིང༌། ཁོ་རང་གཏུག་མཁན་རྣམས་ལའང་ཁྱེད་ཀྱི་དྲུང་ནས་ཁོ་རང་གཏུགས་ཤིག་ཅེས་ཁ་བསྒོ་བྱས་པ་ཡིན། མཇུག་མཐར་ཁྱེད་ཀྱི་སྐུ་ཁམས་བདེ་བར༌སྨོན། ཞེས༌པའོ།།"]},{"type":"verse","number":31,"content":["དེ་ནས་དམག་མི་རྣམས་ཀྱིས་བཀའ་བཞིན་དུ་མཚན་མོའི་དུས༌སུ་ཕོལ་ལོལ་ཁྲིད་ནས་ཨན་ཏི་པཱ་ཏྲི་རུ་སླེབས།"]},{"type":"verse","number":32,"content":["དེའི་ཕྱི༌ཉིན། རྟ་དམག་རྣམས་ཀྱིས་ཕོལ་ལོལ་བསྐྱལ་བ་དང་གཞན་རྣམས་ཕྱིར་དམག་སྒར་དུ་ལོག་གོ།"]},{"type":"verse","number":33,"content":["རྟ་དམག་རྣམས་ཀྱིས་ཕོལ་ལོལ་བསྐྱལ་ནས་ཀེ་སར་ཡཱ་རུ་སླེབས་པ་དང་འཕྲིན་ཡིག་དེ་སྤྱི་དཔོན་ལ་ཕུལ་ཞིང་ཕོལ་ལོལ་ཡང་ཁོའི་མདུན་དུ་བསླངས་སོ།།"]},{"type":"verse","number":34,"content":["སྤྱི་དཔོན་གྱིས་འཕྲིན་ཡིག་བཀླགས༌རྗེས། ཕོལ་ལོལ་ཡུལ་གང་ནས་ཡིན་པ་དྲིས་པ་དང་ཀི་ལིག་ཡཱ་ཡུལ་གྱི་ཡིན་པ་ཤེས༌ཏེ།"]},{"type":"verse","number":35,"content":["ཁྱོད་རང་གཏུག་མཁན་གྱི་མི་རྣམས་ཀྱང་སླེབས་པའི་ཚེ། ངས་ཁྱོད་ཀྱི་དོན་ལ་ཞིབ་ཏུ་མཉན་པར་བྱའོ་ཞེས་སྨྲས་པ༌དང༌། ཧེ་རོ་དཱའི་ཕོ་བྲང་དུ་ཕོལ་ལོལ་བཙོན་ལ་འཇུག་དགོས་པའི་བཀའ་གནང༌ངོ༌།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ACT/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/22.json","previousChapterAudioLinks":{},"numberOfVerses":34}