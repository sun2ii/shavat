{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":25,"content":[{"type":"heading","content":["སྤྱི་དཔོན་ཕེ་ཏིའི་མདུན་དུ་ཕོལ་ལོལ་ལ་འདྲི་གཅོད་བྱས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སྤྱི་དཔོན་ཕེ་ཏི་ཡུལ་ལྗོངས་དེར་སླེབས་ནས་ཉིན་གསུམ་གྱི་རྗེས༌སུ། ཀེ་སར་ཡཱ་ནས་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་སོང་བ༌དང༌།"]},{"type":"verse","number":2,"content":["མཆོད་དཔོན་ཆེན་པོ་དག་དང་ཡ་ཧུ་དཱ་པའི་དཔོན་རིགས་རྣམས་ཀྱིས་ཁོ་ལ་ཕོལ་ལོལ་གཏུགས༌ཤིང༌།"]},{"type":"verse","number":3,"content":["ཕོལ་ལོལ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་འཁྲིད་ཡོང་བར་རེ་བ་ཡང་ཡང་ཞུས། ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཧུ་དཱ་པའི་དཔོན་རིགས་དེ་དག་གིས་ལམ་བར་དུ་ཁོང་ཉིད་གསོད་པར་ལྐོག་འཇབ་བྱས་ཡོད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":4,"content":["འོན༌ཀྱང༌། ཕེ་ཏི་ན༌རེ། ཕོལ་ལོལ་བྱ་བ་ཀེ་སར་ཡཱ་ནས་བཙོན་ལ་བཅུག་ཡོད་ཅིང་ང་རང་ཅང་མ་འགོར་བར་དེ་རུ་འགྲོ་བ་ཡིན།"]},{"type":"verse","number":5,"content":["དེ་བས་ཁྱོད་རྣམས་ལས་མི་དབང་ཐང་ཅན་རྣམས་བདག་དང་མཉམ་དུ༌འགྲོའོ།། གལ་ཏེ་མི་དེ་ལ་ཉེས་སྐྱོན་ཡོད་ན་གཏུག་ཆོག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཕེ་ཏི་བྱ་བ་ཡེ་རུ་སཱ་ལེམ་དུ་ཉིན་བརྒྱད་ནས་བཅུ་ཙམ་ལ་བསྡད་པ་དང་མར་ཀེ་སར་ཡཱ་རུ་སོང༌ཞིང༌། དེའི་ཕྱི་ཉིན་ཁྲིམས་དཔོན་གྱི་ཁྲིའི་སྟེང་དུ་བཞུགས་ཤིང་ཕོལ་ལོལ་འཁྲིད་ཡོང་དགོས་པའི་བཀའ་གནང༌ངོ་།།"]},{"type":"verse","number":7,"content":["ཕོལ་ལོལ་ཁྲིམས་ཁང་དུ་ཡོང་བ་དང་ཡེ་རུ་སཱ་ལེམ་ནས་མར་ཡོང་བའི་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱང་སླེབས་ཏེ། ཕོལ་ལོལ་གྱི་མཐའ་བསྐོར་ཞིང་དོན་རྐྱེན་ཚབས་ཆེན་མང་པོ་གླེང་ནས་ཁོང་ཉིད་གཏུགས་ནའང་བདེན་དཔང་བྱེད་མ་ནུས་སོ།།"]},{"type":"verse","number":8,"content":["ཕོལ་ལོལ་གྱིས་དག་འབུད་བྱས་ནས་འདི་ལྟར་སྨྲས༌པ་སྟེ། ང་རང་ནི་ཡ་ཧུ་དཱ་པའི་བཀའ་ཁྲིམས༌དང༌མཆོད༌ཁང༌། ཡང་ན་སེ་བཟིར་བཅས་གང་ལའང་འགལ་མ་མྱོང་ཞེས་པའོ།།"]},{"type":"verse","number":9,"content":["འོན༌ཀྱང༌། ཕེ་ཏིས་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་ངོ་སོ་ལེན་པའི་ཕྱིར་ན༌རེ། ཁྱོད་རང་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་སོང༌ནས། བདག་གིས་ཁྱོད་ཀྱི་དོན་འདིར་ཁྲིམས་ཐག་བཅད་ན་ཁྱོད་རང་འཐད་པ་ཡིན་ནམ་ཞེས་དྲིས་པ༌དང༌།"]},{"type":"verse","number":10,"content":["ཕོལ་ལོལ་གྱིས་འདི་སྐད༌དུ། ང་རང་ནི་སེ་བཟིར་གྱི་ཁྲིའི་མདུན་དུ་བསྡད་ཡོད༌ཅིང༌། འདི་ནི་བདག་ལ་འདྲི་གཅོད་བྱེད་འོས་པའི་གནས་ཀྱང༌ཡིན། ངས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་གནོད་པའི་བྱ་བ་ཅི་ཡང་བྱས་མ་མྱོང་བ་ཁྱེད་ཀྱིས་ཀྱང་གསལ་པོར་ཤེས༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":11,"content":["གལ་ཏེ་ང་རང་ཉེས་ཅན་ཡིན་པ་དང་ངས་སྲོག་ཆད་གཅོད་འོས་པའི་ཉེས་པ་གང་ཞིག་བྱས་ཡོད༌ན། ང་རང་འཆི་དགོས་ཀྱང་རང་སྲོག་ལ་འཛེམ་པར་མི༌བྱའོ།། གལ་ཏེ་ཁོ་རྣམས་ཀྱིས་ང་རང་གཏུགས་པའི་དོན་དེ་རྣམས་བདེན་པ་མ་ཡིན་ན་སུས་ཀྱང་ང་རང་ཁོ་རྣམས་ལ་སྤྲོད་མི་རུང༌སྟེ། ངས་ཀྱང་སེ་བཟིར་ལ་གཏུག་བཤེར་ཞུ་རྒྱུ་ཡིན་ཞེས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":12,"content":["ཕེ་ཏིས་རང་གི་གྲོས་ཚོགས་ཀྱི་མི་རྣམས་དང་གྲོས་བྱས་ཏེ་ན༌རེ། ཁྱོད་ཀྱིས་སེ་བཟིར་ལ་གཏུག་བཤེར་ཞུ་འདོད་ན་ཁོང་གི་དྲུང་དུ་འགྲོ་དགོས་ཞེས་སྨྲས༌སོ།།"]},{"type":"heading","content":["སྤྱི་དཔོན་ཕེ་ཏི་དང་ས་གནས་རྒྱལ་པོ་ཨག་རི་པཱ་གཉིས་བར་གྱི་གླེང༌མོལ།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཉིན་ཁ་ཤས་འགོར༌རྗེས། ས་གནས་རྒྱལ་པོ་ཨག་རི་པཱ་དང་པུར་ནེ་ཀེ་གཉིས་ཀེ་སར་ཡཱ་རུ་ཕེབས་ཏེ་ཕེ་ཏི་ལ་འཚམས་འདྲི་བྱས༌ཤིང༌།"]},{"type":"verse","number":14,"content":["ཁོ་གཉིས་ཉིན་མང་པོར་བཞུགས་པ་དང་ཕེ་ཏི་ཡིས་ཕོལ་ལོལ་གྱི་གནས་ཚུལ་ས་གནས་རྒྱལ་པོ་ལ་འདི་ལྟར་ཞུས་པ༌སྟེ། འདིར་ཕེ་ལིག་གིས་བཙོན་དུ་བཅུག་པའི་མི་ཞིག་ཡོད་པ༌དང༌།"]},{"type":"verse","number":15,"content":["ང་རང་ཡེ་རུ་སཱ་ལེམ་དུ་སྡོད་པའི་དུས༌སུ། མཆོད་དཔོན་ཆེན་པོ་དག་དང་ཡ་ཧུ་དཱ་པའི་རྒན་པོ་རྣམས་ཀྱིས་མི་དེ་གཏུགས་ཤིང་ཁོ་རང་ལ་ཉེས་ཆད་གཅོད་པའི་རེ་བ་ཞུས།"]},{"type":"verse","number":16,"content":["ངས་དེ་རྣམས་ལ་འདི་ལྟར་སྨྲས་པ༌སྟེ། མི་སུ་ཞིག་ཡིན་ཡང་གྱོད་ཡ་དང་གཏུག་མཁན་གཉིས་ཀྱིས་གདོང་ཐུག་ནས་ར་སྤྲོད་མ་བྱས་པ༌དང༌། རང་ཉིད་གཏུགས་པའི་དོན་དེར་དག་འབུད་བྱེད་པའི་གོ་སྐབས་མ་བྱུང་སྔོན༌དུ། མི་དེར་ཉེས་ཆད་གཅོད་པ་ནི་རོ་མཱ་པའི་སྲོལ་མིན་ཞེས་བཤད་པ༌ཡིན།"]},{"type":"verse","number":17,"content":["དེ་ནས་གཏུག་མཁན་རྣམས་འདིར་སླེབས་པ་དང་ངས་དུས་འགྱངས་མ་བྱས༌པར། དེའི་ཕྱི་ཉིན་ང་རང་ཁྲིམས་དཔོན་གྱི་ཁྲིའི་སྟེང་དུ་བསྡད་ནས་མི་དེ་འཁྲིད་ཡོང་དགོས་པའི་བཀའ་བསྒོས་པ༌དང༌།"]},{"type":"verse","number":18,"content":["གཏུག་མཁན་རྣམས་ཡར་ལངས་ཏེ་ཁོ་རང་གཏུགས༌ཤིང༌། དེ་རྣམས་ཀྱིས་གཏུགས་པའི་དོན་དེ་དག་ནི་ངས་ཚོད་དཔག་བྱས་པའི་ཉེས་པ་དེའི་རིགས་ནི་མིན་ནོ།།"]},{"type":"verse","number":19,"content":["འོན༌ཀྱང༌། ཁོ་རྣམས་ཀྱི་བར་དུ་རང་གི་ཆོས་ལུགས་ཐད་ནས་རྩོད་པ༌འགའ་ཤས་བྱུང་བ་སྟེ། ཡེ་ཤུ་ཟེར་བའི་མི་ཞིག་ཡོད་པ་ཤི་ཟིན་ནའང་ཕོལ་ལོལ་གྱིས་དེ་གསོན་པོ་ཡིན་ཞེས་ཟེར།"]},{"type":"verse","number":20,"content":["ངས་དོན་འདིའི་རིགས་ལ་ཇི་ལྟར་རྩད་གཅོད་བྱེད་པ་མ་ཤེས་པས་ཁོ་ལ་འདི་ལྟར་དྲིས༌པ་སྟེ། ཁྱོད་རང་ཡེ་རུ་སཱ་ལེམ་དུ་སོང་ནས་བདག་གིས་ཁྱོད་ཀྱི་དོན་འདི་ཐག་བཅད་ན་ཁྱོད་རང་འཐད་དམ་ཞེས༌པའོ།།"]},{"type":"verse","number":21,"content":["འོན༌ཀྱང༌། ཕོལ་ལོལ་གྱིས་རང་ཉིད་འདི་རུ་བཙོན་དུ་བཅུག་ནས་བསྲུང་བ་དང་གོང་མ་རྒྱལ་པོས་ཁྲིམས་ཐག་གཅོད་པར་རེ་བ་ཞུས༌པས། ངས་ཀྱང་ཁོ་རང་སེ་བཟིར་གྱི་དྲུང་དུ་བསྐྱལ་བའི་བར་དུ་འདི་ནས་བཙོན་དུ་བཅུག་ནས་བསྲུང་དགོས་པའི་བཀའ་གནང་བ་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཨག་རི་པཱས་སྤྱི་དཔོན་ཕེ་ཏི༌ལ། ང་རང་ཡང་མི་འདིའི་གཏམ་ལ་མཉན་པར་དགའ་ཞེས་སྨྲས་པ༌དང༌། ཕེ་ཏི་ན༌རེ། དེས་ན་སང་ཉིན་ཁྱེད་ཀྱིས་ཀྱང་གསན་པར་འགྱུར་ཞེས་སྨྲས༌སོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་རྒྱལ་པོ་ཨག་རི་པཱའི་དྲུང་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":23,"content":["དེའི་ཕྱི༌ཉིན། ཨག་རི་པཱ་དང་པུར་ནེ་ཀེ་གཉིས་བརྗིད་ཉམས་ཆེན་པོའི་ངང་ནས་ཕེབས༌ཤིང༌། སྟོང་དཔོན་དང་གྲོང་ཁྱེར་གྱི་སྐུ་དྲག་རྣམས་དང་མཉམ་དུ་ཚོགས་ཁང་དུ་ཕྱིན་པ༌དང༌། ཕེ་ཏིས་བཀའ་བསྒྲགས་པ་དང་ཕོལ་ལོལ་ཁྲིད་ཡོང༌བ་རེད།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཕེ་ཏི་ན༌རེ། འདིར་བཞུགས་པའི་རྒྱལ་པོ་ཨག་རི་པཱ་དང་སྐུ་ཞབས་རྣམ༌པ། ཁྱེད་ཅག་གིས་གཟིགས༌དང༌། མི་འདི་ནི་བདག་ལ་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དང་གནས་འདི་ནས་ཁོ་རང་གསོན་པོར་བསྐྱུར་མི་རུང་ཞེས་ནན་ཞུ་བྱས་ཤིང་འུར་བརྒྱབ་པ་དེ་ཡིན།"]},{"type":"verse","number":25,"content":["འོན༌ཀྱང༌། ངས་མི་འདིར་སྲོག་ཆད་གཅོད་འོས་པའི་ཉེས་པ་ཅི་ཡང་མ་རྙེད་པ༌དང༌། ཁོས་གོང་མ་རྒྱལ་པོ་ལ་གཏུག་བཤེར་ཞུ་རྒྱུ་ཡིན་ཞེས་སྨྲས༌པས། ངས་ཀྱང་ཁོ་རང་གོང་མ་རྒྱལ་པོའི་དྲུང་དུ་གཏོང་རྒྱུ་ཐག་གིས་བཅད་དོ།།"]},{"type":"verse","number":26,"content":["བདག་ལ་མི་འདིའི་སྐོར་གྱི་གནས་ཚུལ་གསལ་པོ་ཞིག་ཡི་གེར་བཀོད་ནས་བདག་གི་རྗེ་བོར་འབུལ་རྒྱུ་མེད༌པས། ཁོ་རང་ཁྱེད་རྣམས་དང་ལྷག་པར་རྒྱལ་པོ་ཨག་རི་པཱ་ཁྱེད་ཀྱི་དྲུང་དུ་ཁྲིད་ཡོང༌ཞིང༌། དེ་ནི་མི་འདི་ལ་འདྲི་གཅོད་བྱས་རྗེས་ཡར་ཞུ་བྱེད་བདེ་བའི་ཆེད་དུ༌ཡིན།"]},{"type":"verse","number":27,"content":["ངས་བལྟས་ན་བཙོན་པ་ཞིག་ལ་ཉེས་པ་ཅི་ཡོད་པ་མ་བསྟན་པར་གོང་མ་རྒྱལ་པོའི་དྲུང་དུ་འཁྲིད་པ་ནི་གནས་ལུགས་དང་མི་མཐུན་ཞེས་སྨྲས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ACT/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/24.json","previousChapterAudioLinks":{},"numberOfVerses":27}