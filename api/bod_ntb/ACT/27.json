{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":27,"content":[{"type":"heading","content":["ཕོལ་ལོལ་ཁོང་ཉིད་རོ་མཱ་གྲོང་ཁྱེར་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཕེ་ཏི་ཡིས་ངེད་རྣམས་གྲུ་གཟིངས་ལ་བསྡད་ནས་ཨི་ཏ་ལི་ཡུལ་དུ་འགྲོ་རུ་འཇུག་པར་ཐག་གིས་བཅད་པ༌ན། ཕོལ་ལོལ་དང་བཙོན་པ་གཞན་རྣམས་སེ་བཟིར་རྒྱལ་པོའི་དམག་དཔུང་གི་བརྒྱ་དཔོན་ཡུ་ལི་ཞེས་པ་ལ་སྤྲད་དོ།།"]},{"type":"verse","number":2,"content":["དེ་ཡང་ཨ་དྲ་མིད་ཅེས་པའི་གྲུ་ཁ་ནས་ཡོང་བའི་གྲུ་གཟིངས་ཤིག་ཨེ་ཞི་ཡཱ་ཡུལ་གྱི་མཚོ་འགྲམ་གྱི་གནས་རྣམས་བརྒྱུད་ནས་བསྐྱོད་པ༌ལ། ངེད་རྣམས་ཀྱང་གྲུ་དེར་བསྡད་ནས་འགྲོ་བར་བརྩམས་ཤིང་མ་ཀེ་དོན་ཡཱ་ཡུལ་གྱི་ཐེ་སཱ་ལོ་ནེ་ཀེ་གྲོང་ཁྱེར་གྱི་ཨ་རི་སྟར་ཀུའང་ངེད་ཅག་དང་མཉམ་དུ་ཕྱིན་ཏོ།།"]},{"type":"verse","number":3,"content":["དེའི་ཕྱི༌ཉིན། ཚི་ཏུན་དུ་སླེབས་པ་དང་ཡུ་ལི་བྱ་བས་ཕོལ་ལོལ་གུ་ཡངས་བཏང༌སྟེ། ཁོང་ཉིད་རང་གི་གྲོགས་པོའི་གམ་དུ་བདག་སྐྱོང་འཐོབ་པའི་ཕྱིར་འགྲོ་ཆོག་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཡང་དེ་ནས་གྲུ་གཟིངས་ལ་བསྡད་དེ་འགྲོ་བར་བརྩམས་པ༌ལ། ལྡོག་རླུང་དང་ཕྲད་པས་ཀིབ་རིས་ཀྱི་མཚོ་སྐྱིབས་བརྒྱུད་ནས་སོང༌ངོ་།།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཀི་ལིག་ཡཱ་དང་ཕཱམ་ཕིལ་ཡ་ཡུལ་གཉིས་ཀྱི་མདུན་ཕྱོགས་ཀྱི་རྒྱ་མཚོ་བརྒལ་ནས་ལིག་ཡཱ་ཡུལ་གྱི་མུ་ར་བྱ་བར་སླེབས༌ཤིང༌།"]},{"type":"verse","number":6,"content":["གནས་དེ་ནས་བརྒྱ་དཔོན་གྱིས་ཨི་ཏ་ལི་ཡུལ་དུ་འགྲོ་བའི་ཨ་ལིག་སན་དྲི་ཡཱ་ཡི་གྲུ་གཟིངས་ཤིག་རྙེད་ཅིང་ངེད་རྣམས་ཀྱང་གྲུ་དེར་སྡོད་དུ་བཅུག་གོ།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཉིན་མང་པོར་གྲུ་གཟིངས་དལ་གྱིས་བསྐྱོད་ཅིང་དཀའ་ཚེགས་ཀྱི་ངང་ནས་ཀེ་ནེ་ཏི་ཡི་མདུན་ཕྱོགས་སུ་སླེབས་པ༌དང༌། ཡང་མཚོ་རླུང་གི་བཀག་རྒྱ་ཐེབས་ཏེ་མདུན་དུ་འགྲོ་མ་ནུས༌པས། ཀཱ་རེ་ཏ་གླིང་ཕྲན་གྱི་མཚོ་སྐྱིབས་བརྒྱུད་ནས་སོང་བ༌དང་། སཱལ་མོ་ནེ་ཕར་ཕྱོགས་སུ་སྐྱོད་ཅིང་།"]},{"type":"verse","number":8,"content":["ངེད་རྣམས་ཀྱང་དཀའ་ཚེགས་ངང་མཚོ་འགྲམ་བརྒྱུད་ནས་སོང་བ༌དང༌། གྲོང་ཁྱེར་ལཱ་ས་ཡ་དང་ཉེ་བའི་བདེ་ཅན་ཞེས་པའི་གྲུ་ཁར་སླེབས་སོ།།"]},{"type":"verse","number":9,"content":["དེ་ལྟར་དུས་ཡུན་རིང་པོ་འགོར་བ་དང་སྨྱུང་གནས་དུས་ཆེན་གྱི་ཉིན་ཡང་སྔར་ནས་བརྒལ་བ༌དང༌། གྲུ་གཟིངས་བསྐྱོད་པ་ལའང་ཉེན་ཁ་ཡོད་པས་ཕོལ་ལོལ་གྱིས་མི་རྣམས་ལ་འདི་ལྟར་བསྐུལ་བ་སྟེ།"]},{"type":"verse","number":10,"content":["རྣམ་པ་ཚོ། ཐེངས་འདིར་གྲུ་གཟིངས་བསྐྱོད་པ་ལ་ཉེན་ཁ་ཆེ༌སྟེ། ཚོང་རྫས་དང་གྲུ་གཟིངས་ལ་གྱོང་གུད་དང་གཏོར་བཤིག་ཐེབས་ངེས༌ཤིང༌། ཐ་ན་བདག་ཅག་གི་ཚེ་སྲོག་ལའང་བར་ཆད་འབྱུང་ངེས་པར་བསམ་ཞེས་སྨྲས༌མོད།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་བརྒྱ་དཔོན་ནི་གྲུ་གཟིངས་གཏོང་མཁན་དང་གྲུ་བདག་ལ་ཡིད་ཆེས་པ་ལས་ཕོལ་ལོལ་གྱི་གསུང་ལ་ཡིད་མ་ཆེས།"]},{"type":"verse","number":12,"content":["གྲུ་ཁ་འདི་ནས་དགུན་བསྐྱལ་ན་མི་ལེགས་པས་གྲུ་གཟིངས་ནང་གི་མི་མང་ཤོས་ན༌རེ། ཅི་ལྕོགས་ཀྱིས་གནས་འདི་དང་ཁ་བྲལ་ནས་ཕེ་ནིག་ཅེས་པའི་གྲུ་ཁར་སོང་ན་ལེགས་ཞེས་གཏམ༌སྨྲས། ཕེ་ནིག་ཅེས་པ་ནི་ཀཱ་རེ་ཏ་ཡི་གྲུ་ཁ་ཞིག་སྟེ་སྣེ་མོ་གཅིག་ནི་ལྷོ་ནུབ་ཀྱི་མཚམས་དང་གཅིག་ནི་ནུབ་བྱང་གི་ཕྱོགས་སུ་འཁོར་ཡོད༌དོ།།"]},{"type":"heading","content":["རླུང་ཆེན་ལ་ཕྲད་པའི༌ཚུལ།"]},{"type":"verse","number":13,"content":["དུས༌དེར། ལྷོ་རླུང་དལ་གྱིས་ལྡང་བ་དང་ཁོ་རྣམས་ཀྱིས་བསམ་དོན་གྲུབ་བོ་སྙམ༌སྟེ། གཏིང་རྡོ་བླངས་ནས་ཀཱ་རེ་ཏ་ཡི་ཉེ་སར་འགྲོ་བཞིན་ཡོད་དོ།།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཅང་མ་འགོར་བར་གླིང་ཕྲན་གྱི་ངོས་ནས་ཨེའུ་ར་ཀི་ལོ་ཞེས་པའི་ཤར་བྱང་གི་དྲག་རླུང་གཡུགས་སོ།།"]},{"type":"verse","number":15,"content":["ཡང་གྲུ་གཟིངས་རླུང་ཆེན་དྲག་པོའི་དབང་དུ་སོང་བ༌དང༌། རླུང་གི་ཕྱོགས་སུ་གྲུ་ལ་ཁ་ལོ་བསྒྱུར་མ་ནུས་པས་རླུང་གིས་གང་སར་དེད་དོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཀོ་ཏཱ་ཞེས་པའི་གླིང་ཕྲན་ཆུང་ངུ་ཞིག་གི་མཚོ་སྐྱིབས་སུ་ཁུར་ཞིང་། གྲུ་གཟིངས་ཀྱི་རྗེས་སུ་དྲུད་པའི་གྲུ་ཆུང་ཡང་དཀའ་ཚེགས་ངང་འཛིན་ཐུབ་པ་བྱུང་།"]},{"type":"verse","number":17,"content":["གྲུ་ཆུང་བླངས་པའི་རྗེས་སུ་གྲུ་ཆེན་གྱི་ཞབས་ཐག་པས་བསྡམས་པ༌དང༌། ཡང་སིར་ཏི་ཞེས་པའི་མཚོ་ཞབས་ཀྱི་བྱེ་འདམ་དུ་གྲུ་གཟིངས་ཟུག་པར་དོགས་ནས་གཡོར་མོ་མར་ཕབ་སྟེ་གྲུ་གཟིངས་གང་སར་བསྐྱོད་དུ་བཅུག་གོ།"]},{"type":"verse","number":18,"content":["དེའི་ཕྱི༌ཉིན། རླུང་ཆེན་དྲག་པོས་གྲུ་གཟིངས་ཡོམ་ཡོམ་དུ་གཡུགས༌པས། མི་རྣམས་ཀྱིས་ཚོང་རྫས་མཚོ་ནང་དུ་འཕང་བར་བརྩམས་པ༌དང༌།"]},{"type":"verse","number":19,"content":["ཉིན་གསུམ་པར་ཡང་ཁོ་རྣམས་ཀྱིས་གྲུ་གཟིངས་སྟེང་གི་ཡོ་བྱད་རྣམས་ཀྱང་དངོས་སུ་མཚོ་ནང་དུ་འཕངས་སོ།།"]},{"type":"verse","number":20,"content":["དེ་ལྟར་ཉི་མ་དང་སྐར་མ་མ་མཐོང་བར་ཉིན་མང་པོ་འགོར་བ་དང་རླུང་འཚུབ་དྲག་པོས་ཀྱང་ངེད་རྣམས་སྡུག་ལ་སྦྱར་བས་སྲོག་ཐར་བའི་རེ་བ་ཡོངས་སུ་ཟད་དོ།།"]},{"type":"verse","number":21,"content":["དེ་ནས་མི་རྣམས་ཀྱིས་ཉིན་མང་པོར་བཟའ་བཏུང་ཡང་སྤྱད་མེད༌པས། ཕོལ་ལོལ་དེ་དག་གི་དཀྱིལ་ནས་ཡར་ལངས་ཏེ་འདི་སྐད༌དུ། རྣམ་པ་ཚོ། ཁྱོད་རྣམས་ཀྱིས་སྔར་ནས་བདག་གི་གཏམ་ལ་མཉན༌ཏེ། ཀཱ་རེ་ཏ་རུ་བསྡད་པ་ཡིན་ན་འདི་ལྟ་བུའི་གྱོང་གུད་དང་གཏོར་བཤིག་བྱུང་མེད་དོ།།"]},{"type":"verse","number":22,"content":["ངས་ད་ལྟའང་ཁྱོད་རྣམས་ཀྱི་སེམས་བདེ་བར་བསྐུལ༌ཏེ། གྲུ་གཟིངས་ཁོ་ན་མ་གཏོགས་ཁྱོད་རྣམས་ཀྱི་ཚེ་སྲོག་གཅིག་ཀྱང་འཆོར་བར་མི་འགྱུར།"]},{"type":"verse","number":23,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་ནི་དཀོན་མཆོག་ལ་གཏོགས་པ་དང་ངས་ཁོང་ལ་བསྙེན་བཀུར་བྱེད༌ཅིང༌། ཁོང་གི་ཕོ་ཉ་ཞིག་མདང་དགོང་བདག་གི་གམ་དུ་ཕེབས་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":24,"content":["ཕོལ་ལོལ་ཁྱོད་རང་འཇིགས་མི་དགོས༌ཏེ། ཁྱོད་རང་ཅིས་ཀྱང་སེ་བཟིར་གྱི་མདུན་དུ་ལངས་དགོས་པ་ཡིན། ལྟོས༌དང༌། ཁྱོད་དང་མཉམ་དུ་གྲུ་གཟིངས་ནང་དུ་ཡོད་པའི་མི་ཐམས་ཅད་ཀྱང་དཀོན་མཆོག་གིས་སྐྱོབ་པར་མཛད་ཅེས་གསུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":25,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱི་སེམས་བདེ་བར༌གྱིས། དཀོན་མཆོག་གིས་བདག་ལ་ཇི་ལྟར་གསུངས་པ་དེ་ལྟར་འགྲུབ་པར་མཛད་པ་ལ་ང་རང་ཡིད་ཆེས༌པ་ཡིན།"]},{"type":"verse","number":26,"content":["འོན༌ཀྱང༌། བདག་ཅག་གི་གྲུ་འདི་ངེས་པར་གླིང་ཕྲན་ཞིག་ལ་ཐོགས་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["གྲུ་གཟིངས་ཆག་གྲུམ་བྱུང་བ།"]},{"type":"verse","number":27,"content":["རླུང་ཆེན་གཡུགས་ནས་ཉིན་བཅུ་བཞི་པའི་མཚན་མོ་དེར་གྲུ་གཟིངས་ཀྱང་ཨ་དྲི་ཡཱ་རྒྱ་མཚོའི་སྟེང་ནས་ཡོམ་ཡོམ་དུ་འགུལ་ཏོ།། ནམ་ཕྱེད་ཙམ་ལ་གྲུ་པ་དག་གིས་སྐམ་ས་དང་ཉེ་བར་སླེབས་པ་རེད་སྙམ༌སྟེ།"]},{"type":"verse","number":28,"content":["རྒྱ་མཚོའི་ཟབ་ཚད་འཇལ་བ་ན་འདོམ་ཉི་ཤུ་ཡོད་པ༌དང༌། ཡང་གྲུ་གཟིངས་ཅུང་ཙམ་མདུན་དུ་བསྐྱོད་པ་དང་ཟབ་ཚད་འཇལ་བ་ན་འདོམ་བཅོ་ལྔ་ཡོད་པ་ཤེས༌ཏེ།"]},{"type":"verse","number":29,"content":["གྲུ་གཟིངས་རྡོ་ཕ་བོང་ལ་ཐོགས་པར་འཇིགས་ཏེ་གྲུའི་མཇུག་ནས་གཏིང་རྡོ་བཞི་མཚོ་ནང་དུ་འཕངས་རྗེས་ནམ་ལངས་པར་རེ་སྒུག་བྱས་སོ།།"]},{"type":"verse","number":30,"content":["དེ་ནས་གྲུ་པ་རྣམས་གྲུ་གཟིངས་ལས་འབྲོ་བར་བསམས༌ཏེ། གྲུ་ཆུང་ཞིག་མཚོ་ནང་དུ་དཔྱངས་པ་དང་གྲུའི་མགོ་ནས་ཀྱང་གཏིང་རྡོ་འགའ་འཕེན་ཁུལ་བྱས་པ༌ལ།"]},{"type":"verse","number":31,"content":["ཕོལ་ལོལ་གྱིས་བརྒྱ་དཔོན་དང་དམག་མི་རྣམས་ལ་འདི་སྐད༌དུ། གལ་ཏེ་མི་འདི་རྣམས་གྲུ་གཟིངས་ཀྱི་སྟེང་ནས་མ་བསྡད༌ན། ཁྱོད་ཅག་སུ་ཡིན་ཡང་ཉེན་ཁ་ལས་ཐར་མི་ཐུབ་ཅེས་གསུངས༌པས།"]},{"type":"verse","number":32,"content":["དམག་མི་རྣམས་ཀྱིས་གྲུ་ཆུང་གི་ཐག་པ་བཅད་དེ་ཆུར་བཏང༌ངོ༌།།"]},{"type":"verse","number":33,"content":["དེ་ནས་སྐྱ་རེངས་ཤར་བའི་དུས༌སུ། ཕོལ་ལོལ་གྱིས་མི་ཀུན་ལ་བཟའ་བཏུང་སྤྱོད་འོས་ཚུལ་འདི་ལྟར་བསྐུལ་བ་སྟེ། ཁྱོད་རྣམས་བཀྲེས་ཤིང་ལྟོགས་ནའང་སེམས་ཁྲལ་བྱས་ནས་བཟའ་བཏུང་མ་སྤྱད་པར་ཉིན་བཅུ་བཞི་སོང༌།"]},{"type":"verse","number":34,"content":["དེའི༌ཕྱིར། ངས་ཁྱོད་རྣམས་ལ་བཟའ་བཏུང་སྤྱོད་པར་བསྐུལ༌ཏེ། འདི་ནི་ཁྱོད་ཅག་གི་སྲོག་སྐྱོབ་པའི་ཕྱིར་ཡིན། རྒྱུ་མཚན་ནི་ཁྱོད་ཅག་གི་སྐྲའི་ཉག་མ་གཅིག་ལའང་གནོད་པ་མི་འབྱུང་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":35,"content":["ཕོལ་ལོལ་གྱིས་དེ་སྐད་གསུངས་པ་དང་བག་ལེབ་ཅིག་བླངས་ཏེ། མི་རྣམས་ཀྱི་མདུན་ནས་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས་ཤིང་དུམ་བུར་བྱས་ནས་ཟོས་པ༌དང༌།"]},{"type":"verse","number":36,"content":["མི་ཐམས་ཅད་ཀྱང་སེམས་བདེ་བར་གྱུར་ཏེ་བག་ལེབ་ཟོས།"]},{"type":"verse","number":37,"content":["ངེད་ཅག་གི་གྲུ་གཟིངས་ནང་དུ་བསྡོམས་པས་མི་ཉིས་བརྒྱ་དང་བདུན་ཅུ་དོན་དྲུག་ཡོད༌ཅིང༌།"]},{"type":"verse","number":38,"content":["ཁོ་རྣམས་ཀྱི་ལྟོ་བ་འགྲངས་རྗེས་གྲུ་གཟིངས་ཇེ་ཡང་དུ་གཏོང༌ཆེད། གྲུ་གཟིངས་ནང་གི་གྲོ་ནི་རྒྱ་མཚོའི་ནང་དུ་འཕངས་སོ།།"]},{"type":"verse","number":39,"content":["དེ་ནས་ནམ་ལངས་པ་ན་ཁོ་རྣམས་ཀྱིས་གནས་དེ་གང་ཡིན་མ་ཤེས་ཀྱང་བྱེ་མ་ཡོད་པའི་མཚོ་ཁུག་ཅིག་མཐོང་བ༌དང༌། གྲུ་གཟིངས་དེ་རུ་བསྐྱོད་ཐུབ་མིན་ལ་བལྟ་བར་གྲོས་བྱས་ཏེ་ཐག་བཅད་དོ།།"]},{"type":"verse","number":40,"content":["དེ་ནས་གཏིང་རྡོ་དག་བཀྲོལ་ནས་མཚོ་ནང་དུ་བསྐྱུར་བ་དང་མཉམ༌དུ། གྲུ་སྐྱའི་ཐག་པ་ལྷོད་ཅིང་གཡོར་མོ་བསྒྲེངས་ཏེ་རླུང་དང་བསྟུན་ནས་མཚོ་འགྲམ་གྱི་ཕྱོགས་སུ་བསྐྱོད་དོ།།"]},{"type":"verse","number":41,"content":["འོན༌ཀྱང༌། གློ་བུར་ཉིད་ལ་ཆུ་འཁོར་གཉིས་ཀྱི་བར་དུ་གྲུ་གཟིངས་བྱེ་འདམ་ནང་དུ་ཟུག་སྟེ། གྲུ་མགོ་འགུལ་རྒྱུ་མེད་པར་གྱུར་ཅིང་གྲུ་མཇུག་མཚོ་རླབས་དྲག་པོས་གཏོར་བའོ།།"]},{"type":"verse","number":42,"content":["དེ་ནས་བཙོན་པ་རྣམས་ཆུ་ལ་རྐྱལ་ནས་འབྲོ་བར་དོགས་ཏེ་དམག་མི་རྣམས་ཀྱིས་དེ་དག་གསོད་དགོས་པར་སྙམ་མོད།"]},{"type":"verse","number":43,"content":["འོན༌ཀྱང༌། བརྒྱ་དཔོན་གྱིས་ཕོལ་ལོལ་སྐྱོབ་བསམས་ནས་དམག་མི་དག་གི་ལྟ་ཚུལ་བཀག་སྟེ། ཆུ་ལ་རྐྱལ་ཤེས་པ་རྣམས་སྔོན་ལ་ཆུའི་ནང་དུ་མཆོངས་ནས་སྐམ་སར་འགྲོ་བ༌དང༌།"]},{"type":"verse","number":44,"content":["གཞན་རྣམས་ཤིང་ལེབ་དང་གྲུའི་སྟེང་གི་བཀོལ་ཐུབ་པའི་དངོས་པོ་རྩག་རྩིག་ལ་བརྟེན་ནས་སྐམ་སར་འགྲོ་དགོས་པའི་བཀའ་གནང༌བས། ངེད་ཐམས་ཅད་དེ་ལྟར་ཉེན་ཁ་ལས་ཐར་ཏེ་སྐམ་སར་སོང༌ངོ༌།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ACT/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/26.json","previousChapterAudioLinks":{},"numberOfVerses":44}