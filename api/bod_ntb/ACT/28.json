{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":28,"content":[{"type":"heading","content":["ཕོལ་ལོལ་དང་བཅས་པ་མཱལ་ཏ་གླིང་ཕྲན་དུ་འབྱོར༌བ།"]},{"type":"verse","number":1,"content":["ངེད་རྣམས་ཉེན་ཁ་ལས་ཐར་བ་དང་ད་གཟོད་གླིང་ཕྲན་དེའི་མིང་ལ་མཱལ་ཏ་ཞེས་ཟེར་བ་ཤེས་སོ།།"]},{"type":"verse","number":2,"content":["གླིང་ཕྲན་དེའི་ཡུལ་མི་རྣམས་ཀྱིས་ངེད་ཅག་ལ་དགའ་བསུ་ཆེན་པོ༌བྱས་ཤིང་། དུས༌དེར། ཆར་བ་བབས་པ་དང་གནམ་གཤིས་ཀྱང་འཁྱགས་པས་མི་དེ་རྣམས་ཀྱིས་མེ་སྦར་ནས་ངེད་ཅག་ལ་སྣེ་ལེན་བྱས་སོ།།"]},{"type":"verse","number":3,"content":["སྐབས༌དེར། ཕོལ་ལོལ་གྱིས་མེ་ཤིང་ཕོན་པོ་ཞིག་བླངས་ནས་མེའི་སྟེང་དུ་བཞག་པ་དང་། དུག་སྦྲུལ་ཞིག་ཚ་བས་མ་བཟོད་པར་ཕྱིར་ཐོན་ཏེ་ཁོང་གི་ཕྱག་ལ་སོ་བཏབ་ནས་འབྱར་བ་རེད།"]},{"type":"verse","number":4,"content":["ཡུལ་མི་རྣམས་ཀྱིས་དུག་སྦྲུལ་དེ་ཁོང་གི་ཕྱག་ནས་མར་དཔྱངས་ཡོད་པ་མཐོང་སྟེ་ཕན་ཚུན་ན༌རེ། མི་འདི་ནི་ལག་དམར་ཞིག་ཡིན་པར་གདོན་མི་ཟ༌སྟེ། ཁོ་རང་རྒྱ་མཚོ་ལས་ཐར་ནའང་བདེན་ལུགས་ཀྱིས་ཁོ་རང་གསོན་དུ་མི་འཇུག་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":5,"content":["འོན༌ཀྱང༌། ཕོལ་ལོལ་གྱིས་དུག་སྦྲུལ་དེ་མེའི་ནང་དུ་གཡུགས་ཤིང་རང་ལ་གནོད་པ་ཅི་ཡང་མ་བྱུང༌བ་རེད།"]},{"type":"verse","number":6,"content":["ཡུལ་མི་རྣམས་ཀྱིས་ཁོང་གི་ལུས་པོ་སྐྲངས༌པའམ། ཡང་ན་གློ་བུར་ས་ལ་འགྱེལ་ནས་འཆི་ངེས་པར་སྙམ༌ཞིང༌། ཡུན་རིང་ལ་བལྟས་ཀྱང་ཁོང་ལ་གནོད་པ་ཅི་ཡང་མེད་པ་མཐོང༌རྗེས། བློ་འགྱུར་ནས་ཁོང་ནི་ལྷ་ཞིག་རེད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":7,"content":["གནས་དེ་དང་ཐག་མི་རིང་བའི་སར། གླིང་ཕྲན་འདིའི་འགོ་དཔོན་ཕུབ་ལེ་ཨོ་བྱ་བའི་ས་ཞིང་ཞིག་ཡོད༌ཅིང༌། ཁོས་ངེད་ཅག་བསུས་ཏེ་ཉིན་གསུམ་ལ་སྣེ་ལེན་གཟབ་རྒྱས་བྱས།"]},{"type":"verse","number":8,"content":["དུས༌དེར། ཕུབ་ལེ་ཨོ་ཡི་ཕ་ལ་ཚ་ནད་དང་བཤལ་ནད་བྱུང་སྟེ་ཉལ་ཡོད༌པས། ཕོལ་ལོལ་ཁྱིམ་ནང་དུ་ཕེབས་ནས་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ༌ཅིང༌། ཁོའི་ལུས་ལ་ཕྱག་ཟུང་བཞག་སྟེ་ནད་གསོས་སོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་གླིང་ཕྲན་སྟེང་གི་ནད་པ་གཞན་རྣམས་ཀྱང་ཡོང་བ་དང་ནད་ལས་ཐར་བ་རེད།"]},{"type":"verse","number":10,"content":["མི་དེ་རྣམས་ཀྱིས་གང་ཅིའི་ཐད་ནས་ངེད་ཅག་ལ་གུས་པ་བྱས་ཤིང༌། གྲུ་གཟིངས་སྐྱོད་རན་པའི་དུས་སུའང་ངེད་ཅག་ལ་མཁོ་བ་ཐམས་ཅད་གྲུའི་ནང་དུ་བསྐྱལ་ཡོང༌ངོ༌།།"]},{"type":"heading","content":["རོ་མཱ་གྲོང་ཁྱེར་དུ་སླེབས༌པ།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཟླ་བ་གསུམ་འགོར༌རྗེས། ངེད་རྣམས་ཨ་ལིག་སན་དྲི་ཡཱ་ཡི་གྲུ་གཟིངས་ལ་བསྡད་དེ་སོང་བ་ཡིན། གྲུ་དེའི་གྲུ་མགོར་ལྷའི་བུ་མཚེ་མ་",{"noteId":20},"ཞེས་པའི་རྟགས་བཀོད༌ཡོད། དགུན་ཁར་གྲུ་གཟིངས་དེ་གླིང་ཕྲན་འདི་རུ་བསྡད་ཅིང་།"]},{"type":"verse","number":12,"content":["དེ་ནས་སི་ར་ཀུར་སླེབས་ནས་ཉིན་གསུམ་ལ་བསྡད་དོ།།"]},{"type":"verse","number":13,"content":["ཡང་དེ་ནས་མཚོ་ལམ་བརྒྱུད་དེ་རཱ་ག་ཨུམ་དུ་སླེབས་ནས་ཉིན་གཅིག་ལ་བསྡད་པ་དང་ལྷོ་རླུང་གཡུགས༌པས། དེའི་ཕྱི༌ཉིན་ཕུ་ཏོ་ལེ་རུ་ཕྱིན་པ་རེད།"]},{"type":"verse","number":14,"content":["གནས་དེར་སྤུན་ཟླ་རྣམས་དང་ཕྲད་ཅིང་ཁོ་རྣམས་ཀྱི་གདན་ཞུ༌ལྟར། ངེད་རྣམས་ཉིན་བདུན་ལ་ཁོ་རྣམས་དང་མཉམ་དུ་བསྡད་རྗེས་རོ་མཱ་ཡི་ལམ་ལ་ཆས་སོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་རོ་མཱ་ཡི་སྤུན་ཟླ་རྣམས་ཀྱིས་ངེད་ཅག་གི་གནས་ཚུལ་ཐོས༌ཏེ། ཨ་ཕེ་ཨོ་ཁྲོམ་ར་དང་མགྲོན་ཁང་གསུམ་ཞེས་པའི་གནས་སུ་ཡོང་ནས་ངེད་ཅག་ལ་བསུ་བ་བྱས། དེ་ནས་ཕོལ་ལོལ་གྱིས་མི་དེ་རྣམས་མཐོང་སྟེ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས་པ་དང་བློ་སེམས་བདེ་ཞིང་སྤོབས་པ་དང་ལྡན་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་རོ་མཱ་གྲོང་ཁྱེར་དུ་སླེབས་པ་དང་ཕོལ་ལོལ་ལ་ཆོག་མཆན་ཐོབ་སྟེ། སྲུང་དམག་གཅིག་དང་མཉམ་དུ་མི་སྒེར་གྱི་ཁང་པ་ཞིག་ལ་སྡོད་དུ་བཅུག༌གོ།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་རོ་མཱ་གྲོང་ཁྱེར་དུ་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཉིན་གསུམ་འགོར༌རྗེས། ཕོལ་ལོལ་གྱིས་ཡ་ཧུ་དཱ་པའི་དཔོན་རིགས་རྣམས་བོས་ཤིང་དེ་རྣམས་ལྷན་དུ་འདུས་ཚེ་འདི་སྐད༌དུ། སྤུན་ཟླ༌རྣམ་པ། ངས་རང་རེའི་ཡུལ་གྱི་མི་རྣམས་དང་བདག་ཅག་གི་ཕ་མེས་ཀྱི་ལུགས་སྲོལ་དང་འགལ་བའི་ལས་ཅི་ཡང་མ་བྱས༌ཀྱང༌། ང་རང་ཡེ་རུ་སཱ་ལེམ་ནས་བཙོན་དུ་བཅུག་ཅིང་རོ་མཱ་པའི་ལག་ཏུ་སྤྲད་པ༌དང༌།"]},{"type":"verse","number":18,"content":["ང་རང་ལ་སྲོག་ཆད་གཅོད་དགོས་པའི་ཉེས་པ་ཅི་ཡང་མེད༌པས། དེ་དག་གིས་འདྲི་གཅོད་བྱས་རྗེས་ང་རང་བཙོན་ལས་དགྲོལ་བར་བསམས༌ནའང༌།"]},{"type":"verse","number":19,"content":["ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་དོན་དེར་དགྲ་བྱས༌པས། ངས་ཀྱང་སེ་བཟིར་ལ་གཏུག་བཤེར་མི་ཞུ་ཀ་མེད༌བྱུང༌། འོན༌ཀྱང༌། རང་གི་མི་རིགས་གཏུག་བཤེར་བྱེད་པའི་དོན་ཅི་ཡང༌མེད་དོ།།"]},{"type":"verse","number":20,"content":["དེའི༌ཕྱིར། ངས་ཁྱོད་རྣམས་བོས་ཏེ་ཁ་རི་ཁ་ཐུག་ཏུ་གཏམ་སྨྲ་བར་འདོད། སྤྱིར་ང་རང་ནི་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱི་རེ་བ་དེའི་ཆེད་དུ་ལྕགས་སྒྲོག་གིས་བཀྱིགས་པ་ཡིན་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":21,"content":["དེ་རྣམས་ན༌རེ། ངེད་ཅག་ལ་ཡ་ཧུ་དཱའི་ཡུལ་ནས་ཁྱོད་ཀྱི་སྐོར་གླེང་བའི་འཕྲིན་ཡིག་མ་འབྱོར༌ལ། གནས་འདིར་ཡོང་བའི་སྤུན་ཟླ་གཞན་གྱིས་ཀྱང་ཁྱོད་ཀྱི་སྐོར་ལ་གཏམ་ངན་སྨྲས་པ་མེད།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་ངེད་རྣམས་ཀྱིས་ད་ལྟ་ཁྱོད་ཀྱི་བསམ་འཆར་ག་འདྲ་ཡིན་པར་མཉན་འདོད༌དེ། རྒྱུ་མཚན་ནི་ཆོས་ལུགས་གྲུབ་མཐའ་དེ་ལ་ཡུལ་ཀུན་གྱི་མི་རྣམས་ཀྱིས་དམའ་འབེབས་བྱེད་བཞིན་ཡོད་པ་ངེད་ཅག་གིས་ཤེས་པ་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":23,"content":["དེ་ནས་དཔོན་རིགས་རྣམས་ཀྱིས་ཕོལ་ལོལ་དང་ཉི་ཆད་བགོས༌ཤིང༌། ཉིན་དེར་མི་མང་པོའང་ཁོང་གི་ཤག་ཏུ་ཡོང་བ༌དང༌། ཕོལ་ལོལ་གྱིས་ཞོགས་པའི་དུས་ནས་མཚན་མོའི་བར་དུ་དོན་རྣམས་འགྲེལ་ཞིང་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ལ་བདེན་དཔང་བྱས་པ༌དང༌། མོ་ཤེའི་བཀའ་ཁྲིམས་དང་ལུང་སྟོན་པ་རྣམས་ཀྱི་མདོ་ལས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐོར་གྱི་ཆོས་གསུངས་ཏེ་ཁོ་རྣམས་ལ་སྐུལ་མ་མཛད་དོ།།"]},{"type":"verse","number":24,"content":["ཁོང་གི་གསུང་དེར་ལ་ལ་ཡིད་ཆེས་ཤིང་ལ་ལ་ཡིད་མ་ཆེས་སོ།།"]},{"type":"verse","number":25,"content":["དེ་རྣམས་ཕན་ཚུན་ལྟ་བ་མ་མཐུན་པར་སོ་སོར་གྱེས༌ཤིང༌། སོ་སོར་མ་གྱེས་པའི་སྔོན་ལ་ཕོལ་ལོལ་གྱིས་འདི་སྐད༌དུ། དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་བརྒྱུད་ནས་ཁྱོད་ཅག་གི་ཕ་མེས་ལ་ལེགས་པར་གསུངས༌ཤིང༌།"]},{"type":"verse","number":26,"content":["འདི་སྐད༌དུ།",{"text":"ཁྱོད་ཀྱིས་མི་རྣམས་དེ་ལ་འདི་ལྟར༌ཤོད།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཚོས་རྣ་བས་ཐོས་ཀྱང་དོན་མི༌རྟོགས།།","poem":1},{"lineBreak":true},{"text":"འདྲེན་བྱེད་མིག་གིས་མཐོང་ཡང་ཤེས་མི༌འགྱུར།།","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"དེ་རྣམས་སེམས་ནི་གྱོང་པོར་གྱུར་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"རྣ་བས་མི་མཉན་མིག་ཟུང་བཙུམས་པས༌སོ།།","poem":1},{"lineBreak":true},{"text":"དེ་ལྟར་མིན་ཚེ་མིག་གིས་མཐོང་བ་དང་༎","poem":1},{"lineBreak":true},{"text":"རྣ་བས་ཐོས༌ཤིང་བློ་ཡིས་རྟོགས་པ་དང་༎","poem":1},{"lineBreak":true},{"text":"ཕྱིར་དུ་འཁོར་ནས་ངས་ཀྱང་དེ་རྣམས་ནི༎","poem":1},{"lineBreak":true},{"text":"གསོ་ཞིང་དྲག་པར་བྱེད་པ་ཡིན་ལགས་སོ༎","poem":1},"ཞེས༌པའོ།།"]},{"type":"verse","number":28,"content":["དེའི༌ཕྱིར། དཀོན་མཆོག་གི་ཐར་པའི་ཆོས་འདི་ནི་ད་ལྟ་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་གསུངས༌ཤིང༌། དེ་རྣམས་ཀྱིས་ཀྱང་མཉན་ཞིང་དང་དུ་ལེན་ངེས་པ་ཁྱོད་ཅག་གིས་ཤེས་དགོས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":29,"content":["ཁོང་གིས་དེ་སྐད་གསུངས་པ་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་དོན་དེར་རྩོད་གླེང་ཆེན་པོ་བྱེད་བཞིན་སོང༌ངོ༌།།"]},{"type":"verse","number":30,"content":["དེ་ནས་ཕོལ་ལོལ་མཆོག་རང་གིས་གླས་པའི་ཁང་པ་ནས་ལོ་གཉིས་ཏག་ཏག་ལ་བཞུགས༌ཤིང༌། རང་གི་ཁང་པའི་ནང་དུ་ཡོང་བའི་མི་ཐམས་ཅད་ལ་སྣེ་ལེན་བྱས་པ༌དང༌།"]},{"type":"verse","number":31,"content":["སྙིང་རུས་བསྐྱེད་ནས་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་ཆོས་བསྒྲགས་པ༌དང༌། གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་སྐོར་གསུངས་པ་ལ་བར་ཆད་ཅི་ཡང་མ་བྱུང༌ངོ༌།། །།"]}],"footnotes":[{"noteId":20,"caller":"+","text":"འདིར་བརྗོད་པའི་ལྷའི་བུ་མཚེ་མ་ཞེས་པ་ནི་མ་ཕྱི་ལས་ཏོའོ་སི་ཀེའོ་ཞེས་མཐོང་། དེ་ནི་གནའ་བོའི་གྷི་རིག་པའི་ལྷ་སྒྲུང་ནང་གི་ལྷ་ཆེན་པོ་བཟོའུ་ཟི་ཞེས་བྱ་བའི་བུ་མཚེ་མ་སྟེ་ཁཱ་སི་དིར་དང་ཕོལ་ལག་གཉིས་ཡིན།","reference":{"chapter":28,"verse":11}}]},"thisChapterLink":"/api/bod_ntb/ACT/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/27.json","previousChapterAudioLinks":{},"numberOfVerses":31}