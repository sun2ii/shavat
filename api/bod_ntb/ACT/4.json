{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ACT","translationId":"bod_ntb","name":"མཛད་འཕྲིན།","commonName":"མཛད་འཕྲིན།","title":"༄༅། །སྐུ་ཚབ་པ་རྣམས་ཀྱི་མཛད་འཕྲིན།","order":44,"numberOfChapters":28,"sha256":"0f7fa377b358a15e2719d8cb38f4b3169de36390311be24cfcf009533c06c046","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":4,"content":[{"type":"heading","content":["སྐུ་ཚབ་པ་པེ་ཏྲོ་དང་ཡོ་ཧ་ནན་གཉིས་ལ་འདྲི་དཔྱོད་བྱས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སྐུ་ཚབ་པ་པེ་ཏྲོ་དང་ཡོ་ཧ་ནན་གཉིས་ཀྱིས་མི་རྣམས་ལ་དེ་ལྟར་བརྗོད་པའི་དུས༌སུ། མཆོད་དཔོན་རྣམས་དང་མཆོད་ཁང་གི་སྲུང་དམག་འགོ་དཔོན༌དང༌། སཱ་ཅུ་སེ་པ་དག་ཀྱང་ཁོང་གཉིས་ཀྱི་དྲུང་དུ་སླེབས༌པ་རེད།"]},{"type":"verse","number":2,"content":["ཁོང་གཉིས་ཀྱིས་མི་རྣམས་ལ་ཆོས་གསུངས༌ཤིང༌། སྐྱབས་མགོན་ཡེ་ཤུར་བརྟེན་ནས་གཤིན་པོ་རྣམས་སླར་གསོན་པར་འགྱུར་བའི་དོན་དེ་བསྒྲགས༌པས། དཔོན་རིགས་རྣམས་སུན་སྣང་ཆེན་པོ་སྐྱེས༌ཏེ།"]},{"type":"verse","number":3,"content":["ཁོང་གཉིས་བཟུང་ཞིང་མཚན་མོའི་དུས་ལ་སླེབས་པས་ཕྱི་ཉིན་བར་དུ་བཙོན་ལ་བཅུག་གོ།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་ཆོས་ལ་ཉན་མཁན་རྣམས་ལས་མི་མང་པོ་དད་པར་གྱུར༌ཏེ། དད་ལྡན་པ་སྐྱེས་པའི་གྲངས་ནི་ལྔ་སྟོང་ཙམ་ལ་སླེབས༌སོ།།"]},{"type":"verse","number":5,"content":["དེའི་ཕྱི༌ཉིན། འགོ་དཔོན་དང་རྒན༌པོ། མཁན་པོ་བཅས་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་འདུས༌ཤིང༌།"]},{"type":"verse","number":6,"content":["མཆོད་དཔོན་ཆེན་པོ་ཨ་ནཱ་སི༌དང༌། ཀ་ཡ༌ཕཱ། ཡོ་ཧ༌ནན། ཨ་ལིག་སན་དིར་བཅས༌དང༌། མཆོད་དཔོན་ཆེན་པོའི་ཉེ་འབྲེལ་གཞན་རྣམས་ཀྱང་གནས་དེར་ཡོད༌པ་རེད།"]},{"type":"verse","number":7,"content":["དེ་དག་གིས་སྐུ་ཚབ་པ་ཁོང་གཉིས་དཀྱིལ་དབུས་སུ་བསླངས༌ཏེ། ཁྱོད་གཉིས་ཀྱིས་དབང་གང༌ངམ། ཡང་ན་སུའི་མིང་ལ་བརྟེན་ནས་དོན་འདི་བྱས་པ་ཡིན་ནམ་ཞེས་དྲིས་སོ།།"]},{"type":"verse","number":8,"content":["དེ་ནས་པེ་ཏྲོ་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱབ་པར་གྱུར་ཏེ་འདི་སྐད་དུ། འབངས་མི་སེར་གྱི་འགོ་དཔོན་དང་རྒན་པོ༌རྣམས།"]},{"type":"verse","number":9,"content":["དེ་རིང་ངེད་གཉིས་ཀྱིས་དབང་བོ་སྐྱོན་ཅན་གྱི་ལུས་སྟེང་དུ་བསྒྲུབས་པའི་དོན་བཟང་གི་རྐྱེན་གྱིས། མི་འདི་ཅི་ལྟར་སོས་པར་རྩད་གཅོད་བྱེད་ན།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཅག་གི་མིག་མདུན་དུ་ལངས་ནས་སྡོད་པའི་མི་འདི༌ནི། ཁྱོད་ཅག་གིས་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པ༌དང༌། དཀོན་མཆོག་གིས་གྲོངས་པ་ནས་སླར་གསོན་པར་མཛད་པའི་ནཱ་ཙ་རེལ་པ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་མཚན་ལ་བརྟེན་ནས་ལུས་ཁམས་བདེ་བར་གྱུར་པ་ཁྱོད་ཅག་དང་བཅས་པའི་ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཀྱིས་ཤེས་དགོས་སོ།།"]},{"type":"verse","number":11,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི། ཁྱོད་ཅག་བཟོ་བ་རྣམས་ཀྱིས་སྤངས་པའི་རྡོ་ནི་ཁང་པའི་ཟུར་གྱི་རྨང་རྡོར་གྱུར་ཅེས་པ་དེ་ཡིན།"]},{"type":"verse","number":12,"content":["ཁོང་ཉིད་ལས་གཞན་ཐར་པ་མེད་དེ། རྒྱུ་མཚན་ནི་གནམ་འོག་ཀུན་ཏུ་ཁོང་ལས་གཞན་བདག་ཅག་ཐར་བར་མཛད་ནུས་པའི་མིང་ཞིག་མིའི་རིགས་ལ་གནང་མེད་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":13,"content":["དེ་ནས་དཔོན་རིགས་རྣམས་ཀྱིས་པེ་ཏྲོ་དང་ཡོ་ཧ་ནན་གཉིས་ཀྱི་སྤོབས་པ་མཐོང་བ༌དང༌། ཡང་ཁོང་གཉིས་ནི་རིག་པ་མ་བསླབས་པ་དང་མི་སེར་ཡིན་པ་ཤེས་ནས་ངོ་མཚར་བར་གྱུར་ཅིང༌། དེ་གཉིས་སྐྱབས་མགོན་ཡེ་ཤུ་དང་ལྷན་དུ་འགྲོགས་མྱོང་བའང་གསལ་པོར་རྟོགས་སོ།།"]},{"type":"verse","number":14,"content":["ཡང་ནད་གསོས་པའི་མི་དེའང་ཁོང་གཉིས་ཀྱི་གམ་དུ་ལངས་སྡོད་པ་མཐོང༌སྟེ། དེ་དག་གིས་སྐྱོན་ཅི་ཡང་བརྗོད་མ་ནུས་སོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཁོང་གཉིས་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་ར་ལས་ཕྱིར་ཕུད་ཅིང་ན༌རེ།"]},{"type":"verse","number":16,"content":["བདག་ཅག་གིས་མི་འདི་གཉིས་ལ་ཅི༌བྱའམ། ཁོ་གཉིས་ཀྱིས་དངོས་གནས་ངོ་མཚར་བའི་མཛད་པ་མངོན་གསལ་དུ་བསྟན༌ཅིང་། ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་མི་ཐམས་ཅད་ཀྱིས་ཀྱང་དོན་དེ་ཤེས་པས་བདག་ཅག་གིས་དེ་ལྟར་མ་བྱུང་ཟེར་མི་ནུས།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང་དོན་འདི་དམངས་ཁྲོད་དུ་སྔར་ལས་ལྷག་པར་ཁྱབ་ཉེན་ཡོད་པས། ཁོ་གཉིས་ལ་ཕྱིན་ཆད་མི་དེའི་མིང་ལ་བརྟེན་ནས་མི་གཞན་ལ་གླེང་མོལ་མི་བྱེད་པའི་ཕྱིར་ནན་གྱིས་བསྐུལ་བར་བྱའོ་ཞེས་ཕན་ཚུན་གྲོས་བསྡུར་བྱས་སོ།།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཁོང་གཉིས་བོས༌ཏེ། ཡེ་ཤུའི་མིང་ལ་བརྟེན་ནས་མི་གཞན་ལ་ནམ་ཡང་གླེང་མོལ་བྱེད་པའམ་ཆོས་གསུང་མི་ཆོག་པའི་བཀའ་བབས༌པ་རེད།"]},{"type":"verse","number":19,"content":["འོན༌ཀྱང༌། པེ་ཏྲོ་དང་ཡོ་ཧ་ནན་གཉིས་ཀྱིས་འདི་སྐད་དུ། དཀོན་མཆོག་གི་བཀའ་ལ་མི་ཉན་པར་ཁྱོད་ཅག་གི་གཏམ་ལ་ཉན་པ་ནི་དཀོན་མཆོག་གི་སྤྱན་སྔར་འོས་འཚམ་ཡིན་མིན་ཁྱོད་ཅག་གིས་སོམས༌ཤིག"]},{"type":"verse","number":20,"content":["ངེད་གཉིས་ཀྱིས་གང་ཞིག་མཐོང་ཞིང་ཐོས་པ་ཐམས་ཅད་མི་བཤད་ཐབས་མེད་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":21,"content":["དེ་ནས་དཔོན་རིགས་རྣམས་ཀྱིས་ཁོང་གཉིས་ལ་ཡང་བསྐྱར་འཇིགས་བསྐུལ་རྗེས་ཕྱིར་བཏང༌། རྒྱུ་མཚན་ནི་མི་རྣམས་ཀྱིས་དོན་ངོ་མཚར་ཅན་དེ་མཐོང་ནས་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་ཕུལ་བས་དཔོན་རིགས་རྣམས་ཀྱང་མི་རྣམས་ལ་འཇིགས་པ་དང་ཁོང་གཉིས་ལ་ཉེས་ཆད་གཅོད་པའི་རྒྱུ་ཡང་མ་རྙེད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":22,"content":["ངོ་མཚར་བའི་ལས་ཀྱིས་གསོས་པའི་མི་དེ་ནི་ལོ་བཞི་བཅུ་ལྷག་ལ་སོན་པ་ཞིག་ཡིན༌ནོ།།"]},{"type":"heading","content":["དད་ལྡན་རྣམས་ཀྱི་གསོལ༌འདེབས།"]},{"type":"verse","number":23,"content":["དེ་ནས་པེ་ཏྲོ་དང་ཡོ་ཧ་ནན་གཉིས་ཕྱིར་བཏང་བ་དང་ཆོས་གྲོགས་རྣམས་ཀྱི་གམ་དུ་ཕྱིན༌ཏེ། མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་ཀྱིས་ཅི་སྨྲས་པ་ཐམས་ཅད་ཁོ་རྣམས་ལ་སྨྲས་སོ།།"]},{"type":"verse","number":24,"content":["ཁོ་རྣམས་ཀྱིས་ཀྱང་གཏམ་དེ་ཐོས་ནས་བློ་སེམས་གཅིག་མཐུན་སྒོས་སྐད་གསང་མཐོན་པོས་དཀོན་མཆོག་ལ་འདི་སྐད༌དུ། ཀྱེ། གཙོ་བོ༌ལགས། ཁྱེད་ནི་ནམ་མཁའ་དང་ས་གཞི་རྒྱ་མཚོ་བཅས་པ་དང་དེ་དག་ཏུ་ཡོད་པ་ཐམས་ཅད་འགོད་མཁན་ལགས།"]},{"type":"verse","number":25,"content":["ཁྱེད་ཀྱིས་དམ་པའི་ཐུགས་ཉིད་ཀྱི་སྒོ་ནས་ཉིད་ཀྱི་ཞབས་ཕྱི་པ༌སྟེ། ངེད་ཅག་གི་མེས་པོ་དཱ་བིད་ཀྱི་ངག་བརྒྱུད་ནས་ཇི་སྐད༌དུ།",{"text":"ཅིའི་ཕྱིར་ཕྱི་ཕྱོགས་པ་རྣམས་འཁོན་ཅིང༌འཛིང༌།།","poem":1},{"lineBreak":true},{"text":"ཅིའི་ཕྱིར་མི་རྣམས་དོན་མེད་ཐབས་ལ༌འཇུག །","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"དེ་ཡང་གཙོ་བོ་དཀོན་མཆོག་ཁོང་ཉིད༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་བསྐོས་པའི་སྐྱབས་མགོན་མཱ་ཤི༌ཀར།།","poem":1},{"lineBreak":true},{"text":"རྒོལ་ཕྱིར་འཇིག་རྟེན་སྐྱོང་བའི་རྒྱལ་པོ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"མངའ་བདག་དཔོན་རིགས་རྣམས་ཀྱང་ལྷན་དུ༌འདུས།།","poem":1},"ཞེས་གསུངས་མྱོང༌ངོ༌།།"]},{"type":"verse","number":27,"content":["དེ་བཞིན་ཧེ་རོ་དཱ་དང་ཕོན་ཏིའུ་པི་ལ༌ཏུ། ཕྱི་ཕྱོགས་པ་དང་ཡེས་ར་ཨེལ་གྱི་མི་དང་བཅས་པ་དངོས་གནས་གྲོང་ཁྱེར་འདིར་འདུས་ཏེ་ཁྱེད་ཀྱིས་བྱུགས་པའི་ཞབས་ཕྱི་དམ་པ་ཡེ་ཤུ་ལ་རྒོལ༌བཞིན་ནོ།།"]},{"type":"verse","number":28,"content":["དེ་ནི་ཁྱེད་ཀྱི་དབང་དང་ཐུགས་དགོངས་ཀྱིས་དོན་ཆེན་གང་དེ་སྔར་ནས་འབྱུང་བར་ཐག་གིས་བཅད་པ་བཞིན་དེ་རྣམས་ཀྱིས་ཀྱང་འགྲུབ་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["ད་ལྟ་དེ་རྣམས་ཀྱིས་ངེད་ཅག་ལ་འཇིགས་བསྐུལ་བས་གཙོ་བོ་ཁྱེད་ཀྱིས་གཟིགས་པར༌ཞུ། ཁྱེད་ཀྱིས་རང་གི་ཞབས་ཕྱི་པ་ངེད་རྣམས་ལ་ཁྱེད་ཀྱི་བཀའ་སྒྲོག་པའི་སྤོབས་པ་གནང་བ༌དང༌།"]},{"type":"verse","number":30,"content":["ཕྱག་བརྐྱངས་ནས་ནད་རིགས་སྣ་ཚོགས་འཇོམས༌ཤིང༌། གྲུབ་རྟགས་དང་ངོ་མཚར་ཅན་གྱི་དོན་རྣམས་རང་གི་ཞབས་ཕྱི་དམ་པ་ཡེ་ཤུའི་མཚན་ལ་བརྟེན་ནས་འགྲུབ་པར་ཤོག་ཅེས་གསོལ་བ་བཏབ་བོ།།"]},{"type":"verse","number":31,"content":["ཁོ་རྣམས་ཀྱིས་དེ་ལྟར་གསོལ་བ་བཏབ་རྗེས་འཚོགས་སའི་གནས་དེ་གཡོ་བར་གྱུར་པ་དང༌། མི་དེ་ཐམས་ཅད་ལའང་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱབ་པར་གྱུར་པས་སྤོབས་པ་བསྐྱེད་ནས་དཀོན་མཆོག་གི་བཀའ་བསྒྲགས༌སོ།།"]},{"type":"heading","content":["དད་ལྡན་པ་སྤྱི་ལ་དབང་བའི་ནོར༌རྫས།"]},{"type":"verse","number":32,"content":["དེ་ཡང་དད་ལྡན་དེ་ཐམས་ཅད་བློ་སེམས་གཅིག་མཐུན་ཡིན་པ༌དང༌། སུས་ཀྱང་རང་གི་རྒྱུ་རྫས་རང་ཉིད་ཀྱི་ཡིན་མི་ཟེར་བར་དེ་ཐམས་ཅད་སྤྱི་གཞུང་གིས་སྤྱོད༌པ་རེད།"]},{"type":"verse","number":33,"content":["སྐུ་ཚབ་པ་རྣམས་ཀྱིས་ནུས་མཐུ་ཆེན་པོའི་ངང་ནས་གཙོ་བོ་ཡེ་ཤུ་སླར་གསོན་པའི་དོན་དེ་ལ་བདེན་དཔང་བྱས་པ༌དང༌། མི་ཐམས་ཅད་ལའང་ཐུགས་རྗེ་ཆེན་པོ་ཐོབ།"]},{"type":"verse","number":34,"content":["ཡང་ཁོ་རྣམས་ཀྱི་ཁྲོད་དུ་དབུལ་པོ་གཅིག་ཀྱང་མེད༌དེ། རྒྱུ་མཚན་ནི་རང་ལ་དབང་བའི་ས་ཞིང་དང་ཁང་པ་ཐམས་ཅད་བཙོངས༌ཏེ་རིན་དོད་ཚང་མ་ཁྱེར་ཡོང་ནས།"]},{"type":"verse","number":35,"content":["སྐུ་ཚབ་པ་རྣམས་ཀྱི་ཞབས་དྲུང་དུ་བཞག་པ༌དང༌། ཁོང་རྣམས་ཀྱིས་ཀྱང་སུ་ཞིག་ལ་དགོས་མཁོ་ཡོད་ན་དེ་བཞིན་སོ་སོར་བགོས་སོ།།"]},{"type":"verse","number":36,"content":["གནས་དེར་མིང་ལ་ཡོ་སེབ་བྱ་བ་ཀིབ་རིས་ནས་སྐྱེས་པའི་ལེ་ཝི་པ་ཞིག་ཡོད་པ་ལ་སྐུ་ཚབ་པ་རྣམས་ཀྱིས་པཱར་ན་པཱ་ཞེས་འབོད་ཅིང་། དོན་ནི་སེམས་གསོ་མཁན་ཞེས༌པ་ཡིན།"]},{"type":"verse","number":37,"content":["ཁོ་ལ་ས་ཞིང་ཡོད་པའང་བཙོངས་ཏེ་རིན་ཚང་མ་སྐུ་ཚབ་པ་རྣམས་ཀྱི་ཞབས་དྲུང་དུ་བཞག་གོ།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ACT/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ACT/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ACT/3.json","previousChapterAudioLinks":{},"numberOfVerses":37}