{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"AMO","translationId":"bod_ntb","name":"ཨ་མོ་སི།","commonName":"ཨ་མོ་སི།","title":"༄༅། །ལུང་སྟོན་པ་ཨ་མོ་སིའི་མདོ།","order":30,"numberOfChapters":9,"sha256":"78ed2104ac86fc1164a277ff56010aa2413514f866b0490a6edc1fc78f090e70","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bod_ntb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["སྐྱོ་གླུ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད། ངས་ཁྱོད་ཀྱི་དོན་དུ་བརྩམས་པའི་སྐྱོ་གླུ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":2,"content":["བུ་མོ་གཙང་མ་དང་འདྲ་བའི་ཡེས་ར་ཨེལ་སར་འགྱེལ་ཏེ། སླར་ཡང་ལང་བར་མི་འགྱུར་ཞིང་། མོ་རང་གི་ས་རུ་བསྐྱུར་ན་ཡང་། ཡར་སྐྱོར་མཁན་སུ་ཡང་མེད།"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། གཙོ་བོ་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་སྐོར་ལ་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་མི་རིགས་ཀྱི་གྲོང་ཁྱེར་ལས་དམག་ཆིག་སྟོང་མངགས་ཀྱང་བརྒྱ་མ་གཏོགས་མ་ལུས་ཤིང་། བརྒྱ་མངགས་པ་ལས་བཅུ་མ་གཏོགས་མ་ལུས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་འདི་སྐད་གསུངས་ཏེ། ང་ཚོལ་དང་ཁྱོད་རང་གསོན་པར་འགྱུར།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་པེད་ཨེལ་དུ་རོགས་རམ་མ་བཙལ། གིལ་གལ་དུ་མ་འགྲོ། པེར་ཤ་བཱ་རུ་ཕར་མ་འགྲོ་ཞིག ཅིའི་ཕྱིར་ཞེ་ན། གིལ་གལ་ལ་འཕྲོག་བཅོམ་ཐེབས་ངེས་ཤིང་། པེད་ཨེལ་ནི་མེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":6,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཚོལ་དང་གསོན་པར་འགྱུར། དེ་མིན་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ནི་མེ་ལྟར་ཡོ་སེབ་ཀྱི་ཁྱིམ་རྒྱུད་ཡོངས་སུ་ཁྱབ་ནས་དེ་དག་རྩ་མེད་དུ་བཏང་སྟེ། མི་སུས་ཀྱང་པེད་ཨེལ་གྱི་མེ་གསོད་མི་ཐུབ་བོ། །"]},{"type":"verse","number":7,"content":["དྲང་གཞག་མཁན་པར་བསྒྱུར་ཞིང་། དྲང་བདེན་ས་ལ་འདོར་མཁན་ཁྱོད་རྣམས།"]},{"type":"verse","number":8,"content":["སྨིན་དྲུག་དང་རྔོན་པའི་སྐར་མ་མཛད་མཁན་དང་། སྨག་རུམ་ཐོ་རངས་སུ་སྒྱུར་མཁན་དང་། ཉིན་མོ་མཚན་དུ་མཛད་མཁན་དང་། ཡང་རྒྱ་མཚོར་བཀའ་བབས་ཏེ་རྒྱ་མཚོ་ས་ངོས་སུ་གཏོང་མཁན་ཁོང་གི་མཚན་ནི་ཡ་ཝཱེ་ལགས་སོ། །"]},{"type":"verse","number":9,"content":["ཁོང་གིས་སྟོབས་ལྡན་རྣམས་གློ་བུར་ཉིད་ལ་མེད་པར་མཛད་པས། མཁར་བརྟན་པོ་ལ་རྐྱེན་ངན་ཐེབས་པར་གྱུར།"]},{"type":"verse","number":10,"content":["མཁར་སྒོ་རུ་དྲང་བདེན་སྐྱོང་བའི་མི་ལ་ཁྱོད་རྣམས་སྡང་ཞིང་། བདེན་ཚིག་སྨྲ་མཁན་ལ་ཞེན་པ་ལོག"]},{"type":"verse","number":11,"content":["ཁྱོད་ཅག་གིས་དབུལ་པོར་བརྙས་བཅོས་བྱས་ཤིང་། དེ་ལས་འབྲུ་རིགས་བཙན་གྱིས་བསྡུས་པས། ཁྱོད་ཅག་གིས་བརྡར་བའི་རྡོ་ཡིས་ཁང་པ་བསྐྲུན་ཡང་། དེའི་ནང་དུ་གནས་པར་མི་འགྱུར། ཁྱོད་ཅག་གིས་སྙིང་ལ་སྡུག་པའི་རྒུན་ཚལ་རྣམས་བཙུགས་ཀྱང་། དེ་ལས་ཐོན་པའི་རྒུན་ཆང་འཐུང་བར་མི་འགྱུར།"]},{"type":"verse","number":12,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱི་མི་ཚངས་པ་མང་ཞིང་། སྡིག་པ་ཤིན་ཏུ་ཆེ་བ་ངས་རྟོགས་ཏེ། ཁྱོད་ཅག་གིས་མི་དྲང་བདེན་ཅན་སྡུག་ལ་སྦྱར་ཅིང་། ལྐོག་རྔན་བླངས་ཏེ་མཁར་སྒོ་རུ་དབུལ་ཕོངས་དག་ལ་ཁྲིམས་ལོག་པར་སྤྱད་པས།"]},{"type":"verse","number":13,"content":["ཤེས་པའི་མི་ནི་ཁ་རོག་ཏུ་སྡོད་དེ། ཅིའི་ཕྱིར་ཞེ་ན། དུས་རབས་ངན་པ་ཡིན་པས་སོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་བཟང་པོ་བཙལ་བ་ལས་ངན་པ་མ་བཙལ་ཞིག དེ་ལྟར་ཁྱོད་རྣམས་གསོན་པར་འགྱུར་ཞིང་། ཡང་ཁྱོད་ཅག་གིས་སྨྲས་པ་བཞིན་དུ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་ཅག་དང་མཉམ་དུ་བཞུགས་པར་བྱའོ། །"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་བཟང་པོར་དགའ་ཞིང་། ངན་པར་སྡང་སྟེ་མཁར་སྒོ་རུ་དྲང་བདེན་སྤེལ་ཞིག དེ་ལྟར་བྱས་ན་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་སེབ་ཀྱི་ལྷག་ལུས་རྣམས་ལ་བྱིན་རླབས་གནང་ཡང་སྲིད།"]},{"type":"verse","number":16,"content":["དེ་བས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་སྟེ་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཐང་ཆེན་ཀུན་ཏུ་ངུ་འབོད་བྱེད་པའི་སྒྲ་ཐོས་ཤིང་། སྲང་ལམ་རྣམས་སུ་སྐྱོ་བ་ལ་སྐྱོ་བ་ལ་ཞེས་བརྗོད་པར་འགྱུར་ལ། ཡང་མི་ཡིས་འོ་དོད་བྱེད་དུ་ཞིང་པ་འབོད་ཅིང་། མྱ་ངན་བྱེད་དུ་སྐྱོ་གླུ་ལེན་མཁན་འབོད་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["རྒུན་ཚལ་ཀུན་ཏུ་ཡིད་གདུང་ངུ་འབོད་ཀྱི་སྐད་ཐོས་ཡོང་། ཅིའི་ཕྱིར་ཞེ་ན། ང་རང་ཁྱོད་ཚོའི་དཀྱིལ་ནས་རྒྱུ་བར་བྱའོ་ཞེས་གསུངས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་སླེབ་པར་རེ་སྒུག་བྱེད་པ་ཁྱོད་རྣམས་ལ་ཆག་སྒོ་འབྱུང་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོར་ཁྱོད་རྣམས་ལ་ཅི་འབྱུང་ངམ། ཉིན་མོ་དེ་ནི་འོད་དང་བྲལ་བའི་མུན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":19,"content":["ཉིན་མོ་དེ་ནི་སེང་གེ་ལས་བྲོས་ནས་དོམ་དང་ཕྲད་དེ། ཁྱིམ་དུ་སླེབས་ནས་རྩིག་པར་ལག་པ་སྔས་ཏེ་སྦྲུལ་གྱིས་སོ་བཏབ་པའི་མི་དང་འདྲའོ། །"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་ནི་འོད་དང་བྲལ་བའི་མུན་པ་དང་། སྨག་རུམ་ཡིན་ཞིང་འོད་ཅི་ཡང་མེད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱི་དུས་ཆེན་རྣམས་ལ་ང་སྡང་ཞིང་ཞེན་ལོག་སྟེ། ཁྱོད་ཀྱི་འདུ་འཛོམས་དམ་ནན་རྣམས་ལའང་ང་མི་དགའོ། །"]},{"type":"verse","number":22,"content":["ཁྱོད་ཅག་གིས་ང་ལ་སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་མཆོད་ཕུལ་ན་ཡང་ངས་མི་ལེན་ཏེ། ཁྱོད་ཅག་གིས་ཞི་བདེའི་མཆོད་པ་རུ་ཤ་ཤེད་རྒྱས་པའི་ཕྱུགས་ཟོག་ཕུལ་ན་ཡང་ངས་སྣང་མེད་དུ་བསྐྱུར་རོ། །"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་གི་མགུར་གླུའི་འུར་སྒྲ་ནི་ང་དང་བྲལ་བར་གྱིས་ཤིག ངས་ཁྱོད་ཅག་གིས་རྒྱུད་མངས་དཀྲོལ་བ་ལའང་མི་མཉན་ནོ། །"]},{"type":"verse","number":24,"content":["དེ་ལས་དྲང་གཞག་ནི་རྦ་རླབས་འཕྱུར་བ་བཞིན་དང་། དྲང་བདེན་ཆུ་བོ་བཞིན་དུ་ལྷུང་ལྷུང་འབབ་པར་སྨོན།"]},{"type":"verse","number":25,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད། ཁྱོད་ཅག་དབེན་སྟོང་ཡུལ་ནས་བགྲང་བྱ་བཞི་བཅུར་བསྡད་ཀྱང་། སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་མཆོད་བདག་ལ་ཕུལ་བ་ཡིན་ནམ།"]},{"type":"verse","number":26,"content":["ཁྱོད་ཅག་གིས་རང་གི་ཕྱིར་དུ་བཟོས་པའི་ལྷ་སྟེ། རང་གི་རྒྱལ་པོ་སིག་ཀུད་དང་། ཁྱོད་ཅག་གི་སྐར་ལྷ་ཁེ་ཝན་ཁུར་བས།"]},{"type":"verse","number":27,"content":["ངས་ཁྱོད་རྣམས་བཙོན་དུ་འཁྲིད་པར་འགྱུར་ཞིང་། དཱ་མེ་སེག་ཕྱི་རོལ་ཏུ་ཡུལ་འཁྱམ་ལ་བསྐྱལ་བར་བྱའོ་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་གི་མཚན་མངའ་བའི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}