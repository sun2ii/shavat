{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"AMO","translationId":"bod_ntb","name":"ཨ་མོ་སི།","commonName":"ཨ་མོ་སི།","title":"༄༅། །ལུང་སྟོན་པ་ཨ་མོ་སིའི་མདོ།","order":30,"numberOfChapters":9,"sha256":"78ed2104ac86fc1164a277ff56010aa2413514f866b0490a6edc1fc78f090e70","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bod_ntb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":7,"content":[{"type":"heading","content":["ཆ་ག་འབུ་ཡི་ཞལ་གཟིགས།"]},{"type":"verse","number":1,"content":["གཙོ་བོ་ཡ་ཝཱེས་ང་ལ་དོན་ཞིག་བསྟན་ཏེ། ལྟོས་ཤིག རྒྱལ་པོའི་ཕྱིར་དུ་ལོ་ཏོག་བསྡུས་རྗེས། ས་ཞིང་དུ་མྱུ་གུ་འབུས་མ་ཐག གཙོ་བོས་འབུ་ཆ་ག་པ་མང་པོ་མཛད་པ་དང་།"]},{"type":"verse","number":2,"content":["འབུ་ཆ་ག་པས་ས་གཞིའི་ཐོན་རྫས་ཟོས་ཚར་དུས། ངས་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་དགོངས་ཡངས་གནང་བར་མཛོད་ཅིག ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཀོབ་ནི་ཉམ་ཆུང་ཡིན་པས་ཅི་ལྟར་ལང་སྲིད་དམ་ཞེས་ཞུས་པ་ལས།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་དོན་དེའི་ཕྱིར་ཐུགས་འགྱོད་སྐྱེས་ཤིང་། དེ་བཞིན་འབྱུང་བར་མི་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་ང་ལ་འདི་ལྟར་བསྟན་ཏེ། ལྟོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་ཉེས་ཆད་གཅོད་ཕྱིར་མེ་བཀུག་སྟེ། རྒྱ་མཚོ་ཆེན་པོ་དང་ཡེས་ར་ཨེལ་གྱི་ས་སྐལ་ཡང་མེར་བསྲེགས་པས།"]},{"type":"verse","number":5,"content":["ངས་གཙོ་བོ་ཡ་ཝཱེ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་དེ་ལྟར་མ་མཛད་ཅིག ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཀོབ་ནི་ཉམ་ཆུང་ཡིན་པས་ཅི་ལྟར་ཚུགས་ཐུབ་བམ་ཞེས་ཞུས་པ་ལས།"]},{"type":"verse","number":6,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་དོན་དེའི་ཕྱིར་ཐུགས་འགྱོད་སྐྱེས་ཤིང་། དེ་བཞིན་དུའང་འབྱུང་བར་མི་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["ཡང་ཁོང་གིས་ང་ལ་འདི་ལྟར་བསྟན་ཏེ། ལྟོས་ཤིག རྩིག་པ་ཞིག་ནི་ཐིག་སྐུད་འཐེན་ནས་བཟོས་པ་དང་། གཙོ་བོས་ཕྱག་ཏུ་ཐིག་སྐུད་ཐོགས་ཏེ་རྩིག་པ་དེའི་སྟེང་དུ་བཞེངས་ནས།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཨ་མོ་སི། ཁྱོད་ཀྱིས་ཅི་མཐོང་ངམ་གསུངས་པ་ན། ངས་ལན་དུ་ཐིག་སྐུད་ཅིག་མཐོང་ཞུས་པ་དང་། ཡང་གཙོ་བོས་འདི་སྐད་དུ། ངས་ཐིག་སྐུད་ངའི་མི་སྡེ་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་དཔྱངས་ཏེ། ད་ཕྱིན་ཆད་ངས་དེ་དག་གུ་ཡངས་སུ་མི་གཏོང་ཞིང་།"]},{"type":"verse","number":9,"content":["ཨི་སཱག་གི་མཐོ་གླིང་རྣམས་སྟོངས་ཤིང་། ཡེས་ར་ཨེལ་གྱི་གནས་མཆོག་རྣམས་བརླག་པར་འགྱུར་ལ། ཡང་ངས་རལ་གྲིས་ཡེ་རོབ་ཨམ་གྱི་ཁྱིམ་རྒྱུད་ལ་རྒོལ་བར་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཨ་མཱ་ཙི་ཡས་ཨ་མོ་སི་གཏུག་པ།"]},{"type":"verse","number":10,"content":["དེ་ནས་པེད་ཨེལ་གྱི་མཆོད་དཔོན་ཨ་མཱ་ཙི་ཡས་མི་མངགས་ནས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡེ་རོབ་ཨམ་ལ་འཕྲིན་སྐུར་ཏེ་ན་རེ། ཨ་མོ་སི་ཡིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཁྲོད་དུ་ཁྱེད་ལ་ངོ་ལོག་བྱེད་པར་ལྐོག་ཇུས་འཐེན་ཞིང་། དེའི་ཚིག་ཐམས་ཅད་རྒྱལ་ཁབ་འདི་ཡིས་མི་ཐེག"]},{"type":"verse","number":11,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཨ་མོ་སི་ཡིས་ན་རེ། ཡེ་རོབ་ཨམ་ནི་རལ་གྲིས་འགུམས་པར་འགྱུར་ཞིང་། ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་རང་ཡུལ་ལས་བྲལ་ཏེ་བཙོན་ལ་འཁྲིད་པར་འགྱུར་ཞེས་སྨྲས་པའི་ཕྱིར་སྦྲན་ཏོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཨ་མཱ་ཙི་ཡས་ཨ་མོ་སི་ལ་འདི་ལྟར། ཀྱེ་མངོན་ཤེས་ཅན་ཁྱོད་ཡ་ཧུ་དཱ་རུ་ཕྲོས་ཤིག གནས་དེར་རང་ཁ་གསོས་དང་། གནས་དེར་ལུང་སྟོན་པ་ལས།"]},{"type":"verse","number":13,"content":["པེད་ཨེལ་དུ་ལུང་མ་སྟོན་ཅིག ཅིའི་ཕྱིར་ཞེ་ན། གནས་འདི་རུ་རྒྱལ་པོའི་གནས་མཆོག་ཡོད་པ་དང་། རྒྱལ་པོའི་ཕོ་བྲང་ཡོད་པའི་ཕྱིར་རོ་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་ཨ་མོ་སི་ཡིས་ཨ་མཱ་ཙི་ཡ་ལ་ལན་དུ། ང་ནི་ལུང་སྟོན་པ་ཡང་མིན། ལུང་སྟོན་པའི་བུ་ཡང་མིན། ང་ནི་ལུག་རྫི་ཞིག་ཡིན་ཞིང་། འོ་སེ་ཤིང་ལ་བདག་གཉེར་བྱེད་མཁན་ཞིག་ཡིན།"]},{"type":"verse","number":15,"content":["ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ང་བདམས་ཏེ། ང་ནི་ལུག་ཁྱུའི་རྗེས་སུ་འབྲང་བར་མ་མཛད་དེ། ཁོང་གིས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་སོང་ནས་ངའི་མི་སྡེ་ཡེས་ར་ཨེལ་ལ་ལུང་སྟོན་ཅིག་ཅེས་གསུངས་པས།"]},{"type":"verse","number":16,"content":["ཀྱེ་ཨ་མཱ་ཙི་ཡ་ལགས་ད་ལྟ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག ཅིའི་ཕྱིར་ཞེ་ན། ཡེས་ར་ཨེལ་ལ་རྒོལ་བའི་ལུང་མ་སྟོན་ཅིག ཨི་སཱག་གི་ཁྱིམ་རྒྱུད་ལ་རྒོལ་བའི་གཏམ་མ་བརྗོད་ཅིག་ཅེས་ཁྱོད་ཀྱིས་སྨྲས་པའི་ཕྱིར།"]},{"type":"verse","number":17,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱི་ཆུང་མ་གྲོང་ཁྱེར་ནས་གཡེམ་མ་བྱེད་པ་དང་། ཁྱོད་ཀྱི་བུ་དང་བུ་མོ་རྣམས་རལ་གྲིའི་འོག་ནས་འགྱེལ་ཞིང་། ཁྱོད་ཀྱི་ས་ཞིང་རྣམས་མི་ཡིས་ཐག་པས་ཚད་དེ་བགོ་བར་འགྱུར་ལ། ཡང་ཁྱོད་རང་ཉིད་ནི་གནས་མི་གཙང་བ་ཞིག་ནས་འཆི་བར་འགྱུར་བ་དང་། ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱང་རང་ཡུལ་དང་བྲལ་ནས་བཙོན་ལ་འཁྲིད་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/AMO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/AMO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/AMO/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}