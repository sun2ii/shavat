{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"AMO","translationId":"bod_ntb","name":"ཨ་མོ་སི།","commonName":"ཨ་མོ་སི།","title":"༄༅། །ལུང་སྟོན་པ་ཨ་མོ་སིའི་མདོ།","order":30,"numberOfChapters":9,"sha256":"78ed2104ac86fc1164a277ff56010aa2413514f866b0490a6edc1fc78f090e70","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bod_ntb/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["མཆོད་ཁང་གི་ཞལ་གཟིགས་བརླག་པ།"]},{"type":"verse","number":1,"content":["གཙོ་བོ་ཡ་ཝཱེ་མཆོད་ཁྲི་མདུན་དུ་བཞེངས་པ་ངས་མཐོང་ཞིང་། ཁོང་གིས་འདི་སྐད་དུ། སྒོ་ཐེམ་རྣམས་འགུལ་བར་ཁྱོད་ཀྱིས་མཆོད་ཁང་གི་ཀ་གཞུ་ལ་བརྡུངས་ནས་མི་རྣམས་ཀྱི་མགོ་ལ་ལྷུང་དུ་ཆུག་དང་། ལྷག་ལུས་རྣམས་ངས་རལ་གྲིས་གསོད་པར་འགྱུར་ཞིང་། དེ་དག་ལས་སུ་ཡང་འབྲོ་མི་ཐུབ་ལ། སུ་ཡང་ཐར་མི་ཐུབ།"]},{"type":"verse","number":2,"content":["ཇི་སྟེ་དེ་དག་གིས་གཤིན་པོའི་ཡུལ་གྱི་མཐིལ་བརྟོལ་ནའང་ངའི་ལག་པས་དེ་དག་ཕྱིར་འདོན་པར་འགྱུར་ཞིང་། ཇི་སྟེ་དེ་དག་དགུང་ཨ་སྔོན་དབྱིངས་ཀྱི་རྩེ་མོར་འཛེགས་ནའང་ངས་དེ་དག་མར་འཐེན་པར་བྱའོ། །"]},{"type":"verse","number":3,"content":["ཇི་སྟེ་དེ་དག་ཀར་མེལ་གྱི་རི་རྩེར་སྦས་པ་ཡིན་ནའང་། དེ་ནས་ཀྱང་ངས་དེ་དག་བཙལ་ནས་འཛིན་པར་བྱ་སྟེ། ཇི་སྟེ་དེ་དག་ང་དང་གཡོལ་ཕྱིར་རྒྱ་མཚོའི་གཏིང་དུ་སྦས་རུང་། དེ་ནས་ཀྱང་ངས་ཆུ་སྲིན་ལ་བཀའ་བསྩལ་ཏེ་ཁོ་ཚོར་སོ་འདེབས་སུ་འཇུག"]},{"type":"verse","number":4,"content":["ཇི་སྟེ་དེ་དག་དགྲ་ཡིས་བཙོན་དུ་ཁྲིད་རུང་། དེ་ནས་ཀྱང་ངས་རལ་གྲིར་བཀའ་བསྩལ་ནས་དེ་དག་འགུམས་པར་བྱ་སྟེ། ངས་དེ་དག་ལ་དམ་པོར་གཟིགས་ཏེ་གནོད་འཚེ་ལས་བྱིན་རླབས་མི་གནང་ངོ་། །"]},{"type":"verse","number":5,"content":["དཔུང་ཚོགས་ཀུན་གྱི་གཙོ་བོ་དཀོན་མཆོག་ཡ་ཝཱེས་ས་ལ་ཕྱག་གིས་རེག་པ་ཙམ་གྱིས་དེ་ནི་ཞུ་བ་དང་། དེའི་ནང་དུ་གནས་པ་ཐམས་ཅད་སྐྱོ་བར་འགྱུར་ལ། ཡང་གནས་དེ་ནི་ནེ་ལོ་གཙང་པོ་བཞིན་དུ་རྒྱས་པ་དང་། ཨེ་ཅིབ་གཙང་པོ་བཞིན་དུ་རྒྱས་ཤིང་འབབ་པར་འགྱུར།"]},{"type":"verse","number":6,"content":["ཁོང་གིས་མཁའ་དབྱིངས་སུ་ཐོག་ཁང་བརྩིགས་ཤིང་། ས་གཞིའི་སྟེང་དུ་ཨ་སྔོན་བཀོད། ཁོང་གིས་རྒྱ་མཚོའི་ཆུ་རྣམས་ལ་བཀའ་བསྩལ་ཏེ་ས་ངོས་སུ་བླུགས་པ་སྟེ། ཁོང་གི་མཚན་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས་སོ། །"]},{"type":"verse","number":7,"content":["ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། ཁྱོད་ཅག་ང་ལ་གུ་ཤ་པ་དང་འདྲ་བ་མིན་ནམ། ངས་ཨེ་ཅིབ་ཡུལ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་དང་། ཀབ་ཐོར་ནས་ཕེ་ལེ་ཤེད་པ་རྣམས། ཀིར་ནས་ཨ་རམ་པ་རྣམས་དྲངས་པ་མ་ཡིན་ནམ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་དང་།"]},{"type":"verse","number":8,"content":["ལྟོས་ཤིག གཙོ་བོ་ཡ་ཝཱེའི་སྤྱན་གྱིས་སྡིག་ཅན་གྱི་ཡུལ་ཁམས་འདིར་གཟིགས་ཤིང་། ངས་ཡུལ་འདི་ས་ལས་མེད་པར་མཛད་ཀྱང་། ཡ་ཀོབ་ཀྱི་ཁྱིམ་རྒྱུད་ནི་ཡོངས་སུ་མེད་པར་མི་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ལྟོས་ཤིག མི་ཡིས་ཁྲོལ་ཚགས་ཀྱིས་འབྲུ་བཙགས་པ་བཞིན་དུ། ངས་བཀའ་བསྩལ་ནས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ནི་ཡུལ་ཁམས་སོ་སོར་ཐོར་དུ་འཇུག་ཅིང་། རྡེའུ་ཧྲུག་གཅིག་ཀྱང་སར་ལྷུང་བར་མི་འགྱུར།"]},{"type":"verse","number":10,"content":["ངའི་མི་སྡེ་ཁྲོད་ཀྱི་སྡིག་ཅན་ཐམས་ཅད་དེ། གནོད་འཚེས་ང་རང་མི་ཟིན་ལ་དེ་ངའི་སྟེང་དུ་འབྱུང་བར་ཡང་མི་འགྱུར་ཞེས་སྨྲ་བའི་མི་དག་ཀྱང་རལ་གྲིའི་འོག་ཏུ་འཆི་བར་འགྱུར།"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་ཡང་བསྐྱར་དར་བ།"]},{"type":"verse","number":11,"content":["ཉིན་དེར་ངས་དཱ་བིད་ཀྱི་བརྡིབས་པའི་གུར་མཆོག་ཡང་བསྐྱར་བསྒྲེངས་ནས་དེའི་བུ་ག་རྣམས་གཅོད་ཅིང་། དེའི་ཞིག་རོ་རྣམས་ཡང་བསྐྱར་བརྩིགས་ཏེ། གནའ་དུས་བཞིན་དུ་བཞེང་བར་བྱའོ། །"]},{"type":"verse","number":12,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཨེ་དོམ་གྱི་ལྷག་མ་དང་། བདག་གི་མིང་ཐོགས་པའི་མི་རིགས་ཐམས་ཅད་ནོར་སྐལ་དུ་འཐོབ་པའི་ཕྱིར་དུའོ་ཞེས་དེ་བཞིན་མཛད་པའི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དུས་སླེབས་ལ་ཉེ་ཞིང་། རྨོ་མཁན་གྱིས་སྡུད་མཁན་དང་། རྒུན་འབྲུམ་རྫི་མཁན་གྱིས་ས་བོན་འདེབས་མཁན་གྱི་རྒྱུན་མཐུད་པ་དང་། རི་བོ་ཆེན་པོ་ལས་རྒུན་ཆང་མངར་མོ་ཐིགས་ཤིང་། རི་ཕྲན་རྣམས་ལས་བཞུར་བར་འགྱུར།"]},{"type":"verse","number":14,"content":["ངས་བཙོན་དུ་ཁྲིད་པའི་རང་གི་མི་སྡེ་ཡེས་ར་ཨེལ་ཕྱིར་ལོག་པར་བྱ་སྟེ། དེ་དག་གིས་གྲོང་ཁྱེར་གོག་པོ་རྣམས་ཡང་བསྐྱར་བཞེངས་ནས་དེའི་ནང་དུ་སྡོད་པར་འགྱུར་ཞིང་། རྒུན་ཚལ་རྣམས་བཙུགས་ནས་དེའི་རྒུན་ཆང་འཐུང་བ་དང་། ལྡུམ་ར་བཙུགས་ནས་དེའི་འབྲས་བུ་བཟའ་བར་འགྱུར།"]},{"type":"verse","number":15,"content":["ངས་དེ་དག་རང་ཡུལ་ནང་འཛུགས་ཤིང་། དེ་དག་ངས་སྤྲད་པའི་ཁོ་ཚོ་རང་གི་ཡུལ་ལས་ནམ་ཡང་འདོན་པར་མི་འགྱུར་ཞེས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}