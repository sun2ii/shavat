{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"COL","translationId":"bod_ntb","name":"ཀོ་ལོ་སཱ་པ།","commonName":"ཀོ་ལོ་སཱ་པ།","title":"༄༅། །ཀོ་ལོ་སཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":51,"numberOfChapters":4,"sha256":"498723712519fee5388b12be9acd66a5ab4427d8ca13937d7d8b46ca6b1e94c3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/COL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/COL/4.json","totalNumberOfVerses":95},"chapter":{"number":1,"content":[{"type":"heading","content":["འཕྲིན་ཡིག་བསྐུར༌ཡུལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཕོལ་ལོལ་བདག་ནི་དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་མཱ་ཤི་ཀ་ཡེ་ཤུའི་སྐུ་ཚབ་པ་ཞིག་ཡིན་ནོ།། བདག་དང་བདག་ཅག་གི་སྤུན་ཟླ་ཐི་མོ་ཐེ་གཉིས༌ཀྱིས།"]},{"type":"verse","number":2,"content":["ཀོ་ལོ་སཱ་རུ་གནས་པ་དང་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་གི་བློ་སེམས་དཀར་བའི་སྤུན་ཟླ་དམ་པ་རྣམས་ལ་འཕྲིན་ཡིག་སྤྲིངས་པ༌འདི་ལྟ་སྟེ། བདག་ཅག་གི་ཡབ་དཀོན་མཆོག་ནས་ཁྱོད་རྣམས་ལ་ཐུགས་རྗེ་དང་ཞི་བདེ་འཐོབ་པར༌སྨོན།"]},{"type":"heading","content":["དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ༌བ།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་གིས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་གསོལ་བ་འདེབས་པའི་དུས་སུ། རྟག་ཏུ་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཡབ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས༌པའོ།།"]},{"type":"verse","number":4,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་མཱ་ཤི་ཀ་ཡེ་ཤུར་དད་པ་ཡོད་པ༌དང༌། དད་ལྡན་དམ་པ་ཐམས་ཅད་ལ་བརྩེ་སེམས་ཡོད་པའང་ངེད་ཅག་གིས་ཐོས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":5,"content":["འདི་ནི་ནམ་མཁའི་ཞིང་ཁམས་སུ་ཁྱོད་ཅག་གི་ཆེད་དུ་བཞག་ཡོད་པའི་རེ་འདུན་དེའི་ཕྱིར་ཡིན༌ལ། རེ་འདུན་དེ་ནི་སྔར་ཁྱོད་རྣམས་ཀྱིས་འཕྲིན་བཟང་སྟེ་བདེན་པའི་བཀའ་ལས་ཐོས་པ་དེ་ཡིན།"]},{"type":"verse","number":6,"content":["འཕྲིན་བཟང་དེ་ནི་ཁྱོད་ཅག་གི་གནས་སུ་ཁྱབ་ཅིང་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཐོས༌ཏེ། དངོས་གནས་དཀོན་མཆོག་གི་ཐུགས་རྗེ་དེ་ཉིད་རྟོགས་པའི་ཉིན་མོ་ནས༌བཟུང༌། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་འཕྲིན་བཟང་གི་འབྲས་བུ་མང་དུ་སྨིན་པ༌ལྟར། འཕྲིན་བཟང་དེ་ཉིད་འཇིག་རྟེན་ཀུན་ལ་བསྒྲགས་ཤིང་དེའི་འབྲས་བུའང་སྨིན་བཞིན་འདུག"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱིས་འཕྲིན་བཟང་དེ་ནི་ངེད་ཅག་གི་སྙིང་ནས་བརྩེ་བའི་ཞབས་ཏོག་པ་ཨེ་པབ་རཱའི་ངག་ལས་བསླབས༌ཤིང༌། ཁོ་རང་ནི་ངེད་ཅག་གི་ཕྱིར་དུ་སྐྱབས་མགོན་མཱ་ཤི་ཀར་བློ་སེམས་དཀར་བའི་ཞབས་ཕྱི་པ་ཞིག་ཡིན༌ལ།"]},{"type":"verse","number":8,"content":["ཁོས་དམ་པའི་ཐུགས་ཉིད་ལས་བྱུང་བའི་ཁྱོད་ཅག་གི་བྱམས་པ་དེ་ངེད་ཅག་ལ་སྨྲས༌སོ།།"]},{"type":"verse","number":9,"content":["དེའི༌ཕྱིར། ངེད་རྣམས་ཀྱིས་གོང་གི་དོན་དེ་ཐོས་པའི་ཉིན་མོ་ནས༌བཟུང༌། རྟག་ཏུ་ཁྱོད་རྣམས་ཀྱི་དོན་དུ་འདི་ལྟར་གསོལ་བ་བཏབ་པ༌སྟེ། ཁྱོད་རྣམས་ཀྱིས་ཐུགས་ཉིད་ཀྱི་ཤེས་རབ་དང་ཤེས་རྟོགས་ཐམས་ཅད་ལ་བརྟེན༌ནས། དཀོན་མཆོག་གི་ཐུགས་དགོངས་གསལ་པོར་རྟོགས་པར༌སྨོན།"]},{"type":"verse","number":10,"content":["དེ་ནི་ཁྱོད་རྣམས་ཀྱི་སྤྱོད་ལམ་ནི་གཙོ་བོ་དང་མཐུན་འོས་ཤིང༌། དོན་ཀུན་ནས་ཁོང་གི་ཐུགས་དགྱེས་པར་བྱེད་པ༌དང༌། ལས་བཟང་པོ་ཐམས་ཅད་ནས་འབྲས་བུ་བསྐྱེད་ཅིང་རིམ་བཞིན་དཀོན་མཆོག་གི་ངོ་བོ་ལྷག་ཏུ་རྟོགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་གི་གཟི་བརྗིད་ལྡན་པའི་ནུས་མཐུར་བརྟེན༌ནས། ཁྱོད་རྣམས་དགའ་ཞིང་སྤྲོ་བའི་ངང་དོན་ཀུན་ལ་བཟོད་བསྲན་ཡོད་པའི༌ཕྱིར། ཁྱོད་ཅག་གི་སེམས་སུ་ནུས་མཐུ་སྣ་ཚོགས་སྔར་ལས་རྒྱས་པར༌སྨོན།"]},{"type":"verse","number":12,"content":["ཡང་ཡབ་ཀྱིས་བདག་ཅག་ལ་འོད་ཟེར་གྱི་ཁྲོད་ནས་དད་ལྡན་དམ་པ་རྣམས་དང་ལྷན་དུ་བགོ་སྐལ་འཐོབ་ཐུབ་པར་མཛད༌པས། དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་བ་ཡིན་ནོ།།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་གིས་བདག་ཅག་མུན་པའི་དབང་ལས་ཐར་བར་མཛད༌དེ། ཁོང་གི་གཅེས་པའི་སྲས་ཀྱི་རྒྱལ་སྲིད་དུ་བསྐྱལ་བར་མཛད༌ཅིང༌།"]},{"type":"verse","number":14,"content":["ཁོང་ཉིད་ཀྱི་གཅེས་པའི་སྲས་དེའི་ནང་དུ་བདག་ཅག་བླུས་ཤིང་སྡིག་པ་བསལ་བའོ།།"]},{"type":"heading","content":["བླ་ན་མེད་པའི་ཡེ་ཤུ་མཱ་ཤི་ཀའི༌སྐོར།"]},{"type":"verse","number":15,"content":["གཅེས་པའི་སྲས་ནི་མིག་གིས་མཐོང་མི་ནུས་པའི་དཀོན་མཆོག་གི་སྣང་བརྙན་ཡིན༌ལ། འཇིག་རྟེན་དུ་བཀོད་པའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་སྔོན་ལ་འཁྲུངས་ཡོད་པའོ།།",{"noteId":0}]},{"type":"verse","number":16,"content":["རྒྱུ་མཚན་ནི་འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་ཁོང་ལ་བརྟེན་ནས་བཀོད་པ་ཡིན༌ཏེ། གནམ་ས་གང་ཁྱབ༌དང༌། མིག་གིས་མཐོང་ཐུབ༌མིན། རྒྱལ་ཁྲི་ཐོབ་མཁན། དབང་སྒྱུར༌མཁན། སྲིད་འཛིན༌མཁན། དབང་འཛིན་མཁན་བཅས་ཐམས་ཅད་ཁོང་ཉིད་བརྒྱུད་ནས་བཟོས་ཤིང་ཁོང་གི་ཆེད་དུ་བཀོད་པ་ལགས་སོ།།"]},{"type":"verse","number":17,"content":["ཁོང་ཉིད་ནི་དངོས་པོ་ཐམས་ཅད་མ་བཀོད་པའི་སྔོན་ལ་བཞུགས༌ཤིང༌། དངོས་པོ་ཐམས་ཅད་ཀྱང་ཁོང་ལ་བརྟེན་ནས་གནས༌པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཡང་ཁོང་ནི་རང་ཉིད་ཀྱི་སྐུ་ལུས་ཡིན་པའི་ཆོས་ཚོགས་ཀྱི་དབུ་དང་། ཡང་ཁོང་ནི་ཐོག་མ་ཉིད་དང་། གཤིན་པོའི་ཁྲོད་ནས་སྔོན་དུ་འཁྲུངས་པ་ཡིན་ནོ༎ དེ་ནི་ཁོང་ཉིད་རྣམ་པ་ཀུན་ཏུ་མཆོག་གྱུར་ལགས་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":19,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཡབ་ཐུགས་དགྱེས་པ་ནི་འདི་ལྟ༌སྟེ། ཁོང་གིས་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་རྒྱུད་དུ་གནས་པར་མཛད་པ༌དང༌།"]},{"type":"verse","number":20,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་ཁྲག་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བཞུར་བ་ལ་བརྟེན་ནས་ཞི་བདེ་བསྐྲུན༌ཏེ། སྐྱབས་མགོན་ཡེ་ཤུ་བརྒྱུད་ནས་གནམ་ས་གང་ཁྱབ་ཏུ་ཡོད་པ་མཐའ་དག་ཁོང་དང་འདུམ་པར་མཛད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":21,"content":["དེ་སྔར་ཁྱོད་ཅག་ནི་དཀོན་མཆོག་དང་གཏན་དུ་བྲལ་ཞིང༌། ལས་ངན་པ་བྱས་ཏེ་སེམས་གཏིང་ནས་ཁོང་ཉིད་དགྲ་རུ་བཟུང༌མོད།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང༌། ད་ལྟ་སྐྱབས་མགོན་ཡེ་ཤུའི་ཤ་ཁྲག་གི་སྐུ་ལུས་དང་ཁོང་ཉིད་སྐུ་གྲོངས་པ་བརྒྱུད་ནས། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ཁོང་དང་བསྡུམས༌པའོ།། དེ་ནི་ཁྱོད་རྣམས་དམ་པ༌དང༌། སྐྱོན་གྱི་དྲི་མས་མ་གོས༌པ། སྐྱོན་བརྗོད་རྒྱུ་ཅི་ཡང་མེད་པར་ཁོང་གི་དྲུང་དུ་འདྲེན་པར་འགྱུར་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":23,"content":["གལ་ཏེ། ཁྱོད་རྣམས་ཀྱིས་དད་པ་ལ་སྙིང་རུས་བསྐྱེད་པ་དང་རྩ་བ་སྲ་ཞིང་བརྟན་པ༌དང༌། ཐེ་ཚོམ་མེད་པར་བརྟན་ཅིང་བརླིང་བ༌སྟེ། སྔར་ཐོས་མྱོང་བའི་འཕྲིན་བཟང་ལ་བཅངས་པའི་རེ་བ་དང་ཁ་འབྲལ་བར་མ་གྱུར༌ན། ཁྱོད་རྣམས་ཁོང་གི་དྲུང་དུ་འདྲེན་པར་འགྱུར་རོ།། འཕྲིན་བཟང་འདི་ནི་གནམ་འོག་གི་མི་ཐམས་ཅད་ལའང་བསྒྲགས་པར་མ༌ཟད། ཕོལ་ལོལ་ང་རང་ཡང་འཕྲིན་བཟང་འདིའི་ཞབས་ཕྱི་པར་བསྐོས་པ་ཡིན༌ནོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་ཆོས་ཚོགས་ཀྱི་དོན་དུ་དཀའ་སྡུག་མྱོང༌བ།"]},{"type":"verse","number":24,"content":["ད་ལྟ་བདག་གིས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་དཀའ་སྡུག་མྱངས་ནའང་དགའ་སྣང་སྐྱེ་ཞིང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ལུས་ཡིན་པའི་ཆོས་ཚོགས་ཀྱི་ཆེད༌དུ། ཁོང་གི་དཀའ་སྡུག་མི་འདང་བ་དེ་བདག་གི་ཤ་ཁྲག་གི་ཕུང་བོའི་སྟེང་ནས་རྫོགས་པར་བྱེད་དོ།།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་གི་བཀའ་ཡོངས་སུ་བསྒྲག་པའི༌ཕྱིར། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་བདག་ལ་གནང་བའི་ལས་འགན་བཞིན་ང་རང་ནི་ཆོས་ཚོགས་ཀྱི་ཞབས་ཕྱི་པར་བསྐོས༌པ་ཡིན།"]},{"type":"verse","number":26,"content":["བཀའ་དེ་ནི་བསྐལ་པ་ནས་བསྐལ་པ་དང༌། མི་རབས་ནས་མི་རབས་བར་དུ་སྦས་པའི་གསང་བ་ཡིན༌ཡང༌། ད་ལྟ་ཁོང་གི་དད་ལྡན་དམ་པ་རྣམས་ལ་མངོན་པར་མཛད།"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་གིས་གསང་བ་དེ་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་ཁྲོད་དུ་ཅི་འདྲའི་ཕུན་སུམ་ཚོགས་པའི་གཟི་བརྗིད་ཅིག་ཡིན་པ་དད་ལྡན་དམ་པ་རྣམས་ལ་ཤེས་སུ་འཇུག་པར་དགོངས་པ༌དང༌། གསང་བ་དེ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཁོང་ཉིད་ཁྱོད་རྣམས་ཀྱི་ནང་དུ་བཞུགས༌ཤིང༌། གཟི་བརྗིད་དང་ལྡན་པར་འགྱུར་བའི་རེ་བའང་ཡིན་ནོ།།"]},{"type":"verse","number":28,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་མི་རེ་རེ་ཕུལ་དུ་བྱུང་བ་ཡིན་པ་དཀོན་མཆོག་གི་དྲུང་དུ་འདྲེན་པའི༌ཕྱིར། ངེད་རྣམས་ཀྱིས་ཤེས་རབ་སྣ་ཚོགས་སྤྱད་ནས་མི་རེ་རེ་ལ་སྐུལ་སློང་དང་སློབ་སྟོན་གནང་སྟེ་སྐྱབས་མགོན་མཱ་ཤི་ཀ་སྒྲོག༌པ་དང་།"]},{"type":"verse","number":29,"content":["དོན་འདིའི་ཆེད་དུ་བདག་གིས་ཀྱང་ངལ་དུབ་མྱོང་ཞིང་རང་གི་སེམས་སུ་བཞུགས་པའི་སྐྱབས་མགོན་ཡེ་ཤུའི་ནུས་མཐུ་ཆེན་པོར་བརྟེན་ཏེ། སྟོབས་ཤུགས་ཡོད་རྒུ་བཏོན་ནས་བརྩོན་པའོ།།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འཇིག་རྟེན་དུ་བཀོད་པའི་དངོས་པོ་ཐམས་ཅད་ཀྱི་སྔོན་ལ་འཁྲུངས་ཡོད་པའོ་ཞེས་པ་ནི་གཅེས་པའི་སྲས་ཏེ་སྐྱབས་མགོན་ཡེ་ཤུ་ནི་འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་ལས་བླ་ན་འཕགས་ཞེས་པའི་དོན་ཡིན།","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/bod_ntb/COL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/COL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PHP/4.json","previousChapterAudioLinks":{},"numberOfVerses":29}