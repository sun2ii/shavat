{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"COL","translationId":"bod_ntb","name":"ཀོ་ལོ་སཱ་པ།","commonName":"ཀོ་ལོ་སཱ་པ།","title":"༄༅། །ཀོ་ལོ་སཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":51,"numberOfChapters":4,"sha256":"498723712519fee5388b12be9acd66a5ab4427d8ca13937d7d8b46ca6b1e94c3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/COL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/COL/4.json","totalNumberOfVerses":95},"chapter":{"number":2,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱིས་ཆོས་ཚོགས་ཀྱི་དོན་དུ་ཐུགས་ཁུར་གནང༌བ།"]},{"type":"verse","number":1,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་ཤེས་སུ་འཇུག་འདོད་པ་ནི། ཁྱོད་ཅག་དང་ལའོ་དི་ཀེ་ཡཱ་རུ་གནས་པའི་མི་རྣམས༌དང༌། བདག་དང་དངོས་སུ་ངོ་ཕྲད་མ་མྱོང་བ་རྣམས་ཀྱི་དོན༌དུ། བདག་གིས་ཅི་ལྟར་སྟོབས་ཤུགས་འདོན་པ༌དེ་ཡིན།"]},{"type":"verse","number":2,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་དེ་རྣམས་ལ་སེམས་གསོ་ཐོབ༌ཅིང༌། བྱམས་པའི་དབང་གིས་ཕན་ཚུན་འབྲེལ་འདྲིས་བྱས༌ཏེ། ཤེས་རྟོགས་ཕུན་སུམ་ཚོགས་པའི་ཁྲོད་ནས་དད་སེམས་བརྟན་པོས་དཀོན་མཆོག་གི་གསང་བ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་པ་ཤེས་ཐུབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":3,"content":["ཤེས་རབ་དང་ཤེས་བྱའི་གཏེར་ཁ་ཐམས་ཅད་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་སྦས་ཡོད།"]},{"type":"verse","number":4,"content":["བདག་གིས་འདི་ལྟར་སྨྲ་བ་ནི་མི་གཞན་གྱིས་ཁ་ཡག་ཚིག་གིས་ཁྱོད་རྣམས་འཁྲུལ་དུ་མི་འཇུག་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":5,"content":["བདག་གི་ལུས་པོ་ནི་ཁྱོད་ཅག་དང་ཁ་བྲལ༌ནའང༌། སེམས་ནི་ཁྱོད་ཅག་དང་མཉམ་དུ་གནས། ཁྱོད་རྣམས་ནི་བག་ཡོད་ཚུལ་དང་ལྡན༌ཞིང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ལ་དད་པའི་སེམས་ཀྱང་བརྟན་པོ་ཡིན་པ་ཤེས་པས་བདག་ནི་དགའ་ཞིང་སྤྲོ་བར་གྱུར༌ཏོ།།"]},{"type":"heading","content":["དད་ལྡན་རྣམས་ཀྱི་མི་ཚེ་གསར་པའི༌སྐོར།"]},{"type":"verse","number":6,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་གཙོ་བོ་མཱ་ཤི་ཀ་ཡེ་ཤུ་དང་དུ་བླངས༌པས། ཁོང་ལ་བསྟུན་ནས་སྤྱད་པ་སྤྱོད་དགོས༌ཤིང༌།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་ལ་ཐོབ་པའི་བསླབ་བྱ་ལྟར། ཁྱོད་ཅག་ནི་ཁོང་གི་ནང་དུ་རྩ་བ་ཟབ་ཅིང་ཇེ་བརྟན་དུ་ཡོང་བ་དང༌། དད་སེམས་བརྟན་ཅིང་བརླིང༌བ། དྲིན་ཚོར་བའི་སེམས་ཀྱང་ལྷག་པར་འཕེལ་དགོས་སོ།།"]},{"type":"verse","number":8,"content":["སུ་ཞིག་གིས་མཚན་ཉིད་རིག་པ་དང་རྫུན་གཏམ་སྟོང་བར་བརྟེན་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་མི་མཐུན༌པར། མིའི་རིགས་ཀྱི་སྲོལ་རྒྱུན་དང་འཇིག་རྟེན་གྱི་ཤེས་ཡོན་ཕྲན་བུ་དག་ལ་བརྟེན༌ན། ཁྱོད་རྣམས་བསླུ་ཉེན་ཆེ་བས་གཟབ་པར༌གྱིས།"]},{"type":"verse","number":9,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་རང་བཞིན་ཕུན་སུམ་ཚོགས་པ་ཐམས་ཅད་ནི་གཟུགས་དང་ལྡན་པར་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་བཞུགས་ཡོད་པ་དང་།"]},{"type":"verse","number":10,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ཁྱོད་རྣམས་ཀྱང་ཕུན་སུམ་ཚོགས་པར་མཛད་ཡོད་ཅིང༌། ཁོང་ནི་འཇིག་རྟེན་གྱི་སྲིད་འཛིན་མཁན་དང་དབང་འཛིན་མཁན་ཐམས་ཅད་ཀྱི་དབུ་ལགས་སོ།།"]},{"type":"verse","number":11,"content":["ཡང་ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་མཚན་སྐྱི་གཅོད་པར་ཞུགས༌ཤིང༌། དེ་ནི་མི་ཡིས་ལག་པས་བྱས་པ་མ་ཡིན་པར། སྐྱབས་མགོན་མཱ་ཤི་ཀས་མཚན་སྐྱི་བཅད་པ་ཡིན་ཏེ། ཁྱོད་རྣམས་ལ་ཤ་གཟུགས་ཀྱི་འདོད་ཆགས་འདོར་དུ་བཅུག་པའོ།།"]},{"type":"verse","number":12,"content":["དེ་སྔར་ཁྱོད་རྣམས་ཁྲུས་གསོལ་ལ་ཞུགས་ནས་ཁོང་དང་མཉམ་དུ་དུར་ལ་སྦས་ཤིང་ཁོང་ཉིད་གྲོངས་པ་ནས་སླར་གསོན་པར་མཛད་མཁན་དཀོན་མཆོག་གི་མཐུ་སྟོབས་ལ་ཡིད་ཆེས༌བྱས་པས། ཁྱོད་རྣམས་ཀྱང་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་སླར་གསོན་པ་ཡིན་ནོ།།"]},{"type":"verse","number":13,"content":["དེ་སྔར་ཁྱོད་རྣམས་ནི་སྡིག་པ་དང་མཚན་སྐྱི་མ་བཅད་པའི་ཤ་གཟུགས་ཀྱི་ཕུང་བོའི་ཁྲོད་དུ་ཤི་བའི་དུས་སུ། དཀོན་མཆོག་གིས་ཁྱོད་ཅག་གི་སྡིག་པ་ཐམས་ཅད་བསལ་ནས། ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་སླར་གསོན༌པར་མཛད་པ་ཡིན་ནོ།།"]},{"type":"verse","number":14,"content":["ཡང་ཁྲིམས་ཡིག་ནང་དུ་བྲིས་པའི་བདག་ཅག་ལ་སྐྱོན་བརྗོད་པ་དང་བདག་ཅག་ལ་གནོད་པའི་དཔང་ཡིག་རྣམས་བླངས༌ཏེ། ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་ནས་མེད་པར་མཛད།"]},{"type":"verse","number":15,"content":["ཁོང་གིས་འཇིག་རྟེན་གྱི་སྲིད་འཛིན་མཁན་དང་དབང་འཛིན་མཁན་རྣམས་ལ་དབང་བསྒྱུར་བའི་དུས༌སུ། ཤིང་རྒྱ་གྲམ་གྱི་ནུས་མཐུ་ལ་བརྟེན༌ནས་དེ་དག་ལས་རྣམ་པར་རྒྱལ་བའི་དོན་ནི་མི་ཀུན་ལ་མངོན་པར་མཛད༌དོ།།"]},{"type":"verse","number":16,"content":["དེའི༌ཕྱིར། བཟའ་བཏུང༌དང༌། དུས༌ཆེན། ཚེས་གཅིག ངལ་གསོ་བའི་ཉིན་མོ་བཅས་གང་ཐད༌ནས། མི་གཞན་སུས་ཀྱང་ཁྱོད་ཅག་ལ་ཁ་ཚོན་གཅོད་མི་རུང་ངོ༌།།"]},{"type":"verse","number":17,"content":["དེ་དག་ནི་མ་འོངས་འབྱུང་འགྱུར་གྱི་དོན་རྣམས་ཀྱི་གྲིབ་གཟུགས་ཡིན༌ཡང༌། དོན་དམ་དུ་གཟུགས་པོ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན།"]},{"type":"verse","number":18,"content":["མི་སུ་ཞིག་ལའང་བསམ་བཞིན་ཁེངས་སྐྱུང་གི་ཟོལ་ལ་བརྟེན་པ་དང་ཕོ་ཉར་བསྙེན་བཀུར་བྱེད་པ་བརྒྱུད༌ནས། ཁྱོད་ཅག་གི་བྱ་དགའ་འཕྲོག་ཏུ་འཇུག་མི་རུང༌། མི་དེ་རྣམས་ཀྱིས་མཐོང་སྣང་ཙམ་ལ་བརྟེན་ནས། རང་མོས་གང་འདོད་ཀྱིས་དོན་མེད་ཀྱི་ང་རྒྱལ་ཆེ་རུ་འཛིན༌པ་ལས།"]},{"type":"verse","number":19,"content":["དབུ་དེ་ཉིད་ལ་མི་བརྟེན༌པ་རེད། དོན་དམ་དུ་སྐུ་ལུས་ཡོངས་ཀྱིས་ཁོང་ལ་བརྟེན༌ནས། རྒྱུས་པ་དང་རུས་ཚིགས་དག་གིས་འབྲེལ་མཐུད་སྒྲིག་སྦྱོར་བྱེད༌ཅིང༌། དཀོན་མཆོག་ལ་བརྟེན་ནས་རིམ་བཞིན་ཇེ་ཆེར་འགྱུར་བའོ།།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཅག་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་གྲོངས་ཟིན་ཅིང༌། འཇིག་རྟེན་གྱི་ཤེས་ཡོན་ཕྲན་བུ་དག་ལའང་ཁ་བྲལ་བས་ན། ད་དུང་འཇིག་རྟེན་དུ་འཚོ་བ་དང་མཚུངས༌པར།"]},{"type":"verse","number":21,"content":["འཁྱེར་མི་རུང་བ༌དང༌། བཟའ་མི་རུང༌བ། རེག་མི་རུང་བ་སོགས་ཀྱི་སྲུང་བྱ་དང་བསྟུན་པའི་རྒྱུ་མཚན་ཅི།"]},{"type":"verse","number":22,"content":["སྲུང་བྱ་དེ་དག་ནི་མི་ཡིས་བཀའ་བསྒོས་པ་དང་སློབ་སྟོན་བྱས་པ་ལྟར་ཡིན༌ལ། དངོས་པོ་དེ་དག་ཀྱང་བཀོལ་སྤྱོད་བྱེད་བཞིན་པའི་སྐབས་སུ་ཐམས་ཅད་འཇིག་པར་འགྱུར་རོ།།"]},{"type":"verse","number":23,"content":["སྲུང་བྱ་དེ་དག་གིས་མི་རྣམས་ལ་ཤེས་རབ་ལྡན་པའི་མིང་ཙམ༌དང༌། རང་འདོད་ཀྱིས་བསྙེན་བཀུར་བྱེད༌པ། ཁེངས་སྐྱུང་གི་ཟོལ་མངོན་པ། ལུས་ལ་དཀའ་ཐུབ་སྤྱོད་པ་བཅས་བྱེད་དུ་འཇུག༌པ་ཡིན། དོན་དམ་དུ་ཤ་གཟུགས་ཀྱི་འདོད་ཆགས་སྣ་ཚོགས་འགོག་པའི་ཐད་ལ་སྲུང་བྱ་དེ་དག་གིས་ཕན་ཅི་ཡང་མི་ཐོགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/COL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/COL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/COL/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}