{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"COL","translationId":"bod_ntb","name":"ཀོ་ལོ་སཱ་པ།","commonName":"ཀོ་ལོ་སཱ་པ།","title":"༄༅། །ཀོ་ལོ་སཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":51,"numberOfChapters":4,"sha256":"498723712519fee5388b12be9acd66a5ab4427d8ca13937d7d8b46ca6b1e94c3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/COL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/COL/4.json","totalNumberOfVerses":95},"chapter":{"number":3,"content":[{"type":"heading","content":["དད་ལྡན་རྣམས་ཇི་ལྟར་འཚོ་བའི་ཚད་གཞི།"]},{"type":"verse","number":1,"content":["དེའི་ཕྱིར་ཁྱོད་རྣམས་དངོས་གནས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་སླར་གསོན་པ་ཡིན༌ན། ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་དོན་རྣམས་ལ་མུ་མཐུད་དུ་བརྩོན་པར༌གྱིས། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་གནས་དེ་རུ་དཀོན་མཆོག་གི་གཡས་ཕྱོགས་སུ་བཞུགས༌སོ།།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཅག་གིས་འཇིག་རྟེན་གྱི་དོན་རྣམས་ལ་བསམ་བློ་མི་གཏོང༌བར། ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་དོན་རྣམས་ལ་བསམ་བློ་གཏོང་དགོས།"]},{"type":"verse","number":3,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཤི་ཟིན་པ་དང་རང་གི་ཚེ་སྲོག་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་དཀོན་མཆོག་གི་ནང་དུ་སྦས་ཡོད་པས༌སོ།།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་བདག་ཅག་གི་ཚེ་སྲོག་ཡིན༌ལ། ཁོང་ཉིད་ཕྱིར་མངོན་པའི་དུས༌སུ། ཁྱོད་རྣམས་ཀྱང་ཁོང་དང་ལྷན་ཅིག་གཟི་བརྗིད་ནང་དུ་མངོན་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":5,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱི་འཇིག་རྟེན་ཏུ་གཏོགས་པའི་ཡན་ལག་སྟེ། ལོག་གཡེམ༌དང༌། མི་ཚངས༌སྤྱོད། འདོད༌ཆགས། འདོད་ངན། བརྣབ་སེམས་སོགས་རྩ་བ་ནས་དོར༌ཅིག བརྣབ་སེམས་ནི་སྐུ་འདྲར་བརྟེན་པ་དང་མཚུངས་པའོ།།"]},{"type":"verse","number":6,"content":["དོན་དེ་དག་གི་དབང༌གིས། དཀོན་མཆོག་གི་བཀའ་ལ་མི་ཉན་པ་རྣམས་ལ་ཁོང་ཉིད་ཀྱི་ཐུགས་ཁྲོ་འཕོག་པར་འགྱུར༌ངེས་ཡིན།"]},{"type":"verse","number":7,"content":["དེ་སྔར་ཁྱོད་རྣམས་ཀྱང་དོན་དེ་དག་གི་ནང་དུ་འཚོ་བའི་སྐབས་སུ་དེ་ལྟར་བྱས་མྱོང༌མོད།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་དོན་དེ་ཐམས་ཅད༌དང༌། གཞན་ཡང༌། ཞེ་སྡང༌དང༌། ཁོང༌ཁྲོ། གདུག༌རྩུབ། འཕྱ༌སྨོད། ངག་ནས་ཚིག་ངན་སྨྲ་བ་བཅས་རིང་དུ་དོར༌ཅིག"]},{"type":"verse","number":9,"content":["ཕན་ཚུན་ལ་རྫུན་སྨྲ་བར་མི༌བྱའོ།། རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཀྱིས་སྔར་གྱི་གཤིས་ཀ་རྙིང་པ་དང་དེའི་སྤྱོད་ངན་དོར་ཟིན་པས།"]},{"type":"verse","number":10,"content":["གཤིས་ཀ་གསར་པ་ནི་གྱོན་དགོས་ཤིང་། དེ་ནི་རང་ཉིད་སྐྲུན་མཁན་གྱི་སྣང་བརྙན་ལྟར། ཤེས་བྱའི་ཐད་ནས་རིམ་བཞིན་བསྐྱར་གསོ་མཛད་པ་ཡིན།"]},{"type":"verse","number":11,"content":["དོན་དེའི་ཐད་ནས་གྷི་རིག་པ་དང་ཡ་ཧུ་དཱ༌པ། མཚན་སྐྱི་བཅད་པའམ་མ་བཅད༌པ། མཐའ་འཁོབ་པ། སི་ཁེའུ་ཐེ་ཟི་པ། གཡོག་པོ། རང་དབང་ཅན་བཅས་ལ་ཁྱད་པར་ཅི་ཡང་མེད༌ཅིང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་ཐམས་ཅད་ཀྱི་སྙིང་པོ་ཡིན་པ་དང་ཐམས་ཅད་ཀྱི་ནང་དུ་བཞུགས་སོ།།"]},{"type":"verse","number":12,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ནི་དཀོན་མཆོག་གིས་བདམས་པའི་མི༌སྟེ། དམ་པ་དང་གཅེས་པར་འཛིན་པ་རྣམས་ཡིན་པས། སྙིང་རྗེ༌དང༌། བྱམས༌བརྩེ། ཁེངས༌སྐྱུང༌། ཞི༌དུལ། བཟོད་པ་བཅས་ཀྱི་སེམས་པ་གྱོན་དགོས༌ཤིང༌།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ལས་སུ་དང་སུ་ཞིག་གི་བར་དུ་འགལ་བ་ཡོད༌ན། གང་ལྟར་ཡང་ཕན་ཚུན་ལ་བཟོད་པ་དང་གུ་ཡངས་བྱེད་དགོས༌ཏེ། གཙོ་བོས་ཇི་ལྟར་ཁྱོད་རྣམས་ལ་དགོངས་དག་གནང་བ༌བཞིན། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་མི་གཞན་ལ་གུ་ཡངས་གཏོང་དགོས།"]},{"type":"verse","number":14,"content":["དོན་དེ་ཐམས་ཅད་ལས༌གཞན། ཁྱོད་རྣམས་ཀྱིས་བྱམས་པ་གྱོན་དགོས༌ཏེ། བྱམས་པ་ནི་ཕན་ཚུན་མཐུན་པོ་ཡོང་བར་ཕུལ་དུ་བྱུང་བའི་སྦྲེལ་ཐག་ཡིན་ནོ།།"]},{"type":"verse","number":15,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཞི་བདེ་ནི་ཁྱོད་ཅག་གི་སེམས་ནང་དུ་དབང་སྒྱུར་མཁན་དུ་བྱ་དགོས། ཁྱོད་རྣམས་ཀྱང་དོན་དེའི་ཆེད་དུ་སྐུ་ལུས་གཅིག་གི་ནང་དུ་ཞལ་འབོད་གནང༌བ་ཡིན་ལ། ཁྱོད་ཅག་ལ་དྲིན་གཟོ་བའི་སེམས་དགོས་སོ།།"]},{"type":"verse","number":16,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བཀའ་ནི་ཁྱོད་ཅག་གི་སེམས་ནང་དུ་གཏམས་པར་བཅུག༌སྟེ། ཤེས་རབ་སྣ་ཚོགས་ལ་བརྟེན་ནས་གསུང་མགུར༌དང༌། བསྟོད༌དབྱངས། མགུར་གླུ་བཅས་ཀྱི་ཚིག་དོན་བཀོལ་ནས་ཕན་ཚུན་ལ་སློབ་སྟོན་དང་སྐུལ་མ་གནང་བ་དང༌། བཀའ་དྲིན་དྲན་བཞིན་སེམས་གཏིང་ནས་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་འོས་པ་ཡིན།"]},{"type":"verse","number":17,"content":["གཞན༌ཡང༌། གཏམ་སྨྲ་བའམ་དོན་གང་ཞིག་སྒྲུབ་ཀྱང་གཙོ་བོ་ཡེ་ཤུའི་མཚན་ལ་བརྟེན་ནས་བསྒྲུབ་དགོས་པ༌དང༌། ཁོང་ཉིད་བརྒྱུད་ནས་ཡབ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་དགོས༌སོ།།"]},{"type":"heading","content":["དད་ལྡན་པའི་ཁྱིམ་ཚང་གི་འགྲིག༌ལམ་སྐོར།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཅག་ཆུང་མ་རྣམས་ཀྱིས་རང་རང་གི་ཁྱོ་ག་དང་བསྟུན་པར༌གྱིས། འདི་ནི་གཙོ་བོ་ལ་གཏོགས་པའི་མི་རྣམས་ལ་མཚོན་ན་འོས་ཤིང་འཚམ་པ་ཡིན།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་ཁྱོ་ག་རྣམས་ཀྱིས་རང་རང་གི་ཆུང་མར་བྱམས་ཤིང་གཅེས་དགོས་པ༌ལས། ཁོ་མོ་རྣམས་སྡུག་ལ་སྦྱར་མི་རུང༌ངོ་།།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཅག་བུ་ཕྲུག་རྣམས་ཀྱིས་སྒོ་ཀུན་ནས་ཕ་མའི་ངག་ལ་མཉན་དགོས༌ཏེ། འདི་ལྟར་བྱས་ན་གཙོ་བོ་ཐུགས་མཉེས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཅག་ཕ་ཡིན་པ་རྣམས་ཀྱིས་རང་གི་བུ་ཕྲུག་ལ་ཁོང་ཁྲོ་སློང་བར་མི་བྱ༌སྟེ། དེ་ལྟར་བྱས་ན་བུ་ཕྲུག་དག་གི་སེམས་ཕམ་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཅག་གཡོག་པོ་རྣམས་ཀྱིས་སྒོ་ཀུན་ནས་རང་གི་ལུས་ཕུང་གི་བདག་པོ་དེའི་ངག་ལ་མཉན་དགོས་པ༌དང༌། བདག་པོ་ལ་ངོ་སོ་བྱེད་པ་ལྟར་མིག་མདུན་ཁོ་ནར་ཁ་ལེན་ཚིག་བརྩི་མི་བྱེད༌པར། གཙོ་བོ་ལ་གུས་ཤིང་འཇིགས་པ་བཞིན༌དུ་ལྷག་བསམ་རྣམ་དག་གིས་བརྩི་བཀུར་བྱ་དགོས།"]},{"type":"verse","number":23,"content":["ཁྱོད་རྣམས་ཀྱིས་དོན་གང་ཞིག་སྒྲུབ་ཀྱང་ལྷག་བསམ་རྣམ་དག་གིས་བསྒྲུབ་དགོས༌ཤིང༌། དེ་ནི་མི་གཞན་གྱི་ཆེད་དུ་མ་ཡིན་པར་གཙོ་བོའི་ཆེད་དུ་སྒྲུབ་པ་བཞིན་ཡིན་དགོས།"]},{"type":"verse","number":24,"content":["ཅིའི་ཕྱིར་ཞེ་ན། གཙོ་བོ་ནས་བགོ་སྐལ་གྱི་བྱ་དགའ་ཁྱོད་ཅག་ལ་འཐོབ་ངེས་པ་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཤེས་པའི་ཕྱིར༌ཡིན། ཁྱོད་རྣམས་ཀྱིས་བསྙེན་བཀུར་བྱེད་པ་ནི་གཙོ་བོ་མཱ་ཤི་ཀ་ལགས་སོ།།"]},{"type":"verse","number":25,"content":["ངན་པ་བྱེད་མཁན་ལ་ངན་པ་བྱས་པའི་འབྲས་བུ་འཐོབ་པར་འགྱུར༌ཞིང༌། དཀོན་མཆོག་ལ་ཕྱོགས་རིས་ཅི་ཡང་མེད་དོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/COL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/COL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/COL/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}