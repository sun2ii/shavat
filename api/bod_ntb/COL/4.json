{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"COL","translationId":"bod_ntb","name":"ཀོ་ལོ་སཱ་པ།","commonName":"ཀོ་ལོ་སཱ་པ།","title":"༄༅། །ཀོ་ལོ་སཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":51,"numberOfChapters":4,"sha256":"498723712519fee5388b12be9acd66a5ab4427d8ca13937d7d8b46ca6b1e94c3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/COL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/COL/4.json","totalNumberOfVerses":95},"chapter":{"number":4,"content":[{"type":"heading","content":["དད་ལྡན་རྣམས་ལ་གདམས༌པ།"]},{"type":"verse","number":1,"content":["ཁྱོད་ཅག་བདག་པོ་རྣམས་ཀྱིས་རང་རང་གི་གཡོག་པོ་རྣམས་དྲང་གཞག་དང་འདྲ་མཉམ་གྱི་ངང་ནས་སྐྱོང་དགོས། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཅག་གིས་རང་རང་ལའང་ནམ་མཁའི་ཞིང་ཁམས་སུ་བདག་པོ་ཞིག་ཡོད་པ་ཤེས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་གཟབ་གཟབ་ངང་བཀའ་དྲིན་དྲན་བཞིན་དཀོན་མཆོག་ལ་གསོལ་བ་འདེབས་པར་བརྩོན་པར་གྱིས།"]},{"type":"verse","number":3,"content":["ངེད་རྣམས་ཀྱི་ཆེད་དུའང་གསོལ་བ་འདེབས་དགོས༌ཤིང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་གསང་བ་དེ་ཉིད་འཆད་པའི༌ཕྱིར། དཀོན་མཆོག་གིས་ངེད་ཅག་ལ་བཀའ་སྒྲོག་པའི་སྒོ་ཕྱེ་བར་གསོལ་བ་འདེབས་པར་གྱིས། དོན་དེའི་ཕྱིར་ང་རང་བཙོན་དུ་སྦྱར༌བའོ།།"]},{"type":"verse","number":4,"content":["ཡང་བདག་གིས་བརྗོད་དགོས་པ་བཞིན་གསང་བ་འདི་གསལ་པོར་འཆད་ཐུབ་པའི་ཞུ་བ་ཕུལ༌ཞིག"]},{"type":"verse","number":5,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་ཆུ་ཚོད་དམ་འཛིན་དང་བློ་གྲོས་ལྡན་པའི་སྒོ་ནས་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་འབྲེལ་འདྲིས་བྱེད་དགོས།"]},{"type":"verse","number":6,"content":["ཁྱོད་ཅག་གི་ངག་གི་སྦྱོར་བ་ནི་སྙན་ཞིང་ལན་ཚྭ་བཏབ་པ་ལྟ་བུ་ཡིན་དགོས། དེ་ནས་མི་རེ་རེར་ཇི་ལྟར་ལན་འདེབས་དགོས་པ་ཤེས་པར་འགྱུར༌རོ།།"]},{"type":"heading","content":["མཇུག་མཐའི་འཚམས༌ཞུ།"]},{"type":"verse","number":7,"content":["སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ་ཐི་ཀེ་ཀུ་ཡིས་བདག་གི་གནས་ཚུལ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་སྨྲ་བར་འགྱུར་རོ།། ཁོ་རང་ནི་བློ་སེམས་དཀར་བའི་ཞབས་ཕྱི་པ་ཞིག༌དང༌། བདག་དང་མཉམ་དུ་གཙོ་བོའི་ཞབས་ཏོག་པ་ཞིག་ཀྱང་ཡིན།"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ལ་ངེད་ཅག་གི་གནས་ཚུལ་ཤེས་སུ་འཇུག་པ་དང༌། ཁོས་ཁྱོད་ཅག་ལ་སེམས་གསོ་བྱེད་པའི༌ཕྱིར། བདག་གིས་ཁོ་རང་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་ཆེད་མངགས་བྱས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["ཡང་སྙིང་ནས་བརྩེ་ཞིང་བློ་སེམས་དཀར་བའི་སྤུན་ཟླ་ཨོ་ནེ་སི་མུ་ཡང་ཐི་ཀེ་ཀུ་དང་མཉམ་དུ་མངགས༌ཤིང༌། ཁོ་རང་ཡང་ཁྱོད་ཅག་གི་ཡུལ་དེ་གའི་མི་ཡིན༌ཞིང༌། ཁོ་གཉིས་ཀྱིས་ཡུལ་འདི་གའི་གནས་ཚུལ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་སྨྲ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":10,"content":["བདག་དང་མཉམ་དུ་ཡོད་པའི་བཙོན་གྲོགས་ཨ་རི་སྟར་ཀུ་དང༌། པཱར་ན་པཱའི་ཚ་བོ་མཱར་ཀུ་གཉིས་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་ལ་འཚམས་འདྲི༌ཞུའོ།། མཱར་ཀུ་ཞེས་བྱ་བ་གླེང༌ན། འདིའི་སྐོར་གྱི་བཀའ་ནི་སྔར་ནས་ཁྱོད་ཅག་ལ་ཐོབ༌ཅིང༌། མཱར་ཀུ་ཁོ་རང་ཁྱོད་ཅག་གི་ཡུལ་དེར་སླེབས༌ན། ཁྱོད་ཅག་གིས་ཁོ་རང་ལ་བསུ་བ་བྱེད་དགོས།"]},{"type":"verse","number":11,"content":["མིང་གཞན་ལ་ཡུས་ཐོ་ཟེར་བའི་ཡེ་ཤུ་ཡིས་ཀྱང་ཁྱོད་ཅག་ལ་འཚམས་འདྲི༌ཞུའོ།། མཚན་སྐྱི་བཅད་པའི་དད་ལྡན་རྣམས་ཀྱི་ཁྲོད་ན་མི་འདི་གསུམ་པོ་ནི་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་དོན་དུ། བདག་དང་མཉམ་དུ་ཆོས་སྤེལ་མཁན་ཁོ་ན་ཡིན་ལ། བདག་ལ་སེམས་གསོ་བྱེད་མཁན་ཡང་ཡིན།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཅག་གི་ཡུལ་མི་སྟེ་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ཞབས་ཕྱི་པ་ཨེ་པབ་རཱ་བྱ་བས་ཀྱང་ཁྱོད་རྣམས་ལ་འཚམས་འདྲི༌ཞུའོ།། ཁོས་རྟག་ཏུ་ཁྱོད་རྣམས་ཀྱི་ཕྱིར་ནན་ཏན་གྱིས་འདི་ལྟར་གསོལ་བ་བཏབ་པ་སྟེ། དཀོན་མཆོག་གི་ཐུགས་དགོངས་ཡོངས་སུ་ཁྱོད་རྣམས་ཆ་ཚང་བ་དང༌། བློ་གདེང་དང་བཅས་ཚུགས་ཐུབ་པ་དེའོ།།"]},{"type":"verse","number":13,"content":["ཨེ་པབ་རཱ་ཡིས་ཁྱོད་ཅག༌དང༌། ཡང་ལའོ་དི་ཀེ་ཡཱ་དང་ཧི་རཱ་པོ་ལི་རུ་གནས་པའི་སྤུན་ཟླ་རྣམས་ཀྱི་དོན་དུ་འབད་པ་ཆེན་པོ་བྱེད་ཅིང་། བདག་གིས་ཀྱང་དོན་འདིར་བདེན་དཔང་བྱེད་ནུས༌པ་ཡིན།"]},{"type":"verse","number":14,"content":["སྙིང་ནས་བརྩེ་བའི་སྨན་པ་ལོ་ཀུ་དང་ཏི་མཱ་གཉིས་ཀྱིས་ཀྱང་ཁྱོད་ཅག་ལ་འཚམས་འདྲི༌ཞུའོ།།"]},{"type":"verse","number":15,"content":["ལའོ་དི་ཀེ་ཡཱ་རུ་ཡོད་པའི་སྤུན་ཟླ་རྣམས༌དང༌། ནིམ་ཕཱ་དང་ཁོ་མོའི་ཁྱིམ་དུ་འདུས་པའི་ཆོས་ཚོགས་བཅས་ལའང་འཚམས་འདྲི་ཞུ་བར༌བྱའོ།།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཅག་གི་ཁྲོད་ནས་འཕྲིན་ཡིག་འདི་བཀླགས་ཚར༌རྗེས། ལའོ་དི་ཀེ་ཡཱ་རུ་ཡོད་པའི་ཆོས་ཚོགས་ལ་སྤྲད་ནས་ཁོ་རྣམས་ལའང་ཀློག་ཏུ་འཇུག་དགོས༌ཤིང༌། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ལའོ་དི་ཀེ་ཡཱ་ནས་བསྐུར་ཡོང་བའི་འཕྲིན་ཡིག་བཀླག་དགོས།"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱིས་ཨར་ཀི་པུ་ལ། གཙོ་བོས་ཁྱོད་ལ་གནང་བའི་ལས་འགན་དེ་ནན་ཏན་གྱིས་བསྒྲུབ་དགོས་ཞེས་སྨྲ་བར༌མཛོད།"]},{"type":"verse","number":18,"content":["ཕོལ་ལོལ་བདག་གིས་ཁྱོད་རྣམས་ལ་འཚམས་འདྲི་ཞུ་བ་འདི་ནི་དངོས་སུ་བྲིས་པ་ཡིན། ཁྱོད་རྣམས་ཀྱིས་ང་རང་བཙོན་དུ་ཡོད་པ་དྲན་པར༌གྱིས། མཇུག་མཐར་ཐུགས་རྗེ་ནི་རྟག་ཏུ་ཁྱོད་ཅག་དང་མཉམ་དུ་གནས་པར༌སྨོན།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/COL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1TH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/COL/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}