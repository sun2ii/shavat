{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":10,"content":[{"type":"heading","content":["དཱ་ནེ་ཨེལ་ལ་ཕོ་ཉ་ཞིག་འབྱོར་བ།"]},{"type":"verse","number":1,"content":["ཏ་ཟིག་རྒྱལ་པོ་ཀོ་རེས་ཀྱི་སྲིད་ལོ་གསུམ་པར། པེལ་ཏེ་ཤཱ་ཙར་ཞེས་ཀྱང་འབོད་པའི་དཱ་ནེ་ཨེལ་ལ་དོན་ཞིག་མངོན་པར་མཛད་པ་དང་། དེ་ནི་དོན་དངོས་ཡིན་ཞིང་དམག་འཁྲུག་ཆེན་པོ་ཞིག་གི་སྐོར་ཡིན་ལ། དཱ་ནེ་ཨེལ་གྱིས་དོན་དེ་ཤེས་པ་དང་ཞལ་གཟིགས་དེར་རྒྱུས་ཡོད་པ་ཡིན།"]},{"type":"verse","number":2,"content":["སྐབས་དེར་དཱ་ནེ་ཨེལ་བདག་ནི་བདུན་ཕྲག་གསུམ་གྱི་རིང་ལ་སེམས་སྡུག་གིས་ཁེངས་ཤིང་།"]},{"type":"verse","number":3,"content":["ངས་ཟས་ཞིམ་པོ་གང་ཡང་མ་ཟོས་ལ། རྒུན་ཆང་དང་ཤ་ཚིལ་གང་ལའང་ཁ་མ་རེག བདུན་ཕྲག་ཧྲིལ་པོ་གསུམ་གྱི་རིང་དུ་རང་གི་ལུས་ལ་སྣུམ་ཡང་མ་བྱུགས་སོ། །"]},{"type":"verse","number":4,"content":["ཟླ་བ་དང་པོའི་ཚེས་ཉེར་བཞིའི་ཉིན། ང་རང་ཧི་དཱི་ཀེལ་གཙང་པོ་ཆེན་པོའི་འགྲམ་ངོགས་སུ་བསྡད་ཅིང་།"]},{"type":"verse","number":5,"content":["སྐབས་དེར་བདག་གིས་མགོ་ཡར་བཀྱགས་ནས་བལྟས་པ་ན། ཀྱེ་མ། སོ་རས་ཀྱི་ན་བཟའ་མནབས་པ་དང་སྐུ་རྐེད་ལ་ཨུ་ཕཱ་ཟིའི་གསེར་བཙོ་མའི་སྐ་རགས་བཅིངས་པའི་སྐྱེས་བུ་ཞིག་ཡོད་དེ།"]},{"type":"verse","number":6,"content":["ཁོང་གི་སྐུ་ལུས་ནི་བཻཌཱུརྱ་ལྗང་སེར་དང་མཚུངས་ཤིང་། ཞལ་རས་ནི་གློག་དམར་འཁྱུག་པ་དང་འདྲ་ལ། སྤྱན་ཟུང་ནི་མེ་ཡི་དཔལ་འབར་དང་མཚུངས། ཁོང་གི་ཕྱག་ངར་དང་ཞབས་རྐང་ནི་འོད་ཆེམ་ཆེམ་འཕྲོ་བའི་ལི་དང་མཚུངས། གསུང་སྨྲ་བའི་སྐད་ནི་མི་ཚོགས་ཀྱིས་སྐད་སྒྲ་སྒྲོག་པ་དང་མཚུངས་སོ། །"]},{"type":"verse","number":7,"content":["དཱ་ནེ་ཨེལ་བདག་གཅིག་པུས་ཞལ་གཟིགས་དེ་མཐོང་བ་ལས། བདག་དང་ལྷན་དུ་སྡོད་པའི་མི་གཞན་རྣམས་ཀྱིས་མཐོང་མ་སོང་མོད། འོན་ཀྱང་ཁོ་རྣམས་དངངས་སྐྲག་ཆེན་པོས་ཟིན་ཅིང་བྲོས་ནས་ཡིབས་པའོ། །"]},{"type":"verse","number":8,"content":["དེའི་ཕྱིར་བདག་གཅིག་པུ་གནས་དེར་ལུས་ཤིང་། བདག་གིས་ཞལ་གཟིགས་ངོ་མཚར་ཅན་དེ་མཐོང་བ་ན། ལུས་སྟོབས་ཟད་ཅིང་ངོ་མདངས་ཉམས་ནས་སྟོབས་ཤུགས་ཅི་ཡང་མེད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ངས་ཁོང་གི་གསུང་སྐད་ཐོས་བྱུང་ལ། ཁོང་གི་གསུང་སྐད་ཐོས་པ་ཙམ་གྱིས་བདག་ལ་གཉིད་ལྕི་མོ་ཁུགས་ཏེ་གདོང་སར་བཏུད་ནས་བསྡད་དོ། །"]},{"type":"verse","number":10,"content":["ལྟོས་དང་། ཕྱག་གིས་བདག་ལ་རེག་ཅིང་། བདག་པུས་མོ་དང་ལག་མཐིལ་ལ་བརྟེན་ནས་ཡར་ལང་དུ་བཅུག"]},{"type":"verse","number":11,"content":["ཁོང་གིས་བདག་ལ་འདི་སྐད་དུ། ཀྱེ། ཤིན་ཏུ་གཅེས་པའི་སྐྱེས་བུ་དཱ་ནེ་ཨེལ། ངས་ཁྱོད་ལ་བརྗོད་པའི་ཚིག་རྣམས་རྟོགས་པར་གྱིས་དང་། བདག་ནི་ད་ལྟ་ཁྱོད་ཀྱི་གམ་དུ་མངགས་པ་ཡིན་པས་ཁྱོད་ཡར་ལོངས་ཤིག་ཅེས་གསུངས་སོ། །ཁོང་གིས་བདག་ལ་དེ་ལྟར་གསུང་བའི་དུས་སུ། བདག་ནི་སྐྲག་སྐྲག་འདར་འདར་ངང་ཡར་ལངས་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ཡང་ཁོང་གིས་འདི་སྐད་དུ། དཱ་ནེ་ཨེལ་ཁྱོད་མ་སྐྲག་ཅིག གང་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་དོན་འདི་རྣམས་རྟོགས་པར་སེམས་ཐག་བཅད་པ་དང་ཡང་རང་གི་དཀོན་མཆོག་གི་སྤྱན་སྔར་ཁེངས་སྐྱུང་བྱས་པའི་ཉིན་དང་པོ་ནས་བཟུང་། ཁྱོད་ཀྱིས་སྨོན་ལམ་བཏབ་པ་རྣམས་དཀོན་མཆོག་གིས་གསན་ཡོད་པས་ན། བདག་ནི་ཁྱོད་ཀྱི་སྨོན་ལམ་ལ་ལན་འདེབས་པའི་ཆེད་དུ་འདིར་འོངས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་ཏ་ཟིག་རྒྱལ་ཁམས་ཀྱི་སྐུ་སྲུང་ཕོ་ཉས་ཉིན་ཞག་ཉེར་གཅིག་གི་རིང་ལ་ང་རང་བཀག་བྱུང་། དེ་ནས་ཕོ་ཉའི་མཆོག་མེའ་ཀཱ་ཨེལ་བདག་གི་དཔུང་རོགས་སུ་འོངས་པ་དང་། ང་རང་ཏ་ཟིག་གི་རྒྱལ་པོ་རྣམས་དང་མཉམ་དུ་དེར་བསྡད་པ་ཡིན།"]},{"type":"verse","number":14,"content":["ད་ལྟ་བདག་འོངས་པ་ནི་ཁྱོད་ཀྱིས་རང་གི་མི་སྡེ་ལ་མཐའ་མའི་ཉིན་མོ་དག་ལ་ཅི་ཞིག་འབྱུང་བར་འགྱུར་བ་དེ་རྟོགས་པའི་ཆེད་དུ་ཡིན། རྒྱུ་མཚན་ནི་ཞལ་གཟིགས་དེ་ནི་འབྱུང་འགྱུར་གྱི་ཉིན་མོ་དག་ལ་འབྲེལ་བ་ཡོད་པས་སོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ཁོང་གིས་བདག་ལ་གཏམ་འདི་དག་གླེང་བའི་སྐབས་སུ་ང་རང་གདོང་སར་བཏུད་ནས་བསྡད་ཅིང་ལྐུག་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":16,"content":["ཡང་ལྟོས་དང་། མིའི་བུ་དང་འདྲ་བ་ཞིག་གིས་བདག་གི་མཆུ་སྒྲོས་ལ་རེག་པ་དང་། བདག་གིས་ཁ་གདངས་ནས་ངའི་མདུན་དུ་ལངས་འདུག་པ་དེ་ལ་གཏམ་སྨྲས་ཏེ། ཀྱེ་ང་ཡི་ཇོ་བོ་ལགས། ཞལ་གཟིགས་དེའི་རྐྱེན་གྱིས་བདག་ལ་སྡུག་བསྔལ་ཆེ་ཞིང་སྟོབས་ཤུགས་ཅི་ཡང་མེད་པར་གྱུར།"]},{"type":"verse","number":17,"content":["བདག་གི་ཇོ་བོའི་ཞབས་ཕྱི་བདག་གིས་ཇོ་བོ་ཁྱེད་ལ་གླེང་མོལ་བྱེད་ག་ལ་རུང་། ད་ལྟ་བདག་གི་ལུས་ཡོངས་ལ་སྟོབས་ཤུགས་ཅི་ཡང་མེད་ལ་དབུགས་ཀྱང་ཆད་ལ་ཁད་ཡོད་ཅེས་ཞུས་པ་ན།"]},{"type":"verse","number":18,"content":["ཡང་མི་ཡི་བྱད་གཟུགས་དང་མཚུངས་པ་དེས་བདག་ལ་རེག་ནས་སྟོབས་ཤུགས་ཡོད་པར་མཛད་དོ། །"]},{"type":"verse","number":19,"content":["ཁོང་གིས་འདི་སྐད་དུ། ཀྱེ། ཤིན་ཏུ་གཅེས་པའི་སྐྱེས་བུ་ཁྱོད་མ་འཇིགས་ཤིག ཁྱོད་རང་བདེ་བར་སྨོན། ད་ནི་ཁྱོད་རང་བློ་རྩ་བརྟན་པོ་གྱིས་ཤིག ཁྱོད་རང་བློ་རྩ་བརྟན་པོ་གྱིས་ཤིག་ཅེས་གསུངས་སོ། །ཁོང་གིས་བདག་ལ་དེ་སྐད་གསུང་བའི་མོད་ལ། བདག་ནི་སྟོབས་དང་ལྡན་པར་གྱུར་ཏེ་འདི་ལྟར། བདག་གི་ཇོ་བོ་ལགས། ཁྱེད་ལས་བདག་ལ་སྟོབས་ཤུགས་འཛོམས་པ་ཡིན་པས། ཁྱེད་ཀྱིས་གསུང་གནང་བར་མཛོད་ཅེས་ཞུས་པའོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཁོང་གིས་འདི་སྐད་དུ། ང་ཅིའི་ཕྱིར་ཁྱོད་ཀྱི་གམ་དུ་འོངས་པ་ཁྱོད་ཀྱིས་ཤེས་སམ། ད་ལྟ་བདག་ནི་ཏ་ཟིག་གི་སྐུ་སྲུང་ཕོ་ཉར་འཐབ་མོ་བྱེད་དུ་འགྲོ་བ་ཡིན། ང་རང་སོང་རྗེས་གྷི་རི་སི་ཡི་སྐུ་སྲུང་ཕོ་ཉ་ཡོང་ངེས་ཡིན།"]},{"type":"verse","number":21,"content":["ཐོག་མར་བདེན་པའི་གསུང་རབ་ཏུ་ཅི་ཞིག་བཀོད་ཡོད་པ་དེ་བདག་གིས་ཁྱོད་ལ་སྟོན་པར་བྱ། ཁྱོད་ཀྱི་སྐུ་སྲུང་ཕོ་ཉ་མེའ་ཀཱ་ཨེལ་ལས་གཞན་བདག་ལ་རོགས་བྱས་ནས་བདག་དང་མཉམ་དུ་དེ་དག་ལ་འགོག་རྒོལ་བྱེད་མཁན་གཅིག་ཀྱང་མེད་དོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DAN/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}