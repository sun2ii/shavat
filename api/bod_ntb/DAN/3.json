{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":3,"content":[{"type":"heading","content":["རྒྱལ་པོས་བསྒྲེངས་པའི་གསེར་སྐུ།"]},{"type":"verse","number":1,"content":["རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་མཐོ་ཚད་ལ་ཁྲུ་དྲུག་ཅུ་དང་ཞེང་ལ་ཁྲུ་དྲུག་ཅན་གྱི་གསེར་སྐུ་ཞིག་བཞེངས་ནས་པཱ་པེལ་ལོན་ཡུལ་གྱི་དོའུ་རཱ་ཐང་དུ་ཀེ་རེར་བསྒྲེངས་སོ། །"]},{"type":"verse","number":2,"content":["དེ་ནས་རྒྱལ་པོས་སྤྱི་དཔོན་དང་བཀའ་བློན། བློན་པོ། གྲོས་པ། དཀོར་གཉེར། ཁྲིམས་དཔོན། གཟུ་དཔང་བཅས་དང་མངའ་སྡེ་དེའི་སྐུ་དྲག་ཐམས་ཅད་ཁོས་བཞེངས་པའི་གསེར་སྐུའི་རབ་གནས་ཀྱི་ཆོ་གར་གདན་དྲངས་པས།"]},{"type":"verse","number":3,"content":["སྤྱི་དཔོན་དང་བཀའ་བློན། བློན་པོ། གྲོས་པ། དཀོར་གཉེར། ཁྲིམས་དཔོན། གཟུ་དཔང་བཅས་དང་མངའ་སྡེ་དེའི་སྐུ་དྲག་ཐམས་ཅད་མཉམ་དུ་འཛོམས་ནས། རྒྱལ་པོས་ཡར་བཞེངས་པའི་གསེར་སྐུ་ལ་རབ་གནས་བྱེད་པའི་ཆོ་གར་ཞུགས་ཤིང་། ཐམས་ཅད་གསེར་སྐུའི་མདུན་དུ་ལངས་ནས་བསྡད་དོ། །"]},{"type":"verse","number":4,"content":["དུས་དེ་ཙ་ན་བཀའ་སྒྲོག་མཁན་གྱིས་སྐད་གསང་མཐོན་པོས། ཀྱེ། རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སོ་སོའི་མི་ཐམས་ཅད་ཀྱིས་ཉོན་དང་། རྒྱལ་པོས་ཁྱོད་ཅག་ལ་བསྒོས་པའི་བཀའ་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཅག་གིས་རྭ་དུང་དང་གླིང་བུ། པི་ཝང་། ཏམ་བུ་ར། གཞུ་སྦྲེང་། སྦུད་གླིང་ལ་སོགས་རོལ་མོ་སྣ་ཚོགས་ཀྱི་སྒྲ་ཐོས་ཡོང་དུས། རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་བསྒྲེངས་པའི་གསེར་སྐུ་ལ་ལུས་སར་བཏུད་ནས་ཕྱག་འཚལ་དགོས།"]},{"type":"verse","number":6,"content":["སུ་ཞིག་གིས་ལུས་སར་བཏུད་ནས་ཕྱག་མ་བཙལ་ན། དེ་མ་ཐག་ཏུ་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་ཐབ་ལ་གཡུག་པར་བྱའོ་ཞེས་བསྒྲགས་སོ། །"]},{"type":"verse","number":7,"content":["དེ་བས་རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སོ་སོའི་མི་ཐམས་ཅད་ཀྱིས་རྭ་དུང་དང་གླིང་བུ། པི་ཝང་། ཏམ་བུ་ར། གཞུ་སྦྲེང་ལ་སོགས་རོལ་མོ་སྣ་ཚོགས་ཀྱི་སྒྲ་ཐོས་མ་ཐག་ཏུ། རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་བསྒྲེངས་པའི་གསེར་སྐུ་ལ་ཕྱག་བཙལ་ཏོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱ་པ་ཁ་ཅིག་ལ་སྙད་བཏགས་པ།"]},{"type":"verse","number":8,"content":["ཡང་དེའི་དུས་སུ་ཀལ་དི་པ་ཁ་ཅིག་རྒྱལ་པོའི་མདུན་དུ་ཕྱིན་ཏེ་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་གནོད་སེམས་ཆེན་པོས་སྙད་བཏགས་པ་སྟེ།"]},{"type":"verse","number":9,"content":["ཁོ་ཚོས་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ལ་འདི་ལྟར། རྒྱལ་པོའི་སྐུ་ཚེ་ཡུན་རིང་བརྟན་པར་ཤོག"]},{"type":"verse","number":10,"content":["ཀྱེ་རྒྱལ་པོ་ལགས། དེ་སྔར་ཁྱེད་ཀྱིས་རྭ་དུང་དང་གླིང་བུ། པི་ཝང་། ཏམ་བུ་ར། གཞུ་སྦྲེང་། སྦུད་གླིང་ལ་སོགས་རོལ་མོ་སྣ་ཚོགས་ཀྱི་སྒྲ་ཐོས་ཚད་ཀྱིས་གསེར་སྐུའི་མདུན་དུ་ལུས་སར་བཏུད་ནས་ཕྱག་འཚལ་དགོས་པ་དང་།"]},{"type":"verse","number":11,"content":["སུ་ཞིག་གིས་ལུས་སར་བཏུད་ནས་ཕྱག་མ་བཙལ་ན། དེ་མ་ཐག་ཏུ་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་ཐབ་ལ་གཡུག་པར་འགྱུར་བའི་བཀའ་གནང་བ་མ་ཡིན་ནམ།"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་རྒྱལ་པོ་ལགས། ཁྱེད་ཀྱིས་པཱ་པེལ་ལོན་ཡུལ་གྱི་སྲིད་འཛིན་དུ་བསྐོས་པའི་ཡ་ཧུ་དཱ་པ་ཁ་ཅིག་སྟེ། ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་གསུམ་པོས་ཁྱེད་ཀྱི་བཀའ་མི་བརྩི་བ་དང་། ཁྱེད་ཀྱི་ལྷ་ལ་ཞབས་ཏོག་མི་བསྒྲུབ་ཅིང་། ཉིད་ཀྱིས་བཞེངས་པའི་གསེར་སྐུ་ལ་གུས་ཕྱག་ཀྱང་མི་འཚལ་ལོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":13,"content":["ནེ་བོ་ཀད་ནེ་ཙར་ཁོང་ཁྲོ་རབ་ཏུ་འབར་ནས། ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་གསུམ་པོ་འཁྲིད་འོང་བའི་བཀའ་ཕབ་པ་ན། ཁོ་རྣམས་རྒྱལ་པོའི་མདུན་དུ་ཁྲིད་ཡོང་ངོ་། །"]},{"type":"verse","number":14,"content":["ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཁོ་རྣམས་ལ། ཀྱེ་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ ཁྱོད་ཅག་གིས་ངའི་ལྷ་ལ་ཞབས་ཏོག་མི་བསྒྲུབ་ཅིང་ངས་བཞེངས་པའི་གསེར་སྐུ་ལ་ཕྱག་ཀྱང་མི་འཚལ་ཞེས་པ་བདེན་ནམ།"]},{"type":"verse","number":15,"content":["ཅི་སྟེ་ད་ནི་ཁྱོད་ཅག་གིས་རྭ་དུང་དང་གླིང་བུ། པི་ཝང་། ཏམ་བུ་ར། གཞུ་སྦྲེང་། སྦུད་གླིང་ལ་སོགས་རོལ་མོ་སྣ་ཚོགས་ཀྱི་སྒྲ་ཐོས་པ་ཙམ་གྱིས། བདག་གིས་བཞེངས་པའི་གསེར་སྐུའི་མདུན་དུ་ལུས་སར་བཏུད་ནས་ཕྱག་འཚལ་བ་ཡིན་ན་ལེགས་ཤིང་། གལ་ཏེ་ཁྱོད་ཅག་གིས་དེར་ཕྱག་མ་བཙལ་ན་ད་ལྟ་ཉིད་དུ་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་ཐབ་ལ་གཡུག་པར་འགྱུར། དེའི་དུས་ལྷ་སུ་ཞིག་གིས་ཁྱོད་ཅག་བདག་གི་དབང་ལས་བསྐྱབ་ནུས་སམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་ཀྱིས་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ལ་ལན་དུ། ཀྱེ་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ལགས། ངེད་ཅག་གིས་འདིའི་སྐོར་ལ་ལན་འདེབས་དགོས་དོན་མི་འདུག"]},{"type":"verse","number":17,"content":["ངེད་ཅག་མེ་ཐབ་ནང་དུ་གཡུགས་པའི་དབང་དུ་བཏང་ནའང་། ངེད་ཅག་གིས་ཞབས་ཏོག་སྒྲུབ་པའི་དཀོན་མཆོག་གིས་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་མེ་ཐབ་དང་ཁྱེད་ཀྱི་དབང་ལས་བསྐྱབ་ངེས་ཡིན།"]},{"type":"verse","number":18,"content":["ཀྱེ་རྒྱལ་པོ་ལགས། དེ་འདྲ་མིན་ནའང་ཁྱེད་ཀྱི་སྙན་དུ་སྒྲོན་དགོས་པ་ཞིག་ལ། ངེད་ཅག་གིས་ཁྱེད་ཀྱི་ལྷ་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབ་མི་སྲིད་ལ་ཉིད་ཀྱིས་བསྒྲེངས་པའི་གསེར་སྐུ་ལ་ཕྱག་ཀྱང་མི་འཚལ་བ་མཁྱེན་པར་གྱུར་ཅིག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":19,"content":["སྐབས་དེར་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ནི་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་ཀྱི་སྟེང་དུ་ཁོང་ཁྲོ་མེ་ལྟར་འབར་ནས་ཐ་ན་ངོ་མདངས་ཀྱང་འགྱུར་ཏེ། མེ་ཐབ་དེ་རྒྱུན་ལྡན་ལས་ལྡབ་བདུན་གྱིས་ཚ་བར་བཟོ་རུ་བཅུག་པ་དང་།"]},{"type":"verse","number":20,"content":["དམག་དཔུང་ལས་དམག་མི་སྟོབས་པོ་ཆེ་འགའ་ལ། ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་དམ་པོར་བཀྱིགས་ནས་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་མེ་ཐབ་ནང་དུ་གཡུག་པའི་བཀའ་གནང་ངོ་། །"]},{"type":"verse","number":21,"content":["དེ་ནས་སྐྱེས་བུ་དེ་གསུམ་པོས་ཕྱི་གོས་དང་རྐང་སྣམ། མགོ་རས། དེ་མིན་གྱོན་པ་གཞན་དག་ལུས་ལ་གྱོན་ནས་ཐག་པས་དམ་པོར་བཀྱིགས་ཏེ་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་མེ་ཐབ་ནང་དུ་གཡུགས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ཡང་རྒྱལ་པོའི་བཀའ་དེ་ཛ་དྲག་ཆེ་བ་དང་། མེ་ཐབ་ནང་གི་མེ་འབར་བ་ཡང་ཤུགས་དྲག་པའི་རྐྱེན་གྱིས་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་མེ་ཐབ་ནང་དུ་རྫོང་མཁན་ཐམས་ཅད་མེས་ཚིག་པ་དང་།"]},{"type":"verse","number":23,"content":["ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་སྐྱེས་བུ་གསུམ་པོ་ནི་ཐག་པས་བཀྱིགས་ནས་མེ་ལྕེ་རབ་ཏུ་འབར་བའི་མེ་ཐབ་ནང་དུ་ལྷུང་ངོ་། །"]},{"type":"verse","number":24,"content":["དེའི་ཚེ་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ཤིན་ཏུ་ཧ་ལས་ཤིང་རྟབ་རྟབ་པོར་ཡར་ལངས་ཏེ་གྲོས་པ་དག་ལ་འདི་ལྟར། ང་ཚོས་སྐྱེས་བུ་གསུམ་བཀྱིགས་ནས་མེ་ཐབ་ཏུ་གཡུགས་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་པ་ན། དེ་ཚོས་ལན་དུ། ཀྱེ་རྒྱལ་པོ་ལགས། དེ་བཞིན་ཡིན་ནོ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":25,"content":["དེར་རྒྱལ་པོ་ན་རེ། འོན་ཀྱང་ངས་སྐྱེས་བུ་བཞི་མེའི་ནང་དུ་རྒྱུ་བ་མཐོང་བྱུང་། དེ་རྣམས་བཀྱིགས་མེད་ལ་རྨས་སྐྱོན་ཡང་བྱུང་མེད་པར་མ་ཟད། སྐྱེས་བུ་བཞི་པ་དེའི་བྱད་བཞིན་ནི་ལྷ་སྲས་ཤིག་དང་འདྲ་བོ་འདུག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་ནེ་བོ་ཀད་ནེ་ཙར་ནི་མེ་ལྕེ་རབ་དུ་འབར་བའི་མེ་ཐབ་ཁར་བཅར་ཏེ། ཀྱེ་བླ་ན་མེད་པའི་དཀོན་མཆོག་གི་ཞབས་ཕྱི་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་ཁྱེད་རྣམས་ཕྱི་རུ་ཐོན་ཤོག འདི་རུ་ཕེབས་དང་ཞེས་སྐད་བརྒྱབ་པ་ན། ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་པ་མེའི་ཁྲོད་ནས་ཕྱི་རུ་ཐོན་ནོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་སྤྱི་དཔོན་དང་བཀའ་བློན། བློན་པོ། རྒྱལ་པོའི་གྲོས་པ་བཅས་མཉམ་དུ་འདུས་ཏེ་སྐྱེས་བུ་དེ་གསུམ་པོར་རུབ་ནས་བལྟས་པ་ལ། མེ་ཡིས་ཁོ་ཚོའི་ལུས་སྟེང་དུ་སྐྱོན་ཅི་ཡང་བཟོ་མ་ཐུབ་པར་མ་ཟད། མགོའི་སྐྲ་ཉག་གཅིག་ཀྱང་ཚིག་མེད་པ་དང་གྱོན་གོས་དག་ཀྱང་བསྲེགས་མེད་ལ། ཐ་ན་ཁོ་ཚོའི་ལུས་སྟེང་ལ་དུ་བའི་དྲི་མ་ཙམ་ཡང་མི་བྲོ་བ་རེད།"]},{"type":"verse","number":28,"content":["དེ་ནས་ནེ་བོ་ཀད་ནེ་ཙར་ན་རེ། ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་ཀྱི་དཀོན་མཆོག་ནི་བསྟོད་ཅིང་བསྔགས་པར་འོས་ཏེ། ཁོང་གིས་ཕོ་ཉ་མངགས་ནས་ཁོང་ལ་བརྟེན་པའི་ཞབས་ཕྱི་རྣམས་བསྐྱབས་པ་རེད། ཁོ་ཚོས་རྒྱལ་པོའི་བཀའ་དང་འགལ་ནས་རང་སྲོག་འབེན་ལ་འཇོག་དགོས་བྱུང་ནའང་། རང་ཉིད་ཀྱི་དཀོན་མཆོག་མ་གཏོགས་ལྷ་གཞན་གང་ལ་ཡང་ཞབས་ཏོག་མི་བསྒྲུབ་ལ་ཕྱག་ཀྱང་མི་འཚལ་ལོ། །"]},{"type":"verse","number":29,"content":["དེ་བས་ན་བདག་གིས་བསྒོས་པའི་བཀའ་རྒྱ་ནི། རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སོ་སོའི་མི་ཐམས་ཅད་ཀྱིས་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་ཀྱི་དཀོན་མཆོག་ལ་སྐུར་བ་བཏབ་མི་ཆོག་ལ། གལ་ཏེ་སུ་ཞིག་གིས་སྐུར་བ་བཏབ་ན་དེ་ནི་དུམ་བུ་དུམ་བུར་གཏུབ་ཅིང་ཁང་པ་རྣམས་ཞིག་རོར་ལུས་པར་འགྱུར། གང་ལ་ཞེ་ན། འདི་ལྟར་བསྐྱབ་ནུས་པའི་དཀོན་མཆོག་གཞན་ཞིག་གཏན་ནས་ཡོད་མ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཤད་རག་དང་མེ་ཤག ཨ་བེད་ནེ་གོ་བཅས་ལ་པཱ་པེལ་ལོན་མངའ་སྡེ་ནས་གོ་གནས་མཐོན་པོ་སྤྲད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DAN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/2.json","previousChapterAudioLinks":{},"numberOfVerses":30}