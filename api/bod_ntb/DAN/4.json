{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":4,"content":[{"type":"heading","content":["ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ལྗོན་ཤིང་ཞིག་རྨི་ལམ་དུ་རྨིས་པ།"]},{"type":"verse","number":1,"content":["རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ས་སྟེང་གི་རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སྣ་ཚོགས་སྨྲ་མཁན་གྱི་མི་རྣམས་ལ་འདི་ལྟར་ཁྱབ་བསྒྲགས་བྱས་པ་སྟེ། ཁྱོད་རྣམས་ཞི་བདེའི་ངང་དར་ཞིང་རྒྱས་པར་ཤོག"]},{"type":"verse","number":2,"content":["ངས་ཁྱོད་ཅག་ལ་བླ་མེད་དཀོན་མཆོག་ཁོང་གིས་ང་ཡི་དོན་དུ་གྲུབ་རྟགས་དང་འཕྲིན་ལས་ངོ་མཚར་ཅན་ཅི་ཞིག་མཛད་པ་བརྗོད་འདོད་པ་ཡིན།"]},{"type":"verse","number":3,"content":[{"text":"ཁོང་གི་གྲུབ་རྟགས་ཅི་འདྲའི་རླབས་ཆེ་ཨང་། །","poem":1},{"lineBreak":true},{"text":"ངོ་མཚར་འཕྲིན་ལས་ཅི་འདྲའི་མཐུ་སྟོབས་ལྡན། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་རྒྱལ་སྲིད་ནམ་ཡང་བརྟན་ཞིང་བརླིང་། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་མི་རབས་ཀུན་ལ་རྒྱལ་སྲིད་སྐྱོང་། །","poem":1}]},{"type":"verse","number":4,"content":["ནེ་བོ་ཀད་ནེ་ཙར་བདག་ནི་རང་ཁྱིམ་ནས་སྐྱིད་པོར་བསྡད་དེ་ཕོ་བྲང་ནང་དུ་ཅི་དགར་ལོངས་སྤྱོད་ཆེན་པོར་རོལ་སྐབས།"]},{"type":"verse","number":5,"content":["བདག་གིས་རྨི་ལམ་ཞིག་རྨིས་ཤིང་དེས་བདག་ལ་འཇིགས་སྐྲག་བསླངས་པ་དང་། བདག་མལ་ཁྲིར་ཡོད་དུས་ཀྱི་འཆར་སྣང་དང་ཡིད་ལ་འཁོར་བའི་ཞལ་གཟིགས་ཀྱིས་ང་ལ་ཞེད་སྣང་ཆེན་པོ་བསྐུལ་བས།"]},{"type":"verse","number":6,"content":["བདག་གིས་པཱ་པེལ་ལོན་གྱི་མཁས་མཛངས་ལྡན་པ་ཐམས་ཅད་མདུན་དུ་བོས་ཏེ་རྨི་ལམ་དེའི་དོན་གསལ་པོར་སྨྲ་དགོས་པའི་བཀའ་ཕབ་པ་ཡིན།"]},{"type":"verse","number":7,"content":["དེ་བས་མོ་པ་དང་སྒྱུ་མ་མཁན། ཀལ་དི་པ། རྩིས་པ་བཅས་འཛོམས་པ་དང་། ངས་དེ་རྣམས་ལ་བདག་གི་རྨི་ལམ་བརྗོད་ནའང་། ཁོ་རྣམས་ཀྱིས་བདག་གི་རྨི་ལམ་དེར་འགྲེལ་བཤད་རྒྱག་མ་ནུས།"]},{"type":"verse","number":8,"content":["མཐར་བདག་གིས་བརྟེན་པའི་ལྷ་ཡི་མིང་བཞིན་དུ་པེལ་ཏེ་ཤཱ་ཙར་ཞེས་ཀྱང་འབོད་པ་དང་། ལྷ་དམ་པ་རྣམས་ཀྱི་ཐུགས་ཉིད་མངའ་བའི་དཱ་ནེ་ཨེལ་བདག་གི་མདུན་དུ་འོངས་ཤིང་ངས་ཁོ་ལ་རང་གི་རྨི་ལམ་སྨྲས་པ་སྟེ།"]},{"type":"verse","number":9,"content":["ཀྱེ་པེལ་ཏེ་ཤཱ་ཙར། ཁྱེད་ནི་མོ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ཡིན་ཏེ། ཁྱེད་ཀྱི་ནང་དུ་ལྷ་དམ་པ་རྣམས་ཀྱི་ཐུགས་ཉིད་བཞུགས་པས་ན་གསང་བའི་དོན་གང་གིས་ཀྱང་མགོ་མི་རྨོངས་པ་བདག་གིས་ཤེས། དེའི་ཕྱིར་བདག་གིས་རྨི་ལམ་དུ་མཐོང་བའི་ཞལ་གཟིགས་དང་རྨི་ལམ་གྱི་དོན་ང་ལ་སྨྲ་བར་མཛོད།"]},{"type":"verse","number":10,"content":["བདག་མལ་ཁྲིར་ཡོད་དུས་ཡིད་ལ་ཤར་བའི་ཞལ་གཟིགས་ནི་འདི་ལྟ་སྟེ། བདག་གིས་ས་གཞི་ཆེན་པོའི་དཀྱིལ་ལ་ཤིན་ཏུ་མཐོ་བའི་ལྗོན་ཤིང་ཞིག་ཡོད་པ་མཐོང་བྱུང་ལ།"]},{"type":"verse","number":11,"content":["ལྗོན་ཤིང་དེ་ཆེར་སྐྱེས་ནས་གསོན་ཤུགས་ལྡན་པ་དང་། རྩེ་མོ་ནམ་མཁར་ཟུག་ཅིང་ས་མཐའི་མི་ཐམས་ཅད་ཀྱིས་དེ་གསལ་པོར་མཐོང་ཐུབ་པ་ཞིག་འདུག"]},{"type":"verse","number":12,"content":["དེའི་ལོ་འདབ་རྣམས་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་དང་ཤིང་ཏོག་གིས་གང་ཞིང་། སྲོག་ལྡན་ཐམས་ཅད་ཀྱིས་དེ་ལས་ཁ་ཟས་ལོངས་སུ་སྤྱོད་ཀྱིན་འདུག ཐང་གི་རི་དྭགས་རྣམས་དེའི་བསིལ་གྲིབ་འོག་ཏུ་གནས་ཤིང་། ནམ་མཁའི་བྱ་རྣམས་ཀྱིས་དེའི་ཡལ་གའི་སྟེང་དུ་ཚང་བཟོས་ནས། སྲོག་ལྡན་ཀུན་གྱིས་ལྗོན་ཤིང་དེ་ལ་བརྟེན་ནས་འཚོ་བ་རོལ་ཏོ། །"]},{"type":"verse","number":13,"content":["མལ་ཁྲིར་ཡོད་དུས་བདག་གི་ཡིད་ལ་ཤར་བའི་ཞལ་གཟིགས་རྣམས་ལས། སོ་ལྟ་བྱེད་མཁན་ཕོ་ཉ་དམ་པ་ཞིག་ནམ་མཁའི་ཞིང་ཁམས་ནས་ཐད་ཀར་མི་ཡུལ་དུ་ཕེབས་བྱུང་།"]},{"type":"verse","number":14,"content":["ཕོ་ཉ་དེས་སྐད་གསང་མཐོན་པོས་འདི་སྐད་དུ། ཁྱོད་ཅག་གིས་ལྗོན་ཤིང་དེ་གཅོད་པར་གྱིས། ཡལ་ག་རྣམས་གཞོགས་ལ་ལོ་མ་རྣམས་སྤྲུགས་ཤིག ཤིང་ཏོག་རྣམས་ཀྱང་གཏོར་བར་གྱིས། ལྗོན་ཤིང་དེའི་འོག་ཏུ་གནས་པའི་རི་དྭགས་རྣམས་གང་སར་གཏོར་ཅིག ཡལ་གའི་སྟེང་དུ་གནས་པའི་བྱ་ཐམས་ཅད་ཕྱོགས་བཞིར་འཕུར་དུ་ཆུག"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་ལྗོན་ཤིང་གི་ཤིང་རྡུམ་དང་རྩད་པ་ནི་ལི་དང་ལྕགས་ཀྱི་ཐག་པས་བསྡམས་ནས་ཐང་གི་རྩྭ་སྔོན་ནང་དུ་བསྐྱུར་ལ་ནམ་མཁའི་ཟིལ་པར་ཁོ་རང་སྦང་དུ་ཆུག ཁོ་རང་རྩྭ་ཟན་རྣམས་དང་ལྷན་ཅིག་རྩྭ་གསེང་དུ་གཞིས་ཆགས་པར་གྱིས་ཤིག"]},{"type":"verse","number":16,"content":["ཁོའི་སེམས་ལ་འགྱུར་བ་ཐེབས་སུ་བཅུག་ནས། མི་ལོ་བདུན་",{"noteId":1},"འདའ་བའི་བར་དུ་ཁོ་ལ་མི་ཡི་སེམས་ནི་མི་ལྡན་ཞིང་དུད་འགྲོའི་སེམས་དང་ལྡན་པར་གྱིས།"]},{"type":"verse","number":17,"content":["འདི་ནི་སོ་ལྟ་བྱེད་མཁན་ཕོ་ཉ་དམ་པ་རྣམས་ཀྱིས་བསྒྲགས་པའི་བཀའ་རྒྱ་ཡིན་ལ། བླ་ན་མེད་པ་ཁོང་གིས་མི་ཡུལ་གྱི་རྒྱལ་སྲིད་ཀུན་ལ་དབང་སྒྱུར་ཞིང་། སུ་ཞིག་ལ་རྒྱལ་སྲིད་གནང་འདོད་ན་དེ་ལ་གནང་བ་དང་། ཐ་ན་ཆེས་ཉམས་ཞན་ཡིན་པ་དེར་སྲིད་དབང་ཡང་གནང་བ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["འདི་ནི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་བདག་གིས་རྨིས་པའི་རྨི་ལམ་ཡིན་པས། ད་ནི་པེལ་ཏེ་ཤཱ་ཙར་ཁྱེད་ཀྱིས་དེའི་དོན་བདག་ལ་སྨྲ་བར་མཛོད། གང་ལ་ཞེ་ན། བདག་གི་རྒྱལ་སྲིད་ནང་གི་མཁས་མཛངས་རྣམས་ཀྱིས་དེའི་དོན་བདག་ལ་གསལ་པོར་བཤད་མི་ཐུབ་བོ། །ཁྱེད་ཀྱི་ནང་དུ་ལྷ་དམ་པ་རྣམས་ཀྱི་ཐུགས་ཉིད་བཞུགས་པས་དེ་ལ་འགྲེལ་བཤད་རྒྱག་པའི་ནུས་པ་ཡོད་ཅེས་པའོ། །"]},{"type":"heading","content":["དཱ་ནེ་ཨེལ་གྱིས་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་རྨི་ལམ་ལ་བརྟག་པ།"]},{"type":"verse","number":19,"content":["དེ་ནས་མིང་ལ་པེལ་ཏེ་ཤཱ་ཙར་ཞེས་ཀྱང་འབོད་པའི་དཱ་ནེ་ཨེལ་ནི་ཡུད་ཙམ་ལ་ཧ་ལས་པར་གྱུར་ཅིང་། རང་གི་དྲན་ཚུལ་གྱིས་རང་ལ་འཇིགས་སྣང་བསྐུལ་བ་ཙམ་ལ། རྒྱལ་པོས་དེ་ལ། ཀྱེ་པེལ་ཏེ་ཤཱ་ཙར། རྨི་ལམ་དང་དེའི་དོན་གྱིས་འཇིགས་པར་མ་གྱུར་ཅིག་ཅེས་སྨྲས་པ་ན། པེལ་ཏེ་ཤཱ་ཙར་གྱིས་ལན་དུ། ངའི་ཇོ་བོ་ལགས། རྨི་ལམ་ནི་ཁྱེད་ཉིད་འཁོན་དུ་འཛིན་མཁན་རྣམས་དང་དེའི་དོན་ནི་ཁྱེད་ཀྱི་བསྟན་དགྲ་རྣམས་ཀྱི་སྐོར་ཡིན་ན་ཅི་མ་རུང་།"]},{"type":"verse","number":20,"content":["ཁྱེད་ཀྱིས་མཐོང་བའི་ལྗོན་ཤིང་དེ་ཆེར་སྐྱེས་ནས་གསོན་ཤུགས་ལྡན་པ་དང་། རྩེ་མོ་ནམ་མཁར་ཟུག་ཅིང་ས་མཐའི་མི་ཐམས་ཅད་ཀྱིས་དེ་གསལ་པོར་མཐོང་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":21,"content":["དེའི་ལོ་འདབ་རྣམས་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་དང་ཤིང་ཏོག་གིས་གང་ཞིང་། སྲོག་ལྡན་ཐམས་ཅད་ཀྱིས་དེ་ལས་ཁ་ཟས་ལོངས་སུ་སྤྱོད་དོ། །ས་སྟེང་གི་དུད་འགྲོ་རྣམས་དེའི་བསིལ་གྲིབ་འོག་ཏུ་གནས་ཤིང་། ནམ་མཁའི་བྱ་རྣམས་ཀྱིས་དེའི་ཡལ་གའི་སྟེང་དུ་ཚང་བཟོས་པའོ། །"]},{"type":"verse","number":22,"content":["ཀྱེ་ཧུད་རྒྱལ་པོ། ལྗོན་ཤིང་དེ་ནི་ཁྱེད་རང་ཡིན་ཏེ། ཁྱེད་ནི་རླབས་ཆེ་ཞིང་སྟོབས་ཅན་དུ་གྱུར་ནས་ཁྱེད་ཀྱི་ཟིལ་ཤུགས་ནམ་མཁར་ཟུག་པ་དང་། ཁྱེད་ཀྱི་དབང་ཐང་ས་མཐའི་བར་དུ་སླེབས་པའོ། །"]},{"type":"verse","number":23,"content":["རྒྱལ་པོ་ཁྱེད་ཀྱིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་སོ་ལྟ་བྱེད་མཁན་ཕོ་ཉ་དམ་པ་ཞིག་མར་ཕེབས་ཏེ་འདི་སྐད་དུ། ཁྱོད་ཅག་གིས་ལྗོན་ཤིང་དེ་བཅད་ནས་བརླག་པར་གྱིས། འོན་ཀྱང་ལྗོན་ཤིང་གི་ཤིང་རྡུམ་དང་རྩད་པ་ནི་ལི་དང་ལྕགས་ཀྱི་ཐག་པས་བསྡམས་ནས་ཐང་གི་རྩྭ་སྔོན་ནང་དུ་བསྐྱུར་ལ་ནམ་མཁའི་ཟིལ་པར་ཁོ་རང་སྦང་བར་ཆུག མི་ལོ་བདུན་འདའ་བའི་བར་དུ་ཁོ་རང་རྩྭ་ཟན་རྣམས་དང་འདྲ་བར་བསྐྱུར་ཞོག་ཅེས་སྨྲ་བ་མཐོང་ངོ་། །"]},{"type":"verse","number":24,"content":["ཀྱེ་རྒྱལ་པོ་ལགས། རྨི་ལམ་གྱི་དོན་ནི་འདི་ལྟ་སྟེ། འདི་ནི་བླ་ན་མེད་པའི་དཀོན་མཆོག་གིས་ངའི་ཇོ་བོ་དང་ངའི་རྒྱལ་པོ་ཁྱེད་ལ་གནང་བའི་བཀའ་རྒྱ་ཡིན།"]},{"type":"verse","number":25,"content":["ཁྱེད་ནི་ཕར་བསྐྲད་ནས་མི་ཚོགས་དང་འབྲལ་དགོས་ལ། ས་སྟེང་གི་རྩྭ་ཟན་གྱི་རིགས་དང་ལྷན་དུ་གནས་དགོས་པ་དང་། ཁྱེད་ཀྱིས་བ་གླང་ལྟར་རྩྭ་བཟའ་ཞིང་། གནམ་གྱི་ཟིལ་པས་ཁྱེད་རང་སྦང་བར་འགྱུར་བའོ། །ཡང་བླ་ན་མེད་པ་ཁོང་གིས་མི་ཡུལ་གྱི་རྒྱལ་སྲིད་ཀུན་ལ་དབང་སྒྱུར་བ་དང་། སུ་ཞིག་ལ་རྒྱལ་སྲིད་གནང་འདོད་ན་དེ་ལ་གནང་བ་ཁྱེད་ཀྱིས་རྟོགས་པའི་བར་དུ་མི་ལོ་བདུན་འདའ་བར་འགྱུར།"]},{"type":"verse","number":26,"content":["ལྗོན་ཤིང་གི་ཤིང་རྡུམ་དང་རྩད་པ་སྐྱུར་ཅིག་ཅེས་བཀའ་བསྩལ་པ་བཞིན་དུ། ཁྱེད་ཀྱིས་ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་བླ་ན་མེད་པ་ཁོང་གིས་དབང་སྒྱུར་བ་རྟོགས་པའི་དུས་སུ། ཁྱེད་རང་གི་རྒྱལ་སྲིད་ཀྱང་ཕྱིར་ཁྱེད་ལ་དབང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":27,"content":["དེའི་ཕྱིར། ཀྱེ་རྒྱལ་པོ་ལགས། བདག་གི་ཁ་ཏ་འདི་དང་དུ་ལེན་པར་མཛོད། དྲང་བདེན་སྤྱད་དེ་སྡིག་པ་སྤང་བ་དང་། གཉའ་གནོན་འོག་ཏུ་ཡོད་པ་རྣམས་ལ་སྙིང་རྗེ་བསྐྱེད་ནས་ཉེས་སྐྱོན་བསལ་བར་གྱིས་དང་། ཁྱེད་ཀྱི་མཛད་དོན་རྣམས་ལྷུན་གྱིས་འགྲུབ་ངེས་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["རྨི་ལམ་དོན་ཐོག་ཏུ་འཁེལ་བ།"]},{"type":"verse","number":28,"content":["དོན་དེ་ཐམས་ཅད་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་སྟེང་དུ་བྱུང་བའོ། །"]},{"type":"verse","number":29,"content":["དེ་ནས་ཟླ་བ་བཅུ་གཉིས་འགོར་བའི་རྗེས་ལ་རྒྱལ་པོ་པཱ་པེལ་ལོན་གྱི་ཕོ་བྲང་གི་ཀླད་དུ་འཆམ་འཆམ་འགྲོ་བའི་སྐབས་སུ།"]},{"type":"verse","number":30,"content":["ཁོ་ན་རེ། གནས་མཆོག་པཱ་པེལ་ལོན་འདི་ནི་བདག་གི་དབང་སྟོབས་ཆེན་པོས་བཀོད་པ་སྟེ། ང་རང་གི་རྔམ་བརྗིད་མངོན་པའི་ཕྱིར་བརྩིགས་པའི་རྒྱལ་ས་མ་ཡིན་ནམ་ཞེས་སྨྲས་པའི་མོད་ལ།"]},{"type":"verse","number":31,"content":["རྒྱལ་པོས་ཁ་ནས་ཚིག་མཚམས་མ་རྫོགས་པར་ནམ་མཁའ་ནས་སྒྲ་ཞིག་བྱུང་སྟེ། ཀྱེ་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར། ཁྱོད་ལ་ཆེད་དུ་བསྒོ་བ་ནི། ཁྱོད་ཀྱི་སྲིད་དབང་ཁྱོད་ལས་བླངས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":32,"content":["ཁྱོད་ནི་ཕར་བསྐྲད་ནས་མི་ཚོགས་དང་འབྲལ་དགོས་ལ། ས་སྟེང་གི་རྩྭ་ཟན་གྱི་རིགས་དང་ལྷན་དུ་གནས་དགོས་པ་དང་། ཁྱོད་ཀྱིས་བ་གླང་ལྟར་རྩྭ་བཟའ་བར་འགྱུར། ཡང་བླ་ན་མེད་པ་ཁོང་གིས་མི་ཡུལ་གྱི་རྒྱལ་སྲིད་ཀུན་ལ་དབང་སྒྱུར་བ་དང་། སུ་ཞིག་ལ་རྒྱལ་སྲིད་གནང་འདོད་ན་དེ་ལ་གནང་བ་ཁྱེད་ཀྱིས་རྟོགས་པའི་བར་དུ་མི་ལོ་བདུན་འདའ་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":33,"content":["དུས་དེ་ཉིད་དུ་བཀའ་དེ་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་སྟེང་དུ་འགྲུབ་པ་སྟེ། ཁོ་རང་ཕར་བསྐྲད་ནས་མི་ཚོགས་དང་བྲལ་ཞིང་། བ་གླང་ལྟར་རྩྭ་ཟོས་པ་དང་། གནམ་གྱི་ཟིལ་པས་ལུས་པོ་སྦངས། སྐྲ་རིང་པོར་སྐྱེས་ནས་གླག་གི་སྒྲོ་ལྟར་གྱུར་ཅིང་། སེན་མོ་རྣམས་འདབ་ཆགས་བྱ་ཡི་སྡེར་མོ་བཞིན་གྱུར་ཏོ། །"]},{"type":"verse","number":34,"content":["དེ་ནས་ལོ་བདུན་ལོངས་པ་ན། ནེ་བོ་ཀད་ནེ་ཙར་བདག་གིས་ནམ་མཁའི་ཞིང་ཁམས་སུ་ཡར་བལྟས་པ་དང་། བདག་གི་བློ་རིག་སྔར་བཞིན་གསལ་པོར་གྱུར་ནས་བླ་ན་མེད་པ་ཁོང་ཉིད་ལ་བསྟོད་བསྔགས་བརྗོད་ཅིང་། གཏན་དུ་བཞུགས་པ་ཉིད་ལ་གུས་འདུད་དང་གཟི་བརྗིད་ཕུལ་བ་ནི་འདི་ལྟ་སྟེ།",{"text":"ཁོང་གིས་རྒྱུན་ནས་རྒྱུན་དུ་རྒྱལ་སྲིད་སྐྱོང་། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་རྒྱལ་སྲིད་མི་རབས་ཀུན་ཏུ་གནས། །","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"འཇིག་རྟེན་ཁམས་ཀྱི་མི་སྡེ་ཡོད་དོ་ཅོག །","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་སྤྱན་སྔར་ཅི་ཡང་མ་ཡིན་ནོ། །","poem":1},{"lineBreak":true},{"text":"ནམ་མཁའི་དཔུང་ཚོགས་ཡོངས་ཀྱི་དཀྱིལ་དབུས་སུ། །","poem":1},{"lineBreak":true},{"text":"ཁོང་ནི་ཅི་ལ་དགྱེས་པ་དེ་བཞིན་བྱེད། །","poem":1},{"lineBreak":true},{"text":"ས་གཞིའི་མི་རྣམས་ཁྲོད་དུའང་དེ་བཞིན་ཡིན། །","poem":1},{"lineBreak":true},{"text":"སུས་ཀྱང་ཁོང་ལ་བཀག་འགོག་བྱེད་མི་ནུས། །","poem":1},{"lineBreak":true},{"text":"ཅི་དང་གང་ཞེས་འདྲི་བའི་སྤོབས་པའང་མེད། །","poem":1}]},{"type":"verse","number":36,"content":["བདག་གི་བློ་རིག་སྔར་བཞིན་གསལ་པོར་གྱུར་པའི་དུས་དེ་ཉིད་ལ། ང་ཡི་རྒྱལ་སྲིད་ཀྱི་གཟི་བརྗིད་ཀྱི་ཆེད་དུ་བདག་གི་རྔམ་བརྗིད་དང་ཟིལ་ཤུགས་ཀྱང་སོར་ཆུད་བྱུང་ཞིང་། ངའི་གྲོས་པ་རྣམས་དང་སྐུ་དྲག་རྣམས་ཀྱིས་བདག་བཙལ་ནས་ཡང་བསྐྱར་རྒྱལ་ཁྲིར་བཀོད་པ་དང་། བདག་གི་དབང་ཐང་སྔར་ལས་དར་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":37,"content":["ད་ནི་ནེ་བོ་ཀད་ནེ་ཙར་བདག་གིས་ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་རྒྱལ་པོ་ཁོང་ལ་བསྟོད་བསྔགས་དང་གུས་འདུད། གཟི་བརྗིད་བཅས་དུས་གཅིག་ཏུ་འབུལ་ལོ། །གང་ལ་ཞེ་ན། ཁོང་གི་མཛད་པ་ཐམས་ཅད་ཡང་དག་པ་ཡིན་ཞིང་། གཤེགས་ལམ་ཐམས་ཅད་དྲང་བདེན་ཡིན་ནོ། །ང་རྒྱལ་དང་བཅས་སྤྱད་པ་སྤྱོད་པ་རྣམས་ཁོང་གིས་དམའ་བར་མཛད་ནུས་སོ་ཞེས་པའོ། །"]}],"footnotes":[{"noteId":1,"caller":"+","text":"འདིར་མི་ལོ་བདུན་ཞེས་པར་མ་ཕྱི་ལས་ཐེངས་བདུན་ཞེས་མཐོང་།","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/bod_ntb/DAN/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/3.json","previousChapterAudioLinks":{},"numberOfVerses":37}