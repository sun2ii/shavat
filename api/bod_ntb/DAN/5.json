{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":5,"content":[{"type":"heading","content":["མཁར་ངོས་ཀྱི་སུག་བྲིས།"]},{"type":"verse","number":1,"content":["རྒྱལ་པོ་པེལ་ཤཱ་ཙར་གྱིས་རང་ཉིད་ཀྱི་བློན་ཆེན་ཆིག་སྟོང་ལ་གསོལ་སྟོན་གཟབ་རྒྱས་བཤམས་པ་དང་ཁོས་དེ་ཚོའི་མདུན་ནས་རྒུན་ཆང་འཐུངས་པའོ། །"]},{"type":"verse","number":2,"content":["ཁོས་རྒུན་ཆང་ཅི་དགར་འཐུངས་ནས། ཕ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཡེ་རུ་སཱ་ལེམ་གྱི་མཆོད་ཁང་ནས་བཙན་འཕྲོག་བྱས་པའི་གསེར་དང་དངུལ་གྱི་སྣོད་ཆས་རྣམས་འཁྱེར་འོང་བའི་བཀའ་བསྩལ་པ་སྟེ། གང་ལ་ཞེ་ན། རྒྱལ་པོ་རང་ཉིད་དང་བློན་ཆེན་རྣམས་དང་། བཙུན་མོ་རྣམས་དང་ཆུན་མ་བཅས་ཀྱིས་སྣོད་ཆས་དེ་དག་གིས་རྒུན་ཆང་བཏུང་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་ཁོ་རྣམས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་མཆོད་ཁང་སྟེ། དཀོན་མཆོག་གི་བཞུགས་གནས་ལས་བཙན་འཕྲོག་བྱས་པའི་གསེར་དང་དངུལ་གྱི་སྣོད་ཆས་རྣམས་ཁྱེར་འོངས་ནས་རྒྱལ་པོ་ཪང་ཉིད་དང་བློན་ཆེན་རྣམས། བཙུན་མོ་རྣམས། ཆུན་མ་བཅས་ཀྱིས་སྣོད་ཆས་དེ་དག་ལས་རྒུན་ཆང་འཐུངས།"]},{"type":"verse","number":4,"content":["ཁོ་ཚོས་རྒུན་ཆང་འཐུང་བཞིན་གསེར་དང་དངུལ། ལྕགས། ལི། ཤིང་། རྡོ་སོགས་ལས་བཟོས་པའི་ལྷ་རྣམས་ལ་བསྟོད་བསྔགས་བརྗོད་དོ། །"]},{"type":"verse","number":5,"content":["སྐབས་དེ་ཉིད་དུ་མི་ཡི་ལག་མཛུབ་དག་མངོན་པར་བྱུང་ནས་སྒྲོན་སྟེགས་མདུན་གྱི་ཕོ་བྲང་གི་མཁར་ངོས་སུ་ཡི་གེ་འགའ་འཁྱུག་བྲིས་བྱས་ཤིང་། རྒྱལ་པོས་ཡི་གེ་འབྲི་བའི་མཛུབ་མོ་མངོན་སུམ་དུ་མཐོང་བ་ལ།"]},{"type":"verse","number":6,"content":["རྒྱལ་པོའི་ངོ་མདངས་སྐྱ་བོར་གྱུར་ནས་ཞེད་སྣང་ཆེན་པོ་སྐྱེས་པ་དང་། རྐེད་ཚིགས་བུད་ཅིང་། པུས་མོ་འདར་ལྕུག་ལྕུག་བྱས་པ་རེད།"]},{"type":"verse","number":7,"content":["དེ་ནས་རྒྱལ་པོས་སྐད་ཆེན་པོ་བརྒྱབ་ནས་སྒྱུ་མ་མཁན་དང་ཀལ་དི་པ། དེ་མིན་རྩིས་པ་བཅས་འཁྲིད་འོང་བའི་བཀའ་བསྒོས་ཤིང་། པཱ་པེལ་ལོན་གྱི་མཁས་མཛངས་ལྡན་པ་རྣམས་ལ་བསྒྲགས་དོན། སུ་ཞིག་གིས་ཡི་གེ་འདི་རྣམས་ཀློག་ཤེས་པར་མ་ཟད་དེའི་དོན་འགྲེལ་ནུས་པ་ཡིན་ན། དེའི་ལུས་ལ་གོས་རྒྱ་སྨུག་བསྐོན་པ་དང་སྐེ་ལ་གསེར་གྱི་མགུལ་རྒྱན་བཏེགས་ནས་རྒྱལ་སྲིད་ཀྱི་གོ་གནས་ཨང་གསུམ་པ་འཐོབ་ངེས་ཡིན་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":8,"content":["མཁས་མཛངས་ལྡན་པ་ཐམས་ཅད་དེ་རུ་སླེབས་ན་ཡང་། ཁོ་རྣམས་ལས་མཁར་ངོས་ཀྱི་ཡི་གེ་ཀློག་ཐུབ་མཁན་ཞིག་མ་ཐོན་ལ། དེའི་དོན་རྒྱལ་པོར་འགྲེལ་བཤད་རྒྱག་ནུས་མཁན་ཞིག་ཀྱང་མ་བྱུང་ངོ་། །"]},{"type":"verse","number":9,"content":["དེ་བས་རྒྱལ་པོ་པེལ་ཤཱ་ཙར་དངངས་སྐྲག་ཆེན་པོ་སྐྱེས་ནས་ངོ་མདངས་དེ་ལས་སྐྱ་བོར་གྱུར་པ་དང་། ཁོའི་བློན་ཆེན་རྣམས་ཀྱང་ཅི་བྱ་གཏོལ་མེད་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ཡང་རྒྱལ་ཡུམ་གྱིས་རྒྱལ་པོ་དང་བློན་ཆེན་རྣམས་ཀྱིས་གླེང་མོལ་བྱེད་པའི་གཏམ་ཐོས་ནས་གསོལ་སྟོན་ཁང་དུ་འོངས་ཏེ་རྒྱལ་པོར་ན་རེ། ཀྱེ་རྒྱལ་པོ་ལགས། ཁྱེད་ཉིད་སྐུ་ཚེ་ཡུན་རིང་བརྟན་པར་ཤོག ཁྱེད་རང་སེམས་མ་སྔངས་ཤིག ཞལ་མདངས་ཀྱང་མི་ལོག་པར་གྱིས།"]},{"type":"verse","number":11,"content":["ཁྱེད་ཀྱི་རྒྱལ་སྲིད་ནང་དུ་ལྷ་དམ་པ་རྣམས་ཀྱི་ཐུགས་ཉིད་བཞུགས་པའི་སྐྱེས་བུ་ཞིག་འདུག ཁྱེད་ཀྱི་ཕ་ཡི་སྐུ་རིང་ལ་མི་འདི་ནི་ལྷ་རྣམས་དང་འདྲ་བར་རྣམ་དཔྱོད་དང་རིག་སྟོབས། ཤེས་རབ་བཅས་ལྡན་པའོ། །ཁྱེད་ཀྱི་ཕ་སྟེ་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་སྐྱེས་བུ་དེ་ནི་མོ་པ་དང་སྒྱུ་མ་མཁན། ཀལ་དི་པ། རྩིས་པ་བཅས་ཀྱི་འགོ་དཔོན་དུ་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":12,"content":["རྒྱལ་པོས་པེལ་ཏེ་ཤཱ་ཙར་ཞེས་མིང་བཏགས་པའི་སྐྱེས་བུ་དཱ་ནེ་ཨེལ་འདི་ནི་ཁྱད་དུ་འཕགས་ཤིང་ཤེས་རྒྱ་ཆེ་ལ། གོ་རྟོགས་ལྡན་པར་མ་ཟད། རྨི་ལམ་ལ་བརྟག་ཤེས་པ་དང་གབ་ཚིག་འགྲེལ་ནུས་པ། དཀའ་གནད་བསལ་ཐུབ་པ་ཞིག་ཡིན་པས། དཱ་ནེ་ཨེལ་བོས་ཤོག་དང་ཁོས་མཁར་ངོས་ཀྱི་ཡི་གེའི་ནང་དོན་ལ་འགྲེལ་བཤད་རྒྱག་ཐུབ་ངེས་རེད་ཅེས་བསྐུལ་ཏོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་དཱ་ནེ་ཨེལ་རྒྱལ་པོའི་དྲུང་དུ་བོས་པ་དང་། རྒྱལ་པོས་ཁོ་ལ་འདི་ལྟར། ངའི་ཕ་སྟེ་རྒྱལ་པོ་དམ་པས་ཡ་ཧུ་དཱ་ནས་བཟུང་པའི་བཙོན་མ་རྣམས་ཀྱི་ཁྲོད་དུ་དཱ་ནེ་ཨེལ་ཞེས་པ་ཞིག་ཡོད་པ་ཁྱེད་རང་ཡིན་ནམ།"]},{"type":"verse","number":14,"content":["ཁྱེད་ཀྱི་ནང་དུ་ལྷའི་ཐུགས་ཉིད་བཞུགས་ཤིང་། ཁྱེད་ལ་རྣམ་དཔྱོད་དང་རིག་སྟོབས། ཤེས་རབ་ཁྱད་པར་ཅན་བཅས་ལྡན་པ་ཡིན་ཞེས་གྲགས་པ་བདག་གིས་ཐོས།"]},{"type":"verse","number":15,"content":["མཁས་མཛངས་ལྡན་པ་དང་སྒྱུ་མ་མཁན་ཐམས་ཅད་བདག་གི་མདུན་དུ་བོས་ནས་མཁར་ངོས་སུ་བྲིས་ཡོད་པའི་ཡི་གེ་བཀླགས་ཏེ་ང་ལ་འགྲེལ་བཤད་རྒྱག་ཏུ་བཅུག་ནའང་། དེ་དག་གིས་ཡི་གེ་དེའི་ནང་དོན་ལ་འགྲེལ་བཤད་རྒྱག་མ་ནུས།"]},{"type":"verse","number":16,"content":["གོ་ཐོས་ལྟར་ན་ཁྱེད་ཀྱིས་འགྲེལ་བཤད་རྒྱག་ནུས་པ་དང་དཀའ་གནད་བསལ་ཐུབ་པ་ཡིན་ཟེར། ད་ལྟ་ཁྱེད་ཀྱིས་མཁར་ངོས་སུ་བྲིས་ཡོད་པའི་ཡི་གེ་བཀླགས་ནས་དེའི་ནང་དོན་ཅི་ཡིན་པ་བདག་ལ་འགྲེལ་བཤད་རྒྱག་ནུས་པ་ཡིན་ན། ཁྱེད་ཀྱི་ལུས་ལ་གོས་རྒྱ་སྨུག་བསྐོན་པ་དང་སྐེ་ལ་གསེར་གྱི་མགུལ་རྒྱན་བཏེགས་ནས་རྒྱལ་སྲིད་ཀྱི་གོ་གནས་ཨང་གསུམ་པ་འཐོབ་ངེས་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["དཱ་ནེ་ཨེལ་གྱིས་མཁར་ངོས་ཀྱི་སུག་བྲིས་ལ་འགྲེལ་བཤད་བརྒྱབ་པ།"]},{"type":"verse","number":17,"content":["དེ་ནས་དཱ་ནེ་ཨེལ་གྱིས་རྒྱལ་པོར་ལན་དུ། རྔན་པ་རྣམས་ཁྱེད་རང་གི་བྱོས་དང་། བྱ་དགའ་རྣམས་མི་གཞན་པར་སྦྱིན་ཞིག འོན་ཀྱང་མཁར་ངོས་སུ་བྲིས་ཡོད་པའི་ཡི་གེ་དེ་ངས་རྒྱལ་པོ་ཁྱེད་ལ་བཀླགས་ནས་དེའི་ནང་དོན་ལའང་འགྲེལ་བཤད་རྒྱག་པར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ཀྱེ་རྒྱལ་པོ་ལགས། བླ་ན་མེད་པའི་དཀོན་མཆོག་ཁོང་གིས་ཁྱེད་ཀྱི་ཕ་ནེ་བོ་ཀད་ནེ་ཙར་ལ་རྒྱལ་སྲིད་དང་དབང་ཤུགས། གཟི་དཔལ། རྔམ་བརྗིད་བཅས་གནང་བ་དང་།"]},{"type":"verse","number":19,"content":["དཀོན་མཆོག་གིས་གནང་བའི་དབང་ཤུགས་ཀྱི་རྐྱེན་གྱིས་རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སྣ་ཚོགས་བཅས་ཁོའི་མདུན་དུ་དངངས་ཤིང་ཞེད་པར་གྱུར། ཁོས་སུ་ཞིག་གསོད་འདོད་ན་དེ་བསད་པ་དང་། སུ་ཞིག་ཚེ་ཐར་གཏོང་འདོད་ན་དེ་ཚེ་ཐར་བཏང་བ་རེད། ཡང་སུ་ཡི་གོ་གནས་སྤར་འདོད་ན་དེའི་གོ་གནས་སྤར་བ་དང་། སུ་ཞིག་དམའ་སར་འབེབ་འདོད་ན་དེ་དམའ་སར་ཕབ་བོ། །"]},{"type":"verse","number":20,"content":["ཡིན་ནའང་ཁོའི་སེམས་སུ་ང་རྒྱལ་སྐྱེས་ནས་ཨུ་ཚུགས་ཆེ་ཞིང་། ཐ་ན་ཁེངས་དྲེགས་ངང་སྤྱད་པ་སྤྱོད་པའི་དུས་སུ། ཁོ་རང་རྒྱལ་སྲིད་ཀྱི་གསེར་ཁྲི་ལས་ཕབ་ནས་ཁོའི་གཟི་དཔལ་ཡང་ཕྲོགས་པའོ། །"]},{"type":"verse","number":21,"content":["བླ་ན་མེད་པའི་དཀོན་མཆོག་གིས་མི་ཡུལ་གྱི་རྒྱལ་སྲིད་ཀུན་ལ་དབང་སྒྱུར་བ་དང་། ཡང་ཁོང་ཉིད་སུ་ཞིག་ལ་ཐུགས་མཉེས་པ་ཡིན་ན་དེ་རྒྱལ་པོར་བསྐོ་ངེས་པ་རྟོགས་པའི་བར་དུ། ཁོ་རང་མི་ཚོགས་ནས་ཕར་བསྐྲད་ཅིང་། ཁོ་ལ་དུད་འགྲོའི་སེམས་དང་ལྡན་པར་བྱས་ནས་རི་དྭགས་རྐྱང་དང་ལྷན་དུ་གནས་དགོས་པ་དང་། བ་གླང་ལྟར་རྩྭ་ཟོས་ཏེ་ལུས་པོ་གནམ་གྱི་ཟིལ་པས་སྦངས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་ཁོའི་བུ་པེལ་ཤཱ་ཙར་ཁྱེད་ཀྱིས་འདི་ཐམས་ཅད་ཤེས་ནའང་ད་དུང་ཁེངས་སྐྱུང་མི་བྱེད་པར།"]},{"type":"verse","number":23,"content":["དེ་ལས་ལྡོག་སྟེ་ང་རྒྱལ་བསྐྱེད་ནས་ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་དཀོན་མཆོག་ལ་འགོག་རྒོལ་བྱས་ཤིང་། རང་གི་ཞབས་ཕྱི་རྣམས་ལ་ཁོང་གི་མཆོད་ཁང་ནས་སྣོད་ཆས་རྣམས་འཁྱེར་འོང་དུ་བཅུག་སྟེ། ཁྱེད་རང་ཉིད་དང་བློན་ཆེན་རྣམས། བཙུན་མོ་རྣམས། ཆུན་མ་བཅས་ཀྱིས་དེ་དག་ལས་རྒུན་ཆང་འཐུངས་པས། མཐོང་བ་མེད་ཅིང་ཐོས་པའང་མེད་ལ། འདུ་ཤེས་ཀྱིས་སྟོངས་པའི་གསེར་དང་དངུལ། ལི། ལྕགས། ཤིང་། རྡོ་སོགས་ཀྱིས་བྱས་པའི་ལྷ་ལ་བསྟོད་བསྔགས་བརྗོད་པ་ལས། ཁྱེད་ཀྱི་ཚེ་སྲོག་དང་འགུལ་སྐྱོད་རེ་རེར་དབང་བྱེད་པའི་དཀོན་མཆོག་ཁོང་ལ་བསྟོད་བསྔགས་མ་བརྗོད་དོ། །"]},{"type":"verse","number":24,"content":["དེའི་ཕྱིར། ཁོང་གིས་ཕྱག་མཛུབ་དེ་དག་མངགས་ནས་མཁར་ངོས་སུ་ཡི་གེ་བྲིས་པའོ། །"]},{"type":"verse","number":25,"content":["བྲིས་པའི་ཡི་གེ་རྣམས་ནི་འདི་ལྟ་སྟེ། མེ་ནེ། མེ་ནེ། ཐེ་ཀེལ། ཕར་སིན་ཞེས་པའོ། །"]},{"type":"verse","number":26,"content":["ཐ་སྙད་དེ་དག་གི་འགྲེལ་བ་ནི་འདི་ལྟ་སྟེ། མེ་ནེ་ཞེས་པ་ནི་དཀོན་མཆོག་གིས་ཁྱེད་ཀྱི་རྒྱལ་སྲིད་ཀྱི་ལོ་ཟླ་རྣམས་རྩིས་བླངས་ཤིང་ད་ནི་མཇུག་རྫོགས་པའི་དོན་ལ་འཇུག"]},{"type":"verse","number":27,"content":["ཐེ་ཀེལ་ཞེས་པ་ནི་ཁྱེད་རང་སྲང་ལ་འཇལ་བ་དང་ལྗིད་ཚད་མ་ལོངས་པའི་དོན་ལ་འཇུག"]},{"type":"verse","number":28,"content":["ཕར་སིན་ཞེས་པ་ནི་ཁྱེད་ཀྱི་རྒྱལ་སྲིད་བགོ་བཤའ་བརྒྱབ་སྟེ་མཱ་ཏི་པ་དང་ཏ་ཟིག་པ་རྣམས་ལ་གནང་བའི་དོན་ལ་འཇུག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":29,"content":["དེ་ནས་པེལ་ཤཱ་ཙར་གྱིས་བཀའ་བབས་པ་ལྟར། དཱ་ནེ་ཨེལ་ལ་གོས་རྒྱ་སྨུག་བསྐོན་ཞིང་སྐེ་ལ་གསེར་གྱི་མགུལ་རྒྱན་བཏེགས་ནས་རྒྱལ་སྲིད་ཀྱི་བློན་པོ་ཨང་གསུམ་པར་བསྐོས་པ་རེད།"]},{"type":"verse","number":30,"content":["ཏག་ཏག་མཚན་མོ་དེ་ལ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་པེལ་ཤཱ་ཙར་བཀྲོངས་པ་དང་།"]},{"type":"verse","number":31,"content":["མཱ་ཏི་པ་དར་ཡཱ་ཡིས་དགུང་ལོ་དྲུག་ཅུ་རེ་གཉིས་སྟེང་རྒྱལ་སྲིད་དེ་ལ་དབང་བསྒྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DAN/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}