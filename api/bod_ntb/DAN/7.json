{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":7,"content":[{"type":"heading","content":["དཱ་ནེ་ཨེལ་གྱིས་མཐོང་བའི་ཞལ་གཟིགས་ཁྲོད་རྒྱ་མཚོ་ལས་གཅན་གཟན་བཞི་ཐོན་པ།"]},{"type":"verse","number":1,"content":["པེལ་ཤཱ་ཙར་ནི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་བསྡད་པའི་སྲིད་ལོ་དང་པོ་དེར། དཱ་ནེ་ཨེལ་གྱིས་རང་གི་མལ་ཁྲིའི་སྟེང་རྨི་ལམ་ཞིག་རྨིས་ཤིང་སེམས་སུ་ཞལ་གཟིགས་རྣམས་མཐོང་བ་དང་། རྨི་ལམ་ཁྲོད་ཀྱི་ཞལ་གཟིགས་རྣམས་མདོར་བསྡུས་ངང་ཡི་གེར་བཀོད་ཅིང་།"]},{"type":"verse","number":2,"content":["དཱ་ནེ་ཨེལ་ན་རེ། མཚན་མོའི་ཞལ་གཟིགས་ཁྲོད་དུ་བདག་གིས་མཐོང་བ་ནི་འདི་ལྟ་སྟེ། ནམ་མཁའི་ཕྱོགས་བཞི་ནས་རླུང་ཆེན་པོ་ལྡང་འོངས་ཏེ་རྒྱ་མཚོ་ཆེན་པོ་གཡོ་བར་བྱས་ལ།"]},{"type":"verse","number":3,"content":["དེ་ནས་རྒྱ་མཚོ་ལས་རིགས་མི་འདྲ་བའི་གཅན་གཟན་ཆེན་པོ་བཞི་ཡར་བུད་པའོ། །"]},{"type":"verse","number":4,"content":["གཅན་གཟན་དང་པོ་དེ་ནི་གླག་ལྟར་གཤོག་པ་ཐོགས་ཡོད་པའི་སེང་གེ་ཞིག་དང་མཚུངས་ལ། གཤོག་སྒྲོ་རྣམས་བཀོག་སྟེ་ས་ནས་ཡར་བཀྱགས་པ་ལ། མི་ལྟར་རྐང་པ་གཉིས་སར་བཙུགས་ནས་གྱེན་དུ་འགྲེངས་པ་དང་། མི་ཡི་སེམས་དེ་ལ་སྦྱིན་པའི་བར་དུ་བདག་གིས་བལྟས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་ངས་གཅན་གཟན་གཞན་ཞིག་མཐོང་བ་དང་དེ་ནི་གཅན་གཟན་གཉིས་པ་ཡིན་ལ། དོམ་དང་འདྲ་བའི་གཅན་གཟན་དེས་གཟུགས་པོའི་གཞོགས་གཅིག་ཡར་བཀྱགས་ནས་སོ་ཡི་བར་དུ་རྩིབ་རུས་གསུམ་བཟུང་ཡོད་པ་དེར་འདི་ལྟར། ཡར་ལོངས་ལ་ཤ་མང་པོ་བཟའ་བར་གྱིས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་བདག་གིས་མུ་མཐུད་དུ་བལྟས་པ་ན། གཟིག་དང་འདྲ་བའི་གཅན་གཟན་གཞན་ཞིག་མཐོང་བྱུང་ལ་དེའི་རྒྱབ་ཏུ་འདབ་ཆགས་བྱ་ཡི་གཤོག་པ་བཞི་བརྒྱངས་འདུག གཅན་གཟན་དེར་མགོ་བཞི་ཡོད་ལ་སྲིད་སྐྱོང་བའི་དབང་ཡང་དེར་སྤྲད་ཡོད།"]},{"type":"verse","number":7,"content":["རྗེས་སུ་བདག་གིས་མཚན་མོའི་ཞལ་གཟིགས་ཁྲོད་མུ་མཐུད་དུ་བལྟས་པ་ན། གཅན་གཟན་བཞི་པ་མཐོང་བྱུང་ལ་དེ་ནི་འཇིགས་སུ་རུང་ཞིང་སྐྱི་གཡའ་བའི་སྟོབས་པོ་ཆེ་ཞིག་ཡིན་པ་དང་། དེར་ལྕགས་ཀྱི་མཆེ་བ་དང་ལྡན་ཞིང་ཡོད་ཚད་ཁྱུར་མིད་བཏང་ནས་རྡུལ་དུ་བརླགས་པར་མ་ཟད། ཤུལ་དུ་ལུས་པ་རྣམས་རྡོག་བརྫིས་བཏང་། དེ་ནི་གཅན་གཟན་སྔོན་མ་དག་དང་གཏན་ནས་མི་འདྲ་སྟེ་རྭ་ཅོ་བཅུ་ཡར་ལ་གཟེངས་འདུག"]},{"type":"verse","number":8,"content":["བདག་གིས་རྭ་ཅོ་དེ་དག་ལ་ཞིབ་ཏུ་ལྟ་བའི་སྐབས་སུ། དེ་དག་གི་དབུས་སུ་གཞན་པའི་རྭ་ཅོ་ཆུང་ངུ་ཞིག་སྐྱེས་ཤིང་། རྭ་ཅོ་ཆུང་ངུ་དེ་ཡོད་སར་དེ་སྔའི་རྭ་ཅོ་གསུམ་པོ་རྩ་བ་ནས་བཏོན་ནོ། །རྭ་ཅོ་ཆུང་ངུ་དེ་ལ་མི་ཡི་མིག་དང་འདྲ་བ་ཡོད་ལ་ཁ་ཡང་འདུག་པས་དེ་ལས་འུད་ཤོབ་མང་པོ་ཐོན་ནོ། །"]},{"type":"verse","number":9,"content":["ངས་ཡུན་རིང་བལྟས་པ་ན། ཁྲི་མང་པོ་བརྒྱབ་ཅིང་གདོད་མ་ནས་བཞུགས་པ་ཁོང་ཉིད་ཁྲི་ལ་བཞུགས་པ་དང་། ཁོང་གི་ན་བཟའ་ནི་ཁ་བ་ལྟར་དཀར་ཞིང་དབུ་སྐྲའང་བལ་ལྟར་དྭངས་གཙང་ཡིན། ཁོང་གི་བཞུགས་ཁྲི་ནི་མེ་ལྕེ་ཡིན་ལ་དེའི་འཁོར་ལོ་རྣམས་ནི་མེ་དཔུང་དྲག་པོ་ཡིན།"]},{"type":"verse","number":10,"content":["ཁོང་གི་སྤྱན་སྔ་ནས་མེ་ཡི་གཙང་པོ་ཞིག་བཞུར་ཅིང་མེ་དཔུང་དྲག་པོ་འཕྱུར་བ་དང་། སྟོང་ཕྲག་མང་པོས་ཁོང་ལ་ཞབས་ཏོག་སྒྲུབ་ཀྱིན་ཡོད་པ་དང་ཁྲི་ཕྲག་མང་པོ་ཁོང་གི་དྲུང་དུ་འགྲེང་འདུག ཁྲིམས་གཅོད་འགོ་བརྩམས་པ་དང་གླེགས་བམ་རྣམས་ཁ་ཕྱེས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་བདག་གིས་མུ་མཐུད་དུ་བལྟས་པ་ན། རྭ་ཅོ་ཆུང་ངུ་དེས་ང་རྒྱལ་གྱི་གཏམ་སྨྲ་བས་གཅན་གཟན་དེ་སྲོག་དང་ཕྲལ་ཞིང་། དེའི་ལུས་པོ་མེད་པར་བཏང་ནས་མེ་དཔུང་དྲག་པོའི་ཁྲོད་དུ་གཡུགས།"]},{"type":"verse","number":12,"content":["དེ་འཕྲོས་གཅན་གཟན་གསུམ་པོ་ནི་དེ་དག་གི་རྒྱལ་སྲིད་ཕྲོགས་ནའང་། དེ་རྣམས་ཀྱི་ཚེ་སྲོག་ནི་གཏན་ལ་ཕབ་པའི་དུས་ཚོད་དང་ཉི་མའི་བར་དུ་ལྷག་པར་བྱས།"]},{"type":"verse","number":13,"content":["བདག་གིས་མཚན་མོའི་ཞལ་གཟིགས་ཁྲོད་མུ་མཐུད་དུ་བལྟས་པ་ན། ནམ་མཁའི་སྤྲིན་གྱི་བང་རིམ་ནས་མིའི་བུ་དང་མཚུངས་པ་ཞིག་བྱོན་ནས། གདོད་མ་ནས་བཞུགས་པ་ཁོང་གི་དྲུང་དུ་གཤེགས་ཤིང་ཁོང་གི་དྲུང་དུ་དྲངས་སོ། །"]},{"type":"verse","number":14,"content":["ཁོང་ལ་དབང་ཐང་དང་གུས་འདུད། རྒྱལ་སྲིད་བཅས་ཐོབ་ཅིང་། རྒྱལ་ཁམས་ཁག་དང་མི་རིགས་སོ་སོ། སྐད་རིགས་སྣ་ཚོགས་སྨྲ་མཁན་ཐམས་ཅད་ཀྱིས་ཁོང་ལ་ཞབས་ཕྱི་བསྒྲུབས། ཁོང་གི་དབང་ཐང་ནི་དུས་གཏན་དུ་གནས་ཤིང་མེད་པར་མི་འགྱུར་ལ། ཁོང་གི་རྒྱལ་སྲིད་ནི་དུས་ནམ་ཡང་འཇིག་མི་སྲིད་དོ། །"]},{"type":"heading","content":["ཕོ་ཉ་ཞིག་གིས་དཱ་ནེ་ཨེལ་གྱི་ཞལ་གཟིགས་དེར་འགྲེལ་བཤད་བརྒྱབ་པ།"]},{"type":"verse","number":15,"content":["དཱ་ནེ་ཨེལ་ང་རང་ནི་སེམས་འཁྲུགས་ཤིང་། བློ་ངོར་ཤར་བའི་ཞལ་གཟིགས་དེ་དག་གིས་ང་ལ་ཞེད་སྣང་ཆེན་པོ་བསྐྱེད།"]},{"type":"verse","number":16,"content":["དེ་ནས་ང་རང་འགྲེངས་ནས་བསྡད་ཡོད་པ་དེ་དག་གྲས་ཀྱི་གཅིག་གི་གམ་དུ་བཅར་ནས་དེ་ཡོད་ཚད་ཀྱི་ངེས་དོན་ཅི་ཡིན་དྲིས་པ་ན། ཁོང་གིས་བདག་ལ་ཞལ་གཟིགས་དེ་དག་གི་དོན་སྨྲས་པ་དང་འགྲེལ་བཤད་བརྒྱབ་པ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":17,"content":["གཅན་གཟན་ཆེན་པོ་འདི་བཞི་པོ་ནི་ས་སྟེང་དུ་འབྱུང་བར་འགྱུར་བའི་རྒྱལ་པོ་བཞི་ཡིན་མོད།"]},{"type":"verse","number":18,"content":["འོན་ཀྱང་བླ་ན་མེད་པ་ཁོང་གི་སྐྱེས་བུ་དམ་པ་རྣམས་ལ་རྒྱལ་སྲིད་ཐོབ་ནས་དུས་གཏན་དུ་རྒྱལ་སྲིད་དེ་དབང་བར་འགྱུར་རོ་ཞེས་པའོ། །"]},{"type":"verse","number":19,"content":["དེ་ནས་བདག་གིས་གཅན་གཟན་བཞི་པ་དེའི་ངེས་དོན་ཤེས་འདོད་པ་དང་། དེ་ནི་གཞན་པའི་གཅན་གཟན་གསུམ་པོ་དང་མི་འདྲ་ཞིང་། ཤིན་ཏུ་འཇིགས་སུ་རུང་བ་དང་ལྕགས་ཀྱི་མཆེ་བ་དང་ལི་ཡི་སྡེར་མོ་ཅན་ཞིག་ཡིན་ལ། ཡོད་ཚད་ཁྱུར་མིད་བཏང་ནས་རྡུལ་དུ་བརླགས་པར་མ་ཟད། ཤུལ་དུ་ལུས་པ་རྣམས་རྡོག་བརྫིས་བཏང་བའོ། །"]},{"type":"verse","number":20,"content":["དེ་མིན་མགོ་ལ་ཐོགས་པའི་རྭ་ཅོ་བཅུ་པོ་དང་དེ་དག་གི་དཀྱིལ་ནས་སྐྱེས་པའི་རྭ་ཅོ་ཆུང་ངུ་དེ་དང་། ཡང་རྭ་ཅོ་ཆུང་ངུ་དེའི་མདུན་ནས་འགྱེལ་བའི་རྭ་ཅོ་གསུམ་པོ་དེའི་ངེས་དོན་ཡང་ཤེས་འདོད་པ་ཡིན། རྭ་ཅོ་ཆུང་ངུ་དེར་མིག་ཡོད་ལ་འུད་ཤོབ་བྱེད་པའི་ཁ་ཡང་ཡོད་པ་དང་། དེའི་གཟུགས་དབྱིབས་ནི་གཞན་རྣམས་ལས་ཀྱང་དཔའ་རྔམ་ཆེ་བ་ཞིག་ཡིན།"]},{"type":"verse","number":21,"content":["ངས་ལྟ་བཞིན་པའི་སྒང་ལ་རྭ་ཅོ་ཆུང་ངུ་དེས་སྐྱེས་བུ་དམ་པ་རྣམས་ལ་གཡུལ་འགྱེད་པའི་འགོ་བརྩམས་ཤིང་དེ་དག་ཕམ་པར་བརྒྱབ།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་གདོད་མ་ནས་བཞུགས་པ་ཁོང་ཉིད་བྱོན་ཏེ། བླ་ན་མེད་པ་ཁོང་གི་སྐྱེས་བུ་དམ་པ་རྣམས་ཀྱི་ཕྱོགས་བྱས་ནས་ཁྲིམས་ཐག་བཅད་པ་ལ། སྐྱེས་བུ་དམ་པ་རྣམས་ལ་རྒྱལ་སྲིད་དབང་བའི་དུས་སུ་སླེབས་པའོ། །"]},{"type":"verse","number":23,"content":["ཁོང་གིས་བདག་ལ་འདི་སྐད་དུ། གཅན་གཟན་བཞི་པ་དེ་ནི་ས་སྟེང་འདི་རུ་འབྱུང་ངེས་པའི་རྒྱལ་སྲིད་བཞི་པ་ཡིན་ལ་དེ་ནི་རྒྱལ་སྲིད་གཞན་ཀུན་དང་མི་འདྲ་སྟེ། ས་སྟེང་ཧྲིལ་པོ་རྡོག་བརྫིས་བཏང་ནས་ཁྱུར་མིད་གཏོང་ཞིང་རྡུལ་དུ་བརླག་ངེས་ཡིན།"]},{"type":"verse","number":24,"content":["རྭ་ཅོ་བཅུ་པོ་ནི་རྒྱལ་སྲིད་དེ་ལས་རྒྱལ་པོ་བཅུ་འབྱུང་བར་འགྱུར་བ་དེ་ཡིན་ལ། དེ་དག་གི་རྗེས་སུ་རྒྱལ་པོ་གཞན་ཞིག་སླེབ་པར་འགྱུར་ཞིང་། རྒྱལ་པོ་སྔ་མ་དག་དང་མི་འདྲ་སྟེ། ཁོས་རྒྱལ་པོ་གསུམ་ཀ་དབང་དུ་བསྡུ་ངེས་སོ། །"]},{"type":"verse","number":25,"content":["ཁོས་བླ་ན་མེད་པ་ཁོང་ལ་འགོག་རྒོལ་བྱེད་པའི་གཏམ་སྨྲ་ཞིང་། བླ་ན་མེད་པ་ཁོང་གི་སྐྱེས་བུ་དམ་པ་རྣམས་ལ་མནར་གཅོད་གཏོང་བ་དང་། དུས་ཆེན་དང་བཀའ་ཁྲིམས་རྣམས་ཀྱང་བསྒྱུར་འདོད་པ་ཡིན། སྐྱེས་བུ་དམ་པ་རྣམས་ལོ་གསུམ་དང་ཕྱེད་ཀའི་",{"noteId":2},"རིང་ལ་ཁོའི་དབང་འོག་ཏུ་གཏོད་པར་འགྱུར།"]},{"type":"verse","number":26,"content":["འོན་ཀྱང་ཁྲིམས་གཅོད་འགོ་རྩོམ་ཞིང་ཁོའི་དབང་ཆ་བླངས་ནས་ཁོ་རང་གཏན་དུ་རྩ་མེད་དུ་གཏོང་ངེས་ཡིན།"]},{"type":"verse","number":27,"content":["དེ་ནས་རྒྱལ་སྲིད་དང་དབང་ཐང་། གནམ་འོག་གི་རྒྱལ་ཁམས་ཀུན་གྱི་དབང་ཐམས་ཅད་བླ་ན་མེད་པ་ཁོང་གི་སྐྱེས་བུ་དམ་པ་རྣམས་ལ་གནང་བར་འགྱུར་ཞིང་། ཁོང་གི་རྒྱལ་སྲིད་ནི་དུས་གཏན་གྱི་རྒྱལ་སྲིད་ཡིན་པ་དང་། དབང་སྒྱུར་པ་ཡོངས་ཀྱིས་ཁོང་ལ་ཞབས་ཏོག་བསྒྲུབས་ནས་ཁོང་གི་བཀའ་ལ་མཉན་ནོ་ཞེས་སྨྲས།"]},{"type":"verse","number":28,"content":["དོན་དེ་ནི་འདི་རུ་མཇུག་རྫོགས་པ་ཡིན། དཱ་ནེ་ཨེལ་བདག་ནི་སེམས་ཀུན་ནས་འཁྲུགས་ཤིང་ངོ་མདངས་ཀྱང་འགྱུར་ནའང་། དོན་དེ་ཐམས་ཅད་བདག་གིས་ཡིད་ལ་བཟུང་བའོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"འདིར་ལོ་གསུམ་དང་ཕྱེད་ཀ་ཞེས་པར་མ་ཕྱི་ལས་ལོ་གཅིག་དང་། ལོ་གཉིས། ལོ་ཕྱེད་ཀ་ཞེས་མཐོང་།","reference":{"chapter":7,"verse":25}}]},"thisChapterLink":"/api/bod_ntb/DAN/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}