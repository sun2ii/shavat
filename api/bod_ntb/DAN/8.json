{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DAN","translationId":"bod_ntb","name":"དཱ་ནེ་ཨེལ།","commonName":"དཱ་ནེ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ།","order":27,"numberOfChapters":12,"sha256":"6789ef05b75636c603c628de4889a32681ca1b0230dd2ac14c1c9ce685c9be1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/DAN/12.json","totalNumberOfVerses":356},"chapter":{"number":8,"content":[{"type":"heading","content":["དཱ་ནེ་ཨེལ་གྱིས་རང་གི་ཞལ་གཟིགས་ལས་ར་ཕོ་ཞིག་དང་ལུག་ཐུག་ཅིག་མཐོང་བ།"]},{"type":"verse","number":1,"content":["ཡང་རྒྱལ་པོ་པེལ་ཤཱ་ཙར་རྒྱལ་པོར་བསྡད་པའི་སྲིད་ལོ་གསུམ་པ་དེར། དེ་སྔ་མངོན་ཟིན་པའི་ཞལ་གཟིགས་དེའི་རྗེས་སུ་དཱ་ནེ་ཨེལ་བདག་གིས་ཡང་ཞལ་གཟིགས་གཞན་ཞིག་མཐོང་།"]},{"type":"verse","number":2,"content":["བདག་གིས་ཞལ་གཟིགས་དེར་བལྟས་པ་ན། ང་རང་ཉིད་ཨེ་ལཱམ་མངའ་སྡེའི་སོའུ་སཱན་མཁར་རྫོང་དུ་ཡོད་པ་མཐོང་བ་དང་། ངས་མུ་མཐུད་དུ་ཞལ་གཟིགས་དེར་བལྟས་པ་ན། རང་ཉིད་ཨུ་ལ་ཨི་ཡུར་བའི་འགྲམ་དུ་ཡོད་དོ། །"]},{"type":"verse","number":3,"content":["ངས་མགོ་ཡར་བཀྱགས་ནས་བལྟས་པ་ན། ལུག་ཐུག་ཅིག་ཡུར་བའི་འགྲམ་དུ་ལངས་བསྡད་ཡོད་པ་མཐོང་ཞིང་། དེར་རྭ་ཅོ་གཉིས་ཡོད་ལ་རྭ་ཅོ་གཉིས་ཀ་ཤིན་ཏུ་རིང་ནའང་གཅིག་ནི་ལྷག་ཏུ་རིང་བ་དང་། ཡང་རྭ་ཅོ་རིང་ཤོས་དེ་ནི་རྗེས་སུ་སྐྱེས་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཡང་ལུག་ཐུག་དེས་ནུབ་ཕྱོགས་དང་བྱང་ཕྱོགས། ལྷོ་ཕྱོགས་སོགས་སུ་བརྡུངས་པ་ལ། གཅན་གཟན་གང་ཡིན་ཡང་དེའི་མདུན་དུ་ཚུགས་མི་ཐུབ་པ་དང་སུ་ཞིག་གིས་ཀྱང་དེའི་དབང་ལས་སྐྱོབ་མི་ཐུབ། དེས་རང་འདོད་ལྟར་སྤྱོད་ཅིང་ཁེངས་དྲེགས་ཤིན་ཏུ་ཆེ།"]},{"type":"verse","number":5,"content":["བདག་གིས་དེར་བསམ་བློ་གཏོང་བཞིན་པའི་སྒང་ལ། ལྟོས་དང་། ར་ཕོ་ཞིག་ནུབ་ཕྱོགས་ནས་ཐོན་ཞིང་རྐང་པ་སར་མི་ཐོགས་པར་ས་ངོས་ཡོངས་སུ་ཤར་རྒྱུགས་བྱེད་ཀྱིན་འདུག ར་ཕོ་དེའི་མིག་ཟུང་གི་བར་དུ་རྭ་ཅོ་ཞིག་མངོན་གསལ་གྱིས་གཟེངས་འདུག"]},{"type":"verse","number":6,"content":["ར་ཕོ་དེ་ནི་ཁོང་ཁྲོ་མེ་ལྟར་འབར་བཞིན་བདག་གིས་དེ་སྔར་མཐོང་བའི་ཡུར་བའི་འགྲམ་དུ་ལངས་བསྡད་ཡོད་པ་དང་རྭ་ཅོ་ཟུང་དང་ལྡན་པའི་ལུག་ཐུག་དེའི་ཕྱོགས་སུ་ཤུགས་ཀྱིས་རྒྱུག་སོང་ངོ་། །"]},{"type":"verse","number":7,"content":["ར་ཕོ་དེ་ལུག་ཐུག་གི་ཉེ་སར་ཕྱིན་པ་བདག་གིས་མཐོང་ཞིང་། ལུག་ཐུག་དེའི་སྟེང་ཁོང་ཁྲོ་མེ་ལྟར་འབར་ནས་བརྡུངས་ཤིང་རྭ་ཅོ་གཉིས་ཀའང་བཅག་པའོ། །ལུག་ཐུག་གིས་ཚུགས་མ་ཐུབ་པས་ར་ཕོ་དེས་ལུག་ཐུག་ས་ལ་བརྡབས་ཤིང་རྡོག་བརྫིས་བཏང་ནའང་། སུ་ཞིག་གིས་ཀྱང་ལུག་ཐུག་དེ་ར་ཕོའི་སྟོབས་ལས་སྐྱོབ་མ་ཐུབ།"]},{"type":"verse","number":8,"content":["ར་ཕོ་དེ་ཁེངས་དྲེགས་ཤིན་ཏུ་ཆེ་ནའང་། སྟོབས་ཤུགས་ཆེས་ཆེ་བའི་དུས་སུ་དེའི་རྭ་ཅོ་སྦོམ་པོ་དེ་གློ་བུར་ཉིད་ལ་ཆག་པ་དང་། དེའི་ཤུལ་དུ་མངོན་གསལ་ཆེ་བའི་རྭ་ཅོ་བཞི་སྐྱེས་ཤིང་ནམ་མཁའི་ཕྱོགས་བཞི་རུ་བརྐྱངས་པའོ། །"]},{"type":"verse","number":9,"content":["རྭ་ཅོ་དེ་དག་ཁྲོད་ཀྱི་གཅིག་ལས་ཡང་རྭ་ཅོ་ཆུང་ངུ་ཞིག་སྐྱེས་ཤིང་། རྭ་ཅོ་ཆུང་ངུ་དེ་ཤིན་ཏུ་ཆེན་པོར་རྒྱས་ནས་ལྷོ་ཕྱོགས་དང་ཤར་ཕྱོགས། མཛེས་སྡུག་ལྡན་པའི་ཡུལ་ལྗོངས་བཅས་ཀྱི་ཕྱོགས་སུ་བརྐྱངས།"]},{"type":"verse","number":10,"content":["དེ་ནི་ཤིན་ཏུ་ཆེན་པོར་གྱུར་ནས་ནམ་མཁའི་དཔུང་ཚོགས་བར་དུ་སླེབས་ཤིང་། ནམ་མཁའི་དཔུང་ཚོགས་དང་སྐར་ཚོགས་ཁྱུ་ཞིག་ས་རུ་གཡུགས་ནས་རྡོག་བརྫིས་བཏང་།"]},{"type":"verse","number":11,"content":["དེས་ཁེངས་དྲེགས་ཆེན་པོ་དང་བཅས་ནམ་མཁའི་དཔུང་ཚོགས་ཀྱི་གཙོ་བོར་འགྲན་བཙུགས་ཤིང་། ནམ་མཁའི་དཔུང་ཚོགས་ཀྱི་གཙོ་བོར་ཕུལ་བའི་དུས་རྒྱུན་གྱི་མཆོད་པ་མེད་པར་བཟོས་པ་དང་གནས་དམ་པའང་བཤིགས་པའོ། །"]},{"type":"verse","number":12,"content":["སྡིག་ཉེས་ཀྱི་དབང་གིས་སྐྱེས་བུ་དམ་པས་དུས་རྒྱུན་གྱི་མཆོད་པའང་ཁོ་ལ་གཏད་པ་དང་། དེས་བདེན་པ་ཉིད་ས་ལ་བརྡབས་ཤིང་ཅི་བྱེད་འདོད་ན་དོན་ཀུན་ལྷུན་གྱིས་འགྲུབ་པའོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་ངས་དམ་པ་ཞིག་གིས་གཏམ་སྨྲ་བཞིན་པ་ཐོས་པ་དང་། དམ་པ་གཞན་ཞིག་གིས་དེ་ལ་འདི་སྐད་དུ། ཉིན་རྒྱུན་གྱི་མཆོད་པ་མེད་པར་བྱས་པ་དང་གཏོར་བརླག་བཟོ་བའི་སྡིག་ཉེས་ཀྱི་སྐོར་དང་། གནས་དམ་པ་དང་མི་སྡེ་དམ་པར་རྡོག་བརྫིས་གཏོང་བའི་ཞལ་གཟིགས་ནི་ག་དུས་བར་དུ་གནས་འོང་ངམ་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་འདི་སྐད་དུ། ནངས་དགོང་ཉིས་སྟོང་སུམ་བརྒྱའི་རྗེས་སུ་གནས་དེ་སླར་ཡང་དམ་པར་འགྱུར་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཕོ་ཉ་ཞིག་གིས་དཱ་ནེ་ཨེལ་གྱི་ཞལ་གཟིགས་ལ་འགྲེལ་བཤད་བརྒྱབ་པ།"]},{"type":"verse","number":15,"content":["དཱ་ནེ་ཨེལ་བདག་གིས་ཞལ་གཟིགས་དེ་མཐོང་ནས་དེར་བརྟག་ཅིང་དཔྱོད་པའི་དུས་སུ། ལྟོས་དང་། མི་ཡི་བྱད་གཟུགས་ལྡན་པ་ཞིག་བདག་གི་མདུན་དུ་ཀེ་རེར་ལངས་འདུག་ལ།"]},{"type":"verse","number":16,"content":["ཡང་ཨུ་ལ་ཨི་ཡུར་བའི་འགྲམ་གྱི་མཚམས་ནས་མི་སྐད་ཅིག་གྲགས་འོངས་པ་ཐོས་ཤིང་དེ་ན་རེ། ཀྱེ་གབ་རི་ཨེལ། མི་འདི་ལ་ཞལ་གཟིགས་དེའི་དོན་མངོན་པར་མཛོད་ཅིག་ཅེས་སྨྲས་པས།"]},{"type":"verse","number":17,"content":["ཁོང་ནི་བདག་འགྲེང་སའི་གནས་སུ་སླེབས་ཤིང་བདག་འཇིགས་སྣང་ཆེན་པོ་སྐྱེས་པ་དང་གདོང་སར་བཏུད་ནས་བསྡད་པ་ལ། ཁོང་གིས་འདི་སྐད་དུ། ཀྱེ་མིའི་བུ། ཞལ་གཟིགས་དེ་ནི་དུས་ཀྱི་མཐའ་མའི་སྐོར་ཡིན་པ་རྟོགས་པར་གྱིས་ཤིག་ཅེས་གསུངས།"]},{"type":"verse","number":18,"content":["ཁོང་གིས་གཏམ་སྨྲ་བའི་དུས་སུ་བདག་ནི་གཉིད་ལྕི་པོ་ཁུགས་ཏེ་གདོང་སར་གཏད་ནས་བསྡད་པ་དང་། ཁོང་གིས་བདག་ལ་ཕྱག་གིས་རེག་ནས་ཡར་བསླངས་སོ། །"]},{"type":"verse","number":19,"content":["ཡང་ཁོང་གིས་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གིས་ཁྱོད་ལ་དུས་ཀྱི་མཐའ་མའི་ཐུགས་ཁྲོའི་སྐོར་སྨྲ་ངེས་སོ། །གང་ལ་ཞེ་ན། ཞལ་གཟིགས་དེ་ནི་གཏན་ལ་ཕབ་པའི་དུས་ཀྱི་མཐའ་མ་དེའི་སྐོར་ཡིན་པས་སོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་མཐོང་བའི་ལུག་ཐུག་རྭ་ཅོ་གཉིས་ཅན་དེ་ནི་མཱ་ཏི་དང་ཏ་ཟིག་གཉིས་ཀྱི་རྒྱལ་པོ་ཡིན།"]},{"type":"verse","number":21,"content":["ཡང་ར་ཕོ་ར་རྩིད་མང་པོ་ཅན་དེ་ནི་གྷི་རི་སི་ཡུལ་གྱི་རྒྱལ་པོ་ཡིན་པ་དང་། དེའི་མིག་ཟུང་གི་བར་དུ་ཡོད་པའི་རྭ་ཅོ་ཆེན་པོ་དེ་ནི་དེའི་རྒྱལ་པོ་དང་པོ་ཡིན།"]},{"type":"verse","number":22,"content":["ཡང་རྭ་ཅོ་ཞིག་ཆག་པར་གྱུར་ཅིང་དེའི་ཤུལ་དུ་རྭ་ཅོ་གཞན་པ་བཞི་སྐྱེས་པ་དེ་ནི་རྒྱལ་ཁབ་དེ་ལས་རྒྱལ་ཁམས་བཞི་འབྱུང་བར་འགྱུར་བ་དེ་ཡིན་མོད། འོན་ཀྱང་དེ་རྣམས་ནི་ཁོའི་དབང་སྟོབས་ལས་བརྒལ་མི་སྲིད།"]},{"type":"verse","number":23,"content":["ཡང་རྒྱལ་ཁམས་དེ་རྣམས་ཀྱི་དུས་མཇུག་གྱེན་ལོག་པ་རྣམས་ཀྱི་ངན་སྤྱོད་ཚད་ལས་བརྒལ་བའི་དུས་སུ། གདོང་རིས་འཇིགས་སུ་རུང་བའི་རྒྱལ་པོ་ཞིག་འབྱུང་ཞིང་དེ་ནི་གཡོ་སྒྱུ་ཚ་པོ་ཞིག་ཡིན།"]},{"type":"verse","number":24,"content":["ཁོ་རང་དབང་སྟོབས་ཧ་ཅང་ཆེ་ནའང་དེ་ནི་རང་གི་མཐུ་སྟོབས་ལས་བྱུང་བ་མ་ཡིན། ཁོས་གཏོར་བརླག་སྐྱི་གཡའ་བ་གཏོང་ངེས་ལ། ཅི་བྱེད་འདོད་ན་དོན་ཀུན་ལྷུན་གྱིས་འགྲུབ་པར་མ་ཟད། སྟོབས་ཤུགས་ཆེ་བའི་མི་དང་མི་སྡེ་དམ་པ་རྣམས་ཀྱང་ཕམ་པར་རྒྱག་ངེས་ཡིན།"]},{"type":"verse","number":25,"content":["ཁོས་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་ནས་གཞན་ལ་བསླུ་བྲིད་གཏོང་ཞིང་། སེམས་ལ་ཁེངས་དྲེགས་ཆེན་པོ་བཅངས་ནས་མི་ལ་མཉམ་འཇོག་མེད་དུས་མི་མང་པོ་རྩ་མེད་དུ་གཏོང་བ་དང་། རྒྱལ་པོ་ཀུན་གྱི་རྒྱལ་པོ་ལའང་རྒོལ་བར་འགྱུར་ཏེ། མི་མ་ཡིན་པ་ཞིག་གིས་ཁོ་གསོད་པའི་བར་དུ་དེ་ལྟར་བྱེད་དོ། །"]},{"type":"verse","number":26,"content":["ནངས་དགོང་གི་ཞལ་གཟིགས་དེ་བདེན་པ་ཡིན་ནའང་། ཁྱོད་ཀྱིས་ཞལ་གཟིགས་དེ་གང་སར་མི་སྒྲོག་པར་སྦོས་ཤིག གང་ལ་ཞེ་ན། དེ་ནི་མ་འོངས་པའི་ལོ་ཟླ་མང་པོ་ཞིག་གི་སྐོར་ཡིན་པས་སོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":27,"content":["དཱ་ནེ་ཨེལ་བདག་ནི་ཤིན་ཏུ་ངལ་བ་དང་། ཉིན་འགའ་ལ་ན་བའི་རྗེས་སུ་ཡར་ལངས་ནས་རྒྱལ་པོའི་ལས་དོན་བསྒྲུབས་ནའང་། ཞལ་གཟིགས་དེ་ལ་བདག་ཧ་ལས་ཤིང་དེའི་དོན་རྟོགས་མ་ཐུབ་བོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DAN/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DAN/7.json","previousChapterAudioLinks":{},"numberOfVerses":27}