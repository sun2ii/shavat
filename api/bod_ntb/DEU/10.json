{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":10,"content":[{"type":"heading","content":["རྡོ་ལེབ་གསར་བཅོས།"]},{"type":"verse","number":1,"content":["སྐབས་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་རང་ལ་སྔར་གྱི་རྡོ་ལེབ་དང་འདྲ་བ་གཉིས་བརྐོས་ནས་ངའི་མདུན་དུ་རི་ལ་ཡོང་དགོས། དེ་ནས་ཤིང་གི་ཤུར་སྒམ་ཞིག་ཀྱང་བཟོས་ཤིག"]},{"type":"verse","number":2,"content":["བདག་གིས་ཁྱོད་ཀྱིས་བཅག་པའི་རྡོ་ལེབ་སྔ་མ་དེ་གཉིས་ཀྱི་སྟེང་ཡོད་པའི་ཚིག་རྣམས་རྡོ་ལེབ་འདི་གཉིས་ཀྱི་སྟེང་དུ་བརྐོ་བར་བྱ། ཁྱོད་ཀྱིས་དེ་གཉིས་ཤུར་སྒམ་ནང་དུ་འཇོག་དགོས་ཞེས་བཀའ་བསྩལ་བྱུང་།"]},{"type":"verse","number":3,"content":["དེ་བས་ངས་སེང་ལྡེང་ཤིང་གི་ཤུར་སྒམ་ཞིག་བཟོས་པ་དང་། སྔོན་མ་ནང་བཞིན་རྡོ་ལེབ་གཉིས་བརྐོས་ཤིང་དེ་གཉིས་ལག་ཏུ་བཟུང་ནས་རི་ལ་འགོས་པ་ཡིན།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་བཀོད་པ་སྟེ་འདུ་འཛོམས་ཀྱི་ཉིན་མོར་རི་བོའི་མེའི་དཀྱིལ་ནས་ཁྱོད་ཅག་ལ་བསྩལ་པའི་བཀའ་ཁྲིམས་བཅུ་པོ་རྡོ་ལེབ་གཉིས་ཀྱི་སྟེང་དུ་ཡི་གེར་བཀོད་ཅིང་། ཁོང་གིས་རྡོ་ལེབ་དེ་གཉིས་ང་ལ་གནང་བྱུང་།"]},{"type":"verse","number":5,"content":["དེ་ནས་ང་ཕྱིར་འཁོར་ནས་རི་ལས་བབས་པ་དང་། རྡོ་ལེབ་གཉིས་ངས་བཟོས་པའི་ཤུར་སྒམ་ནང་བཞག་པ་ཡིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བཀའ་བསྩལ་པ་ཇི་བཞིན་རྡོ་ལེབ་ད་དུང་དེ་རུ་ཡོད་དོ། །"]},{"type":"verse","number":6,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ཡཱ་ཨ་ཀན་པ་རྣམས་ཀྱི་ཁྲོན་པ་ཞེས་པའི་ཡུལ་ནས་མོ་སེ་རཱ་ལ་སོང་ཞིང་། ཨ་རོན་དེ་རུ་གྲོངས་ནས་དུར་ལ་སྦས་པ་དང་། ཁོའི་བུ་ཨེ་ལི་ཨ་ཟར་གྱིས་ཁོའི་ཚབ་ཏུ་མཆོད་དཔོན་གྱི་ལས་འགན་ཁུར་བའོ། །"]},{"type":"verse","number":7,"content":["ཡུལ་དེ་ནས་གུད་གོ་དཱ་དང་། གུད་གོ་དཱ་ནས་འབབ་ཆུ་བཞུར་བའི་ས་སྟེ་ཡོད་པ་ཐཱ་རུ་སོང་།"]},{"type":"verse","number":8,"content":["དེའི་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ལེ་ཝིའི་ཚོ་པ་ལོགས་སུ་བཀར་ནས་དེ་རིང་གི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་དུ་བཅུག་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལངས་ནས་ཁོང་ལ་བསྙེན་བཀུར་བྱེད་པ་དང་། ཁོང་གི་མཚན་ལ་བརྟེན་ནས་བྱིན་རླབས་སྩོལ་བར་མཛད་དོ། །"]},{"type":"verse","number":9,"content":["དེ་བས་ལེ་ཝི་པ་རྣམས་ལ་རང་གི་སྤུན་ཟླ་རྣམས་དང་འདྲ་བར་བགོ་སྐལ་དང་ནོར་སྐལ་ནི་མེད། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཞལ་བཞེས་གནང་བ་བཞིན་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་དེ་དག་གི་ནོར་སྐལ་ཡིན་པའོ། །"]},{"type":"verse","number":10,"content":["ཡང་ང་རང་སྔར་བཞིན་ཉིན་མཚན་བཞི་བཅུའི་རིང་ལ་རི་མགོར་བསྡད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་སྐབས་དེར་ཡང་བདག་གི་ཞུ་བར་གསན་ནས་ཁྱོད་རྣམས་ཚར་གཅོད་མཛད་པར་ཐུགས་མ་དགྱེས་སོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཡར་ལོངས་ལ་མི་རྣམས་ཀྱི་སྣེ་ཁྲིད་ནས་ལམ་དུ་ཆས་ཤིག ཅི་ལ་ཞེ་ན། བདག་གིས་ཁོ་ཚོའི་མེས་པོ་རྣམས་ལ་ཡུལ་དེ་ཁོ་ཚོར་སྦྱིན་པར་བྱའོ་ཞེས་མནའ་བསྐྱལ་བའི་ཡུལ་དེ་འཐོབ་པའི་ཕྱིར་ཡིན་ནོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":12,"content":["ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལྟོས་དང་། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ཅི་ཞིག་བསྒྲུབ་ཏུ་འཇུག་འདོད་པ་ཡིན་ནམ། དེ་ནི་ཁྱོད་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པ་དང་། ཁོང་གི་ཕེབས་ལམ་ཐམས་ཅད་དུ་འགྲུལ་ཞིང་ཁོང་ལ་དགའ་བ་དང་། བློ་གཅིག་སེམས་གཅིག་གིས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱེད་པ་དང་།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ལ་ཕན་ཐོགས་པའི་ཆེད་དུ་ངས་དེ་རིང་ཁྱོད་ཅག་ལ་བསྒོས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས་རྣམས་བརྩི་སྲུང་བྱེད་པ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["ལྟོས་དང་། ནམ་མཁའ་དང་ནམ་མཁའི་དབྱིངས་རྣམས་དང་། ས་གཞི་དང་དེའི་ནང་བཅུད་ཐམས་ཅད་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཡིན།"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་རྣམས་ཀྱི་མེས་པོ་འབའ་ཞིག་ལ་ཐུགས་མོས་ཤིང་། ཁོ་རྣམས་ལ་བྱམས་པ་དང་། ཁོང་གིས་དེ་དག་གི་བུ་རྒྱུད་དེ། ཁྱོད་རྣམས་ནི་མི་རིགས་ཐམས་ཅད་ལས་དེ་རིང་ནང་བཞིན་བདམས་པར་མཛད།"]},{"type":"verse","number":16,"content":["དེ་བས་ཁྱོད་ཅག་གིས་རང་གི་སེམས་ལ་མཚན་སྐྱི་ཆོད་ཅིག",{"noteId":0},"མཇིང་པ་མཁྲེགས་པོ་མ་བྱེད་ཅིག"]},{"type":"verse","number":17,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ལྷ་རྣམས་ཀྱི་དཀོན་མཆོག་དང་། གཙོ་བོ་རྣམས་ཀྱི་གཙོ་བོ། ཆེ་ཞིང་མཐུ་སྟོབས་ལྡན་པ་དང་། འཇིགས་སུ་རུང་བ་བཅས་ཀྱི་དཀོན་མཆོག་ཡིན་ལ། ཁོང་ལ་ཕྱོགས་རིས་མེད་པ་དང་ཁོང་གིས་གསུག་ཀྱང་མི་བཞེས།"]},{"type":"verse","number":18,"content":["ཁོང་གིས་དྭ་ཕྲུག་དང་ཡུགས་མོ་རྣམས་ལ་དྲང་བདེན་མཛད་ཅིང་། བྱེས་པ་རྣམས་ལ་གཅེས་ཤིང་ལྟོ་གོས་སྤྲོད་པ་ཡིན།"]},{"type":"verse","number":19,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་ཅག་ཀྱང་ཨེ་ཅིབ་ཡུལ་དུ་བྱེས་པ་ཡིན་པས་བྱེས་པ་རྣམས་ལ་གཅེས་པར་རིགས།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པ་དང་། ཁོང་ལ་བསྙེན་བཀུར་བྱས་ནས་ཁོང་ལ་དམ་པོར་བརྟེན་པ་དང་། ཁོང་གི་མཚན་ལ་བརྟེན་ནས་མནའ་བསྐྱལ་བ་བཅས་བྱེད་དགོས།"]},{"type":"verse","number":21,"content":["ཁོང་ནི་ཁྱོད་རྣམས་ཀྱིས་བསྟོད་འོས་པ་དང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡིན་ཏེ། ཁྱོད་ཅག་གིས་དངོས་སུ་མཐོང་བའི་ཆེ་ཞིང་འཇིགས་སུ་རུང་བའི་དོན་རྣམས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་མཛད་མཁན་ཡིན།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་ཨེ་ཅིབ་ཡུལ་དུ་འགྲོ་དུས་དེ་ཚོའི་མི་གྲངས་ནི་བསྡོམས་པས་བདུན་ཅུ་ཙམ་ཡིན། ད་ལྟ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་གྲངས་ཀ་ནམ་མཁའི་སྐར་ཚོགས་ལྟར་མཛད་པ་ཡིན་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འདིར་སེམས་ལ་མཚན་སྐྱི་ཆོད་ཅིག་ཅེས་པ་ནི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་བཤད་སྲོལ་ཡིན་ལ། དོན་དུ་སོ་སོ་དཀོན་མཆོག་ལ་གཏོགས་པའི་རྟགས་ཤིག་ཡོད་དགོས་པ་སྟེ། སེམས་ཀྱི་མི་གཙང་བ་རྣམས་འདོར་བར་གདམས་པ་ཡིན།","reference":{"chapter":10,"verse":16}}]},"thisChapterLink":"/api/bod_ntb/DEU/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}