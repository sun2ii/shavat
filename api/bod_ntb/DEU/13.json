{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":13,"content":[{"type":"heading","content":["སྐུ་འདྲ་ལ་མཆོད་པར་འཛེམ་དགོས་པ།"]},{"type":"verse","number":1,"content":["གལ་སྲིད་ཁྱོད་ཚོའི་ནང་དུ་ལུང་སྟོན་པ་དང་རྨི་ལམ་པ་བྱུང་སྟེ། ཁྱོད་རྣམས་ལ་གྲུབ་རྟགས་དང་དོན་ངོ་མཚར་ཅན་སྟོན་པ་དང་།"]},{"type":"verse","number":2,"content":["ཁོས་ཁྱོད་རྣམས་ལ་སྨྲས་པའི་གྲུབ་རྟགས་དང་དོན་ངོ་མཚར་ཅན་དེ་དག་དངོས་སུ་བྱུང་ནས་དེས་ཁྱོད་རྣམས་ལ། རང་ཅག་ཁྱོད་རྣམས་ལ་རྒྱུས་མི་མངའ་བའི་ལྷ་གཞན་དག་གི་རྗེས་སུ་འབྲངས་ནས་དེ་དག་ལ་བསྙེན་བཀུར་བྱེད་པར་བྱ་ཞེས་སྨྲས་ན།"]},{"type":"verse","number":3,"content":["ལུང་སྟོན་པ་དང་རྨི་ལམ་པ་དེའི་གཏམ་ལ་ཉན་མི་རུང་། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བློ་གཅིག་སེམས་གཅིག་གིས་དགའ་འམ་མི་དགའ་ཤེས་པའི་ཕྱིར་ཚོད་བགམ་མཛད་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་རྗེས་སུ་འབྲང་དགོས་པ་དང་། ཁོང་ལ་གུས་ཤིང་འཇིགས་ནས་ཁོང་གི་བཀའ་རྣམས་བསྲུངས་ཏེ་ཁོང་གི་གསུང་སྐད་ལ་ཉན་དགོས་ལ། ཁོང་ལ་བསྙེན་བཀུར་ཕུལ་ནས་ཁོང་ལ་དམ་པོར་བརྟེན་དགོས་སོ། །"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་ལུང་སྟོན་པའམ་རྨི་ལམ་པ་དེས་ངོ་ལོག་གི་གཏམ་སྨྲས་ཏེ། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་ཅིང་བྲན་དུ་བཀོལ་བའི་གནས་ནས་བསྐྱབས་འོངས་པའི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ངོ་ལོག་བྱེད་པ་དང་། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་འགྲུལ་བར་བསྒོས་པའི་ལམ་དང་འབྲལ་དུ་འཇུག་འདོད་པ་ཡིན་པས་མི་དེ་གསོད་དགོས། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":6,"content":["གལ་སྲིད་ཁྱོད་རྣམས་ཀྱི་མ་གཅིག་གི་སྤུན་ཟླ་དང་། ཁྱོད་ཅག་གི་བུ་དང་བུ་མོ་དང་། ཁྱོད་རྣམས་ཀྱི་གཅེས་པའི་ཆུང་མ་དང་། ཁྱོད་རྣམས་ཀྱི་སྲོག་དང་འདྲ་བའི་གྲོགས་པོ་སོགས་ཀྱིས་གསང་བའི་སྒོ་ནས་ཁྱོད་ཅག་བསླུས་ཏེ། རང་ཅག་ལྷ་གཞན་དག་ལ་བསྙེན་བཀུར་བྱེད་དུ་འགྲོ་ཞེས་སྨྲ་ཞིང་། དེ་ནི་ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་ལ་རྒྱུས་མི་མངའ་བ་ཞིག་ཡིན་པ་དང་།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གི་མཐའ་འཁོར་གྱི་མི་ཡི་ལྷ་རྣམས་ཏེ། ཁྱོད་རྣམས་དང་ཉེ་བའམ་ཡང་ན་ཁྱོད་རྣམས་དང་ཁ་ཐག་རིང་བའི་ལྷ་རྣམས་དང་། ས་གཞིའི་ཕྱོགས་གཅིག་ནས་ཕྱོགས་གཞན་བར་གྱི་ལྷ་རྣམས་བཅས་གང་ཡིན་ཡང་།"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ཀྱིས་དེ་ལ་མགོ་མི་འདོགས་ཤིང་ཉན་ཡང་མི་འོས་པ་དང་། ཁྱོད་རྣམས་ཀྱི་མིག་ལམ་ནས་དེ་གཅེས་སུ་འཛིན་མི་རུང་ལ་སྙིང་རྗེ་ཡང་བསྐྱེད་མི་རུང་། འགེབ་སྲུང་ཡང་བྱེད་མི་རུང་སྟེ།"]},{"type":"verse","number":9,"content":["ཁྱོད་ཀྱིས་ཁོ་ངེས་པར་གསོད་དགོས། རང་གིས་སྔོན་ལ་ལག་འགུལ་བ་དང་། དེ་ནས་མི་ཐམས་ཅད་ཀྱིས་ཀྱང་ལག་འགུལ་ནས་ཁོ་གསོད་དགོས།"]},{"type":"verse","number":10,"content":["མི་དེ་རྡོ་རུབ་བཏང་ནས་གསོད་དགོས། ཅི་ལ་ཞེ་ན། དེས་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པ་དང་བྲན་དུ་བཀོལ་བའི་གནས་ནས་སྐྱོབ་མཁན་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནས་ལོག་ལམ་དུ་འདྲེན་འདོད་པ་ཡིན།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་ཀུན་གྱིས་དེ་ཐོས་པ་དང་འཇིགས་ནས་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་དེ་འདྲའི་ལས་ངན་པ་ནམ་ཡང་བསྒྲུབ་པར་མི་བྱའོ། །"]},{"type":"verse","number":12,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་འཚོ་སྡོད་བྱེད་སར་གནང་བའི་གྲོང་ཁྱེར་ཞིག་ལས།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱི་དབུས་ནས་མི་ཐ་ཤལ་",{"noteId":1},"འགའ་ཐོན་ཏེ། གྲོང་ཁྱེར་དེའི་ཡུལ་མི་རྣམས་ལ་ཁྱོད་ཚོར་རྒྱུས་མི་མངའ་བའི་ལྷ་གཞན་དག་ལ་བསྙེན་བཀུར་བྱེད་དུ་འགྲོ་ཞེས་སྨྲས་ཏེ། མི་རྣམས་ལོག་ལམ་དུ་འདྲེན་པའི་གཏམ་ཐོས་ན།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་བརྟག་དཔྱད་ཞིབ་འཇུག་དང་འདྲི་གཅོད་ཞིབ་མོ་བྱེད་དགོས་ལ། གལ་སྲིད་ཁྱོད་ཅག་གི་ཁྲོད་དུ་སྐྱུག་བྲོ་བའི་བྱ་སྤྱོད་དེ་ལྟ་བུ་ཡོད་པ་བདེན་ན།"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་ཀྱིས་གྲོང་ཁྱེར་དེ་རུ་སྡོད་པའི་མི་རྣམས་ལ་རལ་གྲིས་བསྣུན་དགོས་ཤིང་། གྲོང་ཁྱེར་དེ་དང་དེ་རུ་ཡོད་པ་ཐམས་ཅད་དང་། ཕྱུགས་ཁྱུ་རྣམས་ཀྱང་རལ་གྲིའི་ཁ་ནས་རྩ་མེད་གཏོང་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":16,"content":["གྲོང་ཁྱེར་ནས་འཕྲོག་བཅོམ་བྱས་པའི་རྒྱུ་ནོར་ཐམས་ཅད་གྲོང་ཁྱེར་དེའི་ཐང་ཆེན་དུ་སྤུངས་ནས། གྲོང་ཁྱེར་དང་དེ་ནས་འཕྲོག་བཅོམ་བྱས་པའི་རྒྱུ་ནོར་ཐམས་ཅད་མེར་བསྲེགས་ཏེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས། དེ་ནས་གྲོང་ཁྱེར་དེ་ནི་ནམ་ཡང་ཞིག་རོར་ལུས་ནས་སླར་བརྩིག་པར་མི་བྱའོ། །"]},{"type":"verse","number":17,"content":["རྩ་མེད་གཏོང་འོས་པའི་རྫས་གང་ཡང་ཁྱོད་རྣམས་ཀྱི་ལག་ཏུ་བསྐྱུར་མི་རུང་སྟེ། དེ་ནས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་ཞི་ནས་ཁྱོད་ཅག་ལ་སྙིང་རྗེ་དང་བྱམས་བརྩེ་དགོངས་པ་དང་། ཁྱོད་ཅག་གི་མེས་པོ་ལ་བཞེས་པའི་མནའ་བཞིན་ཁྱོད་རྣམས་འཕེལ་བར་བྱེད།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་སྐད་ལ་ཉན་པ་དང་། བདག་གིས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསྒོས་པའི་བཀའ་ཐམས་ཅད་བསྲུངས་ནས། ཁོང་གི་སྤྱན་སྔར་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་ན་དེ་བཞིན་འབྱུང་ངེས་སོ། །"]}],"footnotes":[{"noteId":1,"caller":"+","text":"འདིར་མི་ཐ་ཤལ་ཞེས་པར་མ་ཕྱི་ལ་པཱ་ལེ་ཡ་ཨལ་ཞེས་འབྱུང་བ་སྟེ། སྙིང་པོ་མེད་པ་དང་ངན་པའི་དོན་ལ་འཇུག་ཅིང་། དེ་ནི་བདུད་སཱ་ཏན་གྱི་མིང་གཞན་ཡིན།","reference":{"chapter":13,"verse":13}}]},"thisChapterLink":"/api/bod_ntb/DEU/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/12.json","previousChapterAudioLinks":{},"numberOfVerses":18}