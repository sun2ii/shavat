{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":14,"content":[{"type":"heading","content":["ཁ་ཟས་གཙང་དང་མི་གཙང་བ།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བུ་དང་བུ་མོ་ཡིན་པས། གཤིན་པོའི་དོན་དུ་རང་གི་ལུས་པོ་གཅོད་མི་རུང་ལ། ཁྱོད་ཅག་གི་ཐོད་སྤུ་ཡང་བཞར་མི་རུང་།"]},{"type":"verse","number":2,"content":["གང་ལ་ཞེ་ན། ཁྱོད་ཅག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པའི་མི་དམ་པ་རྣམས་ཡིན་ཞིང་། ཁོང་གིས་ས་སྟེང་གི་མི་རིགས་ཐམས་ཅད་ལས་ཁྱོད་རྣམས་བདམས་ཏེ་ཁོང་གི་ནོར་བུ་རུ་མཛད་པའོ། །"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ཀྱིས་སྐྱུག་བྲོ་བའི་རྫས་གང་ཡང་བཟའ་མི་རུང་།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་ཀྱིས་བཟའ་རུང་བའི་སྲོག་ཆགས་ནི་འདི་དག་སྟེ། བ་གླང་དང་། ལུག་དང་། ར་དང་།"]},{"type":"verse","number":5,"content":["ཤྭ་བ་དང་། དགོ་བ་དང་། ཁ་ཤྭ་དང་། ར་རྒོད་དང་། སྐྱིན་དང་། གཙོད་དང་། གཉན་བཅས་ཡིན་ལ།"]},{"type":"verse","number":6,"content":["རི་དྭགས་རྨིག་པ་གཉིས་སུ་ཁ་འཕྲལ་བའམ་རྨིག་སོར་ཁ་འཕྲལ་ཅན་དང་སྐྱུག་ལྡད་བྱེད་པ་རྣམས་བཟའ་རུང་བ་ཡིན།"]},{"type":"verse","number":7,"content":["འོན་ཀྱང་སྐྱུག་ལྡད་བྱེད་པའམ་རྨིག་པ་ཁ་འཕྲལ་ཅན་རྣམས་ལས་བཟའ་མི་རུང་བ་ནི། རྔ་མོང་དང་རི་བོང་། འཕྱི་བ་བཅས་ཡིན་ཏེ། ཅི་ལ་ཞེ་ན། དེ་དག་གིས་སྐྱུག་ལྡད་བྱེད་ནའང་རྨིག་པ་ཁ་འཕྲལ་མེད་པས་ཁྱོད་རྣམས་ལ་མཚོན་ན་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":8,"content":["ཡང་ཕག་ནི་རྨིག་པ་ཁ་འཕྲལ་ཅན་ཡིན་ཡང་སྐྱུག་ལྡད་མི་བྱེད་པས་ཁྱོད་རྣམས་ལ་མཚོན་ན་མི་གཙང་བ་ཡིན་ལ། དེ་དག་གི་ཤ་ནི་བཟའ་མི་རུང་། དེ་དག་གི་རོ་རྣམས་ལ་རེག་ཀྱང་མི་རུང་ངོ་། །"]},{"type":"verse","number":9,"content":["ཡང་ཆུ་ལ་གནས་པ་ཐམས་ཅད་ལས་ཁྱོད་ཅག་གིས་བཟའ་རུང་བ་ནི་འདི་དག་སྟེ། གཤོག་པ་ཅན་དང་ཉ་སག་ཅན་ཐམས་ཅད་བཟའ་རུང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["གཤོག་པ་དང་ཉ་སག་མེད་པ་ཐམས་ཅད་ཁྱོད་ཅག་ལ་མཚོན་ན་མི་གཙང་བ་ཡིན་པས་བཟའ་མི་རུང་ངོ་། །"]},{"type":"verse","number":11,"content":["འདབ་ཆགས་གཙང་མ་ཐམས་ཅད་ཁྱོད་ཅག་གིས་བཟའ་རུང་བ་ཡིན།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་བཟའ་མི་རུང་བའི་འདབ་ཆགས་ནི་འདི་དག་སྟེ། གླག་དང་བྱ་རྒོད་དང་གོ་བོ་དང་།"]},{"type":"verse","number":13,"content":["ནེ་ལེ་དང་། བྱ་ཁྲ་དང་། འོལ་པའི་རིགས་དང་།"]},{"type":"verse","number":14,"content":["ཕོ་རོག་གི་རིགས་དང་།"]},{"type":"verse","number":15,"content":["རྔ་བྱ་དང་སྲིན་བྱ་དང་། ཆུ་སྐྱར་དང་ཁྲའི་རིགས་དང་།"]},{"type":"verse","number":16,"content":["འུག་ཆུང་དང་འུག་རྒན་དང་། འུག་དཀར་དང་།"]},{"type":"verse","number":17,"content":["འུག་སེར་དང་དུར་བྱ་དང་། སོ་བྱ་དང་།"]},{"type":"verse","number":18,"content":["ཁྲུང་ཁྲུང་དང་སྐྱར་མོ་རྐང་རིང་གི་རིགས་དང་པུ་ཤུད་དང་ཕ་ཝང་བཅས་ཡིན།"]},{"type":"verse","number":19,"content":["ཡང་ལྟོ་འགྲོ་འབུ་སྲིན་གཤོག་པ་ཅན་ཐམས་ཅད་ནི་ཁྱོད་ཅག་ལ་མཚོན་ན་མི་གཙང་བ་ཡིན་པས་བཟའ་མི་རུང་།"]},{"type":"verse","number":20,"content":["གཤོག་ལྡན་གཙང་མ་ཐམས་ཅད་ཁྱོད་ཅག་གིས་བཟའ་རུང་བའོ། །"]},{"type":"verse","number":21,"content":["ཤི་ཤ་གང་ཡིན་ཡང་ཁྱོད་རྣམས་ཀྱིས་བཟའ་མི་རུང་སྟེ། ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གནས་པའི་བྱེས་པ་ལ་སྟེར་བའམ། ཕྱི་མི་ཞིག་ལ་བཙོང་དགོས། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པའི་མི་དམ་པ་ཡིན། ར་ཕྲུག་ཅིག་དེའི་ཨ་མའི་འོ་མའི་ནང་དུ་བཙོ་མི་རུང་ངོ་། །"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཞིང་ལས་ལོ་རེར་སྨིན་པའི་ལོ་ཏོག་ཡོངས་ཀྱི་བཅུ་ཆ་གཅིག་འབུལ་དགོས་ལ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་ནམ་ཡང་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པ་ཤེས་པའི་ཆེད་དུ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མདུན་དྲུང་སྟེ་ཁོང་གིས་ཉིད་ཀྱི་མཚན་འགོད་པར་བདམས་པའི་ཡུལ་དུ། ཁྱོད་རྣམས་ཀྱི་འབྲུ་རིགས་དང་རྒུན་ཆང་གསར་པ་དང་། སྣུམ་གསར་པའི་བཅུ་ཆ་གཅིག་དང་། བ་ཁྱུ་དང་ར་ལུག་གི་ཁྱུ་ཡི་སྐྱེས་འགོ་རྣམས་བཟའ་དགོས།"]},{"type":"verse","number":24,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་བའི་ཚེ། གལ་ཏེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་མཚན་འགོད་པར་བདམས་པའི་ཡུལ་དེ་ནི་ཁྱོད་ཅག་དང་རྒྱང་ཐག་རིང་དྲགས་ནས་མཆོད་རྫས་རྣམས་ཡུལ་དེར་འཁྱེར་མི་ནུས་ན།"]},{"type":"verse","number":25,"content":["བཅུ་ཆ་གཅིག་དེ་ཁྱོད་རྣམས་ཀྱིས་དངུལ་ལ་བརྗེས་ནས། དངུལ་དེ་ལག་ཏུ་བཟུང་ནས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བདམས་པའི་གནས་དེར་འགྲོ་དགོས།"]},{"type":"verse","number":26,"content":["དངུལ་དེ་ཁྱོད་རྣམས་ཀྱི་འདོད་པ་བཞིན་བཀོལ་ཆོག་སྟེ། བ་གླང་དང་ར་ལུག་དང་། རྒུན་ཆང་དང་གར་ཆང་སོགས་ཁྱོད་གང་ལ་དགའ་ན་དེ་ཐམས་ཅད་ཉོས་ཆོག་ལ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཁྱོད་རྣམས་དང་རང་གི་ནང་མི་ཀུན་གྱིས་བཟའ་བཏུང་ལ་རོལ་ནས་དགའ་བར་འགྱུར།"]},{"type":"verse","number":27,"content":["ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གནས་པའི་ལེ་ཝི་པ་རྣམས་ལ་ཐོབ་སྐལ་དང་ནོར་སྐལ་མེད་པས་ཁྱོད་ཅག་གིས་སྣང་མེད་དུ་བསྐྱུར་མི་རུང་ངོ་། །"]},{"type":"verse","number":28,"content":["ལོ་འཁོར་གསུམ་རེའི་མཇུག་ཏུ། ལོ་དེའི་ཡོང་འབབ་ཀུན་གྱི་བཅུ་ཆ་གཅིག་ཁྱེར་འོངས་ནས་ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གསོག་འཇོག་བྱེད་དགོས།"]},{"type":"verse","number":29,"content":["དེ་ནས་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་ཐོབ་སྐལ་དང་ནོར་སྐལ་མེད་པའི་ལེ་ཝི་པ་རྣམས་དང་། ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གནས་པའི་བྱེས་པ་རྣམས་དང་། དྭ་ཕྲུག་དང་ཡུགས་མོ་རྣམས་ཡོང་ནས་ཚིམ་པར་ཟོས་ཆོག་ལ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལག་གི་ལས་ཀ་ཐམས་ཅད་ལ་བྱིན་རླབས་གནང་བར་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/13.json","previousChapterAudioLinks":{},"numberOfVerses":29}