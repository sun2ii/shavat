{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":15,"content":[{"type":"heading","content":["ངལ་གསོ་བའི་ལོ།"]},{"type":"verse","number":1,"content":["ལོ་བདུན་རེ་རྫོགས་པའི་མཚམས་སུ་ཁྱོད་རྣམས་ཀྱིས་བུ་ལོན་ཆག་ཡང་གཏོང་དགོས།"]},{"type":"verse","number":2,"content":["ཆག་ཡང་གཏོང་ཚུལ་ནི་འདི་ལྟར་ཡིན་ཏེ། བུན་བདག་སུ་ཡིན་ཡང་ཁྱིམ་མཚེས་ལ་གང་ཞིག་བསྐྱིས་པ་ཐམས་ཅད་ཆག་ཡང་གཏོང་དགོས། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དུ་ཆག་ཡང་གཏོང་བའི་ལོ་ཡིན་པར་བསྒྲགས་ཡོད་པས། ཁྱིམ་མཚེས་དང་སྤུན་ཟླ་རྣམས་ལ་བུ་ལོན་འདེད་མི་རུང་།"]},{"type":"verse","number":3,"content":["གལ་སྲིད་ཕྱི་ཕྱོགས་པ་ལ་བསྐྱིས་པ་ཡིན་ན་བུ་ལོན་དེད་ཆོག་མོད། འོན་ཀྱང་རང་གི་སྤུན་ཟླར་བསྐྱིས་པ་ཡིན་ན། བུ་ལོན་གང་ཡིན་ཡང་ཆག་ཡང་གཏོང་དགོས།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་ཀྱི་ནང་དུ་དབུལ་པོ་གཅིག་ཀྱང་ཡོད་མི་སྲིད། གང་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་དེ་རུ་ཁོང་གིས་ཁྱོད་ཅག་ལ་བྱིན་རླབས་ཆེན་པོ་གནང་བར་འགྱུར།"]},{"type":"verse","number":5,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་སྐད་ལ་ཞིབ་ཏུ་མཉན་པ་དང་། ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསྒོས་པའི་བཀའ་རྒྱ་ཐམས་ཅད་བསྲུངས་ནས་བསྒྲུབས་ན།"]},{"type":"verse","number":6,"content":["དེ་ཡང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ཞལ་བཞེས་གནང་བ་ཇི་བཞིན་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་ངེས་ཡིན། ཁྱོད་རྣམས་ཀྱིས་མི་མང་པོར་བུ་ལོན་བཏང་ནའང་། རང་གིས་གཞན་སུ་ལས་ཀྱང་བསྐྱི་མི་དགོས། ཁྱོད་རྣམས་ཀྱིས་མི་མང་པོ་དབང་དུ་བསྒྱུར་ན་ཡང་། དེ་དག་གིས་ཁྱོད་རྣམས་དབང་དུ་བསྡུ་མི་ནུས་སོ། །"]},{"type":"verse","number":7,"content":["གལ་སྲིད་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བའི་ཡུལ་གྱི་གྲོང་རྡལ་གང་རུང་དུ་ཁྱོད་ཅག་གི་སྤུན་ཟླ་སུ་ཞིག་དབུལ་པོ་ཡིན་ན། སྤུན་ཟླ་དབུལ་པོ་དེ་ལ་ཁྱོད་རྣམས་ཀྱི་སེམས་མཁྲེགས་པོ་བྱེད་མི་རུང་ལ། སེར་སྣ་བྱས་ནས་བསྐྱུར་ཡང་མི་རུང་།"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ཀྱིས་ལག་པ་བརྐྱངས་ཏེ་ཁོ་ལ་ཅི་དགོས་པ་ལྟར་བསྐྱིས་ནས་དགོས་མཁོ་སྐོང་དགོས་སོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་གཟབ་གཟབ་བྱེད་དགོས་ཏེ། ཆག་ཡང་གཏོང་བའི་ལོ་བདུན་པ་བསླེབ་ལ་ཉེ་ཞེས་ངན་སེམས་བཅངས་ནས། ཁྱོད་རྣམས་ཀྱིས་རང་གི་སྤུན་ཟླ་དབུལ་པོ་ལ་སྡང་མིག་བགྲད་ནས་ཁོ་ལ་ཅི་ཡང་མི་སྟེར་ན། ཁོས་ཁྱོད་རྣམས་ཀྱི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་འབོད་པ་དང་། དེ་ནས་ཁྱོད་རྣམས་སྡིག་པའི་ནང་དུ་ལྷུང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["གཏོང་ཕོད་ཆེན་པོས་ཁོ་ལ་སྟེར་དགོས་ཤིང་། སྟེར་བའི་སྐབས་སུ་སྙིང་ནད་བཅང་མི་རུང་། ཅི་ལ་ཞེ་ན། བྱ་བ་དེའི་དོན་དུ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལག་གི་ལས་ཀ་ཐམས་ཅད་དང་། ཁྱོད་རྣམས་ཀྱི་དོན་བྱ་ཐམས་ཅད་ལ་བྱིན་རླབས་མཛད་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":11,"content":["ཡུལ་འདིར་ནམ་ཡང་དབུལ་ཕོངས་གནས་པར་འགྱུར་བས། ཁྱོད་རྣམས་ཀྱིས་རང་ཡུལ་གྱི་སྤུན་ཟླ་སྐྱོ་བོ་དང་དབུལ་པོ་ཡིན་པ་རྣམས་ལ་གཏོང་ཕོད་ཆེན་པོས་རོགས་སྐྱོར་བྱེད་དགོས་ཞེས་ངས་ཁྱོད་རྣམས་ལ་བཀའ་བསྒོ་བར་བྱའོ། །"]},{"type":"verse","number":12,"content":["དེ་ཡང་ཁྱོད་རྣམས་ཀྱི་སྤུན་ཟླ་དེ་ཨིབ་རི་པའི་སྐྱེས་པ་དང་ཡང་ན་ཨིབ་རི་པའི་བུད་མེད་གང་ཡིན་ཡང་། གལ་སྲིད་རང་ལུས་ཁྱོད་རྣམས་ལ་བཙོངས་པ་ཡིན་ན། ལོ་དྲུག་གི་རིང་ཁྱོད་རྣམས་ལ་གཡོག་བྱེད་དགོས། ལོ་བདུན་པར་ཁྱོད་རྣམས་ཀྱིས་དེ་ལ་རང་དབང་སྤྲད་ནས་འགྲོ་རུ་འཇུག་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་དེ་ལ་རང་དབང་སྤྲོད་པའི་སྐབས་སུ་ལག་སྟོང་དུ་གཏོང་མི་རུང་།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱི་ར་ལུག་གི་ཁྱུ་དང་གཡུལ་ཁ། རྒུན་འབྲུམ་འཚིར་གཞོང་བཅས་ནས་དེ་ལ་མཐུན་རྐྱེན་རྒྱས་པར་སྦྱོར་དགོས། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བྱིན་གྱིས་བརླབས་པའི་རྒྱུ་ནོར་ལས་ཁོ་ལ་སྐལ་སྟེར་དགོས།"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་བྲན་གཡོག་ཡིན་པ་དང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་བསྐྱབས་འོངས་པ་དྲན་པར་གྱིས། དེ་བས་ངས་དེ་རིང་ཁྱོད་ཅག་ལ་འདི་ལྟར་བསྒོས་པ་ཡིན།"]},{"type":"verse","number":16,"content":["གལ་སྲིད་ཁོས་ང་ཁྱེད་དང་འབྲལ་མི་འདོད་ཅེས་སྨྲ་བ་ཡིན་ན། དེ་ནི་ཁོ་ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་གི་ནང་མི་ལ་བརྩེ་འདང་ཡོད་པ་དང་། ཁོ་ཁྱོད་རྣམས་དང་མཉམ་དུ་བསྡད་ན་ཤིན་ཏུ་ལེགས་སོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁོ་སྒོ་འགྲམ་ནས་བསླངས་ཏེ་སྙུང་བུས་ཁོའི་རྣ་བ་འབིགས་དགོས་ལ། དེ་ནས་ཁོ་ནི་རྟག་ཏུ་ཁྱོད་རྣམས་ཀྱི་གཡོག་པོ་ཡིན་ཏེ། ཁྱོད་རྣམས་ཀྱི་གཡོག་མོ་ལའང་དེ་བཞིན་བྱེད་དགོས།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁོ་ལ་རང་དབང་སྤྲད་ནས་འགྲོ་རུ་འཇུག་དུས་དེ་དཀའ་ལས་ཁག་པོར་མ་བསམ་ཞིག ཅི་ལ་ཞེ་ན། ཁོས་ལོ་དྲུག་གི་རིང་ཁྱོད་རྣམས་ལ་གཡོག་བྱས་པ་དང་གླ་པའི་གླ་ཡོན་ལྡབ་གཉིས་འཐོབ་འོས་པ་ཡིན་པས། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་དོན་ཅི་བསྒྲུབ་ལ་བྱིན་རླབས་གནང་བའོ། །"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱི་བ་ཁྱུ་དང་ར་ལུག་གི་ཁྱུ་ཡི་སྐྱེས་འགོ་ཕོ་ཕྱུགས་ཐམས་ཅད་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམ་པར་འབུལ་དགོས་ལ། བ་ཁྱུའི་སྐྱེས་འགོ་ལ་ཞིང་རྨོ་རུ་འཇུག་མི་རུང་ལ། ར་ལུག་གི་ཁྱུ་ཡི་སྐྱེས་འགོའི་བལ་ཡང་འབྲེག་མི་རུང་།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་ནང་མིས་ལོ་རེ་རེ་བཞིན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བདམས་པའི་ཡུལ་དུ་ཁོང་གི་དྲུང་ནས་སྐྱེས་འགོ་རྣམས་བཟའ་དགོས།"]},{"type":"verse","number":21,"content":["གལ་སྲིད་སྐྱེས་འགོ་དེ་ལ་ཞ་འཁུམས་དང་མིག་ལོང་བ་སོགས་ཀྱི་སྐྱོན་ཚབས་ཆེན་གང་དང་གང་ཡོད་ནའང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་མི་རུང་སྟེ།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་བཟའ་རུང་བ་དང་། མི་གཙང་མ་དང་གཙང་མ་མིན་པ་ཀུན་གྱིས་ཁྱད་མེད་དུ། དགོ་བ་དང་ཤྭ་བའི་ཤ་ཟ་བ་ནང་བཞིན་ཟོས་ཆོག་པ་ཡིན།"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་དེའི་ཁྲག་བཟའ་མི་རུང་སྟེ། དེ་ནི་ཆུ་ལྟར་ས་ལ་ལྡུག་དགོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/14.json","previousChapterAudioLinks":{},"numberOfVerses":23}