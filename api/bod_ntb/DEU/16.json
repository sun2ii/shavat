{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":16,"content":[{"type":"heading","content":["པེ་སག་གི་དུས་ཆེན།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ཀྱིས་ཨ་རྦིབ་ཟླ་བ་བསྲུངས་ནས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་པེ་སག་གི་དུས་ཆེན་སྲུངས་ཤིག ཅི་ལ་ཞེ་ན། ཨ་རྦིབ་ཟླ་བའི་མཚན་མོ་ཞིག་ལ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པའོ། །"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་རང་གི་མཚན་འགོད་པར་བདམས་པའི་གནས་སུ། ར་ལུག་དང་བ་གླང་ནས་པེ་སག་གི་དུས་ཆེན་དུ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམར་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ཀྱིས་དམར་མཆོད་དེ་དང་ལྷན་དུ་བག་ལེབ་སྐྱུར་ཅན་བཟའ་མི་རུང་། ཉིན་བདུན་གྱི་རིང་ལ་སྐྱུར་མེད་བག་ལེབ་སྟེ་སྐྱོ་གདུང་གི་བག་ལེབ་བཟའ་དགོས། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་རྟབ་རྟབ་པོར་ཕྱི་ལ་ཐོན་པ་ཡིན་ལ། ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་ཉིན་མོ་དེ་ཁྱོད་རྣམས་ཀྱི་མི་ཚེའི་ཁྲོད་རྟག་ཏུ་དྲན་དགོས།"]},{"type":"verse","number":4,"content":["ཉིན་བདུན་གྱི་རིང་ལ་ཁྱོད་རྣམས་ཀྱི་མངའ་ཁོངས་ཡོངས་སུ་སྐྱུར་རྩི་གང་ཡང་མཐོང་མི་རུང་། ཉིན་དང་པོའི་དགོང་མོར་ཕུལ་བའི་དམར་མཆོད་ཀྱི་ཤ་ནི་ཞོགས་པའི་བར་དུ་ལུས་མི་རུང་།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བའི་གྲོང་རྡལ་གང་དུའང་པེ་སག་གི་དུས་ཆེན་གྱི་དམར་མཆོད་བཤའ་མི་རུང་ལ།"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་མཚན་འགོད་པར་བདམས་པའི་གནས་འབའ་ཞིག་ཏུ། དགོང་མོ་ཉི་མ་ནུབ་པའི་དུས་ཏེ་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་དུས་སྐབས་དེར། ཁྱོད་རྣམས་ཀྱིས་པེ་སག་གི་དུས་ཆེན་གྱི་དམར་མཆོད་བཤའ་དགོས།"]},{"type":"verse","number":7,"content":["ཤ་དེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བདམས་པའི་གནས་དེར་བཙོས་ནས་བཟའ་དགོས་ལ། ཞོགས་པར་ཁྱོད་རྣམས་ད་གཟོད་རང་གི་གུར་དུ་ཕྱིར་འགྲོ་དགོས།"]},{"type":"verse","number":8,"content":["ཉིན་དྲུག་གི་རིང་ལ་ཁྱོད་རྣམས་ཀྱིས་སྐྱུར་མེད་བག་ལེབ་བཟའ་དགོས་ཤིང་། ཉིན་བདུན་པར་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དུ་འདུ་འཛོམས་དམ་ནན་ཡོད་དགོས་ཏེ། ཉིན་དེར་ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་ངོ་། །"]},{"type":"heading","content":["བདུན་ཕྲག་རྣམས་ཀྱི་དུས་ཆེན།"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་ཉིད་ཀྱི་ཕྱིར་བདུན་ཕྲག་བདུན་རྩིས་ཤིག འབྲུ་ཞིང་ཟོར་བས་བྲེགས་པའི་ཐོག་མ་ནས་བཟུང་སྟེ། བསྡོམས་པས་བདུན་ཕྲག་བདུན་རྩི་དགོས་ལ།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་བདུན་ཕྲག་རྣམས་ཀྱི་དུས་ཆེན་གཏོང་དགོས་ཏེ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་བ་ཇི་བཞིན། རང་ལ་འཛོམས་ཚོད་ཀྱིས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཡིད་མོས་མཆོད་པ་ཕུལ་ནས།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་རང་གི་མཚན་འགོད་པའི་ཕྱིར་བདམས་པའི་གནས་སུ། ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་བུ་དང་བུ་མོ། གཡོག་པོ་དང་གཡོག་མོ། ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གནས་པའི་ལེ་ཝི་པ། ཁྱོད་ཅག་ཁྲོད་ཀྱི་བྱེས་པ། དྭ་ཕྲུག་དང་ཡུགས་མོ་བཅས་ཐམས་ཅད་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དགའ་བར་གྱིས།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་ཉིད་ཨེ་ཅིབ་ཡུལ་ནས་བྲན་གཡོག་བྱས་པ་དྲན་དགོས་པ་དང་། སྒྲིག་ཁྲིམས་དེ་རྣམས་ནན་གྱིས་བསྲུང་དགོས་སོ། །"]},{"type":"heading","content":["སྤྱིལ་བུའི་དུས་ཆེན།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་གཡུལ་ཁ་དང་རྒུན་འབྲུམ་འཚིར་གཞོང་ནས་ཐོན་རྫས་བསྡུས་རྗེས། ཉིན་བདུན་གྱི་རིང་ལ་སྤྱིལ་བུའི་དུས་ཆེན་གཏོང་དགོས།"]},{"type":"verse","number":14,"content":["དུས་ཆེན་གྱི་སྐབས་སུ་ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་བུ་དང་བུ་མོ། གཡོག་པོ་དང་གཡོག་མོ། ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་གནས་པའི་ལེ་ཝི་པ་དང་བྱེས་པ། དྭ་ཕྲུག་དང་ཡུགས་མོ་བཅས་ཐམས་ཅད་དགའ་བར་གྱིས།"]},{"type":"verse","number":15,"content":["ཉིན་བདུན་གྱི་རིང་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་བདམས་པའི་གནས་སུ། ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དུས་ཆེན་བསྲུང་དགོས་ཏེ། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་ལོ་ཏོག་ཐམས་ཅད་དང་། ཁྱོད་རྣམས་ལག་གི་ལས་ཀ་ཀུན་ལ་བྱིན་རླབས་གནང་ནས་ཁྱོད་རྣམས་དགའ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱི་སྐྱེས་པ་ཐམས་ཅད་སྐྱུར་མེད་བག་ལེབ་ཀྱི་དུས་ཆེན་དང་། བདུན་ཕྲག་རྣམས་ཀྱི་དུས་ཆེན། སྤྱིལ་བུའི་དུས་ཆེན་བཅས་ཀྱི་སྐབས་སུ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བདམས་པའི་གནས་དེ་རུ་ལོ་རེར་ཐེངས་གསུམ་ལ་ཁོང་གི་དྲུང་དུ་འཛོམ་དགོས་ཤིང་། ཁོ་ཚོ་ལག་སྟོང་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཡོང་མི་རུང་།"]},{"type":"verse","number":17,"content":["མི་རེ་རེས་རང་རང་གི་འཛོམས་ཚོད་ལྟར། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བའི་བྱིན་རླབས་བཞིན་ཕྱག་རྟེན་འབུལ་དགོས་སོ། །"]},{"type":"heading","content":["ཁྲིམས་ཀྱི་དྲང་གཞག་སྐྱོང་བའི་སྐོར།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བར་འགྱུར་བའི་གྲོང་རྡལ་ཐམས་ཅད་དུ། ཁྱོད་རྣམས་ཀྱིས་ཚོ་པ་རེ་རེ་བཞིན་ཁྲིམས་དཔོན་དང་འགོ་དཔོན་བསྐོས་ཤིག དེ་དག་གིས་མི་རྣམས་ལ་ཁྲིམས་ཀྱི་དྲང་གཞག་སྐྱོང་དགོས།"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱིས་དྲང་པོ་འཁྱོག་པོར་བསྒྱུར་མི་འོས་ལ། མི་ལ་ཕྱོགས་རིས་ཀྱང་འཛིན་མི་རུང་། གསུག་ལེན་མི་རུང་། གང་ལ་ཞེ་ན། གསུག་གིས་མི་བློ་གྲོས་ཅན་གྱི་མིག་ལོང་བར་བྱེད་ཅིང་། མི་དྲང་པོ་རྣམས་ཀྱི་གཏམ་ཡང་གོ་ལྡོག་པར་བྱེད་པ་ཡིན།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་འཚོ་ཐུབ་པ་དང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བའི་ཡུལ་དེ་ས་སྐལ་དུ་ལོན་ཐུབ་པའི་ཕྱིར་ཁྱོད་རྣམས་ཀྱིས་དྲང་གཞག་འབའ་ཞིག་སྐྱོང་དགོས་སོ། །"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྩིགས་པའི་མཆོད་ཁྲིའི་འགྲམ་དུ་། ཤིང་སྡོང་གི་རིགས་གང་རུང་བཙུགས་ནས་དེས་ཨ་ཤེ་རཱ་བཟོ་མི་རུང་།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྡང་བའི་ལྷ་རྟེན་ཡང་རང་གི་ཕྱིར་དུ་མ་སྒྲེངས་ཤིག་ཅེས་བསྒོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}