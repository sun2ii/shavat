{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":19,"content":[{"type":"heading","content":["སྐྱབས་བཅོལ་གྲོང་ཁྱེར་གྱི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མི་རིགས་རྣམས་མེད་པར་མཛད་དེ། དེ་དག་གི་ཡུལ་རྣམས་ཁྱོད་ཅག་ལ་སྤྲད་པ་དང་། ཁྱོད་རྣམས་ཀྱིས་ཡུལ་མི་དེ་རྣམས་བསྐྲད་ནས་ཁྱོད་ཅག་དེ་དག་གི་གྲོང་ཁྱེར་རྣམས་དང་ཁང་པ་རྣམས་སུ་བསྡད་པའི་རྗེས་སུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་དེར། རང་ཉིད་ཀྱི་ཆེད་དུ་གྲོང་ཁྱེར་གསུམ་ལོགས་སུ་འདོན་དགོས།"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཆེད་དུ་བགྲོད་ལམ་གྲ་སྒྲིག་བྱེད་དགོས་པ་དང་། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་དེ་ཁག་གསུམ་དུ་བགོས་ནས། མི་གསོད་ནོར་བྱས་པ་རྣམས་ཡུལ་དེ་དག་ལ་བྲོས་ཆོག་པར་བྱེད་དགོས་སོ། །"]},{"type":"verse","number":4,"content":["མི་གསོད་ནོར་བྱས་པ་རྣམས་གྲོང་ཁྱེར་དེ་དག་ལ་བྲོས་ནས་བསྡད་ཆོག་པ་དང་སྒྲིག་ལམ་ནི་འདི་ལྟར། མ་བསམ་ས་ནས་མི་བསད་པ་དང་ཕན་ཚུན་བར་དུ་ཞེ་འཁོན་ཡང་མེད་པ་སྟེ།"]},{"type":"verse","number":5,"content":["དཔེར་ན་མི་ཞིག་ཁྱིམ་མཚེས་དང་མཉམ་དུ་ནགས་ལ་ཤིང་གཅོད་དུ་སོང་བ་དང་། ལག་གི་སྟ་རེ་གཡུགས་ནས་ཤིང་གཅོད་སྐབས། སྟ་རེ་ཡུ་བ་ལས་ཤོར་ནས་ཁྱིམ་མཚེས་དེར་ཕོག་ནས་ཤི་ན། མི་དེ་གྲོང་ཁྱེར་དེ་རྣམས་ཀྱི་གཅིག་ལ་བྲོས་ཆོག་ལ། དེ་ནས་རང་སྲོག་ཐར་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":6,"content":["དེ་ལྟར་མིན་ཚེ། ཁོ་དང་མི་དེའི་བར་ལ་སྔར་འཁོན་སེམས་མེད་པས་སྲོག་ཁྲིམས་གཅོད་དགོས་པའི་ཉེས་པ་མེད་ཀྱང་། ཁྲག་ལན་འཇལ་མཁན་གྱིས་ཞེ་སྡང་མ་ཞི་བར་དུ་ལག་དམར་གྱི་རྗེས་འདེད་ཅིང་། ལམ་ཐག་རིང་བའི་རྐྱེན་གྱིས་ཁོའི་རྗེས་ཆོད་ནས་སྲོག་གཅོད་སྲིད་པ་ཡིན།"]},{"type":"verse","number":7,"content":["དེ་བས་ན་ངས་ཁྱོད་རྣམས་ལ་གྲོང་ཁྱེར་གསུམ་རང་གི་ཆེད་དུ་ལོགས་སུ་འདོན་དགོས་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":8,"content":["གལ་སྲིད་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་ལ་བཞེས་པའི་མནའ་བཞིན་དུ། ཁྱོད་ཅག་གི་ས་མཚམས་རྒྱ་བསྐྱེད་ནས་ཕ་མེས་ལ་ཞལ་གྱིས་བཞེས་པའི་ཡུལ་དེ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་གནང་བ་དང་།"]},{"type":"verse","number":9,"content":["ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསྒོས་པའི་བཀའ་ཐམས་ཅད་བསྲུངས་ནས་བསྒྲུབས་ཏེ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་གཅེས་སུ་འཛིན་པ་དང་། རྟག་ཏུ་ཁོང་གི་ཕེབས་ལམ་དུ་སྐྱོད་པ་ཡིན་ན། ཁྱོད་རྣམས་ཀྱིས་གྲོང་ཁྱེར་གསུམ་པོ་དེའི་ཁར་གྲོང་ཁྱེར་གཞན་གསུམ་ཡང་བསྣོན་དགོས།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་ནས་ཉེས་མེད་ཀྱི་ཁྲག་མི་བཞུར། དེ་ལྟར་མིན་ཚེ་ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་ན་ནག་ཉེས་ཁྱོད་ཅག་གི་སྟེང་ལ་འབབ་པ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་མི་ཞིག་རང་གི་ཁྱིམ་མཚེས་ལ་སྡང་བ་དང་དེ་ལ་བསྒུགས་བསྡད་དེ། གློ་བུར་ཉིད་ལ་ཁོའི་སྟེང་ལ་ཤོར་ནས་ཁོ་བསད་པ་དང་། དེ་ནས་གྲོང་ཁྱེར་དེ་དག་ལས་གཅིག་ལ་བྲོས་ན།"]},{"type":"verse","number":12,"content":["ཁོ་ཐོན་སའི་གྲོང་ཁྱེར་གྱི་རྒན་པོ་རྣམས་ཀྱིས་མི་མངགས་ནས་ཁོ་ས་ཆ་དེ་ནས་ཁྲིད་ཡོང་སྟེ། ཁོ་ཁྲག་ལན་འཇལ་མཁན་གྱི་ལག་ཏུ་སྤྲད་ནས་འཆི་ལམ་དུ་བསྐྱལ་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་བདེ་བར་གནས་པའི་ཆེད་དུ། ཁྱོད་རྣམས་ཀྱི་མིག་ལམ་དུ་ཁོ་ལ་སྙིང་རྗེ་བསྐྱེད་མི་རུང་བར། ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་བའི་སྡིག་པ་ནི་ཡེས་ར་ཨེལ་ནས་རྩ་མེད་གཏོང་དགོས་སོ། །"]},{"type":"heading","content":["ས་མཚམས།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་དུ་རང་གི་ཁྱིམ་མཚེས་ཀྱི་ས་རྟགས་བསྣུར་མི་རུང་སྟེ། དེ་ནི་ཕ་མེས་རྣམས་ཀྱིས་བགོས་པའི་ས་མཚམས་ཡིན་ནོ། །"]},{"type":"heading","content":["བདེན་དཔང་བྱེད་པའི་སྒྲིག་ཁྲིམས།"]},{"type":"verse","number":15,"content":["མི་ཞིག་གིས་ཉེས་སྐྱོན་གང་ཞིག་བཟོས་པའམ། ཡང་ན་སྡིག་ཉེས་ཅི་ཞིག་བསགས་པ་ཡིན་ན། དེ་ལ་ནག་ཉེས་སམ་སྡིག་པ་བགྲང་བའི་ཚེ། མི་གཉིས་གསུམ་ཞིག་གི་ངག་ལས་བདེན་དཔང་བྱེད་པར་བརྟེན༌ནས་དོན་དག་གཏན་ལ་འབབ་དགོས་པ་ཡིན།"]},{"type":"verse","number":16,"content":["གལ་སྲིད་དཔང་པོ་ཞེ་གནག་ཅིག་ལངས་ནས་མི་ཞིག་གིས་དོན་ངན་བསྒྲུབས་པར་ཞུ་གཏུག་བྱས་ན།"]},{"type":"verse","number":17,"content":["ཕན་ཚུན་རྩོད་གླེང་བྱེད་མཁན་མི་དེ་གཉིས་ཀ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔ་དང་། སྐབས་དེའི་མཆོད་དཔོན་དང་ཁྲིམས་དཔོན་གྱི་དྲུང་དུ་ལང་དགོས།"]},{"type":"verse","number":18,"content":["ཁྲིམས་དཔོན་རྣམས་ཀྱིས་འདྲི་རྟོག་ནན་མོ་བྱེད་དགོས་ལ། ལྟོས་དང་། གལ་སྲིད་བདེན་དཔང་བྱེད་མཁན་ནི་དཔང་པོ་རྫུན་མ་ཞིག་ཡིན་པ་དང་། བདེན་དཔང་རྫུན་མས་རང་གི་སྤུན་ཟླ་ལ་ནག་མེད་ཉེས་འགེལ་བྱེད་པ་ཤེས་ན།"]},{"type":"verse","number":19,"content":["མི་དེས་རང་གི་སྤུན་ཟླ་ལ་ཅི་བྱ་བསམ་པ་ནང་བཞིན། ཁྱོད་ཅག་གིས་ཁོ་ལའང་དེ་བཞིན་དུ་བྱེད་དགོས་ལ། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":20,"content":["གཞན་རྣམས་ཀྱིས་ཀྱང་དོན་དེ་ཐོས་པ་དང་འཇིགས་ནས་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་དོན་ངན་དེ་ལྟ་བུ་བྱེད་མི་ཕོད་དོ། །"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱི་མིག་ལམ་དུ་སྙིང་རྗེ་མི་བསྐྱེད་པར་སྲོག་ལ་སྲོག་ལན་དང་། མིག་ལ་མིག་ལན། སོ་ལ་སོ་ལན། ལག་པ་ལ་ལག་པའི་ལན། རྐང་པ་ལ་རྐང་པའི་ལན་འཇལ་དགོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/18.json","previousChapterAudioLinks":{},"numberOfVerses":21}