{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":20,"content":[{"type":"heading","content":["དམག་འཁྲུག་གི་སྒྲིག་ཁྲིམས།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ཕྱི་རུ་སོང་ནས་ཁྱོད་ཅག་གི་དགྲ་བོ་རྣམས་ལ་དམག་རྒྱག་པའི་ཚེ། རྟ་དང་ཤིང་རྟ་དང་། དམག་མི་རྣམས་ཁྱོད་ཅག་ལས་མང་བ་མཐོང་ན་དེ་དག་ལ་འཇིགས་མི་དགོས། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཡར་ཁྲིད་འོང་མཁན་གྱི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་རྣམས་དང་མཉམ་དུ་བཞུགས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་གཡུལ་སར་འགྲོ་རན་པའི་ཚེ། མཆོད་དཔོན་ཚུར་འོངས་ནས་མི་ཚོགས་ལ་གཏམ་སྨྲ་དགོས་ཏེ།"]},{"type":"verse","number":3,"content":["ཁོ་རྣམས་ལ་འདི་ལྟར། ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས་ཁྱོད་ཅག་གིས་ཉོན་དང་། དེ་རིང་ཁྱོད་ཅག་གིས་དགྲ་རྣམས་ལ་དམག་རྒྱག་པར་འགྱུར་ཏེ། ཁྱོད་རྣམས་སེམས་ནས་མ་འཁུམས་མ་འཇིགས་མ་འཚབ་ཅིག དེ་དག་གི་མདུན་ནས་འདར་ཡང་མི་དགོས།"]},{"type":"verse","number":4,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་ཅག་དང་མཉམ་དུ་ཕེབས་ནས། ཁྱོད་རྣམས་ཀྱི་དོན་དུ་དགྲ་དང་འཐབ་སྟེ་རྒྱལ་ཁ་གནང་ངེས་ཡིན་ཞེས་སྨྲ་ཞིང་།"]},{"type":"verse","number":5,"content":["འགོ་དཔོན་རྣམས་ཀྱིས་མི་ཚོགས་ལ་གཏམ་འདི་ལྟར་སྨྲ་སྟེ། སུ་ཞིག་གིས་ཁང་པ་གསར་པ་བརྩིགས་ནས་ད་དུང་བསྔོས་མེད་པ་ཡིན་ན། མི་དེ་དམག་འཁྲུག་གི་སྐབས་སུ་ཤི་ནས་མི་གཞན་ཞིག་གིས་ཁོའི་ཁང་པ་བསྔོ་བར་མི་བྱ་བའི་ཆེད་དུ་མི་དེ་ཕྱིར་ཁྱིམ་དུ་ལོག་དགོས།"]},{"type":"verse","number":6,"content":["ཡང་སུ་ཞིག་གིས་རྒུན་ཚལ་བཙུགས་ནས་ད་དུང་དེའི་ཤིང་ཏོག་མ་སྤྱད་པ་ཡིན་ན། མི་དེ་དམག་འཁྲུག་གི་སྐབས་སུ་ཤི་ནས་མི་གཞན་ཞིག་གིས་དེའི་ཤིང་ཏོག་སྤྱོད་པར་མི་བྱ་བའི་ཆེད་དུ་མི་དེ་ཕྱིར་ཁྱིམ་དུ་ལོག་དགོས།"]},{"type":"verse","number":7,"content":["ཡང་སུ་ཞིག་གིས་བུད་མེད་ཅིག་ལ་གཉེན་རྟགས་བརྒྱབ་ཀྱང་ད་དུང་གཉེན་སྒྲིག་བྱས་མེད་པ་ཡིན་ན། མི་དེ་དམག་འཁྲུག་གི་སྐབས་སུ་ཤི་ནས་མི་གཞན་ཞིག་གིས་ཁོ་མོ་ཆུང་མར་མི་ལེན་པའི་ཆེད་དུ་མི་དེ་ཕྱིར་ཁྱིམ་དུ་ལོག་དགོས་ཞེས་པའོ། །"]},{"type":"verse","number":8,"content":["ཡང་འགོ་དཔོན་རྣམས་ཀྱིས་མི་ཚོགས་ལ་འདི་ལྟར་སྨྲ་སྟེ། སུ་ཞིག་འཇིགས་ནས་དཔའ་ཞུམ་པ་ཡིན་ན། མི་དེས་རང་ཉིད་དཔའ་ཞུམ་པ་ལྟར་སྤུན་ཟླའི་དཔའ་ཞུམ་པར་མི་བྱ་བའི་ཆེད་དུ་ཕྱིར་ཁྱིམ་དུ་ལོག་དགོས་ཞེས་པའོ། །"]},{"type":"verse","number":9,"content":["འགོ་དཔོན་རྣམས་ཀྱིས་མི་ཚོགས་ལ་གཏམ་སྨྲས་ཚར་རྗེས། མི་ཚོགས་ཀྱི་སྣེ་ཁྲིད་མཁན་དམག་དཔོན་རྣམས་བསྐོ་བར་བྱའོ། །"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་གྲོང་ཁྱེར་ཞིག་གི་ཉེ་སར་སླེབས་ནས་དེ་ལ་དམག་རྒྱག་པར་རྩོམ་པའི་དུས་སུ། ཐོག་མར་དེ་དང་ཞི་མཐུན་ཡོང་ཐབས་བཙལ་དགོས།"]},{"type":"verse","number":11,"content":["གལ་སྲིད་གྲོང་ཁྱེར་དེས་ཁྱོད་རྣམས་ལ་ཞི་བའི་གྲོས་མཐུན་གྱི་སྒོ་མོ་ཕྱེ་བ་ཡིན་ན། གྲོང་ཁྱེར་དེའི་མི་ཐམས་ཅད་ཀྱིས་ཁྱོད་རྣམས་ལ་གཡོག་བྱས་ནས་ཞབས་ཕྱི་བསྒྲུབ་དགོས།"]},{"type":"verse","number":12,"content":["གལ་སྲིད་གྲོང་ཁྱེར་དེས་ཁྱོད་རྣམས་ལ་ཞི་མཐུན་མི་བྱེད་པར་རྒོལ་བར་བྱས་ན། དེའི་མཐའ་ནས་སྐོར་ཅིག"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གྲོང་ཁྱེར་དེ་ཁྱོད་ཅག་གི་ལག་ཏུ་གཏོད་པའི་ཚེ། དེའི་སྐྱེས་པ་ཐམས་ཅད་ལ་ཁྱོད་རྣམས་ཀྱིས་གྲི་ཁས་བསྣུན་དགོས།"]},{"type":"verse","number":14,"content":["བུད་མེད་དང་བྱིས་པ་རྣམས་དང་། ཕྱུགས་ཟོག་བཅས་གྲོང་ཁྱེར་གྱི་བཅོམ་ནོར་ཐམས་ཅད་ནི་ཁྱོད་ཅག་གིས་བླངས་ཆོག ཁྱོད་རྣམས་ཀྱི་དགྲ་ཡི་བཅོམ་ནོར་ཐམས་ཅད་ནི་ཁྱོད་ཅག་གིས་ལོངས་སུ་སྤྱད་ཆོག་སྟེ། ཅི་ལ་ཞེ་ན། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["དེ་ལྟར་འདིར་ཡོད་པའི་མི་རིགས་རྣམས་ལ་མི་གཏོགས་པའི་གྲོང་ཁྱེར་རྣམས་ཏེ་ཁྱོད་རྣམས་དང་རྒྱང་ཐག་རིང་བའི་གྲོང་ཁྱེར་རྣམས་ལའང་དེ་བཞིན་བྱེད་དགོས།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་མི་རིགས་འདི་རྣམས་ཀྱི་གྲོང་ཁྱེར་དུ། ཁྱོད་རྣམས་ཀྱིས་དབུགས་ཐོགས་གང་ཡང་གསོན་པོར་བསྐྱུར་མི་རུང་།"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བཀའ་བསྒོས་པ་ཇི་བཞིན་ཧེད་པ་དང་། ཨེ་མོར་པ་དང་། ཀ་ན་ཨན་པ་དང་། ཕེ་རེ་ཟི་པ་དང་། ཧེ་བི་པ་དང་། ཡེ་བུ་སི་པ་རྣམས་ཚར་དུ་གཅོད་དགོས།"]},{"type":"verse","number":18,"content":["ཅི་ལ་ཞེ་ན། དེ་དག་གིས་རང་གི་ལྷ་རྣམས་ལ་བྱས་པའི་བྱ་སྤྱོད་སྐྱུག་བྲོ་བ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་བསླབས་ནས། ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་མི་བྱ་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱིས་གྲོང་ཁྱེར་ཅིག་གི་མཐའ་བསྐོར་ཏེ་ཡུན་རིང་པོ་འགོར་ནས་དེ་ལེན་པའི་ཕྱིར་འཐབ་འཁྲུག་བརྒྱབ་ན། དེ་རུ་ཡོད་པའི་ཤིང་སྡོང་རྣམས་སྟ་རེས་གཅོད་མི་རུང་། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱིས་དེ་དག་ལས་ཁ་ཟས་བླངས་ཆོག་པས་དེ་དག་གཅོད་གཏུབ་བྱེད་མི་འོས། ཞིང་ཁའི་ཤིང་སྡོང་ནི་མི་ཡིན་ནམ། ཁྱོད་རྣམས་ཀྱིས་མི་བསྐོར་བ་ནང་བཞིན་དེའི་མཐའ་ནས་བསྐོར་དགོས་སམ།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་ཀྱིས་ཟས་རིགས་མི་ཐོགས་པ་ཤེས་པའི་ཤིང་སྡོང་འབའ་ཞིག་བརླགས་ནས་བཅད་དེ། ཁྱོད་ཅག་ལ་འཐབ་འཛིང་བྱེད་པའི་གྲོང་ཁྱེར་དེ་མ་ནུབ་བར་དུ་ལྕང་མའི་མཁར་བརྩིག་དགོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/19.json","previousChapterAudioLinks":{},"numberOfVerses":20}