{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":22,"content":[{"type":"heading","content":["ཁྲིམས་སྣ་ཚོགས།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་སྤུན་ཟླའི་བ་གླང་ངམ་ར་ལུག་རྣམས་བདག་མེད་དུ་འཁྱམས་པར་མཐོང་ན་དེ་སྣང་མེད་དུ་མི་བསྐྱུར་བར། ངེས་པར་དུ་སྤུན་ཟླའི་རྩར་ཕྱིར་འདེད་དགོས།"]},{"type":"verse","number":2,"content":["གལ་སྲིད་སྤུན་ཟླ་དེ་ཁྱོད་རྣམས་དང་རྒྱང་ཐག་རིང་ཞིང་ཁྱོད་རྣམས་ཀྱིས་དེ་ངོ་མི་ཤེས་ན། ཁྱོད་རྣམས་ཀྱིས་ཕྱུགས་དེ་རང་གི་ཁྱིམ་དུ་དེད་ཡོང་ནས་བདག་བྱེད་དགོས་ལ། སྤུན་ཟླས་དེ་བཙལ་ནས་འོང་དུས་དེ་ཁོ་ལ་ཕྱིར་སྤྲོད་དགོས།"]},{"type":"verse","number":3,"content":["སྤུན་ཟླའི་བོང་བུ་ལ་ཁྱོད་རྣམས་ཀྱིས་དེ་བཞིན་བྱེད་དགོས་ཤིང་། ཁྱོད་རྣམས་ཀྱི་སྤུན་ཟླས་བོར་ནས་ཁྱོད་ཅག་གིས་རྙེད་པའི་གྱོན་གོས་སོགས་ཅ་ལག་གང་དང་གང་ཡིན་ཡང་དེ་ལྟར་བྱེད་དགོས་ཀྱི་སྣང་མེད་དུ་བསྐྱུར་མི་རུང་།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་ཀྱིས་སྤུན་ཟླའི་བོང་བུ་དང་བ་གླང་རྣམས་ལམ་དུ་འགྱེལ་ཡོད་པ་མཐོང་ན། དེ་སྣང་མེད་དུ་མི་བསྐྱུར་བར་ཁོ་ལ་དེ་དག་ཡར་བསླང་རོགས་བྱེད་དགོས་སོ། །"]},{"type":"verse","number":5,"content":["བུད་མེད་ཀྱིས་སྐྱེས་པའི་གོས་མི་གྱོན་པ་དང་། སྐྱེས་པས་ཀྱང་བུད་མེད་ཀྱི་གོས་གྱོན་མི་རུང་། ཅི་ལ་ཞེ་ན། སུས་དེ་ལྟར་བྱེད་པ་ཡིན་ན་དེ་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཞེ་ལོག་པའི་བྱ་སྤྱོད་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱིས་ལམ་ཁར་སྡོང་མགོ་དང་ཡང་ན་ས་རུ་ཡོད་པའི་བྱ་ཚང་རྙེད་ནས། དེའི་ནང་དུ་བྱ་ཕྲུག་དང་བྱ་སྒོང་ཡོད་པ་དང་། བྱ་མས་བྱ་ཕྲུག་རུམ་པའམ་སྒོ་ང་རུམ་ཡོད་ན། ཁྱོད་རྣམས་ཀྱིས་བྱ་མ་དེ་བྱ་ཕྲུག་དང་མཉམ་དུ་འཁྱེར་མི་རུང་།"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱིས་བྱ་ཕྲུག་རང་གི་ཆེད་དུ་འཁྱེར་ཆོག འོན་ཀྱང་བྱ་མ་ངེས་པར་གཏོང་དགོས། དེ་ནས་ཁྱོད་རྣམས་བདེ་བར་གནས་ཤིང་ཚེ་ཐག་རིང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁང་པ་གསར་པ་བཟོ་བའི་ཚེ་ཁང་ཐོག་ལ་སྒྲོམ་སྐྱོར་འཇོག་དགོས་ཏེ། མི་ཞིག་ཁྱོད་རྣམས་ཀྱི་ཁང་ཐོག་ནས་མར་ལྷུང་ནས་ཁྱོད་ཅག་གི་ཁང་པ་ལ་ཁྲག་གི་ཉེས་པ་འཁོར་མི་འོང་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱི་རྒུན་ཚལ་ལ་ས་བོན་རིགས་མི་འདྲ་བ་གཉིས་འདེབས་མི་རུང་། གལ་ཏེ་བཏབ་ན་ཁྱོད་རྣམས་ཀྱི་ལོ་ཏོག་གི་ཡོང་འབབ་དང་། རྒུན་ཚལ་གྱི་འབྲས་བུ་ཀུན་ལད་འགྲོ་བ་ཡིན།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་བ་གླང་དང་བོང་བུ་གཉིས་དོར་བྱས་ནས་ཞིང་རྨོ་མི་རུང་ལ།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཀྱིས་བལ་དང་སོ་རས་གཉིས་བསྲེས་ནས་བཟོས་པའི་གོས་ཀྱང་གྱོན་མི་རུང་།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཕྱི་གོས་ཀྱི་མཐའ་བཞི་པོར་ཙོར་ལོ་འདོགས་དགོས་སོ། །"]},{"type":"heading","content":["འདོད་པ་སྤྱོད་པའི་སྒྲིག་ཁྲིམས།"]},{"type":"verse","number":13,"content":["གལ་སྲིད་མི་ཞིག་གིས་ཆུང་མ་བླངས་ནས་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་པའི་རྗེས་སུ་ཁོ་མོར་སྡང་བར་གྱུར་ཏེ།"]},{"type":"verse","number":14,"content":["ངོ་ཚ་ཁྲེལ་མེད་ཀྱི་དོན་རྫུན་བཟོ་བྱས་ནས་ཁོ་མོར་འཕྱས་ཏེ་ཁོ་མོའི་མིང་བརྫད་པ་དང་། ངས་བུད་མེད་འདི་ཆུང་མར་བླངས་ནས་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱེད་དུས་སུ་མོ་རང་མོ་གསར་ཡིན་པའི་བདེན་རྟགས་རྙེད་མ་བྱུང་ཞེས་སྨྲས་ན།"]},{"type":"verse","number":15,"content":["གཞོན་ནུ་མ་དེའི་ཕ་མ་གཉིས་ཀྱིས་མོ་རང་མོ་གསར་ཡིན་པའི་བདེན་རྟགས་ཁྱེར་ནས་མཁར་སྒོ་རུ་གྲོང་ཁྱེར་གྱི་རྒན་པོ་རྣམས་ཀྱི་མདུན་དུ་འོངས་ཏེ།"]},{"type":"verse","number":16,"content":["གཞོན་ནུ་མའི་ཕ་ཡིས་རྒན་པོ་རྣམས་ལ། ངས་རང་གི་བུ་མོ་མི་འདི་ལ་བག་མར་བཏང་བ་དང་ཁོ་ནི་ཁོ་མོར་སྡང་བར་གྱུར་ཏེ།"]},{"type":"verse","number":17,"content":["ངོ་ཚ་ཁྲེལ་མེད་ཀྱི་དོན་རྫུན་བཟོ་བྱས་ནས་ཁོ་མོར་འཕྱས་ཤིང་། ངས་ཁྱོད་ཀྱི་བུ་མོ་ལས་མོ་རང་མོ་གསར་ཡིན་པའི་བདེན་རྟགས་རྙེད་མ་བྱུང་ཞེས་སྨྲས་པའོ། །དོན་དམ་དུ་ངའི་བུ་མོ་མོ་གསར་ཡིན་པའི་བདེན་རྟགས་འདི་རུ་ཡོད་ཅེས་སྨྲས་ཏེ། གྲོང་ཁྱེར་གྱི་རྒན་པོ་རྣམས་ཀྱི་མདུན་དུ་གྱོན་གོས་སར་འདིང་དགོས།"]},{"type":"verse","number":18,"content":["དེ་ནས་གྲོང་ཁྱེར་གྱི་རྒན་པོ་རྣམས་ཀྱིས་མི་དེ་བཟུང་འོངས་ནས་ཆད་པ་གཅོད་དགོས་པ་དང་།"]},{"type":"verse","number":19,"content":["དངུལ་སྲང་བརྒྱ་ཡི་ཆད་པ་བཀལ་ནས་གཞོན་ནུ་མའི་ཕ་ལ་སྦྱིན་དགོས། ཅི་ལ་ཞེ་ན། མི་དེས་ཡེས་ར་ཨེལ་གྱི་མོ་གསར་ཞིག་གི་མིང་བརྫད་པས་ཡིན། ཡང་གཞོན་ནུ་མ་དེ་ཁོའི་ཆུང་མ་བྱས་ནས་ཚེ་གང་པོར་འཐོར་མི་ཆོག་གོ །"]},{"type":"verse","number":20,"content":["འོན་ཀྱང་གཏམ་དེ་བདེན་ཞིང་གཞོན་ནུ་མ་དེར་མོ་གསར་ཡིན་པའི་བདེན་རྟགས་མེད་ན།"]},{"type":"verse","number":21,"content":["གཞོན་ནུ་མ་དེ་ཁོ་མོའི་ཕ་གཞིས་ཀྱི་སྒོ་ཁར་འཁྲིད་པ་དང་། གྲོང་ཁྱེར་གྱི་མི་རྣམས་ཀྱིས་ཁོ་མོ་རྡོ་རུབ་བཏང་ནས་གསོད་དགོས། ཅི་ལ་ཞེ་ན། ཁོ་མོས་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་ནས་སྐྱུག་བྲོ་བའི་དོན་བྱས་ཤིང་རང་གི་ཕ་གཞིས་སུ་ལོག་གཡེམ་བྱས་པ་རེད། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":22,"content":["གལ་སྲིད་མི་ཞིག་མི་གཞན་པའི་ཆུང་མ་དང་ལུས་འབྲེལ་བྱས་པ་ཤེས་ན། འཆལ་པོ་འཆལ་མོ་དེ་གཉིས་ཀ་གསོད་དགོས་ལ། ཡེས་ར་ཨེལ་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":23,"content":["གལ་སྲིད་གཞོན་ནུ་མ་མོ་གསར་ཡིན་པ་ཞིག་གཞན་ལ་གཉེན་རྟགས་བརྒྱབ་ཡོད་ཀྱང་། སྐྱེས་པ་ཞིག་གྲོང་ཁྱེར་ནས་ཁོ་མོར་ཕྲད་དེ་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་ན།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཅག་གིས་དེ་གཉིས་ཀ་ཡུལ་དེ་གའི་མཁར་སྒོ་རུ་ཁྲིད་ནས་རྡོ་རུབ་བཏང་སྟེ་གསོད་དགོས། གཞོན་ནུ་མ་དེ་གྲོང་ཁྱེར་དུ་ཡོད་ཀྱང་སྐྱོབ་རོགས་ཞུ་བའི་སྐད་མ་བརྒྱབ་པ་དང་། སྐྱེས་པ་དེས་རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་བརྫད་པའི་རྐྱེན་གྱིས་ཁོ་གཉིས་འཆི་དགོས་སོ། །ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":25,"content":["འོན་ཀྱང་མི་ཞིག་ཞིང་ཁ་ནས་གཞན་དང་གཉེན་རྟགས་བརྒྱབ་ཡོད་པའི་གཞོན་ནུ་མ་ཞིག་དང་ཕྲད་དེ། ཁོ་མོ་བཙན་གྱིས་བཟུང་ནས་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་ན། ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་པའི་མི་དེ་གཅིག་པུ་གསོད་དགོས་པ་ཡིན།"]},{"type":"verse","number":26,"content":["བུ་མོ་དེས་སྲོག་ཁྲིམས་གཅོད་དགོས་པའི་སྡིག་པ་བྱས་མེད་པས་ཁོ་མོར་ཅི་ཡང་བྱེད་མི་རུང་། དོན་རྐྱེན་འདི་ནི་མི་ཞིག་གིས་གློ་བུར་ཉིད་ལ་ལངས་ནས་ཁྱིམ་མཚེས་ལ་རྒོལ་ཞིང་དེའི་སྲོག་བཅད་པ་དང་འདྲའོ། །"]},{"type":"verse","number":27,"content":["ཅི་ལ་ཞེ་ན། མི་དེ་ཞིང་ཁ་ནས་གཞོན་ནུ་མ་དེ་དང་ཕྲད་ཅིང་། གཞན་ལ་གཉེན་རྟགས་བརྒྱབ་ཟིན་པའི་གཞོན་ནུ་མ་དེས་སྐད་བརྒྱབ་ཀྱང་སྐྱོབ་མཁན་མ་བྱུང་བས་ཡིན་ནོ། །"]},{"type":"verse","number":28,"content":["གལ་སྲིད་མི་ཞིག་གཞོན་ནུ་མ་མོ་གསར་ཡིན་པ་དང་ད་དུང་གཞན་ལ་གཉེན་རྟགས་བརྒྱབ་མེད་པ་ཞིག་དང་ཕྲད་དེ། བཙན་གྱིས་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་པ་གཞན་གྱིས་རྟོགས་ན།"]},{"type":"verse","number":29,"content":["དེ་ནས་ཁོ་མོ་དང་ལུས་འབྲེལ་བྱེད་མཁན་གྱིས་གཞོན་ནུ་མའི་ཕ་ལ་དངུལ་སྲང་ལྔ་བཅུ་འཇལ་དགོས། ཁོས་གཞོན་ནུ་མ་དེ་བརྫད་པའི་རྐྱེན་གྱིས་ཁོ་མོ་རང་གི་ཆུང་མར་ལེན་དགོས་ལ་ཚེ་གང་པོར་འཐོར་མི་ཆོག་གོ །"]},{"type":"verse","number":30,"content":["མི་ཞིག་གིས་རང་གི་ཕ་ཡི་ཆུང་མ་བསྟེན་མི་རུང་ལ། ཕ་ཡི་སྨད་གོས་ཀྱང་བཤུ་མི་རུང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}