{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":24,"content":[{"type":"heading","content":["བཟའ་འཐོར་གྱི་སྒྲིག་ཁྲིམས།"]},{"type":"verse","number":1,"content":["མི་ཞིག་གིས་ཆུང་མ་བླངས་ཏེ་གཉེན་བསྒྲིགས་པའི་རྗེས་སུ། ཁོ་མོའི་སྐྱོན་ཞིག་མཐོང་ནས་ཁོ་མོར་མི་དགའ་བར་གྱུར་ན། བཟའ་འཐོར་ཡི་གེ་བྲིས་ནས་ཁོ་མོའི་ལག་ཏུ་བཞག་སྟེ་རང་གི་ཁྱིམ་ནས་འགྲོ་རུ་བཅུག་ཆོག་པ་དང་།"]},{"type":"verse","number":2,"content":["ཁོ་མོ་རང་གི་ཁྱོ་གའི་ཁྱིམ་དང་བྲལ་རྗེས་མི་གཞན་ཞིག་གི་ཆུང་མ་བྱས་ཆོག་ལ།"]},{"type":"verse","number":3,"content":["གལ་སྲིད་ཁྱོ་ག་ཕྱི་མ་ཡང་ཁོ་མོར་སྡང་ནས་ཁོ་མོར་འཐོར་ཡིག་བྲིས་པ་དང་། ཁོ་མོའི་ལག་ཏུ་བཞག་ནས་རང་གི་ཁྱིམ་ནས་འགྲོ་རུ་འཇུག་པའམ། ཡང་ན་ཁོ་མོ་ཆུང་མར་བླངས་པའི་ཁྱོ་ག་ཕྱི་མ་དེ་ཚེ་ལས་འདས་པ་ཡིན་ན།"]},{"type":"verse","number":4,"content":["ཁོ་མོ་འགྲོ་རུ་བཅུག་པའི་ཁྱོ་ག་སྔ་མ་དེས་ཁོ་མོ་བཙོག་པར་བཟོས་རྗེས་ཁོ་མོ་ཡང་བསྐྱར་ཆུང་མར་ལེན་མི་རུང་། ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དེ་ནི་སྐྱུག་བྲོ་བ་ཡིན་ལ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་ནི་སྡིག་པས་བརྫད་མི་རུང་ངོ་། །"]},{"type":"heading","content":["སྒྲིག་ཁྲིམས་གཞན་རྣམས།"]},{"type":"verse","number":5,"content":["མི་ཞིག་གིས་ཆུང་མ་བླངས་མ་ཐག་ཡིན་ན། དམག་ལ་ཞུགས་པའམ་ཡང་ན་དེར་བྱ་བ་གཞན་གང་ཡང་འགེལ་མི་རུང་བར། རང་ཁྱིམ་ནས་ཆུང་མ་དང་མཉམ་དུ་ལོ་གཅིག་རིང་ལ་སྐྱིད་བརྒྱབ་ནས་འདུག་དགོས་སོ། །"]},{"type":"verse","number":6,"content":["རང་འཐག་གི་རྡོ་གཉིས་ཀ་དང་ཐ་ན་སྟེང་རྡོ་ཡིན་ཡང་གཏའ་མར་ལེན་མི་རུང་། ཅི་ལ་ཞེ་ན། དེ་ནི་མི་ཡི་ཚེ་སྲོག་གཏའ་མར་བླངས་པའོ། །"]},{"type":"verse","number":7,"content":["སུ་ཞིག་གིས་རང་གི་སྤུན་ཟླ་སྟེ། ཡེས་ར་ཨེལ་པ་རྣམས་ལས་གཅིག་བསླུ་ཁྲིད་བྱས་ནས་བྲན་གཡོག་ལྟར་བཀོལ་བའམ། ཡང་ན་ཁོ་བཙོངས་པ་ཡིན་ན། མི་བསླུ་ཁྲིད་བྱེད་མཁན་དེ་གསོད་དགོས། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་ནས་ངན་པ་རྣམས་དེ་ལྟར་མེད་པར་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":8,"content":["མཛེ་ནད་ལ་འཛེམས་ནས་དོགས་དགོས། ངས་ལེ་ཝི་པའི་མཆོད་དཔོན་རྣམས་ལ་བསྒོས་པ་ཇི་བཞིན། དེ་དག་གིས་ཁྱོད་ཅག་ལ་ཅི་ལྟར་བསྟན་པ་དེ་ཞིབ་ཏུ་བསྲུངས་ནས་བསྒྲུབ་དགོས།"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཐོན་ཏེ་ལམ་ཁར་ཡོད་དུས་སུ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མིར་ཡམ་ལ་ཅི་ཞིག་མཛད་པ་དེ་དྲན་པར་གྱིས།",{"noteId":2}]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཁྱིམ་མཚེས་ལ་བུ་ལོན་གཡར་ན། བུ་ལོན་གང་ཞིག་གཡར་ནའང་མི་དེ་ནས་གཏའ་མ་ལེན་ཕྱིར་ཁོའི་ཁྱིམ་དུ་འགྲོ་མི་རུང་།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཕྱི་ནས་འདུག་དགོས་ལ། བུ་ལོན་གཡོར་མཁན་གྱིས་གཏའ་མ་ཕྱི་ལ་ཁྱེར་འོངས་ནས་ཁྱོད་ལ་སྟེར་དགོས།"]},{"type":"verse","number":12,"content":["གལ་སྲིད་མི་དེ་དབུལ་པོ་ཡིན་ན། ཁྱོད་རྣམས་ཀྱིས་དེའི་གཏའ་མ་ཞག་གིས་བསྐྱུར་མི་རུང་།"]},{"type":"verse","number":13,"content":["ཉི་མ་ནུབ་པའི་དུས་སུ་དེའི་གཏའ་མ་ཅིས་ཀྱང་ཁོ་ལ་ཕྱིར་སྤྲོད་དགོས། ཁོས་རང་གི་གོས་བཀབ་ནས་ཉལ་ཆོག་པ་དང་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་ངེས། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དྲང་བདེན་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":14,"content":["དབུལ་ཞིང་ཕོངས་པའི་གླ་པ་ནི་ཁྱོད་རྣམས་ཀྱི་སྤུན་ཟླའམ། ཡང་ན་ཁྱོད་ཅག་གི་གྲོང་རྡལ་རྣམས་སུ་སྡོད་པའི་བྱེས་པ་སུ་ཡིན་ཡང་། དེ་ལ་བརྙས་བཅོས་བྱེད་མི་རུང་།"]},{"type":"verse","number":15,"content":["ཉིན་རེའི་གླ་ཆ་ཉིན་རེ་བཞིན་ཉི་མ་མ་ནུབ་གོང་ལ་སྟེར་དགོས། དེ་ལྟར་མིན་ཚེ་མི་དེ་དབུལ་པོ་ཡིན་པས་ཁོའི་སེམས་གླ་ཆར་འཁྲེང་ནས་ཁྱོད་ཅག་ལ་མ་དགའ་བར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་ཞུས་ན། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་སྡིག་པར་འགྱུར་ངེས་སོ། །"]},{"type":"verse","number":16,"content":["མི་སོ་སོ་རང་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་གསོད་པར་འོས་པ་ལས། བུ་ཡི་རྐྱེན་གྱིས་ཕ་གསོད་པའམ། ཕ་ཡི་རྐྱེན་གྱིས་བུ་གསོད་མི་རུང་།"]},{"type":"verse","number":17,"content":["བྱེས་པ་དང་དྭ་ཕྲུག་ལ་དྲང་བདེན་ལོག་སྤྱོད་བྱེད་མི་འོས། ཡུགས་མོའི་གྱོན་གོས་གཏའ་མར་ཡང་ལེན་མི་རུང་།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་བྲན་གཡོག་ཡིན་དུས། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལས་བསྐྱབས་འོངས་པ་དེ་དྲན་པའི་ཆེད་དུ། ངས་ཁྱོད་རྣམས་ལ་འདི་ལྟར་བསྒྲུབ་དགོས་པར་གདམས་པའོ། །"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱིས་ཞིང་ནས་འབྲུ་རིགས་བསྡུ་བའི་དུས་སུ། ཞིང་ནས་ཚར་ཕོན་ཞིག་ལུས་ན་ཁྱོད་རྣམས་ཕྱིར་དེ་ལེན་དུ་འགྲོ་མི་རུང་། དེ་ནི་བྱེས་པ་དང་དྭ་ཕྲུག ཡུགས་མོ་བཅས་ཀྱི་སྐལ་ཡིན་ལ། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལག་གི་ལས་ཀ་ཐམས་ཅད་ལ་བྱིན་རླབས་མཛད་པའི་ཕྱིར་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཡང་སྐྱུ་རུ་ཤིང་ལས་འབྲས་བུ་ཐོགས་སྐབས། ཡལ་གའི་སྟེང་དུ་ལུས་པ་རྣམས་ཡང་བསྐྱར་ཐོགས་པར་མི་བྱ་ཞིང་དེ་ནི་བྱེས་པ་དང་དྭ་ཕྲུག ཡུགས་མོ་བཅས་ལ་བསྐྱུར་དགོས།"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱི་རྒུན་ཚལ་ནས་རྒུན་འབྲུམ་བསྡུས་རྗེས་ལུས་པ་རྣམས་ཡང་བསྐྱར་བསྡུ་མི་རུང་། དེ་ནི་བྱེས་པ་དང་དྭ་ཕྲུག ཡུགས་མོ་བཅས་ལ་བསྐྱུར་དགོས།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་བྲན་གཡོག་ཡིན་པ་དེ་དྲན་པའི་ཆེད་དུ། ངས་ཁྱོད་རྣམས་ལ་འདི་ལྟར་བསྒྲུབ་དགོས་པར་གདམས་པའོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"གྲངས་ཀའི་ལེའུ་བཅུ་གཉིས་པའི་ཚིག་རྐང་བཅུ་པར་གཟིགས་རོགས།","reference":{"chapter":24,"verse":9}}]},"thisChapterLink":"/api/bod_ntb/DEU/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/23.json","previousChapterAudioLinks":{},"numberOfVerses":22}