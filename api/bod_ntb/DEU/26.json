{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":26,"content":[{"type":"heading","content":["འབྲུ་རིགས་ཀྱི་ཐོག་ཕུད་མཆོད་པ།"]},{"type":"verse","number":1,"content":["ཕྱིས་སུ་ཁྱོད་རྣམས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་དུ་སླེབས་ཏེ། དེ་བདག་གིར་བཟུང་ནས་དེར་གཞིས་ཆགས་པའི་ཚེ།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་གནང་བའི་ཡུལ་ནས། ས་ལས་སྐྱེས་པའི་ཐོག་ཕུད་འགའ་ཤས་བླངས་ནས་གཟེབ་ཀྱི་ནང་དུ་བཞག་སྟེ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཉིད་ཀྱི་མཚན་འགོད་པར་བདམས་པའི་ཡུལ་དེར་འགྲོ་དགོས་ལ།"]},{"type":"verse","number":3,"content":["སྐབས་དེའི་མཆོད་དཔོན་གྱི་དྲུང་དུ་སོང་ནས་ཁོ་ལ་འདི་ལྟར། ངས་དེ་རིང་ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ར་སྤྲོད་བྱ་སྟེ། ང་རང་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་གི་ཕ་མེས་རྣམས་ལ་གནང་བར་མནའ་དང་བཅས་ཞལ་བཞེས་གནང་བའི་ཡུལ་དེར་སླེབས་པ་ཡིན་ཞེས་སྨྲ་དགོས།"]},{"type":"verse","number":4,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་ཁྱོད་རྣམས་ཀྱི་ལག་ནས་གཟེབ་བླངས་ཏེ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁྲིའི་མདུན་དུ་འཇོག་དགོས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་འདི་ལྟར། ང་ཚོའི་ཕ་མེས་ནི་ཨ་རམ་པ་འཁྱམས་པོ་ཞིག་ཡིན། ཁོ་རང་མར་ཨེ་ཅིབ་ཡུལ་དུ་སོང་ནས་དེར་བསྡད་པ་དང་། མི་གྲངས་ཉུང་ཉུང་ཞིག་ལས་མེད་ནའང་ཡུལ་དེ་རུ་མི་རིགས་ཆེན་པོ་སྟོབས་དང་ལྡན་པ། མི་གྲངས་ཀྱང་མང་པོ་ཞིག་ཏུ་གྱུར་པ་རེད།"]},{"type":"verse","number":6,"content":["ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་ངེད་ཅག་ལ་ངན་བྱས་ཤིང་གནོད་འཚེ་བཏང་ནས་སྡུག་ལས་བཀལ་བ་དང་།"]},{"type":"verse","number":7,"content":["ངེད་ཅག་གིས་ཕ་མེས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འོ་དོད་བཏོན་པའི་ཚེ། དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་ཅག་གི་ཞུ་འབོད་གསན་ཞིང་། ངེད་ཅག་གི་གོད་ཆག་དང་དཀའ་ལས། གཉའ་གནོན་བཅས་གཟིགས་ནས།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མཐུ་ལྡན་གྱི་ཕྱག་དང་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་པ། འཇིགས་སུ་རུང་བའི་དོན་ཆེན་པོ་དང་། གྲུབ་རྟགས་དང་དོན་ངོ་མཚར་ཅན་བཅས་ཀྱི་སྒོ་ནས་ངེད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པ་དང་།"]},{"type":"verse","number":9,"content":["ངེད་ཅག་གནས་འདིར་ཁྲིད་འོངས་ནས་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་འདི་ངེད་ཅག་ལ་གནང་།"]},{"type":"verse","number":10,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ད་ནི་ཁྱེད་ཀྱིས་གཟིགས་དང་། ང་ཚོས་ཁྱེད་ཀྱིས་ངེད་ཅག་ལ་གནང་བའི་ཡུལ་འདིའི་ས་ལས་སྐྱེས་པའི་ཐོག་ཕུད་རྣམས་ཁྱེད་ལ་ཁྱེར་འོངས་པ་ཡིན་ཞེས་ཞུས་ནས། གཟེབ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བཞག་སྟེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཕྱག་འཚལ་དགོས།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་གི་ཁྱིམ་ལ་གནང་བའི་ཕན་ཆ་ཐམས་ཅད་ཀྱི་ཕྱིར་དུ། ལེ་ཝི་པ་དང་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་ཡོད་པའི་བྱེས་པ་རྣམས་དང་མཉམ་དུ་སྤྲོ་སྐྱིད་ལ་རོལ་དགོས་སོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་བཅུ་ཆ་གཅིག་འབུལ་བའི་ལོ་གསུམ་པར། འབྲས་བུ་ཀུན་གྱི་བཅུ་ཆའི་གཅིག་ཡོངས་སུ་བླངས་ནས་ལེ་ཝི་པ་དང་བྱེས་པ་དང་། དྭ་ཕྲུག་དང་ཡུགས་མོ་རྣམས་ལ་བགོས་ནས། དེ་དག་གིས་ཁྱོད་རྣམས་ཀྱི་གྲོང་རྡལ་དུ་བཟའ་བཏུང་ཚིམ་པར་སྤྱད་རྗེས།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་འདི་ལྟར། ང་ཚོས་མཆོད་རྫས་དམ་པ་དེ་རང་ཁྱིམ་ནས་སྤར་ཅིང་། ཁྱེད་ཀྱིས་ངེད་ཅག་ལ་བསྒོས་པའི་བཀའ་རྒྱ་ཐམས་ཅད་ལྟར། དེ་དག་ལེ་ཝི་པ་དང་བྱེས་པ་དང་། དྭ་ཕྲུག་དང་ཡུགས་མོ་རྣམས་ལ་བགོས་པ་ཡིན། ཁྱེད་ཀྱི་བཀའ་དང་འགལ་མེད་ལ་དེ་དག་བརྗེད་ཀྱང་མེད།"]},{"type":"verse","number":14,"content":["ང་ཚོས་མྱ་ངན་བྱེད་དུས་སུ་མཆོད་རྫས་དམ་པ་འདི་ཟོས་མེད་ལ། ངེད་རྣམས་གཙང་མ་མིན་དུས་སུ་ང་ཚོས་དེ་སྤར་བ་མིན། དེ་ལས་གང་ཡང་འདས་པོའི་དོན་དུ་སྤྲད་མེད། ང་ཚོས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་སྐད་ལ་མཉན་ནས་ཁྱེད་ཀྱིས་ངེད་རྣམས་ལ་བསྒོས་པ་ཇི་བཞིན་བསྒྲུབས་པ་ཡིན།"]},{"type":"verse","number":15,"content":["ཁྱེད་ཀྱི་བཞུགས་གནས་དམ་པ་ནམ་མཁའི་མཐོངས་ནས་གཟིགས་ཏེ། ཁྱེད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་དང་། ཁྱེད་ཀྱིས་ངེད་ཅག་གི་ཕ་མེས་ལ་མནའ་དང་བཅས་ཞལ་བཞེས་གནང་བའི་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་ལྗོངས་ལ་བྱིན་རླབས་མཛད་དུ་གསོལ་ཞེས་ཞུ་དགོས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་རིང་གི་ཉིན་མོ་འདིར་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་དེ་དག་བསྲུང་དགོས་པའི་བཀའ་གནང་ཡོད་པས། ཁྱོད་རྣམས་ཀྱིས་བློ་གཅིག་སེམས་གཅིག་གིས་དེ་དག་བསྲུངས་ནས་བསྒྲུབ་དགོས་པ་ཡིན།"]},{"type":"verse","number":17,"content":["དེ་རིང་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡིན་པ་ཁས་བླངས་པ་དང་། ཁྱོད་རྣམས་ཁོང་གི་ལམ་དུ་བསྐྱོད་ཅིང་། ཁོང་གི་སྒྲིག་ཁྲིམས་དང་བཀའ་རྒྱ། སྲོལ་ཡིག་བཅས་བསྲུངས་ཏེ། ཁོང་གི་གསུང་སྐད་ལ་མཉན་པར་བྱའོ། །"]},{"type":"verse","number":18,"content":["དེ་རིང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཞལ་བཞེས་ལྟར་ཁྱོད་ཅག་ནི་ཁོང་གི་འབངས་མི་ཡིན་པར་བསྒྲགས་ཤིང་། ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་ཐམས་ཅད་བསྲུང་དགོས་ལ།"]},{"type":"verse","number":19,"content":["ཁོང་གིས་ཁྱོད་རྣམས་ལ་ཉིད་ཀྱིས་བཀོད་པའི་མི་རིགས་ཐམས་ཅད་ལས་ལྷག་པའི་བསྟོད་བསྔགས་དང་སྙན་གྲགས། བཀུར་བསྟི་བཅས་འཐོབ་པར་བྱ་ཞིང་། ཁོང་གིས་གསུངས་པ་ནང་བཞིན། ཁྱོད་རྣམས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་དམ་པའི་འབངས་མི་ཡིན་དགོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/25.json","previousChapterAudioLinks":{},"numberOfVerses":19}