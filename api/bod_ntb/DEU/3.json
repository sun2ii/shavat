{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":3,"content":[{"type":"heading","content":["ཨོག་རྒྱལ་པོ་ཕམ་ཚུལ།"]},{"type":"verse","number":1,"content":["ཕྱིས་སུ་ང་ཚོས་ཁ་ཕྱིར་འཁོར་ཏེ་པཱ་ཤན་གྱི་ལམ་དེད་ནས་ཡར་སོང་བ་ན། པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་གིས་རང་གི་མི་ཐམས་ཅད་ཁྲིད་ནས་ཨེ་དྲེ་ཨི་ས་ཆར་བདག་ཅག་དང་འཐབ་པར་སླེབས།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། བདག་གིས་ཁོ་དང་ཁོའི་མི་རྣམས་དང་ཡུལ་ཐམས་ཅད་ཁྱོད་ཀྱི་ལག་ཏུ་གཏད་ཡོད་པས་འཇིགས་མི་དགོས། ཅི་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་ཧེ་སི་པོན་དུ་ཡོད་པའི་ཨེ་མོར་པའི་རྒྱལ་པོ་སི་ཧོན་ལ་ཅི་བྱས་པ་ནང་བཞིན་ཁོ་རྣམས་ལའང་དེ་ལྟར་བྱེད་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་རང་རེའི་དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་དང་ཁོའི་མི་ཐམས་ཅད་ང་ཚོའི་ལག་ཏུ་སྤྲད་པས། རང་ཅག་གིས་དེ་རྣམས་ལས་གཅིག་ཀྱང་མ་ལུས་པར་རྩ་མེད་བཏང་བ་ཡིན།"]},{"type":"verse","number":4,"content":["སྐབས་དེར་རང་ཅག་གིས་ཁོའི་གྲོང་ཁྱེར་ཐམས་ཅད་བླངས་ནས་གཅིག་ཀྱང་ལྷག་མེད་དེ། པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་གི་མངའ་ཁུལ་གྲོང་ཁྱེར་དྲུག་ཅུ་སྟེ། ཨར་གོབ་ཀྱི་ཡུལ་འཁོར་ཐམས་ཅད་བླངས།"]},{"type":"verse","number":5,"content":["གྲོང་ཁྱེར་དེ་ཐམས་ཅད་ནི་ལྕགས་རི་མཐོན་པོའི་བཙན་རྫོང་བརྩིགས་ཤིང་། མཁར་སྒོ་དང་སྒོ་གཏན་ཡོད་ལ། ཡང་མཐའ་འཁོར་ལ་མཁར་བརྩིགས་མེད་པའི་གྲོང་ཚོ་མང་པོ་ཡོད།"]},{"type":"verse","number":6,"content":["རང་ཅག་གིས་ཧེ་སི་པོན་གྱི་རྒྱལ་པོ་སི་ཧོན་རྩ་མེད་བཏང་བ་ནང་བཞིན་ཁོ་ཚོ་ཡང་མེད་པར་བཏང་ཞིང་། གྲོང་ཁྱེར་སོ་སོའི་སྐྱེས་པ་དང་བུད་མེད་དང་ཕྲུ་གུ་རྣམས་ཀྱང་རྩ་མེད་བཏང་བ་ཡིན།"]},{"type":"verse","number":7,"content":["འོན་ཀྱང་གྲོང་ཁྱེར་ནང་གི་སྒོ་ཕྱུགས་དང་བཅོམ་ནོར་ཐམས་ཅད་བླངས་ནས་བདག་གིར་བཟུང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["སྐབས་དེར་རང་ཅག་གིས་ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་ཀྱི་ཨེ་མོར་པའི་རྒྱལ་པོ་གཉིས་ཀྱི་ལག་ནས། ཨར་ནོན་གྲོག་རོང་ནས་རི་བོ་ཧེར་མོན་བར་གྱི་ཡུལ་རྣམས་བླངས།"]},{"type":"verse","number":9,"content":["ཚི་ཏུན་པ་རྣམས་ཀྱིས་རི་བོ་ཧེར་མོན་ལ་སིར་ཡོན་ཞེས་འབོད་ཀྱང་། ཨེ་མོར་པ་རྣམས་ཀྱིས་དེར་སེ་ནིར་ཞེས་འབོད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེ་ལྟར་ཐང་གི་གྲོང་ཁྱེར་ཐམས་ཅད་དང་གིལ་ཨད་ཀྱི་ཡུལ་ཀུན། པཱ་ཤན་གྱི་ཡུལ་ཐམས་ཅད། སལ་ཀཱ་དང་ཨེ་དྲེ་ཨིའི་བར་དུ་ཨོག་གི་རྒྱལ་ཁམས་ཐམས་ཅད་རང་ཅག་གིས་བླངས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་གཅིག་པུ་རེ་པཱ་མི་རིགས་ཀྱི་ཤུལ་དུ་ལུས། ལྟོས་དང་། ཁོའི་ཉལ་ཁྲི་ལྕགས་ཀྱི་ཉལ་ཁྲི་ཡིན་ཏེ། དེའི་རིང་ཚད་ལ་ཁྲུ་དགུ་དང་ཞེང་ལ་ཁྲུ་བཞི་ཡོད། ཉལ་ཁྲི་དེ་ཨམ་མོན་པ་རྣམས་ཀྱི་ཡུལ་རབ་བཱ་བྱ་བར་ཡོད་དོ། །"]},{"type":"verse","number":12,"content":["སྐབས་དེར་རང་ཅག་གིས་ཡུལ་དེ་བདག་གིར་བཟུང་། བདག་གིས་ཨར་ནོན་གྲོག་རོང་འགྲམ་གྱི་ཨ་རོ་ཨེར་ནས་རི་བོ་གིལ་ཨད་ཀྱི་ཕྱེད་ཀ་དང་། དེའི་གྲོང་ཁྱེར་རྣམས་རུ་བེན་པ་དང་གཱ་རྡུ་པ་རྣམས་ལ་སྤྲད་པ་ཡིན།"]},{"type":"verse","number":13,"content":["གིལ་ཨད་ཀྱི་ཡུལ་གཞན་རྣམས་དང་རྒྱལ་པོ་ཨོག་གི་མངའ་ཁོངས་ཏེ། པཱ་ཤན་ཡུལ་ཐམས་ཅད་ནི་བདག་གིས་མཱ་ན་ཤེའི་ཚོ་པ་ཕྱེད་ཀར་སྤྲད་པ་ཡིན། ཨར་གོབ་ཀྱི་ཡུལ་ཐམས་ཅད་དེ་པཱ་ཤན་གྱི་ཡུལ་ཐམས་ཅད་ལ་རེ་པཱ་པའི་ཡུལ་ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":14,"content":["མཱ་ན་ཤེ་པ་ཡཱ་ཨིར་གྱིས་ཨར་གོབ་ཀྱི་མངའ་ཁུལ་ཐམས་ཅད་དང་། གེ་ཤུར་པའི་ཡུལ་དང་མ་ཨ་ཀཱ་པའི་ས་ཐམས་ཅད་བཟུང་ཞིང་། ད་ལྟའི་བར་དུ་པཱ་ཤན་ཡུལ་ལ་ཧ་ཝོད་ཨིར་ཞེས་རང་གི་རུས་མིང་སྦྱར་ཡོད།"]},{"type":"verse","number":15,"content":["ཡང་བདག་གིས་གིལ་ཨད་ནི་མཱ་ཀིར་ལ་སྤྲད་པ་ཡིན།"]},{"type":"verse","number":16,"content":["གིལ་ཨད་ནས་ཨར་ནོན་གྲོག་རོང་བར་དུ། གྲོག་རོང་གི་དཀྱིལ་ས་མཚམས་བྱས་ནས་ཨམ་མོན་པའི་མཐའ་མཚམས་ཀྱི་ཡཱབ་པོག་གཙང་པོའི་བར་དུ་རུ་བེན་པ་དང་གཱ་རྡུ་པ་རྣམས་ལ་སྤྲད་ཅིང་།"]},{"type":"verse","number":17,"content":["ཡང་ཨ་ར་པཱ་སྟེ། ཤར་ཕྱོགས་ཀྱི་ཨ་ར་པཱ་དང་ཡོར་དན་གཙང་པོ་ས་མཚམས་བྱས་ཏེ་ཀིན་ནེ་རོད་ནས་ཨ་ར་པཱའི་ཚྭ་མཚོ་བར་དང་། ཕིས་གའི་རི་འདབས་ཀྱི་ཤར་རྒྱུད་ནི་ཁོ་རྣམས་ལ་སྤྲད་པའོ། །"]},{"type":"verse","number":18,"content":["དེའི་དུས་སུ་ངས་ཁྱོད་ཅག་ལ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་འདི་ཁྱོད་རྣམས་ཀྱིས་བདག་གིར་འཛིན་པའི་ཕྱིར་དུ་ཁྱོད་རྣམས་ལ་གནང་ཡོད་པས། ཁྱོད་ཅག་གི་དམག་མི་རྣམས་ཀྱིས་མཚོན་ཆ་སྤྲས་ནས་སོ་སོའི་སྤུན་ཟླ་སྟེ་ཡེས་ར་ཨེལ་པའི་མདུན་ནས་གཙང་པོའི་ཕ་རོལ་ཏུ་བསྐྱོད་དགོས།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་གི་ཆུང་མ་དང་བུ་ཕྲུག ཕྱུགས་ཟོག་བཅས་འབའ་ཞིག་བདག་གིས་ཁྱོད་རྣམས་ལ་གནང་བའི་གྲོང་ཁྱེར་དུ་བསྡད་ཆོག ངས་ཁྱོད་རྣམས་ལ་ཕྱུགས་ཟོག་ཧ་ཅང་མང་བ་ཤེས།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་སྤུན་ཟླ་རྣམས་ལའང་ཁྱོད་རྣམས་དང་འདྲ་བར་ངལ་གསོ་གནང་སྟེ། ཁོ་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡོར་དན་གཙང་པོའི་ནུབ་ཕྱོགས་སུ་ཁོ་ཚོར་གནང་བའི་ཡུལ་དེ་བདག་གིར་བཟུང་བའི་རྗེས་སུ། ཁྱོད་རྣམས་ད་གཟོད་བདག་གིས་ཁྱོད་ཅག་མི་རེ་རེར་སྤྲད་པའི་ཡུལ་དུ་ཕྱིར་ལོག་ཆོག་པ་ཡིན་ཞེས་བསྒོས་སོ། །"]},{"type":"verse","number":21,"content":["སྐབས་དེར་ངས་ཡོ་ཤུ་ཨ་ལ་འདི་ལྟར་བསྒོས་ཡོད་དེ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་རྒྱལ་པོ་དེ་གཉིས་ལ་ཅི་ཞིག་མཛད་པ་ཁྱོད་ཀྱིས་དངོས་སུ་མཐོང་ཡོད། ཁོང་གིས་ཁྱོད་འགྲོ་བར་འགྱུར་བའི་རྒྱལ་ཁམས་ཀུན་ལའང་དེ་བཞིན་མཛད་ངེས།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཁོ་ཚོར་མི་འཇིགས་པར་གྱིས་ཤིག ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་འཐབ་གྲོགས་མཛད་དོ་ཞེས་པའོ། །"]},{"type":"verse","number":23,"content":["སྐབས་དེར་ངས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར།"]},{"type":"verse","number":24,"content":["ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་གྲགས་པ་དང་མཐུ་སྟོབས་ལྡན་པའི་ཕྱག་ནི་ཞབས་ཕྱི་བདག་ལ་སྟོན་པར་བརྩམས་ཤིང་། ཁྱེད་ཀྱི་འཕྲིན་ལས་དང་དོན་ངོ་མཚར་ཅན་གྱི་སྟོབས་ལ་འགྲན་ནུས་པའི་ལྷ་ཞིག་གནམ་ས་གང་དུ་མཆིས་སམ།"]},{"type":"verse","number":25,"content":["ཁྱེད་ཀྱིས་ང་རང་ཡོར་དན་གཙང་པོ་བརྒལ་ནས་མཛེས་སྡུག་ལྡན་པའི་ཡུལ་ཏེ། ཡིད་དུ་འོང་བའི་རི་ཁུལ་དང་ལེ་པཱ་ནོན་ལ་བལྟ་རུ་འཇུག་པར་མཛོད་ཅེས་གསོལ་བ་བཏབ་ཀྱང་།"]},{"type":"verse","number":26,"content":["ཁྱོད་ཅག་གི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ང་ལ་ཐུགས་ཁྲོས་ནས་ངའི་ཞུ་བར་མ་གསན་ཞིང་། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ། ཁྱོད་ཀྱིས་ཚོད་ཟུངས། ད་ནི་དོན་དེ་བདག་ལ་ཡང་བསྐྱར་མི་གླེང་བར་གྱིས།"]},{"type":"verse","number":27,"content":["ཁྱོད་རང་རི་བོ་ཕིས་གའི་རྩེ་ལ་སོང་ནས་དངོས་སུ་ཤར་ལྷོ་ནུབ་བྱང་ལ་ལྟོས་ཤིག ཡིན་ནའང་ཁྱོད་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་འགྲོ་མི་རུང་ངོ་། །"]},{"type":"verse","number":28,"content":["ཡོ་ཤུ་ཨ་ཡིས་མི་འདི་རྣམས་ཀྱི་འགོ་ཁྲིད་དེ་གཙང་པོ་བརྒལ་ནས། ཁྱོད་ཀྱིས་མཐོང་བའི་ཡུལ་འདི་ཁོ་རྣམས་ལ་འཐོབ་པར་བྱེད་དགོས་པས། ཁྱོད་ཀྱིས་ཁོ་ལ་བཀའ་བསྒོས་ནས་ཁོ་རང་བརྟན་པོ་བཟོ་བ་དང་ཁོ་ལ་སྐུལ་འདེད་གཏོང་དགོས་ཞེས་བཀའ་བསྩལ་པས།"]},{"type":"verse","number":29,"content":["ངེད་ཅག་པེད་ཕེ་ཨོར་བྱ་བའི་ཕར་ཕྱོགས་ཀྱི་ལུང་པ་རུ་ལུས་པ་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/2.json","previousChapterAudioLinks":{},"numberOfVerses":29}