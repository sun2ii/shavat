{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":30,"content":[{"type":"heading","content":["འགྱོད་སེམས་ལ་དགོངས་ཡངས་གནང་བ།"]},{"type":"verse","number":1,"content":["ངས་ཁྱོད་རྣམས་ཀྱི་མདུན་དུ་བཤམས་པའི་བྱིན་རླབས་དང་དམོད་པ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་འབྱུང་བའི་དུས་སུ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་མི་རིགས་གང་གི་ཁྲོད་དུ་སྤྱུགས་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་དེ་སེམས་ལ་འཁོར་འོང་ངེས།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་དང་ཁྱོད་རྣམས་ཀྱི་བུ་རྒྱུད་རྣམས་བློ་གཅིག་སེམས་གཅིག་གིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་ཏེ། ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་གདམས་པ་ཐམས་ཅད་བཞིན་ཁོང་གི་བཀའ་གསུང་ལ་ཉན་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["དེའི་ཚེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་བཙན་འཛིན་ལས་ཕྱིར་ཁྲིད་དེ་ཁྱོད་རྣམས་ལ་སྙིང་རྗེ་དགོངས་ནས། ཁོང་གིས་ཁྱོད་རྣམས་གཏོར་སའི་མི་རིགས་ཐམས་ཅད་ཀྱི་ཁྲོད་ནས་ཡང་བསྐྱར་ཕྱིར་བསྡུ་ངེས།"]},{"type":"verse","number":4,"content":["ཁྱོད་ས་མཐར་སྤྱུགས་པ་རྣམས་གནམ་མཐའ་གང་དུ་འཐོར་ཡོད་ནའང་། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་དེ་ནས་ཀྱང་བསྡུས་ཏེ་ཕྱིར་འཁྲིད་འོང་།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ནི་རང་གི་ཕ་མེས་ལ་དབང་བའི་ཡུལ་དུ་ཕྱིར་འཁྲིད་ཅིང་ཁྱོད་རྣམས་ཀྱིས་དེ་བདག་གིར་འཛིན་པ་དང་། ཁོང་གིས་ཁྱོད་རྣམས་དྲིན་གྱིས་བསྐྱངས་ཏེ། ཁྱོད་རྣམས་ཀྱི་ཕ་མེས་ལས་ཀྱང་ཁྱོད་རྣམས་འཕེལ་ཞིང་རྒྱས་པར་མཛད།"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བློ་གཅིག་སེམས་གཅིག་གིས་གཅེས་ཤིང་ཁྱོད་རྣམས་འཚོ་བའི་ཆེད་དུ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་བུ་རྒྱུད་ཀྱི་སེམས་ནང་གི་མི་གཙང་བ་རྣམས་བསལ་ངེས་ཡིན།",{"noteId":5}]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དམོད་པ་དེ་ཐམས་ཅད་ནི་ཁྱོད་རྣམས་ཀྱི་དགྲ་རྣམས་དང་ཁྱོད་ཅག་ལ་སྡང་ནས་བཙན་སྐུལ་བྱེད་མཁན་རྣམས་ཀྱི་སྟེང་ལ་འགེལ་ཞིང་།"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་ཕྱིར་འཁོར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་མཉན་པ་དང་། ངས་དེ་རིང་ཁྱོད་ཅག་ལ་བསྒོས་པའི་ཁོང་གི་བཀའ་ཐམས་ཅད་བསྲུང་བར་འགྱུར།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་ལག་ནས་སྒྲུབ་པའི་ལས་ཀུན་དང་། ཁྱོད་རྣམས་ལས་སྐྱེས་པ་དང་། ཕྱུགས་ཀྱི་འཕེལ་ཐོག་དང་། ཞིང་གི་ཐོན་འབྲས་རྣམས་ཤིན་ཏུ་སྨིན་ཞིང་འཕེལ་བར་མཛད། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་རྣམས་ཀྱི་ཕ་མེས་ལ་ཐུགས་དགྱེས་པ་དང་འདྲ་བར། ཁོང་ཕྱིར་འཁོར་ནས་ཁྱོད་རྣམས་ལ་མཉེས་ཤིང་ཁྱོད་རྣམས་ལ་བྱིན་རླབས་འཐོབ་པར་བྱའོ། །"]},{"type":"verse","number":10,"content":["གལ་སྲིད་ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་མཉན་ཏེ། བཀའ་ཁྲིམས་འདིའི་གླེགས་བམ་ནང་བཀོད་པའི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས་རྣམས་བསྲུང་བ་དང་། བློ་གཅིག་སེམས་གཅིག་གིས་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་བ་ཡིན་ན་དེ་བཞིན་དུ་འབྱུང་ངོ་། །"]},{"type":"heading","content":["འཆི་གསོན་གཉིས་ཀྱི་གདམ་ཀ"]},{"type":"verse","number":11,"content":["ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསྒོས་པའི་བཀའ་རྒྱ་དེ་ནི་ཁྱོད་རྣམས་ལ་ཁག་པོ་ཞིག་མིན་ལ་ཁྱོད་ཅག་དང་རྒྱང་ཐག་རིང་པོའང་མིན།"]},{"type":"verse","number":12,"content":["དེ་ནི་ནམ་མཁར་མེད་པས། ཁྱོད་རྣམས་ཀྱིས་ང་ཚོས་བཀའ་དེ་ཐོས་ནས་དེ་བཞིན་བསྒྲུབ་པའི་ཆེད་དུ་སུ་ཞིག་ནམ་མཁར་སོང་ནས་ངེད་ཅག་ལ་འཁྱེར་ཡོང་ངམ་ཞེས་འདྲི་མི་དགོས།"]},{"type":"verse","number":13,"content":["དེ་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་ཡང་མེད་པས། ཁྱོད་རྣམས་ཀྱིས་ང་ཚོས་བཀའ་དེ་ཐོས་ནས་དེ་བཞིན་བསྒྲུབ་པའི་ཆེད་དུ་སུ་ཞིག་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་སོང་ནས་ངེད་ཅག་ལ་འཁྱེར་ཡོང་ངམ་ཞེས་འདྲི་མི་དགོས།"]},{"type":"verse","number":14,"content":["བཀའ་དེ་ནི་ཁྱོད་རྣམས་དང་ཤིན་ཏུ་ཉེ་སྟེ། ཁྱོད་རྣམས་ཀྱི་སྨྲ་སྒོ་དང་ཡ་ཆུང་སེམས་ཀྱི་ནང་དུ་བཞུགས་པས་ཁྱོད་རྣམས་ཀྱིས་དེ་བསྲུངས་ནས་བསྒྲུབ་དགོས་སོ། །"]},{"type":"verse","number":15,"content":["ལྟོས་དང་། ངས་དེ་རིང་ཁྱོད་རྣམས་ཀྱི་མདུན་དུ་ཚེ་སྲོག་དང་ཕན་བདེ། འཆི་བ་དང་རྐྱེན་ངན་བཤམས་ཡོད་དེ།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་འཚོ་ཞིང་འཕེལ་བའི་ཆེད་དུ། ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་རྒྱ་སྟེ་ངས་དེ་རིང་ཁྱོད་ཅག་ལ་བསྒོས་པ་རྣམས་ལ་མཉན་ནས། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དགའ་ཞིང་ཁོང་གི་ཕེབས་ལམ་དུ་བསྐྱོད་པ་དང་། ཁོང་གི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས། སྲོལ་ཡིག་བཅས་བསྲུངས་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཕར་སོང་སྟེ་བདག་གིར་འཛིན་པའི་ཡུལ་དུ་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་ངེས་ཡིན།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང་ཁྱོད་རྣམས་ཀྱི་སེམས་ལོག་ལམ་ལ་འཕྱན་ནས་བཀའ་མི་བརྩི་བ་དང་། ལྷ་གཞན་དག་ལ་ཕྱག་བཙལ་ནས་བསྙེན་བཀུར་ཕུལ་ན།"]},{"type":"verse","number":18,"content":["ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་གཟབ་ནན་གྱིས་སྨྲ་བར་བྱ་སྟེ་ཁྱོད་ཅག་ནུབ་པར་འགྱུར་ཞིང་། ཁྱོད་རྣམས་ཡོར་དན་གཙང་པོ་བརྒལ་ནས་ཕར་སོང་སྟེ་བདག་གིར་འཛིན་པའི་ཡུལ་དེ་རུ་ཁྱོད་རྣམས་ཡུན་རིང་འཚོ་མི་ཐུབ།"]},{"type":"verse","number":19,"content":["ངས་དེ་རིང་གནམ་ས་གཉིས་དཔང་དུ་བཙུགས་ཏེ་ཁྱོད་རྣམས་ཀྱི་མདུན་དུ་ཚེ་སྲོག་དང་འཆི་བ། བྱིན་རླབས་དང་དམོད་མོ་བཤམས་ཡོད། དེ་བས་ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་གི་བུ་རྒྱུད་ཀྱི་སྲོག་འཚོ་བའི་ཆེད་དུ་ཚེ་སྲོག་འདེམས་དགོས།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཅེས་ཤིང་ཁོང་གི་གསུང་སྐད་ལ་མཉན་ནས་ཁོང་ལ་དམ་པོར་བརྟེན་དགོས། ཅི་ལ་ཞེ་ན། ཁོང་ནི་ཁྱོད་ཅག་གི་ཚེ་སྲོག་ཡིན་ལ་ཁོང་གིས་ཁྱོད་ཅག་ཚེ་ཐག་རིང་བར་མཛད་པའོ། །དེ་ལྟར་བྱས་ན་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་ཕ་མེས་ཨབ་ར་ཧམ་དང་ཨི་སཱག ཡ་ཀོབ་བཅས་ལ་གནང་བར་མནའ་བཞེས་པའི་ཡུལ་དུ་ཁྱོད་ཅག་གནས་ཐུབ་པ་ཡིན་ཞེས་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"འདིར་སེམས་ནང་གི་མི་གཙང་བ་རྣམས་བསལ་ངེས་ཡིན་ཞེས་པར་མ་ཕྱི་ལས་སེམས་ལ་མཚན་སྐྱི་གཅོད་ངེས་ཡིན་ཞེས་མཐོང་ཞིང་། སེམས་ཀྱི་མི་གཙང་བ་རྣམས་བསལ་བའི་དོན་ལ་འཇུག་པས་དོན་སྒྱུར་བྱས་པ་ཡིན།","reference":{"chapter":30,"verse":6}}]},"thisChapterLink":"/api/bod_ntb/DEU/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/29.json","previousChapterAudioLinks":{},"numberOfVerses":20}