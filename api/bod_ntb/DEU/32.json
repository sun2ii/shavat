{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"heading","content":["མོ་ཤེའི་མགུར།"]},{"type":"verse","number":1,"content":["ཀྱེ་མ་ནམ་མཁས་རྣ་བ་གཏོད་པར་གྱིས། ། ང་ཡི་སྨྲ་སྒོར་བརྗོད་བྱའི་གཏམ་ཞིག་ཡོད། ། བདག་གི་གཏམ་དེ་ས་ཡིས་ཐོས་གྱུར་ཅིག །"]},{"type":"verse","number":2,"content":["བདག་གི་བསླབ་བྱ་ཆར་པ་བཞིན་དུ་འབབ། ། ང་ཡི་སྨྲ་བརྗོད་ཟིལ་བ་བཞིན་དུ་ལྷུང་། ། སྦྲང་ཆར་རྩྭ་སྔོན་སྟེང་དུ་ལྷུང་འདྲ་དང་། ། དྲག་ཆར་སྔོ་ཚོད་སྟེང་དུ་བབས་འདྲ་ཡིན། །"]},{"type":"verse","number":3,"content":["བདག་གིས་ཡ་ཝཱེའི་མཚན་སྙན་སྒྲོག་བྱ་ཞིང་། ། རང་རེའི་དཀོན་མཆོག་མཚན་གྱི་ཆེ་བ་བརྗོད། །"]},{"type":"verse","number":4,"content":["བྲག་རི་ཡིན་པ་ཁོང་གི་ཕྱག་ལས་རྣམས། ། རྣམ་པར་དག་ཅིང་ཕེབས་ལམ་ཐམས་ཅད་དྲང་། ། ཡིད་རྟོན་རུང་བའི་དཀོན་མཆོག་དྲང་པོ་སྟེ། ། ཉེས་ལྟུང་དྲི་མ་མེད་པ་ཁོང་ཡིན་ནོ། །"]},{"type":"verse","number":5,"content":["མི་རབས་འདི་ཡིས་ཁོང་ལ་གཏོར་བརླག་བཟོས། ། ཉེས་སྐྱོན་ཡོད་པས་ཁོང་གི་བུ་ཕྲུག་མིན། ། མི་རབས་འདི་ནི་སྤྱོད་རྩིང་བློ་འཁྱོག་གོ །"]},{"type":"verse","number":6,"content":["ཀྱེ་མ་བློ་གྲོས་མེད་པ་བླུན་པོའི་ཚོགས། ། ཡ་ཝཱེའི་བཀའ་དྲིན་དེ་བཞིན་འཇལ་ཡོང་ངམ། ། ཁོང་ནི་ཁྱོད་ཚོ་གསར་བཟོ་གནང་མཁན་གྱི། ། ཡབ་ཆེན་གཅིག་པུ་མིན་ནམ་གོ་མེད་ཚོ། ། ཁོང་གིས་ཁྱོད་རང་བཀོད་ནས་བརྟན་པོར་བཟོས། །"]},{"type":"verse","number":7,"content":["འདས་པའི་ཉིན་མོ་དག་ནི་དྲན་པར་གྱིས། ། སྔོན་རབས་མང་པོ་རྣམས་ལ་བསམ་བློ་ཐོངས། ། རང་གི་ཕ་ལ་དྲིས་དང་ཁོ་ཡིས་སྟོན། ། རྒན་པ་རྣམས་ལ་དྲིས་དང་བརྗོད་པར་ངེས། །"]},{"type":"verse","number":8,"content":["བླ་མེད་ཉིད་ཀྱིས་མི་རིགས་དེ་རྣམས་ལ། ། རང་རང་ས་སྐལ་གནང་བའི་དུས་སྐབས་དང་། ། མིའི་རིགས་སོ་སོར་བཀར་བའི་དུས་དེ་ལ། ། ཁོང་གིས་ཡེས་ར་ཨེལ་གྱི་མི་གྲངས་བཞིན། ། མི་རིགས་རྣམས་ཀྱི་ས་མཚམས་གཏན་ལ་ཕབ། །"]},{"type":"verse","number":9,"content":["ཡ་ཝཱེའི་སྐལ་ནི་ཁོང་གི་འབངས་མི་དང་། ། ཁོང་གི་ནོར་སྐལ་ཡ་ཀོབ་ཡིན་པ་འོ། །"]},{"type":"verse","number":10,"content":["ཡ་ཝཱེ་དབེན་སྟོང་ཡུལ་དུ་མི་དེར་ཕྲད། ། ས་རྒོད་ངར་སྐད་སྒྲོག་པའི་ཡུལ་དུ་རྙེད། ། ཁོང་གིས་དེ་ལ་བྱམས་སྐྱོང་མཛད་ནས་ནི། ། རང་གི་སྤྱན་འབྲས་བཞིན་དུ་སྲུང་བར་མཛད། །"]},{"type":"verse","number":11,"content":["བྱ་གླག་གིས་ནི་རང་གི་ཚང་དཀྲོགས་ནས། ། ཁྲ་ཕྲུག་གོང་དུ་འཕུར་ལྡིང་བྱེད་པ་བཞིན། ། གཤོག་པ་ཕྱི་ལ་བརྐྱངས་ནས་གཤོག་སྒྲོའི་ཁུད། ། ཁྲ་ཕྲུག་ཁུར་ནས་འགྲོ་བའི་ངང་ཚུལ་བཞིན། །"]},{"type":"verse","number":12,"content":["ཡ་ཝཱེ་གཅིག་པུས་ཁོ་ལ་ལམ་ཁྲིད་མཛད། ། གཞན་པའི་ལྷ་ནི་གང་ཡང་ཡོད་མ་ཡིན། །"]},{"type":"verse","number":13,"content":["ཁོང་གིས་དེ་ནི་ས་གཞིའི་མཐོ་སར་བསྐྱོན། ། ཞིང་ཁའི་ཐོན་འབྲས་རྣམས་ནི་སྤྱོད་པར་མཛད། ། བྲག་ལས་སྦྲང་རྩི་འཇིབ་པར་མཛད་པ་དང་། ། སྲ་འཐས་བྲག་གི་གསེང་ནས་སྣུམ་གནང་ངོ་། །"]},{"type":"verse","number":14,"content":["གླང་གི་ཞོ་དང་ར་ལུག་འོ་མ་དང་། ། ལུ་གུའི་ཚིལ་དང་པཱ་ཤན་ཡུལ་གྱི་ནི། ། ལུག་ཐུག་ར་ཐུག་གྲོ་ཡི་སྙིང་བཅུད་བཅས། ། སྤྱོད་པར་མཛད་ཅིང་རྒུན་འབྲུམ་དམར་པོ་ལས། ། བཟོས་པའི་རྒུན་ཆང་ཁྱོད་ཀྱིས་བཏུངས་པ་འོ། །"]},{"type":"verse","number":15,"content":["ཡེ་ཤུ་རུན་",{"noteId":6},"ནི་ཚོ་ཞིང་རྡོག་ཐོ་བརྒྱབ། ། ཁྱོད་རང་ཚོ་ཞིང་ཤུགས་ཆེན་རྒྱགས་པ་ཆགས། ། ཁོས་ནི་རང་ཉིད་འགོད་མཁན་དཀོན་མཆོག་སྤངས། ། རང་གི་མགོན་སྐྱབས་བྲག་ལ་འཕྱ་སྨོད་བྱས། །"]},{"type":"verse","number":16,"content":["དེ་ཚོས་ལྷ་གཞན་བརྟེན་པས་ཁོང་ལ་འགྲན་སེམས་བསྐྱེད། ། སྐྱུག་བྲོའི་བྱ་སྤྱོད་ཀྱིས་ནི་ཁོང་གི་ཐུགས་ཁྲོ་བསླངས། །"]},{"type":"verse","number":17,"content":["དེ་ཚོས་དཀོན་མཆོག་མིན་པའི་གདོན་འདྲེ་སྟེ། ། རང་ལ་རྒྱུས་མེད་ལྷ་ཚོགས་གཞན་པ་དང་། ། ཉེ་རབས་བྱུང་བའི་ལྷ་གསར་མང་པོར་བསྟེན། ། ཁྱོད་ཀྱི་ཕ་མེས་རྣམས་ནི་མི་འཇིགས་པ། ། དེ་འདྲའི་ལྷ་ཡི་རིགས་ལ་མཆོད་པ་ཕུལ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་བསྐྱེད་ཡུམ་བྲག་ནི་སྣང་མེད་བསྐྱུར། ། ཁྱོད་རང་བསྐྲུན་པའི་དཀོན་མཆོག་བརྗེད་པར་གྱུར། །"]},{"type":"verse","number":19,"content":["རང་གི་བུ་དང་བུ་མོས་ཐུགས་ཁྲོ་བསླངས། ། ཡ་ཝཱེས་དེ་དག་གཟིགས་ནས་ཁོ་རྣམས་སྤངས། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཁོང་གིས་འདི་སྐད་གསུངས་པ་སྟེ། ། བདག་གིས་དེ་རྣམས་ལ་ནི་གདོང་མི་སྟོན། ། དེ་ཚོའི་མཇུག་འབྲས་ཅི་ལྟར་འབྱུང་བར་བལྟ། ། དེ་རྣམས་ཚུལ་འཆོས་ཅན་གྱི་མི་རབས་ཤིག ། བློ་གཏད་མེད་པའི་བུ་རྣམས་ཡིན་ཕྱིར་རོ། །"]},{"type":"verse","number":21,"content":["དེ་ཚོས་དཀོན་མཆོག་མིན་པའི་ལྷ་ཡིས་ནི། ། བདག་གི་ཕྲག་དོག་བསྐྱེད་ཅིང་དེ་དག་གིས། ། སྟོང་པའི་སྐུ་འདྲ་རྣམས་ཀྱིས་ཁོང་ཁྲོ་བསླངས། ། དེ་བས་བདག་གིས་འབངས་མི་མ་ཡིན་པའི། ། རིགས་ལ་བརྟེན་ནས་ཁོ་ཚོར་ཕྲག་དོག་བསླང་། ། བླུན་རྨོངས་མི་རིགས་རྣམས་ཀྱིས་ཁོང་ཁྲོ་བསླང་། །"]},{"type":"verse","number":22,"content":["བདག་གི་ཁོང་ཁྲོའི་མེ་ལྕེ་རབ་ཏུ་འབར། ། གཤིན་པོའི་ཡུལ་གྱི་གཏིང་མཐིལ་འཚིག་པར་མཛད། ། ས་གཞི་དང་ནི་དེ་ཡི་སྐྱེ་དངོས་རྣམས། ། ཡོངས་རྫོགས་རྩ་མེད་གཏོང་བའི་དུས་ལ་སླེབས། ། རི་བོའི་རྩ་བ་དག་ཀྱང་མེ་ལ་འབར། །"]},{"type":"verse","number":23,"content":["བདག་གིས་དེ་ཚོའི་སྟེང་ལ་གོད་ཆག་སྤུང་། ། མདའ་མོ་ཐམས་ཅད་ཁོ་ཚོར་ཕོག་པར་བྱ། །"]},{"type":"verse","number":24,"content":["མུ་གེའི་རྐྱེན་གྱིས་ཁོ་རྣམས་རྒུད་པར་འགྱུར། ། ཚ་ནད་རིམས་ནད་དྲག་པོས་མེད་པར་བཟོ། ། གཅན་གཟན་དག་གི་མཆེ་བས་རྨུག་བྱེད་ཅིང་། ། ལྟོ་འགྲོ་སྦྲུལ་གྱི་དུག་ནི་ཁོ་ཚོར་ཕོག །"]},{"type":"verse","number":25,"content":["ཕྱི་ལ་རལ་གྲི་ནང་དུ་འཇིགས་སྣང་ཡོད། ། དེ་ཡིས་མི་རྣམས་འཇིག་པར་བྱེད་པ་དང་། ། ན་གཞོན་ཕོ་མོ་ཕྲུ་གུ་བགྲེས་སོང་བཅས། ། ཐམས་ཅད་རྩ་ནས་མེད་པར་འགྲོ་བ་འོ། །"]},{"type":"verse","number":26,"content":["བདག་གིས་དེ་དག་ཕྱོགས་བཞིར་གཏོར་ནས་ནི། ། མི་ཡི་གྲལ་ནས་གསུབ་དགོས་སྨྲས་ན་ཡང་། །"]},{"type":"verse","number":27,"content":["དགྲ་བོས་དཀྲོག་གཏམ་སྤེལ་བར་ང་མི་དགའ། ། ཁོ་ཚོས་གོ་བ་ལོག་ནས་འདི་ལྟར་དུ། ། ཡ་ཝཱེས་དོན་དེ་ཐམས་ཅད་བསྒྲུབས་པ་མིན། ། ང་ཚོའི་ལག་པ་རྣམ་པར་རྒྱལ་ཞེས་བརྗོད། །"]},{"type":"verse","number":28,"content":["མི་རིགས་དེ་ལ་གོ་རྟོགས་དབེན་གྱུར་པས། ། ཁོ་ཚོའི་ཁྲོད་དུ་བློ་གྲོས་ཡོད་མ་ཡིན། །"]},{"type":"verse","number":29,"content":["གལ་སྲིད་ཁོ་ཚོར་ཤེས་རབ་ལྡན་གྱུར་ན། ། དོན་འདི་རྟོགས་ཤིང་མ་འོངས་འབྱུང་འགྱུར་གྱི། ། རང་གི་མཇུག་འབྲས་ཐག་གིས་ཆོད་པ་ཡིན། །"]},{"type":"verse","number":30,"content":["ཁོ་ཚོའི་བྲག་གིས་ཁོ་རྣམས་བཙོངས་པ་དང་། ། ཡ་ཝཱེས་ཁོ་རྣམས་སྤངས་པ་མ་ཡིན་ན། ། ཅི་ལྟར་གཅིག་གིས་གྲངས་ཀ་སྟོང་ཞིག་འདེད། ། ཅི་ལྟར་གཉིས་ཀྱིས་ཁྲི་གཅིག་འབྲོ་རུ་འཇུག །"]},{"type":"verse","number":31,"content":["ཁོ་ཚོའི་བྲག་ནི་རང་རེའི་བྲག་ལྟར་མིན། ། ངེད་ཀྱི་དགྲ་བོས་དེ་ནི་ཁས་ལེན་ནོ། །"]},{"type":"verse","number":32,"content":["དེ་ཚོའི་རྒུན་ཤིང་སཱ་དོམ་རྒུན་ཤིང་ཡིན། ། གཱ་མོ་ར་ཡི་ས་ཞིང་ནས་བྱུང་ངོ་། ། ཁོ་ཚོའི་རྒུན་འབྲུམ་དུག་གི་རྒུན་འབྲུམ་ཡིན། ། རྒུན་འབྲུམ་ཆུན་པོ་རྣམས་ཀྱི་རོ་ཁ་འོ། །"]},{"type":"verse","number":33,"content":["ཁོ་ཚོའི་རྒུན་ཆང་སྦྲུལ་གྱི་དུག་ཡིན་ཞིང་། ། དེ་ནི་དུག་སྦྲུལ་རྣམས་ཀྱི་དུག་ངན་ཡིན། །"]},{"type":"verse","number":34,"content":["དེ་ནི་ང་ཡི་མཛོད་དུ་ཉར་མེད་དམ། ། གཏེར་མཛོད་ནང་དུ་ཐེལ་ཙེ་གླན་མེད་དམ། །"]},{"type":"verse","number":35,"content":["དེ་དག་རྐང་པ་འདྲེད་པའི་དུས་དེ་ལ། ། བདག་གིས་དགྲ་ཤ་ལེན་ཞིང་ལན་སྤྲོད་དགོས། ། ཁོ་ཚོར་ཆག་སྒོ་འབྱུང་བའི་ཉིན་མོ་སླེབས། ། འབྱུང་འགྱུར་དོན་རྣམས་མྱུར་དུ་ཁོ་ཚོར་འབབ། །"]},{"type":"verse","number":36,"content":["ཡ་ཝཱེས་རང་གི་མི་ལ་དཀར་འདོན་གནང་། ། ཁོང་གི་ཞབས་ཕྱིར་སྙིང་རྗེས་གཟིགས་པར་འགྱུར། ། ཡ་ཝཱེས་དེ་དག་སྟོབས་ཤུགས་ཡལ་བ་དང་། ། བྲན་གཡོག་དང་ནི་རང་དབང་ཅན་རྣམས་ལས། ། ཤུལ་དུ་ལུས་པ་གཅིག་ཀྱང་མེད་པ་གཟིགས། །"]},{"type":"verse","number":37,"content":["དེ་ནས་ཁོང་གིས་འདི་སྐད་གསུང་བ་སྟེ། ། ཁོ་ཚོའི་ལྷ་རྣམས་ད་ལྟ་གང་དུ་ཡོད། ། ཁོ་ཚོའི་སྐྱབས་གནས་བྲག་རི་གང་དུ་ཡོད། །"]},{"type":"verse","number":38,"content":["མཆོད་པའི་ཚིལ་རྣམས་བཟའ་ཞིང་སྐྱེམས་མཆོད་ཀྱི། ། རྒུན་ཆང་འཐུང་མཁན་ལྷ་རྣམས་གང་དུ་མཆིས། ། ཁོ་རྣམས་ལངས་ནས་ཁྱོད་ལ་རོགས་བྱེད་ཅིང་། ། ཁྱོད་རྣམས་བསྲུང་བར་བཅུག་དང་འོས་སོ་ལོ། །"]},{"type":"verse","number":39,"content":["ད་ནི་ལྟོས་དང་ང་རང་ཁོང་ཉིད་ཡིན། ། ང་རང་མ་གཏོགས་དཀོན་མཆོག་གཞན་ཞིག་མེད། ། ངས་ནི་གསོད་ཅིང་ངས་ནི་གསོན་དུ་འཇུག ། ངས་ནི་རྨ་ཁ་བཟོ་ཞིང་དྲག་གསོ་བྱེད། ། སུས་ཀྱང་ང་ཡི་ལག་ནས་འཁྱེར་མི་ནུས། །"]},{"type":"verse","number":40,"content":["བདག་གིས་ལག་པ་ནམ་མཁའི་ཕྱོགས་དུ་བསྒྲེངས། ། ང་རང་ནམ་ཡང་གསོན་པར་མནའ་བསྐྱལ་ལོ། །"]},{"type":"verse","number":41,"content":["བདག་གིས་འོད་འཁྱུག་རལ་གྲི་བརྡར་ནས་ནི། ། ལག་ཏུ་ཉེས་ཆད་གཅོད་པའི་དབང་ཐོགས་དུས། ། དགྲ་བོ་རྣམས་ལ་ཤ་འཁོན་རྩོད་པ་དང་། ། བདག་ལ་སྡང་བ་རྣམས་ལ་ལན་འཇལ་ལོ། །"]},{"type":"verse","number":42,"content":["བསད་པའི་མི་དང་བཙོན་པ་རྣམས་ཀྱི་ཁྲག ། བདག་གི་མདའ་མོས་འཐུང་ཞིང་བཟི་བར་འགྱུར། ། ང་ཡི་རལ་གྲིས་ཤ་ནི་བཟའ་འགྱུར་ཏེ། ། དགྲ་བོའི་དཔོན་པོ་རྣམས་ཀྱི་ཤ་བཟའ་འོ། །"]},{"type":"verse","number":43,"content":["ཀྱེ་ཀྱེ་མི་རིགས་ཀུན་གྱིས་ཉོན་ཅིག་དང་། ། ཁོང་གི་འབངས་དང་མཉམ་དུ་དགའ་བར་གྱིས། ། ཁོང་གིས་རང་གི་ཞབས་ཕྱིའི་ཁྲག་ལན་རྩོད། ། རང་གི་དགྲ་ལས་དགྲ་ཤ་ལེན་པ་དང་། ། ཁོང་གིས་ཉིད་ཀྱི་ཡུལ་ཁམས་གཙང་མར་མཛད། ། ཉིད་ཀྱི་འབངས་མི་བླུ་བར་འགྱུར་བས་སོ། །ཞེས་གསུངས་པའོ། །"]},{"type":"verse","number":44,"content":["དེ་ནས་མོ་ཤེ་དང་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་གཉིས་ཀ་ཡོང་ནས་མགུར་དེའི་གསུང་ཐམས་ཅད་མི་རྣམས་ཀྱི་རྣ་བར་བསྒྲགས།"]},{"type":"verse","number":45,"content":["མོ་ཤེ་ཡིས་གསུང་དེ་ཐམས་ཅད་ཡེས་ར་ཨེལ་པ་ཀུན་ལ་བསྒྲགས་ཚར་རྗེས།"]},{"type":"verse","number":46,"content":["དེ་དག་ལ་འདི་ལྟར། ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསླབས་པའི་བཀའ་ཐམས་ཅད་ཡིད་ལ་ཟུངས་ཤིག དེ་ནས་ཁྱོད་རྣམས་ཀྱིས་རང་གི་བུ་རྒྱུད་ལ་བཀའ་ཁྲིམས་འདིའི་བཀའ་ཐམས་ཅད་གཟབ་གཟབ་ངང་བསྒྲུབ་པར་གདམས་ཆོག་པ་ཡིན།"]},{"type":"verse","number":47,"content":["གང་ལ་ཞེ་ན། བཀའ་འདི་དག་སྟོང་པ་མ་ཡིན་ཏེ། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་ཚེ་སྲོག་ཡིན། བཀའ་འདི་བརྒྱུད་ནས་ཁྱོད་རྣམས་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་ཕྱིན་ཏེ་བདག་གིར་འཛིན་པའི་ཡུལ་དེར་ཡུན་རིང་པོར་འཚོ་ཐུབ་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["མོ་ཤེ་འཆི་བའི་སྔོན་བརྡ།"]},{"type":"verse","number":48,"content":["ཉིན་མོ་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":49,"content":["ཡེ་རུ་ཀོ་ཡི་དྲང་ཐད་དུ་ཡོད་པའི་མོ་ཨབ་ཡུལ་དུ། ཨ་བཱ་རིམ་རི་རྒྱུད་ཀྱི་རི་བོ་ནེ་བོའི་སྟེང་ལ་འགོས་ཏེ། ངས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ས་སྐལ་དུ་སྦྱིན་པའི་ཀ་ན་ཨན་ཡུལ་ལ་ལྟོས་ཤིག"]},{"type":"verse","number":50,"content":["ཁྱོད་ཀྱི་སྤུན་ཟླ་ཨ་རོན་རི་བོ་ཧོར་དུ་འདས་ནས་རང་གི་མེས་པོ་རྣམས་དང་མཉམ་དུ་འཛོམས་པ་ཇི་བཞིན། ཁྱོད་ཀྱང་རང་ཉིད་འགོས་པའི་རི་བོ་དེར་འདས་ནས་མེས་པོ་རྣམས་དང་མཉམ་དུ་འཛོམ་ངེས་ཡིན།"]},{"type":"verse","number":51,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གིས་ཟིན་ཞེས་པའི་དབེན་སྟོང་གི་མེ་རི་བཱ་ཀཱ་དེ་སི་བྱ་བའི་ཆུ་འགྲམ་དུ། ཡེས་ར་ཨེལ་པའི་དཀྱིལ་ནས་ང་དང་འགལ་ཞིང་། ཡེས་ར་ཨེལ་པའི་ཁྲོད་དུ་ང་དམ་པར་མ་བརྩིས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":52,"content":["དེར་བརྟེན་བདག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྦྱིན་པའི་ཡུལ་དེ་ཁྱོད་ཀྱིས་རྒྱང་ནས་མཐོང་ན་ཡང་། ཁྱོད་དེར་འགྲོ་མི་ནུས་སོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[{"noteId":6,"caller":"+","text":"ཡེ་ཤུ་རུན་ཞེས་པ་ནི་ཡེས་ར་ཨེལ་གྱི་གཅེས་མིང་ཡིན་ལ། གཞུང་དྲང་ཞེས་པའི་དོན་ལ་འཇུག","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/bod_ntb/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}