{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":4,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་ལ་དཀོན་མཆོན་གི་བཀའ་བརྩི་བར་གདམས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལྟོས་དང་། དེ་རིང་ཁྱོད་ཅག་གིས་ངས་སྔར་ནས་ཁྱོད་རྣམས་ལ་ཁྲིད་པའི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་ལ་མཉན་དགོས། དེ་དག་བསྲུང་བར་གྱིས་དང་ཁྱོད་རྣམས་འཚོ་ཐུབ་ལ། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་གནང་བའི་ཡུལ་དུ་སོང་ནས་དེར་བདག་པོ་རྒྱག་ནུས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་བསྒོས་པའི་བཀའ་ལ་སྣོན་ཕྲི་གང་ཡང་བྱེད་མི་རུང་། དེ་ནས་ངས་ཁྱོད་ཅག་ལ་བསྒོས་པ་སྟེ་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བསྩལ་པའི་བཀའ་རྣམས་བསྲུང་ནུས་པ་ཡིན།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་ཨལ་ཕེ་ཨོར་ཡུལ་གྱི་རྐྱེན་གྱིས་ཅི་མཛད་པ་ཁྱོད་ཅག་གིས་དངོས་སུ་མཐོང་བ་དང་། ལྷ་པཱ་ཨལ་ཕེ་ཨོར་གྱི་རྗེས་སུ་འབྲངས་པའི་མི་ཐམས་ཅད་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་ཁྲོད་ནས་མེད་པར་མཛད།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགྱུར་བ་མེད་པར་བརྟེན་པ་ཁྱོད་རྣམས་འབའ་ཞིག་དེ་རིང་ཉིན་མོའི་བར་དུ་གནས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":5,"content":["ལྟོས་དང་། བདག་གིས་ང་ཡི་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བསྒོས་པའི་བཀའ་བཞིན་དུ། སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་རྣམས་ཁྱོད་ཅག་ལ་ཁྲིད་པ་སྟེ། ཁྱོད་རྣམས་སོང་ནས་རང་ལ་དབང་བར་འགྱུར་བའི་ཡུལ་ནས་དེ་ལྟར་བསྒྲུབ་པའི་ཕྱིར་དུའོ། །"]},{"type":"verse","number":6,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་གཟབ་གཟབ་ངང་དེ་རྣམས་བསྲུངས་ནས་བསྒྲུབ་དགོས། ཅི་ལ་ཞེ་ན། མི་རྣམས་ཀྱི་མིག་ལ་དེ་ནི་ཁྱོད་ཅག་གི་ཤེས་རབ་དང་བློ་གྲོས་ཡིན་པས་སོ། །ཁོ་ཚོས་སྒྲིག་ཁྲིམས་འདི་ཐམས་ཅད་ཐོས་ན། མི་རིགས་ཆེན་པོ་འདི་ནི་དངོས་གནས་ཤེས་རབ་ཅན་དང་བློ་གྲོས་ཅན་ཞིག་འདུག་ཅེས་སྨྲ་ངེས་ཡིན།"]},{"type":"verse","number":7,"content":["རང་ཅག་གིས་ཞུ་འབོད་བྱེད་ཐེངས་རེར་རང་རེའི་ཉེ་བར་བཞུགས་པའི་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་བཞིན། མི་རིགས་ཆེན་པོ་གཞན་གང་ལ་ཁོ་ཚོའི་ཉེ་བར་སྡོད་པའི་ལྷ་ཞིག་ཡོད་པ་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["ཡང་མི་རིགས་ཆེན་པོ་གང་ལ་འདི་ལྟ་བུའི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་དྲང་བདེན་ཏེ། དེ་རིང་ངས་ཁྱོད་རྣམས་ལ་བསྒྲགས་པའི་བཀའ་ཁྲིམས་འདི་ཐམས་ཅད་ལྟ་བུ་ཡོད་པ་ཡིན་ནམ།"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་དངོས་སུ་མཐོང་བའི་དོན་རྣམས་མི་བརྗེད་པ་དང་། ཡང་དོན་དེ་རྣམས་ཁྱོད་ཅག་གི་མི་ཚེ་གང་པོར་སེམས་ནས་མི་འབོར་བའི་ཆེད་དུ། སྙིང་རུས་བསྐྱེད་ནས་རང་གི་སེམས་དང་བསམ་པ་རྒྱུན་དུ་བསྲུང་དགོས། ཁྱོད་ཅག་གིས་དོན་དེ་རྣམས་རང་གི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ལ་ཤེས་སུ་འཇུག་དགོས།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་རི་བོ་ཧོ་རེབ་ནས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འགྲེང་བའི་ཉིན་དེར། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། མི་རྣམས་འདིར་སྡུས་ཤིག དེ་དག་ས་སྟེང་ནས་ནམ་འཚོའི་བར་དུ་བདག་ལ་གུས་ཤིང་འཇིགས་ཤེས་པ་དང་། དེ་དག་གིས་རང་གི་བུ་བུ་མོ་རྣམས་ལའང་ཁྲིད་སྟོན་བྱེད་པའི་ཕྱིར་དུ་ངས་ཁོ་རྣམས་ལ་རང་གི་གཏམ་ལ་མཉན་དུ་འཇུག་གོ་ཞེས་བཀའ་བསྩལ་ཡོད།"]},{"type":"verse","number":11,"content":["རི་མགོར་མེ་འབར་ནས་མེ་ལྕེ་དགུང་ལ་འཕྱུར་ཏེ་མུན་པ་དང་སྤྲིན་ནག སྨག་རུམ་སྟུག་པོ་བཅས་ཀྱིས་བསྒྲིབས་པའི་དུས་སུ། ཁྱོད་ཅག་ཉེ་སར་འོངས་ཏེ་རི་འདབས་སུ་ལངས་ཡོད།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མེའི་དཀྱིལ་ནས་ཁྱོད་རྣམས་ལ་བཀའ་བསྩལ་པ་ལ། ཁྱོད་ཅག་གིས་གསུང་སྐད་ཐོས་པ་ཙམ་ལས་སྐུ་གཟུགས་ཅི་ཡང་མཇལ་མ་བྱུང་། གསུང་སྐད་འབའ་ཞིག་བྱུང་ནས།"]},{"type":"verse","number":13,"content":["ཁོང་གིས་ཉིད་ཀྱི་ཞལ་ཆད་དེ་ཁྱོད་རྣམས་ལ་བསྲུང་བར་བསྒོས་པའི་བཀའ་ཁྲིམས་བཅུ་པོ་དེ་ཁྱོད་ཅག་ལ་བསྒྲགས་ཤིང་། ཡང་དེ་རྣམས་རྡོ་ལེབ་གཉིས་ཀྱི་སྟེང་དུ་བཀོད་པའོ། །"]},{"type":"verse","number":14,"content":["སྐབས་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ། སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་རྣམས་ཁྱོད་ཅག་ལ་འཁྲིད་དགོས་པ་དང་། ཁྱོད་རྣམས་སོང་ནས་བདག་གིར་འཛིན་རྒྱུ་ཡིན་པའི་ཡུལ་དུ་དེ་བཞིན་བསྒྲུབ་དགོས་པའི་བཀའ་བསྩལ་ཡོད་དོ། །"]},{"type":"heading","content":["སྐུ་རྟེན་དགག་པ།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རི་བོ་ཧོ་རེབ་ཀྱི་མེའི་དཀྱིལ་ནས་ཁྱོད་ཅག་ལ་གསུང་གནང་བའི་ཉིན་དེར། ཁྱོད་ཅག་གིས་སྐུ་གཟུགས་གང་ཡང་མཐོང་མེད་པས། ཁྱོད་ཚོས་གཟབ་གཟབ་ངང་རང་ཉིད་བསྲུང་དགོས།"]},{"type":"verse","number":16,"content":["དེ་ལྟར་མ་བྱས་ཚེ། ཁྱོད་རྣམས་ཀྱིས་ལོག་སྤྱོད་སྤེལ་ནས་རང་གི་ཕྱིར་དུ་སྐུ་རྟེན་འདྲ་མིན་བཞེང་བ་སྟེ། ཕོ་མོའི་གཟུགས་བརྙན་དང་།"]},{"type":"verse","number":17,"content":["ཡང་ན་ས་སྟེང་གི་རི་དྭགས་སྣ་ཚོགས་ཀྱི་སྣང་བརྙན་དང་། ཡང་ན་བར་སྣང་གི་འདབ་ཆགས་གཤོག་པ་ཅན་སྣ་ཚོགས་ཀྱི་སྣང་བརྙན།"]},{"type":"verse","number":18,"content":["ཡང་ན་ས་སྟེང་གི་ལྟོ་འགྲོའི་རིགས་སྣ་ཚོགས་ཀྱི་སྣང་བརྙན། ཡང་ན་ས་འོག་གི་ཆུ་ནང་དུ་གནས་པའི་ཉ་ཡི་རིགས་སྣ་ཚོགས་ཀྱི་སྣང་བརྙན་བཅས་གང་རུང་བཟོ་ཉེན་ཡོད།"]},{"type":"verse","number":19,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་མགོ་ཡར་བཀྱགས་ནས་གནམ་ལ་བལྟས་ཏེ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་གནམ་འོག་ཀུན་ཏུ་གནས་པའི་མི་ཐམས་ཅད་ལ་ལོངས་སྤྱོད་དུ་བསྩལ་པའི་ཉི་ཟླ་སྐར་གསུམ་སྟེ་ནམ་མཁའི་ཚོགས་ཡོད་དོ་ཅོག་མཐོང་བའི་ཚེ། ཡིད་དབང་ཕྲོགས་ནས་དེ་དག་ལ་ཕྱག་འཚལ་བ་དང་བསྙེན་བཀུར་བྱེད་ཉེན་ཆེ།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་དེ་རིང་ནང་བཞིན་ཁོང་གི་ནོར་བུ་དང་ཁོང་གི་འབངས་མི་རུ་བདམས་ཏེ། ཁྱོད་ཅག་ལྕགས་འཇུ་བྱེད་མེ་ཐབ་ལྟ་བུའི་ཨེ་ཅིབ་ཡུལ་ནས་བཏོན་ཏེ་ཁྲིད་འོངས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཁྱོད་ཅག་གི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ང་ལ་ཐུགས་ཁྲོས་ཤིང་། ང་ཡོར་དན་གཙང་པོའི་ཕར་ཁ་སྟེ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བའི་ཡུལ་བཟང་པོ་དེར་འགྲོ་མི་ཆོག་པའི་མནའ་བཞེས་པས།"]},{"type":"verse","number":22,"content":["ང་ནི་ཡུལ་འདི་ནས་འཆི་དགོས་ཤིང་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་འགྲོ་མི་ནུས། འོན་ཀྱང་ཁྱོད་ཅག་ཕར་སོང་ནས་ཡུལ་བཟང་པོ་དེ་བདག་གིར་ཟུངས་ཤིག"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་གནང་བའི་ཞལ་ཆད་མི་བརྗེད་པ་དང་། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་དགག་བྱར་བརྩིས་པའི་སྐུ་བརྙན་གྱི་རིགས་གང་ཡང་མི་བཞེང་བའི་ཆེད་དུ་གཟབ་གཟབ་གྱིས་ཤིག"]},{"type":"verse","number":24,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡོངས་རྫོགས་རྩ་མེད་གཏོང་བའི་མེ་དང་དཀོན་མཆོག་ཕྲག་དོག་ཅན་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["ཁྱོད་རྣམས་ལ་བུ་རབས་ཚ་རྒྱུད་སྐྱེས་ནས་ཡུལ་དེར་ཡུན་རིང་གནས་ཤིང་རྒས་པའི་ཚེ། ཁྱོད་ཅག་གིས་ལོག་སྤྱོད་སྤེལ་ནས་ལྷ་སྐུ་སྣ་ཚོགས་བཟོས་ཏེ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ནས་ཁོང་གི་ཐུགས་དཀྲུགས་ན།"]},{"type":"verse","number":26,"content":["ཁྱོད་རྣམས་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་བརྒལ་ནས་བདག་གིར་འཛིན་པའི་ཡུལ་དུ་མགྱོགས་པོར་འཇིག་ཅིང་། ཡུལ་དེར་ཡུན་རིང་གནས་མི་ཐུབ་པར་རྩ་མེད་དུ་འགྲོ་ངེས་པ་ནི་ངས་དེ་རིང་གནམ་ས་གཉིས་དཔང་དུ་བཙུགས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་མི་མང་པོའི་ཁྲོད་དུ་གཏོར་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་གཏོར་བའི་མི་རིགས་མང་པོའི་ཁྲོད་དུ་ཁྱོད་རྣམས་མི་ཉུང་ངུ་ཙམ་ལས་མི་ལྷག"]},{"type":"verse","number":28,"content":["ཡུལ་དེ་རུ་ཁྱོད་རྣམས་ཀྱིས་མིས་བཟོས་པའི་རྡོ་སྐུ་དང་ཤིང་སྐུ་སྟེ་མིག་གིས་མི་མཐོང་ཞིང་རྣ་བས་མི་གོ་བ་དང་། ཟས་སྤྱོད་མི་ནུས་པ། དྲི་མི་ཚོར་བའི་ལྷ་རྣམས་ལ་བསྙེན་བཀུར་བྱེད་ཀྱང་།"]},{"type":"verse","number":29,"content":["ཁྱོད་ཅག་གིས་གནས་དེ་རུ་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་འཚོལ་བར་འགྱུར་ཏེ། བློ་གཅིག་སེམས་གཅིག་གིས་ཁོང་ཉིད་བཙལ་ནས་བསྙེགས་ན། ཁྱོད་རྣམས་ཀྱིས་ཁོང་རྙེད་པར་འགྱུར།"]},{"type":"verse","number":30,"content":["ཁྱོད་རྣམས་དཀའ་སྡུག་གི་གནས་སུ་ལྷུང་སྟེ་དོན་འདི་ཐམས་ཅད་ཁྱོད་ལ་འབྱུང་བའི་དུས་སུ། མཐའ་མའི་ཉིན་མོ་དེ་དག་ལ་ཁྱོད་རྣམས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་ཞིང་ཁོང་གི་གསུང་སྐད་ཐོས་ངེས་པ་ཡིན།"]},{"type":"verse","number":31,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་སྙིང་རྗེ་ལྡན་པའི་དཀོན་མཆོག་ལགས་པས། ཁོང་གིས་ཁྱོད་སྤང་བར་མི་བྱ་ཞིང་ཁྱོད་རྩ་མེད་དུའང་མི་གཏོང་། ཁོང་གིས་ཁྱོད་ཀྱི་ཕ་མེས་ལ་མནའ་བཞེས་ནས་ཞལ་ཆད་བཞག་པའང་ཐུགས་ནས་མི་བརྗེད་དོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེ་འབའ་ཞིག་དཀོན་མཆོག་ཡིན།"]},{"type":"verse","number":32,"content":["ཁྱོད་རྣམས་ཀྱིས་དྲིས་དང་། ཁྱོད་ཅག་གི་སྔར་འདས་ཟིན་པའི་ཉིན་མོ་དག་ལ། དཀོན་མཆོག་གིས་ས་གཞི་སྟེང་མི་ཐོག་མར་བཀོད་པའི་ཉིན་ནས་བཟུང་། གནམ་གྱི་མཐའ་འདི་ནས་མཐའ་གཞན་པའི་བར་དུ་དོན་ཆེན་པོ་འདི་འདྲ་མཛད་མཁན་སུ་ཞིག་ཡོད། དོན་འདི་འདྲ་ཐོས་མྱོང་བ་སུ་ཞིག་ཡོད།"]},{"type":"verse","number":33,"content":["ཁྱོད་རྣམས་ཀྱིས་ཐོས་ཤིང་ད་དུང་གསོན་པོར་གནས་ཐུབ་པ་ནང་བཞིན། དཀོན་མཆོག་གིས་མེའི་དཀྱིལ་ནས་གསུང་གནང་བ་ཐོས་མྱོང་བའི་མི་རིགས་གང་ཞིག་ཡོད།"]},{"type":"verse","number":34,"content":["ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཡུལ་དུ་ཁྱོད་ཅག་གི་མཐོང་ངོར་གང་དང་གང་མཛད་པ་ནང་བཞིན། ཚོད་བརྟག་དང་གྲུབ་རྟགས། ངོ་མཚར་བའི་དོན། འཐབ་མོ། ནུས་མཐུ་ཆེན་པོའི་ཕྱག་དང་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་པ། རབ་ཏུ་ཆེ་ཞིང་འཇིགས་སུ་རུང་བའི་དོན་བཅས་ལ་བརྟེན་ནས་རང་གི་ཕྱིར་དུ་མི་རིགས་ཤིག་མི་རིགས་གཞན་ནས་ལེན་ཐུབ་པའི་ལྷ་ཞིག་ཡོད་དམ།"]},{"type":"verse","number":35,"content":["དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་དཀོན་མཆོག་གཅིག་པུ་ལགས་ཤིང་། ཁོང་མ་གཏོགས་དཀོན་མཆོག་གཞན་མེད་པ་ཁྱོད་ཅག་ལ་སྟོན་པ་དང་ཁྱོད་རྣམས་ཀྱིས་རྟོགས་པའི་ཕྱིར་ཡིན་ནོ། །"]},{"type":"verse","number":36,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་བསླབ་བྱ་གནང་བའི་ཕྱིར་ནམ་མཁའ་ནས་ཁྱོད་ཅག་ལ་ཁོང་གི་གསུང་སྐད་ཐོས་སུ་བཅུག་པ་དང་། ཡང་ས་སྟེང་ནས་ཁོང་གི་མེ་དཔུང་ཁྱོད་ཅག་ལ་བསྟན་ཅིང་མེའི་དཀྱིལ་ནས་བྱུང་བའི་ཁོང་གི་བཀའ་ཁྱོད་ཅག་ལ་ཐོས་སུ་བཅུག"]},{"type":"verse","number":37,"content":["ཁོང་གིས་ཁྱོད་རྣམས་ཀྱི་ཕ་མེས་ལ་གཅེས་པས་དེ་དག་གི་བུ་རྒྱུད་ཕྱི་མ་རྣམས་བདམས་ཤིང་། ཁོང་གི་ནུས་མཐུ་ཆེན་པོས་དངོས་སུ་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པ་དང་།"]},{"type":"verse","number":38,"content":["དེ་ནི་ཁོང་གིས་ཁྱོད་རྣམས་ལས་ཆེ་ཞིང་ཁྱོད་རྣམས་ལས་སྟོབས་ལྡན་པའི་མི་རིགས་རྣམས་ཁྱོད་ཅག་གི་སྔུན་ནས་སྐྲོད་ཅིང་། ཁྱོད་རྣམས་ནང་དུ་ཁྲིད་ནས་ཁོ་ཚོའི་ཡུལ་ནི་དེ་རིང་ནང་བཞིན་ཁྱོད་རྣམས་ལ་ས་སྐལ་དུ་གནང་བའི་ཕྱིར་ཡིན་ནོ། །"]},{"type":"verse","number":39,"content":["དེ་བས་ན་གནམ་ས་གཉིས་སུ་དཀོན་མཆོག་ཡ་ཝཱེ་འབའ་ཞིག་དཀོན་མཆོག་ཡིན་ཏེ། ཁོང་ལས་གཞན་དཀོན་མཆོག་མེད་པ་དེ་རིང་ཁྱོད་ཅག་གིས་ཤེས་ནས་ཡིད་ལ་འཛིན་དགོས།"]},{"type":"verse","number":40,"content":["ངས་དེ་རིང་ཁྱོད་རྣམས་ལ་བསྒོས་པའི་སྒྲིག་ཁྲིམས་དང་བཀའ་རྒྱ་རྣམས་བསྲུང་བར་གྱིས། དེ་བཞིན་བྱས་ན། ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་གི་བུ་རབས་ཚ་རྒྱུད་རྣམས་བདེ་ཞིང་། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་གནང་བའི་ཡུལ་དེར་ཡུན་རིང་འཚོ་ཐུབ་ཅེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"heading","content":["སྐྱབས་བཅོལ་གྲོང་ཁྱེར།"]},{"type":"verse","number":41,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་ནས་གྲོང་ཁྱེར་གསུམ་བདམས་ཏེ།"]},{"type":"verse","number":42,"content":["ཞེ་འཁོན་ཅི་ཡང་མེད་པར་མ་བསམ་ས་ནས་ཁྱིམ་མཚེས་ཤིག་བསད་ཚེ། མི་དེ་གྲོང་ཁྱེར་གསུམ་པོ་དེ་ལས་གཅིག་གི་ནང་བྲོས་ན་གསོན་པོར་འདུག་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":43,"content":["དབེན་སྟོང་གི་ཐང་དུ་ཡོད་པའི་པེ་ཙེར་ཡུལ་ནི་རུ་བེན་པའི་ཡིན་པ་དང་། གིལ་ཨད་ཀྱི་རཱ་མོད་ནི་གཱ་རྡུ་པའི་ཡིན་ལ། པཱ་ཤན་གྱི་གོ་ལན་ནི་མཱ་ན་ཤེ་པའི་ཡིན་པའོ། །"]},{"type":"heading","content":["བཀའ་ཁྲིམས་མཚམས་སྦྱོར།"]},{"type":"verse","number":44,"content":["འདི་ནི་མོ་ཤེ་ཡིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་དུ་བཙུགས་པའི་བཀའ་ཁྲིམས་ཡིན་ཏེ།"]},{"type":"verse","number":45,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རོལ་ཏུ་ཐོན་རྗེས། མོ་ཤེ་ཡིས་ཁོ་རྣམས་ལ་བསྒོས་པའི་དཔང་ཡིག་དང་། སྒྲིག་ཁྲིམས་དང་། སྲོལ་ཡིག་བཅས་ཡིན།"]},{"type":"verse","number":46,"content":["ཡུལ་ནི་ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་དང་། པེད་ཕེ་ཨོར་ཕ་རོལ་གྱི་ལུང་པ་སྟེ། ཧེ་སི་པོན་དུ་གནས་པའི་ཨེ་མོར་པའི་རྒྱལ་པོ་སི་ཧོན་གྱི་ཡུལ་ཡིན་ལ། སི་ཧོན་ནི་མོ་ཤེ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་རྗེས་ཁོ་ཚོས་བསད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":47,"content":["ཁོ་རྣམས་ཀྱིས་དེའི་ཡུལ་དང་པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་གི་ཡུལ་ཏེ། ཡོར་དན་གཙང་པོ་ཤར་ཕྱོགས་ཀྱི་ཨེ་མོར་པའི་རྒྱལ་པོ་གཉིས་ཀྱི་ཡུལ་དབང་དུ་བསྡུས།"]},{"type":"verse","number":48,"content":["ཡུལ་དེ་ནི་ཨར་ནོན་གྲོག་རོང་འགྲམ་རྒྱུད་ཀྱི་ཨ་རོ་ཨེར་ནས་ཧེར་མོན་བྱ་བའི་རི་བོ་སིར་ཡོན་གྱི་བར་དང་།"]},{"type":"verse","number":49,"content":["ཡོར་དན་གཙང་པོ་ཤར་ཕྱོགས་ཀྱི་ཨ་ར་པཱའི་ཐང་ཐམས་ཅད་དང་ཨ་ར་པཱའི་རྒྱ་མཚོའི་བར་ཏེ། ཕིས་གའི་རི་འདབས་བཅས་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/3.json","previousChapterAudioLinks":{},"numberOfVerses":49}