{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":5,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བཅུ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་མོ་ཤེ་ཡིས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་བོས་ནས་དེ་དག་ལ་འདི་ལྟར། ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། དེ་རིང་ངས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱེད་པའི་སྒྲིག་ཁྲིམས་དང་། སྲོལ་ཡིག་རྣམས་ལ་མཉན་ནས་དེ་དག་ལེགས་པར་སྦྱངས་ཏེ་གཟབ་གཟབ་ངང་བསྲུང་བར་གྱིས།"]},{"type":"verse","number":2,"content":["རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་རི་བོ་ཧོ་རེབ་ནས་རང་ཅག་ལ་ཞལ་ཆད་མཛད་ཡོད།"]},{"type":"verse","number":3,"content":["ཞལ་ཆད་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་གི་ཕ་མེས་རྣམས་ལ་མཛད་པ་མ་ཡིན་ཏེ། དེ་རིང་འདི་རུ་གསོན་པོར་གནས་པའི་རང་ཅག་ཀུན་ལ་མཛད་པ་ཡིན།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རི་སྟེང་གི་མེའི་དཀྱིལ་ནས་ཁྱོད་ཅག་ལ་ཁ་རི་ཁ་ཐུག་ཏུ་བཀའ་བསྩལ་ཡོད་དེ།"]},{"type":"verse","number":5,"content":["སྐབས་དེར་ང་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁྱོད་རྣམས་ཀྱི་བར་དུ་འགྲེང་ནས་ཁོང་གི་བཀའ་གསུང་ཁྱོད་ཅག་ལ་བསྒྲགས་པ་ཡིན་ཏེ། ཁྱོད་རྣམས་མེ་དེར་འཇིགས་པས་རི་མགོར་མ་འོངས་སོ། །དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ།"]},{"type":"verse","number":6,"content":["བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ཞིང་། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་གྱི་བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཁྲིད་མཁན་ཡང་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ང་རང་མ་གཏོགས་པའི་དཀོན་མཆོག་གཞན་ཞིག་ཁྱོད་ལ་ཡོད་མི་ཆོག"]},{"type":"verse","number":8,"content":["ཁྱོད་ཀྱིས་རང་ཉིད་ལ་སྐུ་འདྲ་དང་། སྟེང་གི་ནམ་མཁའ་འམ། འོག་གི་སའམ། ས་འོག་གི་ཆུ་ལ་ཡོད་པའི་སེམས་ཅན་གྱི་གཟུགས་བརྙན་གང་ཡང་བཟོ་མི་རུང་།"]},{"type":"verse","number":9,"content":["དེ་དག་ལ་ཕྱག་མ་འཚལ། བསྙེན་བཀུར་ཡང་བྱེད་མི་རུང་། གང་ལ་ཞེ་ན། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ང་རང་ནི་ཕྲག་དོག་ཅན་ཞིག་ཡིན་ཏེ། ཕ་རྣམས་ཀྱི་ནག་ཉེས་ཕྱིར་མི་རབས་གསུམ་མམ་བཞིའི་བར་དུ་ང་རང་ལ་སྡང་མཁན་གྱི་བུ་ཕྲུག་རྣམས་ལ་བཀའ་ཆད་གཅོད་མོད།"]},{"type":"verse","number":10,"content":["འོན་ཀྱང་ང་རང་གཅེས་སུ་འཛིན་པ་དང་བདག་གི་བཀའ་སྲུང་མཁན་རྣམས་ལ་མི་སྟོང་ཕྲག་གི་བར་དུ་ཐུགས་བརྩེ་བར་བྱེད་དོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གང་བྱུང་དུ་སྤྱོད་མི་རུང་། ཅི་ལ་ཞེ་ན། སུ་ཞིག་གིས་ཁོང་གི་མཚན་གང་བྱུང་དུ་སྤྱད་ན་དཀོན་མཆོག་ཡ་ཝཱེས་མི་དེ་ཉེས་མེད་དུ་རྩི་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་ལ་བསྩལ་པའི་བཀའ་བཞིན་དུ། ངལ་གསོ་བའི་ཉིན་མོ་དམ་པར་སྲུངས་ཤིག"]},{"type":"verse","number":13,"content":["ཉིན་དྲུག་གི་རིང་ལ་འབད་ཅིང་རང་གི་ལས་ཀ་ཚང་མ་སྒྲུབ་རུང་བ་ཡིན།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཉིན་བདུན་པ་ནི་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ངལ་གསོ་བའི་ཉིན་མོ་ཡིན་པས། ཉིན་མོ་དེ་ལ་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་དང་བུ་མོ། གཡོག་པོ་དང་གཡོག་མོ། བ་གླང་དང་བོང་བུ། སྒོ་ཕྱུགས་ཐམས་ཅད། ཁྱོད་ཀྱི་རྒྱ་སྒོ་ནང་རོལ་ལ་གནས་པའི་བྱེས་པ་བཅས་ཀྱིས་ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་སྟེ། ཁྱོད་ཀྱི་གཡོག་པོ་དང་གཡོག་མོ་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་དང་འདྲ་བར་ངལ་གསོ་བྱེད་ཐུབ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":15,"content":["ཁྱོད་རང་ཨེ་ཅིབ་ཡུལ་ནས་བྲན་གཡོག་བྱས་མྱོང་བ་དང་། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མཐུ་སྟོབས་ཆེན་པོའི་ཕྱག་དང་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་པ་ཡིས་ཁྱོད་རང་ཡུལ་དེ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པ་དྲན་དགོས། དེ་བས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ངལ་གསོ་བའི་ཉིན་མོ་སྲུངས་ཤིག་ཅེས་ཁྱོད་ལ་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་བཀའ་བསྩལ་པ་བཞིན་དུ། ཚེ་ཐག་རིང་པོར་གནས་ཐུབ་པ་དང་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་གནང་བྱའི་ཡུལ་དེ་རུ་བདེ་བར་འཚོ་ཐུབ་པའི་ཕྱིར། ཁྱོད་ཀྱིས་རང་གི་ཕ་མ་གཉིས་ལ་བཀུར་སྟི་བྱེད་དགོས།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་མི་མ་གསོད།"]},{"type":"verse","number":18,"content":["ལོག་གཡེམ་མ་བྱེད།"]},{"type":"verse","number":19,"content":["རྐུ་མ་བྱེད།"]},{"type":"verse","number":20,"content":["རང་གི་ཁྱིམ་མཚེས་ལ་རྫུན་གྱི་དཔང་པོ་མ་བྱེད།"]},{"type":"verse","number":21,"content":["རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་ལ་འདོད་ཧམ་མ་བཅང་། ཁྱིམ་མཚེས་ཀྱི་ཁང་པ་དང་ས་ཞིང་། གཡོག་པོ་དང་གཡོག་མོ། བ་གླང་དང་བོང་བུ་བཅས་དང་། ཡང་ན་ཁྱིམ་མཚེས་ཀྱི་ཡིན་ཚད་གང་ལའང་ཧམ་པ་བཅང་མི་རུང་ཞེས་གསུངས་པའོ། །"]},{"type":"verse","number":22,"content":["བཀའ་འདི་རྣམས་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་རི་མགོ་ནས་མེ་དང་སྤྲིན་དང་། སྨག་རུམ་སྟུག་པོའི་དབུས་ནས་གསུང་སྐད་ཆེན་པོས་ཁྱོད་མི་ཚོགས་ཐམས་ཅད་ལ་བསྒྲགས་པ་ཡིན། དེ་ལ་ཅི་ཡང་བསྣན་མེད། ཁོང་གིས་བཀའ་དེ་རྣམས་རྡོ་ལེབ་གཉིས་ཀྱི་སྟེང་བཀོད་ནས་ང་ལ་གནང་བྱུང་།"]},{"type":"verse","number":23,"content":["སྐབས་དེར་རི་མགོར་མེ་འབར་བ་དང་ལྷན་དུ་ཁྱོད་རྣམས་ཀྱིས་སྨག་རུམ་ནས་གསུང་སྐད་གྲགས་འོངས་པ་ཐོས་ནས། ཁྱོད་ཅག་ཚོ་པ་ཁག་གི་འགོ་དཔོན་ཐམས་ཅད་དང་རྒན་པོ་རྣམས་ངའི་ཉེ་སར་འོངས་ཏེ་ན་རེ།"]},{"type":"verse","number":24,"content":["ཀྱེ་མ། བདག་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་གཟི་བརྗིད་དང་ཆེ་བ་ང་ཚོར་བསྟན་པ་དང་། ང་ཚོས་ཁོང་གི་གསུང་སྐད་མེའི་དཀྱིལ་ནས་གྲགས་འོངས་པ་ཐོས། དཀོན་མཆོག་གིས་མི་ལ་གསུང་མོལ་གནང་བ་དང་མི་ད་དུང་གསོན་པོར་གནས་ཐུབ་པ་དེ་རིང་ངེད་ཅག་གིས་མཐོང་བྱུང་།"]},{"type":"verse","number":25,"content":["ད་ནི་མེ་དཔུང་འདིས་ང་ཚོ་རྩ་མེད་གཏོང་ངེས་ཡིན། ང་ཚོ་འཆི་དགོས་དོན་ཅི་ཡོད་དམ། གལ་སྲིད་ང་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་སྐད་ཡང་བསྐྱར་ཐོས་ན་ང་ཚོ་འཆི་བར་འགྱུར།"]},{"type":"verse","number":26,"content":["ཅི་ལ་ཞེ་ན། ཤ་ཁྲག་གདོས་བཅས་ཀྱི་མི་སུ་ཞིག་གིས་རང་ཅག་དང་འདྲ་བར་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་གི་གསུང་སྐད་མེའི་དཀྱིལ་ནས་གྲགས་འོངས་པ་ཐོས་ནས་ད་དུང་གསོན་པོར་གནས་ཐུབ་བམ།"]},{"type":"verse","number":27,"content":["དེ་བས་ཁྱེད་རང་ཉེ་བར་བཅར་ནས་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཅི་ཞིག་གསུང་བར་གསན་པར་མཛོད། དེ་ནས་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ལ་བཀའ་བསྩལ་པ་ཐམས་ཅད་ང་ཚོར་གསུངས་དང་། ངེད་ཅག་གིས་མཉན་ནས་དེ་བཞིན་དུ་བསྒྲུབ་པར་བྱའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":28,"content":["དེ་ཡང་ཁྱོད་རྣམས་ཀྱིས་ང་ལ་གླེང་མོལ་བྱེད་པའི་སྐབས་སུ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་སྐད་སྒྲ་གསན་ནས་ཁོང་གིས་ང་ལ་འདི་སྐད་དུ། མི་འདི་རྣམས་ཀྱིས་ཁྱོད་ལ་སྨྲས་པའི་གཏམ་བདག་གིས་ཐོས་ཡོད། དེ་དག་གིས་སྨྲས་པ་ཐམས་ཅད་ལེགས་པོ་འདུག"]},{"type":"verse","number":29,"content":["ཁོ་ཚོས་རྟག་ཏུ་དེ་ལྟ་བུའི་བསམ་པ་བཅངས་ནས་བདག་ལ་གུས་ཤིང་འཇིགས་པ་དང་། བདག་གི་བཀའ་ཐམས་ཅད་བསྲུང་བར་ཤོག དེ་ནས་ཁོ་ཚོའི་བུ་རྒྱུད་རྣམས་དུས་གཏན་དུ་བདེ་བར་འགྱུར།"]},{"type":"verse","number":30,"content":["ཁྱོད་སོང་ནས་ཁོ་རྣམས་ལ་གུར་ནང་དུ་ཕྱིར་ལོག་ཅིག་ཅེས་སྒོས་ཤིག"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་ཁྱོད་ནི་བདག་གི་མདུན་དུ་སྡོད་ཅིག དེ་ནས་ངས་ཁྱོད་ལ་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས། སྲོལ་ཡིག་བཅས་ཐམས་ཅད་བསླབ་པར་བྱ། ངས་ཁོ་རྣམས་ལ་ས་སྐལ་དུ་སྦྱིན་པའི་ཡུལ་དེ་རུ་ཁོ་ཚོས་དེ་བཞིན་བསྒྲུབ་པའི་ཕྱིར། ཁྱོད་ཀྱིས་ཁོ་ཚོར་དེ་དག་འཁྲིད་དགོས་ཞེས་བཀའ་བསྩལ་བྱུང་།"]},{"type":"verse","number":32,"content":["དེའི་ཕྱིར་ཁྱོད་རྣམས་གཡས་གཡོན་གང་ལ་ཡང་མི་གཟུར་བར་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བསྩལ་པའི་བཀའ་ནང་བཞིན་བརྩི་སྲུང་ནན་མོ་བྱེད་དགོས།"]},{"type":"verse","number":33,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བགྲོད་དགོས་པར་བསྩལ་པའི་ལམ་ཀུན་ཏུ་བསྐྱོད་དགོས། དེ་ལྟར་བྱས་ན། ཁྱོད་རྣམས་འཚོ་ཞིང་བདེ་བར་འགྱུར་ལ། ཁྱོད་རྣམས་རང་གིས་བདག་པོ་རྒྱག་པའི་ཡུལ་དུ་ཡུན་ནས་ཡུན་དུ་གནས་ཐུབ་བོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/4.json","previousChapterAudioLinks":{},"numberOfVerses":33}