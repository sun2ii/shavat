{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":7,"content":[{"type":"heading","content":["མི་བདམས་པ།"]},{"type":"verse","number":1,"content":["ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་སོང་ནས་བདག་གིར་འཛིན་པའི་ཡུལ་དེ་ལ་འཁྲིད་པའི་ཚེ། མི་རིགས་མང་པོ་ཞིག་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་སྐྲོད་པར་འགྱུར། དེ་དག་ནི་ཁྱོད་རྣམས་ལས་གྲངས་ཀ་མང་ཞིང་སྟོབས་ཆེ་བའི་མི་རིགས་བདུན་ཏེ། ཧེད་པ་དང་། གིར་གས་པ་དང་། ཨེ་མོར་པ་དང་། ཀ་ན་ཨན་པ་དང་། ཕེ་རེ་ཟི་པ་དང་། ཧེ་བི་པ་དང་། ཡེ་བུ་སི་པ་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ཁྱོད་ཅག་གི་ལག་ཏུ་སྤྲད་ནས་ཁྱོད་ཅག་གིས་དེ་དག་ཕམ་པར་རྒྱག་པའི་དུས་སུ། ཁོ་རྣམས་རྩ་མེད་གཏོང་བ་ལས་ཁོ་རྣམས་དང་ཁ་ཆད་འཇོག་མི་རུང་ལ། ཁོ་རྣམས་དྲིན་གྱིས་སྐྱོང་ཡང་མི་རུང་།"]},{"type":"verse","number":3,"content":["ཁོ་ཚོ་དང་གཉེན་གྱི་འབྲེལ་བ་ཡང་འཛིན་མི་རུང་སྟེ། ཁྱོད་རྣམས་ཀྱི་བུ་མོ་ཁོ་ཚོའི་བུ་ལ་མནའ་མར་སྟེར་མི་རུང་ལ། ཁོ་ཚོའི་བུ་མོ་ཁྱོད་རྣམས་ཀྱི་བུ་ལ་མནའ་མར་ལེན་ཡང་མི་རུང་ངོ་། །"]},{"type":"verse","number":4,"content":["ཅི་ལ་ཞེ་ན། ཁོ་ཚོས་ཁྱོད་རྣམས་ཀྱི་བུ་བདག་དང་ཕྲལ་ནས་གཞན་པའི་ལྷ་རྣམས་ལ་བསྙེན་བཀུར་བྱེད་དུ་འཇུག་ངེས་ཡིན། དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་ཁྲོས་ཏེ་ཁྱོད་ཅག་མགྱོགས་པོར་མེད་པར་མཛད་ངེས།"]},{"type":"verse","number":5,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ཁོ་ཚོ་ལ་འདི་ལྟར་བྱེད་དགོས་ཏེ། དེ་དག་གི་མཆོད་ཁྲི་རྣམས་བཤིག་པ་དང་། རྡོ་སྐུ་རྣམས་དུམ་བུར་གཅོག་པ་དང་། ལྷ་མོ་ཨ་ཤེ་རཱའི་སྐུ་བརྙན་རྣམས་གཏུབ་པ་དང་། དེ་དག་གི་བརྐོས་པའི་སྐུ་འདྲ་རྣམས་མེ་ཡིས་བསྲེག་དགོས།"]},{"type":"verse","number":6,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ས་སྟེང་གི་མི་རིགས་ཐམས་ཅད་ལས། ཁྱོད་རྣམས་ནི་ཉིད་ཀྱི་ནོར་བུ་དང་ཉིད་ཀྱི་འབངས་མི་རུ་བདམས་ཤིང་། ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཚོན་ན་འབངས་མི་དམ་པ་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་རྣམས་ལ་བྱམས་ཤིང་ཁོང་གིས་ཁྱོད་རྣམས་འདེམས་དོན་ནི་ཁྱོད་ཅག་གི་མི་གྲངས་མི་རིགས་གཞན་ལས་མང་བས་མ་ཡིན་ཏེ། དོན་དམ་དུ་ཁྱོད་རྣམས་ཀྱི་མི་གྲངས་ནི་མི་རིགས་གཞན་ལས་ཉུང་བ་ཡིན་ལ།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་གཅེས་སུ་འཛིན་པ་དང་། ཁོང་གིས་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ལ་མནའ་བཞེས་པ་དེ་བསྒྲུབ་པའི་ཕྱིར། ཁོང་གི་མཐུ་སྟོབས་ཆེན་པོའི་ཕྱག་གིས་ཁྱོད་རྣམས་བྲན་དུ་བཀོལ་བའི་གནས་དང་ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་ལག་ནས་བསྐྱབས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["དེ་བས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དཀོན་མཆོག་ཡིན་པ་དང་། ཡིད་རྟོན་རུང་བའི་དཀོན་མཆོག་ཡིན་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་དགོས་ལ། ཁོང་གིས་ཁོང་ལ་མཉེས་པ་དང་ཁོང་གི་བཀའ་རྒྱ་སྲུང་མཁན་རྣམས་ལ། མི་རབས་སྟོང་གི་བར་དུ་ཞལ་ཆད་བསྲུང་ཞིང་བྱམས་བརྩེ་གནང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["འོན་ཀྱང་ཁོང་ལ་སྡང་མཁན་རྣམས་ལ་ཁ་རི་ཁ་ཐུག་ཏུ་ཡ་ལན་འཇལ་ཞིང་མེད་པར་གཏོང་བ་དང་། ཁོང་ལ་སྡང་མཁན་རྣམས་ལ་ཁ་རི་ཁ་ཐུག་ཏུ་འགོར་འགྱང་མེད་པར་ཡ་ལན་འཇལ་བ་ཡིན།"]},{"type":"verse","number":11,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ངས་དེ་རིང་ཁྱོད་ཅག་ལ་བསྒོས་པའི་བཀའ་རྒྱ་དང་སྒྲིག་ཁྲིམས། སྲོལ་ཡིག་རྣམས་གཟབ་གཟབ་ངང་བསྲུང་དགོས་སོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་སྲོལ་ཡིག་འདི་རྣམས་ལ་ཉན་ཞིང་བསྲུངས་ནས་དེ་བཞིན་བསྒྲུབས་ན། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་མེས་པོ་རྣམས་ལ་མནའ་བཞེས་པ་བཞིན་ཁྱོད་ཅག་ལ་ཞལ་ཆད་བསྲུངས་ནས་བྱམས་བརྩེ་གནང་ངེས་ཡིན།"]},{"type":"verse","number":13,"content":["ཁོང་ཁྱོད་རྣམས་ལ་བྱམས་ཤིང་ཁྱོད་རྣམས་ལ་བྱིན་རླབས་བསྩལ་ནས་ཁྱོད་ཅག་འཕེལ་བར་བྱེད་པ་དང་། ཡང་ཁོང་གིས་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ལ་ཁྱོད་ཅག་ལ་གནང་བར་མནའ་བཞེས་པའི་ཡུལ་དེ་རུ། ཁྱོད་རྣམས་ལས་སྐྱེས་པ་དང་། ཁྱོད་ཅག་གི་ས་ཡི་ལོ་ཏོག་ལ་བྱིན་རླབས་གནང་སྟེ། ཁྱོད་རྣམས་ཀྱི་འབྲུ་རིགས་དང་། རྒུན་ཆང་། སྣུམ་གསར་པ། བ་གླང་གི་འཕེལ་ཏོག ར་ལུག་གི་འཕེལ་ཀ་བཅས་མང་དུ་སྤེལ་ངེས་ཡིན།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ལ་མི་རིགས་ཀུན་ལས་ལྷག་པའི་བྱིན་རླབས་འཐོབ་པ་དང་། ཁྱོད་རྣམས་ཀྱི་སྐྱེས་པ་དང་བུད་མེད་ལ་ཕྲུ་གུ་མི་འཁོར་བ་མེད་ཅིང་། ཕྱུགས་ཟོག་ལ་ཕྱུགས་ཕྲུག་མི་སྐྱེས་པའང་མེད།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་ནད་ཐམས་ཅད་བསལ་བར་བྱ་སྟེ། ཁྱོད་རྣམས་ལ་རྒྱུས་ཡོད་པའི་ཨེ་ཅིབ་ཡུལ་གྱི་ནད་ཡམས་དག་ཁྱོད་རྣམས་ལ་འབྱུང་དུ་མི་འཇུག་པར། ནད་དེ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་སྡང་བ་ཀུན་གྱི་སྟེང་དུ་འགེལ་ངེས།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་སྤྲད་པའི་མི་རིགས་ཐམས་ཅད་ཁྱོད་རྣམས་ཀྱིས་རྩ་མེད་དུ་གཏོང་དགོས། ཁྱོད་རྣམས་ཀྱི་མིག་ལམ་ནས་དེ་དག་ལ་སྙིང་རྗེ་སྒོམ་མི་རུང་། དེ་ཚོའི་ལྷ་རྣམས་ལ་བསྙེན་བཀུར་ཡང་བྱེད་མི་འོས། གང་ལ་ཞེ་ན། དེ་ནི་ཁྱོད་ཅག་བསླུ་བྱེད་ཀྱི་རྙི་རྒྱ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་མི་རིགས་འདི་དག་ང་ཚོ་ལས་མང་བས་ངེད་ཅག་གིས་ཁོ་རྣམས་ཇི་ལྟར་སྐྲོད་དགོས་སྙམ་ན་ཡང་།"]},{"type":"verse","number":18,"content":["དེ་དག་ལ་འཇིགས་མི་དགོས། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཕཱར་ཨོལ་དང་ཨེ་ཅིབ་ཀྱི་ཡུལ་ཐམས་ཅད་ལ་ཇི་ལྟར་མཛད་པ་འབའ་ཞིག་དྲན་དགོས་ཏེ།"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་ཀྱིས་དངོས་སུ་མཐོང་བའི་ཚོད་བརྟག་ཆེན་པོ་དང་གྲུབ་རྟགས་དང་། དོན་ངོ་མཚར་ཅན་དང་། མཐུ་སྟོབས་ཆེན་པོའི་ཕྱག་དང་། ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་པ་བཅས་དྲན་དགོས། དེ་ཐམས་ཅད་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཕྱི་རུ་ཁྲིད་འོངས་པའི་དུས་སུ་མཛད་པ་ཡིན་ལ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་འཇིགས་པའི་མི་རིགས་ཐམས་ཅད་ལའང་དེ་བཞིན་མཛད་ངེས།"]},{"type":"verse","number":20,"content":["ཁོ་ཚོ་ལས་ཤུལ་དུ་ལུས་ཏེ་སྦས་པ་རྣམས་ཀྱང་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་མེད་པར་འགྲོ་བའི་བར་དུ། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་གི་དཀྱིལ་ལ་དུག་སྦྲང་མང་པོ་གཏོང་བར་བྱེད་དོ། །"]},{"type":"verse","number":21,"content":["དེ་དག་ལ་མ་འཇིགས་ཤིག ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་ཅག་གི་ཁྲོད་དུ་བཞུགས་ཤིང་། ཁོང་ནི་དབང་ཆེ་ཞིང་འཇིགས་རུང་བའི་དཀོན་མཆོག་དེ་ཡིན།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མི་རིགས་དེ་དག་ཁྱོད་ཅག་གི་སྔུན་ནས་རིམ་བཞིན་སྐྲོད་པར་མཛད། ཐང་གི་གཅན་གཟན་གཏུམ་པོའི་རིགས་མང་དུ་འཕེལ་ནས་ཁྱོད་རྣམས་ལ་གནོད་བསྐྱལ་ཉེན་ཡོད་པས་ཁྱོད་ཅག་གིས་ཁོ་རྣམས་མགྱོགས་པོར་ཚར་གཅོད་མི་རུང་།"]},{"type":"verse","number":23,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོ་འཇིག་པའི་བར་དུ་ཁོ་རྣམས་ཁྱོད་ཅག་ལ་སྤྲོད་ཅིང་ཁོ་ཚོ་མགོ་འཁོར་དུ་འཇུག་གོ །"]},{"type":"verse","number":24,"content":["ཡང་ཁོང་གིས་ཁོ་ཚོའི་རྒྱལ་པོ་རྣམས་ཀྱང་ཁྱོད་ཅག་གི་ལག་ཏུ་སྤྲོད་ཅིང་། ཁྱོད་རྣམས་ཀྱིས་དེ་དག་གི་མིང་གནམ་འོག་ནས་མེད་པར་བཟོ་བ་དང་། དེ་དག་ཚར་གཅོད་པའི་བར་དུ་ཁྱོད་ཅག་གི་མདུན་དུ་ཚུགས་ཐུབ་པའི་མི་གཅིག་ཀྱང་ཡོད་མི་སྲིད།"]},{"type":"verse","number":25,"content":["དེ་དག་གི་ལྷ་སྐུ་རྣམས་ཁྱོད་རྣམས་ཀྱིས་མེ་རུ་བསྲེག་དགོས་ཤིང་། ལྷ་སྐུའི་སྟེང་གི་གསེར་དངུལ་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཞེ་ལོག་པ་ཡིན་པས། ཁྱོད་ཅག་དེ་ལ་ཧམ་པ་སྐྱེས་ནས་རང་གིས་འཁྱེར་མི་རུང་། ཅི་ལ་ཞེ་ན། དེ་ནི་ཁྱོད་ཅག་བསླུ་བྱེད་ཀྱི་རྙི་རྒྱ་ཡིན།"]},{"type":"verse","number":26,"content":["ཡང་ཁྱོད་རྣམས་རྫས་མི་གཙང་བ་དེ་དང་འདྲ་བར་རྩ་མེད་དུ་གཏོང་བྱ་རུ་མི་འགྱུར་བའི་ཕྱིར། དེ་རང་གི་ཁྱིམ་དུ་འཁྱེར་མི་རུང་། དེ་ནི་རྩ་མེད་དུ་གཏོང་འོས་པའི་རྫས་ཡིན་པས་ཁྱོད་ཅག་དེ་ལ་ཤིན་ཏུ་སྡང་ནས་ཞེ་མེར་དགོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/6.json","previousChapterAudioLinks":{},"numberOfVerses":26}