{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"DEU","translationId":"bod_ntb","name":"བཀའ་ལུང་།","commonName":"བཀའ་ལུང་།","title":"༄༅། །བཀའ་ལུང་གི་མདོ།","order":5,"numberOfChapters":34,"sha256":"f86ca4c97cf26e99ae922239df7cc1ae40fa915cb9b1e0d3e82cf876382dbde3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bod_ntb/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":9,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱིས་དཀོན་མཆོག་གི་ཐུགས་དཀྲུགས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། ཁྱོད་ཅག་གིས་ཉོན་ཅིག དེ་རིང་ཁྱོད་རྣམས་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་སོང་ནས། ཁྱོད་ཅག་ལས་ཆེ་ཞིང་སྟོབས་དང་ལྡན་པའི་མི་རིགས་རྣམས་ཕྱི་རུ་བསྐྲད་དེ། སྲ་ཞིང་བརྟན་ལ་ནམ་མཁར་ཟུག་པའི་གྲོང་ཁྱེར་རྣམས་བདག་གིར་འཛིན་པར་འགྱུར།"]},{"type":"verse","number":2,"content":["སྟོབས་ཆེ་ཞིང་གཟུགས་པོ་རིང་བའི་ཨ་ནག་གི་བུ་རྒྱུད་དེ། མི་གཞན་གྱིས་ཨ་ནག་བུ་རྒྱུད་ཀྱི་མདུན་དུ་སུ་ཞིག་འགྲེང་བར་ནུས་སམ་ཟེར་བ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་ཤིང་ཐོས་པ་རྣམས་དབང་དུ་བསྡུ་དགོས།"]},{"type":"verse","number":3,"content":["དེ་བས་དེ་རིང་ཁྱོད་རྣམས་ཀྱིས་ཤེས་དགོས་པ་ཞིག་ལ། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡོད་ཚད་རྩ་མེད་གཏོང་བའི་མེ་བཞིན་ཁྱོད་རྣམས་ཀྱི་སྔུན་ནས་ཕར་ཕེབས་ཏེ་ཁོ་རྣམས་མེད་པར་མཛད་ཅིང་། ཁོང་གིས་ཁྱོད་རྣམས་ཀྱི་སྔུན་ནས་དེ་དག་འཇོམས་ངེས་ཡིན་ལ། དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་གསུངས་པ་ཇི་བཞིན་ཁྱོད་ཅག་གིས་དེ་དག་དེད་ནས་མྱུར་དུ་མེད་པར་བྱའོ། །"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཁྱོད་ཅག་གི་མདུན་ནས་སྤྱུགས་ཚེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཁྱོད་ཅག་གི་མདུན་ནས་སྤྱུགས་པ་ནི་ཁོ་ཚོའི་སེམས་ངན་པའི་དབང་གིས་ཡིན་གྱི། ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་ང་དྲང་པོ་ཡིན་པའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ལ་ཡུལ་འདིའི་བདག་དབང་གནང་བར་གནས་འདིར་ཁྲིད་པ་རེད་ཅེས་བསམ་པར་མི་བྱའོ། །"]},{"type":"verse","number":5,"content":["ཁྱོད་ཅག་ཁོ་རྣམས་ཀྱི་ཡུལ་བདག་གིར་འཛིན་པའི་ཕྱིར་དེར་འགྲོ་བ་ནི་ཁྱོད་རྣམས་དྲང་ཞིང་སེམས་ཡག་པས་མ་ཡིན་གྱི། མི་རིགས་དེ་དག་གི་སེམས་ངན་པའི་རྐྱེན་གྱིས། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་མེས་པོ་ཨབ་ར་ཧམ་དང་ཨི་སཱག་དང་། ཡ་ཀོབ་བཅས་ལ་མནའ་དང་བཅས་ཞལ་བཞེས་གནང་ཡོད་པ་བསྒྲུབ་ཆེད། ཁོ་ཚོ་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་སྤྱུགས་པ་རེད།"]},{"type":"verse","number":6,"content":["དེ་བས་ཁྱོད་རྣམས་དྲང་པོ་ཡིན་པའི་རྒྱུ་མཚན་གྱིས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་བཟང་པོ་དེ་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་གནང་བ་མ་ཡིན་པ་ཤེས་པར་གྱིས། དོན་དམ་དུ་ཁྱོད་ཅག་ནི་མི་རིགས་གཉའ་རེངས་ཤིག་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱིས་དབེན་སྟོང་ནས་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས་པ་དེ་བརྗེད་པར་མི་བྱ་བར་དྲན་པར་གྱིས། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་ཏེ་གནས་འདིར་མ་སླེབས་བར་དུ། ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ངོ་རྒོལ་བྱས་ཡོད།"]},{"type":"verse","number":8,"content":["རི་བོ་ཧོ་རེབ་ནས་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་ཁྲོས་ནས་ཁྱོད་ཅག་མེད་པར་གཏོང་བའི་ཚད་ལ་སླེབས།"]},{"type":"verse","number":9,"content":["སྐབས་དེར་ང་རང་དཀོན་མཆོག་ཡ་ཝཱེས་གནང་བའི་ཞལ་ཆད་ཀྱི་རྡོ་ལེབ་གཉིས་ལེན་དུ་རི་ལ་འགོས་པ་དང་། ང་རི་མགོར་ཉིན་མཚན་བཞི་བཅུའི་རིང་ལ་བསྡད་ཀྱང་བག་ལེབ་མ་ཟོས། ཆུ་ཡང་མ་འཐུངས།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རྡོ་ལེབ་གཉིས་ང་ལ་གནང་བ་དང་། དེ་ནི་དཀོན་མཆོག་གི་ཕྱག་མཛུབ་ཀྱིས་བྲིས་པ་ཡིན། རྡོ་ལེབ་ཀྱི་སྟེང་དུ་འདུ་འཛོམས་ཉིན་མོར་དཀོན་མཆོག་ཡ་ཝཱེས་རི་རྩེའི་མེའི་དཀྱིལ་ནས་ཁྱོད་རྣམས་ལ་བསྩལ་པའི་བཀའ་ཐམས་ཅད་བཀོད་ཡོད།"]},{"type":"verse","number":11,"content":["ཉིན་མཚན་བཞི་བཅུའི་རྗེས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ཞལ་ཆད་ཀྱི་རྡོ་ལེབ་དེ་གཉིས་ང་ལ་གནང་བྱུང་།"]},{"type":"verse","number":12,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ལོངས་ལ་མགྱོགས་པོར་མར་སོང་ཞིག ཅི་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པའི་མི་མང་གིས་ལོག་སྤྱོད་སྤེལ་ཏེ། བདག་གིས་ཁོ་ཚོར་བསྒོས་པའི་ལམ་ནས་མགྱོགས་པོར་ལོག་པར་ཕྱིན་ཏེ་རང་གི་ཆེད་དུ་བླུགས་སྐུ་བཟོས་འདུག་ཅེས་གསུངས་སོ། །"]},{"type":"heading","content":["གསེར་གྱི་བ་ཕྲུག"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡང་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ལྟོས་དང་ངས་མི་འདི་རྣམས་དངོས་གནས་མི་གཉའ་རེངས་ཤིག་ཡིན་པར་མཐོང་ངོ་། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ཀྱིས་སྐྱུར་དང་། བདག་གིས་དེ་དག་མེད་པར་གཏོང་ཞིང་། དེ་དག་གི་མིང་གནམ་འོག་ནས་མེད་པར་བྱ། ཁྱོད་ནི་ཁོ་ཚོ་ལས་མི་རིགས་སྟོབས་དང་ལྡན་ཞིང་ཆེན་པོ་ཞིག་ཏུ་བྱེད་པར་བྱ་ཞེས་བཀའ་བསྩལ་བྱུང་།"]},{"type":"verse","number":15,"content":["དེ་བས་ང་ཕྱིར་འཁོར་ཏེ་རི་ལས་འབབ་དུས་རི་མགོར་མེ་འབར་བཞིན་ཡོད་ལ། ཞལ་ཆད་ཀྱི་རྡོ་ལེབ་གཉིས་ངའི་ལག་ཏུ་ཡོད།"]},{"type":"verse","number":16,"content":["དེར་ངས་བལྟས་པ་ལ། ཁྱོད་ཅག་གིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱས་ནས། རང་གི་ཆེད་དུ་བ་ཕྲུག་ཅིག་གི་སྐུ་བརྙན་བླུགས་ཤིང་། མགྱོགས་པོར་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་དེའི་ནང་འགྲུལ་དགོས་པར་བཀའ་བསྩལ་པའི་ལམ་དང་བྲལ་བ་མཐོང་བྱུང་།"]},{"type":"verse","number":17,"content":["དེ་བས་ངས་རྡོ་ལེབ་དེ་གཉིས་བཟུང་སྟེ་ལག་པ་གཉིས་ལས་ཕར་གཡུགས་ཤིང་། ཁྱོད་ཅག་གི་མིག་ལམ་ནས་བཅག་པ་ཡིན།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་སྤྱད་ནས་ཁོང་གི་ཐུགས་དཀྲུགས་ཤིང་བསགས་པའི་སྡིག་པ་ཀུན་གྱི་དོན་དུ། ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ལུས་སར་བཏུད་ནས་སྔོན་ཆད་ནང་བཞིན་ཉིན་མཚན་བཞི་བཅུའི་རིང་ལ་བག་ལེབ་མ་ཟོས། ཆུ་ཡང་མ་འཐུངས།"]},{"type":"verse","number":19,"content":["ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་རབ་ཏུ་ཁྲོས་ཏེ་ཁྱོད་ཅག་མེད་པར་གཏོང་རྩིས་བྱས་པ་དང་ང་རང་ཤིན་ཏུ་འཇིགས་པ་ཡིན། འོན་ཀྱང་ཐེངས་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡང་ངའི་ཞུ་བར་གསན་བྱུང་།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་ཨ་རོན་ལའང་ཐུགས་ཤིན་ཏུ་ཁྲོས་པས་ཁོ་མེད་པར་གཏོང་རྩིས་བྱས་ཤིང་། དུས་དེར་ངས་ཨ་རོན་གྱི་དོན་དུ་ཡང་སྨོན་ལམ་བཏབ་པ་ཡིན།"]},{"type":"verse","number":21,"content":["དེ་ནས་ངས་ཁྱོད་ཅག་གི་སྡིག་པ་སྟེ་ཁྱོད་རྣམས་ཀྱིས་བླུགས་པའི་བ་ཕྲུག་ཁྱེར་ནས། དེ་མེ་ལ་བསྲེགས་ནས་ཚར་བཅད་པ་དང་རྡུལ་དུ་བཏགས་པ་ཡིན། དེའི་རྡུལ་ཐལ་ནི་རི་ལས་འབབ་པའི་ཆུ་ལ་བཏབ་པ་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["ཡང་ཐབ་ཨེ་རཱ་དང་མཱ་སཱ་དང་། ཀིབ་རོད་ཧད་ཐཱ་ཨ་ཝ་བྱ་བའི་གནས་སུ་ཁྱོད་རྣམས་ཀྱིས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དཀྲུགས།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཚོ་ཀཱ་དེའེ་ཤཱ་པར་ནེ་ཨ་ནས་མངགས་པའི་དུས་སུ། ཁྱོད་རྣམས་ཡར་སོང་ནས་ངས་ཁྱོད་ཅག་ལ་ས་སྐལ་དུ་སྦྱིན་པའི་ཡུལ་དེ་ལོངས་ཤིག་ཅེས་བཀའ་བསྩལ་ཡང་། ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་དང་འགལ་ནས་ཁོང་ལ་དད་གུས་མ་བྱས། ཁོང་གི་གསུང་སྐད་ལའང་མ་མཉན།"]},{"type":"verse","number":24,"content":["ངས་ཁྱོད་ཚོ་ངོ་ཤེས་པའི་ཉིན་དེ་ནས་བཟུང་ཁྱོད་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ངོ་ལོག་བྱས་ཡོད་དོ། །"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་མེད་པར་བྱ་གསུངས་པས། བསྡོམས་པས་ཉིན་མཚན་བཞི་བཅུའི་རིང་ལ་ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལུས་སར་བཏུད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ངས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་འདི་ལྟར་བཏབ་པ་སྟེ། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་བདག་ཏུ་མཛད་པའི་འབངས་མི་དང་ནོར་སྐལ་ཏེ། ཁྱེད་ཀྱིས་ནུས་མཐུ་ཆེན་པོས་བསྐྱབས་ཤིང་། ཁྱེད་ཀྱི་མཐུ་སྟོབས་ལྡན་པའི་ཕྱག་གིས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པ་དེ་མེད་པར་མི་མཛད་རོགས།"]},{"type":"verse","number":27,"content":["ཁྱེད་ཀྱི་ཞབས་ཕྱི་ཨབ་ར་ཧམ་དང་ཨི་སཱག་དང་། ཡ་ཀོབ་རྣམས་ཐུགས་སུ་དྲན་པར་མཛོད་ཅིག མི་འདི་རྣམས་ཀྱི་གཉའ་རེངས་དང་ངན་རུལ། སྡིག་པ་བཅས་ལ་མི་གཟིགས་པར་མཛོད།"]},{"type":"verse","number":28,"content":["དེ་ལྟར་མིན་ཚེ་ཁྱེད་ཀྱིས་ང་ཚོ་ཕྱི་རུ་ཁྲིད་འོངས་སའི་ཡུལ་དེའི་ཡུལ་མི་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོ་ཁོང་གིས་ཞལ་གྱིས་བཞེས་པའི་ཡུལ་དུ་འཁྲིད་མ་ནུས་པ་དང་། ཡང་དེ་དག་ལ་སྡང་བའི་རྐྱེན་གྱིས་ཁོང་གིས་དེ་ཚོ་དབེན་སྟོང་ནས་འཆི་རུ་འཇུག་ཕྱིར་ཕྱི་རུ་ཁྲིད་པ་རེད་ཅེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":29,"content":["ཁོ་ཚོ་ནི་ཁྱེད་ཀྱི་འབངས་མི་དང་ནོར་སྐལ་ཏེ། ཁྱེད་ཀྱིས་མཐུ་སྟོབས་ཆེན་པོའི་ཕྱག་དང་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་པ་ཡིས་ཕྱི་རུ་ཁྲིད་འོངས་པ་ཡིན་ཞེས་ཞུས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/DEU/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DEU/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/DEU/8.json","previousChapterAudioLinks":{},"numberOfVerses":29}