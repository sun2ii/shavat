{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ECC","translationId":"bod_ntb","name":"སྟོན་པ།","commonName":"སྟོན་པ།","title":"༄༅། །སྟོན་པའི་མདོ།","order":21,"numberOfChapters":12,"sha256":"60f16e8362f300bbe64a9e5fded23a441542162a149147e069a87f1c578a8fa3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":2,"content":[{"type":"heading","content":["བདེ་སྐྱིད་ལ་རོལ་བ་ནི་སྟོང་པ་ཡིན་པ།"]},{"type":"verse","number":1,"content":["ངས་རང་གི་སེམས་ལ་འདི་ལྟར། ཤོག་དང་། ངས་ཁྱོད་ལ་དགའ་སྤྲོས་དཔྱོད་ཅིང་ཕན་ཐོགས་ཅི་ཞིག་ཡོད་པར་བལྟ་རུ་འཇུག་བསམས་ཀྱང་། འདི་ཡང་སྟོང་པ་ཡིན་ཏེ།"]},{"type":"verse","number":2,"content":["གད་མོ་ལ་བདག་གིས་དེ་ནི་ཁེངས་དྲེགས་ཡིན་པར་སྨྲས། ལོངས་སྤྱོད་གླེང་ན་དེར་ཕན་ནུས་ཅི་ཡོད་དམ།"]},{"type":"verse","number":3,"content":["བདག་གིས་མི་ནི་ཅི་འདྲ་ཡིན་པ་གསལ་པོར་ངེས་པ་དང་། གནམ་འོག་ཏུ་མི་ཚེ་ཐུང་ཐུང་གི་ལོ་ཟླའི་ཁྲོད་དུ་དོན་གང་ཞིག་ལེགས་པོ་ཡིན་པ་རྟོགས་པའི་བར་དུ། རྒུན་ཆང་གིས་རང་གི་ལུས་སྐྱིད་པར་བྱས་ནས་བླུན་པོ་ལྟར་སྤྱོད་པར་བསམ་བློ་བཏང་མོད་ཀྱང་། ངའི་ཤེས་རབ་ཀྱིས་ང་ལ་ལམ་བསྟན་ཏོ། །"]},{"type":"verse","number":4,"content":["ངས་ལས་ཀ་ཆེན་པོ་རྣམས་བྱས་ཏེ། རང་གི་ཕྱིར་ཕོ་བྲང་རྣམས་བཞེངས་ནས་རྒུན་ཚལ་རྣམས་བཙུགས།"]},{"type":"verse","number":5,"content":["མེ་ཏོག་ལྡུམ་ར་དང་སྐྱེད་མོས་ཚལ་རྣམས་བཟོས་ཏེ། དེ་དག་གི་ནང་དུ་སིལ་སྡོང་སྣ་ཚོགས་བཙུགས།"]},{"type":"verse","number":6,"content":["ངས་ནགས་ཚལ་གྱི་ལྗང་བུ་རྣམས་ལ་ཆུ་གཏོང་བའི་ཆེད་དུ་རྫིང་བུ་རྣམས་ཀྱང་བཟོས།"]},{"type":"verse","number":7,"content":["ངས་གཡོག་པོ་གཡོག་མོ་གཞན་ཡང་ཉོས་ལ། རང་ཁྱིམ་དུ་སྐྱེས་པའི་བྲན་གཡོག་ཀྱང་ཡོད། ཡང་སྔོན་ཆད་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པ་ཀུན་ལས་ཀྱང་བདག་ལ་སྒོ་ཕྱུགས་མང་པོ་ཡོད།"]},{"type":"verse","number":8,"content":["ཡང་ངས་གསེར་དངུལ་དང་། རྒྱལ་པོ་དང་སྡེ་རྣམས་ཀྱི་གཏེར་མཛོད་རྣམས་ཀྱང་རང་གི་ཕྱིར་བསགས་པར་མ་ཟད། གླུ་བ་གླུ་མ་རྣམས་དང་། མི་རྣམས་དུང་བའི་དངོས་པོ་དང་། བཙུན་མོ་རྣམས་ཀྱང་རང་གི་ཕྱིར་བསྡུས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["དེ་ལྟར་བདག་ནི་ཉིན་རེར་རྒྱས་པ་དང་། སྔོན་ཆད་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པ་ཀུན་ལས་ཀྱང་ལྷག་པར་དར་ཏེ། ངའི་ཤེས་རབ་ནི་ད་དུང་ངའི་ནང་དུ་ལུས་སོ། །"]},{"type":"verse","number":10,"content":["ངས་རང་གི་མིག་གིས་མཐོང་འདོད་པ་ཐམས་ཅད་ལ་བལྟས་ཤིང་། སྐྱིད་པར་བསམས་པ་གང་ལས་ཀྱང་རང་གི་སེམས་ནི་མ་བཀག ཅིའི་ཕྱིར་ཞེ་ན། ངའི་སེམས་ནི་རང་གི་དཀའ་ལས་ཐམས་ཅད་ལ་དགའ་ཞིང་། འདི་ནི་ངས་བྱས་པའི་དཀའ་ལས་ཐམས་ཅད་ནས་ཐོབ་པའི་སྐལ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་ངས་རང་བྱས་ཀྱི་ལས་དང་དཀའ་ལས་ཀྱི་འབྲས་བུ་ཐམས་ཅད་ལ་བལྟས་པ་དང་། ཀྱེ་ཧོ། དེ་ཐམས་ཅད་ནི་སྟོང་པ་དང་རླུང་ལ་ཞགས་པ་འཕེན་པ་ཙམ་ཡིན། ཉི་མའི་འོག་ཏུ་དེ་ལ་ཕན་ཐོགས་ཅི་ཡང་མེད།"]},{"type":"verse","number":12,"content":["དེ་ནས་ངས་ཤེས་རབ་དང་ཁེངས་དྲེགས། བླུན་རྨོངས་བཅས་ཀྱི་ཕྱོགས་སུ་བློ་ཁ་བསྒྱུར་པ་ཡིན། སྔར་ནས་བྱས་ཟིན་པ་དེ་ལས་གཞན། རྒྱལ་པོའི་རྗེས་སུ་འབྱུང་བ་རྣམས་ཀྱིས་གཞན་ཅི་ཞིག་བྱེད་ནུས་སམ།"]},{"type":"verse","number":13,"content":["དེ་ནས་འོད་ནི་མུན་པ་ལས་བརྒལ་བ་ལྟར། ཤེས་རབ་ནི་བླུན་རྨོངས་ལས་བརྒལ་བ་ངས་རྟོགས་བྱུང་།"]},{"type":"verse","number":14,"content":["མཁས་པ་ལ་ནི་ཤེས་རབ་ཀྱི་སྤྱན་དང་ལྡན། བླུན་པོ་ནི་མུན་པའི་ནང་དུ་འགྲུལ་བ་ཡིན། འོན་ཀྱང་དེ་གཉིས་ཀྱི་སྔོན་ལས་གཅིག་ཡིན་པ་ངས་རྟོགས་བྱུང་།"]},{"type":"verse","number":15,"content":["ངའི་སེམས་སུ་འདི་ལྟར། བླུན་པོ་ལ་འབྱུང་བ་བཞིན་དུ་བདག་ལའང་འབྱུང་བར་འགྱུར་བས། བདག་རབ་ཏུ་མཁས་པར་འགྱུར་དགོས་དོན་ཅི་ཡོད་སྙམ་པ་དང་། ཡང་ངའི་སེམས་སུ་འདི་ཡང་སྟོང་པ་ཡིན་བསམས་པའོ། །"]},{"type":"verse","number":16,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མཁས་བླུན་གཉིས་ཀ་གཅིག་ཡིན་ཏེ་སུ་ཞིག་གིས་ཀྱང་ཁོ་རྣམས་དུས་རྟག་ཏུ་དྲན་པར་མི་བྱེད་ལ། མ་འོངས་པའི་དུས་སུ་ཐམས་ཅད་བརྗེད་པར་འགྱུར་བས། བླུན་པོ་ནང་བཞིན་མཁས་པ་ཡང་འཆི་བར་ངེས།"]},{"type":"verse","number":17,"content":["དེའི་རྐྱེན་གྱིས་ཉི་མའི་འོག་ཏུ་བྱེད་པའི་ལས་ནི་སྡུག་བསྔལ་དུ་མཐོང་བས་ང་རང་ཚེ་སྲོག་ལ་སྡང་བ་ཡིན། ཐམས་ཅད་སྟོང་པ་ཡིན་པ་དང་། རླུང་ལ་ཞགས་པ་འཕེན་པ་ཙམ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["དེར་མ་ཟད། ཉི་མའི་འོག་ཏུ་བྱས་པའི་དཀའ་ལས་ཐམས་ཅད་ལའང་ང་རང་སྡང་སྟེ། ཅིའི་ཕྱིར་ཞེ་ན། ངས་དེ་རྣམས་མི་རབས་རྗེས་མའི་དོན་དུ་འཇོག་དགོས་པས་སོ། །"]},{"type":"verse","number":19,"content":["ཡང་དེ་ནི་མཁས་པའམ་ཡང་ན་བླུན་པོ་ཡིན་པ་སུས་ཤེས། འོན་ཀྱང་ངས་སྤྱད་པའི་དཀའ་བ་ཐམས་ཅད་དང་། གང་གི་དོན་དུ་ཉི་མའི་འོག་ཏུ་རང་གི་ཤེས་རབ་ལ་བརྟེན་ནས་ཐོབ་པ་ལ་དེས་དབང་བསྒྱུར་བས་ན་འདི་ཡང་སྟོང་པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེའི་ཕྱིར་ཉི་མའི་འོག་ཏུ་ངས་སྤྱད་པའི་དཀའ་བ་ཐམས་ཅད་ལ་ང་རང་ཡིད་ཐང་ཆད་དོ། །"]},{"type":"verse","number":21,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཤེས་རབ་དང་ཤེས་བྱ། རིག་རྩལ་བཅས་ལ་བརྟེན་ནས་ཐོབ་པའི་རང་གི་ཡོད་ཚད་ནི། མཐར་དཀའ་བ་ཅི་ཡང་མ་སྤྱད་པའི་མི་ལ་ནོར་སྐལ་དུ་འཇོག་དགོས་པའི་ཕྱིར། འདི་ཡང་སྟོང་པ་ཡིན་པ་སྟེ་སེམས་སྡུག་ཆེན་པོ་ཞིག་གོ །"]},{"type":"verse","number":22,"content":["ཉི་མའི་འོག་ཏུ་སེམས་ཁུར་ངང་སྤྱད་པའི་དཀའ་བ་ཐམས་ཅད་ནས་མི་ལ་ཅི་ཞིག་འཐོབ་པ་ཡིན་ནམ།"]},{"type":"verse","number":23,"content":["ཁོས་ཉིན་རེར་སྡུག་བསྔལ་མྱངས་པས། ཁོའི་དཀའ་ངལ་སེམས་སྡུག་ཏུ་གྱུར་ཏེ། ཁོའི་སེམས་ནི་མཚན་མོར་ཡང་ལྷོད་ལ་མ་བབས་པས། འདི་ཡང་སྟོང་པ་ཡིན་ནོ། །"]},{"type":"verse","number":24,"content":["བཟའ་བཏུང་དང་རང་གི་དཀའ་ལས་ཀྱི་ནང་དུ་ཡིད་ཚིམ་པ་ལས་ལྷག་པ་ཞིག་མི་ལ་མེད་དེ། དེ་ཡང་དཀོན་མཆོག་གི་ཕྱག་གིས་གནང་བ་ངས་མཐོང་ངོ་། །"]},{"type":"verse","number":25,"content":["བཟའ་བཏུང་དང་ལོངས་སྤྱོད་གླེང་ན། སུ་ཞིག་བདག་ལས་ལྷག་པ་ཡིན་ནམ།"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་སུ་ལ་ཐུགས་མཉེས་ན་ཁོང་གིས་དེ་ལ་ཤེས་རབ་དང་ཤེས་བྱ། དགའ་སྤྲོ་བཅས་གནང་བ་དང་། སྡིག་ཅན་ལ་ཅི་གནང་ཞེ་ན། དཀའ་སྡུག་གནང་བར་མ་ཟད། དེ་རྣམས་ཀྱིས་བསགས་པའི་རྒྱུ་ནོར་ཐམས་ཅད་ཀྱང་དཀོན་མཆོག་ཐུགས་མཉེས་པ་ལ་ནོར་སྐལ་དུ་གཏོང་ངོ་། །འདི་ཡང་སྟོང་པ་ཡིན་པ་དང་རླུང་ལ་ཞགས་པ་འཕེན་པ་ཙམ་ལས་མ་འདས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ECC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ECC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ECC/1.json","previousChapterAudioLinks":{},"numberOfVerses":26}