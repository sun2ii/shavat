{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ECC","translationId":"bod_ntb","name":"སྟོན་པ།","commonName":"སྟོན་པ།","title":"༄༅། །སྟོན་པའི་མདོ།","order":21,"numberOfChapters":12,"sha256":"60f16e8362f300bbe64a9e5fded23a441542162a149147e069a87f1c578a8fa3","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bod_ntb/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["མཁས་བླུན་གཉིས་ཀྱི་ཁྱད་པར།"]},{"type":"verse","number":1,"content":["ཕུལ་དུ་བྱུང་བའི་བྱུག་སྣུམ་ལས། ། མཚན་དང་སྙན་གྲགས་རྒྱས་པ་ལེགས། ། སྐྱེས་དུས་ལས་ནི་འཆི་དུས་ལེགས། །"]},{"type":"verse","number":2,"content":["སྟོན་མོའི་ཁྱིམ་དུ་འགྲོ་བ་ལས། ། མྱ་ངན་བྱེད་སར་འགྲོ་བ་ལེགས། ། གང་ལ་ཞེ་ན་འཆི་བ་ནི། ། མི་བུ་ཀུན་གྱི་མཐའ་འབྲས་ཡིན། ། གསོན་པོ་རྣམས་ཀྱིས་དོན་དེ་ཉིད། ། རྟག་ཏུ་ཡིད་ལ་ངེས་དགོས་སོ། །"]},{"type":"verse","number":3,"content":["དགའ་བ་ལས་ནི་སྐྱོ་བ་ལེགས། ། རྒྱུ་མཚན་སྐྱོ་བའི་ངོ་གདོང་གིས། ། མི་ཡི་སེམས་ལ་ཕན་ཐོགས་སོ། །"]},{"type":"verse","number":4,"content":["མཁས་པའི་སེམས་ནི་མྱ་ངན་ཁྱིམ་དུ་ཡོད། ། བླུན་པོའི་སེམས་ནི་སྤྲོ་སྐྱིད་ཁྱིམ་དུ་ཡོད། །"]},{"type":"verse","number":5,"content":["བླུན་པོའི་བསྟོད་གླུར་ཉན་པ་ལས། ། མཁས་པའི་བཀའ་བཀྱོན་ཐོས་ན་ལེགས། །"]},{"type":"verse","number":6,"content":["བླུན་པོ་གད་མོ་དགོད་པའི་སྒྲ། ། ཚེར་མ་མེ་ལ་བསྒྲོན་དང་མཚུངས། ། དེ་ལ་སྙིང་པོ་གང་ཡང་མེད། །"]},{"type":"verse","number":7,"content":["བཙན་འཕྲོག་གིས་ནི་མཁས་པ་བླུན་པོར་བསྒྱུར། ། ལྐོག་རྔན་གྱིས་ནི་མི་སེམས་བརླག་པར་བྱེད། །"]},{"type":"verse","number":8,"content":["དོན་གྱི་ཐོག་མ་ལས་ནི་ཕུགས་འབྲས་ལེགས། ། ང་རྒྱལ་ལས་ནི་བཟོད་སྒོམ་བྱེད་པ་ལེགས། །"]},{"type":"verse","number":9,"content":["ཁོང་ཁྲོ་བླུན་པོའི་སེམས་སུ་གནས་པས་ན། ། རང་སེམས་རང་དགར་ཁྲོ་བར་མི་བྱ་འོ། །"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་སྔ་མའི་དུས་ནི་ད་ལྟ་ལས། ། ལེགས་པ་ཅི་ཞིག་ཡིན་ནམ་མ་ཟེར་ཞིག ། དེ་བཞིན་འདྲི་བ་མཁས་རྟགས་མ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["ཤེས་རབ་དང་ནི་ནོར་སྐལ་གཉིས་ཀ་བཟང་། ། ཉི་མ་མཐོང་བ་དག་ལ་ཕན་ཐོགས་ཆེ། །"]},{"type":"verse","number":12,"content":["རྒྱུ་ཡིས་མི་ནི་སྲུང་བ་ལྟར། ། ཤེས་རབ་ཀྱིས་ཀྱང་བསྲུང་བར་མཛད། ། དེ་ཡང་ཤེས་རབ་འབའ་ཞིག་གིས། ། ཤེས་རབ་དང་ནི་ལྡན་པ་ཡི། ། ཚེ་སྲོག་གཅེས་སྲུང་མཛད་ནུས་ཤིང་། ། དེ་ནི་ཤེས་བྱའི་ཕན་ཡོན་ཡིན། །"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་མཛད་པར་ཞིབ་ཏུ་ལྟོས། ། ཁོང་གིས་གང་ཞིག་བཀུག་པ་དེ། ། སུ་ཡིས་བསྲང་བར་བྱ་ནུས་སམ། །"]},{"type":"verse","number":14,"content":["བདེ་བླག་ཡིན་པའི་དུས་སུ་དགའ་བར་གྱིས། ། དཀའ་སྡུག་མྱོང་བའི་དུས་སུ་བསམ་བློ་ཐོངས། ། དཀོན་མཆོག་ཉིད་ཀྱིས་འདི་གཉིས་འབྱུང་བར་མཛད། ། མི་ཡིས་འབྱུང་འགྱུར་མི་ཤེས་ཆེད་དུ་ཡིན། །"]},{"type":"verse","number":15,"content":["དྲང་བདེན་ཅན་ནི་དྲང་བདེན་ནང་དུ་འཆི་བ་དང་། ངན་པས་སྡིག་པའི་ནང་དུ་མི་ཚེ་བཏང་ནས་ཚེ་ལོ་མཐར་ཕྱིན་པ་ཐམས་ཅད་ངས་སྙིང་པོ་མེད་པའི་མི་ཚེ་ལ་རོལ་བའི་དུས་སུ་མཐོང་བྱུང་།"]},{"type":"verse","number":16,"content":["དྲང་བདེན་ཚད་ལས་བརྒལ་དུ་མ་འཇུག སྤྱང་གྲུང་ཚད་ལས་བརྒལ་དུའང་མ་འཇུག རང་གིས་རང་ཉིད་འཕུང་བར་ཅི་ལ་བྱེད།"]},{"type":"verse","number":17,"content":["ཚོད་མེད་པར་སྤྱོད་ངན་མ་བྱེད། བླུན་པོར་མ་གྱུར་ཅིག དུས་མ་སླེབས་པར་འཆི་དགོས་དོན་ཅི་ཡོད།"]},{"type":"verse","number":18,"content":["འདི་བསྲུང་བར་མ་ཟད་གཞན་དེ་ཡང་ལག་པས་མ་ལྷོད་ཅིག ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ལ་གུས་ཤིང་འཇིགས་པ་རྣམས་ནི་འདི་གཉིས་ལ་གཡོལ་ངེས་ཡིན།"]},{"type":"verse","number":19,"content":["ཤེས་རབ་ཀྱིས་ནི་གྲོང་ཁྱེར་ལ་ཡོད་པའི་འགོ་དཔོན་བཅུ་ལས་མཁས་པ་ལ་ནི་ལྷག་པར་སྟོབས་དང་ལྡན་པར་བྱེད།"]},{"type":"verse","number":20,"content":["ས་སྟེང་དུ་རྟག་ཏུ་བཟང་པོ་བྱེད་ཅིང་ཉེས་པ་གང་ཡང་མི་བྱེད་པའི་མི་དྲང་པོ་ནི་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":21,"content":["གཏམ་ཐམས་ཅད་ལ་དོ་སྣང་མ་བྱེད་ཅིག ཇི་སྟེ་བྱས་ན་གཡོག་པོས་ཁྱོད་ལ་ངན་སྨྲ་བ་ཐོས་པར་འགྱུར།"]},{"type":"verse","number":22,"content":["དེ་ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱིས་ཀྱང་ལན་དུ་མར་གཞན་ལ་དེ་བཞིན་དུ་ངན་སྨྲས་པ་ནི་ཁྱོད་རང་གི་སེམས་ཀྱིས་ཤེས་སོ། །"]},{"type":"verse","number":23,"content":["ངས་དེ་སྔར་འདི་ཐམས་ཅད་ལ་ཤེས་རབ་ཀྱི་སྒོ་ནས་དཔྱད་པ་ཡིན། ང་མཁས་པར་འགྱུར་འདོད་ཅེས་སྨྲས་ཀྱང་། དེ་ནི་ང་དང་རྒྱང་རིང་དུ་མཆིས་ཏེ།"]},{"type":"verse","number":24,"content":["བྱ་བ་ཡོད་ཚད་རབ་ཏུ་རྒྱང་རིང་ཞིང་ཤིན་ཏུ་གཏིང་ཟབ་པས། སུ་ཞིག་གིས་དེ་རྟོགས་ནུས་སམ།"]},{"type":"verse","number":25,"content":["ངས་རང་གི་བློ་ཁ་བསྒྱུར་ཏེ། སེམས་གཏིང་ནས་ཤེས་རབ་དང་བྱ་བ་ཡོད་ཚད་ཀྱི་འབྱུང་རྐྱེན་རྟོགས་འདོད་པ་དང་དཔྱོད་འདོད་པ། བཙལ་འདོད་པ་ཡིན། ཡང་བླུན་པོའི་ལུགས་ནི་ངན་པ་དང་། ཁེངས་དྲེགས་ནི་བླུན་རྨོངས་ཡིན་པ་རྟོགས་འདོད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ཡང་ངས་བུད་མེད་ལ་ལ་ནི་འཆི་བ་ལས་ཀྱང་ཁ་ཏིག་ཡིན་པ་དང་། སེམས་ནི་རྙི་རྒྱ་དང་ལག་པ་ནི་ལྕགས་ཐག་ལྟ་བུ་ཡིན་པ་རྟོགས་ཤིང་། དཀོན་མཆོག་ཐུགས་མཉེས་པ་རྣམས་ནི་མོ་ལས་ཐར་བ་དང་། སྡིག་ཅན་རྣམས་ནི་མོས་འཛིན་པར་འགྱུར།"]},{"type":"verse","number":27,"content":["ཀྱེ་ཧོ་སྟོན་པས་འདི་སྐད་དུ། ངས་མཐར་ཐུག་དེ་རྟོགས་པའི་དོན་དུ་རེ་རེ་བཞིན་བསྡུར་ནས་བརྩད་ཆོད་པ་ནི། བྱ་བ་ཡོད་ཚད་ཀྱི་འབྱུང་རྐྱེན་ཤེས་འདོད་པ་ཡིན་ཏེ།"]},{"type":"verse","number":28,"content":["ད་ཙམ་གྱི་བར་དུ་ངའི་སེམས་ཀྱིས་བཙལ་ཡང་མ་ཐོབ། སྐྱེས་པ་སྟོང་ཕྲག་གི་ནང་ནས་གཞུང་དྲང་གཅིག་རང་ངས་རྙེད་ཀྱང་། བུད་མེད་ཐམས་ཅད་ལས་གཞུང་དྲང་གཅིག་ཀྱང་རྙེད་མ་བྱུང་།"]},{"type":"verse","number":29,"content":["དཀོན་མཆོག་གིས་མི་ནི་དྲང་པོར་བཀོད་ཀྱང་། དེ་དག་གིས་བྱུས་ངན་མང་པོ་བཙལ་ཡོད་པ་ཁོ་ན་ངས་རྙེད་པ་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}