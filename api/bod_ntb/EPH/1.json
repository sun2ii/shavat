{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EPH","translationId":"bod_ntb","name":"ཨེ་ཕེ་སི་པ།","commonName":"ཨེ་ཕེ་སི་པ།","title":"༄༅། །ཨེ་ཕེ་སི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":49,"numberOfChapters":6,"sha256":"e04adeff3364a799b5eb3a7c964e9708afbe26eb209718e02bb341f57bdac338","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bod_ntb/EPH/6.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["འཕྲིན་ཡིག་བསྐུར༌ཡུལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཕོལ་ལོལ་བདག་ནི་དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན་མཱ་ཤི་ཀ་ཡེ་ཤུའི་སྐུ་ཚབ་པ་ཞིག་ཡིན་ནོ།། བདག་གིས་ཨེ་ཕེ་སི་རུ་ཡོད་པའི་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་བློ་སེམས་དཀར་བའི་དད་ལྡན་དམ་པ་རྣམས་ལ་འཕྲིན་ཡིག་སྤྲིངས་པ་ནི་འདི་ལྟ༌སྟེ།"]},{"type":"verse","number":2,"content":["བདག་ཅག་གི་ཡབ་དཀོན་མཆོག་དང་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ནས་ཁྱོད་རྣམས་ལ་ཐུགས་རྗེ་དང་ཞི་བདེ་འཐོབ་པར༌སྨོན།"]},{"type":"heading","content":["ཐུགས་ཉིད་ཀྱི་བྱིན་རླབས༌སྐོར།"]},{"type":"verse","number":3,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཡབ་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པར༌ཤོག དཀོན་མཆོག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་ནམ་མཁའི་ཞིང་ཁམས་སུ་ཡོད་པའི་ཐུགས་ཉིད་ཀྱི་བྱིན་རླབས་ཐམས་ཅད་བདག་ཅག་ལ་གནང༌ཞིང༌།"]},{"type":"verse","number":4,"content":["ཁོང་གི་སྤྱན་སྔར་བདག་ཅག་ནི་དམ་པ་དང་སྐྱོན་གྱི་དྲི་མས་མ་གོས་པ་ཞིག་ཏུ་འགྱུར་བའི་ཕྱིར། ཁོང་གིས་འཇིག་རྟེན་ཁམས་མ་བཀོད་པའི་སྔོན་ལ། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་བདག་ཅག་བདམས་པ་ཡིན་ནོ།།"]},{"type":"verse","number":5,"content":["ཡང་ཁོང་གིས་སྔ་མོ་ནས་རང་ཉིད་ཐུགས་དགྱེས་པ་བཞིན། བདག་ཅག་ཡེ་ཤུ་མཱ་ཤི་ཀ་བརྒྱུད་ནས་ཁོང་གི་བུ་སྐལ་དུ་འགྱུར་བར་བྱམས་པའི་ངང་ནས་ཐག་གིས་བཅད༌ཟིན་ལ།"]},{"type":"verse","number":6,"content":["དེ་ནི་ཁོང་གི་གཟི་བརྗིད་དང་ལྡན་པའི་ཐུགས་རྗེ་ལ་བསྟོད་བསྔགས་བརྗོད་པར་འགྱུར་བའི་ཕྱིར༌ཡིན་ལ། ཐུགས་རྗེ་དེ་ནི་ཁོང་གིས་རང་གི་གཅེས་པའི་སྲས་བརྒྱུད་ནས་བདག་ཅག་ལ་ཕངས་མེད་དུ་གནང་ངོ་།།"]},{"type":"verse","number":7,"content":["ཡང་བདག་ཅག་ནི་ཁོང་གི་ནང་དུ་ཉིད་ཀྱི་སྐུ་ཁྲག་ལ་བརྟེན་ནས་བླུས་ཤིང་སྡིག་པ་བསལ་བ་ཡིན། དེ་ནི་དཀོན་མཆོག་གི་ཐུགས་རྗེ་ཕུན་སུམ་ཚོགས་པ༌བཞིན་ཏེ།"]},{"type":"verse","number":8,"content":["ཁོང་གིས་ཤེས་རབ་དང་བློ་རིག་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་བདག་ཅག་ལ་ཕངས་མེད་དུ་གནང༌ངོ་༎"]},{"type":"verse","number":9,"content":["ཡང་དཀོན་མཆོག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་སྔར་ནས་དམིགས་པའི་རང་ཉིད་ཀྱི་ཐུགས་དགོངས་ལེགས་པོ༌བཞིན། བདག་ཅག་ལ་ཁོང་གི་ཐུགས་དགོངས་ཀྱི་གསང་བ་དེ་མངོན་པར་མཛད་ཅིང་།"]},{"type":"verse","number":10,"content":["དེ་ནི་དཀོན་མཆོག་གི་ཐུགས་བཀོད་ལྟར་ཁོང་གི་དུས་དེ་ལོངས༌པའི་ཚེ། ཁོང་གིས་གནམ་ས་གཉིས་ཀྱི་དངོས་པོ་ཐམས་ཅད་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་དབང་འོག་ཏུ་གཅིག་གྱུར་མཛད་པ་ཡིན་ནོ།།"]},{"type":"verse","number":11,"content":["ཡང་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་བདག་ཅག་ལའང་བགོ་སྐལ་ཐོབ་པ་ཡིན། དོན་དེ་ནི་སྔ་མོ་ནས་ཁོང་གི་ཐུགས་དགོངས་ལྟར་ཐག་གིས་བཅད༌ཅིང༌། ཁོང་གིས་ཐུགས་དགོངས་བཞིན་དུ་དོན་ཐམས་ཅད་མཛད༌པ་སྟེ།"]},{"type":"verse","number":12,"content":["ཐོག་མར་སྐྱབས་མགོན་མཱ་ཤི་ཀར་རེ་བ་ལྡན་པ་ངེད་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་གཟི་བརྗིད་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":13,"content":["ཡང་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ། ཁྱོད་ཅག་གིས་ཀྱང་བཀའ་བདེན་པ་སྟེ་ཁྱོད་རྣམས་སྐྱོབ་པར་བྱེད་པའི་འཕྲིན་བཟང་དེ་ཐོས་ཤིང༌ཁོང་ལ་དད་པར་གྱུར་པ་དང་། ཁྱོད་ཅག་ལ་ཞལ་བཞེས་གནང་བའི་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ཕྱག་རྒྱས་བཏབ་པ་ཡིན།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་གིས་ཁོང་ཉིད་ཀྱི་མི་སྡེ་ཐར་བར་མཛད་པའི་བར༌དུ། དམ་པའི་ཐུགས་ཉིད་ནི་བདག་ཅག་ལ་བགོ་སྐལ་གྱི་གཏའ་མའི་དཔང་རྟགས་སུ་གནང་བ་ཡིན་ཏེ། དཀོན་མཆོག་གི་གཟི་བརྗིད་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་ཕྱིར་རོ།།"]},{"type":"heading","content":["ཕོལ་ལོལ་གྱི་གསོལ༌འདེབས།"]},{"type":"verse","number":15,"content":["དེའི༌ཕྱིར། བདག་གིས་ཀྱང་ཁྱོད་རྣམས་གཙོ་བོ་ཡེ་ཤུར་དད་པ་ཡོད་པ༌དང༌། དད་ལྡན་དམ་པ་ཐམས་ཅད་ལའང་བྱམས་ཤིང་གཅེས་པའི་དོན་དེ་ཐོས༌པས།"]},{"type":"verse","number":16,"content":["བདག་གིས་གསོལ་བ་འདེབས་པའི་དུས༌སུ། ཁྱོད་རྣམས་གླེང་བ་དང་རྒྱུན་དུ་ཁྱོད་ཅག་གི་ཆེད་དུ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས་པ་སྟེ།"]},{"type":"verse","number":17,"content":["བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་དཀོན་མཆོག་སྟེ་གཟི་བརྗིད་ཆེ་བའི་ཡབ་དེ་ཉིད༌ཀྱིས། ཁྱོད་རྣམས་ཀྱིས་དངོས་གནས་དཀོན་མཆོག་གི་ངོ་བོ་རྟོགས་པའི་ཕྱིར། ཤེས་རབ་དང་བློ་སྒོ་འབྱེད་པའི་སེམས་དེ་ཁྱོད་ཅག་ལ་སྩོལ་བར༌སྨོན།"]},{"type":"verse","number":18,"content":["གཞན༌ཡང༌། ཁྱོད་རྣམས་ཀྱི་སེམས་ཁོང་གི་མིག་ཟུང་གསལ་པོར་མཛད་པར༌ཞུའོ།། དེ་ནི་དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ལ་ཞལ་འབོད་གནང༌ཞིང༌། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་དེ་ལ་རེ་བ་ག་འདྲ་ལྡན་པ་དང༌། དད་ལྡན་དམ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་དཀོན་མཆོག་གི་གཟི་བརྗིད་ཆེན་པོའི་བགོ་སྐལ་ཅི་འདྲ་ཡོད་པ།"]},{"type":"verse","number":19,"content":["ཁོང་གིས་རང་རེ་དད་ལྡན་རྣམས་ལ་མཐུ་རྩལ་མངོན་པ་ནི་ཇི་འདྲའི་ཆེ་བ་བཅས་རྟོགས་པའི་ཕྱིར་གསོལ་བ་བཏབ༌པའོ།། དེ་ནི་ཁོང་གི་མཐུ་དང་ནུས་པ་བཞིན་ཡིན༌ཏེ།"]},{"type":"verse","number":20,"content":["ཁོང་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་སྐུ་ལུས་སྟེང་དུ་མཐུ་རྩལ་ཆེན་པོ་མངོན་པར་མཛད་པ༌དང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀ་འཆི་བ་ལས་སླར་གསོན་པར་མཛད༌ཅིང་། ནམ་མཁའི་ཞིང་ཁམས་ནས་ཁོང་གི་གཡས་ཕྱོགས་སུ་བཞུགས་པར་མཛད༌པས།"]},{"type":"verse","number":21,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་བསྐལ་པ་འདི་དང་བསྐལ་པ་འབྱུང་འགྱུར་དུའང༌། འཇིག་རྟེན་གྱི་སྲིད་འཛིན་མཁན༌དང༌། དབང་འཛིན༌མཁན། མཐུ་སྟོབས༌ཅན། དབང་སྒྱུར་མཁན། མཚན་དང་ལྡན་པ་ཐམས་ཅད་ལས་ཀྱང་ཆེས་ཁྱད་དུ་འཕགས་ཤིང་བླ་ན༌མཐོ་བའོ།།"]},{"type":"verse","number":22,"content":["ཡང་དཀོན་མཆོག་གིས་འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཞབས་འོག་ཏུ་གནོན་པར་མཛད༌ཅིང༌། ཁོང་ནི་ཆོས་ཚོགས་ཀྱི་ཆེད་དུ་འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་ཀྱི་དབུ་རུ་བསྐོས༌པ་ཡིན།"]},{"type":"verse","number":23,"content":["ཆོས་ཚོགས་ནི་ཁོང་གི་སྐུ་ལུས་ཡིན༌ཞིང༌། འཇིག་རྟེན་སྣོད་བཅུད་མ་ལུས་པར་ཡོངས་སུ་ཁྱབ་པ་དེ་ཉིད་ཀྱིས་ཁྱབ་པའང་ཡིན་ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EPH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EPH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GAL/6.json","previousChapterAudioLinks":{},"numberOfVerses":23}