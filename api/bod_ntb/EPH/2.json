{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EPH","translationId":"bod_ntb","name":"ཨེ་ཕེ་སི་པ།","commonName":"ཨེ་ཕེ་སི་པ།","title":"༄༅། །ཨེ་ཕེ་སི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":49,"numberOfChapters":6,"sha256":"e04adeff3364a799b5eb3a7c964e9708afbe26eb209718e02bb341f57bdac338","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bod_ntb/EPH/6.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་གསོན་པར་མཛད༌པ།"]},{"type":"verse","number":1,"content":["དེ་སྔར་ཁྱོད་ཅག་ནི་སྡིག་པ་དང་ཉེས་པའི་ཁྲོད་དུ་ཤི་བ་ཡིན་ནོ།།"]},{"type":"verse","number":2,"content":["དུས་དེར་ཁྱོད་རྣམས་ཀྱིས་འཇིག་རྟེན་གྱི་ལུགས་སྲོལ་ངན་པ་ལྟར་བྱེད་པ༌དང༌། བར་སྣང་ཁམས་སུ་དབང་འཛིན་མཁན་ལ་བསྟུན་པ་ཡིན། དེ་ནི་ད་ལྟ་དཀོན་མཆོག་གི་བཀའ་ལ་མི་ཉན་པ་རྣམས་ཀྱི་སེམས་སུ་ལས་བྱེད་པའི་སེམས་ཉིད་ངན་པ་ཡིན།"]},{"type":"verse","number":3,"content":["བདག་ཅག་ཐམས་ཅད་ཀྱིས་ཀྱང་སྔར་མི་དེ་དག་གི་ཁྲོད་ནས་ཤ་གཟུགས་ཀྱི་ཆགས་ཞེན་དང༌། ལུས་སེམས་གཉིས་ལས་ཇི་ལྟར་འདོད་པ་བཞིན་བྱས་མྱོང༌ལ། རང་བཞིན་གྱིས་དཀོན་མཆོག་ཐུགས་ཁྲོ་བར་འགྱུར་བའི་བུ་ཡིན་ཞིང་། མི་གཞན་དང་ཁྱད་པར་མེད་དོ།།"]},{"type":"verse","number":4,"content":["འོན༌ཀྱང༌། དཀོན་མཆོག་ལ་ཐུགས་རྗེ་ཕུན་སུམ་ཚོགས་པ་ཡོད་པ་དང་བདག་ཅག་ལ་ཤིན་ཏུ་བྱམས་ཤིང་གཅེས༌པས།"]},{"type":"verse","number":5,"content":["སྔར་བདག་ཅག་ཉེས་པའི་ཁྲོད་དུ་ཤི་བའི་དུས་སུ། བདག་ཅག་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ལྷན་དུ་གསོན་པར་མཛད། དེ་ནི་ཐུགས་རྗེས་ཁྱོད་རྣམས་ལ་ཐར་པ་འཐོབ་པར་མཛད༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":6,"content":["ཡང་དཀོན་མཆོག་གིས་བདག་ཅག་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཁོང་དང་མཉམ་དུ་སླར་གསོན་པ༌དང༌། ཁོང་དང་ལྷན་ཅིག་ནམ་མཁའི་ཞིང་ཁམས་སུ་སྡོད་པར་མཛད།"]},{"type":"verse","number":7,"content":["དེ་ནི་དཀོན་མཆོག་གིས་རང་གི་ཐུགས་རྗེ་ཕུན་སུམ་ཚོགས་པ༌སྟེ། མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་བདག་ཅག་ལ་གནང་བའི་སྙིང་རྗེ་དེ་ནི་བསྐལ་པ་འབྱུང་འགྱུར་དུ་མངོན་པར་མཛད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":8,"content":["མདོར་ན། དད་པའི་སྒོ་ནས་ཐུགས་རྗེས་ཁྱོད་རྣམས་ལ་ཐར་པ་འཐོབ་པར་མཛད་པ༌ལས། རང་ལ་བརྟེན་པ་མ་ཡིན་པར་དཀོན་མཆོག་གིས་གནང་བ་ཡིན་ནོ།།"]},{"type":"verse","number":9,"content":["དེ་ནི་རང་བྱས་ཀྱི་ལས་ལ་བརྟེན་པ་མ་ཡིན༌ལ། མི་སུ་ཡིན་ཡང་ཁ་ཕོ་མི་བཤད་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":10,"content":["དོན་དམ་དུ་བདག་ཅག་ནི་དཀོན་མཆོག་གིས་ལེགས་པར་བཅོས་པ་ཡིན༌ཏེ། མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་དོན་བཟང་པོ་བསྒྲུབ་པའི་ཕྱིར་བདག་ཅག་བཀོད་པ་ཡིན་ལ། དོན་བཟང་པོ་དེ་དག་ནི་བདག་ཅག་གིས་བསྒྲུབ་པའི་ཕྱིར་དཀོན་མཆོག་གིས་སྔ་མོ་ནས་སྟ་གོན་མཛད༌པའོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་གཅིག་གྱུར་བྱུང༌བ།"]},{"type":"verse","number":11,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་སེམས་སུ་འཛིན་དགོས་པ༌ནི། སྔར་ཤ་ཁྲག་གི་ཕུང་བོའི་ཐད་ནས་ཁྱོད་རྣམས་ཕྱི་ཕྱོགས་པ་ཡིན༌ལ། རང་གིས་རང་ལ་མཚན་སྐྱི་གཅོད་པའི་མི་ཞེས་འབོད་པ་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་མཚན་སྐྱི་མི་གཅོད་པའི་མི་ཞེས་འབོད༌པ་དང་། མཚན་སྐྱི་གཅོད་པ་ནི་མིའི་རང་གི་ལག་པས་རང་ལུས་ལ་གཤག་བཅོས་བྱེད་པ༌དེ་ཡིན།"]},{"type":"verse","number":12,"content":["དུས་དེར་ཁྱོད་རྣམས་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་འབྲེལ་བ་མེད༌དེ། ཡེས་ར་ཨེལ་མི་རིགས་ཀྱི་འབངས་སུའང་མི་གཏོགས༌ཤིང༌། ཞལ་བཞེས་ཀྱི་ཞལ་ཆད་རྣམས་ལ་རྒྱུས་ལོན་ཡང་མེད༌ལ། ཁྱོད་རྣམས་ལ་རེ་བ་མེད་ཅིང་འཇིག་རྟེན་དུ་གསོན་པོར་སྡོད་ཀྱང་དཀོན་མཆོག་དང་འབྲེལ་བ་མེད་དོ།།"]},{"type":"verse","number":13,"content":["འོན༌ཀྱང༌། སྔར་ཁྱོད་རྣམས་ནི་རྒྱང་རིང་དུ་གནས་པའི་མི་ཡིན་ཞིང་ད་ལྟ་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ། ཁོང་གི་སྐུ་ཁྲག་ལ་བརྟེན་ནས་ཉེ་སར་དྲངས༌པ་ཡིན།"]},{"type":"verse","number":14,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྐྱབས་མགོན་ཡེ་ཤུ་ནི་བདག་ཅག་སྡུམ་མཁན་ཡིན་ཞིང༌། འགལ་ཟླའི་བར་གྱང་བཤིགས་ནས་ཡ་ཧུ་དཱ་པ་དང་ཕྱི་ཕྱོགས་པ་གཉིས་ཀ་རྣམ་པ་གཅིག་ཏུ་མཛད་དེ།"]},{"type":"verse","number":15,"content":["ད་དུང་ཁོང་ཉིད་ཀྱི་སྐུ་ལུས་ཀྱིས་ཞེ་འཁོན་བསལ་ཞིང་། བཀའ་ཁྲིམས་དང་དེ་ལས་ཕབ་པའི་ཁྲིམས་སྲོལ་ཐམས་ཅད་ལ་ནུས་པ་མེད་པར་མཛད་དོ།། དེ་ནི་སྐྱབས་མགོན་ཡེ་ཤུ་རང་ཉིད་ཀྱི་སྐུ་ལུས་བརྒྱུད་ནས་དེ་གཉིས་ཀ་མི་གསར་པ་ཞིག་ཏུ་བསྐྲུན་ཏེ་བསྡུམས་པ༌དང༌།"]},{"type":"verse","number":16,"content":["ཡང་ཤིང་རྒྱ་གྲམ་བརྒྱུད་ནས་དེ་གཉིས་བར་གྱི་ཞེ་འཁོན་མེད་པར་མཛད་ཅིང་། དེ་གཉིས་ཀ་སྐུ་ལུས་གཅིག་ཏུ་བྱས་ཏེ་དཀོན་མཆོག་དང་བསྡུམས་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":17,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཡུལ་འདིར་ཕེབས་ནས་དཀོན་མཆོག་དང་རྒྱང་དུ་གནས་པ་ཁྱོད་རྣམས་དང༌། ཉེ་སར་ཡོད་པའི་མི་གཞན་དག་ལའང་ཞི་བདེའི་འཕྲིན་བཟང་བསྒྲགས་མྱོང༌།"]},{"type":"verse","number":18,"content":["རྒྱུ་མཚན་ནི་བདག་ཅག་མི་རིགས་གཉིས་ཀ་སྐྱབས་མགོན་ཡེ་ཤུ་བརྒྱུད༌དེ། དམ་པའི་ཐུགས་ཉིད་གཅིག་གི་སྒོ་ནས་ཡབ་ཀྱི་དྲུང་དུ་འབྱོན་པའི་ལམ་བུ་བྱུང༌བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":19,"content":["དེའི༌ཕྱིར། ད་ལྟ་ཁྱོད་ཅག་ཐམས་ཅད་ནི་ཕྱི་མི་དང་མགྲོན་པོ་མ་ཡིན༌པར། དཀོན་མཆོག་གི་དད་ལྡན་དམ་པ་དང་ཡུལ་ཕྱོགས་མཚུངས༌ཤིང༌། དཀོན་མཆོག་གི་ཁྱིམ་གཞིས་ལ་གཏོགས་པའི་མི་ཡིན་པ༌དང༌།"]},{"type":"verse","number":20,"content":["སྐུ་ཚབ་པ་དང་ལུང་སྟོན་པ་རྣམས་ཀྱི་རྨང་གཞིའི་སྟེང་ནས་ཁྱོད་རྣམས་བསྐྲུན་པ་ཡིན། ཁང་པའི་ཟུར་གྱི་རྨང་རྡོ་ནི་མཱ་ཤི་ཀ་ཡེ་ཤུ་རང་ཉིད་ལགས་སོ།།"]},{"type":"verse","number":21,"content":["ཁང་པའི་བཟོ་བཀོད་དེ་ཐམས་ཅད་ནི་ཁོང་གི་ནང་དུ་ལེགས་པར་སྦྲེལ༌ཞིང༌། རིམ་བཞིན་གཙོ་བོའི་ནང་དུ་མཆོད་ཁང་དམ་པ་ཞིག་ཏུ་འགྱུར་གྱིན་ཡོད།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ཀྱང་དད་ལྡན་གཞན་དག་དང་ལྷན༌དུ། སྐྱབས་མགོན་ཡེ་ཤུའི་ནང་དུ་དཀོན་མཆོག་ལ་བཞུགས་གནས་ཤིག་སྐྲུན་བཞིན་ཡོད༌དེ། དཀོན་མཆོག་ནི་དམ་པའི་ཐུགས་ཉིད་བརྒྱུད་ནས་གནས་དེར་བཞུགས་པ་ཡིན་ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EPH/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EPH/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EPH/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}