{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EPH","translationId":"bod_ntb","name":"ཨེ་ཕེ་སི་པ།","commonName":"ཨེ་ཕེ་སི་པ།","title":"༄༅། །ཨེ་ཕེ་སི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":49,"numberOfChapters":6,"sha256":"e04adeff3364a799b5eb3a7c964e9708afbe26eb209718e02bb341f57bdac338","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bod_ntb/EPH/6.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["ཕོལ་ལོལ་གྱི་འགན་འཁྲིའི་སྐོར།"]},{"type":"verse","number":1,"content":["དེའི༌ཕྱིར། ཕྱི་ཕྱོགས་པ་ཁྱོད་རྣམས་ཀྱི་དོན་དུ་ཕོལ་ལོལ་བདག་ནི་མཱ་ཤི་ཀ་ཡེ་ཤུའི་བཙོན་པར་གྱུར་པ་ཡིན་ནོ།།"]},{"type":"verse","number":2,"content":["ཡང་དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་ཁོང་ཉིད་ཀྱི་ཐུགས་རྗེའི་ལས་འགན་བདག་ལ་གནང་བ་ནི་ཁྱོད་ཅག་གིས་ཀྱང་ཐོས་ཡོད་པ༌དང༌།"]},{"type":"verse","number":3,"content":["དེ་སྔར་བདག་གིས་རགས་ཙམ་བྲིས་པ་བཞིན༌དུ། དཀོན་མཆོག་གིས་གསང་བ་དེ་བདག་ལ་མངོན་པར་མཛད༌ཅིང༌།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་གིས་ཡི་གེ་དེ་བཀླགས་པ་ཡིན༌ན། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་གསང་བ་གསལ་པོར་རྟོགས་པའང་ཤེས་པར་ནུས།"]},{"type":"verse","number":5,"content":["གསང་བ་དེ་མི་རབས་སྔ་མའི་མི་རྣམས་ལ་མངོན་པར་མ་མཛད༌ཅིང༌། ད་ལྟ་དམ་པའི་ཐུགས་ཉིད་བརྒྱུད་ནས་ཁོང་གི་སྐུ་ཚབ་དམ་པ་དང་ལུང་སྟོན་པ་རྣམས་ལ་མངོན་པར་མཛད༌པ་ཡིན།"]},{"type":"verse","number":6,"content":["དེ་ནི་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་མཆིས་ཤིང་འཕྲིན་བཟང་བརྒྱུད༌ནས། ཕྱི་ཕྱོགས་པ་རྣམས་ནི་ཡ་ཧུ་དཱ་པ་རྣམས་དང་ལྷན༌དུ་རྒྱུན་འཛིན་མཁན༌དང༌། སྐུ་ལུས་གཅིག་ཏུ་ཞུགས་པ༌དང༌། ཞལ་བཞེས་ཐོབ་མཁན་ཡང་ཡིན༌ནོ།།"]},{"type":"verse","number":7,"content":["ང་རང་འཕྲིན་བཟང་ལ་ཞབས་ཕྱི་བྱེད་མཁན་དུ་གྱུར་པ་ནི་དཀོན་མཆོག་གི་ཐུགས་རྗེའི་གནང་སྦྱིན་བཞིན་དུ་ཐོབ་པ་ཡིན༌ཞིང༌། དེ་ནི་ཁོང་གི་མཐུ་སྟོབས་བཞིན་དུ་བདག་ལ་གནང་ངོ་།།"]},{"type":"verse","number":8,"content":["བདག་ནི་དད་ལྡན་དམ་པ་ཐམས་ཅད་ལས་ཆེས་ཆུང་བ་ལས་ཀྱང་ཕྲན་བུ་ཡིན༌ཡང༌། དཀོན་མཆོག་གིས་བདག་ལ་ཐུགས་རྗེ་དེ་གནང་བའི་རྒྱུ་མཚན་ནི་འདི་ལྟ༌སྟེ། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བསམ་གྱིས་མི་ཁྱབ་པའི་ཐུགས་རྗེ་ཆེན་པོ་དེ་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་སྒྲོག་པ༌དང༌།"]},{"type":"verse","number":9,"content":["གསང་བ་དེ་མངོན་པར་བྱེད་པའི་ལས་འགན་ནི་ངས་མི་ཐམས་ཅད་ལ་ཤེས་སུ་འཇུག་པའི་ཕྱིར༌ཡིན། གསང་བ་དེ་ནི་བསྐལ་པའི་ཐོག་མ་ནས་བཟུང༌། འཇིག་རྟེན་མཐའ་དག་ཡོངས་སུ་འགོད་མཁན་དཀོན་མཆོག་གི་ཐུགས་དགོངས་ནང་དུ་སྦས་ཡོད་ལ།"]},{"type":"verse","number":10,"content":["དེ་ནི་ཁོང་ཉིད་ཀྱི་མཁྱེན་རབ་སྣ་ཚོགས་ད་ལྟ་ཆོས་ཚོགས་བརྒྱུད༌ནས། ནམ་མཁའི་སྲིད་འཛིན་མཁན་དང་དབང་འཛིན་མཁན་རྣམས་ལ་ཤེས་སུ་འཇུག་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["ཡང་དེ་ནི་དཀོན་མཆོག་གིས་ཁོང་ཉིད་ཀྱི་མཐའ་མེད་པའི་ཐུགས་དགོངས་བཞིན། བདག་ཅག་གི་གཙོ་བོ་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་འགྲུབ་པར་མཛད་པ་ཞིག་ཀྱང་ཡིན།"]},{"type":"verse","number":12,"content":["སྐྱབས་མགོན་ཡེ་ཤུར་དད་པ་བྱེད་པ་དང་ཁོང་ཉིད་ཀྱི་ནང་དུ། བདག་ཅག་དཀོན་མཆོག་གི་དྲུང་དུ་འགྲོ་ཐུབ་པར་སྙིང་ལ་ཞུམ་པ་མེད་ཅིང་བློ་ལ་གདེང་ཚོད་ཡོད།"]},{"type":"verse","number":13,"content":["དེའི༌ཕྱིར། ངས་ད་ལྟ་ཁྱོད་རྣམས་ཀྱི་དོན་དུ་དཀའ་སྡུག་མྱོང་བ་ནི་ཁྱོད་ཅག་གི་གཟི་བརྗིད་ཡིན༌པས། བདག་གིས་ཁྱོད་རྣམས་ལ་ཡིད་མ་ཕམ་ཞེས་ཞུ་བ་བྱེད༌དོ།།"]},{"type":"heading","content":["དད་ལྡན་རྣམས་ཀྱི་དོན་དུ་གསོལ་བ་བཏབ༌པ།"]},{"type":"verse","number":14,"content":["དེའི༌ཕྱིར། བདག་གིས་ཡབ་ཀྱི་དྲུང་དུ་པུས་མོ་ས་ལ་བཙུགས་ནས་གསོལ་བ་བཏབ་ཅིང་།"]},{"type":"verse","number":15,"content":["ཁོང་ལ་བརྟེན་ནས་གནམ་ས་གཉིས་སུ་ཡོད་པའི་ཁྱིམ་གཞིས་ཐམས་ཅད་ལ་མིང་བྱུང༌བ་ཡིན་ནོ།།"]},{"type":"verse","number":16,"content":["གསོལ་འདེབས་ནི་འདི་ལྟ༌སྟེ། དཀོན་མཆོག་གི་གཟི་བརྗིད་ཆེན་པོ་བཞིན་ཁོང་གིས་དམ་པའི་ཐུགས་ཉིད་བརྒྱུད་ནས། ཁྱོད་རྣམས་ཀྱི་སེམས་ལ་སྟོབས་ཤུགས་རྒྱས་པར་མཛད༌ཅིང༌།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཅག་གི་དད་པའི་སྒོ་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཁྱོད་ཅག་གི་སེམས་སུ་བཞུགས་པ་དང་། ཡང་ཁྱོད་ཅག་གི་བྱམས་པ་ལ་རྩ་བ་རྒྱས་ཤིང་བརྟན་པོར་གྱུར་ནས།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཅག་དང་དད་ལྡན་དམ་པ་ཐམས་ཅད་ཀྱིས་ལྷན་དུ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བྱམས་པ་ནི་ཇི་འདྲའི་ཡུན་རིང་ཞིང་རྒྱ་ཆེ་བ། ཚད་མཐོ་ཞིང་གཏིང་ཟབ་པ་ཞིག་ཡིན་པ་རྟོགས་ནུས༌པ་དང༌།"]},{"type":"verse","number":19,"content":["ཁོང་གི་བྱམས་པ་དེ་ནི་བློ་ཡུལ་དུ་མི་ཤོང་བ་ཞིག་ཡིན་པ་ཤེས་པར་གྱུར༌ནས། དཀོན་མཆོག་གི་ཕུན་སུམ་ཚོགས་པ་དེ་ཉིད་ཁྱོད་ཅག་ལའང་ཁྱབ་པར་སྨོན།"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་གིས་བདག་ཅག་གི་སེམས་སུ་མཛད་པའི་མཐུ་སྟོབས་ཆེན་པོ་བཞིན། བདག་ཅག་གིས་ཁོང་ལ་ཞུ་བའམ་སེམས་སུ་དྲན་པ་ལས༌ཀྱང༌། ཁོང་གིས་རྒྱ་ཆེ་ཞིང་ཕུན་སུམ་ཚོགས་པའི་སྒོ་ནས་དོན་ཐམས་ཅད་འགྲུབ་པར་མཛད་ནུས༌པས།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ལ་ཆོས་ཚོགས་དང་མཱ་ཤི་ཀ་ཡེ་ཤུ་བརྒྱུད་ནས། མི་རབས་ནས་མི་རབས་དང་ཡུན་ནས་ཡུན་དུ་བསྟོད་བསྔགས་བརྗོད་པར་སྨོན། ཨ༌མེན།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EPH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EPH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EPH/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}