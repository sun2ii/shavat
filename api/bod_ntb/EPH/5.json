{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EPH","translationId":"bod_ntb","name":"ཨེ་ཕེ་སི་པ།","commonName":"ཨེ་ཕེ་སི་པ།","title":"༄༅། །ཨེ་ཕེ་སི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":49,"numberOfChapters":6,"sha256":"e04adeff3364a799b5eb3a7c964e9708afbe26eb209718e02bb341f57bdac338","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bod_ntb/EPH/6.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["ལས་བཟང་པོ་བྱེད་པར་གདམས༌པ།"]},{"type":"verse","number":1,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་བྱམས་སྐྱོང་ཐོབ་པའི་བུ་ཕྲུག་བཞིན་དུ་དཀོན་མཆོག་ཁོང་ཉིད་དཔེ་རུ་ལེན་འོས་སོ།།"]},{"type":"verse","number":2,"content":["ཡང་སྐྱབས་མགོན་མཱ་ཤི་ཀས་ཇི་ལྟར་བདག་ཅག་ལ་བྱམས་ཤིང་གཅེས་ཏེ་རང་སྲོག་བློས་བཏང་བ་དང་། དཀོན་མཆོག་ལ་དྲི་ཞིམ་གྱི་འབུལ་བ་དང་མཆོད་པ་ཕུལ་བ་བཞིན། ཁྱོད་ཅག་གིས་ཀྱང་དེ་ལྟར་བྱམས་པ་ལ་བརྟེན་ནས་སྤྱད་པ་སྤྱོད་དགོས།"]},{"type":"verse","number":3,"content":["འོན༌ཀྱང༌། གཡེམ༌སྦྱོར་རམ་མི་གཙང་བ་ཐམས༌ཅད། ཡང་ན་བརྣབ་སེམས་ཏེ་དད་ལྡན་དམ་པ་རྣམས་ཀྱི་སྤྱོད་ཚུལ་དང་མི་མཐུན་པའི་ལས་ནི་ཁྱོད་ཅག་གི་ཁྲོད་དུ་གླེང་ཡང་མི་རུང༌བ་ཡིན།"]},{"type":"verse","number":4,"content":["འདོད་གཏམ༌དང༌། འཆལ༌གཏམ། ཀུ་རེ་གཏམ་ངན་ཡང་སྨྲ་མི་འོས༌པར། རྟག་ཏུ་བཀའ་དྲིན་ཞུ་དགོས་སོ།།"]},{"type":"verse","number":5,"content":["རྒྱུ་མཚན་ནི་ལོག་གཡེམ་བྱེད་མཁན༌དང༌། མི་གཙང༌བ། སྐུ་འདྲར་བརྟེན་པ་དང་གཅིག་མཚུངས་ཡིན་པའི་བརྣབ་སེམས་ཅན་བཅས་ལ་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་བགོ་སྐལ་ནམ་ཡང་འཐོབ་མི་སྲིད་པ་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་གསལ་པོར་ཤེས༌པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":6,"content":["མི་གཞན་གྱི་སྙིང་པོ་མེད་པའི་གཏམ་གྱི་གཡོ་འོག་ཏུ་ཚུད༌པར་མི་བྱའོ།། ལས་ངན་པ་དེ་དག་གི་རྐྱེན་གྱིས་དཀོན་མཆོག་གི་བཀའ་ལ་མི་ཉན་པ་རྣམས་ལ་ཁོང་ཉིད་ཀྱི་ཐུགས་ཁྲོ་འཕོག་པར་འགྱུར་ངེས་ཡིན།"]},{"type":"verse","number":7,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་མི་དེ་དག་དང་འགྲོགས་པར་མི༌བྱའོ།།"]},{"type":"verse","number":8,"content":["དེ་སྔར་ཁྱོད་རྣམས་ནི་མུན་པ་ཡིན༌ཡང༌། ད་ལྟ་གཙོ་བོ་ལ་གཏོགས་ཤིང་འོད་ཟེར་དང་ལྡན་པ་ཡིན༌པས། འོད་ཟེར་གྱི་བུ་ཕྲུག་བཞིན་དུ་སྤྱོད་འོས་སོ།།"]},{"type":"verse","number":9,"content":["འོད་ཟེར་ལས་བྱུང་བའི་འབྲས་བུ་ནི་ལས་བཟང་པོ༌དང༌། དྲང༌བདེན། བདེན་པ་ཐམས་ཅད་ཡིན།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་ཀྱང་གཙོ་བོ་ཐུགས་དགྱེས་པའི་དོན་གང་ཞིག་འཚོལ་འོས་སོ།།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཕན་ཐོགས་མེད་པའི་མུན་ནག་གི་བྱ་བ་ལ་མི་ཞུགས༌པར། བྱ་བ་ངན་པ་དེ་དག་མི་གཞན་ལ་རྗེན་པར་སྟོན་ཅིག"]},{"type":"verse","number":12,"content":["ཅིའི་ཕྱིར་ཞེ༌ན། དེ་དག་གིས་ལྐོག་ཏུ་སྒྲུབ་པ་ནི་ངག་ལས་སྨྲ་བའང་ངོ་གནོང་བ་ཞིག༌ཡིན།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང༌། འོད་ཟེར་གྱིས་དོན་ཐམས་ཅད་རྗེན་པར་སྟོན་ཞིང་མངོན་པར་བྱེད། རྒྱུ་མཚན་ནི་མིག་གིས་མཐོང་བར་གྱུར་པ་ཐམས་ཅད་འོད་ཟེར་གྱིས་མངོན་པར་བྱེད་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":14,"content":["དེའི༌ཕྱིར། ཇི་སྐད༌དུ།",{"text":"གཉིད་དུ་ཡུར་པ་གཉིད་ལས་སད་པར༌གྱིས།།","poem":1},{"lineBreak":true},{"text":"འཆི་བའི་བེམ་པོ་མྱུར་དུ་ལོངས་ཤིག་དང་།།","poem":1},{"lineBreak":true},{"text":"མཱ་ཤི་ཀ་ཡིས་ཁྱོད་ལ་འོད་ཟེར་སྤྲོ།།","poem":1},"ཞེས༌པའོ།།"]},{"type":"verse","number":15,"content":["དེ་ལྟར་ཡིན་པས། ཁྱོད་རྣམས་ཀྱིས་ཇི་ལྟར་སྤྱོད་པར་གཟབ་གཟབ་གྱིས། བླུན་པོ་དང་མི་འདྲ་བར་མཁས་པ་བཞིན་དུ་སྤྱོད་ཅིག"]},{"type":"verse","number":16,"content":["ད་ལྟ་ནི་དུས་ངན་པ་ཡིན་པས་དུས་ལ་དམ་འཛིན༌བྱ་དགོས།"]},{"type":"verse","number":17,"content":["བླུན་པོ་བཞིན་དུ་མི་འགྱུར་བར་གཙོ་བོའི་ཐུགས་དགོངས་ཅི་ཡིན་པ་ཤེས་པར་གྱིས།"]},{"type":"verse","number":18,"content":["ཆང་གིས་བཟི་བར་གྱུར་ན་བག་མེད་རྣམ་གཡེང་ཡིན༌པས། ཆང་གིས་བཟི་རུ་མི་འཇུག༌པར་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱབ་པར་གྱུར༌ཅིག"]},{"type":"verse","number":19,"content":["གསུང་མགུར་དང༌། བསྟོད༌དབྱངས། མགུར་གླུ་བཅས་ཀྱིས་ཕན་ཚུན་ལ་གཏམ་སྨྲ༌ཞིང༌། རང་གི་སེམས་ནས་གཙོ་བོ་ལ་བསྟོད་གླུ་དང་རོལ་དབྱངས་འབུལ་བར་བྱའོ།།"]},{"type":"verse","number":20,"content":["གཞན༌ཡང༌། དོན་ཐམས་ཅད་ཀྱི་ཆེད༌དུ་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་མཚན་གྱི་སྒོ་ནས་དུས་རྟག་ཏུ་ཡབ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་བ་དང༌།"]},{"type":"verse","number":21,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀར་གུས་ཤིང་འཇིགས་པའི་ངང་ཕན་ཚུན་ལ་བསྟུན་པར་བྱ་འོས༌སོ།།"]},{"type":"heading","content":["བཟའ་ཟླ་སྐོར་གྱི་བསླབ༌བྱ།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཅག་ཆུང་མ་རྣམས་ཀྱིས་གཙོ་བོ་ལ་བསྟུན་པ་བཞིན་རང་རང་གི་ཁྱོ་ག་དང་བསྟུན་པར༌བྱའོ།།"]},{"type":"verse","number":23,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་སྐུ་ལུས་ཡོངས་ཀྱི་སྐྱབས་མགོན་དང་ཆོས་ཚོགས་ཀྱི་དབུ་ཡིན་པ་ལྟར། ཁྱོ་ག་ནི་ཆུང་མའི་མགོ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":24,"content":["ཆོས་ཚོགས་ཀྱིས་ཇི་ལྟར་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ལ་བསྟུན་པ༌བཞིན། ཆུང་མས་ཀྱང་དེ་ལྟར་བྱ་བ་ཐམས་ཅད་རང་གི་ཁྱོ་ག་དང་བསྟུན་པར་བྱ་འོས་སོ།།"]},{"type":"verse","number":25,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀས་ཆོས་ཚོགས་ལ་ཇི་ལྟར་བྱམས་ཤིང་ཆོས་ཚོགས་ཀྱི་དོན་དུ་རང་སྲོག་བློས་བཏང་བ༌བཞིན། ཁྱོད་ཅག་ཁྱོ་ག་རྣམས་ཀྱིས་ཀྱང་རང་རང་གི་ཆུང་མ་ལ་དེ་ལྟར་བྱམས་ཤིང་གཅེས་དགོས་སོ།།"]},{"type":"verse","number":26,"content":["ཅིའི་ཕྱིར་ཞེ༌ན། སྐྱབས་མགོན་མཱ་ཤི་ཀས་བཀའ་ལ་བརྟེན་ནས་ཆུ་ཡིས་ཆོས་ཚོགས་གཙང་མར་བཀྲུས་ཤིང་དམ་པར་མཛད༌དེ།"]},{"type":"verse","number":27,"content":["སྨེ་བ་དང་གཉེར་མ་ལ་སོགས་མེད་པ༌དང་། ཆོས་ཚོགས་ནི་དམ་པ་ཡིན་པ་དང་སྐྱོན་གྱི་དྲི་མས་མ་གོས་པར་གཟི་བརྗིད་ལྡན་པ་ཞིག་རང་ཉིད་ལ་འབུལ་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":28,"content":["དཔེ་དེ་བཞིན་དུ་ཁྱོ་ག་རྣམས་ཀྱིས་ཀྱང་རང་གི་ལུས་པོར་ཇི་ལྟར་གཅེས་པ་བཞིན་ཆུང་མ་ལའང་དེ་ལྟར་གཅེས་དགོས། ཆུང་མར་གཅེས་ན་དོན་གྱིས་རང་ལ་གཅེས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["ཐོག་མ་ཉིད་ནས་རང་གི་ལུས་ལ་ཞེ་སྡང་ལངས་མཁན་སུ་ཡང་མེད༌པར་རྟག་ཏུ་གཅེས་སྐྱོང་བྱེད་པ་དང་། དེ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀས་ཆོས་ཚོགས་ལ་བྱམས་སྐྱོང་མཛད་པ་ལྟར༌ཡིན།"]},{"type":"verse","number":30,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་ཅག་ཐམས་ཅད་ནི་ཁོང་གི་སྐུ་ལུས་ཀྱི་ཡན་ལག་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":31,"content":["དེའི༌ཕྱིར། སྐྱེས་པ་ནི་རང་གི་ཕ་མ་དང་ཁ་བྲལ་ནས་རང་གི་ཆུང་མར་འབྲེལ་ཏེ་ཁོ་གཉིས་ལུས་པོ་གཅིག་ཏུ་འགྱུར་ཞིང་།"]},{"type":"verse","number":32,"content":["འདི་ནི་གསང་བ་ཆེན་པོ་ཞིག་ཡིན༌ཡང༌། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་ཆོས་ཚོགས་ལ་དམིགས་ནས་སྨྲས་པ་ཡིན་ནོ།།"]},{"type":"verse","number":33,"content":["འོན་ཀྱང༌། ཁྱོད་ཅག་མི་རེ་རེས་རང་ཉིད་ལ་གཅེས་པ་བཞིན་རང་གི་ཆུང་མ་ལའང་གཅེས༌ཤིང༌། ཆུང་མས་ཀྱང་རང་གི་ཁྱོ་ག་ལ་བརྩི་བཀུར་བྱ་འོས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EPH/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EPH/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EPH/4.json","previousChapterAudioLinks":{},"numberOfVerses":33}