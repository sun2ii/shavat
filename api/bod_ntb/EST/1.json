{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EST","translationId":"bod_ntb","name":"ཨེས་སི་ཐེར།","commonName":"ཨེས་སི་ཐེར།","title":"༄༅། །ཨེས་སི་ཐེར་གྱི་མདོ།","order":17,"numberOfChapters":10,"sha256":"9b18fc6a90e64b53ffd951ec55bd50a4aa28e4d94c16ebf39578d1a7d8d854e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EST/10.json","totalNumberOfVerses":166},"chapter":{"number":1,"content":[{"type":"heading","content":["རྒྱལ་མོ་ཝཱ་སི་ཏི་ཁྲི་ལས་ཕབ་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དོན་འདི་ནི་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡི་དུས་སྐབས་སུ་བྱུང་བ་ཡིན་ལ། ཨ་ཧཱ་ཝེ་རོ་ཡིས་རྒྱ་གར་ནས་གུ་ཤ་བྱ་བའི་ཡུལ་གྱི་བར་དུ་ལྗོངས་བརྒྱ་དང་ཉེར་བདུན་ལ་དབང་བྱས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["ཁོང་ཉིད་སོའུ་སཱན་མཁར་ཆེན་གྱི་རྒྱལ་ཁྲིའི་སྟེང་དུ་བཞུགས་པའི་དུས་ཏེ།"]},{"type":"verse","number":3,"content":["ཁོང་གིས་རྒྱལ་སྲིད་སྐྱོང་བའི་ལོ་གསུམ་པ་ལ། དཔོན་རིགས་དང་འཁོར་གཡོག་ཐམས་ཅད་ལ་གསོལ་སྟོན་བཤམས་ཤིང་། ཏ་ཟིག་དང་མཱ་ཏི་ཡུལ་གྱི་དམག་དཔོན་རྣམས་དང་། ལྗོངས་སོ་སོའི་སྐུ་དྲག་དང་འགོ་དཔོན་བཅས་ཐམས་ཅད་ཁོང་གི་དྲུང་དུ་འཛོམས་པ་རེད།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོས་རང་གི་རྒྱལ་སྲིད་ཀྱི་རྒྱུ་འབྱོར་བའི་གཟི་དཔལ་དང་། རང་གི་བརྗིད་ཉམས་རབ་ཏུ་འཕགས་པ་རྣམས་ཁོ་རྣམས་ལ་ཉིན་མང་པོར་བསྟན་ཞིང་བསྡོམས་པས་ཉིན་བརྒྱ་དང་བརྒྱད་ཅུའོ། །"]},{"type":"verse","number":5,"content":["དུས་དེ་རྫོགས་ནས་རྒྱལ་པོས་སོའུ་སཱན་མཁར་ཆེན་དུ་གནས་པའི་མི་མཆོག་དམན་ཐམས་ཅད་ལ་ཕོ་བྲང་གི་སྐྱེད་ཚལ་ཐང་ནས་ཉིན་བདུན་ལ་གསོལ་སྟོན་བཤམས་སོ། །"]},{"type":"verse","number":6,"content":["དེར་གོས་ཡུག་དཀར་ལྗང་སྔོ་གསུམ་ལ་རས་རྒྱ་སྨུག་དང་སོ་རས་གཉིས་མཉམ་སྦྲེལ་གྱི་ཐག་པས་དངུལ་གྱི་ཨ་ལོང་ལ་བཏགས་ཏེ་རྡོ་ཀ་མ་རུའི་ཀ་ཆེན་རྣམས་ལ་མདུད་ཡོད་ཅིང་། གསེར་དངུལ་གྱི་འབོལ་ཁྲི་རྣམས་རྡོ་ཀ་མ་རུ་དཀར་དམར་སེར་ནག་བཅས་ཀྱིས་གྲུབ་པའི་པང་གཅལ་སྟེང་དུ་བཀྲམས་པའོ། །"]},{"type":"verse","number":7,"content":["རྒུན་ཆང་འབུལ་བྱེད་ཀྱི་གསེར་ཕོར་རྣམས་ནི་རེ་རེ་མི་འདྲ་ཞིང་། རྒུན་ཆང་ཧ་ཅང་མོད་པོ་ཡོད་པ་དེས་རྒྱལ་པོ་གཏོང་ཕོད་ཆེ་བ་ཡོངས་སུ་མཚོན་པ་རེད།"]},{"type":"verse","number":8,"content":["ཡང་རྒུན་ཆང་འཐུང་བར་ལུགས་སྲོལ་ཡོད་ལ་ནན་གྱིས་བཏང་མི་ཆོག་པ་སྟེ། རྒྱལ་པོས་རང་གི་ཕོ་བྲང་གི་ལས་སྣེ་པ་རྣམས་ལ། མི་རེ་རེར་རང་རང་གི་འདོད་པ་བཞིན་སྤྱོད་དུ་འཇུག་དགོས་པའི་བཀའ་གནང་བས་སོ། །"]},{"type":"verse","number":9,"content":["རྒྱལ་མོ་ཝཱ་སི་ཏི་ཡིས་ཀྱང་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡི་ཕོ་བྲང་ནང་དུ་བུད་མེད་རྣམས་ལ་གསོལ་སྟོན་བཤམས་ཤིང་།"]},{"type":"verse","number":10,"content":["ཉིན་བདུན་པ་ལ་རྒྱལ་པོའི་ཐུགས་ནི་རྒུན་ཆང་གིས་སྤྲོ་བར་གྱུར་པའི་ཚེ། ཁོང་གིས་རང་ཉིད་ཀྱི་དྲུང་དུ་ཞབས་ཕྱི་བྱེད་པའི་མེ་ཧུ་མན་དང་པིས་ཐཱ། ཧར་པོ་ནཱ། པིག་ཐཱ། ཨ་བག་ཐཱ། ཙེ་ཐར། ཀར་ཀ་སི་བཅས་ཉུག་རུམ་པ་བདུན་ལ།"]},{"type":"verse","number":11,"content":["རྒྱལ་མོ་ཝཱ་སི་ཏི་ཡིས་རྒྱལ་མོའི་ཅོད་པན་གསོལ་ནས་རྒྱལ་པོའི་མདུན་དུ་ཡོང་དགོས་པའི་བཀའ་གནང་སྟེ། དེ་ནི་ཁོ་མོ་བྱད་གཟུགས་ཡིད་དུ་འོང་བ་ཞིག་ཡིན་པས། མི་རིགས་སོ་སོའི་ཡུལ་མི་དང་ས་གནས་དཔོན་རིགས་རྣམས་ལ་ཁོ་མོའི་བཞིན་རས་སྟོན་པའི་ཕྱིར་ཡིན་ནོ། །"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་ཁོ་མོ་ཉུག་རུམ་པ་རྣམས་ཀྱིས་སྦྲན་པའི་རྒྱལ་པོའི་བཀའ་བཞིན་མ་འོངས་པས། རྒྱལ་པོ་ཤིན་ཏུ་ཁྲོས་ནས་ཞེ་སྡང་གི་མེ་ལྕེ་འབར་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":13,"content":["རྒྱལ་པོའི་ལུགས་སྲོལ་ལྟར་ན། དོན་ཐམས་ཅད་བསྒྲུབ་པར་སྔོན་ལ་ཁྲིམས་སྲོལ་དང་བཀའ་རྒྱ་ཤེས་པའི་མི་ལ་བློ་འདྲི་བ་ཡིན། སྐབས་དེར་རྒྱལ་པོས་དུས་སྐར་ཤེས་པའི་མཁས་པ་རྣམས་དང་གྲོས་བཏབ་སྟེ།"]},{"type":"verse","number":14,"content":["དེ་དག་ནི་ཀར་ཤེ་ནཱ་དང་སི་ཐཱར། ཨད་མ་ཐཱ། ཐཱར་ཞིས། མེ་རེས། མཱར་སེ་ནཱ། མེ་མུ་ཀན་བཅས་ཏ་ཟིག་དང་མཱ་ཏི་ཡུལ་གྱི་བློན་ཆེན་བདུན་པོ་དེ་ཡིན་ཞིང་། རྟག་ཏུ་རྒྱལ་པོའི་ཞལ་མཇལ་མཁན་དང་། རྒྱལ་ཁམས་ཀྱི་ནང་དུ་གྲལ་མགོ་འཛིན་མཁན་ཡང་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["རྒྱལ་པོས་དེ་རྣམས་ལ། རྒྱལ་མོ་ཝཱ་སི་ཏི་ལ་ཉུག་རུམ་པ་ཚོས་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་བཀའ་སྦྲན་ཀྱང་ཉན་མ་བྱུང་བས། ཁྲིམས་སྲོལ་ལྟར་ན་ད་ནི་ཅི་བྱེད་པར་རིགས་སམ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":16,"content":["མེ་མུ་ཀན་གྱིས་རྒྱལ་པོ་དང་ས་གནས་དཔོན་པོ་རྣམས་ཀྱི་མདུན་དུ་འདི་ལྟར། རྒྱལ་མོ་ཝཱ་སི་ཏི་ཡི་བྱ་སྤྱོད་འདི་ནི་རྒྱལ་པོ་དང་འགལ་བར་མ་ཟད། རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་ལྗོངས་སོ་སོའི་དཔོན་འབངས་སྤྱི་ལའང་གནོད་པར་འདུག"]},{"type":"verse","number":17,"content":["ཅི་ལ་ཞེ་ན། རྒྱལ་མོའི་དོན་འདི་བུད་མེད་ཐམས་ཅད་ཀྱི་རྣ་བར་བརྒྱུད་ན། དེ་དག་གིས་ཀྱང་རང་རང་གི་ཁྱོ་གར་དམའ་འབེབས་བྱེད་ཅིང་ན་རེ། རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་རྒྱལ་མོ་ཝཱ་སི་ཏི་ཁོང་གི་དྲུང་དུ་བོས་ནའང་ཁོ་མོ་དེར་མ་ཕྱིན་ཏོ་ཞེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":18,"content":["ད་ནི་ཏ་ཟིག་དང་མཱ་ཏི་ཡུལ་གྱི་བཙུན་མོ་རྣམས་ཀྱིས་རྒྱལ་མོའི་བྱ་སྤྱོད་དེ་ཐོས་ན། རྒྱལ་པོའི་བློན་ཆེན་ཐམས་ཅད་ལ་དེ་ལྟར་སྨྲ་བ་དང་། དེ་ལྟར་བྱས་ཚེ་དམའ་འབེབས་དང་ཞེ་སྡང་རྫོགས་མེད་འབྱུང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":19,"content":["གལ་ཏེ་རྒྱལ་པོའི་ཐུགས་དང་འཕྲོད་ན། དོན་འདི་འགྱུར་བ་མེད་པའི་ཁྲིམས་སུ་ཕོབས་ལ། ཏ་ཟིག་དང་མཱ་ཏི་ཡུལ་དུ་རྒྱལ་པོའི་བཀའ་ཤོག་ཅིག་སྤྲིང་བར་མཛོད། དེའི་ནང་དུ་ཝཱ་སི་ཏི་ནི་དེང་ཕྱིན་ཆད་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡི་དྲུང་དུ་ཡོང་མི་ཆོག་པ་དང་། རྒྱལ་མོའི་གོ་ས་ཁོ་མོ་ལས་ལྷག་པའི་བཙུན་མོ་ཞིག་ལ་གནང་བར་བྱའོ། །"]},{"type":"verse","number":20,"content":["རྒྱལ་ཁམས་ཀྱི་མངའ་ཁོངས་ནི་ཅི་འདྲའི་རྒྱ་ཆེ་ཡང་། རྒྱལ་པོའི་བཀའ་མཆིད་རྒྱལ་ཁམས་ཡོངས་ལ་ཁྱབ་པའི་དུས་སུ། ཆུང་མ་རྣམས་ཀྱིས་རང་རང་གི་ཁྱོ་ག་མཆོག་དམན་སུ་ཞིག་ཡིན་རུང་དེ་ལ་བཀུར་བསྟི་བྱེད་ངེས་སོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":21,"content":["གཏམ་འདི་ལ་རྒྱལ་པོ་དང་ས་གནས་དཔོན་རིགས་ཐམས་ཅད་ཤིན་ཏུ་དགྱེས་ཤིང་། རྒྱལ་པོས་མེ་མུ་ཀན་གྱི་གཏམ་བཞིན་དུ་བྱས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་ཁོང་གིས་རྒྱལ་པོའི་ལྗོངས་ཐམས་ཅད་དུ་མི་རིགས་རེ་རེའི་སྐད་རིགས་དང་ཡི་གེ་བཞིན་དུ། སྐྱེས་པ་ཀུན་གྱིས་སོ་སོའི་ཁྱིམ་ནང་དུ་བདག་པོ་བྱེད་པ་དང་བཟའ་མི་རྣམས་ལ་རང་མི་རིགས་ཀྱི་སྐད་ཆ་སྨྲ་བར་འོས་ཞེས་བཀའ་རྒྱ་ཞིག་བཀྲམས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EST/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EST/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NEH/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}