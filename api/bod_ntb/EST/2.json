{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EST","translationId":"bod_ntb","name":"ཨེས་སི་ཐེར།","commonName":"ཨེས་སི་ཐེར།","title":"༄༅། །ཨེས་སི་ཐེར་གྱི་མདོ།","order":17,"numberOfChapters":10,"sha256":"9b18fc6a90e64b53ffd951ec55bd50a4aa28e4d94c16ebf39578d1a7d8d854e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EST/10.json","totalNumberOfVerses":166},"chapter":{"number":2,"content":[{"type":"heading","content":["ཨེས་སི་ཐེར་རྒྱལ་མོའི་ཁྲི་ལ་བཀོད་པ།"]},{"type":"verse","number":1,"content":["དོན་དེའི་རྗེས་སུ་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་ཁོང་ཁྲོ་ཞི་བར་གྱུར་ནས། ཝཱ་སི་ཏི་དང་ཁོ་མོས་ཅི་བྱས་པ་དང་རང་གིས་དེའི་སྐོར་ལ་བཀའ་ཅི་གནང་བའང་དྲན་པ་རེད།"]},{"type":"verse","number":2,"content":["དེ་ནས་ཞབས་ཕྱི་པ་རྣམས་ཀྱིས་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱིས་རང་ཉིད་ཀྱི་ཆེད་དུ་མི་མངགས་ནས་ན་ཆུང་བུ་མོ་རྣམས་འཚོལ་དུ་བཅུག་ན་འོས་ཤིང་།"]},{"type":"verse","number":3,"content":["ལྗོངས་ཀུན་ཏུ་འགོ་དཔོན་བསྐོས་ཏེ། ན་ཆུང་བུ་མོ་ཐམས་ཅད་སོའུ་སཱན་མཁར་ཆེན་གྱི་སྐྱེས་མའི་གླིང་ག་རུ་བསྡུ་དགོས་པ་དང་། ཁོ་མོ་རྣམས་རྒྱལ་པོས་བུད་མེད་རྣམས་ལ་བདག་སྐྱོང་བྱེད་པར་བསྐོས་པའི་ཉུག་རུམ་པ་ཧེ་ག་ཨི་ཡི་ལག་ཏུ་གཏད་ནས། དེ་དག་ལ་མཁོ་བའི་བྱུག་སྣུམ་སྣ་ཚོགས་ཡང་སྟེར་བ་དང་།"]},{"type":"verse","number":4,"content":["དེ་ནས་རྒྱལ་པོས་ཐུགས་དང་ལྡན་པའི་ན་ཆུང་མ་ཞིག་ཝཱ་སི་ཏི་ཡི་ཚབ་ཏུ་རྒྱལ་མོར་མཛད་རོགས་ཞེས་ཞུ་བ་ཞུས་པ་ལ། རྒྱལ་པོས་ཐུགས་སུ་འཕྲོད་ནས་དེ་ལྟར་དུ་མཛད་དོ། །"]},{"type":"verse","number":5,"content":["སོའུ་སཱན་མཁར་ཆེན་དུ་མིང་ལ་མོར་དོ་ཀཱ་ཨི་ཞེས་བྱ་བའི་ཡ་ཧུ་དཱ་པ་ཞིག་ཡོད་ལ། ཁོ་ནི་པེན་ཡཱ་མེན་པ་ཁི་སིའི་ཡང་ཚ་དང་། ཤིམ་ཨི་ཡི་ཚ་བོ་དང་། ཡཱ་ཨིར་གྱི་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["དེ་སྔོན་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཀོན་ཡཱ་དང་བཅས་པ་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་ནས་བཙན་ཁྲིད་བྱས་ནས་ཡོང་དུས། མོར་དོ་ཀཱ་ཨི་ཡང་དེའི་ཁྲོད་ཀྱི་གཅིག་ཡིན།"]},{"type":"verse","number":7,"content":["ཁོས་རང་གི་ཁུ་བོའི་བུ་མོ་ཧ་དས་སཱའམ་ཨེས་སི་ཐེར་བྱ་བ་སྙོར་སྐྱོང་བྱས་པ་ཡིན་ཏེ། གང་ལ་ཞེ་ན། དེ་ལ་ཕ་མ་གཉིས་ཀ་མེད་པ་དང་། ཁོ་མོ་ནི་བྱད་གཟུགས་ཡིད་དུ་འོང་བ་ཞིག་ཡིན་ལ། ཕ་མ་ཤི་བའི་ཚེ་མོར་དོ་ཀཱ་ཨི་ཡིས་དེ་རང་གི་བུ་སྐལ་དུ་བསྙོར་བ་རེད།"]},{"type":"verse","number":8,"content":["རྒྱལ་པོའི་བཀའ་མཆིད་ཁྱབ་བསྒྲགས་བྱས་པ་ན། ན་ཆུང་བུ་མོ་མང་པོ་སོའུ་སཱན་མཁར་ཆེན་དུ་བསྡུས་པ་དང་། བུད་མེད་རྣམས་ལ་བདག་སྐྱོང་བྱེད་མཁན་ཉུག་རུམ་པ་ཧེ་ག་ཨི་ལ་སྤྲད་ཅིང་། ཨེས་སི་ཐེར་ཡང་རྒྱལ་པོའི་ཕོ་བྲང་དུ་བསྐྱལ་ནས་ཧེ་ག་ཨི་ལ་གཏད།"]},{"type":"verse","number":9,"content":["ཧེ་ག་ཨི་ནི་ཨེས་སི་ཐེར་ལ་ཧ་ཅང་བརྩེ་ཞིང་ཁོ་མོ་བྱམས་ཀྱིས་བསྐྱངས་ནས། མྱུར་དུ་ཁོ་མོར་བྱུག་སྣུམ་དང་འབབ་འོས་པའི་སྐལ་ཡང་སྤྲད་དོ། །དེར་མ་ཟད་ཕོ་བྲང་ནས་ཁོ་མོ་ལ་ཞབས་ཞུ་བྱེད་པར་ཞལ་ཏ་མ་བདུན་ཡང་མངགས་པ་དང་། ཁོ་མོ་དང་ཞལ་ཏ་མ་རྣམས་སྐྱེས་མའི་གླིང་གའི་ཁྱིམ་ལེགས་ཤོས་དེར་གནས་སྤར་ཏོ། །"]},{"type":"verse","number":10,"content":["ཨེས་སི་ཐེར་གྱིས་རང་གི་གདུང་རྒྱུད་དང་རིགས་རུས་མི་གཞན་པར་གཏན་ནས་མ་བཤད་དོ། །ཅིའི་ཕྱིར་ཞེ་ན། མོར་དོ་ཀཱ་ཨི་ཡིས་སུ་ལའང་ཤེས་སུ་མི་འཇུག་པར་གདམས་ཡོད་པས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་མོར་དོ་ཀཱ་ཨི་ནི་ཨེས་སི་ཐེར་བདེ་མིན་དང་ཁོ་མོའི་འཚོ་བ་ཇི་ལྟར་ཡིན་པ་ཤེས་པའི་ཕྱིར་དུ། ཉིན་རེ་བཞིན་སྐྱེས་མའི་གླིང་གའི་མདུན་དུ་ཕར་འགྲོ་ཚུར་འགྲོ་བྱས་སོ། །"]},{"type":"verse","number":12,"content":["ལུགས་སྲོལ་ལྟར་དུ། ན་ཆུང་བུ་མོ་རྣམས་ཀྱིས་སྔོན་ལ་ཟླ་བ་བཅུ་གཉིས་རིང་ལ་ལུས་པོར་སྣུམ་བསྐུ་བར་བྱ་བ་སྟེ། ཟླ་བ་དྲུག་གི་རིང་ལ་གུ་གུལ་གྱི་སྣུམ་བསྐུ་ཞིང་། ཡང་ཟླ་བ་དྲུག་ལ་སྤོས་སྣུམ་དང་བྱུག་སྣུམ་འབྱུག་དགོས་པ་དང་། དེ་ནས་སྟ་གོན་མཇུག་རྫོགས་པ་ལ་ན་ཆུང་བུ་མོ་རེ་རེ་རིམ་བཞིན་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་དྲུང་དུ་འགྲོ་བ་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["ན་ཆུང་བུ་མོ་རྣམས་རྒྱལ་པོའི་ཕོ་བྲང་དུ་འགྲོ་ལུགས་ནི་འདི་ལྟ་སྟེ། སྐྱེས་མའི་གླིང་ག་ནས་རྒྱལ་པོའི་དྲུང་དུ་འགྲོ་བའི་དུས་སུ། དེ་ལ་ཅི་ཞིག་མཁོ་བ་ཐམས་ཅད་སྤྲད་ནས་ནང་དུ་ཁྱེར་ཆོག་པ་དང་།"]},{"type":"verse","number":14,"content":["མཚན་མོར་རྒྱལ་པོའི་དྲུང་དུ་སོང་ནས་ཕྱི་ཉིན་སྔ་མོར་སྐྱེས་མའི་གླིང་ག་གཞན་པར་ལོག་དགོས་ཤིང་། བཙུན་མོ་རྣམས་ལ་བདག་སྐྱོང་བྱེད་མཁན་ཉུག་རུམ་པ་སཱ་ཨས་ག་སིའི་ལག་ཏུ་སྤྲོད་པ་དང་། རྒྱལ་པོ་ཁོ་མོར་དགའ་ཞིང་མོས་པ་དང་སླར་ཡང་མིང་བཏོན་ནས་བོས་ན་མ་གཏོགས་ཕྱིན་ཆད་རྒྱལ་པོའི་གམ་དུ་འགྲོ་བ་མིན་ནོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་མོར་དོ་ཀཱ་ཨིས་བུ་སྐལ་དུ་བྱས་པའི་རང་གི་ཁུ་བོ་ཨ་བི་ཧ་ཡིལ་གྱི་བུ་མོ་ཨེས་སི་ཐེར་ཡང་། རིམ་པ་བཞིན་རྒྱལ་པོའི་དྲུང་དུ་འགྲོ་བའི་རེས་ལ་བབས་པ་ན། བུད་མེད་རྣམས་ལ་བདག་སྐྱོང་བྱེད་མཁན་ཉུག་རུམ་པ་ཧེ་ག་ཨི་ཡིས་བཀོད་སྒྲིག་བྱས་པ་མ་གཏོགས་གཞན་གང་ཡང་མ་ཞུས་སོ། །ཨེས་སི་ཐེར་མཐོང་བ་ཐམས་ཅད་ཁོ་མོར་མཉེས་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":16,"content":["དེར་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་སྲིད་སྐྱོང་བའི་ལོ་བདུན་པའི་ཟླ་བཅུ་པ་སྟེ་ཐཱེ་བེད་",{"noteId":0},"ཟླ་བ་ལ། ཨེས་སི་ཐེར་ཡང་ཕོ་བྲང་ནང་རྒྱལ་པོའི་དྲུང་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":17,"content":["རྒྱལ་པོ་ནི་བུད་མེད་གཞན་ཐམས་ཅད་ལས་ཨེས་སི་ཐེར་ལ་དགའ་བར་གྱུར་ཅིང་། རྒྱལ་པོའི་དྲུང་དུ་ན་ཆུང་བུ་མོ་ཀུན་ལས་ཁོ་མོར་བརྩེ་བ་ཆེན་པོ་ཐོབ་པས། རྒྱལ་པོ་ཡིས་རྒྱལ་མོའི་ཅོད་པན་ཁོ་མོའི་མགོ་ལ་བསྐོན་པ་དང་། ཁོ་མོ་ཝཱ་སི་ཏིའི་ཚབ་ཏུ་རྒྱལ་མོར་བསྐོས་སོ། །"]},{"type":"verse","number":18,"content":["རྒྱལ་པོས་ཨེས་སི་ཐེར་གྱི་རྐྱེན་གྱིས་ས་གནས་དཔོན་རིགས་དང་འཁོར་གཡོག་ཐམས་ཅད་ལ་གསོལ་སྟོན་གཟབ་རྒྱས་བཤམས་ཤིང་། ལྗོངས་སོ་སོར་གུང་གསེང་གནང་བར་མ་ཟད། མི་ཐམས་ཅད་ལ་གཏོང་ཕོད་ཆེན་པོས་གསོལ་རས་ཀྱང་བསྩལ་ཏོ། །"]},{"type":"heading","content":["མོར་དོ་ཀཱ་ཨིས་ལྐོག་ཇུས་ཞུ་གཏུག་བྱས་པ།"]},{"type":"verse","number":19,"content":["ཡང་ཐེངས་གཉིས་པར་ན་ཆུང་བུ་མོ་རྣམས་བསྡུ་བའི་ཚེ། མོར་དོ་ཀཱ་ཨི་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྒོ་ཁར་བསྡད།"]},{"type":"verse","number":20,"content":["ཨེས་སི་ཐེར་གྱིས་མོར་དོ་ཀཱ་ཨིས་བསྒོས་པ་བཞིན་དུ་རང་གི་གདུང་རྒྱུད་དང་རིགས་རུས་གཞན་ལ་མ་བཤད། སྔོན་ཆད་མོར་དོ་ཀཱ་ཨིས་རང་ཉིད་སྐྱོང་བའི་དུས་སུ་ཇི་ལྟར་ཁོང་གི་ཁ་ལ་མཉན་པ་བཞིན་དུ། ཁོ་མོས་ཁོང་གི་བཀའ་བཞིན་བྱས་པ་རེད།"]},{"type":"verse","number":21,"content":["དེའི་ཚེ་མོར་དོ་ཀཱ་ཨི་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྒོ་ཁར་བསྡད་པ་ལ། ཉུག་རུམ་པའི་ཁྲོད་དུ་པིག་ཐན་དང་ཐེ་རེ་སི་ཞེས་བྱ་བའི་ནང་སྒོ་སྲུང་མཁན་མི་གཉིས་ཡོད་པ་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ལ་རབ་ཏུ་ཁྲོས་ཤིང་། ཁོང་ལྐོག་གསོད་བྱེད་པའི་རེ་ངན་བཅངས་པ་དང་།"]},{"type":"verse","number":22,"content":["མོར་དོ་ཀཱ་ཨི་ཡིས་དོན་དེ་ཤེས་ནས་རྒྱལ་མོ་ཨེས་སི་ཐེར་ལ་བཤད་པ་དང་། ཨེས་སི་ཐེར་གྱིས་མོར་དོ་ཀཱ་ཨིའི་ངོ་ཚབ་བྱས་ནས་རྒྱལ་པོར་ཞུས་སོ། །"]},{"type":"verse","number":23,"content":["རྒྱལ་པོས་བྱ་བ་དེ་ལ་ཞིབ་བཤེར་གནང་སྟེ་དོན་དངོས་ཡིན་པ་ཤེས་ནས། མི་དེ་གཉིས་གདུང་མའི་སྟེང་དུ་དཔྱངས་པ་དང་། ཡང་གནས་ཚུལ་འདི་རྒྱལ་པོའི་དྲུང་གི་ལོ་རྒྱུས་ཀྱི་དེབ་ཐེར་ནང་དུ་བཀོད་དོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ཐཱེ་བེད་ཅེས་པ་ནི་ཟླ་བཅུ་པར་གོ་བ་ཡིན།","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/bod_ntb/EST/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EST/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EST/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}