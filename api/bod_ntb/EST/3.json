{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EST","translationId":"bod_ntb","name":"ཨེས་སི་ཐེར།","commonName":"ཨེས་སི་ཐེར།","title":"༄༅། །ཨེས་སི་ཐེར་གྱི་མདོ།","order":17,"numberOfChapters":10,"sha256":"9b18fc6a90e64b53ffd951ec55bd50a4aa28e4d94c16ebf39578d1a7d8d854e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EST/10.json","totalNumberOfVerses":166},"chapter":{"number":3,"content":[{"type":"heading","content":["ཧ་མཱན་གྱིས་ཡ་ཧུ་དཱ་པ་རྣམས་ཚར་གཅོད་བྱེད་པའི་ལྐོག་ཇུས་བཤམས་པ།"]},{"type":"verse","number":1,"content":["དོན་དེའི་རྗེས་སུ་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་ཨ་གག་",{"noteId":1},"པ་ཧམ་མེ་དཱ་ཐའི་བུ་ཧ་མཱན་ཞེས་བྱ་བ་ཆེན་པོར་བརྩིས་ནས་བསྐོ་འཐེན་བྱས་ཤིང་། དེའི་གོ་གནས་ནི་ཁོ་དང་མཉམ་དུ་ཡོད་པའི་དཔོན་རིགས་ཀུན་ལས་མཐོ་བར་བྱས།"]},{"type":"verse","number":2,"content":["ཡང་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྒོ་ཁར་ཡོད་པའི་འཁོར་གཡོག་རྣམས་ཀྱིས་ཧ་མཱན་ལ་མགོ་བསྒུར་ནས་ཕྱག་བཙལ་ཏོ། །ཅིའི་ཕྱིར་ཞེ་ན། རྒྱལ་པོས་དེ་ལྟ་བུའི་བཀའ་གནང་ཡོད་པ་ཡིན། འོན་ཀྱང་། མོར་དོ་ཀཱ་ཨི་ཡིས་ཧ་མཱན་ལ་མགོ་མ་སྒུར་ཕྱག་ཀྱང་མ་བཙལ་ཏོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྒོ་ཁར་ཡོད་པའི་འཁོར་གཡོག་རྣམས་ཀྱིས་མོར་དོ་ཀཱ་ཨི་ལ། ཁྱོད་རང་ཅིའི་ཕྱིར་རྒྱལ་པོའི་བཀའ་དང་འགལ་ལམ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":4,"content":["དེ་དག་གིས་ཉིན་རེ་བཞིན་ཁོ་ལ་སྐུལ་འདེབས་བྱས་ཀྱང་། ཁོས་སྔར་བཞིན་མ་མཉན་པ་རེད། དེ་བས་མོར་དོ་ཀཱ་ཨི་ཡིས་རང་ཉིད་ཡ་ཧུ་དཱ་པ་ཡིན་",{"noteId":2},"ཟེར་བའི་གཏམ་དེ་དོན་ལ་གནས་མིན་ལ་བལྟ་བའི་ཆེད་དུ། དེ་དག་གིས་ཧ་མཱན་ལ་སྨྲས་སོ། །"]},{"type":"verse","number":5,"content":["མོར་དོ་ཀཱ་ཨི་ཡིས་མགོ་མི་སྒུར་ལ་ཕྱག་ཀྱང་མི་འཚལ་བ་མཐོང་ནས་ཧ་མཱན་ཤིན་ཏུ་ཁྲོས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་རྣམས་ཀྱིས་མོར་དོ་ཀཱ་ཨི་ཡི་རིགས་རྒྱུད་ཅི་ཡིན་པ་ཧ་མཱན་ལ་སྨྲས་པས། ཁོའི་བསམ་པར་མོར་དོ་ཀཱ་ཨི་གཅིག་པུ་གསོད་པ་ནི་དོན་ཆུང་ངུ་ཡིན་པས། མོར་དོ་ཀཱ་ཨི་ཡི་མི་མང་སྟེ། རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་རྒྱལ་ཁམས་སུ་གནས་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་རྩ་མེད་དུ་གཏོང་དགོས་པར་འདོད་དོ། །"]},{"type":"verse","number":7,"content":["རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་སྲིད་སྐྱོང་བའི་ལོ་བཅུ་གཉིས་པའི་ཟླ་བ་དང་པོ་སྟེ་ནེ་སཱན་ཟླ་བར། དེ་དག་གིས་ཟླ་ཚེས་ཐག་གིས་གཅོད་པའི་ཆེད་དུ་ཉིན་རེ་བཞིན་དང་ཟླ་རེ་བཞིན་ཧ་མཱན་གྱི་མདུན་ནས་པུར་ཞེས་པའི་རྒྱན་བླངས་པ་ལ་ཟླ་བཅུ་གཉིས་པ་སྟེ་ཨ་དཱར་ཟླ་བ་ལ་བབས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་ཧ་མཱན་གྱིས་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ལ། ཁྱེད་ཀྱི་རྒྱལ་ཁམས་ནང་དུ་མི་རིགས་གཅིག་ནི་ལྗོངས་སོ་སོའི་མི་རིགས་ཁྲོད་ཁ་འཐོར་དུ་གནས་པ་དང་། དེའི་ལུགས་སྲོལ་ནི་མི་ཐམས་ཅད་ཀྱི་ལུགས་སྲོལ་དང་མི་མཐུན་ལ། རྒྱལ་པོའི་ཁྲིམས་སྲོལ་ཡང་མི་བསྲུང་བས། དེ་རྣམས་སྐྱོང་བ་ནི་རྒྱལ་པོར་ཕན་ཐོགས་མེད་པ་རེད།"]},{"type":"verse","number":9,"content":["དེ་བས་རྒྱལ་པོ་ཁྱེད་རང་ཐུགས་དགྱེས་ན། དེ་རྣམས་རྩ་མེད་གཏོང་བའི་བཀའ་མཆིད་གནང་བར་མཛོད་དང་། བདག་གིས་རྒྱལ་པོའི་གཏེར་མཛོད་ཁང་གི་བདག་གཉེར་བྱེད་མཁན་རྣམས་ཀྱི་ལག་ཏུ་དངུལ་གྱི་རྡོ་ཚད་ཆིག་ཁྲི་འབུལ་བར་བྱའོ་ཞེས་ཞུས་པས།"]},{"type":"verse","number":10,"content":["རྒྱལ་པོས་རང་ཉིད་ཀྱི་ཕྱག་གི་ཐམ་ག་དང་ལྡན་པའི་མཛུབ་དཀྲིས་ཕུད་ནས། ཡ་ཧུ་དཱ་པ་རྣམས་ལ་བཙན་གནོན་གཏོང་མཁན་ཨ་གག་པ་ཧམ་མེ་དཱ་ཐའི་བུ་ཧ་མཱན་ལ་གནང་སྟེ།"]},{"type":"verse","number":11,"content":["ཧ་མཱན་ལ། དངུལ་ནི་ཁྱོད་ལ་གནང་བ་དང་། མི་འདི་རྣམས་ཀྱང་ཁྱོད་ལ་སྤྲད་པ་ཡིན། དེ་དག་ལ་ཁྱོད་ཀྱིས་གང་དགར་གྱིས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་ཟླ་བ་དང་པོའི་ཚེས་བཅུ་གསུམ་ཉིན་ལ། རྒྱལ་པོའི་དྲུང་ཡིག་དག་བོས་ཡོང་སྟེ། ཧ་མཱན་གྱིས་བསྒོས་པ་བཞིན་དུ་ལྗོངས་སོ་སོའི་ཡི་གེ་དང་མི་རིགས་སོ་སོའི་སྐད་ཀྱིས་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོའི་མིང་ལ་བརྟེན་ནས་བཀའ་མཆིད་བྲིས་ཤིང་། ཡང་རྒྱལ་པོའི་མཛུབ་དཀྲིས་ཀྱིས་ཕྱག་རྒྱ་བཏབ་ནས། རྒྱལ་པོའི་སྤྱི་དཔོན་དང་ལྗོངས་སོ་སོའི་འགོ་བདག་དང་། མི་རིགས་རེ་རེའི་དཔོན་རིགས་སོགས་ལ་བསྒྲགས།"]},{"type":"verse","number":13,"content":["ཟླ་བ་བཅུ་གཉིས་པ་སྟེ་ཨ་དཱར་ཟླ་བའི་ཚེས་བཅུ་གསུམ་པ་ལ། ཡ་ཧུ་དཱ་པའི་སྐྱེས་པ་རྒན་གཞོན་ཐམས་ཅད་བུད་མེད་བྱིས་པ་དང་བཅས་པ་ཉིན་གཅིག་ཏུ་ཡོངས་རྫོགས་བསད་ནས་ཚར་གཅོད་པར་མ་ཟད། དེ་དག་གི་རྒྱུ་ནོར་ཡང་འཕྲོག་པའི་བཀའ་ཤོག་དེ་བང་ཆེན་བརྒྱུད་ནས་རྒྱལ་པོའི་ལྗོངས་སོ་སོར་བསྐྱལ།"]},{"type":"verse","number":14,"content":["བཀའ་ཤོག་དེ་ནི་འདྲ་བཤུས་བགྱིས་ཏེ་ལྗོངས་ཐམས་ཅད་ཀྱི་ཁྲིམས་སུ་ཕབ་ནས། ཉིན་དེར་གྲ་སྒྲིག་བྱེད་པའི་དོན་དུ་མི་རིགས་ཀུན་ལ་ཁྱབ་བསྒྲགས་བྱས་སོ། །"]},{"type":"verse","number":15,"content":["བང་ཆེན་རྣམས་རྒྱལ་པོའི་བཀའ་བཞིན་མྱུར་དུ་ལམ་ལ་ཆས་པ་དང་། སོའུ་སཱན་མཁར་ཆེན་ཧྲིལ་པོར་བཀའ་མཆིད་ཁྱབ་བསྒྲགས་བྱས་སོ། །རྒྱལ་པོས་ཧ་མཱན་དང་མཉམ་དུ་ཆང་བཞེས་ནས་བསྡད་མོད། སོའུ་སཱན་མཁར་ཆེན་གྱི་འབངས་མི་རྣམས་འཁྲུགས་པར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":1,"caller":"+","text":"ཨ་གག་ཅེས་པ་ནི་གནའ་བོའི་ཨ་མཱད་ལེག་མི་རིགས་ཀྱི་རྒྱལ་པོ་ཞིག་ཡིན་ལ། དེའི་དུས་སུ་ཨ་མཱད་ལེག་མི་རིགས་ནི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་དགྲ་ཟླ་ཡིན།","reference":{"chapter":3,"verse":1}},{"noteId":2,"caller":"+","text":"འདིར་རང་ཉིད་ཡ་ཧུ་དཱ་པ་ཡིན་ཞེས་པ་ནི་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ལས་གཞན་སུ་དང་གང་ལའང་ཕྱག་མི་འཚལ་བའི་དོན་ལ་འཇུག","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/bod_ntb/EST/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EST/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EST/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}