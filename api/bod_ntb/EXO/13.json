{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":13,"content":[{"type":"heading","content":["སྐྱེས་འགོ་ཀུན་དམ་པར་བྱེད་པའི་སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་སྐྱེས་འགོ་ནི་མི་ཕྱུགས་གང་ཡིན་རུང་དེ་དག་བདག་གི་ཡིན་ཏེ། ཁོ་རྣམས་ཐམས་ཅད་ང་ལ་དམ་པར་གྱིས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་མོ་ཤེ་ཡིས་མི་རྣམས་ལ། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་གྱི་བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཐོན་པའི་ཉིན་འདི་རྗེས་སུ་དྲན་པར་གྱིས་ཤིག དཀོན་མཆོག་ཡ་ཝཱེས་ནུས་མཐུ་ཆེན་པོའི་ཕྱག་གིས་ཁྱོད་རྣམས་ཡུལ་དེ་ནས་ཕྱི་རུ་ཁྲིད་པས། སྐྱུར་རྩི་ཅན་གང་ཡང་བཟའ་མི་རུང་།"]},{"type":"verse","number":4,"content":["ཨ་རྦིབ་ཟླ་བའི་ཉིན་འདི་ལ་ཁྱོད་རྣམས་ཕྱི་རོལ་ཏུ་ཐོན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཀ་ན་ཨན་པ་དང་། ཧེད་པ་དང་། ཨེ་མོར་པ་དང་། ཧེ་བི་པ་དང་། ཡེ་བུ་སི་པ་རྣམས་ཀྱི་ཡུལ་ཏེ། འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་དེ་ཁྱོད་ཅག་གི་ཕ་མེས་ཡང་མེས་རྣམས་ལ་མནའ་བཞེས་པ་བཞིན་ཁྱོད་རྣམས་ལ་གནང་ངེས་ཤིང་། ཁོང་གིས་ཁྱོད་རྣམས་དེ་ལ་འཁྲིད་པར་འགྱུར་བ་དང་། དེའི་དུས་སུ་ཟླ་བ་འདི་ལ་ཁྱོད་རྣམས་ཀྱིས་ཁྲིམས་སྲོལ་བསྲུང་དགོས་པ་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":6,"content":["ཉིན་བདུན་གྱི་རིང་ཁྱོད་རྣམས་ཀྱིས་སྐྱུར་མེད་བག་ལེབ་ཟོ་ལ། ཉིན་བདུན་པར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དུས་ཆེན་བསྲུང་བར་བྱའོ།"]},{"type":"verse","number":7,"content":["ཉིན་བདུན་པོའི་རིང་ལ་སྐྱུར་མེད་བག་ལེབ་བཟའ་དགོས་ཤིང་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་སྐྱུར་རྩི་ཅན་གང་ཡང་མཐོང་མི་འོས། ཁྱོད་རྣམས་ཀྱི་ཡུལ་ཐམས་ཅད་ནས་ཀྱང་སྐྱུར་རྩི་མཐོང་མི་རུང་།"]},{"type":"verse","number":8,"content":["ཡང་ཉིན་དེར་ཁྱོད་རྣམས་ཀྱིས་རང་གི་བུ་ལ། འདི་ནི་ང་རང་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཐོན་པའི་སྐབས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་ལ་དེ་ལྟར་མཛད་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲ་དགོས།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ནུས་མཐུ་ཆེན་པོའི་ཕྱག་གིས་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པའི་རྐྱེན་གྱིས། ཁྲིམས་སྲོལ་འདི་ནི་ཁྱོད་རྣམས་ཀྱི་ལག་པར་བཏབ་པའི་རྟགས་ཐམ་དང་། ཁྱོད་རྣམས་ཀྱི་དཔྲལ་བར་ཡོད་པའི་རྗེས་དྲན་དུ་འགྱུར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་ནི་དུས་རྒྱུན་ཁྱོད་རྣམས་ཀྱི་ངག་ཏུ་ཡོད་པར་བྱའོ། །"]},{"type":"verse","number":10,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ཁྲིམས་སྲོལ་འདི་ལོ་རེ་ནས་ལོ་རེ་བཞིན་དུས་ཚོད་ལྟར་བསྲུང་དགོས་སོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་སྔར་ཁྱོད་དང་ཁྱོད་རྣམས་ཀྱི་ཕ་མེས་ཡང་མེས་ལ་མནའ་བཞེས་པ་བཞིན་དུ། མ་འོངས་པར་ཁྱོད་རྣམས་ཀ་ན་ཨན་པའི་ཡུལ་དུ་ཁྲིད་ནས་ཡུལ་དེ་ཁྱོད་ཅག་ལ་གནང་བའི་ཚེ།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་ཀྱིས་སྐྱེས་འགོ་ཀུན་དང་། ཡང་ཁྱོད་རྣམས་ཀྱི་ཕྱུགས་ཕྲུག་འགོ་མ་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས་ལ། ཕོ་ཡིན་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་བོང་ཕྲུག་འགོ་མ་ཐམས་ཅད་ནི་ལུ་གུ་ཞིག་གིས་བླུ་དགོས། ཅི་སྟེ་བླུ་བར་མ་བྱས་ན་དེའི་སྐེ་ཚིགས་རྫོག་ཅིག ཁྱོད་རྣམས་ཀྱི་བུ་སྐྱེས་འགོ་ཐམས་ཅད་བླུ་དགོས།"]},{"type":"verse","number":14,"content":["མ་འོངས་པར་ཁྱོད་རྣམས་ཀྱི་བུ་ཡིས་དེའི་དོན་ཅི་ཡིན་པ་ཁྱོད་རྣམས་ལ་འདྲི་བའི་ཚེ། ཁྱོད་ཅག་གིས་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ནུས་མཐུ་ཆེན་པོའི་ཕྱག་གིས་ངེད་རྣམས་ཨེ་ཅིབ་ཡུལ་གྱི་བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཕྱི་རུ་ཁྲིད་པར་མཛད་ཅིང་།"]},{"type":"verse","number":15,"content":["ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོ་ཡིན་ཞིང་ངེད་རྣམས་འགྲོ་རུ་མི་འཇུག་པ་ཙམ་བྱས་པའི་སྐབས་སུ། དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཡུལ་གྱི་སྐྱེས་འགོ་ཐམས་ཅད་དེ་མིའི་སྐྱེས་འགོ་ནས་ཕྱུགས་ཕྲུག་འགོ་མའི་བར་དུ་བཀུམས། དེའི་ཕྱིར་ངས་ཕྱུགས་ཕྲུག་འགོ་མ་ཕོ་ཡིན་པ་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ། འོན་ཀྱང་བུ་སྐྱེས་འགོ་ཐམས་ཅད་བླུ་བ་ཡིན་ཞེས་སྨྲ་དགོས།"]},{"type":"verse","number":16,"content":["དོན་འདི་ནི་ཁྱོད་རྣམས་ཀྱི་ལག་པར་བཏབ་པའི་རྟགས་ཐམ་དང་དཔྲལ་བ་རུ་མཚོན་བྱེད་ཡིན་དགོས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་ནུས་མཐུ་ཆེན་པོའི་ཕྱག་གིས་རང་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རོལ་ཏུ་ཁྲིད་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["ཡང་ཕཱར་ཨོལ་གྱིས་མི་འགྲོ་རུ་བཅུག་པའི་དུས་སུ། ཕེ་ལེ་ཤེད་ཡུལ་གྱི་ལམ་ཐག་ཉེ་ནའང་དཀོན་མཆོག་གིས་དེ་དག་ཡུལ་དེ་བརྒྱུད་ནས་མ་ཁྲིད་དོ། །ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་གི་ཐུགས་སུ་མི་རྣམས་ཀྱིས་དམག་འཁྲུག་འབྱུང་བ་མཐོང་ན་འགྱོད་ཅིང་ཨེ་ཅིབ་ཡུལ་དུ་ཕྱིར་ལོག་ཉེན་ཆེ་བར་དགོངས་པས་སོ། །"]},{"type":"verse","number":18,"content":["དེའི་ཕྱིར། དཀོན་མཆོག་གིས་མི་རྣམས་རྒྱ་མཚོ་དམར་པོའི་འགྲམ་གྱི་དབེན་སྟོང་ལ་ལམ་བསྐོར་ནས་ཁྲིད་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་དམག་ཆས་དང་བཅས་པ་ཨེ་ཅིབ་ཡུལ་ནས་ཡར་སོང་།"]},{"type":"verse","number":19,"content":["མོ་ཤེ་ཡིས་ཡོ་སེབ་ཀྱི་རུས་པའང་མཉམ་དུ་ཁྱེར་ཏོ། །གང་ལ་ཟེར་ན། ཡོ་སེབ་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་མནའ་སྐྱེལ་དུ་བཅུག་ཅིང་། ཁོ་རྣམས་ལ་འདི་ལྟར། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ལ་གཟིགས་སྐྱོང་གནང་བར་འགྱུར། ཁྱོད་ཅག་གིས་ངའི་རུས་པ་འདི་ནས་འཁྱེར་དགོས་ཞེས་བཀའ་གནང་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཁོ་རྣམས་སོའུ་ཀོད་ཡུལ་ནས་ཆས་ཏེ་དབེན་སྟོང་གི་ལོགས་སུ་ཨེ་ཐཱམ་བྱ་བའི་གནས་སུ་སྒར་བཏབ།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཉིན་མོའི་དུས་སུ་སྤྲིན་གྱི་ཀ་བ་ཞིག་གི་དབྱིབས་ནས་ཁོ་རྣམས་ལ་ལམ་ཁྲིད་པ་དང༌། མཚན་མོར་མེའི་ཀ་བ་ཞིག་གི་དབྱིབས་ནས་དེ་རྣམས་ལ་འོད་སྤྲོས་ཏེ། ཁོ་རྣམས་ཉིན་མཚན་ཀུན་ཏུ་འགྲོ་ནུས་པར་མཛད།"]},{"type":"verse","number":22,"content":["ཉིན་མོར་སྤྲིན་གྱི་ཀ་བ་དང་མཚན་མོར་མེའི་ཀ་བ་ནི་ནམ་ཡིན་ཡང་མི་རྣམས་དང་ཁ་མ་བྲལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}