{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":14,"content":[{"type":"heading","content":["རྒྱ་མཚོ་དམར་པོ་བརྒལ་བ།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཕྱིར་ལོག་སྟེ་མིག་དོལ་དང་རྒྱ་མཚོའི་བར་གྱི་ཕི་ཧཱ་ཧི་རོད་བྱ་བའི་མདུན་དུ། པཱ་ཨལ་ཚཱ་ཕོན་ཁ་གཏད་ཀྱི་རྒྱ་མཚོའི་འགྲམ་ལ་སྒར་འདེབས་པའི་བཀའ་སྒོས་ཤིག"]},{"type":"verse","number":3,"content":["དེ་ནས་ཕཱར་ཨོལ་གྱི་སེམས་སུ་ཡེས་ར་ཨེལ་པ་རྣམས་ཡུལ་འདི་རུ་མགོ་འཐོམས་ཏེ་དབེན་སྟོང་གིས་དེ་དག་འགོག་བཞིན་འདུག་སྙམ་ངེས།"]},{"type":"verse","number":4,"content":["བདག་གིས་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་བྱས་ཏེ། ཁོས་དེ་དག་གི་རྗེས་འདེད་པ་དང་། ཕཱར་ཨོལ་དང་དེའི་དམག་དཔུང་དང་བཅས་པ་ལས་བདག་ལ་གཟི་བརྗིད་ལྡན་པར་འགྱུར་ཞིང་། ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་བཞིན་དུ་བྱས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་ཨེ་ཅིབ་རྒྱལ་པོར་མི་རྣམས་བྲོས་སོང་ཞེས་གཞན་ཞིག་གིས་སྨྲས་པ་ལ། ཕཱར་ཨོལ་དང་དེའི་འཁོར་གཡོག་རྣམས་མི་རྣམས་ཀྱི་ཕྱོགས་སུ་སེམས་འགྱུར་ནས། ངེད་རྣམས་ལ་གཡོག་བྱེད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་འགྲོ་རུ་བཅུག་ཅིང་། ངེད་རྣམས་ཀྱིས་དོན་ཅི་འདྲ་བ་བྱས་སམ་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":6,"content":["ཕཱར་ཨོལ་གྱིས་རང་གི་ཤིང་རྟ་སྟ་གོན་བྱས་ཤིང་། དམག་དཔུང་ཁྲིད་ནས་སོང་བ་སྟེ།"]},{"type":"verse","number":7,"content":["ཤིང་རྟ་མཆོག་ཏུ་གྱུར་པ་དྲུག་བརྒྱ་དང་། ཨེ་ཅིབ་ཡུལ་གྱི་ཤིང་རྟ་ཇི་ཙམ་ཡོད་པ་ཐམས་ཅད་དང་། དེ་ཐམས་ཅད་ཀྱི་འགོ་དཔོན་རྣམས་མཉམ་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཡུལ་གྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་མཛད་པས། ཁོ་སྤོབས་པ་ཆེན་པོའི་ངང་ནས་ཕར་འགྲོ་བཞིན་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ར་མདར་བརྒྱུགས།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་དེ་དག་གི་རྗེས་དེད་དེ། ཕཱར་ཨོལ་གྱི་རྟ་དང་ཤིང་རྟ་ཐམས་ཅད་དང་། སྐྱ་དམག་རྣམས་དང་། དམག་དཔུང་བཅས་ཕི་ཧཱ་ཧི་རོད་ཀྱི་ཉེ་སར། པཱ་ཨལ་ཚཱ་ཕོན་གྱི་ཁ་གཏད་དུ་རྒྱ་མཚོའི་འགྲམ་ལ་ཡོད་པའི་སྒར་འདེབས་ས་རུ་རྗེས་ཆོད་དོ། །"]},{"type":"verse","number":10,"content":["ཕཱར་ཨོལ་ཉེ་བར་སླེབས་པའི་དུས་སུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཡར་བལྟས་པ་དང་། ལྟོས་ཤིག ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་རྗེས་དེད་ནས་ཡོང་བཞིན་པ་མཐོང་ནས་ཤིན་ཏུ་འཇིགས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ངུ་འབོད་བྱས་པ་དང་།"]},{"type":"verse","number":11,"content":["མོ་ཤེ་ལ་འདི་ལྟར། ཨེ་ཅིབ་ཡུལ་དུ་དུར་ས་མེད་པས་ཁྱོད་ཀྱིས་ང་ཚོ་དབེན་སྟོང་ལ་འཆི་བར་ཁྲིད་དམ། ཁྱོད་ཀྱིས་ངེད་རྣམས་ལ་འདི་ལྟར་བྱས་ཏེ་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཁྲིད་འོངས་པ་ཅི་ཡིན།"]},{"type":"verse","number":12,"content":["ངེད་ཅག་གིས་ཨེ་ཅིབ་ཡུལ་ནས་ཁྱོད་ལ། ངེད་རྣམས་འདིར་བསྐྱུར་ནས་ཨེ་ཅིབ་པ་རྣམས་ལ་གཡོག་བྱེད་དུ་ཆུག་ཅེས་སྨྲས་པ་མ་ཡིན་ནམ། ཅིའི་ཕྱིར་ཞེ་ན། དབེན་སྟོང་དུ་འཆི་བ་ལས་ཨེ་ཅིབ་པ་རྣམས་ལ་གཡོག་བྱས་ན་ལེགས་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་མོ་ཤེ་ཡིས་མི་རྣམས་ལ་འདི་ལྟར། མི་འཇིགས་པར་བརྟན་པོར་སྡོད་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རིང་ཉིན་མོར་ཁྱོད་ཅག་ལ་གནང་ངེས་པའི་ཐར་པ་ལ་ལྟོས་དང་། དེ་རིང་ཉིན་མོར་ཁྱོད་རྣམས་ཀྱིས་མཐོང་བའི་ཨེ་ཅིབ་པ་དེ་དག་ནི་ཕྱིས་སུ་ནམ་ཡང་མཐོང་བར་མི་འགྱུར།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཅག་ལྷོད་ལྷོད་གྱིས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་གི་དོན་དུ་འཐབ་མོ་མཛད་ངེས་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ང་ལ་ངུ་འབོད་བྱེད་དོན་ཅི། ཡེས་ར་ཨེལ་པ་རྣམས་མདུན་དུ་འགྲོ་བའི་བཀའ་གནོངས་ཤིག"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱིས་འཁར་བ་ཡར་བཀྱགས་ནས་ལག་པ་རྒྱ་མཚོའི་ཕྱོགས་སུ་རྐྱོངས་ལ་མཚོ་ཁག་གཉིས་སུ་ཕྱེས་ཤིག ཡེས་ར་ཨེལ་པ་རྣམས་རྒྱ་མཚོའི་དཀྱིལ་ནས་སྐམ་སའི་སྟེང་དུ་བགྲོད་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["ལྟོས་དང་། ངས་ཨེ་ཅིབ་པ་རྣམས་ཀྱི་སེམས་གྱོང་པོར་བྱས་ཏེ་ཁོ་རྣམས་དེ་དག་གི་རྗེས་དེད་ནས་འགྲོ་བ་དང་། ཕཱར་ཨོལ་དང་དེའི་དམག་དཔུང་དང་། ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་བརྒྱུད་ནས་བདག་ལ་གཟི་བརྗིད་ལྡན་པར་འགྱུར།"]},{"type":"verse","number":18,"content":["ཡང་ཕཱར་ཨོལ་དང་དེའི་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་བརྒྱུད་ནས་བདག་ལ་གཟི་བརྗིད་ཐོབ་པའི་ཚེ། ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":19,"content":["ཡེས་ར་ཨེལ་གྱི་སྒར་གྱི་སྔོན་ལ་སྐྱོད་པའི་དཀོན་མཆོག་གི་ཕོ་ཉ་ནི་དེ་དག་གི་རྒྱབ་ཏུ་སླེབས་ཤིང་། སྤྲིན་གྱི་ཀ་བ་ཡང་དེ་དག་གི་མདུན་ཕྱོགས་ནས་སོང་སྟེ་རྒྱབ་ཏུ་འགྲེང་ནས་བཞུགས།"]},{"type":"verse","number":20,"content":["དེ་ལྟར་ཨེ་ཅིབ་པ་རྣམས་ཀྱི་སྒར་དང་ཡེས་ར་ཨེལ་གྱི་སྒར་གཉིས་ཀྱི་བར་དུ་སྤྲིན་གྱི་ཀ་བ་བཞུགས་ཤིང་། ཕྱོགས་གཅིག་ནི་མུན་ནག་ཡིན་ཡང་ཅིག་ཤོས་སུ་འོད་འཕྲོ་བ་ཡིན་པས། མི་དེ་དག་མཚན་གང་པོར་ཕན་ཚུན་ཉེ་བར་མ་བཅར་ཏོ། །"]},{"type":"verse","number":21,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ལག་པ་རྒྱ་མཚོའི་ཕྱོགས་སུ་བརྐྱངས་པ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་མཚན་གང་པོར་ཤར་རླུང་དྲག་པོ་གཡུག་ཏུ་བཅུག་ནས། མཚོ་དེད་ཅིང་སྐམ་སར་མཛད་དེ་ཆུ་ཁག་གཉིས་སུ་ཕྱེས།"]},{"type":"verse","number":22,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་རྒྱ་མཚོའི་དཀྱིལ་ནས་སྐམ་སར་འགྲུལ་ཏེ། ཆུ་ནི་གཡས་གཡོན་དུ་ལྕགས་རི་ལྟར་གྲུབ།"]},{"type":"verse","number":23,"content":["ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་རྗེས་དེད་ཅིང་། ཕཱར་ཨོལ་གྱི་རྟ་རྣམས་དང་། ཤིང་རྟ། སྐྱ་དམག་བཅས་ཐམས་ཅད་དེ་རྣམས་ཀྱི་རྗེས་དེད་ནས་རྒྱ་མཚོའི་དཀྱིལ་དུ་སོང་།"]},{"type":"verse","number":24,"content":["ནམ་ལངས་པའི་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་མེ་དང་སྤྲིན་གྱི་ཀ་བ་ནས་ཨེ་ཅིབ་པའི་དམག་དཔུང་ལ་གཟིགས་ཏེ་ཁོ་རྣམས་འཁྲུག་པར་མཛད།"]},{"type":"verse","number":25,"content":["ཡང་ཁོང་གིས་ཤིང་རྟ་རྣམས་ཀྱི་འཁོར་ལོ་བཏོན་པ་དང་། ཤིང་རྟ་དེ་དག་འདེད་དཀའ་བར་གྱུར་པས། ཨེ་ཅིབ་པ་རྣམས་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཀྱི་ཕྱིར་དུ་བདག་ཅག་ལ་རྒོལ་བས། ཡེས་ར་ཨེལ་གྱི་མདུན་ནས་འབྲོ་བར་བྱའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཨེ་ཅིབ་པ་དང་དེ་དག་གི་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་ཀྱི་ཐོག་ལ་ཆུ་འབབ་པའི་ཕྱིར། ཁྱོད་ཀྱིས་ལག་པ་རྒྱ་མཚོའི་ཕྱོགས་སུ་རྐྱོངས་ཤིག་ཅེས་གསུངས་པ་ལ།"]},{"type":"verse","number":27,"content":["མོ་ཤེ་ཡིས་ལག་པ་རྒྱ་མཚོའི་ཕྱོགས་སུ་བརྐྱངས་ཤིང་། ཐོ་རངས་ཀྱི་དུས་སུ་རྒྱ་མཚོ་ནི་སྔར་དང་འདྲ་བར་གྱུར། ཨེ་ཅིབ་པ་རྣམས་དེའི་ཐད་དུ་བྲོས་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་རྒྱ་མཚོའི་དཀྱིལ་དུ་མགོ་རྟིང་བསློགས་པར་མཛད།"]},{"type":"verse","number":28,"content":["དེ་ལྟར་ཆུ་ནི་ཕྱིར་བཞུར་ཏེ་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྗེས་དེད་ནས་རྒྱ་མཚོའི་ནང་དུ་སོང་བའི་ཕཱར་ཨོལ་གྱི་དམག་དཔུང་ཐམས་ཅད་བསྣུབས་ཤིང་གཅིག་ཀྱང་མ་ལུས་སོ། །"]},{"type":"verse","number":29,"content":["འོན་ཀྱང་ཡེས་ར་ཨེལ་པ་རྣམས་རྒྱ་མཚོའི་དཀྱིལ་དུ་སྐམ་སར་འགྲུལ་ཏེ། ཆུ་ནི་དེ་དག་གི་གཡས་གཡོན་དུ་ལྕགས་རི་ལྟར་གྲུབ།"]},{"type":"verse","number":30,"content":["ཉིན་མོ་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལྟར་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་པ་དག་གི་ལག་ནས་ཐར་བར་མཛད་ཅིང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཨེ་ཅིབ་པ་དག་གི་བེམ་པོ་རྣམས་རྒྱ་མཚོའི་འགྲམ་དུ་ཡོད་པ་མཐོང་།"]},{"type":"verse","number":31,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་པ་རྣམས་ལ་མཛད་པའི་ནུས་མཐུ་ཆེན་པོ་དེ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་མཐོང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་ཏེ། ཁོང་དང་ཁོང་གི་ཞབས་ཕྱི་མོ་ཤེ་ལ་ཡིད་ཆེས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/13.json","previousChapterAudioLinks":{},"numberOfVerses":31}