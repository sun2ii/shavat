{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":18,"content":[{"type":"heading","content":["ཡི་ཏྲོ་ཡིས་རང་གི་མག་པ་ལ་སྐོར་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཡང་མིད༌ཡཱན་ཡུལ་གྱི་མཆོད་དཔོན་ཏེ་མོ་ཤེའི་སྒྱུག་པོ་ཡི་ཏྲོ་ཡིས། དཀོན་མཆོག་གིས་མོ་ཤེ་དང་ཉིད་ཀྱི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་ཅི་དང་ཅི་མཛད་པ་ཐམས་ཅད་དེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པ་ཐོས་ནས།"]},{"type":"verse","number":2,"content":["མོ་ཤེའི་ཆུང་མ་ཚིབ་ཕའོ་རཱ་སྟེ་སྔར་མོ་ཤེ་ཡིས་ཕྱིར་ཁྱིམ་ལ་ལོག་ཏུ་བཅུག་པ་དེ་དང་།"]},{"type":"verse","number":3,"content":["ཚིབ་ཕའོ་རཱ་ཡི་བུ་གཉིས་ཁྲིད་འོངས་པ་རེད། བུ་གཅིག་གི་མིང་ལ་གེར་ཤོམ་ཞེས་ཟེར་ཏེ། རྒྱུ་མཚན་ནི་སྔར་མོ་ཤེ་ཡིས་ང་རང་ཡུལ་གཞན་དུ་བྱེས་པར་གྱུར་ཞེས་སྨྲས་པས་སོ། །"]},{"type":"verse","number":4,"content":["བུ་གཞན་དེའི་མིང་ལ་ཨེ་ལི་ཨེ་བཟིར་ཞེས་ཟེར་ཏེ། ཅི་ལ་ཞེ་ན། སྔར་མོ་ཤེ་ཡིས་བདག་གི་ཕ་ཡི་དཀོན་མཆོག་གིས་ང་ལ་རོགས་རམ་གནང་ཞིང་ཕཱར་ཨོལ་གྱི་རལ་གྲི་ནས་ཐར་བར་མཛད་ཅེས་སྨྲས་པས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ལྟར་མོ་ཤེའི་སྒྱུག་པོ་ཡི་ཏྲོ་ཡིས་མོ་ཤེའི་ཆུང་མ་དང་བུ་གཉིས་ཁྲིད་ནས་དཀོན་མཆོག་གི་རི་བོ་སྟེ། མོ་ཤེ་ཡིས་དབེན་སྟོང་དུ་སྒར་འདེབས་སའི་གནས་ལ་སླེབས་ཤིང་།"]},{"type":"verse","number":6,"content":["ཡང་ཁོས་མི་ཞིག་མངགས་ནས་མོ་ཤེ་ལ་འདི་ལྟར། བདག་ནི་ཁྱེད་ཀྱི་སྒྱུག་པོ་ཡི་ཏྲོ་ཡིན་ཞིང་། ཁྱེད་ཀྱི་ཆུང་མ་དང་བུ་གཉིས་ཁྲིད་ནས་ཁྱེད་རང་ཡོད་ས་འདི་རུ་སླེབས་ཡོད་ཅེས་ངག་འཕྲིན་བཏང་བ་ལ།"]},{"type":"verse","number":7,"content":["མོ་ཤེ་སྒྱུག་པོ་བསུ་བར་སོང་སྟེ། དེའི་མདུན་དུ་གུས་ཕྱག་ཕུལ་ནས་འོ་",{"noteId":7},"བྱས་པ་དང་། ཕན་ཚུན་ཁམས་འདྲི་ཞུས་ནས་གུར་གྱི་ནང་དུ་ཞུགས།"]},{"type":"verse","number":8,"content":["དེ་ནས་མོ་ཤེ་ཡིས་སྒྱུག་པོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་དོན་དུ་ཕཱར་ཨོལ་དང་ཨེ་ཅིབ་པ་རྣམས་ལ་ཅི་དང་ཅི་ཞིག་མཛད་པ་ཀུན་དང་། ལམ་དུ་མྱངས་པའི་སྡུག་བསྔལ་ཐམས་ཅད་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཅི་ལྟར་བསྐྱབས་པ་བཅས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་བཀའ་དྲིན་མཛད་ཅིང་། དེ་དག་ཨེ་ཅིབ་པའི་དབང་ནས་ཐར་བར་མཛད་པས་ཡི་ཏྲོའི་སེམས་ཤིན་ཏུ་དགའ་བ་རེད།"]},{"type":"verse","number":10,"content":["ཡང་ཁོ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པར་ཤོག ཁོང་གིས་ཁྱེད་ཅག་ཨེ་ཅིབ་པ་རྣམས་དང༌ཕཱར་ཨོལ་གྱི་ལག་ནས་ཐར་བར་མཛད་ཅིང་། ཁོང་གིས་མི་འདི་རྣམས་ཨེ་ཅིབ་པ་རྣམས་ཀྱི་ལག་ནས་བསྐྱབས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["ལྷ་ཐམས་ཅད་དང་བསྡུར་ན་དཀོན་མཆོག་ཡ་ཝཱེ་ནུས་མཐུ་ཆེ་བ་ངས་ད་ལྟ་ཤེས་ཏེ། ཅི་ལ་ཞེ་ན། དོན་དེའི་ནང་དུ་ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་མི་རྣམས་ལ་ཁེངས་དྲེགས་ཀྱི་སྤྱོད་ཚུལ་བཟུང་བའི་ཕྱིར་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":12,"content":["དེ་ནས་མོ་ཤེའི་སྒྱུག་པོ་ཡི་ཏྲོས་དཀོན་མཆོག་ལ་སྦྱིན་སྲེག་ཅིག་དང་དམར་མཆོད་རྣམས་ཕུལ་བ་དང་། ཨ་རོན་ནི་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་དང་བཅས་ཡོང་ནས་མོ་ཤེའི་སྒྱུག་པོ་དང་མཉམ་དུ་དཀོན་མཆོག་གི་སྤྱན་སྔར་གསོལ་ཚིགས་བཞེས་པར་ཕེབས་སོ། །"]},{"type":"verse","number":13,"content":["དེའི་ཕྱི་ཉིན། མོ་ཤེ་མི་རྣམས་ལ་ལེགས་ཉེས་འབྱེད་པར་བཞུགས་ཤིང་། ཞོགས་པ་ནས་དགོང་མོའི་བར་དུ་མི་རྣམས་མོ་ཤེའི་དྲུང་དུ་ལངས་ནས་བསྡད།"]},{"type":"verse","number":14,"content":["མོ་ཤེ་ཡིས་མི་རྣམས་ཀྱི་དོན་དུ་ཅི་བྱེད་པ་ཐམས་ཅད་སྒྱུག་པོས་མཐོང་སྟེ་ན་རེ། ཞོགས་པ་ནས་དགོང་མོའི་བར་དུ་མི་རྣམས་ཁྱེད་ཀྱི་དྲུང་དུ་ལངས་ནས་སྡོད་ཅིང་། ཁྱེད་རང་གཅིག་པུ་བཞུགས་ནས་འདུག་དོན་ཅི་ཡིན་ནམ་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":15,"content":["མོ་ཤེ་ཡིས་སྒྱུག་པོ་ལ། དེ་ནི་མི་རྣམས་འདིར་འོངས་ནས་དཀོན་མཆོག་ལ་བཀའ་འདྲི་ཞུ་བའི་རྐྱེན་དང༌།"]},{"type":"verse","number":16,"content":["ཁོ་རྣམས་ལ་རྩོད་པ་འབྱུང་དུས་ཀྱང་ངའི་གམ་དུ་འོངས་ནས། ངས་མི་དང་མིའི་བར་ལ་ཤན་འབྱེད་པ་དང་། དཀོན་མཆོག་གི་སྒྲིག་ལམ་དང་བཀའ་ཁྲིམས་རྣམས་དེ་དག་ལ་བསླབས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["སྒྱུག་པོས་མོ་ཤེ་ལ། ཁྱེད་ཀྱི་བྱེད་ལུགས་དེ་ལེགས་པོ་མི་འདུག"]},{"type":"verse","number":18,"content":["ཁྱེད་དང་ཁྱེད་ཀྱི་དྲུང་དུ་འོངས་པའི་མི་རྣམས་ཐང་ཆད་ངེས་ཡིན། དོན་དེ་ནི་ཁྱེད་ཀྱིས་ཐེག་དཀའ་ཞིང་ཁྱེད་གཅིག་པུས་བསྒྲུབ་ཀྱང་མི་ནུས་སོ། །"]},{"type":"verse","number":19,"content":["ད་ལྟ་ངའི་གཏམ་ལ་གསན་པར་གྱིས། བདག་གིས་ཁྱེད་ལ་སློབ་སྟོན་བྱེད་དེ། དཀོན་མཆོག་ཁྱེད་དང་མཉམ་དུ་བཞུགས་པར་སྨོན། ཁྱེད་ནི་དཀོན་མཆོག་གི་དྲུང་དུ་འབངས་མིའི་ཚབ་བྱེད་མཁན་ཡིན་ཞིང་། རྩོད་གཞི་རྣམས་དཀོན་མཆོག་གི་དྲུང་དུ་ཕུལ་ཞིག"]},{"type":"verse","number":20,"content":["ཁྱེད་ཀྱིས་དེ་དག་ལ་སྒྲིག་ལམ་དང་བཀའ་ཁྲིམས་རྣམས་སློབས་དང་། ཁོ་རྣམས་ལ་འགྲུལ་དགོས་པའི་ལམ་དང་བྱེད་དགོས་པའི་ལས་རྣམས་སྟོན་པར་གྱིས་ཤིག"]},{"type":"verse","number":21,"content":["དེ་ནས་ཁྱེད་ཀྱིས་འབངས་མིའི་ཁྲོད་ནས་སྐྱེས་པ་འཇོན་པོ་རྣམས་འདེམས་དགོས་ཏེ། དཀོན་མཆོག་ལ་གུས་ཤིང་འཇིགས་པ་དང་། གཤིས་རྒྱུད་དྲང་བ་དང་། ལྐོག་ནོར་ལ་སྡང་བ་རྣམས་ཚོལ་དང་། དེ་དག་སྟོང་དཔོན་དང་། བརྒྱ་དཔོན་དང་། ལྔ་བཅུ་དཔོན་དང་། བཅུ་དཔོན་བཅས་བྱེད་དུ་ཆུག"]},{"type":"verse","number":22,"content":["ཁོ་རྣམས་ཀྱིས་དུས་རྒྱུན་མི་རྣམས་ལ་ལེགས་ཉེས་ཀྱི་ཤན་འབྱེད་དགོས་པ་འདི་ལྟ་སྟེ། དོན་ཆེན་གང་བྱུང་བ་དེ་དག་ཁྱེད་ལ་ཞུ་དགོས་པ་དང་། དོན་ཆུང་རྣམས་རང་རང་གིས་ཐག་གིས་གཅོད་དགོས། དེ་ལྟར་བྱས་ན་ཁྱེད་ཀྱི་ལས་ཚགས་ཇེ་ཡང་དུ་འགྲོ་བ་དང་། ཁོ་རྣམས་ཀྱིས་ཁྱེད་དང་མཉམ་དུ་འགན་འཁུར་བར་འགྱུར།"]},{"type":"verse","number":23,"content":["དོན་འདི་དཀོན་མཆོག་གིས་ཁྱེད་ལ་གནང་བའི་བཀའ་ཡིན་པ་དང་ཁྱེད་ཀྱིས་དེ་ལྟར་བྱས་ན། ཁྱེད་ཀྱིས་འགན་ཐེག་སྲིད་ཅིང་། མི་འདི་ཐམས་ཅད་ཀྱང་བདེ་བར་རང་གི་གནས་སུ་འགྲོ་བར་འགྱུར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་མོ་ཤེ་ཡིས་སྒྱུག་པོའི་ངག་ལ་མཉན་ཏེ། ཁོས་ཅི་སྨྲས་པ་བཞིན་དུ་བྱས།"]},{"type":"verse","number":25,"content":["མོ་ཤེ་ཡིས་ཡེས་ར་ཨེལ་པ་དག་ལས་སྐྱེས་པ་འཇོན་པོ་རྣམས་བདམས་ཏེ་འབངས་མིའི་འགོ་དཔོན་དུ་བསྐོས་ཤིང་། སྟོང་དཔོན་དང་། བརྒྱ་དཔོན་དང༌། ལྔ་བཅུ་དཔོན་དང་། བཅུ་དཔོན་བཅས་བྱེད་དུ་བཅུག་པ་དང་།"]},{"type":"verse","number":26,"content":["དེ་དག་གིས་རྟག་ཏུ་མི་རྣམས་ལ་ལེགས་ཉེས་ཀྱི་ཤན་འབྱེད་ཅིང་། ཐག་གིས་ཆོད་དཀའ་བ་རྣམས་མོ་ཤེ་ལ་གཏད། འོན་ཀྱང་དོན་ཆུང་རྣམས་རང་རང་གིས་ཐག་གཅོད་བྱེད་དོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་མོ་ཤེ་ཡིས་རང་གི་སྒྱུག་པོར་སྐྱེལ་མ་བྱས་པ་དང་། ཁོ་ཕྱིར་རང་ཡུལ་དུ་ལོག་གོ །"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འོ་ཞེས་པ་ནི་ཨ་མས་བུ་ཆུང་ལ་སྙིང་རྗེ་ནས་འོ་བྱེད་པ་ལྟ་བུ༌སྟེ། ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་གོམས་སྲོལ་ལ་བརྩི་བཀུར་བྱེད་པ་དང་ཤ་ཚ་ཞིང་སྙིང་ཉེ་བའི་མཚོན་རྟགས་ཤིག༌ཡིན།","reference":{"chapter":18,"verse":7}}]},"thisChapterLink":"/api/bod_ntb/EXO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/17.json","previousChapterAudioLinks":{},"numberOfVerses":27}