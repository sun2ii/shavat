{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":2,"content":[{"type":"heading","content":["ལུང་སྟོན་པ་མོ་ཤེ་འཁྲུངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ལེ་ཝིའི་རྒྱུད་ཀྱི་མི་ཞིག་སོང་ནས་ཚོ་པ་དེའི་བུ་མོ་ཞིག་ཆུང་མར་བླངས་པ་དང་།"]},{"type":"verse","number":2,"content":["བུ་མོ་དེ་མངལ་དང་ལྡན་པར་གྱུར་ནས་བུ་ཞིག་སྐྱེས་ཤིང་། རང་གི་ཕྲུ་གུ་མཛེས་ཤིང་ལྟ་ན་སྡུག་པ་མཐོང་ནས་ཟླ་བ་གསུམ་ལ་སྦས་ནས་བཞག"]},{"type":"verse","number":3,"content":["ཕྱིས་སུ་སྦས་ཐབས་མ་བྱུང་བས་ཁོ་མོས་པ་པི་རཱའི་",{"noteId":0},"གཟེབ་ཅིག་བླངས་ཏེ་རྒྱ་སྐྱེགས་དང་ཐང་ཆུ་བསྐུས་ཤིང་། ཕྲུ་གུ་དེའི་ནང་དུ་བཞག་ནས་ནཱ་ཡོལ་གཙང་པོ་འགྲམ་གྱི་འདམ་རྩྭའི་གསེབ་ཏུ་བཞག་པ་དང་།"]},{"type":"verse","number":4,"content":["བུ་དེའི་གཅེན་མོས་ཁོ་ལ་ཅི་ཞིག་འབྱུང་བར་བལྟ་བའི་ཕྱིར་རྒྱང་རིང་དུ་ལངས་བསྡད་དོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཕཱར་ཨོལ་གྱི་སྲས་མོ་ནཱ་ཡོལ་གཙང་པོའི་འགྲམ་ལ་ཁྲུས་བྱེད་དུ་འོངས་པ་དང་། ཁོ་མོའི་གཡོག་མོ་རྣམས་ཆུ་ཁར་སོང་བ་ལ། སྲས་མོས་འདམ་རྩྭའི་གསེབ་ལ་ཡོད་པའི་གཟེབ་དེ་མཐོང་ནས་གཡོག་མོ་ཞིག་ལེན་དུ་བཏང་།"]},{"type":"verse","number":6,"content":["ཁོ་མོས་གཟེབ་ཀྱི་ཁ་ཕྱེས་པ་ན་བུ་ཞིག་ཡོད་པ་མཐོང་ཞིང་། ལྟོས་དང་། བུ་དེ་ངུ་བཞིན་ཡོད་པར་སྙིང་རྗེ་སྐྱེས་ཏེ་འདི་ལྟར་སྨྲས་པ། འདི་ནི་ཨིབ་རི་པའི་ཕྲུ་གུ་ཞིག་ཡིན་འདུག་ཅེས་པའོ། །"]},{"type":"verse","number":7,"content":["སྐབས་དེར། ཕྲུ་གུའི་གཅེན་མོས་ཕཱར་ཨོལ་གྱི་སྲས་མོ་ལ། ང་རང་སོང་སྟེ་ཁྱེད་ལ་ཨིབ་རི་པའི་བུད་མེད་རྣམས་ལས་ཉེ་བའི་མ་མ་ཞིག་བོས་ཏེ་བུ་འདིར་ནུ་མ་བསྣུན་པར་བྱའམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":8,"content":["ཕཱར་ཨོལ་གྱི་སྲས་མོས་ཁྱོད་སོང་ཞིག་ཅེས་བཀའ་གནང་བ་དང་། བུ་མོ་སོང་ནས་ཕྲུ་གུའི་ཨ་མ་བོས་ཡོང་ཞིང་།"]},{"type":"verse","number":9,"content":["ཕཱར་ཨོལ་གྱི་སྲས་མོས་ཁོ་མོར། ཁྱོད་ཀྱིས་ཕྲུ་གུ་འདི་ཁྱེར་སོང་སྟེ་བདག་གི་དོན་དུ་ཁོ་ལ་ནུ་མ་སྣུན་དང་། ངས་ཁྱོད་ལ་གླ་ཆ་སྟེར་ཞེས་སྨྲས་པ་ན། ཁོ་མོས་ཕྲུ་གུ་ཁྱེར་ནས་ནུ་མ་བསྣུན།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཕྲུ་གུ་ནར་སོན་པ་ན་བུད་མེད་ཀྱིས་བུ་དེ་ཕཱར་ཨོལ་གྱི་སྲས་མོའི་རྩར་ཁྲིད་ནས་དེའི་གསོས་བུར་གྱུར་ཅིང་། སྲས་མོས་བྱིས་པའི་མིང་ལ་མོ་ཤེ་ཞེས་བཏགས་པ་སྟེ། བདག་གིས་ཁོ་རང་ཆུ་ལས་བླངས་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["མོ་ཤེ་ཨེ་ཅིབ་ཡུལ་ནས་བྲོས་པ།"]},{"type":"verse","number":11,"content":["དེའི་རྗེས་སུ་མོ་ཤེ་ལང་ཚོ་དར་ལ་བབས་པ་ན། ཕྱི་རོལ་ཏུ་རང་གི་སྤུན་ཟླ་རྣམས་ཀྱི་གམ་དུ་སོང་བ་དང་། དེ་དག་གིས་དཀའ་སྡུག་མྱོང་བཞིན་ཡོད་པ་མཐོང་ཞིང་། ཨེ་ཅིབ་པ་ཞིག་གིས་ཁོའི་སྤུན་ཟླ་ཨིབ་རི་པ་ཞིག་ལ་གཅར་རྡུང་བྱེད་པ་མཐོང་ནས།"]},{"type":"verse","number":12,"content":["མོ་ཤེ་ཡིས་གཡས་གཡོན་ལ་བལྟས་ཤིང་སུ་ཡང་མ་མཐོང་བས། ཁོས་ཨེ་ཅིབ་པ་དེ་བསད་ནས་བྱེ་མའི་ནང་དུ་སྦས།"]},{"type":"verse","number":13,"content":["དེའི་ཕྱི་ཉིན་ཡང་ཁོ་རང་ཕྱི་རོལ་ཏུ་སོང་བ་ན། ལྟོས་དང་། ཨིབ་རི་པ་གཉིས་འཛིང་རེས་བྱེད་ཀྱིན་འདུག་པ་མཐོང་སྟེ། བརྙས་བཅོས་བྱེད་མཁན་དེ་ལ། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་རང་གི་སྤུན་ཟླར་རྡུང་ངམ་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":14,"content":["མི་དེ་ན་རེ། སུས་ཁྱོད་རང་ངེད་ཅག་གི་འགོ་དཔོན་ནམ་ཁྲིམས་དཔོན་དུ་བསྐོས་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་ཨེ་ཅིབ་པ་དེ་བཞིན་དུ་ང་རང་ཡང་གསོད་འདོད་དམ་ཞེས་སྨྲས་པས། མོ་ཤེ་འཇིགས་ནས་དོན་དེ་མི་གཞན་གྱིས་ཀྱང་དངོས་གནས་ཤེས་པ་འདྲ་སྙམ་མོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ཕཱར་ཨོལ་གྱིས་དོན་དེ་ཐོས་ནས་མོ་ཤེ་གསོད་པར་བསམས་མོད། འོན་ཀྱང་མོ་ཤེ་ནི་ཕཱར་ཨོལ་ལས་བྲོས་ཏེ་མིད༌ཡཱན་ཡུལ་དུ་སོང་ནས་བསྡད་པ་དང་།"]},{"type":"verse","number":16,"content":["ཉིན་ཞིག་ཁོ་རང་ཁྲོན་པ་ཞིག་གི་གམ་དུ་སྡོད་དུས། མིད༌ཡཱན་ཡུལ་གྱི་མཆོད་དཔོན་ལ་བུ་མོ་བདུན་ཡོད་པ་རྣམས་ཕ་ཡི་ར་ལུག་གི་ཁྱུ་ལ་ཆུ་ལྡུད་པའི་ཕྱིར་ཆུ་ལེན་དུ་ཡོང་ཞིང་གཞོང་པ་རྣམས་ཆུས་གང་བར་བྱས།"]},{"type":"verse","number":17,"content":["དུས་དེར་ལུག་རྫི་རྣམས་ཡོང་སྟེ་ཁོ་མོ་རྣམས་བདས། འོན་ཀྱང༌། མོ་ཤེ་ལངས་ནས་ཁོ་མོ་རྣམས་ལ་རོགས་བྱས་ཏེ་ཁོ་ཚོའི་ར་ལུག་གི་ཁྱུ་ལ་ཆུ་བླུད་དོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་ཁོ་མོ་རྣམས་ཕ་རུའུ་ཨེལ་གྱི་གམ་དུ་འོངས་པ་ན། ཕ་ན་རེ། དེ་རིང་ཁྱོད་རྣམས་འདི་ཙམ་མགྱོགས་མྱུར་ངང་སླེབས་པའི་རྒྱུ་མཚན་ཅི་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":19,"content":["ཁོ་མོ་རྣམས་ན་རེ། ཨེ་ཅིབ་པ་ཞིག་གིས་ངེད་རྣམས་རྫི་བོ་སྐོར་ཞིག་གི་ལག་འོག་ནས་བསྐྱབས་པར་མ་ཟད། ད་དུང་ཆུ་བླངས་ནས་ར་ལུག་རྣམས་ལ་བླུད་བྱུང་ཞེས་སྨྲས།"]},{"type":"verse","number":20,"content":["དེ་ནས་ཕ་ཡིས་བུ་མོ་རྣམས་ལ། མི་དེ་གང་དུ་ཡོད་དམ། ཅིའི་ཕྱིར་ཁོ་རང་བསྐྱུར་བ་ཡིན་ནམ། ཁྱོད་རྣམས་སོང་ནས་ཁོ་རང་ཟས་ལ་རོལ་བར་བོས་ཤིག་ཅེས་སྨྲས།"]},{"type":"verse","number":21,"content":["མོ་ཤེ་ནི་མི་དེ་དང་མཉམ་དུ་གནས་པར་དགའ་ཞིང་། མི་དེས་ཀྱང་རང་གི་བུ་མོ་ཚིབ་ཕའོ་རཱ་བྱ་བ་ཁོ་ལ་ཆུང་མར་གནང་བ་དང་།"]},{"type":"verse","number":22,"content":["ཚིབ་ཕའོ་རཱ་ལ་བུ་ཞིག་སྐྱེས་ཤིང་། མོ་ཤེ་ཡིས་བྱིས་པའི་མིང་ལ་གེར་ཤོམ་ཞེས་བཏགས་པ་སྟེ། ང་རང་ཡུལ་གཞན་དུ་བྱེས་པར་གྱུར་ཞེས་སྨྲས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་བགྲང་བྱ་མང་པོ་འདས་པ་ན་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་སྐུ་གྲོངས་ཤིང་། ཡེས་ར་ཨེལ་པ་རྣམས་དཀའ་སྡུག་གིས་མནར་ཏེ་ཤུགས་རིང་འཐེན་ནས་ངུ་འབོད་བྱས་པ་དང་། ཁོ་རྣམས་ཀྱི་སྡུག་ཡུས་ཡར་དཀོན་མཆོག་གི་དྲུང་དུ་སླེབས།"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་གིས་ཁོ་རྣམས་ཀྱི་སྡུག་ཡུས་གསན་ཅིང་། ཨབ་ར་ཧམ་དང་། ཨི་སཱག ཡ་ཀོབ་བཅས་ལ་བཞག་པའི་ཞལ་ཆད་ཐུགས་སུ་དྲན།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གཟིགས་སྐྱོང་མཛད་ཅིང་ཁོང་གིས་དེ་རྣམས་ཀྱི་དཀའ་སྡུག་ཀྱང་མཁྱེན་ཏོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འདིར་པ་པི་རཱ་ཞེས་པ་ནི་འདམ་རྩྭ་པ་པི་རཱ་ལ་གོ་དགོས་པ་ཡིན།","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/EXO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}