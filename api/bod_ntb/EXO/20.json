{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":20,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བཅུ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་གིས་བཀའ་འདི་ཐམས་ཅད་གསུངས་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ཞིང་། ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་གྱི་བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཁྲིད་མཁན་ཡང་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["ང་རང་མ་གཏོགས་པའི་དཀོན་མཆོག་གཞན་ཞིག་ཁྱོད་ལ་ཡོད་མི་ཆོག"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་རང་ཉིད་ལ་སྐུ་འདྲ་དང་། སྟེང་གི་ནམ་མཁའ་འམ། འོག་གི་སའམ། ས་འོག་གི་ཆུ་ལ་ཡོད་པའི་སེམས་ཅན་གྱི་གཟུགས་བརྙན་གང་ཡང་བཟོ་མི་རུང་།"]},{"type":"verse","number":5,"content":["དེ་དག་ལ་ཕྱག་མ་འཚལ། བསྙེན་བཀུར་ཡང་མ་བྱེད། གང་ལ་ཟེར་ན། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ང་རང་ནི་ཕྲག་དོག་ཅན་ཞིག་ཡིན་ཏེ། ཕ་རྣམས་ཀྱི་ནག་ཉེས་ཕྱིར་མི་རབས་གསུམ་མམ་བཞིའི་བར་དུ་ང་རང་ལ་སྡང་མཁན་གྱི་བུ་ཕྲུག་རྣམས་ལ་བཀའ་ཆད་གཅོད་མོད།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་ང་རང་གཅེས་སུ་འཛིན་པ་དང་བདག་གི་བཀའ་སྲུང་མཁན་རྣམས་ལ་མི་སྟོང་ཕྲག་གི་བར་དུ་ཐུགས་བརྩེ་བར་བྱེད་དོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གང་བྱུང་དུ་སྤྱོད་མི་རུང་། ཅི་ལ་ཞེ་ན། སུ་ཞིག་གིས་ཁོང་གི་མཚན་གང་བྱུང་དུ་སྤྱད་ན་དཀོན་མཆོག་ཡ་ཝཱེས་མི་དེ་ཉེས་མེད་དུ་རྩི་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":8,"content":["ངལ་གསོ་བའི་ཉིན་མོ་དྲན་ནས་དེ་དམ་པར་སྲུངས་ཤིག"]},{"type":"verse","number":9,"content":["ཉིན་དྲུག་གི་རིང་ལ་འབད་ཅིང་རང་གི་ལས་ཀ་ཚང་མ་སྒྲུབ་རུང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["འོན་ཀྱང་ཉིན་བདུན་པ་ནི་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ངལ་གསོ་བའི་ཉིན་མོ་ཡིན་པས། ཉིན་མོ་དེ་ལ་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་དང་བུ་མོ། གཡོག་པོ་དང་གཡོག་མོ། སྒོ་ཕྱུགས། རྒྱ་སྒོ་ནང་རོལ་ལ་གནས་པའི་བྱེས་པ་བཅས་ཀྱིས་ལས་ཀ་གང་ཡང་མ་བྱེད་ཅིག"]},{"type":"verse","number":11,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཉིན་དྲུག་གི་རིང་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ནམ་མཁའ་དང་ས་གཞི་དང་རྒྱ་མཚོ་དང་དེ་དག་གི་ནང་དུ་ཡོད་པ་ཐམས་ཅད་བཀོད་ནས། ཉིན་བདུན་པ་ལ་ངལ་གསོས་པའོ། །དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་ངལ་གསོ་བའི་ཉིན་མོ་དེ་ལ་བྱིན་གྱིས་བརླབས་ནས་དམ་པར་མཛད་དོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ལ་གནང་བྱའི་ཡུལ་དེར་ཚེ་ཐག་རིང་པོར་གནས་ཐུབ་པའི་ཕྱིར། རང་གི་ཕ་མ་གཉིས་ལ་བཀུར་སྟི་བྱེད་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱིས་མི་མ་གསོད།"]},{"type":"verse","number":14,"content":["ལོག་གཡེམ་མ་བྱེད།"]},{"type":"verse","number":15,"content":["རྐུ་མ་བྱེད།"]},{"type":"verse","number":16,"content":["རང་གི་ཁྱིམ་མཚེས་ལ་རྫུན་གྱི་དཔང་པོ་མ་བྱེད།"]},{"type":"verse","number":17,"content":["གཞན་གྱི་ཁང་པ་ལ་འདོད་ཧམ་མ་བཅང་། གཞན་གྱི་ཆུང་མ་དང་། གཡོག་པོ་དང་། གཡོག་མོ་དང་། བ་གླང་དང་། བོང་བུ་དང་། དེ་ལྟར་མི་གཞན་གྱི་ཡིན་ཚད་གང་ལའང་ཧམ་པ་བཅང་མི་རུང་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["མི་ཐམས་ཅད་ཀྱིས་འབྲུག་སྒྲ་ལྡིར་བ་དང་གློག་དམར་འཁྱུག་པ། རྭ་དུང་གི་སྐད་དང་རི་ལས་དུ་བ་འཕྱུར་བ་བཅས་མཐོང་བས། ཁོ་རྣམས་སྔངས་འདར་དང་བཅས་རྒྱང་རིང་ནས་ལངས་བསྡད་ཅིང་།"]},{"type":"verse","number":19,"content":["མོ་ཤེ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་ངེད་ཅག་ལ་གཏམ་སྨྲ་བར་མཛོད་དང་ངེད་ཅག་གིས་མཉན་པར་བྱའོ། །འོན་ཀྱང་ངེད་རྣམས་འཆི་བར་མི་འགྱུར་བའི་ཕྱིར། དཀོན་མཆོག་གིས་ངེད་ཅག་ལ་གསུང་འབྱོན་པར་མི་བྱའོ་ཞེས་སྨྲས།"]},{"type":"verse","number":20,"content":["མོ་ཤེ་ཡིས་མི་རྣམས་ལ། མ་འཇིགས་ཤིག རྒྱུ་མཚན་ནི་དཀོན་མཆོག་ཁྱོད་རྣམས་ལ་བརྟག་པར་ཕེབས་པ་སྟེ། ཁྱོད་རྣམས་ཁོང་ལ་གུས་ཤིང་འཇིགས་པ་དང་སྡིག་པའང་མི་བྱེད་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":21,"content":["དེ་ལྟར་མི་རྣམས་རྒྱང་རིང་ནས་ལངས་བསྡད་པ་དང་། མོ་ཤེ་དཀོན་མཆོག་བཞུགས་ཡོད་པའི་མུན་པ་སྟུག་པོའི་ཉེ་སར་བཅར་ཏོ། །"]},{"type":"heading","content":["མཆོད་ཁྲི་བརྩིག་པར་བཀའ་གནང་བ།"]},{"type":"verse","number":22,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་དང་། བདག་གིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་ཁྱོད་ཅག་ལ་གཏམ་སྨྲས་པ་ཁྱོད་རྣམས་ཀྱིས་མཐོང་བ་ཡིན།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་གིས་ང་ཡི་དོ་ཟླར་ཅི་ཡང་བཟོ་མི་རུང་སྟེ། རང་ཉིད་ཀྱི་ཆེད་དུ་དངུལ་གྱི་སྐུ་བརྙན་ནམ་གསེར་གྱི་སྐུ་བརྙན་གང་ཡང་བཟོ་མི་རུང་།"]},{"type":"verse","number":24,"content":["ངའི་ཆེད་དུ་ས་ཡི་མཆོད་ཁྲི་ཞིག་བརྩིག་པར་གྱིས་ལ། དེའི་སྟེང་དུ་ཁྱོད་ཅག་གི་སྦྱིན་སྲེག་དང་། ཞི་བདེའི་མཆོད་པ་རྣམས་དང་། ར་ལུག་དང་བ་གླང་གི་མཆོད་པ་འབུལ་དགོས། ངས་རང་གི་མིང་དྲན་སྐུལ་བྱེད་པའི་གནས་གང་དང་གང་དུ་ང་རང་ཁྱོད་ཅག་གི་གམ་དུ་འོངས་ཏེ་ཁྱོད་ཅག་ལ་བྱིན་རླབས་གནང་བར་འགྱུར།"]},{"type":"verse","number":25,"content":["ཡང་གལ་ཏེ་ངའི་ཕྱིར་རྡོ་ཡི་མཆོད་ཁྲི་ཞིག་བརྩིག་པར་བྱེད་ན། མ་བཅོས་པའི་རྡོ་རྣམས་ལས་བརྩིག་པར་གྱིས། རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཀྱིས་དེའི་སྟེང་དུ་བཟོ་བྱེད་བཀོལ་ན་མཆོད་ཁྲི་མི་གཙང་བར་བྱེད་པས་སོ། །"]},{"type":"verse","number":26,"content":["ཡང་ཁྱོད་རྣམས་ཀྱི་ཁོག་སྨད་གཅེར་བུར་མི་འབུད་པའི་ཕྱིར། ཁྱོད་རྣམས་ཐེམ་སྐས་ཀྱི་སྟེང་ནས་བདག་གི་མཆོད་ཁྲི་སྟེང་དུ་མ་འབུད་ཅིག་ཅེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/19.json","previousChapterAudioLinks":{},"numberOfVerses":26}