{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":28,"content":[{"type":"heading","content":["མཆོད་དཔོན་གྱི་འཕགས་གོས།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་ནས་ཁྱོད་ཀྱི་ཕུ་བོ་ཨ་རོན་དང་ཁོའི་བུ་རྣམས་ཏེ། ནཱ་དབ་དང་ཨ་བི་ཧུ་དང་ཨེ་ལི་ཨ་ཟར་དང་ཨི་ཐ་མཱར་བཅས་བདག་གི་མཆོད་དཔོན་གྱི་ཞབས་ཕྱི་བྱེད་པར་ཁྱོད་ཀྱི་དྲུང་དུ་འོང་བར་ཆུག་ཅིག"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་རང་གི་ཕུ་བོ་ཨ་རོན་ལ་འཕགས་གོས་དམ་པ་བརྗིད་ཉམས་དང་མཛེས་སྡུག་ལྡན་པའི་ཕྱིར་བཟོ་དགོས།"]},{"type":"verse","number":3,"content":["ཨ་རོན་དམ་པར་བྱེད་པ་དང་ཁོས་ཀྱང་བདག་ལ་མཆོད་དཔོན་གྱི་ཞབས་ཕྱི་བྱེད་པའི་ཕྱིར། ཁྱོད་ཀྱིས་ལག་རྩལ་ཡོད་པའི་མི་སྟེ། བདག་གིས་ཤེས་རབ་ཀྱི་སེམས་རྒྱུད་ཀྱིས་ཁེངས་པར་མཛད་པའི་མི་དེ་དག་ལ་ཨ་རོན་ལ་འཕགས་གོས་བཟོ་བའི་བཀའ་སྒོས་ཤིག"]},{"type":"verse","number":4,"content":["དེ་དག་གིས་བཟོ་བྱའི་ན་བཟའ་རྣམས་ནི་འདི་དག་ཡིན་ཏེ། བྲང་རྒྱན་དང་བེར་ཐུལ་དང་། གོས་རིང་དང་། ནང་གོས་འབུར་རིས་མ་དང་། ལ་ཐོད་དང་སྐེད་ཆིངས་བཅས་སོ། །དེ་ལྟ་བུའི་ན་བཟའ་དམ་པ་རྣམས་ཁོ་རྣམས་ཀྱིས་ཁྱོད་ཀྱི་ཕུ་བོ་ཨ་རོན་དང་དེའི་བུ་རྣམས་ལ་བཟོ་དགོས་ལ། དེ་ནི་ཁོ་རྣམས་ཀྱིས་བདག་ལ་མཆོད་དཔོན་གྱི་ཞབས་ཕྱི་བྱེད་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":5,"content":["དེ་བཟོ་བྱེད་ནི་གསེར་སྐུད་དང་བལ་སྐུད་མཐིང་ག་དང་རྒྱ་སྨུག་དང་མཚལ་དམར་དང་སོ་རས་སྲབ་བུ་བཅས་ཡིན་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["བེར་ཐུལ་བཟོ་སྟངས།"]},{"type":"verse","number":6,"content":["ཡང་འདི་སྐད་དུ། བེར་ཐུལ་ཡང་གསེར་སྐུད་དང་བལ་སྐུད་མཐིང་ག་དང་རྒྱ་སྨུག་དང་མཚལ་དམར་དང་སོ་རས་སྲབ་བུ་བསྒྲིམས་པ་ཅན་བཅས་ཀྱིས་འཐག་མཁན་ལག་རྩལ་ཅན་གྱི་ལས་བཞིན་དུ་བཟོ་དགོས།"]},{"type":"verse","number":7,"content":["དེ་ལ་དཔུང་པའི་ཕྲག་ཁེབས་གཉིས་དགོས་ཤིང་། བེར་ཐུལ་གྱི་ཕྲག་མགོ་གཉིས་ལ་སྦྲེལ་ཞིང་འཆིང་བར་བྱའོ། །"]},{"type":"verse","number":8,"content":["ཡང་བེར་ཐུལ་དང་འབྲེལ་བའི་སྐེད་ཆིངས་མཆོར་པོ་ཅན་དེ་ནི་བེར་ཐུལ་གྱི་བཟོ་ཚུལ་དང་གཅིག་མཚུངས་ཡིན་དགོས་ཤིང་། དེའི་རྒྱུ་ནི་གསེར་སྐུད་དང་བལ་སྐུད་མཐིང་ག་དང་རྒྱ་སྨུག་དང་མཚལ་དམར་དང་སོ་རས་སྲབ་བུ་བསྒྲིམས་པ་ཅན་བཅས་ཡིན་དགོས།"]},{"type":"verse","number":9,"content":["ཡང་གཟི་གཉིས་ལོངས་ལ། དེའི་ཁར་ཡེས་ར་ཨེལ་གྱི་བུ་རྣམས་ཀྱི་མིང་བརྐོས་ཤིག"]},{"type":"verse","number":10,"content":["མིང་དྲུག་ནི་གཟི་གཅིག་གི་སྟེང་ལ་བརྐོ་བར་བྱ་ཞིང་། ཡང་མིང་དྲུག་ནི་གཟི་གཞན་པ་དེའི་སྟེང་དུ་བརྐོ་དགོས། དེ་ཐམས་ཅད་ཁོ་རྣམས་སྐྱེས་པའི་གོ་རིམ་བཞིན་དུ་བྱའོ། །"]},{"type":"verse","number":11,"content":["རྡོ་ལ་རྡོ་བཟོས་དམ་ཕྲུག་བརྐོ་བ་བཞིན་དུ་རྡོ་དེ་གཉིས་ཀྱི་སྟེང་དུ་ཡེས་ར་ཨེལ་གྱི་བུ་རྣམས་ཀྱི་མིང་བརྐོས་ཏེ་གསེར་གྱིས་འབུར་ཀོང་གཉིས་བྱའོ། །"]},{"type":"verse","number":12,"content":["རྡོ་དེ་གཉིས་བེར་ཐུལ་གྱི་དཔུང་པའི་ཕྲག་ཁེབས་གཉིས་ལ་སྦྱར་ཏེ། རྡོ་དེ་གཉིས་ལ་བརྟེན་ནས་ཡེས་ར་ཨེལ་གྱི་བུ་རྣམས་ལ་རྗེས་དྲན་ཡོད་དགོས། ཨ་རོན་གྱིས་དེ་དག་གི་མིང་རྣམས་རང་གི་ཕྲག་ལ་ཁུར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དྲན་རྟེན་དུ་བྱེད་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱིས་གསེར་གྱི་འབུར་ཀོང་གཉིས་བཟོ་དགོས་པ་དང་།"]},{"type":"verse","number":14,"content":["གསེར་བཙོ་མས་བསླེས་པའི་ཉག་ཐག་གཉིས་བཟོས་ནས། དེ་ནི་གསེར་གྱི་འབུར་ཀོང་གཉིས་ལ་སྦྱོར་ཅིག་ཅེས་གསུངས་སོ། །"]},{"type":"heading","content":["བྲང་རྒྱན་གྱི་བཟོ་སྟངས།"]},{"type":"verse","number":15,"content":["ཡང་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བློ་འདོན་པའི་བྲང་རྒྱན་བཟོ་བར་བྱའོ། །དེ་ནི་བཟོ་བ་ལག་རྩལ་ཅན་གྱིས་བྱས་པ་ཡིན་དགོས་པ་དང་བེར་ཐུལ་བཞིན་དུ་བཟོ་དགོས་ལ། དེའི་རྒྱུ་ནི་གསེར་སྐུད་དང་བལ་སྐུད་མཐིང་ག་དང་རྒྱ་སྨུག་དང་མཚལ་དམར་དང་སོ་རས་སྲབ་བུ་བསྒྲིམས་པ་ཅན་བཅས་ཡིན་དགོས།"]},{"type":"verse","number":16,"content":["དེ་ནི་ཁ་གང་ཉིས་ལྟེབ་ཅན་དང་། དེའི་རིང་ཚད་ནི་མཐོ་གང་དང་ཞེང་ལ་ཡང་མཐོ་གང་ཡོད་དགོས།"]},{"type":"verse","number":17,"content":["དེ་ལ་ཕ་ལམ་ཤུར་ཕྲེང་བཞི་ཡི་ཕྲ་འདེབས་དགོས་པ་སྟེ། ཤུར་ཕྲེང་དང་པོ་ནི་པདྨ་རཱ་ག་དང་། སྤྲིན་རྡོ། མ་རྒད་བཅས་གསུམ་དང་།"]},{"type":"verse","number":18,"content":["ཤུར་ཕྲེང་གཉིས་པ་ནི་གཡུ་དང་ཨིནྡྲ་ནཱི་ལ་དང་རྡོ་རྗེ་ཕ་ལམ་བཅས་གསུམ།"]},{"type":"verse","number":19,"content":["ཤུར་ཕྲེང་གསུམ་པ་ནི་རྟ་ཀླད་སྨུག་པོ་དང་། ཤེལ་རྡོ་དང་། མུ་མེན་བཅས་གསུམ།"]},{"type":"verse","number":20,"content":["ཤུར་ཕྲེང་བཞི་པ་ནི་བཻཌཱུརྱ་ལྗང་སེར་དང་། གཟི་དང་གཡང་ཊི་སྔོན་པོ་བཅས་གསུམ་སྟེ། དེ་དག་ནི་གསེར་གྱི་འབུར་ཀོང་ལ་འདེབས་པར་བྱའོ། །"]},{"type":"verse","number":21,"content":["རིན་པོ་ཆེ་དེ་དག་གིས་ཡེས་ར་ཨེལ་གྱི་བུ་རྣམས་ཀྱི་མིང་གི་མཚོན་རྟགས་བྱེད་ཅིང་མིང་ལྟར་བཅུ་གཉིས་ཡོད་དེ། དམ་ཕྲུག་བཞིན་དུ་རིན་པོ་ཆེ་རེ་རེའི་སྟེང་དུ་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་བཅུ་གཉིས་པོའི་མིང་རེ་རེ་ལྟར་དུ་བརྐོ་བར་བྱའོ། །"]},{"type":"verse","number":22,"content":["བྲང་རྒྱན་ལ་གསེར་བཙོ་མས་བསླེས་པའི་ཉག་ཐག་བཟོས་ཤིག"]},{"type":"verse","number":23,"content":["བྲང་རྒྱན་གྱི་གྲུ་ག་གཉིས་ལ་གསེར་གྱི་ཨ་ལོང་གཉིས་བཟོས་ཏེ་སྦྱོར་ཅིག་དང་།"]},{"type":"verse","number":24,"content":["ཡང་གསེར་གྱི་ཉག་ཐག་དེ་གཉིས་ནི་བྲང་རྒྱན་གྱི་གྲུ་ག་རུ་ཡོད་པའི་ཨ་ལོང་གཉིས་ལ་རྒྱུས་ཤིག"]},{"type":"verse","number":25,"content":["དེ་ནས་ཉག་ཐག་གི་སྣེ་གཉིས་འབུར་ཀོང་གཉིས་ལ་བཅུག་སྟེ། བེར་ཐུལ་མདུན་ལོགས་ཀྱི་ཕྲག་ཁེབས་སྟེང་སྦྱོར་དགོས།"]},{"type":"verse","number":26,"content":["ཡང་གསེར་གྱི་ཨ་ལོང་གཞན་གཉིས་བཟོས་ནས་བྲང་རྒྱན་གྱི་གྲུ་ག་གཉིས་ལ་སྦྱོར་ཅིག སྦྱོར་ས་དེ་ནི་བྲང་རྒྱན་གྱི་ཟུར་ཁ་ཡིན་ལ་བྲང་རྒྱན་དང་བེར་ཐུལ་གྱི་བར་མཚམས་ཀྱང་ཡིན་ནོ། །"]},{"type":"verse","number":27,"content":["ཡང་གསེར་གྱི་ཨ་ལོང་གཉིས་བཟོས་ནས་བེར་ཐུལ་གྱི་དཔུང་པའི་ཕྲག་ཁེབས་གཉིས་ཀྱི་མདུན་ལོགས་ཀྱི་འོག་དང་སྐེད་ཆིངས་མཆོར་པོ་ཅན་གྱི་འབྲེལ་སའི་ཅུང་ཟད་གོང་དུ་ཆུག་ཅིག"]},{"type":"verse","number":28,"content":["བྲང་རྒྱན་དེ་བེར་ཐུལ་གྱི་སྐེད་ཆིངས་མཆོར་པོ་ཅན་དང་དམ་དུ་འབྲེལ་བ་དང་བེར་ཐུལ་ལས་མི་འཆོར་བའི་ཕྱིར། བྲང་རྒྱན་གྱི་ཨ་ལོང་དེ་བེར་ཐུལ་གྱི་ཨ་ལོང་ལ་སྡེམ་ཐག་སྔོན་པོ་ཡིས་བསྡམ་དགོས།"]},{"type":"verse","number":29,"content":["དེ་ལྟར་ཨ་རོན་གནས་དམ་པར་འགྲོ་བའི་སྐབས་སུ། བློ་འདོན་པའི་བྲང་རྒྱན་ལ་ཡོད་པའི་ཡེས་ར་ཨེལ་གྱི་བུ་རྣམས་ཀྱི་མིང་དག་སྙིང་གི་དྲང་ཐད་དུ་འཛིན་པར་བྱེད་དགོས་ཤིང་། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་རྒྱུན་དུ་རྗེས་དྲན་ཡོད་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":30,"content":["ཡང་ཨུའུ་རིམ་དང་ཐུའུ་མིམ་",{"noteId":11},"ཞེས་པའི་རྟགས་རིལ་གཉིས་བློ་འདོན་པའི་བྲང་རྒྱན་གྱི་ནང་དུ་བཅུག་སྟེ། ཨ་རོན་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འགྲོ་སྐབས་དེ་གཉིས་ཁོའི་སྙིང་གི་དྲང་ཐད་དུ་ཡོད་ཅིང་། ཁོས་རྒྱུན་པར་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བློ་འདོན་པ་དེ་རང་གི་སྙིང་གི་དྲང་ཐད་དུ་འཁུར་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["གོས་རིང་བཟོ་སྟངས།"]},{"type":"verse","number":31,"content":["ཡང་འདི་སྐད་དུ། བེར་ཐུལ་འོག་གི་གོས་རིང་ནི་ཁ་དོག་སྔོན་པོས་བཟོ་བར་བྱའོ། །"]},{"type":"verse","number":32,"content":["དེའི་སྟོད་དཀྱིལ་དུ་མགོའི་ཕྱིར་ཁུང་བུ་ཞིག་འཇོག་དགོས་ཤིང་། དེའི་མཐའ་འཁོར་ལ་འཐག་བཟོ་བྱས་པའི་གོང་བ་ཞིག་ཀྱང་ཡོད་པར་བྱེད་དགོས་ལ། མི་རལ་བའི་ཕྱིར་གོ་ཁྲབ་ཀྱི་གོང་བ་ལྟར་དུ་བཟོ་དགོས།"]},{"type":"verse","number":33,"content":["ཡང་དེའི་གོས་འདབ་ཀྱི་མཐའ་འཁོར་དུ་བལ་སྐུད་མཐིང་ག་དང་རྒྱ་སྨུག མཚལ་དམར་བཅས་ཀྱི་སེ་འབྲུས་བརྒྱན་དགོས་ཤིང་། སེ་འབྲུ་རེ་རེའི་བར་གསེབ་ཏུ་ཡང་གསེར་གྱི་གཡེར་ཁ་རྣམས་འདོགས་དགོས་པ་དང་།"]},{"type":"verse","number":34,"content":["གསེར་གྱི་གཡེར་ཁ་གཅིག་དང་སེ་འབྲུ་གཅིག ཡང་གསེར་གྱི་གཡེར་ཁ་གཅིག་དང་སེ་འབྲུ་གཅིག་བཅས་གོས་རིང་གི་འདབ་ཁ་ཐམས་ཅད་ལ་ཡོད་པར་བྱེད་དགོས་ཤིང་།"]},{"type":"verse","number":35,"content":["ཨ་རོན་གྱིས་ཞབས་ཕྱི་སྒྲུབ་སྐབས་གོས་དེ་གྱོན་དགོས་ཤིང་། གནས་དམ་པ་རུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་དྲུང་དུ་འགྲོ་བ་དང་ཕྱིར་འོང་སྐབས་ཁོ་རང་མི་འཆི་བའི་ཕྱིར་གོས་དེའི་སྐད་སྒྲ་ཐོས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ལ་ཐོད་བཟོ་སྟངས།"]},{"type":"verse","number":36,"content":["ཡང་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་གསེར་བཙོ་མའི་བྱང་བུ་ཞིག་བཟོས་ནས་དེའི་སྟེང་ལ་དམ་ཕྲུག་བརྐོ་བ་བཞིན་དུ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དུ་དམ་པའོ་ཞེས་བརྐོ་བར་བྱའོ། །"]},{"type":"verse","number":37,"content":["ཡང་དེ་ལ་རས་སྔོན་པོའི་ཉག་ཐག་ཅིག་སྦྱར་ནས་ལ་ཐོད་དང་སྦྲེལ་བ་དང་། གསེར་གྱི་བྱང་བུ་ནི་ལ་ཐོད་ཀྱི་མདུན་ལོགས་སུ་ཡོད་དགོས།"]},{"type":"verse","number":38,"content":["དེ་ལྟར་དེ་ནི་ཨ་རོན་གྱི་དཔྲལ་བར་ཡོད་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་མཆོད་པ་དམ་པ་འབུལ་བའི་ཚེ། སྐྱོན་དང་ནོར་བ་གང་ཞིག་ཡོད་ཚེ། དེའི་ཉེས་པ་ཐམས་ཅད་ཨ་རོན་རང་གིས་འཁུར་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་མཆོད་པ་དེ་དག་ལ་ཐུགས་དགྱེས་པའི་ཕྱིར་བྱང་བུ་དེ་གཏན་དུ་ཨ་རོན་གྱི་དཔྲལ་བར་ཡོད་དགོས་སོ། །"]},{"type":"verse","number":39,"content":["ཡང་ཁྱོད་ཀྱིས་སོ་རས་སྲབ་བུ་ཡིས་ནང་གོས་འབུར་རིས་མ་འཐག་དགོས་པ་དང་། ཡང་སོ་རས་སྲབ་བུ་ཡིས་ལ་ཐོད་བཟོ་བ་དང་། འཐག་མཁན་གྱི་ལས་བཞིན་དུ་སྐེད་ཆིངས་བཅས་བཟོ་བར་བྱའོ། །"]},{"type":"verse","number":40,"content":["ཡང་ཨ་རོན་གྱི་བུ་རྣམས་ལ་ནང་གོས་དང་སྐེད་ཆིངས་དང་པྲོག་ཞུ་རྣམས་བརྗིད་ཉམས་དང་མཛེས་སྡུག་ལྡན་པའི་ཕྱིར་དུ་བཟོས་ཤིག"]},{"type":"verse","number":41,"content":["ཁྱོད་ཀྱིས་ན་བཟའ་དེ་རྣམས་རང་གི་ཕུ་བོ་ཨ་རོན་དང་དེའི་བུ་རྣམས་ལ་བསྐོན་དགོས་པ་དང་། དེ་དག་གིས་ང་ལ་མཆོད་དཔོན་གྱི་ཞབས་ཕྱི་བྱེད་པའི་ཕྱིར། ཁོ་རྣམས་ལ་སྣུམ་གྱིས་བྱུག་པ་དང་། བསྐོས་ནས་དམ་པར་བྱེད་དགོས།"]},{"type":"verse","number":42,"content":["ཡང་དེ་དག་གི་ཤ་རྗེན་པ་གཡོག་པའི་ཕྱིར་སོ་རས་ཀྱི་ཨང་ཐུང་རྐེད་པ་ནས་བརླའི་བར་དུ་སླེབས་པ་རྣམས་བཟོས་ཤིག"]},{"type":"verse","number":43,"content":["ཨ་རོན་དང་དེའི་བུ་རྣམས་མཇལ་འཕྲད་གུར་མཆོག་ནང་དུ་འཇུག་པའམ། གནས་དམ་པའི་ནང་ནས་ཞབས་ཕྱི་བྱེད་པའི་ཆེད་དུ་མཆོད་ཁྲིའི་དྲུང་དུ་འོང་ཚེ་དེ་དག་གྱོན་དགོས་པ་སྟེ། གལ་སྲིད་དེ་ལྟར་མ་བྱས་ན་ཉེས་སྐྱོན་ཕོག་ནས་འཆི་དགོས་པའི་ཕྱིར་རོ། །སྒྲིག་ཁྲིམས་དེ་ནི་གཏན་དུ་གནས་དགོས་ཏེ་ཨ་རོན་དང་དེའི་བུ་རྒྱུད་རྣམས་ཀྱི་ཕྱིར་དུ་ཡིན་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":11,"caller":"+","text":"ཨུའུ་རིམ་དང་ཐུའུ་མིམ་ཞེས་པ་ནི་གནའ་བོའི་དུས་སུ་མཆོད་དཔོན་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་ཐུགས་དགོངས་ཤེས་ཆེད་ལེན་པའི་རྟགས་རིལ་གྱི་མིང་ཡིན་པར་གསུངས། ཕྱིས་སུ་ལུང་སྟོན་པ་རྣམས་ཀྱིས་རྟགས་རིལ་འདི་དག་བཀོལ་བ་མེད་ལ་ཞལ་ཆད་གསར་པའི་ནང་དུའང་བཀོད་མེད།","reference":{"chapter":28,"verse":30}}]},"thisChapterLink":"/api/bod_ntb/EXO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/27.json","previousChapterAudioLinks":{},"numberOfVerses":43}