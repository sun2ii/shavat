{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":30,"content":[{"type":"heading","content":["སྤོས་ཁྲི་ཡི་སྐོར།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་སེང་ལྡེང་ཤིང་གིས་སྤོས་ཁྲི་ཞིག་འདི་ལྟར་བཟོ་དགོས་ཏེ།"]},{"type":"verse","number":2,"content":["དེའི་རིང་ཚད་ལ་ཁྲུ་གཅིག་དང་། ཞེང་ཚད་ལ་ཁྲུ་གཅིག་སྟེ་གྲུ་བཞི་མ་ཞིག་ཡིན་དགོས། ཡང་དེའི་མཐོ་ཚད་ལ་ཁྲུ་གཉིས་དང་། རུ་ཐུར་རྣམས་སྤོས་ཁྲི་དང་དངོས་པོ་གཅིག་ཏུ་སྦྲེལ་བར་བཟོས་ཤིག"]},{"type":"verse","number":3,"content":["དེའི་ཐོག་དང་ལོགས་བཞི་དང་རུ་ཐུར་རྣམས་གསེར་བཙོ་མས་གཡོགས་ཤིག དེའི་མཐའ་འཁོར་ལ་གསེར་གྱི་མུ་ཁྱུད་ཅིག་བཟོ་དགོས།"]},{"type":"verse","number":4,"content":["ཡང་གསེར་གྱི་ཨ་ལོང་གཉིས་བཟོ་དགོས་ཏེ་མུ་ཁྱུད་ཀྱི་འོག་ནས་ཁ་གཏད་ཀྱི་ལོགས་གཉིས་ཀར་སྦྱོར་དང་། དེ་ནི་རྒྱུག་པ་གཉིས་བསྐོན་ས་ཡིན་ལ། དེས་སྤོས་ཁྲི་འཁུར་དགོས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":5,"content":["རྒྱུག་པ་དེ་གཉིས་སེང་ལྡེང་ཤིང་གིས་བཟོས་ལ་གསེར་གྱིས་གཡོགས་ཤིག"]},{"type":"verse","number":6,"content":["ཡང་དཔང་མཛད་ཤུར་སྒམ་དང་དེའི་སྟེང་དུ་ཡོད་པའི་ཐུགས་རྗེའི་བཞུགས་ཁྲིའི་མདུན་ས་སྟེ། ང་རང་ཁྱོད་དང་འཕྲད་པའི་གནས་དེའི་ཡོལ་བའི་སྔོན་དུ་སྤོས་ཀྱི་སྒྲོམ་དེ་ཞོག་ཅིག"]},{"type":"verse","number":7,"content":["ཞོགས་པ་རེ་རེ་བཞིན་ཨ་རོན་གྱིས་སྒྲོན་མེ་རྣམས་ལ་བདག་བྱེད་པའི་སྐབས་སུ། སྤོས་ཀྱི་སྒྲོམ་དུ་དྲི་ཞིམ་བདུག་སྤོས་བདུག་དགོས།"]},{"type":"verse","number":8,"content":["ཁོས་ས་སྲོས་ཀྱི་དུས་སུ་སྒྲོན་མེ་རྣམས་སྒྲོན་པའི་ཚེ། ཡང་སྤོས་བདུག་དགོས་ལ། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཁྱོད་རྣམས་མི་རབས་ནས་མི་རབས་བར་རྒྱུན་ཆད་མེད་པའི་བདུག་སྤོས་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་སྤོས་ཁྲི་འདིའི་སྟེང་དུ་སྤོས་ཡ་མ་ཟུང་འབུལ་མི་རུང་། ཡང་སྦྱིན་སྲེག་གམ། འབྲུ་རིགས་ཀྱི་མཆོད་པའམ། སྐྱེམས་མཆོད་བཅས་དེ་ལ་འབུལ་མི་རུང་།"]},{"type":"verse","number":10,"content":["ཨ་རོན་གྱིས་ལོ་རེར་ཐེངས་གཅིག་ལ་དེའི་རུ་ཐུར་རྣམས་ཀྱི་སྟེང་དུ་སྡིག་པ་བཤགས་པའི་ཆོ་ག་བྱེད་དགོས་ཏེ། ཁྱོད་རྣམས་ཀྱི་མི་རབས་ནས་མི་རབས་བར། ཁོས་སྡིག་བཤགས་མཆོད་པའི་ཁྲག་གིས་དེའི་ཁར་ཆོ་ག་དེ་བྱེད་དགོས་ལ། སྤོས་ཁྲི་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཀུན་ལས་དམ་པ་ལགས་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["བླུ་རིན་གྱི་སྐོར།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཚང་རྩིས་བྱེད་པའི་ཚེ། དེ་དག་ལ་ཆག་སྒོ་མི་འབྱུང་བའི་ཕྱིར། སྐབས་དེར་ཁོ་ཚོ་མི་རེ་རེས་རང་གི་ཚེ་སྲོག་གི་ཕྱིར་བླུ་རིན་ཞིག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས།"]},{"type":"verse","number":13,"content":["དེ་དག་གི་འབུལ་བ་ནི་འདི་ལྟར། ཚང་རྩིས་བྱས་པའི་མི་རེས་གནས་མཆོག་གི་སྲང་བཞིན་དུ་དངུལ་སྲང་ཕྱེད་ཀ་འབུལ་དགོས། དངུལ་སྲང་ཕྱེད་ཀ་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་འབུལ་བ་ཡིན་ཏེ། དངུལ་སྲང་གཅིག་ནི་གཱེ་ར་",{"noteId":13},"ཉི་ཤུ་དང་འདྲ།"]},{"type":"verse","number":14,"content":["ཚང་རྩིས་བྱས་པའི་མི་ཐམས་ཅད་ལས། ལོ་ཉི་ཤུ་དང་དེ་ལས་བརྒལ་བ་ཚོས་འབུལ་བ་དེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས།"]},{"type":"verse","number":15,"content":["ཁྱོད་ཅག་གིས་ཚེ་སྲོག་བླུ་བའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་བ་འབུལ་བའི་ཚེ། དངུལ་སྲང་ཕྱེད་ཀ་མ་གཏོགས། མི་ཕྱུག་པོ་ཡིན་ཡང་ལྷག་མ་མི་འབུལ་ལ། མི་དབུལ་པོ་ཡིན་ཡང་ཉུང་དུ་མི་འཕྲི་བར་གྱིས།"]},{"type":"verse","number":16,"content":["ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ལས་བླུ་རིན་དེ་བསྡུས་ནས་མཇལ་འཕྲད་གུར་མཆོག་གི་ཞབས་འདེགས་ཕྱིར་ཞོག་ཅིག དེ་ལྟར་ཁྱོད་རྣམས་ཀྱི་ཚེ་སྲོག་བླུ་བ་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་རྗེས་དྲན་ཡོད་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["གཞོང་པའི་སྐོར།"]},{"type":"verse","number":17,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་བཀྲུ་བའི་ཕྱིར་དུ་ལི་ཡི་གཞོང་པ་ཞིག་དང་དེའི་སྟེགས་བུ་ཞིག་བཟོས་ལ། མཇལ་འཕྲད་གུར་མཆོག་དང་མཆོད་ཁྲིའི་བར་དུ་བཞག་ནས་དེའི་ནང་དུ་ཆུ་བླུགས་ཤིག"]},{"type":"verse","number":19,"content":["ཨ་རོན་དང་དེའི་བུ་རྣམས་ཀྱིས་གཞོང་པ་འདིར་ལག་པ་དང་རྐང་པ་བཀྲུ་དགོས།"]},{"type":"verse","number":20,"content":["དེ་དག་མཇལ་འཕྲད་གུར་མཆོག་གི་ནང་དུ་འཇུག་པའམ། ཞབས་ཕྱི་བྱེད་དུ་མཆོད་ཁྲི་དང་ཉེ་བར་འོངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མེ་མཆོད་འབུལ་བའི་ཚེ། འཆི་བར་མི་འགྱུར་བའི་ཕྱིར་ཆུ་དེས་བཀྲུ་དགོས་པ་ཡིན།"]},{"type":"verse","number":21,"content":["རང་རང་གི་ལག་པ་དང་རྐང་པ་གཉིས་བཀྲུས་ན་ཁོ་ཚོ་འཆི་བར་མི་འགྱུར་ཞིང་། དེ་ནི་ཨ་རོན་དང་ཁོའི་བུ་རྒྱུད་རྣམས་ཀྱི་མི་རབས་ནས་མི་རབས་བར་གཏན་དུ་གནས་པའི་སྒྲིག་ཁྲིམས་ཤིག་ཏུ་འགྱུར་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["འབྱུག་སྣུམ་དམ་པའི་སྐོར།"]},{"type":"verse","number":22,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱིས་བསུང་རྫས་རྣམས་ཀྱི་མཆོག་སྟེ། རང་བཞིན་གྱིས་གཤེར་བའི་གུ་གུལ་སྲང་ལྔ་བརྒྱ་དང་ཤིང་ཚ་སྲང་ཉིས་བརྒྱ་དང་ལྔ་བཅུ་ལེན་དགོས་ལ། ཡང་སྲང་ཉིས་བརྒྱ་དང་ལྔ་བཅུ་ཡོད་པའི་ཤུ་དག་དང་།"]},{"type":"verse","number":24,"content":["གནས་མཆོག་གི་སྲང་བཞིན་དུ་ཁ་ཚི་ཡཱ་སྲང་ལྔ་བརྒྱ་དང་། སྐྱུ་རུ་རའི་འཚིར་སྣུམ་རྫ་བུམ་གང་ལོངས་དང་།"]},{"type":"verse","number":25,"content":["རྒྱུ་དེས་འབྱུག་སྣུམ་དམ་པ་བཟོ་དགོས་ཤིང་། དེ་ནི་སྤོས་ཆུ་བཟོ་མཁན་གྱི་ལུགས་བཞིན་དུ་བསྡེབ་པ་སྟེ་འབྱུག་སྣུམ་དམ་པ་ཡིན་དགོས།"]},{"type":"verse","number":26,"content":["དེ་ཡིས་མཇལ་འཕྲད་གུར་མཆོག་དང་དཔང་མཛད་ཤུར་སྒམ་དང་།"]},{"type":"verse","number":27,"content":["སྒྲོག་ཙེ་དང་དེའི་ཡོ་བྱད་ཐམས་ཅད་དང་། སྒྲོན་སྟེགས་དང་དེའི་ཡོ་བྱད་མཐའ་དག་དང་། དེ་མིན་སྤོས་ཁྲི་དང་།"]},{"type":"verse","number":28,"content":["སྦྱིན་སྲེག་གི་མཆོད་ཁྲི་དང་དེའི་ཡོ་བྱད་ཀུན། ཁྲུས་གཞོང་དང་དེའི་སྟེགས་བུ་ལའང་འབྱུག་དགོས།"]},{"type":"verse","number":29,"content":["དངོས་པོ་དེ་རྣམས་ནི་ཀུན་ལས་དམ་པར་འགྱུར་བའི་ཕྱིར་དེ་ལྟར་དམ་པར་བྱོས་ཤིག སུ་དང་གང་གིས་དེ་དག་ལ་རེག་ན་དམ་པར་འགྱུར།"]},{"type":"verse","number":30,"content":["ཁྱོད་ཀྱིས་ཨ་རོན་དང་དེའི་བུ་རྣམས་ལ་འབྱུག་དགོས་ཤིང་། དེ་དག་གིས་ང་རང་ལ་མཆོད་དཔོན་གྱི་ཞབས་ཕྱི་བྱེད་པའི་ཕྱིར་དམ་པར་བྱོས་ཤིག"]},{"type":"verse","number":31,"content":["ཡང་ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་སྐད་སྨྲོས་ཤིག འདི་ནི་ཁྱོད་ཅག་གི་མི་རབས་ནས་མི་རབས་བར་བདག་གི་ཕྱིར་འབྱུག་སྣུམ་དམ་པ་ཡིན་དགོས།"]},{"type":"verse","number":32,"content":["དེ་མི་ཡི་སྟེང་དུ་མི་ལྡུག་པར་གྱིས། ཁྱོད་རྣམས་ཀྱིས་དེ་དང་གཅིག་པའི་སྦྱོར་ལུགས་ཀྱིས་དེ་དང་མཚུངས་པའང་བཟོ་བར་མི་བྱ་སྟེ། ཅི་ཡིན་ཞེ་ན། དེ་ནི་དམ་པ་ཡིན་པས་ཁྱོད་ཅག་གིས་ཀྱང་དེ་དམ་པར་བརྩི་དགོས།"]},{"type":"verse","number":33,"content":["སུས་ཀྱང་དེ་དང་འདྲ་བའི་འབྱུག་སྣུམ་གྱི་སྦྱོར་ལུགས་བྱེད་པའམ། དེ་ཡིས་མི་གཞན་ཞིག་ལ་བྱུགས་པ་སོགས་གང་བྱས་ཀྱང་། མི་དེ་རང་གི་མི་རྣམས་ལས་འཕུད་དགོས་ཞེས་པའོ་གསུངས་སོ། །"]},{"type":"heading","content":["སྤོས་ཀྱི་སྐོར།"]},{"type":"verse","number":34,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བསུང་རྫས་ཏེ། ཐང་སྨན་ཤིང་ཚྭའི་སྣུམ་དང་། དབང་ལག་དང་། གན་ངྷ་ར་ས་དང་སྤོས་དཀར་སླད་མེད་བཅས་མང་ཉུང་མེད་པར་ལོངས་ལ།"]},{"type":"verse","number":35,"content":["སྤོས་ཆུ་བཟོ་མཁན་གྱི་ལུགས་བཞིན་དུ་བསྡེབ་པ་དང་། དེ་ལ་ཚྭ་བསྲེས་ནས་སླད་མེད་པ་དང་དམ་པར་མཛད་དེ་སྤོས་བཟོ་བར་བྱའོ། །"]},{"type":"verse","number":36,"content":["དེ་ལས་སྤོས་ཁ་ཤས་ཕྱེ་མར་བཏགས་ནས། མཇལ་འཕྲད་གུར་མཆོག་གི་ནང་དུ་དཔང་མཛད་ཤུར་སྒམ་གྱི་མདུན་དུ་ང་རང་ཁྱོད་དང་འཕྲད་སར་ཞོག་ཅིག དེ་ནི་ཁྱོད་ཅག་གི་ཕྱིར་ཀུན་ལས་དམ་པ་ཡིན་དགོས།"]},{"type":"verse","number":37,"content":["ཡང་ཁྱོད་ཀྱིས་སྤོས་དེའི་སྦྱོར་ལུགས་བཞིན་དུ་ཁྱོད་ཅག་གི་ཆེད་དུ་སྤོས་བཟོ་མི་རུང་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དེ་ནི་ཁྱོད་ཀྱིས་དམ་པར་བརྩི་དགོས།"]},{"type":"verse","number":38,"content":["སྤོས་དྲིར་བསྣམ་པའི་ཕྱིར་དེ་དང་འདྲ་བ་ཞིག་བཟོ་བའི་མི་སུ་ཡིན་ཡང་རང་གི་མི་རྣམས་ལས་འཕུད་དགོས་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":13,"caller":"+","text":"གཱེ་ར་ཞེས་པ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་གསེར་དངུལ་འཇལ་བྱེད་ཅིག་ཡིན།","reference":{"chapter":30,"verse":13}}]},"thisChapterLink":"/api/bod_ntb/EXO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/29.json","previousChapterAudioLinks":{},"numberOfVerses":38}