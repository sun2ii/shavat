{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":33,"content":[{"type":"heading","content":["ཡང་བསྐྱར་ལམ་དུ་ཆས་པའི་བཀའ་གནང་བ།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་རང་དང་ཁྱོད་ཀྱིས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་པའི་མི་རྣམས་ནི་འདི་ནས་ཡར་སོང་དང་། ངས་ཨབ་ར་ཧམ་དང་། ཨི་སཱག་དང་། ཡ་ཀོབ་བཅས་ལ་མནའ་བསྐྱལ་ནས་ཁས་བླངས་མྱོང་བའི་ཡུལ་དུ་འགྲོ་བར་གྱིས། སྔར་ངས་དེ་རྣམས་ལ་འདི་ལྟར། ངས་ཡུལ་དེ་ཁྱོད་ཀྱི་བུ་རྒྱུད་ལ་གནང་བར་བྱ་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":2,"content":["ངས་ཁྱོད་ཀྱི་མདུན་དུ་ཕོ་ཉ་ཞིག་གཏོང་བར་ངེས་ཏེ། དེས་ཀ་ན་ཨན་པ་དང་ཨེ་མོར་པ་དང་ཧེད་པ་དང་ཕེ་རེ་ཟི་པ་དང་ཧེ་བི་པ་དང་ཡེ་བུ་སི་པ་རྣམས་སྐྲོད་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["ཡུལ་གང་ལ་ཞེ་ན། འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་དེ་ལ་འགྲོ་བར་གྱིས། ང་ཁྱོད་རྣམས་དང་མཉམ་དུ་ཡར་འགྲོ་བར་མི་བྱ་སྟེ། ཁྱོད་ཅག་ནི་འབངས་གཉའ་རེངས་ཤིག་ཡིན་པས། ངས་ལམ་བར་དུ་ཁྱོད་ཅག་མེད་པར་བཟོ་ཉེན་ཡོད་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་མི་རྣམས་ཀྱིས་སེམས་མུག་བྱེད་ཀྱི་གསུང་དེ་ཐོས་པས་མྱ་ངན་བྱས་ཏེ། རྒྱན་ཆ་བཏགས་པ་མི་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":5,"content":["ཅི་ཡིན་ཞེ་ན། སྔར་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་སྐད་སྨྲོས་ཤིག ཁྱོད་ཅག་ནི་འབངས་གཉའ་རེངས་ཡིན་པས་ང་རང་སྐད་ཅིག་ཙམ་ལ་ཁྱོད་ཅག་གི་དཀྱིལ་དུ་ཡོང་ནའང་། བདག་གིས་ཁྱོད་ཅག་མེད་པར་བཟོ་ཉེན་ཡོད། དེའི་ཕྱིར་ཁྱོད་ཅག་གིས་རྒྱན་ཆ་འཕུད་དང་། ངས་ཁྱོད་ཅག་ལ་ཅི་བྱེད་དགོས་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས་པས།"]},{"type":"verse","number":6,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་རི་བོ་ཧོ་རེབ་ནས་བུད་པའི་ཚུན་ལ་རྒྱན་ཆ་རྣམས་རྩ་བ་ནས་བླངས་སོ། །"]},{"type":"heading","content":["མཇལ་འཕྲད་གུར་མཆོག་གི་སྐོར།"]},{"type":"verse","number":7,"content":["ཡང་མོ་ཤེ་ཡིས་རྒྱུན་སྲོལ་བཞིན་སྦྲ་ཞིག་ཁྱེར་ནས་སྒར་གྱི་ཕྱི་རོལ་ཏུ་རྒྱང་ཐག་ཅུང་རིང་བའི་སར་ཕུབ་པ་དང་། དེ་ལ་མཇལ་འཕྲད་གུར་མཆོག་ཅེས་མིང་བཏགས། དཀོན་མཆོག་ཡ་ཝཱེ་དང་མཇལ་བར་དགའ་བའི་མི་རྣམས་རྟག་ཏུ་སྒར་གྱི་ཕྱི་རོལ་ཏུ་ཡོད་པའི་མཇལ་འཕྲད་གུར་མཆོག་ཏུ་སོང་ངོ་། །"]},{"type":"verse","number":8,"content":["མོ་ཤེ་ནམ་ཡང་གུར་མཆོག་ཏུ་འགྲོ་བའི་ཚེ་མི་ཐམས་ཅད་རང་རང་གུར་གྱི་སྒོ་ཁར་ལངས་ནས་མོ་ཤེ་ནང་དུ་ཕྱིན་པའི་བར་དུ་སྡོད་པར་བྱེད།"]},{"type":"verse","number":9,"content":["ཡང་ནམ་ཞིག་མོ་ཤེ་གུར་ནང་དུ་སོང་ཚེ་སྤྲིན་གྱི་ཀ་བ་འབབ་ཅིང་གུར་གྱི་སྒོ་ཁར་འགྲེང་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་གསུང་གླེང་མཛད།"]},{"type":"verse","number":10,"content":["མི་ཀུན་གྱིས་དོན་དེ་མཐོང་བ་ན། མི་ཐམས་ཅད་འགྲེང་ཞིང་རེ་རེས་རང་རང་གུར་གྱི་སྒོ་འགྲམ་ནས་གུས་ཕྱག་ཕུལ་ཏོ། །"]},{"type":"verse","number":11,"content":["དེ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་ཁ་རི་ཁ་ཐུག་ཏུ་གསུང་གླེང་མཛད་ཅིང་། གྲོགས་པོས་གྲོགས་པོ་ལ་གླེང་མོལ་བྱེད་པ་བཞིན་ཡིན། ཡང་ནམ་ཞིག་མོ་ཤེ་སྒར་ལ་ཕྱིར་ལོག་ཚེ། དེའི་གཞོན་ནུ་ཞབས་ཕྱི་སྟེ་ནུན་ཞེས་པའི་བུ་ཡོ་ཤུ་ཨ་གཅིག་པུ་གུར་དང་མ་བྲལ་བར་བསྡད་དོ། །"]},{"type":"heading","content":["མོ་ཤེ་དང་དཀོན་མཆོག་གི་གཟི་བྱིན་སྐོར།"]},{"type":"verse","number":12,"content":["ཡང་མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ། གཟིགས་པར་ཞུ། ཁྱེད་ཀྱིས་ང་ལ་མི་འདི་རྣམས་ཡར་ཁྲིད་ཅིག་ཅེས་གསུངས་ཀྱང༌། ཁྱེད་ཀྱིས་སུ་ཞིག་ང་དང་མཉམ་དུ་འགྲོ་བར་མངག་རྒྱུ་ཡིན་པ་བདག་ལ་མ་གསུངས་ཤིང་། ཡང་སྔར་ནས་འདི་སྐད་དུ། ངས་ཁྱོད་ཀྱི་མིང་ནས་ཁྱོད་ངོ་ཤེས་ཤིང་བདག་གི་མིག་ལམ་ནས་ཁྱོད་ལ་སྙིང་རྗེ་ཐོབ་པ་ཡིན་ཞེས་གསུངས་མྱོང་བས།"]},{"type":"verse","number":13,"content":["གལ་ཏེ་ཁྱེད་ཀྱི་སྤྱན་སྔར་ང་ལ་ཐུགས་རྗེ་ཐོབ་པ་ཡིན་ན། བདག་ལ་ཁྱེད་ཀྱི་ལམ་སྟོན་པར་མཛོད། དེ་ལྟར་མཛད་ན་ངས་ཁྱེད་རང་ངོ་ཤེས་ཤིང་ཁྱེད་ཀྱི་སྤྱན་སྔར་ཐུགས་རྗེ་འཐོབ་ངེས་ཡིན་ལ། ཡང་མི་རིགས་འདི་ནི་ཁྱེད་ཀྱི་འབངས་མི་ཡིན་པར་གཟིགས་སུ་གསོལ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་འདི་སྐད་དུ། ང་རང་དངོས་སུ་ཁྱོད་དང་མཉམ་དུ་འགྲོ་ཞིང་ཁྱོད་ལ་ངལ་གསོ་སྟེར་བར་བྱ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་མོ་ཤེ་ཡིས་ཁོང་ལ་འདི་ལྟར། གལ་ཏེ་ཁྱེད་ཉིད་དངོས་སུ་ང་ཚོ་དང་ལྷན་དུ་མི་ཕེབས་ན། ངེད་རྣམས་འདི་ནས་ཡར་ལའང་མི་འཁྲིད་རོགས།"]},{"type":"verse","number":16,"content":["ཁྱེད་རང་ངེད་རྣམས་དང་ལྷན་དུ་ཕེབས་ན་མ་གཏོགས། བདག་དང་ཁྱེད་ཀྱི་འབངས་མི་དང་བཅས་པ་ལ་ཁྱེད་ཀྱི་སྤྱན་སྔར་ཐུགས་རྗེ་ཐོབ་པ་ནི་མི་གཞན་དག་གིས་ཅི་ལྟར་ཤེས་ཐུབ་བམ། དེ་ལྟར་ལྷན་དུ་ཕེབས་པ་ན། ད་གཟོད་ས་སྟེང་གི་མི་ཐམས་ཅད་དང་ང་རང་ཐེ་བའི་ཁྱེད་ཀྱི་འབངས་མི་ལ་ཁྱད་པར་ཡོད་པ་ཤེས་པར་འགྱུར་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":17,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། བདག་གི་མིག་ལམ་ནས་ཁྱོད་ལ་སྙིང་རྗེ་ཐོབ་ཅིང་ངས་ཁྱོད་ཀྱི་མིང་ནས་ཁྱོད་ངོ་ཤེས་པས། ང་རང་ལ་ཞུས་པ་བཞིན་དུ་བདག་གིས་ཀྱང་བྱེད་པར་འགྱུར་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":18,"content":["མོ་ཤེ་ཡིས། ཁྱེད་ཀྱི་གཟི་བརྗིད་ང་ལ་སྟོན་པར་མཛོད་ཅེས་ཞུས་ཤིང་།"]},{"type":"verse","number":19,"content":["ཁོང་གིས་འདི་སྐད་དུ། བདག་གིས་རང་གི་དྲིན་ཐམས་ཅད་ཁྱོད་ཀྱི་མདུན་དུ་འགྲོ་བར་འཇུག་ཅིང་དཀོན་མཆོག་ཡ་ཝཱེའི་མིང་ཡང་སྒྲོག་པར་བྱ། ངས་སུ་ཞིག་ལ་བརྩེ་བར་བསམ་ན་དེ་ལ་བརྩེ་བར་བྱ། ཡང་སུ་ཞིག་ལ་སྙིང་རྗེ་བར་འདོད་ན་དེ་ལ་སྙིང་རྗེ་བར༌བྱ་ཞེས་གསུངས།"]},{"type":"verse","number":20,"content":["ཡང་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བདག་གི་གདོང་ནི་མཐོང་མི་རུང་སྟེ། ཅིའི་ཕྱིར་ཞེ་ན། བདག་གི་གདོང་མཐོང་བའི་མི་སུ་ཡིན་ཡང་གསོན་པོར་འདུག་མི་ཐུབ་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":21,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངའི་དྲུང་དུ་གནས་ཤིག་ཡོད་དེ། ཁྱོད་རང་བྲག་དེའི་སྟེང་ལ་འགྲེང་བར་གྱིས།"]},{"type":"verse","number":22,"content":["ངའི་གཟི་བརྗིད་ཁྱོད་ཀྱི་མདུན་དུ་ཕར་འགྲོ་བའི་ཚེ། བདག་གིས་ཁྱོད་རང་བྲག་སྲུབས་ཤིག་ཏུ་བཞག་སྟེ། ང་རང་ཕར་བཞུད་པའི་བར་དུ་ངའི་ལག་པས་ཁྱོད་རང་འགེབ་པར་བྱ།"]},{"type":"verse","number":23,"content":["དེའི་རྗེས་སུ་ངས་རང་གི་ལག་པ་ཕྱིར་འཐེན་ཚེ་ཁྱོད་ཀྱིས་ངའི་རྒྱབ་མཐོང་བར་འགྱུར་ནའང་། གདོང་ནི་གཏན་ནས་མཐོང་བར་མི་རུང་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/32.json","previousChapterAudioLinks":{},"numberOfVerses":23}