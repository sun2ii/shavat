{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":5,"content":[{"type":"heading","content":["ཕཱར་ཨོལ་གྱིས་དཀོན་མཆོག་གི་ཐུགས་དགོངས་ལ་ངོ་རྒོལ་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཕཱར་ཨོལ་གྱི་གམ་དུ་སོང་ནས་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གི་འབངས་མིས་དབེན་སྟོང་ནས་བདག་ལ་དུས་ཆེན་བསྲུང་བའི་ཕྱིར་དེ་རྣམས་འགྲོ་རུ་ཆུག་ཅེས་གསུངས་བྱུང་སྨྲས་པ་ལ།"]},{"type":"verse","number":2,"content":["ཕཱར་ཨོལ་ན་རེ། དཀོན་མཆོག་ཡ༌ཝཱེ་ནི་སུ་ཡིན་ནམ། ངས་ཅིའི་ཕྱིར་ཁོའི་བཀའ་ལ་མཉན་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་འགྲོ་རུ་འཇུག་དགོས་སམ། ངས་ཡ་ཝཱེ་མི་ཤེས་ལ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱང་མི་གཏོང་ཞེས་སྨྲས།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཁོ་གཉིས་ན་རེ། ཨིབ་རི་པའི་དཀོན་མཆོག་ནི་ངེད་ཅག་ལ་ཕྲད་མྱོང་བ་ཡིན། ཁོང་གིས་རིམས་ནད་དམ་རལ་གྲི་ཡིས་རང་ཅག་མི་འགེམ་པའི་ཕྱིར། ངེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་འབུལ་བར་ཞག་མ་གསུམ་གྱི་ལམ་ལ་དབེན་སྟོང་དུ་འགྲོ་རུ་འཇུག་པར་མཛོད་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":4,"content":["ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོས་འདི་ལྟར། མོ་ཤེ་དང་ཨ་རོན་ཁྱོད་གཉིས་ཀྱིས་ཅིའི་ཕྱིར་མི་དེ་རྣམས་ལ་ལས་བྱོལ་བྱེད་དུ་འཇུག་གམ། ཁྱོད་རྣམས་རང་གི་ལས་ཀ་བྱེད་དུ་སོང་ཞིག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":5,"content":["ཡང་འདི་ལྟར། ད་ལྟ་ཡུལ་འདིའི་མི་རྣམས་ཀྱི་གྲངས་ཀ་ནི་ཤིན་ཏུ་མང་ནའང་། ཁྱོད་གཉིས་ཀྱིས་དེ་རྣམས་ལ་ལས་ཀ་མི་བྱེད་པར་སྡོད་དུ་འཇུག་གམ་ཞེས་སྨྲས།"]},{"type":"verse","number":6,"content":["ཉིན་དེར། ཕཱར་ཨོལ་གྱིས་མི་རྣམས་ཀྱི་ལས་རྒྱབ་པ་དང་ལས་དཔོན་རྣམས་ལ་འདི་ལྟར།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་མི་རྣམས་ལ་སྔར་བཞིན་སོ་ཕག་བཟོ་བར་རྩྭ་མ་སྟེར་ཅིག ཁོ་རྣམས་རང་ཉིད་རྩྭ་འཐུ་རུ་འགྲོ་དགོས།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་མི་རྣམས་ཀྱིས་སྔར་ནས་སོ་ཕག་ཇི་ཙམ་བཟོས་པ་དེ་ཙམ་ཁྱོད་ཅག་གིས་ཁོ་རྣམས་ལ་བཀལ་ནས། ཏོག་ཙམ་ཡང་ཇེ་ཉུང་དུ་མ་གཏོང་ཞིག ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་ནི་སྒྱིད་ལུག་ཡིན་པས། ངེད་རྣམས་རང་གི་དཀོན་མཆོག་ལ་མཆོད་པ་འབུལ་དུ་འགྲོ་བར་མཛོད་ཅེས་སྐད་ཅོར་རྒྱག་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་ཅག་གིས་མི་འདི་དག་གི་ལས་ཚགས་ཇེ་ལྗིད་དུ་བཏང་ནས། ཁོ་རྣམས་ལ་དཀའ་ལས་མྱང་དུ་བཅུག་སྟེ་རྫུན་གཏམ་ལ་མི་མཉན་པར་བྱེད་དགོས་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་མི་རྣམས་ཀྱི་ལས་རྒྱབ་པ་དང་ལས་དཔོན་རྣམས་སོང་ནས་མི་རྣམས་ལ་འདི་ལྟར། ཕཱར་ཨོལ་གྱིས་འདི་སྐད་དུ། ངས་ཁྱོད་ཅག་ལ་རྩྭ་ནི་མི་སྟེར།"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་རང་རང་གིས་གང་དུ་རྩྭ་རྙེད་ཐུབ་ན་དེ་རུ་བཙལ་དུ་སོང་། འོན་ཀྱང་ཁྱོད་ཅག་གི་ལས་ཀ་ཏོག་ཙམ་ཡང་ཉུང་དུ་གཏོང་མི་རུང་གསུངས་ཞེས་སྨྲས།"]},{"type":"verse","number":12,"content":["དེ་ནས་མི་དེ་རྣམས་ཨེ་ཅིབ་ཡུལ་ཀུན་ཏུ་ཐོར་ནས་སོག་མ་བཏུས་ཏེ་རྩྭ་རུ་བྱས་པ་ལ།"]},{"type":"verse","number":13,"content":["ལས་རྒྱབ་པ་རྣམས་ཀྱིས་ཚ་འདེད་བྱས་ཏེ་ན་རེ། ཁྱོད་རྣམས་ཀྱིས་ཉིན་རེ་བཞིན་ལས་ཀ་བསྒྲུབས་ཚར་དགོས་ལ། དེ་སྔར་རྩྭ་ཡོད་པའི་དུས་བཞིན་བསྒྲུབ་དགོས་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":14,"content":["ཡང་ཕཱར་ཨོལ་མངའ་འོག་གི་ལས་རྒྱབ་པ་རྣམས་ཀྱིས་སྔར་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ལས་རྒྱབ་པར་བསྐོས་པའི་ལས་དཔོན་རྣམས་ལ་རྡུང་རྡེག་བྱས་ཏེ་ན་རེ། ཁྱོད་ཅག་གིས་ཁ་སང་དེ་རིང་སྔོན་ཆད་ཀྱི་གྲངས་ཀ་ལྟར་སོ་ཕག་མ་བཟོས་པ་དང་རང་གི་ལས་ཀ་བསྒྲུབས་མ་ཚར་བ་ཅི་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པའི་ལས་འཛིན་པ་རྣམས་ཕཱར་ཨོལ་གྱི་དྲུང་དུ་འོངས་ཏེ་སྐད་ཆེན་པོས། ཁྱེད་ཀྱིས་རང་གི་བྲན་གཡོག་རྣམས་ལ་འདི་ལྟར་བྱེད་དོན་ཅི།"]},{"type":"verse","number":16,"content":["ཁྱེད་ཀྱི་བྲན་གཡོག་རྣམས་ལ་རྩྭ་མ་བྱིན་ཡང་ལས་རྒྱབ་པས་ངེད་ཅག་ལ་སོ་ཕག་བཟོས་ཤིག་ཅེས་ཡང་ཡང་བསྐུལ་ཞིང་། ལྟོས་དང་། ཁྱེད་ཀྱི་བྲན་གཡོག་རྣམས་ལ་རྡུང་རྡེག་ཀྱང་ཐེབས། དོན་དམ་དུ་དེ་ནི་ཁྱེད་ཀྱི་འབངས་མི་རྣམས་ཀྱི་ཉེས་སྐྱོན་ཡིན་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":17,"content":["ཕཱར་ཨོལ་ན་རེ། ཁྱོད་ཅག་ནི་དངོས་གནས་ལེ་ལོ་ཅན་ཡིན་འདུག དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ངེད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་འབུལ་དུ་འགྲོ་བར་མཛོད་ཅེས་ཟེར་རོ། །"]},{"type":"verse","number":18,"content":["ད་ནི་ཁྱོད་རྣམས་ལས་ཀ་བྱེད་དུ་སོང་ཞིག ཁྱོད་ཅག་ལ་རྩྭ་མི་སྟེར་ནའང་སོ་ཕག་ནི་གྲངས་ཀ་ལྟར་སྤྲོད་དགོས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["ཡེས་ར་ཨེལ་པའི་ལས་འཛིན་པ་རྣམས་ཀྱིས། ཁྱོད་ཅག་གིས་ཉིན་རེ་བཞིན་སོ་ཕག་བཟོ་བའི་ལས་ཀ་ནི་ཏོག་ཙམ་ཡང་ཉུང་དུ་གཏོང་མི་རུང་ཞེས་པའི་བཀའ་ཐོས་པས། དོན་ངན་ཞིག་དང་ཕྲད་པ་ཤེས་སོ། །"]},{"type":"verse","number":20,"content":["ཡང་ཁོ་རྣམས་ཕཱར་ཨོལ་གྱི་དྲུང་ནས་སོང་བ་ལ། མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱིས་ལངས་ནས་སྒུག་བསྡད་ཡོད་པ་དང་ཕྲད་པས།"]},{"type":"verse","number":21,"content":["ཁོ་གཉིས་ལ་འདི་ལྟར། ཁྱོད་གཉིས་ཀྱིས་ཕཱར་ཨོལ་དང་དེའི་འཁོར་གཡོག་གི་མདུན་དུ་ངེད་རྣམས་དྲི་ངན་པར་བྱས་ཤིང་། ངེད་ཅག་གསོད་པའི་ཕྱིར་དེ་དག་གི་ལག་ཏུ་རལ་གྲི་བཞག་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་གཉིས་ལ་དཔྱད་ཞིབ་གནང་ནས་ཤན་འབྱེད་པར་ཤོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་མོ་ཤེ་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ལོག་སྟེ་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ལགས། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་མི་འདི་རྣམས་དཀའ་སྡུག་ལ་སྦྱར་བ་ཡིན་ནམ། ཅིའི་ཕྱིར་ང་རང་མངགས་པ་ཡིན་ནམ།"]},{"type":"verse","number":23,"content":["ཡང་ང་རང་ཕཱར་ཨོལ་གྱི་གམ་དུ་སོང་སྟེ་ཁྱེད་ཀྱི་མཚན་ལ་བརྟེན་ནས་གཏམ་སྨྲས་པའི་དུས་ནས་བཟུང་། ཁོས་མི་འདི་རྣམས་དཀའ་སྡུག་ལ་སྦྱར་ཞིང་། ཁྱེད་ཀྱིས་ཁོ་རྣམས་སྐྱོབ་པར་གཏན་ནས་མ་མཛད་ཅེས་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}