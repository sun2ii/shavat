{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":6,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཐར་པའི་ཞལ་བཞེས་གནང་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ངས་ཕཱར་ཨོལ་ལ་ཅི་བྱེད་པ་དེ་ཁྱོད་ཀྱིས་ད་ལྟ་མཐོང་བར་འགྱུར། བདག་གི་མཐུ་ལྡན་ལག་པའི་རྐྱེན་གྱིས་ཁོས་ཡེས་ར་ཨེལ་པ་རྣམས་འགྲོ་རུ་འཇུག་པར་མ་ཟད། དེ་རྣམས་ཁོའི་ཡུལ་གྱི་ཕྱི་རུ་སྐྲོད་པར་འགྱུར་ཞེས་གསུངས་ཤིང་།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་གིས་ཡང་མོ་ཤེ་ལ་འདི་སྐད་དུ། བདག་ནི་ཡ་ཝཱེ་ཡིན་ལ།"]},{"type":"verse","number":3,"content":["བདག་ནི་ཀུན་དབང་དཀོན་མཆོག་ཡིན་པ་སྔར་ཨབ་ར་ཧམ་དང་ཨི་སཱག་དང་ཡ་ཀོབ་བཅས་ལ་མངོན་པར་བྱས་པ་ཡིན་མོད། འོན་ཀྱང་བདག་གི་མིང་ཡ་ཝཱེ་ཞེས་པ་དེ་ལས་ངས་རང་ཉིད་ཁོ་རྣམས་ལ་མངོན་པར་མ་བྱས།"]},{"type":"verse","number":4,"content":["བདག་གིས་ཁོ་རྣམས་བྱེས་སུ་སྡོད་སའི་ཀ་ན་ཨན་ཡུལ་དེ་ཁོ་རྣམས་ཀྱི་དབང་དུ་གཏོང་བར་བྱེད་པའི་ཁ་ཆད་ཀྱང་དེ་རྣམས་ལ་བཞག་པ་དང་།"]},{"type":"verse","number":5,"content":["དེ་མིན་ཨེ་ཅིབ་པས་ཡེས་ར་ཨེལ་པ་རྣམས་ཚེ་གཡོག་ཏུ་བཀོལ་བས། དེ་དག་གིས་བཏོན་པའི་སྡུག་ཡུས་བདག་གིས་ཐོས་ཤིང་། རང་གི་ཁ་ཆད་ཀྱང་དྲན་པ་ཡིན།"]},{"type":"verse","number":6,"content":["དེ་བས་ན་ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟརཤོད་དང་། བདག་ནི་ཡ་ཝཱེ་ཡིན་ཏེ། བདག་གིས་ཁྱོད་རྣམས་ཨེ་ཅིབ་པའི་གཉའ་གནོན་འོག་ནས་འདོན་པ་དང་། དེ་དག་གི་ཚེ་གཡོག་བྱེད་པ་ལས་སྒྲོལ་ཞིང་། ཕྱག་བརྐྱངས་ནས་དེ་རྣམས་ལ་ཉེས་ཆད་དྲག་པོ་གཅོད་པའི་སྒོ་ནས་ཁྱོད་ཅག་བླུ་བར་བྱ།"]},{"type":"verse","number":7,"content":["བདག་གིས་ཁྱོད་རྣམས་ང་ཡི་འབངས་མི་བྱེད་ཅིང་། བདག་ཀྱང་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་བྱེད་རྒྱུ་ཡིན། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་པ་དང་། ཁྱོད་རྣམས་ཨེ་ཅིབ་པའི་གཉའ་གནོན་འོག་ནས་ཐར་དུ་འཇུག་མཁན་ཡིན་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["བདག་གིས་ཨབ་ར་ཧམ་དང་། ཨི་སཱག་དང་། ཡ་ཀོབ་བཅས་ལ་སྦྱིན་པར་མནའ་བསྐྱལ་ནས་ཁས་བླངས་པའི་ཡུལ་དེར་ཁྱོད་རྣམས་འཁྲིད་པ་དང་། ཡུལ་དེ་ཁྱོད་རྣམས་ལ་ཐོབ་སྐལ་དུ་སྦྱིན་པར་བྱ། བདག་ནི་ཡ་ཝཱེ་ཡིན་ཞེས་སྨྲ་དགོས་པར་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["མོ་ཤེ་ཡིས་བཀའ་དེ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྨྲས་ནའང་། ཁོ་རྣམས་གཉའ་གནོན་དྲག་པོས་གདུང་བས་མོ་ཤེ་ལ་མ་མཉན་ཏོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":11,"content":["ཁྱོད་སོང་ནས་ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་ལ། ཡེས་ར་ཨེལ་པ་རྣམས་ཁྱོད་ཀྱི་ཡུལ་ནས་འགྲོ་རུ་ཆུག་ཅེས་སྨྲོས་ཤིག་ཅེས་གསུངས་མོད།"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་འདི་ལྟར། གཟིགས་པར་ཞུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཀྱང་ང་ལ་མི་མཉན་ན། ཕཱར་ཨོལ་གྱིས་སྨྲ་ལྕེ་རྟུལ་པོ་བདག་ལྟ་བུ་ལ་ཅི་ལྟར་མཉན་སྲིད་དམ་ཞེས་ཞུས།"]},{"type":"verse","number":13,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་ལ་གསུང་གླེང་གནང་བ་སྟེ། ཡེས་ར་ཨེལ་པ་རྣམས་དང་ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་གམ་དུ་སོང་ནས། ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་འཁྲིད་དགོས་པའི་བཀའ་གནང་བའོ། །"]},{"type":"heading","content":["མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱི་རིགས་རྒྱུད།"]},{"type":"verse","number":14,"content":["ཁོ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་རེ་རེའི་ཁྱིམ་དཔོན་དག་གི་མིང་ནི་གཤམ་གསལ་ལྟར། ཡེས་ར་ཨེལ་གྱི་སྐྱེས་འགོ་རུ་བེན་གྱི་བུ་རྣམས་ནི་ཧ་ནོག་དང་ཕཱ༌ལུའུ། ཧེས་རོན། ཀར་མའེ་བཅས་ཡིན་ཞིང་། དེ་རྣམས་ནི་རུ་བེན་གྱི་རུས་རྒྱུད་ཡིན།"]},{"type":"verse","number":15,"content":["སི་མུ་ཨོན་གྱི་བུ་རྣམས་ནི་ཡཱ་མུ་ཨེལ་དང་ཡཱ༌མེན། ཨོ་ཧད། ཡཱ་ཀིན། ཚོ་ཧར། ཀ་ན་ཨན་བུད་མེད་ཀྱི་བུ་ཤཱ་ཨུལ་བཅས་ཡིན་ཞིང་། དེ་རྣམས་ནི་སི་མུ་ཨོན་གྱི་རུས་རྒྱུད་ཡིན།"]},{"type":"verse","number":16,"content":["ལེ་ཝི་ཡི་བུ་རྣམས་ཀྱི་མིང་རྣམས་རང་རང་གི་རིགས་རྒྱུད་བཞིན་བཀོད་པ་གཤམ་གསལ་ལྟར། གེར་ཤོན་དང་ཀོ་ཧད། མཱ་རཱ་རེའེ་བཅས་གསུམ་ཡིན་ཞིང་། ལེ་ཝི་ཡི་ཚེ་ཚད་ནི་ལོ་བརྒྱ་དང་སོ་བདུན་ཡིན།"]},{"type":"verse","number":17,"content":["གེར་ཤོན་གྱི་བུ་ནི་རང་རང་གི་རུས་རྒྱུད་བཞིན་དུ་ལིབ་ནིས་དང་ཤིམ་ཨི་གཉིས་ཡིན།"]},{"type":"verse","number":18,"content":["ཀོ་ཧད་ཀྱི་བུ་རྣམས་ནི་ཨམ་རམ་དང་ཡེས་ཧར། ཧེབ་རོན། ཨུ་ཟི་ཨེལ་བཅས་ཡིན་ཞིང་། ཀོ་ཧད་ཀྱི་ཚེ་ཚད་ནི་ལོ་བརྒྱ་དང་སོ་གསུམ་ཡིན།"]},{"type":"verse","number":19,"content":["མཱ་རཱ་རེའེ་ཡི་བུ་རྣམས་ནི་མཱ་ལི་དང་མུ་ཤི་གཉིས་ཡིན་ཞིང་། དེ་རྣམས་ནི་ལེ་ཝི་ཡི་རུས་རྒྱུད་དེ་རང་རང་གི་རིགས་རྒྱུད་བཞིན་དུ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["ཨམ་རམ་གྱིས་རང་གི་ཕ་ཡི་སྲིང་མོ་ཡོ་ཀེ་བེད་ཆུང་མར་བླངས་ཤིང་། དེས་ཁོ་རང་ལ་ཨ་རོན་དང་མོ་ཤེ་གཉིས་བཙས། ཨམ་རམ་གྱི་ཚེ་ཚད་ནི་ལོ་བརྒྱ་དང་སོ་བདུན་ཡིན།"]},{"type":"verse","number":21,"content":["ཡེས་ཧར་གྱི་བུ་རྣམས་ནི་ཀོ་རཱག་དང༌ནེ་ཕེག ཟིག་རི་བཅས་ཡིན།"]},{"type":"verse","number":22,"content":["ཨུ་ཟི་ཨེལ་གྱི་བུ་རྣམས་ནི་མེ་ཤཱ་ཨེལ་དང་ཨེལ་ཙ་ཕཱན། སིད་རེའེ་བཅས་ཡིན།"]},{"type":"verse","number":23,"content":["ཡང་ཨ་རོན་གྱིས་ཨ་མི་ནཱ་དབ་ཀྱི་བུ་མོ་དང་ནཱ་སོན་གྱི་ནུ་མོ་སྟེ་ཨེ་ལི་ཤེ་བཱ་ཆུང་མར་བླངས་ཤིང་། དེས་ཁོ་རང་ལ་བུ་ནཱ་དབ་དང་ཨ་བི་ཧུ། ཨེ་ལི་ཨ་ཟར། ཨི་ཐ་མཱར་བཅས་བཙས།"]},{"type":"verse","number":24,"content":["ཀོ་རཱག་གི་བུ་རྣམས་ནི་ཨ་སིར་དང་ཨེལ་ཁ་ནཱ། ཨ་བི་ཨ་སིབ་བཅས་ཡིན་ཞིང་། དེ་རྣམས་ནི་ཀོ་རཱག་པའི་རུས་རྒྱུད་ཡིན།"]},{"type":"verse","number":25,"content":["ཡང་ཨ་རོན་གྱི་བུ་ཨེ་ལི་ཨ་ཟར་གྱིས་ཕུ་ཏི་ཨེལ་གྱི་བུ་མོ་རྣམས་ལས་གཅིག་ཆུང་མར་བླངས་ཤིང་། དེས་ཁོ་ལ་ཕི་ནེ་ཧེ་བཙས། དེ་རྣམས་ནི་རུས་རྒྱུད་བཞིན་ལེ་ཝི་པའི་ཁྱིམ་རྒྱུད་རེ་རེའི་ཁྱིམ་དཔོན་ཡིན་ནོ། །"]},{"type":"verse","number":26,"content":["སྔར་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་དཔུང་ཚོགས་རེ་རེ་བཞིན་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཁྲིད་ཅིག་ཅེས་པའི་བཀའ་ནི་ཨ་རོན་དང་མོ་ཤེ་འདི་གཉིས་ལ་གནང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":27,"content":["ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་ལ་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་འཁྲིད་པར་འགྱུར་བའི་གཏམ་སྨྲ་མཁན་ནི་མོ་ཤེ་དང་ཨ་རོན་འདི་གཉིས་ཡིན་ནོ། །"]},{"type":"verse","number":28,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཡུལ་ནས་མོ་ཤེ་ལ་བཀའ་གནང་བའི་ཉིན་མོ་དེར།"]},{"type":"verse","number":29,"content":["ཁོང་གིས་འདི་སྐད་དུ། བདག་ནི་ཡ་ཝཱེ་ཡིན། ངས་ཁྱོད་ལ་ཅི་སྨྲ་བ་ཐམས་ཅད་ཁྱོད་ཀྱིས་ཨེ་ཅིབ་རྒྱལ་པོ་ཕཱར་ཨོལ་ལ་སྨྲ་བར་གྱིས་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":30,"content":["མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འདི་ལྟར། གཟིགས་པར་ཞུ། ང་རང་ནི་སྨྲ་ལྕེ་རྟུལ་པོ་ཡིན་པས། ཕཱར་ཨོལ་གྱིས་བདག་ལ་ཅི་ལྟར་མཉན་སྲིད་དམ་ཞེས་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}