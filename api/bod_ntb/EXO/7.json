{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":7,"content":[{"type":"heading","content":["མོ་ཤེའི་ཚབ་ཏུ་ཨ་རོན་གྱིས་གཏམ་སྨྲ་བར་ཐུགས་ཐག་བཅད་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ཕཱར་ཨོལ་གྱི་མདུན་དུ་ཁྱོད་རང་དཀོན་མཆོག་ལྟ་བུར་བྱས་པ་དང་། ཡང་ཁྱོད་ཀྱི་སྤུན་ཨ་རོན་ནི་ཁྱོད་ཀྱི་ལུང་སྟོན་པ་ཡིན་པར་འགྱུར།"]},{"type":"verse","number":2,"content":["ངས་ཁྱོད་ལ་བཀའ་ཅི་གནང་བ་ཐམས་ཅད་ཁྱོད་ཀྱིས་སྨྲ་དགོས་པ་དང་། ཁྱོད་ཀྱི་སྤུན་ཨ་རོན་གྱིས་ཕཱར་ཨོལ་ལ། ཡེས་ར་ཨེལ་པ་རྣམས་ཁོའི་ཡུལ་ནས་འགྲོ་རུ་འཇུག་པའི་གཏམ་དེ་སྨྲ་དགོས།"]},{"type":"verse","number":3,"content":["ངས་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་བྱེད་པ་དང་། ཨེ་ཅིབ་ཡུལ་ནས་ང་ཡི་གྲུབ་རྟགས་དང་དོན་ངོ་མཚར་ཅན་མང་པོའང་སྟོན་པར་བྱ།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་ཕཱར་ཨོལ་གྱིས་ཁྱོད་ཅག་ལ་མི་མཉན་ཞིང་། བདག་གིས་ལག་པ་བརྐྱངས་ནས་ཨེ་ཅིབ་ཡུལ་ལ་ཉེས་ཆད་དྲག་པོ་གཅོད་ཅིང་། བདག་གི་མི་ཚོགས་སྟེ་ང་ཡི་འབངས་མི་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་འཁྲིད་པར་བྱའོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ངས་ལག་པ་བརྐྱངས་ནས་ཨེ་ཅིབ་ཡུལ་ལ་རྒོལ་ཞིང་། ཡེས་ར་ཨེལ་པ་རྣམས་དེ་དག་གི་ཁྲོད་ནས་ཕྱིར་འཁྲིད་པའི་དུས་སུ། ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས་པས།"]},{"type":"verse","number":6,"content":["མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱིས་དེ་ལྟར་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ཇི་ལྟར་བསྩལ་པ་བཞིན་དུ་བྱས་པ་དང་།"]},{"type":"verse","number":7,"content":["ཁོ་གཉིས་ཀྱིས་ཕཱར་ཨོལ་ལ་གཏམ་སྨྲ་བའི་དུས་སུ་མོ་ཤེ་ལོ་བརྒྱད་ཅུ་དང་། ཨ་རོན་ལོ་བརྒྱད་ཅུ་གྱ་གསུམ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཨ་རོན་གྱི་འཁར་བ་སྦྲུལ་དུ་གྱུར་པ།"]},{"type":"verse","number":8,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":9,"content":["ཕཱར་ཨོལ་གྱིས་ཁྱོད་ཅག་ལ་དོན་ངོ་མཚར་ཅན་ཞིག་སྟོན་པར་གྱིས་ཞེས་སྨྲ་བའི་ཚེ། ཁྱོད་ཀྱིས་ཨ་རོན་ལ། རང་གི་འཁར་བ་ཕཱར་ཨོལ་གྱི་མདུན་དུ་གཡུགས་ཤིག དེ་སྦྲུལ་དུ་འགྱུར་བ་ཡིན་སྨྲོས་ཤིག་ཅེས་གསུངས།"]},{"type":"verse","number":10,"content":["དེ་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཕཱར་ཨོལ་གྱི་མདུན་དུ་སོང་ནས། དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ཇི་ལྟར་གནང་བ་བཞིན་དུ་བྱས་ཏེ། ཨ་རོན་གྱིས་ཕཱར་ཨོལ་འཁོར་དང་བཅས་པའི་མདུན་དུ་འཁར་བ་གཡུགས་པ་ལ་དེ་སྦྲུལ་དུ་གྱུར་པ་དང་།"]},{"type":"verse","number":11,"content":["ཕཱར་ཨོལ་གྱིས་མཁས་པ་དང་སྒྱུ་མ་མཁན་དག་བོས་འོངས་ཤིང་། དེ་རྣམས་ནི་ཨེ་ཅིབ་ཡུལ་གྱི་རྫུ་འཕྲུལ་སྟོན་མཁན་ཡིན་ལ། ཁོ་རྣམས་ཀྱིས་ཀྱང་རྫུ་འཕྲུལ་ལ་བརྟེན་ནས་དེ་བཞིན་བྱས་པ་སྟེ།"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་རང་རང་གི་འཁར་བ་སར་འཕངས་པ་དང་དེ་སྦྲུལ་དུ་གྱུར་མོད། འོན་ཀྱང་ཨ་རོན་གྱི་འཁར་བས་དེ་དག་གི་འཁར་བ་རྣམས་ཁྱུར་མིད་བཏང་།"]},{"type":"verse","number":13,"content":["ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་གྱུར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་བཞིན་དུ་ཁོས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་མ་མཉན་ཏོ། །"]},{"type":"heading","content":["གཙང་པོ་ཁྲག་ལ་འགྱུར་བའི་ཆག་སྒོ།"]},{"type":"verse","number":14,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཕཱར་ཨོལ་གྱི་སེམས་ཨུ་ཚུགས་ཆེ་ཞིང་མི་རྣམས་འགྲོ་རུ་མི་འཇུག"]},{"type":"verse","number":15,"content":["སང་ཉིན་ཞོགས་པར་ཕཱར་ཨོལ་གྱི་མདུན་དུ་སོང་ཞིག ལྟོས་དང་། ཁོ་རང་ཕྱི་རུ་འོངས་ནས་ཆུ་ཁར་འགྲོ་བའི་དུས་སུ། ཁྱོད་རང་ནཱ་ཡོལ་གཙང་པོའི་འགྲམ་དུ་ལངས་བསྡད་ནས་ཁོ་བསུ་དགོས་ཤིང་། སྦྲུལ་དུ་གྱུར་མྱོང་བའི་འཁར་བ་དེ་ལག་ཏུ་ཟུངས་ཤིག"]},{"type":"verse","number":16,"content":["དེ་ནས་ཁོ་ལ་འདི་ལྟར་ཤོད་དང་། ཨིབ་རི་པའི་དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་ཁྱོད་ཀྱི་མདུན་དུ་མངགས་ནས་འདི་སྐད་དུ། བདག་ལ་བསྙེན་བཀུར་བྱེད་པའི་ཆེད་དུ་བདག་གི་འབངས་མི་དབེན་སྟོང་དུ་འགྲོ་རུ་ཆུག་ཅེས་གསུངས་ནའང་། ལྟོས་དང་། ཁྱོད་ཀྱིས་ད་ལྟའི་བར་དུ་མ་མཉན་ཏོ། །"]},{"type":"verse","number":17,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གིས་རང་གི་ལག་ཏུ་ཡོད་པའི་འཁར་བས་ནཱ་ཡོལ་གཙང་པོའི་ཆུ་ལ་བརྡེག་ཅིང་ཆུ་ནི་ཁྲག་ཏུ་འགྱུར་བ་དང་། དེར་བརྟེན་ནས་ཁྱོད་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་ངེས།"]},{"type":"verse","number":18,"content":["ནཱ་ཡོལ་གཙང་པོའི་ཉ་རྣམས་ཤི་ནས་གཙང་པོ་ལའང་དྲི་ངན་བྲོ་བར་འགྱུར་ལ། ཨེ་ཅིབ་པ་རྣམས་དེའི་ཆུ་འཐུང་བར་ཞེན་པ་ལོག་ཡོང་ཞེས་སྨྲ་དགོས་པར་བཀའ་གནང་ངོ་། །"]},{"type":"verse","number":19,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨ་རོན་ལ་འདི་ལྟར་ཤོད་དང་། ཁྱོད་ཀྱིས་རང་གི་འཁར་བ་ལོངས་ལ་ལག་པ་ཨེ་ཅིབ་ཡུལ་གྱི་ཆུ་རྣམས་ཏེ་གཙང་པོ་དང་། གྲོག་ཆུ་དང་། རྫིང་བུ་དང་། ཆུ་འགག་ཐམས་ཅད་བཅས་ཁྲག་ཏུ་འགྱུར་བའི་ཕྱིར་ཆུ་དེ་རྣམས་ཀྱི་ཕྱོགས་སུ་རྐྱོངས་ཤིག དེ་ནས་ཨེ་ཅིབ་ཡུལ་ཀུན་ཏུ་ཁྲག་ཡོད་པར་འགྱུར་ཞིང་། ཐ་ན་ཤིང་གི་ཡོ་བྱད་དང་། རྡོ་ཡི་ཡོ་བྱད་དུའང་ཁྲག་ཡོད་པར་འགྱུར་ངེས་ཞེས་བཤད་དགོས་པར་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་བསྒྲུབས་པ་སྟེ། ཨ་རོན་གྱིས་ཕཱར་ཨོལ་འཁོར་དང་བཅས་པའི་མདུན་དུ་འཁར་བ་ཡར་བཀྱགས་ནས་ནཱ་ཡོལ་གཙང་པོའི་ཆུ་ལ་བརྡེགས་པ་དང་། གཙང་པོའི་ཆུ་ཡོངས་རྫོགས་ཁྲག་ཏུ་གྱུར་ཅིང་།"]},{"type":"verse","number":21,"content":["ནཱ་ཡོལ་གཙང་པོའི་ཉ་རྣམས་ཤི་བ་དང་། གཙང་པོར་ཡང་དྲི་ངན་བྲོ་བས། ཨེ་ཅིབ་པས་གཙང་པོ་དེའི་ཆུ་འཐུང་མ་ཕོད་ལ། ཨེ་ཅིབ་ཡུལ་ཐམས་ཅད་ལ་ཁྲག་གིས་གང་བའོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་ཨེ་ཅིབ་ཡུལ་གྱི་སྒྱུ་མ་མཁན་རྣམས་ཀྱིས་ཀྱང་རྫུ་འཕྲུལ་ལ་བརྟེན་ནས་དེ་བཞིན་བྱས་པ་དང་། ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་གྱུར་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་བཞིན་དུ་ཁོས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་མ་མཉན་པའི་ཁར།"]},{"type":"verse","number":23,"content":["ཁོ་རང་ཁ་ཕྱིར་འཁོར་ཏེ་ཕོ་བྲང་དུ་ལོག་ཅིང་། དོན་དེར་དོ་སྣང་ཙམ་ཡང་མ་བྱས་པ་དང་།"]},{"type":"verse","number":24,"content":["ཨེ་ཅིབ་པ་ཐམས་ཅད་ཀྱིས་གཙང་པོ་དེའི་ཆུ་འཐུང་མི་ཕོད་པས། འཐུང་ཆུ་འཐོབ་པའི་ཕྱིར་ནཱ་ཡོལ་གཙང་པོའི་འགྲམ་གཉིས་སུ་ས་བརྐོས་ཤིང་།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ནཱ་ཡོལ་གཙང་པོར་བརྡེགས་ནས་ཉིན་བདུན་རྫོགས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/6.json","previousChapterAudioLinks":{},"numberOfVerses":25}