{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EXO","translationId":"bod_ntb","name":"ཨེ་ཅིབ་ནས་ཐོན་པ།","commonName":"ཨེ་ཅིབ་ནས་ཐོན་པ།","title":"༄༅། །ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ།","order":2,"numberOfChapters":40,"sha256":"5a794ef4b5d2e62d04c71116339ea2e9306548c1c29526178b6f1bd60eb7560a","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/bod_ntb/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":9,"content":[{"type":"heading","content":["ཕྱུགས་ཟོག་ལ་གོད་ཁ་བྱུང་བའི་ཆག་སྒོ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཕཱར་ཨོལ་གྱི་མདུན་དུ་སོང་ནས་ཁོ་ལ་འདི་ལྟར་ཤོད་དང་། ཨིབ་རི་པ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ང་ལ་བསྙེན་བཀུར་བྱེད་པའི་ཆེད་དུ་ངའི་མི་རྣམས་འགྲོ་རུ་ཆུག་ཅེས་གསུངས།"]},{"type":"verse","number":2,"content":["གལ་ཏེ་ཁྱོད་ཀྱིས་དེ་དག་ད་དུང་བཀག་ནས་འགྲོ་རུ་མི་འཇུག་ན།"]},{"type":"verse","number":3,"content":["ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་གིས་ཁྱོད་ཀྱི་ཞིང་ལ་ཡོད་པའི་ཕྱུགས་ཟོག་སྟེ། རྟ་དང་། བོང་བུ་དང་། རྔ་མོང་དང་། བ་གླང་གི་ཁྱུ་དང་། ར་ལུག་གི་ཁྱུ་བཅས་ལ་ནད་ཡམས་ཤིན་ཏུ་ལྕི་མོ་ཞིག་འབྱུང་བར་མཛད།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱུགས་ཟོག་ནི་ཨེ་ཅིབ་པ་རྣམས་ཀྱི་ཕྱུགས་ཟོག་ལས་ལོགས་སུ་བཀར་ཏེ། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དབང་བའི་ཕྱུགས་ཟོག་ལས་གཅིག་ཀྱང་འཆི་བར་མི་འགྱུར་བའི་ཕྱིར་ཡིན་ཞེས་སྨྲ་དགོས་པར་གསུངས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་དུས་བཅད་མཛད་དེ་འདི་སྐད་དུ། སང་ཉིན་ཡ་ཝཱེས་ཡུལ་འདིར་དོན་འདི་བསྒྲུབ་ངེས་ཡིན་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":6,"content":["དེའི་ཕྱི་ཉིན་དཀོན་མཆོག་ཡ་ཝཱེས་དོན་དེ་མཛད་ཅིང་། ཨེ་ཅིབ་པའི་ཕྱུགས་ཟོག་ཐམས་ཅད་ཤི་ནའང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱུགས་ཟོག་ལས་གཅིག་ཀྱང་མ་ཤིའོ། །"]},{"type":"verse","number":7,"content":["ཕཱར་ཨོལ་གྱིས་མི་མངགས་ནས་བལྟ་རུ་ཕྱིན་པ་ན། ལྟོས་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱུགས་ཟོག་ལས་གཅིག་ཀྱང་མ་ཤི་བ་མཐོང་མོད། འོན་ཀྱང་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་གྱུར་ཏེ་མི་རྣམས་འགྲོ་རུ་མ་བཅུག་གོ །"]},{"type":"heading","content":["གཉན་འབུར་གྱི་ཆག་སྒོ།"]},{"type":"verse","number":8,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ། སྲེག་ཐབ་ནས་དུ་དྲེག་སྤར་གང་ལོངས་ལ། མོ་ཤེ་ཡིས་ཕཱར་ཨོལ་གྱི་མིག་མདུན་དུ་གནམ་ལ་གཏོར་ཅིག་དང་།"]},{"type":"verse","number":9,"content":["དུ་དྲེག་དེ་ནི་ཨེ་ཅིབ་ཡུལ་ཡོངས་སུ་རྡུལ་དུ་འགྱུར་ཞིང་། མི་ཕྱུགས་གཉིས་ཀྱི་ལུས་སྟེང་དུ་གཉན་འབུར་ཆུ་བུར་ཅན་དུ་འགྱུར་འོང་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":10,"content":["མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱིས་དུ་དྲེག་བླངས་ནས་ཕཱར་ཨོལ་གྱི་མདུན་དུ་འགྲེང་སྟེ། མོ་ཤེ་ཡིས་དེ་གནམ་ལ་གཏོར་བ་ན། མི་ཕྱུགས་གཉིས་ཀྱི་ལུས་སྟེང་དུ་གཉན་འབུར་ཆུ་བུར་ཅན་དུ་གྱུར།"]},{"type":"verse","number":11,"content":["སྒྱུ་མ་མཁན་དེ་དག་དང་ཨེ་ཅིབ་པ་ཐམས་ཅད་ཀྱི་ལུས་སྟེང་དུ་གཉན་འབུར་བྱུང་བས། སྒྱུ་མ་མཁན་དེ་དག་མོ་ཤེའི་མདུན་དུ་ཚུགས་མ་ཐུབ།"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་མཛད་ཅིང་མོ་ཤེ་ལ་གསུངས་པ་བཞིན་དུ་ཕཱར་ཨོལ་གྱིས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་མ་མཉན་ཏོ། །"]},{"type":"heading","content":["སེར་བ་ཆེན་པོའི་ཆག་སྒོ།"]},{"type":"verse","number":13,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་རང་ཐོ་རངས་ཡར་ལངས་ཏེ། ཕཱར་ཨོལ་གྱི་མདུན་དུ་ལངས་བསྡད་ནས་ཁོ་ལ་འདི་ལྟར་ཤོད་ཅིག ཨིབ་རི་པ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་ལ་བསྙེན་བཀུར་བྱེད་པའི་ཆེད་དུ་ངའི་འབངས་མི་འགྲོ་རུ་ཆུག"]},{"type":"verse","number":14,"content":["རྒྱུ་མཚན་ནི་ཐེངས་འདིར་བདག་གིས་ཆག་སྒོ་ཐམས་ཅད་ཁྱོད་དང་ཁྱོད་ཀྱི་འཁོར་གཡོག་རྣམས་དང་། ཁྱོད་ཀྱི་འབངས་མི་རྣམས་ཀྱི་སྟེང་དུ་འབབ་པར་བྱ་སྟེ། བདག་དང་འདྲ་བ་ཞིག་གནམ་འོག་ཀུན་ཏུ་མེད་པ་ཁྱོད་ཀྱིས་ཤེས་པར་འགྱུར་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":15,"content":["ད་ལྟ་བདག་གིས་ལག་པ་བརྐྱངས་ཏེ་ནད་ཡམས་ཀྱིས་ཁྱོད་དང་ཁྱོད་ཀྱི་འབངས་མི་རྣམས་ལ་རྒོལ་བ་ཡིན་ན། ཁྱོད་རང་སྔར་ནས་ས་སྟེང་དུ་མེད་པར་གྱུར་པ་ཡིན།"]},{"type":"verse","number":16,"content":["དོན་དམ་དུ་བདག་གི་ནུས་མཐུ་ཁྱོད་ལ་མངོན་པ་དང་། བདག་གི་མིང་ནི་གནམ་འོག་ཀུན་ཏུ་བསྒྲག་པའི་ཕྱིར་ཁྱོད་རང་དར་བར་བྱས་པ་ཡིན་མོད།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང་ཁྱོད་ཀྱིས་ད་དུང་བདག་གི་འབངས་མི་ལ་རང་རློམ་ཆེན་པོ་བྱས་ནས་ཁོ་ཚོ་འགྲོ་རུ་མི་འཇུག་པ་ཡིན་ནམ།"]},{"type":"verse","number":18,"content":["ལྟོས་དང་། སང་ཉིན་གྱི་དུས་འདི་ཙམ་ལ་བདག་གིས་སེར་བ་ཆེན་པོ་ཞིག་འབབ་པར་བྱ་སྟེ། ཨེ་ཅིབ་ཡུལ་ཆགས་པའི་དུས་ནས་བཟུང་སེར་བ་དེ་འདྲ་བབས་མྱོང་མེད།"]},{"type":"verse","number":19,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་མི་མངགས་ནས་ཁྱོད་ཀྱི་ཕྱུགས་ཟོག་དང་། ཞིང་ལ་གང་ཡོད་པ་ཐམས་ཅད་ནང་ལ་བསྡུས་ཤིག ཞིང་ལ་བསྐྱུར་ཏེ་ནང་དུ་མ་བསྡུས་པ་མི་ཕྱུགས་གང་ཡིན་རུང་སེར་བ་དེའི་སྟེང་ལ་བབས་ནས་འཆི་བར་འགྱུར་ཞེས་སྨྲ་དགོས་པར་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["ཕཱར་ཨོལ་གྱི་འཁོར་གཡོག་རྣམས་ལས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་འདི་ལ་འཇིགས་པ་རྣམས་ཀྱིས་རང་གི་གཡོག་པོ་རྣམས་དང་ཕྱུགས་ཟོག་མྱུར་དུ་ཁང་པའི་ནང་ལ་བསྡུས་མོད།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་འདི་སེམས་ལ་མ་བཟུང་བ་དག་གིས་གཡོག་པོ་རྣམས་དང་ཕྱུགས་ཟོག་ཞིང་ནང་དུ་བསྐྱུར་བ་རེད།"]},{"type":"verse","number":22,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ལག་པ་ནམ་མཁར་རྐྱོངས་དང་། ཨེ་ཅིབ་ཡུལ་ཐམས་ཅད་དེ། མི་དང་ཕྱུགས་ཟོག་དང་ཞིང་ནང་གི་སྐྱེ་དངོས་ཐམས་ཅད་ཀྱི་སྟེང་དུ་སེར་བ་འབབ་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":23,"content":["མོ་ཤེ་ཡིས་རང་གི་འཁར་བ་ནམ་མཁར་བརྐྱངས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་འབྲུག་སྒྲ་གྲགས་པ་དང་སེར་བ་འབབ་པར་མཛད་དེ། ས་ལ་མེའི་གློག་དམར་འཁྱུག་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཡུལ་དུ་སེར་བ་ཕབ་བོ། །"]},{"type":"verse","number":24,"content":["དུས་དེར་སེར་བ་དང་མེའི་གློག་དམར་གཉིས་འདྲེས་ཤིང་ཤིན་ཏུ་དྲག་པོ་ཡིན་ཏེ། ཨེ་ཅིབ་ཡུལ་ཆགས་པའི་དུས་ནས་བཟུང་དེ་ལྟ་བུ་བྱུང་མྱོང་མེད།"]},{"type":"verse","number":25,"content":["ཨེ་ཅིབ་ཡུལ་ཐམས་ཅད་དུ། ཞིང་ལ་ཡོད་པའི་མི་ཕྱུགས་གཉིས་ཀ་དང་སྐྱེ་དངོས་ཡོད་ཚད་སེར་བས་བརྡུངས་པ་དང་། ཞིང་གི་ལྗོན་ཤིང་དང་རྩི་ཤིང་མཐའ་དག་ཀྱང་བཅག་པ་དང་།"]},{"type":"verse","number":26,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་གནས་པའི་གོ་ཤེན་ཡུལ་འབའ་ཞིག་ཏུ་སེར་བ་མ་བབས་སོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་ཕཱར་ཨོལ་གྱིས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་བོས་འོངས་ནས་དེ་གཉིས་ལ་འདི་ལྟར། ད་རེས་ངས་སྡིག་པ་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེ་དྲང་བདེན་ཡིན་ལ། བདག་དང་བདག་གི་འབངས་མི་རྣམས་ནི་ངན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":28,"content":["དཀོན་མཆོག་གི་འབྲུག་སྒྲ་དང་སེར་བས་ད་ནི་ཆོག་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་བ་ཕུལ་ཞིག དེ་ནས་བདག་གིས་ཁྱོད་རྣམས་འགྲོ་རུ་འཇུག་སྟེ་འདི་རུ་འདུག་མི་དགོས་ཞེས་སྨྲས།"]},{"type":"verse","number":29,"content":["ཡང་མོ་ཤེ་ན་རེ། ང་རང་གྲོང་ཁྱེར་གྱི་ཕྱི་རོལ་ཏུ་སོང་མ་ཐག་ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་ལག་ཟུང་བརྐྱངས་ནས་གསོལ་བ་འདེབས་པར་བྱ་སྟེ། འབྲུག་སྒྲ་ཆད་ནས་སེར་བ་ཡང་མེད་པར་འགྱུར་ལ། ས་གཞི་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེའི་ཡིན་པ་ཁྱོད་ཀྱིས་ཤེས་པར་འགྱུར་བའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":30,"content":["འོན་ཀྱང་ཁྱོད་དང་ཁྱོད་ཀྱི་འཁོར་གཡོག་རྣམས་ད་དུང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མི་འཇིགས་པ་ངས་ཤེས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":31,"content":["དུས་དེར་ནས་ཀྱི་སྙེ་མ་འབུས་ཤིང་སོ་མའི་མེ་ཏོག་ཀྱང་བཞད་ཡོད་པས། སེར་བས་སོ་མ་དང་ནས་གཉིས་བརྡུངས་ནའང་།"]},{"type":"verse","number":32,"content":["གྲོ་དང་སོ་བ་ནི་ཕྱིས་སུ་སྨིན་པས་མ་བརྡུངས་སོ། །"]},{"type":"verse","number":33,"content":["དེ་ནས་མོ་ཤེ་ནི་ཕཱར་ཨོལ་དང་བྲལ་ནས་གྲོང་ཁྱེར་གྱི་ཕྱི་རོལ་ཏུ་སོང་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་ལག་ཟུང་བརྐྱངས་ནས་གསོལ་བ་བཏབ་པ་ན། འབྲུག་སྒྲ་དང་སེར་བ་ཆད་ཅིང་། ཆར་བ་ས་ལ་འབབ་མཚམས་ཀྱང་བཞག་པ་རེད།"]},{"type":"verse","number":34,"content":["ཕཱར་ཨོལ་གྱིས་ཆར་བ་དང་སེར་བ་དང་འབྲུག་སྒྲ་བཅས་མཚམས་ཆད་པ་མཐོང་ནས་དེ་ལས་ཀྱང་སྡིག་པ་བྱས་ཏེ། ཁོ་དང་ཁོའི་འཁོར་གཡོག་རྣམས་ཀྱིས་སེམས་གྱོང་པོར་བྱས།"]},{"type":"verse","number":35,"content":["དེ་ལྟར་ཕཱར་ཨོལ་གྱི་སེམས་གྱོང་པོར་གྱུར་ནས། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་དེ་གསུངས་པ་བཞིན་དུ་ཡེས་ར་ཨེལ་པ་རྣམས་འགྲོ་རུ་མ་བཅུག་གོ །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EXO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EXO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EXO/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}