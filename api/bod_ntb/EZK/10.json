{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":10,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་མཆོད་ཁང་དང་ཁ་གྱེས་པའི་སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ངས་བལྟས་པ་ལ། ཀེ་རུབ་ཀྱི་སྟེང་གི་མཁའ་དབྱིངས་སུ། ཨིནྡྲ་ནཱི་ལའི་བཞུགས་ཁྲི་དང་མཚུངས་པའི་གཟུགས་དབྱིབས་མངོན་པར་གྱུར་ཏེ།"]},{"type":"verse","number":2,"content":["གཙོ་བོས་ལུས་ལ་སོ་རས་སྲབ་བུ་གྱོན་པའི་མི་དེ་ལ་འདི་སྐད་དུ། ཁྱོད་ནི་ཀེ་རུབ་ཀྱི་འོག་གི་འཁོར་ལོའི་བར་དུ་སོང་སྟེ། ཀེ་རུབ་ཀྱི་བར་ནས་ལག་པ་གཉིས་ཀས་སོལ་བ་སྤར་གང་ཡར་བླངས་ནས། དེ་གྲོང་ཁྱེར་གྱི་སྟེང་དུ་གཏོར་ཅིག་ཅེས་གསུངས་པ་ན། མི་དེ་ངའི་མདུན་ནས་ནང་དུ་སོང་།"]},{"type":"verse","number":3,"content":["མི་དེ་ནང་དུ་འགྲོ་དུས་ཀེ་རུབ་ནི་མཆོད་ཁང་གི་གཡས་ཕྱོགས་སུ་ལངས་སྡོད་ཅིང་། ནང་གི་ཁྱམས་རར་སྤྲིན་གྱིས་ཁེངས་པའོ། །"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ནི་ཀེ་རུབ་ཀྱི་སྟེང་ནས་ཡར་བཞེངས་ཏེ་མཆོད་ཁང་གི་སྒོ་ཐེམ་དུ་སླེབས་ཤིང་། མཆོད་ཁང་ནང་དུ་སྤྲིན་གྱིས་ཁེངས་པ་དང་། ཁྱམས་ར་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ཀྱི་འོད་ཟེར་གྱིས་ཁྱབ།"]},{"type":"verse","number":5,"content":["ཀེ་རུབ་རྣམས་ཀྱི་གཤོག་སྒྲ་ནི་ཁྱམས་ར་ཕྱི་མར་ཡང་ཐོས་ཤིང་། དེ་ནི་ཀུན་དབང་དཀོན་མཆོག་གི་གསུང་སྐད་དང་འདྲའོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཁོང་གིས་ལུས་ལ་སོ་རས་སྲབ་བུ་གྱོན་པའི་མི་དེར་བཀའ་བསྒོས་ཤིང་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་འཁོར་ལོའི་བར་ཏེ་ཀེ་རུབ་ཀྱི་བར་ནས་མེ་ལོངས་ཤིག་ཅེས་གསུངས་པ་དང་། མི་དེ་ནང་དུ་སོང་ནས་འཁོར་ལོ་ཞིག་གི་མདུན་དུ་ལངས་བསྡད་ཅིང་།"]},{"type":"verse","number":7,"content":["ཀེ་རུབ་རྣམས་ལས་གཅིག་གིས་ཀེ་རུབ་རྣམས་ཀྱི་དཀྱིལ་ལ་ཡོད་པའི་མེའི་ཕྱོགས་སུ་ལག་པ་བརྐྱངས་ནས་མེ་བླངས་ཏེ་སོ་རས་སྲབ་བུ་གྱོན་པའི་མི་དེའི་ལག་ཏུ་བཞག་པས། མི་དེས་མེ་ཁྱེར་ནས་ཕྱི་རུ་སོང་ངོ་། །"]},{"type":"verse","number":8,"content":["ཡང་ཀེ་རུབ་རྣམས་ཀྱི་གཤོག་པའི་འོག་ཏུ་མིའི་ལག་པ་ལྟ་བུའི་དབྱིབས་ཤིག་མཐོང་བྱུང་།"]},{"type":"verse","number":9,"content":["ངས་བལྟས་པ་དང་། ཀེ་རུབ་རྣམས་ཀྱི་ལོགས་སུ་འཁོར་ལོ་བཞི་ཡོད་དེ། ཀེ་རུབ་རེའི་ལོགས་སུ་འཁོར་ལོ་རེ་ཡོད་པ་དང་། འཁོར་ལོ་དེའི་དབྱིབས་ནི་འོད་ཟེར་ལྡན་པའི་བཻཌཱུརྱ་ལྗང་སེར་ལྟ་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["འཁོར་ལོ་བཞི་པོའི་དབྱིབས་དང་གྲུབ་ཚུལ་ནི་རྣམ་པ་གཅིག་ཡིན་ཞིང་། འཁོར་ལོ་རྣམས་གཅིག་ལ་གཅིག་སྦྲེལ་ཡོད་པ་འདྲ།"]},{"type":"verse","number":11,"content":["འཁོར་ལོ་དེ་དག་ཕྱོགས་བཞི་རུ་སྐྱོད་ནུས་ཤིང་། སྐྱོད་པའི་དུས་སུ་ཁ་ལོ་བསྒྱུར་མི་དགོས་ལ། ཀེ་རུབ་ཀྱི་མགོ་ནི་ཕྱོགས་གང་དུ་འཁོར་ན་དེ་རྣམས་རྗེས་སུ་འབྲངས་ནས་སྐྱོད་པ་དང་། སྐྱོད་པའི་དུས་སུ་ཁ་ལོ་བསྒྱུར་མི་དགོས་སོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཀེ་རུབ་ཀྱི་ལུས་ཡོངས་དང་རྒྱབ། ལག་པ། གཤོག་པ། ད་དུང་འཁོར་ལོ་རྣམས་ལ་མིག་གིས་བཀང་ཡོད་དེ། ཀེ་རུབ་བཞི་པོའི་འཁོར་ལོ་ཚང་མ་དེ་བཞིན་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["འཁོར་ལོ་དེ་དག་ལ་མཚོན་ན། དེ་རྣམས་ལ་འཁོར་སྐྱོད་བྱེད་པའི་འཁོར་ལོ་ཞེས་འབོད་པ་ངས་ཐོས་བྱུང་།"]},{"type":"verse","number":14,"content":["ཀེ་རུབ་རེ་ལ་གདོང་བཞི་རེ་ཡོད་དེ། དང་པོ་ནི་ཀེ་རུབ་ཀྱི་གདོང་དང་། གཉིས་པ་མི་ཡི་གདོང་། གསུམ་པ་སེང་གེའི་གདོང་། བཞི་པ་གླག་གི་གདོང་བཅས་ཡིན་ཞིང་།"]},{"type":"verse","number":15,"content":["ཕྱིས་སུ་ཀེ་རུབ་རྣམས་ཀྱང་ཡར་འཕགས་ཤིང་། འདི་དག་ནི་ངས་ཀེ་བར་ཡུར་བའི་འགྲམ་དུ་མཐོང་བའི་སེམས་ཅན་དེ་རྣམས་སོ། །"]},{"type":"verse","number":16,"content":["ཀེ་རུབ་རྣམས་སྐྱོད་དུས་སུ་འཁོར་ལོ་རྣམས་ཀྱང་དེ་ཚོའི་གམ་དུ་སྐྱོད་པ་དང་། ཀེ་རུབ་རྣམས་ཀྱིས་གཤོག་པ་བརྐྱངས་ནས་ས་ངོས་དང་བྲལ་ཏེ་འཕུར་བའི་སྐབས་སུ་འཁོར་ལོ་རྣམས་ཀྱང་དེ་དག་དང་མི་འབྲལ་ལོ། །"]},{"type":"verse","number":17,"content":["དེ་རྣམས་ལངས་ནས་སྡོད་དུས་འཁོར་ལོ་དག་ཀྱང་ལངས་སྡོད་པ་ཡིན། དེ་རྣམས་ཡར་འཕགས་དུས་འཁོར་ལོ་རྣམས་ཀྱང་དེ་རྣམས་དང་མཉམ་དུ་ཡར་འཕགས། གང་ལ་ཞེ་ན། སེམས་ཅན་རྣམས་ཀྱི་ཐུགས་ཉིད་ནི་འཁོར་ལོའི་ནང་དུ་ཡོད་པའོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ནི་མཆོད་ཁང་གི་སྒོ་ཐེམ་ལས་བཞུད་དེ་ཀེ་རུབ་རྣམས་ཀྱི་སྟེང་དུ་བཞུགས་པ་དང་།"]},{"type":"verse","number":19,"content":["ཀེ་རུབ་རྣམས་འབྲལ་དུས་སུ་དེ་དག་གིས་ངའི་མདུན་དུ་གཤོག་པ་བརྐྱངས་ནས་ས་ངོས་ལས་བྲལ་ཏེ་འཕུར་ཞིང་། འཁོར་ལོ་རྣམས་ཀྱང་དེ་དང་མཉམ་དུ་ཡོད་པ་དང་། དེ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཤར་སྒོ་རུ་བསྡད། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་གཟི་བརྗིད་དེ་དག་གི་གོང་དུ་ཡོད་དོ། །"]},{"type":"verse","number":20,"content":["དེ་དག་ནི་ངས་ཀེ་བར་ཡུར་བའི་འགྲམ་དུ་མཐོང་བའི་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་གཟི་བརྗིད་འོག་ཏུ་གནས་པའི་སེམས་ཅན་ཡིན་པས། དེ་དག་ཀེ་རུབ་ཡིན་པ་ངས་རྟོགས་སོང་།"]},{"type":"verse","number":21,"content":["ཀེ་རུབ་བཞི་པོ་དེ་རེ་རེར་གདོང་བཞི་རེ་དང་གཤོག་པ་བཞི་རེ་ཡོད་དེ། གཤོག་པའི་འོག་ཏུ་མིའི་ལག་པ་ལྟ་བུའི་དབྱིབས་ཤིག་ཡོད།"]},{"type":"verse","number":22,"content":["ཁོ་ཚོའི་གདོང་གི་གཟུགས་དབྱིབས་ནི། དེ་སྔར་ངས་ཀེ་བར་ཡུར་བའི་འགྲམ་དུ་མཐོང་བ་དང་མཚུངས་ཤིང་། ཁོ་ཚོ་རེ་རེ་མདུན་དུ་སྐྱོད་ཀྱིན་ཡོད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}