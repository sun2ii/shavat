{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":12,"content":[{"type":"heading","content":["གནས་སྤོ་བའི་སྔ་ལྟས།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ནི་གྱེན་ལོག་གི་མི་རྣམས་ཁྲོད་དུ་བསྡད་ཡོད་པ་དང་། དེ་དག་ལ་ལྟ་བའི་མིག་ཡོད་ཀྱང་མི་མཐོང་ལ། ཉན་པའི་རྣ་ཡོད་ཀྱང་མི་ཐོས་ཏེ། གང་ལ་ཞེ་ན། དེ་དག་ནི་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་ཡིན་པས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་བས། ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་རང་གི་དོན་དུ་བཙོན་ལ་ཁྲིད་སྐབས་མཁོ་བའི་དངོས་པོ་རྣམས་གྲ་སྒྲིག་གྱིས་ཤིག ཉིན་དཀར་དེ་ཚོའི་མདུན་ནས་ཕར་སོང་ཞིག ཡང་རང་ཉིད་འདུག་ས་ནས་གནས་གཞན་དུ་སྤོས་ཤིག དེ་དག་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་ཡིན་ན་ཡང་མིག་གིས་མཐོང་རྗེས་ཁོ་ཚོས་རྟོགས་ཀྱང་སྲིད།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་ཉིན་དཀར་ཁོ་ཚོའི་མདུན་དུ་རང་གི་དངོས་པོ་སྟེ་བཙོན་ལ་ཁྲིད་སྐབས་མཁོ་བའི་དངོས་པོ་དང་འདྲ་བ་རྣམས་སྒོའི་ཕྱི་རུ་བཞག་ནས། མཚན་མོའི་དུས་སུ་ཁྱོད་ནི་བཙོན་དུ་ཁྲིད་པའི་མི་བཞིན་དུ། དེ་དག་གི་མདུན་ནས་ཕྱི་རུ་སོང་ཞིག"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱིས་ཁོ་ཚོའི་མདུན་དུ་གྱང་ལ་ཁུང་བུ་དྲུས་ཏེ་ཁྱོད་ཀྱི་དངོས་པོ་རྣམས་དེ་ནས་ཕྱི་རུ་ཁྱེར་ཞིག"]},{"type":"verse","number":6,"content":["མུན་རུབ་པའི་དུས་སུ་ཁྱོད་ཀྱིས་ཁོ་ཚོའི་མདུན་ནས་དངོས་པོ་དེ་དག་ཕྲག་པར་ཁུར་ཏེ་ཕྱི་རུ་ཁྱེར་ཞིག་དང་། ངས་ཁྱོད་ནི་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་སྔ་ལྟས་སུ་མཛད་པས། ཁྱོད་ཀྱིས་ཡུལ་འདི་མི་མཐོང་བའི་ཕྱིར་རང་གི་གདོང་ཐུམས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ངས་ཁོང་གིས་བཀའ་བསྒོས་པ་བཞིན་བྱས་ཏེ། ཉིན་དཀར་ངའི་དངོས་པོ་སྟེ་བཙོན་དུ་ཁྲིད་སྐབས་མཁོ་བའི་དངོས་པོ་དང་འདྲ་བ་རྣམས་སྒོའི་ཕྱི་རུ་བཞག་པ་དང་། ས་སྲོད་ཀྱི་དུས་སུ་ངས་ལག་པས་གྱང་ལ་ཁུང་བུ་དྲུས་ཤིང་། མཚན་མོ་ངས་ཁོ་ཚོའི་མདུན་དུ་དངོས་པོ་དེ་དག་ཕྲག་པར་ཁུར་ནས་ཕྱི་རུ་ཁྱེར་བའོ། །"]},{"type":"verse","number":8,"content":["ཞོགས་པའི་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":9,"content":["ཀྱེ་མིའི་བུ། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་དེ་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་གྱིས་ཁྱོད་ལ། ཁྱོད་ཀྱིས་ཅི་བྱེད་དམ་ཞེས་འདྲི་བ་མ་ཡིན་ནམ།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལུང་བསྟན་འདི་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་དང་དེའི་ནང་གི་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་དང་འབྲེལ་ལོ་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱིས་འདི་ལྟར། བདག་ནི་ཁྱོད་ཚོའི་སྔ་ལྟས་ཤིག་ཡིན་པས། བདག་གིས་ཅི་ལྟར་སྤྱད་ན་ཁོ་ཚོ་ལའང་དེ་བཞིན་འབྱུང་བར་འགྱུར་ཏེ། ཁོ་རྣམས་བཙོན་དུ་འཁྲིད་པར་འགྱུར་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":12,"content":["ཁོ་ཚོའི་ཁྲོད་ཀྱི་རྒྱལ་པོས་ས་སྲོད་ཀྱི་དུས་སུ་དངོས་པོ་རྣམས་ཕྲག་པར་ཁུར་ནས་འགྲོ་ལ། དེ་ཚོས་གྱང་ལ་ཁུང་བུ་དྲུས་ནས་རྒྱལ་པོ་དེ་ནས་ཕྱི་རུ་འཁྱེར་ཞིང་། ཡང་དེས་རང་གི་གདོང་བཏུམས་ནས་ཡུལ་འདི་མི་མཐོང་ངོ་། །"]},{"type":"verse","number":13,"content":["བདག་གིས་རང་གི་དྲ་དེའི་སྟེང་དུ་གཏོང་བར་བྱ་ཞིང་ངའི་དྲ་བས་དེ་འཛིན་པར་འགྱུར་བ་དང་། ཡང་བདག་གིས་དེ་ཀལ་དི་པའི་ཡུལ་ཏེ་པཱ་པེལ་ལོན་དུ་འཁྲིད་ཅིང་། ཁོས་ཡུལ་དེ་མི་མཐོང་ཡང་དེ་རུ་འཆི་བར་འགྱུར།"]},{"type":"verse","number":14,"content":["བདག་གིས་དེའི་མཐའ་འཁོར་གྱི་མི་རྣམས་ཏེ། ཁོ་ལ་རོགས་བྱེད་མཁན་དག་དང་ཁོའི་དམག་དཔུང་ཐམས་ཅད་ཕྱོགས་བཞི་རུ་གཏོར་ཏེ། རལ་གྲི་ཕྱུང་ནས་དེ་དག་གི་རྗེས་འདེད་པར་བྱའོ། །"]},{"type":"verse","number":15,"content":["བདག་གིས་དེ་རྣམས་ཕྱི་རོལ་པའི་མི་རིགས་སོ་སོའི་ནང་དུ་གཏོར་ཏེ། ཡུལ་ཕྱོགས་སོ་སོར་ཁ་ཐོར་དུ་འགྲོ་རུ་འཇུག་དུས་སུ། དེ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":16,"content":["ཡིན་ནའང་དེ་དག་གིས་རང་རང་སླེབས་སའི་མི་རིགས་ཀུན་གྱི་ནང་དུ། རང་གི་ཞེན་ཁ་ལོག་པའི་དོན་རྣམས་སྨྲ་བའི་ཕྱིར་དུ་ངས་དེ་ལས་མི་གྲངས་ཉུང་ངུ་ཞིག་ལུས་པར་བྱེད་ཅིང་། རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ལས་ཐར་བར་བཅུག་ན། དེ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":17,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡང་བསྐྱར་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":18,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་སྐྲག་སྐྲག་འདར་འདར་ངང་རང་གི་ཁ་ཟས་སྤྱོད་དང་། དངངས་འཚབ་དང་བཅས་རང་གི་ཆུ་ཐུངས་ཤིག"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱིས་ཡུལ་འདིའི་མི་རྣམས་ལ་འདི་ལྟར། ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་དང་ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཁམས་ཀྱི་སྐོར་ལ། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁོ་ཚོས་སེམས་ཁྲལ་དང་བཅས་རང་གི་ཁ་ཟས་སྤྱོད་ཅིང་། འཇིགས་སྐྲག་ངང་རང་གི་ཆུ་བཏུང་བ་ཡིན་ཏེ། གང་ལ་ཞེ་ན། མི་ཀུན་གྱི་བཙན་ཤུགས་ཀྱི་དབང་གིས་ཡུལ་འདི་ནི་ཡོངས་སུ་སྟོང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":20,"content":["མི་འདུག་སའི་གྲོང་ཁྱེར་རྣམས་སྟོང་བར་འགྱུར་ཞིང་། ཡུལ་ཁམས་འདི་ཡང་སྟོང་བར་འགྱུར་བ་དང་། དེ་ནས་ཁྱོད་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གི་ལུང་བསྟན་འགྲུབ་པར་འགྱུར་བ།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":22,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཅག་ལ་ཡེས་ར་ཨེལ་གྱི་ཡུལ་དུ། ཞག་རྣམས་ཉིན་རེ་བཞིན་དུ་འདས། །ཞལ་གཟིགས་ཐམས་ཅད་སྟོང་བར་གྱུར། །ཞེས་པའི་ཁ་དཔེ་ཞིག་ཡོད་པ་དེ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":23,"content":["དེ་བས་ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཁ་དཔེ་འདི་ད་ནི་དར་བར་མི་བྱ་སྟེ། ཕྱིན་ཆད་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་མི་ཡིས་ཁ་དཔེ་འདི་མི་འདྲེན་ཞེས་པའོ། །ཡིན་ནའང་ཁྱོད་ཀྱིས་དེ་རྣམས་ལ། ཉིན་མོ་དེ་ནི་སླེབས་ལ་ཉེ། །ཞལ་གཟིགས་མཐའ་དག་འགྲུབ་པར་འགྱུར་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":24,"content":["དུས་དེ་ནས་བཟུང་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ནང་དུ་ཞལ་གཟིགས་རྫུས་མ་དང་ངོ་བསྟོད་བྱེད་པའི་མོ་བ་འབྱུང་བར་མི་འགྱུར།"]},{"type":"verse","number":25,"content":["གང་ལ་ཞེ་ན། བདག་ནི་ཡ་ཝཱེ་ཡིན་ཏེ་བདག་གིས་བཀའ་གསུང་བར་འགྱུར་ཞིང་གསུངས་པའི་བཀའ་དེ་གང་ཞིག་ཡིན་ཡང་འགྲུབ་ངེས་ཤིང་དུས་འགྱང་མི་བྱའོ། །ཀྱེ་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན། ངས་གསུངས་པའི་བཀའ་རྣམས་ཁྱོད་ཚོ་ད་དུང་གསོན་པའི་དུས་སུ་འགྲུབ་པར་འགྱུར་གསུངས་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡང་བསྐྱར་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":27,"content":["ཀྱེ་མིའི་བུ། ལྟོས་དང་། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ན་རེ། མི་འདིས་མཐོང་བའི་ཞལ་གཟིགས་ནི་དུས་ཡུན་རིང་པོའི་རྗེས་ཀྱི་དོན་དང་འབྲེལ་ཏེ། ཁོས་ལུང་བསྟན་པ་དེ་ནི་རྒྱང་རིང་གི་མ་འོངས་པ་བསྟན་པ་ཡིན་ཞེས་ཟེར་བས་ན།"]},{"type":"verse","number":28,"content":["ཁྱོད་ཀྱིས་དེ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངའི་གསུང་ཐམས་ཅད་ཚིག་གཅིག་ཀྱང་དུས་འགྱང་བར་མི་བྱ་སྟེ། ངས་གསུངས་པ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར་གསུངས་ཞེས་པའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}