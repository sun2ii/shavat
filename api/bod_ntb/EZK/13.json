{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":13,"content":[{"type":"heading","content":["ལུང་སྟོན་པ་རྫུན་མར་བཀའ་བཀྱོན་གནང་བ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ལུང་སྟོན་མཁན་ལུང་སྟོན་པ་དེ་རྣམས་ལ་ཁྱོད་ཀྱིས་ལུང་བསྟན་ནས་རྒོལ་ཞིག་དང་། རང་གི་བསམ་འདུན་བཞིན་དུ་ལུང་སྟོན་མཁན་དེ་དག་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་ཉོན་ཅིག་ཅེས་པའོ་ཞེས་གསུངས།"]},{"type":"verse","number":3,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཞལ་གཟིགས་ཅི་ཡང་མ་མཐོང་བར་རང་གི་སེམས་ཉིད་བཞིན་དུ་ལུང་སྟོན་མཁན་གྱི་ལུང་སྟོན་པ་བླུན་པོ་དེ་དག་ལ་ཆག་སྒོ་འབྱུང་།"]},{"type":"verse","number":4,"content":["ཀྱེ་ཡེས་ར་ཨེལ། ཁྱོད་ཀྱི་ལུང་སྟོན་པ་རྣམས་ནི་ཞིག་རལ་སྟེང་གི་ཝ་མོ་བཞིན་ཡིན་ལ།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོར་དམག་འཐབ་ཁྲོད་དུ་ཚུགས་ཐུབ་པའི་ཕྱིར་དུ། དེ་དག་ཡར་སོང་ནས་ཞིག་རལ་རྣམས་མ་བཅོས་ཏེ། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཀྱི་ཆེད་དུ་མཁར་ཡང་སླར་མ་བརྩིགས།"]},{"type":"verse","number":6,"content":["དེ་དག་གིས་མཐོང་བ་ནི་ཞལ་གཟིགས་རྫུས་མ་དང་། མི་ལ་མགོ་སྐོར་གཏོང་བའི་མོ་ཡིན་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་མ་མངགས་ཀྱང་ཁོ་ཚོ་ན་རེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ཡིན་ཞེས་ཟེར་ཞིང་། དེ་དག་གིས་རང་གིས་ཅི་བཤད་པ་རྣམས་དེ་བཞིན་འགྲུབ་པར་རེའོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་ཚོས་ཞལ་གཟིགས་རྫུས་མ་མཐོང་ཞིང་། མི་ལ་མགོ་སྐོར་གཏོང་བའི་མོ་བཏབ་པ་མ་ཡིན་ནམ། ཁྱོད་ཚོས་ད་དུང་འདི་ནི་ཡ་ཝཱེའི་གསུང་ཡིན་ཟེར་ཡང་། དོན་དམ་དུ་ངས་དེ་ལྟར་མ་སྨྲས་ཞེས་གསུངས།"]},{"type":"verse","number":8,"content":["དེ་བས་ན་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་རྣམས་ཀྱིས་བཤད་པ་ནི་རྫུན་དང་། མཐོང་བ་ནི་འཕྲུལ་སྣང་ཡིན་པས། ལྟོས་དང་། ངས་ཁྱོད་རྣམས་ལ་རྒོལ་བ་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་ཤིང་།"]},{"type":"verse","number":9,"content":["ཞལ་གཟིགས་རྫུས་མ་མཐོང་མཁན་དང་། མོ་བཏབ་ནས་མི་ལ་མགོ་སྐོར་གཏོང་བའི་ལུང་སྟོན་པ་དེ་དག་ལ་ངའི་ལག་པས་རྒོལ་བར་བྱ། དེ་དག་ངའི་མི་ཚོགས་ཀྱི་ནང་དུ་འདུག་མི་རུང་ཞིང་། ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་མིང་ཐོ་རུའང་འགོད་མི་རུང་ལ། ཡེས་ར་ཨེལ་གྱི་ཡུལ་ཁམས་སུའང་འགྲོ་མི་ཆོག་སྟེ། དེ་ནས་ཁྱོད་ཚོས་བདག་ནི་གཙོ་བོ་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["གང་ལ་ཞེ་ན། ཞི་བདེ་མེད་ན་ཡང་དེ་ཚོས་བདག་གི་འབངས་མི་ལ་ཞི་བདེ་ཡོད་ཅེས་བསླུས་ཤིང་། མི་ཡིས་མཁར་གྱང་རྩིག་དུས་སུ་དེ་དག་གིས་རྩིག་པར་དཀར་རྩི་འབྱུག་པ་ཡིན།"]},{"type":"verse","number":11,"content":["དེ་བས་ཁྱོད་ཀྱིས་མཁར་གྱང་ལ་དཀར་རྩི་འབྱུག་མཁན་རྣམས་ལ་འདི་ལྟར། མཁར་གྱང་དེ་ནི་ལོག་པར་མ་ཟད་དྲག་ཆར་གྱིས་བསྣུབ་པར་འགྱུར། ཀྱེ་སེར་བ་ཆེན་པོ་ཁྱོད་ནི་བོབས་དང་། དྲག་རླུང་ཡང་གཡུག་པར་འགྱུར་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":12,"content":["ལྟོས་དང་། མཁར་གྱང་དེ་ལོག་རྗེས་མི་ཡིས་ཁྱོད་རྣམས་ལ། ཁྱོད་རྣམས་ཀྱིས་བྱུགས་པའི་དཀར་རྩི་དེ་གང་དུ་ཡོད་དམ་ཞེས་མི་འདྲིའམ་ཞེས་གསུངས།"]},{"type":"verse","number":13,"content":["དེ་བས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་རང་གི་ཁོང་ཁྲོ་ཆེན་པོས་དྲག་རླུང་གཡུག་པར་བྱ་ཞིང་། ང་ཡི་ཞེ་སྡང་ནང་དུ་དྲག་ཆར་གྱིས་ནུབ་པར་འགྱུར་ལ། ཁོང་ཁྲོ་ཆེན་པོའི་སེར་བ་བབས་ནས་མཁར་གྱང་དེ་མེད་པར་བྱེད་དེ།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཚོས་དཀར་རྩི་བྱུགས་པའི་མཁར་གྱང་དེ་ངས་བཤིགས་ནས་ས་རུ་འགྱེལ་བར་འགྱུར་ཞིང་། ཐ་ན་དེའི་རྨང་ཡང་མངོན་པར་འགྱུར་ལ། མཁར་གྱང་ལོག་ནས་ཁྱོད་རྣམས་ཀྱང་དེའི་ནང་དུ་མེད་པར་འགྱུར་བས། ཁྱོད་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["དེ་ལྟར་ངས་མཁར་གྱང་དང་མཁར་གྱང་ལ་དཀར་རྩི་འབྱུག་པའི་མི་དེ་དག་གི་སྟེང་དུ་རང་གི་ཁོང་ཁྲོ་ཡོངས་སུ་བླུགས་ནས། ངས་དེ་དག་ལ་འདི་སྐད་དུ། མཁར་གྱང་མེད་པར་གྱུར་ཏེ། མཁར་གྱང་ལ་དཀར་རྩི་འབྱུག་མཁན་ཡང་མེད་པར་གྱུར་ཏོ་ཞེས་སྨྲ་ཞིང་།"]},{"type":"verse","number":16,"content":["མཁར་གྱང་ལ་དཀར་རྩི་འབྱུག་མཁན་དེ་ཚོ་ནི་ཡེས་ར་ཨེལ་གྱི་ལུང་སྟོན་པ་རྣམས་ཡིན་ཞིང་། ཁོ་ཚོས་ཡེ་རུ་སཱ་ལེམ་ལ་ལུང་བསྟན་ཏེ། ཞི་བདེ་མེད་པའི་དུས་སུ་གྲོང་ཁྱེར་དེའི་ཆེད་དུ་ཞི་བདེའི་ཞལ་གཟིགས་མཐོང་བར་གྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["བུད་མེད་ལུང་སྟོན་པ་རྫུན་མར་བཀའ་བཀྱོན་གནང་བ།"]},{"type":"verse","number":17,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་མི་རྣམས་ཁྲོད་ཀྱི་རང་གི་བསམ་འདུན་བཞིན་དུ་ལུང་སྟོན་མཁན་བུད་མེད་དེ་དག་གི་ཕྱོགས་སུ་འཁོར་ནས། དེ་དག་ལ་རྒོལ་བའི་ལུང་སྟོན་ཅིག ཁྱོད་ཀྱིས་འདི་ལྟར།"]},{"type":"verse","number":18,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་རྣམས་ཀྱི་སྲོག་ལེན་པའི་ཕྱིར་དུ། མི་རྣམས་ཀྱི་ལག་རྩར་སྔགས་དང་ལྡན་པའི་ཐི་གུ་བཙེམས་པ་དང་། ཡང་མི་རྣམས་ཀྱི་ཆེད་དུ་རིང་ཐུང་མི་འདྲ་བའི་མགོ་རས་བཟོ་བའི་བུད་མེད་རྣམས་ལ་ཆག་སྒོ་འབྱུང་། ཁྱོད་ཚོས་ངའི་མི་རྣམས་ཀྱི་སྲོག་བླངས་ན་རང་སྲོག་སྐྱོབ་ཐུབ་པ་ཡིན་ནམ།"]},{"type":"verse","number":19,"content":["ནས་སྤར་བ་ཁ་ཤས་དང་བག་ལེབ་དུམ་བུ་འགའ་ཡི་ཕྱིར་དུ། ཁྱོད་ཚོས་ངའི་འབངས་མིའི་ནང་དུ་ང་ཁྱད་དུ་བསད་པ་དང་། རྫུན་གཏམ་ལ་མཉན་འདོད་པའི་ངའི་འབངས་མི་རྣམས་ལ་ཁྱོད་ཚོས་རྫུན་གཏམ་ལབ་ཅིང་། འཆི་བར་མི་འོས་པ་རྣམས་ཁྱོད་ཚོས་བསད་དེ། གསོན་མི་འོས་པ་དེ་ཚོའི་སྲོག་ནི་ཁྱོད་ཚོས་བསྐྱབས་པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེ་བས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ཁྱོད་ཚོའི་སྔགས་དང་ལྡན་པའི་ཐི་གུ་དེ་ལ་རྒོལ་བར་བྱ་སྟེ། ཁྱོད་ཚོས་འདབ་ཆགས་བྱ་རྣམས་བཟུང་པ་བཞིན་དུ་ཐི་གུ་དེ་དག་གིས་མིའི་སྲོག་བླངས་པས། ངས་དེ་རྣམས་ཁྱོད་ཚོའི་དཔུང་པ་ནས་དབྲལ་བར་འགྱུར་ལ། ཁྱོད་ཚོས་འདབ་ཆགས་བྱ་ལྟར་བཟུང་པ་དེ་རྣམས་སྒྲོལ་བར་བྱའོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཁྱོད་ཀྱི་མགོ་རས་རྣམས་གཤགས་ཏེ། ངའི་འབངས་མི་ཁྱོད་ཀྱི་ལག་ནས་སྒྲོལ་བར་བྱ་ཞིང་། ཕྱིན་ཆད་ཁོ་ཚོ་ནི་འཛིན་བྱའི་རི་དྭགས་བཞིན་ཁྱོད་ཀྱི་ལག་ཏུ་མི་འཚུད་པ་དང་། དེ་ནས་ཁྱོད་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":22,"content":["གང་ལ་ཞེ་ན། ངས་དྲང་བདེན་ཅན་རྣམས་སེམས་ཕམ་པར་མ་བྱས་ཀྱང་། ཁྱོད་ཚོས་རྫུན་གཏམ་གྱིས་དེ་དག་གི་སེམས་ཕམ་པར་བྱས་པ་དང་། ཡང་མི་ངན་གྱི་ལག་པ་བརྟན་པོར་བྱས་པར་མ་ཟད། དེ་དག་ངན་སྤྱོད་ལས་ལོག་སྟེ་ཐར་པ་འཐོབ་ཏུ་མ་བཅུག་གོ །"]},{"type":"verse","number":23,"content":["དེ་བས། ཁྱོད་ཚོས་ཕྱིན་ཆད་ཞལ་གཟིགས་རྫུས་མ་མཐོང་བར་མི་འགྱུར་ལ། མོ་འདེབས་པའི་དོན་ཡང་སྤྱོད་པར་མི་བྱ་སྟེ། བདག་གིས་རང་གི་འབངས་མི་ཁྱོད་ཀྱི་ལག་ནས་སྒྲོལ་བར་བྱེད་ཅིང་། དེ་ནས་ཁྱོད་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/12.json","previousChapterAudioLinks":{},"numberOfVerses":23}