{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":16,"content":[{"type":"heading","content":["ཕ་མས་དོར་བའི་ཕྲུ་གུའི་དཔེ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་ལ་ཁོ་ཚོའི་ཞེན་ལོག་གི་དོན་རྣམས་སྟོན་དགོས་ཏེ།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱིས་དེ་དག་ལ། གཙོ་བོ་ཡ་ཝཱེས་ཡེ་རུ་སཱ་ལེམ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་འབྱུང་ཁུངས་དང་སྐྱེས་ས་ནི་ཀ་ན་ཨན་གྱི་ཡུལ་ཡིན་ལ། ཁྱོད་ཀྱི་ཕ་ནི་ཨེ་མོར་པ་དང་མ་ནི་ཧེད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["ཁྱོད་སྐྱེས་པའི་གནས་ཚུལ་བརྗོད་ན། ཁྱོད་སྐྱེས་པའི་ཉིན་ལ་མི་ཡིས་ཁྱོད་ཀྱི་ལྟེ་བ་མ་བཅད་ཅིང་། གཙང་དག་བྱེད་དུ་ཁྱོད་ཆུའི་ནང་དུ་ཡང་མ་བཀྲུས་ཏེ། ཁྱོད་ཀྱི་ལུས་སྟེང་དུ་ཚྭ་གཏོར་མཁན་ཡང་མ་བྱུང་ལ། ཁྱོད་རས་ཀྱིས་ཀྱང་མ་བཏུམས་སོ། །"]},{"type":"verse","number":5,"content":["ཁྱོད་ལ་ལྟ་སྐྱོང་བྱས་ཏེ་སྙིང་རྗེ་ནས་དེ་ལྟར་བྱེད་མཁན་མི་གཅིག་ཀྱང་མེད་དེ། མི་ཡིས་ཁྱོད་ནི་ས་སྟོང་དུ་དོར་བ་ཡིན། གང་ལ་ཞེ་ན། ཁྱོད་སྐྱེས་དུས་མི་རྣམས་ཁྱོད་ལ་ཞེན་ཁ་ལོག་པས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ཡང་ང་རང་ཁྱོད་ཀྱི་གམ་ནས་འགྲོ་དུས་སུ། ཁྱོད་ནི་ཁྲག་གི་ནང་དུ་འཕག་འཚག་རྒྱག་པ་མཐོང་བྱུང་། དུས་དེར་ངས་ཁྱོད་ལ་ཁྱོད་ཁྲག་གི་ནང་དུ་ཉལ་ཡོད་ཀྱང་གསོན་པར་གྱིས་ཤིག ཁྱོད་ཁྲག་གི་ནང་དུ་ཉལ་ཡོད་ཀྱང་གསོན་པར་གྱིས་ཤིག་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":7,"content":["ངས་ཁྱོད་ནི་ཞིང་ཁའི་རྩི་ཤིང་བཞིན་དུ་སྐྱེ་བར་བྱས་ཤིང་། དེ་ནས་ཁྱོད་རང་རིམ་གྱིས་ཡར་སྐྱེས་ཏེ་མཛེས་ཤིང་ལྟ་ན་སྡུག་པར་གྱུར་པ་དང་། ཁྱོད་ཀྱི་ནུ་མ་གཉིས་པོ་རྒྱས་ཏེ་སྐྲ་ལོ་རིང་ན་ཡང་། ཁྱོད་ནི་སྔར་བཞིན་གཅེར་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཡང་ང་རང་ཁྱོད་ཀྱི་གམ་ནས་སོང་པ་ན། ཁྱོད་ནི་དགའ་རོགས་སྒྲིག་པའི་དུས་སུ་བབས་ཡོད་པ་མཐོང་སྟེ། ངས་རང་གི་གོས་ཀྱི་ཐུ་བས་ཁྱོད་ཀྱི་ལུས་གཡོགས་ནས། ཁྱོད་ཀྱི་ལུས་གཅེར་བུ་དེ་བཀབ་པ་དང་། ཡང་ཁྱོད་ལ་མནའ་བསྐྱལ་ནས་ཁ་ཆད་བཞག་པས་ཁྱོད་ནི་ང་ལ་གཏོགས་པ་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":9,"content":["དུས་དེར་ངས་ཆུ་ཡིས་ཁྱོད་བཀྲུས་ཤིང་། ཁྱོད་ཀྱི་ལུས་སྟེང་གི་ཁྲག་རྣམས་བཀྲུས་ཏེ་ཁྱོད་ལ་སྣུམ་གྱིས་བྱུགས།"]},{"type":"verse","number":10,"content":["ངས་ཁྱོད་ཀྱི་ལུས་ནི་ཚེམ་དྲུབ་ཀྱི་གོས་ཀྱིས་གཡོགས་ཤིང་། རྐང་པར་ཀོ་བ་སྤུས་ལེགས་ཀྱི་ལྷམ་བསྐོན་པ་དང་། སོ་རས་སྲབ་བུས་ཁྱོད་ཀྱི་མགོ་བཏུམས་ནས་དར་གོས་ཁྱོད་ཀྱི་ལུས་ལ་བསྐོན་ཏོ། །"]},{"type":"verse","number":11,"content":["ངས་ཁྱོད་རང་རྒྱན་ཆས་སྤྲས་ཏེ། ལག་པར་གདུ་བུ་དང་སྐེ་ལ་སྐེ་རྒྱན།"]},{"type":"verse","number":12,"content":["སྣ་ལ་སྣ་ལོང་། རྣ་བར་རྣ་ལོང་། མགོ་ལ་ཡིད་དུ་འོང་བའི་ཅོད་པན་བཅས་བསྐོན་ཏོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་ཁྱོད་ལ་གསེར་དངུལ་གྱིས་བརྒྱན་ཏེ། གོས་སུ་སོ་རས་སྲབ་བུ་དང་། དར་གོས་དང་། ཚེམ་དྲུབ་ཀྱིས་གཡོགས་ཤིང་། ཁྱོད་ཀྱིས་ཟས་སུ་གྲོ་ཞིབ་དང་སྦྲང་རྩི། སྣུམ་བཅས་སྤྱོད་པས། ཁྱོད་ནི་རབ་ཏུ་མཛེས་ཤིང་རྒྱལ་མོའི་ཁྲི་ལའང་བཞུགས་འོས་སོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་རང་ཤིན་ཏུ་མཛེས་པའི་རྐྱེན་གྱིས་ཁྱོད་ཀྱི་མཚན་སྙན་ནི་ཡུལ་ཁམས་ཡོངས་སུ་ཁྱབ་ཅིང་། ཁྱོད་རང་ཡོངས་སུ་མཛེས་པ་ནི་ངས་ཁྱོད་ལ་གནང་བའི་དཔལ་དང་གཟི་བརྗིད་ཀྱི་དབང་གིས་ཡིན་ནོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཞལ་ཆད་དང་འགལ་ནས་ལོག་གཡེམ་བྱས་པ།"]},{"type":"verse","number":15,"content":["ཡིན་ནའང་ཁྱོད་ཀྱིས་རང་གི་བྱད་གཟུགས་དང་རང་གི་མཚན་སྙན་ལ་བརྟེན་ནས་ལོག་གཡེམ་སྤྱད་དེ། ལམ་འགྲོ་རེ་རེ་ལ་ཁྱོད་ཀྱིས་ཅི་དགར་ལོག་གཡེམ་སྤྱད་ཅིང་ཁྱོད་རང་དེ་རྣམས་ལ་དབང་བར་གྱུར།"]},{"type":"verse","number":16,"content":["ཡང་ཁྱོད་ཀྱིས་རང་གི་གོས་རྣམས་ཁྱེར་ཏེ། རང་གི་ཆེད་དུ་ཁ་དོག་རྣམ་པར་བཀྲ་བའི་མཐོ་གླིང་བརྩིགས་ཤིང་གནས་དེར་ལོག་གཡེམ་སྤྱད་དོ། །དོན་དེ་འདྲ་འབྱུང་མི་འོས་ལ་མ་འོངས་པར་ཡང་འབྱུང་མི་སྲིད།"]},{"type":"verse","number":17,"content":["ཡང་ཁྱོད་ཀྱིས་ངས་ཁྱོད་ལ་གནང་བའི་ཡིད་དུ་འོང་བའི་གསེར་ཆས་དང་དངུལ་ཆས་རྣམས་ཁྱེར་ཏེ། རང་གི་ཆེད་དུ་སྐྱེས་པའི་སྐུ་འདྲ་བླུགས་ནས་དེ་དག་དང་ལོག་གཡེམ་སྤྱད་དོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཁྱོད་ཀྱིས་རང་གི་ཚེམ་དྲུབ་ཀྱི་གོས་རྣམས་ཁྱེར་ནས་དེ་དག་གི་སྟེང་དུ་བཀབ་པར་མ་ཟད། ངའི་སྣུམ་དང་བདུག་སྤོས་ཀྱང་དེ་དག་གི་མདུན་དུ་བཤམས།"]},{"type":"verse","number":19,"content":["ངས་ཁྱོད་ལ་གནང་བའི་ཟས་རིགས་ཏེ་གྲོ་ཞིབ་དང་སྣུམ། སྦྲང་རྩི་བཅས་ནི་ཁྱོད་ཀྱིས་སྐུ་འདྲའི་མདུན་དུ་བཤམས་ཏེ་དྲི་ཞིམ་མཆོད་རྫས་སུ་བྱས་སོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":20,"content":["ཡང་ཁྱོད་ལས་བཙས་པའི་ངའི་བུ་དང་བུ་མོ་སྟེ། རང་གི་བུ་དང་བུ་མོ་རྣམས་ཀྱང་ཁྱོད་ཀྱིས་དེ་དག་ལ་ཁ་ཟས་སུ་ཕུལ་བས། ཁྱོད་ཀྱིས་སྤྱད་པའི་ལོག་གཡེམ་འདི་རྣམས་ད་དུང་དོན་ཆུང་བར་བརྩིས་སམ།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱིས་ངའི་བུ་ཕྲུག་རྣམས་བསད་དེ། མེ་བརྒྱུད་ནས་ཁོ་ཚོ་སྐུ་འདྲར་ཕུལ་ཏོ། །"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱིས་རང་གི་ཞེན་ལོག་གི་དོན་དང་ལོག་གཡེམ་འདི་ཐམས་ཅད་སྤྱོད་པའི་དུས་སུ། རང་ཉིད་ལོ་ན་ཆུང་བའི་དུས་སུ་གཅེར་བུར་ཁྲག་གི་ནང་དུ་འཕག་འཚག་བརྒྱབ་པ་མི་དྲན་ནམ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ལ་ཆག་སྒོ་འབྱུང་། ཁྱོད་ལ་ཆག་སྒོ་འབྱུང་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་དེ་སྐད་གསུངས་ཤིང་། ཁྱོད་ཀྱིས་དོན་ངན་དེ་ཐམས་ཅད་སྤྱད་རྗེས།"]},{"type":"verse","number":24,"content":["ཡང་ཁྱོད་ཀྱིས་རང་གི་ཆེད་དུ་གཡེམ་ཁང་བརྩིགས་ཤིང་། ཐང་ཆེན་རེ་རེ་ལ་མཐོ་གླིང་བརྩིགས་པ་དང་།"]},{"type":"verse","number":25,"content":["ཁྱོད་ཀྱིས་ལམ་མདོ་རེ་རེ་ནས་མཐོ་གླིང་བརྩིགས་ཏེ། རང་གི་བྱད་གཟུགས་མཛེས་པོ་དེ་ཞེན་ལོག་ཏུ་བསྒྱུར་ཅིང་ལམ་འགྲོ་རེ་རེ་དང་ལོག་གཡེམ་གྱི་ལས་མང་པོ་སྤྱད།"]},{"type":"verse","number":26,"content":["ཡང་ཁྱོད་ཀྱིས་རང་གི་ཁྱིམ་མཚེས་ཏེ་ཅི་དགར་འདོད་ཆགས་སྤྱོད་པའི་ཨེ་ཅིབ་པ་དང་ལོག་གཡེམ་མང་པོ་སྤྱད་ནས་ང་ཁྲོ་རུ་བཅུག"]},{"type":"verse","number":27,"content":["དེ་བས་ངས་རང་གི་ལག་པ་བརྐྱངས་ཏེ་ཁྱོད་ལ་རྒོལ་ནས་ཁྱོད་ཀྱི་མངའ་ཁོངས་ཆུང་དུ་བཏང་སྟེ། ཁྱོད་རང་ཁྱོད་ལ་སྡང་བའི་ཕེ་ལེ་ཤེད་པའི་བུད་མེད་ཀྱི་ལག་ཏུ་གཏད་ཅིང་། དེ་ཚོས་ཁྱོད་ལ་གང་འདོད་ལྟར་བྱས་པའོ། །ཡང་ཁྱོད་ཀྱི་འདོད་གཡེམ་གྱི་དབང་གིས་དེ་དག་ངོ་ཚ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":28,"content":["འོན་ཀྱང་ཁྱོད་ད་དུང་ཡིད་མ་ཚིམ་པར་ཨ་སུར་པ་དང་ལོག་གཡེམ་སྤྱད་དེ། དེ་དག་དང་ལོག་གཡེམ་སྤྱད་ཀྱང་ཁྱོད་ད་དུང་ཡིད་མ་ཚིམ།"]},{"type":"verse","number":29,"content":["དེ་ནས་ཁྱོད་ཀྱིས་རང་གི་གཡེམ་སྤྱོད་མང་དུ་བཏང་སྟེ། ཚོང་བྱེད་པའི་ཀལ་དི་པའི་བར་དུའང་ལོག་གཡེམ་སྤྱད་ཀྱང་ད་དུང་ཡིད་མ་ཚིམ།"]},{"type":"verse","number":30,"content":["ཁྱོད་ཀྱིས་སྤྱད་པ་དེ་ཐམས་ཅད་ནི་རང་གཤིས་གྱོང་པོ་དང་ངོ་ཚ་མེད་པའི་གཡེམ་མ་དང་འདྲ་བས། ཁྱོད་ནི་ཅི་འདྲའི་སེམས་ཤུགས་ཞན་པ་ཤེས་ཐུབ་བོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":31,"content":["ཁྱོད་ཀྱིས་ལམ་མདོ་རེ་རེ་ནས་རང་གི་གཡེམ་ཁང་བརྩིགས་ཤིང་། ཡང་ཐང་ཆེན་རེ་རེ་ལ་མཐོ་གླིང་བརྩིགས་ནའང་ཁྱོད་ནི་གཡེམ་མ་བཞིན་མིན་ནོ། །གང་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་སྨད་བཙོངས་ནས་ཐོབ་པའི་རྔན་པར་མཐོང་ཆུང་བྱས་པས་སོ། །"]},{"type":"verse","number":32,"content":["རང་གི་ཁྱོ་བོའི་ཚབ་ཏུ་མི་ཆ་མེད་ལེན་པའི་ཆུང་མ་གཡེམ་སྦྱོར་ཅན་ཁྱོད།"]},{"type":"verse","number":33,"content":["མི་རྣམས་ཀྱིས་གཡེམ་མ་ཀུན་ལ་རྔན་པ་སྦྱིན་ཡང་། ཁྱོད་ཀྱིས་རང་གི་རྔན་པ་དེ་རང་ཉིད་དགའ་བའི་དགའ་རོགས་རྣམས་ལ་སྤྲད་ནས། ཁྱོད་དང་མཉམ་དུ་ལོག་གཡེམ་སྤྱོད་པར་དེ་དག་ཕྱོགས་ཀུན་ནས་འོང་བར་བསླུས་སོ། །"]},{"type":"verse","number":34,"content":["ཁྱོད་ཀྱི་གཡེམ་སྤྱོད་ནི་བུད་མེད་གཞན་དང་མི་མཚུངས་ཏེ། གང་ལ་ཞེ་ན། མི་ཡིས་ཁྱོད་ལ་རྔན་པ་སྤྲད་ནས་ཁྱོད་དང་ལོག་གཡེམ་སྤྱོད་པར་མ་ཞུས་ཤིང་། ཁྱོད་ཀྱིས་མི་ལ་རྔན་པ་སྤྲད་པས་ཁྱོད་ནི་དེ་ལས་ལྡོག་པ་ཞིག་གོ །"]},{"type":"verse","number":35,"content":["དེ་བས་སྨད་འཚོང་མ་ཁྱོད་ཀྱིས་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":36,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་རང་གི་འདོད་པ་ཡོད་ཚད་ཕྱི་རུ་མངོན་ནས་རང་གི་དགའ་རོགས་དང་ལོག་གཡེམ་སྤྱད་ནས་ཁོག་སྨད་ཕྱི་རུ་མངོན་པ་དང་། ཡང་ཁྱོད་ཀྱིས་ཞེན་ལོག་གི་སྐུ་འདྲ་ཐམས་ཅད་ལ་ཕྱག་བཙལ་ཏེ། རང་གི་བུ་ཕྲུག་གི་ཁྲག་བཞུར་ཏུ་བཅུག་ནས་ཁྲག་དེ་སྐུ་འདྲ་ལ་ཕུལ་བའི་རྐྱེན་གྱིས།"]},{"type":"verse","number":37,"content":["ལྟོས་དང་། ངས་ཁྱོད་རང་དགའ་བ་དང་སྡང་བའི་མི་རྣམས་ཏེ། ཁྱོད་དང་མཉམ་དུ་དགའ་མགུར་སྤྱད་པའི་དགའ་རོགས་ཚང་མ་བསྡུས་ཏེ། ངས་ཕྱོགས་ཀུན་ནས་དེ་རྣམས་བསྡུས་ཏེ་ཁྱོད་ལ་རྒོལ་བར་འགྱུར་ཞིང་། ངས་དེ་དག་གི་མདུན་དུ་ཁྱོད་ཀྱི་ཁོག་སྨད་ཕྱུང་ནས། ཁྱོད་ཀྱི་ལུས་ཡོངས་གཅེར་བུ་ཡིན་པ་དེ་ཚོར་མཐོང་དུ་འཇུག་གོ །"]},{"type":"verse","number":38,"content":["ལོག་གཡེམ་སྤྱད་པ་དང་མི་ལ་ཁྲག་བཞུར་དུ་བཅུག་པའི་བུད་མེད་བཞིན་དུ་ངས་ཁྱོད་ལ་ཉེས་ཆད་གཅོད་ཅིང་། ངས་རང་གི་ཁོང་ཁྲོ་ཆེན་པོ་དང་ཞེ་སྡང་གིས་མི་ལ་ཁྲག་བཞུར་དུ་བཅུག་པའི་སྡིག་པ་དེ་ཁྱོད་ལ་འཁུར་དུ་འཇུག་གོ །"]},{"type":"verse","number":39,"content":["ངས་ཁྱོད་རང་དེ་ཚོའི་ལག་ཏུ་གཏད་དེ། ཁོ་ཚོས་ཁྱོད་ཀྱི་གཡེམ་ཁང་བཤིག་ཅིང་། ཁྱོད་ཀྱི་མཐོ་གླིང་རྣམས་གཏོར་བ་དང་། ཁྱོད་ཀྱི་ལྭ་བ་རྣམས་བཤུས་ནས་ཁྱོད་ཀྱི་མཛེས་སྡུག་ལྡན་པའི་རིན་པོ་ཆེ་རྣམས་ཕྲོགས་ཏེ། ཁྱོད་ནི་གཅེར་བུར་ལུས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":40,"content":["དེ་དག་གིས་མི་མང་པོ་ཁྲིད་ནས་ཡར་འོངས་ཏེ་ཁྱོད་ལ་རྒོལ་བར་བྱ་ཞིང་། ཁྱོད་ནི་རྡོ་རུབ་བཏང་སྟེ། དེ་དག་གི་རལ་གྲིས་ཁྱོད་དུམ་བུར་གཏུབ་བོ། །"]},{"type":"verse","number":41,"content":["ཡང་དེ་དག་གིས་ཁྱོད་ཀྱི་ཁང་པ་མེར་བསྲེགས་ཏེ། བུད་མེད་མང་པོའི་མདུན་དུ་ཁྱོད་ལ་ཉེས་ཆད་གཅོད་ཅིང་། ངས་ཁྱོད་ཀྱི་གཡེམ་སྤྱོད་མཚམས་བཅད་དེ། ཁྱོད་ཀྱིས་མི་གཡེམ་སྦྱོར་བྱེད་དུ་བསླུ་བའི་རྔན་པ་དེ་སླར་མི་ལ་སྦྱིན་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":42,"content":["དེ་ལྟར་བྱས་ན་ཁྱོད་ཀྱི་སྟེང་དུ་ལངས་པའི་ངའི་ཁོང་ཁྲོ་དེ་ཞི་ཞིང་། ངའི་ཞེ་སྡང་ཡང་ཁྱོད་དང་བྲལ་ནས། ང་རང་ཞི་བར་གནས་ཤིང་སླར་ཡང་ཁྲོ་བར་མི་འགྱུར།"]},{"type":"verse","number":43,"content":["གང་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་རང་གི་ན་ཆུང་གི་དུས་ལ་རྗེས་དྲན་མི་བྱེད་པར། ད་དུང་དོན་དེ་ཐམས་ཅད་ཀྱི་ཁར་ང་རང་ཁྲོ་རུ་བཅུག་པས། ལྟོས་དང་། ཁྱོད་ཀྱིས་སྤྱད་པ་བཞིན་དུ་ངས་ཁྱོད་ལ་ལན་འཇལ་ལོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །ཁྱོད་ཀྱི་ཞེན་ལོག་གི་དོན་རྣམས་ལས་གཞན་ཁྱོད་ཀྱིས་ད་དུང་ལོག་གཡེམ་གྱི་སྐྱུག་བྲོ་བའི་ལས་སྤྱད་པ་མ་ཡིན་ནམ།"]},{"type":"heading","content":["མ་གང་འདྲ་ཡིན་ན་བུ་མོའང་དེ་འདྲ་ཡིན་པ།"]},{"type":"verse","number":44,"content":["ལྟོས་དང་། ཁ་དཔེ་འདྲེན་མཁན་རྣམས་ཀྱིས་ཁ་དཔེ་འདི་དྲངས་ཏེ་ཁྱོད་ལ། མ་གང་འདྲ་ཡིན་ན་བུ་མོའང་དེ་འདྲ་ཡིན་ཞེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":45,"content":["ཁྱོད་ནི་དངོས་གནས་རང་གི་ཁྱོ་ག་དང་བུ་ཕྲུག་རྣམས་འདོར་མཁན་གྱི་མ་ཡི་བུ་མོ་དང་། ཁྱོད་ནི་དངོས་གནས་རང་གི་ཁྱོ་ག་དང་བུ་ཕྲུག་རྣམས་འདོར་མཁན་གྱི་ལྕམ་སྲིང་གི་ཨ་ཅེ་དང་སྲིང་མོ་སྟེ། ཁྱོད་ཚོའི་མ་ནི་ཧེད་པ་དང་ཁྱོད་ཚོའི་ཕ་ནི་ཨེ་མོར་པ་ཡིན།"]},{"type":"verse","number":46,"content":["ཁྱོད་ཀྱི་གཅེན་མོ་ནི་སཱ་མར་ཡ་སྟེ། མོ་དང་མོའི་བུ་མོ་རྣམས་ནི་ཁྱོད་ཀྱི་བྱང་ཕྱོགས་སུ་གནས་ཤིང་། ཁྱོད་ཀྱི་སྲིང་མོ་ནི་སཱ་དོམ་ཡིན་ཏེ། མོ་དང་མོའི་བུ་མོ་རྣམས་ནི་ཁྱོད་ཀྱི་ལྷོ་ཕྱོགས་སུ་གནས་པའོ། །"]},{"type":"verse","number":47,"content":["ཁྱོད་ཀྱིས་དེ་ཚོས་སྤྱོད་པ་བཞིན་དུ་སྤྱད་པ་དང་། དེ་དག་གིས་ཞེན་ལོག་གི་དོན་སྤྱད་པ་བཞིན་དུ་སྤྱད་པར་མ་ཟད། ད་དུང་ཁྱོད་ཀྱིས་དེ་རྣམས་དོན་ཆུང་བར་བརྩིས་ཤིང་། ཁྱོད་ཀྱིས་སྤྱད་པའི་ལས་ཐམས་ཅད་ནི་དེ་ལས་ཀྱང་ཐུ་བ་ཡིན།"]},{"type":"verse","number":48,"content":["བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། ཁྱོད་ཀྱི་སྲིང་མོ་སཱ་དོམ་དང་མོའི་བུ་མོ་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་མོ་རྣམས་ཀྱིས་སྤྱད་པ་བཞིན་དུ་མ་སྤྱད་དོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":49,"content":["དེ་ཡང་ཁྱོད་ཀྱི་སྲིང་མོ་སཱ་དོམ་གྱི་སྡིག་ཉེས་ནི་འདི་ལྟ་སྟེ། མོ་དང་མོའི་བུ་མོ་རྣམས་ནི་ང་རྒྱལ་ཆེ་ཞིང་རང་རློམ་མཐོ་བ་སྟེ། འབྲུ་རིགས་མོད་པོ་ཡོད་ཅིང་འཚོ་བ་སྐྱིད་ནའང་། ཉམ་ཐག་པའི་མི་དང་དབུལ་ཕོངས་རྣམས་ལ་རོགས་རམ་མ་བྱས་སོ། །"]},{"type":"verse","number":50,"content":["དེ་དག་རང་སྣང་མཐོ་ཞིང་ང་རྒྱལ་ཆེ་བ་དང་། ངའི་མདུན་དུ་ཞེན་ལོག་གི་ལས་སྤྱད་པ་ངས་མཐོང་བས་དེ་རྣམས་མེད་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":51,"content":["སཱ་མར་ཡ་ཡིས་ཁྱོད་ཀྱི་སྡིག་པའི་ཕྱེད་ཀ་ཙམ་ཡང་མ་བྱས་ལ། ཁྱོད་ཀྱིས་ཞེན་ལོག་གི་ལས་སྤྱད་པ་ནི་དེ་ལས་ཀྱང་མང་སྟེ། ཐ་ན་ཁྱོད་ཀྱིས་སྤྱད་པའི་ཞེན་ལོག་གི་དོན་རྣམས་དང་བསྡུར་ན་ཁྱོད་ཀྱི་ལྕམ་སྲིང་དག་ནི་དྲང་བདེན་དུ་མངོན་པ་ཡིན།"]},{"type":"verse","number":52,"content":["ཁྱོད་ཀྱིས་རང་གི་ལྕམ་སྲིང་རྣམས་ནི་རང་ཉིད་ལས་དྲང་བདེན་དུ་མངོན་པར་བྱས་ན། ཁྱོད་ཀྱིས་རང་གི་ངོ་ཚ་འཁུར་དགོས་ཏེ། གང་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་སྤྱད་པའི་སྡིག་པ་ནི་དེ་དག་ལས་ཀྱང་སྐྱུག་བྲོ་བ་ཡིན་ཞིང་། དེ་དག་ཁྱོད་དང་བསྡུར་ན་དྲང་བདེན་ཡིན། ཁྱོད་ཀྱིས་རང་གི་ལྕམ་སྲིང་རྣམས་དྲང་བདེན་དུ་མངོན་པར་བྱས་པས། ཁྱོད་ནི་ངོ་ཚ་བར་འགྱུར་ཞིང་རང་གི་ངོ་ཚ་འཁུར་དགོས་སོ། །"]},{"type":"verse","number":53,"content":["ངས་སཱ་དོམ་དང་མོའི་བུ་མོ་རྣམས་དང་། སཱ་མར་ཡ་དང་མོའི་བུ་མོ་རྣམས་ནི་དཀའ་བའི་གནས་ལས་ཕྱིར་ལོག་ཏུ་འཇུག་ཅིང་། ངས་ཁྱོད་རྣམས་ཀྱང་དེ་དག་དང་མཉམ་དུ་ཕྱིར་ལོག་ཏུ་བཅུག་ནས།"]},{"type":"verse","number":54,"content":["ཁྱོད་ལ་རང་གི་ངོ་ཚ་འཁུར་བར་བྱ་ཞིང་། ཁྱོད་ཀྱིས་སྤྱད་པའི་ལས་ཐམས་ཅད་ཀྱི་དབང་གིས་དེ་ཚོར་སེམས་གསོ་འཐོབ་པ་དང་། དེ་ནས་ཁྱོད་ངོ་ཚ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":55,"content":["ཡང་ཁྱོད་ཀྱི་སྲིང་མོ་སཱ་དོམ་དང་མོའི་བུ་མོ་རྣམས་ནི་སྔར་བཞིན་གནས་ཤིང་། སཱ་མར་ཡ་དང་མོའི་བུ་མོ་རྣམས་ཀྱང་སྔར་བཞིན་གནས་པར་འགྱུར་ལ། ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་མོ་རྣམས་ཀྱང་སྔར་བཞིན་གནས་པར་འགྱུར།"]},{"type":"verse","number":56,"content":["ཁྱོད་རང་ང་རྒྱལ་ཆེ་ཞིང་རང་སྣང་མཐོ་བའི་དུས་སུ། ཁྱོད་ཀྱི་སྲིང་མོ་སཱ་དོམ་ནི་ཁྱོད་ཀྱི་ངག་གི་དགོད་གཞི་རུ་གྱུར་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":57,"content":["དུས་དེར་ཁྱོད་ཀྱི་ངན་སྤྱོད་རྣམས་ད་དུང་ཕྱི་རུ་མ་མངོན་ནའང་། ད་ལྟ་ཁྱོད་ནི་ཨ་རམ་གྱི་བུ་མོ་རྣམས་དང་ཕྱོགས་བཞིའི་མི་རྣམས་དང་། ཕེ་ལེ་ཤེད་ཀྱི་བུ་མོ་རྣམས་ཀྱི་འཕྱ་དགོད་བྱེད་ཡུལ་དུ་གྱུར་པ་དང་། ཁྱོད་ཀྱི་མཐའ་འཁོར་གྱི་མི་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་ལ་མཐོང་ཆུང་བྱེད་པའོ། །"]},{"type":"verse","number":58,"content":["ཁྱོད་ཀྱིས་རང་གི་ལོག་གཡེམ་དང་ཞེན་ལོག་གི་ལས་སྤྱད་པའི་མཇུག་འབྲས་རྣམས་འཁུར་དགོས་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":59,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་མནའ་ཚིག་ལ་མཐོང་ཆུང་བྱེད་ཅིང་ཁ་ཆད་འདོར་མཁན་ཁྱོད་ལ། ངས་ཁྱོད་ཀྱིས་གང་ཞིག་སྤྱད་པ་དེ་བཞིན་དུ་ལན་འཇལ་བར་བྱའོ། །"]},{"type":"verse","number":60,"content":["ཡིན་ཡང་ངས་ད་དུང་ཁྱོད་རང་གཞོན་དུས་སུ་ཁྱོད་ལ་བཞག་པའི་ཁ་ཆད་དེ་དྲན་ཞིང་། ཁྱོད་ལ་དུས་གཏན་གྱི་ཁ་ཆད་ཅིག་འཇོག་པར་བྱ།"]},{"type":"verse","number":61,"content":["དེ་ནས་ཁྱོད་ཀྱིས་རང་གི་གཅེན་མོ་དང་སྲིང་མོ་དང་ལེན་བྱེད་དུས་སུ། རང་གིས་སྤྱད་པའི་ལས་རྣམས་དྲན་ཏེ་ངོ་ཚ་བར་འགྱུར་ལ། ངས་དེ་ཚོ་ནི་ཁྱོད་ལ་བུ་མོ་རུ་གནང་ཡང་། འདི་ནི་ངས་ཁྱོད་ལ་བཞག་པའི་ཁ་ཆད་གཞིར་བཟུང་བ་མ་ཡིན་ནོ། །"]},{"type":"verse","number":62,"content":["ངས་ཁྱོད་ལ་བཞག་པའི་ཁ་ཆད་དེ་བརྟན་པོར་བྱེད་ཅིང་། ཁྱོད་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ལ།"]},{"type":"verse","number":63,"content":["ངས་ཁྱོད་ཀྱིས་ཅི་བྱས་ཐམས་ཅད་ལ་གུ་ཡངས་གཏོང་བའི་ཚེ། ཁྱོད་ཀྱིས་ཕྱིར་དྲན་བྱེད་ཅིང་ངོ་ཚ་བར་འགྱུར་ཏེ། ཡང་རང་ཉིད་ལ་ངོ་ཚ་ཐེབས་པའི་རྐྱེན་གྱིས་ད་ནི་ངག་བསྡམ་པར་བྱའོ་གསུངས་ཞེས་སྨྲོས་ཤིག་ཅེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/15.json","previousChapterAudioLinks":{},"numberOfVerses":63}