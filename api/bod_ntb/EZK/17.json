{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":17,"content":[{"type":"heading","content":["གླག་གཉིས་དང་རྒུན་འབྲུམ་ཤིང་གི་དཔེ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་གབ་ཚིག་སྨྲས་ནས་དཔེ་བཞག་སྟེ་འདི་ལྟར་སྨྲོས་ཤིག"]},{"type":"verse","number":3,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། གཤོག་པ་ཆེ་ཞིང་གཤོག་སྒྲོ་རིང་ལ། བྱ་སྒྲོ་མང་ཞིང་ཁ་དོག་རྣམ་པར་བཀྲ་བའི་གླག་ཆེན་པོ་ཞིག་ལེ་པཱ་ནོན་དུ་བབས་ནས་ཐང་ཤིང་གི་རྩེ་མོ་བཏོགས་པ་དང་།"]},{"type":"verse","number":4,"content":["དེས་ལྗོན་ཤིང་གི་རྩེ་མོའི་ལྕུག་མ་གསར་པ་བཅད་ནས་དེ་ཚོང་རྒྱག་ས་དང་ཚོང་པའི་གྲོང་ཁྱེར་དུ་ཁྱེར་ཏེ་བཙུགས།"]},{"type":"verse","number":5,"content":["ཡང་དེས་ས་བོན་ཁྱེར་ཏེ་ལྕང་མ་འཛུགས་པ་བཞིན་དུ་ས་བཅུད་འཛོམས་ས་དང་ཆུ་རྒྱུན་གྱི་འགྲམ་དུ་གཏོར་ནས།"]},{"type":"verse","number":6,"content":["ས་བོན་དེ་ཆེར་སྐྱེས་ནས་གང་སར་མཆེད་པའི་རྒུན་འབྲུམ་ཤིང་ཕྲན་ཞིག་ཏུ་གྱུར་པ་དང་། ཤིང་གི་ཡལ་ག་རྣམས་གླག་གི་ཕྱོགས་སུ་འཁོར་ཞིང་རྩ་བ་དེའི་འོག་ཏུ་ཡོད། དེ་བཞིན་དུ་དེ་ནི་རྒུན་འབྲུམ་ཤིང་ཞིག་ཏུ་གྱུར་ནས། ཡལ་འདབ་རྒྱས་ཤིང་མྱུ་གུ་འབུས་པའོ། །"]},{"type":"verse","number":7,"content":["ཡང་གླག་གཞན་ཞིག་ཡོད་པའང་གཤོག་པ་ཆེ་ཞིང་བྱ་སྒྲོ་མང་ལ། ལྟོས་དང་། རྒུན་འབྲུམ་ཤིང་དེ་ལྗང་བུ་གསོ་ས་ནས་གླག་དེས་ཆུ་འདྲེན་པའི་ཕྱིར་རྩ་བ་གླག་གི་ཕྱོགས་སུ་བརྐྱངས་ཤིང་། གླག་དེའི་ཕྱོགས་སུ་ཡལ་འདབ་རྒྱས་པ་རེད།"]},{"type":"verse","number":8,"content":["དོན་དམ་དུ་རྒུན་འབྲུམ་ཤིང་དེ་ནི་སྔ་མོ་ནས་ས་བཅུད་འཛོམས་ས་དང་ཆུ་རྒྱུན་གྱི་འགྲམ་དུ་བཙུགས་ཡོད་པས། ཡལ་འདབ་རྒྱས་ཤིང་འབྲས་བུ་ཐོགས་ནས་རྒུན་འབྲུམ་ཤིང་ཡིད་དུ་འོང་བ་ཞིག་ཏུ་འགྱུར་ཐུབ་པ་ཡིན་གསུངས་ཞེས་པའོ། །"]},{"type":"verse","number":9,"content":["ཡང་ཁྱོད་ཀྱིས་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། རྒུན་འབྲུམ་ཤིང་འདི་ནི་ཅི་ལྟར་ལོ་འདབ་རྒྱས་སམ། གླག་གིས་དེ་རྩ་བ་ནས་འདོན་ཞིང་འབྲས་བུ་བཏོགས་ཏེ། དེ་དང་དེ་ལས་སྐྱེས་པའི་ལོ་མ་གསར་པ་རྣམས་སྐམ་པར་བྱེད་པ་མ་ཡིན་ནམ། དོན་དམ་དུ་དེ་རྩ་བ་ནས་འདོན་པར་ཤུགས་ཆེན་པོ་དང་མི་མང་པོ་ནི་མི་དགོས་སོ། །"]},{"type":"verse","number":10,"content":["ལྟོས་དང་། རྒུན་འབྲུམ་ཤིང་ནི་བཙུགས་ནའང་དེ་རྒྱས་པར་འགྱུར་རམ། ཤར་རླུང་གཡུགས་ནས་དེར་རྒོལ་དུས་དེ་སྐམ་པར་འགྱུར་བ་མ་ཡིན་ནམ། དེ་ནི་ལྗང་བུ་གསོ་ས་ནས་སྐམ་པར་འགྱུར་རོ་གསུངས་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["དཔེའི་ནང་དོན་བརྗོད་པ།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་དེ་ལ་འདི་ལྟར། ཁྱོད་རྣམས་ཀྱིས་བྱ་བ་འདིའི་དོན་ཅི་ཡིན་པ་མི་ཤེས་སམ་ཞེས་དྲིས་ཤིག་དང་། ཡང་དེ་ཚོར་འདི་ལྟར་སྨྲོས་ཤིག ལྟོས་དང་། སྔར་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ཡེ་རུ་སཱ་ལེམ་དུ་འོངས་ནས། ཡུལ་དེའི་རྒྱལ་པོ་དང་འགོ་དཔོན་རྣམས་བཟུང་ནས་ཁོ་དང་མཉམ་དུ་པཱ་པེལ་ལོན་ལ་བཙོན་དུ་ཁྲིད་དེ།"]},{"type":"verse","number":13,"content":["ཁོས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་རྒྱུད་ལས་མི་གཅིག་བདམས་ཏེ། དེ་དང་ཁ་ཆད་བཞག་ནས་དེར་མནའ་བསྐྱལ་དུ་བཅུག་པ་དང་། ད་དུང་རྒྱལ་ཁབ་ནང་གི་སྟོབས་ཤུགས་ཡོད་པ་རྣམས་བཙོན་དུ་ཁྲིད་ཅིང་།"]},{"type":"verse","number":14,"content":["རྒྱལ་ཁབ་ཉམས་སུ་བཅུག་སྟེ་ཡང་བསྐྱར་དར་རྒྱས་སུ་འགྲོ་མ་ཐུབ་པས། ཁ་ཆད་བརྩི་སྲུང་གཟབ་ནན་བྱས་ན་ད་གཟོད་ཁོ་རྣམས་གནས་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་མི་དེས་དམག་རྟ་དང་དཔུང་ཆེན་འཐོབ་པའི་ཆེད་དུ། ཨེ་ཅིབ་ཡུལ་དུ་ཕོ་ཉ་མངགས་ནས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་ངོ་ལོག་བྱས་པའོ། །མི་དེའི་བསམ་དོན་འགྲུབ་ཐུབ་བམ། དོན་དེ་འདྲ་བྱས་པའི་མི་ནི་ཅི་ལྟར་ཐར་རམ། མི་དེས་ཁ་ཆད་བརྩི་སྲུང་མ་བྱས་པས་ཅི་ལྟར་ཐར་རམ།"]},{"type":"verse","number":16,"content":["བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། དེས་རང་གིས་བསྐྱལ་བའི་མནའ་ལ་མཐོང་ཆུང་བྱས་ཤིང་རྒྱལ་པོ་དང་བཞག་པའི་ཁ་ཆད་དོར་བས། ཁོ་ནི་རྒྱལ་སར་བཀོད་ས་སྟེ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་ཁབ་ཏུ་འཆི་བར་འགྱུར་རོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":17,"content":["དགྲ་ཡིས་གྲོང་ཁྱེར་བསྐོར་བའི་མཁར་མཐོན་པོ་བརྩིགས་ཤིང་། གྲོང་ཁྱེར་ལ་རྒོལ་བའི་ཆེད་དུ་ས་རགས་བརྩིགས་ནས་མི་མང་པོ་ཚར་དུ་གཅོད་དུས། ཕཱར་ཨོལ་གྱིས་དཔུང་ཆེན་དང་དམག་མང་པོ་ཁྲིད་འོངས་ཀྱང་། དེའི་དོན་དུ་གཡུལ་འགྱེད་མི་ཐུབ་བོ། །"]},{"type":"verse","number":18,"content":["དེས་མནའ་ཚིག་ལ་མཐོང་ཆུང་བྱས་ནས་ཁ་ཆད་དོར་བ་དང་། ཁོས་བློ་དཀར་བའི་དམ་བཅའ་བཞག་ཀྱང་དོན་དེ་ཐམས་ཅད་སྤྱད་པས། ཁོ་ནི་ཐར་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":19,"content":["དེ་བས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན་ཏེ། ཁོས་ངའི་མནའ་ཚིག་ལ་མཐོང་ཆུང་བྱས་ཏེ་ངའི་ཁ་ཆད་དོར་བ་ཡིན་ན། ངས་སྡིག་པ་དེ་ཁོའི་སྟེང་དུ་འགེལ་བར་བྱའོ། །"]},{"type":"verse","number":20,"content":["ངས་རང་གི་དྲ་དེའི་སྟེང་དུ་གཏོར་ནས་ཁོ་ངའི་དྲ་ཡི་ནང་དུ་འཚུད་པར་འགྱུར་ཞིང་། ངས་དེ་པཱ་པེལ་ལོན་དུ་ཁྲིད་དེ། ཁོ་རང་ང་ལ་བློ་མི་དཀར་བའི་སྡིག་པའི་ཆེད་དུ། ངས་གནས་དེར་ཁོ་ལ་ཉེས་ཆད་གཅོད་པར་འགྱུར།"]},{"type":"verse","number":21,"content":["དེ་ནས་ཁོའི་དམག་དཔུང་གི་དམག་མི་དཔའ་རྩལ་ཅན་ཚང་མ་རལ་གྲིའི་འོག་ཏུ་འཆི་བར་འགྱུར་ཞིང་། ལྷག་ལུས་རྣམས་ཀྱང་ཕྱོགས་བཞིར་ཁ་ཐོར་དུ་འགྲོ་བ་དང་། དེ་ནས་ཁྱོད་ཚོས་འདི་སྐད་སྨྲ་བ་ནི་ཡ་ཝཱེ་ང་རང་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":22,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཐང་ཤིང་མཐོན་པོའི་རྩེ་མོ་ནས་ཡལ་ག་ཞིག་བླངས་ཏེ་འཛུགས་ཤིང་། ངས་དེའི་རྩེ་མོའི་ལྕུག་མ་གསར་པ་ཞིག་བཅད་ནས་རི་མཐོན་པོའི་ཁར་འཛུགས་པར་བྱ་སྟེ།"]},{"type":"verse","number":23,"content":["ངས་དེ་ཡེས་ར་ཨེལ་གྱི་རི་མཐོན་པོའི་ཁར་བཙུགས་ནས། དེར་ཡལ་ག་སྐྱེས་ནས་ཤིང་ཏོག་ཐོགས་པ་དང་། ཡིད་དུ་འོང་བའི་ཐང་ཤིང་དུ་འགྱུར་ཞིང་། འདབ་ཆགས་སྣ་ཚོགས་དེའི་འོག་ཏུ་སྡོད་པ་སྟེ། དེའི་ཡལ་གའི་བསིལ་གྲིབ་འོག་ཏུ་སྡོད་པར་འགྱུར།"]},{"type":"verse","number":24,"content":["དེ་ནས་ང་ཡ་ཝཱེས་ལྗོན་ཤིང་མཐོན་པོ་རྣམས་དམའ་མོ་དང་དམའ་མོ་རྣམས་མཐོན་པོ། ལྗོན་ཤིང་སྔོ་ལྗང་རྣམས་སྐམ་པོ་དང་སྐམ་པོ་རྣམས་ལོ་འདབ་རྒྱས་པར་བྱེད་པ་ཐང་གི་ལྗོན་ཤིང་ཐམས་ཅད་ཀྱིས་ཤེས་པར་འགྱུར་ལ། ཡ་ཝཱེ་བདག་གིས་ཅི་ལྟར་སྨྲས་པ་ཡིན་ན་དེ་ལྟར་བསྒྲུབ་པར་འགྱུར་རོ་གསུངས་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/16.json","previousChapterAudioLinks":{},"numberOfVerses":24}