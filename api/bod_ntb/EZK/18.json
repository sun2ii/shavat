{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":18,"content":[{"type":"heading","content":["ངན་པ་སྤྱད་ན་འཆི་ངེས་ཡིན།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་ཡུལ་གྱི་སྐོར་གླེང་ན། ཕ་ཡིས་རྒུན་འབྲུམ་སྐྱུར་མོ་ཟོས་པས་བུ་ཡི་སོ་བརྩེ་བའི་ཁ་དཔེ་འདི་ཁྱོད་ཚོས་ཅི་ལ་འདྲེན་ནམ།"]},{"type":"verse","number":3,"content":["བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། ཁྱོད་ཚོས་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ཁ་དཔེ་འདི་སླར་འདྲེན་པར་མི་འགྱུར་རོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ལྟོས་དང་། མི་ཐམས་ཅད་ཀྱི་ཚེ་སྲོག་ནི་ང་ལ་གཏོགས་ཤིང་། ཕ་རྣམས་ཀྱི་ཚེ་སྲོག་ཇི་ལྟར་ང་ལ་གཏོགས་པ་བཞིན་དུ། བུ་རྣམས་ཀྱི་ཚེ་སྲོག་ཀྱང་དེ་ལྟར་ང་ལ་གཏོགས་སོ། །ཡིན་ཡང་སྡིག་སྤྱོད་ཅན་རྣམས་འཆི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":5,"content":["གལ་ཏེ་མི་ཞིག་དྲང་བདེན་ཡིན་ཞིང་། བདེན་པ་དང་དྲང་གཞག་གི་ལས་རྣམས་སྤྱད་པ་ཡིན་ཚེ།"]},{"type":"verse","number":6,"content":["དེས་རི་མགོར་མཆོད་རྫས་མི་ཟ་ཞིང་། མིག་གིས་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་སྐུ་འདྲ་རྣམས་ལ་རེ་ལྟོས་མི་བྱེད་ལ། རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་བཙོག་པར་མི་བྱེད་པ་དང་། ཟླ་མཚན་འབབ་པའི་བུད་མེད་དང་ཉེ་བར་མི་བཅར།"]},{"type":"verse","number":7,"content":["མི་སུ་ལའང་བརྙས་བཅོས་དང་གཉའ་གནོན་མི་བྱེད་ཅིང་། བུན་པའི་གཏའ་མ་ཕྱིར་སྤྲོད་པ་དང་། མི་ཡི་དངོས་ཟོག་ཁོས་མི་འཕྲོག་པའི་ཁར་བཀྲེས་ལྟོགས་ཀྱིས་མནར་བ་རྣམས་ལ་རང་གི་ཁ་ཟས་སྦྱིན་ཞིང་། གཅེར་བུ་རྣམས་ལ་གོས་བསྐོན་པར་བྱའོ། །"]},{"type":"verse","number":8,"content":["མི་ལ་དངོས་པོ་གཡར་ན་ཁོས་བུན་སྐྱེད་མི་ལེན་ཞིང་མང་པོའང་མི་ལེན་པ་དང་། ཁོས་རང་གི་ལག་པ་ནག་ཉེས་དང་རིང་དུ་འབྲལ་བར་བྱས་ནས། མི་དང་མི་ཡི་བར་དུ་དྲང་བདེན་གྱི་ཁྲིམས་ཐག་གཅོད་པ་ཡིན།"]},{"type":"verse","number":9,"content":["དེས་ངའི་སྒྲིག་ཁྲིམས་བརྩི་ཞིང་ངའི་སྒྲིག་སྲོལ་གཟབ་ནན་ངང་བསྲུངས་ནས། དྲང་བདེན་བཞིན་སྤྱོད་དེ། མི་དེ་ནི་དྲང་བདེན་ཞིག་ཡིན་པས་དེ་གསོན་པར་འགྱུར་རོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ཡང་ཁོ་ལ་བུ་ཞིག་སྐྱེས་ཏེ། བུ་དེ་ནི་གཏུམ་དྲག་ཅན་ཡིན་ཞིང་། མི་གཞན་ལ་ཁྲག་བཞུར་དུ་འཇུག་པ་དང་། ཡང་ན་རང་གི་སྤུན་ཟླར་གོང་དུ་སོང་བའི་ངན་སྤྱོད་རྣམས་ལས་གཅིག་སྤྱོད་པ་ཡིན་ན།"]},{"type":"verse","number":11,"content":["ཁོའི་ཕ་ཡིས་དོན་དེ་རྣམས་མ་བྱས་ཀྱང་། ཁོས་རི་མགོར་མཆོད་རྫས་ཟ་ཞིང་རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་བཙོག་པར་བྱེད་པ་དང་།"]},{"type":"verse","number":12,"content":["དཀའ་སྡུག་ཅན་དང་དབུལ་པོར་བརྙས་བཅོས་དང་གཉའ་གནོན་བྱས་ནས་མི་ཡི་དངོས་ཟོག་འཕྲོག་པ་དང་། བུན་པའི་གཏའ་མ་ཕྱིར་མི་སྤྲོད་པར། མིག་གིས་སྐུ་འདྲར་རེ་ལྟོས་བྱས་ནས་ཞེན་ལོག་གི་ལས་སྤྱོད་ཅིང་།"]},{"type":"verse","number":13,"content":["མི་ལ་དངོས་པོ་གཡར་ན་ཁོས་བུན་སྐྱེད་ལེན་ཞིང་མང་པོ་ལེན་པ་ཡིན་ན། མི་དེ་ལྟ་བུ་ནི་གསོན་པར་འགྱུར་རམ་ཞེ་ན། དེ་ནི་གསོན་པར་མི་འགྱུར་ཞིང་། ཁོས་ཞེན་ལོག་གི་ལས་འདི་ཐམས་ཅད་སྤྱད་པས་ཁོ་འཆི་བར་འགྱུར་ལ། ཁོའི་སྡིག་པ་རང་གི་སྟེང་དུ་འབབ་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["དེ་ཡང་ཁོ་ལ་བུ་ཞིག་སྐྱེས་ཏེ། བུ་དེས་རང་གི་ཕ་ཡིས་སྤྱད་པའི་སྡིག་པ་ཐམས་ཅད་མཐོང་བ་དང་། ཁོས་དེ་རྣམས་མཐོང་ན་ཡང་དེ་བཞིན་དུ་མི་སྤྱོད་དེ།"]},{"type":"verse","number":15,"content":["ཁོས་རི་མགོར་མཆོད་རྫས་མི་ཟ་ཞིང་། མིག་གིས་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་སྐུ་འདྲ་རྣམས་ལ་རེ་ལྟོས་མི་བྱེད་ལ། རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་བཙོག་པར་མི་བྱེད་པ་དང་།"]},{"type":"verse","number":16,"content":["མི་སུ་ལའང་བརྙས་བཅོས་དང་གཉའ་གནོན་མི་བྱེད་ཅིང་། གཏའ་མ་གང་ཡང་མི་ལེན་པར། མི་ཡི་དངོས་ཟོག་མི་འཕྲོག་པའི་ཁར་བཀྲེས་ལྟོགས་ཀྱིས་མནར་བ་རྣམས་ལ་རང་གི་ཁ་ཟས་སྦྱིན་ཞིང་། གཅེར་བུ་རྣམས་ལ་གོས་བསྐོན་པ་དང་།"]},{"type":"verse","number":17,"content":["ཁོས་ལག་པ་བརྐྱངས་ནས་དཀའ་སྡུག་ཅན་ལ་བརྙས་བཅོས་དང་གཉའ་གནོན་མི་བྱེད་ཅིང་། མི་ལ་དངོས་པོ་གཡར་ན་ཁོས་བུན་སྐྱེད་མི་ལེན་ལ་མང་པོའང་མི་ལེན་པར། ཁོས་ངའི་སྒྲིག་སྲོལ་བསྲུངས་ནས་ངའི་སྒྲིག་ཁྲིམས་བརྩིས་ན། མི་དེ་ནི་རང་གི་ཕ་ཡི་སྡིག་པའི་རྐྱེན་གྱིས་མི་འཆི་བར་གསོན་པར་ངེས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་དེའི་ཕ་ལ་མཚོན་ན། ཁོས་མི་གཞན་གྱི་དངོས་པོ་བཙན་གྱིས་བླངས་ཏེ་སྤུན་ཟླའི་དངོས་ཟོག་ཕྲོགས་པ་དང་། རང་གི་མི་རྣམས་ཀྱི་ནང་དུ་དོན་ངན་པ་སྤྱད་པས། ལྟོས་དང་། ཁོ་ནི་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཚོས་ད་དུང་བུ་ཡིས་རང་གི་ཕ་ཡི་སྡིག་པ་ཅི་ལ་མི་འཁུར་ཞེས་འདྲིའམ། གལ་ཏེ་བུ་ཡིས་དྲང་བདེན་དང་བདེན་པའི་དོན་རྣམས་སྤྱད་དེ། ངའི་སྒྲིག་ཁྲིམས་རྣམས་བསྲུངས་ནས་དེ་བཞིན་བྱས་ན་དེ་ངེས་པར་དུ་གསོན་པར་འགྱུར་རོ། །"]},{"type":"verse","number":20,"content":["སྡིག་པ་བྱེད་པ་དེ་ཁོ་ན་འཆི་བར་འགྱུར་ཞིང་། བུ་ཡིས་རང་གི་ཕ་ཡི་སྡིག་པ་འཁུར་མི་དགོས་ལ། ཕ་ཡིས་ཀྱང་རང་གི་བུ་ཡི་སྡིག་པ་འཁུར་མི་དགོས་པར། དྲང་བདེན་ཅན་གྱི་དྲང་བདེན་ནི་ཁོ་རང་གི་སྟེང་དུ་འབབ་པར་འགྱུར་ལ། སྡིག་སྤྱོད་ཅན་གྱི་ངན་པ་དེ་ཡང་ཁོ་རང་གི་སྟེང་དུ་འབབ་པར་འགྱུར།"]},{"type":"heading","content":["སྔར་ངན་པ་ཡིན་ཞིང་རྗེས་སུ་བཟང་པོར་གྱུར་ཚེ་གཙོ་བོས་འདས་ཟིན་གྱི་ངན་པར་མི་གཟིགས་པ།"]},{"type":"verse","number":21,"content":["ཇི་སྟེ་སྡིག་སྤྱོད་ཅན་ཞིག་གིས་འགྱོད་བཤགས་བྱས་ཏེ་རང་གིས་སྤྱད་པའི་སྡིག་པ་ཐམས་ཅད་དང་བྲལ་ནས། ངའི་སྒྲིག་ཁྲིམས་ཐམས་ཅད་གཟབ་ནན་ངང་བསྲུངས་པ་དང་། དྲང་བདེན་དང་བདེན་པའི་དོན་རྣམས་སྤྱད་ན་གསོན་ངེས་ཡིན་ལ་འཆི་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":22,"content":["ཡང་དེའི་ནག་ཉེས་བགྲང་བའི་རྒྱུ་མཚན་དུ། དེས་བྱས་པའི་སྡིག་པ་ཐམས་ཅད་ཀྱང་དྲན་པར་མི་བྱ་སྟེ། དེ་ནི་རང་གིས་སྤྱད་པའི་དྲང་བདེན་གྱི་དབང་གིས་གསོན་པར་འགྱུར།"]},{"type":"verse","number":23,"content":["སྡིག་སྤྱོད་ཅན་རང་གི་ལམ་ནང་འཆི་བར་ང་དགའ་བ་ཡིན་ནམ། ཁོ་རྣམས་རང་གིས་སྤྱོད་པའི་ལས་ནས་ཕྱིར་ལོག་སྟེ་གསོན་པར་གྱུར་ན་ང་མི་དགའ་འམ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":24,"content":["ཇི་སྟེ་མི་དྲང་བདེན་ཞིག་གིས་རང་གི་དྲང་བདེན་དང་བྲལ་ནས་ངན་པ་སྤྱད་དེ། སྡིག་སྤྱོད་བཞིན་དུ་ཞེན་ལོག་གི་དོན་རྣམས་བྱས་ན། ཁོ་ནི་གསོན་པར་འགྱུར་རམ། ཁོས་སྤྱད་པའི་དྲང་བདེན་ཐམས་ཅད་དྲན་པར་མི་བྱ་ཞིང་། རང་གི་བློ་མི་དཀར་བའི་དོན་དང་ཁོས་སྤྱད་པའི་ནག་ཉེས་ཀྱི་དབང་གིས་ཁོ་ནི་འཆི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":25,"content":["ཁྱོད་ཚོས་ད་དུང་གཙོ་བོའི་མཛད་པ་དྲང་གཞག་མིན་ནོ་ཟེར། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ཁྱོད་ཚོས་ཉོན་ཅིག ངས་སྤྱད་པ་གང་ཞིག་དྲང་བདེན་མ་ཡིན་ནམ། ཁྱོད་ཚོས་སྤྱད་པ་དྲང་བདེན་མ་ཡིན་པ་མིན་ནམ།"]},{"type":"verse","number":26,"content":["གལ་ཏེ་མི་དྲང་བདེན་ཞིག་གིས་རང་གི་དྲང་བདེན་དང་བྲལ་ཏེ་ངན་པ་སྤྱད་ན། ཁོ་ནི་དེའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར་ཞིང་། ཁོ་ནི་རང་གིས་སྤྱད་པའི་དྲང་བདེན་མ་ཡིན་པ་དེའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར།"]},{"type":"verse","number":27,"content":["ཡང་ཇི་སྟེ་སྡིག་སྤྱོད་ཅན་ཞིག་གིས་འགྱོད་བཤགས་བྱས་ཏེ་རང་གི་གདུག་པ་དང་བྲལ་ནས། དྲང་བདེན་དང་བདེན་པའི་དོན་རྣམས་སྤྱད་ན་དེས་རང་གི་ཚེ་སྲོག་སྐྱོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":28,"content":["གང་ལ་ཞེ་ན། ཁོས་བསམ་བློ་བཏང་རྗེས་རང་གི་སྤྱད་པའི་སྡིག་པ་ཐམས་ཅད་དང་བྲལ་བས། ཁོ་ནི་གསོན་པོར་ལུས་ཤིང་འཆི་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":29,"content":["ཡིན་ཡང་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཀྱིས་ད་དུང་གཙོ་བོའི་མཛད་པ་དྲང་གཞག་མིན་ནོ་ཟེར། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ངས་སྤྱད་པ་གང་ཞིག་དྲང་བདེན་མ་ཡིན་ནམ། ཁྱོད་ཚོས་སྤྱད་པ་དྲང་བདེན་མ་ཡིན་པ་མིན་ནམ།"]},{"type":"verse","number":30,"content":["དེ་བས། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ངས་ཁྱོད་ཚོ་རེ་རེས་སྤྱད་པའི་ལས་བཞིན་དུ་ཁྱོད་རྣམས་ལ་ཁྲིམས་ཐག་གཅོད་པར་བྱའོ། །སྡིག་པ་དེ་རང་གི་བཀག་རྡོ་རུ་མི་འགྱུར་བའི་ཆེད་དུ། ཁྱོད་ཚོས་འགྱོད་བཤགས་བྱོས་ལ་རང་གི་སྡིག་ཉེས་ཐམས་ཅད་དང་འབྲལ་བར་གྱིས་ཤིག་ཅེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":31,"content":["ཁྱོད་ཚོས་རང་གིས་སྤྱད་པའི་སྡིག་པ་ཐམས་ཅད་དོར་ནས། རང་གི་ཆེད་དུ་སེམས་གསར་པ་དང་སེམས་ཉིད་གསར་པ་ཞིག་བསྐྱེད་དགོས། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ཁྱོད་རྣམས་འཆི་དགོས་དོན་ཅི་ཡོད་དམ།"]},{"type":"verse","number":32,"content":["སུ་ཞིག་འཆི་བར་གྱུར་ཡང་ང་མི་དགའ་བས། ཁྱོད་རྣམས་ཀྱིས་འགྱོད་བཤགས་བྱོས་དང་གསོན་པར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/17.json","previousChapterAudioLinks":{},"numberOfVerses":32}