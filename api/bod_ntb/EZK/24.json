{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":24,"content":[{"type":"heading","content":["ཤ་ཡོད་པའི་སླ་ངའི་དཔེ།"]},{"type":"verse","number":1,"content":["ཡང་ལོ་དགུ་པའི་ཟླ་བཅུ་པའི་ཚེས་བཅུ་ཉིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་དེ་རིང་གི་ཟླ་ཚེས་འདི་ཡི་གེར་ཁོད་ཅིག དེ་རིང་གི་ཉིན་མོ་འདི་ནི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་ཡེ་རུ་སཱ་ལེམ་བསྐོར་བའི་ཉིན་མོ་ཡིན།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱིས་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་དེ་ལ་དཔེ་དྲངས་ནས་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། སླ་ང་མེའི་སྟེང་དུ་སྐྱོན་དང་། བསྐྱོན་པའི་རྗེས་སུ་དེའི་ནང་དུ་ཆུ་བླུགས་ཤིག"]},{"type":"verse","number":4,"content":["དེ་ནས་ཤ་རྡོག་རྡོག་སྟེ། ཤ་ཤེད་རྒྱས་པའི་ཤ་རྡོག་རྡོག་དང་རྐང་ལག་རྣམས་སླ་ངའི་ནང་དུ་བཞག་སྟེ། རུས་པ་ལེགས་པོས་སླ་ང་ཁེངས་སུ་ཆུག་དང་།"]},{"type":"verse","number":5,"content":["ལུག་ཁྱུ་ལས་ཤ་ཤེད་རྒྱས་པའི་ལུག་བདམས་ནས། སླ་ངའི་འོག་ཏུ་བུད་ཤིང་བཞག་སྟེ་སླ་ངའི་ཆུ་འཁོལ་དུ་ཆུག་དང་། རུས་པ་སླ་ངའི་ནང་དུ་ཚོས་ཤིག"]},{"type":"verse","number":6,"content":["དེ་བས། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ལ་ཁྲག་བཞུར་དུ་བཅུག་པའི་གྲོང་ཁྱེར་ལ། ཡུན་རིང་དུ་བཙའ་ཆགས་པའི་སླ་ང་བཞིན་དུ་ཆག་སྒོ་འབྱུང་ཞིང་། དེའི་བཙའ་ནི་མེད་པར་བཟོས་མེད་པས། སླ་ངའི་ནང་གི་དངོས་པོ་ནི་གཅིག་རེ་གཅིག་རེ་བྱས་ནས་ལེན་དགོས་པ་ལས། དེ་དག་གི་ཕྱིར་དུ་རྒྱན་ལེན་མི་དགོས་སོ། །"]},{"type":"verse","number":7,"content":["གང་ལ་ཞེ་ན། གྲོང་ཁྱེར་ནང་དུ་ད་དུང་མོས་བཞུར་དུ་བཅུག་པའི་ཁྲག་ཡོད་དེ། མོས་ཁྲག་ནི་ཕ་བོང་འཇམ་པོའི་སྟེང་དུ་གཏོར་བ་ལས། ས་རྡུལ་གྱིས་འགེབ་པར་སའི་ནང་དུ་མ་བླུགས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ལྟར་ངས་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་ནས་ལན་འཇལ་བའི་ཕྱིར་དུ། མོའི་ཁྲག་ནི་ཕ་བོང་འཇམ་པོའི་སྟེང་དུ་བླུགས་ཤིང་ཐ་ན་འགེབ་ཀྱང་མི་ནུས་པར་བྱས།"]},{"type":"verse","number":9,"content":["དེ་བས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ལ་ཁྲག་བཞུར་དུ་བཅུག་པའི་གྲོང་ཁྱེར་དེ་ལ་ཆག་སྒོ་འབྱུང་། ངས་བུད་ཤིང་ཇེ་མང་དུ་གཏོང་བར་བྱ།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་བུད་ཤིང་མང་པོ་སྤུངས་ལ་མེ་སྦར་ནས་བྲོ་སྨན་དང་བཅས་ཤ་ལེགས་པར་ཚོས་དང་། རུས་པ་རྣམས་འཚིག་ཏུ་ཆུག"]},{"type":"verse","number":11,"content":["དེ་ནས་སླ་ང་སྟོང་པ་མེའི་སྟེང་དུ་བཞག་ནས་སླ་ང་ངར་དུ་བཅུག་སྟེ། ཟངས་དམར་པོར་འགྱུར་བར་བྱས་ནས། དེའི་ནང་གི་མི་གཙང་བ་རྣམས་བཞུ་རུ་ཆུག་དང་། དེའི་བཙའ་རྣམས་མེད་པར་བཟོས་ཤིག"]},{"type":"verse","number":12,"content":["སླ་ང་འདིས་མི་ལ་ཡིད་ཆད་དུ་འཇུག་སྟེ། དེའི་སྟེང་གི་བཙའ་མཐུག་པོ་ནི་ལེན་ཐབས་མེད་ལ། མེའི་ནང་དུ་ཡང་དེའི་བཙའ་མེད་པར་བཟོ་མི་ཐུབ་བོ། །"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱི་མི་གཙང་བ་དེ་ནི་འདོད་གཡེམ་ཡིན་ནོ། །ངས་ཁྱོད་གཙང་མར་བཟོ་འདོད་ཀྱང་ཁྱོད་གཙང་མར་འགྱུར་མི་འདོད་པས། ང་ཁྱོད་ཀྱི་སྟེང་དུ་ཁོང་ཁྲོ་རབ་ཏུ་འབར་ནས་མཚམས་འཇོག་པའི་བར་དུ། ཁྱོད་ཀྱི་བཙོག་པ་དེ་གཙང་མར་འགྱུར་མི་ནུས་སོ། །"]},{"type":"verse","number":14,"content":["ང་ཡ་ཝཱེས་གསུངས་པ་དང་དུས་སུ་སླེབས་ན་ངས་དེ་འགྲུབ་པར་བྱའོ། །ངས་ཕྱིར་འཐེན་མི་བྱེད་ལ་སྙིང་རྗེ་ཡང་མི་བསྐྱེད། བསམ་ཚུལ་ཡང་མི་བསྒྱུར་བར། ཁྱོད་ཀྱི་སྤྱོད་ལམ་བཞིན་དུ་ཁྱོད་ལ་ཁྲིམས་གཅོད་པར་འགྱུར་གསུངས་ཞེས་པའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཆུང་མ་ཤི་ན་མྱ་ངན་མི་བྱེད་པའི་དཔེ།"]},{"type":"verse","number":15,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":16,"content":["ཀྱེ་མིའི་བུ། ལྟོས་དང་། ངས་གློ་བུར་ཉིད་དུ་ཁྱོད་ལ་རྒོལ་ཞིང་། ཁྱོད་རང་ཅི་ལ་བལྟ་བར་དགའ་བ་དེ་འཕྲོག་པར་བྱ་སྟེ། ཁྱོད་ནི་ཡིད་སྐྱོ་མི་རུང་། ངུ་ཡང་མི་རུང་། མཆི་མ་ཡང་མི་འདོན་པར།"]},{"type":"verse","number":17,"content":["ཁུ་སིམ་པོར་དབུགས་རིང་ཐོངས་ཤིག གཤིན་པོའི་དོན་དུ་མྱ་ངན་མི་བྱེད་པར། ཁྱོད་ཀྱི་མགོ་ལ་ད་དུང་མགོ་རས་དཀྲིས་དང་། རྐང་པར་ད་དུང་ལྷམ་གྱོན་པ་ལས། ཁྱོད་ཀྱིས་རང་གི་གདོང་ནི་འགེབ་མི་རུང་ལ། མྱ་ངན་ཞུ་བཞིན་པའི་ཁྱིམ་ཚང་ལ་གྲ་སྒྲིག་བྱས་པའི་སྡུག་ཟས་ཀྱང་མི་ཟའོ་ཞེས་གསུངས།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཞོགས་པ་ངས་མི་ཚོགས་ལ་དོན་འདི་སྨྲས་པ་དང་། མཚན་མོར་ངའི་ཆུང་མ་ཚེ་ལས་འདས། ཕྱི་ཉིན་ཞོགས་པ་ངས་རང་ལ་བཀའ་ཇི་ལྟར་བསྩལ་པ་བཞིན་དུ་སྤྱད་ཅིང་།"]},{"type":"verse","number":19,"content":["མི་ཚོགས་ཀྱིས་ང་ལ། ཁྱེད་ཀྱིས་བྱས་པ་དེ་ནི་ངེད་རྣམས་དང་འབྲེལ་བ་ཅི་ཡོད་པ་འཆད་པར་མི་བྱའམ་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":20,"content":["ངས་དེ་ཚོའི་ལན་དུ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་རང་གི་གནས་དམ་པ་ནི་བཙོག་པར་བྱེད་ངེས་ཡིན། དམ་པའི་གནས་འདི་ནི་ཁྱོད་ཚོས་ངོམ་པའི་སྟོབས་ཤུགས་དང་། མིག་ནང་དུ་ཅི་ལ་དགའ་བ་དང་། སེམས་ནས་གཅེས་སུ་འཛིན་པ་དེའོ། །ཁྱོད་ཚོའི་ཤུལ་དུ་ལུས་པའི་བུ་དང་བུ་མོ་རྣམས་ནི་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":22,"content":["དུས་དེར་ཁྱོད་ཚོས་ངས་ཅི་བྱས་པ་བཞིན་དུ་སྤྱོད་པ་ལས་ཁྱོད་ཚོས་རང་གི་གདོང་འགེབ་མི་རུང་ལ། མྱ་ངན་ཞུ་བཞིན་པའི་ཁྱིམ་ཚང་ལ་གྲ་སྒྲིག་བྱས་པའི་སྡུག་ཟས་ཀྱང་ཟ་མི་རུང་ངོ་། །"]},{"type":"verse","number":23,"content":["ཁྱོད་ཚོའི་མགོ་ལ་སྔར་བཞིན་མགོ་རས་དཀྲིས་ཤིག རྐང་པར་ད་དུང་ལྷམ་གྱོན་ཞིག ཁྱོད་རྣམས་ཡིད་སྐྱོ་མི་རུང་། ངུ་ཡང་མི་རུང་། ཡིན་ཡང་ཁྱོད་ཚོས་རང་གི་སྡིག་པའི་དབང་གིས་གཅིག་གིས་གཅིག་ལ་བལྟ་ཞིང་དབུགས་རིང་ཕྱུང་ནས་ཉམ་ཐག་པར་འགྱུར།"]},{"type":"verse","number":24,"content":["འདིའི་ལུགས་སུ་ཨེ་ཟེ་ཀི་ཨེལ་ནི་ཁྱོད་ཅག་གི་སྔ་ལྟས་ཤིག་ཡིན་པས། དེས་སྤྱད་པའི་ལས་ཐམས་ཅད་ནི་མ་འོངས་པར་ཁྱོད་ཚོས་ཀྱང་སྤྱོད་དེ། དོན་དེ་འབྱུང་དུས་སུ། ཁྱོད་ཚོས་བདག་ནི་གཙོ་བོ་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་པའོ། །"]},{"type":"verse","number":25,"content":["ཀྱེ་མིའི་བུ། ངས་དེ་དག་གི་ཁྲོད་ནས་ཁོ་ཚོའི་བཙན་རྫོང་དང་། དེ་དག་དགའ་བའི་གཟི་བརྗིད་དང་། དེ་དག་གི་མིག་ནང་དུ་ཅི་ལ་དགའ་བ་དང་། སེམས་ནས་བརྩི་མཐོང་བྱེད་པ་དང་ཁོ་ཚོའི་བུ་དང་བུ་མོ་རྣམས་འཕྲོག་པའི་དུས་སུ།"]},{"type":"verse","number":26,"content":["དེ་ལས་ཐར་བའི་མི་ཞིག་ཁྱོད་ཀྱི་དྲུང་དུ་འོངས་ཏེ་ཁྱོད་ལ་དོན་དེ་ཐོས་སུ་འཇུག་པ་ཡིན།"]},{"type":"verse","number":27,"content":["དུས་དེར། ཁྱོད་ཀྱིས་ཁ་གྲགས་ནས་ཐར་བའི་མི་དེ་ལ་གཏམ་སྨྲ་བ་ལས་ལྐུགས་པ་མ་བྱེད་ཅིག ཁྱོད་ནི་དེ་ཚོའི་སྔ་ལྟས་ཤིག་ཏུ་འགྱུར་བ་དང་། དེ་ནས་ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/23.json","previousChapterAudioLinks":{},"numberOfVerses":27}