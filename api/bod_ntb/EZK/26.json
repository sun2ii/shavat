{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":26,"content":[{"type":"heading","content":["ཐཱར་ལ་ལན་འཇལ་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ལོ་བཅུ་གཅིག་པའི་ཟླ་ག་གེ་མོའི་ཚེས་གཅིག་གི་ཉིན། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཐཱར་གྱིས་ཡེ་རུ་སཱ་ལེམ་ལ་འཕྱ་དགོད་བྱས་ནས་ན་རེ། མི་རིགས་ཀུན་གྱི་སྒོ་དེ་ཆག་ནས་ངའི་ཕྱོགས་སུ་ཕྱེས་པ་དང་། དེ་ནི་སྟོངས་ཤིང་ང་ནི་བཀང་བར་འགྱུར་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":3,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཐཱར། ལྟོས་དང་། ངས་ཁྱོད་ནི་དགྲ་རུ་འཛིན་ཞིང་། རྒྱ་མཚོས་རྦ་རླབས་ཡར་འཕྱུར་དུ་འཇུག་པ་ནང་བཞིན། ངས་ཡུལ་ཁམས་ཀུན་ཡར་འོངས་ནས་ཁྱོད་ལ་རྒོལ་བར་བྱ་སྟེ།"]},{"type":"verse","number":4,"content":["དེ་དག་གིས་ཐཱར་གྱི་ལྕགས་རི་རྣམས་བརླགས་ཏེ་ལྕོག་མཁར་རྣམས་བཤིག་ཅིང་། ངས་དེའི་ས་རྡུལ་རྣམས་གཙང་མར་བྲད་ནས་དེ་ནི་བྲག་རྡོ་འཇམ་པོ་རུ་འགྱུར་བར་བྱའོ། །"]},{"type":"verse","number":5,"content":["དེ་ནི་རྒྱ་མཚོའི་དབུས་སུ་ཉ་རྒྱ་འདིང་བའི་གནས་སུ་འགྱུར་ཏེ། གང་ལ་ཞེ་ན། གཙོ་བོ་ཡ་ཝཱེ་བདག་གིས་འདི་ལྟར་གསུངས་པ་ཡིན། དེ་ནི་མི་ཀུན་གྱི་བཅོམ་ནོར་དུ་འགྱུར་བ་དང་།"]},{"type":"verse","number":6,"content":["སྐམ་སར་སྡོད་པའི་ཐཱར་པ་རྣམས་ནི་རལ་གྲིས་གསོད་པར་འགྱུར་ལ། དེ་ནས་ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":7,"content":["གང་ལ་ཞེ་ན། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་རྒྱལ་པོ་རྣམས་ཀྱི་རྒྱལ་པོ་ཡིན་པའི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ལ། རྟ་དང་ཤིང་རྟ། རྟ་དམག་བཅས་དམག་དཔུང་ཆེན་པོ་ཞིག་ཁྲིད་དེ་བྱང་ནས་ཐཱར་ལ་རྒོལ་དུ་འོང་བར་བྱ་ཞིང་།"]},{"type":"verse","number":8,"content":["དེས་ཁྱོད་ཀྱི་སྐམ་སར་སྡོད་པའི་མི་རྣམས་གསོད་ཅིང་། གྲོང་ཁྱེར་བསྐོར་བའི་མཁར་རྣམས་བརྩིག་པ་དང་། འགོག་སྲུང་བྱེད་པའི་ས་རགས་བརྩིགས་ནས་ཕུབ་རྣམས་བཟུང་སྟེ་ཁྱོད་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":9,"content":["དེས་གྲོང་ཁྱེར་ལ་རྒོལ་བའི་ཐོ་བ་ཆེན་པོས་ཁྱོད་ཀྱི་ལྕགས་རི་རྣམས་ལ་རྒོལ་ཞིང་། མཚོན་ཆས་ཁྱོད་ཀྱི་ལྕོག་མཁར་རྣམས་བཤིག་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["དེ་ལ་རྟ་ཤིན་ཏུ་མང་པོ་ཡོད་པས་ན། དེ་དག་གིས་ས་རྡུལ་ལངས་སུ་བཅུག་ནས་ཁྱོད་ནི་འགེབ་པར་འགྱུར་ཞིང་། མི་ནི་གྲོང་ཁྱེར་ཞིག་རལ་ཅན་གྱི་ནང་དུ་འཛུལ་བ་བཞིན་དུ། དེ་ནི་ཁྱོད་ཀྱི་མཁར་སྒོའི་ནང་དུ་འཛུལ་བར་འགྱུར་ལ། དུས་དེར། ཁྱོད་ཀྱི་ལྕགས་རི་རྣམས་ནི་རྟ་དམག་དང་ཤིང་རྟའི་འཁོར་ལོ་དང་། ཤིང་རྟའི་སྒྲ་ཡི་རྐྱེན་གྱིས་འདར་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["དེའི་རྟ་ཡི་རྨིག་པས་ཁྱོད་ཀྱི་སྲང་ལམ་ཐམས་ཅད་བརྫི་བར་འགྱུར་ཞིང་། དེས་རལ་གྲི་ཡིས་ཁྱོད་ཀྱི་མི་རྣམས་གསོད་པ་དང་། ཁྱོད་ཀྱི་ཀ་བ་བརྟན་པོ་རྣམས་ཀྱང་ས་ལ་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་ཁྱོད་ཀྱི་རྒྱུ་ནོར་ཕྲོགས་ནས་ཁྱོད་ཀྱི་ཚོང་ཟོག་ནི་བཅོམ་ནོར་དུ་འགྱུར་ཞིང་། ཁྱོད་ཀྱི་ལྕགས་རི་རྣམས་བརླགས་ནས་ཁྱོད་ཀྱི་མཛེས་པའི་གཟིམས་ཁང་རྣམས་བཤིག་སྟེ། ཁྱོད་ཀྱི་རྡོ་དང་ཤིང་དང་། ས་རྡུལ་བཅས་ནི་མཚོ་ནང་དུ་འདོར་བར་བྱའོ། །"]},{"type":"verse","number":13,"content":["ཡང་ངས་ཁྱོད་ཀྱི་གླུ་སྐད་མཚམས་གཅོད་ཅིང་། མི་ཡིས་ཁྱོད་ཀྱི་པི་ཝང་གི་སྒྲ་ཡང་བསྐྱར་ཐོས་པར་མི་འགྱུར་ཏེ།"]},{"type":"verse","number":14,"content":["ངས་ཁྱོད་བྲག་རྡོ་འཇམ་པོ་ཞིག་ཏུ་འགྱུར་བར་བྱ་སྟེ། ཁྱོད་ནི་ཉ་རྒྱ་འདིང་བའི་གནས་སུ་འགྱུར་ལ། ཁྱོད་ནི་སླར་བརྩིག་པར་མི་འགྱུར་རོ། །གང་ལ་ཞེ་ན། ང་ཡ་ཝཱེས་སྨྲས་པ་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་ཐཱར་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་ནང་དུ་སྲོག་གཅོད་པའི་དོན་བྱུང་བ་སྟེ། རྨས་མ་རྣམས་ངུ་བའི་དུས་སུ། གླིང་ཕྲན་རྣམས་ནི་ཁྱོད་རང་འགྱེལ་བའི་སྒྲ་ཡིས་འདར་བར་མི་འགྱུར་རམ།"]},{"type":"verse","number":16,"content":["དུས་དེར་མཚོ་འགྲམ་དུ་ཡོད་པའི་རྒྱལ་པོ་ཐམས་ཅད་རྒྱལ་ཁྲི་ལས་མར་འབབ་ཅིང་། གཟབ་གོས་དང་ཚེམ་དྲུབ་ལྡན་པའི་གོས་ཕུད་དེ། འཇིགས་སྐྲག་གིས་ཁེངས་ནས་སར་སྡོད་ཅིང་། མཚམས་མེད་པར་འདར་ཞིང་ཁྱོད་ཀྱི་དབང་གིས་འཇིགས་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["དེ་ཚོས་ཁྱོད་ལ་སྐྱོ་གླུ་ལེན་ཞིང་ན་རེ། མིང་དུ་གྲགས་པའི་གྲོང་ཁྱེར་ཁྱོད་རང་ནི། །གྲུ་དཔོན་རྣམས་ཀྱི་སྡོད་སའི་གནས་ཡིན་ཞིང་། །རྒྱ་མཚོའི་སྟེང་དུ་བརྟན་ཞིང་སྟོབས་ལྡན་ཁྱོད། །ཁྱོད་དང་ཁྱོད་ཀྱི་མི་ཡིས་སྔར་ནས་བཟུང་། །གནས་དེར་སྡོད་པའི་མི་ལ་དངངས་སྐྲག་ཕབ། །ད་ལྟ་ཁྱོད་ནི་ཅི་ལྟར་ཤུལ་ཆད་དམ། །"]},{"type":"verse","number":18,"content":["ད་ནི་ཁྱོད་རང་འགྱེལ་བའི་དུས་འདི་ལ། །གླིང་ཕྲན་རྣམས་ཀྱི་མི་ཀུན་འདར་བ་དང་། །གླིང་ཕྲན་དག་ནི་ཁྱོད་རང་བརླགས་པས་འཇིགས། །ཞེས་པའོ། །"]},{"type":"verse","number":19,"content":["གང་ལ་ཞེ་ན། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཁྱོད་ནི་མི་མེད་པའི་གྲོང་ཁྱེར་བཞིན་དུ་སྟོངས་སུ་འཇུག་ཅིང་། ཡང་ངས་གཏིང་གི་ཆུ་རྣམས་ཡར་འཕྱུར་དུ་བཅུག་ནས་ཁྱོད་ལས་བརྒལ་ཏེ། ཆུ་ཆེན་གྱིས་ཁྱོད་བསྣུབ་པར་བྱའོ། །"]},{"type":"verse","number":20,"content":["དུས་དེར། ངས་ཁྱོད་ནི་དུར་དུ་སྦས་པའི་མི་དང་བཅས་གནའ་མི་རྣམས་ཀྱི་རྩར་འབབ་ཏུ་འཇུག་ཅིང་། ངས་ཁྱོད་ནི་ཡུན་རིང་པོར་སྟོངས་པར་གྱུར་པའི་ས་ཡི་འོག་སྟེ། དུར་དུ་སྦས་པའི་མི་དེ་དག་དང་མཉམ་དུ་སྡོད་པར་འཇུག་ཅིང་། ཁྱོད་ནི་གསོན་པོའི་གནས་སུ་མངོན་པར་མི་འགྱུར། ཡིན་ནའང་ངས་གསོན་པོའི་གནས་ལ་མཛེས་སྡུག་བསྣན་པར་བྱའོ། །"]},{"type":"verse","number":21,"content":["ཡང་ངས་ཁྱོད་ལ་འཇིགས་སུ་རུང་བའི་ཆག་སྒོ་འབྱུང་དུ་བཅུག་སྟེ། ཁྱོད་ནི་ཡང་བསྐྱར་གནས་པར་མི་འགྱུར་ལ། མི་ཡིས་ཁྱོད་བཙལ་ནའང་ནམ་ཡང་བཙལ་ནས་མི་རྙེད་དོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}