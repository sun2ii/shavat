{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["ཐཱར་གྱི་རྒྱལ་པོའི་སྐོར་གྱི་ལུང་བསྟན།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཐཱར་གྱི་རྒྱལ་པོ་ལ་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱི་སེམས་སུ་ང་རྒྱལ་སྐྱེས་ནས་ན་རེ། ང་ནི་ལྷ་ཡིན་ཏེ། ང་ནི་རྒྱ་མཚོའི་དབུས་སུ་ལྷ་ཡི་བཞུགས་ཁྲིར་བཞུགས་ཡོད་དོ་ཞེས་སྨྲ་ཞིང་། དོན་དམ་དུ་ཁྱོད་ནི་མི་ཞིག་ཡིན་པ་ལས་ལྷ་ནི་མ་ཡིན། ཡིན་ནའང་ཁྱོད་ཀྱི་སེམས་སུ་རང་ཉིད་ནི་ལྷ་ཡིན་པར་འདོད་དོ། །"]},{"type":"verse","number":3,"content":["ལྟོས་དང་། ཁྱོད་ནི་དཱ་ནེ་ཨེལ་ལས་ཀྱང་ལྷག་པར་མཁས་པས། ཁྱོད་ལ་སྦ་ཐུབ་པའི་གསང་བ་གང་ཡང་མེད།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་རང་གི་ཤེས་རབ་དང་བློ་གྲོས་ལ་བརྟེན་ནས། རང་གི་ཆེད་དུ་རྒྱུ་འབྱོར་བ་རྙེད་པ་དང་། རྙེད་པའི་གསེར་དང་དངུལ་རྣམས་རང་གི་བང་མཛོད་དུ་བཞག་གོ །"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱིས་རང་གི་ཚོང་ལས་ཐད་ཀྱི་བློ་གྲོས་ཆེན་པོར་བརྟེན་ནས་རང་གི་རྒྱུ་ནོར་འཕེལ་བར་བྱས་ཤིང་། ཡང་རང་གི་རྒྱུ་འབྱོར་བའི་དབང་གིས་སེམས་སུ་ང་རྒྱལ་སྐྱེས་པས།"]},{"type":"verse","number":6,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱི་སེམས་སུ་རང་ཉིད་ལྷ་ཡིན་པར་འདོད་པས།"]},{"type":"verse","number":7,"content":["ལྟོས་དང་། ངས་ཕྱི་ཕྱོགས་པ་སྟེ། ཡུལ་ཁམས་ཀུན་ནས་ཆེས་གདུག་རྩུབ་ཅན་དེ་ཁྱོད་ལ་རྒོལ་དུ་འོང་བར་བྱ་ཞིང་། དེ་དག་གིས་རལ་གྲི་བཏོན་ནས་ཁྱོད་ཀྱི་བློ་གྲོས་ལ་བརྟེན་ནས་ཐོབ་པའི་དངོས་པོ་ཡིད་དུ་འོང་བ་དག་ལ་རྒོལ་བར་འགྱུར་ཞིང་། ཁྱོད་ཀྱི་གཟི་བརྗིད་དེ་བཙོག་པར་བཟོའོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་གིས་ཁྱོད་ས་དོང་དུ་གཡུགས་ཏེ། ཁྱོད་བསད་ནས་རྒྱ་མཚོའི་དབུས་སུ་འཆི་བར་འགྱུར།"]},{"type":"verse","number":9,"content":["ཁྱོད་རང་གསོད་མཁན་གྱི་མདུན་དུ་ཁྱོད་ཀྱིས་ད་དུང་ང་ནི་ལྷ་ཡིན་ཞེས་སྨྲ་ནུས་སམ། ཁྱོད་ལ་གྲིས་སྣུན་མཁན་གྱི་ལག་ཏུ་ཁྱོད་ནི་མི་ཡིན་པ་ལས་ལྷ་མ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["ཁྱོད་ནི་མཚན་སྐྱི་མ་བཅད་པའི་མི་བཞིན་དུ་ཕྱི་ཕྱོགས་པའི་ལག་ཏུ་འཆི་བར་འགྱུར་ཏེ། གང་ལ་ཞེ་ན། འདི་ནི་ངས་སྔོན་ཆད་ནས་སྨྲས་པ་ཡིན་གསུངས་ཞེས་པའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡང་བསྐྱར་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":12,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཐཱར་གྱི་རྒྱལ་པོའི་ཆེད་དུ་སྐྱོ་གླུ་ཞིག་རྩོམས་ཤིག་དང་། དེ་ལ་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ནི་ཆ་ཡོངས་སུ་རྫོགས་པའི་མིག་དཔེ་ཡིན་ཞིང་། ཀུན་ནས་ཤེས་རབ་ལྡན་པ་དང་། ཁྱོན་ནས་ཡིད་དུ་འོང་བ་ཡིན།"]},{"type":"verse","number":13,"content":["སྔར་ཁྱོད་རང་དཀོན་མཆོག་གི་ཨེ་དེན་ལྡུམ་རར་ཡོད་དུས། པད་མ་རཱ་ག་དང་སྤྲིན་རྡོ། རྡོ་རྗེ་ཕ་ལམ། བཻཌཱུརྱ་ལྗང་སེར། གཟི། གཡང་ཊི་སྔོན་པོ། ཨིནྡྲ་ནཱི་ལ། གཡུ། མ་རྒད་བཅས་རིན་པོ་ཆེ་སྣ་ཚོགས་ནི་ཁྱོད་ཀྱི་གྱོན་གོས་ཡིན་ལ། རིན་པོ་ཆེ་དེ་དག་ནི་གསེར་གྱི་འབུར་ཀོང་ལ་བཏབ་པ་དང་། དེ་ཐམས་ཅད་ནི་ཁྱོད་རང་བཀོད་པའི་ཉིན་མོར་གྲ་སྒྲིག་ཚགས་སུ་ཆུད་པའོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ནི་བཞུགས་ཁྲི་སྲུང་མཁན་དང་སྣུམ་གྱིས་བྱུགས་པའི་ཀེ་རུབ་ཡིན་ཞིང་། དཀོན་མཆོག་གི་རི་དམ་པར་ངས་ཁྱོད་བསྐོས་པས། ཁྱོད་ནི་འོད་ཟེར་མེ་བཞིན་འཕྲོ་བའི་རིན་པོ་ཆེའི་དབུས་སུ་སྐྱོད་པ་དང་།"]},{"type":"verse","number":15,"content":["ཁྱོད་རང་བཀོད་པའི་ཉིན་མོ་ནས་བཟུང་ཁྱོད་ཀྱི་ནང་དུ་སྡིག་པ་མ་བྱུང་བར་དུ། ཁྱོད་ཀྱི་སྤྱོད་པ་ཐམས་ཅད་ལ་སྐྱོན་བརྗོད་རྒྱུ་ཅི་ཡང་མེད་དེ།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱི་ཚོང་དར་ཞིང་རྒྱས་པའི་རྐྱེན་གྱིས་ཁྱོད་ཀྱི་ནང་དུ་དོན་གདུག་རྩུབ་ཅན་གྱིས་བཀང་སྟེ། ཁྱོད་ཀྱིས་ཀྱང་སྡིག་པ་བྱས་པས། ངས་ཀྱང་ཁྱོད་ནི་མི་གཙང་བའི་རྫས་སུ་བརྩིས་ནས་དཀོན་མཆོག་གི་རི་བོ་ནས་དོར་བ་ཡིན། ཀྱེ་བཞུགས་ཁྲི་སྲུང་མཁན་གྱི་ཀེ་རུབ་ལགས། ངས་ཁྱོད་ནི་འོད་ཟེར་མེ་བཞིན་འཕྲོ་བའི་རིན་པོ་ཆེའི་དབུས་ནས་མེད་པར་བྱའོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ནི་རང་ཉིད་བྱད་གཟུགས་ལེགས་པས་ང་རྒྱལ་སྐྱེས་ཤིང་། ཡང་ཁྱོད་ཀྱི་མཛེས་སྡུག་གིས་ཁྱོད་ཀྱི་ཤེས་རབ་བརླགས་པས་ངས་ཁྱོད་ནི་ས་གཞི་རུ་དོར་ནས། རྒྱལ་པོ་རྣམས་ཀྱིས་མཐོང་བའི་ཆེད་དུ་དེ་དག་གི་མདུན་དུ་བཞག་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ལ་སྡིག་ཉེས་མང་ཞིང་། ཚོང་དོན་ཕྱོགས་ཀྱི་སྡིག་པས་ཁྱོད་ཀྱི་གནས་དམ་པ་བཙོག་པར་བཟོས་པས། ངས་ཁྱོད་ཀྱི་དཀྱིལ་ནས་མེ་ཞིག་བཏོན་ཏེ། མེ་དེས་ཁྱོད་བསྲེག་པར་འགྱུར་ལ། ཁྱོད་ལ་ལྟད་མོ་ལྟ་མཁན་ཚང་མའི་མདུན་དུ་ངས་ཁྱོད་ས་སྟེང་གི་ཐལ་བ་རུ་བསྒྱུར་བར་བྱ།"]},{"type":"verse","number":19,"content":["མི་རིགས་སོ་སོ་ལས་ཁྱོད་ངོ་ཤེས་མཁན་རྣམས་ཁྱོད་ཀྱི་དབང་གིས་འཇིགས་ཤིང་སྐྲག་པ་དང་། ཁྱོད་ལ་འཇིགས་སུ་རུང་བའི་གནོད་འཚེ་ཐེབས་པར་འགྱུར་ལ། དེ་ནས་ཁྱོད་ནི་ནམ་ཡང་གནས་པར་མི་འགྱུར་གསུངས་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཚི་ཏུན་ལ་ལན་འཇལ་བ།"]},{"type":"verse","number":20,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":21,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཚི་ཏུན་གྱི་ཕྱོགས་སུ་འཁོར་ནས་དེ་ལ་རྒོལ་བའི་ལུང་སྟོན་ཅིག"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱིས་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཚི་ཏུན། ལྟོས་དང་། ངས་ཁྱོད་ནི་དགྲ་རུ་འཛིན་ཞིང་། ཁྱོད་ཀྱི་ནང་ནས་ང་ལ་གཟི་བརྗིད་འཐོབ་པར་འགྱུར་ལ། ངས་དེའི་སྟེང་དུ་ཉེས་ཆད་གཅོད་ཅིང་། ང་རང་དམ་པ་ཡིན་པ་མངོན་པའི་ཚེ་མི་ཡིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":23,"content":["ངས་ཚི་ཏུན་གྱི་ནང་དུ་རིམས་ནད་གཏོང་སྟེ། དེའི་ལམ་སྲང་རྣམས་སུ་ཁྲག་བཞུར་བར་བྱའོ། །རལ་གྲིས་ཕྱོགས་ཀུན་ནས་དེ་ལ་རྒོལ་ཞིང་། གསོད་གཅོད་ཐེབས་པའི་མི་རྣམས་གྲོང་ཁྱེར་ནང་དུ་འགྱེལ་བར་བྱས་ན་མི་ཡིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་ཕྱོགས་བཞིའི་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་སྡང་བའི་མི་ཐམས་ཅད་ནི། ཁོ་ཚོའི་ཕྱོགས་སུ་མི་ལ་འཛེར་བའི་ཚེར་མ་དང་། མི་སྡུག་ལ་སྦྱོར་བའི་གཟེ་མ་ར་མགོ་མི་བྱའོ། །དེ་ནས་མི་ཡིས་བདག་ནི་གཙོ་བོ་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་ཡང་བསྐྱར་དར་བ།"]},{"type":"verse","number":25,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ནི་མི་རིགས་སོ་སོའི་ནང་སྟེ། དེ་རྣམས་གང་ས་གང་དུ་ཁ་ཐོར་དུ་སོང་བ་ལས་བསྡུ་བའི་ཚེ་ན། ངས་དེ་དག་གི་སྟེང་དུ་མི་ཀུན་གྱི་མིག་མདུན་དུ་རང་ཉིད་དམ་པ་རུ་མངོན་པར་འགྱུར་ལ། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ནི་རང་གི་ཡུལ་ཏེ། ངས་རང་གི་བྲན་པོ་ཡ་ཀོབ་ལ་གནང་བའི་ཡུལ་དུ་གནས་པར་འགྱུར།"]},{"type":"verse","number":26,"content":["ངས་དེ་དག་ལ་སྡང་བའི་ཕྱོགས་བཞིའི་མི་ཀུན་ལ་ཉེས་ཆད་བཅད་རྗེས་དེ་དག་བདེ་བར་གནས་ཤིང་། ཁྱིམ་གཞི་དང་རྒུན་འབྲུམ་ར་བ་བཙུགས་ནས། དེ་དག་བདེ་བར་གནས་པ་དང་། དེ་ནས་ཁོ་རྣམས་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་སྟེ་ཁོ་ཚོའི་དཀོན་མཆོག་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}