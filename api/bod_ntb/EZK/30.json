{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["ཨེ་ཅིབ་དང་དེའི་མནའ་འབྲེལ་རྒྱལ་ཁམས་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ལུང་སྟོན་ལ་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོས་ངུ་འབོད་གྱིས་ཤིག ཉིན་མོ་དེ་ནི་སྐྱོ་བ་ལ།"]},{"type":"verse","number":3,"content":["གང་ལ་ཞེ་ན། ཉིན་དེ་ནི་སླེབས་ལ་ཉེ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་སླེབས་ལ་ཉེ། དེ་ནི་སྤྲིན་ནག་འཐིབས་པའི་ཉིན་དང་རྒྱལ་ཁམས་ཀུན་ལ་ཉེས་ཆད་གཅོད་པའི་དུས་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["ཉིན་དེར་ཨེ་ཅིབ་ཀྱི་སྟེང་དུ་རལ་གྲི་འབབ་ཅིང་། སྲོག་ཤོར་བའི་མི་རྣམས་ཨེ་ཅིབ་ཡུལ་དུ་འགྱེལ་བའི་ཚེ་ན། གུ་ཤ་རུ་སྡུག་བསྔལ་འབྱུང་ཞིང་། ཨེ་ཅིབ་ཀྱི་རྒྱུ་ནོར་རྣམས་འཕྲོག་པར་འགྱུར་ལ། དེའི་རྨང་གཞི་བཤིག་པར་འགྱུར།"]},{"type":"verse","number":5,"content":["གུ་ཤ་པ་དང་ཕུ༌ཏཱ་པ་དང་། ལུ༌ཏི་པ་དང་། ཕྱི་ཕྱོགས་པའི་མི་ཐམས་ཅད་དང་། ཁུབ་པ་དང་། ཨེ་ཅིབ་དང་ཁ་ཆད་བཞག་པའི་མི་ཐམས་ཅད་ཨེ་ཅིབ་པ་དང་མཉམ་དུ་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":6,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཨེ་ཅིབ་ལ་རྒྱབ་སྐྱོར་བྱེད་མཁན་རྣམས་འགྱེལ་བར་འགྱུར་ལ། ཨེ་ཅིབ་ཀྱིས་ངོམ་བཟོ་སྟོན་པའི་སྟོབས་ཤུགས་ཉམས་ཤིང་། མིག་དོལ་ནས་སེ་ནེའི་བར་དུ་དེ་དག་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":7,"content":["ཨེ་ཅིབ་ནི་ས་སྟོང་ནང་གི་ས་སྟོང་དུ་འགྱུར་ཞིང་། དེའི་གྲོང་ཁྱེར་རྣམས་ནི་ཉེ་འཁོར་གྱི་གྲོང་ཁྱེར་ཞིག་རལ་ཅན་ནང་གི་ཞིག་རལ་དུ་འགྱུར།"]},{"type":"verse","number":8,"content":["ངས་ཨེ་ཅིབ་ཡུལ་དུ་མེ་སྦར་བའི་དུས་སུ། ཨེ་ཅིབ་ལ་རོགས་བྱེད་མཁན་ཐམས་ཅད་མེད་པར་འགྱུར་ཞིང་། དུས་དེར་ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":9,"content":["ཉིན་དེ་ལ། ཕོ་ཉ་རྣམས་ངའི་མདུན་ནས་གྲུ་ལ་བསྡད་དེ་འགྲོ་ཞིང་། བློ་བདེ་བག་ཕེབས་ངང་སྡོད་པའི་གུ་ཤ་པ་རྣམས་སྐྲག་ཏུ་འཇུག་པ་དང་། ཨེ་ཅིབ་ལ་གནོད་འཚེ་ཐེབས་པའི་ཉིན་ལ་ཁོ་ཚོར་སྡུག་བསྔལ་འབྱུང་བ་ཡིན། ལྟོས་དང་། དོན་དེ་སླེབས་ཟིན།"]},{"type":"verse","number":10,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་ལག་པ་བརྒྱུད་དེ་ཨེ་ཅིབ་ཀྱི་རྒྱུ་ནོར་རྣམས་མེད་པར་བྱེད་ཅིང་།"]},{"type":"verse","number":11,"content":["དེ་དང་དེའི་རྗེས་འབྲང་པ་སྟེ། རྒྱལ་ཁམས་ཀུན་ལས་ཆེས་ཧམ་ཤེད་ཅན་ཡིན་པ་རྣམས་ཡུལ་འདི་མེད་པར་བྱེད་དུ་འདྲེན་ཞིང་། དེ་ཚོས་རལ་གྲི་བཏོན་ནས་ཨེ་ཅིབ་ཡུལ་ལ་རྒོལ་བར་འགྱུར་ལ། གང་སར་སྲོག་བཅད་པའི་བེམ་པོ་ཡིས་ཁེངས་པར་འགྱུར།"]},{"type":"verse","number":12,"content":["ཡང་ངས་གཙང་པོ་རྣམས་སྐམ་དུ་བཅུག་སྟེ། ཡུལ་འདི་ངན་པར་བཙོང་ཞིང་། ངས་ཕྱི་ཕྱོགས་པའི་ལག་པ་བརྒྱུད་དེ་ཡུལ་འདི་དང་འདིའི་ནང་དུ་ཡོད་པ་ཐམས་ཅད་སྟོངས་སུ་འཇུག་གོ་ཞེས་ང་ཡ་ཝཱེས་སྨྲས་པའོ། །"]},{"type":"verse","number":13,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་སྐུ་འདྲ་རྣམས་མེད་པར་བྱེད་ཅིང་། སྙིང་པོ་མེད་པའི་ལྷ་སྐུ་རྣམས་ནོབ་ནས་མེད་པར་བྱ་སྟེ། ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིན་ཆད་རྒྱལ་པོ་གཅིག་ཀྱང་མི་འབྱུང་ལ། ངས་ཨེ་ཅིབ་ཡུལ་ལ་འཇིགས་སྐྲག་འོང་བར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ངས་ཕཱད་རུའུ་སི་སྟོངས་སུ་འཇུག་ཅིང་། ཚོ་ཨན་དུ་མེ་སྦར་ནས་ནོ་ཡུལ་ལ་ཉེས་ཆད་གཅོད་དོ། །"]},{"type":"verse","number":15,"content":["ཡང་ཨེ་ཅིབ་ཀྱི་བཙན་རྫོང་ཡིན་པའི་སིན་གྱི་སྟེང་དུ་ངས་རང་གི་ཁོང་ཁྲོ་ཆེན་པོ་དེ་ལྡུག་པར་མ་ཟད། ནོ་ཡུལ་གྱི་མི་རྣམས་ཚར་དུ་གཅོད་དགོས།"]},{"type":"verse","number":16,"content":["ངས་ཨེ་ཅིབ་ཡུལ་དུ་མེ་སྦར་ཞིང་། སིན་ལ་སྡུག་བསྔལ་ཆེན་པོ་འབྱུང་བར་འགྱུར་ལ། ནོ་ཡུལ་གཞན་གྱིས་གཏོར་ནས་ནོབ་ནི་ཉིན་གང་པོར་སྡུག་བསྔལ་གྱིས་མནར་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["ཨོ་ནཱ་དང་ཕི་བེ་སེད་གཉིས་ཀྱི་གཞོན་ནུ་རྣམས་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་ཞིང་། གྲོང་ཁྱེར་འདི་དག་གི་བུད་མེད་རྣམས་བཙོན་དུ་འཁྲིད་པར་འགྱུར།"]},{"type":"verse","number":18,"content":["ངས་ཐ་ཕན་ཧེ་སི་རུ་ཨེ་ཅིབ་ཡུལ་གྱི་གཉའ་ཤིང་རྣམས་གཅོག་པའི་དུས་སུ། ཉིན་དཀར་ནི་མུན་པ་རུ་འགྱུར་ཞིང་། ཨེ་ཅིབ་ཀྱིས་ངོམ་བཟོ་སྟོན་པའི་སྟོབས་ཤུགས་ནི་དེའི་ནང་དུ་ཉམས་པ་དང་། གྲོང་ཁྱེར་འདི་ལ་སྤྲིན་ནག་འཐིབས་ནས་གྲོང་ཁྱེར་ནང་གི་མི་རྣམས་བཙོན་དུ་འཁྲིད་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["ངས་དེ་ལྟར་ཨེ་ཅིབ་ལ་ཉེས་ཆད་གཅོད་ཅིང་། ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཕཱར་ཨོལ་གྱི་དཔུང་པ་གཅོག་པ།"]},{"type":"verse","number":20,"content":["དེ་ཡང་ལོ་བཅུ་གཅིག་པའི་ཟླ་དང་པོའི་ཚེས་བདུན་ཉིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":21,"content":["ཀྱེ་མིའི་བུ། ངས་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་དཔུང་པ་བཅག་པ་ཡིན། ལྟོས་དང་། དེར་རལ་གྲི་འཛིན་པའི་སྟོབས་ཡོད་པའི་ཆེད་དུ། ཁོ་ལ་སྨན་བཅོས་བྱེད་མཁན་མེད་དེ། རྨ་རས་དཀྲི་མཁན་ཡང་མེད་དོ། །"]},{"type":"verse","number":22,"content":["དེ་བས་ན་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་ནི་དགྲ་རུ་འཛིན་ཞིང་། ངས་དེའི་སྟོབས་ཤུགས་ལྡན་པའི་དཔུང་པ་དང་བཅག་པའི་དཔུང་པ་མཉམ་དུ་བཅད་ནས། རལ་གྲི་ནི་དེའི་ལག་ནས་སར་ལྷུང་བར་འགྱུར།"]},{"type":"verse","number":23,"content":["ངས་ཨེ་ཅིབ་པ་ནི་རྒྱལ་ཁམས་སོ་སོར་གཏོར་ཞིང་། ཡུལ་ཁམས་སོ་སོར་ཁ་ཐོར་དུ་འགྲོ་བར་བྱའོ། །"]},{"type":"verse","number":24,"content":["ངས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་དཔུང་པ་ལ་སྟོབས་བཅུག་ནས་ངའི་རལ་གྲི་ཁོའི་ལག་ཏུ་གཏོད་ཅིང་། ངས་ཕཱར་ཨོལ་གྱི་དཔུང་པ་བཅག་སྟེ་ཁོ་ནི་རྨས་ནས་འཆི་ལ་ཉེ་བའི་མི་བཞིན་དུ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་མདུན་དུ་འཁུན་པར་བྱའོ། །"]},{"type":"verse","number":25,"content":["ངས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་དཔུང་པར་སྟོབས་བཅུག་ནས། ཕཱར་ཨོལ་གྱི་དཔུང་པ་ནི་ཐུར་དུ་འཕྱང་བར་བྱ། ངས་རང་གི་རལ་གྲི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏད་ནས། ཁོས་རལ་གྲི་བཟུང་སྟེ་ཨེ་ཅིབ་ལ་རྒོལ་བའི་དུས་སུ། དེ་དག་གིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":26,"content":["ངས་ཨེ་ཅིབ་པ་ནི་རྒྱལ་ཁམས་སོ་སོར་གཏོར་ཞིང་། ཡུལ་ཁམས་སོ་སོར་ཁ་ཐོར་དུ་འགྲོ་རུ་བཅུག་ན། དེ་དག་གིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}