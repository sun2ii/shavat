{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":32,"content":[{"type":"heading","content":["ཨེ་ཅིབ་ཀྱི་སྐྱོ་གླུ།"]},{"type":"verse","number":1,"content":["ལོ་བཅུ་གཉིས་པའི་ཟླ་བཅུ་གཉིས་ཀྱི་ཚེས་གཅིག་ཉིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱི་ཆེད་དུ་སྐྱོ་གླུ་ཞིག་རྩོམས་ཤིག དེ་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཁྱོད་ནི་མི་རིགས་ཀུན་གྱི་ཁྲོད་ནས་སེང་གེ་དར་མ་དང་འདྲ་ཞིང་། རྒྱ་མཚོའི་ནང་གི་ཆུ་སྲིན་དང་མཚུངས་ཏེ། ཁྱོད་ནི་གཙང་པོའི་ནང་དུ་ཡར་ལྡིང་མར་ལྡིང་བྱས་ནས་རང་གི་སྡེར་མོས་ཆུ་དཀྲུགས་ཏེ་གཙང་པོ་རྙོག་པ་ཡིན།"]},{"type":"verse","number":3,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཡུལ་ཁམས་ཀུན་གྱི་མི་རྣམས་བསྡུས་ཏེ། ངའི་དྲ་རྒྱ་ཁྱོད་ཀྱི་སྟེང་དུ་འཕངས་ནས། དེ་དག་གིས་ངའི་དྲ་རྒྱས་ཁྱོད་ནི་ཡར་འཐེན་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["ངས་ཁྱོད་སྐམ་སར་གཡུགས་ཏེ་ས་སྟོང་དུ་འཕངས་ནས། ནམ་མཁའི་བྱ་ཐམས་ཅད་ཁྱོད་ཀྱི་སྟེང་དུ་གནས་པར་བྱ་ཞིང་། ས་གཞིའི་གཅན་གཟན་ཐམས་ཅད་ཀྱིས་ཁྱོད་ཟོས་ནས་འགྲང་བར་བྱའོ། །"]},{"type":"verse","number":5,"content":["ཡང་ངས་ཁྱོད་ཀྱི་ཤ་ནི་རི་མགོར་འཕངས་ནས། ཁྱོད་ཀྱི་མཐོ་ཞིང་ཆེ་བའི་བམ་རོ་ནི་ལུང་པ་རུ་འགེང་བར་བྱ་སྟེ།"]},{"type":"verse","number":6,"content":["ངས་ཁྱོད་ལས་བཞུར་བའི་ཁྲག་ནི་ས་གཞིར་བླུགས་ཏེ། རི་བོར་སླེབས་པར་བྱ་ཞིང་གྲོག་ཤུར་རྣམས་སུའང་ཁྱོད་ཀྱི་ཁྲག་གིས་ཁེངས་པར་འགྱུར།"]},{"type":"verse","number":7,"content":["ངས་ཁྱོད་མེད་པར་བྱེད་དུས་ནམ་མཁའ་བསྒྲིབ་ཅིང་། ནམ་མཁའི་སྐར་མ་རྣམས་ཀྱང་མུན་པར་བྱ་སྟེ། ཉི་མ་སྤྲིན་གྱིས་བསྒྲིབས་ནས་ཟླ་བས་ཀྱང་འོད་མི་སྣང་ངོ་། །"]},{"type":"verse","number":8,"content":["ངས་ནམ་མཁའི་འོད་ཀྱི་ཕུང་བོ་རྣམས་ཁྱོད་ཀྱི་སྟེང་དུ་མུན་པར་མཛད་ནས། ཁྱོད་ཀྱི་ཡུལ་ཁམས་ནི་མུན་པས་བསྒྲིབ་པར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["ངས་ཁྱོད་ནི་མི་རྣམས་ཀྱི་ཁྲོད་ནས་མེད་པར་བཏང་བའི་གནས་ཚུལ་དེ། ཁྱོད་ལ་རྒྱུས་མི་མངའ་བའི་ཡུལ་རྣམས་སུ་བསྐྱལ་དུས། ངས་མི་རིགས་ཀུན་གྱི་སེམས་དཀྲུག་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["ངས་དེ་དག་གི་མདུན་ནས་རང་གི་རལ་གྲི་ཁྱོད་ལ་གཡུག་དུས་སུ། དེ་དག་ཁྱོད་ཀྱི་དབང་གིས་སྐྲག་ཅིང་། དེ་དག་གི་རྒྱལ་པོ་རྣམས་ཀྱང་ཁྱོད་ཀྱི་དབང་གིས་རབ་ཏུ་དངངས་པར་འགྱུར། ཁྱོད་ཕམ་པའི་ཉིན་མོར་མི་རེ་རེ་རང་སྲོག་གི་ཆེད་དུ་རྟག་ཏུ་འདར་བར་འགྱུར་རོ། །"]},{"type":"verse","number":11,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་རལ་གྲི་ཁྱོད་ཀྱི་སྟེང་དུ་འབབ་ངེས་ཤིང་།"]},{"type":"verse","number":12,"content":["ངས་དཔའ་བོ་རྣམས་ཀྱི་རལ་གྲི་ལ་བརྟེན་ནས་ཁྱོད་ཀྱི་མི་རྣམས་འགྱེལ་བར་བྱ་ཞིང་། དཔའ་བོ་འདི་རྣམས་ནི་མི་རིགས་ཀུན་ལས་ཧམ་ཤེད་ཆེས་ཆེ་བ་རྣམས་ཡིན་ལ། དེ་ཚོས་ཨེ་ཅིབ་ཀྱིས་ངོམ་བཟོ་སྟོན་པ་དེ་མེད་པར་བྱེད་ཅིང་། ཨེ་ཅིབ་ཀྱི་མི་ཐམས་ཅད་མེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ཡང་ངས་ཆུ་རྣམས་ཀྱི་འགྲམ་དུ་ཨེ་ཅིབ་ཀྱི་ཕྱུགས་རྣམས་ཚར་གཅོད་ཅིང་། ཕྱིན་ཆད་མིའི་རྐང་པས་ཆུ་འདི་དག་རྙོག་པར་མི་འགྱུར་ལ། ཕྱུགས་ཀྱི་རྨིག་པས་ཀྱང་དེ་ལྟར་མི་བྱའོ། །"]},{"type":"verse","number":14,"content":["དུས་དེར་ངས་ཆུ་རྣམས་དྭངས་བར་བྱེད་ཅིང་། གཙང་པོའི་ཆུ་རྣམས་ནི་སྣུམ་བཞིན་དུ་དལ་གྱིས་བཞུར་བར་བྱའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":15,"content":["ངས་ཨེ་ཅིབ་ཀྱི་ཡུལ་སྟོངས་སུ་བཅུག་སྟེ། ཡུལ་ཁམས་དེའི་ནང་ཡོད་པ་ཐམས་ཅད་བརླགས་ནས། དེའི་ནང་ཡོད་པའི་ཡུལ་མི་ཐམས་ཅད་ཚར་བཅད་ན། དུས་དེར་ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ཞེས་པའོ། །"]},{"type":"verse","number":16,"content":["འདི་ནི་མི་ཡིས་ཨེ་ཅིབ་ཀྱི་ཆེད་དུ་བླངས་པའི་སྐྱོ་གླུ་སྟེ། མི་རིགས་སོ་སོའི་བུད་མེད་དག་གིས་སྐྱོ་གླུ་འདི་ལེན་ཞིང་། དེ་རྣམས་ཀྱིས་ཨེ་ཅིབ་དང་དེའི་མི་རྣམས་ཀྱི་ཆེད་དུ་སྐྱོ་གླུ་འདི་ལེན་ནོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ཡང་ལོ་བཅུ་གཉིས་པའི་ཟླ་བཅུ་གཉིས་ཀྱི་ཚེས་བཅོ་ལྔའི་ཉིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":18,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཨེ་ཅིབ་ཀྱི་མི་རྣམས་ཀྱི་ཆེད་དུ་ངུ་འབོད་གྱིས་ཤིག ཨེ་ཅིབ་དང་རྒྱལ་ཁབ་སྟོབས་དང་ལྡན་པའི་བུད་མེད་རྣམས་ནི་ས་དོང་དུ་འབབ་པའི་མི་རྣམས་དང་མཉམ་དུ་གཤིན་པོའི་ཡུལ་དུ་སྐྱོལ་ཅིག"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱིས་ཨེ་ཅིབ་ལ་འདི་ལྟར། ཁྱོད་ནི་སུ་ལས་ཁྱད་དུ་འཕགས་པ་ཡིན་ནམ། ཁྱོད་རང་མར་སོང་སྟེ་མཚན་སྐྱི་མ་བཅད་པའི་མི་དེ་དག་དང་མཉམ་དུ་ཉལ་ནས་སྡོད་ཅིག་ཅེས་སྨྲོས་ཤིག"]},{"type":"verse","number":20,"content":["དེ་དག་ནི་རལ་གྲིས་བཀུམ་པའི་མི་རྣམས་ཀྱི་དབུས་སུ་འགྱེལ་བར་འགྱུར་ཞིང་། རལ་གྲི་བཏོན་པ་ན་ཨེ་ཅིབ་དང་དེའི་མི་རྣམས་ནི་མཉམ་དུ་མར་འཐེན་པར་འགྱུར།"]},{"type":"verse","number":21,"content":["དཔའ་བོ་ནང་གི་ཆེས་སྟོབས་དང་ལྡན་པ་དེས་གཤིན་ཡུལ་དུ་ཨེ་ཅིབ་དང་ཨེ་ཅིབ་ལ་རོགས་བྱེད་མཁན་རྣམས་གླེང་སྟེ་ན་རེ། དེ་དག་མར་འོངས་ཤིང་། དེ་དག་ནི་མཚན་སྐྱི་མ་བཅད་པའི་མི་སྟེ་རལ་གྲིས་བཀུམ་པའི་མི་རྣམས་དང་མཉམ་དུ་ཉལ་ལོ་ཞེས་ཟེར་རོ། །"]},{"type":"heading","content":["ལན་འཇལ་བའི་སྐོར།"]},{"type":"verse","number":22,"content":["ཨ་སུར་དང་དེའི་དམག་དཔུང་ཐམས་ཅད་དེར་ཡོད་པ་དང་། དེའི་མཐའ་འཁོར་དུ་ཁོ་ཚོའི་དུར་ཁུང་རྣམས་འདུག་སྟེ། དེ་ཐམས་ཅད་ནི་སྲོག་ཤོར་བ་དང་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བའི་མི་ཡིན་ནོ། །"]},{"type":"verse","number":23,"content":["དེ་དག་གི་དུར་ཁུང་ནི་ཆེས་ཟབ་པའི་དོང་ནང་དུ་བཞག་ཡོད་པ་དང་། ཨ་སུར་གྱི་དམག་དཔུང་རྣམས་ནི་དེའི་དུར་ཁུང་གི་མཐའ་འཁོར་དུ་ཡོད་ལ། ཐམས་ཅད་སྲོག་ཤོར་བ་དང་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བའི་མི་ཡིན་ཏེ། སྔར་དེ་ཚོས་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས་སོ། །"]},{"type":"verse","number":24,"content":["ཨེ་ལཱམ་ཡང་དེར་ཡོད་པ་དང་དེའི་མི་རྣམས་ཀྱང་དེའི་དུར་ཁུང་གི་མཐའ་འཁོར་དུ་ཡོད་དེ། ཐམས་ཅད་སྲོག་ཤོར་བ་དང་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བའི་མི་ཡིན་ནོ། །ཁོ་ཚོ་ནི་མཚན་སྐྱི་མ་བཅད་པར་གཤིན་ཡུལ་དུ་ལྷུང་བ་ཡིན་ལ། སྔར་ཁོ་ཚོས་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས་ཏེ། ད་ལྟ་ཁོ་ཚོས་དོང་ནང་དུ་ལྷུང་བའི་མི་རྣམས་དང་ལྷན་ཅིག་རང་གི་ངོ་ཚ་ཁུར་བ་ཡིན།"]},{"type":"verse","number":25,"content":["བསད་པའི་མི་རྣམས་ཀྱི་ཁྲོད་དུ་དེ་དང་དེའི་མི་ཀུན་གྱི་ཆེད་དུ་མལ་ཁྲི་བཙུགས་ཡོད་དེ། ཁོ་ཚོའི་དུར་ཁུང་ནི་དེའི་མཐའ་འཁོར་དུ་ཡོད་པ་དང་། ཁོ་ཚོ་ཚང་མ་མཚན་སྐྱི་མ་བཅད་པ་དང་རལ་གྲིས་བཀུམ་པའི་མི་ཡིན་ཏེ། སྔར་ཁོ་ཚོས་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས་ཏེ། ད་ལྟ་ཁོ་ཚོས་དོང་ནང་དུ་ལྷུང་བའི་མི་རྣམས་དང་ལྷན་ཅིག་རང་གི་ངོ་ཚ་ཁུར་བ་དང་། ཨེ་ལཱམ་ནི་བསད་པའི་མི་རྣམས་ཁྲོད་དུ་བཞག་ཡོད་དོ། །"]},{"type":"verse","number":26,"content":["མེ་ཤེག་དང་ཐུ་བཱལ་དང་དེའི་མི་ཀུན་ཡང་དེར་ཡོད་དེ། ཁོ་ཚོའི་དུར་ཁུང་ནི་མེ་ཤེག་དང་ཐུ་བཱལ་གྱི་མཐའ་འཁོར་དུ་ཡོད་པ་དང་། ཁོ་ཚོ་ཚང་མ་མཚན་སྐྱི་མ་བཅད་པ་དང་རལ་གྲིས་བཀུམ་པའི་མི་སྟེ། སྔར་ཁོ་ཚོས་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས།"]},{"type":"verse","number":27,"content":["ཁོ་ཚོ་ཚང་མ་ནི་མཚན་སྐྱི་མ་བཅད་པར་བསད་པའི་དཔའ་བོ་རྣམས་དང་མཉམ་དུ་ཉལ་བ་མ་ཡིན་ནམ། དཔའ་བོ་འདི་དག་གིས་མཚོན་ཆ་བཟུང་ནས་གཤིན་ཡུལ་དུ་ལྷུང་སྟེ། རལ་གྲི་རང་གི་མགོ་ཡི་འོག་ཏུ་བཞག་ཡོད་དོ། །དེ་དག་གི་སྡིག་ཉེས་ནི་རང་གི་རུས་པའི་སྟེང་དུ་ཡོད་དེ། སྔར་ཁོ་ཚོས་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས་སོ། །"]},{"type":"verse","number":28,"content":["ཀྱེ་ཕཱར་ཨོལ། ཁྱོད་ལ་མཚོན་ན། ཁྱོད་ནི་མཚན་སྐྱི་མ་བཅད་པའི་མི་ཡི་ཁྲོད་དུ་མེད་པར་འགྱུར་ཞིང་། རལ་གྲིས་བསད་པའི་མི་དང་མཉམ་དུ་ཉལ་བར་འགྱུར།"]},{"type":"verse","number":29,"content":["ཨེ་དོམ་ཡང་དེར་ཡོད་དེ། ཨེ་དོམ་གྱི་རྒྱལ་པོ་རྣམས་དང་འགོ་དཔོན་ཐམས་ཅད་ལ་དཔའ་ངར་ལྡན་ཡང་། ད་དུང་རལ་གྲིས་བཀུམ་པའི་མི་རྣམས་ཀྱི་ཁོངས་སུ་བཞག་ཡོད་པ་དང་། དེ་དག་ནི་མཚན་སྐྱི་མ་བཅད་པར་དོང་དུ་ལྷུང་བའི་མི་དང་མཉམ་དུ་ཉལ་བར་འགྱུར།"]},{"type":"heading","content":["བྱང་ཕྱོགས་ཀྱི་མི་རིགས་ཀུན་དང་ཚི་ཏུན་ལ་ལན་འཇལ་བ།"]},{"type":"verse","number":30,"content":["གནས་དེར་བྱང་ཕྱོགས་ཀྱི་འགོ་དཔོན་རྣམས་དང་ཚི་ཏུན་པ་ཐམས་ཅད་ཀྱང་ཡོད་པ་དང་། དེ་ཐམས་ཅད་ནི་བསད་པའི་མི་དང་མཉམ་དུ་མར་ཕྱིན་པ་སྟེ། ཁོ་ཚོར་དཔའ་ངར་ལྡན་ཞིང་མི་ལ་འཇིགས་སྐུལ་ན་ཡང་། ད་དུང་ངོ་ཚ་ཐེབས་པ་དང་། ཁོ་ཚོས་མཚན་སྐྱི་མ་བཅད་པ་དང་། རལ་གྲིས་བཀུམ་པའི་མི་རྣམས་དང་མཉམ་དུ་ཉལ་ཞིང་། དོང་ནང་དུ་ལྷུང་བའི་མི་དང་ལྷན་ཅིག་རང་གི་ངོ་ཚ་ཁུར་བའོ། །"]},{"type":"verse","number":31,"content":["ཕཱར་ཨོལ་གྱིས་དེ་དག་མཐོང་སྟེ། ཕཱར་ཨོལ་རང་ཉིད་དང་ཁོའི་མི་རྣམས་ཏེ། རལ་གྲིས་བཀུམ་པའི་རང་གི་དཔུང་ཚོགས་ཀུན་གྱི་ཕྱིར་དུ་སེམས་གསོ་རྙེད་དོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":32,"content":["ངས་ཕཱར་ཨོལ་ལ་གསོན་པོའི་གནས་སུ་དངངས་སྐྲག་གིས་ཁྱབ་པར་བྱས་ན་བྱེད་དུ་བཅུག་ཀྱང་། དེ་དང་དེའི་མི་རྣམས་ནི་མཚན་སྐྱི་མ་བཅད་པའི་མི་ཡི་ནང་དུ་རལ་གྲིས་བཀུམ་པའི་མི་དང་མཉམ་དུ་ཉལ་བར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/31.json","previousChapterAudioLinks":{},"numberOfVerses":32}