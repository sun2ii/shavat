{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":33,"content":[{"type":"heading","content":["སོ་ལྟའི་འགན་ཁུར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་རང་གི་རྒྱལ་ཁམས་ཀྱི་མི་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག ངས་ཡུལ་ཞིག་ལ་རལ་གྲི་སླེབས་སུ་འཇུག་དུས། ཡུལ་མི་རྣམས་ཀྱིས་རང་གི་ནང་ནས་མི་ཞིག་བདམས་ཏེ་ཁོ་ཚོའི་སོ་ལྟ་རུ་བཞག་ནས།"]},{"type":"verse","number":3,"content":["མི་དེས་རང་གི་ཡུལ་དུ་རལ་གྲི་སླེབས་པ་མཐོང་ཚེ། དམག་དུང་བུས་ནས་མི་རྣམས་ལ་ཉེན་བརྡ་གཏོང་དགོས་ལ།"]},{"type":"verse","number":4,"content":["དམག་དུང་ཐོས་ཀྱང་ཉེན་བརྡར་མི་མཉན་པའི་མི་ལ། རལ་གྲི་སླེབས་ནས་ཁོ་མེད་པར་བཟོས་ཀྱང་ཁོའི་སྲོག་ཉེས་ནི་ཁོ་རང་གིས་འཁུར་དགོས་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ཁོས་དམག་དུང་ཐོས་ཀྱང་ཉེན་བརྡར་མ་མཉན་པས། ཁོའི་སྲོག་ཉེས་ནི་ཁོ་རང་གིས་འཁུར་དགོས་པ་ཡིན། གལ་ཏེ་ཁོས་ཉེན་བརྡ་དེ་དང་དུ་བླངས་ན་རང་སྲོག་སྐྱོབ་ཐུབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":6,"content":["ཡིན་ན་ཡང་གལ་ཏེ་སོ་ལྟ་དེས་རལ་གྲི་སླེབས་པ་མཐོང་བཞིན་དུ་དམག་དུང་མ་བུས་པར། ཐ་ན་མི་རྣམས་ལ་ཉེན་བརྡ་ཡང་མ་བཏང་ན། རལ་གྲི་སླེབས་ཏེ་ཁོ་ཚོའི་ནང་གི་མི་གཅིག་མེད་པར་བཟོས་ན། མི་དེ་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་མེད་པར་བཟོས་ཀྱང་། དེ་ཤི་བའི་རྐྱེན་གྱིས་ངས་སོ་ལྟ་དེ་འདེད་པར་བྱའོ་ཞེས་པའོ། །"]},{"type":"verse","number":7,"content":["ཀྱེ་མིའི་བུ། ངས་ཁྱོད་ནི་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་བྱ་ར་རུ་བསྐོས་པས། ཁྱོད་ཀྱིས་ངའི་གསུང་ལ་མཉན་ཏེ། ངའི་ཚབ་ཏུ་དེ་རྣམས་ལ་ཐ་ཚིག་སྒྲོགས་ཤིག"]},{"type":"verse","number":8,"content":["གལ་ཏེ་ངས་མི་ངན་ལ་འདི་སྐད་དུ། ཀྱེ་མི་ངན་ཁྱོད་ནི་འཆི་ངེས་ཡིན་ཞེས་སྨྲས་པའི་ཚེ། ཨེ་ཟེ་ཀི་ཨེལ་ཁྱོད་ཀྱིས་མི་དེ་རང་གི་སྤྱོད་ལམ་དང་འབྲལ་བར་ཉེན་བརྡ་མ་བཏང་ན། མི་ངན་དེ་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར་ན་ཡང་། དེ་ཤི་བའི་རྐྱེན་གྱིས་ངས་ཁྱོད་འདེད་པར་བྱའོ། །"]},{"type":"verse","number":9,"content":["གལ་ཏེ་ཁྱོད་ཀྱིས་མི་ངན་ལ་ཐ་ཚིག་བསྒྲགས་ཤིང་། མི་དེ་རང་གི་སྤྱོད་ལམ་ལས་འབྲལ་བར་བསྐུལ་ན་ཡང་། མི་དེ་ད་དུང་མི་འབྲལ་ན། མི་དེ་ནི་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར་མོད། ཁྱོད་ཀྱིས་རང་སྲོག་བསྐྱབས་པ་ཡིན།"]},{"type":"heading","content":["མིའི་བཟང་ངན་རང་ཉིད་ཀྱིས་འགན་འཁུར་དགོས་པ།"]},{"type":"verse","number":10,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་འདི་ལྟར། ཁྱོད་ཚོ་ན་རེ། ངེད་ཅག་གི་ཉེས་སྐྱོན་དང་སྡིག་པ་ནི་ང་ཚོའི་སྟེང་དུ་ཡོད་པས། ངེད་རྣམས་དེའི་རྐྱེན་གྱིས་ཉམ་ཐག་ནས་འཆི་བར་འགྱུར་བ་ལས། གསོན་པར་ཅི་ལྟར་འགྱུར་རམ་ཟེར་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱིས་ཁོ་ཚོར་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ངན་ནི་རང་གི་སྤྱོད་ལམ་དང་བྲལ་ནས་གསོན་པ་མ་གཏོགས་མི་ངན་འཆི་བར་ང་རང་མི་དགའོ་ཞེས་བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བས་ན། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད། ཕྱིར་འཁོར་ཞིག རང་གི་སྤྱོད་ལམ་དང་འབྲལ་བར་གྱིས་ཤིག ཁྱོད་ཅག་འཆི་དགོས་དོན་ཅི་ཡོད་དམ་གསུངས་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":12,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་རང་གི་མི་རིགས་ལ་འདི་ལྟར་སྨྲོས་ཤིག མི་དྲང་བདེན་ཅན་གྱི་དྲང་བདེན་གྱིས་ཁོས་སྡིག་པ་བྱེད་པའི་དུས་སུ་ཁོ་སྐྱོབ་མི་ནུས་ལ། མི་ངན་གྱི་ངན་པས་ཀྱང་ཁོས་རང་གི་ལས་ངན་པ་འདོར་བའི་དུས་སུ་ཁོ་རང་འགྱེལ་བར་མི་བྱ། མི་དྲང་བདེན་ཅན་གྱིས་སྡིག་པ་བྱེད་པའི་དུས་སུ་རང་གི་དྲང་བདེན་གྱིས་འཚོ་བར་མི་འགྱུར་ཞེས་པའོ། །"]},{"type":"verse","number":13,"content":["མི་དྲང་བདེན་ཅན་ལ་ངས་དེ་ངེས་པར་དུ་གསོན་པར་འགྱུར་ཞེས་སྨྲས་ཀྱང་། དེས་རང་གི་དྲང་བདེན་ལ་བློ་གཏད་དེ་ལས་ངན་པ་སྤྱད་ན། དེའི་དྲང་བདེན་ཡོད་ཚད་དྲན་པར་མི་འགྱུར་ལ། དེ་ནི་རང་གིས་སྤྱད་པའི་སྡིག་པའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":14,"content":["ཡང་ངས་མི་ངན་ལ་ཁྱོད་ནི་འཆི་ངེས་ཡིན་ཞེས་སྨྲས་ཀྱང་། དེ་རང་གི་སྡིག་པ་དང་བྲལ་ནས་དྲང་གཞག་དང་དྲང་བདེན་གྱི་ལས་རྣམས་སྤྱད་དེ།"]},{"type":"verse","number":15,"content":["གཏའ་མར་བཞག་པ་ཕྱིར་སྤྲོད་པ་དང་། མི་ལས་ཕྲོགས་པའི་རྫས་རྣམས་འཇལ་བ་དང་། སྲོག་འཚོ་བར་བྱེད་པའི་བཀའ་རྒྱ་བརྩིས་ཏེ་ལས་ངན་པ་མ་སྤྱད་ན། དེ་གསོན་པ་ལས་འཆི་བར་མི་འགྱུར་ལ།"]},{"type":"verse","number":16,"content":["དེས་སྤྱད་པའི་སྡིག་པ་ཡོད་ཚད་ནི་དྲན་པར་མི་འགྱུར་ཞིང་། དེས་དྲང་གཞག་དང་དྲང་བདེན་གྱི་ལས་སྤྱད་པས་གསོན་ངེས་ཡིན།"]},{"type":"verse","number":17,"content":["ཡང་ཁྱོད་ཀྱི་མི་རྣམས་ན་རེ། གཙོ་བོས་མཛད་པ་དྲང་གཞག་མིན་ཟེར་མོད། དོན་དངོས་སུ་ཁོ་ཚོས་སྤྱད་པ་དྲང་གཞག་མིན་ནོ། །"]},{"type":"verse","number":18,"content":["མི་དྲང་བདེན་ཅན་ནི་རང་གི་དྲང་བདེན་དང་བྲལ་ནས་ལས་ངན་པ་སྤྱད་ན། མི་དེ་ནི་སྤྱོད་པ་ངན་པའི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར།"]},{"type":"verse","number":19,"content":["ཡང་མི་ངན་རང་གི་གདུག་པ་དང་བྲལ་ནས། དྲང་གཞག་དང་དྲང་བདེན་གྱི་ལས་རྣམས་སྤྱད་ན། ཁོ་ནི་དེའི་རྐྱེན་གྱིས་གསོན་པར་འགྱུར་རོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་ཚོས་ད་དུང་གཙོ་བོས་མཛད་པ་དྲང་གཞག་མིན་ཟེར་རམ། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ངས་ཁྱོད་ཚོ་མི་རེ་རེས་སྤྱད་པའི་ལས་བཞིན་དུ་ཁྱོད་ལ་ཁྲིམས་གཅོད་དོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་དགྲ་ལག་ཏུ་ཤོར་བའི་གནས་ཚུལ།"]},{"type":"verse","number":21,"content":["ངེད་ཅག་བཙོན་དུ་ཁྲིད་པའི་ལོ་བཅུ་གཉིས་པའི་ཟླ་བཅུ་པའི་ཚེས་ལྔ་ཉིན་ལ། མི་ཞིག་ཡེ་རུ་སཱ་ལེམ་ནས་ངའི་མདུན་དུ་བྲོས་འོངས་ནས་ན་རེ། གྲོང་ཁྱེར་དགྲ་ལག་ཏུ་ཤོར་སོང་ཞེས་སྨྲས་བྱུང་།"]},{"type":"verse","number":22,"content":["མི་དེ་མ་སླེབས་སྔོན་གྱི་མཚན་མོ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ནི་ངའི་སྟེང་དུ་བཞག་སྟེ། ངའི་ངག་སྒོ་ཕྱེས་པ་དང་། ཞོགས་པ་སླེབས་ནས་མི་དེ་ངའི་མདུན་དུ་འོངས་པ་ན། ང་རང་ཁ་གྲགས་ཐུབ་པར་གྱུར་ནས་ལྐུགས་པར་མ་ལུས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":24,"content":["ཀྱེ་མིའི་བུ། ཡེས་ར་ཨེལ་ཡུལ་གྱི་གྱང་རོ་ཡི་ནང་དུ་སྡོད་པའི་མི་དེ་རྣམས་ཀྱིས་རྒྱུན་དུ་ན་རེ། ཨབ་ར་ཧམ་གཅིག་པོར་ཡུལ་འདི་ས་སྐལ་དུ་ཐོབ་པ་ཡིན་ན། ངེད་རྣམས་མི་གྲངས་མང་བས་ཡུལ་འདི་རང་ཅག་ལ་ས་སྐལ་དུ་འཐོབ་པར་གདོན་མི་ཟ་ཞེས་ཟེར་བས།"]},{"type":"verse","number":25,"content":["ཁྱོད་ཀྱིས་མི་དེ་དག་ལ་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོས་ཁྲག་ཡོད་པའི་ཤ་ཟ་ཞིང་། ཡར་རང་གི་སྐུ་འདྲ་རྣམས་ལ་བལྟ་བ་དང་། ཡང་མི་ལ་ཁྲག་བཞུར་དུ་བཅུག་པས། ཁྱོད་རྣམས་ལ་ད་དུང་ཡུལ་འདི་ས་སྐལ་དུ་འཐོབ་འོས་སམ།"]},{"type":"verse","number":26,"content":["ཁྱོད་ཚོས་རང་གི་རལ་གྲིར་བརྟེན་ནས་ཞེན་ལོག་གི་ལས་སྤྱད་དེ། མི་རེ་རེས་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་བཙོག་པར་བྱས་པས། ཁྱོད་ཚོར་ད་དུང་ཡུལ་འདི་ས་སྐལ་དུ་འཐོབ་འོས་སམ་གསུངས་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":27,"content":["ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། གྱང་རོའི་ནང་དུ་ཡོད་པ་དག་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བར་འགྱུར། ཐང་དུ་ཡོད་པ་དག་ངས་གཅན་གཟན་ལ་གཏད་དེ་བཟའ་བར་འགྱུར། བཙན་རྫོང་དང་བྲག་ཕུག་ནང་དུ་ཡོད་པ་དག་རིམས་ནད་ཀྱིས་འཆི་བར་འགྱུར་ཞེས་བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་ཡིན།"]},{"type":"verse","number":28,"content":["ངས་ཡུལ་འདི་མི་མེད་ལུང་སྟོང་དུ་བྱ་སྟེ། དེའི་སྟོབས་ཤུགས་ཀྱི་དབང་གིས་ཡོད་པའི་ང་རྒྱལ་རྣམས་མེད་པར་འགྱུར་ཞིང་། ཡེས་ར་ཨེལ་གྱི་རི་རྣམས་སྟོངས་ཤིང་། དེར་རྒྱུ་ནས་འགྲོ་མཁན་སུ་ཡང་མེད་དོ། །"]},{"type":"verse","number":29,"content":["ངས་དེ་དག་གིས་བྱས་པའི་ཞེན་ལོག་གི་དོན་རྣམས་ཀྱི་རྐྱེན་གྱིས་ཡུལ་འདི་མི་མེད་ལུང་སྟོང་དུ་བྱས་ན། ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་གསུངས་ཞེས་སྨྲོས་ཤིག"]},{"type":"heading","content":["ལུང་སྟོན་པས་གཏམ་བཟང་བསྒྲགས་པའི་འབྲས་བུ།"]},{"type":"verse","number":30,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱི་མི་རྣམས་ཀྱིས་མཁར་གྱི་འགྲམ་དང་རང་ཁྱིམ་གྱི་སྒོ་ཁར་ཁྱོད་རང་གླེང་སྟེ། སྤུན་ཟླས་སྤུན་ཟླར་ཕན་ཚུན་ན་རེ། ཤོག་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལས་འབྱུང་བའི་གསུང་ལ་མཉན་པར་བྱའོ་ཟེར་ཞིང་།"]},{"type":"verse","number":31,"content":["དེ་དག་ངའི་མི་ཡིན་པ་བཞིན་དུ་ཚོ་དང་ཚོ་བྱས་ནས་ཁྱོད་ཀྱི་རྩར་འོངས་ཏེ་ཁྱོད་ཀྱི་མདུན་དུ་སྡོད་པ་ཡིན། དོན་དངོས་སུ་དེ་དག་གིས་ཁྱོད་ཀྱི་གཏམ་ལ་མཉན་ཡང་དེ་བཞིན་མི་བྱ་སྟེ། ཁོ་ཚོས་ཁ་ནས་གང་ཞིག་འདོད་པ་དེ་སྨྲ་ཞིང་། སེམས་ནི་ལྐོག་ནོར་གྱི་རྗེས་སུ་འབྲང་བའོ། །"]},{"type":"verse","number":32,"content":["ལྟོས་དང་། དེ་ཚོའི་མིག་ལམ་དུ་ཁྱོད་ནི་གླུ་སྙན་མོ་ཞིག་ལས་མ་འདས། གླུ་སྐད་སྙན་ཞིང་སྒྲ་སྙན་དཀྲོལ་བ་འཇེབས་པ་ཙམ་ཡིན་ཏེ། གང་ལ་ཞེ་ན། དེ་ཚོས་ཁྱོད་ཀྱི་གཏམ་ལ་མཉན་ཡང་དེ་བཞིན་དུ་མི་སྤྱོད་དོ། །"]},{"type":"verse","number":33,"content":["ལྟོས་དང་། དོན་འདི་འགྲུབ་པར་འགྱུར་ཞིང་། དུས་དེར་སླེབས་ཚེ་ཁོ་ཚོས་རང་གི་ཁྲོད་དུ་ལུང་སྟོན་པ་ཞིག་ཡོད་པ་རྟོགས་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}