{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":34,"content":[{"type":"heading","content":["འགན་ཤོར་བའི་རྫི་བོ་རྣམས་ལ་གཤེ་གཤེ་གཏོང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཡེས་ར་ཨེལ་གྱི་རྫི་བོ་རྣམས་ལ་རྒོལ་བའི་ལུང་སྟོན་ཅིག ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་གྱི་རྫི་བོ་རྣམས་ལ་ཆག་སྒོ་འབྱུང་། གང་ལ་ཞེ་ན། དེ་དག་གིས་རང་ཉིད་འཚོ་བ་ཁོ་ནར་འབད་དོ། །རྫི་བོས་ལུག་ཁྱུ་འཚོ་འོས་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཚོས་སྣུམ་དང་ཚིལ་ཟོས་ནས་ལུག་བལ་གྱོན་པ་དང་། ཤ་རྒྱགས་པའི་ལུག་བཤས་ཀྱང་ལུག་ཁྱུ་མི་འཚོའོ། །"]},{"type":"verse","number":4,"content":["ཤ་ཤེད་ཞན་པ་རྣམས་ལ་ཁྱོད་ཚོས་ཤེད་འཛོམ་དུ་མ་བཅུག་ལ། ནད་ཡོད་པ་རྣམས་ལ་ཁྱོད་ཚོས་སྨན་བཅོས་མ་བྱས། རྨས་པ་རྣམས་ཁྱོད་ཚོས་མ་དཀྲིས། ཕར་བསྐྲད་ནས་ཁ་ཐོར་དུ་ཕྱིན་པ་རྣམས་ཁྱོད་ཚོས་ཕྱིར་ཁྲིད་མ་འོངས་ལ། བོར་བ་རྣམས་ཁྱོད་ཚོས་མ་བཙལ་བའི་ཁར། ཁྱོད་ཚོས་ད་དུང་དེ་དག་ལ་བཙན་ཤུགས་བཀོལ་ནས་མངའ་འོག་ཏུ་བསྡུས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་རྣམས་ལ་རྫི་བོ་མེད་པས་ཁ་ཐོར་དུ་སོང་སྟེ། ཐང་གི་གཅན་གཟན་རྣམས་ཀྱི་ཁ་ཟས་སུ་གྱུར་ཏོ། །"]},{"type":"verse","number":6,"content":["ངའི་ལུག་རྣམས་རི་བོ་རྣམས་དང་རི་སྒང་དག་ཏུ་ཕྱོགས་བཞིར་འཁྱམས་པ་དང་། དེ་དག་ས་གཞི་ཡོངས་སུ་ཁ་ཐོར་དུ་སོང་ན་ཡང་འཚོལ་མཁན་མེད་ལ་ལྟ་མཁན་ཡང་མེད་དོ། །"]},{"type":"verse","number":7,"content":["དེ་བས་ཁྱོད་རྫི་བོ་རྣམས་ཀྱིས་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":8,"content":["བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། ངའི་ལུག་ལ་རྫི་བོ་མེད་པས་བརྔོན་དངོས་སུ་གྱུར་ནས་ཐང་གི་གཅན་གཟན་རྣམས་ཀྱི་ཁ་ཟས་སུ་གྱུར་ཏོ། །ངའི་རྫི་བོ་རྣམས་ཀྱིས་ངའི་ལུག་རྣམས་མི་བཙལ་ཞིང་། ཁོ་ཚོས་རང་ཉིད་འཚོ་བར་འབད་པ་ལས་ངའི་ལུག་རྣམས་མི་འཚོའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":9,"content":["དེའི་ཕྱིར་ཁྱོད་རྫི་བོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":10,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་རྫི་བོ་རྣམས་དགྲ་རུ་འཛིན་ཏེ། ངས་དེ་ཚོའི་ལག་ནས་ངའི་ལུག་རྣམས་བླངས་ནས། དེ་དག་ལ་ཡང་བསྐྱར་ལུག་འཚོ་བར་མི་འཇུག་སྟེ། ཕྱིན་ཆད་རང་ཉིད་ཀྱང་འཚོ་བར་མི་འགྱུར་རོ། །གང་ལ་ཞེ་ན། དེ་དག་གི་ཁ་ཟས་སུ་མི་འགྱུར་བའི་ཆེད་དུ་ངས་རང་གི་ལུག་རྣམས་བསྐྱབས་ནས་དེ་དག་གི་ཁ་ནས་འཆོར་བར་འགྱུར་རོ། །"]},{"type":"heading","content":["ཡ་ཝཱེ་ཁོང་ཉིད་ཡེས་ར་ཨེལ་གྱི་རྫི་བོར་བྱེད་པ།"]},{"type":"verse","number":11,"content":["གང་ལ་ཞེ་ན། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ང་རང་གིས་ངའི་ལུག་རྣམས་བཙལ་ནས་དེ་དག་རྙེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["ལུག་རྣམས་ཕྱོགས་བཞིར་ཐོར་བའི་དུས་སུ་རྫི་བོས་རང་གི་ལུག་རྣམས་ཇི་ལྟར་འཚོལ་བ་བཞིན་དུ། ངས་ཀྱང་དེ་ལྟར་རང་གི་ལུག་རྣམས་འཚོལ་བར་བྱའོ། །ལུག་འདི་རྣམས་ནི་སྤྲིན་ནག་འཐིབས་ཤིང་མུན་པའི་དུས་སུ་ཡུལ་སོ་སོར་ཁ་ཐོར་དུ་སོང་བ་དང་། ངས་ཡུལ་དེ་ནས་དེ་དག་སྐྱོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ངས་དེ་རྣམས་མི་རིགས་ཀུན་ལས་ཕྱི་རུ་ཁྲིད་འོངས་ནས། མི་ཀུན་ནས་བསྡུས་ཏེ་རང་ཡུལ་དུ་འཁྲིད་པར་འགྱུར་ཞིང་། ཡེས་ར་ཨེལ་གྱི་རི་རྣམས་དང་། གྲོག་ཤུར་གྱི་འགྲམ་དང་། ཡུལ་ཁམས་ནང་རོལ་གྱི་སྡོད་གནས་ཀུན་ཏུ་དེ་དག་འཚོ་བར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ངས་དེ་དག་རྩྭ་ཆུ་འཛོམས་པའི་གནས་སུ་འཚོ་བ་དང་། ཡེས་ར་ཨེལ་གྱི་རི་སྒང་མཐོན་པོ་རྣམས་དེ་དག་འཚོ་སའི་གནས་སུ་འགྱུར་ཞིང་། གནས་དེ་རུ་དེ་རྣམས་རྩྭ་ས་བཟང་པོའི་སྟེང་དུ་ཉལ་ནས། ཡེས་ར་ཨེལ་གྱི་རི་རྣམས་ཀྱི་རྩྭ་ཁ་བཟང་སར་རྩྭ་བཟའ་བར་འགྱུར།"]},{"type":"verse","number":15,"content":["ངས་རང་གི་ལུག་རྣམས་འཚོས་ནས་ཉལ་དུ་འཇུག་གོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":16,"content":["བོར་བ་རྣམས་ངས་ཕྱིར་འཚོལ་ཞིང་། ཁ་ཐོར་དུ་སོང་བ་རྣམས་ངས་ཕྱིར་ཁྲིད་འོང་དགོས་ལ། རྨས་པ་རྣམས་ངས་དཀྲིས་ནས་ནད་ཡོད་པ་རྣམས་ལ་ངས་ཤེད་རྒྱས་པར་བྱའོ། །ཡིན་ཡང་ཚོན་པོ་དང་ཤ་ཤེད་ཅན་རྣམས་ངས་ཚར་དུ་གཅོད་ཅིང་། ངས་དྲང་གཞག་གིས་དེ་རྣམས་འཚོ་བར་བྱའོ། །"]},{"type":"verse","number":17,"content":["ཀྱེ་ངའི་ལུག་ཁྱུ། ཁྱོད་ཚོའི་སྐོར་ལ་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ལུག་དང་ལུག་གི་བར་དང་། ལུག་ཐུག་དང་ར་ཐུག་གི་བར་ནས་ཁྲིམས་གཅོད་པར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཚོས་རྩྭ་ཁ་བཟང་ས་ནས་རྩྭ་ཟོས་ཀྱང་ད་དུང་ཡིད་མི་ཚིམ་པ་ཡིན་ནམ། ཁྱོད་ཚོས་ཇི་མི་སྙམ་པར་རྩྭ་ཟ་འཕྲོ་རྣམས་ལ་རྡོག་བརྫིས་བརྒྱབ་ནས། ཆུ་དྭངས་མོ་འཐུང་ན་ཡང་ཆུ་ལྷག་མ་རྣམས་རྐང་པས་རྙོག"]},{"type":"verse","number":19,"content":["ངའི་ལུག་ཁྱུས་ཁྱོད་ཚོས་བརྫིས་པ་དེ་བཟའ་དགོས་ཤིང་། རྐང་པས་རྙོག་པ་དེ་མི་འཐུང་ཀ་མེད་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["དེའི་ཕྱིར་གཙོ་བོ་ཡ་ཝཱེས་དེ་རྣམས་ལ་འདི་སྐད་དུ། ལྟོས་དང་། ངས་ལུག་རྒྱགས་པ་དང་ལུག་སྐམ་པོ་གཉིས་ཀྱི་བར་ནས་ཁྲིམས་གཅོད་པར་བྱ་སྟེ།"]},{"type":"verse","number":21,"content":["གང་ལ་ཞེ་ན། ཁྱོད་ཚོས་རང་གི་རྩིབ་ལོགས་དང་ཕྲག་པ་ཡིས་ལུག་སྐམ་པོ་ཐམས་ཅད་བཙིར་ནས། དེ་དག་ཕྱི་རུ་མ་བསྐྲད་བར་དུ་རང་གི་རྭ་ཅོས་དེ་རྣམས་ལ་བརྡུངས་པའོ། །"]},{"type":"verse","number":22,"content":["དེ་བས་ན་ངས་རང་གི་ལུག་རྣམས་བརྔོན་དངོས་སུ་མི་འགྱུར་བའི་ཆེད་དུ་དེ་རྣམས་སྐྱོབ་ཅིང་། ངས་ལུག་དང་ལུག་གི་བར་ནས་ཁྲིམས་གཅོད་པར་བྱའོ། །"]},{"type":"heading","content":["མཱ་ཤི་ཀའི་ལུང་བསྟན།"]},{"type":"verse","number":23,"content":["ངས་རང་གི་གཡོག་པོ་དཱ་བིད་རྫི་བོར་བསྐོས་ནས། དེས་ལུག་ཁྱུ་ལ་ལྟ་སྐྱོང་བྱས་ནས་འཚོ་བར་འགྱུར་ལ། ལུག་ཁྱུ་འཚོས་ནས་དེ་དག་གི་རྫི་བོ་བྱེད་དོ། །"]},{"type":"verse","number":24,"content":["ཡ་ཝཱེ་བདག་ནི་ཁོ་ཚོའི་དཀོན་མཆོག་དང་། ངའི་གཡོག་པོ་དཱ་བིད་ནི་ཁོ་ཚོའི་དཀྱིལ་དུ་རྒྱལ་པོ་རུ་འགྱུར་རོ་ཞེས་ང་ཡ་ཝཱེས་སྨྲས་པ་ཡིན།"]},{"type":"verse","number":25,"content":["ཡང་ངས་དེ་དག་དང་ཞི་བདེའི་ཁ་ཆད་བཞག་སྟེ། ཡུལ་ཁམས་ནང་རོལ་གྱི་གཅན་གཟན་ངན་པ་རྣམས་མེད་པར་བཟོས་ནས། དེ་དག་དབེན་སྟོང་དུ་བདེ་བར་གནས་ཤིང་ནགས་ཚལ་དུ་ཉལ་བར་འགྱུར།"]},{"type":"verse","number":26,"content":["ངས་དེ་དག་དང་ངའི་རི་སྒང་གི་མཐའ་འཁོར་ལའང་བྱིན་རླབས་གནང་ནས་དུས་ལྟར་ཆར་འབབ་ཏུ་འཇུག་སྟེ། དེ་ནི་བདེ་བ་སྩོལ་བའི་ཆར་བ་ཡིན།"]},{"type":"verse","number":27,"content":["ཐང་གི་ལྗོན་ཤིང་ལ་འབྲས་བུ་ཐོགས་ཤིང་ས་ལའང་ཐོན་རྫས་ཡོད་པས། དེ་དག་རང་ཡུལ་དུ་བདེ་བར་གནས་ཤིང་། ཡང་ངས་དེ་དག་གི་གཉའ་ཤིང་བཅག་སྟེ་བྲན་དུ་བཀོལ་བའི་མི་རྣམས་ཀྱི་ལག་ནས་དེ་རྣམས་སྐྱོབ་དུས་སུ། ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":28,"content":["དེ་དག་ཡང་བསྐྱར་མི་རྣམས་ཀྱི་བརྔོན་བྱ་རུ་མི་འགྱུར་ལ། ས་གཞིའི་གཅན་གཟན་རྣམས་ཀྱིས་ཀྱང་དེ་མི་བཟའ་བར། དེ་དག་བདེ་བར་གནས་ཤིང་། ཁོ་ཚོར་འཇིགས་སྐུལ་མཁན་སུ་ཡང་མེད་དོ། །"]},{"type":"verse","number":29,"content":["འདེབས་འཛུགས་ཀྱིས་མིང་དུ་གྲགས་པའི་གནས་ཤིག་ངས་ཁོ་ཚོའི་ཆེད་དུ་དར་བར་བྱ་ཞིང་། མུ་གེས་ཡུལ་ཁམས་ནང་རོལ་དུ་དེ་དག་ཡང་བསྐྱར་མེད་པར་མི་བཟོ་ལ། ཕྱིན་ཆད་མི་རྣམས་ཀྱི་ངོ་ཚ་ཡང་འཁུར་བར་མི་འགྱུར།"]},{"type":"verse","number":30,"content":["དེའི་དུས་སུ་ཁོ་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེ་ང་རང་ཁོ་ཚོ་དང་མཉམ་དུ་གནས་པ་རྟོགས་ཤིང་། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ནི་ངའི་མི་ཡིན་པའང་རྟོགས་པར་འགྱུར་རོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས། །"]},{"type":"verse","number":31,"content":["ཁྱོད་ཚོ་མི་རྣམས་ནི་ངའི་ལུག་ཁྱུ་སྟེ་ངའི་རྩྭ་ར་ནང་གི་ལུག་ཁྱུ་ཡིན་ལ། ང་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡིན་གསུངས་ཞེས་པའོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/33.json","previousChapterAudioLinks":{},"numberOfVerses":31}