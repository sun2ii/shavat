{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":38,"content":[{"type":"heading","content":["གཱོག་ལ་རྒོལ་བའི་ལུང་བསྟན།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་མ་གཱོག་ཡུལ་གྱི་གཱོག་ཅེས་པ་སྟེ། རའོ་ཤ་དང་མེ་ཤེག ཐུ་བཱལ་བཅས་ཀྱི་འགོ་དཔོན་",{"noteId":5},"ཕྱོགས་སུ་འཁོར་ནས་དེར་རྒོལ་བའི་ལུང་སྟོན་ཅིག"]},{"type":"verse","number":3,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་རའོ་ཤ་དང་མེ་ཤེག་དང་ཐུ་བཱལ་བཅས་ཀྱི་འགོ་དཔོན་གཱོག་",{"noteId":6},"ལགས། ལྟོས་དང་། ངས་ཁྱོད་ནི་དགྲ་རུ་འཛིན་ཞིང་།"]},{"type":"verse","number":4,"content":["ངས་ཁྱོད་བཟློགས་ཏེ་ཁྱོད་ཀྱི་འགྲམ་པ་གཉིས་ལ་ལྕགས་ཀྱུ་བརྒྱབ་ནས། ཁྱོད་དང་ཁྱོད་ཀྱི་དམག་དཔུང་དང་། རྟ་དང་རྟ་དམག་རྣམས་ཕྱི་རུ་ཁྲིད་འོང་ཞིང་། ཀུན་གྱིས་དམག་ཆས་ཆ་ཚང་གྱོན་པས་དཔུང་ཚོགས་ཆེན་པོ་ཞིག་ཏུ་གྱུར་ཏེ་ཕུབ་ཆེ་ཆུང་གཉིས་ཀ་ཡོད་པ་དང་། མི་རེ་རེའི་ལག་ཏུ་རལ་གྲི་བཟུང་ཡོད་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ད་དུང་ཏ་ཟིག་པ་དང་གུ་ཤ་པ། ཕུ༌ཏཱ་པ་བཅས་ཡོད་དེ། མི་རེ་རེའི་ལག་ཏུ་ཕུབ་ཐོགས་ཤིང་མགོ་ལ་རྨོག་ཞྭ་གྱོན་ཡོད་པ་ཡིན།"]},{"type":"verse","number":6,"content":["ཡང་གོ་མེར་པ་དང་དེའི་དམག་དཔུང་ཀུན་དང་། བྱང་ཕྱོགས་རྒྱང་རིང་ཡུལ་གྱི་པེད་ཐོ་གར་མཱའི་མི་རིགས་དང་དེའི་དམག་དཔུང་ཐམས་ཅད་དེ་རྒྱལ་ཁབ་མང་པོའི་མི་རྣམས་ཁྱོད་དང་མཉམ་དུ་ཡོད་དོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་དང་ཁྱོད་ཀྱི་མདུན་དུ་འདུས་པའི་དམག་དཔུང་ཀུན་པོས་སྟ་གོན་ལེགས་པོ་བྱེད་དགོས་ལ། ཁྱོད་རང་ཉིད་ཀྱིས་ཀྱང་སྟ་གོན་ལེགས་པོ་བྱས་ནས་ཁྱོད་ནི་དེ་དག་གི་དམག་དཔོན་བྱེད་དགོས།"]},{"type":"verse","number":8,"content":["ཉིན་མང་པོ་འགོར་རྗེས་ཁྱོད་ནི་གཡུལ་སར་མངགས་ཏེ། མ་འོངས་པའི་ལོ་ཟླའི་ནང་དུ་ཁྱོད་ཀྱིས་རལ་གྲི་ལས་ཐར་ཞིང་ཡུལ་ཁམས་སོ་སོ་ནས་ཕྱིར་བླངས་པའི་ཡུལ་ཏེ། ཡེས་ར་ཨེལ་གྱི་ཡུན་རིང་པོར་ས་སྟོང་དུ་ལུས་པའི་རི་ལ་འཐབ་ངེས་ཡིན། ཡིན་ནའང་རྒྱལ་ཁབ་སོ་སོ་ནས་བསྡུས་འོངས་པ་ཐམས་ཅད་དེའི་སྟེང་དུ་བདེ་བར་གནས་པའོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་དང་ཁྱོད་ཀྱི་དམག་དཔུང་ཀུན་པོ་ཁྱོད་དང་མཉམ་དུ་ཡོད་པའི་མི་རིགས་མང་པོ་དང་བཅས་རླུང་འཚུབ་བཞིན་ཡར་འོངས་ནས་སྤྲིན་ནག་བཞིན་ས་སྟེང་འགེབ་པར་འགྱུར་རོ། །"]},{"type":"heading","content":["གཱོག་གི་རྩུབ་སྤྱོད་དང་ཇུས་ངན།"]},{"type":"verse","number":10,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། དུས་དེར་ཁྱོད་ཀྱི་སེམས་སུ་ལྐོག་ཇུས་འདིང་བར་བསམ་ཞིང་ན་རེ།"]},{"type":"verse","number":11,"content":["ང་ཡར་ལྕགས་རི་མེད་པའི་གྲོང་སྡེ་ལ་རྒོལ་བར་འགྲོ་དགོས། ང་འོངས་ནས་ལྷིང་འཇགས་ངང་འཚོ་བའི་མི་ལ་རྒོལ་བར་བྱ། དེ་ཐམས་ཅད་བདེ་བར་སྡོད་ཅིང་ལྕགས་རི་མེད་ལ། སྒོ་གཏན་ཡང་མེད་དོ་ཞེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཁྱོད་ཀྱིས་རྒྱུ་ནོར་ཕྲོགས་ནས་དངོས་པོ་རྣམས་བཅོམ་ཏེ། སྔར་ས་སྟོང་དུ་གྱུར་པ་དང་ད་ལྟ་འདུག་མཁན་ཡོད་པའི་གནས་དེ་ལ་ལག་པ་བརྐྱངས་ནས་རྒོལ་བར་འགྱུར་ཞིང་། ཡུལ་ཁམས་སོ་སོ་ནས་བསྡུས་པ་དང་། ཕྱུགས་དང་རྒྱུ་ནོར་ཐོབ་ནས་ས་གཞིའི་ལྟེ་བར་གནས་པའི་མི་རྣམས་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":13,"content":["ཤེ་བཱ་པ་དང་དི་དན་པ། ཐཱར་ཞིས་ཀྱི་ཚོང་པ། ཐཱར་ཞིས་ཀྱི་འགོ་དཔོན་བཅས་ཀྱིས་ཁྱོད་ལ། ཁྱོད་ནི་རྒྱུ་ནོར་འཕྲོག་ཏུ་འོངས་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་དམག་དཔུང་བསྡུས་པ་ནི་དངོས་པོ་རྣམས་འཕྲོག་བཅོམ་བྱེད་པ་དང་། གསེར་དངུལ་འཁྱེར་བ། ཕྱུགས་དང་ནོར་རྫས་འཕྲོག་པ། འཕྲོག་བཅོམ་ཆེན་པོ་ཞིག་བྱེད་པའི་ཆེད་དུ་ཡིན་ནམ་ཞེས་འདྲི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":14,"content":["དེ་བས། ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་གཱོག་ལ་འདི་ལྟར་ལུང་སྟོན་ཅིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངའི་འབངས་མི་ཡེས་ར་ཨེལ་བདེ་བར་སྡོད་པའི་ཉིན་དེ་སླེབས་ཚེ་ཁྱོད་ཀྱིས་གཟབ་གཟབ་མི་བྱའམ།"]},{"type":"verse","number":15,"content":["ཁྱོད་ནི་རང་གི་ཡུལ་ཏེ་བྱང་ཕྱོགས་ཀྱི་ས་མཐའ་ནས་མི་རིགས་མང་པོ་དང་མཉམ་དུ་འོང་བ་སྟེ། ཐམས་ཅད་རྟ་ལ་ཞོན་ནས་སྟོབས་ཤུགས་ཅན་གྱི་དམག་དཔུང་ཆེན་པོ་ཞིག་ཏུ་འགྱུར་ཞིང་།"]},{"type":"verse","number":16,"content":["ཡུལ་དེར་སྤྲིན་ནག་འཐིབས་པ་བཞིན་དུ། ཁྱོད་ཡར་འོངས་ཏེ་ངའི་འབངས་མི་ཡེས་ར་ཨེལ་ལ་རྒོལ་བར་འགྱུར། ཀྱེ་གཱོག་ལགས། ང་རང་ཁྱོད་བརྒྱུད་དེ་ཁོ་ཚོར་དམ་པར་མངོན་པའི་དུས་སུ་དེ་དག་གིས་བདག་ངོ་ཤེས་པའི་ཆེད་དུ། མཐའ་མའི་ཉིན་མོ་དག་ལ་ངས་ཁྱོད་ཁྲིད་འོངས་ནས་ངའི་ཡུལ་ལ་རྒོལ་བར་འཇུག་གོ །"]},{"type":"verse","number":17,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་སྔར་རང་གི་ཞབས་ཕྱི་སྟེ་ཡེས་ར་ཨེལ་གྱི་ལུང་སྟོན་པ་རྣམས་བརྒྱུད་ནས་སྨྲས་པའི་མི་དེ་ནི་ཁྱོད་རང་མ་ཡིན་ནམ། ལོ་དེ་དག་གི་ནང་དུ། ངས་ཁྱོད་ཁྲིད་འོངས་ཏེ་ཡེས་ར་ཨེལ་ལ་རྒོལ་ངེས་ཡིན་ཞེས་ཁོ་ཚོས་ལུང་བསྟན་པ་དང་།"]},{"type":"verse","number":18,"content":["གཱོག་ནི་ཡེས་ར་ཨེལ་ལ་རྒོལ་དུ་འོང་བའི་དུས་སུ། ངའི་ཁོང་ཁྲོ་ནི་རང་གི་གདོང་ནས་ཕྱིར་མངོན་པར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":19,"content":["ངས་ཞེ་སྡང་དང་ཁོང་ཁྲོའི་ངང་ནས་འདི་སྐད་དུ། ཉིན་དེར་སླེབས་ཚེ་ཡེས་ར་ཨེལ་ལ་ས་འགུལ་ཆེན་པོ་ཞིག་འབྱུང་ཞིང་།"]},{"type":"verse","number":20,"content":["རྒྱ་མཚོ་ནང་གི་ཉ་དང་། ནམ་མཁའི་བྱ་དང་། ཐང་གི་རི་དྭགས་དང་། ས་ཡི་ལྟོ་འགྲོ་འབུ་སྲིན་སྣ་ཚོགས་དང་། ད་དུང་ས་གཞི་སྟེང་གི་མི་ཐམས་ཅད་ངའི་མདུན་དུ་འདར་ཞིང་། རི་རྣམས་བསྙིལ་ནས་བྲག་གཟར་རྣམས་བརྡིབ་ཅིང་། རྩིག་པ་ཐམས་ཅད་སར་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":21,"content":["ངས་རལ་གྲིར་བསྐུལ་ནས་ངའི་རི་རྣམས་ཀྱི་སྟེང་དུ་གཱོག་ལ་རྒོལ་བར་འགྱུར་ཞིང་། མི་རེ་རེའི་རལ་གྲིས་རང་གི་སྤུན་ཟླར་རྒོལ་བར་འགྱུར་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":22,"content":["ཡང་ངས་རིམས་ནད་དང་ཁྲག་གི་སྒོ་ནས་དེ་ལ་ཉེས་ཆད་གཅོད་ཅིང་། ངས་དྲག་ཆར་དང་སེར་བ་ཆེན་པོ་དང་། མེ་དང་མུ་ཟི་ནི་དེ་དང་དེའི་དམག་དཔུང་དང་། ད་དུང་དེ་དང་མཉམ་དུ་ཡོད་པའི་མི་རིགས་རྣམས་ཀྱི་སྟེང་དུ་འབབ་བར་བྱ་སྟེ།"]},{"type":"verse","number":23,"content":["ངས་རང་ཉིད་ཆེན་པོ་དང་དམ་པར་མངོན་ཞིང་། མི་རིགས་མང་པོའི་མདུན་དུ་རང་ཉིད་མངོན་པར་འགྱུར་ལ། དེ་ནས་ཁོ་ཚོས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་ཞེས་པའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"དམ་པའི་གསུང་རབ་ཀྱི་མཁས་པ་རྣམས་ཀྱི་བཞེད་ཚུལ་ལྟར་ན། ཚིག་རྐང་འདིའི་རའོ་ཤ་དང་མེ་ཤེག ཐུ་བཱལ་བཅས་ཀྱི་འགོ་དཔོན་ཞེས་པའི་ཚན་པ་འདིར་མེ་ཤེག་དང་ཐུ་བཱལ་གཉིས་ཀྱི་གཙོ་བདག་ཅེས་ཀྱང་གོ་རུང་བ་ཡིན།","reference":{"chapter":38,"verse":2}},{"noteId":6,"caller":"+","text":"གཱོག་ཅེས་པ་ནི་ཆེས་མཐའ་མའི་ཁྲིམས་གཅོད་སྔོན་གྱི་འཐབ་འཁྲུག་གི་དམག་དཔུང་ངན་པའི་འགོ་དཔོན་ཡིན། མངོན་པའི་ལེའུ་ཉི་ཤུ་ཡི་ཚིག་རྐང་བདུན་ནས་བཅུ་ཡི་བར་དུ་གཟིགས་རོགས།","reference":{"chapter":38,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/EZK/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}