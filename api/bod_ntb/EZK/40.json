{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":40,"content":[{"type":"heading","content":["མཆོད་ཁང་འཇལ་བྱའི་ཞལ་གཟིགས།"]},{"type":"verse","number":1,"content":["ངེད་རྣམས་བཙོན་དུ་ཁྲིད་པའི་ལོ་ཉེར་ལྔ་པ་སྟེ། ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་གཏོར་བའི་ལོ་བཅུ་བཞི་པའི་ལོ་འགོ་ཡི་ཟླ་དེའི་ཚེས་བཅུ་ཡི་ཉིན་མོར། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ནི་ངའི་སྟེང་དུ་བཞག་སྟེ། ཁོང་གིས་ང་གནས་དེར་ཁྲིད་པ་དང་།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་གི་ཞལ་གཟིགས་ཀྱི་ནང་དུ། ཁོང་གིས་ང་ཡེས་ར་ཨེལ་གྱི་ཡུལ་དུ་ཁྲིད་ནས་ང་རང་རི་ཤིན་ཏུ་མཐོན་པོ་ཞིག་གི་སྟེང་དུ་བཞག་པ་དང་། རི་བོའི་ལྷོ་ཕྱོགས་སུ་གྲོང་ཁྱེར་ལྟ་བུའི་བཟོ་བཀོད་ཅིག་ཡོད་དོ། །"]},{"type":"verse","number":3,"content":["ཁོང་གིས་ང་དེ་རུ་ཁྲིད་པ་དང་ངས་མི་ཞིག་མཐོང་སྟེ། དེར་བལྟས་ཚེ་ལི་ཡི་མདངས་ལྡན་ཞིང་ལག་ཏུ་སོ་ཐག་དང་ཚད་ཐིག་ལེན་བྱེད་ལྕུག་མ་ཞིག་བཟུང་སྟེ་རྒྱ་སྒོ་ཁར་ལངས་ནས་བསྡད་ཡོད།"]},{"type":"verse","number":4,"content":["མི་དེས་ང་ལ་འདི་ལྟར། ཀྱེ་མིའི་བུ། ངས་ཁྱོད་བསྟན་པ་རྣམས་ལ་ཁྱོད་ཀྱིས་མིག་གིས་ལྟོས་དང་། རྣ་བས་ཉོན་ཅིག ཡིད་ལ་ཟུངས་ཤིག གང་ལ་ཞེ་ན། ཁྱོད་ལ་སྟོན་པའི་ཆེད་དུ་ངས་ཁྱོད་གནས་འདིར་ཁྲིད་འོངས་པ་དང་། ཁྱོད་ཀྱིས་ཅི་མཐོང་བ་ཐམས་ཅད་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་སྨྲ་དགོས་ཞེས་བསྒོས་སོ། །"]},{"type":"heading","content":["མཆོད་ཁང་ཕྱི་རོལ་གྱི་རྩིག་པ།"]},{"type":"verse","number":5,"content":["དེ་ནས་ངས་མཆོད་ཁང་གི་ཕྱོགས་བཞི་རུ་མཁར་ཡོད་པ་མཐོང་སྟེ། མི་དེའི་ལག་གི་ཚད་ཐིག་ལེན་བྱེད་ལྕུག་མའི་རིང་ཚད་ལ་ཁྲུ་དྲུག་ཡོད་ལ། ཁྲུ་རེ་ནི་ཁྲུ་གང་དང་སོར་བཞི་ཡིན། ཁོས་བཟོ་བཀོད་དེའི་ཚད་ཐིག་བླངས་པ་ན་མཁར་གྱི་མཐུག་ཚད་ལ་ལྕུག་མ་གཅིག་དང་། མཐོ་ཚད་ལའང་ལྕུག་མ་གཅིག་ཡོད་དོ། །"]},{"type":"verse","number":6,"content":["ཡང་མི་དེ་ཤར་ཕྱོགས་ཀྱི་རྒྱ་སྒོར་ཕྱིན་ནས་དེའི་རྡོ་སྐས་ལ་འཛེགས་ཏེ། སྒོ་ཐེམ་གྱི་ཚད་ཐིག་བླངས་པ་ན་མཐུག་ཚད་ལ་ལྕུག་མ་གཅིག་དང་། ཡང་སྒོ་ཐེམ་ཅིག་ཤོས་དེའི་མཐུག་ཚད་ལའང་ལྕུག་མ་གཅིག་ཡོད་པ་ཡིན།"]},{"type":"verse","number":7,"content":["ཡང་སྒོ་ཁང་ཡོད་དེ། རིང་ཚད་ལ་ལྕུག་མ་གཅིག་དང་། ཞེང་ལ་ལྕུག་མ་གཅིག་ཡོད་ཅིང་། སྒོ་ཁང་དང་ཁང་པའི་བར་ཐག་ལ་ཁྲུ་ལྔ་ཡོད་པ་དང་། མཆོད་ཁང་གི་ནང་ཕྱོགས་སུ་འཁོར་བའི་སྒོ་ཁྱམས་འགྲམ་གྱི་སྒོ་ཐེམ་གྱི་མཐུག་ཚད་ལ་ལྕུག་མ་གཅིག་ཡོད་དོ། །"]},{"type":"verse","number":8,"content":["ཡང་དེས་མཆོད་ཁང་གི་ནང་ཕྱོགས་སུ་འཁོར་བའི་སྒོ་ཁྱམས་ཀྱི་ཚད་ཐིག་བླངས་པ་ལ་དེའི་རིང་ཚད་ལྕུག་མ་གཅིག་ཡིན།"]},{"type":"verse","number":9,"content":["སྒོ་ཁྱམས་དེའི་གཏིང་ཚད་ལ་ཁྲུ་བརྒྱད་ཡོད་པ་དང་། སྒོ་སྒྲོམ་གྱི་མཐུག་ཚད་ལ་ཁྲུ་གཉིས་ཡོད་དེ། སྒོ་ཁྱམས་ནི་མཆོད་ཁང་གི་ནང་ཕྱོགས་སུ་འཁོར་ཡོད་དོ། །"]},{"type":"verse","number":10,"content":["ཤར་སྒོའི་ཁང་པ་རྣམས་གཡས་ཕྱོགས་སུ་གསུམ་དང་གཡོན་ཕྱོགས་སུ་གསུམ་ཡོད་ལ། ཁང་མིག་གསུམ་པོའི་རིང་ཚད་དང་ཞེང་གི་ཆེ་ཆུང་གཉིས་ཀ་གཅིག་ཡིན་ལ། འགྲམ་གཉིས་ཀྱི་སྒོ་སྒྲོམ་གྱི་མཐུག་ཚད་ཀྱང་གཅིག་ཡིན།"]},{"type":"verse","number":11,"content":["དེས་ཤར་སྒོའི་ཚད་ཐིག་བླངས་པ་ན། འཇུག་སྒོའི་ཞེང་ལ་ཁྲུ་བཅུ་ཡོད་པ་དང་། རྒྱུ་ལམ་གྱི་རིང་ཚད་ལ་ཁྲུ་བཅུ་གསུམ་ཡོད།"]},{"type":"verse","number":12,"content":["སྒོ་ཁང་རེ་རེའི་མདུན་དུ་རྩིག་པ་དམའ་མོ་རེ་ཡོད་དེ། མཐོ་ཚད་ལ་ཁྲུ་གཅིག་ཡོད་པ་ཡིན། ཕྱོགས་གཉིས་ཀྱི་ཁང་མིག་གཉིས་ཀྱང་གཅིག་མཚུངས་ཡིན་ནོ། །ཁང་པ་དེའི་རིང་ཚད་ལ་ཁྲུ་དྲུག་ཡོད་པ་དང་། ཕྱོགས་གཉིས་ནི་གཅིག་མཚུངས་ཡིན།"]},{"type":"verse","number":13,"content":["དེས་ཤར་སྒོའི་ཚད་ཐིག་བླངས་པ་དང་། ཁང་པ་འདིའི་ལྟག་སྒོ་ནས་ཁ་གཏད་ཀྱི་ཁང་པ་གཞན་དེའི་ལྟག་སྒོ་སྟེ། ཁང་ཀླད་འདི་ནས་ཁང་ཀླད་གཞན་དེའི་བར་གྱི་ཚད་ཐིག་བླངས་པ་ན་ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད་དོ། །"]},{"type":"verse","number":14,"content":["ནང་གི་སྒོ་སྒྲོམ་རེ་རེ་བརྒྱུད་ནས་ཁྱམས་རའི་ཕྱོགས་ཀྱི་སྒོ་སྒྲོམ་གྱི་བར་དུ་ཚད་ཐིག་བླངས་པ་ན། རིང་ཚད་ལ་བསྡོམས་པས་ཁྲུ་དྲུག་ཅུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":15,"content":["ཤར་སྒོའི་མདུན་གྱི་འཇུག་སྒོ་ནས་རྒྱབ་ཀྱི་སྒོ་ཁྱམས་བར་དུ་ཁྲུ་ལྔ་བཅུ་ཡོད།"]},{"type":"verse","number":16,"content":["སྒོ་ཁང་གི་ཤར་སྒོའི་ནང་ཕྱོགས་ཀྱི་སྒོ་སྒྲོམ་དང་། སྒོ་ཁྱམས་བཅས་ལ་སྒེའུ་ཁུང་དོག་མོ་རྣམས་ཡོད་དེ། ནང་གི་ཕྱོགས་བཞི་རུའང་སྒེའུ་ཁུང་ཡོད་ལ་རྩིག་པའི་སྟེང་དུ་ཤིང་ཏ་ལ་བརྐོས་ཡོད་དོ། །"]},{"type":"heading","content":["ཁྱམས་ར་ཕྱི་མ།"]},{"type":"verse","number":17,"content":["དེ་ནས་དེས་ང་ཁྱམས་ར་ཕྱི་མར་ཁྲིད་པ་དང་ངས་ཁང་པ་འགའ་ཡོད་པ་མཐོང་སྟེ། ཁྱམས་རའི་ཕྱོགས་བཞིའི་ས་རུ་རྡོ་གཅལ་ཡོད་པ་དང་། དེའི་འགྲམ་དུ་ཁང་པ་སུམ་ཅུ་ཡོད་དོ། །"]},{"type":"verse","number":18,"content":["རྡོ་གཅལ་ནི་རྒྱ་སྒོ་རེ་རེའི་འགྲམ་དུ་ཡོད་ཅིང་སྒོ་ལས་ཅུང་དམའ་ཞིང་། ཞེང་ནི་རྒྱ་སྒོའི་རིང་ཚད་དང་གཅིག་ཡིན།"]},{"type":"verse","number":19,"content":["དེས་འོག་གི་རྒྱ་སྒོ་ནས་ནང་གི་ཁྱམས་རའི་རྩིག་པའི་བར་དུ་ཚད་ཐིག་བླངས་པ་ན་ཞེང་ལ་བསྡོམས་པས་ཁྲུ་བརྒྱ་ཡོད་དེ། ཤར་ཕྱོགས་དང་བྱང་ཕྱོགས་ཐམས་ཅད་གཅིག་ཡིན་ནོ། །"]},{"type":"heading","content":["བྱང་སྒོ་ཕྱི་མ།"]},{"type":"verse","number":20,"content":["ཡང་དེས་ཁྱམས་ར་ཕྱི་མའི་བྱང་ལ་འཁོར་ཡོད་པའི་རྒྱ་སྒོའི་རིང་ཚད་དང་ཞེང་གི་ཆེ་ཆུང་གཉིས་ཀྱི་ཚད་ཐིག་བླངས་པ་ན།"]},{"type":"verse","number":21,"content":["ནང་གི་ཁང་པ་རྣམས་གཡས་སུ་གསུམ་དང་གཡོན་དུ་གསུམ་ཡོད་དེ། སྒོ་སྒྲོམ་དང་སྒོ་ཁྱམས་ཀྱི་རིང་ཐུང་ནི་ཤར་སྒོ་དང་གཅིག་མཚུངས་ཡིན་ཏེ། བྱང་སྒོ་སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་དང་ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":22,"content":["དེའི་སྒེའུ་ཁུང་དང་སྒོ་ཁྱམས། ཤིང་ཏ་ལའི་བརྐོས་རིས་བཅས་ནི་ཤར་སྒོ་དང་གཅིག་མཚུངས་ཡིན་ལ། མི་རྣམས་རྡོ་སྐས་རིམ་པ་བདུན་ལ་འཛེགས་ན་ད་གཟོད་རྒྱ་སྒོ་འདིར་སླེབ་ཐུབ་པ་དང་། མདུན་གྱི་མུ་མཐའ་རུ་སྒོ་ཁྱམས་ཡིན།"]},{"type":"verse","number":23,"content":["ནང་གི་ཁྱམས་རར་རྒྱ་སྒོ་ཞིག་རྒྱ་སྒོ་འདིའི་ཁ་གཏད་དུ་ཡོད་པ་དང་། བྱང་ཕྱོགས་དང་ཤར་ཕྱོགས་ཐམས་ཅད་གཅིག་མཚུངས་ཡིན། དེས་རྒྱ་སྒོ་འདི་ནས་རྒྱ་སྒོ་གཞན་དེའི་བར་དུ་ཚད་ཐིག་བླངས་པ་ན་བསྡོམས་པས་ཁྲུ་བརྒྱ་ཡོད་དོ། །"]},{"type":"heading","content":["ལྷོ་སྒོ་ཕྱི་མ།"]},{"type":"verse","number":24,"content":["ཡང་དེས་ང་ལྷོ་ཕྱོགས་སུ་ཁྲིད་པ་དང་ངས་ལྷོ་ཕྱོགས་སུ་འཁོར་བའི་རྒྱ་སྒོ་དེ་མཐོང་ཞིང་། དེས་སྒོ་སྒྲོམ་དང་སྒོ་ཁྱམས་གཉིས་ཀྱི་ཚད་ཐིག་བླངས་པ་ན་ཆེ་ཆུང་སྔར་དང་འདྲའོ། །"]},{"type":"verse","number":25,"content":["རྒྱ་སྒོའི་ནང་ཕྱོགས་དང་སྒོ་ཁྱམས་ཀྱི་མཐའ་སྐོར་ཀུན་ཏུ་སྒེའུ་ཁུང་ཡོད་པ་དང་། དེ་ཡང་སྔར་གྱི་སྒེའུ་ཁུང་དང་གཅིག་ཡིན་ནོ། །ལྷོ་སྒོ་སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":26,"content":["མི་རྣམས་རྡོ་སྐས་རིམ་པ་བདུན་ལ་འཛེགས་ན་ད་གཟོད་རྒྱ་སྒོ་འདིར་སླེབ་ཐུབ་པ་དང་། མདུན་གྱི་མུ་མཐའ་རུ་སྒོ་ཁྱམས་ཡིན། སྒོ་སྒྲོམ་གྱི་སྟེང་དུ་ཕྱོགས་གཉིས་སུ་ཤིང་ཏ་ལ་བརྐོས་ཡོད་པ་ཡིན།"]},{"type":"verse","number":27,"content":["ནང་གི་ཁྱམས་རའི་ལྷོ་ཕྱོགས་སུ་ཡང་རྒྱ་སྒོ་ཡོད་པ་དང་། དེས་རྒྱ་སྒོ་འདི་ནས་ལྷོ་སྒོའི་བར་དུ་ཚད་ཐིག་བླངས་པ་ན་བསྡོམས་པས་ཁྲུ་བརྒྱ་ཡོད་དོ། །"]},{"type":"heading","content":["ནང་གི་ཁྱམས་ར།"]},{"type":"verse","number":28,"content":["དེས་ང་ནང་གི་ཁྱམས་རའི་ལྷོ་སྒོ་ནས་ནང་གི་ཁྱམས་རར་ཁྲིད་དེ། རྒྱ་སྒོ་དེའི་ཚད་ཐིག་བླངས་པ་ན་ཆེ་ཆུང་སྔར་དང་མཚུངས་སོ། །"]},{"type":"verse","number":29,"content":["སྒོ་ཁང་དང་སྒོ་སྒྲོམ། སྒོ་ཁྱམས་བཅས་ཀྱི་རིང་ཐུང་ནི་སྔར་དང་གཅིག་ཡིན་ལ། རྒྱ་སྒོའི་ནང་ཕྱོགས་དང་སྒོ་ཁྱམས་ཀྱི་མཐའ་སྐོར་ཀུན་ཏུ་སྒེའུ་ཁུང་ཡོད་པ་དང་། རྒྱ་སྒོའི་ནང་ཕྱོགས་ཀྱི་སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":30,"content":["ཁྱམས་རའི་མཐའ་སྐོར་དུ་སྒོ་ཁྱམས་ཡོད་དེ། སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":31,"content":["སྒོ་ཁྱམས་དེ་ཁྱམས་ར་ཕྱི་མའི་ཕྱོགས་སུ་འཁོར་ཡོད་དེ། སྒོ་སྒྲོམ་གྱི་སྟེང་དུ་ཤིང་ཏ་ལ་བརྐོས་ཡོད་པ་དང་། རྡོ་སྐས་ལ་རིམ་པ་བརྒྱད་ཡོད་དོ། །"]},{"type":"verse","number":32,"content":["དེས་ང་ནང་གི་ཁྱམས་རའི་ཤར་སྒོ་རུ་ཁྲིད་ནས་རྒྱ་སྒོ་དེའི་ཚད་ཐིག་བླངས་པ་ན་ཆེ་ཆུང་སྔར་དང་མཚུངས་པ་ཡིན།"]},{"type":"verse","number":33,"content":["སྒོ་ཁང་དང་སྒོ་སྒྲོམ། སྒོ་ཁྱམས་བཅས་ཀྱི་རིང་ཐུང་ནི་སྔར་དང་གཅིག་ཡིན་ལ། རྒྱ་སྒོའི་ནང་ཕྱོགས་དང་སྒོ་ཁྱམས་ཀྱི་མཐའ་སྐོར་ཀུན་ཏུ་སྒེའུ་ཁུང་ཡོད་པ་དང་། རྒྱ་སྒོའི་ནང་ཕྱོགས་ཀྱི་སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":34,"content":["སྒོ་ཁྱམས་དེ་ཁྱམས་ར་ཕྱི་མའི་ཕྱོགས་སུ་འཁོར་ཡོད་དེ། སྒོ་སྒྲོམ་གྱི་སྟེང་དུ་ཕྱོགས་གཉིས་སུ་ཤིང་ཏ་ལ་བརྐོས་ཡོད་པ་དང་། རྡོ་སྐས་ལ་རིམ་པ་བརྒྱད་ཡོད་དོ། །"]},{"type":"verse","number":35,"content":["དེས་ང་ནང་གི་ཁྱམས་རའི་བྱང་སྒོ་རུ་ཁྲིད་ནས་རྒྱ་སྒོ་དེའི་ཚད་ཐིག་བླངས་པ་ན་ཆེ་ཆུང་སྔར་དང་མཚུངས་སོ། །"]},{"type":"verse","number":36,"content":["སྒོ་ཁང་དང་སྒོ་སྒྲོམ། སྒོ་ཁྱམས་བཅས་ཐམས་ཅད་གཅིག་མཚུངས་ཡིན་ལ། རྒྱ་སྒོའི་ནང་ཕྱོགས་དང་མཐའ་སྐོར་ཀུན་ཏུ་སྒེའུ་ཁུང་ཡོད། རྒྱ་སྒོ་དེ་ཡི་སྤྱིའི་རིང་ཚད་ལ་ཁྲུ་ལྔ་བཅུ་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཉེར་ལྔ་ཡོད།"]},{"type":"verse","number":37,"content":["སྒོ་ཁྱམས་དེ་ཁྱམས་ར་ཕྱི་མའི་ཕྱོགས་སུ་འཁོར་ཡོད་དེ། སྒོ་སྒྲོམ་གྱི་སྟེང་དུ་ཕྱོགས་གཉིས་སུ་ཤིང་ཏ་ལ་བརྐོས་ཡོད་པ་དང་། རྡོ་སྐས་ལ་རིམ་པ་བརྒྱད་ཡོད་དོ། །"]},{"type":"verse","number":38,"content":["ཡང་རྒྱ་སྒོ་རྣམས་ཀྱི་སྒོ་སྒྲོམ་གྱི་འགྲམ་དུ་ཁང་པ་སྒོ་ཅན་ཞིག་ཡོད་པ་དང་། དེ་ནི་སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་བཀྲུ་ས་ཡིན།"]},{"type":"verse","number":39,"content":["སྒོ་ཁྱམས་ཀྱི་ནང་དུ་གཡས་ཕྱོགས་སུ་ཅོག་ཙེ་གཉིས་དང་གཡོན་ཕྱོགས་སུ་ཅོག་ཙེ་གཉིས་ཡོད་པ་དང་། དེའི་སྟེང་དུ་སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་དང་སྡིག་བཤགས་མཆོད་པར་འབུལ་བའི་ཕྱུགས་ཟོག ཉེས་སེལ་གྱི་མཆོད་པར་འབུལ་བའི་ཕྱུགས་ཟོག་རྣམས་ཀྱང་བཤས་ཆོག་པ་ཡིན།"]},{"type":"verse","number":40,"content":["བྱང་སྒོ་ལ་འཇུག་པའི་རྡོ་སྐས་ཀྱི་ཕྱི་ཕྱོགས་སུ་འཁོར་བའི་གནས་སུ་ཅོག་ཙེ་གཉིས་ཡོད་པ་དང་། སྒོ་ཁྱམས་ཀྱི་ཕྱོགས་སུ་འཁོར་བའི་གནས་གཞན་དེ་རུ་ཡང་ཅོག་ཙེ་གཉིས་ཡོད།"]},{"type":"verse","number":41,"content":["ཕྱུགས་ཟོག་བཤའ་བའི་ཕྱིར་དུ་རྒྱ་སྒོའི་གཡས་ཕྱོགས་སུ་ཅོག་ཙེ་བཞི་དང་། གཡོན་ཕྱོགས་སུའང་ཅོག་ཙེ་བཞི་སྟེ་བསྡོམས་པས་ཅོག་ཙེ་བརྒྱད་ཡོད།"]},{"type":"verse","number":42,"content":["གཞན་ཡང་ཅོག་ཙེ་བཞི་ཡོད་པ་ནི་སྦྱིན་སྲེག་གི་མཆོད་པ་འབུལ་བའི་ཕྱིར་ཡིན་པ་དང་། དེ་ནི་རྡོ་བརྐོས་མས་བཟོས་ཏེ། རིང་ཚད་ལ་ཁྲུ་གཅིག་དང་ཕྱེད་ཀ་དང་། ཞེང་ལ་ཁྲུ་གཅིག་དང་ཕྱེད་ཀ མཐོ་ཚད་ལ་ཁྲུ་གཅིག་བཅས་ཡོད་པ་དང་། སྤྱིན་སྲེག་གི་ཕྱུགས་ཟོག་དང་མཆོད་པ་གཞན་པའི་ཕྱུགས་ཟོག་རྣམས་བཤའ་དུས་སྤྱོད་པའི་སྣོད་ཆས་རྣམས་དེར་བཞག་ཡོད་དོ། །"]},{"type":"verse","number":43,"content":["ཕྱོགས་བཞིའི་རྩིག་ངོས་སུ་ལྕགས་ཀྱུ་རྣམས་བརྡབས་ཡོད་པ་དང་དེ་རེ་རེའི་རིང་ཚད་སོར་བཞི་ཡིན། ཡང་ཅོག་ཙེའི་སྟེང་དུ་མཆོད་པར་འབུལ་བྱའི་ཤ་རྣམས་བཞག་ཡོད་པ་ཡིན།"]},{"type":"heading","content":["མཆོད་དཔོན་གྱི་ཁང་པ།"]},{"type":"verse","number":44,"content":["ནང་གི་ཁྱམས་རའི་རྒྱ་སྒོ་ཡི་ཕྱི་རོལ་ཏུ་མགུར་ལེན་མཁན་གྱི་ཁང་པ་གཉིས་ཡོད་དེ། གཅིག་ནི་བྱང་སྒོའི་འགྲམ་དུ་ལྷོ་ཕྱོགས་སུ་འཁོར་ཡོད་པ་དང་། ཅིག་ཤོས་ནི་ཤར་སྒོའི་འགྲམ་དུ་བྱང་ཕྱོགས་སུ་འཁོར་ཡོད།"]},{"type":"verse","number":45,"content":["དེ་ནས་ཁོས་ང་ལ་འདི་ལྟར། ལྷོ་ཕྱོགས་སུ་འཁོར་བའི་ཁང་པ་འདི་ནི་མཆོད་ཁང་གི་ལས་འགན་ཁུར་བའི་མཆོད་དཔོན་རྣམས་ཀྱི་ཆེད་དུ་བཀོད་པ་ཡིན་ལ།"]},{"type":"verse","number":46,"content":["བྱང་ཕྱོགས་སུ་འཁོར་བའི་ཁང་པ་དེ་ནི་མཆོད་ཁྲིའི་ལས་འགན་ཁུར་བའི་མཆོད་དཔོན་རྣམས་ཀྱི་ཆེད་དུ་བཀོད་པ་ཡིན་ཏེ། མཆོད་དཔོན་འདི་ཐམས་ཅད་ནི་ཟཱ་ཏོག་གི་བུ་རྒྱུད་ཡིན་པ་དང་། ལེ་ཝི་པའི་ཁྲོད་ནས་ཁོ་ཚོ་འབའ་ཞིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཞབས་ཕྱི་བསྒྲུབ་ཆོག་པ་ཡིན་ཞེས་ཟེར།"]},{"type":"verse","number":47,"content":["ཡང་དེས་ནང་གི་ཁྱམས་རའི་ཚད་ཐིག་བླངས་པ་ན་རིང་ཚད་ལ་ཁྲུ་བརྒྱ་དང་། ཞེང་ལ་ཁྲུ་བརྒྱ་ཡོད་པའི་གྲུ་བཞི་ཅན་ཞིག་ཡིན་པ་དང་། མཆོད་ཁྲི་ནི་མཆོད་ཁང་གི་མདུན་དུ་ཡོད།"]},{"type":"heading","content":["མཆོད་ཁང་གི་སྒོ་ཁྱམས།"]},{"type":"verse","number":48,"content":["དེ་ནས་ཁོས་ང་མཆོད་ཁང་གི་སྒོ་ཁྱམས་སུ་ཁྲིད་དེ། སྒོ་ཁྱམས་ཀྱི་སྒོ་སྒྲོམ་གྱི་ཚད་ཐིག་བླངས་པ་ན་གཡས་ཀྱི་མཐུག་ཚད་ལ་ཁྲུ་ལྔ་དང་། གཡོན་གྱི་མཐུག་ཚད་ལའང་ཁྲུ་ལྔ་ཡོད་པ་ཡིན། སྒོ་ཁའི་ཞེང་ལ་ཁྲུ་བཅུ་བཞི་དང་། རྒྱ་སྒོ་ནང་རོལ་གྱི་རྩིག་པར་",{"noteId":7},"གཡས་སུ་ཁྲུ་གསུམ་དང་གཡོན་ལ་ཁྲུ་གསུམ་ཡོད་དོ། །"]},{"type":"verse","number":49,"content":["ཡང་སྒོ་ཁྱམས་ཀྱི་རིང་ཚད་ལ་ཁྲུ་ཉི་ཤུ་དང་། ཞེང་ལ་ཁྲུ་བཅུ་གཅིག་ཡོད་ཅིང་། མི་རྣམས་རྡོ་སྐས་ལ་འཛེགས་ན་ད་གཟོད་སྒོ་ཁྱམས་སུ་སླེབ་ཐུབ་པ་དང་། སྒོ་སྒྲོམ་གྱི་འགྲམ་དུ་ཡང་ཀ་བ་གཉིས་ཕྱོགས་གཉིས་སུ་ཡོད་དོ། །"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འདིར་རྒྱ་སྒོ་ནང་རོལ་གྱི་རྩིག་པ་ཞེས་པར་མ་ཕྱི་ལས་རྒྱ་སྒོའི་ཞེང་ལ་གཡས་སུ་ཁྲུ་གསུམ་དང་གཡོན་ལ་ཁྲུ་གསུམ་ཡོད་ཅེས་མཐོང་།","reference":{"chapter":40,"verse":48}}]},"thisChapterLink":"/api/bod_ntb/EZK/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/39.json","previousChapterAudioLinks":{},"numberOfVerses":49}