{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":43,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་མཆོད་ཁང་ནང་དུ་ཁེངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཁོས་ང་ཤར་ཕྱོགས་སུ་འཁོར་བའི་རྒྱ་སྒོ་ཡོད་སར་ཁྲིད་པ་ན།"]},{"type":"verse","number":2,"content":["ལྟོས་དང་། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་གཟི་བརྗིད་དེ་ཤར་ཕྱོགས་ནས་འོངས་ཏེ། ཁོང་གི་གསུང་སྐད་ནི་ཆུ་ལོག་གི་འུར་སྒྲ་དང་འདྲ་ཞིང་། ཁོང་གི་གཟི་བརྗིད་ཀྱི་དབང་གིས་ས་གཞི་ལས་འོད་འཕྲོས་པའོ། །"]},{"type":"verse","number":3,"content":["ངས་མཐོང་བའི་ཞལ་གཟིགས་དེ་ནི་ཁོང་ཉིད་གྲོང་ཁྱེར་དེ་མེད་པར་བཟོ་བར་ཕེབས་དུས་སུ་མཐོང་བའི་ཞལ་གཟིགས་དང་མཚུངས་ལ། ཡང་ངས་ཀེ་བར་གཙང་པོའི་འགྲམ་དུ་མཐོང་བའི་ཞལ་གཟིགས་དང་འདྲ་བས་ང་ལུས་སར་བཏུད་ནས་བསྡད།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ནི་ཤར་ཕྱོགས་སུ་འཁོར་བའི་རྒྱ་སྒོ་ལས་མཆོད་ཁང་གི་ནང་དུ་ཕེབས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཐུགས་ཉིད་ཀྱིས་ང་ཡར་བཀྱགས་ཏེ་ང་རང་ནང་གི་ཁྱམས་རར་ཁྲིད་པ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ནི་མཆོད་ཁང་ནང་དུ་ཁེངས་ཡོད་པ་ངས་མཐོང་ངོ་། །"]},{"type":"verse","number":6,"content":["མི་དེ་ངའི་གམ་དུ་ལངས་སྡོད་པའི་སྐབས་སུ། གཙོ་བོས་མཆོད་ཁང་ནས་ང་ལ་བཀའ་གནང་བ་ངས་ཐོས་བྱུང་སྟེ།"]},{"type":"verse","number":7,"content":["ཁོང་གིས་ང་ལ་འདི་སྐད་དུ། ཀྱེ་མིའི་བུ། འདི་ནི་ངའི་བཞུགས་ཁྲི་ཡོད་ས་དང་། ངའི་རྐང་པ་སྤོ་སའི་གནས་དེ་ཡིན་པས། ང་གནས་དེ་རུ་བསྡད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ནང་དུ་ཇི་སྲིད་བར་དུ་གནས་པར་འགྱུར་ལ། ད་ཕྱིན་ཆད་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་དང་དེ་དག་གི་རྒྱལ་པོ་རྣམས་ཀྱིས་རང་ཉིད་ཀྱི་ལོག་གཡེམ་དང་། རྒྱལ་པོ་རྣམས་ཀྱི་མཐོ་གླིང་གི་རྡོ་རིང་གིས་ངའི་མཚན་དམ་པ་བཙོག་པར་མི་བྱ།"]},{"type":"verse","number":8,"content":["དེ་དག་གི་སྒོ་ཐེམ་ནི་ངའི་སྒོ་ཐེམ་དང་ཉེ་ཞིང་། དེ་དག་གི་སྒོ་སྒྲོམ་ཡང་ངའི་སྒོ་སྒྲོམ་དང་ཉེ་བ་ཡིན། ང་དང་དེ་དག་གི་བར་དུ་རྩིག་པ་གཅིག་མ་གཏོགས་མེད་པའི་དུས་སུ། དེ་དག་གིས་རང་གིས་སྤྱད་པའི་ཞེན་ལོག་གི་ལས་ཀྱིས་ངའི་མཚན་དམ་པ་བཙོག་པར་བཟོས་པས། ངས་ཁོང་ཁྲོ་དང་བཅས་དེ་དག་རྩ་མེད་དུ་བཏང་བ་ཡིན།"]},{"type":"verse","number":9,"content":["ད་ལྟ་ཁོ་ཚོས་ངའི་མདུན་དུ་རང་གི་ལོག་གཡེམ་དང་ཁོ་ཚོའི་རྒྱལ་པོ་དག་གི་རྡོ་རིང་རྣམས་མེད་པར་བཟོས་ན། ང་ནི་ཇི་སྲིད་བར་དུ་ཁོ་ཚོའི་ཁྲོད་དུ་གནས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":10,"content":["ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་མཆོད་ཁང་འདི་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལ་བསྟན་ནས་ཁོ་རྣམས་རང་གི་སྡིག་པའི་རྐྱེན་གྱིས་ངོ་ཚ་བར་གྱིས་ལ། ཡང་ཁོ་ཚོར་མཆོད་ཁང་གི་ཆེ་ཆུང་ཚད་ཐིག་ལེན་དུ་ཆུག་དང་།"]},{"type":"verse","number":11,"content":["གལ་ཏེ་ཁོ་རྣམས་རང་གིས་སྤྱད་པའི་ལས་ཀུན་གྱི་ཕྱིར་ངོ་ཚ་བར་གྱུར་ན། ཁྱོད་ཀྱིས་མཆོད་ཁང་གི་བཟོ་བཀོད་དང་སྒྲིག་གཞི། ནང་ལ་འགྲོ་ས་དང་ཕྱིར་ཐོན་ས། ད་དུང་བཟོ་བཀོད་དང་ལམ་སྲོལ། གུས་སྲོལ་མཛད་སྒོ། ཁྲིམས་སྲོལ་མཐའ་དག་དེ་རྣམས་ལ་སྟོན་ཅིག ཡང་དེ་དག་གི་མདུན་དུ་ཡི་གེར་བཀོད་ནས་མཆོད་ཁང་གི་བཟོ་བཀོད་དང་ལམ་སྲོལ་ཡོད་ཚད་བཞིན་དུ་ཁོ་རྣམས་ལ་བྱེད་དུ་ཆུག"]},{"type":"verse","number":12,"content":["མཆོད་ཁང་གི་ཁྲིམས་སྲོལ་ནི་འདི་ལྟ་སྟེ། མཆོད་ཁང་གི་རི་རྩེའི་མཐའ་འཁོར་གྱི་ས་མཚམས་ཀུན་དམ་པར་བརྩིས་པ་ནི་མཆོད་ཁང་གི་ཁྲིམས་སྲོལ་ཡིན་ནོ། །"]},{"type":"heading","content":["མཆོད་ཁྲི།"]},{"type":"verse","number":13,"content":["མཆོད་ཁྲིའི་ཆེ་ཆུང་ནི་འདི་ལྟ་སྟེ། ཁྲུ་རེ་ཚད་ཐིག་ཏུ་བྱེད་དགོས་ལ་ཁྲུ་རེ་ནི་ཁྲུ་གང་དང་སོར་བཞི་ཡིན། ཝ་མཆུ་ལ་ཁྲུ་གང་དང་མུ་མཐའི་ཞེང་ལ་ཁྲུ་གང་ཡོད་དེ། ཕྱོགས་བཞི་རུ་མཐའ་ཡོད་པའི་མཐོ་ཚད་ལ་ཐོ་གང་ཡོད་པ་འདི་ནི་མཆོད་ཁྲིའི་ཞབས་ར་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["ཝ་མཆུ་ནས་འོག་རིམ་གྱི་ཁྲི་སྟེགས་བར་དུ་མཐོ་ཚད་ལ་ཁྲུ་དོ་དང་། མུ་མཐའི་ཞེང་ལ་ཁྲུ་གང་ཡོད་དེ། ཁྲི་སྟེགས་ཆུང་བ་ནས་ཆེ་བའི་བར་དུ་མཐོ་ཚད་ལ་ཁྲུ་དོ་དང་། མུ་མཐའི་ཞེང་ལ་ཁྲུ་གང་ཡོད་དོ། །"]},{"type":"verse","number":15,"content":["མཆོད་ཁྲིའི་མཆོད་རྫས་བཤམས་སའི་མཐོ་ཚད་ལ་ཁྲུ་བཞི་ཡོད་པ་དང་། མཆོད་རྫས་བཤམས་ས་ནས་ཟུར་བཞི་པོ་ཕྱི་རུ་འབུར་ཡོད་པ་ཡིན།"]},{"type":"verse","number":16,"content":["མཆོད་རྫས་བཤམས་སའི་རིང་ཐུང་ལ་ཁྲུ་བཅུ་གཉིས་དང་། ཞེང་ལ་ཁྲུ་བཅུ་གཉིས་ཡོད་དེ། ཕྱོགས་བཞིའི་དབྱིབས་ནི་གྲུ་བཞི་ཡིན།"]},{"type":"verse","number":17,"content":["ཁྲི་སྟེགས་ཆེ་བའི་རིང་ཐུང་ལ་ཁྲུ་བཅུ་བཞི་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་བཅུ་བཞི་ཡོད་དེ། ཕྱོགས་བཞིའི་དབྱིབས་ནི་གྲུ་བཞི་ཡིན་ལ། མཐའ་བཞི་པོའི་མཐོ་ཚད་ལ་ཁྲུ་ཕྱེད་ཀ་ཡོད་པ་དང་། ཝ་མཆུའི་ཕྱོགས་བཞི་པོའི་མུ་མཐའ་ཡི་ཞེང་ལ་ཁྲུ་གང་ཡོད། ཡང་སྐས་རྐང་ནི་ཤར་ཕྱོགས་སུ་འཁོར་ཡོད་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["མཆོད་པའི་ཆོ་ག་སྤེལ་ལུགས།"]},{"type":"verse","number":18,"content":["ཁོས་ང་ལ་འདི་ལྟར། ཀྱེ་མིའི་བུ། གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། མཆོད་ཁྲིའི་ལམ་སྲོལ་ནི་འདི་ལྟ་སྟེ། མཆོད་ཁྲི་བཞེངས་ཚར་ནས་དེའི་སྟེང་དུ་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་ཏེ་ཁྲག་གཏོར་བའི་དུས་སུ།"]},{"type":"verse","number":19,"content":["ངའི་སྤྱན་སྔར་བདག་ལ་ཞབས་ཕྱི་སྒྲུབ་པའི་ལེ་ཝི་པའི་མཆོད་དཔོན་ཏེ་ཟཱ་ཏོག་གི་བུ་རྒྱུད་རྣམས་ལ། སྡིག་བཤགས་ཀྱི་མཆོད་པ་རུ་ཁྱོད་ཀྱིས་བ་ཕྲུག་ཅིག་སྟེར་དགོས་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་པ་དང་།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་བ་ཕྲུག་གི་ཁྲག་ཅུང་ཙམ་བླངས་ཏེ་མཆོད་ཁྲིའི་ཟུར་བཞི་དང་ཁྲི་སྟེགས་ཀྱི་ཟུར་བཞི། དེ་མིན་ཕྱོགས་བཞིའི་འབུར་དུ་ཐོན་པའི་མཐའ་རྣམས་ལ་སྐུས་ཤིག ཁྱོད་ཀྱིས་དེ་ལྟར་མཆོད་ཁྲི་གཙང་མར་བྱས་ན་དེ་གཙང་མར་འགྱུར་རོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཁྱོད་ཀྱིས་སྡིག་བཤགས་ཀྱི་མཆོད་པར་འབུལ་བའི་བ་ཕྲུག་དེ་ནི་གནས་དམ་པའི་ཕྱི་རོལ་ཏུ་མཆོད་ཁང་གི་གཏན་ལ་ཁེལ་བའི་གནས་སུ་སྲེགས་ཤིག"]},{"type":"verse","number":22,"content":["བ་ཕྲུག་གིས་མཆོད་ཁྲི་གཙང་མར་བྱས་པ་བཞིན་དུ་མཆོད་ཁྲི་གཙང་མར་བཟོ་བའི་ཕྱིར། དེའི་ཕྱི་ཉིན་ཁྱོད་ཀྱིས་སྐྱོན་དང་བྲལ་བའི་ར་ཐུག་ཅིག་སྡིག་བཤགས་ཀྱི་མཆོད་པར་ཕུལ་ཞིག"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱིས་མཆོད་ཁྲི་གཙང་མར་བྱས་རྗེས་སྐྱོན་དང་བྲལ་བའི་བ་ཕྲུག་ཅིག་དང་ལུག་ཁྱུ་ལས་སྐྱོན་དང་བྲལ་བའི་ལུག་ཐུག་ཅིག་བླངས་ཏེ་མཆོད་པར་འབུལ་དགོས།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་དེ་དག་ཡ་ཝཱེའི་ཞལ་ངོར་ཕུལ་ཞིག མཆོད་དཔོན་རྣམས་ཀྱིས་དེ་དག་གི་སྟེང་དུ་ཚྭ་གཏོར་ནས་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་གི་མཆོད་པར་འབུལ་དགོས།"]},{"type":"verse","number":25,"content":["ཁྱོད་ཀྱིས་བསྟུད་མར་ཉིན་བདུན་ལ་ཉིན་རེ་བཞིན་སྡིག་བཤགས་ཀྱི་མཆོད་པའི་ཕྱིར་ར་ཐུག་ཅིག་དང་། ཡང་བ་ཕྲུག་ཅིག་དང་ལུག་ཁྱུ་ལས་ལུག་ཐུག་ཅིག་གྲ་སྒྲིག་བྱེད་དགོས་ལ། ཐམས་ཅད་སྐྱོན་དང་བྲལ་བ་ཡིན་དགོས།"]},{"type":"verse","number":26,"content":["བསྟུད་མར་ཉིན་བདུན་ལ་མཆོད་དཔོན་རྣམས་ཀྱིས་མཆོད་ཁྲི་གཙང་མར་བྱས་ན་མཆོད་ཁྲི་གཙང་མར་འགྱུར་ཞིང་། ཁོ་ཚོས་དེ་ལྟར་མཆོད་ཁྲི་དམ་པར་བྱས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["ཉིན་བདུན་ཚང་རྗེས་ཀྱི་ཉིན་བརྒྱད་པ་ནས་བཟུང་། མཆོད་དཔོན་རྣམས་ཀྱིས་མཆོད་ཁྲིའི་སྟེང་དུ་ཁྱོད་ཅག་གི་སྦྱིན་སྲེག་དང་ཞི་བདེའི་མཆོད་པ་འབུལ་དགོས་པ་དང་། དུས་དེར་ངས་དགའ་མགུའི་ངང་ཁྱོད་རྣམས་དང་དུ་ལེན་ནོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/42.json","previousChapterAudioLinks":{},"numberOfVerses":27}