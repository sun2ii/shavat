{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":44,"content":[{"type":"heading","content":["ཤར་སྒོ་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཡང་དེས་ང་གནས་དམ་པའི་ཤར་ཕྱོགས་སུ་འཁོར་བའི་ཕྱི་སྒོ་རུ་ཁྲིད་པ་ན་སྒོ་དེ་བརྒྱབ་ཡོད་པ་དང་།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། སྒོ་འདི་ངེས་པར་དུ་རྒྱག་དགོས་པ་ལས་འབྱེད་མི་རུང་སྟེ། མི་སུ་ཞིག་ཡིན་ཡང་དེ་ལས་ནང་དུ་འགྲོ་མི་ཆོག གང་ལ་ཞེ་ན། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་དེ་ལས་ནང་དུ་ཕེབས་པས་ན་སྒོ་འདི་ངེས་པར་དུ་རྒྱག་དགོས་པ་ཡིན།"]},{"type":"verse","number":3,"content":["རྒྱལ་པོ་འབའ་ཞིག་ནང་དུ་བཞུགས་ཏེ་ཡ་ཝཱེའི་དྲུང་དུ་བག་ལེབ་བཟའ་ཆོག་པ་དང་། དེ་ནི་ངེས་པར་དུ་སྒོ་ཁྱམས་ནས་ནང་དུ་འཛུལ་ཞིང་། ཡང་ལམ་དེ་བརྒྱུད་ནས་ཕྱིར་ཡོང་དགོས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་ཁོས་བྱང་སྒོ་བརྒྱུད་ནས་ང་མཆོད་ཁང་གི་མདུན་ཕྱོགས་སུ་ཁྲིད་ཅིང་། ངས་བལྟས་པ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་ཁོང་གི་གཟི་བརྗིད་ཀྱིས་ཁེངས་ཡོད་པ་མཐོང་བ་དང་ངས་གདོང་སར་བཏུད་ནས་བསྡད་དོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཀྱེ་མིའི་བུ། ངས་ཁྱོད་ལ་སྨྲས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལམ་སྲོལ་དང་ཁྲིམས་སྲོལ་ཐམས་ཅད་ལ་ཁྱོད་ཀྱིས་གཟབ་གཟབ་བྱས་ནས་མིག་གིས་ལྟོས་ལ་རྣ་བས་ཉོན་ཅིག དེར་མ་ཟད་མཆོད་ཁང་གི་འཇུག་སྒོ་དང་གནས་དམ་པའི་ཐོན་སྒོ་ཐམས་ཅད་ལ་ཡིད་འཇོག་བྱེད་དགོས།"]},{"type":"verse","number":6,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ངོ་ལོག་ཅན་ལ་འདི་ལྟར་སྨྲོས་ཤིག གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད། ཁྱོད་ཀྱིས་སྤྱད་པའི་ཞེན་ལོག་གི་དོན་ཀུན་ད་དུང་མ་ལོངས་སམ།"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱིས་ཞེན་ལོག་གི་དོན་འདི་ཐམས་ཅད་སྤྱད་པའི་ཁར། ད་དུང་ཁྱོད་རྣམས་ཀྱིས་ཚིལ་དང་ཁྲག་ང་ལ་ཟས་སུ་འབུལ་སྐབས། ལུས་སེམས་གཉིས་ཀྱི་མཚན་སྐྱི་བཅད་མེད་པའི་ཕྱི་ཕྱོགས་པ་རྣམས་ངའི་གནས་དམ་པ་རུ་ཁྲིད་འོངས་ཏེ། ངའི་མཆོད་ཁང་བཙོག་པར་བཟོས་ནས་ངའི་ཁ་ཆད་ལའང་འགལ་བའོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཁྱོད་ཚོས་ངའི་རྫས་དམ་པ་རྣམས་མ་བསྲུངས་པའི་ཁར། ཁྱོད་རྣམས་ཀྱི་ཚབ་ཏུ་ངའི་གནས་དམ་པར་མི་གཞན་མངགས་ནས་སྲུང་བར་བཅུག་གོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་ལུས་སེམས་གཉིས་ཀྱི་མཚན་སྐྱི་བཅད་མེད་པའི་ཕྱི་ཕྱོགས་པ་རྣམས་སུ་ཡིན་ཡང་ངའི་གནས་དམ་པ་རུ་འོང་མི་ཆོག"]},{"type":"verse","number":10,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལམ་བོར་བའི་དུས་སུ། ལེ་ཝི་པ་ཡང་ང་དང་རིང་དུ་བྲལ་ནས་ལམ་བོར་བ་དང་། དེ་དག་ང་དང་བྲལ་ནས་རང་གི་སྐུ་འདྲའི་རྗེས་སུ་འབྲངས་པས་ན་ཁོ་ཚོས་རང་གི་སྡིག་པ་འཁུར་དགོས་ངེས་ཡིན།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་ངའི་གནས་དམ་པ་རུ་ཞབས་ཕྱི་བསྒྲུབས་ནས་ངའི་མཆོད་ཁང་གི་སྒོ་རྣམས་བསྲུང་དགོས་ལ། ངའི་གནས་དམ་པའི་ནང་དུ་ལས་འགན་བསྒྲུབ་དགོས། དེ་དག་གིས་མི་རྣམས་ཀྱི་ཆེད་དུ་སྦྱིན་སྲེག་གི་མཆོད་པའི་ཕྱུགས་ཟོག་དང་། མཆོད་པ་གཞན་པའི་ཕྱུགས་ཟོག་རྣམས་བཤའ་དགོས་པ་དང་། ཡང་མི་རྣམས་ཀྱི་མདུན་དུ་ལངས་ནས་དེ་དག་ལ་ཞབས་ཏོག་བསྒྲུབ་དགོས་སོ། །"]},{"type":"verse","number":12,"content":["གང་ལ་ཞེ་ན། སྔར་ལེ་ཝི་པ་དེ་དག་གིས་ཁོ་ཚོའི་སྐུ་འདྲའི་མདུན་དུ་མི་འདི་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབས་པས། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་སྡིག་པའི་ནང་དུ་ལྷུང་བར་བྱེད་པའི་བཀག་རྡོ་རུ་གྱུར་པའོ། །དེ་བས་ངས་ཁོ་ཚོའི་ཕྱོགས་སུ་ལག་པ་བརྐྱངས་ནས་མནའ་བསྐྱལ་བ་སྟེ། དེ་དག་གིས་རང་གི་སྡིག་པ་འཁུར་དགོས་ངེས་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་དག་ངའི་ཉེ་སར་བཅར་ནས་ངའི་མཆོད་དཔོན་བྱེད་མི་རུང་ལ། ངའི་རྫས་དམ་པ་རྣམས་དང་རྫས་དམ་མཆོག་རྣམས་ཀྱི་ཉེ་སར་ཡང་བཅར་མི་རུང་། དེ་དག་གིས་ངེས་པར་དུ་རང་གི་ངོ་ཚ་དང་རང་གིས་བྱས་པའི་ཞེན་ལོག་གི་དོན་རྣམས་ཀྱི་ལན་འཁུར་དགོས།"]},{"type":"verse","number":14,"content":["ཡིན་ནའང་ངས་ཁོ་ཚོ་མཆོད་ཁང་བསྲུང་བ་དང་མཆོད་ཁང་གི་ལས་དོན་རྣམས་བསྒྲུབ་པ། བྱེད་འོས་པའི་ལས་ཐམས་ཅད་བྱེད་པའི་ཆེད་དུ་བསྐོ་བར་བྱའོ། །"]},{"type":"heading","content":["མཆོད་དཔོན་རྣམས་ཀྱིས་བསྲུང་དགོས་པའི་ཁྲིམས་སྲོལ།"]},{"type":"verse","number":15,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལམ་བོར་ཏེ་ང་དང་ཁ་བྲལ་དུས་སུ། ཟཱ་ཏོག་གི་བུ་རྒྱུད་དེ་ལེ་ཝི་པའི་མཆོད་དཔོན་དག་གིས་ད་དུང་ངའི་གནས་དམ་པ་བསྲུངས་པ་ཡིན། དེ་རྣམས་འབའ་ཞིག་ངའི་ཉེ་སར་བཅར་ནས་ང་ལ་ཞབས་ཕྱི་བསྒྲུབ་པ་དང་། ངའི་མདུན་དུ་ལངས་བསྡད་དེ་ཚིལ་དང་ཁྲག་ང་ལ་འབུལ་ཆོག་པ་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":16,"content":["དེ་དག་ནི་ངའི་གནས་དམ་པའི་ནང་དུ་འཛུལ་ནས་ངའི་སྒྲོག་ཙེ་རྩར་འོངས་ཏེ་ང་ལ་ཞབས་ཏོག་བསྒྲུབ་པ་དང་། ངས་བསྒོས་པའི་བཀའ་རྣམས་བསྲུང་ཆོག་པ་ཡིན།"]},{"type":"verse","number":17,"content":["དེ་དག་ནང་གི་ཁྱམས་རའི་སྒོ་རུ་འཇུག་དུས་སུ། ངེས་པར་དུ་སོ་རས་སྲབ་བུ་གྱོན་དགོས་པ་དང་། དེ་དག་གིས་ནང་གི་ཁྱམས་རའི་སྒོ་ཁ་དང་མཆོད་ཁང་ནང་དུ་ཞབས་ཏོག་སྒྲུབ་དུས་སུ་ཁོ་ཚོས་སྣམ་བུ་གྱོན་མི་རུང་སྟེ།"]},{"type":"verse","number":18,"content":["ཁོ་ཚོའི་མགོ་ལ་སོ་རས་སྲབ་བུ་དཀྲི་དགོས་པ་དང་། ཁོག་སྨད་ལ་སོ་རས་སྲབ་བུའི་དོར་མ་གྱོན་དགོས་པ་ལས། ལུས་སུ་རྔུལ་ཆུ་འདོན་སླ་བའི་གོས་ནི་གྱོན་མི་རུང་།"]},{"type":"verse","number":19,"content":["དེ་དག་ཁྱམས་ར་ཕྱི་མའི་མི་རྣམས་ཀྱི་རྩར་འགྲོ་དུས་སུ། ཞབས་ཏོག་སྒྲུབ་དུས་ཀྱི་གོས་རྣམས་ཕུད་དེ་མཆོད་ཁང་གི་ཁང་པའི་ནང་དུ་འཇོག་དགོས་ཤིང་། རང་གི་གོས་དམ་པས་མི་རྣམས་དམ་པར་མི་བྱེད་པའི་ཆེད་དུ་གོས་གཞན་རྣམས་གྱོན་དགོས་སོ། །"]},{"type":"verse","number":20,"content":["དེ་དག་གིས་སྐྲ་བཞར་མི་རུང་ལ་སྐྲ་ཐུང་ཐུང་འཇོག་པ་ལས་སྐྲ་རིང་པོའང་འཇོག་མི་རུང་།"]},{"type":"verse","number":21,"content":["མཆོད་དཔོན་ཐམས་ཅད་ནང་གི་ཁྱམས་རར་འཇུག་དུས་སུ་རྒུན་ཆང་འཐུང་མི་རུང་།"]},{"type":"verse","number":22,"content":["དེ་དག་གིས་ཡུགས་མོ་དང་སྐྱེས་པས་དོར་བའི་བུད་མེད་ནི་ཆུང་མར་ལེན་མི་རུང་ལ། ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཀྱི་ན་ཆུང་བུ་མོ་དང་ཡང་ན་མཆོད་དཔོན་ནས་ལུས་པའི་ཡུགས་མོ་ཆུང་མར་ལེན་དགོས།"]},{"type":"verse","number":23,"content":["དེ་དག་གིས་ངའི་འབངས་མི་ལ་རྫས་དམ་པ་དང་རྫས་ཕལ་བ་གཉིས་བཀར་བའི་བསླབ་བྱ་གནང་སྟེ། མི་ལ་གང་ཞིག་གཙང་བ་དང་གང་ཞིག་མི་གཙང་བའི་དབྱེ་བ་འབྱེད་དུ་འཇུག་དགོས།"]},{"type":"verse","number":24,"content":["ཡང་དེ་དག་གིས་གྱོད་དོན་རྣམས་ཐག་གིས་གཅོད་དགོས་ཏེ། ངའི་སྒྲིག་སྲོལ་བཞིན་དུ་ཐག་གིས་གཅོད་དགོས། ཁོ་ཚོས་ངའི་དུས་ཆེན་ཀུན་གྱི་ནང་དུ་གཟབ་གཟབ་ངང་ངའི་བཀའ་ཁྲིམས་དང་སྲོལ་ཡིག་རྣམས་བསྲུང་དགོས་ལ། ངའི་ངལ་གསོ་བའི་ཉིན་མོ་དམ་པར་བསྲུང་དགོས།"]},{"type":"verse","number":25,"content":["དེ་དག་ཤི་བོའི་ཉེ་སར་བཏུད་ནས་རང་ཉིད་མི་གཙང་བར་བྱེད་མི་རུང་། ཡིན་ནའང་ཤི་བོ་དེ་ནི་རང་གི་ཕའམ། མ། བུ། བུ་མོ། སྤུན་ཟླ། ཡང་ན་གནས་ལ་ཕྱིན་མེད་པའི་ལྕམ་སྲིང་ཡིན་ན། དེ་དག་གིས་རང་ཉིད་བཙོག་པར་བཟོས་ཆོག་གོ །"]},{"type":"verse","number":26,"content":["མཆོད་དཔོན་གྱིས་རང་ཉིད་གཙང་མར་མཛད་རྗེས་ད་དུང་ཉིན་བདུན་ལ་བསྒུག་དགོས་ཏེ།"]},{"type":"verse","number":27,"content":["དེ་ནང་གི་ཁྱམས་རར་ཕྱིན་ཏེ་གནས་དམ་པ་རུ་ཞབས་ཏོག་སྒྲུབ་དུས་སུ། དེས་སྡིག་བཤགས་ཀྱི་མཆོད་པ་འབུལ་དགོས་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡ་ཝཱེ་ནི་མཆོད་དཔོན་རྣམས་ཀྱི་ནོར་སྐལ་ཡིན་པ།"]},{"type":"verse","number":28,"content":["མཆོད་དཔོན་རྣམས་ལ་ནོར་སྐལ་ཡོད་དེ་བདག་ནི་དེ་དག་གི་ནོར་སྐལ་ཡིན། ཁྱོད་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་དེ་དག་ལ་ས་སྐལ་གང་ཡང་སྟེར་མི་རུང་སྟེ། བདག་ནི་དེ་དག་གི་ཐོབ་སྐལ་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["འབྲུ་མཆོད་དང་སྡིག་བཤགས་ཀྱི་མཆོད་པ། ཉེས་སེལ་གྱི་མཆོད་པ་བཅས་ཀྱི་མཆོད་རྫས་རྣམས་ཁོ་ཚོས་བཟའ་རུང་སྟེ། ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ཡ་ཝཱེ་ལ་ཕུལ་བ་ཐམས་ཅད་མཆོད་དཔོན་རྣམས་ལ་དབང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":30,"content":["ཐོག་ཕུད་རྣམས་ལས་ཆེས་ལེགས་པའི་རྫས་དང་ཁྱོད་ཚོས་ཕུལ་བའི་མཆོད་རྫས་ཐམས་ཅད་མཆོད་དཔོན་རྣམས་ལ་དབང་བ་དང་། ཁྱོད་ཀྱི་ཁྱིམ་ལ་བྱིན་རླབས་འཐོབ་པའི་ཆེད་དུ། ཁྱོད་ཚོས་ཕྱེ་གསར་པ་དེ་མཆོད་དཔོན་ལ་འབུལ་དགོས།"]},{"type":"verse","number":31,"content":["འདབ་ཆགས་དང་ཡང་ན་རི་དྭགས་གང་ཡིན་ཡང་རང་བཞིན་གྱིས་ཤི་བའམ་ཡང་ན་ཐང་དུ་ཕྲལ་བའི་ཤ་གང་ཡང་མཆོད་དཔོན་རྣམས་ཀྱིས་བཟའ་མི་རུང་ངོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/43.json","previousChapterAudioLinks":{},"numberOfVerses":31}