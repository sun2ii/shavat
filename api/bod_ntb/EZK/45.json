{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":45,"content":[{"type":"heading","content":["གནས་གཙང་མ།"]},{"type":"verse","number":1,"content":["ཁྱོད་ཚོས་རྒྱན་བླངས་ནས་ས་སྐལ་བགོ་བའི་དུས་སུ། རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་། ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཅན་གྱི་ས་སྐལ་ཞིག་གནས་གཙང་མ་རུ་ཡ་ཝཱེ་ལ་ཕུལ་ཞིག དེའི་ས་ཁུལ་ཡོངས་རྫོགས་དམ་པ་ཡིན།"]},{"type":"verse","number":2,"content":["དེའི་ནང་ནས་རིང་ཚད་ལ་ཁྲུ་ལྔ་བརྒྱ་དང་། ཞེང་ལའང་ཁྲུ་ལྔ་བརྒྱ་ཡོད་པའི་ཕྱོགས་བཞི་པོ་གྲུ་བཞི་ཅན་གྱི་ས་ཞིག་གནས་དམ་པའི་ཕྱིར་འཇོག་དགོས་པ་དང་། དེའི་མཐའ་འཁོར་དུ་ཁྲུ་ལྔ་བཅུ་ཡོད་པའི་ས་སྟོང་ཞིག་འཇོག་དགོས།"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ཀྱིས་ཚད་ཐིག་བླངས་པའི་གནས་གཙང་མ་ལས་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་། ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཡོད་པའི་ས་ཞིག་ཚད་ནས་དེའི་ནང་དུ་གནས་དམ་པ་ཡོད་དགོས་ལ། དེ་ནི་གནས་དམ་མཆོག་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["དེ་ནི་ས་ཁུལ་ཡོངས་ཀྱི་གནས་མཆོག་ཅིག་ཡིན་ཏེ། གནས་དམ་པ་རུ་ཞབས་ཏོག་སྒྲུབ་པ་དང་། ཡ་ཝཱེའི་ཉེ་སར་བཏུད་ནས་ཁོང་ལ་ཞབས་ཕྱི་སྒྲུབ་པའི་མཆོད་དཔོན་རྣམས་ལ་དབང་ཞིང་། དེ་ནི་ཁོ་ཚོའི་ཁང་ས་དང་གནས་དམ་པའི་གནས་མཆོག་ཡིན།"]},{"type":"verse","number":5,"content":["ཡང་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡོད་པ་དང་། ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཡོད་པའི་ས་གཞན་ཞིག་ཡོད་པ་དེ་ནི། མཆོད་ཁང་ནང་དུ་ཞབས་ཏོག་སྒྲུབ་པའི་ལེ་ཝི་པ་རྣམས་ལ་དབང་ཞིང་། ཁང་པ་ཉི་ཤུ་ནི་དེའི་ས་སྐལ་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱིས་ཞེང་ལ་ཁྲུ་ལྔ་སྟོང་དང་། རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡོད་པའི་ས་ཞིག་བགོས་ཏེ་གྲོང་ཁྱེར་གྱི་ས་སྐལ་བྱེད་དགོས་ཤིང་། དེ་ནི་ཁྱོད་ཚོས་ཕུལ་བའི་གནས་གཙང་མའི་འགྲམ་དུ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཡོངས་ལ་དབང་བའོ། །"]},{"type":"heading","content":["རྒྱལ་པོར་དབང་བའི་ས།"]},{"type":"verse","number":7,"content":["རྒྱལ་པོར་དབང་བའི་ས་ནི་ཁྱོད་ཚོས་ཕུལ་བའི་གནས་གཙང་མ་དང་གྲོང་ཁྱེར་གྱི་ས་ཡི་འགྲམ་དུ་ཡོད་དགོས་པ་དང་། གཅིག་ནི་ཁྱོད་ཚོས་ཕུལ་བའི་གནས་གཙང་མར་ཁ་གཏད་དགོས་པ་དང་། ཅིག་ཤོས་ནི་གྲོང་ཁྱེར་གྱི་ས་ལ་ཁ་གཏད་དགོས་ཏེ། ནུབ་ཕྱོགས་སུ་ས་དེའི་ནུབ་ཕྱོགས་ཀྱི་ས་མཚམས་དང་། ཤར་ཕྱོགས་སུ་ས་དེའི་ཤར་ཕྱོགས་ཀྱི་ས་མཚམས་ལ་རིང་ཚད་ནི་ཚོ་པ་ཁག་ལ་བགོས་པའི་ས་དང་གཅིག་ཡིན་དགོས།"]},{"type":"verse","number":8,"content":["ས་འདི་ནི་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་རྒྱལ་པོ་རྣམས་ལ་དབང་ཞིང་། ངས་བསྐོས་པའི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཕྱིན་ཆད་ངའི་མི་རིགས་ལ་གཉའ་གནོན་བྱེད་མི་རུང་ལ། ཚོ་ཁག་བཞིན་དུ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ལ་ས་བགོ་དགོས་སོ། །"]},{"type":"verse","number":9,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་རྣམས། ཁྱོད་ཚོས་གང་ཞིག་སྤྱད་པ་ད་དུང་མ་ལོངས་སམ། ཁྱོད་ཚོས་བཙན་ཤུགས་དང་མེད་པར་བཟོ་བའི་དོན་རྣམས་ཚར་བཅད་ནས་དྲང་གཞག་དང་དྲང་བདེན་སྤྱོད་ཅིག ད་ནི་ངའི་མི་རྣམས་ཀྱི་ནོར་སྐལ་འཕྲོག་བཅོམ་མ་བྱེད་ཅིག་ཅེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཚོས་དྲང་བདེན་གྱི་རྒྱ་སྲང་དང་དྲང་བདེན་གྱི་ཨེ་ཕཱ། དྲང་བདེན་གྱི་ཆུ་བེན་བཅས་སྤྱོད་ཅིག"]},{"type":"verse","number":11,"content":["སྲ་གཟུགས་འཇལ་བྱེད་ཀྱི་ཨེ་ཕཱ་དང་གཤེར་གཟུགས་འཇལ་བྱེད་ཀྱི་ཆུ་བེན་ཞེས་པ་གཉིས་ནི་གཅིག་འདྲ་ཡིན་དགོས་ལ། ཆུ་བེན་གཅིག་ནི་ཁལ་གྱི་བཅུ་ཆའི་གཅིག་ཡིན་ཏེ། ཨེ་ཕཱ་གཅིག་ཀྱང་ཁལ་གྱི་བཅུ་ཆའི་གཅིག་ཡིན། ཐམས་ཅད་ཀྱིས་ཁལ་གྱི་འཇལ་ཆས་ཚད་གཞི་རུ་འཛིན་དགོས།"]},{"type":"verse","number":12,"content":["ལྗིད་ཚད་རྩིས་གཞི་ཡི་སྲང་ཞེས་པ་གཅིག་ནི་གཱེ་ར་ཉི་ཤུ་དང་། སྲང་ཉི་ཤུའི་ཁར། སྲང་ཉེར་ལྔ་དང་སྲང་བཅོ་ལྔ་བསྣན་ན་ཁྱོད་ཚོའི་མཱེ་ན་གཅིག་ཡིན།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཚོས་འབུལ་དགོས་པའི་མཆོད་རྫས་ནི་འདི་ལྟ་སྟེ། གྲོ་ཁལ་གཅིག་ལས་ཨེ་ཕཱའི་དྲུག་ཆའི་གཅིག་དང་། སོ་བ་ཁལ་གཅིག་ལས་ཀྱང་ཨེ་ཕཱའི་དྲུག་ཆའི་གཅིག་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་སྣུམ་ནི་འདི་ལྟར་འབུལ་དགོས་ཏེ། ཆུ་བེན་གྱིས་འཇལ་ནས་ཁལ་གཅིག་ལས་ཆུ་བེན་གྱི་བཅུ་ཆའི་གཅིག་འབུལ་དགོས་ཏེ། གང་ལ་ཞེ་ན། ཁལ་གཅིག་ནི་ཆུ་བེན་བཅུ་དང་ཡང་ན་ཁལ་གཅིག་ཡིན་ནོ། །གང་ལ་ཞེ་ན། ཆུ་བེན་བཅུ་ནི་ཁལ་གཅིག་ཡིན་པས་སོ། །"]},{"type":"verse","number":15,"content":["ཡེས་ར་ཨེལ་གྱི་ས་བཅུད་འཛོམས་པའི་རྩྭ་ཐང་ནས་ལུག་ཉིས་བརྒྱ་ལས་ལུ་གུ་གཅིག་རེ་འབུལ་དགོས་ཏེ། མཆོད་རྫས་འདི་དག་ནི་འབྲུ་མཆོད་དང་སྦྱིན་སྲེག་གི་མཆོད་པ། ཞི་བདེའི་མཆོད་པ་བཅས་སུ་འབུལ་དགོས་པ་དང་། དེ་དག་གི་སྡིག་པ་བཤགས་པའི་ཆེད་དུ་ཡིན་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":16,"content":["ཡུལ་ཁམས་ནང་གི་མི་ཀུན་གྱིས་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོར་ཕྱག་རྟེན་འབུལ་དགོས་ཏེ།"]},{"type":"verse","number":17,"content":["རྒྱལ་པོས་དུས་ཆེན་དང་ཚེས་གཅིག ངལ་གསོ་བའི་ཉིན་མོ་བཅས་པ་སྟེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ཀྱིས་གཏན་ལ་ཁེལ་བའི་དུས་ཆེན་ཡོངས་སུ། སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་མཆོད། སྐྱེམས་མཆོད་བཅས་འབུལ་དགོས་ལ། ཁོང་གིས་སྡིག་བཤགས་ཀྱི་མཆོད་པ་དང་འབྲུ་མཆོད། སྦྱིན་སྲེག་གི་མཆོད་པ། ཞི་བདེའི་མཆོད་པ་བཅས་སྟ་གོན་བྱས་ཏེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ཀྱི་སྡིག་པ་བཤགས་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["ཡང་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཟླ་དང་པོའི་ཚེས་གཅིག་གི་ཉིན་ཁྱོད་ཀྱིས་སྐྱོན་དང་བྲལ་བའི་བ་ཕྲུག་ཅིག་བླངས་ནས་གནས་དམ་པ་གཙང་མར་བཟོ་དགོས།"]},{"type":"verse","number":19,"content":["མཆོད་དཔོན་གྱིས་སྡིག་བཤགས་མཆོད་པའི་ཕྱུགས་ཟོག་གི་ཁྲག་ཅུང་ཙམ་བླངས་ཏེ་མཆོད་ཁང་གི་སྒོ་སྒྲོམ་དང་མཆོད་ཁྲིའི་ཁྲི་སྟེགས་ཀྱི་ཟུར་བཞི། དེ་མིན་ནང་གི་ཁྱམས་རའི་སྒོ་སྒྲོམ་བཅས་ལ་བསྐུ་དགོས།"]},{"type":"verse","number":20,"content":["ཟླ་དང་པོའི་ཚེས་བདུན་གྱི་ཉིན། བསམ་བཞིན་མ་ཡིན་པར་ཉེས་པ་བཟོས་པ་དང་ཡང་ན་མ་ཤེས་པར་ཉེས་པ་བྱས་པའི་མི་ལ་ཁྱོད་ཀྱིས་དེ་ལྟར་བྱས་ནས་མཆོད་ཁང་གི་ཆེད་དུ་སྡིག་པ་བཤགས་དགོས།"]},{"type":"verse","number":21,"content":["ཟླ་དང་པོའི་ཚེས་བཅུ་བཞིའི་ཉིན་ཁྱོད་རྣམས་ཀྱིས་ཉིན་བདུན་གྱི་རིང་ལ་པེ་སག་གི་དུས་ཆེན་བསྲུང་དགོས་ཏེ། དུས་ཆེན་གྱི་སྐབས་སུ་ཁྱོད་ཚོས་སྐྱུར་མེད་བག་ལེབ་བཟའ་དགོས།"]},{"type":"verse","number":22,"content":["ཉིན་དེར་རྒྱལ་པོས་རང་ཉིད་དང་ཡུལ་ཁམས་ནང་གི་མི་ཀུན་གྱི་ཕྱིར་དུ་གླང་ཐུག་ཅིག་སྡིག་བཤགས་ཀྱི་མཆོད་པར་གྲ་སྒྲིག་བྱེད་དགོས།"]},{"type":"verse","number":23,"content":["དུས་ཆེན་གྱི་ཉིན་བདུན་པོར་ཁོས་ཉིན་རེར་ཡ་ཝཱེ་ལ་སྐྱོན་དང་བྲལ་བའི་གླང་ཐུག་བདུན་དང་ལུག་ཐུག་བདུན་སྦྱིན་སྲེག་གི་མཆོད་པའི་ཆེད་དུ་གྲ་སྒྲིག་བྱེད་དགོས་ཏེ། ཡང་ཉིན་རེར་ར་ཐུག་ཅིག་སྡིག་བཤགས་ཀྱི་མཆོད་པར་གྲ་སྒྲིག་བྱེད་དགོས།"]},{"type":"verse","number":24,"content":["ཡང་ཁོས་འབྲུ་མཆོད་ཀྱང་གྲ་སྒྲིག་བྱེད་དགོས་ཏེ། གླང་ཐུག་རེ་རེ་ནི་ཕྱེ་བཟང་པོ་ཨེ་ཕཱ་གང་དང་མཉམ་དུ་འབུལ་བ་དང་། ལུག་ཐུག་རེ་རེ་ནི་ཕྱེ་བཟང་པོ་ཨེ་ཕཱ་གང་དང་མཉམ་དུ་འབུལ་དགོས་ཏེ། ཕྱེ་བཟང་པོ་ཨེ་ཕཱ་གང་རེའི་ནང་དུ་སྐྱུ་རུ་རའི་འཚིར་སྣུམ་རྫ་བུམ་གང་བསྲེ་དགོས་པ་དང་།"]},{"type":"verse","number":25,"content":["ཟླ་བདུན་པའི་ཚེས་བཅོ་ལྔ་སྟེ་དུས་ཆེན་སྲུང་བའི་དུས་སུ་ཡང་ཁོས་ཉིན་བདུན་པོར་དེ་ལྟར་བྱེད་དགོས་ལ། པེ་སག་དུས་ཆེན་གྱི་སྡིག་བཤགས་ཀྱི་མཆོད་པ་དང་སྦྱིན་སྲེག་གི་མཆོད་པ། འབྲུ་མཆོད། འཚིར་སྣུམ་བཅས་ཀྱི་སྲོལ་བཞིན་དུ་སྟ་གོན་བྱེད་དགོས་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}