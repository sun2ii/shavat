{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":47,"content":[{"type":"heading","content":["མཆོད་ཁང་ནས་ཆུ་ཐོན་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་ཁོས་ང་མཆོད་ཁང་གི་སྒོ་ཁར་ཁྲིད་པ་དང་། ལྟོས་དང་། མཆོད་ཁང་དེ་ཤར་ཕྱོགས་སུ་འཁོར་ཡོད་པས། མཆོད་ཁང་གི་སྒོ་ཐེམ་ནས་ཆུ་བཞུར་འོངས་ཏེ་ཤར་ཕྱོགས་སུ་བཞུར་བ་དང་། ཆུ་དེ་ནི་མཆོད་ཁང་གི་གཡས་སུ་ཡོད་པའི་མཆོད་ཁྲིའི་ལྷོ་ཕྱོགས་ཀྱི་ས་འོག་ནས་བཞུར་འོངས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["དེས་ང་བྱང་སྒོ་ནས་ཕྱི་རུ་ཁྲིད་ཅིང་། ཡང་ང་ཁྲིད་དེ་ཕྱི་རོལ་ནས་ཤར་ཕྱོགས་སུ་འཁོར་བའི་ཕྱི་སྒོ་རུ་སླེབས་པ་ན། ལྟོས་དང་། གཡས་ཕྱོགས་ནས་ཆུ་ཕྲན་བཞུར་འོངས་པའོ། །"]},{"type":"verse","number":3,"content":["མི་དེའི་ལག་ཏུ་ཚད་ཐིག་ལེན་བྱེད་ཐག་པ་ཞིག་བཟུང་སྟེ་ཤར་ཕྱོགས་སུ་འགྲོ་བའི་སྐབས་སུ། ཁྲུ་ཆིག་སྟོང་གི་རིང་ཐུང་ཚད་པ་དང་། དེ་ནས་ང་ཆུ་ནང་ནས་ཕར་ཁྲིད་པ་ལ་ཆུ་ནི་སྲེ་ལོང་བར་དུ་སླེབས་ཤིང་།"]},{"type":"verse","number":4,"content":["ཡང་དེས་ཁྲུ་ཆིག་སྟོང་ཚད་དེ། ང་ཆུ་ནང་ནས་ཕར་ཁྲིད་པ་ལ་ཆུ་ནི་པུས་མོ་ཡི་མཚམས་སུ་སླེབས་པ་དང་། ཡང་དེས་ཁྲུ་ཆིག་སྟོང་ཚད་དེ། ང་ཕར་ཁྲིད་པ་ལ་ཆུ་རྐེད་པའི་མཚམས་སུ་སླེབས་སོ། །"]},{"type":"verse","number":5,"content":["དེས་ཡང་ཁྲུ་ཆིག་སྟོང་ཚད་པ་ན་ཆུ་དེ་ནི་གཙང་པོ་ཞིག་ཏུ་གྱུར་ཏེ། ཆུ་རྒྱས་ནས་རྐྱལ་ཆོག་པ་ལས་ཕ་རོལ་དུ་བརྒལ་མི་ཐུབ་པའི་གཙང་པོ་རུ་གྱུར་པས་ན། ང་དེར་བརྒལ་ནས་འགྲོ་མ་ཐུབ་བོ། །"]},{"type":"verse","number":6,"content":["དེས་ང་ལ་འདི་ལྟར། ཀྱེ་མིའི་བུ། ཁྱོད་ཀྱིས་འདི་མཐོང་ངམ་ཞེས་གསུངས་ནས། ང་ཁྲིད་དེ་སླར་ཡང་གཙང་པོའི་འགྲམ་དུ་ཕྱིན།"]},{"type":"verse","number":7,"content":["ང་ཕྱིར་ལོག་རྗེས་གཙང་པོའི་འགྲམ་གཉིས་སུ་ལྗོན་ཤིང་མང་པོ་ཡོད་པ་མཐོང་བྱུང་།"]},{"type":"verse","number":8,"content":["ཡང་དེས་ང་ལ་འདི་ལྟར། ཆུ་འདི་ནི་ཤར་ཕྱོགས་ཀྱི་གནས་སུ་བཞུར་ཏེ། མར་ཨ་ར་པཱ་རུ་བཞུར་ནས་འཆི་མཚོར་བབས་ཏེ། ཆུ་དེ་འཆི་མཚོ་ནང་དུ་བཞུར་ནས་རྒྱ་མཚོའི་ནང་གི་ཚྭ་མེད་པར་གཏོང་བ་ཡིན།"]},{"type":"verse","number":9,"content":["དུས་དེར། གཙང་པོ་འདི་བཞུར་ས་ཀུན་ཏུ་སྐྱེ་འཕེལ་བྱུང་བའི་སྲོག་ཆགས་ཐམས་ཅད་གསོན་ཐུབ་པ་དང་། ཆུ་དེ་གང་དུ་བཞུར་ན་དེ་རུ་ཉ་ཤིན་ཏུ་མང་བའོ། །གང་ལ་ཞེ་ན། གཙང་པོ་འདི་",{"noteId":9},"གང་དུ་བཞུར་ན་རྒྱ་མཚོ་ནང་གི་ཚྭ་མེད་པར་གྱུར་ཏེ་སྲོག་ཆགས་ཐམས་ཅད་གསོན་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཨེན་གེ་དི་ནས་ཨེན་ཨེག་ལཱ་ཡིམ་གྱི་བར་དུ་ཉ་པ་རྣམས་མཚོ་འགྲམ་དུ་ལངས་ཏེ་ཚང་མ་ཉ་རྒྱ་འདིང་ས་ཡིན་ཏེ། རྒྱ་མཚོའི་ནང་གི་ཉ་བཞིན་དུ་ཉ་རིགས་ཤིན་ཏུ་མང་ངོ་། །"]},{"type":"verse","number":11,"content":["ཡིན་ནའང་ན་ཁུག་དང་གཤོང་སའི་ཆུ་ནི་ཚྭ་མེད་པར་འགྱུར་མི་རུང་བར་ཚྭ་ཁ་རུ་འགྱུར་དགོས།"]},{"type":"verse","number":12,"content":["གཙང་པོའི་འགྲམ་གཉིས་སུ་སིལ་སྡོང་སྣ་ཚོགས་སྐྱེས་ཏེ་ཟོས་ཆོག་པ་དང་། སྡོང་པོའི་ལོ་མ་མི་སྐམ་ལ་འབྲས་བུ་ཡང་ཆད་པར་མི་འགྱུར། ལྗོན་ཤིང་ལ་མཁོ་བའི་ཆུ་ནི་གནས་དམ་པ་ནས་བཞུར་འོངས་པ་ཡིན་པས་ཟླ་རེ་རེར་འབྲས་བུ་གསར་པ་ཐོགས་པ་ཡིན། ཡང་ལྗོན་ཤིང་གི་འབྲས་བུ་ཟོས་ཆོག་པ་དང་ལོ་མས་ནད་གསོ་ཐུབ་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་ས་མཚམས།"]},{"type":"verse","number":13,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཚོས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་བཅུ་གཉིས་བཞིན་དུ་ས་སྐལ་བགོ་དགོས་པ་དང་། ས་མཚམས་འདི་དག་བཞིན་དུ་ཡོ་སེབ་ལ་ཉིས་སྐལ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཚོས་ས་སྐལ་འདི་ཆ་སྙོམས་ཀྱིས་བགོས་ཤིག གང་ལ་ཞེ་ན། སྔར་ངས་རང་གི་ལག་པ་བརྐྱངས་ཏེ་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ལ་ས་འདི་སྦྱིན་པར་ཁས་བླངས་པས། ཡུལ་འདི་ནི་ཁྱོད་ཚོར་ས་སྐལ་དུ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["ཡུལ་འདིའི་ས་མཚམས་ནི་བྱང་ཕྱོགས་སུ་རྒྱ་མཚོ་ཆེན་པོ་ནས་ཧེད་ལོན་གྱི་ལམ་བརྒྱུད་དེ་ཚེ་དད་ལ་འགྲོ་སར་སླེབས་པ་དང་།"]},{"type":"verse","number":16,"content":["ཡང་ཧ་མཱད་དང་པེ་རོ་ཏ། དཱ་མེ་སེག་དང་ཧ་མཱད་ཀྱི་ས་མཚམས་སུ་ཡོད་པའི་སིབ་ར་ཨིམ་བཅས་བརྒྱུད་དེ། ཧོ་རན་ས་མཚམས་ཀྱི་ཧ་ཚར་ཧད་ཏི་ཀན་ལ་སླེབས་པའོ། །"]},{"type":"verse","number":17,"content":["ཡང་ས་མཚམས་འདི་ནི་རྒྱ་མཚོ་ནས་ཧ་ཚར་ཨེ་ནན་དང་། བྱང་ཕྱོགས་སུ་དཱ་མེ་སེག་གི་ས་མཚམས་དང་། ཡང་དེའི་བྱང་ཕྱོགས་སུ་ཧ་མཱད་ཀྱི་ས་མཚམས་ཡིན་པ་དང་། འདི་ནི་བྱང་ཕྱོགས་ཀྱི་ས་མཚམས་ཡིན།"]},{"type":"verse","number":18,"content":["ཤར་ཕྱོགས་ཀྱི་ས་མཚམས་ནི་ཧོ་རན་དང་དཱ་མེ་སེག་གཉིས་ཀྱི་བར་དང་། གིལ་ཨད་དང་ཡེས་ར་ཨེལ་ཡུལ་གྱི་བར་དུ་ཡོད་པའི་ཡོར་དན་གཙང་པོ་ཡིན་པ་དང་། ཁྱོད་ཚོས་བྱང་ཕྱོགས་ཀྱི་མཚམས་ནས་ཤར་ཕྱོགས་ཀྱི་རྒྱ་མཚོའི་བར་དུ་ཚད་དགོས་ལ་དེ་ནི་ཤར་ཕྱོགས་ཀྱི་ས་མཚམས་ཡིན།"]},{"type":"verse","number":19,"content":["ལྷོ་ཕྱོགས་ཀྱི་ས་མཚམས་ནི་ཐལ་མཱར་ནས་མེ་རི་བཱ་ཀཱ་དེའེ་ཤཱའི་ཆུ་རྣམས་དང་། ཨེ་ཅིབ་ཀྱི་ཆུ་ཕྲན་རྣམས་བརྒྱུད་ནས་རྒྱ་མཚོ་ཆེན་པོར་སླེབས་པ་དང་། དེ་ནི་ལྷོ་ཕྱོགས་ཀྱི་ས་མཚམས་ཡིན།"]},{"type":"verse","number":20,"content":["ནུབ་ཕྱོགས་ཀྱི་ས་མཚམས་ནི་རྒྱ་མཚོ་ཡིན་ཞིང་། ལྷོ་ཕྱོགས་ཀྱི་ས་མཚམས་ནས་ཧ་མཱད་ཁར་གྱི་ཁ་གཏད་ས་དེ་ནི་ནུབ་ཕྱོགས་ཀྱི་ས་མཚམས་ཡིན།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཚོས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་བཞིན་དུ་ས་འདི་བགོས་ཤིག"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་དང་ཁྱོད་ཚོའི་ཁྲོད་དུ་ཡོད་པའི་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་དབང་བའི་ཕྱིར་དུ། མ་འོངས་པར་ཁྱོད་ཚོས་རྒྱན་བླངས་ནས་ས་འདི་ནོར་སྐལ་དུ་བགོས་ཤིག དེ་དག་གིས་ཁྱོད་ཚོའི་ཁྲོད་དུ་བུ་ཕྲུག་སྐྱེ་བས། ཁྱོད་ཅག་གིས་དེ་རྣམས་ནི་གཞིས་སུ་སྐྱེས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་དང་འདྲ་བའི་ལྟ་སྟངས་འཛིན་དགོས་ཤིང་། དེ་རྣམས་ལའང་ཡེས་ར་ཨེལ་གྱི་ཚོ་པའི་ནང་དུ་ཁྱོད་ཅག་དང་མཉམ་དུ་རྒྱན་བླངས་ནས་ས་སྐལ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":23,"content":["མ་འོངས་པར་ཚོ་པ་གང་ཞིག་གི་ནང་དུ་ཕྱི་ཕྱོགས་པ་གནས་ཡོད་ན། ཁྱོད་རྣམས་ཀྱིས་ཡུལ་དེ་རུ་དེ་དག་ལ་ས་སྐལ་བགོ་བར་གྱིས་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":9,"caller":"+","text":"འདིར་གཙང་པོ་འདི་ཞེས་པར་མ་ཕྱི་ལས་གཙང་པོ་འདི་གཉིས་ཞེས་མཐོང་།","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/bod_ntb/EZK/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZK/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/46.json","previousChapterAudioLinks":{},"numberOfVerses":23}