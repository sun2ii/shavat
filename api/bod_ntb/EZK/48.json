{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZK","translationId":"bod_ntb","name":"ཨེ་ཟེ་ཀི་ཨེལ།","commonName":"ཨེ་ཟེ་ཀི་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཨེ་ཟེ་ཀི་ཨེལ་གྱི་མདོ།","order":26,"numberOfChapters":48,"sha256":"c2aae725cc536162f786a6962207b0079539a934cd257a05e8d2b5f29bf14d02","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bod_ntb/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":48,"content":[{"type":"heading","content":["ཚོ་པ་བདུན་ལ་ཐོབ་པའི་ས་སྐལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཚོ་པ་སོ་སོར་དབང་བའི་ས་སྐལ་ནི་འདི་ལྟ་སྟེ། བྱང་གི་མུ་མཐའི་ས་མཚམས་ནས་ཧེད་ལོན་གྱི་ལམ་བརྒྱུད་དེ། ཧ་མཱད་ཁར་ནས་དཱ་མེ་སེག་གི་ས་མཚམས་ཀྱི་ཧ་ཚར་ཨེ་ནན་ལ་སླེབས་པ་དང་། བྱང་དུ་ཧ་མཱད་ལ་འབྱར་ནས། ཤར་ནས་ནུབ་བར་གྱི་ས་དེ་ནི་དཱན་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":2,"content":["དཱན་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ཨ་ཤེར་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":3,"content":["ཨ་ཤེར་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ནཱབ་ཐ་ལིའི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":4,"content":["ནཱབ་ཐ་ལིའི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་མཱ་ན་ཤེའི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":5,"content":["མཱ་ན་ཤེའི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ཨེ་ཕཱར་ཡིམ་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":6,"content":["ཨེ་ཕཱར་ཡིམ་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་རུ་བེན་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":7,"content":["རུ་བེན་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ཡ་ཧུ་དཱའི་ས་སྐལ་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཡ་ཧུ་དཱའི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་ཀྱི་བར་ནི་ཁྱོད་རྣམས་ཀྱིས་འབུལ་དགོས་པའི་གནས་གཙང་མ་ཡིན་ཏེ། རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡིན། ཤར་ནས་ནུབ་བར་གྱི་རིང་ཚད་ནི་ས་སྐལ་གཞན་རྣམས་དང་གཅིག་ཡིན་ཞིང་། གནས་དམ་པ་ནི་དེའི་དབུས་སུ་ཡོད་དགོས།"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེར་འབུལ་བའི་ས་ཁུལ་ནི་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཡིན་དགོས།"]},{"type":"heading","content":["མཆོད་དཔོན་རྣམས་ཀྱི་ས་སྐལ།"]},{"type":"verse","number":10,"content":["མཆོད་དཔོན་རྣམས་ལ་འབུལ་བའི་གནས་མཆོག་ནི་བྱང་ཕྱོགས་ཀྱི་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་། ནུབ་ཕྱོགས་ཀྱི་ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་དང་། ཤར་ཕྱོགས་ཀྱི་ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་དང་། ལྷོ་ཕྱོགས་ཀྱི་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡིན་དགོས་ལ། དེའི་དབུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེའི་གནས་མཆོག་ཡོད་དགོས།"]},{"type":"verse","number":11,"content":["ས་འདི་ནི་ཟཱ་ཏོག་གི་བུ་རྒྱུད་རྣམས་ལས་དམ་པར་གྱུར་པ་རྣམས་ཏེ་མཆོད་དཔོན་རྣམས་ལ་འབུལ་དགོས་པ་དང་། དེ་དག་གིས་ངས་བསྒོས་པའི་ལས་འགན་རྣམས་བསྒྲུབས་ཤིང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ལམ་བོར་བའི་དུས་སུ། དེ་དག་ནི་ལེ་ཝི་པ་རྣམས་དང་འདྲ་བར་ལམ་མ་བོར་ཏོ། །"]},{"type":"verse","number":12,"content":["དེ་བས། གནས་གཙང་མར་ཕུལ་བ་ལས་ས་ཆ་ཞིག་ནི་མཆོད་དཔོན་རྣམས་ལ་ཕུལ་ནས་གནས་དམ་མཆོག་བྱེད་དགོས་ཏེ། ས་འདི་ནི་ལེ་ཝི་པའི་ས་མཚམས་དང་འབྲེལ་ཡོད་དོ། །"]},{"type":"verse","number":13,"content":["ཡང་མཆོད་དཔོན་རྣམས་ཀྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ས་ཆ་ཞིག་ནི་ལེ་ཝི་པ་རྣམས་ལ་སྦྱིན་པ་དང་། རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཡོད་དགོས་ཤིང་། མཆོད་དཔོན་རྣམས་ཀྱི་སའི་རིང་ཚད་ཀྱང་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་ཞེང་ལ་ཁྲུ་ཆིག་ཁྲི་ཡིན།"]},{"type":"verse","number":14,"content":["ས་འདིའི་ཆ་གང་ཞིག་ཀྱང་འཚོང་མི་རུང་ལ་བརྗེ་ཡང་མི་རུང་། མི་གཞན་ལ་སྤྲོད་ཀྱང་མི་རུང་ངོ་། །གང་ལ་ཞེ་ན། དེ་ནི་ས་ཡི་ནང་ནས་ཆེས་ལེགས་པོ་དེ་ཡིན་ལ་ཡ་ཝཱེའི་གནས་དམ་པ་ལགས་སོ། །"]},{"type":"verse","number":15,"content":["ཡང་ས་ལྷག་མ་སྟེ་ཞེང་ལ་ཁྲུ་ལྔ་སྟོང་དང་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡོད་པ་སྤྱི་བའི་གནས་སུ་བྱས་ཏེ་གྲོང་ཁྱེར་དང་སྡོད་གནས། ཉེ་འཁོར་བཅས་སུ་སྤྱོད་ཅིང་གྲོང་ཁྱེར་ནི་དེའི་དབུས་སུ་ཡོད་དགོས།"]},{"type":"verse","number":16,"content":["གྲོང་ཁྱེར་གྱི་ཆེ་ཆུང་ནི་འདི་ལྟ་སྟེ། བྱང་ཕྱོགས་སུ་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་དང་། ལྷོ་ཕྱོགས་སུ་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་དང་། ཤར་ཕྱོགས་སུ་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་དང་། ནུབ་ཕྱོགས་སུ་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་ཡོད།"]},{"type":"verse","number":17,"content":["གྲོང་ཁྱེར་ལ་ཉེ་འཁོར་ཡོད་དགོས་ཏེ། བྱང་ཕྱོགས་སུ་ཁྲུ་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་། ལྷོ་ཕྱོགས་སུ་ཁྲུ་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་། ཤར་ཕྱོགས་སུ་ཁྲུ་ཉིས་བརྒྱ་ལྔ་བཅུ་དང་། ནུབ་ཕྱོགས་སུ་ཁྲུ་ཉིས་བརྒྱ་ལྔ་བཅུ་ཡོད།"]},{"type":"verse","number":18,"content":["སྤྱི་གནས་ཀྱི་ལོགས་གཉིས་སུ་ལུས་པའི་ས་ནི་གནས་གཙང་མར་ཕུལ་བའི་ས་དེའི་རིང་ཚད་ལྟར་བརྩིས་ན། ཤར་ཕྱོགས་སུ་ཁྲུ་ཆིག་ཁྲི་དང་ནུབ་ཕྱོགས་སུའང་ཁྲུ་ཆིག་ཁྲི་ཡོད་པ་དང་། གནས་གཙང་མར་ཕུལ་བའི་ས་དེའི་འགྲམ་རྒྱུད་དུ་ཡོད་དོ། །ས་འདི་དག་ལས་ཐོན་པ་རྣམས་གྲོང་ཁྱེར་ནང་གི་ལས་བཟོ་པའི་ཁ་ཟས་སུ་བྱེད་དགོས།"]},{"type":"verse","number":19,"content":["གྲོང་ཁྱེར་ནང་གི་ལས་བཟོ་པ་རྣམས་ནི་ཡེས་ར་ཨེལ་གྱི་ཚོ་ཁག་སོ་སོ་ནས་འོངས་ཏེ་ས་འདི་རྨོ་དགོས།"]},{"type":"verse","number":20,"content":["གནས་གཙང་མར་ཕུལ་བའི་ས་ཆ་ཡོངས་ནི་རིང་ཚད་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་དང་ཞེང་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཅན་གྱི་དབྱིབས་གྲུ་བཞི་མ་ཞིག་ཡིན་ཏེ། ཁྱོད་རྣམས་ཀྱིས་གནས་གཙང་མར་འབུལ་བའི་ས་དེ་ནི་གྲོང་ཁྱེར་གྱི་ས་དང་མཉམ་དུ་འབུལ་དགོས།"]},{"type":"heading","content":["རྒྱལ་པོའི་ས་སྐལ།"]},{"type":"verse","number":21,"content":["ཡང་གནས་གཙང་མར་ཕུལ་བའི་ས་ཆ་དང་གྲོང་ཁྱེར་གྱི་ས་ཡི་གཡས་གཡོན་གཉིས་སུ་ལུས་པ་ཐམས་ཅད་རྒྱལ་པོར་དབང་བ་ཡིན་ཏེ། ཞེང་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡོད་པའི་གནས་གཙང་མར་ཕུལ་བའི་ས་དེའི་ཤར་ནས་ཤར་གྱི་ས་མཚམས་བར་དང་། ཡང་ཞེང་ལ་ཁྲུ་ཉིས་ཁྲི་ལྔ་སྟོང་ཡོད་པའི་གནས་གཙང་མར་ཕུལ་བའི་ས་དེའི་ནུབ་ནས་ནུབ་ཀྱི་ས་མཚམས་དང་། ས་སྐལ་དུ་བགོས་པའི་ཡུལ་གཞན་དག་ཁ་ཚང་རྒྱལ་པོར་དབང་བ་ཡིན། དེ་བཞིན་ཡར་ཕུལ་བའི་གནས་མཆོག་དང་མཆོད་ཁང་གི་གནས་དམ་པ་ནི་ས་དེ་གཉིས་ཀྱི་དབུས་སུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":22,"content":["ལེ་ཝི་པའི་ས་སྐལ་དང་གྲོང་ཁྱེར་གྱི་ས་ནི་རྒྱལ་པོའི་ས་སྐལ་གྱི་དབུས་སུ་ཡོད་པ་དང་། ཡང་རྒྱལ་པོའི་ས་སྐལ་ནི་ཡ་ཧུ་དཱའི་ས་མཚམས་དང་པེན་ཡཱ་མེན་གྱི་ས་མཚམས་གཉིས་ཀྱི་བར་དུ་ཡོད་དོ། །"]},{"type":"verse","number":23,"content":["ཡང་དེའི་འཕྲོས་ཚོ་པ་རྣམས་ལ་མཚོན་ན། ཤར་ནས་ནུབ་བར་དུ་པེན་ཡཱ་མེན་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":24,"content":["པེན་ཡཱ་མེན་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་སི་མུ་ཨོན་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":25,"content":["སི་མུ་ཨོན་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ཡེས་སི་ཀཱར་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":26,"content":["ཡེས་སི་ཀཱར་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་ཟེ་བུ་ལུན་གྱི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":27,"content":["ཟེ་བུ་ལུན་གྱི་ས་མཚམས་འགྲམ་རྒྱུད་ཀྱི་ཤར་ནས་ནུབ་བར་དུ་གཱ་རྡུ་ཡི་ས་སྐལ་ཡིན།"]},{"type":"verse","number":28,"content":["གཱ་རྡུའི་ལྷོ་ཕྱོགས་ཀྱི་ས་མཚམས་ནི་ཐལ་མཱར་ནས་མེ་རི་བཱ་ཀཱ་དེའེ་ཤཱའི་ཆུ་རྣམས་དང་། ཨེ་ཅིབ་ཀྱི་ཆུ་ཕྲན་རྣམས་བརྒྱུད་ནས་རྒྱ་མཚོ་ཆེན་པོར་སླེབས་པ་ཡིན།"]},{"type":"verse","number":29,"content":["འདི་ནི་ཁྱོད་ཚོས་རྒྱན་བླངས་ནས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་སོ་སོར་བགོ་དགོས་པའི་ས་སྐལ་ཡིན་ཏེ། ས་སྐལ་འདི་དག་ནི་ཁོ་ཚོར་ཐོབ་པའི་ནོར་སྐལ་ཡིན་ནོ་ཞེས་གཙོ་བོ་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["གྲོང་ཁྱེར་གསར་པའི་སྤྱིའི་རྒྱ་ཁྱོན་དང་མཁར་སྒོ་བཅུ་གཉིས།"]},{"type":"verse","number":30,"content":["གྲོང་ཁྱེར་བྱང་ཕྱོགས་ཀྱི་རིང་ཚད་ནི་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་ཡིན་ལ། གྲོང་ཁྱེར་གྱི་ཐོན་སྒོ་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":31,"content":["མཁར་སྒོ་རྣམས་ལ་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་རེ་རེ་བཞིན་དུ་མིང་འདོགས་དགོས་པ་དང་། བྱང་ཕྱོགས་སུ་རྒྱ་སྒོ་གསུམ་ཡོད་དེ། གཅིག་ནི་རུ་བེན་གྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ཡ་ཧུ་དཱའི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ལེ་ཝིའི་རྒྱ་སྒོ་ཡིན།"]},{"type":"verse","number":32,"content":["ཤར་ཕྱོགས་ཀྱི་རིང་ཚད་ནི་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་ཡིན་པ་དང་། རྒྱ་སྒོ་གསུམ་ཡོད་དེ། གཅིག་ནི་ཡོ་སེབ་ཀྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་པེན་ཡཱ་མེན་གྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་དཱན་གྱི་རྒྱ་སྒོ་ཡིན།"]},{"type":"verse","number":33,"content":["ལྷོ་ཕྱོགས་ཀྱི་རིང་ཚད་ནི་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་ཡིན་པ་དང་། རྒྱ་སྒོ་གསུམ་ཡོད་དེ། གཅིག་ནི་སི་མུ་ཨོན་གྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ཡེས་སི་ཀཱར་གྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ཟེ་བུ་ལུན་གྱི་རྒྱ་སྒོ་ཡིན།"]},{"type":"verse","number":34,"content":["ནུབ་ཕྱོགས་ཀྱི་རིང་ཚད་ནི་ཁྲུ་བཞི་སྟོང་ལྔ་བརྒྱ་ཡིན་པ་དང་། དེ་རུ་ཡང་རྒྱ་སྒོ་གསུམ་ཡོད་དེ། གཅིག་ནི་གཱ་རྡུ་ཡི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ཨ་ཤེར་གྱི་རྒྱ་སྒོ་དང་། གཅིག་ནི་ནཱབ་ཐ་ལིའི་རྒྱ་སྒོ་ཡིན།"]},{"type":"verse","number":35,"content":["གྲོང་ཁྱེར་མཐའ་འཁོར་གྱི་རིང་ཚད་ནི་ཁྲུ་ཆིག་ཁྲི་བརྒྱད་སྟོང་ཡིན་ཏེ། དུས་དེ་ནས་བཟུང་སྟེ་གྲོང་ཁྱེར་འདིའི་མིང་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་གནས་དེར་བཞུགས་པ་ཡིན་ཞེས་འདོགས་པར་འགྱུར་རོ་ཞེས་གསུངས་སོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZK/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/DAN/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZK/47.json","previousChapterAudioLinks":{},"numberOfVerses":35}