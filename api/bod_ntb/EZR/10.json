{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":10,"content":[{"type":"heading","content":["མི་རིགས་གཞན་དང་གཉེན་སྒྲིག་པ་མཚམས་འཇོག་པའི་ཐབས་བཀོད།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཨེས་སི་རཱ་ཡིས་དཀོན་མཆོག་གི་མཆོད་ཁང་མདུན་ནས་སྨོན་ལམ་ཞུས་ཏེ། འགྱོད་བཤགས་བྱས་ནས་ངུས་ཤིང་ཕྱག་བཙལ་ནས་སྡོད་སྐབས། ཡེས་ར་ཨེལ་པའི་སྐྱེས་པ་དང་བུད་མེད། བྱིས་པ་བཅས་ཀྱི་མི་ཚོགས་ཆེན་པོ་ཞིག་ཁོའི་རྩར་འདུས་ཏེ་སྡུག་བསྔལ་དང་བཅས་མཉམ་དུ་ངུས་སོ། །"]},{"type":"verse","number":2,"content":["དེར་ཨེ་ལཱམ་གྱི་བུ་རྒྱུད་དེ། ཡེ་ཧི་ཨེལ་གྱི་བུ་ཤེ་ཀན་ཡཱ་ཡིས་ཨེས་སི་རཱ་ལ་འདི་ལྟར། ངེད་ཅག་ནི་རང་གི་དཀོན་མཆོག་ལ་བློ་མི་དཀར་ཞིང་། ཡུལ་འདིའི་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་ཆུང་མར་བླངས་པ་ཡིན། འོན་ཀྱང་ཡེས་ར་ཨེལ་ལ་ད་དུང་རེ་བ་ཡོད་དེ།"]},{"type":"verse","number":3,"content":["ད་ལྟ་ངེད་ཅག་གིས་དཀོན་མཆོག་ལ་དམ་བཅས་ནས། ཕྱི་རོལ་པའི་བུད་མེད་དང་ཁོ་ཚོའི་ཕྲུ་གུ་རྣམས་ཕྱིར་བསྐྱལ་དགོས། བདག་པོ་ཁྱེད་དང་དཀོན་མཆོག་གི་བཀའ་ལ་འཇིགས་མཁན་རྣམས་ཀྱི་གྲོས་ཆོད་ནང་ལྟར་བཀའ་ཁྲིམས་བཞིན་བྱེད་པར་རིགས་སོ། །"]},{"type":"verse","number":4,"content":["ཁྱེད་རང་ཡར་བཞེང་བར་མཛོད། འདི་ཁྱེད་ཀྱི་ལས་འགན་ཡིན། ངེད་ཅག་གིས་ཁྱེད་ལ་རྒྱབ་སྐྱོར་བྱེད་ངེས་ཡིན། ཁྱེད་ཀྱིས་སྤོབས་པ་བསྐྱེད་ནས་བྱ་བ་བསྒྲུབ་པར་མཛོད་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":5,"content":["དེར་ཨེས་སི་རཱ་ཡར་ལངས་ནས། མཆོད་དཔོན་འགོ་ཁྲིད་དང་ལེ་ཝི་པ། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་དེ་བཞིན་དུ་བྱེད་པའི་མནའ་བཀལ་བས་ཁོ་རྣམས་ཀྱིས་མནའ་དེ་བསྐྱལ།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཨེས་སི་རཱ་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་མདུན་ནས་ལངས་ཏེ། ཨེལ་ཡཱ་ཤིབ་ཀྱི་བུ་ཡེ་ཧོ་ཧ་ནན་གྱི་ཁང་མིག་ཏུ་སོང་ནས། ཟས་མ་སྤྱད་ལ་ཆུ་ཡང་མ་འཐུང་། གང་ལ་ཞེ་ན། བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་རྣམས་ཀྱི་སྡིག་པའི་ཕྱིར་མྱ་ངན་བྱས་སོ། །"]},{"type":"verse","number":7,"content":["ཡང་འགོ་དཔོན་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་ཐམས་ཅད་ལ་བརྡ་བརྒྱབ་སྟེ། ཡེ་རུ་སཱ་ལེམ་དུ་འཛོམས་དགོས་པར་བསྒྲགས་ནས།"]},{"type":"verse","number":8,"content":["འགོ་དཔོན་རྣམས་དང་རྒན་པོ་རྣམས་ཀྱི་གྲོས་ཆོད་བཞིན་དུ་སུ་ཞིག་ཉིན་ཞག་གསུམ་གྱི་ནང་ཚུན་དུ་མ་འོངས་ན། མི་དེའི་ནོར་རྫས་ཐམས་ཅད་གཞུང་བཞེས་བྱེད་པ་དང་བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་རྣམས་ཀྱི་ཚོགས་ནས་ཀྱང་འདོན་པར་བྱའོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཉིན་གསུམ་གྱི་ནང་དུ་ཡ་ཧུ་དཱ་དང་པེན་ཡཱ་མེན་གྱི་མི་ཐམས་ཅད་ཡེ་རུ་སཱ་ལེམ་དུ་འཛོམས་ཤིང་། དེ་ནི་ཟླ་དགུ་བའི་ཚེས་ཉི་ཤུ་ཉིན་ཡིན་ལ། འབངས་མི་རྣམས་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཐང་ཆེན་ནས་བསྡད་པ་དང་། ཡང་བྱ་བ་དེའི་ཕྱིར་དང་ཆར་པ་ཡང་དྲག་པོ་བབས་པས་མི་རྣམས་འདར་བཞིན་ཡོད།"]},{"type":"verse","number":10,"content":["དེར་མཆོད་དཔོན་ཨེས་སི་རཱ་ཡར་ལངས་ནས་དེ་རྣམས་ལ། ཁྱོད་རྣམས་དཀོན་མཆོག་ལ་བློ་མི་དཀར་ཏེ། རྒྱུ་མཚན་ནི་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་རྣམས་ཆུང་མར་བླངས་ནས་ཡེས་ར་ཨེལ་གྱི་སྡིག་པ་སྔར་ལས་མང་དུ་བཏང་།"]},{"type":"verse","number":11,"content":["ད་ནི་རང་གི་ཕ་མེས་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འགྱོད་བཤགས་བྱས་ནས། ཁོང་གི་ཐུགས་དགོངས་བཞིན་དུ་ཡུལ་འདིའི་འབངས་མི་དང་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་རྣམས་དང་སོ་སོར་གྱེས་ཤིག་ཅེས་བསྐུལ་ཏོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་མི་ཚོགས་ཐམས་ཅད་ཀྱིས་སྐད་གསང་མཐོན་པོས་ལན་བཏབ་ནས་ན་རེ། ངེད་ཅག་གིས་ཁྱེད་ཀྱི་བསྒོ་བ་བཞིན་དུ་བསྒྲུབ་བོ། །"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་མི་ཚོགས་ནི་མང་པོ་ཡོད་པར་མ་ཟད་དུས་ཚིགས་འདི་ལ་ཆར་པའང་མང་བས། བདག་ཅག་ཕྱི་རོལ་ཏུ་ལངས་ནས་སྡོད་ཐབས་མེད། ཡང་བདག་ཅག་གིས་བྱ་བ་འདིའི་ཐད་ཉེས་པ་ཆེན་པོ་བྱས་པས། འདི་ནི་ཞག་གཅིག་གམ་གཉིས་ཀྱི་ནང་དུ་བསྒྲུབ་ཐུབ་པའི་ལས་མ་ཡིན།"]},{"type":"verse","number":14,"content":["བདག་ཅག་གི་འགོ་དཔོན་རྣམས་མི་ཚོགས་ཐམས་ཅད་ཀྱི་ཚབ་ཏུ་འདིར་བཞུགས་སུ་མཛོད་ཅིག བྱ་བ་འདིའི་རྐྱེན་གྱིས་བྱུང་བའི་དཀོན་མཆོག་གི་ཐུགས་ཁྲོ་དྲག་པོ་ཞི་བའི་བར་དུ། གྲོང་ཁྱེར་སོ་སོ་ནས་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་ཆུང་མར་བླངས་པ་ཐམས་ཅད་ནི། དུས་བཅད་ལྟར་གྲོང་ཁྱེར་དེའི་རྒན་པོ་དང་ཁྲིམས་དཔོན་རྣམས་མཉམ་དུ་ཡོང་ནས་ལས་འདི་བསྒྲུབ་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":15,"content":["གྲོས་འདི་ལ་ཨ་ས་ཧེལ་གྱི་བུ་ཡོ་ནཱ་ཐན་དང་ཏིག་ཝའི་བུ་ཡ་ཧ་ཟེ་གཉིས་མོས་མཐུན་མ་བྱུང་ལ། མཱེ་ཤུལ་ལིམ་དང་ལེ་ཝི་པ་ཤབ་བེ་ཐ་ཨི་གཉིས་ཀྱིས་དེ་རྣམས་ལ་རྒྱབ་སྐྱོར་མཛད།"]},{"type":"verse","number":16,"content":["དེ་ནས་བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་རྣམས་ཀྱིས་དེ་ལྟར་བསྒྲུབས་ཏེ། མཆོད་དཔོན་ཨེས་སི་རཱ་ཡིས་མིང་བཏོན་ནས་རུས་རྒྱུད་སོ་སོའི་ཚོ་དཔོན་རྣམས་བདམས་མངགས་བྱས་པ་དང་། ཟླ་བཅུ་པའི་ཚེས་གཅིག་ཉིན་ནས་བྱ་བ་འདིར་རྩད་གཅོད་བྱས་ནས།"]},{"type":"verse","number":17,"content":["ཟླ་དང་པོའི་ཚེས་གཅིག་ཉིན་ཁོ་རྣམས་ཀྱིས་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་ཆུང་མར་ལེན་མཁན་རྣམས་རྩད་ཆོད་དོ། །"]},{"type":"heading","content":["མི་རིགས་གཞན་ནས་ཆུང་མ་ལེན་མཁན་དག་གི་མིང་ཐོ།"]},{"type":"verse","number":18,"content":["མཆོད་དཔོན་གྱི་བུ་རྒྱུད་ཁྲོད་དུ་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་ཆུང་མར་ལེན་མཁན་རྣམས་ནི་ཡོ་ཚ་དག་གི་བུ་ཡེ་ཤུ་ཨ་ཡི་བུ་རྒྱུད་དང་སྤུན་རྣམས་ལས། མ་ཨ་སེ་ཡཱ་དང་། ཨེ་ལི་ཨེ་བཟིར། ཡཱ་རིབ། གེ་དལ་ཡཱ་བཅས་སོ། །"]},{"type":"verse","number":19,"content":["དེ་དག་གིས་རང་གི་ཆུང་མ་རྣམས་སྤངས་པའི་དམ་བཅའ་བཞག་ནས་སྡིག་བཤགས་མཆོད་པ་ཕུལ་བ་སྟེ། རང་རང་གི་སྡིག་པའི་དོན་དུ་ལུག་ཁྱུ་ནས་ལུག་ཐུག་ཅིག་མཆོད་པར་ཕུལ།"]},{"type":"verse","number":20,"content":["ཡང་ཨིམ་མེར་གྱི་བུ་རྒྱུད་རྣམས་ལས་ཧ་ནཱ་ནེ་དང་ཟེ་བད་ཡཱ་གཉིས་ཡོད་ཅིང་།"]},{"type":"verse","number":21,"content":["ཧ་རིམ་གྱི་བུ་རྒྱུད་རྣམས་ལས་མ་ཨ་སེ་ཡཱ་དང་། ཨེ་ལི་ཡཱ། ཤེ་མ་ཡཱ། ཡེ་ཧི་ཨེལ། ཨུ་ཟི་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":22,"content":["ཕཱ་ཤུར་གྱི་བུ་རྒྱུད་རྣམས་ལས་ཨེལ་ཡོ་ཨེ་ནཱ་ཨི། མ་ཨ་སེ་ཡཱ། ཡེས་མ་ཨེལ། ནེ་ཐན་ཨེལ། ཡོ་ཟཱ་བད། ཨེ་ལ་ཟ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":23,"content":["ལེ་ཝི་པ་རྣམས་ལས་ཡོ་ཟཱ་བད་དང་། ཤིམ་ཨི། ཀེ་ལ་ཡཱའམ་ཀེ་ལི་ཏ་བྱ་བ། ཕེ་ཐ་ཡཱ། ཡ་ཧུ་དཱ། ཨེ་ལི་ཨེ་བཟིར་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":24,"content":["མགུར་ལེན་མཁན་རྣམས་ལས་ཨེལ་ཡཱ་ཤིབ་དང་། སྒོ་སྲུང་རྣམས་ལས་ཤལ་ལུམ་དང་། ཏེ་ལེམ། ཨུ་རི་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":25,"content":["ཡེས་ར་ཨེལ་པ་ཕཱར་ཨོ་སིའི་བུ་རྒྱུད་རྣམས་ལས་རམ་ཡཱ་དང་། ཡི་ཟི་ཡཱ། མལ་ཀི་ཡཱ། མི་ཡཱ་མིན། ཨེ་ལི་ཨ་ཟར། མལ་ཀི་ཡཱ། པེ་ན་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":26,"content":["ཨེ་ལཱམ་གྱི་བུ་རྒྱུད་རྣམས་ལས་མད་ཐན་ཡཱ་དང་། ཟཱ་ཀར་ཡ། ཡེ་ཧི་ཨེལ། ཨབ་དི། ཡེ་རེ་མོད། ཨེ་ལི་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":27,"content":["ཟད་ཐུའི་བུ་རྒྱུད་རྣམས་ལས་ཨེལ་ཡོ་ཨེ་ནཱ་ཨི་དང་། ཨེལ་ཡཱ་ཤིབ། མད་ཐན་ཡཱ། ཡེ་རེ་མོད། ཟཱ་བད། ཨ་ཟི་ཟ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":28,"content":["པེ་བཱ་ཨིའི་བུ་རྒྱུད་རྣམས་ལས་ཡེ་ཧོ་ཧ་ནན་དང་། ཧ་ནན་ཡཱ། ཟ་བཱ་ཨི། ཨད་ལཱ་ཨི་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":29,"content":["པཱ་ནིའི་བུ་རྒྱུད་རྣམས་ལས་མཱེ་ཤུལ་ལིམ་དང་། མལ་ལུག ཨ་ད་ཡཱ། ཡ་ཤུབ། ཤེ་ཨལ། རཱ་མོད་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":30,"content":["ཕཱ་ཧད་མོ་ཨབ་ཀྱི་བུ་རྒྱུད་རྣམས་ལས་ཨད་ནཱ་དང་། ཁེ་ལམ། པེ་ན་ཡཱ། མ་ཨ་སེ་ཡཱ། མད་ཐན་ཡཱ། པེ་ཟལ་ཨེལ། པིན་ནུ་ཨི། མ་ན་ཤེ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":31,"content":["ཧ་རིམ་གྱི་བུ་རྒྱུད་རྣམས་ལས་ཨེ་ལི་ཨེ་བཟིར་དང་། ཨི་ཤི་ཡཱ། མལ་ཀི་ཡཱ། ཤེ་མ་ཡཱ། སི་མུ་ཨོན།"]},{"type":"verse","number":32,"content":["པེན་ཡཱ་མེན། མལ་ལུག ཤེ་མར་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":33,"content":["ཧ་ཤུམ་གྱི་བུ་རྒྱུད་རྣམས་ལས་མད་ཏེ་ནཱ་ཨི་དང་། མད་ཐད་ཐཱ། ཟཱ་བད། ཨེ་ལི་ཕེ་ལེད། ཡེ་རེ་མཱ་ཨི། མ་ན་ཤེ། ཤིམ་ཨི་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":34,"content":["པཱ་ནིའི་བུ་རྒྱུད་རྣམས་ལས་མ་ཨ་དཱ་ཨི་དང་། ཨམ་རམ། ཨུ་ཨེལ།"]},{"type":"verse","number":35,"content":["པེ་ན་ཡཱ། པེ་དེ་ཡཱ། ཁེ་ལུ་ཧི།"]},{"type":"verse","number":36,"content":["ཝན་ཡཱ། མེ་རེ་མོད། ཨེལ་ཡཱ་ཤིབ།"]},{"type":"verse","number":37,"content":["མད་ཐན་ཡཱ། མད་ཏེ་ནཱ་ཨི། ཡ་ཡ་སུ།"]},{"type":"verse","number":38,"content":["པཱ་ནི། པིན་ནུ་ཨི། ཤིམ་ཨི།"]},{"type":"verse","number":39,"content":["ཤེ་ལེམ་ཡཱ། ནཱ་ཐན། ཨ་ད་ཡཱ།"]},{"type":"verse","number":40,"content":["མག་ནཱད་བ་ཨི། ཤ་ཤ་ཨི། ཤ་ར་ཨི།"]},{"type":"verse","number":41,"content":["ཨ་ཟར་ཨེལ། ཤེ་ལེམ་ཡཱ། ཤེ་མར་ཡཱ།"]},{"type":"verse","number":42,"content":["ཤལ་ལུམ། ཨ་མར་ཡཱ། ཡོ་སེབ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":43,"content":["ནེ་བོའི་བུ་རྒྱུད་རྣམས་ལས་ཡེ་ཨི་ཨེལ་དང་། མད་ཏིད་ཡཱ། ཟཱ་བད། ཟེ་བི་ནཱ། ཡད་དཱ་ཨི། ཡོ་ཨེལ། པེ་ན་ཡཱ་བཅས་ཡོད་དོ། །"]},{"type":"verse","number":44,"content":["དེ་ཐམས་ཅད་ཀྱིས་ཕྱི་ཕྱོགས་ཀྱི་བུད་མེད་ཆུང་མར་བླངས་པ་དང་། འགའ་ཞིག་གི་ཆུང་མར་ཕྲུ་གུ་ཡང་སྐྱེས་ཡོད་དོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NEH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/9.json","previousChapterAudioLinks":{},"numberOfVerses":44}