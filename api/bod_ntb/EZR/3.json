{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":3,"content":[{"type":"heading","content":["དཀོན་མཆོག་ལ་བརྟེན་པའི་འཚོ་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཟླ་བདུན་པ་ལོན་པའི་ཚེ། གྲོང་ཁྱེར་སོ་སོར་གནས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་བློ་སེམས་གཅིག་མཐུན་ངང་མཉམ་དུ་འཛོམས་ཏེ།"]},{"type":"verse","number":2,"content":["ཡོ་ཚ་དག་གི་བུ་ཡེ་ཤུ་ཨ་དང་། ཁོའི་སྤུན་མཆོད་དཔོན་རྣམས་དང་། ཞིད་ཨལ་ཐེ་ཨེལ་གྱི་བུ་ཟེ་རུ་པཱ་པེལ་དང་། ཁོའི་སྤུན་རྣམས་ཡོང་ནས་དཀོན་མཆོག་གི་སྐྱེས་བུ་མོ་ཤེའི་བཀའ་ཁྲིམས་ནང་བཀོད་པ་བཞིན་དུ། སྦྱིན་སྲེག་གི་མཆོད་པ་འབུལ་ཕྱིར་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་མཆོད་ཁྲི་བཞེངས་སོ། །"]},{"type":"verse","number":3,"content":["ཁོ་ཚོ་ཡུལ་མི་རྣམས་ལ་འཇིགས་པས། མཆོད་ཁྲི་དེ་སྔར་གནས་སུ་བཞེངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ནངས་དགོང་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་བ་དང་།"]},{"type":"verse","number":4,"content":["ཡང་མདོ་ནང་བཀོད་པ་བཞིན་དུ། དེ་དག་གིས་སྤྱིལ་བུའི་དུས་ཆེན་རོལ་ཏེ་ཁྲིམས་སྲོལ་ལྟར་སྦྱིན་སྲེག་གི་མཆོད་པ་ནི་ཉིན་རེའི་གྲངས་ཀ་བཞིན་དུ་ཕུལ།"]},{"type":"verse","number":5,"content":["ཡང་དེའི་རྗེས་སུ་དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་གི་མཆོད་པ་ཕུལ་བ་དང་། ཚེས་གཅིག་གི་མཆོད་པ་དང་དཀོན་མཆོག་ཡ་ཝཱེའི་དམ་པར་བྱས་པའི་དུས་ཆེན་གྱི་མཆོད་པ་དང་། ཡང་མི་རེ་རེས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་ཡིད་མོས་མཆོད་པ་ཕུལ།"]},{"type":"verse","number":6,"content":["ཟླ་བདུན་པའི་ཚེས་གཅིག་ཉིན་ནས་བཟུང་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་རྨང་གཞི་ད་དུང་བཏིངས་མེད་ན་ཡང་། ཁོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྦྱིན་སྲེག་གི་མཆོད་པ་འབུལ་བའི་འགོ་བརྩམས།"]},{"type":"verse","number":7,"content":["ཡང་དེ་དག་གིས་རྡོ་བཟོ་དང་ཤིང་བཟོ་ལ་དངུལ་སྤྲད་དེ། ཏ་ཟིག་གི་རྒྱལ་པོ་ཀོ་རེས་ཀྱི་བཀའ་བཞིན་དུ། ལེ་པཱ་ནོན་ནས་རྒྱ་མཚོ་བརྒྱུད་དེ་ཡོ་ཕཱའི་བར་དུ་ཐང་ཤིང་འདྲེན་པའི་ཕྱིར། ཚི་ཏུན་པ་དང་ཐཱར་པ་རྣམས་ལ་བཟའ་བཏུང་དང་སྣུམ་བཅས་སྤྲད་དོ། །"]},{"type":"heading","content":["མཆོད་ཁང་བསྐྱར་བཞེངས་ཀྱི་འགོ་བརྩམས་པ།"]},{"type":"verse","number":8,"content":["ཁོ་ཚོ་ཡེ་རུ་སཱ་ལེམ་དུ་དཀོན་མཆོག་གི་མཆོད་ཁང་བཞེངས་སར་སླེབས་པའི་ལོ་གཉིས་པའི་ཟླ་གཉིས་པར། ཞིད་ཨལ་ཐེ་ཨེལ་གྱི་བུ་ཟེ་རུ་པཱ་པེལ་དང་། ཡོ་ཚ་དག་གི་བུ་ཡེ་ཤུ་ཨ་དང་། དེ་དག་གི་སྤུན་མཆོད་དཔོན་རྣམས་དང་། ལེ་ཝི་པ་རྣམས་དང་། བཙོན་ལས་ཐར་ཏེ་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོང་བ་རྣམས་ཀྱིས་ལས་འགོ་བརྩམས་པ་དང་། ལེ་ཝི་པ་ལོ་ཉི་ཤུ་ཡན་ལོན་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ལས་ཀའི་ལྟ་སྐུལ་བ་བྱེད་དུ་བཅུག"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡ་ཧུ་དཱའི་བུ་རྒྱུད་དེ། ཡེ་ཤུ་ཨ་དང་ཁོའི་བུ་རྒྱུད་དང་སྤུན་རྣམས་དང་། ཀད་མི་ཨེལ་དང་ཁོའི་བུ་རྒྱུད་རྣམས་ནི་ལེ་ཝི་པ་ཧེ་ན་དད་ཀྱི་བུ་རྒྱུད་དང་སྤུན་རྣམས་དང་བཅས་འཛོམས་ནས། བློ་སེམས་རྩེ་གཅིག་ངང་དཀོན་མཆོག་གི་མཆོད་ཁང་བཞེང་བའི་ལས་བཟོ་པ་རྣམས་ལ་ལྟ་སྐུལ་བྱས།"]},{"type":"verse","number":10,"content":["ལས་བཟོ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་རྨང་གཞི་འདིང་བའི་ཚེ། མཆོད་དཔོན་གྱིས་ཆོས་གོས་གྱོན་ཏེ་དུང་ཐོགས་པ་དང་། ལེ་ཝི་པ་ཨ་སབ་ཀྱི་བུ་རྒྱུད་ཀྱིས་སྦུག་ཆལ་བརྡུངས་པ་དང་། ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་དཱ་བིད་ཀྱིས་བཙུགས་པའི་ཁྲིམས་བཞིན་དུ་ཡར་ལངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པ་ཕུལ་ཏེ།"]},{"type":"verse","number":11,"content":["ཁོ་ཚོས་མཉམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པ་དང་གཏང་རག་ཕུལ་ཞིང་འདི་ལྟར། ཁོང་ནི་བཟང་པོ་ལགས་ཤིང་། ཁོང་གིས་ཡེས་ར་ཨེལ་ལ་བཅངས་པའི་བྱམས་བརྩེ་རྒྱུན་ནས་རྒྱུན་དུ་གནས་སོ་ཞེས་བསྟོད་དབྱངས་ཕུལ་བ་དང་། ཁོ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་བསྔགས་འབུལ་བའི་དུས་སུ། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་རྨང་གཞི་བཏིངས་ཟིན་པས་མི་ཚོགས་ཀྱིས་སྐད་ཆེན་པོས་ཀི་སྒྲ་བསྒྲགས་སོ། །"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་མཆོད་དཔོན་མང་པོ་དང་ལེ་ཝི་པ། ཚོ་དཔོན་བཅས་སྔར་གྱི་མཆོད་ཁང་མཐོང་མྱོང་བའི་རྒན་པོ་མང་པོས་མཆོད་ཁང་འདིའི་རྨང་གཞི་ཡང་བསྐྱར་བཏིངས་པ་མཐོང་ནས་སྐད་ཆེན་པོས་ངུས་པ་དང་། ཡང་མི་མང་པོས་དགའ་སྤྲོའི་འབོད་སྒྲ་མཐོན་པོར་བསྒྲགས་པ་ལ།"]},{"type":"verse","number":13,"content":["དགའ་བའི་སྒྲ་དང་ངུ་བའི་སྒྲ་གང་ཡིན་ཁྱད་འབྱེད་མ་ནུས། གང་ལ་ཞེ་ན། འབངས་མི་རྣམས་ཀྱིས་སྐད་ཤིན་ཏུ་ཆེན་པོ་བཏོན་ཏེ། རྒྱང་རིང་ནས་ཀྱང་འུར་སྒྲ་དེ་ཐོས་ཐུབ་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZR/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/2.json","previousChapterAudioLinks":{},"numberOfVerses":13}