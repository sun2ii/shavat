{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":5,"content":[{"type":"heading","content":["མཆོད་ཁང་ཡང་བསྐྱར་བཞེང་བའི་བྱ་བ་རྒྱུན་བསྐྱངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ལུང་སྟོན་པ་ཧག་གཱ་ཨི་དང་། ཨིད་དོའི་བུ་རྒྱུད་དེ་ལུང་སྟོན་པ་ཟཱ་ཀར་ཡ་གཉིས་ཀྱིས་ཡ་ཧུ་དཱ་ཡུལ་དང་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་མཚན་བརྗོད་ནས་ལུང་བསྟན་གནང་།"]},{"type":"verse","number":2,"content":["དེ་ནས་ཞིད་ཨལ་ཐེ་ཨེལ་གྱི་བུ་ཟེ་རུ་པཱ་པེལ་དང་ཡོ་ཚ་དག་གི་བུ་ཡེ་ཤུ་ཨ་གཉིས་ལངས་ཏེ། ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་དེ་ཡང་བསྐྱར་བཞེང་བའི་འགོ་བརྩམས་ནས། དེ་དག་ལ་དཀོན་མཆོག་གི་ལུང་སྟོན་པས་རྒྱབ་སྐྱོར་མཛད་དོ། །"]},{"type":"verse","number":3,"content":["དུས་དེ་ཉིད་དུ་གཙང་པོའི་ཕ་རོལ་གྱི་སྤྱི་དཔོན་ཐད་ན་ཨི་དང་། ཧྲི་ཐིར་པོ་ཟི་ནཱ་ཨི་དང་། དེའི་གྲོས་མི་རྣམས་འོངས་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ། སུ་ཞིག་གིས་ཁྱོད་ཅག་ལ་མཆོད་ཁང་འདི་ཡང་བསྐྱར་བཞེང་བར་བཀའ་བསྩལ་ལམ་ཞེས་དང་།"]},{"type":"verse","number":4,"content":["ཡང་དེ་དག་གིས། བཟོ་སྐྲུན་འདིའི་འགན་འཁུར་མཁན་རྣམས་ཀྱི་མིང་ལ་ཅི་ཟེར་རམ་ཞེས་དྲིས།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་ཡ་ཧུ་དཱ་པའི་རྒན་པོ་རྣམས་ལ་དཀོན་མཆོག་གིས་གཟིགས་སྐྱོང་མཛད་པས། དར་ཡཱ་ལ་སྙན་ཞུ་ཞིག་ཕུལ་བ་དང་། དེར་བཀའ་ལན་འཐོབ་པའི་བར་དུ་མི་སུས་ཀྱང་ཁོ་ཚོའི་ལས་ཀར་བཀག་འགོག་མ་བྱས།"]},{"type":"verse","number":6,"content":["ཡང་གཙང་པོའི་ཕ་རོལ་གྱི་སྤྱི་དཔོན་ཐད་ན་ཨི་དང་། ཧྲི་ཐིར་པོ་ཟི་ནཱ་ཨི་དང་། དེའི་གྲོས་མི་རྣམས་ཏེ། གཙང་པོའི་ཕ་རོལ་གྱི་འགོ་དཔོན་རྣམས་ཀྱིས་རྒྱལ་པོ་དར་ཡཱ་ལ་ཕུལ་བའི་སྙན་ཞུ་བཤུས་མ་ནི་འདི་ལྟར་ཡིན།"]},{"type":"verse","number":7,"content":["དེའི་ནང་དུ་འདི་ལྟར་བྲིས་ཡོད་དེ། རྒྱལ་པོ་དར་ཡཱ་ཁྱེད་ཉིད་ཕྱོགས་ཀུན་ནས་བདེ་བར་སྨོན།"]},{"type":"verse","number":8,"content":["རྒྱལ་པོ་ཆེན་པོས་མཁྱེན་རོགས་ཞུ། བདག་ཅག་ཡ་ཧུ་དཱ་ཡུལ་གྱི་དཀོན་མཆོག་ཆེན་པོའི་མཆོད་ཁང་དུ་སོང་བ་ན། དེ་རྣམས་ཀྱིས་མཆོད་ཁང་ནི་རྡོ་ཕ་བོང་ཆེན་པོས་བརྩིགས་ཏེ། གྱང་གི་ནང་དུ་གདུང་མ་བཅུག་ཡོད། ལས་ཀ་འདི་ནི་མྱུར་དུ་བྱས་པ་དང་། དེ་དག་གིས་ལེགས་པར་སྒྲུབ་བཞིན་འདུག"]},{"type":"verse","number":9,"content":["དེ་ནས་བདག་ཅག་གིས་རྒན་པོ་རྣམས་ལ། སུ་ཞིག་གིས་ཁྱོད་ཅག་ལ་མཆོད་ཁང་འདི་ཡང་བསྐྱར་བཞེང་བར་བཀའ་བསྩལ་ལམ་ཞེས་དྲིས་པ་དང་།"]},{"type":"verse","number":10,"content":["དེ་དག་གི་འགོ་དཔོན་སུ་ཡིན་པའི་འཕྲིན་ཁྱེད་ལ་འབུལ་བའི་ཕྱིར་སོ་སོའི་མིང་ཡང་དྲིས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["ཁོ་ཚོས་ངེད་རྣམས་ཀྱི་ལན་དུ། ངེད་ཅག་ནི་གནམ་ས་གཉིས་ཀྱི་དཀོན་མཆོག་གི་ཞབས་ཕྱི་ཡིན་ཏེ། ལོ་མང་པོའི་སྔོན་དུ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཆེན་པོ་ཞིག་གིས་བཞེངས་པའི་མཆོད་ཁང་འདི་ཡང་བསྐྱར་བཞེང་བཞིན་ཡོད།"]},{"type":"verse","number":12,"content":["འོན་ཀྱང་ངེད་རྣམས་ཀྱི་ཕ་མེས་རྣམས་ཀྱིས་ནམ་མཁའི་དཀོན་མཆོག་ཐུགས་ཁྲོས་པར་བྱས་པས། ཁོང་གིས་དེ་རྣམས་ཀལ་དི་པ་ཡིན་པའི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་ལག་ཏུ་སྤྲད་དེ། མཆོད་ཁང་བཤིགས་ནས་མི་རྣམས་པཱ་པེལ་ལོན་དུ་བཙན་ཁྲིད་བྱས།"]},{"type":"verse","number":13,"content":["ཡིན་ཡང་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ཀོ་རེས་ཀྱིས་རྒྱལ་སྲིད་བསྐྱངས་པའི་ལོ་དང་པོར། རྒྱལ་པོས་དཀོན་མཆོག་གི་མཆོད་ཁང་བཞེང་བར་བཀའ་གནང་ངོ་། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་གི་མཆོད་ཁང་གི་གསེར་དངུལ་གྱི་སྣོད་ཆས་ཏེ། ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཡེ་རུ་སཱ་ལེམ་གྱི་མཆོད་ཁང་ནས་ཕྲོགས་ཏེ། པཱ་པེལ་ལོན་གྱི་ལྷ་ཁང་དུ་ཁྱེར་བ་དག་ཀྱང་རྒྱལ་པོ་ཀོ་རེས་ཀྱིས་པཱ་པེལ་ལོན་གྱི་ལྷ་ཁང་ནས་ཕྱིར་བླངས་ཤིང་། ཁོ་རང་ཉིད་ཀྱིས་འགོ་དཔོན་དུ་བསྐོས་པའི་ཤེ་སཱ་པ་ཙར་བྱ་བའི་ལག་ཏུ་སྤྲད་དེ།"]},{"type":"verse","number":15,"content":["ཁོ་ལ་སྣོད་ཆས་འདི་དག་ཡེ་རུ་སཱ་ལེམ་གྱི་མཆོད་ཁང་དུ་ཁྱེར་ནས་དཀོན་མཆོག་གི་མཆོད་ཁང་དེ་སྔར་གནས་སུ་བཞེང་བར་གྱིས་ཞེས་བཀའ་བསྩལ།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཤེ་སཱ་པ་ཙར་ཕྱིར་འོངས་ནས། ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་རྨང་གཞི་བཏིངས་པ་དང་། དུས་དེ་ནས་བཟུང་ད་ལྟའི་བར་དུ་བཞེང་བཞིན་ཡོད་ཀྱང་ད་དུང་མ་འགྲུབ་བོ་ཞེས་སྨྲས་བྱུང་ངོ་། །"]},{"type":"verse","number":17,"content":["གལ་ཏེ་རྒྱལ་པོ་ཐུགས་མོས་ན། པཱ་པེལ་ལོན་དུ་ཡོད་པའི་རྒྱལ་པོའི་ཡིག་ཚང་ཁང་དུ་རྩད་གཅོད་མཛད་ནས། རྒྱལ་པོ་ཀོ་རེས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་དཀོན་མཆོག་གི་མཆོད་ཁང་ཡང་བསྐྱར་བཞེང་བའི་ཕྱིར་བཀའ་བསྩལ་བའི་གོང་མའི་བཀའ་ཡིག་ཡོད་མེད་ལ་གཟིགས་རོགས། ཡང་རྒྱལ་པོ་ལགས་ཀྱིས་བདག་ཅག་ལ་བྱ་གཞག་འདིའི་ཐད་ཀྱི་དགོངས་པ་སྟོན་པར་མཛོད་ཅེས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZR/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/4.json","previousChapterAudioLinks":{},"numberOfVerses":17}