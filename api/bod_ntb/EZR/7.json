{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":7,"content":[{"type":"heading","content":["ཨེས་སི་རཱ་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་ལོག་པ།"]},{"type":"verse","number":1,"content":["ཡང་དོན་དེ་དག་གི་རྗེས་སུ། ཏ་ཟིག་གི་རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་ཡིས་རྒྱལ་སྲིད་འཛིན་པའི་དུས་སུ། ཨེས་སི་རཱ་བྱ་བ་ཞིག་ཡོད་དེ། ཨེས་སི་རཱ་ནི་སེ་ར་ཡཱའི་བུ་ཡིན། སེ་ར་ཡཱ་ནི་ཨ་ཟར་ཡཱ་ཡི་བུ་ཡིན། ཨ་ཟར་ཡཱ་ནི་ཧིལ་ཀི་ཡཱའི་བུ་ཡིན།"]},{"type":"verse","number":2,"content":["ཧིལ་ཀི་ཡཱ་ནི་ཤལ་ལུམ་གྱི་བུ་ཡིན། ཤལ་ལུམ་ནི་ཟཱ་ཏོག་གི་བུ་ཡིན། ཟཱ་ཏོག་ནི་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཡིན།"]},{"type":"verse","number":3,"content":["ཨ་ཧི་ཏུབ་ནི་ཨ་མར་ཡཱའི་བུ་ཡིན། ཨ་མར་ཡཱ་ནི་ཨ་ཟར་ཡཱའི་བུ་ཡིན། ཨ་ཟར་ཡཱ་ནི་མེ་ར་ཡོད་ཀྱི་བུ་ཡིན།"]},{"type":"verse","number":4,"content":["མེ་ར་ཡོད་ནི་ཟེ་རཱ་ཡཱའི་བུ་ཡིན། ཟེ་རཱ་ཡཱ་ནི་ཨུ་ཟིའི་བུ་ཡིན། ཨུ་ཟི་ནི་པུག་ཀིའི་བུ་ཡིན།"]},{"type":"verse","number":5,"content":["པུག་ཀི་ནི་ཨ་བི་ཤུ་ཨའི་བུ་ཡིན། ཨ་བི་ཤུ་ཨ་ནི་ཕི་ནེ་ཧེའི་བུ་ཡིན། ཕི་ནེ་ཧེ་ནི་ཨེ་ལི་ཨ་ཟར་གྱི་བུ་ཡིན། ཨེ་ལི་ཨ་ཟར་ནི་མཆོད་དཔོན་ཆེན་པོ་ཨ་རོན་གྱི་བུ་ཡིན།"]},{"type":"verse","number":6,"content":["ཨེས་སི་རཱ་འདི་ནི་པཱ་པེལ་ལོན་ནས་ཡར་ཕྱིན་ཏེ། ཁོ་ནི་དྲུང་ཡིག་ཅིག་ཡིན་པ་དང་། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་གནང་བའི་བཀའ་ཁྲིམས་ལ་ཤིན་ཏུ་མཁས་པ་ཡིན་ལ། ཁོའི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་རོགས་རམ་མཛད་པས། རྒྱལ་པོས་ཁོས་ཞུ་བ་ལྟར་གནང་ངོ་། །"]},{"type":"verse","number":7,"content":["ཡང་རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་ཡིས་རྒྱལ་སྲིད་འཛིན་པའི་ལོ་བདུན་པར། ཡེས་ར་ཨེལ་གྱི་མི་འགའ་ཞིག་དང་། མཆོད་དཔོན་འགའ་ཞིག་དང་། ལེ་ཝི་པ། མཆོད་ཁང་གི་མགུར་ལེན་མཁན། སྒོ་སྲུང་། མཆོད་གཡོག་འགའ་ཞིག་བཅས་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་སོང་།"]},{"type":"verse","number":8,"content":["ཡང་རྒྱལ་པོ་དེའི་ལོ་བདུན་པའི་ཟླ་ལྔ་བའི་ནང་དུ་ཨེས་སི་རཱ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིན།"]},{"type":"verse","number":9,"content":["ཁོ་ནི་ཟླ་དང་པོའི་ཚེས་གཅིག་ཉིན་པཱ་པེལ་ལོན་ནས་ལམ་དུ་ཆས་ཤིང་། ཁོའི་དཀོན་མཆོག་གིས་རོགས་རམ་མཛད་པས། ཟླ་ལྔ་བའི་ཚེས་གཅིག་ཉིན་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས།"]},{"type":"verse","number":10,"content":["ཡང་ཨེས་སི་རཱ་ཡིས་བློ་སེམས་རྩེ་གཅིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་སྦྱངས་ནས་དེ་བཞིན་བརྩིས་པ་དང་། བཀའ་རྒྱ་དང་སྒྲིག་སྲོལ་དག་གིས་ཡེས་ར་ཨེལ་གྱི་འབངས་མི་ལ་མཛུབ་སྟོན་གནང་ངོ་། །"]},{"type":"heading","content":["རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་ཡིས་ཨེས་སི་རཱ་ལ་བཀའ་བསྩལ་པ།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁྲིམས་དང་ཡེས་ར་ཨེལ་ལ་གནང་བའི་བཀའ་རྒྱ་རྣམས་སྦྱོང་མཁན་གྱི་མཆོད་དཔོན་དང་དྲུང་ཡིག་ཨེས་སི་རཱ་བྱ་བ་ལ་རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་ཡིས་གནང་བའི་བཀའ་ཡིག་གི་ངོ་བཤུས་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":12,"content":["རྒྱལ་པོ་རྣམས་ཀྱི་རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་ཡིས། ནམ་མཁའི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བྱང་དུ་ཆུབ་པའི་དཔེ་ཆ་པ་མཆོད་དཔོན་ཨེས་སི་རཱ་ལ་གོང་མའི་བཀའ་ཡིག་སྤྲིངས་དོན་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":13,"content":["ངའི་རྒྱལ་ཁམས་སུ་ཡོད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ལས། ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་འགྲོ་འདོད་པའི་མཆོད་དཔོན་དང་ལེ་ཝི་པ་ཐམས་ཅད་ཁྱོད་དང་མཉམ་དུ་སོང་ཆོག"]},{"type":"verse","number":14,"content":["ཁྱོད་ནི་རྒྱལ་པོ་དང་གྲོས་མི་བདུན་པོས་མངགས་པ་ཡིན་པས། ཁྱོད་ཀྱི་ལག་ཏུ་ཡོད་པའི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ལྟར་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་གནས་ཚུལ་ལ་རྩད་ཆོད་ཅིག"]},{"type":"verse","number":15,"content":["རྒྱལ་པོ་དང་གྲོས་མི་རྣམས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས་པའི་དཀོན་མཆོག་ལ་དགའ་མགུ་ངང་ཕུལ་བའི་གསེར་དངུལ་ཡང་ཁྱོད་ཀྱིས་འཁྱེར་དགོས།"]},{"type":"verse","number":16,"content":["དེར་མ་ཟད། ཁྱོད་ཀྱིས་པཱ་པེལ་ལོན་གྱི་ཡུལ་ཐམས་ཅད་ནས་བསྡུས་པའི་གསེར་དངུལ་དང་། འབངས་མི་དང་མཆོད་དཔོན་རྣམས་ཀྱིས་ཡིད་མོས་ངང་ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་ཕུལ་བའི་ལེགས་སྐྱེས་དག་ཀྱང་འཁྱེར་དགོས།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་དངུལ་འདི་ལས་གཟབ་ནན་གྱིས་གླང་དང་ལུག་ཐུག་དང་ལུ་གུ་དང་། འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་ཉོས་ནས། ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་ཁྱོད་ཚོའི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་མཆོད་ཁྲིའི་སྟེང་ནས་མཆོད་ཅིག"]},{"type":"verse","number":18,"content":["ཡང་གསེར་དངུལ་ལྷག་མ་དེ་དག་ནི། ཁྱོད་ཚོའི་དཀོན་མཆོག་གི་དགོངས་པ་བཞིན་དུ། ཁྱོད་དང་ཁྱོད་ཀྱི་སྤུན་རྣམས་ཀྱིས་གང་ལེགས་པར་བསམས་ན་དེ་བཞིན་གྱིས་ཤིག"]},{"type":"verse","number":19,"content":["ཡང་ཁྱོད་ལ་བཅོལ་བའི་དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་ཞབས་ཕྱི་སྒྲུབ་བྱེད་ཀྱི་སྣོད་ཆས་རྣམས་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་ལ་ཕུལ་ཞིག"]},{"type":"verse","number":20,"content":["དེ་མིན་ཁྱོད་ཀྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་ཅི་ཞིག་མཁོ་ན། འགྲོ་གྲོན་ཚང་མ་རྒྱལ་པོའི་བང་མཛོད་ནས་ལོངས་ཤིག"]},{"type":"verse","number":21,"content":["རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐི་བདག་གིས་གཙང་པོའི་ཕ་རོལ་གྱི་ཕྱག་མཛོད་ཐམས་ཅད་ལ་བཀའ་འདི་གནང་བ་ཡིན། ནམ་མཁའི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ལ་མཁས་པའི་དཔེ་ཆ་པ་མཆོད་དཔོན་ཨེས་སི་རཱ་ལ་ཁྱོད་ཅག་ལས་ཅི་དགོས་ན་མྱུར་དུ་སྒྲུབས་ཤིག"]},{"type":"verse","number":22,"content":["དངུལ་གྱི་རྡོ་ཚད་བརྒྱ་དང་། གྲོ་ཁལ་བརྒྱ། རྒུན་ཆང་ཆུ་བེན་བརྒྱ། སྐྱུ་རུའི་ཚི་སྣུམ་ཆུ་བེན་བརྒྱ། ཚྭ་འདོད་པ་བཞིན་དུ་འབུལ་དགོས།"]},{"type":"verse","number":23,"content":["ནམ་མཁར་བཞུགས་པའི་དཀོན་མཆོག་གིས་བཀའ་གང་ཞིག་གནང་བ་དེ། ནམ་མཁའི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཕྱིར་བརྩོན་པར་གྱིས། གང་ལ་ཞེ་ན། རྒྱལ་པོ་དང་དེའི་སྲས་ཀྱི་རྒྱལ་ཁམས་ལ་ཐུགས་ཁྲོ་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":24,"content":["ཁྱོད་རྣམས་ཀྱིས་ཤེས་དགོས་པ་ཞིག་ནི། མཆོད་དཔོན་དང་། ལེ་ཝི་པ། མགུར་ལེན་མཁན། སྒོ་སྲུང། མཆོད་གཡོག་རྣམས་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་འདིའི་གཉེར་པ་རྣམས་ལས་དཔྱ་ཁྲལ་དང་འབུལ་མཚན། འབྲུ་ཁྲལ་བཅས་བླང་མི་ཆོག"]},{"type":"verse","number":25,"content":["ཀྱེ་ཨེས་སི་རཱ་ཁྱོད་རང་ལ་མཚོན་ན། ཁྱོད་ཀྱི་དཀོན་མཆོག་གིས་གནང་བའི་ཤེས་རབ་བཞིན་དུ་ཁྲིམས་དཔོན་དང་འགོ་དཔོན་བསྐོས་ནས། གཙང་པོའི་ཕ་རོལ་ཏུ་གནས་པའི་འབངས་མི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ཤེས་པ་རྣམས་ལ་དབང་བསྒྱུར་དགོས་ལ། ཁྱོད་ཀྱིས་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་མི་ཤེས་པ་རྣམས་ལ་སློབས་ཤིག"]},{"type":"verse","number":26,"content":["གལ་ཏེ། མི་སུ་ཞིག་གིས་ཁྱོད་ཀྱི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་དང་རྒྱལ་པོའི་བཀའ་མི་བསྲུང་ན། དེ་ལ་སྲོག་ཆད་གཅོད་པའམ་རྒྱང་ཕུད་དུ་གཏོང་བའམ། རྒྱུ་ནོར་ལེན་པའམ་བཙོན་དུ་འཇུག་པའི་ཁྲིམས་སོགས་གཟབ་ནན་གྱིས་ཆོད་ཅིག་ཅེས་བྲིས་སོ། །"]},{"type":"heading","content":["ཨེས་སི་རཱ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པ་ཕུལ་བ།"]},{"type":"verse","number":27,"content":["ཨེས་སི་རཱ་ན་རེ། ངེད་ཀྱི་མེས་པོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་བསྟོད་འོས་པ་ཡིན། གང་ལ་ཞེ་ན། ཡེ་རུ་སཱ་ལེམ་གྱི་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་གཟི་བརྗིད་འབུལ་བའི་བསམ་པ་འདི་རྒྱལ་པོའི་སེམས་སུ་གནང་བ་དང་།"]},{"type":"verse","number":28,"content":["ཡང་ཁོང་གིས་རྒྱལ་པོ་དང་། དེའི་གྲོས་མི་དང་། རྒྱལ་པོའི་འགོ་དཔོན་ནུས་པ་ཅན་ཐམས་ཅད་ཀྱི་མདུན་ནས་བདག་ཐུགས་རྗེས་བསྐྱངས་པའི་ཕྱིར་རོ། །བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་རོགས་རམ་མཛད་པས། བདག་ལ་སྤོབས་པ་འཛོམས་ཏེ། ཡེས་ར་ཨེལ་གྱི་འགོ་དཔོན་ཁ་ཤས་ང་དང་མཉམ་དུ་འགྲོ་བའི་ཕྱིར་བསྡུས་པ་ཡིན་ཞེས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZR/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}