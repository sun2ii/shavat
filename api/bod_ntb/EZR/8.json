{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":8,"content":[{"type":"heading","content":["ཨེས་སི་རཱ་དང་མཉམ་དུ་ཕྱིར་ལོག་པའི་མི།"]},{"type":"verse","number":1,"content":["རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐིའི་དུས་སུ་པཱ་པེལ་ལོན་ནས་ང་དང་མཉམ་དུ་འོངས་པ་རྣམས་ཀྱི་ཚོ་དཔོན་དག་དང་ཁོ་ཚོའི་གདུང་རྒྱུད་ཀྱི་ཐོ་ནི།"]},{"type":"verse","number":2,"content":["ཕི་ནེ་ཧེ་ཡི་བུ་རྒྱུད་ནས་གེར་ཤོམ་དང་། ཨི་ཐ་མཱར་གྱི་བུ་རྒྱུད་ནས་དཱ་ནེ་ཨེལ་དང་། དཱ་བིད་ཀྱི་བུ་རྒྱུད་ནས་ཧད་ཏུས་དང་།"]},{"type":"verse","number":3,"content":["ཤེ་ཀན་ཡཱའི་བུ་རྒྱུད་དེ་ཕཱར་ཨོ་སིའི་བུ་རྒྱུད་ནས་ཟཱ་ཀར་ཡ་དང་། དེ་དང་མཉམ་དུ་ཁྱིམ་རྒྱུད་ཀྱི་ཐོ་ལྟར་སྐྱེས་པ་བརྒྱ་དང་ལྔ་བཅུ་ཡོད།"]},{"type":"verse","number":4,"content":["ཕཱ་ཧད་མོ་ཨབ་ཀྱི་བུ་རྒྱུད་ནས་ཟེ་རཱ་ཡཱའི་བུ་ཨེ་ལི་ཧོ་ནེ་ཨི་དང་མཉམ་དུ་སྐྱེས་པ་ཉིས་བརྒྱ་ཡོད།"]},{"type":"verse","number":5,"content":["ཤེ་ཀན་ཡཱའི་བུ་རྒྱུད་ནས་ཡེ་ཧ་ཟི་ཨེལ་གྱི་བུ་དང་མཉམ་དུ་སྐྱེས་པ་སུམ་བརྒྱ་ཡོད།"]},{"type":"verse","number":6,"content":["ཨ་དིན་གྱི་བུ་རྒྱུད་ནས་ཡོ་ནཱ་ཐན་གྱི་བུ་ཨེ་བད་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་ལྔ་བཅུ་ཡོད།"]},{"type":"verse","number":7,"content":["ཨེ་ལཱམ་གྱི་བུ་རྒྱུད་ནས་ཨ་ཐལ་ཡཱའི་བུ་ཡེ་ཤ་ཡཱ་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་བདུན་ཅུ་ཡོད།"]},{"type":"verse","number":8,"content":["ཤེ་ཕད་ཡཱའི་བུ་རྒྱུད་ནས་མེའ་ཀཱ་ཨེལ་གྱི་བུ་ཟེ་བད་ཡཱ་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་བརྒྱད་ཅུ་ཡོད།"]},{"type":"verse","number":9,"content":["ཡོ་ཨབ་ཀྱི་བུ་རྒྱུད་ནས་ཡེ་ཧི་ཨེལ་གྱི་བུ་ཨོ་བད་ཡཱ་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་ཉིས་བརྒྱ་དང་བཅོ་བརྒྱད་ཡོད།"]},{"type":"verse","number":10,"content":["ཤེ་ལོ་མིད་ཀྱི་བུ་རྒྱུད་ནས་ཡོ་སེབ་ཡཱའི་བུ་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་བརྒྱ་དང་དྲུག་ཅུ་ཡོད།"]},{"type":"verse","number":11,"content":["པེ་བཱ་ཨིའི་བུ་རྒྱུད་ནས་པེ་བཱ་ཨིའི་བུ་ཟཱ་ཀར་ཡ་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་ཉེར་བརྒྱད་ཡོད།"]},{"type":"verse","number":12,"content":["ཨས་གད་ཀྱི་བུ་རྒྱུད་ནས་ཧག་ག་ཏན་གྱི་བུ་ཡོ་ཧ་ནན་དང་། དེ་དང་མཉམ་དུ་སྐྱེས་པ་བརྒྱ་དང་བཅུ་ཡོད།"]},{"type":"verse","number":13,"content":["ཨ་དོ་ནི་ཀམ་གྱི་བུ་རྒྱུད་ནི་མཐའ་མ་རྣམས་ཡིན་ཏེ་ཨེ་ལི་ཕེ་ལེད་དང་། ཡེ་ཧི་ཨེལ་དང་། ཤེ་མ་ཡཱ་གསུམ་དང་མཉམ་དུ་སྐྱེས་པ་དྲུག་ཅུ་ཡོད།"]},{"type":"verse","number":14,"content":["པིག་ཝ་ཨིའི་བུ་རྒྱུད་ནི་ཨུ་ཐ་ཨི་དང་ཟ་ཀུར་དང་མཉམ་དུ་སྐྱེས་པ་བདུན་ཅུ་ཐམ་པ་ཡོད།"]},{"type":"heading","content":["ཨེས་སི་རཱ་ཡིས་ལེ་ཝི་པ་རྣམས་བསྡུས་པ།"]},{"type":"verse","number":15,"content":["བདག་གིས་ཨ་ཧ་ཝའི་ཕྱོགས་སུ་འབབ་པའི་ཆུ་བོའི་འགྲམ་དུ་དེ་རྣམས་བསྡུས་ནས་སྒར་བརྒྱབ་སྟེ་དེར་ཉིན་གསུམ་ལ་བསྡད། འབངས་མི་དང་མཆོད་དཔོན་རྣམས་ཀྱི་གྲས་སུ་རྩད་བཅད་ཀྱང་ལེ་ཝི་པ་གཅིག་ཀྱང་མ་རྙེད།"]},{"type":"verse","number":16,"content":["དེ་ནས་ངས་ཨེ་ལི་ཨེ་བཟིར་དང་། ཨ་རི་ཨེལ། ཤེ་མ་ཡཱ། ཨེལ་ནཱ་ཐན། ཡ་རིབ། ཨེལ་ནཱ་ཐན། ནཱ་ཐན། ཟཱ་ཀར་ཡ། མཱེ་ཤུལ་ལིམ་སོགས་འགོ་དཔོན་རྣམས་དང་། ཡོ་ཡཱ་རིབ་དང་ཨེལ་ནཱ་ཐན་ཞེས་བྱ་བའི་ཡོན་ཏན་ཅན་གཉིས་བཅས་བསྡུས་ཏེ།"]},{"type":"verse","number":17,"content":["ཁོ་ཚོ་ཀ་སིབ་ཡཱ་བྱ་བའི་ས་གནས་ཀྱི་འགོ་དཔོན་ཨིད་དོའི་དྲུང་དུ་མངགས་ནས། དེ་རྣམས་ཀྱིས་ཨིད་དོ་དང་ཁོའི་སྤུན་མཆོད་གཡོག་ཡིན་པ་རྣམས་ལ་ཅི་ལྟར་སྨྲ་དགོས་ལུགས་བསླབས་པ་དང་། ངེད་ཀྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཕྱིར་ཞབས་ཕྱི་སྒྲུབ་མཁན་གཏོང་བར་ཞུས་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ངེད་ཀྱི་དཀོན་མཆོག་གི་ཐུགས་རྗེའི་རོགས་རམ་ལ་བརྟེན་ནས། དེ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་དང་ལེ་ཝིའི་བུ་རྒྱུད་དང་། མཱ་ལིའི་བུ་རྒྱུད་ལས་མི་བློ་རིག་ཅན་ཞིག་ཁྲིད་ཡོང་བ་སྟེ། ཤེ་རེབ་ཡཱ་དང་དེའི་བུ་རྣམས་དང་སྤུན་དག་བསྡོམས་པས་མི་བཅོ་བརྒྱད་ཡོད།"]},{"type":"verse","number":19,"content":["གཞན་ད་དུང་ཧ་ཤབ་ཡཱ་དང་། དེ་དང་མཉམ་དུ་མཱ་རཱ་རེའེ་ཡི་བུ་རྒྱུད་ལས་ཡེ་ཤ་ཡཱ་དང་། དེའི་སྤུན་དང་དེ་དག་གི་བུ་རྣམས་བསྡོམས་པས་མི་ཉི་ཤུ་ཡོད།"]},{"type":"verse","number":20,"content":["དེར་མ་ཟད་སྔར་དཱ་བིད་དང་འགོ་དཔོན་དག་གིས་ལེ་ཝི་པ་རྣམས་ལ་ཞབས་ཕྱི་བསྒྲུབ་པར་བསྐོས་པའི་མཆོད་གཡོག་རྣམས་ལས། མིང་བཀོད་ཡོད་པའི་མི་ཉིས་བརྒྱ་དང་ཉི་ཤུ་བཅས་མངགས་ཡོད་དོ། །"]},{"type":"heading","content":["ཨེས་སི་རཱ་ཡིས་སྨྱུང་གནས་བསྲུངས་ཏེ་སྨོན་ལམ་བཏབ་པ།"]},{"type":"verse","number":21,"content":["སྐབས་དེར་ངས་ཆུ་བོ་ཨ་ཧ་ཝའི་འགྲམ་དུ་སྨྱུང་གནས་བསྲུང་དགོས་པའི་བཀའ་བསྒྲགས་པ་ཡིན། གང་ལ་ཞེ་ན། ང་ཚོའི་དཀོན་མཆོག་གི་དྲུང་དུ་ཁེངས་སྐྱུང་གི་སེམས་དང་བཅས་ང་ཚོ་དང་ང་ཚོའི་ཕྲུ་གུ་རྣམས་དང་། རང་གི་རྒྱུ་ནོམ་པ་ཐམས་ཅད་ལ་བགྲོད་བདེའི་ལམ་བུ་ཞིག་འབྱུང་བའི་ཕྱིར་གསོལ་བ་བཏབ་པ་ཡིན།"]},{"type":"verse","number":22,"content":["ལམ་བར་དུ་དགྲ་ལས་བསྲུང་བའི་ཕྱིར་རྒྱལ་པོ་ལ་རྐང་དམག་དང་སྐྱ་དམག་མངགས་པར་ཞུ་བ་ལ་ངོ་ཚ་བྱུང་། གང་ལ་ཞེ་ན། སྔར་ངེད་རྣམས་ཀྱིས་རྒྱལ་པོར་སྨྲས་པ་ལྟར། སུ་ཞིག་གིས་ང་ཚོའི་དཀོན་མཆོག་བཙལ་ན་དེ་ལ་བྱིན་རླབས་གནང་ངེས་ཡིན་པ་དང་། གལ་ཏེ་སུ་ཞིག་གིས་ཁོང་ལ་རྒྱབ་འགལ་བྱས་ན་ཁོང་ཐུགས་ཁྲོ་བ་དང་དེ་ལ་ཆད་པ་གཅོད་ངེས་སོ་ཞེས་སྨྲས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ངེད་རྣམས་ཀྱིས་སྨྱུང་གནས་བསྲུངས་ཏེ་རང་གི་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ་པ་དང་ཁོང་གིས་གསན་པར་མཛད་དོ། །"]},{"type":"heading","content":["མཆོད་ཁང་དུ་ཕུལ་བའི་ཕྱག་རྟེན།"]},{"type":"verse","number":24,"content":["དེར་ངས་མཆོད་དཔོན་འགོ་ཁྲིད་རྣམས་ལས་མི་བཅུ་གཉིས་དང་། ཡང་ཤེ་རེབ་ཡཱ་དང་། ཧ་ཤབ་ཡཱ། དེ་དག་གི་སྤུན་བཅུ་བཅས་བསྐོ་མངགས་བྱས་ཏེ།"]},{"type":"verse","number":25,"content":["རྒྱལ་པོ་དང་བློ་འདོན་པ་དང་། དམག་དཔོན་དང་། དེར་ཡོད་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་ང་ཚོའི་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཕྱིར་ཕུལ་བའི་གསེར་དངུལ་དང་སྣོད་ཆས་དག་ཚད་ནས་ཁོ་ཚོར་སྤྲད་པ་ཡིན།"]},{"type":"verse","number":26,"content":["ངས་ཚད་ནས་སྤྲད་པའི་དངུལ་རྡོ་ཚད་དྲུག་བརྒྱ་ལྔ་བཅུ་དང་། རྡོ་ཚད་བརྒྱ་ཡི་དངུལ་ཆས་དང་། གསེར་རྡོ་ཚད་བརྒྱ་དང་།"]},{"type":"verse","number":27,"content":["གསེར་གྱི་དཀར་ཡོལ་ཉི་ཤུ་སྟེ། དེའི་རིན་ཐང་ནི་གསེར་གྱི་དོང་ཙེ་ཆིག་སྟོང་དང་། གསེར་ལྟར་རིན་ཐང་ཆེ་བའི་ལི་ཆས་འོད་ཅན་གཉིས་བཅས་ཡོད།"]},{"type":"verse","number":28,"content":["ངས་ཁོ་ཚོར་སྨྲས་པ། ཁྱོད་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་དམ་པ་ཡིན་ལ། སྣོད་ཆས་འདི་དག་ཀྱང་དམ་པ་ཡིན། ཡང་གསེར་དངུལ་ནི་ཁྱོད་ཚོའི་ཕ་མེས་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཡིད་མོས་ངང་ཕུལ་བའི་འབུལ་བ་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["མཆོད་དཔོན་དང་ལེ་ཝི་པའི་ཚོ་དཔོན་དག་དང་། དེ་མིན་ཡེས་ར་ཨེལ་གྱི་ཚོ་དཔོན་རྣམས་ཀྱི་མདུན་དུ་སླེབས་པའི་བར་དུ་ཁྱོད་ཚོས་གཟབ་ནན་ངང་སྲུངས་ཤིག ཡེ་རུ་སཱ་ལེམ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་མཛོད་ཁང་དུ་རྩིས་བླངས་ཏེ་སྤྲོད་ཅིག་ཅེས་པའོ། །"]},{"type":"verse","number":30,"content":["དེར་རྩིས་བླངས་པའི་གསེར་དངུལ་དང་སྣོད་ཆས་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་ངེད་ཀྱི་དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་འཁྱེར་བའི་ཕྱིར་མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱིས་བླངས་སོ། །"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་དུ་ཕྱིར་ལོག་པ།"]},{"type":"verse","number":31,"content":["ཟླ་དང་པོའི་ཚེས་བཅུ་གཉིས་ཉིན་ང་ཚོ་ཆུ་བོ་ཨ་ཧ་ཝའི་འགྲམ་ནས་ཆས་ཏེ་ཡེ་རུ་སཱ་ལེམ་གྱི་ཕྱོགས་སུ་ཕྱིན། ངེད་ཀྱི་དཀོན་མཆོག་གིས་རོགས་སྐྱོབ་མཛད་ནས་ངེད་རྣམས་དགྲ་དང་ལམ་གྱི་ཇག་པའི་ལག་ནས་ཐར་བར་བཅུག"]},{"type":"verse","number":32,"content":["ངེད་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་པ་དང་ཉིན་གསུམ་གྱི་རིང་ལ་དེ་རུ་བསྡད།"]},{"type":"verse","number":33,"content":["ཉིན་བཞི་པར་གསེར་དངུལ་དང་སྣོད་ཆས་དག་དཀོན་མཆོག་གི་མཆོད་ཁང་ནས་རྩིས་གྲངས་བླངས་ཏེ། ཨུ་རི་ཡཱའི་བུ་སྟེ་མཆོད་དཔོན་མེ་རེ་མོད་ལ་སྤྲད། ཁོ་དང་མཉམ་དུ་གཞན་ཕི་ནེ་ཧེ་ཡི་བུ་ཨེ་ལི་ཨ་ཟར་དང་། ད་དུང་ལེ་ཝི་པ་ཡེ་ཤུ་ཨའི་བུ་ཡོ་ཟཱ་བད་དང་། པིན་ནུ་ཨིའི་བུ་ནོ་ཨད་ཡཱ་རྣམས་ཡོད་པ་ཡིན།"]},{"type":"verse","number":34,"content":["དེ་དག་རེ་རེ་བཞིན་རྩིས་གྲངས་བླངས་ནས་ལྗིད་ཚད་ཚང་མ་དུས་དེ་རང་ལ་ཟིན་ཐོར་བཀོད་དོ། །"]},{"type":"verse","number":35,"content":["བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ལ་སྦྱིན་སྲེག་ཕུལ་བ་སྟེ། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱི་དོན་དུ་གླང་བཅུ་གཉིས་དང་། ལུག་ཐུག་དགུ་བཅུ་གོ་དྲུག་དང་། ལུ་གུ་བདུན་ཅུ་དོན་བདུན་ཕུལ་ཞིང་། སྡིག་བཤགས་ཀྱི་མཆོད་པར་ར་མ་བཅུ་གཉིས་ཕུལ། འདི་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་སྦྱིན་སྲེག་གི་མཆོད་པ་ཡིན།"]},{"type":"verse","number":36,"content":["ཁོ་རྣམས་ཀྱིས་རྒྱལ་པོའི་བཀའ་ཡིག་རྒྱལ་པོའི་སྤྱི་དཔོན་དང་གཙང་པོའི་ཕ་རོལ་གྱི་འགོ་དཔོན་རྣམས་ལ་སྤྲད་ཅིང་། དེ་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་མཆོད་ཁང་དང་འབངས་མི་ལ་རོགས་བྱས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZR/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}