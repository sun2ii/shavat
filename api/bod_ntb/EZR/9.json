{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"EZR","translationId":"bod_ntb","name":"ཨེས་སི་རཱ།","commonName":"ཨེས་སི་རཱ།","title":"༄༅། །ཨེས་སི་རཱའི་མདོ།","order":15,"numberOfChapters":10,"sha256":"0d140ed82dbb5e1ed57085ef7bbf7c6e65181dcdac0613447d73ac0d51d155c9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/bod_ntb/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":9,"content":[{"type":"heading","content":["ཨེས་སི་རཱ་ཡིས་མི་རིགས་གཞན་དང་གཉེན་བསྒྲིགས་པའི་སྡིག་པར་འགྱོད་བཤགས་བྱས་ནས་གསོལ་བ་བཏབ་པ།"]},{"type":"verse","number":1,"content":["དོན་དེ་དག་འགྲུབ་རྗེས་འགོ་དཔོན་རྣམས་ངའི་རྩར་འོངས་ནས་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་མི་མང་དང་། མཆོད་དཔོན་རྣམས་དང་། ལེ་ཝི་པ་རྣམས་ཀྱིས་ཀ་ན་ཨན་པ་དང་། ཧེད་པ། ཕེ་རེ་ཟི་པ། ཡེ་བུ་སི་པ། ཨམ་མོན་པ། མོ་ཨབ་པ། ཨེ་ཅིབ་པ། ཨེ་མོར་པ་རྣམས་ཏེ། ཡུལ་མི་རྣམས་ཀྱི་ཞེན་ལོག་གི་བྱ་སྤྱོད་དག་ལ་བསྟུན་ནས།"]},{"type":"verse","number":2,"content":["ཁོ་རྣམས་ཀྱིས་རང་ཉིད་དང་རང་གི་བུ་རྣམས་ལ་ཕྱི་ཕྱོགས་པའི་ཆུང་མ་བླངས་ཏེ། རིགས་རྒྱུད་གཙང་མ་དེ་མི་རིགས་གཞན་དང་བསྲེས་འདུག དེར་མ་ཟད་འགོ་དཔོན་དང་འགོ་ཁྲིད་རྣམས་བྱ་བ་འདིའི་སྟེང་ནས་ཉེས་ཅན་གཏེ་བོ་ཡིན་ཞུས་བྱུང་།"]},{"type":"verse","number":3,"content":["ངས་གཏམ་དེ་ཐོས་པ་དང་། གྱོན་གོས་དང་བེར་གོས་ཧྲལ་ཏེ། མགོའི་སྐྲ་དང་སྨྲ་ར་བལ་ཞིང་། དངངས་སྐྲག་དང་བཅས་བསྡད།"]},{"type":"verse","number":4,"content":["བཙོན་ལས་ཐར་ཏེ་ཕྱིར་ལོག་པ་རྣམས་ཀྱི་སྡིག་ཉེས་ཀྱི་ཕྱིར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གི་བཀའ་ཡི་རྐྱེན་གྱིས་སྐྲག་ནས་འདར་མཁན་ཐམས་ཅད་ངའི་མདུན་དུ་འཛོམས་ཤིང་། ང་རང་མཚན་མོའི་སྦྱིན་སྲེག་འབུལ་བའི་བར་དུ་འཇིགས་སྣང་དང་བཅས་བསྡད་པ་ཡིན།"]},{"type":"verse","number":5,"content":["མཚན་མོའི་སྦྱིན་སྲེག་གི་མཆོད་པའི་དུས་སུ་ང་རང་སྡུག་བསྔལ་ཁྲོད་ཡར་ལངས་ཏེ། སྔར་བཞིན་གྱོན་གོས་དང་བེར་གོས་ཧྲལ་པོ་དག་གྱོན་ནས་པུས་མོ་སར་བཙུགས་ཤིང་། བདག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་ལག་པ་བརྐྱངས་ནས་སྨོན་ལམ་ཞུས།"]},{"type":"verse","number":6,"content":["ཀྱེ། བདག་གི་དཀོན་མཆོག་ལགས། ངེད་ཅག་གིས་སྡིག་པ་མང་པོ་སྲོག་ལ་འབབ་འོས་པ་བྱས་ཤིང་། ངེད་ཅག་གི་སྡིག་པ་ནི་ནམ་མཁར་ཡང་མི་ཤོང་བས། ང་རང་ཁྱེད་ཀྱི་ཕྱོགས་སུ་མགོ་བོ་འདེགས་པར་ངོ་གནོང་བའོ། །"]},{"type":"verse","number":7,"content":["ང་ཚོའི་ཕ་མེས་རྣམས་ཀྱི་དུས་ནས་ད་བར་དུ། ངེད་ཅག་གི་སྡིག་པ་ཤིན་ཏུ་ཚབས་ཆེ་ཞིང་། ཡང་སྡིག་པ་བྱས་ཡོད་པའི་ཕྱིར། ངེད་ཅག་དང་ངེད་ཅག་གི་རྒྱལ་པོ་རྣམས་དང་མཆོད་དཔོན་རྣམས་ནི་རྒྱལ་ཁབ་གཞན་གྱི་རྒྱལ་པོ་རྣམས་ཀྱི་ལག་ཏུ་ལྷུང་ནས་བསད་པ་དང་། བཟུང་བ་དང་། བཅོམ་པ་དང་། ངོ་ཚར་སྦྱར་བ་སོགས་ནི་ད་ལྟའི་དུས་དང་གཅིག་མཚུངས་ཡིན།"]},{"type":"verse","number":8,"content":["ད་ལྟ་ངེད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡུད་ཙམ་ལ་ཐུགས་རྗེ་མཛད་ཅིང་། ངེད་ཅག་ལ་ལྷག་ལུས་འགའ་རེ་བསྐྱུར་ཡོད་ལ། ངེད་ཅག་ནི་ཁོང་གི་གནས་དམ་པ་རུ་འཛེར་མ་བརྡབས་པ་བཞིན་དུ་བག་ཕེབས་ངང་གནས་ཐུབ་པར་མཛད་ཅིང་། ཁོང་གི་གཟི་འོད་ཀྱིས་ང་ཚོའི་མིག་སྒོ་ཡང་ཕྱེས་ཏེ་བཙན་གནོན་འོག་ཡང་བསྐྱར་དར་བ་ཙམ་བྱས།"]},{"type":"verse","number":9,"content":["ངེད་ཅག་བྲན་གཡོག་ཡིན་ནའང་། རང་རེའི་དཀོན་མཆོག་གིས་ངེད་ཅག་བཙན་གནོན་འོག་ཏུ་མ་བསྐྱུར་བར། ཏ་ཟིག་གི་རྒྱལ་པོ་རྣམས་ཀྱི་མདུན་ནས་ངེད་ཅག་ལ་ཐུགས་རྗེས་གཟིགས་ཏེ་བསྐྱར་དར་མཛད་ཅིང་། རང་རེའི་དཀོན་མཆོག་གི་མཆོད་ཁང་ཞིག་རལ་དེ་ཉམས་གསོ་མཛད་པ་དང་། ངེད་ཅག་ལ་ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་དུ་མཁར་གྱང་ཡོད་པར་མཛད།"]},{"type":"verse","number":10,"content":["ཀྱེ། ངེད་ཀྱི་དཀོན་མཆོག་ལགས། ད་ནི་ངེད་ཅག་གིས་ཅི་ཞུ་བར་བྱའམ། གང་ལ་ཞེ་ན། ངེད་ཅག་གིས་ཁྱེད་ཀྱི་བཀའ་དོར་བ་དང་།"]},{"type":"verse","number":11,"content":["བཀའ་དེ་ནི་ཁྱེད་ཀྱིས་ཞབས་ཕྱི་ལུང་སྟོན་པ་རྣམས་བརྒྱུད་ནས་གསུངས་པ་ཡིན་ཏེ། ཁྱེད་ཀྱིས་འདི་སྐད་དུ། ཁྱོད་རྣམས་ལ་བགོ་སྐལ་དུ་འཐོབ་པར་འགྱུར་བའི་ཡུལ་ནི་བཙོག་པ་ཡིན་ཏེ། ཡུལ་དེའི་མི་རིགས་རྣམས་ཀྱི་བཙོག་པས་བཀང་ཡོད་པ་ཡིན། ཁོ་རྣམས་ཀྱི་ཞེན་ལོག་གི་ལས་ཀྱིས་ཡུལ་དེའི་མགོ་ནས་མཇུག་བར་དུ་བཙོག་པས་གང་བར་བྱས།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར། ཁྱོད་ཅག་གིས་རང་གི་བུ་མོ་རྣམས་དེ་དག་ལ་མནའ་མར་བྱིན་མི་ཆོག་ལ། ཁྱོད་ཅག་གི་བུ་རྣམས་ལ་དེ་དག་གི་བུ་མོ་རྣམས་མནའ་མར་བླངས་ནའང་མི་ཆོག ཁོ་ཚོའི་ཞི་བདེ་དང་ཁོ་ཚོའི་ཁེ་ཕན་ནམ་ཡང་བཙལ་མི་ཆོག དེ་ལྟར་བྱས་ན་ཁྱོད་རྣམས་སྟོབས་ཅན་དུ་འགྱུར་ངེས་ཏེ། ཡུལ་འདིའི་ཟས་མཆོག་རྣམས་སྤྱོད་ཅིང་། ཡུལ་འདི་རྒྱུན་ནས་རྒྱུན་དུ་ཁྱོད་ཚོའི་བུ་རྒྱུད་རྣམས་ལ་བགོ་སྐལ་དུ་བསྐྱུར་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["ཡང་ངེད་ཅག་གིས་སྤྱོད་ངན་དང་སྡིག་པ་ཆེན་པོ་བྱས་པས། འདི་ཐམས་ཅད་ངེད་ཅག་གི་སྟེང་དུ་བྱུང་བ་རེད། ཡིན་ཡང་ངེད་ཀྱི་དཀོན་མཆོག་ཁྱེད་ཉིད་ཀྱིས་ངེད་ཅག་གི་སྡིག་པའི་ཚད་དང་བསྟུན་ནས་ཉེས་ཆད་ལྗིད་མོ་མ་བཅད་པར། ང་ཚོ་ལ་ལྷག་ལུས་འགའ་རེ་བསྐྱུར་ཡོད།"]},{"type":"verse","number":14,"content":["ད་ནི་ངེད་ཅག་གིས་སླར་ཡང་ཁྱེད་ཀྱི་བཀའ་དང་འགལ་ནས། སྤྱད་པ་ཞེན་ལོག་སྤྱོད་པའི་མི་རིགས་འདི་རྣམས་དང་གཉེན་འབྲེལ་བྱེད་དམ། གལ་ཏེ་ང་ཚོས་འདི་ལྟར་བྱས་ན་ཁྱེད་རང་ཐུགས་ཁྲོས་ཏེ་ང་ཚོ་མེད་པར་བཏང་ནས་མི་གཅིག་ཀྱང་མི་ལྷག་པར་མཛད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["ཀྱེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ནི་དྲང་བདེན་ཡིན་པས་ངེད་ཅག་ལུས་ནས་ལྷག་མ་རུ་གྱུར་ཏེ། གཟིགས་དང་། ངེད་ཅག་ལ་ཁྱེད་ཀྱི་དྲུང་དུ་སྡིག་པ་ཡོད་པས། མི་སུ་ཡིན་ཡང་ཁྱེད་ཀྱི་དྲུང་དུ་ཚུགས་མི་ནུས་ཞེས་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/EZR/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EZR/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/EZR/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}