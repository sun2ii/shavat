{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":1,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་འཇིག་རྟེན་ཁམས་བཀོད༌པ།"]},{"type":"verse","number":1,"content":["ཐོག་མར་དཀོན་མཆོག་གིས་ནམ་མཁའ་དང་ས་གཞི་",{"noteId":0},"གསར་དུ་བཀོད་པ་ལགས༌སོ།།"]},{"type":"verse","number":2,"content":["ས་གཞི་ནི་སྟོངས་ཤིང་གོ་རིམ་མེད་པ་དང་མཚོ་ཆེན་པོའི་ངོས་སུ་མུན་ནག་གིས་ཁེབས༌ཤིང༌། དཀོན་མཆོག་གི་ཐུགས་ཉིད་མཚོའི་ངོས་སུ་ཕར་ཚུར༌རྒྱུའོ།།"]},{"type":"verse","number":3,"content":["དེ་ནས་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། འོད་ཡོད་པར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་འོད་བྱུང༌ངོ༌།།"]},{"type":"verse","number":4,"content":["ཁོང་གིས་འོད་ནི་ལེགས་པར་དགོངས་ཏེ་འོད་དང་མུན་པའི་དབྱེ་བ༌ཕྱེས་སོ།།"]},{"type":"verse","number":5,"content":["ཁོང་གིས་འོད་ལ་ཉིན་མོ་ཞེས་བཏགས་པ༌དང༌། མུན་པར་མཚན་མོ་ཞེས་མིང་བཏགས༌སོ། །དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་དང༌པོའོ།།",{"noteId":1}]},{"type":"verse","number":6,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ཆུའི་བར་དུ་དབྱིངས་དང་ལྡན་པར་གྱུར་ནས་ཆུ་དང་ཆུའི་བར་མཚམས་ཕྱེས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":7,"content":["ཁོང་གིས་དབྱིངས་མཛད༌དེ། དབྱིངས་ཀྱི་གོང་དུ་ཡོད་པའི་ཆུ་དང་དབྱིངས་ཀྱི་འོག་ཏུ་ཡོད་པའི་ཆུ་གཉིས་སོ་སོར་ཕྱེས་ནས་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་གིས་དབྱིངས་ཀྱི་མིང་ལ་ནམ་མཁའ་ཞེས་བཏགས༌སོ། །དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་གཉིས༌པའོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ནམ་མཁའི་འོག་ཏུ་ཡོད་པའི་ཆུ་རྣམས་གནས་གཅིག་ཏུ་འདུས་ཏེ་སྐམ་ས་མངོན་པར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་གིས་སྐམ་སའི་མིང་ལ་ས་གཞི་ཞེས་བཏགས་པ༌དང༌། ཆུ་རྣམས་ལྷན་དུ་འདུས་པ་ལ་རྒྱ་མཚོ་ཞེས་མིང་བཏགས༌ཤིང༌། ཁོང་གིས་དེ་ནི་ལེགས་པར་དགོངས༌སོ།།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ས་ལས་སྔོ་རིགས༌ཏེ། ས་བོན་བསྐྱེད་པའི་སྔོ་ཚལ༌དང༌། ས་བོན་ལྡན་པའི་ཤིང་འབྲས་བསྐྱེད་པའི་ལྗོན་ཤིང་ཐམས་ཅད་རང་རང་གི་རིགས་བཞིན་དུ་སྐྱེ་བར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":12,"content":["དེ་ནས་ས་ལས་སྔོ་རིགས༌ཏེ། རང་རང་གི་རིགས་བཞིན་དུ་ས་བོན་བསྐྱེད་པའི་སྔོ་ཚལ༌དང༌། ས་བོན་ལྡན་པའི་ཤིང་འབྲས་བསྐྱེད་པའི་ལྗོན་ཤིང་ཐམས་ཅད་རང་རང་གི་རིགས་བཞིན་དུ་སྐྱེས་པར་གྱུར༌ཏོ། །ཁོང་གིས་དེ་ནི་ལེགས་པར་དགོངས༌སོ།།"]},{"type":"verse","number":13,"content":["དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་གསུམ༌པའོ།།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ཉིན་མོ་དང་མཚན་མོ་འབྱེད་པའི་ཕྱིར་ནམ་མཁའི་དབྱིངས་སུ་འོད་ཀྱི་ཕུང་པོ་རྣམས་ཡོད་པར་གྱུར༌ཅིག དེ་ནི་དུས་ཚིགས༌དང༌། ཉིན༌མོ། ལོ་ཟླའི་རྟགས་སུ་འགྱུར་བ༌དང༌།"]},{"type":"verse","number":15,"content":["ནམ་མཁའི་དབྱིངས་སུ་འོད་འཕྲོ་བ་དང་ས་ལ་འོད་སྣང་བའི་ཕྱིར་རོ་ཞེས་གསུངས་པ་དང་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཁོང་གིས་འོད་ཆེན་པོ་གཉིས་མཛད༌ཅིང༌། དེ་ནི་འོད་ཆེན་པོས་ཉིན་མོ་ལ་དབང་བྱེད་པ༌དང༌། འོད་ཆུང་བས་མཚན་མོ་ལ་དབང་བྱེད་པའི་ཕྱིར་ཡིན༌ཞིང༌། ཡང་སྐར་མ་རྣམས་ཀྱང་མཛད༌དོ།།"]},{"type":"verse","number":17,"content":["ཁོང་གིས་འོད་དེ་གཉིས་ནམ་མཁའི་དབྱིངས་སུ་བཤམས་པར་མཛད༌དོ། །ཅིའི་ཕྱིར་ཞེ༌ན། དེ་གཉིས་ས་གཞི་ལ་སྣང་བར་བྱེད་པ༌དང༌།"]},{"type":"verse","number":18,"content":["ཉིན་དང་མཚན་ལའང་དབང་བྱེད་པར་འགྱུར་བ༌དང༌། འོད་དང་མུན་པ་འབྱེད་པའི་ཕྱིར༌རོ། །ཁོང་གིས་དེ་ནི་ལེགས་པར་དགོངས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་བཞི༌པའོ།།"]},{"type":"verse","number":20,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ཆུའི་ནང་དུ་སྲོག་དང་ལྡན་པའི་སེམས་ཅན་ཧ་ཅང་མང་དུ་འབྱུང་བ༌དང༌། འདབ་ཆགས་རྣམས་ས་སྟེང་གི་བར་སྣང་དུ་ཕུར་ཅིག་ཅེས་གསུངས༌ཏེ།"]},{"type":"verse","number":21,"content":["ཁོང་གིས་ཆུ་ལ་གནས་པའི་སྲོག་ལྡན་ཆེན་པོ༌དང༌། ཆུའི་ནང་དུ་བྱུང་བའི་སྲོག༌ལྡན། འདབ་ཆགས་རྣམས་ཀྱང་རང་རང་གི་རིགས་བཞིན་དུ་བཀོད་པར་མཛད་ཅིང་ཁོང་གིས་དེ་ནི་ལེགས་པར་དགོངས༌སོ།།"]},{"type":"verse","number":22,"content":["ཡང་དཀོན་མཆོག་གིས་དེ་དག་ལ་བྱིན་གྱིས་བརླབས་ཏེ་འདི་སྐད༌དུ། རྒྱུད་དང་ལྡན་པར་གྱུར་ནས་མང་དུ་སྤེལ་ཏེ་རྒྱ་མཚོའི་ཆུ་ལ་གང་བར་གྱིས༌དང༌། འདབ་ཆགས་རྣམས་ཀྱང་ས་ལ་འཕེལ་བར་གྱུར་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":23,"content":["དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་ལྔ༌པའོ།།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ས་གཞིའི་སྟེང་དུ་རང་རང་གི་རིགས་བཞིན་དུ་སྲོག་ལྡན་ཏེ་ཕྱུགས་ཟོག༌དང༌། ལྟོ་འགྲོ་དང་འབུ༌སྲིན། རི་དྭགས་རྣམས་སྐྱེ་བར་གྱུར་ཅིག་ཅེས་གསུངས་པ་དང་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་གིས་རི་དྭགས༌དང༌། ཕྱུགས༌ཟོག ས་སྟེང་གི་ལྟོ་འགྲོ་དང་འབུ་སྲིན་ཐམས་ཅད་རང་རང་གི་རིགས་བཞིན་དུ་བཀོད་པར་མཛད༌ཅིང༌། དཀོན་མཆོག་གིས་དེ་ནི་ལེགས་པར་དགོངས༌སོ།།"]},{"type":"verse","number":26,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ངེད་ཅག་",{"noteId":2},"གིས་རང་གི་སྣང་བརྙན༌ལྟར། ངེད་ཅག་དང་མཚུངས་པའི་མིའི་རིགས་བསྐྲུན་པར༌བྱའོ། །དེ་དག་གིས་རྒྱ་མཚོའི་ཉ་རྣམས༌དང༌། ནམ་མཁའི༌བྱ། ཕྱུགས༌ཟོག ས་གཞི༌ཡོངས། ས་སྟེང་གི་ལྟོ་འགྲོ་དང་འབུ་སྲིན་ཐམས་ཅད་ལ་དབང་བྱེད་པར་གྱུར་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་གིས་རང་གི་སྣང་བརྙན་ལྟར་མིའི་རིགས་བསྐྲུན་པར་མཛད༌ཅིང༌། དེ་ནི་དཀོན་མཆོག་ཉིད་ཀྱི་སྣང་བརྙན་བཞིན་ཕོ་མོ་གཉིས་སུ་མཛད༌དོ།།"]},{"type":"verse","number":28,"content":["དཀོན་མཆོག་གིས་དེ་གཉིས་ལ་བྱིན་གྱིས་བརླབས་ཏེ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་རྒྱུད་དང་ལྡན་པར་གྱུར་ནས་མང་དུ་སྤེལ་ཏེ་ས་གཞིར་གང་བར་བྱོས༌ཤིག ཡང་ས་གཞིར་དབང་བསྒྱུར་བ་དང་རྒྱ་མཚོའི་ཉ༌དང༌། ནམ་མཁའི༌བྱ། ས་ཐོག་ཏུ་རྒྱུ་བའི་སྲོག་ཆགས་ཀུན་ལའང་དབང་བྱེད་པར་གྱིས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":29,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ལྟོས༌དང༌། བདག་གིས་ས་སྟེང་དུ་ས་བོན་བསྐྱེད་པའི་སྔོ་ཚལ་དང་ས་བོན་ལྡན་པའི་ཤིང་འབྲས་བསྐྱེད་པའི་ལྗོན་ཤིང་ཐམས་ཅད་ཁྱོད་ཅག་ལ་ཟས་སུ་སྦྱིན་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":30,"content":["ཡང་ས་སྟེང་གི་དུད་འགྲོ་ཐམས་ཅད༌དང༌། ནམ་མཁའི་བྱ་མཐའ་དག༌དང༌། ས་ཐོག་ཏུ་རྒྱུ་བའི་སྲོག་ལྡན་ཡོངས་ལ་སྔོ་རིགས་ཟས་སུ་སྦྱིན་ནོ་ཞེས་གསུངས་པ་དང་དེ་བཞིན་དུ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":31,"content":["དེ་ནས་དཀོན་མཆོག་གིས་རང་ཉིད་ཀྱིས་ཇི་བཞིན་མཛད་པ་ཐམས་ཅད་ལ་གཟིགས་ཤིང་དེ་ནི་ཤིན་ཏུ་ལེགས་པར་དགོངས༌སོ། །དེ་ནི་མཚན་མོ་དང་ཞོགས་པ་བྱུང་བའི་ཉིན་མཚན་དྲུག༌པའོ།།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ནམ་མཁའ་དང་ས་གཞི་ཞེས་པ་འདི་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་ཡི་གེར་བཀོད་པའི་དམ་པའི་གསུང་རབ་ཀྱི་མ་ཕྱིའི་གོ་དོན་ལྟར༌ན། རང་ཅག་རྣམས་འཚོ་ཞིང་གནས་པའི་འཇིག་རྟེན་འདི་དང་དེ་ལས་གཞན་པའི་འཇིག་རྟེན་ཁམས་རྣམས་ཀྱང་འདུ་བར༌གསུངས།","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"འདིར་ཉིན་མཚན་དང་པོ་ཞེས་པར་མ་ཕྱི་ལས་ཉིན་མཚན་གཅིག་ཅེས་མཐོང་།","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"མ་ཕྱི་ལས་ངེད་ཅག་ཅེས་བྲིས་ཡོད་ཀྱང་དོན་ལ་དཀོན་མཆོག་ཁོ་ན་བསྟན༌ཏེ། ཁོང་ནི་རང་བཞིན་ཐུགས་ཉིད་ཡིན་ཞིང་ཐོག་མཐའ་མེད་པ་དང་བདེན་པའི་དཀོན་མཆོག་ཉིད༌ཡིན། དཀོན་མཆོག་གི་ངོ་བོ་གཅིག་ལ་རང་གཤིས་གསུམ་ཡོད༌ཅིང། དེ་དག་ནི་ཡབ་དཀོན་མཆོག༌དང༌། སྲས་དཀོན༌མཆོག དམ་པའི་ཐུགས་ཉིད་དཀོན་མཆོག་བཅས༌ཡིན་ལ། རང་གཤིས་གསུམ་པོ་ལྷན་གཅིག་ཏུ་བསྡུས་ན་དཀོན་མཆོག་གི་ངོ་བོ་ནི་གཅིག༌ཡིན།","reference":{"chapter":1,"verse":26}}]},"thisChapterLink":"/api/bod_ntb/GEN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":31}