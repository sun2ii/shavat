{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":14,"content":[{"type":"heading","content":["ཨབ་རམ་གྱིས་ལོད་ཐུའི་སྲོག་བསྐྱབས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཤིན་ཨར་ཡུལ་གྱི་རྒྱལ་པོ་ཨམ་རཱ་ཕིལ༌དང༌། ཨེལ་ལ་སཱར་ཡུལ་གྱི་རྒྱལ་པོ་ཨར༌ཡོག ཨེ་ལཱམ་ཡུལ་གྱི་རྒྱལ་པོ་ཀཱ་དོར་ལཱ་ཨོ༌མེར། གོ་ཡེམ་ཡུལ་གྱི་རྒྱལ་པོ་ཐིད་ཨལ་བཅས་ཀྱི་དུས༌སུ།"]},{"type":"verse","number":2,"content":["རྒྱལ་པོ་འདི་བཞི་པོས་སཱ་དོམ་གྱི་རྒྱལ་པོ་པེ་རཱ༌དང༌། གཱ་མོ་ར་ཡི་རྒྱལ་པོ་པེར༌ཤཱ། ཨད་མཱ་ཡི་རྒྱལ་པོ་ཤིན༌ཨབ། ཚཱ་བོ་ཡིམ་གྱི་རྒྱལ་པོ་ཤེམ་ཨེ༌བེར། པེ་ལཱ་༼དེང་སང་ཚོ་ཨར་ཞེས་ཀྱང་བྱ།༽ཡི་རྒྱལ་པོ་དང་བཅས་པར་དམག་དྲངས༌སོ།།"]},{"type":"verse","number":3,"content":["དེ་ནས་རྒྱལ་པོ་དེ་རྣམས་སིད་དིམ་ལུང་པར་གཅིག་ཏུ༌འདུས། ལུང་པ་དེ་ནི་ཚྭ་མཚོ༌དེའོ།།"]},{"type":"verse","number":4,"content":["དེ་སྔར་དེ་དག་ཀཱ་དོར་ལཱ་ཨོ་མེར་གྱི་མངའ་འོག་ཏུ་ལོ་བཅུ་གཉིས་རིང་ལ་བསྡད་ཅིང་ལོ་བཅུ་གསུམ་པར་ངོ་ལོག༌བྱས།"]},{"type":"verse","number":5,"content":["དེ་ཡང་ལོ་བཅུ་བཞི༌པར། ཀཱ་དོར་ལཱ་ཨོ་མེར་གྱི་མནའ་འབྲེལ་རྒྱལ་པོ་ཐམས་ཅད་ཨ་ཤ་ཐ་རོད་ཀར་ནཱ་ཡེམ་ཞེས་པའི་ཡུལ་དུ་འོངས༌ཏེ། རེ་པཱ་མི་རིགས༌དང༌། ཧཱམ་ཞེས་པའི་ཡུལ་གྱི་ཟུ་ཟ་མི༌རིགས། ཤཱ་ཝེ་ཀིར་ཡ་ཐཱ་ཡེམ་ཡུལ་གྱི་ཨེ་མཱ་མི༌རིགས།"]},{"type":"verse","number":6,"content":["དབེན་སྟོང་གི་འགྲམ་དུ་ཡོད་པའི་ཨེལ་ཕཱ་རན་ཡུལ་ནས་སེ་ཨིར་རི་བོའི་བར་དུ་གནས་པའི་ཧོར་མི་རིགས་བཅས་ལ་དམག་དྲངས་ཤིང་དེ་ལས་རྣམ་པར་རྒྱལ༌ཏོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཁོ་རྣམས་ཕྱིར་ལོག་པའི་ལམ་བར་དུ་ཨིན་མུས་ཕཱད་ཅེས་པ་སྟེ་ཀཱ་དེའེ་ཤཱ་ཡུལ་དུ་སོང༌སྟེ། ཨ་མཱད་ལེག་མི་རིགས་ཀྱི་ཡུལ་ཐམས་ཅད༌དང༌། ཧ་ཚོན་ཐལ་མཱར་ཡུལ་དུ་གནས་པའི་ཨེ་མོར་མི་རིགས་བཅས་ལ་དམག་དྲངས་ཤིང་དེ་ལས་རྣམ་པར་རྒྱལ༌ཏོ།།"]},{"type":"verse","number":8,"content":["དེ་ནས་སཱ་དོམ༌དང༌། གཱ་མོ༌ར། ཨད༌མཱ། ཚཱ་བོ༌ཡིམ། པེ་ལཱའམ་ཚོ་ཨར་བཅས་ཀྱི་རྒྱལ་པོ་རྣམས་སླེབས་པ༌དང༌། སིད་དིམ་ལུང་པ་ནས་གཡུལ་བཤམས་ཏེ་ཁོ་རྣམས་ལ་གཡུལ་འགྱེད་པ༌སྟེ།"]},{"type":"verse","number":9,"content":["ཨེ་ལཱམ་གྱི་རྒྱལ་པོ་ཀཱ་དོར་ལཱ་ཨོ་མེར༌དང༌། གོ་ཡེམ་གྱི་རྒྱལ་པོ་ཐིད༌ཨལ། ཤིན་ཨར་གྱི་རྒྱལ་པོ་ཨམ་རཱ་ཕིལ། ཨེལ་ལ་སཱར་གྱི་རྒྱལ་པོ་ཨར་ཡོག་བཅས་ཡིན༌ཞིང༌། རྒྱལ་པོ་བཞི་པོས་རྒྱལ་པོ་ལྔ་པོར་གཡུལ་འགྱེད༌པའོ།།"]},{"type":"verse","number":10,"content":["དེ་ཡང་སིད་དིམ་ལུང་པར་རྒྱ་སྐྱེགས་ཀྱིས་བཀང་བའི་དོང་མང་པོ་ཡོད༌ལ། སཱ་དོམ་གྱི་རྒྱལ་པོ་དང་གཱ་མོ་ར་ཡི་རྒྱལ་པོ་གཉིས་བྲོས་ཏེ་རྒྱ་སྐྱེགས་ཀྱི་དོང་ནང་དུ་ལྷུང་ཞིང་གཞན་རྣམས་རི་ཁྲོད་དུ༌བྲོས།"]},{"type":"verse","number":11,"content":["དེ་ནས་རྒྱལ་པོ་བཞི་པོས་སཱ་དོམ་དང་གཱ་མོ་ར་ཡི་རྒྱུ་ནོར་དང་འབྲུ་རིགས་ཐམས་ཅད་ཕྲོགས་ཤིང་།"]},{"type":"verse","number":12,"content":["ཨབ་རམ་གྱི་ཚ་བོ་ལོད་ཐུ་དང་ཁོའི་རྒྱུ་ནོར་ཡང་ཕྲོགས་ནས་སོང༌། ཅིའི་ཕྱིར་ཞེ༌ན། དུས་དེར་ལོད་ཐུ་ནི་སཱ་དོམ་དུ་བསྡད་ཡོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":13,"content":["དེ་ཡང་ཕྱིར་བྲོས་འོངས་པའི་མི་ཞིག་གིས་ཨིབ་རི་པ་",{"noteId":20},"ཨབ་རམ་ལ་གནས་ཚུལ་དེའི་སྐོར༌སྨྲས། ཨབ་རམ་ནི་སྐབས་དེར་ཨེ་མོར་མི་རིགས་ཀྱི་མཱན་རེའེ་ཞེས་བྱ་བའི་བེ་ཤིང་སྐྱེད་ཚལ་གྱི་ཉེ་འགྲམ་དུ་བསྡད་ཡོད༌ཅིང༌། མཱན་རེའེ་བྱ་བ་ནི་ཨེ་ཤ་ཀོལ་དང་ཨ་ནེར་གཉིས་ཀྱི་སྤུན་ཡིན༌ལ། ཁོ་རྣམས་ཀྱིས་ཨབ་རམ་དང་མནའ་འབྲེལ་བྱས་མྱོང༌ངོ༌།།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཨབ་རམ་གྱིས་ཁོང་གི་ཚ་བོ་ལོད་ཐུ་བཙན་བཟུང་བྱས་པའི་གནས་ཚུལ་ཐོས༌ཏེ། རང་ཁྱིམ་ནས་ནར་སོན་ཅིང་དམག་རྩལ་སྦྱངས་པའི་ཕོ་རྒོད་སུམ་བརྒྱ་དང་བཅོ་བརྒྱད་ཁྲིད་ནས་དཱན་ཞེས་པའི་ཡུལ་བར་དུ་ར་མདར༌རྒྱུགས།"]},{"type":"verse","number":15,"content":["མཚན་མོའི་དུས༌སུ། ཨབ་རམ་གྱིས་རང་ཉིད་དང་དམག་མི་སྡེ་ཚན་བགོས་ནས་དགྲ་བོ་འཇོམས་པར་བྱས་པ༌དང༌། དེ་ནས་ཡང་དཱ་མེ་སེག་གི་བྱང་ཕྱོགས་སུ་ཡོད་པའི་ཧོ་བཱ་ཡུལ་བར་དུ་བདས༌ཏེ།"]},{"type":"verse","number":16,"content":["སྔར་ཕྲོགས་ཟིན་པའི་རྒྱུ་ནོར་ཐམས་ཅད་ཕྱིར་བླངས་པར་མ༌ཟད། ད་དུང་ཁོང་གི་ཚ་བོ་ལོད་ཐུ༌དང༌། ཁོའི་རྒྱུ་ནོར་དང་བུད༌མེད། འབངས་མི་ཐམས་ཅད་ཀྱང་ཕྱིར་བླངས༌སོ།།"]},{"type":"verse","number":17,"content":["དེ་ཡང་ཨབ་རམ་བྱ་བ་ཀཱ་དོར་ལཱ་ཨོ་མེར་དང་དེའི་མནའ་འབྲེལ་རྒྱལ་པོ་གཞན་རྣམས་ལས་རྣམ་པར་རྒྱལ་ཏེ་ཕྱིར་ལོག་པའི་དུས༌སུ། སཱ་དོམ་གྱི་རྒྱལ་པོ་འོངས་ནས་ཤཱ་ཝེ་ལུང་པ་རུ་ཁོང་ལ་བསུ་བ༌བྱས། ཤཱ་ཝེ་ལུང་པ་ལ་རྒྱལ་པོའི་ལུང་པ་ཞེས་ཀྱང༌ཟེར།"]},{"type":"verse","number":18,"content":["དེ་ནས་སཱ་ལེམ་གྱི་རྒྱལ་པོ་མཱལ་ཀི་ཚེ་དེག་གིས་ཀྱང་བག་ལེབ་དང་རྒུན་ཆང་ཁྱེར་ནས་བསུ་བ་བྱེད་དུ༌ཕེབས། ཁོང་ནི་བླ་ན་མེད་པའི་དཀོན་མཆོག་གི་མཆོད་དཔོན་ཞིག་ཡིན༌ནོ།།"]},{"type":"verse","number":19,"content":["ཁོང་གིས་ཨབ་རམ་ལ་བྱིན་གྱིས་བརླབས་ཏེ་འདི་སྐད༌དུ།",{"text":"གནམ་ས་གཉིས་ཀྱི་བྱེད་པོ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"བླ་ན་མེད་པའི་དཀོན་མཆོག༌གིས།།","poem":1},{"lineBreak":true},{"text":"ཨབ་རམ་ཁྱོད་ལ་བྱིན་བརླབས༌མཛོད།།","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"དགྲ་བོ་ཐམས་ཅད་ཁྱོད་སྤྲད༌པའི།།","poem":1},{"lineBreak":true},{"text":"བླ་ན་མེད་པའི་དཀོན་མཆོག༌ལ།།","poem":1},{"lineBreak":true},{"text":"བསྟོད་ཅིང་བསྔགས་པར་འོས་སོ༌ལོ། །ཞེས་གསུངས༌སོ།།","poem":1},"ཨབ་རམ་གྱིས་རང་ལ་ཐོབ་པའི་བཅུ་ཆ་གཅིག་ནི་མཱལ་ཀི་ཚེ་དེག་ལ་ཕུལ༌ཏོ།།"]},{"type":"verse","number":21,"content":["དེ་ནས་སཱ་དོམ་གྱི་རྒྱལ་པོས་ཨབ་རམ་ལ་འདི་ལྟར། ཁྱོད་ཀྱིས་འབངས་མི་རྣམས་བདག་ལ་བྱིན༌དང༌། རྒྱུ་ནོར་རྣམས་ཁྱོད་ཀྱིས་ཁྱེར་ཞིག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཨབ་རམ་གྱིས་སཱ་དོམ་གྱི་རྒྱལ་པོ་ལ་འདི་སྐད༌དུ། བདག་གིས་གནམ་ས་གཉིས་ཀྱི་བྱེད་པོ་སྟེ་བླ་ན་མེད་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམ་བཅས༌ཏེ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ལ་གཏོགས་པའི་རྒྱུ་རྫས་ནི་སྐུད་པ་ཞིག༌གམ། ཡང་ན་ལྷམ་མདུད་ཅིག་ཡིན་ཡང་བདག་གིས་མི་འཁྱེར༌རོ། །ཅིའི་ཕྱིར་ཞེ༌ན། ཁྱོད་ན༌རེ། བདག་གིས་ཨབ་རམ་ཕྱུག་པོར་བཏང་བ་ཡིན་ཞེས་མི་སྨྲ་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":24,"content":["དམག་མི་རྣམས་ཀྱིས་གང་ཞིག་ཟོས་པ༌དང༌། བདག་དང་མཉམ་དུ་ཕྱིན་པའི་ཨ་ནེར༌དང༌། ཨེ་ཤ༌ཀོལ། མཱན་རེའེ་བཅས་ལ་རང་གི་བགོ་སྐལ་འཁྱེར་དུ་འཇུག་པ་ལས༌གཞན། བདག་གིས་ཅི་ཡང་མི་འཁྱེར་ཞེས་སྨྲས༌སོ།།"]}],"footnotes":[{"noteId":20,"caller":"+","text":"ཨིབ་རི་པ་ཞེས་པ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་མིང་གཞན༌ཡིན།","reference":{"chapter":14,"verse":13}}]},"thisChapterLink":"/api/bod_ntb/GEN/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/13.json","previousChapterAudioLinks":{},"numberOfVerses":24}