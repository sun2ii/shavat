{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":15,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཨབ་རམ་ལ་ཞལ་ཆད་བཞག༌པ།"]},{"type":"verse","number":1,"content":["དོན་དེའི་རྗེས༌སུ། ཨབ་རམ་གྱི་ཞལ་གཟིགས་ནང་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་བབས་ཤིང་ཁོང་ལ་འདི་སྐད༌དུ། ཨབ༌རམ། ཁྱོད་རང་འཇིགས་མི་དགོས༌ཏེ། བདག་ནི་ཁྱོད་ཀྱི་ཕུབ་ཡིན༌ཞིང༌། བདག་གིས་ཁྱོད་ལ་བྱ་དགའ་ཆེན་པོ་ཞིག་སྦྱིན་པར་བྱ་ཞེས་པ༌དང༌།"]},{"type":"verse","number":2,"content":["ཨབ་རམ་ན༌རེ། ཀྱེ། གཙོ་བོ་ཡ་ཝཱེ༌ལགས། བདག་ལ་བུ་མེད་པས་ཁྱེད་ཀྱིས་བདག་ལ་ཅི་ཞིག་གནང་བར༌བྱའམ། བདག་གི་ཁྱིམ་རྒྱུད་འཛིན་མཁན་ནི་དཱ་མེ་སེག་གི་ཨེ་ལི་ཨེ་བཟིར་ཡིན་ཞེས་པ༌དང༌།"]},{"type":"verse","number":3,"content":["ཡང་ཨབ་རམ་ན༌རེ། ཁྱེད་ཀྱིས་བདག་ལ་བུ་རྒྱུད་མ་གནང༌བས། བདག་གི་ཁྱིམ་དུ་སྐྱེས་པའི་མི་དེ་ནི་བདག་གི་ཁྱིམ་རྒྱུད་འཛིན་མཁན་ཡིན་ནོ་ཞེས་པ༌ལ།"]},{"type":"verse","number":4,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་བབས་ཏེ་འདི་སྐད༌དུ། མི་དེ་ཁྱོད་ཀྱི་ཁྱིམ་རྒྱུད་འཛིན་མཁན་དུ་མི༌འགྱུར། ཁྱོད་རང་ལས་སྐྱེས་པའི་བུ་ནི་ཁྱོད་ཀྱི་ཁྱིམ་རྒྱུད་འཛིན་མཁན་དུ་འགྱུར་བ་ཡིན་ཞེས༌པའོ།།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁོང་གིས་ཨབ་རམ་ཕྱི་རོལ་ཏུ་ཁྲིད་དེ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ནམ་མཁར་ལྟོས༌དང༌། ནམ་མཁའི་སྐར་མ་ཐམས་ཅད་བརྩི་ནུས༌སམ། བརྩི་ནུས་ན་རྩིས་ཤིག་ཅེས༌དང༌། ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་ཀྱི་རིགས་རྒྱུད་ཀྱང་དེ་བཞིན་དུ་འབྱུང་བར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཨབ་རམ་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དད་པ་བྱས་ཤིང་དཀོན་མཆོག་ཡ་ཝཱེས་ཀྱང་ཁོང་ནི་མི་རྣམ་དག་ཏུ་བརྩིས༌སོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཨབ་རམ་ལ་འདི་སྐད༌དུ། བདག་ནི་ཡ་ཝཱེ་ཡིན༌ཏེ། བདག་གིས་ཀ་ན་ཨན་གྱི་ཡུལ་འདི་ཁྱོད་ལ་བགོ་སྐལ་དུ་སྦྱིན་པའི༌ཕྱིར། དེ་སྔར་ཁྱོད་རང་ཀལ་དི་ཡུལ་གྱི་ཨུར་ནས་ཁྲིད་ཡོང་བ་ཡིན་ཞེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":8,"content":["ཨབ་རམ་ན༌རེ། ཀྱེ། གཙོ་བོ་ཡ་ཝཱེ༌ལགས། ངས་ཡུལ་འདི་བདག་གི་བགོ་སྐལ་ཡིན་པ་ཅི་ལྟར་ཤེས་ནུས་སམ་ཞེས་ཞུས༌ཤིང༌།"]},{"type":"verse","number":9,"content":["ཡང་དཀོན་མཆོག་གིས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་བ་དྲུས་མ༌དང༌། ར༌མ། ལུག་ཐུག་བཅས་ལོ་གསུམ་ཅན་གཅིག་རེ༌དང༌། གཞན༌ཡང༌། བྱ་ཐི་བ་དང་ཕུག་རོན་ཆུང་ངུ་གཅིག་རེ་བདག་གི་མདུན་དུ་ཁྱེར་ཤོག་ཅེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":10,"content":["ཨབ་རམ་གྱིས་ཀྱང་དེ་ལྟར་ཁྱེར་ཡོང་བ༌དང༌། དེ་དག་རེ་རེ་བཞིན་དུམ་བུ་གཉིས་སུ་བགོས་ཤིང་དུམ་བུ་རེ་རེ་བཞིན་བཤམས་ནས༌བཞག འོན༌ཀྱང༌། བྱ་ཐི་བ་དང་ཕུག་རོན་ཆུང་ངུ་གཉིས་དུམ་བུར་མ་བགོས༌སོ།།"]},{"type":"verse","number":11,"content":["དེ་ནས་བྱ་རྒོད་རྣམས་འཕུར་འོངས་ནས་ཕྱུགས་ཟོག་གི་ཤ་སྟེང་དུ་བབས་པས་ཨབ་རམ་གྱིས་དེ་རྣམས་བདས༌སོ།།"]},{"type":"verse","number":12,"content":["དེ་ཡང་ཉི་མ་ནུབ་པའི་དུས༌སུ། ཨབ་རམ་ལ་གཉིད་ལྕི་མོ་ཁུགས་པ་དང་འཇིགས་སུ་རུང་བའི་མུན་ནག་ཆེན་པོ་ཁོང་གི་ལུས་ལ་ཁྱབ་པར༌གྱུར།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨབ་རམ་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ངེས་པར་ཤེས་དགོས་པ༌ནི། ཁྱོད་ཀྱི་རིགས་རྒྱུད་རྣམས་མི་རིགས་གཞན་གྱི་ཡུལ་དུ་སྡོད་པར་བྱེད༌ཅིང༌། ཁོ་རྣམས་ཀྱིས་ལོ་འཁོར་བཞི་བརྒྱའི་རིང་ལ་ཡུལ་དེའི་མི་རྣམས་ལ་གཡོག་བྱེད་པ་དང་དེ་དག་གི་གཉའ་གནོན་མྱང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཁོ་རྣམས་ཀྱིས་གཡོག་བྱེད་པའི་རྒྱལ་ཁབ་དེ་ལ་བདག་གིས་ཉེས་ཆད་གཅོད་པར་འགྱུར༌ཞིང༌། དེའི་རྗེས༌སུ། ཁྱོད་ཀྱི་རིགས་རྒྱུད་རྣམས་ཀྱིས་ཡུལ་དེ་ནས་རྒྱུ་ནོར་མང་པོ་ཁྱེར་ནས་ཡུལ་དེ་དང་ཁ་འབྲལ་བར༌འགྱུར།"]},{"type":"verse","number":15,"content":["འོན༌ཀྱང༌། ཁྱོད་ནི་ཚེ་རིང་བར་འགྱུར༌ཞིང༌། མཇུག་མཐར་བདེ་བའི་ངང་ཕ་མེས་ཡང་མེས་རྣམས་ཀྱི་གམ་དུ་འགྲོ་བ་དང་དུར་ལ་འཇུག་པར་བྱེད༌དོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་མི་རབས་བཞི༌པར། ཁྱོད་ཀྱི་རིགས་རྒྱུད་རྣམས་ཕྱིར་ཡུལ་འདིར་འབྱོན་ངེས༌ཏེ། ཨེ་མོར་མི་རིགས་ཀྱི་ནག་ཉེས་ད་དུང་ལོངས་མེད་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཉི་མ་ནུབ་ནས་མུན་རུབ་པ༌ན། གློ་བུར༌ཉིད་དུ། དུ་བ་འཕྱུར་བའི་ཐབ་ཀ་དང་དམར་ལམ་ལམ་བྱེད་པའི་དཔལ་འབར་དེ་གཉིས་ནི་ཕྱུགས་ཟོག་གི་ཤ་རྣམས་ཀྱི་བར་བརྒྱུད་ནས་སོང༌ངོ༌།།"]},{"type":"verse","number":18,"content":["ཉིན་དེ༌ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཨབ་རམ་ལ་ཞལ་ཆད་བཞག་སྟེ་འདི་སྐད༌དུ། བདག་གིས་ཨེ་ཅིབ་ཀྱི་ཆུ་བོ་ནས་ཕི་རཱད་ཆུ་བོའི་བར་གྱི་ས་ཆ་འདི་དག་ཁྱོད་ཀྱི་རིགས་རྒྱུད་ལ་སྤྲད་ཟིན༌ཏེ།"]},{"type":"verse","number":19,"content":["དེའང་ས་ཆ་དེ་དག་གི་ད་ལྟའི་བདག་པོ་ནི་ཀེ་ནེ་མི་རིགས༌དང༌། ཀ་ནེ་ཟི་མི༌རིགས། ཀད་མོན་མི༌རིགས།"]},{"type":"verse","number":20,"content":["ཧེད་མི༌རིགས། ཕེ་རེ་ཟི་མི༌རིགས། རེ་པཱ་མི༌རིགས།"]},{"type":"verse","number":21,"content":["ཨེ་མོར་མི༌རིགས། ཀ་ན་ཨན་མི༌རིགས། གིར་གས་མི༌རིགས། ཡེ་བུ་སི་མི་རིགས་བཅས་ཡིན་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/GEN/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}