{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["དེ་ལྟར་ནམ་མཁའ་དང་ས་གཞི་དང་དངོས་པོ་ཐམས་ཅད་ལེགས་པར་བཀོད༌ཅིང༌།"]},{"type":"verse","number":2,"content":["ཉིན་བདུན་པའི་སྔོན་དུ་དཀོན་མཆོག་གིས་མཛད་པའི་འཕྲིན་ལས་ཐམས་ཅད་ལེགས་པར་གྲུབ་པ་དང་ཉིན་བདུན་པ་ལ་ངལ་གསོ་མཛད༌དོ།།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་གིས་ཉིན་བདུན་པ་ལ་བྱིན་གྱིས་བརླབས་ཤིང་ཉིན་དེ་ནི་དམ་པར་མཛད་པ༌སྟེ། རྒྱུ་མཚན་ནི་ཉིན་དེར་ཁོང་གིས་བཀོད་པའི་འཕྲིན་ལས་ཐམས་ཅད་འགྲུབ་པར་མཛད་ནས་ངལ་གསོ་གནང་བའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["འཇིག་རྟེན་གྱི་མི་ཐོག་མ་ཇི་ལྟར་བཀོད༌ཚུལ།"]},{"type":"verse","number":4,"content":["དེ་ཡང་ནམ་མཁའ་དང་ས་གཞི་བཀོད་པའི་ལོ་རྒྱུས་ནི་འདི་ལྟ༌སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་",{"noteId":3},"ནམ་མཁའ་དང་ས་གཞི་བཀོད་པའི་དུས༌ལ།"]},{"type":"verse","number":5,"content":["ས་རྒོད་སྟེང་དུ་སྡོང་ཕྲན་མེད་ལ་ཞིང་ཁར་སྔོ་ཚལ་ཡང་སྐྱེ་མེད༌དེ། དཀོན་མཆོག་ཡ་ཝཱེས་ད་དུང་ས་ལ་ཆར་བ་འབབ་པར་མ་མཛད༌ཅིང༌། ཞིང་འདེབས་མཁན་ཡང་མེད༌དོ།།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་ས་ནས་རླངས་པ་འཕྱུར་ཏེ་ས་གཞི་ཡོངས་སུ་བརླན་པར་བྱས༌སོ།།"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ས་རྡུལ་གྱིས་སྐྱེས་པ་ཞིག་བཟོས་པ༌དང༌། དེའི་སྣ་ཁུང་ལ་ཚེ་སྲོག་གི་ཞལ་ཕུ་བརྒྱབ་ནས་སྲོག་དང་ལྡན་པའི་མི་ཞིག་ཏུ་འགྱུར་བར་མཛད༌དོ།།"]},{"type":"verse","number":8,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཤར་ཕྱོགས་ཀྱི་ཨེ་དེན་ཡུལ་དུ་ལྡུམ་ར་ཞིག་བསྐྲུན་ཅིང་ཁོང་གིས་བཟོས་པའི་སྐྱེས་པ་དེའང་ཡུལ་དེར་བསྐྱལ༌ཏོ།།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ས་ནས་ལྗོན་ཤིང་སྣ་ཚོགས་སྐྱེ་རུ་བཅུག་ཅིང་དེ་དག་ནི་ལྟ་ན་སྡུག་པ་དང་དེ་དག་གི་ཤིང་ཏོག་ཟོས་ན་ཞིམ་མངར་ལྡན་པར་མཛད༌ཅིང༌། ལྡུམ་རའི་དཀྱིལ་དུ་ཚེ་སྲོག་གི་ལྗོན་ཤིང་དང་བཟང་ངན་རྟོགས་པའི་ལྗོན་ཤིང་ཡང་ཡོད་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":10,"content":["དེ་ཡང་ཨེ་དེན་ཡུལ་ནས་ཆུ་བོ་ཞིག་བཞུར་འོངས་ཏེ་ལྡུམ་ར་བརླན་པར་བྱས་པ༌དང༌། གནས་དེར་ཆུ་བོ་བཞི་རུ་གྱེས༌ཤིང༌།"]},{"type":"verse","number":11,"content":["ཆུ་བོ་དང་པོའི་མིང་ལ་ཕི་ཤོན་ཟེར་བ༌དང༌། དེ་ནི་ཧ་བེ་ལཱའི་ཡུལ་ཐམས་ཅད་བརྒྱུད་ནས་བཞུར་བ་དང་ཡུལ་དེ་རུ་གསེར་ཡང་ཡོད༌ཅིང༌།"]},{"type":"verse","number":12,"content":["ཡུལ་དེའི་གསེར་ནི་ཤིན་ཏུ་ལེགས༌སོ། །ཡུལ་དེ་རུ་པེ་དེལ་ཡོན་ཞེས་པའི་ཐང་ཆུ་དང་རིན་པོ་ཆེ་གཟིའང་ཡོད༌དོ།།"]},{"type":"verse","number":13,"content":["ཆུ་བོ་གཉིས་པའི་མིང་ལ་གེ་ཧོན་ཟེར་བ་དང་དེ་ནི་གུ་ཤའི་ཡུལ་ཐམས་ཅད་བརྒྱུད་ནས་བཞུར༌རོ།།"]},{"type":"verse","number":14,"content":["ཆུ་བོ་གསུམ་པའི་མིང་ལ་ཧི་དཱི་ཀེལ་ཟེར་ཞིང་ཨ་སུར་ཡུལ་གྱི་ཤར་ཕྱོགས་སུ་བཞུར༌རོ། །ཆུ་བོ་བཞི་པའི་མིང་ལ་ཕི་རཱད་ཅེས་ཟེར༌རོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་སྐྱེས་པ་དེ་ཨེ་དེན་ལྡུམ་རར་བསྐྱལ་ནས་བདག་གཉེར་བྱེད་མཁན་དུ་བསྐོས༌སོ།།"]},{"type":"verse","number":16,"content":["ཁོང་གིས་སྐྱེས་པ་དེ་ལ་འདི་སྐད༌དུ། ལྡུམ་ར་ནང་གི་ལྗོན་ཤིང་སྣ་ཚོགས་ཀྱི་ཤིང་ཏོག་ཟས་སུ་སྤྱོད་རུང༌མོད།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང་བཟང་ངན་རྟོགས་པའི་ལྗོན་ཤིང་དེའི་ཤིང་ཏོག་བཟའ་མི༌རུང༌། ཅིའི་ཕྱིར་ཞེ༌ན། ཁྱོད་ཀྱིས་དུས་ནམ་ཞིག་ལ་ཟོས་པར་གྱུར་ན་འཆི་བར་འགྱུར་བའི་ཕྱིར་ཡིན་ཞེས་བཀའ་གནང༌ངོ༌།།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད༌དུ། སྐྱེས་པ་དེ་གཅིག་པུ་བསྡད་ན་མི་ལེགས༌ཏེ། བདག་གིས་ཁོ་ལ་འཚམ་པའི་ལས་གྲོགས་ཤིག་བཟོ་བར་བྱ་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ས་སྟེང་གི་དུད་འགྲོ་དང་ནམ་མཁའི་བྱ་ཐམས་ཅད་ས་ལས་བཟོས་པ་དང་སྐྱེས་པ་དེའི་མདུན་དུ་ཁྲིད་ཡོང༌སྟེ། ཁོས་དེ་དག་ལ་མིང་ཅི་གདགས་པར་གཟིགས༌སོ། །སྐྱེས་པ་དེས་སེམས་ཅན་རྣམས་ལ་མིང་གང་ཞིག་བཏགས་པ་བཞིན་སེམས་ཅན་མཐའ་དག་ལ་མིང་ཡོད་པར༌གྱུར།"]},{"type":"verse","number":20,"content":["སྐྱེས་པ་དེས་ཕྱུགས་ཟོག་ཐམས་ཅད༌དང༌། ནམ་མཁའི་བྱ༌དང༌། ས་སྟེང་གི་དུད་འགྲོ་རེ་རེ་བཞིན་དུ་མིང་བཏགས༌ཀྱང༌། ཨ་དམ་",{"noteId":4},"གྱིས་རང་ལ་འོས་པའི་ལས་གྲོགས་ཤིག་རྩ་བ་ནས་མ་མཐོང༌ངོ༌།།"]},{"type":"verse","number":21,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་དམ་གཉིད་ལྕི་མོ་ཁུགས་སུ་བཅུག་པ༌དང༌། ཁོང་གིས་ཨ་དམ་གྱི་རྩིབ་རུས་གཅིག་བླངས་ཤིང་རྨ་ཤུལ་ཤ་ཡིས་སྦྱར་བར་མཛད༌དོ།།"]},{"type":"verse","number":22,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེས་སྐྱེས་པ་དེའི་རྩིབ་མ་ལས་བུད་མེད་ཅིག་མཛད་དེ་ཁོའི་གམ་དུ་ཁྲིད་པ༌ལ།"]},{"type":"verse","number":23,"content":["ཁོས་འདི་ལྟར་སྨྲས༌པ།",{"text":"འདི་ནི་རུས་པ་ལས་བྱུང་རུས་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"བདག་གི་ཤ་ལས་བྱུང་བའི་ཤ་ཡིན༌ནོ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོའི་མིང་ལ་སྐྱེས་མ་འདོགས་པར༌བྱ།།","poem":1},{"lineBreak":true},{"text":"དེ་ནི་སྐྱེས་པའི་ལུས་ནས་བྱུང་ཕྱིར༌རོ། །ཞེས༌པའོ།།","poem":1}]},{"type":"verse","number":24,"content":["དེ་བས་སྐྱེས་པ་ནི་རང་གི་ཕ་མ་དང་ཁ་བྲལ་ནས་རང་གི་ཆུང་མར་འབྲེལ་ཏེ་ཁོ་གཉིས་ལུས་པོ་གཅིག་ཏུ་འགྱུར༌རོ།།"]},{"type":"verse","number":25,"content":["དུས་དེར་ཁྱོ་ཤུག་གཉིས་ལུས་པོ་གཅེར་བུ་ཡིན་ཡང་ངོ་གནོང་བ་མེད༌དོ།།"]}],"footnotes":[{"noteId":3,"caller":"+","text":"ཡ་ཝཱེ་ཞེས་པ་ནི་དཀོན་མཆོག་གི་མཚན་ཏེ་རྟག་ཏུ་བཞུགས་པ་དང་ཐོག་མཐའ་མེད་པའི་དཀོན་མཆོག་དེ་ཉིད༌ཡིན།","reference":{"chapter":2,"verse":4}},{"noteId":4,"caller":"+","text":"འདིར་ཨ་དམ་ཞེས་པ་ནི་གོང་དུ་བརྗོད་པའི་སྐྱེས་པ་དེ་ཞེས་པར་གོ༌དགོས།","reference":{"chapter":2,"verse":20}}]},"thisChapterLink":"/api/bod_ntb/GEN/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}