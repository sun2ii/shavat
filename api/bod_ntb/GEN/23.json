{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":23,"content":[{"type":"heading","content":["སཱ་ར་ཚེ་ལས་འདས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་སཱ་ར་དགུང་ལོ་བརྒྱ་དང་ཉེར་བདུན་ལ་བཞུགས༌ཤིང༌། དེ་ནི་སཱ་རའི་མི་ཚེ་གང་པོའི་ཚེ་ཚད་ཡིན༌ནོ།།"]},{"type":"verse","number":2,"content":["ཁོ་མོ་ཀ་ན་ཨན་ཡུལ་གྱི་ཀིར་ཡཱད་ཨར་པཱ་གྲོང་ཁྱེར༌ཏེ། དེང་སང་གི་ཧེབ་རོན་དུ་ཚེ་ལས་འདས༌པས། ཨབ་ར་ཧམ་ནང་དུ་སོང་ནས་མྱ་ངན་དང་ངུ་འབོད་བྱས་པ༌དང༌།"]},{"type":"verse","number":3,"content":["ཕྱིས་སུ་ཨབ་ར་ཧམ་འདས་པོ་སཱ་རའི་མདུན་ནས་ཡར་ལངས༌ཏེ། ཧེད་ཀྱི་བུ་རྒྱུད་རྣམས་ལ་འདི་སྐད༌དུ།"]},{"type":"verse","number":4,"content":["བདག་ནི་ཁྱེད་རྣམས་ཀྱི་ཁྲོད་ནས་ཕྱི་ཕྱོགས་པ་ཡིན༌ལ། བྱེས་པ་ཞིག་ཀྱང་ཡིན༌པས། ཁྱེད་ཅག་གིས་འདི་ནས་བདག་ལ་དུར་ས་ཞིག་གནང་བར༌ཞུ། ངས་ཁོ་མོའི་བེམ་པོ་བདག་གི་མིག་ལམ་ནས་དུར་ལ་སྦ་བར་བྱ་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":5,"content":["ཧེད་ཀྱི་བུ་རྒྱུད་རྣམས་ན༌རེ།"]},{"type":"verse","number":6,"content":["ཇོ་བོ༌ལགས། ཁྱེད་ཀྱིས་གསན་རོགས༌གནང༌། ཁྱེད་ནི་ངེད་ཅག་གི་ཁྲོད་དུ་རྒྱལ་སྲས་མཆོག་གྱུར་ཞིག་ཡིན༌ལ། ཁྱེད་ཀྱིས་ངེད་ཅག་གི་དུར་ཁྲོད་ལས་ཆེས་བཟང་བའི་གནས་སུ་ཁྱེད་ཀྱི་བེམ་པོ་དུར་ལ་སྦས་ཀྱང་རུང༌སྟེ། ངེད་ཅག་སུ་ཞིག་གིས་ཀྱང་རང་གི་དུར་ཁྲོད་དུ་ཁྱེད་ཀྱི་བེམ་པོ་དུར་ལ་སྦ་རུ་མི་འཇུག་པ་མེད་ཅེས་ལན་བཏབ༌བོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཨབ་ར་ཧམ་ཡར་ལངས་ཤིང་གནས་དེའི་ཧེད་ཀྱི་བུ་རྒྱུད་རྣམས་ལ་གུས་པ་བྱས༌ཏེ།"]},{"type":"verse","number":8,"content":["འདི་སྐད༌དུ། ངས་ཁོ་མོའི་བེམ་པོ་བདག་གི་མིག་ལམ་ནས་དུར་ལ་སྦ་བར་ཁྱེད་རྣམས་འཐད་པ་ཡིན༌ན། ཁྱེད་ཅག་གིས་གསོན་དང༌། བདག་གི་ཆེད་དུ་ཁྱེད་རྣམས་བར་སྡོད་པ་བྱས་ནས་ཚོ་ཧར་གྱི་བུ་ཨེབ་རོན་ལ་ཞུ་བ་ཞུས༌ཏེ།"]},{"type":"verse","number":9,"content":["ས་ཞིང་གི་གོང་དུ་ཡོད་པའི་མཱག་ཕེ་ལཱ་བྲག་ཁུང་དེ་བདག་ལ་དུར་ས་རུ་གནང་བ༌དང༌། ཨེབ་རོན་གྱིས་བྲག་ཁུང་དེ་རིན་གོང་དངོས་མ་ལྟར་ཁྱེད་ཀྱི་མིག་མདུན་ནས་བདག་ལ་བཙོང་བར་མཛོད་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":10,"content":["སྐབས་དེར་ཧེད་ཀྱི་བུ་རྒྱུད་ཨེབ་རོན་རང་གི་སྤུན་ཟླ་རྣམས་ཀྱི་ཁྲོད་དུ་ཡོད༌པས། ཨེབ་རོན་གྱིས་མཁར་སྒོ་བརྒྱུད་ནས་འགྲོ་འོང་བྱེད་པའི་ཧེད་ཀྱི་བུ་རྒྱུད་ཐམས་ཅད་ཀྱི་ཁྲོད་དུ་ཨབ་ར་ཧམ་ལ་འདི་ལྟར་སྨྲས་པ༌སྟེ།"]},{"type":"verse","number":11,"content":["དེ་འདྲ་ག་ལ༌ཡིན། བདག་གི་ཇོ་བོ༌ལགས། གསོན་དང༌། བདག་གིས་ས་ཞིང་འདི་ཁྱེད་ལ་སྟེར་བ༌དང༌། ཐ་ན་ཞིང་བར་གྱི་བྲག་ཁུང་ཡང་ཁྱེད་ལ་སྟེར་རྒྱུ༌དང༌། ངེད་ཅག་མི་རིགས་ཀྱི་མིག་མདུན་ནས་ཐམས་ཅད་ཁྱེད་ལ་སྟེར་རྒྱུ་ཡིན༌པས། ཁྱེད་ཀྱིས་རང་གི་བེམ་པོ་དུར་ལ་སྦ་བར་གྱིས་ཞེས༌པའོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཡང་ཨབ་ར་ཧམ་གྱིས་ཡུལ་དེའི་མི་རྣམས་ལ་གུས་པ་བྱས༌རྗེས།"]},{"type":"verse","number":13,"content":["ཁོ་རྣམས་ཀྱི་མིག་མདུན་ནས་ཨེབ་རོན་ལ་འདི་སྐད༌དུ། ཁྱེད་རང་འཐད་པ་ཡིན༌ན། བདག་གི་གཏམ་ལ་མཉན་པར༌མཛོད། ངས་ས་རིན་ཐམས་ཅད་ཁྱེད་ལ་སྟེར་རྒྱུ་ཡིན་པ༌དང༌། ཁྱེད་ཀྱིས་ཀྱང་ལེན་པར༌མཛོད། ངས་གནས་དེ་རུ་བདག་གི་བེམ་པོ་དུར་ལ་སྦ་བར་བྱ་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":14,"content":["ཨེབ་རོན་ན༌རེ།"]},{"type":"verse","number":15,"content":["བདག་གི་ཇོ་བོ༌ལགས། ཁྱེད་ཀྱིས་གསོན་དང༌། ས་རིན་དངུལ་སྲང་",{"noteId":25},"བཞི་བརྒྱ་ཡིན་པའི་ས་ཞིང་ནི་ངེད་གཉིས་བར་དུ་ཅི་ཡང་མ་ཡིན༌ཏེ། ཁྱེད་ཀྱིས་རང་གི་བེམ་པོ་དུར་དུ་སྦ་བར་གྱིས་ཞེས་ལན་བཏབ༌བོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཨབ་ར་ཧམ་གྱིས་ཨེབ་རོན་གྱི་གཏམ་ལ་མཉན༌ཅིང་། ཁོང་གིས་ཧེད་ཀྱི་བུ་རྒྱུད་རྣམས་ཀྱི་མདུན་དུ་སྨྲས་པ་བཞིན་བསྒྲུབས༌ཏེ། ཉོ་འཚོང་བྱེད་པར་བཀོལ་བའི་དངུལ་སྲང་བཞི་བརྒྱ་དེ་སྲང་ལ་འཇལ་ནས་ཨེབ་རོན་ལ་སྤྲད་དོ།།"]},{"type":"verse","number":17,"content":["དེ་ལྟར་ཨབ་ར་ཧམ་གྱིས་ཨེབ་རོན་གྱི་ས་ཞིང་ཉོས་པ༌དང༌། ས་ཞིང་དེ་ནི་མཱག་ཕེ་ལཱ་ཞེས་པའི་ས་ཆར་ཡོད་པར་མ༌ཟད། མཱན་རེའེ་ཡུལ་གྱི་མདུན་ཕྱོགས་སུ་ཡོད༌ཅིང༌། ས་ཞིང་དེ་དང་དེ་རུ་ཡོད་པའི་བྲག་ཁུང༌དང༌། ཞིང་བར་དང་དེའི་མཐའ་སྐོར་གྱི་ལྗོན་ཤིང་ཐམས་ཅད་ཨབ་ར་ཧམ་ལ་དབང་བ༌དང༌། ས་ཞིང་དེ་ནི་མཁར་སྒོ་བརྒྱུད་ནས་འགྲོ་འོང་བྱེད་པའི་ཧེད་ཀྱི་བུ་རྒྱུད་ཐམས་ཅད་ཀྱི་མིག་མདུན་ནས་ཉོས༌པའོ།།"]},{"type":"verse","number":19,"content":["དོན་དེའི་རྗེས༌སུ། ཨབ་ར་ཧམ་གྱིས་རང་གི་ཆུང་མ་སཱ་རའི་བེམ་པོ་ཀ་ན་ཨན་ཡུལ་གྱི་མཱག་ཕེ་ལཱ་ཞེས་པའི་ས་ཆར་ཡོད་པའི་ས་ཞིང་གི་བྲག་ཁུང་དུ་དུར་ལ་སྦས༌སོ། །བྲག་ཁུང་དེ་མཱན་རེའེ་ཡུལ་གྱི་མདུན་ཕྱོགས་སུ་ཡོད༌ཅིང༌། མཱན་རེའེ་ཞེས་པ་ནི་ཧེབ་རོན༌ཡིན།"]},{"type":"verse","number":20,"content":["དུས་དེ་ནས༌བཟུང༌། ས་ཞིང་དེ་དང་དེ་རུ་ཡོད་པའི་བྲག་ཁུང་ནི་ཧེད་ཀྱི་བུ་རྒྱུད་རྣམས་ཀྱིས་ཁས་བླངས་པ་ལྟར་ཨབ་ར་ཧམ་ལ་དབང་བ་དང་ཁོང་གི་ཁྱིམ་རྒྱུད་ཀྱི་དུར་ཁྲོད་དུ་གྱུར༌ཏོ།།"]}],"footnotes":[{"noteId":25,"caller":"+","text":"འདིར་དངུལ་སྲང་ཞེས་པའི་སྲང་ལ་མ་ཕྱི་ལས་ཤེ་ཀོལ་ཞེས་མཐོང་བ་དང་། དེ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱ་མི་རིགས་ཀྱི་ལྗིད་ཚད་འཇལ་བྱེད་ཅིག་ཡིན་ལ། གནའ་བོའི་ཤེ་ཀོལ་ཞེས་པའི་ལྗིད་ཚད་ནི་དེང་སང་གི་སྤྱི་རྒྱ་གང་གི་སྟོང་ཆའི་བཅུ་གཅིག་ཙམ་ཡིན།","reference":{"chapter":23,"verse":15}}]},"thisChapterLink":"/api/bod_ntb/GEN/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/22.json","previousChapterAudioLinks":{},"numberOfVerses":19}