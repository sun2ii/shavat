{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":32,"content":[{"type":"heading","content":["ཡ་ཀོབ་རང་གི་གཅེན་པོ་ཨེ་སཱབ་ལ་འཕྲད་པར་རྩོམ༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡ་ཀོབ་མུ་མཐུད་དུ་ལམ་ལ་ཆས་ཤིང་དཀོན་མཆོག་གི་ཕོ་ཉ་རྣམས་ཁོ་དང་ཕྲད་པ༌དང༌།"]},{"type":"verse","number":2,"content":["ཡ་ཀོབ་ཀྱིས་ཕོ་ཉ་རྣམས་མཐོང༌སྟེ། འདི་ནི་དཀོན་མཆོག་གི་དམག་དཔུང་ཡིན་ཞེས་སྨྲས་པས་གནས་དེར་མཱ་ཧ་ནཱ་ཡིམ་",{"noteId":47},"ཞེས་མིང་བཏགས༌སོ།།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཡ་ཀོབ་ཀྱིས་ཨེ་དོམ་ཡུལ་གྱི་སེ་ཨེར་དུ་ཡོད་པའི་གཅེན་པོ་ཨེ་སཱབ་ཀྱི་གམ་དུ་མི་འགའ་མངགས་ཤིང་དེ་རྣམས་ལ་ན་རེ།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་གིས་བདག་གི་ཇོ་བོ་ཨེ་སཱབ་ལ་འདི་ལྟར་ཤོད་ཅིག ཁྱེད་ཀྱི་ཞབས་ཕྱི་པ་ཡ་ཀོབ་ཀྱིས་ཁྱེད་ལ་འདི༌ལྟར་སྨྲའོ།། བདག་ནི་ད་ལྟའི་བར་དུ་ལཱ་པན་དང་མཉམ་དུ་བསྡད༌ཅིང༌།"]},{"type":"verse","number":5,"content":["བདག་ལ་བ་གླང༌དང༌། བོང༌བུ། ར་ལུག་གི༌ཁྱུ། གཡོག་པོ་གཡོག་མོ་སོགས་ཡོད་པ༌དང༌། ཁྱེད་ཀྱི་སྤྱན་དྲུང་ནས་བདག་ལ་ཐུགས་རྗེ་འཐོབ་པའི༌ཕྱིར། ད་ལྟ་བདག་གིས་དོན་འདི་ཁྱེད་ལ་ཞུ་བར་མི་མངགས་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡ་ཀོབ་ཀྱིས་མངགས་པའི་མི་རྣམས་ཕྱིར་ལོག་སྟེ་ན༌རེ། ངེད་ཅག་ཁྱེད་ཀྱི་གཅེན་པོ་ཨེ་སཱབ་ཀྱི་དྲུང་དུ་སོང་བ༌དང༌། ད་ལྟ་ཁོང་གིས་མི་བཞི་བརྒྱ་ཁྲིད་དེ་ཁྱེད་ཀྱི་མདུན་བསུས་ནས་ཡོང་བཞིན་ཡོད་ཅེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":7,"content":["ཡ་ཀོབ་ཤིན་ཏུ་འཇིགས་ནས་སེམས་ཁྲལ་བྱུང་བ༌དང༌། རང་གི་འཁོར་དང་བཅས་པའི་མི་ཐམས་ཅད༌དང༌། ར་ལུག་དང་བ་གླང་གི༌ཁྱུ། རྔ་མོང་སོགས་སྐོར་ཁྱུ་ཆེན་པོ་གཉིས་སུ་བགོས༌ཏེ།"]},{"type":"verse","number":8,"content":["སེམས་སུ་གལ་སྲིད་ཨེ་སཱབ་སླེབས་ནས་སྐོར་ཁྱུ་འདི་འཇོམས་པར་བྱས༌ན། སྐོར་ཁྱུ་ཅིག་ཤོས་ནི་ད་དུང་བྲོས་ཆོག་པ་ཡིན་སྙམ༌པའོ།།"]},{"type":"verse","number":9,"content":["ཡ་ཀོབ་ན༌རེ། ཀྱེ། དཀོན་མཆོག་ཡ༌ཝཱེ། བདག་གི་མེས་པོ་ཨབ་ར་ཧམ་དང་ཡབ་ཨི་སཱག་གི་དཀོན་མཆོག༌ལགས། ཁྱེད་ཀྱིས་དེ་སྔར་བདག་ལ་ཁྱོད་ནི་རང་གི་ཕ་ཡུལ་དང་གཉེན་ཉེ་རྣམས་ཀྱི་གམ་དུ་སོང༌ཞིག བདག་གིས་ཁྱོད་ལ་སྐྱབས་མཛད་ངེས་ཡིན་ཞེས་གསུངས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":10,"content":["ཁྱེད་ཀྱིས་ཞབས་ཕྱི་པ་བདག་ལ་གནང་བའི་བྱམས་སྙིང་རྗེ་དང་དྲང་བདེན་ཐམས་ཅད་ནི་བདག་ལ་མི་འོས༌སོ། །སྔོན་ཆད་བདག་གིས་མཁར་བ་བཟུང་ནས་ཡོར་དན་གཙང་པོ་འདི་ལས་བརྒལ་བ༌དང༌། ད་ལྟ་བདག་ནི་སྡེ་ཚན་ཆེན་པོ་གཉིས་སུ་གྱུར༌ཡོད།"]},{"type":"verse","number":11,"content":["ཁྱེད་ཀྱིས་ང་རང་བདག་གི་གཅེན་པོ་ཨེ་སཱབ་ལས་སྐྱོབ་པར༌མཛོད། ཅིའི་ཕྱིར་ཞེ༌ན། གཅེན་པོས་བདག་དང་བདག་གི་ཆུང་མ་བུ་ཕྲུག་བཅས་མཉམ་དུ་གསོད་པར་འཇིགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":12,"content":["ཁྱེད་ཀྱིས་དེ་སྔར་བདག་ལ་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་ལ་སྐྱབས་མཛད་ངེས༌ཡིན། ཁྱོད་ཀྱི་རིགས་རྒྱུད་ནི་རྒྱ་མཚོའི་འགྲམ་གྱི་བྱེ་མ་བཞིན་མང་དུ་སྤེལ་བར་ངེས་ཞེས་གསུངས་མྱོང་བ་ཡིན་ཞེས་གསོལ་བ་བཏབ༌བོ།།"]},{"type":"verse","number":13,"content":["ཉིན་དེའི་མཚན༌མོར། ཡ་ཀོབ་ཡུལ་དེར་བསྡད་ཅིང་ཁོ་ལ་དབང་བའི་རྒྱུ་ནོར་ཐམས་ཅད་ལས་རང་གི་གཅེན་པོར་ལེགས་སྐྱེས༌སུ།"]},{"type":"verse","number":14,"content":["ར་མ་ཉིས་བརྒྱ༌དང༌། ར་ཐུག་ཉི༌ཤུ། མ་མོ་ཉིས༌བརྒྱ། ལུག་ཐུག་ཉི༌ཤུ།"]},{"type":"verse","number":15,"content":["འོ་མ་སྣུན་པའི་རྔ་མོང་སུམ་ཅུ་དང་དེའི་ཕྲུ་གུ་དང་བཅས༌པ། བ་མོ་བཞི་བཅུ་དང་བ་གླང༌བཅུ། བོང་མ་ཉི་ཤུ་དང་བོང་གསེབ་བཅུ་བཅས༌ཏེ།"]},{"type":"verse","number":16,"content":["རིགས་རེ་རེ་ལས་ཁྱུ་རེ་བླངས་ནས་གཡོག་པོ་རྣམས་ལ་སྤྲད༌དེ། ཁྱོད་ཅག་བདག་གི་སྔོན་ལ་སོང༌དང༌། ཕྱུགས་ཁྱུ་རེ་རེ་བཞིན་སོ་སོར་ཕྱེས་ནས་སོང་ཞིག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཡ་ཀོབ་ཀྱིས་འགྲོ་ཐེངས་ཐོག་མ་རྣམས་ལ་འདི་ལྟར་སྨྲས༌པ། བདག་གི་གཅེན་པོ་ཨེ་སཱབ་ཁྱོད་དང་འཕྲད་པའི་དུས༌སུ། ཁོ་ན༌རེ། ཁྱོད་སུ་ཚང་གི་ཡིན་པ་དང་གང་ལ་འགྲོ་བ༌ཡིན། ཁྱོད་ཀྱི་སྔོན་དུ་ཡོད་པའི་ཕྱུགས་ཁྱུ་འདི་དག་སུ་ཞིག་གི་ཡིན་ནམ་ཞེས་དྲིས༌ན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་འདི་ལྟར་ཤོད༌ཅིག འདི་དག་ནི་ཁྱེད་ཀྱི་ཞབས་ཕྱི་པ་ཡ་ཀོབ་ཀྱི་ཡིན༌ལ། བདག་གི་ཇོ་བོ་ཨེ་སཱབ་ལ་བསྐུར་བའི་ལེགས་སྐྱེས་ཡིན༌ཞིང༌། ཡ་ཀོབ་ཁོ་རང་ཡང་ངེད་ཅག་གི་རྗེས་སུ་ཡོད་ཅེས་སྨྲོས་ཤིག་ཅེས་པའོ། །"]},{"type":"verse","number":19,"content":["དེ་ནས་ཡང་ཡ་ཀོབ་ཀྱིས་འགྲོ་ཐེངས་གཉིས་པ་དང་གསུམ༌པ། ཕྱུགས་ཟོག་འདེད་མཁན་གཞན་ཐམས་ཅད་ལ་འདི༌ལྟར། ཁྱོད་ཅག་བདག་གི་གཅེན་པོ་ཨེ་སཱབ་ལ་འཕྲད་པའི་དུས་སུའང་འདི་ལྟར་སྨྲ་དགོས་པར་མ༌ཟད།"]},{"type":"verse","number":20,"content":["ཁྱེད་ཀྱི་ཞབས་ཕྱི་པ་ཡ་ཀོབ་ནི་ངེད་ཅག་གི་རྗེས་སུ་ཡོད་ཅེས་སྨྲོས་ཤིག་ཅེས་སྨྲས༌སོ། །ཅིའི་ཕྱིར་ཞེ༌ན། ཡ་ཀོབ་ཀྱི་སེམས༌སུ། བདག་གིས་སྔོན་ལ་མངགས་པའི་ལེགས་སྐྱེས་ལ་བརྟེན་ནས་གཅེན་པོའི་ཞེ་སྡང་ཞི་བར་བྱེད་པ༌དང༌། ཕྱིས་སུ་ཁོ་དང་ངོ་འཕྲད་དུས་སུ་ཁོས་ང་རང་ལ་དགའ་བསུ་བྱེད་ཀྱང་སྲིད་སྙམ་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":21,"content":["དེ་ལྟར་ལེགས་སྐྱེས་ཐམས་ཅད་སྔོན་དུ་བསྐུར་ཟིན༌ལ། ཉིན་དེའི་མཚན༌མོར། ཡ་ཀོབ་ལམ་བར་དུ་ཞག་སྡོད་བྱས༌སོ།།"]},{"type":"heading","content":["ཡ་ཀོབ་དཀོན་མཆོག་དང་དངོས་སུ་ཕྲད་པ།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཡ་ཀོབ་མཚན་མོ་དེར་མལ་ལས་ལངས་ཏེ་ཆུང་མ་གཉིས་ཀ༌དང༌། གཡོག་མོ༌གཉིས་ཀ གཞན་ཡང་བུ་ཕྲུག་བཅུ་གཅིག་དང་བཅས་པ་ཁྲིད་དེ་ཡཱབ་པོག་ཆུ་བོའི་རབ་ཁ་བརྒལ་ནས༌སོང༌།"]},{"type":"verse","number":23,"content":["དེ་ཡང་ཡ་ཀོབ་ཀྱིས་ཐོག་མར་ཁོ་རྣམས་ཆུ་བོར་བརྒལ་དུ་བཅུག་པ༌དང༌། དེ་ནས་གཞན་ཐམས་ཅད་ཀྱང་འགྲོ་རུ༌བཅུག"]},{"type":"verse","number":24,"content":["ཡ་ཀོབ་ཁོ་ན་ཤུལ་དུ་ལུས་ཤིང་མི་ཞིག་ཡོང་སྟེ་ནམ་ལངས་པའི་བར་དུ་ཁོ་དང་འཇུ་རེས༌བྱས།"]},{"type":"verse","number":25,"content":["མི་དེས་ཡ་ཀོབ་ལས་རྒྱལ་མི་ཐུབ་པ་ཤེས་ཏེ་ཡ་ཀོབ་ཀྱི་དཔྱི་མིག་ལ་རེག་པ༌ན། ཡ་ཀོབ་ཀྱི་དཔྱི་མགོ་ནི་འཇུ་རེས་བྱེད་སྐབས་ཚིགས་འཁྲོག་པ༌རེད།"]},{"type":"verse","number":26,"content":["དེ་ནས་མི་དེ་ན༌རེ། ད་ནི་ནམ་ལངས་སོང་བས་ང་རང་འགྲོ་རུ་ཆུག་ཅེས་སྨྲས་པ༌དང༌། ཡ་ཀོབ་ན༌རེ། ཁྱེད་ཀྱིས་བདག་ལ་བྱིན་རླབས་གནང་བ་མིན༌ན། བདག་གིས་ཁྱེད་འགྲོ་རུ་མི་འཇུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":27,"content":["དེར་མི་དེ་ན༌རེ། ཁྱོད་ཀྱི་མིང་ལ་ཅི་ཟེར་ཞེས་དྲིས་པ༌དང༌། ཡ་ཀོབ་ན༌རེ། བདག་གི་མིང་ལ་ཡ་ཀོབ་ཟེར་ཞེས་ལན༌བཏབ།"]},{"type":"verse","number":28,"content":["ཡང་མི་དེ་ན༌རེ། ད་ནས་བཟུང་ཁྱོད་ལ་ཡ་ཀོབ་ཅེས་མི་འབོད་པར་ཡེས་ར་ཨེལ་ཞེས་འདོགས་པར༌གྱིས། ཅིའི་ཕྱིར་ཞེ༌ན། ཁྱོད་ནི་དཀོན་མཆོག་དང་མིའི་རིགས་ལ་འགྲན་ཏེ་རྣམ་པར་རྒྱལ་བའི་ཕྱིར་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":29,"content":["ཡ་ཀོབ་ཀྱིས་མི་དེ་ལ་ཁྱེད་ཀྱི་མིང་ལ་ཅི་ཟེར་ཞེས་དྲིས་པ༌དང༌། མི་དེ་ན༌རེ། བདག་གི་མིང་འདྲི་བའི་རྒྱུ་མཚན་ཅི་ཞེས་སྨྲས་པ་དང་ཡ་ཀོབ་ལ་བྱིན་རླབས་གནང༌ངོ༌།།"]},{"type":"verse","number":30,"content":["དེ་ནས་ཡ་ཀོབ་ཀྱིས་ས་ཆ་དེའི་མིང་ལ་ཕཱ་ནེ་ཨེལ་",{"noteId":48},"ཞེས་བཏགས༌སོ། །ཅིའི་ཕྱིར་ཞེ༌ན། ངས་ཁ་རི་ཁ་ཐུག་ཏུ་དཀོན་མཆོག་མཇལ༌ནའང༌། ཁོང་གིས་བདག་གི་ཚེ་སྲོག་བསྐྱབས་པ་ཡིན་ཞེས་སྨྲས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":31,"content":["དེ་ཡང་ཡ་ཀོབ་ནི་ཕཱ་ནེ་ཨེལ་ཡུལ་བརྒྱུད་ནས་འགྲོ་བའི་དུས༌སུ། ཁོའི་ལུས་ལ་ཉི་འོད་ཤར་བ༌དང༌། ཁོའི་དཔྱི་ཚིགས་ན་བའི་རྐྱེན་གྱིས་རྐང་པ་གྱོལ་བཞིན་ཡོད༌དོ།།"]},{"type":"verse","number":32,"content":["དེའི༌ཕྱིར། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ད་ལྟའི་བར་དུ་ཕྱུགས་ཟོག་གི་དཔྱི་མགོའི་རྩ་རྒྱུས་མི༌ཟའོ། །ཅིའི་ཕྱིར་ཞེ༌ན། མི་དེས་ཡ་ཀོབ་ཀྱི་དཔྱི་མགོའི་རྩ་རྒྱུས་ལ་རེག་པའི་ཕྱིར༌རོ།།"]}],"footnotes":[{"noteId":47,"caller":"+","text":"མཱ་ཧ་ནཱ་ཡིམ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་སྐད་དོད་དེ་དམག་དཔུང་གཉིས་ཀྱི་དོན་ལ༌འཇུག","reference":{"chapter":32,"verse":2}},{"noteId":48,"caller":"+","text":"ཕཱ་ནེ་ཨེལ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་སྐད་དོད་དེ་དཀོན་མཆོག་གི་ཞལ་རས་ཞེས་པའི་དོན་ལ༌འཇུག","reference":{"chapter":32,"verse":30}}]},"thisChapterLink":"/api/bod_ntb/GEN/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/31.json","previousChapterAudioLinks":{},"numberOfVerses":32}