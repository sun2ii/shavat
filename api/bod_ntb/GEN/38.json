{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":38,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱ་དང་ཐལ་མཱར་ཞེས་བྱ་བའི༌སྐོར།"]},{"type":"verse","number":1,"content":["སྐབས༌དེར། ཡ་ཧུ་དཱ་རང་གི་སྤུན་ཟླ་རྣམས་དང་ཁ་བྲལ་ནས་ཨ་དུལ་ལཱམ་མི་རིགས་ཀྱི་ཧི་རཱ་ཞེས་པའི་ཁྱིམ་དུ་སོང༌ཞིང༌།"]},{"type":"verse","number":2,"content":["ཡ་ཧུ་དཱ་ཡིས་ཁྱིམ་དེ་ནས་ཀ་ན་ཨན་མི་རིགས་ཀྱི་ཤུ་ཨ་ཞེས་པ་དེའི་བུ་མོ་མཐོང་ནས་རང་གི་ཆུང་མར་བླངས་ཤིང་ལུས་འབྲེལ་བྱས་པ༌དང༌།"]},{"type":"verse","number":3,"content":["ཁོ་མོར་མངལ་ཆགས་ཏེ་བུ་ཞིག་སྐྱེས་པ་ལ་ཡ་ཧུ་དཱ་ཡིས་བུའི་མིང་ལ་ཨེར་ཞེས་བཏགས༌སོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཡང་ཁོ་མོར་མངལ་སྦྲུམ་ནས་བུ་ཞིག་སྐྱེས་པ་ལ་མ་ཡིས་བུའི་མིང་ལ་ཨོ་ནན་ཞེས་བཏགས༌སོ།།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཡང་ཁོ་མོར་མངལ་ཆགས་ཏེ་བུ་ཞིག་སྐྱེས་པ་ལ་ཤེ་ལཱ་ཞེས་བཏགས་པ༌དང༌། ཁོ་མོས་བུ་ཤེ་ལཱ་བཙའ་བའི་དུས་སུ་ཡ་ཧུ་དཱ་ནི་ཀཱ་ཟིབ་གྲོང་རྡལ་དུ་ཡོད༌དོ།།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡ་ཧུ་དཱ་ཡིས་བུ་སྐྱེས་འགོ་ཨེར་ལ་ཆུང་མ་ཞིག་བླངས་ཤིང་ཁོ་མོའི་མིང་ལ་ཐལ་མཱར་ཞེས༌ཟེར།"]},{"type":"verse","number":7,"content":["འོན༌ཀྱང༌། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་ལམ་དུ་ཡ་ཧུ་དཱའི་བུ་སྐྱེས་འགོ་ཨེར་ནི་མི་ཐ་ཤལ་ཅན་དུ་མཐོང༌བས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རང་འཆི་བར་མཛད༌དོ།།"]},{"type":"verse","number":8,"content":["དེ་ནས་ཡ་ཧུ་དཱ་ཡིས་བུ་འབྲིང་བ་ཨོ་ནན་ལ་འདི༌ལྟར། ཁྱོད་ནི་རང་གི་གཅེན་པོའི་ཆུང་མར་འགྲོགས་པ༌དང༌། གཅུང་པོའི་འགན་ཁུར་དང་དུ་བླངས་ཏེ་གཅེན་པོའི་ཆེད་དུ་ཁོ་མོར་བུ་ཞིག་སྐྱེས་པར་གྱིས་ཞེས༌སྨྲས།"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་ཨོ་ནན་གྱིས་ཁོ་མོར་བུ་སྐྱེས་ནའང་རང་ལ་མི་དབང་བ་ཤེས༌ཏེ། གཅེན་པོར་རིགས་རྒྱུད་མི་འབྱུང་བའི་ཆེད་དུ་ལུས་འབྲེལ་བྱེད་པའི་དུས་སུ་རང་གི་ཁམས་དཀར་ས་རུ་གཏོར་བ༌རེད།"]},{"type":"verse","number":10,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་ལམ་དུ་ཨོ་ནན་གྱི་ལས་དེ་ནི་ལས་ངན་པར་གཟིགས༌པས། ཁོང་གིས་ཨོ་ནན་ཡང་འཆི་བར་མཛད༌དོ།།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཡ་ཧུ་དཱ་ཡི་སེམས་སུ་བུ་ཆུང་བ་ཤེ་ལཱའང་ཁོའི་གཅེན་པོ་གཉིས་ལྟར་འཆིའོ་སྙམ༌སྟེ། མནའ་མ་ཐལ་མཱར་ལ་འདི༌ལྟར། བདག་གི་བུ་ཤེ་ལཱ་ནར་སོན་པའི་བར༌དུ། ཁྱོད་རང་གི་ཕ་གཞིས་སུ་སོང་ནས་ཡུགས་མོར་སྡོད་ཅིག་ཅེས་སྨྲས་པ༌དང༌། ཁོ་མོ་ཕ་གཞིས་སུ་སོང་ནས༌བསྡད་དོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་དུས་ཡུན་རིང་པོ་འགོར་བའི་རྗེས༌སུ། ཡ་ཧུ་དཱའི་ཆུང་མ་ཤུ་ཨ་ཡི་བུ་མོ༌ཤིའོ། །དེ་ནས་ཡ་ཧུ་དཱ་མྱ་ངན་ལས་སངས་ཏེ་ཁོའི་གྲོགས་པོ་ཨ་དུལ་ལཱམ་མི་རིགས་ཀྱི་ཧི་རཱ་ཞེས་པ་དང་མཉམ་དུ་ཐིམ་ནཱ་ཡུལ་གྱི་རང་གི་ལུག་བལ་འབྲེག་མཁན་རྣམས་ཀྱི་གམ་དུ་སོང༌ངོ༌།།"]},{"type":"verse","number":13,"content":["དེར་མི་ཞིག་གིས་ཐལ་མཱར་ལ་འདི༌ལྟར། ཁྱོད་ཀྱི་སྒྱུག་པོ་ཐིམ་ནཱ་རུ་རང་གི་ལུག་བལ་འབྲེག་ཏུ་སོང་ཞེས་པ༌ལ།"]},{"type":"verse","number":14,"content":["ཐལ་མཱར་གྱིས་ཤེ་ལཱ་ནར་སོན་ཡོད་པ་མཐོང་ཞིང་ཁོས་ད་དུང་རང་ཉིད་ཆུང་མར་མ་བླངས༌པས། ཡུགས་མོའི་གྱོན་གོས་ཕུད་དེ་གདོང་ཁེབས་ཀྱིས་ངོ་བཀབ་པ་དང་ལུས་པོའང་བཀབ༌རྗེས། ཐིམ་ནཱ་རུ་འགྲོ་བའི་ལམ་དུ་ཨེ་ནཱ་ཡིམ་གྱི་མཁར་སྒོའི་འགྲམ་དུ་ཙོག་པུར༌བསྡད།"]},{"type":"verse","number":15,"content":["ཡ་ཧུ་དཱ་ཡིས་ཁོ་མོ་མཐོང་སྟེ་སྨད་འཚོང་མ་ཞིག་ཡིན་པར་སྙམ་པ༌སྟེ། ཁོ་མོས་གདོང་ཁེབས་ཀྱིས་ངོ་བཀབ་ཡོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཡ་ཧུ་དཱ་ཕྱིར་འཁོར་ནས་ཁོ་མོའི་མདུན་དུ་ཡོང་སྟེ་ན༌རེ། ཤོག༌དང༌། ང་རང་ཁྱོད་དང་འགྲོགས་པར་བྱ་ཞེས་སྨྲས༌སོ། །རྒྱུ་མཚན་ནི་ཡ་ཧུ་དཱས་ཁོ་མོ་རང་གི་མནའ་མ་ཡིན་པ་མ་ཤེས་པའི་ཕྱིར༌རོ། །ཐལ་མཱར་ན༌རེ། ཁྱོད་བདག་དང་འགྲོགས་འདོད༌ན། ཁྱོད་ཀྱིས་བདག་ལ་ཅི་ཞིག་སྟེར་རམ་ཞེས་པ༌ལ།"]},{"type":"verse","number":17,"content":["ཡ་ཧུ་དཱ་ན༌རེ། བདག་གིས་མི་ཞིག་མངགས་ནས་རང་གི་ར་ཁྱུ་ལས་རེའུ་ཞིག་འཁྱེར་ཡོང་སྟེ་ཁྱོད་ལ་སྟེར་ཞེས༌སྨྲས། ཡང་ཐལ་མཱར་ན༌རེ། ཁྱོད་ཀྱིས་རེའུ་མ་བསྐྱལ་བའི་སྔོན༌ལ། བདག་ལ་གཏའ་མ་ཅི་ཞིག་འཇོག་གམ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":18,"content":["ཡང་ཡ་ཧུ་དཱ་ན༌རེ། བདག་གིས་ཁྱོད་ལ་གཏའ་མ་ཅི་ཞིག་འཇོག་གམ་ཞེས་སྨྲས༌ཤིང༌། ཡང་ཐལ་མཱར་ན༌རེ། ཁྱོད་ཀྱི་ཐམ་ག༌དང༌། ཐམ་གའི་རྒྱུན༌བུ། ལག་ཏུ་ཐོགས་པའི་མཁར་བ་བཅས་འཇོག་པར་མཛོད་ཅིག་ཅེས་སྨྲས་པ༌དང༌། ཡ་ཧུ་དཱ་ཡིས་དངོས་པོ་དེ་དག་ཁོ་མོར་སྤྲད༌རྗེས། ཁོ་མོ་དང་ལུས་འབྲེལ་བྱས་ཤིང་ཁོ་མོར་ཡ་ཧུ་དཱ་ལས་མངལ་སྦྲུམ་པར༌གྱུར།"]},{"type":"verse","number":19,"content":["དེ་ནས་ཁོ་མོ་ཡར་ལངས་ནས་སོང་བ་དང༌། གདོང་ཁེབས་བླངས་ཏེ་ཡང་ཡུགས་མོའི་གྱོན་གོས་ལུས་ལ་གྱོན༌ཏོ།།"]},{"type":"verse","number":20,"content":["ཡ་ཧུ་དཱ་ཡིས་རང་གི་གྲོགས་པོ་ཧི་རཱ་ལ་རེའུ་ཞིག་བསྐུར༌ཏེ། བུད་མེད་དེ་ལས་གཏའ་མ་ཕྱིར་ལེན་པར་ཕྱིན་ནའང་བུད་མེད་དེ་མ་རྙེད༌པས།"]},{"type":"verse","number":21,"content":["ཡུལ་དེ་གའི་སྐྱེས་པ་རྣམས་ལ་ཨེ་ནཱ་ཡིམ་གྱི་ལམ་ཁར་སྡོད་པའི་ཆོས་རྫུ་སྨད་འཚོང་མ་ནི་གང་དུ་ཡོད་ཅེས་དྲིས་པ༌ན། དེ་རྣམས་ཀྱིས་འདི་རུ་ཆོས་རྫུ་སྨད་འཚོང་མ་མེད་ཅེས་ལན་བཏབ༌བོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཧི་རཱ་ཕྱིར་ཡ་ཧུ་དཱའི་དྲུང་དུ་སོང་སྟེ་འདི༌ལྟར། ངས་ཁོ་མོ་རྙེད་མ༌བྱུང༌། ཡུལ་དེའི་སྐྱེས་པ་རྣམས་ཀྱིས་འདི་རུ་ཆོས་རྫུ་སྨད་འཚོང་མ་མེད་ཟེར་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":23,"content":["ཡ་ཧུ་དཱ་ན༌རེ། ལྟོས༌དང༌། བདག་གིས་རེའུ་བསྐྱལ་ནའང་ཁྱོད་ཀྱིས་ཁོ་མོ་བཙལ་ནས་མ༌རྙེད། མི་གཞན་གྱིས་རང་ཅག་ལ་འཕྱ་སྨོད་མི་བྱེད་པའི༌ཕྱིར། ཁོ་མོར་ཁྱེར་ན་འཁྱེར་དུ་ཆུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཟླ་བ་གསུམ་ཙམ་འགོར༌རྗེས། མི་ཞིག་གིས་ཡ་ཧུ་དཱ་ལ་འདི་ལྟར་སྨྲས༌པ། ཁྱོད་ཀྱི་མནའ་མ་ཐལ་མཱར་ནི་སྨད་འཚོང་མར་གྱུར་པར་མ༌ཟད། ཁོ་མོས་ལོག་གཡེམ་བྱས་ཏེ་མངལ་སྦྲུམ་འདུག་ཅེས་པ༌ན། ཡ་ཧུ་དཱ་ན༌རེ། ཁོ་མོ་དྲུད་ཡོང་ནས་མེར་བསྲེག་པར་གྱིས་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":25,"content":["དེ་ནས་ཐལ་མཱར་དྲུད་ནས་ཡོང་བའི་སྐབས༌སུ། ཁོ་མོས་རང་གི་སྒྱུག་པོར་ངག་འཕྲིན་ཞིག་བསྐུར་བ༌སྟེ། དངོས་པོ་འདི་དག་སུ་ཞིག་གི་ཡིན༌ན། བདག་ལ་དེ་ལས་མངལ་སྦྲུམ་པ༌ཡིན། དེའི༌ཕྱིར། ཁྱོད་ཀྱིས་ཐམ་ག༌དང༌། ཐམ་གའི་རྒྱུན༌བུ། མཁར་བ་འདི་དག་སུ་ཞིག་གི་ཡིན་པ་ངོས་འཛིན་པར་གྱིས་ཞེས་མི་ཞིག་ཡ་ཧུ་དཱའི་དྲུང་དུ༌མངགས།"]},{"type":"verse","number":26,"content":["དེ་ནས་ཡ་ཧུ་དཱས་ཀྱང་དངོས་པོ་དེ་དག་ངོས་ཟིན༌ཏེ། ཁོ་མོ་ནི་བདག་ལས་ཀྱང་དྲང་པོ་ཡིན༌ཏེ། བདག་གིས་ཁོ་མོ་རང་གི་བུ་ཤེ་ལཱ་ལ་ཆུང་མར་མ་བྱིན་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས༌སོ། །དུས་དེ་ནས་བཟུང་ཡ་ཧུ་དཱ་ཁོ་མོ་དང་ལུས་འབྲེལ་མ་མྱོང༌ངོ༌།།"]},{"type":"verse","number":27,"content":["དེ་ཡང་ཐལ་མཱར་བུ་བཙའ་རན་ལ་སླེབས་པའི་སྐབས༌སུ། ཁོ་མོའི་མངལ་དུ་མཚེ་མ་ཞིག་ཆགས་ཡོད་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":28,"content":["ཁོ་མོས་བུ་བཙའ་བའི་དུས༌སུ། ཕྲུ་གུ་ཞིག་གི་ལག་པ་ཐོག་མར་མངལ་ལས་ཐོན་པ༌དང༌། སྐྱེ་གཡོག་མས་སྐུད་པ་དམར་པོ་ཕྲུ་གུའི་ལག་པར་མདུད༌དེ། འདི་ནི་ཕྲུ་གུ་ཐོག་མ་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":29,"content":["དེ་ནས་ཅུང་མ་འགོར་བར་ཕྲུ་གུའི་ལག་པ་ཕྱིར་མངལ་ནང་དུ་བསྐུམས་པ༌དང༌། ཕྲུ་གུ་གཞན་དེ་ཐོག་མར༌བཙས། དེ་ནས་སྐྱེ་གཡོག་མ་ན༌རེ། ཁྱོད་ཅིའི་ཕྱིར་འཚང་ནས་ཡོང་ངམ་ཞེས་སྨྲས་པའི༌ཕྱིར། ཕྲུ་གུ་དེའི་མིང་ལ་ཕེ་རེལ་ཟི་ཞེས་བཏགས༌སོ།།"]},{"type":"verse","number":30,"content":["དེའི་རྗེས་ནས་ལག་པར་སྐུད་པ་དམར་པོ་མདུད་པའི་ཕྲུ་གུའང་བཙས་པ༌དང༌། ཕྲུ་གུ་དེའི་མིང་ལ་ཟེ་རག་ཅེས་བཏགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/GEN/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/37.json","previousChapterAudioLinks":{},"numberOfVerses":30}