{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":39,"content":[{"type":"heading","content":["དམག་དཔོན་ཕའོ་ཏི་ཕར་གྱི་ཆུང་མས་ཡོ་སེབ་ལ་གནོད་འཚེ་བྱས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡོ་སེབ་ནི་ཨེ་ཅིབ་ཡུལ་དུ་ཁྲིད་པ༌དང༌། ཨེ་ཅིབ་ཀྱི་མི་ཞིག་སྟེ་ཕཱར་ཨོལ་གྱི་ནང་བློན་དང་རྒྱལ་པོའི་སྐུ་སྲུང་དམག་དཔོན་ཕའོ་ཏི་ཕར་གྱིས་ཡེས་མ་ཨེལ་མི་རིགས་ཀྱི་ཚོང་པ་དེ་རྣམས་ལས་ཡོ་སེབ་ཉོས༌སོ།།"]},{"type":"verse","number":2,"content":["དེ་ནས་ཡོ་སེབ་ནི་ཨེ་ཅིབ་ཡུལ་གྱི་རང་གི་བདག་པོ་ཕའོ་ཏི་ཕར་གྱི་ཁྱིམ་དུ་བསྡད༌ཅིང༌། དཀོན་མཆོག་ཡ་ཝཱེ་ཡང་ཁོ་དང་མཉམ་དུ་བཞུགས་པས་ཁོའི་བྱ་བ་ཐམས་ཅད་བདེ་བར༌གྲུབ།"]},{"type":"verse","number":3,"content":["བདག་པོ་ཕའོ་ཏི་ཕར་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོ་དང་མཉམ་དུ་བཞུགས་པ་དང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོའི་བྱ་བ་ཐམས་ཅད་བདེ་བར་འགྲུབ་པར་མཛད་པ་མཐོང༌བས།"]},{"type":"verse","number":4,"content":["ཡོ་སེབ་ལ་བདག་པོ་ཕའོ་ཏི་ཕར་གྱི་མདུན་དུ་ཐུགས་རྗེ་ཐོབ་པ་དང་ཁོས་བདག་པོ་ལ་ཞབས་ཕྱི་བསྒྲུབས་པར་མ༌ཟད། བདག་པོས་ཁོ་རང་ཁྱིམ་ལས་གཉེར་མཁན་དུ་བསྐོས་ཤིང་རྒྱུ་ནོར་ཐམས་ཅད་ཁོ་ལ་བཅོལ་བ༌རེད།"]},{"type":"verse","number":5,"content":["དུས་དེ་ནས༌བཟུང༌། དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་སེབ་ཀྱི་རྐྱེན་ལ་བརྟེན་ནས་ཨེ་ཅིབ་ཀྱི་མི་དེའི་ཁྱིམ་ལ་བྱིན་རླབས་གནང༌སྟེ། བདག་པོའི་ཁྱིམ་ཚང་ཕྱི་ནང་ཐམས་ཅད་ལ་བྱིན་རླབས་ཐོབ༌བོ།།"]},{"type":"verse","number":6,"content":["དེ་ལྟར་བདག་པོས་རྒྱུ་ནོར་ཐམས་ཅད་ཡོ་སེབ་ལ་བཅོལ་བ༌དང༌། རང་གི་བཟའ་བཏུང་ཁོ་ན་མ༌གཏོགས། དོན་གཞན་དག་ལ་སེམས་ཁུར་ཅི་ཡང་མི་བྱེད༌དོ།། དེ་ཡང་ཡོ་སེབ་ནི་སྐྱེས་གཟུགས་ལེགས་ཤིང་ཞལ་རས་མཛེས་པའི་ཕོ་གསར་ཞིག་ཡིན༌ནོ།།"]},{"type":"verse","number":7,"content":["དོན་དེའི་རྗེས༌སུ། བདག་པོའི་ཆུང་མས་ཡོ་སེབ་ལ་ཟུར་མིག་བསྟན༌ཏེ། ཁྱོད་བདག་དང་འགྲོགས་པར་གྱིས་ཞེས༌སྨྲས།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་ཡོ་སེབ་ཀྱིས་དོན་དེ་ཁས་མ་བླངས་པར་ཁོ་མོ་ལ་འདི༌ལྟར། ལྟོས༌དང༌། བདག་པོས་རྒྱུ་ནོར་ཐམས་ཅད་བདག་ལ་བཅོལ་བ༌དང༌། ཁྱིམ་ཚང་ལ་སེམས་ཁུར་ཅི་ཡང་མི༌བྱེད།"]},{"type":"verse","number":9,"content":["ཁྱིམ་འདི་རུ་བདག་ལས་དབང་ཅན་ཞིག༌མེད། བདག་པོས་ཁྱོད་རང་ཁོ་ན་ལས༌གཞན། བདག་ལ་མ་བཅོལ་བ་གཅིག་ཀྱང་མེད༌དེ། ཅིའི་ཕྱིར་ཞེ༌ན། ཁྱོད་ནི་བདག་པོའི་ཆུང་མ་ཡིན་པའི་ཕྱིར༌རོ། །དེའི༌ཕྱིར། བདག་གིས་ལས་ངན་པ་འདི་ལྟ་བུ་བྱེད་རུང༌ངམ། གལ་ཏེ་འདི་ལྟར་བྱས་ན་བདག་གིས་དཀོན་མཆོག་ལ་འགལ་བའི་སྡིག་པ་བྱས་པ་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":10,"content":["ཕྱིས་སུའང་ཁོ་མོས་ནམ་རྒྱུན་ཡོ་སེབ་ལ་དེ་ལྟར་སྨྲས་ཀྱང་ཡོ་སེབ་ཀྱིས་དོན་དེ་ཁས་མི་ལེན་པར་མ༌ཟད། ཁོ་མོ་དང་མཉམ་དུའང་མ་བསྡད༌དོ།།"]},{"type":"verse","number":11,"content":["ཉིན་ཞིག༌ལ། ཡོ་སེབ་ཁྱིམ་ནང་དུ་ཞབས་ཕྱི་བསྒྲུབ་ཏུ་སོང༌ཞིང༌། ཁྱིམ་དུ་ཞབས་ཕྱི་པ་གཞན་སུ་ཡང་མེད༌པས།"]},{"type":"verse","number":12,"content":["བུད་མེད་དེས་ཡོ་སེབ་ཀྱི་ལྭ་བ་ནས་བཟུང༌སྟེ། ཁྱོད་བདག་དང་འགྲོགས་པར་གྱིས་ཞེས་སྨྲས་པ༌ན། ཡོ་སེབ་ཀྱིས་ལྭ་བ་བསྐྱུར་ཏེ་སྒོའི་ཕྱི་རོལ་ཏུ་བྲོས༌སོ།།"]},{"type":"verse","number":13,"content":["དེ་ནས་བུད་མེད་དེས་ཡོ་སེབ་ཀྱིས་ལྭ་བ་བསྐྱུར་ནས་བྲོས་པ་མཐོང་བ༌དང༌།"]},{"type":"verse","number":14,"content":["ཞབས་ཕྱི་པ་གཞན་དག་བོས༌ཏེ། ཁྱོད་ཅག་གིས་ལྟོས༌དང༌། བདག་པོས་ཨིབ་རི་པ་ཞིག་རང་ཁྱིམ་དུ་ཁྲིད་ཡོང་ནས་རང་ཅག་ལ་བརྙས་བཅོས་བྱེད༌དོ། །ཡོ་སེབ་ང་རང་ལ་འགྲོགས་སུ་ཡོང་བ་དང་ངས་སྐད་ཆེན་པོས་ཀི་བཏབ་པ༌ཡིན།"]},{"type":"verse","number":15,"content":["ཁོས་ཀི་སྒྲ་ཐོས་པ་དང་ལྭ་བ་འདི་རུ་བསྐྱུར་ཏེ་སྒོའི་ཕྱི་རོལ་ཏུ་བྲོས་སོང་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་བུད་མེད་དེས་ཡོ་སེབ་ཀྱི་ལྭ་བ་ཁོ་མོའི་གནས་དེར་བཞག་སྟེ་བདག་པོ་ཡོང་བར་སྒུག་པ༌རེད།"]},{"type":"verse","number":17,"content":["བདག་པོ་ཡོང་བ་དང་ཁོ་མོས་འདི༌ལྟར། ཁྱོད་ཀྱིས་རང་ཁྱིམ་དུ་ཁྲིད་ཡོང་བའི་ཨིབ་རི་པ་གཡོག་པོ་དེས་ང་རང་རྩེད་སྤྱད་བྱེད་པར་རྩོམ་པ༌ན།"]},{"type":"verse","number":18,"content":["ངས་སྐད་ཆེན་པོས་ཀི་བཏབ་པ་དང་ཁོས་ལྭ་བ་བསྐྱུར་ནས་བྲོས་སོང་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་ཡང་ཡོ་སེབ་ཀྱི་བདག་པོས་རང་གི་ཆུང་མས་ཁྱོད་ཀྱི་གཡོག་པོས་བདག་ལ་འདི་ལྟར་བྱས་བྱུང་ཞེས་སྨྲས་པའི་གཏམ་ཐོས་པ་དང་ཤིན་ཏུ་ཁྲོས༌ཏེ།"]},{"type":"verse","number":20,"content":["རྒྱལ་པོའི་བཙོན་པ་བཙོན་དུ་འཇུག་སར་ཡོ་སེབ་ཀྱང་བཙོན་ལ་བཅུག་པ༌དང༌། ཡོ་སེབ་དེ་རུ་བཙོན་དུ༌བསྡད།"]},{"type":"verse","number":21,"content":["འོན༌ཀྱང༌། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡོ་སེབ་དང་ལྷན་དུ་བཞུགས་ཤིང་ཁོང་གིས་ཡོ་སེབ་ལ་ཐུགས་རྗེས་གཟིགས༌པས། བཙོན་བདག་གི་མིག་མདུན་ནས་ཀྱང་ཁོ་རང་ལ་ཐུགས་རྗེ་ཐོབ༌བོ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་བཙོན་བདག་གིས་བཙོན་ཁང་ནང་གི་བཙོན་པ་ཐམས་ཅད་ཡོ་སེབ་ལ་བཅོལ༌བས། བཙོན་ཁང་གི་བྱ་བ་གང་ཡིན་ཡང་ཡོ་སེབ་བརྒྱུད་དགོས༌སོ།།"]},{"type":"verse","number":23,"content":["ཡོ་སེབ་ཀྱིས་བསྒྲུབས་པའི་བྱ་བར་བཙོན་བདག་གིས་ཀྱང་བརྟག་དཔྱོད་མི་བྱེད༌དེ། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡོ་སེབ་དང་ལྷན་དུ་བཞུགས༌ཤིང༌། ཁོང་གིས་ཡོ་སེབ་ཀྱི་བྱ་བ་ཐམས་ཅད་བདེ་བར་འགྲུབ་པར་མཛད་པའི་ཕྱིར༌རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/GEN/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/38.json","previousChapterAudioLinks":{},"numberOfVerses":23}