{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"GEN","translationId":"bod_ntb","name":"བཀོད་པ།","commonName":"བཀོད་པ།","title":"༄༅།།འཇིག་རྟེན་ཁམས་བཀོད་པའི༌མདོ།","order":1,"numberOfChapters":50,"sha256":"b596d6091a1bfba8fe155f15f78efbd79bccde0339ecdc092b75aa9d4cda646c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bod_ntb/GEN/50.json","totalNumberOfVerses":1528},"chapter":{"number":40,"content":[{"type":"heading","content":["རྒྱལ་པོའི་ཆང་གཉེར་བློན་ཆེན་དང་གསོལ་དཔོན་བློན་ཆེན་གཉིས་ཀྱི་རྨི༌ལམ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དོན་དེའི་རྗེས་སུ་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོའི་ཆང་གཉེར་བློན་ཆེན་དང་གསོལ་དཔོན་བློན་ཆེན་གཉིས་རང་གི་རྒྱལ་པོ་དང་འགལ༌བས།"]},{"type":"verse","number":2,"content":["ཕཱར་ཨོལ་ཆང་གཉེར་བློན་ཆེན་དང་གསོལ་དཔོན་བློན་ཆེན་གཉིས་ལ་ཐུགས་ཤིན་ཏུ་ཁྲོས༌ཏེ།"]},{"type":"verse","number":3,"content":["ཁོ་གཉིས་རྒྱལ་པོའི་སྐུ་སྲུང་དམག་དཔོན་གྱི་བཙོན་ཁང་དུ༌བཅུག དེ་ནི་ཡོ་སེབ་བཙོན་དུ་བཅུག་པའི་གནས༌དེའོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་སྐུ་སྲུང་དམག་དཔོན་གྱིས་མི་དེ་གཉིས་ཀྱང་ཡོ་སེབ་ལ་བཅོལ་བ༌དང༌། ཡོ་སེབ་ཀྱིས་དེ་གཉིས་ལ་ཞབས་ཕྱི་བསྒྲུབས༌ཤིང༌། ཁོ་རྣམས་དུས་ཡུན་རིང་པོ་ཞིག་ལ་བཙོན་ཁང་ནས་མཉམ་དུ་བསྡད༌དོ།།"]},{"type":"verse","number":5,"content":["དེ་ཡང་བཙོན་དུ་བཅུག་པའི་རྒྱལ་པོའི་ཆང་གཉེར་པ་དང་གསོལ་དཔོན་གཉིས་ཀྱིས་ཞག་གཅིག་ལ་རྨི་ལམ་རེ་རྨིས༌ཤིང༌། རྨི་ལམ་རེ་ལ་ནང་དོན་རེ་ཡོད་པ༌རེད།"]},{"type":"verse","number":6,"content":["ཞོགས་པར་སླེབས༌དུས། ཡོ་སེབ་མི་དེ་གཉིས་ཀྱི་གམ་དུ་སོང་བ་དང་ཁོ་གཉིས་ཡིད་སྐྱོ་བའི་གནས་སུ་ལྷུང་བའི་ཉམས་འགྱུར་མཐོང༌སྟེ།"]},{"type":"verse","number":7,"content":["ཁོས་ཕཱར་ཨོལ་གྱི་བློན་ཆེན་གཉིས་ཏེ་རང་དང་མཉམ་དུ་བདག་པོའི་བཙོན་དུ་བཅུག་ཡོད་པར་འདི༌ལྟར། དེ་རིང་ཁྱོད་གཉིས་ཀྱི་གདོང་ལ་སྐྱོ་བའི་ཉམས་ཤིག་ཤར་ཡོད་པའི་རྒྱུ་མཚན་ཅི་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":8,"content":["ཁོ་གཉིས་ན༌རེ། ངེད་གཉིས་ཀྱིས་རྨི་ལམ་རེ་རྨིས་ནའང་རྨི་ལམ་ལ་བརྟག་མཁན་མེད་ཅེས་ལན་བཏབ་པ༌དང༌། ཡང་ཡོ་སེབ་ན༌རེ། རྨི་ལམ་ལ་བརྟག་མཁན་ནི་དཀོན་མཆོག་མ་ཡིན༌ནམ། ཁྱོད་གཉིས་ཀྱིས་རྨི་ལམ་དེ་བདག་ལ་ཤོད་ཅིག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཆང་གཉེར་པས་རང་གི་རྨི་ལམ་ཡོ་སེབ་ལ་འདི༌ལྟར། བདག་གི་རྨི་ལམ་ནང་དུ་ངའི་མདུན་དུ་རྒུན་འབྲུམ་ཤིང་ཞིག་ཡོད༌ཅིང༌།"]},{"type":"verse","number":10,"content":["རྒུན་ཤིང་དེ་ལ་ཡལ་ག་གསུམ་ཡོད་པ༌དང༌། དེ་དག་ལ་ལོ་མ་འབུས་ནས་མེ་ཏོག་བཞད་པ༌དང༌། རྒུན་ཤིང་དེ་ལ་རྒུན་འབྲུམ་ཡང་སྨིན༌ཡོད།"]},{"type":"verse","number":11,"content":["བདག་གི་ལག་ཏུ་ཕཱར་ཨོལ་གྱི་ཕོར་བ་ཡོད་པ་དང་བདག་གིས་རྒུན་འབྲུམ་ཕོར་བའི་ནང་བཙིར༌རྗེས། ཕོར་བ་དེ་རྒྱལ་པོའི་ཕྱག་ཏུ་ཕུལ་ཞེས་སྨྲས༌པའོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཡོ་སེབ་ན༌རེ། ཁྱོད་ཀྱི་རྨི་ལམ་ལ་བརྟགས་ན་འདི་ལྟ༌སྟེ། ཡལ་ག་གསུམ་ནི་ཉིན་གསུམ་ཡིན༌ལ།"]},{"type":"verse","number":13,"content":["ཉིན་གསུམ་གྱི་ནང༌དུ། ཕཱར་ཨོལ་གྱིས་ཁྱོད་རང་བཙོན་ཁང་ནས་ཕྱིར་གཏོང་བ༌དང༌། ཁྱོད་ལ་དཔོན་ས་སྔར་བཞིན་འཐོབ༌ཅིང༌། ཁྱོད་དེ་སྔར་ཆང་གཉེར་བློན་ཆེན་ཡིན་པ༌བཞིན། མུ་མཐུད་ནས་རྒྱལ་པོའི་ཕྱག་ཏུ་ཕོར་བ་འབུལ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཁྱོད་རང་བདེ་བླག་ཡིན་པའི་དུས་སུ་ང་རང་སེམས་སུ་འཛིན་པ་དང་ཐུགས་རྗེ་གནང་བར༌ཞུ། ཕཱར་ཨོལ་གྱི་དྲུང་དུའང་བདག་གླེང༌ནས། ང་རང་བཙོན་ལས་སྐྱོབ་པར༌ཞུ།"]},{"type":"verse","number":15,"content":["བདག་ནི་དངོས་གནས་ཨིབ་རི་པའི་ཡུལ་ནས་མི་གཞན་གྱིས་བཙན་ཁྲིད་བྱས་ཏེ་འདིར་ཡོང་བ༌དང༌། བདག་གིས་གནས་འདི་རུ་བཙོན་དུ་འཇུག་དགོས་པའི་ལས་ཅི་ཡང་བྱས་མེད་ཅེས་སྨྲས༌པའོ།།"]},{"type":"verse","number":16,"content":["དེ་ཡང་ཡོ་སེབ་ཀྱིས་རྨི་ལམ་ལ་ལེགས་པར་བརྟགས་པ་གསོལ་དཔོན་གྱིས་མཐོང༌སྟེ། ཡོ་སེབ་ལ་འདི༌ལྟར། ངས་རྨི་ལམ་ནང་དུ་བག་ལེབ་སླེ་བོ་གསུམ་མགོ་ལ་ཁུར༌ཞིང༌།"]},{"type":"verse","number":17,"content":["སླེ་བོ་གོང་མའི་ནང་དུ་ཕཱར་ཨོལ་ལ་གཡོས་སྦྱོར་བྱས་པའི་ཟས་རིགས་བསྲེག་མ་སྣ་ཚོགས་ཡོད་པ༌དང༌། བྱ་རྣམས་འཕུར་ཡོང་སྟེ་ཟོས་པ་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཡོ་སེབ་ན༌རེ། ཁྱོད་ཀྱི་རྨི་ལམ་ལ་བརྟགས་ན་འདི་ལྟ༌སྟེ། སླེ་བོ་གསུམ་ནི་ཉིན་གསུམ་ཡིན༌ལ།"]},{"type":"verse","number":19,"content":["ཉིན་གསུམ་གྱི་ནང༌དུ། ཕཱར་ཨོལ་གྱིས་ཁྱོད་ཀྱི་མགོ་བོ་གཅོད་པ༌དང༌། ཁྱོད་ཀྱི་བེམ་པོ་ལྗོན་ཤིང་གི་སྟེང་དུ་འགེལ༌ཞིང༌། བྱ་རྣམས་འཕུར་ཡོང་ནས་ཁྱོད་ཀྱི་བེམ་པོ་ཐོག་གི་ཤ་ཐམས་ཅད་བཟའ་བར་འགྱུར་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":20,"content":["དེ་ནས་ཉིན་གསུམ་པར་སླེབས་པ༌དང༌། ཉིན་དེ་ནི་ཕཱར་ཨོལ་གྱི་འཁྲུངས་སྐར་ཡིན༌པས། ཁོང་གིས་ཞབས་ཕྱི་པ་རྣམས་ལ་གསོལ་སྟོན་གཟབ་རྒྱས་བསྡུས༌ཤིང༌། བཙོན་ཁང་དུ་ཡོད་པའི་ཆང་གཉེར་པ་དང་གསོལ་དཔོན་གཉིས་ཀྱང་ཁྲིད་ཡོང་བ༌དང༌།"]},{"type":"verse","number":21,"content":["ཆང་གཉེར་པ་ནི་སྔར་བཞིན་ཆང་གཉེར་བློན་ཆེན་དུ་བསྐོས་པ༌དང༌། ཁོས་སྔར་བཞིན་ཕཱར་ཨོལ་གྱི་ཕྱག་ཏུ་ཕོར་བ་ཕུལ་ཏོ།།"]},{"type":"verse","number":22,"content":["འོན༌ཀྱང༌། ཡོ་སེབ་ཀྱིས་རྨི་ལམ་ལ་བརྟགས་པ་བཞིན་གསོལ་དཔོན་ནི་སྡོང་པོའི་སྟེང་དུ༌བཀལ།"]},{"type":"verse","number":23,"content":["ཡིན་ནའང་ཆང་གཉེར་བློན་ཆེན་གྱིས་ཡོ་སེབ་སེམས་སུ་མ་བཟུང་ཞིང་གཏན་དུ་བརྗེད་པར་གྱུར༌ཏོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/GEN/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/GEN/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/GEN/39.json","previousChapterAudioLinks":{},"numberOfVerses":23}