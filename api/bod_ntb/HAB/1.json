{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HAB","translationId":"bod_ntb","name":"ཧ་བཱ་ཁུག","commonName":"ཧ་བཱ་ཁུག","title":"༄༅། །ལུང་སྟོན་པ་ཧ་བཱ་ཁུག་གི་མདོ།","order":35,"numberOfChapters":3,"sha256":"5a22410705a911fa5c4ddfa73e180e51c3d692740060e2b4e23c8f19ce596a72","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bod_ntb/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"heading","content":["ལུང་སྟོན་པའི་ཐོག་མའི་དྲི་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ལུང་སྟོན་པ་ཧ་བཱ་ཁུག་གིས་ཞལ་གཟིགས་ལས་མཐོང་བའི་བཀའ་ལུང་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། བདག་གིས་ཞུས་ཀྱང་ཁྱེད་ཀྱིས་མི་གསན་པར་དུས་ཇི་ཙམ་ལ་འདུག་གམ། དོན་གདུག་རྩུབ་ཅན་གྱི་རྐྱེན་གྱིས་ངས་ཁྱེད་ཀྱི་ཕྱོགས་སུ་འོ་དོད་བོས་ནའང་ཁྱེད་ཀྱིས་ད་དུང་སྐྱོབ་པར་མ་མཛད།"]},{"type":"verse","number":3,"content":["ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་ང་ལ་སྡིག་ཉེས་མཐོང་བར་མཛད་དམ། ཁྱེད་ཀྱིས་སྤྱོད་ངན་གཟིགས་ཀྱང་དེར་བཟོད་སྒོམ་བྱེད་པ་ཅི་ཡིན་ནམ། གཏོར་བརླག་དང་གདུག་རྩུབ་ནི་ངའི་མདུན་དུ་ཡོད་པ་དང་། རྩོད་པ་དང་འཐབ་རྩོད་ཀྱང་རྒྱུན་དུ་འབྱུང་ངོ་། །"]},{"type":"verse","number":4,"content":["དེ་བས་བཀའ་ཁྲིམས་མི་བརྩི་ཞིང་། དྲང་བདེན་མི་སྲུང་ལ། མི་ངན་པས་དྲང་བདེན་ཅན་གྱི་མཐའ་ནས་བསྐོར་བས་དྲང་བདེན་གོ་ལྡོག་པ་ཡིན།"]},{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལན།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱིས་མི་རིགས་ཀུན་ལ་ལྟོས་དང་ཤིན་ཏུ་ཧ་ལས་པར་འགྱུར། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱི་མི་ཚེའི་ནང་དུ་ངས་དོན་ཞིག་མཛད་པར་འགྱུར་ཞིང་། གཞན་གྱིས་དོན་དེའི་སྐོར་ཁྱོད་རྣམས་ལ་བཤད་ཀྱང་ཁྱོད་རྣམས་དོན་དེ་ལ་ཡིད་མི་ཆེས་སོ། །"]},{"type":"verse","number":6,"content":["ངས་ཀལ་དི་པ་རྣམས་དར་བར་བཅུག་ནས། གདུག་རྩུབ་ཆེ་ཞིང་བྲེལ་འཚུབ་ཅན་གྱི་མི་སྡེ་དེ་ས་ཕྱོགས་ཀུན་ལ་ཁྱབ་པར་གྱུར་ཏེ། གཞན་གྱི་ཁྱིམ་གཞིས་བཙན་འཛིན་བྱེད་པ་དང་།"]},{"type":"verse","number":7,"content":["དེ་དག་ནི་རྔམ་བརྗིད་ཆེ་ལ་འཇིགས་སུ་རུང་བ་ཡིན་པས་རང་ཉིད་ཚད་མར་འཛིན་པ་དང་། ང་རྒྱལ་ཁེངས་དྲེགས་ཅན་ཡིན་ཞིང་།"]},{"type":"verse","number":8,"content":["དེ་ཚོའི་རྟ་ནི་གཟིག་ལས་མགྱོགས་ཤིང་། མཚན་མོའི་སྤྱང་ཀི་ལས་ཀྱང་གཏུམ་དྲག་ཆེ་ལ། དེ་དག་གི་རྟ་དམག་གདོང་མཆོང་བྱེད་ཀྱིན་རྒྱང་རིང་ནས་ཐོན་པ་དང་། དེ་དག་གིས་གླག་བཞིན་ལྡིང་སྐོར་བརྒྱབ་སྟེ་མྱུར་དུ་ཁྱུར་མིད་གཏོང་བའོ། །"]},{"type":"verse","number":9,"content":["དེ་དག་གིས་མདུན་ཕྱོགས་སུ་གདོང་གཏད་ནས་མཉམ་དུ་གདུག་རྩུབ་སྤྱོད་པ་དང་། བཙོན་པ་བགྲང་ལས་འདས་པ་ཐོབ་པའོ། །"]},{"type":"verse","number":10,"content":["དེ་དག་གིས་རྒྱལ་པོར་ཟུར་ཟ་དང་འགོ་དཔོན་རྣམས་ལ་འཕྱ་དམོད་བྱེད་ཅིང་། བཙན་རྫོང་རྣམས་ལ་ཁྲེལ་དགོད་བྱས་ནས་ས་རགས་བརྩིགས་ཏེ་གནས་དེ་བཙན་འཛིན་བྱེད།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་རང་གི་སྟོབས་ཤུགས་ལྷ་རུ་བཀུར་བ་དང་། རླུང་འཚུབ་བཞིན་གཡུགས་ནས་འགྲོ་ཞིང་སྡིག་ཅན་ཡིན་ནོ། །"]},{"type":"heading","content":["ལུང་སྟོན་པའི་དྲི་བ་གཉིས་པ།"]},{"type":"verse","number":12,"content":["ཀྱེ་ང་ཡི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་བདག་གི་དམ་པ་ཉིད་ལགས། ཁྱེད་ནི་ཐོག་མ་ཉིད་ནས་བཞུགས་པ་མ་ཡིན་ནམ། ངེད་ཅག་ནི་འཆི་བར་མི་འགྱུར་རོ། །ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཁྲིམས་ཆད་གཅོད་དུ་དེ་དག་མངགས་པ་དང་། ཀྱེ་བྲག་རྡོ་ལགས། ཁྱེད་ཀྱིས་ཉེས་ཆད་གཅོད་དུ་དེ་དག་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ཁྱེད་ཀྱི་སྤྱན་ཟུང་ནི་རྣམ་དག་ཡིན་པས་ངན་པར་མི་གཟིགས་ལ། སྤྱོད་ངན་སྣང་མེད་དུ་མི་བསྐྱུར། དེས་ན་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་བའི་མི་མཐོང་ཚེ་དེར་བཟོད་པ་ཅི་ཡིན་ནམ། མི་ངན་གྱིས་རང་ཉིད་ལས་དྲང་བདེན་ཡིན་པའི་མི་མེད་པར་བཟོ་དུས་ཁྱེད་ཉིད་ཞལ་རོག་བཞུགས་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":14,"content":["ཁྱེད་ཀྱིས་མི་ནི་རྒྱ་མཚོའི་ཉ་བཞིན་དང་། བདག་སྐྱོང་བྱེད་མཁན་མེད་པའི་ལྟོ་འགྲོའི་སྲོག་ཆགས་བཞིན་མཛད་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["ཀལ་དི་པས་དེ་ཐམས་ཅད་ལྕགས་ཀྱུས་ཡར་དྲངས་ཏེ། དྲ་རྒྱ་ཡིས་དེ་དག་འཛིན་པ་དང་། ཉ་དྲ་ཡིས་དེ་རྣམས་མཉམ་དུ་བསྡུས་ནས་དགའ་སྤྲོ་ཆེན་པོ་སྐྱེས་པས།"]},{"type":"verse","number":16,"content":["ཀལ་དི་པས་རང་གི་དྲ་རྒྱར་མཆོད་པ་ཕུལ་ནས་ཉ་རྒྱར་སྤོས་བདུགས་སོ། །ཅིའི་ཕྱིར་ཞེ་ན། དེ་ལ་བརྟེན་ནས་ཁོ་ཚོར་ཁ་ཟས་ཕུན་སུམ་ཚོགས་པ་ཐོབ་སྟེ། བཟའ་བཏུང་མོད་པོ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["ཁོ་ཚོས་རང་གི་དྲ་རྒྱ་སྟོང་བར་མཛད་དེ། སྙིང་རྗེ་སྤུ་ཙམ་ཡང་མེད་པར་ཡུལ་ཁམས་གཞན་པའི་མི་སྡེ་རྣམས་གསོད་པ་ཡིན་ནམ།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}