{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HAB","translationId":"bod_ntb","name":"ཧ་བཱ་ཁུག","commonName":"ཧ་བཱ་ཁུག","title":"༄༅། །ལུང་སྟོན་པ་ཧ་བཱ་ཁུག་གི་མདོ།","order":35,"numberOfChapters":3,"sha256":"5a22410705a911fa5c4ddfa73e180e51c3d692740060e2b4e23c8f19ce596a72","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bod_ntb/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལན།"]},{"type":"verse","number":1,"content":["ང་རང་བྱ་རའི་ལྕོག་མཁར་སྟེང་ལངས་ནས་ལྕགས་རིའི་སྟེང་འཛེགས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་ཅི་ཞིག་གསུང་བ་དང་། ངའི་སྡུག་སྐད་ལ་ཅི་ལྟར་ལན་གནང་བར་གཟབ་གཟབ་བྱས་ནས་བལྟ་བར་བྱའོ། །"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བཀའ་ལན་གནང་སྟེ་འདི་སྐད་དུ། ཞལ་གཟིགས་དེ་འཇིམ་པའི་བྱང་བུའི་སྟེང་དུ་ཕྲིས་ཤིག དེ་གསལ་པོར་བཀོད་ན་ཀློག་མཁན་རྣམས་ཀྱིས་ཀློག་བདེ་བར་འགྱུར།"]},{"type":"verse","number":3,"content":["ཞལ་གཟིགས་འདི་ནི་དུས་ངེས་ཅན་ཞིག་དང་འབྲེལ་ཡོད་པ་དང་། དངོས་སུ་འགྲུབ་པར་འགྱུར་བས་དོན་མེད་དུ་མ་ཡིན་ལ། འགོར་འགྱངས་བྱས་པ་འདྲ་ཡང་ད་དུང་སྒུག་དགོས། ཅིའི་ཕྱིར་ཞེ་ན། དོན་དེ་ནི་སླེབ་པར་འགྱུར་ལ་དེའི་ཚེ་འགོར་འགྱངས་མི་བྱེད་དོ། །"]},{"type":"verse","number":4,"content":["ཁོ་ཚོ་ནི་རང་རློམ་ཆེ་ཞིང་གཞུང་རྒྱུད་མི་དྲང་། འོན་ཀྱང་མི་རྣམ་དག་ནི་དད་པའི་སྒོ་ནས་འཚོ་བར་འགྱུར།"]},{"type":"verse","number":5,"content":["རྒྱུ་ནོར་གྱིས་གཡོ་ཟོལ་དང་ང་རྒྱལ་བསྐྱེད་པས་བདེ་བར་གནས་མི་ཐུབ་ལ། གཤིན་ཡུལ་བཞིན་དུ་འདོད་པ་བསྐྱེད་ཅིང་། ཡང་འཆི་བ་ནང་བཞིན་ནམ་ཡང་ཚིམ་པ་མེད་ལ། དེ་དག་གིས་རང་གི་ཕྱིར་དུ་མི་རིགས་ཐམས་ཅད་བསྡུ་ཞིང་མི་སྡེ་ཀུན་རང་ལ་དབང་བར་བྱེད་དོ། །"]},{"type":"verse","number":6,"content":["ཡུལ་ཁམས་དེ་ཐམས་ཅད་ཀྱི་མི་སྡེ་དག་གིས་དཔེ་དང་ཟུར་ཟ། གབ་ཚིག་བཅས་ཀྱིས་དེ་དག་ལ། གང་བྱུང་དུ་མི་གཞན་པའི་རྒྱུ་ནོར་བླངས་ཏེ། བཙན་དབང་གིས་བུ་ལོན་འདེད་མཁན་དག་ལ་ཆག་སྒོ་འབྱུང་བ་ཡིན། ཁོ་ཚོས་ག་དུས་བར་དུ་དེ་བཞིན་བྱེད་ཡོང་ངམ་ཞེས་ཟེར་ཞིང་།"]},{"type":"verse","number":7,"content":["བུ་ལོན་ཅན་རྣམས་གློ་བུར་ཉིད་ལ་ལང་མི་འོང་ངམ། ཁྱོད་འདར་དུ་འཇུག་མཁན་རྣམས་སད་པར་མི་འགྱུར་རམ། དེ་ནས་ཁྱོད་ནི་ཁོ་ཚོའི་བཅོམ་ནོར་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":8,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱིས་ཡུལ་ཁམས་མང་པོ་བཅོམ་ནས་མི་བསད་དེ་ཁྲག་བཞུར་དུ་བཅུག་པ་དང་། ཡུལ་ཁམས་ཀུན་གྱི་གྲོང་ཁྱེར་རྣམས་དང་དེའི་ནང་དུ་སྡོད་པའི་མི་རྣམས་ལ་གདུག་རྩུབ་སྤྱད་པས། ཡུལ་ཁམས་དེའི་ལྷག་ལུས་རྣམས་ཀྱིས་ཁྱོད་རང་འཇོམས་པར་འགྱུར།"]},{"type":"verse","number":9,"content":["རང་གི་ཁྱིམ་གཞིས་ཀྱི་ཕྱིར་དུ་ཐོབ་མི་འོས་པའི་རྒྱུ་ནོར་བསགས་པ་དང་། མཐོ་ས་ནས་སྡོད་ཁང་ཕུབ་སྟེ་ཆག་སྒོ་ལ་གཡོལ་བསམ་པ་ཁྱོད་རྣམས་ལ་ཆག་སྒོ་འབྱུང་།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་ཡུལ་ཁམས་མང་པོའི་མི་སྡེ་ཚར་གཅོད་བྱེད་པའི་ཇུས་ངན་བཤམས་ཤིང་། རང་གི་ཁྱིམ་གཞིས་ངོ་ཚར་སྦྱར་ནས་འབྲས་བུ་ངན་པ་རང་ལ་འཁོར་བ་ཡིན།"]},{"type":"verse","number":11,"content":["ཐ་ན་རྩིག་པའི་རྡོ་ཡིས་སྐད་རྒྱག་ཅིང་། ཁང་པའི་གདུང་མས་ཀྱང་ལན་སྤྲོད་པར་འགྱུར།"]},{"type":"verse","number":12,"content":["མི་ཡི་ཁྲག་གིས་མཁར་བརྩིགས་པ་དང་། གདུག་ལས་ཀྱིས་གྲོང་ཁྱེར་འཛུགས་མཁན་ལ་ཆག་སྒོ་འབྱུང་།"]},{"type":"verse","number":13,"content":["མི་རྣམས་ཀྱིས་ངལ་རྩོལ་བྱས་ནས་ཐོབ་པ་དག་མེས་བསྲེག་པ་དང་། ཡུལ་ཁམས་ཀུན་གྱིས་དཀའ་བ་སྤྱད་དེ་ཐོབ་པ་དག་ནི་སྟོང་བར་འགྱུར་ལ། དོན་འདི་ཐམས་ཅད་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལས་བྱུང་བ་མ་ཡིན་ནམ།"]},{"type":"verse","number":14,"content":["ཆུ་བོ་རྣམས་ཀྱིས་ཇི་ལྟར་རྒྱ་མཚོ་བཀང་བ་བཞིན་དུ། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་རྟོགས་པའི་ཤེས་ཡོན་ནི་ས་གཞི་ཡོངས་སུ་ཁྱབ་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["ཁྱིམ་མཚེས་ལ་ཁོང་ཁྲོ་དང་བཅས་ཆང་གཏོད་མཁན་དང་། དེའི་ལུས་གཅེར་བུ་མཐོང་བའི་ཆེད་དུ་ར་བཟི་བར་འཇུག་མཁན་ལ་ཆག་སྒོ་འབྱུང་།"]},{"type":"verse","number":16,"content":["ཁྱོད་རང་ངོ་ཚས་ཁེངས་པ་ལས་བཀུར་བར་མི་བྱ་སྟེ། ཁྱོད་ཀྱིས་ཀྱང་ཆང་འཐུང་ནས་ལུས་སྨད་མངོན་པར་གྱིས་",{"noteId":0},"ཤིག དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་གཡས་པའི་ཕོར་བ་ནི་འཁོར་ནས་ཁྱོད་ལ་སྤྲོད་ཅིང་། དེའི་ཚེ་ཁྱོད་ཀྱི་གཟི་བརྗིད་ཡོད་ཚད་ངོ་ཚ་ཆེན་པོར་འགྱུར་རོ། །"]},{"type":"verse","number":17,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱིས་ལེ་པཱ་ནོན་གྱི་ཕྱོགས་སུ་གདུག་རྩུབ་སྤྱད་པ་དང་། འཇིགས་སྐྲག་གིས་ཟིན་པའི་རི་དྭགས་རྣམས་བསད་ཅིང་། ཡང་མིའི་སྲོག་བཅད་དེ་ཁྲག་བཞུར་དུ་བཅུག་ནས། ས་གཞི་ཡོངས་ཀྱི་གྲོང་ཁྱེར་རེ་རེའི་ནང་སྡོད་པའི་མི་ཀུན་ལ་གདུག་རྩུབ་སྤྱད་པས་ཁྱོད་ཀྱང་དབང་འོག་ཏུ་བསྡུ་ངེས་ཡིན།"]},{"type":"verse","number":18,"content":["སྐུ་འདྲ་བརྐོས་མ་ལ་ཕན་ཐོགས་ཅི་ཞིག་ཡོད་དམ། དེ་ནི་བཟོ་བས་བརྐོས་པ་ཙམ་ཡིན་ཞིང་། སྐུ་འདྲ་བླུགས་མ་དང་དགེ་རྒན་རྫུས་མ་ལ་ཕན་ཐོགས་ཅི་ཞིག་ཡོད་དམ། བཟོ་བས་རང་ཉིད་ལ་བརྟེན་ནས་ལྷ་ལྐུགས་པ་རྣམས་བཟོས་པའོ། །"]},{"type":"verse","number":19,"content":["ཤིང་གི་གཟུགས་བརྙན་ལ་ཡར་ལོངས་ཞེས་སྨྲ་བ་དང་། རྡོ་ལྐུགས་པ་ལ་སད་པར་གྱུར་ཅིག་ཅེས་སྨྲ་མཁན་ལ་ཆག་སྒོ་འབྱུང་། དེ་ཡིས་ཁྱོད་ལ་ཅི་ལྟར་བཀའ་སློབ་གནང་ངམ། ལྟོས་ཤིག དེའི་ཕྱི་ལ་གསེར་དང་དངུལ་གྱིས་བརྒྱན་ན་ཡང་ནང་དུ་དབུགས་ཀྱི་རྒྱུ་བ་ནི་གཏན་ནས་མེད་དོ། །"]},{"type":"verse","number":20,"content":["ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁོང་གི་མཆོད་ཁང་དམ་པའི་ནང་དུ་བཞུགས་ལ། ས་གཞི་ཡོངས་ཀྱི་མི་རྣམས་ཁོང་གི་དྲུང་དུ་ཁུ་སིམ་མེར་འདུག་འོས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ལུས་སྨད་མངོན་པར་གྱིས་ཞེས་པར་མ་ཕྱི་ལས་མཚན་སྐྱི་བཅད་མེད་པ་མངོན་པར་གྱིས་ཞེས་མཐོང་།","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/bod_ntb/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}