{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HEB","translationId":"bod_ntb","name":"ཨིབ་རི་པ།","commonName":"ཨིབ་རི་པ།","title":"༄༅།།ཨིབ་རི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":58,"numberOfChapters":13,"sha256":"b9b1f605996227851b358125263864b3a9f3fd7ae4ddfecbcd46580e076224a9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":11,"content":[{"type":"heading","content":["དད་པ་ལ་བརྟེན་པའི་སྐོར།"]},{"type":"verse","number":1,"content":["དད་པ་ནི་རེ་བ་བྱེད་པའི་དོན་རྣམས་ཀྱི་བློ་གདེང་དང་མིག་གིས་མི་མཐོང་བའི་དོན་རྣམས་ཀྱི་དཔང་རྟགས་ཡིན༌ལ།"]},{"type":"verse","number":2,"content":["གནའ་བོའི་དད་ལྡན་རྣམས་ལ་དད་པའི་ཆ་ནས་བདེན་དཔང་ལེགས་པོ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":3,"content":["བདག་ཅག་གིས་དད་པར་བརྟེན་ནས་འཇིག་རྟེན་ཁམས་ཐམས་ཅད་ནི་དཀོན་མཆོག་གི་བཀའ་ཡིས་བཀོད་པ་ཤེས༌པས། མིག་གིས་མཐོང་བ་དག་ནི་མིག་གིས་མཐོང་ཐུབ་པའི་དངོས་པོ་དག་ལས་བཟོས་པ་མིན་ནོ།།"]},{"type":"verse","number":4,"content":["ཡང་ཧ་བེལ་གྱིས་དད་པར་བརྟེན་ནས་དཀོན་མཆོག་ལ་མཆོད་པ་ཕུལ༌ཞིང༌། དེ་ནི་ཀཱ་ཡན་གྱིས་ཕུལ་བ་ལས་ཀྱང་ཁྱད་དུ་འཕགས་པས། ཧ་བེལ་མི་རྣམ་དག་ཏུ་གྱུར་པའི་བདེན་དཔང༌བྱུང་ངོ་།། དེ་ནི་དཀོན་མཆོག་གིས་ཁོའི་ཕྱག་རྟེན་ལ་བདེན་དཔང་མཛད་པའོ།། ཁོ་རང་ཚེ་ལས་འདས་ནའང་དད་པའི་དབང་གིས་ཁོས་ད་དུང་གཏམ་སྨྲ༌བའོ།།"]},{"type":"verse","number":5,"content":["ཡང་ཧ་ནོག་གིས་དད་པར་བརྟེན་པའི་རྐྱེན་གྱིས་ཁོ་རང་ཡར་དྲངས་ཤིང་། དེ་ནི་དཀོན་མཆོག་གིས་ཁོ་རང་ཡར་དྲངས་པ་ཡིན་པས། ཁོས་འཆི་བ་ཉམས་སུ་མ་མྱངས་ལ་མི་ཡིས་ཀྱང་ཁོ་རང་བཙལ་ནས་མ་རྙེད་དོ།། ཧ་ནོག་ཡར་མ་དྲངས་པའི་སྔོན་ལ། ཁོ་ལ་དཀོན་མཆོག་ཐུགས་དགྱེས་པའི་བདེན་དཔང་བྱུང་ཟིན༌ཏོ།།"]},{"type":"verse","number":6,"content":["སྤྱིར་མི་ལ་དད་པ་མེད་ན་དཀོན་མཆོག་ཐུགས་དགྱེས་མི་སྲིད༌དོ།། ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་དྲུང་དུ་ཡོང་བའི་མི་རྣམས་ཀྱིས་ངེས་པར་དཀོན་མཆོག་བཞུགས་པར་ཡིད་ཆེས་བྱ་དགོས་ཤིང་། ཁོང་གིས་རང་ཉིད་འཚོལ་བའི་མི་རྣམས་ལ་བྱ་དགའ་གནང་ངེས་པ་ལའང་ཡིད་རྟོན་བྱ་དགོས༌སོ།།"]},{"type":"verse","number":7,"content":["ཡང་ནོ་ཨས་དད་པ་ལ་བརྟེན་ཅིང་དཀོན་མཆོག་གིས་ཁོ་རང་ལ་ད་དུང་མིག་གིས་མ་མཐོང་བའི་དོན་དག་སྐོར་ཉེན་བརྡ་མཛད༌སྐབས། ཁོ་ལ་གུས་ཤིང་འཇིགས་པའི་སེམས་འགུལ་ཐེབས་ནས། ཁོས་རང་གི་ཁྱིམ་མི་ཐམས་ཅད་སྐྱོབ་པའི་ཕྱིར་གྲུ་གཟིངས་བཟོས་པས། དོན་དེ་ལ་བརྟེན་ནས་འཇིག་རྟེན་གྱི་མི་རྣམས་ལ་ནག་ཉེས་བཙུགས་པ་དང་། ཁོ་རང་ནི་དད་པ་ལས་བྱུང་བའི་རྣམ་པར་དག་པའི་རྒྱུད་འཛིན་མཁན་དུ་གྱུར་ཏོ།།"]},{"type":"verse","number":8,"content":["ཡང་ཨབ་ར་ཧམ་གྱིས་དད་པར་བརྟེན་ནས་དཀོན་མཆོག་གི་ཞལ་འབོད་ཐོབ་པའི་དུས་སུ། བཀའ་ལྟར་མ་འོངས་པ་ན་བགོ་སྐལ་འཐོབ་པར་འགྱུར་བའི་ཡུལ་དེར་འགྲོ་བར་བརྩམས། ཁོ་རང་དངོས་སུ་འགྲོ་བའི་དུས་སུ་གང་དུ་འགྲོ་བའང་མ་ཤེས་སོ།།"]},{"type":"verse","number":9,"content":["ཁོས་དད་པར་བརྟེན་ནས་ཁོ་རང་ལ་ཞལ་བཞེས་གནང་བའི་ཡུལ་ལ་སོང་སྟེ་མགྲོན་པོ་ལྟར་གནས་ཤིང་། ཞལ་བཞེས་གཅིག་མཚུངས་ཐོབ་མཁན་ཨི་སཱག་དང་ཡ་ཀོབ་བཞིན་ཡུལ་གཞན་ནས་སྦྲ་གུར་ནང་དུ་བསྡད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོས་རྨང་གཞི་ལྡན་པའི་གྲོང་ཁྱེར་དེ་ལ་རེ་སྒུག་བྱེད་ཅིང་། དེ་ནི་དཀོན་མཆོག་གིས་ཇུས་འགོད་གནང་ཞིང་བཟོ་སྐྲུན་མཛད་པའོ།།"]},{"type":"verse","number":11,"content":["ཡང་དད་པར་བརྟེན་ནས་སཱ་ར་ཁོ་མོའང་ཕྲུ་གུ་ཆགས་པའི་ལོ་ཚོད་ལས་བརྒལ༌ཡང༌། ཁོ་མོས་རང་ཉིད་ལ་ཞལ་བཞེས་གནང་མཁན་ནི་ཡིད་རྟོན་རུང་བར་སྙམ་པས། ཁོ་མོར་མངལ་ཆགས་ནུས་པའོ།།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར། ཚེ་ལས་འདས་ཟིན་པ་ལྟ་བུའི་མི་ཞིག་ལས་བུ་རྒྱུད་མཆེད་པ༌ནི། ནམ་མཁའི་སྐར་ཚོགས་བཞིན་མང་ཞིང་། མཚོ་འགྲམ་གྱི་བྱེ་མ་བཞིན་དུ་བགྲང་ལས་འདས་སོ།།"]},{"type":"verse","number":13,"content":["མི་དེ་ཐམས་ཅད་དད་སེམས་བཅངས་ནས་ཚེ་ལས་འདས་ཤིང་ཞལ་བཞེས་རྣམས་ཀྱང་མ་ཐོབ་མོད། འོན་ཀྱང་རྒྱང་རིང་ནས་ཞལ་བཞེས་མཐོང་ཞིང་དགའ་སྤྲོའི་ངང་བསུ་བ་བྱས་པ༌དང༌། རང་ཉིད་ནི་འཇིག་རྟེན་གྱི་མགྲོན་པོ་ཡིན་པ་དང་འཇིག་རྟེན་དུ་བྱེས་སུ་ཡོང་བའང་ཁས་བླངས་པའོ།།"]},{"type":"verse","number":14,"content":["གཏམ་འདི་ལྟར་སྨྲ་མཁན་རྣམས་ཀྱིས་རང་ཉིད་ལ་ཡུལ་ཞིག་འཚོལ་བཞིན་ཡོད་པ་བསྟན༌པ་ཡིན།"]},{"type":"verse","number":15,"content":["ཁོ་རྣམས་ཀྱིས་ཁ་བྲལ་ཟིན་པའི་ཡུལ་དེ་དྲན་པ་ཡིན་ན། ཁོ་རྣམས་ལ་སྔ་མོ་ནས་ཕྱིར་ཡུལ་དུ་འགྲོ་བའི་གོ་སྐབས་ལྡན་ནོ།།"]},{"type":"verse","number":16,"content":["དོན་དམ་དུ་ཁོ་རྣམས་ཀྱིས་དེ་ལས་ཀྱང་ཁྱད་དུ་འཕགས་པའི་ཡུལ་ཏེ། ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་ཡུལ་དེ་ལ་རེ་སྨོན་བཅངས་པ་ཡིན། དེའི་ཕྱིར། དཀོན་མཆོག་ནི་ཁོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཏུ་འབོད་ཀྱང་། ཁོང་ཉིད་དེ་ལ་ངོ་མི་གནོང་ཞིང་། དཀོན་མཆོག་གིས་ཁོ་རྣམས་ལ་གྲོང་ཁྱེར་ཞིག་སྟ་གོན་མཛད་ཡོད་པས་སོ།།"]},{"type":"verse","number":17,"content":["ཡང་ཨབ་ར་ཧམ་གྱིས་དད་པར་བརྟེན་ཅིང་ཁོ་རང་ཉིད་ལ་བརྟག་པའི་དུས་སུ། ཨི་སཱག་མཆོད་པར་འབུལ་བར་རྩོམ་ཞིང་། རང་ཉིད་ཀྱི་བུ་གཅིག་པུའང་མཆོད་པར་འབུལ་བའི་མི་ཁོ་རང་ནི་ཞལ་བཞེས་ཐོབ་མཁན་དེ་ཡིན་ནོ།།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་གིས་དེ་སྔར་ཁོ་ལ་འདི་སྐད༌དུ། ཨི་སཱག་བརྒྱུད་ནས་ཁྱོད་ཀྱི་རིགས་རྒྱུད་ཀྱི་མིང་ཐོན་པར་འགྱུར་ཞེས་གསུངས་པ་ཡིན།"]},{"type":"verse","number":19,"content":["ཁོས་ནི་དཀོན་མཆོག་གིས་མི་འཆི་བ་ལས་སླར་གསོན་པར་མཛད་ནུས་པར་སྙམ༌ཞིང༌། ཡང་དེ་ནི་ཁོ་ལ་རང་གི་བུ་འཆི་བ་ལས་ཕྱིར་ཐོབ་པའི་དཔེ་གཞི་ཡིན་ནོ༎"]},{"type":"verse","number":20,"content":["ཡང་ཨི་སཱག་གིས་དད་པར་བརྟེན་ནས་ཡ་ཀོབ་དང་ཨེ་སཱབ་གཉིས་ལ་མ་འོངས་པའི་དོན་རྣམས་བསྟན་ཏེ་བྱིན་རླབས་གནང༌ངོ༌།།"]},{"type":"verse","number":21,"content":["ཡང་ཡ་ཀོབ་ཀྱིས་དད་པར་བརྟེན་ནས་རང་ཉིད་ཚེ་ལས་འདའ་ཁར། ཡོ་སེབ་ཀྱི་བུ་རེ་རེ་ལ་བྱིན་རླབས་གནང༌ཞིང༌། འཁར་བ་ལ་བརྟེན་ནས་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད༌དོ།།"]},{"type":"verse","number":22,"content":["ཡང་ཡོ་སེབ་ཀྱིས་དད་པར་བརྟེན་ནས་རང་ཉིད་ཚེ་ལས་འདའ་ཁར། ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཕྱིས་སུ་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཐོན་ངེས་པའི་སྐོར་སྨྲས་ཤིང་། རང་གི་ཀེང་རུས་ཀྱི་ཕྱིར་ཁ་ཆེམས་བཞག་གོ།"]},{"type":"verse","number":23,"content":["ཡང་དད་པར་བརྟེན་ནས། མོ་ཤེ་སྐྱེས་པ་དང་ཁོའི་ཕ་མ་གཉིས་ཀྱིས་ཕྲུ་གུ་མཛེས་ཤིང་སྡུག་པ་ཞིག་ཡིན་པ་མཐོང༌སྟེ། རྒྱལ་པོའི་བཀའ་ལའང་མ་འཇིགས་པར་ཕྲུ་གུ་དེ་ཟླ་བ་གསུམ་གྱི་རིང་ལ་སྦས༌པའོ།།"]},{"type":"verse","number":24,"content":["ཡང་མོ་ཤེ་ཡིས་དད་པར་བརྟེན་ནས་ཁོ་རང་ནར་སོན་རྗེས། ཕཱར་ཨོལ་གྱི་སྲས་མོའི་བུ་ཞེས་འབོད་པ་ཁས་མ་བླངས་སོ།།"]},{"type":"verse","number":25,"content":["ཁོ་རང་ནི་དཀོན་མཆོག་གི་འབངས་མི་དང་ལྷན་དུ་གནོད་འཚེ་མྱང་བར༌དགའ་བ་ལས། གནས་སྐབས་ཙམ་ལའང་སྡིག་པའི་ནང་གི་བདེ་སྐྱིད་ལ་རོལ་མི་འདོད།"]},{"type":"verse","number":26,"content":["ཁོས་དཀོན་མཆོག་གི་བྱ་དགའ་ལ་རེ་སྒུག་བྱེད་པས། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་དོན་དུ་ཐེབས་པའི་བརྙས་བཅོས་ནི་ཨེ་ཅིབ་ཡུལ་གྱི་རྒྱུ་ནོར་ལས་ཀྱང་རིན་པོ་ཆེ་རུ་བརྩིས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["ཁོས་དད་པར་བརྟེན་ནས་རྒྱལ་པོའི་ཁྲོ་བ་ལ་མ་འཇིགས་པར་ཨེ་ཅིབ་ཡུལ་དང་ཁ་བྲལ་ཏོ།། དེ་ནི་མིག་གིས་མཐོང་མི་ནུས་པའི་དཀོན་མཆོག་མཐོང་བ་བཞིན་བློ་སེམས་བརྟན་པོས་བཟོད་བསྲན་བྱས་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":28,"content":["ཡང་ཁོས་དད་པར་བརྟེན་ནས་པེ་སག་གི་དུས་ཆེན་དང་ཁྲག་གཏོར་བའི་དོན་དེ་བསྲུངས་པ་ཡིན། དེ་ནི་བུ་སྐྱེས་འགོ་རྣམས་གསོད་མཁན་གྱིས་ཡེས་ར་ཨེལ་མི་རིགས་ལ་གནོད་འཚེ་མི་བྱེད་པའི་ཕྱིར་ཡིན་ནོ།།"]},{"type":"verse","number":29,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱིས་དད་པར་བརྟེན་ནས་མཚོ་དམར་པོ་སྐམ་ས་བཞིན་དུ་བརྒལ་ནས་སོང་བ་ལ། ཨེ་ཅིབ་པ་རྣམས་ཀྱང་དེ་ལྟར་བརྒལ་བར་བརྩམས་པ་ན་ཆུར་ནུབ་བོ།།"]},{"type":"verse","number":30,"content":["ཡང་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ཀྱིས་དད་པར་བརྟེན་ནས་ཉིན་བདུན་ལ་ཡེ་རུ་ཀོ་ལ་སྐོར་བ་བརྒྱབ་པ་དང་མཁར་གྱང་ལོག་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":31,"content":["ཡང་སྨད་འཚོང་མ་རཱ་ཧབ་ཀྱིས་དད་པར་བརྟེན་ནས་ཞི་འཇམ་ངང་མྱུལ་མ་རྣམས་ནང་དུ་བསུས༌པས། ཁོ་མོ་ནི་དཀོན་མཆོག་གི་བཀའ་ལ་མི་ཉན་པ་རྣམས་དང་མཉམ་དུ་འཆི་བར་མ་གྱུར༌ཏོ།།"]},{"type":"verse","number":32,"content":["བདག་གིས་ད་དུང་བརྗོད་དགོས་དོན་ཅི་ཡོད༌དམ། གལ་ཏེ། བདག་གིས་རེ་རེ་བཞིན་ཞིབ་ཏུ་བཤད༌ན། གིད་ཡོན་དང་། པཱ༌རག སཱམ༌སོན། ཡེབ༌ཐཱ། དཱ༌བིད། སཱ་མུ༌ཨེལ་དང་བཅས་པའི་ལུང་སྟོན་པ་དག་གི་དོན་རྣམས་བརྗོད་ཁོམ་མེད་དོ།།"]},{"type":"verse","number":33,"content":["ཁོ་རྣམས་ཀྱིས་དད་པར་བརྟེན་ནས་རྒྱལ་ཁམས་གཞན་དག་བཏུལ་ཞིང་། དྲང་བདེན་གཉེར་བ༌དང༌། ཞལ་བཞེས་ཐོབ༌པ། སེངྒེ་དག་གི་མཆུ་ཏོ་བསྡམས༌པ།"]},{"type":"verse","number":34,"content":["མེ་དཔུང་གི་ངར་ཤུགས་བཅོམས་པ། རལ་གྲིའི་ཁ་ལས་ཐར༌བ། ཉམ་ཆུང་ལས་སྟོབས་ཅན་དུ་བསྒྱུར༌བ། གཡུལ་ངོར་དཔའ་རྩལ་ངོམ་པ། ཕས་རྒོལ་གྱི་དམག་དཔུང་ཕྱིར་བཟློག༌པའོ།།"]},{"type":"verse","number":35,"content":["བུད་མེད་དག་གི་འདས་པོ་རྣམས་སླར་གསོན་ནས་ཁོ་མོ་དག་ལ་ཕྱིར་ཐོབ༌པ། ལ་ལས་མནར་གཅོད་དྲག་པོ་མྱངས་ནའང་། ཁྱད་དུ་འཕགས་པའི་སླར་གསོན་དེ་ཉིད་འཐོབ་པའི༌ཕྱིར། གནས་སྐབས་ཙམ་གྱི་ཐར་པ་དང་དུ་མ་བླངས་སོ།།"]},{"type":"verse","number":36,"content":["ཡང་དད་ལྡན་ལ་ལས་འཕྱ་དམོད་དང་རྡུང༌རྡེག ལྕགས༌སྒྲོག་དང་བཙོན་འཇུག་བཅས་ཀྱི་སྡུག་བསྔལ་སྣ་ཚོགས་ཀྱང་མྱངས༌ཤིང་།"]},{"type":"verse","number":37,"content":["ལ་ལ་རྡོ་རུབ་བཏང་བ་དང་། ལ་ལ་སོག་ལེ་ཡིས་དུམ་བུར་བཅད། ལ་ལ་ཉམས་ཚོད་དང༌ཕྲད། ལ་ལ་རལ་གྲིས༌བསད། ལ་ལས་ལུག་ལྤགས་དང་ར་ལྤགས་གྱོན་ནས་ས་མཐར་འཁྱམས། ལ་ལ་དབུལ་ཕོངས་དང་། དཀའ༌ཚེགས། མནར་གཅོད་བཅས་ཀྱི་གནས་སུ༌ལྷུང༌།"]},{"type":"verse","number":38,"content":["ལ་ལ་དབེན་སྟོང་དང་། རི༌ལུང་། བྲག༌ཁུང་། ས་དོང་བཅས་གནས་ངེས་མེད་དུ་རྒྱུའོ།། འཇིག་རྟེན་འདི་ནི་ཁོ་རྣམས་ཡོད་པར་མི་འོས་སོ།།"]},{"type":"verse","number":39,"content":["མི་དེ་དག་ཐམས་ཅད་ལ་དད་པ་བརྒྱུད་ནས་བདེན་དཔང་ལེགས་པོ་ཐོབ་ནའང༌ཞལ་བཞེས་མ་ཐོབ་བོ།།"]},{"type":"verse","number":40,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་བདག་ཅག་ལ་དེ་ལས་འཕགས་པ་ཞིག་སྟ་གོན་མཛད་ཡོད་དེ། ཁོ་རྣམས་ལ་བདག་ཅག་དང་མཉམ་དུ་ཐོབ་པར་མ་མཛད་ན། དེ་རྣམས་ཡོངས་སུ་རྫོགས་པར་མི་འགྱུར༌བའི་ཕྱིར་རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/HEB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HEB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HEB/10.json","previousChapterAudioLinks":{},"numberOfVerses":40}