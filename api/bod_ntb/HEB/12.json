{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HEB","translationId":"bod_ntb","name":"ཨིབ་རི་པ།","commonName":"ཨིབ་རི་པ།","title":"༄༅།།ཨིབ་རི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":58,"numberOfChapters":13,"sha256":"b9b1f605996227851b358125263864b3a9f3fd7ae4ddfecbcd46580e076224a9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":12,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་རང་ཉིད་ཀྱི་བུ་ཕྲུག་ལ་བསླབ་བྱ་གནང་བའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེ་བས་ན་བདག་ཅག་ལ་སྤྲིན་ཕུང་གིས་མཐའ་ནས་བསྐོར་བ་ལྟ་བུའི་དཔང་པོ་འདི་འདྲ་མང་པོ་ཡོད་པས། ཁུར་པོ་ལྕི་མོ་སྣ་ཚོགས་བསྐྱུར་བ་དང་། འཁྲིལ་སླ་བའི་སྡིག་པ་རྣམས་སྤངས༌ཏེ། བཟོད་སེམས་བཅངས་ནས་མདུན་དུ་བཤམས་པའི་འགྲན་རྒྱུག་དེར་རྒྱུག་དགོས༌པ་དང་།"]},{"type":"verse","number":2,"content":["བདག་ཅག་གི་དད་པའི་འགོ་རྩོམ་མཁན་དང་དེ་ཉིད་ཡོངས་སུ་རྫོགས་པར་མཛད་མཁན་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་མགོ་བོ་ཡར་བཏེགས་ནས་བལྟ་དགོས༌སོ།། ཁོང་གིས་རང་ཉིད་ཀྱི་མདུན་དུ་བཤམས་པའི་དགའ་སྤྲོའི་ཕྱིར། ངོ་ཚ་སྣང་མེད་དུ་བསྐྱུར་བ་དང་ཤིང་རྒྱ་གྲམ་གྱི་དཀའ་སྡུག་ལ་བཟོད་བསྲན་མཛད་དེ། ཁོང་ཉིད་དཀོན་མཆོག་གི་བཞུགས་ཁྲིའི་གཡས་ཕྱོགས་སུ་བཞུགས༌པ་ཡིན།"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ལུས་ཐང་མི་ཆད་པ་དང་ཡིད་སེམས་མི་ཕམ་པའི་ཕྱིར། ཁོང་གིས་སྡིག་ཅན་རྣམས་ཀྱི་འགོག་རྒོལ་ལ་ཅི་ལྟར་བཟོད་བསྲན་བྱས་པར་ཁྱོད་ཅག་གིས་མནོ་བསམ་གཏོང་བར་བྱའོ།།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་སྡིག་པ་དང་འཐབ་ནའང་། ཁྲག་བཞུར་བའི་བར་དུ་འགོག་དགོས་པའི་ཚད་ལ་ད་དུང་མ་སླེབས་སོ།།"]},{"type":"verse","number":5,"content":["དེ་ལ་ཇི་སྐད༌དུ།",{"text":"བདག་གི་བུ་ཁྱོད་གཙོ་བོས་གཅུན་པ་ལ།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱིས་མཐོང་ཆུང་སྣང་མེད་མ་བྱེད་ཅིག །","poem":1},{"lineBreak":true},{"text":"བཀའ་བཀྱོན་མཛད་དུས་ཡིད་སེམས་ཕམ་མི་བྱ།།","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"གཙོ་བོས་གཅེས་པ་རྣམས་ལ་གཅུན་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"བུ་རུ་བརྩིས་པ་རེ་རེར་རྡེག་ཕྱིར་རོ།།","poem":1},"ཞེས་བུ་ལ་བསླབ་བྱ་གནང་བ་བཞིན། ཁྱོད་རྣམས་ལ་བསླབ་བྱ་གནང་བ་ཡང་ཁྱོད་ཅག་གིས་བརྗེད་ཟིན༌ཏོ།།"]},{"type":"verse","number":7,"content":["ཁྱོད་རྣམས་ཀྱིས་བཟོད་བསྲན་བྱེད་པ་ནི་གཅུན་པའི་ཕྱིར་ཡིན་ལ། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་རང་གི་བུ་བཞིན་དུ་གཅུན་པར་མཛད་པའོ།། ཕ་ཡིས་བུ་ལ་མི་གཅུན་པ་ཞིག་ག་ན་ཡོད་ཨང་།"]},{"type":"verse","number":8,"content":["མ་གཞི་བུ་ཕྲུག་ཐམས་ཅད་ལ་གཅུན་མཁན་ཡོད། གལ་ཏེ། ཁྱོད་རྣམས་ལ་གཅུན་མཁན་མེད༌ན། ཁྱོད་ཅག་ནི་བྱི་ཕྲུག་ཡིན་པ་ལས་བུ་ཕྲུག་དངོས་མིན་ནོ།།"]},{"type":"verse","number":9,"content":["གཞན་ཡང་། བདག་ཅག་ལ་གཅུན་མཁན་ལུས་སྦྱིན་གྱི་ཕ་ཡོད་ལ། བདག་ཅག་གིས་ཁོང་ལ་བརྩི་བཀུར་བྱེད༌པ་ཡིན་པས། སེམས་ཉིད་ཀྱི་ཡབ་ནི་ལྟ་ཅི་སྨོས། བདག་ཅག་གིས་ཁོང་གི་བཀའ་ལ་མཉན་ཏེ་འཚོ་བར་མི་འོས༌སམ།"]},{"type":"verse","number":10,"content":["ལུས་སྦྱིན་གྱི་ཕ་རྣམས་ཀྱིས་རང་རང་གི་འདོད་བློ་ལྟར་གནས་སྐབས་སུ་བདག་ཅག་ལ་གཅུན་པ་ཡིན༌མོད། འོན་ཀྱང་སེམས་ཉིད་ཐམས་ཅད་ཀྱི་ཡབ་ལགས་ཀྱིས་བདག་ཅག་ལ་ཕན་འདོགས་པ་དང་། ཁོང་གི་དམ་པའི་རང་བཞིན་ལས་བདག་ཅག་ལ་སྐལ་བ་ལྡན་པའི་ཕྱིར་གཅུན་པར་མཛད་པའོ།།"]},{"type":"verse","number":11,"content":["སྤྱིར་གཅུན་པའི་དོན་ཐམས་ཅད་ནི་སྐབས་དེར་སྡུག་བསྔལ་དུ་འདོད་པ་ལས་དགའ་སྤྲོའི་ཚོར་བ་མེད་མོད། འོན་ཀྱང་གཅུན་པའི་སྦྱོང་བ་ཐོབ་པ་རྣམས་ལ་ཕྱིས་སུ་ཞི་བདེའི་འབྲས་བུ་སྨིན་ཞིང་དེ་ནི་དྲང་བདེན་ཡིན་ནོ།།"]},{"type":"verse","number":12,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་ལག་པ་ལྷོད་ཅིང་པུས་མོའི་ཤེད་ཉམས་པ་དག་ནི་སྟོབས་དང་ལྡན་པར་གྱིས།"]},{"type":"verse","number":13,"content":["ཡང་རང་རང་གི་རྐང་པའི་དོན་དུ་ལམ་དྲང་པོར་བཟོས༌ཤིག དེ་ལྟར་བྱས་ན། རྐང་ལག་ཞ་བར་གྱུར་པ་གང་ཡིན་པ་ཚིགས་མི་བུད་པར་སོས་པར་འགྱུར༌རོ།།"]},{"type":"heading","content":["དཀོན་མཆོག་འདོར་མི་རུང་བའི་ཉེན་བརྡ།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་མི་ཐམས་ཅད་ལ་མཐུན་པོ་ཡོང་བ་དང་རང་ཉིད་དམ་པར་འགྱུར་བར་བསྙེག་དགོས༌ཏེ། དམ་པ་མིན་ན་གཙོ་བོ་ལ་མཇལ་ཐུབ་མཁན་གཅིག་ཀྱང་མེད༌དོ།།"]},{"type":"verse","number":15,"content":["ཡང་དཀོན་མཆོག་གི་ཐུགས་རྗེ་དང་མི་འབྲལ་བ་དང་། འཁོན་སེམས་དུག་གི་རྩ་བ་རྒྱས་ཏེ་ཁྱོད་རྣམས་དཀྲུགས་པ་བརྒྱུད་ནས་མི་མང་པོ་བཙོག་པར་མི་བྱེད་པའི་ཕྱིར་གཟབ་གཟབ་གྱིས་ཤིག"]},{"type":"verse","number":16,"content":["ལོག་གཡེམ་བྱེད་མཁན་དང་དད་གུས་མེད་པ་ཨེ་སཱབ་ལྟ་བུ་འབྱུང་བར་གཟབ་གཟབ་བྱེད་དགོས༌ཏེ། ཨེ་སཱབ་ཀྱིས་ཟས་ཐུན་གཅིག་གི་ཆེད་དུ་རང་ཉིད་ཀྱི་བུ་ཆེ་བའི་ཐོབ་ཐང་ཡང་བཙོངས་པ་ཡིན།"]},{"type":"verse","number":17,"content":["ཕྱིས་སུ་ཁོ་ལ་ཕ་ཡི་བྱིན་རླབས་འཐོབ་འདོད་ཀྱང་ཁོ་ནི་འདོར་བར་གྱུར་པ་དང་། མིག་ལས་མཆི་མ་བཞུར་གྱིན་ཞུ་བ་ཞུས་ཀྱང་ཕ་ཡི་བློ་ཁ་བསྒྱུར་བའི་ཐབས་མ་རྙེད་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས༌སོ།།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཅག་ནི་རེག་ཐུབ་པའི་རི་བོ་དེར་ཡོང་བ་མ་ཡིན༌ཏེ། རི་བོ་དེར་མེ་དཔུང་དང་། སྤྲིན་ནག མུན་ནག དྲག་རླུང་།"]},{"type":"verse","number":19,"content":["དུང་སྒྲ་དང་བཀའ་གསུང་བའི་སྒྲ་བཅས་ཡོད་པ་ཡིན་ལ། གསུང་སྐད་དེ་ཐོས་པ་རྣམས་ཀྱིས་ཁོ་རྣམས་ལ་གསུང་སྐད་ཅི་ཡང་མི་གནང་བར་ཞུ་བ་ཞུས་སོ།།"]},{"type":"verse","number":20,"content":["ཅིའི་ཕྱིར་ཞེ་ན། འདི་སྐད༌དུ། རི་བོ་དེའི་འདབས་ལ་རེག་མཁན་ནི་རི་དྭགས་ཡིན་ཡང་། རྡོ་རུབ་བཏང་ནས་གསོད་པར་བྱ་ཞེས་གསུངས་པའི་བཀའ་ནི་ཁོ་རྣམས་ཀྱིས་མ་བཟོད་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":21,"content":["མིག་གིས་མཐོང་བ་དེ་ནི་འཇིགས་སུ་རུང་བ་ཞིག་ཡིན་པས། དེ་ལ་མོ་ཤེ་ཡིས་འདི་སྐད་དུ། བདག་ནི་ཤིན་ཏུ་འཇིགས་ཤིང་སྐྲག་སྟེ་འདར་བར་གྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་། ཁྱོད་ཅག་ནི་རི་བོ་ཛ་ཡན་དང་རྟག་ཏུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་གི་གྲོང་ཁྱེར་ཏེ། ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོང་ངོ་།། གནས་དེ་རུ་ཕོ་ཉ་ཁྲི་ཕྲག་དུ་མ་ཡོད་ལ།"]},{"type":"verse","number":23,"content":["ནམ་མཁའི་ཞིང་ཁམས་སུ་མིང་ཐོ་བཀོད་ཡོད་པའི་བུ་སྐྱེས་འགོ་རྣམས་འདུས་པའི་ཆོས་ཚོགས་དང་། མི་ཐམས་ཅད་ལ་ཁྲིམས་ཐག་མཛད་མཁན་དཀོན་མཆོག་དང་། ཡོངས་སུ་རྫོགས་པར་མཛད་པའི་རྣམ་པར་དག་པ་རྣམས་ཀྱི་རྣམ་ཤེས་ཡོད་པར་མ༌ཟད།"]},{"type":"verse","number":24,"content":["ཞལ་ཆད་གསར་པའི་བར་མི་སྟེ་སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཁོང་གིས་གཏོར་བའི་སྐུ་ཁྲག་ཀྱང་ཡོད༌ལ། སྐུ་ཁྲག་དེས་ཧ་བེལ་གྱི་ཁྲག་ལས་ཀྱང་ཡིད་དུ་འོང་བའི་བཀའ་གསུངས་སོ།།"]},{"type":"verse","number":25,"content":["ཁྱོད་རྣམས་ཀྱིས་རྟག་ཏུ་གཟབ་གཟབ་བྱ་དགོས་ཏེ། ཁྱོད་རྣམས་ལ་བཀའ་གསུང་མཁན་དེ་ཉིད་འདོར་མི༌རུང་ངོ་།། འཇིག་རྟེན་དུ་མི་རྣམས་ལ་ཉེན་བརྡ་གཏོང་མཁན་དེ་ཉིད་དོར་བ་ཁོ་རྣམས་ཐར་མི་ནུས་ན། ནམ་མཁའི་ཞིང་ཁམས་ནས་བདག་ཅག་ལ་ཉེན་བརྡ་གཏོང་མཁན་དེ་ཉིད་དང་འགལ་བ་ཡིན་ན་སྨྲ་ཅི་དགོས།"]},{"type":"verse","number":26,"content":["དུས་དེར་ཁོང་གི་གསུང་སྐད་ཀྱིས་ས་གཞི་གཡོས་མོད། འོན་ཀྱང་ད་ལྟ་ཁོང་གིས་འདི་སྐད༌དུ་ཞལ་བཞེས་གནང་བ་སྟེ། ད་དུང་ཐེངས་གཅིག་ལ་བདག་གིས་ས་གཞི་གཡོ་ཞིང་ནམ་མཁའ་ཡང་གཡོ་བར་བྱའོ་ཞེས་གསུངས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["ད་དུང་ཐེངས་གཅིག་ལ་ཞེས་པའི་གསུང་འདིས་གཡོ་མི་ནུས་པ་རྣམས་རྟག་ཏུ་གནས་པའི༌ཕྱིར། གཡོ་བར་འགྱུར་བའི་དངོས་པོ་བསྐྲུན་པ་དེ་དག་འདོར་བར་འགྱུར་བ་གསལ་པོར་བསྟན༌ཏོ།།"]},{"type":"verse","number":28,"content":["དེའི༌ཕྱིར། བདག་ཅག་ལ་གཡོ་མི་ནུས་པའི་རྒྱལ་སྲིད་ཐོབ་པ་ཡིན་པས། བདག་ཅག་ནི་དྲིན་གཟོ་བའི་སེམས་དང་ལྡན་འོས་ཤིང༌། དཀོན་མཆོག་ཐུགས་དགྱེས་པ་བཞིན་དུ། དད་གུས་དང་འཚེར་སྣང་བཅས་ཁོང་ལ་ཞབས་ཏོག་བསྒྲུབ་འོས་སོ།།"]},{"type":"verse","number":29,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་ཅག་གི་དཀོན་མཆོག་ནི་ཡོངས་རྫོགས་རྩ་མེད་གཏོང་བའི་མེ་ཡིན་པའི་ཕྱིར་རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/HEB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HEB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HEB/11.json","previousChapterAudioLinks":{},"numberOfVerses":29}