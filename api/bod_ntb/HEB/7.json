{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HEB","translationId":"bod_ntb","name":"ཨིབ་རི་པ།","commonName":"ཨིབ་རི་པ།","title":"༄༅།།ཨིབ་རི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":58,"numberOfChapters":13,"sha256":"b9b1f605996227851b358125263864b3a9f3fd7ae4ddfecbcd46580e076224a9","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":7,"content":[{"type":"heading","content":["མཆོད་དཔོན་མལ་ཀི་ཚེ༌དེག་གི་སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་མཱལ་ཀི་ཚེ་དེག་ནི་སཱ་ལེམ་གྱི་རྒྱལ་པོ་ཡིན་ལ། བླ་ན་མེད་པའི་དཀོན་མཆོག་གི་མཆོད་དཔོན་ཡང་ཡིན། ཨབ་ར་ཧམ་ནི་རྒྱལ་པོ་གཞན་དག་ལས་རྣམ་པར་རྒྱལ་ཏེ་ཕྱིར་ལོག༌སྐབས། ཁོང་གིས་ཨབ་ར་ཧམ་ལ་བསུ་བ་བྱས་ཤིང་བྱིན་གྱིས་བརླབས་སོ།།"]},{"type":"verse","number":2,"content":["ཨབ་ར་ཧམ་གྱིས་ཀྱང་རང་ཉིད་ལ་ཐོབ་པ་ཐམས་ཅད་ལས་བཅུ་ཆའི་གཅིག་བླངས་ནས་ཁོང་ལ་ཕུལ་ཏོ།། ཁོང་གི་མཚན་དང་པོའི་དོན་ནི་དྲང་བདེན་གྱི་རྒྱལ་པོ་ཞེས་པ་དང༌། ཡང་སཱ་ལེམ་གྱི་རྒྱལ་པོ་ཞེས་ཀྱང་ཟེར་ཏེ་ཞི་བདེའི་རྒྱལ་པོ་ཞེས་པའི་དོན་ཡིན།"]},{"type":"verse","number":3,"content":["ཁོང་ལ་ཕ་ནི་མེད་ལ་མ་ཡང་མེད་ཅིང་རིགས་རྒྱུད་མེད༌པ་དང་། སྐྱེས་པའི་དུས་དང་འཆི་བའི་དུས་ཀྱང་མེད༌དེ། དཀོན་མཆོག་གི་སྲས་དང་མཚུངས་པར་ཡུན་གཏན་གྱི་མཆོད་དཔོན་ཡིན༌ནོ།།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་གིས་སོམས༌དང༌། མེས་པོ་ཨབ་ར་ཧམ་གྱིས་འཕྲོག་བཅོམ་བྱས་པའི་ནོར་རྫས་མཆོག་ཏུ་གྱུར་པ་ལས་བཅུ་ཆའི་གཅིག་བླངས་ནས་ཁོང་ཉིད་ལ་ཕུལ༌བས། སྐྱེས་བུ་དེ་ཉིད་ཇི་འདྲའི་རླབས་ཆེ་བ་ལ།"]},{"type":"verse","number":5,"content":["ཡང་ལེ་ཝིའི་བུ་རྒྱུད་ལས་མཆོད་དཔོན་གྱི་ལས་འགན་ཐོབ་པ་རྣམས་ཀྱིས་བཀའ་ཁྲིམས་ལྟར་འབངས་མི་ལས་བཅུ་ཆའི་གཅིག་ལེན་ཞིང་། དེ་དག་ནི་རང་གི་སྤུན་ཟླ་ཡིན༌ལ། ཨབ་ར་ཧམ་གྱི་བུ་རྒྱུད་ཡིན་ཡང་། ད་དུང་ལུགས་སྲོལ་ལྟར་བཅུ་ཆའི་གཅིག་ལེན༌པའོ།།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་། མཱལ་ཀི་ཚེ་དེག་ནི་ཁོ་རྣམས་དང་རིགས་རྒྱུད་མི་གཅིག་ཀྱང༌། ཨབ་ར་ཧམ་གྱིས་བཅུ་ཆའི་གཅིག་གནང་བའང་བླངས་པ༌དང༌། ཞལ་བཞེས་ཐོབ་པའི་ཨབ་ར་ཧམ་ལ་བྱིན་གྱིས་བརླབས་ཤིང་།"]},{"type":"verse","number":7,"content":["ཆེན་པོས་ཆུང་ངུ་ལ་བྱིན་གྱིས་བརླབས་པ་ནི་གནས་ལུགས་མཐར་ཐུག་ཡིན།"]},{"type":"verse","number":8,"content":["དོན་འདིའི་སྟེང་དུ་ཕྱོགས་གཅིག་ནས་བཅུ་ཆའི་གཅིག་ལེན་མཁན་ཐམས་ཅད་ནི་འཆི་བར་འགྱུར་ངེས་པའི་མི་ཡིན༌མོད། འོན་ཀྱང་ཕྱོགས་གཞན་ཞིག་ནས་བཅུ་ཆའི་གཅིག་ལེན་མཁན་མཱལ་ཀི་ཚེ་དེག་ལ་ཁོང་ནི་གསོན་པོ་ཡིན་ཞེས་བདེན་དཔང་བྱས་ཡོད༌པར་མ་ཟད།"]},{"type":"verse","number":9,"content":["བཅུ་ཆའི་གཅིག་ལེན་མཁན་ལེ་ཝིས་ཀྱང་ཨབ་ར་ཧམ་བརྒྱུད་ནས་བཅུ་ཆའི་གཅིག་ཕུལ་བ་ཡིན་ཞེས་བརྗོད་རུང་ངོ་།།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མཱལ་ཀི་ཚེ་དེག་གིས་ཨབ་ར་ཧམ་ལ་བསུ་བ་བྱེད་པའི་དུས་སུ། ལེ་ཝི་ཡང་རང་གི་མེས་པོའི་རྒྱུད་ལས་ཡོད་",{"noteId":0},"པའི་ཕྱིར་རོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མཱལ་ཀི་ཚེ་དེག་དང་མཚུངས་པའི༌སྐོར།"]},{"type":"verse","number":11,"content":["སྔོན་ཆད་ལེ་ཝིའི་རིགས་རྒྱུད་ཀྱི་མཆོད་དཔོན་གྱི་ལས་འགན་ལ་བརྟེན་ནས་མི་སྡེས་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་དང་དུ་བླངས་པ་དང༌། ལས་འགན་དེ་བརྒྱུད་ནས་ཕུལ་ཏུ་བྱུང་བར་འགྱུར་ཐུབ༌པ་ཡིན་ན། ཨ་རོན་གྱི་རིམ་པ་བཞིན་མ་ཡིན་པར་མཱལ་ཀི་ཚེ་དེག་གི་རིམ་པ་བཞིན་མཆོད་དཔོན་གཞན་ཞིག་འབྱུང་དགོས་དོན༌ཅི།"]},{"type":"verse","number":12,"content":["མཆོད་དཔོན་གྱི་ལས་འགན་བསྒྱུར་པ་ཡིན་པས་ན། བཀའ་ཁྲིམས་ཀྱང་ངེས་པར་བསྒྱུར་དགོས་སོ།།"]},{"type":"verse","number":13,"content":["རྒྱུ་མཚན་ནི་ཚིག་འདིས་བསྟན་པའི༌མི་དེ་ནི་ཚོ་པ་གཞན་ཞིག་ལ་གཏོགས༌ཤིང་། ཚོ་པ་དེ་ལས་མཆོད་ཁྲི་ལ་ཞབས་ཕྱི་བསྒྲུབས་མྱོང༌བ་གཅིག་ཀྱང་མེད་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":14,"content":["བདག་ཅག་གི་གཙོ་བོ་ནི་ཡ་ཧུ་དཱའི་ཚོ་པ་ལས་བྱུང༌བ་མངོན་གསལ་ཡིན་མོད། འོན་ཀྱང་ཚོ་པ་དེར་མཆོད་དཔོན་ཡོད་པ་ནི་མོ་ཤེ་ཡིས་གསུངས་མ་མྱོང༌།"]},{"type":"verse","number":15,"content":["གལ་ཏེ། མཱལ་ཀི་ཚེ་དེག་དང་མཚུངས་པའི་མཆོད་དཔོན་གཞན་ཞིག་བྱུང་ཚེ། བདག་གི་གཏམ་འདི་ནི་དེ་ལས་ཀྱང་གསལ་པོ་ཡིན༌ཏེ།"]},{"type":"verse","number":16,"content":["ཁོང་ཉིད་མཆོད་དཔོན་དུ་གྱུར་པ་ནི་མིའི་ཤ་གཟུགས་ཀྱི་ཕུང་བོའི་སྲོལ་ཡིག་བཞིན་དུ་མ་ཡིན༌པར། འཇོམས་ཐབས་མེད་པའི་ཚེ་སྲོག་གི་ནུས་མཐུ་བཞིན་དུ་གྱུར་པའོ།།"]},{"type":"verse","number":17,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་ལ་བདེན་དཔང་མཛད་པ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"མཱལ་ཀི་ཚེ་དེག་ཉིད་ཀྱི་རིམ་པ་བཞིན།།","poem":1},{"lineBreak":true},{"text":"ཁྱེད་ནི་ཇི་སྲིད་བར་དུ་མཆོད་དཔོན་ཡིན།།","poem":1},"ཞེས་གསུངས་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":18,"content":["ཕྱོགས་གཅིག་ནས་བཀའ་ཁྲིམས་ཀྱིས་ཅི་ཡང་ཕུལ་དུ་བྱུང་བར་མ་མཛད༌ཅིང༌། སྔོན་ཆད་ཀྱི་བཀའ་ནི་སྟོབས་དང་ཕན་ནུས་ཅི་ཡང་མེད་པས་དོར་བ་དང་། ཕྱོགས་གཞན་ཞིག་ནས་སྔར་ལས་ཁྱད་དུ་འཕགས་པའི་རེ་བ་ཞིག་དྲངས་ཡོད་ཅིང༌། རེ་བ་དེ་ལ་བརྟེན་ནས་བདག་ཅག་དཀོན་མཆོག་གི་དྲུང་དུ་སླེབ་ནུས་སོ།།"]},{"type":"verse","number":20,"content":["ཡང་གཅིག་སྨྲས༌ན། སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་དཔོན་དུ་བསྐོས་པ་ནི་དམ་བཅའ་མ་མཛད་པ་མ་ཡིན་ནོ།། མཆོད་དཔོན་གཞན་དག་ལ་མཚོན་ན། དམ་བཅས་ནས་བསྐོས་པ་མ༌ཡིན་ཏེ།"]},{"type":"verse","number":21,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཁོ་ན་དམ་བཅས་ནས་བསྐོས་པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་ཉིད་བསྐོ་མཁན་གྱིས་ཁོང་ལ་འདི་སྐད༌དུ།",{"text":"གཙོ་བོས་","poem":1},{"noteId":1},{"text":"དམ་བཅའ་བཞག་པས་ཐུགས་མི༌གཡོ།།","poem":1},{"lineBreak":true},{"text":"ཁྱེད་ནི་ཇི་སྲིད་བར་དུ་མཆོད་དཔོན༌ཡིན།།","poem":1},"ཞེས་གསུངས་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":22,"content":["དམ་བཅས་ནས་བསྐོས་པའི་རྐྱེན་གྱིས། སྐྱབས་མགོན་ཡེ་ཤུ་ནི་དེ་ལས་ཀྱང་ཁྱད་དུ་འཕགས་པའི་ཞལ་ཆད་ཀྱི་ཁག་ལེན་མཁན་དུ་གྱུར་པའོ།།"]},{"type":"verse","number":23,"content":["ཕྱོགས་གཅིག་ནས་མཆོད་དཔོན་དུ་གྱུར་པ་གཞན་དག་འཆི་བའི་བར་ཆད་ཀྱི་དབང་གིས། ཡུན་རིང་པོར་གནས་མི་ཐུབ་པས་ཁོ་རྣམས་ཀྱི་མི་གྲངས་མང༌བ་ཡིན་ནོ།།"]},{"type":"verse","number":24,"content":["ཕྱོགས་གཞན་ཞིག་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ནི་གཏན་དུ་བཞུགས་པ་ཡིན་པས། ཁོང་གི་མཆོད་དཔོན་གྱི་ལས་འགན་ལ་ནམ་ཡང་འགྱུར༌བ་མེད།"]},{"type":"verse","number":25,"content":["དེ་བས་ན། མི་དེ་རྣམས་ཀྱི་ཆེད་དུ་གསོལ་བ་འདེབས་པར་ཁོང་ཉིད་གཏན་དུ་གསོན་པོར་བཞུགས་པས། ཁོང་ལ་བརྟེན་ནས་དཀོན་མཆོག་གི་དྲུང་དུ་འགྲོ་མཁན་ཐམས་ཅད་ཁོང་གིས་མཐའ་གཅིག་ཏུ་སྐྱོབ་ནུས༌སོ།།"]},{"type":"verse","number":26,"content":["དམ་པ་དང་། སྐྱོན་མི་མངའ་བ། དྲི་མས་མ་གོས༌པ། སྡིག་ཅན་རྣམས་དང་ཁ་བྲལ༌བ། ནམ་མཁའ་ལས་ཀྱང་བླ་ན་འཕགས་པའི་མཆོད་དཔོན་ཆེན་པོ་",{"noteId":2},"འདི་ལྟ་བུ་ནི་བདག་ཅག་ལ་ཡོད་ན་འོས་འཚམ་ཡིན་ནོ།།"]},{"type":"verse","number":27,"content":["ཁོང་ནི་མཆོད་དཔོན་ཆེན་པོ་གཞན་དག་དང་འདྲ་བར། ངེས་པར་ཉིན་རེ་བཞིན་ཐོག་མར་རང་ཉིད་ཀྱི་སྡིག་པ༌དང༌། ཕྱིས་སུ་འབངས་མི་ཡི་སྡིག་པའི་ཕྱིར་མཆོད་པ་འབུལ་བ་མ་ཡིན༌ཏེ། ཁོང་གིས་རང་ཉིད་ཐེངས་གཅིག་ཁོ་ནར་ཕུལ་བས་དོན་དེ་ཡོངས་སུ་འགྲུབ་པར་མཛད༌པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":28,"content":["མ་གཞི་བཀའ་ཁྲིམས་ཀྱིས་ནུས་སྟོབས་ཞན་པའི་མི་རྣམས་མཆོད་དཔོན་ཆེན་པོར་བསྐོ་བར་བྱེད་པ་ཡིན༌མོད། འོན་ཀྱང་བཀའ་ཁྲིམས་ཀྱི་རྗེས་སུ་དམ་བཅས་པའི་བཀའ་ཡིས་སྲས་དཀོན་མཆོག་དེ་ཉིད་མཆོད་དཔོན་ཆེན་པོར་བསྐོས་ཤིང་རྟག་ཏུ་ཕུལ་དུ་བྱུང་བའོ།།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"མེས་པོའི་རྒྱུད་ལས་ཡོད་ཅེས་པར་མ་ཕྱི་ལས་ཕ་ཡི་དཔྱིའི་ནང་དུ་ཡོད་ཅེས༌མཐོང༌། དམ་པའི་གསུང་རབ་ཀྱི་མཁས་པ་རྣམས་ཀྱིས་བཞེད་པ་ལྟར་དོན་སྒྱུར་བྱས་པ༌ཡིན།","reference":{"chapter":7,"verse":10}},{"noteId":1,"caller":"+","text":"སྤྱིར་གཙོ་བོ་ཞེས་པ་གཙོ་བོ་ཡེ་ཤུ་ལ་འཇུག་པ་ཤུགས་ཆེ་ཡང་། འདིར་དམིགས་བསལ་གྱིས་ཡབ་དཀོན་མཆོག་ལ་གོ་དགོས།","reference":{"chapter":7,"verse":21}},{"noteId":2,"caller":"+","text":"འདིར་མཆོད་དཔོན་ཆེན་པོ་ཞེས་པ་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་གོ་དགོས།","reference":{"chapter":7,"verse":26}}]},"thisChapterLink":"/api/bod_ntb/HEB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HEB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HEB/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}