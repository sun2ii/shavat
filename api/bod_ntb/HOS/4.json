{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HOS","translationId":"bod_ntb","name":"ཧོ་ཤེ་ཨ།","commonName":"ཧོ་ཤེ་ཨ།","title":"༄༅། །ལུང་སྟོན་པ་ཧོ་ཤེ་ཨའི་མདོ།","order":28,"numberOfChapters":14,"sha256":"4a633848b603e0e91f0b2b50b2c615ebf25e44e75c537980b72e4f88b3affdb2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཡེས་ར་ཨེལ་ལ་རྒོལ་གཏམ་གཏོང་བ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ་པ་རྣམས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག ཡ་ཝཱེས་ཡུལ་འདིའི་མི་རྣམས་ལ་སྐྱོན་བརྗོད་པ་སྟེ། ཡུལ་འདི་རུ་བདེན་པ་དང་བྱམས་བརྩེ། དཀོན་མཆོག་ངོ་ཤེས་མཁན་བཅས་ནི་མེད་པ་དང་།"]},{"type":"verse","number":2,"content":["མནའ་རྫུན་མ་སྐྱེལ་བ་དང་། སླུ་བྲིད་གཏོང་བ། སྲོག་གཅོད་པ། རྐུ་བྱེད་པ། ལོག་གཡེམ་བྱེད་པ། གདུག་རྩུབ་སྤྱོད་པ། མི་བསད་ནས་ཁྲག་བཞུར་བ་བཅས་ནི་རྒྱུན་ཆད་མེད་པས་ན།"]},{"type":"verse","number":3,"content":["ཡུལ་འདིར་སྡུག་བསྔལ་གྱིས་ཁེངས་འདུག་སྟེ། དེར་སྡོད་པའི་ཡུལ་མི་རྣམས་དང་ཐང་གི་གཅན་གཟན། ནམ་མཁའི་འདབ་ཆགས་བཅས་ཐམས་ཅད་ཉིན་རེ་བཞིན་ཉམས་རྒུད་དུ་འགྱུར་ཞིང་། རྒྱ་མཚོའི་ཉ་རྣམས་ཀྱང་མེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":4,"content":["ཡིན་ནའང་སུ་ཞིག་གིས་ཀྱང་གཞན་དང་མ་རྩོད་སྐྱོན་ཡང་མ་བརྗོད་ཅིག ཁྱོད་ཀྱི་མི་རྣམས་ནི་མཆོད་དཔོན་ལ་བཀག་འགོག་བྱེད་པ་རྣམས་དང་འདྲའོ། །"]},{"type":"verse","number":5,"content":["ཉིན་དཀར་ཁྱོད་རང་འགྱེལ་བར་འགྱུར་ལ། མཚན་མོར་ལུང་སྟོན་པའང་ཁྱོད་དང་མཉམ་དུ་འགྱེལ་བར་འགྱུར་ཞིང་། ངས་ཁྱོད་ཀྱི་མ་ནི་མེད་པར་བྱའོ། །"]},{"type":"verse","number":6,"content":["ངའི་མི་རིགས་ལ་ཤེས་བྱ་མི་ལྡན་པས་མེད་པར་གྱུར་པ་དང་། ཁྱོད་ཀྱིས་ཤེས་བྱ་དོར་བས་ན་ངས་ཀྱང་ཁྱོད་རང་འདོར་བར་བྱ་སྟེ། ཁྱོད་ངའི་དྲུང་དུ་མཆོད་དཔོན་ཏུ་བསྐོ་བར་མི་བྱ། ཁྱོད་ཀྱིས་རང་གི་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བརྗེད་པས་ན་ངས་ཀྱང་ཁྱོད་ཀྱི་བུ་ཕྲུག་རྣམས་བརྗེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":7,"content":["མཆོད་དཔོན་ཇི་ལྟར་འཕེལ་ན་ང་དང་འགལ་བའི་སྡིག་པ་དེ་ལས་ལྷག་པར་བྱས་པས། ངས་དེ་དག་གི་གཟི་བརྗིད་ནི་ངོ་ཚ་རུ་བསྒྱུར་བར་བྱའོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་གིས་ངའི་མི་རྣམས་ཀྱི་སྡིག་བཤགས་མཆོད་པ་ཁྱུར་མིད་གཏོང་ཞིང་། ངའི་མི་རྣམས་ཀྱིས་སྡིག་ཉེས་བསགས་ན་སེམས་གཏིང་ནས་དགའ་བ་ཡིན།"]},{"type":"verse","number":9,"content":["ཡང་མི་ཐམས་ཅད་ལ་ཅི་ཞིག་ཕོག་པ་ལྟར་མཆོད་དཔོན་རྣམས་ལའང་དེ་འཕོག་པར་འགྱུར། ངས་དེ་དག་གི་སྤྱོད་པ་ལྟར་ཆད་པ་གཅོད་ངེས་ཡིན་ལ། དེ་དག་གི་ཅི་བྱས་བཞིན་ལན་གནང་བར་བྱའོ། །"]},{"type":"verse","number":10,"content":["དེ་དག་གིས་ཟོས་ཀྱང་མི་ཚིམ་ལ། ལོག་གཡེམ་བྱས་ཀྱང་རྒྱུད་འཕེལ་བར་མི་འགྱུར་ཏེ། ཅི་ལ་ཞེ་ན། ཁོ་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་ནས།"]},{"type":"verse","number":11,"content":["ནམ་རྒྱུན་ལོག་གཡེམ་བྱེད་ཅིང་། རྒུན་ཆང་གསར་རྙིང་གཉིས་ཀས་མི་སེམས་འཕྲོག་པར་བྱེད་པའོ། །"]},{"type":"heading","content":["སྐུ་འདྲ་ལ་བརྟེན་པར་གཏམ་སྨྲ་བ།"]},{"type":"verse","number":12,"content":["ངའི་མི་རྣམས་ཀྱིས་ཤིང་གི་སྐུ་བརྙན་ལ་བཀའ་འདྲི་ཞུས་ནས། དེའི་དབྱུག་པས་ཁོ་ཚོར་ལམ་སྟོན་གནང་བར་བསམ་པ་དང་། ལོག་གཡེམ་གྱི་སེམས་ཀྱིས་དེ་དག་གི་ལམ་ཁ་ནོར་དུ་བཅུག་ཅིང་། ལོག་གཡེམ་སྤྱད་དེ་རང་གི་དཀོན་མཆོག་སྤངས་པ་དང་།"]},{"type":"verse","number":13,"content":["རི་བོའི་རྩེ་མོ་རྣམས་སུ་མཆོད་པ་འབུལ་ཞིང་། མཐོ་གླིང་དག་གི་སྟེང་དུ་ལོ་འདབ་རྒྱས་ནས་བསིལ་གྲིབ་སྦྱིན་པའི་བེ་ཤིང་དང་སྦྱར་བ། ཐང་ཤིང་ཚི་བ་ཅན་བཅས་ཀྱི་འོག་ཏུ་བདུག་སྤོས་གདུག་པའོ། །དེ་བས་ཁྱོད་ཀྱི་བུ་མོ་དག་གིས་གཞང་བཙོང་ཞིང་། མནའ་མ་དག་གིས་ཀྱང་ལོག་གཡེམ་བྱེད་དོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ཀྱི་བུ་མོ་རྣམས་ཀྱིས་གཞང་བཙོངས་པའི་ལས་དང་། མནའ་མ་རྣམས་ཀྱིས་ལོག་གཡེམ་སྤྱད་པའི་ལས་ལ་ངས་ཉེས་ཆད་མི་གཅོད་དེ། ཅི་ལ་ཞེ་ན། དེ་རྣམས་རང་ཉིད་སོང་ནས་སྨད་འཚོང་མ་དང་འགྲོགས་ཤིང་། མཆོད་གཤོམ་གྱི་ཆོས་རྫུ་སྨད་འཚོང་མ་དང་འགྲོགས་ནས་མཆོད་པ་འབུལ་ལོ། །དེ་བས་ཤེས་རྨོངས་ཅན་གྱི་མི་འདི་རྣམས་ནི་འཇིག་པར་འགྱུར་རོ། །"]},{"type":"verse","number":15,"content":["ཀྱེ་ཡེས་ར་ཨེལ་ཁྱོད་ཀྱིས་ལོག་གཡེམ་བྱས་ཀྱང་། ཡ་ཧུ་དཱས་སྡིག་པ་བྱེད་མི་རུང་ལ། གིལ་གལ་དང་པེད་ཨ་ཝེན་དུ་ཡར་མ་འགྲོ་ཞིག གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་ཡང་མ་བསྐྱལ་ཞིག"]},{"type":"verse","number":16,"content":["ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ནི་བ་གཞོན་བཞིན་དུ་ཨུ་ཚུགས་ཆེ་བས། ད་ལྟ་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ཁོད་ཡངས་སར་ལུ་གུ་བཞིན་དུ་འཚོ་ནུས་སམ།"]},{"type":"verse","number":17,"content":["ཨེ་ཕཱར་ཡིམ་ནི་སྐུ་འདྲར་ཆགས་པས་སྐྱུར་ཞོག"]},{"type":"verse","number":18,"content":["དེ་དག་གིས་བཟི་དྭངས་རྗེས་ལོག་གཡེམ་བག་མེད་བྱེད་ཅིང་། དེ་དག་གི་འགོ་དཔོན་རྣམས་ནི་ངོ་ཚའི་ལས་ལ་རབ་ཏུ་དགའོ། །"]},{"type":"verse","number":19,"content":["དེ་དག་རླུང་འཚུབ་མས་འཁྱེར་ཞིང་། རང་གིས་འབུལ་བའི་མཆོད་པ་རྣམས་ཀྱིས་དེ་དག་སྐྱེངས་པར་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}