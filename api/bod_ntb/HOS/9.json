{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"HOS","translationId":"bod_ntb","name":"ཧོ་ཤེ་ཨ།","commonName":"ཧོ་ཤེ་ཨ།","title":"༄༅། །ལུང་སྟོན་པ་ཧོ་ཤེ་ཨའི་མདོ།","order":28,"numberOfChapters":14,"sha256":"4a633848b603e0e91f0b2b50b2c615ebf25e44e75c537980b72e4f88b3affdb2","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་ཉེས་ཆད་བསྒྲགས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ། མི་རིགས་གཞན་རྣམས་དང་འདྲ་བར་དགའ་ཞིང་ཡི་རང་བར་མ་བྱེད་ཅིག ཅི་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་ལོག་གཡེམ་སྤྱད་ནས་དཀོན་མཆོག་སྤངས་པ་དང་། གཡུལ་ཁ་རེ་རེའི་ནང་དུ་ཁྱོད་ནི་སྨད་བཙོངས་ནས་ཐོབ་པའི་རྔན་པར་ཆགས་སོ། །"]},{"type":"verse","number":2,"content":["གཡུལ་ཁ་དང་རྒུན་འབྲུམ་འཚིར་གཞོང་གིས་དེ་དག་གི་ཁ་མི་སོས་ལ། རྒུན་ཆང་གསར་པའང་ཆད་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེའི་ཡུལ་དུ་གནས་མི་ཐུབ་ལ། ཨེ་ཕཱར་ཡིམ་ནི་ཕྱིར་ཨེ་ཅིབ་ཡུལ་དུ་ལོག་ཅིང་། ཨ་སུར་དུ་ཟས་མི་གཙང་བ་བཟའ་བར་འགྱུར།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེར་སྐྱེམས་མཆོད་འབུལ་མི་ནུས་ཤིང་། ཁོ་ཚོའི་མཆོད་པར་ཁོང་ཐུགས་མཉེས་པར་ཡང་མི་འགྱུར། དེ་དག་གི་མཆོད་པ་ནི་གཤིན་པོར་མྱ་ངན་བྱེད་མཁན་གྱི་བག་ལེབ་ལྟར་ཡིན་ལ། དེ་ཟ་བ་ཐམས་ཅད་མི་གཙང་བར་འགྱུར་རོ། །གང་ལ་ཞེ་ན། དེ་དག་གི་བག་ལེབ་ནི་རང་གི་ལྟོ་བའི་ཕྱིར་ཡིན་པ་མ་གཏོགས། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་འཁྱེར་མི་རུང་།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་འདུ་འཛོམས་ཀྱི་ཉིན་མོ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་དུས་ཆེན་གྱི་ཉིན་མོར་ཁྱོད་ཚོས་ཅི་བྱའམ།"]},{"type":"verse","number":6,"content":["ལྟོས་ཤིག དེ་དག་གོད་ཆག་ལས་བྲོས་ནའང་ཨེ་ཅིབ་པས་ཁོ་ཚོ་བསྡུས་ནས་ནོབ་པ་རྣམས་ཀྱིས་བསྐུང་བར་འགྱུར། ཁོ་ཚོའི་དངུལ་གྱི་ནོར་བུ་རྣམས་གཟེ་མ་ར་མགོ་ཡིས་བཟུང་བར་འགྱུར་ལ། ཁོ་ཚོའི་གུར་གྱི་ནང་དུ་ཚེར་མ་སྐྱེ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":7,"content":["ཉེས་ཆད་ཀྱི་ཉིན་མོ་སླེབས་ལ་ཉེ། ལན་འཇལ་བའི་དུས་སྐབས་སླེབས་ཟིན་ཏོ། །ཡེས་ར་ཨེལ་གྱིས་དེ་རྟོགས་པར་འགྱུར་ཏེ། ལུང་སྟོན་པ་ནི་བླུན་པོ་དང་། ཐུགས་ཉིད་དང་ལྡན་པའི་མི་ནི་སྨྱོན་པ་དང་འདྲ་བར་འདོད་དོ། །ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱིས་སྡིག་པ་མང་པོ་བསགས་ནས་སེམས་སུ་ཞེ་སྡང་གིས་ཁེངས་པས་སོ། །"]},{"type":"verse","number":8,"content":["ལུང་སྟོན་པས་ངའི་དཀོན་མཆོག་དང་མཉམ་དུ་ཨེ་ཕཱར་ཡིམ་ལ་བྱ་ར་བྱེད་ཅིང་། ལུང་སྟོན་པ་འགྲོ་སའི་ལམ་ཐམས་ཅད་དུ་བྱ་རྙི་དང་། རང་གི་དཀོན་མཆོག་གི་གནས་ལ་འཁོན་སེམས་བཅངས་སོ། །"]},{"type":"verse","number":9,"content":["གིབ་ཨའི་ཉིན་མོ་ནང་བཞིན་དེ་དག་རྩ་བ་ནས་ཉམས་པར་བྱས་པ་དང་། ཡ་ཝཱེས་དེ་དག་གི་སྡིག་པ་ཐུགས་སུ་དྲན་ནས་ཁོ་ཚོའི་སྡིག་ཉེས་ལ་ཆད་པ་གཅོད་དོ། །"]},{"type":"verse","number":10,"content":["ཡེས་ར་ཨེལ་ནི་དབེན་སྟོང་གི་རྒུན་འབྲུམ་དང་། ཁྱོད་ཅག་གི་ཕ་མེས་ནི་སེ་ཡབ་ཤིང་གི་ཐོག་ཕུད་དང་འདྲ་བ་ངས་མཐོང་བྱུང་། ཡིན་ནའང་དེ་དག་པཱ་ཨལ་ཕེ་ཨོར་གྱི་རྩར་སོང་ནས་རང་ཉིད་དེར་ཕུལ་ནས་ཁྲེལ་མེད་གྱི་ལས་བྱས་ཏེ། ཁོ་རྣམས་དགའ་བ་དེ་དང་འདྲ་བར་ཞེན་ལོག་ཏུ་གྱུར་ཏོ། །"]},{"type":"verse","number":11,"content":["ཨེ་ཕཱར་ཡིམ་གྱི་གཟི་བརྗིད་ནི་བྱ་ལྟར་འཕུར་འགྲོ་ཞིང་། ཕྲུ་གུ་སྐྱེ་བ་དང་མངལ་དང་ལྡན་པ། ཕྲུ་གུ་འཁོར་བ་བཅས་ནི་དེའི་ནང་དུ་མེད་པར་འགྱུར།"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་རང་གི་བུ་ཕྲུག་རྣམས་བསྐྱངས་ནའང་ངས་དེ་ཐམས་ཅད་མེད་པར་བཅུག་སྟེ་གཅིག་ཀྱང་མི་ལུས་ལ། ཡང་ངས་དེ་དག་དོར་ནས་ཁོ་ཚོར་ཆག་སྒོ་འབྱུང་ངོ་། །"]},{"type":"verse","number":13,"content":["ཨེ་ཕཱར་ཡིམ་ནི་ཐཱར་དང་འདྲ་བར་ས་བཟང་པོར་བཙུགས་པ་བདག་གིས་མཐོང་མོད། འོན་ཀྱང་ཨེ་ཕཱར་ཡིམ་གྱིས་རང་གི་ཕྲུ་གུ་རྣམས་གཤེད་མའི་རྩར་འཁྲིད་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། དེ་དག་ལ་ཅི་ཞིག་གནང་བའི་ཕྱིར་ངས་ཞུ་བ་ཡིན་ནམ་ཞེ་ན། ཕྲུ་གུ་འཁོར་ཡང་མངལ་ཤོར་བ་དང་ནུ་མ་སྐམ་པོ་རྣམས་གནང་བར་མཛོད།"]},{"type":"verse","number":15,"content":["དེ་དག་གིས་གིལ་གལ་དུ་སྤྱད་པའི་ལས་ངན་པ་རྣམས་ཀྱི་དབང་གིས་ང་རང་ཁོ་རྣམས་ལ་སྡང་བ་ཡིན། དེ་དག་གིས་བསགས་པའི་སྡིག་ཉེས་རྣམས་ཀྱི་རྐྱེན་གྱིས་བདག་གིས་ཁོ་ཚོ་ངའི་གནས་ནས་སྤྱུག་པར་བྱ། ད་ནི་ངས་ཁོ་རྣམས་ལ་བྱམས་པར་མི་བྱ་སྟེ། ཁོ་ཚོའི་འགོ་དཔོན་ཐམས་ཅད་གྱེན་ལོག་མཁན་ཡིན་ནོ། །"]},{"type":"verse","number":16,"content":["ཨེ་ཕཱར་ཡིམ་ལ་བརྡུངས་ནས་རྩད་པ་སྐམ་ཏེ་འབྲས་བུ་ཆགས་མི་ཐུབ་ལ། ཕྲུ་གུ་བཙའ་བའི་དབང་དུ་བཏང་ནའང་། ངས་དེ་དག་གིས་གཅེས་པའི་བུ་རྣམས་གསོད་པར་བྱའོ། །"]},{"type":"verse","number":17,"content":["དེ་དག་གིས་བཀའ་ལ་མ་མཉན་པས་ན། ངའི་དཀོན་མཆོག་གིས་དེ་དག་སྤངས་ནས། ཁོ་ཚོ་མི་རིགས་གཞན་རྣམས་ཀྱི་ཁྲོད་དུ་འཁྱམ་པར་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}