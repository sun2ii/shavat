{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["པཱ་པེལ་ལོན་ཕམ་པར་ལུང་བསྟན་པ།"]},{"type":"verse","number":1,"content":["ཨ་མོ་ཟིའི་བུ་ཡེ་ཤ་ཡཱས་མཐོང་བའི་པཱ་པེལ་ལོན་སྐོར་གྱི་བཀའ་ལུང་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་སྐྱ་ཐེར་ཐེར་གྱི་རི་རྩེ་ལ་དར་བསྒྲེངས་ནས། མི་རྣམས་ལ་སྐད་བརྒྱབ་སྟེ་ལག་པ་གཡུགས་ཤིག དེ་དག་དབང་ཆེན་ཚོའི་མཁར་སྒོ་ལ་འཛུལ་དུ་ཆུག་དང་།"]},{"type":"verse","number":3,"content":["ངས་ནི་རང་གིས་ཆེད་དུ་བདམས་པའི་དམག་མི་རྣམས་ལ་བཀའ་བབས་ཤིང་། རང་གི་དཔའ་བོ་རྣམས་ཏེ་ང་རྒྱལ་དང་རང་རློམ་ཆེ་བའི་མི་རྣམས་བསྡུས་ནས་བདག་གིས་ཐུགས་ཁྲོ་ནང་དུ་མཛད་པའི་དོན་རྣམས་བསྒྲུབ་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["ཉོན་དང་། རི་རྩེ་ནས་མི་ཚོགས་འདུས་པ་བཞིན་དུ་འུད་སྒྲོག་ཅིང་། ཉོན་དང་། རྒྱལ་ཁབ་མང་པོ་འདུས་པ་བཞིན་དུ་མི་སྡེ་མང་པོའི་འུར་སྒྲ་ཡོད། དེ་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དམག་མི་བརྩིས་ནས་གཡུལ་འཁྲུག་ལ་བཀོད་འདོམས་མཛད་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ཡུལ་ཁམས་འདི་ཐམས་ཅད་བརླག་པའི་ཕྱིར་དུ། དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁོང་གི་ཐུགས་ཁྲོའི་མཚོན་ཆ་རྣམས་རྒྱང་རིང་ཡུལ་དང་ས་མཐའ་ནས་སླེབ་ངེས་སོ། །"]},{"type":"verse","number":6,"content":["སྨྲེ་སྔགས་ཐོན་དང་། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་སླེབ་ལ་ཉེ་ཞིང་། གཏོར་བརླག་ནི་ཀུན་དབང་ཁོང་ལས་སླེབས་པ་བཞིན་དུ་ཉིན་མོ་འདི་སླེབ་ལ་ཉེ་བས།"]},{"type":"verse","number":7,"content":["མི་རེ་རེའི་ལག་པའི་ཤེད་ཉམས་ཤིང་། མི་རེ་རེའི་སྙིང་རྩ་འདར་བར་འགྱུར།"]},{"type":"verse","number":8,"content":["དེ་དག་ཐམས་ཅད་དངངས་སྐྲག་སྐྱེ་བ་དང་། ཟུག་གཟེར་དང་སྡུག་བསྔལ་གྱིས་དེ་རྣམས་བཟུང་སྟེ་ཤིན་ཏུ་སྡུག་ལ་བསྒྱུར་ནས། ཕྲུ་གུ་བཙའ་བའི་བུད་མེད་བཞིན་དུ་དེ་ཚོས་དངངས་སྐྲག་གིས་ཕན་ཚུན་ལ་བལྟ་ཞིང་། གདོང་མདོག་དམར་པོ་མེ་ལྟར་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་སླེབ་ལ་ཉེ་ཞིང་། གདུག་རྩུབ་དང་ཞེ་སྡང་། ཐུགས་ཁྲོ་ཆེན་པོ་བཅས་ཀྱིས་ཡུལ་འདི་དབེན་སྟོང་ལ་འགྱུར་བར་བྱ་སྟེ། ཡུལ་འདིའི་སྡིག་ཅན་དག་མེད་པར་མཛད་དོ། །"]},{"type":"verse","number":10,"content":["ནམ་མཁའི་སྐར་མ་དང་སྐར་ཚོམ་གྱིས་འོད་མི་སྤྲོ་ཞིང་། ཉི་མ་ཤར་མ་ཐག་ཏུ་མུན་ནག་འཐིབས། ཟླ་བས་ཀྱང་འོད་སྤྲོ་བར་མི་བྱ།"]},{"type":"verse","number":11,"content":["བདག་གིས་ས་གཞིའི་སྡིག་སྤྱོད་ཀྱི་ཕྱིར་དུ་ཉེས་ཆད་གཅོད་ཅིང་། མི་ངན་གྱི་སྡིག་པའི་ཕྱིར་དུ་དེ་ཚོར་ཉེས་ཆད་བཅད་ནས། བདག་གིས་རང་རློམ་ཅན་གྱི་ང་རྒྱལ་བཅག་སྟེ། གཏུམ་སྤྱོད་ཅན་གྱི་ཁེངས་དྲེགས་ཉམས་པར་བྱ།"]},{"type":"verse","number":12,"content":["བདག་གིས་མི་ནི་གསེར་བཙོ་མ་ལས་ཀྱང་ཉུང་བར་བྱེད་ཅིང་། མི་ནི་ཨོ་ཕིར་གྱི་གསེར་ལས་ཀྱང་ཁྱད་དུ་འཕགས་པར་བྱའོ། །"]},{"type":"verse","number":13,"content":["བདག་ཤིན་ཏུ་ཐུགས་ཁྲོས་པའི་ཉིན་མོ་སྟེ། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་ཁྲོས་པའི་ཉིན་མོར། བདག་གིས་ནམ་མཁའ་བསྒུལ་ཞིང་། ས་གཞི་འདར་ནས་རང་སར་འབྲལ་བར་བྱ།"]},{"type":"verse","number":14,"content":["དེ་ནས་མི་རྣམས་རྔོན་པས་བདའ་བའི་དགོ་བའམ། བདག་པོ་མེད་པའི་ལུག་ཁྱུ་བཞིན་རང་རང་གི་མི་རྣམས་ཀྱི་ཕྱོགས་སུ་འཁོར་ནས་རང་ཡུལ་དུ་འབྲོ་ངེས་ཡིན།"]},{"type":"verse","number":15,"content":["བདས་ནས་རྗེས་ཆོད་པ་ཐམས་ཅད་མཚོན་གྱིས་བསྣུན་ཞིང་། བཟུང་བ་ཐམས་ཅད་རལ་གྲིའི་ཁ་ནས་འགྱེལ་ལོ། །"]},{"type":"verse","number":16,"content":["དེ་ཚོའི་ཕྲུ་གུ་རྣམས་རང་རང་གི་ཕ་མའི་མིག་ལམ་ནས་སར་བསྒྱེལ་ནས་འཆི་བ་དང་། དེ་ཚོའི་ཁང་པ་རྣམས་འཕྲོག་ཅིང་། དེ་ཚོའི་ཆུང་མ་རྣམས་ལའང་བཙན་གཡེམ་ཐེབས་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["ལྟོས་དང་། མཱ་ཏི་པས་དངུལ་གྱི་ཁ་ངོར་མི་བལྟ་ཞིང་གསེར་ལའང་མི་དགའ་བས། བདག་གིས་མཱ་ཏི་པ་རྣམས་བསྐུལ་ནས་དེ་དག་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":18,"content":["དེ་དག་གི་གཞུ་ཡིས་གཞོན་ནུ་རྣམས་བསྒྱེལ་བ་དང་། དེ་དག་གིས་ཕྲུ་གུ་ལ་སྙིང་རྗེ་མི་བསྐྱེད་ཅིང་། མིག་གིས་བྱིས་པ་རྣམས་ལ་སྙིང་རྗེས་ཀྱང་མི་གཟིགས་སོ། །"]},{"type":"verse","number":19,"content":["པཱ་པེལ་ལོན་ནི་རྒྱལ་ཁབ་ནང་ནས་བརྗིད་ཉམས་ཅན་དང་། ཀལ་དི་པས་གཟི་བརྗིད་དུ་རྩི་བ་ཞིག་ཡིན། དེ་ནི་དཀོན་མཆོག་གིས་ཕམ་པར་མཛད་པའི་ས་དོམ་དང་གཱ་མོ་ར་གཉིས་དང་འདྲའོ། །"]},{"type":"verse","number":20,"content":["མི་རབས་ནས་མི་རབས་བར་མི་གཅིག་ཀྱང་ཡུལ་དེར་གནས་པར་མི་བྱ་སྟེ། ཨ་རབ་པས་གནས་དེ་རུ་སྦྲ་གུར་མི་ཕུབ་ཅིང་། ཕྱུགས་རྫི་རྣམས་ཀྱིས་ཀྱང་གནས་དེར་ཕྱུགས་འཚོ་བར་མི་བྱའོ། །"]},{"type":"verse","number":21,"content":["ཡུལ་དེར་དབེན་སྟོང་གི་རི་དྭགས་རྣམས་འཚོ་ཞིང་ཉལ་བ་དང་། དེ་དག་གི་ཁང་པ་རྣམས་སུ་ཅེ་སྤྱང་གི་ཀུ་ཅོས་ཁེངས་ཏེ། རྔ་བྱ་དེ་རུ་སྡོད་ཅིང་། ར་རྒོད་རྣམས་དེ་རུ་མཆོང་རྒྱུག་བྱེད།"]},{"type":"verse","number":22,"content":["འཕར་སྤྱང་གི་ཚོགས་ཀྱིས་པཱ་པེལ་ལོན་གྱི་ཕོ་བྲང་དུ་ངར་སྐད་འདོན་ཞིང་། ཁྱི་སྤྱང་ནི་དེ་ཚོའི་ཡིད་དུ་འོང་བའི་འདུ་ཁང་ནང་ཟུག་པར་འགྱུར། པཱ་པེལ་ལོན་ལ་ཉེས་ཆེད་གཅོད་པའི་དུས་སླེབས་ཤིང་དུས་དེ་ནི་ཡུན་མི་རིང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}