{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཕྱིར་རང་ཡུལ་དུ་ལོག་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཀོབ་ལ་ཐུགས་རྗེ་དགོངས་ནས་ཡེས་ར་ཨེལ་སླར་ཡང་བདམས་ཤིང་། དེ་དག་རང་ཡུལ་དུ་བདེ་བར་སྡོད་དུས། ཕྱི་རོལ་པ་རྣམས་ཁོ་ཚོ་དང་འདྲེས་ནས་ཡ་ཀོབ་ཀྱི་ཁྱིམ་རྒྱུད་དུ་གཏོགས་པར་འགྱུར།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པས་དེ་ཚོ་རང་ཡུལ་དུ་འཁྲིད་པར་འགྱུར་ཞིང་། ཡེས་ར་ཨེལ་བུ་རྒྱུད་ཀྱིས་དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེས་གནང་བའི་གནས་སུ་གཡོག་པོ་དང་གཡོག་མོ་རུ་བཀོལ་ནས་རང་ལ་དབང་བར་བྱེད། དེ་དག་གིས་རང་ཉིད་བཙོན་ལ་ཁྲིད་མཁན་རྣམས་བཙོན་དུ་འཁྲིད་ཅིང་། ཁོ་རྣམས་ལ་བརྙས་བཅོས་བྱེད་མཁན་རྣམས་དབང་དུ་བསྒྱུར་ངེས་སོ། །"]},{"type":"heading","content":["པཱ་པེལ་ལོན་ལ་ཟུར་ཟ་བྱེད་པའི་གླུ།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་སྡུག་བསྔལ་དང་སེམས་ངལ། བཙན་བཀོལ་བའི་ངལ་ལས་བཅས་ནས་བསྐྱབས་ཏེ། ངལ་གསོ་བའི་ཉིན་མོ་ལོངས་སུ་སྤྱོད་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["དེ་ནས་ཁྱོད་ཅག་གིས་གླུ་བླངས་ཏེ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་ཟུར་ཟ་བྱས་ཏེ་ན་རེ། མི་ལ་བརྙས་བཅོས་གཉའ་གནོན་བྱེད་མཁན་ཅི་ལྟར་མཚམས་ཆད་དམ། གཏུམ་དྲག་ཅི་ལྟར་མཚམས་བཅད་དམ་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མི་ངན་གྱི་དབྱུག་པ་བཅག་ཅིང་དབང་སྒྱུར་པའི་བེ་ཅོན་བརླགས།"]},{"type":"verse","number":6,"content":["དེ་དག་ནི་ཁྲོ་གཏུམ་ནང་དུ་མི་རྣམས་ལ་རྡུང་མཁན་དང་། ཁོང་ཁྲོ་ཆེན་པོས་རྒྱལ་ཁབ་སྐྱོང་མཁན་དང་། བཟོད་བསྲན་མེད་པར་མི་ལ་གནོད་འཚེ་གཏོང་མཁན་དག་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ད་ལྟ་ས་གཞི་ཐམས་ཅད་ལྷིང་འཇགས་ངང་ངལ་གསོ་ཞིང་། མི་རེ་རེས་སྐད་བཏོན་ཏེ་དགའ་འབོད་བྱེད་ཀྱིན་འདུག"]},{"type":"verse","number":8,"content":["གསོམ་ཤིང་དང་ལེ་པཱ་ནོན་གྱི་ཐང་ཤིང་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་ཀྱི་ཕྱིར་དུ་མཉེས་ཏེ་ན་རེ། པཱ་པེལ་ལོན་ཁྱོད་འགྱེལ་ཟིན་པའི་རྗེས་སུ། ད་ནི་ཤིང་གཅོད་མཁན་གཅིག་ཀྱང་ང་ཚོ་གཅོད་པར་མི་འོང་ངོ་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":9,"content":["ས་འོག་ནས་གཤིན་ཡུལ་ཁྱོད་ཕྱིར་འགུལ་ཏེ། ཁྱོད་འོང་བར་བསུ་ཞིང་། ཡང་ཁྱོད་ཀྱི་ཕྱིར་དུ་སྔར་ས་གཞིའི་སྟེང་གི་འགོ་དཔོན་ཡིན་པ་ཀུན་གྱི་རྣམ་ཤེས་སད་དུ་བཅུག་སྟེ། སྔར་རྒྱལ་ཁབ་ཁག་གི་རྒྱལ་པོ་ཡིན་པ་ཐམས་ཅད་ཀྱང་རང་སར་བྲལ་ནས་ཡར་ལངས་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེ་ཐམས་ཅད་ཀྱིས་ཁྱོད་ལ་ན་རེ། ཁྱོད་ཀྱང་ང་ཚོ་བཞིན་ཉམ་ཆུང་བར་གྱུར་རམ། ཁྱོད་ཀྱང་ངེད་ཅག་དང་འདྲ་བར་གྱུར་རམ་ཞེས་འདྲི་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱི་གཟི་བརྗིད་དང་རྒྱུད་མངས་ཀྱི་སྒྲ་ནི་མར་གཤིན་ཡུལ་ལ་སླེབས་ཏེ། ཁྱོད་ཀྱི་འོག་ཏུ་ཤ་འབུ་བཏིངས་ཡོད་ལ། ཁྱོད་ཀྱི་སྟེང་དུ་སྐྱག་འབུ་བཀབ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ཀྱེ་འོད་མདངས་བཀྲ་བའི་སྐར་ཆེན་དང་སྐྱ་རེངས་ཀྱི་བུ་ལགས། ཁྱོད་ཅིའི་ཕྱིར་ནམ་མཁའ་ནས་སར་འཕངས་པ་ཡིན་ནམ། རྒྱལ་ཁབ་ཐམས་ཅད་ཕམ་པར་བརྒྱབ་པ་ཁྱོད་རང་ཅིའི་ཕྱིར་ས་རུ་འགྱེལ་བ་ཡིན།"]},{"type":"verse","number":13,"content":["སྔར་ཁྱོད་ཀྱི་སེམས་སུ། ང་རང་ནམ་མཁར་འཕགས་ཏེ་རང་གི་བཞུགས་ཁྲི་ནི་དཀོན་མཆོག་གི་རྒྱུ་སྐར་ལས་ཀྱང་མཐོ་བར་བཞེངས་ནས། བྱང་ཕྱོགས་ཀྱི་ས་མཐའི་རི་ཚོགས་སྟེང་དུ་འདུག་པ་དང་།"]},{"type":"verse","number":14,"content":["ང་ནི་སྤྲིན་གྱི་མཐོ་སར་འཛེགས་ཏེ། རང་ཉིད་བླ་ན་མེད་པ་དེ་དང་མཚུངས་པར་བྱའོ་སྙམ་ནའང་།"]},{"type":"verse","number":15,"content":["ཁྱོད་ནི་གཤིན་ཡུལ་དུ་གཡུགས་ནས། དོང་གི་ཆེས་གཏིང་སར་ལྷུང་བ་ཡིན།"]},{"type":"verse","number":16,"content":["མཐོང་མཁན་རྣམས་ཀྱིས་ཁྱོད་ལ་མིག་གིས་ཅེ་རེར་བལྟ་ཞིང་ན་རེ། ས་གཞི་སྒུལ་ཞིང་རྒྱལ་ཁབ་འཐོར་དུ་འཇུག་མཁན་དང་།"]},{"type":"verse","number":17,"content":["ས་གཞི་དབེན་སྟོང་དུ་བསྒྱུར་བ་དང་། གྲོང་ཁྱེར་རྣམས་བརླག་པ། བཙོན་གྲོལ་མི་གཏོང་བ་དེ་མི་འདི་ཡིན་ནམ་ཟེར་ཞིང་།"]},{"type":"verse","number":18,"content":["རྒྱལ་ཁབ་ཀུན་གྱི་རྒྱལ་པོ་རྣམས་གཟི་བརྗིད་ངང་རང་རང་གི་དུར་ས་ནས་གཟིམས།"]},{"type":"verse","number":19,"content":["འོན་ཀྱང་ཁྱོད་ནི་གཞན་གྱིས་དོར་བའི་སྡོང་པོའི་ཡལ་ག་བཞིན། རང་གི་དུར་ས་ནས་ཕྱིར་སྐྲོད་པར་འགྱུར། དོང་ནང་གི་རྡོ་ཡོད་སར་གཡུགས་པའི་མི་རྣམས་ཏེ། སྲོག་གྲི་ཁ་ནས་ཤོར་བ་དག་གིས་ཁྱོད་གཡོགས་ཤིང་། ཁྱོད་ནི་མི་ཡིས་རྡོག་བརྫིས་བརྒྱབ་པའི་རོ་དང་འདྲ།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་རང་གི་རྒྱལ་ཁབ་ཉམས་སུ་བཅུག་ཅིང་། རང་གི་མི་དམངས་དམར་གསོད་བཏང་བས། ཁྱོད་ནི་རྒྱལ་པོ་གཞན་དང་མཉམ་དུ་སྦ་བར་མི་བྱ་སྟེ། མི་ངན་དག་གི་བུ་རྒྱུད་ནམ་ཡང་མི་ཡིས་གླེང་བར་མི་བྱའོ། །"]},{"type":"verse","number":21,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོ་ཚོའི་མེས་པོ་རྣམས་ཀྱིས་སྡིག་པ་བྱས་པས། ཁྱོད་ཅག་གིས་དེའི་བུ་རྒྱུད་རྣམས་ཀྱི་ཕྱིར་དུ་དམར་གསོད་བྱེད་ས་གྲ་སྒྲིག་བྱེད་དགོས་པ་ལས། དེ་དག་དར་ཞིང་རྒྱས་ནས་ས་ཞིང་བདག་འཛིན་དང་གྲོང་ཁྱེར་བཙུགས་ནས་ས་གཞིར་ཁྱབ་ཏུ་འཇུག་མི་རུང་ངོ་། །"]},{"type":"verse","number":22,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་ནི་དེ་དག་གི་དགྲ་རུ་ལངས་ཤིང་། པཱ་པེལ་ལོན་གྱི་མིང་དང་། ཤུལ་ལུས་དག དེའི་བུ་རབས་ཚ་རྒྱུད་དང་བཅས་ཚར་དུ་གཅོད་པར་འགྱུར་ཞེས་གསུངས་པ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":23,"content":["བདག་གིས་པཱ་པེལ་ལོན་ནི་འུག་པར་འཛིན་དུ་འཇུག་ཅིང་། ས་དེ་ནི་འདམ་རྫབ་ལ་བསྒྱུར་ནས། བདག་གིས་ཕྱགས་མས་ས་ཕྱག་པ་བཞིན་དེ་མེད་པར་གཏོང་བར་འགྱུར་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":24,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དམ་བཅས་ནས་འདི་སྐད་དུ། བདག་གིས་ཅི་ལྟར་དྲན་ན་དོན་དེ་ལྟར་འགྲུབ་ཅིང་། བདག་གིས་ཅི་ལྟར་འཆར་གཞི་བཙུགས་ན་དོན་ནི་དེ་ལྟར་འགྲུབ་ངེས་ཡིན།"]},{"type":"verse","number":25,"content":["དེ་ནི་བདག་གི་གནས་སུ་ཨ་སུར་པ་རྣམས་མེད་པར་བཟོ་ཞིང་། ངའི་རི་བོ་ནས་ཁོ་ཚོར་རྡོག་བརྫིས་གཏོང་སྟེ། དེས་བཞག་པའི་གཉའ་ཤིང་ཡེས་ར་ཨེལ་པ་རྣམས་དང་འབྲལ་ཞིང་། དེས་བཀལ་བའི་ཁུར་པོ་ཡེས་ར་ཨེལ་པའི་ཕྲག་དང་འབྲལ་བར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":26,"content":["འདི་ནི་ས་གཞི་ཡོངས་ལ་བཙུགས་པའི་དགོངས་པ་སྟེ། རྒྱལ་ཁམས་ཀུན་ལ་བརྐྱངས་པའི་ཕྱག་ཡིན་ནོ། །"]},{"type":"verse","number":27,"content":["ཅི་ལ་ཞེ་ན། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཐུགས་སུ་དགོངས་པའི་དོན་ནི་སུས་ཀྱང་འགོག་ཐབས་མེད་ལ། ཁོང་གིས་བརྐྱངས་པའི་ཕྱག་ནི་སུ་ཞིག་གིས་ཕྱིར་འཐེན་ནུས་སམ།"]},{"type":"heading","content":["ཕེ་ལེ་ཤེད་ཡུལ་དུ་གནོད་འཚེ་འབྱུང་བར་ལུང་བསྟན་པ།"]},{"type":"verse","number":28,"content":["རྒྱལ་པོ་ཨ་ཧ་ཟཱ་ཤི་བའི་ལོ་དེར་བཀའ་ལུང་གནང་བ་འདི་ལྟར།"]},{"type":"verse","number":29,"content":["ཀྱེ་ཀྱེ་ཕེ་ལེ་ཤེད་པ་རྣམས། ཁྱོད་ལ་རྡུང་བའི་དབྱུག་པ་ཆག་སོང་ཞེས་དགའ་བར་མི་བྱའོ། །ཅི་ལ་ཞེ་ན། སྦྲུལ་ལས་དུག་སྦྲུལ་འབྱུང་ཞིང་། དེ་ལས་བྱུང་བ་ནི་འཁྱུག་ཅིང་བགྲོད་པའི་དུག་སྦྲུལ་ཡིན།"]},{"type":"verse","number":30,"content":["དབུལ་པོ་རྣམས་ལ་ཁ་ཟས་ལྡན་ཞིང་མེད་པོ་རྣམས་བདེ་བར་གནས་ཐུབ། བདག་གིས་མུ་གེས་ཁྱོད་ཀྱི་བུ་རྒྱུད་རྣམས་གཏོར་ཞིང་། ཁྱོད་ཀྱི་ཤུལ་ལུས་དག་མུ་གེས་མེད་པར་བྱའོ། །"]},{"type":"verse","number":31,"content":["ཀྱེ་ཀྱེ་མཁར་སྒོས་ངུ་འབོད་བྱོས་དང་། གྲོང་ཁྱེར་གྱིས་སྨྲེ་སྔགས་ཐོན་ཅིག ཕེ་ལེ་ཤེད་པ་རྣམས། ཁྱོད་ཅག་འཇིགས་ནས་ཡོངས་སུ་རྒུད་པར་གྱུར་ཅིག ཅི་ལ་ཞེ་ན། བྱང་ཕྱོགས་ནས་དུ་བ་ཞིག་འཕྱུར་འོང་སྟེ། དེའི་དཔུང་ཚོགས་དང་བྲལ་ནས་འབྲོ་ཐུབ་མཁན་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":32,"content":["མི་ཡིས་ཕྱི་ཕྱོགས་པའི་བང་ཆེན་ལ་ལན་ཅི་ལྟར་འདེབས་སམ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཛ་ཡན་མཛད་ཅིང་། ཁོང་གི་མི་སྡེའི་སྡུག་བསྔལ་ཅན་རྣམས་དེའི་ནང་དུ་སྦ་བར་འགྱུར་ཞེས་སྨྲའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}