{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["ཨེ་ཅིབ་སྐོར་གྱི་ལུང་བསྟན།"]},{"type":"verse","number":1,"content":["ཨེ་ཅིབ་སྐོར་གྱི་བཀའ་ལུང་ནི་འདི་ལྟ་སྟེ། ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་འགྲོས་མྱུར་སྤྲིན་ལ་བཅིབས་ནས་ཨེ་ཅིབ་ཏུ་ཕེབས་ཤིང་། ཨེ་ཅིབ་ཀྱི་སྐུ་འདྲ་རྣམས་ཁོང་གི་དྲུང་དུ་འཇིགས་ནས་འདར་བ་དང་། ཨེ་ཅིབ་པའི་སེམས་ནི་ཤིན་ཏུ་སྐྲག་གོ །"]},{"type":"verse","number":2,"content":["བདག་གིས་ཨེ་ཅིབ་པར་བསྐུལ་ཏེ་ཨེ་ཅིབ་པ་ལ་རྒོལ་བར་འགྱུར་ལ། དེ་དག་ནང་འཁྲུག་ལངས་ཏེ། མི་རེ་རེས་རང་གི་སྤུན་ཟླ་ལ་རྒོལ་བར་འགྱུར་ཞིང་། རང་གི་ཁྱིམ་མཚེས་བར་འཁྲུག་པ་ལངས་ནས་གྲོང་ཁྱེར་གྱིས་གྲོང་ཁྱེར་དང་། རྒྱལ་ཁབ་ཀྱིས་རྒྱལ་ཁབ་ལ་རྒྱག་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཨེ་ཅིབ་པའི་སེམས་ཤུགས་ཉམས་ཤིང་། བདག་གིས་དེ་དག་གི་ཇུས་ངན་རྣམས་མེད་པར་གཏོང་བ་དང་། དེ་དག་གིས་སྐུ་འདྲ་དང་སྔགས་པ། ལྷ་པ། སྒྱུ་མ་མཁན་བཅས་ལ་ཞུ་བར་འགྱུར།"]},{"type":"verse","number":4,"content":["ངས་ཨེ་ཅིབ་པ་རྣམས་རྒྱལ་པོ་གདུག་རྩུབ་ཅན་གྱི་ལག་ཏུ་གཏད་དེ། རྒྱལ་པོ་གཏུམ་དྲག་ཅན་གྱིས་དེ་ཚོ་དབང་དུ་བསྡུའོ་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་གཙོ་བོ་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":5,"content":["རྒྱ་མཚོའི་ཆུ་རྣམས་སྐམ་ཞིང་། ཆུ་བཞུར་ས་རྣམས་ཀྱང་སྐམ་ཐག་ཆོད་པར་འགྱུར།"]},{"type":"verse","number":6,"content":["ཆུ་ལམ་ནང་དུ་དྲི་ངན་ཐུལ་ཞིང་། ཨེ་ཅིབ་ཀྱི་ཆུ་བོ་རྣམས་ཐག་ཅིང་སྐམ་པ་དང་། འདམ་རྩྭ་དང་འདག་རྒྱུད་རྙིད་ཅིང་སྐམ་པར་འགྱུར།"]},{"type":"verse","number":7,"content":["ནཱ་ཡོལ་གཙང་པོའི་འགྲམ་རྒྱུད་དང་ནཱ་ཡོལ་གཙང་པོ་མདོ་ཡི་རྩྭ་ས། ད་དུང་ནཱ་ཡོལ་གཙང་པོའི་འགྲམ་ལ་བཏབ་ཡོད་པའི་ཞིང་བཅས་སྐམ་ནས་རླུང་གིས་ཐོར་ཞིང་མེད་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["ཉ་པ་རྣམས་ཀྱིས་སྨྲེ་སྔགས་འདོན་པ་དང་། ནཱ་ཡོལ་གཙང་པོའི་ནང་དུ་ལྕགས་ཀྱུས་ཉ་འཛིན་མཁན་རྣམས་སེམས་སྡུག་ཅིང་། ཆུ་སྟེང་ལ་རྙི་རྒྱ་འགྲེམ་པ་དག་ནི་ཡིད་ཆད་དེ་སེམས་སྐྱོ་བར་འགྱུར།"]},{"type":"verse","number":9,"content":["སོ་མ་ར་ཙས་སོ་རས་འཐག་པ་དང་རས་དཀར་པོ་འཐག་པའི་མི་རྣམས་ཀྱང་ངོ་ཚ་བར་འགྱུར།"]},{"type":"verse","number":10,"content":["ཨེ་ཅིབ་ཀྱི་ཀ་བ་རྣམས་དུམ་བུར་གཅོག་པ་དང་། གླ་པ་རྣམས་ཀྱང་སེམས་སྡུག་གིས་ཁེངས་པར་འགྱུར།"]},{"type":"verse","number":11,"content":["ཚོ་ཨན་གྱི་འགོ་དཔོན་རྣམས་ཤིན་ཏུ་རྨོངས་ཤིང་། ཤེས་རབ་ལྡན་པའི་ཕཱར་ཨོལ་གྱི་ཐབས་བཀོད་པས་ཇུས་བཏིངས་པ་རྣམས་ཀྱང་རྨོངས་གཉིད་དུ་གྱུར་པས། ཁྱོད་ཀྱིས་ཕཱར་ཨོལ་ལ། ང་ནི་ཤེས་རབ་ཅན་གྱི་བུ་དང་། གནའ་བོའི་རྒྱལ་པོའི་བུ་རྒྱུད་ཡིན་ཞེས་ཅི་ལྟར་བརྗོད་དམ།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་མཛངས་མི་རྣམས་གང་དུ་ཡོད་དམ། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ལ་བཅངས་པའི་ཐུགས་དགོངས་ཅི་ཡིན་པ་ཁྱོད་ལ་ཤེས་སུ་འཇུག་ཕྱིར། དེ་དག་གིས་ཁྱོད་ལ་བརྗོད་པར་གྱུར་ཅིག"]},{"type":"verse","number":13,"content":["ཚོ་ཨན་གྱི་འགོ་དཔོན་རྣམས་བླུན་རྨོངས་སུ་གྱུར་ཅིང་། ནོབ་ཀྱི་འགོ་དཔོན་དག་ལ་མགོ་སྐོར་ཐེབས། ཨེ་ཅིབ་ཕྱོགས་ཁག་གི་འགོ་དཔོན་རྣམས་ཀྱིས་ཨེ་ཅིབ་པ་རྣམས་ལམ་ལོག་ཏུ་ཁྲིད་དོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་པའི་ནང་དུ་ལོག་སེམས་བསྐྲུན་པ་དང་། ཐ་ན་ཨེ་ཅིབ་པས་སྤྱད་པ་ཐམས་ཅད་འཁྲུལ་ཞིང་། དེ་ནི་ཆང་གིས་བཟི་བའི་མི་རང་གི་སྐྱུག་རོ་ནང་དུ་འགྲེད་བདར་འཆོར་བ་དང་འདྲའོ། །"]},{"type":"verse","number":15,"content":["མགོ་ནས་རྔ་མ་དང་། ཤིང་ཏ་ལའི་ཡལ་ག་ནས་འདམ་རྩྭ་",{"noteId":6},"གང་གིས་ཀྱང་ཨེ་ཅིབ་ཀྱི་ཕྱིར་དུ་ཅི་ཡང་བསྒྲུབ་མི་ནུས་སོ། །"]},{"type":"verse","number":16,"content":["ཉིན་དེར་ཨེ་ཅིབ་པ་རྣམས་བུད་མེད་དང་འདྲ་བར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ཀྱི་སྟེང་ལ་ཕྱག་གཡུག་གནང་བའི་ཕྱིར་དེ་ཚོ་སྐྲག་ནས་འདར་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["ཡ་ཧུ་དཱའི་ཡུལ་ཁམས་ཀྱིས་ཨེ་ཅིབ་ལ་དངངས་སྐྲག་སློང་ཞིང་། སུ་ཞིག་གིས་ཨེ་ཅིབ་པར་ཡ་ཧུ་དཱ་གླེང་ན་དེ་དག་འཇིགས་པར་འགྱུར། གང་ལ་ཞེ་ན། འདི་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ལ་བཅངས་པའི་ཐུགས་དགོངས་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["ཉིན་དེར། ཨེ་ཅིབ་ཡུལ་གྱི་གྲོང་ཁྱེར་ལྔ་ཡི་མི་རྣམས་ཀྱིས་ཀ་ན་ཨན་གྱི་སྐད་སྨྲ་ཞིང་། ཡང་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བློ་དཀར་བར་མནའ་བསྐྱལ་ནས། གྲོང་ཁྱེར་གཅིག་ལ་ཉི་མའི་གྲོང་",{"noteId":7},"ཞེས་འབོད་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["དེའི་དུས་སུ། ཨེ་ཅིབ་ཡུལ་དུ་དཀོན་མཆོག་ཡ་ཝཱེར་ཕུལ་བའི་མཆོད་ཁྲི་ཞིག་དང་། དེའི་ས་མཚམས་སུ་དཀོན་མཆོག་ཡ་ཝཱེར་ཕུལ་བའི་ཀ་བ་ཞིག་ཡོད་པར་འགྱུར།"]},{"type":"verse","number":20,"content":["དེ་ཐམས་ཅད་ཨེ་ཅིབ་ཡུལ་དུ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་རྟགས་དང་དཔང་ཡིན། ཅི་ལ་ཞེ་ན། ཨེ་ཅིབ་པར་བརྙས་བཅོས་ཐེབས་ནས་དཀོན་མཆོག་ཡ་ཝཱེར་ཞུ་སྐབས། ཁོང་གིས་དེ་དག་ལ་སྐྱོབ་མཁན་དང་སྲུང་མཁན་ཞིག་མངགས་ཤིང་། དེ་ཡིས་ཁོ་ཚོ་སྐྱོབ་པར་འགྱུར།"]},{"type":"verse","number":21,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་པ་རྣམས་ལ་ཁོང་ཉིད་ངོ་ཤེས་པར་མཛད་ཅིང་། དུས་དེར་ཨེ་ཅིབ་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ངོ་ཤེས་པས། དེ་དག་གིས་ཁོང་ལ་མཆོད་རྫས་དང་མཆོད་པ་ཕུལ་ནས་བསྙེན་བཀུར་བྱེད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམ་བཅའ་བཞག་ནས་དེ་བཞིན་བསྒྲུབ་པར་འགྱུར།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་ཅིབ་ལ་རྒོལ་ཞིང་གསོ་བར་འགྱུར་བས། དེ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་སེམས་འཁོར་ཞིང་། དེ་ནས་ཁོང་གིས་དེ་དག་གི་གསོལ་བ་བཏབ་པ་ལ་གསན་ཞིང་དེ་དག་གསོ་བར་བྱའོ། །"]},{"type":"verse","number":23,"content":["དུས་དེར་ཨེ་ཅིབ་ནས་ཨ་སུར་ལ་འགྲོ་བའི་ལམ་ཆེན་ཞིག་ཡོད་ལ། ཨ་སུར་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་དུ་འགྲོ་བ་དང་། ཨེ་ཅིབ་པ་རྣམས་ཨ་སུར་ཡུལ་དུ་སླེབས་ནས་ཨེ་ཅིབ་པས་ཨ་སུར་པ་དང་མཉམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེར་བསྙེན་བཀུར་ཞུའོ། །"]},{"type":"verse","number":24,"content":["དུས་དེར་ཡེས་ར་ཨེལ་ནི་ཨེ་ཅིབ་དང་། ཨ་སུར་བཅས་མཉམ་དུ་ས་གཞིའི་རྒྱལ་ཁབ་ཡོངས་ཀྱི་བྱིན་རླབས་སུ་འགྱུར་ངེས།"]},{"type":"verse","number":25,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལ་བྱིན་རླབས་གནང་སྟེ་འདི་སྐད་དུ། བདག་གི་འབངས་མི་ཨེ་ཅིབ། ངའི་ལག་གི་ལས་ཀ་ཨ་སུར། ངའི་ནོར་སྐལ་ཡེས་ར་ཨེལ་བཅས་བདེའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":6,"caller":"+","text":"འདིར་མགོ་ནས་རྔ་མ་དང་ཤིང་ཏ་ལའི་ཡལ་ག་ནས་འདམ་རྩྭ་ཞེས་པ་ནི་མི་གལ་ཆེན་དང་མི་ཉམ་ཆུང་གཉིས་ལ་གོ་བ་ཡིན།","reference":{"chapter":19,"verse":15}},{"noteId":7,"caller":"+","text":"འདིར་ཉི་མའི་གྲོང་ཞེས་པ་འགྱུར་ལ་ལར་རྩ་མེད་འགྲོ་བའི་གྲོང་ཞེས་མཐོང་།","reference":{"chapter":19,"verse":18}}]},"thisChapterLink":"/api/bod_ntb/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}