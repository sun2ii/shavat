{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["ཐཱར་སྐོར་གྱི་ལུང་བསྟན།"]},{"type":"verse","number":1,"content":["ཐཱར་ཞེས་པའི་སྐོར་གྱི་བཀའ་ལུང་ནི་འདི་ལྟ་སྟེ། ཀྱེ་ཐཱར་ཞིས་ཀྱི་གྲུ་གཟིངས་རྣམས། ངུ་འབོད་གྱིས་ཤིག གང་ལ་ཞེ་ན། ཐཱར་གྱི་ས་ཆ་སྟོངས་ཤིང་འཇིག་ནས་དེ་རུ་ཁང་པ་མེད་ཅིང་། གྲུ་ཁའང་མེད་ཅེས་པའི་བརྡ་འདི་ནི་ཁོ་ཚོས་ཀིབ་རིས་ཡུལ་ནས་ཐོས་པར་གྱུར།"]},{"type":"verse","number":2,"content":["མཚོ་རྒྱུད་ཀྱི་ཡུལ་མི་སྟེ། མཚོ་འགྲུལ་ལ་བརྟེན་ནས་ཕྱུག་པོར་འགྱུར་བའི་ཚི་ཏུན་གྱི་ཚོང་པ་ཁྱོད་རྣམས་ཁུ་སིམ་པོར་སྡོད་ཅིག"]},{"type":"verse","number":3,"content":["ཆུ་ཆེན་སྟེང་གི་ཤུ་ཧོར་གྱི་འབྲུ་རིགས་དང་། ནཱ་ཡོལ་གཙང་པོའི་ལོ་ཏོག་བཅས་ནི་ཚི་ཏུན་གྱི་ཡོང་འབབ་ཡིན་པས། ཚི་ཏུན་ནི་རྒྱལ་ཁབ་ཀུན་གྱི་ཚོང་ར་རུ་གྱུར།"]},{"type":"verse","number":4,"content":["ཀྱེ་ཚི་ཏུན་ངོ་ཚ་བར་གྱུར་ཅིག གང་ལ་ཞེ་ན། རྒྱ་མཚོ་དང་རྒྱ་མཚོའི་ངར་ཤུགས་ཀྱིས། ངས་ཕྲུ་གུ་སྐྱེ་བའི་ན་ཟུག་ཉམས་སུ་མ་མྱངས་ལ། ཕྲུ་གུ་ཡང་བཙས་མ་མྱོང་། བུ་གསོས་མ་མྱོང་ལ་བུ་མོ་ཡང་གསོ་སྐྱོང་བྱས་མ་མྱོང་ངོ་ཞེས་པའོ། །"]},{"type":"verse","number":5,"content":["གནས་ཚུལ་འདི་ཨེ་ཅིབ་པས་ཐོས་པས། ཨེ་ཅིབ་པ་རྣམས་ཐཱར་གྱི་གནས་ཚུལ་འདིའི་ཕྱིར་ཤིན་ཏུ་སྐྱོ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":6,"content":["ཀྱེ་མཚོ་རྒྱུད་ཀྱི་ཡུལ་མི་རྣམས། ངུ་འབོད་བྱོས་ཤིག ཁྱོད་རྣམས་ཕ་རོལ་གྱི་ཐཱར་ཞིས་ལ་སོང་ཞིག"]},{"type":"verse","number":7,"content":["འདི་ནི་ཁྱོད་རྣམས་དགའ་བའི་གྲོང་ཁྱེར་ཡིན་ནམ། དེའི་འབྱུང་ཁུངས་བརྗོད་ན་གནའ་རབས་ཡིན་ཞིང་། དེའི་རྐང་པས་ཡུལ་མི་རྣམས་རྒྱང་རིང་དུ་ཁྲིད་ནས་སྡོད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":8,"content":["སུ་ཞིག་གིས་ཇུས་འགོད་བྱས་ཏེ་ཐཱར་ལ་རྒོལ་དུ་བཅུག་པ་ཡིན་ནམ། དེ་ནི་མི་ལ་ཅོད་པན་གནང་བའི་གྲོང་ཁྱེར་ཞིག་སྟེ། དེའི་ཚོང་པ་ནི་རྒྱལ་སྲས་དང་། དེའི་ཚོང་དཔོན་རྣམས་ནི་ས་གཞིའི་སྟེང་གི་བཀུར་འོས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["འདི་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དགོངས་ཏེ། གཟི་བརྗིད་ཀྱིས་ང་རྒྱལ་ཆེ་བ་དག་ལ་བརྙས་བཅོས་དང་། ས་གཞིའི་སྐུ་དྲག་ཐམས་ཅད་ལ་མཐོང་ཆུང་བྱེད་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":10,"content":["ཀྱེ་ཐཱར་ཞིས་ཀྱི་ཡུལ་མི་རྣམས། བཀག་འགོག་ཅི་ཡང་མེད་པའི་ནཱ་ཡོལ་གཙང་པོ་ཁྱོད་ཀྱི་ཡུལ་ལ་བཞུར་བ་བཞིན་དུ་སོང་ཞིག"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཕྱག་ཟུང་རྒྱ་མཚོའི་ཁྱོན་ལ་བརྐྱངས་ཏེ་རྒྱལ་ཁབ་ཀུན་སྒུལ་ཞིང་། ཁོང་གིས་ཀ་ན་ཨན་གྱི་སྐོར་ལ་དེའི་ནང་གི་བཙན་རྫོང་རྣམས་བཤིག་པར་འགྱུར་ཞེས་པའི་བཀའ་ཞིག་བབས།"]},{"type":"verse","number":12,"content":["ཡང་ཁོང་གིས་འདི་སྐད་དུ། བཙན་གནོན་ཐེབས་པའི་ཚི་ཏུན་གྱི་ཡུལ་མི་རྣམས། ཁྱོད་རྣམས་ཡང་བསྐྱར་དགའ་བར་མི་འགྱུར་ཏེ། ཡར་ལངས་ནས་ཕར་ཕྱོགས་ཀྱི་ཀིབ་རིས་སུ་སོང་དང་། དེ་ནས་ཀྱང་ཁྱོད་ལ་ངལ་གསོ་འཐོབ་པར་མི་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":13,"content":["ལྟོས་དང་། ཐཱར་ནི་དབེན་སྟོང་དང་རི་དྭགས་གནས་སར་འགྱུར་དུ་འཇུག་མཁན་ནི་ཀལ་དི་ནས་ཐོན་པའི་མི་ཡིན་པ་ལས་ཨ་སུར་པ་མ་ཡིན་ཏེ། ཁོ་ཚོས་མཁར་ལ་རྒོལ་བའི་ལྕོག་མཐོན་པོ་བརྩིགས་ཤིང་། ཐཱར་གྱི་མཁར་རྫོང་བཤིགས་ནས་ཞིག་རལ་དུ་བཏང་ཡོད་དོ། །"]},{"type":"verse","number":14,"content":["ཀྱེ་ཐཱར་ཞིས་ཀྱི་གྲུ་གཟིངས་རྣམས། ཁྱོད་ཀྱི་བཙན་རྫོང་རྣམས་གཏོར་བས་ངུ་འབོད་གྱིས་ཤིག"]},{"type":"heading","content":["ལོ་བདུན་ཅུའི་རྗེས་སུ་ཐཱར་ལ་ཡང་བསྐྱར་གཟིགས་སྐྱོང་མཛད་པ།"]},{"type":"verse","number":15,"content":["ཉིན་མོ་དེར། ཐཱར་ནི་རྒྱལ་རབས་གཅིག་གི་དུས་སྐབས་བཞིན་དུ་ལོ་བདུན་ཅུར་བརྗེད་པར་འགྱུར་ཞིང་། ལོ་བདུན་ཅུའི་རྗེས་སུ་ཐཱར་ནི་སྨད་འཚོང་མས་བླངས་པའི་གླུ་བཞིན་འགྱུར་ཏེ།"]},{"type":"verse","number":16,"content":["ཀྱེ་བརྗེད་ཟིན་པའི་གཡེམ་མ། མི་ཡིས་ཁྱོད་རང་ཕྱིར་དྲན་པའི་ཆེད་དུ་པི་ཝང་ཐོགས་ཏེ་གྲོང་ཁྱེར་ཡོངས་སུ་སྐྱོད་ཅིག རོལ་དབྱངས་དཀྲོལ་བཞིན་གླུ་མང་པོ་ལོངས་ཤིག་ཅེས་པའོ། །"]},{"type":"verse","number":17,"content":["ལོ་བདུན་ཅུའི་རྗེས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ཐཱར་ལ་གཟིགས་སྐྱོང་མཛད་ཅིང་། ཐཱར་ཡང་བསྐྱར་དར་ཞིང་རྒྱས་ཏེ། ས་གཞིའི་སྟེང་གི་རྒྱལ་ཁམས་ཀུན་དང་སྨད་འཚོང་མའི་ཚོང་བྱེད་དོ། །"]},{"type":"verse","number":18,"content":["དེའི་རྒྱུ་ནོར་དང་ཐོབ་པའི་ཁེ་ཕན་དམ་པའི་ཚུལ་དུ་དཀོན་མཆོག་ཡ་ཝཱེར་འབུལ་ཞིང་། གསོག་འཇོག་བྱེད་པར་མི་འགྱུར། གང་ལ་ཞེ་ན། དེའི་རྒྱུ་ནོར་དག་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྡོད་པའི་མི་ལ་དབང་བས། ཁོ་ཚོའི་ལྟོ་བ་འགྲང་ཞིང་གྱོན་པ་ལེགས་པོ་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}