{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["དཀོན་མཆོག་ལ་བརྟེན་པའི་བསྟོད་དབྱངས།"]},{"type":"verse","number":1,"content":["ཉིན་མོ་དེར། ཡ་ཧུ་དཱའི་ཡུལ་ནས་བསྟོད་དབྱངས་འདི་ལྟར་འབུལ་བར་འགྱུར་ཏེ། ང་ཚོ་ལ་མཁར་བརྟན་པོ་ཞིག་ཡོད། དཀོན་མཆོག་ཡ་ཝཱེས་ཐར་པ་ནི་དེའི་ལྕགས་རི་དང་གྱང་རགས་སུ་མཛད་ཡོད།"]},{"type":"verse","number":2,"content":["བདེན་པ་ཉིད་དང་བློ་དཀར་བའི་མི་རྣམས་ཀྱི་ནང་དུ་སླེབ་ཕྱིར་མཁར་སྒོ་ཕྱེས་ཤིག"]},{"type":"verse","number":3,"content":["སེམས་བསམ་པས་ཁྱེད་ལ་བརྟེན་མཁན་རྣམས་ནི་ཁྱེད་ཀྱིས་ཞི་བདེའི་ནང་དུ་བསྲུང་བ་སྟེ། གང་ལ་ཞེ་ན། དེ་ནི་ཁྱེད་ལ་བརྟེན་པའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་དུས་གཏན་གྱི་བྲག་རྡོ་ཡིན་པས་ཁྱོད་རྣམས་ཀྱིས་ནམ་ཡང་ཁོང་ལ་ཡིད་ཆེས་བྱོས་ཤིག"]},{"type":"verse","number":5,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁོང་གིས་ང་རྒྱལ་ཅན་མར་འབེབ་ཅིང་། མཐོ་སར་ཡོད་པའི་གྲོང་ཁྱེར་རྣམས་ཉམས་པར་མཛད་དེ་བཤིག་པ་དང་། ས་རུ་གཏོར་ནས་རྡུལ་དུ་བརླག"]},{"type":"verse","number":6,"content":["དཀའ་སྡུག་ཅན་དང་དབུལ་པོའི་རྐང་པ་ཡིས་དེ་ལ་རྡོག་རྫིས་གཏོང་བར་བྱའོ། །"]},{"type":"verse","number":7,"content":["དྲང་བདེན་མི་ཡི་ལམ་ནི་དྲང་པོ་ཡིན། ཀྱེ་དྲང་བདེན་ཅན་གྱི་གཙོ་བོ་ལགས། ཁྱེད་ཀྱིས་དྲང་བདེན་མི་ཡི་བགྲོད་ལམ་བདེ་བར་མཛད།"]},{"type":"verse","number":8,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ང་ཚོས་ཁྱེད་ཀྱི་ཁྲིམས་གཅོད་པའི་ལམ་དུ་ཁྱེད་ལ་སྒུག་ཡོད། ཁྱེད་ཀྱི་མཚན་སྙན་ནི་ང་ཚོའི་སེམས་ཀྱི་རེ་འདུན་ཉག་གཅིག་ཡིན།"]},{"type":"verse","number":9,"content":["མཚན་མོའི་དུས་སུ་ངའི་སེམས་སུ་ཁྱེད་ཉིད་དྲན། ངའི་སེམས་ཉིད་ཀྱིས་ཁྱེད་རང་འཚོལ་བར་བརྩོན། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱེད་ཀྱི་ཁྲིམས་གཅོད་ས་སྟེང་དུ་སླེབས་པའི་ཚེ། ས་གཞིའི་མི་ཐམས་ཅད་ཀྱིས་དྲང་བདེན་ཅི་ཡིན་ཤེས་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["མི་སྡིག་ཅན་ལ་ཐུགས་རྗེ་ཐོབ་ཀྱང་། དེས་དྲང་བདེན་ཅི་ཡིན་མི་རྟོགས་ཤིང་། དྲང་བདེན་ཡོད་སར་དེས་ད་དུང་ངན་པ་སྤྱོད་དེ། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བྱིན་དེ་ཡིས་མི་མཐོང་ངོ་། །"]},{"type":"verse","number":11,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱི་ཕྱག་ཡར་བཏེགས་ཀྱང་དེ་དག་གིས་མཐོང་བར་མ་གྱུར། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་མི་རྣམས་ལ་བཅངས་པའི་འཁུར་ཞེན་མཐོང་བར་མཛད་ནས་དེ་དག་ངོ་ཚར་གཏོད་ཅིག ཁྱེད་ཀྱི་དགྲ་ཡི་ཕྱིར་དུ་གྲ་སྒྲིག་བྱས་པའི་མེ་ཡིས་དེ་དག་ཁྱུར་མིད་གཏོང་གྱུར་ཅིག"]},{"type":"verse","number":12,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ང་ཚོར་ཞི་བདེ་གནང་ངེས་ཏེ། ཅིའི་ཕྱིར་ཞེ་ན། ངེད་རྣམས་ཀྱིས་སྤྱོད་པ་ཐམས་ཅད་ཁྱེད་ཀྱིས་ངེད་ཕྱིར་མཛད་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ཀྱེ་ངེད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ལས་གཞན་པའི་བདག་པོ་ཡིས་ང་ཚོར་དབང་བསྒྱུར་ནའང་། ང་ཚོས་ཁྱེད་ཀྱི་མཚན་ཁོ་ན་བརྗོད་པར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ཁོ་ཚོ་འཆི་བ་རྣམས་གསོན་པར་མི་འགྱུར་ལ། འདས་པོ་རྣམས་ཀྱང་ཡར་འགྲེང་བར་མི་འགྱུར། ཅི་ལ་ཞེ་ན། ཁྱེད་ཀྱིས་དེ་ཚོར་ཉེས་ཆད་བཅད་དེ་མེད་པར་མཛད་ཅིང་། དེ་དག་ནམ་ཡིན་ཡང་དྲན་པར་མི་མཛད།"]},{"type":"verse","number":15,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་མི་རྣམས་དར་ཞིང་རྒྱས་པར་མཛད། ཁྱེད་ཀྱིས་མི་རྣམས་དར་ཞིང་རྒྱས་པར་མཛད་ནས་གཟི་བརྗིད་ཁྱེད་ལ་ཐོབ་གྱུར་ཅིང་། ས་ཡི་ཕྱོགས་བཞི་ཁྱེད་ཀྱིས་རྒྱ་ཆེར་བསྐྱེད།"]},{"type":"verse","number":16,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། དཀའ་ངལ་དུས་སུ་ངེད་ཀྱིས་ཁྱེད་འཚོལ་ཞིང་། ཁྱེད་ཀྱི་ཉེས་ཆད་ངེད་ཀྱི་སྟེང་དུ་འབབ་དུས། ང་ཚོས་ལྷག་བསམ་རྣམ་དག་གིས་ཤུབ་ཤུབ་ཏུ་ཁྱེད་ལ་གསོལ་བ་འདེབས།"]},{"type":"verse","number":17,"content":["སྦྲུམ་མས་ཕྲུ་གུ་སྐྱེ་དུས་ཅི་ལྟར་ཟུག་གཟེར་ལངས་ནས་ངུ་སྐད་འཆོར་བ་བཞིན། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ངེད་རྣམས་ཁྱེད་ཀྱི་དྲུང་དུའང་དེ་བཞིན་ནོ། །"]},{"type":"verse","number":18,"content":["ངེད་རྣམས་སྦྲུམ་མ་བཞིན་དུ་ཟུག་གཟེར་ལངས་ཀྱང་རླུང་ལྟར་གྱུར་ནས་གང་ཡང་བཙས་མ་བྱུང་། ང་ཚོས་ས་སྟེང་དུ་ཐར་བའི་དོན་གང་ཡང་གཉེར་མ་ཐུབ་ལ། ས་གཞིའི་ཡུལ་མི་ངེད་ཀྱི་ཕྱིར་ཡང་བཙས་མ་ནུས།"]},{"type":"verse","number":19,"content":["ཁྱེད་ལ་དབང་བའི་འདས་པོ་རྣམས་གསོན་པར་འགྱུར་ཞིང་། དེ་དག་གི་བེམ་པོ་རྣམས་ཡར་ལངས་ངེས། ས་རྡུལ་ཁྲོད་དུ་སྡོད་མཁན་དག་སད་ནས་དགའ་འབོད་བྱེད་དེ། ཅི་ལ་ཞེ་ན། ཁྱེད་ཀྱི་ཟིལ་ཆར་ནི་ཞོགས་པའི་ཟིལ་པ་ཇི་བཞིན་ས་གཞིའི་འདས་པོ་རྣམས་ཀྱི་སྟེང་ལ་འབབ་ཅིང་། ས་གཞིར་ཚེ་ལས་འདས་པ་རྣམས་ཕྱིར་སྤྲོད་དུ་འཇུག་གོ །"]},{"type":"verse","number":20,"content":["ཀྱེ་ངའི་མི་རྣམས། ཚུར་ཤོག་དང་། ཁྱོད་ཀྱི་གཟིམ་ཁང་དུ་འཛུལ་ནས་སྒོ་རྒྱོབས་ཤིག ཁོང་གི་ཐུགས་ཁྲོ་མ་ཞི་བར་དུ་ཁྱོད་རྣམས་ཡུད་ཙམ་ཡིབ་ནས་སྡོད་ཅིག"]},{"type":"verse","number":21,"content":["ཅི་ལ་ཞེ་ན། ས་གཞིའི་ཡུལ་མི་རྣམས་ཀྱི་སྡིག་པར་ཉེས་ཆད་གཅོད་པར། དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་གི་བཞུགས་གནས་ནས་ཕེབས་ཏེ། ས་གཞིས་རང་གི་སྟེང་ནས་བཞུར་བའི་ཁྲག་མངོན་པ་དང་། བསད་པ་རྣམས་འགེབས་པར་མི་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}