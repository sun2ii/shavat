{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["དཀོན་མཆོག་ལ་སྐྱབས་ཞུ་བའི་གསོལ་བ།"]},{"type":"verse","number":1,"content":["ཀྱེ་མི་ལ་གཏོར་བརླག་གཏོང་ཞིང་རང་ཉིད་བརླག་པར་མི་འགྱུར་བ་དང་། གཡོ་སྒྱུ་སྤྱོད་ཅིང་གཞན་པས་ཁྱོད་ལ་གཡོ་སྒྱུ་མི་སྤྱོད་པ་རྣམས་ལ་ཆག་སྒོ་འབྱུང་། ཁྱོད་ཀྱིས་གཏོར་བརླག་བཏང་ཚར་མ་ཐག་ཏུ་རང་ཉིད་ཀྱང་འཇིག་པར་འགྱུར་ལ། ཁྱོད་ཀྱིས་གཡོ་སྒྱུ་སྤྱོད་མཚམས་བཞག་མ་ཐག་ཏུ་རང་ལ་ཡང་གཡོ་སྒྱུ་ཐེབས་པར་འགྱུར།"]},{"type":"verse","number":2,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ང་ཚོས་ཁྱེད་ལ་སྒུག་ཡོད་པས་ངེད་ཅག་ལ་ཐུགས་རྗེས་གཟིགས་སུ་གསོལ། ཞོགས་པ་རེ་རེར་ཁྱེད་ནི་ང་ཚོའི་དཔུང་པ་དང་། དཀའ་སྡུག་གི་དུས་སུ་ང་ཚོའི་མགོན་སྐྱབས་སུ་འགྱུར་བར་ཤོག"]},{"type":"verse","number":3,"content":["འུར་སྒྲ་ཐོས་མ་ཐག་མི་རྣམས་ཕྱོགས་བཅུར་འབྲོ་ཞིང་། ཁྱེད་ཡར་བཞེངས་དུས་མི་རིགས་རྣམས་གང་སར་འཐོར།"]},{"type":"verse","number":4,"content":["ཀྱེ་མི་རིགས་ཀུན། ཆ་ག་པས་འབྲུ་རིགས་སྡུད་པ་བཞིན་ཁྱོད་ཀྱི་བཅོམ་ནོར་རྣམས་ཕྱིར་ལེན་པར་འགྱུར་ཏེ། ཆ་ག་པ་ཟས་ཀྱི་ཕྱིར་དུ་བྲེལ་འཚུབ་ངང་འདུར་བ་བཞིན་མི་རྣམས་ཀྱང་བཅོམ་ནོར་སྟེང་བརྒྱུག་པར་བྱའོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་མཐོ་སར་བཞུགས་པས་ཁོང་ལ་བསྟོད་བསྔགས་བརྗོད་ཅིག ཁོང་གིས་དྲང་གཞག་དང་དྲང་བདེན་གྱིས་ཛ་ཡན་ཁེངས་པར་མཛད།"]},{"type":"verse","number":6,"content":["ཁོང་ནི་ཁྱོད་ཀྱི་ཚེ་གཅིག་ལུས་གཅིག་གི་བརྟེན་ས་དང་། ཕུན་སུམ་ཚོགས་པའི་སྲོག་སྐྱོབ། ཤེས་རབ་དང་ཤེས་བྱ་བཅས་ལགས་པས། དཀོན་མཆོག་ཡ་ཝཱེར་གུས་ཤིང་འཇིགས་པ་ནི་ཁྱོད་ཀྱི་ནོར་བུ་རྩ་ཆེན་ཡིན་",{"noteId":16},"ནོ། །"]},{"type":"verse","number":7,"content":["ལྟོས་དང་། དེ་དག་གི་དཔའ་རྒོད་རྣམས་ཀྱིས་སྲང་ལམ་ནས་འོ་དོད་འབོད་ཅིང་། ཞི་མཐུན་གྱི་སྐུ་ཚབ་རྣམས་སྡུག་བསྔལ་གྱིས་ཞུམ་པའོ། །"]},{"type":"verse","number":8,"content":["ལམ་ཆེན་རྣམས་སྟོངས་ཤིང་དེ་བརྒྱུད་ནས་འགྲོ་མཁན་མེད་པ་དང་། དགྲ་རྣམས་དམ་བཅའ་དང་འགལ་ཞིང་ཁྲིམས་མི་བརྩི་ལ། མི་ལ་བཀུར་བའང་མེད་དོ། །"]},{"type":"verse","number":9,"content":["ས་གཞི་མྱ་ངན་གྱིས་རྒུད་ཅིང་། ལེ་པཱ་ནོན་གནོང་ཞིང་སྐམ་པ་དང་། ཤཱ་རོན་ནི་མྱ་ངམ་ཐང་བཞིན་ཡིན་ལ། པཱ་ཤན་དང་ཀར་མེལ་གྱི་སྡོང་ལོ་རྣམས་ལྷུང་བའོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ད་ནི་བདག་ཡར་ལང་བར་བྱའོ། །ད་ནི་བདག་དར་བར་འགྱུར་ཞིང་། ད་ནི་མི་ཡིས་བདག་ལ་བསྟོད་པར་བྱའོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱི་མངལ་དུ་ཆགས་པ་ནི་ཕུབ་མ་དང་སྐྱེ་བར་འགྱུར་བ་སོག་མ་ཡིན་ཏེ། ཁྱོད་ཀྱི་དབུགས་ཀྱིས་མེ་བཞིན་རང་ཉིད་ཁྱུར་མིད་གཏོང་བར་འགྱུར།"]},{"type":"verse","number":12,"content":["མི་རྣམས་ནི་མེ་རུ་བསྲེགས་པའི་རྡོ་ཐལ་དང་། བྲེགས་ཟིན་པའི་ཚེར་མ་བཞིན་དུ་མེ་ལ་སྦར་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["ཀྱེ་རྒྱང་ཐག་རིང་བའི་མི་རྣམས། ཁྱོད་ཚོས་བདག་གིས་ཅི་བྱས་ལ་ཉོན་ཅིག ཀྱེ་ཉེ་བར་གནས་པའི་མི་རྣམས། ཁྱོད་ཚོས་བདག་གི་མཐུ་སྟོབས་ཤེས་པར་གྱིས།"]},{"type":"verse","number":14,"content":["ཛ་ཡན་དུ་གནས་པའི་སྡིག་ཅན་རྣམས་འཇིགས་ཤིང་། དད་པ་མེད་པའི་མི་རྣམས་འདར་ཡམ་གྱིས་བཟུང་སྟེ་ན་རེ། ང་ཚོ་ལས་སུ་ཞིག་ཡོངས་རྫོགས་རྩ་མེད་གཏོང་བའི་མེའི་ནང་དུ་སྡོད་ནུས་སམ། ང་ཚོ་ལས་སུ་ཞིག་དུས་རྟག་ཏུ་འབར་བའི་མེའི་ནང་དུ་སྡོད་ནུས་སམ་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":15,"content":["དེ་ཡང་དྲང་པོར་སྤྱོད་ཅིང་བདེན་ཚིག་སྨྲ་བ་དང་། བཙན་འཕྲོག་བྱས་པའི་རྒྱུ་ནོར་མི་ལེན་པ། ལག་པ་གཡུགས་ནས་ལྐོག་རྔན་མི་ལེན་པ། མི་གསོད་སྐོར་གྱི་གཏམ་ལ་མི་མཉན་པ། དོན་ངན་ལ་མི་བལྟ་བ་བཅས་པ་སྟེ།"]},{"type":"verse","number":16,"content":["མི་འདི་ལྟ་བུ་རྣམས་ནི་མཐོ་སར་བཞུགས་ཤིང་། བྲག་རི་བརྟན་པོ་རྣམས་དེའི་སྐྱབས་གནས་ཡིན་ལ། དེ་ལ་བག་ལེབ་གནང་ཞིང་དེའི་ཆུ་ཡང་ཆད་པར་མི་འགྱུར་རོ། །"]},{"type":"heading","content":["བདེ་སྐྱིད་ལྡན་པའི་མ་འོངས་པ།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་དངོས་སུ་རྒྱལ་པོའི་གཟི་བརྗིད་མཇལ་ཞིང་། མུ་མཐའ་མེད་པའི་ཡུལ་ཡང་མཐོང་བར་འགྱུར།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱི་སེམས་སུ་འདས་ཟིན་པའི་འཇིགས་སྣང་དྲན་ཏེ། རྩིས་གྲངས་ལེན་མཁན་དེ་གང་དུ་ཡོད་དམ། ཁྲལ་དངུལ་ཡང་ལྕི་འཇལ་མཁན་དེ་གང་དུ་ཡོད་དམ། བྱ་རའི་ཐོག་ཁང་བགྲང་མཁན་དེ་གང་དུ་ཡོད་དམ་ཞེས་བསམ་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["དེ་ནས་ཁྱོད་ཀྱིས་མི་གཏུམ་དྲག་ཅན་རྣམས་ཏེ། རྟོགས་དཀའ་བའི་གཏམ་སྨྲ་མཁན་དང་། ཚིག་ལྡབ་ལྡིབ་སྨྲ་བའི་མི་རྣམས་སླར་མཐོང་བར་མི་འགྱུར།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་རང་ཅག་གི་དུས་ཆེན་གཏོང་ཡུལ་ཛ་ཡན་གྲོང་ཁྱེར་ལ་ལྟོས་དང་། ཡེ་རུ་སཱ་ལེམ་ནི་ཞི་བའི་སྡོད་གནས་ཤིག་དང་། སྤོ་བར་མི་འགྱུར་བའི་གུར་མཆོག་ཅིག་ཡིན་པ་ཁྱོད་ཀྱིས་མཐོང་བར་འགྱུར། དེའི་ཕུར་པ་ནམ་ཡང་འབལ་བར་མི་འགྱུར་ལ། དེའི་ཐག་པའང་གཅོད་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":21,"content":["གནས་དེར་བརྗིད་ཉམས་ལྡན་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་རང་ཅག་དང་མཉམ་དུ་བཞུགས་ཤིང་། གཙང་པོ་དང་ཆུ་བོ་ཆེན་པོའི་གནས་ལྟ་བུ་ཡིན་ཞིང་། དེའི་སྟེང་དུ་བརྒྱུད་ནུས་པའི་གྲུ་དང་སྐྱ་བ་གང་ཡང་མེད་ལ། གྲུ་གཟིངས་ཀྱང་དེར་བརྒྱུད་མི་ནུས་སོ། །"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་རང་ཅག་གི་ཁྲིམས་གཅོད་མཁན་དང་། ཁོང་ནི་རང་ཅག་ལ་ཁྲིམས་གནང་མཁན་དང་རང་ཅག་གི་རྒྱལ་པོ་བཅས་ཡིན་པས་ཁོང་གིས་ང་ཚོ་སྐྱོབ་ངེས་ཡིན།"]},{"type":"verse","number":23,"content":["ད་ལྟ་ཁྱོད་ཀྱི་གྲུ་ཐག་ལྷོད་པས་དར་ཤིང་དམ་པོར་སྡོམ་མི་ནུས་ལ། གྲུ་གཡོར་ཡང་བརྟན་པོར་བསྒྲེང་མི་ནུས་ནའང་། དུས་དེར་བཅོམ་ནོར་མང་པོ་ཁྱོད་ཚོས་བགོ་ཞིང་། ཐ་ན་ཞ་བོས་ཀྱང་བཅོམ་ནོར་ཕྲོགས་ནས་འཁྱེར་ནུས་པ་ཡིན།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་ཡུལ་མི་ཚོས་ང་ལ་ན་ཚ་ཡོད་ཅེས་སྨྲ་བར་མི་བྱ་སྟེ། གང་ལ་ཞེ་ན། ཡུལ་དེར་གནས་པའི་མི་རྣམས་ཀྱི་སྡིག་ཉེས་སེལ་བར་འགྱུར་རོ། །"]}],"footnotes":[{"noteId":16,"caller":"+","text":"འདིར་ཁྱོད་ཀྱི་ནོར་བུ་རྩ་ཆེན་ཡིན་ཞེས་པར་འགྱུར་ལ་ལར་ཁོང་ནས་འཐོབ་པའི་ནོར་བུ་རྩ་ཆེན་ཡིན་ཞེས་ཀྱང་མཐོང་།","reference":{"chapter":33,"verse":6}}]},"thisChapterLink":"/api/bod_ntb/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}