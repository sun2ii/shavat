{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":36,"content":[{"type":"heading","content":["ཨ་སུར་རྒྱལ་པོས་ཡ་ཧུ་དཱ་ལ་རྒོལ་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་རྒྱལ་སྲིད་སྐྱོང་བའི་ལོ་བཅུ་བཞི་པར། ཨ་སུར་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱིས་ཡ་ཧུ་དཱའི་འགོག་སྲུང་གྲོང་ཁྱེར་རྣམས་ལ་དཔུང་འཇུག་བྱས་ནས་བླངས་པ་དང་།"]},{"type":"verse","number":2,"content":["ཨ་སུར་རྒྱལ་པོས་ལཱ་ཀི་སི་ནས་རབ་ཤཱ་ཀེ་ཞེས་བྱ་བའི་དམག་དཔུང་ཆེན་པོ་དང་བཅས་པ་ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་བརྫངས་ཏེ། གོས་འཁྲུད་མཁན་གྱི་ཞིང་ཁའི་ལམ་ཆེན་དུ་ཡོད་པའི་རྫིང་བུ་གོང་མའི་ཆུ་ཡུར་འགྲམ་དུ་ལངས་བསྡད་པ་ན།"]},{"type":"verse","number":3,"content":["ཧིལ་ཀི་ཡཱའི་བུ་སྟེ་རྒྱལ་པོའི་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་། དྲུང་ཡིག་ཤེབ་ནཱ་དང་། ཨ་སབ་ཀྱི་བུ་སྟེ་ལོ་རྒྱུས་འགོད་མཁན་ཡོ་ཨག་བཅས་པ་ཁོ་བསུ་བར་ཕྱི་རོལ་ཏུ་ཐོན་ནོ། །"]},{"type":"verse","number":4,"content":["དེར་རབ་ཤཱ་ཀེས་དེ་དག་ལ་ན་རེ། ཁྱོད་ཅག་སོང་སྟེ་ཧི་ཟི་ཀི་ཡཱ་ལ་ཞུས་ཤིག རྒྱལ་པོ་ཆེན་པོ་ཨ་སུར་གྱིས་འདི་སྐད་གསུངས་ཏེ། ཁྱོད་ཀྱིས་བློ་བཅོལ་བའི་འགོག་སྲུང་དེ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":5,"content":["ངས་བལྟས་ན་ཁྱོད་ཀྱིས་གཡུལ་འགྱེད་པའི་བློ་བཀོད་དང་སྟོབས་ཤུགས་ཡོད་ཅེས་པ་ནི་སྟོང་བཤད་ཙམ་ཡིན་ལ། ད་ལྟ་ཁྱོད་ཀྱིས་སུ་ལ་བརྟེན་ནས་བདག་ལ་ངོ་ལོག་བྱེད་དམ།"]},{"type":"verse","number":6,"content":["ལྟོས་དང་། ཁྱོད་ཀྱིས་འདམ་བུའི་དབྱུག་པ་ཆག་པོ་སྟེ་ཨེ་ཅིབ་ལ་བློ་བཅོལ་བ་རེད། སུ་ཞིག་དེར་བརྟེན་ན་དེ་ནི་ཁོའི་ལག་པར་ཟུག་ནས་བརྟོལ་བར་བྱེད། ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཕཱར་ཨོལ་གྱིས་རང་ལ་བློ་གཏད་བཅོལ་མཁན་ཐམས་ཅད་ལའང་དེ་བཞིན་དུ་བྱེད་དོ། །"]},{"type":"verse","number":7,"content":["ཡང་གལ་ཏེ་ཁྱོད་ཀྱིས་ང་ལ། ངེད་ཅག་ནི་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྟེན་པ་ཡིན་ཟེར་ན། ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཐོ་གླིང་དང་མཆོད་ཁྲི་རྣམས་བཤིགས་ནས། ཡ་ཧུ་དཱ་པ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་ལ། ཁྱོད་ཅག་གིས་མཆོད་ཁྲི་འདིའི་མདུན་དུ་བསྙེན་བཀུར་ཞུ་དགོས་ཞེས་བསྒོས་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["ད་ལྟ་ཁྱོད་ཀྱིས་ངའི་བདག་པོ་ཨ་སུར་གྱི་རྒྱལ་པོ་དང་གྲོས་མཐུན་འཇོག་པར་ཞུ། གལ་ཏེ་ཁྱོད་ཀྱིས་ཞོན་པ་ཉིས་སྟོང་མངག་ནུས་ན། ངས་ཁྱོད་ལ་དམག་རྟ་སྟོང་ཕྲག་གཉིས་སྟེར་བར་བྱའོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་ཀྱིས་ཤིང་རྟ་དང་སྐྱ་དམག་རྣམས་ཀྱི་ཕྱིར་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོར་བློ་བཅོལ་ཡང་། ངའི་བདག་པོའི་འཁོར་འབངས་ཆུང་ཤོས་གཅིག་གི་ངོ་གདོང་དེ་ཡང་ཇི་ལྟར་བཟློག་ནུས་སམ།"]},{"type":"verse","number":10,"content":["ད་ལྟ་ང་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་འཁྲོལ་མེད་པར་ས་ཆ་འདི་འཇིག་པར་བྱེད་དུ་ཡར་འོངས་པ་ཡིན་ནམ། དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ལ། ཡུལ་དེར་ཡར་སོང་ལ་དེ་མེད་པར་བྱོས་ཤིག་ཅེས་པའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["དེ་ནས་ཨེལ་ཡ་ཀིམ་དང་། ཤེབ་ནཱ། ཡོ་ཨག་བཅས་ཀྱིས་རབ་ཤཱ་ཀེ་ལ་ན་རེ། ང་ཚོས་ཨ་རམ་པའི་སྐད་ཤེས་པས་ཁྱོད་ཀྱི་ཞབས་ཕྱི་ཚོར་ཨ་རམ་པའི་སྐད་སྨྲ་བར་མཛོད་ཅིག ལྕགས་རིའི་སྟེང་གི་མི་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་སྐད་གོ་བས་དེ་མི་གསུང་རོགས་ཞེས་ཞུས་ཀྱང་།"]},{"type":"verse","number":12,"content":["རབ་ཤཱ་ཀེ་ན་རེ། ང་ཡི་བདག་པོས་ཁྱོད་ཀྱི་བདག་པོ་དང་ཁྱོད་ཁོ་ནར་གཏམ་འདི་དག་སྨྲ་བའི་ཕྱིར་ང་འདིར་མངགས་པ་ཡིན་ནམ། ཁོང་གིས་ལྕགས་རིའི་སྟེང་སྡོད་པའི་མི་རྣམས་ཏེ། ཁྱོད་དང་མཉམ་དུ་རང་གི་སྐྱག་པ་ཟ་ཞིང་། རང་གི་གཅིན་པ་འཐུང་བ་རྣམས་ལའང་སྨྲ་བའི་ཕྱིར་ང་རང་མངགས་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["བསླབ་བྱའི་གཏམ།"]},{"type":"verse","number":13,"content":["དེ་ནས་རབ་ཤཱ་ཀེ་ཡར་ལངས་ནས་སྐད་ཆེན་པོས་ཡ་ཧུ་དཱའི་སྐད་དུ། ཁྱོད་ཅག་གིས་རྒྱལ་པོ་ཆེན་པོ་ཨ་སུར་གྱི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":14,"content":["རྒྱལ་པོས་འདི་སྐད་གསུངས་ཏེ། ཧི་ཟི་ཀི་ཡཱས་ཁྱོད་ཅག་སྐྱོབ་མི་ནུས་པས། ཁྱོད་ཅག་ཁོའི་གཡོ་འོག་ཏུ་མི་ཚུད་པར་གྱིས།"]},{"type":"verse","number":15,"content":["ཡང་ཧི་ཟི་ཀི་ཡཱས་ཁྱོད་ཅག་དཀོན་མཆོག་ཡ་ཝཱེར་བརྟེན་དགོས་པའི་ཐད། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ཚོ་སྐྱོབ་ངེས་ཤིང་། གྲོང་ཁྱེར་འདིའང་ཨ་སུར་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་པར་མི་བྱའོ་ཞེས་པའི་ཚིག་ལ་མ་མཉན་ཅིག"]},{"type":"verse","number":16,"content":["ཧི་ཟི་ཀི་ཡཱའི་གཏམ་ལ་མཉན་མི་རུང་། རྒྱུ་མཚན་ནི་ཨ་སུར་གྱི་རྒྱལ་པོས་འདི་སྐད་གསུངས་ཏེ། ཁྱོད་ཅག་བདག་དང་མཐུན་པོ་ཡོང་ཆེད་ཕྱི་རུ་ཤོག་དང་། ཁྱོད་ཚོ་མི་རེ་རེས་རང་གི་རྒུན་ཤིང་དང་སེ་ཡབ་ཤིང་གི་འབྲས་བུ་བཟའ་ཞིང་། རང་རང་གི་ཁྲོན་པའི་ཆུ་འཐུང་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["རྗེས་སུ་བདག་འོང་བའི་དུས་སུ་ཁྱོད་རྣམས་ནི་ཁྱོད་ཅག་གི་ཡུལ་ཁམས་ལྟ་བུའི་ཡུལ་ཞིག་ལ་འཁྲིད་པར་བྱ་སྟེ། ཡུལ་དེར་འབྲུ་རིགས་འཛོམས་ཤིང་རྒུན་ཆང་གསར་པ་ཡོད་པ་དང་། བག་ལེབ་དང་རྒུན་འབྲུམ་ར་བ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་ཅག་སྐྱོབ་ངེས་ཡིན་ཞེས་ཧི་ཟི་ཀི་ཡཱས་བློ་འགུག་པ་ལ་ཁྱོད་རྣམས་དོགས་པར་གྱིས། མི་རིགས་རྣམས་ཀྱི་ལྷ་རྣམས་ལས་སུ་ཞིག་གིས་རང་གི་ས་ཆ་ཨ་སུར་རྒྱལ་པོའི་ལག་ནས་བསྐྱབས་མྱོང་ངམ།"]},{"type":"verse","number":19,"content":["ཧ་མཱད་དང་ཨར་ཕད་ཀྱི་ལྷ་རྣམས་གང་དུ་ཡོད་དམ། སེ་ཕར་ཝ་ཨིམ་གྱི་ལྷ་རྣམས་གང་དུ་ཡོད་དམ། ལྷ་དེ་དག་གིས་སཱ་མར་ཡ་ངའི་ལག་ནས་བསྐྱབས་མྱོང་ངམ།"]},{"type":"verse","number":20,"content":["ཡུལ་དེ་དག་གི་ལྷ་རྣམས་ལས་སུ་ཞིག་གིས་རང་གི་ས་ཆ་ངའི་ལག་ནས་བླངས་པ་ཡིན་ནམ། དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ལག་ནས་ཡེ་རུ་སཱ་ལེམ་སྐྱོབ་ནུས་སམ་ཞེས་སྨྲས་ཀྱང་།"]},{"type":"verse","number":21,"content":["རྒྱལ་པོས་དེ་ལ་ལན་མ་འདེབས་ཞེས་བཀའ་བསྒོས་ཡོད་པས། མི་རྣམས་ཁ་རོག་གེར་བསྡད་དེ་གཏམ་ལན་ཚིག་གཅིག་ཀྱང་མ་སྨྲས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་ཧིལ་ཀི་ཡཱའི་བུ་སྟེ་རྒྱལ་པོའི་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་། དྲུང་ཡིག་ཤེབ་ནཱ་དང་། ཨ་སབ་ཀྱི་བུ་སྟེ་ལོ་རྒྱུས་འགོད་མཁན་ཡོ་ཨག་བཅས་ཀྱིས་རང་རང་གི་གྱོན་གོས་གཤགས་ཏེ། ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་འོངས་ནས་རབ་ཤཱ་ཀེའི་གཏམ་རྣམས་ཁོང་ལ་ཞུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/35.json","previousChapterAudioLinks":{},"numberOfVerses":22}