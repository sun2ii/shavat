{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":37,"content":[{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱས་ཡེ་ཤ་ཡཱ་ལ་སྐྱབས་ཞུས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱས་དེ་ཐོས་པ་ཙམ་གྱིས་རང་གི་ན་བཟའ་གཤགས་ནས། ལུས་པོར་རྩིད་རས་གཡོགས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་ཕྱིན།"]},{"type":"verse","number":2,"content":["ཁོས་ཕོ་བྲང་གི་ནང་བློན་ཨེལ་ཡ་ཀིམ་དང་དྲུང་ཡིག་ཤེབ་ནཱ། མཆོད་དཔོན་རྣམས་ལས་རྒན་པོ་དག་རྩིད་རས་ཀྱིས་གཡོགས་ཏེ་ཨ་མོ་ཟིའི་བུ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་དྲུང་དུ་མངགས།"]},{"type":"verse","number":3,"content":["དེ་དག་གིས་ཁོང་ལ། ཧི་ཟི་ཀི་ཡཱ་ན་རེ། དེ་རིང་ནི་ཉེན་ཚབས་ཆེ་ཞིང་འཇིགས་སྐུལ་ཐེབས་པ་དང་། བརྙས་བཅོས་ཐེབས་པའི་ཉིན་མོ་ཡིན། དེ་ནི་ཕྲུ་གུ་བཙའ་རན་ནའང་བཙའ་བའི་སྟོབས་ཟད་པ་དང་འདྲའོ། །"]},{"type":"verse","number":4,"content":["ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས་ཀྱིས་རབ་ཤཱ་ཀེའི་གཏམ་རྣམས་གསན་ཡོད་ཀྱང་སྲིད། དེ་ནི་ཁོའི་བདག་པོ་ཨ་སུར་རྒྱལ་པོས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ལ་སྨོད་ཅིང་སྐུར་བ་འདེབས་པའི་དོན་དུ་ཁོ་རང་འདིར་མངགས་པ་ཡིན་ཞིང་། ཁྱེད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསན་པའི་ཚིག་རྣམས་ཀྱི་རྐྱེན་གྱིས་ཁོ་ལ་གཤེ་གཤེ་གཏོང་ངེས་ཡིན། དེ་བས་ཁྱེད་ཀྱིས་ཤུལ་ལུས་རྣམས་ཀྱི་དོན་དུ་གསོལ་བ་འདེབས་རོགས་ཟེར་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱའི་འཁོར་གཡོག་རྣམས་ཡེ་ཤ་ཡཱའི་དྲུང་དུ་སླེབས་པའི་ཚེ།"]},{"type":"verse","number":6,"content":["ཡེ་ཤ་ཡཱས་དེ་དག་ལ། ཁྱོད་ཅག་གི་བདག་པོ་ལ་འདི་ལྟར་སྦྲོན་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨ་སུར་རྒྱལ་པོའི་འཁོར་གཡོག་རྣམས་ཀྱིས་བདག་ལ་སྐུར་བ་བཏབ་པའི་གཏམ་ཐོས་ཀྱང་དེ་ལ་མ་འཇིགས་ཤིག"]},{"type":"verse","number":7,"content":["ལྟོས་དང་། བདག་གིས་ཁོའི་ནང་དུ་ཐུགས་ཉིད་ཅིག་འཇུག་སྟེ། ཁོས་འཆལ་གཏམ་ཞིག་ཐོས་ནས་རང་ཡུལ་དུ་ལོག་ཅིང་། བདག་གིས་གནས་དེར་ཁོ་རལ་གྲིའི་འོག་ཏུ་འགྱེལ་བར་བྱེད་ངེས་ཡིན་ཞེས་སྨྲ་དགོས་པར་གསུངས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་རབ་ཤཱ་ཀེ་ཕྱིར་ལོག་པ་ན། ཨ་སུར་རྒྱལ་པོས་ལིབ་ནཱ་དང་དམག་རྒྱག་གིན་ཡོད་པ་དང་ཕྲད་ཅིང་། མ་གཞི་ཁོས་ཨ་སུར་རྒྱལ་པོ་ལཱ་ཀི་སི་ནས་ཆས་ཟིན་པའི་གཏམ་ཐོས་པ་རེད།"]},{"type":"verse","number":9,"content":["ཨ་སུར་རྒྱལ་པོས་གུ་ཤའི་རྒྱལ་པོ་ཐིར་ཧ་ཀཱའི་སྐོར་ནས། ཁོ་ནི་ཁྱོད་དང་འཐབ་འཛིང་བྱེད་དུ་འོང་བཞིན་འདུག་ཅེས་པའི་གཏམ་ཐོས་ཚེ། ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་བང་ཆེན་མངགས་ཏེ་ན་རེ།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཅག་གིས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཧི་ཟི་ཀི་ཡཱ་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཡེ་རུ་སཱ་ལེམ་ནི་ཨ་སུར་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་པར་མི་འགྱུར་ཞེས་ཁྱོད་ཚོས་བློ་བཅོལ་བའི་དཀོན་མཆོག་ལ་ཁྱོད་རང་བསླུ་བར་མ་འཇུག"]},{"type":"verse","number":11,"content":["ཨ་སུར་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཡུལ་ཐམས་ཅད་ལ་ཅི་བྱས་པ་དང་རྩ་ནས་བཅོམ་པ་ཁྱོད་ཀྱིས་ཐོས་ཡོད་པས། ཁྱོད་ལ་ཐར་ས་ཡོད་དམ།"]},{"type":"verse","number":12,"content":["ངའི་ཕ་མེས་རྣམས་ཀྱིས་བཅོམ་པའི་གོ་ཟན་དང་ཧཱ་རན། རེ་ཙེབ། ཐེ་ལཱ་སར་ལ་ཡོད་པའི་ཨེ་དེན་གྱི་མི་རྣམས་བཅས་མི་རིགས་སོ་སོའི་ལྷ་རྣམས་ཀྱིས་ཁོ་ཚོ་བསྐྱབས་སམ།"]},{"type":"verse","number":13,"content":["ཧ་མཱད་ཀྱི་རྒྱལ་པོ་དང་ཨར་ཕད་ཀྱི་རྒྱལ་པོ། སེ་ཕར་ཝ་ཨིམ་གྲོང་ཁྱེར་གྱི་རྒྱལ་པོ། ཧེ་ནཱ་དང་ཨི་ཝཱ་ཡི་རྒྱལ་པོ་བཅས་རྣམས་ད་ལྟ་གང་དུ་ཡོད་དམ་ཞེས་འཕྲིན་བསྐུར་ཏོ། །"]},{"type":"heading","content":["ཧི་ཟི་ཀི་ཡཱས་དཀོན་མཆོག་ལ་གསོལ་བ་བཏབ་པ།"]},{"type":"verse","number":14,"content":["དེ་ཡང་ཧི་ཟི་ཀི་ཡཱས་བང་ཆེན་རྣམས་ཀྱི་ལག་ནས་འབྱོར་བའི་འཕྲིན་ཡིག་དེ་བཀླགས་རྗེས། ཡར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་སོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འཕྲིན་ཡིག་ཁ་ཕྱེས་ཏེ་བཞག་གོ །"]},{"type":"verse","number":15,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་བཞིན་གསོལ་བ་བཏབ་པ་སྟེ།"]},{"type":"verse","number":16,"content":["ཀྱེ་ཀེ་རུབ་རྣམས་ཀྱི་དབུས་སུ་བཞུགས་པའི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ལགས། ཁྱེད་ཉིད་གཅིག་པུ་ས་གཞིའི་རྒྱལ་ཁམས་ཀུན་གྱི་དཀོན་མཆོག་ལགས་ཤིང་། ཁྱེད་ཀྱིས་གནམ་ས་གཉིས་ཀ་བཀོད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་སྙན་གཏད་ནས་གསན་པར་མཛོད་ཅིག ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་སྤྱན་ཟུང་ཕྱེས་ནས་གཟིགས་སུ་གསོལ། སེན་ན་ཧེ་རིབ་ཀྱིས་བང་ཆེན་མངགས་ནས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ལ་དམའ་འབེབས་ཀྱི་ཚིག་སྨྲས་པ་ཐམས་ཅད་གསན་པར་མཛོད་ཅིག"]},{"type":"verse","number":18,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཨ་སུར་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་རྒྱལ་ཁམས་དེ་ཐམས་ཅད་དང་། དེ་དག་གི་ས་ཆ་ཀུན་རྡུལ་དུ་བརླགས་པ་ནི་བདེན་ཏེ།"]},{"type":"verse","number":19,"content":["དེ་དག་གི་ལྷ་རྣམས་མེ་ལ་གཡུགས། ཅི་ལ་ཞེ་ན། དེ་དག་ནི་དཀོན་མཆོག་མ་ཡིན་པར་མིའི་ལག་བཟོས་ཀྱི་ཤིང་སྐུ་དང་རྡོ་སྐུ་ཡིན་པས། ཁོ་ཚོས་དེ་དག་མེད་པར་བཏང་བ་རེད།"]},{"type":"verse","number":20,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ངེད་ཅག་གི་དཀོན་མཆོག་ལགས། ས་གཞིའི་རྒྱལ་ཁམས་ཀུན་གྱིས་ཡ་ཝཱེ་ཁྱེད་ཉིད་གཅིག་པུ་ཡ་ཝཱེ་ཡིན་པ་གསལ་པོར་རྟོགས་པའི་ཕྱིར། ངེད་ཅག་ཨ་སུར་རྒྱལ་པོའི་ལག་ནས་སྐྱོབ་པར་མཛོད་ཅིག་ཅེས་ཞུས་སོ། །"]},{"type":"heading","content":["ཡེ་ཤ་ཡཱ་ཡིས་ཨ་སུར་ཕམ་པར་ལུང་བསྟན་པ།"]},{"type":"verse","number":21,"content":["དེ་ནས་ཨ་མོ་ཟིའི་བུ་ཡེ་ཤ་ཡཱ་ཡིས་ཧི་ཟི་ཀི་ཡཱའི་དྲུང་དུ་མི་ཞིག་མངགས་ཏེ་ན་རེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨ་སུར་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱི་སྐོར་ནས་བདག་ལ་གསོལ་བ་བཏབ་པས།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལ་རྒོལ་ལན་གསུངས་པ་འདི་ལྟར། ཛ་ཡན་བུ་མོ་ན་ཆུང་མས། །ཁྱོད་ལ་བརྙས་ཤིང་ཁྲེལ་རྒོད་བྱས། །ཡེ་རུ་སཱ་ལེམ་བུ་མོ་ཚོས། །ཁྱོད་ཀྱི་རྒྱབ་ནས་མགོ་བོ་གཡུགས། །"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱིས་སུ་ལ་སྨད་ཅིང་སྐུར་བ་བཏབ་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་ཀུ་ཅོ་བསྒྲགས་ནས་མིག་ཟུང་ཡར་བཏེགས་ཏེ་སུ་ལ་རྒོལ་བ་ཡིན་ནམ། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ལ་རྒོལ་བ་ཡིན།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་རང་གི་འཁོར་གཡོག་རྣམས་བརྒྱུད་ནས་གཙོ་བོར་སྨད་ཅིང་ན་རེ། ང་ནི་རང་གི་ཤིང་རྟའི་དཔུང་ཚོགས་དང་མཉམ་དུ་རི་བོ་དག་གི་ཡང་རྩེར་འཛེགས་ཤིང་། ལེ་པཱ་ནོན་གྱི་ཕུགས་སུ་ཕྱིན། དེའི་ཐང་ཤིང་རིང་པོ་རྣམས་དང་གསོམ་ཤིང་གང་བཟང་རྣམས་བཅད་ཅིང་། རྒྱང་ཐག་རིང་བའི་མཐོ་ས་རྣམས་དང་དེའི་ནགས་ཚལ་སྟུག་པོའི་ནང་དུ་ཞུགས་པ་ཡིན།"]},{"type":"verse","number":25,"content":["ངས་དོང་ཆུ་བརྐོས་ནས་ཆུ་འཐུང་ཞིང་། རང་གི་རྐང་མཐིལ་གྱིས་ཨེ་ཅིབ་ཀྱི་གཙང་པོ་ཐམས་ཅད་བསྐམས་སུ་བཅུག་གོ་སྨྲས་བྱུང་ཞེས་པའོ། །"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་གནའ་ནས་བཀོད་སྒྲིག་བྱས་ཤིང་། སྔོན་ནས་འཆར་བཀོད་བཟོས་ཡོད་པ་ཁྱོད་ཀྱིས་མ་ཐོས་སམ། ད་ནི་ཁྱོད་ཀྱི་ལྕགས་རིས་བསྐོར་བའི་གྲོང་ཁྱེར་རྣམས་བཤིགས་ནས་ས་རོར་བསྒྱུར་བ་དེ་བདག་གིས་བསྒྲུབས་པ་ཡིན།"]},{"type":"verse","number":27,"content":["དེ་བས་ཡུལ་དེའི་མི་རྣམས་ནི་སྟོབས་ཟད་ནས་སྐྲག་ཅིང་ཞེ་གནོང་སྟེ། ཞིང་ཁའི་སྔོ་ཚལ་དང་རྩྭ་སྔོན་བཞིན་དང་། ཡང་ཡར་མ་སྐྱེ་སྔོན་ལ་སྐམ་ཐག་ཆོད་པའི་ཁང་ཐོག་གི་རྩྭ་བཞིན་ནོ། །"]},{"type":"verse","number":28,"content":["ཁྱོད་རང་མར་སྡོད་པ་དང་། ཁྱོད་རང་ཕྱི་ནང་དུ་འགྲོ་འོང་བྱེད་པ། ཁྱོད་རང་ང་ལ་རབ་ཏུ་ཁྲོས་པ་སོགས་ངས་ཤེས་ཡོད།"]},{"type":"verse","number":29,"content":["ཁྱོད་རང་ང་ལ་རབ་ཏུ་ཁྲོས་ཤིང་། ཁྱོད་ཀྱི་ཁེངས་རློམ་བདག་གི་རྣ་བས་ཐོས་བྱུང་བས། བདག་གིས་ཁྱོད་ཀྱི་སྣ་རུ་ལྕགས་ཀྱུ་བསྐོན་ཞིང་། ཁྱོད་ཀྱི་ཁ་ལ་སྲབ་བསྐོན་ཏེ། ཁྱོད་རང་ཐོན་པའི་ལམ་དེར་ཕྱིར་ཟློག་ཏུ་འཇུག་གོ །"]},{"type":"verse","number":30,"content":["ཀྱེ་ཧི་ཟི་ཀི་ཡཱ། འདི་ནི་ཁྱོད་ཀྱི་སྔ་ལྟས་ཡིན་ཏེ། ལོ་འདིར་ཁྱོད་ཅག་གིས་རང་བཞིན་དུ་སྐྱེ་བ་རྣམས་བཟའ་ཞིང་། ལོ་རྗེས་མར་དེ་ལས་སྐྱེ་བ་རྣམས་བཟའ་དགོས། དེ་ནས་ལོ་གསུམ་པར་ཁྱོད་རྣམས་ཀྱིས་ས་བོན་བཏབ་ནས་འབྲུ་རིགས་བསྡུ་བ་དང་། རྒུན་ཚལ་བཙུགས་ནས་དེའི་འབྲས་བུ་བཟའ་དགོས།"]},{"type":"verse","number":31,"content":["ཡ་ཧུ་དཱ་ཁྱིམ་རྒྱུད་ཀྱི་ཤུལ་ལུས་རྣམས་ནི་སླར་ཡང་རྩ་བ་ཟུག་ཅིང་སྟེང་དུ་འབྲས་བུ་ཐོགས་པར་འགྱུར།"]},{"type":"verse","number":32,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ལྷག་ལུས་རྣམས་ཡེ་རུ་སཱ་ལེམ་ནས་ཕྱི་རུ་ཐོན་ཞིང་། སྲོག་ཐར་བ་རྣམས་རི་བོ་ཛ་ཡན་ནས་ཕྱི་ལ་སླེབ་པར་འགྱུར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་འཁྲེན་གྱིས་དེ་ལྟར་མཛད་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":33,"content":["དེའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་སུར་རྒྱལ་པོའི་སྐོར་ལ་འདི་སྐད་དུ། ཁོ་རང་གྲོང་ཁྱེར་འདིར་འོང་བར་མི་འགྱུར་ཞིང་། དེ་གར་མདའ་ཡང་འཕེན་པར་མི་འགྱུར། ཕུབ་ཐོགས་ནས་དེའི་ཕྱོགས་སུ་འོང་བར་མི་འགྱུར་ལ། དེའི་མཐའ་རུ་འཐབ་ར་ཡང་བརྩིག་པར་མི་འགྱུར།"]},{"type":"verse","number":34,"content":["ཁོ་སྔར་འོངས་པའི་ལམ་དེ་ནས་ཕྱིར་ལོག་འགྲོ་བ་དང་། གྲོང་ཁྱེར་དེའི་ནང་དུ་འོང་བར་མི་འགྱུར་བ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":35,"content":["བདག་གིས་རང་ཉིད་དང་བདག་གི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་དོན་དུ། གྲོང་ཁྱེར་འདི་བསྲུང་ཞིང་སྐྱོབ་པར་འགྱུར་གསུངས་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གིས་ཨ་སུར་རྒྱལ་པོར་ཉེས་ཆད་བཅད་པ།"]},{"type":"verse","number":36,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཕྱི་རུ་ཐོན་ཏེ། ཨ་སུར་པའི་དམག་སྒར་ལས་མི་ཆིག་འབུམ་བརྒྱད་ཁྲི་ལྔ་སྟོང་བསད་པ་དང་། ཐོ་རངས་མི་རྣམས་མལ་ལས་ལངས་པའི་ཚེ། ཀྱེ་ཧོ། མིག་གིས་མཐོང་ཚད་བམ་རོ་ཡིན་ནོ། །"]},{"type":"verse","number":37,"content":["དེར་ཨ་སུར་རྒྱལ་པོ་སེན་ན་ཧེ་རིབ་ཀྱིས་སྒར་གཏོར་ཞིང་རང་ཡུལ་དུ་ལོག་སྟེ་ནིན་ཝེ་ཞེས་པར་བསྡད།"]},{"type":"verse","number":38,"content":["ཁོས་རང་གི་ལྷ་ནིས་རོག་གི་ལྷ་ཁང་དུ་ཕྱག་འཚལ་དུས་སུ། ཁོའི་བུ་ཨད་རམ་མེ་ལེག་དང་སཱར་ཨེ་ཚེར་གཉིས་ཀྱིས་ཁོ་རལ་གྲིས་བསད་ཅིང་། དེ་ནས་ཁོ་གཉིས་ཨ་ར་རད་ཡུལ་དུ་བྲོས་པ་དང་། ཁོའི་བུ་ཨེ་སར་ཧད་ཏོན་ཁོའི་རྒྱུན་མཐུད་ནས་རྒྱལ་པོར་གྱུར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/36.json","previousChapterAudioLinks":{},"numberOfVerses":38}