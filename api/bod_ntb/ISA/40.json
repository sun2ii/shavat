{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་སེམས་གསོ།"]},{"type":"verse","number":1,"content":["ཁྱོད་རྣམས་ཀྱིས་སེམས་གསོ་བྱོས་ཤིག བདག་གི་མི་སྡེ་ལ་སེམས་གསོ་བྱོས་ཤིག་ཅེས་ཁྱོད་ཚོའི་དཀོན་མཆོག་གིས་གསུངས།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་ལ་གཏམ་འཇམ་པོ་བཤད་ནས་དེ་ལ། ཁོ་ཚོའི་དཀའ་སྡུག་རྫོགས་ཤིང་། ཁོ་ཚོའི་སྡིག་པའི་བླུ་རིན་འཇལ་ཏོ། །ཁོ་ཚོར་རང་གི་སྡིག་པ་ཐམས་ཅད་ཀྱི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ནས་ཆད་པ་ལྡབ་འགྱུར་གྱིས་བབས་སོ་ཞེས་སྒྲོགས་ཤིག"]},{"type":"verse","number":3,"content":["དེ་ནས་སྐད་སྒྲ་ཞིག་གིས་འདི་ལྟར་འབོད་བཞིན་འདུག དབེན་སྟོང་ཡུལ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ། །ཕེབས་ལམ་སྟ་གོན་བྱེད་ཅིང་བྱེ་ཐང་དུ། །རང་ཅག་དཀོན་མཆོག་གཤེགས་ལམ་དྲང་པོར་བཟོས། །"]},{"type":"verse","number":4,"content":["གྲོག་རོང་ཐམས་ཅད་འགེང་བར་བྱེད་པ་དང་། །རི་སྒང་མཐའ་དག་སྙོམས་པར་གཏོང་ངེས་ལ། །གཡང་གཟར་ཐམས་ཅད་བདེ་སྙོམ་དུ་བཟོ་ཞིང་། །ཀྱག་ཀྱོག་རྣམས་ནི་ཐང་བདེ་རུ་མཛད་ངེས། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་མངོན་འགྱུར་ཞིང་། །སྐྱེ་བོ་ཀུན་གྱིས་ལྷན་ཅིག་མཐོང་བར་འགྱུར། །འདི་བཞིན་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་སྒྲ་ཞིག་གིས་ཁྱོད་ཀྱིས་སྐད་རྒྱོབ་ཅིག་ཅེས་པ་ན། ཁོས་བདག་གིས་ཅི་ཞིག་སྒྲོག་གམ་ཞེས་དྲིས་པ་དང་། ལུས་ཅན་ཐམས་ཅད་རྩྭ་དང་འདྲ། །མཛེས་སྡུག་སྤང་གི་མེ་ཏོག་འདྲ། །"]},{"type":"verse","number":7,"content":["རྩྭ་ནི་སྐམ་ཞིང་མེ་ཏོག་ཡལ། །ཡ་ཝཱེས་ཞལ་ཕུ་བཏབ་པས་ན། །ལུས་ཅན་ཐམས་ཅད་རྩྭ་དང་འདྲ། །"]},{"type":"verse","number":8,"content":["རྩྭ་ནི་སྐམ་ཞིང་མེ་ཏོག་ཡལ། །རང་ཅག་དཀོན་མཆོག་ཉིད་ཀྱི་བཀའ། །རྒྱུན་ནས་རྒྱུན་དུ་གནས་པ་ཡིན། །ཞེས་པའོ། །"]},{"type":"verse","number":9,"content":["ཡང་ཀྱེ་ཛ་ཡན་ལ་འཕྲིན་བཟང་སྐྱེལ་མཁན་ཁྱོད། རི་མཐོན་པོར་འཛེགས་པར་གྱིས། ཀྱེ་ཡེ་རུ་སཱ་ལེམ་ལ་ལོན་བཟང་སྐྱེལ་མཁན་ཁྱོད་ཀྱིས་ཅི་ལྕོགས་ཀྱིས་སྐད་མཐོན་པོ་གྱིས་ཤིག འཇིགས་པ་མེད་པར་སྐད་མཐོན་པོ་གྱིས་ཤིག ལྟོས་དང་འདི་ནི་ཁྱོད་ཀྱི་དཀོན་མཆོག་ལགས་སོ་ཞེས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ཀུན་ལ་སྒྲོགས་ཤིག"]},{"type":"verse","number":10,"content":["ལྟོས་དང་། གཙོ་བོ་ཡ་ཝཱེ་མཐུ་སྟོབས་དང་བཅས་ཕེབས་ངེས་ཤིང་། ཁོང་གི་ཕྱག་གིས་ཉིད་ཀྱི་ཕྱིར་དུ་དབང་སྒྱུར་ཏོ། །ལྟོས་དང་། ཁོང་གིས་མི་རྣམས་ལ་གནང་བའི་གསོལ་རས་ཁོང་གི་རྩར་གནས་ཤིང་། ཁོང་གི་ཐོབ་ཆ་ཉིད་ཀྱི་དྲུང་དུ་ཡོད།"]},{"type":"verse","number":11,"content":["ཁོང་ཉིད་རྫི་བོ་ཞིག་དང་མཚུངས་པར་རང་གི་ལུག་ཁྱུ་འཚོ་སྐྱོང་ལེགས་པོ་བྱེད་པ་དང་། ལུ་གུ་རྣམས་ཕྱག་གིས་པང་དུ་བསྣམས་ནས་མ་མོ་རྣམས་ལ་དལ་གྱིས་ལམ་སྟོན་མཛད་དོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་བླ་ན་མེད་པ་ལགས།"]},{"type":"verse","number":12,"content":["སུས་རྒྱ་མཚོའི་ཆུ་ཡི་ཚད་ནི་ལག་མཐིལ་གྱིས་འཇལ་ཞིང་། ལག་པས་ནམ་མཁའི་མཐོ་ཚད་བཅལ་བ་ཡིན་ནམ། སུས་ས་གཞིའི་རྡུལ་གྲངས་བྲེ་ལ་འཇལ་ཞིང་། རི་མཐོན་པོ་རྣམས་སྲང་དང་རི་ཕྲན་རྣམས་རྒྱ་མར་བཏེགས་པ་ཡིན་ནམ།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཉིད་སུས་དཔོག་ནུས་སམ། ཡང་ན་སུ་ཞིག་གིས་ཁོང་ལ་སློབ་སྟོན་བྱས་པ་ཡིན་ནམ།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་སུ་ལ་གྲོས་བཏབ་ནས་ཁོང་ལ་སུ་ཡིས་བློ་གྲོས་བསྩལ་ཏམ། སུས་ཁོང་ལ་དྲང་པོའི་ལམ་བསྟན་ཅིང་ཤེས་བྱ་བསླབས་ཏེ་བློ་སྒོ་ཕྱེས་སམ།"]},{"type":"verse","number":15,"content":["ལྟོས་དང་། མི་རིགས་ཀུན་ནི་ཟོ་བ་ནང་གི་ཆུ་ཐིགས་ཙམ་དང་རྒྱ་སྲང་གི་རྡུལ་ཕྲན་ཙམ་ཡིན། ལྟོས་དང་། ཁོང་གིས་གླིང་ཕྲན་རྣམས་རྡུལ་ཕྲ་མོ་བཞིན་ཡར་འགྱོག་པའོ། །"]},{"type":"verse","number":16,"content":["ཐ་ན་ལེ་པཱ་ནོན་གྱི་ནགས་ཚལ་ནི་བུད་ཤིང་ལ་མི་འདང་ཞིང་། དེའི་ནང་གི་རི་དྭགས་རྣམས་ཀྱང་སྦྱིན་སྲེག་གི་མཆོད་པར་འདང་བ་མིན།"]},{"type":"verse","number":17,"content":["ཁོང་གི་སྤྱན་སྔར་མི་རིགས་ཐམས་ཅད་ཅི་ཡང་མིན་པར་སྣང་ཞིང་། ཁོང་གི་ཐུགས་སུ་དེ་རྣམས་སྟོང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["དེས་ན་ཁྱོད་ཚོས་སུ་ཞིག་དཀོན་མཆོག་དང་བསྡུར་བར་བྱའམ། ཁྱོད་ཚོས་གཟུགས་བརྙན་ཇི་ལྟ་བུ་ཞིག་གིས་ཁོང་དང་བསྡུར་རམ།"]},{"type":"verse","number":19,"content":["སྐུ་འདྲར་མཚོན་ན་དེ་ནི་བཟོ་པས་བླུགས་ཏེ། མགར་པས་དེ་གསེར་གྱིས་བཏུམས་ནས་དངུལ་གྱི་ཉག་ཐག་བཟོ་བའོ། །"]},{"type":"verse","number":20,"content":["མཆོད་པ་དེ་འདྲ་འབུལ་མི་ནུས་པའི་དབུལ་ཕོངས་རྣམས་ཀྱིས་རུལ་རྒྱུ་མེད་པའི་ཤིང་བདམས་ཏེ། རང་ལ་ལག་ཤེས་པ་ཞིག་བཙལ་ནས་གཡོ་བ་མེད་པའི་སྐུ་འདྲ་བཟོ་བའོ། །"]},{"type":"verse","number":21,"content":["ཁྱོད་ཅག་གིས་མ་ཤེས་མ་ཐོས་སམ། གཏམ་འདི་དང་པོ་ནས་ཁྱོད་རྣམས་ལ་སྨྲས་པ་མ་ཡིན་ནམ། ས་གཞིའི་རྨང་བཙུགས་པའི་ཚུན་ལ་ཁྱོད་ཅག་གིས་ད་དུང་རྟོགས་པར་མ་གྱུར་རམ།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཁོང་ཉིད་ས་གཞིའི་དཀྱིལ་འཁོར་གྱི་ཡང་སྟེང་དུ་བཞུགས་ཤིང་། ས་སྟེང་གི་ཡུལ་མི་རྣམས་ནི་འབུ་ཆ་ག་པ་དང་མཚུངས། ཁོང་གིས་ནམ་མཁའི་དབྱིངས་རྣམས་གནམ་ཡོལ་ལྟར་འདིང་བ་དང་། དེ་རྣམས་སྡོད་གནས་སུ་རུང་བའི་གུར་བཞིན་རྐྱོང་བ་ཡིན།"]},{"type":"verse","number":23,"content":["ཁོང་གིས་རྒྱལ་སྲས་རྣམས་ཅི་ཡང་མིན་པ་དང་ས་གཞིའི་ཁྲིམས་དཔོན་རྣམས་ཀྱང་སྙིང་པོ་མེད་པར་མཛད།"]},{"type":"verse","number":24,"content":["དེ་དག་ས་རུ་བཙུགས་ཤིང་བཏབ་པ་ཙམ་དང་། དེ་དག་གི་རྩ་བ་ས་འོག་ཏུ་ཟུག་པ་ཙམ་དུ། ཁོང་གིས་ཞལ་ཕུ་འདེབས་དུས་དེ་དག་སྐམ་ཞིང་། རླུང་འཚུབ་ཀྱིས་དེ་རྣམས་སོག་མ་ཇི་བཞིན་འཁུར་འགྲོ་བའོ། །"]},{"type":"verse","number":25,"content":["དམ་པ་ཉིད་ཀྱིས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་སུ་ཞིག་ང་དང་བསྡུར་བར་བྱའམ། ཡང་ན་བདག་ལ་འགྲན་ཟླ་སུ་ཞིག་ཡོད་དམ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":26,"content":["ཁྱོད་ཚོས་མགོ་ཡར་ཁྱོག་ལ་ནམ་མཁར་ལྟོས་དང་། སྐར་ཚོགས་འདི་ཐམས་ཅད་སུས་བཀོད་པ་ཡིན་ནམ། སུས་གྲངས་ཀ་བཞིན་དེ་རྣམས་ཕྱིར་ཁྲིད་འོངས་ནས་རེ་རེ་བཞིན་མིང་ནས་ཞལ་འབོད་གནང་ངམ། ཁོང་ལ་དབང་དང་མཐུ་སྟོབས་ཆེན་པོ་མངའ་བས་གཅིག་ཀྱང་མ་ལུས་སོ། །"]},{"type":"verse","number":27,"content":["ཀྱེ་ཡ་ཀོབ། ཁྱོད་ཀྱིས་ངའི་བགྲོད་ལམ་དཀོན་མཆོག་ཡ་ཝཱེས་མི་མཁྱེན་ཞེས་བརྗོད་དོན་ཅི་ཡིན་ནམ། ཀྱེ་ཡེས་ར་ཨེལ། ཁྱོད་ཀྱིས་ངའི་གྱོད་གཞི་ལ་དཀོན་མཆོག་གིས་མི་གཟིགས་ཞེས་འཁང་ར་བྱེད་དོན་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":28,"content":["ཁྱོད་ཀྱིས་མི་ཤེས་ཤིང་ཐོས་ཀྱང་མ་མྱོང་ངམ། གཏན་གནས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ། ས་གཞི་ཡོངས་ཀྱི་བྱེད་པོ་ཁོང་ཉིད་ནམ་ཡང་མི་ཆད་མི་དུབ་ཅིང་། ཁོང་གི་མཁྱེན་རྒྱ་དཔག་ཏུ་མེད་དོ། །"]},{"type":"verse","number":29,"content":["ཉམ་ཐག་རྣམས་ལ་ཁོང་གིས་སྟོབས་ཤུགས་སྦྱིན་ཞིང་། ཟུངས་ཤོར་བའི་མི་ལ་ཁོང་གིས་ནུས་པ་གནང་།"]},{"type":"verse","number":30,"content":["ན་གཞོན་ཡིན་ཡང་ཉམ་ཐག་ཅིང་ངལ་དུབ་འབྱུང་ངེས་ལ། དར་མ་ཡིན་ཡང་གཞི་ནས་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེར་རེ་སྒུག་བྱེད་མཁན་རྣམས་ལ་ཡང་བསྐྱར་སྟོབས་ཤུགས་འཛོམ་ངེས་ཡིན། ཁོ་ཚོས་གླག་བཞིན་གཤོག་པ་བརྐྱངས་ནས་ནམ་འཕང་གཅོད་ཅིང་། དེ་དག་མཆོང་རྒྱུག་བྱས་ཀྱང་ཐང་མི་ཆད་ལ། བགྲོད་ཀྱང་ངལ་བར་མི་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}