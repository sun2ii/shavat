{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་བདམས་པའི་ཡེས་ར་ཨེལ།"]},{"type":"verse","number":1,"content":["ཀྱེ་བདག་གི་ཞབས་ཕྱི་ཡ་ཀོབ། བདག་གིས་བདམས་པའི་ཡེས་ར་ཨེལ། ད་ལྟ་འདི་ལ་ཉོན་ཅིག"]},{"type":"verse","number":2,"content":["ཁྱོད་མཛད་ཅིང་མངལ་དུ་འགོད་མཁན་དང་ཁྱོད་རང་སྐྱོབ་མཁན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་བདག་གི་ཞབས་ཕྱི་ཡ་ཀོབ། བདག་གིས་བདམས་པའི་ཡེ་ཤུ་རུན་ཁྱོད་མ་འཇིགས་ཤིག"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྐོམ་པས་མནར་བའི་ས་ལ་བདག་གིས་ཆུ་འདྲེན་ཞིང་། སྐམ་སར་གཙང་པོ་བཞུར་དུ་འཇུག བདག་གིས་རང་གི་སེམས་ཉིད་ཁྱོད་ཀྱི་བུ་རྒྱུད་སྟེང་འབབ་ཏུ་འཇུག་ཅིང་། བདག་གི་བྱིན་རླབས་ཁྱོད་ཀྱི་བུ་རྒྱུད་ལ་གནང་བར་བྱ།"]},{"type":"verse","number":4,"content":["དེ་དག་རྩྭ་གསེང་ནས་སྐྱེས་པ་དང་ཆུ་ཕྲན་འགྲམ་གྱི་ལྕང་མ་ཇི་བཞིན་ནོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་མི་འདིས་ན་རེ། ང་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པ་ཡིན་ཞེས་དང་། དེས་ཀྱང་རང་ལ་ཡ་ཀོབ་ཀྱི་མིང་ནས་འབོད་ཅིང་། ཡང་མི་གཞན་ཞིག་གིས་དངོས་སུ་ང་རང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པ་ཡིན་ཞེས་ཡི་གེར་འགོད་ལ། ཡེས་ར་ཨེལ་གྱི་མཚན་ནས་རང་ལ་མིང་འདོགས་པར་འགྱུར།"]},{"type":"verse","number":6,"content":["ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ། ཡེས་ར་ཨེལ་གྱི་གཙོ་བོ་སྐྱབས་མགོན། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་ནི་ཐོག་མ་ཉིད་དེ་མཐའ་མ་ཡང་ཡིན་པས། བདག་ལས་དཀོན་མཆོག་གཞན་ཞིག་མེད།"]},{"type":"verse","number":7,"content":["བདག་དང་འདྲ་བ་སུ་ཞིག་ཡོད་དམ། དེ་ལ་བསྒྲག་ཏུ་ཆུག དེ་ལ་བཤད་དུ་ཆུག དེ་ལ་བདག་གི་མདུན་ནས་གསལ་པོར་མངོན་དུ་ཆུག གནའ་དུས་ཀྱི་མི་སྡེ་བདག་གིས་བདམས་ཤིང་བཀོད་པ་ནས་བཟུང་མ་འོངས་པའི་དོན་དང་འབྱུང་བར་འགྱུར་བའི་དོན་རྣམས་ཁོ་ཚོར་གསལ་བསྒྲགས་བྱེད་དུ་ཆུག"]},{"type":"verse","number":8,"content":["ཁྱོད་རྣམས་དངངས་ཤིང་སྐྲག་མི་དགོས། བདག་གིས་སྔར་ནས་དེ་ཁྱོད་ཅག་གི་རྣ་ལ་བཞག་ཅིང་ཁྱོད་རྣམས་ལ་བརྗོད་པ་མ་ཡིན་ནམ། ཁྱོད་ཅག་ནི་བདག་གི་དཔང་པོ་ཡིན། བདག་ལས་དཀོན་མཆོག་གཞན་ཞིག་ཡོད་དམ། ཡང་ན་བྲག་རི་གཞན་ཞིག་ཡོད་དམ། བདག་གིས་གཅིག་ཀྱང་མི་ཤེས་སོ། །"]},{"type":"heading","content":["སྐུ་འདྲ་བཟོ་མཁན་བླུན་རྨོངས་ཡིན་པ།"]},{"type":"verse","number":9,"content":["སྐུ་འདྲ་བཟོ་མཁན་ཐམས་ཅད་སྙིང་པོ་མེད། ཁོ་ཚོ་དགའ་ཞིང་མོས་པ་རྣམས་ལ་ཕན་ཐོགས་མེད། ཁོ་ཚོའི་དཔང་པོས་གང་ཡང་མི་མཐོང་ཞིང་ཅི་ཡང་མི་ཤེས་པས་ཐ་ན་ཁོ་ཚོ་ངོ་ཚར་གཏོད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["སུས་ལྷ་སྐུ་བཟོ་ཞིང་སྐུ་འདྲ་བླུག་པ་ནི་ཕན་ཐོགས་པའི་ཕྱིར་མ་ཡིན་ནམ།"]},{"type":"verse","number":11,"content":["ལྟོས་དང་། ཁོའི་ལས་གྲོགས་ཐམས་ཅད་ཁ་སྐྱེངས་པར་འགྱུར་ཏེ། ལག་ཤེས་པ་རྣམས་ཀྱང་མི་ལས་གང་ཡང་མ་ཡིན། དེ་དག་ཐམས་ཅད་ལྷན་དུ་འཛོམས་ནས་འགྲེང་དུ་ཆུག་དང་། དེ་དག་མཉམ་གཅིག་ཏུ་སྐྲག་ཅིང་ངོ་ཚར་གཏོད་པར་བྱའོ། །"]},{"type":"verse","number":12,"content":["མགར་བས་ཐོག་མར་སོལ་བའི་སྟེང་དུ་ལྕགས་ངར་བ་དང་། དེ་ནས་ལག་ཆས་ལྕགས་བརྡུང་བར་བྱ་ཞིང་། ཁོས་ལག་པའི་ཤེད་ཤུགས་ལ་བརྟེན་ནས་ཐོ་བས་ལྕགས་རྡུང་ཞིང་དབྱིབས་བཟོ་བར་བྱེད། ཁོ་རང་ལྟོགས་ན་སྟོབས་ཤུགས་ཟད་ཅིང་། ཆུ་མ་འཐུང་ན་ཉམ་ཐག་པར་འགྱུར།"]},{"type":"verse","number":13,"content":["མི་དང་འདྲ་བར་མཛེས་སྡུག་གི་གཟུགས་བརྙན་ལྡན་པ་དང་། དགོན་པའི་ནང་དུ་འཇོག་ཕྱིར་ཤིང་བཟོས་ཐིག་སྐུད་འཐེན་ནས་སྨྱུ་གུས་སྐྱ་རིས་ཕབ་སྟེ་ཤིང་གཞོག་གིས་འཇམ་པོར་བཟོ་བ་དང་། སྒོར་ཐིག་རྒྱག་ཆས་ཀྱིས་དབྱིབས་བྲིས་ཏེ་མིའི་རྣམ་པ་དང་འདྲ་བའི་སྐུ་འདྲ་བཟོ་བའོ། །"]},{"type":"verse","number":14,"content":["ཁོས་རང་ཉིད་ཀྱི་ཕྱིར་དུ་ཐང་ཤིང་གཅོད་ཅིང་། ཡང་ན་ཡོ་འབོག་དང་བེ་ཤིང་བདམས་ཏེ་ནགས་ཚལ་ཁྲོད་དུ་སྐྱེ་རུ་འཇུག དེས་གསོམ་པ་ཡང་བཙུགས་ནས་ཆར་ཆུ་ལ་དེ་ཆེར་བསྐྱེད་དུ་འཇུག"]},{"type":"verse","number":15,"content":["མི་ཡིས་དེ་འབུད་ཤིང་བྱེད་ཆོག་ལ། བླངས་ནས་མེ་བུས་ཏེ་དྲོད་ལེན་པ་དང་། ཡང་མེ་སྦར་ནས་བག་ལེབ་བསྲེག་ཆོག ཡིན་ཡང་མི་ཡིས་དེ་བཀོལ་ནས་ལྷ་སྐུ་བཞེང་བ་དང་དེ་ལ་བསྙེན་བཀུར་ཞུ་ཞིང་། སྐུ་འདྲ་བརྐོས་ཏེ་དེ་ལ་ཕྱག་འཚལ་བའོ། །"]},{"type":"verse","number":16,"content":["དེས་ཤིང་ཆའི་ཆ་ཤས་མེ་ལ་སྦར་ཏེ་སྟེང་དུ་ཤ་སྲེག་པ་དང་། སྲེག་ཤ་ཟ་ཞིང་འགྲང་བར་བྱེད། དེ་ནས་རང་ཉིད་མེ་ལ་བསྲོས་ཏེ་ན་རེ། ང་དྲོན་པོ་ཡིན། ངས་མེ་མཐོང་བྱུང་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":17,"content":["ཤིང་གི་ལྷག་མ་ལས་རང་ལ་ལྷ་སྐུ་ཞིག་བཟོ་ཞིང་། དེ་ནི་རང་གིས་བརྐོས་པའི་སྐུ་འདྲ་སྟེ། ཁོས་སྐུ་འདྲ་དེ་ལ་ཕྱག་བཙལ་ནས་བསྙེན་བཀུར་ཞུ་ཞིང་། ཡང་དེ་ལ་གསོལ་བ་བཏབ་ནས་ན་རེ། ཁྱེད་ནི་ངའི་དཀོན་མཆོག་ཡིན་པས་ཁྱེད་ཀྱིས་ང་རང་སྐྱོབ་པར་མཛོད་ཅེས་ཞུའོ། །"]},{"type":"verse","number":18,"content":["དེ་དག་གིས་དོན་མི་རྟོགས་ལ་ཧ་ཡང་མི་གོ གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་གི་མིག་ཟུང་བསྒྲིབས་པས་མིག་གིས་མི་མཐོང་ལ། དེ་དག་གི་སེམས་བཀབ་པས་རྟོགས་པར་མི་འགྱུར།"]},{"type":"verse","number":19,"content":["སུ་ཞིག་གིས་ཀྱང་སེམས་ཞིབ་མོས་བསམ་བློ་མི་གཏོང་ཞིང་། ཡང་ཤིང་ཆའི་དུམ་བུ་ངས་མེ་ལ་བསྲེགས། སོལ་བའི་སྟེང་དུ་ངས་བག་ལེབ་དང་ཤ་བསྲེགས་ནས་ཟོས། དེའི་ལྷག་མ་རྣམས་ཀྱིས་ངས་ཞེན་ལོག་གི་རྫས་ཤིག་བཟོས་པས། ངས་ཤིང་དུམ་དེ་ལ་ཕྱག་འཚལ་དགོས་སམ་ཞེས་བརྗོད་མཁན་གྱི་མི་ཤེས་རབ་ཅན་དང་བློ་གྲོས་ཅན་ནི་མེད།"]},{"type":"verse","number":20,"content":["ཁོས་བརྩོན་ལེན་བྱེད་པ་ནི་ཐལ་བ་ཡིན། བསླུ་བྲིད་ཐེབས་པའི་སེམས་ཀྱིས་ཁོ་རང་ལམ་ལོག་ཏུ་ཁྲིད་དེ། ཁོས་རང་ཉིད་སྐྱོབ་མི་ནུས་ཤིང་ཡང་ངའི་ལག་གཡས་པའི་ནང་དུ་རྫུན་ཞིག་ཡོད་པ་མ་ཡིན་ནམ་ཞེས་སྨྲ་ཡང་མི་སྲིད་དོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་སྐྱོབ་པར་མཛད་པའི་ཐུགས་རྗེ།"]},{"type":"verse","number":21,"content":["ཀྱེ་ཡ་ཀོབ་དང་ཡེས་ར་ཨེལ། ཁྱོད་ནི་བདག་གི་ཞབས་ཕྱི་ཡིན་པས་གཏམ་འདི་དག་དྲན་པར་གྱིས། བདག་གིས་ཁྱོད་བཀོད་པ་ནི་ཁྱོད་རང་བདག་གི་ཞབས་ཕྱི་བྱེད་པའི་ཕྱིར་ཡིན། ཀྱེ་ཡེས་ར་ཨེལ། བདག་གིས་ཁྱོད་བརྗེད་པར་མི་བྱའོ། །"]},{"type":"verse","number":22,"content":["སྤྲིན་པ་སྟུག་པོ་ཐོར་བ་བཞིན་དུ་ངས་ཁྱོད་ཀྱི་ཉེས་སྐྱོན་རྣམས་བསལ་ཞིང་། སྤྲིན་ཡལ་བ་བཞིན་དུ་ངས་ཁྱོད་ཀྱི་སྡིག་པ་རྣམས་བསལ་བ་ཡིན། ཡང་བདག་གིས་ཁྱོད་རང་བསྐྱབས་པས་ཁྱོད་བདག་གི་ཕྱོགས་སུ་ཕྱིར་ཤོག་ཅིག"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ལྟར་མཛད་པས། ཀྱེ་ནམ་མཁའ་ཡིས་བསྟོད་གླུ་ལོངས་ཤིག ཀྱེ་ས་གཞིའི་གཏིང་རིམ་རྣམས་ཀྱིས་འབོད་སྒྲ་སྒྲོགས་ཤིག ཀྱེ་རི་ཚོགས་རྣམས་ཀྱིས་དགའ་འབོད་གྱིས་ཤིག ནགས་ཚལ་དང་དེའི་ནང་ཡོད་པའི་ལྗོན་ཤིང་གི་ཚོགས་ཀྱིས་ཀྱང་དེ་བཞིན་གྱིས་ཤིག གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཀོབ་བསྐྱབས་ཤིང་། ཁོང་གིས་ཡེས་ར་ཨེལ་བརྒྱུད་དེ་རང་ཉིད་ལ་གཟི་བརྗིད་ཐོབ་པར་མཛད་དོ། །"]},{"type":"verse","number":24,"content":["ཁྱོད་རང་མ་ཡི་མངལ་དུ་བཀོད་ཅིང་། ཁྱོད་རང་སྐྱོབ་མཁན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡ་ཝཱེ་བདག་ནི་ཐམས་ཅད་འགོད་མཁན་ཏེ། བདག་ཁོ་ནས་ནམ་མཁའ་རྒྱ་བསྐྱེད་ཅིང་ས་གཞི་བཏིངས་པ་ཡིན།"]},{"type":"verse","number":25,"content":["བདག་གིས་རྫུན་སྨྲ་མཁན་གྱི་རྟགས་མཚན་རྣམས་སྙིང་པོ་མེད་པར་བྱས་པ་དང་། མོ་པ་རྣམས་བླུན་པོར་བསྒྱུར། མི་བློ་གྲོས་ཅན་རྣམས་ཕྱིར་བསྣུར་སྟེག་ཏུ་བཅུག་ཅིང་། དེ་དག་གི་ཤེས་བྱ་རྣམས་རྨོངས་པར་བསྒྱུར།"]},{"type":"verse","number":26,"content":["བདག་གིས་རང་གི་ཞབས་ཕྱིའི་ཚིག་རྣམས་དོན་ལ་གནས་ཤིང་། བདག་གི་བང་ཆེན་རྣམས་ཀྱི་གྲོས་དོན་འགྲུབ་པར་བྱས། ཡེ་རུ་སཱ་ལེམ་ལ་ཁྱོད་ནང་སྡོད་མཁན་ཡོད་པར་འགྱུར་ཞེས་དང་། ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་དག་ལ་ཁྱོད་རྣམས་ཡང་བསྐྱར་འཛུགས་པར་འགྱུར། དེའི་ཞིག་རོ་རྣམས་ཡར་བསླང་བར་བྱའོ་ཞེས་བདག་གིས་བརྗོད་དོ། །"]},{"type":"verse","number":27,"content":["བདག་གིས་གཏིང་ཟབ་པའི་རྒྱ་མཚོ་ལ་ཁྱོད་སྐམ་པར་གྱུར་ཅིག ངས་ཁྱོད་ཀྱི་གཙང་པོ་རྣམས་ཀྱང་སྐམ་དུ་འཇུག་ངེས་ཡིན་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":28,"content":["བདག་གིས་ཀོ་རེས་ལ། བདག་གི་རྫི་བོ་ཁོང་གིས་བདག་ཡིད་མོས་པ་ཐམས་ཅད་བསྒྲུབ་པར་འགྱུར་ཞེས་བརྗོད་ཅིང་། ཡང་དེས་ཡེ་རུ་སཱ་ལེམ་ལ་ན་རེ། ཁྱོད་ཡང་བསྐྱར་འཛུགས་པར་འགྱུར་ཞེས་སྨྲ་ཞིང་། དེས་མཆོད་ཁང་ལ་ན་རེ། ཁྱོད་ཀྱི་རྩིག་རྨང་འདིང་དགོས་ཞེས་སྨྲའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}