{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["རྒྱལ་པོ་ཀོ་རེས་དཀོན་མཆོག་གི་ལག་ཆར་སྤྱད་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་བདག་གིས་སྣུམ་གྱིས་བྱུགས་པའི་ཀོ་རེས་ལ་མཚོན་ན། རྒྱལ་ཕྲན་རྣམས་ཁོས་དབང་དུ་བསྡུ་བའི་ཕྱིར། བདག་གིས་ཁོའི་ལག་གཡས་པ་ནས་དམ་པོར་བཟུང་སྟེ། ཁོའི་སྔོན་དུ་མཁར་སྒོ་ཕྱེ་བ་དང་། མཁར་སྒོ་དེ་དག་མི་རྒྱག་པའི་ཆེད་དུ། བདག་གིས་རྒྱལ་པོ་དག་གི་རྐེད་འཆིང་ལྷོད་དུ་འཇུག་པ་ཡིན།",{"noteId":19}]},{"type":"verse","number":2,"content":["བདག་ཁྱོད་ཀྱི་སྔོན་དུ་སོང་ནས་ལམ་མི་བདེ་བ་རྣམས་སྙོམས་པར་བྱེད། ཟངས་ཀྱི་རྒྱ་སྒོ་རྣམས་བདག་གིས་སིལ་བུར་གཅོག་ཅིང་། ལྕགས་ཀྱི་སྒོ་གཏན་རྣམས་བདག་གིས་དུམ་བུར་གཅོད་ངེས་ཡིན།"]},{"type":"verse","number":3,"content":["བདག་གིས་ཁྱོད་ལ་ཡིབ་པའི་གཏེར་མཛོད་རྣམས་དང་། གསང་བའི་གནས་ཀྱི་རྒྱུ་ནོར་རྣམས་སྦྱིན་པར་བྱ། དེ་ནས་ཁྱོད་ཀྱིས་བདག་ནི་ཁྱོད་ཀྱི་མིང་ནས་འབོད་མཁན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["བདག་གི་ཞབས་ཕྱི་ཡ་ཀོབ་དང་། བདག་གིས་བདམས་པའི་ཡེས་ར་ཨེལ་གྱི་དབང་གིས། བདག་གིས་ཁྱོད་ཀྱི་མིང་ནས་བོས་པ་ཡིན། ཁྱོད་ཀྱིས་བདག་སུ་ཡིན་པ་མི་ཤེས་ཀྱང་ངས་ཁྱོད་ལ་གཟི་བརྗིད་ཀྱི་མཚན་གནང་ཡོད།"]},{"type":"verse","number":5,"content":["བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་དང་བདག་ལས་དཀོན་མཆོག་གཞན་མེད་དེ། ང་མ་གཏོགས་དཀོན་མཆོག་གཞན་ནི་མེད། ཁྱོད་ཀྱིས་བདག་ངོ་མི་ཤེས་ཀྱང་ངས་ཁྱོད་རང་བརྟན་པོར་བྱེད་དེ།"]},{"type":"verse","number":6,"content":["ཉི་མ་ཤར་ས་ནས་ཉི་མ་ནུབ་སའི་བར་གྱི་མི་རྣམས་ཀྱིས་ང་མ་གཏོགས་དཀོན་མཆོག་གཞན་ཞིག་མེད་པ་ཤེས་པའི་ཕྱིར་ཡིན། བདག་ནི་ཡ་ཝཱེ་ཡིན། བདག་ལས་དཀོན་མཆོག་གཞན་སུ་ཡང་མེད།"]},{"type":"verse","number":7,"content":["བདག་གིས་འོད་བཟོས་ནས་མུན་པའང་འགོད། ཞི་བདེ་གནང་ཞིང་བར་ཆད་ཀྱང་བཟོ། དཀོན་མཆོག་ཡ་ཝཱེ་བདག་ནི་དོན་འདི་ཐམས་ཅད་སྒྲུབ་མཁན་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཀྱེ་ནམ་མཁའི་ཚོགས། སྟེང་ཕྱོགས་ནས་དྲང་བདེན་ཕོབས་ཤོག སྤྲིན་པར་དྲང་བདེན་འབེབ་ཏུ་བཅུག ས་གཞིའི་སྒོ་ཕྱེས་ནས་ཐར་པ་སྨིན་གྱུར་ཅིག དེ་དང་མཉམ་དུ་དྲང་བདེན་གྱི་འབྲས་བུ་ཐོགས་གྱུར་ཅིག དོན་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་བདག་གིས་བཀོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["རང་ཉིད་སྐྲུན་མཁན་གྱི་གཙོ་བོ་དང་རྩོད་པ་བྱེད་མཁན་དེར་ཆག་སྒོ་འབྱུང་། དེ་དག་ནི་སའི་རྫ་ལྷེབ་ནང་གི་རྫ་ལྷེབ་ཅིག་ཡིན་ཞིང་། ས་འདམ་གྱིས་རྫ་བཟོ་ལ་ཁྱོད་ཀྱིས་ཅི་ཞིག་བཟོ་བཞིན་ཡོད་ཅེས་འདྲིའམ། ཡང་ན་ཁྱོད་ཀྱིས་བསྐྲུན་པ་དེས་ཁོ་ལ་ལག་པ་མེད་ཅེས་སྨྲ་སྲིད་དམ།"]},{"type":"verse","number":10,"content":["རང་གི་ཕ་ལ་ཁྱེད་ལས་སྐྱེས་པ་ནི་ཅི་ཡིན་ནམ་ཞེས་དང་། ཡང་ན་རང་གི་མ་ལ་ཁྱེད་ཀྱིས་བཙས་པ་ནི་ཅི་ཡིན་ནམ་ཟེར་མཁན་དེར་ཆག་སྒོ་འབྱུང་ངོ་། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དམ་པ། དེ་དག་སྐྲུན་མཁན་ཁོང་གིས་འདི་སྐད་དུ། ཕྱིས་འབྱུང་གི་དོན་རྣམས་ཁྱོད་ཀྱིས་ང་ལ་དྲིས་ཤོག བདག་གི་བུ་ཕྲུག་རྣམས་དང་བདག་གི་ལག་པས་བཀོད་པའི་སྐོར་ནས་ཀྱང་ཁྱོད་ཀྱིས་ང་ལ་བཀའ་བབས་ཆོག"]},{"type":"verse","number":12,"content":["བདག་གིས་ས་གཞི་བསྐྲུན་ཅིང་དེའི་སྟེང་དུ་མིའི་རིགས་བཀོད་པ་ཡིན། བདག་གིས་ནམ་མཁའི་དབྱིངས་རྣམས་བསྐྱེད་ཅིང་། ཡང་དེའི་ཚོགས་ཐམས་ཅད་ལ་བཀའ་བསྩལ་པ་ཡིན།"]},{"type":"verse","number":13,"content":["བདག་གིས་དྲང་བདེན་སྒོ་ནས་ཀོ་རེས་ཡར་བསླངས་ཏེ། ཁོའི་ལམ་ཐམས་ཅད་བདེ་བར་བྱེད་ཅིང་། དེ་ནས་ཁོས་བདག་གི་གྲོང་ཁྱེར་བརྩིག་པར་འགྱུར་ཞིང་། གླ་དང་རྔན་པ་མི་ལེན་པར་ངའི་བཙོན་པ་མི་སྡེ་རྣམས་ལ་རང་དབང་སྦྱིན་ངེས་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡ་ཝཱེ།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཨེ་ཅིབ་ལ་དཀའ་ལས་སྒོ་ནས་ཐོབ་པ་དང་གུ་ཤ་པར་ཐོབ་པའི་རྒྱུ་ནོར། གཟུགས་པོ་མཐོ་ཞིང་ཆེ་བའི་སེ་བཱ་པ་བཅས་ཐམས་ཅད་ཁྱོད་ཀྱི་མདུན་དུ་སླེབས་ནས་དེ་དག་ཁྱོད་ལ་གཏོགས་ཤིང་། དེ་དག་ལྕགས་སྒྲོག་དང་བཅས་འོངས་ནས་ཁྱོད་ཀྱི་རྗེས་སུ་འབྲང་ཞིང་ཁྱོད་ལ་ཕྱག་བཙལ་ནས་ན་རེ། དཀོན་མཆོག་ཁྱོད་ཅག་གི་ཁྲོད་དུ་བཞུགས་པ་དང་། ཁོང་མ་གཏོགས་དཀོན་མཆོག་གཞན་མེད་དེ། དཀོན་མཆོག་བདེན་པ་གཞན་ཞིག་མེད་ཅེས་ཞུ་བར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་སྐྱབས་མགོན་དཀོན་མཆོག་ལགས། ཁྱེད་ནི་དངོས་གནས་རང་ཉིད་སྦས་པའི་དཀོན་མཆོག་དེ་ལགས་སོ། །"]},{"type":"verse","number":16,"content":["ལྷ་སྐུ་བཞེང་མཁན་ཐམས་ཅད་མཉམ་གཅིག་ཏུ་ངོ་ཚར་གཏོད་ཅིང་བརྙས་བཅོས་འཁེལ་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["ཡེས་ར་ཨེལ་ཁོ་ན་དཀོན་མཆོག་ཡ་ཝཱེར་བརྟེན་ནས་ཐར་བར་འགྱུར་ཞིང་། དུས་གཏན་གྱི་ཐར་པ་འཐོབ་པར་འགྱུར། དེ་དག་ཇི་སྲིད་བར་དུ་ངོ་ཚར་མི་གཏོད་ལ་བརྙས་བཅོས་ཀྱང་མི་འཁེལ་ལོ། །"]},{"type":"verse","number":18,"content":["ནམ་མཁའི་དབྱིངས་རྣམས་འགོད་མཁན་ཡ་ཝཱེ་ཁོང་ནི་དཀོན་མཆོག་ལགས་ཤིང་། ཁོང་གིས་ས་གཞི་བཀོད་པས་ས་གཞི་གྲུབ་པ་དང་ས་གཞི་བརྟན་པོར་མཛད། ཁོང་གིས་ས་གཞི་བཀོད་པ་ནི་སྟོང་བར་ལུས་པའི་ཕྱིར་མིན་ལ། མི་རྣམས་དེ་ནང་གནས་པའི་ཕྱིར་ཡིན། ཁོང་གིས་འདི་སྐད་དུ། བདག་ནི་ཡ་ཝཱེ་ཡིན། ང་མ་གཏོགས་དཀོན་མཆོག་གཞན་ཞིག་གཏན་ནས་མེད།"]},{"type":"verse","number":19,"content":["བདག་གིས་མུན་ནག་གི་ས་ནས་གསང་བའི་གཏམ་མ་སྨྲས། ཁྱོད་ཀྱིས་ང་འཚོལ་བ་ནི་དོན་མེད་ཡིན་ཞེས་ཡ་ཀོབ་ཀྱི་བུ་རྒྱུད་ལ་བདག་གིས་མ་སྨྲས། དཀོན་མཆོག་ཡ་ཝཱེ་བདག་གིས་བདེན་པ་གླེང་ཞིང་། ཡང་དག་པ་རྣམས་འཆད་དོ། །"]},{"type":"verse","number":20,"content":["ཀྱེ་རྒྱལ་ཕྲན་ཀུན་ནས་ཐར་བའི་མི་རྣམས། ཁྱོད་ཅག་ལྷན་དུ་འདུས་ནས་ཐག་ཉེ་སར་ཤོག་དང་། ཤིང་གི་ལྷ་སྐུ་རྣམས་ཡར་འགྱོགས་པ་དང་། མི་སྐྱོབ་ནུས་མེད་པའི་ལྷ་ལ་གསོལ་བ་འདེབས་པ་དེ་དག་དངོས་གནས་ཤེས་རྨོངས་ཡིན།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱིས་དོན་རྣམས་ཤོད་དང་རྒྱུ་མཚན་ཐོན་ཅིག དེ་དག་ཕན་ཚུན་གྲོས་མོལ་བྱེད་དུ་ཆུག སུ་ཞིག་གིས་གནའ་བོའི་དུས་ནས་མི་ལ་དོན་འདི་ཐོས་སུ་བཅུག་གམ། སུ་ཞིག་གིས་གནའ་བོའི་དུས་ནས་དོན་འདི་འཆད་པ་ཡིན་ནམ། དེ་བཤད་མཁན་དཀོན་མཆོག་ཡ་ཝཱེ་ང་རང་མ་ཡིན་ནམ། ང་ལས་དཀོན་མཆོག་གཞན་མེད། བདག་ནི་དྲང་བདེན་གྱི་དཀོན་མཆོག་དང་མིའི་རིགས་སྐྱོབ་མཁན་ཡང་ཡིན། བདག་ལས་དཀོན་མཆོག་གཞན་མེད།"]},{"type":"verse","number":22,"content":["བདག་ནི་དཀོན་མཆོག་ཡིན། ང་མ་གཏོགས་དཀོན་མཆོག་གཞན་མེད། དེ་བས་ས་གཞིའི་མི་ཐམས་ཅད་ཀྱེ། བདག་གི་ཕྱོགས་སུ་འཁོར་དང་ཐར་པ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":23,"content":["ངས་རང་ཉིད་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ཞིང་། ངའི་ཁ་ནས་དྲང་བདེན་གྱི་གཏམ་སྨྲས་པ་ཕྱིར་ཟློག་པར་མི་བྱ། དེ་བས་པུས་མོ་ཐམས་ཅད་ཀྱིས་བདག་ལ་ཕྱག་འཚལ་ཞིང་། ལྕེ་ཐམས་ཅད་ཀྱིས་ང་རང་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བར་འགྱུར།"]},{"type":"verse","number":24,"content":["མི་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་འབའ་ཞིག་གི་ནང་དུ་དྲང་བདེན་དང་སྟོབས་ཤུགས་ཡོད་དེ། ཁོང་ལ་སྡང་མཁན་ཐམས་ཅད་ཁོང་གི་དྲུང་དུ་འོངས་ཏེ་ངོ་ཚར་གཏོད་པར་འགྱུར་ཞེས་བརྗོད་ངེས།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྟེན་ནས་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཐམས་ཅད་དྲང་བདེན་དུ་བརྩི་ཞིང་གཟི་བརྗིད་འཐོབ་པར་འགྱུར་རོ། །"]}],"footnotes":[{"noteId":19,"caller":"+","text":"འདིར་རྒྱལ་པོ་དག་གི་རྐེད་འཆིང་ལྷོད་དུ་འཇུག་པ་ཡིན་ཞེས་པ་ནི་རྒྱལ་པོ་དག་ངོ་ཚར་གཏོད་པ་དང་ཕམ་པར་མཛད་པ་ལ་གོ་བ་ཡིན།","reference":{"chapter":45,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}