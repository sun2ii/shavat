{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་དཔལ་གྱིས་ཡེས་ར་ཨེལ་ལེགས་ལམ་དུ་དྲངས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཡེས་ར་ཨེལ་ཞེས་འབོད་པའི་ཡ་ཀོབ་ཀྱི་ཁྱིམ་རྒྱུད། ཡ་ཧུ་དཱའི་ཆུ་རྒྱུན་ལས་བྱུང་བ་",{"noteId":20},"དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་སྒོ་ནས་མནའ་བསྐྱལ་ནའང་བདེན་པ་དང་དྲང་པོ་མ་ཡིན། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གླེང་པ་ཁྱོད་རྣམས་ཀྱིས་གཏམ་འདི་ལ་ཉོན་ཅིག"]},{"type":"verse","number":2,"content":["ཁོ་ཚོས་རང་ཉིད་གྲོང་ཁྱེར་དམ་པའི་མི་རུ་བརྩི་ཞིང་། ཡང་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་སྟེ། མཚན་ལ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཞེས་པར་བརྟེན་པ་ཡིན།"]},{"type":"verse","number":3,"content":["གཙོ་བོས་འདི་སྐད་དུ། སྔོན་གྱི་དོན་རྣམས་བདག་གིས་གནའ་བོའི་དུས་ནས་ལུང་བསྟན་པ་དང་། དེ་དག་ངའི་ཁ་ནས་ཐོན་ཅིང་མི་རྣམས་ལ་བསྒྲགས་ཡོད་དེ། བདག་གིས་གློ་བུར་ཉིད་ལ་བསྒྲུབས་ཤིང་གྲུབ་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཅི་ལ་ཞེ་ན། ཁྱོད་ནི་བློ་གྱོང་པོ་ཡིན་པ་དང་། ཁྱོད་ཀྱི་མཇིང་པའི་ཤ་རྒྱུས་ལྕགས་ལྟར་མཁྲེགས་ཤིང་། ཁྱོད་ཀྱི་ཡ་ཐོད་ར་གན་ཡིན་པ་ངས་སྔར་ནས་ཤེས།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱིས་དོན་དེ་དག་ངའི་ལྷ་སྐུས་བསྒྲུབས་ཤིང་། ངའི་བརྐོས་སྐུ་དང་བླུགས་སྐུ་ཡིས་བསྒོས་པ་ཡིན་ཞེས་མི་གླེང་ཕྱིར། གནའ་བོའི་དུས་ནས་བདག་གིས་ཁྱོད་ལ་བཤད་དེ། དོན་མ་བྱུང་སྔོན་དུ་བདག་གིས་ཁྱོད་ལ་སྨྲས་སོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་ཀྱིས་འདི་དག་ཐམས་ཅད་ཐོས་ཡོད་པས་ད་ནི་དེ་ཀུན་ལ་བསམ་བློ་ཐོངས་ཤིག ཁྱོད་ཀྱིས་དེ་བསྒྲག་པར་མི་བྱའམ། ད་ཕྱིན་ཆད་ངས་ཁྱོད་ལ་དོན་གསར་པ་སྟེ་ཁྱོད་ཀྱིས་མི་ཤེས་པའི་གསང་དོན་རྣམས་སྟོན་པར་བྱ།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཀྱིས་ལྟོས་ཤིག དོན་འདི་དག་ངས་སྔ་མོ་ནས་རྟོགས་ཟིན་ཞེས་མི་བཤད་པའི་ཕྱིར། དོན་དེ་དག་སྔོན་ཆད་ནས་ཡོད་པ་མ་ཡིན་པར་ད་ལྟ་གསར་དུ་བཀོད་པ་ཡིན། དེ་རིང་ཉིན་མོའི་སྔོན་དུ་ཁྱོད་ཀྱིས་ཐོས་མྱོང་མེད།"]},{"type":"verse","number":8,"content":["ཁྱོད་ཀྱིས་ཐོས་མེད་ལ་རྟོགས་ཀྱང་མེད། སྔོན་ཆད་ཁྱོད་ཀྱི་རྣ་བ་ཕྱེས་མེད་པ་ཡིན། དེའི་རྒྱུ་མཚན་ནི་ཁྱོད་ཀྱིས་གཡོ་སྒྱུ་སྤྱོད་པ་ངས་སྔར་ནས་ཤེས་ཏེ། ཁྱོད་རང་མ་སྐྱེས་གོང་ནས་ཁྱོད་ལ་ངོ་ལོག་པ་ཞེས་ཐོགས་སོ། །"]},{"type":"verse","number":9,"content":["ངའི་མིང་གི་ཕྱིར་དུ་ང་སྐབས་སུ་མི་ཁྲོ་ཞིང་། ངའི་མཚན་སྙན་གྱི་ཕྱིར་དུ་ངས་ཁྱོད་ལ་བཟོད་པ་བསྒོམས་ནས་ཁྱོད་རང་ཚར་གཅོད་མི་བྱའོ། །"]},{"type":"verse","number":10,"content":["ལྟོས་ཤིག ངས་ཁྱོད་རང་བཙོ་སྦྱང་བྱས་ཀྱང་དངུལ་བཙོ་སྦྱོང་བྱེད་པ་ལྟར་མ་ཡིན་ཞིང་། བདག་གིས་ཁྱོད་སྡུག་བསྔལ་གྱི་ཚ་ཐབ་ལས་བདམས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["ང་རང་ཉིད་ཀྱི་ཆེད་དུ་ཡིན་ཏེ། ང་རང་ཉིད་ཀྱི་ཆེད་དུ་ངས་དེ་དག་བསྒྲུབ་ངེས་ཡིན། བདག་གི་མིང་ནི་བརྫབ་ག་ལ་རུང་། ངས་རང་ཉིད་ཀྱི་གཟི་བརྗིད་གཞན་ལ་སྟེར་བར་མི་བྱའོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གིས་ཡེས་ར་ཨེལ་བདམས་པ།"]},{"type":"verse","number":12,"content":["ཀྱེ་ཡ་ཀོབ། བདག་གིས་བོས་པའི་ཡེས་ར་ཨེལ། བདག་ལ་ཉོན་དང་། བདག་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ཏེ། ཐོག་མ་ཡིན་ལ་མཐའ་མའང་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["ངའི་ལག་པས་ས་གཞིའི་རྨང་གཞི་བཏིངས་པ་ཡིན་ལ། ངའི་ལག་གཡས་པས་ནམ་མཁའ་རྒྱ་བསྐྱེད་པ་ཡིན། ངས་དེ་དག་འབོད་དུས་དེ་དག་མཉམ་གཅིག་ཏུ་ཡར་འགྲེང་པ་ཡིན།"]},{"type":"verse","number":14,"content":["ཀྱེ་མི་སྡེ་རྣམས། ཁྱོད་ཅག་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་འདུས་ནས་ཉོན་ཅིག དེ་དག་གི་ཁྲོད་ནས་དོན་འདི་ལུང་སྟོན་མཁན་སུ་ཞིག་ཡོད་དམ། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁོ་ལ་བྱམས་པས་ཁོང་གིས་ཉིད་ཀྱི་དགོངས་དོན་ཇི་བཞིན་དུ་པཱ་པེལ་ལོན་ལ་མཛད་ཅིང་། ཁོང་གི་ཕྱག་གིས་ཀལ་དི་པ་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":15,"content":["བདག་གིས་སྨྲས་ཤིང་ཡང་ཁོ་རང་བོས་ཏེ། བདག་གིས་ཁོ་ཁྲིད་འོངས་པ་ཡིན་པས། ཁོས་སྤྱོད་པ་ཐམས་ཅད་འགྲུབ་པར་འགྱུར།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་བདག་གི་ཉེ་སར་ཡོང་ནས་གཏམ་འདི་ལ་ཉོན་ཅིག ཐོག་མ་ཉིད་ནས་ངས་གསང་བའི་གཏམ་སྨྲས་མེད། དོན་འདི་འབྱུང་བའི་དུས་ནས་བཟུང་ང་རང་དེ་རུ་ཡོད་ཅེས་པའོ། །ད་ལྟ་གཙོ་བོ་ཡ་ཝཱེས་ང་དང་ཁོང་གི་ཐུགས་ཉིད་མངགས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་སྐྱོབ་མཁན་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ཀྱིས་འདི་སྐད་དུ། བདག་ནི་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཁྱོད་ལ་ཕན་ཐོགས་པའི་བསླབ་བྱ་གནང་མཁན་དང་། ཁྱོད་ལ་འགྲོ་དགོས་པའི་ལམ་སྟོན་མཁན་གྱི་དཀོན་མཆོག་ཡིན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་བདག་གི་བཀའ་ལ་མཉན་པར་གྱུར་ཅིག དེ་ལྟར་ཁྱོད་ཀྱི་ཞི་བདེ་ནི་གཙང་པོ་བཞུར་བ་དང་འདྲ་ལ། ཁྱོད་ཀྱི་དྲང་བདེན་ནི་རྒྱ་མཚོའི་རྦ་རླབས་འཕྱུར་བ་དང་མཚུངས།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱི་བུ་རྒྱུད་རྒྱ་མཚོའི་བྱེ་མ་བཞིན་མང་ལ། ཁྱོད་ཀྱི་མངལ་དུ་ཆགས་པའི་བུ་རབས་ཚ་རྒྱུད་བྱེ་རྡུལ་ཇི་བཞིན་མོད། ཁོ་ཚོའི་མིང་ནི་བདག་དྲུང་སྟོངས་ཤིང་མེད་པར་མི་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་པཱ་པེལ་ལོན་ནས་ཕྱིར་ཤོག་དང་། ཀལ་དི་པའི་ཡུལ་ནས་བྱོལ་ཅིག ཁྱོད་རྣམས་ཀྱིས་དགའ་སྤྲོའི་འབོད་སྒྲ་དང་བཅས་སྒྲོགས་ཤིག དོན་དེ་མི་རྣམས་ལ་ཤོད། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཞབས་ཕྱི་ཡ་ཀོབ་བསྐྱབས་སོ་ཞེས་ས་མཐའི་བར་དུ་ཁྱོད་རྣམས་ཀྱིས་དོན་དེ་སྒྲོགས་ཤིག"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་དབེན་སྟོང་ཡུལ་ནས་ཁྲིད་དུས་དེ་ཚོ་སྐོམ་གདུང་གིས་མ་མནར། ཁོང་གིས་དེ་དག་གི་དོན་དུ་བྲག་གསེང་ནས་ཆུ་བཏོན་པ་རེད། ཁོང་གིས་བྲག་གཏོར་ནས་ཆུ་བརྡོལ་དུ་བཅུག"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ངན་ལ་ཞི་བདེ་མེད་ཅེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":20,"caller":"+","text":"འདིར་ཡ་ཧུ་དཱའི་ཆུ་རྒྱུན་ལས་བྱུང་བ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་རྒྱུད་ལས་མཆེད་པ་ཞེས་པར་གོ་བ་ཡིན།","reference":{"chapter":48,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}