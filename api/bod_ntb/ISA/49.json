{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་ཞབས་ཕྱི།"]},{"type":"verse","number":1,"content":["ཀྱེ་མཚོ་གླིང་རྣམས། ཁྱོད་ཚོས་བདག་ལ་ཉོན་དང་། རྒྱང་རིང་གི་མི་རིགས་ཀུན་གྱིས་རྣ་བ་བླགས་ནས་ཉོན་ཅིག ང་རང་མངལ་ནས་ཡོད་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་ཞལ་འབོད་གནང་ཞིང་། ང་རང་མ་ཡི་ཁོག་ནས་སྐྱེས་དུས་སུ་ཁོང་གིས་ངའི་མིང་ནས་བོས།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་ངའི་ཁ་ལྕེ་རྣོན་པོ་གྲི་ལྟར་མཛད་ཅིང་། ཁོང་གི་ཕྱག་འོག་ཏུ་ང་རང་སྦས། ཡང་ཁོང་གིས་ང་ནི་མདའ་རྣོན་པོ་བཞིན་མཛད་དེ། ང་རང་ཁོང་གི་མདའ་དོང་ནང་དུ་སྦས།"]},{"type":"verse","number":3,"content":["ཁོང་གིས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ནི་ངའི་ཞབས་ཕྱི་ཡེས་ར་ཨེལ་ཡིན་ཏེ། བདག་ལ་ཁྱོད་བརྒྱུད་ནས་གཟི་བརྗིད་འཐོབ་པར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":4,"content":["ཡིན་ཡང་ངས་ལན་དུ། ངས་དཀའ་ལས་མྱངས་པ་དོན་མེད་ཡིན། ངའི་སྟོབས་ཤུགས་ཟད་པ་ནི་སྟོང་བ་ཉིད་དང་མི་རྟག་པའོ། །ཡིན་ཡང་ང་ལ་འཐོབ་འོས་པའི་བདེན་ལུགས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཡོད། ངའི་རྔན་པ་ནི་ངའི་དཀོན་མཆོག་དང་ལྷན་དུ་ཡོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":5,"content":["ཡ་ཀོབ་ཕྱིར་འཁོར་ཏེ་ཁོང་ལ་གཏོགས་པ་དང་། ཡེས་ར་ཨེལ་ཁོང་གི་དྲུང་དུ་བསྡུ་བའི་ཕྱིར། ང་རང་མངལ་དུ་ཡོད་དུས་ཁོང་གིས་ང་ནི་ཉིད་ཀྱི་ཞབས་ཕྱི་རུ་བཀོད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ང་རང་གལ་ཆེན་པོ་ཡིན་ལ། ངའི་དཀོན་མཆོག་ནི་ངའི་སྟོབས་ཤུགས་ལགས།"]},{"type":"verse","number":6,"content":["ད་ལྟ་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་རང་བདག་གི་ཞབས་ཕྱི་བྱས་ནས་ཡ་ཀོབ་ཀྱི་ཚོ་པ་རྣམས་ཡང་བསྐྱར་དར་ཞིང་། ཡེས་ར་ཨེལ་ནང་གི་ལྷག་ལུས་རྣམས་ཕྱིར་འཁྲིད་འོང་བ་ནི་དོན་ཆུང་ངུ་ཙམ་ཡིན། བདག་གིས་ཁྱོད་ནི་མི་སྡེ་ཀུན་གྱི་འོད་དུ་བྱེད་པ་དང་། བདག་གི་ཐར་ལམ་ས་མཐར་བསྐྱལ་བར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["ཡེས་ར་ཨེལ་གྱི་གཙོ་བོ་སྐྱབས་མགོན། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་དེ་དཀོན་མཆོག་ཡ་ཝཱེས་མི་ཡི་མཐོང་ཆུང་མྱོང་མཁན། རང་རྒྱལ་སྡང་བ། དབང་སྒྱུར་པས་བྲན་དུ་བཀོལ་བའི་མི་བཅས་ལ་འདི་སྐད་དུ། རྒྱལ་པོ་རྣམས་ཀྱིས་མཐོང་ན་ཡར་འགྲེང་ཞིང་། འགོ་དཔོན་རྣམས་ཀྱིས་མཐོང་ཡང་ཕྱག་འཚལ་ངེས། ཐམས་ཅད་བློ་གཏོད་རུང་བའི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཁྱོད་རང་འདེམས་མཁན་ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ཀྱི་རྐྱེན་གྱིས་སོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཐུགས་དགྱེས་དུས་ངས་ཁྱོད་ལ་ཨ་ལན་སྤྲད། སྐྱོབ་པའི་ཉིན་མོར་ངས་ཁྱོད་ལ་གྲོགས་ཀྱང་མཛད། འབངས་རྣམས་ཀྱི་བར་མི་བྱ་ཕྱིར་ངས་ཁྱོད་བསྲུང་ཞིང་། ཡུལ་དེ་ཡང་བསྐྱར་དར་བར་བྱས་ཏེ། སྟོངས་པའི་ས་ནི་མི་རྣམས་ལ་ནོར་སྐལ་དུ་གནང་བར་བྱའོ། །"]},{"type":"verse","number":9,"content":["བཙོན་པ་རྣམས་ལ་ཕྱི་རུ་ཤོག་ཅེས་དང་། མུན་ནག་ནང་དུ་གནས་པ་རྣམས་ལ་ཕྱིར་མངོན་ཤོག་ཅེས་བརྗོད་ཅིང་། ལམ་བར་དུ་དེ་ཚོས་བཟའ་བཏུང་རྙེད་ཅིང་། སྐྱ་ཐེར་ཐེར་གྱི་མཐོ་ས་རྣམས་དེ་ཚོར་སྤང་ཐང་དུ་འགྱུར་ངེས་ཡིན།"]},{"type":"verse","number":10,"content":["ཁོ་ཚོ་བཀྲེས་ཤིང་སྐོམ་པར་མི་འགྱུར་ལ། ཚ་བས་བསྲེག་ཅིང་ཉི་མས་འཚེ་མི་འགྱུར། ཅི་ལ་ཞེ་ན། ཁོ་ཚོ་བྱམས་བརྩེས་སྐྱོང་མཁན་གྱིས་དེ་དག་འཁྲིད་ཅིང་། ཆུ་མིག་དག་གི་འགྲམ་དུ་ལམ་སྣ་འདྲེན་ནོ། །"]},{"type":"verse","number":11,"content":["བདག་གིས་རང་གི་རི་བོ་ཀུན་ལམ་ཆེན་དུ་བཟོ་ཞིང་། ངའི་གཞུང་ལམ་རྣམས་ཀྱང་བསྙམ་པར་བྱེད།"]},{"type":"verse","number":12,"content":["ལྟོས་ཤིག མི་ལ་ལ་རྒྱང་རིང་ནས་འོང་ཞིང་། ལ་ལ་བྱང་ཕྱོགས་དང་ནུབ་ཕྱོགས་ནས་འོང་ལ། ལ་ལ་སི་ནེན་ཡུལ་ནས་སླེབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ཀྱེ་ནམ་མཁའི་ཚོགས་ཁྱོད་རྣམས་ཀྱིས་དགའ་འབོད་བྱོས་དང་། ཀྱེ་ས་གཞི་ཁྱོད་དགའ་བར་གྱིས་ཤིག ཀྱེ་རི་བོའི་ཚོགས། ཁྱོད་རྣམས་ཀྱིས་སྐད་བཏོན་ཏེ་དགའ་འབོད་གྱིས་ཤིག ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་མི་སྡེ་ལ་སེམས་གསོ་གནང་ནས་ཉིད་ཀྱི་སྐྱོ་བོ་རྣམས་ལ་སྙིང་རྗེ་དགོངས་སོ། །"]},{"type":"verse","number":14,"content":["དེ་ལྟར་ལགས་ཀྱང་ཛ་ཡན་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་སྤངས་ཤིང་། བདག་གི་གཙོ་བོས་ང་བརྗེད་སོང་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["བུད་མེད་ཅིག་གིས་རང་གི་ནུ་མ་ནུ་བའི་ཕྲུ་གུ་བརྗེད་པ་དང་། རང་གི་མངལ་སྐྱེས་བུ་ལ་བརྩེ་བར་མི་བྱའམ། དེ་ཚོས་བརྗེད་སྲིད་ཀྱང་བདག་གིས་ཁྱོད་རང་བརྗེད་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":16,"content":["ལྟོས་ཤིག ངས་ཁྱོད་རང་བདག་གི་ལག་མཐིལ་ལ་བརྐོས་ཏེ། ཁྱོད་ཀྱི་ལྕགས་རི་རྣམས་དུས་རྟག་པར་བདག་གི་མདུན་དུ་ཡོད།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཡང་བསྐྱར་འཛུགས་མཁན་མྱུར་དུ་འོང་ཞིང་། ཁྱོད་རང་མེད་པར་གཏོང་མཁན་དང་སྟོངས་སུ་འཇུག་མཁན་རྣམས་ཁྱོད་དང་རིང་དུ་འབྲལ་བར་འགྱུར།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་མིག་ཡར་བཏེགས་ནས་ཕྱོགས་བཞིར་ལྟོས་དང་། དེ་དག་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་ཁྱོད་ཀྱི་ཕྱོགས་སུ་འོང་བཞིན་འདུག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། རྒྱན་ཆ་འདོགས་པ་ཇི་བཞིན་ཁྱོད་ཀྱིས་དེ་རྣམས་འདོགས་ཤིང་། བག་གསར་གྱིས་སྐ་རགས་འཆིང་པ་བཞིན། ཁྱོད་ཀྱིས་དེ་དག་བཅིང་བར་འགྱུར།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱི་སྟོངས་ཤིང་དབེན་པའི་ཡུལ་རྣམས་དང་། རྡུལ་དུ་བརླགས་པའི་ས་ཆ་རྣམས་ཁྱོད་ཀྱི་ཡུལ་མི་རྣམས་ལ་ཆུང་དྲགས་པས། ཁྱོད་རང་ཁྱུར་མིད་གཏོང་མཁན་རྣམས་ཀྱང་ཁྱོད་དང་རིང་དུ་གྱེས་པར་འགྱུར།"]},{"type":"verse","number":20,"content":["ཡང་ཁྱོད་མྱ་ངན་གྱིས་མནར་བའི་རྗེས་སུ་སྐྱེས་པའི་བུ་རྒྱུད་ཀྱིས་ཁྱོད་ཀྱི་རྣ་བར། ཡུལ་འདི་ང་ལ་ཆུང་དྲགས་པས། ང་སྡོད་སའི་ས་ཞིག་སྦྱིན་རོགས་ཞེས་ཞུ་ངེས།"]},{"type":"verse","number":21,"content":["དུས་དེར་ཁྱོད་ཀྱིས་སེམས་སུ་ན་རེ། ང་ནི་བུ་ཚེ་ལས་འདས་ཤིང་མོ་གཤམ་དུ་ལུས། ང་རང་ཡུལ་བྱོལ་བཏང་ནས་ཕྱི་རུ་སྤྱུགས་པ་ཡིན་པས། སུ་ཞིག་གིས་ངའི་ཕྱིར་ཕྲུ་གུ་འདི་དག་བཙས་ཤིང་། སུས་ཕྲུ་གུ་འདི་དག་སྐྱོང་བར་མཛད་དམ། ལྟོས་ཤིག ང་རང་གཅིག་པུ་དོར་བས་ན། ཕྲུ་གུ་འདི་དག་གང་ནས་ཡོང་ངམ་ཞེས་བརྗོད་ངེས།"]},{"type":"verse","number":22,"content":["གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་མི་རིགས་ཀུན་ལ་རང་གི་ལག་ཟུང་བཏེགས་ཏེ། མི་རྣམས་ལ་ངའི་དར་ཆ་བསྒྲེང་བར་བྱ། དེ་ནས་ཁོ་ཚོས་ཁྱོད་ཀྱི་བུ་རྣམས་པང་དུ་བཟུང་ནས་འོང་ཞིང་། ཁྱོད་ཀྱི་བུ་མོ་རྣམས་ཕྲག་ལ་ཁུར་ནས་འོང་།"]},{"type":"verse","number":23,"content":["རྒྱལ་པོ་རྣམས་ཁྱོད་ཀྱི་ཕ་གཡར་དང་། དེ་དག་གི་རྒྱལ་མོ་རྣམས་ཁྱོད་རང་བདག་སྐྱོང་བྱེད་པའི་མ་མ་རུ་གྱུར་ཏེ། དེ་དག་གིས་གདོང་སར་བཏུད་ནས་ཁྱོད་ལ་ཕྱག་འཚལ་ཞིང་། ཁྱོད་ཀྱི་རྐང་པའི་སྟེང་གི་རྡུལ་ལྡག་པར་བྱའོ། །དེ་ནས་ཁྱོད་ཀྱིས་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་ཤིང་། བདག་ལ་སྒུག་མཁན་རྣམས་ངོ་ཚ་བར་ཡེ་མི་འགྱུར་རོ། །"]},{"type":"verse","number":24,"content":["དེ་ཡང་བཅོམ་པར་གྱུར་པ་དཔའ་བོའི་ལག་ནས་ཅི་ལྟར་ལེན་ནམ། བཙོན་པ་རྣམས་གདུག་རྩུབ་ཅན་གྱི་ལག་ནས་ཅི་ལྟར་སྐྱོབ་བམ།"]},{"type":"verse","number":25,"content":["ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དཔའ་བོས་བཙོན་དུ་ཁྲིད་པ་ཕྱིར་འཕྲོག་ཅིང་། གདུག་རྩུབ་ཅན་གྱིས་བཅོམ་པ་ཕྱིར་སྐྱོབ་པར་འགྱུར། ཁྱོད་དང་རྩོད་མཁན་ལ་ངས་ཀྱང་དེ་དང་རྩོད་ཅིང་། ཁྱོད་ཀྱི་བུ་ཕྲུག་རྣམས་ངས་སྐྱོབ་པར་འགྱུར།"]},{"type":"verse","number":26,"content":["བདག་གིས་ཁྱོད་ཀྱི་གཉའ་ནས་གནོན་མཁན་རྣམས་ལ་རང་གི་ཤ་བཟའ་རུ་འཇུག་ཅིང་། དེ་ཚོ་རྒུན་ཆང་འཐུང་བ་བཞིན་དུ་རང་གི་ཁྲག་གིས་བཟི་བར་འགྱུར། དེ་ནས་མི་ཀུན་གྱིས་བདག་ནི་ཁྱོད་ཀྱི་སྐྱབས་མགོན་ཡ་ཝཱེ་སྟེ། ཁྱོད་སྐྱོབ་མཁན་དང་ཡ་ཀོབ་ཀྱི་མཐུ་བོ་ཆེ་དེ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}