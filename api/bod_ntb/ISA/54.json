{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་བཅངས་པའི་བྱམས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཕྲུ་གུ་སྐྱེ་མི་ཐུབ་པ་དང་། མངལ་ཆགས་མ་མྱོང་བ་ཁྱོད་རྣམས་ཀྱིས་དགའ་འབོད་གྱིས་ཤིག ཕྲུ་གུ་བཙས་མ་མྱོང་བ་ཁྱོད་ཀྱིས་སྐད་ཆེན་པོས་དགའ་འབོད་གྱིས། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོ་ག་ཡོད་པའི་སྐྱེས་མ་ལས་ཁེར་འདུག་མ་ལ་ཕྲུ་གུ་ལྷག་ཏུ་འཕེལ་བར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱི་གུར་ས་རྒྱ་ཆེར་བསྐྱེད་ནས་རང་གི་སྡོད་གནས་ཀྱི་ཡོལ་བ་ཕྱི་ལ་ཚད་མེད་རྐྱོངས་ཤིག རང་གི་ཐག་པ་རིང་དུ་བཏང་ནས་ཕུར་པ་བརྟན་པོར་རྡོབས་ཤིག"]},{"type":"verse","number":3,"content":["གང་ལ་ཞེ་ན། ཁྱོད་རང་གཡས་དང་གཡོན་དུ་ཁྱབ་ཆེན་པོར་དར་ཞིང་། ཁྱོད་ཀྱི་བུ་རྒྱུད་ལ་རྒྱལ་ཕྲན་རྣམས་ཀྱི་ས་དབང་སྟེ། གྲོང་ཁྱེར་སྟོང་བ་རྣམས་སུ་མི་ཡིས་གང་བར་འགྱུར།"]},{"type":"verse","number":4,"content":["ཁྱོད་ངོ་ཚར་མི་གཏོད་པས་སྐྲག་པར་མ་གྱུར་ཅིག ཁྱོད་ལ་བརྙས་བཅོས་མི་འཁེལ་བས་ངོ་གནོང་བར་མ་བྱེད་ཅིག ཁྱོད་ཀྱིས་རང་གི་གཞོན་དུས་ཀྱི་ངོ་ཚ་བརྗེད་ཅིང་། ཁེར་འདུག་སྐབས་ཀྱི་འཕྱ་སྨོད་དྲན་པར་མི་བྱ།"]},{"type":"verse","number":5,"content":["གང་ལ་ཞེ་ན། ཁྱོད་རང་སྐྲུན་མཁན་ནི་ཁྱོད་ཀྱི་ཁྱོ་ག་སྟེ། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁོང་གི་མཚན་ལགས། ཁྱོད་རང་སྐྱོབ་མཁན་ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་དང་། ས་གཞི་ཐམས་ཅད་ཀྱི་དཀོན་མཆོག་ཅེས་འབོད་པ་ཡིན།"]},{"type":"verse","number":6,"content":["ཁྱོད་ནི་གཞན་གྱིས་དོར་བའི་ཆུང་མ་སེམས་སྡུག་ཅན་ཏེ། ལོ་ན་གཞོན་དུས་གཞན་གྱིས་དོར་བའི་ཆུང་མ་བཞིན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་བོས་སོ་ཞེས་ཁྱོད་ཀྱི་དཀོན་མཆོག་གིས་གསུངས།"]},{"type":"verse","number":7,"content":["བདག་གིས་ཁྱོད་གནས་སྐབས་སུ་དོར་ཡང་། ངས་སྙིང་རྗེ་ཆེན་པོས་ཁྱོད་ཕྱིར་བསྡུ་ངེས་ཡིན།"]},{"type":"verse","number":8,"content":["ཁོང་ཁྲོ་རབ་ཏུ་འབར་བའི་དུས་སུ། ངས་གནས་སྐབས་སུ་རང་གི་ངོ་གདོང་ཁྱོད་ཕྱོགས་མ་འཁོར་ཡང་། མཐའ་མེད་པའི་བྱམས་བརྩེ་ཡིས་ངས་ཁྱོད་ལ་སྙིང་རྗེ་སྒོམ་པར་བྱ་ཞེས་ཁྱོད་རང་སྐྱོབ་མཁན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ཡང་དོན་འདི་ང་ལ་མཚོན་ན་ནོ་ཨའི་དུས་སྐབས་ཀྱི་ཆུ་ལོག་དང་འདྲ་ལ། ནོ་ཨའི་དུས་སྐབས་སུ་བྱུང་བའི་ཆུ་ལོག་གིས་ཡང་བསྐྱར་ས་གཞི་བསྣུབ་པར་མི་བྱའོ་ཞེས་བདག་གིས་མནའ་བསྐྱལ་བ་བཞིན། ཁྱོད་སྟེང་བདག་མི་ཁྲོས་ཤིང་། ཁྱོད་ལ་གཤེ་གཤེ་གཏོང་བར་མི་འགྱུར་ཞེས་མནའ་བསྐྱལ་བ་ཡིན།"]},{"type":"verse","number":10,"content":["རི་རྣམས་བསྣུར་ཅིང་སྒང་རྣམས་བསྒུལ་ནའང་། བདག་གིས་ཁྱོད་ལ་བཅངས་པའི་བྱམས་བརྩེ་ནི་ཁྱོད་དང་མི་འབྲལ་ཞིང་། བདག་གི་ཞི་བདེའི་དམ་བཅའ་ཡང་ཁྱོད་དང་འབྲལ་བར་མི་འགྱུར་ཞེས་ཁྱོད་ལ་སྙིང་རྗེ་དགོངས་པའི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གྱི་མ་འོངས་པའི་ཚུལ།"]},{"type":"verse","number":11,"content":["ཀྱེ་དཀའ་སྡུག་མྱངས་ཤིང་རླུང་དམར་གྱིས་སྒུལ་བ། སེམས་གསོ་མ་ཐོབ་པ་ཁྱོད་ཀྱིས་ལྟོས་དང་། ངས་གཡུ་ནི་ཁྱོད་ཀྱི་རྨང་རྡོ་རུ་བྱ་ཞིང་། ཁྱོད་ཀྱི་རྩིག་རྨང་ལ་དབང་སྔོན་འདིང་བར་བྱའོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་མཁར་རྣམས་པད་མ་རཱ་ག་དང་། མཁར་སྒོ་གཡང་ཊི་དམར་པོ། ཕྱོགས་བཞིའི་རྩིག་པ་རྣམས་རྡོ་རིན་པོ་ཆེ་སྣ་ཚོགས་ཀྱིས་བཞེང་བར་བྱ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱི་བུ་རྒྱུད་ཐམས་ཅད་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བསླབ་བྱ་འཐོབ་ཅིང་། ཁྱོད་ཀྱི་བུ་ཕྲུག་རྣམས་ཀྱིས་ཞི་བདེ་ལོངས་སུ་སྤྱོད་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཁྱོད་ནི་དྲང་བདེན་དབང་གིས་བརྟན་པོར་མཛད་ཅིང་། ཁྱོད་ནི་བརྙས་བཅོས་དང་རིང་དུ་འབྲལ་བ་དང་། ཁྱོད་ལ་འཇིགས་པ་གང་ཡང་མི་འབྱུང་ངོ་། །ཁྱོད་རང་འཇིགས་དངངས་ཀུན་དང་འབྲལ་བར་འགྱུར། གང་ལ་ཞེ་ན། འཇིགས་སྐྲག་ཁྱོད་ཀྱི་ཉེ་སར་མི་བཏུད་དོ། །"]},{"type":"verse","number":15,"content":["ལྟོས་ཤིག མི་ཡར་ལངས་ནས་ཁྱོད་ལ་རྒོལ་ནའང་། དེ་ནི་ང་ལས་བྱུང་བ་མིན་ལ། ཁྱོད་ཀྱི་རྐྱེན་གྱིས་དེ་སར་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":16,"content":["ལྟོས་ཤིག སོལ་མེར་ཕུ་འདེབས་མཁན་དང་། སྤྱོད་གོ་ཆོད་པོའི་མཚོན་ཆ་བཟོ་མཁན་མགར་པ་དེ་ངས་མཛད་ཅིང་། མི་ལ་གནོད་པ་སྐྱེལ་ཞིང་མེད་པར་གཏོང་མཁན་དེ་ཡང་ངས་བསྐྲུན་ནོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ལ་རྒོལ་ཕྱིར་བཟོས་པའི་མཚོན་ཆ་དག་ལ་ནུས་པ་མ་ལྡན་ཏེ། ཁྲིམས་ཐག་གཅོད་དུས་དར་ཞིང་རྒྱས་ནས་ཁྱོད་དང་རྒོལ་བའི་ལྕེ་རྣམས་ལ་ཡང་ཁྱོད་ཀྱིས་དགག་པ་རྒྱག་པར་འགྱུར། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་རྣམས་ཀྱི་ནོར་སྐལ་ཡིན་ལ། དེ་དག་གི་དྲང་བདེན་ནི་བདག་ལས་ཐོབ་པ་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}