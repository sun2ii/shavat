{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་རིན་མི་དགོས་པའི་བྱམས་པ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཁ་སྐོམ་པ་ཁྱོད་རྣམས་ཆུ་ཡོད་སར་ཤོག་དང་། དངུལ་མེད་པ་ཁྱོད་རྣམས་ཀྱང་ཤོག་དང་ཉོས་ནས་བཟའ་བར་གྱིས། ཁྱོད་རྣམས་དངུལ་དང་རིན་མི་དགོས་པར་རྒུན་ཆང་དང་འོ་མ་ཉོ་བར་ཕེབས་ཤོག"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་དངུལ་སྤྲད་དེ་བཟའ་བཏུང་མ་ཡིན་པ་དེ་ཉོ་བ་དང་། ཅིའི་ཕྱིར་དཀའ་སྡུག་སྤྱད་ནས་ཐོབ་པ་དེས་མིའི་ཡིད་ཚིམ་དུ་འཇུག་མི་ནུས་པ་དེ་ཉོའམ། ཁྱོད་རྣམས་ཀྱིས་སེམས་ཞིབ་མོས་ངའི་བཀའ་ལ་མཉན་ན་ཟས་ཞིམ་པོ་སྤྱོད་པ་དང་སེམས་པ་སྐྱིད་ཅིང་བདེའོ། །"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་ཀྱིས་རྣ་བ་གཏད་དེ་ཉོན་ལ་བདག་གི་དྲུང་དུ་ཤོག ཁྱོད་རྣམས་ཀྱིས་མཉན་ན་གསོན་པར་འགྱུར་ཞིང་། བདག་གིས་ཁྱོད་ཅག་ལ་དུས་གཏན་གྱི་ཁ་ཆད་འཇོག་པར་བྱ་སྟེ། དཱ་བིད་ལ་གནང་བར་ཁས་བླངས་པའི་བྱམས་བརྩེ་བདེན་པ་དེ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["ལྟོས་དང་། བདག་གིས་ཁོ་ནི་མི་རིགས་ཀུན་གྱི་དཔང་པོ་དང་། འགོ་དཔོན། དམག་དཔོན་དུ་བསྐོས་པ་ཡིན།"]},{"type":"verse","number":5,"content":["ལྟོས་ཤིག ཁྱོད་ཀྱིས་ངོ་མི་ཤེས་པའི་རྒྱལ་ཕྲན་རྣམས་བོས་ཤིག རྒྱལ་ཕྲན་དེ་དག་གིས་ཁྱོད་ངོ་མི་ཤེས་ཀྱང་ཁྱོད་ཀྱི་ཕྱོགས་སུ་རྒྱུགས་ནས་འོང་། རྒྱུ་མཚན་ནི་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཁོང་གིས་ཁྱོད་དཔལ་དང་ལྡན་པར་མཛད་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་རྙེད་ཐུབ་དུས་ཁོང་འཚོལ་ཞིག ཁོང་ཉེ་སར་བཞུགས་དུས་ཁོང་ལ་ཞུས་ཤིག"]},{"type":"verse","number":7,"content":["ངན་པས་རང་གི་ལོག་ལམ་འདོར་དགོས་ཤིང་། དྲང་བདེན་མིན་པའི་མི་ཡིས་རང་གི་བསམ་ཚུལ་དོར་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ཕྱོགས་སུ་ལོག་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལ་སྙིང་རྗེ་བསྒོམ་པར་འགྱུར། ཁྱོད་རྣམས་རང་ཅག་གི་དཀོན་མཆོག་ཕྱོགས་སུ་ལོག་དང་། གང་ལ་ཞེ་ན། ཁོང་གིས་མིའི་སྡིག་པ་སེལ་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གི་བསམ་བློ་ནི་ཁྱོད་རྣམས་ཀྱི་བསམ་ཚུལ་མིན་ལ། ཁྱོད་ཅག་གི་ལམ་རྣམས་ཀྱང་བདག་གི་ལམ་ནི་མིན།"]},{"type":"verse","number":9,"content":["ནམ་མཁའ་ས་གཞི་ལས་མཐོ་བ་བཞིན། བདག་གི་གཤེགས་ལམ་ནི་ཁྱོད་ཅག་གི་བགྲོད་ལམ་ལས་མཐོ་ཞིང་། བདག་གི་བསམ་བློ་ཡང་ཁྱོད་རྣམས་ཀྱི་བསམ་ཚུལ་ལས་མཐོ་བ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["གནམ་ནས་ཆར་དང་ཁངས་བབས་ཏེ། ནམ་མཁར་ཕྱིར་མི་ལོག་པར་ས་གཞིར་རློན་བཟོས་ནས་དེའི་སྟེང་གི་སྐྱེས་དངོས་ལ་མྱུ་གུ་འབུ་བར་བྱེད་པ་དང་། ཞིང་འདེབས་མཁན་ལ་ས་བོན་ཡོད་པ་དང་། ཟས་སྤྱོད་མཁན་ལ་འབྲུ་རིགས་འཐོབ་ཏུ་འཇུག་པ་ཇི་བཞིན།"]},{"type":"verse","number":11,"content":["བདག་གི་ཁ་ནས་བྱུང་བའི་གཏམ་རྣམས་ཀྱང་དེ་བཞིན་ཡིན་ཏེ། དོན་མེད་དུ་བདག་གི་ཕྱོགས་སུ་ཕྱིར་ལོག་པར་མི་འགྱུར་གྱིས། བདག་གི་འདོད་བློ་བཞིན་དུ་འགྲུབ་ཅིང་། བདག་གིས་མངགས་པའི་དོན་རྣམས་སྟེང་དུ་འགྲུབ་པར་འགྱུར།"]},{"type":"verse","number":12,"content":["དེ་ནས་ཁྱོད་རྣམས་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་ཕྱི་རུ་ཐོན་ཞིང་། ཞི་བདེའི་ངང་ཁྲིད་སྟོན་མཛད་པ་དང་། རི་རབ་དང་རི་སྒང་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་མདུན་ནས་དགའ་འབོད་བྱེད་ཅིང་། ཐང་གི་ལྗོན་ཤིང་རྣམས་ཀྱིས་ཀྱང་ཐལ་མོ་རྡེབ་པར་འགྱུར།"]},{"type":"verse","number":13,"content":["ཚེར་མའི་ཚབ་ཏུ་གསོམ་ཤིང་སྐྱེ་ཞིང་། ཤིང་ཚེར་གྱི་ཚབ་ཏུ་པ་སངས་མེ་ཏོག་སྐྱེས་ནས། དེས་དཀོན་མཆོག་ཡ་ཝཱེར་མཚན་གསོལ་བ་དང་རྟག་ཏུ་གནས་ཤིང་འཇིག་པ་མེད་པའི་རྟགས་སུ་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}