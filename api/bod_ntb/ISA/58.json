{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["སྨྱུང་གནས་སྲུང་བའི་སྙིང་པོ།"]},{"type":"verse","number":1,"content":["ཁྱོད་ཀྱིས་མཚམས་མེད་པར་སྐད་ཆེན་པོ་རྒྱོབས་ཤིག རྭ་དུང་འབུད་པ་བཞིན་སྐད་ཆེན་པོ་རྒྱོབས་ཤིག བདག་གི་མི་སྡེ་ལ་དེ་ཚོའི་ཉེས་པ་སྒྲོགས་དང་། ཡ་ཀོབ་ཀྱི་ཁྱིམ་རྒྱུད་ལ་ཁོ་ཚོའི་སྡིག་པ་རྣམས་གསལ་པོར་སྨྲོས་ཤིག"]},{"type":"verse","number":2,"content":["དྲང་བདེན་སྤྱོད་པའི་རྒྱལ་དམངས་ཚོས་རང་གི་དཀོན་མཆོག་གི་བཀའ་རྣམས་མི་འདོར་བ་བཞིན། དེ་དག་གིས་ཉིན་རེ་བཞིན་བདག་འཚོལ་ཞིང་། བདག་གི་ལམ་རྣམས་ཤེས་འདོད་དེ། དྲང་བདེན་གྱི་བཅད་ཁྲ་བདག་ལ་ཞུ་ཞིང་། དཀོན་མཆོག་དང་ཉེ་སར་གཅར་བ་ལ་སྤྲོའོ། །"]},{"type":"verse","number":3,"content":["དེ་དག་ན་རེ། ང་ཚོས་སྨྱུང་གནས་བསྲུངས་པ་ཁྱེད་ཀྱིས་མི་གཟིགས་པ་ཅི་ཡིན་ནམ། ང་ཚོས་དཀའ་སྡུག་སྤྱད་ཀྱང་ཁྱེད་ཀྱིས་མི་མཁྱེན་པ་ཅི་ཡིན་ནམ་ཞེས་ཞུས་ཀྱང་། ལྟོས་དང་། ཁྱོད་ཚོས་སྨྱུང་གནས་སྲུང་བའི་ཉིན་མོར་ཡང་རང་ཉིད་དགའ་བའི་ལས་སྤྱོད་ཅིང་། རང་གི་ལས་མི་ཀུན་ལ་གཉའ་གནོན་བྱེད་དོ། །"]},{"type":"verse","number":4,"content":["ལྟོས་ཤིག ཁྱོད་ཚོའི་སྨྱུང་གནས་ནི་རྩོད་གླེང་དང་འཐབ་འཁྲུག་ཡིན་ཏེ། ཁུ་ཚུར་གཏུམ་པོས་མི་ལ་རྡུང་བ་ཡིན་ཞིང་། ཁྱོད་ཚོས་དེ་རིང་གི་སྨྱུང་གནས་འདི་ལྟ་བུ་བསྲུངས་ཏེ་རང་གི་སྐད་སྒྲ་གནམ་ནས་ཐོས་པར་རེ་བ་མ་བྱེད་ཅིག"]},{"type":"verse","number":5,"content":["འདི་ལྟ་བུའི་སྨྱུང་གནས་ནི་བདག་གིས་བདམས་ཤིང་མི་ལ་དཀའ་ཐུབ་སྤྱོད་དུ་འཇུག་པའི་ཉིན་མོ་ཡིན་ནམ། མི་ཡི་མགོ་བོ་འདམ་རྩྭ་བཞིན་སྒུར་དུ་བཅུག་སྟེ། རྩིད་རས་དང་གོ་ཐལ་གྱི་གདན་གདིང་དགོས་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་འདི་ལ་སྨྱུང་གནས་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ལ་ལྡན་པའི་ཉིན་མོ་རུ་འབོད་དམ།"]},{"type":"verse","number":6,"content":["བདག་གིས་བདམས་པའི་སྨྱུང་གནས་ནི་གདུག་རྩུབ་ཅན་གྱི་ལྕགས་སྒྲོག་བསྒྲལ་བ་དང་། གཉའ་ཤིང་གི་ཐག་པ་ལྷོད་པ། གཉའ་གནོན་འོག་ཏུ་ཡོད་པ་རྣམས་ཐར་དུ་འཇུག་པ། གཉའ་ཤིང་ཐམས་ཅད་གཅོག་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":7,"content":["དེ་ནི་བཀྲེས་པའི་མི་ལ་རང་གི་ཁ་ཟས་སྟེར་བ་དང་། དབུལ་པོ་འཁྱམས་པོ་དག་རང་ཁྱིམ་དུ་སྣེ་ལེན་བྱེད་པ། གོས་མེད་གཅེར་བུ་མཐོང་ཚེ་དེ་ལ་གོས་བསྐོན་པ། རང་གི་གཉེན་ཉེ་ལས་རང་ཉིད་སྦ་སྐུང་མི་བྱེད་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["དེ་ནས་ཁྱོད་ཀྱི་འོད་ཟེར་སྐྱ་རེངས་ལྟར་འཕྲོ་ཞིང་། ཁྱོད་ཀྱི་རྨ་ཁ་མྱུར་དུ་སོས་ཏེ། དྲང་བདེན་ཁྱོད་ཀྱི་མདུན་དུ་སྐྱོད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ཁྱོད་ཀྱི་རྒྱབ་རྟེན་དུ་འགྱུར་ངེས།"]},{"type":"verse","number":9,"content":["དུས་དེར་ཁྱོད་ཀྱིས་ཞུས་ན་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ལན་བསྩལ་ཞིང་། ཁྱོད་ཀྱིས་འོ་དོད་བོས་ན་ཁོང་གིས་ང་འདི་རུ་ཡོད་ཅེས་གསུང་བར་འགྱུར། གལ་ཏེ་ཁྱོད་ཀྱིས་རང་ཅག་གི་ཁྲོད་ནས་གཉའ་ཤིང་དང་། སྐྱོན་འཛུགས་པའི་མཛུབ་མོ། གཏམ་ངན་སྨྲ་བ་བཅས་འདོར་ཞིང་།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་བཀྲེས་ལྟོགས་ཀྱིས་མནར་བ་རྣམས་ལ་སྙིང་རྗེ་བསྐྱེད་པ་དང་། དཀའ་སྡུག་ཅན་གྱི་ཡིད་ཚིམ་དུ་བཅུག་ན། ཁྱོད་ཀྱི་འོད་ནི་མུན་པའི་ཁྲོད་ནས་འཆར་ཞིང་། ཁྱོད་ཀྱི་སྨག་རུམ་ནི་ཉིན་གུང་བཞིན་དུ་འགྱུར།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རྟག་ཏུ་ཁྱོད་ཀྱི་ལམ་སྣ་འདྲེན་ཞིང་། སྐམ་སར་ཁྱོད་ཀྱི་ཡིད་ཚིམ་པར་མཛད་ཅིང་། ཁྱོད་ཀྱི་རུས་པ་རྣམས་ལ་སྟོབས་ཤུགས་རྒྱས་པར་མཛད་དོ། །དེ་ནས་ཁྱོད་ནི་ཆུ་མང་པོ་དྲངས་པའི་སྐྱེད་ཚལ་དང་། བཞུར་རྒྱུན་མི་ཆད་པའི་ཆུ་མིག་ལྟ་བུར་འགྱུར།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་བུ་རྒྱུད་རྣམས་ཀྱིས་ཞིག་རལ་རྣམས་སླར་སྐྲུན་ཞིང་། ཁྱོད་ཀྱིས་གནའ་བོའི་བཤིག་རོ་རྣམས་ཀྱི་རྨང་རྡོ་འཛུགས་པས། ཁྱོད་ལ་མཁར་ཆག་ཞིག་གསོ་བྱེད་མཁན་དང་། གཞིས་ཡུལ་བསྐྲུན་པའི་ལམ་བཟོ་མཁན་ཞེས་མིང་ཐོགས་པར་འགྱུར་རོ། །"]},{"type":"heading","content":["ངལ་གསོ་བའི་ཉིན་མོ་སྲུང་བའི་བྱིན་རླབས།"]},{"type":"verse","number":13,"content":["ངལ་གསོ་བའི་ཉིན་མོར་ཁྱོད་ཀྱིས་རང་གི་གོམ་སྟབས་ལ་གཟབ་གཟབ་བྱས་ཏེ། བདག་གི་ཉིན་དམ་པའི་ནང་དུ་རང་ཉིད་དགའ་བའི་ལས་མི་སྤྱོད་པར། ངལ་གསོ་བའི་ཉིན་མོ་དགའ་འོས་པའི་ཉིན་དུ་བརྩི་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་དམ་པ་བཀུར་འོས་པར་བརྗོད་དེ། དེ་ལ་བཀུར་བ་ལས་རང་གི་ལམ་དུ་མི་སྐྱོད་ཅིང་། རང་གི་འདོད་པ་མི་འཚོལ་བ་དང་། ཕན་མེད་ཀྱི་གཏམ་ཡང་མི་སྨྲ་བ་ཡིན་ན།"]},{"type":"verse","number":14,"content":["ཁྱོད་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་ལས་དགའ་སྤྲོ་འཐོབ་ཅིང་། བདག་གིས་ཁྱོད་ས་གཞིའི་མཐོ་སར་བསྐྱོན་ཏེ། ཁྱོད་ཀྱི་མེས་པོ་ཡ་ཀོབ་ཀྱི་ནོར་སྐལ་ལས་ཁྱོད་འཚོ་བར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་སྐུ་དངོས་སུ་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}