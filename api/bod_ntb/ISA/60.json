{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གྱི་མ་འོངས་པའི་གཟི་དཔལ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ཛ་ཡན་ཡར་ལོངས་ལ་འོད་སྤྲོས་ཤིག ཁྱོད་ཀྱི་འོད་སླེབས་ཟིན་པས་སོ། །དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད་ཡར་འཕགས་ཏེ་ཁྱོད་ཀྱི་སྟེང་དུ་ཤར་བྱུང་།"]},{"type":"verse","number":2,"content":["ལྟོས་དང་། མུན་པས་ས་གཞི་གཡོགས་ཤིང་མི་རིགས་ཀུན་སྨག་རུམ་གྱིས་བཏུམས་ནའང་། དཀོན་མཆོག་ཡ་ཝཱེ་ཡར་བཞེངས་ཏེ་ཁྱོད་ལ་འོད་སྤྲོ་ཞིང་ཁོང་གི་གཟི་བརྗིད་ཁྱོད་ཀྱི་སྟེང་ནས་མངོན་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["རྒྱལ་ཕྲན་རྣམས་ནི་ཁྱོད་ཀྱི་འོད་ནང་དུ་སྐྱོད་ཅིང་། རྒྱལ་པོ་རྣམས་ཁྱོད་ཀྱི་ཉི་གཞོན་འཆར་ཀའི་འོད་ནང་དུ་རྒྱུ་བར་འགྱུར།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་མིག་ཟུང་ཡར་བཏེགས་ནས་ཕྱོགས་ཀུན་ལ་ལྟོས་དང་། མི་ཐམས་ཅད་མཉམ་གཅིག་ཏུ་ཁྱོད་ཀྱི་མདུན་དུ་འོང་ཞིང་། ཁྱོད་ཀྱི་བུ་རྣམས་རྒྱང་རིང་ནས་འོང་ལ། ཁྱོད་ཀྱི་བུ་མོ་རྣམས་མཆན་ལ་བཙིར་ནས་འོང་བར་འགྱུར།"]},{"type":"verse","number":5,"content":["དུས་དེར་ཁྱོད་ཀྱིས་མཐོང་ཞིང་འོད་མདངས་བཀྲ་བར་འགྱུར་ཏེ། ཁྱོད་ཀྱི་སེམས་ངོ་མཚར་ཞིང་སྤྲོ་བར་འགྱུར། ཅིའི་ཕྱིར་ཞེ་ན། རྒྱ་མཚོའི་གཏེར་རྣམས་ཁྱོད་ཀྱི་ཕྱོགས་སུ་འཁོར་ཞིང་། རྒྱལ་ཕྲན་རྣམས་ཀྱི་རྒྱུ་ནོར་ཁྱོད་ལ་འཐོབ་ངེས་ཡིན།"]},{"type":"verse","number":6,"content":["རྔ་མོང་གི་ཁྱུ་རྣམས་ཁྱོད་ཀྱི་ས་གཞིར་ཁྱབ་ཅིང་། མིད་ཡཱན་དང་ཨེ་ཕཱ་ཡི་རྔ་མོང་ཆུང་ཆུང་རྣམས་ཁྱོད་ཀྱི་རྒྱལ་ཁམས་སུ་གང་སྟེ། ཤེ་བཱའི་མི་ཀུན་གྱིས་གསེར་དང་སྤོས་དཀར་ཁྱེར་འོངས་ནས། དཀོན་མཆོག་ཡ་ཝཱེར་བསྟོད་ཅིང་བསྔགས་པའི་གཏམ་བཟང་སྒྲོག་གོ །"]},{"type":"verse","number":7,"content":["ཀེ་དཱར་གྱི་ལུག་ཁྱུ་ཐམས་ཅད་ཁྱོད་ཀྱི་དྲུང་དུ་འདུས་ཤིང་། ནཱ་བ་ཨོད་ཀྱི་ལུག་ཐུག་རྣམས་ཁྱོད་ཀྱི་དྲུང་དུ་འབྱོར་ངེས། དེ་དག་བདག་གི་བློར་འབབ་པའི་མཆོད་རྫས་སུ་འགྱུར་ཆེད་བདག་གི་མཆོད་ཁྲི་སྟེང་འབུལ་ཞིང་། བདག་གིས་རང་གི་གཟི་བརྗིད་ལྡན་པའི་མཆོད་ཁང་ལ་གཟི་བརྗིད་ལྡན་པར་མཛད་དོ། །"]},{"type":"verse","number":8,"content":["སྤྲིན་ལྟར་འཕུར་ཞིང་། ཕུག་རོན་བཞིན་རང་གི་ཚང་ནང་འཕུར་འགྲོ་བ་དེ་དག་སུ་ཡིན་ནམ།"]},{"type":"verse","number":9,"content":["གླིང་ཕྲན་རྣམས་ཀྱིས་བདག་ལ་བསྒུག་ཅིང་། ཁོང་གིས་ཁྱོད་ལ་གཟི་བརྗིད་བསྩལ་ཡོད་པས། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་དང་། ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ཀྱི་རྐྱེན་གྱིས། ཐཱར་ཞིས་པའི་གྲུ་གཟིངས་རྣམས་ཀྱིས་སྣེ་ཁྲིད་དེ་ཁྱོད་ཀྱི་བུ་རྣམས་གསེར་དངུལ་དང་བཅས་རྒྱང་རིང་ཡུལ་ནས་བསྐྱལ་འོང་།"]},{"type":"verse","number":10,"content":["ཕྱི་ཕྱོགས་པས་ཁྱོད་ཀྱི་མཁར་ཡང་བསྐྱར་བརྩིག་ཅིང་། དེ་དག་གི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཁྱོད་ལ་ཞབས་ཕྱི་བསྒྲུབ་པར་འགྱུར། གང་ལ་ཞེ་ན། སྔར་བདག་གིས་ཁོང་ཁྲོ་དང་བཅས་ཁྱོད་ལ་བརྡེགས་ནའང་། ད་ལྟ་གཟིགས་སྐྱོང་ཁྲོད་ནས་ཁྱོད་ལ་སྙིང་རྗེ་བསྐྱེད་པ་ཡིན།"]},{"type":"verse","number":11,"content":["མི་རྣམས་ཀྱིས་ཁྱོད་ལ་རྒྱལ་ཕྲན་ཀུན་གྱི་རྒྱུ་ནོར་སྐྱེལ་འདྲེན་བྱེད་པ་དང་། དེའི་རྒྱལ་པོ་རྣམས་ཁྲིད་འོང་བའི་ཕྱིར། ཁྱོད་ཀྱི་མཁར་སྒོ་རྒྱུན་དུ་ཕྱེས་ཏེ། ཉིན་མཚན་གང་དུའང་སྒོ་རྒྱག་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཁྱོད་ལ་ཞབས་ཕྱི་མི་བསྒྲུབ་པའི་བུ་རྒྱུད་དང་རྒྱལ་སྲིད་ནི་མེད་པར་འགྱུར་ཞིང་། རྒྱལ་ཁབ་དེ་དག་རྩ་བ་ནས་འཇིག་ངེས་ཡིན།"]},{"type":"verse","number":13,"content":["བདག་གི་གནས་དམ་པ་མཛེས་པར་བརྒྱན་ཕྱིར་གསོམ་པ་དང་སྒྲོན་ཤིང་། ཤུག་ཤིང་བཅས་ལེ་པཱ་ནོན་གྱི་གཟི་བརྗིད་ཁྱོད་ལ་གཏོགས་པར་འགྱུར། ངས་རང་གི་རྐང་པ་སྤོ་སར་གཟི་བརྗིད་འཐོབ་པར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་དཀའ་སྡུག་ལ་སྦྱོར་མཁན་གྱི་བུ་རྒྱུད་རྣམས་མགོ་བསྒུར་ཏེ་ཁྱོད་ཀྱི་དྲུང་དུ་འོང་ཞིང་། ཁྱོད་ལ་མཐོང་ཆུང་བྱེད་མཁན་ཐམས་ཅད་ཀྱིས་ཁྱོད་ཀྱི་རྐང་འོག་ནས་ཕྱག་འཚལ་བར་འགྱུར། དེ་ཚོས་ཁྱོད་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་གྲོང་ཁྱེར་དང་། ཡེས་ར་ཨེལ་གྱི་དམ་པའི་ཛ་ཡན་ཞེས་འབོད།"]},{"type":"verse","number":15,"content":["སྔར་ཁྱོད་ནི་དོར་ཞིང་སྡང་བར་གྱུར་ཏེ། ཐ་ན་ཁྱོད་བརྒྱུད་ནས་འགྲོ་མཁན་མེད་ཀྱང་། བདག་གིས་ཁྱོད་ནི་དུས་གཏན་དུ་བསྟོད་པའི་ཡུལ་དུ་འགྱུར་བ་དང་། མི་རབས་ཀུན་གྱི་དགའ་སྤྲོ་རུ་བྱེད་དོ། །"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱིས་རྒྱལ་ཕྲན་ཀུན་གྱི་འོ་མ་བཏུང་ཞིང་། རྒྱལ་པོ་རྣམས་ཀྱི་ནུ་ཞོ་འཇིབ་པ་དང་། དེ་ནས་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་བདག་ནི་ཁྱོད་ཀྱི་མགོན་སྐྱབས་དང་། ཡ་ཀོབ་ཀྱི་མཐུ་བོ་ཆེ་སྟེ་ཁྱོད་རང་བླུ་མཁན་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["བདག་གིས་ཟངས་ཀྱི་ཚབ་ཏུ་གསེར་དང་། ལྕགས་ཀྱི་ཚབ་ཏུ་དངུལ། ཤིང་གི་ཚབ་ཏུ་ར་གན་དང་། རྡོའི་ཚབ་ཏུ་ལྕགས་འདྲེན་པར་བྱ་སྟེ། བདག་གིས་ཁྱོད་ཀྱི་ལས་དཔོན་དུ་ཞི་བདེ་དང་། ཁྱོད་ཀྱི་དབང་སྒྱུར་མཁན་དུ་དྲང་བདེན་བསྐོ་བར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱི་ཡུལ་ནས་དྲག་སྤྱོད་ཀྱི་དོན་ཙམ་ཡང་མི་ཐོས་ཤིང་། ཁྱོད་ཀྱི་མངའ་ཁོངས་སུ་ཉམ་རྒུད་དང་གཏོར་བཤིག་གི་སྒྲ་ཙམ་ཡང་ཐོས་པར་མི་འགྱུར། ཁྱོད་ཀྱིས་རང་གི་ལྕགས་རི་རྣམས་ལ་ཐར་པ་དང་། མཁར་སྒོ་རྣམས་ལ་བསྟོད་བསྔགས་ཞེས་འབོད་པར་འགྱུར།"]},{"type":"verse","number":19,"content":["ཉིན་དཀར་ཉི་འོད་ཁྱོད་ཀྱི་འོད་དུ་མི་བྱ་ཞིང་། མཚན་མོར་ཟླ་འོད་ཀྱང་ཁྱོད་སྟེང་མི་སྤྲོ། ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་ཀྱི་དུས་གཏན་གྱི་འོད་ཟེར་དང་། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཁྱོད་ཀྱི་གཟི་བརྗིད་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱི་ཉི་མ་ནམ་ཡང་མི་ནུབ་ལ། ཁྱོད་ཀྱི་ཟླ་བ་ཡང་འཁུམ་པར་མི་འགྱུར། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་ཀྱི་དུས་གཏན་གྱི་འོད་ཟེར་བྱེད་ཅིང་། ཁྱོད་ཀྱི་སྡུག་བསྔལ་གྱི་ཉིན་མོ་རྣམས་རྫོགས་པར་འགྱུར།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱི་འབངས་རྣམས་དྲང་བདེན་དུ་འགྱུར་ཞིང་། དུས་གཏན་དུ་ཡུལ་དེ་ས་སྐལ་དུ་འཐོབ་པར་འགྱུར། དེ་དག་ནི་བདག་གིས་བཙུགས་པའི་མྱུ་གུ་དང་། བདག་གི་ཕྱག་གིས་བྱས་པ་ཡིན་པས་བདག་ལ་གཟི་བརྗིད་མངའ་བར་འགྱུར།"]},{"type":"verse","number":22,"content":["ཆེས་ཆུང་བ་རྣམས་རིགས་གཅིག་ཏུ་འགྱུར་ཞིང་། སྟོབས་ཉམས་པ་རྣམས་སྟོབས་འབྱོར་ལྡན་པའི་རྒྱལ་ཁབ་ཏུ་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེ་བདག་གིས་དུས་བཞིན་དུ་དོན་དེ་རྣམས་མྱུར་དུ་བསྒྲུབ་པར་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}