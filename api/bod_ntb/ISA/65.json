{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":1,"content":["བདག་ལ་མ་ཞུ་བ་རྣམས་ལ་བདག་གིས་རྙེད་པར་བྱ་ཞིང་། བདག་མ་བཙལ་བ་རྣམས་བདག་དང་འཕྲད་པར་འགྱུར། བདག་གི་མིང་ནས་བོས་མ་མྱོང་བའི་མི་རིགས་ལ་བདག་གིས་ང་འདི་རུ་ཡོད། ང་འདི་རུ་ཡོད་ཅེས་སྨྲ་ངེས།"]},{"type":"verse","number":2,"content":["བདག་གིས་ཉིན་གང་པོར་རང་གི་ལག་ཟུང་མི་སྡེ་གྱེན་ལྡོག་གི་ཕྱོགས་སུ་བརྐྱངས། དེ་ཚོ་རང་གི་བསམ་པའི་རྗེས་སུ་འབྲངས་ནས་ལམ་བཟང་པོར་མ་འགྲུལ་ཏོ། །"]},{"type":"verse","number":3,"content":["སྐྱེད་ཚལ་ཁྲོད་ནས་སྦྱིན་སྲེག་བཏང་ཞིང་། སོ་ཕག་གི་མཆོད་ཁྲིའི་སྟེང་མཆོད་པ་ཕུལ་ནས་འབངས་དེ་དག་གིས་རྒྱུན་དུ་ངའི་མདུན་ནས་བདག་ལ་ཁོང་ཁྲོ་བསླངས།"]},{"type":"verse","number":4,"content":["དེ་དག་དུར་ཁྲོད་དུ་བསྡད་ནས་གསང་བའི་ཡུལ་དུ་ཞག་སྡོད་བྱས་པ་དང་ཕག་ཤ་སྤྱད་ཅིང་། དེ་དག་གི་རྫ་ཁོག་ནང་དུ་མི་གཙང་བའི་རྫས་ཀྱིས་ཤ་ཁུ་བསྐོལ་བ་དང་།"]},{"type":"verse","number":5,"content":["ད་དུང་མི་ལ་ན་རེ། ང་རང་ཁྱོད་ལས་གཙང་མ་ཡིན་པས། རྒྱང་ནས་སྡོད་དང་ངའི་ཉེ་སར་མ་བཏུད་ཅིག་ཅེས་སྨྲའོ། །དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་འདི་དག་བདག་གི་སྣ་ཁུང་ནང་གི་དུ་བ་དང་། ཉིན་ཧྲིལ་བོར་འབར་བའི་མེ་དེ་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["ལྟོས་དང་། དེ་ཐམས་ཅད་བདག་གི་མདུན་དུ་བྲིས་ཡོད་པས། ང་ཁ་རོག་མི་འདུག་པར་ལན་འཇལ་ཞིང་། དངོས་སུ་དེ་དག་གི་པང་དུ་ལན་འཇལ་ངེས་ཡིན།",{"noteId":23}]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གི་ཉེས་པ་དང་ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་ཀྱི་ཉེས་པའི་ལན་ཡང་ལྷན་ཅིག་ཏུ་འཇལ་དགོས་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས། ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གིས་རི་མགོ་དག་ནས་མཆོད་པ་ཕུལ་ཞིང་། སྤང་རིའི་སྟེང་དུ་བདག་ཁྱད་དུ་བསད་པས། དེ་དག་གིས་སྔར་ཅི་བྱས་པ་བཞིན་ངས་དེ་ཚོའི་པང་དུ་ལན་འཇལ་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ཡིས་རྒུན་འབྲུམ་ཆུན་པོ་ལས་རྒུན་ཆང་འབྱུང་བ་མཐོང་ནས། དེའི་ནང་དུ་དགེ་མཚན་ཡོད་པས་མེད་བརླག་གཏོང་མི་རུང་ཞེས་སྨྲ་བ་ལྟར། བདག་གིས་ཀྱང་རང་གི་ཞབས་ཕྱི་རྣམས་ཀྱི་རྐྱེན་གྱིས་དེ་བཞིན་བྱ་སྟེ། དེ་དག་ཐམས་ཅད་མེད་པར་མི་གཏོང་ངོ་། །"]},{"type":"verse","number":9,"content":["བདག་གིས་ཡ་ཀོབ་ལས་བུ་རྒྱུད་ཅིག་བསྐྱེད་དེ། ཡ་ཧུ་དཱའི་ཁྲོད་ནས་བདག་གི་རི་བོ་རྣམས་ལ་བདག་པོ་བདམས་ནས་དེ་རྣམས་ལ་བདག་བྱེད་དུ་འཇུག་དགོས། བདག་གི་ཞབས་ཕྱི་རྣམས་གནས་དེ་རུ་སྡོད་པར་འགྱུར།"]},{"type":"verse","number":10,"content":["བདག་འཚོལ་མཁན་འབངས་རྣམས་ཀྱི་ཕྱིར་དུ། ཤཱ་རོན་ཐང་ནི་ལུག་ཁྱུ་འཚོ་སའི་རྩྭ་ཐང་དང་། ཨ་ཀོར་ལུང་པ་ནི་ཕྱུགས་ཁྱུའི་མལ་ས་རུ་འགྱུར།"]},{"type":"verse","number":11,"content":["དེ་ལྟར་ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེ་སྤངས་ཤིང་། བདག་གི་རི་བོ་དམ་པ་བརྗེད་དེ། ལྷ་གལ་དཱིའི་",{"noteId":24},"ཕྱིར་དུ་གསོལ་ལྕོག་བསྒྲིགས་ཤིང་ལྷ་མིའུ་ནེའི་",{"noteId":25},"ཕྱིར་དུ་རྒུན་ཆང་སྡེབ་མས་ཕོར་བ་བཀང་བར་བྱེད་མཁན་ཁྱོད་ཅག་ལ་མཚོན་ན།"]},{"type":"verse","number":12,"content":["བདག་གིས་ཁྱོད་ཅག་རལ་གྲིའི་ཁར་གཏོད་པར་བྱ་ཞིང་། ཁྱོད་ཅག་ཚང་མས་མགོ་བསྒུར་ཏེ་གསོད་པར་འགྱུར། གང་ལ་ཞེ་ན། བདག་གིས་ཁྱོད་བོས་ཀྱང་ཨ་ལན་མ་སྤྲད་ལ། བདག་གིས་གཏམ་སྨྲས་ནའང་ཁྱོད་ཀྱིས་མ་མཉན་པར། བདག་གི་མིག་ནང་ངན་པ་གང་ཡིན་དེ་སྤྱད་ནས་བདག་མི་དགའ་བའི་དོན་རྣམས་བདམས་པས་སོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་བས་གཙོ་བོ་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གི་ཞབས་ཕྱི་རྣམས་ཀྱིས་ཁ་ཟས་སྤྱོད་ཀྱང་ཁྱོད་ཅག་ལྟོགས་པར་འགྱུར། ལྟོས་དང་། བདག་གི་ཞབས་ཕྱི་རྣམས་ཀྱིས་བཏུང་ཡང་ཁྱོད་ཅག་སྐོམ་པས་གདུང་། ཡང་ལྟོས་དང་། བདག་གི་ཞབས་ཕྱི་རྣམས་དགའ་ཡང་ཁྱོད་ཅག་ངོ་ཚ་བར་འགྱུར།"]},{"type":"verse","number":14,"content":["ལྟོས་དང་། བདག་གི་ཞབས་ཕྱི་རྣམས་ཀྱིས་སེམས་སྤྲོ་སྟེ་དགའ་འབོད་བྱེད་ཀྱང་། ཁྱོད་རྣམས་ཀྱིས་ཞེ་སྡུག་ནས་ངུ་འབོད་བྱེད་ཅིང་། སེམས་སྐྱོ་ནས་སྨྲེ་སྔགས་འདོན།"]},{"type":"verse","number":15,"content":["བདག་གིས་བདམས་པའི་མི་རྣམས་ལ་ཁྱོད་ཅག་གིས་རང་གི་མིང་ནི་དམོད་མོ་གཏོང་ཕྱིར་བསྐྱུར་ནས་འགྲོའོ། །གཙོ་བོ་ཡ་ཝཱེས་ཁྱོད་རྣམས་འཆི་བར་མཛད་པ་དང་། ཁོང་གི་ཞབས་ཕྱི་རྣམས་ལ་མིང་གཞན་ཞིག་གསོལ་བར་འགྱུར།"]},{"type":"verse","number":16,"content":["དེ་བས་ས་ནས་སུ་ཞིག་གིས་རང་ལ་བྱིན་རླབས་ཞུས་ན། བདེན་པའི་དཀོན་མཆོག་ལ་བརྟེན་ནས་བྱིན་རླབས་ཞུ་དགོས་པ་དང་། ས་ནས་སུ་ཞིག་གིས་མནའ་བསྐྱལ་ན། བདེན་པའི་དཀོན་མཆོག་ལ་བརྟེན་ནས་མནའ་བསྐྱལ་དགོས། གང་ལ་ཞེ་ན། སྔར་གྱི་དཀའ་སྡུག་རྣམས་མི་ཡིས་བརྗེད་ཅིང་། བདག་གི་མིག་མདུན་ནས་ཀྱང་དེ་དག་སྦས་པར་གྱུར་པའོ། །"]},{"type":"heading","content":["གནམ་ས་གསར་པ།"]},{"type":"verse","number":17,"content":["ལྟོས་དང་། བདག་གིས་ནམ་མཁའ་གསར་པ་དང་ས་གཞི་གསར་པ་བཀོད་དེ། སྔར་གྱི་དོན་རྣམས་དྲན་པར་མི་བྱ་ཞིང་། ཡིད་ལ་འཆར་བར་ཡང་མི་བྱ།"]},{"type":"verse","number":18,"content":["བདག་གིས་བཀོད་པ་དེའི་ཕྱིར་ཁྱོད་རྣམས་ནམ་ཡང་དགའ་བར་གྱུར་ཅིག གང་ལ་ཞེ་ན། བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ནི་དགའ་སྤྲོ་དང་། དེའི་མི་རྣམས་བདེ་སྐྱིད་ལ་བཀོད་དོ། །"]},{"type":"verse","number":19,"content":["བདག་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་ཕྱིར་དུ་སྤྲོ་ཞིང་། བདག་གི་མི་སྡེའི་ཕྱིར་དུ་དགའ་བ་ཡིན་ཏེ། ངུ་སྒྲ་དང་སྡུག་བསྔལ་གྱི་སྨྲེ་སྔགས་ཙམ་ཡང་དེ་དག་ལས་ཐོས་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":20,"content":["དེར་ཉིན་འགའི་ནང་འཆི་བའི་ཕྲུ་གུ་མེད་པ་དང་། ཚེ་ལོ་མཐར་མ་ཕྱིན་པའི་བགྲེས་པོ་ཡང་མེད། གང་ལ་ཞེ་ན། ལོ་བརྒྱ་ལོན་རྗེས་འཆི་བ་རྣམས་ད་དུང་གཞོན་པར་བརྩིས་པ་དང་། ལོ་བརྒྱ་མ་ལོན་པར་འཆི་བ་རྣམས་ནི་དམོད་མོ་ཐེབས་པར་བརྩིས་པ་ཡིན།"]},{"type":"verse","number":21,"content":["དེ་རྣམས་ཀྱིས་ཁང་པ་བཟོས་ནས་དེའི་ནང་དུ་སྡོད་ཅིང་། རྒུན་འབྲུམ་སྐྱེད་ཚལ་བཙུགས་ནས་དེའི་འབྲས་བུ་བཟའ་བར་འགྱུར།"]},{"type":"verse","number":22,"content":["བདག་གི་མི་སྡེ་ཡི་ཚེ་ནི་ལྗོན་ཤིང་བཞིན་དང་། བདག་གིས་བདམས་པའི་མི་རྣམས་ཀྱིས་རང་གི་ལག་པས་བཟོས་པ་དག་ལོངས་སུ་སྤྱོད་པས། དེ་དག་གིས་ཁང་པ་བཟོས་ནས་དེའི་ནང་དུ་གནས་པ་དང་། རྒུན་འབྲུམ་ར་བ་བཙུགས་ནས་དེའི་འབྲས་བུ་ལོངས་སུ་སྤྱོད་པར་བྱེད་དོ། །"]},{"type":"verse","number":23,"content":["དེ་དག་གིས་དོན་མེད་ཀྱི་ངལ་རྩོལ་མི་བྱེད་ཅིང་། དེ་དག་ལ་ཕྲུ་གུ་སྐྱེས་ཀྱང་འཆི་སྐྱོན་ཐེབས་པར་མི་འགྱུར། གང་ལ་ཞེ་ན། དེ་དག་ནི་རང་གི་བུ་རྒྱུད་དང་མཉམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་བྱིན་རླབས་བསྩལ་ཡོད་པའི་རིགས་རྒྱུད་ཡིན།"]},{"type":"verse","number":24,"content":["དུས་དེར། ཁོ་ཚོས་མ་ཞུས་སྔོན་ལ་བདག་གིས་བཀའ་ལན་བསྩལ་ཞིང་། དེ་དག་གི་སྐད་ཆ་མཇུག་མ་རྫོགས་སྔོན་ལ་བདག་གིས་ཉན་ངེས་ཡིན།"]},{"type":"verse","number":25,"content":["སྤྱང་ཀི་དང་ལུ་གུ་གཉིས་མཉམ་དུ་འཚོ་ཞིང་། སེང་གེས་གླང་ལྟར་རྩྭ་བཟའ་བ་དང་། ས་རྡུལ་ནི་སྦྲུལ་གྱི་ཁ་ཟས་ཡིན། བདག་གི་རི་བོ་དམ་པའི་གནས་སོ་སོ་རུ་དེ་དག་གིས་གནོད་པ་དང་གཏོར་བཤིག་གཏོང་བར་མི་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":23,"caller":"+","text":"འདིར་པང་དུ་ལན་འཇལ་ངེས་ཡིན་ཞེས་པ་ནི་ཡ་ཧུ་དཱ་པའི་བཤད་སྲོལ་ཡིན་ལ་ཅི་བྱས་བཞིན་ཡོངས་སུ་ལན་འཇལ་བའི་དོན་ལ་འཇུག","reference":{"chapter":65,"verse":6}},{"noteId":24,"caller":"+","text":"འདིར་ལྷ་གལ་དཱི་ཞེས་པ་ནི་གཡང་ལྷའམ་བསོད་ནམས་འགུག་པའི་ལྷ་ཡི་མིང་ཡིན་པར་གསུངས།","reference":{"chapter":65,"verse":11}},{"noteId":25,"caller":"+","text":"འདིར་ལྷ་མིའུ་ནེ་ཞེས་པ་ནི་སྔོན་ལས་ཀྱི་ལྷ་ཡི་མིང་ཡིན་པར་གསུངས།","reference":{"chapter":65,"verse":11}}]},"thisChapterLink":"/api/bod_ntb/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}