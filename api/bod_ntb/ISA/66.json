{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ISA","translationId":"bod_ntb","name":"ཡེ་ཤ་ཡཱ།","commonName":"ཡེ་ཤ་ཡཱ།","title":"༄༅།།ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ།","order":23,"numberOfChapters":66,"sha256":"668bdedad9951f6c762c1160ef47a893ed4bc526064390ce3006a2093f911a3d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bod_ntb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་མི་རིགས་ཀུན་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ནམ་མཁའ་ནི་བདག་གི་བཞུགས་ཁྲི་དང་། ས་གཞི་ནི་བདག་གི་ཞབས་སྟེགས་ཡིན་པས། ཁྱོད་ཀྱིས་བདག་ལ་ས་གང་ནས་ཁང་པ་ཞིག་བཞེང་ངམ། བདག་ངལ་གསོ་སའི་གནས་ནི་གང་ཞིག་ཡིན་ནམ་ཞེས་གསུངས།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡང་འདི་སྐད་དུ། འདི་ཐམས་ཅད་བདག་གི་ལག་པས་བཀོད་པ་ཡིན་པས་འདི་ཐམས་ཅད་བྱུང་བ་ཡིན། འོན་ཀྱང་སེམས་སྡུག་ཅན་དང་ཁེངས་སྐྱུང་ཅན། བདག་གི་བཀའ་ཡི་ཕྱིར་འཇིགས་པའི་མི་ལ་ངས་བལྟ་བར་བྱ།"]},{"type":"verse","number":3,"content":["གླང་བསད་དེ་མཆོད་པར་ཕུལ་ནས་ཡང་མི་གསོད་པ་དང་། ལུ་གུ་མཆོད་པར་ཕུལ་ནས་ཡང་ཁྱིའི་སྐེ་གཅོག་པ། འབྲུ་མཆོད་ཕུལ་ནས་ཡང་ཕག་གི་ཁྲག་ཀྱང་འབུལ་བ། དྲན་གསོའི་སྤོས་དཀར་བདུག་ཅིང་སྐུ་འདྲ་སྟོང་བ་ལ་བསྟོད་པར་བྱེད་པ་དེ་དག་ནི་རང་གི་ལམ་ནང་འགྲུལ་ཞིང་། སེམས་སུ་རང་རང་སོ་སོའི་དོན་ཞེན་ལོག་རྣམས་ལ་དགའ་བ་ཡིན།"]},{"type":"verse","number":4,"content":["དེ་བས་བདག་གིས་ཀྱང་དེ་དག་ལ་སྡུག་བསྔལ་འབྱུང་བར་བྱས་ཏེ། ཁོ་ཚོ་གང་ལ་འཇིགས་པ་དེ་ཁོ་ཚོའི་སྟེང་དུ་འདྲེན་པར་བྱ། གང་ལ་ཞེ་ན། བདག་གིས་བོས་ཀྱང་ཨ་ལན་སྟེར་མཁན་མེད། བདག་གིས་གཏམ་བརྗོད་པའི་ཚེ་དེ་དག་གིས་མ་མཉན་པར། བདག་གི་མིག་ནང་ངན་པ་གང་ཡིན་དེ་སྤྱད་ནས་ང་མི་དགའ་བའི་དོན་རྣམས་བདམས་པའོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་གི་ཕྱིར་དུ་འཇིགས་པ་ཁྱོད་རྣམས་ཀྱིས་ཁོང་གི་བཀའ་ལ་མཉན་ཞིང་། ངའི་མིང་གི་རྐྱེན་གྱིས་ཁྱོད་ཅག་བསྐྲད་པའི་རང་གི་སྤུན་ཟླ་ཚོ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེར་གཟི་བརྗིད་འཐོབ་གྱུར་ཅིག ཁྱོད་ཚོའི་དགའ་སྤྲོ་ངེད་རྣམས་ལ་མཐོང་བར་གྱིས་ཞེས་སྨྲ་མཁན་དག་ངོ་ཚར་གཏོད་པར་འགྱུར།"]},{"type":"verse","number":6,"content":["གྲོང་ཁྱེར་ནས་འུར་སྒྲ་གྲགས་ཤིང་མཆོད་ཁང་ནས་སྒྲ་གྲགས་བྱུང་། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་སྐད་ཀྱིས་རང་གི་དགྲ་རྣམས་ལ་ལན་འཇལ་བ་ཡིན།"]},{"type":"verse","number":7,"content":["མོ་ལ་གཟེར་མ་བརྒྱབ་སྔོན་དུ་ཕྲུ་གུ་སྐྱེས་པ་དང་། ཟུག་རྔུ་མ་ལངས་གོང་དུ་བུ་ཞིག་སྐྱེས།"]},{"type":"verse","number":8,"content":["དོན་འདི་ལྟ་བུ་སུ་ཞིག་གིས་ཐོས་མྱོང་ངམ། དོན་འདི་འདྲ་བ་སུ་ཞིག་གིས་མཐོང་མྱོང་ངམ། ཉིན་གཅིག་གི་ཡུན་ལ་མི་རིགས་ཤིག་ཆགས་ནུས་སམ། རྒྱལ་ཁབ་ཅིག་གི་མི་ནི་སྐད་ཅིག་ཙམ་ལ་འབྱུང་ཐུབ་བམ། ཡིན་ཡང་ཛ་ཡན་ལ་ཟུག་གཟེར་བྱུང་མ་ཐག་རང་གི་ཕྲུ་གུ་རྣམས་སྐྱེས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["བདག་གིས་དེ་ལ་བུ་བཙའ་བར་བཅུག་ན་སྐྱེ་རུ་ཅི་ལ་མི་འཇུག་གམ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཤིང་། བདག་གིས་དེ་ལ་བུ་བཙའ་བར་བཅུག་ན་ཅིའི་ཕྱིར་དེ་ཡི་མངལ་སྒོ་བཅད་དེ་སྐྱེ་བར་མི་འཇུག་གམ་ཞེས་ཁྱོད་ཀྱི་དཀོན་མཆོག་གིས་གསུངས།"]},{"type":"verse","number":10,"content":["ཀྱེ་ཡེ་རུ་སཱ་ལེམ་ལ་དགའ་བ་ཁྱོད་རྣམས་མོ་དང་མཉམ་དུ་དགའ་ཞིང་སྤྲོ་བར་གྱུར་ཅིག དེ་ཡི་ཕྱིར་དུ་དགའ་བར་གྱིས། ཀྱེ་ཡེ་རུ་སཱ་ལེམ་གྱི་ཕྱིར་དུ་མྱ་ངན་ཞུ་མཁན་ཁྱོད་རྣམས་མོ་དང་ལྷན་ཅིག་རབ་ཏུ་དགའ་བར་གྱུར་ཅིག"]},{"type":"verse","number":11,"content":["དེ་ནི་ཁྱོད་རྣམས་ཀྱིས་མོའི་སེམས་གསོ་གནང་བའི་པང་ནས་ནུ་ཞོ་ཡིད་ཚིམ་པར་ནུ་བ་དང་། མོའི་ཕུན་སུམ་ཚོགས་པའི་གཟི་བརྗིད་ནང་དུ་འོ་མ་བཞོས་ནས་ཁྱོད་རྣམས་ཀྱིས་འཐུང་ཞིང་སྤྲོ་སྐྱིད་ལ་རོལ་བའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":12,"content":["ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་ཞི་བདེ་ནི་གཙང་པོ་བཞིན་དུ་མོ་ཡོད་སར་སླེབ་ཏུ་འཇུག་ཅིང་། རྒྱལ་ཕྲན་ཁག་གི་རྒྱུ་ནོར་མཐའ་དག་བཞུར་རྒྱུན་འཕེལ་བ་བཞིན་དུ་མོ་ཡོད་སར་འདྲེན་ངེས་ཡིན། ཁྱོད་རྣམས་ཀྱིས་ནུ་ཞོ་ནུས་དང་། མོས་ཁྱོད་རྣམས་མཆན་ལ་བཙིར་ནས་པང་དུ་འཛིན་པར་བྱའོ། །"]},{"type":"verse","number":13,"content":["ཨ་མས་རང་གི་བུ་ལ་སེམས་གསོ་བྱེད་པ་ལྟར། བདག་གིས་ཁྱོད་ལ་སེམས་གསོ་བྱེད་ཅིང་། ཡེ་རུ་སཱ་ལེམ་ནས་ཁྱོད་ལ་སེམས་གསོ་འཐོབ་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་དེ་མཐོང་ནས་སེམས་དགའ་ཞིང་། ཁྱོད་རྣམས་ཀྱི་རུས་པ་རྣམས་རྩྭ་སྔོན་བཞིན་རྒྱས་པར་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་ནི་ཉིད་ཀྱི་ཞབས་ཕྱི་རྣམས་ལ་མངོན་པར་མཛད་དེ། ཁོང་གི་དགྲ་རྣམས་ལ་ཐུགས་ཁྲོ་བར་འགྱུར་རོ། །"]},{"type":"heading","content":["མཐའ་མའི་ཐག་གཅོད་དང་དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་བརྗིད།"]},{"type":"verse","number":15,"content":["ལྟོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་མེའི་ནང་ནས་འབྱོན་པར་བྱ་སྟེ། ཁོང་གི་ཤིང་རྟ་རླུང་འཚུབ་བཞིན་དང་ཁོང་གི་བཀའ་བཀྱོན་མེ་ལྕེ་བཞིན་དུ་འབར་ནས་ཕེབས་པར་འགྱུར།"]},{"type":"verse","number":16,"content":["གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་མེ་ལྕེ་དང་རལ་གྲིས་ལུས་ཅན་ཐམས་ཅད་ལ་ཉེས་ཆད་གཅོད་ཅིང་། དཀོན་མཆོག་ཡ་ཝཱེས་མི་མང་པོ་འཆི་ལམ་དུ་བརྫང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":17,"content":["སྐྱེད་ཚལ་རྣམས་ཀྱི་ནང་དུ་འགྲོ་བར་རང་ཉིད་གཙང་མ་དང་དག་པར་བཟོས་ཏེ། གཅིག་རྗེས་གཉིས་མཐུད་ཀྱིས་ཕག་དང་བྱི་བའི་ཤ་དང་། ཞེན་ཁ་ལོག་པའི་རྫས་བཅས་ཟ་མཁན་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་མེད་པར་འགྲོའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":18,"content":["བདག་གིས་དེ་དག་གི་སྤྱོད་པ་དང་བསམ་བློ་རྟོགས་ཏེ། བདག་འོང་བ་ནི་རྒྱལ་ཕྲན་ཀུན་དང་མི་རིགས་ཐམས་ཅད་བསྡུ་བའི་ཕྱིར་ཡིན། དེ་དག་བདག་གི་གཟི་བརྗིད་ལ་བལྟ་རུ་འོང་བར་འགྱུར།"]},{"type":"verse","number":19,"content":["བདག་གིས་དེ་དག་གི་ཁྲོད་དུ་རྟགས་ཡ་མཚན་ཅན་བསྟན་ནས། ཁོ་ཚོའི་ནང་ནས་ཐར་བ་རྣམས་རྒྱལ་ཕྲན་ཀུན་ཏེ། ཐཱར་ཞིས་དང་ཕོལ། གཞུ་འཐེན་མཁན་གྱི་ལུ༌ཏི། ཐུ་བཱལ། ཡཱ་ཝན། བདག་གི་མིང་ཐོས་མེད་ལ་བདག་གི་གཟི་བརྗིད་ཀྱང་མཐོང་མེད་པའི་རྒྱང་རིང་གི་གླིང་ཕྲན་བཅས་ལ་གཏོང་བར་བྱ། དེ་དག་གིས་རྒྱལ་ཕྲན་ཀུན་ཏུ་བདག་གི་གཟི་བརྗིད་བསྒྲག་གོ །"]},{"type":"verse","number":20,"content":["ཡེས་ར་ཨེལ་པས་སྣོད་གཙང་མའི་ནང་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འབྲུ་མཆོད་འཁྱེར་ཡོང་བ་ནང་བཞིན། དེ་ཚོས་རྒྱལ་ཕྲན་ཀུན་ནས་རྟ་དང་། ཤིང་རྟ་དང་། ཁྱོགས་ཤིང་དང་། དྲེལ་དང་རྔ་མོང་སོགས་ཀྱིས་ཁྱོད་ཅག་གི་སྤུན་ཟླ་ཐམས་ཅད་བདག་གི་རི་དམ་པ་ཡེ་རུ་སཱ་ལེམ་དུ་འཁྲིད་འོང་ངོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":21,"content":["བདག་གིས་དེ་དག་གི་ཁྲོད་ནས་མི་འགའ་མཆོད་དཔོན་དང་ལེ་ཝི་པར་བསྐོ་བར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་བསྐྲུན་པའི་ནམ་མཁའ་གསར་པ་དང་ས་གཞི་གསར་པ་ནི་བདག་གི་མདུན་དུ་ཇི་ལྟར་གནས་པ་བཞིན། ཁྱོད་ཅག་གི་བུ་རྒྱུད་དང་མིང་གཉིས་ཀྱང་དེ་ལྟར་གནས་པར་འགྱུར།"]},{"type":"verse","number":23,"content":["མ་འོངས་པར་ཚེས་གཅིག་དང་ངལ་གསོ་བའི་ཉིན་མོ་གང་ཡིན་རུང་། མི་ཐམས་ཅད་བདག་གི་མདུན་དུ་འོངས་ཏེ་ཕྱག་འཚལ་བར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":24,"content":["དེ་ནས་དེ་ཚོ་ཕྱི་རོལ་ཏུ་སོང་ནས་བདག་ལ་གྱེན་ལོག་བྱས་པའི་མི་རྣམས་ཀྱི་རོ་ལ་བལྟ་བ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། དེ་དག་གི་འབུ་སྲིན་མི་འཆི་ལ། དེ་དག་གི་མེ་ཡང་མི་ཞིའོ། །དེ་དག་མི་ཐམས་ཅད་སྡང་བའི་རྫས་སུ་འགྱུར་རོ་ཞེས་གསུངས་སོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}