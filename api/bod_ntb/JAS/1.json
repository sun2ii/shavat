{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JAS","translationId":"bod_ntb","name":"ཡ་ཀོབ།","commonName":"ཡ་ཀོབ།","title":"༄༅། །ཡ་ཀོབ་ཀྱི་འཕྲིན་ཡིག","order":59,"numberOfChapters":5,"sha256":"9ce45b2574f1e6a6d657e69159ad8f1f94ed17ac287b8ae4e17b4dd2ef2f80cf","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":1,"content":[{"type":"heading","content":["འཕྲིན་ཡིག་བསྐུར༌ཡུལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་དང་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཞབས་ཕྱི་པ་ཡ་ཀོབ་བདག་གིས་ཐར་ཐོར་དུ་གནས་པའི་ཚོ་པ་བཅུ་གཉིས་",{"noteId":0},"ལ་འཕྲིན་ཡིག་སྤྲིངས་ཤིང༌། ཁྱོད་རྣམས་ལ་འཚམས་འདྲི༌ཞུའོ།།"]},{"type":"heading","content":["ཚོད་བགམ་དང་ཉམས་ཚོད་གཉིས་ཀྱི༌སྐོར།"]},{"type":"verse","number":2,"content":["བདག་གི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་དཀའ་སྡུག་སྣ་ཚོགས་ལ་འཕྲད༌དུས། དེ་ནི་དགའ་སྤྲོ་ཆེན་པོར་བརྩི་བར་བྱའོ།།"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། རང་གི་དད་པར་ཚོད་བརྟག་བྱས་པ་བརྒྱུད་ནས་བཟོད་སེམས་འབྱུང་བ་ནི་ཁྱོད་ཅག་གིས་ཀྱང་ཤེས་པས༌སོ།།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཅག་ནི་མ་ཚང་བ་མེད༌པར་ཡང་དག་པ་དང་ཕུལ་དུ་བྱུང་བར་འགྱུར་བའི་ཕྱིར། བཟོད་པའང་ཡོངས་སུ་རྫོགས་དགོས།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ལས་སུ་ཞིག་ལ་ཤེས་རབ་མི་ཚང་ན། བཀའ་བཀྱོན་མི་མཛད་ཅིང་མི་ཐམས་ཅད་ལ་གཏོང་ཕོད་ཆེ་བའི་དཀོན་མཆོག་ཁོང་ལ་ཞུས༌དང༌། ཁོང་གིས་གནང་བར་འགྱུར།"]},{"type":"verse","number":6,"content":["འོན༌ཀྱང༌། ཞུ་བ་བྱེད་པའི་དུས༌སུ། ཐེ་ཚོམ་སྤུ་ཙམ་ཡང་མེད་པར་དད་པའི་སྒོ་ནས་ཞུ་དགོས། ཅིའི་ཕྱིར་ཞེ་ན། མི་ཐེ་ཚོམ་ཅན་ནི་རྒྱ་མཚོའི་རྦ་རླབས་རླུང་གིས་དེད་ནས་དགུང་དུ་འཕྱུར་བ་དང་མཚུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":7,"content":["མི་འདི་ལྟ་བུས་གཙོ་བོ་ནས་ཅི་ཡང་འཐོབ་པར་བསམ་མི་དགོས༌ཏེ།"]},{"type":"verse","number":8,"content":["མི་བློ་གཉིས་ཅན་ནི་རང་གིས་སྒྲུབ་པའི་ལས་ཀུན་ལའང་བརྟན་པོ་མ་ཡིན་ནོ།།"]},{"type":"verse","number":9,"content":["སྤུན་ཟླ་གཉོམ་ཆུང་དེ་གོ་ས་འཕར་བར་དགའ་འོས༌ཤིང༌།"]},{"type":"verse","number":10,"content":["ཕྱུག་པོ་དེ་དམན་སར་ལྷུང་བ་ལའང་དགའ་འོས༌སོ། །ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་རྩྭ་མགོའི་མེ་ཏོག་དང་མཚུངས་པར་ཡལ་ངེས་ཏེ།"]},{"type":"verse","number":11,"content":["ཉི་མ་ཤར་བ་དང་ཚ་རླུང་གཡུགས་ནས་རྩྭ་སྔོན་སྐམས་ཤིང་མེ་ཏོག་སར་ལྷུང་བས་མཛེས་སྡུག་ཐམས་ཅད་ཡལ་བར་འགྱུར་བའི་ཕྱིར༌ཡིན། དཔེ་དེ་བཞིན་དུ་ཕྱུག་པོ་དེ་ཡང་རང་དོན་སྒྲུབ་བཞིན་པའི་སྐབས་སུ་ཉམས་པར་འགྱུར་རོ།།"]},{"type":"verse","number":12,"content":["ཚོད་བགམ་ལ་བཟོད་བསྲན་ཐུབ་པའི་མི་ནི་བྱིན་རླབས་ཅན་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། ཚོད་བགམ་བྱས་པའི་རྗེས་སུ། དཀོན་མཆོག་གིས་ཁོང་ཉིད་གཅེས་པར་འཛིན་པ་རྣམས་ལ་ཞལ་བཞེས་གནང་བའི་ཚེ་སྲོག་གི་ཅོད་པན་གནང་བར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":13,"content":["ཉམས་ཚོད་ལ་འཕྲད་པའི་དུས༌སུ། དཀོན་མཆོག་གིས་བདག་ལ་ཉམས་ཚོད་ལེན་བཞིན་གདའ་ཞེས་སུ་ཞིག་གིས་ཀྱང་སྨྲ་མི་རུང༌། ཅིའི་ཕྱིར་ཞེ་ན། ངན་པས་དཀོན་མཆོག་ལ་ཉམས་ཚོད་བྱ་མི་ནུས༌ལ། དཀོན་མཆོག་གིས་ཀྱང་སུ་ཞིག་ལའང་ཉམས་ཚོད་མི་མཛད་པས༌སོ།།"]},{"type":"verse","number":14,"content":["འོན༌ཀྱང༌། མི་རེ་རེ་རང་གི་འདོད་ཆགས་ཀྱིས་དྲངས་ཏེ་བསླུས་ན་ཉམས་ཚོད་འབྱུང་།"]},{"type":"verse","number":15,"content":["འདོད་ཆགས་མངལ་དང་ལྡན་པར་གྱུར་ན་སྡིག་པ་སྐྱེས༌ཤིང༌། སྡིག་པ་བྱས་ན་འཆི་བ་འབྱུང་ངོ་།།"]},{"type":"verse","number":16,"content":["བདག་གི་སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་བསླུ་བྲིད་འོག་ཏུ་མི་ཚུད་པར་གྱུར༌ཅིག"]},{"type":"verse","number":17,"content":["གནང་སྦྱིན་ལེགས་ཤིང་ཕུལ་དུ་བྱུང་བ་ཐམས་ཅད་ནི་སྟེང་ནས་བྱུང་བ༌དང༌། དེ་ནི་འོད་ཟེར་ཀུན་གྱི་མངའ་བདག་སྟེ་ཡབ་ལས་བྱུང༌ཞིང༌། ཁོང་ལ་འགྱུར་ལྡོག་མེད་ཅིང་འགུལ་སྐྱོད་ཀྱི་གྲིབ་མ་ཙམ་ཡང་མེད་དོ།།"]},{"type":"verse","number":18,"content":["བདག་ཅག་ནི་ཁོང་གིས་བསྐྲུན་པ་ཐམས་ཅད་ལས་ཐོག་མར་སྨིན་པའི་འབྲས་བུ་ལྟ་བུར་འགྱུར་བའི༌ཕྱིར། ཁོང་གིས་རང་ཉིད་ཀྱི་ཐུགས་དགོངས་བཞིན་བདེན་པ་ཉིད་ཀྱི་བཀའ་བརྒྱུད་ནས་བདག་ཅག་སྐྱེ་བར་མཛད་པ་ལགས༌སོ།།"]},{"type":"heading","content":["བཀའ་ལ་མཉན་པ་དང་བཀའ་ལྟར་བསྒྲུབ་དགོས་པའི༌སྐོར།"]},{"type":"verse","number":19,"content":["བདག་གི་སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་གིས་ཤེས་གསལ༌ལྟར། ཁྱོད་རྣམས་མི་རེ་རེ་ནི་རྣ་བས་ཉན་པ་ལ་མྱུར་དགོས༌ཤིང༌། ངག་ནས་སྨྲ་བ་དང་སེམས་ནས་ཁྲོ་བ་ལ་དལ་དགོས་སོ།།"]},{"type":"verse","number":20,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མིའི་ཁོང་ཁྲོས་དཀོན་མཆོག་གི་རྣམ་པར་དག་པའི་ལས་བསྒྲུབ་མི་ནུས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":21,"content":["དེ་བས་ཁྱོད་ཅག་གིས་མི་གཙང་བ་དང་ངན་པས་གང་བ་ཐམས་ཅད་སྤངས༌ཏེ། ཞི་ཞིང་དུལ་བའི་སེམས་བཅངས་ནས་ཁྱོད་ཅག་གི་ནང་དུ་བཙུགས་ཡོད་པ་དང་ཁྱོད་ཅག་གི་བླ་སྲོག་སྐྱོབ་ནུས་པའི་བཀའ་དེ་ཁས་ལེན་དགོས།"]},{"type":"verse","number":22,"content":["ཁྱོད་རྣམས་ནི་རང་མགོ་རང་གིས་གཡོག་ཅིང་བཀའ་ལ་ཉན་མཁན་ཁོ་ནར་མི་འགྱུར་བར་བཀའ་བཞིན་དུ་སྒྲུབ་མཁན་དུ་གྱུར༌ཅིག"]},{"type":"verse","number":23,"content":["རྒྱུ་མཚན་ནི་སུ་ཞིག་གིས་བཀའ་ལ་ཉན་པ་ལས་བཀའ་ལྟར་མི་སྒྲུབ་པ་ནི་མི་ཞིག་གིས་མེ་ལོང་ལས་རང་གི་ངོ་གདོང་མཐོང་བ་དང་མཚུངས༌ལ།"]},{"type":"verse","number":24,"content":["མིག་གིས་མཐོང་ཞིང་ཕར་སོང་མ་ཐག་རང་ཉིད་ཀྱི་བཞིན་རས་ཇི་འདྲ་ཡིན་པ་བརྗེད་པ་ཡིན་ནོ།།"]},{"type":"verse","number":25,"content":["འོན༌ཀྱང༌། སུ་ཞིག་གིས་ཕུལ་དུ་བྱུང་བ་དང་རང་དབང་འཐོབ་པར་བྱེད་པའི་བཀའ་ཁྲིམས་ལ་རྒྱུན་དུ་ཞིབ་ལྟ་བྱས་ནས་བརྩི་སྲུང་བྱེད་ན། བཀའ་ལ་ཉན་མ་ཐག་བརྗེད་པ་མིན་པར་དངོས་སུ་དེ་ལྟར་བསྒྲུབས༌པས། ཁོས་སྒྲུབ་པའི་དོན་ཐམས་ཅད་ལ་བྱིན་རླབས་འཐོབ་པར་འགྱུར་ངེས༌སོ།།"]},{"type":"verse","number":26,"content":["གལ༌ཏེ། སུ་ཞིག་གིས་རང་ཉིད་ཆོས་སེམས་ཅན་ཡིན་པར་བསམས་ཀྱང༌། རང་གི་སྨྲ་ལྕེ་ལ་བདག་མི་བྱེད་པར། རང་མགོ་རང་གིས་གཡོག་པར་བྱེད༌ན། མི་དེའི་ཆོས་ལ་སྙིང་པོ་མེད་དོ།།"]},{"type":"verse","number":27,"content":["བདག་ཅག་གི་ཡབ་དཀོན་མཆོག་གི་སྤྱན༌སྔར། ཡང་དག་ཅིང་དྲི་མས་མ་གོས་པའི་ཆོས་ནི་དཀའ་སྡུག་གིས་ཁེངས་པའི་དྭ་ཕྲུག་དང་ཡུགས་མོ་ལ་བདག་སྐྱོང་བྱེད་པ་དང༌། འཇིག་རྟེན་གྱི་དྲི་མ་རང་ཉིད་ལ་མི་འགོས་པར་སྲུང་བ་དེའོ།།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འདིར་ཚོ་པ་བཅུ་གཉིས་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་ཚོ་པ་བཅུ་གཉིས་ལ་གོ་དགོས།","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/JAS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JAS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HEB/13.json","previousChapterAudioLinks":{},"numberOfVerses":27}