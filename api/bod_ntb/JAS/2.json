{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JAS","translationId":"bod_ntb","name":"ཡ་ཀོབ།","commonName":"ཡ་ཀོབ།","title":"༄༅། །ཡ་ཀོབ་ཀྱི་འཕྲིན་ཡིག","order":59,"numberOfChapters":5,"sha256":"9ce45b2574f1e6a6d657e69159ad8f1f94ed17ac287b8ae4e17b4dd2ef2f80cf","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":2,"content":[{"type":"heading","content":["ཕྱོགས་རིས་གཟུང་མི་རུང་བའི༌སྐོར།"]},{"type":"verse","number":1,"content":["བདག་གི་སྤུན་ཟླ༌རྣམས། ཁྱོད་རྣམས་ཀྱིས་བདག་ཅག་གི་གཟི་བརྗིད་ཆེ་བའི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ལ་དད་པ་བྱེད་པས་མི་གཞན་ལ་ཕྱོགས་རིས་འཛིན་མི་རུང་ངོ༌།།"]},{"type":"verse","number":2,"content":["གལ༌ཏེ། གསེར་གྱི་མཛུབ་དཀྲིས་དང་གོས་ཆེན་གྱོན་པའི་མི་ཞིག་ཁྱོད་ཅག་གི་ཚོགས་རའི་ནང་དུ་ཡོང༌བ་དང༌། གོས་ཧྲུལ་གྱོན་པའི་དབུལ་པོ་ཞིག་ཀྱང་ཡོང་བ་ཡིན༌ན།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཅག་གིས་གོས་ཆེན་གྱོན་མཁན་ལ་བརྩི་མཐོང་བྱས༌ཏེ། ཁྱེད་རང་གྲལ་མགོ་ནས་བཞུགས་རོགས་མཛོད་ཅེས་སྨྲ་བ༌དང༌། དབུལ་པོ་དེ་ལ་ཁྱོད་རང་གནས་དེར་ལངས་ནས་སྡོད་ཅིག་ཅེས་སྨྲ་བའམ། ཡང་ན་བདག་གི་ཞབས་སྟེགས་ཀྱི་གམ་དུ་སྡོད་ཅིག་ཅེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":4,"content":["དེ་ནི་ཁྱོད་ཅག་གིས་མི་ལ་ཕྱོགས་རིས་བཟུང་ཞིང༌། ངན་སེམས་བཅངས་ནས་མི་ལ་ཁ་ཚོན་གཅོད་མཁན་དུ་གྱུར་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":5,"content":["བདག་གི་སྙིང་ནས་བརྩེ་བའི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་གིས་ཉོན༌དང༌། དཀོན་མཆོག་གིས་འཇིག་རྟེན་གྱི་དབུལ་པོ་རྣམས་བདམས་ཏེ་དད་པའི་ཕྱོགས་ནས་ཕྱུག་པོར་མཛད་པར་མ༌ཟད། ཁོང་ཉིད་གཅེས་པར་འཛིན་མཁན་རྣམས་ཁོང་གིས་ཞལ་བཞེས་གནང་བའི་རྒྱལ་སྲིད་འཛིན་མཁན་དུ་བདམས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":6,"content":["འོན༌ཀྱང༌། ཁྱོད་ཅག་གིས་དབུལ་པོ་རྣམས་ལ་མཐོང་ཆུང་བྱས་ཤིང་། ཕྱུག་པོ་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་གཉའ་གནོན་བྱས་ནས་ཁྲིམས་རར་འདྲུད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":7,"content":["ཕྱུག་པོ་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་ཐོགས་པའི་དམ་པའི་མཚན་ལ་སྐུར་བ་བཏབ་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":8,"content":["གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁྱོད་ཀྱིས་ཁྱིམ་མཚེས་ལ་རང་དང་འདྲ་བར་གཅེས་ཤིག་ཅེས་གསུངས་ཤིང་། གལ༌ཏེ། ཁྱོད་ཅག་གིས་དངོས་གནས་བླ་ན་མེད་པའི་བཀའ་ཁྲིམས་དེ་བཞིན་དུ་བྱེད༌ན། ཁྱོད་རྣམས་ཀྱིས་ལེགས་པོར་བྱས་པ་ཡིན་ནོ།།"]},{"type":"verse","number":9,"content":["འོན༌ཀྱང༌། ཁྱོད་ཅག་གིས་མི་ལ་ཕྱོགས་རིས་བཟུང་ན་དེ་ནི་སྡིག་པ་བྱས་པ་ཡིན༌ཏེ། བཀའ་ཁྲིམས་ལྟར་ཁྱོད་ཅག་ནི་བཀའ་ཁྲིམས་དང་འགལ་མཁན་དུ་བརྩིས༌སོ།།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སུ་ཞིག་གིས་བཀའ་ཁྲིམས་ཐམས་ཅད་བསྲུངས༌ནའང༌། དེ་ལས་གཅིག་དང་འགལ༌ན། དེ་ནི་བཀའ་ཁྲིམས་ཐམས་ཅད་ལ་འགལ་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["མ་གཞི་ལོག་གཡེམ་མ་བྱེད་ཅེས་གསུང་མཁན་གྱིས་མི་མ་གསོད་ཅེས་ཀྱང་གསུངས་པ་ཡིན། ཁྱོད་ཀྱིས་ལོག་གཡེམ་མི་བྱེད་ནའང་མི་གསོད་པ་ཡིན༌ན། ཁྱོད་ནི་བཀའ་ཁྲིམས་དང་འགལ་བ་ཡིན༌ནོ།།"]},{"type":"verse","number":12,"content":["མི་ལ་རང་དབང་འཐོབ་པར་བྱེད་པའི་བཀའ་ཁྲིམས་ཀྱིས་ཁྱོད་ཅག་ལ་ལེགས་ཉེས་ཀྱི་ཁྲིམས་ཐག་གཅོད༌ངེས་པས། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་རང་གི་སྨྲ་བརྗོད་དང་སྤྱོད་ལམ་ནི་བཀའ་ཁྲིམས་དེ་བཞིན་དུ་བྱ་འོས་སོ།།"]},{"type":"verse","number":13,"content":["རྒྱུ་མཚན་ནི་མི་གཞན་ལ་སྙིང་རྗེ་མི་བྱེད་མཁན་ལ་སྙིང་རྗེ་མེད་པའི་ཁྲིམས་ཆད་ཕོག་པར་འགྱུར་བའི་ཕྱིར༌ཡིན། ཐུགས་རྗེ་ནི་ཉེས་ཆད་ལས་རྣམ་པར་རྒྱལ་བ་ཡིན༌ནོ།།"]},{"type":"heading","content":["དད་པ་དང་བྱ་སྤྱོད་ཀྱི༌སྐོར།"]},{"type":"verse","number":14,"content":["བདག་གི་སྤུན་ཟླ༌རྣམས། མི་ཞིག་གིས་རང་ཉིད་ལ་དད་པ་ཡོད་ཅེས་སྨྲས༌ཀྱང༌། དེ་དང་མཐུན་པའི་སྤྱོད་བཟང་མེད༌ན། དེ་ལ་ཕན་ཐོགས་ཅི་ཡོད༌དམ། དད་པ་དེ་ལྟ་བུས་ཁོ་རང་སྐྱོབ་ནུས༌སམ།"]},{"type":"verse","number":15,"content":["གལ༌ཏེ། སྤུན་ཟླའམ་ལྕམ་སྲིང་ཞིག་ལ་གྱོན་གོས་མེད་ལ་ཉིན་རེ་བཞིན་ཁ་ཟས་ཀྱང་མེད༌ན།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ལས་གཅིག་གིས་དེ་ལ་འདི༌ལྟར། བདེ་བའི་ངང་ཕྱིར་སོང་དང༌། ཁྱོད་རང་གི་ལུས་རྒྱབ་དྲོ་ཞིང་ལྟོ་བ་འགྲང་བར་སྨོན་ཞེས་སྨྲས༌ནའང༌། མི་དེའི་ལུས་ལ་གང་ཞིག་མཁོ་བ་མ་སྦྱིན༌ཚེ། དེ་ལ་ཕན་ཐོགས་ཅི་ཡོད༌དམ།"]},{"type":"verse","number":17,"content":["དེ་བཞིན་དུ་སྤྱོད་བཟང་མེད་པའི་དད་པ་ནི་འཆི་བ་ཡིན་ནོ།།"]},{"type":"verse","number":18,"content":["མི་གཞན་ཞིག་ན༌རེ། ཁྱོད་ལ་དད་པ་ཡོད་ལ། བདག་ལ་སྤྱོད་བཟང་ཡོད། ཁྱོད་ཀྱིས་བདག་ལ་སྤྱོད་བཟང་མེད་པའི་དད་པ་སྟོན༌དང༌། བདག་གིས་རང་གི་སྤྱོད་བཟང་བརྒྱུད་ནས་རང་གི་དད་པ་ཁྱོད་ལ་སྟོན་པར༌བྱའོ་ཞེས་སྨྲ་ངེས་སོ།།"]},{"type":"verse","number":19,"content":["ཁྱོད་ཀྱིས་དཀོན་མཆོག་གཅིག་རང་ཡིན་པ་ལ་དད་པ་བྱེད་པས། ཁྱོད་ཀྱི་དད་པ་དེ་ནི་ལེགས༌པོ་མ་ཡིན་ནམ། གདོན་འདྲེ་དག་གིས་ཀྱང་དཀོན་མཆོག་ལ་ཡིད་ཆེས༌བྱེད་ཀྱང༌། ཁོང་ལ་འཇིགས་ཤིང་སྐྲག་སྟེ་འདར་བ་ཡིན་ནོ།།"]},{"type":"verse","number":20,"content":["བླུན་པོ་ཁྱོད་ཀྱིས་སྤྱོད་བཟང་མེད་པའི་དད་པ་ནི་འཆི་བ་ཡིན་པ་ཤེས་འདོད༌དམ།"]},{"type":"verse","number":21,"content":["བདག་ཅག་གི་མེས་པོ་ཨབ་ར་ཧམ་གྱིས་རང་གི་བུ་ཨི་སཱག་མཆོད་ཁྲིའི་སྟེང་དུ་མཆོད་པར་ཕུལ་ཞིང༌། སྤྱོད་བཟང་དེ་ལ་བརྟེན་ནས་ཁོང་ནི་མི་རྣམ་དག་ཏུ་བརྩིས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":22,"content":["དད་པ་དང་སྤྱོད་བཟང་གཉིས་མཉམ་དུ་གནས་པར་མ༌ཟད། ཁོང་གི་དད་པ་ནི་སྤྱོད་བཟང་ལ་བརྟེན་ནས་ཆ་ཡོངས་སུ་རྫོགས་ཡོད་པ་རྟོགས་ནུས་སོ།།"]},{"type":"verse","number":23,"content":["གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཨབ་ར་ཧམ་གྱིས་དཀོན་མཆོག་ལ་དད་པ་བྱས་པ་དང་དཀོན་མཆོག་གིས་ཀྱང་ཁོང་ནི་མི་རྣམ་དག་ཏུ་བརྩིས་པ་ཡིན་ཞེས་གསུངས་པ་བཞིན་དུ་གྲུབ་པ༌དང༌། ཨབ་ར་ཧམ་ནི་དཀོན་མཆོག་གི་མཛའ་གྲོགས་སུ་འབོད་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":24,"content":["དེའི༌ཕྱིར། མི་ཞིག་རྣམ་དག་ཏུ་བརྩི་བ་ནི་དད་པ་འབའ་ཞིག་ལ་བརྟེན་པ་མ་ཡིན་པར་སྤྱོད་བཟང་ལའང་རག་ལས་པ་རྟོགས་ནུས་སོ།།"]},{"type":"verse","number":25,"content":["དེ་བཞིན༌དུ། སྨད་འཚོང་མ་རཱ་ཧབ་ཀྱིས་བང་ཆེན་རྣམས་ལ་སྣེ་ལེན་བྱས༌ཤིང༌། ཡང་བང་ཆེན་རྣམས་ལམ་གཞན་བརྒྱུད་ནས་ཕྱིར་བཏང་བས། སྤྱོད་བཟང་ལ་བརྟེན་ནས་ཁོ་མོ་ནི་མི་རྣམ་དག་ཏུ་བརྩིས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":26,"content":["དེའི༌ཕྱིར། ལུས་པོ་ནི་རྣམ་ཤེས་དང་ཁ་བྲལ་ན་བེམ་པོ་ཡིན་པ༌བཞིན། དད་པའང་སྤྱོད་བཟང་དང་ཁ་བྲལ་ན་འཆི་བ་ཡིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JAS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JAS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JAS/1.json","previousChapterAudioLinks":{},"numberOfVerses":26}