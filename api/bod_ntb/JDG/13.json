{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":13,"content":[{"type":"heading","content":["སཱམ་སོན་སྐྱེས་པ།"]},{"type":"verse","number":1,"content":["ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ལོ་ངོ་བཞི་བཅུའི་རིང་ལ་ཕེ་ལེ་ཤེད་པའི་ལག་ཏུ་སྤྲད་དོ། །"]},{"type":"verse","number":2,"content":["དུས་དེར་ཚོར་ཨ་པ་ཞིག་ཡོད་ལ་དཱན་གྱི་ཚོ་པར་གཏོགས་ཤིང་མིང་ལ་མ་ནོ་ཨ་ཞེས་བྱ་བ་དང་། དེའི་ཆུང་མར་མངལ་མི་སྦྲུམ་ལ་ཕྲུ་གུ་སྐྱེས་མི་ཐུབ་བོ། །"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཞིག་བུད་མེད་དེར་མངོན་ཞིང་འདི་སྐད་དུ། ལྟོས་དང་། ཁྱོད་རང་སྔར་ནས་མངལ་མི་སྦྲུམ་ལ་ཕྲུ་གུ་སྐྱེས་རྒྱུ་མེད་ནའང་། ད་ནི་ཁྱོད་ལ་མངལ་སྦྲུམ་ནས་བུ་ཞིག་སྐྱེ་ངེས་ཡིན།"]},{"type":"verse","number":4,"content":["དེ་བས་ཁྱོད་ཀྱིས་གཟབ་གཟབ་བྱེད་དགོས་ཏེ། རྒུན་ཆང་དང་ཨ་རག་གར་པོ་གང་ཡང་འཐུང་མི་རུང་ལ། མི་གཙང་བའི་རིགས་ཀྱང་གང་ཡང་བཟའ་མི་རུང་།"]},{"type":"verse","number":5,"content":["ལྟོས་དང་། ཁྱོད་ལ་མངལ་སྦྲུམ་ནས་བུ་ཞིག་སྐྱེ་ངེས་ཤིང་། དེའི་མགོ་ལ་སྐྲ་གྲིས་རེག་མི་ཆོག ཅི་ལ་ཞེ་ན། ཕྲུ་གུ་འདི་ནི་སྐྱེས་མ་ཐག་ནས་དཀོན་མཆོག་ལ་གཏོགས་ཤིང་ལོགས་སུ་བཀར་བའི་མི་རུ་འགྱུར་ལ། ཁོས་ཡེས་ར་ཨེལ་པ་རྣམས་བསྐྱབས་ཏེ་ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱི་ལག་ནས་ཐར་དུ་འཇུག་པར་རྩོམ་པ་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":6,"content":["དེ་ནས་བུད་མེད་དེ་ཕྱིར་ལོག་ནས་སྐྱེས་པ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། དཀོན་མཆོག་གི་སྐྱེས་བུ་ཞིག་ངའི་མདུན་དུ་སླེབས་ཤིང་དེའི་ཞལ་རས་ནི་དཀོན་མཆོག་གི་ཕོ་ཉའི་ཞལ་རས་དང་མཚུངས་ལ་ཤིན་ཏུ་གུས་ཞུམ་བྱེད་འོས་པར་སྣང་། ངས་ཁོང་ཉིད་གང་ནས་འོངས་པ་མ་དྲིས། ཁོང་གིས་ཀྱང་ཉིད་ཀྱི་མཚན་ང་ལ་གསུངས་མ་བྱུང་།"]},{"type":"verse","number":7,"content":["ཡིན་ནའང་ཁོང་གིས་བདག་ལ་འདི་སྐད་དུ། ལྟོས་དང་། ཁྱོད་ལ་མངལ་སྦྲུམ་ནས་བུ་ཞིག་སྐྱེ་ངེས་ཡིན། དེ་བས་ཁྱོད་ཀྱིས་རྒུན་ཆང་དང་ཨ་རག་གར་པོ་གང་ཡང་འཐུང་མི་རུང་ལ། མི་གཙང་བའི་རིགས་ཀྱང་གང་ཡང་བཟའ་མི་རུང་། ཅི་ལ་ཞེ་ན། ཕྲུ་གུ་འདི་ནི་སྐྱེས་མ་ཐག་ནས་འཆི་བའི་བར་དུ་དཀོན་མཆོག་ལ་གཏོགས་ཤིང་ལོགས་སུ་བཀར་བའི་མི་རུ་འགྱུར་ཞེས་གསུངས་བྱུང་ཞེས་པ་ལ།"]},{"type":"verse","number":8,"content":["མ་ནོ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་བ་ཕུལ་ནས་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ལགས། སྐྱེ་བར་འགྱུར་བའི་ཕྲུ་གུ་དེ་ཅི་ལྟར་སྐྱོང་དགོས་པ་ངེད་ཅག་ལ་མཛུབ་སྟོན་གནང་བའི་ཆེད་དུ། ཁྱེད་ཀྱིས་དཀོན་མཆོག་གི་སྐྱེས་བུ་དེ་ཡང་བསྐྱར་ངེད་ཀྱི་རྩར་མངགས་པར་མཛོད་ཅེས་ཞུས།"]},{"type":"verse","number":9,"content":["དེར་དཀོན་མཆོག་གིས་མ་ནོ་ཨ་ཡི་ཞུ་བར་གསན་ཏེ། བུད་མེད་དེ་ཞིང་ཁར་སྡོད་པའི་སྐབས་སུ་དཀོན་མཆོག་གི་ཕོ་ཉ་ཡང་བསྐྱར་ཁོ་མོའི་གམ་དུ་སླེབས། ཡིན་ནའང་ཁོ་མོའི་སྐྱེས་པ་མ་ནོ་ཨ་ཁོ་མོ་དང་མཉམ་དུ་མེད་པ་རེད།"]},{"type":"verse","number":10,"content":["བུད་མེད་མྱུར་བ་མྱུར་དུ་བརྒྱུགས་སོང་སྟེ་སྐྱེས་པར་ན་རེ། ལྟོས་དང་། ཉིན་དེར་ངའི་མདུན་དུ་འོངས་པའི་མི་དེ་ཡང་བསྐྱར་ང་ལ་མངོན་བྱུང་ཞེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":11,"content":["མ་ནོ་ཨ་ཡར་ལངས་ཏེ་རང་གི་ཆུང་མའི་རྗེས་འབྲངས་ནས་མི་དེའི་དྲུང་དུ་སླེབས་ནས་འདི་ལྟར། བུད་མེད་འདིར་གསུང་གནང་མཁན་ནི་ཁྱེད་རང་ཡིན་ནམ་ཞེས་དྲིས་པ་ལ། ཁོང་གིས་ང་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":12,"content":["དེ་ནས་མ་ནོ་ཨ་ན་རེ། ཁྱེད་ཀྱི་གསུང་བཞིན་འགྲུབ་པར་ཤོག ངེད་ཅག་གིས་ཕྲུ་གུ་དེ་ཅི་ལྟར་སྐྱོང་དགོས་པ་དང་། ཕྱིས་སུ་ཁོ་རང་ཅི་འདྲ་ཡིན་དགོས་སམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་མ་ནོ་ཨ་ལ་འདི་སྐད་དུ། བདག་གིས་བུད་མེད་ལ་སྨྲས་པའི་དོན་ཐམས་ཅད་ཀྱི་ཐད་ཁོ་མོས་གཟབ་གཟབ་བྱེད་དགོས།"]},{"type":"verse","number":14,"content":["རྒུན་ཤིང་ལས་ཐོགས་པ་ཐམས་ཅད་བཟའ་མི་རུང་ཞིང་། རྒུན་ཆང་དང་ཨ་རག་གར་པོ་གང་ཡིན་ཡང་འཐུང་མི་རུང་ལ། མི་གཙང་བའི་རིགས་ཀྱང་གང་ཡང་བཟའ་མི་རུང་། ངས་ཅི་བསྒོས་པ་ཐམས་ཅད་ཁོ་མོས་བསྲུང་དགོས་ཞེས་གསུངས།"]},{"type":"verse","number":15,"content":["མ་ནོ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལ་འདི་ལྟར། ངེད་ཅག་གིས་ཁྱེད་ལ་ར་ཕྲུག་ཅིག་སྟ་གོན་བྱེད་པའི་ཕྱིར། ཁྱེད་རང་ཡུད་ཙམ་ལ་བཞུགས་རོགས་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་མ་ནོ་ཨ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ང་རང་བཀག་ནའང་ངས་ཁྱོད་ཀྱི་ཟས་མི་ཟ། གལ་ཏེ་ཁྱོད་ཀྱིས་སྦྱིན་སྲེག་གི་མཆོད་པ་སྟ་གོན་བྱེད་ན་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་བར་འོས་ཞེས་གསུངས་པ་སྟེ། མ་གཞི་མ་ནོ་ཨས་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཡིན་པ་མ་ཤེས་སོ། །"]},{"type":"verse","number":17,"content":["མ་ནོ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལ་འདི་ལྟར། ཁྱེད་ཀྱི་གསུང་ལྟར་འགྲུབ་པའི་ཚེ། ངེད་ཅག་གིས་ཁྱེད་ལ་བཀུར་བ་བྱེད་པའི་ཆེད་དུ་ཁྱེད་ཀྱི་མཚན་ང་ལ་གསུང་རོགས་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཁོ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ངའི་མིང་འདྲི་དོན་ཅི། ངའི་མིང་ནི་ངོ་མཚར་ཅན་ཞིག་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":19,"content":["དེ་ནས་མ་ནོ་ཨས་ཕ་བོང་ཞིག་གི་སྟེང་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ར་ཕྲུག་ཅིག་དང་འབྲུ་མཆོད་ཕུལ་བ་དང་། ཕོ་ཉས་དོན་ངོ་མཚར་ཅན་མཛད་པར་མ་ནོ་ཨ་དང་ཁོའི་ཆུང་མ་གཉིས་ཀྱིས་དེར་བལྟས་པ་ལ།"]},{"type":"verse","number":20,"content":["མཆོད་ཁྲིའི་སྟེང་ནས་མེ་ལྕེ་གྱེན་དུ་འཕྱུར་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་མཆོད་ཁྲི་སྟེང་གི་མེ་ལྕེ་ཁྲོད་ཡར་འཕགས་པ་མཐོང་། མ་ནོ་ཨ་དང་ཁོའི་ཆུང་མ་གཉིས་ཀྱིས་དེ་མཐོང་སྟེ་ཁ་སར་གཏད་ནས་བསྡད།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་དེ་མ་ནོ་ཨ་དང་ཁོའི་ཆུང་མ་གཉིས་ལ་ཡང་བསྐྱར་མ་མངོན་ཞིང་། མ་ནོ་ཨས་ད་གཟོད་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཡིན་པ་ཤེས་སོ། །"]},{"type":"verse","number":22,"content":["མ་ནོ་ཨས་རང་གི་ཆུང་མར་འདི་ལྟར་སྨྲས་པ་སྟེ། བདག་ཅག་གིས་དཀོན་མཆོག་མཇལ་བས་འཆི་བར་ངེས་ཞེས་པ་ལ།"]},{"type":"verse","number":23,"content":["ཁོའི་ཆུང་མ་ན་རེ། གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་བདག་ཅག་གསོད་པར་དགོངས་ན། ཁོང་གིས་བདག་ཅག་གི་ལག་ནས་སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་མཆོད་བཞེས་མི་སྲིད་ཅིང་། དོན་འདི་ཐམས་ཅད་བདག་ཅག་ལ་སྟོན་པར་མི་འགྱུར་ལ། དེ་རིང་བཀའ་འདི་རྣམས་བདག་ཅག་ལ་གསུང་བར་ཡང་མི་འགྱུར་ཞེས་སྨྲས།"]},{"type":"verse","number":24,"content":["ཕྱིས་སུ་བུད་མེད་དེས་བུ་ཞིག་བཙས་ཤིང་མིང་ལ་སཱམ་སོན་ཞེས་བཏགས། ཕྲུ་གུ་ཆེར་སྐྱེས་པ་དང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་བྱིན་རླབས་གནང་།"]},{"type":"verse","number":25,"content":["ཚོར་ཨ་དང་ཨེ་སི་ཐ་ཨོལ་གྱི་མཚམས་སུ་ཡོད་པའི་མ་ཧ་ནེ་དཱན་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཉིད་ཀྱིས་སཱམ་སོན་ལ་སྐུལ་སློང་མཛད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JDG/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}