{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":16,"content":[{"type":"heading","content":["སཱམ་སོན་དང་དི་ལེ་ལཱ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སཱམ་སོན་ནི་གཱ་ཟཱ་རུ་སླེབས་ཤིང་དེར་སྨད་འཚོང་མ་ཞིག་མཐོང་ནས་དེ་དང་མཉམ་དུ་བསྡད།"]},{"type":"verse","number":2,"content":["མི་ཞིག་གིས་གཱ་ཟཱ་པ་རྣམས་ལ་སཱམ་སོན་འདི་རུ་སླེབས་འདུག་ཅེས་ཞུས་པ་ན། དེ་ཚོས་ཁོ་རང་བསྐོར་ནས་མཚན་གང་པོར་གྲགས་འགུལ་ཅི་ཡང་མེད་པར་མཁར་སྒོ་རུ་འཇབ་སྒུག་བྱས་པ་དང་། ནམ་ལངས་པའི་དུས་སུ་བདག་ཅག་གིས་ཁོ་གསོད་པར་བྱ་ཞེས་སྨྲས།"]},{"type":"verse","number":3,"content":["སཱམ་སོན་ཉལ་ནས་ནམ་གུང་ལ་སླེབས་པ་དང་ཡར་ལངས་ཏེ་མཁར་སྒོའི་སྒོ་གླེགས་གཉིས་ཀ་དང་སྒོ་རུ། སྒོ་གཏན་བཅས་ཐམས་ཅད་བླངས་ནས་ཕྲག་ལ་ཁུར་ཏེ་ཧེབ་རོན་མདུན་ཕྱོགས་ཀྱི་རི་རྩེ་ཞིག་ལ་ཁྱེར།"]},{"type":"verse","number":4,"content":["དེའི་རྗེས་སུ་སཱམ་སོན་ནི་སོ་རེག་གྲོག་མོ་རུ་མིང་ལ་དི་ལེ་ལཱ་བྱ་བའི་བུད་མེད་ཅིག་ལ་དགའ་བར་གྱུར།"]},{"type":"verse","number":5,"content":["ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཡར་བུད་མེད་དེའི་རྩར་ཕྱིན་ཏེ་ན་རེ། ཁྱོད་ཀྱིས་སཱམ་སོན་བསླུས་ནས་ཁོ་རང་ལ་ཅིའི་ཕྱིར་སྟོབས་ཤུགས་ཆེན་པོ་དེ་འདྲ་ལྡན་པ་དང་། ཐབས་བཀོད་གང་ཞིག་གིས་ངེད་ཅག་ཁོ་ལས་རྒྱལ་ཐུབ་པ་རྩད་ཨེ་ཆོད་བལྟ་རོགས། དེ་ནས་ཁོ་རང་བཀྱིགས་ནས་འདུལ་བར་བྱ། ངེད་ཅག་མི་རེས་ཁྱོད་ལ་དངུལ་སྲང་ཆིག་སྟོང་དང་བརྒྱ་རེ་སྟེར་བར་བྱ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":6,"content":["དི་ལེ་ལཱ་ཡིས་སཱམ་སོན་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་ལ་ཅིའི་ཕྱིར་སྟོབས་ཤུགས་ཆེན་པོ་དེ་འདྲ་ལྡན་པ་དང་། ཐབས་བཀོད་གང་ཞིག་གིས་ཁྱོད་རང་བཀྱིགས་ནས་འདུལ་ཐུབ་པ་ང་ལ་སྨྲ་བར་མཛོད་ཅེས་པ་ན།"]},{"type":"verse","number":7,"content":["སཱམ་སོན་ན་རེ། གལ་ཏེ་སུ་ཞིག་གིས་འབྲེང་བུ་རློན་པ་བདུན་གྱིས་ང་རང་བཀྱིགས་ན། ང་ནི་སྟོབས་ཉམས་ནས་མི་གཞན་དང་འདྲ་བར་འགྱུར་རོ་ཞེས་སྨྲས།"]},{"type":"verse","number":8,"content":["དེ་ནས་ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཀྱིས་འབྲེང་བུ་རློན་པ་བདུན་ཁྱེར་ཡོང་སྟེ་བུད་མེད་དེར་སྤྲད་ཅིང་། ཁོ་མོས་སཱམ་སོན་ཐག་པས་བཀྱིགས་པ་རེད།"]},{"type":"verse","number":9,"content":["སྐབས་དེར་མི་འགའ་ཞིག་གིས་སྔ་མོ་ནས་བུད་མེད་ཀྱི་ཁང་པ་སྦུག་མ་རུ་འཇབ་སྒུག་བྱས་ཡོད་ཅིང་། བུད་མེད་ན་རེ། ཀྱེ་སཱམ་སོན། ཕེ་ལེ་ཤེད་པ་རྣམས་ཁྱོད་རང་འཛིན་དུ་འོངས་པ་རེད་ཅེས་སྨྲས་པ་ལ། སཱམ་སོན་གྱིས་གསོ་སྐུད་མེ་ལ་ཐུག་ན་ཆད་འགྲོ་བ་བཞིན་འབྲེང་བུ་རྣམས་བཅད། དེ་ལྟར་མི་རྣམས་ཀྱིས་ཁོའི་སྟོབས་ཤུགས་ཀྱི་འབྱུང་རྩ་མ་ཤེས་སོ། །"]},{"type":"verse","number":10,"content":["དི་ལེ་ལཱ་ཡིས་སཱམ་སོན་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ལྟོས་དང་། ཁྱོད་ཀྱིས་ང་ལ་མགོ་གཡོགས་ཏེ་རྫུན་སྨྲས་པ་རེད། ད་ནི་ཁྱོད་རང་ཐབས་བཀོད་གང་ཞིག་གིས་བཀྱིག་ནུས་པ་ང་ལ་སྨྲ་བར་མཛོད་ཅེས་པར།"]},{"type":"verse","number":11,"content":["སཱམ་སོན་ན་རེ། གལ་ཏེ་སུ་ཞིག་གིས་ཐག་པ་གསར་པ་བཀོལ་མ་མྱོང་བ་རྣམས་ཀྱིས་ང་རང་བཀྱིགས་ན། ང་ནི་སྟོབས་ཉམས་ནས་མི་གཞན་དང་འདྲ་བར་འགྱུར་རོ་ཞེས་སྨྲས་པས།"]},{"type":"verse","number":12,"content":["དི་ལེ་ལཱ་ཡིས་ཐག་པ་གསར་པས་ཁོ་རང་བཀྱིགས་ནས་འདི་ལྟར་སྨྲས་པ་སྟེ། ཀྱེ་སཱམ་སོན། ཕེ་ལེ་ཤེད་པ་རྣམས་ཁྱོད་རང་འཛིན་དུ་འོངས་པ་རེད་ཅེས་པ་དང་། སྐབས་དེར་མི་འགའ་ཞིག་གིས་སྔ་མོ་ནས་ཁང་པ་སྦུག་མ་རུ་འཇབ་སྒུག་བྱས་ཡོད་པ་ལ། སཱམ་སོན་གྱིས་དཔུང་པའི་ཐག་པ་དེ་སྐུད་པ་རྐྱ་གཅིག་གཅོད་པ་བཞིན་དུ་བཅད་པ་རེད།"]},{"type":"verse","number":13,"content":["དེ་ནས་དི་ལེ་ལཱ་ཡིས་སཱམ་སོན་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་ཀྱིས་ད་དུང་ང་ལ་མགོ་གཡོགས་ཏེ་རྫུན་སྨྲས་པ་རེད། ཐབས་བཀོད་གང་ཞིག་གིས་ཁྱོད་རང་བཀྱིག་ནུས་པ་ང་ལ་སྨྲ་བར་མཛོད་ཅེས་པ་ལ། སཱམ་སོན་ན་རེ། ཁྱོད་ཀྱིས་ངའི་སྐྲ་ལན་གྱི་སྣེ་བདུན་པོ་ཐགས་དང་མཉམ་དུ་བཏགས་པས་ཆོག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":14,"content":["དི་ལེ་ལཱ་ཡིས་ཁོའི་སྐྲ་ལན་གྱི་སྣེ་མོ་རྣམས་ཐགས་དང་མཉམ་དུ་བཏགས་ཤིང་ཕུར་བས་བརྡབས་ནས་ཁོ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཀྱེ་སཱམ་སོན། ཕེ་ལེ་ཤེད་པ་རྣམས་ཁྱོད་རང་འཛིན་དུ་འོངས་པ་རེད་ཅེས་པ་ན། སཱམ་སོན་གཉིད་ལས་སད་དེ། ཐགས་ཁྲི་སྟེང་གི་ཕུར་བ་དང་ཐགས་བཅས་ཐམས་ཅད་བལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་དི་ལེ་ལཱ་ཡིས་སཱམ་སོན་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་ཀྱིས་བདག་ལ་སེམས་མི་སྟེར་བས་ཁྱོད་ང་ལ་དགའ་ཞེས་ཟེར་དོན་ཅི་ཡིན་ནམ། ཁྱོད་ཀྱིས་ཐེངས་གསུམ་དུ་ང་ལ་མགོ་གཡོགས་པ་སྟེ། ཁྱོད་ལ་ཅིའི་ཕྱིར་སྟོབས་ཆེན་པོ་འདི་འདྲ་ཡོད་པ་བདག་ལ་མ་སྨྲས་ཞེས་པའོ། །"]},{"type":"verse","number":16,"content":["དི་ལེ་ལཱ་ཡིས་ཉིན་རྒྱུན་ཁོ་ལ་ནན་གྱིས་བསྐུལ་བས། ཁོ་རང་སེམས་འཁྲུགས་ནས་ཐ་ན་འཆི་དགོས་པའི་ཚད་ལ་སླེབས་པ་དང་།"]},{"type":"verse","number":17,"content":["སཱམ་སོན་གྱིས་རང་གི་སྙིང་གཏམ་ཡོད་ཚད་ཁོ་མོ་ལ་སྨྲས་ཏེ་ན་རེ། ང་རང་ནི་སྐྱེས་མ་ཐག་ནས་དཀོན་མཆོག་ལ་གཏོགས་ཤིང་ལོགས་སུ་བཀར་བའི་མི་རུ་གྱུར་པ་ཡིན་པས། ངའི་སྐྲ་ལོ་ནི་ནམ་ཡང་སྐྲ་གྲིས་བཞར་མྱོང་མེད། གལ་ཏེ་མི་ཞིག་གིས་ངའི་སྐྲ་ལོ་བཞར་ན་ངའི་སྟོབས་ཤུགས་ང་དང་བྲལ་ནས། ང་རང་སྟོབས་ཉམས་ནས་མི་གཞན་དང་འདྲ་བར་འགྱུར་འགྲོ་ཞེས་སྨྲས།"]},{"type":"verse","number":18,"content":["དི་ལེ་ལཱ་ཡིས་ཁོས་སྙིང་གཏམ་ཡོད་ཚད་ཁོ་མོར་སྨྲས་པ་མཐོང་ནས། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཀྱི་རྩར་མི་མངགས་ཏེ་ན་རེ། ཁོས་སྙིང་གཏམ་ཡོད་ཚད་བདག་ལ་སྨྲས་ཟིན་པས་ཁྱེད་རྣམས་ཡང་བསྐྱར་ཐེངས་གཅིག་ཡར་ཕེབས་རོགས་ཞེས་སྨྲས་པ་ལ། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་ཀྱིས་ལག་ལ་དངུལ་ཁྱེར་ནས་བུད་མེད་དེའི་རྩར་ཕྱིན།"]},{"type":"verse","number":19,"content":["དི་ལེ་ལཱ་ཡིས་སཱམ་སོན་རང་གི་པང་ལ་སྔས་ཏེ་གཉིད་དུ་བཅུག་པ་དང་། མི་ཞིག་བོས་ཡོང་སྟེ་ཁོའི་མགོ་ཡི་སྐྲ་ལན་གྱི་སྣེ་བདུན་པོ་འབྲེག་ཏུ་བཅུག་ཅིང་། དི་ལེ་ལཱ་ཡིས་ཁོ་རང་ངོ་ཚར་སྦྱར་བ་དང་ཁོའི་སྟོབས་ཤུགས་ཁོ་དང་བྲལ་ཏོ། །"]},{"type":"verse","number":20,"content":["དེར་ཁོ་མོ་ན་རེ། ཀྱེ་སཱམ་སོན། ཕེ་ལེ་ཤེད་པ་རྣམས་ཁྱོད་འཛིན་དུ་འོངས་པ་རེད་ཅེས་སྨྲས་པ་ལ། སཱམ་སོན་གཉིད་ལས་སད་ཅིང་སེམས་སུ། བདག་སྔར་བཞིན་ཕྱི་རོལ་ཏུ་སོང་སྟེ་འཆིང་བ་ལས་ཐར་དགོས་སྙམ་ནའང་། ཁོས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁོ་དང་བྲལ་ཟིན་པ་མ་ཤེས་སོ། །"]},{"type":"verse","number":21,"content":["ཕེ་ལེ་ཤེད་པ་རྣམས་ཀྱིས་ཁོ་རང་བཟུང་སྟེ་མིག་གཉིས་བཏོན་ཅིང་མར་གཱ་ཟཱ་རུ་ཁྲིད་ནས་ལི་སྒྲོག་བརྒྱབ་པ་དང་། ཁོས་བཙོན་ཁང་དུ་རང་འཐག་བསྐོར་ནས་བསྡད།"]},{"type":"verse","number":22,"content":["ཡིན་ནའང་ཁོའི་སྐྲ་ནི་བཞར་བའི་རྗེས་སུ་ཡང་བསྐྱར་སྐྱེས་པའོ། །"]},{"type":"heading","content":["སཱམ་སོན་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":23,"content":["ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་རྣམས་དེ་དག་གི་ལྷ་དཱ་གོན་ལ་དམར་མཆོད་རྒྱ་ཆེན་པོ་འབུལ་བ་དང་སྤྲོ་སྤྲོ་གཏོང་བའི་ཕྱིར་འཛོམས་པ་སྟེ། ཁོ་རྣམས་ཀྱིས། བདག་ཅག་གི་ལྷ་ཡིས་དགྲ་བོ་སཱམ་སོན་བདག་ཅག་གི་ལག་ཏུ་སྤྲད་པ་རེད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":24,"content":["མི་རྣམས་ཀྱིས་སཱམ་སོན་མཐོང་ནས་ཁོ་ཚོའི་ལྷ་ལ་བསྟོད་བསྔགས་བརྗོད་དེ་འདི་ལྟར་སྨྲས་པ་སྟེ། རང་ཅག་གི་ཡུལ་རྣམས་བརླག་ཅིང་། རང་ཅག་ལས་མི་མང་པོ་གསོད་མཁན་དགྲ་བོ་དེ་ནི་བདག་ཅག་གི་ལྷ་ཡིས་རང་རེའི་ལག་ཏུ་སྤྲད་པ་རེད་ཅེས་པའོ། །"]},{"type":"verse","number":25,"content":["ཁོ་རྣམས་ཀྱིས་སྤྲོ་སྐྱིད་ལ་རོལ་བའི་དུས་སུ། སཱམ་སོན་བོས་ཡོང་སྟེ་ངེད་ཅག་གི་མདུན་དུ་ལྟད་མོ་སྟོན་ཅིག་ཅེས་སྨྲས་པ་ལ། ཁོ་ཚོས་སཱམ་སོན་བཙོན་ཁང་ནས་ཕྱིར་ཁྲིད་ཡོང་བ་དང་། ཁོས་མི་རྣམས་ཀྱི་མདུན་དུ་བཞད་གད་བསླངས་ཤིང་། དེ་དག་གིས་ཁོ་རང་ཀ་བ་གཉིས་ཀྱི་བར་ལ་འགྲེང་དུ་བཅུག"]},{"type":"verse","number":26,"content":["དེ་ནས་སཱམ་སོན་གྱིས་ཁོའི་ལག་པ་འཛིན་མཁན་བྱིས་པ་དེར་འདི་ལྟར་སྨྲས་པ་སྟེ། ང་རང་ཁང་པ་འདེགས་བྱེད་ཀ་བ་འདིར་བརྟེན་ཕྱིར་དེ་ལ་རེག་ཏུ་འཇུག་རོགས་ཞེས་པའོ། །"]},{"type":"verse","number":27,"content":["དུས་དེར་ཁང་པའི་ནང་དུ་སྐྱེས་པ་དང་བུད་མེད་ཀྱིས་གང་ཞིང་། ཕེ་ལེ་ཤེད་པའི་འགོ་དཔོན་ཐམས་ཅད་ཀྱང་དེར་ཡོད་པ་རེད། ཁང་ཐོག་ཏུ་སཱམ་སོན་གྱི་བཞད་གད་ལ་ལྟད་མོ་ལྟ་མཁན་སྐྱེས་ཕོ་མོ་ཧ་ལམ་སུམ་སྟོང་ཡོད་པའོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་སཱམ་སོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ང་རང་ཐུགས་ལ་དགོངས་པར་མཛོད། ཀྱེ་དཀོན་མཆོག་ལགས། བདག་གིས་ཕེ་ལེ་ཤེད་པ་རྣམས་ལས་ངའི་མིག་ཟུང་བཏོན་པར་དགྲ་ཤ་ལེན་པའི་ཕྱིར། ཐེངས་འདི་ཁོ་ནར་ཁྱེད་ཀྱིས་ང་ལ་སྟོབས་ཤུགས་གནང་བར་མཛོད་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":29,"content":["སཱམ་སོན་གྱིས་ཁང་པའི་དཀྱིལ་དབུས་སུ་ཡོད་པའི་འདེགས་བྱེད་ཀ་བ་དེ་གཉིས་ལ་འཇུས་པ་སྟེ། གཡོན་ལག་གིས་གཅིག་དང་གཡས་ལག་གིས་གཅིག་ལ་འཇུས་ནས་ན་རེ།"]},{"type":"verse","number":30,"content":["ང་རང་ཕེ་ལེ་ཤེད་པ་རྣམས་དང་མཉམ་དུ་འཆི་བར་ཤོག་ཅེས་སྨྲས་པ་དང་། སྟོབས་ཤུགས་ཡོད་རྒུས་འཕུལ་རྒྱག་བྱས་པ་ལ། ཁང་པ་བརྡིབས་ནས་འགོ་དཔོན་རྣམས་དང་ཁང་པའི་ནང་གི་མི་ཐམས་ཅད་མནན་པ་རེད། དེ་ལྟར་སཱམ་སོན་གྱིས་ཚེ་ལས་འདའ་བའི་དུས་སུ་བསད་པའི་མི་ནི་ཁོ་གསོན་པའི་དུས་སུ་བསད་པ་ལས་ཀྱང་མང་བའོ། །"]},{"type":"verse","number":31,"content":["དེ་ནས་སཱམ་སོན་གྱི་སྤུན་རྣམས་དང་ཁོའི་ཕ་གཞིས་ཐམས་ཅད་མར་ཁོའི་བེམ་པོ་ལེན་དུ་ཕྱིན་པ་དང་། ཁྱེར་ཡོང་ནས་ཚོར་ཨ་དང་ཨེ་སི་ཐ་ཨོལ་གཉིས་ཀྱི་བར་དུ་ཁོའི་ཕ་སྟེ་མ་ནོ་ཨ་ཡི་དུར་ས་རུ་བསྐུངས། ཁོ་ལོ་ངོ་ཉི་ཤུའི་རིང་ལ་ཡེས་ར་ཨེལ་གྱི་ཁྲིམས་དཔོན་བྱས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JDG/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/15.json","previousChapterAudioLinks":{},"numberOfVerses":31}