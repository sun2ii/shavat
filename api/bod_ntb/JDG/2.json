{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":2,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་པོ་ཀིམ་དུ་མངོན་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ནི་གིལ་གལ་ནས་ཡར་པོ་ཀིམ་དུ་སླེབས་ཤིང་ཡེས་ར་ཨེལ་པ་རྣམས་ལ། བདག་གིས་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཁྲིད་དེ་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ལ་མནའ་བསྐྱལ་ནས་ཞལ་བཞེས་གནང་བའི་ཡུལ་འདིར་འོངས་པ་ཡིན། ཡང་ངས་ཁྱོད་རྣམས་དང་བཞག་པའི་ཞལ་ཆད་ནི་ནམ་ཡིན་ཡང་འདོར་བར་མི་བྱ་ཞིང་།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཡུལ་འདིའི་མི་རྣམས་དང་ཁ་ཆད་བཞག་མི་ཆོག་ལ། ཁོ་ཚོའི་མཆོད་ཁྲི་བཤིག་དགོས་ཞེས་གསུངས་ནའང་། ཁྱོད་ཚོས་ངའི་བཀའ་ལ་མ་མཉན་པར་འདི་ལྟར་བྱེད་དོན་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":3,"content":["དེའི་ཕྱིར་ངས་ཡང་ཁྱོད་ཅག་ལ། བདག་གིས་ཁོ་ཚོ་ནི་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་ཕྱིར་སྐྲོད་པར་མི་བྱ་སྟེ། ཁོ་ཚོ་ནི་ཁྱོད་རྣམས་ཀྱི་རྩིབ་འོག་གི་ཚེར་མ་ལྟ་བུར་འགྱུར་ངེས་ཤིང་། ཁོ་ཚོའི་ལྷ་རྣམས་ནི་ཁྱོད་ཅག་གི་རྙི་རྒྱ་རུ་འགྱུར་ངེས་ཞེས་སྨྲའོ་ཞེས་གསུངས།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་འདི་ལྟར་སྨྲ་བའི་སྐབས་སུ། འབངས་རྣམས་སྐད་ཆེན་པོས་ངུས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁོ་ཚོས་ཡུལ་དེའི་མིང་ལ་པོ་ཀིམ་",{"noteId":1},"ཞེས་བཏགས་པ་དང་། མི་རྣམས་ཀྱིས་གནས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་ཕུལ་ཏོ། །"]},{"type":"heading","content":["ཡོ་ཤུ་ཨ་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":6,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡེས་ར་ཨེལ་གྱི་འབངས་རྣམས་མངགས་པ་དང་། ཁོ་ཚོ་རང་རང་གི་ས་སྐལ་དུ་སོང་ནས་ས་བཟུང་བའོ། །"]},{"type":"verse","number":7,"content":["ཡོ་ཤུ་ཨ་གསོན་པའི་དུས་ཀུན་དང་ཡོ་ཤུ་ཨ་ཚེ་ལས་འདས་རྗེས། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་དོན་དུ་མཛད་པའི་དོན་ཆེན་ཐམས་ཅད་མཇལ་བའི་རྒན་པོ་རྣམས་ད་དུང་ཡོད་པའི་དུས་ཡོངས་སུ། འབངས་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་ཞུས་སོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་སྟེ་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་དགུང་ལོ་བརྒྱ་དང་བཅུ་རུ་སོན་ནས་ཚེ་ལས་འདས་པ་དང་།"]},{"type":"verse","number":9,"content":["ཡེས་ར་ཨེལ་པས་ཁོང་ནི་ཁོང་གི་ས་སྐལ་གྱི་མངའ་ཁོངས་ཏེ། གཱ་ཨ་སི་རི་བོའི་བྱང་ཕྱོགས་སུ་ཨེ་ཕཱར་ཡིམ་རི་ཁུལ་གྱི་ཐིམ་ནད་ཧེ་རེ་སི་རུ་དུར་ལ་སྦས།"]},{"type":"verse","number":10,"content":["དུས་རབས་དེའི་མི་ཐམས་ཅད་ཀྱང་རང་རང་གི་མེས་པོ་རྣམས་ཀྱི་དྲུང་དུ་འཛོམས་པ་དང་། རྗེས་སུ་དུས་རབས་གསར་པའི་མི་རྣམས་བྱུང་ཞིང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་མི་ཤེས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱིར་མཛད་པའི་དོན་རྣམས་ཀྱང་མི་ཤེས་སོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་དོར་བ།"]},{"type":"verse","number":11,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་ཅིང་། པཱ་ཨལ་རྣམས་ལ་བསྙེན་བཀུར་བྱས་པ་དང་།"]},{"type":"verse","number":12,"content":["ཁོ་ཚོ་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཁྲིད་མཁན་ཡ་ཝཱེ་སྟེ་ཁོ་ཚོའི་མེས་པོ་རྣམས་ཀྱི་དཀོན་མཆོག་བསྐྱུར་ཏེ། ལྷ་གཞན་པ་སྟེ་ཉེ་འཁོར་གྱི་མི་སྡེ་དག་གི་ལྷ་རྣམས་ལ་ཕྱག་བཙལ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་སེམས་དཀྲུགས་པར་མ་ཟད།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་བསྐྱུར་ནས་པཱ་ཨལ་དང་ཨ་ཤཱ་ཏ་རོད་ལ་བསྙེན་བཀུར་བྱས་སོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཐུགས་ཁྲོས་ནས། ཁོ་རྣམས་འཕྲོག་བཅོམ་བྱེད་མཁན་གྱི་ལག་ཏུ་སྤྲད་ནས་དེ་དག་གིས་ཁོ་རྣམས་ལ་འཕྲོག་བཅོམ་བྱས་པ་དང་། ཡང་ཁོ་རྣམས་མཐའ་འཁོར་གྱི་དགྲ་ཟླའི་ལག་ཏུ་སྤྲད་ཅིང་། ཐ་ན་དེ་རྣམས་དགྲ་བོའི་མདུན་དུ་ཚུགས་མ་ཐུབ་བོ། །"]},{"type":"verse","number":15,"content":["ཁོ་རྣམས་གང་དུ་སོང་ནའང་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ཇི་ལྟར་གསུངས་པ་དང་ཡང་ཁོང་གིས་ཁོ་རྣམས་ལ་ཇི་ལྟར་མནའ་བཞེས་པ་བཞིན་དུ། བགེགས་བར་ཆད་ཀྱིས་ཁོ་རྣམས་ལ་རྒོལ་བས། ཁོ་ཚོས་དཀའ་སྡུག་ཆེན་པོ་མྱངས།"]},{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྲིམས་དཔོན་རྣམས་བསྐོས་པ།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོའི་དོན་དུ་ཁྲིམས་དཔོན་རྣམས་བསྐོས་ཤིང་། ཁྲིམས་དཔོན་གྱིས་ཁོ་རྣམས་འཕྲོག་བཅོམ་བྱེད་མཁན་གྱི་ལག་ནས་ཐར་བར་བྱས།"]},{"type":"verse","number":17,"content":["ཡིན་ནའང་ཁོ་ཚོས་ཁྲིམས་དཔོན་གྱི་བཀའ་ལ་མི་ཉན་པར་ལྷ་གཞན་གྱི་རྗེས་སུ་འབྲངས་ཏེ་དེར་ཕྱག་བཙལ་ནས་ལོག་གཡེམ་བྱས་པ་དང་། མྱུར་བ་མྱུར་དུ་ཁོ་ཚོའི་མེས་པོ་རྣམས་འགྲིམས་པའི་ལམ་དང་བྲལ་ཏེ། ཁོ་ཚོའི་མེས་པོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བརྩི་སྲུང་བྱེད་པ་བཞིན་དུ་མ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོའི་དོན་དུ་ཁྲིམས་དཔོན་བསྐོས་ཤིང་དེ་རྣམས་དང་མཉམ་དུ་བཞུགས། ཁྲིམས་དཔོན་རྣམས་འཚོ་བཞུགས་ཡོད་པའི་སྐབས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་དགྲ་བོའི་ལག་ནས་ཐར་བར་མཛད་པ་སྟེ། ཅི་ལ་ཞེ་ན། ཁོ་རྣམས་ཀྱིས་མནར་གཅོད་དང་གནོད་འཚེ་འོག་ཏུ་སྨྲེ་སྔགས་བཏོན་པས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ལ་སྙིང་རྗེ་འཁྲུངས་པའོ། །"]},{"type":"verse","number":19,"content":["དེ་ནས་ཁྲིམས་དཔོན་ཚེ་ལས་འདས་རྗེས་ཁོ་རྣམས་བློ་ཁ་འགྱུར་ནས་ངན་པའི་ལས་བྱས་ཤིང་ཁོ་ཚོའི་མེས་པོ་རྣམས་ལས་ཀྱང་ཐུ་སྟེ། ལྷ་གཞན་རྣམས་ལ་བསྙེན་བཀུར་བྱས་ནས་ཕྱག་བཙལ་ཞིང་། ཨུ་ཚུགས་ཀྱི་སྤྱོད་ཚུལ་ངན་པ་ནམ་ཡང་རྒྱུན་མ་ཆད་དོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཐུགས་ཁྲོས་ནས་འདི་སྐད་དུ། མི་རིགས་འདིས་བདག་གིས་ཁོ་ཚོའི་མེས་པོ་རྣམས་ལ་བསྲུང་བར་བསྒོས་པའི་ཞལ་ཆད་དང་འགལ་ཞིང་ངའི་བཀའ་ལ་མི་ཉན་པས།"]},{"type":"verse","number":21,"content":["ཡོ་ཤུ་ཨ་ཚེ་ལས་འདས་པའི་སྐབས་སུ་ལྷག་པའི་མི་རིགས་གཞན་རྣམས་ད་ནི་བདག་གིས་ཁོ་ཚོའི་སྔུན་ནས་ཕྱིར་སྐྲོད་པར་མི་བྱ་སྟེ།"]},{"type":"verse","number":22,"content":["ཅི་ལ་ཞེ་ན། འདི་བརྒྱུད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཚོད་བགམ་བྱེད་དེ། ཁོ་རྣམས་ཀྱིས་ཁོ་ཚོའི་མེས་པོ་རྣམས་བཞིན་དུ་ངའི་བཀའ་ལ་མཉན་མིན་བལྟ་བར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ལྟར་དཀོན་མཆོག་ཡ་ཝཱེས་མི་རིགས་དེ་རྣམས་མྱུར་བ་མྱུར་དུ་ཕྱིར་མ་བསྐྲད་པར་བསྐྱུར་ཅིང་། ཡོ་ཤུ་ཨ་ཡི་ལག་ཏུ་ཡང་མ་སྤྲད་དོ། །"]}],"footnotes":[{"noteId":1,"caller":"+","text":"པོ་ཀིམ་ཞེས་པ་ནི་ངུ་བའི་དོན་ཡིན།","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/bod_ntb/JDG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}