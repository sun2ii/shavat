{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":6,"content":[{"type":"heading","content":["གིད་ཡོན།"]},{"type":"verse","number":1,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ངན་པ་གང་ཡིན་དེ་སྤྱད་པས། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་དག་ལོ་ངོ་བདུན་གྱི་རིང་ལ་མིད༌ཡཱན་པའི་ལག་ཏུ་སྤྲད་ཅིང་།"]},{"type":"verse","number":2,"content":["མིད་ཡཱན་པས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བཙན་གནོན་བྱས་པ་དང་། ཡང་མིད༌ཡཱན་པའི་རྐྱེན་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རི་ཁྲོད་དུ་བྲག་ཕུག་དང་བྲག་ཁུང་། མཁར་རྫོང་བཅས་པ་བཟོས་སོ། །"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ས་བོན་བཏབ་ཟིན་པའི་དུས་སུ། མིད་ཡཱན་པ་དང་ཨ་མཱད་ལེག་པ། ཤར་ཕྱོགས་པ་ཐམས་ཅད་ཡར་ཁོ་རྣམས་ལ་འཐབ་ཏུ་འོངས་པ་དང་།"]},{"type":"verse","number":4,"content":["ཁོ་རྣམས་ཀྱི་ཁ་གཏད་དུ་དམག་སྒར་བཏབ་ནས་གཱ་ཟཱའི་བར་དུ་ལོ་ཏོག་མེད་པར་བཟོས་ཤིང་། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཟ་རྒྱུ་དང་བ་གླང་། ལུག བོང་བུ་སོགས་ཅི་ཡང་མ་བསྐྱུར་ཏོ། །"]},{"type":"verse","number":5,"content":["རྒྱུ་མཚན་ནི་དེ་རྣམས་ཀྱིས་ཕྱུགས་ཟོག་དེད་ནས་གུར་དང་བཅས་ཡོང་བ་ནི་འབུ་ཆ་ག་པ་ལྟར་མང་ལ། མི་དང་རྔ་མོང་ནི་བགྲང་ལས་འདས་ཤིང་ཐམས་ཅད་ཡོང་སྟེ་ཡུལ་དེ་རྩ་བ་ནས་བརླགས་པའོ། །"]},{"type":"verse","number":6,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་མིད་ཡཱན་པའི་རྐྱེན་གྱིས་དབུལ་ཞིང་ཕོངས་པར་གྱུར་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་བོས་སོ། །"]},{"type":"verse","number":7,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་མིད་ཡཱན་པའི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་བོས་པས།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ལུང་སྟོན་པ་ཞིག་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྩར་མངགས་ཏེ་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་སྔར་ཁྱོད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཡར་ཁྲིད་འོངས་ཤིང་། བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཕྱི་རུ་བཏོན་པ་དང་།"]},{"type":"verse","number":9,"content":["ཨེ་ཅིབ་པའི་ལག་དང་ཁྱོད་རྣམས་ལ་གཉའ་གནོན་བྱེད་པ་ཀུན་ལས་བསྐྱབས་ནས་ཐར་དུ་བཅུག དེ་དག་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་བསྐྲད་ཅིང་ཁོ་རྣམས་ཀྱི་ཡུལ་ཁྱོད་ཅག་ལ་གནང་བ་ཡིན་ཞེས་དང་།"]},{"type":"verse","number":10,"content":["ཡང་ཁྱོད་རྣམས་ལ། ང་རང་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན། ཁྱོད་རྣམས་ཨེ་མོར་པའི་ཡུལ་དུ་གནས་པ་དང་། ཁོ་ཚོའི་ལྷ་རྣམས་ལ་བསྙེན་བཀུར་བྱེད་མི་རུང་ཞེས་སྨྲས་ནའང་། ཁྱོད་རྣམས་ཀྱིས་ངའི་གཏམ་ལ་མཉན་མ་སོང་ཞེས་གསུངས་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["གིད་ཡོན་ལ་ཐུགས་རྗེ་ཐོབ་པ།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཨོབ་རཱ་ཡུལ་དུ་སླེབས་ནས། ཨ་བི་ཨེ་ཟེར་པ་ཡོ་ཨ་སི་ཞེས་བྱ་བའི་བེ་ཤིང་འོག་ཏུ་བཞུགས་པ་ལ། ཡོ་ཨ་སིའི་བུ་གིད་ཡོན་གྱིས་མིད་ཡཱན་པ་རྣམས་ལ་སྦས་པའི་ཆེད་དུ་རྒུན་འབྲུམ་འཚིར་གཞོང་ཡོད་སར་གྲོ་རྡུང་བཞིན་བསྡད།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་གིད་ཡོན་ལ་མངོན་པར་གྱུར་ཏེ་ཁོ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཀྱེ་སྙིང་སྟོབས་ཅན་གྱི་དཔའ་རྒོད་ལགས། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁྱོད་དང་མཉམ་དུ་བཞུགས་ཞེས་པ་ལ།"]},{"type":"verse","number":13,"content":["གིད་ཡོན་ན་རེ། ཀྱེ་གཙོ་བོ་ལགས། གལ་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ངེད་དང་མཉམ་དུ་བཞུགས་ན། ངེད་རྣམས་དོན་འདི་ཐམས་ཅད་ལ་ཕྲད་དོན་ཅི། ཡང་བདག་ཅག་གི་ཕ་མེས་ཡང་མེས་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཡར་ཁྲིད་འོངས་པ་ཡིན་ཞེས་སྨྲས་པ་མ་ཡིན་ནམ། ཁོང་གི་ངོ་མཚར་བའི་འཕྲིན་ལས་རྣམས་གང་དུ་མཆིས་སམ། ད་ནི་ཁོང་གིས་བདག་ཅག་དོར་ནས་མིད་ཡཱན་པའི་ལག་ཏུ་སྤྲད་པ་ཡིན་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་གཟིགས་ཏེ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་རང་གི་མཐུ་སྟོབས་འདི་ལ་བརྟེན་ནས་མིད་ཡཱན་པའི་ལག་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་སྐྱོབས་ཤིག བདག་གིས་ཁྱོད་རང་མངགས་པ་མ་ཡིན་ནམ་ཞེས་གསུངས་པ་དང་།"]},{"type":"verse","number":15,"content":["གིད་ཡོན་ན་རེ། ཀྱེ་གཙོ་བོ་ལགས། བདག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཅི་ལྟར་སྐྱོབ་ནུས་སམ། གཟིགས་དང་། བདག་གི་ཁྱིམ་རྒྱུད་ནི་མཱ་ན་ཤེའི་ཚོ་པའི་ཁྲོད་ཆེས་དབུལ་ཞིང་ཕོངས་པ་དང་། ང་རང་བདག་གི་ཕ་ཁྱིམ་དུ་ཆེས་ཆུང་ཤོས་ཡིན་ཞེས་ཞུས།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་འདི་སྐད་དུ། ང་རང་ཁྱོད་དང་མཉམ་དུ་གནས་པས། ཁྱོད་ཀྱིས་མིད་ཡཱན་པ་རྣམས་མི་གཅིག་དང་འདྲ་བར་ཕམ་པར་རྒྱག་ངེས་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":17,"content":["གིད་ཡོན་ན་རེ། གལ་ཏེ་ཁྱེད་ཀྱི་སྤྱན་སྔར་ང་རང་ལ་ཐུགས་རྗེ་ཐོབ་པ་ཡིན་ན། ང་ལ་བཀའ་གནང་མཁན་ནི་ཁྱེད་རང་ཡིན་པའི་རྟགས་ཤིག་བདག་ལ་གནང་བར་མཛོད།"]},{"type":"verse","number":18,"content":["བདག་གིས་འབུལ་བ་འཁྱེར་ཡོང་སྟེ་ཁྱེད་ཀྱི་དྲུང་དུ་འབུལ་བའི་བར་དུ། ཁྱེད་རང་འདི་དང་མི་འབྲལ་བར་ཞུ་ཞེས་ཞུས་པ་ལ། གཙོ་བོས་འདི་སྐད་དུ། བདག་གིས་ཁྱོད་རང་ཕྱིར་ལོག་པར་སྒུག་ངེས་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":19,"content":["གིད་ཡོན་སོང་ནས་རེའུ་གཅིག་སྟ་གོན་བྱས་པ་དང་། གྲོ་ཕྱེ་ཨེ་ཕཱ་གང་གིས་སྐྱུར་མེད་བག་ལེབ་བཟོས་ཤིང་། ཤ་སླེ་བོ་ནང་དུ་བཞག་ནས་ཁུ་བ་སྣོད་ཀྱི་ནང་དུ་བླུགས་ཏེ། བེ་ཤིང་འོག་ཏུ་ཁྱེར་ནས་ཕོ་ཉའི་དྲུང་དུ་ཕུལ་ཏོ། །"]},{"type":"verse","number":20,"content":["དཀོན་མཆོག་གི་ཕོ་ཉས་གིད་ཡོན་ལ་འདི་སྐད་དུ། ཤ་དང་སྐྱུར་མེད་བག་ལེབ་ཕ་བོང་འདིའི་སྟེང་དུ་བཞག་ནས་ཁུ་བ་བླུགས་ཤིག་ཅེས་གསུངས་པ་ལ། ཁོས་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཕྱག་གི་འཁར་བ་བརྐྱངས་ནས་འཁར་བའི་སྣེ་མོས་ཤ་དང་སྐྱུར་མེད་བག་ལེབ་ལ་རེག་པ་ན། ཕ་བོང་ལས་མེ་འཕྱུར་ཏེ་ཤ་དང་སྐྱུར་མེད་བག་ལེབ་ཡོངས་རྫོགས་རྩ་མེད་བཏང་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉའང་མི་མཐོང་བར་གྱུར།"]},{"type":"verse","number":22,"content":["གིད་ཡོན་གྱིས་ཁོང་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཡིན་པ་ཤེས་ཏེ་ན་རེ། ཀྱེ་ཧུད་གཙོ་བོ་ཡ་ཝཱེ། བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཁ་རི་ཁ་ཐུག་ཏུ་མཇལ་བྱུང་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་སེམས་བདེ་བར་གྱིས་དང་མ་འཇིགས་ཤིག ཁྱོད་རང་འཆི་བར་མི་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":24,"content":["དེ་ནས་གིད་ཡོན་གྱིས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲི་ཞིག་བརྩིགས་པ་དང་མིང་ལ་ཡ་ཝཱེ་ཤཱ་ལོམ་",{"noteId":4},"ཞེས་བཏགས་པ་དང་། མཆོད་ཁྲི་དེ་ནི་ད་ལྟའི་བར་དུ་ཨ་བི་ཨེ་ཟེར་པ་རྣམས་ཀྱི་ཨོབ་རཱ་ཞེས་པར་གནས་སོ། །"]},{"type":"verse","number":25,"content":["ཡང་མཚན་མོ་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་རང་གི་ཕ་ཡི་བ་གླང་རྣམས་ལས་བ་གླང་གཉིས་པ་སྟེ་ཁ་གང་འཁྲིད་པར་མ་ཟད། ཁྱོད་ཀྱི་ཕ་ཡིས་པཱ་ཨལ་ལ་བརྩིགས་པའི་མཆོད་ཁྲི་བཤིག་ནས་དེའི་འགྲམ་དུ་ཡོད་པའི་ཨ་ཤེ་རཱ་སྟེ་ཤིང་སྐུ་དེ་ཆོད་ཅིག"]},{"type":"verse","number":26,"content":["དེ་ནས་བྲག་རི་འདིའི་སྟེང་དུ་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་མཆོད་ཁྲི་ཡག་པོ་ཞིག་རྩིགས་ལ། ཁྱོད་ཀྱིས་བཅད་པའི་ཨ་ཤེ་རཱ་སྟེ་ཤིང་སྐུ་བུད་ཤིང་དུ་བྱས་ནས་བ་གླང་གཉིས་པ་དེ་སྦྱིན་སྲེག་གི་མཆོད་པར་ཕུལ་ཞིག་ཅེས་བཀའ་བསྒོས་པས།"]},{"type":"verse","number":27,"content":["གིད་ཡོན་གྱིས་རང་གི་གཡོག་པོ་རྣམས་ལས་མི་བཅུ་བདམས་ནས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་བཀའ་ཇི་ལྟར་བསྒོས་པ་བཞིན་དུ་བྱས། ཡང་ཕ་གཞིས་དང་གྲོང་ཁྱེར་དེའི་མི་རྣམས་ལ་འཇིགས་པས་ཉིན་དཀར་དོན་དེ་བྱེད་མ་ཕོད་པར་མཚན་མོར་བྱས་པའོ། །"]},{"type":"heading","content":["གིད་ཡོན་གྱིས་པཱ་ཨལ་གྱི་མཆོད་ཁྲི་བཤིག་པ།"]},{"type":"verse","number":28,"content":["གྲོང་ཁྱེར་གྱི་མི་རྣམས་ནངས་སྔ་མོ་ཡར་ལངས་ཏེ། ལྟོས་དང་། པཱ་ཨལ་གྱི་མཆོད་ཁྲི་བཤིག་ནས་དེའི་འགྲམ་གྱི་ཨ་ཤེ་རཱ་སྟེ་ཤིང་སྐུ་བཅད་པ་དང་། བ་གླང་གཉིས་པ་གསར་དུ་བརྩིགས་པའི་མཆོད་ཁྲིའི་སྟེང་ཕུལ་ཡོད་པ་མཐོང་ནས།"]},{"type":"verse","number":29,"content":["ཕན་ཚུན་ན་རེ། འདི་ནི་སུ་ཞིག་གིས་བྱས་པ་ཡིན་ནམ་ཞེས་སྨྲས་ཤིང་། ཡང་རྩད་བཅད་ནས་དྲིས་རྗེས་འདི་ནི་ཡོ་ཨ་སིའི་བུ་གིད་ཡོན་གྱིས་བྱས་པ་རེད་ཅེས་སྨྲས།"]},{"type":"verse","number":30,"content":["གྲོང་ཁྱེར་གྱི་མི་རྣམས་ཀྱིས་ཡོ་ཨ་སི་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་ཀྱི་བུ་ཕྱིར་སྤྲོད་ཅིག་ཁོས་པཱ་ཨལ་གྱི་མཆོད་ཁྲི་བཤིག་ནས་དེའི་འགྲམ་གྱི་ཨ་ཤེ་རཱ་བཅད་པས་ཁོ་ནི་གསོད་རུང་བ་ཡིན་ཞེས་པ་ལ།"]},{"type":"verse","number":31,"content":["ཡོ་ཨ་སི་ཡིས་དེར་ལངས་བསྡད་ནས་ཁོ་ལ་རྒོལ་བའི་མི་ཚོགས་ལ་འདི་ལྟར། ཁྱོད་ཅག་གིས་པཱ་ཨལ་གྱི་དོན་དུ་རྩོད་གླེང་བྱེད་པ་ཡིན་ནམ། ཡང་ན་ཁྱོད་ཅག་གིས་དེ་སྐྱོབ་འདོད་པ་ཡིན་ནམ། སུ་ཞིག་གིས་དེའི་དོན་དུ་རྩོད་གླེང་བྱེད་ན་དེ་ནི་ནམ་མ་ལངས་སྔོན་ལ་གསོད་པར་འོས། གལ་ཏེ་པཱ་ཨལ་ལྷ་ཡིན་ན། མི་ཞིག་གིས་ཁོའི་མཆོད་ཁྲི་བཤིག་པ་ཡིན་པས་ཁོ་རང་ལ་རྩོད་གླེང་བྱེད་དུ་ཆུག་ཅེས་སྨྲས།"]},{"type":"verse","number":32,"content":["དེའི་ཕྱིར་ཉིན་དེ་ནས་བཟུང་མི་རྣམས་ཀྱིས་གིད་ཡོན་གྱི་མིང་ལ་ཡེ་རུབ་པཱ་ཨལ་ཞེས་བོས་ཤིང་། ཁོས་པཱ་ཨལ་གྱི་མཆོད་ཁྲི་བཤིག་པ་ཡིན་པས་པཱ་ཨལ་ལ་ཁོ་དང་རྩོད་གླེང་བྱེད་དུ་ཆུག་ཅེས་པའི་དོན་ནོ། །"]},{"type":"verse","number":33,"content":["དེའི་དུས་སུ་མིད་ཡཱན་པ་དང་ཨ་མཱད་ལེག་པ། ཤར་ཕྱོགས་པ་བཅས་ཀུན་པོ་འདུས་ནས་གཙང་པོ་བརྒལ་ཞིང་། ཡེ་སི་རེ་ཨེལ་གྱི་ཐང་དུ་སྒར་བཏབ།"]},{"type":"verse","number":34,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཉིད་གིད་ཡོན་གྱི་སྟེང་དུ་བབས་པ་དང་ཁོས་རྭ་དུང་བུས་ཤིང་། ཨ་བི་ཨེ་ཟཱེར་པ་རྣམས་ཁོའི་རྗེས་སུ་འབྲངས།"]},{"type":"verse","number":35,"content":["ཡང་ཁོས་བང་ཆེན་མངགས་ཏེ་མཱ་ན་ཤེའི་ཡུལ་ཀུན་བརྒྱུད་ཅིང་མཱ་ན་ཤེ་པ་རྣམས་ཀྱང་འདུས་ནས་ཁོའི་རྗེས་སུ་འབྲངས། ཡང་ཨ་ཤེར་དང་ཟེ་བུ་ལུན་དང་། ནཱབ་ཐ་ལི་བཅས་ཀྱི་རྩར་བང་ཆེན་མངགས་ཤིང་། དེ་རྣམས་ཀྱང་ཁོ་རྣམས་དང་འཛོམས་པར་སླེབས་སོ། །"]},{"type":"heading","content":["དོན་ཡ་མཚན་ཅན།"]},{"type":"verse","number":36,"content":["གིད་ཡོན་གྱིས་དཀོན་མཆོག་ལ། གལ་ཏེ་ཁྱེད་ཀྱིས་ཅི་གསུངས་པ་བཞིན་དུ་ང་རང་བརྒྱུད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་སྐྱོབ་པ་ཡིན་ན།"]},{"type":"verse","number":37,"content":["གཟིགས་དང་། བདག་གིས་བལ་རྡོག་ཅིག་གཡུལ་ཁ་རུ་འཇོག་པར་བྱ་སྟེ། གལ་ཏེ་བལ་རྡོག་ཁོ་ནའི་སྟེང་དུ་ཟིལ་བ་ཡོད་པ་དང་ཉེ་འཁོར་ཐམས་ཅད་སྐམ་པོར་ལུས་ན། ཁྱེད་ཀྱིས་ཅི་གསུངས་པ་བཞིན་དུ་ང་རང་བརྒྱུད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་སྐྱོབ་རྒྱུ་ཡིན་པ་བདག་གིས་ཤེས་པར་འགྱུར་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":38,"content":["དེའི་ཕྱི་ཉིན་ཞོགས་པར་གིད་ཡོན་ཡར་ལངས་པ་ལ་དེ་བཞིན་དུ་བྱུང་བ་མཐོང་ཞིང་། བལ་རྡོག་བཙིར་བ་ལ་ཆུ་ཕོར་བ་གང་ཐོན་ནོ། །"]},{"type":"verse","number":39,"content":["དེ་ནས་གིད་ཡོན་གྱིས་ཡང་དཀོན་མཆོག་ལ་འདི་ལྟར། བདག་གིས་ཡང་བསྐྱར་བལ་རྡོག་ལས་ཚོད་ལྟ་བྱེད་པར་བྱ་ཞེས་ཡང་ཐེངས་ཤིག་ཞུས་པར་ཁྱེད་རང་དགོངས་པ་མི་ཚོམ་པར་མཁྱེན། བལ་རྡོག་ནི་སྐམ་པོར་ལུས་ནས་ཉེ་འཁོར་ཐམས་ཅད་ལ་ཟིལ་བ་འབབ་པར་ཤོག་ཅེས་ཞུས་ཤིང་།"]},{"type":"verse","number":40,"content":["མཚན་མོ་དེར་དཀོན་མཆོག་གིས་ཡང་དེ་བཞིན་མཛད་ཅིང་། བལ་རྡོག་ཁོ་ན་སྐམ་པོར་ལུས་ནས་ཉེ་འཁོར་ཐམས་ཅད་ལ་ཟིལ་བ་བབས་སོ། །"]}],"footnotes":[{"noteId":4,"caller":"+","text":"འདིར་ཤཱ་ལོམ་ཞེས་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ཞི་བདེ་གནང་ཞེས་པའི་དོན་ཡིན།","reference":{"chapter":6,"verse":24}}]},"thisChapterLink":"/api/bod_ntb/JDG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/5.json","previousChapterAudioLinks":{},"numberOfVerses":40}