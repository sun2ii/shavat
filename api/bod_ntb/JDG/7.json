{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":7,"content":[{"type":"heading","content":["གིད་ཡོན་གྱིས་མིད་ཡཱན་པ་རྣམས་ཕམ་པར་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཡེ་རུབ་པཱ་ཨལ་ཞེས་བྱ་བའི་གིད་ཡོན་དང་ཁོའི་རྗེས་སུ་འབྲངས་པ་རྣམས་ནངས་སྔ་མོ་ནས་ཡར་ལངས་ཏེ། ཧ་རོད་ཆུ་མགོའི་རྩར་སྒར་བཏབ། མིད༌ཡཱན་གྱི་དམག་སྒར་ནི་བྱང་ཕྱོགས་ཀྱི་ཐང་དུ་མོ་རེ་རི་བོའི་ཉེ་འདབས་སུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱི་རྗེས་སུ་འབྲངས་པའི་མི་མང་དྲགས་པས་བདག་གིས་མིད་ཡཱན་པ་རྣམས་ཁོ་ཚོའི་ལག་ཏུ་སྤྲོད་མི་རུང་སྟེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ང་ལ་འུད་ཤོབ་བྱས་ཏེ། ང་ཚོ་རང་གིས་རང་ཉིད་བསྐྱབས་པ་ཡིན་ཞེས་ཟེར་ཉེན་ཆེ།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱིས་ད་ལྟ་མི་འདི་རྣམས་ལ་འདི་ལྟར། འཇིགས་ཤིང་དཔའ་ཞུམ་པ་རྣམས་གིལ་ཨད་རི་དང་བྲལ་ནས་ཕྱིར་ལོག་ཆོག་ཅེས་ཁྱབ་བསྒྲགས་བྱོས་ཤིག་ཅེས་གསུངས་ཤིང་། དེ་ནས་མི་ཉིས་ཁྲི་ཉིས་སྟོང་ཕྱིར་ལོག་ཅིང་ཆིག་ཁྲི་འབའ་ཞིག་ལུས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་འདི་སྐད་དུ། མི་ནི་ད་དུང་མང་དྲགས་པས་ཁྱོད་ཀྱིས་དེ་རྣམས་ཆུ་འགྲམ་དུ་ཁྲིད་དང་། བདག་གིས་དེ་རུ་ཁྱོད་ཀྱི་ཕྱིར་ཁོ་རྣམས་ལ་ཚོད་བགམ་བྱེད་པར་བྱ། ངས་སུ་ཞིག་ཁྱོད་དང་མཉམ་དུ་འགྲོ་ཆོག་པར་བསྟན་ན་དེ་ཁྱོད་དང་ལྷན་ཅིག་ཏུ་འགྲོ་བར་རུང་ལ། ངས་སུ་ཞིག་ཁྱོད་དང་མཉམ་དུ་འགྲོ་མི་ཆོག་པར་བསྟན་ན་དེ་ཁྱོད་དང་ལྷན་ཅིག་ཏུ་འགྲོ་བར་མི་རུང་ཞེས་གསུངས་པས།"]},{"type":"verse","number":5,"content":["གིད་ཡོན་གྱིས་མི་རྣམས་མར་ཆུ་འགྲམ་དུ་ཁྲིད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ། སུ་ཞིག་གིས་ཁྱི་ལྟར་ཆུ་ལྕེ་ཡིས་བལྡགས་ནས་འཐུང་བ་ཡིན་ན་དེ་རྣམས་ལོགས་སུ་ཁོར་དང་། ཡང་སུ་ཞིག་གིས་པུས་མོ་བཙུགས་ནས་ཆུ་འཐུང་བ་རྣམས་ཀྱང་དེ་བཞིན་དུ་ལོགས་སུ་ཁོར་ཅིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཆུ་ལག་མཐིལ་དུ་བླངས་ནས་བལྡགས་ཏེ་འཐུང་མཁན་མི་སུམ་བརྒྱ་བྱུང་བ་དང་། དེའི་འཕྲོ་མ་རྣམས་ཀྱིས་པུས་མོ་བཙུགས་ཏེ་ཆུ་འཐུང་ངོ་། །"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་འདི་སྐད་དུ། ཆུ་བལྡགས་ཏེ་འཐུང་བའི་མི་སུམ་བརྒྱ་འདི་བརྒྱུད་ནས་བདག་གིས་ཁྱོད་རྣམས་སྐྱོབ་ཅིང་། མིད་ཡཱན་པ་རྣམས་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲོད་པར་བྱ། དེའི་འཕྲོ་མ་རྣམས་རང་རང་སར་ལོག་ཆོག་ཅེས་གསུངས་པ་ལ།"]},{"type":"verse","number":8,"content":["མི་སུམ་བརྒྱ་བོ་དེས་བྲོ་དང་རྭ་དུང་ཁྱེར་བ་དང་། གིད་ཡོན་གྱིས་དེའི་འཕྲོ་ཡི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་རང་རང་གི་གུར་ཡོད་སར་ལོག་ཏུ་བཅུག མི་སུམ་བརྒྱ་བོ་རང་གི་རྩར་བཞག་པ་དང་། མིད༌ཡཱན་གྱི་དམག་སྒར་ནི་ཁོའི་ཉེ་འདབས་ཀྱི་ཐང་དུ་ཡོད་དོ། །"]},{"type":"verse","number":9,"content":["མཚན་མོ་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་གིད་ཡོན་ལ་འདི་སྐད་དུ། བདག་གིས་ཁོ་རྣམས་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲད་ཟིན་པས། ཡར་ལོངས་ལ་མར་མིད་ཡཱན་གྱི་དམག་སྒར་དུ་སོང་ཞིག"]},{"type":"verse","number":10,"content":["གལ་ཏེ་ཁྱོད་འགྲོ་བར་འཇིགས་ན། ཁྱོད་ཀྱི་གཡོག་པོ་ཕུ་རཱ་ཁྲིད་ནས་དམག་སྒར་དེ་རུ་སོང་དང་།"]},{"type":"verse","number":11,"content":["ཁོ་རྣམས་ཀྱིས་ཅི་སྨྲ་བ་ཁྱོད་ཀྱིས་ཐོས་པ་དང་། ཁྱོད་ལ་མར་སོང་ནས་དམག་སྒར་དེར་དཔུང་འཇུག་བྱེད་པའི་སྙིང་སྟོབས་ལྡན་པར་འགྱུར་ཞེས་གསུངས། དེ་ནས་གིད་ཡོན་གྱིས་གཡོག་པོ་ཕུ་རཱ་ཁྲིད་ནས་མར་དམག་སྒར་གྱི་མཐའ་མཚམས་སུ་སོང་ངོ་། །"]},{"type":"verse","number":12,"content":["དེར་མིད་ཡཱན་པ་དང་ཨ་མཱད་ལེག་པ། ཤར་ཕྱོགས་པ་ཐམས་ཅད་ཐང་ལ་ཁྱབ་ཅིང་འབུ་ཆ་ག་པ་ལྟར་མང་ལ། དེ་རྣམས་ཀྱི་རྔ་མོང་ནི་མཚོ་འགྲམ་གྱི་བྱེ་མ་ལྟར་བགྲང་ལས་འདས་པའོ། །"]},{"type":"verse","number":13,"content":["གིད་ཡོན་དེར་སླེབས་པ་ལ། མི་ཞིག་གིས་རང་གི་གྲོགས་པོར་རྨི་ལམ་བཤད་དེ་འདི་ལྟར་སྨྲས་པ་སྟེ། ལྟོས་དང་། བདག་གིས་རྨི་ལམ་ཞིག་རྨིས་པ་ནི་འདི་ལྟ་སྟེ། སོ་ཕྱེའི་བག་ལེབ་ཅིག་མིད༌ཡཱན་གྱི་དམག་སྒར་དུ་གྲིལ་འོང་ཞིང་། གུར་གྱི་རྩར་སླེབས་ནས་གུར་ལ་ཐོགས་ཏེ་བསྒྱེལ་བ་དང་གུར་གྱི་མགོ་རྟིང་བསློགས་ཞེས་པ་ལ།"]},{"type":"verse","number":14,"content":["གྲོགས་པོ་དེ་ན་རེ། འདི་ནི་གཞན་ཞིག་མ་ཡིན་པར་ཡེས་ར་ཨེལ་པ་ཡོ་ཨ་སིའི་བུ་གིད་ཡོན་གྱི་རལ་གྲི་ཡིན་ཏེ། དཀོན་མཆོག་གིས་མིད༌ཡཱན་དང་དམག་མི་ཡོངས་རྫོགས་ཁོའི་ལག་ཏུ་སྤྲད་པ་ཡིན་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["གིད་ཡོན་གྱིས་རྨི་ལམ་དང་དེའི་དོན་འགྲེལ་ཐོས་ནས་དཀོན་མཆོག་ལ་བསྙེན་བཀུར་ཕུལ་ཞིང་། ཡེས་ར་ཨེལ་པའི་དམག་སྒར་དུ་ཕྱིར་ལོག་སྟེ་འདི་ལྟར། ཡར་ལོངས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་མིད༌ཡཱན་གྱི་དམག་དཔུང་ཁྱོད་རྣམས་ཀྱི་ལག་ཏུ་སྤྲད་ཟིན་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་གིད་ཡོན་གྱིས་མི་སུམ་བརྒྱ་ཁག་གསུམ་དུ་བགོས་ནས། མི་རེའི་ལག་ཏུ་རྭ་དུང་རེ་དང་རྫ་ཁོག་སྟོང་བ་རེ་སྤྲད་ཅིང་། རྫ་ཁོག་རེ་རེའི་ནང་དུ་དཔལ་འབར་རེ་བཞག་པ་དང་།"]},{"type":"verse","number":17,"content":["དེ་རྣམས་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་རྣམས་ཀྱིས་བདག་གིས་ཅི་བྱེད་པར་ལྟོས་ཤིག ངས་དམག་སྒར་གྱི་རྩར་སླེབས་ནས་ཅི་ལྟར་བྱས་ན་ཁྱོད་ཅག་གིས་ཀྱང་དེ་ལྟར་བྱོས་ཤིག"]},{"type":"verse","number":18,"content":["ང་དང་ངའི་རྗེས་སུ་འབྲངས་པ་ཐམས་ཅད་ཀྱིས་རྭ་དུང་འབུད་པའི་དུས་སུ། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་དམག་སྒར་གྱི་ཕྱོགས་བཞི་རུ་རྭ་དུང་འབུད་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་དང་གིད་ཡོན་གྱི་ཕྱིར་ཞེས་འུར་རྒྱོབ་ཅིག་ཅེས་པའོ། །"]},{"type":"verse","number":19,"content":["གིད་ཡོན་དང་ཁོའི་རྗེས་སུ་འབྲངས་པའི་མི་བརྒྱ་བོ་དེ་མཚན་མོ་ཐུན་གཉིས་པའི་ཐོག་མར་སོ་སྲུང་བརྗེ་བའི་དུས་སུ་དམག་སྒར་གྱི་རྩར་སླེབས་ནས། རྭ་དུང་བུས་ཤིང་ལག་གི་རྫ་ཁོག་བཅག་གོ །"]},{"type":"verse","number":20,"content":["ཁག་གསུམ་པོས་རྭ་དུང་བུས་ཤིང་རྫ་ཁོག་བཅག གཡོན་ལག་ཏུ་དཔལ་འབར་ཐོགས་པ་དང་གཡས་ལག་ཏུ་རྭ་དུང་བཟུང་ནས། དཀོན་མཆོག་ཡ་ཝཱེ་དང་གིད་ཡོན་གྱི་རལ་གྲི་ཞེས་འུར་བརྒྱབ།"]},{"type":"verse","number":21,"content":["ཁོ་རྣམས་དམག་སྒར་གྱི་ཕྱོགས་བཞི་རུ་རང་རང་སར་ལངས་བསྡད་པ་ལ་སྒར་ཡོངས་ཀྱི་མི་ཐམས་ཅད་ཡར་རྒྱུག་མར་རྒྱུག་བྱས་ནས་འཁྲུག་ཅིང་། དེ་རྣམས་ཀི་འདེབས་བཞིན་བྲོས་སོ། །"]},{"type":"verse","number":22,"content":["མི་སུམ་བརྒྱ་དེས་རྭ་དུང་བུས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་དམག་སྒར་གྱི་མི་ཐམས་ཅད་ལ་རལ་གྲིས་ཕན་ཚུན་སྣུན་པར་མཛད་ཅིང་། དེ་རྣམས་ཚེ་རེ་རཱ་ཞེས་པའི་པེད་ཤིད་ཏ་དང་། ཏབ་པཱད་ཉེ་འགྲམ་གྱི་ཨ་བེལ་མེ་ཧོ་ལཱའི་བར་དུ་བྲོས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ནཱབ་ཐ་ལི་དང་ཨ་ཤེར་དང་། མཱ་ན་ཤེ་བཅས་ཀྱི་ཡུལ་ཐམས་ཅད་ནས་འདུས་ཏེ་མིད་ཡཱན་པ་རྣམས་ཀྱི་ར་མདར་བརྒྱུགས།"]},{"type":"verse","number":24,"content":["གིད་ཡོན་གྱིས་ཨེ་ཕཱར་ཡིམ་གྱི་རི་ཁུལ་ཐམས་ཅད་དུ་བང་ཆེན་མངགས་ནས་འདི་ལྟར། ཁྱོད་རྣམས་མར་ཤོག་ལ་མིད་ཡཱན་པར་རྒོལ་ཞིག དེ་དག་གི་སྔོན་ལ་པེད་པཱ་རའི་བར་དུ་ཡོར་དན་གཙང་པོའི་རབ་ཁ་སྲུངས་ཤིག་ཅེས་བསྒོས་པ་ལ། ཨེ་ཕཱར་ཡིམ་གྱི་མི་ཐམས་ཅད་འདུས་ནས་པེད་པཱ་རའི་བར་དུ་ཡོར་དན་གཙང་པོའི་རབ་ཁ་བསྲུངས་པ་དང་།"]},{"type":"verse","number":25,"content":["དེ་ཚོས་མིད་ཡཱན་པའི་འགོ་དཔོན་གཉིས་ཟིན་པ་སྟེ་གཅིག་གི་མིང་ལ་ཨོ་རེབ་ཅེས་དང་ཅིག་ཤོས་དེའི་མིང་ལ་ཟེབ་ཅེས་བྱ། ཨོ་རེབ་ནི་ཨོ་རེབ་ཀྱི་ཕ་བོང་སྟེང་དུ་བསད་ཅིང་། ཟེབ་ནི་ཟེབ་ཀྱི་རྒུན་འབྲུམ་འཚིར་གཞོང་ཡོད་སར་བསད་པ་དང་། ཡང་མིད་ཡཱན་པ་རྣམས་བདས་ནས། ཨོ་རེབ་དང་ཟེབ་གཉིས་ཀྱི་མགོ་བོ་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་གིད་ཡོན་ཡོད་སར་ཁྱེར་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JDG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/6.json","previousChapterAudioLinks":{},"numberOfVerses":25}