{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JDG","translationId":"bod_ntb","name":"ཁྲིམས་དཔོན།","commonName":"ཁྲིམས་དཔོན།","title":"༄༅། །ཁྲིམས་དཔོན་གྱི་མདོ།","order":7,"numberOfChapters":21,"sha256":"07c9058703ba48376b60b17703f2c6ddcdd30fc3966da51520c85855daf658a4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":9,"content":[{"type":"heading","content":["ཨ་བི་མེ་ལེག"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་ཨ་བི་མེ་ལེག་ཅེས་བྱ་བ་སི་ཀེམ་ཡུལ་གྱི་རང་གི་ཨ་ཞང་རྣམས་ཀྱི་རྩར་ཕྱིན་ཏེ། དེ་དག་དང་ཁོའི་ཨ་མའི་ཁྱིམ་རྒྱུད་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་སི་ཀེམ་གྱི་འགོ་དཔོན་ཀུན་ལ། ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་བདུན་ཅུ་བོ་ཚང་མས་ཁྱོད་རྣམས་ལ་དབང་བསྒྱུར་ན་བཟང་ངམ། ཡང་ན་མི་གཅིག་གིས་ཁྱོད་རྣམས་ལ་དབང་བསྒྱུར་ན་བཟང་། ཡང་ང་རང་ཁྱོད་རྣམས་ཀྱི་ཤ་དང་རུས་པའི་གཉེན་ཉེ་ཡིན་པ་ཡིད་ལ་དྲན་དགོས་ཞེས་ཞུ་བར་མཛོད་ཅེས་པ་ལ།"]},{"type":"verse","number":3,"content":["ཁོའི་ཨ་ཞང་རྣམས་ཀྱིས་ཁོའི་དོན་དུ་གཏམ་འདི་ཐམས་ཅད་སི་ཀེམ་པ་རྣམས་ལ་སྨྲས་པ་དང་། དེ་དག་གི་སེམས་ནི་ཨ་བི་མེ་ལེག་གི་ཕྱོགས་སུ་འཁོར་ཞིང་། ཁོ་ནི་མ་གཞི་བདག་ཅག་གི་སྤུན་ཡིན་ཞེས་སྨྲས་ནས།"]},{"type":"verse","number":4,"content":["དེ་ཚོས་པཱ་ཨལ་པེ་རིད་ཀྱི་མཆོད་ཁང་ནས་དངུལ་སྲང་བདུན་ཅུ་བླངས་ནས་ཨ་བི་མེ་ལེག་ལ་སྤྲད་ཅིང་། ཨ་བི་མེ་ལེག་གིས་དངུལ་དེ་ཡིས་རང་གི་རྗེས་སུ་འབྲང་བའི་ཁྲམ་པ་ཇག་རྐུན་སྐོར་ཞིག་གླས་པའོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁོ་ཨོབ་རཱ་རུ་རང་གི་ཕ་ཡི་ཁྱིམ་དུ་ཕྱིན་ཅིང་། ཁོའི་སྤུན་རྣམས་ཏེ་ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་བདུན་ཅུ་བོ་ཕ་བོང་གཅིག་གི་སྟེང་བསད་པ་དང་། ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་ཆུང་བ་ཡོ་ཐམ་ནི་སྦས་བསྡད་པས་དེ་ཁོ་ན་ལུས་སོ། །"]},{"type":"verse","number":6,"content":["སི་ཀེམ་པ་དང་པེད་མིལ་ལོས་ཀྱི་མི་རྣམས་མཉམ་དུ་འཛོམས་ཤིང་། སི་ཀེམ་གྱི་བེ་ཤིང་གི་ཀ་བ་ཡོད་སར་ཕྱིན་ཏེ་ཨ་བི་མེ་ལེག་རྒྱལ་པོར་བསྐོས་སོ། །"]},{"type":"verse","number":7,"content":["མི་ཞིག་གིས་དོན་དེ་ཡོ་ཐམ་ལ་སྨྲས་པས་ཁོ་རང་གེ་རི་ཟིམ་རི་མགོར་སོང་སྟེ་སྐད་ཆེན་པོས་འདི་ལྟར་སྨྲས་པ་སྟེ། ཀྱེ་སི་ཀེམ་པ་རྣམས། དཀོན་མཆོག་གིས་ཁྱོད་ཅག་ལ་གསན་པའི་ཕྱིར་བདག་ལ་ཉོན་ཅིག"]},{"type":"verse","number":8,"content":["དུས་ནམ་ཞིག་གི་ཚེ་ལྗོན་ཤིང་རྣམས་ཀྱིས་ལྗོན་ཤིང་གཅིག་རྒྱལ་པོར་བསྐོས་ནས། ཁོ་རྣམས་ལ་བདག་སྐྱོང་བྱེད་དུ་འཇུག་དགོས་འདོད་དེ། སོང་ནས་སྐྱུ་རུ་ཤིང་ལ་འདི་ལྟར། ཁྱེད་རང་ཕེབས་ནས་ངེད་ཅག་གི་རྒྱལ་པོར་བཞུགས་པར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":9,"content":["སྐྱུ་རུ་ཤིང་ན་རེ། བདག་གིས་ལྷ་ལ་བསྙེན་བཀུར་འབུལ་བ་དང་མི་རྣམས་ལ་བཀུར་བྱེད་ཀྱི་སྣུམ་བསྐྱུར་ཏེ། ལྗོན་ཤིང་རྣམས་ཀྱི་རྩེ་མོར་གཡོ་རུང་ངམ་ཞེས་སྨྲས།"]},{"type":"verse","number":10,"content":["དེ་ནས་ལྗོན་ཤིང་རྣམས་ཀྱིས་སེ་ཡབ་ཤིང་ལ་འདི་ལྟར། ཁྱེད་རང་ཕེབས་ནས་ངེད་ཅག་གི་རྒྱལ་པོར་བཞུགས་པར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":11,"content":["སེ་ཡབ་ཤིང་ན་རེ། བདག་གིས་ཞིམ་མངར་ལྡན་པའི་འབྲས་བུ་བསྐྱེད་པ་སྤངས་ནས་ལྗོན་ཤིང་རྣམས་ཀྱི་རྩེ་མོར་གཡོ་རུང་ངམ་ཞེས་སྨྲས།"]},{"type":"verse","number":12,"content":["དེ་ནས་ལྗོན་ཤིང་རྣམས་ཀྱིས་རྒུན་འབྲུམ་ཤིང་ལ་འདི་ལྟར། ཁྱེད་རང་ཕེབས་ནས་ངེད་ཅག་གི་རྒྱལ་པོར་བཞུགས་པར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":13,"content":["རྒུན་འབྲུམ་ཤིང་ན་རེ། བདག་གིས་ལྷ་དང་མི་རྣམས་སྤྲོ་བར་བྱེད་པའི་རྒུན་ཆང་གསར་པ་བསྐྱུར་ནས། ལྗོན་ཤིང་རྣམས་ཀྱི་རྩེ་མོར་གཡོ་རུང་ངམ་ཞེས་སྨྲས།"]},{"type":"verse","number":14,"content":["དེ་ནས་ལྗོན་ཤིང་རྣམས་ཀྱིས་ཚེར་མ་ལ་འདི་ལྟར། ཁྱེད་རང་ཕེབས་ནས་ངེད་ཅག་གི་རྒྱལ་པོར་བཞུགས་པར་མཛོད་ཅེས་ཞུས་པ་ལ།"]},{"type":"verse","number":15,"content":["ཚེར་མ་ན་རེ། གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་བསམ་པ་རྣམ་དག་གིས་ང་རང་རྒྱལ་པོར་བསྐོས་པ་ཡིན་ན། བདག་གི་གྲིབ་བསིལ་འོག་ཏུ་སྡོད་དགོས། དེ་ལྟར་མིན་ཚེ། ཚེར་མ་ལས་མེ་ཐོན་ཏེ་ལེ་པཱ་ནོན་གྱི་ཐང་ཤིང་རྣམས་འགེམ་པར་ཤོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["ད་ལྟ་ཁྱོད་ཅག་གིས་གཞུང་དྲང་ཟོལ་མེད་ཀྱིས་ཨ་བི་མེ་ལེག་རྒྱལ་པོར་བསྐོས་ཤིང་། གལ་ཏེ་ཡེ་རུབ་པཱ་ཨལ་དང་ཁོའི་ཁྱིམ་རྒྱུད་ལ་བཟང་པོ་བྱས་ཏེ། ཁོ་ཡི་ལག་པས་བཟོས་པ་ལྟར་དེ་ལ་དྲིན་ལན་འཇལ་ན།"]},{"type":"verse","number":17,"content":["སྔར་བདག་གི་ཡབ་ཀྱིས་རང་སྲོག་འབེན་ལ་བཞག་ནས་ཁྱོད་ཚོའི་དོན་དུ་འཐབ་ཅིང་། ཁྱོད་རྣམས་བསྐྱབས་ཏེ་མིད་ཡཱན་པའི་ལག་ནས་ཐར་དུ་བཅུག"]},{"type":"verse","number":18,"content":["ཡིན་ནའང་ད་ལྟ་ཁྱོད་ཅག་ལངས་ཏེ་ངའི་ཕ་ཡི་ཁྱིམ་རྒྱུད་ལ་རྒོལ་ཞིང་། ཁོའི་བུ་བདུན་ཅུ་བོ་ཕ་བོང་གཅིག་གི་སྟེང་དུ་བསད་པ་དང་། ཡང་ཁོའི་གཡོག་མོ་ལས་སྐྱེས་པའི་བུ་སྟེ་ཨ་བི་མེ་ལེག་ནི་སི་ཀེམ་པའི་རྒྱལ་པོར་བསྐོས་པ་དང་། མ་གཞི་དེ་ནི་ཁྱོད་ཅག་གི་སྤུན་ཡིན་པའོ། །"]},{"type":"verse","number":19,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་ད་ལྟ་ཡེ་རུབ་པཱ་ཨལ་དང་ཁོའི་ཁྱིམ་རྒྱུད་ལ་གཞུང་དྲང་ཟོལ་མེད་ཀྱི་སྤྱོད་སྟངས་འཛིན་ན། ཁྱོད་རྣམས་ཨ་བི་མེ་ལེག་གི་རྐྱེན་གྱིས་དགའ་བར་གྱིས། ཁོ་ཡང་ཁྱོད་རྣམས་ཀྱི་རྐྱེན་གྱིས་སྤྲོ་བར་གྱུར་ཅིག"]},{"type":"verse","number":20,"content":["དེ་ལྟར་མིན་ཚེ། ཨ་བི་མེ་ལེག་ནས་མེ་ཞིག་ཐོན་ཏེ་སི་ཀེམ་པ་དང་པེད་མིལ་ལོས་ཀྱི་མི་ཐམས་ཅད་འགེམ་པ་དང་། ཡང་སི་ཀེམ་པ་དང་པེད་མིལ་ལོས་ཀྱི་མི་རྣམས་ལས་མེ་ཞིག་ཐོན་ཏེ་ཨ་བི་མེ་ལེག་འགེམ་པར་གྱུར་ཅིག་ཅེས་པའོ། །"]},{"type":"verse","number":21,"content":["ཡོ་ཐམ་ནི་ཁོའི་སྤུན་ཨ་བི་མེ་ལེག་ལ་འཇིགས་ནས་བྲོས་ཤིང་པེར་དུ་སོང་སྟེ་དེར་བསྡད་དོ། །"]},{"type":"verse","number":22,"content":["ཨ་བི་མེ་ལེག་གིས་ལོ་གསུམ་གྱི་རིང་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དབང་བསྒྱུར་ཏོ། །"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་གིས་ཨ་བི་མེ་ལེག་དང་སི་ཀེམ་པའི་བར་ལ་གདོན་འདྲེ་ཞིག་མངགས་པས། སི་ཀེམ་པ་རྣམས་ཀྱིས་ཨ་བི་མེ་ལེག་ལ་གཡོ་སྒྱུ་ཁྲམ་གསུམ་བྱས།"]},{"type":"verse","number":24,"content":["ཅི་ལ་ཞེ་ན། ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་བདུན་ཅུ་བོར་ཐེབས་པའི་གནོད་འཚེ་ཡི་ལན་དེ་ཁོ་རྣམས་ཀྱི་གཅེན་པོ་ཨ་བི་མེ་ལེག་གི་སྟེང་དུ་འབེབ་པ་དང་། ཡང་ཁོ་རྣམས་ཀྱི་ཁྲག་བཞུར་བའི་སྡིག་པ་དེ་ཨ་བི་མེ་ལེག་ལ་རོགས་བྱས་ནས་སྤུན་ཟླ་རྣམས་གསོད་པའི་སི་ཀེམ་པ་རྣམས་ཀྱི་སྟེང་དུ་འབེབ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":25,"content":["སི་ཀེམ་གྱི་འགོ་དཔོན་རྣམས་ཀྱིས་མི་མངགས་ནས་རི་མགོར་འཇབས་ཤིང་ཨ་བི་མེ་ལེག་ལ་བསྒུགས་པ་དང་། ཁོ་རྣམས་ཡོད་སར་བརྒྱུད་ནས་འགྲོ་མཁན་ཐམས་ཅད་ལ་འཕྲོག་བཅོམ་བྱས་པ་ལ། མི་ཞིག་གིས་དོན་དེ་ཨ་བི་མེ་ལེག་ལ་སྨྲས།"]},{"type":"verse","number":26,"content":["ཡང་ཨེ་བེད་ཀྱི་བུ་གཱ་ཨལ་དང་དེའི་སྤུན་རྣམས་སི་ཀེམ་ཡུལ་དུ་སླེབས་པ་དང་། སི་ཀེམ་པ་རྣམས་ཀྱིས་ཁོ་རང་ལ་བློ་གཏད་དོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་སི་ཀེམ་པ་རྣམས་ཞིང་ཁར་སོང་སྟེ་རྒུན་འབྲུམ་ར་བ་ནས་རྒུན་འབྲུམ་བཏོགས་ཏེ་རྒུན་ཆང་བཙིར་ཞིང་གསོལ་སྟོན་བཤམས་པ་དང་། དེ་དག་རང་གི་ལྷ་ཁང་དུ་སོང་ནས་བཟའ་བཏུང་ལོངས་སུ་སྤྱད་ཅིང་ཨ་བི་མེ་ལེག་ལ་དམོད་མོ་བྱས།"]},{"type":"verse","number":28,"content":["དེ་ནས་ཨེ་བེད་ཀྱི་བུ་གཱ་ཨལ་ན་རེ། ཨ་བི་མེ་ལེག་ནི་སུ་ཡིན་ནམ། སི་ཀེམ་པ་ནི་སུ་ཡིན་ནམ། བདག་ཅག་གིས་ཁོ་ལ་ཞབས་ཕྱི་བསྒྲུབ་དགོས་དོན་ཅི། ཁོ་ནི་ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་མ་ཡིན་ནམ། ཟེ་བུལ་ནི་ཁོའི་ལག་རོགས་མ་ཡིན་ནམ། ཁྱོད་རྣམས་ཀྱིས་སི་ཀེམ་གྱི་ཕ་སྟེ་ཧ་མོར་གྱི་བུ་རྒྱུད་ལ་ཞབས་ཕྱི་བསྒྲུབ་ཆོག་ལ། བདག་ཅག་གིས་ཨ་བི་མེ་ལེག་ལ་ཞབས་ཕྱི་བསྒྲུབ་དགོས་དོན་ཅི་ཡོད།"]},{"type":"verse","number":29,"content":["མི་འདི་རྣམས་ངའི་དབང་འོག་ཏུ་ཡོད་པ་ཡིན་ན་བདག་གིས་ཨ་བི་མེ་ལེག་མེད་པར་བཟོ་བ་ཡིན་ཞེས་སྨྲས་པ་དང་། ཡང་གཱ་ཨལ་གྱིས་ཨ་བི་མེ་ལེག་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་ཀྱི་དམག་མི་ཇེ་མང་དུ་བཏང་ནས་ཕྱི་རུ་ཤོག་ཅིག་ཅེས་པ་དེ་ཡིན།"]},{"type":"verse","number":30,"content":["གྲོང་ཁྱེར་གྱི་འགོ་དཔོན་ཟེ་བུལ་གྱིས་ཨེ་བེད་ཀྱི་བུ་གཱ་ཨལ་གྱི་གཏམ་ཐོས་པ་དང་ཤིན་ཏུ་ཁྲོས་ཤིང་།"]},{"type":"verse","number":31,"content":["ལྐོག་ནས་ཨ་བི་མེ་ལེག་གི་རྩར་ཕོ་ཉ་མངགས་ཏེ་ན་རེ། ཨེ་བེད་ཀྱི་བུ་གཱ་ཨལ་དང་ཁོའི་སྤུན་རྣམས་སི་ཀེམ་དུ་སླེབས་ཤིང་། གྲོང་ཁྱེར་གྱི་མི་རྣམས་ལ་ཁྱོད་ལ་རྒོལ་བར་ངན་སྐུལ་བྱེད་ཀྱིན་ཡོད།"]},{"type":"verse","number":32,"content":["ད་ནི་ཁྱོད་དང་ཁྱོད་ཀྱི་རྗེས་འབྲང་བ་རྣམས་ཀྱིས་དོ་དགོང་ལོངས་ལ་ཞིང་ཁར་འཇབ་སྒུག་བྱོས་ཤིག"]},{"type":"verse","number":33,"content":["ཞོགས་པར་ཉི་རྩེ་བརྒྱབ་མ་ཐག་ཁྱོད་རང་ལངས་ནས་གྲོང་ཁྱེར་ནང་རྒྱུགས་ཤིག ལྟོས་དང་། གཱ་ཨལ་དང་ཁོའི་རྗེས་སུ་འབྲངས་པ་རྣམས་ཕྱི་རུ་ཐོན་ནས་ཁྱོད་ལ་རྒོལ་བའི་དུས་སུ། ཁྱོད་ཀྱིས་ཁོ་རྣམས་ལ་ཅི་བྱེད་ནུས་ན་དེ་ལྟར་བྱོས་ཤིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":34,"content":["ཨ་བི་མེ་ལེག་དང་ཁོའི་རྗེས་འབྲང་བ་རྣམས་མཚན་མོར་ལངས་ཏེ་ཁག་བཞི་རུ་བགོས་ཤིང་། སི་ཀེམ་པ་རྣམས་ལ་འཇབ་སྒུག་བྱས།"]},{"type":"verse","number":35,"content":["ཨེ་བེད་ཀྱི་བུ་གཱ་ཨལ་ཕྱི་རུ་ཐོན་ནས་མཁར་སྒོ་རུ་ལངས་བསྡད་པ་ལ། ཨ་བི་མེ་ལེག་དང་ཁོའི་རྗེས་སུ་འབྲངས་པ་རྣམས་འཇབ་སྒུག་བྱེད་ས་ནས་ལངས།"]},{"type":"verse","number":36,"content":["གཱ་ཨལ་གྱིས་མི་དེ་རྣམས་མཐོང་བ་དང་ཟེ་བུལ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ལྟོས་དང་། མི་རྣམས་རི་མགོ་ནས་མར་ཡོང་བཞིན་ཡོད་ཅེས་པ་ལ། ཟེ་བུལ་ན་རེ། ཁྱོད་ཀྱིས་རི་བོའི་གྲིབ་གཟུགས་མཐོང་ནས་མི་ཡིན་པར་སྙམ་པ་རེད་ཅེས་སྨྲས།"]},{"type":"verse","number":37,"content":["ཡང་གཱ་ཨལ་གྱིས་འདི་ལྟར་སྨྲས་པ་སྟེ། ལྟོས་དང་། མི་རྣམས་མཐོ་ས་ནས་མར་ཡོང་བཞིན་ཡོད། ཡང་རུ་ཁག་གཅིག་ནི་མོ་པའི་བེ་ཤིང་གི་ཕྱོགས་ནས་ཡོང་བཞིན་གདའ་ཞེས་པ་ལ།"]},{"type":"verse","number":38,"content":["ཟེ་བུལ་ན་རེ། དེ་སྔར་ཁྱོད་ཀྱིས་ཨ་བི་མེ་ལེག་ནི་སུ་ཡིན་ནམ། བདག་ཅག་གིས་ཁོ་ལ་ཞབས་ཕྱི་བསྒྲུབ་དགོས་དོན་ཅི་ཞེས་སྨྲས་ཤིང་། ཁྱོད་ཀྱིས་ཁ་ཕོ་བྱེད་པ་དེ་གང་དུ་ཡོད་དམ། འདི་ནི་ཁྱོད་ཀྱིས་མཐོང་ཆུང་བྱེད་པའི་མི་རྣམས་མ་ཡིན་ནམ། ད་ནི་ཁྱོད་རང་ཕྱི་རུ་སོང་ནས་ཁོ་རྣམས་དང་འཐབ་འཛིང་བྱོས་ཤིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":39,"content":["གཱ་ཨལ་གྱིས་སི་ཀེམ་པ་རྣམས་ཁྲིད་དེ་ཕྱི་རུ་སོང་ནས་ཨ་བི་མེ་ལེག་དང་འཐབ་འཛིང་བྱས།"]},{"type":"verse","number":40,"content":["ཨ་བི་མེ་ལེག་གིས་གཱ་ཨལ་བདས་པ་ལ། གཱ་ཨལ་ནི་ཁོའི་སྔུན་ནས་མཁར་སྒོའི་བར་དུ་བྲོས་ཤིང་མི་མང་པོ་རྨས་ཏེ་འགྱེལ་ནས་མཁར་སྒོ་རུ་སླེབས།"]},{"type":"verse","number":41,"content":["ཨ་བི་མེ་ལེག་ནི་ཨ་རུ་མཱ་ལ་གནས་པ་དང་། ཟེ་བུལ་གྱིས་གཱ་ཨལ་དང་དེའི་སྤུན་རྣམས་ཕྱིར་བསྐྲད་ཅིང་། ཁོ་རྣམས་སི་ཀེམ་ལ་སྡོད་དུ་མ་བཅུག་གོ །"]},{"type":"verse","number":42,"content":["དེའི་ཕྱི་ཉིན་མི་རྣམས་ཞིང་ཁར་སླེབས་པ་དང་། མི་ཞིག་གིས་ཨ་བི་མེ་ལེག་ལ་དོན་དེ་སྨྲས་པ་ན།"]},{"type":"verse","number":43,"content":["ཁོས་རང་གི་མི་རྣམས་ཁག་གསུམ་དུ་བགོས་ནས་ཞིང་ཁར་འཇབ་སྒུག་བྱས་ཤིང་། སི་ཀེམ་པ་རྣམས་གྲོང་ཁྱེར་ནས་ཕྱིར་ཐོན་པ་མཐོང་ནས་ལངས་ཏེ་ཁོ་རྣམས་དང་འཐབ་པ་ལ།"]},{"type":"verse","number":44,"content":["ཨ་བི་མེ་ལེག་དང་ཁོའི་རྗེས་སུ་འབྲངས་པའི་རུ་ཁག་མདུན་དུ་བརྒྱུགས་ནས་མཁར་སྒོ་རུ་ལངས་བསྡད་ཅིང་། གཞན་པའི་རུ་ཁག་གཉིས་ཞིང་ཁར་བརྒྱུགས་ནས་མི་རྣམས་ལ་འཐབ་པའོ། །"]},{"type":"verse","number":45,"content":["ཨ་བི་མེ་ལེག་གིས་ཉིན་གང་པོར་གྲོང་ཁྱེར་ལ་དམག་བརྒྱབ་ནས་གྲོང་ཁྱེར་ཕྲོགས་པ་དང་། དེའི་ནང་གི་མི་རྣམས་བསད་ཅིང་གྲོང་ཁྱེར་བཤིག་སྟེ་ཚྭ་གཏོར་བའོ། །"]},{"type":"verse","number":46,"content":["སི་ཀེམ་ལྕོག་མཁར་ནང་གི་མི་རྣམས་ཀྱིས་དེ་ཐོས་ནས་ལྷ་པེ་ཨེད་ཐུ་ཡི་ལྷ་ཁང་གི་ས་དོང་ནང་དུ་སྦས།"]},{"type":"verse","number":47,"content":["ཡང་མི་ཞིག་གིས་ཨ་བི་མེ་ལེག་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། སི་ཀེམ་ལྕོག་མཁར་ནང་གི་མི་རྣམས་ཕྱོགས་གཅིག་ཏུ་འཛོམས་འདུག་ཅེས་པས།"]},{"type":"verse","number":48,"content":["ཨ་བི་མེ་ལེག་དང་ཁོའི་རྗེས་སུ་འབྲངས་པའི་མི་ཐམས་ཅད་ཙལ་མོན་རི་བོར་འགོས་པ་དང་། ཨ་བི་མེ་ལེག་གིས་ལག་ལ་སྟ་རེ་བཟུང་སྟེ་ཡལ་ག་ཞིག་བཅད་ནས་ཕྲག་ལ་ཁུར་ཞིང་། རང་གི་རྗེས་སུ་འབྲངས་པའི་མི་རྣམས་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། ཁྱོད་རྣམས་ཀྱིས་བདག་གིས་ཅི་བྱེད་པ་མཐོང་བ་ཇི་བཞིན་མྱུར་བ་མྱུར་དུ་བྱོས་ཤིག་ཅེས་པ་ལ།"]},{"type":"verse","number":49,"content":["མི་རྣམས་ཀྱིས་སོ་སོར་ཡལ་ག་རེ་བཅད་ནས་ཨ་བི་མེ་ལེག་གི་རྗེས་སུ་འབྲངས་ཤིང་། ཡལ་ག་རྣམས་ས་དོང་གི་ཐོག་ཏུ་སྤུངས་ནས་ས་དོང་མེར་བསྲེགས་པ་ན། སི་ཀེམ་མཁར་གྱི་སྐྱེས་ཕོ་མོ་ཐམས་ཅད་ཤི་བ་དང་ཁྱོན་བསྡོམས་མི་ཆིག་སྟོང་ཙམ་ཡོད་དོ། །"]},{"type":"verse","number":50,"content":["དེ་ནས་ཨ་བི་མེ་ལེག་ནི་ཐེ་བེ་སི་ལ་ཕྱིན་ཏེ། དེའི་སྔུན་ནས་སྒར་བཏབ་ཅིང་གྲོང་ཁྱེར་ལ་དམག་བརྒྱབ་ནས་བླངས།"]},{"type":"verse","number":51,"content":["ཡང་གྲོང་ཁྱེར་ནང་དུ་ལྕོག་མཁར་བརྟན་པོ་ཞིག་ཡོད་ཅིང་། གྲོང་ཁྱེར་གྱི་སྐྱེས་ཕོ་མོ་ཐམས་ཅད་ལྕོག་མཁར་གྱི་ནང་དུ་བྲོས་ནས་སྒོ་བརྒྱབ་པ་དང་ལྕོག་མཁར་གྱི་ཀླད་ལ་བུད་དེ་བསྡད།"]},{"type":"verse","number":52,"content":["ཨ་བི་མེ་ལེག་ལྕོག་མཁར་གྱི་མདུན་དུ་སླེབས་ནས་འཐབ་ཅིང་མཁར་སྒོའི་ཉེ་སར་བཅར་ཏེ་མེས་བསྲེག་པར་བརྩམས་པ་ལ།"]},{"type":"verse","number":53,"content":["བུད་མེད་ཅིག་གིས་རང་ཐག་གི་རྡོ་ཞིག་ཨ་བི་མེ་ལེག་གི་མགོ་ལ་འཕངས་ཏེ་ཁོའི་ཀླད་རུས་གཏོར་བ་དང་།"]},{"type":"verse","number":54,"content":["ཁོས་རང་གི་མཚོན་ཆ་འཁུར་བའི་གཞོན་ནུ་མྱུར་དུ་བོས་ནས་དེ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། མི་རྣམས་ཀྱིས་ང་ནི་བུད་མེད་ཅིག་གིས་བསད་པ་ཡིན་ཞེས་མི་གླེང་བའི་ཕྱིར། ཁྱོད་ཀྱིས་རལ་གྲི་བཏོན་ནས་ང་རང་སོད་ཅིག་ཅེས་པ་དང་། གཞོན་ནུ་ཡིས་ཁོ་ལ་རལ་གྲིས་བསྣུན་པས་ཁོ་ཚེ་ལས་འདས་སོ། །"]},{"type":"verse","number":55,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཨ་བི་མེ་ལེག་ཚེ་ལས་འདས་པ་མཐོང་ནས་རང་རང་གི་གནས་སུ་ལོག་གོ །"]},{"type":"verse","number":56,"content":["དེ་བཞིན་དཀོན་མཆོག་གིས་ཨ་བི་མེ་ལེག་གིས་རང་གི་ཕ་ལ་བྱས་པའི་ལས་ངན་པ་སྟེ། སྤུན་བདུན་ཅུ་བོ་བསད་པའི་ངན་ལ་ངན་ལན་འཇལ།"]},{"type":"verse","number":57,"content":["སི་ཀེམ་པའི་ལས་ངན་པ་ཐམས་ཅད་ལའང་དཀོན་མཆོག་གིས་ངན་ལན་འཇལ་ཞིང་། ཡེ་རུབ་པཱ་ཨལ་གྱི་བུ་ཡོ་ཐམ་གྱི་དམོད་མོ་རྣམས་དེ་དག་གི་སྟེང་དུ་བབས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JDG/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JDG/8.json","previousChapterAudioLinks":{},"numberOfVerses":57}