{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["འདི་དག་ནི་པེན་ཡཱ་མེན་ཡུལ་གྱི་ཨ་ན་ཐོད་གྲོང་ཁྱེར་གྱི་མཆོད་དཔོན་ཏེ། ཧིལ་གི་ཡཱའི་བུ་ཡེ་རེམ་ཡཱའི་གསུང་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཨ་མོན་གྱི་བུ་ཡོ་ཤི་ཡཱས་རྒྱལ་སྲིད་སྐྱོང་བའི་ལོ་བཅུ་གསུམ་པར། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་སྟེ།"]},{"type":"verse","number":3,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱའི་བུ་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱིས་རྒྱལ་སྲིད་བསྐྱངས་པ་ནས། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱའི་བུ་ཚིད་ཀི་ཡཱ་ཡིས་རྒྱལ་སྲིད་སྐྱོང་བའི་དུས་མཇུག་སྟེ། ལོ་བཅུ་གཅིག་པའི་ཟླ་ལྔ་པའི་ནང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་བཙན་བཟུང་བྱས་པའི་སྐབས་སུ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་རྒྱུན་དུ་ཡེ་རེམ་ཡཱ་ལ་བྱུང་ངོ་། །"]},{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ལགས་བདམས་པ།"]},{"type":"verse","number":4,"content":["ཡེ་རེམ་ཡཱ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་བདག་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":5,"content":["བདག་གིས་ཁྱོད་མ་ཡི་མངལ་ནང་མ་བཀོད་སྔོན་དུ་ཁྱོད་རང་ངོ་ཤེས་པ་དང་། ཁྱོད་རང་མ་ཡི་མངལ་ལས་མ་ཐོན་སྔོན་དུ་བདག་གིས་ཁྱོད་དམ་པར་མཛད་ཅིང་། ཁྱོད་རང་མི་རིགས་རྣམས་ཀྱི་ལུང་སྟོན་པར་བསྐོས་པ་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":6,"content":["དེ་ནས་ངས་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། གཟིགས་དང་། ང་ནི་ལོ་ན་ཕྲ་བས་གཏམ་ཅི་ལྟར་སྨྲ་བའང་མི་ཤེས་སོ་ཞེས་ཞུས་པ་ན།"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ང་རང་ལོ་ན་ཕྲའོ་ཞེས་མ་བཤད་ཅིག ཅི་ལ་ཞེ་ན། བདག་གིས་ཁྱོད་སུ་དང་སུ་ཞིག་གི་གམ་དུ་མངགས་ཀྱང་ཁྱོད་དེར་འགྲོ་དགོས་ལ། བདག་གིས་ཁྱོད་ལ་བཀའ་བབས་ནས་ཅི་སྨྲ་བར་བཅུག་ན་ཁྱོད་ཀྱིས་དེ་བཞིན་སྨྲ་དགོས།"]},{"type":"verse","number":8,"content":["ཁྱོད་དེ་རྣམས་ལ་མ་འཇིགས་ཤིག ཅི་ལ་ཞེ་ན། བདག་ཁྱོད་དང་མཉམ་དུ་ཡོད་པ་དང་ཁྱོད་སྐྱོབ་པར་འགྱུར་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཕྱག་བརྐྱངས་ནས་ངའི་ཁ་ལ་རེག་སྟེ་ང་ལ་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་རང་གི་གཏམ་ཁྱོད་ཀྱི་སྨྲ་སྒོར་བཞག་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེ་རིང་བདག་གིས་ཁྱོད་ནི་མི་རིགས་དང་རྒྱལ་ཕྲན་ཐམས་ཅད་ཀྱི་མཐོ་སར་འགོད་པ་སྟེ། ཅི་ལ་ཞེ་ན། རྩ་ནས་འབལ་བ་དང་བཤིག་པ། རྩ་མེད་གཏོང་བ། ཕམ་པར་རྒྱག་པ་བཅས་དང་། ཡང་བསྐྱར་འཛུགས་པ་དང་འདེབས་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས།"]},{"type":"heading","content":["ཞལ་གཟིགས་གཉིས།"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་བདག་ལ་བྱུང་བ་འདི་ལྟ་སྟེ། ཡེ་རེམ་ཡཱ་ཁྱོད་ཀྱིས་ཅི་ཞིག་མཐོང་ངམ་ཞེས་གསུངས་པར། ངས་འདི་ལྟར། ངས་སྟར་སྡོང་གི་ཡལ་ག་ཞིག་མཐོང་བྱུང་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་མཐོང་པ་ལེགས་ཏེ། བདག་གིས་རང་གི་གཏམ་གཟབ་གཟབ་ངང་བསྲུངས་ནས་དེ་འགྲུབ་པར་བྱེད་ངེས་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":13,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཐེངས་གཉིས་པ་བདག་ལ་བྱུང་བ་འདི་ལྟ་སྟེ། ཡེ་རེམ་ཡཱ་ཁྱོད་ཀྱིས་ཅི་ཞིག་མཐོང་ངམ་ཞེས་གསུངས་པར། ངས་བྱང་ནས་ལྷོ་རུ་བསེགས་པའི་སྣོད་ལས་ཆུ་ཁོལ་བ་མཐོང་བྱུང་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། བྱང་ཕྱོགས་ནས་ཆག་སྒོ་འབྱུང་ཞིང་ཡུལ་འདིའི་མི་ཐམས་ཅད་ཀྱི་སྟེང་ལ་འབབ་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["ལྟོས་ཤིག བདག་གིས་བྱང་ཕྱོགས་རྒྱལ་ཕྲན་རྣམས་ཀྱི་མི་ཐམས་ཅད་བསྡུ་བར་བྱེད་ཅིང་། དེ་རྣམས་འོངས་ནས་རེ་རེས་ཡེ་རུ་སཱ་ལེམ་གྱི་མཁར་སྒོ་རུ་རང་རང་གི་བཞུགས་ཁྲི་འགོད་པ་དང་། ཉེ་འཁོར་གྱི་མཁར་རྣམས་ལ་རྒོལ་ཞིང་། ཡང་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ཐམས་ཅད་ལ་རྒོལ་བར་འགྱུར་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":16,"content":["མི་འདི་རྣམས་ཀྱིས་བདག་དོར་ནས་ལྷ་གཞན་རྣམས་ལ་སྤོས་བདུགས་ཏེ། རང་གི་ལག་པས་བཟོས་པ་ལ་ཕྱག་བཙལ་ཏོ། །བདག་གིས་སྤྱོད་ངན་འདི་ཐམས་ཅད་ཀྱི་ཕྱིར་དུ་དེ་རྣམས་ལ་ངའི་ཉེས་ཆད་བསྒྲག་པར་འགྱུར་རོ། །"]},{"type":"verse","number":17,"content":["དེ་བས། ཁྱོད་རྣམས་ཀྱིས་སྐ་རགས་ཆོངས་ལ་ཡར་ལོངས་དང་། བདག་གིས་ཁྱོད་ལ་བསྒོས་པའི་བཀའ་ཐམས་ཅད་དེ་དག་ལ་ཤོད་ཅིག བདག་གིས་ཁྱོད་ནི་དེ་དག་གི་མདུན་དུ་འཇིགས་པར་མི་བྱ་བའི་ཆེད་དུ། དེ་རྣམས་ཀྱི་དབང་གིས་ཁྱོད་མ་འཇིགས་ཤིག"]},{"type":"verse","number":18,"content":["ལྟོས་དང་། བདག་གིས་དེ་རིང་ཁྱོད་ནི་མཁར་བརྟན་པོ་དང་ལྕགས་ཀྱི་ཀ་བ། ལི་ཡི་གྱང་བཅས་སུ་བྱས་ནས་ས་གཞི་ཡོངས་ཏེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་དང་འགོ་དཔོན། མཆོད་དཔོན། ཡུལ་འདིའི་མི་ཐམས་ཅད་བཅས་ལ་འགོག་རྒོལ་བྱེད་དུ་འཇུག་གོ །"]},{"type":"verse","number":19,"content":["དེ་དག་གིས་ཁྱོད་ལ་རྒོལ་ན་ཡང་ཁྱོད་ལས་རྒྱལ་མི་ཐུབ། ཅི་ལ་ཞེ་ན། བདག་ཁྱོད་དང་མཉམ་དུ་ཡོད་པ་དང་ཁྱོད་སྐྱོབ་པར་འགྱུར་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ISA/66.json","previousChapterAudioLinks":{},"numberOfVerses":19}