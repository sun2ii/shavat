{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":13,"content":[{"type":"heading","content":["སྐ་རགས་ཀྱི་དཔེ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་སོང་ལ་སོ་རས་ཀྱི་སྐ་རགས་ཤིག་ཉོས་ཏེ་རྐེད་པར་དཀྲིས་ཤིག ཡང་དེ་ཆུའི་ནང་དུ་མ་སྦང་ཞིག་ཅེས་གསུངས་པས།"]},{"type":"verse","number":2,"content":["ངས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་སྐ་རགས་ཤིག་ཉོས་ནས་རང་གི་རྐེད་པར་དཀྲིས་སོ། །"]},{"type":"verse","number":3,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཐེངས་གཉིས་པ་ང་ལ་བྱུང་སྟེ་འདི་སྐད་དུ།"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་རང་གིས་ཉོས་ཡོང་ནས་རྐེད་པར་དཀྲིས་ཡོད་པའི་སྐ་རགས་ཁྱེར་ནས། ཡར་ལོངས་ལ་ཕི་རཱད་གཙང་པོའི་འགྲམ་དུ་སོང་ལ། སྐ་རགས་དེའི་བྲག་ཕུག་ནང་དུ་སྦ་བར་གྱིས་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བཀའ་བབས་པ་བཞིན་དུ། བདག་སོང་ནས་སྐ་རགས་དེ་ཕི་རཱད་གཙང་པོའི་འགྲམ་དུ་སྦས་སོ། །"]},{"type":"verse","number":6,"content":["ཡང་ཉིན་མང་པོ་འགོར་རྗེས་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ལོངས་ལ་ཕི་རཱད་གཙང་པོར་སོང་ནས། བདག་གིས་ཁྱོད་ལ་བཀའ་བབས་ཏེ་སྦས་པའི་སྐ་རགས་དེ་ལོངས་ཤོག་ཅེས་གསུངས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ང་ཕི་རཱད་གཙང་པོར་སོང་ནས་སྐ་རགས་དེ་ངས་སྦས་ས་ནས་བསློགས་ཏེ་བླངས་པ་ན། ལྟོས་ཤིག སྐ་རགས་ཧྲུལ་ནས་བེད་མེད་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":8,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་ཡ་ཧུ་དཱའི་ང་རྒྱལ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་རང་སྣང་ཆེན་པོ་ཡང་དེ་དང་དེ་བཞིན་དུ་ཉམས་པར་བྱའོ། །"]},{"type":"verse","number":10,"content":["མི་ངན་པ་འདི་དག་གིས་ངའི་བཀའ་ལ་མི་མཉན་པར། རང་གི་གཤིས་རྒྱུད་གྱོང་པོ་བཞིན་དུ་སྤྱོད་པ་སྤྱད་དེ། ལྷ་གཞན་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་པ་དང་དེ་དག་ལ་ཞབས་ཏོག་བསྒྲུབས་ནས་ཕྱག་བཙལ་བས། ཁོ་རྣམས་ཀྱང་སྐ་རགས་འདི་བཞིན་དུ་སྤྱོད་ཡུལ་གང་ཡང་མེད་པར་འགྱུར།"]},{"type":"verse","number":11,"content":["སྐ་རགས་ཅི་ལྟར་མི་ཡི་རྐེད་པར་འབྱར་བ་བཞིན། ངས་ཀྱང་ཡེས་ར་ཨེལ་ཁྱིམ་རྒྱུད་ཐམས་ཅད་དང་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ཐམས་ཅད་ནི། ང་ལ་གཏོགས་པའི་མི་ལ་གྱུར་ནས་ང་ལ་མཚན་སྙན་གྲགས་དང་། བསྟོད་པ། གཟི་བརྗིད་བཅས་འབྱུང་བར་ངས་རང་ལ་སྦྱར་བ་ཡིན་མོད། འོན་ཀྱང་དེ་དག་གིས་མཉན་པར་མ་འདོད་དོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"heading","content":["རྒུན་ཆང་གི་རྫ་མའི་དཔེ།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར། ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། རྒུན་ཆང་གི་རྫ་མ་རེ་རེ་རྒུན་ཆང་གིས་བཀང་བར་བྱོས་ཤིག་ཅེས་པའོ་ཞེས་སྨྲོས་དང་། དེ་དག་གིས་ཁྱོད་ལ་ལན་དུ། ངེད་ཅག་གིས་རྒུན་ཆང་གི་རྫ་མ་རེ་རེ་རྒུན་ཆང་གིས་བཀང་བར་བྱེད་མི་ཤེས་སམ་ཞེས་སྨྲ་བར་འགྱུར་ལ།"]},{"type":"verse","number":13,"content":["ཡང་ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་གནས་འདིའི་ཡུལ་མི་ཐམས་ཅད་དེ། དཱ་བིད་ཀྱི་ཁྲི་ལ་བཞུགས་པའི་རྒྱལ་པོ་དང་མཆོད་དཔོན། ལུང་སྟོན་པ། ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་ཐམས་ཅད་རྒུན་ཆང་གིས་རབ་ཏུ་བཟི་བར་བྱེད་ཅིང་།"]},{"type":"verse","number":14,"content":["བདག་གིས་དེ་རྣམས་ཕན་ཚུན་འགལ་བར་བྱེད་དེ་ཕ་དང་བུ་ཡང་ཕན་ཚུན་འགལ་བར་འགྱུར། བདག་གིས་གཅེས་སུ་མི་འཛིན་ཞིང་། ཤ་ཚ་བར་མི་བྱེད་ལ། སྙིང་རྗེ་ཡང་མི་བྱེད་པར་དེ་དག་ཚར་དུ་གཅོད་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་ཡིན་པས་ཁྱོད་ཚོས་ཉོན་ཅིག རྣ་བ་གཏད་ནས་ཉོན་ཅིག ང་རྒྱལ་མ་སྐྱེས་ཤིག"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ད་དུང་མུན་ནག་མ་གནང་གོང་དང་། ཁྱོད་རྣམས་ཀྱི་རྐང་པ་མུན་པ་འཐིབས་པའི་རི་བོར་མ་འགྱེལ་སྔོན་དུ། གཟི་བརྗིད་ཐམས་ཅད་ཁོང་ལ་ཕུལ་དང་། དེ་མིན་ཚེ་ཁྱོད་རྣམས་ཀྱིས་འོད་ལ་སྒུག་ཀྱང་ཁོང་གིས་འོད་ནི་སྨག་རུམ་དང་མུན་ནག་ཏུ་མཛད་དོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱིས་གཏམ་འདིར་མི་མཉན་ན། ཁྱོད་ཚོའི་ང་རྒྱལ་གྱི་ཕྱིར་ང་རང་ཕག་ནས་ངུས་ཏེ་ངའི་མིག་ལས་སྡུག་གི་མཆི་མ་བཞུར་ངེས་ཡིན། ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་ལུག་ཁྱུ་བཙོན་དུ་ཁྱེར་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་རྒྱལ་པོ་དང་རྒྱལ་ཡུམ་གཉིས་ལ་འདི་ལྟར། ཁྱོད་ཅག་གི་དཔལ་དང་ལྡན་པའི་ཅོད་པན་དེ་ཁྱོད་ཚོའི་མགོ་ནས་མར་ལྷུང་བས་ན་ཁྱོད་རྣམས་ནི་ཁེངས་སྐྱུང་ངང་སྡོད་ཅིག་ཅེས་སྨྲོས་ཤིག"]},{"type":"verse","number":19,"content":["ནེ་གུབ་ཡུལ་གྱི་གྲོང་ཁྱེར་རྣམས་ཀྱི་སྒོ་བརྒྱབ་ནས་དེ་འབྱེད་མཁན་སུ་ཡང་མེད་ལ། ཡ་ཧུ་དཱ་ཡོངས་རྫོགས་བཙོན་དུ་ཁྱེར་ནས་ཚང་མ་བཙོན་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་ཀྱིས་མགོ་བོ་ཡར་བཀྱགས་ཏེ་བྱང་ཕྱོགས་ནས་འོངས་པའི་མི་རྣམས་ལ་ལྟོས་ཤིག ཁྱོད་ཀྱིས་གཟི་བརྗིད་དུ་བརྩིས་པའི་ལུག་ཁྱུ་སྟེ་སྔར་ཁྱོད་ལ་གནང་བའི་ལུག་ཁྱུ་ད་ལྟ་གང་དུ་ཡོད་དམ།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱིས་བསླབས་པའི་མནའ་གྲོགས་རྣམས་འགོ་དཔོན་དུ་བསྐོས་ནས་ཁྱོད་ལ་དབང་བསྒྱུར་བར་མཛད་པས་ཁྱོད་ལ་སྨྲ་བ་ཅི་ཞིག་ཡོད་དམ། ཁྱོད་སྡུག་བསྔལ་གྱིས་བཟུང་ནས་གཟེར་རྒྱག་པའི་བུད་མེད་ལྟར་འགྱུར་བ་མ་ཡིན་ནམ།"]},{"type":"verse","number":22,"content":["ཇི་སྟེ་ཁྱོད་ཀྱིས་སེམས་སུ་དོན་འདི་ཐམས་ཅད་བདག་གི་སྟེང་དུ་བྱུང་བ་ཅི་ཡིན་ནམ་སྙམ་ན། ཁྱོད་ཀྱི་ཐུ་བ་རྣམས་ཡར་བཀྱགས་ནས་ཁྱོད་ཀྱི་ཕྱི་རྟིང་རྨས་པ་",{"noteId":5},"ནི་ཁྱོད་སྡིག་པ་ཆེ་བའི་རྐྱེན་གྱིས་ཡིན།"]},{"type":"verse","number":23,"content":["གུ་ཤ་པས་སྐྱི་མོ་ག་ལ་བསྒྱུར་ཐུབ་བམ། གཟིག་གིས་རང་གི་ཁྲ་ཐིག་བརྗེ་ནུས་སམ། ཇི་སྟེ་ནུས་ན། སྤྱོད་ངན་ལ་གོམས་པ་ཁྱོད་ཚོས་ཀྱང་བཟང་པོ་སྤྱོད་ནུས་པ་ཡིན།"]},{"type":"verse","number":24,"content":["དེ་བས་ངས་དེ་དག་ནི་དབེན་སྟོང་གི་རླུང་གིས་འཁྱེར་བའི་སྦུར་མ་ལྟར་འཁུར་བར་བྱའོ། །"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། འདི་ནི་ཁྱོད་ལ་འཐོབ་འོས་པ་སྟེ་བདག་གིས་ཁྱོད་ལ་ཚད་པའི་ཟ་སྐལ་ཡིན། ཅི་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་ང་བརྗེད་པར་གྱུར་ནས་རྫུས་མ་ལ་བརྟེན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":26,"content":["དེའི་ཕྱིར་ངས་ཁྱོད་ཀྱི་ཐུ་བ་ཡར་བརྫེས་ནས་ཁྱོད་ཀྱི་གདོང་ལ་བཀབ་སྟེ་ཁྱོད་ཀྱི་ངོ་ཚ་རྣམས་མངོན་པར་བྱ།"]},{"type":"verse","number":27,"content":["ཁྱོད་ཀྱིས་ས་སྟོང་གི་རི་ཀླུང་རྣམས་སུ་ལོག་གཡེམ་སྤྱད་ནས་སྐད་ཅོར་རྒྱག་པ་དང་། གཡེམ་སྦྱོར་ལ་བརྩོན་པའི་ཞེན་ལོག་གི་ལས་འདི་རྣམས་ངས་མཐོང་བ་ཡིན། ཀྱེ་ཡེ་རུ་སཱ་ལེམ་ཁྱོད་ལ་ཆག་སྒོ་འབྱུང་། ཁྱོད་གཙང་མར་བཟོ་མི་འདོད་པར་ག་དུས་བར་དུ་བསྒུག་དགོས་སམ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"འདིར་ཕྱི་རྟིང་རྨས་པ་ཞེས་པ་ནི་བཙན་གཡེམ་བྱས་པར་གོ་བ་ཡིན།","reference":{"chapter":13,"verse":22}}]},"thisChapterLink":"/api/bod_ntb/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}