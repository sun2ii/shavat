{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":14,"content":[{"type":"heading","content":["འཇིགས་སུ་རུང་བའི་ཐན་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་ནས་ཐན་པའི་སྐོར་གླེང་བ་སྟེ།"]},{"type":"verse","number":2,"content":["ཡ་ཧུ་དཱ་ཡིས་མྱ་ངན་བྱེད། དེའི་མཁར་སྒོ་རྣམས་ཉམས་པར་གྱུར་ནས་མི་ཐམས་ཅད་སར་བསྡད་དེ་མྱ་ངན་ཞུ་ཞིང་། ཡེ་རུ་སཱ་ལེམ་གྱི་ངུ་སྐད་ཡར་ཁྱབ་པ་ཡིན།"]},{"type":"verse","number":3,"content":["དེ་དག་གི་སྐུ་དྲག་རྣམས་ཀྱིས་ཞབས་ཕྱི་རྣམས་ཆུ་ལེན་དུ་མངགས་ནས། དེ་རྣམས་རྫིང་བུའི་འགྲམ་དུ་ཕྱིན་ཡང་ཆུ་མ་རྙེད་པས་སྣོད་སྟོང་བ་ཁུར་ནས་ངོ་ཚ་ཞིང་མགོ་བསྒུར་ཏེ་ཕྱིར་ལོག་འོང་།"]},{"type":"verse","number":4,"content":["ས་ལ་ཆར་མ་བབས་པར་ས་གཞི་སྐམ་ནས་གས་པར་གྱུར་པས། ཞིང་བ་རྣམས་ཀྱང་ངོ་ཚ་ནས་མགོ་བསྒུར་ཏོ། །"]},{"type":"verse","number":5,"content":["དེ་ཡང་རྩྭ་མེད་པས་ན་ཐང་རྒོད་ཀྱི་ཤ་མོ་ལ་ཤ་ཕྲུག་སྐྱེས་ཀྱང་དེ་སྤང་བར་བྱེད།"]},{"type":"verse","number":6,"content":["རྐྱང་རྣམས་སྐྱ་ཐེར་ཐེར་གྱི་རི་སྒང་དུ་འགྲེང་ཞིང་ཁྱི་སྤྱང་ལྟར་དབུགས་རྔུབ་པ་དང་། རྩྭ་མེད་པས་དེ་དག་གི་མིག་ལ་མདངས་མེད་པར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":7,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ངེད་རྣམས་ཀྱིས་ཐེངས་མང་པོར་ངོ་ལོག་བྱས་ཏེ་ཁྱེད་དང་འགལ་བའི་སྡིག་པ་བསགས་པས། ངེད་ཅག་གི་སྡིག་པས་ངེད་རྣམས་ལ་ར་སྤྲོད་བྱེད་ནའང་། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་མཚན་གྱི་དོན་དུ་ད་དུང་འཕྲིན་ལས་མཛོད་ཅིག"]},{"type":"verse","number":8,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་རེ་བ་བཅོལ་ས་དང་དཀའ་སྡུག་ལ་འཕྲད་དུས་སྐྱབས་སུ་འགྲོ་ས་ལགས། ཁྱེད་ནི་ཡུལ་ཁམས་འདིར་བྱེས་སུ་སྡོད་པའི་མི་དང་མཚུངས་ཤིང་། ཡང་ན་ཞག་གཅིག་ལ་མ་གཏོགས་མི་འདུག་པའི་མགྲོན་པོ་ཞིག་དང་འདྲ་བ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":9,"content":["ཁྱེད་ནི་ཧོན་འཐོར་བའི་མི་ཞིག་གམ། ཡང་ན་མི་སྐྱོབ་པར་མི་ནུས་པའི་དཔའ་བོ་ཞིག་དང་འདྲ་བ་ཅི་ཡིན་ནམ། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ནི་སྔར་བཞིན་ངེད་ཅག་གི་དཀྱིལ་དུ་བཞུགས་ཤིང་། ངེད་རྣམས་ནི་ཁྱེད་ཀྱི་མཚན་ལ་གཏོགས་པའི་མི་ཡིན་པས། ཁྱེད་ཀྱིས་ངེད་རྣམས་འདོར་བར་མི་མཛད་རོགས།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མི་འདི་རྣམས་ལ་འདི་སྐད་དུ། མི་འདི་དག་ནི་གང་སར་འཁྱམ་པ་ལ་དགའ་ཞིང་རང་གི་གོམ་སྟབས་ལ་ཚོད་མ་བཟུང་བའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་དང་ལེན་མི་བྱེད་པར། ད་ལྟ་ཁོང་གིས་དེ་ཚོའི་སྡིག་ཉེས་རྣམས་དྲན་ཞིང་། དེ་དག་གི་སྡིག་པའི་ཕྱིར་དུ་ཉེས་ཆད་གཅོད་དོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":11,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། མི་འདི་དག་ལ་བྱིན་རླབས་འཐོབ་པའི་ཕྱིར་ཞུ་བ་མ་བྱེད་ཅིག"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་སྨྱུང་གནས་སྲུང་དུས་ངས་ཁོ་ཚོའི་ཞུ་བར་མི་མཉན་ལ། སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་རིགས་ཀྱི་མཆོད་པ་འབུལ་དུས་ངས་དང་ལེན་མི་བྱེད་པར། ངས་དེ་དག་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ཀྱིས་མེད་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་ངས་འདི་ལྟར། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། གཟིགས་དང་། ལུང་སྟོན་པ་རྣམས་ཀྱིས་ནམ་རྒྱུན་དེ་རྣམས་ལ། ཁྱོད་ཅག་གིས་རལ་གྲི་མཐོང་བར་མི་འགྱུར། མུ་གེའང་འབྱུང་བར་མི་འགྱུར། དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་ཁམས་འདི་ནས་ཁྱོད་རྣམས་ལ་དུས་གཏན་གྱི་ཞི་བདེ་གནང་བར་འགྱུར་ཞེས་སྨྲས་སོ་ཞུས་པ་ལ།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ལུང་སྟོན་པ་དེ་རྣམས་ཀྱིས་ངའི་མིང་གཡར་ནས་རྫུན་གྱི་ལུང་སྟོན་པ་དང་། ངས་དེ་དག་མ་མངགས་ལ་ཁོ་ཚོར་བཀའ་ཡང་མ་བསྒོས། གསུང་ཡང་མ་གནང་ངོ་། །དེ་དག་གིས་ཁྱོད་རྣམས་ལ་ལུང་བསྟན་པ་ནི་ཞལ་གཟིགས་རྫུས་མ་དང་མོ་དང་། སྙིང་པོ་མེད་པའི་དོན། རང་སེམས་ཀྱི་གཡོ་སྒྱུ་བཅས་ཡིན་པས།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ངའི་མིང་གཡར་ནས་ལུང་སྟོན་མཁན་གྱི་ལུང་སྟོན་པ་དེ་རྣམས་གླེང་ན་ངས་དེ་རྣམས་མངགས་མེད། དེ་དག་གིས་ཡུལ་འདི་ལ་རལ་གྲི་དང་མུ་གེ་མི་འབྱུང་ཟེར་ཡང། དོན་དམ་དུ་ལུང་སྟོན་པ་དེ་དག་ནི་རལ་གྲི་དང་མུ་གེས་མེད་པར་བཟོ་ངེས་ཡིན།"]},{"type":"verse","number":16,"content":["དེ་དག་གི་ལུང་བསྟན་ལ་ཉན་པའི་མི་རྣམས་ཀྱང་མུ་གེ་དང་རལ་གྲིའི་རྐྱེན་གྱིས། ཡེ་རུ་སཱ་ལེམ་གྱི་སྲང་ལམ་དུ་གཡུགས་ནས་དུར་ལ་འཇུག་མཁན་ཡང་མེད་དེ། ཁོ་རྣམས་ཀྱི་ཆུང་མ་དང་བུ་བུ་མོ་རྣམས་ཀྱང་དེ་བཞིན་ཡིན། ངས་དེ་དག་གི་ངན་པ་ནི་དེ་ཚོའི་སྟེང་དུ་བླུག་པར་འགྱུར།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་དེ་རྣམས་ལ་འདི་ལྟར། ངའི་མི་རྣམས་ལ་གནོད་པ་ཚབས་ཆེན་ཐེབས་ཏེ་རྨ་ཁ་རབ་ཏུ་ཆེ་བས། ངའི་མིག་ནས་ཉིན་མཚན་མེད་པར་མཆི་མ་བཞུར་བར་གྱུར་ཅིག"]},{"type":"verse","number":18,"content":["གལ་ཏེ་ང་རང་ཞིང་ཁར་ཕྱིན་ན། ལྟོས་དང་། དེ་རུ་རལ་གྲིས་བསད་པ་རྣམས་མཐོང་ཞིང་། གལ་ཏེ་ང་རང་གྲོང་ཁྱེར་དུ་ཕྱིན་ན། ལྟོས་དང་། དེར་མུ་གེ་ལས་བྱུང་བའི་ནད་པ་རྣམས་འདུག ལུང་སྟོན་པ་དང་མཆོད་དཔོན་རྣམས་ཀྱང་ཡུལ་རྒྱུས་མེད་ཅིག་ལ་འགྲིམས་པ་ལས། ཅི་བྱེད་དགོས་མི་ཤེས་ཞེས་སྨྲོས་ཤིག་གསུངས་སོ། །"]},{"type":"heading","content":["མི་རྣམས་ཀྱིས་ཡ་ཝཱེའི་སྙིང་རྗེ་ཞུ་བ།"]},{"type":"verse","number":19,"content":["ཁྱེད་ཀྱིས་ཡ་ཧུ་དཱ་ཡོངས་སུ་སྤངས་པ་ཡིན་ནམ། ཁྱེད་ཉིད་ཛ་ཡན་ལ་ཞེ་ལོག་པ་ཡིན་ནམ། ཁྱེད་ཀྱིས་ངེད་རྣམས་ལ་བརྡུངས་ནས་གསོ་ཐབས་མེད་པར་མཛད་པ་ཅི་ཡིན་ནམ། ངེད་ཅག་གིས་ཞི་བདེ་ལ་རེ་ཡང་ཕན་གང་ཡང་མ་ཐོགས། ནད་སངས་པར་རེ་ཡང་འཇིགས་སྐྲག་ཐེབས་བྱུང་།"]},{"type":"verse","number":20,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ངེད་རྣམས་ཀྱིས་ཁྱེད་ལ་འགལ་བའི་སྡིག་པ་བྱས་པས། ངེད་ཅག་གིས་རང་གི་སྡིག་ཉེས་དང་ཕ་མེས་རྣམས་ཀྱི་སྡིག་པ་རྣམས་ཁས་ལེན་པར་བྱའོ། །"]},{"type":"verse","number":21,"content":["ཁྱེད་ཀྱིས་ཉིད་ཀྱི་མཚན་གྱི་ཕྱིར་ངེད་རྣམས་མི་འདོར་ཞིང་། རང་གི་གཟི་བརྗིད་ཀྱི་བཞུགས་ཁྲི་ལ་དམའ་འབེབ་མི་མཛད་རོགས། ཁྱེད་ཀྱིས་ངེད་རྣམས་ལ་བཞག་པའི་ཞལ་ཆད་ཐུགས་སུ་དྲན་ནས་དེ་དང་འགལ་བར་མི་མཛད་རོགས།"]},{"type":"verse","number":22,"content":["ཕྱི་རོལ་པའི་སྙིང་པོ་མེད་པའི་ལྷ་རྣམས་ཀྱི་ནང་དུ་ཆར་བ་འབེབ་ནུས་པ་ཡོད་དམ། ནམ་མཁའ་རང་གིས་སྦྲང་ཆར་འབེབ་ནུས་སམ། ཀྱེ་ངེད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། དེ་བཞིན་མཛད་ནུས་པ་ནི་ཁྱེད་རང་མ་ཡིན་ནམ། དེའི་ཕྱིར་འདི་དག་ཐམས་ཅད་ཁྱེད་ཀྱིས་བཀོད་པས་ན། ངེད་ཅག་གིས་ཁྱེད་ལ་རེ་བར་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}