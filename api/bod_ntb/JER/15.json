{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":15,"content":[{"type":"heading","content":["ཡ་ཧུ་དཱའི་མི་རྣམས་ཀྱི་རྐྱེན་ངན།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། མོ་ཤེ་དང་སཱ་མུ༌ཨེལ་གཉིས་ངའི་དྲུང་དུ་ལངས་བསྡད་ནའང་། ངའི་སེམས་མི་འདི་རྣམས་ཀྱི་ཕྱོགས་སུ་བསྒྱུར་བར་མི་བྱ་སྟེ། ཁྱོད་ཀྱིས་དེ་དག་ངའི་མིག་མདུན་ནས་ཕྱིར་སྐྲོད་ཅིག དེ་དག་འགྲོ་རུ་ཆུག་ཅིག"]},{"type":"verse","number":2,"content":["ཡང་དེ་དག་གིས་ཁྱོད་ལ་ངེད་རྣམས་གང་དུ་འགྲོའམ་ཞེས་དྲིས་ན། ཁྱོད་ཀྱིས་དེ་རྣམས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། འཆི་དགོས་པ་རྣམས་འཆི་བར་ངེས་ལ། རལ་གྲིས་གསོད་དགོས་པ་རྣམས་གསོད་པར་འགྱུར། མུ་གེ་འབྱུང་དགོས་པ་རྣམས་ལ་མུ་གེ་འབྱུང་། བཙོན་དུ་འཁྲིད་དགོས་པ་རྣམས་བཙོན་ལ་འཁྲིད་ངེས་ཡིན་ཞེས་གསུངས་སྨྲོས་ཤིག"]},{"type":"verse","number":3,"content":["ངས་དེ་རྣམས་ཀྱི་སྟེང་དུ་གནོད་འཚེ་རིགས་བཞི་ཐེབས་པར་བྱ་སྟེ། གསོད་དུ་རལ་གྲི་དང་འདྲུད་དུ་ཁྱི། བཟའ་བ་དང་མེད་པར་བྱེད་དུ་ནམ་མཁའི་བྱ་དང་ཐང་གི་གཅན་གཟན་བཅས་སོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":4,"content":["ཧི་ཟི་ཀི་ཡཱའི་བུ་སྟེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་མཱ་ན་ཤེ་ཡིས་ཡེ་རུ་སཱ་ལེམ་དུ་སྤྱད་པའི་ལས་ཀྱི་རྐྱེན་གྱིས། ངས་གནམ་འོག་གི་རྒྱལ་ཕྲན་ཀུན་ཏུ་དེ་རྣམས་སྐྱུག་བྲོ་བར་བྱའོ། །"]},{"type":"verse","number":5,"content":["ཀྱེ་ཡེ་རུ་སཱ་ལེམ། སུས་ཁྱོད་ལ་སྙིང་རྗེ་བར་འགྱུར་རམ། སུས་ཁྱོད་ཀྱི་དོན་དུ་མྱ་ངན་བྱེད་དམ། སུས་ཁ་ཕྱིར་འཁོར་ནས་ཁྱོད་ལ་ཁམས་འདྲི་ཞུའམ།"]},{"type":"verse","number":6,"content":["ཁྱོད་ཀྱིས་ང་རང་དོར་ཏེ་ཁ་ཕྱིར་འཁོར་ནས་སོང་བས། ངས་ལག་པ་བརྐྱངས་ནས་ཁྱོད་ལ་རྒོལ་ཞིང་ཁྱོད་མེད་པར་བཟོ་དགོས་ལ། བདག་བློ་ཁ་ཚུར་འཁོར་བའི་དཔེ་མེད་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":7,"content":["ངས་ཡུལ་ཁམས་ཀྱི་མཁར་སྒོ་རྣམས་སུ་ཚེབ་ཀྱིས་ངའི་མི་རྣམས་ཕྱར་ཞིང་དེ་དག་ལ་ཕྲུ་གུ་ཤོར་དུ་བཅུག ཡང་དེ་རྣམས་མེད་པར་བཟོས་ཀྱང་དེ་དག་རང་གི་ལམ་དང་མ་བྲལ་ཏོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་གི་ཡུགས་མོ་རྣམས་ནི་ངའི་མདུན་དུ་རྒྱ་མཚོའི་བྱེ་མ་ལས་ཀྱང་མང་སྟེ། ངས་ཉིན་གུང་ལ་སྲོག་ལེན་མཁན་འོང་དུ་བཅུག་ནས། གཞོན་ནུ་རྣམས་ཀྱི་མ་རྣམས་འཇོམས་པར་བྱེད་ཅིང་། སྡུག་བསྔལ་དང་འཇིགས་སྣང་གཉིས་ཀ་གློ་བུར་མོའི་སྟེང་ལ་སླེབ་པར་བྱ།"]},{"type":"verse","number":9,"content":["ཕྲུ་གུ་བདུན་བཙས་པའི་བུད་མེད་ནི་ཉམ་ཐག་པར་གྱུར་ཏེ། ཉིན་དཀར་ཡིན་ཡང་ཉི་མ་གློ་བུར་ནུབ་ཅིང་། མོ་སྐྱེངས་ཤིང་ངོ་ཚ་བར་འགྱུར། དེ་དག་གི་ལྷག་ལུས་རྣམས་ནི་ཁོ་ཚོའི་དགྲ་བོའི་མདུན་དུ་གྲིར་གཏོད་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ཡིས་ཡ་ཝཱེ་ལ་སྡུག་བགྲང་བ།"]},{"type":"verse","number":10,"content":["ཀྱེ་ཧུད་བདག་གི་མ་ཡུམ་ལགས། ང་ལ་ཆག་སྒོ་འབྱུང་ངོ་། །ཅི་ལ་ཞེ་ན། ས་གཞི་ཐམས་ཅད་དུ་ཀུན་དང་མི་མཐུན་པའི་མི་རུ་འགྱུར་བར་ཁྱེད་ཀྱིས་ང་བཙས་པ་ཡིན། ངས་སྔར་ནས་མི་ལ་དངུལ་མ་གཡར་ཞིང་། མི་ཡིས་ང་ལ་བུ་ལོན་ཡང་མ་བཏང་མོད། འོན་ཀྱང་མི་རེ་རེས་ང་ལ་དམོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ལ་ཕན་ཐོགས་པའི་ཕྱིར་ངས་ཁྱོད་སྒྲོལ་བར་འགྱུར། ཡང་བར་ཆད་དང་སྡུག་བསྔལ་འབྱུང་དུས། བདག་གིས་ཁྱོད་ཀྱི་དགྲ་བོ་རྣམས་ལ་ཁྱོད་ལ་ཞུ་བ་བྱེད་དུ་འཇུག་གོ །"]},{"type":"verse","number":12,"content":["སུ་ཞིག་གིས་བྱང་ཕྱོགས་ཀྱི་ལྕགས་ཏེ་ལི་དང་ལྕགས་གཉིས་གཅོད་ནུས་སམ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱིས་མངའ་འོག་གི་ཡུལ་གྲུ་ཀུན་ཏུ་བྱས་པའི་སྡིག་པ་ཐམས་ཅད་ཀྱི་རྐྱེན་གྱིས། བདག་གིས་ཁྱོད་ཀྱི་རྒྱུ་ནོར་དང་རིན་པོ་ཆེ་རྣམས་བཅོམ་ནོར་ལྟར་རིན་མེད་དུ་དགྲ་བོ་རྣམས་ལ་སྤྲོད་པར་བྱ།"]},{"type":"verse","number":14,"content":["བདག་གི་ཁོང་ཁྲོ་མེ་ལྟར་འབར་ནས་ཁྱོད་རྣམས་བསྲེག་རྒྱུ་ཡིན་པས། བདག་གིས་ཁྱོད་ཀྱི་དགྲ་རྣམས་ཁྱོད་ལ་རྒྱུས་མི་མངའ་བའི་གནས་སུ་འགྲོ་རུ་འཇུག་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":15,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་མཁྱེན་ཏེ། ཁྱེད་ཀྱིས་ང་ཐུགས་སུ་དྲན་ནས་གཟིགས་སྐྱོང་གནང་བར་མཛོད། བདག་ལ་གནོད་སྐྱེལ་བའི་མི་ལ་འཁོན་ལན་སློགས་ཤིག ཁྱེད་ཉིད་རང་དགར་ཐུགས་མི་ཁྲོ་བས་ང་ཡི་ཚེ་སྲོག་མི་ལེན་པར་མཛོད། ཅི་ལ་ཞེ་ན། ཁྱེད་ཀྱི་ཕྱིར་དུ་བདག་ལ་བརྙས་བཅོས་ཐེབས་པས་སོ། །"]},{"type":"verse","number":16,"content":["དཔུང་ཚོགས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱི་བཀའ་གསུང་བདག་ལ་ཐོབ་པས་ངས་དེ་ཟོས་པ་དང་། ང་ནི་ཁྱེད་ཀྱི་མཚན་ཐོགས་པའི་མི་ཡིན་པས་ཁྱེད་ཀྱི་བཀའ་ནི་ངའི་སེམས་ཀྱི་དགའ་སྤྲོ་ཆེན་པོ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["བདག་ནི་འདོད་ཡོན་ཅན་གྱི་ཚོགས་ནང་བསྡད་ནས་དགའ་མགུ་མ་བྱས། ཁྱེད་ཀྱི་ཕྱག་གི་རྐྱེན་གྱིས་ང་རང་གཅིག་པུར་བསྡད་དེ། ཁྱེད་ཀྱིས་ངའི་སེམས་སུ་ཁོང་ཁྲོས་བཀང་བར་མཛད།"]},{"type":"verse","number":18,"content":["ངའི་སྡུག་བསྔལ་གཏན་དུ་ལུས་པ་ཅི་ཡིན་ནམ། ངའི་རྨ་ཁ་གསོ་ཐབས་མེད་པ་དང་མི་དྲག་པ་དེ་ཅི་ཡིན་ནམ། ཁྱེད་ནི་བདག་ལ་མི་སེམས་སླུ་བའི་ཆུ་ཕྲན་ལྟ་བུ་ཡིན་ནམ།"]},{"type":"verse","number":19,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཇི་སྟེ་ཁྱོད་ཀྱིས་འགྱོད་བཤགས་བྱས་ན་ངས་ཀྱང་ཁྱོད་ཡང་བསྐྱར་ངའི་མདུན་དུ་འགྲེང་བར་བྱའོ། །ཡང་གལ་ཏེ་ཁྱོད་ཀྱིས་སྐད་ཆ་རྩ་ཆེན་སྨྲ་བ་ལས་རིན་ཐང་མེད་པ་དོར་ན་ཁྱོད་ངའི་སྨྲ་སྒོ་རུ་འགྱུར། དེ་དག་ཁྱོད་ཀྱི་ཕྱོགས་སུ་ལོག་འོང་ངེས་ལ། ཁྱོད་ནི་དེ་དག་གི་ཕྱོགས་སུ་མི་འགྲོའོ། །"]},{"type":"verse","number":20,"content":["ཡང་ངས་མི་འདི་རྣམས་ཀྱི་ཕྱོགས་སུ་ཁྱོད་རང་ལི་ཡི་ལྕགས་རི་བརྟན་པོར་བྱེད་ཅིང་། དེ་ཚོས་ཁྱོད་ལ་རྒོལ་ཡང་ཁྱོད་ལས་རྒྱལ་བར་མི་འགྱུར། ཅི་ལ་ཞེ་ན། ཁྱོད་སྐྱོབ་ཅིང་སྒྲོལ་བའི་ཕྱིར་ང་རང་ཁྱོད་དང་འགྲོགས་ཡོད་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":21,"content":["ཡང་ངས་ཁྱོད་ནི་སྡིག་སྤྱོད་ཀྱི་ལག་ནས་སྒྲོལ་ཞིང་། གདུག་རྩུབ་ཅན་རྣམས་ཀྱི་ལག་ནས་ཐར་བར་བྱའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}