{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":16,"content":[{"type":"heading","content":["ཡ་ཝཱེས་ཡེ་རེམ་ཡཱ་ནི་ཁེར་རྐྱང་དུ་སྡོད་པར་བསྐུལ་བ།"]},{"type":"verse","number":1,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་བདག་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་གནས་འདི་རུ་ཆུང་མ་བླངས་ཏེ་བུ་དང་བུ་མོ་སྐྱེས་མི་རུང་ཞེས་གསུངས།"]},{"type":"verse","number":3,"content":["ཅི་ལ་ཞེ་ན། གནས་འདིར་བཙས་པའི་བུ་དང་བུ་མོ་རྣམས་དང་། དེ་དག་སྐྱེས་པའི་ཕ་དང་མ་རྣམས་ཀྱི་སྐོར་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ།"]},{"type":"verse","number":4,"content":["དེ་དག་སྲོག་ལ་ཐུག་པའི་ན་ཟུག་གིས་འཆི་བར་འགྱུར་ཞིང་མྱ་ངན་བྱེད་མཁན་སུ་ཡང་མེད་ལ་བསྐུང་བར་ཡང་མི་བྱ་སྟེ། དེ་རྣམས་ལུད་ལྟར་ས་རུ་ལུས་པར་འགྱུར། རལ་གྲི་དང་མུ་གེས་དེ་དག་མེད་པར་བྱེད་ཅིང་། དེ་དག་གི་བམ་རོ་ནི་ནམ་མཁའི་བྱ་དང་ས་སྟེང་གི་གཅན་གཟན་རྣམས་ཀྱི་ཁ་ཟས་སུ་འགྱུར་རོ་ཞེས་པའོ། །"]},{"type":"verse","number":5,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ཤི་བའི་ཁྱིམ་དུ་མ་འགྲོ། མྱ་ངན་མ་ཞུ། དེ་དག་གི་ཕྱིར་དུ་སེམས་སྡུག་ཀྱང་མ་བྱེད་ཅིག ཅི་ལ་ཞེ་ན། ངས་རང་གི་ཞི་བདེ་དང་བྱམས་བརྩེ། སྙིང་རྗེ་བཅས་ནི་མི་འདི་རྣམས་ལས་ཕྱིར་བླངས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་དག་མཆོག་དམན་སུ་ཡིན་ཡང་ཐམས་ཅད་ས་འདི་ནས་འཆི་བར་འགྱུར་ཏེ་དུར་ལ་འཇུག་མཁན་ཡང་མེད། མི་ཡིས་དེ་དག་གི་ཕྱིར་དུ་མྱ་ངན་མི་བྱེད། དེ་དག་གི་ཕྱིར་དུ་རང་གི་ཤ་གཅོད་པར་མི་བྱེད། དེ་དག་གི་ཕྱིར་སྐྲ་བཞར་ནས་སྤྱི་ཐེར་དུ་ཡང་མི་གཏོང་།"]},{"type":"verse","number":7,"content":["འདས་མཆོད་ཡོད་ཀྱང་མི་ཡིས་དེ་དག་གི་ཕྱིར་དུ་བག་ལེབ་མི་གཅོག་ལ། གཤིན་པོའི་ཕྱིར་དུ་དེ་དག་ལ་སེམས་གསོ་མི་བྱེད། དེ་དག་གི་ཕའམ་མ་ཚེ་ལས་འདས་ནའང་མི་ཡིས་དེ་དག་གི་ཕྱིར་དུ་ཆང་སྤྲད་ནས་སེམས་གསོ་མི་བྱེད་དོ། །"]},{"type":"verse","number":8,"content":["ཁྱོད་ནི་མི་དང་མཉམ་དུ་བཟའ་བཏུང་ལ་རོལ་བར་སྟོན་མོའི་ཁྱིམ་དུ་ཞུགས་མི་རུང་།"]},{"type":"verse","number":9,"content":["ཅི་ལ་ཞེ་ན། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ལྟོས་ཤིག ཁྱོད་རྣམས་གསོན་པའི་དུས་སུ། ངས་ཁྱོད་ཚོའི་མདུན་དུ་ཡུལ་འདིའི་དགའ་སྤྲོ་དང་དགའ་མགུ་བྱེད་པའི་སྐད། བག་གསར་དང་མག་གསར་གྱི་སྐད་ནི་མེད་པར་བྱའོ་ཞེས་གསུངས་པས་སོ། །"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་མི་འདི་དག་ལ་གཏམ་འདི་ཡོངས་སུ་སྨྲས་ནས་དེ་དག་གིས་ཁྱོད་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་བར་ཆད་ཆེན་པོས་ངེད་རྣམས་ལ་རྒོལ་བར་འགྱུར་ཞེས་གསུངས་པ་ཅི་ཡིན་ནམ། ངེད་རྣམས་ལ་ཉེས་སྐྱོན་ཅི་ཞིག་ཡོད་དམ། ངེད་ཅག་གིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྡིག་ཉེས་ཅི་ཞིག་བསགས་པ་ཡིན་ནམ་ཞེས་འདྲི་བའི་ཚེ།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱིས་དེ་དག་ལ་འདི་ལྟར་སྨྲོས་ཤིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་བདག་དོར་ཏེ་ལྷ་གཞན་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་ནས། དེ་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབས་ནས་ཕྱག་བཙལ་ཞིང་། ངའི་བཀའ་ཁྲིམས་ཀྱང་མ་བསྲུངས་པ་དང་།"]},{"type":"verse","number":12,"content":["ཡང་ཁྱོད་ཚོའི་སྤྱོད་ངན་ནི་ཁྱོད་ཚོའི་མེས་པོ་ལས་ཀྱང་ལྷག་པའི་རྐྱེན་དང་། མི་རེ་རེ་རང་རང་གི་སེམས་ངན་གཤིས་གྱོང་གི་རྗེས་སུ་འབྲངས་ནས་ཐ་ན་བདག་གི་བཀའ་ལའང་མི་མཉན་པས་ན།"]},{"type":"verse","number":13,"content":["བདག་གིས་ཁྱོད་རྣམས་ཡུལ་འདི་ནས་ཕྱི་རུ་སྐྲོད་པར་འགྱུར་ལ། ཁྱོད་ཚོ་དང་ཁྱོད་ཚོའི་མེས་པོ་དག་ལ་རྒྱུས་མི་མངའ་བའི་གནས་སུ་སྐྲོད་པར་འགྱུར། ཁྱོད་རྣམས་ཀྱིས་གནས་དེར་ཉིན་མཚན་མེད་པར་ལྷ་གཞན་རྣམས་ལ་ཞབས་ཏོག་བསྒྲུབ་ངེས་ཡིན། ཅི་ལ་ཞེ་ན། བདག་གིས་ཁྱོད་རྣམས་དྲིན་གྱིས་མི་སྐྱོང་ཞེས་པའོ་ཞེས་གསུངས།"]},{"type":"heading","content":["བཙོན་དུ་ཁྲིད་པ་རྣམས་ཕྱིར་ལོག་པར་སྔོན་བརྡ་གཏོང་བ།"]},{"type":"verse","number":14,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། མི་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཡར་འདྲེན་མཁན་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་མི་བསྐྱལ་ལོ། །"]},{"type":"verse","number":15,"content":["ཡིན་ཡང་མི་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་བྱང་ཕྱོགས་ཀྱི་ཡུལ་དང་། ཁོ་རྣམས་སྐྲོད་སའི་རྒྱལ་ཁམས་སོ་སོ་ནས་ཡར་འདྲེན་མཁན་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བར་འགྱུར་ཏེ། ཅི་ལ་ཞེ་ན། བདག་གིས་དེ་དག་ཁྲིད་ནས་ངས་སྔར་དེ་རྣམས་ཀྱི་མེས་པོ་ལ་གནང་བའི་ཡུལ་དུ་ཕྱིར་ལོག་པར་བྱེད་དོ། །"]},{"type":"verse","number":16,"content":["ལྟོས་ཤིག བདག་གིས་ཉ་པ་མང་པོ་མངགས་ནས་དེ་རྣམས་འཛིན་པར་བྱེད་ཅིང་། དེའི་རྗེས་སུ་བདག་གིས་རྔོན་པ་མང་པོ་མངགས་ནས་རི་བོ་རེ་རེ་དང་སྒང་རེ་རེ། བྲག་ཕུག་རེ་རེ་བཅས་ནས་དེ་རྣམས་བརྔོན་པར་བྱེད།"]},{"type":"verse","number":17,"content":["ཅི་ལ་ཞེ་ན། བདག་གི་མིག་གིས་དེ་དག་གི་སྤྱོད་པ་ཀུན་ལ་ལྟ་ཞིབ་བྱེད་ཅིང་། དེ་དག་གིས་ངའི་མདུན་ནས་འགེབ་མི་ནུས་ལ། དེ་དག་གི་སྡིག་པའང་ངའི་མདུན་དུ་སྦ་མི་ནུས་སོ། །"]},{"type":"verse","number":18,"content":["བདག་གིས་སྔོན་ལ་དེ་དག་གི་སྡིག་པ་དང་ཉེས་པ་རྣམས་ལ་ལྡབ་འགྱུར་གྱིས་ལན་འཇལ་བར་བྱ་སྟེ། ཅི་ལ་ཞེ་ན། དེ་རྣམས་ཀྱིས་ཞེན་ཁ་ལོག་པའི་སྐུ་འདྲའི་བམ་རོ་ཡིས་བདག་གི་ཡུལ་ཁམས་བཙོག་པར་བཟོས་པ་དང་། རྫས་མི་གཙང་བ་རྣམས་ཀྱིས་ངའི་ནོར་སྐལ་ཡིན་པའི་ཡུལ་བཀང་བར་བྱས་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":19,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ནི་ང་ཡི་སྟོབས་ཤུགས་དང་ང་ཡི་བཙན་རྫོང་། དཀའ་སྡུག་གི་དུས་སུ་ང་ཡི་སྐྱབས་བཅོལ་ས་བཅས་ཡིན་པས། མི་རིགས་ཐམས་ཅད་ས་མཐའ་ནས་ཁྱེད་ཀྱི་དྲུང་དུ་འོངས་ཏེ། ངེད་ཅག་གི་ཕ་མེས་རྣམས་ཀྱིས་རྒྱུན་འཛིན་བྱས་པ་ནི་རྫུན་དང་སྙིང་པོ་མེད་པ། ཕན་ཐོགས་ཅི་ཡང་མེད་པ་བཅས་སོ། །"]},{"type":"verse","number":20,"content":["མི་ཡིས་རང་གི་ཕྱིར་དུ་དཀོན་མཆོག་བཟོ་ནུས་སམ། དོན་དམ་དུ་དེ་དག་ནི་དཀོན་མཆོག་མིན་ཞེས་ཞུ་བར་འགྱུར།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ད་རེས་བདག་གིས་དེ་རྣམས་ལ་སྟོན་པར་བྱ་སྟེ། ཐེངས་འདིར་ངའི་ཕྱག་དང་མཐུ་སྟོབས་སྟོན་པར་བྱ། དེ་ནས་ཁོ་ཚོས་ངའི་མིང་ནི་ཡ་ཝཱེ་ཡིན་པ་རྟོགས་པར་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/15.json","previousChapterAudioLinks":{},"numberOfVerses":21}