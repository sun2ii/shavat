{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":18,"content":[{"type":"heading","content":["ཡེ་རེམ་ཡཱ་རྫ་བཟོ་ཞིག་གི་ཁྱིམ་དུ་ཕྱིན་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ལོངས་ལ་རྫ་བཟོའི་ཁྱིམ་དུ་མར་སོང་ཞིག དེ་རུ་ངས་ཁྱོད་ལ་བདག་གི་བཀའ་གནང་བར་བྱའོ་ཞེས་གསུངས་པས།"]},{"type":"verse","number":3,"content":["ང་རང་མར་རྫ་བཟོའི་ཁྱིམ་དུ་སོང་བ་ན། ལྟོས་ཤིག དེས་རང་གི་འཁོར་ལོའི་སྟེང་དུ་སྣོད་བཟོ་བཞིན་འདུག"]},{"type":"verse","number":4,"content":["འཇིམ་པས་བཟོས་པའི་སྣོད་དེར་རྫ་བཟོའི་ལག་ནས་ཆག་སྐྱོན་བྱུང་བ་ཙམ་གྱིས། ཁོས་འཇིམ་པ་དེས་སྣོད་གཞན་ཞིག་བཟོས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":6,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལགས། ངས་ཁྱོད་རྣམས་ལ་རྫ་བཟོས་འདམ་བཟོ་བ་ལྟར་བྱེད་མི་ནུས་སམ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ལགས། ལྟོས་ཤིག འཇིམ་པ་རྫ་བཟོའི་ལག་ནང་དུ་ཇི་ལྟར་ཡིན་པ་བཞིན། ཁྱོད་ཀྱང་ངའི་ལག་ནང་དེ་ལྟར་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ངས་མི་རིགས་དང་ཡང་ན་རྒྱལ་ཕྲན་གང་ཞིག་གི་སྐོར་ལ། དེ་རྩ་བ་ནས་བཏོན་ཏེ་བཤིག་ནས་མེད་པར་བཟོ་དགོས་ཞེས་དུས་ནམ་ཞིག་ལ་སྨྲས་པ་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["ཇི་སྟེ་ངས་གླེང་པའི་མི་རིགས་དེས་འགྱོད་བཤགས་བྱས་ནས་རང་གི་ངན་སྤྱོད་ལས་བྲལ་ན། ངས་ཀྱང་བློ་ཁ་བསྒྱུར་ནས་ལག་བསྟར་བྱེད་འདོད་པའི་ཆག་སྒོ་ནི་དེ་རྣམས་ཀྱི་སྟེང་དུ་འབྱུང་བར་མི་བྱའོ། །"]},{"type":"verse","number":9,"content":["ཡང་ངས་མི་རིགས་དང་ཡང་ན་རྒྱལ་ཕྲན་གང་ཞིག་གི་སྐོར་ལ། དེ་ཡར་བཙུགས་ནས་གསོ་སྐྱོང་བྱེད་དགོས་ཞེས་དུས་ནམ་ཞིག་ལ་སྨྲས་པ་ཡིན་ནམ།"]},{"type":"verse","number":10,"content":["གལ་སྲིད་ཁོ་རྣམས་ཀྱིས་ངའི་མིག་ལམ་དུ་ངན་པ་གང་ཡིན་དེ་སྤྱད་ནས་ངའི་བཀའ་ལ་མི་མཉན་ན། ངས་ཀྱང་བློ་ཁ་བསྒྱུར་ནས་ངས་སྨྲས་པའི་བྱིན་རླབས་ནི་དེ་དག་ལ་གནང་བར་མི་བྱའོ། །"]},{"type":"verse","number":11,"content":["ད་ལྟ། ཁྱོད་ཀྱིས་ཡ་ཧུ་དཱ་པ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཁྱོད་རྣམས་ལ་ཆག་སྒོ་ཐེབས་པར་རྩོམ་ཞིང་། ཁྱོད་རྣམས་ལ་ཉེས་ཆད་གཅོད་པར་སེམས་ཐག་བཅད་པ་ཡིན། ཁྱོད་རྣམས་ཁ་ཕྱིར་འཁོར་ཏེ་རང་གི་སྤྱོད་ངན་དང་འབྲལ་དགོས་ལ། རང་གི་བྱ་བ་སྤྱོད་པ་སྒྱུར་ཅིག་ཅེས་སྨྲོས་དང་།"]},{"type":"verse","number":12,"content":["དེ་དག་གིས་དེར་ཕན་ཐོགས་ཅི་ཡང་མེད་པས། ངེད་རྣམས་ཀྱིས་རང་གི་བསམ་པ་བཞིན་དུ་སོ་སོའི་སེམས་ངན་གཤིས་གྱོང་གི་རྗེས་སུ་འབྲངས་ནས་སྤྱད་པ་སྤྱོད་དགོས་ཞེས་སྨྲ་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":13,"content":["དེའི་ཕྱིར་ན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་སོང་ནས་ཡུལ་ཁམས་ཀུན་ལ་དྲིས་ཤིག འདི་འདྲའི་དོན་རྣམས་ཐོས་མྱོང་ངམ། ན་ཆུང་བུ་མོ་ཡེས་ར་ཨེལ་གྱིས་དོན་ཤིན་ཏུ་མི་རུང་བ་ཞིག་བྱས་སོ། །"]},{"type":"verse","number":14,"content":["ལེ་པཱ་ནོན་གྱི་བྲག་རི་སྟེང་གི་གངས་ནི་ཞི་བར་འགྱུར་རམ། རྒྱང་རིང་ནས་བཞུར་འོང་བའི་དྭངས་ཤིང་བསིལ་བའི་ཆུ་དེ་སྐམ་པར་འགྱུར་རམ།"]},{"type":"verse","number":15,"content":["ཡིན་ཡང་ངའི་འབངས་རྣམས་ཀྱིས་ང་རང་བརྗེད་ནས་རིན་ཐང་མེད་པའི་སྐུ་འདྲ་རྣམས་ལ་སྤོས་བདུགས་ཤིང་། ཁོ་རྣམས་འགྲུལ་བའི་ལམ་ནང་དང་གནའ་བོའི་ལམ་བུར་འགྱེལ་ཞིང་། ལམ་ཆེན་ནང་དུ་མི་འགྲུལ་བར་ལམ་ཕྲན་ནང་དུ་བསྐྱོད་དོ། །"]},{"type":"verse","number":16,"content":["དེ་དག་གི་ཡུལ་ཁམས་ནི་མི་མེད་ལུང་སྟོང་དང་ནམ་རྒྱུན་མི་ཡིས་འཕྱ་སྨོད་བྱེད་ཡུལ་དུ་འགྱུར་བ་དང་། ཡུལ་དེ་བརྒྱུད་ནས་འགྲོ་མཁན་ཐམས་ཅད་དངངས་ནས་མགོ་གཡུག་པར་འགྱུར་རོ། །"]},{"type":"verse","number":17,"content":["ཤར་རླུང་གིས་བསྐྱོད་པ་བཞིན་ངས་དེ་དག་དགྲ་བོའི་མདུན་དུ་གཏོར་ཞིང་། ཆག་སྒོ་འབྱུང་དུས་ངས་དེ་དག་ལ་རྒྱབ་གཏོད་པ་ལས་གདོང་སྟོན་པར་མི་བྱའོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ལ་གནོད་བསྐྱལ་བ།"]},{"type":"verse","number":18,"content":["དེར་ཁོ་རྣམས་ན་རེ། མཆོད་དཔོན་ལས་བཀའ་ཁྲིམས་དང་། མཁས་པ་ལས་བློ་གྲོས། ལུང་སྟོན་པ་ལས་ལུང་བསྟན་བཅས་རྒྱུན་མི་ཆད་པས། ཤོག་དང་། ཡེ་རེམ་ཡཱ་ལ་གནོད་བསྐྱལ་བར་གྲོས་བྱེད་དོ། །ཤོག་དང་། རང་ཅག་གི་ལྕེ་ཡིས་ཁོ་ལ་རྒོལ་ཞིང་ཁོའི་ཚིག་གང་ལའང་མ་མཉན་ཞིག་ཅེས་སྨྲས།"]},{"type":"verse","number":19,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ང་ལ་གསན་ཞིང་ང་ལ་སྐྱོན་བརྗོད་པའི་མི་དེ་དག་གི་གཏམ་ལའང་གསན་པར་མཛོད།"]},{"type":"verse","number":20,"content":["མི་ཡིས་བཟང་ལན་ངན་འཇལ་བྱེད་འོས་སམ། དེ་དག་གིས་དོང་ཞིག་བརྐོས་ནས་ངའི་སྲོག་ལ་གནོད་བསྐྱལ་འདོད་དེ། ཁྱེད་ཀྱི་ཐུགས་ཁྲོ་དེ་དག་དང་འབྲལ་བའི་ཕྱིར་ང་ཁྱེད་ཀྱི་དྲུང་དུ་ལངས་ནས་དེ་དག་གི་ཆེད་དུ་ཞུ་བ་ཞུས་པ་ཁྱེད་ཀྱི་ཐུགས་སུ་དྲན་པར་མཛོད།"]},{"type":"verse","number":21,"content":["དེའི་ཕྱིར་དེ་དག་གི་བུ་ཕྲུག་རྣམས་ལ་མུ་གེ་འབྱུང་ཞིང་རལ་གྲིའི་དབང་ལ་གཏོད་པར་མཛོད་ཅིག དེ་དག་གི་ཆུང་མ་རྣམས་ལ་ཕྲུ་གུ་མི་སྐྱེས་པར་ཡུགས་མོ་རུ་འགྱུར་བར་མཛོད་ཅིག དེ་དག་གི་ཁྱོ་ག་རྣམས་ནི་འཆི་བས་གསོད་ཅིང་། དེ་དག་གི་གཞོན་ནུ་རྣམས་གཡུལ་ངོར་རལ་གྲིས་འགུམ་པར་མཛོད་ཅིག"]},{"type":"verse","number":22,"content":["ཁྱེད་ཀྱིས་དེ་དག་གི་སྟེང་དུ་གློ་བུར་ཉིད་ལ་ཆོམ་རྐུན་འདྲེན་པའི་དུས་སུ། དེ་དག་གི་ཁྱིམ་ནས་སྐྱབས་ཞུ་བའི་སྐད་ཐོས་འོང་བར་གྱུར་ཅིག ཅི་ལ་ཞེ་ན། དེ་དག་གིས་དོང་བརྐོས་ནས་ང་རང་འཛིན་འདོད་པ་དང་། ང་རྐང་འདྲེད་འཆོར་བའི་ཕྱིར་ལྐོག་ནས་རྙི་བཙུགས་སོ། །"]},{"type":"verse","number":23,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། དེ་ཚོས་ང་གསོད་པར་འདོད་པའི་གྲོས་ངན་དེ་ཐམས་ཅད་ཁྱེད་ཀྱིས་མཁྱེན་པས། ཁྱེད་ཀྱིས་དེ་དག་གི་སྡིག་པ་བསལ་བར་མ་མཛད་ཅིག ཁྱེད་ཀྱི་གཟིགས་ངོར་དེ་དག་གི་སྡིག་ཉེས་མེད་པར་ཡང་མི་མཛད་རོགས། ཁྱེད་ཀྱི་དྲུང་དུ་དེ་དག་འགྱེལ་ཞིང་། ཁྱེད་ཐུགས་ཁྲོ་བའི་ཚེ་ན་དེ་དག་ལ་འདི་ལྟར་མཛད་དུ་གསོལ་ལོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}