{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":21,"content":[{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་ནུབ་པར་ལུང་བསྟན་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་ཞིང་། དུས་དེར་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ཡིས་མལ་ཀི་ཡཱ་ཞེས་བྱ་བའི་བུ་ཕཱ་ཤུར་དང་། མ་ཨ་སེ་ཡཱའི་བུ་སྟེ་མཆོད་དཔོན་ཟེ་ཕན་ཡཱ་གཉིས་ཀ་ཁོང་གི་རྩར་མངགས་ནས་ན་རེ།"]},{"type":"verse","number":2,"content":["ཁྱེད་ཀྱིས་ངེད་རྣམས་ཀྱི་ཆེད་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞུ་བར་མཛོད། ཅི་ལ་ཞེ་ན། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ངེད་རྣམས་ལ་རྒོལ་དུ་འོངས་པའོ། །དཀོན་མཆོག་ཡ་ཝཱེས་མཛད་པ་ངོ་མཚར་ཅན་གྱིས་ངེད་རྣམས་ལ་རོགས་རམ་གནང་ནས། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནི་ངེད་དང་འབྲལ་བར་མཛད་ཀྱང་སྲིད་ཅེས་ཞུས་པ་ན།"]},{"type":"verse","number":3,"content":["ཡེ་རེམ་ཡཱ་ཡིས་དེ་དག་ལ་འདི་ལྟར། ཁྱོད་རྣམས་ཀྱིས་ཚིད་ཀི་ཡཱ་ལ་འདི་སྐད་ཤོད་ཅིག"]},{"type":"verse","number":4,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཁྱོད་རྣམས་ཀྱི་ལག་གི་མཚོན་ཆ་སྟེ། ཁྱོད་ཚོས་ལྕགས་རིའི་ཕྱི་རོལ་ནས་ཁྱོད་རྣམས་བསྐོར་བའི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་དང་ཀལ་དི་པ་རྣམས་དང་འཐབ་བྱེད་མཚོན་ཆ་རྣམས་ཕྱིར་བསྐོར་ནས་གྲོང་ཁྱེར་འདིའི་དཀྱིལ་དུ་བསྡུ་བར་བྱའོ། །"]},{"type":"verse","number":5,"content":["ངས་ཁོང་ཁྲོ་དང་ཁྲོ་གཏུམ་ཆེན་པོ། ཞེ་སྡང་བཅས་ཀྱི་ནང་དུ་ཕྱི་རུ་བརྐྱངས་པའི་ལག་པ་དང་ནུས་མཐུ་ལྡན་པའི་དཔུང་ངར་གྱིས་ཁྱོད་རྣམས་ལ་རྒོལ་ངེས་ཡིན།"]},{"type":"verse","number":6,"content":["ཡང་ངས་གྲོང་ཁྱེར་འདི་རུ་གནས་པའི་མི་ཕྱུགས་གཉིས་ལ་བརྡུངས་ནས་དེ་ཐམས་ཅད་ལ་རིམས་ནད་དྲག་པོ་བྱུང་ནས་འཆི་བར་འགྱུར་རོ། །"]},{"type":"verse","number":7,"content":["དེའི་རྗེས་སུ། ངས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་དང་དེའི་འཁོར་གཡོག་དང་མི་རྣམས་ཏེ། གྲོང་ཁྱེར་འདིའི་ནང་དུ་རིམས་ནད་དང་རལ་གྲིའི་ཆག་སྒོ་དང་། མུ་གེ་བཅས་ལས་ལུས་པའི་མི་རྣམས་ནི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་དང་ཁོ་ཚོའི་དགྲ་རྣམས་དང་། ཁོ་ཚོའི་སྲོག་ལ་སྙེག་མཁན་བཅས་ཀྱི་ལག་ཏུ་གཏད་དེ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་དེ་རྣམས་གཅེས་སུ་མི་འཛིན་ཞིང་། ཤ་ཚ་བར་མི་བྱེད་ལ། སྙིང་རྗེ་ཡང་མི་བྱེད་པར་རལ་གྲིས་དེ་རྣམས་གསོད་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":8,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རེམ་ཡཱ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་མི་འདི་རྣམས་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཤི་གསོན་གཉིས་ཀྱི་ལམ་ནི་ཁྱོད་ཅག་གི་མདུན་དུ་བཤམ་པར་བྱ་སྟེ།"]},{"type":"verse","number":9,"content":["གྲོང་ཁྱེར་འདི་རུ་སྡོད་པ་རྣམས་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ཀྱི་རྐྱེན་གྱིས་འཆི་བར་འགྱུར་མོད། འོན་ཀྱང་ཕྱི་རོལ་ཏུ་སོང་ནས་ཁྱོད་ཅག་བསྐོར་བའི་ཀལ་དི་པ་ལ་མགོ་སྒུར་མཁན་ནི་གསོན་པོར་ལུས་ཤིང་སྲོག་ཐར་བར་འགྱུར་རོ། །"]},{"type":"verse","number":10,"content":["ངས་གྲོང་ཁྱེར་འདི་ལ་ཆག་སྒོ་འབྱུང་བར་མཛད་པ་ལས་བྱིན་རླབས་མི་གནང་བའི་སེམས་ཐག་བཅད་པ་དང་། གྲོང་ཁྱེར་འདི་ནི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་ཅིང་། དེས་མེ་ཡིས་བསྲེག་པར་འགྱུར་གསུངས་ཞེས་ཤོད་ཅིག་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱའི་རྒྱལ་རྒྱུད་དག་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱིས་ཡ་ཧུ་དཱའི་རྒྱལ་རྒྱུད་ལ་འདི་ལྟར་ཤོད་ཅིག ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":12,"content":["དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་ལགས། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ང་རང་ཁྱོད་ཅག་གི་སྤྱོད་པ་ངན་པའི་རྐྱེན་གྱིས་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་ཏེ། མེ་བཞིན་འབར་ནས་སུས་ཀྱང་གསོད་མི་ནུས་པ་ཞིག་མི་འབྱུང་བའི་ཆེད་དུ། ཁྱོད་རྣམས་ཀྱིས་ཞོགས་པ་རེ་རེར་དྲང་བདེན་སྤྱོད་ཅིག ཕྲོགས་ནས་ཁྱེར་བ་དག་བརྙས་བཅོས་བྱེད་མཁན་གྱི་ལག་ནས་སྒྲོལ་ཞིག"]},{"type":"verse","number":13,"content":["སུས་རང་ཅག་ལ་རྒོལ་ཡོང་། སུ་རང་ཅག་གི་གནས་ཚང་དུ་འཇུག་པར་འགྱུར་ཞེས་སྨྲ་བའི་རི་ཁུག་དང་ཐང་གི་བྲག་ལ་གནས་པའི་ཡུལ་མི་རྣམས། ལྟོས་ཤིག ང་ནི་ཁྱོད་རྣམས་ཀྱི་དགྲ་རུ་ལང་ངོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":14,"content":["ཡང་ཁྱོད་ཅག་གིས་སྤྱད་པའི་ལས་འབྲས་བཞིན་དུ་ངས་ཆད་པ་གཅོད་དེ། ངས་ཡེ་རུ་སཱ་ལེམ་གྱི་ནགས་ཚལ་ལ་མེ་སྦར་ནས་ཁྱོད་ཀྱི་མཐའ་འཁོར་གྱི་ཡོད་ཚད་ཁྱུར་མིད་གཏོང་ངོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}