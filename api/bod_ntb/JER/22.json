{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":22,"content":[{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ཡིས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ལ་ཐ་ཚིག་སྒྲོག་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཡ་ཧུ་དཱའི་རྒྱལ་པོའི་ཕོ་བྲང་དུ་མར་སོང་ནས་འདི་སྐད་ཤོད་ཅིག"]},{"type":"verse","number":2,"content":["ཀྱེ་དཱ་བིད་ཀྱི་ཁྲི་ལ་བཞུགས་པའི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ལགས། ཁྱེད་དང་ཁྱེད་ཀྱི་འཁོར་གཡོག་རྣམས་དང་མཁར་སྒོ་འདིའི་ནང་དུ་ཞུགས་པའི་མི་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་རྣམས་ཀྱིས་དྲང་གཞག་དང་དྲང་བདེན་སྤྱོད་ཅིག ཕྲོགས་ནས་ཁྱེར་བ་དག་གཉའ་གནོན་གཏོང་མཁན་གྱི་ལག་ནས་སྒྲོལ་ཞིག བྱེས་སུ་སྡོད་པའི་མི་དང་དྭ་ཕྲུག་དང་ཡུགས་མོ་བཅས་ལ་མནར་གཅོད་གཏོང་བའམ་ཡང་ན་གདུག་རྩུབ་མ་སྤྱོད་ཅིག ཡང་གནས་འདི་རུ་ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་མི་རུང་།"]},{"type":"verse","number":4,"content":["ཇི་སྟེ་ཁྱོད་རྣམས་ཀྱིས་དངོས་གནས་འདི་བཞིན་སྤྱད་ན། དེ་ནས་དཱ་བིད་ཀྱི་རྒྱལ་ཁྲིར་བཞུགས་པའི་རྒྱལ་པོ་ནི་ཤིང་རྟ་དང་ཆིབས་པར་བཅིབས་ནས། རང་གི་འཁོར་གཡོག་དང་མི་རྣམས་མཉམ་དུ་ཕོ་བྲང་འདིའི་སྒོ་རྣམས་ལས་ནང་དུ་འཇུག་པར་འགྱུར།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་ཇི་སྟེ་ཁྱོད་རྣམས་ཀྱིས་ཚིག་འདི་ལ་མ་མཉན་ན། ཕོ་བྲང་འདི་ཁང་སྟོང་དུ་འགྱུར་བར་ངས་རང་ཉིད་དཔང་དུ་བཙུགས་ནས་མནའ་སྐྱེལ་ལོ་ཞེས་པའོ་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":6,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོའི་ཕོ་བྲང་གི་སྐོར་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ང་ལ་མཚོན་ན་ཁྱོད་ནི་གིལ་ཨད་དང་ལེ་པཱ་ནོན་གྱི་རི་རྩེ་ལྟ་བུ་ཡིན་ནའང་། ངས་ཁྱོད་ནི་དབེན་སྟོང་དང་སྡོད་མཁན་མེད་པའི་གྲོང་ཁྱེར་དང་འདྲ་བར་བྱའོ། །"]},{"type":"verse","number":7,"content":["ངས་བཤིག་མཁན་མངགས་པར་བྱེད་དེ། རེ་རེས་མཚོན་ཆ་ཐོགས་ནས་ཁྱོད་ལ་རྒོལ་ཞིང་། དེ་ཚོས་ཁྱོད་ཀྱི་ཐང་ཤིང་ཡག་ཤོས་རྣམས་བཅད་དེ་མེ་རུ་གཡུག་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["རྒྱལ་ཁམས་མང་པོའི་མི་རྣམས་གྲོང་ཁྱེར་འདི་བརྒྱུད་ནས་འགྲོ་ཞིང་ཕན་ཚུན་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཅིའི་ཕྱིར་གྲོང་ཁྱེར་ཆེན་པོ་འདི་ལ་འདི་ལྟར་མཛད་པ་ཡིན་ནམ་ཞེས་འདྲི་བ་དང་།"]},{"type":"verse","number":9,"content":["ཡང་དེ་རྣམས་ཀྱིས་འདི་ལྟར། དེ་དག་གིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་དོར་ནས། ལྷ་གཞན་རྣམས་ལ་ཕྱག་བཙལ་ནས་ཞབས་ཏོག་བསྒྲུབས་པས་ཡིན་ཞེས་ལན་འདེབས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":10,"content":["གཤིན་པོའི་དོན་དུ་མ་ངུ་ཞིག དེའི་དོན་དུ་སེམས་མ་སྐྱོ་ཞིག འོན་ཀྱང་རང་ཡུལ་དང་བྲལ་བའི་མི་རྣམས་ཀྱི་ཕྱིར་དྲག་ཏུ་ངུས་ཤིག ཅི་ལ་ཞེ་ན། དེ་ཕྱིར་མི་ལོག་ལ་རང་གི་ཕ་ཡུལ་མཐོང་ཡང་མི་ནུས་སོ། །"]},{"type":"verse","number":11,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་ཡི་བུ་སྟེ། རང་གི་ཕ་ཡོ་ཤི་ཡཱ་ཡི་རྒྱུན་མཐུད་ནས་རྒྱལ་སྲིད་བསྐྱངས་པའི་རྒྱལ་པོ་ཤལ་ལུམ་གྱི་སྐོར་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁོ་ནི་ཡུལ་འདི་དང་བྲལ་ནས་ཕྱིར་འདི་རུ་མི་འོང་སྟེ།"]},{"type":"verse","number":12,"content":["བཙོན་དུ་བཟུང་ནས་ཁྱེར་བའི་གནས་སུ་འཆི་དགོས་ལ། ཡུལ་འདི་སླར་མཐོང་བར་མི་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་སྐོར་གླེང་བ།"]},{"type":"verse","number":13,"content":["དྲང་བདེན་མིན་པའི་སྒོ་ནས་རང་གི་ཁང་པ་བཟོས་ཤིང་། མི་དྲང་པོའི་ཚུལ་གྱིས་རང་གི་ཐོག་ཁང་རྣམས་རྩིག་མཁན་ལ་ཆག་སྒོ་འབྱུང་། དེས་རང་གི་ཁྱིམ་མཚེས་ལ་དོན་མེད་དུ་ངལ་རྩོལ་བྱེད་དུ་འཇུག་ཅིང་དེ་རྣམས་ལ་གླ་མི་སྦྱིན་ནོ། །"]},{"type":"verse","number":14,"content":["ཁོ་ན་རེ། ངས་རང་ལ་ཁང་ཆེན་ཞིག་དང་ཐོག་ཁང་མཐོན་པོ་ཞིག་བརྩིག་པར་བྱའོ་ཟེར་ཞིང་། དེར་དཀར་ཁུང་ཡངས་ཤིང་རྒྱ་ཆེ་བ་རྣམས་ཕྱེས་ཏེ། རྩིག་ངོས་ཐང་ཤིང་གིས་བཏུམས་ནས་མཚལ་མདོག་གི་ཚོན་བྱུགས།"]},{"type":"verse","number":15,"content":["ཁྱོད་ཀྱིས་ཐང་ཤིང་གིས་ཐོག་ཁང་བརྩིགས་ནས་རྒྱལ་ཁ་ལོན་ཐབས་བྱས་ཏེ་རང་ཉིད་རྒྱལ་པོ་ཡིན་པ་ངོམ་མམ། ཁྱོད་ཀྱི་ཕ་ཡིས་ཀྱང་བཟའ་བཏུང་སྤྱད་ནས་དྲང་གཞག་དང་དྲང་བདེན་སྤྱད་པ་མ་ཡིན་ནམ། དུས་དེར་ཁོ་ལ་བདེ་སྐྱིད་ཐོབ་པར་གྱུར།"]},{"type":"verse","number":16,"content":["དེས་དཀའ་ངལ་ཅན་དང་དབུལ་པོ་རྣམས་ལ་དཀར་འདོན་བྱས་པས། ཁོ་ལ་བདེ་སྐྱིད་ཐོབ་པར་གྱུར་ཏེ། འདི་ནི་བདག་ངོ་ཤེས་པའི་དོན་སྙིང་མ་ཡིན་ནམ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱི་མིག་དང་སེམས་ནི་མི་འོས་པའི་ཐོབ་ནོར་འབའ་ཞིག་ལ་ཆགས་ཤིང་། མི་ཉེས་མེད་ཀྱི་ཁྲག་བཞུར་དུ་བཅུག་སྟེ། བརྙས་བཅོས་དང་གདུག་རྩུབ་སྤྱད་པས།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤི་ཡཱའི་བུ་སྟེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་སྐོར་ལ་འདི་སྐད་དུ། མི་ཡིས་དེའི་དོན་དུ་ཀྱི་ཧུད་ངའི་གཅེན་པོ། ཀྱི་ཧུད་ངའི་གཅེན་མོ་ཟེར་བཞིན་མྱ་ངན་མི་བྱེད་ལ། ཀྱི་ཧུད་ངའི་ཇོ་བོ། ཀྱི་ཧུད་ངའི་རྒྱལ་པོ་བརྗིད་ཉམས་ཅན་ཟེར་བཞིན་མྱ་ངན་མི་བྱེད་དོ། །"]},{"type":"verse","number":19,"content":["བོང་བུ་ཞིག་སྐུང་བ་བཞིན་དུ་དེ་བསྐུང་བར་འགྱུར་ལ། ཡེ་རུ་སཱ་ལེམ་གྱི་མཁར་སྒོའི་ཕྱི་རོལ་ཏུ་དྲུད་ནས་གཡུག་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":20,"content":["ཀྱེ་ཡེ་རུ་སཱ་ལེམ། ཁྱོད་ཀྱི་མནའ་བཅད་ཐམས་ཅད་མེད་པར་བཟོས་པས། ཁྱོད་རང་ཡར་ལེ་པཱ་ནོན་དུ་སོང་ལ་འོ་དོད་བོས་ཤིག པཱ་ཤན་དུ་སྒྲ་སྒྲོགས་ཤིག ཨ་བཱ་རིམ་ནས་འོ་དོད་བོས་ཤིག"]},{"type":"verse","number":21,"content":["ཁྱོད་རང་དར་བའི་དུས་སུ་བདག་གིས་ཁྱོད་ལ་སྨྲས་ཀྱང་ཁྱོད་ཀྱིས་ངས་མི་མཉན་ཞེས་སྨྲས། ཁྱོད་ནི་གཞོན་པའི་དུས་ནས་འདི་བཞིན་ཡིན་ཏེ་ངའི་བཀའ་ལ་མ་མཉན་ཏོ། །"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱི་རྫི་བོ་ཐམས་ཅད་དྲག་རླུང་གིས་འཁུར་ཞིང་ཁྱོད་ཀྱི་མནའ་བཅད་རྣམས་བཙོན་དུ་འཁྲིད་པར་འགྱུར་བས། དུས་དེར་ཁྱོད་ནི་རང་གི་སྤྱོད་ངན་གྱི་དབང་གིས་ནོངས་ཤིང་ངོ་ཚ་བར་འགྱུར།"]},{"type":"verse","number":23,"content":["ལེ་པཱ་ནོན་དུ་སྡོད་པ་དང་ཐང་ཤིང་གི་དཀྱིལ་དུ་ཚང་བཅའ་མཁན་ཁྱོད་ལ། སྡུག་བསྔལ་བྱུང་ནས་ཕྲུ་གུ་བཙའ་བའི་བུད་མེད་ལ་ཟུག་གཟེར་རྒྱག་པ་ལྟ་བུའི་དུས་དེར་ཁྱོད་ཀྱིས་ཅི་འདྲའི་འཁུན་སྒྲ་འབྱིན་ནམ།"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གིས་རང་གི་ཚེ་སྲོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་བ་སྟེ། ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་བུ་སྟེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཀོན་ཡཱ་ནི་ངའི་གཡས་ལག་གི་མཛུབ་དཀྲིས་དམ་ཕྲུག་ཅན་",{"noteId":7},"ཡིན་ནའང་། ངས་ཁྱོད་ངའི་མཛུབ་མོ་ནས་མར་བླངས་ཏེ།"]},{"type":"verse","number":25,"content":["ཁྱོད་ཀྱི་སྲོག་སྙེག་མཁན་དང་ཁྱོད་རང་འཇིགས་པའི་མི་སྟེ། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་དང་ཀལ་དི་པའི་ལག་ཏུ་གཏོད་པར་བྱའོ། །"]},{"type":"verse","number":26,"content":["ཡང་ངས་ཁྱོད་རང་ཁྱོད་སྐྱེས་པའི་མ་དང་བཅས་ཁྱོད་ཅག་གི་སྐྱེ་ཡུལ་མིན་པའི་ཡུལ་དུ་སྐྲོད་པར་བྱ་ཞིང་། ཁྱོད་རྣམས་དེ་རུ་མ་སྐྱེས་ཀྱང་དེ་རུ་འཆི་བར་འགྱུར་ལ།"]},{"type":"verse","number":27,"content":["ཁྱོད་རྣམས་སེམས་ནས་ཕྱིར་རང་ཡུལ་དུ་ལོག་འདོད་ཀྱང་ནམ་ཡང་ཕྱིར་ལོག་པར་མི་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":28,"content":["ཀོན་ཡཱ་བྱ་བའི་མི་འདི་ནི་མི་ཡིས་མཐོང་ཆུང་བྱེད་པ་དང་དུམ་བུར་བཅག་པའི་རྫ་སྣོད་དམ། སུས་ཀྱང་མི་འདོད་པའི་སྣོད་ཡིན་ནམ། དེ་དང་དེའི་བུ་རྒྱུད་དག་ནི་ཅིའི་ཕྱིར་ཆ་རྒྱུས་མེད་པའི་ཡུལ་དུ་བསྐྲད་པ་ཡིན་ནམ།"]},{"type":"verse","number":29,"content":["ཀྱེ་ས་གཞི། ཀྱེ་ས་གཞི། ཀྱེ་ས་གཞི། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":30,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དེང་ཕྱིན་དཱ་བིད་ཀྱི་རྒྱལ་ཁྲིར་བཞུགས་ཏེ་ཡ་ཧུ་དཱ་ལ་སྲིད་བྱེད་དུ་མི་དེའི་བུ་རྒྱུད་ལས་གཅིག་ཀྱང་མི་འབྱུང་བས་ན། འདི་ལ་བུ་མེད་པའི་མི་དང་མི་ཚེ་གང་པོར་དོན་གང་ཡང་མི་འགྲུབ་པའི་མི་ཞེས་ཡི་གེར་ཁོད་ཅིག་ཅེས་གསུངས་སོ། །"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འདིར་མཛུབ་དཀྲིས་དམ་ཕྲུག་ཅན་ཞེས་པ་ནི་མི་སྒེར་གྱི་རྟགས་ཁྱད་པར་ཅན་བརྐོས་ཡོད་པའི་མཛུབ་དཀྲིས་ཡིན་ལ། མཛུབ་དཀྲིས་འདི་རིགས་ཀྱིས་འཇིམ་པ་དང་ཡང་ན་སྤྲ་ཚིལ་སྟེང་དམ་ཕྲུག་ཕབ་ནས་ཕྱག་རྒྱ་འདེབས་མཁན་གྱི་ཐོབ་ཐང་མཚོན་པ་ཡིན།","reference":{"chapter":22,"verse":24}}]},"thisChapterLink":"/api/bod_ntb/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}