{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":27,"content":[{"type":"heading","content":["ཡེ་རེམ་ཡཱ་འཆིང་རྒྱར་ཚུད་པ།"]},{"type":"verse","number":1,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡོ་ཤི་ཡཱའི་བུ་ཡེ་ཧོ་ཡཱ་ཀིམ་རྒྱལ་ཁྲིར་འཁོད་དུས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་རང་ཉིད་ལ་ཀོ་བའི་ཐག་པ་དང་གཉའ་ཤིང་བཟོས་ཏེ་རང་གི་སྐེ་ལ་སྐོན་ཅིག"]},{"type":"verse","number":3,"content":["དེ་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱའི་དྲུང་དུ་འོངས་པའི་བང་ཆེན་དག་གི་ལག་ཏུ་ཀོ་བའི་ཐག་པ་དང་གཉའ་ཤིང་ནི། ཨེ་དོམ་གྱི་རྒྱལ་པོ་དང་། མོ་ཨབ་ཀྱི་རྒྱལ་པོ། ཨམ་མོན་གྱི་རྒྱལ་པོ། ཐཱར་གྱི་རྒྱལ་པོ། ཚི་ཏུན་གྱི་རྒྱལ་པོ་བཅས་ལྔ་པོར་རྫོངས་ཤིག"]},{"type":"verse","number":4,"content":["ཡང་དེ་དག་གི་ཇོ་བོ་རྣམས་ལ་བརྡ་སྤྲོད་པར་འདི་ལྟར་བཅོལ་གདམས་བྱོས་ཤིག དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ཁྱོད་ཅག་གིས་རང་གི་ཇོ་བོ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག"]},{"type":"verse","number":5,"content":["ངས་ནུས་མཐུ་ཆེན་པོ་དང་ཕྱི་རུ་བརྐྱངས་པའི་དཔུང་ངར་གྱིས་ས་གཞི་དང་ས་ལ་ཡོད་པའི་མི་དང་གཅན་གཟན་རྣམས་བཀོད་པ་དང་། ངས་སུ་ལ་སྦྱིན་འོས་འདོད་ན་ས་གཞི་དེ་ལ་སྦྱིན་ནོ། །"]},{"type":"verse","number":6,"content":["ད་ལྟ་ངས་ཡུལ་ཁམས་མཐའ་དག་ངའི་འཁོར་གཡོག་སྟེ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་ལག་ཏུ་གཏད་ཅིང་། ཐང་རྒོད་ཀྱི་རི་དྭགས་རྣམས་ཀྱང་དེ་ལ་སྤྱད་དུ་གནང་ངོ་། །"]},{"type":"verse","number":7,"content":["དེའི་ཡུལ་ཁམས་ལ་འཁོན་ལན་ཕོག་པའི་དུས་མ་སླེབས་བར་དུ། མི་རིགས་ཀུན་གྱིས་དེ་དང་དེའི་བུ་རབས་ཚ་རྒྱུད་རྣམས་ལ་གཡོག་བྱེད་དགོས་པ་དང་། དུས་དེར། རྒྱལ་ཁམས་མང་པོ་དང་རྒྱལ་པོ་ཆེན་པོ་རྣམས་ཀྱིས་དེ་བྲན་གཡོག་ཏུ་བྱེད་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["དེ་ནས་མི་རིགས་དང་རྒྱལ་ཕྲན་གང་ཡིན་ཡང་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་འདི་ལ་གཡོག་མི་བྱེད་ཅིང་། རང་གི་མཇིང་པ་དེའི་གཉའ་ཤིང་འོག་ཏུ་མི་འཇོག་ན། ངས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་ལག་པ་བརྒྱུད་ནས་དེ་དག་རྩ་མེད་གཏོང་བའི་བར་དུ། རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ཀྱིས་ངས་མི་རིགས་དེ་ལ་ཉེས་ཆད་གཅོད་ངེས་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":9,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་རང་གི་ལུང་སྟོན་པ་དང་མོ་པ། རྨི་ལམ་ལ་བརྟག་མཁན། ལྷ་པ། སྒྱུ་མ་མཁན་བཅས་ལ་མ་མཉན་ཅིག དེ་དག་གིས་ཁྱོད་རྣམས་ལ། ཁྱོད་ཅག་གིས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་གཡོག་བྱེད་པར་མི་འགྱུར་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":10,"content":["དེ་ཚོས་ཁྱོད་ཅག་ལ་རྫུན་གྱི་ལུང་བསྟན་ཏེ། ཁྱོད་ཅག་རང་ཡུལ་དང་བྲལ་ནས་རྒྱང་ཐག་རིང་པོར་འགྲོ་ཞིང་། ངས་ཁྱོད་ཅག་ཕྱིར་བསྐྲད་ནས་ཁྱོད་རྣམས་འཆི་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་མི་རིགས་གང་ཞིག་གིས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་གཉའ་ཤིང་འོག་ཏུ་རང་གི་མཇིང་པ་བཞག་ནས་དེ་ལ་གཡོག་བྱས་ན། ངས་མི་རིགས་དེ་ནི་རང་ཡུལ་དུ་ལུས་པར་བྱེད་ཅིང་། དེར་ཞིང་རྨོས་ཏེ་གནས་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":12,"content":["ངས་བཀའ་འདི་རྣམས་བཞིན་དུ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ལ་བསྐུལ་ནས་འདི་ལྟར། ཁྱེད་ཚོས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་གཉའ་ཤིང་འོག་ཏུ་མཇིང་པ་བཞག་ནས། དེ་དང་དེའི་འབངས་མི་ལ་གཡོག་བྱས་ན་གསོན་པོར་ལུས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་གཡོག་མི་བྱེད་པའི་མི་རིགས་ཀྱི་སྐོར་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཇི་སྐད་གསུངས་པ་བཞིན། ཁྱེད་དང་ཁྱེད་ཀྱི་མི་རིགས་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ཀྱིས་འཆི་བར་བྱེད་དོན་ཅི་ཡོད་དམ།"]},{"type":"verse","number":14,"content":["ཁྱེད་རྣམས་ཀྱིས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོར་གཡོག་བྱེད་པར་མི་འགྱུར་ཞེས་སྨྲ་མཁན་ལུང་སྟོན་པ་དག་གིས་ཁྱོད་ཅག་ལ་སྨྲས་པའི་གཏམ་ལ་མ་མཉན་ཅིག དེ་དག་གིས་ཁྱེད་ལ་ལུང་རྫུན་མ་བསྟན་ཏོ། །"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ངས་དེ་རྣམས་མངགས་པ་མིན་ཡང་། དེ་དག་གིས་ངའི་མིང་གཡར་ནས་ལུང་རྫུན་མ་བསྟན་ཏེ། ངས་ཁྱོད་རྣམས་དང་ཁྱོད་ཅག་ལ་ལུང་བསྟན་སྨྲ་བའི་ལུང་སྟོན་པ་དེ་དག་ཕྱིར་བསྐྲད་དེ། མཉམ་དུ་རྩ་མེད་གཏོང་ངོ་ཞེས་གསུངས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":16,"content":["ངས་ཡང་མཆོད་དཔོན་རྣམས་དང་མི་འདི་དག་ཐམས་ཅད་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་གི་ལུང་སྟོན་པས་ཁྱོད་རྣམས་ལ་ལུང་བསྟན་ཏེ་ན་རེ། ལྟོས་ཤིག དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་ཡོ་བྱད་རྣམས་པཱ་པེལ་ལོན་ནས་འདིར་འདྲེན་ལ་ཉེ་ཞེས་ཟེར་ཞིང་། དེ་དག་གིས་ཁྱོད་ལ་སྨྲས་པ་ནི་ལུང་བསྟན་རྫུན་མ་ཡིན་པས་དེར་མ་མཉན་ཅིག"]},{"type":"verse","number":17,"content":["དེ་དག་ལ་མི་མཉན་པར་པཱ་པེལ་ལོན་རྒྱལ་པོའི་གཡོག་བྱས་ན་གསོན་པོར་ལུས་ཏེ། གྲོང་ཁྱེར་འདི་ཞིག་རོར་འགྱུར་དུ་འཇུག་དོན་ཅི་ཡོད་དམ།"]},{"type":"verse","number":18,"content":["གལ་ཏེ་ཁོ་རྣམས་ལུང་སྟོན་པ་ངོ་མ་ཡིན་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཁོ་རྣམས་ལ་བྱུང་བ་ཡིན་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོའི་ཕོ་བྲང་། ཡེ་རུ་སཱ་ལེམ་བཅས་སུ་ལུས་པའི་ཡོ་བྱད་རྣམས་པཱ་པེལ་ལོན་དུ་མི་འཁྱེར་བའི་དོན་དུ། དེ་དག་ལ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེར་ཞུས་སུ་ཆུག་ཅེས་པའོ། །"]},{"type":"verse","number":19,"content":["ཀ་བ་དང་། ལི་ཡི་རྒྱ་མཚོ། སྟེགས་བུ། གྲོང་ཁྱེར་འདིའི་ནང་དུ་ལུས་པའི་ཡོ་བྱད་བཅས་པ་སྟེ།"]},{"type":"verse","number":20,"content":["པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཡེ་ཧོ་ཡཱ་ཀིམ་གྱི་བུ་ཡེ་ཀོན་ཡཱ་དང་། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་སྐུ་དྲག་ཐམས་ཅད་བཟུང་སྟེ་ཡེ་རུ་སཱ་ལེམ་ནས་པཱ་པེལ་ལོན་དུ་ཁྲིད་དུས་བཙན་འཕྲོག་མ་བྱས་པའི་ཡོ་བྱད་དག་གི་སྐོར་དང་།"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དང་ཡ་ཧུ་དཱའི་རྒྱལ་པོའི་ཕོ་བྲང་། ཡེ་རུ་སཱ་ལེམ་བཅས་སུ་ལུས་པའི་ཡོ་བྱད་རྣམས་ཀྱི་སྐོར་ལ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ།"]},{"type":"verse","number":22,"content":["ཡོ་བྱད་དེ་རྣམས་པཱ་པེལ་ལོན་དུ་འཁྱེར་བར་འགྱུར་ཞིང་། ངས་ཡོ་བྱད་རྣམས་ལ་ལྟ་སྐྱོང་བྱས་ཏེ་འདི་དག་ཕྱིར་གནས་འདིར་སྤྲོད་པའི་བར་དུ་དེར་ལུས་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/26.json","previousChapterAudioLinks":{},"numberOfVerses":22}