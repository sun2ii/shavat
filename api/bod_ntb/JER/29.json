{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":29,"content":[{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ཡིས་པཱ་པེལ་ལོན་དུ་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འཕྲིན་བསྐུར་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་བཙོན་དུ་ཁྲིད་པའི་མཆོད་དཔོན་དང་ལུང་སྟོན་པ། མི་ཐམས་ཅད་དང་། ད་དུང་ཤུལ་དུ་ལུས་པའི་རྒན་པོ་རྣམས་ཏེ། ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཡེ་རུ་སཱ་ལེམ་ནས་པཱ་པེལ་ལོན་དུ་བཙོན་ལ་ཁྲིད་པའི་མི་ཡོངས་ལ། ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱས་ཡེ་རུ་སཱ་ལེམ་ནས་འཕྲིན་ཞིག་སྤྲིངས་པ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["འདི་ནི་རྒྱལ་པོ་ཡེ་ཀོན་ཡཱ་དང་རྒྱལ་ཡུམ། ཕོ་བྲང་གི་རྒྱལ་བློན། ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་འགོ་དཔོན། དེ་མིན་ཤིང་བཟོ་དང་མགར་པ་དང་བཅས་པ་ཡེ་རུ་སཱ་ལེམ་དང་བྲལ་བའི་རྗེས་སུ་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["འཕྲིན་ཡིག་འདི་ནི་ཤཱ་ཕན་གྱི་བུ་ཨེ་ལ་ཟཱ་དང་ཧིལ་ཀི་ཡཱའི་བུ་གེ་མར་ཡཱ་གཉིས་ཀ་བརྒྱུད་ནས་སྤྲིངས་པ་དང་། དེ་གཉིས་ནི་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱས་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་ལ་འཕྲད་དུ་མངགས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["འཕྲིན་ཡིག་གི་ནང་དུ་འདི་ལྟར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་བཙོན་དུ་ཁྲིད་པའི་མི་ཐམས་ཅད་དེ། ངས་ཡེ་རུ་སཱ་ལེམ་ནས་པཱ་པེལ་ལོན་དུ་བཙོན་ལ་ཁྲིད་དུ་བཅུག་པའི་མི་ཐམས་ཅད་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁང་པ་བརྩིགས་ནས་དེའི་ནང་དུ་འདུག་དགོས་ལ། སྐྱེད་ཚལ་བཙུགས་ནས་དེའི་ནང་གི་ཤིང་ཏོག་སྤྱོད་དགོས།"]},{"type":"verse","number":6,"content":["ཆུང་མ་བླངས་ནས་བུ་རྒྱུད་སྤེལ་བ་དང་། བུ་རྒྱུད་སྤེལ་བའི་ཕྱིར་ཁྱོད་རྣམས་ཀྱི་བུ་ལ་ཆུང་མ་ལོངས་ལ་ཁྱོད་རྣམས་ཀྱི་བུ་མོ་རྣམས་མནའ་མར་སྟེར་དགོས། ཁྱོད་རྣམས་གནས་དེར་མང་དུ་འཕེལ་བ་ལས་ཉུང་དུ་བྲི་མི་རུང་།"]},{"type":"verse","number":7,"content":["ཡང་ངས་ཁྱོད་ཅག་བཙོན་དུ་ཁྲིད་པའི་གྲོང་ཁྱེར་དེའི་ཆེད་དུ་ཁྱོད་རྣམས་ཀྱིས་ཞི་བདེ་ཚོལ་ཞིག གྲོང་ཁྱེར་དེའི་ཕྱིར་དུ་དཀོན་མཆོག་ཡ་ཝཱེར་གསོལ་བ་ཐོབས་ཤིག ཅི་ལ་ཞེ་ན། གྲོང་ཁྱེར་དེ་ལ་ཞི་བདེ་ཐོབ་ན་ཁྱོད་རྣམས་ཀྱང་བདེ་བ་ཡིན་ནོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":8,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ཁྱོད་རྣམས་ཁྱོད་ཅག་ཁྲོད་ཀྱི་ལུང་སྟོན་པ་དང་མོ་པ་རྣམས་ཀྱི་མགོ་སྐོར་འོག་ཏུ་མི་ཚུད་པར་གྱིས། ཡང་ཁྱོད་ཅག་གིས་རྨིས་པའི་རྨི་ལམ་ལ་བློ་མ་གཏོད་ཅིག"]},{"type":"verse","number":9,"content":["ཅི་ལ་ཞེ་ན། དེ་དག་གིས་ངའི་མིང་ལ་བརྟེན་ནས་ཁྱོད་ཅག་ལ་ལུང་བསྟན་རྫུན་མ་སྨྲས་པ་ཡིན་ལ། ངས་དེ་དག་མངགས་མེད་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། པཱ་པེལ་ལོན་གྱི་ཕྱིར་དུ་གཏན་ལ་ཕབ་བའི་བགྲང་བྱ་བདུན་ཅུ་རྫོགས་དུས་སུ། ངས་ཁྱོད་རྣམས་ལ་ལྟ་སྐྱོང་བྱས་ཏེ་ངའི་ཁས་ལེན་བཟང་པོ་ཁྱོད་ཅག་ལ་བསྒྲུབས་ནས། ཁྱོད་རྣམས་ཕྱིར་གནས་འདིར་འཁྲིད་འོང་དགོས།"]},{"type":"verse","number":11,"content":["ངས་ཁྱོད་རྣམས་ལ་བཅངས་པའི་བསམ་པ་ནི་ཁྱོད་ཚོར་ཞི་བདེ་འཐོབ་པ་ལས་ཆག་སྒོ་འབྱུང་བ་མིན་པ་ངས་རྟོགས་ཡོད། མ་འོངས་པ་ན་ཁྱོད་རྣམས་ལ་འོད་སྟོང་འབར་བའི་མདུན་ལམ་དང་རེ་བ་ཡོད་པར་བྱའོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཅག་གིས་ང་ལ་འོ་དོད་བོས་ནས་ངའི་ཕྱོགས་སུ་གསོལ་བ་བཏབ་ན་ངས་དེར་མཉན་པར་བྱའོ། །"]},{"type":"verse","number":13,"content":["ཡང་ཁྱོད་ཚོས་ང་ཚོལ་ཞིག སེམས་པ་རྩེ་གཅིག་གིས་ང་རང་བཙལ་ན་རྙེད་པར་འགྱུར་ཏེ།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཅག་གིས་ང་རང་རྙེད་པར་འགྱུར་ལ། ཡང་ངས་ཁྱོད་ཅག་བཙོན་དུ་ཁྲིད་པ་རྣམས་ཕྱིར་ལོག་པར་བྱ་སྟེ། ངས་ཁྱོད་རྣམས་སྐྲོད་སའི་རྒྱལ་ཁམས་དང་ཡུལ་ཕྱོགས་སོ་སོ་ནས་བསྡུས་ཏེ། ངས་ཁྱོད་རྣམས་བཙོན་དུ་ཁྲིད་ནས་ཁ་བྲལ་བའི་གནས་སུ་ཁྱོད་རྣམས་ཕྱིར་འཁྲིད་འོང་ངོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས།"]},{"type":"verse","number":15,"content":["ཁྱོད་རྣམས་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་པེལ་ལོན་ནས་རང་ཅག་གི་ཕྱིར་དུ་ལུང་སྟོན་པ་རྣམས་བསྐོས་སོ་ཞེས་སྨྲ་བས་ན།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་དཱ་བིད་ཀྱི་རྒྱལ་ཁྲིར་བཞུགས་པའི་རྒྱལ་པོ་དང་གྲོང་ཁྱེར་འདིར་གནས་པའི་མི་ཀུན་ཏེ། ཁྱོད་དང་ལྷན་ཅིག་པཱ་པེལ་ལོན་དུ་བཙོན་ལ་མ་ཁྲིད་པའི་སྤུན་ཟླ་རྣམས་ཀྱི་སྐོར་ལ་འདི་སྐད་གསུངས་ཏེ།"]},{"type":"verse","number":17,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་དེ་དག་གི་སྟེང་དུ་འབེབ་ཅིང་། དེ་དག་ནི་སེ་ཡབ་ཤིང་འབྲས་རུལ་བ་དང་མཚུངས་པར་བཟའ་ཐབས་མེད་པར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ངས་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ཀྱིས་དེ་དག་འདེད་ཅིང་། ས་སྟེང་གི་རྒྱལ་ཕྲན་ཐམས་ཅད་དེའི་ཕྱིར་འཇིགས་པར་འགྱུར་བ་དང་། ངས་དེ་དག་སྐྲོད་སའི་ཡུལ་ཁམས་རྣམས་སུ་མི་རྣམས་འཇིགས་པ་དང་། དམོད་མོ་དང་འཕྱ་དགོད་བྱེད་ས་དང་། ངོ་ཚ་གཏོད་ཡུལ་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":19,"content":["དེ་ནི་ངས་སྔོན་ཆད་རང་གི་ཞབས་ཕྱི་ལུང་སྟོན་པ་རྣམས་ཡང་ཡང་མངགས་ནས་སྨྲས་པའི་གཏམ་ལ་དེ་དག་གིས་མ་མཉན་པས་སོ། །ཁྱོད་རྣམས་ཀྱིས་ཀྱང་དེ་དང་དེ་བཞིན་དུ་མ་མཉན་ཏོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ།"]},{"type":"verse","number":20,"content":["དེ་བས་ཁྱོད་ཅག་ངས་ཡེ་རུ་སཱ་ལེམ་ནས་པཱ་པེལ་ལོན་དུ་བཏང་བའི་བཙོན་པ་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":21,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ངའི་མིང་གཡར་ནས་ཁྱོད་རྣམས་ལ་རྫུན་གྱི་ལུང་བསྟན་སྨྲ་བའི་ཀོ་ལ་ཡཱའི་བུ་ཨ་ཧབ་དང་མ་ཨ་སེ་ཡཱའི་བུ་ཚིད་ཀི་ཡཱ་གཉིས་ལ་མཚོན་ན། ལྟོས་ཤིག ངས་དེ་གཉིས་པོ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་ལག་ཏུ་གཏད་ནས། དེས་ཁྱོད་ཚོའི་མིག་མདུན་དུ་དེ་གཉིས་གསོད་པར་འགྱུར་ཞིང་།"]},{"type":"verse","number":22,"content":["པཱ་པེལ་ལོན་དུ་བཙོན་ལ་ཁྲིད་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱིས་དེ་གཉིས་པོ་བསྟན་ནས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ནི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་མེའི་ནང་དུ་བསྲེགས་པའི་ཚིད་ཀི་ཡཱ་དང་ཨ་ཧབ་ལྟར་མཛོད་ཅིག་ཅེས་དམོད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":23,"content":["མི་འདི་གཉིས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ནང་དུ་ངོ་ཚ་མེད་པའི་ལས་སྤྱད་དེ། རང་གི་ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་དང་ལོག་གཡེམ་སྤྱད་ཅིང་། ཡང་ངའི་མིང་གཡར་ནས་ངས་དེ་དག་ལ་མ་བསྒོས་པའི་རྫུན་སྨྲས་སོ། །ངས་དེ་ཐམས་ཅད་རྟོགས་ཤིང་བདེན་དཔང་ཡོད་དོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཤེ་མ་ཡཱའི་འཕྲིན་ཡིག"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རེམ་ཡཱ་ལ་འདི་ལྟར་བསྒོས་ཏེ། ཁྱོད་ཀྱིས་ནེ་ཧེ་ལམ་པ་ཤེ་མ་ཡཱ་ལ་འདི་ལྟར་སྨྲོས་ཤིག"]},{"type":"verse","number":25,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། དེ་ཡང་ཁྱོད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་མི་ཐམས་ཅད་དང་། མཆོད་དཔོན་མ་ཨ་སེ་ཡཱའི་བུ་ཟེ་ཕན་ཡཱ་ཞེས་པ་དང་། མཆོད་དཔོན་གཞན་རྣམས་ལ་རང་གི་མིང་བཀོད་ནས་འཕྲིན་བསྐུར་ཏེ་འདི་ལྟར།"]},{"type":"verse","number":26,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མཆོད་དཔོན་ཆེན་པོ་ཡེ་ཧོ་ཡ་དཱའི་ཚབ་ཏུ་ཁོང་གི་མཆོད་ཁང་དུ་སྤྱི་དཔོན་བྱེད་པར་ཟེ་ཕན་ཡཱ་ཁྱེད་ཉིད་མཆོད་དཔོན་དུ་བསྐོས་པ་ཡིན་པས། རང་ཉིད་ལུང་སྟོན་པ་ཡིན་ཞེས་སྨྱོ་ལབ་རྒྱག་མཁན་ཐམས་ཅད་ལ་རྐང་སྒྲོག་དང་སྐེ་སྒྲོག་རྒྱག་འོས།"]},{"type":"verse","number":27,"content":["ད་ལྟ་ཨ་ན་ཐོད་པ་ཡེ་རེམ་ཡཱ་ཡིས་ཁྱོད་རྣམས་ལ་ལུང་བསྟན་སྨྲས་པར་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་བཀའ་བཀྱོན་མི་གནང་ངམ།"]},{"type":"verse","number":28,"content":["དེས་བདག་ཅག་པཱ་པེལ་ལོན་དུ་གནས་པ་རྣམས་ལ་འཕྲིན་བསྐུར་ཏེ་འདི་ལྟར། བཙོན་ལ་གནས་པའི་དུས་ཡུན་རིང་སྟེ། ཁྱོད་ཅག་གིས་ཁང་པ་བརྩིགས་ནས་དེའི་ནང་དུ་འདུག་དགོས་ལ། སྐྱེད་ཚལ་བཙུགས་ནས་དེའི་ནང་གི་ཤིང་ཏོག་སྤྱོད་དགོས་ཞེས་སྨྲས་སོ་ཞེས་པའོ། །"]},{"type":"verse","number":29,"content":["ཡང་མཆོད་དཔོན་ཟེ་ཕན་ཡཱས་འཕྲིན་ཡིག་འདི་ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་རྣ་བར་བཀླགས་སོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":31,"content":["ཁྱོད་ཀྱིས་བཙོན་དུ་ཁྲིད་པ་ཀུན་ལ་འཕྲིན་བསྐུར་ཏེ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་ནེ་ཧེ་ལམ་པ་ཤེ་མ་ཡཱའི་སྐོར་ལ་འདི་སྐད་དུ། ངས་ཤེ་མ་ཡཱ་མ་མངགས་ཀྱང་དེས་ཁྱོད་ཅག་ལ་ལུང་བསྟན་ཏེ་ཁྱོད་རྣམས་རྫུན་ལ་ཡིད་ཆེས་སུ་བཅུག་པས།"]},{"type":"verse","number":32,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ནེ་ཧེ་ལམ་པ་ཤེ་མ་ཡཱ་དང་དེའི་བུ་རྒྱུད་ལ་ཉེས་ཆད་གཅོད་པར་བྱའོ། །ཁོའི་བུ་རབས་ཚ་རྒྱུད་ལས་གཅིག་ཀྱང་མི་འདི་རྣམས་ཀྱི་ནང་དུ་མི་ལུས་ཤིང་། ངས་རང་གི་འབངས་མི་ལ་གནང་བར་འགྱུར་བའི་བྱིན་རླབས་དེ་ཡང་མཐོང་བར་མི་འགྱུར། ཅི་ལ་ཞེ་ན། དེས་ཡ་ཝཱེ་ལ་ངོ་ལོག་གི་གཏམ་སྨྲས་པས་ཡིན་ཞེས་གསུངས་པ་སྨྲོས་ཤིག་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/28.json","previousChapterAudioLinks":{},"numberOfVerses":32}