{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":3,"content":[{"type":"heading","content":["བློ་མི་དཀར་བའི་ཡེས་ར་ཨེལ།"]},{"type":"verse","number":1,"content":["གལ་ཏེ་མི་ཞིག་གིས་ཆུང་མ་དོར་ནས་ཆུང་མ་དེ་ཁོ་དང་བྲལ་ཏེ་མི་གཞན་པའི་ཆུང་མ་བྱས་པ་ཡིན་ན། སྐྱེས་པ་དེ་སླར་ཡང་མོའི་གམ་དུ་འགྲོ་ནུས་སམ། གནས་དེ་རྩ་བ་ནས་བཙོག་པར་གྱུར་པ་མ་ཡིན་ནམ། ཁྱོད་ནི་དགའ་རོགས་མང་པོ་དང་ལོག་གཡེམ་སྤྱད་ཅིང་ད་ནི་བདག་གི་གམ་དུ་ལོག་འདོད་དམ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་མགོ་ཡར་བཀྱགས་ནས་སྐྱ་ཐེར་ཐེར་གྱི་མཐོ་སྒང་རྣམས་ལ་ལྟོས་ཤིག གནས་གང་དུ་ཁྱོད་ཀྱི་གཡེམ་སྦྱོར་མེད་དམ། ཁྱོད་ལམ་ཁར་བསྡད་དེ་དགའ་རོགས་ལ་སྒུག་པའི་ཚུལ་ནི། ཨ་རབ་པ་ཞིག་དབེན་སྟོང་དུ་འཇབ་པ་དང་འདྲ་སྟེ། ཁྱོད་ཀྱི་གཡེམ་སྦྱོར་དང་མ་རུངས་པས་ས་གཞི་ཐམས་ཅད་བཙོག་པར་བཟོས།"]},{"type":"verse","number":3,"content":["དེ་བས་དཔྱིད་ཆར་འབབ་མཚམས་བཞག་ཅིང་སྟོན་ཁའི་ཆར་བའང་མི་འབབ་པར་གྱུར་ཡང་། ཁྱོད་ཀྱི་གདོང་ནི་ད་དུང་སྨད་འཚོང་མའི་གདོང་བཞིན་ངོ་ཚ་དང་བྲལ་ཏོ། །"]},{"type":"verse","number":4,"content":["ཁྱོད་ཀྱིས་ད་ལྟ་བདག་ལ་ཞུས་ནས་ན་རེ། ཀྱེ་ང་ཡི་ཡབ་ལགས། ཁྱེད་ནི་ངའི་ལོ་ན་གཞོན་དུས་ཀྱི་མཛའ་གྲོགས་ཡིན།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཇི་སྲིད་བར་དུ་ཐུགས་ཁྲོས་ནས་ཡུན་རིང་པོར་ཁྲོ་གཏུམ་འབར་ག་ལ་སྲིད་ཅེས་པའོ། །ལྟོས་ཤིག ཁྱོད་ཀྱིས་འདི་ལྟར་སྨྲས་ཀྱང་ད་དུང་ནུས་ཤུགས་ཅི་ཡོད་བཏོན་ནས་སྤྱོད་ངན་སྤྱད་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱ་གཉིས་ཀྱིས་འགྱོད་བཤགས་བྱེད་འོས་པ།"]},{"type":"verse","number":6,"content":["ཡོ་ཤི་ཡཱས་རྒྱལ་སྲིད་སྐྱོང་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ལོག་ལམ་དུ་ཞུགས་པའི་ཡེས་ར་ཨེལ་གྱི་སྤྱོད་པ་མཐོང་ངམ། དེ་ནི་རི་མཐོན་པོ་རེ་རེར་སོང་སྟེ། སྔོ་ལྗང་གི་ལྗོན་ཤིང་རེ་རེའི་འོག་ཏུ་ལོག་གཡེམ་སྤྱད་པའོ། །"]},{"type":"verse","number":7,"content":["ངས་དེ་ཡིས་སྤྱོད་པ་འདི་ཐམས་ཅད་སྤྱད་རྗེས་སླར་ཡང་བདག་གི་ཕྱོགས་སུ་འཁོར་ཡོང་སྙམ་ནའང་དེ་ཕྱིར་མ་འོང་སྟེ། དེའི་སྲིང་མོ་གཡོ་སྒྱུ་ཅན་ཡ་ཧུ་དཱས་ཀྱང་མཐོང་བ་ཡིན།"]},{"type":"verse","number":8,"content":["ལོག་ལམ་དུ་ཞུགས་པའི་ཡེས་ར་ཨེལ་གྱིས་ལོག་གཡེམ་སྣ་ཚོགས་སྤྱད་པས་བདག་གིས་དེར་བཟའ་འཐོར་ཡི་གེ་སྤྲད་ནས་དོར་བ་ཡིན་མོད། འོན་ཀྱང་དེའི་སྲིང་མོ་གཡོ་སྒྱུ་ཅན་ཡ་ཧུ་དཱ་ནི་ད་དུང་མི་སྐྲག་པར་དེས་ཀྱང་ལོག་གཡེམ་སྤྱད།"]},{"type":"verse","number":9,"content":["ཡེས་ར་ཨེལ་གྱིས་ལོག་གཡེམ་སྤྱོད་པ་སྣང་མེད་དུ་བཏང་ཞིང་རྡོ་དང་ཤིང་ལ་ལོག་གཡེམ་སྤྱད་ནས་ས་འདི་ཡོངས་སུ་བཙོག་པར་བྱས།"]},{"type":"verse","number":10,"content":["དོན་འདི་ཐམས་ཅད་ཡོད་ཀྱང་། དེའི་སྲིང་མོ་གཡོ་སྒྱུ་ཅན་ཡ་ཧུ་དཱ་ནི་ང་ཡི་ཕྱོགས་སུ་ལོག་ཁུལ་བྱས་པ་ལས་སེམས་གཅིག་ལུས་གཅིག་མ་ཡིན་ནོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། གཡོ་སྒྱུ་ཅན་གྱི་ཡ་ཧུ་དཱ་ལས་ལོག་ལམ་དུ་ཞུགས་པའི་ཡེས་ར་ཨེལ་ནི་དྲང་པོར་མངོན་ཞིང་།"]},{"type":"verse","number":12,"content":["ཁྱོད་ནི་བྱང་ཕྱོགས་སུ་སོང་ནས་འདི་ལྟར། ཀྱེ་ལོག་ལམ་དུ་ཞུགས་པའི་ཡེས་ར་ཨེལ་ལགས། ཕྱིར་ལོག་དང་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །བདག་ནི་བྱམས་སྙིང་རྗེ་ཅན་ཡིན་པས་ངས་ཁྱོད་ཚོར་སྡང་མིག་གིས་མི་བལྟ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །བདག་ནི་ཇི་སྲིད་བར་དུ་ཁྲོ་བར་མི་བྱ་སྟེ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱིས་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་འགལ་ཏེ། སྔོ་ལྗང་གི་ལྗོན་ཤིང་རེ་རེའི་འོག་ཏུ་ཕྱི་ཕྱོགས་པའི་ལྷ་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་བདག་གི་བཀའ་ལ་མ་མཉན་པའི་སྡིག་པ་ཁས་ལོངས་ཤིག་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":14,"content":["ལོག་ལམ་དུ་ཞུགས་པའི་བུ་རྣམས་ཕྱིར་ལོག་ཅིག་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས། ཅི་ལ་ཞེ་ན། བདག་ནི་ཁྱོད་རྣམས་ཀྱི་ཁྱོ་ག་ཡིན་ལ། ངས་ཁྱོད་རྣམས་གྲོང་ཁྱེར་གཅིག་ནས་མི་གཅིག་རེ་དང་། རིགས་རྒྱུད་གཅིག་ནས་མི་གཉིས་རེ་བླངས་ཏེ་ཛ་ཡན་དུ་འཁྲིད་རྒྱུ་ཡིན།"]},{"type":"verse","number":15,"content":["ངས་རང་གི་བློར་འབབ་པའི་རྫི་བོ་ཁྱོད་རྣམས་ལ་གནང་སྟེ། དེ་དག་གིས་ཤེས་བྱ་དང་ཤེས་རབ་ཀྱིས་ཁྱོད་རྣམས་སྐྱོང་བར་འགྱུར།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ནི་ཡུལ་དེ་རུ་དར་ཞིང་རྒྱས་པའི་ཉིན་དེ་དག་ལ། མི་ཡིས་སླར་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཞེས་གླེང་བར་མི་འགྱུར་ལ། དེར་དོ་སྣང་མི་བྱེད། དེ་ཡིད་ལ་མི་དྲན། དེ་དགོས་འདོད་ཀྱང་མི་སྐྱེ། དེ་སླར་བཟོ་བར་ཡང་མི་བྱ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":17,"content":["དུས་དེར། མི་ཡིས་ཡེ་རུ་སཱ་ལེམ་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་བཞུགས་ཁྲི་ཞེས་འབོད་ཅིང་། མི་རིགས་ཐམས་ཅད་དེ་རུ་འདུ་བ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་དུ་འོང་ཞིང་། ཁོ་རྣམས་ཡང་བསྐྱར་རང་གི་སེམས་ངན་གཤིས་གྱོང་གི་རྗེས་སུ་མི་འབྲང་ངོ་། །"]},{"type":"verse","number":18,"content":["དུས་དེར། ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་དང་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་གཉིས་ལྷན་ཅིག་ཏུ་འགྲུལ་ཞིང་། བྱང་ཕྱོགས་ནས་མཉམ་དུ་བདག་གིས་ཁྱོད་ཚོའི་མེས་པོ་རྣམས་ལ་ནོར་སྐལ་དུ་གནང་བའི་ཡུལ་དུ་འོང་བར་འགྱུར།"]},{"type":"heading","content":["དཀོན་མཆོག་གི་མི་རྣམས་ཀྱིས་སྐུ་འདྲར་ཕྱག་བཙལ་བ།"]},{"type":"verse","number":19,"content":["བདག་གིས་ཁྱོད་ནི་རང་གི་བུ་དང་བུ་མོར་བརྩིས་ཤིང་ཁྱོད་ལ་ཡིད་དུ་འོང་བའི་ཡུལ་ཞིག་གནང་བ་སྟེ། ཡུལ་དེ་ནི་མི་རིགས་རྣམས་ལས་ཆེས་ལེགས་པའི་ནོར་སྐལ་ཡིན་ལ། ཁྱོད་ཀྱིས་བདག་ལ་ངའི་ཡབ་ཅེས་བོས་ནས་སླར་ཡང་བདག་དང་མི་འབྲལ་བར་ང་ཡི་རྗེས་སུ་འབྲང་ངེས་ཡིན་སྙམ་ནའང་།"]},{"type":"verse","number":20,"content":["ཀྱེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས། ཁྱོད་ཚོས་བདག་གི་ཕྱོགས་སུ་གཡོ་སྒྱུ་ཚད་པ་དེ་ནི། ཆུང་མ་ཞིག་གིས་གཡོ་སྒྱུ་ཚད་ནས་རང་གི་ཁྱོ་གར་བྲལ་བ་དང་མཚུངས་ཞེས་དཀོན་མཆོན་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":21,"content":["སྐྱ་ཐེར་ཐེར་གྱི་མཐོ་སྒང་ནས་སྐད་སྒྲ་ཞིག་བྱུང་བ་སྟེ། དེ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ངུས་ནས་ནན་ཞུ་བྱེད་པའི་སྐད་སྒྲ་ཡིན་ལ། ཅི་ལ་ཞེ་ན། དེ་རྣམས་ལོག་ལམ་དུ་རྒྱུ་བ་སྟེ་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེ་བརྗེད་པས་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["ལོག་ལམ་དུ་ཞུགས་པའི་བུ་རྣམས་ཕྱིར་ཤོག་དང་། བདག་གིས་ཁྱོད་ཚོ་ལོག་ལམ་དུ་ཞུགས་པའི་ནད་གསོ་བར་བྱ། གཟིགས་དང་ངེད་རྣམས་ཁྱེད་ཀྱི་དྲུང་དུ་འོང་བར་བྱ་སྟེ། ཅི་ལ་ཞེ་ན། ཁྱེད་ནི་ངེད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་པས་སོ། །"]},{"type":"verse","number":23,"content":["རི་སྒང་དང་རི་བོ་རྣམས་ཀྱི་འུར་སྒྲ་ལས་སྐྱབས་འཚོལ་བ་ནི་དོན་མེད་ཡིན་ལ། ཡེས་ར་ཨེལ་གྱི་ཐར་པ་ནི་དངོས་གནས་ང་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཐུག་ཡོད་དོ། །"]},{"type":"verse","number":24,"content":["ངེད་རྣམས་ལོ་ན་གཞོན་པའི་དུས་ནས་ད་ལྟའི་བར་དུ། རང་ཅག་གི་མེས་པོས་ངལ་རྩོལ་བྱས་ནས་ཐོབ་པ་དང་། ཁོང་རྣམས་ཀྱི་ར་ལུག་དང་བ་གླང་གི་ཁྱུ། བུ་དང་བུ་མོ་བཅས་ཐམས་ཅད་ལྷ་ཁྲེལ་མེད་དག་གིས་མེད་པར་བཟོས།"]},{"type":"verse","number":25,"content":["རང་ཅག་དང་རང་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་ང་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱས་ཤིང་། རང་ཅག་གིས་ལོ་ན་གཞོན་པའི་དུས་ནས་ད་ལྟའི་བར་དུ་ང་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་མ་མཉན་པས་ན། རང་ཅག་ངོ་ཚའི་ནང་དུ་ཉལ་ནས་ཡོངས་སུ་ངོ་གནོང་བར་གྱུར་ཅིག"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}