{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":31,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཕྱིར་རང་ཡུལ་དུ་ལོག་པ།"]},{"type":"verse","number":1,"content":["དེའི་ཚེ་ང་ནི་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་སོ་སོའི་དཀོན་མཆོག་དང་དེ་དག་ངའི་འབངས་མི་རུ་འགྱུར་རོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། རལ་གྲི་ལས་ཐར་བའི་མི་རྣམས་ལ་དབེན་སྟོང་ནས་གཟིགས་སྐྱོང་འཐོབ་པ་དང་། ངས་ཡེས་ར་ཨེལ་ལ་ངལ་གསོ་གནང་བར་བྱའོ་ཞེས་གསུངས།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་རྒྱང་རིང་ནས་ང་ལ་མངོན་པར་གྱུར་ཏེ་འདི་སྐད་དུ། ངས་མཐའ་མེད་པའི་བྱམས་བརྩེས་ཁྱོད་ལ་བྱམས་པས། ངས་བྱམས་བརྩེ་ཡིས་ཁྱོད་རང་འགུག་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཀྱེ་ན་ཆུང་ཡེས་ར་ཨེལ་ལགས། ངས་ཡང་བསྐྱར་ཁྱོད་བརྩིགས་ན་ཁྱོད་རང་ཚུགས་པར་འགྱུར་ལ། ཁྱོད་ཀྱིས་ཡང་བསྐྱར་སིལ་རྔ་བཟུང་ནས་དགའ་མགུའི་ངང་གར་རྩེད་ཀྱི་ཁྲོད་དུ་ཞུགས་པར་འགྱུར།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱིས་སཱ་མར་ཡའི་རི་རྣམས་ལ་རྒུན་ཚལ་རྣམས་འཛུགས་ཤིང་། འཛུགས་མཁན་གྱིས་བཙུགས་ནས་དེའི་ཤིང་ཏོག་ལོངས་སུ་སྤྱོད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":6,"content":["ཉིན་ཞིག་ལ་ཨེ་ཕཱར་ཡིམ་གྱི་རི་ལས་སོ་ལྟ་པས་འདི་ལྟར། ལོངས་ཤིག་དང་། རང་ཅག་ཛ་ཡན་དུ་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འགྲོའོ་ཞེས་འབོད་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":7,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡ་ཀོབ་ཀྱི་ཕྱིར་དུ་དགའ་སྤྲོའི་སྐད་སྒྲོགས་ཤིག མི་རིགས་ཀུན་ལས་གཙོ་བོ་ཡིན་པ་དེའི་ཕྱིར་དགའ་འབོད་གྱིས་ཤིག ཁྱོད་ཚོས་ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཉིད་ཀྱི་མི་རྣམས་སྐྱོབ་པར་མཛོད་ཅིག ཡེས་ར་ཨེལ་གྱི་ལྷག་ལུས་རྣམས་སྐྱོབ་པར་མཛོད་ཅིག་ཅེས་ཁྱབ་བསྒྲག་བྱོས་ལ་བསྟོད་ཅིག"]},{"type":"verse","number":8,"content":["ལྟོས་ཤིག ངས་དེ་དག་བྱང་ཕྱོགས་ཀྱི་ཡུལ་ནས་ཕྱིར་འཁྲིད་འོང་བ་དང་ས་མཐའ་ནས་བསྡུ་བར་བྱ་སྟེ། དེ་དག་གི་ནང་དུ་ལོང་པ་དང་ཞ་བོ། མངལ་དང་ལྡན་པ། སྦྲུམ་མ་བཅས་ཡོད་ཅིང་མི་ཚོགས་ཆེན་པོ་ཞིག་ཚུར་ལོག་འོང་།"]},{"type":"verse","number":9,"content":["དེ་དག་ངུ་བཞིན་འོངས་ནས་བདག་ལ་ཞུ་བ་བྱེད་པ་དང་། ངས་ཁོ་རྣམས་ཁྲིད་ནས་གཙང་པོའི་འགྲམ་དང་དྲང་པོའི་ལམ་དུ་བསྐྱོད་པར་བྱེད་ཅིང་དེ་རྣམས་འགྱེལ་བར་མི་འགྱུར་རོ། །ཅི་ལ་ཞེ་ན། ང་ནི་ཡེས་ར་ཨེལ་གྱི་ཕ་དང་། ཨེ་ཕཱར་ཡིམ་ནི་ངའི་སྐྱེས་འགོ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["ཀྱེ་མི་རིགས་རྣམས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག རྒྱང་རིང་གི་གླིང་ཕྲན་དུ་འདི་བཞིན་སྒྲོགས་ཤིག ཡེས་ར་ཨེལ་སིལ་བུར་གཏོར་མཁན་གྱིས་དེ་སླར་ཡང་བསྡུ་ཞིང་། རྫི་བོས་རང་གི་ལུག་ཁྱུ་སྲུང་བ་ལྟར་དེ་དག་བསྲུང་བར་འགྱུར་ཞེས་པའོ། །"]},{"type":"verse","number":11,"content":["ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཀོབ་བླུས་པ་དང་། དེ་ནི་རང་ལས་སྟོབས་ཆེ་བའི་ལག་ནས་ཐར་བར་མཛད།"]},{"type":"verse","number":12,"content":["དེ་རྣམས་ཛ་ཡན་གྱི་མཐོ་སར་འོངས་ཏེ་གླུ་ལེན་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེས་གནང་སྦྱིན་བཟང་པོ་རྣམས་ཏེ། འབྲུ་རིགས་དང་རྒུན་ཆང་། སྣུམ། ལུ་གུ། བ་ཕྲུག་བཅས་གནང་བས་དགའ་སྤྲོས་དགང་ཞིང་། དེ་དག་གི་མི་ཚེ་ནི་ཆུ་མོད་པའི་སྐྱེད་ཚལ་ལྟར་གྱུར་ནས་ནམ་ཡང་སྐམ་པར་མི་འགྱུར།"]},{"type":"verse","number":13,"content":["དེའི་དུས་སུ་ན་ཆུང་མ་རྣམས་དགའ་ནས་བྲོ་འཁྲབ་ཅིང་། ཁ་རྒན་གཞོན་ཐམས་ཅད་མཉམ་དུ་དགའོ། །ཅི་ལ་ཞེ་ན། ངས་དེ་དག་གི་སྡུག་བསྔལ་ནི་དགའ་སྤྲོ་རུ་བསྒྱུར་ནས་ཁོ་རྣམས་ལ་སེམས་གསོ་བྱེད་པ་དང་། དེ་དག་ལ་སེམས་སྡུག་ཁྲོད་དགའ་སྤྲོ་འཐོབ་པར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ཡང་མཆོད་དཔོན་རྣམས་ཀྱི་སེམས་ནི་སྣུམ་གྱིས་ཚིམ་པར་བྱ་ཞིང་། མི་རྣམས་ངའི་གནང་སྦྱིན་གྱིས་ཚིམ་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་སྙིང་རྗེས་གཟིགས་པ།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། རཱ་མ་རུ་ཆོ་ངེ་འདོན་པ་དང་ངུ་འབོད་ཆེན་པོའི་སྒྲ་ཞིག་ཐོས་འོང་སྟེ། དེ་ནི་རཱ་ཧེལ་རང་གི་བུ་ཕྲུག་རྣམས་ཀྱི་ཕྱིར་ངུ་བ་ཡིན་ལ། དེ་རྣམས་མེད་པས་མོས་སེམས་གསོ་མི་འདོད་དོ་ཞེས་གསུངས།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱི་ཅི་བྱས་ལ་ལས་འབྲས་འཐོབ་ཅིང་དེ་རྣམས་དགྲ་བོའི་ཡུལ་ནས་ཕྱིར་ལོག་འོང་བས་སྐད་བརྒྱབ་ནས་མ་ངུ་ཞིག ཁྱོད་ཀྱི་མིག་ལས་མཆི་མ་མ་བཞུར་ཅིག་ཅེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱི་བུ་ཕྲུག་རྣམས་སླར་རང་གི་ཡུལ་དུ་འོང་བར་འགྱུར་བས་ན། ཁྱོད་ཀྱི་མ་འོངས་པར་རེ་བ་ཡོད་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":18,"content":["ཨེ་ཕཱར་ཡིམ་གྱིས་རང་གི་ཆེད་དུ་འདི་ལྟར་སྨྲེ་སྔགས་འདོན་པ་ངས་ཐོས་ཏེ། ཁྱེད་ཀྱིས་བདག་བཅུན་ཞིང་ང་ནི་ཁ་ལོ་མ་བཏུལ་བའི་བ་ཕྲུག་ཅིག་དང་འདྲ། ཁྱེད་ནི་ངའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས་པས། ང་གསོ་བར་མཛོད་དང་ང་ཕྱིར་འཁོར་འོང་།"]},{"type":"verse","number":19,"content":["ང་ཕྱིར་འཁོར་རྗེས་སེམས་གཏིང་ནས་འགྱོད་པ་སྐྱེས་ཤིང་། གོ་རྟོགས་སད་རྗེས་རང་གི་བྲང་ཁར་བརྡུངས་",{"noteId":10},"ཤིང་། ངས་ན་གཞོན་དུས་ཀྱི་བརྙས་བཅོས་ཁུར་བས་འགྱོད་པ་སྐྱེས་ནས་ངོ་ཚ་བར་གྱུར་ཏོ་ཞེས་པའོ། །"]},{"type":"verse","number":20,"content":["ཨེ་ཕཱར་ཡིམ་ནི་ངའི་གཅེས་པའི་བུ་ཡིན་ནམ། ང་དགའ་བའི་བུ་དེ་ཡིན་ནམ། ངས་དེ་ལ་བཀའ་བཀྱོན་གནང་དུས་སུ་སེམས་ལ་ཡང་བསྐྱར་དེ་དྲན་ངེས་ཡིན། དེའི་ཕྱིར་ངའི་སེམས་ནས་དེ་ལ་སེམས་ཁྲལ་བྱེད་ཅིང་། ངས་དེ་ལ་སྙིང་རྗེ་བསྐྱེད་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":21,"content":["ཀྱེ་ན་ཆུང་བུ་མོ་ཡེས་ར་ཨེལ་ལགས། རང་གི་དོན་དུ་ལམ་ཐོ་ཚུགས་ཤིག རང་ལ་ཐོ་སློངས་ཤིག ཁྱོད་རང་འགྲིམས་མྱོང་བའི་ལམ་ཆེན་ལ་ཡིད་འཇོག་ཡོད་པར་གྱིས། ཁྱོད་ཕྱིར་འཁོར་ལ་རང་གི་གྲོང་ཁྱེར་གྱི་ནང་དུ་ལོག་ཤོག"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ས་གཞིའི་སྟེང་དུ་བུད་མེད་ཀྱིས་སྐྱེས་པ་བསྲུང་བའི་དོན་གསར་པ་ཞིག་མཛད་པར་འགྱུར་བས། དད་པ་མི་བརྟན་པའི་བུད་མེད་ཁྱོད་གང་སར་འཁྱམས་ནས་དུས་ག་ཙམ་ལ་འདུག་གམ།"]},{"type":"heading","content":["དཀོན་མཆོག་གི་འབངས་མིའི་འོད་སྟོང་འབར་བའི་མ་འོངས་པ།"]},{"type":"verse","number":23,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ངས་བཙོན་དུ་ཁྲིད་པའི་མི་རྣམས་ཕྱིར་ལོག་ཏུ་འཇུག་པའི་དུས་སུ། དེ་རྣམས་ཀྱིས་ཡ་ཧུ་དཱའི་ཡུལ་ཁམས་དང་དེའི་གྲོང་ཁྱེར་དུ། ཀ་ཡེ་དྲང་བདེན་གྱི་གནས་ཚང་། རི་བོ་དམ་པ་ལགས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་བྱིན་རླབས་གནང་བར་གྱུར་ཅིག་ཅེས་བརྗོད་པར་འགྱུར།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་སོ་སོའི་མི་དང་ཞིང་པ། ཕྱུགས་འཚོ་བའི་མི་ཐམས་ཅད་ལྷན་ཅིག་ཏུ་ཡ་ཧུ་དཱ་རུ་གནས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":25,"content":["ཉམ་ཐག་པའི་མི་ཀུན་ལ་ངས་སེམས་ཤུགས་བསྐྱེད་ཅིང་། སེམས་སྡུག་པའི་མི་ནི་ངས་ཡིད་ཚིམ་པར་འཇུག་གོ་ཞེས་གསུངས།"]},{"type":"verse","number":26,"content":["དེ་ནས་ང་གཉིད་ལས་སད་ཅིང་ཕྱོགས་བཞིར་བལྟས་པ་དང་། ངས་རང་ཉིད་གཉིད་སྐྱིད་པོ་ཞིག་ལོག་པ་ཚོར་བྱུང་།"]},{"type":"verse","number":27,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། ངས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་དང་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་གཉིས་ཀྱི་མི་ཕྱུགས་གཉིས་ཀ་འཕེལ་བར་བྱའོ། །"]},{"type":"verse","number":28,"content":["ངས་སྔོན་ཆད་དེ་རྣམས་རྩ་བ་ནས་འདོན་པ་དང་བཤིག་པ། བརླག་པ། ཕམ་པར་བཟོ་བ། ཆག་སྒོ་འབེབ་པ་བཅས་ལ་ཇི་ལྟར་ཡིད་འཇོག་བྱས་ན། མ་འོངས་པ་ན་ངས་དེ་རྣམས་ཡར་བརྩིག་པ་དང་འཛུགས་པའི་དོན་ལའང་དེ་ལྟར་ཡིད་འཇོག་བྱེད་ངེས་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":29,"content":["དེའི་དུས་སུ་མི་རྣམས་ཀྱིས་ཕ་ཡིས་རྒུན་འབྲུམ་སྐྱུར་མོ་ཟོས་པས་བུ་ཡི་སོ་བརྩེ་ཞེས་མི་ཟེར་རོ། །"]},{"type":"verse","number":30,"content":["ཡིན་ནའང་སོ་སོ་རང་རང་གི་སྡིག་པའི་ལས་འབྲས་ཀྱིས་འཆི་ཞིང་། རྒུན་འབྲུམ་སྐྱུར་མོ་ཟ་མཁན་རང་རང་གི་སོ་བརྩེ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":31,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། བདག་གིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་དང་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་གཉིས་ལ་ཞལ་ཆད་གསར་པ་ཞིག་འཇོག་པར་བྱ་སྟེ།"]},{"type":"verse","number":32,"content":["ཞལ་ཆད་འདི་ནི་བདག་གིས་དེ་དག་གི་ཕ་མེས་རྣམས་ཀྱི་ལག་པར་འཇུས་ཏེ་ཨེ་ཅིབ་ཡུལ་ནས་ཁྲིད་ཡོང་དུས་བཞག་པའི་ཞལ་ཆད་ལྟ་བུ་མ་ཡིན་ཏེ། བདག་ནི་དེ་དག་གི་ཁྱོ་བོ་ཡིན་ནའང་དེ་རྣམས་ངའི་ཞལ་ཆད་དང་འགལ་བ་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":33,"content":["དུས་དེའི་རྗེས་སུ་བདག་གིས་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ལ་ཞལ་ཆད་གསར་པ་ཞིག་གནང་བར་བྱ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། དེ་ནི་ངས་རང་གི་བཀའ་ཁྲིམས་དེ་དག་གི་ཡིད་ལ་འཇོག་ཅིང་དེ་དག་གི་སེམས་ནང་དུ་བརྐོ་བར་བྱ། བདག་ནི་དེ་དག་གི་དཀོན་མཆོག་དང་དེ་དག་བདག་གི་འབངས་མི་རུ་འགྱུར་བ་དང་།"]},{"type":"verse","number":34,"content":["ཡང་མི་མཆོག་དམན་ཀུན་གྱིས་བདག་ངོ་ཤེས་པར་འགྱུར་ལ། ངས་དེ་དག་གི་སྡིག་པ་སེལ་ཞིང་ཕྱིན་ཆད་དེ་དག་གི་སྡིག་ཉེས་མི་དྲན་པའི་རྐྱེན་གྱིས། སུས་ཀྱང་རང་གི་ཁྱིམ་མཚེས་དང་སྤུན་ལ་དཀོན་མཆོག་ཡ་ཝཱེ་ངོ་ཤེས་པར་འོས་ཞེས་སྨྲ་ཞིང་བསླབ་པར་མི་འགྱུར་རོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":35,"content":["ཉིན་མོའི་འོད་དུ་ཉི་མ་གནང་ཞིང་། མཚན་མོའི་འོད་དུ་ཟླ་བ་དང་སྐར་མ་རྣམས་ཀྱི་སྲོལ་མཛད་དེ། རྒྱ་མཚོའི་རྦ་རླབས་དཀྲུགས་ནས་མཚོ་རུ་རྦ་རླབས་ཆིལ་ཆིལ་གཡོ་བར་མཛད། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཁོང་གི་མཚན་ལགས་པ་ཉིད་ཀྱིས་འདི་སྐད་དུ།"]},{"type":"verse","number":36,"content":["ཇི་སྟེ་ཆོས་ཉིད་འདི་དག་ངའི་མདུན་ནས་འདོར་ནུས་པ་ཡིན་ན། ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཀྱང་ངའི་མདུན་ནས་རྒྱུད་ཆད་པར་གྱུར་ཏེ་རྒྱལ་ཁམས་ཤིག་ཏུ་གཏན་ནས་མི་གྲུབ་བོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":37,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། གལ་ཏེ་མི་ཡིས་སྟེང་གི་ནམ་མཁའ་གཞལ་ནུས་པ་དང་འོག་གི་རྩིག་རྨང་འཚོལ་ཞིབ་བྱེད་ཐུབ་ན། བདག་གིས་ཀྱང་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ཐམས་ཅད་ཀྱིས་བྱས་པའི་ལས་ཀུན་གྱི་ཕྱིར་ཁོ་རྣམས་འདོར་བར་བྱའོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":38,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། ཧ་ནན་ཨེལ་ལྕོག་མཁར་ནས་གྲུ་ག་ཡི་རྒྱ་སྒོའི་བར་དུ་གྲོང་ཁྱེར་འདི་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་དུ་བཞེང་བའི་དུས་དེ་སླེབས་ལ་ཉེ།"]},{"type":"verse","number":39,"content":["ཡང་ཐིག་སྐུད་ཕྱི་རུ་འཐེན་ཏེ་ག་རེབ་རི་བོ་ནས་གོ་ཨཱའི་བར་དུ་སླེབ་པར་འགྱུར།"]},{"type":"verse","number":40,"content":["རོ་གཡུག་ས་དང་ཐལ་བ་གཏོར་སའི་ལུང་པ་ཧྲིལ་པོ་དང་བཅས་ཞིང་ས་ཐམས་ཅད་ཀིད་རོན་གྲོག་མོའི་བར་དང་། ཤར་ཕྱོགས་རྟའི་རྒྱ་སྒོ་ཡི་གྲུ་གའི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་དམ་པར་འགྱུར་ཞིང་། ཕྱིན་ཆད་ནམ་ཡང་དེ་རྩ་བ་ནས་འདོན་པ་དང་ཕམ་པར་བཟོ་བར་མི་འགྱུར་རོ། །"]}],"footnotes":[{"noteId":10,"caller":"+","text":"འདིར་བྲང་ཁར་བརྡུངས་ཞེས་པར་མ་ཕྱི་ལས་བརླ་ལ་ཐལ་ལྕག་གཞུས་ཞེས་མཐོང་སྟེ། ངོ་གནོང་བ་མཚོན་པ་ཡིན།","reference":{"chapter":31,"verse":19}}]},"thisChapterLink":"/api/bod_ntb/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}