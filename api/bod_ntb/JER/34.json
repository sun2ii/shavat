{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":34,"content":[{"type":"heading","content":["ཚིད་ཀི་ཡཱ་ལ་བསྐུར་བའི་འཕྲིན།"]},{"type":"verse","number":1,"content":["དེ་ཡང་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ཁོའི་དམག་དཔུང་ཐམས་ཅད་དང་། མངའ་འོག་ཏུ་ཡོད་པའི་ས་སྟེང་གི་རྒྱལ་ཕྲན་དང་མི་རིགས་ཐམས་ཅད་ཁྲིད་དེ། ཡེ་རུ་སཱ་ལེམ་དང་དེའི་མཐའ་འཁོར་གྱི་གྲོང་ཁྱེར་ཡོངས་རྫོགས་ལ་རྒོལ་བའི་ཚེ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་སོང་ནས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ལ་ཤོད་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་གྲོང་ཁྱེར་འདི་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་དེ། དེས་གྲོང་ཁྱེར་འདི་མེ་ཡིས་བསྲེག་པར་འགྱུར་ཞིང་།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱང་དེའི་ལག་ནས་ཐར་མི་ཐུབ་ལ་བཟུང་ནས་དེའི་ལག་ཏུ་གཏོད་ངེས་ཡིན། ཁྱོད་ཀྱིས་དངོས་སུ་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་མཐོང་ཞིང་། དེས་དངོས་སུ་ཁྱོད་ལ་གཏམ་སྨྲ་བར་འགྱུར་ལ། ཁྱོད་ཀྱང་པཱ་པེལ་ལོན་དུ་འགྲོ་ངེས་ཡིན་ཞེས་གསུངས་ཞེས་པའོ། །"]},{"type":"verse","number":4,"content":["ཀྱེ་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་སྐོར་ལ་འདི་སྐད་དུ། ཁྱོད་ནི་རལ་གྲིའི་འོག་ཏུ་མི་འཆི་བར།"]},{"type":"verse","number":5,"content":["བདེ་བར་ཚེ་ལས་འདས་ཏེ། མི་རྣམས་ཀྱིས་ཇི་ལྟར་ཁྱོད་ཀྱི་མེས་པོ་སྟེ་རྒྱལ་པོ་སྔ་རབས་རྣམས་ལ་སྤོས་བདུགས་པ་བཞིན་ཁྱོད་ལའང་དེ་ལྟར་སྤོས་བདུག་ཅིང་། ཀྱི་ཧུད་ཇོ་བོ་ལགས་ཞེས་ཟེར་ཞིང་ཁྱོད་ཀྱི་དོན་དུ་མྱ་ངན་ཞུ་བར་འགྱུར་ཞེས་བདག་གིས་སྨྲའོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱ་ཡིས་ཡེ་རུ་སཱ་ལེམ་དུ་གཏམ་འདི་རྣམས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ལ་སྨྲས་པའོ། །"]},{"type":"verse","number":7,"content":["དུས་དེར་པཱ་པེལ་ལོན་རྒྱལ་པོའི་དམག་དཔུང་གིས་ཡེ་རུ་སཱ་ལེམ་དང་ཡ་ཧུ་དཱ་ནས་ལུས་པའི་གྲོང་ཁྱེར་ཏེ་ལཱ་ཀི་སི་དང་ཨ་ཟེ་ཀཱ་གཉིས་ཀར་དམག་བརྒྱབ་བོ། །ཅི་ལ་ཞེ་ན། ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་ལས་མཁར་བརྟན་པོ་ལུས་པ་འདི་གཉིས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ཡང་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ཡིས་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་དང་ཁ་ཆད་བཞག་ནས་བྲན་པོ་རྣམས་ལ་རང་དབང་སྟེར་དགོས་པར་བསྒྲགས་ཤིང་། དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བའོ། །"]},{"type":"verse","number":9,"content":["མི་རེ་རེས་རང་རང་གི་ཨིབ་རི་པའི་གཡོག་པོ་དང་གཡོག་མོ་རྣམས་གཏོང་དགོས་པ་དང་། སུས་ཀྱང་རང་གི་ཡ་ཧུ་དཱའི་སྤུན་མཆེད་གཡོག་པོར་བྱེད་མི་རུང་བར་བྱས།"]},{"type":"verse","number":10,"content":["ཁ་ཆད་བཞག་པའི་འགོ་དཔོན་དང་མི་ཐམས་ཅད་རང་གི་གཡོག་པོ་དང་གཡོག་མོ་རྣམས་གཏོང་བར་ཡིད་འཐད་པ་དང་། དེ་རྣམས་ཡང་བསྐྱར་བྲན་གཡོག་བྱེད་དུ་མ་བཅུག་གོ །ཁོ་ཚོ་ཚང་མ་དེར་ཡིད་འཐད་པར་མ་ཟད་གཡོག་པོ་གཡོག་མོ་རྣམས་ལ་རང་དབང་སྤྲད་པ་རེད།"]},{"type":"verse","number":11,"content":["ཡིན་ནའང་རྗེས་སུ་དེ་རྣམས་བློ་འགྱོད་སྐྱེས་ནས། རང་དབང་སྤྲད་ནས་བཏང་བའི་གཡོག་པོ་གཡོག་མོ་རྣམས་ཕྱིར་བོས་ནས་དེ་དག་བྲན་གཡོག་བྱེད་དུ་བཙན་བཙུགས་སོ། །"]},{"type":"heading","content":["བྲན་གཡོག་དགྲོལ་བའི་ཞལ་ཆད་དང་འགལ་བ།"]},{"type":"verse","number":12,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཡེ་རེམ་ཡཱ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":13,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དེ་ཡང་ངས་ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་བྲན་དུ་བཀོལ་བའི་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོང་དུས། དེ་དག་དང་ཞལ་ཆད་བཞག་ནས་འདི་ལྟར།"]},{"type":"verse","number":14,"content":["གལ་ཏེ་ཨིབ་རི་པའི་སྤུན་ཞིག་ཁྱོད་ལ་བཙོངས་ནས་ལོ་དྲུག་གི་རིང་དུ་ཁྱོད་ལ་ཞབས་ཕྱི་བསྒྲུབས་པ་ཡིན་ན། ལོ་བདུན་པར་ཁྱོད་རྣམས་མི་རེ་རེས་དེར་རང་དབང་སྤྲད་ནས་ཕྱིར་གཏོང་དགོས་ཞེས་བསྒོས་ཀྱང་། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་བདག་ལ་མ་མཉན་པ་དང་དོ་སྣང་ཙམ་ཡང་མེད་དོ། །"]},{"type":"verse","number":15,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་འགྱོད་བཤགས་བྱས་ཏེ་ངའི་མིག་ལམ་དུ་ལེགས་པོ་གང་ཡིན་དེ་སྤྱད་ནས། མི་རེ་རེས་རང་གི་སྤུན་ཟླར་རང་དབང་བསྒྲགས་པ་དང་། ངའི་མིང་གིས་འབོད་པའི་མཆོད་ཁང་ནང་དུ་ངའི་མདུན་ནས་ཁ་ཆད་བཞག་མོད་ཀྱང་།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་བློ་འགྱོད་དེ་ངའི་མིང་ཁྱད་དུ་བསད་ནས། མི་རེ་རེས་རང་རང་གི་རང་དབང་སྤྲད་ནས་འགྲོ་རུ་བཅུག་པའི་གཡོག་པོ་གཡོག་མོ་རྣམས་ཕྱིར་ལོག་ཏུ་བཅུག་ནས་དེ་དག་བྲན་གཡོག་བྱེད་དུ་བཙན་བཙུགས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཅག་གིས་ང་ལ་མཉན་ནས་རེ་རེས་རང་གི་སྤུན་ཟླ་དང་ཁྱིམ་མཚེས་ལ་རང་དབང་མི་བསྒྲག་པས། ལྟོས་ཤིག ངས་ད་ལྟ་ཁྱོད་ཅག་ལ་རང་དབང་སྒྲོག་ཅིང་། ཁྱོད་རྣམས་ནི་རལ་གྲི་དང་མུ་གེ རིམས་ནད་བཅས་ལ་གཏད་དེ། ས་སྟེང་གི་རྒྱལ་ཕྲན་ཐམས་ཅད་ཁྱོད་ཅག་ལ་འཇིགས་པར་འགྱུར་རོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":18,"content":["ངའི་ཞལ་ཆད་དང་འགལ་བའི་མི་རྣམས་ངས་སྤྲོད་པར་བྱ་སྟེ། དེ་དག་གིས་ངའི་མདུན་དུ་བ་ཕྲུག་དུམ་བུ་གཉིས་སུ་གཤགས་",{"noteId":11},"ཤིང་དུམ་བུ་དེ་གཉིས་ཀྱི་བར་ནས་རྒྱུ་དུས་སུ་ཞལ་ཆད་བཞག་ནས་བསྐྱལ་བའི་མནའ་ཚིག་མ་བསྲུངས་སོ། །"]},{"type":"verse","number":19,"content":["ཁོ་རྣམས་ནི་བ་ཕྲུག་དུམ་བུ་གཉིས་སུ་གཤགས་པའི་བར་ནས་རྒྱུ་མཁན་ཡ་ཧུ་དཱའི་འགོ་དཔོན་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་འགོ་དཔོན། ཕོ་བྲང་ནང་གི་འཁོར་གཡོག མཆོད་དཔོན། དེ་མིན་ཡུལ་དེའི་མི་སྡེ་ཐམས་ཅད་དོ། །"]},{"type":"verse","number":20,"content":["ངས་དེ་དག་ནི་ཕ་རོལ་དགྲ་བོའི་ལག་དང་ཁོ་ཚོའི་སྲོག་སྙེག་མཁན་རྣམས་ཀྱི་ལག་པར་གཏད་ནས། དེ་དག་གི་བམ་རོ་ནི་ནམ་མཁའི་བྱ་དང་ས་སྟེང་གི་གཅན་གཟན་གྱི་ཟས་སུ་འགྱུར་རོ། །"]},{"type":"verse","number":21,"content":["ཡང་ངས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་དང་དེའི་འགོ་དཔོན་རྣམས་ཀྱང་དགྲ་བོའི་ལག་དང་ཁོ་ཚོའི་སྲོག་སྙེག་མཁན་གྱི་ལག་དང་། རེ་ཞིག་ཁྱོད་རྣམས་དང་བྲལ་བའི་པཱ་པེལ་ལོན་རྒྱལ་པོའི་དམག་དཔུང་གི་ལག་ཏུ་གཏོད་པར་བྱའོ། །"]},{"type":"verse","number":22,"content":["ལྟོས་ཤིག ངས་དེ་དག་ལ་བཀའ་བཀོད་ནས་སླར་ཡང་གྲོང་ཁྱེར་འདིར་དྲངས་ཏེ། གྲོང་ཁྱེར་འདི་ལ་འཐབ་ནས་བླངས་ཏེ་མེས་བསྲེག་པར་འགྱུར་ལ། ཡང་ངས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་ནི་ས་སྟོང་ལུང་སྟོང་དུ་འགྱུར་བར་བྱས་ནས། སྡོད་མཁན་མི་གཅིག་ཀྱང་མེད་པར་བྱའོ་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]}],"footnotes":[{"noteId":11,"caller":"+","text":"འདིར་བ་ཕྲུག་དུམ་བུ་གཉིས་སུ་གཤགས་ཞེས་པ་ནི་སྐབས་དེའི་མི་རྣམས་ཀྱིས་ཕན་ཚུན་བར་དམ་བཅའ་འཇོག་དུས་སུ་ཕྱུགས་གང་རུང་དུམ་བུ་གཉིས་སུ་གཤགས་ནས་དམ་བཅའ་འཇོག་མཁན་ཕྱོགས་གཉིས་ཀ་དུམ་བུ་གཉིས་ཀྱི་བར་ནས་རྒྱུ་ཞིང་། སུ་ཞིག་དམ་བཅའ་དང་འགལ་བ་ཡིན་ན་ཕྱུགས་དེའི་རང་བཞིན་ཡིན་པ་མཚོན།","reference":{"chapter":34,"verse":18}}]},"thisChapterLink":"/api/bod_ntb/JER/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}