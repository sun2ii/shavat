{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":4,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་ལ་འགྱོད་བཤགས་བྱེད་པར་བསྐུལ་བ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཡེས་ར་ཨེལ། གལ་ཏེ་ཁྱོད་ཕྱིར་ལོག་ན་བདག་གི་ཕྱོགས་སུ་ལོག་དགོས་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །བདག་གི་མིག་མདུན་ནས་ཁྱོད་ཀྱི་ཞེན་ཁ་ལོག་པའི་སྐུ་འདྲ་མེད་པར་བཟོས་ཏེ་ལོག་ལམ་དུ་མི་འགྲོ་ཞིང་།"]},{"type":"verse","number":2,"content":["བདེན་པ་དང་དྲང་གཞག དྲང་བདེན་བཅས་ལ་བརྟེན་ནས། གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་ན། མི་རིགས་ཐམས་ཅད་ལ་ཁོང་ནས་བྱིན་རླབས་འཐོབ་ཅིང་། ཁོང་གི་རྐྱེན་གྱིས་གཟི་བརྗིད་འཐོབ་པར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཧུ་དཱ་པ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་ལ་འདི་སྐད་དུ། ཁྱོད་ཚོས་རང་ཉིད་ཀྱི་ཆེད་དུ་ས་རྒོད་བཏོད་དགོས་ཤིང་། ས་བོན་ཚེར་མའི་གསེང་དུ་མ་འདེབས་ཤིག"]},{"type":"verse","number":4,"content":["ཡ་ཧུ་དཱ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས། ཁྱོད་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་རང་གི་མཚན་སྐྱི་གཅོད་དགོས་ཏེ། སེམས་ནང་གི་མི་གཙང་བ་རྣམས་མེད་པར་བཟོས་ཤིག དེ་ལྟར་མིན་ཚེ། ཁྱོད་ཚོའི་ངན་སྤྱོད་ཀྱི་རྐྱེན་གྱིས་བདག་གི་ཁོང་ཁྲོ་མེ་ལྟར་འབར་ཞིང་། མི་སུས་ཀྱང་དེ་ཞི་བར་བྱེད་མི་ནུས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་རུ་སྒྲོགས་ལ་ཡེ་རུ་སཱ་ལེམ་དུ་ཁྱབ་བསྒྲགས་བྱས་ཏེ་ན་རེ། ཡུལ་ཁམས་ཀྱི་ནང་དུ་རྭ་དུང་བུས་ཤིག སྐད་ཆེན་པོས་འདི་ལྟར། རང་ཅག་མཁར་བརྟན་པོ་རྣམས་སུ་འགྲོ་བའི་ཆེད་དུ་ཕྱོགས་གཅིག་ཏུ་འདུས་ཤིག་ཅེས་སྨྲ་བར་གྱིས།"]},{"type":"verse","number":6,"content":["ཡང་ཛ་ཡན་གྱི་ཕྱོགས་སུ་དར་ཆེན་བསྒྲེངས་ནས་ཕྲོས་ཤིག བདག་གིས་ཆག་སྒོ་དང་འཇིགས་པ་ཆེན་པོ་བྱང་ཕྱོགས་ནས་སླེབ་ཏུ་འཇུག་རྒྱུ་ཡིན་པས་དུས་འགྱངས་མ་བྱེད་ཅིག"]},{"type":"verse","number":7,"content":["སེང་གེ་ནི་ནགས་ཚལ་སྟུག་པོ་ནས་ཡར་ཐོན་ཞིང་དེ་ནི་ཡུལ་ཁམས་རྣམས་མེད་པར་བཟོ་མཁན་ཡིན་ལ། དེ་རང་གནས་དང་བྲལ་ནས་ཡོང་བཞིན་པ་དང་ཁྱོད་ཀྱི་ཡུལ་སྟོངས་སུ་འཇུག་ལ། ཁྱོད་ཀྱི་གྲོང་ཁྱེར་དག་རྡུལ་དུ་བརླགས་ནས་མི་གཅིག་ཀྱང་ལུས་པར་མི་བྱའོ། །"]},{"type":"verse","number":8,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་རྐེད་པར་རྩིད་རས་གཡོགས་ལ་ངུ་འབོད་བྱོས་དང་། ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་ནི་རང་ཅག་དང་མ་བྲལ་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དུས་དེར། རྒྱལ་པོ་དང་འགོ་དཔོན་དག་གི་སེམས་དཔའ་ཞུམ་པར་འགྱུར་ལ། མཆོད་དཔོན་དག་ཧ་ལས་ཤིང་ལུང་སྟོན་པ་རྣམས་ཀྱང་ངོ་མཚར་བར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":10,"content":["དེ་ནས་ངས་འདི་ལྟར། ཅི་འདྲའི་སྐྱོ་བ་ལ། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་མི་འདི་རྣམས་དང་ཡེ་རུ་སཱ་ལེམ་ལ་མགོ་སྐོར་ཆེན་པོ་བཏང་སྟེ་འདི་སྐད་དུ། ཁྱོད་རྣམས་བདེ་བར་འགྱུར་ཞེས་གསུངས་མོད། དོན་དམ་དུ་སྲོག་གི་སྟེང་ལ་རལ་གྲི་བབས་ཡོད་ཅེས་ཞུས་པ་ཡིན།"]},{"type":"verse","number":11,"content":["དེའི་ཚེ་མི་འདི་རྣམས་དང་ཡེ་རུ་སཱ་ལེམ་ལ་འདི་སྐད་གསུང་བར་འགྱུར། དབེན་སྟོང་གི་སྐྱ་ཐེར་ཐེར་གྱི་མཐོ་སྒང་ལས་ཚ་རླུང་བདག་གི་མི་རྣམས་ཀྱི་བུ་མོའི་ཕྱོགས་སུ་གཡུགས་འོང་སྟེ། སྙིགས་མ་ཡར་ཕྱར་བའི་དོན་དུ་མ་ཡིན་ལ་གཙང་མར་བཟོ་བའི་དོན་དུའང་མ་ཡིན་ནོ། །"]},{"type":"verse","number":12,"content":["ཡང་དེ་ལས་ཆེ་བའི་རླུང་ནི་བདག་གི་ཕྱོགས་སུ་གཡུགས་འོང་སྟེ། ད་ལྟ་བདག་གིས་ཁྲིམས་གཅོད་བསྒྲགས་ནས་དེ་དག་ལ་རྒོལ་བར་བྱའོ་ཟེར།"]},{"type":"verse","number":13,"content":["ལྟོས་ཤིག དེ་ནི་སྤྲིན་བཞིན་དུ་ཡར་རྒྱས་ཤིང་། དེའི་ཤིང་རྟ་ནི་རླུང་འཚུབ་དང་འདྲ། དེའི་རྟ་རྣམས་ནི་གླག་ལས་ཀྱང་མགྱོགས་པས། ངེད་ཅག་ལ་ཆག་སྒོ་འབྱུང་ཞིང་ངེད་རྣམས་ཉམས་པར་གྱུར།"]},{"type":"verse","number":14,"content":["ཀྱེ་ཡེ་རུ་སཱ་ལེམ་ལགས། ཁྱོད་ལ་ཐར་པ་འཐོབ་ཕྱིར་ཁྱོད་ཀྱིས་རང་སེམས་ཀྱི་ངན་པ་དེ་ཁྲུས་ཤིག ངན་སེམས་ཁྱོད་ཀྱི་ནང་དུ་དུས་ག་ཚོད་ལ་འདུག་གམ།"]},{"type":"verse","number":15,"content":["སྒྲ་ཞིག་དཱན་ལས་གྲགས་འོང་ཞིང་། ཆག་སྒོ་ཨེ་ཕཱར་ཡིམ་གྱི་རི་ནས་ཀུན་ལ་བསྒྲག་འོང་།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱིས་མི་རིགས་ཐམས་ཅད་ལ་བསྒྲགས་ནས་ཡེ་རུ་སཱ་ལེམ་ལ་འདི་ལྟར། འགོག་རྒོལ་བྱེད་པའི་མི་ནི་རྒྱང་རིང་ནས་ཡོང་སྟེ་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ལ་ངར་སྐད་སྒྲོག་པ་དང་།"]},{"type":"verse","number":17,"content":["དེ་དག་གིས་ས་ཞིང་སྲུང་མཁན་དང་འདྲ་བར་ཡེ་རུ་སཱ་ལེམ་ཕྱོགས་བཞི་ནས་བསྐོར་བ་ཡིན། ཅི་ལ་ཞེ་ན། དེས་བདག་ལ་རྒྱབ་འགལ་བྱས་པ་ཡིན་ཞེས་ཤོད་ཅིག་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱི་ཅི་བྱས་དང་སྤྱོད་ཚུལ་གྱིས་དོན་འདི་དག་བྱུང་དུ་བཅུག་ལ། འདི་ནི་ཁྱོད་ཀྱི་སྡིག་པའི་མཇུག་འབྲས་ཡིན་ཏེ། དངོས་གནས་སྡུག་བསྔལ་ཆེ་ཞིང་ཁྱོད་ཀྱི་སེམས་ལ་ཕོག་གོ །"]},{"type":"heading","content":["ཡེ་རེམ་ཡཱ་ཡིས་སྤུན་ཟླ་རྣམས་ལ་སེམས་ཁུར་བྱས་པ།"]},{"type":"verse","number":19,"content":["ཀྱེ་ང་ཡི་སེམས། ང་ཡི་སེམས་ལགས། ངའི་སེམས་ཤིན་ཏུ་སྐྱོ་སྟེ། ངའི་སེམས་ངའི་ནང་དུ་འཚབ་ནས་མི་བདེ་ཞིང་། ང་ཁ་རོག་སྡོད་མི་ནུས་ཏེ། ཅི་ལ་ཞེ་ན། ངས་རྭ་དུང་གི་སྐད་དང་དམག་འཐབ་པའི་སྒྲ་ཐོས་པ་ཡིན།"]},{"type":"verse","number":20,"content":["ས་གཞི་ཡོངས་སུ་གཏོར་བརླག་ཐེབས་པས་མེད་པར་བཟོ་བའི་བརྡ་ནི་བསྟུད་མར་ཐོས་ཡོང་ཞིང་། བདག་གི་གུར་ཡང་གློ་བུར་རྩ་མེད་བཏང་བ་དང་། བདག་གི་ཡོལ་བ་གཤགས་པར་གྱུར།"]},{"type":"verse","number":21,"content":["བདག་གིས་དར་ཆེན་མཐོང་ནས་རྭ་དུང་གི་སྐད་ཐོས་ཏེ་ནམ་ཞིག་གི་བར་དུ་སླེབ་བམ།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། བདག་གི་མི་རྣམས་ནི་གླེན་ཞིང་ཨུ་ཚུགས་ཆེ་ལ་ང་རང་ངོ་མི་ཤེས་ཏེ། དེ་དག་ནི་བླུན་རྨོངས་གོ་མེད་ཅན་གྱི་བུ་ཡིན་ཞིང་། ངན་པ་སྤྱོད་པར་ཤེས་རབ་ལྡན་ཞིང་། བཟང་པོ་སྤྱོད་པར་ཤེས་བྱ་མེད་དོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":23,"content":["ངས་ས་གཞིར་བལྟས་པ་དང་། ཀྱེ་ཧོ། ས་གཞི་ནི་སྟོངས་ཤིང་གོ་རིམ་མེད་པ་དང་། ངས་ནམ་མཁར་བལྟས་པ་ལ། ནམ་མཁའ་ཡང་འོད་དང་བྲལ།"]},{"type":"verse","number":24,"content":["ངས་རི་བོ་རྣམས་ལ་བལྟས་པ་དང་། ཀྱེ་ཧོ། དེ་དག་འདར་ཞིང་རི་སྒང་ཐམས་ཅད་ཀྱང་རབ་ཏུ་གཡོ་བཞིན་འདུག"]},{"type":"verse","number":25,"content":["ངས་བལྟས་པ་ན། ཀྱེ་ཧོ། མི་གཅིག་ཀྱང་མི་འདུག ནམ་མཁའི་བྱ་ཐམས་ཅད་ཀྱང་ཡིབ་ནས་འདུག"]},{"type":"verse","number":26,"content":["ངས་བལྟས་པ་ན། ཀྱེ་ཧོ། ས་ཞིང་གཤིན་པོ་དེ་དབེན་སྟོང་དུ་གྱུར་ཅིང་། གྲོང་ཁྱེར་ཐམས་ཅད་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་ཁྲོས་པས་ན་ཁོང་གི་དྲུང་དུ་མེད་པར་བཟོས་པའོ། །"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཡུལ་ཁམས་ཐམས་ཅད་སྟོངས་པར་འགྱུར་ངེས། ཡིན་ཡང་བདག་གིས་ཐམས་ཅད་རྩ་མེད་དུ་མི་གཏོང་།"]},{"type":"verse","number":28,"content":["དེ་བས། ས་གཞིས་མྱ་ངན་བྱེད་པ་དང་། ནམ་མཁའ་ལ་ཡང་མུན་ནག་འཐིབ་པར་འགྱུར། ཅི་ལ་ཞེ་ན། བདག་ནི་ཅི་ཞིག་སྨྲས་པར་འགྱོད་པ་མེད་ལ། སེམས་ཐག་བཅད་པས་ནམ་ཡང་འགྱུར་བ་མེད་ཅེས་གསུངས་པས་སོ། །"]},{"type":"verse","number":29,"content":["གྲོང་ཁྱེར་སོ་སོའི་མི་རྣམས་ནི་རྟ་དམག་དང་མདའ་པ་རྣམས་ཀྱི་ཀི་སྒྲའི་རྐྱེན་གྱིས་གང་སར་འབྲོ་བ་སྟེ། ནགས་ཚལ་སྟུག་པོའི་ནང་དུ་འཛུལ་ནས་བྲག་ལ་འཛེགས་པ་དང་། གྲོང་ཁྱེར་རྣམས་ཀྱང་སྤངས་ནས་དེ་རུ་སྡོད་མཁན་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":30,"content":["ཀྱེ་རྡུལ་དུ་བརླག་པར་འགྱུར་བ་ཁྱོད་ཀྱིས་ཅི་བྱེད་དམ། ཁྱོད་ཀྱིས་གོས་རྒྱ་ཚོས་ཅན་གྱོན་ཞིང་གསེར་གྱི་རྒྱན་ཆ་བཏགས་ནས། མིག་རྩི་བསྐུས་ཏེ་མིག་མཛེས་པར་བྱེད་པ་དང་། རང་ཉིད་ཡག་པར་རློམ་ནའང་ངལ་བ་དོན་མེད་ཡིན་ཏེ། ཁྱོད་ལ་ཡིད་སྨོན་བྱེད་མཁན་གྱིས་ཁྱོད་ལ་མཐོང་ཆུང་བྱས་ནས་ཁྱོད་ཀྱི་སྲོག་འཚོལ་བའོ། །"]},{"type":"verse","number":31,"content":["བདག་གིས་བུད་མེད་ཅིག་ལ་གཟེར་རྒྱག་པའི་སྐད་ལྟ་བུ་དང་། ཕྲུ་གུ་སྐྱེས་འགོ་བཙའ་བའི་འཁུན་སྒྲ་ལྟ་བུ་ཞིག་ཐོས་བྱུང་། དེ་ནི་ཛ་ཡན་གྱི་བུ་མོའི་སྐད་ཡིན་ལ། མོས་དབུགས་རིང་འཐེན་ཏེ་ལག་པ་བརྐྱངས་ནས། ང་ལ་ཆག་སྒོ་འབྱུང་། མི་གསོད་རྣམས་ཀྱི་མདུན་དུ་ངའི་སེམས་ཀྱི་དྲན་པ་ཉམས་སོང་ཞེས་ཟེར་གྱིན་འདུག"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}