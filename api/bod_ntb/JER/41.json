{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":["དེ་ཡང་ཟླ་བ་བདུན་པར་རྒྱལ་པོའི་བློན་ཆེན་ཏེ། རྒྱལ་རྒྱུད་ཨེ་ལི་ཤཱ་མའི་ཚ་བོའམ། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་བྱ་བས་མི་བཅུ་ཁྲིད་དེ་མཱས་ཟི་ཕཱ་རུ་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱའི་རྩར་འོངས་ནས། དེ་དག་གིས་མཱས་ཟི་ཕཱ་རུ་མཉམ་དུ་ཁ་ཟས་རོལ་བ་དང་།"]},{"type":"verse","number":2,"content":["དེ་ནས་ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་དང་། ཁོ་དང་མཉམ་དུ་ཡོང་བའི་མི་བཅུ་པོ་དེ་ལངས་ནས། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོས་ཡུལ་ཁམས་ཀྱི་སྤྱི་དཔོན་དུ་བཞག་པའི་ཤཱ་ཕན་གྱི་ཚ་བོའམ། ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱ་རལ་གྲིས་བཀུམ་མོ། །"]},{"type":"verse","number":3,"content":["ཡང་ཡེས་མ་ཨེལ་གྱིས་གེ་དལ་ཡཱ་དང་མཉམ་དུ་མཱས་ཟི་ཕཱ་རུ་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་དང་། དེར་ཡོད་པའི་ཀལ་དི་པ་དག་དང་དམག་རྣམས་ཀྱང་བསད་དོ། །"]},{"type":"verse","number":4,"content":["ཁོས་གེ་དལ་ཡཱ་བསད་པའི་ཉིན་གསུམ་པ་སྟེ། མི་སུས་ཀྱང་མི་ཤེས་པའི་དུས་སུ།"]},{"type":"verse","number":5,"content":["མི་བརྒྱད་ཅུ་ནི་སི་ཀེམ་དང་། ཞི་ལོ་དང་། སཱ་མར་ཡ་བཅས་ནས་འོངས་པ་དང་། སྨ་ར་བཞར་ཏེ་གོས་བཤགས་ནས། རང་ལ་རྨ་ཕྱུང་",{"noteId":13},"སྟེ་འབྲུ་མཆོད་དང་སྤོས་དཀར་ལག་ཏུ་བཟུང་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ལ་འབུལ་དུ་འོང་བ་སྟེ།"]},{"type":"verse","number":6,"content":["ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་ནི་དེ་དག་ལ་བསུ་རུ་མཱས་ཟི་ཕཱ་ནས་ཐོན་ཏེ། ངུ་ཞོར་འགྲོ་ཞོར་དེ་དག་དང་ཕྲད་ནས་ན་རེ། ཁྱོད་རྣམས་ནི་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱའི་དྲུང་དུ་ཤོག་དང་ཞེས་པ་དང་།"]},{"type":"verse","number":7,"content":["དེ་རྣམས་གྲོང་ཁྱེར་གྱི་དབུས་སུ་ཕྱིན་པའི་ཚེ། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་དང་དེ་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་ཀྱིས་དེ་ཚོ་བསད་ནས་དོང་ནང་དུ་གཡུགས་སོ། །"]},{"type":"verse","number":8,"content":["ཡིན་ཡང་དེ་རྣམས་ལས་མི་བཅུ་ཡིས་ཡེས་མ་ཨེལ་ལ་འདི་ལྟར། ངེད་ཅག་གིས་ཞིང་ཁར་སོ་བ་དང་གྲོ་དང་། སྣུམ་དང་། སྦྲང་རྩི་སོགས་སྦས་ཡོད་པས་ངེད་ཅག་མ་གསོད་ཅིག་ཞུས་པ་ན། ཡེས་མ་ཨེལ་གྱིས་དེ་དག་སྤུན་ཟླ་རྣམས་དང་མཉམ་དུ་མ་བསད་པར་བསྐྱུར་བ་རེད།"]},{"type":"verse","number":9,"content":["ཡེས་མ་ཨེལ་གྱིས་བསད་པའི་མི་རྣམས་ཀྱི་བེམ་པོ་གེ་དལ་ཡཱའི་རྩར་གཡུགས་པ་དང་། དོང་འདི་ནི་སྔར་རྒྱལ་པོ་ཨ་སཱ་བྱ་བ་དེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་པཱ་ཤ་ལ་སྐྲག་ནས་བརྐོས་པ་ཡིན་ལ། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་བེམ་པོ་ཡིས་དོང་དེ་བཀང་བར་བྱས།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཡེས་མ་ཨེལ་གྱིས་མཱས་ཟི་ཕཱ་རུ་ལུས་པའི་མི་རྣམས་ཏེ། རྒྱལ་པོའི་སྲས་མོ་རྣམས་དང་མཱས་ཟི་ཕཱ་རུ་གནས་པའི་མི་སྡེ་ཐམས་ཅད་བཙོན་དུ་ཁྲིད་དོ། །དེ་དག་ནི་སྔར་སྐུ་སྲུང་དམག་དཔོན་ནེ་བོ་ཟར་ཨ་དན་གྱིས་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱ་ལ་བཅོལ་བ་ཡིན་ཏེ། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་དེ་རྣམས་བཙོན་དུ་ཁྲིད་ནས། ཨམ་མོན་པའི་རྩར་འགྲོ་བར་བརྩམས།"]},{"type":"verse","number":11,"content":["ཀཱ་རེ་ཨའི་བུ་ཡོ་ཧ་ནན་དང་། དེ་དང་མཉམ་དུ་ཡོད་པའི་དམག་དཔོན་རྣམས་ཀྱིས་ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་སྤྱད་པའི་ངན་སྤྱོད་ཐམས་ཅད་ཐོས་པ་དང་།"]},{"type":"verse","number":12,"content":["མི་རྣམས་ཁྲིད་ནས་ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་དང་འཐབ་ཏུ་སོང་བ་ལ། གིབ་ཡོན་གྱི་ཆུ་ཆེན་འགྲམ་དུ་དེ་དང་ཕྲད།"]},{"type":"verse","number":13,"content":["ཡང་ཡེས་མ་ཨེལ་དང་མཉམ་དུ་ཡོད་པའི་མི་རྣམས་ཀྱིས་ཀཱ་རེ་ཨའི་བུ་ཡོ་ཧ་ནན་དང་། དེ་དང་ལྷན་ཅིག་ཏུ་ཡོད་པའི་དམག་དཔོན་རྣམས་མཐོང་ནས་སེམས་དགའ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":14,"content":["དེ་ལྟར་ཡེས་མ་ཨེལ་གྱིས་མཱས་ཟི་ཕཱ་ནས་བཙོན་དུ་ཁྲིད་པའི་མི་ཐམས་ཅད་ཁ་ཕྱིར་འཁོར་ནས་ཀཱ་རེ་ཨའི་བུ་ཡོ་ཧ་ནན་གྱི་དྲུང་དུ་ཕྱིན་ཏོ། །"]},{"type":"verse","number":15,"content":["ཡང་ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་ནི་མི་བརྒྱད་དང་བཅས་ཡོ་ཧ་ནན་གྱི་ལག་ནས་ཐར་ཏེ་ཨམ་མོན་པའི་རྩར་བྲོས་སོ། །"]},{"type":"verse","number":16,"content":["ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱ་བསད་དེ། མཱས་ཟི་ཕཱ་རུ་ལུས་པའི་མི་རྣམས་དང་། དམག་མི་དང་། བུད་མེད་དང་། བྱིས་པ་དང་། ཉུག་རུམ་པ་དང་བཅས་གིབ་ཡོན་དུ་བཙོན་ལ་ཁྲིད་པའི་རྗེས་སུ། ཀཱ་རེ་ཨའི་བུ་ཡོ་ཧ་ནན་དང་དེ་དང་མཉམ་དུ་ཡོད་པའི་དམག་དཔོན་དག་གིས་དེ་རྣམས་ཕྱིར་ཕྲོགས་ཏེ།"]},{"type":"verse","number":17,"content":["ཨེ་ཅིབ་ཡུལ་དུ་འགྲོ་བར་པེད་ལེ་ཧེམ་གྱི་གེ་ལོ་ཐུ་ཀིམ་ཧམ་དུ་བསྡད་དོ། །"]},{"type":"verse","number":18,"content":["ཅི་ལ་ཞེ་ན། ནེ་ཐན་ཡཱའི་བུ་ཡེས་མ་ཨེལ་གྱིས་པཱ་པེལ་ལོན་རྒྱལ་པོས་ཡུལ་ཁམས་ཀྱི་སྤྱི་དཔོན་དུ་བསྐོས་པའི་ཨ་ཧི་ཀམ་གྱི་བུ་གེ་དལ་ཡཱ་བསད་པའི་རྐྱེན་གྱིས་དེ་དག་ཀལ་དི་པ་ལ་འཇིགས་པས་སོ། །"]}],"footnotes":[{"noteId":13,"caller":"+","text":"འདིར་སྨ་ར་བཞར་ཏེ་གོས་བཤགས་ནས། རང་ལ་རྨ་ཕྱུང་ཞེས་པ་ནི་མྱ་ངན་ཆེན་པོ་བྱེད་པའི་རྟགས་ཡིན།","reference":{"chapter":41,"verse":5}}]},"thisChapterLink":"/api/bod_ntb/JER/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/40.json","previousChapterAudioLinks":{},"numberOfVerses":18}