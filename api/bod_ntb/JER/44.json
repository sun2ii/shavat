{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":44,"content":[{"type":"heading","content":["ཨེ་ཅིབ་ཡུལ་དུ་འཁྱམ་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འཕྲིན་བསྐུར་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨེ་ཅིབ་ཡུལ་ཏེ། མིག་དོལ་དང་ཐ་ཕན་ཧེ་སི། ནོབ། ཕཱད་རུའུ་སི་བཅས་ཡུལ་འཁོར་དུ་སྡོད་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱི་ཕྱིར་དུ། ཡེ་རེམ་ཡཱ་ལ་བྱུང་བའི་བཀའ་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ངས་ཡེ་རུ་སཱ་ལེམ་དང་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་ཀྱི་སྟེང་དུ་ཕབ་པའི་ཆག་སྒོ་ཐམས་ཅད་ཁྱོད་ཚོས་མཐོང་བ་ཡིན་ལ། ལྟོས་ཤིག གྲོང་ཁྱེར་དེ་རྣམས་དེ་རིང་གི་བར་དུ་ཞིག་རོར་ལུས་ནས་འདུག་མཁན་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":3,"content":["དེ་ནི་མི་རྣམས་ཀྱིས་སྤྱོད་ངན་སྤྱད་པའི་རྐྱེན་གྱིས་ཡིན་ལ། ཁོ་ཚོས་ལྷ་གཞན་རྣམས་ཏེ་ཁོ་ཚོ་དང་ཁྱོད་ཅག དེ་མིན་ཁྱོད་ཅག་གི་ཕ་མེས་རྣམས་ལ་རྒྱུས་མི་མངའ་བའི་ལྷ་རྣམས་ལ་སྤོས་བདུགས་པ་དང་ཞབས་ཏོག་བསྒྲུབས་ནས་ང་ལ་ཁོང་ཁྲོ་བསླངས།"]},{"type":"verse","number":4,"content":["ངས་རང་གི་ཞབས་ཕྱི་ལུང་སྟོན་པ་ཀུན་ཡང་ཡང་ཁྱོད་ཅག་གི་གམ་དུ་མངགས་ནས་འདི་ལྟར། ཁྱོད་ཚོས་ང་ཞེ་མེར་ཞིང་སྡང་བའི་དོན་འདི་མ་བྱེད་ཅིག་ཅེས་བསྒོས་ནའང་།"]},{"type":"verse","number":5,"content":["དེ་དག་གིས་མ་མཉན་ཏེ། རྣ་བ་གཏད་ནས་མ་མཉན་ལ། རང་གི་ངན་སྤྱོད་ལས་ཀྱང་ཕྱིར་མ་འཁོར་བར་སྔར་བཞིན་ལྷ་གཞན་རྣམས་ལ་སྤོས་བདུགས་པས།"]},{"type":"verse","number":6,"content":["ངའི་ཁོང་ཁྲོ་དང་ཁྲོ་གཏུམ་བླུགས་ཤིང་། ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་སྲང་ལམ་དུ་མེ་ལྟར་འབར་བས། དེ་རིང་གི་ཉིན་མོ་ལྟར་དེ་དག་བཤིག་ནས་ཞིག་རོར་བྱས་སོ་ཞེས་གསུངས།"]},{"type":"verse","number":7,"content":["ད་ལྟ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ཁྱོད་ཅག་གིས་སྤྱོད་ངན་འདི་དག་སྤྱད་ནས་རང་ཉིད་བརླགས་ཏེ། ཁྱོད་ཅག་གི་སྐྱེས་པ་རྣམས་དང་བུད་མེད་རྣམས། བྱིས་པ་རྣམས། འོ་འཐུང་དང་བཅས་ཡ་ཧུ་དཱ་ནས་མེད་པར་བྱས་ཏེ་གཅིག་ཀྱང་མི་ལུས་པར་བྱེད་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":8,"content":["ཁྱོད་ཅག་གིས་རང་གི་ལག་པས་བཟོས་པ་ཡིས་བྱེས་སུ་སྡོད་པའི་ཨེ་ཅིབ་ཡུལ་དུ་ལྷ་གཞན་རྣམས་ལ་སྤོས་བདུགས་ནས་ང་ཁྲོ་བར་བཅུག་སྟེ། ཁྱོད་རྣམས་མེད་པར་བཟོས་པ་དང་། ས་སྟེང་གི་ཡུལ་ཁམས་ཐམས་ཅད་དུ་དམོད་པ་དང་སྨད་ར་གཏོང་བའི་གཞི་རུ་གྱུར་ཏོ། །"]},{"type":"verse","number":9,"content":["ཡ་ཧུ་དཱའི་ཡུལ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་སྲང་ལམ་རྣམས་སུ་སྤྱད་པའི་སྤྱོད་ངན་ཏེ། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱི་སྤྱོད་ངན་དང་། ཡ་ཧུ་དཱའི་རྒྱལ་པོ་དག་དང་བཙུན་མོ་རྣམས་ཀྱི་སྤྱོད་ངན། ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་ཆུང་མ་རྣམས་ཀྱི་སྤྱོད་ངན་རྣམས་ཁྱོད་རྣམས་ཀྱིས་བརྗེད་སོང་ངམ།"]},{"type":"verse","number":10,"content":["དེ་རིང་གི་བར་དུ་ཁོ་རྣམས་ད་དུང་བློ་འགྱོད་མ་སྐྱེས་ཤིང་། འཇིགས་ཀྱང་མ་འཇིགས་ལ། ངས་ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་མེས་པོའི་མདུན་དུ་བཞག་པའི་བཀའ་ཁྲིམས་དང་སྒྲིག་སྲོལ་རྣམས་མ་བརྩིས་པས།"]},{"type":"verse","number":11,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཁྱོད་རྣམས་ལ་ཆག་སྒོ་འབྱུང་བར་བྱས་ཏེ་ཡ་ཧུ་དཱ་པ་རྣམས་མེད་པར་བཟོ་བའི་སེམས་ཐག་བཅད་ཟིན་ཏོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཨེ་ཅིབ་ཡུལ་དུ་འགྲོ་བར་ཐག་བཅད་པ་དང་དེ་རུ་བྱེས་སུ་སྡོད་པའི་མི་སྟེ། ཤུལ་དུ་ལུས་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ངས་མེད་པར་བཟོ་བ་དང་། དེ་རྣམས་ནི་ཨེ་ཅིབ་ཡུལ་དུ་མེད་པར་འགྱུར་རོ། །རལ་གྲི་དང་མུ་གེའི་རྐྱེན་གྱིས་རྩ་མེད་དུ་འགྲོ་བ་དང་། མཆོག་དམན་སུ་ཡིན་ཡང་རལ་གྲི་དང་མུ་གེ་ལས་འཆི་བར་འགྱུར་ལ། ཐ་ན་ངན་སྨྲས་དང་འཇིགས་སྐྲག དམོད་མོ། ངོ་ཚ་བཅས་ཐེབས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ངས་ཇི་ལྟར་རལ་གྲི་དང་མུ་གེ་དང་རིམས་ནད་བཅས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་ལ་ཉེས་ཆད་བཅད་པ་ཡིན་ན། ཨེ་ཅིབ་ཡུལ་དུ་སྡོད་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ལའང་དེ་ལྟར་ཉེས་ཆད་གཅོད་ངེས་ཡིན།"]},{"type":"verse","number":14,"content":["ཨེ་ཅིབ་ཡུལ་དུ་སོང་ནས་དེ་རུ་སྡོད་པའི་མི་སྟེ་ཡ་ཧུ་དཱ་པ་ཤུལ་ལུས་རྣམས་ནི་སུ་ཡང་ཐར་མི་ཐུབ་ལ་གསོན་པོར་ཡང་མི་ལུས་ཏེ། ཁོ་རྣམས་ཡ་ཧུ་དཱའི་ཡུལ་དུ་ཕྱིར་ལོག་མི་ནུས་སོ། །དེ་དག་གི་སེམས་སུ་ཕྱིར་ལོག་ནས་དེ་རུ་འདུག་འདོད་ཀྱང་། བྲོས་ནས་ཐར་བའི་མི་འགའ་རེ་མ་གཏོགས་གཞན་སུ་ཡང་ཕྱིར་ལོག་མི་ནུས་ཞེས་གསུངས་སོ་ཞེས་པའོ། །"]},{"type":"verse","number":15,"content":["དེ་ཡང་ཨེ་ཅིབ་ཀྱི་ཕཱད་རུའུ་སི་ཡུལ་དུ་སྡོད་པའི་མི་རྣམས་ཏེ། རང་གི་ཆུང་མས་ལྷ་གཞན་རྣམས་ལ་སྤོས་བདུགས་པ་ཤེས་པའི་སྐྱེས་པ་རྣམས་དང་དེར་ལངས་སྡོད་པའི་བུད་མེད་ཚོགས་ཀྱིས་མཉམ་དུ་ཡེ་རེམ་ཡཱ་ལ་ལན་བཟློགས་ནས་འདི་ལྟར།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་སྒོ་ནས་ངེད་ཅག་ལ་བསྒོས་པ་དེར་ངེད་རྣམས་ཀྱིས་མཉན་པར་མི་བྱ།"]},{"type":"verse","number":17,"content":["ངེད་རྣམས་ཀྱིས་རང་གི་ངག་ནས་ཐོན་པའི་ཚིག་བཞིན་བྱེད་ངེས་ཡིན་ཏེ། ནམ་མཁའི་རྒྱལ་མོར་སྤོས་བདུགས་ནས་སྐྱེམས་མཆོད་འབུལ་བ་དང་། ངེད་ཅག་དང་ངེད་ཅག་གི་ཕ་མེས་རྣམས། རྒྱལ་པོ་རྣམས། འགོ་དཔོན་བཅས་ཀྱིས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་སྲང་ལམ་དུ་ཅི་ལྟར་སྤྱད་པ་བཞིན་དུ་སྤྱོད་པར་འགྱུར་ཏེ། ཅི་ལ་ཞེ་ན། དེའི་དུས་སུ་ངེད་རྣམས་ལྟོ་བ་འགྲངས་ཤིང་བདེ་སྐྱིད་ལྡན་ལ། ཆག་སྒོ་ཅི་ཡང་མ་མཐོང་བས་སོ། །"]},{"type":"verse","number":18,"content":["འོན་ཀྱང་ངེད་རྣམས་ཀྱིས་ནམ་མཁའི་རྒྱལ་མོར་སྤོས་བདུག་པ་དང་སྐྱེམས་མཆོད་འབུལ་བ་མཚམས་བཞག་པའི་ཚུན་ལ། ངེད་རྣམས་ལ་ཅི་ཡང་མེད་པར་མ་ཟད། རལ་གྲི་དང་མུ་གེས་ཚར་བཅད་དོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["བུད་མེད་རྣམས་ན་རེ། ངེད་ཅག་གིས་ནམ་མཁའི་རྒྱལ་མོར་སྤོས་བདུགས་ནས་སྐྱེམས་མཆོད་ཕུལ་བ་དང་། ནམ་མཁའི་རྒྱལ་མོའི་རྟེན་གྱི་འཁུར་ར་བཟོས་ནས་དེར་ཕུལ་བ་དང་སྐྱེམས་མཆོད་ཕུལ་བ་ངེད་རྣམས་ཀྱི་སྐྱེས་པ་དག་གིས་མི་ཤེས་སམ་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":20,"content":["ཡེ་རེམ་ཡཱ་ཡིས་ཁོང་ལ་དེ་ལྟར་ལན་བཟློགས་པའི་སྐྱེས་པ་དང་བུད་མེད་ཡོངས་ལ་འདི་ལྟར།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་ཕ་མེས་དང་། རྒྱལ་པོ། འགོ་དཔོན། དེ་མིན་ཡུལ་མི་བཅས་ཀྱིས་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་དང་། ཡེ་རུ་སཱ་ལེམ་གྱི་སྲང་ལམ་རྣམས་སུ་སྤོས་བདུགས་པ་དཀོན་མཆོག་ཡ་ཝཱེས་ཐུགས་སུ་དྲན་ཞིང་དགོངས་པ་མ་ཡིན་ནམ།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཅག་གིས་སྤྱད་པའི་སྤྱོད་ངན་དང་ཞེ་མེར་བའི་དོན་རྣམས་ཀྱི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེས་ཐུགས་ནས་བཟོད་མ་ནུས་པས། དེ་རིང་ཉིན་མོ་ལྟར་ཁྱོད་ཅག་གི་ཡུལ་ཁམས་ཞིག་རོར་ལུས་པ་དང་། མི་རྣམས་འཇིགས་ཤིང་དམོད་མོ་འདེབས་པའི་གཞི་རུ་གྱུར་ཅིང་། སྡོད་མཁན་གཅིག་ཀྱང་མེད་པར་མཛད་དོ། །"]},{"type":"verse","number":23,"content":["ཁྱོད་ཚོས་སྤོས་བདུགས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འགལ་བའི་སྡིག་པ་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལའང་མ་མཉན་པར། ཁོང་གི་བཀའ་ཁྲིམས་དང་སྒྲིག་ལམ། དཔང་ཡིག་བཅས་བརྩི་སྲུང་མ་བྱས་པས། དེ་རིང་ཉིན་མོ་བཞིན་དུ་ཆག་སྒོ་འདི་ཁྱོད་ཅག་གི་སྟེང་དུ་བབས་པ་ཡིན་ནོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡེ་རེམ་ཡཱ་ཡིས་ཡང་མི་ཀུན་དང་བུད་མེད་རྣམས་ལ་འདི་ལྟར། ཨེ་ཅིབ་ཡུལ་དུ་གནས་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ལགས། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག"]},{"type":"verse","number":25,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་ཆུང་མ་རྣམས་ཀྱིས་ངག་ནས་སྨྲས་ཤིང་ལག་ནས་བསྒྲུབས་ཏེ་ན་རེ། ངེད་རྣམས་ཀྱིས་ནམ་མཁའི་རྒྱལ་མོར་སྤོས་བདུགས་ནས་སྐྱེམས་མཆོད་ཕུལ་ཏེ་དམ་བཅས་པ་དག་བསྒྲུབ་པར་བྱ་ཞེས་སྨྲས་པ་དང་། ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་རང་གི་དམ་བཅའ་བསྲུངས་ནས་དེ་བཞིན་སྒྲུབས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":26,"content":["ཨེ་ཅིབ་ཡུལ་དུ་གནས་པའི་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་རང་གི་མིང་ཆེན་པོ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་ཏེ། ཨེ་ཅིབ་ཡུལ་ཐམས་ཅད་དུ་ཡ་ཧུ་དཱ་པ་སུ་དང་སུ་ཡིས་ཀྱང་འདི་ལྟར། ངའི་གཏན་དུ་བཞུགས་པའི་གཙོ་བོ་ཡ་ཝཱེ་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་ལོ་ཞེས་ངའི་མིང་ལ་ཞུ་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":27,"content":["ལྟོས་ཤིག ངས་དེ་དག་ལ་ཆག་སྒོ་འབྱུང་བ་ལས་བྱིན་རླབས་མི་འཐོབ་པའི་ཕྱིར་དུ་དེ་དག་ལ་ལྟོས་ཡོད། ཨེ་ཅིབ་ཡུལ་དུ་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ནི་རལ་གྲི་དང་མུ་གེས་ཚར་བཅད་དེ་རྩ་མེད་དུ་གཏོང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":28,"content":["ཨེ་ཅིབ་ཡུལ་ནས་རལ་གྲི་ལས་ཐར་ཏེ་ཡ་ཧུ་དཱ་རུ་ལོག་པའི་མི་གྲངས་ནི་ཤིན་ཏུ་ཉུང་བ་ཡིན། ཨེ་ཅིབ་ཡུལ་དུ་སོང་ནས་བྱེས་སུ་སྡོད་པའི་མི་སྟེ། ཡ་ཧུ་དཱ་པ་ཤུལ་ལུས་ཐམས་ཅད་ཀྱིས་ངའི་བཀའ་འམ་ཡང་ན་ཁོ་ཚོའི་གཏམ་ལས་སུ་ཞིག་གི་ཚིག་བརྟན་པོར་ཚུགས་པ་རྟོགས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":29,"content":["ཡང་གནས་འདི་རུ་ངས་ཁྱོད་ཅག་ལ་ཉེས་ཆད་གཅོད་པར་བྱ་ཞིང་དེ་ནི་སྔ་ལྟས་ཡིན་ལ། ངས་ཁྱོད་ཅག་ལ་ཆག་སྒོ་འབེབ་རྒྱུ་ཡིན་པའི་བཀའ་དེ་བརྟན་པོར་ཚུགས་པ་ཁྱོད་ཅག་གིས་ཤེས་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":30,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོ་ཧོབ་རཱ་ཕཱར་ཨོལ་ནི་ཁོའི་དགྲ་དང་ཁོའི་སྲོག་སྙེག་མཁན་རྣམས་ཀྱི་ལག་ཏུ་གཏོད་ཅིང་། དེ་ནི་ངས་ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་ནི་ཁོའི་དགྲ་དང་ཁོའི་སྲོག་སྙེག་མཁན་པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱི་ལག་ཏུ་གཏད་པ་དང་འདྲའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/43.json","previousChapterAudioLinks":{},"numberOfVerses":30}