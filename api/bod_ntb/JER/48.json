{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":48,"content":[{"type":"heading","content":["མོ་ཨབ་སྐོར་གྱི་གཏམ།"]},{"type":"verse","number":1,"content":["མོ་ཨབ་ཀྱི་སྐོར་ལ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ནེ་བོ་ནི་སྟོང་བར་འགྱུར་བས་ཆག་སྒོ་འབྱུང་། ཀིར་ཡ་ཐཱ་ཡེམ་ནི་ངོ་ཚར་སྦྱར་ཏེ་བཙན་འཛིན་བྱེད་པར་འགྱུར་ལ། མཱེ་སི་ཀ་ནི་ངོ་ཚར་སྦྱར་ནས་མེད་པར་བཟོའོ། །"]},{"type":"verse","number":2,"content":["མོ་ཨབ་ལ་སླར་ཡང་བསྟོད་བསྔགས་མི་འབྱུང་སྟེ། ཧེ་སི་པོན་དུ་མི་ཡིས་གྲོས་ངན་བཏབ་ནས་དེ་ལ་གནོད་བསྐྱལ་ཞིང་ན་རེ། ཚུར་ཤོག་དང་ཡུལ་ཁམས་ཤིག་ཏུ་མི་ལུས་པའི་ཕྱིར་རང་ཅག་གིས་དེ་མེད་པར་བྱའོ་ཟེར་ཞིང་། ཀྱེ་མད་མེན་ན་ཁྱོད་ཀྱང་ཁུ་སིམ་པོར་བསྡད་དེ་རལ་གྲིས་ཁྱོད་འདེད་པར་འགྱུར།"]},{"type":"verse","number":3,"content":["ཧོ་རོ་ན་ཨིམ་ལས་སྟོངས་ཤིང་གཏོར་བརླག་ཐེབས་པའི་ངུ་སྐད་བྱུང་བ་དང་།"]},{"type":"verse","number":4,"content":["མོ་ཨབ་མེད་པར་བཟོས་ནས། དེའི་བྱིས་པ་རྣམས་ཀྱི་ངུ་སྐད་ནི་མི་ཡིས་ཐོས་སོ། །"]},{"type":"verse","number":5,"content":["མི་རྣམས་ལུ་ཧིད་ཀྱི་ལ་ངོས་སུ་ངུ་བཞིན་ཡར་འགྲོ་བ་སྟེ། ཅི་ལ་ཞེ་ན། ཧོ་རོ་ན་ཨིམ་གྱི་ལ་ཐུར་དུ་གཏོར་བརླག་ཐེབས་པའི་ངུ་སྐད་ཐོས་པས་སོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་སྲོག་ཐར་བར་ཕྲོས་ཤིག དབེན་སྟོང་གི་ཨ་རོ་ཨེར་ལྟར་གཅིག་པུར་ལུས་སོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་ནི་རང་གིས་ཅི་བྱས་པ་དང་རྒྱུ་ནོར་ལ་བརྟེན་པའི་དབང་གིས་གཞན་གྱིས་ལེན་པར་འགྱུར་ཏེ། ཀེ་མོ་སི་",{"noteId":14},"དང་དེའི་མཆོད་དཔོན་དང་འགོ་དཔོན་རྣམས་ཀྱང་བཙོན་དུ་འཁྲིད་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཅི་གསུངས་བཞིན་དུ། གཏོར་བརླག་གཏོང་མཁན་དེ་གྲོང་ཁྱེར་རེ་རེར་འོང་ཞིང་། གྲོང་ཁྱེར་གང་ཡང་ཐར་ས་མེད་པར་ལུང་པ་རྣམས་ཉམས་ཤིང་ཐང་ཆེན་རྣམས་བརླག་པར་འགྱུར་རོ། །"]},{"type":"verse","number":9,"content":["མོ་ཨབ་འཕུར་ནས་འགྲོ་བའི་ཕྱིར་དུ། ཁྱོད་ཅག་གིས་མོ་ལ་གཤོག་པ་སྤྲོད་ཅིག དེའི་གྲོང་ཁྱེར་རྣམས་སྟོང་བར་འགྱུར་ལ་མི་གཅིག་ཀྱང་སྡོད་པར་མི་འགྱུར།"]},{"type":"verse","number":10,"content":["སྒྱིད་ལུག་གི་དབང་དུ་སོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དོན་མི་བྱེད་པ་རྣམས་ལ་དམོད་མོ་ཐེབས་པ་དང་། རལ་གྲི་ལ་ཁྲག་འགོ་བར་མི་བྱེད་པ་དེ་ལའང་དམོད་མོ་ཐེབས་པར་འགྱུར།"]},{"type":"heading","content":["མོ་ཨབ་ཀྱི་གྲོང་ཁྱེར་གཏོར་བར་མཛད་པ།"]},{"type":"verse","number":11,"content":["མོ་ཨབ་ནི་ལོ་ན་གཞོན་དུས་ནས་སྐྱིད་པོར་བསྡད་དེ་བཙོན་དུའང་མ་ཕྱིན་ལ། སྙིགས་རོ་མ་དཀྲུག་པའི་རྒུན་ཆང་དྭངས་མོ་དང་འདྲ་ཞིང་། སྣོད་གཅིག་ལས་སྣོད་གཞན་དུ་བླུགས་མ་མྱོང་ལ་དེའི་བྲོ་བ་ལུས་ཤིང་དྲི་ཞིམ་ཡལ་མེད་དོ་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":12,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། ངས་དེའི་རྩར་ཆང་ལྡུག་མཁན་མངགས་ནས་དེ་བླུག་པར་འགྱུར་ལ། དེ་དག་གིས་སྣོད་རྣམས་སྟོང་བར་བྱས་ཏེ་རྫ་མ་རྣམས་གཅོག་པར་བྱའོ། །"]},{"type":"verse","number":13,"content":["སྔར་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་པེད་ཨེལ་ལ་བརྟེན་ཞིང་ངོ་ཚ་བར་གྱུར་པ་བཞིན་དུ། མོ་ཨབ་ཀྱང་ཀེ་མོ་སིའི་རྐྱེན་གྱིས་ངོ་ཚ་བར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་ངེད་ཅག་ནི་དཔའ་བོ་སྟེ། དམག་འཐབ་ལ་བྱང་བའི་དཔའ་བོ་ཡིན་ཟེར་བ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":15,"content":["མོ་ཨབ་ནི་དབེན་སྟོང་དུ་གྱུར་ཏེ། དགྲ་རྣམས་ཡར་སོང་ནས་དེའི་གྲོང་ཁྱེར་རྣམས་བཟུང་བ་དང་། དེའི་དར་མའི་མཆོག་རྣམས་མར་སོང་ནས་གསོད་པར་འགྱུར་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་མངའ་བའི་རྒྱལ་པོས་གསུངས་སོ། །"]},{"type":"verse","number":16,"content":["མོ་ཨབ་ཀྱི་ཆག་སྒོ་འབྱུང་ལ་ཉེ་སྟེ། དེའི་སྡུག་བསྔལ་ནི་མྱུར་བ་མྱུར་དུ་སླེབ་འོང་ངོ་། །"]},{"type":"verse","number":17,"content":["དེའི་མཐའ་འཁོར་དུ་གནས་པ་དང་དེའི་མིང་ལ་གསལ་ཆ་ཡོད་པ་རྣམས་ཀྱིས་དེའི་ཕྱིར་དུ་མྱ་ངན་བྱས་ནས། སྲ་བའི་དབྱུག་པ་དང་མཛེས་པའི་འཁར་བ་དེ་ཆག་བྱུང་ཞེས་སྨྲ་བར་འགྱུར།"]},{"type":"verse","number":18,"content":["ཀྱེ་དི་བོན་གྱི་བུ་མོ་ལགས། ཁྱོད་ནི་རང་གི་གཟི་བརྗིད་ཀྱི་བཞུགས་ཁྲི་ལས་མར་བོབས་ཤིག ཁ་སྐམ་ནས་སྡོད་ཅིག ཅི་ལ་ཞེ་ན། མོ་ཨབ་རྩ་མེད་དུ་གཏོང་མཁན་དེ་ཡར་འོངས་ནས་ཁྱོད་ལ་རྒོལ་ཞིང་ཁྱོད་ཀྱི་མཁར་བརྟན་པོ་རྣམས་གཏོར་བར་བྱེད།"]},{"type":"verse","number":19,"content":["ཀྱེ་ཨ་རོ་ཨེར་དུ་གནས་པ་རྣམས། ལམ་ཁར་ལངས་ནས་ལྟོས་ཤིག འབྲོ་བའི་སྐྱེས་པ་དང་ཐར་བའི་བུད་མེད་རྣམས་ལ་ཅི་ཞིག་བྱུང་ངམ་ཞེས་དྲིས་ཤིག"]},{"type":"verse","number":20,"content":["མོ་ཨབ་ལ་གཏོར་བརླག་ཐེབས་པས་ངོ་ཚར་སྦྱར་བ་དང་། ཁྱོད་ཅག་གིས་ངུ་སྐད་བཏོན་ལ་འུར་རྒྱོབ་ཅིག ཨར་ནོན་ཆུ་བོའི་འགྲམ་དུ་མོ་ཨབ་བརླགས་ཚར་ཞེས་སྒྲོགས་ཤིག"]},{"type":"verse","number":21,"content":["ཐང་ཆེན་གྱི་ཧོ་ལོན་དང་། ཡ་ཙཱ། མེ་ཕཱ་ཨད།"]},{"type":"verse","number":22,"content":["དི་བོན། ནེ་བོ། པེད་དིབ་ལ་ཐ་ཡིམ།"]},{"type":"verse","number":23,"content":["ཀིར་ཡ་ཐཱ་ཡེམ། པེད་ག་མུལ། པེད་མེ་ཨོན།"]},{"type":"verse","number":24,"content":["ཀེ་རི་ཨོད། པོ་ཚ་རཱ། མོ་ཨབ་ཡུལ་ཁམས་ཀྱི་ཐག་ཉེ་རིང་གི་གྲོང་ཁྱེར་ཀུན་དང་བཅས་པ་ལ་ཉེས་ཆད་ཐེབས་པར་འགྱུར་ཏེ།"]},{"type":"verse","number":25,"content":["མོ་ཨབ་ཀྱི་རྭ་ཅོ་བཅད་ནས་དཔུང་པ་བཅག་ཟིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":26,"content":["མོ་ཨབ་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ངོར་རང་མཐོང་ཆེན་པོ་བྱས་པས། ཁྱོད་ཅག་གིས་མོ་ཨབ་བཟི་རུ་ཆུག་ཅིག མོ་ཨབ་ནི་རང་གི་སྐྱུག་རོའི་ནང་དུ་འགྲེ་ལྡོག་བརྒྱབ་ཅིང་། མི་ཡིས་དེ་ལ་འཕྱ་དགོད་བྱེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":27,"content":["ཡེས་ར་ཨེལ་ནི་ཁྱོད་ཀྱི་དགོད་གཞི་མ་ཡིན་ནམ། ཁྱོད་ཀྱིས་དེའི་མིང་གླེང་བ་ཙམ་གྱིས་མགོ་བོ་གཡུག་པ་ནི་དེ་ཇག་རྐུན་གྱི་གྲས་ནས་བཟུང་བ་ཡིན་ནམ་ཅི།"]},{"type":"verse","number":28,"content":["ཀྱེ་མོ་ཨབ་ཀྱི་ཡུལ་མི་རྣམས། ཕུག་རོན་གྱིས་བྲག་ཁར་ཚང་བཅའ་བ་བཞིན་དུ། གྲོང་ཁྱེར་རྣམས་དང་བྲལ་ནས་བྲག་གཡང་དུ་སྡོད་ཅིག"]},{"type":"verse","number":29,"content":["ངེད་ཅག་གིས་མོ་ཨབ་པའི་ང་རྒྱལ་ཐོས་མྱོང་སྟེ། ང་རྒྱལ་ཤིན་ཏུ་ཆེ་ཞིང་། དེ་དག་ནི་རང་སྣང་མཐོ་ཞིང་རང་རློམ་ཆེ་བ་དང་། ཁེངས་དྲེགས་ཆེ་ལ་སེམས་སུ་རང་མཐོང་ཆེན་པོ་ཡིན།"]},{"type":"verse","number":30,"content":["དེའི་ཁྲོ་གཏུམ་ནི་སྟོང་བ་ཡིན་པ་ངས་རྟོགས་ཤིང་། དེའི་འུར་སྒྲོག་གི་གཏམ་ནི་གཅིག་ཀྱང་འགྲུབ་པར་མི་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས།"]},{"type":"verse","number":31,"content":["དེ་བས་ངས་མོ་ཨབ་ཀྱི་དོན་དུ་འོ་དོད་འབོད་ཅིང་། མོ་ཨབ་ཁྱོན་ཡོངས་ཀྱི་དོན་དུ་ངུ་འབོད་བྱེད་པ་དང་། ཀིར་ཧེ་རེ་སིའི་ཆེད་དུ་མི་རྣམས་ཀྱིས་འཁུན་སྒྲ་འབྱིན་ནོ། །"]},{"type":"verse","number":32,"content":["ཀྱེ་སིབ་མའི་རྒུན་ཤིང་། ང་རང་ཁྱོད་ཀྱི་དོན་དུ་ངུ་ཞིང་དེ་ནི་ཡཱ་ཟེར་གྱི་ངུ་འབོད་ལས་ཀྱང་ལྷག་པ་ཡིན། ཁྱོད་ཀྱི་ཡལ་ག་རྣམས་རྒྱ་མཚོའི་ཕ་རོལ་ཏུ་རྒྱས་ཏེ་ཡཱ་ཟེར་གྱི་རྒྱ་མཚོའི་བར་དུ་རྒྱས་མོད་ཀྱང་། འཇོམས་པར་བྱེད་མཁན་དེ་ཁྱོད་ཀྱི་དབྱར་ཐོག་གི་འབྲས་བུ་དང་རྒུན་འབྲུམ་སྟེང་དུ་སླེབས་ཟིན།"]},{"type":"verse","number":33,"content":["ས་ཞིང་གཤིན་པོ་དང་མོ་ཨབ་ཡུལ་གྱི་དགའ་མགུ་དང་བདེ་སྐྱིད་ནི་ཕྲོགས་པ་དང་། ངས་རྒུན་འབྲུམ་འཚིར་གཞོང་ལས་རྒུན་ཆང་བཞུར་མཚམས་བཅད་པ་སྟེ། སུས་ཀྱང་དགའ་མགུ་ཡི་རང་གིས་རྒུན་ཆང་བརྫི་བར་མི་བྱེད་ལ། སྐད་རྒྱག་པའི་སྒྲ་ཡོད་ཀྱང་དེ་ནི་དགའ་མགུ་རངས་པའི་སྒྲ་མ་ཡིན་ནོ། །"]},{"type":"verse","number":34,"content":["ངུ་འབོད་ཅིག་ཧེ་སི་པོན་ནས་ཨེལ་ཨ་ལེ་དང་དེ་ནས་ཡ་ཧ་ཙཱའི་བར་དུ་སླེབས་པ་དང་། ཚོ་ཨར་ནས་ཧོ་རོ་ན་ཨིམ་དང་དེ་ནས་ཨེག་ལད་ཤེ་ལི་ཤི་ཡཱའི་བར་དུ་སླེབས་པ་སྟེ། ཅི་ལ་ཞེ་ན། ནིམ་རིམ་གྱི་ཆུ་རྣམས་ཀྱང་སྐམ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":35,"content":["ངས་མོ་ཨབ་ཀྱི་མཐོ་གླིང་རྣམས་སུ་མཆོད་པ་འབུལ་མཁན་དང་། རང་གི་ལྷ་རྣམས་ལ་སྤོས་གདུག་མཁན་རྣམས་ཚར་གཅོད་བྱེད་ངེས་ཡིན་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":36,"content":["དེ་བས་ན་ང་ཡི་སེམས་ཀྱིས་མོ་ཨབ་ཀྱི་ཕྱིར་དུ་གླིང་བུ་དང་འདྲ་བར་སྨྲེ་སྔགས་འདོན་པ་དང་། ངའི་སེམས་ནི་ཀིར་ཧེ་རེ་སི་པའི་དོན་དུ་ངུ་བ་ཡིན་ཏེ། མོ་ཨབ་པའི་རྒྱུ་ནོར་ལོངས་སྤྱོད་ཡོད་ཚད་ཟད་ཚར་བས་སོ། །"]},{"type":"verse","number":37,"content":["མི་རེ་རེའི་མགོ་ནི་སྤྱི་ཐེར་ཏུ་གྱུར་ཏེ་སྨ་ར་བཞར་བ་དང་། ལག་པ་གཤགས་ནས་རྐེད་པར་རྩིད་རས་གཡོགས་འདུག"]},{"type":"verse","number":38,"content":["མོ་ཨབ་ཀྱི་ཁང་ཐོག་རེ་རེ་དང་ཐང་ཆེན་དུ་མྱ་ངན་བྱེད་མཁན་གྱིས་བཀང་བ་སྟེ། ཅི་ལ་ཞེ་ན། མི་ཡིས་གཅེས་སུ་མི་འཛིན་པའི་ཡོ་བྱད་གཅོག་པ་བཞིན་དུ་ངས་མོ་ཨབ་རྡུལ་དུ་བརླགས་པའི་ཕྱིར་རོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":39,"content":["མོ་ཨབ་ལ་ཐེབས་པའི་གཏོར་བརླག་ནི་ཅི་འདྲའི་ཚབས་ཆེའང་། དེ་དག་གི་ངུ་འབོད་ནི་ཅི་འདྲའི་སྐྱོ་བ་ལ། མོ་ཨབ་སྐྱེངས་ནས་ཁ་ཕར་འཁོར་ཞིང་དེ་ནི་ཉེ་འཁོར་གྱི་མི་ཐམས་ཅད་ཀྱིས་འཕྱ་དམོད་བྱེད་ས་དང་འཇིགས་པའི་རྒྱུ་རུ་གྱུར་པའོ། །"]},{"type":"heading","content":["མོ་ཨབ་ལ་འབྲོ་ས་མེད་པ།"]},{"type":"verse","number":40,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག དགྲ་བོ་ནི་བྱ་རྒོད་ལྟར་འཕུར་ཞིང་། གཤོག་ཟུང་བརྐྱངས་ནས་མོ་ཨབ་ལ་རྒོལ་བ་དང་།"]},{"type":"verse","number":41,"content":["ཀེ་རི་ཨོད་ལ་རྒོལ་ནས་ལེན་པར་འགྱུར་ལ། མཁར་བརྟན་པོ་རྣམས་ཀྱང་བཙན་གྱིས་འཛིན་པ་དང་། ཉིན་མོ་དེར་མོ་ཨབ་ཀྱི་དཔའ་བོའི་སེམས་སུ་དངངས་སྐྲག་སྐྱེས་ནས་སྐྱེ་གཟེར་རྒྱག་པའི་བུད་མེད་དང་འདྲའོ། །"]},{"type":"verse","number":42,"content":["ཡང་མོ་ཨབ་ནི་མེད་པར་བཟོ་ཞིང་མི་རིགས་ཤིག་ཏུ་མི་འགྱུར་ཏེ། ཅི་ལ་ཞེ་ན། དེས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ངོར་རང་མཐོང་ཆེན་པོ་བྱས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":43,"content":["ཀྱེ་མོ་ཨབ་ཀྱི་མི་རྣམས། འཇིགས་སྐྲག་དང་ས་དོང་། རྙི་རྒྱ་བཅས་ནི་ཁྱོད་དང་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":44,"content":["འཇིགས་པ་ལས་ཐར་བ་དེ་ས་དོང་ནང་དུ་ལྷུང་བ་དང་། ཡང་ས་དོང་ལས་ཡར་འཛེག་པ་དེ་རྙི་རྒྱས་འཛིན་པར་འགྱུར། ཅི་ལ་ཞེ་ན། བདག་གིས་ཉེས་ཆད་གཅོད་པའི་དུས་ནི་མོ་ཨབ་ཀྱི་སྟེང་དུ་འབེབ་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":45,"content":["འབྲོ་མཁན་རྣམས་ནི་ཧེ་སི་པོན་གྱི་གྲིབ་བསིལ་འོག་ཏུ་སྟོབས་ཉམས་ཤིང་ལངས་སྡོད་པ་སྟེ། ཅི་ལ་ཞེ་ན། ཧེ་སི་པོན་ལས་མེ་ཞིག་དང་སི་ཧོན་གྱི་གྲོང་ཁྱེར་ནས་མེ་ལྕེ་ཞིག་ཐོན་ཞིང་། མོ་ཨབ་ཀྱི་དཔྲལ་བ་དང་འུར་སྒྲོག་མཁན་རྣམས་ཀྱི་སྤྱི་བོ་བསྲེགས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":46,"content":["ཀྱེ་མོ་ཨབ་ཁྱོད་ལ་ཆག་སྒོ་འབྱུང་ལ། ཀེ་མོ་སི་ལ་གཏོགས་པའི་མི་རྣམས་འཆི་བའོ། །ཅི་ལ་ཞེ་ན། ཁྱོད་ཀྱི་བུ་རྣམས་བཙོན་དུ་ཁྲིད་ཅིང་། ཁྱོད་ཀྱི་བུ་མོ་རྣམས་ཀྱང་བཙོན་དུ་ཁྲིད་དོ། །"]},{"type":"verse","number":47,"content":["ཡིན་ཡང་མཐའ་མའི་ཉིན་མོ་དག་ལ་ངས་མོ་ཨབ་ལས་བཙོན་དུ་ཁྲིད་པ་རྣམས་ཕྱིར་ལོག་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པ་དང་། མོ་ཨབ་ལ་ཉེས་ཆད་གཅོད་པའི་གཏམ་ནི་འདི་རུ་མཚམས་བཞག་པའོ། །"]}],"footnotes":[{"noteId":14,"caller":"+","text":"ཀེ་མོ་སི་ཞེས་པ་ནི་མོ་ཨབ་ཀྱི་ལྷ་ཞིག་གི་མིང་ཡིན།","reference":{"chapter":48,"verse":7}}]},"thisChapterLink":"/api/bod_ntb/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}