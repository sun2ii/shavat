{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":51,"content":[{"type":"heading","content":["པཱ་པེལ་ལོན་ལ་ཡང་བསྐྱར་ཉེས་ཆད་བཅད་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་འཇོམས་བྱེད་ཀྱི་རླུང་ཞིག་སློང་བར་བྱ་སྟེ། པཱ་པེལ་ལོན་དང་ལེ་ཀཱ་མཱེ་རུ་སྡོད་པའི་མི་རྣམས་ལ་རྒོལ་བར་བྱའོ། །"]},{"type":"verse","number":2,"content":["ཡང་ངས་ཕྱི་ཕྱོགས་པ་རྣམས་པཱ་པེལ་ལོན་དུ་མངགས་ནས། ཁོ་ཚོས་དེ་གཏོར་ཞིང་དེའི་ཡུལ་ཁམས་རྡུལ་དུ་བརླག་པར་བྱེད། ཡང་དེ་ལ་ཆག་སྒོ་འབྱུང་བའི་དུས་སུ། ཁོ་རྣམས་ཀྱིས་དེ་ལ་ཕྱོགས་བཞི་ནས་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":3,"content":["གཞུ་འཐེན་མཁན་ལ་གཞུ་འཐེན་དུ་མ་འཇུག་ཅིག དེ་ལ་ཁྲབ་རྨོག་གྱོན་དུ་མ་འཇུག་ཅིག པཱ་པེལ་ལོན་གྱི་དར་མ་དག་ལ་སྙིང་རྗེ་མ་སྒོམས་ཤིག དེའི་དམག་དཔུང་ནི་རྩ་བ་ནས་མེད་པར་བཟོས་ཤིག"]},{"type":"verse","number":4,"content":["དེ་དག་ཀལ་དི་པའི་ཡུལ་དུ་བསད་ནས་འགྱེལ་བར་འགྱུར་ཞིང་། པཱ་པེལ་ལོན་གྱི་སྲང་ལམ་དུ་བསྣུན་པར་འགྱུར་ཞེས་གསུངས།"]},{"type":"verse","number":5,"content":["ཡེས་ར་ཨེལ་དང་ཡ་ཧུ་དཱའི་ཡུལ་ཁམས་སུ་ཡེས་ར་ཨེལ་གྱི་དམ་པ་ཉིད་ལ་རྒྱབ་འགལ་བྱས་པའི་སྡིག་པ་ཡིས་བཀང་ན་ཡང་། དེའི་དཀོན་མཆོག་སྟེ་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་ནི་མ་དོར་རོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་རྣམས་པཱ་པེལ་ལོན་ནས་ཕྲོས་ཤིག་དང་། རེ་རེས་རང་གི་སྲོག་སྐྱོབས་ཤིག དེའི་སྡིག་པ་ནང་དུ་ལྷུང་ནས་མཉམ་དུ་འཆི་བར་མ་འགྱུར་ཞིག ཅི་ལ་ཞེ་ན། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་འཁོན་ལན་སློག་པའི་དུས་ཏེ། ཁོང་གིས་པཱ་པེལ་ལོན་གྱི་ཕྱོགས་སུ་ལན་འཇལ་ངེས་ཡིན།"]},{"type":"verse","number":7,"content":["པཱ་པེལ་ལོན་ནི་སྔར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱག་གི་གསེར་ཕོར་ཞིག་ཡིན་ཏེ། དེས་ས་གཞི་ཚང་མ་བཟི་བར་བྱས། མི་རིགས་རྣམས་ཀྱིས་དེའི་རྒུན་ཆང་འཐུངས་བས་སྨྱོས་པར་གྱུར་ཏེ།"]},{"type":"verse","number":8,"content":["པཱ་པེལ་ལོན་ནི་གློ་བུར་ཉིད་ལ་འགྱེལ་ནས་བཤིག་པར་གྱུར་ལ། དེའི་དོན་དུ་ངུ་འབོད་བྱོས་ཤིག དེའི་ཟུག་གཟེར་གྱི་ཕྱིར་སྤོས་དཀར་དྲངས་ཤིག་དང་། ཡང་ན་དེ་གསོ་བར་འགྱུར་ཡང་སྲིད།"]},{"type":"verse","number":9,"content":["ངེད་ཀྱིས་པཱ་པེལ་ལོན་གསོ་བར་འདོད་ནའང་དེའི་ནད་མ་སངས་བས། དེ་དང་འབྲལ་བར་གྱིས་ཤིག་དང་། བདག་ཅག་རང་རང་གི་ཡུལ་དུ་ལོག་པར་བྱའོ། །ཅི་ལ་ཞེ་ན། དེར་ཐེབས་པའི་ཉེས་ཆད་ནི་བར་སྣང་དུ་སླེབས་ཤིང་། ནམ་མཁའི་བར་དུའང་སླེབས་པའོ། །"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཅག་གི་དྲང་བདེན་མངོན་པར་མཛད་པས། ཤོག་དང་། རང་ཅག་གིས་ཛ་ཡན་དུ་རང་རེའི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཛད་རྗེས་འཆད་པར་བྱའོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཀྱིས་མདའ་རྩེ་རྡོར་དང་། ཕུབ་རྣམས་དམ་དུ་ཟུངས་ཤིག དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་པེལ་ལོན་ནི་མེད་པར་མཛད་པའི་ཐུགས་ཐག་བཅད་པས་ན། མཱ་ཏི་པའི་རྒྱལ་པོའི་སེམས་དཀྲུགས་སོ། །ཅི་ལ་ཞེ་ན། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་འཁོན་ལན་སློག་པ་སྟེ། ཁོང་གི་མཆོད་ཁང་གི་དོན་དུ་ལན་སློག་པ་ཡིན་ནོ། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཅག་གིས་དར་རྣམས་བསྒྲེངས་ཏེ་པཱ་པེལ་ལོན་གྱི་མཁར་རྣམས་ལ་རྒོལ་ཞིག མེལ་ཚེ་བརྟན་པོ་བྱོས་ལ་སོ་པ་རྣམས་ཞོག་ཅིག འཇབ་ས་རྣམས་ཤོམས་ཤིག ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་པེལ་ལོན་གྱི་མི་རྣམས་ཀྱི་ཆེད་དུ་གསུངས་པ་ལྟར། ཁོང་གིས་དེ་བཞིན་དགོངས་པར་མ་ཟད་དེ་བཞིན་མཛད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ཀྱེ་ཆུ་རྣམས་ཀྱི་སྟེང་དུ་སྡོད་ཅིང་གཏེར་མང་པོ་ཡོད་པ་ཁྱོད་ཀྱི་མཐའ་མར་སླེབས་ཏེ། ཁྱོད་ཀྱི་འདོད་པ་ཁ་བཀང་བའོ། །"]},{"type":"verse","number":14,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་རང་ཉིད་དཔང་དུ་བཙུགས་ནས་མནའ་བཞེས་ཏེ་འདི་སྐད་དུ། ངས་ཆ་ག་འབུ་ནི་ག་ས་གང་དུ་བཀང་བ་བཞིན་དགྲ་རྣམས་ཁྱོད་ཀྱི་ཡུལ་ཁམས་སུ་ཁྱབ་པར་བྱ་སྟེ། དེ་དག་གིས་ངར་སྐད་སྒྲོག་བཞིན་ཁྱོད་ལ་རྒོལ་བར་འགྱུར་རོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་སྙན་ཚིག"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ནུས་མཐུ་ལ་བརྟེན་ནས་ས་གཞི་བཀོད་ཅིང་། ཉིད་ཀྱི་ཤེས་རབ་ཀྱིས་འཇིག་རྟེན་མཛད་པ་དང་། ཡང་ཁོང་གི་མཁྱེན་རབ་ཀྱིས་ཨ་སྔོན་དབྱིངས་རྣམས་བཏིངས།"]},{"type":"verse","number":16,"content":["ཁོང་གིས་གསུང་སྐད་འདོན་དུས་ནམ་མཁའ་ནས་ཆུ་རྣམས་འཕྱུར་ཞིང་། ཁོང་གིས་ས་མཐའ་ནས་སྤྲིན་དང་སྨུག་པ་ལང་བར་མཛད་པ་དང་། ཆར་བ་དང་ཆབས་ཅིག་གློག་དམར་འཁྱུག་པར་མཛད། ཉིད་ཀྱི་གཏེར་མཛོད་རྣམས་ལས་རླུང་ཡང་འདོན་ནོ། །"]},{"type":"verse","number":17,"content":["མི་རེ་རེ་དུད་འགྲོ་དང་འདྲ་སྟེ་ཤེས་བྱ་མེད་ལ། དངུལ་མགར་རྣམས་ནི་རང་རང་གི་སྐུ་འདྲའི་རྐྱེན་གྱིས་ངོ་ཚ་བ་དང་། དེས་བླུགས་པའི་སྐུ་འདྲ་རྣམས་ནི་རྫུས་མ་ཡིན་ལ་དེ་དག་གི་ནང་དུ་དབུགས་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":18,"content":["སྐུ་འདྲ་ཐམས་ཅད་སྙིང་པོ་མེད་པ་དང་། དེ་ནི་མི་ལ་མགོ་སྐོར་གཏོང་བྱེད་ཙམ་ཡིན་ཏེ། ཉེས་ཆད་གཅོད་པའི་དུས་སུ་སླེབས་ཚེ་དེ་དག་མེད་པར་བཟོ་ངེས་ཡིན།"]},{"type":"verse","number":19,"content":["ཡང་ཡ་ཀོབ་ཀྱི་ཐོབ་སྐལ་ནི་དེ་འདྲ་མིན་ཏེ། ཅི་ལ་ཞེ་ན། ཁོང་ནི་ཐམས་ཅད་འགོད་མཁན་གཙོ་བོ་ཡིན་པས་སོ། །ཡེས་ར་ཨེལ་ཡང་ཁོང་གི་ནོར་སྐལ་གྱི་ཚོ་ཁག་ཡིན་པ་དང་། ཁོང་གི་མཚན་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས་སོ། །"]},{"type":"verse","number":20,"content":["ཁྱོད་ནི་ངའི་རྒྱག་བྱེད་ཀྱི་སྟ་རེ་དང་འཐབ་མོའི་མཚོན་ཆ་ཡིན་ཏེ། ངས་ཁྱོད་བརྒྱུད་ནས་མི་རྣམས་རྡུལ་དུ་བརླག་ཅིང་། རྒྱལ་ཕྲན་རྣམས་མེད་པར་བྱའོ། །"]},{"type":"verse","number":21,"content":["ངས་ཁྱོད་བརྒྱུད་ནས་རྟ་དང་སྐྱ་མི་གཉིས་པོ་རྡུལ་དུ་བརླག་ཅིང་། ཤིང་རྟ་དང་དེའི་ནང་དུ་སྡོད་མཁན་གཉིས་ཀ་རྡུལ་དུ་བརླག་པར་བྱའོ། །"]},{"type":"verse","number":22,"content":["ངས་ཁྱོད་བརྒྱུད་ནས་སྐྱེས་པ་དང་བུད་མེད་གཉིས་ཀ་རྡུལ་དུ་བརླག་ཅིང་། རྒན་པ་དང་ན་གཞོན་གཉིས་ཀ་རྡུལ་དུ་བརླག་པ་དང་། གཞོན་ནུ་ཕོ་མོ་གཉིས་ཀའང་རྡུལ་དུ་བརླག་པར་བྱའོ། །"]},{"type":"verse","number":23,"content":["ངས་ཁྱོད་བརྒྱུད་ནས་རྫི་བོ་དང་དེའི་ཕྱུགས་ཁྱུ་རྡུལ་དུ་བརླག་ཅིང་། ཞིང་པ་དང་དེའི་རྨོན་གླང་རྡུལ་དུ་བརླག་པ་དང་། བཀའ་བློན་དང་བློན་པོ་རྣམས་ཀྱང་རྡུལ་དུ་བརླག་པར་བྱའོ། །"]},{"type":"heading","content":["པཱ་པེལ་ལོན་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":24,"content":["པཱ་པེལ་ལོན་དང་ཀལ་དི་པའི་མི་ཐམས་ཅད་ཀྱིས་ཛ་ཡན་དུ་སྤྱད་པའི་ངན་སྤྱོད་ཀུན་གྱི་ཕྱིར་དུ། ངས་ཁྱོད་ཚོའི་མིག་མདུན་དུ་དེ་དག་ལ་འཁོན་ལན་སློག་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":25,"content":["ཀྱེ་ཚར་གཅོད་བྱེད་པའི་རི་བོ། ས་གཞི་ཐམས་ཅད་རྩ་མེད་དུ་གཏོང་བའི་རི་བོ། ལྟོས་ཤིག ངས་ཁྱོད་ནི་དགྲ་རུ་བཟུང་སྟེ། ངས་ཁྱོད་ཀྱི་སྟེང་དུ་རང་གི་ལག་པ་བརྐྱངས་ཏེ་རྒོལ་བར་འགྱུར་ལ། བྲག་རྣམས་ལས་ཁྱོད་བསྒྲིལ་བར་བཅུག་ནས། ཁྱོད་ནི་མེས་བསྲེགས་པའི་རི་བོར་བྱའོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་མི་ཡིས་ཁང་པའི་གྲུ་རྡོ་བྱེད་དུ་ཁྱོད་ལས་མི་ལེན་པ་དང་། རྨང་རྡོ་ཡང་ཁྱོད་ལས་མི་ལེན་ནོ། །ཅི་ལ་ཞེ་ན། ཁྱོད་ནི་དུས་རྟག་ཏུ་ཞིག་རོར་ལུས་པར་འགྱུར་རོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"verse","number":27,"content":["ཁྱོད་ཅག་གིས་ཡུལ་ཁམས་ནང་དུ་དར་རྣམས་བསྒྲེངས་ཏེ། མི་རིགས་རྣམས་ཀྱི་ཁྲོད་དུ་རྭ་དུང་བུས་ཤིག མི་རིགས་རྣམས་ཀྱིས་པཱ་པེལ་ལོན་ལ་འཐབ་པར་གྲ་སྒྲིག་བྱོས་ཤིག ཡང་ཨ་ར་རད་དང་མིན་ནི་དང་། ཨ་ཤ་ཀེ་ནཱ་ཡི་རྒྱལ་ཕྲན་རྣམས་བསྡུས་ཏེ་དམག་དཔོན་མངགས་ནས་དེར་རྒོལ་དུ་ཆུག་དང་། ཡང་ཆ་ག་འབུ་བཞིན་དུ་རྟ་རྣམས་དྲངས་ནས།"]},{"type":"verse","number":28,"content":["མི་རིགས་རྣམས་དང་མཱ་ཏི་པའི་རྒྱལ་པོ་དང་། བཀའ་བློན་དང་བློན་པོ་རྣམས་དང་། དེ་དག་གིས་བཟུང་བའི་ཡུལ་ཁམས་ཐམས་ཅད་ཀྱིས་དེ་ལ་རྒོལ་བར་རྩོམ་དགོས།"]},{"type":"verse","number":29,"content":["དེ་ནས་ས་གཞི་འདར་ཞིང་གཅུ་གྲིམ་རྒྱག་གོ །ཅི་ལ་ཞེ་ན། པཱ་པེལ་ལོན་ནང་དུ་མི་གཅིག་ཀྱང་མི་གནས་པ་དང་སྟོངས་པར་མཛད་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དགོངས་པ་རྣམས་གཏན་ལ་ཕབ་པས་སོ། །"]},{"type":"verse","number":30,"content":["པཱ་པེལ་ལོན་གྱི་དཔའ་བོ་རྣམས་ཀྱིས་དམག་འཁྲུག་མཚམས་བཞག་སྟེ་བཙན་རྫོང་ནང་དུ་སྦས་པ་དང་། དེ་དག་གི་སྟོབས་ཤུགས་ཉམས་ཏེ་བུད་མེད་ལྟ་བུར་གྱུར་ཏོ། །ཡང་པཱ་པེལ་ལོན་གྱི་སྡོད་གནས་དག་མེས་བསྲེགས་ཤིང་སྒོ་གཏན་རྣམས་བཅགས་སོ། །"]},{"type":"verse","number":31,"content":["པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ལ། ཁྱེད་ཀྱི་གྲོང་ཁྱེར་གྱི་ཕྱོགས་བཞི་པོ་བླངས་ཤིང་། རབ་ཁ་རྣམས་བཙན་བཟུང་བྱས་ཏེ་འདམ་གཞུང་རྣམས་མེས་བསྲེགས་པ་དང་། དམག་རྣམས་ཀྱང་འཇིགས་པར་གྱུར་ཏོ་ཞེས་ཞུ་བའི་བང་ཆེན་རྣམས་ཕན་ཚུན་གདོང་ཐུག་རྒྱག་པ་དང་། འཕྲིན་སྐྱེལ་མཁན་རྣམས་ཀྱང་ཕན་ཚུན་འཕྲད་དོ། །"]},{"type":"verse","number":33,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། པཱ་པེལ་ལོན་གྱི་བུ་མོ་ནི་ཚར་མ་རྡུང་སའི་གཡུལ་ཁ་དང་མཚུངས་ཏེ། ཅང་མི་འགོར་བར་དེ་བསྡུ་བའི་སྐབས་ལ་སླེབ་པར་འགྱུར་རོ་ཞེས་གསུངས།"]},{"type":"verse","number":34,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་འདི་ལྟར། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ནེ་བོ་ཀད་ནེ་ཙར་གྱིས་ང་རང་ཁྱུར་མིད་བཏང་ནས་ང་རང་བརྫིས་པ་དང་། ང་རང་སྣོད་སྟོང་དུ་འགྱུར་བར་བྱས། ཁོ་ནི་ཆུ་སྲིན་ཞིག་དང་འདྲ་བར་ང་ཁྱུར་མིད་བཏང་ཞིང་། ང་ནི་ཟས་མཆོག་བཞིན་ཁོའི་ཁོག་པར་བཀང་བར་བཅུག་སྟེ། ཡང་ང་རང་བསྐྲད་པ་ཡིན་ནོ་ཞེས་སྨྲའོ། །"]},{"type":"verse","number":35,"content":["ཡང་ཛ་ཡན་གྱི་མི་རྣམས་ཀྱིས་འདི་ལྟར། ང་དང་ངའི་ཤ་ཁྲག་གིས་མྱངས་པའི་གདུག་རྩུབ་དེ་ཕྱིར་པཱ་པེལ་ལོན་གྱི་སྟེང་དུ་འབབ་པར་ཤོག་ཅེས་སྨྲ་བར་འགྱུར་ཞིང་། ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་ཀྱིས་འདི་ལྟར། ངེད་རྣམས་ལས་ཁྲག་བཞུར་བའི་ཉེས་ཆད་ནི་ཀལ་དི་པའི་སྟེང་དུ་འཕོག་གྱུར་ཅིག་ཅེས་སྨྲ་བར་འགྱུར་རོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་རོགས་རམ་མཛད་པ།"]},{"type":"verse","number":36,"content":["དེ་བས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག ངས་ཁྱོད་ཀྱི་དོན་དུ་དཀར་འདོན་པ་དང་། ཁྱོད་ཀྱི་དོན་དུ་འཁོན་ལན་སློག་པར་བྱ་སྟེ། ངས་པཱ་པེལ་ལོན་གྱི་རྒྱ་མཚོ་སྐམ་པར་བྱེད་ཅིང་། དེའི་ཆུ་མགོ་ཡང་སྐམ་པར་བྱའོ། །"]},{"type":"verse","number":37,"content":["པཱ་པེལ་ལོན་ནི་ཞིག་རོ་དང་ཁྱི་སྤྱང་གི་ཚང་དུ་གྱུར་ནས། འཇིགས་སུ་རུང་བ་དང་འཕྱ་དགོད་བྱེད་ཡུལ་དུ་འགྱུར་ཞིང་སྡོད་མཁན་གཅིག་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":38,"content":["དེ་དག་གིས་སེང་གེ་དར་མ་བཞིན་ང་རོ་སྒྲོག་ཅིང་། སེང་ཕྲུག་ལྟར་ངར་སྐད་འདོན་པ་ཡིན།"]},{"type":"verse","number":39,"content":["དེ་དག་ལ་ཟ་འདོད་ཆེ་བའི་དུས་སུ། ངས་དེ་དག་ལ་གསོལ་སྟོན་བཤམས་ནས་ཁོ་ཚོ་བཟི་རུ་བཅུག་སྟེ་དགའ་བར་བྱེད་པ་དང་། དེ་དག་ལ་དུས་གཏན་དུ་གཉིད་འཐིབས་ནས་མི་སད་དོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":40,"content":["ངས་དེ་དག་ནི་ལུ་གུ་བཞིན་དང་། ལུག་ཐུག་དང་ར་ཐུག་ལྟར་བཤས་རར་ཤན་པའི་དྲུང་དུ་འཁྲིད་པར་བྱའོ། །"]},{"type":"verse","number":41,"content":["ཤེ་ཤག་ནི་ཅི་ལྟར་རྒོལ་ནས་བླངས་པ་ཡིན་ནམ། ས་གཞི་ཡོངས་ཀྱིས་བསྟོད་པ་དེ་ཅི་ལྟར་བཙན་བཟུང་བྱས་པ་ཡིན་ནམ། མི་རིགས་རྣམས་ཀྱི་ཁྲོད་དུ་པཱ་པེལ་ལོན་ནི་ཅི་ལྟར་འཇིགས་སུ་རུང་བར་གྱུར་པ་ཡིན་ནམ།"]},{"type":"verse","number":42,"content":["རྒྱ་མཚོ་འཕྱུར་ནས་པཱ་པེལ་ལོན་བསྣུབས་ཏེ། འཕྱུར་བའི་རྦ་རླབས་ཀྱིས་དེ་འགེབ་པར་འགྱུར།"]},{"type":"verse","number":43,"content":["དེའི་གྲོང་ཁྱེར་ནི་ས་སྟོང་དང་སྐམ་ས། བྱེ་ཐང་བཅས་སུ་གྱུར་ཏེ། སྡོད་མཁན་གཅིག་ཀྱང་མེད་ལ་དེ་བརྒྱུད་ནས་འགྲོ་མཁན་ཡང་མེད་པའི་གནས་སུ་འགྱུར་རོ། །"]},{"type":"verse","number":44,"content":["ངས་པཱ་པེལ་ལོན་གྱི་པེལ་ལ་ཆད་པ་གཅོད་ཅིང་། དེས་ཁྱུར་མིད་བཏང་བ་རྣམས་ཁ་ནས་སྐྱུག་པར་བྱ་སྟེ། ཕྱིན་ཆད་མི་རྣམས་དེའི་མདུན་དུ་ཕྱོགས་པར་མི་བྱེད་ལ། པཱ་པེལ་ལོན་གྱི་མཁར་རྣམས་ཀྱང་ལོག་པར་འགྱུར་རོ། །"]},{"type":"verse","number":45,"content":["ཀྱེ་བདག་གི་འབངས་མི་ལགས། ཁྱོད་རྣམས་པཱ་པེལ་ལོན་དང་འབྲལ་བར་གྱིས་ཤིག མི་རེ་རེ་སྲོག་ཐར་བར་བྲོས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་དྲག་པོ་ལ་གཡོལ་བར་གྱིས་ཤིག"]},{"type":"verse","number":46,"content":["ཡུལ་ཁམས་སུ་ཐོས་པའི་སྐད་ཆའི་ཕྱིར་དུ་ཁྱོད་ཅག་མ་ཞུམ་མ་འཇིགས་ཤིག ཅི་ལ་ཞེ་ན། ལོ་འདིའི་ནང་དུ་སྐད་ཆ་ཞིག་དང་། ལོ་རྗེས་མར་ཡང་སྐད་ཆ་གཞན་ཞིག་ཐོས་འོང་སྟེ། ཡུལ་ཁམས་སུ་དྲག་ཤུགས་འབྱུང་བ་དང་འགོ་དཔོན་གྱིས་འགོ་དཔོན་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":47,"content":["དེ་བས་ན་ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེ། ངས་པཱ་པེལ་ལོན་གྱི་བརྐོས་སྐུ་ལ་ཉེས་ཆད་གཅོད་པར་འགྱུར་ཏེ། དེའི་ཡུལ་ཁམས་ཡོངས་རྫོགས་ངོ་ཚ་བར་འགྱུར་ལ། དེའི་བསད་པའི་མི་ཐམས་ཅད་ནི་དེའི་དབུས་སུ་འགྱེལ་བར་འགྱུར།"]},{"type":"verse","number":48,"content":["དུས་དེར། ནམ་མཁའ་དང་ས་གཞི་དང་དེའི་ནང་ཡོད་པ་ཀུན་གྱིས་པཱ་པེལ་ལོན་གྱི་རྐྱེན་གྱིས་དགའ་འབོད་བྱེད་འོང་སྟེ། ཅི་ལ་ཞེ་ན། གཏོར་བརླག་བྱེད་མཁན་ནི་བྱང་ཕྱོགས་ཡུལ་ནས་དེར་འོང་བར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":49,"content":["སྔར་པཱ་པེལ་ལོན་གྱིས་ཇི་ལྟར་ཡེས་ར་ཨེལ་གྱི་བསད་པའི་མི་རྣམས་འགྱེལ་བར་བྱས་ན། དེའི་ཡུལ་ཁམས་ཡོངས་ཀྱི་བསད་པའི་མི་ཐམས་ཅད་ཀྱང་དེ་དང་དེ་བཞིན་པཱ་པེལ་ལོན་དུ་འགྱེལ་བར་འགྱུར་རོ། །"]},{"type":"heading","content":["པཱ་པེལ་ལོན་དུ་ཡོད་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བསྐུར་བའི་འཕྲིན།"]},{"type":"verse","number":50,"content":["རལ་གྲི་ལ་གཡོལ་བ་ཁྱོད་རྣམས་མྱུར་དུ་སོང་ཞིག་དང་། ལངས་ནས་མ་སྡོད་ཅིག རྒྱང་རིང་ཡུལ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་དྲན་པར་གྱིས། སེམས་སུ་ཡེ་རུ་སཱ་ལེམ་དྲན་གསོ་བྱོས་ཤིག"]},{"type":"verse","number":51,"content":["ངེད་ཅག་གིས་ངན་སྨྲས་ཐོས་པས་ངོ་ཚ་བ་དང་། གདོང་དུ་ངོ་ཚ་ཡིས་བཀང་བ་སྟེ། ཅི་ལ་ཞེ་ན། ཕྱི་ཕྱོགས་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་གི་གནས་དམ་པར་ཕྱིན་པས་སོ། །"]},{"type":"verse","number":52,"content":["དེ་བས་ན་ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། ངས་པཱ་པེལ་ལོན་གྱི་བརྐོས་སྐུ་ལ་ཉེས་ཆད་གཅོད་པར་འགྱུར་ཏེ། ཡུལ་ཁམས་ཡོངས་སུ་སྣད་པར་གྱུར་པའི་མི་ཡིས་འཁུན་སྒྲ་འདོན་པར་འགྱུར་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":53,"content":["པཱ་པེལ་ལོན་ནི་ནམ་མཁའ་རུ་འཛེགས་པ་དང་། དེས་རང་གི་མཐོ་ས་རྣམས་བརྟན་པོར་བྱས་ན་ཡང་། ངས་འཇིག་བྱེད་རྣམས་མངགས་ནས་དེར་འགྲོ་བར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["པཱ་པེལ་ལོན་ནུབ་པ།"]},{"type":"verse","number":54,"content":["པཱ་པེལ་ལོན་ནས་ངུ་འབོད་ཅིག་ཐོན་ཏེ། ཀལ་དི་པའི་ཡུལ་ནས་འཇིག་པ་ཆེན་པོའི་སྒྲ་ཞིག་ཐོན།"]},{"type":"verse","number":55,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་པཱ་པེལ་ལོན་ནི་དབེན་སྟོང་དུ་མཛད་ཅིང་། དེའི་ནང་གི་ཅ་ཅོའི་སྒྲ་རྣམས་མེད་པར་མཛད་པས། དགྲ་ཟླས་ཆུ་རྣམས་བཞིན་དུ་རྦ་རླབས་འཕྱུར་ཏེ་ཅ་ཅོ་བསྒྲག་འོང་།"]},{"type":"verse","number":56,"content":["འདི་ནི་འཇོམས་མཁན་རྣམས་པཱ་པེལ་ལོན་གྱི་སྟེང་དུ་བབས་ཏེ། པཱ་པེལ་ལོན་གྱི་དཔའ་བོ་རྣམས་བཟུང་ནས་དེ་དག་གི་གཞུ་རྣམས་དུམ་བུར་བཅག་གོ །ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་འཁོན་ལན་སློག་པའི་དཀོན་མཆོག་ལགས་པས། ཁོང་གིས་ངེས་པར་དུ་འཁོན་ལན་སློག་པའོ། །"]},{"type":"verse","number":57,"content":["ཡང་ངས་པཱ་པེལ་ལོན་གྱི་འགོ་དཔོན་དང་མཁས་པ། བཀའ་བློན། བློན་པོ། དཔའ་བོ་བཅས་ཐམས་ཅད་བཟི་རུ་བཅུག་སྟེ། ཁོ་རྣམས་ལ་དུས་གཏན་དུ་གཉིད་འཐིབས་ནས་སད་པར་མི་འགྱུར་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་མངའ་བའི་རྒྱལ་པོས་གསུངས་སོ། །"]},{"type":"verse","number":58,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། པཱ་པེལ་ལོན་གྱི་ཡངས་ཤིང་རྒྱ་ཆེ་བའི་མཁར་རྣམས་ནི་རྩ་བ་ནས་ལོག་ཅིང་། དེའི་མཁར་སྒོ་མཐོན་པོ་རྣམས་མེས་བསྲེག་པར་འགྱུར། མི་རྣམས་ཀྱིས་དཀའ་ལས་ཆེན་པོ་མྱངས་པ་དོན་མེད་དུ་འགྱུར་ཞིང་། མི་རིགས་རྣམས་ཀྱིས་དཀའ་ལས་བྱེད་པ་རྣམས་མེས་བསྲེག་པར་འགྱུར་བས། དེ་དག་ཉམ་ཐག་པའོ། །"]},{"type":"verse","number":59,"content":["ཡ་ཧུ་དཱའི་རྒྱལ་པོ་ཚིད་ཀི་ཡཱས་སྲིད་སྐྱོང་བའི་ལོ་བཞི་པར། མ་སེ་ཡཱའི་ཚ་བོའམ་ནེར་ཡཱའི་བུ་སེ་ར་ཡཱ་ནི་རྒྱལ་པོ་དང་མཉམ་དུ་པཱ་པེལ་ལོན་དུ་སོང་སྟེ། སེ་ར་ཡཱ་ནི་རྒྱལ་པོའི་ཕོ་བྲང་གི་བློན་ཆེན་ཡིན་ནོ། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱ་ཡིས་དེ་ལ་བཀའ་བསྒོས་པ་སྟེ།"]},{"type":"verse","number":60,"content":["དེ་ཡང་ཡེ་རེམ་ཡཱ་ཡིས་པཱ་པེལ་ལོན་གྱི་སྟེང་དུ་འབྱུང་བར་འགྱུར་བའི་ཆག་སྒོ་ཐམས་ཅད་དེ། པཱ་པེལ་ལོན་གྱི་སྐོར་དུ་བྲིས་པའི་གསུང་འདི་ཐམས་ཅད་གླེགས་བམ་ནང་དུ་བཀོད་པ་རེད།"]},{"type":"verse","number":61,"content":["ཡེ་རེམ་ཡཱ་ཡིས་སེ་ར་ཡཱ་ལ་འདི་ལྟར། ཁྱེད་རང་པཱ་པེལ་ལོན་དུ་སླེབས་དུས་གླེགས་བམ་འདིའི་ནང་གི་བཀའ་རྣམས་བཀླག་པར་མཛོད་ཅིག"]},{"type":"verse","number":62,"content":["ཡང་ཁྱེད་ཀྱིས་འདི་ལྟར། ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་གནས་འདིའི་སྐོར་ལ་འདི་རུ་མི་དང་དུད་འགྲོ་གང་ཡང་མི་གནས་པར་དུས་རྒྱུན་དུ་སྟོང་བར་ལུས་པའི་ཕྱིར་གནས་འདི་མེད་པར་བྱའོ་ཞེས་གསུངས་པ་ཡིན་ཞེས་སྨྲོས་ཤིག"]},{"type":"verse","number":63,"content":["ཁྱེད་ཀྱིས་མདོ་འདི་བཀླགས་ཚར་རྗེས་དེ་ལ་རྡོ་ཞིག་བཏགས་ནས་ཕི་རཱད་གཙང་པོའི་ནང་དུ་གཡུགས་ནས་འདི་ལྟར།"]},{"type":"verse","number":64,"content":["པཱ་པེལ་ལོན་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་དེའི་སྟེང་དུ་འབེབ་པར་འགྱུར་བའི་ཆག་སྒོ་ཡི་རྐྱེན་གྱིས་འདི་ལྟར་ནུབ་ནས་སླར་ལང་བར་མི་འགྱུར་ཏེ། མི་རྣམས་ཀྱང་ཉམ་ཐག་པར་འགྱུར་རོ་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་པ་དང་། ཡེ་རེམ་ཡཱ་ཡི་གསུང་རྣམས་འདི་ནས་རྫོགས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":63}