{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JER","translationId":"bod_ntb","name":"ཡེ་རེམ་ཡཱ།","commonName":"ཡེ་རེམ་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱའི་མདོ།","order":24,"numberOfChapters":52,"sha256":"5b64691f3ef339e1c1614a6dafccda9daba62cd9f5ec11d9d962143462167bb6","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bod_ntb/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["བདག་ནི་རང་གི་མི་རྣམས་ཀྱི་ནང་དུ་གསོད་གཅོད་ཐེབས་པའི་མི་ཡི་ཆེད་དུ་ཉིན་མཚན་མེད་པར་ངུ་བའི་ཕྱིར། བདག་གི་མགོ་ནི་ཁྲོན་པ་དང་བདག་གི་མིག་ནི་མཆི་མའི་ཆུ་མིག་ཡིན་པར་སྨོན།"]},{"type":"verse","number":2,"content":["ཡང་བདག་ནི་ང་ཡི་མི་རྣམས་དང་གྱེས་ནས་འགྲོ་ཐུབ་པའི་ཆེད་དུ་དབེན་སྟོང་དུ་ལམ་པའི་གནས་ཚང་ཞིག་ཡོད་པར་སྨོན། ཅི་ལ་ཞེ་ན། དེ་དག་ཐམས་ཅད་ལོག་གཡེམ་བྱེད་མཁན་དང་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་མཁན་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["རྫུན་སྨྲ་བའི་ཆེད་དུ་དེ་རྣམས་ཀྱིས་ལྕེ་བཀུག་ནས་གཞུ་དང་འདྲ། དེ་རྣམས་ལ་ཡུལ་ཁམས་སུ་སྟོབས་ཤུགས་རྒྱས་པ་ནི་དྲང་བདེན་གྱི་དབང་གིས་མ་ཡིན་ལ། དེ་དག་གིས་ངན་པའི་སྟེང་དུ་ངན་བསགས་ནས་བདག་ཀྱང་ངོ་མི་ཤེས་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":4,"content":["སྤུན་ཟླ་ཀུན་གྱིས་མི་ལ་མགོ་སྐོར་གཏོང་ཞིང་ཁྱིམ་མཚེས་ཐམས་ཅད་ཀྱིས་ཀྱང་དཀྲུག་ཤིང་འཕེན་པས་ན། ཁྱོད་ཚོས་རང་གི་ཁྱིམ་མཚེས་ལ་དོགས་ཟོན་གྱིས་ཤིག སྤུན་ཟླ་ལའང་བློ་མ་གཏོད་ཅིག"]},{"type":"verse","number":5,"content":["དེ་དག་གིས་ཁྱིམ་མཚེས་ལ་མགོ་སྐོར་གཏོང་ཞིང་དྲང་གཏམ་མི་སྨྲ་བར། རང་གི་ལྕེ་ཡིས་རྫུན་ཚིག་སྨྲ་བར་སྦྱང་སྟེ། ནུས་ཤུགས་གང་ཡོད་བཏོན་ནས་སྤྱོད་ངན་སྤྱོད་པའོ། །"]},{"type":"verse","number":6,"content":["ཁྱོད་ནི་གཡོ་སྒྱུ་ཅན་རྣམས་ཀྱི་དབུས་སུ་སྡོད་པ་དང་། དེ་དག་གིས་གཡོ་སྒྱུ་སྤྱད་པས་ང་རང་ངོ་ཤེས་པར་མ་འདོད་ཅེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":7,"content":["དེ་བས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་དེ་རྣམས་གཙང་མར་བཟོ་བ་དང་ཚོད་བགམ་བྱེད་པར་འགྱུར། བདག་གི་འབངས་མིའི་ཆེད་དུ་ངས་དེ་ལས་གཞན་ཅི་ཞིག་སྤྱོད་འོས་སམ།"]},{"type":"verse","number":8,"content":["དེ་དག་གི་ལྕེ་ནི་དུག་མདའ་ཡིན་ལ་ཁ་ནས་གཡོ་སྒྱུ་སྨྲ་ཞིང་། ཁྱིམ་མཚེས་ལ་ཁ་ཡག་ཚིག་འཇམ་སྨྲ་ནའང་སེམས་སུ་ཇུས་ངན་བཀོད་ནས་དེ་རྣམས་ལ་གནོད་བསྐྱལ་བ་ཡིན།"]},{"type":"verse","number":9,"content":["བདག་གིས་དོན་འདི་ཐམས་ཅད་ཀྱི་ཕྱིར་དུ་དེ་དག་ལ་ཉེས་ཆད་མི་གཅོད་ག་ལ་རུང་། ཡུལ་ཁམས་འདི་ལྟ་བུ་ལ་བདག་གིས་ལན་མི་བསློག་གམ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས།"]},{"type":"verse","number":10,"content":["བདག་ནི་རི་རྒྱུད་རྣམས་ཀྱི་ཕྱིར་ངུ་ཞིང་སྡུག་པར་འགྱུར་ལ། དབེན་སྟོང་གི་རྩྭ་སའི་ཆེད་དུ་ངུ་འབོད་བྱེད་དོ། །ཅི་ལ་ཞེ་ན། དེ་རྣམས་སྐམ་ཞིང་དེར་བརྒྱུད་ནས་འགྲོ་མཁན་གཅིག་ཀྱང་མེད་ལ། ཕྱུགས་ཟོག་གི་སྐད་ཀྱང་མི་ཐོས་ཏེ། ནམ་མཁའི་འདབ་ཆགས་དང་ས་ཡི་གཅན་གཟན་ཡང་བྲོས་སོང་ངོ་། །"]},{"type":"verse","number":11,"content":["བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ནི་ཞིག་རོ་དང་ཁྱི་སྤྱང་གི་གནས་སུ་བསྒྱུར་དགོས་ལ། ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་རྣམས་ཀྱང་ཤུལ་མེད་དུ་བསྐྱུར་ནས་མི་སུ་ཡང་སྡོད་པར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["སུ་ཞིག་ལ་ཤེས་རབ་ལྡན་ཞིང་དོན་འདི་རྣམས་རྟོགས་ནུས་སམ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་གྱིས་སུ་ཞིག་ལ་གསུངས་ཏེ་དོན་འདི་བསྒྲག་ནུས་པར་མཛད་དམ། གནས་འདི་ནི་མེད་པར་བཏང་ནས་དབེན་སྟོང་དུ་ལུས་པ་དང་། དེར་བརྒྱུད་ནས་འགྲོ་མཁན་གཅིག་ཀྱང་མེད་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":13,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་འདི་རྣམས་ཀྱིས་བདག་གིས་ཁོ་རྣམས་ཀྱི་མདུན་དུ་བཤམས་པའི་བཀའ་ཁྲིམས་དོར་ཞིང་བདག་གི་བཀའ་ལ་ཡང་མི་མཉན་པ་དང་། བདག་གི་བཀའ་ཁྲིམས་བཞིན་དུ་མ་སྤྱད་པར།"]},{"type":"verse","number":14,"content":["གཤིས་རྒྱུད་གྱོང་པོའི་རྗེས་སུ་འབྲངས་ཏེ་སྤྱོད་པ་སྤྱད་ཅིང་། དེ་དག་གི་ཕ་མེས་རྣམས་ཀྱིས་བསླབ་པ་བཞིན་དུ་པཱ་ཨལ་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་པ་ཡིན་ཞེས་པའོ། །"]},{"type":"verse","number":15,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་འདི་སྐད་དུ། ལྟོས་ཤིག བདག་གིས་མི་འདི་རྣམས་ལ་ཟས་སུ་མཁན་པ་དང་བཏུང་བར་དུག་ཆུ་སྦྱིན་པར་བྱའོ། །"]},{"type":"verse","number":16,"content":["བདག་གིས་ཁོ་ཚོ་ནི་ཁོ་རྣམས་དང་ཁོ་ཚོའི་མེས་པོ་རྣམས་ལ་རྒྱུས་མེད་པའི་ཡུལ་ཁམས་སུ་གཏོར་བར་བྱ་ཞིང་། དེ་དག་ཚར་མ་བཅད་བར་དུ་རལ་གྲིས་དེ་དག་འདེད་བཅོམ་བྱེད་པར་འགྱུར་ཞེས་གསུངས།"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གྱིས་རོགས་སྐྱོར་བྱེད་རེ་ཞུ་བ།"]},{"type":"verse","number":17,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དོགས་ཟོན་གྱིས། སྐྱོ་གླུ་ལེན་པའི་བུད་མེད་རྣམས་བསྡུས་ཤིག མི་མངགས་ནས་ངུ་བར་བྱང་བའི་བུད་མེད་རྣམས་བོས་ཤིག"]},{"type":"verse","number":18,"content":["དེ་དག་མྱུར་དུ་ཡོང་ནས་བདག་ཅག་གི་ཕྱིར་མྱ་ངན་ཞུ་བར་བྱས་ནས། རང་ཅག་གི་མིག་ལས་མཆི་མ་བཞུར་བ་དང་རང་ཅག་གི་མིག་ལྕིབས་ལས་མིག་ཆུ་ཡོང་བར་བྱེད་དགོས།"]},{"type":"verse","number":19,"content":["ཅི་ལ་ཞེ་ན། ཛ་ཡན་ལས་སྨྲེ་སྔགས་འདོན་པའི་སྒྲ་གྲགས་འོངས་ཏེ་ན་རེ། བདག་ཅག་ཕམ་པར་གྱུར་ཅིང་ཇི་འདྲའི་ངོ་ཚ་བ་ལ། བདག་ཅག་གིས་ཡུལ་ཁམས་དོར་ནས་མི་ཡིས་རང་རེའི་ཁྱིམ་གཞིས་མེད་པར་བཟོས་སོང་ཞེས་སྨྲའོ་ཞེས་གསུངས།"]},{"type":"verse","number":20,"content":["ཀྱེ་བུད་མེད་རྣམས། དཀོན་མཆོག་ཡ་ཝཱེའི་གསུང་ལ་ཉོན་ཅིག ཁྱོད་ཚོའི་བུ་མོ་རྣམས་ལ་མྱ་ངན་ཞུ་ལུགས་སློབས་དང་། མི་རེ་རེས་རང་གི་ཁྱིམ་མཚེས་ལ་སྐྱོ་གླུ་བསླབ་དགོས།"]},{"type":"verse","number":21,"content":["ཅི་ལ་ཞེ་ན། འཆི་བ་དཀར་ཁུང་ནས་ཡར་འོངས་ཏེ་རང་ཅག་གི་བཙན་རྫོང་དུ་འཛུལ་བྱུང་། དེས་ཕྱི་རོལ་ཏུ་བྱིས་པ་རྣམས་ཚར་གཅོད་པ་དང་། ཐང་ཆེན་དུ་ན་གཞོན་དག་ཚར་གཅོད་པར་བྱེད་དོ། །"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱིས་འདི་ལྟར་སྨྲ་འོས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། མི་ཡི་བེམ་པོ་ནི་ཞིང་ཁའི་ལུད་བཞིན་འཕྲེད་དུ་ཉལ་བ་དང་། ཡང་ལོ་ཏོག་རྔ་མཁན་རྣམས་ཀྱི་རྗེས་སུ་ལུས་པའི་སྙེ་མ་བཞིན་དུ་སྡུད་མཁན་མེད་ཅེས་གསུངས།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཤེས་རབ་ཅན་གྱིས་རང་གི་ཤེས་རབ་ཀྱི་ཕྱིར་ཁ་ཕོ་མ་གཏོང་ཞིག སྟོབས་ཤུགས་ཅན་གྱིས་རང་གི་སྟོབས་ཤུགས་ཀྱི་ཕྱིར་ཁ་ཕོ་མ་གཏོང་ཞིག ཕྱུག་པོས་ཀྱང་རང་གི་རྒྱུ་ནོར་གྱི་ཕྱིར་ཁ་ཕོ་མ་གཏོང་ཞིག"]},{"type":"verse","number":24,"content":["བསྔགས་བརྗོད་བྱེད་མཁན་གྱིས་རང་ལ་བློ་གྲོས་ལྡན་ཞིང་བདག་ནི་ཡ་ཝཱེ་ཡིན་པ་ཤེས་པ་དང་། ཡང་བདག་ནི་ས་གཞིའི་སྟེང་དུ་བྱམས་བརྩེ་དང་དྲང་གཞག དྲང་བདེན་བཅས་སྤྱོད་པར་དགའ་བ་རྟོགས་པའི་རྐྱེན་གྱིས་བསྔགས་འོས་ཞེས་གསུངས་ཏེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །"]},{"type":"verse","number":25,"content":["ལྟོས་ཤིག དུས་དེ་སླེབས་ལ་ཉེའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་ཏེ། བདག་གིས་ལུས་ཕུང་འབའ་ཞིག་ཏུ་མཚན་སྐྱི་བཅད་པ་རྣམས་ལ་ཉེས་ཆད་གཅོད་པར་འགྱུར་ཏེ།"]},{"type":"verse","number":26,"content":["དེ་ནི་ཨེ་ཅིབ་དང་ཡ་ཧུ་དཱ། ཨེ་དོམ། ཨམ་མོན། མོ་ཨབ་བཅས་དང་དབེན་སྟོང་དུ་གནས་ཤིང་ཡ་ཐོད་ཀྱི་སྐྲ་གཞར་མཁན་ཐམས་ཅད་དོ། །ཅི་ལ་ཞེ་ན། མི་རིགས་འདི་ཐམས་ཅད་གཙང་མར་མ་མཛད་དེ། ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཀུན་གྱི་སེམས་ཀྱང་གཙང་མར་མ་མཛད་པའི་ཕྱིར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}