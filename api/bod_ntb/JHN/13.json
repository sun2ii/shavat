{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":13,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རང་གི་ཐུགས་སྲས་ཀྱི་རྐང་པ་བཀྲུ་བར་མཛད༌པ།"]},{"type":"verse","number":1,"content":["པེ་སག་གི་དུས་ཆེན་གྱི་སྔོན༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་འཇིག་རྟེན་འདི་དང་ཁ་བྲལ་ནས་ཡབ་ཀྱི་དྲུང་དུ་གཤེགས་དགོས་པའི་དུས་ལ་བབས་པ་མཁྱེན་པ༌དང༌། ཁོང་གིས་འཇིག་རྟེན་འདིའི་རང་ཉིད་ལ་གཏོགས་པའི་རྗེས་འབྲང་པ་རྣམས་ལ་གཏན་དུ་བྱམས་ཤིང་གཅེས་ལ། དུས་མཐའ་མའི་བར་དུའང་བྱམས་པར་མཛད༌དོ།།"]},{"type":"verse","number":2,"content":["དེ་ནས་དགོང་ཟས་བཞེས་པའི་དུས༌སུ། བདུད་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་ངོ་ལོག་བྱེད་པའི་བསམ་ཚུལ༌དེ་ནི་སྔར་ནས་ཨི་སི་ཀར་རེའི་སི་མོན་གྱི་བུ་ཡུ་དཱའི་སེམས་སུ་བཞག༌ཡོད་པ་རེད།"]},{"type":"verse","number":3,"content":["ཡབ་ཀྱིས་དབང་ཐམས་ཅད་རང་གི་ཕྱག་ལ་སྤྲད་པ་དང་རང་ཉིད་ནི་དཀོན་མཆོག་ནས་འོངས་ཤིང་སླར་ཡང་དཀོན་མཆོག་གི་དྲུང་དུ་གཤེགས་དགོས་པ་སྐྱབས་མགོན་ཡེ་ཤུས་མཁྱེན༌ཏེ།"]},{"type":"verse","number":4,"content":["བཞུགས་གྲལ་ནས་ཡར་བཞེངས་ཤིང་ཕྱི་གོས་ཕུད་དེ་རས་ལེབ་ཅིག་རྐེད་པར་དཀྲིས༌རྗེས།"]},{"type":"verse","number":5,"content":["གཞོང་པའི་ནང་དུ་ཆུ་བླུགས་ཏེ་ཐུགས་སྲས་རེ་རེའི་རྐང་པ་བཀྲུས་པ་དང་རྐེད་པའི་རས་ལེབ་བླངས་ནས་ཕྱིས༌པ་རེད།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཐུགས་སྲས་སི་མོན་པེ་ཏྲོའི་རྐང་པ་བཀྲུ་བར་ཕྲད་པ་ན་ཁོ་ན༌རེ། གཙོ་བོ༌ལགས། ཁྱེད་ཀྱིས་བདག་གི་རྐང་པ་བཀྲུ་འདོད་དམ་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":7,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་གང་ཞིག་བྱེད་པ་འདི་ད་ལྟ་ཁྱོད་ཀྱིས་མི་རྟོགས་ཀྱང་རྗེས་སུ་རྟོགས་པར་ངེས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":8,"content":["ཡང་པེ་ཏྲོ་ན༌རེ། ཁྱེད་ཀྱིས་ནམ་ཡང་བདག་གི་རྐང་པ་བཀྲུ་མི་འོས་ཞེས་ཞུས་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་ངས་ཁྱོད་མ་བཀྲུས༌ན། ཁྱོད་ནི་བདག་དང་འབྲེལ་བ་མེད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":9,"content":["ཡང་སི་མོན་པེ་ཏྲོ་ན༌རེ། གཙོ་བོ༌ལགས། ཁྱེད་ཀྱིས་ངའི་རྐང་པ་ཙམ་མ༌ཟད། ངའི་ལག་པ་དང་མགོ་བོའང་བཀྲུ་བར་མཛོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":10,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྲུས་བྱས་མྱོང་བ་རྣམས་ཀྱི་ལུས་ཧྲིལ་པོ་གཙང༌བ་ཡིན། རྐང་པ་ལས་གཞན་རང་གི་ལུས་པོ་བཀྲུ་མི་དགོས༌ལ། ཁྱོད་རྣམས་ནི་གཙང་མ་ཡིན་ཡང་ཐམས་ཅད་གཙང་མ་མིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":11,"content":["དོན་ནི་སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ལ་ངོ་ལོག་བྱེད་མཁན་སུ་ཡིན་པ་མཁྱེན༌པས། ཁྱོད་རྣམས་ཐམས་ཅད་གཙང་བ་མ་ཡིན་ཞེས་པའོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ཀྱི་རྐང་པ་བཀྲུས་ཚར༌རྗེས། ཕྱི་གོས་མནབས་ཤིང་སླར་ཡང་བཞུགས་ཏེ་འདི་སྐད༌དུ། ངས་ཁྱོད་རྣམས་ལ་ཅི་བྱས་པ་འདི་ཁྱོད་རྣམས་ཀྱིས་ཤེས༌སམ།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་ལ་སློབ་དཔོན་ནམ་གཙོ་བོ་ཞེས་འབོད་ཅིང༌། བདག་ནི་དངོས་གནས་དེ་ཉིད་ཡིན་པས་ཁྱོད་ཅག་གིས་སྨྲས་པའང་བདེན༌པ་ཡིན།"]},{"type":"verse","number":14,"content":["བདག་ནི་ཁྱོད་རྣམས་ཀྱི་གཙོ་བོ་དང་སློབ་དཔོན་ཡིན་ཡང་ངས་ཁྱོད་རྣམས་ཀྱི་རྐང་པ་བཀྲུས༌པས། ཁྱོད་ཅག་གིས་ཀྱང་ཕན་ཚུན་གྱི་རྐང་པ་བཀྲུ་འོས།"]},{"type":"verse","number":15,"content":["ངས་ཁྱོད་རྣམས་ལ་མིག་དཔེ་བསྟན༌ཅིང༌། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་བདག་བཞིན་དུ་བྱ་འོས༌པ་ཡིན།"]},{"type":"verse","number":16,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། གཡོག་པོ་ནི་བདག་པོ་ལས་ཆེན་པོ་ཡིན་མི་སྲིད༌ཅིང༌། མངག་བྱའི་མི་སྣའང་མངགས་མཁན་ལས་ཆེན་པོ་མིན།"]},{"type":"verse","number":17,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་དོན་དེ་རྟོགས་པས་དེ་བཞིན་དུ་བྱེད་ན་ཁྱོད་རྣམས་ལའང་བདེ་བ་དང་ལྡན་པར༌ངེས།"]},{"type":"verse","number":18,"content":["བདག་གིས་གཏམ་འདི་ཁྱོད་ཅག་ཐམས་ཅད་ལ་སྨྲས་པ་མིན༌ལ། བདག་གིས་སུ་ཞིག་བདམས་པ་ངས་ཀྱང་ཤེས་སོ།། དེ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"བདག་དང་མཉམ་དུ་ཁ་ཟས་སྤྱོད་མཁན༌གྱིས།།","poem":1},{"lineBreak":true},{"text":"བདག་ལ་རྐང་པའི་ཕྱི་རྟིང་བསྟན་པ་ཡིན།།","poem":1},"ཞེས་གསུངས་པ་བཞིན་འགྲུབ་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":19,"content":["ད་ལྟ་དོན་དེ་མ་འགྲུབ་པའི་སྔོན༌དུ། བདག་གིས་ཐོག་མར་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། དོན་དེ་འགྲུབ་པའི་དུས་སུ་ཁྱོད་རྣམས་ཀྱིས་ང་རང་དེ་ཉིད་ཡིན་པ་ལ་དད་པ་བྱེད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":20,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། མི་སུས་ཀྱང་ངས་མངགས་པ་གང་ཞིག་ལ་བསུ་བ་བྱས་ན་ང་རང་ལའང་བསུ་བ་བྱས་པ༌ཡིན། ང་རང་ལ་བསུ་བ་བྱས་ན་དོན་དམ་དུ་ང་རང་མངགས་མཁན་ལའང་བསུ་བ་བྱས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་ངོ་ལོག་པའི་མཚང་བརྟོལ༌བ།"]},{"type":"verse","number":21,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་སྐད་གསུངས་པ་དང་ཐུགས་སྐྱོ་བར་གྱུར་ནས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། ཁྱོད་རྣམས་ལས་མི་གཅིག་གིས་ང་རང་ལ་ངོ་ལོག་བྱ་ངེས་ཡིན་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":22,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་བལྟས་ཀྱང་ཁོང་གིས་གསུངས་པའི་མི་དེ་སུ་ཡིན་མ་ཤེས་པར་ཐེ་ཚོམ་སྐྱེས་སོ།།"]},{"type":"verse","number":23,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་བྲང་དུ་སྔས་པའི་ཁོང་གི་གཅེས་པའི་ཐུགས་སྲས་",{"noteId":17},"དེ༌ལ།"]},{"type":"verse","number":24,"content":["སི་མོན་པེ་ཏྲོས་བརྡ་བསྟན་ཏེ་ན༌རེ། ཁྱོད་ཀྱིས་ཤོད༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་སུ་ཞིག་ལ་གསུངས་པ་ཡིན་ནམ་ཞེས་དྲིས་སོ།།"]},{"type":"verse","number":25,"content":["ཐུགས་སྲས་དེས་རང་གི་མགོ་བོ་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་བྲང་ལ་བསྔས༌ཏེ། གཙོ་བོ༌ལགས། མི་དེ་སུ་ཡིན་ནམ་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":26,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ངས་བག་ལེབ་དུམ་བུ་འདི་སྡེར་མའི་ནང་ལ་སྦངས་ནས་སུ་ཞིག་ལ་བྱིན་ན་དེ་ཡིན་ཞེས་གསུངས༌རྗེས། ཁོང་གིས་བག་ལེབ་དུམ་བུ་དེ་སྡེར་མའི་ནང་ལ་སྦངས་རྗེས་ཨི་སི་ཀར་རེའི་སི་མོན་གྱི་བུ་ཡུ་དཱ་ལ་གནང༌ངོ་༎"]},{"type":"verse","number":27,"content":["ཡུ་དཱས་ཀྱང་བག་ལེབ་སྦངས་མ་དེ་ཚུར་བླངས་མ་ཐག་བདུད་སཱ་ཏན་ཡང་ཁོའི་སེམས་ནང་དུ་ཞུགས་པ་རེད། དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཡུ་དཱ་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་བྱ་བ་གང་ཞིག་འདོད་པ་དེ་མྱུར་དུ་སྒྲུབས་ཤིག་ཅེས་གསུངས༌ནའང༌།"]},{"type":"verse","number":28,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་དང་ལྷན་དུ་གྲལ་ལ་བཞུགས་པའི་མི་སུས་ཀྱང་ཁོང་གིས་ཅིའི་ཕྱིར་དེ་ལྟར་གསུངས་པའི་དོན་མ་རྟོགས་སོ།།"]},{"type":"verse","number":29,"content":["རྒྱུ་མཚན་ནི་ཐུགས་སྲས་ལ་ལས་ཡུ་དཱའི་ལག་ཏུ་དངུལ་ཁུག་བཟུང་ཡོད༌པས། སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རང་ནི་དུས་ཆེན་ལ་མཁོ་བའི་དངོས་རྫས་ཉོ་བར་བསྐུལ༌བའམ། ཡང་ན་དབུལ་པོ་རྣམས་ལ་གང་ཞིག་སྦྱིན་པར་གསུངས་པར་བསམས་སོ།།"]},{"type":"verse","number":30,"content":["དེ་ནས་ཡུ་དཱས་བག་ལེབ་སྦངས་མ་དེ་བླངས་མ་ཐག་ཕྱི་རོལ་ཏུ་སོང་བ་དང་དུས་དེ་ནི་མཚན་མོ་ཡིན༌ནོ།།"]},{"type":"heading","content":["པེ་ཏྲོ་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་དང་འགལ་བའི་ལུང་བསྟན།"]},{"type":"verse","number":31,"content":["དེ་ནས་ཡུ་དཱ་ཕྱི་རོལ་ཏུ་སོང་བ་དང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ད་ནི་མིའི་བུ་གཟི་བརྗིད་དང་ལྡན་པར་འགྱུར་ཞིང་དཀོན་མཆོག་གི་གཟི་བརྗིད་ཀྱང་མིའི་བུ་བརྒྱུད་ནས་མངོན་པར་འགྱུར༌ལ།"]},{"type":"verse","number":32,"content":["ཡང་དཀོན་མཆོག་གི་གཟི་བརྗིད་མིའི་བུ་བརྒྱུད་ནས་མངོན་པར་འགྱུར་བས༌ན། དཀོན་མཆོག་རང་ཉིད་ཀྱིས་ཀྱང་མིའི་བུ་གཟི་བརྗིད་དང་ལྡན་པར་མཛད་དེ་མྱུར་བ་མྱུར་དུ་མཛད་ངེས༌ཡིན།"]},{"type":"verse","number":33,"content":["བདག་གི་གཅེས་པའི་བུ༌རྣམས། བདག་ནི་ད་དུང་དུས་ཐུང་ངུ་ཙམ་ལ་ཁྱོད་ཅག་དང་མཉམ་དུ་ཡོད༌དེ། རྗེས་སུ་ཁྱོད་ཅག་གིས་ང་རང་འཚོལ་བར་འགྱུར་ནའང་། བདག་གིས་དེ་སྔར་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་སྨྲས་པ་བཞིན་ད་ནི་ཁྱོད་རྣམས་ལའང་སྨྲ་བར་བྱ༌སྟེ། ང་རང་འགྲོ་བའི་གནས་སུ་ཁྱོད་རྣམས་འགྲོ་མི་ནུས་སོ།།"]},{"type":"verse","number":34,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་བཀའ་གསར་པ་ཞིག་གནང་བར༌བྱའོ།། དེ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་པར་བྱེད་དགོས་པ༌དེ་ཡིན། ངས་ཁྱོད་རྣམས་ལ་བྱམས་ཤིང་གཅེས་པ་བཞིན་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཕན་ཚུན་ལ་གཅེས་དགོས།"]},{"type":"verse","number":35,"content":["ཁྱོད་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་པར་བྱས༌ན། མི་ཐམས་ཅད་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་བདག་གི་རྗེས་འབྲང་པ་ཡིན་པ་ཤེས་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":36,"content":["དེ་ནས་སི་མོན་པེ་ཏྲོ་ན༌རེ། གཙོ་བོ༌ལགས། ཁྱེད་ཉིད་གང་དུ་ཕེབས་སམ་ཞེས་ཞུས་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ང་རང་འགྲོ་བའི་གནས་སུ་ད་ལྟ་ཁྱོད་རང་བདག་གི་རྗེས་སུ་འབྲངས་ནས་འགྲོ་མི་ཐུབ༌ཀྱང༌། ཕྱིས་སུ་བདག་གི་རྗེས་སུ་འབྲང་བར་འགྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":37,"content":["ཡང་པེ་ཏྲོ་ན༌རེ། གཙོ་བོ༌ལགས། ད་ལྟ་ང་རང་ཅིའི་ཕྱིར་ཁྱེད་ཀྱི་རྗེས་སུ་འབྲང་མི་ཐུབ༌བམ། ངས་ཁྱེད་ཀྱི་དོན་དུ་རང་སྲོག་ཀྱང་བློས་གཏོང་བར་བྱའོ་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":38,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་བདག་གི་དོན་དུ་རང་སྲོག་ཀྱང་བློས་གཏོང་ཐུབ༌བམ། ངས་ཁྱོད་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། བྱ་ཕོ་མ་གྲགས་པའི་སྔོན༌དུ། ཁྱོད་ཀྱིས་ང་རང་ཐེངས་གསུམ་ལ་ཁས་མི་ལེན་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":17,"caller":"+","text":"གཅེས་པའི་ཐུགས་སྲས་ཞེས་པ་འདི་ཧ་ལམ་འཕྲིན་བཟང་འདི་ཡི་གེར་འགོད་མཁན༌ཏེ། ཐུགས་སྲས་ཡོ་ཧ་ནན་ལ་ངོས་འཛིན་དགོས་པ༌ཡིན། གཤམ་དུ་འབྱུང་བའི་ཐུགས་སྲས་གཞན་དེ་ཉིད༌དམ། གཅེས་པའི་ཐུགས༌སྲས། ཡང་ན་ཐུགས་སྲས་འདི་ཞེས་པའང་གོང་ལྟར་ངོས་འཛིན་དགོས་པར་དམ་པའི་གསུང་རབ་ཀྱི་མཁས་པ་རྣམས་ཀྱིས༌གསུངས།","reference":{"chapter":13,"verse":23}}]},"thisChapterLink":"/api/bod_ntb/JHN/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/12.json","previousChapterAudioLinks":{},"numberOfVerses":38}