{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":15,"content":[{"type":"heading","content":["རྒུན་འབྲུམ་ཤིང་གི་དཔེ་བསྟན༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ང་རང་ནི་རྒུན་འབྲུམ་ཤིང་དངོས་ཡིན་ཏེ། བདག་གི་ཡབ་ནི་རྒུན་འབྲུམ་ཤིང་གི་བདག་པོ་ཡིན།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་བདག་ལ་འབྲེལ་བའི་ཡལ་ག་ལས་འབྲས་བུ་མི་ཐོགས་པ་ཐམས་ཅད་གཅོད་པར་བྱེད༌ཅིང༌། འབྲས་བུ་ཐོགས་པའི་ཡལ་ག་ལ་འབྲས་བུ་དེ་ལས་ཀྱང་ལྷག་པ་ཞིག་སྨིན་པའི་ཕྱིར་ཡལ་ག་འབྲེག་བཅོས་མཛད་དོ།།"]},{"type":"verse","number":3,"content":["ད་ལྟ་བདག་གིས་ཁྱོད་རྣམས་ལ་བཀའ་གསུངས༌པས། ཁྱོད་རྣམས་ཀྱང་གཙང་མར་གྱུར༌པ་ཡིན།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་བདག་གི་ནང་དུ་གནས་པར་གྱིས། ང་རང་ཡང་ཁྱོད་ཅག་གི་ནང་དུ་གནས་པར༌བྱའོ།། ཡལ་ག་གང་ཞིག་རྒུན་འབྲུམ་ཤིང་གི་སྟེང་དུ་མ་གནས་ན་རང་ཉིད་ལ་འབྲས་བུ་མི་ཐོགས་པ༌ལྟར། ཁྱོད་རྣམས་ཀྱང་བདག་གི་ནང་དུ་མི་གནས་ན་ཁྱོད་ཅག་ལའང་འབྲས་བུ་མི་འབྱུང་ངོ༌།།"]},{"type":"verse","number":5,"content":["ང་རང་ནི་རྒུན་འབྲུམ་ཤིང་ཡིན་ཞིང་ཁྱོད་ཅག་ནི་ཡལ་ག༌སྟེ། སུ་ཞིག་ངའི་ནང་དུ་གནས་ཤིང་ང་རང་ཡང་ཁོའི་ནང་དུ་གནས་ན་མི་དེ་ལ་འབྲས་བུ་མང་པོ་འབྱུང༌བ་ཡིན། གལ་ཏེ་ང་རང་དང་ཁ་བྲལ་ན་ཁྱོད་རྣམས་ཀྱིས་ཅི་ཡང་བྱ་མི་ནུས་སོ།།"]},{"type":"verse","number":6,"content":["ངའི་ནང་དུ་མི་གནས་པ་དེ་ཕྱི་རུ་འཕངས་པའི་ཡལ་ག་བཞིན་དུ་བསྐམ་པར་འགྱུར་བ་དང༌། མི་ཡིས་བཏུས་ནས་མེ་ལ་བསྲེག་པར་འགྱུར།"]},{"type":"verse","number":7,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ངའི་ནང་དུ་གནས་ཤིང་ང་ཡི་བཀའ་ཡང་ཁྱོད་ཅག་གི་ནང་དུ་གནས༌ན། ཁྱོད་རྣམས་ཀྱིས་གང་ཞིག་ཞུས་དང་འགྲུབ་པར་འགྱུར་རོ།།"]},{"type":"verse","number":8,"content":["ཁྱོད་ཅག་ལ་འབྲས་བུ་མང་པོ་འཐོག་ན། ཁྱོད་རྣམས་ཀྱང་བདག་གི་རྗེས་འབྲང་པ་ཡིན་པར་མངོན་ཞིང་། དེའི་སྒོ་ནས་ངའི་ཡབ་ཀྱི་གཟི་བརྗིད་མངོན་པར་འགྱུར།"]},{"type":"verse","number":9,"content":["ཡབ་ཀྱིས་བདག་ལ་བྱམས་པ་བཞིན་ངས་ཀྱང་ཁྱོད་རྣམས་ལ་བྱམས༌པ་ཡིན། ཁྱོད་རྣམས་ཀྱང་བདག་གི་བྱམས་པའི་ནང་དུ་གནས་པར༌གྱིས།"]},{"type":"verse","number":10,"content":["བདག་གིས་ཡབ་ཀྱི་བཀའ་རྣམས་བསྲུངས་ཤིང་ཁོང་གི་བྱམས་པའི་ནང་དུ་གནས་པ༌བཞིན། ཁྱོད་རྣམས་ཀྱིས་ཀྱང་བདག་གི་བཀའ་རྣམས་བསྲུངས་ན། ཁྱོད་ཅག་བདག་གི་བྱམས་པའི་ནང་དུ་གནས་པར་འགྱུར་རོ།།"]},{"type":"verse","number":11,"content":["དེ་ཡང་བདག་གིས་དོན་དེ་རྣམས་ཁྱོད་ཅག་ལ་སྨྲས་པ༌ནི། བདག་གི་དགའ་སྤྲོ་ཁྱོད་ཅག་གི་སེམས་ནང་དུ་གནས་ཤིང་ཁྱོད་རྣམས་ལའང་དགའ་སྤྲོས་ཁེངས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":12,"content":["ངས་ཁྱོད་རྣམས་ལ་བྱམས་ཤིང་གཅེས་པ་ལྟར་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཕན་ཚུན་ལ་གཅེས་དགོས་པ་ནི་བདག་གི་བཀའ་ཡིན༌ཏེ།"]},{"type":"verse","number":13,"content":["མཛའ་གྲོགས་ཀྱི་དོན་དུ་རང་སྲོག་བློས་གཏོང་བ་དེ་ལས་ལྷག་པའི་བྱམས་པ་ཞིག་མེད།"]},{"type":"verse","number":14,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་བདག་གི་བཀའ་ལྟར་བསྒྲུབས༌ན། ཁྱོད་རྣམས་ཀྱང་བདག་གི་མཛའ་གྲོགས་ཡིན།"]},{"type":"verse","number":15,"content":["ད་ནས༌བཟུང༌། ངས་ཁྱོད་རྣམས་ལ་ཞབས་ཕྱི་བྱེད་མཁན་ཞེས་མི་ཟེར། རྒྱུ་མཚན་ནི་ཞབས་ཕྱི་བྱེད་པ་རྣམས་ཀྱིས་རང་གི་བདག་པོས་ཅི་བྱེད་པ་མི་ཤེས་པའི་ཕྱིར༌ཡིན། འོན་ཀྱང་ངས་རང་གི་ཡབ་ཀྱི་དྲུང་ནས་གང་ཞིག་ཐོས་པ་ཐམས་ཅད་ཁྱོད་རྣམས་ལ་སྨྲས༌པས། བདག་གིས་ཀྱང་ཁྱོད་རྣམས་ལ་མཛའ་གྲོགས་ཞེས་ཟེར་རོ།།"]},{"type":"verse","number":16,"content":["ཁྱོད་རྣམས་ཀྱིས་ང་རང་བདམས་པ་མ་ཡིན༌པར། ཁྱོད་རྣམས་སོང་ནས་འབྲས་བུ་སྨིན་པར་བྱེད་པ་དང་འབྲས་བུ་དེ་རྟག་ཏུ་གནས་པའི༌ཕྱིར། བདག་གིས་ཁྱོད་རྣམས་བདམས་ཤིང་བསྐོས༌སོ།། དེ་ནི་བདག་གི་མིང་ལ་བརྟེན་ནས་ཡབ་ལ་གང་ཞིག་ཞུས༌ན། ཁོང་གིས་ཁྱོད་རྣམས་ལ་དེ་གནང་བར་འགྱུར་བའི་ཕྱིར་ཡིན།"]},{"type":"verse","number":17,"content":["ཁྱོད་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་བྱམས་ཤིང་གཅེས་དགོས་པ་འདི༌ནི་བདག་གིས་གནང་བའི་བཀའ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["འཇིག་རྟེན་གྱི་མི་རྣམས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་སྲས་ལ་སྡང༌བ།"]},{"type":"verse","number":18,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་འཇིག་རྟེན་གྱི་མི་རྣམས་ཁྱོད་ཅག་ལ་སྡང་བ་ཡིན༌ན། ཁྱོད་རྣམས་ལ་མ་སྡང་བའི་སྔོན་དུ་ང་རང་ལ་སྡང་བ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་དགོས།"]},{"type":"verse","number":19,"content":["གལ་ཏེ་ཁྱོད་རྣམས་འཇིག་རྟེན་ལ་གཏོགས་པ་ཡིན༌ན། འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་རང་ལ་གཏོགས་པ་བཞིན་ཁྱོད་ཅག་ལ་བྱམས་ཤིང་བརྩེ་བ་ཡིན༌མོད། འོན་ཀྱང་ཁྱོད་རྣམས་འཇིག་རྟེན་ལ་མི་གཏོགས་ཤིང་། ངས་འཇིག་རྟེན་འདི་ལས་ཁྱོད་རྣམས་བདམས་པ་ཡིན་པས་འཇིག་རྟེན་གྱི་མི་རྣམས་ཁྱོད་ཅག་ལ་སྡང༌བ་ཡིན།"]},{"type":"verse","number":20,"content":["བདག་གིས་དེ་སྔར་ཁྱོད་རྣམས་ལ་གཡོག་པོ་ནི་བདག་པོ་ལས་ཆེན་པོ་ཡིན་མི་སྲིད་ཅེས་སྨྲས་པ་དེ་དྲན་པར༌གྱིས། འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་བདག་ལ་གནོད་འཚེ་བྱས་ན། ཁྱོད་རྣམས་ལའང་གནོད་འཚེ་བྱེད་པར་འགྱུར་བ༌དང༌། དེ་དག་གིས་ངའི་བཀའ་བསྲུངས་ཡོད་ན། ཁྱོད་ཅག་གི་བཀའ་ཡང་བསྲུང་བར་འགྱུར་རོ།།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་ངའི་མིང་གི་རྐྱེན་གྱིས་ཁྱོད་ཅག་ལ་དོན་དེ་ཐམས་ཅད་བྱེད་པར་འགྱུར་རོ།། རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ཀྱིས་ང་རང་མངགས་མཁན་ངོ་མི་ཤེས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":22,"content":["གལ་ཏེ་ང་རང་ཡོང་ནས་མི་དེ་རྣམས་ལ་ཆོས་མ་བཤད་ན་ཁོ་རྣམས་ལ་སྡིག་པ་མེད༌མོད། འོན་ཀྱང་ད་ལྟ་མི་དེ་རྣམས་ཀྱི་སྡིག་པ་གཞན་ལ་སྙད་འདོགས་ཐབས་མེད།"]},{"type":"verse","number":23,"content":["ང་རང་ལ་སྡང་མཁན་ནི་བདག་གི་ཡབ་ལའང་སྡང་བ་ཡིན།"]},{"type":"verse","number":24,"content":["གལ་ཏེ་ངས་མི་གཞན་སུས་ཀྱང་བྱས་མ་མྱོང་བའི་དོན་རྣམས་ཁོ་རྣམས་ཀྱི་ཁྲོད་དུ་མ་བྱས་ན། དེ་རྣམས་ལའང་སྡིག་པ་མེད་དོ།། འོན་ཀྱང་ཁོ་རྣམས་ཀྱིས་དོན་དེ་རྣམས་མཐོང་མྱོང་ཡང་བདག་དང་བདག་གི་ཡབ་ལ་སྡང་བ་ཡིན།"]},{"type":"verse","number":25,"content":["དོན་དེ་ནི་ཁོ་ཚོའི་བཀའ་ཁྲིམས་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁོ་རྣམས་དོན་མེད་བདག་ལ་སྡང་ཞེས་པ་དེ་ཉིད་འགྲུབ་པའི་ཕྱིར་དེ་ལྟར་བྱུང་བ་ཡིན༌ནོ།།"]},{"type":"verse","number":26,"content":["དེ་ཡང་བདག་གིས་ཡབ་ནས་བྱུང་བའི་སྡོངས་གྲོགས་ཏེ། བདེན་པ་ཉིད་ཀྱི་དམ་པའི་ཐུགས་ཉིད་ནི་ཡབ་ཀྱི་དྲུང་ནས་ཁྱོད་ཅག་ལ་མངགས་ཤིང་བྱོན༌ཚེ། ཁོང་གིས་བདག་ལ་བདེན་དཔང་མཛད་པར་འགྱུར།"]},{"type":"verse","number":27,"content":["ཁྱོད་རྣམས་ཀྱིས་ཀྱང་བདག་ལ་བདེན་དཔང་བྱེད་པར་འགྱུར་རོ།། ཅིའི་ཕྱིར་ཞེ་ན་ཐོག་མ་ནས་ཁྱོད་རྣམས་བདག་དང་ལྷན་དུ་འགྲོགས་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JHN/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}