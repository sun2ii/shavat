{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":17,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ཀྱི་ཆེད་དུ་གསོལ་བ་བཏབ༌པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་སྐད་གསུངས་རྗེས་ནམ་མཁའི་ཕྱོགས་སུ་གཟིགས་ཏེ་འདི་སྐད༌དུ། ཡབ་ལགས། ད་ནི་དུས་དེ་སླེབས༌པ་ཡིན། དེ་ཡང་སྲས་ཀྱིས་ཁྱེད་ཀྱི་གཟི་བརྗིད་མངོན་པར་བྱེད༌ཆེད། ཁྱེད་ཀྱིས་སྲས་གཟི་བརྗིད་དང་ལྡན་པར༌མཛོད།"]},{"type":"verse","number":2,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཁྱེད་ཀྱིས་ཤ་ཁྲག་གདོས་བཅས་ཀྱི་མི་ཐམས་ཅད་ལ་དབང་བསྒྱུར་བའི་དབང་ཆ་ནི་སྲས་ལ་གནང་ཞིང་། དེ་ནི་ཁྱེད་ཀྱིས་ཁོ་ལ་གནང་བའི་མི་ཀུན་ལ་ཁོས་མཐའ་མེད་པའི་ཚེ་སྲོག་སྩོལ་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":3,"content":["དད་ལྡན་རྣམས་ཀྱིས་ཁྱེད་རང་ནི་བདེན་པའི་དཀོན་མཆོག་ཁོ་ན་དང་ཁྱེད་ཀྱིས་མངགས་པའི་ཡེ་ཤུ་མཱ་ཤི་ཀ་གཉིས་ངོ་ཤེས་པ་ནི་མཐའ་མེད་པའི་ཚེ་སྲོག་ཡིན་ནོ།།"]},{"type":"verse","number":4,"content":["ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་ལས་ཐམས་ཅད་བདག་གིས་བསྒྲུབས་ཟིན་ཏེ། ས་གཞིའི་སྟེང་དུ་ཁྱེད་ཀྱི་གཟི་བརྗིད་ཀྱང་མངོན་པར་བྱས།"]},{"type":"verse","number":5,"content":["ཡབ་ལགས། འཇིག་རྟེན་མ་བསྐྲུན་པའི་སྔོན༌ལ། ང་རང་ཁྱེད་དང་ལྷན་དུ་བཞུགས་པའི་དུས་ཀྱི་གཟི་བརྗིད་དེ་ཉིད། ད་ལྟ་ཁྱེད་ཀྱི་དྲུང་དུ་སླར་ཡང་བདག་ལ་གནང་བར་མཛོད་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ཀྱི་ཆེད་དུ་གསོལ་བ་བཏབ༌པ།"]},{"type":"verse","number":6,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཁྱེད་ཀྱིས་འཇིག་རྟེན་ལས་བདག་ལ་གནང་བའི་མི་རྣམས་ལ་ངས་ཀྱང་ཁྱེད་ཀྱི་མཚན་མངོན་པར་བྱས། དེ་རྣམས་སྔར་ནས་ཁྱེད་ལ་གཏོགས་ཤིང་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བ་དང་དེ་རྣམས་ཀྱིས་ཀྱང་ཁྱེད་ཀྱི་བཀའ་བསྲུངས༌སོ།།"]},{"type":"verse","number":7,"content":["ད་ལྟ་དེ་རྣམས་ཀྱིས་ཀྱང་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བ་ཐམས་ཅད་ཁྱེད་རང་ནས་བྱུང་བ་ཤེས་སོ།།"]},{"type":"verse","number":8,"content":["རྒྱུ་མཚན་ནི་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་བཀའ་རྣམས་ངས་ཀྱང་ཁོ་རྣམས་ལ་བསྩལ་ཅིང་དེ་དག་གིས་ཀྱང་དང་དུ་བླངས་པ༌དང༌། ཡང་ང་རང་ནི་དངོས་གནས་ཁྱེད་ཀྱི་དྲུང་ནས་ཡོང་བ་ཤེས་པ་དང་། ཁྱེད་ཀྱིས་ང་རང་མངགས་པ་ལའང་དེ་རྣམས་ཡིད་ཆེས༌སོ།།"]},{"type":"verse","number":9,"content":["ངས་ད་ལྟ་འཇིག་རྟེན་གྱི་མིའི་དོན་དུ་གསོལ་བ་འདེབས་པ་མ་ཡིན༌པར། ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་མི་དེ་རྣམས་ཀྱི་དོན་དུ་གསོལ་བ་འདེབས་པ་ཡིན། རྒྱུ་མཚན་ནི་ཁོ་རྣམས་ཁྱེད་ལ་གཏོགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":10,"content":["ཡང་བདག་གི་ཡིན་པ་ཐམས་ཅད་ཁྱེད་ལ་གཏོགས༌ཤིང༌། ཁྱེད་ལ་གཏོགས་པ་ཐམས་ཅད་བདག་ལའང་གཏོགས༌པ་དང་། དེ་དག་བརྒྱུད་ནས་བདག་གི་གཟི་བརྗིད་མངོན་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":11,"content":["ད་ནས་བཟུང་བདག་ནི་ཁྱེད་ཀྱི་དྲུང་དུ་ཡོང་བཞིན་ཡོད་པས་འཇིག་རྟེན་དུ་མི་གནས་ཀྱང་ཁོ་རྣམས་འཇིག་རྟེན་དུ་གནས༌པ་ཡིན། ཡབ་དམ་པ༌ལགས། འུ་གཉིས་ངོ་བོ་གཅིག་ཡིན་པ་བཞིན་ཁོ་རྣམས་ཀྱང་ངོ་བོ་གཅིག་ཏུ་འགྱུར་བའི༌ཕྱིར། ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་ཁྱེད་ཀྱི་མཚན་དེའི་ནང་དུ་ཁོ་རྣམས་ཀྱང་བསྲུང་བར༌མཛོད།"]},{"type":"verse","number":12,"content":["ང་རང་ཁོ་རྣམས་དང་མཉམ་དུ་ཡོད༌དུས། བདག་གིས་ཀྱང་ཁོ་རྣམས་ནི་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་མཚན་གྱི་ནང་དུ་བསྲུངས་ཤིང་བསྐྱངས༌ཏེ། ཁྱེད་ཀྱི་གསུང་རབ་ཀྱི་མདོ་འགྲུབ་པའི༌ཕྱིར། འཇིག་པའི་བུ་",{"noteId":19},"ལས་གཞན་གཅིག་ཀྱང་འཇིག་པར་མ་གྱུར༌ཏོ།།"]},{"type":"verse","number":13,"content":["ང་རང་ད་ལྟ་ཁྱེད་ཀྱི་དྲུང་དུ་ཡོང་ལ་ཉེ་ཡང་ད་དུང་འཇིག་རྟེན་དུ་བསྡད་ནས་འདི་ལྟར་བརྗོད་དོན་ནི་བདག་གི་དགའ་སྤྲོ་དེ་ཁོ་རྣམས་ཀྱི་སེམས་སུ་ཁྱབ་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":14,"content":["ངས་ཁྱེད་ཀྱི་བཀའ་ཁོ་རྣམས་ལ་བསྩལ་ཅིང་འཇིག་རྟེན་གྱི་མི་དག་ཁོ་རྣམས་ལ༌སྡང༌། རྒྱུ་མཚན་ནི་ང་རང་འཇིག་རྟེན་ལ་མི་གཏོགས་པ༌བཞིན། ཁོ་རྣམས་ཀྱང་འཇིག་རྟེན་ལ་མི་གཏོགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":15,"content":["ཁོ་རྣམས་འཇིག་རྟེན་ནས་འདྲེན་པའི་ཕྱིར་ངས་ཁྱེད་ལ་གསོལ་བ་མི་འདེབས༌པར། ཁྱེད་ཀྱིས་ཁོ་རྣམས་བདུད་ངན་དེ་ལས་བསྲུང་ཞིང་སྐྱོབ་པའི་ཕྱིར་གསོལ་བ་འདེབས༌པ་ཡིན།"]},{"type":"verse","number":16,"content":["ང་རང་འཇིག་རྟེན་ལ་མི་གཏོགས་པ་བཞིན་ཁོ་རྣམས་ཀྱང་འཇིག་རྟེན་ལ་མི་གཏོགས་སོ།།"]},{"type":"verse","number":17,"content":["ཁྱེད་ཀྱིས་བདེན་པ་ཉིད་བརྒྱུད་ནས་ཁོ་རྣམས་དམ་པར་མཛོད༌ཅིག ཁྱེད་ཀྱི་བཀའ་ནི་བདེན་པ་ཉིད་ལགས་སོ།།"]},{"type":"verse","number":18,"content":["ཁྱེད་ཀྱིས་ང་རང་འཇིག་རྟེན་དུ་ཇི་ལྟར་མངགས་པ༌བཞིན། ངས་ཀྱང་ཁོ་རྣམས་འཇིག་རྟེན་ལ་མངགས༌ཤིང་།"]},{"type":"verse","number":19,"content":["ཁོ་རྣམས་ཀྱང་བདེན་པ་ཉིད་ཀྱི་སྒོ་ནས་དམ་པར་འགྱུར་བའི༌ཕྱིར། ངས་ཁོ་རྣམས་ཀྱི་ཆེད་དུ་རང་ཉིད་དམ་པར་བྱ་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རྗེས་འབྲང་པ་ཐམས་ཅད་ཀྱི་དོན་དུ་གསོལ་བ་བཏབ༌པ།"]},{"type":"verse","number":20,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ངས་འདི་རྣམས་ཁོ་ནའི་ཆེད་དུ་གསོལ་བ་མི་འདེབས་པར་ཁོ་རྣམས་ཀྱིས་སྤེལ་བའི་ཆོས་ལ་མཉན་ནས་བདག་ལ་དད་པ་བྱེད་མཁན་ཐམས་ཅད་ཀྱི་དོན་དུའང་གསོལ་བ་འདེབས༌པ་ཡིན།"]},{"type":"verse","number":21,"content":["འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་ང་རང་ནི་ཁྱེད་ཀྱིས་མངགས་པ་ཡིན་པར་ཡིད་ཆེས་པའི༌ཕྱིར། ཡབ་ལགས། ཁྱེད་རང་ནི་ངའི་ནང་དུ་གནས་ཤིང་བདག་ཀྱང་ཁྱེད་ཀྱི་ནང་དུ་གནས་པ༌བཞིན། དད་པ་དང་ལྡན་པ་ཐམས་ཅད་ངོ་བོ་གཅིག་ཏུ་འགྱུར་བ་དང་དེ་རྣམས་ཀྱང་འུ་གཉིས་ཀྱི་ནང་དུ་གནས་པར༌ཞུའོ།།"]},{"type":"verse","number":22,"content":["འུ་གཉིས་ངོ་བོ་གཅིག་ཡིན་པ་ལྟར་དད་ལྡན་རྣམས་ཀྱང་ངོ་བོ་གཅིག་ཏུ་འགྱུར་བའི༌ཕྱིར། ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་གཟི་བརྗིད་དེ་ངས་ཀྱང་ཁོ་རྣམས་ལ་བསྩལ་ཟིན༌པ་ཡིན།"]},{"type":"verse","number":23,"content":["ང་རང་ནི་ཡབ་ཁྱེད་ཀྱིས་མངགས་པ་དང་ཁྱེད་ཀྱིས་བདག་ལ་གཅེས་པ་བཞིན། དད་ལྡན་རྣམས་ལའང་བྱམས་ཤིང་གཅེས་པ་དེ་འཇིག་རྟེན་གྱི་མི་རྣམས་ལ་ཤེས་སུ་འཇུག༌པའི་ཕྱིར། བདག་ནི་དད་ལྡན་རྣམས་ཀྱི་ནང་དུ་གནས་ཤིང་ཡབ་ཁྱེད་རང་ཡང་བདག་གི་ནང་དུ་གནས་པ་བཞིན། དད་ལྡན་རྣམས་ཀྱང་དངོས་གནས་ངོ་བོ་གཅིག་ཏུ་འགྱུར་བར༌ཞུའོ།།"]},{"type":"verse","number":24,"content":["ཡབ་ལགས། ཁྱེད་ཀྱིས་འཇིག་རྟེན་མ་བསྐྲུན་སྔོན་དུ་བདག་ལ་བྱམས་ཤིང་གཅེས༌པས། ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་གཟི་བརྗིད་དེ་དད་ལྡན་རྣམས་ཀྱིས་མཐོང་བའི༌ཕྱིར། ང་རང་གནས་གང་དུ་ཡོད་ན་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བའི་དད་ལྡན་རྣམས་ཀྱང་བདག་དང་ལྷན་དུ་ཡོད་པར༌མཛོད།"]},{"type":"verse","number":25,"content":["ཀྱེ། དྲང་བདེན་གྱི་ཡབ་ལགས། འཇིག་རྟེན་གྱི་མི་རྣམས་ཀྱིས་ཁྱེད་རང་ངོ་མི་ཤེས་ནའང་ངས་ཁྱེད་རང་ངོ་ཤེས༌ཏེ། དད་ལྡན་རྣམས་ཀྱིས་ང་རང་ནི་ཁྱེད་ཀྱིས་མངགས་པའང་ཤེས་སོ།།"]},{"type":"verse","number":26,"content":["ཁྱེད་ཀྱིས་བདག་ལ་བྱམས་ཤིང་གཅེས་པ་དེ་དད་ལྡན་རྣམས་ཀྱི་སེམས་སུ་གནས་པ༌དང༌། ང་རང་ནི་ཁོ་རྣམས་ཀྱི་ནང་དུ་གནས་པའི༌ཕྱིར་དུ། བདག་གིས་དད་ལྡན་རྣམས་ལ་ཁྱེད་ཀྱི་མཚན་མངོན་པར་བྱས་ཤིང་ད་དུང་མངོན་པར་འགྱུར་ཞེས་གསོལ་བ་བཏབ༌བོ།།"]}],"footnotes":[{"noteId":19,"caller":"+","text":"འདིར་འཇིག་པའི་བུ་ཞེས་པ་ལ་སྒྱུར་ཡིག་གཞན༌ལས། མེད་པར་གྱུར་པའི༌བུ། ཤི་ཟིན་པའི༌བུ། བོར་ཟིན་པའི་བུ་ཞེས་བྲིས༌འདུག དོན་ནི་དམྱལ་བའི་གནས་སུ་ལྷུང་བའི་བུ༌སྟེ། སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་སྲས་བཅུ་གཉིས་ལས་ཨི་སི་ཀར་རེའི་ཡུ་དཱ་ཞེས་བྱ་བའི་ངོ་ལོག་པ་ཞིག་ཡོད་པ་དེར་གོ༌དགོས།","reference":{"chapter":17,"verse":12}}]},"thisChapterLink":"/api/bod_ntb/JHN/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/16.json","previousChapterAudioLinks":{},"numberOfVerses":26}