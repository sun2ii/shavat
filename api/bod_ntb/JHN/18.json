{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":18,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་འཛིན་བཟུང་བྱས་པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་སྐད་གསུངས༌རྗེས། ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་ཕྱི་རོལ་ཏུ་ཕྱིན༌ཅིང༌། ཀིད་རོན་གྲམ་པ་བརྒལ་ནས་གནས་དེར་ཡོད་པའི་སྐྱེད་ཚལ་ཞིག་ཏུ་ཕེབས༌སོ།།"]},{"type":"verse","number":2,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཐུགས་སྲས་རྣམས་གནས་དེར་ཐེངས་མང་པོར་ཕེབས་ཏེ་ལྷན་དུ་འདུས་མྱོང༌བས། ཁོང་ཉིད་ལ་ངོ་ལོག་བྱེད་མཁན་ཡུ་དཱས་ཀྱང་གནས་དེ་ཤེས༌པ་རེད།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཡུ་དཱས་མཆོད་དཔོན་ཆེན་པོ་དག་དང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་མངགས་པའི་རོ་མཱ་གོང་མའི་རྒྱལ་ཁབ་ཀྱི་དམག་དཔུང་དང་སྲུང་དམག་འགའ་ཁྲིད༌དེ། ལག་ཏུ་སྒྲོན་མེ༌དང༌དཔལ་འབར། མཚོན་ཆ་བཅས་བཟུང་ནས་གནས་དེར་སླེབས་སོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ལ་འབྱུང་ངེས་པའི་དོན་ཐམས་ཅད་མཁྱེན༌ཏེ། མདུན་ཕྱོགས་སུ་ཕེབས་ཤིང་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་སུ་ཞིག་འཚོལ་བ་ཡིན་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":5,"content":["དེ་དག་ན༌རེ། ནཱ་ཙ་རེལ་པ་ཡེ་ཤུ་འཚོལ་བ་ཡིན་ཞེས་སྨྲས་པ༌ན། སྐྱབས་མགོན་ཡེ་ཤུས་དེ་ནི་ང་རང་ཡིན་ཞེས་གསུངས་སོ།། ཁོང་ལ་ངོ་ལོག་བྱེད་མཁན་ཡུ་དཱའང་དེ་དག་དང་མཉམ་དུ་ལངས་ནས་བསྡད་ཡོད༌པ་རེད།"]},{"type":"verse","number":6,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་ནི་ང་རང་ཡིན་ཞེས་གསུངས་མ་ཐག་དེ་རྣམས་ཕྱི་ནུར་སྟེག་བཞིན་ས་རུ་འགྱེལ་ཏོ།།"]},{"type":"verse","number":7,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་སུ་ཞིག་འཚོལ་བ་ཡིན་ནམ་ཞེས་གསུངས་པ༌ལ། ཡང་དེ་རྣམས་ན༌རེ། ནཱ་ཙ་རེལ་པ་ཡེ་ཤུ་འཚོལ་བ་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":8,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ངས་དེ་ནི་ང་རང་ཡིན་ཞེས་སྨྲས་ཟིན། ཁྱོད་ཅག་གིས་ང་རང་འཚོལ་བ་ཡིན་ན་འདི་རྣམས་འགྲོ་རུ་ཆུག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":9,"content":["དེ་ནི་ཁྱེད་ཀྱིས་བདག་ལ་གནང་བ་ལས་ངས་གཅིག་ཀྱང་མ་སྟོར་ཞེས་སྐྱབས་མགོན་ཡེ་ཤུས་གསུངས་མྱོང་བ་དེ་བཞིན་འགྲུབ་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":10,"content":["དེ་ནས་སི་མོན་པེ་ཏྲོས་རལ་གྲི་ཞིག་ཡོད་པ་ཕྱུང༌སྟེ། མཆོད་དཔོན་ཆེན་པོའི་གཡོག་པོར་བརྒྱབ་ནས་རྣ་བ་གཡས་པ་བཅད་ཅིང་། གཡོག་པོ་དེའི་མིང་ལ་མཱལ་ཀུ་ཟེར།"]},{"type":"verse","number":11,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་པེ་ཏྲོ་ལ་འདི་སྐད༌དུ། རལ་གྲི་ཤུབས་སུ་ཆུག་དང༌། ཡབ་ཀྱིས་བདག་ལ་གནང་བའི་ཕོར་བ་",{"noteId":20},"ནི་བདག་གིས་མི་འཐུང་ཅི་སྟེ་འཐུང་དགོས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་རོ་མཱ་གོང་མའི་རྒྱལ་ཁབ་ཀྱི་དམག་དཔུང༌དང༌དམག༌དཔོན། ཡ་ཧུ་དཱ་པའི་སྲུང་དམག་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་འཛིན་བཟུང་བྱས་ཏེ་བཀྱིགས་པ༌དང༌།"]},{"type":"verse","number":13,"content":["ཐོག་མར་ཨ་ནཱ་སིའི་དྲུང་དུ་ཁྲིད་དོ།། རྒྱུ་མཚན་ཨ་ནཱ་སི་ནི་ལོ་དེར་མཆོད་དཔོན་ཆེན་པོའི་འགན་འཁུར་བའི་ཀ་ཡ་ཕཱའི་གྱོས་པོ་ཡིན་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":14,"content":["ཀ་ཡ་ཕཱ་ནི་སྔོན་ཆད་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་མི་རྣམས་ཀྱི་ཆེད་དུ་མི་གཅིག་འཆི་བར་འགྱུར་བ་དེ་ལེགས་ཞེས་བགྲོ་གླེང་བྱེད་མཁན་དེ་ཡིན༌ནོ།།"]},{"type":"heading","content":["པེ་ཏྲོ་ཐེངས་དང་པོར་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་དང་འགལ༌བ།"]},{"type":"verse","number":15,"content":["སི་མོན་པེ་ཏྲོ་དང་ཐུགས་སྲས་གཞན་ཞིག་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུའི་རྗེས་སུ་འབྲངས་པ༌དང༌། ཐུགས་སྲས་གཞན་དེ་ཉིད་མཆོད་དཔོན་ཆེན་པོ་དང་ཕན་ཚུན་ངོ་ཤེས༌པས། ཁོ་རང་སྐྱབས་མགོན་ཡེ་ཤུ་དང་ལྷན་དུ་མཆོད་དཔོན་ཆེན་པོའི་ར་སྐོར་ནང་དུ་ཕྱིན་ཏོ།།"]},{"type":"verse","number":16,"content":["འོན་ཀྱང་པེ་ཏྲོ་སྒོའི་ཕྱི་རོལ་ཏུ་ལངས་ནས་བསྡད། དེ་ནས་མཆོད་དཔོན་ཆེན་པོ་ངོ་ཤེས་པའི་ཐུགས་སྲས་དེ་ཕྱིར་ཡོང༌སྟེ། སྒོ་སྲུང་གཡོག་མོ་ལ་ཚིག་འགའ་སྨྲས་རྗེས་པེ་ཏྲོའང་ནང་དུ་ཁྲིད།"]},{"type":"verse","number":17,"content":["དེ་ནས་སྒོ་སྲུང་གཡོག་མོ་དེས་པེ་ཏྲོ༌ལ། ཁྱོད་ཀྱང་མི་དེའི་ཐུགས་སྲས་མ་ཡིན་ནམ་ཞེས་སྨྲས་པ༌ན། ཁོས་ང་རང་མིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":18,"content":["ཉིན་དེར་ནམ་ཟླ་འཁྱགས་པས་གཡོག་པོ་དང་སྲུང་དམག་རྣམས་ཀྱིས་སོལ་བའི་མེ་སྦར་ཏེ་གནས་དེར་ལངས་ནས་མེར་ལྡེ་བ༌ལ། པེ་ཏྲོ་ཡང་དེ་དག་དང་མཉམ་དུ་མེར་ལྡེས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འདྲི་རྩད་བྱས་པ།"]},{"type":"verse","number":19,"content":["དེ་ནས་མཆོད་དཔོན་ཆེན་པོས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་རང་ཉིད་ཀྱི་ཐུགས་སྲས་དང་ཁོང་གིས་ཆོས་གསུངས་པའི་སྐོར་ནས་འདྲི་རྩད་བྱས་པ༌ན།"]},{"type":"verse","number":20,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ངས་མངོན་སུམ་དུ་འཇིག་རྟེན་གྱི་མི་རྣམས་ལ་ཆོས་བཤད་པ་ཡིན༌ཏེ། རྟག་ཏུ་ཡ་ཧུ་དཱ་པ་རྣམས་འཛོམས་སའི་ཆོས་ཁང་དང་མཆོད་ཁང་ནས་མི་རྣམས་ལ་ཆོས་བཤད་པ༌ཡིན། གསང་བའི་ངང་ནས་ཅི་ཡང་མ་སྨྲས།"]},{"type":"verse","number":21,"content":["ཅིའི་ཕྱིར་བདག་ལ༌འདྲིའམ། བདག་གི་གཏམ་ཐོས་པའི་མི་རྣམས་ཀྱིས་ངས་ཅི་ཞིག་སྨྲས་པ་ཤེས་པས་དེ་དག་ལ་དྲིས་ཤིག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":22,"content":["ཁོང་གིས་དེ་སྐད་གསུངས་པ༌ལ། ཉེ་འགྲམ་དུ་ལངས་ནས་སྡོད་པའི་སྲུང་དམག་ཅིག་གིས་ཁོང་ལ་འགྲམ་ལྕག་གཞུས་ཏེ་ན༌རེ། ཁྱོད་ཀྱིས་མཆོད་དཔོན་ཆེན་པོར་འདི་ལྟར་ལན་སློག་གམ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":23,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་ངས་མི་འོས་པའི་གཏམ་སྨྲས་ཡོད་ན་མི་འོས་པ་དེ་སྟོན༌ཅིག གལ་ཏེ་ངས་སྨྲས་པ་དེ་བདེན་པ་ཡིན་ན་ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་བདག་ལ་རྡུང་རྡེག་བྱེད་དམ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཨ་ནཱ་སི་ཡིས་སྐྱབས་མགོན་ཡེ་ཤུ་སྔར་བཞིན་བཀྱིགས༌ཏེ། མཆོད་དཔོན་ཆེན་པོ་ཀ་ཡ་ཕཱའི་མདུན་ལ་ཁྲིད་དུ་བཅུག༌གོ།"]},{"type":"heading","content":["པེ་ཏྲོ་ཡང་ཡང་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་དང་འགལ༌བ།"]},{"type":"verse","number":25,"content":["སི་མོན་པེ་ཏྲོ་ལངས་ནས་མེར་ལྡེ་བཞིན་པའི་དུས༌སུ། མི་དེ་རྣམས་ན༌རེ། ཁྱོད་རང་ཡང་ཁོང་གི་ཐུགས་སྲས་མ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན། ཁོས་ང་རང་མིན་ཞེས་ཁས་མ་བླངས༌སོ།།"]},{"type":"verse","number":26,"content":["དེ་སྔོན་པེ་ཏྲོས་རྣ་བ་བཅད་ཟིན་པ་དེའི་གཉེན་ཉེ་དང་མཆོད་དཔོན་ཆེན་པོའི་གཡོག་པོ་ཡིན་པ་ཞིག་ན༌རེ། ངས་སྐྱེད་ཚལ་ནང་དུ་ཁྱོད་རང་ཡེ་ཤུ་དང་མཉམ་དུ་ཡོད་པ་མཐོང་བ་མ་ཡིན་ནམ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":27,"content":["ཡང་པེ་ཏྲོས་ཁས་མ་བླངས༌ཤིང་། དེ་མ་ཐག་བྱ་ཕོའང་གྲགས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྤྱི་དཔོན་པི་ལ་ཏུའི་མདུན་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":28,"content":["ནམ་མ་ལངས་པའི་དུས༌སུ། ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་དཔོན་ཆེན་པོ་ཀ་ཡ་ཕཱའི་གམ་ནས་སྤྱི་དཔོན་གྱི་ཕོ་བྲང་དུ་ཁྲིད༌ཅིང༌། ཆོས་དཔོན་རྣམས་རང་ཉིད་མི་གཙང་བར་གྱུར༌ན། པེ་སག་གི་དུས་ཆེན་གྱི་ཟས་བཟའ་མི་ཐུབ་པར་དོགས་ཏེ་ཕོ་བྲང་ནང་དུ་མ་སོང༌ངོ་༎"]},{"type":"verse","number":29,"content":["དེ་ནས་སྤྱི་དཔོན་པི་ལ་ཏུ་ཕོ་བྲང་ནས་ཐོན་ཏེ་ན༌རེ། ཁྱོད་རྣམས་ཀྱིས་མི་འདི་ཁྲིམས་ལ་གཏུགས་དོན་ཅི་ཞེས་དྲིས་པ༌དང༌།"]},{"type":"verse","number":30,"content":["དེ་རྣམས་ན༌རེ། གལ་ཏེ་མི་འདི་ལས་ངན་པ་བྱེད་མཁན་ཞིག་མིན་ན་ངེད་ཅག་གིས་ཁྱེད་རང་ལ་སྤྲོད་མི་སྲིད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":31,"content":["དེ་ནས་པི་ལ་ཏུ་ན༌རེ། ཁྱོད་རྣམས་ཀྱིས་ཁོ་རང་ཕྱིར་ཁྲིད་དེ་ཁྱོད་ཅག་གི་ཆོས་ཁྲིམས་བཞིན་དུ་ཁྲིམས་ཐག་ཆོད་ཅིག་ཅེས་སྨྲས་པ༌ལ། ཡ་ཧུ་དཱ་པ་རྣམས་ན༌རེ། ངེད་ཅག་ལ་ཁྲིམས་ཐག་བཅད་ནས་མི་གསོད་པའི་དབང་ཆ་མེད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":32,"content":["དེ་ནི་སྔར་སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ཇི་ལྟར་སྐུ་གཤེགས་དགོས་པའི་སྐོར་ལུང་བསྟན་པ་བཞིན་དུ་འགྲུབ་པའི་ཕྱིར་བྱུང་བ་ཡིན།"]},{"type":"verse","number":33,"content":["དེ་ནས་པི་ལ་ཏུ་སླར་ཡང་ཕོ་བྲང་གི་ནང་དུ་སོང༌སྟེ། སྐྱབས་མགོན་ཡེ་ཤུའང་ཕོ་བྲང་ནང་དུ་འཁྲིད་པའི་བཀའ་གནང་ཞིང་ཁྱོད་རང་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":34,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། འདི་ནི་ཁྱོད་རང་གིས་བཤད་པ་ཡིན༌ནམ། ཡང་ན་མི་གཞན་གྱིས་བདག་གི་སྐོར་ཁྱོད་ལ་སྨྲས་པ་ཡིན་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":35,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། ང་རང་ནི་ཡ་ཧུ་དཱ་པ་ཞིག་ག་ལ༌ཡིན། ཁྱོད་ཀྱི་ཡུལ་མི་དང་མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་ཁྱོད་རང་བདག་ལ་སྤྲད༌པ་ཡིན། ཁྱོད་ཀྱིས་ཉེས་པ་ཅི་བྱས་སམ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":36,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གི་རྒྱལ་སྲིད་ནི་འཇིག་རྟེན་འདིར་མི་གཏོགས༌ཏེ། གལ་སྲིད་གཏོགས་ན་ངའི་འཁོར་གཡོག་རྣམས་ཀྱིས་ང་རང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་ལག་ཏུ་མི་སྤྲོད་པའི་ཆེད་དུ་འཐབ་འཛིང་བྱེད་ངེས༌ཡིན། དོན་དམ་དུ་བདག་གི་རྒྱལ་སྲིད་ནི་གནས་འདི་ལ་མི་གཏོགས་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":37,"content":["དེ་ནས་པི་ལ་ཏུ་ན༌རེ། དེས་ན་ཁྱོད་ནི་རྒྱལ་པོ་ཞིག་ཡིན་ནམ་ཞེས་དྲིས་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་སྨྲས་པ་བཞིན་ང་རང་ནི་རྒྱལ་པོ་ཞིག༌སྟེ། བདེན་པ་ཉིད་ལ་བདེན་དཔང་བྱེད་ཆེད་འཇིག་རྟེན་འདི་རུ་སྐྱེས༌ཤིང༌། དོན་དེའི་ཆེད་དུ་འཇིག་རྟེན་འདི་རུ་ཡོང༌བ་ཡིན། བདེན་པ་ཉིད་ལ་གཏོགས་པའི་མི་རྣམས་ཀྱིས་བདག་གི་གསུང་ལ་ཉན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":38,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། བདེན་པ་ཉིད་ནི་ཅི་ཡིན་ནམ་ཞེས་སྨྲས་པ་དང་ཕྱི་རོལ་གྱི་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་གམ་དུ་སོང༌སྟེ། ངས་མི་འདིའི་ཉེས་སྐྱོན་ཅི་ཡང་མ་རྙེད་དོ།།"]},{"type":"verse","number":39,"content":["འོན་ཀྱང་པེ་སག་གི་དུས་ཆེན་ལ། ཁྱོད་ཅག་གི་རྒྱུན་སྲོལ་ལྟར་བཙོན་པ་ཞིག་བཙོན་གྲོལ་གཏོང་དགོས༌པས། ཁྱོད་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་འདི་ཉིད་བཙོན་གྲོལ་གཏོང་འདོད་དམ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":40,"content":["དེ་དག་གིས་སྐད་ཆེན༌པོས། མི་འདི་གཏོང་མི༌དགོས། པཱ་རབ་པཱ་གཏོང་བར་མཛོད་ཅེས་ཞུས་སོ།། པཱ་རབ་པཱ་ནི་ཇག་པ་ཞིག་ཡིན༌ནོ།།"]}],"footnotes":[{"noteId":20,"caller":"+","text":"ཕོར་བ་ཞེས་པའི་དོན་ནི་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་འཆི་བར་འགྱུར་བའི་སྡུག་བསྔལ་ཆེན་པོ་དེ་ལ་གོ་དགོས་པ༌ཡིན།","reference":{"chapter":18,"verse":11}}]},"thisChapterLink":"/api/bod_ntb/JHN/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/17.json","previousChapterAudioLinks":{},"numberOfVerses":40}