{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":2,"content":[{"type":"heading","content":["ཀ་ནཱ་གྲོང་སྡེའི་གཉེན༌སྟོན།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཉིན་གསུམ་པ་ལ་ག་ལིལ་ཡུལ་གྱི་ཀ་ནཱ་རུ་གཉེན་སྟོན་ཞིག་ཡོད༌ལ། སྐྱབས་མགོན་ཡེ་ཤུའི་ཡུམ་ཡང་གནས་དེར་བཞུགས༌ཤིང༌།"]},{"type":"verse","number":2,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཁོང་གི་ཐུགས་སྲས་རྣམས་ཀྱང་གཉེན་སྟོན་དུ་གདན་འདྲེན་ཞུས༌ཡོད་དོ།།"]},{"type":"verse","number":3,"content":["དུས༌དེར། སྟོན་ཆང་ཐམས་ཅད་བཏུང་ཚར་བ་དང་སྐྱབས་མགོན་ཡེ་ཤུའི་ཡུམ་གྱིས་ཁོང༌ལ། ཁོ་རྣམས་ལ་རྒུན་ཆང་མེད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཡུམ༌ལགས། དོན་དེ་བདག་དང་འབྲེལ་བ་ཅི་ཡོད་དམ། བདག་གི་དུས་ནི་ད་དུང་སླེབས་མེད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":5,"content":["ཁོང་གི་ཡུམ་གྱིས་གནས་དེར་ཡོད་པའི་གཡོག་པོ་རྣམས༌ལ། ཁོང་གིས་ཁྱོད་ཅག་ལ་ཇི་ལྟར་གསུངས་ན་ཁྱོད་ཅག་གིས་དེ་ལྟར་བྱོས་ཤིག་ཅེས་སྨྲས།"]},{"type":"verse","number":6,"content":["ཡ་ཧུ་དཱ་པའི་ལུགས་སྲོལ་བཞིན་གཙང་སྦྲ་བྱེད་པ༌ལ། རྡོ་ཡིས་བཟོས་པའི་ཆུ་རྫ་དྲུག་ཀྱང་གནས་དེར་བཞག་ཡོད༌དེ། དེ་རེ་རེའི་ནང་དུ་ཧ་ལམ་ཆུ་ཟོ་གཉིས་གསུམ་ཙམ་ཤོང༌ཐུབ་བོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་གཡོག་པོ་དེ་རྣམས་ལ་ཆུ་རྫ་འདི་དག་ཆུས་གང་བར་བྱོས་ཞེས་བཀའ་བསྩལ་པ་དང་ཁོ་རྣམས་ཀྱིས་ཀྱང་ཆུས་བལྟམས་པར་བྱས།"]},{"type":"verse","number":8,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ད་ལྟ་བཅུས་ཏེ་གཉེན་སྟོན་གྱི་གཉེར་པ་ལ་སྤྲོད་ཅིག་ཅེས་གསུངས་པ་དང་གཡོག་པོ་རྣམས་ཀྱིས༌བསྐྱལ་ཏོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་གཉེར་པས་ཆུ་ནས་བསྒྱུར་བའི་རྒུན་ཆང་གི་བྲོ་བ་མྱངས་ནའང་གང་ནས་བཅུས་ཤིང་གང་ནས་ཁྱེར་ཡོང་བ་མི་ཤེས། འོན་ཀྱང་ཆུ་བཅུ་མཁན་གཡོག་པོ་རྣམས་ཀྱིས་གང་ནས་ཁྱེར་འོངས་པ་ཤེས༌པ་རེད། དེ་ནས་གཉེར་པས་མག་གསར་ཚུར་བོས་ཏེ་ན༌རེ།"]},{"type":"verse","number":10,"content":["མི་ཚང་མས་རྒུན་ཆང་ཞིམ་པོ་སྔོན་ལ་ལྡུད་ཅིང་མགྲོན་པོ་རྣམས་བཟི་བར་གྱུར༌ཚེ། རྒུན་ཆང་ཕལ་བ་གཞུག་ནས་ལྡུད་པར༌བྱེད། འོན་ཀྱང་ཁྱོད་ཀྱིས་དེ་ལྟར་མི་བྱེད་པར་རྒུན་ཆང་ཞིམ་པོ་གཞུག་ཏུ་བསྐྱུར་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":11,"content":["དེ་ལྟར་གྲུབ་རྟགས་དང་པོ་དེ་སྐྱབས་མགོན་ཡེ་ཤུས་ག་ལིལ་ཡུལ་གྱི་ཀ་ནཱ་རུ་བསྟན་ཏེ། རང་གི་གཟི་བརྗིད་མངོན་པར་མཛད་པས་ཐུགས་སྲས་རྣམས་ཀྱང་ཁོང་ལ་དད་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":12,"content":["དེའི་རྗེས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུ་རང་གི་ཡུམ་དང་སྐུ༌མཆེད། ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་ཀཱ་ཕར་ན་ཧུམ་དུ་མར་ཕེབས་ཤིང་གནས་དེ་རུ་ཉིན་འགར་བཞུགས༌སོ།།"]},{"type":"heading","content":["མཆོད་ཁང་གཙང་མར་མཛད༌པ།"]},{"type":"verse","number":13,"content":["དེ་ཡང་ཡ་ཧུ་དཱ་པའི་པེ་སག་གི་དུས་ཆེན་སླེབས་ལ་ཉེ་བ༌ན། སྐྱབས་མགོན་ཡེ་ཤུ་ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་ཕེབས་པ༌དང༌།"]},{"type":"verse","number":14,"content":["མཆོད་ཁང་ནང་དུ་བ་གླང༌དང༌། ལུག ཕུག་རོན་བཅས་ཚོང་མཁན་དང་དངུལ་བརྗེ་མཁན་རྣམས་བསྡད་ཡོད་པ་གཟིགས༌ཏེ།"]},{"type":"verse","number":15,"content":["ཁོང་གིས་ཐག་པས་རྟ་ལྕག་ཅིག་མཛད༌དེ། བ་གླང་དང་ལུག་དང་བཅས་པ་ཐམས་ཅད་མཆོད་ཁང་ལས་ཕྱིར་ཕུད་པ༌དང༌། དངུལ་བརྗེ་མཁན་གྱི་དངུལ་སྒོར་ཡང་ས་རུ་གཏོར་བ་དང་དེ་དག་གི་ཅོག་ཙེའང་སར་བསྒྱེལ་ཏོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཕུག་རོན་ཚོང་མཁན་རྣམས་ལ་འདི་སྐད༌དུ། ཕུག་རོན་འདི་དག་ཕྱིར་ཁྱེར༌ཅིག བདག་གི་ཡབ་ཀྱི་ཕོ་བྲང་འདི་ནི་ཚོང་རར་བྱེད་མི་རུང་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཁོང་གི་ཐུགས་སྲས་རྣམས་ཀྱིས་གསུང་རབ་ཀྱི་མདོ༌ལས། ཁྱེད་ཀྱི་བཞུགས་གནས་ཀྱི་དོན་དུ་ང་རང་སེམས་པ་ཤིན་ཏུ་འཚབ་ནས་མེ་ལྟར༌འབར་ཞེས་བཀོད་ཡོད་པ་དེ་དྲན་ནོ།།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་ན༌རེ། ཁྱེད་ལ་དོན་འདི་རྣམས་མཛད་པའི་དབང་ཡོད་པར་བདེན་དཔང་བྱ་ཆེད་གྲུབ་རྟགས་གང་ཞིག་སྟོན་ནུས་སམ་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":19,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་ཁྱོད་ཅག་གིས་མཆོད་ཁང་འདི་བཤིག་ན། བདག་གིས་ཉིན་གསུམ་ལ་སླར་ཡང་བརྩིག་པར་བྱ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":20,"content":["ཡང་དེ་རྣམས་ན༌རེ། མཆོད་ཁང་འདི་ནི་ལོ་ངོ་བཞི་བཅུ་ཞེ་དྲུག་གི་རིང་ལ་བརྩིགས་པ་ཡིན་ཡང་ཁྱོད་ཀྱིས་ཉིན་གསུམ་ལ་བརྩིག་ཐུབ་བམ་ཞེས་དྲིས།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་དེ་ནི་སྐྱབས་མགོན་ཡེ་ཤུས་རང་གི་སྐུ་ལུས་ཡིན་པའི་མཆོད་ཁང་ལ་དམིགས་ཏེ་གསུངས་པ་ཡིན།"]},{"type":"verse","number":22,"content":["དེའི༌ཕྱིར། ཁོང་ཉིད་སྐུ་གཤེགས་པ་ནས་སླར་གསོན་པའི་རྗེས༌སུ། ཐུགས་སྲས་རྣམས་ཀྱིས་ཁོང་གི་གསུང་དེ་དྲན༌ནས། གསུང་རབ་ཀྱི་མདོ་དང་སྐྱབས་མགོན་ཡེ་ཤུས་གསུངས་པའི་བཀའ་ལ་དད་པར་གྱུར༌ཏོ།།"]},{"type":"verse","number":23,"content":["དེ་ཡང་པེ་སག་གི་དུས་ཆེན་ལ་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་བཞུགས༌ཤིང༌། མི་མང་པོས་ཁོང་གིས་མཛད་པའི་གྲུབ་རྟགས་རྣམས་མཐོང་སྟེ་ཁོང་གི་མཚན་ལ་དད་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཐམས་ཅད་མཁྱེན་པས་དེ་དག་ལ་བློ་མི་གཏོད༌ཅིང༌།"]},{"type":"verse","number":25,"content":["ཁོང་གིས་མིའི་སེམས་སུ་ཅི་ཡོད་པའང་མཁྱེན་པས་སུས་ཀྱང་མི་གཞན་ཅི་འདྲ་ཡིན་པར་བདེན་དཔང་བྱེད་དགོས་དོན་ཅི་ཡང་མེད༌དོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JHN/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}