{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":20,"content":[{"type":"heading","content":["སྟོང་བར་ལུས་པའི་དུར་ཁུང་།"]},{"type":"verse","number":1,"content":["གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོར་ནམ་མ་ལངས་པའི་སྔོན༌ལ། མཱག་རྡལ་གྱི་མིར་ཡམ་དུར་ཁུང་གི་གམ་དུ་སླེབས་པ༌ན། དུར་ཁུང་གི་སྒོ་གཅོད་བྱེད་ཀྱི་རྡོ་ཕ་བོང་དེ་ཕར་བསྒྲིལ་ཟིན་པ་མཐོང༌བས།"]},{"type":"verse","number":2,"content":["མྱུར་དུ་སི་མོན་པེ་ཏྲོ་དང་སྐྱབས་མགོན་ཡེ་ཤུས་བྱམས་ཤིང་གཅེས་པའི་ཐུགས་སྲས་ཅིག་ཤོས་དེའི་མདུན་དུ་སོང་སྟེ་ན༌རེ། གཙོ་བོའི་སྐུ་གདུང་མི་གཞན་རྣམས་ཀྱིས་དུར་ཁུང་ནས་ཁྱེར་ཞིང་ངེད་རྣམས་ཀྱིས་གང་དུ་བཞག་ཡོད་པའང་མ་ཤེས་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":3,"content":["པེ་ཏྲོ་དང་ཐུགས་སྲས་གཞན་དེ་ཕྱི་རོལ་ཏུ་ཐོན༌ནས།"]},{"type":"verse","number":4,"content":["མཉམ་དུ་དུར་ཁུང་གི་ཕྱོགས་སུ་བརྒྱུགས་པ་དང་ཐུགས་སྲས་ཅིག་ཤོས་པེ་ཏྲོ་ལས་མགྱོགས་པས་སྔོན་ལ་དུར་ཁུང་ཡོད་སར་སླེབས༌ཤིང༌།"]},{"type":"verse","number":5,"content":["མགོ་བོ་སྒུར་ནས་དུར་ཁུང་ནང་དུ་བལྟས་པ་ན། སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་བཏུམ་བྱེད་ཀྱི་སོ་རས་ཤུལ་དུ་ཡོད་པ་མཐོང་བ་དང་ཁོ་རང་ནང་དུ་མ་སོང་ངོ་།།"]},{"type":"verse","number":6,"content":["དེ་ནས་སི་མོན་པེ་ཏྲོ་ཡང་སླེབས་ཏེ་དུར་ཁུང་ནང་དུ་སོང་བ༌ན། སོ་རས་ཤུལ་དུ་ལུས་ཡོད་པ༌དང༌།"]},{"type":"verse","number":7,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་དབུ་བཏུམ་བྱེད་ཀྱི་རས་དེ་སོ་རས་དང་མཉམ་དུ་མེད༌པར། གནས་གཞན་ཞིག་ཏུ་དཀྲིས་ཏེ་བཞག་ཡོད་པ་མཐོང༌།"]},{"type":"verse","number":8,"content":["སྔོན་ལ་སླེབས་པའི་ཐུགས་སྲས་དེ་ཡང་དུར་ཁུང་ནང་དུ་སོང་སྟེ་གནས་ཚུལ་དེ་དག་མཐོང་བ་དང་ཡིད་ཆེས་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":9,"content":["རྒྱུ་མཚན་ནི་དེ་གཉིས་ཀྱིས་གསུང་རབ་ཀྱི་མདོ་ལས་སྐྱབས་མགོན་ཡེ་ཤུ་གྲོངས་པ་ནས་སླར་གསོན་པར་འགྱུར་དགོས་ཞེས་པའི་དོན་དེ་ད་དུང་མ་རྟོགས༌པ་རེད།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཐུགས་སྲས་དེ་གཉིས་ཕྱིར་རང་གནས་སུ་ལོག༌གོ།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ཀྱི་སྐུ་གཟུགས་མངོན་པར་མཛད༌པ།"]},{"type":"verse","number":11,"content":["དེ་ནས་མཱག་རྡལ་གྱི་མིར་ཡམ་དུར་ཁུང་གི་ཕྱི་རོལ་ཏུ་ལངས་བསྡད་དེ་ངུས༌ཤིང༌། ངུ་བཞིན་མགོ་བོ་སྒུར་ནས་དུར་ཁུང་ནང་དུ་བལྟས་པ༌ན།"]},{"type":"verse","number":12,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་བཞག་སའི་ཤུལ་དུ་གོས་དཀར་པོ་གྱོན་པའི་ཕོ་ཉ་གཉིས་ཡོད་ཅིང་གཅིག་ནི་དབུ་དང་གཅིག་ནི་ཞབས་ཀྱི་ཕྱོགས་སུ་བཞུགས་པ་མཐོང་ངོ༌།།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཕོ་ཉ་དེ་གཉིས་ན༌རེ། ཀྱེ། བུད༌མེད། ཁྱོད་རང་ཅིའི་ཕྱིར་ངུ་བ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ལ། ཁོ་མོ་ན༌རེ། ང་ཡི་གཙོ་བོའི་སྐུ་གདུང་མི་གཞན་རྣམས་ཀྱིས་ཁྱེར་ཞིང་གང་དུ་བཞག་པ་མི་ཤེས་པའི་ཕྱིར་ཡིན་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":14,"content":["ཁོ་མོ་ཁ་ཕྱིར་འཁོར་བ༌ན། སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེར་བཞེངས་ཡོད་པ་མཐོང༌ཡང༌། ཁོ་མོས་སྐྱབས་མགོན་ཡེ་ཤུ་ཡིན་པ་མ་ཤེས་སོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཀྱེ། བུད༌མེད། ཁྱོད་རང་ཅིའི་ཕྱིར་ངུ་བ་ཡིན༌ནམ། ཁྱོད་ཀྱིས་སུ་ཞིག་འཚོལ་ལམ་ཞེས་གསུངས་པ༌ན། མིར་ཡམ་གྱིས་མི་དེ་ནི་སྐྱེད་ཚལ་སྲུང་མཁན་ཡིན་པར་སྙམ༌སྟེ། ཇོ་བོ༌ལགས། ཁྱེད་ཀྱིས་ཁོང་གི་སྐུ་གདུང་ཁྱེར་བ་ཡིན་ན་གང་དུ་བཞག་པ་བདག་ལ་སྨྲོས་དང་ང་རང་ལེན་དུ་འགྲོ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་མིར་ཡམ་ཞེས་ཁོ་མོའི་མིང་ནས་བོས༌ཤིང༌། མིར་ཡམ་ཁོང་གི་ཕྱོགས་སུ་འཁོར༌ཏེ། ཨིབ་རིའི་མི་རིགས་ཀྱི་སྐད༌དུ། རཱབ་པོ་ནེ་ཞེས་ཞུས་ཤིང་སློབ་དཔོན་ལགས་ཞེས་པའི་དོན་ཡིན་ནོ།།"]},{"type":"verse","number":17,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ང་རང་ད་དུང་ཡབ་ཀྱི་དྲུང་དུ་མ་འཕགས༌པས། ང་རང་དམ་པོར་འཛིན་པར་མི༌བྱའོ།། ཁྱོད་རང་བདག་གི་སྤུན་ཟླ་རྣམས་ཀྱི་གམ་དུ་སོང་ནས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ང་རང་ནི་བདག་གི་ཡབ་དང༌། ཁྱོད་ཅག་གི་ཡབ། བདག་གི་དཀོན༌མཆོག་སྟེ་ཁྱོད་ཅག་གི་དཀོན་མཆོག་གི་དྲུང་དུ་འགྲོ་བ་ཡིན་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":18,"content":["དེ་ནས་མཱག་རྡལ་གྱི་མིར་ཡམ་ཕྱིར་སོང་ནས་ཐུགས་སྲས་རྣམས་ལ་ང་རང་གཙོ་བོ་ལ་མཇལ་བྱུང་ཞེས་སྨྲས་པ་དང་ཁོང་གིས་ཁོ་མོར་གསུངས་པ་རྣམས་ཀྱང་སྨྲས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་རང་ཉིད་ཀྱི་སྐུ་གཟུགས་མངོན༌པ།"]},{"type":"verse","number":19,"content":["གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོའི་མཚན༌མོར། ཐུགས་སྲས་རྣམས་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འཇིགས་ཏེ་སྒོ་བརྟན་པོར་བརྒྱབ་ནས་སྡོད་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེར་བྱོན་ནས་ཁོ་རྣམས་ཀྱི་དཀྱིལ་དབུས་སུ་ཡར་བཞེངས་ཏེ་ཁྱོད་རྣམས་བདེ་བར་སྨོན་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":20,"content":["རང་ཉིད་ཀྱི་ཕྱག་དང་གཞོགས་བསྟན་པ་དང་ཐུགས་སྲས་རྣམས་གཙོ་བོ་ལ་སླར་ཡང་མཇལ་བས་སེམས་དགའ་བར་གྱུར་ཏོ།།"]},{"type":"verse","number":21,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་བདེ་བར་གྱུར༌ཅིག ཡབ་ཀྱིས་ང་རང་ཇི་ལྟར་མངགས་པ་བཞིན་བདག་གིས་ཀྱང་ཁྱོད་རྣམས་དེ་ལྟར་མངག་པར་བྱ་ཞེས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":22,"content":["དེ་རྣམས་ལ་ཞལ་ཕུ་བཏབ་སྟེ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་དམ་པའི་ཐུགས་ཉིད་ལོངས་ཤིག"]},{"type":"verse","number":23,"content":["ཁྱོད་ཅག་གིས་མིའི་སྡིག་པ་བསལ་བ་ཡིན་ན་མིའི་སྡིག་པའང་དག་པ༌ཡིན། ཁྱོད་རྣམས་ཀྱིས་སུ་ཞིག་གི་སྡིག་པ་མི་བསལ་ན་མི་དེའི་སྡིག་པའང་ལུས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་ཐོ་མཱ་ལ་རང་ཉིད་ཀྱི་སྐུ་གཟུགས་མངོན༌པ།"]},{"type":"verse","number":24,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕེབས་ཡོང་བའི་དུས༌སུ། ཐུགས་སྲས་བཅུ་གཉིས་པོ་ལས་མིང་གཞན་ལ་མཚེ་མ་ཞེས་ཀྱང་འབོད་པའི་ཐོ་མཱ་ནི་ཁོ་ཚོ་དང་མཉམ་དུ་མེད༌པས།"]},{"type":"verse","number":25,"content":["ཐུགས་སྲས་གཞན་རྣམས་ཀྱིས་ངེད་ཅག་གཙོ་བོ་ལ་མཇལ་བྱུང་ཞེས་སྨྲས་པ༌ན། ཐོ་མཱ་ན༌རེ། ཁོང་ཉིད་ཀྱི་ཕྱག་ཟུང་སྟེང་གི་གཟེར་མས་བསྣད་པའི་རྨ་ཤུལ་མཐོང་བ་དང་བདག་གི་མཛུབ་མོས་རྨ་ཤུལ་ལ་རེག༌ཅིང༌། ཡང་ངའི་ལག་པ་ཁོང་གི་གཞོགས་སུ་བཞག་ན་མ་གཏོགས་ང་རང་ཡིད་མི་ཆེས་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":26,"content":["དེ་ནས་ཉིན་བརྒྱད་འགོར་བའི་རྗེས༌སུ། ཐོ་མཱའང་ཐུགས་སྲས་གཞན་རྣམས་དང་མཉམ་དུ་སླར་ཡང་ཁང་པ་དེའི་ནང་དུ་བསྡད་ཅིང་སྒོ་བརྟན་པོར་བརྒྱབ་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེར་བྱོན་ནས་ཁོ་རྣམས་ཀྱི་དཀྱིལ་དབུས་སུ་བཞེངས་ཏེ་ཁྱོད་རྣམས་བདེ་བར་སྨོན་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":27,"content":["ཐོ་མཱ་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་རང་གི་མཛུབ་མོ་བརྐྱངས་ནས་བདག་གི་ལག་པ་ལ་རེག་པར༌གྱིས། ཁྱོད་ཀྱིས་རང་གི་ལག་པ་བརྐྱངས་ནས་བདག་གི་གཞོགས་ལ་ཞོག༌དང༌། མི་དད་པའི་སེམས་སྤོངས་ལ་དད་པ་བྱོས་ཤིག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":28,"content":["དེ་ནས་ཐོ་མཱས་ང་ཡི་གཙོ་བོ༌ལགས། ང་ཡི་དཀོན་མཆོག་ལགས་ཞེས་ཞུས་སོ།།"]},{"type":"verse","number":29,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ང་རང་མཐོང་ནས་ད་གཟོད་དད་པ་བྱས་པ༌ཡིན། ང་རང་མ་མཐོང་བར་དད་པ་བྱེད་མཁན་རྣམས་ནི་བདེའོ་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":30,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ཀྱི་མདུན་དུ་གྲུབ་རྟགས་གཞན་མང་པོ་མཛད་ཀྱང་མདོ་འདིའི་ནང་དུ་མ་བཀོད་དོ།།"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་འདིར་བཀོད་པའི་དོན་རྣམས་ཁྱོད་ཅག་གིས་ཡེ་ཤུ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་སྟེ་དཀོན་མཆོག་གི་སྲས་ཡིན་པར་དད་པ་བྱེད་ཅིང་། ཁོང་ལ་དད་པ་བྱས་ཏེ་ཁོང་གི་མཚན་གྱི་སྒོ་ནས་མཐའ་མེད་པའི་ཚེ་སྲོག་འཐོབ་པའི་ཕྱིར་ཡིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JHN/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/19.json","previousChapterAudioLinks":{},"numberOfVerses":31}