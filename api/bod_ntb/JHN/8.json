{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":8,"content":[{"type":"heading","content":["ལོག་གཡེམ་བྱས་པའི་བུད་མེད༌ཅིག"]},{"type":"verse","number":1,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་སྐྱུ་རུ་རའི་རི་བོར་ཕེབས༌ཤིང༌།"]},{"type":"verse","number":2,"content":["སྐྱ་རེངས་ཤར་བའི་དུས་སུ་སླར་ཡང་མཆོད་ཁང་དུ་ཕེབས་པ༌ལ། མི་མང་པོ་ཁོང་གི་དྲུང་དུ་འཛོམས་ཤིང་ཁོང་ཉིད་ཀྱང་བཞུགས་ཏེ་མི་རྣམས་ལ་ཆོས་གསུངས་པ་རེད།"]},{"type":"verse","number":3,"content":["དེ་ནས་མཁན་པོ་དང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་ལོག་གཡེམ་བྱེད་པའི་དུས་སུ་བཟུང་བའི་བུད་མེད་ཅིག་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌དང༌། མི་ཚོགས་ཀྱི་མདུན་ནས་ཁོ་མོ་ཡར་བསླངས་ཏེ་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ།"]},{"type":"verse","number":4,"content":["སློབ་དཔོན༌ལགས། བུད་མེད་འདི་ནི་ལོག་གཡེམ་བྱེད་བཞིན་པའི་དུས་སུ་བཟུང་བ༌ཡིན།"]},{"type":"verse","number":5,"content":["དེ་ཡང་བཀའ་ཁྲིམས་ལས་མོ་ཤེ་ཡིས་བུད་མེད་འདི་ལྟ་བུ་རྡོ་རུབ་གཏོང་དགོས་ཞེས་བཀའ་གནང༌ཡོད། ཁྱེད་ཀྱིས་བལྟས༌ན། ཅི་ལྟར་བྱས་ན་ལེགས་སམ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":6,"content":["དེ་རྣམས་ཀྱིས་ཁོང་ལ་བསྙོན་འཛུགས་ཕྱིར་ཚོད་བགམས་ནས་དེ་ལྟར་ཞུས་སོ།། འོན་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་མར་སྒུར་ནས་ཕྱག་མཛུབ་ཀྱིས་ས་ལ་ཡི་གེ་བྲིས་སོ།།"]},{"type":"verse","number":7,"content":["དེ་རྣམས་ཀྱིས་ཁོང་ལ་ཡང་ཡང་ཞུས་པ་ན་ཁོང་གིས་དབུ་ཡར་དགྱེ་ནས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ལས་སྡིག་པའི་དྲི་མས་མ་གོས་པ་དེས་ཐོག་མར་བུད་མེད་དེ་ལ་རྡོ་ཡིས་རྒྱག་རུང་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":8,"content":["ཡང་མར་སྒུར་ནས་ཕྱག་མཛུབ་ཀྱིས་ས་ལ་ཡི་གེ་བྲིས༌སོ།།"]},{"type":"verse","number":9,"content":["དེ་རྣམས་ཀྱིས་གསུང་དེ་ཐོས་པ་དང་རྒན་པོ་ནས་ན་གཞོན་བར་རེ་རེ་བཞིན་ཕྱིར་སོང་བ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུ་ཁོ་ན་ལུས་ཤིང་ད་དུང་བུད་མེད་དེ་དཀྱིལ་དབུས་སུ་ལངས་བསྡད་ཡོད་པ་རེད།"]},{"type":"verse","number":10,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཡར་ལངས་ནས་བུད་མེད་དེ་ལ་འདི་སྐད༌དུ། བུད་མེད། མི་དེ་རྣམས་གང་དུ་སོང༌ངམ། སུས་ཀྱང་ཁྱོད་ལ་ཉེས་ཆད་མ་བཅད་དམ་ཞེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":11,"content":["བུད་མེད་ན༌རེ། ཇོ་བོ༌ལགས། བདག་ལ་ཉེས་ཆད་མ་བཅད་ཅེས་ཞུས་སོ།། དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རང་ཕྱིར་སོང༌དང༌། བདག་གིས་ཀྱང་ཁྱོད་ལ་ཉེས་ཆད་གཅོད་པར་མི༌བྱའོ།། ཁྱོད་ཀྱིས་དེང་ཕྱིན་སྡིག་པ་མ་བྱེད་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་བདེན་དཔང་མཛད་པའི༌སྐོར།"]},{"type":"verse","number":12,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ལ་འདི་སྐད༌དུ། བདག་ནི་འཇིག་རྟེན་གྱི་འོད་ཟེར་ཡིན༌ཞིང༌། ངའི་རྗེས་སུ་འབྲང་མཁན་རྣམས་མུན་པའི་ནང་དུ་བགྲོད་པ་མ་ཡིན་པར་ཚེ་སྲོག་གི་འོད་དང་ལྡན་པར་འགྱུར་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":13,"content":["ཕ་རུ་ཤི་པ་རྣམས་ན༌རེ། ཁྱོད་ཀྱིས་རང་ཉིད་ལ་བདེན་དཔང་བྱེད་པ་ཡིན་པས་ཁྱོད་ཀྱི་བདེན་དཔང་དེ་བདེན་པ་མིན་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":14,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་རང་ཉིད་ལ་བདེན་དཔང་བྱས་ནའང་བདག་གི་བདེན་དཔང་ནི་བདེན་པ་ཡིན༌ཏེ། ངས་ང་རང་གང་ནས་ཡོང་བ་དང་གང་དུ་འགྲོ་བའང་ཤེས༌ཤིང༌། ཁྱོད་རྣམས་ཀྱིས་ང་རང་གང་ནས་ཡོང་བ་དང་གང་དུ་འགྲོ་བའང་མི་ཤེས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":15,"content":["ཡང་ཁྱོད་རྣམས་ཀྱིས་མིའི་ལུགས་སྲོལ་ལྟར་ཁ་ཚོན་གཅོད་ཅིང་ངས་མི་སུ་ལའང་ཁ་ཚོན་མི་གཅོད་དོ།།"]},{"type":"verse","number":16,"content":["འོན༌ཀྱང༌། ངས་ཁ་ཚོན་གཅོད་པའི་དབང་དུ་བཏང་ནའང་དེ་ནི་བདེན་པ་ཡིན༌ཏེ། ངས་རང་ཉིད་གཅིག་པུར་བརྟེན་ནས་ཁ་ཚོན་བཅད་པ་མ་ཡིན༌པར། ང་རང་མངགས་མཁན་ཡབ་དང་ངེད་གཉིས་ཀྱིས་ལྷན་དུ་ཁ་ཚོན་གཅོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":17,"content":["དེ་ཡང་ཁྱོད་ཅག་གི་བཀའ་ཁྲིམས་ནང་དུ་མི་གཉིས་ཀྱི་བདེན་དཔང་དེ་གཞི་གཅིག་ལ་འཁེལ་ན་དེ་ནི་བདེན་པ་ཡིན་ཞེས་བྲིས་འདུག༌ལ།"]},{"type":"verse","number":18,"content":["ངས་རང་ཉིད་ལ་བདེན་དཔང་བྱེད་ཅིང་ང་རང་མངགས་མཁན་ཏེ་ཡབ་ཀྱིས་ཀྱང་ང་རང་ལ་བདེན་དཔང་མཛད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":19,"content":["ཡང་ཕ་རུ་ཤི་པ་རྣམས་ན༌རེ། ཁྱོད་ཀྱི་ཡབ་དེ་གང་དུ་ཡོད་ཅེས་དྲིས་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་ང་རང་ངོ་མི་ཤེས་ཤིང་བདག་གི་ཡབ་ཀྱང་ངོ་མི་ཤེས། གལ་ཏེ་ང་རང་ངོ་ཤེས་ན་ངའི་ཡབ་ཀྱང་ངོ་ཤེས་པ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":20,"content":["གསུང་འདི་དག་ནི་སྐྱབས་མགོན་ཡེ་ཤུས་མཆོད་ཁང་གི་དཀོར་མཛོད་དུ་ཆོས་བསྟན་སྐབས་གསུངས་པ༌ཡིན། ཁོང་གི་དུས་དེ་མ་སླེབས་པས་མི་སུས་ཀྱང་ཁོང་ཉིད་མ་བཟུང་ངོ་།།"]},{"type":"verse","number":21,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ལ་འདི་སྐད༌དུ། བདག་ནི་འགྲོ་ཞིང་ཁྱོད་ཅག་གིས་ང་རང་བཙལ་ནའང་ཁྱོད་རྣམས་རང་གི་སྡིག་པའི་ནང་དུ་འཆི་བར་འགྱུར་རོ།། ང་རང་འགྲོ་བའི་གནས་སུ་ཁྱོད་རྣམས་འགྲོ་མི་ནུས་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":22,"content":["ཡ་ཧུ་དཱ་པ་རྣམས་ཕན་ཚུན་ན༌རེ། ཁོང་གིས་ང་རང་འགྲོ་བའི་གནས་སུ་ཁྱོད་རྣམས་འགྲོ་མི་ནུས་ཞེས་གསུངས་དོན༌ནི། ཁོང་གིས་རང་སྲོག་གཅོད་འདོད་པ་ཡིན་ནམ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":23,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་འོག་ནས་བྱུང་ཞིང་བདག་ནི་སྟེང་ནས་བྱུང་བ་ཡིན། ཁྱོད་ཅག་ནི་འཇིག་རྟེན་འདིར་གཏོགས་ཤིང་ང་རང་ནི་མི་གཏོགས་སོ།།"]},{"type":"verse","number":24,"content":["དེའི༌ཕྱིར། བདག་གིས་ཁྱོད་རྣམས་རང་གི་སྡིག་པའི་ནང་དུ་འཆི་བར་འགྱུར་ཞེས་སྨྲས་པ་ཡིན། གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་ང་རང་ནི་གཏན་དུ་གནས་པ་དེ་ཉིད་ཡིན་པར་དད་པ་མི་བྱེད༌ན། ཁྱོད་རྣམས་རང་གི་སྡིག་པའི་ནང་དུ་འཆི་བར་འགྱུར་ཞེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":25,"content":["མི་དེ་རྣམས་ན༌རེ། ཁྱོད་རང་སུ་ཡིན་ནམ་ཞེས་དྲིས། དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་ནི་ཐོག་མ་ཉིད་ནས་ཁྱོད་རྣམས་ལ་སྨྲས་པ་དེ་ཉིད་ཡིན་ནོ།།"]},{"type":"verse","number":26,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་ཉེས་སྐྱོན་བརྗོད་པ་དང་བདེན་རྫུན་གྱི་ཤན་འབྱེད་པའི་དོན་མང་པོ་ཡོད༌ནའང༌། ང་རང་མངགས་མཁན་དེ་ནི་བདེན་པ་ཡིན༌པས། ངས་ཁོང་གི་དྲུང་ནས་གང་ཞིག་ཐོས་པ་དེ་ཁོ་ན་འཇིག་རྟེན་གྱི་མི་རྣམས་ལ་སྨྲ་བ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":27,"content":["དེ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུས་རང་གི་ཡབ་བསྟན་པ་མ་རྟོགས༌པས།"]},{"type":"verse","number":28,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་མིའི་བུ་གྱེན་དུ་བསྒྲེངས༌པའི་དུས་སུ། ང་རང་ནི་གཏན་དུ་གནས་པ་དེ་ཉིད་ཡིན་པ་རྟོགས་ངེས་པ༌དང༌། ངས་རང་ཉིད་ལ་བརྟེན་ནས་དོན་ཅི་ཡང་མི་བྱེད༌པར། ཡབ་ཀྱིས་བསླབས་པ་བཞིན་དུ་དེ་ལྟར་སྨྲས་པའང་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པར་འགྱུར་རོ།།"]},{"type":"verse","number":29,"content":["ང་རང་མངགས་མཁན་ནི་བདག་དང་ལྷན་དུ་བཞུགས༌ཏེ། ངས་དུས་རྟག་ཏུ་ཁོང་ཉིད་ཐུགས་དགྱེས་པའི་ལས་ཁོ་ན་བྱེད་པས་ཁོང་ཉིད་ང་རང་དང་ཁ་མི་འབྲལ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":30,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་ལྟར་གསུང་བའི་དུས་སུ་མི་མང་པོ་ཁོང་ལ་དད་པར་གྱུར༌ཏོ།།"]},{"type":"heading","content":["ཨབ་ར་ཧམ་གྱི་བུ་རབས་ཚ་རྒྱུད༌སྐོར།"]},{"type":"verse","number":31,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ལ་དད་པ་ཡོད་པའི་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འདི་སྐད༌དུ། གལ་ཏེ་ཁྱོད་རྣམས་བདག་གི་བཀའ་ཡི་ནང་དུ་གནས་ན། ཁྱོད་ཅག་ནི་དངོས་གནས་བདག་གི་རྗེས་འབྲང་པ་ཡིན༌ལ།"]},{"type":"verse","number":32,"content":["ཁྱོད་རྣམས་ཀྱིས་བདེན་པ་ཉིད་",{"noteId":14},"དེ་ཤེས་པར་འགྱུར་ཞིང་བདེན་པ་ཉིད་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་ལ་རང་དབང་ལྡན་པར་མཛད་ངེས་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":33,"content":["ཡང་དེ་རྣམས་ན༌རེ། ངེད་རྣམས་ནི་ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་ཡིན་ཞིང་ནམ་ཡང་མི་གཞན་གྱི་བྲན་གཡོག་བྱས་མ་མྱོང་བས། ཁྱོད་རྣམས་ལ་རང་དབང་ལྡན་པར་མཛད་ངེས་ཡིན་ཞེས་བརྗོད་དོན་ཅི་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":34,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། སྡིག་པ་བྱེད་མཁན་ཐམས་ཅད་ནི་སྡིག་པའི་བྲན་གཡོག་ཡིན།"]},{"type":"verse","number":35,"content":["བྲན་གཡོག་ནི་རྟག་ཏུ་བདག་པོའི་ཁྱིམ་ལ་མི་གནས་ཤིང་བུ་ནི་རྟག་ཏུ་རང་གི་ཁྱིམ་ལ་གནས་སོ།།"]},{"type":"verse","number":36,"content":["དེའི༌ཕྱིར། སྲས་ཀྱིས་ཁྱོད་རྣམས་ལ་རང་དབང་ལྡན་པར་མཛད་ན་ཁྱོད་ཅག་ལ་དངོས་གནས་རང་དབང་ལྡན་པ་ཡིན།"]},{"type":"verse","number":37,"content":["བདག་གིས་ཁྱོད་རྣམས་ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་ཡིན་པ་ཤེས༌ཀྱང༌། བདག་གི་བཀའ་ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་གནས་ས་མེད་པས་ང་རང་དགྲོང་འདོད༌པ་ཡིན།"]},{"type":"verse","number":38,"content":["ངས་རང་གི་ཡབ་ཀྱི་དྲུང་ནས་གང་ཞིག་མཐོང་བ་དེ་སྨྲ་བ་ཡིན༌ལ། ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཕ་ཡི་ངག་ནས་ཐོས་པ་བཞིན་བྱེད་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":39,"content":["ཡང་དེ་རྣམས་ན༌རེ། ངེད་ཅག་གི་ཕ་མེས་ནི་ཨབ་ར་ཧམ་ཡིན་ནོ་ཞེས་སྨྲས་པ༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་ཁྱོད་རྣམས་ནི་ཨབ་ར་ཧམ་གྱི་བུ་རྒྱུད་ཡིན༌ན། ཁྱོད་ཅག་གིས་ཀྱང་ཨབ་ར་ཧམ་གྱི་སྤྱོད་པ་བཞིན་དུ་བྱེད་དགོས།"]},{"type":"verse","number":40,"content":["བདག་གིས་དཀོན་མཆོག་གི་དྲུང་ནས་ཐོས་པའི་བདེན་པ་དེ་ཁྱོད་ཅག་ལ་སྨྲས༌ཀྱང༌། ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་ང་རང་གསོད་འདོད་དོ།། འོན་ཀྱང་ཨབ་ར་ཧམ་གྱིས་དེ་ལྟར་མ་བྱས།"]},{"type":"verse","number":41,"content":["ཁྱོད་ཅག་གིས་རང་རང་གི་ཕ་ཡི་སྤྱོད་ལུགས་བཞིན་བྱེད་པ་ཡིན་ཞེས་གསུངས་པ༌ལ། ཡང་དེ་རྣམས་ན༌རེ། ངེད་ཅག་ནི་ནལ་ཕྲུག་མིན༌ཏེ། ངེད་ཅག་ལ་ཡབ་གཅིག་རང་ཡོད་པ་ནི་དཀོན་མཆོག་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"heading","content":["བདུད་ལ་གཏོགས་པའི་སྐོར།"]},{"type":"verse","number":42,"content":["དེ་ནས་ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་དཀོན་མཆོག་ནི་དངོས་གནས་ཁྱོད་ཅག་གི་ཡབ་ཡིན་ན་ཁྱོད་ཅག་གིས་བདག་ལ་གཅེས་དགོས༌ཏེ། ང་རང་ནི་དཀོན་མཆོག་ནས་བྱུང་ཞིང་ད་ལྟ་འདི་རུ་བསྡད་ཡོད། རང་བཞིན་གྱིས་ཡོང་བ་མ་ཡིན་པར་ཁོང་གིས་མངགས་པ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":43,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་གི་གཏམ་འདིའི་དོན་མི་གོ་བ་ཅི་ཡིན་ཞེ༌ན། དེ་ནི་ངའི་བཀའ་ལ་ཉན་མི་ཐུབ་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":44,"content":["ཁྱོད་ཅག་ནི་རང་གི་ཕ་སྟེ་བདུད་ལ་གཏོགས༌ཤིང༌། རང་གི་ཕ་ཡི་འདོད་པ་བཞིན་བྱེད་པར༌དགའོ།། བདུད་ནི་ཐོག་མ་ནས་མི་གསོད་མཁན་ཡིན་པ༌དང༌། བདེན་པ་ཉིད་དང་འབྲེལ་བ་ཅི་ཡང་མེད། རྒྱུ་མཚན་ནི་བདུད་དེའི་སེམས་སུ་བདེན་པ་ཉིད་མེད་པའི་ཕྱིར༌རོ།། ཡང་བདུད་དེ་ནི་རྫུན་སྨྲ་མཁན་དང་རྫུན་སྨྲ་བ་རྣམས་ཀྱི་ཕ་རྒན་ཡང་ཡིན༌པས། དེས་རྫུན་བརྗོད་པའི་དུས་སུ་རང་གི་གཤིས་ཀ་ལྟར་སྨྲ་བར་བྱེད་དོ།།"]},{"type":"verse","number":45,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་ཅག་ལ་བདེན་པ་སྨྲས་པའི་རྐྱེན་གྱིས་ཁྱོད་རྣམས་བདག་ལ་ཡིད་མི་ཆེས།"]},{"type":"verse","number":46,"content":["ཡང་ཁྱོད་རྣམས་ལས་སུ་ཞིག་གིས་བདག་ལ་སྡིག་པ་ཡོད་ཅེས་བདེན་དཔང་བྱེད་ནུས༌སམ། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པ་སྨྲས༌ནའང༌། ཁྱོད་ཅག་བདག་ལ་ཡིད་མི་ཆེས༌པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":47,"content":["དཀོན་མཆོག་ལ་གཏོགས་པའི་མི་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་བཀའ་ལ་མཉན༌ཞིང༌། ཁྱོད་རྣམས་དཀོན་མཆོག་ལ་མི་གཏོགས་པས་དཀོན་མཆོག་གི་བཀའ་ལའང་མི་མཉན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རང་ཉིད་ལ་བདེན་དཔང་མཛད༌པ།"]},{"type":"verse","number":48,"content":["དེ་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་ན༌རེ། ངེད་རྣམས་ཀྱིས་ཁྱོད་ནི་སཱ་མར་ཡ་པ་ཡིན་ཞིང་གདོན་འདྲེ་ཞུགས་འདུག་ཅེས་སྨྲས་པ་མི་བདེན་ནམ་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":49,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་ལ་གདོན་འདྲེ་ཞུགས་པ་མ་ཡིན། བདག་གིས་རང་གི་ཡབ་ལ་གུས་པ་བྱེད་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་བདག་ལ་སྨད༌པ་རེད།"]},{"type":"verse","number":50,"content":["བདག་གིས་རང་ལ་བཀུར་སྟི་མི་འཚོལ༌ཞིང༌། བདག་ལ་བཀུར་སྟི་འཚོལ་མཁན་ནི་བདེན་རྫུན་འབྱེད་མཁན་ཏེ་དཀོན་མཆོག༌ཡིན་ནོ།།"]},{"type":"verse","number":51,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། བདག་གི་བཀའ་སྲུང་མཁན་སུ་ལའང་ནམ་ཡང་འཆི་བ་མེད་ཅེས་གསུངས་པ༌ན།"]},{"type":"verse","number":52,"content":["ཡ་ཧུ་དཱ་པ་རྣམས་ན༌རེ། ཁྱོད་རང་ལ་གདོན་འདྲེ་ཞུགས་ཡོད་པ་ད་ལྟ་ངེད་རྣམས་ཀྱིས་ཤེས་བྱུང་། ཨབ་ར་ཧམ་དང་ལུང་སྟོན་པ་རྣམས་སྔ་མོ་ནས་ཚེ་ལས་འདས་ཟིན༌མོད། འོན་ཀྱང་ཁྱོད་ཀྱིས་ད་དུང་བདག་གི་བཀའ་སྲུང་མཁན་སུ་ལའང་ནམ་ཡང་འཆི་བ་མེད་ཅེས་སྨྲས༌པས།"]},{"type":"verse","number":53,"content":["ཁྱོད་ནི་ངེད་ཅག་གི་མེས་པོ་ཨབ་ར་ཧམ་ལས་ཀྱང་ཆེན་པོ་ཞིག་ཡིན༌ནམ། ཨབ་ར་ཧམ་དང་ལུང་སྟོན་པ་རྣམས་ཀྱང་གཤེགས་ཟིན༌མོད། འོན་ཀྱང་ཁྱོད་ཀྱིས་རང་ཉིད་ནི་སུ་ཡིན་པར་རློམ་མམ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":54,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ངས་རང་ལ་བཀུར་སྟི་བྱེད་ན་བཀུར་སྟི་དེ་ལ་དོན་སྙིང་ཅི་ཡང་མེད། བདག་ལ་བཀུར་སྟི་མཛད་མཁན་ནི་བདག་གི་ཡབ་ལགས། ཁྱོད་རྣམས་ཀྱིས་སྨྲ་བཞིན་པའི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡིན་ཞེས་ཟེར་བ་དེ་ཡིན།"]},{"type":"verse","number":55,"content":["འོན་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ངོ་མི་ཤེས་ཀྱང་བདག་གིས་ངོ་ཤེས། གལ་ཏེ་བདག་གིས་དཀོན་མཆོག་ངོ་མི་ཤེས་ཟེར་ན་བདག་ནི་ཁྱོད་ཅག་དང་འདྲ་བར་རྫུན་སྨྲ་བ་ཡིན། འོན་ཀྱང་བདག་གིས་ཁོང་ཉིད་ངོ་ཤེས་པ་དང་ཁོང་གི་བཀའ་ཡང་སྲུང་བ་ཡིན།"]},{"type":"verse","number":56,"content":["ཁྱོད་ཅག་གི་མེས་པོ་ཨབ་ར་ཧམ་གྱིས་དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་ནས་བདག་གི་ཉིན་མོ་མཐོང་བར་ཡིད་སྨོན་བྱས་པ༌དང༌། མཐོང་བ་དང་དགའ་བར་གྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":57,"content":["ཡང་ཡ་ཧུ་དཱ་པ་རྣམས་ན༌རེ། ཁྱོད་ནི་ལོ་ལྔ་བཅུ་ལའང་མ་སོན་པར་ཨབ་ར་ཧམ་མཐོང་མྱོང་ངམ་ཞེས་དྲིས༌ཚེ།"]},{"type":"verse","number":58,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་རྣམས་ལ་ཡང་དག་པར་བདེན་པར་སྨྲ༌སྟེ། ཨབ་ར་ཧམ་མ་སྐྱེས་པའི་སྔོན་ལ་བདག་ནི་གཏན་དུ་གནས་པ་དེ་ཉིད་ཡིན་ཞེས་གསུངས༌པས།"]},{"type":"verse","number":59,"content":["དེ་དག་གིས་ས་ནས་རྡོ་བླངས་ཏེ་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་རྒྱག་པར་རྩོམ་པ༌ན། ཁོང་ཉིད་གསང་བའི་སྒོ་ནས་མཆོད་ཁང་དང་ཁ་བྲལ༌ཏོ།།"]}],"footnotes":[{"noteId":14,"caller":"+","text":"བདེན་པ་ཉིད་ཅེས་པ་ནི་ཡང་དག་ཅིང་བདེན་པ་ཁོ་ན་ཉིད་ཀྱི་དོན༌ཏེ། དཀོན་མཆོག་ནི་བདེན་པ་ཁོ་ན་ཉིད་ཡིན་པ་ལ་གོ་དགོས་པ༌ཡིན།","reference":{"chapter":8,"verse":32}}]},"thisChapterLink":"/api/bod_ntb/JHN/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/7.json","previousChapterAudioLinks":{},"numberOfVerses":59}