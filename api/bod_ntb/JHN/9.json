{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JHN","translationId":"bod_ntb","name":"ཡོ་ཧ་ནན།","commonName":"ཡོ་ཧ་ནན།","title":"༄༅། །ཡོ་ཧ་ནན་གྱི་འཕྲིན་བཟང་།","order":43,"numberOfChapters":21,"sha256":"77cdb9cb8203e18f705518875de400eee1d62e1eddb2dbffebfad500d21e6518","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bod_ntb/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":9,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་དམུས་ལོང་ཞིག་གསོས༌པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕར་ཕེབས་པའི་ལམ་བར་དུ་དམུས་ལོང་ཞིག་དང་ཕྲད༌ཅིང༌།"]},{"type":"verse","number":2,"content":["ཐུགས་སྲས་རྣམས་ན༌རེ། རཱབ་པེ་ལགས། མི་འདི་ནི་སྐྱེས་མ་ཐག་ནས་ལོང་བ་ཞིག་ཡིན༌པས། ལོང་བ་རང་ཉིད་དམ་ཁོའི་ཕ་མས་སྡིག་པ་བྱས་པའི་རྐྱེན་གང་ཞིག་ཡིན་ནམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":3,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ལོང་བ་འདིས་སྡིག་པ་བྱས་པའི་རྐྱེན་མིན༌ལ། ཁོའི་ཕ་མས་སྡིག་པ་བྱས་པའི་རྐྱེན་ཡང་མིན༌པར། དེ་ནི་དཀོན་མཆོག་གི་ངོ་མཚར་བའི་མཛད་པ་ཁོའི་སྟེང་ནས་མངོན་པའི་ཕྱིར་དེ་ལྟར་བྱུང༌ངོ་།།"]},{"type":"verse","number":4,"content":["བདག་ཅག་གིས་ཉིན་མོའི་དུས་སུ་ང་རང་མངགས་མཁན་གྱི་བསྒྲུབ་འོས་པའི་དོན་བྱེད་དགོས༌ཤིང༌། མི་སུས་ཀྱང་ལས་ཅི་ཡང་བྱེད་མི་ཐུབ་པའི་མཚན་མོའི་དུས་ཤིག་སླེབ་ངེས༌ཡིན།"]},{"type":"verse","number":5,"content":["ང་རང་འཇིག་རྟེན་དུ་བཞུགས་དུས་བདག་ནི་འཇིག་རྟེན་གྱི་འོད་ཟེར་ཡིན་ཞེས་གསུངས༌རྗེས།"]},{"type":"verse","number":6,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མཆིལ་མ་ས་ལ་གཏོར་ནས་འཇིམ་པ་ཞིག་བརྫིས་ཤིང་ལོང་བའི་མིག་ཟུང་ལ་བསྐུས་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":7,"content":["ཁྱོད་རང་སི་ལོ་ཨམ་རྫིང་བུའི་ནང་དུ་མིག་ཟུང་བཀྲུ་བར་སོང་ཞིག་ཅེས་གསུངས་སོ།། སི་ལོ་ཨམ་ཞེས་པ་ནི་མངགས་པ་ཞེས་པའི་དོན༌ཡིན། དེ་ནས་ལོང་བ་དེ་སོང་ནས་མིག་ཟུང་བཀྲུས་ཤིང་མིག་གིས་མཐོང་བར་གྱུར་པ་དང་ཕྱིར་རང་ཡུལ་དུ་ལོག༌གོ།"]},{"type":"verse","number":8,"content":["དེ་ནས་ཁོའི་ཁྱིམ་མཚེས་དང་སྔར་ཁོ་སྤྲང་པོ་ཡིན་པ་མཐོང་མྱོང་མཁན་རྣམས་ན༌རེ། མི་འདི་ནི་སྔོན་ཆད་སློང་མོ་བྱེད་མཁན་དེ་མ་ཡིན་ནམ་ཞེས་སྨྲས༌ཤིང༌།"]},{"type":"verse","number":9,"content":["མི་འགའ་ཞིག་གིས་ཁོ་རང་ཡིན་ཞེས་སྨྲས་པ༌དང༌། ཡང་འགའ་ཞིག་གིས་ཁོ་རང་མ་ཡིན་ཏེ་ཁོ་རང་དང་བྱད་གཟུགས་འདྲ་བ་ཞིག་རེད་ཅེས་སྨྲས་པ༌ན། ཁོས་ང་རང་ཡིན་ཞེས་ཡང་ཡང་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":10,"content":["མི་རྣམས་ན༌རེ། ཁྱོད་ཀྱི་མིག་ཟུང་ཇི་ལྟར་སོས་སམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":11,"content":["ཁོ་ན༌རེ། ཡེ་ཤུ་ཟེར་བའི་སྐྱེས་བུ་དེས་འཇིམ་པ་བརྫིས་ཏེ་ངའི་མིག་ཟུང་ལ་བསྐུས༌རྗེས། སི་ལོ་ཨམ་རྫིང་བུའི་ནང་དུ་མིག་ཟུང་བཀྲུ་བར་སོང་ཞིག་ཅེས་སྨྲས་པ༌དང༌། ང་རང་སོང་སྟེ་བཀྲུས་པ་ན་མིག་གིས་མཐོང་བར་གྱུར་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":12,"content":["དེ་ནས་མི་དེ་རྣམས་ཀྱིས་མི་དེ་གང་དུ་ཡོད་ཅེས་དྲིས་པ༌ལ། ཁོས་མི་ཤེས་ཞེས་སྨྲས༌སོ།།"]},{"type":"heading","content":["ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་དམུས་ལོང་གི་མིག་གསོས་པར་རྩད་བཅད༌པ།"]},{"type":"verse","number":13,"content":["དེ་ནས་མི་དེ་རྣམས་ཀྱིས་སྔོན་ཆད་དམུས་ལོང་ཡིན་པ་དེ་ཉིད་ཕ་རུ་ཤི་པ་རྣམས་ཀྱི་དྲུང་དུ་ཁྲིད་པ་རེད།"]},{"type":"verse","number":14,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འཇིམ་པ་བརྫིས་ནས་དམུས་ལོང་གི་མིག་ཟུང་གསོས་པར་མཛད་པའི་ཉིན་ནི་ངལ་གསོ་བའི་ཉིན་མོ་ཡིན་ནོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་ཀྱང་ཁོའི་མིག་གིས་ཇི་ལྟར་མཐོང་བར་གྱུར་པ་དྲིས་པ༌ལ། ཁོ་ན༌རེ། མི་དེས་འཇིམ་པ་བརྫིས་ཏེ་ངའི་མིག་ལ་བསྐུས་ཤིང་། ངས་འཇིམ་པ་བཀྲུས་པ་དང་མིག་གིས་མཐོང་བར་གྱུར་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཕ་རུ་ཤི་པ་རྣམས་ལས་འགའ་ཞིག་ན༌རེ། མི་དེས་ངལ་གསོ་བའི་ཉིན་མོའི་བཀའ་ཁྲིམས་སྲུང་བཞིན་མེད་པས་དཀོན་མཆོག་ནས་བྱུང་བ་མ་ཡིན་ནོ་ཞེས་སྨྲས་པ༌དང༌། ཡང་འགའ་ཞིག་ན༌རེ། མི་སྡིག་ཅན་གྱིས་དེ་ལྟ་བུའི་གྲུབ་རྟགས་རྣམས་སྟོན་ག་ལ་སྲིད་ཅེས་སྨྲས་པས་དེ་རྣམས་ལ་ལྟ་བ་མི་མཐུན་པ་བྱུང༌ངོ་༎"]},{"type":"verse","number":17,"content":["ཡང་ཕ་རུ་ཤི་པ་དེ་རྣམས་ཀྱིས་སྔོན་ཆད་དམུས་ལོང་ཡིན་པ་དེ༌ལ། མི་དེས་ཁྱོད་ཀྱི་མིག་ཟུང་གསོས་པར་མཛད༌པས། ཁྱོད་ཀྱིས་མི་དེ་ནི་ཅི་ལྟ་བུ་ཡིན་བསམ་མམ་ཞེས་དྲིས་པ༌ལ། ཁོ་ན༌རེ། མི་དེ་ནི་ལུང་སྟོན་པ་ཞིག་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":18,"content":["དེ་ནས་ཡ་ཧུ་དཱ་པ་དེ་རྣམས་ཀྱིས་སྔོན་ཆད་དམུས་ལོང་ཡིན་ཞིང་རྗེས་སུ་མིག་གིས་མཐོང་བར་གྱུར་པའི་དོན་དེ་ལ་ཡིད་མ་ཆེས༌པར། ཁོའི་ཕ་མ་གཉིས་བོས་ཏེ་ན༌རེ།"]},{"type":"verse","number":19,"content":["མི་འདི་ནི་ཁྱོད་གཉིས་ཀྱི་བུ་ཡིན༌ནམ། ཁྱོད་ཕ་མ་གཉིས་ཀྱིས་བཤད་པ་ལྟར་ན་ཁོ་ནི་སྐྱེས་མ་ཐག་ནས་ལོང་བ་ཡིན༌ཟེར། འོ་ན་ད་ལྟ་ཁོའི་མིག་གིས་ཇི་ལྟར་མཐོང་བར་གྱུར་རམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":20,"content":["ཕ་མ་གཉིས་ན༌རེ། ཁོ་ནི་ངེད་གཉིས་ཀྱི་བུ་ཡིན་ཞིང་སྐྱེས་མ་ཐག་ནས་ལོང་བ་ཡིན་པ་ངེད་གཉིས་ཀྱིས་ཤེས་སོ།།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་ད་ལྟ་ཁོའི་མིག་གིས་ཇི་ལྟར་མཐོང་བར་གྱུར་པ་དང་། སུ་ཞིག་གིས་ཁོའི་མིག་ཟུང་གསོས་པར་མཛད་པའི་དོན་ནི་ངེད་གཉིས་ཀྱིས་མི་ཤེས༌ཏེ། ཁོ་རང་ནར་སོན་པས་ཁོ་རང་ལ་དྲིས་དང་སྨྲ་ངེས་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":22,"content":["ཁོའི་ཕ་མ་གཉིས་ཀྱིས་དེ་སྐད་སྨྲས་པ་ནི་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འཇིགས༌པ་རེད། རྒྱུ་མཚན་ནི་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་མི་སུ་ཞིག་གིས་ཡེ་ཤུ་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་ཟེར༌ན། མི་དེ་ཆོས་ཁང་ནས་ཕྱི་རུ་འདོན་པར་གྲོས་ཐག་བཅད་ཡོད་པའི་རྐྱེན༌གྱིས།"]},{"type":"verse","number":23,"content":["ཁོའི་ཕ་མ་གཉིས་ཀྱིས་ཀྱང་ཁོ་རང་ནར་སོན་པས་ཁོ་ལ་དྲིས་ཤིག་ཅེས་སྨྲས་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":24,"content":["དེའི༌ཕྱིར། ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་སླར་ཡང་སྔོན་ཆད་ལོང་བ་ཡིན་པ་དེ་ཉིད་བོས་ཡོང་སྟེ་ན༌རེ། ཁྱོད་ཀྱིས་དཀོན་མཆོག་ལ་བསྔགས་བརྗོད་བྱོས༌ཤིག མི་དེ་ནི་སྡིག་ཅན་ཞིག་ཡིན་པ་ངེད་རྣམས་ཀྱིས་ཤེས་པ་ཡིན་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":25,"content":["ཁོ་ན༌རེ། མི་དེ་ནི་སྡིག་ཅན་ཞིག་ཡིན་མིན་ངས་མི་ཤེས༌ལ། སྔོན་ཆད་ང་རང་ནི་དམུས་ལོང་ཡིན་ཡང་ད་ལྟ་མིག་གིས་མཐོང་བ་འདི་བདག་གིས་ཤེས་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":26,"content":["ཡང་ཕ་རུ་ཤི་པ་རྣམས་ན༌རེ། མི་དེས་ཁྱོད་ལ་ཅི་བྱས་པ་ཡིན༌ནམ། ཁྱོད་ཀྱི་མིག་ཟུང་ཇི་ལྟར་སོས་པ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":27,"content":["ཡང་ཁོ་ན༌རེ། ངས་ཁྱོད་རྣམས་ལ་ལན་གཅིག་བཤད་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་མ་མཉན། ད་ནི་ཅིའི་ཕྱིར་མཉན་འདོད༌དམ། ཁྱོད་རྣམས་ཀྱང་མི་དེའི་རྗེས་འབྲང་པ་བྱེད་འདོད་པ་ཡིན་ནམ་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":28,"content":["དེ་རྣམས་ན༌རེ། ཁྱོད་ནི་མི་དེའི་རྗེས་འབྲང་པ་ཡིན་ཞིང་ངེད་ཅག་ནི་མོ་ཤེའི་རྗེས་འབྲང་པ་ཡིན།"]},{"type":"verse","number":29,"content":["དཀོན་མཆོག་གིས་མོ་ཤེ་ལ་གསུང་གླེང་མཛད་མྱོང་བའི་དོན་དེ་ངེད་རྣམས་ཀྱིས་ཤེས་སོ།། འོན་ཀྱང་མི་དེ་ཡུལ་གང་ནས་ཡོང་བ་མི་ཤེས་ཞེས་སྡིགས་དམོད་བྱས་སོ།།"]},{"type":"verse","number":30,"content":["ཡང་ཁོ་ན༌རེ། ཁོང་གིས་ངའི་མིག་གསོས་པར་མཛད་ཅིང་ཁྱོད་རྣམས་ཀྱིས་ཁོང་ནི་ཡུལ་གང་ནས་ཡོང་བའང་མི་ཤེས་པས་ཡ་མཚན༌ཆེ།"]},{"type":"verse","number":31,"content":["དཀོན་མཆོག་གིས་མི་སྡིག་ཅན་གྱི་གསོལ་འདེབས་ལ་མི་གསན་ཞིང༌། དཀོན་མཆོག་ལ་དད་གུས་ལྡན་པ་དང་ཁོང་གི་དགོངས་པ་བཞིན་དུ་བྱེད་མཁན་རྣམས་ཀྱིས་གསོལ་བ་བཏབ་པ་ལ་ཁོང་གིས་གསན་ངེས་པ་བདག་ཅག་གིས་ཤེས་སོ།།"]},{"type":"verse","number":32,"content":["འཇིག་རྟེན་བཀོད་པའི་ཚུན་ལ་མི་སུས་ཀྱང་དམུས་ལོང་གི་མིག་ཟུང་གསོས་པར་མཛད་པའི་དོན་ཐོས་མ་མྱོང༌།"]},{"type":"verse","number":33,"content":["གལ་ཏེ་མི་དེ་ནི་དཀོན་མཆོག་ནས་བྱུང་བ་མིན༌ན། དོན་ཅི་ཡང་མཛད་མི་ནུས་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":34,"content":["ཡང་དེ་རྣམས་ན༌རེ། ཁྱོད་ནི་སྐྱེས་པའི་དུས་ནས་སྡིག་ཅན་ཤ་སྟག་ཡིན་ཞིང་ད་དུང་ངེད་རྣམས་ལ་བསླབ་བྱ་གཏོང་འདོད་དམ་ཞེས་སྨྲས་ཏེ་ཁོ་རང་ཕྱི་རུ་བཏོན༌ཏོ།།"]},{"type":"heading","content":["དད་པ་མེད་པའི་དམུས་ལོང་ལྟ་བུ་རྣམས་ལ་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":35,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་མིག་ཟུང་གསོས་པའི་མི་དེ་ཕྱི་རུ་བཏོན་པའི་གཏམ་ཐོས༌ཤིང༌། མི་དེ་བཙལ་ནས་རྙེད་དེ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་མིའི་བུ་ལ་དད་པ་བྱེད་དམ་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":36,"content":["ཁོ་ན༌རེ། ཇོ་བོ༌ལགས། ཁོང་སུ་ཡིན༌ནམ། ཁྱོད་ཀྱིས་གསུངས་དང་བདག་གིས་དད་པ་བྱའོ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":37,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་ཁོང་ཉིད་མཐོང་མྱོང་ཞིང་ད་ལྟ་ཁྱོད་དང་གཏམ་སྨྲ་བཞིན་པ་འདི་ནི་ཁོ་རང་ཡིན་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":38,"content":["ཡང་ཁོ་ན༌རེ། གཙོ་བོ༌ལགས། ངས་དད་པ་བྱེད་ཅེས་ཞུས་པ་དང་ཁོང་ལ་ཕྱག་བཙལ་ཏོ།།"]},{"type":"verse","number":39,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ང་ནི་འཇིག་རྟེན་འདི་ལ་ལེགས་ཉེས་ཀྱི་ཤན་འབྱེད་དུ་ཡོང་བ་ཡིན༌ཏེ། ལོང་བ་རྣམས་ལ་མཐོང་བར་བྱེད་ཅིང་མཐོང་བ་རྣམས་ནི་ལོང་བར་འགྱུར་བའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":40,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཡོད་པའི་ཕ་རུ་ཤི་པ་འགའ་ཞིག་གིས་ཀྱང་གསུངས་དེ་ཐོས་ནས་འདི༌ལྟར། དེས་ན་ངེད་རྣམས་ཀྱང་ལོང་བ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":41,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གལ་ཏེ་ཁྱོད་རྣམས་ལོང་བ་ཡིན་ན་སྡིག་པའང་མེད། འོན་ཀྱང་ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་མིག་གིས་མཐོང་བ་ཡིན་ཞེས་ཟེར༌བས། ཁྱོད་ཅག་གི་རྒྱུད་དུ་ད་དུང་སྡིག་པ་ཡོད་ཅེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JHN/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JHN/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JHN/8.json","previousChapterAudioLinks":{},"numberOfVerses":41}