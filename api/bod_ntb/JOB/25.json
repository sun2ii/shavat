{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOB","translationId":"bod_ntb","name":"ཨེས་ཡོབ།","commonName":"ཨེས་ཡོབ།","title":"༄༅། །ཨེས་ཡོབ་ཀྱི་མདོ།","order":18,"numberOfChapters":42,"sha256":"423db00918d3fe34b11f2fc2cf673e579d102f1eb83e71c7a540a90e9f0feb2c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bod_ntb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["པེལ་དེལ་གྱི་ཁ་བརྡ་གསུམ་པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཤུ་ཧེ་པ་པེལ་དེལ་གྱིས་ལན་བཏབ་ནས་སྨྲས་པ།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཁོང་ཉིད་དབང་བསྒྱུར་མཛད་མཁན་ཏེ། ། འཇིགས་སུ་རུང་ཞིང་མཐོ་སར་ཞི་བདེ་མཛད། །"]},{"type":"verse","number":3,"content":["ཁོང་གི་དཔུང་ཚོགས་རྣམས་ནི་བགྲང་ལས་འདས། ། ཁོང་གི་འོད་ནི་སུ་ལ་མི་འཆར་རམ། །"]},{"type":"verse","number":4,"content":["དེ་བས་དཀོན་མཆོག་ཁོང་གི་སྐུ་དྲུང་དུ། ། མི་ནི་ཇི་ལྟར་དྲང་བདེན་ཅན་དུ་བརྩི། ། བུད་མེད་དག་ལས་བཙས་པ་ཇི་ལྟར་གཙང་། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་དྲུང་དུ་ཟླ་བར་བཀྲག་མདངས་མེད། ། ཁོང་གི་གཟིགས་ངོར་སྐར་མ་དྭངས་གཙང་མིན། །"]},{"type":"verse","number":6,"content":["དེ་བས་འབུ་དང་འདྲ་བའི་མི་རྣམས་དང་། ། སྐྱག་འབུ་ལྟ་བུའི་མི་ནི་སྨྲ་ཅི་དགོས། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_n