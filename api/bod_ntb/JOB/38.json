{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOB","translationId":"bod_ntb","name":"ཨེས་ཡོབ།","commonName":"ཨེས་ཡོབ།","title":"༄༅། །ཨེས་ཡོབ་ཀྱི་མདོ།","order":18,"numberOfChapters":42,"sha256":"423db00918d3fe34b11f2fc2cf673e579d102f1eb83e71c7a540a90e9f0feb2c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bod_ntb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["ཡ་ཝཱེས་ཨེས་ཡོབ་ལ་བཀའ་ལན་གནང་བ།"]},{"type":"verse","number":1,"content":["དུས་དེར་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་གིས་རླུང་འཚུབ་ནང། ། ཨེས་ཡོབ་ཁོང་ལ་བཀའ་ལན་གནང་ཞིང་འདི་སྐད་གསུངས། །"]},{"type":"verse","number":2,"content":["སུ་ཡིས་ཤེས་རབ་དང་ནི་བྲལ་བའི་གཏམ་གླེང་གིས། ། ང་ཡི་ཐུགས་དགོངས་གསལ་མིན་རྟོགས་དཀའི་གནས་སུ་བསྒྱུར། །"]},{"type":"verse","number":3,"content":["ཁྱོད་ཀྱིས་དཔའ་བོ་བཞིན་དུ་སྐ་རགས་ཆིངས་ཤིག་དང་། ། བདག་གིས་ཁྱོད་ལ་འདྲི་དུས་ཁྱོད་ཀྱིས་ལན་ཐོབས་ཤིག །"]},{"type":"verse","number":4,"content":["བདག་གིས་ས་གཞིའི་རྨང་གཞི་འགོད་དུས་སུ། ། ཁྱོད་རང་གང་དུ་ཡོད་པ་རྟོགས་ན་ཤོད། །"]},{"type":"verse","number":5,"content":["སའི་ཚད་སུས་བླངས་ཁྱོད་ལ་ཆ་ཡོད་དམ། ། ཡང་ན་དེའི་ངོས་སྐྱ་ཐིག་སུ་ཡིས་བརྒྱབ། །"]},{"type":"verse","number":6,"content":["ས་ཡི་རྨང་གཞི་གང་གི་སྟེང་དུ་བཙུགས། ། ས་གཞིའི་ཟུར་རྡོ་སུ་ཡིས་བཞག་པ་ཡིན། །"]},{"type":"verse","number":7,"content":["དུས་དེར་ཐོ་རངས་སྐར་མས་མཉམ་མགུར་བླངས། ། དཀོན་མཆོག་ཕོ་ཉ་",{"noteId":13},"ཀུན་གྱིས་དགའ་འབོད་བྱས། །"]},{"type":"verse","number":8,"content":["མངལ་ལས་ཐོན་བཞིན་རྒྱ་མཚོ་འཕྱུར་བའི་དུས། ། སུ་ཡིས་དེ་རྣམས་སྒོ་ཡིས་བཀག་པ་ཡིན། །"]},{"type":"verse","number":9,"content":["བདག་གིས་རྒྱ་མཚོའི་གོས་སུ་སྤྲིན་བྱས་ཤིང་། ། མུན་ནག་དེ་ཉིད་བཏུམ་བྱའི་རས་སུ་བསྒྱུར། །"]},{"type":"verse","number":10,"content":["བདག་གིས་དེ་ལ་ས་མཚམས་ཤིག་བཅད་དེ། ། སྒོ་གཏན་དང་ནི་སྒོ་མོ་རྣམས་བཙུགས་ཤིང་། །"]},{"type":"verse","number":11,"content":["ཁྱོད་ནི་འདི་རུ་སླེབས་ནས་ཕར་ལ་བརྒལ་མི་རུང་། ། ཆེས་ཆེར་རྒྱས་པའི་རྦ་རླབས་འདི་ནས་མཚམས་ཆོད་སྨྲས། །"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་ཚེ་ནང་སྐྱ་མདའ་གཏོང་བར་བཀའ་བཀོད་ཅིང་། ། ཞོགས་པའི་སྐྱ་རེངས་ལ་ནི་རང་གནས་རྟོགས་བཅུག་སྟེ། །"]},{"type":"verse","number":13,"content":["འོད་དེ་ས་གཞིའི་ཕྱོགས་མཐར་འཕྲོས་ནས་ནི། ། ས་ལས་སྡིག་སྤྱོད་ཅན་རྣམས་བསྐྲད་དམ་ཅི། །"]},{"type":"verse","number":14,"content":["ས་ངོས་ཐམ་ཀའི་འོག་གི་འཇིམ་བཞིན་འགྱུར། ། དངོས་པོ་ཐམས་ཅད་གོས་དང་འདྲ་བར་མངོན། །"]},{"type":"verse","number":15,"content":["དེ་ལྟར་སྡིག་སྤྱོད་རྣམས་ཀྱི་འོད་མི་སྤྲོ། ། མཐོར་འདེགས་དཔུང་ངར་རྣམས་ཀྱང་གཅོག་པར་མཛད། །"]},{"type":"verse","number":16,"content":["རྒྱ་མཚོ་འཕྱུར་བའི་གནས་སུ་ཁྱོད་ཕྱིན་ནམ། ། ཡང་ན་གཏིང་ཟབ་གནས་སུ་བསྐྱོད་མྱོང་ངམ། །"]},{"type":"verse","number":17,"content":["འཆི་བའི་སྒོ་རྣམས་ཁྱོད་ལ་མངོན་གྱུར་ཏམ། ། སྨག་རུམ་སྒོ་རྣམས་ཁྱོད་ཀྱིས་མཐོང་མྱོང་ངམ། །"]},{"type":"verse","number":18,"content":["རྒྱ་ཆེན་ས་གཞི་ཁྱོད་ཀྱིས་ཚད་ཐུབ་བམ། ། ཁྱོད་ཀྱིས་འདི་ཀུན་ཤེས་ན་ད་ཤོད་ཅིག །"]},{"type":"verse","number":19,"content":["འོད་ལྡན་ཁྱིམ་གྱི་ལམ་དེ་གང་ཡིན་ནམ། ། མུན་པ་དེ་ཡི་རང་གནས་གང་དུ་ཡོད། །"]},{"type":"verse","number":20,"content":["ཁྱོད་ཀྱིས་དེ་རྣམས་རང་གི་མངའ་ཁོངས་སུ། ། ཁྲིད་དེ་ཁྱིམ་དེར་འགྲོ་བའི་ལམ་ཤེས་སམ། །"]},{"type":"verse","number":21,"content":["དུས་དེར་ཁྱོད་རང་སྐྱེས་པས་ཁྱོད་ཀྱིས་ཤེས། ། ཁྱོད་ཀྱིས་མི་ཚེའི་ཉི་མ་མང་པོ་བསྐྱལ། །"]},{"type":"verse","number":22,"content":["ཁ་བ་འབྱུང་བའི་གནས་སུ་ཁྱོད་སླེབས་སམ། ། ཡང་ན་སེར་བའི་བང་མཛོད་རྣམས་མཐོང་ངམ། །"]},{"type":"verse","number":23,"content":["དེ་རྣམས་བདག་གིས་དཀའ་སྡུག་འབྱུང་དུས་དང་། ། དམག་དང་འཐབ་མོའི་ཕྱིར་དུ་མཛད་པ་ཡིན། །"]},{"type":"verse","number":24,"content":["གློག་དམར་ལམ་བུ་གང་ནས་བཀར་བ་དང་། ། ཤར་རླུང་ས་གཞིའི་སྟེང་ལ་ཅི་ལྟར་ཐོར། །"]},{"type":"verse","number":25,"content":["སུ་ཡིས་ཆར་ཆུའི་རྒྱུ་ལམ་གཤགས། ། སུ་ཡིས་ཐོག་ལ་བགྲོད་ལམ་ཕྱེས། །"]},{"type":"verse","number":26,"content":["མི་མེད་ལུང་སྟོང་ལ་ནི་ཆར་གནང་ཞིང་། ། དབེན་སྟོང་ཡུལ་ལ་ཆར་བ་འབབ་ཏུ་བཅུག །"]},{"type":"verse","number":27,"content":["ཐང་རྒོད་ལུས་པའི་ས་ནི་བརླན་གཤེར་རྒྱས། ། རྩྭ་སྔོན་དག་ནི་སྐམ་སར་སྐྱེས་སུ་བཅུག །"]},{"type":"verse","number":28,"content":["ཆར་བ་ལ་ནི་ཕ་ཡོད་དམ། ། ཟིལ་བ་སུ་ལས་སྐྱེས་པ་ཡིན། །"]},{"type":"verse","number":29,"content":["འཁྱགས་རོམ་གང་གི་མངལ་ལས་བྱུང་བ་ཡིན། ། ནམ་མཁའི་བ་མོ་སུ་ལས་སྐྱེས་པ་ཡིན། །"]},{"type":"verse","number":30,"content":["ཆུ་རྣམས་སྲ་ཤིང་རྡོ་ལྟར་གྱུར། ། གཏིང་ཟབ་ངོས་སུ་འཁྱགས་རོམ་ཆགས། །"]},{"type":"verse","number":31,"content":["སྨིན་དྲུག་སྐར་མ་ཁྱོད་ཀྱིས་འཆིང་ནུས་སམ། ། དྲང་སྲོང་སྐར་མ་ཁྱོད་ཀྱིས་སྒྲོལ་ནུས་སམ། །"]},{"type":"verse","number":32,"content":["ཁྱོད་ཀྱིས་དུས་ལྟར་སྐར་ཁྱིམ་དག་ནི་འདྲེན་ནུས་སམ། ། སྨིན་བདུན་དང་ནི་རྒྱུ་སྐར་གཞན་དག་འཁྲིད་ནུས་སམ། །"]},{"type":"verse","number":33,"content":["ནམ་མཁའི་ཆོས་ཉིད་ཁྱོད་ཀྱིས་ཤེས་ལགས་སམ། ། དེ་ཡི་དབང་འོག་ས་གཞི་འཇུག་ཐུབ་བམ། །"]},{"type":"verse","number":34,"content":["ཁྱོད་ཀྱིས་ཆུ་འཛིན་སྤྲིན་ཕུང་ཕྱོགས་ལ་སྐད་བརྒྱབ་ནས། ། དྲག་ཆར་ལ་ནི་ཁྱོད་རང་འགེབ་ཏུ་འཇུག་ནུས་སམ། །"]},{"type":"verse","number":35,"content":["གློག་དམར་འཁྱུག་ཏུ་ཁྱོད་ཀྱིས་མངག་ནུས་སམ། ། ངེད་འདིར་ཡོད་ཅེས་ཁྱོད་ལ་ཞུ་འོང་ངམ། །"]},{"type":"verse","number":36,"content":["སུ་ཡིས་ཤེས་རབ་སེམས་གཏིང་བཞག་པ་དང་། ། མི་ཡི་སེམས་ལ་གོ་རྟོགས་སུ་ཡིས་བསྩལ། །"]},{"type":"verse","number":37,"content":["ཤེས་རབ་ཀྱིས་ནི་ཆུ་འཛིན་སུས་བགྲང་ནུས། ། ནམ་མཁའི་ཆུ་རྐྱལ་རྣམས་ཀྱང་སུས་ཕྱོ་ནུས། །"]},{"type":"verse","number":38,"content":["དེའི་དུས་ས་རྡུལ་འདུས་ཏེ་གོང་བུར་ཆགས། ། ས་རྡོག་རྣམས་ནི་གཅིག་ལ་གཅིག་འབྲེལ་ལོ། །"]},{"type":"verse","number":39,"content":["ཁྱོད་ཀྱིས་མོ་སེང་ཆེད་དུ་རྔོན་རྒྱག་ཅིང་། ། སེང་གེའི་ལྟོ་བ་འགྲང་བར་བྱེད་ནུས་སམ། །"]},{"type":"verse","number":40,"content":["དེའི་དུས་དེ་རྣམས་དོང་ནང་འཇབ་པ་དང་། ། གསང་བའི་གནས་སུ་ཡིབ་ནས་སྡོད་པ་ཡིན། །"]},{"type":"verse","number":41,"content":["ཕོ་རོག་བྱ་ཕྲུག་ཁ་ཟས་མེད་པས་ན། ། ཐང་ནས་མྱུལ་ཞིང་དཀོན་མཆོག་ཞུ་བའི་དུས། ། སུ་ཡིས་ཕོ་རོག་ཆེད་དུ་ཟས་གནང་ངམ། །"]}],"footnotes":[{"noteId":13,"caller":"+","text":"འདིར་ཕོ་ཉ་ཞེས་པར་མ་ཕྱི་ལས་དཀོན་མཆོག་གི་སྲས་རྣམས་ཞེས་མཐོང་།","reference":{"chapter":38,"verse":7}}]},"thisChapterLink":"/api/bod_ntb/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}