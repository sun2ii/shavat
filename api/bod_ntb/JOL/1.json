{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOL","translationId":"bod_ntb","name":"ཡོ་ཨེལ།","commonName":"ཡོ་ཨེལ།","title":"༄༅། །ལུང་སྟོན་པ་ཡོ་ཨེལ་གྱི་མདོ།","order":29,"numberOfChapters":3,"sha256":"356f99409eb56e48ebf9e62c4fe2fc534cc6bd96603c0e96c146c24406e7a001","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bod_ntb/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["མི་རྣམས་ཀྱི་སྡུག་བསྔལ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཕེ་ཏུ་ཨེལ་གྱི་བུ་ཡོ་ཨེལ་ལ་བྱུང་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":2,"content":["ཀྱེ་རྒན་པ་རྣམས་ཀྱིས་གཏམ་འདི་ལ་ཉོན་ཅིག ཀྱེ་ཡུལ་འདིའི་མི་སྡེ་ཐམས་ཅད་ཀྱིས་རྣ་བ་གཏད་ནས་གཏམ་འདི་ལ་ཉོན་ཅིག ཁྱོད་རང་གི་དུས་དང་། ཁྱོད་ཚོའི་ཕ་མེས་རྣམས་ཀྱི་རིང་ལ་འདི་འདྲ་བྱུང་མྱོང་ངམ།"]},{"type":"verse","number":3,"content":["དོན་འདི་ནི་ཁྱོད་རྣམས་ཀྱིས་རང་གི་བུ་རྒྱུད་རྣམས་དང་། དེ་རྣམས་ཀྱིས་ཚ་རྒྱུད་རྣམས། དེ་རྣམས་ཀྱིས་བུ་རབས་ཚ་རྒྱུད་རྣམས་ལ་བཤད་དགོས།"]},{"type":"verse","number":4,"content":["ཆ་ག་པའི་འབུ་ཆུང་ལས་ལུས་པ་ནི་ཆ་ག་འབུ་ཡིས་ཟོས་པ་དང་། ཆ་ག་འབུ་ལས་ལུས་པ་ནི་ཆ་ག་པས་ཟོས་ཤིང་། ཆ་ག་པ་ལས་ལུས་པ་དེ་ཨ་ཚག་ཚག་པས་ཟོས།"]},{"type":"verse","number":5,"content":["ཀྱེ་ཆང་གིས་ར་བཟི་བ་རྣམས་ནི་གཉིད་ལས་སད་པར་གྱིས་ལ་ངུས་ཤིག ཆང་ལ་དགའ་བ་ཐམས་ཅད་ཀྱིས་རྒུན་ཆང་མངར་མོའི་ཆེད་དུ་ངུ་འབོད་གྱིས་ཤིག གང་ལ་ཞེ་ན། ཆང་དེ་ནི་ཁྱོད་ཀྱི་ཁ་དང་བྲལ་བས་སོ། །"]},{"type":"verse","number":6,"content":["ཆ་ག་འབུ་ཡི་དཔུང་ཚོགས་སྟོབས་ལྡན་གྲངས་ལས་འདས་པ་ཞིག་ངའི་ཡུལ་ལ་ཚུར་རྒོལ་བྱེད་དུ་ཡར་འོངས་པ་དང་། དེའི་སོ་རྣམས་ནི་སེང་གེའི་སོ་དང་འདྲ་ཞིང་མོ་སེང་གི་མཆེ་བ་དང་འདྲའོ། །"]},{"type":"verse","number":7,"content":["དེས་ངའི་རྒུན་ཤིང་ལ་གཏོར་བརླག་བྱས་པ་དང་། ངའི་སེ་ཡབ་ཤིང་བཅག་ནས་དེའི་སྡོང་ཤུན་བཤུས་ཏེ་གཡུགས་ཤིང་། ཡལ་ག་རྣམས་དཀར་པོར་ལུས།"]},{"type":"verse","number":8,"content":["ན་ཆུང་མ་ཞིག་གིས་སྐེད་པར་རྩིད་རས་གཡོགས་ཏེ། རང་གི་ལོ་ན་གཞོན་དུས་ཀྱི་ཁྱོ་གའི་ཕྱིར་དུ་ངུ་འབོད་བྱེད་པ་བཞིན་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ངུ་འབོད་གྱིས་ཤིག"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་དུ་འབྲུ་མཆོད་དང་སྐྱེམས་མཆོད་རྣམས་མཚམས་ཆད་པས། དཀོན་མཆོག་ཡ་ཝཱེར་ཞབས་ཕྱི་བྱེད་མཁན་མཆོད་དཔོན་རྣམས་ཀྱང་སྡུག་གོ །"]},{"type":"verse","number":10,"content":["འབྲུ་རིགས་བརླགས་ནས་རྒུན་ཆང་གསར་པ་སྐམ་པ་དང་། སྣུམ་གསར་པ་ཡང་ཟད་པས་ན། ས་ཞིང་སྟོངས་ནས་ས་གཞི་ཡང་སྐྱོའོ། །"]},{"type":"verse","number":11,"content":["ཀྱེ་ཞིང་པ་རྣམས། ཁྱོད་ཚོ་སྐྱེངས་པར་གྱིས་ཤིག ཀྱེ་རྒུན་ཚལ་ལ་བདག་བྱེད་མཁན་རྣམས། ཁྱོད་ཚོས་ངུ་འབོད་བྱོས་དང་། ཞིང་ཁའི་སྟོན་ཐོག་ཐམས་ཅད་བརླགས་པས་ན། གྲོ་དང་ནས་ཀྱི་དོན་དུ་མྱ་ངན་བྱོས་ཤིག"]},{"type":"verse","number":12,"content":["རྒུན་འབྲུམ་ཤིང་ནི་སྐམ་ཞིང་སེ་ཡབ་ཤིང་ནི་རྙིད་པ་དང་། སེ་འབྲུ་དང་ཏ་ལའི་ཤིང་དང་ཀུ་ཤུའི་སྡོང་པོ་ལ་སོགས་པ་སྟེ་ཞིང་ཁའི་ལྗོན་ཤིང་ཐམས་ཅད་ཀྱང་སྐམ་ནས། མི་རྣམས་ཀྱི་དགའ་སྤྲོ་ཡོངས་སུ་མེད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":13,"content":["ཀྱེ་མཆོད་དཔོན་རྣམས་ཀྱིས་རྩིད་རས་དཀྲིས་ནས་མྱ་ངན་གྱིས་ཤིག ཀྱེ་མཆོད་ཁྲི་ལ་ཞབས་ཏོག་སྒྲུབ་མཁན་རྣམས་ཀྱིས་ངུ་འབོད་བྱོས་ཤིག ཀྱེ་ངའི་དཀོན་མཆོག་ལ་ཞབས་ཕྱི་བྱེད་མཁན་ཁྱོད་རྣམས་ཡར་འོངས་ནས་རྩིད་རས་གྱོན་ཏེ་མཚན་གང་པོར་མྱ་ངན་གྱིས་ཤིག གང་ལ་ཞེ་ན། ཁྱོད་ཚོའི་དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་འབྲུ་མཆོད་དང་སྐྱེམས་མཆོད་མཚམས་བཞག་པས་སོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ཚོས་སྨྱུང་གནས་ཀྱི་དུས་ནི་དམ་པར་རྩིས་ལ། འདུ་འཛོམས་དམ་ནན་ཡོངས་སུ་སྒྲོགས་དང་། ས་འདིའི་རྒན་པོ་རྣམས་དང་ཡུལ་མི་ཐམས་ཅད་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་བསྡུས་ནས། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འོ་དོད་བོས་ཤིག"]},{"type":"verse","number":15,"content":["ཉིན་མོ་དེའི་ཕྱིར་སྐྱོ་བ་ལ། གང་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་མོ་དེ་ནི་ཉེ་བར་སླེབས་པ་སྟེ། ཀུན་དབང་ཉིད་ཀྱི་ཕྱོགས་ནས་གཏོར་སྐྱོན་སླེབས་པ་དང་འདྲ།"]},{"type":"verse","number":16,"content":["འབྲུ་རིགས་ནི་ངེད་རྣམས་ཀྱི་མིག་མདུན་ནས་ཚར་བ་མིན་ནམ། རང་རེའི་དཀོན་མཆོག་གི་མཆོད་ཁང་ལས་སྤྲོ་སྐྱིད་དང་དགའ་སྣང་ཡལ་བ་མིན་ནམ།"]},{"type":"verse","number":17,"content":["ས་བོན་ས་འོག་ནས་རུལ་ཏེ། འབྲུ་རིགས་རྣམས་སྐམ་པས་ན་འབྲུ་མཛོད་སྟོང་བར་ལུས་ཤིང་བང་ཁང་རྣམས་ཞིག་རལ་དུ་གྱུར།"]},{"type":"verse","number":18,"content":["ཕྱུགས་ཟོག་གིས་སྨྲེ་སྔགས་འདོན་ཞིང་། རྩྭ་ས་མེད་པས་བ་ཁྱུ་རྣམས་གང་སར་ཉུལ། ར་ལུག་གི་ཁྱུ་རྣམས་ཀྱིས་ཀྱང་སྡུག་མྱངས་སོ། །"]},{"type":"verse","number":19,"content":["ཀྱེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལགས། ངས་ཁྱེད་ལ་ཞུ་འབོད་བྱེད་དེ། ཅི་ལ་ཞེ་ན། ཐང་རྒོད་ཀྱི་རྩྭ་ས་རྣམས་མེས་བསྲེགས་པ་དང་། ཞིང་ཁའི་ལྗོན་ཤིང་ཐམས་ཅད་མེ་ལྕེས་ཚིག་པའོ། །"]},{"type":"verse","number":20,"content":["ཆུ་ཕྲན་རྣམས་སྐམ་ནས་ཐང་རྒོད་ཀྱི་རྩྭ་ས་རྣམས་མེས་བསྲེགས་པས། ཐང་གི་རི་དྭགས་རྣམས་ཀྱིས་ཀྱང་ཁྱེད་ལ་ཧལ་སྒྲ་འབྱིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}