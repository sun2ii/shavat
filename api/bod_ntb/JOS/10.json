{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":10,"content":[{"type":"heading","content":["ཉི་མ་འཁོར་མཚམས་བཞག་པ།"]},{"type":"verse","number":1,"content":["ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་ཨ་དོ་ནི་ཚེ་དེག་གིས། ཡོ་ཤུ་ཨ་ཡིས་ཨེ་ཡུ་གྲོང་ཁྱེར་བཅོམ་ནས་རྩ་མེད་དུ་བཏང་བ་དང་། ཡེ་རུ་ཀོ་དང་དེའི་རྒྱལ་པོ་ལ་ཇི་ལྟར་བྱས་པ་བཞིན་དུ་ཨེ་ཡུ་གྲོང་ཁྱེར་དང་དེའི་རྒྱལ་པོ་ལའང་དེ་ལྟར་བྱས་པ་ཐོས་ཤིང་། གིབ་ཡོན་གྱི་མི་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དམ་བཅས་ནས་ཁོ་ཚོའི་ཁྲོད་དུ་གནས་པ་ཡང་ཐོས་ཏེ།"]},{"type":"verse","number":2,"content":["གིབ་ཡོན་ནི་རྒྱལ་ས་ལྟ་བུའི་གྲོང་ཁྱེར་ཆེན་པོ་ཞིག་ཡིན་པ་དང་ཨེ་ཡུ་གྲོང་ཁྱེར་ལས་ཀྱང་ཆེ་བར་མ་ཟད། གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་དཔའ་རྒོད་ཡིན་པས་ཡེ་རུ་སཱ་ལེམ་པ་རྣམས་ཤིན་ཏུ་འཇིགས་སོ། །"]},{"type":"verse","number":3,"content":["དེའི་ཕྱིར་ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་ཨ་དོ་ནི་ཚེ་དེག་གིས་ཧེབ་རོན་གྱི་རྒྱལ་པོ་ཧོ་ཧམ་དང་། ཡར་མུད་ཀྱི་རྒྱལ་པོ་པིར་ཨམ། ལཱ་ཀི་སིའི་རྒྱལ་པོ་ཡ་ཕི་ཨ། ཨེག་ལོན་གྱི་རྒྱལ་པོ་དི་བིར་བཅས་བཞི་པོའི་མདུན་དུ་མི་མངགས་ནས་དེ་རྣམས་ལ་འདི་ལྟར།"]},{"type":"verse","number":4,"content":["ང་ཚོས་གིབ་ཡོན་ལ་འཐབ་འཛིང་བྱེད་པའི་ཕྱིར་ཁྱེད་རྣམས་ཡར་ངེད་ཅག་ལ་རོགས་བྱེད་དུ་འོང་བར་མཛོད་ཅིག ཅི་ལ་ཞེ་ན། ཁོ་རྣམས་ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འགྲིག་མཐུན་བྱུང་བ་རེད་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཨེ་མོར་པའི་རྒྱལ་པོ་རྣམས་ཏེ། ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་དང་། ཧེབ་རོན་གྱི་རྒྱལ་པོ། ཡར་མུད་ཀྱི་རྒྱལ་པོ། ལཱ་ཀི་སིའི་རྒྱལ་པོ། ཨེག་ལོན་གྱི་རྒྱལ་པོ་བཅས་ལྔ་པོ་འཛོམས་ནས་ཁོ་ཚོའི་དམག་དཔུང་ཐམས་ཅད་ཁྲིད་དེ་ཡར་སོང་ཞིང་། གིབ་ཡོན་གྱི་ཁ་གཏད་དུ་སྒར་བརྒྱབ་ནས་གི་པེ་ཨོན་ལ་དམག་བརྒྱབ།"]},{"type":"verse","number":6,"content":["དེར་གིབ་ཡོན་པ་རྣམས་ཀྱིས་གིལ་གལ་ལ་ཡོད་པའི་སྒར་དུ་ཡོ་ཤུ་ཨའི་རྩར་མི་མངགས་ཏེ། རི་ཁུལ་དུ་སྡོད་པའི་ཨེ་མོར་པའི་རྒྱལ་པོ་རྣམས་མཉམ་དུ་འདུས་ནས་ངེད་རྣམས་ལ་དམག་བརྒྱབ་པས། ཁྱེད་ཀྱིས་རང་གི་གཡོག་པོ་རྣམས་མི་བསྐྱུར་བར་མྱུར་བ་མྱུར་དུ་ཡར་ངེད་རྣམས་སྐྱོབ་ཏུ་ཕེབས་ནས། ངེད་རྣམས་ལ་རོགས་རམ་མཛད་པར་ཞུ་ཞེས་སྨྲས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་དང་ཁོའི་དམག་མི་ཐམས་ཅད། དེར་མ་ཟད་ནུས་སྟོབས་ཆེན་པོའི་དཔའ་རྒོད་དང་བཅས་པ་གིལ་གལ་ནས་ཡར་ཕྱིན་པ་དང་།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། བདག་གིས་ཁོ་རྣམས་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲད་ཟིན་པ་དང་། ཁོ་རྣམས་ཀྱི་ཁྲོད་དུ་ཁྱོད་ཀྱི་མདུན་དུ་ཚུགས་ཐུབ་མཁན་གཅིག་ཀྱང་མེད་པས་ཁོ་ཚོར་མ་འཇིགས་ཤིག་ཅེས་གསུངས་པ་དང།"]},{"type":"verse","number":9,"content":["ཡོ་ཤུ་ཨ་མཚན་བརྒལ་ཏེ་གིལ་གལ་ནས་ཡར་ཕྱིན་ཅིང་གློ་བུར་ཉིད་ལ་ཁོ་ཚོའི་རྩར་སླེབས།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཡེས་ར་ཨེལ་གྱི་མདུན་དུ་མགོ་རྙོག་པར་མཛད། ཡོ་ཤུ་ཨ་ཡིས་གིབ་ཡོན་ནས་ཁོ་རྣམས་ཕམ་པར་བརྒྱབ་པ་དང་། པེད་ཧོ་རོན་གྱི་ལ་ངོས་སུ་ཁོ་རྣམས་ལ་འཐབ་ནས་ཨ་ཟེ་ཀཱ་དང་མག་ཀེ་དཱ་བར་དུ་སླེབས།"]},{"type":"verse","number":11,"content":["ཁོ་རྣམས་ཡེས་ར་ཨེལ་པའི་མདུན་ནས་བྲོས་ཤིང་པེད་ཧོ་རོན་ནས་ཐུར་ལ་འབབ་པའི་དུས་སུ། ཨ་ཟེ་ཀཱ་ལ་སླེབས་རག་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་ནམ་མཁའ་ནས་དེ་རྣམས་ཀྱི་སྟེང་དུ་སེར་བ་ཆེན་པོ་ཕབ་ནས་ཁོ་རྣམས་བསད་དོ། །སེར་བས་བསད་པ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་གྲི་ཡིས་བསད་པ་ལས་ཀྱང་མང་ངོ་། །"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཨེ་མོར་པ་རྣམས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྤྲད་པའི་ཉིན་མོར། ཡོ་ཤུ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྨོན་ལམ་ཞུས་ཤིང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མདུན་དུ་ཇི་སྐད་དུ། ཉི་མ་ཁྱོད་ནི་གིབ་ཡོན་དུ་འདུག་པར་གྱིས། ཟླ་བ་ཁྱོད་ནི་ཨ་ཡཱ་ལོན་ལུང་པར་སྡོད་ཅིག་ཅེས་སྨྲས།"]},{"type":"verse","number":13,"content":["དེ་ནས་འབངས་མི་རྣམས་ཀྱིས་དགྲ་བོ་རྣམས་ལ་དགྲ་ཤ་ལེན་པའི་བར་དུ་ཉི་མ་རང་སོར་ལུས་ཤིང་ཟླ་བ་ཡང་བསྡད། དོན་འདི་ནི་ཡ་ཟ་ཨེར་གྱི་མདོ་ནང་དུ་བཀོད་ཡོད་པ་མ་ཡིན་ནམ། ཉི་མ་ནམ་མཁའི་དབུས་སུ་ལུས་ནས་ཉིན་གཅིག་ཙམ་གྱི་རིང་ལ་ལམ་སང་མ་ནུབ་ཏོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མི་ཡི་སྨོན་ལམ་ལ་ཉིན་མོ་དེ་བཞིན་གསན་པ་ནི་དེའི་སྔོན་དུ་བྱུང་མ་མྱོང་ལ་རྗེས་སུ་ཡང་བྱུང་མ་མྱོང་བ་སྟེ། ཅི་ལ་ཟེར་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་ཕྱིར་འཐབ་མོ་མཛད་པས་སོ། །"]},{"type":"verse","number":15,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཕྱིར་གིལ་གལ་གྱི་སྒར་དུ་ལོག་པ་དང་།"]},{"type":"verse","number":16,"content":["རྒྱལ་པོ་དེ་ལྔ་པོ་བྲོས་སོང་སྟེ་མག་ཀེ་དཱ་བྲག་ཕུག་ནང་དུ་སྦས་སོ། །"]},{"type":"verse","number":17,"content":["མི་ཞིག་གིས་ཡོ་ཤུ་ཨ་ལ། རྒྱལ་པོ་དེ་ལྔ་པོ་རྙེད་ཟིན་ལ། ཐམས་ཅད་མག་ཀེ་དཱ་བྲག་ཕུག་ནང་དུ་སྦས་ཡོད་དོ་ཞེས་སྨྲས།"]},{"type":"verse","number":18,"content":["ཡོ་ཤུ་ཨ་ཡིས། ཁྱོད་རྣམས་ཀྱིས་རྡོ་ཕ་བོང་འགའ་བྲག་ཕུག་ཁར་བསྒྲིལ་ནས་མི་མངགས་ཏེ་བསྲུང་བར་གྱིས་ཤིག"]},{"type":"verse","number":19,"content":["ཡིན་ནའང་ཁྱོད་རྣམས་ཀྱིས་འགོར་འགྱངས་མི་བྱེད་པར་དགྲ་བོའི་ར་མདར་བརྒྱུགས་ཏེ། རྒྱབ་ལོགས་ནས་ཁོ་རྣམས་ལ་རྒོལ་ཏེ་ཁོ་ཚོ་རང་གི་གྲོང་ཁྱེར་ནང་འགྲོ་རུ་མི་འཇུག་པར་གྱིས། ཅི་ལ་ཟེར་ན། ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོ་ཁྱོད་ཅག་གི་ལག་ཏུ་སྤྲད་ཟིན་པས་སོ། །"]},{"type":"verse","number":20,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཁོ་རྣམས་ཡོངས་སུ་རྩ་མེད་དུ་བཏང་བ་དང་། དེ་དག་ལས་ལུས་པ་ཐམས་ཅད་ལྕགས་རིས་བསྐོར་བའི་གྲོང་ཁྱེར་ནང་དུ་འཛུལ།"]},{"type":"verse","number":21,"content":["དེ་ནས་འབངས་མི་རྣམས་བདེ་འཇགས་ངང་མག་ཀེ་དཱ་ཡི་སྒར་དུ་ཡོ་ཤུ་ཨ་ཡོད་སར་ཕྱིར་ལོག་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཚིག་ངན་སྨྲ་ཕོད་མཁན་གཅིག་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":22,"content":["ཡོ་ཤུ་ཨ་ཡིས། བྲག་ཕུག་ཁ་ཕྱེས་ལ་རྒྱལ་པོ་དེ་ལྔ་པོ་བྲག་ཕུག་ནས་ཕྱི་རུ་ངའི་མདུན་དུ་ཁྲིད་ཤོག་ཅིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":23,"content":["མི་རྣམས་ཀྱིས་དེ་བཞིན་བྱས་ཤིང་། རྒྱལ་པོ་དེ་ལྔ་ནི། ཡེ་རུ་སཱ་ལེམ་གྱི་རྒྱལ་པོ་དང་། ཧེབ་རོན་གྱི་རྒྱལ་པོ། ཡར་མུད་ཀྱི་རྒྱལ་པོ། ལཱ་ཀི་སིའི་རྒྱལ་པོ། ཨེག་ལོན་གྱི་རྒྱལ་པོ་བཅས་བྲག་ཕུག་ནས་ཕྱི་རུ་བླངས་ཏེ་ཡོ་ཤུ་ཨའི་མདུན་དུ་ཁྲིད་འོངས་སོ། །"]},{"type":"verse","number":24,"content":["རྒྱལ་པོ་དེ་ལྔ་པོ་ཕྱིར་ཁྲིད་ནས་ཡོ་ཤུ་ཨ་ཡི་མདུན་དུ་སླེབས་པའི་སྐབས་སུ། ཡོ་ཤུ་ཨ་ཡིས་ཡེས་ར་ཨེལ་པའི་མི་རྣམས་བོས་འོངས་ཞིང་། ཁོ་དང་ལྷན་དུ་ཕྱིན་པའི་དམག་དཔོན་དེ་རྣམས་ལ། ཁྱོད་རྣམས་ཚུར་ཤོག་ལ་རྐང་པ་རྒྱལ་པོ་འདི་རྣམས་ཀྱི་སྐེ་ལ་ཞོག་ཅིག་ཅེས་སྨྲས་པ་ན། ཁོ་རྣམས་ཉེ་སར་བཅར་ནས་རྐང་པ་རྒྱལ་པོ་དེ་རྣམས་ཀྱི་སྐེ་ལ་བཞག"]},{"type":"verse","number":25,"content":["ཡོ་ཤུ་ཨས་ཁོ་རྣམས་ལ། ཁྱོད་རྣམས་མ་འཇིགས་མ་འཚབ་ཅིག བློ་རྩ་བརྟན་པོས་སྙིང་རུས་བསྐྱེད་དགོས། ཅི་ལ་ཟེར་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱིས་རྒོལ་བར་འགྱུར་བའི་དགྲ་བོ་ཐམས་ཅད་ལ་འདི་ལྟར་མཛད་ངེས་པས་སོ་ཞེས་གསུངས།"]},{"type":"verse","number":26,"content":["དེ་རྗེས་ཡོ་ཤུ་ཨ་ཡིས་རྒྱལ་པོ་དེ་ལྔ་པོར་བརྒྱབ་ནས་བསད་པ་དང་ཤིང་སྡོང་ལྔ་ཡི་སྟེང་དུ་བཀལ་ཞིང་། ཁོ་རྣམས་དགོང་མོའི་བར་དུ་ཤིང་སྡོང་སྟེང་བཀལ་ནས་བཞག"]},{"type":"verse","number":27,"content":["ཉི་མ་ནུབ་དུས་སུ་ཡོ་ཤུ་ཨ་ཡིས་བཀའ་བསྒོས་པ་དང་། མི་ཡིས་བེམ་པོ་ཤིང་སྡོང་ལས་མར་བླངས་ཤིང་ཁོ་རྣམས་སྦས་མྱོང་བའི་བྲག་ཕུག་ནང་དུ་འཕངས་ཏེ་རྡོ་ཕ་བོང་འགའ་བྲག་ཕུག་ཁར་བཞག་ཅིང་ད་ལྟའི་བར་དུ་ལུས་སོ། །"]},{"type":"heading","content":["གྲོང་ཁྱེར་མང་པོ་བླངས་པ།"]},{"type":"verse","number":28,"content":["ཉིན་མོ་དེར་ཡོ་ཤུ་ཨ་ཡིས་མ་ཀེ་དཱ་ཕྲོགས་ཤིང་གྲོང་ཁྱེར་ནང་གི་མི་དང་རྒྱལ་པོ་གྲི་ཡིས་བསད་པ་དང་། དེའི་ནང་གི་མི་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་བར་རྩ་མེད་དུ་བཏང་། ཁོས་སྔོན་ཆད་ཡེ་རུ་ཀོ་ཡི་རྒྱལ་པོ་ལ་ཇི་ལྟར་བྱས་པ་བཞིན་མག་ཀེ་དཱ་ཡི་རྒྱལ་པོ་ལའང་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":29,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་མག་ཀེ་དཱ་ནས་ལིབ་ནཱའི་ཕྱོགས་སུ་ཕྱིན་ཅིང་དེ་ལ་དམག་དྲངས་སོ། །"]},{"type":"verse","number":30,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ལིབ་ནཱ་དང་དེའི་རྒྱལ་པོ་ཡང་ཡེས་ར་ཨེལ་པའི་ལག་ཏུ་སྤྲད། ཡོ་ཤུ་ཨ་ཡིས་གྲོང་ཁྱེར་དེ་ལ་དམག་བརྒྱབ་ནས་གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་བར་གྲི་ཡིས་བསད། ཁོས་སྔོན་ཆད་ཡེ་རུ་ཀོ་ཡི་རྒྱལ་པོ་ལ་ཇི་ལྟར་བྱས་པ་བཞིན་ལིབ་ནཱ་ཡི་རྒྱལ་པོ་ལའང་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":31,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ལིབ་ནཱ་ནས་ལཱ་ཀི་སིའི་ཕྱོགས་སུ་ཕྱིན་ཅིང་། ལཱ་ཀི་སིའི་ཁ་གཏད་དུ་སྒར་བཏབ་ནས་གྲོང་ཁྱེར་དེ་ལ་དམག་དྲངས།"]},{"type":"verse","number":32,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ལཱ་ཀི་སི་ནི་ཡེས་ར་ཨེལ་པའི་ལག་ཏུ་སྤྲད་དོ། །ཉིན་གཉིས་པར་ཡོ་ཤུ་ཨ་ཡིས་ལཱ་ཀི་སི་ཕྲོགས་ཤིང་། ཁོས་ལིབ་ནཱ་ལ་ཇི་ལྟར་བྱས་པ་དེ་བཞིན་དུ་གྲོང་ཁྱེར་ལ་དམག་བརྒྱབ་ནས་དེའི་ནང་གི་མི་ཐམས་ཅད་གྲིས་བསད།"]},{"type":"verse","number":33,"content":["སྐབས་དེར་གེ་ཟེར་གྱི་རྒྱལ་པོ་ཧོ་རམ་ཡར་ལཱ་ཀི་སི་ལ་རོགས་བྱེད་དུ་འོངས་པ་དང་། ཡོ་ཤུ་ཨ་ཡིས་ཁོ་དང་ཁོའི་འབངས་མི་ཐམས་ཅད་ཕམ་པར་བརྒྱབ་ནས་གཅིག་ཀྱང་མ་བསྐྱུར།"]},{"type":"verse","number":34,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ལཱ་ཀི་སི་ནས་ཨེག་ལོན་ཕྱོགས་སུ་ཕྱིན་ཅིང་། ཨེག་ལོན་གྱི་ཁ་གཏད་དུ་སྒར་བཏབ་ནས་གྲོང་ཁྱེར་དེ་ལ་དམག་དྲངས།"]},{"type":"verse","number":35,"content":["ཉིན་མོ་དེར་གྲོང་ཁྱེར་ཕྲོགས་ཤིང་གྲོང་ཁྱེར་ལ་དམག་བརྒྱབ་ནས་དེའི་ནང་གི་མི་རྣམས་གྲིས་བསད། ཉིན་མོ་དེར་ཡོ་ཤུ་ཨ་ཡིས་ལཱ་ཀི་སི་ལ་ཇི་ལྟར་བྱས་པ་དེ་བཞིན་དུ་གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་རྩ་མེད་དུ་བཏང་།"]},{"type":"verse","number":36,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེག་ལོན་ནས་ཧེབ་རོན་ཕྱོགས་སུ་ཕྱིན་ཅིང་གྲོང་ཁྱེར་དེ་ལ་དམག་དྲངས།"]},{"type":"verse","number":37,"content":["ཧེབ་རོན་དང་དེ་ལ་གཏོགས་པའི་གྲོང་ཚོ་རྣམས་ཕྲོགས་ཤིང་། གྲོང་ཁྱེར་ལ་དམག་བརྒྱབ་ནས་དེའི་རྒྱལ་པོ་དང་གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་བར་གྲིས་བསད། ཁོས་ཨེག་ལོན་ལ་ཇི་ལྟར་བྱས་པ་དེ་བཞིན་དུ་གྲོང་ཁྱེར་དང་གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་རྩ་མེད་དུ་བཏང་།"]},{"type":"verse","number":38,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཕྱིར་དི་བིར་ལ་སླེབས་ཤིང་གྲོང་ཁྱེར་དེ་ལ་དམག་དྲངས།"]},{"type":"verse","number":39,"content":["དི་བིར་དང་དེ་ལ་གཏོགས་པའི་གྲོང་ཚོ་རྣམས་ཕྲོགས་ཤིང་། ཡང་དི་བིར་གྱི་རྒྱལ་པོ་གསོན་བཟུང་བྱས་ནས། གྲོང་ཁྱེར་ནང་གི་མི་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་བར་གྲིས་བསད། ཁོས་སྔར་ཧེབ་རོན་དང་ལིབ་ནཱ། ལིབ་ནཱའི་རྒྱལ་པོ་བཅས་ལ་ཇི་ལྟར་བྱས་པ་དེ་བཞིན་དུ་དི་བིར་དང་དེའི་རྒྱལ་པོ་ལའང་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":40,"content":["དེ་ལྟར། ཡོ་ཤུ་ཨ་ཡིས་ཡུལ་ཐམས་ཅད་དེ་རི་ཁུལ་དང་ནེ་གུབ་ཡུལ། རི་ཀླུང་། རི་ལྡེབས་བཅས་ཀྱི་མི་རྣམས་དང་ཡུལ་དེ་དག་གི་རྒྱལ་པོ་རྣམས་ལ་དམག་བརྒྱབ་ནས་གཅིག་ཀྱང་མ་བསྐྱུར་བ་དང་། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་བསྒོས་པ་བཞིན་དབུགས་དང་ལྡན་པ་ཐམས་ཅད་བསད་དོ། །"]},{"type":"verse","number":41,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཀཱ་དེའེ་ཤཱ་པར་ནེ་ཨ་ནས་དམག་བརྒྱབ་སྟེ་གཱ་ཟཱ་བར་དུ་སླེབས་ཤིང་། ཡང་གོ་ཤེན་ཡུལ་ཐམས་ཅད་ལ་དམག་བརྒྱབ་སྟེ་གིབ་ཡོན་བར་དུ་སླེབས།"]},{"type":"verse","number":42,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་ཕྱིར་འཐབ་མོ་མཛད་པས། ཡོ་ཤུ་ཨ་ཡིས་དམག་འཐབ་གཅིག་གིས་རྒྱལ་པོ་དེ་རྣམས་ཕམ་པར་བརྒྱབ་པར་མ་ཟད་ཁོ་རྣམས་ཀྱི་ཡུལ་ཡང་ཕྲོགས་པ་རེད།"]},{"type":"verse","number":43,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་གིལ་གལ་གྱི་སྒར་དུ་ཕྱིར་ལོག་གོ །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":43}