{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":11,"content":[{"type":"heading","content":["བྱང་ཕྱོགས་ཀྱི་རྒྱལ་པོ་རྣམས་ཕམ་པར་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["ཧ་ཟོར་གྱི་རྒྱལ་པོ་ཡཱ་བིན་གྱིས་དོན་དེ་ཐོས་ནས། མ་དོན་གྱི་རྒྱལ་པོ་ཡོ་པབ་དང་ཤིམ་རོན་གྱི་རྒྱལ་པོ། ཨག་ཤབ་ཀྱི་རྒྱལ་པོ།"]},{"type":"verse","number":2,"content":["བྱང་ཕྱོགས་ཀྱི་རི་ཁུལ་དང་ཀིན་ནེ་རོད་ཀྱི་ལྷོ་ཕྱོགས་ཀྱི་ཨ་ར་པཱ་རི་ཀླུང་། དེར་མ་ཟད་ནུབ་ཕྱོགས་ཀྱི་དཱོར་དེའུ་འབུར་བཅས་ཀྱི་རྒྱལ་པོ་རྣམས་ཀྱི་མདུན་དུ་མི་མངགས་པ་དང་།"]},{"type":"verse","number":3,"content":["ཡང་ཤར་ནུབ་གཉིས་ཀྱི་ཀ་ན་ཨན་པ་དང་། རི་ཁུལ་གྱི་ཨེ་མོར་པ། ཧེད་པ། ཕེ་རེ་ཟི་པ། ཡེ་བུ་སི་པ། དེར་མ་ཟད་ཧེར་མོན་རི་འདབས་ཀྱི་མཱས་ཟི་ཕཱ་ཡུལ་གྱི་ཧེ་བི་པ་བཅས་ཀྱི་མདུན་དུ་མི་མངགས།"]},{"type":"verse","number":4,"content":["རྒྱལ་པོ་དེ་རྣམས་དང་ཁོ་ཚོའི་དམག་དཔུང་ཐམས་ཅད་ཕྱི་རུ་ཡོང་ཞིང་མི་གྲངས་ནི་མཚོ་ཁའི་བྱེ་མ་ལྟར་མང་བར་མ་ཟད། རྟ་དང་ཤིང་རྟ་ཡང་མང་པོ་ཡོད།"]},{"type":"verse","number":5,"content":["རྒྱལ་པོ་དེ་རྣམས་གཅིག་ཏུ་འདུས་ནས་མེ་རོམ་ཆུ་འགྲམ་དུ་སླེབས་ཤིང་། ཡེས་ར་ཨེལ་དང་འཐབ་ཕྱིར་མཉམ་དུ་དམག་སྒར་བཏབ།"]},{"type":"verse","number":6,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། ཁྱོད་རང་ཁོ་རྣམས་ལ་མ་འཇིགས་ཤིག སང་ཉིན་ད་ཚོད་བདག་གིས་ཁོ་ཚོ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྤྲད་དེ་ཐམས་ཅད་གསོད་ངེས་ཡིན། ཁྱོད་ཀྱིས་ཁོ་ཚོའི་རྟ་རྣམས་ཀྱི་བརླ་རྩ་བཅད་ནས་ཁོ་ཚོའི་ཤིང་རྟ་རྣམས་མེར་བསྲེག་དགོས་ཞེས་གསུངས།"]},{"type":"verse","number":7,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་ཡིས་དམག་མི་ཐམས་ཅད་ཁྲིད་དེ་མེ་རོམ་ཆུ་འགྲམ་ནས་གློ་བུར་ཉིད་དུ་ཁོ་རྣམས་ལ་དམག་བརྒྱབ།"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་ཡེས་ར་ཨེལ་པའི་ལག་ཏུ་སྤྲད་པ་དང་། ཡེས་ར་ཨེལ་པས་ཁོ་རྣམས་ལ་དམག་བརྒྱབ་ཅིང་བདས་ནས་གྲོང་ཁྱེར་ཆེན་པོ་ཚི་ཏུན་བར་དང་མིས་རེ་ཕཱོད་མ་ཨིམ་གྱི་བར། ཤར་ཕྱོགས་ཀྱི་མི་ཙི་ཕེའི་ལུང་པ་བར་བཅས་སུ་སླེབས་ཤིང་། ཁོ་རྣམས་གཅིག་ཀྱང་མ་བསྐྱུར་ཏོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་ཅི་ལྟར་བཀའ་བསྒོས་པ་བཞིན་བྱས་ཏེ། ཁོ་ཚོའི་རྟ་ཡི་བརླ་རྩ་བཅད་ནས་ཤིང་རྟ་མེར་བསྲེགས་སོ། །"]},{"type":"verse","number":10,"content":["སྐབས་དེར་ཡོ་ཤུ་ཨ་ཕྱིར་ལོག་ནས་ཧ་ཟོར་ཕྲོགས་པ་དང་དེའི་རྒྱལ་པོ་གྲིས་བསད། ཧ་ཟོར་ནི་སྔར་ནས་བཟུང་རྒྱལ་ཁམས་རྣམས་ཀྱི་ཁྲོད་དུ་མགོ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["ཡེས་ར་ཨེལ་པས་གྲོང་ཁྱེར་ནང་གི་མི་རྣམས་གྲིས་བསད་ཅིང་ཁོ་རྣམས་རྩ་མེད་དུ་བཏང་། དབུགས་དང་ལྡན་པ་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་ཏོ། །ཡོ་ཤུ་ཨ་ཡིས་ཡང་ཧ་ཟོར་མེར་བསྲེགས་སོ། །"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་མོ་ཤེས་བཀའ་ཅི་ལྟར་བསྒོས་པ་དེ་བཞིན་དུ། ཡོ་ཤུ་ཨ་ཡིས་རྒྱལ་པོ་དེ་རྣམས་ཀྱི་གྲོང་ཁྱེར་ཐམས་ཅད་ཕྲོགས་ཤིང་། དེའི་ནང་གི་རྒྱལ་པོ་རྣམས་གསོན་བཟུང་བྱས་ཏེ་ཁོ་རྣམས་གྲིས་བརྒྱབ་ནས་བསད་པ་དང་ཐམས་ཅད་རྩ་མེད་དུ་བཏང་ངོ་། །"]},{"type":"verse","number":13,"content":["དེའུ་འབུར་སྟེང་དུ་བརྩིགས་པའི་གྲོང་ཁྱེར་རྣམས་ནི། ཧ་ཟོར་ལས་གཞན་ཡེས་ར་ཨེལ་པས་མེར་མ་སྲེག་གོ །ཡོ་ཤུ་ཨ་ཡིས་ཧ་ཟོར་ཁོ་ན་མེར་བསྲེགས་པའོ། །"]},{"type":"verse","number":14,"content":["གྲོང་ཁྱེར་དེ་དག་གི་རྒྱུ་ནོར་དང་ཕྱུགས་ཟོག་ཐམས་ཅད་ནི་ཡེས་ར་ཨེལ་པས་རང་རང་གི་བཅོམ་ནོར་དུ་བླངས། ཡིན་ནའང་མི་ཐམས་ཅད་ནི་རྩ་མེད་དུ་གཏོང་བའི་བར་དུ་གྲིས་བརྒྱབ་ནས་བསད་པ་དང་། དབུགས་དང་ལྡན་པ་ཐམས་ཅད་གཅིག་ཀྱང་མ་བསྐྱུར་ཏོ། །"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཞབས་ཕྱི་མོ་ཤེ་ལ་ཅི་ལྟར་བཀའ་བསྒོས་པ་ལྟར་མོ་ཤེས་དེ་བཞིན་དུ་ཡོ་ཤུ་ཨ་ལ་བཀའ་བསྒོས་ཤིང་། ཡོ་ཤུ་ཨ་ཡིས་ཀྱང་དེ་བཞིན་དུ་བྱས་སོ། །དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་ཅི་ལྟར་བཀའ་བསྒོས་པ་ཐམས་ཅད་ནི་ཡོ་ཤུ་ཨ་ཡིས་ལྷོད་གཡེང་དུ་བཏང་ནས་མ་བསྒྲུབས་པ་གཅིག་ཀྱང་མེད་དོ། །"]},{"type":"heading","content":["ས་བཟུང་བ།"]},{"type":"verse","number":16,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡུལ་དེ་ཐམས་ཅད་དེ་རི་ཁུལ་དང་ནེ་གུབ་ཡུལ་རྣམས། གོ་ཤེན་ཡུལ་ཐམས་ཅད། རི་ཀླུང་། ཨ་ར་པཱ། ཡེས་ར་ཨེལ་གྱི་རི་ཁུལ་དང་དེའི་རི་ཀླུང་།"]},{"type":"verse","number":17,"content":["སེ་ཨིར་ལ་ཡར་འགྲོ་སའི་ཧ་ལཱ་རི་བོ་ནས་ཧེར་མོན་རི་འདབས་ཀྱི་ལེ་པཱ་ནོན་ལུང་པའི་པཱ་ཨལ་གཱ་རྡུ་བར་བཅས་ཕྲོགས་པར་མ་ཟད། ཡུལ་དེ་དག་གི་རྒྱལ་པོ་རྣམས་གསོན་བཟུང་བྱས་ཏེ་བརྒྱབ་ནས་བསད།"]},{"type":"verse","number":18,"content":["ཡོ་ཤུ་ཨ་དང་རྒྱལ་པོ་དེ་རྣམས་ལོ་ཟླ་མང་པོ་ཞིག་ལ་འཐབ་བོ། །"]},{"type":"verse","number":19,"content":["གིབ་ཡོན་གྱི་ཧེ་བི་པ་ལས་གཞན་ཡེས་ར་ཨེལ་པ་དང་འདུམ་འགྲིག་བྱུང་བའི་གྲོང་ཁྱེར་གཅིག་ཀྱང་མེད་པ་སྟེ། ཐམས་ཅད་ཡེས་ར་ཨེལ་པས་འཐབ་མོ་བྱས་ནས་ཕྲོགས་འོངས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་ཅི་ལྟར་བཀའ་བསྒོས་པ་བཞིན་དུ། ཁོ་རྣམས་རྩ་མེད་དུ་གཏོང་བ་དང་སྙིང་རྗེ་མི་འཐོབ་པའི་ཕྱིར། ཁོ་རྣམས་ཀྱི་སེམས་རྒྱུད་གྱོང་པོར་མཛད་ནས་ཡེས་ར་ཨེལ་པ་དང་འཐབ་པར་འོངས་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་དགོངས་ལགས་སོ། །"]},{"type":"verse","number":21,"content":["སྐབས་དེར་ཡོ་ཤུ་ཨ་འོངས་ནས་རི་ཁུལ་དང་ཧེབ་རོན། དི་བིར། ཨ་ནབ། ཡ་ཧུ་དཱ་རི་ཁུལ། ཡེས་ར་ཨེལ་རི་ཁུལ་བཅས་སུ་གནས་པའི་ཨ་ནག་གི་བུ་རྒྱུད་",{"noteId":3},"ཐམས་ཅད་མེད་པར་བྱས་ཤིང་། ཡོ་ཤུ་ཨ་ཡིས་ཁོ་རྣམས་དང་ཁོ་ཚོའི་གྲོང་ཁྱེར་རྣམས་མེད་པར་བྱས་སོ། །"]},{"type":"verse","number":22,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཡུལ་དུ་ཨ་ནག་པ་གཅིག་ཀྱང་མ་བསྐྱུར་བ་དང་། གཱ་ཟཱ་དང་གཱད། ཨ་སི་དོད་བཅས་འབའ་ཞིག་ཏུ་བསྐྱུར་ནས་ལུས་པ་ཡིན།"]},{"type":"verse","number":23,"content":["དེ་ལྟར་ཡོ་ཤུ་ཨ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་བསྒོས་པའི་བཀའ་ཐམས་ཅད་ལྟར་ཡུལ་དེ་ཡོངས་སུ་ཕྲོགས་ཤིང་། ཡེས་ར་ཨེལ་ཚོ་པའི་རུས་རྒྱུད་ལྟར་ཁོ་རྣམས་ལ་ས་སྐལ་དུ་བགོས་པ་དང་། ས་གཞི་ཡོངས་སུ་འཐབ་འཁྲུག་ཞི་བར་གྱུར་ཏོ། །"]}],"footnotes":[{"noteId":3,"caller":"+","text":"ཨ་ནག་གི་བུ་རྒྱུད་ཅེས་པ་ནི་གཟུགས་པོའི་རིང་ཚད་ལ་སྨི་གསུམ་ཙམ་ཡོད་པའི་མི་བོ་ཆེ་རྣམས་ཡིན་པར་གསུངས།","reference":{"chapter":11,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/JOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":23}