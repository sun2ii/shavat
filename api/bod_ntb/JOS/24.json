{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":24,"content":[{"type":"heading","content":["སི་ཀེམ་དུ་དམ་པའི་ཞལ་ཆད་བསྐྱར་བསྒྲགས་མཛད་པ།"]},{"type":"verse","number":1,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཐམས་ཅད་སི་ཀེམ་དུ་བསྡུས་ཤིང་། ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་དང་ཚོ་དཔོན། ཁྲིམས་དཔོན། དེ་མིན་འགོ་དཔོན་བཅས་བོས་འོངས་པ་དང་། ཁོ་རྣམས་དཀོན་མཆོག་གི་དྲུང་དུ་ལངས་ནས་བསྡད།"]},{"type":"verse","number":2,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་ལ། ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། གནའ་དུས་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཏེ། ཨབ་ར་ཧམ་དང་ནཱ་ཧོར་གྱི་ཕ་ཐ་རཱ་ནི་གཙང་པོའི་",{"noteId":7},"ཕ་རོལ་ཏུ་གནས་ཤིང་ལྷ་གཞན་རྣམས་ལ་བསྙེན་བཀུར་བྱས་པ་དང་།"]},{"type":"verse","number":3,"content":["བདག་གིས་ཁྱོད་རྣམས་ཀྱི་མེས་པོ་ཨབ་ར་ཧམ་གཙང་པོའི་ཕ་རོལ་ནས་ཁྲིད་འོངས་ཏེ། ཀ་ན་ཨན་ཡུལ་ཀུན་ལ་འགྲིམ་དུ་བཅུག་ཅིང་། ཡང་ཁོའི་བུ་རྒྱུད་མང་དུ་སྤེལ་ཏེ་ཨི་སཱག་ཁོ་ལ་གནང་བ་ཡིན།"]},{"type":"verse","number":4,"content":["ཡང་ཨི་སཱག་ལ་ཡ་ཀོབ་དང་ཨེ་སཱབ་གནང་ནས། སེ་ཨིར་རི་བོ་ཨེ་སཱབ་ལ་ས་སྐལ་དུ་གནང་བ་ཡིན། ཕྱིས་སུ་ཡ་ཀོབ་དང་ཁོའི་བུ་རྒྱུད་རྣམས་ནི་མར་ཨེ་ཅིབ་ཡུལ་དུ་ཕྱིན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":5,"content":["བདག་གིས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་མངགས་པར་མ་ཟད། ངས་ཨེ་ཅིབ་ཡུལ་ནས་ཅི་བྱས་པ་བཞིན་དུ་ཨེ་ཅིབ་སྡུག་ལ་སྦྱར་བ་དང་། ཁྱོད་རྣམས་ཕྱིར་ཁྲིད་འོངས་པ་ཡིན།"]},{"type":"verse","number":6,"content":["བདག་གིས་ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཨེ་ཅིབ་ནས་ཕྱིར་ཁྲིད་འོངས་པ་དང་ཁོ་རྣམས་རྒྱ་མཚོ་རུ་སླེབས། ཨེ་ཅིབ་པ་རྣམས་ཀྱིས་ཤིང་རྟ་དང་སྐྱ་དམག་ཁྲིད་ནས་ཁྱོད་ཚོའི་མེས་པོ་རྣམས་ཀྱི་ར་མདར་བརྒྱུགས་ཤིང་རྒྱ་མཚོ་དམར་པོ་རུ་སླེབས།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྐྱབས་སུ་ཞུས་པས། ཁོང་གིས་ཁྱོད་རྣམས་དང་ཨེ་ཅིབ་པའི་བར་དུ་མུན་པ་གནང་བ་དང་། ཡང་རྒྱ་མཚོ་ཕྱིར་དྲངས་ནས་ཨེ་ཅིབ་པ་རྣམས་བསྣུབས་པར་མཛད་དོ། །བདག་གིས་ཨེ་ཅིབ་ནས་དོན་ཅི་ཞིག་བྱས་པ་རྣམས་ཁྱོད་ཅག་གིས་དངོས་སུ་མཐོང་ཞིང་། ཁྱོད་རྣམས་དབེན་སྟོང་ནས་ཀྱང་ལོ་ཟླ་མང་པོར་བསྡད་དོ། །"]},{"type":"verse","number":8,"content":["ངས་ཁྱོད་རྣམས་ཁྲིད་དེ་ཡོར་དན་གཙང་པོའི་ཤར་ཏུ་ཨེ་མོར་པ་རྣམས་གནས་པའི་ཡུལ་ལ་སླེབས་ཤིང་། ཁོ་ཚོ་ནི་ཁྱོད་རྣམས་དང་འཐབ་པ་ན། ངས་ཁོ་ཚོ་ཁྱོད་རྣམས་ཀྱི་ལག་ཏུ་སྤྲད་པས་ཁོ་ཚོའི་ཡུལ་ནི་ཁྱོད་རྣམས་ལ་ས་སྐལ་དུ་ཐོབ་པ་དང་། ངས་ཁྱོད་རྣམས་ཀྱི་སྔུན་ནས་ཁོ་ཚོ་རྩ་མེད་དུ་བཏང་།"]},{"type":"verse","number":9,"content":["སྐབས་དེར། མོ་ཨབ་ཀྱི་རྒྱལ་པོ་ཚིབ་ཕོར་གྱི་བུ་པཱ་ལག་ལངས་ཏེ་ཡེས་ར་ཨེལ་པ་ལ་རྒོལ་བ་དང་། ཁྱོད་རྣམས་ལ་དམོད་མོ་བྱ་ཆེད་མི་མངགས་ནས་པེ་ཨོར་གྱི་བུ་པེལ་ཨམ་བོས་འོངས་ཤིང་།"]},{"type":"verse","number":10,"content":["ངས་པེལ་ཨམ་གྱི་གཏམ་ལ་མ་མཉན་པས་ཁོས་དེ་ལས་ལྡོག་སྟེ་ཁྱོད་རྣམས་ལ་ཡང་ཡང་བྱིན་གྱིས་བརླབས་པ་དང་། ངས་ཁྱོད་རྣམས་ཁོའི་ལག་ནས་ཐར་བར་བྱས་སོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཡོར་དན་གཙང་པོ་བརྒལ་ནས་ཡེ་རུ་ཀོ་ལ་སླེབས་པ་དང་། ཡེ་རུ་ཀོའི་ཡུལ་མི་དང་ཨེ་མོར་པ། ཕེ་རེ་ཟི་པ། ཀ་ན་ཨན་པ། ཧེད་པ། གིར་གས་པ། ཧེ་བི་པ། ཡེ་བུ་སི་པ་བཅས་ཐམས་ཅད་ཀྱིས་ཁྱོད་ཅག་ལ་དམག་བརྒྱབ་ཅིང་། ངས་ཁོ་ཚོ་ཁྱོད་རྣམས་ཀྱི་ལག་ཏུ་སྤྲད་པ་ཡིན།"]},{"type":"verse","number":12,"content":["ངས་དུག་སྦྲང་མང་པོ་ཁྱོད་རྣམས་ཀྱི་སྔུན་ལ་བཏང་ནས། ཨེ་མོར་པའི་རྒྱལ་པོ་གཉིས་ཁྱོད་ཀྱི་གྲི་དང་གཞུ་གཉིས་མ་བཀོལ་བར་ཁྱོད་རྣམས་ཀྱི་སྔུན་ནས་བསྐྲད་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ངས་ཁྱོད་རྣམས་ལ་ཁྱོད་ཚོས་དཀའ་བ་སྤྱད་ནས་བསློགས་པ་མིན་པའི་ས་ཞིང་དང་ཁྱོད་ཚོས་བསྐྲུན་པ་མིན་པའི་གྲོང་ཁྱེར་སྤྲད་པ་དང་། ཁྱོད་རྣམས་དེའི་ནང་དུ་སྡོད་ཅིང་ཁྱོད་ཚོས་བཙུགས་པ་མིན་པའི་རྒུན་འབྲུམ་ར་བ་དང་སྐྱུ་རུ་ར་བའི་འབྲས་བུ་ལོངས་སུ་སྤྱོད་ཐུབ་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":14,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གུས་ཤིང་འཇིགས་པར་བྱེད་པ་དང་། སྒོ་ཀུན་ནས་དྲང་བདེན་ངང་ཁོང་ལ་བསྙེན་བཀུར་བྱེད་ཅིང་། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་གཙང་པོའི་ཕ་རོལ་དང་ཨེ་ཅིབ་ཡུལ་ནས་བསྙེན་བཀུར་བྱས་པའི་ལྷ་རྣམས་དོར་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱེད་དགོས།"]},{"type":"verse","number":15,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱེད་པ་ནི་མི་ལེགས་པར་འདོད་ན། ཁྱོད་ཅག་གི་མེས་པོ་རྣམས་ཀྱིས་གཙང་པོའི་ཕ་རོལ་ཏུ་བསྙེན་བཀུར་བྱས་པའི་ལྷའམ་ཁྱོད་རྣམས་སྡོད་སའི་ཡུལ་འདི་ཡི་ཨེ་མོར་པའི་ལྷ་རྣམས་ལས་དེ་རིང་བསྙེན་བཀུར་བྱེད་ཡུལ་འདེམས་ཆོག་པ་ཡིན། ང་དང་ངའི་ཁྱིམ་ལ་མཚོན་ན་ངེད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱེད་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":16,"content":["འབངས་རྣམས་ཀྱིས་དེའི་ལན་དུ། ང་ཚོས་དཀོན་མཆོག་ཡ་ཝཱེ་བསྐྱུར་ནས་ལྷ་གཞན་ལ་བསྙེན་བཀུར་བྱེད་པ་ནི་གཏན་ནས་མི་སྲིད།"]},{"type":"verse","number":17,"content":["ཅི་ལ་ཟེར་ན། བདག་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་ང་ཚོ་དང་ང་ཚོའི་མེས་པོ་རྣམས་བྲན་དུ་བཀོལ་བའི་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱིར་ཁྲིད་འོངས་ཤིང་། ང་ཚོའི་མིག་སྔར་གྲུབ་རྟགས་ཆེན་པོ་དེ་རྣམས་མཛད་པ་དང་། བདག་ཅག་འགྲིམ་པའི་ལམ་རྣམས་དང་བརྒྱུད་པའི་རྒྱལ་ཁམས་ཐམས་ཅད་ནས་ང་ཚོ་སྲུང་བར་མཛད་དོ། །"]},{"type":"verse","number":18,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཡུལ་འདིར་གནས་པའི་ཨེ་མོར་པ་ཐམས་ཅད་ང་ཚོའི་སྔུན་ནས་ཕྱིར་བསྐྲད། དེའི་ཕྱིར། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ང་ཚོའི་དཀོན་མཆོག་ལགས་པས་ང་ཚོས་ཁོང་ལ་བསྙེན་བཀུར་བྱེད་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":19,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་ལ། ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱེད་མི་ནུས་ཏེ། ཅི་ལ་ཟེར་ན། ཁོང་ནི་དཀོན་མཆོག་དམ་པ་དང་ཕྲག་དོག་ཅན་ལགས་པས། ཁྱོད་རྣམས་ཀྱི་ཉེས་སྐྱོན་དང་སྡིག་པ་རྣམས་སེལ་བར་མི་འགྱུར།"]},{"type":"verse","number":20,"content":["གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་བསྐྱུར་ནས་ཕྱི་རོལ་པའི་ལྷ་རྣམས་ལ་བསྙེན་བཀུར་བྱས་ན། དཀོན་མཆོག་ཡ་ཝཱེས་བྱིན་རླབས་གནང་རྗེས་ཕྱིར་ཁྱོད་རྣམས་ལ་བགེགས་བར་ཆད་མཛད་དེ་ཁྱོད་ཚོ་རྩ་མེད་དུ་གཏོང་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":21,"content":["འབངས་རྣམས་ཀྱིས་ཡོ་ཤུ་ཨ་ལ་དེའི་ལན་དུ། དེ་ལྟར་མི་བྱ་སྟེ་ངེད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་འབུལ་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":22,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་ལ། ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་བདམས་ནས་ཁོང་ལ་བསྙེན་བཀུར་བྱེད་རྒྱུ་ཡིན་པས། ཁྱོད་ཚོ་རང་གིས་བདེན་དཔང་བྱོས་ཤིག་ཅེས་སྨྲས་པ་ལ། ཁོ་རྣམས་ན་རེ། ང་ཚོ་བདེན་དཔང་བྱེད་པར་འཐད་པ་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":23,"content":["ཡོ་ཤུ་ཨ་ན་རེ། ཁྱོད་ཚོས་ད་ལྟ་ཁྱོད་རྣམས་ཁྲོད་ཀྱི་ཕྱི་རོལ་པའི་ལྷ་རྣམས་སྤངས་ནས། བློ་སེམས་རྩེ་གཅིག་གིས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར་དགོས་ཞེས་སྨྲས།"]},{"type":"verse","number":24,"content":["འབངས་རྣམས་ཀྱིས་ཡོ་ཤུ་ཨ་ལ་དེའི་ལན་དུ། ངེད་རྣམས་ཀྱིས་ང་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་ཕུལ་ནས་ཁོང་གི་བཀའ་ལ་མཉན་ངེས་ཡིན་ཞེས་སྨྲས།"]},{"type":"verse","number":25,"content":["ཉིན་མོ་དེར་ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་དང་ཞལ་ཆད་བཞག་ནས། སི་ཀེམ་དུ་ཁོ་རྣམས་ཀྱི་ཕྱིར་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་བཙུགས།"]},{"type":"verse","number":26,"content":["ཡོ་ཤུ་ཨ་ཡིས་བཀའ་དེ་ཐམས་ཅད་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ཀྱི་མདོ་རུ་བཀོད་ཅིང་། ཡང་རྡོ་ཆེན་པོ་ཞིག་དཀོན་མཆོག་ཡ་ཝཱེའི་གནས་དམ་པའི་འགྲམ་དུ་བེ་ཤིང་གི་འོག་ཏུ་བསླངས།"]},{"type":"verse","number":27,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་ལ། ལྟོས་དང་། རྡོ་འདིས་དཀོན་མཆོག་ཡ་ཝཱེས་ངེད་རྣམས་ལ་བསྒོས་པའི་བཀའ་ཅི་གསུངས་ཐམས་ཅད་ཐོས་པས་ངེད་ཅག་ལ་བདེན་དཔང་བྱེད་ཐུབ་པ་སྟེ། ཁྱོད་རྣམས་ཀྱིས་ཡ་ཝཱེ་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ལ་རྒྱབ་འགལ་མི་བྱེད་པའི་ཆེད་དུ་རྡོ་འདིས་ཁྱོད་རྣམས་ལ་དྲན་སྐུལ་བྱེད་པར་འགྱུར་རོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་ཡིས་འབངས་མི་རྣམས་རང་རང་གི་ས་སྐལ་དུ་མངགས་སོ། །"]},{"type":"heading","content":["ཡོ་ཤུ་ཨ་དང་ཨེ་ལི་ཨ་ཟར་གཉིས་ཀ་ཚེ་ལས་འདས་པ།"]},{"type":"verse","number":29,"content":["དོན་དེ་རྣམས་ཀྱི་རྗེས་སུ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་དགུང་ལོ་བརྒྱ་དང་བཅུ་ལོན་ནས་ཚེ་ལས་འདས་པ་དང་།"]},{"type":"verse","number":30,"content":["ཡེས་ར་ཨེལ་པས་ཁོང་ནི་ཁོང་གི་ས་སྐལ་གྱི་མངའ་ཁོངས་སུ། གཱ་ཨ་སི་རི་བོའི་བྱང་ཕྱོགས་སུ་ཨེ་ཕཱར་ཡིམ་རི་ཁུལ་གྱི་ཐིམ་ནད་སེ་ར་རུ་དུར་ལ་སྦས།"]},{"type":"verse","number":31,"content":["ཡོ་ཤུ་ཨ་གསོན་པའི་དུས་ཐམས་ཅད་དང་ཁོང་ཚེ་ལས་འདས་པའི་རྗེས་སུ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པའི་ཕྱིར་དོན་ཅི་རྣམས་མཛད་པ་ཤེས་པའི་རྒན་པོ་རྣམས་ད་དུང་གནས་པའི་དུས་སྐབས་ཡོངས་སུ། ཡེས་ར་ཨེལ་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྙེན་བཀུར་བྱས་སོ། །"]},{"type":"verse","number":32,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཨེ་ཅིབ་ཡུལ་ནས་ཁྱེར་འོངས་པའི་ཡོ་སེབ་ཀྱི་ཀེང་རུས་ནི། སི་ཀེམ་སྟེ་སྔར་ཡ་ཀོབ་ཀྱིས་སི་ཀེམ་གྱི་ཕ་ཧ་མོར་གྱི་བུ་རྒྱུད་རྣམས་ལས་དངུལ་སྲང་བརྒྱ་ཡིས་ཉོས་པའི་ས་དེར་དུར་ལ་སྦས་པ་དང་། དེ་ཡོ་སེབ་ཀྱི་བུ་རྒྱུད་རྣམས་ཀྱི་ས་སྐལ་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":33,"content":["ཨ་རོན་གྱི་བུ་ཨེ་ལི་ཨ་ཟར་ཡང་ཚེ་ལས་འདས་ནས། ཁོའི་བུ་ཕི་ནེ་ཧེ་ལ་ཨེ་ཕཱར་ཡིམ་རི་ཁུལ་དུ་ཐོབ་པའི་རི་མགོར་དུར་དུ་སྦས་སོ།། །།"]}],"footnotes":[{"noteId":7,"caller":"+","text":"འདིར་གཙང་པོ་ཞེས་པ་ནི་ཕི་རཱད་གཙང་པོར་གོ་བ་ཡིན།","reference":{"chapter":24,"verse":2}}]},"thisChapterLink":"/api/bod_ntb/JOS/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JDG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/23.json","previousChapterAudioLinks":{},"numberOfVerses":33}