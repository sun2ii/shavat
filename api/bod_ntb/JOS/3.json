{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":3,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཡོར་དན་གཙང་པོ་བརྒལ་བ།"]},{"type":"verse","number":1,"content":["ཡོ་ཤུ་ཨ་ནི་ཞོགས་པ་སྔ་མོར་ཡར་ལངས་ཏེ་ཡེས་ར་ཨེལ་པ་རྣམས་དང་མཉམ་དུ་སིད་ཏིམ་དང་བྲལ་ནས་ཡོར་དན་གཙང་པོ་རུ་སླེབས་པ་དང་། གཙང་པོ་བརྒལ་བའི་བར་དུ་དེར་བསྡད་དོ། །"]},{"type":"verse","number":2,"content":["ཉིན་གསུམ་འགོར་རྗེས་འགོ་དཔོན་རྣམས་སྒར་ས་ཀུན་ཏུ་འགྲིམས་ནས།"]},{"type":"verse","number":3,"content":["འབངས་མི་རྣམས་ལ་འདི་ལྟར། ཁྱོད་རྣམས་ཀྱིས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་། ཡང་མཆོད་དཔོན་ཡིན་པའི་ལེ་ཝི་པ་རྣམས་ཀྱིས་དེ་ཁུར་ནས་འགྲོ་བ་མཐོང་དུས་སྡོད་སའི་གནས་དང་བྲལ་ནས་དེའི་རྗེས་སུ་འབྲང་དགོས།"]},{"type":"verse","number":4,"content":["འོན་ཀྱང་ཁྱོད་ཅག་དང་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གཉིས་ཀྱི་བར་དུ་ཁྲུ་ཉིས་སྟོང་གི་བར་ཐག་ཡོད་དགོས་ལ། ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་དང་ཉེ་བར་མ་གཅར་ཅིག ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་སྔར་ལམ་དེར་སྐྱོད་མ་མྱོང་བས་ཁྱོད་ཅག་བགྲོད་པའི་ལམ་དེ་ཤེས་པའི་ཕྱིར་རོ་ཞེས་བཀའ་བསྒོས།"]},{"type":"verse","number":5,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་རྣམས་ལ། སང་ཉིན་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་དོན་ངོ་མཚར་ཅན་རྣམས་མཛད་རྒྱུ་ཡིན་པས། ཁྱོད་ཅག་གིས་རང་ཉིད་གཙང་མར་བཟོ་དགོས་ཞེས་བཀའ་བསྒོས།"]},{"type":"verse","number":6,"content":["ཡང་ཡོ་ཤུ་ཨ་ཡིས་མཆོད་དཔོན་རྣམས་ལ། ཁྱོད་ཅག་གིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཁུར་ནས་འབངས་རྣམས་ཀྱི་སྔོན་དུ་སོང་ཞིག་ཅེས་བཀའ་བསྒོས་པ་ལ། ཁོ་རྣམས་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཁུར་ནས་འབངས་རྣམས་ཀྱི་སྔོན་ནས་བསྐྱོད་དོ། །"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། དུས་དེ་རིང་ནས་བཟུང་ངས་ཁྱོད་རང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མིག་སྔར་མཆོག་ཏུ་གྱུར་བར་བྱ་སྟེ། ང་རང་ནི་ཇི་ལྟར་མོ་ཤེ་དང་མཉམ་དུ་ཡོད་པ་དེ་བཞིན་དུ་ཁྱོད་དང་མཉམ་དུའང་ཡོད་པ་ཁོ་རྣམས་ལ་ཤེས་སུ་འཇུག་གོ །"]},{"type":"verse","number":8,"content":["ཁྱོད་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་བའི་མཆོད་དཔོན་རྣམས་ལ། ཁྱོད་ཅག་ཡོར་དན་གཙང་པོའི་འགྲམ་དུ་སླེབས་ཚེ། ཡོར་དན་གཙང་པོའི་ཆུ་ནང་དུ་ལངས་ནས་འདུག་དགོས་ཞེས་བསྒོས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ། ཁྱོད་རྣམས་ཚུར་ཤོག་ལ་ཁྱོད་ཚོའི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་ཉོན་ཅིག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":10,"content":["ཡོ་ཤུ་ཨ་ཡིས། ལྟོས་དང་། ས་གཞི་ཡོངས་ཀྱི་བདག་པོའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཁྱོད་རྣམས་ཀྱི་སྔོན་དུ་འགྲོ་ཞིང་ཡོར་དན་གཙང་པོར་བསླེབ་པ་དང་། དེ་ནས་ཁྱོད་ཅག་གིས་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་ནི་ཁྱོད་ཚོའི་ཁྲོད་དུ་བཞུགས་པར་མ་ཟད། ཁོང་གིས་ཁྱོད་རྣམས་ཀྱི་མདུན་ནས་ཀ་ན་ཨན་པ་དང་། ཧེད་པ། ཧེ་བི་པ། ཕེ་རེ་ཟི་པ། གིར་གས་པ། ཨེ་མོར་པ། ཡེ་བུ་སི་པ་རྣམས་མཐར་སྐྲོད་གཏོང་ངེས་པ་ཤེས་སོ། །"]},{"type":"verse","number":12,"content":["ད་ལྟ་ཁྱོད་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་ཚོ་པའི་ཁྲོད་ནས་མི་བཅུ་གཉིས་འདེམས་དགོས་པ་སྟེ། ཚོ་པ་རེ་ནས་མི་རེ་འདེམས་དགོས།"]},{"type":"verse","number":13,"content":["ས་གཞི་ཡོངས་ཀྱི་བདག་པོ་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་མཁན་མཆོད་དཔོན་རྣམས་ཀྱི་རྐང་པ་ཡོར་དན་གཙང་པོའི་ཆུ་ནང་དུ་སྤོས་པ་ན། ཡོར་དན་གཙང་པོའི་ཆུ་སྟེ་ཡར་ནས་མར་འབབ་པའི་ཆུ་ནི་རྒྱུན་ཆད་ཅིང་ཆུ་རགས་སུ་འགྱིང་བར་འགྱུར་ཞེས་སྨྲས།"]},{"type":"verse","number":14,"content":["འབངས་མི་རྣམས་གུར་དང་བྲལ་ནས་ཡོར་དན་གཙང་པོ་བརྒལ་དུ་འགྲོ་དུས། ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་བའི་མཆོད་དཔོན་རྣམས་ནི་འབངས་མི་རྣམས་ཀྱི་སྔོན་དུ་བསྐྱོད་དོ། །"]},{"type":"verse","number":15,"content":["སྟོན་ཐོག་བསྡུ་བའི་སྐབས་སུ་ཡོར་དན་གཙང་པོའི་ཆུ་ནི་འགྲམ་གཉིས་སུ་རྒྱས་པ་ཡིན་མོད། འོན་ཀྱང་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་མཁན་མཆོད་དཔོན་རྣམས་ཡོར་དན་གཙང་པོར་སླེབས་པ་དང་དེ་ཚོའི་རྐང་པ་ཆུའི་ནང་དུ་སྤོས་མ་ཐག"]},{"type":"verse","number":16,"content":["ཡར་ནས་མར་འབབ་པའི་ཆུ་ནི་རྒྱང་ཐག་ཧ་ཅང་རིང་སའི་ཟར་ཐན་གྱི་ཉེ་འགྲམ་དུ་ཡོད་པའི་ཨ་དམ་གྲོང་ཁྱེར་དུ་རྒྱུན་ཆད་ཅིང་ཆུ་རགས་སུ་འགྱིངས་པ་དང་། ཨ་ར་པཱ་རུ་བཞུར་བའི་མཚོ་སྟེ་ཚྭ་མཚོ་ཡི་མར་འབབ་པའི་ཆུ་ནི་རྒྱུན་ཆད་པར་གྱུར་པས། འབངས་མི་རྣམས་ཡེ་རུ་ཀོའི་ཁ་གཏད་ནས་ཆུའི་ཕ་རོལ་ཏུ་བརྒལ།"]},{"type":"verse","number":17,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་མཁན་མཆོད་དཔོན་རྣམས་ཡོར་དན་གཙང་པོའི་སྐམ་ས་རུ་བརྟན་པོར་ལངས་པ་དང་། མི་ཐམས་ཅད་ཡོར་དན་གཙང་པོ་བརྒལ་བའི་བར་དུ་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་སྐམ་ས་ནས་ཕ་རོལ་ཏུ་ཕྱིན་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}