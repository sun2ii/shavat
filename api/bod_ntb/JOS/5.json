{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":5,"content":[{"type":"heading","content":["གིལ་གལ་ཡུལ་ནས་མཚན་སྐྱི་བཅད་པ།"]},{"type":"verse","number":1,"content":["ཡོར་དན་གཙང་པོའི་ནུབ་ཕྱོགས་ཀྱི་ཨེ་མོར་པའི་རྒྱལ་པོ་རྣམས་དང་མཚོ་འགྲམ་གྱི་ཀ་ན་ཨན་པའི་རྒྱལ་པོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཕར་སླེབས་པའི་བར་དུ་ཁོ་ཚོའི་སྔོན་དུ་ཡོར་དན་གཙང་པོའི་ཆུ་སྐམ་པར་མཛད་པ་ཐོས་ནས། དེ་དག་གི་སེམས་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྐྱེན་གྱིས་དཔའ་ཞུམ་པ་དང་བློ་སྟོབས་ཉམས་པར་གྱུར།"]},{"type":"verse","number":2,"content":["སྐབས་དེར་དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་མེ་རྡོ་ཡི་གྲི་བཟོས་ནས་ཡེས་ར་ཨེལ་པའི་སྡེ་ཚན་གཉིས་པར་མཚན་སྐྱི་ཆོད་ཅིག་ཅེས་གསུངས་པ་ལ།"]},{"type":"verse","number":3,"content":["ཡོ་ཤུ་ཨ་ཡིས་མེ་རྡོ་ཡི་གྲི་བཟོས་ནས་རི་བོ་ཨ་ར་ལོད་",{"noteId":0},"དུ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་མཚན་སྐྱི་བཅད་དོ། །"]},{"type":"verse","number":4,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་མཚན་སྐྱི་གཅོད་པའི་རྒྱུ་མཚན་ཅི་ཡིན་ཞེ་ན། ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་འབངས་རྣམས་ཏེ་འཐབ་མོ་བྱེད་ཐུབ་པའི་སྐྱེས་པ་ཐམས་ཅད་ནི་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་རྗེས་ཚང་མ་དབེན་སྟོང་གི་ལམ་བར་དུ་ཚེ་ལས་འདས་པ་དང་།"]},{"type":"verse","number":5,"content":["ཨེ་ཅིབ་ནས་ཕྱིར་ཐོན་པའི་འབངས་རྣམས་ནི་མཚན་སྐྱི་བཅད་མྱོང་བ་ཡིན་མོད། འོན་ཀྱང་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་རྗེས་དབེན་སྟོང་གི་ལམ་བར་དུ་སྐྱེས་པའི་མི་རྣམས་ནི་མཚན་སྐྱི་བཅད་མ་མྱོང་བའི་ཕྱིར་རོ། །"]},{"type":"verse","number":6,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་མ་མཉན་པས། འབངས་མི་སྟེ་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་དམག་མི་ཐམས་ཅད་རྩ་མེད་དུ་འགྲོ་བའི་བར་དུ། ཁོ་རྣམས་ལོ་ངོ་བཞི་བཅུའི་རིང་ལ་དབེན་སྟོང་འགྲིམས་པའོ། །དཀོན་མཆོག་ཡ་ཝཱེས་སྔར་ཁོ་རྣམས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོའི་ཕ་མེས་རྣམས་ལ་མནའ་བཞེས་ཤིང་རང་ཅག་ལ་གནང་བར་ཞལ་བཞེས་གནང་བའི་ཡུལ་ཏེ་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་དེ་ནི་ཁོ་ཚོར་མཐོང་དུ་མི་འཇུག་ཅེས་མནའ་བཞེས་པའོ། །"]},{"type":"verse","number":7,"content":["ཁོ་རྣམས་ཀྱི་བུ་རབས་ཚ་རྒྱུད་དེ་ཡ་ཝཱེས་ཁོ་ཚོའི་ཚབ་བྱེད་དུ་སྤེལ་བ་རྣམས་ནི་མཚན་སྐྱི་བཅད་མ་མྱོང་བ་དང་། ལམ་བར་དུ་ཁོ་རྣམས་ལ་མཚན་སྐྱི་མ་བཅད་པས་ཡོ་ཤུ་ཨས་ད་ནི་ཁོ་ཚོར་བཅད་དོ། །"]},{"type":"verse","number":8,"content":["འབངས་མི་ཐམས་ཅད་ལ་མཚན་སྐྱི་བཅད་ཚར་ཞིང་། རྨ་ཁ་ཡོངས་སུ་སོས་པའི་བར་དུ་སྒར་ས་རུ་རང་རང་གི་སྡོད་སར་གནས་པའོ། །"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། དེ་རིང་ངས་ཁྱོད་ཚོའི་སྟེང་གི་ཨེ་ཅིབ་ཡུལ་གྱི་ངོ་ཚ་དེ་བསྒྲིལ་བར་བྱའོ་ཞེས་གསུངས་པས་ཡུལ་དེའི་མིང་ལ་ད་ལྟའི་བར་དུ་གིལ་གལ་",{"noteId":1},"ཞེས་འབོད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་གིལ་གལ་ཡུལ་དུ་སྒར་བཏབ་ཅིང་། ཟླ་དང་པོའི་ཚེས་བཅུ་བཞི་ཉིན་གྱི་དགོང་མོར་ཡེ་རུ་ཀོ་ཡི་ཐང་དུ་པེ་སག་གི་དུས་ཆེན་བསྲུངས།"]},{"type":"verse","number":11,"content":["པེ་སག་གི་དུས་ཆེན་གྱི་ཕྱི་ཉིན་ཁོ་ཚོས་ཡུལ་དེའི་ཐོན་རྫས་ཟོས་པ་དང་། ཉིན་མོ་དེར་སྐྱུར་མེད་བག་ལེབ་དང་ཡོས་ཟོས་སོ། །"]},{"type":"verse","number":12,"content":["ཁོ་རྣམས་ཀྱིས་ཡུལ་དེའི་ཐོན་རྫས་ཟོས་པ་དང་དེའི་ཕྱི་ཉིན་མཱན་ནཱ་ཆད་པ་རེད། དེ་ནས་བཟུང་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་མཱན་ནཱ་མེད་པར་གྱུར་མོད། འོན་ཀྱང་ལོ་དེར་ཁོ་རྣམས་ཀྱིས་ཀ་ན་ཨན་ཡུལ་གྱི་ཐོན་རྫས་ཟོས་པའོ། །"]},{"type":"heading","content":["ཡ་ཝཱེའི་དཔུང་ཚོགས་ཀྱི་དམག་དཔོན།"]},{"type":"verse","number":13,"content":["ཡོ་ཤུ་ཨས་ནི་ཡེ་རུ་ཀོ་ལ་ཉེ་བའི་སྐབས་སུ་མགོ་ཡར་བཀྱགས་ནས་བལྟས་ཚེ། བསམ་ཡུལ་ལས་འདས་པ་ཞིག་ལ། ལག་ཏུ་ཤུབས་ལས་བཏོན་པའི་གྲི་བཟུང་བའི་སྐྱེས་བུ་ཞིག་ཁ་གཏད་དུ་ལངས་སྡོད་པ་རེད། ཡོ་ཤུ་ཨ་ནི་ཁོང་གི་དྲུང་དུ་སོང་ནས་ན་རེ། ཁྱེད་ནི་ངེད་ཅག་ལ་རོགས་བྱེད་མཁན་ཡིན་ནམ་ཡང་ན་ངེད་ཅག་གི་དགྲ་ཟླར་རོགས་བྱེད་མཁན་ཡིན་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་ལན་དུ། གང་ཡང་མིན་ཏེ། ང་རང་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་དཔུང་ཚོགས་ཀྱི་དམག་དཔོན་བྱེད་དུ་འོངས་པ་ཡིན་ཞེས་གསུངས་པ་ལ། ཡོ་ཤུ་ཨ་ཡིས་ཁ་སར་གཏད་ནས་ཕྱག་བཙལ་ཞིང་། བདག་གི་གཙོ་བོས་གཡོག་པོ་ལ་བཀའ་ཅི་ཞིག་གནང་ངམ་ཞེས་ཞུས།"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་དཔུང་ཚོགས་ཀྱི་དམག་དཔོན་གྱིས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། ཁྱོད་རང་ལངས་ནས་འདུག་ས་འདི་ནི་གནས་དམ་པ་ཡིན་པས། ཁྱོད་ཀྱིས་བསིལ་ལྷམ་ཕུད་ཅིག་ཅེས་གསུངས་པ་ལ། ཡོ་ཤུ་ཨ་ཡིས་དེ་ལྟར་བྱས་སོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ཨ་ར་ལོད་ཅེས་པ་ནི་མཚན་སྐྱི་བཅད་པའི་དོན་ལ་འཇུག","reference":{"chapter":5,"verse":3}},{"noteId":1,"caller":"+","text":"གིལ་གལ་ཞེས་པ་ནི་བསྒྲིལ་བའི་དོན་ཡིན།","reference":{"chapter":5,"verse":9}}]},"thisChapterLink":"/api/bod_ntb/JOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}