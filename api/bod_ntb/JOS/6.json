{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཕྱིར་ཡེ་རུ་ཀོ་ཡི་མཁར་སྒོ་ནི་བརྟན་པོར་བརྒྱབ་ཅིང་འགྲོ་འོང་བྱེད་མཁན་མེད་པ་རེད།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་སྐུལ་སློང་གནང་སྟེ་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གིས་ཡེ་རུ་ཀོ་དང་དེའི་རྒྱལ་པོ། དེ་མིན་དཔའ་བོ་རྩལ་ཅན་ཐམས་ཅད་ཁྱོད་ཀྱི་ལག་ཏུ་སྤྲད་ཟིན་པ་ཡིན།"]},{"type":"verse","number":3,"content":["ཁྱོད་ཚོའི་དམག་མི་ཐམས་ཅད་ཀྱིས་མཁར་འདིར་སྐོར་བ་རྒྱག་དགོས་པ་སྟེ། ཉིན་རེར་སྐོར་བ་རེ་རྒྱག་དགོས་པ་དང་། ཉིན་དྲུག་གི་རིང་ལ་དེ་ལྟར་བྱེད་དགོས།"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་བདུན་གྱིས་ལུག་གི་རྭ་དུང་བདུན་ཁྱེར་ནས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་སྔོན་དུ་བསྐྱོད་དགོས་པ་དང་། ཉིན་བདུན་པར་སླེབས་ཚེ་ཁྱོད་རྣམས་ཀྱིས་མཁར་ལ་སྐོར་བ་བདུན་རྒྱག་དགོས་ཤིང་། མཆོད་དཔོན་གྱིས་ཀྱང་དུང་འབུད་དགོས།"]},{"type":"verse","number":5,"content":["ཁོ་ཚོའི་རྭ་དུང་གི་སྐད་རྒྱང་འབུད་བྱེད་པ་དང་། ཁྱོད་རྣམས་ཀྱིས་སྐད་དེ་ཐོས་པ་ན་འབངས་མི་རྣམས་ཀྱིས་སྐད་ཆེན་པོ་རྒྱག་དགོས། དེ་ནས་ལྕགས་རི་བརྡིབ་པར་འགྱུར་ཞིང་མི་རེ་རེ་ཐད་ཀར་མདུན་དུ་སྐྱོད་ཅིག་ཅེས་གསུངས།"]},{"type":"verse","number":6,"content":["ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་ཡིས་མཆོད་དཔོན་རྣམས་བོས་ཡོང་ནས་དེ་དག་ལ། ཁྱོད་རྣམས་ཀྱིས་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་འཁུར་ལ་ཤོག མཆོད་དཔོན་བདུན་གྱིས་ལུག་གི་རྭ་དུང་བདུན་ཁྱེར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་སྔོན་དུ་བསྐྱོད་དགོས་ཞེས་བསྒོས་ཤིང་།"]},{"type":"verse","number":7,"content":["ཡང་འབངས་མི་རྣམས་ལ། ཁྱོད་རྣམས་སྔོན་དུ་སོང་ནས་མཁར་ལ་སྐོར་བ་རྒྱོབ་ཅིག མཚོན་ཆ་འཛིན་མཁན་རྣམས་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་སྔོན་དུ་བསྐྱོད་དགོས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་མི་རྣམས་ལ་གཏམ་སྨྲས་ཚར་རྗེས། མཆོད་དཔོན་བདུན་གྱིས་ལུག་གི་རྭ་དུང་བདུན་ཁྱེར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མདུན་དུ་དུང་བུས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ནི་ཁོ་རྣམས་ཀྱི་རྗེས་ནས་ཕེབས་སོ། །"]},{"type":"verse","number":9,"content":["མཚོན་ཆ་འཛིན་མཁན་རྣམས་ནི་རྭ་དུང་འབུད་པའི་མཆོད་དཔོན་རྣམས་ཀྱི་སྔོན་དུ་བསྐྱོད་ཅིང་། རུ་ཁག་རྗེས་མ་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་རྗེས་སུ་འབྲངས་ནས་བསྐྱོད་པ་དང་། མཆོད་དཔོན་རྣམས་ཀྱིས་རྭ་དུང་འབུད་ཀྱིན་བསྐྱོད་དོ། །"]},{"type":"verse","number":10,"content":["ཡོ་ཤུ་ཨ་ཡིས་འབངས་མི་རྣམས་ལ། བདག་གིས་ཁྱོད་རྣམས་ལ་སྐད་རྒྱག་པར་བསྒོ་བའི་ཉིན་མོའི་བར་དུ་ཁྱོད་རྣམས་ཀྱིས་སྐད་རྒྱག་མི་རུང་ལ་སྐད་འདོན་ཡང་མི་རུང་། ཐ་ན་སྐད་ཆ་ཚིག་གཅིག་ཀྱང་ཁྱོད་རྣམས་ཀྱི་ངག་ལས་འཆོར་མི་རུང་སྟེ། སྐབས་དེར་སླེབས་ཚེ་ད་གཟོད་སྐད་རྒྱག་དགོས་ཞེས་བསྒོས།"]},{"type":"verse","number":11,"content":["དེ་ལྟར་ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་མཁར་ལ་སྐོར་དུ་བཅུག་པ་དང་། མཁར་ལ་སྐོར་བ་གཅིག་བརྒྱབ་ཅིང་། མི་རྣམས་ཕྱིར་སྒར་ས་རུ་སླེབས་ནས་དེར་ཞག་སྡོད་བྱས།"]},{"type":"verse","number":12,"content":["ཡོ་ཤུ་ཨ་ནི་ཞོགས་པ་སྔ་མོར་ཡར་ལངས་པ་དང་། མཆོད་དཔོན་རྣམས་ཀྱིས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་ཁུར་ཏོ། །"]},{"type":"verse","number":13,"content":["མཆོད་དཔོན་བདུན་གྱིས་ལུག་གི་རྭ་དུང་བདུན་ཁྱེར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་སྔོན་དུ་རྭ་དུང་འབུད་ཀྱིན་བསྐྱོད་པ་དང་། མཚོན་ཆ་འཛིན་མཁན་རྣམས་ནི་ཁོ་ཚོའི་སྔོན་དུ་བསྐྱོད་ལ། རུ་ཁག་རྗེས་མ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་རྗེས་སུ་འབྲངས་ནས་བསྐྱོད་ཅིང་། མཆོད་དཔོན་རྣམས་ཀྱིས་རྭ་དུང་འབུད་ཀྱིན་མདུན་དུ་བསྐྱོད་དོ། །"]},{"type":"verse","number":14,"content":["ཉིན་གཉིས་པར་འབངས་རྣམས་ཀྱིས་མཁར་ལ་སྐོར་བ་ཐེངས་གཅིག་བརྒྱབ་ནས་ཕྱིར་སྒར་ས་རུ་ལོག་ཅིང་། ཉིན་དྲུག་གི་རིང་ལ་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":15,"content":["ཉིན་བདུན་པའི་ཞོགས་པར། སྐྱ་རེངས་ཤར་དུས་སུ་ཁོ་རྣམས་ཡར་ལངས་ནས་སྔར་བཞིན་མཁར་ལ་སྐོར་བ་ཐེངས་བདུན་བརྒྱབ། ཉིན་དེ་ཁོ་ནར་མཁར་ལ་སྐོར་བ་ཐེངས་བདུན་བརྒྱབ།"]},{"type":"verse","number":16,"content":["ཐེངས་བདུན་པར་སླེབས་ནས་མཆོད་དཔོན་རྣམས་ཀྱིས་རྭ་དུང་འབུད་སྐབས། ཡོ་ཤུ་ཨ་ཡིས་འབངས་མི་རྣམས་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་མཁར་འདི་ཁྱོད་རྣམས་ལ་སྤྲད་ཟིན་པས་སྐད་རྒྱོབ་ཅིག"]},{"type":"verse","number":17,"content":["མཁར་འདི་ནི་བསྔོ་དགོས་ཏེ། མཁར་འདི་དང་འདིའི་ནང་དུ་ཡོད་པ་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས། སྨད་འཚོང་མ་རཱ་ཧབ་ཀྱིས་ང་ཚོས་མངགས་པའི་བང་ཆེན་སྦས་པ་ཡིན་པས། ཁོ་མོ་དང་ཁོ་མོའི་ཁྱིམ་དུ་ཡོད་པ་ཐམས་ཅད་ཁོ་ན་གསོན་པོར་གནས་ཆོག་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ལ་མཚོན་ན། ཁྱོད་རྣམས་ཀྱིས་བསྔོ་བར་འོས་པའི་དངོས་པོ་དེ་བླངས་ནས་ཡེས་ར་ཨེལ་གྱི་སྒར་ཧྲིལ་པོ་ཐག་ཞོར་འབྲེང་འདྲུད་བྱེད་པ་དང་སྒར་ཧྲིལ་པོར་དམོད་མོ་ཐེབས་སུ་འཇུག་ཉེན་ཡོད་པས། གཟབ་གཟབ་གྱིས་ལ་བསྔོ་བར་འོས་པའི་དངོས་པོ་དེ་མ་ལེན་ཞིག"]},{"type":"verse","number":19,"content":["གསེར་དངུལ་ལི་ལྕགས་སོགས་ཀྱི་སྣོད་ཆས་ཐམས་ཅད་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམ་པ་ཡིན་ཞིང་ཁོང་གི་དཀོར་མཛོད་དུ་འཇུག་དགོས་ཞེས་བསྒོས་སོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་འབངས་མི་རྣམས་ཀྱིས་སྐད་བརྒྱབ་ཅིང་མཆོད་དཔོན་རྣམས་ཀྱིས་ཀྱང་རྭ་དུང་བུས། འབངས་མི་རྣམས་ཀྱིས་རྭ་དུང་སྐད་ཐོས་པ་དང་སྐད་ཆེན་པོ་བརྒྱབ་པས། མཁར་གྱི་ལྕགས་རི་བརྡིབས་པ་དང་འབངས་རྣམས་ཡར་མཁར་གྱི་ནང་དུ་སོང་ཞིང་། མི་རེ་རེ་ཐད་ཀར་མདུན་དུ་བསྐྱོད་ནས་མཁར་བླངས་པ་དང་།"]},{"type":"verse","number":21,"content":["ཡང་མཁར་གྱི་ནང་དུ་ཡོད་པ་ཐམས་ཅད་དེ་ཕོ་མོ་རྒན་གཞོན་དང་། བ་གླང་དང་ལུག བོང་བུ་བཅས་སུ་དང་གང་ཡིན་ཡང་ཐམས་ཅད་གྲི་ཡིས་གཙང་གསོད་བྱས་སོ། །"]},{"type":"verse","number":22,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཡུལ་དེར་ལྟ་ཉུལ་བྱེད་མཁན་མི་གཉིས་ལ། ཁྱོད་རྣམས་སྨད་འཚོང་མ་དེའི་ཁྱིམ་དུ་སོང་ནས། ཁྱོད་ཚོས་ཁོ་མོ་ལ་ཇི་ལྟར་དམ་བཅས་པ་བཞིན་དུ། བུད་མེད་དེ་དང་ཁོ་མོའི་ནང་མི་ཐམས་ཅད་དེ་ནས་ཕྱི་རུ་ཁྲིད་ཤོག་ཅེས་བསྒོས་པ་ལ།"]},{"type":"verse","number":23,"content":["ལྟ་ཉུལ་བྱེད་མཁན་གཞོན་ནུ་དེ་གཉིས་ནང་དུ་ཕྱིན་ཅིང་། རཱ་ཧབ་དང་ཁོ་མོའི་ཕ་མ། ཕུ་ནུ། ཁོ་མོ་ལ་ཅི་ཞིག་ཡོད་པ་ཐམས་ཅད་དང་། དེར་མ་ཟད་ཁོ་མོའི་ནང་མི་དང་བཅས་ཚང་མ་ཕྱི་རུ་ཁྲིད་ཡོང་ནས་ཡེས་ར་ཨེལ་པའི་སྒར་གྱི་ཕྱི་རོལ་ཏུ་བཀོད་སྒྲིག་བྱས།"]},{"type":"verse","number":24,"content":["དེ་ནས་འབངས་རྣམས་ཀྱིས་གསེར་དངུལ་ལི་ལྕགས་སོགས་ཀྱི་སྣོད་ཆས་ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་གི་དཀོར་མཛོད་དུ་བཞག་པ་ཕུད། མཁར་དང་དེའི་ནང་དུ་ཡོད་པ་ཐམས་ཅད་མེར་བསྲེགས་པ་རེད།"]},{"type":"verse","number":25,"content":["འོན་ཀྱང་སྨད་འཚོང་མ་རཱ་ཧབ་ཀྱིས་ཡོ་ཤུ་ཨ་ཡིས་ཡེ་རུ་ཀོ་ཡུལ་ལ་ལྟ་ཉུལ་བྱེད་དུ་མངགས་པའི་བང་ཆེན་སྦས་པས། ཡོ་ཤུ་ཨ་ཡིས་ཁོ་མོ་དང་ཁོ་མོའི་ཕ་གཞིས། དེ་མིན་ཁོ་མོའི་ནང་མི་ཐམས་ཅད་ཀྱི་སྲོག་བསྐྱབས་ཤིང་། ཁོ་མོ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་ད་ལྟའི་བར་དུ་འཚོ་བ་ཡིན།"]},{"type":"verse","number":26,"content":["སྐབས་དེར་ཡོ་ཤུ་ཨ་ཡིས་མི་རྣམས་ལ་དམ་བཅའ་འཇོག་ཏུ་བཅུག་པ་སྟེ། ཡར་ལངས་ནས་ཡེ་རུ་ཀོ་མཁར་བསྐྱར་འཛུགས་བྱེད་མཁན་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དམོད་མོ་ཐེབས་འོས་ཤིང་། དེས་རྨང་གཞི་འདིང་དུས་སུ་བུ་སྐྱེས་འགོ་འཆོར་བ་དང་། རྒྱལ་སྒོ་འཛུགས་དུས་སུ་བུ་ཆུང་ཤོས་འཆོར་ངེས་ཡིན་ཞེས་པའོ། །"]},{"type":"verse","number":27,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡོ་ཤུ་ཨ་དང་མཉམ་དུ་བཞུགས་ཤིང་། ཡོ་ཤུ་ཨ་ཡི་མཚན་སྙན་གྲགས་ཡུལ་གྲུ་ཀུན་ཏུ་ཁྱབ་བོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/JOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":27}