{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"JOS","translationId":"bod_ntb","name":"ཡོ་ཤུ་ཨ།","commonName":"ཡོ་ཤུ་ཨ།","title":"༄༅། །ཡོ་ཤུ་ཨའི་མདོ།","order":6,"numberOfChapters":24,"sha256":"8ccc54fa3ab7eb04d6b8f2b3de5be18917cff5158596d5d5dd73521329e92ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":7,"content":[{"type":"heading","content":["ཨ་ཀན་གྱིས་སྡིག་ཉེས་བསགས་པ།"]},{"type":"verse","number":1,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་བསྔོ་བར་འོས་པའི་དངོས་པོའི་སྟེང་ནས་སྡིག་ཉེས་བསགས་པ་སྟེ། ཅི་ལ་ཟེར་ན། ཡ་ཧུ་དཱའི་ཚོ་པ་ནང་གི་ཟེ་རག་གི་ཡང་ཚ་དང་ཟབ་དཱི་ཡི་ཚ་བོ། ཀར་མིའི་བུ་ཨ་ཀན་ཞེས་བྱ་བས་བསྔོ་བར་འོས་པའི་དངོས་པོ་བླངས་པས། དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཐུགས་ཁྲོས་པའོ། །"]},{"type":"verse","number":2,"content":["སྐབས་དེར་ཡོ་ཤུ་ཨ་ཡིས་ཡེ་རུ་ཀོ་ནས་པེད་ཨེལ་གྱི་ཤར་ཕྱོགས་སུ་པེད་ཨ་ཝེན་དང་ཉེ་བའི་ཨེ་ཡུ་གྲོང་ཁྱེར་དུ་མི་མངགས་ཤིང་། ཁོ་རྣམས་ལ། ཁྱོད་ཚོ་ཡར་སོང་ལ་ཡུལ་དེར་ལྟ་ཉུལ་བྱོས་ཤིག་ཅེས་བཀའ་བསྒོས་པ་དང་། ཁོ་རྣམས་ཡར་སོང་སྟེ་ཨེ་ཡུ་གྲོང་ཁྱེར་ལ་ལྟ་ཉུལ་བྱས།"]},{"type":"verse","number":3,"content":["ཁོ་རྣམས་ཡོ་ཤུ་ཨའི་རྩར་ཕྱིར་ལོག་སྟེ་ཁོ་ལ། འབངས་མི་ཐམས་ཅད་ཡར་འགྲོ་མི་དགོས་ཏེ། མི་སྟོང་ཕྲག་གཉིས་གསུམ་ཙམ་ཡར་སོང་ན་ཨེ་ཡུ་གྲོང་ཁྱེར་ལེན་ཐུབ་པ་ཡིན། ཡུལ་དེར་མི་ཉུང་བས་འབངས་མི་ཐམས་ཅད་ལ་དཀའ་ལས་བཟོ་དགོས་དོན་མེད་ཅེས་སྨྲས།"]},{"type":"verse","number":4,"content":["དེ་ནས་འབངས་རྣམས་ལས་མི་སྟོང་ཕྲག་གསུམ་ཙམ་ཡར་ཡུལ་དེར་སོང་མོད། འོན་ཀྱང་ཁོ་ཚོ་ཨེ་ཡུ་གྲོང་ཁྱེར་གྱི་མི་རྣམས་ཀྱི་སྔུན་ནས་བྲོས་པའོ། །"]},{"type":"verse","number":5,"content":["ཨེ་ཡུ་གྲོང་ཁྱེར་གྱི་མི་ཡིས་ཁོ་རྣམས་ལས་མི་སོ་དྲུག་བསད་པ་དང་། མཁར་སྒོ་ནས་ཤ་བཱ་རིམ་གྱི་བར་དུ་ཁོ་རྣམས་བདས་ཤིང་། ལ་ཐུར་ནས་ཁོ་རྣམས་ཕམ་པར་བརྒྱབ་པས། འབངས་རྣམས་འཇིགས་ནས་དཔའ་ཞུམ་པ་རེད།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་ཡིས་གྱོན་གོས་ཕྲལ་ཞིང་། ཁོ་དང་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ཀྱིས་མགོ་ལ་ཐལ་བ་གཏོར་ནས་དགོང་མོའི་བར་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞལ་ཆད་ཀྱི་ཤུར་སྒམ་གྱི་མདུན་དུ་ཁ་སར་བཏུད་ནས་བསྡད།"]},{"type":"verse","number":7,"content":["ཡོ་ཤུ་ཨ་ཡིས་སྐྱོ་བ་ལ། ཀྱེ་གཙོ་བོ་ཡ་ཝཱེ་ལགས། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་འབངས་འདི་རྣམས་ཁྲིད་ནས་ཡོར་དན་གཙང་པོ་བརྒལ་བ་དང་ངེད་ཅག་ཨེ་མོར་པ་རྣམས་ཀྱི་ལག་ཏུ་སྤྲད་ནས་ངེད་རྣམས་རྩ་མེད་དུ་འགྲོ་བར་མཛད་པ་ཡིན་ནམ། ངེད་རྣམས་ཡོར་དན་གཙང་པོའི་ཕ་རོལ་ཏུ་བསྡད་པ་ཡིན་ན་ཅི་མ་རུང་།"]},{"type":"verse","number":8,"content":["ཀྱེ་གཙོ་བོ་ལགས། ཡེས་ར་ཨེལ་པ་རྣམས་ནི་དགྲ་བོའི་སྔུན་ནས་ཁ་ཕྱིར་འཁོར་ཏེ་བྲོས་པ་ཡིན་པས་ང་ལ་ད་དུང་སྨྲ་རྒྱུ་ཅི་ཞིག་ཡོད་དམ།"]},{"type":"verse","number":9,"content":["ཀ་ན་ཨན་གྱི་མི་དང་ཡུལ་འདིའི་མི་རྣམས་ཀྱིས་དོན་དེ་ཐོས་ན་ངེད་རྣམས་བསྐོར་ཞིང་ངེད་ཅག་གི་མིང་ནི་ས་གཞི་ལས་མེད་པར་བཟོ་བར་འགྱུར། སྐབས་དེར་ཁྱེད་ཀྱིས་ཉིད་ཀྱི་མཚན་སྙན་གྱི་ཕྱིར་དུ་ཅི་ཞིག་མཛད་པར་བྱའམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":10,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡོ་ཤུ་ཨ་ལ་འདི་སྐད་དུ། ཡར་ལོངས་ཤིག ཁྱོད་ཁ་སར་བཏུད་ནས་འདུག་དོན་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":11,"content":["ཡེས་ར་ཨེལ་པས་སྡིག་ཉེས་བསགས་པ་དང་། ངས་ཁོ་རྣམས་ལ་བསྒོས་པའི་ཞལ་ཆད་དང་འགལ་ནས་བསྔོ་བར་འོས་པའི་དངོས་པོ་བླངས་པ་རེད། ཡང་རྐུ་བྱས་ནས་གཡོ་སྒྱུ་ཡིས་བསྔོ་བར་འོས་པའི་དངོས་པོ་དེ་ཁོ་རྣམས་ཀྱི་ཅ་ལག་ནང་དུ་བཞག་གོ །"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར། ཡེས་ར་ཨེལ་པ་རྣམས་ནི་དགྲ་བོའི་སྔུན་ནས་ཚུགས་མ་ཐུབ་པ་དང་། ཁོ་རྣམས་རྩ་མེད་དུ་གཏོང་འོས་པར་གྱུར་པས་དགྲ་བོའི་སྔུན་ནས་ཁ་ཕྱིར་འཁོར་ཏེ་བྲོས་པ་ཡིན་ནོ། །གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་བསྔོ་བར་འོས་པའི་དངོས་པོ་རྣམས་ཁྱོད་ཅག་གི་ཁྲོད་དུ་མེད་པར་མི་བཟོ་ན། དེང་ཕྱིན་ང་རང་ཁྱོད་རྣམས་དང་མཉམ་དུ་གནས་པར་མི་འགྱུར།"]},{"type":"verse","number":13,"content":["ཁྱོད་རང་ཡར་ལངས་ནས་འབངས་རྣམས་ལ་རང་རང་གཙང་མར་བཟོ་རུ་བཅུག་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཀྱེ་ཡེས་ར་ཨེལ། ཁྱོད་རྣམས་ཀྱི་ཁྲོད་དུ་བསྔོ་བར་འོས་པའི་དངོས་པོ་ཡོད་ཅིང་། གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་དེ་མེད་པར་མ་བཟོས་ན་དགྲ་བོའི་སྔུན་ནས་ཚུགས་མི་ཐུབ་པར་གདོན་མི་ཟའོ་ཞེས་གསུངས་པས། སང་ཉིན་གྱི་ཕྱིར་དུ་ཁྱོད་རྣམས་ཀྱིས་རང་རང་གཙང་མར་བཟོ་དགོས་ཞེས་སྨྲ་བར་གྱིས་ཤིག"]},{"type":"verse","number":14,"content":["ཞོགས་པ་སླེབས་དུས་ཁྱོད་རྣམས་ཚོ་པ་རེ་རེ་བཞིན་མདུན་སར་འོང་དགོས་པ་སྟེ། ཡ་ཝཱེས་རྒྱན་འཕངས་ནས་བབས་པའི་ཚོ་པ་ནི་རུས་རྒྱུད་རེ་རེ་བཞིན་མདུན་སར་འོང་དགོས་པ་དང་། ཡ་ཝཱེས་རྒྱན་འཕངས་ནས་བབས་པའི་རུས་རྒྱུད་ནི་ཁྱིམ་རྒྱུད་རེ་རེ་བཞིན་མདུན་སར་འོང་དགོས། ཡ་ཝཱེས་རྒྱན་འཕངས་ནས་བབས་པའི་ཁྱིམ་རྒྱུད་ནི་སྐྱེས་པ་རེ་རེ་བཞིན་མདུན་སར་འོང་དགོས།"]},{"type":"verse","number":15,"content":["རྒྱན་བབས་པའི་མི་ཡི་ལག་ཏུ་བསྔོ་བར་འོས་པའི་དངོས་པོ་ཡོད་ན། ཁོ་དང་ཁོ་ལ་གཏོགས་པ་ཐམས་ཅད་མེར་བསྲེག་དགོས་པ་སྟེ། ཁོ་རང་ཡ་ཝཱེའི་ཞལ་ཆད་དང་འགལ་ཞིང་ཡང་ཁོས་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་བླུན་ཧམ་ཆེ་བའི་དོན་བསྒྲུབས་པས་སོ་ཞེས་གསུངས།"]},{"type":"verse","number":16,"content":["དེ་ནས་ཡོ་ཤུ་ཨ་ཞོགས་པ་སྔ་མོ་ཡར་ལངས་ཏེ་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་རེ་རེ་བཞིན་མདུན་སར་འོང་དུ་བཅུག་པ་ལ་ཡ་ཧུ་དཱ་ཚོ་པར་རྒྱན་བབས་པའོ། །"]},{"type":"verse","number":17,"content":["ཡང་ཡ་ཧུ་དཱ་རུས་རྒྱུད་མདུན་སར་འོང་དུ་བཅུག་པ་དང་ཟེ་རག་གི་ཁྱིམ་རྒྱུད་ལ་རྒྱན་བབས། ཡང་ཟེ་རག་གི་ཁྱིམ་རྒྱུད་ཀྱི་སྐྱེས་པ་རེ་རེ་བཞིན་མདུན་སར་འོང་དུ་བཅུག་པ་དང་ཟབ་དཱི་ལ་རྒྱན་བབས།"]},{"type":"verse","number":18,"content":["ཡང་ཟབ་དཱི་ཡི་ཁྱིམ་རྒྱུད་ཀྱི་སྐྱེས་པ་རེ་རེ་བཞིན་མདུན་སར་འོང་དུ་བཅུག་པ་དང་། ཡ་ཧུ་དཱ་ཚོ་པའི་ཟེ་རག་གི་ཡང་ཚ་དང་ཟབ་དཱི་ཡི་ཚ་བོ། ཀར་མིའི་བུ་ཨ་ཀན་ཞེས་བྱ་བར་རྒྱན་བབས།"]},{"type":"verse","number":19,"content":["ཡོ་ཤུ་ཨ་ཡིས་ཨ་ཀན་ལ། ངའི་བུ། ཁྱོད་ཀྱིས་གཟི་བརྗིད་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་ཞིག ཁོང་གི་མདུན་ནས་མཐོལ་བཤགས་བྱོས་ལ། ཁྱོད་ཀྱིས་ཅི་བྱས་པ་རྣམས་ང་ལ་མ་གསང་བར་སྨྲོས་ཤིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":20,"content":["ཨ་ཀན་གྱིས་དེའི་ལན་དུ་ཡོ་ཤུ་ཨ་ལ། ངས་དངོས་གནས་ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་འགལ་བའི་སྡིག་པ་བྱས་པ་ཡིན། ངས་བྱས་པའི་དོན་ནི་འདི་དང་འདི་ལྟར་ཡིན།"]},{"type":"verse","number":21,"content":["ངས་འཕྲོག་བཅོམ་བྱས་པའི་ནོར་རྫས་ཁྲོད་དུ་ཤིན་ཨར་པའི་གྱོན་གོས་ཡག་ཤོས་ཞིག་དང་། དངུལ་སྲང་ཉིས་བརྒྱ། སྲང་ལྔ་བཅུ་ཅན་གྱི་གསེར་ལྕུག་གཅིག་བཅས་མཐོང་བས། ང་རང་དངོས་པོ་དེ་རྣམས་ལ་ཞེན་ཆགས་ནས་ཁྱེར་བ་དང་། ད་ལྟ་ངའི་གུར་ནང་གི་ས་འོག་ཏུ་སྦས་ཡོད་ལ། དངུལ་ནི་གྱོན་གོས་ཀྱི་འོག་ཏུ་ཡོད་ཅེས་སྨྲས་པར།"]},{"type":"verse","number":22,"content":["ཡོ་ཤུ་ཨ་ཡིས་ལག་རོགས་མངགས་ཤིང་ཨ་ཀན་གྱི་གུར་ནང་དུ་རྒྱུགས་སོང་བ་ལ། གྱོན་གོས་དེ་དངོས་གནས་ཁོའི་གུར་ནང་དུ་སྦས་ཡོད་པ་དང་། དངུལ་དེའི་འོག་ཏུ་ཡོད་དོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཁོ་རྣམས་ཀྱིས་གུར་ལས་བླངས་ཏེ་ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྩར་ཁྱེར་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བཞག"]},{"type":"verse","number":24,"content":["ཡོ་ཤུ་ཨ་དང་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཟེ་རག་གི་ཡང་ཚ་ཨ་ཀན་དང་། དངུལ་དེ་དང་། གྱོན་གོས་དེ་དང་། གསེར་ལྕུག་དེ་དང་། དེ་མིན་ཨ་ཀན་གྱི་བུ་ཕྲུག་རྣམས་དང་བ་གླང་། བོང་བུ། ལུག གུར་ལ་སོགས་ཁོ་ལ་གཏོགས་པ་ཐམས་ཅད་དང་བཅས་པ་ཨ་ཀོར་ལུང་པར་ཁྲིད་ཅིང་།"]},{"type":"verse","number":25,"content":["ཡོ་ཤུ་ཨ་ཡིས། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་ང་ཚོ་སྡུག་ལ་གཏད་པ་ཡིན་ནམ། དེ་རིང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རང་སྡུག་ལ་སྦྱོར་ངེས་ཡིན་ཞེས་སྨྲས་པ་དང་། དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཁོ་རང་རྡོ་རུབ་བཏང་ནས་བསད་ཅིང་། རྡོ་རྣམས་དེའི་སྟེང་དུ་འཕངས་ནས་ཡང་ཁོ་ལ་གཏོགས་པ་ཐམས་ཅད་མེར་བསྲེགས་པའོ། །"]},{"type":"verse","number":26,"content":["མི་རྣམས་ཀྱིས་ཨ་ཀན་གྱི་ལུས་སྟེང་དུ་རྡོ་སྤུང་ཆེན་པོ་བརྒྱབ་པ་ད་ལྟའི་བར་དུ་ལུས། དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཚུར་འཁོར་ཏེ་ཐུགས་ཁྲོ་ཆེན་པོ་ཞི་བར་གྱུར་ཏོ། །དེའི་ཕྱིར་ཡུལ་དེའི་མིང་ལ་ད་ལྟའི་བར་དུ་ཨ་ཀོར་",{"noteId":2},"ལུང་པ་ཞེས་བྱའོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ཨ་ཀོར་ཞེས་པ་ནི་སྡུག་ལ་གཏད་པ་ཞེས་པའི་དོན་ཡིན།","reference":{"chapter":7,"verse":26}}]},"thisChapterLink":"/api/bod_ntb/JOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/JOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/JOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":26}