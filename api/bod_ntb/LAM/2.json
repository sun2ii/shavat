{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LAM","translationId":"bod_ntb","name":"སྐྱོ་གླུ།","commonName":"སྐྱོ་གླུ།","title":"༄༅།།ཡེ་རེམ་ཡཱའི་སྐྱོ་གླུའི་མདོ།","order":25,"numberOfChapters":5,"sha256":"a3c4ab4752c3530838522d0144a9623265de696ae44ea0c130e64c298df119e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/LAM/5.json","totalNumberOfVerses":153},"chapter":{"number":2,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རུ་སཱ་ལེམ་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":1,"content":["གཙོ་བོས་ཁྲོས་པའི་སྤྲིན་གྱིས་ཛ་ཡན་བུ་མོ་བསྒྲིབས་པར་གྱུར། ། ཁོང་གིས་ཡེས་ར་ཨེལ་གྱི་གཟི་བརྗིད་གནམ་ནས་ས་རུ་འཕངས། ། ཁོང་ཉིད་ཁྲོས་པའི་ཉིན་མོའི་ནང་དུ་ཡང་། ། རང་གི་ཞབས་སྟེགས་",{"noteId":1},"ནམ་ཡང་དྲན་མ་གྱུར། །"]},{"type":"verse","number":2,"content":["གཙོ་བོས་ཡ་ཀོབ་ཁོ་ཡི་གནས་ཀུན་ནི། ། ཁྱུར་མིད་བཏང་ཡང་ཐུགས་ནི་ཡེ་མི་འགྱོད། ། ཁོང་གིས་ཉིད་ཀྱི་ཐུགས་ཁྲོ་ཆེན་པོའི་ནང་། ། ཡ་ཧུ་དཱ་ཡི་མི་སྡེའི་མཁར་རྣམས་བཤིག ། ཁོང་གིས་རྒྱལ་ཁབ་དང་ནི་འགོ་དཔོན་རྣམས། ། ས་ལ་བརྡབས་ཏེ་ངོ་ཚ་ཐེབས་པར་མཛད། །"]},{"type":"verse","number":3,"content":["ཁོང་ཉིད་ཁྲོས་པས་ཡེས་ར་ཨེལ་གྱི་རྭ་ཅོ་",{"noteId":2},"ཐམས་ཅད་བཅད། ། ཁོང་གི་དགྲ་ཟླའི་མདུན་ནས་ཉིད་ཀྱི་གཡས་ཕྱག་ཚུར་འཁུམས་ཤིང་། ། ཁོང་ནི་ཕྱོགས་བཞིའི་དངོས་པོ་བསྲེག་པའི་མེ་ལྕེ་བཞིན། ། ཡ་ཀོབ་ཁོ་ཡི་ནང་དུ་ཁྱུར་མིད་བཏང་བ་འོ། །"]},{"type":"verse","number":4,"content":["ཁོང་ནི་དགྲ་ཟླས་འཐེན་པའི་གཞུ་བཞིན་དུ། ། གཡས་ཕྱག་གིས་ནི་གྲ་སྒྲིག་བྱས་ཟིན་ཏེ། ། ཁོང་ནི་དགྲ་ཟླས་མིག་ནང་ལྷུང་བ་ཐམས་ཅད་བསད་པ་བཞིན། ། ཁོང་གི་ཐུགས་ཁྲོ་མེ་ལྟར་ཛ་ཡན་སྦྲ་གུར་སྟེང་དུ་བླུགས། །"]},{"type":"verse","number":5,"content":["གཙོ་བོ་དགྲ་ཟླ་བཞིན་དུ་གྱུར་པ་དང་། ། ཁོང་གིས་ཡེས་ར་ཨེལ་དང་དེའི་ཕོ་བྲང་། ། ཁྱུར་མིད་བཏང་ཞིང་བཙན་པོའི་མཁར་ཡོངས་བཤིག ། ཁོང་གིས་ཡ་ཧུ་དཱ་ཡི་མི་སྡེའི་ནང་། ། སྡུག་བསྔལ་དང་ནི་ངུ་འབོད་བསྣན་པར་མཛད། །"]},{"type":"verse","number":6,"content":["ཁོང་གིས་ཉིད་ཀྱི་བཞུགས་གནས་ཡོངས་སུ་བརླགས། ། ལྡུམ་ར་ཇི་བཞིན་ཉིད་ཀྱི་ཚོགས་ར་གཏོར། ། ཡ་ཝཱེའི་སྲུང་བྱའི་དུས་དང་ངལ་གསོའི་དུས། ། ཛ་ཡན་ཡུལ་དུ་མ་ལུས་བརྗེད་པར་མཛད། ། ཁོང་གིས་ཉིད་ཀྱི་ཐུགས་ཁྲོ་ཆེན་པོའི་ནང་། ། རྒྱལ་པོ་དང་ནི་མཆོད་དཔོན་དོར་བར་མཛད། །"]},{"type":"verse","number":7,"content":["གཙོ་བོས་ཉིད་ཀྱི་མཆོད་ཁྲི་སྤངས་ཤིང་གནས་མཆོག་དོར། ། ཁོང་གིས་ཕོ་བྲང་དེ་ཡི་ལྕགས་རི་དགྲ་ལག་གཏད། ། དུས་ཆེན་ཞིག་ལ་དགའ་བའི་རྟེན་འབྲེལ་ཞུ་བ་བཞིན། ། ཡ་ཝཱེའི་བཞུགས་གནས་ནང་དུ་དེ་ཚོས་འུར་སྒྲ་བསྒྲགས། །"]},{"type":"verse","number":8,"content":["ཡ་ཝཱེས་ཛ་ཡན་མི་སྡེའི་མཁར་རྣམས་བརླག་པར་དགོངས། ། ཁོང་གིས་ཐིག་སྐུད་",{"noteId":3},"འཐེན་ནས་ཕྱག་ཟུང་མ་འཁུམས་ཤིང་། ། ཁོང་གིས་བཙན་མཁར་དེ་དག་གཏོར་བར་མཛད་ཕྱིར་དུ། ། བཙན་རྫོང་དང་ནི་མཁར་གྱང་མཉམ་དུ་སྡུག་ལ་སྦྱར། །"]},{"type":"verse","number":9,"content":["ཛ་ཡན་ཡུལ་གྱི་མཁར་སྒོ་ཐམས་ཅད་ས་རུ་ནུབ་པ་དང་། ། གཙོ་བོས་ཁོ་མོའི་སྒོ་གཏན་དག་ཀྱང་དུམ་བུར་མཛད་གྱུར་ཅིང་། ། ཁོ་མོའི་རྒྱལ་པོ་དང་ནི་འགོ་དཔོན་ཡུལ་ཁམས་སོ་སོར་ཐོར། ། དེ་ནས་ཛ་ཡན་ཡུལ་དུ་བཀའ་ཁྲིམས་གཏན་ནས་མེད་གྱུར་ཅིང་། ། ཡ་ཝཱེའི་ཞལ་གཟིགས་ལུང་སྟོན་པ་ཚོར་ནམ་ཡང་ཐོབ་མ་གྱུར། །"]},{"type":"verse","number":10,"content":["ཛ་ཡན་ཡུལ་གྱི་རྒན་པོ་མཐའ་དག་ས་རུ་ཁ་རོག་བསྡད། ། ཁོ་ཚོས་ཐལ་བ་མགོ་ལ་གཏོར་ཅིང་སྐེད་པར་སོ་རས་བཅིངས། ། ཡེ་རུ་སཱ་ལེམ་ཡུལ་གྱི་མོ་གསར་ཐམས་ཅད་མགོ་སར་བཏུད། །"]},{"type":"verse","number":11,"content":["ང་ཡི་མིག་ལས་མཆི་མ་བཞུར་བས་ལོང་བར་གྱུར་པ་དང་། ། ང་ཡི་སེམས་པ་སྐྱོ་ཞིང་ལུས་ཟུངས་ཡོངས་སུ་ཉམས་པར་གྱུར། ། དེ་དག་ཐམས་ཅད་ང་ཡི་མི་སྡེ་སྡུག་ལ་སྦྱར་བ་དང་། ། བྱིས་པ་དང་ནི་ཕྲུ་གུ་གྲོང་གི་ལམ་ནང་འགྱེལ་བའི་ཕྱིར། །"]},{"type":"verse","number":12,"content":["དེ་དག་མཚོན་ཆས་རྨས་པའི་མི་ལྟར་གྲོང་ཁྱེར་སྲང་ལམ་འགྱེལ། ། དེ་དག་རང་གི་མ་ཡི་པང་དུ་འཆི་ལ་ཉེ་བའི་དུས། ། ཟས་དང་རྒུན་ཆང་གང་དུ་ཡོད་ཅེས་མ་ལ་དྲིས་དང་མཚུངས། །"]},{"type":"verse","number":13,"content":["ཀྱེ་ཀྱེ་ཡེ་རུ་སཱ་ལེམ་ཡུལ་གྱི་མི་སྡེ་རྣམས། ། བདག་གིས་ཁྱོད་ལ་བདེན་དཔང་ཅི་ལྟར་བྱེད་དགོས་སམ། ། བདག་གིས་ཁྱོད་དང་ཅི་ལྟར་བསྡུར་བར་འགྱུར་ནུས་སམ། ། ཀྱེ་ཀྱེ་ཛ་ཡན་ཡུལ་གྱི་མི་སྡེ་ངས་ཁྱོད་ལ། ། སེམས་གསོ་བྱ་ཕྱིར་ཅི་ཞིག་གིས་ནི་ཁྱོད་དང་བསྡུར། ། ཁྱོད་ཀྱི་རྨ་ཁ་མཚོ་བཞིན་ཡངས་པས་སུ་ཡིས་གསོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ཀྱི་ལུང་སྟོན་པ་ཡིས་ཁྱོད་དོན་དུ། ། མཐོང་བའི་ཞལ་གཟིགས་གཡོ་ཟོལ་བླུན་རྨོངས་ཡིན། ། ཁྱོད་ཀྱི་ཚེ་སྲོག་ཡང་བསྐྱར་དྲངས་པའི་ཕྱིར། ། དེ་ཚོས་ཁྱོད་ཀྱི་ཉེས་སྡིག་ཕྱིར་མ་མངོན། ། ཁྱོད་ཕྱིར་དེ་ཚོར་ཐོབ་པའི་བཀའ་ལུང་ནི། ། རྫུན་དང་མི་རྣམས་ལོག་ལམ་ཁྲིད་བྱེད་ཡིན། །"]},{"type":"verse","number":15,"content":["ཁྱོད་རང་མཐོང་བའི་ལམ་འགྲོ་པ་རྣམས་ཀྱིས། ། ལག་པ་བརྡབས་ནས་ཁྱོད་ལ་འཕྱས་པ་དང་། ། དེ་ཚོས་ཡེ་རུ་སཱ་ལེམ་ཡུལ་གྱི་མི་སྡེར་མགོ་གཡུགས་ནས། ། ཀུན་གྱིས་སྨྲ་བར་བརྗོད་པའི་སྐྱོན་བྲལ་ཡོན་ཏན་ཀུན་རྫོགས་ཤིང་། ། ཐམས་ཅད་དགའ་བྱེད་གྲོང་ཁྱེར་འདི་ནི་ཨེ་ཡིན་ནམ་ཞེས་སྨྲས། །"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱི་དགྲ་བོས་ཁྱོད་ལ་རྒོལ་ཕྱིར་ཁ་གདངས་ཤིང་། ། ཁྱོད་ལ་འཕྱ་དམོད་བྱེད་ཀྱིན་སོ་ཡང་འཆོས་ནས་ནི། ། ངེད་ཅག་རྣམས་ཀྱིས་དེ་ནི་མེད་པར་མཛད་གྱུར་ཅིང་། ། དེ་ནི་ང་ཚོས་རེ་སྒུག་བྱེད་པའི་ཉིན་མོ་སྟེ། ། ངེད་ཀྱིས་མིག་གིས་དངོས་སུ་མཐོང་ངོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["ཁོང་གིས་ཁྱོད་ནི་གཏོར་ཡང་སྙིང་རྗེས་གཟིགས་པ་མེད། ། ཁོང་གིས་དགྲ་ཟླ་ཁྱོད་ལས་རྒྱལ་བས་དགའ་བར་མཛད། ། ཁོང་གིས་ཁྱོད་ཀྱི་དགྲ་བོའི་རྭ་ནི་མཐོན་པོར་མཛད། ། ཡ་ཝཱེས་ཉིད་ཀྱི་ཐུགས་དགོངས་བཞིན་དུ་མཛད་པ་དང་། ། ཁོང་གིས་སྔར་ནས་གསུངས་པ་བཞིན་དུ་མཛད་པར་གྱུར། །"]},{"type":"verse","number":18,"content":["ཛ་ཡན་ཡུལ་གྱི་མི་སྡེའི་མཁར་གྱང་རྣམས། ། ཁྱོད་ཀྱིས་བློ་སེམས་གཅིག་གིས་གཙོ་བོར་ཞུས། ། ཁྱོད་ཀྱི་མིག་ཆུ་གཙང་པོ་ཇི་བཞིན་དུ། ། ཉིན་མཚན་དབྱེ་བ་མེད་པར་བཞུར་ནས་ནི། ། རང་ལ་ངལ་གསོ་ནམ་ཡང་ཐོབ་མི་བྱ། ། མིག་འབྲས་གཉིས་ལ་ངལ་གསོ་མེད་པར་ཤོག །"]},{"type":"verse","number":19,"content":["མཚན་མོ་ཐུན་མཚམས་",{"noteId":4},"དང་པོའི་དུས་སུ་བབས་པ་ན། ། ཁྱོད་ནི་ཡར་ལ་ལངས་ཏེ་བོས་ནས་ཞུས་ཤིག་དང་། ། གཙོ་བོའི་དྲུང་དུ་ཁྱོད་ཀྱི་སྙིང་གཏམ་ལྷུག་པོར་བརྗོད་དགོས་ཤིང་། ། ཁྱོད་ཀྱི་བྱིས་པ་རྣམས་ནི་ལམ་བར་དག་ཏུ་བཀྲེས་ཤིང་བརྒྱལ། ། ཁྱོད་ཀྱིས་བྱིས་པ་རྣམས་ཀྱི་ཚེ་སྲོག་བསྐྱབ་པའི་ཕྱིར། ། ལག་པ་ཡར་ལ་བརྐྱངས་ཏེ་གཙོ་བོར་གསོལ་བ་ཐོབས། །"]},{"type":"verse","number":20,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ཁྱེད་ཀྱིས་གཟིགས་དང་གཟིགས་པར་མཛོད། ། ཁྱེད་ཀྱིས་སྔོན་ཆད་འདི་ལྟར་སུ་ལ་ལན་འཇལ་ལམ། ། བུད་མེད་ཅིག་གིས་རང་གིས་བཙས་ནས་སྐྱོང་བ་ཡི། ། ཕྲུ་གུ་ཟ་ཞིང་བཟའ་བར་ཕོད་པ་སུ་ཡོད་དམ། ། གཙོ་བོའི་གནས་མཆོག་ལ་ནི་མཆོད་དཔོན་དང་ནི་ལུང་སྟོན་པ། ། གདུག་རྩུབ་ནག་པོའི་ལས་ཀྱིས་དམར་གསོད་བྱེད་ཅིང་བྱ་འོས་སམ། །"]},{"type":"verse","number":21,"content":["སྲང་བར་དག་ཏུ་རྒན་གཞོན་ཐམས་ཅད་ས་རུ་འགྱེལ་ནས་ཤི ། བདག་གི་བུ་མོ་དང་ནི་གསར་བུ་ཐམས་ཅད་གྲི་ཁར་འགྱེལ། ། ཁྱེད་རང་ཁྲོས་པའི་ཉིན་ལ་དེ་རྣམས་ཐམས་ཅད་གསོད་པར་མཛད། ། ཁྱེད་ཀྱིས་དེ་རྣམས་བསད་ཀྱང་སྙིང་རྗེ་ཅི་ཡང་མ་གནང་ངོ་། །"]},{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གྱི་སྡུག་བསྔལ་ཅན་གྱི་གསོལ་འདེབས།"]},{"type":"verse","number":22,"content":["ཁྱེད་ཀྱིས་ཕྱོགས་བཞི་བསྡུས་ཏེ་ང་རང་སྐྲག་པར་མཛད་པ་ནི། ། དུས་ཆེན་རོལ་བའི་ཉིན་ལ་མི་ཚོགས་མང་པོ་བསྡུས་དང་མཚུངས། ། ཡ་ཝཱེ་ཐུགས་ཁྲོའི་དུས་སུ་ཐར་ཏེ་གསོན་མཁན་གཅིག་ཀྱང་མེད། ། བདག་གིས་བཙས་ཤིང་ཆེ་བར་བསྐྱངས་པའི་ཕྲུ་གུ་རྣམས། ། དགྲ་ཟླས་ཐམས་ཅད་བསད་དེ་གཅིག་ཀྱང་མ་ལྷག་གོ །"]}],"footnotes":[{"noteId":1,"caller":"+","text":"འདིར་ཞབས་སྟེགས་ཞེས་པ་ནི་ས་གཞི་ཡོངས་དང་ལྷག་པར་དུ་ཡེ་རུ་སཱ་ལེམ་སྟེ་དཀོན་མཆོག་གི་གྲོང་ཁྱེར་དེ་ལ་གོ་བ་ཡིན།","reference":{"chapter":2,"verse":1}},{"noteId":2,"caller":"+","text":"འདིར་རྭ་ཅོ་ཞེས་པ་ནི་སྟོབས་ཤུགས་ལ་འཇུག","reference":{"chapter":2,"verse":3}},{"noteId":3,"caller":"+","text":"ཐིག་སྐུད་ཅེས་པ་ནི་སྤྱིར་རྩིག་པ་དྲང་མིན་ལ་བལྟ་བ་དང་རིང་ཐུང་ཚད་བྱེད་ཡིན་ཞིང་། འདིར་དཀོན་མཆོག་ཡ་ཝཱེས་རང་གི་མི་རྣམས་དྲང་བདེན་ཡིན་མིན་གྱི་ཚད་ཐིག་བླངས་ནས་དྲང་བདེན་མིན་པ་རྣམས་རྩ་མེད་གཏོང་བར་གོ་བ་ཡིན།","reference":{"chapter":2,"verse":8}},{"noteId":4,"caller":"+","text":"ཐུན་མཚམས་ཞེས་པ་ནི་མཚན་མོ་གཅིག་ཐུན་མཚམས་གསུམ་ལ་བགོས་པ་སྟེ། ཐུན་མཚམས་དང་པོ་ནི་དུས་ཚོད་དྲུག་ནས་བཅུ་ཡི་བར་དང་། ཐུན་མཚམས་བར་མ་ནི་དུས་ཚོད་བཅུ་ནས་གཉིས་ཀྱི་བར་དང་། ཐུན་མཚམས་གསུམ་པ་ནི་དུས་ཚོད་གཉིས་ནས་དྲུག་གི་བར་དུ་ཡིན།","reference":{"chapter":2,"verse":19}}]},"thisChapterLink":"/api/bod_ntb/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}