{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LAM","translationId":"bod_ntb","name":"སྐྱོ་གླུ།","commonName":"སྐྱོ་གླུ།","title":"༄༅།།ཡེ་རེམ་ཡཱའི་སྐྱོ་གླུའི་མདོ།","order":25,"numberOfChapters":5,"sha256":"a3c4ab4752c3530838522d0144a9623265de696ae44ea0c130e64c298df119e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/LAM/5.json","totalNumberOfVerses":153},"chapter":{"number":3,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཁྲོ་གཏུམ་གྱི་དབྱུག་པ།"]},{"type":"verse","number":1,"content":["བདག་ནི་ཡ་ཝཱེའི་དབྱུག་པའི་འོག་ཏུ་སྡུག་བསྔལ་མྱངས་པའི་མི་ཡིན་ཏེ། །"]},{"type":"verse","number":2,"content":["ཁོང་གིས་བདག་ནི་མུན་པའི་ནང་དུ་ཁྲིད་ཀྱང་འོད་ནང་མ་ཁྲིད་དོ། །"]},{"type":"verse","number":3,"content":["ཁོང་གིས་དངོས་གནས་ཉིན་གང་བདག་ལ་ཡང་ཡང་རྒོལ་བ་དང་། །"]},{"type":"verse","number":4,"content":["ཁོང་གིས་བདག་གི་ཤ་པགས་ཉམས་ཤིང་རུས་པ་བཅག་པར་མཛད། །"]},{"type":"verse","number":5,"content":["ཁོང་གིས་བཙན་རྫོང་བརྩིགས་ཏེ་བདག་གི་མཐའ་ནས་བསྐོར། ། གནོད་པ་དང་ནི་དཀའ་སྡུག་ང་ལ་བསྐོར་བར་མཛད། །"]},{"type":"verse","number":6,"content":["ཁོང་གིས་ང་རང་མུན་པར་སྡོད་བཅུག་སྟེ། ། ཤི་ནས་ཡུན་རིང་འགོར་བའི་མི་ལྟར་མཛད། །"]},{"type":"verse","number":7,"content":["ཁོང་གིས་མཁར་རྣམས་བརྩིགས་ཏེ་བདག་བསྐོར་བས། ། བདག་ནི་དེ་ལས་ཐར་བར་མ་མཛད་དེ། ། ཁོང་གིས་བདག་གི་ལྕགས་སྒྲོག་ལྗིད་དུ་བཏང་། །"]},{"type":"verse","number":8,"content":["ཐ་ན་བདག་གིས་ཁོང་ལ་ཞུས་ནས་འོ་དོད་འབོད་དུས་ཀྱང་། ། ཁོང་གིས་སྙན་ཅོག་བཀབ་སྟེ་ང་ཡི་གསོལ་འདེབས་མ་གསན་ཏོ། །"]},{"type":"verse","number":9,"content":["ཁོང་གིས་རྡོ་བ་བཟོས་མས་བདག་གི་ལམ་བུ་བཀག ། ཁོང་གིས་བདག་གི་འགྲོ་ལམ་ཀྱག་ཀྱོག་ཏུ་མཛད་དོ། །"]},{"type":"verse","number":10,"content":["ཁོང་ཉིད་བདག་ལ་མཚོན་ན་ནི། ། འཇབ་སྒུག་བྱེད་པའི་དྲེད་མོང་དང་། ། གསང་བའི་གནས་ཀྱི་སེང་གེ་བཞིན། །"]},{"type":"verse","number":11,"content":["ཁོང་གིས་བདག་ནི་དྲང་པོའི་ལམ་དང་ཕྲལ། ། སིལ་བུར་གཏོར་ནས་དབེན་སར་བསྐྱུར་བ་ཡིན། །"]},{"type":"verse","number":12,"content":["ཁོང་གིས་ཉིད་ཀྱི་གཞུ་འཐེན་ཏེ། ། བདག་ནི་མདའ་ཡི་འབེན་དུ་མཛད། །"]},{"type":"verse","number":13,"content":["ཁོང་གིས་ཉིད་ཀྱི་མདའ་ཤུབས་ནང་གི་མདའ། ། ང་ཡི་སྙིང་ཁོང་རུས་པའི་གཏིང་དུ་བསྣུན། །"]},{"type":"verse","number":14,"content":["བདག་ནི་མི་སྡེ་ཀུན་གྱིས་འཕྱ་དམོད་བྱེད་སར་གྱུར། ། འཕྱ་དགོད་གླུ་རུ་གྱུར་ཏེ་ཀུན་གྱིས་ཉིན་གང་འཕྱས། །"]},{"type":"verse","number":15,"content":["ཁོང་གིས་བདག་ལ་སྡུག་བསྔལ་ཆེན་པོ་བཟོས། ། མཁན་པའི་ཁ་ཏིག་ཉམས་སུ་མྱོང་བར་མཛད། །"]},{"type":"verse","number":16,"content":["ཁོང་གིས་ཟེགས་མས་བདག་གི་སོ་ནི་ཆག་པར་མཛད། ། ཁོང་གིས་བདག་ནི་ས་རྡུལ་ནང་དུ་སྡོད་པར་མཛད། །"]},{"type":"verse","number":17,"content":["ཁྱེད་ཀྱིས་བདག་ལ་ཞི་བདེ་མེད་པར་མཛད་པ་དང་། ། བདག་གིས་དགའ་སྤྲོ་བྱིན་རླབས་ཅི་ཞིག་ཡིན་པ་བརྗེད། །"]},{"type":"verse","number":18,"content":["དེ་བས་བདག་གིས་ང་ཡི་སྟོབས་ཤུགས་ཡོངས་སུ་རྫོགས་པ་དང་། ། ཡ་ཝཱེ་ཁོང་ལས་ཐོབ་པའི་རེ་བ་བདག་དང་བྲལ་ཞེས་སྨྲས། །"]},{"type":"heading","content":["སྙིང་རྗེ་གནང་བར་ཞུས་པ།"]},{"type":"verse","number":19,"content":["བདག་གི་ཉམ་ཐག་ཡུལ་འཁྱམ་དྲན་དུས་སུ། ། དེ་ནི་མཁན་པ་དང་ནི་མཁྲིས་ཁུ་བཞིན། །"]},{"type":"verse","number":20,"content":["ནམ་རྒྱུན་བདག་གིས་འདས་པའི་དོན་དྲན་དུས། ། བདག་གི་སེམས་ནང་སྐྱོ་བས་ཁེངས་པ་འོ། །"]},{"type":"verse","number":21,"content":["ཡིན་ཡང་བདག་གིས་དོན་ཞིག་དྲན་དུས་སུ། ། བདག་གི་ཡིད་སེམས་ནང་དུ་རེ་བ་ཡོད། །"]},{"type":"verse","number":22,"content":["དེ་ནི་ཡ་ཝཱེའི་བྱམས་བརྩེ་ནམ་ཡང་འཇིག་ཡེ་མེད། ། ཁོང་གི་སྙིང་རྗེ་ཇི་སྲིད་བར་དུ་བཞུགས་པར་འགྱུར། །"]},{"type":"verse","number":23,"content":["ཞོགས་པ་རེ་རེར་གསར་པ་ཡིན་པ་བཞིན། ། ཁྱེད་ནི་ཧ་ཅང་བློ་གཏོད་རུང་བ་འོ། །"]},{"type":"verse","number":24,"content":["ང་ཡི་སེམས་སུ་ཡ་ཝཱེ་ཁོང་ནི་བདག་གི་ནོར་སྐལ་ཡིན། ། དེ་བས་བདག་གིས་ཁོང་ལ་རེ་སྒུག་བྱེད་ངེས་ཡིན་ཞེས་སྨྲ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གི་མགོན་སྐྱབས་ལ་སྒུག་པ།"]},{"type":"verse","number":25,"content":["ཁོང་ཉིད་འཚོལ་ཞིང་སེམས་ནས་སྒུག་མཁན་ལ། ། ཡ་ཝཱེས་ཐུགས་རྗེ་གནང་བར་འགྱུར་བ་དང་། །"]},{"type":"verse","number":26,"content":["ལྷིང་འཇགས་ངང་ནས་ཡ་ཝཱེའི་སྐྱབས་ལ་ནི། ། སྒུག་པའི་དོན་དེ་ཅི་འདྲའི་བཟང་བ་ལ། །"]},{"type":"verse","number":27,"content":["མི་ཡིས་ལོ་ན་གཞོན་པའི་དུས་སྐབས་སུ། ། རང་གི་གཉའ་ཤིང་འཁུར་བ་ཅི་འདྲའི་ལེགས། །"]},{"type":"verse","number":28,"content":["ཁོ་རང་གཅིག་པུ་ཁ་རོག་སྡོད་ཅིང་སྨྲ་བ་མེད་པ་དེ། ། ཡ་ཝཱེ་ཁོང་གིས་དེ་ཡི་ལུས་སྟེང་བཞག་པའི་ཕྱིར་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["དེ་ཡིས་རང་གི་སྨྲ་སྒོ་ས་རྡུལ་ནང་། ། སྦས་པར་གྱུར་ན་རེ་བ་ཡོད་ཀྱང་སྲིད། །"]},{"type":"verse","number":30,"content":["དེ་ཡིས་གཞན་པར་རང་ལ་འགྲམ་ལྕག་གཞུ་བཅུག་སྟེ། ། རང་ལ་བརྙས་བཅོས་ཚད་མེད་མྱོང་བར་འཇུག་པ་དང་། །"]},{"type":"verse","number":31,"content":["གཙོ་བོས་མི་རྣམས་རྒྱུན་ནས་རྒྱུན་དུ་འདོར་བར་མི་འགྱུར་ཏེ། །"]},{"type":"verse","number":32,"content":["ཡ་ཝཱེ་ཁོང་གིས་མི་ལ་སྐྱོ་བ་བསྐྱེད་པར་མཛད་ན་ཡང་། ། བྱམས་བརྩེ་ཆེན་པོ་ལྡན་པས་མི་ལ་ཐུགས་རྗེ་གནང་འགྱུར་རོ། །"]},{"type":"verse","number":33,"content":["དེ་ནི་ཁོང་གི་ཐུགས་ལས་མི་ལ་དཀའ་སྡུག་མི་འབྱུང་ཞིང་། ། ཡང་ན་འཇིག་རྟེན་མི་ལ་སྐྱོ་བ་མི་འབྱུང་དགོངས་པའི་ཕྱིར། །"]},{"type":"verse","number":34,"content":["ས་སྟེང་བཙོན་པ་ཐམས་ཅད་རྡོག་བརྫིས་གཏོང་བ་འམ། །"]},{"type":"verse","number":35,"content":["ཡང་ན་བླ་མེད་དྲུང་དུ་དྲང་པོར་བསྙོན་འཛུགས་པ། །"]},{"type":"verse","number":36,"content":["ཞུ་གཏུག་དོན་ཐོག་དཀར་ནག་ལྡོག་གྱུར་ན། ། གཙོ་བོས་ཐམས་ཅད་གཟིགས་པ་མ་ཡིན་ནམ། །"]},{"type":"verse","number":37,"content":["གཙོ་བོའི་ཐུགས་དགོངས་མིན་པར་སུ་ཡིས་སྨྲ་ཞིང་བསྒྲུབ་ནུས་སམ། །"]},{"type":"verse","number":38,"content":["བདེ་སྡུག་ཐམས་ཅད་བླ་མེད་ཞལ་ལས་འོང་བ་མ་ཡིན་ནམ། །"]},{"type":"verse","number":39,"content":["གསོན་པོས་རང་ཉེས་ཁྲིམས་ཆད་འཁུར་ཕྱིར་སྨྲེ་སྔགས་ཅི་ལ་འདོན། །"]},{"type":"verse","number":40,"content":["རང་ཅག་རྣམས་ཀྱིས་སོ་སོའི་སྤྱོད་ལམ་ཡང་ཡང་དུ། ། ཞིབ་བཤེར་ཚོད་ལྟ་བྱས་རྗེས་ཡ་ཝཱེའི་ཕྱོགས་སུ་འཁོར། །"]},{"type":"verse","number":41,"content":["རང་ཅག་རྣམས་ཀྱིས་ལྷག་བསམ་རྣམ་དག་གིས། ། ནམ་མཁར་བཞུགས་པའི་དཀོན་མཆོག་ཁོང་ཕྱོགས་སུ། ། ལག་པ་ཡར་ལ་བཀྱགས་ནས་གསོལ་བ་འདེབས། །"]},{"type":"verse","number":42,"content":["ངེད་ཀྱིས་སྡིག་པ་སྤྱད་ནས་ངོ་ལོག་བྱས་པ་ལ། ། ཁྱེད་ཀྱིས་ཉེས་པ་དེ་དག་སེལ་བར་མི་མཛད་དེ། །"]},{"type":"verse","number":43,"content":["ཁྱེད་རང་ཐུགས་ཁྲོས་བཀབ་པའི་ཕྱིར། ། སྙིང་རྗེ་ཅི་ཡང་མེད་པའི་ངང་། ། ངེད་ཅག་བདས་ཤིང་བསད་པ་འོ། །"]},{"type":"verse","number":44,"content":["ཁྱེད་ཀྱིས་སྤྲིན་ནག་ཕུང་བོས་རང་ཉིད་ཡོངས་སུ་བསྒྲིབས་མཛད་པས། ། ངེད་ཀྱི་ཞུ་གསོལ་ཉིད་ཀྱི་སྙན་ལམ་དུ་ནི་སླེབ་མི་སྲིད། །"]},{"type":"verse","number":45,"content":["ཁྱེད་ཀྱིས་ངེད་རྣམས་མི་སྡེ་ཁྲོད་དུ་སྙིགས་མ་དང་ནི་ཟོག་རོར་མཛད། །"]},{"type":"verse","number":46,"content":["ངེད་ཀྱི་དགྲ་བོ་ཀུན་གྱིས་ངེད་ཅག་ཕྱོགས་སུ་རྒོལ་བར་ཁ་གདངས་པས། །"]},{"type":"verse","number":47,"content":["འཇིགས་སྐྲག་རྒྱ་རྙི་རྩ་མེད་གཏོང་བ་དང་། ། གཏོར་བརླག་བཅས་ནི་ངེད་ཀྱི་སྟེང་ལ་སླེབས། །"]},{"type":"verse","number":48,"content":["བདག་གི་མི་སྡེ་བརླགས་པས་ང་ཡི་མཆི་མ་ཆུ་ལྟར་བཞུར། །"]},{"type":"verse","number":49,"content":["བདག་གི་མིག་ལས་མཆི་མ་བཞུར་བ་རྒྱུན་ཆད་མེད་པར་གྱུར། །"]},{"type":"verse","number":50,"content":["ཡ་ཝཱེས་ནམ་མཁའི་དབྱིངས་ནས་གཟིགས་ཤིང་གཟིགས་པའི་བར་དུ་བཞུར། །"]},{"type":"verse","number":51,"content":["བདག་གི་གྲོང་ཁྱེར་མི་སྡེར་བྱུང་བའི་སྡུག་བསྔལ་མཐོང་བས་ན། ། བདག་གི་སེམས་སུ་སྡུག་བསྔལ་མང་དུ་བསྐྱེད་པར་གྱུར་པ་ཡིན། །"]},{"type":"verse","number":52,"content":["བྱ་དང་བྱིའུ་དེད་ནས་འཛིན་པ་ཇི་བཞིན་དུ། ། དོན་མེད་བདག་གི་དགྲ་ཟླར་གྱུར་པས་ངའི་རྗེས་དེད། །"]},{"type":"verse","number":53,"content":["སྲོག་དང་ཕྲལ་ཕྱིར་དེ་ཚོས་བདག་ནི་དོང་ནང་འཕངས། ། ད་དུང་བདག་གི་ལུས་སྟེང་ཕ་བོང་ཆེན་པོས་མནན། །"]},{"type":"verse","number":54,"content":["ཆུ་ཡིས་མགོ་ནས་བསྣུབས་པས་ང་ནི་འཆིའོ་ཞེས་ངས་སྨྲས། །"]},{"type":"heading","content":["དཀོན་མཆོག་གིས་མགོན་སྐྱབས་གནང་བར་ཞུས་པ།"]},{"type":"verse","number":55,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེ་བདག་གིས་དོང་གི་ཞབས་ངོས་སུ། ། ཁྱེད་ཀྱི་མཚན་ནི་ཡང་ཡང་བརྗོད་ནས་ཞུས་པ་དང་། །"]},{"type":"verse","number":56,"content":["དེ་སྔོན་ཁྱེད་ཀྱིས་བདག་གི་འབོད་སྐད་གསན་ཞིང་གསན་གྱུར་པས། ། ཁྱེད་ཀྱིས་ང་ཡི་སྐྱབས་འཇུག་ཞུ་བའི་སྐད་ལ་གསན་པར་མཛོད། །"]},{"type":"verse","number":57,"content":["ནམ་ཡང་བདག་གིས་ཁྱེད་ཀྱི་ཕྱོགས་སུ་ཞུ་བའི་དུས་སྐབས་སུ། ། ཁྱེད་ཉིད་བདག་གི་ཉེ་སར་ཕེབས་ཏེ་འཇིགས་པར་མི་དགོས་གསུངས། །"]},{"type":"verse","number":58,"content":["གཙོ་བོ་ཁྱེད་ཀྱིས་བདག་ལ་དག་འབུད་མཛད་དེ་ངའི་སྲོག་བསྐྱབས་པ་ཡིན། །"]},{"type":"verse","number":59,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ཁྱེད་ཀྱིས་བདག་གི་ཉེས་འགེལ་གཟིགས་གྱུར་པས། ། ཁྱེད་ཀྱིས་བདག་གི་ཕྱིར་དུ་དྲང་བདེན་ཅན་གྱི་ལམ་མཛོད་ཅིག །"]},{"type":"verse","number":60,"content":["ཁྱེད་ཀྱིས་དེ་ཚོའི་སྡང་ཟུག་སྣ་ཚོགས་གཟིགས་གྱུར་ཅིང་། ། ད་དུང་བདག་ལ་གནོད་པའི་ཇུས་ངན་ཐམས་ཅད་གཟིགས། །"]},{"type":"verse","number":61,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ཁྱེད་ཀྱིས་དེ་ཚོའི་ངན་སྨྲས་རྣམས་གསན་ཞིང་། ། ད་དུང་བདག་ལ་གནོད་པའི་ཇུས་ངན་ཐམས་ཅད་གསན་པར་གྱུར། །"]},{"type":"verse","number":62,"content":["བདག་ལ་རྒོལ་བའི་མི་ཚོའི་སྨྲ་བརྗོད་ཁྱེད་ཀྱིས་གསན་གྱུར་ཅིང་། ། དེ་ཚོས་ཉིན་རེར་བདག་ལ་རྒོལ་བའི་ངན་ཇུས་ཁྱེད་ཀྱིས་མཁྱེན། །"]},{"type":"verse","number":63,"content":["དེ་རྣམས་ས་རུ་འདུག་པའམ་ཡར་ལ་ལང་བ་གང་བྱས་ཀྱང་། ། བདག་ནི་ཀུན་གྱིས་འཕྱ་དགོད་གླུ་ཚིག་གྱུར་པ་ཁྱེད་ཀྱིས་གཟིགས། །"]},{"type":"verse","number":64,"content":["ཡ་ཝཱེ་ཁྱེད་ཀྱིས་ཁོ་ཚོའི་ལག་པས་སྤྱད་པ་བཞིན། ། དེ་དག་ཀུན་ལ་ཉེས་པའི་ལན་ཞིག་འཇལ་བར་མཛོད། །"]},{"type":"verse","number":65,"content":["ཁྱེད་ཀྱིས་ཁོ་ཚོའི་སེམས་ནི་གྱོང་པོར་མཛོད་ཅིག་དང་། ། ཁྱེད་ཀྱི་དམོད་མོ་དེ་དག་སྟེང་དུ་ཐེབས་པར་ཤོག །"]},{"type":"verse","number":66,"content":["ཁྱེད་ཀྱིས་ཁྲོ་གཏུམ་ཆེན་པོས་དེ་དག་བདའ་བར་མཛོད་ཅིག་དང་། ། ཡ་ཝཱེས་སྐྱོང་བའི་གནམ་འོག་ཀུན་ནས་དེ་དག་བརླག་པར་མཛོད། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}