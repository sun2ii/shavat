{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LAM","translationId":"bod_ntb","name":"སྐྱོ་གླུ།","commonName":"སྐྱོ་གླུ།","title":"༄༅།།ཡེ་རེམ་ཡཱའི་སྐྱོ་གླུའི་མདོ།","order":25,"numberOfChapters":5,"sha256":"a3c4ab4752c3530838522d0144a9623265de696ae44ea0c130e64c298df119e5","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bod_ntb/LAM/5.json","totalNumberOfVerses":153},"chapter":{"number":4,"content":[{"type":"heading","content":["འདས་ཟིན་དང་ད་ལྟ་དྲན་ཚེ་དཀའ་སྡུག་འགོག་ཐབས་མེད་པ་འབྱུང་བ།"]},{"type":"verse","number":1,"content":["གསེར་འོད་ཉམས་ཤིང་ལྷད་མེད་གསེར་རྐྱང་ཁ་མདོག་འགྱུར་བ་ཅི། ། དམ་པའི་གནས་ཀྱི་རྡོ་དག་སྲང་ལམ་སོ་སོར་གཏོར་ཏེ་ཡོད། །"]},{"type":"verse","number":2,"content":["ཛ་ཡན་ཡུལ་གྱི་གུས་པར་འོས་པའི་མི་སྡེ་རྣམས། ། སྔོན་ལ་གསེར་རྐྱང་བཞིན་དུ་རྩ་ཆེན་ཡིན་པ་དང་། ། ད་ལྟ་ཅིའི་ཕྱིར་མི་ཡིས་རྫ་ཆས་བཞིན་དུ་ལྟ། ། རྫ་མཁན་ལག་པས་བཟོས་པའི་རྫ་སྣོད་འདྲ་བ་ཅི། །"]},{"type":"verse","number":3,"content":["ཁྱི་སྤྱང་དག་གིས་ནུ་མ་བཏོན་ཏེ་ཕྲུ་གུ་སྐྱོང་ཤེས་ཀྱང་། ། བདག་གི་མི་སྡེ་དབེན་སྟོང་ཡུལ་གྱི་རྔ་བྱ་ཇི་བཞིན་དུ། ། ཅི་འདྲའི་གདུག་རྩུབ་ཆེ་ཞིང་སྙིང་རྗེ་མེད་པར་གྱུར་པ་ཡིན། །"]},{"type":"verse","number":4,"content":["ཕྲུ་གུ་དམར་འབྱར་སྐོམ་ནས་ལྕེ་རྩེ་རྐན་ལ་འབྱར། ། བྱིས་པས་བག་ལེབ་བསླངས་ཀྱང་སྦྱིན་མཁན་གཅིག་ཀྱང་མེད། །"]},{"type":"verse","number":5,"content":["སྔོན་ཆད་མངར་བའི་ཟས་ལ་རོལ་མཁན་ད་ལྟ་ལམ་གྱི་སྤྲང་པོར་གྱུར། ། སྔོན་ཆད་མཚལ་ཁའི་ལྭ་བ་གྱོན་མཁན་ད་ལྟ་སྙིགས་རོ་ནང་དུ་ཉལ། །"]},{"type":"verse","number":6,"content":["བདག་གི་མི་སྡེ་ཀུན་གྱི་སྡིག་པ་ནི། ། སཱ་དོམ་ལས་ཀྱང་ཤིན་ཏུ་ཆེ་བ་དང་། ། སཱ་དོམ་སྐད་ཅིག་ཙམ་དུ་ཕམ་པར་གྱུར། ། དེ་ལ་རོགས་རམ་བྱེད་མཁན་ཡོད་མ་གྱུར། །"]},{"type":"verse","number":7,"content":["དེ་སྔ་ཛ་ཡན་ཡུལ་གྱི་སྐུ་དྲག་ཐམས་ཅད་ནི། ། ཁ་བ་ལས་ཀྱང་གཙང་ལ་འོ་མ་ལས་ཀྱང་དཀར། ། ལུས་པོ་པདྨ་རཱ་ག་ལས་ཀྱང་བཀྲག་མདངས་རྒྱས། ། ཞལ་རས་རིན་ཆེན་སྔོན་པོ་བཞིན་དུ་མཛེས་ཤིང་མཛེས། །"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་ད་ལྟ་དེ་ཚོའི་ངོ་མདོག་སོལ་བ་ལས་ཀྱང་ནག ། སྲང་ལམ་ནང་དུ་དེ་དག་ཤེས་མཁན་གཅིག་ཀྱང་མ་བྱུང་སྟེ། ། དེ་རྣམས་སྐྱི་མོ་རུས་པར་འབྱར་ཏེ་ཤིང་སྐམ་ཇི་བཞིན་གྱུར། །"]},{"type":"verse","number":9,"content":["ལྟོགས་ཤི་ཐེབས་པར་བསྡུར་ན་རལ་གྲིས་བསད་པ་ལེགས་པར་འདུག ། བཀྲེས་ནས་ཤི་བ་དག་ནི་ཞིང་སར་ཐོན་རྫས་མ་བྱུང་བར། ། ལུས་པོ་རིམ་གྱིས་རིད་ཅིང་མཐའ་མར་ཡོངས་སུ་འཇིག་པའི་ཕྱིར། །"]},{"type":"verse","number":10,"content":["བདག་གི་མི་སྡེར་གནོད་པ་ཐེབས་པའི་དུས། ། བྱམས་སེམས་ལྡན་པའི་བུད་མེད་རང་ཉིད་ཀྱིས། ། དངོས་སུ་རང་གི་ཕྲུ་གུ་བཙོས་པ་དང་། ། ཕྲུ་གུ་རྣམས་ནི་ཨ་མའི་ཟས་སུ་གྱུར། །"]},{"type":"verse","number":11,"content":["དེ་ནས་ཡ་ཝཱེ་ཤིན་ཏུ་ཐུགས་ཁྲོས་ཏེ། ། ཉིད་ཀྱི་ཁྲོ་གཏུམ་དེ་དག་སྟེང་དུ་བླུགས། ། ཁོང་གིས་ཛ་ཡན་ཡུལ་དུ་མེ་སྦར་ནས། ། དེ་ཡི་རྩ་བ་ཡོངས་སུ་གཏོར་བ་འོ། །"]},{"type":"verse","number":12,"content":["ས་སྟེང་རྒྱལ་པོ་དང་ནི་ཡུལ་གྱི་མངའ་འབངས་ཐམས་ཅད་ཀྱིས། ། ཡེ་རུ་སཱ་ལེམ་མཁར་སྒོར་དགྲ་བོ་འཛུལ་བར་ཡིད་མ་ཆེས། །"]},{"type":"heading","content":["དཀོན་མཆོག་གིས་དྲང་བདེན་མིན་པའི་འགོ་དཔོན་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":13,"content":["ཛ་ཡན་ལུང་སྟོན་པ་ཡི་སྡིག་པ་དང་། ། མཆོད་དཔོན་དག་གི་ཉེས་པ་ཐམས་ཅད་དེ། ། གྲོང་ཁྱེར་ནང་དུ་དྲང་བདེན་མི་ཀུན་གྱི། ། སྐུ་ཁྲག་བཞུར་དུ་བཅུག་པ་དེའི་རྐྱེན་གྱིས། །"]},{"type":"verse","number":14,"content":["དེ་རྣམས་ལོང་བ་སྲང་ལམ་འཁྱམ་པ་བཞིན། ། དེ་དག་ཁྲག་གིས་བཙོག་པར་བཟོས་པས་ན། ། དེ་ཚོའི་ལྭ་བར་རེག་མཁན་གཅིག་ཀྱང་མེད། །"]},{"type":"verse","number":15,"content":["མི་རྣམས་དག་གིས་ཁོ་ཚོ་ལ། ། མི་གཙང་མི་གཙང་ཁྱོད་ཅག་རྣམས། ། ཕར་སོང་ཕར་སོང་ཞེས་པ་དང་། ། ང་ལ་མ་རེག་ཅེས་ཟེར་ཞིང་། ། དེ་དག་བྲོས་ཤིང་འཁྱམ་པའི་དུས། ། ཡུལ་ཁམས་ཀུན་གྱི་མི་རྣམས་ཀྱིས། ། དེ་དག་ད་ནི་གནས་འདི་རུ། ། སྡོད་པར་མི་རུང་ཞེས་སུ་སྨྲ། །"]},{"type":"verse","number":16,"content":["ཡ་ཝཱེ་ཁོང་གིས་དེ་དག་གཏོར་བར་མཛད། ། དེ་ནས་ཁོ་ཚོར་གཟིགས་སྐྱོང་མ་མཛད་ཅིང་། ། མི་ཡིས་མཆོད་དཔོན་དག་ལ་མ་བཀུར་ཏེ། ། རྒན་པོ་རྣམས་ཀྱང་དྲིན་གྱིས་མ་བསྐྱངས་སོ། །"]},{"type":"verse","number":17,"content":["མིག་གི་དབང་བོ་ཉམས་པར་འགྱུར་བའི་བར། ། རང་ཅག་གིས་ནི་དོན་མེད་རམ་འདེགས་སྒུག ། རང་ཅག་གིས་ནི་རྒྱང་ལྟའི་མཐོ་སྟེགས་སུ། ། བསྐྱབ་ནུས་མེད་པའི་རྒྱལ་ཁབ་ཅིག་ལ་སྒུག །"]},{"type":"verse","number":18,"content":["དགྲ་ཟླས་རང་རེའི་རྗེས་སུ་བསྙེགས་པས་ན། ། བདག་ཅག་རང་གི་སྲང་ལམ་བསྐྱོད་མ་ཕོད། ། བདག་ཅག་མཇུག་འབྲས་དང་ནི་དུས་ཉེ་ཞིང་། ། རང་ཅག་རྣམས་ཀྱི་མཇུག་འབྲས་དངོས་སུ་སླེབས། །"]},{"type":"verse","number":19,"content":["རང་ཅག་སྙེག་མཁན་ནམ་མཁའི་གླག་ལས་མགྱོགས་ཤིང་མྱུར། ། རི་བོ་རྣམས་སུ་ཁོ་ཚོས་རང་རེའི་རྗེས་དེད་ཅིང་། ། ཐང་རྒོད་ཀུན་ཏུ་ཡིབ་ནས་རང་ཅག་རྣམས་ལ་རྒོལ། །"]},{"type":"verse","number":20,"content":["ཡ་ཝཱེས་བྱུགས་པ་",{"noteId":5},"རང་རེའི་སྣ་ཁུང་དབུགས། ། དེ་ཚོའི་དོང་རྙི་ནང་དུ་ཚུད་པ་དང་། ། རང་ཅག་ངེས་པར་ཁོང་གི་བསིལ་གྲིབ་འོག ། ཡུལ་ཁམས་ནང་དུ་གསོན་ཞེས་རང་རེས་སྨྲས། །"]},{"type":"verse","number":21,"content":["ཨེ་དོམ་པ་དང་ཨུ་ཟཱའི་འབངས་མི་རྣམས། ། དགའ་མགུ་དང་ནི་སྤྲོ་བར་གྱིས་ཤིག་དང་། ། ཕོར་བ་",{"noteId":6},"དེ་ནི་ཁྱོད་ཀྱི་གམ་དུ་བརྒྱུད་འོང་ཞིང་། ། ཁྱོད་ནི་ངེས་པར་བཟི་ཞིང་ལུས་པོ་སྒྲེན་མོར་འགྱུར། །"]},{"type":"heading","content":["ཛ་ཡན་ལ་སེམས་གསོ་ཐོབ་པ།"]},{"type":"verse","number":22,"content":["ཀྱེ་ཀྱེ་ཛ་ཡན་ཡུལ་གྱི་བུ་མོ་ལགས། ། ཁྱོད་ལ་ཉེས་ཆད་ཐེབས་པ་རྫོགས་གྱུར་ཏེ། ། ཡ་ཝཱེས་ད་ནི་ཁྱོད་རང་འཁྱམ་མི་འཇུག ། ཀྱེ་ཀྱེ་ཨེ་དོམ་ཡུལ་གྱི་འབངས་མི་རྣམས། ། ཁོང་གིས་ཁྱོད་ཀྱི་སྡིག་པར་ཉེས་ཆད་གཅོད། ། ཁྱོད་ཀྱི་ཉེས་པ་མངོན་པར་འགྱུར་མཛད་དོ། །"]}],"footnotes":[{"noteId":5,"caller":"+","text":"བྱུགས་པ་ཞེས་པ་འདི་ཁོ་རྣམས་ཀྱི་རྒྱལ་པོ་སྟེ་དཀོན་མཆོག་གིས་བསྐོས་པ་དེ་ལ་གོ་ཞིང་། དེ་ནི་ཁོ་རྣམས་འཚོ་བའི་རེ་བ་ཉག་གཅིག་ཡིན་ཏེ་སྲོག་གི་དབུགས་ལྟར་གལ་ཆེ་བ་བརྗོད་པ་ཡིན། རྒྱལ་པོ་ཡོ་ཤི་ཡཱ་སྟེ་ཨེ་ཅིབ་ཀྱི་རྒྱལ་པོས་གཡུལ་སར་བཀྲོངས་པ་དེའམ་ཡང་ན་རྒྱལ་པོ་ཚིད་ཀི་ཡཱ་སྟེ་དཱ་བིད་རིགས་ཀྱི་རྒྱལ་པོ་མཐའ་མ་དེ་ཡིན་པར་སྨྲ།","reference":{"chapter":4,"verse":20}},{"noteId":6,"caller":"+","text":"འདིར་ཕོར་བ་ཞེས་པ་ནི་སྡུག་བསྔལ་ལ་གོ་ཞིང་ཨེ་དོམ་པ་དང་ཨུ་ཟཱའི་འབངས་མི་རྣམས་ཀྱིས་ཀྱང་སྡུག་བསྔལ་མྱོང་བར་འགྱུར་བ་སྟོན་པ་ཡིན།","reference":{"chapter":4,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}