{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":10,"content":[{"type":"heading","content":["ནཱ་དབ་དང་ཨ་བིད་ཧུ་གཉིས་ཀྱི་འཆི་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཨ་རོན་གྱི་བུ་ནཱ་དབ་དང་ཨ་བི་ཧུ་གཉིས་ཀྱིས་རང་གི་སྤོས་ཕོར་ཁྱེར་ནས། དེའི་ནང་དུ་མེ་བཞག་པ་དང་བདུག་སྤོས་ཀྱང་བཏབ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ཚོར་བཀའ་འཁྲོལ་མེད་པའི་མེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཕུལ།"]},{"type":"verse","number":2,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་མེ་ཞིག་བྱུང་ཞིང་དེ་གཉིས་བསྲེགས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཤིའོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ཨ་རོན་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ངའི་གམ་དུ་བཅར་བ་རྣམས་ཀྱི་ཁྲོད་དུ་ང་རང་དམ་པར་མངོན་པ་དང་། མི་ཐམས་ཅད་ཀྱི་མཐོང་ངོར་བདག་ལ་གཟི་བརྗིད་ལྡན་པར་འགྱུར་ཞེས་བཀའ་བསྩལ་པའོ་ཞེས་གསུངས་པར། ཨ་རོན་གྱིས་ངག་བཅད་དེ་བསྡད་དོ། །"]},{"type":"verse","number":4,"content":["མོ་ཤེ་ཡིས་ཨ་རོན་གྱི་ཞང་པོ་ཨུ་ཟི་ཨེལ་གྱི་བུ་མེ་ཤཱ་ཨེལ་དང་ཨེལ་ཙ་ཕཱན་གཉིས་བོས་ནས་ན་རེ། ཚུར་ཤོག་དང་། ཁྱོད་ཀྱི་སྤུན་མཆེད་རྣམས་ཀྱི་བེམ་པོ་གནས་མཆོག་གི་མདུན་ནས་སྒར་ཁའི་ཕྱི་རོལ་ཏུ་ཁྱེར་ཅིག་ཅེས་གསུངས་པ་ན།"]},{"type":"verse","number":5,"content":["དེ་གཉིས་ཚུར་འོངས་ནས། མོ་ཤེ་ཡིས་གསུངས་པ་བཞིན་དུ་བེམ་པོ་ནི་གོས་རིང་དང་བཅས་སྒར་ཁའི་ཕྱི་རོལ་ཏུ་ཁྱེར།"]},{"type":"verse","number":6,"content":["ཡང་མོ་ཤེ་ཡིས་ཨ་རོན་དང་དེའི་བུ་ཨེ་ལི་ཨ་ཟར་དང་ཨི་ཐ་མཱར་བཅས་ལ། ཁྱོད་ཀྱི་མགོ་ཟིང་ནས་སྐྲ་བཤིག་པར་མི་བྱེད་ལ་གོས་རྣམས་ཀྱང་དྲལ་བར་མ་གྱུར་ཅིག ཅི་ལ་ཞེ་ན། ཁྱོད་འཆི་བར་མི་འགྱུར་བ་དང་དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་མི་ཚོགས་ཐམས་ཅད་ལ་ཐུགས་ཁྲོ་བར་མི་འགྱུར་བའི་ཕྱིར་རོ། །འོན་ཀྱང་ཁྱོད་ཀྱི་སྤུན་ཟླ་སྟེ་ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་ཀུན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་མཛད་པའི་མེ་འདི་ཡི་ཕྱིར་དུ་སྨྲེ་ངག་འདོན་ངེས།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་འཆི་བར་མི་འགྱུར་བའི་ཕྱིར་དུ། མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོའི་ཕྱི་རོལ་ཏུ་མ་འགྲོ་ཞིག དཀོན་མཆོག་ཡ་ཝཱེས་བྱུགས་པའི་སྣུམ་ཁྱོད་ཅག་གི་ལུས་སྟེང་དུ་ཡོད་པའི་ཕྱིར་རོ་ཞེས་གསུངས་པས། དེ་དག་གིས་མོ་ཤེའི་བཀའ་བཞིན་དུ་བསྒྲུབས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཨ་རོན་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":9,"content":["ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྣམས་མཇལ་འཕྲད་གུར་མཆོག་གི་ནང་དུ་འོངས་པའི་ཚེ། འཆི་བར་མི་འགྱུར་བའི་ཕྱིར་དུ་རྒུན་ཆང་དང་ཨ་རག་གང་ཡང་བཏུང་བར་མ་བྱེད་ཅིག དེ་ནི་ཁྱོད་ཅག་གི་མི་རབས་ནས་མི་རབས་བར་དུས་གཏན་གྱི་སྒྲིག་ཁྲིམས་ཡིན།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་དམ་པ་དང་ཐ་ཤལ་གཉིས་དང་། གཙང་དང་མི་གཙང་བའི་དབྱེ་བ་འབྱེད་དགོས་ལ།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གསུངས་པའི་སྒྲིག་ཁྲིམས་ཐམས་ཅད་ཁོ་རྣམས་ལ་སློབ་དགོས་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":12,"content":["ཡང་མོ་ཤེ་ཡིས་ཨ་རོན་དང་ཁོའི་གསོན་པོར་ལུས་པའི་བུ་ཨེ་ལི་ཨ་ཟར་དང་ཨི་ཐ་མཱར་གཉིས་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་མེ་མཆོད་ལས་འབྲུ་རིགས་ཀྱི་ལྷག་མ་རྣམས་བླངས་ཏེ། མཆོད་ཁྲིའི་ལོགས་སུ་སྐྱུར་མེད་བག་ལེབ་དེ་ཟོ་ཞིག དེ་ནི་ཀུན་ལས་དམ་པ་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་གནས་དམ་པ་རུ་དེ་བཟའ་དགོས། ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་མེ་མཆོད་ལས་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྣམས་ལ་འཐོབ་འོས་པའི་སྐལ་ཡིན་ལ། ང་ལ་བསྩལ་པའི་བཀའ་ནི་དེ་བཞིན་ཡིན།"]},{"type":"verse","number":14,"content":["གཡོབ་མཆོད་ཀྱི་བྲང་དང་འདེགས་མཆོད་ཀྱི་བརླ་ནི། ཁྱོད་ཀྱིས་རང་གི་བུ་དང་བུ་མོ་རྣམས་དང་མཉམ་དུ་གནས་གཙང་ས་ཞིག་ཏུ་བཟའ་དགོས། དེ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཞི་བདེའི་མཆོད་པ་ལས་ཁྱོད་ལ་དབང་ཞིང་། ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྣམས་ལ་འཐོབ་འོས་པའི་སྐལ་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":15,"content":["ཁོ་རྣམས་ཀྱིས་འདེགས་མཆོད་ཀྱི་བརླ་དང་གཡོབ་མཆོད་ཀྱི་བྲང་། མེ་མཆོད་ཀྱི་ཚིལ་བཅས་ཁྱེར་འོངས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཕར་གཡོ་ཚུར་གཡོ་བྱས་ནས་གཡོབ་མཆོད་དུ་འབུལ་བར་འགྱུར། འདི་ཐམས་ཅད་ཁྱོད་དང་ཁྱོད་ཀྱི་བུ་རྣམས་ལ་དབང་ཞིང་། དུས་གཏན་དུ་འཐོབ་འོས་པའི་སྐལ་ཡིན་ལ། ཐམས་ཅད་དཀོན་མཆོག་ཡ་ཝཱེས་བསྩལ་པའི་བཀའ་བཞིན་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":16,"content":["དེའི་སྐབས་སུ་མོ་ཤེ་ཡིས་གཟབ་ནན་གྱིས་སྡིག་བཤགས་མཆོད་པའི་ར་ཐུག་བཙལ་བ་ན། ལྟོས་དང་། དེ་ནི་བསྲེགས་ཟིན་པས་ཁོང་ཨ་རོན་གྱི་བུ་གསོན་པོར་ལུས་པ་ཨེ་ལི་ཨ་ཟར་དང་ཨི་ཐ་མཱར་གཉིས་ལ་ཁྲོས་ནས་འདི་ལྟར།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཅག་གིས་སྡིག་བཤགས་མཆོད་པ་དེ་གནས་མཆོག་ཏུ་མ་ཟོས་པ་ཅི་ཡིན་ནམ། དེ་ནི་ཀུན་ལས་དམ་པ་ཡིན་ལ། མི་ཚོགས་ཀྱི་ནག་ཉེས་སེལ་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་དྲུང་དུ་དེ་དག་གི་སྡིག་པ་བཤག་པའི་ཕྱིར་དུ་ཁྱོད་རྣམས་ལ་གནང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["ལྟོས་དང་། དམར་མཆོད་དེའི་ཁྲག་ནི་གནས་མཆོག་ཏུ་ཁྱེར་མེད་པས། ཁྱོད་ཅག་གིས་ངའི་བསྒོ་བ་བཞིན་གནས་མཆོག་ཏུ་ཤ་དེ་བཟའ་དགོས་སོ་ཞེས་གསུངས་པ་ལ།"]},{"type":"verse","number":19,"content":["ཨ་རོན་གྱིས་མོ་ཤེ་ལ། ལྟོས་དང་། དེ་རིང་དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྡིག་བཤགས་མཆོད་པ་དང་སྦྱིན་སྲེག་ཕུལ་ནའང་། ང་རང་ཆག་སྒོ་འདི་ལྟ་བུར་ཕྲད་བྱུང་། གལ་སྲིད་དེ་རིང་ངས་སྡིག་བཤགས་མཆོད་པ་འདི་ཟོས་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འོས་སམ་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":20,"content":["མོ་ཤེ་ཡིས་དེ་ཐོས་པ་དང་ལེགས་པར་དགོངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}