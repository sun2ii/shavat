{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":14,"content":[{"type":"heading","content":["པགས་ནད་སོས་རྗེས་གཙང་མར་བཟོ་བའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["མཛེ་ནད་ཕོག་པའི་མི་ཞིག་གཙང་མར་གྱུར་སྐབས་ཀྱི་བཀའ་ཁྲིམས་ནི་འདི་ལྟ་སྟེ། མི་དེ་མཆོད་དཔོན་གྱི་མདུན་དུ་འཁྲིད་དགོས་པ་དང་།"]},{"type":"verse","number":3,"content":["མཆོད་དཔོན་སྒར་ཁའི་ཕྱི་རོལ་ཏུ་སོང་ནས་མཛེ་ནད་ཅན་དེ་ལ་བརྟག་དགོས་ཤིང་། ལྟོས་དང་། གལ་སྲིད་དེའི་མཛེ་ནད་དྲག་པ་ཡིན་ན།"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་གྱིས་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་ཕྱིར་དུ། བྱ་གསོན་པོ་གཙང་མ་གཉིས་དང་ཐང་ཤིང་དང་། སེང་སྐུད་མཚལ་དམར་དང་། ཨི་སོབ་རྩྭ་ཤིང་བཅས་འཁྱེར་འོང་དུ་འཇུག་དགོས།"]},{"type":"verse","number":5,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་རྫ་སྣོད་ནང་གི་ཆུ་དྭངས་མོའི་ཐོག་ཏུ་བྱ་གཅིག་གསོད་དུ་འཇུག་དགོས།"]},{"type":"verse","number":6,"content":["བྱ་གསོན་པོ་དེ་ནི་མཆོད་དཔོན་གྱིས་ཐང་ཤིང་དང་། སེང་སྐུད་མཚལ་དམར་དང་། ཨི་སོབ་རྩྭ་ཤིང་བཅས་དང་མཉམ་དུ་ཆུ་གཙང་མའི་སྟེང་དུ་བསད་པའི་བྱ་དེའི་ཁྲག་ནང་དུ་བསྒྲེས་ནས།"]},{"type":"verse","number":7,"content":["ཁོས་མཛེ་ནད་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་ལུས་སྟེང་དུ་ལན་བདུན་ལ་གཏོར་རྗེས་མི་དེ་གཙང་མ་ཡིན་པར་བསྒྲག་དགོས། དེ་ནས་བྱ་གསོན་པོ་དེ་ཡང་ཐང་ཆེན་དུ་གཏོང་དགོས་སོ། །"]},{"type":"verse","number":8,"content":["གཙང་མར་བཟོ་དགོས་པའི་མི་དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། སྐྲ་སྤུ་ཐམས་ཅད་བཞར་ནས་ལུས་པོ་ཆུས་བཀྲུས་རྗེས་ཁོ་རང་གཙང་མར་གྱུར་པ་ཡིན་ལ། དེ་ནས་ཁོ་སྒར་ཁའི་ནང་དུ་འོང་ཆོག་ཀྱང་། ཉིན་བདུན་ལ་རང་གི་གུར་གྱི་ཕྱི་རུ་འདུག་དགོས།"]},{"type":"verse","number":9,"content":["ཉིན་བདུན་པ་ལ། མི་དེས་རང་གི་སྐྲ་སྤུ་ཐམས་ཅད་དེ། སྐྲ་དང་ཨག་ཚོམ་དང་སྨིན་མ་བཅས་ལུས་ཡོངས་ཀྱི་སྐྲ་སྤུ་ཐམས་ཅད་གཞར་དགོས། དེ་ནས་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུས་རྗེས་གཙང་མར་གྱུར་པའོ། །"]},{"type":"verse","number":10,"content":["ཡང་ཉིན་བརྒྱད་པ་ལ། མི་དེས་སྐྱོན་མེད་པའི་ལུ་གུ་ཕོ་ཅན་གཉིས་དང་མོ་ལུག་ལོ་གཅིག་ཅན་གཅིག འབྲུ་རིགས་ཀྱི་མཆོད་པའི་གྲོ་ཞིབ་སྣུམ་བསྲེས་མ་ཨེ་ཕཱ་བཅུ་ཆ་གསུམ་དང་སྣུམ་ལོ་རྒི་",{"noteId":0},"གཅིག་བཅས་འཁྱེར་འོང་དགོས་ལ།"]},{"type":"verse","number":11,"content":["གཙང་མར་བཟོ་མཁན་མཆོད་དཔོན་གྱིས། གཙང་མར་བཟོ་དགོས་པའི་མི་དེ་རྫས་དེ་དག་དང་མཉམ་དུ་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་འཇོག་དགོས།"]},{"type":"verse","number":12,"content":["མཆོད་དཔོན་གྱིས་ལུ་གུ་ཕོ་ཞིག་ཉེས་སེལ་མཆོད་པར་འབུལ་དགོས་ཞིང་། ཡང་སྣུམ་ལོ་རྒི་གཅིག་བླངས་ནས་དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཕར་གཡོ་ཚུར་གཡོ་བྱས་ཏེ་གཡོབ་མཆོད་དུ་འབུལ་དགོས།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཉེས་སེལ་མཆོད་པ་ནི་སྡིག་བཤགས་མཆོད་པ་ལྟར་མཆོད་དཔོན་ལ་དབང་བ་ཡིན་པས། ལུ་གུ་ཕོ་དེ་སྡིག་བཤགས་མཆོད་པའི་ཕྱུགས་ཟོག་དང་། སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་བཤའ་སའི་གནས་ཏེ་གནས་མཆོག་ཏུ་གསོད་དགོས་ལ། དེ་ནི་ཀུན་ལས་དམ་པ་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["མཆོད་དཔོན་གྱིས་ཉེས་སེལ་མཆོད་པའི་ཁྲག་ཅུང་ཙམ་བླངས་ནས། གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་རྣ་ཤལ་གཡས་པ་དང་། ལག་གཡས་པའི་མཐེ་བོང་དང་རྐང་པ་གཡས་པའི་མཐེབ་ཆེན་བཅས་སུ་འབྱུག་པར་བྱ་བའོ། །"]},{"type":"verse","number":15,"content":["མཆོད་དཔོན་གྱིས་ལོ་རྒི་གཅིག་གི་སྣུམ་དེ་ལས་ཅུང་ཙམ་བླངས་ནས་རང་གི་ལག་གཡོན་པའི་ལག་མཐིལ་དུ་ལྡུག་དགོས་པ་དང་།"]},{"type":"verse","number":16,"content":["ལག་གཡས་པའི་མཛུབ་མོ་རང་གི་ལག་གཡོན་པའི་ལག་མཐིལ་དུ་ཡོད་པའི་སྣུམ་གྱི་ནང་དུ་བསྒྲེས་ནས། མཛུབ་མོས་སྣུམ་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལན་བདུན་གཏོར་དགོས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་ལག་མཐིལ་གྱི་སྣུམ་ལྷག་མ་ཅུང་ཙམ་བླངས་ནས་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་རྣ་ཤལ་གཡས་པ་དང་ལག་གཡས་པའི་མཐེ་བོང་དང་། རྐང་པ་གཡས་པའི་མཐེབ་ཆེན་བཅས་སུ་ཉེས་སེལ་མཆོད་པའི་ཁྲག་བྱུགས་སར་འབྱུག་དགོས།"]},{"type":"verse","number":18,"content":["མཆོད་དཔོན་གྱིས་ལག་མཐིལ་གྱི་སྣུམ་ལྷག་མ་རྣམས་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་མགོར་འབྱུག་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་མི་དེའི་སྡིག་པ་བཤག་དགོས།"]},{"type":"verse","number":19,"content":["ཁོས་སྡིག་བཤགས་མཆོད་པ་ཕུལ་ནས་མི་གཙང་བ་ལས་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་སྡིག་པ་བཤགས་རྗེས། སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་བཤའ་དགོས།"]},{"type":"verse","number":20,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་སྦྱིན་སྲེག་དང་འབྲུ་མཆོད་རྣམས་མཆོད་ཁྲིའི་སྟེང་འབུལ་བ་དང་། ཁོས་མི་དེའི་སྡིག་པ་བཤག་པར་བྱ་ཞིང་། དེ་ནས་མི་དེ་གཙང་མར་གྱུར་ཏོ། །"]},{"type":"verse","number":21,"content":["གལ་སྲིད་མི་དེ་དབུལ་ཞིང་རྒྱུ་ནོར་དེ་ཙམ་མེད་ན། ལུ་གུ་ཕོ་ཞིག་ཉེས་སེལ་མཆོད་པའི་ཕྱིར་འཁྱེར་འོང་བ་དང་། གཡོབ་མཆོད་དུ་ཕུལ་ནས་ཁོའི་སྡིག་པ་བཤག་དགོས། ཡང་འབྲུ་མཆོད་དུ་འབུལ་བའི་གྲོ་ཞིབ་སྣུམ་བསྲེས་མ་བྲེ་ཡི་བཅུ་ཆ་གཅིག་དང་། སྣུམ་ལོ་རྒི་གཅིག་དེ་དང་མཉམ་དུ་འཁྱེར་འོང་དགོས།"]},{"type":"verse","number":22,"content":["ཡང་ཁོས་རང་གི་རྒྱུ་ནོར་འཛོམ་ཚོད་ལྟར་བྱ་ཐི་བ་གཉིས་སམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་ཁྱེར་འོངས་ཏེ། གཅིག་ནི་སྡིག་བཤགས་མཆོད་པ་དང་། ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":23,"content":["ཉིན་བརྒྱད་པར། རང་ཉིད་གཙང་མར་འགྱུར་བའི་ཕྱིར་དུ་ཁོས་དེ་དག་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་ཁྱེར་ནས་མཆོད་དཔོན་ལ་སྤྲོད་དགོས།"]},{"type":"verse","number":24,"content":["མཆོད་དཔོན་གྱིས་ཉེས་སེལ་མཆོད་པའི་ལུ་གུ་དང་། སྣུམ་ལོ་རྒི་གཅིག་པོ་དེ་མཉམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཕར་གཡོ་ཚུར་གཡོ་བྱས་ནས་གཡོབ་མཆོད་དུ་འབུལ་དགོས།"]},{"type":"verse","number":25,"content":["དེ་ནས་ཡང་ཁོས་ཉེས་སེལ་མཆོད་པའི་ལུ་གུ་བཤས་ནས། ཉེས་སེལ་མཆོད་པ་དེའི་ཁྲག་ལས་ཅུང་ཙམ་བླངས་ཏེ། གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་རྣ་ཤལ་གཡས་པ་དང་ལག་གཡས་པའི་མཐེ་བོང་། རྐང་པ་གཡས་པའི་མཐེབ་ཆེན་བཅས་ལ་འབྱུག་པར་བྱའོ། །"]},{"type":"verse","number":26,"content":["མཆོད་དཔོན་གྱིས་སྣུམ་ཅུང་ཙམ་ཞིག་རང་གི་ལག་གཡོན་པའི་ལག་མཐིལ་དུ་བླུགས་ནས།"]},{"type":"verse","number":27,"content":["ལག་གཡས་པའི་མཛུབ་མོས་ལག་གཡོན་པའི་ལག་མཐིལ་དུ་ཡོད་པའི་སྣུམ་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ལན་བདུན་གཏོར་དགོས།"]},{"type":"verse","number":28,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་རང་གི་ལག་མཐིལ་གྱི་སྣུམ་ལས་ཅུང་ཙམ་ཞིག་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་རྣ་ཤལ་གཡས་པ་དང་། ལག་གཡས་པའི་མཐེ་བོང་དང་རྐང་པ་གཡས་པའི་མཐེབ་ཆེན་བཅས་སུ། ཉེས་སེལ་མཆོད་པའི་ཁྲག་བྱུགས་སར་འབྱུག་དགོས།"]},{"type":"verse","number":29,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔ་ནས་མི་དེའི་སྡིག་པ་བཤག་ཕྱིར། མཆོད་དཔོན་གྱིས་རང་གི་ལག་མཐིལ་གྱི་སྣུམ་ལྷག་མ་རྣམས་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་མགོ་ལ་འབྱུག་དགོས་སོ། །"]},{"type":"verse","number":30,"content":["ཡང་མི་དེས་རང་གི་རྒྱུ་ནོར་འཛོམ་ཚོད་ལྟར་བྱ་ཐི་བ་གཉིས་ལས་གཅིག་གམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་ལས་གཅིག་མཆོད་པར་འབུལ་བ་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":31,"content":["ཁོས་རང་གི་འཛོམ་ཚོད་ལྟར། བྱ་གཅིག་ནི་སྡིག་བཤགས་མཆོད་པ་དང་། ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་འབྲུ་མཆོད་དང་ལྷན་ཅིག་འབུལ་དགོས་ལ། དེ་ནས་མཆོད་དཔོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་གཙང་མར་བཟོ་དགོས་པའི་མི་དེའི་སྡིག་པ་བཤག་དགོས།"]},{"type":"verse","number":32,"content":["དེ་ནི་མཛེ་ནད་བྱུང་ཞིང་རྒྱུ་ནོར་མེད་པ་དག་གཙང་མར་བཟོ་དགོས་པའི་བཀའ་ཁྲིམས་ཡིན་ནོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"heading","content":["ཁང་པ་གཡན་སྤུ་ཅན་གཙང་མར་བཟོ་བའི་ཁྲིམས།"]},{"type":"verse","number":33,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":34,"content":["ཁྱོད་ཅག་བདག་གིས་ཁྱོད་རྣམས་ལ་ས་སྐལ་དུ་སྤྲད་པའི་ཀ་ན་ཨན་ཡུལ་དུ་སླེབས་དུས་སུ། བདག་གིས་ཁྱོད་རྣམས་ལ་ས་སྐལ་དུ་སྤྲད་པའི་ཡུལ་དེའི་ཁང་པར་མཛེ་ནད་བྱུང་དུ་བཅུག་ཡོད་ན།"]},{"type":"verse","number":35,"content":["ཁང་བདག་སོང་ནས་མཆོད་དཔོན་ལ། ངས་བལྟས་ན་ཁང་པར་གཡན་སྤུ་སྐྱེས་འདུག་ཅེས་སྨྲ་དགོས།"]},{"type":"verse","number":36,"content":["མཆོད་དཔོན་ཁང་པའི་ནང་བརྟག་དཔྱད་བྱེད་དུ་མ་ཕྱིན་པའི་སྔོན་ལ། ཁང་པའི་ནང་གི་དངོས་པོ་ཡོད་ཚད་བཙོག་པར་མི་འགྱུར་བའི་ཕྱིར། དེ་དག་ལ་ཁང་པའི་ནང་གི་དངོས་པོ་ཆ་ཚང་སྤོ་རུ་འཇུག་དགོས་ལ། དེའི་རྗེས་སུ་མཆོད་དཔོན་ནང་དུ་སོང་ནས་ཁང་པར་བརྟག་དགོས།"]},{"type":"verse","number":37,"content":["ཁོས་གཡན་སྤུ་དེ་ལ་བརྟག་དགོས་ཤིང་། ལྟོས་དང་། ཁང་པའི་རྩིག་ངོས་ཀྱི་གཡན་སྤུ་དེར་མདོག་ལྗང་གུའམ་དམར་པོའི་ཐིག་རིས་ཀོང་ཀོང་ཡོད་ཅིང་། རྟགས་དེ་རྩིག་པའི་ནང་འཐིམ་པ་མཐོང་ན།"]},{"type":"verse","number":38,"content":["མཆོད་དཔོན་ཁང་པའི་སྒོ་ཕྱི་རུ་ཐོན་ཏེ། ཁང་པའི་སྒོ་ཉིན་བདུན་ལ་རྒྱག་དགོས།"]},{"type":"verse","number":39,"content":["ཉིན་བདུན་པར། མཆོད་དཔོན་ཡང་བསྐྱར་སོང་ནས་བརྟག་དགོས་ཤིང་། ལྟོས་དང་། གལ་སྲིད་གཡན་སྤུ་ཁང་པའི་རྩིག་ངོས་སུ་ཁྱབ་པ་མཐོང་ན།"]},{"type":"verse","number":40,"content":["མཆོད་དཔོན་གྱིས་གཡན་སྤུ་སྐྱེས་པའི་རྡོ་རྣམས་ཕྱིར་འདོན་པ་དང་། མཁར་ཕྱིའི་གནས་མི་གཙང་བ་ཞིག་ཏུ་གཡུག་པའི་བཀའ་གནང་དགོས།"]},{"type":"verse","number":41,"content":["ཡང་ཁོས་ཁང་པའི་རྩིག་ངོས་བཞི་པོ་འབྲད་དུ་འཇུག་པ་དང་། བྲད་པའི་འཇིམ་པ་རྣམས་མཁར་ཕྱིའི་གནས་མི་གཙང་བ་ཞིག་ལ་ལྡུག་ཏུ་འཇུག་དགོས།"]},{"type":"verse","number":42,"content":["དེ་ནས་ཁོ་རྣམས་ཀྱིས་རྡོ་གཞན་དག་རྡོ་ཕྱིར་བཏོན་པ་རྣམས་ཀྱི་ཚབ་ཏུ་འཇོག་པ་དང་། འཇིམ་པ་གཞན་གྱིས་ཁང་པའི་ནང་འབྱུག་དགོས་སོ། །"]},{"type":"verse","number":43,"content":["ཁོས་རྡོ་རྣམས་བཏོན་ནས་རྩིག་ངོས་བྲད་པ་དང་། བྱུགས་པའི་རྗེས་སུ་གཡན་སྤུ་ཡང་བསྐྱར་སྐྱེས་ན།"]},{"type":"verse","number":44,"content":["མཆོད་དཔོན་ནང་དུ་སོང་ནས་བརྟག་དགོས་པ་དང་། ལྟོས་དང་། གལ་སྲིད་གཡན་སྤུ་ཁང་པའི་ནང་དུ་ཁྱབ་ཡོད་ན། དེ་ནི་ཁང་པ་རུ་གཡན་སྤུ་བསྟུད་མར་སྐྱེས་པ་ཡིན་པས་མི་གཙང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":45,"content":["ཁོས་ཁང་པ་བཤིགས་ནས་དེའི་རྡོ་དང་ཤིང་ཆ་དང་། འཇིམ་པ་བཅས་ཐམས་ཅད་མཁར་ཕྱིའི་གནས་མི་གཙང་བ་ཞིག་ཏུ་འཁྱེར་དགོས་པ་དང་།"]},{"type":"verse","number":46,"content":["ཁང་པའི་སྒོ་གཏན་པའི་དུས་ཡུན་གང་དང་གང་ལ་དེའི་ནང་དུ་འགྲོ་བའི་མི་ནི་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":47,"content":["ཁང་པའི་ནང་དུ་ཉལ་བའི་མི་དེས་གོས་རྣམས་གཙང་མར་བཀྲུ་དགོས་པ་དང་། ཁང་པའི་ནང་དུ་ཁ་ཟས་ཟ་བའི་མི་དེས་ཀྱང་གོས་རྣམས་གཙང་མར་བཀྲུ་དགོས།"]},{"type":"verse","number":48,"content":["ཁང་པར་འཇིམ་པ་བྱུགས་རྗེས་སུ། མཆོད་དཔོན་ནང་དུ་སོང་ནས་བརྟག་ཅིང་། ལྟོས་དང་། གཡན་སྤུ་ཁང་པའི་ནང་དུ་ཁྱབ་མེད་ན། གཡན་སྤུ་ཚར་བཅད་པས་ཁང་པ་དེ་གཙང་མ་ཡིན་པར་བསྒྲག་དགོས།"]},{"type":"verse","number":49,"content":["ཁོས་ཁང་པར་གཙང་སྦྲ་བྱེད་ཆེད། བྱ་གཉིས་དང་ཐང་ཤིང་དང་སེང་སྐུད་མཚལ་དམར་དང་ཨི་སོབ་རྩྭ་ཤིང་བཅས་ཁྱེར་འོངས་ནས།"]},{"type":"verse","number":50,"content":["བྱ་གཅིག་རྫ་སྣོད་ནང་གི་ཆུ་དྭངས་མོའི་ཐོག་ཏུ་གསོད་དགོས་པ་དང་།"]},{"type":"verse","number":51,"content":["ཐང་ཤིང་དང་ཨི་སོབ་རྩྭ་ཤིང་དང་། སེང་སྐུད་མཚལ་དམར་དང་། བྱ་གསོན་པོ་བཅས་ཐམས་ཅད་བསད་པའི་བྱ་དེའི་ཁྲག་དང་ཆུ་དྭངས་མོའི་ནང་བསྒྲེས་ནས། ཁང་པ་དེ་ལ་ལན་བདུན་གཏོར་དགོས།"]},{"type":"verse","number":52,"content":["དེ་ལྟར་བྱ་ཡི་ཁྲག་དང་ཆུ་དྭངས་མོ་དང་། བྱ་གསོན་པོ་དང་། ཐང་ཤིང་དང་། ཨི་སོབ་རྩྭ་ཤིང་དང་། སེང་སྐུད་མཚལ་དམར་བཅས་ཀྱིས་ཁང་པ་དེར་གཙང་སྦྲ་བྱེད་དགོས།"]},{"type":"verse","number":53,"content":["ཁོས་བྱ་གསོན་པོ་དེ་མཁར་ཕྱིའི་ཐང་ཆེན་དུ་གཏོང་བ་དང་། ཁོས་ཁང་པའི་སྡིག་པ་བཤག་དགོས་ཤིང་དེ་ནས་ཁང་པ་གཙང་མར་གྱུར་པའོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":54,"content":["དེ་ནི་མཛེ་ནད་དང་གཡན་དང་།"]},{"type":"verse","number":55,"content":["གོས་དང་ཁང་པ་རྣམས་ལ་གཡན་སྤུ་སྐྱེས་པ་དང་།"]},{"type":"verse","number":56,"content":["སྐྱི་མོར་སྐྲངས་འབུར་དང་སིབ་རྒྱས་པ་དང་། ཁྲ་ཐིག་ལྷུང་བ་བཅས་ཀྱི་ཕྱིར་ཡིན་ལ།"]},{"type":"verse","number":57,"content":["དུས་ནམ་ཞིག་ལ་གཙང་བ་དང་དུས་ནམ་ཞིག་ལ་མི་གཙང་བའི་དབྱེ་བ་འབྱེད་བྱེད་ཡིན་ཞིང་། དེ་ནི་མཛེ་ནད་ཀྱི་བཀའ་ཁྲིམས་ཡིན་ནོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ལོ་རྒི་གཅིག་ནི་སྤྱི་བྲེ་གཅིག་གི་བཅུ་ཆའི་གསུམ་ཙམ་ཡིན།","reference":{"chapter":14,"verse":10}}]},"thisChapterLink":"/api/bod_ntb/LEV/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/13.json","previousChapterAudioLinks":{},"numberOfVerses":57}