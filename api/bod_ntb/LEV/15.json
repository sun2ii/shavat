{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":15,"content":[{"type":"heading","content":["མིའི་ལུས་ནས་གཤེར་ཁུ་འཛིར་བའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་གཉིས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྒོས་ཤིག གལ་ཏེ་སྐྱེས་པ་ཞིག་གི་ལུས་སུ་རྣག་ནད་བྱུང་ན། ཁོའི་རྣག་ནད་དེ་ནི་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":3,"content":["ཁོ་རང་འཛིར་ནད་ཀྱི་རྐྱེན་གྱིས་མི་གཙང་བར་གྱུར་པ་ནི་འདི་ལྟ་སྟེ། ལུས་ནས་རྣག་བཞུར་བའམ། ཡང་ན་ལུས་ནས་གཤེར་ཁུ་འཛིར་མཚམས་བཞག་པ་གང་ཡིན་ཡང་། ཁོ་རང་མི་གཙང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["རྣག་ནད་བྱུང་བའི་མི་དེ་ཉལ་བའི་མལ་ཁྲི་ཐམས་ཅད་མི་གཙང་བ་དང་། མི་དེ་སྡོད་པའི་དངོས་པོ་གང་ཡིན་ཡང་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":5,"content":["ཡང་མི་དེའི་མལ་ས་ལ་རེག་མཁན་གྱིས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":6,"content":["སུ་ཞིག་རྣག་ནད་ཅན་དེ་བསྡད་མྱོང་བའི་དངོས་པོའི་སྟེང་དུ་བསྡད་ན། དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":7,"content":["སུ་ཞིག་གིས་མི་རྣག་ནད་ཅན་གྱི་ལུས་ལ་རེག་ན། དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":8,"content":["ཡང་རྣག་ནད་ཅན་གྱིས་སུ་ཞིག་ལ་མཆིལ་མ་འཕངས་ན། དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་། དེ་ནི་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":9,"content":["རྣག་ནད་ཅན་དེ་ཞོན་པའི་སྒ་གང་དང་གང་ཡིན་རུང་དེ་ནི་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":10,"content":["མི་དེ་བསྡད་མྱོང་བའི་དངོས་པོ་གང་རུང་ལ་རེག་ན། དེ་ནི་དགོང་མོའི་བར་དུ་མི་གཙང་བ་དང་། དངོས་པོ་དེ་དག་ཁྱེར་བ་ཡིན་ན། མི་དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":11,"content":["ཡང་རྣག་ནད་ཅན་དེས་རང་གི་ལག་པ་ཆུས་མ་བཀྲུས་པར་མི་སུ་ཞིག་ལ་རེག་ན། མི་དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུའི་ནང་དུ་བཀྲུ་དགོས་ཤིང་། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":12,"content":["རྣག་ནད་ཅན་དེས་རེག་པའི་རྫ་སྣོད་གཅོག་དགོས་པ་དང་། དེས་རེག་པའི་ཤིང་གི་སྣོད་ཐམས་ཅད་ཆུ་ཡིས་བཤལ་དགོས།"]},{"type":"verse","number":13,"content":["རྣག་ནད་བྱུང་བའི་མི་དེའི་རྣག་ནད་སོས་པ་ཡིན་ན། དེས་རང་ཉིད་གཙང་མར་བཟོ་བར་ཉིན་བདུན་བརྩིས་ཏེ། རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། ཆུ་གཙང་མས་ལུས་པོ་བཀྲུས་ན་གཙང་མར་གྱུར་པའོ། །"]},{"type":"verse","number":14,"content":["ཡང་ཉིན་བརྒྱད་པ་ལ་ཁོས་བྱ་ཐི་བ་གཉིས་སམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་ཁྱེར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འོངས་ཏེ། མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་བྱ་རྣམས་མཆོད་དཔོན་ལ་སྤྲོད་དགོས་པ་དང་།"]},{"type":"verse","number":15,"content":["མཆོད་དཔོན་གྱིས་དེ་དག་ལས་བྱ་གཅིག་ནི་སྡིག་བཤགས་མཆོད་པ་དང་ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་འབུལ་དགོས་ཤིང་། ཡང་མི་དེའི་རྣག་ནད་ཀྱི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དེའི་སྡིག་པ་བཤག་དགོས་སོ། །"]},{"type":"verse","number":16,"content":["གལ་སྲིད་སྐྱེས་པ་ཞིག་ནས་ཁུ་བ་ཟགས་ན། དེས་རང་གི་ལུས་ཧྲིལ་པོ་ཆུས་བཀྲུ་དགོས་ལ། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":17,"content":["གོས་དང་ཀོ་བ་གང་ཡིན་ཡང་ཁུ་བ་འགོས་ན་དེ་ཆུ་ཡིས་བཀྲུ་དགོས་པ་དང་། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":18,"content":["བུད་མེད་ནི་གལ་སྲིད་སྐྱེས་པ་ཞིག་ལ་ལུས་འབྲེལ་བྱས་ནས་ཁུ་བ་འགོས་ན། དེ་གཉིས་ཀྱིས་རང་གི་ལུས་ཆུ་ཡིས་བཀྲུ་དགོས་ཤིང་། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན་ནོ། །"]},{"type":"heading","content":["ཟླ་མཚན་གྱི་ཁྲིམས།"]},{"type":"verse","number":19,"content":["བུད་མེད་ལ་ཟླ་མཚན་འབབ་པའི་སྐབས་སུ་ལུས་ནས་ཁྲག་འཛིར་ན། ཉིན་བདུན་གྱི་བར་དུ་མི་གཙང་བ་ཡིན། མི་སུ་ཞིག་གིས་ཁོ་མོར་རེག་ཚེ་དེ་ནི་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":20,"content":["ཡང་མི་གཙང་བའི་སྐབས་སུ། བུད་མེད་དེ་ཉལ་བའི་དངོས་པོ་ཐམས་ཅད་མི་གཙང་བ་དང་། གང་གི་སྟེང་དུ་བསྡད་ན་དེ་ཡང་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":21,"content":["སུ་ཞིག་གིས་དེའི་མལ་སར་རེག་ན། དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུ་ནང་བཀྲུ་དགོས་ལ། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":22,"content":["ཡང་སུ་ཞིག་གིས་ཁོ་མོ་བསྡད་པའི་དངོས་པོ་ལ་རེག་ན། རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་ལུས་པོ་ཆུ་ནང་བཀྲུ་དགོས་ལ། དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":23,"content":["མལ་སའམ་མོ་བསྡད་པའི་དངོས་པོ་གང་རུང་ལ་སུ་ཞིག་གིས་རེག་ཚེ། དེ་ནི་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":24,"content":["གལ་སྲིད་སྐྱེས་པ་ཞིག་ཁོ་མོར་ལུས་འབྲེལ་བྱས་ནས་ཁོ་མོའི་མི་གཙང་བ་དེ་ཁོ་ལ་འགོས་ན། དེ་ཡང་ཉིན་བདུན་ལ་མི་གཙང་བ་ཡིན་ཏེ། ཁོ་ཉལ་བའི་མལ་ས་ཡང་མི་གཙང་བ་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["དེ་ཡང་བུད་མེད་ལ་ཟླ་མཚན་འབབ་དུས་བརྒལ་ནས་ཉིན་མང་པོར་ཁྲག་བཞུར་བའམ། ཡང་ན་ཟླ་མཚན་འབབ་དུས་རིང་དྲགས་ན། ཁྲག་འཛིར་བའི་ཉིན་མོ་ཡོངས་ལ་ཁོ་མོ་མི་གཙང་བ་སྟེ། ཟླ་མཚན་འབབ་དུས་ཀྱི་ཉིན་རྣམས་ལ་ཁོ་མོ་མི་གཙང་བ་དང་གཅིག་ཡིན།"]},{"type":"verse","number":26,"content":["ཁྲག་འཛིར་བའི་ཉིན་མོ་རྣམས་ལ། ཁོ་མོ་ཉལ་བའི་མལ་ས་དང་། སྡོད་སའི་དངོས་པོ་གང་ཡིན་རུང་ཐམས་ཅད་མི་གཙང་བ་ཡིན་ཏེ། ཟླ་མཚན་འབབ་དུས་མི་གཙང་བ་དང་གཅིག་ཡིན།"]},{"type":"verse","number":27,"content":["ཡང་དངོས་པོ་དེ་རྣམས་ལ་རེག་མཁན་ནི་མི་གཙང་བ་ཡིན་པས། དེས་རང་གི་གོས་རྣམས་བཀྲུ་བ་དང་། ལུས་པོ་ཆུས་བཀྲུ་དགོས་ལ་དགོང་མོའི་བར་དུ་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":28,"content":["གལ་སྲིད་ཁོ་མོའི་ཁྲག་འཛིར་བ་ཆད་པ་ཡིན་ན། ཉིན་བདུན་བརྩིས་པའི་རྗེས་སུ་ད་གཟོད་གཙང་མར་གྱུར་པའོ། །"]},{"type":"verse","number":29,"content":["ཉིན་བརྒྱད་པ་ལ་ཁོ་མོས་བྱ་ཐི་བ་གཉིས་སམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་ཁྱེར་འོངས་ནས། མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་མཆོད་དཔོན་ལ་སྤྲོད་དགོས།"]},{"type":"verse","number":30,"content":["མཆོད་དཔོན་གྱིས་བྱ་དེ་གཉིས་ལས་གཅིག་ནི་སྡིག་བཤགས་མཆོད་པ་དང་། ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་འབུལ་དགོས་པ་དང་། བུད་མེད་དེའི་ཁྲག་འཛིར་བའི་མི་གཙང་བ་དེའི་རྐྱེན་གྱིས། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཁོ་མོའི་སྡིག་པ་བཤག་དགོས་སོ། །"]},{"type":"verse","number":31,"content":["དེ་བས་ཁྱོད་ཅག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཁོ་ཚོའི་མི་གཙང་བ་རྣམས་ལས་ལོགས་སུ་འགེར་དགོས། དེ་ལྟར་མ་བྱས་ཚེ་དེ་དག་གིས་བདག་གི་གུར་མཆོག་ཁོ་ཚོའི་ཁྲོད་དུ་ཡོད་པ་དེ་བཙོག་པར་བྱ་ཞིང་། ཁོ་རང་ཚོའི་མི་གཙང་བ་དེའི་རྐྱེན་གྱིས་འཆི་ཉེན་ཡོད་ཅེས་པའོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]},{"type":"verse","number":32,"content":["དེ་ནི་འཛིར་ནད་ཕོག་པའི་མིའམ་ཁུ་བ་ཟགས་ནས་མི་གཙང་བར་གྱུར་པ་དང་།"]},{"type":"verse","number":33,"content":["བུད་མེད་ལ་ཟླ་མཚན་འབབ་པའི་དུས་དང་། སྐྱེས་ཕོ་མོར་རྣག་ནད་བྱུང་བ། བུད་མེད་མི་གཙང་བ་དང་ལུས་འབྲེལ་བྱེད་པའི་སྐྱེས་པ་བཅས་ཀྱི་ཕྱིར་དུ་བཙུགས་པའི་བཀའ་ཁྲིམས་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}