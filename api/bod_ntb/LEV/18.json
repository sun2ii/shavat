{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":18,"content":[{"type":"heading","content":["ལོག་གཡེམ་འགོག་པའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྒོས་ཤིག བདག་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན།"]},{"type":"verse","number":3,"content":["ཁྱོད་རྣམས་སྔར་འདུག་སའི་ཨེ་ཅིབ་ཡུལ་གྱི་མི་རྣམས་ཀྱི་སྤྱོད་པ་བཞིན་དུ་བྱེད་མི་རུང་བ་དང་། བདག་གིས་ཁྱོད་ཅག་ཁྲིད་ནས་འགྲོ་ས་ཀ་ན་ཨན་ཡུལ་གྱི་མི་རྣམས་ཀྱི་སྤྱོད་པ་བཞིན་དུ་ཡང་བྱེད་མི་རུང་ལ། དེ་དག་གི་སྒྲིག་ཁྲིམས་བཞིན་དུ་ཡང་སྤྱོད་མི་རུང་ངོ་། །"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་གི་སྲོལ་ཡིག་ལྟར་བྱེད་པ་དང་། བདག་གི་སྒྲིག་ཁྲིམས་རྣམས་བརྩི་སྲུང་བྱེད་དགོས་ཤིང་། བདག་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན།"]},{"type":"verse","number":5,"content":["བདག་གི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་རྣམས་ནན་བསྲུང་བྱས་ན། མི་དེའང་དེ་ལ་བརྟེན་ནས་སྲོག་འཚོ་བར་འགྱུར། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["སུ་ཡིན་ཡང་རང་གི་གཉེན་ཉེའི་གམ་དུ་བཅར་ནས་དེའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་ཀྱིས་རང་གི་ཕ་ལ་གཏོགས་པའི་ལུས་པོ་སྟེ་ཁྱོད་ཀྱི་མ་ཡི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། ཁོ་མོ་ནི་ཁྱོད་ཀྱི་མ་ཡིན་པའི་ཕྱིར་དེའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་ངོ་། །"]},{"type":"verse","number":8,"content":["ཁྱོད་ཀྱིས་ཕ་ཡི་ཆུང་མ་གཅེར་བུར་འཕུད་མི་རུང་། མོའི་ལུས་གཅེར་བུ་དེ་ཁྱོད་ཀྱི་ཕ་ལ་གཏོགས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་ཀྱི་ལྕམ་སྲིང་སྟེ། ཁྱོད་ཀྱི་ཕ་ཡི་བུ་མོ་དང་མ་ཡི་བུ་མོ་ཁྱིམ་ནས་སྐྱེས་པའམ་ཕྱི་ནས་སྐྱེས་པ་གང་ཡིན་ཡང་། དེ་དག་གི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་ངོ་། །"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱི་བུ་ཡི་བུ་མོའམ་བུ་མོའི་བུ་མོ་ཡི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། ཅི་ལ་ཞེ་ན། དེ་དག་གི་ཁོག་སྨད་གཅེར་བུར་ཕུད་པ་ནི་ཁྱོད་ཀྱི་ངོ་ཚ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["ཕ་ཡི་ཆུང་མས་བཙས་པའི་བུ་མོ་ནི་ཁྱོད་ཀྱི་ལྕམ་སྲིང་ཡིན་པས། ཁྱོད་ཀྱིས་ཁོ་མོའི་ཁོག་སྨད་གཅེར་བུར་མ་ཕུད་ཅིག"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱི་ཕ་ཡི་སྲིང་མོའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། དེ་ནི་ཁྱོད་ཀྱི་ཕ་ཡི་ཤ་ཁྲག་ཡིན་པའོ། །"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱི་མ་ཡི་ལྕམ་སྲིང་གི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། དེ་ནི་ཁྱོད་ཀྱི་མ་ཡི་ཤ་ཁྲག་ཡིན་པའོ། །"]},{"type":"verse","number":14,"content":["ཁྱོད་ཀྱི་ཁུ་བོར་དབང་བའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པའམ་དེའི་ཆུང་མའི་ཉེ་སར་བཅར་མི་རུང་སྟེ། ཁོ་མོ་ནི་ཁྱོད་ཀྱི་ཨ་ནེ་ཡིན་པའོ། །"]},{"type":"verse","number":15,"content":["ཁྱོད་ཀྱི་མནའ་མའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། དེ་ནི་ཁྱོད་ཀྱི་བུ་ཡི་ཆུང་མ་ཡིན་པས་དེའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱི་སྤུན་གྱི་ཆུང་མའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། དེ་ནི་ཁྱོད་ཀྱི་སྤུན་ལ་དབང་བའི་ཁོག་སྨད་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["བུད་མེད་ཅིག་དང་དེའི་བུ་མོ་གཉིས་ཀྱི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་ལ། ཡང་དེའི་བུ་ཡི་བུ་མོའམ་བུ་མོའི་བུ་མོ་གཉིས་ཀྱི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་སྟེ། དེ་དག་ནི་ཉེ་འབྲེལ་ཡིན་པ་དང་། དེ་ནི་དོན་ངན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱི་ཆུང་མ་ད་དུང་གསོན་པའི་དུས་སུ། ཁྱོད་ཀྱིས་ཁོ་མོའི་འགྲན་ཟླ་རུ་དེའི་ལྕམ་སྲིང་གཞན་ཞིག་ཆུང་མར་བླངས་ནས། ཁོ་མོའི་ལྕམ་སྲིང་གི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་ངོ་། །"]},{"type":"verse","number":19,"content":["ཟླ་མཚན་འབབ་དུས་ཀྱི་བུད་མེད་མི་གཙང་བའི་ཉེ་སར་བཅར་ནས་ཁོ་མོའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་།"]},{"type":"verse","number":20,"content":["ཁྱིམ་མཚེས་ཀྱི་ཆུང་མ་དང་འགྲོགས་ནས་རང་ཉིད་བཙོག་པར་བྱེད་མི་རུང་།"]},{"type":"verse","number":21,"content":["ཁྱོད་ཀྱིས་རང་གི་བུ་དང་བུ་མོ་རྣམས་མོ་ལེག་ལ་མེ་མཆོད་དུ་འབུལ་མི་རུང་ལ། ཁྱོད་ཀྱི་དཀོན་མཆོག་གི་མཚན་ཡང་ཁྱད་དུ་གསོད་མི་རུང་སྟེ། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["བུད་མེད་དང་ལུས་འབྲེལ་བྱེད་པའི་ཚུལ་བཞིན་དུ་སྐྱེས་པ་དང་ལུས་འབྲེལ་བྱེད་མི་རུང་སྟེ། དེ་ནི་སྐྱུག་བྲོ་བའི་བྱ་སྤྱོད་ཡིན།"]},{"type":"verse","number":23,"content":["སེམས་ཅན་དུད་འགྲོ་དང་འཁྲིག་པ་སྤྱད་དེ་རང་ཉིད་བཙོག་པར་བྱེད་མི་རུང་ལ། བུད་མེད་ཀྱང་སེམས་ཅན་དུད་འགྲོའི་མདུན་དུ་ལངས་ནས་དེ་དང་འཁྲིག་པ་སྤྱོད་མི་རུང་། དེ་ནི་ཕྱིན་ཅི་ལོག་པ་ཡིན་ནོ། །"]},{"type":"verse","number":24,"content":["དོན་འདི་ཐམས་ཅད་ཀྱི་ཐད་ནས་ཁྱོད་རྣམས་ཀྱིས་རང་ཉིད་བཙོག་པར་བྱེད་མི་རུང་སྟེ། ཅི་ལ་ཞེ་ན། བདག་གིས་ཁྱོད་ཅག་གི་མདུན་ནས་ཕར་བསྐྲད་པའི་མི་རྣམས་ཀྱིས་དོན་འདི་མཐའ་དག་གི་ཐད་རང་ཉིད་བཙོག་པར་བཟོས་པའོ། །"]},{"type":"verse","number":25,"content":["ཐ་ན་ཡུལ་དེའང་སྦགས་པ་ཡིན་པས་བདག་གིས་ཡུལ་དེའི་ནག་ཉེས་ལ་ཆད་པ་བཅད་ཅིང་། ཡུལ་དེས་རང་གི་ཡུལ་མི་རྣམས་སྐྱུག་པའོ། །"]},{"type":"verse","number":26,"content":["འོན་ཀྱང་ཁྱོད་ཅག་གིས་བདག་གི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་རྣམས་བསྲུང་དགོས་ཤིང་། གཞིས་སྐྱེས་སམ་ཁྱོད་ཅག་ཁྲོད་དུ་གནས་པའི་བྱེས་པ་རྣམས་སུ་ཡིན་ཡང་། སྐྱུག་བྲོ་བའི་དོན་དེ་ལྟ་བུ་ཅི་ཡང་བྱེད་མི་རུང་།"]},{"type":"verse","number":27,"content":["ཁྱོད་ཅག་གི་སྔོན་དུ་ཡུལ་དེར་གནས་པའི་ཡུལ་མི་རྣམས་ཀྱིས་སྐྱུག་བྲོ་བའི་དོན་དེ་ཐམས་ཅད་བྱས་པས་ཡུལ་དེ་སྦགས་པའོ། །"]},{"type":"verse","number":28,"content":["ཁྱོད་ཀྱིས་དེ་ལྟར་གནས་དེ་མི་གཙང་བར་བཟོས་ན། ཁྱོད་ཀྱི་སྔོན་དུ་ཡོད་པའི་མི་རྣམས་ཡུལ་གྱིས་སྐྱུག་བྲོ་བར་བཟོས་པ་ལྟར། ཁྱོད་རང་སྐྱུག་བྲོ་བར་མི་འགྱུར་བའི་ཕྱིར་དུའོ། །"]},{"type":"verse","number":29,"content":["སུ་ཡིན་ཡང་སྐྱུག་བྲོ་བའི་དོན་དེ་རྣམས་ལས་གཅིག་བྱས་ན། དེ་ནི་མི་མང་ལས་མེད་པར་གཏོང་དགོས།"]},{"type":"verse","number":30,"content":["ཁྱོད་རྣམས་ཀྱིས་སྐྱུག་བྲོ་བའི་གོམས་སྲོལ་དེ་དག་ལ་བསྟུན་ནས། ཁྱོད་ཅག་སྔོན་གྱི་མི་རྣམས་ཀྱིས་ཅི་ཞིག་བྱས་པ་བཞིན་སྤྱད་དེ་རང་ཉིད་བཙོག་པར་མི་བྱ་བའི་ཆེད་དུ། བདག་གི་བསྒོ་བ་རྣམས་བསྲུང་དགོས་ཏེ། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ཞེས་སྨྲ་དགོས་པར་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/17.json","previousChapterAudioLinks":{},"numberOfVerses":30}