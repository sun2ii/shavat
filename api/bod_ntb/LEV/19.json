{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":19,"content":[{"type":"heading","content":["དམ་པ་དང་དྲང་གཞག་གི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ཐམས་ཅད་ལ་འདི་ལྟར་ཤོད་དང་། ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་བདག་ནི་དམ་པ་ཡིན་པའི་ཕྱིར། ཁྱོད་རྣམས་ཀྱང་དམ་པ་ཡིན་དགོས་སོ། །"]},{"type":"verse","number":3,"content":["ཁྱོད་ཅག་མི་རེ་རེས་རང་རང་གི་ཕ་མ་ལ་བསྙེན་བཀུར་བྱེད་དགོས་པ་དང་། བདག་གི་ངལ་གསོ་བའི་ཉིན་མོའང་བསྲུང་དགོས་ལ། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["ལྷ་སྐུ་རྣམས་ཀྱི་ཕྱོགས་སུ་འཁོར་མི་རུང་ལ། རང་ཉིད་ཀྱི་ཕྱིར་དུ་ལྷ་སྐུ་རྣམས་ལྡུག་ཀྱང་མི་རུང་སྟེ། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":5,"content":["དེ་ཡང་ཁྱོད་རྣམས་ཀྱིས་དམར་མཆོད་བཤས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞི་བདེའི་མཆོད་པ་འབུལ་བའི་ཚེ། ཁྱོད་རྣམས་ཁོང་གི་ཐུགས་ལ་ལྡན་པ་ཞིག་ཡིན་པའི་ཕྱིར་འབུལ་དགོས་པ་དང་།"]},{"type":"verse","number":6,"content":["མཆོད་རྫས་དེ་ནི་མཆོད་པར་ཕུལ་བའི་ཉིན་དེ་རང་དང་དེའི་ཕྱི་ཉིན་བཟའ་དགོས་ལ། ཉིན་གསུམ་པའི་བར་དུ་ལུས་པ་རྣམས་མེ་ཡིས་བསྲེག་དགོས་སོ། །"]},{"type":"verse","number":7,"content":["གལ་སྲིད་ཉིན་གསུམ་པར་ཟོས་ན་དེ་ནི་མི་གཙང་དྲི་མས་གོས་པ་ཡིན་པས་ཁོང་གི་ཐུགས་ལ་མི་ལྡན་ཞིང་།"]},{"type":"verse","number":8,"content":["སུ་ཞིག་གིས་དེ་ཟོས་ན་དེས་རང་གི་ནག་ཉེས་འཁུར་དགོས་ཏེ། ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་རྫས་དམ་པ་བསླད་པའི་རྐྱེན་གྱིས་ཁོ་ནི་མི་མང་ལས་མེད་པར་གཏོང་ངེས་སོ། །"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་རང་གི་ས་ཞིང་ནས་སྟོན་ཐོག་བསྡུ་བའི་ཚེ། ས་ཞིང་གྲུ་ཟུར་གྱི་ལོ་ཏོག་བསྡུ་མི་འོས་ལ། སར་ལྷུང་བའི་སྙེ་མ་རྣམས་ཀྱང་བཏུ་མི་རུང་།"]},{"type":"verse","number":10,"content":["རྒུན་འབྲུམ་ར་བ་ལས་རྒུན་འབྲུམ་ཡོད་ཚད་བཏོག་མི་རུང་ལ། རྒུན་འབྲུམ་ར་བར་ས་ལ་ལྷུང་བའི་རྒུན་འབྲུམ་རྣམས་ཀྱང་བཏུ་མི་འོས་ཏེ། དེ་ནི་དབུལ་པོ་དང་བྱེས་པ་རྣམས་ཀྱི་ཕྱིར་དུ་བསྐྱུར་དགོས། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":11,"content":["ཁྱོད་རྣམས་ཀྱིས་རྐུ་བྱེད་མི་རུང་བ་དང་། མགོ་སྐོར་གཏོང་མི་རུང་ལ། ཕན་ཚུན་ལ་རྫུན་ཡང་སྨྲ་མི་རུང་།"]},{"type":"verse","number":12,"content":["བདག་གི་མཚན་དཔང་དུ་བཙུགས་ནས་མནའ་རྫུན་མ་བསྐྱལ་ཏེ་ཁྱོད་ཀྱི་དཀོན་མཆོག་གི་མཚན་ཁྱད་དུ་གསོད་མི་རུང་། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱི་ཁྱིམ་མཚེས་ལ་བཙན་གནོན་བྱེད་མི་རུང་ལ། འཕྲོག་བཅོམ་ཡང་བྱེད་མི་རུང་། གླ་པའི་གླ་ཆ་ནི་ཞོགས་པའི་བར་དུ་ཁྱོད་ཀྱི་ལག་ནས་ལུས་མི་རུང་།"]},{"type":"verse","number":14,"content":["འོན་པ་ལ་དམོད་མོ་འདེབས་མི་རུང་ལ། ལོང་བའི་མདུན་དུ་བཀག་རྡོ་འཇོག་མི་འོས། ཁྱོད་ནི་རང་གི་དཀོན་མཆོག་ལ་གུས་ཤིང་འཇིགས་དགོས་ཏེ། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["ཁྲིམས་ལ་གཏུག་སྐབས་དྲང་གཞག་ཡིན་དགོས་ཤིང་། དབུལ་པོར་ཕྱོགས་ལྷུང་བྱེད་མི་རུང་ལ། དབང་ཤུགས་ཅན་གྱི་ཁ་ངོར་ཡང་བལྟ་མི་རུང་སྟེ། ཅི་ནས་ཀྱང་འདྲ་མཉམ་གྱིས་ཁྱོད་ཀྱི་ཁྱིམ་མཚེས་ལ་དྲང་བདེན་བསྐྱང་དགོས།"]},{"type":"verse","number":16,"content":["མི་མང་གི་ཁྲོད་དུ་གང་སར་དབྱེན་སྦྱོར་རྩོད་སློང་བྱེད་མི་རུང་ལ། ཁྱིམ་མཚེས་ཀྱི་ཚེ་སྲོག་ལ་གནོད་འཚེ་གཏོང་མི་རུང་སྟེ། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱི་སེམས་སུ་རང་གི་སྤུན་ཟླར་སྡང་མི་རུང་། ཁྱོད་ཀྱིས་རང་གི་ཁྱིམ་མཚེས་ཀྱི་རྐྱེན་གྱིས་སྡིག་པ་མི་འབྱུང་བའི་ཕྱིར་དེའི་སྐྱོན་སྟོན་དགོས།"]},{"type":"verse","number":18,"content":["འཁོན་ལན་སློག་མི་རུང་ལ། ཁྱོད་རང་གི་མི་རྣམས་ལ་འཁང་ར་ཡང་བྱེད་མི་རུང་ཞིང་། ཁྱོད་ཀྱིས་ཁྱིམ་མཚེས་ལའང་རང་དང་འདྲ་བར་གཅེས་ཤིག བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":19,"content":["ཁྱོད་ཅག་གིས་བདག་གི་སྒྲིག་ཁྲིམས་བརྩི་སྲུང་བྱེད་དགོས་ཏེ། ཁྱོད་ཀྱི་ཕྱུགས་ཟོག་རྣམས་རིགས་མི་གཅིག་པ་དང་འཁྲིག་ཏུ་འཇུག་མི་རུང་བ་དང་། ཞིང་ལ་རིགས་མི་མཚུངས་པའི་ས་བོན་གཉིས་འདེབས་མི་རུང་ལ། རྒྱུ་གཉིས་ལས་གྲུབ་པའི་གྱོན་པ་ཡང་གོན་མི་རུང་ངོ་། །"]},{"type":"verse","number":20,"content":["གལ་སྲིད་སྐྱེས་པ་ཞིག་བུད་མེད་ཅིག་ལ་འགྲོགས་ནས་འཁྲིག་པ་སྤྱད་ཅིང་། ཁོ་མོ་ནི་བྲན་མོ་ཡིན་ཞིང་སྐྱེས་པ་གཞན་ལ་གཉེན་རྟགས་བརྒྱབ་ཡོད་པ་དང་། ད་དུང་བླུས་མེད་པའམ་རང་དབང་ཐོབ་མེད་པ་ཡིན་ན། ཉེས་ཆད་གཅོད་འོས་པ་ལས་དེ་གཉིས་གསོད་པར་མི་རིགས། ཅི་ལ་ཞེ་ན། བྲན་མོར་ད་དུང་རང་དབང་ཐོབ་མེད་པའོ། །"]},{"type":"verse","number":21,"content":["སྐྱེས་པ་དེས་ཉེས་སེལ་མཆོད་པ་སྟེ་ལུག་ཐུག་ཅིག་དཀོན་མཆོག་ཡ་ཝཱེའི་མདུན་དྲུང་དུ་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་འཁྲིད་འོང་དགོས།"]},{"type":"verse","number":22,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་ཉེས་སེལ་མཆོད་པར་ཕུལ་བའི་ལུག་ཐུག་དེས། མི་དེས་བྱས་པའི་སྡིག་པའི་ཆེད་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་སྡིག་པ་བཤག་དགོས་པ་དང་། དེས་བྱས་པའི་སྡིག་པ་སེལ་བར་ངེས་སོ། །"]},{"type":"verse","number":23,"content":["ཁྱོད་རྣམས་ཀཱ་ན་ཨན་ཡུལ་དུ་སླེབས་ཚེ། སིལ་སྡོང་སྣ་ཚོགས་བཙུགས་ནས་དེ་དག་གི་ཤིང་ཏོག་རྣམས་ཟས་སུ་སྤྱོད་མི་རུང་། ལོ་གསུམ་གྱི་ནང་དུ་ཁྱོད་ཅག་གིས་དེ་བཀོལ་མི་རུང་ལ་བཟའ་ཡང་མི་རུང་ངོ་། །"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་ལོ་བཞི་པར་ཐོགས་པའི་ཤིང་ཏོག་ནི་ཐམས་ཅད་དམ་པ་ཡིན་ལ། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་པ་འབུལ་བའི་མཆོད་པ་ཡིན།"]},{"type":"verse","number":25,"content":["ལོ་ལྔ་པར་ཁྱོད་ཅག་གི་ཆེད་དུ་སིལ་སྡོང་ལ་ཤིང་ཏོག་མང་པོ་ཐོགས་སུ་བཅུག་ནས། ཁྱོད་རྣམས་ཀྱིས་སྡོང་མགོའི་སིལ་ཏོག་རྣམས་བཟའ་དགོས། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":26,"content":["ཁྱོད་ཚོས་ཁྲག་ཡོད་པའི་ཁ་ཟས་ཅི་ཡང་བཟའ་མི་རུང་ཞིང་། ཁྱོད་ཚོས་མོ་འདེབས་མི་རུང་ལ། སྐར་ལྟས་ལའང་བལྟ་མི་རུང་།"]},{"type":"verse","number":27,"content":["ཁྱོད་ཀྱི་སྐྲ་འདབས་བཞར་མི་རུང་བ་དང་། ཨག་ཚོམ་གྱི་མཐའ་ནས་ཀྱང་གཅོད་མི་རུང་།"]},{"type":"verse","number":28,"content":["གཤིན་པོའི་ཕྱིར་དུ་རང་གི་ཤ་གཅོད་མི་རུང་ལ། ལུས་སྟེང་དུ་རི་མོ་གཙགས་མི་རུང་། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["ཁྱོད་ཀྱི་བུ་མོ་སྨད་འཚོང་མ་རུ་བྱས་ནས་སྐྱོན་གྱིས་གོས་པར་བྱེད་མི་རུང་། དེ་ལྟར་བྱས་ན་ཡུལ་འདིས་གཡེམ་སྦྱོར་སྤེལ་ནས་གནས་འདིར་ངན་པས་འགེང་བར་འགྱུར་རོ། །"]},{"type":"verse","number":30,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་གི་ངལ་གསོ་བའི་ཉིན་མོ་རྣམས་བསྲུང་བ་དང་། བདག་གི་གནས་མཆོག་ལ་གུས་ཤིང་འཇིགས་དགོས། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":31,"content":["ལྷ་པ་རྣམས་ཀྱི་ཕྱོགས་སུ་འཁོར་མི་རུང་ལ། མོ་པ་རྣམས་ལ་ཞུ་ཡང་མི་རུང་སྟེ། ཁྱོད་རང་དེ་དག་གིས་བཙོག་པར་མི་བྱེད་པའི་ཕྱིར་ཡིན། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":32,"content":["མགོ་སྐྲ་དཀར་པོར་གྱུར་པའི་མདུན་ནས་ཡར་ལངས་པ་དང་། བགྲེས་པོ་ཚོར་གུས་བཀུར་བྱེད་དགོས། ཁྱོད་ཀྱི་དཀོན་མཆོག་ལ་གུས་ཤིང་འཇིགས་པར་གྱིས། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":33,"content":["གལ་སྲིད་ཕྱི་རོལ་གྱི་མི་ཞིག་ཁྱོད་ཅག་གི་ཡུལ་ནས་ཁྱོད་དང་མཉམ་དུ་གནས་བཅས་ན་དེ་ལ་ཐུབ་ཚོད་བྱེད་མི་རུང་།"]},{"type":"verse","number":34,"content":["ཁྱོད་ཅག་གི་ཡུལ་ནས་བྱེས་སུ་སྡོད་པའི་ཕྱི་མི་ལ། ཁྱོད་རྣམས་ཀྱིས་གཞིས་སྐྱེས་པའི་ལྟ་སྟངས་འཛིན་པར་མ་ཟད། རང་ཉིད་ལ་གཅེས་པ་བཞིན་དེ་ཡང་གཅེས་སུ་འཛིན་དགོས། ཅི་ལ་ཞེ་ན། ཁྱོད་རྣམས་ཀྱང་ཨེ་ཅིབ་ཡུལ་དུ་བྱེས་སུ་བསྡད་མྱོང་བས་སོ། །བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":35,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྲིམས་ཐག་གཅོད་པའི་སྐབས་སུ། རིང་ཐུང་ཚད་པ་དང་ལྕི་ཡང་འཇལ་བ། ཤོང་ཚད་འཇལ་བ་བཅས་ལ་གཡོ་སྒྱུ་བྱེད་མི་རུང་།"]},{"type":"verse","number":36,"content":["ཁྱོད་རྣམས་ཀྱིས་དྲང་གཞག་གི་རྒྱ་སྲང་དང་དྲང་གཞག་གི་རྒྱ་རྡོ་དང་། དྲང་གཞག་གི་ཨེ་ཕཱ་དང་། དྲང་གཞག་གི་རྫ་བུམ་བཅས་བཀོལ་དགོས། བདག་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ལ། སྔར་ཁྱོད་ཅག་ཨེ་ཅིབ་ཡུལ་ནས་ཕྱི་རུ་ཁྲིད་འོངས་པ་ཡིན།"]},{"type":"verse","number":37,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་གི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་ཐམས་ཅད་བརྩི་སྲུང་བྱས་ནས་དེ་བཞིན་དུ་སྒྲུབས་ཤིག བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ་ཞེས་སྨྲ་དགོས་པར་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/18.json","previousChapterAudioLinks":{},"numberOfVerses":37}