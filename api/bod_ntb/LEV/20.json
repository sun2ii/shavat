{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":20,"content":[{"type":"heading","content":["ཉེས་ཆད་གཅོད་པའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར། ཡེས་ར་ཨེལ་པ་དང་ཡེས་ར་ཨེལ་གྱི་ཁྲོད་དུ་བྱེས་སུ་སྡོད་པའི་ཕྱི་མི་སུ་ཡིན་ཡང་། རང་གི་བུ་རྒྱུད་མོ་ལེག་ལ་མཆོད་པར་བྱེད་ན་དེ་ནི་གསོད་དགོས། ཡུལ་མི་རྣམས་ཀྱིས་རྡོ་རུབ་བཏང་ནས་གསོད་དགོས་པ་དང་།"]},{"type":"verse","number":3,"content":["མི་དེ་ལ་བདག་གི་གདོང་མདོག་ཀྱང་ལོག་སྟེ་ཁོ་རང་མི་མང་ཁྲོད་ནས་མེད་པར་གཏོང་བར་བྱ། གང་ལ་ཞེ་ན། ཁོས་རང་གི་བུ་རྒྱུད་མོ་ལེག་ལ་ཕུལ་ནས། བདག་གི་གནས་མཆོག་སྦགས་པ་དང་བདག་གི་མཚན་དམ་པ་ཁྱད་དུ་བསད་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":4,"content":["གལ་སྲིད་མི་དེས་བུ་བུ་མོ་རྣམས་མོ་ལེག་ལ་ཕུལ་བ་དང་། ཡུལ་མི་རྣམས་ཀྱིས་དེ་མ་མཐོང་ཁུལ་བྱས་ཏེ་མི་དེ་མི་གསོད་ན།"]},{"type":"verse","number":5,"content":["མི་དེ་དང་དེའི་ཁྱིམ་མི་ལ་བདག་གི་གདོང་མདོག་ལོག་ཅིང་། མི་དེ་དང་དེའི་རྗེས་སུ་འབྲངས་ནས་མོ་ལེག་དང་ལོག་གཡེམ་བྱེད་པ་ཐམས་ཅད་མི་མང་ལས་མེད་པར་གཏོང་བར་བྱའོ། །"]},{"type":"verse","number":6,"content":["མི་སུ་ཞིག་མོ་པ་དང་ལྷ་པ་རྣམས་ཀྱི་ཕྱོགས་སུ་འཁོར་བ་དང་། དེ་དག་གི་རྗེས་སུ་འབྲངས་ནས་ལོག་གཡེམ་བྱེད་པ་ཡིན་ན། མི་དེ་ལ་བདག་གི་གདོང་མདོག་ལོག་ཅིང་ཁོ་རང་མི་མང་ལས་མེད་པར་གཏོང་བར་བྱའོ། །"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་རང་ཉིད་དམ་པར་བྱོས་ལ་དམ་པར་སྒྱུར་ཅིག ཅི་ལ་ཞེ་ན། བདག་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":8,"content":["ཁྱོད་ཅག་གིས་བདག་གི་སྒྲིག་ཁྲིམས་བརྩི་སྲུང་བྱས་ནས་དེ་བཞིན་དུ་བྱོས་ཤིག བདག་ནི་ཁྱོད་ཅག་དམ་པར་བཟོ་བའི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན།"]},{"type":"verse","number":9,"content":["གལ་ཏེ་རང་གི་ཕ་མ་ལ་དམོད་མོ་འདེབས་མཁན་ཡོད་ན་དེ་གསོད་དགོས། སུས་ཕ་མ་ལ་དམོད་མོ་གཏོང་ན། དེའི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས་སོ། །"]},{"type":"verse","number":10,"content":["གཞན་གྱི་ཆུང་མ་སྟེ་རང་གི་ཁྱིམ་མཚེས་གྱི་ཆུང་མ་དང་ལོག་གཡེམ་བྱེད་མཁན་སུ་ཡིན་ཡང་། འཆལ་པོ་འཆལ་མོ་གཉིས་ཀ་གསོད་དགོས།"]},{"type":"verse","number":11,"content":["སུ་ཞིག་རང་གི་ཕ་ཡི་ཆུང་མ་དང་ལུས་འབྲེལ་བྱེད་པ་སྟེ། རང་གི་ཕ་ཡི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པ་ཡིན་ན། དེ་གཉིས་ཀ་གསོད་དགོས་ལ། དེ་གཉིས་ཀའི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས་པ་ཡིན།"]},{"type":"verse","number":12,"content":["སུ་ཞིག་རང་གི་མནའ་མ་དང་ལུས་འབྲེལ་བྱེད་ན་དེ་གཉིས་ཀ་གསོད་དགོས། དེ་དག་གིས་གཉེན་ཚན་བར་འཁྲིག་པ་སྤྱད་པ་ཡིན་པས། ཁོ་ཚོའི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས།"]},{"type":"verse","number":13,"content":["སྐྱེས་པ་ཞིག་བུད་མེད་ལ་ལུས་འབྲེལ་བྱེད་པའི་ཚུལ་བཞིན་དུ་ཕོ་དང་ལུས་འབྲེལ་བྱས་ན། དེ་གཉིས་ཀྱིས་སྐྱུག་བྲོ་བའི་ལས་བྱས་པ་ཡིན་པས་གསོད་དགོས། དེ་དག་གི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས།"]},{"type":"verse","number":14,"content":["སྐྱེས་པ་ཞིག་གིས་ཆུང་མ་བླངས་པ་དང་། ཆུང་མའི་མ་ཡང་བླངས་ན་དེ་ནི་ལོག་སྤྱོད་ཡིན་པས། མི་དེ་གསུམ་པོ་མེ་ཡིས་བསྲེགས་ནས། ཁྱོད་ཚོའི་ཁྲོད་ནས་ལོག་སྤྱོད་མེད་པར་བཟོ་དགོས།"]},{"type":"verse","number":15,"content":["སུ་ཞིག་གིས་ཕྱུགས་ཟོག་རིགས་དང་འཁྲིག་པ་སྤྱད་ན་མི་དེ་གསོད་དགོས་ལ། ཕྱུགས་ཟོག་དེ་ཡང་གསོད་དགོས།"]},{"type":"verse","number":16,"content":["བུད་མེད་ཅིག་ཕྱུགས་ཟོག་རིགས་ཀྱི་ཉེ་སར་བཅར་ནས་དེ་དང་འཁྲིག་པ་སྤྱད་ན། ཁྱོད་ཀྱིས་བུད་མེད་དང་ཕྱུགས་ཟོག་གཉིས་ཀ་གསོད་དགོས། དེ་དག་ངེས་པར་གསོད་དགོས་ལ། དེ་དག་གི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས་པའོ། །"]},{"type":"verse","number":17,"content":["སུ་ཞིག་གིས་རང་གི་ལྕམ་སྲིང་སྟེ། ཕ་ཡི་བུ་མོའམ་ཡང་ན་མ་ཡི་བུ་མོ་ཆུང་མར་བླངས་ཏེ། ཕན་ཚུན་གྱི་ཁོག་སྨད་མཐོང་བ་ཡིན་ན་དེ་ནི་ངོ་ཚ་དགོས་པའི་དོན་ཡིན་པས། དེ་གཉིས་ཀ་རང་གི་མི་རྣམས་ཀྱི་མཐོང་ངོར་རྩ་མེད་དུ་གཏོང་དགོས། དེས་རང་གི་ལྕམ་སྲིང་གི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པ་ཡིན་པས་ཉེས་པ་འཁུར་དགོས་པའོ། །"]},{"type":"verse","number":18,"content":["གལ་ཏེ་སུ་ཞིག་ཟླ་མཚན་འབབ་དུས་ཀྱི་བུད་མེད་དང་ལུས་འབྲེལ་བྱས་ནས། ཁོ་མོའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པ་དང་། ཁོ་མོའི་ཁྲག་ཁུངས་དམར་རྗེན་དུ་བཏོན་ཏེ། ཁོ་མོས་ཀྱང་རང་གི་ཁྲག་ཁུངས་མངོན་པ་ཡིན་ན། དེ་གཉིས་ཀ་རང་གི་མི་མང་ལས་མེད་པར་གཏོང་དགོས།"]},{"type":"verse","number":19,"content":["མ་ཡི་ལྕམ་སྲིང་དང་ཕ་ཡི་ལྕམ་སྲིང་གི་ཁོག་སྨད་གཅེར་བུར་འཕུད་མི་རུང་། དེ་ནི་རང་གི་གཉེན་ཉེ་གཅེར་བུར་འཕུད་པ་ཡིན་པས། ཁོ་ཚོས་རང་གི་ནག་ཉེས་འཁུར་དགོས་སོ། །"]},{"type":"verse","number":20,"content":["གལ་ཏེ་སུ་ཞིག་ཁུ་བོའི་ཆུང་མ་དང་ལུས་འབྲེལ་བྱས་ན། དེ་ནི་རང་གི་ཁུ་བོའི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པ་ཡིན་པས། དེ་ཚོས་རང་གི་སྡིག་པ་འཁུར་དགོས་ལ་བུ་ཕྲུག་མེད་པར་འཆི་ངེས་ཡིན།"]},{"type":"verse","number":21,"content":["ཡང་སུ་ཞིག་གིས་རང་གི་སྤུན་གྱི་ཆུང་མ་བླངས་ན་དེ་ནི་སྤུན་གྱི་ཁོག་སྨད་གཅེར་བུར་འཕུད་པ་ཡིན་ལ། དེ་ནི་འཆལ་སྤྱོད་ཡིན་པས་ཁོ་ཚོར་བུ་ཕྲུག་མེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":22,"content":["ཁྱོད་ཚོས་བདག་གི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་ཐམས་ཅད་སྲུང་བརྩི་བྱས་ནས་དེ་བཞིན་བྱོས་ཤིག དེ་ནས་བདག་གིས་ཁྱོད་རྣམས་ཁྲིད་དེ་གནས་པར་འགྱུར་བའི་ཡུལ་དེས་ཁྱོད་ཅག་སྐྱུག་པར་མི་བྱའོ། །"]},{"type":"verse","number":23,"content":["ཁྱོད་རྣམས་ནི་བདག་གིས་ཁྱོད་ཅག་གི་མདུན་ནས་བསྐྲད་པའི་མི་རྣམས་ཀྱི་ལུགས་སྲོལ་གྱི་རྗེས་སུ་འབྲང་མི་རུང་སྟེ། ཅི་ལ་ཞེ་ན། དེ་དག་གིས་དོན་མི་ལེགས་པ་དེ་ཐམས་ཅད་བྱས་པས་བདག་ནི་དེ་དག་ལ་ཞེན་པ་གཏིང་ནས་ལོག་ཡོད།"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་ཚོ་ལ། དེ་དག་གི་ཡུལ་ནི་ཁྱོད་རྣམས་ཀྱིས་རྒྱུན་འཛིན་བྱེད་པ་དང་། བདག་གིས་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་དེ་ཁྱོད་ཅག་ལ་བགོ་སྐལ་དུ་སྟེར་བར་བྱ་ཞེས་སྨྲས་ཡོད། བདག་ནི་ཁྱོད་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ། ཁྱོད་རྣམས་མི་ཐམས་ཅད་ལས་སོ་སོར་འགེར་མཁན་དེ་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["ཁྱོད་རྣམས་ཀྱིས་འདབ་ཆགས་དང་སེམས་ཅན་དུད་འགྲོ་གཙང་མི་གཙང་གི་དབྱེ་བ་འབྱེད་དགོས་པ་དང་། བདག་གིས་མི་གཙང་བར་སོ་སོར་ཕྱེས་པའི་འདབ་ཆགས་དང་སེམས་ཅན་དུད་འགྲོའམ། ཡང་ན་ས་སྟེང་གི་ལྟོ་འགྲོ་སྲོག་ཆགས་གང་དང་གང་གི་རྐྱེན་གྱིས་རང་ཉིད་སྐྱུག་བྲོ་བར་བཟོ་མི་རུང་།"]},{"type":"verse","number":26,"content":["ཡ་ཝཱེ་ང་རང་ནི་དམ་པ་ཡིན་པའི་ཕྱིར། ཁྱོད་ཀྱང་བདག་གི་ཆེད་དུ་དམ་པ་ཡིན་དགོས། བདག་གིས་ཁྱོད་ཅག་བདག་གི་ཡིན་པའི་རྐྱེན་གྱིས་མི་ཐམས་ཅད་ལས་སོ་སོར་བཀར་བ་ཡིན་ནོ། །"]},{"type":"verse","number":27,"content":["ཡང་མོ་པ་དང་ལྷ་པ་ནི་སྐྱེས་ཕོ་མོ་སུ་ཡིན་ཡང་གསོད་དགོས་ལ། མི་ཡིས་རྡོ་རུབ་བཏང་སྟེ་གསོད་དགོས་པ་དང་། དེ་དག་གི་སྟེང་ནས་ཁྲག་ལན་འཇལ་དགོས་ཞེས་སྨྲོས་ཤིག་ཅེས་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/19.json","previousChapterAudioLinks":{},"numberOfVerses":27}