{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":21,"content":[{"type":"heading","content":["མཆོད་དཔོན་དམ་པར་འགྱུར་བའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཨ་རོན་གྱི་བུ་རྒྱུད་ལས་མཆོད་དཔོན་ཡིན་པ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག མཆོད་དཔོན་གྱིས་རང་གི་མི་མང་ཁྲོད་ཀྱི་འདས་པོའི་ཕྱིར་དུ་རང་ཉིད་སྦག་མི་རུང་།"]},{"type":"verse","number":2,"content":["དེ་ཡང་རང་གི་རྩ་བའི་གཉེན་ཉེ་སྟེ། ཁོའི་ཕ་མ་དང་། བུ་བུ་མོ་དང་། སྤུན་མཆེད་དང་།"]},{"type":"verse","number":3,"content":["ཡང་ན་ད་དུང་གནས་ལ་མ་སོང་བའི་ན་ཆུང་བུ་མོ་སྟེ་ལྕམ་སྲིང་ཡིན་པ་བཅས་ནི་འཕུད་དགོས། དེ་ནི་ཁོའི་ལྕམ་སྲིང་ཡིན་པའི་རྐྱེན་གྱིས་རང་ཉིད་མི་གཙང་བར་བྱས་ཆོག"]},{"type":"verse","number":4,"content":["མཆོད་དཔོན་ནི་རང་གི་མི་མང་ཁྲོད་ཀྱི་འགོ་དཔོན་ཡིན་པས། རང་ཉིད་སྦགས་ནས་མི་གཙང་བར་བྱེད་མི་རུང་ངོ་། །"]},{"type":"verse","number":5,"content":["མགོ་སྤྱི་ཐེར་དུ་གཏོང་བ་དང་ཨག་ཚོམ་གྱི་སྣེ་མོ་གཅོད་མི་རུང་ལ། རང་ལུས་ཀྱི་ཤ་སྐྱི་གང་ཡང་གཅོད་མི་རུང་།"]},{"type":"verse","number":6,"content":["ཁོ་རྣམས་ནི་དཀོན་མཆོག་གི་ཆེད་དུ་དམ་པ་ཡིན་དགོས་ལ། རང་གི་དཀོན་མཆོག་གི་མཚན་ཁྱད་དུ་གསོད་མི་རུང་། དཀོན་མཆོག་ཡ་ཝཱེའི་མེ་མཆོད་དེ་དཀོན་མཆོག་གི་ཞལ་ཟས་ནི་ཁོ་རྣམས་ཀྱིས་འདྲེན་པ་ཡིན་པས། ཁོ་ཚོ་ནི་དམ་པ་ཡིན་དགོས་སོ། །"]},{"type":"verse","number":7,"content":["མཆོད་དཔོན་གྱིས་སྨད་འཚོང་མ་དང་ཡང་ན་གཞན་གྱིས་སྦགས་པའི་བུད་མེད་ནི་ཆུང་མར་ལེན་མི་རུང་ལ། ཁྱོ་གས་ཕྱི་ལ་སྤྱུགས་པའི་བུད་མེད་ཀྱང་ཆུང་མར་ལེན་མི་རུང་། ཅི་ལ་ཞེ་ན། ཁོ་ནི་རང་གི་དཀོན་མཆོག་གི་ཆེད་དུ་དམ་པ་ཡིན་པས་སོ། །"]},{"type":"verse","number":8,"content":["མཆོད་དཔོན་གྱིས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ལ་ཞལ་ཟས་འདྲེན་པས་ཁྱོད་ཀྱིས་ཁོ་ནི་དམ་པར་བཟོ་དགོས། ཁྱོད་ཀྱིས་མཆོད་དཔོན་དམ་པར་བརྩི་དགོས་ཏེ། ཅིའི་ཕྱིར་ཞེ་ན། བདག་ནི་ཁྱོད་རྣམས་དམ་པར་བཟོ་བའི་དཀོན་མཆོག་ཡ་ཝཱེ་དང་དམ་པ་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":9,"content":["མཆོད་དཔོན་གྱི་བུ་མོ་སྨད་འཚོང་མ་བྱས་ནས་རང་ཉིད་སྦགས་ན། རང་གི་ཕ་བཙོག་པར་བཟོས་པ་ཡིན་པས་ཁོ་མོ་མེས་བསྲེག་དགོས་སོ། །"]},{"type":"verse","number":10,"content":["སྤུན་ཟླ་ཚོའི་ཁྲོད་ནས་མཆོད་དཔོན་ཆེན་པོ་བྱེད་པ་སྟེ། མགོ་ལ་འབྱུག་སྣུམ་བླུགས་པ་དང་། ལས་འགན་དམ་པ་རྒྱུན་འཛིན་བྱས་ཤིང་འཕགས་གོས་མནབས་པ་དེས། མགོ་ཟིང་ནས་སྐྲ་བཤིག་པར་མི་བྱེད་པ་དང་གོས་ཀྱང་གཤག་མི་རུང་།"]},{"type":"verse","number":11,"content":["བེམ་པོ་གང་ཡིན་ཡང་དེའི་ཉེ་སར་བཅར་མི་རུང་སྟེ། རང་གི་ཕ་མའི་ཆེད་དུ་ཡང་རང་ཉིད་སྦག་མི་རུང་ངོ་། །"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་གི་གནས་མཆོག་འབག་པར་མི་བྱེད་པའི་ཕྱིར་དུ། མཆོད་དཔོན་ཆེན་པོ་གནས་མཆོག་གི་ཕྱི་རུ་འགྲོ་མི་རུང་སྟེ། ཁོའི་ལུས་སྟེང་དུ་དཀོན་མཆོག་གི་འབྱུག་སྣུམ་དམ་པ་ཡོད་པའི་རྐྱེན་གྱིས། དཀོན་མཆོག་གི་གནས་མཆོག་འབག་པར་མི་བྱེད་དེ། གནས་མཆོག་གི་ཕྱི་རུ་འགྲོ་མི་རུང་། བདག་ནི་ཡ་ཝཱེ་ཡིན་ནོ། །"]},{"type":"verse","number":13,"content":["ཁོས་ན་ཆུང་བུ་མོ་ཆུང་མར་ལེན་དགོས་ཏེ།"]},{"type":"verse","number":14,"content":["མཆོད་དཔོན་ཆེན་པོས་ཡུགས་མོ་དང་ཁྱོ་གས་ཕྱི་ལ་སྤྱུགས་པའི་བུད་མེད་དང་། ཡང་ན་གཞན་གྱིས་སྦགས་པའི་སྨད་འཚོང་མ་བཅས་ནི་ཆུང་མར་ལེན་མི་རུང་། ཁོས་རང་གི་མི་མང་ཁྲོད་ཀྱི་ན་ཆུང་བུ་མོ་འབའ་ཞིག་ཆུང་མར་ལེན་དགོས།"]},{"type":"verse","number":15,"content":["ཁོས་རང་གི་མི་རིགས་ཀྱི་ཁྲོད་དུ་རང་གི་བུ་རྒྱུད་བཙོག་པར་བཟོ་མི་རུང་། ཅི་ལ་ཞེ་ན། བདག་ནི་ཁོ་རང་དམ་པར་བཟོ་མཁན་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ཞེས་པའོ་གསུངས་སོ།།"]},{"type":"verse","number":16,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་ཨ་རོན་ལ་འདི་ལྟར་སྒོས་ཤིག ཁྱོད་ཀྱི་རིགས་རྒྱུད་ལས་མི་རབས་ནས་མི་རབས་བར། དབང་བོ་སྐྱོན་ཅན་སུ་ཡིན་ཡང་ཚུར་འོངས་ནས་སོ་སོའི་དཀོན་མཆོག་ལ་ཞལ་ཟས་འདྲེན་མི་རུང་།"]},{"type":"verse","number":18,"content":["ཅི་ལ་ཞེ་ན། དབང་བོ་སྐྱོན་དང་ལྡན་པ་ནི། ལོང་བའམ། ཞ་བོའམ། ཁ་ངོ་སྐྱོན་ཅན་ནམ། ཡན་ལག་གཅིག་རིང་དྲགས་པའམ།"]},{"type":"verse","number":19,"content":["རྐང་པའམ་ལག་པར་ཆག་གྲུམ་ཤོར་བའམ།"]},{"type":"verse","number":20,"content":["སྒུར་པོ་དང་། མིའུ་ཐུང་དང་། མིག་མཛེར་ཅན་དང་། རྔོའམ་རྨ་སྐོགས་ཅན་དང་། རླིག་འབྲས་བསྣད་པ་བཅས་ནི་ཚུར་འོང་མི་རུང་ངོ་། །"]},{"type":"verse","number":21,"content":["མཆོད་དཔོན་ཨ་རོན་གྱི་རིགས་རྒྱུད་ལས་དབང་བོ་སྐྱོན་ཅན་སུ་ཡིན་ཡང་། ཚུར་འོངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མེ་མཆོད་འབུལ་མི་རུང་། དེའི་དབང་བོར་སྐྱོན་ཡོད་པས་ཚུར་འོངས་ནས་དཀོན་མཆོག་ལ་ཞལ་ཟས་འདྲེན་མི་རུང་ངོ་། །"]},{"type":"verse","number":22,"content":["རང་གི་དཀོན་མཆོག་གི་ཞལ་ཟས་ནི་ཀུན་ལས་དམ་པའམ་དམ་པ་གང་ཡིན་ཡང་ཁོས་དེ་ཟོས་ཆོག་མོད།"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་། ཁོ་རང་ཡོལ་བའི་མདུན་དུ་འོང་མི་རུང་ལ། མཆོད་ཁྲིའི་ཉེ་སར་ཡང་བཅར་མི་རུང་སྟེ། ཁོའི་དབང་བོར་སྐྱོན་ཡོད་པ་དང་བདག་གི་གནས་མཆོག་མི་སྦག་པའི་ཕྱིར་རོ། །བདག་ནི་དེ་རྣམས་དམ་པར་བཟོ་བའི་དཀོན་མཆོག་ཡ་ཝཱེ་ཡིན་ནོ་ཞེས་པའོ་གསུངས།"]},{"type":"verse","number":24,"content":["དེ་བས་མོ་ཤེ་ཡིས་ཨ་རོན་དང་ཁོའི་བུ་རྣམས་དང་། ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ལ་བཀའ་བསྒོས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/20.json","previousChapterAudioLinks":{},"numberOfVerses":24}