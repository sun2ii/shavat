{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":4,"content":[{"type":"heading","content":["སྡིག་བཤགས་མཆོད་པའི་ཁྲིམས།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྒོས་ཤིག གལ་སྲིད་སུ་ཞིག་གིས་མ་ཤེས་པར་སྡིག་པ་སྤྱད་ཅིང་། བྱ་བ་གང་རུང་གི་སྟེང་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྣམས་ལས་གཅིག་དང་འགལ་བའམ།"]},{"type":"verse","number":3,"content":["ཡང་ན་སྣུམ་གྱིས་བྱུགས་པའི་མཆོད་དཔོན་གྱིས་སྡིག་པ་བྱས་ནས། མི་རྣམས་ཉེས་པའི་ནང་ལྷུང་དུ་བཅུག་ན། རང་གིས་བྱས་པའི་སྡིག་པའི་དོན་དུ་སྒོ་ཕྱུགས་ལས་གླང་ཐུག་སྐྱོན་མེད་པ་ཞིག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས།"]},{"type":"verse","number":4,"content":["ཁོས་གླང་ཐུག་དེ་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་ཁྲིད་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་གླང་ཐུག་གི་མགོ་ལ་ལག་པ་བཞག་ནས་དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་བཤའ་དགོས།"]},{"type":"verse","number":5,"content":["སྣུམ་གྱིས་བྱུགས་པའི་མཆོད་དཔོན་གྱིས་གླང་ཐུག་གི་ཁྲག་ཉུང་ཙམ་བླངས་ནས་མཇལ་འཕྲད་གུར་མཆོག་ཏུ་འཁྱེར་འོང་བ་དང་།"]},{"type":"verse","number":6,"content":["མཆོད་དཔོན་གྱིས་མཛུབ་མོ་ཁྲག་ནང་བསྒྲེས་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དམ་པའི་གནས་ཀྱི་ཡོལ་བར་གཏད་ནས་ལན་བདུན་གཏོར་དགོས།"]},{"type":"verse","number":7,"content":["ཡང་ཁྲག་ཉུང་ཙམ་ཞིག་མཇལ་འཕྲད་གུར་མཆོག་གི་ནང་དུ་འབྱུག་དགོས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྤོས་སྒྲོམ་གྱི་རུ་ཐུར་བཞི་པོར་འབྱུག་དགོས་པ་དང་། དེ་ནས་གླང་ཐུག་གི་ཁྲག་ལྷག་མ་ཡོངས་རྫོགས་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་ཡོད་པའི་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་དུ་ལྡུག་དགོས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་སྡིག་བཤགས་མཆོད་པར་འབུལ་བའི་གླང་ཐུག་དེའི་ཚིལ་ཐམས་ཅད་དེ། ནང་ཁྲོལ་བཏུམས་པའི་ཚིལ་དང་ནང་ཁྲོལ་སྟེང་གི་ཚིལ་ཐམས་ཅད་དང་།"]},{"type":"verse","number":9,"content":["མཁལ་མ་གཉིས་དང་དེའི་ཚིལ་ཏེ་མཁལ་མའི་ལོགས་གཉིས་ཀྱི་ཚིལ་དང་། མཆིན་པའི་རྩ་རྒྱུས་དེ་མཁལ་མ་དང་བཅས་ལེན་དགོས།"]},{"type":"verse","number":10,"content":["དེ་ནི་ཞི་བདེའི་མཆོད་པར་ཕུལ་བའི་གླང་ཐུག་ནས་བླངས་པ་བཞིན་ཡིན་དགོས་ཤིང་། མཆོད་དཔོན་གྱིས་དེ་རྣམས་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་སྟེང་སྦར་དགོས་སོ། །"]},{"type":"verse","number":11,"content":["ཡིན་ནའང་གླང་ཐུག་གི་པགས་པ་དང་ཤ་ཐམས་ཅད་དང་། མགོ་དང་བརླ་རྐང་དང་ནང་ཁྲོལ་དང་ལྕི་བ་བཅས་ཏེ།"]},{"type":"verse","number":12,"content":["གླང་ཐུག་ཧྲིལ་པོ་སྒར་ཁའི་ཕྱི་རོལ་གྱི་གཙང་ས་སྟེ། ཐལ་བ་འཕོ་སའི་གནས་སུ་ཁྱེར་ནས་བུད་ཤིང་སྟེང་དུ་མེར་བསྲེག་དགོས།"]},{"type":"verse","number":13,"content":["གལ་སྲིད་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ཐམས་ཅད་ཀྱིས་མ་ཤེས་པར་ཉེས་སྐྱོན་བཟོས་པ་དང་། བྱ་བ་གང་རུང་གི་སྟེང་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྣམས་ལས་གཅིག་དང་འགལ་ནས་ཉེས་པ་བསགས་ཡོད་ཅིང་། མི་ཚོགས་ཀྱིས་སྦས་པའི་དོན་དེ་མ་རྟོགས་ན།"]},{"type":"verse","number":14,"content":["དེ་རྣམས་ཀྱིས་སྡིག་པ་བསགས་པ་ཤེས་མ་ཐག་སྒོ་ཕྱུགས་ལས་གླང་ཐུག་ཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་པ་དང་། དེ་མཇལ་འཕྲད་གུར་མཆོག་གི་མདུན་དུ་འཁྲིད་འོང་དགོས་སོ། །"]},{"type":"verse","number":15,"content":["མི་ཚོགས་ཀྱི་རྒན་པོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་གླང་ཐུག་གི་མགོ་ལ་ལག་པ་བཞག་ནས། དེ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་བཤའ་དགོས།"]},{"type":"verse","number":16,"content":["སྣུམ་གྱིས་བྱུགས་པའི་མཆོད་དཔོན་གྱིས་གླང་ཐུག་གི་ཁྲག་ལས་ཉུང་ཙམ་བླངས་ཏེ་མཇལ་འཕྲད་གུར་མཆོག་ཏུ་འཁྱེར་འོང་དགོས།"]},{"type":"verse","number":17,"content":["མཆོད་དཔོན་གྱིས་མཛུབ་མོ་ཁྲག་ནང་བསྒྲེས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཡོལ་བར་གཏད་དེ་ལན་བདུན་གཏོར་དགོས།"]},{"type":"verse","number":18,"content":["ཡང་ཁྲག་ཉུང་ཙམ་ཅིག་མཇལ་འཕྲད་གུར་མཆོག་གི་ནང་དུ་འབྱུག་དགོས་ཏེ། དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་མཆོད་ཁྲིའི་རུ་ཐུར་བཞི་པོར་འབྱུག་དགོས་པ་དང་། དེ་ནས་ཁྲག་ལྷག་མ་ཡོངས་རྫོགས་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་ཡོད་པའི་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་དུ་ལྡུག་དགོས་སོ། །"]},{"type":"verse","number":19,"content":["ཁོས་དེའི་ཚིལ་ཐམས་ཅད་བླངས་ནས་མཆོད་ཁྲིའི་སྟེང་སྦྱིན་སྲེག་གཏོང་དགོས།"]},{"type":"verse","number":20,"content":["ཁོས་སྡིག་བཤགས་མཆོད་པའི་གླང་ཐུག་དེ་ཇི་ལྟར་ཕུལ་བ་བཞིན་དུ་གླང་ཐུག་འདི་ཡང་དེ་ལྟར་འབུལ་དགོས་ལ། མཆོད་དཔོན་གྱིས་དེ་དག་གི་སྡིག་པ་བཤག་པར་བྱ་ཞིང་དེ་ཚོར་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":21,"content":["ཡང་ཁོས་གླང་ཐུག་སྒར་ཁའི་ཕྱི་རོལ་ཏུ་ཁྱེར་ནས། གླང་ཐུག་སྔོན་མ་དེ་བཞིན་མེར་བསྲེག་དགོས། དེ་ནི་མི་ཚོགས་ཀྱི་སྡིག་བཤགས་མཆོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":22,"content":["གལ་སྲིད་འགོ་དཔོན་ཞིག་གིས་སྡིག་པ་སྤྱད་ཅིང་། བྱ་བ་གང་རུང་གི་སྟེང་མ་ཤེས་པར་ཁོའི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྣམས་ལས་གཅིག་དང་འགལ་ཏེ་ཉེས་པ་བསགས་ན།"]},{"type":"verse","number":23,"content":["ཁོས་རང་གིས་སྡིག་པ་བྱས་པ་ཤེས་མ་ཐག ར་ཐུག་སྐྱོན་གྱི་དྲི་མས་མ་གོས་པ་ཞིག་ཁྲིད་འོངས་ནས་མཆོད་པར་འབུལ་དགོས་ཤིང་།"]},{"type":"verse","number":24,"content":["ར་ཐུག་གི་མགོར་ལག་པ་བཞག་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་བཤའ་སའི་གནས་དེར་བཤའ་དགོས་ལ། དེ་ནི་སྡིག་བཤགས་མཆོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["མཆོད་དཔོན་གྱིས་མཛུབ་མོ་སྡིག་བཤགས་མཆོད་པར་ཕུལ་བའི་ཕྱུགས་ཟོག་གི་ཁྲག་ནང་བསྒྲེས་ནས། སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་རུ་ཐུར་བཞི་པོར་འབྱུག་དགོས་པ་དང་། དེ་ནས་ཁྲག་ལྷག་མ་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་དུ་ལྡུག་དགོས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ཡང་ཞི་བདེའི་མཆོད་པའི་ཚིལ་དང་འདྲ་བར་དེའི་ཚིལ་ཐམས་ཅད་མཆོད་ཁྲིའི་སྟེང་བསྲེག་དགོས་པ་དང་། མཆོད་དཔོན་གྱིས་ཁོའི་ཕྱིར་དུ་སྡིག་པ་བཤགས་ནས་ཁོ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":27,"content":["གལ་སྲིད་མི་རྣམས་ལས་སུ་ཞིག་གིས་མ་ཤེས་པར་སྡིག་པ་བྱས་ཤིང་། བྱ་བ་གང་རུང་གི་སྟེང་དུ་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྣམས་ལས་གཅིག་ལ་འགལ་ནས་ཉེས་པ་བསགས་ན།"]},{"type":"verse","number":28,"content":["ཁོས་རང་གིས་སྡིག་པ་བྱས་པ་ཤེས་མ་ཐག་རང་བྱས་ཀྱི་སྡིག་པའི་ཕྱིར་དུ་ར་མ་སྐྱོན་མེད་པ་ཞིག་ཁྲིད་ཡོང་སྟེ་མཆོད་པར་འབུལ་དགོས་པ་དང་།"]},{"type":"verse","number":29,"content":["སྡིག་བཤགས་མཆོད་པར་འབུལ་བའི་ཕྱུགས་ཟོག་གི་མགོ་ལ་ལག་པ་བཞག་ནས་སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་འབུལ་བའི་གནས་སུ་དེ་བཤའ་དགོས།"]},{"type":"verse","number":30,"content":["མཆོད་དཔོན་གྱིས་མཛུབ་མོ་ཕྱུགས་ཟོག་གི་ཁྲག་ནང་བསྒྲེས་ཏེ། སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་རུ་ཐུར་བཞི་པོར་འབྱུག་དགོས་པ་དང་། ཁྲག་ལྷག་མ་ཡོངས་རྫོགས་སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་དུ་ལྡུག་དགོས་སོ། །"]},{"type":"verse","number":31,"content":["དེ་ཡང་ཞི་བདེའི་མཆོད་པར་ཕུལ་བའི་ཕྱུགས་ཟོག་གི་ཚིལ་དང་འདྲ་བར་དེའི་ཚིལ་ཐམས་ཅད་ལེན་པ་དང་། མཆོད་དཔོན་གྱིས་ཚིལ་རྣམས་མཆོད་ཁྲིའི་སྟེང་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་མཆོད་པར་འབུལ་དགོས། མཆོད་དཔོན་གྱིས་ཁོའི་ཕྱིར་དུ་སྡིག་པ་བཤགས་ནས་ཁོ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":32,"content":["གལ་སྲིད་མི་ཞིག་གིས་ལུག་ཅིག་ཁྲིད་འོངས་ཏེ་སྡིག་བཤགས་མཆོད་པར་འབུལ་ན། མོ་ལུག་སྐྱོན་མེད་པ་ཞིག་ཁྲིད་ཡོང་ནས་འབུལ་དགོས།"]},{"type":"verse","number":33,"content":["ཁོས་སྡིག་བཤགས་མཆོད་པར་འབུལ་བའི་ཕྱུགས་ཟོག་གི་མགོ་ལ་ལག་པ་བཞག་ནས། སྦྱིན་སྲེག་གི་ཕྱུགས་ཟོག་བཤའ་བའི་གནས་སུ་དེ་བཤས་ནས་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས།"]},{"type":"verse","number":34,"content":["མཆོད་དཔོན་གྱིས་མཛུབ་མོ་སྡིག་བཤགས་མཆོད་པར་ཕུལ་བའི་ཕྱུགས་ཟོག་གི་ཁྲག་ནང་དུ་བསྒྲེས་ཏེ། སྦྱིན་སྲེག་གི་མཆོད་ཁྲིའི་རུ་ཐུར་བཞི་པོར་འབྱུག་དགོས་པ་དང་། དེ་ནས་ཁྲག་ལྷག་མ་ཡོངས་རྫོགས་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་དུ་ལྡུག་དགོས་ལ།"]},{"type":"verse","number":35,"content":["ཡང་ཞི་བདེའི་མཆོད་པར་ཕུལ་བའི་ལུག་གི་ཚིལ་དང་འདྲ་བར་དེའི་ཚིལ་ཐམས་ཅད་ལེན་པ་དང་། མཆོད་དཔོན་གྱིས་ཚིལ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་ཁྲིའི་མེ་མཆོད་ཐོག་ཏུ་སྦྱིན་སྲེག་གཏོང་དགོས། མཆོད་དཔོན་གྱིས་ཁོས་བསགས་པའི་སྡིག་པ་བཤག་པར་བྱ་ཞིང་། ཁོ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/3.json","previousChapterAudioLinks":{},"numberOfVerses":35}