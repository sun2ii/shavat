{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LEV","translationId":"bod_ntb","name":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","commonName":"ལེ་ཝིའི་ཚུལ་ཁྲིམས།","title":"༄༅། །ལེ་ཝིའི་ཚུལ་ཁྲིམས་ཀྱི་མདོ།","order":3,"numberOfChapters":27,"sha256":"a48d6640b7bcf31dd7b7abb6680b49e19dd707fa1ee6df1f6540be81d735512c","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/bod_ntb/LEV/27.json","totalNumberOfVerses":858},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["གལ་སྲིད་མི་ཞིག་གིས་སྡིག་པ་བྱས་པ་སྟེ། མནའ་བསྐྱལ་བའི་གཏམ་ཐོས་ཤིང་ཁོ་རང་དཔང་བོ་ཡིན་ནའང་། ཁོས་ཅི་མཐོང་བ་གང་ཤེས་པ་དེ་སྙན་སེང་མ་ཞུས་ན། ངེས་པར་རང་གི་ཆད་པ་འཁུར་དགོས།"]},{"type":"verse","number":2,"content":["ཡང་མི་ཞིག་གིས་མི་གཙང་བའི་རྫས་གང་རུང་སྟེ། གཅན་གཟན་མི་གཙང་བའི་རོའམ། སྒོ་ཕྱུགས་མི་གཙང་བའི་རོའམ། ལྟོ་འགྲོ་སེམས་ཅན་མི་གཙང་བའི་རོ་ལ་རེག་པ་གང་ཡིན་ཡང་། མི་དེས་མ་ཤེས་ནའང་མི་གཙང་བ་ཡིན་པས་ཉེས་པ་ཡོད་དོ། །"]},{"type":"verse","number":3,"content":["ཡང་ན་ཁོས་མི་ལས་བྱུང་བའི་མི་གཙང་བའི་རྫས་གང་རུང་སྟེ། མི་བཙོག་པར་བྱེད་པའི་མི་གཙང་བའི་རྫས་གང་རུང་ཞིག་ལ་རེག་ན། ཁོས་མ་ཤེས་ནའང་དེ་མི་གཙང་བ་ཡིན་པ་རྟོགས་ན་དེ་ནི་ཉེས་པ་ཡིན།"]},{"type":"verse","number":4,"content":["ད་དུང་མི་ཞིག་གིས་ཁ་ནས་ཅི་མི་སྙམ་པར་མནའ་བསྐྱལ་ན། ངན་སེམས་བཟང་སེམས་གང་ཞིག་བཅངས་ནས་བསྐྱལ་ནའང་། དེས་འཛེམ་དོགས་མེད་པར་དོན་གང་ཞིག་གི་སྟེང་ཅི་མི་སྙམ་པར་མནའ་བསྐྱལ་བ་ཡིན་ན། ནམ་ཞིག་ཁོས་ཤེས་མ་ཐག་ཏུ་དེའི་ནང་གི་དོན་ཞིག་གི་སྟེང་ཉེས་པ་ཡོད།"]},{"type":"verse","number":5,"content":["ཁོ་ལ་དེའི་ནང་གི་དོན་གང་རུང་ཞིག་གི་སྟེང་ཉེས་པ་ཡོད་ཚེ་སྡིག་པ་མཐོལ་བཤགས་བྱེད་དགོས་ལ།"]},{"type":"verse","number":6,"content":["རང་བྱས་ཀྱི་སྡིག་པའི་ཕྱིར་དུ། རང་གི་ཉེས་སེལ་མཆོད་པའི་ཕྱུགས་ཏེ། ལུག་ཁྱུ་ལས་མོ་ལུག་གཅིག་གམ་ཡང་ན་ར་མ་གཅིག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་ཤིང་། མཆོད་དཔོན་གྱིས་ཁོ་རང་གི་སྡིག་པ་བཤག་པར་བྱེད་དོ། །"]},{"type":"verse","number":7,"content":["གལ་སྲིད་མི་དེས་ལུ་གུ་གཅིག་འབུལ་མི་ནུས་ན། རང་བྱས་ཀྱི་སྡིག་པའི་ཕྱིར་དུ། བྱ་ཐི་བ་གཉིས་སམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཉེས་སེལ་མཆོད་པར་འབུལ་དགོས་ཏེ། གཅིག་ནི་སྡིག་བཤགས་མཆོད་པར་འབུལ་བ་དང་། ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་འབུལ་བར་བྱའོ། །"]},{"type":"verse","number":8,"content":["ཁོས་དེ་རྣམས་མཆོད་དཔོན་གྱི་དྲུང་དུ་འཁྱེར་འོང་བ་དང་། མཆོད་དཔོན་གྱིས་ཐོག་མར་སྡིག་བཤགས་མཆོད་པ་འབུལ་བ་སྟེ། འདབ་ཆགས་ཀྱི་སྐེ་གཅུས་ནའང་དེ་གཅོད་པར་མི་བྱ།"]},{"type":"verse","number":9,"content":["མཆོད་དཔོན་གྱིས་སྡིག་བཤགས་མཆོད་པའི་འདབ་ཆགས་ཀྱི་ཁྲག་ཉུང་ཙམ་ཞིག་མཆོད་ཁྲིའི་ལོགས་སུ་གཏོར་བ་དང་། ཁྲག་ལྷག་མ་རྣམས་མཆོད་ཁྲིའི་ཞབས་རའི་སྟེང་ལྡུག་དགོས། དེ་ནི་སྡིག་བཤགས་མཆོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":10,"content":["ཡང་ཁོས་སྲོལ་ཡིག་བཞིན་དུ་འདབ་ཆགས་གཞན་པ་དེ་སྦྱིན་སྲེག་ཏུ་འབུལ་དགོས་ཤིང་། མཆོད་དཔོན་གྱིས་མི་དེའི་རང་བྱས་ཀྱི་སྡིག་པ་བཤག་དགོས་ལ། མི་དེར་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":11,"content":["གལ་སྲིད་ཁོས་བྱ་ཐི་བ་གཉིས་སམ་ཡང་ན་ཕུག་རོན་ཆུང་ངུ་གཉིས་འབུལ་མི་ནུས་ན། རང་བྱས་ཀྱི་སྡིག་པའི་ཕྱིར་དུ་གྲོ་ཞིབ་ཨེ་ཕཱ་གཅིག་གི་བཅུ་ཆ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས། དེའི་སྟེང་སྣུམ་དང་སྤོས་དཀར་གང་ཡང་འཇོག་མི་དགོས། ཅི་ལ་ཞེ་ན། དེ་ནི་སྡིག་བཤགས་མཆོད་པ་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":12,"content":["དེ་ཡང་ཁོས་གྲོ་ཞིབ་དེ་མཆོད་དཔོན་གྱི་དྲུང་དུ་འཁྱེར་འོང་བ་དང་། མཆོད་དཔོན་གྱིས་དེ་ལས་ཁྱོར་བ་གང་དྲན་རྟེན་དུ་བླངས་ནས། མཆོད་ཁྲིའི་སྟེང་དཀོན་མཆོག་ཡ་ཝཱེའི་མེ་མཆོད་ཀྱི་ཁར་སྦྱིན་སྲེག་གཏོང་དགོས་ལ། དེ་ནི་སྡིག་བཤགས་མཆོད་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ཡང་ཁོས་དོན་དེ་རྣམས་ཀྱི་ཐད་བསགས་པའི་སྡིག་པ་གང་ཡིན་ནའང་། མཆོད་དཔོན་གྱིས་མི་དེའི་སྡིག་པ་དེ་བཤག་པར་བྱ་ཞིང་དེ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར། དེའི་ལྷག་མ་ནི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་འདྲ་བར་ཡོངས་རྫོགས་མཆོད་དཔོན་ལ་དབང་བར་འགྱུར་ཞེས་བཤད་དགོས་པར་བཀའ་བསྩལ་ཏོ། །"]},{"type":"heading","content":["ཉེས་སེལ་མཆོད་པའི་ཁྲིམས།"]},{"type":"verse","number":14,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":15,"content":["གལ་སྲིད་མི་ཞིག་གིས་མ་ཤེས་པར་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་རྫས་དམ་པ་རྣམས་ཀྱི་སྟེང་དུ་སྡིག་པ་བྱས་ནས་ཉེས་པ་བསགས་ན། ལུག་ཁྱུ་ལས་སྐྱོན་མེད་པའི་ལུག་ཐུག་ཅིག་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཉེས་སེལ་མཆོད་པ་རུ་འབུལ་བའམ། ཡང་ན་གནས་མཆོག་གི་སྲང་ལྟར་དངུལ་སྲང་གི་ཚོད་རྩིས་བྱས་པའི་རིན་འབབ་བཞིན་དུ་ཉེས་སེལ་མཆོད་པར་འབུལ་དགོས།"]},{"type":"verse","number":16,"content":["ཁོས་མཆོད་རྫས་དམ་པའི་ཐད་ནོར་འཛོལ་གང་ཞིག་བཟོས་པར་སྐྱིན་ཚབ་འཇལ་ཆེད་དང་། དེའི་ཁར་ལྔ་ཆ་གཅིག་བསྣན་ཏེ་མཆོད་དཔོན་ལ་སྤྲོད་པ་དང་། མཆོད་དཔོན་གྱིས་ཉེས་པ་སེལ་བྱེད་ལུག་ཐུག་གིས་ཁོའི་སྡིག་པ་བཤག་པར་བྱ་ཞིང་། ཁོ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":17,"content":["གལ་སྲིད་མི་ཞིག་གིས་དོན་གང་རུང་གི་སྟེང་དུ་སྡིག་པ་བྱས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་རྣམས་ལས་གཅིག་ལ་འགལ་ན། ཁོས་མ་ཤེས་ནའང་ཉེས་པ་རུ་བརྩི་ཞིང་རང་གི་ཆད་པ་འཁུར་དགོས་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཁོས་ལུག་ཁྱུ་ལས་ལུག་ཐུག་སྐྱོན་མེད་པ་ཞིག་འཁྲིད་ཡོང་བའམ། ཡང་ན་ཁྱོད་ཀྱིས་ཚོད་རྩིས་བྱས་པའི་རིན་འབབ་བཞིན། ཉེས་སེལ་མཆོད་པ་རུ་མཆོད་དཔོན་ལ་འབུལ་བ་དང་། མཆོད་དཔོན་གྱིས་ཁོའི་མ་ཤེས་མ་བསམ་ས་ནས་བྱས་པའི་སྡིག་པ་བཤག་པར་བྱ་ཞིང་། དེ་ལ་སྡིག་སེལ་འཐོབ་པར་འགྱུར་རོ། །"]},{"type":"verse","number":19,"content":["དེ་ནི་ཉེས་སེལ་མཆོད་པ་ཡིན་ཏེ། ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་དངོས་སུ་ཉེས་པ་བཟོས་པའི་ཕྱིར་རོ་ཞེས་བཀའ་བསྩལ་ཏོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LEV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LEV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LEV/4.json","previousChapterAudioLinks":{},"numberOfVerses":19}