{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LUK","translationId":"bod_ntb","name":"ལོ་ཀུ","commonName":"ལོ་ཀུ","title":"༄༅། །ལོ་ཀུའི་འཕྲིན་བཟང་།","order":42,"numberOfChapters":24,"sha256":"5c682cf5eca7d56a5e6ec830f96469bd04d6c9bee8bd88bc021ba77495c88c78","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/LUK/24.json","totalNumberOfVerses":1145},"chapter":{"number":12,"content":[{"type":"heading","content":["དོགས་ཟོན་བྱེད་དགོས་པ་དང་སེམས་ཁྲལ་བྱ་མི་འོས་པའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེའི་དུས༌སུ། མི་གྲངས་སྟོང་ཕྲག་དུ་མ་འདུས་ཤིང་འཚང་ཁ་ཤིག་ཤིག་བརྒྱབ་ནས་ཐ་ན་ཕན་ཚུན་ཡང་བརྫིས་སོ།། སྐྱབས་མགོན་ཡེ་ཤུས་ཐོག་མར་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་ཕ་རུ་ཤི་པའི་སྐྱུར་རྩི་སྟེ་ཚུལ་འཆོས་ལ་དོགས་པར༌གྱིས།"]},{"type":"verse","number":2,"content":["སྦས་པའི་དོན་ཐམས་ཅད་མི་མངོན་པ་ཅི་ཡང་མེད༌ལ། གསང་བའི་དོན་ཐམས་ཅད་ཀྱང་ཤེས་པར་མི་འགྱུར་བ་ཅི་ཡང་མེད།"]},{"type":"verse","number":3,"content":["དེ་བཞིན་དུ་ཁྱོད་རྣམས་ཀྱིས་ལྐོག་ནས་ཅི་ཞིག་སྨྲས་པ་དེ་མི་རྣམས་ཀྱིས་མངོན་གསལ་དུ་ཐོས་པར་འགྱུར། ཁང་པའི་སྦུག་མར་ཁ་རྣ་བར་གཏད་དེ་ཤུབ་ཤུབ་ཏུ་གང་ཞིག་སྨྲས་པ་དེའང་ཁང་པའི་ཐོག་ནས་བསྒྲག་པར་འགྱུར་རོ།།"]},{"type":"verse","number":4,"content":["བདག་གི་གྲོགས་པོ༌རྣམས། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ལུས་པོ་འཇོམ་ཡང༌དེ་ལས་གཞན་ཅི་ཡང་བྱེད་མི་ཐུབ་པ་དག་ལ་འཇིགས་པར་མི༌བྱའོ།།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་། བདག་གིས་ཁྱོད་རྣམས་གང་ལ་འཇིགས་དགོས་པ་དེ་སྟོན་པར༌བྱའོ།། ཁྱོད་ཀྱི་སྲོག་ལེན་ནུས་པ་དང་ཕྱིས་སུ་དམྱལ་བའི་གནས་སུ་འཕེན་པར་མཛད་པའི་དབང་ཡང་ཡོད་པ་དེ་ཉིད་ལ་འཇིགས་དགོས། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་རྣམས་དེ་ཉིད་ལ་འཇིགས་པར༌གྱིས།"]},{"type":"verse","number":6,"content":["བྱེའུ་ལྔ་ནི་དོང་ཙེ་གཉིས་ལ་འཚོང་ཐུབ་པ་མ་ཡིན༌ནམ། འོན་ཀྱང་དཀོན་མཆོག་གི་སྤྱན་སྔར་བྱེའུ་རྣམས་ལས་གཅིག་ཀྱང་བརྗེད་མི་སྲིད།"]},{"type":"verse","number":7,"content":["དཀོན་མཆོག་གིས་ཐ་ན་ཁྱོད་རྣམས་ཀྱི་སྐྲ་ཡི་ཉག་མ་རེ་རེ་ཡང་གྲངས་སུ་བརྩིས་ཡོད་པས། འཇིགས་མི་དགོས་ཏེ། བྱེའུ་མང་པོ་ལས་ཀྱང་ཁྱོད་རྣམས་ལ་རིན་ཐང་ཆེན་པོ་ལྡན་ནོ།།"]},{"type":"verse","number":8,"content":["ཡང་བདག་གིས་ཁྱོད་རྣམས་ལ༌སྨྲའོ།། སུ་ཞིག་གིས་མི་གཞན་གྱི་མདུན་དུ་ང་རང་ཁས་བླངས༌ན། མིའི་བུ་ཡིས་ཀྱང་དཀོན་མཆོག་གི་ཕོ་ཉ་རྣམས་ཀྱི་མདུན་ནས་མི་དེ་ཁས་ལེན་པར་འགྱུར།"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་། སུ་ཞིག་གིས་མི་གཞན་གྱི་མདུན་དུ་ང་རང་ཁས་མ་བླངས༌ན། དཀོན་མཆོག་གི་ཕོ་ཉ་རྣམས་ཀྱི་མདུན་ནས་མི་དེའང་ཁས་ལེན་པར་མི་འགྱུར།"]},{"type":"verse","number":10,"content":["ཡང་སུ་ཞིག་གིས་མིའི་བུ་ལ་གཏམ་ངན་སྨྲས་ན་མི་དེའི་སྡིག་པ་བསལ་བར་འགྱུར༌ཡང༌། དམ་པའི་ཐུགས་ཉིད་ལ་སྐུར་བ་བཏབ་ན་མི་དེའི་སྡིག་པ་གཏན་ནས་བསལ་བར་མི་འགྱུར་རོ།།"]},{"type":"verse","number":11,"content":["མི་གཞན་གྱིས་ཁྱོད་རྣམས་ཆོས་ཁང་གི་ཁྲིམས༌རའམ། ཁྲིམས་དཔོན་ནམ་མི་དབང་དང་ལྡན་པ་བཅས་ཀྱི་མདུན་དུ་ཁྲིད་པའི་དུས༌སུ། ཁྱོད་རྣམས་ཀྱིས་ལན་ཇི་ལྟར་འདེབས་པ་དང་གང་ཞིག་བརྗོད་པ་ལ་སེམས་ཁྲལ་མ་བྱེད༌ཅིག"]},{"type":"verse","number":12,"content":["རྒྱུ་མཚན་ནི་དེའི་དུས་སུ་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱོད་རྣམས་ལ་གང་ཞིག་སྨྲ་དགོས་པ་སྟོན་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཕྱུག་པོ་གླེན་པའི༌དཔེ།"]},{"type":"verse","number":13,"content":["མི་ཚོགས་ཀྱི་ཁྲོད་དུ་མི་ཞིག་གིས་སྐྱབས་མགོན་ཡེ་ཤུ༌ལ། སློབ་དཔོན༌ལགས། ཁྱེད་ཀྱིས་ངའི་ཕུ་བོར་བཀའ་གནང་སྟེ་ཤུལ་བཞག་རྒྱུ་ནོར་བདག་ལའང་བགོ་བཤའ་བྱེད་པར་མཛོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་འདི་སྐད༌དུ། གྲོགས༌པོ། སུ་ཞིག་གིས་ང་རང་ཁྱོད་གཉིས་ཀྱི་ཤུལ་བཞག་རྒྱུ་ནོར་བགོ་བཤའ་བྱེད་པའི་བར་འདུམ་པའམ་འགོ་པར་བསྐོས་པ་ཡིན་ནམ་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":15,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཚོགས་ལ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་རང་ཉིད་བསྲུང་ཞིང་མཉམ་པར་བཞག་སྟེ་བརྣབ་སེམས་ཅན་གྱི་རིགས་ཐམས་ཅད་ལ་དོགས་པར༌གྱིས། རྒྱུ་མཚན་མི་ཡི་ཚེ་སྲོག་ནི་རྒྱུ་ནོར་ལོངས་སྤྱོད་མང་པོ་ཡོད་མེད་ལ་རག་མི་ལས་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":16,"content":["ཡང་ཁོང་གིས་དཔེའི་སྒོ་ནས་འདི་སྐད༌དུ། དེ་ཡང་མི་ཕྱུག་པོ་ཞིག་ཡོད་པར་ཞིང་ལ་ལོ་ལེགས་བྱུང༌ཞིང༌།"]},{"type":"verse","number":17,"content":["ཁོའི་སེམས་སུ་འབྲུ་རིགས་ལ་འབྲུ་མཛོད་མེད་པས་བདག་གིས་ཅི་བྱའམ་ཞེས་བསམས་པ༌དང༌།"]},{"type":"verse","number":18,"content":["ཡང་ཁོ་ན༌རེ། བདག་གིས་རང་གི་བང་མཛོད་རྣམས་བཤིག་ཅིང་དེ་ལས་ཀྱང་ཆེ་བ་རྣམས་བཟོས༌ཏེ། རང་གི་འབྲུ་རིགས་དང་རྒྱུ་ནོར་ཐམས་ཅད་དེ་རུ་འཇོག་པར་བྱའོ་སྙམ་པ༌དང༌།"]},{"type":"verse","number":19,"content":["དེའི་རྗེས་སུ་ཡང་རང་གིས་རང༌ལ། ཁྱོད་ཀྱིས་ལོ་མང་པོའི་རིང་ལ་རྒྱུ་ནོར་འབོར་ཆེན་བསགས་ཡོད༌པས། ད་ལྟ་ངལ་གསོ་བྱོས་དང་བློ་བདེ་བག་ཕེབས་ངང་ནས་བཟའ་བཏུང་ལོངས་སུ་སྤྱད་དེ་སྤྲོ་སྐྱིད་ལ་རོལ་ཅིག་ཅེས་སྨྲ་བར་བྱའོ་བསམས༌མོད།"]},{"type":"verse","number":20,"content":["འོན་ཀྱང་དཀོན་མཆོག་གིས་ཁོ་རང་ལ་འདི་སྐད༌དུ། གླེན་པ༌ཁྱོད། དོ་དགོང་གི་དུས་འདི་ལ་ཁྱོད་ཀྱི་ཚེ་སྲོག་ལེན་པར༌འགྱུར། ཁྱོད་ཀྱིས་སྟ་གོན་བྱས་ནས་བསགས་པའི་རྒྱུ་ནོར་དེ་སུ་ལ་དབང་ངམ་བལྟ་ཞེས་གསུངས༌པའོ།།"]},{"type":"verse","number":21,"content":["དེ་བཞིན་མི་སུས་ཀྱང་རང་གི་དོན་དུ་རྒྱུ་ནོར་མང་པོ་བསགས་ཀྱང་དཀོན་མཆོག་གི་སྤྱན་སྔར་ཕྱུག་པོ་མ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སེམས་ཁྲལ་བྱ་མི་རུང་བའི༌སྐོར།"]},{"type":"verse","number":22,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། དེས་ན་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཚེ་སྲོག་གི་དོན་དུ་ཟས་གང་ཞིག་སྤྱོད་པ་དང་ལུས་པོའི་ཆེད་དུ་གོས་གང་ཞིག་གྱོན་པ་ལའང་སེམས་ཁྲལ་མ་བྱེད༌ཅིག"]},{"type":"verse","number":23,"content":["རྒྱུ་མཚན་ནི་ཁ་ཟས་ལས་ཚེ་སྲོག་ཁྱད་དུ་འཕགས་ཤིང་གྱོན་ཆས་ལས་ཀྱང་མིའི་ལུས་པོ་ནི་ཁྱད་དུ་འཕགས་པ་ཡིན།"]},{"type":"verse","number":24,"content":["བྱ་ཕོ་རོག་དག་ལ་ལྟོས༌དང༌། དེ་དག་གིས་ས་བོན་མི་འདེབས༌ལ། སྟོན་ཡང་མི་བསྡུ་ཞིང་བང་མཛོད་དང་འབྲུ་མཛོད་ཅི་ཡང་མེད༌མོད། འོན་ཀྱང་དཀོན་མཆོག་གིས་དེ་དག་གསོ་བ་ཡིན། ཁྱོད་རྣམས་ནི་བྱ་ལས་ཇི་འདྲའི་རིན་ཐང་ཆེ༌ཨང༌།"]},{"type":"verse","number":25,"content":["ཁྱོད་རྣམས་ལས་སུ་ཞིག་གིས་སེམས་ཁྲལ་བྱས་ནས་རང་གི་ཚེ་ཐག་ཡུད་ཙམ་ཞིག་ཇེ་རིང་དུ་གཏོང་ནུས༌སམ།"]},{"type":"verse","number":26,"content":["ཁྱོད་རྣམས་ཀྱིས་དོན་ཆུང་ངུ་འདི་ལྟ་བུ་ཞིག་ཀྱང་བསྒྲུབ་མི་ནུས༌ན། དོན་དག་གཞན་ལ་སེམས་ཁྲལ་བྱ་དགོས་དོན༌ཅི།"]},{"type":"verse","number":27,"content":["མེ་ཏོག་ཀུ་མུད་ཇི་ལྟར་སྐྱེ་བར་ལྟོས༌དང༌། དེ་དག་གིས་ལས་ཀ་མི་བྱེད་ལ་བལ་ཡང་མི་འཁེལ་མོད། འོན་ཀྱང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། སོ་ལོ་མོན་གྱི་བརྗིད་ཉམས་ཤིན་ཏུ་ཆེ་བའི་དུས༌སུ། ཁོང་གི་རྒྱན་གོས་མེ་ཏོག་འདི་ལའང་མི༌དོའོ།།"]},{"type":"verse","number":28,"content":["དེའི༌ཕྱིར། དེ་རིང་ཡོད་ཡོད་འདྲ་ཡང་སང་ཉིན་ཐབ་ལ་བསྲེག་པར་འགྱུར་བའི་སྤང་ཐང་གི་རྩྭ་ཡང་དཀོན་མཆོག་གིས་ལེགས་པར་བསྐྱངས༌ན། དད་པ་ཆུང་བ་ཁྱོད་རྣམས་དེ་ལས་ལྷག་པར་སྐྱོང་བར་མི་མཛད༌དམ།"]},{"type":"verse","number":29,"content":["ཁྱོད་རྣམས་ཀྱིས་བཟའ་བཏུང་གང་ཞིག་ལོངས་སུ་སྤྱོད་པར་མ་སྙེག་ལ་སེམས་ཁྲལ་ཡང་མ་བྱེད༌ཅིག"]},{"type":"verse","number":30,"content":["རྒྱུ་མཚན་ནི་དེ་ཐམས་ཅད་འཇིག་རྟེན་པ་དག་གིས་བརྩོན་ས་ཡིན༌ལ། ཁྱོད་རྣམས་ལ་དེ་དག་མཁོ་བ་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་མཁྱེན༌ནོ།།"]},{"type":"verse","number":31,"content":["ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་འཚོལ་ཞིང་སྙེགས་པར་གྱིས་དང་། དེ་རྣམས་ཀྱང་ཁྱོད་ཅག་ལ་གནང་བར་འགྱུར།"]},{"type":"verse","number":32,"content":["ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་རང་གི་རྒྱལ་སྲིད་ཀྱང་ཁྱོད་རྣམས་ལ་གནང་བར་ཐུགས་དགྱེས༌པས། ཀྱེ། ཚོགས་ཆུང་ཁྱོད་རྣམས་མ་སྐྲག༌ཅིག"]},{"type":"verse","number":33,"content":["ཁྱོད་ཅག་གིས་རང་གི་རྒྱུ་རྫས་རྣམས་བཙོང་སྟེ་མི་གཞན་ལ་སྦྱིན་པར༌གྱིས། དེ་ནི་རུལ་བར་མི་འགྱུར་བའི་དངུལ་ཁུག་རང་ལ་འབྱོར་བ་དང་མཚུངས༌ཤིང༌། འཛད་མཐའ་མེད་པའི་ནོར་བུ་ནམ་མཁའི་ཞིང་ཁམས་སུ་གསོག་པ་དང་འདྲ༌སྟེ། གནས་དེར་རྐུན་མ་མི་ཐོན་ཞིང་འབུ་སྲིན་གྱིས་ཀྱང་བཟའ་བར་མི་འགྱུར།"]},{"type":"verse","number":34,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཀྱི་ནོར་བུ་གང་དུ་ཡོད་ན་ཁྱོད་རྣམས་ཀྱི་སེམས་ཀྱང་དེ་རུ་ཡོད་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕྱིར་ཕེབས་པར་བསྒུག་དགོས་པའི༌དཔེ།"]},{"type":"verse","number":35,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་ལུས་ལ་སྐ་རགས་བཅིངས་ཤིང་སྒྲོན་མེ་བསྒྲོན༌ཏེ།"]},{"type":"verse","number":36,"content":["རང་ཉིད་ནི་རང་གི་བདག་པོ་གཉེན་སྟོན་ལས་ཕྱིར་ལོག་པར་སྒུག་པའི་གཡོག་པོ་རྣམས་དང་འདྲ་བར་བྱོས་ཤིག བདག་པོ་ཕྱིར་ཕེབས་ཏེ་སྒོ་བརྡུང་དུས་གཡོག་པོ་རྣམས་ཀྱིས་ཀྱང་མྱུར་དུ་སྒོ་འབྱེད་ཐུབ་པ་ཡིན།"]},{"type":"verse","number":37,"content":["བདག་པོ་ཕྱིར་ཕེབས་དུས་གཡོག་པོ་རྣམས་ཀྱིས་མཉམ་པར་བཞག་ནས་སྒུག་སྡོད་པ་ཁོང་གིས་གཟིགས་ན་གཡོག་པོ་རྣམས༌བདེའོ།། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། བདག་པོས་ལུས་ལ་སྐ་རགས་བཅིངས་ཤིང་གཡོག་པོ་རྣམས་གྲལ་ལ་སྡོད་དུ་འཇུག་པ་དང་དེ་དག་གི་མདུན་དུ་ཡོང་ནས་ཞབས་ཕྱི་བསྒྲུབ་པ་ཡིན།"]},{"type":"verse","number":38,"content":["ཡང་ནམ་ཕྱེད་དམ་སྐྱ་རེངས་ཀྱི་དུས་གང་ཞིག་ལ་ཁོང་ཉིད་ཕྱིར་སླེབས་ཚེ། གཡོག་པོ་རྣམས་ཀྱིས་དེ་ལྟར་སྒུག་བཞིན་པ་གཟིགས༌ན། གཡོག་པོ་དེ་རྣམས་ཀྱང༌བདེའོ།།"]},{"type":"verse","number":39,"content":["ཁྱིམ་བདག་གིས་དུས་ནམ་ཞིག་ལ་རྐུན་མ་ཡོང་ངེས་པ་ཤེས༌ན། ཁོས་རྐུན་མ་ཁྱིམ་ལ་འཛུལ་དུ་མི་འཇུག་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པར་གྱིས།"]},{"type":"verse","number":40,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་སྟ་གོན་བྱོས༌དང༌། རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཀྱིས་སེམས་སུའང་མི་དྲན་པའི་དུས་ཤིག༌ལ། མིའི་བུ་ཕེབས་ཡོང་ངེས་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":41,"content":["ཐུགས་སྲས་པེ་ཏྲོ་ན༌རེ། གཙོ་བོ༌ལགས། དཔེ་འདི་ནི་ངེད་རྣམས་ཀྱི་དོན་དུ་གསུངས་པ་ཡིན༌ནམ། ཡང་ན་མི་ཀུན་ལ་གསུངས་པ་ཡིན་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":42,"content":["གཙོ་བོས་འདི་སྐད༌དུ། དེས་ན་སུ་ཞིག་བློ་སེམས་དཀར་ཞིང་འཇོན་ཐང་ཅན་གྱི་གཉེར་པ་ཡིན༌པ་དང་། བདག་པོས་ཁོ་ནི་རང་གི་གཡོག་པོ་རྣམས་ཀྱི་འགོ་པར་བསྐོས༌ཏེ། དུས་ལྟར་དེ་རྣམས་ལ་ཟས་སྐལ་སྟེར་བ་ཡིན་ནམ།"]},{"type":"verse","number":43,"content":["བདག་པོ་ཕྱིར་སླེབས་ཏེ་གཡོག་པོས་དེ་ལྟར་སྒྲུབ་བཞིན་པ་མཐོང༌ན། གཡོག་པོ་དེ་ནི༌བདེའོ།།"]},{"type":"verse","number":44,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར༌སྨྲ་སྟེ། བདག་པོས་གཡོག་པོ་དེར་རྒྱུ་ནོར་ཐམས་ཅད་དོ་དམ་བྱེད་པའི་དབང་སྤྲོད་པར་འགྱུར་རོ།།"]},{"type":"verse","number":45,"content":["འོན་ཀྱང་། གཡོག་པོའི་སེམས་སུ་ངའི་བདག་པོ་ཕྱིར་ཡོང་བ་འཕྱིའོ་སྙམ༌སྟེ། གཡོག་པོ་དང་གཡོག་མོ་གཞན་རྣམས་ལ་གཅར་རྡུང་བྱེད་པ་དང་། བཟའ་བཏུང་སྤྱོད་ཅིང་ར་བཟི་བར་གྱུར༌ན།"]},{"type":"verse","number":46,"content":["ཁོས་སེམས་སུའང་མི་དྲན་པའི་ཉིན་ཞིག་དང་། མི་ཤེས་པའི་དུས་ཤིག་ལ། གཡོག་པོ་དེའི་བདག་པོ་ཕྱིར་ཕེབས་ཏེ། ཁོ་རང་དུམ་བུར་གཅོད་ཅིང་། དད་པ་མེད་པ་རྣམས་དང་མཉམ་དུ་གཏོང་བར་འགྱུར།"]},{"type":"verse","number":47,"content":["ཡང་གཡོག་པོ་དེས་བདག་པོའི་བསམ་དོན་ཤེས་བཞིན་དུ་སྟ་གོན་མི་བྱེད་པ་དང་བདག་པོའི་བསམ་དོན་ལྟར་མ་བསྒྲུབས༌ན། ཁོས་རྡུང་རྡེག་མང་པོ་མྱང་བར་འགྱུར་རོ།།"]},{"type":"verse","number":48,"content":["འོན་ཀྱང་བདག་པོའི་བསམ་དོན་མི་ཤེས་པའི་གཡོག་པོས་རྡུང་རྡེག་བྱེད་འོས་པའི་ཉེས་སྐྱོན་བཟོས་ཀྱང་དེས་རྡུང་རྡེག་ཉུང་ཙམ་མྱང་བར་འགྱུར། རྒྱུ་མཚན་ནི་མི་སུ་ཞིག་ལ་མང་པོ་གནང་བ་ཡིན༌ན། མི་དེ་ལས་ཀྱང་ཕྱིར་མང་པོ་ལེན་པ་དང༌། ཡང་སུ་ཞིག་ལ་མང་པོ་བཅོལ་བ་ཡིན༌ན། མི་དེས་ཀྱང་ཕྱིར་མང་པོ་སྤྲོད་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["འཁྲུག་རྩོད་འབྱུང་བའི༌རྒྱུ།"]},{"type":"verse","number":49,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་ནི་ས་གཞི་ཆེན་པོར་མེ་འཕེན་དུ་ཡོང༌བ་ཡིན་ནོ།། མེ་འབར་ཟིན་ན་ཅི་མ༌རུང་།"]},{"type":"verse","number":50,"content":["བདག་གིས་ཁྲུས་གསོལ་ལེན་དགོས་པ་ད་དུང་བླངས་མེད་ཅིང་། དོན་དེ་འགྲུབ་པའི་བར་དུ་བདག་ནི་ཇི་འདྲའི་སེམས་འཚབ་ཨང་།"]},{"type":"verse","number":51,"content":["ཁྱོད་རྣམས་ཀྱིས་ང་རང་འཇིག་རྟེན་འདིར་ཡོང་བ་ནི་མི་རྣམས་ལ་ཞི་བདེ་འཐོབ་པའི་ཆེད་དུ་ཡིན་སྙམ་མམ། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར༌བྱའོ།། དེ་ལྟར་མ་ཡིན༌ཏེ། ང་ནི་དབྱེན་འབྱེད་དུ་འོངས་པ་ཡིན།"]},{"type":"verse","number":52,"content":["དུས་ད་ནས༌བཟུང༌། ཁྱིམ་ཚང་གཅིག་གི་བཟའ་མི་ལྔ་བོར་རྩོད་གླེང་བྱུང༌སྟེ། མི་གསུམ་ཅན་གྱིས་མི་གཉིས་ཅན་དང་མི་གཉིས་ཅན་གྱིས་མི་གསུམ་ཅན་ལ་ཕན་ཚུན་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":53,"content":["ཡང་ཕ་ཡིས་བུ༌དང༌བུ་ཡིས་ཕ་ལ་རྒོལ་བ༌དང༌། མ་ཡིས་བུ་མོ༌དང༌བུ་མོས་མ་ལ་རྒོལ་བ༌དང༌། སྒྱུག་མོས་མནའ་མ༌དང༌མནའ་མས་སྒྱུག་མོ་ལ་རྒོལ་བར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དུས་ལ་བརྟག་དགོས་པའི༌སྐོར།"]},{"type":"verse","number":54,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཚོགས་ལ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་ནུབ་ཕྱོགས་ནས་སྤྲིན་འཁྲིགས་པ་མཐོང་མ་ཐག༌ཏུ། ཆར་བ་འབབ་ངེས་རེད་ཟེར་ཞིང་དངོས་གནས་དེ་ལྟར་དུ་འབྱུང༌།"]},{"type":"verse","number":55,"content":["ཡང་ལྷོ་ཕྱོགས་ནས་རླུང་གཡོས་པ་མཐོང་བ་ན། ཚ་བ་འབྱུང་ངེས་རེད་ཟེར་བ་དང་དེ་ལྟར་དུ་འབྱུང༌།"]},{"type":"verse","number":56,"content":["འོན་ཀྱང་ཚུལ་འཆོས་ཅན་ཁྱོད་རྣམས་ཀྱིས་གནམ་སའི་རང་བཞིན་བརྟགས་པས་ཤེས༌ཀྱང་། དུས་འདིར་ཅིའི་ཕྱིར་རྟོག་མི་ཤེས་སམ།"]},{"type":"verse","number":57,"content":["ཁྱོད་རྣམས་ཀྱིས་གང་ཞིག་འོས་མཐུན་ཡིན་མིན་ལ་ཅིའི་ཕྱིར་རང་གིས་ཐག་གཅོད་མི་བྱེད༌དམ།"]},{"type":"verse","number":58,"content":["དཔེར་ན་ཁྱོད་དང་ཁྱོད་རང་གཏུག་མཁན་གཉིས་མཉམ་དུ་ཁྲིམས་དཔོན་གྱི་དྲུང་དུ་འགྲོ་བའི་དུས༌སུ། ལམ་བར་དུ་ཁོ་དང་འགྲིག་མཐུན་ཡོང་བར་བརྩོན་པར༌གྱིས། དེ་ལྟར་མ་བྱས་ཚེ་ཁྱོད་ཀྱི་གྱོད་ཡས་ཁྱོད་རང་ཁྲིམས་དཔོན་གྱི་དྲུང་དུ་ཁྲིད༌ཅིང༌། ཁྲིམས་དཔོན་གྱིས་ཁྱོད་རང་དམག་མིར་སྤྲོད་པ་དང་དམག་མིས་ཁྱོད་རང་བཙོན་དུ་འཇུག་པར་འགྱུར།"]},{"type":"verse","number":59,"content":["ཡང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་ཀྱིས་དོང་ཙེ་ཐམས་ཅད་སྐྱིན་ཚབ་ཏུ་སྤྲད་ཚར་བའི་བར་དུ་ཁྱོད་རང་བཙོན་ཁང་ལས་གཏན་ནས་ཐར་མི་ནུས་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LUK/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LUK/11.json","previousChapterAudioLinks":{},"numberOfVerses":59}