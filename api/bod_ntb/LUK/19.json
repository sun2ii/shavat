{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LUK","translationId":"bod_ntb","name":"ལོ་ཀུ","commonName":"ལོ་ཀུ","title":"༄༅། །ལོ་ཀུའི་འཕྲིན་བཟང་།","order":42,"numberOfChapters":24,"sha256":"5c682cf5eca7d56a5e6ec830f96469bd04d6c9bee8bd88bc021ba77495c88c78","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/LUK/24.json","totalNumberOfVerses":1145},"chapter":{"number":19,"content":[{"type":"heading","content":["ཁྲལ་ལེན་མཁན་སཱ་ཀའི་སྐོར།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ཡེ་རུ་ཀོ་བརྒྱུད་ནས་ཕེབས་པའི༌ཚེ།"]},{"type":"verse","number":2,"content":["གནས་དེར་སཱ་ཀ་ཟེར་བའི་ཕྱུག་བདག་ཅིག་ཡོད་ཅིང་དེ་ནི་ཁྲལ་ལེན་མཁན་གྱི་འགོ་དཔོན་ཡང་ཡིན་ནོ།།"]},{"type":"verse","number":3,"content":["སཱ་ཀས་སྐྱབས་མགོན་ཡེ་ཤུ་སུ་ཡིན་པར་བལྟ་འདོད༌ཀྱང༌། ཁོའི་གཟུགས་ཐུང་ཞིང་མི་མང་པོ་འཚོགས་པའི་རྐྱེན་གྱིས་མཐོང་མ་ཐུབ༌པས།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་གཤེགས་ལམ་གྱི་མདུན་དུ་བརྒྱུགས་པ་དང་འོ་སེ་ཤིང་ཞིག་ལ་འགོས་ནས་བལྟས་པ་ལ།"]},{"type":"verse","number":5,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེར་ཕེབས་པ་དང་ཡར་གཟིགས་ཏེ་འདི་སྐད༌དུ། སཱ༌ཀ ཁྱོད་རང་མྱུར་དུ་མར་བོབས༌དང༌། དེ་རིང་ང་ནི་ཁྱོད་ཀྱི་ཁྱིམ་དུ་སྡོད་དགོས་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":6,"content":["སཱ་ཀ་མྱུར་དུ་མར་བབས་ཏེ་དགའ་སྤྲོའི་ངང་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་གདན་དྲངས༌སོ།།"]},{"type":"verse","number":7,"content":["མི་རྣམས་ཀྱིས་དོན་དེ་མཐོང་སྟེ་མ་དགའ་བར་ཤབ་ཤུབ་ཏུ་ཕན་ཚུན་ན༌རེ། ཁོང་ཉིད་མི་སྡིག་ཅན་གྱི་ཁྱིམ་ལ་མགྲོན་དུ་ཕེབས་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":8,"content":["སཱ་ཀ་ཡར་ལངས་ཏེ་སྐྱབས་མགོན་ཡེ་ཤུ༌ལ། ཇོ་བོ༌ལགས། ཁྱེད་ཀྱིས་གཟིགས༌དང༌། ངས་རང་གི་རྒྱུ་ནོར་གྱི་ཕྱེད་ཀ་དབུལ་པོ་རྣམས་ལ་སྟེར་ངེས་ཡིན། གལ་ཏེ་ངས་སྔོན་ཆད་མི་སུ་ཞིག་ནས་སླུ་བྲིད་ཀྱིས་རྒྱུ་ནོར་བླངས་ཡོད༌ན། ཕྱིར་ལྡབ་བཞིས་འཇལ་ངེས་ཡིན་ཞེས་ཞུས་སོ།།"]},{"type":"verse","number":9,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མི་འདི་ཡང་ཨབ་ར་ཧམ་གྱི་བུ་རབས་ཚ་རྒྱུད་ཡིན༌པས། དེ་རིང་ཐར་པ་ཁྱིམ་འདིར་སླེབས༌པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཅིའི་ཕྱིར་ཞེ༌ན། མིའི་བུ་ནི་བོར་ཟིན་པ་རྣམས་འཚོལ་བ་དང་སྐྱོབ་པའི་ཕྱིར་ཡོང་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དངུལ་སྒོར་བཅུ་ཡི་དཔེ།"]},{"type":"verse","number":11,"content":["མི་རྣམས་ཀྱིས་གཏམ་དེ་དག་ལ་ཉན་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་ལ་ཉེ་བར་སླེབས་པའི་རྐྱེན༌དང༌། མི་རྣམས་ཀྱི་སེམས་སུའང་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་མྱུར་དུ་མངོན་པར་འགྱུར་ངེས་ཡིན་བསམས༌པས། ཁོང་གིས་དཔེའི་སྒོ་ནས་འདི་སྐད༌དུ།"]},{"type":"verse","number":12,"content":["དེ་ཡང་རྒྱལ་པོའི་རིགས་རྒྱུད་ཅིག་ཡོད་པར་རྒྱལ་སྲིད་འཐོབ་ཆེད་རྒྱང་རིང་ཡུལ་དུ་འགྲོ་བའི་འཆར་གཞི་བཀོད༌དེ། རྒྱལ་སྲིད་ཐོབ་རྗེས་ཕྱིར་ལོག་པར་འདོད་ཅིང་།"]},{"type":"verse","number":13,"content":["རང་གི་གཡོག་པོ་བཅུ་ཚུར་བོས་ནས་མི་རེ་རེར་དངུལ་རྡོ་ཚད་གཅིག་རེ་སྤྲད༌དེ། ཁྱོད་རྣམས་ཀྱིས་ང་རང་ཕྱིར་ཡོང་བའི་བར་དུ་ཚོང་ལས་གཉེར་ཞིག་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཁོའི་འབངས་མི་རྣམས་ཁོ་ལ་སྡང་སེམས་སྐྱེས་པས་མི་ཁ་ཤས་ཁོའི་རྗེས་སུ་བཏང༌སྟེ། ངེད་རྣམས་མི་དེ་རྒྱལ་པོ་བྱེད་པར་མི་འཐད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":15,"content":["ཁོ་ལ་རྒྱལ་སྲིད་ཐོབ་ནས་ཕྱིར་ཡོང་སྟེ་དངུལ་སྤྲད་པའི་གཡོག་པོ་རྣམས་ཀྱིས་ཚོང་ལས་བྱས་ནས་ཁེ་སྤོགས་ཅི་ཙམ་ཡོད་པར་བལྟ་ཕྱིར་དེ་རྣམས་འབོད་དགོས་པའི་བཀའ་གནང་ངོ་།།"]},{"type":"verse","number":16,"content":["གཡོག་པོ་སྔ་མ་དེ་ཁོའི་དྲུང་དུ་ཡོང༌སྟེ། བདག་པོ༌ལགས། ཁྱེད་ཀྱིས་གནང་བའི་རྡོ་ཚད་གཅིག་གིས་རྡོ་ཚད་བཅུའི་ཁེ་སྤོགས་རེག་ཡོད་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":17,"content":["བདག་པོ་ན༌རེ། ལེགས་པོ༌འདུག ཁྱོད་ནི་གཡོག་པོ་བཟང་པོ་ཡིན་ལ། ཁྱོད་ནི་དོན་ཆུང་ངུ་ལའང་བློ་སེམས་དཀར་བས། གྲོང་ཁྱེར་བཅུའི་མངའ་དབང་ཁྱོད་ལ་སྤྲོད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":18,"content":["གཡོག་པོ་གཞན་ཞིག་ཡོང་སྟེ་ན༌རེ། བདག་པོ༌ལགས། ཁྱེད་ཀྱིས་གནང་བའི་རྡོ་ཚད་གཅིག་གིས་རྡོ་ཚད་ལྔའི་ཁེ་སྤོགས་རེག་ཡོད་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":19,"content":["ཡང་བདག་པོ་ན༌རེ། ཁྱོད་ལ་ཡང་གྲོང་ཁྱེར་ལྔའི་མངའ་དབང་སྤྲོད་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":20,"content":["ཡང་གཡོག་པོ་གཞན་ཞིག་ཡོང་སྟེ་ན༌རེ། བདག་པོ༌ལགས། ངས་ཁྱེད་ཀྱི་རྡོ་ཚད་གཅིག་པོ་དེ་རས་ཀྱིས་བཏུམས་ནས་བདག་གཉེར་བྱས་པས་འདི་རུ་ཡོད༌དེ།"]},{"type":"verse","number":21,"content":["ཁྱེད་རང་ནི་མི་བཙན་པོ་ཞིག་ཡིན་ཞིང་རྒྱུ་ནོར་མ་བཞག་པར་ལེན་པ་དང་མ་བཏབ་ས་ནས་སྟོན་བསྡུ་བས་ང་རང་ཁྱེད་ལ་འཇིགས་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":22,"content":["ཡང་བདག་པོ་ན༌རེ། གཡོག་པོ་ངན་པ་ཁྱོད་ལ་རང་གི་ཁ་ནས་ཅི་སྨྲས་བཞིན་ཉེས་ཆད་གཅོད་པར༌བྱའོ།། ཁྱོད་ཀྱིས་ང་རང་མི་བཙན་པོ་ཞིག་ཡིན་ཞིང་རྒྱུ་ནོར་མ་བཞག་པར་ལེན་པ་དང་ས་བོན་མ་བཏབ་པར་ལོ་ཏོག་རྔ་བ་ཤེས༌ན།"]},{"type":"verse","number":23,"content":["ཅིའི་ཕྱིར་ངའི་རྡོ་ཚད་གཅིག་པོ་དེ་དངུལ་ཁང་དུ་མ་བཞག༌གམ། ཁྱོད་ཀྱིས་དེ་ལྟར་བྱས་ན་ང་རང་ཕྱིར་སླེབས་པའི་དུས་སུ། མ་རྩ་དང་སྐྱེད་ཀ་གཉིས་བླངས་ཆོག་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས༌ཤིང༌།"]},{"type":"verse","number":24,"content":["ཡང་གནས་དེར་ཡོད་པའི་མི་རྣམས༌ལ། ཁོའི་རྡོ་ཚད་གཅིག་པོ་ཕྱིར་ལོངས༌དང༌། རྡོ་ཚད་བཅུ་ཡོད་པ་ཅན་ལ་བྱིན་ཅིག་ཅེས་སྨྲས་སོ།།"]},{"type":"verse","number":25,"content":["དེ་རྣམས་ན༌རེ། བདག་པོ༌ལགས། མི་དེ་ལ་རྡོ་ཚད་བཅུ་ཡོད་པ་མ་ཡིན་ནམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":26,"content":["ཡང་བདག་པོ་ན༌རེ། ངས་ཁྱོད་ཅག་ལ་སྨྲ་བར༌བྱ་སྟེ། སུ་ཞིག་ལ་ཡོད་པ་དེ་ལ་ད་དུང་ཡང་གནང་ངེས༌ཤིང༌། སུ་ཞིག་ལ་མེད་པ་དེ་ལས་ཉུང་ཙམ་ཡོད་པ་དེ་ཡང་ཕྱིར་ལེན་པར་འགྱུར།"]},{"type":"verse","number":27,"content":["འོན༌ཀྱང༌། ང་རང་ཁོ་རྣམས་ཀྱི་རྒྱལ་པོ་བྱེད་པར་མི་དགའ་བའི་དགྲ་བོ་དེ་རྣམས་འདིར་ཁྲིད་ཤོག༌དང༌། བདག་གི་མདུན་ནས་སོད་ཅིག་སྨྲས་པའོ་ཞེས་གསུངས་སོ།།"]},{"type":"heading","content":["གཟི་བརྗིད་ཀྱི་ངང་ནས་ཡེ་རུ་སཱ་ལེམ་དུ་ཕེབས༌པ།"]},{"type":"verse","number":28,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་གོང་གི་གསུང་དེ་དག་གནང༌རྗེས། ཡར་ཡེ་རུ་སཱ་ལེམ་དུ་ཆས་པ༌དང༌།"]},{"type":"verse","number":29,"content":["ཁོང་ཉིད་སྐྱུ་རུ་རའི་རི་བོའི་ངོས་སུ་ཡོད་པའི་པེ་ཕཱ་གེ་དང་པེ་ཐན་ཡཱ་ཡུལ་དང་ཉེ་བར་ཕེབས་པའི༌ཚེ། ཁོང་གིས་ཐུགས་སྲས་གཉིས་མངགས༌ཏེ།"]},{"type":"verse","number":30,"content":["ཁྱོད་གཉིས་ཕ་རོལ་གྱི་གྲོང་སྡེ་རུ་སོང༌དང༌། དེའི་ནང་དུ་འགྲོ་སྐབས་སུས་ཀྱང་བཞོན་མ་མྱོང་བའི་བོང་ཕྲུག་ཅིག་བཏགས་ཡོད་པ་མཐོང་ངེས༌ཤིང་། ཁྱོད་གཉིས་ཀྱིས་ཐག་པ་བཀྲོལ་ནས་འདིར་ཁྲིད༌ཤོག"]},{"type":"verse","number":31,"content":["གལ་ཏེ་སུ་ཞིག་གིས་ཅིའི་ཕྱིར་འགྲོལ་བ་ཡིན་ཞེས་ཟེར༌ན། ཁྱོད་གཉིས་ཀྱིས་བོང་ཕྲུག་འདི་གཙོ་བོ་ལ་མཁོ་བ་ཡིན་ཞེས་སྨྲོས་ཤིག་ཅེས་བཀའ་གནང༌ངོ་།།"]},{"type":"verse","number":32,"content":["གྲོང་སྡེའི་ནང་དུ་མངགས་པའི་ཐུགས་སྲས་གཉིས་པོ་ཕར་སོང་བ་དང་ཁོང་གིས་ཇི་ལྟར་གསུངས་པ་བཞིན་དུ་མཐོང༌ཞིང༌།"]},{"type":"verse","number":33,"content":["ཁོ་གཉིས་ཀྱིས་བོང་ཕྲུག་གི་འདོགས་ཐག་འགྲོལ་བཞིན་པའི་སྐབས༌སུ། བོང་ཕྲུག་གི་བདག་པོ་རྣམས་ན༌རེ། ཅིའི་ཕྱིར་བོང་ཕྲུག་འགྲོལ་བ་ཡིན་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":34,"content":["ཁོ་གཉིས་ཀྱིས་བོང་ཕྲུག་འདི་ངེད་ཅག་གི་གཙོ་བོ་ལ་མཁོ་བ་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":35,"content":["ཁོ་གཉིས་ཀྱིས་དེ་ཁྲིད་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་སླེབས་པ༌དང༌། རང་གི་ཕྱི་གོས་བོང་ཕྲུག་གི་རྒྱབ་ཏུ་བཏིངས་ཤིང་ཁོང་ཉིད་བསྐྱོར་ནས་དེ་ལ་བཅིབས་སུ་བཅུག་པ་རེད།"]},{"type":"verse","number":36,"content":["ཁོང་ཉིད་ཕེབས་པའི་དུས་སུ་མི་རྣམས་ཀྱིས་རང་གི་ཕྱི་གོས་ལམ་ནང་དུ་བཀྲམ་པའོ།།"]},{"type":"verse","number":37,"content":["ཡང་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་ཉེ་བར་ཕེབས་པ་དང་སྐྱུ་རུ་རའི་རི་བོ་ལས་མར་འབབ་པའི༌ཚེ། རྗེས་སུ་འབྲང་བའི་མི་ཚོགས་ཀྱིས་ངོ་མཚར་བའི་མཛད་པ་རྣམས་མཐོང་མྱོང༌བས། ཤིན་ཏུ་དགའ་ཞིང་སྐད་ཆེན་པོས་དཀོན་མཆོག་ལ་བསྟོད་པ་འབུལ་བཞིན།"]},{"type":"verse","number":38,"content":["གཙོ་བོའི་མཚན་གྱི་སྒོ་ནས་བྱོན་པའི་རྒྱལ་པོ་ནི་བྱིན་རླབས་ཅན་ཡིན། ནམ་མཁའི་ཞིང་ཁམས་ལ་ཞི་བདེ་དང་། བླ་ན་མེད་པའི་གནས་སུ་གཟི་བརྗིད་ཡོད་པར་གྱུར་ཅིག་ཅེས་ཡང་ཡང་བསྒྲགས་སོ།།"]},{"type":"verse","number":39,"content":["མི་ཚོགས་ཀྱི་ཁྲོད་དུ་ཡོད་པའི་ཕ་རུ་ཤི་པ་འགའ་ཞིག་གིས་སྐྱབས་མགོན་ཡེ་ཤུ༌ལ། སློབ་དཔོན༌ལགས། ཁྱེད་ཀྱིས་རང་གི་རྗེས་འབྲང་པ་རྣམས་ལ་བཀའ་བཀྱོན་གནང་བར་མཛོད་ཅེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":40,"content":["ཁོང་གིས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར༌བྱ་སྟེ། གལ་ཏེ་མི་འདི་རྣམས་ཀྱིས་ཁ་ཅི་ཡང་མི་གྲགས༌ན། རྡོ་འདི་དག་གིས་སྐད་རྒྱག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":41,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དང་ཉེ་བར་ཕེབས་པ༌དང༌། གྲོང་ཁྱེར་དེ་གཟིགས་ནས་ཐུགས་སྐྱོ་བའི་ངང་བཤུམས་ཤིང་གྲོང་ཁྱེར་དེའི་སྐོར་ལ་འདི་སྐད༌དུ།"]},{"type":"verse","number":42,"content":["གལ་སྲིད་དེ་རིང་ཁྱོད་ཀྱིས་ཞི་བདེ་གང་ལ་རག་ལས་པའི་དོན་དེ་ཤེས་ན་ཅི་མ༌རུང་། འོན་ཀྱང་ད་ལྟ་དོན་དེ་སྦས་པ་ཡིན་པས་ཁྱོད་ཀྱིས་མཐོང་བར་མི་འགྱུར།"]},{"type":"verse","number":43,"content":["དུས་ཤིག་སླེབ་ངེས༌ཏེ། ཁྱོད་ཀྱི་དགྲ་བོས་ཕྱོགས་བཞིར་འཐབ་རགས་བརྩིག་ཅིང༌། ཁྱོད་ཀྱི་མཐའ་ནས་བསྐོར་ཏེ་ཕྱོགས་བཞི་ནས་ཁྱོད་ལ་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":44,"content":["ཁྱོད་ཀྱིས་དཀོན་མཆོག་གི་གཟིགས་སྐྱོང་མཛད་པའི་དུས་དེ་མ་རྟོགས༌པས། ཁྱོད་དང་ཁྱོད་ཀྱི་ར་བའི་ནང་དུ་ཡོད་པའི་བུ་ཕྲུག་རྣམས་རྩ་མེད་དུ་བཏང༌ནས། རྡོ་ཕ་བོང་སྟེང་དུ་རྡོ་གཅིག་ཀྱང་མི་ལུས་པར་བཤིག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["མཆོད་ཁང་གཙང་མར་མཛད༌པ།"]},{"type":"verse","number":45,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་ཁང་ནང་དུ་ཕེབས་ཤིང་གནས་དེར་ཡོད་པའི་ཚོང་པ་རྣམས་སྒོའི་ཕྱི་རུ་ཕུད༌དེ།"]},{"type":"verse","number":46,"content":["འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ༌ལས། ངའི་མཆོད་ཁང་ནི་སྨོན་ལམ་ཞུ་སའི་གནས་སུ་འགྱུར་ཞེས་བཀོད་ཡོད༌ཀྱང༌། ཁྱོད་ཅག་གིས་འདི་ནི་ཇག་ཚང་ཞིག་ཏུ་བསྒྱུར་འདུག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":47,"content":["ཁོང་གིས་ཉིན་རེ་བཞིན་མཆོད་ཁང་ནས་ཆོས་གསུངས། འོན་ཀྱང་མཆོད་དཔོན་ཆེན་པོ་རྣམས་དང་མཁན༌པོ། ཡུལ་མིའི་འགོ་དཔོན་བཅས་ཀྱིས་ཁོང་ཉིད་དགྲོང་འདོད༌ཀྱང༌།"]},{"type":"verse","number":48,"content":["མི་ཐམས་ཅད་ཀྱིས་ཁོང་གི་གསུང་ལ་ཞིབ་ཏུ་ཉན་འདུག༌པས། དེ་དག་གིས་ཐབས་ཅི་ཡང་མ་རྙེད༌དོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LUK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LUK/18.json","previousChapterAudioLinks":{},"numberOfVerses":48}