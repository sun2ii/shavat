{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LUK","translationId":"bod_ntb","name":"ལོ་ཀུ","commonName":"ལོ་ཀུ","title":"༄༅། །ལོ་ཀུའི་འཕྲིན་བཟང་།","order":42,"numberOfChapters":24,"sha256":"5c682cf5eca7d56a5e6ec830f96469bd04d6c9bee8bd88bc021ba77495c88c78","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/LUK/24.json","totalNumberOfVerses":1145},"chapter":{"number":20,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་དབང་དང་ནུས་མཐུའི༌སྐོར།"]},{"type":"verse","number":1,"content":["ཡང་ཉིན་ཞིག༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་མཆོད་ཁང་ནང་དུ་མི་ཚོགས་ལ་ཆོས་གསུངས་ཤིང་དཀོན་མཆོག་གི་འཕྲིན་བཟང་སྒྲོག་པའི་དུས༌སུ། མཆོད་དཔོན་ཆེན་པོ་རྣམས་དང་མཁན༌པོ། དཔོན་རིགས་རྒན་པོ་བཅས་མཉམ་དུ་ཁོང་གི་དྲུང་དུ་ཡོང༌སྟེ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་དབང་གང་ལ་བརྟེན་ནས་དོན་འདི་དག་མཛད་པ་ཡིན༌ནམ། སུ་ཞིག་གིས་ཁྱོད་ལ་དབང་འདི་གནང་བ་ཡིན་པ་ངེད་ཅག་ལ་སྨྲ་བར་མཛོད་ཅེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":3,"content":["ཁོང་གིས་འདི་སྐད༌དུ། བདག་གིས་ཀྱང་ཁྱོད་རྣམས་ལ་དྲི་བ་ཞིག་འདོན༌ཏེ།"]},{"type":"verse","number":4,"content":["ཡོ་ཧ་ནན་གྱི་ཁྲུས་གསོལ་དེ་ནམ་མཁའི་ཞིང་ཁམས་དང་མི་ཡུལ་གཉིས་ཀྱི་གང་ནས་བྱུང་བ་ལ་ལན་ཐོབས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":5,"content":["དེ་རྣམས་ཀྱིས་ཕན་ཚུན་གླེང་མོལ་བྱེད༌བཞིན། གལ་ཏེ་ནམ་མཁའི་ཞིང་ཁམས་ནས་བྱུང་བ་ཡིན་ཞེ༌ན། ཁོས་ཁྱོད་རྣམས་ཅིའི་ཕྱིར་ཡོ་ཧ་ནན་ལ་ཡིད་མ་ཆེས་སམ་ཞེས་སྨྲ་ངེས༌ལ།"]},{"type":"verse","number":6,"content":["ཡང་མི་ཡུལ་ནས་བྱུང་བ་ཡིན་ཞེ༌ན། མི་ཐམས་ཅད་ཡོ་ཧ་ནན་དངོས་གནས་ལུང་སྟོན་པ་ཞིག་ཡིན་པར་ཡིད་ཆེས༌པས། མི་རྣམས་ཀྱིས་བདག་ཅག་རྡོ་རུབ་གཏོང་བར་ངེས་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":7,"content":["ཁོ་རྣམས་ན༌རེ། ངེད་ཅག་གིས་གང་ནས་བྱུང་བ་མི་ཤེས་ཞེས་ལན་བཏབ་བོ།།"]},{"type":"verse","number":8,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། དེས་ན་བདག་གིས་ཀྱང་དབང་གང་ལ་བརྟེན་ནས་དོན་འདི་དག་བྱེད་པ་ཁྱོད་ཅག་ལ་སྨྲ་བ་མིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["རྒུན་ཚལ་གླ་མཁན་གྱི༌དཔེ།"]},{"type":"verse","number":9,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དཔེའི་སྒོ་ནས་མི་རྣམས་ལ་འདི་སྐད༌དུ། དེ་ཡང་མི་ཞིག་གིས་རྒུན་ཚལ་ཞིག་བཙུགས་རྗེས་མི་གཞན་ལ་གླས་ཏེ་ཁོ་རང་ཡུལ་གཞན་དུ་སོང་ནས་ཡུན་རིང་ལ་བསྡད་དོ།།"]},{"type":"verse","number":10,"content":["དུས་ལ་བབས༌ཚེ། ཁོང་གིས་གཡོག་པོ་ཞིག་གླ་མཁན་ཚང་ལ་རྒུན་འབྲུམ་གྱི་འབྲས་བུ་ལེན་དུ་མངགས༌ནའང༌། གླ་མཁན་རྣམས་ཀྱིས་གཡོག་པོ་དེ་ལ་གཅར་རྡུང་བྱས་ནས་ལག་སྟོང་དུ་ཕྱིར་བཏང༌།"]},{"type":"verse","number":11,"content":["ཡང་ཁོང་གིས་གཡོག་པོ་གཞན་ཞིག་མངགས་པ༌ན། གླ་མཁན་རྣམས་ཀྱིས་གཡོག་པོ་དེ་ལའང་གཅར་རྡུང་དང་དམའ་འབེབས་བྱས་ཏེ་ལག་སྟོང་དུ་ཕྱིར་བཏང༌།"]},{"type":"verse","number":12,"content":["ཡང་གཡོག་པོ་གསུམ་པ་དེ་མངགས་པ༌ན། གླ་མཁན་རྣམས་ཀྱིས་དེ་ལའང་གཅར་རྡུང་བྱས་ནས་རྨས་ཏེ་ཕྱི་རུ་བསྐྲད།"]},{"type":"verse","number":13,"content":["རྒུན་འབྲུམ་ར་བའི་བདག་པོ་ན༌རེ། ད་ནི་ཅི༌བྱའམ། བདག་གི་གཅེས་པའི་བུ་དེ་མངགས་ན་གླ་མཁན་རྣམས་ཀྱིས་བཀུར་སྟི་བྱེད་ཀྱང་སྲིད་བསམས༌སོ།།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་གླ་མཁན་རྣམས་ཀྱིས་བུ་དེ་མཐོང་ནས་ཕན་ཚུན༌ལ། འདི་ནི་ཕ་ཤུལ་འཛིན་མཁན་ཡིན། ནོར་སྐལ་དེ་དག་བདག་ཅག་ལ་འཐོབ་པའི་ཕྱིར། ཁོ་རང་གསོད་པར་བྱའོ་ཞེས་སྨྲས༌ཏེ།"]},{"type":"verse","number":15,"content":["བུ་དེ་རྒུན་འབྲུམ་ར་བའི་ཕྱི་རུ་བཏོན་ནས་བསད་དོ།། དེས་ན་རྒུན་འབྲུམ་ར་བའི་བདག་པོས་དེ་དག་ལ་ཅི་བྱེད་པར་འགྱུར་རམ་ཞེ༌ན།"]},{"type":"verse","number":16,"content":["ཁོང་ཉིད་ཕེབས་ཡོང་ནས་གླ་མཁན་རྣམས་འཇོམས་པར་མཛད༌དེ། རྒུན་འབྲུམ་ར་བ་མི་གཞན་རྣམས་ལ་སྤྲོད་པར་བྱེད་ཅེས་གསུངས་པ༌དང༌། མི་རྣམས་ཀྱིས་གསུང་དེ་ཐོས་ནས་དེ་ལྟར་བྱ་མི་རུང་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":17,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་རྣམས་ལ་གཟིགས་ནས་འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"བཟོ་བ་རྣམས་ཀྱིས་སྤངས་པའི༌རྡོ།།","poem":1},{"lineBreak":true},{"text":"ཁང་པའི་ཟུར་གྱི་རྨང་རྡོ༌ཡིན།།","poem":1},"ཞེས་གསུངས་ཡོད་པའི་དོན་ཅི་ཡིན༌ནམ།"]},{"type":"verse","number":18,"content":["མི་སུ་ཞིག་རྡོ་དེའི་སྟེང་དུ་ལྷུང༌ན། མི་དེ་ནི་དུམ་བུར་འགྱུར། ཡང་རྡོ་དེ་མི་སུ་ཞིག་གི་སྟེང་དུ་ལྷུང༌ན། མི་དེའང་རྡུལ་དུ་བརླག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཁྲལ་འཇལ་བའི༌སྐོར།"]},{"type":"verse","number":19,"content":["དེ་ནས་མཁན་པོ་དང་མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་གོང་གི་དཔེ་དེ་ནི་རང་ཉིད་ལ་གསུངས་པ་ཤེས༌ནས། དེ་མ་ཐག་ཏུ་ཁོང་ཉིད་འཛིན་པར་བསམས་ཀྱང་མི་ཚོགས་ལ་འཇིགས༌སོ།།"]},{"type":"verse","number":20,"content":["སྐྱབས་མགོན་ཡེ་ཤུར་ལྐོག་ལྟ་བྱས་ནས་ཁོང་གི་གསུང་ལས་གླགས་བཙལ་ཏེ་སྤྱི་དཔོན་གྱི་ཁྲིམས་དང་དབང་ལ་སྤྲོད༌ཆེད། མི་གཞུང་དྲང་ཡིན་ཁུལ་བྱེད་པའི་མྱུལ་མ་འགའ་ཁོང་གི་དྲུང་དུ་བཏང༌ངོ་།།"]},{"type":"verse","number":21,"content":["དེ་རྣམས་ན༌རེ། སློབ་དཔོན༌ལགས། ཁྱེད་ཀྱིས་གསུངས་པ་དང་བསྟན་པ་ནི་བདེན་པ་ཡིན་ཞིང་མི་ཀུན་ལ་ཕྱོགས་རིས་མེད་པར་དཀོན་མཆོག་གི་ལམ་ཡང་དག་པར་བདེན་པར་སྟོན་པ་ངེད་རྣམས་ཀྱིས་ཤེས་པ་ཡིན།"]},{"type":"verse","number":22,"content":["ད་ལྟ་ངེད་ཅག་གིས་སེ་བཟིར་ལ་ཁྲལ་འཇལ་རུང་ངམ་མི་རུང་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":23,"content":["ཁོང་གིས་དེ་རྣམས་ཀྱི་གཡོ་སྒྱུ་མཁྱེན་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":24,"content":["བདག་ལ་དངུལ་སྒོར་ཞིག་སྟོན༌ཅིག དངུལ་སྒོར་སྟེང་གི་རི་མོ་དང་ཡི་གེ་འདི་སུའི་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན། དེ་རྣམས་ཀྱིས་སེ་བཟིར་གྱི་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":25,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། དེས་ན་གང་ཞིག་སེ་བཟིར་གྱི་ཡིན་ན་དེ་ནི་སེ་བཟིར་ལ་ཕུལ༌དང༌། གང་ཞིག་དཀོན་མཆོག་གི་ཡིན་ན་དེ་ནི་དཀོན་མཆོག་ལ་ཕུལ་ཅིག་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":26,"content":["དེ་རྣམས་ཀྱིས་མི་ཚོགས་ཀྱི་མདུན་ནས་ཁོང་ལ་ལོག་བཤད་བྱེད་དུ་འཇུག་མ་ནུས༌ཤིང༌། ཁོང་གི་བཀའ་ལན་ལ་ངོ་མཚར་བར་གྱུར་པས་ཁ་ཅི་ཡང་མ་གྲགས༌སོ།།"]},{"type":"heading","content":["སླར་གསོན་པའི་དོན་དང་བཟའ་ཟླའི༌སྐོར།"]},{"type":"verse","number":27,"content":["སླར་གསོན་པའི་དོན་",{"noteId":11},"དེ་མེད་ཟེར་མཁན་སཱ་ཅུ་སེ་པ་རྣམས་ཁོང་གི་དྲུང་དུ་ཡོང་སྟེ་ན༌རེ།"]},{"type":"verse","number":28,"content":["སློབ་དཔོན༌ལགས། མོ་ཤེའི་མདོ༌ལས། གལ་སྲིད་སྐྱེས་པ་ཞིག་ལ་བུ་ཕྲུག་མེད་པར་ཤི་སྟེ་ཆུང་མ་གཅིག་པུར་ལུས༌ན། དེའི་གཅུང་པོས་ཆུང་མ་དེ་བླངས་ནས་གཅེན་པོའི་དོན་དུ་རིགས་རྒྱུད་སྤེལ་དགོས་ཞེས་གསུངས་ཡོད།"]},{"type":"verse","number":29,"content":["སྔོན་ཆད་སྤུན་བདུན་ཡོད་པ་ལས་སྤུན་ཆེ་བས་ཆུང་མ་ཞིག་བླངས་ནས་བུ་ཕྲུག་མེད་པར༌ཤི་བ་དང་།"]},{"type":"verse","number":30,"content":["སྤུན་གཉིས་པ་དང་གསུམ་པས་ཀྱང་བུད་མེད་དེ་ཆུང་མར་བླངས་མྱོང་བ༌དང༌། དེ་བཞིན་དུ་སྤུན་བདུན་པོས་དེ་ལྟར་བྱས་ནས་བུ་ཕྲུག་མ་བྱུང་བར༌ཚང་མ་ཤི་བ་རེད།"]},{"type":"verse","number":32,"content":["མཇུག་མཐར་བུད་མེད་དེའང༌ཤིའོ།།"]},{"type":"verse","number":33,"content":["དེས་ན་གཤིན་པོ་རྣམས་སླར་གསོན་པར་འགྱུར་བའི་དུས་དེ་སླེབས༌ཚེ། སྤུན་བདུན་པོས་བུད་མེད་དེ་ཆུང་མར་བླངས་མྱོང་བས་ཁོ་མོ་ནི་སྤུན་བདུན་ལས་སུ་ཞིག་གི་ཆུང་མ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":34,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བསྐལ་པ་འདི་ལ་གཏོགས་པའི་མི་རྣམས་ཀྱིས་བག་མ་ཕར་བསྐྱལ་ཚུར་ལེན་བྱེད༌ཀྱང༌།"]},{"type":"verse","number":35,"content":["བསྐལ་པ་འབྱུང་འགྱུར་འཐོབ་པ་དང་གཤིན་པོ་སླར་གསོན་པར་འོས་པ་རྣམས་ཀྱིས་བག་མ་ཕར་བསྐྱལ་ཚུར་ལེན་མི་བྱེད།"]},{"type":"verse","number":36,"content":["རྒྱུ་མཚན་ནི་དེ་རྣམས་ལ་ནམ་ཡང་འཆི་བ་མེད་པར་ཕོ་ཉ་རྣམས་དང་མཚུངས༌ཤིང༌། སླར་གསོན་པ་རྣམས་ཡིན་པས་དཀོན་མཆོག་གི་བུ་ཕྲུག་ཏུ་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":37,"content":["འོན་ཀྱང་གཤིན་པོ་རྣམས་སླར་གསོན་ངེས་པའི་སྐོར༌ལ། མོ་ཤེ་ཡིས་ཚེར་སྡོང་གི་སྐོར་བཀོད་པའི་མདོ་ལས། གཙོ་བོ་ལ་ཨབ་ར་ཧམ་གྱི་དཀོན་མཆོག༌དང༌། ཨི་སཱག་གི་དཀོན༌མཆོག ཡ་ཀོབ་ཀྱི་དཀོན་མཆོག་ཅེས་གསོལ་བ་ལས་གསལ་པོར་བསྟན་པ་ཡིན།"]},{"type":"verse","number":38,"content":["དཀོན་མཆོག་ནི་གཤིན་པོ་རྣམས་ཀྱི་དཀོན་མཆོག་མ་ཡིན༌པར། གསོན་པོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡིན༌ཏེ། ཁོང་གི་དྲུང་དུ་མི་ཐམས་ཅད་གསོན་པོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":39,"content":["ཡང་མཁན་པོ་འགའ་ཞིག་ན༌རེ། སློབ་དཔོན༌ལགས། ཁྱེད་ཀྱིས་ལེགས་པར་གསུངས་པ་ཡིན་ཞེས་ཞུས༌ཤིང༌།"]},{"type":"verse","number":40,"content":["ཕྱིས་སུ་དེ་རྣམས་ཀྱིས་ཁོང་ལ་དྲི་བ་ཅི་ཡང་ཞུ་མ་ཕོད༌དོ།།"]},{"type":"heading","content":["རྒྱལ་པོ་དཱ་བིད་ཀྱི་རིགས་སྲས༌སྐོར།"]},{"type":"verse","number":41,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། མཱ་ཤི་ཀ་ནི་ཇི་ལྟར་དཱ་བིད་ཀྱི་རིགས་སྲས་ཡིན་པར་སྨྲའམ།"]},{"type":"verse","number":42,"content":["དཱ་བིད་ཀྱིས་གསུང་མགུར་གྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དཀོན་མཆོག་གིས་ནི་ང་ཡི་གཙོ་བོ༌ལ།།","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"བདག་གིས་ཁྱོད་ཀྱི་བསྟན་དགྲ་ཐམས་ཅད༌ཀུན།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཞབས་ཀྱི་སྟེགས་སུ་བསྒྱུར་བའི༌བར།།","poem":1},{"lineBreak":true},{"text":"བདག་གི་གཡས་སུ་བཞུགས་ཤིང་སྒུག་པར༌བྱའོ།།","poem":1},"ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":44,"content":["དཱ་བིད་ཀྱིས་ཁོང་ལ་གཙོ་བོ་ཞེས་ཞུས༌ན། ཁོང་ནི་དཱ་བིད་ཀྱི་རིགས་སྲས་སུ་ཇི་ལྟར་གྱུར་པ་ཡིན་ནམ་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":45,"content":["མི་ཐམས་ཅད་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་གསུང་ལ་ཉན་བཞིན་པའི་དུས༌སུ། ཁོང་གིས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ།"]},{"type":"verse","number":46,"content":["མཁན་པོ་རྣམས་ལ་དོགས་པར༌གྱིས། དེ་རྣམས་ཀྱིས་ལྭ་རིང་པོ་གྱོན་ཏེ་ཕར་འགྲོ་ཚུར་འོང་བྱེད་པ༌དང༌། ཁྲོམ་སྲང་ནས་མི་རྣམས་ཀྱི་བསྙེན་བཀུར་འཐོབ་པར་དགའ་ཞིང་། ཆོས་ཁང་དང་གསོལ་སྟོན་དུ་གྲལ་མགོ་ནས་སྡོད་པར་མོས་པ་ཡིན།"]},{"type":"verse","number":47,"content":["མི་དེ་རྣམས་ཀྱིས་ཡུགས་མོ་རྣམས་ཀྱི་ཁང་པ་དང་བཅས་པའི་རྒྱུ་རྫས་ཧམ་བཟུང་བྱེད་ཅིང་སྨོན་ལམ་རིང་པོ་འདེབས་ཁུལ་བྱེད༌པས། མི་དེ་དག་ལ་ལྷག་ཏུ་ཉེས་ཆད་ལྕི་མོ་འཕོག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":11,"caller":"+","text":"སླར་གསོན་པའི་དོན་ཞེས་པ་ནི་དམ་པའི་གསུང་རབ་ལས་སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་བཀྲོངས་རྗེས་ཉིན་གསུམ་པ་ལ་སླར་གསོན་ཞིང་ཕྱིར་དཀོན་མཆོག་གི་གཡས་སུ་བཞུགས་པ་ཡིན་ཞེས་འབྱུང༌ལ། ཕྱིས་སུ་སྐྱབས་མགོན་ཡེ་ཤུ་སླར་ཡང་འཇིག་རྟེན་འདིར་འབྱོན་ངེས་ཡིན༌ཏེ། དེའི་དུས་སུ་སྔར་ཤི་ཟིན་པའི་མི་རྣམས་སླར་གསོན་པར་མཛད་ངེས་པས་སྐབས་འདིར་ཡང་དེའི་དོན༌ཡིན། (དམ་པའི་གསུང་རབ་ཀྱི་ཀོ་རིན་ཐུ་པའི་འཕྲིན་ཡིག་དང་པོའི་ལེའུ་བཅོ་ལྔ་པའི་ཚིག་རྐང་བཅུ་གཉིས་ནས་ང་བརྒྱད་བར་དུ༌གསལ།)","reference":{"chapter":20,"verse":27}}]},"thisChapterLink":"/api/bod_ntb/LUK/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LUK/19.json","previousChapterAudioLinks":{},"numberOfVerses":46}