{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LUK","translationId":"bod_ntb","name":"ལོ་ཀུ","commonName":"ལོ་ཀུ","title":"༄༅། །ལོ་ཀུའི་འཕྲིན་བཟང་།","order":42,"numberOfChapters":24,"sha256":"5c682cf5eca7d56a5e6ec830f96469bd04d6c9bee8bd88bc021ba77495c88c78","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/LUK/24.json","totalNumberOfVerses":1145},"chapter":{"number":4,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུར་ཉམས་ཚོད་བླངས༌པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུར་དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁྱབ་ཅིང་ཡོར་དན་གཙང་པོ་ནས་ཕྱིར་ཕེབས་པ༌ན། དམ་པའི་ཐུགས་ཉིད་ཀྱིས་ཁོང་ཉིད་དབེན་སྟོང་ཞིག་ཏུ་ཁྲིད་པ༌དང༌།"]},{"type":"verse","number":2,"content":["ཉིན་བཞི་བཅུའི་རིང་ལ་བདུད་ཀྱིས་ཁོང་ལ་ཉམས་ཚོད་བླངས་སོ།། ཉིན་དེ་དག་གི་རིང་ལ་ཁོང་གིས་ཞལ་ཟས་ཅི་ཡང་མ་བཞེས༌པས། ཉིན་དེ་དག་མཇུག་རྫོགས་སྐབས་ཁོང་ནི་བཀྲེས་ཤིང་ལྟོགས་པར་གྱུར་ཏོ།།"]},{"type":"verse","number":3,"content":["བདུད་ན༌རེ། ཁྱེད་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན༌ན། རྡོ་འདིར་བཀའ་གནང་ནས་བག་ལེབ་ཏུ་བསྒྱུར་ཅིག་ཅེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ༌ལས། མི་ནི་བག་ལེབ་ཁོ་ནར་བརྟེན་ནས་འཚོ་བ་མ་ཡིན་ནོ་ཞེས་བཀོད་ཡོད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":5,"content":["ཡང་བདུད་ཀྱིས་ཁོང་ཉིད་རི་མཐོན་པོ་ཞིག་ཏུ་ཁྲིད་ནས་སྐད་ཅིག་ཙམ་ལ་འཇིག་རྟེན་གྱི་རྒྱལ་ཁམས་ཐམས་ཅད་བསྟན་ཏེ་ན༌རེ།"]},{"type":"verse","number":6,"content":["ངས་དབང་ཐང་དང་གཟི་བརྗིད་འདི་མཐའ་དག་ཁྱེད་ལ་འབུལ་བར༌བྱ། རྒྱུ་མཚན་ནི་འདི་ཐམས་ཅད་སྔར་ནས་བདག་ལ་སྤྲད་ཡོད༌པས། བདག་གིས་སུ་ཞིག་ལ་སྟེར་འདོད་ན་དེ་ལ་སྟེར་ངེས༌ཡིན།"]},{"type":"verse","number":7,"content":["གལ་ཏེ་ཁྱེད་ཀྱིས་བདག་ལ་ཕྱག་བཙལ་ན་འདི་ཐམས་ཅད་ཁྱེད་ལ་དབང་བ་ཡིན་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":8,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ༌ལས། ཁྱོད་ཀྱིས་གཙོ་བོ་སྟེ་རང་གི་དཀོན་མཆོག་ལ་ཕྱག་འཚལ་ཞིང་ཁོང་གཅིག་པུར་བསྙེན་བཀུར་བྱེད་དགོས་ཞེས་བཀོད་འདུག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":9,"content":["ཡང་བདུད་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ཡེ་རུ་སཱ་ལེམ་དུ་ཁྲིད༌ནས། མཆོད་ཁང་གི་རྩེ་རུ་སྡོད་དུ་བཅུག༌སྟེ་ན་རེ། གལ་ཏེ་ཁྱེད་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་ན་འདི་ནས་མར་མཆོངས༌ཤིག"]},{"type":"verse","number":10,"content":["རྒྱུ་མཚན་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་དཀོན་མཆོག་གིས་རང་གི་ཕོ་ཉ་རྣམས་ལ་བཀའ་གནང་སྟེ་ཁྱེད་རང་བསྲུང་བར་ངེས་ཞེས་པ༌དང༌།"]},{"type":"verse","number":11,"content":["ཁྱེད་ཀྱི་ཞབས་རྡོ་ལའང་མི་ཐོགས་པའི༌ཕྱིར། ཕོ་ཉ་དེ་རྣམས་ཀྱི་ལག་པས་ཁྱེད་རང་ཡར་འདེགས་པར་འགྱུར་ཞེས་ཀྱང་བཀོད་འདུག་ཅེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":12,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌གསུངས་པ་སྟེ། གསུང་རབ་ཀྱི་མདོ་ལས། ཁྱོད་ཀྱིས་གཙོ་བོ་སྟེ་རང་གི་དཀོན་མཆོག་ལ་ཚོད་བགམ་མ་བྱེད་ཅེས་གསུངས་འདུག་ཅེས་པའོ།།"]},{"type":"verse","number":13,"content":["བདུད་ཀྱིས་ཐབས་སྣ་ཚོགས་ཀྱི་སྒོ་ནས་ཁོང་ལ་ཉམས་ཚོད་བླངས་ཚར༌རྗེས། རེ་ཞིག་ཁོང་དང་ཁ་བྲལ་ཏོ།།"]},{"type":"heading","content":["ག་ལིལ་ཡུལ་དུ་བཀའ་སྒྲོག་པའི་འགོ་རྩོམ༌པ།"]},{"type":"verse","number":14,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ནུས་མཐུའི་ངང་ནས་ཕྱིར་ག་ལིལ་ཡུལ་དུ་ཕེབས་པ༌དང༌། ཁོང་གི་མཚན་སྙན་གྲགས་ཀྱང་ག་ལིལ་ཡུལ་གྱི་མཐའ་འཁོར་ཀུན་ལ་ཁྱབ།"]},{"type":"verse","number":15,"content":["ཁོང་གིས་ཆོས་ཁང་སོ་སོ་ནས་ཆོས་གསུངས་པ་དང་མི་ཀུན་གྱིས་ཁོང་ལ་བསྟོད་བསྔགས་བརྗོད༌དོ།།"]},{"type":"verse","number":16,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕྱིར་རང་ཉིད་ནར་སོན་པའི་གནས་ཏེ་ནཱ་ཙ་རེལ་གྲོང་རྡལ་དུ་ཕེབས་ཤིང་ངལ་གསོ་བའི་ཉིན་མོ་ལའང་རང་གི་ནམ་རྒྱུན་གྱི་སྲོལ་ལྟར་ཆོས་ཁང་དུ་ཕེབས༌པ་དང་། ཁོང་གིས་གསུང་རབ་ཀློག་ཕྱིར་ཡར་བཞེངས་པ༌ན།"]},{"type":"verse","number":17,"content":["མི་ཞིག་གིས་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་མདོ་དེ་ཁོང་ལ་ཕུལ༌ཞིང༌། ཁོང་གིས་མདོ་དེའི་ཁ་ཕྱེས་པ༌ན། དེ་ལས་བཀོད་ཡོད་པའི་ཚན་པ་ཞིག་རྙེད་པ་ནི་འདི་ལྟ༌སྟེ།"]},{"type":"verse","number":18,"content":[{"text":"གཙོ་བོའི་ཐུགས་ཉིད་ང་ཡི་སྟེང་དུ༌བཞུགས།།","poem":1},{"lineBreak":true},{"text":"དབུལ་ཕོངས་རྣམས་ལ་འཕྲིན་བཟང་སྒྲོག་པའི༌ཕྱིར།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་བདག་ལ་བྱུགས་ཤིང༌བསྐོས་པ་འོ།།","poem":1},{"lineBreak":true},{"text":"བཙོན་པ་རྣམས་ལ་ཐར་པའི་འཕྲིན་བཟང༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ལོང་བ་གསོ་བའི་འཕྲིན་བཟང་སྒྲོག་ཕྱིར༌དང༌།།","poem":1},{"lineBreak":true},{"text":"མནར་བ་རྣམས་ནི་སྒྲོལ་དུ་འཇུག་པ༌དང༌།།","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ཁོང་གི་ཐུགས་རྗེའི་གནམ་ལོ་སྒྲོག་ཕྱིར༌དུ།།","poem":1},{"lineBreak":true},{"text":"གཙོ་བོ་ཁོང་གིས་བདག་ནི་མངགས་པ༌ཡིན།།","poem":1},"ཞེས་པ་དེ་བཀླགས༌སོ།།"]},{"type":"verse","number":20,"content":["ཁོང་གིས་དཔེ་ཆ་བསྒྲིལ་ནས་ཕྱིར་ཆོས་ཁང་གི་གཉེར་པ་ལ་བསྩལ་ཏེ་བཞུགས༌ཤིང༌། ཆོས་ཁང་དུ་ཡོད་པའི་མི་ཐམས་ཅད་ཀྱིས་ཁོང་ལ་མིག་ཅེ་རེར་བལྟས་པ༌དང༌།"]},{"type":"verse","number":21,"content":["ཁོང་གིས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ་འདི་ནི་དེ་རིང་ཁྱོད་ཅག་གིས་ཐོས་པའི་དུས་སུ་གྲུབ་པ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":22,"content":["མི་ཐམས་ཅད་ཀྱིས་ཁོང་ལ་བསྟོད་བསྔགས་བརྗོད་ཅིང་ཁོང་གི་ཞལ་ལས་གསུངས་པའི་ཚིག་སྙན་མོ་ཐོས་ནས་ངོ་མཚར་བར་གྱུར། ཁོ་རྣམས་ན༌རེ། འདི་ནི་ཡོ་སེབ་ཀྱི་བུ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":23,"content":["ཡང་ཁོང་གིས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་ཅག་ན༌རེ། སྨན་པ༌ལགས། ཁྱོད་ཀྱིས་རང་ཉིད་གསོ་བར་བྱོས་ཞེས་པའི་ཁ་དཔེ་འདི་ང་ལ་སྦྱར་ངེས༌ཤིང༌། ཁྱོད་ཀྱིས་ཀཱ་ཕར་ན་ཧུམ་ནས་བྱས་པའི་བྱ་བ་ངེད་ཅག་གིས་ཐོས་པ་དེ་རྣམས་རང་གི་ཕ་ཡུལ་འདི་ནས་ཀྱང་བྱོས་ཤིག་ཅེས་བདག་ལ་སྨྲ་བར་འགྱུར་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":24,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ངས་ཁྱོད་ཅག་ལ་བདེན་པར་སྨྲ༌སྟེ། ལུང་སྟོན་པ་སུ་ཞིག་ལའང་རང་ཡུལ་ནས་བརྩི་བཀུར་མི་འཐོབ།"]},{"type":"verse","number":25,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ་སྟེ། ཡང་ཨེ་ལི་ཡཱའི་དུས་སུ། ལོ་གསུམ་དང་ཟླ་བ་དྲུག་གི་རིང་ལ་ཐན་པ་བྱུང་བས། ས་ཆ་ཡོངས་ལ་མུ་གེ་ཆེན་པོ་བྱུང་བ་དང་ཡེས་ར་ཨེལ་ཡུལ་དུ་ཡུགས་མོ་མང་པོ་ཡོད༌ནའང༌།"]},{"type":"verse","number":26,"content":["ཨེ་ལི་ཡཱ་ནི་ཡུགས་མོ་དེ་རྣམས་ཀྱི་གམ་དུ་མ་མངགས༌པར། ཚི་ཏུན་ཡུལ་གྱི་ཁོང་གཏོགས་སཱ་རེ་ཕད་ཀྱི་ཡུགས་མོ་དེ་ཁོ་ནའི་གམ་དུ་མངགས།"]},{"type":"verse","number":27,"content":["ཡང་ལུང་སྟོན་པ་ཨེ་ལི་ཤཱའི་དུས་སུ། ཡེས་ར་ཨེལ་གྱི་ས་ཆར་མཛེ་ནད་ཅན་མང་པོ་ཡོད༌ནའང༌། ཁོང་གིས་དེ་རྣམས་ལས་གཅིག་ཀྱང་གཙང་མར་མ་མཛད༌པར། སིར་ཡཱ་ཡུལ་གྱི་ནཱ་ཨ༌མན་ཁོ་ན་གཙང་མར་མཛད་ཅེས་གསུངས་པ་དང་།"]},{"type":"verse","number":28,"content":["ཆོས་ཁང་དུ་ཡོད་པའི་མི་ཐམས་ཅད་ཀྱིས་གཏམ་དེ་ཐོས་རྗེས་ཤིན་ཏུ་ཁྲོས༌ཏེ།"]},{"type":"verse","number":29,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་གྲོང་རྡལ་ནས་ཕྱིར་བསྐྲད་པ༌དང༌། གྲོང་རྡལ་དེ་ནི་རི་སྟེང་དུ་ཆགས་ཡོད་ལ་མི་དེ་དག་གིས་ཁོང་ཉིད་གཡང་གཟར་དུ་འཕེན་ཕྱིར་བྲག་ཁ་རུ་ཁྲིད༌ནའང༌།"]},{"type":"verse","number":30,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མི་དེ་རྣམས་ཀྱི་དཀྱིལ་ནས་ཐད་ཀར་ཕེབས༌སོ།།"]},{"type":"heading","content":["གདོན་འདྲེ་བསྐྲད་པ།"]},{"type":"verse","number":31,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མར་ག་ལིལ་ཡུལ་གྱི་གྲོང་ཁྱེར་ཀཱ་ཕར་ན་ཧུམ་དུ་ཕེབས་པ༌དང༌། ངལ་གསོ་བའི་ཉིན་མོར་མི་རྣམས་ལ་ཆོས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":32,"content":["ཁོང་གིས་གསུངས་པའི་ཆོས་ལ་དབང་དང་ལྡན་པས་ཐོས་མཁན་རྣམས་ངོ་མཚར་བར་གྱུར་ཏོ།།"]},{"type":"verse","number":33,"content":["དུས༌དེར། ཆོས་ཁང་དེ་རུ་གདོན་འདྲེས་བཟུང་བའི་མི་ཞིག་ཡོད་པ་དེས་སྐད་ཆེན༌པོས།"]},{"type":"verse","number":34,"content":["ཀྱེ། ནཱ་ཙ་རེལ་པ་ཡེ༌ཤུ། ཁྱེད་དང་ངེད་ཅག་ལ་འབྲེལ་བ་ཅི་མཆིས༌སམ། ཁྱེད་རང་ངེད་རྣམས་འཇོམས་པར་ཕེབས༌སམ། ངས་ཁྱེད་རང་སུ་ཡིན་པ་ཤེས༌ཏེ། ཁྱེད་ནི་དཀོན་མཆོག་གི་སྐྱེས་བུ་དམ་པ་དེ་ཉིད་ཡིན་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":35,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་གདོན་འདྲེ་དེ་ལ་འདི་སྐད༌དུ། ཁ་རོག་ཏུ་སྡོད༌ཅིག ཁྱོད་ནི་ཁོའི་ལུས་ནས་ཕྱིར་བུད་ཅིག་ཅེས་བཀའ་བཀྱོན་གནང་བ༌ན། གདོན་འདྲེ་དེས་མི་རྣམས་ཀྱི་མདུན་དུ་མི་དེ་ས་རུ་བསྒྱེལ་ནས་ཕྱི་རུ་ཐོན་ཞིང་མི་དེར་གནོད་འཚེ་ཅི་ཡང་མ་བྱས་སོ།།"]},{"type":"verse","number":36,"content":["མི་ཐམས་ཅད་ཧ་ལས་ཏེ་ཕན་ཚུན་ལ་བཀའ་འདི་ནི་ཅི་ཡིན༌ནམ། ཁོང་གིས་དབང་དང་མཐུ་ལ་བརྟེན་ནས་གདོན་འདྲེ་རྣམས་ལ་བཀའ་གནང་ཞིང་གདོན་འདྲེ་ཡང་ཕྱིར་བུད་དོ་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":37,"content":["དེ་ནས་ཁོང་གི་མཚན་སྙན་གྲགས་མཐའ་འཁོར་གྱི་ཡུལ་གྲུ་ཀུན་ཏུ་ཁྱབ༌བོ།།"]},{"type":"heading","content":["མི་མང་པོའི་ནད་གསོས༌པ།"]},{"type":"verse","number":38,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཡར་བཞེངས་ཤིང་ཆོས་ཁང་ནས་ཕྱིར་བུད་དེ་སི་མོན་གྱི་ཁྱིམ་དུ་ཕེབས་པ༌དང༌། སི་མོན་གྱི་སྒྱུག་མོར་ཚ་ནད་དྲག་པོ་བྱུང་ཡོད་པས་ཁྱིམ་མི་རྣམས་ཀྱིས་དོན་དེ་ཁོང་ལ་ཞུས་སོ།།"]},{"type":"verse","number":39,"content":["ཁོང་ཉིད་ཁོ་མོའི་གམ་དུ་ཡར་བཞེངས་ནས་ཚ་ནད་ལ་བཀའ་བཀྱོན་མཛད་པ༌ན། ཁོ་མོའི་ཚ་བཞག་ཅིང་དེ་མ་ཐག་ཡར་ལངས་ནས་ཁོང་རྣམས་ལ་ཞབས་ཕྱི་བསྒྲུབས།"]},{"type":"verse","number":40,"content":["ཉི་མ་ནུབ་དུས་མི་རྣམས་ཀྱིས་ནད་རིགས་སྣ་ཚོགས་ཅན་གྱི་ནད་པ་ཐམས་ཅད་ཁོང་གི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌དང༌། ཁོང་གིས་དེ་དག་རེ་རེའི་ལུས་ལ་ཕྱག་བཞག་སྟེ་ནད་ལས་གསོས་པའོ།།"]},{"type":"verse","number":41,"content":["གདོན་འདྲེ་རྣམས་ཀྱང་མི་མང་པོའི་ལུས་ནས་ཕྱི་རུ་ཐོན་ཏེ་སྐད་ཆེན་པོས་ཁྱེད་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་ཞེས་འུར་བརྒྱབ་པ༌དང༌། གདོན་འདྲེ་དེ་དག་གིས་ཁོང་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་པ་ཤེས༌པས། སྐྱབས་མགོན་ཡེ་ཤུས་དེ་དག་ལ་བཀའ་བཀྱོན་མཛད་ཅིང་སྐད་ཆ་སྨྲ་རུ་མ་བཅུག་གོ།"]},{"type":"verse","number":42,"content":["ནམ་ལངས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུ་ཡར་བཞེངས་ཏེ་དབེན་གནས་ཤིག་ཏུ་ཕེབས༌ཤིང༌། མི་ཚོགས་ཀྱིས་ཁོང་ཉིད་བཙལ་ནས་ཁོང་གི་དྲུང་དུ་ཡོང༌སྟེ། ཁོ་རྣམས་དང་ཁ་མི་འབྲལ་བའི་ཕྱིར་ཁོང་ཉིད་འགོག་འདོད༌ཀྱང༌།"]},{"type":"verse","number":43,"content":["ཁོང་གིས་དེ་རྣམས་ལ་ང་རང་ནི་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་ཆོས་སྒྲོག་ཏུ་མངགས་པ་ཡིན༌པས། གྲོང་རྡལ་གཞན་དག་ལའང་བསྒྲག་དགོས་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":44,"content":["ཁོང་གིས་ཡ་ཧུ་དཱ་པའི་ཡུལ་གྱི་ཆོས་ཁང་མང་པོ་ནས་ཀྱང་ཆོས་བསྒྲགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/LUK/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LUK/3.json","previousChapterAudioLinks":{},"numberOfVerses":44}