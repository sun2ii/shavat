{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"LUK","translationId":"bod_ntb","name":"ལོ་ཀུ","commonName":"ལོ་ཀུ","title":"༄༅། །ལོ་ཀུའི་འཕྲིན་བཟང་།","order":42,"numberOfChapters":24,"sha256":"5c682cf5eca7d56a5e6ec830f96469bd04d6c9bee8bd88bc021ba77495c88c78","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bod_ntb/LUK/24.json","totalNumberOfVerses":1145},"chapter":{"number":5,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་སྲས་སྔ་མའི་སྐོར།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མཚོ་གེན་ནེ་སཱ་རེལ་",{"noteId":5},"གྱི་འགྲམ་དུ་བཞུགས་པའི་སྐབས༌སུ། མི་ཚོགས་ཀྱིས་དཀོན་མཆོག་གི་བཀའ་ལ་མཉན་ཕྱིར་འཚང་ཁ་བརྒྱབ་སྟེ་ཁོང་གི་མཐའ་ནས་བསྐོར།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་མཚོ་འགྲམ་དུ་མཚོ་གྲུ་གཉིས་ཡོད་པ་གཟིགས་ཤིང་ཉ་པ་རྣམས་མཚོ་གྲུ་དང་ཁ་བྲལ་ནས་དྲ་རྒྱ་འཁྲུད་བཞིན་ཡོད་དོ།།"]},{"type":"verse","number":3,"content":["མཚོ་གྲུ་རྣམས་ལས་གཅིག་ནི་སི་མོན་གྱི་ཡིན་པ་དང་། ཁོང་ཉིད་དེའི་ནང་དུ་ཕེབས༌ཤིང༌། དེ་ལ་མཚོ་འགྲམ་ནས་ཅུང་ཙམ་ཕར་སྐྱོད་ཅིག་ཅེས་གསུངས་པ༌དང༌། ཁོང་ཉིད་གྲུ་དེར་བཞུགས་ཏེ་མི་ཚོགས་ལ་ཆོས་གསུངས་སོ།།"]},{"type":"verse","number":4,"content":["ཁོང་གིས་ཆོས་གསུངས་ཚར་རྗེས་སི་མོན་ལ་འདི་སྐད༌དུ། མཚོ་གཏིང་ཟབ་པའི་གནས་སུ་གྲུ་སྐྱོད༌ཅིག དྲ་རྒྱ་འཕངས་ནས་ཉ་ཟུངས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":5,"content":["སི་མོན་ན༌རེ། སྟོན་པ༌ལགས། ངེད་ཅག་གིས་ཞག་གང་བོར་དཀའ་སྡུག་མྱངས་ནའང་ཅི་ཡང་མ༌ཟིན། འོན་ཀྱང་ཁྱེད་ཀྱིས་གསུངས་པ་བཞིན་དྲ་རྒྱ་མར་གཏོང་བར་བྱ་ཞེས་སྨྲས༌ཤིང༌།"]},{"type":"verse","number":6,"content":["ཁོ་རྣམས་ཀྱིས་དེ་ལྟར་དྲ་རྒྱ་བཏང་བ་དང་ཉ་ཤིན་ཏུ་མང་པོ་ཟིན་ཏེ་དྲ་རྒྱའང་ཆད་ལ་ཉེ་བ་ཙམ་བྱུང༌བས།"]},{"type":"verse","number":7,"content":["མཚོ་གྲུ་གཞན་དུ་ཡོད་པའི་གྲོགས་རྣམས་ལ་རོགས་བྱེད་དུ་ཡོང་བར་ལག་བརྡ་བྱས་པ༌དང༌། དེ་རྣམས་ཀྱང་ཚུར་ཡོང་ཞིང་མཚོ་གྲུ་གཉིས་པོར་ཉས་བཀང་སྟེ་མཚོ་གྲུ་ཡང་ཆུ་རུ་ནུབ་ལ་ཉེ་བ་ཙམ་བྱུང༌།"]},{"type":"verse","number":8,"content":["སི་མོན་པེ་ཏྲོས་དོན་དེ་མཐོང་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཞབས་དྲུང་དུ་ཕྱག་བཙལ་ཏེ་འདི་སྐད༌དུ། གཙོ་བོ༌ལགས། བདག་ནི་མི་སྡིག་ཅན་ཞིག་ཡིན༌པས། ཁྱེད་རང་ང་དང་བྲལ་ནས་ཕེབས་རོགས་ཞེས་ཞུས་སོ།།"]},{"type":"verse","number":9,"content":["ཁོ་དང་མཉམ་དུ་ཡོད་པ་ཐམས་ཅད་ཀྱིས་ཐེངས་འདིར་ཉ་དེ་འདྲ་མང་པོ་ཟིན་པ་མཐོང་བས་དོན་དེར་ཤིན་ཏུ་ཧ་ལས༌ཤིང༌།"]},{"type":"verse","number":10,"content":["སི་མོན་གྱི་ལས་གྲོགས་ཟེ་བད་ཡཱའི་བུ་ཡ་ཀོབ་དང་ཡོ་ཧ་ནན་གཉིས་ཀྱང་དེར་ཧ་ལས༌པ་རེད། སྐྱབས་མགོན་ཡེ་ཤུས་སི་མོན་ལ་འདི་སྐད༌དུ། མ་འཇིགས༌ཤིག ཕྱིན་ཆད་ཁྱོད་ལ་མི་ཡང་འཐོབ་པར་འགྱུར་ཞེས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":11,"content":["དེ་རྣམས་ཀྱིས་ཀྱང་མཚོ་གྲུ་གཉིས་པོ་མཚོ་འགྲམ་དུ་བསྐྱུར་བ་དང་ཐམས་ཅད་སྤངས་ནས་ཁོང་གི་རྗེས་སུ་འབྲངས༌སོ།།"]},{"type":"heading","content":["མཛེ་ནད་ཅན་གསོས༌པ།"]},{"type":"verse","number":12,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཡུལ་དེའི་གྲོང་རྡལ་ཞིག་ཏུ་བཞུགས་པའི་དུས༌སུ། ལྟོས་དང་། ལུས་ཡོངས་ལ་མཛེ་ནད་ཀྱིས་ཟིན་པའི་མི་ཞིག་གིས་ཁོང་ཉིད་མཐོང་བ་དང་ཕྱག་བཙལ་ཏེ་ན༌རེ། གཙོ་བོ༌ལགས། གལ་ཏེ་ཁྱེད་ཐུགས་མཉེས་པ་ཡིན༌ན། ཁྱེད་ཀྱིས་ང་རང་གཙང་མར་མཛད་ནུས་པ་ཡིན་ཞེས་ཞུ་བ་བྱས་པ༌ལ།"]},{"type":"verse","number":13,"content":["ཁོང་གིས་ཕྱག་བརྐྱངས་ནས་མི་དེར་རེག་པ༌དང༌། ང་རང་འཐད་པ་ཡིན། ཁྱོད་རང་གཙང་མར་གྱུར་ཅིག་ཅེས་གསུངས་མ་ཐག་མི་དེའི་མཛེ་ནད་སོས་སོ།།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་མི་དེ་ལ་འདི་སྐད་དུ། དོན་འདི་གཞན་སུ་ལའང་མི་སྨྲ་བར་གྱིས། ཁྱོད་རང་ཕྱིར་སོང་ནས་རང་གི་ལུས་པོ་མཆོད་དཔོན་ལ་སྟོན༌ཅིག མི་རྣམས་ལ་བདེན་དཔང་བྱེད་པའི་ཆེད་དུ་མོ་ཤེ་ཡིས་བཀའ་གནང་ཡོད་པ༌བཞིན། གཙང་མར་གྱུར་པའི་མཆོད་པ་ཕུལ་ཅིག་ཅེས་བཀའ་བསྒོས་སོ།།"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་ཁོང་གི་མཚན་སྙན་གྲགས་སྔར་ལས་ཀྱང་ཤིན་ཏུ་རྒྱས༌པས། མི་སྐོར་ཚོ་མང་པོ་ཁོང་གི་གསུང་ལ་མཉན་པ་དང་རང་གི་ནད་གསོ་བའི་ཕྱིར་གནས་དེར་འདུས༌ནའང༌།"]},{"type":"verse","number":16,"content":["ཁོང་ནི་ནམ་རྒྱུན་ལྟར་གསོལ་བ་འདེབས་ཕྱིར་དབེན་གནས་སུ་ཕེབས༌སོ།།"]},{"type":"heading","content":["མི་ཞ་བོ་ཞིག་གསོས༌པ།"]},{"type":"verse","number":17,"content":["ཉིན་ཞིག༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་ཆོས་གསུང་བའི་དུས༌སུ། ག་ལིལ་ཡུལ་གྱི་གྲོང་སྡེ་སོ་སོ༌དང༌། ཡ་ཧུ་དཱ༌ཡུལ། ཡེ་རུ་སཱ་ལེམ་བཅས་ནས་ཡོང་བའི་ཕ་རུ་ཤི་པ་དང་བཀའ་ཁྲིམས་ཀྱི་དགེ་རྒན་འགའ་ཤས་གནས་དེར་བསྡད་ཡོད༌ཅིང༌། གཙོ་བོའི་ནུས་མཐུ་ནི་ཁོང་དང་མཉམ་དུ་བཞུགས་པས་ཁོང་གིས་ནད་པ་རྣམས་ཀྱི་ནད་གསོ་བར་ནུས༌སོ།།"]},{"type":"verse","number":18,"content":["མི་འགའ་ཞིག་གིས་མི་ཞ་བོ་ཞིག་ཁྱོགས་ཤིང་དུ་ཁུར་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཡོང་བསམས༌ཀྱང༌།"]},{"type":"verse","number":19,"content":["གནས་དེར་མི་མང་པོ་འདུས་པའི་རྐྱེན་གྱིས་ཁང་པའི་ནང་དུ་འགྲོ་ཐབས་མ་རྙེད༌པར། ཁང་ཐོག་ཏུ་སོང་སྟེ་རྫ་གཡམ་གྱི་བར་ནས་མི་ཞ་བོ་དེ་ཁྱོགས་ཤིང་དང་བཅས་མི་ཚོགས་ཀྱི་དཀྱིལ་ལ་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་བཏང༌།"]},{"type":"verse","number":20,"content":["ཁོང་གིས་དེ་རྣམས་ཀྱི་དད་སེམས་གཟིགས་ནས་ཞ་བོ་དེ་ལ་འདི་སྐད༌དུ། སྙིང་གི༌བུ། ཁྱོད་ཀྱི་སྡིག་པ་བསལ་བ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":21,"content":["མཁན་པོ་དང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱི་སེམས༌སུ། དཀོན་མཆོག་གི་དབུ་འཕང་སྨད་མཁན་འདི་སུ་ཡིན༌ནམ། དཀོན་མཆོག་ཁོ་ན་ལས་གཞན་སུ་ཞིག་གིས་སྡིག་པ་བསལ་ནུས་སམ་ཞེས་བསམས་པར།"]},{"type":"verse","number":22,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་དག་གི་བསམ་ཚུལ་མཁྱེན་ཏེ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་ཅིའི་ཕྱིར་དེ་ལྟར་བསམས་པ་ཡིན༌ནམ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱི་སྡིག་པ་བསལ་བ་ཡིན་ཞེས་ཟེར༌བ་དང་། ཁྱོད་ཡར་ལོངས་ལ་སྐྱོད་ཅིག་ཟེར་བ་གཉིས་ལས་གང་ཞིག༌སླའམ།"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་། འདི་ནི་ས་སྟེང་དུ་མིའི་བུ་ལ་སྡིག་པ་བསལ་བའི་དབང་ཡོད་པ་ཁྱོད་ཅག་གིས་ཤེས་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌རྗེས། ཁོང་གིས་ཞ་བོ་དེ་ལ་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་ལ་སྨྲ་བར་བྱ༌སྟེ། ཡར་ལོངས་ལ་ཁྱོགས་ཤིང་ཁུར་ནས་ཕྱིར་རང་ཡུལ་དུ་སོང་ཞིག་ཅེས་བཀའ་གནང་མ༌ཐག"]},{"type":"verse","number":25,"content":["མི་དེ་ཁོ་རྣམས་ཀྱི་མདུན་ནས་ཡར་ལངས་ཏེ་ཁྱོགས་ཤིང་ཁུར་ནས་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་བཞིན་ཕྱིར་རང་ཡུལ་དུ་ལོག་པ་རེད།"]},{"type":"verse","number":26,"content":["མི་ཐམས་ཅད་ངོ་མཚར་སྐྱེས་ཏེ་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པ་དང་གུས་ཤིང་འཇིགས་པའི་ངང་ནས་བདག་ཅག་གིས་དེ་རིང་དོན་ཁྱད་མཚར་ཞིག་མཐོང་བྱུང་ཞེས་སྨྲས༌སོ།།"]},{"type":"heading","content":["ལེ་ཝི་སྐྱབས་མགོན་ཡེ་ཤུའི་རྗེས་སུ་འབྲང༌བ།"]},{"type":"verse","number":27,"content":["དེའི་རྗེས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུ་ཕྱི་རོལ་ཏུ་ཕེབས༌ཤིང༌། མིང་ལ་ལེ་ཝི་ཟེར་བའི་ཁྲལ་ལེན་མཁན་དེ་ཁྲལ་སྡུད་སར་བསྡད་ཡོད་པ་གཟིགས་ནས་འདི་སྐད༌དུ། ཁྱོད་རང་ངའི་རྗེས་སུ་ཤོག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":28,"content":["མི་དེས་ཀྱང་ཐམས་ཅད་སྤངས་ནས་ཡར་ལངས་ཏེ་ཁོང་གི་རྗེས་སུ་འབྲངས༌སོ།།"]},{"type":"verse","number":29,"content":["ལེ་ཝི་ཡིས་རང་གི་ཁྱིམ་ནས་ཁོང་ལ་གསོལ་སྟོན་ཆེན་པོ་བཤམས་པ༌དང༌། ཁྲལ་ལེན་མཁན་དང་མི་གཞན་མང་པོས་ཀྱང་ཁོང་རྣམས་དང་མཉམ་དུ་བཟའ་བཏུང་སྤྱད་ནས་བསྡད་དོ།།"]},{"type":"verse","number":30,"content":["དེའི་དུས་སུ་ཕ་རུ་ཤི་པ་དང་མཁན་པོ་རྣམས་ཀྱིས་ཁོང་གི་ཐུགས་སྲས་རྣམས་ལ་མི་དགའ་བའི་གཏམ་གླེང༌སྟེ། ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་ཁྲལ་ལེན་མཁན་དང་མི་སྡིག་ཅན་རྣམས་དང་མཉམ་དུ་བཟའ་བཏུང་ལ་རོལ་བ་ཡིན་ནམ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":31,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ལུས་ཁམས་བདེ་བའི་མི་ཡིས་སྨན་པ་བསྟེན་མི་དགོས་མོད། འོན་ཀྱང་ནད་པས་ད་གཟོད་སྨན་པ་བསྟེན་དགོས་པ་ཡིན།"]},{"type":"verse","number":32,"content":["བདག་ནི་མི་གཞུང་དྲང་རྣམས་ཀྱིས་འགྱོད་བཤགས་བྱེད་པའི་ཕྱིར་ཁོ་རྣམས་འབོད་དུ་འོངས་པ་མ་ཡིན༌པར། མི་སྡིག་ཅན་རྣམས་ཀྱིས་འགྱོད་བཤགས་བྱེད་པའི་ཕྱིར་ཁོ་རྣམས་འབོད་དུ་ཡོང་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྨྱུང་གནས་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":33,"content":["ཡང་ཆོས་དཔོན་དེ་རྣམས་ན༌རེ། ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་གྱི་སློབ་མ་རྣམས་ཀྱིས་དུས་རྒྱུན་དུ་སྨྱུང་གནས་སྲུང་ཞིང་གསོལ་བ་འདེབས༌པ་དང་། ཕ་རུ་ཤི་པའི་སློབ་མ་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱེད་པ་རེད། འོན་ཀྱང་ཁྱེད་ཀྱི་ཐུགས་སྲས་རྣམས་ཀྱིས་དེ་ལྟར་མི་བྱེད་པར་བཟའ་བཏུང་སྤྱོད་དོ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":34,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མག་པ་དང་སྐུ་མགྲོན་རྣམས་མཉམ་དུ་ཡོད་དུས་སྐུ་མགྲོན་རྣམས་ལ་སྨྱུང་གནས་སྲུང་དུ་འཇུག་ག་ལ་རུང་།"]},{"type":"verse","number":35,"content":["འོན་ཀྱང་མག་པ་དང་སྐུ་མགྲོན་རྣམས་ཁ་འབྲལ་བའི་དུས་ཤིག་སླེབ་ཡོང༌སྟེ། དུས་དེར་སྐུ་མགྲོན་རྣམས་ཀྱིས་སྨྱུང་གནས་བསྲུང་བར་འགྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":36,"content":["ཡང་ཁོང་གིས་དེ་རྣམས་ལ་དཔེ་ཞིག་སྦྱར་ནས་འདི་སྐད༌དུ། མི་སུ་ཡིན་ཡང་ལྭ་གསར་པའི་སྟེང་ནས་རས་ཞིག་བླངས་ཏེ་ལྭ་རྙིང་པར་ལྷན་པ་མི་རྒྱག༌སྟེ། དེ་ལྟར་བྱས་ན་ལྭ་གསར་པ་དེ་རལ་བར་མ༌ཟད། རས་གསར་པ་དེ་དང་ལྭ་རྙིང་པ་གཉིས་ཀྱང་ཆ་མཚུངས་པ་མ་ཡིན།"]},{"type":"verse","number":37,"content":["ཡང་སུ་ཡིན་ཡང་རྒུན་ཆང་གསར་པ་སྐྱི་ཁུག་རྙིང་པའི་ནང་དུ་མི་བླུག༌སྟེ། གལ་ཏེ་བླུགས་ན་རྒུན་ཆང་གསར་པ་དེས་སྐྱི་ཁུག་རྙིང་པ་རལ་ཏུ་འཇུག་པར་མ༌ཟད། ཆང་ཡང་ས་རུ་བཞུར་ནས་སྐྱི་ཁུག་ཀྱང་བརླག་པར་འགྱུར་ངེས༌པས།"]},{"type":"verse","number":38,"content":["རྒུན་ཆང་གསར་པ་དེ་སྐྱི་ཁུག་གསར་པའི་ནང་དུ་བླུག་དགོས།"]},{"type":"verse","number":39,"content":["ཡང་མི་སུ་ཡིན་ཡང་རྒུན་ཆང་རྙིང་པ་འཐུང་རྗེས་རྒུན་ཆང་གསར་པ་འཐུང་མི་འདོད༌པར། ཁོས་རྟག་ཏུ་རྒུན་ཆང་རྙིང་པ་ཞིམ་པོ་འདུག་ཅེས་ཟེར་ངེས་ཡིན་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":5,"caller":"+","text":"གེན་ནེ་སཱ་རེལ་ཞེས་པ་ནི་མཚོ་ག་ལིལ་དང་དོན་གཅིག་མིང་གི་རྣམ་གྲངས༌ཡིན།","reference":{"chapter":5,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/LUK/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/LUK/4.json","previousChapterAudioLinks":{},"numberOfVerses":39}