{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAL","translationId":"bod_ntb","name":"མཱལ་ཨ་ཀེ","commonName":"མཱལ་ཨ་ཀེ","title":"༄༅། །ལུང་སྟོན་པ་མཱལ་ཨ་ཀེའི་མདོ།","order":39,"numberOfChapters":4,"sha256":"a71487b102920d13005c68eddf94b88915d47db68a86e9c4c286d77be5e9b6d1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":2,"content":[{"type":"heading","content":["མཆོད་དཔོན་རྣམས་བཀའ་དང་འགལ་བ།"]},{"type":"verse","number":1,"content":["ཀྱེ་མཆོད་དཔོན་རྣམས། ད་ལྟའི་བཀའ་འདི་ནི་ཁྱོད་ཅག་ལ་གསུངས་པ་ཡིན།"]},{"type":"verse","number":2,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། གལ་ཏེ་ཁྱོད་རྣམས་ཀྱིས་མི་མཉན་ལ་སེམས་སུའང་མི་འཛིན་པ་དང་། གཟི་བརྗིད་ཐམས་ཅད་ངའི་མིང་ལ་མི་འབུལ་ན། ངས་ཁྱོད་རྣམས་ལ་དམོད་མོ་ཐེབས་པར་བྱ་སྟེ། ངས་ཁྱོད་རྣམས་ལ་འཐོབ་འོས་པའི་བྱིན་རླབས་དེ་ལ་དམོད་མོ་ཐེབས་སུ་འཇུག་པར་མ་ཟད། དམོད་མོ་ཐེབས་ཟིན་པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཅག་གིས་བཀའ་དེ་སེམས་སུ་མ་བཟུང་བས་སོ། །"]},{"type":"verse","number":3,"content":["ངས་ཁྱོད་ཅག་གི་བུ་རྒྱུད་རྣམས་ལ་གཤེ་གཤེ་བཏང་སྟེ། དུས་ཆེན་གྱི་སྐབས་སུ་མཆོད་པར་ཕུལ་བའི་ཕྱུགས་ཟོག་གི་ལྕི་བ་ཁྱོད་རྣམས་ཀྱི་གདོང་ལ་བྱུག་པར་འགྱུར་ཞིང་། མི་ཡིས་ཁྱོད་རྣམས་ལུད་ཕུང་ནང་དུ་འཁྱེར་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དེ་ནས་ཁྱོད་ཚོས་བཀའ་འདི་ནི་ངས་ཁྱོད་ཅག་ལ་གནང་བ་དང་། ངས་ལེ་ཝི་ལ་བཞག་པའི་ཞལ་ཆད་དེ་མུ་མཐུད་དུ་གནས་པའི་ཆེད་དུ་ཡིན་པ་རྟོགས་པར་འགྱུར།"]},{"type":"verse","number":5,"content":["ངས་ཁོ་ལ་བཞག་པའི་ཞལ་ཆད་ནི་ཚེ་སྲོག་དང་ཞི་བདེའི་ཞལ་ཆད་ཡིན་ལ། ཡང་ངས་དེ་རྣམས་ཁོ་ལ་གནང་ནས་ཁོ་རང་བདག་ལ་གུས་ཤིང་འཇིགས་པར་བྱས་ཤིང་། ཁོ་རང་བདག་ལ་གུས་ཤིང་འཇིགས་པ་དང་བདག་གི་མིང་ལ་འཇིགས་པའོ། །"]},{"type":"verse","number":6,"content":["ཁོའི་སྨྲ་སྒོ་རུ་བདེན་པ་ཉིད་ཀྱི་བཀའ་སློབ་ཡོད་ཅིང་། ཁོའི་མཆུ་སྒྲོས་ལས་རྫུན་གང་ཡང་ལབ་མེད་པ་ཡིན། ཁོ་ནི་ཞི་བདེ་དང་དྲང་བདེན་གྱི་ངང་ནས་ང་དང་མཉམ་དུ་སྐྱོད་ཅིང་། མི་མང་པོ་ཕྱིར་བཟློགས་ནས་སྡིག་པ་དང་བྲལ་ཏོ། །"]},{"type":"verse","number":7,"content":["མཆོད་དཔོན་གྱི་མཆུ་སྒྲོས་ཀྱིས་ཤེས་བྱ་སློབ་སྟོན་བྱེད་འོས་ལ། མི་ཡིས་དེའི་སྨྲ་སྒོ་ནས་བཀའ་ཁྲིམས་འཚོལ་དགོས་པ་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། དེ་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཡིན་པས་སོ། །"]},{"type":"verse","number":8,"content":["ཡིན་ཡང་ཁྱོད་ཅག་ནི་དྲང་ལམ་དང་བྲལ་ནས་མི་མང་པོ་བཀའ་ཁྲིམས་སྟེང་འགྱེལ་བར་བཅུག་པ་དང་། ཡང་ཁྱོད་རྣམས་ཀྱིས་ངས་ལེ་ཝི་ལ་བཞག་པའི་ཞལ་ཆད་ཀྱང་མ་བསྲུངས་པས།"]},{"type":"verse","number":9,"content":["ངས་ཀྱང་ཁྱོད་ཅག་ལ་མི་སྡེ་ཀུན་གྱི་མདུན་དུ་མཐོང་ཆུང་དང་དམའ་འབེབས་ཐེབས་སུ་འཇུག་གོ །གང་ལ་ཞེ་ན། ཁྱོད་ཅག་གིས་ངའི་བགྲོད་ལམ་མ་བསྲུངས་པར། བཀའ་ཁྲིམས་སྟེང་མི་ལ་ངོ་དགའ་ཕྱོགས་འཐེན་བྱས་པས་སོ་ཞེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡ་ཧུ་དཱ་པ་རྣམས་ལ་བློ་གཏད་མེད་པ།"]},{"type":"verse","number":10,"content":["རང་ཅག་ཐམས་ཅད་ལ་ཡབ་གཅིག་ཡོད་པ་མ་ཡིན་ནམ། དཀོན་མཆོག་གཅིག་གིས་རང་ཅག་བཀོད་པ་མ་ཡིན་ནམ། རང་ཅག་མི་རེ་རེས་རང་གི་སྤུན་ཟླ་ལ་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་ཞིང་། རང་ཅག་གི་ཕ་མེས་རྣམས་ཀྱི་ཞལ་ཆད་ཁྱད་དུ་གསོད་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":11,"content":["ཡ་ཧུ་དཱ་པས་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་ནས་ཡེས་ར་ཨེལ་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ནང་དུ་ཞེན་ཁ་ལོག་པའི་དོན་སྤྱད་པའོ། །ཅིའི་ཕྱིར་ཞེ་ན། ཡ་ཧུ་དཱ་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་མཉེས་པའི་མཆོད་ཁང་བཙོག་པར་བཟོས་ཏེ། ཕྱི་རོལ་པའི་ལྷ་ལ་ཞབས་ཏོག་སྒྲུབ་པའི་བུད་མེད་ཆུང་མར་བླངས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ལྟར་སྤྱོད་མཁན་ནི་སུ་ཡིན་ཡང་། ཐ་ན་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་འབུལ་མཁན་ཡིན་ནའང་། དཀོན་མཆོག་ཡ་ཝཱེས་མི་དེ་ནི་ཡ་ཀོབ་ཀྱི་གུར་ལས་ཚར་དུ་གཅོད་པར་འགྱུར།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཀྱིས་ཡང་དོན་འདི་སྤྱད་དེ། མིག་ཆུ་དང་ངུ་འབོད། འཁུན་སྒྲ་བཅས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁྲི་བཀབ་པ་ཡིན། གང་ལ་ཞེ་ན། ད་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ལེགས་སྐྱེས་ལ་མི་གཟིགས་ཤིང་། ཁྱོད་ཚོའི་ལག་ནས་དེ་བཞེས་པར་ཡང་ཐུགས་མི་མཉེས།"]},{"type":"verse","number":14,"content":["ཁྱོད་རྣམས་ཀྱིས་ད་དུང་ཅི་ལ་མི་བཞེས་སམ་ཞེས་འདྲིའོ། །ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་དང་ཁྱོད་ལོ་ན་གཞོན་དུས་བླངས་པའི་ཆུང་མའི་བར་དུ་བདེན་དཔང་མཛད་དེ། མོ་ནི་ཁྱོད་ཀྱི་གཏན་གྲོགས་དང་ཁྱོད་ཀྱིས་དམ་བཅའ་བཞག་པའི་ཆུང་མ་ཡིན་ནའང་ཁྱོད་ཀྱིས་ད་དུང་དེ་ལ་གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་ཏོ། །"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་གི་སེམས་ཉིད་དང་ལྡན་པའི་མི་ཞིག་ཡིན་ཚེ་དེ་ལྟར་མི་བྱ་སྟེ། དེས་ཅི་ལྟར་སྤྱོད་དམ་ཟེར་ན། དེས་དཀོན་མཆོག་ལ་དད་པའི་བུ་རབས་ཚ་རྒྱུད་འཚོལ་བའོ། །དེ་བས་ཁྱོད་ཅག་གིས་གཟབ་གཟབ་བྱས་ནས་རང་གི་སེམས་སྲུངས་དང་། ལོ་ན་གཞོན་དུས་བླངས་པའི་ཆུང་མར་བློ་དཀར་དགོས་སོ། །"]},{"type":"verse","number":16,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཆུང་མ་འདོར་བ་དང་ཆུང་མར་གདུག་རྩུབ་སྤྱོད་པའི་མི་ལ་ང་རང་སྡང་ངོ་ཞེས་གསུངས་ཤིང་། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དེ་བས་ཁྱོད་ཅག་གིས་གཟབ་གཟབ་བྱས་ནས་རང་གི་སེམས་སྲུངས་དང་། གཡོ་སྒྱུའི་སྦྱོར་བ་སྤེལ་མི་རུང་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":17,"content":["ཁྱོད་ཅག་གིས་རང་གི་སྨྲ་བརྗོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ལ་སུན་སྣང་བསྐྱེད་ནས་ད་དུང་ན་རེ། ངེད་རྣམས་ཀྱིས་ཁོང་ལ་ཅི་ལྟར་སུན་སྣང་བསྐྱེད་པ་ཡིན་ནམ་ཟེར་ཏེ། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་རྣམས་ན་རེ། ངན་པ་བྱེད་མཁན་རྣམས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་ལེགས་པར་གཟིགས་པར་མ་ཟད། ཁོང་དེ་དག་ལ་ཐུགས་མཉེས་པ་ཡིན་ཞེས་སྨྲ་ཞིང་། ཡང་ན་དྲང་བདེན་ཅན་གྱི་དཀོན་མཆོག་གང་དུ་བཞུགས་ལགས་སམ་ཞེས་སྨྲས་པས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAL/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}