{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":1,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་གདུང༌རྒྱུད།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡེ་ཤུ་མཱ་ཤི་ཀ་ནི་དཱ་བིད་དང་ཨབ་ར་ཧམ་གྱི་རིགས་སྲས་ཡིན༌ཞིང༌། ཁོང་གི་གདུང་རྒྱུད་ནི་འདི་ལྟ༌སྟེ།"]},{"type":"verse","number":2,"content":["ཨབ་ར་ཧམ་ལས་ཨི་སཱག་མཆེད༌ཅིང༌། ཨི་སཱག་ལས་ཡ་ཀོབ༌མཆེད། ཡ་ཀོབ་ལས་ཡ་ཧུ་དཱ་དང་དེའི་སྤུན་རྣམས་མཆེད༌དོ།།"]},{"type":"verse","number":3,"content":["ཡ་ཧུ་དཱའི་བུ་ཕེ་རེལ་ཟི་དང་ཟེ་རག་གཉིས་ནི་ཐལ་མཱར་ལས་མཆེད༌ཅིང༌། ཕེ་རེལ་ཟི་ལས་ཧེས་རོན༌མཆེད། ཧེས་རོན་ལས་རཱམ༌མཆེད།"]},{"type":"verse","number":4,"content":["རཱམ་ལས་ཨ་མི་ནཱ་དབ༌མཆེད། ཨ་མི་ནཱ་དབ་ལས་ནཱ་སོན༌མཆེད། ནཱ་སོན་ལས་སཱལ་མོན༌མཆེད།"]},{"type":"verse","number":5,"content":["སཱལ་མོན་གྱི་བུ་པཱོ་ཨ་ཟི་ནི་རཱ་ཧབ་ལས༌མཆེད། པཱོ་ཨ་ཟིའི་བུ་ཨོ་བེད་ནི་རུ་ཐི་ལས༌མཆེད། ཨོ་བེད་ལས་ཡེ་སེ༌མཆེད།"]},{"type":"verse","number":6,"content":["ཡེ་སེ་ལས་རྒྱལ་པོ་དཱ་བིད༌མཆེད། དཱ་བིད་ཀྱི་སྲས་སོ་ལོ་མོན་ནི་ཨུ་རི་ཡཱའི་ཆུང་མ་ལས༌མཆེད།"]},{"type":"verse","number":7,"content":["སོ་ལོ་མོན་ལས་རེ་ཧབ་ཨམ༌མཆེད། རེ་ཧབ་ཨམ་ལས་ཨ་བི་ཡཱ༌མཆེད། ཨ་བི་ཡཱ་ལས་ཨ་སཱ༌མཆེད།"]},{"type":"verse","number":8,"content":["ཨ་སཱ་ལས་ཡེ་ཧོ་ཤ་ཕད༌མཆེད། ཡེ་ཧོ་ཤ་ཕད་ལས་ཡོ་རཱམ༌མཆེད། ཡོ་རཱམ་ལས་ཨུ་ཟི་ཡཱ༌མཆེད།"]},{"type":"verse","number":9,"content":["ཨུ་ཟི་ཡཱ་ལས་ཡོ་ཐམ༌མཆེད། ཡོ་ཐམ་ལས་ཨ་ཧ་ཟཱ༌མཆེད། ཨ་ཧ་ཟཱ་ལས་ཧི་ཟི་ཀི་ཡཱ༌མཆེད།"]},{"type":"verse","number":10,"content":["ཧི་ཟི་ཀི་ཡཱ་ལས་མཱ་ན་ཤེ༌མཆེད། མཱ་ན་ཤེ་ལས་ཨ་མོན༌མཆེད། ཨ་མོན་ལས་ཡོ་ཤི་ཡཱ༌མཆེད།"]},{"type":"verse","number":11,"content":["པཱ་པེལ་ལོན་དུ་བཙན་ཁྲིད་བྱེད་པའི་དུས༌སུ། ཡོ་ཤི་ཡཱ་ལས་ཡེ་ཀོན་ཡཱ་དང་དེའི་ནུ་བོ་རྣམས་མཆེད༌དོ།།"]},{"type":"verse","number":12,"content":["པཱ་པེལ་ལོན་དུ་བཙན་ཁྲིད་བྱས༌རྗེས། ཡེ་ཀོན་ཡཱ་ལས་ཞིད་ཨལ་ཐེ་ཨེལ་མཆེད༌ཅིང༌། ཞིད་ཨལ་ཐེ་ཨེལ་ལས་ཟེ་རུ་པཱ་པེལ༌མཆེད།"]},{"type":"verse","number":13,"content":["ཟེ་རུ་པཱ་པེལ་ལས་ཨ་བི་ཧུད༌མཆེད། ཨ་བི་ཧུད་ལས་ཨེལ་ཡ་ཀིམ༌མཆེད། ཨེལ་ཡ་ཀིམ་ལས་ཨ་ཟོར༌མཆེད།"]},{"type":"verse","number":14,"content":["ཨ་ཟོར་ལས་ཟཱ་ཏོག༌མཆེད། ཟཱ་ཏོག་ལས་ཨ་ཀིམ༌མཆེད། ཨ་ཀིམ་ལས་ཨེ་ལི་ཧུད༌མཆེད།"]},{"type":"verse","number":15,"content":["ཨེ་ལི་ཧུད་ལས་ཨེ་ལི་ཨ་ཟར༌མཆེད། ཨེ་ལི་ཨ་ཟར་ལས་མད་ཐན༌མཆེད། མད་ཐན་ལས་ཡ་ཀོབ༌མཆེད།"]},{"type":"verse","number":16,"content":["ཡ་ཀོབ་ལས་ཡོ་སེབ་མཆེད་ཅིང་ཁོ་ནི་མིར་ཡམ་གྱི་ཁྱོ་བོ༌ཡིན། མཱ་ཤི་ཀ་ཞེས་གྲགས་པའི་སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མིར་ཡམ་ལས་སྐུ་འཁྲུངས་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":17,"content":["དེའི༌ཕྱིར། ཨབ་ར་ཧམ་ནས་དཱ་བིད་ཀྱི་བར་དུ་གདུང་རབས་བཅུ་བཞི༌དང༌། དཱ་བིད་ནས་ཡ་ཧུ་དཱ་པ་རྣམས་པཱ་པེལ་ལོན་ལ་བཙན་ཁྲིད་བྱས་པའི་བར་དུ་གདུང་རབས་བཅུ་བཞི་ཡོད་པ༌དང༌། པཱ་པེལ་ལོན་དུ་བཙན་ཁྲིད་བྱས་པ་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་བར་ལའང་གདུང་རབས་བཅུ་བཞི་ཡོད༌དོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་འཁྲུངས༌པ།"]},{"type":"verse","number":18,"content":["ཡེ་ཤུ་མཱ་ཤི་ཀ་སྐུ་འཁྲུངས་པའི་ལོ་རྒྱུས་ནི་འདི་ལྟ༌སྟེ། ཁོང་ཉིད་ཀྱི་ཡུམ་མིར་ཡམ་ནི་ཡོ་སེབ་དང་གཉེན་རྟགས་བརྒྱབ་ཡོད༌ཅིང༌། ཁོ་གཉིས་ཀྱི་བར་དུ་ཕོ་མོའི་ལུས་མ་འབྲེལ་བའི་སྔོན༌ལ། མིར་ཡམ་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱི་སྒོ་ནས་མངལ་སྦྲུམ་པར་གྱུར༌ཏོ།།"]},{"type":"verse","number":19,"content":["ཁོ་མོའི་ཁྱོ་བོ་ཡོ་སེབ་ནི་མི་གཞུང་དྲང་ཞིག་ཡིན༌པས། མི་ཚོགས་ཀྱི་མདུན་དུ་ཁོ་མོ་ངོ་གནོང་བར་བྱེད་མ་འདོད༌དེ། ལྐོག་ནས་ཁོ་མོ་དང་འཐོར་བར་བྱ་བསམས་པ༌ཡིན།"]},{"type":"verse","number":20,"content":["ཁོས་དེ་ལྟར་བསམས་པའི༌ཚེ། གཙོ་བོའི་ཕོ་ཉ་ཞིག་ཁོའི་རྨི་ལམ་དུ་བྱུང་སྟེ་འདི་སྐད༌དུ། ཀྱེ། དཱ་བིད་ཀྱི་རིགས་རྒྱུད་ཡོ༌སེབ། མིར་ཡམ་གྱི་མངལ་དུ་ཆགས་པ་ནི་དམ་པའི་ཐུགས་ཉིད་ནས་བྱུང་བ་ཡིན༌པས། ཁོ་མོ་ཁྱོད་ཀྱི་ཆུང་མར་ལེན་པ་ལ་མ་འཇིགས༌ཤིག"]},{"type":"verse","number":21,"content":["ཁོ་མོར་སྲས་ཤིག་འཁྲུངས་པར་འགྱུར༌ཞིང༌། ཁོང་གིས་རང་གི་མི་རྣམས་སྡིག་པ་ལས་སྐྱོབ་པར་འགྱུར༌བས། ཁྱོད་ཀྱིས་ཁོང་གི་མཚན་ལ་ཡེ་ཤུ་ཞེས་ཐོགས་ཤིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":22,"content":["དོན་འདི་ཐམས་ཅད་ནི་གཙོ་བོས་ལུང་སྟོན་པ་བརྒྱུད་ནས་འདི་སྐད༌དུ།"]},{"type":"verse","number":23,"content":["ལྟོས༌དང༌། ན་ཆུང་བུ་མོ་ཞིག་ལ་མངལ་སྦྲུམ་སྟེ་སྲས་ཤིག་འཁྲུངས་ངེས༌ཤིང༌། མི་རྣམས་ཀྱིས་ཁོང་གི་མཚན་ལ་ཨིམ་མཱ་ནུ་ཨེལ་ཞེས་འབོད་པར་འགྱུར་ཞེས་གསུངས་པ་དེ་འགྲུབ་པའི་ཕྱིར་དེ་ལྟར༌བྱུང༌། ཨིམ་མཱ་ནུ་ཨེལ་ཞེས་པ་ནི་དཀོན་མཆོག་བདག་ཅག་དང་མཉམ་དུ་བཞུགས་པ་ཡིན་ཞེས་པའི་དོན༌ནོ།།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡོ་སེབ་གཉིད་ལས་སད་པ་དང་ཡར་ལངས༌ནས། གཙོ་བོའི་ཕོ་ཉས་རང་ལ་བཀའ་གནང་བ་དེ་བཞིན་དུ་མིར་ཡམ་རང་གི་ཆུང་མར་བླངས༌ཤིང༌།"]},{"type":"verse","number":25,"content":["སྲས་མ་འཁྲུངས་པའི་བར་དུ་ཁོ་མོ་དང་ལུས་འབྲེལ་མ་བྱས༌ལ། སྲས་དེ་སྐུ་འཁྲུངས་རྗེས་མཚན་ལ་ཡེ་ཤུ་ཞེས་བཏགས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}