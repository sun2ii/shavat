{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":12,"content":[{"type":"heading","content":["ངལ་གསོ་བའི་ཉིན་གྱི་གཙོ༌བོ།"]},{"type":"verse","number":1,"content":["དེའི་དུས༌སུ། ངལ་གསོ་བའི་ཉིན་མོར་སྐྱབས་མགོན་ཡེ་ཤུ་ཞིང་བར་བརྒྱུད་ནས་ཕེབས་པ༌དང༌། ཁོང་གི་ཐུགས་སྲས་རྣམས་བཀྲེས་ཏེ་འབྲུ་ཡི་སྙེ་མ་བཏོགས་ནས་ཟོས༌སོ།།"]},{"type":"verse","number":2,"content":["ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་དོན་དེ་མཐོང་ཞིང་ན༌རེ། གཟིགས༌དང༌། ཁྱེད་ཀྱི་ཐུགས་སྲས་རྣམས་ཀྱིས་ངལ་གསོ་བའི་ཉིན༌ལ་བཀའ་ཁྲིམས་དང་འགལ་བའི་ལས་བྱེད་ཀྱིན་འདུག་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":3,"content":["ཁོང་གིས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། དཱ་བིད་འཁོར་དང་བཅས་པའི་ལྟོ་བ་བཀྲེས་སྐབས་ཅི་ཞིག་བྱས་པ་ཁྱོད་རྣམས་ཀྱིས་བཀླགས་མ་མྱོང༌ངམ།"]},{"type":"verse","number":4,"content":["ཁོང་ཅིའི་ཕྱིར་དཀོན་མཆོག་གི་བཞུགས་གནས་སུ་སོང་སྟེ་སྤྱན་བསྟར་བག་ལེབ་ཟོས༌སམ། སྤྱིར་དེ་ནི་དཱ་བིད་འཁོར་དང་བཅས་པས་བཟའ་རུང་བ་ཞིག་མ་ཡིན༌ཏེ། མཆོད་དཔོན་ཁོ་ནས་བཟའ་རུང་བ་ཡིན༌ནོ།།"]},{"type":"verse","number":5,"content":["གཞན༌ཡང༌། མཆོད་དཔོན་རྣམས་ཀྱིས་ངལ་གསོ་བའི་ཉིན་མོར་མཆོད་ཁང་ནས་ངལ་གསོའི་ཁྲིམས་དང་འགལ་ནའང་ཉེས་པ་མེད་ཅེས་བཀའ་ཁྲིམས་ནང་དུ་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་མ་བཀླགས༌སམ།"]},{"type":"verse","number":6,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། མཆོད་ཁང་ལས་ཀྱང་ཆེ་བ་ཞིག་འདི་རུ༌ཡོད།"]},{"type":"verse","number":7,"content":["འོན༌ཀྱང༌། ཁྱོད་རྣམས་ཀྱིས་བདག་ནི་མཆོད་པར་མི་དགའ་ཞིང་སྙིང་རྗེའི་སེམས་ལ་དགའ་ཞེས་གསུངས་པ་དེའི་དོན་རྟོགས༌ན། ཉེས་པ་མེད་པའི་མི་ལ་ཉེས་པ་ཡོད་པར་མི་བྱེད༌དེ།"]},{"type":"verse","number":8,"content":["མིའི་བུ་ནི་ངལ་གསོ་བའི་ཉིན་གྱི་གཙོ་བོ་ཡིན་པའི་ཕྱིར་རོ་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཡུལ་དེ་དང་ཁ་བྲལ་ནས་ཁོ་རྣམས་ཀྱི་ཆོས་ཁང་དུ་ཕེབས༌ཤིང༌།"]},{"type":"verse","number":10,"content":["དེ་རུ་ལག་པ་ཡ་གཅིག་ཞ་བའི་མི་ཞིག་ཡོད༌དེ། ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་ཁོང་ལ་སྙད་འཛུགས་པའི༌ཕྱིར། ངལ་གསོ་བའི་ཉིན་མོར་ནད་གསོ་བ་ནི་བཀའ་ཁྲིམས་དང་མཐུན་ནམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":11,"content":["ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ལས་སུ་ཞིག་གི་ལུག་ཅིག་ངལ་གསོ་བའི་ཉིན་ལ་དོང་ནང་དུ་ལྷུང་བ༌ན། ཁོས་ལུག་དེ་ཕྱིར་མི་ལེན༌ནམ།"]},{"type":"verse","number":12,"content":["མི་ནི་ལུག་ལས་ཀྱང་གལ་ཆེ་བ་མ་ཡིན༌ནམ། དེའི༌ཕྱིར། ངལ་གསོ་བའི་ཉིན་ལ་ལས་བཟང་པོ་སྒྲུབ་པ་ནི་བཀའ་ཁྲིམས་དང་མཐུན་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":13,"content":["ཁོང་གིས་མི་དེར་ལག་པ་རྐྱོངས་ཤིག་ཅེས་གསུངས་པ༌དང༌། ཁོས་ལག་པ་བརྐྱངས་ཤིང་སོས་ཏེ་ལག་པ་གཞན་དང་འདྲ་བར༌གྱུར།"]},{"type":"verse","number":14,"content":["འོན་ཀྱང་ཕ་རུ་ཤི་པ་རྣམས་ཕྱི་རོལ་ཏུ་སོང་ནས་ཁོང་ཉིད་ཅི་ལྟར་དགྲོང་བར་གྲོས་བྱས༌སོ།།"]},{"type":"heading","content":["དཀོན་མཆོག་གིས་བདམས་པའི་ཞབས་ཕྱི་པའི༌སྐོར།"]},{"type":"verse","number":15,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དོན་དེ་མཁྱེན་ནས་ཡུལ་དེ་དང་ཁ་བྲལ་བ༌དང༌། མི་མང་པོའང་ཁོང་གི་རྗེས་སུ༌འབྲངས། ཁོང་གིས་མི་དེ་རྣམས་ལས་ནད་པ་ཐམས་ཅད་ཀྱི་ནད་འཇོམས་པར་མཛད༌ཅིང༌།"]},{"type":"verse","number":16,"content":["ཡང་མི་རྣམས་ལ་རང་ཉིད་སུ་ཡིན་པ་མི་གཞན་ལ་བསྒྲག་པར་མི་བྱ་བའི་ཕྱིར་གདམས༌སོ།།"]},{"type":"verse","number":17,"content":["འདི་ནི་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱ་ཡི་མདོ་ལས་ཇི་སྐད༌དུ།"]},{"type":"verse","number":18,"content":[{"text":"ལྟོས་དང་བདག་གིས་བདམས་པའི་ཞབས་ཕྱི༌པ།།","poem":1},{"lineBreak":true},{"text":"དེ་ལ་བདག་ནི་དགའ་ཞིང་ཤིན་ཏུ༌གཅེས།།","poem":1},{"lineBreak":true},{"text":"བདག་གི་ཐུགས་ཉིད་ཁོང་ལ་གནང་བར༌འགྱུར།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་ཕྱི་ཕྱོགས་མི་ལ་བདེན་ལུགས༌སྒྲོག །","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ཁོང་གིས་མི་རྩོད་མི་རྒོལ་འུར་མི༌སྒྲོག །","poem":1},{"lineBreak":true},{"text":"སུས་ཀྱང་ཁྲོམ་ནས་དེའི་སྐད་ཐོས་པ༌མེད།།","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ཁོང་གིས་གཞན་ལ་བདེན་ལུགས་སྒྲོག་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"བདེན་ལུགས་དེ་ནི་རྣམ་པར་རྒྱལ་བའི༌བར།།","poem":1},{"lineBreak":true},{"text":"བསྣད་པའི་འདམ་རྩྭ་ཡང་ནི་གཅོད་མི༌སྲིད།།","poem":1},{"lineBreak":true},{"text":"དུ་བ་འཐུལ་བའི་སྡོང་རས་གཟུམ་མི༌འགྱུར།།","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ཕྱིའི་མིས་ཁོང་གི་མཚན་ལ་རེ་ལྟོས༌བཅང༌།།","poem":1},"ཞེས་ལུང་བསྟན་གནང་བ་བཞིན་དུ་འགྲུབ་པའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་དང་བདུད་ཀྱི་རྒྱལ་པོ་པེ་ཨལ་བཟི༌པད།"]},{"type":"verse","number":22,"content":["དེ་ནས་མི་འགའ་ཞིག་གིས་གདོན་འདྲེས་བཟུང་ནས་མིག་ལོང་ཞིང་ལྕེ་ལྐུགས་པར་གྱུར་པ་ཞིག་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌དང༌། ཁོང་གིས་མི་དེ་ནད་ལས་ཐར་བར་མཛད༌དེ། སྨྲའང་ཤེས་ལ་མཐོང་ཡང་ནུས་པར༌མཛད།"]},{"type":"verse","number":23,"content":["དོན་དེར་མི་ཐམས་ཅད་ངོ་མཚར་སྐྱེས༌ཤིང༌། མི་འདི་ནི་དཱ་བིད་ཀྱི་རིགས་སྲས་མ་ཡིན་ནམ་ཞེས༌སྨྲས།"]},{"type":"verse","number":24,"content":["འོན་ཀྱང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་གཏམ་དེ་ཐོས་ནས་མི་འདིས་བདུད་ཀྱི་རྒྱལ་པོ་པེ་ཨལ་བཟི་པད་ལ་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད་བཞིན་འདུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":25,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཕ་རུ་ཤི་པ་རྣམས་ཀྱི་བསམ་ཚུལ་མཁྱེན་ཏེ་འདི་སྐད༌དུ། རྒྱལ་ཁམས་ཤིག་ལ་ནང་འཁྲུག་བྱུང་ན་རྒྱལ་ཁམས་དེ་འཇིག་པར་འགྱུར༌ཞིང༌། གྲོང་ཁྱེར་རམ་ཁྱིམ་ཚང་ཞིག་ལ་ནང་འཁྲུག་བྱུང་ན་དེའང་བརྟན་པོར་གནས་མི༌ཐུབ།"]},{"type":"verse","number":26,"content":["གལ་ཏེ་བདུད་སཱ་ཏན་གྱིས་སཱ་ཏན་སྐྲོད༌ན། དེ་ལ་ནང་འཁྲུག་བྱུང་བས་བདུད་ཀྱི་རྒྱལ་ཁམས་ནི་ཇི་ལྟར་བརྟན་པོར་གནས་ཐུབ༌བམ།"]},{"type":"verse","number":27,"content":["གལ་ཏེ་བདག་གིས་པེ་ཨལ་བཟི་པད་ལ་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད་པ་ཡིན༌ན། ཁྱོད་ཅག་གི་རྗེས་འབྲང་པ་རྣམས་ཀྱིས་གང་ལ་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད༌དམ། དེའི༌ཕྱིར། རྗེས་འབྲང་པ་དེ་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་བདེན་རྫུན་གྱི་ཤན་འབྱེད་པར༌འགྱུར།"]},{"type":"verse","number":28,"content":["གལ་ཏེ་བདག་གིས་དཀོན་མཆོག་གི་ཐུགས་ཉིད་ལ་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད་པ་ཡིན༌ན། དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ནི་ཁྱོད་ཅག་གི་སྟེང་དུ་སླེབས་པ༌ཡིན།"]},{"type":"verse","number":29,"content":["ཡང་ན་སུ་ཞིག་མི་སྟོབས་ཅན་གྱི་ཁྱིམ་དུ་འཛུལ་ནས་ཅ་ལག་ཇི་ལྟར་འཕྲོག་ནུས༌སམ། ཐོག་མར་མི་དེ་བཟུང་ནས་བཀྱིགས༌ཚེ། ད་གཟོད་མི་དེའི་ཁྱིམ་ཚང་འཕྲོག་ནུས་པ༌ཡིན།"]},{"type":"verse","number":30,"content":["མི་སུ་ཞིག་བདག་གི་ཕྱོགས་མི་བྱེད་པ་དེ་ནི་བདག་གི་དགྲ་བོ་ཡིན༌ཞིང༌། སུ་ཞིག་གིས་བདག་དང་མཉམ་དུ་མི་བསྡུ་ན་དེ་ནི་གཏོར་མཁན༌ཡིན།"]},{"type":"verse","number":31,"content":["དེའི༌ཕྱིར། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། མི་རྣམས་ཀྱིས་བྱས་པའི་སྡིག་པ་དང་སྐུར་བ་འདེབས་པ་ཐམས་ཅད་བསལ༌ནའང༌། དམ་པའི་ཐུགས་ཉིད་ལ་སྐུར་བ་འདེབས་མཁན་གྱི་སྡིག་པ་ནི་གཏན་ནས་བསལ་བར་མི་འགྱུར༌རོ།།"]},{"type":"verse","number":32,"content":["ཡང་མིའི་བུ་ལ་ཚིག་ངན་སྨྲ་མཁན་དེའི་སྡིག་པ་བསལ༌ནའང༌། སུ་ཞིག་གིས་དམ་པའི་ཐུགས་ཉིད་ལ་སྐུར་བ་བཏབ༌ན། མི་དེའི་སྡིག་པ་ནི་བསྐལ་པ་འདི་དང་འབྱུང་འགྱུར་གྱི་བསྐལ་པར་ཡང་བསལ་བར་མི༌འགྱུར།"]},{"type":"verse","number":33,"content":["ཁྱོད་རྣམས་ཀྱིས་ལྗོན་ཤིང་དང་དེའི་འབྲས་བུ་གཉིས་ཀ་བཟང་པོར་རྩིས༌ཤིག ཡང་ན་ལྗོན་ཤིང་དང་དེའི་འབྲས་བུ་གཉིས་ཀ་ངན་པར་རྩིས༌ཤིག རྒྱུ་མཚན་ནི་འབྲས་བུ་ལས་ལྗོན་ཤིང་དེ་ག་འདྲ་ཡིན་པ་ཤེས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":34,"content":["དུག་སྦྲུལ་གྱི་རྒྱུད་ཁྱོད་ཅག་ཐ་ཤལ་ཡིན༌པས། ཁྱོད་ཅག་གིས་གཏམ་བཟང་པོ་ཇི་ལྟར་སྨྲ་ནུས༌སམ། རྒྱུ་མཚན་ནི་སེམས་ལ་ཅི་ལྟ་བུས་བཀང༌ན། ངག་ལས་ཀྱང་དེ་ལྟ་བུ་སྨྲ་བ༌ཡིན།"]},{"type":"verse","number":35,"content":["མི་བཟང་ཞིག་གིས་རང་གི་བང་མཛོད་བཟང་པོ་ནས་དོན་བཟང་པོ་འདོན༌ཞིང༌། མི་ངན་པས་རང་གི་བང་མཛོད་ངན་པ་ནས་དོན་ངན་པ་འདོན་པ༌ཡིན།"]},{"type":"verse","number":36,"content":["ཡང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། མི་རྣམས་ཀྱིས་ངག་འཆལ་སྨྲས༌ན། མ་འོངས་པའི་ཉེས་ཆད་གཅོད་པའི་ཉིན༌ལ། ཚིག་དེ་དག་ལ་རེ་རེ་བཞིན་ལན་འདེབས་དགོས་པར༌འགྱུར།"]},{"type":"verse","number":37,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་ཀྱིས་སྨྲས་པའི་ཚིག་ལ་བརྟེན་ནས་ཁྱོད་རང་ཉེས་པ་མེད་པར་བརྩི༌ཞིང༌། ཡང་ཁྱོད་ཀྱིས་སྨྲས་པའི་ཚིག་ལ་བརྟེན་ནས་ཁྱོད་རང་ཉེས་ཅན་དུ་བརྩི་བར་འགྱུར་བའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ལུང་སྟོན་པ་ཡོ་ནཱའི་གྲུབ༌རྟགས།"]},{"type":"verse","number":38,"content":["དེ་ནས་མཁན་པོ་དང་ཕ་རུ་ཤི་པ་འགའ་ཞིག་གིས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འདི་ལྟར་སྨྲས༌པ། སློབ་དཔོན༌ལགས། ཁྱེད་ཀྱིས་གྲུབ་རྟགས་ཤིག་སྟོན་དང་ངེད་རྣམས་ཀྱིས་མཐོང་འདོད་པ་ཡིན་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":39,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མི་རབས་ངན་པ་དང་གཡེམ་སྦྱོར་ཅན་ཞིག་གིས་གྲུབ་རྟགས་ཤིག་མཐོང་འདོད༌ནའང༌། ལུང་སྟོན་པ་ཡོ་ནཱའི་རྟགས་ངོ་མཚར་ཅན་དེ་ལས༌གཞན། ཁྱོད་རྣམས་ལ་རྟགས་ཅི་ཡང་སྟོན་པར་མི༌འགྱུར།"]},{"type":"verse","number":40,"content":["ཡོ་ནཱ་ཉིན་ཞག་གསུམ་ལ་ཉ་ཆེན་གྱི་གྲོད་ཁོག་ནང་དུ་ལུས་པ༌ལྟར། མིའི་བུ་ཡང་ཉིན་ཞག་གསུམ་ལ་སའི་ཁོག་ཏུ་གནས་པར༌འགྱུར།"]},{"type":"verse","number":41,"content":["ནིན་ཝེ་པ་རྣམས་ཀྱིས་ལུང་སྟོན་པ་ཡོ་ནཱས་བསྒྲགས་པའི་ཆོས་ལ་མཉན་ཞིང་འགྱོད་བཤགས་བྱས་མྱོང༌བས། ཉེས་ཆད་གཅོད་པའི་ཉིན༌ལ། མི་དེ་རྣམས་ཀྱང་མི་རབས་འདིའི་མི་རྣམས་དང་ལྷན་དུ་ཡར་འགྲེང་སྟེ་མི་རབས་འདི་ལ་ཉེས་སྐྱོན་བརྗོད་པར༌འགྱུར། ཡང་ལྟོས༌དང༌། འདི་རུ་ཡོ་ནཱ་ལས་ཀྱང་སྐྱེས་བུ་ཆེན་པོ་ཞིག༌ཡོད།"]},{"type":"verse","number":42,"content":["ལྷོ་ཕྱོགས་ཀྱི་རྒྱལ་མོ་དེ་རྒྱང་ཐག་རིང་བའི་ས་མཐའ་ནས་སོ་ལོ་མོན་གྱི་ཤེས་རབ་དང་ལྡན་པའི་གཏམ་ལ་གསན་དུ་ཡོང་མྱོང༌བས། ཉེས་ཆད་གཅོད་པའི་ཉིན༌ལ། ཁོ་མོའང་མི་རབས་འདིའི་མི་རྣམས་དང་ལྷན་དུ་ཡར་འགྲེང་སྟེ་མི་རབས་འདི་ལ་ཉེས་སྐྱོན་བརྗོད་པར༌འགྱུར། ཡང་ལྟོས༌དང༌། འདི་རུ་སོ་ལོ་མོན་ལས་ཀྱང་སྐྱེས་བུ་ཆེན་པོ་ཞིག་མཆིས༌སོ།།"]},{"type":"verse","number":43,"content":["སྤྱིར་གདོན་འདྲེ་ཞིག་མིའི་ལུས་ནས་ཕྱིར་བུད༌རྗེས། ཆུ་མེད་པའི་གནས་སུ་ཕར་འགྲོ་ཚུར་འོང་བྱེད༌ཅིང༌། ངལ་གསོ་བའི་གནས་ཤིག་བཙལ་ཡང་མ་རྙེད༌པས།"]},{"type":"verse","number":44,"content":["རང་གིས་རང་ལ་ན༌རེ། ང་རང་ཕྱིར་རང་ཉིད་ཡོང་བའི་གནས་དེར་འགྲོའོ་ཞེས་སྨྲ༌ཞིང༌། གནས་དེར་ཕྱིར་ལོག་པ༌ན། གནས་དེ་སྟོང་ཞིང་ཕྱག་དར་བྱས་ནས་ལེགས་པར་བསྒྲིགས་ཡོད་པ་མཐོང༌སྟེ།"]},{"type":"verse","number":45,"content":["ཕར་སོང་ནས་རང་ལས་ཀྱང་ངན་པའི་གདོན་འདྲེ་བདུན་ཁྲིད་དེ་གནས་དེར་ཡོང་ནས༌བསྡད། དེ་བས་མི་དེའི་ཕྱིས་ཀྱི་གནས་ཚུལ་ནི་སྔར་ལས་ཀྱང་ཇེ་ཞན་དང་ཇེ་སྡུག་ཏུ་འགྱུར༌ཞིང༌། མི་རབས་ངན་པ་འདི་ལའང་དེ་བཞིན་དུ་འབྱུང་བར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་ཡུམ་དང་ཁོང་གི་སྐུ་མཆེད༌རྣམས་ཀྱི་སྐོར།"]},{"type":"verse","number":46,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཚོགས་ལ་དེ་ལྟར་གསུང་བཞིན་པའི་དུས༌སུ། ཁོང་གི་ཡུམ་དང་སྐུ་མཆེད་རྣམས་གནས་དེར་སླེབས་ཤིང་ཁོང་ལ་གཏམ་སྨྲ་བར་འདོད་དེ་ཕྱི་རོལ་ཏུ་ལངས་ནས་བསྡད༌དོ།།"]},{"type":"verse","number":47,"content":["དེ་ནས་མི་ཞིག་གིས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འདི་ལྟར་ཞུས་པ༌སྟེ། གཟིགས༌དང༌། ཁྱེད་ཀྱི་ཡུམ་དང་སྐུ་མཆེད་རྣམས་ཀྱིས་ཁྱེད་དང་གཏམ་སྨྲ་བར་འདོད་ནས་ཕྱི་རོལ་ཏུ་ལངས་བསྡད་ཡོད་ཅེས་པ༌ལ།"]},{"type":"verse","number":48,"content":["ཁོང་གིས་འདི་སྐད༌དུ། ངའི་མ་དང་ངའི་སྤུན་ནི་སུ་ཡིན་ནམ་ཞེས་གསུང༌བཞིན།"]},{"type":"verse","number":49,"content":["ཡང་ཕྱག་གིས་ཐུགས་སྲས་རྣམས་བསྟན༌ཏེ། ལྟོས༌དང༌། ངའི་མ་དང་ངའི་སྤུན་ནི་ཁོ་ཚོ་ཡིན༌ཏེ།"]},{"type":"verse","number":50,"content":["ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་བདག་གི་ཡབ་ཀྱི་དགོངས་པ་ལྟར་སྒྲུབ་མཁན་ཐམས་ཅད་ནི་ངའི་མ་དང༌སྤུན། ངའི་མིང་སྲིང་རྣམས་ཡིན་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/11.json","previousChapterAudioLinks":{},"numberOfVerses":50}