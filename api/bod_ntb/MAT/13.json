{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":13,"content":[{"type":"heading","content":["ས་བོན་འདེབས་པའི༌དཔེ།"]},{"type":"verse","number":1,"content":["ཉིན་དེ་ལ་སྐྱབས་མགོན་ཡེ་ཤུ་ཁང་པའི་ཕྱི་རོལ་ཏུ་ཕེབས་ཤིང་མཚོ་འགྲམ་དུ་བཞུགས༌སོ།།"]},{"type":"verse","number":2,"content":["དེ་ནས་མི་སྐོར་ཚོ་མང་པོ་ཁོང་གི་དྲུང་དུ་འཛོམས་པས་ཁོང་ཉིད་མཚོ་གྲུའི་ནང་དུ་ཕེབས་ཏེ་བཞུགས་པ༌དང༌། མི་ཐམས་ཅད་མཚོ་འགྲམ་དུ་ལངས་ནས༌བསྡད།"]},{"type":"verse","number":3,"content":["ཁོང་གིས་དཔེའི་སྒོ་ནས་ཆོས་མང་པོ་གསུངས་ཤིང་དེ་རྣམས་ལ་འདི་སྐད༌དུ། དེ་ཡང་ཞིང་འདེབས་མཁན་ཞིག་ཕྱི་རོལ་ཏུ་ཞིང་འདེབས་སུ་སོང་བ༌དང༌།"]},{"type":"verse","number":4,"content":["ས་བོན་གཏོར་བའི་སྐབས༌སུ། ས་བོན་ཁ་ཤས་ལམ་ཁར་ཐོར་ཞིང་བྱ་རྣམས་ཡོང་ནས༌ཟོས།"]},{"type":"verse","number":5,"content":["ཡང་ས་བོན་ཁ་ཤས་ས་ཉུང་སའི་རྡོ་གསེབ་ཏུ་ཐོར་ཞིང་སའི་གཏིང་མི་ཟབ་པས་ཡར་སྐྱེས་པ་མགྱོགས༌ཀྱང༌།"]},{"type":"verse","number":6,"content":["ཉི་མ་ཤར་ཚེ་རྙིད་ཅིང་རྩ་བ་མ་རྒྱས་པས་བསྐམས་པ༌རེད།"]},{"type":"verse","number":7,"content":["ས་བོན་ཁ་ཤས་ཚེར་མའི་གསེབ་ཏུ་ཐོར་ཞིང་ཚེར་མ་སྐྱེས་ཏེ་མར༌མནན།"]},{"type":"verse","number":8,"content":["ཡང་ས་བོན་ཁ་ཤས་ས་གཤིན་ནང་དུ་ཐོར་ཞིང་འབྲས་བུ་སྨིན༌ཏེ། དེ་དག་ལས་ཁ་ཤས་ལྡབ་བརྒྱ༌དང༌། ཁ་ཤས་ལྡབ་དྲུག༌ཅུ། ཁ་ཤས་ལྡབ་སུམ་ཅུ་བཅས་སྨིན་པ༌ཡིན།"]},{"type":"verse","number":9,"content":["རྣ་བ་ཡོད་པ་ཐམས་ཅད་ཀྱིས་གཏམ་འདིར་ཉོན་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཐུགས་སྲས་རྣམས་ཡོང་སྟེ་ཁོང་ལ་ན༌རེ། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་མི་རྣམས་ལ་དཔེའི་སྒོ་ནས་གསུངས་པ་ཡིན་ནམ་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":11,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ཀྱི་གསང་བ་རྣམས་ནི་ཁྱོད་ཅག་ལ་ཤེས་སུ་འཇུག་པ་ལས་མི་དེ་རྣམས་ལ་མངོན་པ་མ༌ཡིན།"]},{"type":"verse","number":12,"content":["རྒྱུ་མཚན་ནི་སུ་ཞིག་ལ་ཡོད་པ་དེ་ལ་ད་དུང་ཡང་གནང་ངེས་ཤིང་དེ་ལ་ལྷག་མའང་ཡོད་པར༌འགྱུར། འོན་ཀྱང་སུ་ཞིག་ལ་མེད་པ་དེ་ལས་ཉུང་ཙམ་ཡོད་པ་དེའང་ཕྱིར་ལེན་པར་འགྱུར་བའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":13,"content":["དེའི༌ཕྱིར། བདག་གིས་མི་དེ་རྣམས་ལ་དཔེའི་སྒོ་ནས་བཤད་པའི་རྒྱུ་མཚན༌ནི། དེ་རྣམས་ཀྱིས་མིག་གིས་བལྟས་ཀྱང་མི་མཐོང་བ༌དང༌། རྣ་བས་མཉན་ཡང་མི་ཐོས་ཤིང་མི་རྟོགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":14,"content":["དེ་ལ་ལུང་སྟོན་པ་ཡེ་ཤ་ཡཱའི་ལུང་བསྟན་ལས་ཇི་སྐད༌དུ།",{"text":"རྣ་བས་ཐོས་ཀྱང་ཅི་ཡང་མི་ཤེས༌ཤིང༌།།","poem":1},{"lineBreak":true},{"text":"མིག་གིས་མཐོང་ཡང་ཅི་ཡང་མི་རྟོགས༌པ།།","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"དེ་རྣམས་སེམས་ནི་གྱོང་པོར་གྱུར་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"རྣ་བས་མི་མཉན་མིག་ཟུང་བཙུམས་པས༌སོ།།","poem":1},{"lineBreak":true},{"text":"དེ་ལྟར་མིན་ན་མིག་གིས་མཐོང་བ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"རྣ་བས་ཐོས་ཤིང་བློ་ཡིས་རྟོགས་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ཕྱིར་དུ་འཁོར་ནས་ངས་ཀྱང་དེ་རྣམས༌ནི།།","poem":1},{"lineBreak":true},{"text":"གསོ་ཞིང་དྲག་པར་བྱེད་པ་ཡིན་ལགས༌སོ།།","poem":1},"ཞེས་ལུང་བསྟན་གནང་བ་ལྟར་ཁོ་རྣམས་ཀྱི་སྟེང་དུ་འགྲུབ་བཞིན༌འདུག"]},{"type":"verse","number":16,"content":["འོན༌ཀྱང༌། ཁྱོད་ཅག་གི་མིག་གིས་མཐོང་བའི༌ཕྱིར། ཁྱོད་ཅག་གི་མིག་ནི་བདེ་བ༌ཡིན། ཁྱོད་ཅག་གི་རྣ་བས་ཐོས་པའི༌ཕྱིར། ཁྱོད་ཅག་གི་རྣ་བ་བདེ༌བའོ།།"]},{"type":"verse","number":17,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། སྔར་ལུང་སྟོན་པ་དང་མི་གཞུང་དྲང་མང་པོས་ཁྱོད་རྣམས་ཀྱིས་མཐོང་བ་དེ་དག་ལ་བལྟ་འདོད་ནའང་མཐོང་མ༌མྱོང༌། ཁྱོད་རྣམས་ཀྱིས་ཐོས་པ་དེ་དག་ལ་ཉན་འདོད་ཀྱང་མ་ཐོས༌སོ།།"]},{"type":"verse","number":18,"content":["དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་ས་བོན་བཏབ་པའི་དཔེ་འདིའི་དོན་ལ་ཉོན༌ཅིག"]},{"type":"verse","number":19,"content":["སུ་ཞིག་གིས་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་བཀའ་ཐོས་ཤིང་དོན་མ་རྟོགས་པར་སྡོད་པའི་དུས༌སུ། བདུད་ངན་དེ་ཡོང་ནས་ཁོའི་སེམས་སུ་བཏབ་པའི་ས་བོན་ཕྲོགས་པ༌དང༌། འདི་ནི་ས་བོན་ལམ་ཁར་ཐོར་བ་དེ་རྣམས༌ཡིན།"]},{"type":"verse","number":20,"content":["ས་བོན་རྡོ་གསེབ་ཏུ་ཐོར་བ་ནི་མི་ལ་ལས་བཀའ་ཐོས་པ་ཙམ་གྱིས་དགའ་ཞིང་དང་དུ་བླངས༌ནའང༌།"]},{"type":"verse","number":21,"content":["སེམས་སུ་རྩ་བ་མ་རྒྱས་པས་དུས་ཡུན་ཐུང་ངུ་ལ་གནས༌ཀྱང༌། བཀའ་དེའི་རྐྱེན་གྱིས་དཀའ་སྡུག་དང་གནོད་འཚེ་བྱུང་མ་ཐག་དད་པ་ལོག་པ༌རྣམས་ཡིན།"]},{"type":"verse","number":22,"content":["ཚེར་མའི་གསེབ་ཏུ་གཏོར་བ་ནི་མི་ལ་ལས་བཀའ་ཐོས༌ཀྱང༌། འཇིག་རྟེན་གྱི་སེམས་ཁུར་དང་རྒྱུ་ནོར་གྱི་སླུ་བྲིད་ཀྱིས་བཀའ་མནན་ནས་འབྲས་བུ་སྨིན་མ་ཐུབ་པ༌རྣམས་ཡིན།"]},{"type":"verse","number":23,"content":["ས་གཤིན་ནང་དུ་ཐོར་བ་ནི་མི་ལ་ལས་བཀའ་ཐོས་ནས་དོན་རྟོགས༌ཤིང༌། རྗེས་སུ་འབྲས་བུ་སྨིན་ཐུབ་པ་རྣམས་ཡིན༌ཏེ། འབྲས་བུ་ཁ་ཤས་ལྡབ་བརྒྱ༌དང༌། ཁ་ཤས་ལྡབ་དྲུག༌ཅུ། ཁ་ཤས་ལྡབ་སུམ་ཅུ་བཅས་སྨིན་པ་ཡིན་ཞེས་བཀའ་ལན་གསུངས༌སོ།།"]},{"type":"heading","content":["རྩྭ་ལྡུམ་གྱི༌དཔེ།"]},{"type":"verse","number":24,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་དཔེའི་སྒོ་ནས་མི་ཚོགས་ལ་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ནི་མི་ཞིག་གིས་ཞིང་ལ་ས་བོན་བཟང་པོ་བཏབ་པ་དང་འདྲ༌སྟེ།"]},{"type":"verse","number":25,"content":["མི་རྣམས་གཉིད་དུ་ཡུར་བའི་དུས༌སུ། དགྲ་བོ་ཡོང་ནས་རྩྭ་ལྡུམ་གྲོ་ནང་དུ་གཏོར་ཏེ༌སོང༌།"]},{"type":"verse","number":26,"content":["དེ་ནས་སྙེ་མ་ཐོགས་པའི་དུས༌སུ། རྩྭ་ལྡུམ་ཡང་མངོན་པར་གྱུར༌ཏོ།།"]},{"type":"verse","number":27,"content":["དེ་ནས་ཞིང་བདག་གི་གཡོག་པོ་རྣམས་ཡོང་སྟེ་ན༌རེ། བདག་པོ༌ལགས། ཁྱེད་ཀྱིས་ཞིང་ལ་ས་བོན་བཟང་པོ་བཏབ་པ་མ་ཡིན༌ནམ། རྩྭ་ལྡུམ་དེ་དག་གང་ནས་བྱུང་ངམ་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":28,"content":["བདག་པོ་ན༌རེ། དེ་ནི་དགྲ་བོས་བྱས་པ་ཡིན་ཞེས་སྨྲས༌སོ། །ཡང་གཡོག་པོ་རྣམས་ན༌རེ། ངེད་རྣམས་སོང་ནས་རྩྭ་ལྡུམ་ཡུར་དགོས་སམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":29,"content":["ཡང་བདག་པོ་ན༌རེ། རྩྭ་ལྡུམ་ཡུར་མི་དགོས༌ཏེ། ཁྱོད་ཅག་གིས་རྩྭ་ལྡུམ་ཡུར་སྐབས་གྲོ་ཡང་མཉམ་དུ་ཡུར་ཉེན༌ཆེའོ།།"]},{"type":"verse","number":30,"content":["སྟོན་ཐོག་བསྡུ་བའི་བར་དུ་དེ་གཉིས་མཉམ་དུ་སྐྱེ་རུ༌ཆུག བདག་གིས་སྟོན་ཐོག་བསྡུ་བའི་དུས༌སུ། གྲོ་རྔ་མཁན་རྣམས་ལ་ཐོག་མར་རྩྭ་ལྡུམ་བལ་ཏེ་མེ་རུ་བསྲེག་ཆེད་ཕོན་པོར་སྡོམས༌ཤིག གྲོ་ནི་བདག་གི་བང་མཛོད་དུ་སྡུས་ཤིག་ཅེས་ཟེར་བར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཡུངས་འབྲུ་དང་སྐྱུར་རྩིའི༌དཔེ།"]},{"type":"verse","number":31,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་དཔེ་གཞན་ཞིག་དྲངས་ནས་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ནི་ཡུངས་འབྲུའི་ས་བོན་ཞིག་དང་འདྲ༌སྟེ། མི་ཞིག་གིས་ས་བོན་དེ་ཁྱེར་ནས་རང་གི་ཞིང་ལ༌བཏབ།"]},{"type":"verse","number":32,"content":["ས་བོན་དེ་ནི་ས་བོན་གྱི་རིགས་གཞན་ཐམས་ཅད་ལས་ཆུང༌ནའང༌། ཆེར་སྐྱེས་ནས་སྔོ་ཚལ་སྣ་ཚོགས་ལས་ཆེ་ཞིང་ཤིང་སྡོང་དུ་གྱུར༌ཏེ། ནམ་མཁའི་བྱའང་འཕུར་ཡོང་ནས་ཡལ་གའི་གསེབ་ཏུ་ཚང་བཟོ་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":33,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་དཔེ་གཞན་ཞིག་དྲངས་ཏེ་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ནི་སྐྱུར་རྩི་དང་འདྲ༌སྟེ། བུད་མེད་ཅིག་གིས་སྐྱུར་རྩི་དེ་ཕྱེ་བྲེ་གསུམ་གྱི་ནང་དུ་བསྲེས་ཤིང་བརྫིས་ཏེ་རིམ་བཞིན་ཕྱེ་ཐམས་ཅད་སྐྱུར་ལངས་པ་དང་མཚུངས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":34,"content":["གོང་གི་གསུང་དེ་ཐམས་ཅད་ནི་སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཚོགས་ལ་དཔེའི་སྒོ་ནས་གསུངས་པ་ཡིན༌ཏེ། ཁོང་གིས་དཔེ་མ་བཀོད་པར་དེ་རྣམས་ལ་ཅི་ཡང་མ༌གསུངས།"]},{"type":"verse","number":35,"content":["དེ་ལ་ལུང་སྟོན་པའི་མདོ་བརྒྱུད་ནས་ཇི་སྐད༌དུ།",{"text":"བདག་གིས་ངག་གི་སྒོ་མོ་ཡངས་པོར༌ཕྱེ།།","poem":1},{"lineBreak":true},{"text":"འཇིག་རྟེན་གསར་དུ་བཀོད་པའི་ཚུ་རོལ༌གྱི།།","poem":1},{"lineBreak":true},{"text":"སྦས་ཤིང་གསང་བའི་དོན་དག་སྣ་ཚོགས༌ནི།།","poem":1},{"lineBreak":true},{"text":"དཔེ་རུ་བཀོད་ནས་རིམ་བཞིན་བསྟན་པར༌བྱ།།","poem":1},"ཞེས་གསུངས་པ་བཞིན་འགྲུབ་པའི་ཕྱིར་དེ་ལྟར་བྱུང་བ་ཡིན༌ནོ།།"]},{"type":"heading","content":["རྩྭ་ལྡུམ་གྱི་དཔེའི་འགྲེལ༌བ།"]},{"type":"verse","number":36,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་མི་ཚོགས་དང་ཁ་བྲལ་ནས་ཁང་པའི་ནང་དུ་ཕེབས་པ༌དང༌། ཐུགས་སྲས་རྣམས་ཁོང་གི་དྲུང་དུ་ཡོང༌སྟེ། རྩྭ་ལྡུམ་གྱི་དཔེ་དེའི་དོན་རྣམས་ངེད་ཅག་ལ་གསུང་བར་མཛོད་ཅེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":37,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། སོན་བཟང་འདེབས་མཁན་ནི་མིའི་བུ་ཡིན༌ལ།"]},{"type":"verse","number":38,"content":["ས་ཞིང་ནི་འཇིག་རྟེན་ཁམས༌ཡིན། སོན་བཟང་ནི་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ལ་གཏོགས་པའི་མི་རྣམས༌ཡིན། རྩྭ་ལྡུམ་ནི་བདུད་ངན་དེ་ལ་གཏོགས་པའི་མི་རྣམས༌ཡིན།"]},{"type":"verse","number":39,"content":["རྩྭ་ལྡུམ་གཏོར་མཁན་དགྲ་བོ་ནི་བདུད༌ཡིན། སྟོན་ཐོག་བསྡུ་བའི་དུས་ནི་བསྐལ་པའི་མཐའ་མ༌ཡིན། ཞིང་རྔ་མཁན་ནི་ཕོ་ཉ་རྣམས༌ཡིན།"]},{"type":"verse","number":40,"content":["དེའི༌ཕྱིར། རྩྭ་ལྡུམ་བལ་ནས་མེ་རུ་སྲེག་པ་བཞིན་བསྐལ་པའི་མཐའ་མ་ལའང་དེ་ལྟར་འབྱུང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":41,"content":["མིའི་བུ་ཡིས་ཕོ་ཉ་རྣམས་མངགས་ཤིང་དེ་དག་གིས་ཁོང་གི་རྒྱལ་སྲིད་ནས་མི་ལ་སྡིག་པ་བྱེད་དུ་འཇུག་པ་དང་ཉེས་པ་གསོག་མཁན་ཐམས་ཅད་བསྡུས༌ཏེ།"]},{"type":"verse","number":42,"content":["མེ་ཐབ་ནང་དུ་གཡུག་ཅིང་གནས་དེ་རུ་ངུ་འབོད་བྱས་ནས་ཨམ་གཙིགས་བསྡམ་པར༌འགྱུར།"]},{"type":"verse","number":43,"content":["དེའི་དུས༌སུ། མི་གཞུང་དྲང་རྣམས་ཀྱིས་རང་གི་ཡབ་ཀྱི་རྒྱལ་སྲིད་དུ་ཉི་མ་དང་འདྲ་བར་འོད་སྤྲོ་བར༌འགྱུར། ཡང་རྣ་བ་ཡོད་པ་ཐམས་ཅད་ཀྱིས་གཏམ་འདིར་ཉོན་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["རིན་པོ་ཆེའི་གཏེར་ཁ་དང་མུ་ཏིག་གི༌དཔེ།"]},{"type":"verse","number":44,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ནི་ཞིང་ལ་སྦས་པའི་རིན་པོ་ཆེའི་གཏེར་མཛོད་དང་འདྲ༌བར། མི་ཞིག་གིས་གཏེར་མཛོད་དེ་རྙེད་ཅིང་སྦས༌རྗེས། དགའ་སྤྲོའི་ངང་རང་ལ་ཡོད་པ་ཐམས་ཅད་བཙོངས་ནས་ས་ཞིང་དེ་ཉོས༌སོ།།"]},{"type":"verse","number":45,"content":["ཡང་ནམ་མཁའི་རྒྱལ་སྲིད་ནི་ཚོང་པ་ཞིག་གིས་མུ་ཏིག་བཟང་པོ་འཚོལ་བ་དང་འདྲ༌སྟེ།"]},{"type":"verse","number":46,"content":["ཁོས་རིན་ཐང་ཆེ་བའི་མུ་ཏིག་ཅིག་མཐོང་སྟེ་རང་ལ་ཡོད་པ་ཐམས་ཅད་བཙོངས་ནས་མུ་ཏིག་དེ་ཉོས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དྲ་རྒྱའི༌དཔེ།"]},{"type":"verse","number":47,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ནི་རྒྱ་མཚོའི་ནང་དུ་དྲ་རྒྱ་འཕངས་ནས་ཉའི་རིགས་སྣ་ཚོགས་འཛིན་པ་དང་འདྲ༌སྟེ།"]},{"type":"verse","number":48,"content":["དྲ་རྒྱར་ཉས་བཀང་བ་དང་ཉ་པས་དྲ་རྒྱ་མཚོ་འགྲམ་དུ་འཐེན་ཏེ་བསྡད༌ཅིང༌། ཟས་སུ་རུང་བ་དག་སྣོད་དུ་བསྡུས་ཤིང་ཟས་སུ་མི་རུང་བ་དག་དོར༌བའོ།།"]},{"type":"verse","number":49,"content":["བསྐལ་པའི་མཐའ་མ་ལའང་དེ་ལྟར་འབྱུང་ངེས༌ཏེ། ཕོ་ཉ་རྣམས་ཕེབས་ནས་མི་གཞུང་དྲང་རྣམས་ཀྱི་ཁྲོད་ནས་མི་ངན་པ་རྣམས་ལོགས་སུ་བཀར༌ཏེ།"]},{"type":"verse","number":50,"content":["མེ་ཐབ་ནང་དུ་གཡུག་ཅིང་གནས་དེ་རུ་ངུ་འབོད་བྱས་ནས་ཨམ་གཙིགས་བསྡམ་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":51,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་དེ་ཐམས་ཅད་ཀྱི་དོན་གོའམ་ཞེས་གསུངས་པ༌དང༌། ཐུགས་སྲས་རྣམས་ཀྱིས་དོན་དེ་གོའོ་ཞེས་ཞུས༌སོ།།"]},{"type":"verse","number":52,"content":["ཡང་ཁོང་གིས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། ནམ་མཁའི་རྒྱལ་སྲིད་ཀྱི་རྗེས་འབྲང་པར་གྱུར་པའི་མཁན་པོ་རྣམས༌ནི། ཁྱིམ་བདག་ཅིག་གིས་རང་གི་བང་མཛོད་ནས་དངོས་པོ་གསར་པ་དང་རྙིང་པ་འཁྱེར་འོང་བ་དང་འདྲ་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཡུལ་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུར་བརྩི་བཀུར་མ་བྱས༌པ།"]},{"type":"verse","number":53,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དཔེ་དེ་དག་གསུངས༌རྗེས། ཁོང་ཉིད་གནས་དེ་དང་ཁ་བྲལ༌ཏེ།"]},{"type":"verse","number":54,"content":["རང་ཡུལ་དུ་ཕེབས་ཤིང་ཆོས་ཁང་དུ་ཡུལ་མི་རྣམས་ལ་ཆོས་གསུངས་པ༌ན། ཉན་མཁན་རྣམས་ངོ་མཚར་སྐྱེས༌ཏེ། མི་འདི་ལ་ཤེས་རབ་དང་ནུས་མཐུ་ཁྱད་པར་བ་དེ་ལྟ་བུ་གང་ནས་བྱུང༌ངམ།"]},{"type":"verse","number":55,"content":["མི་འདི་ནི་ཤིང་བཟོའི་བུ་དེ་མ་ཡིན༌ནམ། ཁོའི་མ་ནི་མིར་ཡམ་ཟེར་བ་དེ་མ་ཡིན༌ནམ། ཁོའི་ནུ་བོ་རྣམས་ནི་ཡ་ཀོབ༌དང༌། ཡོ༌སེབ། སི༌མོན། ཡུ་དཱ་བཅས་མ་ཡིན༌ནམ།"]},{"type":"verse","number":56,"content":["ཁོའི་སྲིང་མོ་རྣམས་ཀྱང་འདི་རུ་བདག་ཅག་དང་མཉམ་དུ་ཡོད་པ་མིན༌ནམ། དེས་ན་མི་འདིར་དོན་འདི་ལྟ་བུ་རྣམས་གང་ནས་བྱུང་ངམ་ཟེར༌ཞིང༌།"]},{"type":"verse","number":57,"content":["མི་དེ་རྣམས་ཁོང་ལ་མི་དགའ་བར་གྱུར༌ཏོ། །དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ལུང་སྟོན་པ་ལ་རང་ཡུལ་དང་ཁྱིམ་མི་ལས༌གཞན། བརྩི་བཀུར་མི་བྱེད་མཁན་གཅིག་ཀྱང་མེད་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":58,"content":["མི་དེ་རྣམས་ལ་དད་པ་མེད་པའི་རྐྱེན་གྱིས་སྐྱབས་མགོན་ཡེ་ཤུས་ངོ་མཚར་བའི་མཛད་པ་མང་པོ་མ་གནང༌ངོ༌།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/12.json","previousChapterAudioLinks":{},"numberOfVerses":58}