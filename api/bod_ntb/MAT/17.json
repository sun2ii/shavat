{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":17,"content":[{"type":"heading","content":["སྐུ་གཟུགས་ཀྱི་རྣམ་པ་འགྱུར༌བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཉིན་དྲུག་འགོར༌རྗེས། སྐྱབས་མགོན་ཡེ་ཤུས་པེ་ཏྲོ༌དང༌། ཡ༌ཀོབ། ཡ་ཀོབ་ཀྱི་སྤུན་ཡོ་ཧ་ནན་བཅས་ཁྲིད་ནས་རི་མཐོན་པོ་ཞིག་ཏུ་ཕེབས་པ༌དང༌།"]},{"type":"verse","number":2,"content":["ཁོ་རྣམས་ཀྱི་མདུན་དུ་ཁོང་གི་རྣམ་པ་འགྱུར༌ཏེ། ཞལ་རས་ནི་ཉི་འོད་བཞིན་དུ་འཕྲོ་བ༌དང༌། ན་བཟའ་ནི་འོད་ཟེར་ལྟར་དཀར་པོར༌གྱུར།"]},{"type":"verse","number":3,"content":["གློ་བུར་ཉིད་ལ་མོ་ཤེ་དང་ཨེ་ལི་ཡཱ་གཉིས་མངོན་སུམ་དུ་བྱུང་སྟེ་སྐྱབས་མགོན་ཡེ་ཤུ་དང་གསུང་མོལ་མཛད༌དོ།།"]},{"type":"verse","number":4,"content":["པེ་ཏྲོས་སྐྱབས་མགོན་ཡེ་ཤུ༌ལ། གཙོ་བོ༌ལགས། བདག་ཅག་འདི་རུ་བསྡད་ན་དངོས་གནས་ལེགས་པོ༌འདུག ཁྱེད་རང་ཐུགས་དགྱེས་ན་བདག་གིས་འདི་ནས་གུར་གསུམ་བཟོ་བར་བྱ༌སྟེ། ཁྱེད་ལ་གཅིག༌དང༌། མོ་ཤེ་ལ༌གཅིག ཨེ་ལི་ཡཱ་ལའང་གཅིག་ཅེས་ཞུ་བཞིན་པའི་མོད༌ལ།"]},{"type":"verse","number":5,"content":["སྐད་ཅིག་ལ་འོད་དང་ལྡན་པའི་སྤྲིན་ཕུང་ཞིག་གིས་ཁོང་རྣམས་བསྒྲིབས་པ་དང་དེའི་ཁྲོད་ནས་སྐད་སྒྲ་ཞིག་གྲགས༌ཏེ། འདི་ནི་བདག་གི་གཅེས་པའི་བུ་ཡིན༌ཞིང༌། ང་རང་ཁོ་ལ་ཤིན་ཏུ༌དགའ། ཁྱོད་ཅག་གིས་ཁོའི་གཏམ་ལ་ཉོན་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":6,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་གསུང་དེ་ཐོས་པ་དང་ཁ་སྦུབ་ཏུ་འགྱེལ་ཞིང་ཤིན་ཏུ༌འཇིགས།"]},{"type":"verse","number":7,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕེབས་ཡོང་སྟེ་ཁོ་རྣམས་ལ་ཕྱག་གིས་རེག༌ཅིང༌། ཡར་ལོངས་དང་མ་འཇིགས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":8,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་ཡར་བལྟས་པ་ན་སྐྱབས་མགོན་ཡེ་ཤུ་ལས་གཞན་སུའང་མ་མཐོང༌ངོ༌།།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཁོང་རྣམས་རི་བོ་ལས་མར་ཕེབས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། མིའི་བུ་ད་དུང་འཆི་བ་ལས་སླར་གསོན་པའི་བར་དུ་ཁྱོད་རྣམས་ཀྱིས་ཅི་མཐོང་བ་དེ་གཞན་སུ་ལའང་མི་སྨྲ་བར་གྱིས་ཞེས་བཀའ་བསྒོས༌སོ།།"]},{"type":"verse","number":10,"content":["ཐུགས་སྲས་རྣམས་ན༌རེ། མཁན་པོ་རྣམས་ཀྱིས་ཨེ་ལི་ཡཱ་སྔོན་ལ་འབྱོན་ངེས་ཡིན་ཞེས་ཟེར་དོན་ཅི་ཞུས་པ༌ལ།"]},{"type":"verse","number":11,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཨེ་ལི་ཡཱ་དངོས་སུ་སྔོན་ལ་བྱོན་ཏེ་ཐམས་ཅད་བསྐྱར་དར་བྱ་བར༌ངེས།"]},{"type":"verse","number":12,"content":["འོན༌ཀྱང༌། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཨེ་ལི་ཡཱ་ནི་སྔར་ནས་བྱོན་ཟིན༌ཅིང༌། མི་རྣམས་ཀྱིས་ཁོང་ཉིད་སུ་ཡིན་པ་མ་ཤེས༌པས་ཁོང་ལ་ཅི་འདོད་བཞིན༌བྱས། དེ་བཞིན༌དུ། མི་དེ་རྣམས་ཀྱིས་མིའི་བུ་ལའང་གནོད་འཚེ་བྱ་བར་འགྱུར་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":13,"content":["ད་གཟོད་ཐུགས་སྲས་རྣམས་ཀྱིས་གསུང་འདི་ནི་ཁོང་གིས་ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་ལ་དམིགས་ནས་གསུངས་པ་ཤེས༌སོ།།"]},{"type":"heading","content":["གདོན་འདྲེས་བཟུང་བའི་བུ་ཞིག་གསོས༌པ།"]},{"type":"verse","number":14,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཐུགས་སྲས་རྣམས་མི་ཚོགས་ཡོད་སར་ཕེབས་པ༌དང༌། མི་ཞིག་ཁོང་གི་དྲུང་དུ་ཡོང་ནས་པུས་མོ་སར་བཙུགས་ཏེ་ན༌རེ།"]},{"type":"verse","number":15,"content":["གཙོ་བོ༌ལགས། བདག་གི་བུ་ལ་སྙིང་རྗེ་གནང་བར༌མཛོད། ཁོ་ལ་གཟའ་ཕོག་ནས་སྡུག་བསྔལ་ཆེན་པོ་མྱངས༌ཏེ། ཐེངས་དུ་མར་མེའི་ནང་དུ་ལྷུང་བ༌དང༌། ཐེངས་དུ་མར་ཆུའི་ནང་དུའང༌ལྷུང༌།"]},{"type":"verse","number":16,"content":["ངས་རང་གི་བུ་ཁྱེད་ཀྱི་ཐུགས་སྲས་རྣམས་ཀྱི་དྲུང་དུ་ཁྲིད༌ནའང༌། དེ་རྣམས་ཀྱིས་ཁོ་རང་གསོ་བར་མ་ནུས་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":17,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཀྱེ། དད་པ་མེད་པ་དང་ཕྱིན་ཅི་ལོག་པའི་མི་རབས༌འདི། བདག་ནི་ཁྱོད་ཅག་དང་མཉམ་དུ་དུས་ནམ་ཞིག་གི་བར་དུ་སྡོད་དགོས༌སམ། ངས་དུས་ནམ་ཞིག་གི་བར་དུ་ཁྱོད་རྣམས་ལ་བཟོད་བསྲན་བྱེད་དགོས༌སམ། བུ་དེ་བདག་གི་མདུན་དུ་ཁྲིད་ཤོག་ཅིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":18,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་གདོན་འདྲེ་དེར་བཀའ་བཀྱོན་མཛད་པ་དང་གདོན་འདྲེ་ཕྱི་རུ༌ཐོན། དེ་ནས་བཟུང་བུ་དེ་ནད་ལས་ཐར་བར་གྱུར༌ཏོ།།"]},{"type":"verse","number":19,"content":["ཐུགས་སྲས་རྣམས་ཟུར་དུ་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་ལ་ཡོང༌སྟེ། ངེད་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་གདོན་འདྲེ་དེ་ཕྱིར་སྐྲོད་མ་ནུས་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":20,"content":["ཁོང་གིས་འདི་སྐད༌དུ། དེ་ནི་ཁྱོད་རྣམས་ཀྱི་དད་པ་ཆུང་བའི་ཕྱིར༌ཡིན། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། ཁྱོད་རྣམས་ལ་ཡུངས་འབྲུའི་ས་བོན་ལྟ་བུའི་དད་པ་ཆུང་ངུ་ཙམ་ཡོད༌ན། ཁྱོད་རྣམས་ཀྱིས་རི་བོ་འདི༌ལ། ཁྱོད་འདི་ནས་ཕར་སྤོས་ཤིག་ཅེས་སྨྲས༌ན། རི་བོ་དེའང་ཕར་སྤོ་བར་འགྱུར༌བས། ཁྱོད་རྣམས་ཀྱིས་བསྒྲུབ་མི་ནུས་པ་ཅི་ཡང༌མེད།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་གདོན་འདྲེ་འདིའི་རིགས་སྨོན་ལམ་འདེབས་པ་དང་སྨྱུང་གནས་སྲུང་བ་ལས༌གཞན། ཐབས་གང་གིས་ཀྱང་ཕྱིར་སྐྲོད་མི་ནུས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":22,"content":["ཁོང་རྣམས་ག་ལིལ་ཡུལ་དུ་འཛོམས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། མིའི་བུ་ཁོ་རང་མི་རྣམས་ཀྱི་ལག་ཏུ་སྤྲོད༌ཅིང༌།"]},{"type":"verse","number":23,"content":["དེ་རྣམས་ཀྱིས་ཁོ་རང་གསོད་པར་འགྱུར༌ཡང༌། ཉིན་གསུམ་པ་ལ་ཁོ་རང་སླར་གསོན་ངེས་ཡིན་ཞེས་གསུངས༌པས། ཐུགས་སྲས་རྣམས་ཀྱི་སེམས་ཤིན་ཏུ་སྐྱོ་བར་གྱུར༌ཏོ།།"]},{"type":"heading","content":["མཆོད་ཁང་གི་དཔྱ་ཁྲལ༌སྐོར།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཁོང་རྣམས་ཀཱ་ཕར་ན་ཧུམ་དུ་སླེབས་པ༌ན། མཆོད་ཁང་གི་དཔྱ་ཁྲལ་ལེན་མཁན་རྣམས་པེ་ཏྲོའི་གམ་དུ་ཡོང༌སྟེ། ཁྱོད་ཀྱི་སློབ་དཔོན་གྱིས་མཆོད་ཁང་ལ་དཔྱ་ཁྲལ་མི་འཇལ་ལམ་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":25,"content":["པེ་ཏྲོས་འཇལ་བ་ཡིན་ཞེས་སྨྲས༌སོ། །པེ་ཏྲོ་ཁང་པའི་ནང་དུ་སོང་བ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་སྔོན་ལ་འདི་སྐད༌དུ། སི༌མོན། ཁྱོད་ཀྱིས་ཇི་ལྟར་བསམ་པ་ཡིན༌ནམ། འཇིག་རྟེན་གྱི་རྒྱལ་པོ་རྣམས་ཀྱིས་སུ་ལས་ཤོ་གམ་མམ་དཔྱ་ཁྲལ་ལེན་པ་ཡིན༌ནམ། རང་གི་སྲས་ལས་ལེན་ནམ་གཞན་ལས་ལེན་པ་ཡིན་ཞེས་གསུངས་པ༌ལ།"]},{"type":"verse","number":26,"content":["པེ་ཏྲོས་མི་གཞན་དག་ལས་ལེན་པ་ཡིན་ཞེས་ཞུས༌སོ། །ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། དེས་ན་རྒྱལ་སྲས་རྣམས་ཀྱིས་དཔྱ་ཁྲལ་མ་འཇལ་ཡང༌ཆོག"]},{"type":"verse","number":27,"content":["འོན༌ཀྱང༌། དཔྱ་ཁྲལ་ལེན་མཁན་དེ་རྣམས་ཁྲོ་རུ་མི་འཇུག་པའི༌ཕྱིར། ཁྱོད་རང་མཚོ་འགྲམ་དུ་ལྕགས་ཀྱུ་འཕངས་ནས་ཉ་འཛིན་དུ་སོང༌ཞིག ཐོག་མར་བཟུང་བའི་ཉ་དེའི་ཁ་ཕྱེས་ཤིག་དང་དངུལ་སྒོར་གཅིག་རྙེད་པར༌འགྱུར། ཁྱོད་ཀྱིས་དངུལ་སྒོར་དེ་ཁྱེར་ནས་ངེད་གཉིས་ཀའི་དཔྱ་ཁྲལ་གྱི་ཚབ་ཏུ་དེ་རྣམས་ལ་བྱིན་ཅིག་ཅེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}