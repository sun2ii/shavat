{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":24,"content":[{"type":"heading","content":["བསྐལ་པའི་མཐའ་མའི་སྐོར་གྱི་ལུང༌བསྟན།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་ཁང་ནས་ཕྱིར་ཕེབས༌དུས། ཐུགས་སྲས་རྣམས་ཁོང་གི་དྲུང་དུ་ཡོང་སྟེ་མཆོད་ཁང་གི་བཟོ་བཀོད་ཁོང་ལ་བསྟན་པ༌ན།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་འདི་ཐམས་ཅད་མཐོང་བ་མ་ཡིན༌ནམ། ངས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། མ་འོངས་པར་འདི་རུ་རྡོ་ཕ་བོང་སྟེང་དུ་རྡོ་གཅིག་ཀྱང་མི་ལུས་པར་ཐམས་ཅད་བཤིག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":3,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྐྱུ་རུ་རའི་རི་བོར་བཞུགས༌དུས། ཐུགས་སྲས་རྣམས་ཟུར་དུ་ཁོང་གི་དྲུང་ལ་ཡོང༌སྟེ། དོན་འདི་རྣམས་དུས་ནམ་ཞིག་ལ་འབྱུང༌ཞིང༌། ཁྱེད་རང་ཕེབས་ཡོང་བ་དང་བསྐལ་པའི་མཐའ་མར་རྟགས་ཅི་ཞིག་ཡོད་པ་གསུང་བར་མཛོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། སུ་ཞིག་གིས་ཀྱང་ཁྱོད་རྣམས་མི་བསླུ་བའི་ཆེད་དུ་དོགས་པར༌གྱིས།"]},{"type":"verse","number":5,"content":["རྒྱུ་མཚན་ནི་མི་མང་པོས་ངའི་མིང་དུ་རྫུ་བཞིན་ཡོང༌སྟེ། ང་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་ཟེར་ཞིང་མི་མང་པོ་བསླུ་བར༌ངེས།"]},{"type":"verse","number":6,"content":["ཡང་ཁྱོད་ཅག་གིས་དམག་འཁྲུག་དང་དམག་འཁྲུག་གི་གཏམ་ཐོས་པར་འགྱུར་ཡང་འཇིགས་པར་མི༌བྱའོ། །རྒྱུ་མཚན་ནི་དོན་འདི་དག་འབྱུང་ངེས༌ཀྱང༌། དེ་ནི་མཐའ་མའི་དུས་ལ་སླེབས་པ་མ་ཡིན༌ཏེ།"]},{"type":"verse","number":7,"content":["མི་རིགས་དང་མི་རིགས་འཁྲུག་ཅིང་རྒྱལ་ཁབ་དང་རྒྱལ་ཁབ་འཁྲུག༌པ། ས་ཆ་མང་པོར་མུ་གེ་དང་ས་འགུལ་ཡང་འབྱུང་བར༌འགྱུར།"]},{"type":"verse","number":8,"content":["དོན་འདི་ཐམས་ཅད་ནི་སྦྲུམ་མའི་ཟུག་གཟེར་གྱི་ཐོག་མ༌ཡིན།",{"noteId":18}]},{"type":"verse","number":9,"content":["དེའི་དུས༌སུ། མི་རྣམས་ཀྱིས་ཁྱོད་ཅག་དཀའ་སྡུག་ལ་སྦྱོར་ཞིང་གསོད་པར་འགྱུར་བ༌དང༌། ངའི་མིང་གི་རྐྱེན་གྱིས་མི་རིགས་ཐམས་ཅད་ཁྱོད་ཅག་ལ་སྡང་བར༌འགྱུར།"]},{"type":"verse","number":10,"content":["ཡང་དེའི་དུས༌སུ། མི་མང་པོ་ཞིག་དད་པ་ལོག་པ་དང་ཕན་ཚུན་ངོ་ལོག་བྱེད་ཅིང་སྡང་བར༌འགྱུར།"]},{"type":"verse","number":11,"content":["ཡང་ལུང་སྟོན་པ་རྫུས་མ་མང་པོ་འབྱུང་ཞིང་མི་མང་པོ་བསླུ་བར༌འགྱུར།"]},{"type":"verse","number":12,"content":["ཁྲིམས་འགལ་གྱི་ལས་ཇེ་མང་དུ་སོང་བས་མི་མང་པོའི་བྱམས་སེམས་ཀྱང་ཉམས་པར༌འགྱུར།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་མཐར་ཐུག་ཏུ་བཟོད་བསྲན་བྱེད་མཁན་དེ་ལ་ཐར་པ་འཐོབ་ངེས་ཡིན།"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་འཕྲིན་བཟང་འདི་མི་རིགས་ཐམས་ཅད་ལ་བདེན་དཔང་བྱེད་པའི་ཕྱིར་འཇིག་རྟེན་ཡོངས་ལ་བསྒྲགས༌རྗེས། དུས་ཀྱི་མཐའ་མ་ད་གཟོད་སླེབ་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":15,"content":["དེའི༌ཕྱིར། མདོ་འདི་ཀློག་མཁན་གྱིས་དོན་རྟོགས་པར་བྱ༌སྟེ། ནམ་ཞིག་ཁྱོད་ཅག་གིས་ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་གྱི་མདོ་ལས་སྟོང་པར་བྱེད་པའི་སྐྱུག་བྲོ་བ་དེ་གནས་དམ་པ་རུ་འགྲེངས་ནས་བསྡད་ཡོད་པ་མཐོང༌དུས་སུ།",{"noteId":19}]},{"type":"verse","number":16,"content":["ཡ་ཧུ་དཱའི་ཡུལ་དུ་ཡོད་པ་རྣམས་རི་ལ་འབྲོ་བར༌གྱིས།"]},{"type":"verse","number":17,"content":["ཁང་པའི་སྟེང་དུ་ཡོད་པ་རྣམས་ཀྱང་སར་བབས་ནས་རང་ཁྱིམ་དུ་དངོས་པོ་ལེན་དུ་མ༌འགྲོའོ།།"]},{"type":"verse","number":18,"content":["ཞིང་ཁར་ཡོད་པ་རྣམས་རང་གི་གྱོན་པ་ལེན་དུའང་ཕྱིར་མ་ལོག༌ཅིག"]},{"type":"verse","number":19,"content":["ཉིན་དེ་དག་གི་རིང༌ལ། བུད་མེད་སྦྲུམ་མ་དང་ཕྲུ་གུར་ནུ་མ་སྣུན་མཁན་རྣམས་སྙིང་རེ་རྗེ༌ཨང༌།"]},{"type":"verse","number":20,"content":["ཁྱོད་རྣམས་ཡུལ་གཞན་དུ་འབྲོ་བའི་དུས་དེ་དགུན་ཁའམ་ངལ་གསོ་བའི་ཉིན་དང་མི་འཕྲད་པའི་ཕྱིར་སྨོན་ལམ་ཐོབས༌ཤིག"]},{"type":"verse","number":21,"content":["རྒྱུ་མཚན་ནི་དེའི་དུས་སུ་དཀའ་སྡུག་ཆེན་པོ་འབྱུང་བར་འགྱུར༌ཏེ། དཀའ་སྡུག་དེ་ལྟ་བུ་ནི་འཇིག་རྟེན་བཀོད་པ་ནས་ད་ལྟའི་བར་དུ་བྱུང་མ་མྱོང༌ལ། རྗེས་སུའང་འབྱུང་མི༌སྲིད།"]},{"type":"verse","number":22,"content":["ཡང་ཉིན་དེ་དག་ཇེ་ཉུང་དུ་མཛད་པ་མིན༌ན། ཤ་ཁྲག་གདོས་བཅས་སུ་གྲུབ་པ་སུ་ཡང་ཐར་མི་ཐུབ༌མོད། འོན་ཀྱང་བདམས་པའི་མི་",{"noteId":20},"རྣམས་ཀྱི་དོན་དུ་ཉིན་དེ་དག་ཇེ་ཉུང་དུ་མཛད་ངེས༌ཡིན།"]},{"type":"verse","number":23,"content":["དེའི་དུས༌སུ། སུ་ཞིག་གིས་ཁྱོད་ཅག་ལ་ལྟོས་དང་མཱ་ཤི་ཀ་འདི་རུ༌བཞུགས། ཡང་ན་དེ་གར་བཞུགས་ཞེས་སྨྲས་ཀྱང་དེ་ལ་ཡིད་རྟོན་བྱ་མི་རུང༌ངོ༌།།"]},{"type":"verse","number":24,"content":["རྒྱུ་མཚན་ནི་མཱ་ཤི་ཀ་བཅོས་མ་དང་ལུང་སྟོན་པ་རྫུས་མ་མང་པོ་འབྱུང༌ཞིང༌། གལ་ཏེ་བསླུ་ནུས་ན་བདམས་པའི་མི་རྣམས་ཀྱང་བསླུ་བའི༌ཕྱིར། གྲུབ་རྟགས་ཆེན་པོ་དང་ངོ་མཚར་བའི་དོན་རྣམས་ཀྱང་སྟོན་པར༌འགྱུར།"]},{"type":"verse","number":25,"content":["ལྟོས༌དང༌། བདག་གིས་སྔ་མོ་ནས་དོན་འདི་ཁྱོད་ཅག་ལ་སྨྲས་པ༌ཡིན།"]},{"type":"verse","number":26,"content":["ཡང་དེ་རྣམས་ཀྱིས་ཁྱོད་ཅག་ལ་ལྟོས༌དང༌། མཱ་ཤི་ཀ་དབེན་པའི་གནས་སུ་བཞུགས་ཞེས་ཟེར་ཡང་ཕྱི་རོལ་ཏུ་མ༌འགྲོའོ། །ཡང་ལྟོས༌དང༌། མཱ་ཤི་ཀ་ཁང་པའི་ཕུགས་སུ་བཞུགས་ཞེས་ཟེར་ཡང་ཡིད་ཆེས་མི༌བྱའོ།།"]},{"type":"verse","number":27,"content":["རྒྱུ་མཚན་ནི་ཤར་ནས་ནུབ་ཕྱོགས་སུ་གློག་དམར་འཁྱུག་པ༌བཞིན། མིའི་བུ་ཡང་དེ་ལྟར་ཕེབས་ཡོང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":28,"content":["བེམ་པོ་གང་དུ་ཡོད་ན་བྱ་རྒོད་དག་ཀྱང་གནས་དེར་འཁོར་ཡོང་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕེབས་ཡོང་བའི༌སྐོར།"]},{"type":"verse","number":29,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཉིན་དེ་དག་གི་དཀའ་སྡུག་བྱུང་རྗེས་ཉི་མ་སྒྲིབ་ཅིང་ཟླ་བས་ཀྱང་འོད་མི༌སྤྲོའོ། །སྐར་ཚོགས་ནམ་མཁའ་ནས་ལྷུང་ཞིང་བར་སྣང་ཁམས་ཀྱི་དབང་ཐམས་ཅད་གཡོ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":30,"content":["དེའི་དུས༌སུ། མིའི་བུ་ཡི་རྟགས་ནི་ནམ་མཁའ་རུ་འབྱུང༌ཞིང༌། ས་སྟེང་གི་མི་རིགས་ཐམས་ཅད་ཀྱིས་མྱ་ངན་བྱེད་པ༌དང༌། དེ་རྣམས་ཀྱིས་མིའི་བུ་ཁོ་རང་ནུས་མཐུ་དང་གཟི་བརྗིད་ཆེན་པོའི་ངང་ནམ་མཁའི་སྤྲིན་གྱི་བང་རིམ་ནས་འབྱོན་པ་མཐོང་བར༌འགྱུར།"]},{"type":"verse","number":31,"content":["ཡང་ཁོས་རང་ཉིད་ཀྱི་ཕོ་ཉ་རྣམས་དུང་སྒྲ་ཆེན་པོ་དང་བཅས་མངགས་ཤིང་དེ་རྣམས་ཀྱིས་ཁོའི་བདམས་པའི་མི་ཐམས་ཅད་ནི་ནམ་མཁའི་མཐའ་མཚམས་གཅིག་ནས་མཐའ་མཚམས་གཞན་པའི་བར་དུ་ཕྱོགས་བཞི་མཚམས་བརྒྱད་ནས་བསྡུ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":32,"content":["ཁྱོད་ཅག་གིས་བསེ་ཡབ་ཤིང་ལས་བསླབ་བྱ་ཞིག་ལོངས་དང༌། དེའི་ཡལ་ག་མཉེན་ལྕུག་ལྡན་པར་གྱུར་ནས་ལོ་མ་འབུས་པའི་དུས༌སུ། དབྱར་ཁའི་དུས་ལ་ཉེ་བ་ཁྱོད་ཅག་གིས་ཤེས༌སོ།།"]},{"type":"verse","number":33,"content":["དེ་བཞིན་དུ་ཁྱོད་ཅག་གིས་དོན་དེ་དག་ཐམས་ཅད་མཐོང་བའི༌ཚེ། མིའི་བུ་སླེབས་ལ་ཉེ་བ་དང་སྒོ་འགྲམ་དུ་སླེབས་ཡོད་པ་རྟོགས་པར༌གྱིས།"]},{"type":"verse","number":34,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་བདེན་པར་སྨྲ༌སྟེ། མི་རབས་འདི་ད་དུང་མ་འདས་པའི་སྔོན་ལ་དོན་འདི་ཐམས་ཅད་འབྱུང་བར༌འགྱུར།"]},{"type":"verse","number":35,"content":["གནམ་ས་གཉིས་ནི་འཇིག་སྲིད་ཀྱང་བདག་གི་བཀའ་རྣམས་འཇིག་པར་མི་འགྱུར༌རོ།།"]},{"type":"heading","content":["ཉིན་མོ་དེའམ་དུས་དེ་ཤེས་མཁན་སུ་ཡང་མེད༌པ།"]},{"type":"verse","number":36,"content":["འོན་ཀྱང་མི་སུས་ཀྱང་ཉིན་མོ་དེ་དང་དུས་དེ་ནི་ནམ་ཞིག་ཡིན་པ་མི་ཤེས༌ཤིང༌། ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་ཕོ་ཉ་རྣམས་ཀྱིས་ཀྱང་མི་ཤེས༌ལ། སྲས་ཀྱིས་ཀྱང་མི་ཤེས་ཏེ་ཡབ་གཅིག་པུས་མཁྱེན༌ཏོ།།"]},{"type":"verse","number":37,"content":["རྒྱུ་མཚན་ནི་ནོ་ཨའི་དུས་ནི་ཇི་ལྟར་བྱུང་བ་བཞིན་མིའི་བུ་ཕེབས་ཡོང་བའི་དུས་ཀྱང་དེ་ལྟར་འབྱུང་བར༌འགྱུར།"]},{"type":"verse","number":38,"content":["ཆུ་ལོག་ཆེན་པོ་མ་བྱུང་བའི་ཡར་སྔོན༌དུ། མི་རྣམས་ཀྱིས་བཟའ་བཏུང་ལ་རོལ་བ་དང་བག་མ་ཚུར་ལེན་ཕར་བསྐྱལ་བྱས༌ཤིང༌། ནོ་ཨ་གྲུ་གཟིངས་ཀྱི་ནང་དུ་ཞུགས་པའི་ཉིན༌དེར།"]},{"type":"verse","number":39,"content":["ཆུ་ལོག་ཆེན་པོ་བྱུང་སྟེ་མི་ཐམས་ཅད་ཆུས་ཁུར་བའི་བར༌དུ། མི་རྣམས་ཀྱིས་ཅི་ཡིན་འདི་ཡིན་མ་ཤེས༌ལ། མིའི་བུ་ཕེབས་ཡོང་བའི་དོན་ཡང་དེ་ལྟར༌འབྱུང༌།"]},{"type":"verse","number":40,"content":["དུས༌དེར། མི་གཉིས་ཞིང་ཁར་ཡོད་པ་ལས་གཅིག་ནི་འདྲེན་ཞིང་གཅིག་ནི་བསྐྱུར་བར༌འགྱུར།"]},{"type":"verse","number":41,"content":["ཡང་བུད་མེད་གཉིས་ཀྱིས་ལག་སྐོར་གཅིག་བསྐོར་བ་ལས་གཅིག་ནི་འདྲེན་ཞིང་གཅིག་ནི་བསྐྱུར་བར༌འགྱུར།"]},{"type":"verse","number":42,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་གི་གཙོ་བོ་ཁོང་ཉིད་ཉིན་གང་ཞིག་ལ་ཕེབས་པར་འགྱུར་བ་ཁྱོད་རྣམས་ཀྱིས་མི་ཤེས་པས་གཟབ་པར་གྱིས༌ཤིག"]},{"type":"verse","number":43,"content":["ཁྱིམ་བདག་གིས་མཚན་མོའི་དུས་སུ་ནམ་ཞིག་ལ་རྐུན་མ་ཡོང་ངེས་པ་ཤེས༌ན། ཁོས་གཟབ་གཟབ་བྱས་ནས་རྐུན་མ་ཁྱིམ་ལ་འཛུལ་དུ་མི་འཇུག་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པར༌གྱིས།"]},{"type":"verse","number":44,"content":["དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་སྟ་གོན་བྱོས༌དང༌། རྒྱུ་མཚན་ནི་ཁྱོད་ཅག་གིས་སེམས་སུའང་མི་དྲན་པའི་དུས་ཤིག༌ལ་མིའི་བུ་ཕེབས་ཡོང་བར་ངེས༌སོ།།"]},{"type":"verse","number":45,"content":["དེས་ན་སུ་ཞིག་བློ་སེམས་དཀར་ཞིང་འཇོན་ཐང་ཅན་གྱི་གཡོག་པོ་ཡིན་པ༌དང༌། བདག་པོས་ཁོ་ནི་རང་གི་གཡོག་པོ་རྣམས་ཀྱི་འགོ་བར་བསྐོས༌ཏེ། དུས་ལྟར་དེ་རྣམས་ལ་ཟས་སྐལ་སྟེར་བ་ཡིན༌ནམ།"]},{"type":"verse","number":46,"content":["བདག་པོ་ཕྱིར་སླེབས་ཏེ་གཡོག་པོས་དེ་ལྟར་སྒྲུབ་བཞིན་པ་མཐོང༌ན། གཡོག་པོ་དེ་ནི༌བདེའོ།།"]},{"type":"verse","number":47,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། བདག་པོས་གཡོག་པོ་དེར་རྒྱུ་ནོར་ཐམས་ཅད་དོ་དམ་བྱེད་པའི་དབང་སྤྲོད་པར༌འགྱུར།"]},{"type":"verse","number":48,"content":["འོན༌ཀྱང༌། གཡོག་པོ་ངན་པ་དེས་རང་གི་སེམས་སུ་ངའི་བདག་པོ་ཕྱིར་ཡོང་བ་འཕྱིའོ་སྙམ༌སྟེ།"]},{"type":"verse","number":49,"content":["གཡོག་པོ་གཞན་རྣམས་ལ་གཅར་རྡུང་བྱེད་པ༌དང༌། ར་བཟི་བའི་མི་རྣམས་དང་འགྲོགས་ནས་བཟའ་བཏུང་སྤྱོད་པ་ཡིན༌ན།"]},{"type":"verse","number":50,"content":["ཁོས་སེམས་སུའང་མི་དྲན་པའི་ཉིན་ཞིག༌དང༌། མི་ཤེས་པའི་དུས་ཞིག༌ལ། གཡོག་པོ་དེའི་བདག་པོ་ཕྱིར་ཕེབས༌ཏེ།"]},{"type":"verse","number":51,"content":["ཁོ་རང་དུམ་བུར་གཅོད༌ཅིང༌། ཚུལ་འཆོས་པ་དང་མཉམ་དུ་གཏོང༌སྟེ། གནས་དེ་རུ་ངུ་འབོད་བྱས་ནས་ཨམ་གཙིགས་བསྡམ་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":18,"caller":"+","text":"སྦྲུམ་མའི་ཟུག་གཟེར་གྱི་ཐོག་མ་ཡིན་ཞེས་པ་ནི་སྦྲུམ་མ་རྣམས་ཀྱིས་ཕྲུ་གུ་བཙའ་སྐབས་ཀྱི་ན་ཟུག་གམ་སྡུག་བསྔལ་ལྟ་བུ་བསྟན་པ༌ཡིན། སྤྱི་ལོ་70ལོར། ཡེ་རུ་སཱ་ལེམ་དུ་དམག་འཁྲུག་ཆེན་པོ་བྱུང་ནས་མི་གྲངས་མེད་ཅིག་ཤི་བའི་ལོ་རྒྱུས་ཀྱི་དོན་རྐྱེན་བྱུང་བ་དང་གྲོང་ཁྱེར་དེ་ཡང་རྩ་བ་ནས་བརླག་པར་གྱུར་པ་ལ་གོ་བ༌དང༌། གཞན༌ཡང༌། མ་འོངས་པའི་དུས་སུ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ཕྱིར་འཇིག་རྟེན་དུ་མ་ཕེབས་པའི་སྔོན༌ལ། འཇིག་རྟེན་དུ་དམག་འཁྲུག་དང་ནད་ཡམས་མུ་གེ་ལ་སོགས་པ་འབྱུང་བའི་སྡུག་བསྔལ་ཆེན་པོའང་བསྟན་པ༌ཡིན།","reference":{"chapter":24,"verse":8}},{"noteId":19,"caller":"+","text":"ཚིག་རྐང་འདི་ནི་དམ་པའི་གསུང་རབ་ཀྱི་ཞལ་ཆད་རྙིང་པའི་ལུང་སྟོན་པ་དཱ་ནེ་ཨེལ་ཞེས་བྱ་བའི་ལུང་བསྟན་ལས༌འབྱུང༌། གཞུང་དེའི་ལེའུ་དགུ་པའི་ཚིག་རྐང་ཉེར་བདུན་པ་དང༌། ལེའུ་བཅུ་གཅིག་པའི་ཚིག་རྐང་སོ་གཅིག་པ་དང༌། ལེའུ་བཅུ་གཉིས་པའི་ཚིག་རྐང་བཅུ་གཅིག་པ་བཅས་སུ༌གསལ།","reference":{"chapter":24,"verse":15}},{"noteId":20,"caller":"+","text":"བདམས་པའི་མི་ཞེས་པ་ནི་སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཡེ་ཤུའི་ཆོས་ལུགས་ལ་དད་པ་བྱེད་མཁན་རྣམས་ལ་དཀོན་མཆོག་གིས་བདམས་པའི་མི་ཞེས༌འབོད།","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/bod_ntb/MAT/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/23.json","previousChapterAudioLinks":{},"numberOfVerses":51}