{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":27,"content":[{"type":"heading","content":["ཡུ་དཱ་ཡིས་རང་སྲོག་བཅད༌པ།"]},{"type":"verse","number":1,"content":["ནམ་ལངས༌རྗེས། མཆོད་དཔོན་ཆེན་པོ་དག་དང་ཡུལ་མི་རྒན་པོ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་དགྲོང་བར་གྲོས་བྱས༌ཤིང༌།"]},{"type":"verse","number":2,"content":["ཁོང་ཉིད་བཀྱིགས་ནས་ཁྲིད་དེ་སྤྱི་དཔོན་པི་ལ་ཏུ་ལ་སྤྲད༌དོ།།"]},{"type":"verse","number":3,"content":["དུས༌དེར། སྐྱབས་མགོན་ཡེ་ཤུར་ངོ་ལོག་བྱེད་མཁན་ཡུ་དཱ་ཡིས་སྐྱབས་མགོན་ཡེ་ཤུར་ཉེས་ཆད་བཅད་པ་མཐོང་ནས་འགྱོད་པ་སྐྱེས༌ཏེ། མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་ལ་དངུལ་སྲང་སུམ་ཅུ་བོ་ཕྱིར་བྱིན་ཏེ་ན༌རེ།"]},{"type":"verse","number":4,"content":["ངས་ཉེས་མེད་གཡོ་བཙོང་བྱས་པས་སྡིག་པ་བྱས་སོ་ཞེས་སྨྲས་པ༌དང༌། དེ་རྣམས་ན༌རེ། དོན་དེ་ངེད་ཅག་དང་འབྲེལ་བ་ཅི་མཆིས༌སམ། དེ་ནི་ཁྱོད་རང་གི་འགན་ཁུར་རེད་ཅེས༌སྨྲས།"]},{"type":"verse","number":5,"content":["ཡུ་དཱ་ཡིས་དངུལ་སྲང་དེ་དག་མཆོད་ཁང་ནང་དུ་འཕངས་རྗེས་ཕྱི་རོལ་ཏུ་སོང་ནས་ལྕེབས༌སོ།།"]},{"type":"verse","number":6,"content":["མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་དངུལ་སྲང་དེ་དག་ས་ནས་བླངས༌ཤིང༌། འདི་ནི་ཁྲག་རིན་ཡིན་པས་མཆོད་ཁང་གི་དཀོར་མཛོད་དུ་འཇོག་མི་འོས་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":7,"content":["དེ་དག་གིས་གྲོས་བྱས་ནས་དངུལ་སྲང་དེས་རྫ་མཁན་གྱི་ས་ཞིང་ཟེར་བ་ཉོས༌ཏེ། ཕྱི་མི་རྣམས་ཀྱི་དུར་ས་རུ་བྱས༌སོ།།"]},{"type":"verse","number":8,"content":["དེའི༌ཕྱིར། ད་ལྟའི་བར་དུ་ས་ཞིང་དེ་ལ་ཁྲག་གི་ས་ཞིང་ཞེས༌ཟེར།"]},{"type":"verse","number":9,"content":["དེ་ལ་ལུང་སྟོན་པ་ཡེ་རེམ་ཡཱ་ཡིས་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དེ་རྣམས་དངུལ་སྲང་སུམ་ཅུ་བླངས་པ༌ནི།།","poem":1},{"lineBreak":true},{"text":"དེ་སྔར་ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད༌ཀྱིས།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་རིན་གོང་གཏན་ལ་ཁེལ་བ༌བཞིན།།","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"དངུལ་སྲང་དག་གིས་རྫ་མཁན་ས་ཞིང༌ཉོས།།","poem":1},{"lineBreak":true},{"text":"དེ་སྐད་གཙོ་བོས་བདག་ལ་བཀའ་བསྩལ༌ཏོ།།","poem":1},"ཞེས་གསུངས་པ་ལྟར་གྲུབ༌པའོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྤྱི་དཔོན་པི་ལ་ཏུའི་མདུན་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":11,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྤྱི་དཔོན་པི་ལ་ཏུའི་མདུན་དུ་བཞེངས་པའི༌ཚེ། སྤྱི་དཔོན་ན༌རེ། ཁྱོད་ནི་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན། ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་སྨྲས་པ་བཞིན་ཡིན་ཞེས༌གསུངས།"]},{"type":"verse","number":12,"content":["མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་ཀྱིས་ཁོང་ལ་ཉེས་སྐྱོན་འཛུགས༌དུས། ཁོང་གིས་བཀའ་ལན་ཅི་ཡང་མ་གནང༌ངོ༌།།"]},{"type":"verse","number":13,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། མི་དེ་དག་གིས་དཔང་བཙུགས་ནས་ཁྱོད་རང་ཅི་ཙམ་གཏུག་པ་མི་ཐོས་སམ་ཞེས་དྲིས༌ནའང༌།"]},{"type":"verse","number":14,"content":["ཁོང་གིས་ལན་ཅི་ཡང་མ་བཏབ་ཅིང་ཚིག་གཅིག་ཀྱང་མ་གསུངས་པས་སྤྱི་དཔོན་ཡང་ཤིན་ཏུ་ཧ་ལས༌སོ།།"]},{"type":"verse","number":15,"content":["སྤྱི་དཔོན་ལ་མཚོན༌ན། དུས་ཆེན་འདི་ལ་ཁེལ༌དུས། མི་སེར་གྱི་འདོད་བློ་ལྟར་ཁོ་རྣམས་ལ་བཙོན་པ་ཞིག་བཙོན་གྲོལ་གཏོང་བའི་རྒྱུན་སྲོལ༌ཡོད།"]},{"type":"verse","number":16,"content":["དུས་དེར་པཱ་རབ་པཱ་ཟེར་བའི་བཙོན་པ་མི་ངན་གྲགས་ཅན་ཞིག་ཡོད༌ཅིང༌།"]},{"type":"verse","number":17,"content":["མི་རྣམས་གནས་དེར་འཛོམས་པ༌ན། པི་ལ་ཏུ་ན༌རེ། པཱ་རབ་པཱ་དང་མཱ་ཤི་ཀ་ཟེར་བའི་ཡེ་ཤུ་གཉིས་ལས་ཁྱོད་རྣམས་ཀྱིས་སུ་ཞིག་བཙོན་གྲོལ་གཏོང་འདོད་དམ་ཞེས༌དྲིས།"]},{"type":"verse","number":18,"content":["རྒྱུ་མཚན་ནི་དེ་དག་གིས་སྐྱབས་མགོན་ཡེ་ཤུར་ཕྲག་དོག་བྱས་ཏེ་ཁོ་ལ་སྤྲད་པ་ནི་སྤྱི་དཔོན་ཀྱིས་ཤེས༌པའོ།།"]},{"type":"verse","number":19,"content":["ཁོ་ནི་ཁྲིམས་དཔོན་གྱི་ཁྲི་ཐོག་ཏུ་སྡོད༌དུས། ཁོའི་ཆུང་མས་མི་ཞིག་བཏང་སྟེ་ན༌རེ། ངས་མདང་ནུབ་ཀྱི་རྨི་ལམ་དུ་སྐྱེས་བུ་དམ་པ་དེའི་དོན་དུ་སྡུག་བསྔལ་མང་པོ་མྱངས༌པས། ཁྱོད་ཀྱིས་མི་དེའི་དོན་ལ་ཐེ་གཏོགས་མི་བྱའོ་ཞེས་ངག་འཕྲིན་བསྐུར༌ཏོ།།"]},{"type":"verse","number":20,"content":["འོན་ཀྱང་མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་ཀྱིས་མི་ཚོགས་ལ་ངན་སྐུལ་བྱས་ཏེ་པཱ་རབ་པཱ་བཙོན་གྲོལ་གཏོང་བ་དང་ཡེ་ཤུ་གསོད་པར༌བསྐུལ།"]},{"type":"verse","number":21,"content":["སྤྱི་དཔོན་གྱིས་མི་ཚོགས༌ལ། ཁྱོད་ཅག་གིས་འདི་གཉིས་ལས་སུ་ཞིག་བཙོན་གྲོལ་གཏོང་འདོད་དམ་ཞེས་དྲིས་པ༌ན། དེ་རྣམས་ན༌རེ། པཱ་རབ་པཱ་ཞེས་ཞུས༌སོ།།"]},{"type":"verse","number":22,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། དེས་ན་ངས་མཱ་ཤི་ཀ་ཟེར་བའི་ཡེ་ཤུ་ལ་ཅི་བྱའམ་ཞེས་དྲིས་པ༌ན། དེ་དག་ཐམས་ཅད་ཀྱིས་ཁོ་རང་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་རྡོབས་ཤིག་ཅེས༌སྨྲས།"]},{"type":"verse","number":23,"content":["ཡང་སྤྱི་དཔོན་ན༌རེ། རྒྱུ་མཚན་ཅིའི་ཕྱིར༌རམ། ཁོས་ནག་ཉེས་ཅི་བྱས་སམ་ཞེས་སྨྲས༌ནའང༌། དེ་དག་གིས་སྔར་ལས་སྐད་གསང་མཐོན་པོས་ཁོ་རང་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་རྡོབས་ཤིག་ཅེས་འུར་བརྒྱབ༌བོ།།"]},{"type":"verse","number":24,"content":["པི་ལ་ཏུས་རང་གིས་གཏམ་ཇི་ལྟར་སྨྲས་ནའང་ཕན་ཐོགས་མེད་པར་ད་དུང་ཟིང་ཆ་ལངས་བཞིན་པ་མཐོང༌སྟེ། མི་ཚོགས་ཀྱི་མདུན་ནས་ཆུ་བླངས་ཏེ་རང་གི་ལག་པ་བཀྲུས་ཤིང་ན༌རེ། སྐྱེས་བུ་འདིའི་ཁྲག་བཞུར་",{"noteId":25},"ནའང་བདག་ལ་སྡིག་པ་མེད༌དེ། ཁྱོད་རྣམས་ཀྱིས་འགན་འཁུར་དགོས་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":25,"content":["མི་ཐམས་ཅད༌ཀྱིས། ཁོའི་ཁྲག་བཞུར་བའི་དོན་དེ་ངེད་ཅག་དང་ངེད་ཅག་གི་བུ་རྒྱུད་རྣམས་ཀྱི་སྟེང་དུ་འབབ་པར་ཤོག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":26,"content":["དེ་ནས་པི་ལ་ཏུས་པཱ་རབ་པཱ་བཙོན་གྲོལ་བཏང་ནས་ཁོ་རྣམས་ལ་སྤྲད༌ཅིང༌། སྐྱབས་མགོན་ཡེ་ཤུར་རྟ་ལྕག་གིས་གཞུས་ཏེ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབ་ཕྱིར་དམག་མི་རྣམས་ལ་སྤྲད༌དོ།།"]},{"type":"heading","content":["དམག་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུར་འཕྱ་དམོད་བྱས༌པ།"]},{"type":"verse","number":27,"content":["སྤྱི་དཔོན་གྱི་དམག་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་སྤྱི་དཔོན་གྱི་ཕོ་བྲང་དུ་ཁྲིད་པ༌དང༌། དམག་དཔུང་ཐམས་ཅད་ཁོང་གི་དྲུང་དུ་བསྡུས༌ཏེ།"]},{"type":"verse","number":28,"content":["ཁོང་གི་ན་བཟའ་ཕུད་ཅིང་ལུས་ལ་ན་བཟའ་དམར་སྨུག་ཅིག༌བསྐོན།"]},{"type":"verse","number":29,"content":["ཚེར་མའི་ཅོད་པན་བསླེས་ཏེ་ཁོང་གི་དབུ་ལ༌བསྐོན། ཁོང་གི་ཕྱག་གཡས་པར་འདམ་རྩྭ་བསྣམས་སུ༌བཅུག ཁོང་གི་དྲུང་དུ་པུས་མོ་སར་བཙུགས་ཏེ་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཁྱོད་ལ་རྟེན་འབྲེལ་ཞུ་ཞེས་བརྙས་བཅོས༌བྱས།"]},{"type":"verse","number":30,"content":["ཡང་ཁོང་གི་གདོང་ལ་མཆིལ་མ་བཏབ༌ཅིང༌། ཁོང་གི་ཕྱག་ནས་འདམ་རྩྭ་བླངས་ཏེ་དབུ་ལ་བརྡེགས༌སོ།།"]},{"type":"verse","number":31,"content":["དམག་མི་དག་གིས་དེ་ལྟར་ཁོང་ལ་བརྙས་བཅོས་བྱས༌རྗེས། ན་བཟའ་དམར་སྨུག་ཕུད་ཅིང་ཁོང་ལ་རང་ཉིད་ཀྱི་ན་བཟའ་བསྐོན༌ཏེ། ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབ་ཆེད་ཕར་ཁྲིད༌དོ།།"]},{"type":"heading","content":["ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས༌པ།"]},{"type":"verse","number":32,"content":["ཁོ་རྣམས་ཕྱི་རོལ་ཏུ་སླེབས༌དུས། ཀི་རེ་ནེའི་མི་སྟེ་མིང་ལ་སི་མོན་ཟེར་བ་དང་ཕྲད་ནས། དེ་དག་གིས་ཁོ་ལ་བཙན་གྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཤིང་རྒྱ་གྲམ་འཁུར་དུ༌བཅུག"]},{"type":"verse","number":33,"content":["དེ་རྣམས་གོལ་གོ་ཐཱ་སྟེ་དོན་ལ་མགོ་སྐོགས་གནས་ཞེས་པའི་ས་ཆར་སླེབས་པ༌དང༌།"]},{"type":"verse","number":34,"content":["དམག་མི་རྣམས་ཀྱིས་ཁོང་ལ་མཁྲིས་ཁུ་འདྲེས་པའི་རྒུན་ཆང་དྲངས་པ༌ན། ཁོང་གིས་བྲོ་བ་མྱངས་ཙམ་ལས་མ༌བཞེས།"]},{"type":"verse","number":35,"content":["དེ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་ཤིང་ཁོང་གི་ན་བཟའ་རྒྱན་འཕངས་ཏེ་བགོ་བཤའ་བྱས༌རྗེས།"]},{"type":"verse","number":36,"content":["ཡང་ཁོང་ཉིད་བསྲུངས་ནས༌བསྡད།"]},{"type":"verse","number":37,"content":["ཁོང་གི་དབུ་ཡི་གོང་དུ་ཤིང་བྱང་ཞིག་བཀལ་ཞིང་ཁོང་ལ་བཏགས་པའི་ཉེས་སྐྱོན་ནི་འདི་ལྟར་བྲིས་ཡོད༌དེ། འདི་ནི་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཡེ་ཤུ་ཡིན་ཞེས་པ༌དེའོ།།"]},{"type":"verse","number":38,"content":["དུས༌དེར། ཁོང་དང་ལྷན་ཅིག་ཇག་པ་གཉིས་ཀྱང་ཁོང་གི་གཡས་གཡོན་དུ་ཤིང་རྒྱ་གྲམ་སྟེང་དུ་བརྡབས༌ཡོད།"]},{"type":"verse","number":39,"content":["གནས་དེར་བརྒྱུད་ནས་འགྲོ་བ་རྣམས་ཀྱིས་ཁོང་ལ་འཕྱ་སྨོད་བྱས་ཤིང་མགོ་བོ་གཡུག་བཞིན་ན༌རེ།"]},{"type":"verse","number":40,"content":["ཀྱེ། མཆོད་ཁང་བཤིག་ནས་ཉིན་གསུམ་གྱི་ནང་དུ་སླར་རྩིག་མཁན་ཁྱོད་ཀྱིས་རང་ཉིད་སྐྱོབས༌དང༌། ཁྱོད་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་ན་ཤིང་རྒྱ་གྲམ་སྟེང་ནས་མར་བོབས་ཤིག་ཅེས༌སྨྲས།"]},{"type":"verse","number":41,"content":["དེ་བཞིན་དུ་མཆོད་དཔོན་ཆེན་པོ་དག༌དང༌། མཁན་པོ་དང་རྒན་པོ་རྣམས་ཀྱིས་ཀྱང་ཁོང་ལ་འཕྱ་སྨོད་བྱེད་བཞིན་ན༌རེ།"]},{"type":"verse","number":42,"content":["ཁོས་གཞན་རྣམས་བསྐྱབས་མྱོང་ནའང་རང་ཉིད་སྐྱོབ་མི༌ནུས། ཁོ་ནི་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡིན༌པས། ད་ལྟ་ཤིང་རྒྱ་གྲམ་སྟེང་ནས་མར་བབས་ཆོག༌ལ། དེས་ན་ངེད་ཅག་གིས་ཀྱང་ཁོ་ལ་དད་པ་བྱེད༌སྲིད།"]},{"type":"verse","number":43,"content":["ཁོས་དཀོན་མཆོག་ལ་བློ་གཏོད་ཅིང་ང་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་ཟེར༌བས། དཀོན་མཆོག་ཁོ་ལ་དགའ༌ན། ད་ལྟ་ཁོ་རང་བསྐྱབ་ངེས་ཡིན་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":44,"content":["ཁོང་དང་མཉམ་དུ་བརྡབས་པའི་ཇག་པ་གཉིས་ཀྱིས་ཀྱང་དེ་ལྟར་ཁོང་ལ་འཕྱ་སྨོད་བྱས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་གྲོངས༌པ།"]},{"type":"verse","number":45,"content":["ཉིན་གུང་ནས་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་",{"noteId":26},"བར༌དུ། ཡུལ་ཡོངས་ལ་མུན་ནག་འཐིབས༌ཤིང༌།"]},{"type":"verse","number":46,"content":["ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་ཙམ་ལ་སྐྱབས་མགོན་ཡེ་ཤུས་གསུང་སྐད་ཆེན༌པོས། ཨེ༌ལེ། ཨེ༌ལེ། ལཱ་མཱ་སཱ་པཱག་ཐཱ་ནེ་ཞེས་གསུངས༌ཤིང༌། དོན་ནི་འདི་ལྟ༌སྟེ། ཀྱེ། བདག་གི་དཀོན་མཆོག༌ལགས། བདག་གི་དཀོན་མཆོག༌ལགས། ཁྱེད་ཀྱིས་ང་རང་རྒྱབ་ཏུ་བསྐྱུར་དོན་ཅི་ཞེས༌པའོ།།"]},{"type":"verse","number":47,"content":["གནས་དེར་ཡོད་པའི་མི་འགའ་ཞིག་གིས་གསུང་དེ་ཐོས༌རྗེས། མི་འདིས་ཨེ་ལི་ཡཱ་འབོད་ཀྱིན་འདུག་ཅེས་སྨྲས་མ༌ཐག"]},{"type":"verse","number":48,"content":["དེ་དག་གི་ཁྲོད་ནས་མི་ཞིག་བརྒྱུགས་སོང་ནས་འགྱིག་སོབ་ཅིག་རྒུན་ཆང་སྐྱུར་མོར་སྦངས༌ཏེ། འདམ་རྩྭའི་རྩེར་བཀལ་ནས་ཁོང་ལ་འདྲེན་པའི་དུས༌སུ།"]},{"type":"verse","number":49,"content":["གཞན་རྣམས་ན༌རེ། ཅུང་ཙམ་སྒུག༌དང༌། ཨེ་ལི་ཡཱ་ཁོ་རང་སྐྱོབ་ཏུ་ཡོང་མིན་ལ་བལྟ་བར་བྱའོ་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":50,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་སླར་ཡང་སྐད་གསང་མཐོན་པོས་འབོད་སྒྲ་ཞིག་བསྒྲགས་པ་དང་སྐུ་སྲོག་ཕུལ༌ཏོ།།"]},{"type":"verse","number":51,"content":["གློ་བུར་ཉིད་ལ་མཆོད་ཁང་གི་ཡོལ་བ་དེ་ཡང་གོང་ནས་འོག་ཏུ་དུམ་བུ་གཉིས་སུ་རལ་བ༌དང༌། ས་འགུལ་བྱུང་ནས་རྡོ་ཕ་བོང་དག་ཀྱང་གས༌ཤིང༌།"]},{"type":"verse","number":52,"content":["དུར་ཁུང་ཕྱེས་ཏེ་སྔར་གཤེགས་ཟིན་པའི་དད་ལྡན་དམ་པའི་བེམ་པོ་མང་པོའང་སླར་གསོན་པ༌ཡིན།"]},{"type":"verse","number":53,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་སླར་གསོན༌རྗེས། ཁོ་རྣམས་ཀྱང་དུར་ཁུང་ནས་ཕྱིར་ཡོང་སྟེ་དམ་པའི་གྲོང་ཁྱེར་དུ་ཕྱིན་པ་དང་མི་མང་པོར་མངོན་པར༌མཛད།"]},{"type":"verse","number":54,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྲུང་བའི་བརྒྱ་དཔོན་དང་བཅས་པས་ས་འགུལ་བྱུང་བ་ལ་སོགས་པའི་དོན་རྣམས་མཐོང་ནས་ཤིན་ཏུ་འཇིགས༌ཏེ། སྐྱེས་བུ་འདི་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་པ་བདེན་འདུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":55,"content":["ག་ལིལ་ཡུལ་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་རྗེས་འབྲངས་ཏེ་ཁོང་ལ་ཞབས་ཕྱི་བསྒྲུབས་མྱོང་བའི་བུད་མེད་མང་པོ་ཡང་གནས་དེར་ཡོད་ཅིང་རྒྱང་རིང་ནས་དོན་དེར༌བལྟས།"]},{"type":"verse","number":56,"content":["བུད་མེད་དེ་དག་གི་ཁྲོད་དུ་མཱག་རྡལ་གྱི་མིར་ཡམ༌དང༌། ཡ་ཀོབ་དང་ཡོ་སེབ་གཉིས་ཀྱི་མ་མིར༌ཡམ། གཞན་ཡང་ཟེ་བད་ཡའི་བུ་གཉིས་ཀྱི་མ་བཅས་ཀྱང་གནས་དེར་ཡོད༌དོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་དུར་ལ་སྦས༌པ།"]},{"type":"verse","number":57,"content":["མཚན་མོར་སླེབས༌ཤིང༌། ཨ་རི་མ་ཐཱ་ཡི་ཡོ་སེབ་ཟེར་བའི་ཕྱུག་བདག་དེ་གནས་དེར་སླེབས་ཤིང་ཁོ་རང་ཡང་སྐྱབས་མགོན་ཡེ་ཤུའི་རྗེས་འབྲང་པ་ཞིག་ཡིན༌པས།"]},{"type":"verse","number":58,"content":["པི་ལ་ཏུའི་གམ་དུ་སོང་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་གནང་བར་ཞུ་བ་ཞུས་པ༌ན། པི་ལ་ཏུས་ཁོ་ལ་གནང་བའི་བཀའ་བསྩལ༌པའོ།།"]},{"type":"verse","number":59,"content":["ཡོ་སེབ་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་བླངས་ཏེ་སོ་རས་གཙང་མས་དཀྲིས༌རྗེས།"]},{"type":"verse","number":60,"content":["སྔ་མོ་ནས་རང་ལ་དུར་ཁུང་གསར་པ་ཞིག་བརྐོས་ཡོད་པ་དེར་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་སྦས༌ཤིང༌། རྡོ་ཕ་བོང་ཞིག་བསྒྲིལ་འོངས་ནས་དུར་ཁུང་གི་སྒོ་བཅད་ནས་ཕྱིར་སོང༌ངོ༌།།"]},{"type":"verse","number":61,"content":["དུས༌དེར། མཱག་རྡལ་གྱི་མིར་ཡམ༌དང༌། གཞན་ཡང་མིང་ལ་མིར་ཡམ་ཟེར་བའི་བུད་མེད་དེ་གཉིས་ཀྱང་དུར་ཁུང་གི་ཁ་གཏད་དུ་བསྡད་ཡོད༌དོ།།"]},{"type":"heading","content":["དམག་མིས་དུར་ཁུང་སྲུང་བའི༌སྐོར།"]},{"type":"verse","number":62,"content":["དེའི་ཕྱི་ཉིན༌ཏེ། སྟ་གོན་ཉིན་ཞེས་པའི་ཕྱི་ཉིན༌ལ། མཆོད་དཔོན་ཆེན་པོ་དག་དང་ཕ་རུ་ཤི་པ་རྣམས་པི་ལ་ཏུའི་མདུན་དུ་འཛོམས་ཏེ་ན༌རེ།"]},{"type":"verse","number":63,"content":["སྐུ་ངོ༌ལགས། བསླུ་བྲིད་པ་དེས་གསོན་པའི་དུས་སུ་འདི་སྐད༌དུ། ཉིན་གསུམ་གྱི་རྗེས་སུ་ང་རང་སླར་གསོན་ངེས་ཡིན་ཞེས་སྨྲས་པ་ངེད་ཅག་གིས་དྲན༌པས།"]},{"type":"verse","number":64,"content":["ཁྱེད་ཀྱིས་ཉིན་གསུམ་པའི་བར་དུ་དུར་ཁུང་ལེགས་པོར་བསྲུང་བའི་བཀའ་གནང་བར༌མཛོད། དེ་ལྟར་མ་བསྲུངས༌ན། ཁོའི་རྗེས་འབྲང་པ་རྣམས་ཀྱིས་བེམ་པོ་བརྐུས་ཏེ་ཡུལ་མི་རྣམས་ལ་ཡེ་ཤུ་སླར་གསོན་ནོ་ཞེས་སྨྲ་བར་འགྱུར༌བས། ཕྱིས་སུ་འབྱུང་བའི་བསླུ་བྲིད་ནི་སྔ་མ་ལས་ཀྱང་ཚབས་ཆེན་དུ་འགྱུར་ཉེན་ཡོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":65,"content":["པི་ལ་ཏུ་ན༌རེ། ཁྱོད་ཅག་ལ་སྲུང་དམག་ཡོད༌པས། ཕར་སོང་ནས་དུར་ཁུང་ལེགས་པོར་སྲུངས་ཤིག་ཅེས་བཀའ་བསྒོས༌ཤིང༌།"]},{"type":"verse","number":66,"content":["དེ་དག་གིས་སྲུང་དམག་ཁྲིད་ནས་སོང༌སྟེ། ཕ་བོང་ལ་རྟགས་ཐམ་བརྒྱབ་ནས་དུར་ཁུང་ལེགས་པོར་སྲུང་དུ་བཅུག༌གོ།"]}],"footnotes":[{"noteId":25,"caller":"+","text":"འདི་ནི་བསད་པའི་དོན༌ཡིན།","reference":{"chapter":27,"verse":24}},{"noteId":26,"caller":"+","text":"འདིར་བཤད་པའི་ཉིན་གུང་ནས་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་བརྩི་སྲོལ༌ཏེ། མ་ཕྱི་ལས་ཆུ་ཚོད་དྲུག་དང་ཆུ་ཚོད་དགུ་ཞེས༌འབྱུང༌། ད་ལྟའི་བརྩི་སྲོལ་ལྟར་ན་ཉིན་གུང་གི་ཆུ་ཚོད་བཅུ་གཉིས་དང་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་བར་ཡིན་པས་དོན་སྒྱུར་བྱས་པ༌ཡིན།","reference":{"chapter":27,"verse":45}}]},"thisChapterLink":"/api/bod_ntb/MAT/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/26.json","previousChapterAudioLinks":{},"numberOfVerses":66}