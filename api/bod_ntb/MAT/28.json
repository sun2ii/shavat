{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":28,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་གྲོངས་ནས་སླར་གསོན༌པ།"]},{"type":"verse","number":1,"content":["ངལ་གསོ་བའི་ཉིན་རྫོགས༌རྗེས། གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོར་",{"noteId":27},"ནམ་ལངས་པའི་དུས༌སུ། མཱག་རྡལ་གྱི་མིར་ཡམ་དང་གཞན་ཡང་མིང་ལ་མིར་ཡམ་ཟེར་བའི་བུད་མེད་དེ་གཉིས་དུར་ཁུང་ལ་བལྟ་རུ་ཡོང༌ངོ༌།།"]},{"type":"verse","number":2,"content":["གློ་བུར་ཉིད་དུ་ས་འགུལ་ཆེན་པོ༌བྱུང༌། དེ་ནི་གཙོ་བོའི་ཕོ་ཉ་ཞིག་ནམ་མཁའི་ཞིང་ཁམས་ནས་ཕེབས༌ཏེ། ཕོ་ཉས་རྡོ་ཕ་བོང་ཕར་བསྒྲིལ་ཞིང་དེའི་སྟེང་དུ་བཞུགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":3,"content":["ཁོང་གི་གཟུགས་བརྙན་ནི་གློག་དམར་འཁྱུག་པ་དང་འདྲ༌ཞིང༌། ན་བཟའ་ནི་ཁ་བ་ལྟར་དཀར་བ༌ཡིན།"]},{"type":"verse","number":4,"content":["དུར་ཁུང་སྲུང་མཁན་གྱི་དམག་མི་རྣམས་ཁོང་ལ་ཤིན་ཏུ་འཇིགས་ཏེ་ལུས་ཡོངས་འདར་ཞིང་བེམ་པོ་ལྟར་གྱུར༌ཏོ།།"]},{"type":"verse","number":5,"content":["ཕོ་ཉས་བུད་མེད་དེ་གཉིས་ལ་འདི་སྐད༌དུ། འཇིགས་མི་དགོས༌ཏེ། ཁྱོད་གཉིས་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པའི་སྐྱབས་མགོན་ཡེ་ཤུ་འཚོལ་དུ་འོངས་པ་བདག་གིས་ཤེས་པ༌ཡིན།"]},{"type":"verse","number":6,"content":["ཁྱོད་གཉིས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་འཇོག་སར་ལྟོས༌དང༌། ད་ལྟ་ཁོང་གནས་འདིར་མི་བཞུགས་པར་དེ་སྔར་ཁོང་གིས་གསུངས་པ་བཞིན་སླར་གསོན་པ༌ཡིན།"]},{"type":"verse","number":7,"content":["ཁྱོད་གཉིས་མྱུར་དུ་སོང་ནས་ཁོང་གི་ཐུགས་སྲས་རྣམས༌ལ། སྐྱབས་མགོན་ཡེ་ཤུ་གྲོངས་པ་ནས་སླར་གསོན༌ནོ། །ཁོང་ནི་ཁྱོད་ཅག་གི་སྔོན་ལ་ག་ལིལ་ཡུལ་དུ་བྱོན་ཏེ་གནས་དེ་རུ་ཁྱོད་ཅག་ཁོང་དང་མཇལ་ངེས་ཡིན་ཞེས་སྨྲོས༌ཤིག ལྟོས༌དང༌། ངས་ཁྱོད་གཉིས་ལ་སྨྲས་ཟིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":8,"content":["བུད་མེད་དེ་གཉིས་མྱུར་དུ་དུར་ཁུང་དང་ཁ་བྲལ་ཞིང་འཇིགས་སྐྲག་དང་དགའ་མགུའི་ངང་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་སྲས་རྣམས་ལ་དོན་འདི་སྨྲ་བའི་ཕྱིར་བརྒྱུགས༌སོ།།"]},{"type":"verse","number":9,"content":["གློ་བུར་ཉིད་ལ་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོ་མོ་གཉིས་ཀར་ཕྲད་དེ་འདི་སྐད༌དུ། ཁྱོད་གཉིས་བདེ་བར་སྨོན་ཞེས་གསུངས་པ༌དང༌། ཁོ་མོ་གཉིས་ཚུར་ཡོང་ནས་ཁོང་གི་ཞབས་ལ་འཇུས་ཏེ་ཕྱག༌བཙལ།"]},{"type":"verse","number":10,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། འཇིགས་མི་དགོས༌ཏེ། ཁྱོད་གཉིས་ཀྱིས་བདག་གི་སྤུན་ཟླ་རྣམས་ལ་ག་ལིལ་ཡུལ་དུ་སོང༌དང༌། གནས་དེ་རུ་ཁྱོད་ཅག་གིས་ང་རང་མཐོང་བར་འགྱུར་ཞེས་སྨྲོས་ཤིག་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དམག་མིའི་རྫུན་གཏམ༌སྐོར།"]},{"type":"verse","number":11,"content":["བུད་མེད་དེ་གཉིས་ལམ་ལ་ཆས༌སྐབས། དུར་ཁུང་གི་སྲུང་དམག་རྣམས་ལས་འགའ་ཞིག་ཡེ་རུ་སཱ་ལེམ་དུ་སོང༌སྟེ། དོན་ཅི་བྱུང་བ་ཐམས་ཅད་མཆོད་དཔོན་ཆེན་པོ་དག་ལ་སྨྲས༌སོ།།"]},{"type":"verse","number":12,"content":["མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ་རྣམས་མཉམ་དུ་འཛོམས་ནས་གྲོས་བྱས་པ༌དང༌། དམག་མི་དེ་རྣམས་ལ་དངུལ་སྒོར་མང་པོ་བྱིན་ཏེ་ན༌རེ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཅག་གིས་མི་གཞན་རྣམས༌ལ། ངེད་ཅག་མཚན་མོར་གཉིད་ལ་ཡུར་བའི༌ཚེ། ཡེ་ཤུའི་རྗེས་འབྲང་པ་རྣམས་ཡོང་ནས་བེམ་པོ་བརྐུས་ཏེ་ཁྱེར་ཏོ་ཞེས་སྨྲོས༌ཤིག"]},{"type":"verse","number":14,"content":["གལ་ཏེ་སྤྱི་དཔོན་གྱིས་དོན་འདི་ཤེས་པར་གྱུར༌ན། ངེད་ཅག་གིས་ཁོང་ལ་ཞུ་བ་ཞུས་ནས་ཁྱོད་ཅག་ལ་ཉེས་སྐྱོན་མི་འབྱུང་བར་ཁག་ཐེག་བྱེད་ངེས་ཡིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":15,"content":["དམག་མི་དེ་དག་གིས་ཀྱང་ལྐོག་རྔན་བླངས་ཏེ་མཆོད་དཔོན་རྣམས་ཀྱིས་སྨྲས་པ་ལྟར་བྱས༌ཤིང༌། གཏམ་འདི་ནི་ད་ལྟའི་བར་དུ་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་ངག་རྒྱུན་དུ་གྲགས༌སོ།།"]},{"type":"heading","content":["འཕྲིན་བཟང་སྒྲོག་པའི་བཀའ་བསྩལ༌པ།"]},{"type":"verse","number":16,"content":["ཐུགས་སྲས་བཅུ་གཅིག་པོ་སྐྱབས་མགོན་ཡེ་ཤུའི་བཀའ་བཞིན་དུ་ག་ལིལ་ཡུལ་གྱི་རི་མགོར་ཆས་པ༌དང༌།"]},{"type":"verse","number":17,"content":["ཁོ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་མཐོང་བ་དང་ཕྱག་བཙལ་ཏོ། །འོན་ཀྱང་ཐུགས་སྲས་ལ་ལ་ད་དུང་དོན་འདིར་ཐེ་ཚོམ་སྐྱེས༌སོ།།"]},{"type":"verse","number":18,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཚུར་ཕེབས་ཏེ་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། གནམ་ས་གཉིས་ཀྱི་དབང་ཐམས་ཅད་བདག་ལ་གནང་ཡོད༌པས།"]},{"type":"verse","number":19,"content":["ཁྱོད་རྣམས་སོང་ནས་མི་རིགས་ཐམས་ཅད་བདག་གི་རྗེས་སུ་འབྲང་དུ་འཇུག་པར༌གྱིས། ཡབ༌དང༌། སྲས༌དང༌། དམ་པའི་ཐུགས་ཉིད་བཅས་ཀྱི་མཚན་ལ་བརྟེན་ནས་ཁོ་རྣམས་ལ་ཁྲུས་གསོལ་བྱོས༌ཤིག"]},{"type":"verse","number":20,"content":["ངས་ཁྱོད་ཅག་ལ་གནང་བའི་བཀའ་ཐམས་ཅད་ཁོ་རྣམས་ལ་ཁྲིད་སྟོན་བྱོས་ལ་བསྲུང་དུ༌བཅུག ལྟོས༌དང༌། ང་ནི་རྟག་ཏུ་བསྐལ་པའི་མཐའ་མའི་བར་དུའང་ཁྱོད་ཅག་དང་མཉམ་དུ་གནས་ཞེས་གསུངས༌སོ།། །།"]}],"footnotes":[{"noteId":27,"caller":"+","text":"གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོ་ཞེས་པ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་གོམས་སྲོལ་ཡིན༌ལ། གཟའ་འཁོར་གཅིག་ལ་ཉིན་བདུན་ཡོད་པ་ལས་ཉིན་དང་པོ་ནི་དེང་སང་ལྟར་ན་གཟའ་ཉི་མའི་ཉིན༌ཡིན།","reference":{"chapter":28,"verse":1}}]},"thisChapterLink":"/api/bod_ntb/MAT/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/27.json","previousChapterAudioLinks":{},"numberOfVerses":20}