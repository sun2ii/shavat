{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":5,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་རི་བོར་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མི་མང་པོ་གཟིགས༌ཤིང༌། རི་བོར་ཕེབས་ནས་བཞུགས༌རྗེས། ཐུགས་སྲས་རྣམས་ཀྱང་ཁོང་གི་དྲུང་དུ་ཡོང་བ༌དང༌།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་དེ་རྣམས་ལ་འདི་སྐད་དུ་ཆོས་གསུངས་པ༌སྟེ།"]},{"type":"verse","number":3,"content":["ཉམ་ཆུང་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་ནམ་མཁའི་རྒྱལ་སྲིད་ཁོ་རྣམས་ཀྱི་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":4,"content":["མྱ་ངན་ཅན་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ལ་སེམས་གསོ་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":5,"content":["གཤིས་འཇམ་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ལ་ས་གཞི་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":6,"content":["དྲང་བདེན་གྱི་ཕྱིར་དུ་ལྟོགས་ཤིང་སྐོམ་པ་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ཡིད་ཚིམ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":7,"content":["བྱམས་སྙིང་རྗེ་ཅན་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ལ་སྙིང་རྗེ་འཐོབ་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":8,"content":["སེམས་རྣམ་པར་དག་པ་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་དཀོན་མཆོག་ལ་མཇལ་བར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":9,"content":["མི་གཞན་སྡུམ་མཁན་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་མི་དེ་རྣམས་ལ་དཀོན་མཆོག་གི་བུ་ཞེས་འབོད་པར་འགྱུར་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":10,"content":["དྲང་བདེན་གྱི་ཆེད་དུ་གནོད་འཚེ་ཕོག་པ་རྣམས༌བདེའོ། །རྒྱུ་མཚན་ནི་ནམ་མཁའི་རྒྱལ་སྲིད་མི་དེ་དག་གི་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":11,"content":["མི་རྣམས་ཀྱིས་བདག་གི་ཕྱིར་ཁྱོད་ཅག་ལ་དམའ་འབེབས་དང་གནོད་པ་བྱེད་ཅིང་གཏམ་ངན་སྣ་ཚོགས་སྨྲ་བའི༌ཚེ། ཁྱོད་རྣམས༌བདེའོ།།"]},{"type":"verse","number":12,"content":["ཁྱོད་རྣམས་དགའ་ཞིང་ཡི་རངས་པར་གྱུར༌ཅིག རྒྱུ་མཚན་ནི་ནམ་མཁའི་ཞིང་ཁམས་ནས་ཁྱོད་རྣམས་ལ་བྱ་དགའ་ཆེན་པོ་ཡོད་པའི་ཕྱིར༌རོ། །ཡང་དེ་དག་གིས་ཁྱོད་ཅག་གི་སྔོན་རོལ་གྱི་ལུང་སྟོན་པ་རྣམས་ལའང་དེ་ལྟར་གནོད་འཚེ་བྱས་མྱོང་ཞེས༌པའོ།།"]},{"type":"heading","content":["ལན་ཚྭ་དང་འོད་ཟེར་གཉིས་ཀྱི༌དཔེ།"]},{"type":"verse","number":13,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་ནི་འཇིག་རྟེན་གྱི་ལན་ཚྭ་ཡིན་མོད༌ཀྱང༌། གལ་ཏེ་ལན་ཚྭའི་བྲོ་བ་ཡལ་ན་དེའི་བྲོ་བ་གང་གིས་བསྐྱེད༌དམ། དེ་ཕྱི་རོལ་ཏུ་འཕངས་ནས་མིའི་རྐང་པས་བརྫི་བ་མ་གཏོགས་ཕན་པ་ཅི་ཡང༌མེད།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཅག་ནི་འཇིག་རྟེན་གྱི་འོད་ཟེར་ཡིན༌ལ། རི་མགོར་ཆགས་པའི་གྲོང་ཁྱེར་ནི་མཐོང་མི་ནུས་པ་གང་ཡང༌མེད།"]},{"type":"verse","number":15,"content":["ཡང་མིས་སྒྲོན་མེ་བསྒྲོན་པ་ནི་བྲེའི་འོག་ཏུ་འཇོག་ཕྱིར་མ་ཡིན༌པར། སྒྲོན་སྟེགས་སྟེང་བཞག་ནས་ཁྱིམ་དུ་ཡོད་པའི་མི་ཐམས་ཅད་ལ་འོད་ཟེར་སྤྲོ་བའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":16,"content":["དེ་བཞིན་དུ་མི་གཞན་རྣམས་ཀྱིས་ཁྱོད་ཅག་གི་ལས་བཟང་པོ་མཐོང༌ཞིང༌། ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ལ་བསྟོད་བསྔགས་བྱ༌ཆེད། ཁྱོད་ཅག་གིས་ཀྱང་རང་གི་འོད་ཟེར་དེ་མི་རྣམས་ཀྱི་མིག་ལམ་དུ་འཕྲོ་བར་བྱོས་ཤིག་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["བཀའ་ཁྲིམས་དང་སྐྱབས་མགོན་ཡེ་ཤུ་གཉིས་ཀྱི་འབྲེལ༌བ།"]},{"type":"verse","number":17,"content":["དེ་ནས་ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་ནི་བཀའ་ཁྲིམས་དང་ཡང་ན་ལུང་སྟོན་པའི་མདོ་རྣམས་མེད་པར་བཟོ་ཕྱིར་ཡོང་བར་མ་འདོད༌ཅིག བདག་ནི་མེད་པར་བཟོ་ཕྱིར་ཡོང་བ་མ་ཡིན་པར་དེ་རྣམས་བསྒྲུབ་ཕྱིར་ཡོང་བ༌ཡིན།"]},{"type":"verse","number":18,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། གནམ་ས་གཉིས་འཇིག་པའི་བར༌དུ། བཀའ་ཁྲིམས་ཀྱི་མདོ་ལས་ཡིག་འབྲུ་གཅིག་གམ་ཚེག་ཐིག་གཅིག་ཀྱང་འཇིག་པར་མི་འགྱུར༌ཞིང༌། དོན་དེ་ཐམས་ཅད་འགྲུབ་པར༌ངེས།"]},{"type":"verse","number":19,"content":["དེ་བས་སུ་ཞིག་གིས་བཀའ་ཁྲིམས་འདི་དག་ལས་ཆུང་ཤོས་གཅིག་འདོར༌ཞིང༌། ཡང་གཞན་རྣམས་ལ་དེ་བཞིན་ལོག་ཁྲིད་བྱེད༌ན། མི་དེ་ནི་ནམ་མཁའི་རྒྱལ་སྲིད་དུ་ཆེས་ཆུང་ཤོས་ཡིན༌ཟེར། འོན༌ཀྱང༌། སུ་ཞིག་གིས་བཀའ་ཁྲིམས་དེ་དག་སྲུང༌ཞིང༌། གཞན་ལའང་དེ་བཞིན་ཁྲིད་སྟོན་བྱེད༌ན། མི་དེ་ནི་ནམ་མཁའི་རྒྱལ་སྲིད་ནང་དུ་ཆེན་པོ་ཡིན་ཟེར་བར༌འགྱུར།"]},{"type":"verse","number":20,"content":["ཡང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་ཅག་གི་དྲང་བདེན་ནི་མཁན་པོ་དང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱི་དྲང་བདེན་ལས་ཀྱང་ལྷག་པ་མ་ཡིན༌ན། ཁྱོད་རྣམས་ཅིས་ཀྱང་ནམ་མཁའི་རྒྱལ་སྲིད་དུ་ཞུགས་མི་ཐུབ་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ཞེ་སྡང་འགོག་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":21,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་མི་མ་གསོད་ཅེས༌དང༌། ཡང་སུ་ཞིག་གིས་མི་བསད༌ན། མི་དེར་ཁྲིམས་ཐག་གཅོད་འོས་ཞེས་གནའ་མི་རྣམས་ལ་ཆོས་གསུངས་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་ཐོས་མྱོང༌ངོ༌།།"]},{"type":"verse","number":22,"content":["འོན༌ཀྱང༌། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། སུ་ཞིག་དོན་མེད་དུ་རང་གི་སྤུན་ཟླར་ཞེ་སྡང་ལངས༌ན། མི་ཞེ་སྡང་ཅན་དེ་ལ་ཉེས་ཆད་གཅོད༌འོས། ཡང་སུ་ཞིག་གིས་རང་གི་སྤུན་ཟླ༌ལ། ཁྱོད་ནི་སྨྱོན་པ་རེད་ཅེས་ཟེར༌ན། མི་དེའང་ཚོགས་མི་རྣམས་ཀྱི་མདུན་དུ་ཁྲིད་ནས་ཉེས་ཆད་གཅོད༌འོས། ཡང་སུ་ཞིག་གིས་རང་གི་སྤུན་ཟླ༌ལ། ཁྱོད་ནི་གླེན་པ་རེད་ཅེས་ཟེར༌ན། མི་དེ་ནི་དམྱལ་བའི་མེའི་ནང་དུ་ལྷུང་འོས་པ༌ཡིན།"]},{"type":"verse","number":23,"content":["དེ་བས་ཁྱོད་ཀྱིས་མཆོད་ཁྲིའི་སྟེང་དུ་མཆོད་པ་འབུལ་བའི༌ཚེ། སྤུན་ཟླ་ཞིག་དང་ཁྱོད་ཀྱི་བར་དུ་མི་མཐུན་པ་ཞིག་ཡོད་པ་དྲན༌ན།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་རང་གི་མཆོད་རྫས་དེ་མཆོད་ཁྲིའི་མདུན་དུ་བཞག༌སྟེ། ཐོག་མར་རང་གི་སྤུན་ཟླ་དང་འགྲིག་མཐུན་ཡོང་བར༌བྱོས། དེ་ནས་ཕྱིར་ལོག་སྟེ་མཆོད་པ་ཕུལ༌ཞིག"]},{"type":"verse","number":25,"content":["ཁྱོད་དང་ཁྱོད་རང་གཏུག་མཁན་གཉིས་མཉམ་དུ་ཁྲིམས་རར་འགྲོ་བའི་དུས༌སུ། ལམ་བར་ནས་མྱུར་དུ་འགྲིག་མཐུན་ཡོང་བར༌གྱིས། དེ་ལྟར་མ་བྱས་ན་ཁྱོད་ཀྱི་གྱོད་ཡ་དེས་ཁྱོད་རང་ཁྲིམས་དཔོན་གྱི་དྲུང་དུ་འཁྲིད༌ཅིང༌། ཁྲིམས་དཔོན་གྱིས་ཁྱོད་རང་དམག་མིར་སྤྲད༌དེ། དམག་མིས་ཁྱོད་རང་བཙོན་དུ་འཇུག་པར༌འགྱུར།"]},{"type":"verse","number":26,"content":["བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། ཁྱོད་ཀྱིས་དོང་ཙེ་ཐམས་ཅད་སྐྱིན་ཚབ་ཏུ་སྤྲད་ཚར་བའི་བར་དུ་ཁྱོད་རང་བཙོན་ཁང་ལས་གཏན་ནས་ཐར་མི་ནུས་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ལོག་གཡེམ་འགོག་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":27,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ལོག་གཡེམ་མ་བྱེད་ཅེས་ཆོས་གསུངས་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་ཐོས་མྱོང་བ་ཡིན༌མོད།"]},{"type":"verse","number":28,"content":["འོན༌ཀྱང༌། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། སུ་ཞིག་གིས་འདོད་ཆགས་དང་བཅས་བུད་མེད་ཅིག་ལ་བལྟས༌ན། མི་དེས་སེམས་སུ་ལོག་གཡེམ་བྱས་ཟིན་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":29,"content":["གལ་ཏེ་ཁྱོད་ཀྱི་མིག་གཡས་པས་ཁྱོད་ལ་སྡིག་པ་བྱེད་དུ་འཇུག༌ན། མིག་དེ་བཏོན་ནས་དོར༌ཅིག རྒྱུ་མཚན་ནི་ཁྱོད་ཀྱི་ལུས་ཡོངས་དམྱལ་བའི་གནས་སུ་ལྷུང་བ༌ལས། ཁྱོད་ལ་ཡན་ལག་གཅིག་མེད་པར་གྱུར་ཀྱང་ལེགས།"]},{"type":"verse","number":30,"content":["ཡང་ཁྱོད་ཀྱི་གཡས་ལག་གིས་ཁྱོད་ལ་སྡིག་པ་བྱེད་དུ་འཇུག༌ན། ལག་པ་དེ་བཅད་ནས་དོར༌ཅིག ཁྱོད་ཀྱི་ལུས་ཧྲིལ་པོ་དམྱལ་བའི་གནས་སུ་ལྷུང་བ༌ལས། ཡན་ལག་གཅིག་མེད་པར་གྱུར་ཀྱང་ལེགས།"]},{"type":"verse","number":31,"content":["ཡང་སྐྱེས་པ་སུ་ཞིག་གིས་རང་གི་ཆུང་མ་སྤངས༌ན། ཁོ་མོར་བཟའ་འཐོར་ཡི་གེ་སྟེར་དགོས་ཞེས་ཆོས་གསུངས་ཡོད༌མོད།"]},{"type":"verse","number":32,"content":["འོན༌ཀྱང༌། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ལོག་གཡེམ་བྱས་པའི་རྒྱུ་རྐྱེན་ལས༌གཞན། ཁྱོ་བོ་སུ་ཞིག་རང་གི་ཆུང་མ་དང་འཐོར༌ན། ཁྱོ་བོས་བུད་མེད་དེ་ལ་ལོག་གཡེམ་བྱེད་དུ་བཅུག་པ༌ཡིན། ཡང་སུ་ཞིག་གིས་བཟའ་འཐོར་བྱས་པའི་བུད་མེད་དེ་རང་གི་ཆུང་མར་བླངས༌ན། དེ་ཡང་ལོག་གཡེམ་བྱས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["མནའ་འགོག་དགོས་པའི་སྐོར་ལ་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":33,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། རྫུན་གྱི་མནའ་མ་སྐྱེལ༌ཅིག གཙོ་བོ་ལ་དམ་བཅའ་ཕུལ་བ་རྣམས་སྒྲུབས་ཤིག་ཅེས་གནའ་མི་རྣམས་ལ་ཆོས་གསུངས་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་ཐོས་མྱོང་བ་ཡིན༌ནོ།།"]},{"type":"verse","number":34,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་ཀྱིས་མནའ་ཅི་ཡང་མ་སྐྱེལ༌ཅིག ནམ་མཁའི་ཞིང་ཁམས་ནི་དཀོན་མཆོག་གི་བཞུགས་ཁྲི་ཡིན༌པས། ནམ་མཁའི་ཞིང་ཁམས་དཔང་དུ་བཙུགས་ནས་མནའ་མ་སྐྱེལ༌ཅིག"]},{"type":"verse","number":35,"content":["ཡང་ས་གཞི་ནི་ཁོང་གི་ཞབས་སྟེགས་ཡིན་པས་ས་གཞི་དཔང་དུ་བཙུགས་ནས་མནའ་མ་སྐྱེལ༌ཅིག ཡང་ཡེ་རུ་སཱ་ལེམ་ནི་རྒྱལ་པོ་ཆེན་པོ་སྟེ་དཀོན་མཆོག་གི་གྲོང་ཁྱེར་ཡིན༌པས། ཡེ་རུ་སཱ་ལེམ་དཔང་དུ་བཙུགས་ནས་མནའ་མ་སྐྱེལ༌ཅིག"]},{"type":"verse","number":36,"content":["ཡང་ཁྱོད་ཀྱིས་རང་གི་སྐྲའི་ཉག་མ་གཅིག་ཀྱང་དཀར་པོའམ་ནག་པོར་བསྒྱུར་མི་ནུས༌པས། རང་གི་མགོ་བོ་དཔང་དུ་བཙུགས་ནས་མནའ་མ་སྐྱེལ༌ཅིག"]},{"type":"verse","number":37,"content":["འོན་ཀྱང་ཁྱོད་ཅག་གི་གཏམ་ནི་ཡིན་ན་ཡིན་ཞེས༌དང༌། མིན་ན་མིན་ཞེས་སྨྲོས༌ཤིག དེ་ལས་ལྷག་པ་གང་ཞིག་སྨྲས་ནའང་དེ་ནི་ངན་པ་ལས་བྱུང་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["ངན་ལན་འགོག་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":38,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མིག་ལ་མིག་ལན་དང་སོ་ལ་སོ་ལན་འཇལ་དགོས་ཞེས་ཆོས་གསུངས་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་ཐོས་མྱོང་བ་ཡིན༌ནོ།།"]},{"type":"verse","number":39,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་ཀྱིས་རང་ལ་ངན་བྱེད་མཁན་ལའང་རྒོལ་བར་མི༌བྱའོ། །སུ་ཞིག་གིས་ཁྱོད་ཀྱི་འགྲམ་པ་གཡས་པར་འགྲམ་ལྕག་གཞུས༌ན། ཁྱོད་ཀྱིས་འགྲམ་པ་གཡོན་པ་ལའང་གཞུ་རུ༌ཆུག"]},{"type":"verse","number":40,"content":["ཡང་སུ་ཞིག་གིས་ཁྱོད་རང་ཁྲིམས་ཁང་ལ་གཏུགས་ཤིང་ཁྱོད་ཀྱི་ནང་གོས་འཕྲོག་འདོད་པ་དེ་ལ་ཁྱོད་ཀྱིས་རང་གི་ཕྱི་གོས་ཀྱང་འཁྱེར་དུ༌ཆུག"]},{"type":"verse","number":41,"content":["ཡང་སུ་ཞིག་གིས་ཁྱོད་རང་དཔག་ཚད་གཅིག་ལ་འགྲོ་བར་བཙན་སྐུལ་བྱེད༌ན། ཁྱོད་རང་མི་དེ་དང་མཉམ་དུ་དཔག་ཚད་གཉིས་ལ་སོང༌ཞིག"]},{"type":"verse","number":42,"content":["ཡང་སུ་ཞིག་གིས་ཁྱོད་ལ་ཅི་ཞིག་སློང་བར་བྱེད་ན་དེ་ལ་བྱིན༌དང༌། ཁྱོད་ལས་རྒྱུ་ནོར་བསྐྱི་བར་འདོད་མཁན་དེའི་ངོ་མ་ཟློག་ཅིག་ཅེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དགྲ་ལ་བྱམས་དགོས་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":43,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་རང་གི་ཁྱིམ་མཚེས་ལ་བྱམས་པ་དང་དགྲ་ལ་སྡང་དགོས་ཞེས་ཆོས་གསུངས་ཡོད་པ་ཐོས་མྱོང་བ༌ཡིན།"]},{"type":"verse","number":44,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་ཅག་ནི་ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཡབ་ཀྱི་བུ་བུ་མོ་ཡིན་པའི༌ཕྱིར། ཁྱོད་ཅག་གིས་རང་གི་དགྲ་བོ་རྣམས་ལའང་བྱམས་ཤིང་བརྩེ་བར་གྱིས༌དང༌། རང་ལ་གནོད་པ་བྱེད་མཁན་རྣམས་ཀྱི་དོན་དུ་སྨོན་ལམ་ཐོབས༌ཤིག ཅིའི་ཕྱིར་ཞེ༌ན། དཀོན་མཆོག་གིས་མི་སེམས་བཟང་སེམས་ངན་གཉིས་ལ་རང་ཉིད་ཀྱི་ཉི་མ་འཆར་དུ་འཇུག༌ཅིང༌། མི་གཞུང་དྲང་ཡིན་མིན་ཐམས་ཅད་ལ་ཆར་བ་འབབ་པར་མཛད༌དོ།།"]},{"type":"verse","number":46,"content":["གལ་ཏེ་ཁྱོད་ཅག་གིས་རང་ལ་བྱམས་མཁན་རྣམས་ལ་བྱམས་པར་བྱེད༌ན། ཁྱོད་ཅག་ལ་བྱ་དགའ་ཅི་ལ༌ཐོབ། ཁྲལ་ལེན་མཁན་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱེད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":47,"content":["ཡང་ཁྱོད་ཅག་གིས་རང་གི་སྤུན་ཟླ་ཁོ་ནར་འཚམས་འདྲི་ཞུ༌ན། ཁྱོད་ཅག་ལ་མི་གཞན་ལས་ཁྱད་དུ་འཕགས་པ་ཅི་ཡོད༌དམ། ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱེད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":48,"content":["དེའི༌ཕྱིར། ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ནི་ཕུལ་དུ་བྱུང་བ་ཡིན་པ༌ལྟར། ཁྱོད་རྣམས་ཀྱང་ཕུལ་དུ་བྱུང་བར་གྱུར་ཅིག་ཅེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/4.json","previousChapterAudioLinks":{},"numberOfVerses":47}