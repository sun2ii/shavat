{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":6,"content":[{"type":"heading","content":["སྦྱིན་པ་གཏོང་དགོས་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":1,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་མཉམ་པར་ཞོག༌དང༌། མི་གཞན་རྣམས་ལ་མཐོང་དུ་འཇུག་པའི༌ཕྱིར། དེ་རྣམས་ཀྱི་མིག་མདུན་ནས་དྲང་བདེན་གྱི་ལས་བསྒྲུབ་པར་མི༌བྱའོ། །དེ་ལྟར་བྱས༌ན། ཁྱོད་ཅག་ལ་ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཡབ་ནས་བྱ་དགའ་ཅི་ཡང་མི༌འཐོབ།"]},{"type":"verse","number":2,"content":["དེའི༌ཕྱིར། ཁྱོད་ཀྱིས་སྦྱིན་པ་གཏོང་བའི་དུས༌སུ། རང་གི་མདུན་ནས་དུང་འབུད་དུ་མ༌འཇུག དེ་ནི་ཚུལ་འཆོས་པ་རྣམས་ཀྱིས་མི་གཞན་དག་གི་བསྔགས་བརྗོད་འཐོབ་པའི༌ཕྱིར། ཆོས་ཁང་དང་སྲང་ལམ་དུ་དེ་ལྟར་བྱེད་པ༌ཡིན། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། མི་དེ་དག་ལ་སྔར་ནས་རང་གི་བྱ་དགའ་ཐོབ༌ཟིན།"]},{"type":"verse","number":3,"content":["འོན་ཀྱང་ཁྱོད་ཀྱི་སྦྱིན་པ་གསང་བར་གནས་པའི༌ཕྱིར། སྦྱིན་པ་གཏོང༌ཚེ། ཁྱོད་ཀྱི་གཡས་ལག་གིས་གང་ཞིག་བྱས་པ་དེ་གཡོན་ལག་ལའང་ཤེས་སུ་མ་འཇུག༌གོ །དེ་ནས་གསང་བའི་ངང་ནས་སྒྲུབ་མཁན་ལ་གཟིགས་པའི་ཡབ་ཀྱིས་ཁྱོད་ལ་བྱ་དགའ་གནང་ངེས་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["གསོལ་འདེབས་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":5,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་གསོལ་བ་འདེབས༌སྐབས། ཚུལ་འཆོས་པ་རྣམས་དང་འདྲ་བར་མ་བྱེད༌ཅིག མི་གཞན་རྣམས་ལ་མཐོང་དུ་འཇུག་པའི༌ཕྱིར། དེ་རྣམས་བསམ་བཞིན་ཆོས་ཁང་དང་ཁྲོམ་སྲང་གི་བཞི་མདོ་རུ་འགྲེང་ནས་བསྡད་དེ་གསོལ་བ་འདེབས་པར༌དགའ། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། དེ་རྣམས་ལ་སྔར་ནས་རང་གི་བྱ་དགའ་ཐོབ་ཟིན་པ༌ཡིན།"]},{"type":"verse","number":6,"content":["འོན་ཀྱང་ཁྱོད་ཀྱིས་གསོལ་བ་འདེབས་པའི་དུས༌སུ། ཁྱོད་ནི་རང་གི་ཁང་པ་སྦུག་མར་སོང་ནས་སྒོ་བརྒྱབ༌སྟེ། མིག་གི་མཐོང་ལམ་དུ་མ་གྱུར་པའི་ཁྱོད་ཀྱི་ཡབ་ལ་གསོལ་བ་ཐོབས༌ཤིག དེ་ནས་གསང་བའི་ངང་ནས་སྒྲུབ་མཁན་ལ་གཟིགས་པའི་ཁྱོད་ཀྱི་ཡབ་ཀྱིས་ཁྱོད་ལ་བྱ་དགའ་གནང་ངེས༌ཡིན།"]},{"type":"verse","number":7,"content":["ཡང་ཁྱོད་ཅག་གིས་གསོལ་བ་འདེབས་པའི་དུས༌སུ། ཕྱི་ཕྱོགས་པ་རྣམས་དང་འདྲ་བར་དོན་སྙིང་མེད་པའི་བསྐྱར་བཟློས་མ་བྱེད༌ཅིག དེ་དག་གི་སེམས་སུ་སྨྲ་བ་མང༌ན། དཀོན་མཆོག་གིས་རང་གི་གསོལ་འདེབས་ལ་གསན་ངེས་ཡིན་བསམ༌མོ།།"]},{"type":"verse","number":8,"content":["དེ་བས་ཁོ་རྣམས་དང་འདྲ་བར་མ་བྱེད༌ཅིག རྒྱུ་མཚན་ནི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་ཁྱོད་ཅག་གིས་མ་ཞུས་སྔོན་དུ་ཁྱོད་ཀྱི་དགོས་མཁོ་མཁྱེན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":9,"content":["དེའི༌ཕྱིར། ཁྱོད་ཅག་གིས་གསོལ་བ་འདེབས་པའི་དུས་སུ་འདི་ལྟར་ཞུ་བར་བྱ༌སྟེ།",{"text":"ནམ་མཁར་བཞུགས་པའི་ངེད་ཀྱི༌ཡབ།།","poem":1},{"lineBreak":true},{"text":"ཁྱེད་མཚན་དམ་པར་བསྲུང་བར༌ཤོག །","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ཁྱེད་ཀྱི་རྒྱལ་སྲིད་འོང་བར༌ཤོག །","poem":1},{"lineBreak":true},{"text":"ཁྱེད་ཀྱི་དགོངས་པ་ནམ་མཁའ༌རུ།།","poem":1},{"lineBreak":true},{"text":"གྲུབ་བཞིན་ས་ལའང་འགྲུབ་པར༌ཤོག །","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ངེད་ཀྱི་ཉིན་རེའི་ཟས་ཀྱི༌སྐལ།།","poem":1},{"lineBreak":true},{"text":"དེ་རིང་ཡང་ནི་གནང་བར༌མཛོད།།","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ངེད་ཀྱིས་གཞན་ཉེས་བསལ་བ༌ལྟར།།","poem":1},{"lineBreak":true},{"text":"ངེད་ཀྱི་སྡིག་པ་བསལ་བར༌མཛོད།།","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ངན་པའི་ལས་ནས་ཐར་བ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ཉམས་ཚོད་མི་ལེན་སྐྱོབ་པར༌མཛོད།།","poem":1},{"lineBreak":true},{"text":"རྒྱལ་སྲིད་དབང་དང་གཟི་བརྗིད༌ནི།།","poem":1},{"lineBreak":true},{"text":"རྒྱུན་ནས་རྒྱུན་དུ་ཁྱེད་ཀྱི༌ཡིན།།","poem":1},"ཨ༌མེན། ཞེས༌པའོ།།"]},{"type":"verse","number":14,"content":["ཁྱོད་ཅག་གིས་མི་གཞན་གྱི་ཉེས་སྐྱོན་བསལ༌ན། ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་ཀྱི་ཉེས་པ་བསལ་ངེས༌ཡིན།"]},{"type":"verse","number":15,"content":["ཡང་ཁྱོད་ཅག་གིས་མི་གཞན་གྱི་ཉེས་སྐྱོན་མ་བསལ༌ན། ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་ཀྱང་ཁྱོད་ཅག་གི་ཉེས་པ་བསལ་བར་མི་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྨྱུང་གནས་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":16,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་སྨྱུང་གནས་སྲུང་བའི་དུས༌སུ། ཚུལ་འཆོས་པ་རྣམས་དང་འདྲ་བར་སྐྱོ་བའི་ངོ་མདངས་མ་སྟོན༌ཅིག ཅིའི་ཕྱིར་ཞེ༌ན། དེ་རྣམས་ཀྱིས་སྨྱུང་གནས་སྲུང་བ་ནི་མི་གཞན་རྣམས་ཀྱིས་མཐོང་བའི་ཕྱིར༌དུ། རང་གི་ངོ་མདངས་སྡུག་པར༌སྟོན། བདག་གིས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། དེ་དག་ལ་རང་གི་བྱ་དགའ་ཐོབ་ཟིན་པ༌ཡིན།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་སྨྱུང་གནས་སྲུང་བ་ནི་མི་གཞན་རྣམས་ཀྱིས་མི་ཤེས་པའི་ཕྱིར༌དུ། སྨྱུང་གནས་སྲུང་བའི་དུས༌སུ། མགོ་ལ་སྣུམ་བསྐུ་ཞིང་ཁ་ངོ་གཙང་མར་ཁྲུས༌ཤིག འོན་ཀྱང་མིག་གི་མཐོང་ལམ་དུ་མ་གྱུར་པའི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་ཁྱོད་རང་གཟིགས་པ༌དང༌། དེ་ནས་གསང་བའི་ངང་ནས་སྒྲུབ་མཁན་ལ་གཟིགས་པའི་ཁྱོད་ཀྱི་ཡབ་ཀྱིས་ཁྱོད་ལ་བྱ་དགའ་གནང་ངེས་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["བདེན་པའི་རྒྱུ་ནོར་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":19,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་རང་གི་དོན་དུ་ས་སྟེང་དུ་རྒྱུ་ནོར་གསོག་པར་མི༌བྱའོ། །ས་སྟེང་གི་རྒྱུ་ནོར་ནི་འབུ་སྲིན་གྱིས་བཟའ་ཞིང་བཙའ་ཡིས་བརླག་པ༌དང༌། རྐུན་མས་ཀྱང་ཁུང་བུ་བྲུས་ཏེ་བརྐུ་བར༌བྱེད།"]},{"type":"verse","number":20,"content":["འོན་ཀྱང་ཁྱོད་རྣམས་ཀྱིས་རང་གི་དོན་དུ་ནམ་མཁའི་ཞིང་ཁམས་སུ་ནོར་བུ་གསོགས༌ཤིག གནས་དེ་རུ་འབུ་སྲིན་དང་བཙའ་ཡིས་མི་བཟའ་ཞིང་རྐུན་མས་ཀྱང་ཁུང་བུ་བྲུས་ཏེ་བརྐུ་མི༌ནུས།"]},{"type":"verse","number":21,"content":["རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཀྱི་ནོར་བུ་གང་དུ་ཡོད་ན་ཁྱོད་རྣམས་ཀྱི་སེམས་ཀྱང་དེ་རུ་ཡོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱི་མིག་ཟུང་ནི་ལུས་ཀྱི་སྒྲོན་མེ་ཡིན༌ཏེ། མིག་ཟུང་གསལ་པོ་ཡིན་ན་ལུས་པོ་ཡོངས་རྫོགས་འོད་དང་ལྡན་པར༌འགྱུར།"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་ཁྱོད་ཀྱི་མིག་ཟུང་རབ་རིབ་ཏུ་གྱུར༌ན། ལུས་པོ་ཡོངས་རྫོགས་མུན་ནག་ཏུ༌འགྱུར། དེའི༌ཕྱིར། ཁྱོད་ཀྱི་སེམས་ནང་དུ་གནས་པའི་འོད་དེ་མུན་ནག་ཏུ་གྱུར་ན་མུན་ནག་དེ་ནི་ཅི་འདྲ་ཚབས་ཆེ༌ཨང༌།"]},{"type":"verse","number":24,"content":["སུ་ཞིག་གིས་ཀྱང་བདག་པོ་གཉིས་ལ་ཞབས་ཕྱི་བསྒྲུབ་མི་ནུས༌ཏེ། ཁོས་གཅིག་ལ་སྡང་ཞིང་གཅིག་ལ་གཅེས༌པའམ། ཡང་ན་གཅིག་ལ་བཀུར་ཞིང་གཅིག་ལ་སྨད་པར་བྱེད༌དོ། །དེའི༌ཕྱིར། ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་དང་འཇིག་རྟེན་གྱི་རྒྱུ་ནོར་གཉིས་ལ་ཞབས་ཕྱི་བསྒྲུབ་མི་ནུས་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སེམས་ཁྲལ་མེད་པར་དཀོན་མཆོག་ལ་ཡིད་ཆེས་པར་གདམས༌པ།"]},{"type":"verse","number":25,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། དེ་བས་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། ཁྱོད་རྣམས་ཀྱིས་རང་གི་ཚེ་སྲོག་གི་དོན་དུ་བཟའ་བཏུང་གང་ཞིག་སྤྱོད་པ༌དང༌། ལུས་པོའི་ཆེད་དུ་གོས་གང་ཞིག་གྱོན་པར་སེམས་ཁྲལ་མ་བྱེད༌ཅིག ཁ་ཟས་ལས་ཚེ་སྲོག་ནི་ཁྱད་དུ་འཕགས་ཤིང་གྱོན་ཆས་ལས་ཀྱང་མིའི་ལུས་པོ་ནི་ཁྱད་དུ་འཕགས་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":26,"content":["ནམ་མཁའི་བྱ་རྣམས་ལ་ལྟོས༌དང༌། དེ་དག་གིས་ས་བོན་མི་འདེབས་ཤིང་སྟོན་ལས་མི་བྱེད༌ལ། འབྲུ་རིགས་བང་མཛོད་དུ་མི་བསྡུ༌ཡང༌། ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་དེ་རྣམས་གསོ་བ༌ཡིན། ཁྱོད་རྣམས་ནི་ནམ་མཁའི་བྱ་ལས་རིན་ཐང་ཆེ་བ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":27,"content":["ཁྱོད་རྣམས་ལས་སུ་ཞིག་གིས་སེམས་ཁྲལ་བྱས་ནས་རང་གི་ཚེ་ཐག་ཡུད་ཙམ་ཞིག་ཇེ་རིང་དུ་གཏོང་ནུས༌སམ།"]},{"type":"verse","number":28,"content":["ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་གྱོན་པའི་ཆེད་དུ་སེམས་ཁྲལ་བྱེད༌དམ། སྤང་ཐང་གི་མེ་ཏོག་ཀུ་མུད་ཇི་ལྟར་སྐྱེ་བར་ལྟོས༌དང༌། དེ་དག་གིས་ལས་ཀ་མི་བྱེད་ལ་བལ་ཡང་མི་འཁེལ༌མོད།"]},{"type":"verse","number":29,"content":["འོན་ཀྱང་བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲ་བར་བྱ༌སྟེ། སོ་ལོ་མོན་གྱི་བརྗིད་ཉམས་ཤིན་ཏུ་ཆེ་བའི་དུས༌སུ། ཁོང་གི་རྒྱན་གོས་མེ་ཏོག་འདི་ལའང་མི༌དོའོ།།"]},{"type":"verse","number":30,"content":["འོན་ཀྱང་དེ་རིང་ཡོད་ཡོད་འདྲ་ཡང་སང་ཉིན་ཐབ་ལ་སྲེག་པར་འགྱུར་བའི་སྤང་ཐང་གི་རྩྭ་ཡང་དཀོན་མཆོག་གིས་ལེགས་པར་བསྐྱངས༌ན། དད་པ་ཆུང་བ་ཁྱོད་རྣམས་དེ་ལས་ཀྱང་ལྷག་ཏུ་སྐྱོང་བར་མི་མཛད༌དམ།"]},{"type":"verse","number":31,"content":["དེ་བས་ཁྱོད་ཅག་གིས་བཟའ་བཏུང་གང་ཞིག་སྤྱོད་པ་དང་ལུས་ལ་གོས་གང་ཞིག་གྱོན་པར་སེམས་ཁྲལ་མ་བྱེད༌ཅིག"]},{"type":"verse","number":32,"content":["འདི་ཐམས་ཅད་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་འཚོལ་བ་ཡིན༌ལ། ཁྱོད་རྣམས་ལ་དངོས་པོ་དེ་ཐམས་ཅད་མཁོ་བའང་ནམ་མཁའི་ཞིང་ཁམས་སུ་བཞུགས་པའི་ཁྱོད་ཅག་གི་ཡབ་ཀྱིས་མཁྱེན༌ནོ།།"]},{"type":"verse","number":33,"content":["འོན༌ཀྱང༌། ཁྱོད་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་དང་ཁོང་གི་རྣམ་དག་དེ་ཉིད་འཚོལ་ཞིང་སྙེགས་པར་གྱིས༌དང༌། དེ་རྣམས་ཀྱང་ཁྱོད་ཅག་ལ་གནང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":34,"content":["དེའི༌ཕྱིར། སང་ཉིན་གྱི་དོན་དུ་སེམས་ཁྲལ་མ་བྱེད༌ཅིག རྒྱུ་མཚན་ནི་སང་ཉིན་གྱི་དུས་སུ་སང་ཉིན་གྱི་སེམས་ཁྲལ་ཡོད༌ཅིང༌། ཉིན་རེ་རེའི་སྡུག་བསྔལ་ནི་ཉིན་རེ་རེར་འཁུར་ན་འོས་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MAT/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/5.json","previousChapterAudioLinks":{},"numberOfVerses":32}