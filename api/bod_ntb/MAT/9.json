{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MAT","translationId":"bod_ntb","name":"མད༌ཐཱ།","commonName":"མད༌ཐཱ།","title":"༄༅།།མད་ཐཱའི་འཕྲིན༌བཟང༌།","order":40,"numberOfChapters":28,"sha256":"b0a940048cdfd09ff124bc99bc01c84a218fd77930d6ff42e357a2d8dd4260e1","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bod_ntb/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":9,"content":[{"type":"heading","content":["མི་ཞ་བོ་ཞིག་གསོས༌པ།"]},{"type":"verse","number":1,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་མཚོ་གྲུར་བཞུགས་ནས་མཚོ་ལས་བརྒལ་ཏེ་རང་ཉིད་བཞུགས་སའི་གྲོང་ཁྱེར་དུ་ཕེབས་པ༌ན།"]},{"type":"verse","number":2,"content":["མི་རྣམས་ཀྱིས་ཞ་བོ་ཞིག་ཁྱོགས་ཤིང་སྟེང་བཞག་ནས་ཁོང་གི་དྲུང་དུ་ཁུར་ཡོང་བ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་དེ་རྣམས་ཀྱི་དད་སེམས་གཟིགས་ཏེ་ཞ་བོ་དེ་ལ་འདི་སྐད༌དུ། སྙིང་གི༌བུ། སེམས་བདེ་བར་གྱུར༌ཅིག ཁྱོད་ཀྱི་སྡིག་པ་བསལ་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":3,"content":["མཁན་པོ་འགའ་ཞིག་ཡོད་པའི་སེམས༌སུ། མི་འདིས་དཀོན་མཆོག་གི་དབུ་འཕང་སྨད་ཀྱིན་འདུག་བསམས་པ༌རེད།"]},{"type":"verse","number":4,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་དེ་དག་གི་བསམ་ཚུལ་མཁྱེན་ཏེ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱིས་ཅིའི་ཕྱིར་སེམས་ངན་བཅངས་པ་ཡིན༌ནམ།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱི་སྡིག་པ་བསལ་བ་ཡིན་ཞེས་ཟེར་བ༌དང༌། ཡར་ལོངས་ལ་སྐྱོད་ཅིག་ཅེས་ཟེར་བ་གཉིས་ལས་གང་ཞིག༌སླའམ།"]},{"type":"verse","number":6,"content":["འོན༌ཀྱང༌། འདི་ནི་ས་སྟེང་དུ་མིའི་བུ་ལ་སྡིག་པ་བསལ་བའི་དབང་ཡོད་པ་ཁྱོད་རྣམས་ཀྱིས་ཤེས་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས༌རྗེས། ཁོང་གིས་ཞ་བོ་དེ་ལ་འདི་སྐད༌དུ། ཁྱོད་རང་ཡར་ལོངས༌ལ་ཁྱོགས་ཤིང་ཁུར་ནས་རང་ཡུལ་དུ་སོང་ཞིག་ཅེས་བཀའ་གནང་བ༌དང༌།"]},{"type":"verse","number":7,"content":["མི་དེ་ཡར་ལངས་ནས་རང་ཡུལ་དུ་ཕྱིན་པ༌རེད།"]},{"type":"verse","number":8,"content":["དོན་དེ་མི་ཚོགས་ཀྱིས་མཐོང་ནས་ངོ་མཚར་སྐྱེས་ཏེ་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས༌ཕུལ། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་མི་ལ་དབང་དེ་ལྟ་བུ་གནང་བའི་ཕྱིར༌རོ།།"]},{"type":"heading","content":["མད་ཐཱ་ཚུར་བོས༌པ།"]},{"type":"verse","number":9,"content":["དེ་ཡང་སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེ་ནས་ཕར་ཕེབས་པ༌ལ། མད་ཐཱ་ཞེས་པ་ནི་ཁྲལ་སྡུད་སར་བསྡད་ཡོད་པ་གཟིགས་ཏེ་འདི་སྐད༌དུ། ཁྱོད་རང་ངའི་རྗེས་སུ་ཤོག་ཅེས་གསུངས་པ༌ན། ཁོ་རང་ཡར་ལངས་ཏེ་ཁོང་གི་རྗེས་སུ་འབྲངས༌སོ།།"]},{"type":"verse","number":10,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁང་པའི་ནང་དུ་ཞལ་ཟས་བཞེས་ནས་སྡོད་པའི་དུས༌སུ། ཁྲལ་ལེན་མཁན་དང་མི་སྡིག་ཅན་མང་པོ་ཡོང༌སྟེ། སྐྱབས་མགོན་ཡེ་ཤུ་དང་ཁོང་གི་ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་བཟའ་བཏུང་སྤྱད་ནས་བསྡད༌དོ།།"]},{"type":"verse","number":11,"content":["དོན་དེ་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་མཐོང་སྟེ་ཁོང་གི་ཐུགས་སྲས་རྣམས་ལ་འདི་ལྟར་སྨྲས༌པ། ཁྱོད་ཅག་གི་སྟོན་པས་ཅིའི་ཕྱིར་ཁྲལ་ལེན་མཁན་དང་མི་སྡིག་ཅན་རྣམས་དང་མཉམ་དུ་བཟའ་བཏུང་ལ་རོལ་བ་ཡིན་ནམ་ཞེས་པ༌ན།"]},{"type":"verse","number":12,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་གཏམ་དེ་ཐོས་ནས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ལུས་ཁམས་བདེ་བའི་མིས་སྨན་པ་བསྟེན་མི་དགོས༌མོད། འོན་ཀྱང་ནད་པས་ད་གཟོད་སྨན་པ་བསྟེན་དགོས་པ༌ཡིན།"]},{"type":"verse","number":13,"content":["ཁྱོད་རྣམས་ཕར་སོང༌ལ། བདག་ནི་མཆོད་པར་མི་དགའ་ཞིང་སྙིང་རྗེའི་སེམས་ལ་དགའ་ཞེས་གསུངས་པའི་དོན་ཅི་ཡིན་པ་སློབས༌ཤིག བདག་ནི་མི་གཞུང་དྲང་རྣམས་འབོད་དུ་འོངས་པ་མ་ཡིན༌པར། མི་སྡིག་ཅན་རྣམས་འབོད་དུ་ཡོང་བ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྨྱུང་གནས་ཀྱི༌སྐོར།"]},{"type":"verse","number":14,"content":["དེའི་དུས༌སུ། ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་གྱི་སློབ་མ་འགའ་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཡོང༌སྟེ། ངེད་ཅག་དང་ཕ་རུ་ཤི་པ་རྣམས་ཀྱིས་རྒྱུན་དུ་སྨྱུང་གནས་སྲུང་བཞིན་ཡོད༌ནའང༌། ཁྱེད་ཀྱི་ཐུགས་སྲས་རྣམས་ཀྱིས་སྨྱུང་གནས་མི་སྲུང་བ་ཅི་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":15,"content":["ཁོང་གིས་དེ་རྣམས་ལ་འདི་སྐད༌དུ། སྐུ་མགྲོན་རྣམས་མག་པ་དང་མཉམ་དུ་ཡོད་དུས་ཡིད༌སྐྱོའམ། འོན་ཀྱང་མག་པ་དེ་ཁོ་ཚོ་དང་ཁ་འབྲལ་བའི་དུས་ཤིག་སླེབ་ཡོང༌སྟེ། དུས་དེར་ཁོ་ཚོས་སྨྱུང་གནས་བསྲུང་ངེས༌ཡིན།"]},{"type":"verse","number":16,"content":["མི་སུ་ཡིན་ཡང་རས་གསར་པས་ལྭ་རྙིང་པར་ལྷན་པ་མི་རྒྱག༌སྟེ། རས་གསར་པས་ལྷན་པ་བརྒྱབ་ན་ལྭ་རྙིང་པ་དེ་ལས་རལ་ཞིང་སྲུབས་ཀ་ཇེ་ཆེར༌འགྲོའོ།།"]},{"type":"verse","number":17,"content":["ཡང་མི་སུ་ཡིན་ཡང་རྒུན་ཆང་གསར་པ་སྐྱི་ཁུག་རྙིང་པའི་ནང་དུ་མི་ལྡུག༌སྟེ། གལ་ཏེ་བླུག་ན་སྐྱི་ཁུག་རྙིང་པ་རལ་ཏེ་རྒུན་ཆང་བཞུར་འགྲོ་ཞིང་སྐྱི་ཁུག་ཀྱང་བརླག་པར་འགྱུར༌བས། རྒུན་ཆང་གསར་པ་དེ་སྐྱི་ཁུག་གསར་པའི་ནང་དུ་བླུག་ན་ད་གཟོད་དེ་གཉིས་ཀ་བརླག་པར་མི་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["མོ་ནད་བསལ་བ་དང་ཤི་ཟིན་པའི་བུ་མོ་སླར་གསོན༌པ།"]},{"type":"verse","number":18,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་དེ་སྐད་གསུང་བའི་དུས༌སུ། ཆོས་ཁང་གི་དབུ་འཛིན་པ་ཞིག་ཡོང་ནས་ཁོང་ལ་ཕྱག་བཙལ་ཏེ། ངའི་བུ་མོ་ཅང་མ་འགོར་བའི་སྔོན་ལ་ཤི༌བས། ཁྱེད་རང་ཕེབས་ནས་ཁོ་མོའི་ལུས་ལ་ཕྱག་བཞག༌ན། བུ་མོ་སླར་གསོན་པར་ངེས་ཞེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":19,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཡར་བཞེངས་ཏེ་ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་ཁོའི་རྗེས་སུ་འབྲངས་ནས་ཕེབས༌སོ།།"]},{"type":"verse","number":20,"content":["དེའི༌ཚེ། ཁྲག་འཛིར་བའི་མོ་ནད་བྱུང་སྟེ་ལོ་བཅུ་གཉིས་འགོར་བའི་བུད་མེད་ཅིག་ཁོང་གི་སྐུ་རྒྱབ་ཏུ་ཡོང༌སྟེ། ཁོང་གི་ན་བཟའི་འདབས་ཁར༌རེག"]},{"type":"verse","number":21,"content":["རྒྱུ་མཚན་ནི་ཁོ་མོའི་སེམས༌སུ། ངས་ཁོང་གི་ན་བཟའ་ལ་རེག༌ན། ང་རང་ནད་ལས་ཐར་ངེས་ཡིན་བསམས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":22,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕྱིར་འཁོར་ནས་བུད་མེད་དེར་གཟིགས་ཤིང་འདི་སྐད༌དུ། བུ༌མོ། སེམས་བདེ་བར༌གྱིས། ཁྱོད་ཀྱི་དད་པས་ཁྱོད་རང་བསྐྱབས་པ་ཡིན་ཞེས་གསུངས་མ་ཐག་ཏུ་བུད་མེད་དེ་ནད་ལས་ཐར༌རོ།།"]},{"type":"verse","number":23,"content":["ཁོང་རྣམས་ཆོས་ཁང་གི་དབུ་འཛིན་པའི་ཁྱིམ་དུ་སླེབས་པ༌དང༌། གླིང་བུ་འབུད་མཁན་དང་མི་ཚོགས་ཀྱིས་འུར་རྒྱག་བཞིན་པ་གཟིགས་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":24,"content":["ཕར་སོང༌ཞིག བུ་མོ་འདི་ཤི་བ་མིན་པར་གཉིད་འདུག་ཅེས་གསུངས་པ༌ལ། མི་དེ་རྣམས་ཀྱིས་ཁོང་ལ་འཕྱ་དགོད༌བྱས།"]},{"type":"verse","number":25,"content":["འོན་ཀྱང་ཁོང་གིས་མི་ཚོགས་ཕྱི་རུ་བསྐྲད༌རྗེས། དབུ་འཛིན་པའི་ཁྱིམ་ནང་དུ་ཕེབས་ཤིང་བུ་མོ་དེའི་ལག་པར་འཇུས་པ་དང་བུ་མོ་ཡར་ལངས༌སོ།།"]},{"type":"verse","number":26,"content":["ཁོང་གིས་མཛད་པའི་དོན་ནི་ཡུལ་དེའི་ཕྱོགས་ཀུན་ཏུ་ཁྱབ༌བོ།།"]},{"type":"heading","content":["ལོང་བ་དང་ལྐུགས་པ་གསོས༌པ།"]},{"type":"verse","number":27,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་གནས་དེ་ནས་ཡུལ་གཞན་དུ་ཕེབས་པའི་དུས༌སུ། ལོང་བ་གཉིས་ཁོང་གི་རྗེས་སུ་འབྲངས་ཏེ་སྐད་ཆེན༌པོས། ཀྱེ། དཱ་བིད་ཀྱི་རིགས༌སྲས། ངེད་གཉིས་ལ་སྙིང་རྗེས་གཟིགས་རོགས་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":28,"content":["ཁོང་ཉིད་ཁང་པའི་ནང་དུ་ཕེབས་པ༌ན། ལོང་བ་དེ་གཉིས་ཀྱང་ཁོང་གི་དྲུང་དུ་ཡོང་བ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་གཉིས་ལ་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་གཉིས་ཀྱི་མིག་ཟུང་གསོ་ནུས་པར་ཁྱོད་གཉིས་ཡིད་ཆེས་སམ་ཞེས་གསུངས་པ༌ན། དེ་གཉིས་ན༌རེ། གཙོ་བོ༌ལགས། ཁྱེད་ལ་ཡིད་ཆེས་པ་ཡིན་ཞེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":29,"content":["ཁོང་གིས་མི་དེ་གཉིས་ཀྱི་མིག་ཟུང་ལ་ཕྱག་གིས་རེག༌སྟེ། ཁྱོད་གཉིས་ཀྱི་དད་པ་བཞིན་དུ་གྲུབ་གྱུར་ཅིག་ཅེས་གསུངས་མ་ཐག༌ཏུ།"]},{"type":"verse","number":30,"content":["དེ་གཉིས་ཀྱི་མིག་ཟུང་གིས་མཐོང་ཐུབ་པར༌གྱུར། སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་གཉིས་ལ་འདི་སྐད༌དུ། ཁྱོད་གཉིས་ཀྱིས་གཟབ་པར༌གྱིས། དོན་འདི་མི་གཞན་སུ་ལའང་ཤེས་སུ་འཇུག་མི་རུང་ཞེས་ནན་གྱིས་བསྐུལ་ཞིང་བཀའ་གནང༌ཡང༌།"]},{"type":"verse","number":31,"content":["ཁོ་གཉིས་ཕྱི་རོལ་ཏུ་སོང་ནས་ཁོང་གི་གནས་ཚུལ་ཡུལ་དེའི་ཕྱོགས་ཀུན་ཏུ་བསྒྲགས༌སོ།།"]},{"type":"verse","number":32,"content":["མི་དེ་གཉིས་ཕྱི་རོལ་ཏུ་འགྲོ་བའི་དུས༌སུ། མི་འགའ་ཞིག་གིས་གདོན་འདྲེས་བཟུང་བའི་ལྐུགས་པ་ཞིག་ཁོང་གི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌དང༌།"]},{"type":"verse","number":33,"content":["ཁོང་གིས་གདོན་འདྲེ་དེ་ཕྱིར་བསྐྲད་པ་དང་ལྐུགས་པས་སྐད་ཆ་སྨྲ་ནུས་པར་གྱུར༌པས། གནས་དེར་ཚོགས་པའི་མི་རྣམས་ངོ་མཚར་སྐྱེས༌ཏེ། ཡེས་ར་ཨེལ་གྱི་ཡུལ་ནས་དོན་འདི་འདྲ་ཞིག་གཏན་ནས་མཐོང་མ་མྱོང་ཞེས༌སྨྲས།"]},{"type":"verse","number":34,"content":["འོན་ཀྱང་ཕ་རུ་ཤི་པ་རྣམས་ན༌རེ། ཁོས་བདུད་ཀྱི་རྒྱལ་པོར་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད་བཞིན་འདུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"heading","content":["སྟོན་ཐོག་སྡུད་མཁན་ཉུང༌བ།"]},{"type":"verse","number":35,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་གྲོང་ཁྱེར་དང་ཡུལ་སྡེ་ཀུན་ཏུ་ཕེབས༌ཤིང༌། ཆོས་ཁང་དག་ནས་ཆོས་གསུངས་ཤིང་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ཀྱི་འཕྲིན་བཟང་བསྒྲགས་པ༌དང༌། ནད་རིགས་དང་ལུས་ཟུངས་ཞན་པ་སྣ་ཚོགས་ཀྱང་གསོས༌སོ།།"]},{"type":"verse","number":36,"content":["ཡང་ཁོང་གིས་མི་རྣམས་ཀྱི་ཡིད་གདུང་ཞིང་ཉམ་ཐག་པའི་ཚུལ་ནི་རྫི་བོ་མེད་པའི་ལུག་དང་འདྲ་བར་གཟིགས་ཏེ་ཐུགས་ལ་སྙིང་རྗེ་འཁྲུངས༌ནས།"]},{"type":"verse","number":37,"content":["ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། སྟོན་ཐོག་ཤིན་ཏུ་མང་ཡང་སྡུད་མཁན་ཉུང༌བས།"]},{"type":"verse","number":38,"content":["སྟོན་ཐོག་གི་བདག་པོ་ལ་ཁོང་ཉིད་ཀྱི་སྟོན་ཐོག་བསྡུ་བའི་ཕྱིར་དུ་སྡུད་མཁན་རྣམས་མངག་པར་ཞུས་ཤིག་ཅེས་གསུངས༌སོ།།",{"noteId":5}]}],"footnotes":[{"noteId":5,"caller":"+","text":"ཚིག་རྐང་སོ་བདུན་དང་སོ་བརྒྱད་པ་གཉིས་ནི་འདི་ལྟ༌སྟེ། དཀོན་མཆོག་ལ་དད་པ་བྱེད་འདོད་པའི་མི་མང་ཡང་ཁོང་གི་ཆོས་སྒྲོག་མཁན་དང་སྤེལ་མཁན་མང་པོ་མེད༌པས། མི་རྣམས་ལ་ཆོས་སྤེལ་མཁན་མངག་ཕྱིར་ཁོང་ལ་གསོལ་བ་ཐོབས་ཤིག་ཅེས་པའི་དོན༌ཡིན།","reference":{"chapter":9,"verse":38}}]},"thisChapterLink":"/api/bod_ntb/MAT/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MAT/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MAT/8.json","previousChapterAudioLinks":{},"numberOfVerses":38}