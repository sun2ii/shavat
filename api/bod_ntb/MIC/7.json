{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MIC","translationId":"bod_ntb","name":"མི་ཀཱ","commonName":"མི་ཀཱ","title":"༄༅། །ལུང་སྟོན་པ་མི་ཀཱའི་མདོ།","order":33,"numberOfChapters":7,"sha256":"5e8f01356ed91062c55c9f5925dc71caa24a511989facf2f9d0cbbc2d994a576","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bod_ntb/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་ངན་རུལ་དུ་གྱུར་པ།"]},{"type":"verse","number":1,"content":["ཀྱི་ཧུད། ང་ལ་ཆག་སྒོ་འབྱུང་། བདག་ནི་དབྱར་གྱི་དུས་སུ་བཏོགས་པའི་ཤིང་ཏོག་དང་མཚུངས་ལ། འབྲས་བུ་བསྡུས་ནས་ལུས་པའི་རྒུན་འབྲུམ་བཞིན་ཡིན་ཞིང་། བཟའ་རྒྱུ་ཅི་ཡང་མེད་པ་དང་། རང་གི་སེམས་ནས་རེ་སྨོན་བྱེད་ཅིང་སྨིན་སྔ་བའི་སེ་ཡབ་ཤིང་ཏོག་ཀྱང་མེད་དོ། །"]},{"type":"verse","number":2,"content":["ས་གཞིའི་སྟེང་གི་ལྷག་བསམ་ཅན་རྣམས་རྩ་མེད་དུ་བཏང་བ་དང་། མི་ཡི་ཁྲོད་དུ་གཞུང་དྲང་གཅིག་ཀྱང་མེད། མི་ལ་ཁྲག་བཞུར་དུ་འཇུག་པའི་ཕྱིར་དེ་ཐམས་ཅད་ཀྱིས་འཇབ་སྒུག་བྱེད་ཅིང་། རེ་རེས་རྙི་བཙུགས་ནས་རང་གི་སྤུན་རྣམས་འཛིན་པ་ཡིན།"]},{"type":"verse","number":3,"content":["དེ་དག་གི་ལག་ཟུང་ནི་ངན་པ་བྱེད་པར་མཁས་ལ། རྒྱལ་པོ་དང་ཁྲིམས་དཔོན་རྣམས་ཀྱིས་ལྐོག་རྔན་ལེན་པ་དང་། ཐོབ་གོ་ས་ཅན་གྱིས་རང་སེམས་ཀྱི་འདོད་པའི་གཏམ་སྨྲས་ནས་ཕན་ཚུན་ངན་འབྲེལ་བྱེད་དོ། །"]},{"type":"verse","number":4,"content":["དེ་དག་ཁྲོད་ཀྱི་མཆོག་ནི་གཟེ་མ་ར་མགོ་དང་མཚུངས་ལ། ཆེས་གཞུང་དྲང་ཡིན་པ་ཡང་ཚེར་མའི་ར་སྐྱོར་ཙམ་ལས་མ་འདས། སོ་པ་ཡིས་གསུངས་པའི་ཉེས་ཆད་གཅོད་པའི་ཉིན་མོ་སླེབས་འོང་སྟེ། དེ་དག་གི་ནང་དུ་ཟིང་ཆ་ལངས་ནས་བདེ་བ་མེད་དོ། །"]},{"type":"verse","number":5,"content":["ཁྱིམ་མཚེས་ལ་ཡིད་རྟོན་མ་བྱེད་ཅིག གྲོགས་མཆོག་ལ་ཡང་ཡིད་ཆེས་མ་བྱེད་ཅིག ཐ་ན་རང་གི་པང་དུ་ཉལ་བའི་ཆུང་མ་ལ་ཡང་ཁྱོད་ཀྱི་ངག་དམ་པོར་བསྡམ་དགོས།"]},{"type":"verse","number":6,"content":["ཅི་ལ་ཞེ་ན། བུ་ཡིས་ཕ་ལ་མཐོང་ཆུང་བྱེད་པ་དང་། བུ་མོས་མ་ལ་བཀག་འགོག་བྱེད་ཅིང་། མནའ་མས་སྒྱུག་མོར་འགོག་རྒོལ་བྱེད་པར་འགྱུར་ཏེ། མི་ཡི་དགྲ་བོ་ནི་རང་གི་ཁྱིམ་མི་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["འོན་ཀྱང་བདག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་རེ་ལྟོས་བཅངས་ནས། བདག་ལ་སྐྱབས་མཛད་པའི་དཀོན་མཆོག་ལ་རེ་སྒུག་བྱེད་དེ། ངའི་དཀོན་མཆོག་གིས་ང་ལ་གསན་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["ཀྱེ་ངའི་དགྲ་བོ། ང་ལ་ངོམ་ཟིལ་མ་སྟོན་ཅིག ང་ནི་ས་རུ་འགྱེལ་ན་ཡང་ཡར་ལང་བ་དང་། མུན་པར་བསྡད་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ང་ཡི་འོད་དུ་འགྱུར་རོ། །"]},{"type":"verse","number":9,"content":["ཁོང་གིས་ངའི་ཆེད་དུ་དག་འབུད་དང་དཀར་འདོན་མཛད་པའི་བར་དུ། ངས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་དང་དུ་ལེན་པར་བྱའོ། །ཅི་ལ་ཞེ་ན། ངས་ཁོང་ལ་འགལ་བའི་སྡིག་པ་བྱས་པ་ཡིན། ཁོང་གིས་ང་ནི་འོད་ཟེར་ནང་དུ་འཁྲིད་པ་དང་། ངས་ཀྱང་ཁོང་གི་དྲང་བདེན་མཇལ་ངེས་ཡིན།"]},{"type":"verse","number":10,"content":["དེའི་དུས་སུ་ངའི་དགྲ་ཟླས་དོན་འདི་མཐོང་ནས་ངོ་ཚ་བར་འགྱུར་ལ། སྔོན་ཆད་དེས་ང་ལ་ན་རེ། ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེ་གང་དུ་བཞུགས་སམ་ཞེས་སྨྲས། ངས་ཁོ་ལ་ལས་འབྲས་ཕོག་པ་དངོས་སུ་མཐོང་ངེས་ཡིན་ལ། ད་ལྟ་ཁོ་རང་ནི་སྲང་ལམ་གྱི་འདམ་བག་བཞིན་རྡོག་རོལ་གཏོང་ངེས་ཡིན།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱི་མཁར་སླར་ཡང་རྩིག་པའི་དུས་དེ་སླེབས་པ་དང་། ཉིན་མོ་དེར་ཁྱོད་ཀྱི་ས་མཚམས་རྒྱང་ཐག་རིང་པོའི་བར་དུ་རྒྱས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["ཉིན་མོ་དེར་དེ་དག་ནི་ཨ་སུར་དང་ཨེ་ཅིབ་ཀྱི་གྲོང་ཁྱེར་རྣམས་དང་། ཨེ་ཅིབ་ནས་གཙང་པོ་ཆེན་པོ་དང་། རྒྱ་མཚོ་འདི་ནས་རྒྱ་མཚོ་གཞན་དང་། རི་བོ་འདི་ནས་རི་བོ་དེའི་བར་དུ་ཐམས་ཅད་ཁྱོད་ཀྱི་རྩར་སླེབས་འོང་།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་ཡུལ་མི་རྣམས་ཀྱི་རྐྱེན་དང་། ཁོ་ཚོས་སྤྱོད་པ་སྤྱད་པའི་མཇུག་འབྲས་ཀྱི་དབང་གིས་ས་གཞི་སྟོངས་པར་འགྱུར་རོ། །"]},{"type":"heading","content":["ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་སྙིང་རྗེ་དགོངས་པ།"]},{"type":"verse","number":14,"content":["ཁྱེད་ཀྱིས་རྩྭ་ཆུ་འཛོམས་པའི་ཡུལ་དུ་ཉིད་ཀྱི་དབྱུག་པས་ཁེར་རྐྱང་དུ་ལུས་པའི་མི་རྣམས་ཏེ་ཁྱེད་ཀྱི་ནོར་སྐལ་ཡིན་པའི་ལུག་ཁྱུ་འཚོ་བར་མཛོད། དེ་དག་ལ་གནའ་ལྟར་པཱ་ཤན་དང་གིལ་ཨད་དུ་གཟིགས་སྐྱོང་འཐོབ་པར་གྱུར་ཅིག"]},{"type":"verse","number":15,"content":["ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་ཉིན་མོ་བཞིན་དུ། ངས་དེ་དག་ལ་ངོ་མཚར་བའི་འཕྲིན་ལས་རྣམས་སྟོན་པར་བྱའོ། །"]},{"type":"verse","number":16,"content":["མི་རིགས་རྣམས་ཀྱིས་དེ་མཐོང་ཞིང་། སྟོབས་ཤུགས་ཆེ་ན་ཡང་ངོ་ཚ་བར་འགྱུར་ལ། དེ་དག་གིས་རང་གི་ལག་པས་སྨྲ་སྒོ་གཅོད་ཅིང་། རྣ་བ་བཀབ་ནས་མི་མཉན་ནོ། །"]},{"type":"verse","number":17,"content":["དེ་དག་གིས་སྦྲུལ་ལྟར་ས་ལྡག་ཅིང་། ལྟོ་འགྲོ་བཞིན་དུ་འདར་ཞིང་འདར་བཞིན་རང་གི་ཚང་རྣམས་དང་འབྲལ་བར་འགྱུར། དེ་དག་འཇིགས་ཤིང་རང་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་འོང་བ་དང་། ཁྱོད་ཀྱི་དབང་གིས་དངངས་པར་འགྱུར་རོ། །"]},{"type":"verse","number":18,"content":["མི་ལ་ཉེས་ཆད་མི་གཅོད་ཅིང་། རང་གི་ནོར་སྐལ་ནང་གི་ལྷག་ལུས་རྣམས་ལ་དགོངས་ཡངས་གནང་བའི་དཀོན་མཆོག་གཞན་སུ་ཞིག་ཡོད་དམ། ཁོང་ནི་དུས་གཏན་དུ་ཐུགས་ཁྲོ་བར་མི་བྱ་ཞིང་། དྲིན་གྱིས་སྐྱོང་བ་ལ་ཐུགས་མཉེས་པའོ། །"]},{"type":"verse","number":19,"content":["ཁོང་གིས་ཞལ་ཚུར་འཁོར་ནས་རང་ཅག་ལ་སྙིང་རྗེ་དགོངས་ཞིང་། རང་ཅག་གི་སྡིག་པ་རྣམས་ཞབས་འོག་ཏུ་གནོན་པར་འགྱུར་ཏེ། ཁོང་གིས་རང་ཅག་གི་ཉེས་སྐྱོན་ཐམས་ཅད་རྒྱ་མཚོའི་གཏིང་དུ་འདོར་བར་འགྱུར།"]},{"type":"verse","number":20,"content":["གནའ་དུས་ངེད་ཀྱི་ཕ་མེས་རྣམས་ལ་ཞལ་བཞེས་གནང་བ་བཞིན་དུ། ཡ་ཀོབ་ལ་ཐུགས་དྲང་པོ་དང་། ཨབ་ར་ཧམ་ལ་བྱམས་བརྩེ་མངོན་པར་མཛད་དོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}