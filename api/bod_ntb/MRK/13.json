{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":13,"content":[{"type":"heading","content":["མཆོད་ཁང་མེད་པར་གཏོང་བའི་ལུང༌བསྟན།"]},{"type":"verse","number":1,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་ཁང་ནས་ཕྱིར་ཕེབས༌དུས། ཐུགས་སྲས་རྣམས་ལས་གཅིག་ན༌རེ། སློབ་དཔོན༌ལགས། གཟིགས༌དང༌། འདི་ནི་ཇི་འདྲའི་རྡོ་ཕ་བོང་ཆེན་པོ་ཞིག༌དང༌། ཅི་ལྟ་བུའི་ཁང་པའི་བཟོ་བཀོད་ངོ་མཚར་ཆེ་བ་ཞིག་ཡིན་ཨང་ཞེས་སྨྲས་པ༌ལ།"]},{"type":"verse","number":2,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་བརྗིད་རྔམ་ཆེ་བའི་ཁང་པའི་བཟོ་བཀོད་ཆེན་པོ་འདི་དག་མཐོང་བ་ཡིན༌ནམ། མ་འོངས་པའི་དུས༌སུ། འདི་རུ་རྡོ་ཕ་བོང་སྟེང་དུ་རྡོ་གཅིག་ཀྱང་མི་ལུས་པར་ཐམས་ཅད་བཤིག་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དུས་ཀྱི་མཐའ་མའི་སྐོར་གྱི་ལུང༌བསྟན།"]},{"type":"verse","number":3,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་སྐྱུ་རུ་རའི་རི་བོ་སྟེང་དུ་ཕེབས་ཏེ་མཆོད་ཁང་ལ་ཁ་གཏད་ནས་བཞུགས་པའི་དུས༌སུ། པེ་ཏྲོ༌དང༌། ཡ༌ཀོབ། ཡོ་ཧ༌ནན། ཨན་དྲི་ཡཱ་བཅས་ཀྱིས་ཟུར་དུ་ཁོང་ལ་འདི་ལྟར་དྲིས༌ཏེ།"]},{"type":"verse","number":4,"content":["དོན་འདི་རྣམས་དུས་ནམ་ཞིག་ལ་འབྱུང་ཞིང་དོན་འདི་རྣམས་འབྱུང་བའི་དུས་སུ་རྟགས་ཅི་ཞིག་ཡོད་པ་གསུང་བར་མཛོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":5,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། སུ་ཞིག་གིས་ཀྱང་ཁྱོད་རྣམས་མི་བསླུ་བའི་ཆེད་དུ་དོགས་པར༌གྱིས།"]},{"type":"verse","number":6,"content":["མི་མང་པོ་ངའི་མིང་དུ་རྫུ་བཞིན་ཡོང༌སྟེ། ང་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་ཟེར་ཞིང་མི་མང་པོ་བསླུ་བར༌ངེས།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་གིས་དམག་འཁྲུག་དང་དམག་འཁྲུག་གི་གཏམ་ཐོས་པའི་དུས་སུ་མི་འཇིགས་པར༌གྱིས། དོན་འདི་དག་འབྱུང་ངེས་ཀྱང་དེ་ནི་མཐའ་མའི་དུས་ལ་སླེབས་པ་མ་ཡིན༌ནོ།།"]},{"type":"verse","number":8,"content":["རྒྱུ་མཚན་ནི་མི་རིགས་དང་མི་རིགས་འཁྲུག་ཅིང་རྒྱལ་ཁབ་དང་རྒྱལ་ཁབ་འཁྲུག༌པ། ས་ཆ་མང་པོར་ས་འགུལ་དང་མུ་གེ་ཡང་འབྱུང་བར༌འགྱུར། འདི་དག་ནི་སྦྲུམ་མའི་ཟུག་གཟེར་གྱི་ཐོག་མ་ཡིན༌ནོ།།"]},{"type":"verse","number":9,"content":["འོན་ཀྱང་རང་གི་ཆེད་དུ་ཁྱོད་ཅག་གིས་གཟབ་པར༌གྱིས། རྒྱུ་མཚན་ནི་ཁྱོད་རྣམས་ཁྲིམས་རའི་ཁྲིམས་དཔོན་རྒན་པོ་རྣམས་ཀྱི་ལག་ཏུ་སྤྲོད༌ཅིང༌། ཆོས་ཁང་ནས་རྟ་ལྕག་གིས་གཞུ་ངེས་པ༌དང༌། ཡང་བདག་གི་རྐྱེན་གྱིས་ཁྱོད་རྣམས་སྤྱི་དཔོན་དང་རྒྱལ་པོ་རྣམས་ཀྱི་མདུན་དུ་ཁྲིད༌ནས། དེ་རྣམས་ལ་བདེན་དཔང་བྱ་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":10,"content":["ཡང་དོན་དེའི་སྔོན་དུ་མི་རིགས་ཀུན་ལ་ངེས་པར་བདག་གི་འཕྲིན་བཟང་བསྒྲག༌དགོས།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་ཁྱོད་རྣམས་བཟུང་སྟེ་ཁྲིམས་ཐག་གཅོད་པར་སྤྲོད་པའི་དུས༌སུ། ཁྱོད་ཅག་གིས་དོན་དེའི་སྔོན་ལ་ཅི་ཞིག་སྨྲ་བར་སེམས་ཁྲལ་བྱ་མི་དགོས༌ཏེ། དུས་དེར་ཁྱོད་ཅག་ལ་ཅི་ཞིག་གནང་བ་ཡིན་ན་དེ་ཤོད༌ཅིག རྒྱུ་མཚན་ནི་སྐབས་དེའི་གཏམ་སྨྲ་མཁན་ནི་ཁྱོད་རྣམས་རང་ཉིད་མ་ཡིན་པར་དམ་པའི་ཐུགས་ཉིད་ཡིན་པས༌སོ།།"]},{"type":"verse","number":12,"content":["དེའི་དུས༌སུ། གཅེན་པོས་གཅུང་པོ་དང་ཕ་ཡིས་རང་གི་བུ་ཡང་འཆི་ལམ་དུ་བསྐྱལ་བར་འགྱུར༌ཞིང༌། བུ་ཕྲུག་རྣམས་ཀྱིས་ཀྱང་ཕ་མ་དགྲ་རུ་བཟུང་སྟེ་གསོད་པར༌འགྱུར།"]},{"type":"verse","number":13,"content":["ཡང་ངའི་མིང་གི་རྐྱེན་གྱིས་མི་ཐམས་ཅད་ཁྱོད་ཅག་ལ་སྡང་བར་འགྱུར༌མོད། འོན་ཀྱང་མཐར་ཐུག་ཏུ་བཟོད་བསྲན་བྱེད་མཁན་དེ་ལ་ཐར་པ་འཐོབ་ངེས༌སོ།།"]},{"type":"heading","content":["བཙོག་པར་བཟོ་བའི་སྐུར་བ་འདེབས་མཁན་གྱི༌སྐོར།"]},{"type":"verse","number":14,"content":["མདོ་འདི་ཀློག་མཁན་གྱིས་དོན་རྟོགས་པར་བྱ༌སྟེ། ནམ་ཞིག་ཁྱོད་ཅག་གིས་སྟོང་པར་བྱེད་པའི་སྐྱུག་བྲོ་བ་དེ་སྡོད་མི་འོས་པའི་གནས་སུ་འགྲེངས་ནས་བསྡད་ཡོད་པ་མཐོང་དུས༌སུ། ཡ་ཧུ་དཱའི་ཡུལ་དུ་ཡོད་པ་རྣམས་རི་ལ་འབྲོ་བར༌གྱིས།"]},{"type":"verse","number":15,"content":["ཁང་པའི་སྟེང་དུ་ཡོད་པ་རྣམས་སར་བབས་ནས་རང་ཁྱིམ་དུ་དངོས་པོ་ལེན་དུ་མ༌འགྲོའོ།།"]},{"type":"verse","number":16,"content":["ཞིང་ཁར་ཡོད་པ་རྣམས་རང་གི་གྱོན་པ་ལེན་དུའང་ཕྱིར་མ་ལོག༌ཅིག"]},{"type":"verse","number":17,"content":["ཉིན་དེ་དག་གི་རིང༌ལ། བུད་མེད་སྦྲུམ་མ་དང་ཕྲུ་གུར་ནུ་མ་སྣུན་མཁན་རྣམས་སྙིང་རེ་རྗེ༌ཨང༌།"]},{"type":"verse","number":18,"content":["དོན་དེ་དགུན་ཁར་མི་འབྱུང་བའི་ཕྱིར་ཁྱོད་ཅག་གིས་སྨོན་ལམ་ཐོབས༌ཤིག"]},{"type":"verse","number":19,"content":["རྒྱུ་མཚན་ནི་ཉིན་དེ་དག་གི་རིང༌ལ། དཀའ་སྡུག་འབྱུང་བར་འགྱུར་བ༌དང༌། དཀའ་སྡུག་དེ་ལྟ་བུ་དཀོན་མཆོག་གིས་འཇིག་རྟེན་བཀོད་པ་ནས་ད་ལྟའི་བར་དུ་བྱུང་མ་མྱོང་ལ་རྗེས་སུའང་འབྱུང་མི་སྲིད༌དོ།།"]},{"type":"verse","number":20,"content":["ཡང་གཙོ་བོས་ཉིན་དེ་དག་ཇེ་ཉུང་དུ་མཛད་པ་མིན༌ན། ཤ་ཁྲག་གདོས་བཅས་སུ་གྲུབ་པ་སུ་ཡང་ཐར་མི་ཐུབ༌མོད། འོན་ཀྱང་ཁོང་གིས་བདམས་པའི་མི་རྣམས་ཀྱི་དོན་དུ་ཉིན་དེ་དག་ཇེ་ཉུང་དུ་མཛད་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":21,"content":["དེའི་དུས༌སུ། སུ་ཞིག་གིས་ཁྱོད་ཅག་ལ་ལྟོས་དང་མཱ་ཤི་ཀ་འདི་རུ༌བཞུགས། ཡང་ན་དེ་གར་བཞུགས་ཞེས་སྨྲས་ཀྱང་དེ་ལ་ཡིད་རྟོན་བྱ་མི་རུང༌ངོ༌།།"]},{"type":"verse","number":22,"content":["རྒྱུ་མཚན་ནི་མཱ་ཤི་ཀ་བཅོས་མ་དང་ལུང་སྟོན་པ་རྫུས་མ་མང་པོ་འབྱུང༌ཞིང༌། གལ་ཏེ་བསླུ་ནུས་ན་བདམས་པའི་མི་རྣམས་ཀྱང་བསླུ་བའི༌ཕྱིར། གྲུབ་རྟགས་དང་ངོ་མཚར་བའི་དོན་རྣམས་སྟོན་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":23,"content":["བདག་གིས་གཏམ་འདི་ཐམས་ཅད་དོན་དེའི་སྔོན་དུ་ཁྱོད་ཅག་ལ་སྨྲས་པ་ཡིན་པས་གཟབ་པར་གྱིས་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཕེབས་ཡོང་བའི༌སྐོར།"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཉིན་དེ་དག་གི་རིང་དང་དཀའ་སྡུག་དེའི་རྗེས་སུ་ཉི་མ་བསྒྲིབ་ཅིང་ཟླ་བས་འོད་མི༌སྤྲོའོ།།"]},{"type":"verse","number":25,"content":["སྐར་ཚོགས་ནམ་མཁའ་ནས་ལྷུང་ཞིང་བར་སྣང་ཁམས་ཀྱི་དབང་ཐམས་ཅད་གཡོ་བར༌འགྱུར།"]},{"type":"verse","number":26,"content":["དེའི་དུས༌སུ། མི་རྣམས་ཀྱིས་མིའི་བུ་ཁོ་རང་ནུས་མཐུ་དང་གཟི་བརྗིད་ཆེན་པོའི་ངང་སྤྲིན་གྱི་བང་རིམ་ནས་འབྱོན་པ་མཐོང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":27,"content":["དེ་ནས་ཁོས་རང་ཉིད་ཀྱི་ཕོ་ཉ་རྣམས་མངགས༌ཏེ། ས་གཞི་ཆེན་པོའི་མཐའ་ནས་ནམ་མཁའི་མཐའ་མཚམས་བར་དུ་ཁོའི་བདམས་པའི་མི་ཐམས་ཅད་ཕྱོགས་བཞི་མཚམས་བརྒྱད་ནས་བསྡུ་བར་འགྱུར༌རོ།།"]},{"type":"heading","content":["བསེ་ཡབ་ཤིང་གི་བསླབ༌བྱ།"]},{"type":"verse","number":28,"content":["ཁྱོད་ཅག་གིས་བསེ་ཡབ་ཤིང་ལས་བསླབ་བྱ་ཞིག་ལོངས་དང༌། དེའི་ཡལ་ག་མཉེན་ལྕུག་ལྡན་པར་གྱུར་ནས་ལོ་མ་འབུས་པའི་དུས༌སུ། དབྱར་ཁའི་དུས་ལ་ཉེ་བ་ཁྱོད་ཅག་གིས་ཤེས༌སོ།།"]},{"type":"verse","number":29,"content":["དེ་བཞིན་དུ་ཁྱོད་ཅག་གིས་དོན་དེ་དག་མཐོང་བའི༌ཚེ། མིའི་བུ་སླེབ་ལ་ཉེ་བ་དང་སྒོ་འགྲམ་དུ་སླེབས་ཡོད་པ་རྟོགས་པར༌གྱིས།"]},{"type":"verse","number":30,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་བདེན་པར་སྨྲ༌སྟེ། མི་རབས་འདི་ད་དུང་མ་འདས་པའི་སྔོན་ལ་དོན་འདི་ཐམས་ཅད་འབྱུང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":31,"content":["གནམ་ས་གཉིས་ནི་འཇིག་སྲིད་ཀྱང་བདག་གི་བཀའ་རྣམས་འཇིག་པར་མི་འགྱུར༌རོ།།"]},{"type":"heading","content":["ཕྱིར་ཕེབས་པར་བློ་གཟུ་བོར་གནས་དགོས༌པ།"]},{"type":"verse","number":32,"content":["འོན་ཀྱང་མི་སུས་ཀྱང་ཉིན་མོ་དེའམ་དུས་དེ་ནི་ནམ་ཞིག་ཡིན་པ་མི་ཤེས༌ཤིང༌། ནམ་མཁའི་ཞིང་ཁམས་སུ་སྡོད་པའི་ཕོ་ཉ་རྣམས་ཀྱིས་ཀྱང་མི་ཤེས༌ལ། སྲས་ཀྱིས་ཀྱང་མི་ཤེས་ཏེ་ཡབ་གཅིག་པུས་མཁྱེན༌ཏོ།།"]},{"type":"verse","number":33,"content":["ཡང་དུས་དེ་ནམ་ཞིག་ལ་སླེབ་པ་ཁྱོད་ཅག་གིས་མི་ཤེས་པས་དོགས་པར་གྱིས་དང་གཉིད་དུ་མ་ཡུར༌ཅིག"]},{"type":"verse","number":34,"content":["འདི་ནི་མི་ཞིག་གིས་རང་ཁྱིམ་བསྐྱུར་ཏེ་ཡུལ་གཞན་དུ་འགྲོ་བའི་སྐབས༌སུ། རང་གི་གཡོག་པོ་རྣམས་ལ་དབང་ཐམས་ཅད་སྤྲད་ནས་སོ་སོར་ལས་ཀ་བགོས་པ༌དང༌། སྒོ་སྲུང་མཁན་གྱིས་ཀྱང་དོགས་ཟོན་བྱེད་དགོས་པར་བཀའ་གནང་བ་དང༌འདྲའོ།།"]},{"type":"verse","number":35,"content":["དེ་བས་ཁྱིམ་བདག་དེ་ནི་མཚན་མོའམ་ནམ་ཕྱེད་ཀྱི་དུས༌སམ། ཡང་ན་བྱ་ཕོ་གྲགས་པའི་དུས་སམ་ཞོགས་པའི་དུས་གང་ཞིག་ལ་ཡོང་བ་ཁྱོད་ཅག་གིས་མི་ཤེས་པས་དོགས་པར༌གྱིས།"]},{"type":"verse","number":36,"content":["དེ་ལྟར་མ་བྱས་ན་ཁོ་རང་གློ་བུར་ཕྱིར་ལོག༌ཚེ། ཁྱོད་ཅག་གཉིད་དུ་ཡུར་བ་མཐོང་བར་འགྱུར༌རོ།།"]},{"type":"verse","number":37,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་སྨྲས་པ་འདི་དག་ནི་མི་ཐམས་ཅད་ལའང་དོགས་པར་གྱིས་ཞེས་སྨྲས་པ་ཡིན་གསུངས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/MRK/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/12.json","previousChapterAudioLinks":{},"numberOfVerses":37}