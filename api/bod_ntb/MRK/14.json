{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":14,"content":[{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་དབུ་ལ་སྤོས་ཆུ་བླུགས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཉིན་གཉིས་ཀྱི་རྗེས་ནི་པེ་སག་གི་དུས་ཆེན་དང་སྐྱུར་མེད་བག་ལེབ་ཀྱི་དུས་ཆེན་ཡིན་པ༌དང༌། མཆོད་དཔོན་ཆེན་པོ་དག་དང་མཁན་པོ་རྣམས་ཀྱིས་གཡོ་ཐབས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་འཛིན་བཟུང་བྱས་ནས་དགྲོང་བའི་གོ་སྐབས་བཙལ་མོད༌ཀྱང༌།"]},{"type":"verse","number":2,"content":["དེ་དག་ན༌རེ། མི་སེར་ཟིང་ཆ་ལངས་ཉེན་ཡོད་པས་དུས་ཆེན་ལ་དེ་ལྟར་བྱེད་མི་རུང་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":3,"content":["དེ་ཡང་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་པེ་ཐན་ཡཱའི་མཛེ་ནད་ཅན་སི་མོན་གྱི་ཁྱིམ་དུ་བཞུགས་ཏེ་ཞལ་ཟས་བཞེས་པའི་དུས༌སུ། བུད་མེད་ཅིག་གིས་རིན་ཐང་ཆེ་བའི་སྤོས་ཆུ་ལྷད་མེད་པ་ནཱར་དི་",{"noteId":11},"ཡིས་གང་བའི་རྡོ་ཀ་མ་རུའི་བུམ་པ་ཞིག་ཁྱེར་ཡོང༌སྟེ། བུམ་པ་བཅགས་ནས་ཁོང་གི་དབུ་ལ་སྤོས་ཆུ་བླུགས༌པས།"]},{"type":"verse","number":4,"content":["གནས་དེར་ཡོད་པའི་མི་འགའ་ཞིག་ཁྲོས་ཏེ་ཕན་ཚུན་ན༌རེ། སྤོས་ཆུ་འདི་ཅིའི་ཕྱིར་འདི་ལྟར་ཆུད་ཟོས་སུ་བཏང་བ་ཡིན༌ནམ།"]},{"type":"verse","number":5,"content":["སྤོས་ཆུ་འདི་དངུལ་སྒོར་སུམ་བརྒྱ་ལྷག་ལ་བཙོངས་ཏེ་དབུལ་པོ་རྣམས་ལ་བྱིན་ན་མི་ལེགས་སམ་ཞེས་སྨྲས་ཤིང་བུད་མེད་དེར་གཤེ་གཤེ་བཏང༌ངོ༌།།"]},{"type":"verse","number":6,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁོ་མོར་དེ་བཞིན་བྱེད་དུ༌ཆུག ཅིའི་ཕྱིར་ཁོ་མོར་འོ་བརྒྱལ་བྱེད༌དམ། ཁོ་མོས་བདག་ལ་དོན་བཟང་པོ་བྱས་པ་ཡིན༌ཏེ།"]},{"type":"verse","number":7,"content":["དབུལ་པོ་རྣམས་དུས་རྟག་ཏུ་ཁྱོད་རྣམས་དང་མཉམ་དུ་ཡོད༌པས། ཁྱོད་ཅག་གིས་ནམ་ཡིན་ཡང་དེ་དག་ལ་ལས་བཟང་པོ་བྱ་ཐུབ༌མོད། འོན་ཀྱང་བདག་ནི་དུས་རྟག་ཏུ་ཁྱོད་རྣམས་དང་མཉམ་དུ་མི་གནས༌སོ།།"]},{"type":"verse","number":8,"content":["ཁོ་མོས་ཅི་བྱ་ནུས་པ་དེ་བཞིན་དུ་བྱས་པ༌དང༌། ཁོ་མོས་ང་རང་དུར་ལ་འཇུག་པར་སྔ་མོ་ནས་བདག་གི་ལུས་ལ་སྤོས་ཆུ་བླུགས་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":9,"content":["ངས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། འཇིག་རྟེན་ཡོངས་ཀྱི་ཡུལ་གང་དུ་འཕྲིན་བཟང་འདི་བསྒྲགས༌ན། བུད་མེད་འདིས་ཅི་ལྟར་བྱས་པ་དྲན་པའི་ཕྱིར་གཏམ་དེ་ཡང་བརྗོད་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཐུགས་སྲས་བཅུ་གཉིས་པོ་ལས་ཨི་སི་ཀར་རེའི་ཡུ་དཱ་ངོ་ལོག་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་མཆོད་དཔོན་ཆེན་པོ་རྣམས་ལ་སྤྲོད་པའི་ཕྱིར་དེ་རྣམས་ཀྱི་གམ་དུ་སོང༌ཞིང༌།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་ཀྱང་གཏམ་དེ་ཐོས་ནས་ཤིན་ཏུ་དགའ་བར་གྱུར་ཏེ་ཁོ་ལ་དངུལ་སྟེར་བར་ཁས་བླངས༌སོ། །དེ་ནས་ཁོས་སྐྱབས་མགོན་ཡེ་ཤུ་དེ་དག་གི་ལག་ཏུ་ཇི་ལྟར་སྤྲོད་པའི་གོ་སྐབས་བཙལ༌ཏོ།།"]},{"type":"heading","content":["གཙོ་བོ་ཡེ་ཤུའི་རྗེས་དྲན་གྱི་ཞལ༌ཟས།"]},{"type":"verse","number":12,"content":["སྐྱུར་མེད་བག་ལེབ་དུས་ཆེན་གྱི་ཉིན་དང༌པོར། པེ་སག་གི་ལུ་གུ་",{"noteId":12},"བཤའ་བའི་དུས༌སུ། ཐུགས་སྲས་རྣམས་ན༌རེ། ཁྱེད་ཀྱིས་པེ་སག་གི་ཞལ་ཟས་བཞེས་པའི༌ཕྱིར། ངེད་ཅག་གིས་གནས་གང་དུ་སྟ་གོན་བྱེད་དགོངས་སམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":13,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་གཉིས་མངགས་ཏེ་འདི་སྐད༌དུ། ཁྱོད་གཉིས་གྲོང་ཁྱེར་ནང་དུ་སོང༌དང༌། དེ་རུ་ཆུ་བུམ་འཁྱེར་བའི་སྐྱེས་པ་ཞིག་ཚུར་ཡོང་བར་འགྱུར་ཞིང་མི་དེའི་རྗེས་འབྲངས་ནས་སོང༌སྟེ།"]},{"type":"verse","number":14,"content":["ཁོ་རང་ཁྱིམ་གང་དུ་སོང་ན་ཁྱོད་གཉིས་ཀྱིས་ཁྱིམ་དེའི་བདག་པོ༌ལ། སློབ་དཔོན་གྱིས་ཁྱོད་ལ་འདི་སྐད་གསུངས་ཏེ། ང་དང་ངའི་ཐུགས་སྲས་རྣམས་ཀྱིས་མཉམ་དུ་པེ་སག་གི་ཞལ་ཟས་བཞེས་སའི་འགྲུལ་ཁང་དེ་གང་དུ་ཡོད་ཅེས་ཤོད༌ཅིག"]},{"type":"verse","number":15,"content":["མི་དེས་ཁྱོད་གཉིས་ལ་ཅ་ལག་ཁ་ཚང་བསྒྲིགས་ཡོད་པའི་ཐོག་ཁང་ཆེན་པོ་ཞིག་སྟོན༌སྲིད། ཁྱོད་གཉིས་ཀྱིས་ཀྱང་གནས་དེ་རུ་བདག་ཅག་གི་གསོལ་སྟོན་ལ་སྟ་གོན་བྱོས་ཤིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":16,"content":["ཐུགས་སྲས་དེ་གཉིས་སོང་ནས་གྲོང་ཁྱེར་ནང་དུ་སླེབས༌ཏེ། ཁོང་གིས་གསུངས་པ་ལྟར་མཐོང་ཞིང་གནས་དེ་རུ་པེ་སག་གི་གསོལ་སྟོན་བཤམས༌སོ།།"]},{"type":"verse","number":17,"content":["མཚན་མོའི་དུས༌སུ། ཁོང་དང་ཐུགས་སྲས་བཅུ་གཉིས་པོ་མཉམ་དུ་གནས་དེར་ཕེབས༌ཤིང༌།"]},{"type":"verse","number":18,"content":["ཁོང་རྣམས་ལྷན་དུ་གྲལ་ལ་བཞུགས་ནས་ཞལ་ཟས་བཞེས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་ཅག་ལ་བདེན་པར་སྨྲ༌སྟེ། བདག་དང་མཉམ་དུ་ཟས་ཟ་མཁན་ཁྱོད་རྣམས་ལས་མི་གཅིག་གིས་ང་རང་ལ་ངོ་ལོག་བྱ་ངེས་ཞེས་གསུངས་པ༌ན།"]},{"type":"verse","number":19,"content":["ཁོ་རྣམས་ཀྱི་སེམས་སྐྱོ་བར་གྱུར་ཏེ་རེ་རེ་བཞིན་གྱིས་ཁོང་ལ་དྲིས༌པ། ང་རང་ཡིན་མི་སྲིད་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":20,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། དེ་ནི་ཐུགས་སྲས་བཅུ་གཉིས་པོ་ཁྱོད་རྣམས་ལས་བདག་དང་མཉམ་དུ་སྡེར་མའི་ནང་ལ་བག་ལེབ་སྦོང་མཁན་དེ་ཡིན༌ནོ།།"]},{"type":"verse","number":21,"content":["མིའི་བུ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་ཁོའི་སྐོར་བཀོད་ཡོད་པ་བཞིན་གཤེགས་དགོས༌ཀྱང༌། མིའི་བུ་ལ་ངོ་ལོག་བྱེད་མཁན་གྱི་མི་དེར་ཆག་སྒོ་འབྱུང་བར༌ངེས། མི་དེ་སྐྱེས་པ་ལས་མ་སྐྱེས་ན་ལེགས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":22,"content":["ཁོང་རྣམས་ཀྱིས་ཞལ་ཟས་བཞེས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུས་ཕྱག་ཏུ་བག་ལེབ་བསྣམས་ཏེ་བྱིན་རླབས་གནང༌རྗེས། དུམ་བུར་བགོས་ནས་ཁོ་རྣམས་ལ་གནང་སྟེ་འདི་སྐད༌དུ། འདི་ནི་བདག་གི་ལུས་པོ་ཡིན་ལ་ཁྱོད་ཅག་གིས་ལོངས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":23,"content":["ཡང་ཁོང་གིས་ཕོར་བ་ཕྱག་ཏུ་བསྣམས་ཏེ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས་རྗེས་ཁོ་རྣམས་ལ་གནང་བ་དང་ཚང་མས་དེ་ལས་བཏུངས༌སོ།།"]},{"type":"verse","number":24,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། འདི་ནི་བདག་གི་ཞལ་ཆད་ཀྱི་ཁྲག་ཡིན༌ཏེ། མི་མང་པོའི་ཆེད་དུ་བཞུར་བ༌ཡིན།"]},{"type":"verse","number":25,"content":["བདག་གིས་ཁྱོད་ཅག་ལ་བདེན་པར་སྨྲ༌སྟེ། ངས་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ནས་གསར་པ་ཞིག་འཐུང་བའི་ཉིན་མོའི་བར༌དུ། རྒུན་འབྲུམ་གྱི་ཁུ་བ་འདི་འཐུང་བ་མིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":26,"content":["དེ་ནས་ཁོང་རྣམས་ཀྱིས་གསུང་མགུར་བླངས་རྗེས་ཕྱི་རུ་ཐོན་ཞིང་སྐྱུ་རུ་རའི་རི་བོར་ཕེབས༌སོ།།"]},{"type":"heading","content":["ཐུགས་སྲས་པེ་ཏྲོའི་སྐོར་གྱི་ལུང༌བསྟན།"]},{"type":"verse","number":27,"content":["དེ་ནས་ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། བདག་གིས་ལུག་རྫི་ལ་རྡུང་རྡེག་བྱས་ནས་ལུག་རྣམས་འཐོར་བར་འགྱུར་ཞེས་བཀོད་པ༌བཞིན། ཁྱོད་ཅག་ཐམས་ཅད་ས་རུ་འགྱེལ་བར༌འགྱུར།"]},{"type":"verse","number":28,"content":["འོན་ཀྱང་བདག་ནི་སླར་གསོན་རྗེས་ཁྱོད་ཅག་གི་སྔོན་ལ་ག་ལིལ་ཡུལ་དུ་འགྲོ་ངེས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":29,"content":["དེ་ནས་པེ་ཏྲོ་ན༌རེ། མི་ཐམས་ཅད་ས་རུ་འགྱེལ་ནའང་བདག་ནི་འགྱེལ་བ་མིན་ཞེས་ཞུས་པ༌ན།"]},{"type":"verse","number":30,"content":["ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། བདག་གིས་ཁྱོད་ལ་བདེན་པར་སྨྲ༌སྟེ། དོ་དགོང་གི་དུས་འདིར་བྱ་ཕོ་ཐེངས་གཉིས་མ་གྲགས་པའི་སྔོན༌དུ། ཁྱོད་ཀྱིས་ཐེངས་གསུམ་ལ་ང་རང་ཁས་མི་ལེན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་པེ་ཏྲོས་ཁོང་ལ་བདག་ནི་ཁྱེད་དང་མཉམ་དུ་འཆི་དགོས༌ཀྱང༌། ཁྱེད་རང་ཁས་མི་ལེན་པ་དཔེ་མི་སྲིད་ཅེས་ནན་གྱིས་ཞུས་ཤིང་ཐུགས་སྲས་གཞན་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་ཞུས༌སོ།།"]},{"type":"heading","content":["གེད་སེམ་མཱ་ནེ་ཞེས་པའི་སྐྱེད༌ཚལ།"]},{"type":"verse","number":32,"content":["དེ་ནས་ཁོང་རྣམས་གེད་སེམ་མཱ་ནེ་ཞེས་པའི་ས་ཆ་ཞིག་ལ་ཕེབས་པ༌དང༌། ཁོང་གིས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། བདག་གིས་གསོལ་བ་འདེབས་པའི་བར་དུ་ཁྱོད་ཅག་གནས་འདིར་སྡོད་ཅིག་ཅེས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":33,"content":["པེ་ཏྲོ༌དང༌། ཡ༌ཀོབ། ཡོ་ཧ་ནན་གསུམ་པོ་ཁྲིད་པ༌དང༌། དུས་དེར་ཁོང་གི་ཐུགས་ཤིན་ཏུ་འཁྲུག་ཅིང་གདུངས་པར་གྱུར་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":34,"content":["བདག་སེམས་ཤིན་ཏུ་སྐྱོ་ནས་འཆི་ལ༌ཉེའོ། །ཁྱོད་ཅག་གིས་གནས་འདི་རུ་བསྒུགས་ནས་དོགས་ཟོན་གྱིས་ཤིག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":35,"content":["ཡང་ཁོང་ཉིད་མདུན་ཕྱོགས་སུ་ཅུང་ཙམ་ཕེབས་ཤིང་སྐུ་ལུས་སར་བཏུད་དེ་འདི་སྐད༌དུ། གལ་ཏེ་སྲིད་པ་ཡིན་ན་དུས་འདི་བདག་ལས་འདའ་བར་མཛོད་ཅེས་གསོལ་བ༌བཏབ།"]},{"type":"verse","number":36,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཀྱེ། ཨབ་བཱ༌ལགས། ཡབ༌ལགས། ཁྱེད་ལ་བསྒྲུབ་མི་ནུས་པའི་བྱ་བ་གང་ཡང་མེད་པས་ཕོར་བ་འདི་བདག་ལས་ཕྱིར་ལེན་པར༌མཛོད། འོན་ཀྱང་བདག་གི་བསམ་པ་བཞིན་དུ་མི་འགྲུབ་པར་ཁྱེད་ཀྱི་ཐུགས་དགོངས་བཞིན་དུ་གྲུབ་གྱུར་ཅིག་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":37,"content":["དེ་ནས་ཁོང་ཉིད་ཕྱིར་ཕེབས་པ་ན་ཁོ་རྣམས་གཉིད་དུ་ཡུར་བ་གཟིགས་ཏེ་པེ་ཏྲོ་ལ་འདི་སྐད༌དུ། སི༌མོན། ཁྱོད་རང་གཉིད་ལ་ཡུར་བ་ཡིན༌ནམ། ཆུ་ཚོད་གཅིག་ཙམ་ལའང་དོགས་ཟོན་བྱ་མི་ནུས༌སམ།"]},{"type":"verse","number":38,"content":["ཁྱོད་ཅག་ཉམས་ཚོད་ཀྱི་འོག་ཏུ་མི་འཚུད་པའི་ཕྱིར་དོགས་ཟོན་བྱས་ནས་གསོལ་བ་ཐོབས༌ཤིག ཁྱོད་ཅག་གི་སེམས་སུ་དེ་ལྟར་བྱ་བསམ་ཡང་ལུས་སྟོབས་ཞན་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":39,"content":["ཡང་ཁོང་ཉིད་ཕར་ཕེབས་ནས་སྔར་བཞིན་གསོལ་བ་བཏབ་པ༌དང༌།"]},{"type":"verse","number":40,"content":["ཁོང་ཉིད་ཕྱིར་ཕེབས་པ་ན་ཡང་ཁོ་རྣམས་ངལ་དུབ་ཆེ་བས་གཉིད་དུ་ཡུར་བ་གཟིགས༌ཤིང༌། ཁོ་རྣམས་ཀྱིས་ཁོང་ལ་ཅི་ཞུ་བའང་མ་ཤེས༌སོ།།"]},{"type":"verse","number":41,"content":["ཁོང་ཐེངས་གསུམ་པར་ཕྱིར་ཕེབས་རྗེས་འདི་སྐད༌དུ། ཁྱོད་ཅག་ད་དུང་གཉིད་ནས་ངལ༌གསོའམ། གཉིད་པར་མི༌བྱའོ། །ད་ལྟ་དུས་ལ་བབས་པ༌རེད། ལྟོས༌དང༌། མིའི་བུ་སྡིག་ཅན་རྣམས་ཀྱི་ལག་ཏུ་སྤྲོད་པར༌བྱེད།"]},{"type":"verse","number":42,"content":["ལྟོས༌དང༌། ང་ལ་ངོ་ལོག་བྱེད་མཁན་དེ་ཉེ་སར་སླེབས་པས་ཡར་ལོངས་དང་འགྲོའོ་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་འཛིན་བཟུང་བྱས༌པ།"]},{"type":"verse","number":43,"content":["ཁོང་གིས་དེ་ལྟར་གསུང་བཞིན་པའི་དུས༌སུ། གློ་བུར་ཉིད་ལ་ཐུགས་སྲས་བཅུ་གཉིས་ཀྱི་ཡ་གྱལ་ཏེ་ཡུ་དཱ་སླེབས་པ༌དང༌། ད་དུང་ལག་ཏུ་རལ་གྲི་དང་དབྱུག་པ་ཐོགས༌ཤིང༌། མཆོད་དཔོན་ཆེན་པོ་རྣམས་དང་མཁན༌པོ། རྒན་པོ་དག་གིས་མངགས་པའི་མི་ཚོགས་ཀྱང་ཁོ་དང་མཉམ་དུ་སླེབས༌སོ།།"]},{"type":"verse","number":44,"content":["ཁོང་ལ་ངོ་ལོག་བྱེད་མཁན་དེས་མི་དེ་དག་ལ་ངས་སུ་ལ་འོ་བྱས༌ན། དེ་ནི་ཁོང་ཉིད་ཡིན་པས་མྱུར་དུ་བཟུང་ནས་དམ་པོར་ཁྲིད་ཅིག་ཅེས་སྔོན་ལ་ལྐོག་བརྡ་བརྒྱབ་ཡོད་པ༌རེད།"]},{"type":"verse","number":45,"content":["དེ་ནས་ངོ་ལོག་པ་དེ་ཁོང་གི་དྲུང་དུ་སླེབས་མ་ཐག་རཱབ་པེ་ལགས་ཞེས་ཞུས་ནས་ཁོང་གི་འགྲམ་པར་འོ་བྱས་པ༌ན།"]},{"type":"verse","number":46,"content":["མི་དེ་དག་གིས་ཁོང་ཉིད་བཟུང༌ངོ༌།།"]},{"type":"verse","number":47,"content":["ཁོང་གི་ཉེ་འགྲམ་དུ་ལངས་བསྡད་ཡོད་པ་རྣམས་ལས་མི་ཞིག་གིས་རལ་གྲི་ཕྱུང༌སྟེ། མཆོད་དཔོན་ཆེན་པོའི་གཡོག་པོར་བརྒྱབ་ནས་རྣ་བ་ཡ་གཅིག་བཅད༌དོ།།"]},{"type":"verse","number":48,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་རལ་གྲི་དང་དབྱུག་པ་བཟུང་ནས་ཇག་པ་འཛིན་པ་ལྟར་ང་རང་གཟུང་དུ་ཡོང༌ངམ།"]},{"type":"verse","number":49,"content":["བདག་གིས་ཉིན་རེ་བཞིན་མཆོད་ཁང་ནང་དུ་ཆོས་བཤད་ཅིང་ཁྱོད་རྣམས་དང་མཉམ་དུ་སྡོད་དུས་ཁྱོད་ཅག་གིས་ང་རང་མ་བཟུང༌མོད། འོན་ཀྱང་དོན་འདི་བྱུང་བ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་གསུངས་པ་ལྟར་འགྲུབ་པའི་ཕྱིར་ཡིན་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":50,"content":["ཐུགས་སྲས་ཐམས་ཅད་ཀྱིས་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུ་བསྐྱུར་ནས་བྲོས༌སོ།།"]},{"type":"verse","number":51,"content":["ལུས་ལ་སོ་རས་གྱོན་པའི་ན་གཞོན་ཞིག་ཁོང་གི་རྗེས་སུ་འབྲངས་ཤིང་མི་ཚོགས་ཀྱིས་ཁོ་རང་ཡང་བཟུང་བ༌ན།"]},{"type":"verse","number":52,"content":["ཁོས་སོ་རས་གཡུགས་ཏེ་ལུས་གཅེར་བུར་བྲོས༌སོ།།"]},{"type":"heading","content":["མཆོད་དཔོན་ཆེན་པོའི་ཁྲིམས་རར་ཁྲིད༌པ།"]},{"type":"verse","number":53,"content":["ཁོ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་མཆོད་དཔོན་ཆེན་པོའི་དྲུང་དུ་ཁྲིད་ཅིང་མཆོད་དཔོན་ཆེན་པོ་དག་དང་རྒན་པོ༌རྣམས། མཁན་པོ་རྣམས་ཀྱང་གནས་དེར༌འཛོམས།"]},{"type":"verse","number":54,"content":["པེ་ཏྲོའང་རྒྱང་རིང་ནས་ཁོང་གི་རྗེས་སུ་འབྲངས་ཏེ་མཆོད་དཔོན་ཆེན་པོའི་ར་སྐོར་དུ་སོང་ནས་སྲུང་དམག་དང་མཉམ་དུ་མེར་ལྡེ་བཞིན་བསྡད༌དོ།།"]},{"type":"verse","number":55,"content":["མཆོད་དཔོན་ཆེན་པོ་རྣམས་དང་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་ཐམས་ཅད་ཀྱིས་ཁོང་ཉིད་གཏུགས་ཤིང་སྲོག་ཆད་གཅོད་པའི་ཕྱིར་དཔང་པོ་བཙལ་ཡང་མ་རྙེད༌དོ།།"]},{"type":"verse","number":56,"content":["མི་མང་པོས་རྫུན་གྱི་དཔང་པོ་བྱས་ཀྱང་དཔང་པོ་བྱས་པ་ནང་མཐུན་མ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":57,"content":["ཡང་མི་འགའ་ཞིག་ཡར་ལངས་ནས་ཁོང་ལ་རྫུན་གྱི་དཔང་པོ་བྱས་ཏེ་གཏུགས་ཤིང་འདི་ལྟར་སྨྲས༌པ།"]},{"type":"verse","number":58,"content":["ཁོས་མི་ཡི་ལག་པས་བཟོས་པའི་མཆོད་ཁང་འདི་བཤིག༌སྟེ། ཉིན་གསུམ་ལ་མི་ཡི་ལག་པས་བརྩིགས་པ་མ་ཡིན་པའི་མཆོད་ཁང་གཞན་ཞིག་བཞེང་ངེས་ཡིན་ཟེར་བ་ངེད་ཅག་གིས་ཐོས་བྱུང་ཞེས་སྨྲས༌མོད།"]},{"type":"verse","number":59,"content":["འོན་ཀྱང་དཔང་པོ་བྱས་པ་དེ་ཡང་ནང་མཐུན་མ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":60,"content":["དེ་ནས་མཆོད་དཔོན་ཆེན་པོ་དཀྱིལ་ནས་ཡར་ལངས་ཏེ་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འདི་ལྟར་དྲིས་པ༌སྟེ། མི་འདི་རྣམས་ཀྱིས་ཁྱོད་ལ་དཔང་པོ་བྱས་ནས་གཏུག་པ་འདི་ཅི་ཡིན༌ནམ། ཁྱོད་ཀྱིས་ལན་ཅི་ཡང་མི་འདེབས་སམ་ཞེས་པ༌ན།"]},{"type":"verse","number":61,"content":["ཁོང་གིས་ཅི་ཡང་མ་གསུངས་ལ་བཀའ་ལན་ཡང་མ་གནང༌ངོ༌། །ཡང་མཆོད་དཔོན་ཆེན་པོ་ན༌རེ། ཁྱོད་ནི་བསྟོད་འོས་པ་དེ་ཉིད་ཀྱི་སྲས་མཱ་ཤི་ཀ་ཡིན་ནམ་ཞེས་དྲིས་པ༌ན།"]},{"type":"verse","number":62,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ང་རང་ཡིན༌ནོ། །ཁྱོད་ཅག་གིས་མིའི་བུ་ཁོང་ཉིད་ཀུན་དབང་ཉིད་ཀྱི་གཡས་ཕྱོགས་སུ་བཞུགས༌ཏེ། ནམ་མཁའི་སྤྲིན་དང་བཅས་ཕེབས་ཡོང་བ་མཐོང་བར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":63,"content":["མཆོད་དཔོན་ཆེན་པོས་རང་གི་གྱོན་པ་གཤགས་ཏེ་ད་ལྟ་བདག་ཅག་ལ་དཔང་པོ་ཅི་ལ༌དགོས།"]},{"type":"verse","number":64,"content":["ཁོས་དཀོན་མཆོག་ལ་སྐུར་བ་བཏབ་པ་ཁྱོད་རྣམས་ཀྱིས་ཀྱང་ཐོས་པས་ཁྱོད་ཅག་ལ་བསམ་འཆར་ཅི་ཡོད་ཅེས་སྨྲས་པ༌ན། དེ་དག་ཐམས་ཅད་ཀྱིས་ཁོང་གསོད་དགོས་པ་ཐག་གིས་བཅད༌ཅིང༌།"]},{"type":"verse","number":65,"content":["མི་འགའ་ཞིག་གིས་ཁོང་ལ་མཆིལ་མ་བཏབ་ཅིང་སྤྱན་ཟུང་རས་ཀྱིས་བཏུམས་ནས་ཁུ་ཚུར་གཞུས་ཏེ་ན༌རེ། ད་ལྟ་ལུང་བསྟན་ཤོད་ཅིག་ཅེས་བརྗོད་པ་དང་སྲུང་དམག་དག་གིས་ཀྱང་ཁོང་ཚུར་དྲུད་ནས་གདོང་ལ་འགྲམ་ལྕག་གིས་གཞུས༌སོ།།"]},{"type":"heading","content":["པེ་ཏྲོ་སྐྱབས་མགོན་ཡེ་ཤུའི་ཐུགས་དང་འགལ་བའི༌སྐོར།"]},{"type":"verse","number":66,"content":["དེ་ནས་པེ་ཏྲོ་ར་སྐོར་ཞོལ་མར་སྡོད༌དུས། མཆོད་དཔོན་ཆེན་པོའི་གཡོག་མོ་ཞིག་ཡོང༌སྟེ།"]},{"type":"verse","number":67,"content":["པེ་ཏྲོ་མེར་ལྡེ་བཞིན་པ་མཐོང་ཞིང་ཁོ་ལ་བལྟས་ནས་ཁྱོད་ཀྱང་ནཱ་ཙ་རེལ་པ་ཡེ་ཤུ་དང་གྲས་གཅིག་རེད་ཅེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":68,"content":["པེ་ཏྲོས་ཁས་མ་བླངས་པར་ཁྱོད་ཀྱིས་ཅི་བཤད་པ་ངས་མི་ཤེས་ལ་དོན་ཡང་མི་གོ་ཞེས་སྨྲས་ཏེ་སྒོ་ལམ་དུ་སོང་བ་དང་བྱ་ཕོ་གྲགས༌སོ།།"]},{"type":"verse","number":69,"content":["ཡང་གཡོག་མོ་དེས་པེ་ཏྲོ་མཐོང་ནས་སླར་ཡང་གནས་དེར་ལངས་བསྡད་ཡོད་པའི་མི་རྣམས༌ལ། མི་འདི་ཡང་དེ་དག་གི་གྲས་གཅིག་རེད་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":70,"content":["འོན་ཀྱང་པེ་ཏྲོས་ཡང་ཁས་མ་བླངས༌སོ། །དེ་ནས་ཅུང་མ་འགོར་བར་གནས་དེར་ལངས་བསྡད་ཡོད་པའི་མི་རྣམས་ཀྱིས་ཀྱང་པེ་ཏྲོ༌ལ། ཁྱོད་ནི་ག་ལིལ་པ་ཞིག་ཡིན་པས་དངོས་གནས་དེ་དག་དང་གྲས་གཅིག་རེད་ཅེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":71,"content":["པེ་ཏྲོས་སྡིགས་དམོད་བྱེད་བཞིན་མནའ་བསྐྱལ༌ཏེ། ཁྱོད་ཅག་གིས་སྨྲས་པའི་མི་དེ་ངས་ངོ་མི་ཤེས་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":72,"content":["དེ་མ་ཐག་བྱ་ཕོ་ཐེངས་གཉིས་པའང་གྲགས༌པས། པེ་ཏྲོས་དེ་སྔར་སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རང་ལ་བྱ་ཕོ་ཐེངས་གཉིས་མ་གྲགས་པའི་སྔོན༌དུ། ཁྱོད་ཀྱིས་ཐེངས་གསུམ་ལ་ང་རང་ཁས་མི་ལེན་ཞེས་པའི་གསུང་དེ་དྲན་ཞིང་བཟོད་གླགས་མེད་པར་ངུས༌སོ།།"]}],"footnotes":[{"noteId":11,"caller":"+","text":"ནཱར་དི་ཞེས་པའི་སྤོས་ཆུ་ནི་རྒྱ་གར་བྱང་ཕྱོགས་ཀྱི་རྩི་ཤིང་ཞིག་ནས་བྱུང་བའི་རིན་ཐང་ཆེ་བའི་སྤོས་ཆུ་ཡིན༌ལ། རྩི་ཤིང་དེའི་མིང་ཡང༌ཡིན།","reference":{"chapter":14,"verse":3}},{"noteId":12,"caller":"+","text":"པེ་སག་གི་ལུ་གུ་ཞེས་པ་ནི་པེ་སག་གི་དུས་ཆེན་ཉིན་ལ་བཤའ་བའི་ལུ་གུ་སྟེ་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་གོམས་སྲོལ༌ལ། སྔར་ཨེ་ཅིབ་ཡུལ་གྱི་བྲན་དུ་བཀོལ་བའི་གནས་ནས་ཐར་བའི་དྲན་གསོའི་དུས་ཆེན་གྱི་ཉིན་དང༌པོར། མི་གྲངས་བཅུ་ནས་ཉི་ཤུ་རེ་གྲལ་སྐོར་གཅིག་ཏུ་བྱས་ནས་ནག་ནོག་གི་ལྷད་མ་འདྲེས་པའི་ལུ་གུ་མཆོག་ཏུ་གྱུར་པ་བཤས༌ཏེ། ཁྲག་དང་ཚིལ་གཉིས་མཆོད་ཅིང་ཤ་ཟ་བ༌ཡིན། དེའི༌ཕྱིར། དྲན་གསོའི་དུས་ཆེན་གྱི་ཉིན་དང་པོར་བཤའ་བའི་ལུ་གུ་དེར་པེ་སག་གི་ལུ་གུ་ཞེས༌བྱ། འདིར་ཡང་སྒྲ་སྒྱུར་བྱས་པས་ཀློག་མཁན་རྣམས་ཀྱིས་དོན་རྣམས་མ་ལུས་པར་རྟོགས་པར༌སྨོན།(པེ་སག་ཅེས་པའི་མཆན་ལའང་གཟིགས་རོགས)","reference":{"chapter":14,"verse":12}}]},"thisChapterLink":"/api/bod_ntb/MRK/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/13.json","previousChapterAudioLinks":{},"numberOfVerses":72}