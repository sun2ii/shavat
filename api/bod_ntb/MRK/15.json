{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":15,"content":[{"type":"heading","content":["སྤྱི་དཔོན་པི་ལ་ཏུའི་མདུན་དུ་ཁྲིད༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ནམ་ལངས་མ་ཐག་མཆོད་དཔོན་ཆེན་པོ་རྣམས་དང་། རྒན་པོ་དང་མཁན་པོ་བཅས་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་ཐམས་ཅད་ཀྱིས་གྲོས་བྱས༌ཏེ། སྐྱབས་མགོན་ཡེ་ཤུ་བཀྱིགས་ནས་པི་ལ་ཏུ་ལ་སྤྲད༌ཅིང༌།"]},{"type":"verse","number":2,"content":["པི་ལ་ཏུ་ན༌རེ། ཁྱོད་ནི་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཡིན་ནམ་ཞེས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་དྲིས་པ༌ན། ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་སྨྲས་པ་བཞིན་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":3,"content":["མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་ཁོང་གི་དོན་མང་པོ་གཏུགས༌སོ།།"]},{"type":"verse","number":4,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། ལྟོས་དང་མི་དེ་རྣམས་ཀྱིས་ཁྱོད་ཀྱི་དོན་འདི་འདྲ་མང་པོ་གཏུག་གིན་འདུག༌ཨང༌། ཁྱོད་ཀྱིས་ལན་ཅི་ཡང་མི་འདེབས་སམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":5,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་བཀའ་ལན་ཅི་ཡང་མ་གསུངས་པས་པི་ལ་ཏུའང་ངོ་མཚར་བར་གྱུར༌ཏོ།།"]},{"type":"verse","number":6,"content":["པི་ལ་ཏུ་ལ་དུས་ཆེན་འདིར་ཁེལ་བའི་དུས༌སུ། ཁོ་རྣམས་ཀྱི་རེ་ཞུ་ལྟར་བཙོན་པ་ཞིག་བཙོན་གྲོལ་གཏོང་བའི་རྒྱུན་སྲོལ་ཡོད༌དོ།།"]},{"type":"verse","number":7,"content":["དེ་ཡང་པཱ་རབ་པཱ་ཞེས་པའི་བཙོན་པ་ཞིག་ཀྱང་ཟིང་འཁྲུག་སློང་མཁན་དང་མཉམ་དུ་བཀྱིགས་ཡོད༌ལ། དེ་དག་གིས་ཟིང་འཁྲུག་ཁྲོད་དུ་མི་ཡང་བསད་མྱོང་བ༌རེད།"]},{"type":"verse","number":8,"content":["དེ་ནས་མི་རྣམས་པི་ལ་ཏུའི་དྲུང་དུ་སོང་ནས་རྒྱུན་སྲོལ་བཞིན་མཛོད་ཅིག་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":9,"content":["པི་ལ་ཏུས་མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་ཕྲག་དོག་བྱས་ནས་ཁོ་རང་ལ་སྤྲད་པ་ཤེས་ཏེ་ན༌རེ། ཁྱོད་རྣམས་ཀྱིས་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་འདི་ཉིད་བཙོན་གྲོལ་གཏོང་འདོད་དམ་ཞེས་དྲིས༌སོ།།"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་མཆོད་དཔོན་ཆེན་པོ་རྣམས་ཀྱིས་མི་ཚོགས་ལ་པཱ་རབ་པཱ་བཏང་ན་ལེགས་ཞེས་ཞུ་བར་ནན་གྱིས༌བསྐུལ།"]},{"type":"verse","number":12,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། འོ་ན་ཁྱོད་ཅག་གིས་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཟེར་བ་འདིར་བདག་གིས་ཅི་བྱ་འོས་སམ་ཞེས་སྨྲས་པ༌ན།"]},{"type":"verse","number":13,"content":["དེ་དག་གིས་སླར་ཡང་སྐད་གསང་མཐོན་པོས་ཁོ་རང་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་རྡོབས་ཤིག་ཅེས་བསྒྲགས༌སོ།།"]},{"type":"verse","number":14,"content":["ཡང་པི་ལ་ཏུ་ན༌རེ། རྒྱུ་མཚན་ཅིའི་ཕྱིར༌རམ། ཁོས་དོན་ངན་ཅི་བྱས་སམ་ཞེས་སྨྲས༌ནའང༌། དེ་དག་གིས་སྔར་ལས་སྐད་ཆེན་པོས་ཁོ་རང་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་རྡོབས་ཤིག་ཅེས་འུར་བརྒྱབ༌བོ།།"]},{"type":"verse","number":15,"content":["པི་ལ་ཏུས་མི་ཚོགས་དགའ་བར་འཇུག་འདོད་དེ་པཱ་རབ་པཱ་བཏང་ནས་ཁོ་རྣམས་ལ་སྤྲད༌ཅིང༌། སྐྱབས་མགོན་ཡེ་ཤུར་རྟ་ལྕག་གིས་གཞུས་ཏེ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབ་ཕྱིར་དམག་མི་རྣམས་ལ་སྤྲད༌དོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ལ་འཕྱ་དམོད་བྱས༌པ།"]},{"type":"verse","number":16,"content":["དེ་ནས་དམག་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་སྤྱི་དཔོན་གྱི་ཕོ་བྲང་གི་ར་སྐོར་དུ་ཁྲིད་ནས་རང་གི་དམག་དཔུང་ཐམས་ཅད་བསྡུས༌ཤིང༌།"]},{"type":"verse","number":17,"content":["དེ་དག་གིས་ཁོང་གི་ལུས་ལ་ན་བཟའ་མདོག་རྒྱ་སྨུག་ཅན་ཞིག་བསྐོན་པ་དང་ཚེར་མས་ཅོད་པན་བསླེས་ཏེ་ཁོང་གི་དབུ་ལ་བསྐོན་ནས།"]},{"type":"verse","number":18,"content":["ཁོང་ལ་རྟེན་འབྲེལ་ཞུ་བའི་ཟོལ་གྱིས་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཁྱོད་ལ་རྟེན་འབྲེལ་ཞུ་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":19,"content":["ཡང་ཁོང་གི་དབུ་ལ་དབྱུག་པ་ཕྲ་མོས་བརྡེག་ཅིང་གདོང་ལ་མཆིལ་མ༌བཏབ། པུས་མོ་སར་བཙུགས་ཏེ་ཁོང་ལ་ཕྱག་འཚལ་ཁུལ་བྱས༌སོ།།"]},{"type":"verse","number":20,"content":["དེ་ལྟར་ཁོང་ལ་བརྙས་བཅོས་བྱས་ཚར༌རྗེས། ཁ་དོག་རྒྱ་སྨུག་ཡིན་པའི་ན་བཟའ་ཕུད་ཅིང་ཁོང་ལ་རང་ཉིད་ཀྱི་ན་བཟའ་བསྐོན༌ཏེ། ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབ་ཆེད་ཕྱི་རོལ་ཏུ་ཁྲིད༌དོ།།"]},{"type":"heading","content":["ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས༌པ།"]},{"type":"verse","number":21,"content":["དེའི་དུས༌སུ། ཨ་ལིག་སན་དིར་དང་རུ་ཕུ་སྤུན་གཉིས་ཀྱི་ཕ་སྟེ་སི་མོན་ནི་ཀི་རེ་ནེ་ཡི་མི་ཡིན༌ལ། ཁོ་རང་གྲོང་གསེབ་ནས་ཡོང་ཞིང་གནས་འདི་བརྒྱུད་ནས་འགྲོ་བ༌ན། དེ་དག་གིས་ཁོ་ལ་བཙན་གྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་ཤིང་རྒྱ་གྲམ་འཁུར་དུ༌བཅུག"]},{"type":"verse","number":22,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཁྲིད་ནས་གོལ་གོ་ཐཱ༌སྟེ། དོན་ལ་མགོ་སྐོགས་གནས་ཞེས་པའི་ས་ཆར་སླེབས་པ༌དང༌།"]},{"type":"verse","number":23,"content":["དེ་དག་གིས་སྐྱབས་མགོན་ཡེ་ཤུར་གུ་གུལ་འདྲེས་པའི་རྒུན་ཆང་དྲངས་ནའང་ཁོང་གིས་མ་བཞེས་པ༌རེད།"]},{"type":"verse","number":24,"content":["དེ་ནས་དམག་མི་རྣམས་ཀྱིས་ཁོང་ཉིད་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས༌ཤིང༌། ཁོང་གི་ན་བཟའ་བགོ་བཤའ་བྱས་ནས་རྒྱན་འཕངས་པ་དང་མི་རེ་རེར་གང་ཐོབ་པར་བལྟས༌སོ།།"]},{"type":"verse","number":25,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པའི་དུས་ནི་ཞོགས་པའི་ཆུ་ཚོད་དགུ་",{"noteId":13},"ཡིན༌ནོ།།"]},{"type":"verse","number":26,"content":["ཁོང་ལ་བཏགས་པའི་ཉེས་སྐྱོན་ནི་ཤིང་བྱང་ཞིག་གི་ངོས་སུ་ཡ་ཧུ་དཱ་པའི་རྒྱལ་པོ་ཡིན་ཞེས་བྲིས་ཡོད་པ༌དེའོ།།"]},{"type":"verse","number":27,"content":["ཁོང་དང་ལྷན་ཅིག་ཇག་པ་གཉིས་ཀྱང་ཁོང་གི་གཡས་གཡོན་དུ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་ཡོད༌ཅིང༌།"]},{"type":"verse","number":28,"content":["དེ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་ཁོང་ཉེས་ཅན་གྱི་གྲས་སུ་བརྩིས་ཡོད་ཅེས་གསུངས་པ་བཞིན་དུ་གྲུབ་པ་ཡིན༌ནོ།།"]},{"type":"verse","number":29,"content":["གནས་དེར་བརྒྱུད་ནས་འགྲོ་བ་རྣམས་ཀྱིས་ཁོང་ལ་འཕྱ་སྨོད་བྱས་ཤིང་མགོ་བོ་གཡུག༌བཞིན། ཀྱེ། མཆོད་ཁང་བཤིགས་ནས་ཉིན་གསུམ་གྱི་ནང་དུ་སླར་རྩིག་མཁན་ཁྱོད་ཀྱིས་རང་ཉིད་སྐྱོབས༌དང༌། ཤིང་རྒྱ་གྲམ་སྟེང་ནས་མར་བོབས་ཤིག་ཅེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":31,"content":["དེ་བཞིན་མཆོད་དཔོན་ཆེན་པོ་དག་དང་མཁན་པོ་རྣམས་ཀྱིས་ཀྱང་མཉམ་དུ་ཁོང་ལ་འཕྱ་དམོད་བྱེད་ཀྱིན་ཁོས་གཞན་རྣམས་བསྐྱབས་མྱོང་ནའང་རང་ཉིད་སྐྱོབ་མི་ནུས་ཞེས་ཕན་ཚུན་གླེང་བ༌དང༌།"]},{"type":"verse","number":32,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་མཱ་ཤི༌ཀ ད་ལྟ་ཤིང་རྒྱ་གྲམ་སྟེང་ནས་མར་བོབས༌དང༌། ངེད་ཅག་གིས་དོན་དེ་མཐོང་ན་དད་པ་བྱེད་ཅེས་སྨྲས༌སོ། །ཁོང་དང་མཉམ་དུ་ཤིང་རྒྱ་གྲམ་ལ་བརྡབས་ཡོད་པ་དེ་གཉིས་ཀྱིས་ཀྱང་ཁོང་ལ་དེ་ལྟར་སྨད༌དོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་གྲོངས༌པ།"]},{"type":"verse","number":33,"content":["དེར་ཉིན་གུང་",{"noteId":14},"ནས་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་པའི་བར་དུ་ཡུལ་དེ་ཡོངས་སུ་མུན་ནག་འཐིབས༌ཤིང༌།"]},{"type":"verse","number":34,"content":["ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་གྱི་སྟེང་སྐྱབས་མགོན་ཡེ་ཤུས་གསུང་སྐད་ཆེན༌པོས། ཨེ་ལོ༌ཨི། ཨེ་ལོ༌ཨི། ལཱ་མཱ་སཱ་པཱག་ཐཱ་ནེ་ཞེས་གསུངས༌ཤིང༌། དོན་ནི་འདི་ལྟ༌སྟེ། ཀྱེ། བདག་གི་དཀོན་མཆོག༌ལགས། བདག་གི་དཀོན་མཆོག༌ལགས། ཁྱེད་ཀྱིས་ང་རང་རྒྱབ་ཏུ་བསྐྱུར་དོན་ཅི་ཞེས༌པའོ།།"]},{"type":"verse","number":35,"content":["ཉེ་འགྲམ་དུ་འགྲེངས་ནས་བསྡད་ཡོད་པའི་མི་འགའ་ཞིག་གིས་གསུང་དེ་ཐོས༌རྗེས། ལྟོས༌དང༌། ཁོས་ཨེ་ལི་ཡཱ་འབོད་ཀྱིན་འདུག་ཅེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":36,"content":["ཡང་མི་ཞིག་བརྒྱུགས་སོང་ནས་འགྱིག་སོབ་ཅིག་རྒུན་ཆང་སྐྱུར་མོར་སྦངས༌ཏེ། འདམ་རྩྭའི་རྩེར་བཀལ་ནས་ཁོང་ལ་འདྲེན་བཞིན་པའི་དུས༌སུ། ཅུང་ཙམ་སྒུགས༌དང༌། ཨེ་ལི་ཡཱ་ཡོང་སྟེ་ཁོང་ཉིད་ཤིང་རྒྱ་གྲམ་སྟེང་ནས་ལེན་མིན་ལ་བལྟའོ་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":37,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་སྐད་ཆེན་པོས་འབོད་སྒྲ་ཞིག་བསྒྲགས་པ་དང་སྐུ་དབུགས་ཆད་པར་གྱུར༌ཏོ།།"]},{"type":"verse","number":38,"content":["མཆོད་ཁང་གི་ཡོལ་བ་ཆེན་པོ་དེ་ཡང་གོང་ནས་འོག་ཏུ་དུམ་བུ་གཉིས་སུ་རལ་བར་གྱུར༌ཏོ།།"]},{"type":"verse","number":39,"content":["ཁ་གཏད་དུ་འགྲེངས་ནས་བསྡད་ཡོད་པའི་བརྒྱ་དཔོན་གྱིས་ཁོང་གི་སྐུ་དབུགས་དེ་ལྟར་ཆད་པ་མཐོང༌སྟེ། སྐྱེས་བུ་འདི་ནི་དཀོན་མཆོག་གི་སྲས་ཡིན་པ་བདེན་འདུག་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":40,"content":["རྒྱང་རིང་ནས་ལྟ་བཞིན་པའི་བུད་མེད་རྣམས་ཀྱི་ཁྲོད་དུ་མཱག་རྡལ་གྱི་མིར་ཡམ༌དང༌། ཡ་ཀོབ་ཆུང་བ་དང་ཡོ་སེ་གཉིས་ཀྱི་མ་མིར་ཡམ་དེ༌དང༌། སཱ་ལོ་མེ་བཅས་ཀྱང༌ཡོད།"]},{"type":"verse","number":41,"content":["དེ་རྣམས་ནི་སྐྱབས་མགོན་ཡེ་ཤུ་ཁོང་ཉིད་ག་ལིལ་ཡུལ་དུ་བཞུགས་པའི་དུས་སུ་ཁོང་གི་རྗེས་འབྲངས་ནས་ཞབས་ཕྱི་བསྒྲུབས་མྱོང་བ་རྣམས༌ཡིན། གཞན་ཡང་སྐྱབས་མགོན་ཡེ་ཤུ་དང་མཉམ་དུ་ཡར་ཡེ་རུ་སཱ་ལེམ་ལ་འོངས་པའི་བུད་མེད་གཞན་མང་པོའང་གནས་འདིར་མཆིས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་དུར་དུ་སྦས༌པ།"]},{"type":"verse","number":42,"content":["མཚན་མོར་སླེབས་ཤིང་ཉིན་དེ་ནི་སྟ་གོན་གྱི་ཉིན་མོ་",{"noteId":15},"སྟེ། ངལ་གསོ་བའི་ཉིན་གྱི་ཉིན་སྔ་མ་ཡིན༌པས།"]},{"type":"verse","number":43,"content":["བཀུར་འོས་པའི་དཔོན་རིགས་ཚོགས་པའི་ཚོགས་མི་སྟེ་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ལ་སྒུག་མཁན་ཨ་རི་མ་ཐཱ་ཡི་ཡོ་སེབ་ཡོང༌ནས། སྤོབས་པ་ཆེར་བསྐྱེད་དེ་པི་ལ་ཏུའི་དྲུང་དུ་སོང་ཞིང་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་གནང་བར་ཞུ་བ་ཞུས་པ༌ལ།"]},{"type":"verse","number":44,"content":["པི་ལ་ཏུས་སྐྱབས་མགོན་ཡེ་ཤུ་སྐུ་གྲོངས་པའི་གཏམ་ཐོས་ནས་ཡ་མཚན་སྐྱེས་ཤིང་བརྒྱ་དཔོན་བོས༌ཏེ། ཁོང་གྲོངས་སམ་མ་གྲོངས་ཞེས་དྲིས་པ༌དང༌།"]},{"type":"verse","number":45,"content":["པི་ལ་ཏུས་བརྒྱ་དཔོན་ལས་དོན་འདི་རྩད་ཆོད་རྗེས་ཁོང་གི་སྐུ་གདུང་ཡོ་སེབ་ལ་གནང༌ངོ༌།།"]},{"type":"verse","number":46,"content":["དེ་ནས་ཡོ་སེབ་ཀྱིས་སོ་རས་ཞིག་ཉོས་ཤིང་ཁོང་གི་སྐུ་གདུང་ཤིང་རྒྱ་གྲམ་སྟེང་ནས་མར་བླངས་ཏེ་སོ་རས་ཀྱིས་དཀྲིས༌རྗེས། བྲག་ནང་དུ་བརྐོས་པའི་དུར་ཁུང་ཞིག་གི་ནང་དུ་སྦས་ཤིང་རྡོ་ཕ་བོང་ཞིག་བསྒྲིལ་ཡོང་ནས་དུར་ཁུང་གི་སྒོ་བཅད༌དོ།།"]},{"type":"verse","number":47,"content":["མཱག་རྡལ་གྱི་མིར་ཡམ་དང་ཡོ་སེ་བྱ་བའི་མ་མིར་ཡམ་གཉིས་ཀྱིས་ཀྱང་སྐུ་གདུང་གང་དུ་བཞག་པའི་གནས་མཐོང༌ངོ༌།།"]}],"footnotes":[{"noteId":13,"caller":"+","text":"དམ་པའི་གསུང་རབ་ཀྱི་མ་ཕྱི་དག༌ལས། སྐྱབས་མགོན་ཡེ་ཤུ་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པའི་དུས་ནི་ཆུ་ཚོད་གསུམ་ཡིན་ཞེས་གསུངས་འདུག༌ཀྱང༌། སྐབས་འདིིའི་ཆུ་ཚོད་གསུམ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་བརྩི་སྲོལ་ལྟར༌ཡིན། ད་ལྟའི་བརྩི་སྲོལ་ལྟར་ན་ཞོགས་པའི་ཆུ་ཚོད་དགུ་ཡིན་པས་དོན་སྒྱུར་བྱས་པ༌ཡིན།","reference":{"chapter":15,"verse":25}},{"noteId":14,"caller":"+","text":"འདིར་བརྗོད་པའི་ཉིན་གུང་དང་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་ཞེས་པ་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་བརྩི་སྲོལ་ཏེ་མ་ཕྱི་དག་ལས་ཆུ་ཚོད་དྲུག་དང་ཆུ་ཚོད་དགུ་ཞེས༌འབྱུང༌། ད་ལྟའི་བརྩི་སྲོལ་ལྟར་ན་ཉིན་གུང་གི་ཆུ་ཚོད་བཅུ་གཉིས་ནས་ཕྱི་དྲོའི་ཆུ་ཚོད་གསུམ་བར༌ཡིན།","reference":{"chapter":15,"verse":33}},{"noteId":15,"caller":"+","text":"སྟ་གོན་གྱི་ཉིན་མོ་ཞེས་པ་ནི་གཟའ་པ་སངས་ཉིན་ལ་གོ་ཞིང་པེ་སག་དུས་ཆེན་གྱི་ངལ་གསོ་བའི་ཉིན་ནི་གཟའ་སྤེན་པའི་ཉིན་ལ༌གོ དེ་ནི་གནའ་བོའི་ཡ་ཧུ་དཱའི་མི་རིགས་ཀྱི་གོམས་སྲོལ༌ཡིན།","reference":{"chapter":15,"verse":42}}]},"thisChapterLink":"/api/bod_ntb/MRK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/14.json","previousChapterAudioLinks":{},"numberOfVerses":45}