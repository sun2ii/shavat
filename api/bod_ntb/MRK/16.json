{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":16,"content":[{"type":"heading","content":["སྐུ་གྲོངས་ནས་སླར་གསོན༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ངལ་གསོ་བའི་ཉིན་རྫོགས༌རྗེས། མཱག་རྡལ་གྱི་མིར་ཡམ༌དང༌། ཡ་ཀོབ་ཀྱི་མ་མིར༌ཡམ། སཱ་ལོ་མེ་བཅས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་གདུང་ལ་བྱུག་བྱའི་བསུང་རྫས་ཉོས་པ༌དང༌།"]},{"type":"verse","number":2,"content":["གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོའི་ཞོགས་པར་ཉི་མ་ཤར་བའི་དུས་སུ་ཁོ་མོ་ཚོ་དུར་ཁུང་གི་གམ་དུ་སླེབས༌ཤིང༌།"]},{"type":"verse","number":3,"content":["ལམ་བར་དུ་ཕན་ཚུན་ལ་དུར་ཁུང་གི་སྒོ་ཁར་ཡོད་པའི་རྡོ་ཕ་བོང་དེ་སུ་ཞིག་གིས་ངེད་ཅག་གི་ཆེད་དུ་ཕར་བསྒྲིལ་བར་བྱའམ་ཞེས་སྨྲས༌ཤིང༌།"]},{"type":"verse","number":4,"content":["ཁོ་མོ་དག་གིས་མགོ་ཡར་དགྱེ་ནས་བལྟས་པ༌ན། རྡོ་ཕ་བོང་དེ་ནི་དངོས་གནས་ཤིན་ཏུ་ཆེན་པོ་ཞིག་ཡིན་ཡང་སྔར་ནས་ཕར་བསྒྲིལ་ཟིན་པ་མཐོང༌ངོ༌།།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཁོ་མོ་ཚོ་དུར་ཁུང་ནང་དུ་འཛུལ་བ་དང་ལྭ་རིང་དཀར་པོ་གྱོན་པའི་ན་གཞོན་ཞིག་",{"noteId":16},"ཁོ་མོ་ཚོའི་གཡས་ཕྱོགས་སུ་བཞུགས་ཡོད་པ་མཐོང་ནས་ཤིན་ཏུ་འཇིགས༌སོ།།"]},{"type":"verse","number":6,"content":["ན་གཞོན་དེ་ན༌རེ། ཁྱོད་རྣམས་འཇིགས་མི༌དགོས། ཁྱོད་ཅག་ནི་ཤིང་རྒྱ་གྲམ་གྱི་སྟེང་དུ་བརྡབས་པའི་ནཱ་ཙ་རེལ་པ་ཡེ་ཤུ་འཚོལ་དུ་ཡོང་བ་ཡིན༌ཏེ། ཁོང་གི་སྐུ་གདུང་བཞུགས་སའི་གནས་དེར་ལྟོས་དང་ཁོང་ཉིད་སླར་གསོན་པས་གནས་འདིར་མི༌བཞུགས།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཅག་ཕྱིར་སོང་ནས་ཁོང་གི་ཐུགས་སྲས་རྣམས་དང་པེ་ཏྲོ་ལ་འདི་སྐད་ཤོད༌ཅིག དེ་སྔར་ཁོང་གིས་ཁྱོད་རྣམས་ལ་གསུངས་པ་བཞིན་ཁོང་ཉིད་ཁྱོད་ཅག་གི་སྔོན་ལ་ག་ལིལ་ཡུལ་དུ་ཕེབས༌ཤིང༌། གནས་དེ་རུ་ཁྱོད་ཅག་ཁོང་དང་མཇལ་བར་ངེས་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":8,"content":["ཁོ་མོ་ཚོ་དུར་ཁུང་ལས་ཕྱིར་བུད་མ་ཐག་འདར་ཞིང་ཧ་ལས་ནས་བྲོས༌པས། གཏམ་དེ་མི་གཞན་སུ་ལའང་སྨྲ་བར་མ་སྤོབས༌སོ།།"]},{"type":"verse","number":9,"content":["གཟའ་འཁོར་གཅིག་གི་ཉིན་དང་པོའི་ཞོགས༌པར། སྐྱབས་མགོན་ཡེ་ཤུ་སླར་གསོན་པ༌དང༌། དེ་སྔར་ཁོང་གིས་གདོན་འདྲེ་བདུན་བསྐྲད་མྱོང་བའི་མཱག་རྡལ་གྱི་མིར་ཡམ་ལ་ཐོག་མར་སྐུ་གཟུགས་མངོན་སུམ་དུ་བསྟན༌པས།"]},{"type":"verse","number":10,"content":["ཁོ་མོ་སྔར་ནས་སྐྱབས་མགོན་ཡེ་ཤུའི་རྗེས་སུ་འབྲངས་པ་རྣམས་ཀྱི་དྲུང་དུ་སོང་ཞིང་དེ་རྣམས་ཀྱིས་མྱ་ངན་བྱེད་བཞིན་ཡོད་པར་དོན་དེ་སྨྲས༌ནའང༌།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་སྐྱབས་མགོན་ཡེ་ཤུ་གསོན་པོར་བཞུགས་པ་དང་མིར་ཡམ་གྱིས་མཐོང་བ་ཡིན་ཞེས་པའི་གཏམ་ལ་ཡིད་མ་ཆེས༌སོ།།"]},{"type":"verse","number":12,"content":["དེའི་རྗེས༌སུ། རྗེས་འབྲང་པ་རྣམས་ལས་མི་གཉིས་གྲོང་གསེབ་ལ་འགྲོ་བའི་ལམ་བར༌དུ། སྐྱབས་མགོན་ཡེ་ཤུས་རང་གི་སྐུ་གཟུགས་རྣམ་པ་གཞན་པའི་ལམ་ནས་ཁོ་གཉིས་ལ་མངོན་སུམ་དུ་བསྟན༌ཏོ།།"]},{"type":"verse","number":13,"content":["ཁོ་གཉིས་ཕྱིར་ལོག་ནས་རྗེས་འབྲང་པ་གཞན་རྣམས་ལ་གནས་ཚུལ་དེ་སྨྲས་ནའང་སུས་ཀྱང་ཁོ་གཉིས་ལ་ཡིད་མ་ཆེས༌སོ།།"]},{"type":"heading","content":["འཕྲིན་བཟང་སྒྲོག་པའི་བཀའ་བསྩལ༌པ།"]},{"type":"verse","number":14,"content":["དོན་དེའི་རྗེས༌སུ། ཐུགས་སྲས་བཅུ་གཅིག་པོས་ཟས་བཞེས་ནས་སྡོད་པའི་དུས༌སུའང༌། སྐྱབས་མགོན་ཡེ་ཤུས་དེ་རྣམས་ལ་རང་གི་སྐུ་གཟུགས་མངོན་སུམ་དུ་བསྟན༌ཏེ། ཁོང་ཉིད་སླར་གསོན་རྗེས་ཁོང་ཉིད་མཐོང་མཁན་རྣམས་ཀྱིས་སྨྲས་པའི་གཏམ་ལ་ཁོ་རྣམས་ཡིད་མ་ཆེས༌པས། ཁོང་གིས་དེ་རྣམས་ལ་དད་པ་མེད་པ་དང་སེམས་གྱོང་པོ་ཡིན་པར་བཀའ་བཀྱོན་མཛད༌དོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གནམ་འོག་ཀུན་ཏུ་སོང་ནས་མི་ཐམས་ཅད་ལ་འཕྲིན་བཟང་སྒྲོགས༌ཤིག"]},{"type":"verse","number":16,"content":["སུ་ཞིག་གིས་དད་པ་བྱས་ནས་ཁྲུས་གསོལ་ལ་འཇུག་པ་དེ་ལ་ཐར་པ་འཐོབ་པར་འགྱུར་ཞིང་དད་པ་མེད་པ་དེ་ལ་ཉེས་ཆད་གཅོད་པར་འགྱུར༌རོ།།"]},{"type":"verse","number":17,"content":["དད་པ་དང་ལྡན་པའི་མི་རྣམས་དང་ལྷན་ཅིག་ངོ་མཚར་བའི་རྟགས་འདི་རྣམས་འབྱུང་ངེས༌ཤིང༌། ངའི་མིང་ལ་བརྟེན་ནས་དེ་དག་གིས་གདོན་འདྲེ་ཕར་སྐྲོད་པ་དང་སྐད་རིགས་གསར་པ་སྨྲ༌བ།"]},{"type":"verse","number":18,"content":["དུག་སྦྲུལ་ལག་པས་འཛིན་ནུས༌པ། དུག་འཐུང་ནའང་སྲོག་ལ་མི་གནོད༌པ། ལག་པ་ནད་པའི་སྟེང་དུ་བཞག་ན་ནད་གཞོམ་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་བཀའ་གནང་ཚར༌རྗེས། ཁོང་ཉིད་ནམ་མཁའི་ཞིང་ཁམས་སུ་དྲངས་ཤིང་དཀོན་མཆོག་གི་གཡས་ཕྱོགས་སུ་བཞུགས༌སོ།།"]},{"type":"verse","number":20,"content":["ཐུགས་སྲས་རྣམས་ཀྱང་ཡུལ་ཕྱོགས་ཀུན་ཏུ་སོང་ནས་འཕྲིན་བཟང་བསྒྲགས༌ཤིང༌། གཙོ་བོས་ཀྱང་ཁོ་རྣམས་དང་མཉམ་དུ་འཕྲིན་ལས་མཛད་པ་དང་ངོ་མཚར་བའི་རྟགས་དང་ཆབས་ཅིག་བཀའ་དེ་ལ་བདེན་དཔང་མཛད༌དོ།། །།"]}],"footnotes":[{"noteId":16,"caller":"+","text":"སྐབས་འདིའི་ལྭ་རིང་དཀར་པོ་གྱོན་པའི་ན་གཞོན་ཞིག་ཅེས་པ་ལ་དམ་པའི་གསུང་རབ་ཀྱི་འཕྲིན་བཟང་གཞན་ལས་དཀོན་མཆོག་གིས་མངགས་པའི་ཕོ་ཉ་ཡིན་པར༌གསུངས།","reference":{"chapter":16,"verse":5}}]},"thisChapterLink":"/api/bod_ntb/MRK/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/LUK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/15.json","previousChapterAudioLinks":{},"numberOfVerses":20}