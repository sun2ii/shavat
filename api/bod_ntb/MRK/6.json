{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":6,"content":[{"type":"heading","content":["ཡུལ་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་བརྩི་བཀུར་མ་བྱས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ས་ཆ་དེ་དང་ཁ་བྲལ་ནས་རང་ཡུལ་དུ་ཕེབས་པ་དང་ཐུགས་སྲས་རྣམས་ཀྱང་ཁོང་གི་རྗེས་སུ་འབྲངས༌སོ།།"]},{"type":"verse","number":2,"content":["ངལ་གསོ་བའི་ཉིན༌ལ། སྐྱབས་མགོན་ཡེ་ཤུས་ཆོས་ཁང་ནས་མི་རྣམས་ལ་ཆོས་གསུངས་པ་དང་ཉན་མཁན་མང་པོས་ཆོས་ཐོས་ཤིང་ཧ་ལས༌ཏེ། མི་འདིར་ནུས་པ་དེ་ལྟ་བུ་རྣམས་གང་ནས་བྱུང་བ་ཡིན༌ནམ། ཁོང་ལ་གནང་ཡོད་པའི་ཤེས་རབ་ནི་ཅི་ཞིག་ཡིན༌ནམ། ཁོང་གི་ཕྱག་གིས་མཛད་པ་དེ་ནི་ཅི་འདྲའི་ངོ་མཚར་ཆེ༌ཨང༌།"]},{"type":"verse","number":3,"content":["མི་འདི་ནི་ཤིང་བཟོ་དེ་མ་ཡིན༌ནམ། ཁོ་རང་ནི་མིར་ཡམ་གྱི་བུ་སྟེ་ཡ་ཀོབ༌དང༌། ཡོ༌སེ། ཡུ༌དཱ། སི་མོན་བཅས་ཀྱི་གཅེན་པོ་མ་ཡིན༌ནམ། ཁོའི་སྲིང་མོ་རྣམས་ཀྱང་ཡུལ་འདི་རུ་བདག་ཅག་དང་མཉམ་དུ་ཡོད་པ་མ་ཡིན་ནམ་ཞེས་ཟེར༌ཞིང༌། མི་དེ་རྣམས་ཁོང་ལ་མི་དགའ་བར་གྱུར༌ཏོ།།"]},{"type":"verse","number":4,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ལུང་སྟོན་པ་ལ་རང་ཡུལ་གྱི་མི༌དང༌། གཉེན༌ཉེ། ཁྱིམ་མི་ལས་གཞན་བརྩི་བཀུར་མི་བྱེད་མཁན་གཅིག་ཀྱང་མེད་ཅེས༌གསུངས།"]},{"type":"verse","number":5,"content":["ཁོང་གིས་ནད་པ་ཁ་ཤས་ཀྱི་ལུས་སྟེང་ལ་ཕྱག་བཞག་སྟེ་ནད་འཇོམས་པ་ལས་ངོ་མཚར་བའི་དོན་གཞན་མཛད་མ༌ནུས།"]},{"type":"verse","number":6,"content":["མི་དེ་རྣམས་ལ་དད་པ་མེད་པས་ཁོང་ཡང་ཡ་མཚན་སྐྱེས་ཤིང་མཐའ་འཁོར་གྱི་ཡུལ་སྡེ་དག་ལ་ཆོས་གསུང་བར་ཕེབས༌སོ།།"]},{"type":"heading","content":["ཐུགས་སྲས་བཅུ་གཉིས་པོ་ཡུལ་གཞན་དུ་མངགས༌པ།"]},{"type":"verse","number":7,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་བཅུ་གཉིས་པོ་རང་གི་དྲུང་དུ་བོས༌ཏེ། ཁོ་རྣམས་ལ་གདོན་འདྲེ་འདུལ་བའི་དབང་གནང་བ་དང་མི་གཉིས་རེ་གཉིས་རེ་ཕྱི་རུ་མངགས༌ཤིང༌།"]},{"type":"verse","number":8,"content":["ལམ་དུ་ཆས་སྐབས་མཁར་བ་ལས་གཞན་ལམ་བྲོ་དང་ཁུག༌མ། སྒོར་ཁུག་ནང་དངུལ་སྒོར་སོགས་ཅི་ཡང་མ་འཁྱེར༌ཅིག"]},{"type":"verse","number":9,"content":["རྐང་པར་བསིལ་ལྷམ་གྱོན་པ༌ལས། ནང་གོས་ཉིས་བརྩེགས་མ་གྱོན་ཅིག་ཅེས་བཀའ་བསྒོས་པ༌དང༌།"]},{"type":"verse","number":10,"content":["ཡང་ཁྱོད་རྣམས་ཡུལ་གང་དུ་སླེབས་ནའང་མིའི་ཁྱིམ་དུ་སོང༌རྗེས། ས་ཆ་དེ་དང་ཁ་འབྲལ་བའི་བར་དུ་ཁྱིམ་དེར་སྡོད༌དང༌།"]},{"type":"verse","number":11,"content":["ཡུལ་གང་གི་མི་ཡིས་ཁྱོད་རྣམས་ལ་གནས་ཚང་མི་གཏོང་ཞིང་ཁྱོད་ཅག་ལ་མི་ཉན༌ན། ཁྱོད་རྣམས་ས་ཆ་དེ་དང་འབྲལ་བའི་དུས༌སུ། ཁོ་རྣམས་མི་འགྲིག་པ་སྟོན་པའི་ཆེད་དུ་རྐང་པའི་སྟེང་གི་ས་རྡུལ་སྤྲུགས་ཤིག་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":12,"content":["ཐུགས་སྲས་རྣམས་ཕྱི་རོལ་ཏུ་སོང་ནས་མི་རྣམས་ལ་འགྱོད་བཤགས་བྱེད་དགོས་པའི་ཆོས་བསྒྲགས༌ཤིང༌།"]},{"type":"verse","number":13,"content":["གདོན་འདྲེ་མང་པོ་ཕྱིར་བསྐྲད་པ་དང་ནད་པ་མང་པོར་སྣུམ་གྱིས་བྱུགས་ཏེ་ནད་ལས་ཐར་དུ་བཅུག༌གོ།"]},{"type":"heading","content":["ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་བཀྲོངས༌པ།"]},{"type":"verse","number":14,"content":["སྐྱབས་མགོན་ཡེ་ཤུའི་མཚན་སྙན་ཡུལ་གྲུ་ཀུན་ཏུ་ཁྱབ་པ་དང་རྒྱལ་པོ་ཧེ་རོ་དཱས་ཀྱང་གཏམ་དེ་ཐོས༌སོ། །མི་གཞན་གྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ནི་ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་འཆི་བ་ལས་སླར་གསོན་པ་ཡིན་པས་ཁོང་གིས་ནུས་མཐུ་འདི་དག་སྟོན་བཞིན་འདུག་ཅེས་སྨྲས༌ཤིང༌།"]},{"type":"verse","number":15,"content":["མི་ལ་ལས་ཁོང་ནི་ཨེ་ལི་ཡཱ་ཡིན་ཟེར་བ༌དང༌། མི་ཁ་ཤས་ཀྱིས་ཁོང་ནི་ལུང་སྟོན་པ་ཞིག༌སྟེ། གནའ་བོའི་ལུང་སྟོན་པའི་ཁྲོད་ཀྱི་གཅིག་དང་མཚུངས་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":16,"content":["འོན་ཀྱང་ཧེ་རོ་དཱས་གཏམ་དེ་དག་ཐོས་པ༌ན། དེ་ནི་ངས་མགོ་བོ་བཅད་པའི་ཡོ་ཧ་ནན་དེ་ཉིད་སླར་གསོན་པ་རེད་ཅེས་སྨྲས༌སོ།།"]},{"type":"verse","number":17,"content":["དེ་ཡང་སྔོན་ཆད་ཧེ་རོ་ཡཱ་ཟེར་བ་ཞིག་ཡོད་པ་དེའི་རྐྱེན༌གྱིས། ཧེ་རོ་དཱས་མི་མངགས་ནས་ཡོ་ཧ་ནན་བཟུང་སྟེ་བཙོན་དུ་བཅུག་པ༌རེད། རྒྱུ་མཚན་ཅི་ཞེ༌ན། ཧེ་རོ་ཡཱ་ནི་ཧེ་རོ་དཱའི་སྤུན་ཕི་ལིབ་ཀྱི་ཆུང་མ་ཡིན་ཡང་ཧེ་རོ་དཱས་རང་གི་ཆུང་མར་བླངས༌པས།"]},{"type":"verse","number":18,"content":["ཡོ་ཧ་ནན་གྱིས་དེ་སྔར་ཧེ་རོ་དཱ་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱིས་རང་གི་སྤུན་གྱི་ཆུང་མ་རང་ལ་ལེན་མི་རུང་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་བས་ཧེ་རོ་ཡཱས་ཡོ་ཧ་ནན་འཁོན་དུ་བཟུང་ནས་དགྲོང་བར་འདོད་ནའང་དགྲོང་མ༌ནུས།"]},{"type":"verse","number":20,"content":["རྒྱུ་མཚན་ནི་ཧེ་རོ་དཱས་ཡོ་ཧ་ནན་ནི་གཞུང་རྒྱུད་དྲང་ཞིང་སྐྱེས་བུ་དམ་པ་ཞིག་ཡིན་པ་ཤེས་པས་ཁོང་ལ་འཇིགས་ཤིང་ཁོང་གནོད་པ་ལས༌བསྲུངས། ཁོས་ཡོ་ཧ་ནན་གྱི་བསླབ་བྱ་ལ་ཉན་དུས་མགོ་འཐོམས་ནའང་ཉན་པར༌དགའོ།།"]},{"type":"verse","number":21,"content":["སྟབས་འགྲིག་པའི་ཉིན༌ཞིག་ལ། ཧེ་རོ་དཱས་རང་གི་སྐྱེས་སྐར་ལ་བློན་ཆེན༌དང༌། དམག༌དཔོན། ག་ལིལ་ཡུལ་གྱི་འགོ་དཔོན་རྣམས་མགྲོན་དུ་བོས་ཏེ་དགའ་སྟོན་བཤམས༌ཤིང༌།"]},{"type":"verse","number":22,"content":["ཧེ་རོ་ཡཱའི་བུ་མོའང་སྟོན་ཐོག་ཏུ་ཡོང་སྟེ་བྲོ་འཁྲབ་ནས་ཧེ་རོ་དཱ་དང་མགྲོན་པོ་རྣམས་དགའ་བར་བྱས༌པས། རྒྱལ་པོས་བུ་མོ་དེ་ལ་ཁྱོད་ཀྱིས་ཅི་དང་ཅི་འདོད་པ་བདག་ལ་སྨྲོས༌ཤིག ངས་སྟེར་ངེས་ཡིན་ཞེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":23,"content":["ཡང་ཁོ་མོར་དམ་བཅས༌ཏེ། ཁྱོད་ཀྱིས་ང་རང་ལ་ཅི་ཞིག་བསླངས་ན་ངས་རྒྱལ་ཁམས་ཀྱི་ཕྱེད་ཀ་ཡིན་ཡང་ཁྱོད་ལ་སྟེར་ངེས་ཡིན་ཞེས་ཁས་བླངས༌སོ།།"]},{"type":"verse","number":24,"content":["དེ་ནས་བུ་མོ་དེ་ཕྱི་རུ་སོང་ནས་རང་གི་མ༌ལ། ངས་ཅི་ཞིག་བསླངས་ན་ལེགས་སམ་ཞེས་དྲིས་པ༌ལ། ཁོ་མོའི་མ་ན༌རེ། ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་གྱི་མགོ་བོ་སློངས་ཤིག་ཅེས་སྨྲས་པ༌དང༌།"]},{"type":"verse","number":25,"content":["བུ་མོ་མྱུར་དུ་ཕྱིར་རྒྱལ་པོའི་དྲུང་དུ་ལོག༌སྟེ། ངའི་འདོད་པ་ནི་ད་ལྟ་མྱུར་དུ་ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན་གྱི་མགོ་བོ་སྡེར་མའི་ནང་དུ་བཞག་ནས་བདག་ལ་གནང་བར་མཛོད་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":26,"content":["དེའི་ཚེ་རྒྱལ་པོ་ཧེ་རོ་དཱའི་སེམས་ཤིན་ཏུ་སྐྱོ་ནའང་མགྲོན་པོ་རྣམས་ཀྱི་མདུན་ནས་དམ་བཅས་ཟིན་པས་མི་སྟེར་ཞེས་ཟེར་མ་ཕོད༌པར།"]},{"type":"verse","number":27,"content":["དེ་མ་ཐག་སྲུང་དམག་ཅིག་མངགས་ཏེ་ཡོ་ཧ་ནན་གྱི་མགོ་བོ་འཁྱེར་ཡོང་བའི་བཀའ་བསྒོས༌ཤིང༌། སྲུང་དམག་དེ་ཡང་བཙོན་ཁང་དུ་སོང་ནས་ཡོ་ཧ་ནན་གྱི་མགོ་བོ་བཅད༌དེ།"]},{"type":"verse","number":28,"content":["སྡེར་མའི་ནང་དུ་བཞག་ནས་ཁྱེར་ཡོང་སྟེ་ཁོ་མོར་བྱིན་པ༌དང༌། བུ་མོ་དེས་ཀྱང་རང་གི་མ་ལ༌བྱིན།"]},{"type":"verse","number":29,"content":["ཡོ་ཧ་ནན་གྱི་རྗེས་འབྲང་པ་རྣམས་ཀྱིས་གཏམ་དེ་ཐོས་ནས་ཡུལ་དེར་སླེབས༌ཏེ། ཁོང་གི་སྐུ་གདུང་ཁུར་ནས་དུར་དུ་བཞག༌གོ།"]},{"type":"heading","content":["མི་ལྔ་སྟོང་ལྷག་འགྲང་བར་མཛད༌པ།"]},{"type":"verse","number":30,"content":["དེ་ནས་སྐུ་ཚབ་པ་རྣམས་",{"noteId":3},"སླར་ཡང་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་འཛོམས༌ཏེ། དོན་ཅི་ཞིག་བསྒྲུབས་པ་དང་ཆོས་ཇི་ལྟར་བསྟན་པ་ཐམས་ཅད་ཁོང་ལ་ཞུས་པ༌ན།"]},{"type":"verse","number":31,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་རང་ཚོ་ཁོ་ན་འདིར་ཤོག་དང་ངེད་རྣམས་ལྷན་དུ་དབེན་གནས་ཤིག་ཏུ་སོང་ནས་ཅུང་ཙམ་ངལ་གསོ་བར་བྱའོ་ཞེས་གསུངས༌སོ། །རྒྱུ་མཚན་ནི་གནས་འདིར་ཕར་འགྲོ་ཚུར་ཡོང་གི་མི་མང༌བས། ཁོང་རྣམས་ལ་ཞལ་ཟས་བཞེས་ཁོམ་ཡང་མ་བྱུང༌ངོ༌།།"]},{"type":"verse","number":32,"content":["དེ་ནས་ཁོང་རྣམས་མཚོ་གྲུར་བསྡད་ནས་དབེན་གནས་ཀྱི་ཕྱོགས་སུ༌ཕྱིན།"]},{"type":"verse","number":33,"content":["མི་ཚོགས་ཀྱིས་ཀྱང་ཁོང་རྣམས་འགྲོ་བཞིན་པ་མཐོང༌སྟེ། མི་མང་པོ་ཞིག་གིས་ཁོང་རྣམས་སུ་ཡིན་ཤེས་པས་གྲོང་སྡེ་སོ་སོ་ནས་ལྷན་དུ་རྐང་ཐང་ལ་བརྒྱུགས་ཏེ་ཁོང་རྣམས་ཀྱི་སྔོན་ལ་ཡུལ་དེར་སླེབས༌སོ།།"]},{"type":"verse","number":34,"content":["སྐྱབས་མགོན་ཡེ་ཤུ་གྲུ་ལས་བབས་པ༌ན། མི་ཤིན་ཏུ་མང་པོ་ནི་རྫི་བོ་མེད་པའི་ལུག་དང་འདྲ་བར་གཟིགས༌པས། ཐུགས་ལ་སྙིང་རྗེ་འཁྲུངས་ནས་དེ་དག་ལ་ཆོས་མང་པོ༌གསུངས།"]},{"type":"verse","number":35,"content":["ཉི་མ་ནུབ་ལ་ཉེ་བའི་དུས༌སུ། ཐུགས་སྲས་རྣམས་ཁོང་གི་དྲུང་དུ་ཡོང་སྟེ་ན༌རེ། ས་ཆ་འདི་དབེན་སྟོང་ཡིན་པ་དང་ཉི་མ་ཡང་ནུབ་ལ་ཉེ༌བས།"]},{"type":"verse","number":36,"content":["ཁོ་རྣམས་ཉེ་འཁོར་གྱི་གྲོང་སྡེ་དང་མཐའ་ཁུལ་དག་ལ་རང་རང་གི་ཁ་ཟས་ཉོ་རུ་གཏོང་བར་མཛོད་ཅེས་ཞུས་པ༌ན།"]},{"type":"verse","number":37,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་མི་ཚོགས་ལ་ཁ་ཟས་བྱིན་ཅིག་ཅེས༌གསུངས། ཐུགས་སྲས་རྣམས་ན༌རེ། ངེད་ཅག་གིས་དངུལ་སྒོར་ཉིས་བརྒྱ་",{"noteId":4},"བཀོལ་ནས་བག་ལེབ་ཉོས༌ཏེ། ཁོ་རྣམས་ལ་ཁ་ཟས་སྟེར་ནུས་སམ་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":38,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། ཁྱོད་རྣམས་བག་ལེབ་ག་ཙམ་ཡོད་པར་བལྟ་རུ་སོང་ཞེས་གསུངས་པ༌དང༌། ཐུགས་སྲས་རྣམས་ཀྱིས་ཅི་ཙམ་ཡོད་པ་ཤེས༌ཏེ། བག་ལེབ་ལྔ་དང་ཉ་གཉིས་ཡོད་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":39,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་མི་ཐམས་ཅད་གྲལ་སྐོར་བྱས་ཏེ་སྤང་ཐང་ལ་སྡོད་དུ་འཇུག་པའི་བཀའ་གནང་བ༌དང༌།"]},{"type":"verse","number":40,"content":["མི་ཚོགས་བརྒྱའམ་ལྔ་བཅུ་རེ་གྲལ་སྐོར་བྱས་ནས་བསྡད༌དོ།།"]},{"type":"verse","number":41,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་བག་ལེབ་ལྔ་དང་ཉ་གཉིས་པོ་ཕྱག་ཏུ་བསྣམས་ཏེ་ནམ་མཁར་གཟིགས་ནས་བྱིན་རླབས་གནང༌རྗེས། དུམ་བུར་བྱས་ནས་ཐུགས་སྲས་རྣམས་ལ་གནང་ཞིང་མི་ཚོགས་ཀྱི་མདུན་དུ་བཀྲམ༌པའོ། །ཁོང་གིས་ཉ་གཉིས་པོའང་མི་ཐམས་ཅད་ལ་བགོས༌པས།"]},{"type":"verse","number":42,"content":["མི་ཚང་མས་ཟོས་ཤིང་ལྟོ་བ་འགྲངས་པ༌དང༌།"]},{"type":"verse","number":43,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་བག་ལེབ་དང་ཉའི་ཟས་ལྷག་བསྡུས་ནས་སླེ་བོ་བཅུ་གཉིས་གང་ཞིང༌།"]},{"type":"verse","number":44,"content":["བག་ལེབ་ཟ་མཁན་གྱི་སྐྱེས་པ་བསྡོམས་པས་ལྔ་སྟོང་ཙམ་ཡོད༌དོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུས་མཚོ་སྟེང་དུ་ཞབས་ཀྱིས་བཅགས༌པ།"]},{"type":"verse","number":45,"content":["དོན་དེའི་རྗེས་སུ་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་མཚོ་གྲུར་སྡོད་དུ་བཅུག༌སྟེ། ཁོང་གི་སྔོན་དུ་མཚོའི་ཕ་རོལ་གྱི་པེ་སད་དཱ་རུ་འགྲོ་བར་བསྐུལ་ཞིང་མི་རྣམས་ཀྱང་སོ་སོར་གྱེས་སུ༌བཅུག"]},{"type":"verse","number":46,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་མི་ཚོགས་དང་ཁ་བྲལ་རྗེས་རི་མགོར་གསོལ་བ་འདེབས་སུ་ཕེབས་པ༌དང༌།"]},{"type":"verse","number":47,"content":["མཚན་མོའི་དུས༌སུ། ཁོ་རྣམས་ཀྱི་གྲུ་དེ་མཚོ་དཀྱིལ་དུ་སླེབས་ཤིང་སྐྱབས་མགོན་ཡེ་ཤུ་གཅིག་པུ་སྐམ་སར་བཞུགས༌སོ།།"]},{"type":"verse","number":48,"content":["ཁོང་གིས་རླུང་ཚུར་གཡུགས་ཤིང་ཐུགས་སྲས་རྣམས་ཀྱིས་མཚོ་གྲུ་གཏོང་བ་ལ་དཀའ་ཁག་ཆེན་པོ་བྱུང་བ་གཟིགས་པ༌དང༌། ནམ་ལངས་ལ་ཉེ་བའི་དུས༌སུ། ཁོང་གིས་མཚོ་སྟེང་དུ་ཞབས་ཀྱིས་བཅགས་ནས་དེ་དག་གི་གམ་དུ་ཕེབས་པ་དང་ཕར་ཕྱོགས་སུ་འགྲོ་བར་དགོངས་པ༌ལ།"]},{"type":"verse","number":49,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་ཁོང་གིས་མཚོ་སྟེང་དུ་ཞབས་ཀྱིས་བཅགས་ནས་ཕེབས་པ་མཐོང༌སྟེ། འདྲེ་ཡིན་པར་བསམས་ནས་འུར་བརྒྱབ༌བོ།།"]},{"type":"verse","number":50,"content":["ཅིའི་ཕྱིར་ཞེ༌ན། ཁོ་རྣམས་ཚང་མས་ཁོང་ཉིད་མཐོང་བ་ཙམ་གྱིས་འཇིགས་ཤིང་སྐྲག་པས༌སོ། །དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འཕྲལ་དུ་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་རྣམས་ཀྱི་སེམས་བདེ་བར་གྱིས༌དང༌། ང་རང་ཡིན་པས་འཇིགས་མི་དགོས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":51,"content":["ཁོང་ཉིད་མཚོ་གྲུའི་ནང་དུ་ཕེབས་པ་དང་རླུང་གཡུག་མཚམས་ཀྱང་ཆད་པས་ཁོ་རྣམས་ཀྱི་སེམས་སུ་ངོ་མཚར་ཆེན་པོ་སྐྱེས༌ཤིང༌།"]},{"type":"verse","number":52,"content":["དེ་ནི་ཁོ་རྣམས་ཀྱིས་བག་ལེབ་བགོས་པའི་དོན་ཡང་མི་རྟོགས་པའི་ཕྱིར༌དང༌། ཁོ་རྣམས་ཀྱི་སེམས་རྒྱུད་ད་དུང་གྱོང་པོ་ཡིན༌ནོ།།"]},{"type":"heading","content":["གེན་ནེ་སཱ་རེལ་ཡུལ་དུ་ནད་གསོས༌པ།"]},{"type":"verse","number":53,"content":["དེ་ནས་ཁོང་རྣམས་མཚོ་བརྒལ་ནས་གེན་ནེ་སཱ་རེལ་གྱི་ས་ཆར་སླེབས་ཤིང་མཚོ་གྲུ་ཡང་མཚོ་འགྲམ་དུ༌བཏགས།"]},{"type":"verse","number":54,"content":["ཁོང་རྣམས་མཚོ་གྲུ་ལས་སར་བབས་མ་ཐག་མི་རྣམས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་ཡིན་པ་ཤེས་པ༌དང༌།"]},{"type":"verse","number":55,"content":["ཁོང་གང་དུ་བཞུགས་པ་ཐོས༌རྗེས། མཐའ་སྐོར་གྱི་ཡུལ་ཐམས་ཅད་ལ་བརྒྱུགས་ཏེ་ནད་པ་རྣམས་ཁྱོགས་ཤིང་དུ་བཞག་ནས་ཁུར་ཡོང༌ངོ༌།།"]},{"type":"verse","number":56,"content":["ཁོང་ཉིད་གྲོང་སྡེའམ་གྲོང༌ཁྱེར། ཡང་ན་མཐའ་ཁུལ་བཅས་ས་ཆ་གང་དུ་ཕེབས༌ནའང༌། མི་རྣམས་ཀྱིས་ནད་པ་རྣམས་ཁྲོམ་སྲང་དུ་བསྐྱལ༌ཏེ། སྐྱབས་མགོན་ཡེ་ཤུ་ལ་ཁོང་གི་ན་བཟའི་འདབས་ཁ་ཙམ་ལ་རེག་ཏུ་གནང་བར་ཞུ་བ་ཞུས༌ཤིང༌། དེར་རེག་པའི་ནད་པ་ཐམས་ཅད་ནད་ལས་ཐར་བར་གྱུར༌ཏོ།།"]}],"footnotes":[{"noteId":3,"caller":"+","text":"འདིར་སྐུ་ཚབ་པ་རྣམས་ཞེས་པ་ནི་དོན་ལ་ཐུགས་སྲས་རྣམས༌ཡིན།","reference":{"chapter":6,"verse":30}},{"noteId":4,"caller":"+","text":"དངུལ་སྒོར་ཉིས་བརྒྱ་ཞེས་པ་འདིར་དམ་པའི་གསུང་རབ་ཀྱི་འཕྲིན་བཟང་འདི་ཉིད་ཡིག་ཐོག་ཏུ་འགོད་པའི་དུས༌སུ། དངུལ་སྒོར་གཅིག་ནི་ཉིན་གཅིག་གི་གླ་ཆ༌ཡིན།","reference":{"chapter":6,"verse":37}}]},"thisChapterLink":"/api/bod_ntb/MRK/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/5.json","previousChapterAudioLinks":{},"numberOfVerses":56}