{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":8,"content":[{"type":"heading","content":["མི་བཞི་སྟོང་ཙམ་འགྲང་བར་མཛད༌པ།"]},{"type":"verse","number":1,"content":["དེའི་དུས༌སུ། ཡང་མི་ཤིན་ཏུ་མང་པོ་ཕྱོགས་གཅིག་ཏུ་འདུས་ཤིང་ཟས་ཅི་ཡང་མེད༌པས། སྐྱབས་མགོན་ཡེ་ཤུས་ཁོང་གི་ཐུགས་སྲས་རྣམས་བོས་ཏེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":2,"content":["མི་ཚོགས་འདི་བདག་དང་མཉམ་དུ་གནས་འདི་རུ་ཉིན་གསུམ་འགོར༌ཡང༌། ད་ལྟ་ཁ་ཟས་ཅི་ཡང་མེད་པས་བདག་གིས་ཁོ་རྣམས་ལ་སྙིང་རྗེ་བར༌འདུག"]},{"type":"verse","number":3,"content":["ཁོ་རྣམས་ལས་མི་ཁ་ཤས་རྒྱང་རིང་ནས་ཡོང༌བས། ངས་ཁོ་རྣམས་བཀྲེས་ལྟོགས་ངང་ནས་ཕྱིར་འགྲོ་རུ་བཅུག༌ན། ལམ་བར་དུ་ཐང་ཆད་ནས་བརྒྱལ་བར་ངེས་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":4,"content":["ཐུགས་སྲས་རྣམས་ན༌རེ། དབེན་སྟོང་འདི་རུ་མི་འདི་རྣམས་ཀྱི་ཕོ་བ་འགྲང་བར་བྱེད་པའི་བག་ལེབ་ཇི་ལྟར་འཚོལ་ཞེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":5,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁྱོད་ཅག་ལ་བག་ལེབ་ག་ཚོད་ཡོད་ཅེས་དྲིས་པ༌ན། ཁོ་རྣམས་ཀྱིས་བདུན་ཡོད་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":6,"content":["དེ་ནས་ཁོང་གིས་མི་ཚོགས་ལ་བཀའ་གནང་སྟེ་ས་རུ་སྡོད་དུ་བཅུག༌ཅིང༌། བག་ལེབ་བདུན་པོ་ཕྱག་ཏུ་བསྣམས་ཏེ་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུས༌རྗེས། བག་ལེབ་དུམ་བུར་བྱས་ནས་ཐུགས་སྲས་རྣམས་ལ་སྤྲད་དེ་མི་ཚོགས་ལ་སྟེར་དུ་བཅུག་པ༌དང༌། ཐུགས་སྲས་རྣམས་ཀྱིས་ཀྱང་མི་ཚོགས་ལ༌བཀྲམ།"]},{"type":"verse","number":7,"content":["ཡང་ཉ་ཆུང་ངུ་ཁ་ཤས་ཡོད་པ་དེ་ལ་སྐྱབས་མགོན་ཡེ་ཤུས་བྱིན་རླབས་གནང་ནས་མི་ཚོགས་ལ་སྟེར་བའི་བཀའ་གནང༌ངོ༌།།"]},{"type":"verse","number":8,"content":["དེ་ནས་མི་ཚོགས་ཀྱིས་ཟས་སྤྱད་ནས་ལྟོ་བ་འགྲངས་པ༌དང༌། ཐུགས་སྲས་རྣམས་ཀྱིས་ཟས་ལྷག་བསྡུ་གསོག་བྱས་པ་སླེ་བོ་བདུན་བྱུང༌ངོ༌།།"]},{"type":"verse","number":9,"content":["གནས་དེར་མི་བཞི་སྟོང་ཙམ་ཡོད་པ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ཕྱིར་རང་ཡུལ་དུ་འགྲོ་རུ་བཅུག་པ་དང་ལྷན༌དུ།"]},{"type":"verse","number":10,"content":["ཁོང་ཉིད་ཀྱང་ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་མཚོ་གྲུར་བསྡད་ནས་དཱལ་མ་ནུ་ཐ་ཡུལ་དུ་ཕེབས༌སོ།།"]},{"type":"verse","number":11,"content":["ཕ་རུ་ཤི་པ་རྣམས་ཡོང་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ལ་རྩོད་གླེང་བྱས༌ཤིང༌། ཁོང་ལ་ཚོད་བགམ་བྱེད་པའི་ཕྱིར་ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་གྲུབ་རྟགས་ཤིག་སྟོན་པར་ཞུས་པ༌དང༌།"]},{"type":"verse","number":12,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་ནས་དབུགས་རིང་ཞིག་ཕྱུང་སྟེ་འདི་སྐད༌དུ། མི་རབས་འདིས་ཅིའི་ཕྱིར་ངོ་མཚར་བའི་རྟགས་ཤིག་འཚོལ་བ་ཡིན༌ནམ། ངས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། མི་རབས་འདི་ལ་ངོ་མཚར་བའི་རྟགས་སྟོན་པར་མི་འགྱུར་ཞེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":13,"content":["ཁོང་རྣམས་ཁོ་ཚོ་དང་ཁ་བྲལ་ནས་མཚོ་གྲུར་བསྡད་དེ་མཚོའི་ཕ་རོལ་ཏུ་ཕེབས༌སོ།།"]},{"type":"heading","content":["ཕ་རུ་ཤི་པ་དང་ཧེ་རོ་དཱ་གཉིས་ལ་དོགས་ཟོན་བྱ་དགོས༌པ།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཐུགས་སྲས་རྣམས་ཀྱིས་ལམ་བྲོ་འཁྱེར་བ་བརྗེད༌པས། མཚོ་གྲུའི་ནང་དུ་བག་ལེབ་གཅིག་ལས་ཅི་ཡང་མེད༌དོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་བློ་རིག་བསྒྲིམས་ནས་ཕ་རུ་ཤི་པ་དང་ཧེ་རོ་དཱའི་སྐྱུར་རྩི་",{"noteId":6},"ལ་དོགས་པར་གྱིས་ཞེས་བཀའ་གནང༌ཞིང༌།"]},{"type":"verse","number":16,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་ཕན་ཚུན་ལ་འདི་ནི་ངེད་ཅག་ལ་བག་ལེབ་མེད་པའི་ཕྱིར་ཡིན་ཞེས་གླེང༌ངོ༌།།"]},{"type":"verse","number":17,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ཀྱི་བསམ་ཚུལ་མཁྱེན༌ནས། ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་བག་ལེབ་མེད་པའི་གཏམ་གླེང་བ་ཡིན༌ནམ། ཁྱོད་རྣམས་ཀྱིས་ད་དུང་མི་ཤེས་ཤིང་མི༌གོའམ། ཁྱོད་ཅག་གི་སེམས་ནི་ད་དུང་གྱོང་པོ་ཡིན༌ནམ།"]},{"type":"verse","number":18,"content":["ཁྱོད་རྣམས་ལ་མིག་ཡོད་ཀྱང་མི་མཐོང༌ངམ། རྣ་བ་ཡོད་ཀྱང་མི་ཐོས༌སམ། ཁྱོད་ཅག་གིས་ཡིད་ལའང་མི་དྲན༌ནམ།"]},{"type":"verse","number":19,"content":["ངས་བག་ལེབ་ལྔ་མི་ལྔ་སྟོང་ལ་བགོས་ཤིང་ཁྱོད་རྣམས་ཀྱིས་ཟས་ལྷག་སླེ་བོ་ཅི་ཙམ་བསྡུ་གསོག་བྱས་སམ་ཞེས་དྲིས་པ༌ལ། ཁོ་རྣམས་ཀྱིས་བཅུ་གཉིས་ཡོད་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":20,"content":["ཡང་བག་ལེབ་བདུན་མི་བཞི་སྟོང་ལ་བགོས་ཤིང་ཁྱོད་ཅག་གིས་ཟས་ལྷག་བསྡུ་གསོག་བྱས་ནས་སླེ་བོ་ཅི་ཙམ་གང་ངམ་ཞེས་དྲིས་པ༌ལ། ཁོ་རྣམས་ཀྱིས་བདུན་ཡོད་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":21,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁྱོད་ཅག་གིས་ད་དུང་མི་ཤེས་སམ་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["པེ་སད་དཱ་གྲོང་རྡལ་གྱི་ལོང་བ་ཞིག་གསོས༌པ།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཁོང་རྣམས་པེ་སད་དཱ་རུ་སླེབས༌ཤིང༌། མི་འགའ་ཞིག་གིས་ལོང་བ་ཞིག་སྐྱབས་མགོན་ཡེ་ཤུའི་དྲུང་དུ་ཁྲིད་ཡོང༌སྟེ། ཁོང་ལ་ཕྱག་གིས་རེག་པར་ཞུ་བ༌ཞུས།"]},{"type":"verse","number":23,"content":["ཁོང་གིས་ལོང་བ་དེའི་ལག་པར་འཇུས་ཏེ་གྲོང་སྡེའི་ཕྱི་རོལ་ཏུ་ཁྲིད༌ཅིང༌། ལོང་བའི་མིག་གཉིས་ལ་ལྗགས་ཆུ་གཏོར་བ༌དང༌། ཕྱག་མི་དེའི་ལུས་སྟེང་ལ་བཞག༌སྟེ། ཁྱོད་ཀྱི་མིག་གིས་མཐོང་ངམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":24,"content":["ལོང་བས་མགོ་ཡར་བཀྱགས་ནས་བལྟས༌ཏེ། ངས་མི་རྣམས་མཐོང་ཞིང་དེ་དག་ནི་ཤིང་སྡོང་རྣམས་འགྲོ་བ་དང་མཚུངས་ཞེས་ཞུས༌སོ།།"]},{"type":"verse","number":25,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཡང་བསྐྱར་ལོང་བའི་མིག་ཟུང་ལ་ཕྱག་གླན༌ཅིང༌། ལོང་བས་མིག་ཅེ་རེར་བལྟས་པ་དང་མིག་ཟུང་སོས་ཏེ་ཐམས་ཅད་གསལ་པོར་མཐོང་བར་གྱུར༌ཏོ།།"]},{"type":"verse","number":26,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་ཕྱིར་རང་ཁྱིམ་དུ་འགྲོ་རུ་བཅུག་པ་དང་གྲོང་སྡེ་འདིའི་ནང་དུ་མ་འགྲོའོ་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མཱ་ཤི་ཀ་ཡིན་པར་ཁས་བླངས༌པ།"]},{"type":"verse","number":27,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཐུགས་སྲས་རྣམས་དང་མཉམ་དུ་ཀེ་སར་ཡཱ་ཕི་ལིབ་པིའི་མཐའ་འཁོར་གྱི་གྲོང་སྡེ་དག་ལ་ཕེབས༌ཤིང༌། ལམ་བར་ནས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། མི་རྣམས་ཀྱིས་ང་རང་སུ་ཡིན་པར་སྨྲ་བཞིན་འདུག་གམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":28,"content":["ཁོ་རྣམས་ན༌རེ། མི་ལ་ལས་ཁྲུས་གསོལ་མཁན་ཡོ་ཧ་ནན༌དང༌། ལ་ལས་ཨེ་ལི༌ཡཱ། ཡང་མི་ལ་ལས་ལུང་སྟོན་པའི་གྲས་ཀྱི་གཅིག་ཡིན་ཟེར་གྱི་འདུག་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":29,"content":["ཡང་ཁོང་གིས་འདི་སྐད༌དུ། འོ༌ན། ཁྱོད་ཅག་གིས་ང་རང་སུ་ཡིན་པར་གླེང་ངམ་ཞེས་དྲིས་པ༌ན། པེ་ཏྲོ་ན༌རེ། ཁྱེད་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡིན་ཞེས་ཞུས༌སོ།།"]},{"type":"verse","number":30,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་ཁོང་ཉིད་ཀྱི་དོན་འདི་མི་གཞན་ལ་མི་སྨྲ་བའི་ཕྱིར་ནན་གྱིས་བསྐུལ༌ཏོ།།"]},{"type":"heading","content":["དགྲོང་བར་འགྱུར་བའི་ལུང་བསྟན༌པ།"]},{"type":"verse","number":31,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། མིའི་བུ་ཡིས་ངེས་པར་སྡུག་བསྔལ་མང་དུ་མྱོང༌ཞིང༌། རྒན་པོ་དང་མཆོད་དཔོན་ཆེན་པོ༌དག མཁན་པོ་རྣམས་ཀྱིས་ཁོ་རང་དོར་ནས་གསོད་པ༌དང༌། ཡང་ཉིན་གསུམ་གྱི་རྗེས་སུ་སླར་གསོན་པར་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":32,"content":["ཁོང་གིས་བཀའ་དེ་གསལ་པོར་གསུངས་པ༌ན། པེ་ཏྲོས་ཁོང་གི་ཕྱག་ལ་འཇུས་ཤིང་ཟུར་དུ་ཁྲིད་ནས་ནན་གྱིས་བསྐུལ༌མོད།"]},{"type":"verse","number":33,"content":["འོན་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུས་ཞལ་ཕྱིར་འཁོར་ནས་ཐུགས་སྲས་རྣམས་ལ་གཟིགས་ཏེ་པེ་ཏྲོ་ལ་འདི་སྐད༌དུ། བདུད་སཱ་ཏན་ཁྱོད་ངའི་རྒྱབ་ཏུ་སོང༌ཞིག ཁྱོད་ཀྱིས་དཀོན་མཆོག་གི་དགོངས་པ་མི་བསམ་པར་མིའི་འདོད་བློ་བསམ་པ་ཡིན་ཞེས་བཀའ་བཀྱོན་གནང༌ངོ༌།།"]},{"type":"verse","number":34,"content":["ཁོང་གིས་མི་ཚོགས་དང་ཐུགས་སྲས་རྣམས་རང་ཉིད་ཀྱི་དྲུང་དུ་བོས༌ཏེ། སུ་ཞིག་ང་ཡི་རྗེས་སུ་འབྲང་འདོད༌ན། རང་ཉིད་དོར་ནས་རང་གི་ཤིང་རྒྱ་གྲམ་ཁུར་ཏེ་ང་ཡི་རྗེས་སུ་འབྲང་བར༌གྱིས།"]},{"type":"verse","number":35,"content":["སུ་ཞིག་གིས་རང་སྲོག་སྐྱོབ་འདོད་པ་དེས་རང་སྲོག་འཆོར༌ཞིང༌། སུ་ཞིག་གིས་ང་རང་དང་འཕྲིན་བཟང་གི་དོན་དུ་རང་སྲོག་འདོར་བ་དེས་རང་སྲོག་སྐྱོབ་ངེས༌ཡིན།"]},{"type":"verse","number":36,"content":["སུ་ཞིག་གིས་འཇིག་རྟེན་ཧྲིལ་པོ་རག་ཀྱང་རང་སྲོག་བོར་ན་ཅི་ལ༌ཕན།"]},{"type":"verse","number":37,"content":["མིས་རང་ལ་ཚེ་སྲོག་འཐོབ་པར་རིན་ཅི་ཞིག་སྤྲོད༌དམ།"]},{"type":"verse","number":38,"content":["ལོག་གཡེམ་དང་སྡིག་ཅན་ཡིན་པའི་མི་རབས་འདི་ལས་སུ་ཞིག་གིས་ང་དང་ངའི་བཀའ་ངོ་ཚ་ཞིག་ཏུ་བརྩིས༌ན། མིའི་བུ་ཡབ་ཀྱི་གཟི་བརྗིད་ངང་ཕོ་ཉ་དམ་པ་འཁོར་དང་བཅས་པ་ཕེབས་ཡོང༌དུས། མི་དེ་ཡང་ངོ་ཚ་ཞིག་ཏུ་བརྩི་ངེས་ཞེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":6,"caller":"+","text":"འདིར་བརྗོད་པའི་སྐྱུར་རྩི་ཞེས་པ་ནི་དཔེ་ཡིན༌ལ། དོན་ནི་གཡོ་སྒྱུ་དང་སྡིག་པ་ལ་སོགས་པའི་ལས་ངན་པར་གོ་བ་ཡིན།","reference":{"chapter":8,"verse":15}}]},"thisChapterLink":"/api/bod_ntb/MRK/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/7.json","previousChapterAudioLinks":{},"numberOfVerses":38}