{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"MRK","translationId":"bod_ntb","name":"མཱཪ་ཀུ","commonName":"མཱཪ་ཀུ","title":"༄༅། །མཱར་ཀུའི་འཕྲིན་བཟང་།","order":41,"numberOfChapters":16,"sha256":"1f1cbe06acd4d55231fa0ea9e906f759beb6448dbbd88b42e68b9dbdde01902d","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/MRK/16.json","totalNumberOfVerses":673},"chapter":{"number":9,"content":[{"type":"heading","content":["དཀོན་མཆོག་གི་རྒྱལ་སྲིད་སླེབ་ངེས༌པ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་སྐྱབས་མགོན་ཡེ་ཤུས་ཁོ་རྣམས་ལ་འདི་སྐད༌དུ། ངས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། འདི་རུ་སྡོད་པའི་མི་རྣམས་ལས་འགའ་ཞིག་གིས་འཆི་བ་དངོས་སུ་མ་མྱོང་བའི་སྔོན༌དུ། དཀོན་མཆོག་གི་རྒྱལ་སྲིད་མཐུ་སྟོབས་དང་ལྡན་པའི་སྒོ་ནས་སླེབ་ཡོང་བ་མཐོང་བར་ངེས་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྐུ་གཟུགས་ཀྱི་རྣམ་པ་འགྱུར༌བ།"]},{"type":"verse","number":2,"content":["དེ་ནས་ཉིན་དྲུག་འགོར་བ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་པེ་ཏྲོ༌དང༌། ཡ༌ཀོབ། ཡོ་ཧ་ནན་བཅས་ཁྲིད་ནས་རི་མཐོན་པོ་ཞིག་ཏུ་ཕེབས་པ༌དང༌། ཁོ་རྣམས་ཀྱི་མདུན་དུ་ཁོང་གི་རྣམ་པ་འགྱུར༌ཏེ།"]},{"type":"verse","number":3,"content":["ན་བཟའ་ནི་འོད་འཕྲོ་ཞིང་ཤིན་ཏུ་དཀར་བ་འཇིག་རྟེན་དུ་འཁྲུད་མཁན་སུས་ཀྱང་དེ་ལྟར་དཀར་པོ་བྱེད་མི་ཐུབ་པ་ཙམ་དུ་གྱུར༌ཏོ།།"]},{"type":"verse","number":4,"content":["དེའི༌ཚེ། ཨེ་ལི་ཡཱ་དང་མོ་ཤེ་གཉིས་མངོན་སུམ་དུ་བྱུང་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་དང་གསུང་མོལ་མཛད༌དོ།།"]},{"type":"verse","number":5,"content":["དེ་ནས་ཐུགས་སྲས་གསུམ་པོ་ཤིན་ཏུ་འཇིགས་ཏེ་པེ་ཏྲོས་ཅི་ལྟར་ཞུ་དགོས་པའང་མ་ཤེས༌པས། ཁོ་ན༌རེ། རཱབ་པེ༌ལགས། བདག་ཅག་འདི་རུ་བསྡད་ན་དངོས་གནས་ལེགས་པོ༌འདུག གུར་གསུམ་ཡང་བཟོ་བར་བྱ༌སྟེ། ཁྱེད་ལ་གཅིག་དང་མོ་ཤེ་ལ༌གཅིག ཨེ་ལི་ཡཱ་ལའང་གཅིག་ཅེས་ཞུས༌སོ།།"]},{"type":"verse","number":7,"content":["དེ་ནས་སྤྲིན་ཕུང་ཞིག་གིས་ཁོང་རྣམས་བསྒྲིབས་པ་དང་དེའི་ཁྲོད་ནས་སྐད་སྒྲ་ཞིག་གྲགས༌ཏེ། འདི་ནི་བདག་གི་གཅེས་པའི་བུ་ཡིན༌ཞིང༌། ཁྱོད་ཅག་གིས་ཁོའི་གཏམ་ལ་ཉོན་ཅིག་ཅེས༌གསུངས།"]},{"type":"verse","number":8,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་མྱུར་དུ་མཐའ་འཁོར་ལ་བལྟས་པ༌ན། སྐྱབས་མགོན་ཡེ་ཤུ་གཅིག་པུ་ཁོ་རྣམས་དང་མཉམ་དུ་བཞུགས་པ་ལས་ཅི་ཡང་མ་མཐོང༌ངོ༌།།"]},{"type":"verse","number":9,"content":["དེ་ནས་ཁོང་རྣམས་རི་བོ་ལས་མར་ཕེབས་པའི་དུས༌སུ། སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མིའི་བུ་ད་དུང་འཆི་བ་ལས་སླར་གསོན་པའི་བར་དུ་ཁྱོད་ཅག་གིས་ཅི་མཐོང་བ་དེ་གཞན་སུ་ལའང་མི་སྨྲ་བར་གྱིས་ཞེས་བཀའ་བསྒོས༌སོ།།"]},{"type":"verse","number":10,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་གསུང་དེ་ཡིད་ལ་བཟུང༌ཞིང༌། འཆི་བ་ལས་སླར་གསོན་ཞེས་གསུངས་པའི་དོན་ཅི་ཡིན་ཕན་ཚུན་གླེང༌མོལ་བྱས།"]},{"type":"verse","number":11,"content":["ཁོ་རྣམས་ན༌རེ། མཁན་པོ་རྣམས་ཀྱིས་ཨེ་ལི་ཡཱ་སྔོན་དུ་འབྱོན་ངེས་ཡིན་ཞེས་ཟེར་དོན་ཅི་ཞུས་པ༌ལ།"]},{"type":"verse","number":12,"content":["ཁོང་གིས་འདི་སྐད༌དུ། ཨེ་ལི་ཡཱ་དངོས་སུ་སྔོན་ལ་བྱོན་ཏེ་ཐམས་ཅད་བསྐྱར་དར་བྱ་བར༌ངེས། གསུང་རབ་ཀྱི་མདོ༌ལས། མིའི་བུ་ཡི་སྐོར་ལ་ཇི་ལྟར་གསུངས་ཡོད་ཅེ༌ན། ཁོང་གིས་སྡུག་བསྔལ་མང་པོ་མྱང་བར་འགྱུར་ཞིང་མི་རྣམས་ཀྱིས་མཐོང་ཆུང་བྱེད་ངེས་ཡིན་ཞེས་བསྟན་ཡོད་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":13,"content":["འོན༌ཀྱང༌། བདག་གིས་ཁྱོད་རྣམས་ལ་སྨྲས་པ་ནི་གསུང་རབ་ཀྱི་མདོ་ལས་ཨེ་ལི་ཡཱའི་སྐོར་བཀོད་ཡོད་པ་ལྟར་ཁོང་ཉིད་བྱོན་ཟིན༌ལ། མི་རྣམས་ཀྱིས་ཁོང་ལ་ཅི་འདོད་བཞིན་བྱས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["གདོན་འདྲེས་བཟུང་བའི་བུ་ཞིག་གསོས༌པ།"]},{"type":"verse","number":14,"content":["དེ་ནས་ཁོང་རྣམས་ཐུགས་སྲས་གཞན་རྣམས་ཀྱི་གམ་དུ་ཕེབས་པ༌ན། མི་ཤིན་ཏུ་མང་པོས་ཐུགས་སྲས་གཞན་རྣམས་ཀྱི་མཐའ་བསྐོར༌ཞིང༌། ཡང་མཁན་པོ་འགའ་ཞིག་གིས་ཁོ་རྣམས་དང་རྩོད་གླེང་བྱེད་བཞིན་པ་གཟིགས༌སོ།།"]},{"type":"verse","number":15,"content":["དེ་ནས་མི་ཚོགས་ཀྱིས་སྐྱབས་མགོན་ཡེ་ཤུ་མཐོང་མ་ཐག་ཐམས་ཅད་ངོ་མཚར་བ་དང་ཁོང་གི་དྲུང་དུ་བརྒྱུགས་ཡོང་ནས་ཁོང་ལ་མཇལ༌ཏོ།།"]},{"type":"verse","number":16,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་མི་དེ་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་ཅི་ཞིག་རྩོད་བཞིན་ཡོད་དམ་ཞེས་དྲིས་པ༌ལ།"]},{"type":"verse","number":17,"content":["མི་ཚོགས་ཀྱི་ཁྲོད་ནས་མི་ཞིག་ན༌རེ། སློབ་དཔོན༌ལགས། ངས་རང་གི་བུ་ཁྱེད་ཀྱི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌ཡིན། ངའི་བུ་ནི་གདོན་འདྲེ་ཞིག་གིས་བཟུང་སྟེ་ལྐུགས་པར་གྱུར༌ཅིང༌།"]},{"type":"verse","number":18,"content":["གང་ས་གང་དུའང་གདོན་འདྲེས་བཟུང༌ཚེ། བུ་ས་ལ་སྒྱེལ་ཞིང་ཁ་ནས་ལྦུ་བ་བཞུར་བ༌དང༌། སོ་འཆའ་ཞིང་ལུས་པོའང་རེངས་པོར་འགྱུར༌བས། ངས་ཁྱེད་ཀྱི་ཐུགས་སྲས་རྣམས་ལ་གདོན་འདྲེ་ཕྱིར་སྐྲོད་པར་ཞུས་ཀྱང་ཁོ་རྣམས་ཀྱིས་སྐྲོད་མ་ནུས་ཞེས་ཞུས༌སོ།།"]},{"type":"verse","number":19,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཀྱེ། དད་པ་མེད་པའི་མི་རབས༌འདི། བདག་ནི་ཁྱོད་ཅག་དང་མཉམ་དུ་དུས་ནམ་ཞིག་གི་བར་དུ་སྡོད་དགོས༌སམ། ངས་དུས་ནམ་ཞིག་གི་བར་དུ་ཁྱོད་ཅག་ལ་བཟོད་བསྲན་བྱེད་དགོས༌སམ། བུ་དེ་བདག་གི་མདུན་དུ་ཁྲིད་ཤོག་ཅེས་གསུངས་པ༌དང༌།"]},{"type":"verse","number":20,"content":["མི་རྣམས་ཀྱིས་བུ་དེ་ཁོང་གི་དྲུང་དུ་ཁྲིད་ཡོང་བ༌དང༌། གདོན་འདྲེ་དེས་སྐྱབས་མགོན་ཡེ་ཤུ་མཐོང་མ་ཐག་བུ་དྲག་ཏུ་སྤྲུགས༌པས། བུ་ས་ལ་འགྱེལ་ཞིང་འགྲེ་ལྡོག་བརྒྱབ་པ་དང་ཁ་ནས་ལྦུ་བ་བཞུར༌ཏོ།།"]},{"type":"verse","number":21,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་བུ་དེའི་ཕ་ལ་དུས་ནམ་ཞིག་ཏུ་འདི་ལྟ་བུར་གྱུར་ཏམ་ཞེས་དྲིས་པ༌ལ། ཕ་ན༌རེ། ཁོ་ཆུང་དུས་ནས་བཟུང་འདི་ལྟར༌ཡིན།"]},{"type":"verse","number":22,"content":["གདོན་འདྲེ་དེས་ངའི་བུ་གསོད་པའི་ཆེད་དུ་ཐེངས་མང་པོར་མེ་དང་ཆུའི་ནང་དུ་འཕངས༌མྱོང༌། ཁྱེད་ཀྱིས་ཅི་ཞིག་མཛད་ནུས༌ན། ངེད་ཅག་ལ་སྙིང་རྗེ་གནང་ཞིང་སྐྱབས་སུ་འཛིན་པར་མཛོད་ཅེས་ཞུས་པ༌དང༌།"]},{"type":"verse","number":23,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། ཅི་ཞིག་མཛད་ནུས་ན་ཟེར༌རམ། སུས་ཀྱང་དད་པ་བྱས་ན་དོན་ཐམས་ཅད་འགྲུབ་སྲིད་ཅེས་གསུངས༌སོ།།"]},{"type":"verse","number":24,"content":["བུའི་ཕ་ཡིས་དེ་མ་ཐག་སྐད་ཆེན༌པོས། ངས་དད་པ༌བྱེད། འོན་ཀྱང་ངའི་དད་པ་མི་འདང་བས་རོགས་རམ་མཛོད་ཅིག་ཅེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":25,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་མི་ཚོགས་ཐམས་ཅད་རྒྱུག་ཡོང་བ་གཟིགས་པ་དང་གདོན་འདྲེ་ལ་འདི་སྐད་བཀའ་བཀྱོན་གནང་བ༌སྟེ། འོན་ཞིང་ལྐུགས་པའི་གདོན་འདྲེ༌ཁྱོད། ཁོའི་ལུས་ནས་ཕྱིར་བུད༌ཅིག ཕྱིན་ཆད་བུ་དེའི་ལུས་ལ་ཕྱིར་མ་ལོག་ཅིག་ཅེས་བཀའ་བབས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"verse","number":26,"content":["དེ་ནས་གདོན་འདྲེས་འུར་བརྒྱབ་ཅིང་བུ་འདར་དུ་བཅུག་ནས་ཕྱི་རུ་ཐོན་པ༌ན། བུ་བེམ་པོ་ལྟར་གྱུར་པས་མི་མང་ཤོས་ཀྱིས་བུ་དེ་ཤི་ཟིན་ཞེས་སྨྲས༌སོ།།"]},{"type":"verse","number":27,"content":["འོན་ཀྱང་སྐྱབས་མགོན་ཡེ་ཤུས་བུའི་ལག་པར་འཇུས་ཏེ་བསྐྱོར་བ་ན་བུའང་ཡར༌ལངས།"]},{"type":"verse","number":28,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུ་ཁང་པའི་ནང་དུ་ཕེབས་ཤིང་ཟུར་ནས་ཐུགས་སྲས་རྣམས་ན༌རེ། ངེད་ཅག་གིས་ཅིའི་ཕྱིར་གདོན་འདྲེ་དེ་ཕྱིར་བསྐྲོད་མ་ནུས་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":29,"content":["ཁོང་གིས་འདི་སྐད༌དུ། གདོན་འདྲེ་འདིའི་རིགས་གསོལ་བ་འདེབས་པ་ལས་གཞན་ཐབས་གང་གིས་ཀྱང་ཕྱི་རུ་ཕུད་མི་ནུས་ཞེས་གསུངས༌སོ།།",{"noteId":7}]},{"type":"verse","number":30,"content":["དེ་ནས་ཁོང་རྣམས་ལམ་ལ་ཆས་ཤིང་ག་ལིལ་ཡུལ་བརྒྱུད་ནས་ཕེབས་པ༌དང༌། སྐྱབས་མགོན་ཡེ་ཤུས་དོན་དེ་མི་གཞན་ལ་ཤེས་སུ་མི་འཇུག་པར་དགོངས༌ཏེ།"]},{"type":"verse","number":31,"content":["ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། མིའི་བུ་མི་རྣམས་ཀྱི་ལག་ཏུ་སྤྲོད༌ཅིང༌། དེ་དག་གིས་ཁོ་རང་གསོད་པར་འགྱུར༌ལ། བསད་ནས་ཉིན་གསུམ་གྱི་རྗེས་སུ་ཁོ་རང་སླར་གསོན་པར་ངེས་ཞེས་གདམས༌སོ།།"]},{"type":"verse","number":32,"content":["ཐུགས་སྲས་རྣམས་ཀྱིས་གསུང་དེའི་དོན་མ་རྟོགས་ཀྱང་ཁོང་ལ་དྲི་བ་འདོན་མ་ཕོད༌དོ།།"]},{"type":"heading","content":["ཐུགས་སྲས་རྣམས་ལས་སུ་ཞིག་མཆོག་གྱུར་ཡིན༌པ།"]},{"type":"verse","number":33,"content":["དེ་ནས་ཁོང་རྣམས་ཀཱ་ཕར་ན་ཧུམ་དུ་སླེབས་པ་དང་སྐྱབས་མགོན་ཡེ་ཤུ་ཁང་པའི་ནང་དུ་བཞུགས་པའི་ཚེ་ཐུགས་སྲས་རྣམས་ལ་འདི་སྐད༌དུ། ཁྱོད་ཅག་གིས་ལམ་བར་ནས་ཅི་ཞིག་གླེང་བ་ཡིན་ཞེས༌དྲིས།"]},{"type":"verse","number":34,"content":["ཁོ་རྣམས་ཀྱིས་ལམ་བར་དུ་ཁོ་རྣམས་ལས་སུ་ཞིག་མཆོག་ཏུ་གྱུར་པ་ཡིན་པར་རྩོད་གླེང་བྱས་པས་སུས་ཀྱང་ཁ་མ་གྲགས༌སོ།།"]},{"type":"verse","number":35,"content":["ཁོང་ཉིད་མར་བཞུགས་རྗེས་ཐུགས་སྲས་བཅུ་གཉིས་པོ་བོས་ཏེ་འདི་སྐད༌དུ། སུ་ཞིག་གིས་རང་ཉིད་མཆོག་གྱུར་ཡིན་པར་འདོད༌ན། དེ་ནི་མི་ཐམས་ཅད་ཀྱི་མཐའ་མ་དང་མི་ཀུན་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་ཏུ་འགྱུར་དགོས་པ་ཡིན་ཞེས་གསུངས༌ཤིང༌།"]},{"type":"verse","number":36,"content":["དེ་ནས་ཁོང་གིས་བྱིས་པ་ཆུང་ངུ་ཞིག་ཁྲིད་ཡོང་སྟེ་ཁོ་རྣམས་ཀྱི་དཀྱིལ་ནས་སྡོད་དུ་བཅུག་པ༌དང༌། ཡང་བྱིས་པ་དེ་ཁོང་གི་པང་དུ་བཟུང་སྟེ་འདི་སྐད༌དུ།"]},{"type":"verse","number":37,"content":["སུ་ཞིག་གིས་ངའི་མིང་གི་ཕྱིར་འདི་འདྲའི་བྱིས་པ་ཆུང་ངུ་ཞིག་ལ་བསུ་བ་བྱས༌ན། དོན་དམ་དུ་བདག་ལ་བསུ་བ་བྱས་པ༌ཡིན། ཡང་སུ་ཞིག་གིས་ང་རང་ལ་བསུ་བ་བྱས་པ་ཡིན༌ན། དོན་དམ་དུ་ང་རང་ལ་བསུ་བ་བྱས་པ་མ་ཡིན་པར་ང་རང་མངགས་མཁན་ཁོང་ལ་བསུ་བ་བྱས་པ་ཡིན་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["དགྲ་དང་རང་ཕྱོགས་ཀྱི༌སྐོར།"]},{"type":"verse","number":38,"content":["དེ་ནས་ཡོ་ཧ་ནན་ན༌རེ། སློབ་དཔོན༌ལགས། མི་གཞན་ཞིག་གིས་ཁྱེད་ཀྱི་མཚན་ལ་བརྟེན་ནས་གདོན་འདྲེ་སྐྲོད་བཞིན་པ་ངེད་རྣམས་ཀྱིས་མཐོང་བྱུང༌ངོ༌། །འོན་ཀྱང་མི་དེ་ནི་བདག་ཅག་གི་རྗེས་སུ་མི་འབྲང༌བས། ངེད་རྣམས་ཀྱིས་དོན་དེ་ལྟར་བྱེད་པ་བཀག་པ་ཡིན་ཞེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":39,"content":["སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། མི་གཞན་གྱིས་བདག་གི་མིང་ལ་བརྟེན་ནས་དོན་ངོ་མཚར་ཅན་བྱས༌རྗེས། མྱུར་དུ་བདག་ལ་ཚིག་ངན་སྨྲ་བར་མི་ནུས་པས་ཁོ་རང་མ་འགོག༌ཅིག"]},{"type":"verse","number":40,"content":["བདག་ཅག་དགྲ་རུ་མི་འཛིན་པ་དེ་ནི་བདག་ཅག་གི་ཕྱོགས༌ཡིན།"]},{"type":"verse","number":41,"content":["ངས་ཁྱོད་རྣམས་ལ་བདེན་པར་སྨྲ༌སྟེ། སུ་ཞིག་གིས་ཁྱོད་ཅག་ནི་མཱ་ཤི་ཀ་ལ་གཏོགས་པའི་མི་ཡིན་པའི༌ཕྱིར། ཁྱོད་རྣམས་ལ་ཆུ་ཕོར་བ་གང་བྱིན་ནའང་མི་དེའི་བྱ་དགའ་ཅི་ནས་ཀྱང་སྟོང་བར་མི་འགྱུར་ཞེས་གསུངས༌སོ།།"]},{"type":"heading","content":["སྡིག་པ་འགོག་པའི་སྐོར་གྱི་ཆོས་གསུངས༌པ།"]},{"type":"verse","number":42,"content":["དེ་ནས་སྐྱབས་མགོན་ཡེ་ཤུས་འདི་སྐད༌དུ། སུ་ཞིག་གིས་བདག་ལ་དད་པའི་བྱིས་པ་ཆུང་ངུ་འདི་རྣམས་ལས་གཅིག་ལ་སྡིག་པ་བྱེད་དུ་འཇུག་པ༌ལས། མི་དེའི་སྐེ་ལ་རང་འཐག་གི་རྡོ་ཆེན་པོ་ཞིག་བཏགས་ནས་རྒྱ་མཚོའི་ནང་དུ་འཕངས་ན་ལེགས༌སོ།།"]},{"type":"verse","number":43,"content":["གལ་ཏེ་ཁྱོད་ཀྱི་ལག་པས་ཁྱོད་ལ་སྡིག་པ་བྱེད་དུ་འཇུག༌ན། ལག་པ་དེ་ཆོད༌ཅིག ཁྱོད་རང་ལག་པ་གཉིས་དང་ལྡན་པར་ནམ་ཡང་ཞི་བ་མེད་པའི་དམྱལ་བའི་གནས་ཀྱི་མེ་རུ་འཇུག་པ༌ལས། ལག་རྡུམ་དུ་གྱུར་ཀྱང་མཐའ་མེད་པའི་ཚེ་སྲོག་ཐོབ་པ་དེ་ལེགས༌སོ།།"]},{"type":"verse","number":44,"content":["དམྱལ་བའི་གནས་སུའང་མི་དེ་དག་ཟ་བའི་འབུ་མི་འཆི་ལ་མེ་ཡང་མི༌ཞིའོ།།"]},{"type":"verse","number":45,"content":["གལ་ཏེ་ཁྱོད་ཀྱི་རྐང་པས་ཁྱོད་ལ་སྡིག་པ་བྱེད་དུ་འཇུག༌ན། རྐང་པ་དེ་ཆོད༌ཅིག ཁྱོད་རང་རྐང་པ་གཉིས་དང་ལྡན་པར་དམྱལ་བའི་གནས་སུ་གཡུག་པ༌ལས། གྱོལ་པོར་གྱུར་ཀྱང་མཐའ་མེད་པའི་ཚེ་སྲོག་ཐོབ་པ་དེ་ལེགས༌སོ།།"]},{"type":"verse","number":46,"content":["དམྱལ་བའི་གནས་སུའང་མི་དེ་དག་ཟ་བའི་འབུ་མི་འཆི་ལ་མེ་ཡང་མི༌ཞིའོ།།"]},{"type":"verse","number":47,"content":["གལ་ཏེ་ཁྱོད་ཀྱི་མིག་གིས་ཁྱོད་ལ་སྡིག་པ་བྱེད་དུ་འཇུག༌ན། མིག་དེ་བཏོན་ནས་དོར༌ཅིག ཁྱོད་རང་མིག་ཟུང་དང་ལྡན་པར་དམྱལ་བའི་གནས་སུ་གཡུག་པ༌ལས། མིག་ཡ་གཅིག་མེད་ནའང་དཀོན་མཆོག་གི་རྒྱལ་སྲིད་དུ་ཞུགས་པ་དེ་ལེགས༌སོ།།"]},{"type":"verse","number":48,"content":["དམྱལ་བའི་གནས་སུའང་མི་དེ་དག་ཟ་བའི་འབུ་མི་འཆི་ལ་མེ་ཡང་མི༌ཞིའོ།།"]},{"type":"verse","number":49,"content":["རྒྱུ་མཚན་ནི་མི་རེ་རེ་ལ་མེ་ནི་ལན་ཚྭ་བཞིན་དུ་འདེབས་པར༌འགྱུར།",{"noteId":8}]},{"type":"verse","number":50,"content":["སྤྱིར་ལན་ཚྭ་ནི་ལེགས་ཀྱང་ལན་ཚྭའི་བྲོ་བ་ཡལ༌ན། དེའི་བྲོ་བ་གང་གིས་བསྐྱེད༌དམ། ཁྱོད་ཅག་གི་ཁྲོད་དུའང་ཚྭ་ཡོད་པ་ལྟར་གྱུར༌ནས། ཕན་ཚུན་འགྲིག་མཐུན་ངང་གནས་པར་གྱིས་ཤིག་ཅེས་གསུངས༌སོ།།"]}],"footnotes":[{"noteId":7,"caller":"+","text":"ཚིག་རྐང་ཉེར་དགུ་པ་ལྟ་བུ་ནི་དམ་པའི་གསུང་རབ་ཀྱི་མ་ཕྱི་ལ་ལར་དཀོན་མཆོག་ལ་གསོལ་བ་འདེབས་པ་དང་སྨྱུང་གནས་སྲུང་བ་ལས་གཞན་ཐབས་གང་གིས་ཀྱང་འདྲེ་དེའི་རིགས་ཕྱིར་བསྐྲོད་མི་ནུས་ཞེས་ཀྱང༌འབྱུང༌།","reference":{"chapter":9,"verse":29}},{"noteId":8,"caller":"+","text":"ཚིག་རྐང་ཞེ་དགུ་ལ་གོ་བ་ལེན་ཚུལ་གཉིས་ཡོད༌དེ། གཅིག་ནི་ཡེ་ཤུའི་ཆོས་ལས་དམྱལ་བའི་གནས་སུ་ལྷུང་བ་རྣམས་ལ་མེ་ཡི་ཉེས་ཆད་ཆེན་པོ་གཅོད་ངེས་པས་སྡུག་བསྔལ་ཤིན་ཏུ༌ཆེ། གཞན་ཞིག་ནི་ཡེ་ཤུའི་ཆོས་ཀྱི་དད་ལྡན་དང་རྗེས་འབྲང་པ་ཞིག་ཡིན༌ན། མི་ཚེ་འདིའི་ནང་དུ་མེ་ཡིས་བསྲེགས་པ་ལྟ་བུའི་སྡུག་བསྔལ་མྱངས་ཏེ། སྐྱབས་མགོན་ཡེ་ཤུ་བཞིན་དུ་རྣམ་པར་དག་ཅིང་གཙང་མར་འགྱུར་ཞེས་པའི་དོན༌ཡིན།","reference":{"chapter":9,"verse":49}}]},"thisChapterLink":"/api/bod_ntb/MRK/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/MRK/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/MRK/8.json","previousChapterAudioLinks":{},"numberOfVerses":49}