{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NEH","translationId":"bod_ntb","name":"ནེ་ཧེམ་ཡཱ།","commonName":"ནེ་ཧེམ་ཡཱ།","title":"༄༅། །ནེ་ཧེམ་ཡཱའི་མདོ།","order":16,"numberOfChapters":13,"sha256":"8da814755655b7409c9d9b29c353315ca2b71074de41b900086b00fdb81690ab","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":11,"content":[{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་དུ་བསྡད་ཡོད་པའི་མི།"]},{"type":"verse","number":1,"content":["ཡང་འབངས་མིའི་འགོ་དཔོན་རྣམས་ཡེ་རུ་སཱ་ལེམ་དུ་གཞི་སྡོད་བྱས་པ་དང་། དེའི་འཕྲོ་ཡི་འབངས་མི་རྣམས་ཀྱིས་རྒྱན་བླངས་ནས་མི་བཅུ་རེའི་ནང་ནས་གཅིག་བདམས་པ་དེ་གྲོང་ཁྱེར་དམ་པ་ཡེ་རུ་སཱ་ལེམ་དུ་གཞི་སྡོད་བྱས་པ་དང་། གཞན་མི་དགུ་བོ་ནི་གྲོང་ཁྱེར་གཞན་དུ་གནས་སོ། །"]},{"type":"verse","number":2,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་དགའ་མོས་ངང་འདུག་པར་འབངས་མི་ཐམས་ཅད་ཀྱིས་དེ་དག་ལ་བྱིན་གྱིས་བརླབས་པ་ཡིན།"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་པ་དང་། མཆོད་དཔོན། ལེ་ཝི་པ། མཆོད་གཡོག སོ་ལོ་མོན་གྱི་ཞབས་ཕྱི་པ་རྣམས་ཀྱི་བུ་རྒྱུད་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་ནང་དུ་གནས་པ་དང་། རེ་རེ་རང་རང་གི་མཁར་གྲོང་ནང་དུ་རང་གི་ས་གནས་སུ་སྡོད་པ་དང་། ཡེ་རུ་སཱ་ལེམ་དུ་གཞི་སྡོད་བྱེད་པའི་ས་འདིའི་འགོ་དཔོན་རྣམས་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":4,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པ་ནི་ཡ་ཧུ་དཱ་པ་ཁ་ཤས་དང་པེན་ཡཱ་མེན་པ་ཁ་ཤས་ཡོད་པ་སྟེ། ཡ་ཧུ་དཱ་པ་ལས་ཕེ་རེལ་ཟིའི་བུ་རྒྱུད་ཨ་ཐ་ཡཱ་ཡོད་པ་ཡིན། ཨ་ཐ་ཡཱ་ནི་ཨུ་ཟི་ཡཱའི་བུ་དང་། ཨུ་ཟི་ཡཱ་ནི་ཟཱ་ཀར་ཡའི་བུ་དང་། ཟཱ་ཀར་ཡ་ནི་ཨ་མར་ཡཱའི་བུ་དང་། ཨ་མར་ཡཱ་ནི་ཤེ་ཕད་ཡཱའི་བུ་དང་། ཤེ་ཕད་ཡཱ་ནི་མཱ་ཧ་ལ་ཨེལ་གྱི་བུའོ། །"]},{"type":"verse","number":5,"content":["དེར་མ་ཟད་པ་རུག་གི་བུ་མ་ཨ་སེ་ཡཱ་ཡོད་པ་དང་། པ་རུག་ནི་ཀོལ་ཧོ་ཟེའི་བུ་དང་། ཀོལ་ཧོ་ཟེ་ནི་ཧ་ཟ་ཡཱའི་བུ་དང་། ཧ་ཟ་ཡཱ་ནི་ཨ་ད་ཡཱའི་བུ་དང་། ཨ་ད་ཡཱ་ནི་ཡོ་ཡ་རིབ་ཀྱི་བུ་དང་། ཡོ་ཡ་རིབ་ནི་ཟཱ་ཀར་ཡའི་བུ་དང་། ཟཱ་ཀར་ཡ་ནི་ཞི་ལོ་པའི་བུའོ། །"]},{"type":"verse","number":6,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་ཕེ་རེལ་ཟིའི་བུ་རྒྱུད་བསྡོམས་པས་བཞི་བརྒྱ་དྲུག་ཅུ་རེ་བརྒྱད་ཡོད། ཐམས་ཅད་དཔའ་རྩལ་ཅན་ཡིན།"]},{"type":"verse","number":7,"content":["ཡང་པེན་ཡཱ་མེན་པའི་ཁྲོད་སལ་ལུ་ཡོད་པ་དང་། སལ་ལུ་ནི་མཱེ་ཤུལ་ལིམ་གྱི་བུ་དང་། མཱེ་ཤུལ་ལིམ་ནི་ཡོ་ཨེད་ཀྱི་བུ་དང་། ཡོ་ཨེད་ནི་ཕེ་ད་ཡཱའི་བུ་དང་། ཕེ་ད་ཡཱ་ནི་ཀོ་ལ་ཡཱའི་བུ་དང་། ཀོ་ལ་ཡཱ་ནི་མ་ཨ་སེ་ཡཱའི་བུ་དང་། མ་ཨ་སེ་ཡཱ་ནི་ཨི་ཐི་ཨེལ་གྱི་བུ་དང་། ཨི་ཐི་ཨེལ་ནི་ཡེ་ཤ་ཡཱའི་བུའོ། །"]},{"type":"verse","number":8,"content":["ཡང་དེའི་རྗེས་སུ་གབ་བ་ཨི་དང་སལ་ལཱ་ཨི་བཅས་མི་དགུ་བརྒྱ་དང་ཉེར་བརྒྱད་ཡོད་དོ། །"]},{"type":"verse","number":9,"content":["ཟིག་རིའི་བུ་ཡོ་ཨེལ་ནི་དེ་དག་གི་འགོ་དཔོན་ཡིན་པ་དང་། ཧ་སེ་ནུ་ཨའི་བུ་ཡ་ཧུ་དཱ་ཞེས་བྱ་བ་ནི་ཡེ་རུ་སཱ་ལེམ་གྱི་འགོ་དཔོན་གཞོན་པ་ཡིན།"]},{"type":"verse","number":10,"content":["ཡང་མཆོད་དཔོན་རྣམས་ཀྱི་གྲས་ནས་ཡོ་ཡ་རིབ་ཀྱི་བུ་ཡེ་དཱ་ཡ་དང་། ད་དུང་ཡཱ་ཀིན་ཞེས་པ་དང་།"]},{"type":"verse","number":11,"content":["དཀོན་མཆོག་གི་མཆོད་ཁང་དུ་བདག་གཉེར་བྱེད་མཁན་སེ་ར་ཡཱ་ཡང་ཡོད་པ་དང་། སེ་ར་ཡཱ་ནི་ཧིལ་ཀི་ཡཱའི་བུ་དང་། ཧིལ་ཀི་ཡཱ་ནི་མཱེ་ཤུལ་ལིམ་གྱི་བུ་དང་། མཱེ་ཤུལ་ལིམ་ནི་ཟཱ་ཏོག་གི་བུ་དང་། ཟཱ་ཏོག་ནི་མེ་ར་ཡོད་ཀྱི་བུ་དང་། མེ་ར་ཡོད་ནི་ཨ་ཧི་ཏུབ་ཀྱི་བུ་ཡིན་ནོ། །"]},{"type":"verse","number":12,"content":["ཡང་མཆོད་ཁང་དུ་ཞབས་ཏོག་སྒྲུབ་པ་དེ་དག་གི་སྤུན་བརྒྱད་བརྒྱ་དང་ཉེར་གཉིས་ཡོད་པ་ཡིན། དེར་མ་ཟད་ཨ་ད་ཡཱ་ཡོད་པ་སྟེ། ཨ་ད་ཡཱ་ནི་ཡེ་རོ་ཧམ་གྱི་བུ་དང་། ཡེ་རོ་ཧམ་ནི་ཕེ་ལལ་ཡའི་བུ་དང་། ཕེ་ལལ་ཡ་ནི་ཨམ་ཙིའི་བུ་དང་། ཨམ་ཙི་ནི་ཟཱ་ཀར་ཡའི་བུ་དང་། ཟཱ་ཀར་ཡ་ནི་ཕཱ་ཤུར་གྱི་བུ་དང་། ཕཱ་ཤུར་ནི་མལ་ཀི་ཡཱའི་བུའོ། །"]},{"type":"verse","number":13,"content":["ཡང་ཁོ་ཚོའི་སྤུན་ཚོ་དཔོན་ཡིན་པ་ཉིས་བརྒྱ་བཞི་བཅུ་ཞེ་གཉིས་ཡོད་པ་དང་། ཡང་ཨ་མས་སཱ་ཨི་ཡོད་པ་སྟེ། ཨ་མས་སཱ་ཨི་ནི་ཨ་ཟ་ར་ཨེལ་གྱི་བུ་དང་། ཨ་ཟ་ར་ཨེལ་ནི་ཨ་ཧ་ས་ཨིའི་བུ་དང་། ཨ་ཧ་ས་ཨི་ནི་མེ་ཤིལ་ལེ་མོད་ཀྱི་བུ་དང་། མེ་ཤིལ་ལེ་མོད་ནི་ཨིམ་མེར་གྱི་བུའོ། །"]},{"type":"verse","number":14,"content":["ཡང་དེ་དག་གི་སྤུན་དཔའ་རྩལ་ཅན་བསྡོམས་པས་བརྒྱ་དང་ཉེར་བརྒྱད་ཡོད་པ་དང་། དེ་དག་གི་འགོ་དཔོན་ནི་ཧ་གེ་དོ་ལིམ་གྱི་བུ་ཟབ་དི་ཨེལ་ཡིན།"]},{"type":"verse","number":15,"content":["ཡང་ལེ་ཝི་པ་རྣམས་ལས་ཤེ་མཱ་ཡ་ཡོད་པ་སྟེ། ཤེ་མཱ་ཡ་ནི་ཧ་ཤུབ་ཀྱི་བུ་དང་། ཧ་ཤུབ་ནི་ཨས་རི་ཀམ་གྱི་བུ་དང་། ཨས་རི་ཀམ་ནི་ཧ་ཤབ་ཡཱའི་བུ་དང་། ཧ་ཤབ་ཡཱ་ནི་པུན་ནིའི་བུའོ། །"]},{"type":"verse","number":16,"content":["ཡང་ལེ་ཝི་པའི་ཚོ་དཔོན་ཤབ་བེ་ཐ་ཨི་དང་ཡོ་ཟཱ་བད་གཉིས་ཀྱིས་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཕྱི་རོལ་གྱི་ལས་ལ་བདག་བྱེད་པ་ཡིན།"]},{"type":"verse","number":17,"content":["གསོལ་བ་འདེབས་པའི་ཚེ་བསྟོད་པ་འབུལ་བའི་དབུ་མཛད་དུ་མི་ཀཱ་ཡི་བུ་མད་ཐན་ཡཱ་ཡོད་པ་ཡིན། མི་ཀཱ་ནི་ཟབ་དིའི་བུ་དང་། ཟབ་དི་ནི་ཨ་སབ་ཀྱི་བུའོ། །ཡང་མད་ཐན་ཡཱའི་སྤུན་རྣམས་ལས་པག་པུག་ཡཱ་ནི་འགོ་དཔོན་གཞོན་པ་ཡིན་ལ། ད་དུང་ཨབ་དཱ་ཡོད་པ་སྟེ། ཨབ་དཱ་ནི་ཤམ་མུ་ཨའི་བུ་དང་། ཤམ་མུ་ཨ་ནི་ག་ལལ་གྱི་བུ་དང་། ག་ལལ་ནི་ཡེ་དུ་ཐུན་གྱི་བུའོ། །"]},{"type":"verse","number":18,"content":["གྲོང་ཁྱེར་དམ་པ་རུ་གནས་པའི་ལེ་ཝི་པའི་བསྡོམས་གྲངས་ནི་ཉིས་བརྒྱ་བརྒྱད་ཅུ་གྱ་བཞི་ཡོད་པ་ཡིན།"]},{"type":"verse","number":19,"content":["སྒོ་སྲུང་ཨག་ཀུབ་དང་ཏལ་མོན་གཉིས་དང་། སྒོ་རེ་རེ་བསྲུངས་པ་དེ་དག་གི་སྤུན་བརྒྱ་དང་བདུན་ཅུ་དོན་གཉིས་ཡོད་པ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["དེ་འཕྲོའི་ཡེས་ར་ཨེལ་པ་དང་མཆོད་དཔོན་དང་ལེ་ཝི་པ་ཐམས་ཅད་ཡ་ཧུ་དཱའི་གྲོང་ཁྱེར་སོ་སོ་རུ་རང་རང་གི་གནས་སུ་བསྡད་ཡོད།"]},{"type":"verse","number":21,"content":["མཆོད་གཡོག་རྣམས་ནི་ཨོ་ཕེལ་དུ་གནས་ཏེ། ཁོ་ཚོར་ཙི་ཧཱ་དང་གེས་པ་གཉིས་ཀྱིས་བདག་སྐྱོང་བྱེད་ཀྱི་ཡོད་པ་ཡིན།"]},{"type":"verse","number":22,"content":["ཡང་ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་ལེ་ཝི་པ་རྣམས་ཀྱི་འགོ་དཔོན་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་ལ་བདག་སྐྱོང་བྱེད་པའི་ལས་ནི་མགུར་ལེན་མཁན་ཨ་སབ་ཀྱི་བུ་རྒྱུད་ཨུ་ཟི་ཡིན་པ་དང་། ཨུ་ཟི་ནི་པཱ་ནིའི་བུ་དང་། པཱ་ནི་ནི་ཧ་ཤབ་ཡཱའི་བུ་དང་། ཧ་ཤབ་ཡཱ་ནི་མད་ཐན་ཡཱའི་བུ་དང་། མད་ཐན་ཡཱ་ནི་མི་ཀཱའི་བུའོ། །"]},{"type":"verse","number":23,"content":["ཡང་རྒྱལ་པོའི་བཀའ་ལྟར་མགུར་ལེན་མཁན་དག་ལ་ཉིན་རེ་བཞིན་དུ་འབྲུ་ཕོག་སྦྱིན་པ་ཡིན།"]},{"type":"verse","number":24,"content":["ཡང་ཡ་ཧུ་དཱའི་བུ་ཟེ་རག་གི་བུ་རྒྱུད་ལས་བྱུང་བའི་མེ་ཤེ་ཟ་བེ་ཨེལ་གྱི་བུ་ཕེ་ཐ་ཡཱ་ནི་འབངས་མིའི་བྱ་བ་ཐམས་ཅད་བསྒྲུབ་པར་རྒྱལ་པོའི་སྐུ་མདུན་དུ་ཡོད་པ་ཡིན་ནོ། །"]},{"type":"heading","content":["གྲོང་རྡལ་དང་གྲོང་ཚོ་གཞན་དུ་སྡོད་པའི་མི།"]},{"type":"verse","number":25,"content":["གྲོང་ཚོ་དང་ཞིང་ས་སོ་སོའི་སྐོར་ནི། ཡ་ཧུ་དཱ་པ་རྣམས་ནི་ཀིར་ཡཱད་ཨར་པཱ་དང་དེའི་གྲོང་རྡལ་དུ་གནས་པ་དང་། དི་བོན་དང་དེའི་གྲོང་རྡལ་དུ་གནས་པ་དང་། ཡེ་ཀབ་ཙེ་ཨེལ་དང་དེའི་གྲོང་ཚོ་རུ་གནས་པ་ཡིན།"]},{"type":"verse","number":26,"content":["གཞན་ཡང་། ཡེ་ཤུ་ཨ་དང་མོ་ལ་དཱ་དང་པེད་ཕེ་ལེད་དང་།"]},{"type":"verse","number":27,"content":["ཧ་ཚར་ཤུ་ཨལ་དང་པེར་ཤ་བཱ་དང་དེའི་གྲོང་རྡལ་རྣམས་དང་།"]},{"type":"verse","number":28,"content":["ཙིག་ལག་དང་མེ་ཁོ་ནཱ་དང་དེའི་གྲོང་རྡལ་རྣམས་དང་།"]},{"type":"verse","number":29,"content":["ཨེན་རིམ་མོན་དང་ཚོར་ཨ་དང་ཡར་མུད་དང་།"]},{"type":"verse","number":30,"content":["ཟཱ་ནོ་ཨ་དང་ཨ་དུལ་ལཱམ་དང་དེ་དག་གི་གྲོང་ཚོ་རྣམས་དང་། ལཱ་ཀི་སི་དང་དེའི་ཞིང་ས་རྣམས་དང་། ཨ་ཟེ་ཀཱ་དང་དེའི་གྲོང་རྡལ་རྣམས་དང་པེར་ཤ་བཱ་ནས་ཧིན་ནོམ་ལུང་པའི་བར་དུ་གཞི་སྡོད་བྱེད་པ་ཡིན།"]},{"type":"verse","number":31,"content":["པེན་ཡཱ་མེན་པ་རྣམས་ནི་གེ་བཱ་ནས་བཟུང་སྟེ། མིགས་མཱ་སི་དང་ཨ་ཡཱ་དང་པེད་ཨེལ་དང་དེའི་གྲོང་རྡལ་རྣམས་སུ་གཞི་སྡོད་བྱེད་པ་ཡིན།"]},{"type":"verse","number":32,"content":["ཨ་ན་ཐོད་དང་ནོབ་དང་ཨ་ནན་ཡཱ་དང་།"]},{"type":"verse","number":33,"content":["ཧ་ཟོར་དང་རཱ་མ་དང་གིད་ཏཱ་ཡིམ་དང་།"]},{"type":"verse","number":34,"content":["ཧ་དིད་དང་ཙེ་བོ་ཡིམ་དང་ནེ་བལ་ལད་དང་།"]},{"type":"verse","number":35,"content":["ལོད་དང་། ཨོ་ནོ་དང་ལག་ཤེས་ལུང་པའི་བར་དུ་གནས་པ་དང་།"]},{"type":"verse","number":36,"content":["ཡང་ཡ་ཧུ་དཱའི་ས་ཁུལ་གྱི་ལེ་ཝི་པ་ཁ་ཤས་པེན་ཡཱ་མེན་ལ་དབང་བ་ཡིན་ནོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NEH/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NEH/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NEH/10.json","previousChapterAudioLinks":{},"numberOfVerses":36}