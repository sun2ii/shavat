{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NEH","translationId":"bod_ntb","name":"ནེ་ཧེམ་ཡཱ།","commonName":"ནེ་ཧེམ་ཡཱ།","title":"༄༅། །ནེ་ཧེམ་ཡཱའི་མདོ།","order":16,"numberOfChapters":13,"sha256":"8da814755655b7409c9d9b29c353315ca2b71074de41b900086b00fdb81690ab","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":13,"content":[{"type":"heading","content":["ཕྱི་ཕྱོགས་ཀྱི་མི་རྣམས་དང་ཁ་བྲལ་བ།"]},{"type":"verse","number":1,"content":["ཉིན་དེར་འབངས་མིས་མོ་ཤེའི་མདོ་དེ་ཀློག་པ་ཐོས་ནས། ཨམ་མོན་པ་དང་མོ་ཨབ་པ་རྣམས་དཀོན་མཆོག་གི་ཚོགས་འདུའི་ཁྲོད་དུ་ནམ་ཡང་ཡོང་མི་ཆོག་པ་དེའི་ནང་དུ་བཀོད་ཡོད་པ་ཤེས་སོ། །"]},{"type":"verse","number":2,"content":["གང་ལ་ཞེ་ན། དེ་དག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་བསུ་བར་བག་ལེབ་དང་ཆུ་ཁུར་ནས་མ་འོངས་པ་དང་། པེལ་ཨམ་གླས་ནས་དེ་རྣམས་ལ་དམོད་པ་བྱས་ནའང་། ངེད་ཀྱི་དཀོན་མཆོག་གིས་དམོད་པ་དེ་བྱིན་རླབས་སུ་བསྒྱུར་བར་མཛད་དོ། །"]},{"type":"verse","number":3,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་བཀའ་ཁྲིམས་དེ་ཐོས་མ་ཐག་ཏུ་རིགས་རྒྱུད་འདྲེས་མ་ཐམས་ཅད་ལས་སོ་སོར་ཕྱེས་སོ། །"]},{"type":"heading","content":["ནེ་ཧེམ་ཡཱ་ཡིས་མཐའ་མཇུག་གི་བསྒྱུར་བཅོས་བྱས་པ།"]},{"type":"verse","number":4,"content":["ཡང་དོན་འདིའི་སྔོན་དུ་ཏོ་བི་ཡཱ་དང་གཉེན་ཉེ་ཡིན་པའི་མཆོད་དཔོན་ཨེལ་ཡཱ་ཤིབ་གཉིས་ཀྱིས། མངགས་བཅོལ་ལྟར་རང་ཅག་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་མཛོད་ཁང་དུ་བདག་གཉེར་བྱེད་པ་དང་།"]},{"type":"verse","number":5,"content":["ཏོ་བི་ཡཱར་ཁང་པ་ཆེན་པོ་ཞིག་གྲ་སྒྲིག་བྱས་ཡོད་པ་སྟེ། དེ་ནི་སྔོན་ཆད་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། སྤོས་དཀར་དང་། སྣོད་ཆས་བཅས་དང་། ཁྲིམས་སྲོལ་ལྟར་ལེ་ཝི་པ་རྣམས་དང་མགུར་ལེན་མཁན་དང་། སྒོ་སྲུང་བཅས་ལ་འབུལ་བྱའི་འབྲུ་དང་རྒུན་ཆང་། སྣུམ་བཅས་ཀྱི་བཅུ་ཆའི་གཅིག་དང་། མཆོད་དཔོན་ལ་དབང་བའི་འདེགས་མཆོད་བཅས་བསྡུས་ཡོད་པའི་ཁང་པ་ཡིན་ནོ། །"]},{"type":"verse","number":6,"content":["དོན་འདི་ཐམས་ཅད་འབྱུང་དུས་སུ་ང་ནི་ཡེ་རུ་སཱ་ལེམ་དུ་མེད། གང་ལ་ཞེ་ན། པཱ་པེལ་ལོན་གྱི་རྒྱལ་པོ་ཨར་ཐག་ཤཱ་ཐིའི་སྲིད་ལོ་སོ་གཉིས་པར་ང་རྒྱལ་པོའི་དྲུང་དུ་ཕྱིན་པ་དང་། ཉིན་འགའ་ཤས་བསྡད་རྗེས་རྒྱལ་པོ་དང་འབྲལ་བའི་དགོངས་པ་ཞུས།"]},{"type":"verse","number":7,"content":["ཡེ་རུ་སཱ་ལེམ་དུ་སླེབས་ནས། ཨེལ་ཡཱ་ཤིབ་ཀྱིས་ཏོ་བི་ཡཱའི་ཆེད་དུ་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ཚོམས་སྐོར་ནང་དུ་ཁང་མིག་ཅིག་གྲ་སྒྲིག་བྱས་པའི་དོན་ངན་འདི་རྟོགས་པ་དང་།"]},{"type":"verse","number":8,"content":["ང་ཁོང་ཁྲོ་ཆེན་པོ་ལངས་ནས་ཏོ་བི་ཡཱའི་ཁྱིམ་གྱི་ནོར་རྫས་ཐམས་ཅད་མཛོད་ཁང་དེའི་ནང་ནས་ཕྱིར་འཕངས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ངས་བཀའ་བསྒོས་ཏེ་ཁང་པ་དེའི་ནང་གཙང་མ་བྱས་པ་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་གི་སྣོད་ཆས་རྣམས་དང་། འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། སྤོས་དཀར་རྣམས་སླར་དེའི་ནང་དུ་བཞག་གོ །"]},{"type":"verse","number":10,"content":["ཡང་ངས་ལེ་ཝི་པ་རྣམས་ལ་ནོར་སྐལ་མི་སུས་ཀྱང་མ་སྤྲད་པས། ཞབས་ཏོག་སྒྲུབ་པའི་ལེ་ཝི་པ་དང་མགུར་ལེན་མཁན་ཀུན་པོ་རང་ཉིད་ཀྱི་ཞིང་སར་ཕྱིན་པ་ཤེས་ཚོར་བྱུང་།"]},{"type":"verse","number":11,"content":["དེ་ནས་ངས་འགོ་དཔོན་དག་ལ་གཤེ་གཤེ་བཏང་ནས་འདི་ལྟར། དཀོན་མཆོག་གི་མཆོད་ཁང་སྤངས་བཞག་པ་ཅི་ཡིན་ནམ་ཞེས་སྨྲས་ཤིང་། ངས་ལེ་ཝི་པ་རྣམས་མཉམ་དུ་བསྡུས་ཏེ་རང་རང་གི་ལས་སྣེར་བཞག་གོ །"]},{"type":"verse","number":12,"content":["དེ་ནས་ཡ་ཧུ་དཱ་པ་ཐམས་ཅད་ཀྱིས་འབྲུ་དང་རྒུན་ཆང་གསར་པ་དང་། སྣུམ་གསར་པ་བཅས་ཀྱི་བཅུ་ཆའི་གཅིག་དཀོར་མཛོད་དུ་བསྐྱལ་བྱུང་།"]},{"type":"verse","number":13,"content":["ཡང་ངས་མཆོད་དཔོན་ཤེ་ལེམ་ཡཱ་དང་དྲུང་ཡིག་ཟཱ་ཏོག་དང་། ལེ་ཝི་པ་ཕེ་ད་ཡཱ་བྱ་བ་བཅས་གསུམ་པོ་དཀོར་མཛོད་ཀྱི་གཉེར་པར་བསྐོས་ཏེ། དེ་དག་གི་གཉེར་གཡོག་ཏུ་ཧ་ནན་བསྐོས། ཧ་ནན་ནི་ཟག་ཀུར་གྱི་བུ་དང་། ཟག་ཀུར་ནི་མད་ཐན་ཡཱའི་བུའོ། །དེ་དག་ནི་མི་གཞུང་དྲང་ཡིན་ཏེ། རང་གི་སྤུན་རྣམས་ལ་བགོ་བཤའ་རྒྱག་པ་ནི་དེ་དག་གི་ལས་འགན་ཡིན་ནོ། །"]},{"type":"verse","number":14,"content":["ཀྱེ། ངའི་དཀོན་མཆོག་ལགས། ངས་རང་གི་དཀོན་མཆོག་གི་མཆོད་ཁང་དོན་དུ་སེམས་གཏིང་ནས་ལས་བཟང་པོ་བསྒྲུབས་པས་བདག་མ་འདོར་ཅིག འདིའི་ཕྱིར་དུའང་བདག་དྲན་དུ་གསོལ་ལོ། །"]},{"type":"verse","number":15,"content":["ཉིན་དེ་དག་གི་རིང་ལ་ངས་ཡ་ཧུ་དཱ་རུ་མི་ཁ་ཤས་ཀྱིས་ངལ་གསོ་བའི་ཉིན་ལ་རྒུན་ཆང་འཚིར་གནོན་བྱེད་པ་དང་། ཚར་ཕོན་མང་པོ་བོང་བུ་ལ་ཁལ་འགེལ་བ་དང་། རྒུན་ཆང་དང་རྒུན་འབྲུམ་དང་། སེ་ཡབ་དང་ཁུར་པོ་གང་རུང་ཡེ་རུ་སཱ་ལེམ་དུ་ངལ་གསོ་བའི་ཉིན་མོར་སྐྱེལ་བ་མཐོང་ནས། དེ་དག་གིས་ཉོ་ཚོང་བྱེད་པའི་ཉིན་མོར་ངས་དེ་རྣམས་ལ་ཉེན་བརྡ་བཏང་བ་ཡིན།"]},{"type":"verse","number":16,"content":["དེར་མ་ཟད། ཡེ་རུ་སཱ་ལེམ་དུ་གནས་པའི་ཐཱར་པ་འགའ་ཤས་ཀྱིས་ཀྱང་ཉ་དང་ཚོང་རིགས་སྣ་ཚོགས་ནང་དུ་དྲངས་ནས་ངལ་གསོ་བའི་ཉིན་མོར་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་བཙོངས་སོ། །"]},{"type":"verse","number":17,"content":["དེར་ངས་ཡ་ཧུ་དཱའི་སྐུ་དྲག་རྣམས་ལ་གཤེ་གཤེ་བཏང་ནས་འདི་ལྟར། ཁྱོད་ཅག་གིས་ལས་ངན་པ་འདི་བྱས་ནས་ངལ་གསོ་བའི་ཉིན་མོ་བཙོག་པར་བྱེད་པ་ཅི་ཡིན་ནམ།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱི་ཕ་མེས་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱས་པས། བདག་ཅག་གི་དཀོན་མཆོག་གིས་ང་རང་ཚོ་དང་། ཐ་ན་གྲོང་ཁྱེར་འདིའི་སྟེང་དུ་གནོད་པ་འདི་ཚང་མ་བཏང་བ་མ་ཡིན་ནམ། ད་ལྟ་ངལ་གསོ་བའི་ཉིན་མོ་བཙོག་པར་བྱས་པ་དང་བསྟུན་ནས་ཁྱོད་ཅག་གིས་ཡེས་ར་ཨེལ་ལ་གཏུམ་དྲག་མང་པོ་བསྐྱལ་ཡོང་ངོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":19,"content":["ངལ་གསོ་བའི་ཉིན་གྱི་ཉིན་སྔོན་མ་ས་རུབ་ཁར་བདག་གིས་ཡེ་རུ་སཱ་ལེམ་གྱི་སྒོ་ཐམས་ཅད་ཟྭ་རྒྱག་དགོས་པ་དང་། ཡང་ངལ་གསོ་བའི་ཉིན་མོ་མ་འདས་བར་དུ་སྒོ་ཕྱེ་མི་ཆོག་པའི་བཀའ་བབས་པ་ཡིན། ཡང་ངལ་གསོ་བའི་ཉིན་མོར་གྲོང་ཁྱེར་ནང་དུ་ཁུར་པོ་བསྐྱལ་མི་ཡོང་བའི་ཆེད་དུ། བདག་གིས་གཡོག་པོ་འགའ་ཞིག་མངགས་ནས་མཁར་སྒོ་སྲུང་དུ་བཅུག་པ་ཡིན།"]},{"type":"verse","number":20,"content":["དེའི་རྐྱེན་གྱིས་ཚོང་པ་དང་ཚོང་རིགས་སྣ་ཚོགས་འཚོང་མཁན་རྣམས་ཐེངས་གཅིག་གཉིས་ལ་ཡེ་རུ་སཱ་ལེམ་གྲོང་ཁྱེར་ཕྱི་རོལ་ཏུ་ཞག་སྡོད་བྱས།"]},{"type":"verse","number":21,"content":["ངས་དེ་དག་ལ་ཉེན་བརྡ་བཏང་ནས་འདི་ལྟར། ཁྱོད་ཅག་གིས་ཅིའི་ཕྱིར་མཁར་གྱང་མདུན་ནས་མཚན་བསྐྱལ་ལམ། ཡང་བསྐྱར་འདི་འདྲ་བྱེད་ན་ངས་ཁྱོད་ཚོར་ལག་འགུལ་ངེས་ཡིན་ཞེས་སྨྲས་པས། དེ་ནས་བཟུང་དེ་དག་ངལ་གསོ་བའི་ཉིན་མོར་མ་འོངས་སོ། །"]},{"type":"verse","number":22,"content":["ངས་ལེ་ཝི་པ་རྣམས་ལ་གཙང་སྦྲ་བྱས་ནས་ཡོང་སྟེ་མཁར་སྒོ་བསྲུང་དགོས་པ་དང་། ངལ་གསོ་བའི་ཉིན་མོ་དམ་པར་བརྩི་དགོས་པའི་བཀའ་བབས་པ་ཡིན། ཀྱེ། ངའི་དཀོན་མཆོག་ལགས། འདིའི་ཕྱིར་དུ་བདག་དྲན་པར་མཛོད། ཁྱེད་ཀྱི་ཐུགས་བརྩེ་བ་ཕུན་སུམ་ཚོགས་པས་བདག་ལ་གཟིགས་སུ་གསོལ་ལོ། །"]},{"type":"verse","number":23,"content":["ཉིན་དེ་དག་གི་རིང་ལ་ཡང་བདག་གིས་ཡ་ཧུ་དཱ་པ་དག་ཨ་སི་དོད་པ་དང་། ཨམ་མོན་པ་དང་། མོ་ཨབ་པ་བཅས་ཀྱི་བུད་མེད་རྣམས་དང་གཉེན་བསྒྲིགས་པ་མཐོང་བྱུང་།"]},{"type":"verse","number":24,"content":["དེ་དག་གི་བུ་དང་བུ་མོ་རྣམས་ལས་ཕྱེད་ཀས་ཨ་སི་དོད་ཀྱི་སྐད་སྨྲ་བ་དང་། ཡང་ན་མི་རིགས་གཞན་པའི་སྐད་སྨྲ་ཞིང་། ཡ་ཧུ་དཱའི་སྐད་སྨྲ་མི་ཤེས་སོ། །"]},{"type":"verse","number":25,"content":["ངས་དེ་དག་ལ་གཤེ་གཤེ་བཏང་ནས་དམོད་པ་བཏབ་སྟེ། མི་འགའ་ཞིག་ལ་གཅར་རྡུང་བྱས། དེ་དག་གི་མགོའི་སྐྲ་ཡང་བལ་ཞིང་། དཀོན་མཆོག་དཔང་དུ་བཙུགས་ནས་མནའ་བསྐྱལ་དུ་བཅུག་པ་སྟེ། ཁྱོད་ཅག་གིས་རང་གི་བུ་མོ་ཕྱི་རོལ་པའི་བུ་ལ་གཉེན་འབྲེལ་བྱེད་དུ་འཇུག་མི་ཆོག་པ་དང་། ཡང་རང་ཉིད་ཀྱི་བུ་ལ་དེ་དག་གི་བུ་མོ་ཆུང་མར་བླང་མི་ཆོག"]},{"type":"verse","number":26,"content":["ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་སོ་ལོ་མོན་གྱིས་ཀྱང་དོན་འདིའི་སྟེང་དུ་སྡིག་པ་མ་བྱས་སམ། རྒྱལ་ཁབ་མང་པོ་ཞིག་གི་ནང་དུ་ཁོང་ལྟ་བུའི་རྒྱལ་པོ་མེད་པ་དང་། དཀོན་མཆོག་གིས་ཁོང་ལ་ཧ་ཅང་གཅེས་པས་ཡེས་ར་ཨེལ་ཡོངས་ལ་བདག་སྐྱོང་བྱེད་པའི་རྒྱལ་པོར་བསྐོས་ཡོད། དེ་ལྟ་ནའང་ཕྱི་ཕྱོགས་པའི་བུད་མེད་རྣམས་ཀྱིས་ཁོང་སྡིག་པའི་ནང་ལྷུང་དུ་བཅུག་གོ །"]},{"type":"verse","number":27,"content":["ང་ཚོས་ཁྱོད་ཅག་གིས་དོན་ངན་འདི་རྣམས་བྱེད་པ་རྒྱ་ཡན་དུ་བཏང་ནས། ཕྱི་ཕྱོགས་པའི་བུད་མེད་དང་གཉེན་བསྒྲིགས་ཏེ་ངེད་ཀྱི་དཀོན་མཆོག་ལ་སྡིག་པ་བྱེད་དུ་འཇུག་ག་ལ་རུང་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":28,"content":["ཡང་མཆོད་དཔོན་ཆེན་པོ་ཨེལ་ཡཱ་ཤིབ་ཀྱི་བུ་ཡོ་ཡ་དཱའི་བུ་རྣམས་ལས་གཅིག་ནི་ཧོ་རོན་པ་སན་པཱ་ལད་ཀྱི་མག་པ་ཡིན་པས། ངས་ཁོ་རང་ངའི་མདུན་ནས་ཕར་བསྐྲད་པ་ཡིན།"]},{"type":"verse","number":29,"content":["ཀྱེ། ངའི་དཀོན་མཆོག་ལགས། དེ་དག་གི་སྡིག་པ་ཐུགས་སུ་དགོངས་པར་མཛོད་ཅིག དེ་དག་གིས་མཆོད་དཔོན་གྱི་གོ་གནས་སྦགས་ཤིང་། མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱི་དམ་བཅའ་དང་འགལ་ལོ། །"]},{"type":"verse","number":30,"content":["དེ་ལྟར་ངས་ཁོ་རྣམས་ལ་གཙང་སྦྲ་བྱས་ཏེ། ཕྱི་ཕྱོགས་པ་རྣམས་ལ་གཏོགས་པ་ཐམས་ཅད་ལས་ཕྲལ་ཞིང་། ཡང་ངས་མཆོད་དཔོན་དང་ལེ་ཝི་པ་རྣམས་ཀྱི་ལས་རེས་གཏན་ལ་ཕབ་སྟེ་ཁོ་རྣམས་ལ་རང་རང་གི་ལས་འགན་བསྒྲུབ་ཏུ་བཅུག་ཅིང་།"]},{"type":"verse","number":31,"content":["དུས་ལྟར་འབུད་ཤིང་དང་སྐྱེ་དངོས་ཐོག་མ་རྣམས་ཕུལ་ཏོ། །ཀྱེ། ངའི་དཀོན་མཆོག་ལགས། བདག་ཐུགས་སུ་བཟུང་ནས་དྲིན་གྱིས་སྐྱོང་བར་མཛོད་ཅིག ། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NEH/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/EST/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NEH/12.json","previousChapterAudioLinks":{},"numberOfVerses":31}