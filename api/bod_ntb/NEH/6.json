{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NEH","translationId":"bod_ntb","name":"ནེ་ཧེམ་ཡཱ།","commonName":"ནེ་ཧེམ་ཡཱ།","title":"༄༅། །ནེ་ཧེམ་ཡཱའི་མདོ།","order":16,"numberOfChapters":13,"sha256":"8da814755655b7409c9d9b29c353315ca2b71074de41b900086b00fdb81690ab","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":6,"content":[{"type":"heading","content":["ནེ་ཧེམ་ཡཱས་དགྲ་བོའི་ཇུས་ངན་བརྟོལ་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་སན་པཱ་ལད་དང་ཏོ་བི་ཡཱ། ཨ་རབ་པ་གེ་ཤེམ་དང་། གཞན་དགྲ་བོ་ཀུན་གྱིས་ངས་མཁར་གྱང་བརྩིགས་ཚར་ཞིང་ཞིག་རལ་མེད་པ་ཐོས་པ་དང་། སྐབས་དེར་མཁར་སྒོ་ད་དུང་བཙུགས་མེད།"]},{"type":"verse","number":2,"content":["སན་པཱ་ལད་དང་གེ་ཤེམ་གཉིས་ཀྱིས་ངའི་རྩར་མི་མངགས་ནས་འདི་ལྟར། ཁྱོད་ཕེབས་ཤོག་དང་ངེད་ཅག་ཨོ་ནོའི་ཐང་གི་གྲོང་ཚོ་རུ་མཇལ་ཡོང་ཞེས་སྨྲས་བྱུང་། དོན་དངོས་སུ་དེ་དག་གིས་ང་ལ་གནོད་སྐྱེལ་འདོད་པ་རེད།"]},{"type":"verse","number":3,"content":["དེ་བས་ངས་མི་མངགས་ནས་དེ་ཚོར། ངས་ལས་ཀ་ཆེན་པོ་ལས་བཞིན་ཡོད་པས་ང་རང་མར་འགྲོ་མི་རུང་། ང་ཁ་བྲལ་ནས་མར་ཁྱོད་ཅག་དང་འཕྲད་དུ་སོང་སྟེ་ལས་ཀ་མཚམས་འཇོག་པར་བྱེད་ག་ལ་རུང་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":4,"content":["དེ་རྣམས་ཀྱིས་འདི་ལྟར་ཐེངས་བཞི་ལ་ངའི་རྩར་སྐད་བཏང་ཞིང་ངས་སྔར་བཞིན་ལན་བཏབ་བོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་སན་པཱ་ལད་ཀྱིས་ཐེངས་ལྔ་པར་གོང་བཞིན་དུ་མི་མངགས་ཏེ་ལག་ཏུ་ཡི་གེ་ཐུམ་མེད་པ་ཞིག་བསྐུར་བྱུང་།"]},{"type":"verse","number":6,"content":["ཡིག་ཐོག་ཏུ་འདི་ལྟར། མི་རིགས་སོ་སོའི་ཁྲོད་དུ་འདི་འདྲ་ཞིག་གྲགས་བཞིན་ཡོད་ལ། གེ་ཤེམ་གྱིས་ཀྱང་འདི་བཞིན་སྨྲས་བྱུང་སྟེ། ཁྱོད་དང་ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱིས་ངོ་ལོག་བྱེད་པའི་ཕྱིར། ཁྱོད་ཀྱིས་མཁར་གྱང་བརྩིགས་པ་ཡིན་ལ། གོ་ཐོས་ལྟར་ན། ཁྱོད་དེ་དག་གི་རྒྱལ་པོར་འགྱུར་བའི་དོན་དུ་ཡིན་ཟེར།"]},{"type":"verse","number":7,"content":["ཁྱོད་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་མངགས་པའི་ལུང་སྟོན་པས་ཁྱོད་ལ་དམིགས་ནས་ཡ་ཧུ་དཱ་རུ་རྒྱལ་པོ་ཡོད་ཅེས་སྒྲོག་གོ །ད་ལྟ་གཏམ་འདི་དག་རྒྱལ་པོར་བསྒྲག་པར་འགྱུར། ཁྱོད་རང་ཤོག་དང་ངེད་རྣམས་ལྷན་ཅིག་ཏུ་གྲོས་བྱའོ་ཞེས་བྲིས་འདུག"]},{"type":"verse","number":8,"content":["དེར་ངས་ཁོ་ལ་སྐད་བཏང་སྟེ་འདི་ལྟར། ཁྱོད་ཀྱིས་སྨྲས་པའི་དོན་འདི་དག་གཅིག་ཀྱང་མེད། འདི་ནི་ཁྱོད་རང་གི་རྫུན་བཟོ་ཡིན་ནོ་ཞེས་སྨྲས་པ་ཡིན།"]},{"type":"verse","number":9,"content":["དེ་དག་གིས་ངེད་རྣམས་ལ་འཇིགས་བསྐུལ་ནས་འདི་ལྟར། དེ་རྣམས་ཀྱི་ལག་པའི་སྟོབས་ཞན་པར་གྱུར་ཅིག ལས་སྒྲུབ་མི་ཐུབ་ཅིང་། ལས་ཀ་རྫོགས་པར་བྱ་མི་ནུས་ཞེས་སྨྲས། ད་ལྟ་ངའི་ལག་པར་སྟོབས་གནང་བར་མཛོད་ཅིག"]},{"type":"verse","number":10,"content":["དེའི་རྗེས་སུ་ང་མཱས་ཧེ་ཏ་བེལ་གྱི་ཚ་བོའམ་དི་ལཱ་ཡའི་བུ་ཤེ་མ་ཡཱའི་ཁང་པར་ཕྱིན། སྐབས་དེར་ཁོས་སྒོ་བརྒྱབ་སྟེ་ཕྱིར་མི་འབུད་པ་དང་། ཁོ་ན་རེ། ངེད་གཉིས་དཀོན་མཆོག་གི་མཆོད་ཁང་གི་དཀྱིལ་དུ་འཛོམས་ཏེ་མཆོད་ཁང་གི་སྒོ་རྒྱག་པར་བྱའོ། །གང་ལ་ཞེ་ན། དེ་དག་ཁྱོད་རང་གསོད་དུ་འོང་བ་ཡིན། མཚན་མོ་འོངས་ནས་ཁྱོད་རང་གསོད་དོ་ཞེས་སྨྲས།"]},{"type":"verse","number":11,"content":["ངས་དེ་ལ། ང་ལྟ་བུའི་མི་ཞིག་འབྲོ་བར་བྱེད་དམ། ང་འདྲ་བའི་མི་ཞིག་གིས་རང་སྲོག་སྐྱོབ་པའི་ཆེད་དུ་མཆོད་ཁང་ནང་དུ་འབྱོལ་ལམ། ང་ནང་དུ་མི་འགྲོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":12,"content":["ངས་གསལ་པོར་བལྟས་པ་དང་། དཀོན་མཆོག་གིས་ཁོ་མ་མངགས་སོ། །ཁོ་རང་ཉིད་ཀྱིས་ང་ལ་གནོད་པའི་ལུང་བསྟན་ཏེ། ཏོ་བི་ཡཱ་དང་སན་པཱ་ལད་གཉིས་ཀྱིས་དེ་གླས་པ་རེད།"]},{"type":"verse","number":13,"content":["ང་ལ་འཇིགས་བསྐུལ་ནས་ངས་དེར་བསྟུན་ཏེ་སྡིག་པ་བྱེད་པ་དང་། མིང་ངན་བཞག་ནས་ཁོ་རྣམས་ཀྱིས་འཕྱ་སྨོད་བྱེད་པའི་ཕྱིར་དེ་གླས་པ་རེད།"]},{"type":"verse","number":14,"content":["ཀྱེ། ངའི་དཀོན་མཆོག་ལགས། ཏོ་བི་ཡཱ་དང་སན་པཱ་ལད་དང་ལུང་སྟོན་མ་ནོ་ཨད་ཡཱ་དང་། ལུང་སྟོན་པ་གཞན་དག་གིས་དོན་འདི་དག་བསྒྲུབས་དོན་ནི་ང་ལ་འཇིགས་བསྐུལ་བའི་ཕྱིར་ཡིན་པས། ཁྱེད་ཀྱིས་དེ་དག་ཐུགས་སུ་བཟུང་བར་མཛོད།"]},{"type":"heading","content":["མཁར་གྱང་ལེགས་འགྲུབ་བྱུང་བ།"]},{"type":"verse","number":15,"content":["ཨེ་ལུད་ཟླ་བའི་ཚེས་ཉེར་ལྔ་ཉིན་མཁར་གྱང་བརྩིགས་ཟིན་པ་དང་། བསྡོམས་པས་ཉིན་ལྔ་བཅུ་ང་གཉིས་ལ་ཉམས་གསོ་བྱས་སོ། །"]},{"type":"verse","number":16,"content":["ངེད་རྣམས་ཀྱི་དགྲ་བོ་ཀུན་གྱིས་ཐོས་པ་དང་། ཕྱོགས་བཞིའི་མི་རིགས་རྣམས་འཇིགས་ཤིང་སྐྱོ་མདངས་ཤར། གང་ལ་ཞེ་ན། ལས་འདི་ངེད་ཀྱི་དཀོན་མཆོག་གིས་འགྲུབ་པར་མཛད་པ་དེ་དག་གིས་ཤེས་སོ། །"]},{"type":"verse","number":17,"content":["ཡང་ཉིན་དེ་དག་གི་རིང་ལ་ཡ་ཧུ་དཱའི་སྐུ་དྲག་ཚོས་ཐེངས་མང་པོར་ཏོ་བི་ཡཱ་ལ་ཡི་གེ་བསྐུར་བ་དང་། ཏོ་བི་ཡཱས་ཀྱང་ཡིག་ལན་བསྐུར་ཏོ། །"]},{"type":"verse","number":18,"content":["ཡ་ཧུ་དཱའི་ཡུལ་དུ་མི་མང་པོས་ཏོ་བི་ཡཱ་དང་མནའ་འབྲེལ་བྱས་སོ། །གང་ལ་ཞེ་ན། ཁོ་ནི་ཨ་རཱའི་བུ་ཤེ་ཀན་ཡཱའི་མག་པ་ཡིན་ལ། ཁོའི་བུ་ཡེ་ཧོ་ཧ་ནན་གྱིས་ཀྱང་པེ་རེག་ཡཱའི་བུ་མཱེ་ཤུལ་ལིམ་གྱི་བུ་མོ་བག་མར་བླངས་ཡོད་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":19,"content":["དེ་དག་གིས་ཀྱང་ངའི་མདུན་དུ་ཏོ་བི་ཡཱ་ལ་གཏམ་བཟང་པོ་སྨྲས་པ་དང་། ངའི་གཏམ་ཡང་ཁོ་ལ་བཤད་དོ། །ཏོ་བི་ཡཱས་རྒྱུན་ཏུ་ང་ལ་ཡི་གེ་བསྐུར་ནས་འཇིགས་སྣང་བསྐུལ་ལོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NEH/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NEH/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NEH/5.json","previousChapterAudioLinks":{},"numberOfVerses":19}