{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NEH","translationId":"bod_ntb","name":"ནེ་ཧེམ་ཡཱ།","commonName":"ནེ་ཧེམ་ཡཱ།","title":"༄༅། །ནེ་ཧེམ་ཡཱའི་མདོ།","order":16,"numberOfChapters":13,"sha256":"8da814755655b7409c9d9b29c353315ca2b71074de41b900086b00fdb81690ab","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bod_ntb/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":8,"content":[{"type":"heading","content":["ཨེས་སི་རཱ་ཡིས་བཀའ་ཁྲིམས་ཡོངས་ཁྱབ་ཏུ་བཀླགས་པ།"]},{"type":"verse","number":1,"content":["ཟླ་བདུན་པ་ཚེས་དུས་སུ། འབངས་རྣམས་མི་གཅིག་ལྟར་ཆུ་སྒོའི་མདུན་གྱི་ཐང་ཆེན་དུ་འཛོམས་ནས། དྲུང་ཡིག་ཨེས་སི་རཱ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་ལ་གསུངས་པའི་མོ་ཤེའི་བཀའ་ཁྲིམས་ཀྱི་གླེགས་བམ་ཁྱེར་ཡོང་བར་ཞུས།"]},{"type":"verse","number":2,"content":["དེར་ཟླ་བདུན་པའི་ཚེས་གཅིག་ཉིན་མཆོད་དཔོན་ཨེས་སི་རཱ་ཡིས་ཐོས་ཤིང་དོན་རྟོགས་ནུས་པའི་སྐྱེས་ཕོ་མོ་རྣམས་ཀྱི་མདུན་དུ་བཀའ་ཁྲིམས་ཀྱི་གླེགས་བམ་དེ་ཁྱེར་ཡོང་ནས།"]},{"type":"verse","number":3,"content":["སྔ་དྲོ་ནས་ཉིན་གུང་གི་བར་དུ་ཆུ་སྒོའི་མདུན་གྱི་ཐང་ཆེན་དུ་སྐྱེས་ཕོ་མོ་དང་དོན་རྟོགས་ནུས་པ་ཐམས་ཅད་ཀྱི་མདུན་དུ་བཀླགས་ཏེ། འབངས་ཐམས་ཅད་ཀྱིས་བཀའ་ཁྲིམས་ཀྱི་མདོ་དེ་ལ་རྣ་བ་བླགས་ནས་མཉན་ཏོ། །"]},{"type":"verse","number":4,"content":["དེའི་དོན་དུ་བཟོས་པའི་ཤིང་སྟེགས་སྟེང་དུ་དྲུང་ཡིག་ཨེས་སི་རཱ་བཞེངས་ནས་བསྡད། ཁོའི་གཡས་ཕྱོགས་སུ་མད་ཐིད་ཡཱ་དང་། ཤེ་མཱ། ཨ་ན་ཡཱ། ཨུ་རི་ཡཱ། ཧིལ་ཀི་ཡཱ། མ་ཨ་སེ་ཡཱ་བཅས་ལངས་བསྡད་ཡོད། ཁོའི་གཡོན་ཕྱོགས་སུ་ཕེ་ད་ཡཱ་དང་། མེ་ཤཱ་ཨེལ། མལ་ཀི་ཡཱ། ཧ་ཤུམ། ཧས་བད་ད་ནཱ། ཟཱ་ཀར་ཡ། མཱེ་ཤུལ་ལིམ་བཅས་ལངས་བསྡད་ཡོད་དོ། །"]},{"type":"verse","number":5,"content":["དེར་ཨེས་སི་རཱ་མཐོ་སར་བཞེངས་ནས་མི་ཚང་མའི་མཐོང་སར་མདོ་དེ་ཁ་ཕྱེས་པ་དང་། ཁོང་གིས་ཕྱེས་མ་ཐག་ཏུ་མི་ཐམས་ཅད་ཡར་ལངས་སོ། །"]},{"type":"verse","number":6,"content":["ཨེས་སི་རཱས་བླ་ན་མེད་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བསྟོད་བསྔགས་བརྗོད་པ་དང་། མི་ཐམས་ཅད་ཀྱིས་ལག་པ་ཡར་བརྐྱངས་ནས། ཨ་མེན། ཨ་མེན་ཞེས་ཞུས་ཤིང་། མགོ་བོ་བསྒུར་ཏེ་གདོང་སར་བཏུད་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕྱག་བཙལ་ཏོ། །"]},{"type":"verse","number":7,"content":["ཡང་ཡེ་ཤུ་ཨ་དང་། པཱ་ནི། ཤེ་རེབ་ཡཱ། ཡ་མིན། ཨག་ཁུབ། ཤབ་བེ་ཐ་ཨི། ཧོ་དི་ཡཱ། མ་ཨ་སེ་ཡཱ། ཀེ་ལི་ཏ། ཨ་ཟར་ཡཱ། ཡོ་ཟཱ་བད། ཧ་ནན། ཕེ་ལ་ཡཱ་དང་ལེ་ཝི་པ་རྣམས་ཀྱིས་འབངས་མི་རྣམས་ལ་བཀའ་ཁྲིམས་རྟོགས་སུ་བཅུག་པ་དང་། འབངས་ཐམས་ཅད་རང་རང་གི་གནས་སུ་ལངས་བསྡད་དོ། །"]},{"type":"verse","number":8,"content":["དེ་དག་གིས་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་ཀྱི་མདོ་གསལ་པོར་བཀླགས་ནས་དོན་སྨྲས་ཤིང་། འབངས་མི་རྣམས་ལ་བཀླགས་པའི་མདོ་ཡི་དོན་ཧ་གོ་རུ་བཅུག་གོ །"]},{"type":"verse","number":9,"content":["འགོ་དཔོན་ནེ་ཧེམ་ཡཱ་དང་། མཆོད་དཔོན་དང་དྲུང་ཡིག་ཨེས་སི་རཱ་དང་། འབངས་མི་རྣམས་ལ་སློབ་སྟོན་བྱེད་པའི་ལེ་ཝི་པ་རྣམས་ཀྱིས་འབངས་རྣམས་ལ་འདི་ལྟར། དེ་རིང་ནི་ཁྱོད་ཅག་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཉིན་དམ་པ་ཡིན་པས། མྱ་ངན་བྱས་ནས་མ་ངུ་ཞིག་ཅེས་སྨྲས། གང་ལ་ཞེ་ན། བཀའ་ཁྲིམས་ཐོས་ཏེ་ཁོ་ཚོ་ངུས་པས་ཡིན།"]},{"type":"verse","number":10,"content":["ནེ་ཧེམ་ཡཱས་ཁོ་རྣམས་ལ་འདི་ལྟར། ཁྱོད་རྣམས་སོང་སྟེ་ཤ་ཞིམ་པོ་ཟོ་ལ། བཏུང་བ་མངར་མོ་ཐུངས་ཤིག སྟ་གོན་བྱེད་མི་ནུས་པ་ལ་བགོས་ཤིག དེ་རིང་ནི་བདག་ཅག་གི་གཙོ་བོའི་ཉིན་དམ་པ་ཡིན་པས་སོ། །སེམས་མ་སྐྱོ་ཞིག དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བརྟེན་ནས་བྱུང་བའི་དགའ་སྤྲོ་ནི་ཁྱོད་ཚོའི་སྟོབས་ཤུགས་ཡིན་ནོ་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":11,"content":["ལེ་ཝི་པས་འབངས་མི་ཐམས་ཅད་ཁ་རོག་ལ་འདུག་ཏུ་བཅུག་སྟེ་འདི་ལྟར། ཁ་རོག་སྡོད་ཅིག དེ་རིང་ནི་ཉིན་དམ་པ་ཡིན་པས་སེམས་མ་སྡུག་ཅེས་སྨྲས།"]},{"type":"verse","number":12,"content":["འབངས་མི་ཐམས་ཅད་སོང་ནས་བཟའ་བཏུང་སྤྱད་པ་དང་། མི་གཞན་ལའང་བགོས་པས་ཐམས་ཅད་ཤིན་ཏུ་དགའ་བར་གྱུར། གང་ལ་ཞེ་ན། དེ་དག་གིས་ཁྲིད་སྟོན་གནང་བ་དག་རྟོགས་པས་སོ། །"]},{"type":"heading","content":["སྤྱིལ་བུའི་དུས་ཆེན་བསྲུངས་པ།"]},{"type":"verse","number":13,"content":["དེའི་ཕྱི་ཉིན་འབངས་མི་ཀུན་གྱི་ཚོ་དཔོན་རྣམས་དང་། མཆོད་དཔོན་རྣམས་དང་། ལེ་ཝི་པ་རྣམས་བཀའ་ཁྲིམས་ཀྱི་ནང་དོན་སློབ་ཆེད་དྲུང་ཡིག་ཨེས་སི་རཱའི་དྲུང་དུ་འཛོམས་སོ། །"]},{"type":"verse","number":14,"content":["དེར་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེའི་ངག་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་ཁྲིམས་ནང་དུ་ཟླ་བདུན་པའི་དུས་ཆེན་ལ་ཡེས་ར་ཨེལ་པ་རྣམས་སྤྱིལ་བུར་སྡོད་དགོས་པ་དང་།"]},{"type":"verse","number":15,"content":["གྲོང་ཁྱེར་ཐམས་ཅད་དང་ཡེ་རུ་སཱ་ལེམ་དུ་འདི་ལྟར། ཁྱོད་ཚོ་ཕྱི་རོལ་ཏུ་རི་ལ་སོང་ནས་སྐྱུ་རུ་རའི་ཤིང་གི་ཡལ་ག་དང་། རི་སྐྱེས་སྐྱུ་རུ་རའི་ཡལ་ག་དང་། པ་སངས་མེ་ཏོག་གི་ཡལ་ག་དང་། ཏ་ལའི་ཤིང་གི་ཡལ་ག་དང་། ལོ་འདབ་རྒྱས་པའི་ཤིང་སྣ་ཚོགས་ཀྱི་ཡལ་ག་རྣམས་བཏོགས་ནས། བཀའ་ཁྲིམས་ལས་གསུངས་པ་བཞིན་སྤྱིལ་བུ་བཟོ་བར་གྱིས་ཞེས་བསྒྲག་དགོས་ཞེས་པ་རྙེད་དེ།"]},{"type":"verse","number":16,"content":["འབངས་མི་རྣམས་ཕྱི་རོལ་ཏུ་སོང་ནས་སྡོང་པོའི་ཡལ་ག་ཁྱེར་འོངས་ཏེ། རང་རང་གི་ཁང་པའི་ཐོག་དང་ཁྱམས་ར་དང་། དཀོན་མཆོག་གི་མཆོད་ཁང་གི་ར་སྐོར་ནང་དང་། ཆུ་སྒོའི་ཐང་ཆེན་དང་། ཨེ་ཕཱར་ཡིམ་སྒོའི་ཐང་ཆེན་རྣམས་སུ་སྤྱིལ་བུ་བཟོས་སོ། །"]},{"type":"verse","number":17,"content":["ཡང་བཙོན་ལས་ཐར་བའི་མི་ཚོགས་ཐམས་ཅད་ཀྱིས་སྤྱིལ་བུ་བཟོས་ནས་དེའི་ནང་དུ་གནས་སོ། །ནུན་གྱི་བུ་ཡོ་ཤུ་ཨའི་དུས་ནས་བཟུང་སྟེ་ཉིན་འདིའི་བར་དུ་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་ལྟར་མ་བྱས་པ་ཡིན། དེའི་རྐྱེན་གྱིས་དེ་དག་ཤིན་ཏུ་དགའ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":18,"content":["ཡང་ཨེས་སི་རཱ་ཡིས་ཉིན་དང་པོ་ནས་མཐའ་མཇུག་བར་དུ། ཉིན་ལྟར་དཀོན་མཆོག་གི་བཀའ་ཁྲིམས་བཀླགས་ཏེ། དེ་རྣམས་ཀྱིས་ཉིན་ཞག་བདུན་གྱི་རིང་ལ་དུས་ཆེན་བསྲུངས་ནས། ཉིན་བརྒྱད་པར་ཁྲིམས་སྲོལ་བཞིན་དུ་འདུ་འཛོམས་དམ་ནན་ཡོད་པ་བཅས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NEH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NEH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NEH/7.json","previousChapterAudioLinks":{},"numberOfVerses":18}