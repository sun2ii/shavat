{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":11,"content":[{"type":"heading","content":["འབངས་རྣམས་ཀྱིས་སྡུག་ཡུས་བཏོན་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་མི་ཚོགས་ཀྱིས་སྡུག་ཡུས་བཏོན་ཞིང་སྐད་ངན་དཀོན་མཆོག་ཡ་ཝཱེའི་སྙན་ལམ་དུ་སླེབས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་གསན་ནས་ཐུགས་ཁྲོས་པར་གྱུར། དཀོན་མཆོག་ཡ་ཝཱེའི་མེ་ནི་དེ་དག་གི་ཁྲོད་དུ་འབར་ཏེ་སྒར་གྱི་མཐའ་རྣམས་འགེམས་པའོ། །"]},{"type":"verse","number":2,"content":["མི་ཚོགས་ཀྱིས་མོ་ཤེ་ལ་ཞུ་འབོད་བྱས་པ་དང་། མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གསོལ་བ་བཏབ་ཅིང་མེ་ཞི་བར་གྱུར་ཏེ།"]},{"type":"verse","number":3,"content":["དེ་དག་གི་ཁྲོད་དུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མེ་འབར་བ་ཡིན་པས་ཡུལ་དེའི་མིང་ལ་ཐབ་ཨེ་རཱ་ཞེས་བཏགས་སོ། །"]},{"type":"heading","content":["སྲེད་པའི་ཆག་སྒོ།"]},{"type":"verse","number":4,"content":["དེ་དག་ཁྲོད་ཀྱི་རིགས་རྒྱུད་འདྲེས་མ་རྣམས་ཀྱིས་འདོད་རྔམ་བསྐྱེད་ཅིང་། ཐ་ན་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཀྱང་ངུ་བཞིན་དུ། སུས་ང་ཚོ་ལ་ཁ་ཟས་སུ་ཤ་སྟེར་བར་འགྱུར་རམ།"]},{"type":"verse","number":5,"content":["ང་ཚོས་ཨེ་ཅིབ་ཡུལ་དུ་ཉ་དང་། ཁི་ར་དང་། ག་གོན་དང་། རི་སྒོག་དང་། ཙོང་དང་། སྒོག་པ་བཅས་ནི་རིན་མི་དགོས་པར་ཟ་རྒྱུ་ཡོད་པ་དྲན་བྱུང་།"]},{"type":"verse","number":6,"content":["ད་ནི་ངེད་རྣམས་ཡི་ག་ཆད་པ་སྟེ། མན་ནཱ་ལས་གཞན་ཅི་ཡང་མཐོང་རྒྱུ་མི་འདུག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":7,"content":["མན་ནཱ་དེ་ནི་སྔོ་སྨན་འུ་སུའི་འབྲུ་གུ་ལྟར་ཡིན་ཞིང་། པེ་དེལ་ཡོན་ཞེས་པའི་ཐང་ཆུ་དང་མཚུངས་པའོ། །"]},{"type":"verse","number":8,"content":["མི་ཚོགས་མཐའ་འཁོར་དུ་སོང་ནས་མན་ནཱ་བསྡུས་པ་དང་རང་འཐག་གིས་བཏགས་པའམ་གཏུན་ཁུང་དུ་བརྡུངས་ནས། རྫ་ཁོག་ནང་དུ་བཙོས་པའམ་བག་ལེབ་བཟོས་ཤིང་། དེའི་བྲོ་བ་ནི་བག་ལེབ་སྣུམ་བཙོས་དང་འདྲ་ལ།"]},{"type":"verse","number":9,"content":["མཚན་མོར་སྒར་གྱི་སྟེང་དུ་ཟིལ་པ་ཆགས་པའི་ཚེ་མན་ནཱ་ཡང་བབས་སོ། །"]},{"type":"verse","number":10,"content":["མོ་ཤེ་ཡིས་མི་རྣམས་ཀྱིས་ཁྱིམ་རྒྱུད་སོ་སོའི་གུར་སྒོ་ནས་ངུ་འབོད་བྱེད་པ་ཐོས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་རབ་ཏུ་ཁྲོས་པ་དང་། མོ་ཤེ་ཡང་མི་དགའ་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":11,"content":["མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་ཉིད་ཀྱི་ཞབས་ཕྱི་སྡུག་ལ་སྦྱར་དོན་ཅི། ཁྱེད་ཀྱི་སྤྱན་སྔར་བདག་ལ་ཐུགས་རྗེ་མ་ཐོབ་པ་ཅི། མི་ཚོགས་ཐམས་ཅད་ལ་བདག་སྐྱོང་བྱེད་པའི་ཁུར་པོ་ང་ལ་བཀལ་བ་ཅི།"]},{"type":"verse","number":12,"content":["མི་ཚོགས་འདི་ནི་ངའི་མངལ་དུ་སྦྲུམས་ནས་ང་ལས་སྐྱེས་པ་ཡིན་ནམ། ཁྱེད་ཀྱིས་ང་ལ་འདི་སྐད་དུ། བུ་སྙོར་མས་གསོས་པའི་ཕྲུ་གུ་ལྟར་དེ་དག་ངའི་པང་ལ་བཟུང་ནས། ཁྱེད་ཀྱིས་ཁོ་རྣམས་ཀྱི་ཕ་མེས་ལ་གནང་བར་མནའ་བཞེས་པའི་ཡུལ་དེར་ཁྱེར་ཅིག་ཅེས་གསུངས་པ་ཡིན་ནམ།"]},{"type":"verse","number":13,"content":["ངས་མི་དེ་ཐམས་ཅད་ཀྱི་ཁ་ཟས་སུ་ཤ་གང་ནས་རྙེད་པར་འགྱུར་རམ། དེ་དག་གིས་ངུ་འབོད་བྱེད་ཀྱིན་ང་ལ་ཁྱོད་ཀྱིས་ང་ཚོར་བཟའ་རྒྱུའི་ཤ་བྱིན་ཅིག་ཅེས་སྨྲའོ། །"]},{"type":"verse","number":14,"content":["མི་ཚོགས་འདིར་བདག་སྐྱོང་བྱེད་པའི་འགན་ཁུར་ནི་ལྗིད་དྲགས་པས། ང་གཅིག་པུས་དེ་འཁུར་མི་ནུས་སོ། །"]},{"type":"verse","number":15,"content":["ཁྱེད་ཀྱིས་ང་ལ་འདི་ལྟར་མཛད་པ་ཡིན་པས། གལ་སྲིད་ཁྱེད་ཀྱི་སྤྱན་སྔར་བདག་ལ་ཐུགས་རྗེ་ཐོབ་པ་ཡིན་ན། ངས་རང་གི་སྡུག་བསྔལ་མི་མཐོང་བའི་ཆེད་དུ་ཁྱེད་ཀྱིས་དངོས་སུ་ང་རང་གསོད་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ལས་བདག་ལ་མི་བདུན་ཅུ་སྟེ། ཁྱོད་ཀྱིས་ངོ་ཤེས་པའི་མི་ཚོགས་ཁྲོད་ཀྱི་རྒན་པོ་དང་འགོ་དཔོན་རྣམས་ཁྱོད་དང་མཉམ་དུ་འགྲེང་བར་མཇལ་འཕྲད་གུར་མཆོག་གི་མདུན་དུ་ཁྲིད་ཤོག"]},{"type":"verse","number":17,"content":["བདག་ཡུལ་དེར་མར་འོངས་ནས་ཁྱོད་དང་གླེང་མོལ་བྱེད་ཅིང་། ཁྱོད་ཀྱི་སྟེང་དུ་ཡོད་པའི་ཐུགས་ཉིད་ནི་དེ་དག་གི་སྟེང་ལའང་འཇོག་པར་བྱ། མི་ཚོགས་ལ་བདག་སྐྱོང་བྱེད་པའི་འགན་ཁྱོད་གཅིག་པུས་འཁུར་མི་དགོས་པར་དེ་དག་གིས་ཁྱོད་དང་མཉམ་དུ་འཁུར་བར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་མི་ཚོགས་ལ་འདི་ལྟར། སང་ཉིན་ཤ་བཟའ་བའི་ཕྱིར་དུ་ཁྱོད་ཅག་གིས་རང་ཉིད་དམ་པར་སྲུངས་ཤིག ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གིས་ངུ་འབོད་བྱེད་ཀྱིན་དཀོན་མཆོག་ཡ་ཝཱེའི་སྙན་ལམ་དུ། སུ་ཞིག་གིས་ངེད་རྣམས་ལ་ཤ་སྟེར་རམ། ངེད་རྣམས་ཨེ་ཅིབ་ཡུལ་དུ་ཡོད་དུས་ཅི་འདྲ་སྐྱིད་ཨང་ཞེས་ཞུས་པས། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཅག་ལ་བཟའ་རྒྱུའི་ཤ་གནང་ངེས་ཡིན།"]},{"type":"verse","number":19,"content":["དེ་ནི་ཁྱོད་ཅག་གིས་ཉིན་གཅིག་དང་གཉིས་སམ། ཡང་ན་ཉིན་ལྔ་དང་བཅུའམ། ཡང་ན་ཉིན་ཉི་ཤུ་ཙམ་ལ་བཟའ་བ་མ་ཡིན་པར།"]},{"type":"verse","number":20,"content":["ཁྱོད་ཅག་གིས་ཟླ་ཧྲིལ་པོ་གཅིག་ལ་བཟའ་བ་དང་། ཤ་ནི་ཁྱོད་ཚོའི་སྣ་ཁུང་ལས་འཐོན་ཞིང་དེ་ལ་ཞེ་མེར་བའི་བར་དུ་བཟའ་བར་འགྱུར། ཅི་ལ་ཞེ་ན། ཁྱོད་ཅག་གིས་ཁྱོད་ཚོའི་དཀྱིལ་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་སྣང་མེད་དུ་བསྐྱུར་ཏེ་ཁོང་གི་དྲུང་དུ་ངུ་འབོད་བྱེད་ཀྱིན། ངེད་ཅག་ཅིའི་ཕྱིར་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པ་ཡིན་ནམ་ཞེས་སྨྲས་པའི་ཕྱིར་རོ་ཞེས་སྨྲོས་ཤིག་གསུངས་སོ། །"]},{"type":"verse","number":21,"content":["དེ་ནས་མོ་ཤེ་ཡིས་འདི་ལྟར། ང་དང་མཉམ་དུ་གནས་པའི་མི་ཚོགས་འདི་ལས་རྐང་ཐང་ལ་སྐྱོད་མཁན་འབུམ་དྲུག་ཡོད་ཀྱང་། ཁྱེད་ཀྱིས་ད་དུང་བདག་གིས་དེ་དག་ལ་ཟླ་གཅིག་གི་རིང་ལ་བཟའ་རྒྱུའི་ཤ་གནང་བར་བྱ་ཞེས་གསུངས་པའོ། །"]},{"type":"verse","number":22,"content":["ར་ལུག་གི་ཁྱུ་དང་བ་ཁྱུ་ཐམས་ཅད་བཤས་ན་དེ་དག་གི་བཟའ་རྒྱུར་འདང་བ་ཡིན་ནམ། ཡང་ན་རྒྱ་མཚོ་ནང་གི་ཉ་ཐམས་ཅད་བསྡུས་ན་དེ་དག་གི་བཟའ་རྒྱུར་འདང་བ་ཡིན་ཞེས་ཞུས་ཤིང་།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཡ་ཝཱེའི་ལག་ངར་ཇེ་ཐུང་དུ་སོང་བ་ཡིན་ནམ",{"noteId":2},"། ད་ལྟ་ངས་སྨྲས་པ་བཞིན་དུ་འབྱུང་མིན་ཁྱོད་ཀྱིས་མཐོང་བར་འགྱུར་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་མོ་ཤེ་ཕྱི་རོལ་ཏུ་སོང་སྟེ་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའི་བཀའ་མི་ཚོགས་ལ་སྨྲས་པ་དང་། ཡང་མི་ཚོགས་ཁྲོད་ཀྱི་རྒན་པོ་རྣམས་ལས་མི་བདུན་ཅུ་བསྡུས་ནས་མཇལ་འཕྲད་གུར་མཆོག་གི་མཐའ་འཁོར་ལ་འགྲེང་དུ་བཅུག"]},{"type":"verse","number":25,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་སྤྲིན་གྱི་ནང་ནས་མར་ཕེབས་ཏེ་མོ་ཤེ་ལ་གསུང་གླེང་མཛད་པ་དང་། ཁོའི་སྟེང་དུ་ཡོད་པའི་ཐུགས་ཉིད་རྒན་པོ་བདུན་ཅུའི་སྟེང་དུ་བཞག་པ་ལ། ཐུགས་ཉིད་དེ་དག་གི་སྟེང་དུ་བཞུགས་པའི་དུས་སུ་དེ་དག་གིས་ལུང་བསྟན་གནང་བ་ཡིན་མོད། འོན་ཀྱང་དེའི་རྗེས་སུ་ཡང་བསྐྱར་ལུང་མ་བསྟན་ཏོ། །"]},{"type":"verse","number":26,"content":["སྐབས་དེར་མི་གཉིས་ད་དུང་སྒར་གྱི་ནང་དུ་ལུས་ཡོད་ཅིང་། གཅིག་གི་མིང་ལ་ཨེལ་དཱད་དང་ཅིག་ཤོས་ཀྱི་མིང་ལ་མེ་དཱད་ཟེར་བ་དང་། ཐུགས་ཉིད་ནི་དེ་གཉིས་ཀྱི་སྟེང་དུའང་བཞུགས། དེ་གཉིས་ཀའང་རྒན་པོ་རྣམས་ཀྱི་གྲས་སུ་ཡོད་ན་ཡང་ཁོ་གཉིས་མཇལ་འཕྲད་གུར་མཆོག་ཡོད་སར་མ་སོང་ལ། དེ་ཚོས་སྒར་གྱི་ནང་དུ་ལུང་བསྟན་གནང་།"]},{"type":"verse","number":27,"content":["དེ་ནས་གཞོན་ནུ་ཞིག་རྒྱུགས་འོངས་ནས་མོ་ཤེ་ལ། ཨེལ་དཱད་དང་མེ་དཱད་གཉིས་ཀྱིས་སྒར་གྱི་ནང་དུ་ལུང་སྟོན་བཞིན་འདུག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":28,"content":["མོ་ཤེའི་ཞབས་ཕྱི་དང་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་སྟེ་མོ་ཤེ་ཡི་ལག་རོགས་དར་མ་དེ་ན་རེ། ང་ཡི་ཇོ་བོ་མོ་ཤེ་ལགས། ཁྱེད་ཀྱིས་དེ་གཉིས་འགོག་པར་མཛོད་ཅེས་ཞུས་པ་ན།"]},{"type":"verse","number":29,"content":["མོ་ཤེ་ཡིས་དེ་ལ། ཁྱོད་ཀྱིས་བདག་གི་ཆེད་དུ་ཕྲག་དོག་བྱེད་དམ། དཀོན་མཆོག་ཡ་ཝཱེའི་མི་ཚོགས་ཐམས་ཅད་ལུང་སྟོན་པ་ཡིན་ན་ཅིས་མི་རུང་། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་གི་ཐུགས་ཉིད་ནི་དེ་དག་གི་སྟེང་དུ་གནང་བར་ཤོག་ཅེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":30,"content":["དེ་ནས་མོ་ཤེ་དང་ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་སྒར་དུ་ཕྱིར་ལོག་གོ །"]},{"type":"verse","number":31,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་རླུང་ཞིག་བྱུང་སྟེ། རྒྱ་མཚོའི་ངོས་ནས་སྲེག་པ་ཁུར་འོངས་ཤིང་སྒར་གྱི་ས་ལ་བབས་པ་དང་། སྲེག་པས་སྒར་བསྐོར་ཏེ་ཚུར་ལ་ཉིན་གཅིག་གི་ལམ་ཐག་དང་ཕར་ལ་ཉིན་གཅིག་གི་ལམ་ཐག་ཡོད་ཅིང་། ས་ངོས་ནས་མཐོ་ཚད་ཁྲུ་གཉིས་ཙམ་ལ་སླེབས་པའོ། །"]},{"type":"verse","number":32,"content":["མི་ཚོགས་ལངས་ནས་ཉིན་གང་དང་མཚན་གང་། དེའི་ཕྱི་ཉིན་ཉིན་གང་བཅས་ལ་སྲེག་པ་བསྡུས་ཤིང་། ཉུང་མཐའ་ཡང་ཁལ་བཅུ་བསྡུས་ནས་སྒར་གྱི་ཕྱོགས་བཞིར་བཀྲམས།"]},{"type":"verse","number":33,"content":["ཤ་ནི་དེ་དག་གི་སོ་བར་དུ་ཡོད་ཅིང་ད་དུང་ལྡད་མ་ཚར་བའི་མཚམས་དེར། དཀོན་མཆོག་ཡ་ཝཱེའི་ཐུགས་ཁྲོ་མི་ཚོགས་ཀྱི་སྟེང་དུ་འབར་ཞིང་། ནད་ཡམས་དྲག་པོས་མི་ཚོགས་ལ་བརྡུངས་པའོ། །"]},{"type":"verse","number":34,"content":["དེའི་ཕྱིར་གནས་དེའི་མིང་ལ་ཀིབ་རོད་ཧད་ཐཱ་ཨ་ཝ་",{"noteId":3},"ཞེས་བཏགས། གང་ལ་ཞེ་ན། འདོད་རྔམ་བཅངས་པའི་མི་རྣམས་དེ་རུ་དུར་ལ་སྦས་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":35,"content":["དེ་ནས་མི་ཚོགས་ཀིབ་རོད་ཧད་ཐཱ་ཨ་ཝ་ནས་ལམ་དུ་ཆས་ཏེ་ཧ་ཚི་རོད་ཀྱི་ཕྱོགས་སུ་སོང་བ་དང་། ཧ་ཚི་རོད་དུ་བསྡད་དོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ཡ་ཝཱེའི་ལག་ངར་ཇེ་ཐུང་དུ་སོང་བ་ཡིན་ནམ་ཞེས་པ་འདིར་མ་ཕྱི་ལས་ཡ་ཝཱེའི་ལག་ངར་ཞེས་མཐོང་ཞིང་ཚིག་རྐང་འདི་དོན་གྱིས་ཡ་ཝཱེའི་དབང་ཤུགས་ལ་ཚད་བཀག་ཡོད་དམ་ཅེས་པ་ཡིན།","reference":{"chapter":11,"verse":23}},{"noteId":3,"caller":"+","text":"ཡ་ཧུ་དཱའི་སྐད་དུ་ཀིབ་རོད་ཧད་ཐཱ་ཨ་ཝ་ཞེས་པ་ནི་མི་འདོད་རྔམ་ཅན་གྱི་དུར་ས་ཞེས་པའི་དོན་ཡིན་ལ། ལེའུ་སོ་གསུམ་པའི་ཚིག་རྐང་བཅུ་དྲུག་ནས་བཅུ་བདུན་དུའང་འབྱུང་།","reference":{"chapter":11,"verse":34}}]},"thisChapterLink":"/api/bod_ntb/NUM/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/10.json","previousChapterAudioLinks":{},"numberOfVerses":35}