{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":13,"content":[{"type":"heading","content":["མོ་ཤེ་ཡིས་ཀ་ན་ཨན་ལ་མྱུལ་མ་བཏང་བ།"]},{"type":"verse","number":1,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ངས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྦྱིན་པའི་ཀ་ན་ཨན་ཡུལ་དུ་མྱུལ་མ་ཐོངས་ཤིག ཕ་མེས་རྣམས་ཀྱི་ཚོ་པ་བཞིན་དུ་ཚོ་པ་རེ་ནས་མི་རེ་གཏོང་བ་དང་། རེ་རེ་བཞིན་འགོ་དཔོན་ཡིན་དགོས་ཞེས་བཀའ་གནང་ངོ་། །"]},{"type":"verse","number":3,"content":["དེར་བརྟེན་མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ། ཕཱ་རན་དབེན་སྟོང་ནས་ཁོ་རྣམས་བཏང་བ་དང་། དེ་དག་ཐམས་ཅད་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ཡིན་པའོ། །"]},{"type":"verse","number":4,"content":["དེ་དག་གི་མིང་ནི་འདི་ལྟ་སྟེ། རུ་བེན་ཚོ་པ་ནས་ཟག་ཀུར་གྱི་བུ་ཤཱ་མུ་ཨ་དང་།"]},{"type":"verse","number":5,"content":["སི་མུ་ཨོན་ཚོ་པ་ནས་ཧོ་རིའི་བུ་ཤཱ་ཕད་དང་།"]},{"type":"verse","number":6,"content":["ཡ་ཧུ་དཱ་ཚོ་པ་ནས་ཡེ་ཕུན་ནེའི་བུ་ཀཱ་ལེབ་དང་།"]},{"type":"verse","number":7,"content":["ཡེས་སི་ཀཱར་ཚོ་པ་ནས་ཡོ་སེབ་ཀྱི་བུ་ཡི་གལ་དང་།"]},{"type":"verse","number":8,"content":["ཨེ་ཕཱར་ཡིམ་ཚོ་པ་ནས་ནུན་གྱི་བུ་ཧོ་ཤེ་ཨ་དང་།"]},{"type":"verse","number":9,"content":["པེན་ཡཱ་མེན་ཚོ་པ་ནས་རཱ་ཕུའི་བུ་ཕལ་ཏི་དང་།"]},{"type":"verse","number":10,"content":["ཟེ་བུ་ལུན་ཚོ་པ་ནས་སོ་དིའི་བུ་གད་དི་ཨེལ་དང་།"]},{"type":"verse","number":11,"content":["ཡོ་སེབ་ཚོ་པ་སྟེ་མཱ་ན་ཤེ་ཚོ་པ་ནས་སུ་སེའི་བུ་གད་དི་དང་།"]},{"type":"verse","number":12,"content":["དཱན་ཚོ་པ་ནས་གཱ་མལ་ལིའི་བུ་ཨམ་མེ་ཨེལ་དང་།"]},{"type":"verse","number":13,"content":["ཨ་ཤེར་ཚོ་པ་ནས་མེའ་ཀཱ་ཨེལ་གྱི་བུ་སེ་ཐུར་དང་།"]},{"type":"verse","number":14,"content":["ནཱབ་ཐ་ལི་ཚོ་པ་ནས་ཝོ་ཕེ་སིའི་བུ་ནག་པི་དང་།"]},{"type":"verse","number":15,"content":["གཱ་རྡུ་ཚོ་པ་ནས་མ་ཀིའི་བུ་གཱ་ཨུ་ཨེལ་བཅས་སོ། །"]},{"type":"verse","number":16,"content":["དེ་དག་ནི་མོ་ཤེ་ཡིས་ཡུལ་དེར་མྱུལ་མར་བཏང་བའི་མི་རྣམས་ཀྱི་མིང་ཡིན། མོ་ཤེ་ཡིས་ནུན་གྱི་བུ་ཧོ་ཤེ་ཨའི་མིང་ལ་ཡོ་ཤུ་ཨ་ཞེས་བཏགས་སོ། །"]},{"type":"verse","number":17,"content":["མོ་ཤེ་ཡིས་དེ་རྣམས་ཀ་ན་ཨན་ཡུལ་གྱི་མྱུལ་མར་གཏོང་བའི་སྐབས་སུ། དེ་དག་ལ་འདི་ལྟར། ཁྱོད་ཅག་འདི་ནས་ཡར་ནེ་གུབ་ཡུལ་དུ་འགྲོ་བ་དང་། དེ་ནས་ཡར་རི་ཁུལ་དུ་སོང་ཞིག"]},{"type":"verse","number":18,"content":["ཡུལ་དེ་ཇི་ལྟ་བུ་ཡིན་པ་དང་། དེར་གནས་པའི་མི་རྣམས་ཀྱི་སྟོབས་ཀྱི་ཆེ་ཆུང་། མི་ཡི་མང་ཉུང་།"]},{"type":"verse","number":19,"content":["དེ་རྣམས་སྡོད་པའི་ཡུལ་ནི་བཟང་ངན་ཅི་ལྟ་བུ་ཡིན་པ། དེ་དག་གནས་པའི་གྲོང་ཁྱེར་རྣམས་སྒར་རམ་བཙན་རྫོང་ཡིན་པ།"]},{"type":"verse","number":20,"content":["ས་ཆ་དེ་ནི་ས་བཅུད་འཛོམས་སམ་ས་རྒྱུ་ཞན་པ། དེར་ཤིང་སྡོང་ཡོད་མེད་བཅས་ལ་ལྟོས་ཤིག སྙིང་སྟོབས་ཆེན་པོ་བསྐྱེད་ནས་ཡུལ་དེའི་ཤིང་འབྲས་འགའ་ཤས་ཁྱེར་ཤོག་ཅེས་སྨྲས་ཤིང་། དེ་ནི་རྒུན་འབྲུམ་ཐོག་མར་སྨིན་པའི་དུས་ཡིན་ནོ། །"]},{"type":"verse","number":21,"content":["དེ་ནས་ཁོ་རྣམས་ཡར་སོང་སྟེ། ཟིན་ཞེས་པའི་དབེན་སྟོང་ནས་ལེ་པོ་ཧ་མཱད་ཡུལ་གྱི་རེ་ཧོབ་འགག་བར་དུ་ཡུལ་དེར་ལྐོག་ལྟ་བྱས།"]},{"type":"verse","number":22,"content":["ཁོ་རྣམས་ཡར་ནེ་གུབ་ཡུལ་དུ་སོང་སྟེ་ཧེབ་རོན་ལ་སླེབས་པ་དང་། ཨ་ནག་གི་བུ་རྒྱུད་དེ་ཨ་ཧི་མན་དང་ཤེ་ཤཱ་ཨི། ཐལ་མ་ཨི་བཅས་ཡུལ་དེར་ཡོད་ཅིང་། ཧེབ་རོན་ནི་ཨེ་ཅིབ་ཡུལ་གྱི་ཚོ་ཨན་ལས་ཀྱང་ལོ་བདུན་གྱི་ཡར་སྔོན་དུ་ཚུགས་པ་ཡིན།"]},{"type":"verse","number":23,"content":["དེ་ནས་ཁོ་རྣམས་ཨེ་ཤཱ་ཀོལ་ལུང་པར་",{"noteId":4},"སླེབས་པ་དང་། དེར་རྒུན་ཤིང་གི་ཡལ་གར་རྒུན་འབྲུམ་ཆུན་པོ་གཅིག་རང་ཡོད་པ་དེ་བཅད་ནས། མི་གཉིས་ཀྱིས་དེ་གདང་ལ་ཁུར་ནས་ཐོན་ཞིང་། སེ་འབྲུ་དང་སེ་ཡབ་འགའ་ཤས་ཀྱང་ཁྱེར་ཡོང་ངོ་། །"]},{"type":"verse","number":24,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཡུལ་དེ་ནས་བཅད་འོངས་པའི་རྒུན་འབྲུམ་ཆུན་པོ་དེའི་རྐྱེན་གྱིས་གནས་དེའི་མིང་ལ་ཨེ་ཤཱ་ཀོལ་ལུང་པ་ཞེས་བཏགས་སོ། །"]},{"type":"heading","content":["མྱུལ་མ་རྣམས་ཀྱིས་གནས་ཚུལ་བརྗོད་པ།"]},{"type":"verse","number":25,"content":["ཉིན་ཞག་བཞི་བཅུ་སོང་བའི་མཐར། ཁོ་རྣམས་ཀྱིས་ཡུལ་དེར་ལྐོག་ལྟ་བྱས་ཚར་ནས་ཕྱིར་ལོག་པ་དང་།"]},{"type":"verse","number":26,"content":["ཁོ་རྣམས་ཕཱ་རན་དབེན་སྟོང་གི་ཀཱ་དེའེ་ཤཱ་ཡུལ་དུ་མོ་ཤེ་དང་། ཨ་རོན་དང་། ཡེས་ར་ཨེལ་པའི་མི་ཚོགས་ཡོངས་ཀྱི་མདུན་དུ་ཡོང་ནས་དེ་དག་ལ་གནས་ཚུལ་བརྗོད་ཅིང་། ཡང་ཡུལ་དེའི་ཤིང་འབྲས་དེ་རྣམས་ལ་བསྟན།"]},{"type":"verse","number":27,"content":["དེ་དག་གིས་མོ་ཤེ་ལ་འདི་ལྟར། ངེད་ཅག་ཁྱེད་ཀྱིས་བཏང་བའི་ཡུལ་དེར་ཕྱིན་པ་དང་། དེ་ནི་དངོས་གནས་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་ཞིག་སྟེ། འདི་ནི་ས་ཆ་དེའི་ཤིང་འབྲས་ཡིན།"]},{"type":"verse","number":28,"content":["འོན་ཀྱང་ཡུལ་དེར་གནས་པའི་མི་རྣམས་ནི་སྟོབས་ཆེ་བ་དང་། གྲོང་ཁྱེར་དག་ནི་སྲ་ཞིང་བརྟན་ལ་ཤིན་ཏུ་ཆེན་པོ་འདུག ངེད་ཅག་གིས་དེར་ཨ་ནག་གི་བུ་རྒྱུད་རྣམས་ཀྱང་མཐོང་ངོ་། །"]},{"type":"verse","number":29,"content":["དེའི་ནེ་གུབ་ཡུལ་དུ་ཨ་མཱད་ལེག་པ་རྣམས་ཆགས་ཡོད་པ་དང་། ཧེད་པ་དང་ཡེ་བུ་སི་པ་དང་ཨེ་མོར་པ་རྣམས་རི་ཁུལ་དུ་གནས་ཡོད། ཀ་ན་ཨན་པ་རྣམས་རྒྱ་མཚོའི་འགྲམ་དང་ཡོར་དན་གཙང་པོའི་ཕྱོགས་སུ་ཆགས་ཡོད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":30,"content":["དེ་ནས་ཀཱ་ལེབ་ཀྱིས་མོ་ཤེའི་མདུན་དུ་མི་ཚོགས་ལྷོད་འཇགས་སུ་ཕབ་སྟེ་ན་རེ། རང་ཅག་ཡུལ་དེ་ལས་ཏན་ཏན་རྣམ་པར་རྒྱལ་ཐུབ་པས་ཡར་འགྲོ་ལ་ཡུལ་དེ་ལེན་པར་བྱ་ཞེས་སྨྲས།"]},{"type":"verse","number":31,"content":["འོན་ཀྱང་ཁོ་དང་མཉམ་དུ་སོང་བའི་མི་རྣམས་ན་རེ། ཡུལ་དེའི་མི་རྣམས་རང་ཅག་ལས་སྟོབས་ཆེ་བས། རང་ཅག་ཡར་དེ་དག་ལ་རྒོལ་བར་འགྲོ་མི་ནུས་སོ་ཞེས་སྨྲས།"]},{"type":"verse","number":32,"content":["མྱུལ་མ་དེ་དག་གིས་ཁོ་རྣམས་ལྐོག་ལྟ་བྱེད་དུ་ཕྱིན་པའི་ཡུལ་དེའི་སྐོར་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་གཏམ་ངན་བསྒྲགས་ཏེ་ན་རེ། ངེད་ཅག་སོང་ནས་ལྐོག་ལྟ་བྱས་པའི་ཡུལ་དེ་ནི་དེར་གནས་པའི་མི་རྣམས་རྔམ་ཟ་བྱེད་པའི་ཡུལ་ཞིག་ཡིན་པ་དང་། ངེད་ཅག་གིས་དེར་མཐོང་བའི་མི་ཐམས་ཅད་ནི་གཟུགས་རིང་ཞིང་ཆེའོ། །"]},{"type":"verse","number":33,"content":["དེར་ང་ཚོས་ནེ་ཕེ་ལིམ་པ་རྣམས་མཐོང་ཞིང་། ཨ་ནག་གི་བུ་རྒྱུད་ནི་ནེ་ཕེ་ལིམ་པ་རྣམས་ལས་ཆད་པ་ཡིན། ང་ཚོའི་མཐོང་སྣང་ལ་རང་ཉིད་ནི་འབུ་ཆ་ག་པ་ལྟ་བུ་ཡིན་ལ། དེ་དག་གི་མཐོང་སྣང་ལའང་ངེད་རྣམས་དེ་བཞིན་ཡིན་ཞེས་སྨྲས་སོ། །"]}],"footnotes":[{"noteId":4,"caller":"+","text":"ཡ་ཧུ་དཱའི་སྐད་དུ་ཨེ་ཤཱ་ཀོལ་ཞེས་པ་ནི་རྒུན་འབྲུམ་ཆུན་པོའི་དོན་ཡིན།","reference":{"chapter":13,"verse":23}}]},"thisChapterLink":"/api/bod_ntb/NUM/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/12.json","previousChapterAudioLinks":{},"numberOfVerses":33}