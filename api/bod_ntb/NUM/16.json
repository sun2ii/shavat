{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":16,"content":[{"type":"heading","content":["ཀོ་རཱག་གིས་ངོ་ལོག་བྱས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ལེ་ཝིའི་ཡང་ཚ་སྟེ། ཀོ་ཧད་ཀྱི་ཚ་བོ་དང་ཡེས་ཧར་གྱི་བུ་ཀོ་རཱག་དང་། རུ་བེན་གྱི་བུ་རྒྱུད་ལས་ཨེ་ལི་ཨབ་ཀྱི་བུ་དཱ་ཐན་དང་ཨ་བི་རཱམ་གཉིས་དང་། ཕེ་ལེད་ཀྱི་བུ་ཨོན་བཅས་ཀྱིས་མི་ཁྲིད་ནས་འོངས་ཏེ།"]},{"type":"verse","number":2,"content":["མོ་ཤེ་ལ་ངོ་རྒོལ་བྱས་པ་དང་། ད་དུང་ཡེས་ར་ཨེལ་པ་རྣམས་ལས་མི་ཉིས་བརྒྱ་ལྔ་བཅུ་སྟེ་མི་ཚོགས་ཀྱི་འགོ་དཔོན་ཡིན་ཞིང་། མི་ཚོགས་ལས་བདམས་པའི་མི་སྙན་གྲགས་ཅན་རྣམས་ཀྱང་ཡོད་དོ། །"]},{"type":"verse","number":3,"content":["དེ་དག་མཉམ་དུ་འདུས་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་ངོ་རྒོལ་བྱས་ཤིང་ཁོ་གཉིས་ལ་འདི་ལྟར། ཁྱོད་གཉིས་ཚད་ལས་བརྒལ་དྲགས། མི་ཚོགས་ཡོངས་ཀྱི་མི་རེ་རེ་དམ་པ་ཡིན་ཞིང་དཀོན་མཆོག་ཡ་ཝཱེ་ཡང་དེ་དག་གི་ཁྲོད་དུ་བཞུགས་ཡོད་པས། ཁྱོད་གཉིས་ཀྱིས་རང་ཉིད་དཀོན་མཆོག་ཡ་ཝཱེའི་མི་ཚོགས་ལས་མཐོན་པོར་བཀུར་བ་ཅི་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":4,"content":["མོ་ཤེ་ཡིས་དེ་ཐོས་ནས་གདོང་ས་རུ་བཏུད་ཅིང་།"]},{"type":"verse","number":5,"content":["ཀོ་རཱག་དང་ཁོའི་འགྲོགས་ཡ་རྣམས་ལ་འདི་ལྟར། སང་ཉིན་ཞོགས་པར་དཀོན་མཆོག་ཡ་ཝཱེས་སུ་ཞིག་ཁོང་གི་ཡིན་པ་དང་། སུ་ཞིག་དམ་པ་ཡིན་པ་སྟོན་པར་མཛད་ནས་དེ་ཁོང་གི་འཁྲིས་སུ་འཁྲིད་འོང་ལ། ཡང་སུ་ཞིག་ཁོང་གིས་བདམས་པ་ཡིན་ན་དེ་ཁོང་གི་ཉེ་སར་འདྲེན་པར་འགྱུར།"]},{"type":"verse","number":6,"content":["ཁྱོད་ཅག་གིས་འདི་ལྟར་བྱེད་དགོས་ཏེ། ཀོ་རཱག་དང་ཁྱོད་ཀྱི་འགྲོགས་ཡ་རྣམས་ཀྱིས་སྤོས་ཕོར་ཁྱེར་འོངས་ནས།"]},{"type":"verse","number":7,"content":["སང་ཉིན་ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་ནས་དེ་དག་གི་ནང་དུ་མེ་སྦར་བ་དང་དེའི་སྟེང་དུ་སྤོས་ཞོག་ཅིག དཀོན་མཆོག་ཡ་ཝཱེས་སུ་ཞིག་བདམས་ན་དེ་ནི་དམ་པ་ཡིན་པར་འགྱུར། ལེ་ཝི་པ་ཁྱོད་རྣམས་ཚད་ལས་བརྒལ་དྲགས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ཀོ་རཱག་ལ་འདི་ལྟར། ལེ་ཝི་པ་རྣམས་ཀྱིས་ཉོན་ཅིག"]},{"type":"verse","number":9,"content":["ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་གིས་ཁྱོད་ཚོ་ཡེས་ར་ཨེལ་པའི་མི་ཚོགས་ལས་ལོགས་སུ་བཀར་ཏེ། ཁྱོད་ཅག་ཁོང་དང་ཉེ་བར་མཛད་ནས། དཀོན་མཆོག་ཡ་ཝཱེའི་གུར་མཆོག་གི་ཞབས་ཕྱི་བྱེད་པ་དང་། མི་ཚོགས་ཀྱི་མདུན་དུ་ལངས་ནས་ཁོ་ཚོའི་དོན་དུ་ཞབས་ཕྱི་སྒྲུབ་པར་མཛད།"]},{"type":"verse","number":10,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་དང་ཁྱོད་ཀྱི་སྤུན་ཟླ་ཐམས་ཅད་དེ། ལེ་ཝིའི་བུ་རྒྱུད་རྣམས་ལྷན་དུ་ཁོང་དང་ཉེ་བར་མཛད་པ་དང་། ཁྱོད་ཅག་གིས་དེ་ནི་དོན་ཆུང་ངུ་ཞིག་ཡིན་པར་འདོད་དམ། ཁྱོད་ཅག་གིས་ད་དུང་མཆོད་དཔོན་གྱི་ལས་འགན་ལ་བསྙེག་གམ།"]},{"type":"verse","number":11,"content":["དེའི་ཕྱིར། ཁྱོད་དང་ཁྱོད་ཀྱི་འགྲོགས་ཡ་རྣམས་མཉམ་དུ་འདུས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་རྒོལ་བའོ། །ཨ་རོན་སུ་ཡིན་ནམ། ཁྱོད་ཅག་གིས་ཁོ་ལ་འཁང་ར་བྱེད་དགོས་དོན་ཅི་ཡོད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":12,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ཨེ་ལི་ཨབ་ཀྱི་བུ་དཱ་ཐན་དང་ཨ་བི་རཱམ་གཉིས་འབོད་པར་མི་མངགས་པ་ལ། དེ་གཉིས་ཀྱིས་ངེད་གཉིས་ཡར་མི་འགྲོ།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཀྱིས་ངེད་རྣམས་དབེན་སྟོང་དུ་གསོད་པའི་ཕྱིར་དུ་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་ནས་ཡར་ཁྲིད་འོངས་པ་དང་། དེ་ནི་དོན་ཆུང་ངུ་ཞིག་ཡིན་ནམ། ཁྱོད་ཀྱིས་ད་དུང་རང་ཉིད་རྒྱལ་པོར་བསྐོས་ནས་ངེད་རྣམས་ལ་དབང་བསྒྱུར་དགོས་སམ།"]},{"type":"verse","number":14,"content":["དེར་མ་ཟད་ཁྱོད་ཀྱིས་ངེད་རྣམས་འོ་མ་དང་སྦྲང་རྩི་བཞུར་བའི་ཡུལ་དུ་མ་ཁྲིད་ལ། ས་ཞིང་དང་རྒུན་འབྲུམ་ར་བ་དག་ཀྱང་ངེད་རྣམས་ལ་ས་སྐལ་དུ་མ་བྱིན། ཁྱོད་ཀྱིས་མི་འདི་དག་གི་མིག་འདོན་པར་བྱའམ། ངེད་གཉིས་ཡར་མི་འགྲོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་མོ་ཤེ་ཤིན་ཏུ་ཁྲོས་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་དེ་དག་གི་མཆོད་པ་མི་གཟིགས་པར་མཛོད། ངས་དེ་དག་ལས་བོང་བུ་གཅིག་ཀྱང་བླངས་མེད་ལ། ཁོ་རྣམས་ལས་མི་གཅིག་ལ་ཡང་གནོད་པ་བཏང་མེད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":16,"content":["མོ་ཤེ་ཡིས་ཀོ་རཱག་ལ་འདི་ལྟར། སང་ཉིན་ཁྱོད་དང་ཁྱོད་ཀྱི་འགྲོགས་ཡ་རྣམས་དང་། དེ་མིན་ཨ་རོན་བཅས་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འཛོམ་པར་གྱིས་ཤིག"]},{"type":"verse","number":17,"content":["ཁྱོད་ཅག་མི་རེ་རེས་རང་གི་སྤོས་ཕོར་ཁྱེར་ནས་དེ་དག་གི་ནང་དུ་སྤོས་ཞོག་ཅིག མི་རེ་རེས་རང་རང་གི་སྤོས་ཕོར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་འཁྱེར་འོང་དགོས་ལ། བསྡོམས་པས་སྤོས་ཕོར་ཉིས་བརྒྱ་ལྔ་བཅུ་ཡིན། ཁྱོད་དང་ཨ་རོན་གཉིས་ཀྱིས་ཀྱང་རང་རང་གི་སྤོས་ཕོར་འཁྱེར་འོང་དགོས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་ཁོ་རྣམས་མི་རེ་རེས་རང་རང་གི་སྤོས་ཕོར་ཁྱེར་ནས་དེ་དག་གི་སྟེང་དུ་མེ་དང་མེའི་སྟེང་དུ་སྤོས་བཞག་རྗེས། མོ་ཤེ་དང་ཨ་རོན་མཉམ་དུ་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་འགྲེང་ངོ་། །"]},{"type":"verse","number":19,"content":["ཀོ་རཱག་གིས་མི་ཚོགས་ཡོངས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་རྒོལ་བར་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་བསྡུས་པ་ན། དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་འོད་མི་ཚོགས་ཡོངས་ལ་མངོན་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":20,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":21,"content":["བདག་གིས་མི་ཚོགས་འདི་སྐད་ཅིག་ཉིད་ལ་རྩ་ནས་འཇོམས་པའི་ཕྱིར། ཁྱོད་གཉིས་དེ་དག་དང་གྱེས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱིས་གདོང་སར་བཏུད་ནས་འདི་ལྟར། ཀྱེ་དཀོན་མཆོག ལུས་ཅན་ཐམས་ཅད་ཀྱི་སེམས་ཉིད་ཀྱི་དཀོན་མཆོག་ལགས། མི་གཅིག་གིས་སྡིག་པ་བྱས་པས་ཁྱེད་ཉིད་མི་ཚོགས་ཡོངས་ལ་ཐུགས་ཁྲོ་བར་མཛད་དམ་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཀྱིས་མི་ཚོགས་ལ། ཁྱོད་རྣམས་ཀོ་རཱག་དང་། དཱ་ཐན། ཨ་བི་རཱམ་བཅས་ཀྱི་གུར་དང་འབྲལ་བར་གྱིས་སྨྲོས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":25,"content":["དེ་ནས་མོ་ཤེ་ཡར་ལངས་ནས་དཱ་ཐན་དང་ཨ་བི་རཱམ་གཉིས་ཀྱི་རྩར་ཕྱིན་པ་དང་། ཡེས་ར་ཨེལ་གྱི་རྒན་པོ་རྣམས་ཀྱང་ཁོང་གི་རྗེས་སུ་འབྲངས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་མོ་ཤེ་ཡིས་མི་ཚོགས་ལ་འདི་ལྟར། ཁྱོད་ཅག་མི་ངན་འདི་དག་གི་གུར་རྣམས་དང་རིང་དུ་འབྲལ་བར་གྱིས། ཁྱོད་རྣམས་དེ་དག་གི་སྡིག་པའི་རྐྱེན་གྱིས་རླུང་གིས་འཁུར་བ་ལྟར་མི་འགྱུར་བའི་སླད། དེ་དག་གི་ཡིན་པ་གང་ལ་ཡང་རེག་པར་མི་བྱའོ་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":27,"content":["མི་ཚོགས་ཀོ་རཱག་དང་དཱ་ཐན་དང་ཨ་བི་རཱམ་བཅས་ཀྱི་གུར་གྱི་ཕྱོགས་བཞིར་བྲལ་ཞིང་། དཱ་ཐན་དང་ཨ་བི་རཱམ་གཉིས་ཀྱིས་རང་གི་ཆུང་མ་རྣམས་དང་བུ་ཕྲུག་དང་ཕྲུ་གུ་བཅས་ཁྲིད་ནས་ཐོན་ཏེ་རང་གི་གུར་རྣམས་ཀྱི་སྒོ་ཁར་འགྲེང་ནས་བསྡད་དོ། །"]},{"type":"verse","number":28,"content":["མོ་ཤེ་ཡིས་འདི་ལྟར། དོན་འདི་ཐམས་ཅད་ནི་ངས་རང་གི་བསམ་ཚུལ་བཞིན་དུ་སྒྲུབ་པ་མ་ཡིན་པར། དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་དོན་འདི་རྣམས་བསྒྲུབ་ཏུ་མངགས་པ་ཁྱོད་ཅག་གིས་འདི་ནས་ཤེས་ཡོང་སྟེ།"]},{"type":"verse","number":29,"content":["གལ་སྲིད་མི་འདི་རྣམས་འཆི་བ་ནི་མི་ཐམས་ཅད་ཀྱི་ལུགས་ལྟར་ཡིན་པའམ། ཡང་ན་ཁོ་རྣམས་ཀྱིས་མྱོང་བ་ནི་མི་ཐམས་ཅད་ཀྱིས་མྱོང་བ་བཞིན་དུ་ཡིན་ན། དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་མངགས་པ་མ་ཡིན་ཏེ།"]},{"type":"verse","number":30,"content":["གལ་སྲིད་དཀོན་མཆོག་ཡ་ཝཱེས་དོན་ཞིག་གསར་དུ་བཏོད་ཅིང། ས་གཞིས་རང་གི་ཁ་གདངས་ཏེ་ཁོ་རྣམས་དང་ཁོ་རྣམས་ལ་ཡོད་པ་ཐམས་ཅད་ཁྱུར་མིད་བཏང་ནས་གསོན་པོར་གཤིན་ཡུལ་དུ་ནུབ་ན། དེ་ནས་མི་འདི་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་སྐུར་བ་བཏབ་པ་ཁྱོད་ཅག་གིས་ཤེས་པར་འགྱུར་རོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":31,"content":["མོ་ཤེ་ཡིས་གཏམ་དེ་ཐམས་ཅད་བརྗོད་ཚར་བ་ན། དེ་རྣམས་ཀྱི་རྐང་འོག་གི་ས་གཞི་གས་ཤིང་།"]},{"type":"verse","number":32,"content":["ས་གཞིས་རང་གི་ཁ་གདངས་ནས་དེ་དག་དང་དེ་དག་གི་ཁྱིམ་ཚང་དང་། ཀོ་རཱག་གི་མི་དང་ནོར་རྫས་ཐམས་ཅད་ཁྱུར་མིད་བཏང་ངོ་། །"]},{"type":"verse","number":33,"content":["དེ་བཞིན་ཁོ་རྣམས་དང་ཁོ་རྣམས་ལ་དབང་བ་ཐམས་ཅད་གསོན་པོར་གཤིན་ཡུལ་དུ་ནུབ་ཅིང་། ས་གཞིས་ཁོ་རྣམས་བཀབ་སྟེ་མི་ཚོགས་ལས་མེད་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":34,"content":["དེ་དག་གི་མཐའ་འཁོར་དུ་ཡོད་པའི་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་ཀྱིས་དེ་རྣམས་ཀྱི་ངུ་འབོད་ཐོས་ནས་བྲོས་ཤིང་། ས་གཞིས་རང་ཅག་ཀྱང་ཁྱུར་མིད་གཏོང་སྲིད་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":35,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་ནས་མེ་བྱུང་སྟེ་སྤོས་བསྒྲོན་པའི་མི་ཉིས་བརྒྱ་དང་ལྔ་བཅུ་བཅོམ་པའོ། །"]},{"type":"verse","number":36,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":37,"content":["ཁྱོད་ཀྱིས་མཆོད་དཔོན་ཨ་རོན་གྱི་བུ་ཨེ་ལི་ཨ་ཟར་ལ་ཁ་བསྒོ་བཏང་ནས། ཁོ་ལ་སྤོས་ཕོར་དེ་དག་མེ་རོའི་ཁྲོད་ནས་ལེན་པ་དང་མེ་ནི་ས་གཞན་ལ་གཏོར་དུ་འཇུག་དགོས། དེ་ནི་སྤོས་ཕོར་རྣམས་དམ་པ་ཡིན་པས་སོ། །"]},{"type":"verse","number":38,"content":["སྡིག་པ་བྱས་ནས་རང་སྲོག་བརླག་པ་དེ་རྣམས་ཀྱི་སྤོས་ཕོར་ཁྱོད་ཅག་གིས་ལེབ་མོར་བརྡུངས་ཏེ་མཆོད་ཁྲི་གཡོག་སྤྱད་དུ་བྱེད་དགོས། སྤོས་ཕོར་དེ་དག་ཁོ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་མྱོང་བས་དམ་པ་ཡིན་པར་མ་ཟད། དེ་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཕྱི་འདོམས་ཀྱི་རྟགས་ཤིག་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":39,"content":["དེ་ནས་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་གྱིས་མེས་བསྲེགས་པའི་མི་དེ་དག་གིས་ཕུལ་མྱོང་བའི་ལི་ཡི་སྤོས་ཕོར་རྣམས་བླངས་ནས། ལེབ་མོར་བརྡུང་དུ་བཅུག་སྟེ་མཆོད་ཁྲི་གཡོག་སྤྱད་དུ་བྱས་པ་དང་།"]},{"type":"verse","number":40,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ལ་ཕྱི་འདོམས་ཀྱི་རྟགས་ཤིག་ཏུ་བཞག་ཅིང་། ཨ་རོན་གྱི་རིགས་རྒྱུད་མ་ཡིན་པའི་ཕྱི་མི་སུ་ཡིན་ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཡོང་ནས་སྤོས་བསྒྲོན་པར་མི་བྱ་སྟེ། ཁོ་རང་ཀོ་རཱག་དང་ཁོའི་འགྲོགས་ཡ་བཞིན་དུ་མི་འགྱུར་བའི་ཕྱིར་ཡིན་ལ། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་ནས་ཨེ་ལི་ཨ་ཟར་ལ་གནང་བའི་བཀའ་བཞིན་ནོ། །"]},{"type":"verse","number":41,"content":["དེའི་ཕྱི་ཉིན་ཡེས་ར་ཨེལ་པའི་མི་ཚོགས་ཡོངས་ཀྱིས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འཁང་ར་བྱས་ཏེ་ན་རེ། ཁྱོད་གཉིས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་འབངས་མི་བསད་པ་ཡིན་ཞེས་སྨྲས་ཤིང་།"]},{"type":"verse","number":42,"content":["མི་ཚོགས་འདུས་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་རྒོལ་བའི་ཚེ། ཁོ་གཉིས་ཁ་ཕྱིར་འཁོར་ནས་མཇལ་འཕྲད་གུར་མཆོག་གི་ཕྱོགས་སུ་བལྟས་པ་ན། ཀྱེ་མ། མཇལ་འཕྲད་གུར་མཆོག་སྤྲིན་གྱིས་གཡོགས་ཤིང་དཀོན་མཆོག་ཡ་ཝཱེའི་གཟི་འོད་མངོན་པར་གྱུར་ཏོ། །"]},{"type":"verse","number":43,"content":["དེ་ནས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་མཇལ་འཕྲད་གུར་མཆོག་གི་མདུན་དུ་སོང་བ་དང་།"]},{"type":"verse","number":44,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":45,"content":["ཁྱོད་གཉིས་མི་ཚོགས་འདི་དང་འབྲལ་བར་གྱིས་ཤིག བདག་གིས་ཁོ་རྣམས་སྐད་ཅིག་ཉིད་ལ་མེད་པར་བྱའོ་ཞེས་གསུངས་པ་ན། ཁོ་གཉིས་ཀྱིས་གདོང་སར་བཏུད་དོ། །"]},{"type":"verse","number":46,"content":["མོ་ཤེ་ཡིས་ཨ་རོན་ལ་འདི་ལྟར། ཁྱོད་ཀྱིས་སྤོས་ཕོར་ལོངས་ལ་མཆོད་ཁྲིའི་སྟེང་གི་མེ་དེའི་ནང་དུ་བླུགས་ཤིག དེའི་སྟེང་དུ་སྤོས་བསྒྲོན་རྗེས་མགྱོགས་པོར་མི་ཚོགས་ཡོད་སར་སོང་ལ། ཁོ་རྣམས་ཀྱི་དོན་དུ་སྡིག་བཤགས་བྱོས་ཤིག གང་ལ་ཟེར་ན། དཀོན་མཆོག་ཡ་ཝཱེ་ཐུགས་རབ་ཏུ་ཁྲོས་ཤིང་། གཉན་ནད་འགོ་ཚུགས་ཟིན་པའི་ཕྱིར་རོ་ཞེས་སྨྲས།"]},{"type":"verse","number":47,"content":["དེ་ནས་ཨ་རོན་གྱིས་མོ་ཤེ་ཡིས་བསྒོས་པ་བཞིན་དུ། སྤོས་ཕོར་ཁྱེར་ནས་མི་ཚོགས་ཀྱི་དཀྱིལ་དུ་རྒྱུགས་པ་ལ། ལྟོས་དང་། མི་རྣམས་ཀྱི་ཁྲོད་དུ་དངོས་གནས་གཉན་ནད་བྱུང་འགོ་ཚུགས། དེ་ནས་ཁོས་སྤོས་བསྒྲོན་ཞིང་མི་ཚོགས་ཀྱི་དོན་དུ་སྡིག་བཤགས་བྱས་སོ། །"]},{"type":"verse","number":48,"content":["ཁོ་ནི་གཤིན་པོ་དང་གསོན་པོ་གཉིས་ཀྱི་བར་ནས་འགྲེང་པ་ན། གཉན་ནད་མཚམས་ཆད་དོ། །"]},{"type":"verse","number":49,"content":["ཀོ་རཱག་གི་དོན་རྐྱེན་དབང་གིས་ཤི་བ་རྣམས་ལས་གཞན་གཉན་ནད་ལས་ཤི་བའི་མི་ནི་ཆིག་ཁྲི་བཞི་སྟོང་བདུན་བརྒྱའོ། །"]},{"type":"verse","number":50,"content":["དེ་ནས་ཨ་རོན་ཕྱིར་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁ་རུ་མོ་ཤེའི་རྩར་འབྱོར་བ་ན། གཉན་ནད་མཚམས་ཆད་དོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/15.json","previousChapterAudioLinks":{},"numberOfVerses":50}