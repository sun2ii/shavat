{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":2,"content":[{"type":"heading","content":["སྒར་འདེབས་པའི་གོ་རིམ་དང་གནས་ཡུལ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་རང་རང་གི་རུ་དར་དང་རང་རང་གི་ཕ་ཁྱིམ་གྱི་དར་ཆེན་འོག་ཏུ་སྒར་འདེབས་དགོས། དེ་རྣམས་ཀྱིས་མཇལ་འཕྲད་གུར་མཆོག་གི་ཕྱོགས་བཞི་རུ་རྒྱང་ཐག་ཅུང་རིང་བའི་གནས་སུ་སྒར་འདེབས་དགོས།"]},{"type":"verse","number":3,"content":["ཤར་ཕྱོགས་སྐྱ་རེངས་ཤར་བའི་གནས་སུ་དམག་ཚོགས་བཞིན་དུ་སྒར་འདེབས་མཁན་ནི་ཡ་ཧུ་དཱའི་སྒར་ཁའི་དར་ཆེན་ཡིན་ལ། ཡ་ཧུ་དཱ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཨ་མི་ནཱ་དབ་ཀྱི་བུ་ནཱ་སོན་ཡིན་ཞིང་།"]},{"type":"verse","number":4,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་བདུན་ཁྲི་བཞི་སྟོང་དྲུག་བརྒྱའོ། །"]},{"type":"verse","number":5,"content":["དེའི་གཞོགས་སུ་སྒར་འདེབས་མཁན་ནི་ཡེས་སི་ཀཱར་ཚོ་པ་ཡིན་པ་དང་། ཡེས་སི་ཀཱར་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཙུ་ཨར་གྱི་བུ་ནེ་ཐན་ཨེལ་ཡིན་ཞིང་།"]},{"type":"verse","number":6,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ལྔ་ཁྲི་བཞི་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ཟེ་བུ་ལུན་གྱི་ཚོ་པ་ཡོད་པ་དང་། ཟེ་བུ་ལུན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཧེ་ལོན་གྱི་བུ་ཨེ་ལི་ཨབ་ཡིན་ཞིང་།"]},{"type":"verse","number":8,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ལྔ་ཁྲི་བདུན་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":9,"content":["ཡ་ཧུ་དཱའི་སྒར་ནས་དམག་ཚོགས་བཞིན་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ཆིག་འབུམ་བརྒྱད་ཁྲི་དྲུག་སྟོང་བཞི་བརྒྱ་ཡིན་ལ། དེ་དག་སྔོན་དུ་ལམ་ལ་ཆས་དགོས་སོ། །"]},{"type":"verse","number":10,"content":["ལྷོ་ཕྱོགས་སུ་དམག་ཚོགས་བཞིན་དུ་རུ་བེན་གྱི་སྒར་ཁའི་དར་ཆེན་ཡོད་པ་དང་། རུ་བེན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཤེ་དེ་ཨུར་གྱི་བུ་ཨེ་ལི་ཚུར་ཡིན་ཞིང་།"]},{"type":"verse","number":11,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་བཞི་ཁྲི་དྲུག་སྟོང་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":12,"content":["དེའི་གཞོགས་སུ་སྒར་འདེབས་མཁན་ནི་སི་མུ་ཨོན་ཚོ་པ་ཡིན་ལ། སི་མུ་ཨོན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཙུ་རེ་ཤད་དཱ་ཨིའི་བུ་ཤེ་ལུ་མེ་ཨེལ་ཡིན་ཞིང་།"]},{"type":"verse","number":13,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ལྔ་ཁྲི་དགུ་སྟོང་སུམ་བརྒྱའོ། །"]},{"type":"verse","number":14,"content":["དེ་ནས་གཱ་རྡུ་ཚོ་པ་ཡོད་པ་དང་། གཱ་རྡུ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་དི་ཨོ་ཨེལ་",{"noteId":0},"གྱི་བུ་ཨེལ་ཡཱ་སབ་ཡིན་ཞིང་།"]},{"type":"verse","number":15,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་བཞི་ཁྲི་ལྔ་སྟོང་དྲུག་བརྒྱ་ལྔ་བཅུའོ། །"]},{"type":"verse","number":16,"content":["རུ་བེན་གྱི་སྒར་ནས་དམག་ཚོགས་བཞིན་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ཆིག་འབུམ་ལྔ་ཁྲི་ཆིག་སྟོང་བཞི་བརྒྱ་ལྔ་བཅུ་ཡིན་ལ། དེ་དག་གྲལ་གཉིས་པ་བྱས་ནས་ལམ་དུ་ཆས་དགོས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་མཇལ་འཕྲད་གུར་མཆོག་དང་ལེ་ཝི་པ་རྣམས་ཀྱི་སྒར་དེ་སྒར་རྣམས་ཀྱི་དཀྱིལ་ནས་མདུན་དུ་བསྐྱོད་དགོས། དེ་དག་གིས་ཇི་ལྟར་སྒར་བཏབ་ན་དེ་ལྟར་ལམ་ལ་ཆས་ཏེ་མདུན་དུ་བསྐྱོད་པ་དང་། སོ་སོའི་རང་གནས་སུ་རང་རང་གི་དར་ཆེན་འོག་ཏུ་ཡོད་དགོས་སོ། །"]},{"type":"verse","number":18,"content":["ནུབ་ཕྱོགས་སུ་དམག་ཚོགས་བཞིན་དུ་ཨེ་ཕཱར་ཡིམ་གྱི་སྒར་ཁའི་དར་ཆེན་ཡོད་པ་དང་། ཨེ་ཕཱར་ཡིམ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ཨམ་མེ་ཧུད་ཀྱི་བུ་ཨེ་ལི་ཤ་མཱ་ཡིན་ཞིང་།"]},{"type":"verse","number":19,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་བཞི་ཁྲི་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":20,"content":["དེའི་གཞོགས་སུ་མཱ་ན་ཤེ་ཚོ་པ་ཡོད་པ་དང་། མཱ་ན་ཤེ་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཕེ་དཱ་ཚུར་གྱི་བུ་གམ་ལི་ཨེལ་ཡིན་ཞིང་།"]},{"type":"verse","number":21,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་སུམ་ཁྲི་ཉིས་སྟོང་ཉིས་བརྒྱའོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་པེན་ཡཱ་མེན་ཚོ་པ་ཡོད་པ་དང་། པེན་ཡཱ་མེན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་གིད་ཨོ་ནཱའི་བུ་ཨ་བི་ཏན་ཡིན་ཞིང་།"]},{"type":"verse","number":23,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་སུམ་ཁྲི་ལྔ་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":24,"content":["ཨེ་ཕཱར་ཡིམ་གྱི་སྒར་ནས་དམག་ཚོགས་བཞིན་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ཆིག་འབུམ་བརྒྱད་སྟོང་དང་བརྒྱ་ཡིན་ལ། དེ་དག་གྲལ་གསུམ་པ་བྱས་ནས་ལམ་དུ་ཆས་དགོས་སོ། །"]},{"type":"verse","number":25,"content":["བྱང་ཕྱོགས་སུ་དམག་ཚོགས་བཞིན་དུ་དཱན་གྱི་སྒར་ཁའི་དར་ཆེན་ཡོད་པ་དང་། དཱན་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཨམ་མེ་ཤད་ད་ཨི་ཡི་བུ་ཨ་ཧི་ཨེ་ཟེར་ཡིན་ཞིང་།"]},{"type":"verse","number":26,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་དྲུག་ཁྲི་ཉིས་སྟོང་བདུན་བརྒྱའོ། །"]},{"type":"verse","number":27,"content":["དེའི་གཞོགས་སུ་སྒར་འདེབས་མཁན་ནི་ཨ་ཤེར་ཚོ་པ་ཡིན་པ་དང་། ཨ་ཤེར་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཨོག་རན་གྱི་བུ་ཕཱ་གེ་ཨེལ་ཡིན་ཞིང་།"]},{"type":"verse","number":28,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་བཞི་ཁྲི་ཆིག་སྟོང་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":29,"content":["དེ་ནས་ནཱབ་ཐ་ལིའི་ཚོ་པ་ཡོད་པ་དང་། ནཱབ་ཐ་ལི་པ་རྣམས་ཀྱི་འགོ་དཔོན་ནི་ཨེ་ནན་གྱི་བུ་ཨ་ཧི་རཱ་ཡིན་ཞིང་།"]},{"type":"verse","number":30,"content":["དེའི་དམག་ཚོགས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ལྔ་ཁྲི་སུམ་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":31,"content":["དཱན་གྱི་སྒར་ནས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་ཆིག་འབུམ་ལྔ་ཁྲི་བདུན་སྟོང་དྲུག་བརྒྱ་ཡིན། དེ་དག་གིས་དར་ཆེན་བསྒྲེངས་ནས་མཇུག་ཏུ་ལམ་ལ་ཆས་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":32,"content":["དེ་དག་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་རང་རང་གི་ཕ་ཁྱིམ་བཞིན་དུ་རྩིས་བླངས་པའི་མི་གྲངས་ཡིན་པ་དང་། སོ་སོའི་དམག་ཚོགས་བཞིན་སྒར་རྣམས་ལས་རྩིས་བླངས་པའི་མི་གྲངས་ནི་བསྡོམས་པས་དྲུག་འབུམ་སུམ་སྟོང་ལྔ་བརྒྱ་ལྔ་བཅུ་ཡིན་ནོ། །"]},{"type":"verse","number":33,"content":["འོན་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་བཀའ་བསྩལ་པ་བཞིན་དུ། ལེ་ཝི་པ་རྣམས་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་མ་བརྩིས་སོ། །"]},{"type":"verse","number":34,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་བསྒོས་པའི་བཀའ་བཞིན་དུ་བྱས་ཤིང་། དེ་དག་གིས་རང་རང་གི་དར་ཆེན་འོག་ཏུ་སྒར་བཏབ་པ་དང་། མི་རེ་རེ་རང་རང་གི་རུས་རྒྱུད་དང་ཕ་ཁྱིམ་བཞིན་དུ་ལམ་ལ་ཆས་པའོ། །"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འདིར་དི་ཨོ་ཨེལ་ཞེས་པ་ནི་འགྱུར་ལ་ལར་རུའུ་ཨེལ་ཞེས་ཀྱང་བཀོད་ཡོད།","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/bod_ntb/NUM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/1.json","previousChapterAudioLinks":{},"numberOfVerses":34}