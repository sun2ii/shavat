{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":21,"content":[{"type":"heading","content":["ཨ་རད་མེད་པར་བཏང་བ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ནེ་གུབ་ཡུལ་དུ་གནས་པའི་ཨ་རད་ཀྱི་རྒྱལ་པོ་ཀ་ན་ཨན་པ་དེས། ཡེས་ར་ཨེལ་པ་རྣམས་ཨ་ཐཱ་རིམ་གྱི་ལམ་ནས་ཡོང་བ་ཐོས་ཏེ། ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འཐབ་ཅིང་མི་འགའ་ཤས་བཟུང་ནས་ཁྲིད།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དམ་བཅས་ཏེ་ན་རེ། གལ་སྲིད་ཁྱེད་ཀྱིས་མི་འདི་རྣམས་ངེད་ཅག་གི་ལག་ཏུ་སྤྲོད་པར་མཛད་ན། ངེད་རྣམས་ཀྱིས་དེ་དག་གི་གྲོང་ཁྱེར་རྣམས་མེད་པར་བྱེད་ངེས་ཡིན་ཞེས་ཞུས།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཞུ་བ་གསན་ནས། ཀ་ན་ཨན་པ་རྣམས་དེ་དག་གི་ལག་ཏུ་གཏད་ཅིང་། དེ་དག་གིས་ཀ་ན་ཨན་པ་རྣམས་དང་དེ་ཚོའི་གྲོང་ཁྱེར་རྣམས་རྩ་ནས་བཤིགས་པས། གནས་དེའི་མིང་ལ་ཧོར་མཱ་ཞེས་བཏགས་སོ། །"]},{"type":"heading","content":["ལི་ཡི་སྦྲུལ།"]},{"type":"verse","number":4,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་རི་བོ་ཧོར་ནས་རྒྱ་མཚོ་དམར་པོར་འགྲོ་བའི་ལམ་བརྒྱུད་དེ། ཨེ་དོམ་གྱི་ཡུལ་བསྐོར་ནས་སོང་བ་ལ། ལམ་དེའི་རྐྱེན་གྱིས་མི་རྣམས་སེམས་འཚབས་ཏེ།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་དང་མོ་ཤེ་གཉིས་ལ་རྒོལ་ཞིང་ན་རེ། ཁྱེད་གཉིས་ཀྱིས་ངེད་རྣམས་ཅིའི་ཕྱིར་ཨེ་ཅིབ་ཡུལ་ནས་ཁྲིད་ཡོང་སྟེ་དབེན་སྟོང་དུ་འཆི་བར་བྱའམ། འདི་རུ་བག་ལེབ་མེད་ལ་ཆུ་ཡང་མེད། ཁ་ཟས་སྐྱོ་བོ་འདི་ལ་ངེད་རྣམས་སྐྱུག་མེར་ལངས་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་དུག་སྦྲུལ་རྣམས་མི་ཚོགས་ཁྲོད་དུ་བཏང་ཞིང་། སྦྲུལ་གྱིས་ཁོ་རྣམས་ལ་རྨུགས་པས་ཡེས་ར་ཨེལ་པ་མང་པོ་ཤི་བར་གྱུར།"]},{"type":"verse","number":7,"content":["དེ་ནས་མི་རྣམས་ཡོང་ནས་མོ་ཤེ་ལ། ངེད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་དང་ཁྱེད་ལ་གཏམ་ངན་གྱིས་རྒོལ་བས་སྡིག་པ་བསགས། དཀོན་མཆོག་ཡ་ཝཱེས་སྦྲུལ་དེ་དག་ངེད་ཅག་དང་འབྲལ་བར་མཛད་པའི་ཕྱིར་ཁྱེད་ཀྱིས་སྨོན་ལམ་འདེབས་རོགས་ཞེས་ཞུས་པ་ན། མོ་ཤེ་ཡིས་མི་རྣམས་ཀྱི་དོན་དུ་སྨོན་ལམ་བཏབ་བོ། །"]},{"type":"verse","number":8,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་དུག་སྦྲུལ་ཞིག་བཟོས་ལ་ཀ་བའི་རྩེ་མོར་སྐྱོན་དང་། སྦྲུལ་གྱིས་རྨུགས་པའི་མི་ཀུན་གྱིས་སྦྲུལ་དེར་བལྟས་མ་ཐག་གསོན་པར་འགྱུར་ཞེས་གསུངས་པས།"]},{"type":"verse","number":9,"content":["མོ་ཤེ་ཡིས་ལི་ཡི་སྦྲུལ་ཞིག་བཟོས་ནས་ཀ་བའི་རྩེ་མོར་བསྐྱོན། དེ་ནས་སྦྲུལ་གྱིས་རྨུགས་པའི་མི་སུ་ཡིན་ཡང་ལི་ཡི་སྦྲུལ་དེར་བལྟས་པ་ཙམ་གྱིས་གསོན་པར་གྱུར་ཏོ། །"]},{"type":"heading","content":["མོ་ཨབ་ཏུ་བགྲོད་པའི་ལམ་ཐག"]},{"type":"verse","number":10,"content":["ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ལམ་དུ་ཆས་པ་དང་། ཨོ་བོད་བྱ་བའི་ཡུལ་ནས་སྒར་བཏབ།"]},{"type":"verse","number":11,"content":["ཡང་ཨོ་བོད་ནས་ལམ་དུ་ཞུགས་པ་དང་། མོ་ཨབ་ཕ་རོལ་གྱི་དབེན་སྟོང་དུ་ཡོད་ལ་ཤར་ཕྱོགས་སུ་འཁོར་བའི་ཨི་ཡེ་ཨ་བཱ་རིམ་ཡུལ་དུ་སྒར་བཏབ་བོ། །"]},{"type":"verse","number":12,"content":["ཡང་ཁོ་རྣམས་དེ་ནས་ལམ་དུ་ཆས་ཏེ་ཟེ་རེད་ལུང་པར་སྒར་བཏབ་པ་དང་།"]},{"type":"verse","number":13,"content":["ཡང་དེ་ནས་ལམ་དུ་ཆས་ཏེ་ཨར་ནོན་ཆུ་བོའི་ཕ་རོལ་ཏུ་སྒར་བཏབ། ཨར་ནོན་ཆུ་བོ་ནི་དབེན་སྟོང་དུ་ཡོད་ཅིང་ཨེ་མོར་པ་རྣམས་ཀྱི་ས་མཚམས་ནས་བཞུར་འོངས་པ་ཡིན། མ་གཞི་ཨར་ནོན་ཆུ་བོ་ནི་མོ་ཨབ་ཀྱི་མཐའ་མཚམས་ཡིན་ལ། མོ་ཨེབ་དང་ཨེ་མོར་པའི་བར་མཚམས་སུ་ཡོད་པའོ། །"]},{"type":"verse","number":14,"content":["དེར་བརྟེན་དཀོན་མཆོག་ཡ་ཝཱེའི་དམག་འཁྲུག་གི་ལོ་རྒྱུས་དཔེ་ཆ་རུ།",{"text":"སུབ་ཕཱའི་ཝཱ་ཧེབ་ཨར་ནོན་གྲོག་ཤུར་རྣམས། །","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"གྲོག་མོའི་ཐུར་གསེག་ཨར་ལ་ཐུག་པ་དང་། །","poem":1},{"lineBreak":true},{"text":"མོ་ཨབ་ས་མཚམས་དང་ནི་ཉེ་བ་འོ། །ཞེས་བཀོད་པའོ། །","poem":1}]},{"type":"verse","number":16,"content":["ཡང་དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་པེར་ཞེས་པའི་ཁྲོན་པ་རུ་སླེབས་ཤིང་། སྔར་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་མི་ཚོགས་གནས་དེར་སྡུས་ཤིག་དང་། བདག་གིས་དེ་དག་ལ་ཆུ་སྦྱིན་པར་བྱ་ཞེས་གསུངས་པ་ནི་ཁྲོན་པ་དེའི་སྐོར་ཡིན་ནོ། །"]},{"type":"verse","number":17,"content":["དེའི་དུས་སུ་ཡེས་ར་ཨེལ་པས་མགུར་འདི་བླངས་པ་སྟེ།",{"text":"ཀྱེ་ཀྱེ་ཁྲོན་པ་ཆུ་འཕྱུར་ཤོག །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཅག་དེ་ལ་གླུ་ལོངས་ཤིག །","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ཁྲོན་པ་འདི་ནི་འགོ་དཔོན་རྣམས་ཀྱིས་བརྐོས། །","poem":1},{"lineBreak":true},{"text":"དེ་ནི་དམངས་ཁྲོད་སྐུ་དྲག་རྣམས་ཀྱིས་ནི། །","poem":1},{"lineBreak":true},{"text":"ཕྱག་འཁར་དང་ནི་འཁར་བས་བསྔོགས་པ་ཡིན། ། ཞེས་པའོ། །","poem":1},"དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་དབེན་སྟོང་ནས་མད་ཐ་ནཱ་རུ་སླེབས་པ་དང་།"]},{"type":"verse","number":19,"content":["མད་ཐ་ནཱ་ནས་ནཱ་ཧ་ལི་ཨེལ་དང་། ནཱ་ཧ་ལི་ཨེལ་ནས་པཱ་མོད་དང་།"]},{"type":"verse","number":20,"content":["པཱ་མོད་ནས་མོ་ཨབ་ཡུལ་གྱི་ལུང་པ་དང་། ཡང་དབེན་སྟོང་ལ་ཁ་ཐུར་ལྟའི་རི་བོ་ཕིས་གའི་རྩེ་མོར་སླེབས་སོ། །"]},{"type":"heading","content":["ཨེ་མོར་པའི་རྒྱལ་པོ་དང་པཱ་ཤན་གྱི་རྒྱལ་པོ་གཉིས་ཀ་ཕམ་པར་བརྒྱབ་པ།"]},{"type":"verse","number":21,"content":["ཡེས་ར་ཨེལ་པས་ཨེ་མོར་པའི་རྒྱལ་པོ་སི་ཧོན་ལ་བང་ཆེན་བཏང་སྟེ་ན་རེ།"]},{"type":"verse","number":22,"content":["ཁྱེད་ཀྱིས་ངེད་རྣམས་ཁྱེད་ཀྱི་ཡུལ་བརྒྱུད་དེ་འགྲོ་རུ་འཇུག་པར་མཛོད། ངེད་ཅག་ཞིང་ཁ་དང་རྒུན་འབྲུམ་ར་བར་མི་འགྲོ་ལ། ཁྲོན་པ་དག་གི་ཆུ་ཡང་མི་འཐུང་། ཁྱེད་ཀྱི་ས་མཚམས་ནས་བརྒལ་བའི་བར་དུ་ངེད་རྣམས་རྒྱལ་པོའི་ལམ་ཆེན་ནས་འགྲོ་བར་བྱའོ་ཞེས་སྨྲས་ནའང་།"]},{"type":"verse","number":23,"content":["སི་ཧོན་གྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་རང་གི་ས་མཚམས་བརྒལ་ནས་འགྲོ་རུ་འཇུག་པ་ཕར་ཞོག ཁོས་རང་གི་མི་ཐམས་ཅད་བསྡུས་ཏེ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འཐབ་ཕྱིར་དབེན་སྟོང་དུ་ཕྱིན་པ་དང་། ཡ་ཧ་ཙཱ་བྱ་བར་སླེབས་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་དམག་བརྒྱབ་པའོ། །"]},{"type":"verse","number":24,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པས་ཁོ་རལ་གྲིས་བསད་ཅིང་། ཨར་ནོན་ནས་ཡཱབ་པོག་དང་། དེ་ནས་ཨམ་མོན་པ་རྣམས་ཀྱི་བར་དུ་ཁོའི་ས་ཆ་རྣམས་བདག་ཏུ་བཟུང་། ཨམ་མོན་པའི་ས་མཚམས་ནི་བརྟན་འཇགས་ཡིན་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":25,"content":["ཡེས་ར་ཨེལ་པས་གྲོང་ཁྱེར་དེ་ཐམས་ཅད་ཕྲོགས་ཤིང་། ཨེ་མོར་པའི་གྲོང་ཁྱེར་སོ་སོ་སྟེ་ཧེ་སི་པོན་བྱ་བ་དང་དེར་གཏོགས་པའི་གྲོང་སྡེ་ཐམས་ཅད་ནས་གཞིས་ཕབ་བོ། །"]},{"type":"verse","number":26,"content":["ཧེ་སི་པོན་ནི་ཨེ་མོར་པ་རྣམས་ཀྱི་རྒྱལ་པོ་སི་ཧོན་གྱི་རྒྱལ་ས་ཡིན་པ་དང་། ཁོས་སྔར་མོ་ཨབ་ཀྱི་རྒྱལ་པོ་སྔོན་མར་དམག་བརྒྱབ་ཅིང་དེའི་ལག་ནས་ཨར་ནོན་ཆུ་བོའི་བར་དུ་ས་ཆ་ཐམས་ཅད་ཕྲོགས་པའོ། །"]},{"type":"verse","number":27,"content":["དེའི་ཕྱིར་གཏམ་དཔེ་འཆད་མཁན་རྣམས་ཀྱིས་འདི་ལྟར།",{"text":"ཁྱོད་རྣམས་ཧེ་སི་པོན་ལ་ཕེབས། །","poem":1},{"lineBreak":true},{"text":"སི་ཧོན་རྒྱལ་པོའི་མཁར་སྐྲུན་ཅིག །","poem":1},{"lineBreak":true},{"text":"མཁར་དེ་བརྟན་པོར་བཟོ་བར་གྱིས། །","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"དེ་ནི་གང་གི་རྐྱེན་གྱིས་ཡིན་ཞེ་ན། །","poem":1},{"lineBreak":true},{"text":"ཧེ་སི་པོན་ནས་མེ་ཞིག་བྱུང་བ་དང་། །","poem":1},{"lineBreak":true},{"text":"སི་ཧོན་རྒྱལ་པོའི་མཁར་ནས་མེ་ལྕེ་འཕྱུར། །","poem":1},{"lineBreak":true},{"text":"མོ་ཨབ་ཡུལ་གྱི་ཨཱར་དང་ཨར་ནོན་གྱི། །","poem":1},{"lineBreak":true},{"text":"རི་རྒྱུད་གཙོ་བོ་རྣམས་ཀྱང་རྩ་མེད་བཏང་། །","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ཀྱེ་ཀྱེ་མོ་ཨབ་ཁྱོད་ལ་ཆག་སྒོ་བྱུང་། །","poem":1},{"lineBreak":true},{"text":"ཀེ་མོ་སི་ཡི་མི་རྣམས་མེད་པར་གྱུར། །","poem":1},{"lineBreak":true},{"text":"ལྷ་དེས་རང་གི་བུ་རྣམས་འབྲོ་རུ་བཅུག །","poem":1},{"lineBreak":true},{"text":"རང་གི་བུ་མོ་རྣམས་ནི་བཙོན་པར་བཏང་། །","poem":1},{"lineBreak":true},{"text":"ཨེ་མོར་རྒྱལ་པོ་སི་ཧོན་ལག་ཏུ་བརྫངས། །","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ང་ཚོས་མདའ་ཡིས་དེ་རྣམས་བརྒྱབས་པ་དང་། །","poem":1},{"lineBreak":true},{"text":"དི་བོན་བར་དུ་ཧེ་སི་པོན་ཚར་བཅད། །","poem":1},{"lineBreak":true},{"text":"ནོ་ཕཱའི་བར་དུ་ང་ཚོས་སྟོངས་སུ་བཅུག །","poem":1},{"lineBreak":true},{"text":"དེ་ནི་མེ་དེ་བཱ་ཡི་བར་དུ་བསྲིངས། །ཞེས་སྨྲ་བའོ། །","poem":1}]},{"type":"verse","number":31,"content":["དེ་ལྟར་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་མོར་པ་རྣམས་ཀྱི་ཡུལ་དུ་བསྡད་དོ། །"]},{"type":"verse","number":32,"content":["དེ་ཡང་མོ་ཤེ་ཡིས་ཡཱ་ཟེར་བྱ་བའི་ཡུལ་ལ་མྱུལ་མ་བཏང་བ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེའི་གྲོང་སྡེ་རྣམས་བདག་ཏུ་བཟུང་ཞིང་། དེར་གནས་པའི་ཨེ་མོར་པ་རྣམས་གཞན་དུ་བསྐྲད་དོ། །"]},{"type":"verse","number":33,"content":["དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཁ་ཕྱིར་འཁོར་ནས་པཱ་ཤན་དུ་འགྲོ་བའི་ལམ་དུ་ཞུགས་པ་ན། པཱ་ཤན་གྱི་རྒྱལ་པོ་ཨོག་ཅེས་བྱ་བ་དང་དེའི་མི་ཐམས་ཅད་འོངས་ནས་ཨེ་དྲེ་ཨི་ཡུལ་དུ་ཁོ་རྣམས་ལ་དམག་བརྒྱབ་བོ། །"]},{"type":"verse","number":34,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། བདག་གིས་ཁོ་དང་ཁོའི་མི་ཐམས་ཅད་དང་། ཁོའི་ས་ཆ་བཅས་ཁྱོད་ཀྱི་ལག་ཏུ་གཏད་ཡོད་པས། ཁོ་ལ་མ་འཇིགས་ཤིག ཁྱོད་ཀྱིས་སྔར་ཧེ་སི་པོན་དུ་གནས་པའི་ཨེ་མོར་པའི་རྒྱལ་པོ་སི་ཧོན་ལ་ཅི་ལྟར་བྱས་པ་ཡིན་ན། འདི་ལ་ཡང་དེ་ལྟར་གྱིས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"verse","number":35,"content":["དེ་ནས་ཁོ་ཚོས་ཨོག་དང་དེའི་བུ་རྣམས་དང་། དེའི་མི་ཐམས་ཅད་བསད་དེ་གཅིག་ཀྱང་མི་ལུས་པར་བྱས་ནས་དེའི་ས་ཆ་བདག་གིར་བཟུང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/20.json","previousChapterAudioLinks":{},"numberOfVerses":35}