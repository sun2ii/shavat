{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":22,"content":[{"type":"heading","content":["མོ་ཨབ་ཀྱི་རྒྱལ་པོས་པེལ་ཨམ་གདན་དྲངས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ལམ་དུ་ཆས་ནས་མོ་ཨབ་སྤང་ལྗོངས་ཏེ། ཡོར་དན་གཙང་པོའི་ཤར་ཕྱོགས་དང་། ཡེ་རུ་ཀོ་ཡི་ཁ་གཏད་དུ་སྒར་བཏབ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་ཨེ་མོར་པ་རྣམས་ལ་ཅི་བྱས་པ་ཐམས་ཅད་ཚིབ་ཕོར་གྱི་བུ་པཱ་ལག་གིས་མཐོང་བ་དང་།"]},{"type":"verse","number":3,"content":["ཁོ་ཚོར་མི་ཚོགས་མང་པོ་ཡོད་པས་མོ་ཨབ་པ་རྣམས་ཤིན་ཏུ་འཇིགས་པ་དང་། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྐྱེན་གྱིས་མོ་ཨབ་པ་རྣམས་དངངས་སྐྲག་ཆེན་པོ་སྐྱེས།"]},{"type":"verse","number":4,"content":["མོ་ཨབ་པ་རྣམས་ཀྱིས་མིད་ཡཱན་པའི་རྒན་པོ་རྣམས་ལ། བ་གླང་གིས་ཞིང་ཁའི་རྩྭ་བཟའ་བ་བཞིན་དུ། ད་ལྟ་མི་ཚོགས་འདིས་རང་ཅག་གི་ཉེ་འཁོར་ཐམས་ཅད་བལྡག་པར་འགྱུར་ཞེས་སྨྲས། དེའི་དུས་སུ་ཚིབ་ཕོར་གྱི་བུ་པཱ་ལག་ནི་མོ་ཨབ་ཀྱི་རྒྱལ་པོ་ཡིན་ལ།"]},{"type":"verse","number":5,"content":["ཁོས་པེ་ཨོར་གྱི་བུ་པེལ་ཨམ་གྱི་རྩར་བང་ཆེན་བཏང་བ་སྟེ། ཆུ་བོ་ཉེ་འགྲམ་གྱི་ཕེ་ཐོར་ཏེ་ཁོའི་ཡུལ་མི་རྣམས་ཀྱི་ས་ཆར་པེལ་ཨམ་གདན་འདྲེན་བྱེད་དུ་མངགས་ཤིང་ན་རེ། གཟིགས་དང་། མི་རིགས་ཤིག་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་བྱུང་། ཀྱེ་ཧོ། དེ་དག་ས་གཞི་ཡོངས་སུ་ཁེབས་ཤིང་ད་ལྟ་ངའི་ཁ་གཏད་དུ་བསྡད་ཡོད།"]},{"type":"verse","number":6,"content":["མི་རིགས་འདི་ནི་བདག་ལས་སྟོབས་ཆེ་བས། ད་ལྟ་ཁྱེད་རང་ཕེབས་ནས་ངའི་ཆེད་དུ་ཁོ་རྣམས་ལ་དམོད་མོ་འདེབས་རོགས། དེ་ནས་ངས་ཁོ་རྣམས་ཕམ་པར་བརྒྱབ་སྟེ་ཡུལ་འདི་ནས་སྐྲོད་ནུས་ཀྱང་སྲིད། གང་ལ་ཞེ་ན། ཁྱེད་ཀྱིས་སུ་ལ་བྱིན་གྱིས་བརླབས་ན་དེར་བྱིན་རླབས་འཐོབ་ཅིང་། ཁྱེད་ཀྱིས་སུ་ལ་དམོད་མོ་བཏབ་ན་དེར་དམོད་མོ་ཐེབས་པ་ངས་ཤེས་པ་ཡིན་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":7,"content":["མོ་ཨབ་དང་མིད༌ཡཱན་གྱི་རྒན་པོ་རྣམས་ཀྱིས་མོ་འདེབས་པའི་རྔན་པ་ལག་ལ་ཁྱེར་ནས་ཆས་པ་དང་། པེལ་ཨམ་གྱི་རྩར་སླེབས་ནས་པཱ་ལག་གི་གཏམ་ཁོ་ལ་སྨྲས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་པེལ་ཨམ་གྱིས་ཁོ་ཚོར་འདི་ལྟར། དོ་ནུབ་འདི་རུ་ཞག་སྡོད་བྱོས་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་བཀའ་ཅི་ལྟར་གསུངས་ན་ངས་དེ་བཞིན་དུ་ཁྱོད་ལ་ལན་སྦྱིན་འོང་ཞེས་སྨྲས་པས། མོ་ཨབ་ཀྱི་འགོ་དཔོན་རྣམས་པེལ་ཨམ་དང་མཉམ་དུ་བསྡད།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་པེལ་ཨམ་གྱི་རྩར་ཕེབས་ཏེ་འདི་སྐད་དུ། ཁྱོད་དང་མཉམ་དུ་ཡོད་པ་འདི་རྣམས་སུ་ཡིན་ནམ་ཞེས་གསུངས་པ་ན།"]},{"type":"verse","number":10,"content":["པེལ་ཨམ་གྱིས་དཀོན་མཆོག་ལ། མོ་ཨབ་ཀྱི་རྒྱལ་པོ་སྟེ་ཚིབ་ཕོར་གྱི་བུ་པཱ་ལག་གིས་ངའི་རྩར་བཏང་བའི་མི་རྣམས་ཡིན་ཏེ། ཁོ་རྣམས་ན་རེ།"]},{"type":"verse","number":11,"content":["ལྟོས་དང་། ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་པའི་མི་རིགས་ཤིག་གིས་ས་གཞི་ཡོངས་སུ་ཁེབས་འདུག ད་ལྟ་ཁྱོད་རང་ཡོང་ནས་ངའི་ཆེད་དུ་ཁོ་རྣམས་ལ་དམོད་མོ་འདེབས་རོགས། དེ་ནས་ངས་ཁོ་རྣམས་ལས་རྒྱལ་ཁ་བླངས་ཏེ་སྐྲོད་ནུས་ཀྱང་སྲིད་ཅེས་སྨྲས་བྱུང་ཞུས་པ་ལ།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་གིས་པེལ་ཨམ་ལ་འདི་སྐད་དུ། ཁྱོད་དེ་དག་དང་མཉམ་དུ་འགྲོ་མི་རུང་ལ། ཡང་མི་རིགས་དེ་ནི་བྱིན་རླབས་ཐོབ་པ་ཡིན་པས་དེ་ལ་དམོད་མོ་འདེབས་མི་རུང་ཞེས་གསུངས།"]},{"type":"verse","number":13,"content":["དེ་ནས་པེལ་ཨམ་ནངས་སྔ་མོ་ལངས་ནས་པཱ་ལག་གི་འགོ་དཔོན་རྣམས་ལ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་རང་ཁྱོད་ཅག་དང་མཉམ་དུ་འགྲོ་བར་མི་གནང་བས་ཁྱོད་རྣམས་ཕྱིར་རང་ཡུལ་དུ་སོང་ཞིག་ཅེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":14,"content":["མོ་ཨབ་ཀྱི་འགོ་དཔོན་རྣམས་ཡར་ལངས་ཏེ་ཕྱིར་པཱ་ལག་གི་རྩར་ཕྱིན་ནས་ཁོ་ལ། པེལ་ཨམ་ངེད་ཅག་དང་མཉམ་དུ་མི་ཡོང་ངོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":15,"content":["དེ་ནས་པཱ་ལག་གིས་ཡང་བསྐྱར་འགོ་དཔོན་སྔར་ལས་མང་པོ་དང་། དེ་ལས་སྙན་གྲགས་ཆེ་བ་རྣམས་བཏང་བ་དང་།"]},{"type":"verse","number":16,"content":["དེ་དག་པེལ་ཨམ་གྱི་དྲུང་དུ་ཕྱིན་ནས་ཁོ་ལ་འདི་ལྟར། ཚིབ་ཕོར་གྱི་བུ་པཱ་ལག་གིས་འདི་ལྟར་སྨྲས་ཏེ། ཁྱེད་རང་ངའི་རྩར་ཕེབས་པར་མི་གཡོལ་རོགས།"]},{"type":"verse","number":17,"content":["གང་ལ་ཞེ་ན། ངས་ཁྱེད་ལ་གུས་པ་ཆེན་པོ་འཐོབ་པར་བྱ་ཞིང་། ཁྱེད་ཀྱིས་ཅི་གསུངས་བཞིན་དུ་བསྒྲུབ་པར་བྱ། ཁྱེད་ཀྱིས་ངའི་ཆེད་དུ་མི་རིགས་འདི་ལ་དམོད་མོ་འདེབས་རོགས་ཞེས་ཞུ་བ་ཞུས་སོ། །"]},{"type":"verse","number":18,"content":["དེ་ནས་པེལ་ཨམ་གྱིས་པཱ་ལག་གི་འཁོར་གཡོག་རྣམས་ལ་ལན་དུ། པཱ་ལག་གིས་རང་གི་གསེར་དངུལ་ཁང་པ་གང་པོ་དེ་ང་ལ་གནང་ན་ཡང་། ངས་དོན་ཆེ་ཆུང་གང་ཡིན་ཡང་རང་གི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བརྒལ་ནས་བསྒྲུབ་མི་ནུས།"]},{"type":"verse","number":19,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་ད་དུང་ཅི་ཞིག་གསུང་བ་ཤེས་པའི་ཆེད་དུ། ཁྱོད་ཅག་དོ་ནུབ་ཀྱང་འདི་རུ་སྡོད་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":20,"content":["མཚན་མོ་དེར་དཀོན་མཆོག་པེལ་ཨམ་གྱི་རྩར་ཕེབས་ནས་འདི་སྐད་དུ། མི་འདི་རྣམས་ཁྱོད་འབོད་དུ་འོངས་པ་ཡིན་པས་ན། ཁྱོད་རང་ལམ་ལ་ཆས་ནས་དེ་དག་དང་མཉམ་དུ་སོང་ཞིག འོན་ཀྱང་ངས་ཁྱོད་ལ་ཅི་སྨྲས་པ་དེ་ཁོ་ན་སྒྲུབས་ཤིག་ཅེས་གསུངས་སོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གི་ཕོ་ཉ་དང་པེལ་ཨམ་གྱི་བོང་བུ།"]},{"type":"verse","number":21,"content":["པེལ་ཨམ་ནངས་སྔ་མོར་ལངས་ནས་རང་གི་བོང་བུ་ལ་སྒ་བསྟད་དེ། མོ་ཨབ་ཀྱི་འགོ་དཔོན་རྣམས་དང་མཉམ་དུ་སོང་ངོ་། །"]},{"type":"verse","number":22,"content":["ཁོ་རང་སོང་བའི་རྐྱེན་གྱིས་དཀོན་མཆོག་ཐུགས་ཁྲོས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལམ་ནང་དུ་འགྲེང་ནས་ཁོ་རང་བཀག་པ་དང་། དེའི་དུས་སུ་ཁོ་བོང་བུར་ཞོན་ཏེ་ཞབས་ཕྱི་གཉིས་ཀྱང་ཁོ་དང་མཉམ་དུ་བསྐྱོད་པའོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་བོང་བུས་ཕྱག་ཏུ་རལ་གྲི་ཐོགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལམ་ནང་དུ་འགྲེང་འདུག་པ་མཐོང་བས། ལམ་ལ་བཟུར་ནས་ཞིང་ནང་དུ་སོང་། པེལ་ཨམ་གྱིས་བོང་བུ་ལམ་ལ་བསྒྱུར་ཕྱིར་བརྡེགས་སོ། །"]},{"type":"verse","number":24,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་རྒུན་འབྲུམ་ར་བ་རྣམས་ཀྱི་བར་དུ་ཡོད་པའི་ལམ་དོག་མོའི་ནང་དུ་འགྲེང་པ་དང་། ལམ་གྱི་འགྲམ་གཉིས་ཀ་གྱང་ཡིན་ནོ། །"]},{"type":"verse","number":25,"content":["བོང་བུས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་མཐོང་བ་དང་གྱང་ལ་གཙུབས་ནས་པེལ་ཨམ་གྱི་རྐང་པ་བཙིར་བས་པེལ་ཨམ་གྱིས་ཡང་བོང་བུ་ལ་བརྡེགས་སོ། །"]},{"type":"verse","number":26,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ཡང་སྔོན་ལ་ཅུང་ཙམ་ཕེབས་ནས། འགག་དོག་མོ་གཡས་གཡོན་ལ་འཁོར་ས་མེད་པ་ཞིག་ཏུ་འགྲེང་བསྡད་པ་དང་།"]},{"type":"verse","number":27,"content":["བོང་བུས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་མཐོང་སྟེ་པེལ་ཨམ་གྱི་འོག་ཏུ་ཉལ་བ་དང་། པེལ་ཨམ་རབ་ཏུ་ཁྲོས་ནས་དབྱུག་པས་བོང་བུ་ལ་བརྡེགས་པ་ན།"]},{"type":"verse","number":28,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་བོང་བུ་ལ་ཁ་གྲགས་པར་མཛད་ཅིང་དེས་པེལ་ཨམ་ལ། ངས་ཁྱོད་ལ་ཅི་བྱས་པ་ཡིན་ནམ། ཁྱོད་ཀྱིས་ང་ལ་ལན་གསུམ་བརྡེགས་སོང་ཞེས་སྨྲས་པ་ན།"]},{"type":"verse","number":29,"content":["པེལ་ཨམ་གྱིས་བོང་བུ་ལ་ན་རེ། ཁྱོད་ཀྱིས་ང་རང་རྩེད་སྤྱད་བྱས་པས་ཡིན། ངའི་ལག་ཏུ་རལ་གྲི་ཞིག་ཡོད་པ་ཡིན་ན། ད་ལྟ་ཉིད་ལ་ཁྱོད་གསོད་དོ་ཞེས་སྨྲས།"]},{"type":"verse","number":30,"content":["དེ་ནས་བོང་བུས་པེལ་ཨམ་ལ། ང་ནི་ཁྱོད་ཆུང་དུས་ནས་དེ་རིང་བར་དུ་ཞོན་པའི་བོང་བུ་དེ་མ་ཡིན་ནམ། ངས་དུས་ནམ་ཞིག་ཁྱོད་ལ་འདི་ལྟར་བྱས་མྱོང་ངམ་ཞེས་སྨྲས་པ་ན། པེལ་ཨམ་གྱིས་བྱས་མ་མྱོང་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":31,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་པེལ་ཨམ་གྱི་མིག་ཕྱེས་པ་ན། ཁོས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལམ་ནང་དུ་འགྲེང་འདུག་པ་དང་། ཕྱག་ཏུ་རལ་གྲི་ཤུབས་ནས་ཐོན་པ་ཞིག་ཡོད་པ་མཐོང་ནས། མགོ་བོ་སྨད་དུ་བསྒུར་ནས་ཕྱག་བཙལ་ཏོ། །"]},{"type":"verse","number":32,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་ཁོ་ལ། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་རང་གི་བོང་བུ་ལ་ཐེངས་གསུམ་བརྡེགས་པ་ཡིན་ནམ། ལྟོས་དང་། ཁྱོད་ཀྱི་ལམ་ནི་ངའི་མདུན་དུ་ཕྱིན་ཅི་ལོག་པའི་ལམ་ཡིན་པས་ང་རང་ཁྱོད་འགོག་ཏུ་འོངས་པ་ཡིན།"]},{"type":"verse","number":33,"content":["བོང་བུས་ང་མཐོང་ནས་ཐེངས་གསུམ་ལ་བཟུར་བ་དང་། གལ་སྲིད་བོང་བུ་ངའི་མདུན་ནས་ཏན་ཏན་མ་བཟུར་པ་ཡིན་ན། ངས་སྔ་མོ་ནས་ཁྱོད་བསད་ཅིང་། བོང་བུ་སྲོག་ཐར་དུ་བཏང་བ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":34,"content":["དེ་ནས་པེལ་ཨམ་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་ལ་འདི་ལྟར། ངས་སྡིག་པ་བྱས་ཟིན། ངས་ཁྱེད་རང་ལམ་ནང་དུ་འགྲེང་ནས་ང་འགོག་པ་མ་ཤེས། ད་ལྟ་ང་རང་འགྲོ་བར་ཁྱེད་མི་མཉེས་ན་ང་ཕྱིར་ལོག་འགྲོ་ཞེས་ཞུས།"]},{"type":"verse","number":35,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉས་པེལ་ཨམ་ལ། ཁྱོད་མི་འདི་དག་དང་མཉམ་དུ་སོང་ཞིག འོན་ཀྱང་ངས་ཁྱོད་ལ་སྨྲས་པའི་གཏམ་འབའ་ཞིག་ལས་གཞན་ཅི་ཡང་སྨྲ་བར་མི་བྱའོ་ཞེས་གསུངས་པས། པེལ་ཨམ་ནི་པཱ་ལག་གི་འགོ་དཔོན་རྣམས་དང་མཉམ་དུ་སོང་ངོ་། །"]},{"type":"verse","number":36,"content":["པཱ་ལག་གིས་པེལ་ཨམ་ཡོང་བཞིན་པ་ཐོས་ནས་མོ་ཨབ་ཀྱི་གྲོང་ཁྱེར་དུ་བསུ་བར་སོང་སྟེ། གྲོང་ཁྱེར་དེ་ནི་ཨར་ནོན་ཆུ་བོའི་འགྲམ་དུ་ས་མཚམས་ཀྱི་མཐའ་རུ་ཡོད་པའོ། །"]},{"type":"verse","number":37,"content":["པཱ་ལག་གིས་པེལ་ཨམ་ལ། ངས་བྲེལ་མྱུར་ངང་ཁྱེད་ཀྱི་རྩར་མི་བཏང་ནས་ཁྱེད་རང་གདན་དྲངས་པ་མ་ཡིན་ནམ། ཁྱེད་རང་ངའི་རྩར་མ་ཡོང་བ་ཅི་ཡིན་ནམ། ངས་ཁྱེད་ལ་གུས་བརྩི་ཆེན་པོ་འཐོབ་པར་བྱེད་མི་ནུས་སམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":38,"content":["པེལ་ཨམ་གྱིས་པཱ་ལག་ལ། ལྟོས་དང་། ང་ཁྱོད་ཀྱི་རྩར་སླེབས་ཡོད་པས་ད་ལྟ་ང་ལ་ཅི་ཞིག་སྨྲ་བའི་དབང་ཡོད་དམ། དཀོན་མཆོག་གིས་ངའི་ཁ་ལ་བཀའ་ཅི་ཞིག་གནང་ན་ངས་བཀའ་དེ་སྨྲ་བར་བྱའོ་ཞེས་སྨྲས།"]},{"type":"verse","number":39,"content":["དེ་ནས་པེལ་ཨམ་ནི་པཱ་ལག་དང་མཉམ་དུ་སོང་བ་དང་། ཁོ་གཉིས་ཀིར་ཡཱད་ཧུ་ཚོད་བྱ་བར་སླེབས།"]},{"type":"verse","number":40,"content":["པཱ་ལག་གིས་བ་གླང་དང་ལུག་རྣམས་མཆོད་པར་ཕུལ་བ་དང་། པེལ་ཨམ་དང་ཁོ་དང་མཉམ་དུ་ཡོད་པའི་འགོ་དཔོན་རྣམས་ལ་དེའི་ཤ་ཡང་ཕུལ་ཏོ། །"]},{"type":"verse","number":41,"content":["ཕྱི་ཉིན་ཞོགས་པར་པཱ་ལག་གིས་པེལ་ཨམ་ཁྲིད་ནས་ཡར་པཱ་ཨལ་གྱི་མཐོ་གླིང་དུ་ཕྱིན་ཅིང་། པེལ་ཨམ་གྱིས་དེ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ཀྱི་ཟུར་ཞིག་མཐོང་ངོ་། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/21.json","previousChapterAudioLinks":{},"numberOfVerses":41}