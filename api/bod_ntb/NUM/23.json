{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":23,"content":[{"type":"heading","content":["པེལ་ཨམ་གྱི་ལུང་བསྟན་ཐོག་མ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་པེལ་ཨམ་གྱིས་པཱ་ལག་ལ། ཁྱོད་ཀྱིས་འདི་རུ་ང་ལ་མཆོད་ཁྲི་བདུན་བཟོས་ཤིག བ་གླང་བདུན་དང་ལུག་ཐུག་བདུན་ཡང་ང་ལ་གྲ་སྒྲིག་བྱོས་ཤིག་ཅེས་སྨྲས།"]},{"type":"verse","number":2,"content":["པཱ་ལག་གིས་པེལ་ཨམ་གྱིས་བསྒོས་པ་བཞིན་དུ་བྱས་ཤིང་། པཱ་ལག་དང་པེལ་ཨམ་གཉིས་ཀྱིས་མཆོད་ཁྲི་རེ་རེའི་སྟེང་དུ་བ་གླང་རེ་དང་ལུག་ཐུག་རེ་མཆོད་པར་ཕུལ།"]},{"type":"verse","number":3,"content":["པེལ་ཨམ་གྱིས་པཱ་ལག་ལ། ཁྱོད་ནི་རང་གི་སྦྱིན་སྲེག་གི་འགྲམ་དུ་སྡོད་ཅིག ང་མདུན་ལ་འགྲོའོ། །དཀོན་མཆོག་ཡ་ཝཱེ་ང་དང་འཕྲད་དུ་ཕེབས་ཡོང་ཡང་སྲིད། ཁོང་གིས་ང་ལ་གང་ཞིག་སྟོན་པར་མཛད་ན་ངས་དེ་ཁྱོད་ལ་སྨྲ་ངེས་ཡིན་ཞེས་སྨྲས་པ་དང་། ཁོ་མཐོ་སྒང་ཞིག་ལ་ཆས་སོ། །"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་པེལ་ཨམ་ལ་ཕྲད་པ་དང་། ཁོས་དཀོན་མཆོག་ལ་འདི་ལྟར། ངས་མཆོད་ཁྲི་བདུན་གྲ་སྒྲིག་བྱས་ཤིང་མཆོད་ཁྲི་རེའི་སྟེང་དུ་བ་གླང་གཅིག་དང་ལུག་ཐུག་གཅིག་རེ་མཆོད་པར་ཕུལ་ཡོད་ཅེས་ཞུས་པ་ན།"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་པེལ་ཨམ་གྱི་ཁ་ལ་བཀའ་གནང་ཞིང་ཡང་འདི་སྐད་དུ། ཁྱོད་པཱ་ལག་གི་རྩར་ཕྱིར་ལོག་ལ་འདི་ལྟར་སྨྲོས་ཤིག་ཅེས་གསུངས་པས།"]},{"type":"verse","number":6,"content":["ཁོ་པཱ་ལག་གི་རྩར་ལོག་པ་ན། ལྟོས་དང་། པཱ་ལག་དང་མོ་ཨབ་ཀྱི་འགོ་དཔོན་ཐམས་ཅད་སྦྱིན་སྲེག་གི་རྩར་འགྲེང་ནས་བསྡད་ཡོད་དོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་པེལ་ཨམ་གྱིས་ཁོ་རང་གི་ལུང་བསྟན་དབྱངས་ལ་གྱེར་ཏེ་འདི་ལྟར།",{"text":"པཱ་ལག་གིས་ནི་ང་རང་ཨ་རམ་ཡུལ་ནས་ཁྲིད། །","poem":1},{"lineBreak":true},{"text":"མོ་ཨབ་རྒྱལ་པོས་ང་རང་ཤར་ཕྱོགས་རི་ནས་ཁྲིད།","poem":1},{"lineBreak":true},{"text":"ཤོག་དང་ང་ཡི་ཆེད་དུ་ཡ་ཀོབ་ལ་དམོད་ཅིག །","poem":1},{"lineBreak":true},{"text":"ཤོག་དང་ཡེས་ར་ཨེལ་ལ་སྐྱོན་རྗོད་ཅེས་སྨྲས་སོ། །","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་ཉིད་ཀྱིས་མ་དམད་པ་དེ་ལ། །","poem":1},{"lineBreak":true},{"text":"ང་ཡིས་དམོད་པ་ཅི་ལྟར་གཏོང་ནུས་སམ། །","poem":1},{"lineBreak":true},{"text":"ཡ་ཝཱེས་དགག་པ་མ་བརྒྱབ་པ་དེ་ལ། །","poem":1},{"lineBreak":true},{"text":"ང་ཡིས་དགག་པ་ཅི་ལྟར་རྒྱག་ནུས་སམ། །","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"བདག་གིས་བྲག་གི་རྩེ་མོ་དག་ནས་ཁོ་རྣམས་མཐོང་། །","poem":1},{"lineBreak":true},{"text":"རི་བོའི་རྩེ་མོ་དག་ནས་ང་ཡིས་ཁོ་ཚོར་བལྟས། །","poem":1},{"lineBreak":true},{"text":"ཀྱེ་ཧོ་དེ་ནི་མི་རིགས་ཁེར་འདུག་ཅིག་ཡིན་ཞིང་། །","poem":1},{"lineBreak":true},{"text":"མི་རིགས་གཞན་པའི་ནང་དུ་རང་ཉིད་བགྲང་མི་འདུག །","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ཡ་ཀོབ་ཁོང་གི་རྡུལ་ཕྲན་སུ་ཡིས་རྩི་ནུས་སམ།","poem":1},{"lineBreak":true},{"text":"ཡེས་ར་ཨེལ་པའི་བཞི་ཆའི་གཅིག་ཀྱང་སུས་བགྲང་ནུས། །","poem":1},{"lineBreak":true},{"text":"ང་རང་དྲང་པོའི་འཆི་ལུགས་བཞིན་དུ་འཆི་བ་དང་། །","poem":1},{"lineBreak":true},{"text":"ང་ཡི་ཚེ་མཇུག་དེ་རྣམས་བཞིན་དུ་འགྱུར་བར་ཤོག །ཅེས་སྨྲས་སོ། །","poem":1}]},{"type":"verse","number":11,"content":["པཱ་ལག་གིས་པེལ་ཨམ་ལ་འདི་ལྟར། ཁྱེད་ཀྱིས་ང་ལ་ཅི་བྱས་སམ། ངའི་དགྲ་བོ་རྣམས་ལ་དམོད་མོ་འདེབས་པའི་ཆེད་དུ་ཁྱེད་ཁྲིད་འོངས་པ་ཡིན། ལྟོས་དང་། ཁྱེད་ཀྱིས་ཁོ་རྣམས་ལ་བྱིན་གྱིས་བརླབས་སོ་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":12,"content":["པེལ་ཨམ་གྱིས་དེའི་ལན་དུ། དཀོན་མཆོག་ཡ་ཝཱེས་ངའི་ཁ་རུ་གནང་བ་དེ་ངས་གཟབ་གཟབ་བྱས་ནས་སྨྲ་མི་དགོས་སམ་ཞེས་སྨྲས་སོ། །"]},{"type":"heading","content":["པེལ་ཨམ་གྱི་ལུང་བསྟན་གཉིས་པ།"]},{"type":"verse","number":13,"content":["པཱ་ལག་གིས་པེལ་ཨམ་ལ་ན་རེ། ཁྱེད་རང་ང་དང་མཉམ་དུ་གནས་གཞན་ཞིག་ཏུ་ཕེབས་རོགས། དེ་རུ་ཁྱེད་ཀྱིས་ཁོ་རྣམས་མཐོང་བར་འགྱུར། དེ་དག་ཐམས་ཅད་མཐོང་མི་ནུས་ལ། དེ་དག་གི་མཐའ་མཚམས་ཀྱི་ཁག་ཅིག་མཐོང་བར་འགྱུར། དེ་ནས་ངའི་ཆེད་དུ་ཁྱེད་ཀྱིས་ཁོ་རྣམས་ལ་དམོད་མོ་ཐོངས་ཤིག་ཅེས་ཞུས་པ་དང་།"]},{"type":"verse","number":14,"content":["པཱ་ལག་གིས་པེལ་ཨམ་ཁྲིད་ནས་ཚི་པེམ་བྱ་བའི་ཞིང་ལ་སླེབས་ཤིང་། ཡར་ཕིས་གའི་རི་རྩེར་ཁྲིད་པ་དང་དེར་མཆོད་ཁྲི་བདུན་བརྩིགས། མཆོད་ཁྲི་རེའི་སྟེང་དུ་བ་གླང་གཅིག་དང་ལུག་ཐུག་གཅིག་རེ་ཕུལ་ཏོ། །"]},{"type":"verse","number":15,"content":["པེལ་ཨམ་གྱིས་པཱ་ལག་ལ། ང་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཇལ་དུ་འགྲོ་སྟེ། ཁྱོད་ནི་འདིར་རང་གི་སྦྱིན་སྲེག་གི་རྩར་འགྲེང་ནས་སྡོད་ཅིག་ཅེས་སྨྲས་པ་དང་།"]},{"type":"verse","number":16,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་པེལ་ཨམ་དང་ཕྲད་དེ། ཁོང་གིས་དེའི་ཁ་ལ་བཀའ་གནང་ཞིང་འདི་སྐད་དུ། ཁྱོད་པཱ་ལག་གི་རྩར་ཕྱིར་ལོག་ལ་འདི་ལྟར་སྨྲོས་ཤིག་ཅེས་གསུངས།"]},{"type":"verse","number":17,"content":["དེ་ནས་པེལ་ཨམ་ནི་པཱ་ལག་གི་རྩར་ཕྱིར་ལོག་པ་ན། ལྟོས་དང་། པཱ་ལག་ནི་རང་གི་སྦྱིན་སྲེག་གི་རྩར་འགྲེང་ནས་བསྡད་ཡོད་པ་དང་། མོ་ཨབ་ཀྱི་འགོ་དཔོན་རྣམས་ཀྱང་ཁོ་དང་མཉམ་དུ་ཡོད་པའོ། །པཱ་ལག་གིས་པེལ་ཨམ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཅི་གསུངས་བྱུང་ཞེས་དྲིས་པ་ན།"]},{"type":"verse","number":18,"content":["པེལ་ཨམ་གྱིས་ལུང་བསྟན་དབྱངས་ལ་གྱེར་ཏེ་འདི་ལྟར།",{"text":"ཀྱེ་ཀྱེ་པཱ་ལག་ལོངས་ལ་མཉན་པར་གྱིས། །","poem":1},{"lineBreak":true},{"text":"ཚིབ་ཕོར་བུ་ཡིས་རྣ་བ་བདག་ལ་གཏོད། །","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་རྫུན་གཏམ་སྨྲ་བའི་མི་མ་ཡིན། །","poem":1},{"lineBreak":true},{"text":"མིའི་བུ་ནང་བཞིན་ཁོང་ནི་ཐུགས་མི་འགྱོད། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་བཀའ་གསུང་གནང་སྟེ་མི་མཛད་དམ། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་ཞལ་བཞེས་གནང་བ་མི་འགྲུབ་བམ། །","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ལྟོས་དང་བྱིན་རླབས་གནང་བའི་བཀའ་ནི་བདག་ལ་གསུངས། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་བྱིན་གྱིས་བརླབས་པ་བདག་གིས་བསྒྱུར་མི་ནུས། །","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ཡ་ཀོབ་ལས་ནི་སྡིག་ཉེས་མཐོང་བ་མེད། །","poem":1},{"lineBreak":true},{"text":"ཡེས་ར་ཨེལ་ནང་སྤྱོད་ངན་མཐོང་བ་མེད། །","poem":1},{"lineBreak":true},{"text":"ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་མཆོག །","poem":1},{"lineBreak":true},{"text":"ཁོ་རྣམས་མཉམ་དུ་བཞུགས་ཤིང་དེ་དག་ཁྲོད། །","poem":1},{"lineBreak":true},{"text":"རྒྱལ་པོའི་དགའ་མགུ་རངས་པའི་སྐད་ཅོར་འདུག །","poem":1},{"noteId":8}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ཨེ་ཅིབ་ཡུལ་ནས་ཁྲིད་མཁན་དཀོན་མཆོག་ནི། །","poem":1},{"lineBreak":true},{"text":"ཁོ་ཚོར་གླང་རྒོད་ཅིག་གི་རྭ་དང་མཚུངས། །","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ཡ་ཀོབ་ཕྱོགས་སུ་ངན་སྔགས་འདེབས་པ་མེད། །","poem":1},{"lineBreak":true},{"text":"ཡེས་ར་ཨེལ་གྱི་ཕྱོགས་སུ་མོ་པ་མེད། །","poem":1},{"lineBreak":true},{"text":"འོས་ཤིང་འཚམ་པའི་དུས་སུ་སླེབས་པའི་ཚེ། །","poem":1},{"lineBreak":true},{"text":"ཡ་ཀོབ་དང་ནི་ཡེས་ར་ཨེལ་ལ་ནི། །","poem":1},{"lineBreak":true},{"text":"དཀོན་མཆོག་ཁོང་གིས་དོན་ཆེན་མཛད་ཅེས་བརྗོད། །","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ཀྱེ་ཧོ་མི་རིགས་དེ་ནི་མོ་སེང་བཞིན། །","poem":1},{"lineBreak":true},{"text":"འགྱིང་ཞིང་སེང་གེ་ཇི་བཞིན་འགྲེང་ནས་ཡོང་། །","poem":1},{"lineBreak":true},{"text":"བརྔོན་བྱའི་རི་དྭགས་ཁྱུར་མིད་གཏོང་བ་དང་། །","poem":1},{"lineBreak":true},{"text":"བསད་པ་དེའི་ཁྲག་འཐུང་བའི་བར་དུ་ནི། །","poem":1},{"lineBreak":true},{"text":"མར་ལ་ཉལ་བ་གཏན་ནས་དཔེ་མི་སྲིད། །ཅེས་སྨྲས་སོ། །","poem":1}]},{"type":"verse","number":25,"content":["དེ་ནས་པཱ་ལག་གིས་པེལ་ཨམ་ལ། ཁྱེད་ཀྱིས་ཁོ་རྣམས་ལ་དམོད་མོ་ཅི་ཡང་མ་འདེབས། བྱིན་རླབས་ཀྱང་ཅི་ཡང་མ་གནང་ཞེས་སྨྲས་པ་ལ།"]},{"type":"verse","number":26,"content":["པེལ་ཨམ་གྱིས་དེའི་ལན་དུ་པཱ་ལག་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་ཅི་གསུངས་པ་ཐམས་ཅད་ངས་ངེས་པར་དེ་བཞིན་བསྒྲུབ་དགོས་ཞེས་ཁྱོད་ལ་སྨྲས་པ་མ་ཡིན་ནམ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":27,"content":["དེ་ནས་པཱ་ལག་གིས་པེལ་ཨམ་ལ། ཕེབས་དང་། ངས་ཁྱེད་རང་ས་ཆ་གཞན་ཞིག་ལ་འཁྲིད་པར་བྱ་སྟེ། དཀོན་མཆོག་ཁྱེད་ལ་ཐུགས་མཉེས་ཀྱང་སྲིད་ལ། ཁྱེད་ཀྱིས་ས་དེ་ནས་ངའི་ཆེད་དུ་ཁོ་རྣམས་ལ་དམོད་མོ་བཏབ་ཆོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":28,"content":["དེ་ནས་པཱ་ལག་གིས་པེལ་ཨམ་དབེན་སྟོང་ལ་ཁ་ཐུར་ལྟའི་ཕེ་ཨོར་རི་རྩེར་ཁྲིད་དོ། །"]},{"type":"verse","number":29,"content":["པེལ་ཨམ་གྱིས་པཱ་ལག་ལ། ཁྱོད་ཀྱིས་འདི་ནས་ང་ལ་མཆོད་ཁྲི་བདུན་རྩིགས་ཤིག བ་གླང་བདུན་དང་ལུག་ཐུག་བདུན་ཡང་ང་ལ་གྲ་སྒྲིག་བྱོས་ཤིག་ཅེས་སྨྲས་པ་ན།"]},{"type":"verse","number":30,"content":["པཱ་ལག་གིས་པེལ་ཨམ་གྱིས་སྨྲས་པ་བཞིན་དུ་བསྒྲུབས་པ་དང་། མཆོད་ཁྲི་རེའི་སྟེང་དུ་བ་གླང་གཅིག་དང་ལུག་ཐུག་གཅིག་རེ་མཆོད་པར་ཕུལ་ཏོ། །"]}],"footnotes":[{"noteId":8,"caller":"+","text":"འདིར་རྒྱལ་པོ་ཞེས་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེར་གོ་ཞིང་། ཨེ་ཅིབ་ནས་ཐོན་པའི་མདོ་ཡི་ལེའུ་བཅོ་ལྔའི་ཚིག་རྐང་བརྒྱད་པ་ལའང་དེ་བཞིན་གསུངས་ཡོད།","reference":{"chapter":23,"verse":21}}]},"thisChapterLink":"/api/bod_ntb/NUM/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/22.json","previousChapterAudioLinks":{},"numberOfVerses":30}