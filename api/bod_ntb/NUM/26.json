{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":26,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་གྲངས་ལེན་ཐེངས་གཉིས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་གཉན་ནད་བྱུང་བའི་རྗེས་སུ་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་དང་མཆོད་དཔོན་ཨ་རོན་གྱི་བུ་ཨེ་ལི་ཨ་ཟར་གཉིས་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ལས་ལོ་ཉི་ཤུ་ཅན་དང་དེའི་ཡན་གྱི་འཐབ་མོར་ཞུགས་ཐུབ་པ་རྣམས་ནི་དེ་དག་གི་ཕ་ཁྱིམ་བཞིན་དུ་རྩིས་ལེན་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་མོ་ཤེ་དང་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་གཉིས་ཀྱིས་མོ་ཨབ་སྤང་ལྗོངས་ཏེ། ཡེ་རུ་ཀོའི་ཁ་གཏད་དུ་ཡོར་དན་གཙང་པོའི་འགྲམ་ནས་དེ་དག་ལ་འདི་ལྟར།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་བཀའ་གནང་བ་བཞིན་དུ་ལོ་ཉི་ཤུ་ཅན་དང་དེའི་ཡན་གྱི་མི་རྣམས་རྩིས་ལེན་དགོས་ཞེས་སྨྲས་སོ། ། ཨེ་ཅིབ་ཡུལ་ནས་འོངས་པའི་ཡེས་ར་ཨེལ་པ་རྣམས་ནི་འདི་ལྟ་སྟེ།"]},{"type":"verse","number":5,"content":["ཡེས་ར་ཨེལ་གྱི་བུ་སྐྱེས་འགོ་རུ་བེན་དང་། རུ་བེན་གྱི་བུ་རྒྱུད་རྣམས་ནི་ཧ་ནོག་ལ་གཏོགས་པ་ཧ་ནོག་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཕཱ༌ལུའུ་ལ་གཏོགས་པ་ཕཱ་ལུའུ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད།"]},{"type":"verse","number":6,"content":["ཧེས་རོན་ལ་གཏོགས་པ་ཧེས་རོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཀར་མའེ་ལ་གཏོགས་པ་ཀར་མའེ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":7,"content":["འདི་དག་ནི་རུ་བེན་གྱི་ཁྱིམ་རྒྱུད་ཡིན་པ་དང་། དེ་དག་ནས་རྩིས་བླངས་པ་ནི་བསྡོམས་པས་བཞི་ཁྲི་སུམ་སྟོང་བདུན་བརྒྱ་སུམ་ཅུའོ། །"]},{"type":"verse","number":8,"content":["ཕཱ༌ལུའུ་ཡི་བུ་ནི་ཨེ་ལི་ཨབ་ཡིན་ལ།"]},{"type":"verse","number":9,"content":["ཨེ་ལི་ཨབ་ཀྱི་བུ་རྣམས་ནི་ནེ་མུ་ཨེལ་དང་། དཱ་ཐན་དང་། ཨ་བི་རཱམ་བཅས་ཡིན། དཱ་ཐན་དང་ཨ་བི་རཱམ་ནི་མ་གཞི་མི་ཚོགས་ཁྲོད་ནས་བདམས་པ་དང་། དེ་གཉིས་དང་ཀོ་རཱག་ཕྱོགས་ཁག་གི་མི་རྣམས་ཀྱིས་ཁ་མཐུན་ནས་མཉམ་དུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ངོ་རྒོལ་བྱས་ཤིང་། མོ་ཤེ་དང་ཨ་རོན་གཉིས་ལའང་ངོ་རྒོལ་བྱས་པའི་དུས་སུ།"]},{"type":"verse","number":10,"content":["ས་གཞིས་ཁ་གདངས་ནས་དེ་དག་དང་ཀོ་རཱག་མཉམ་དུ་ཁྱུར་མིད་བཏང་བ་དང་། ཀོ་རཱག་དང་ཁོའི་ཆོས་ཚོགས་ཀྱི་མི་ཐམས་ཅད་ཤི་བར་གྱུར། མེ་ཡིས་མི་ཉིས་བརྒྱ་དང་ལྔ་བཅུ་འགེམས་པའི་དུས་དེ་ནི་ཕྱི་འདོམས་ཀྱི་མེ་ལོང་དུ་གྱུར་ཏོ། །"]},{"type":"verse","number":11,"content":["འོན་ཀྱང་ཀོ་རཱག་གི་བུ་རྒྱུད་རྣམས་འཆི་བར་མ་གྱུར་ཏོ། །"]},{"type":"verse","number":12,"content":["སི་མུ་ཨོན་གྱི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། ནེ་མུ་ཨེལ་ལ་གཏོགས་པ་ནེ་མུ་ཨེལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཡཱ་མེན་ལ་གཏོགས་པ་ཡཱ་མེན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཡཱ་ཀིན་ལ་གཏོགས་པ་ཡཱ་ཀིན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":13,"content":["ཟེ༌རག་ལ་གཏོགས་པ་ཟེ༌རག་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཤཱ་ཨུལ་ལ་གཏོགས་པ་ཤཱ་ཨུལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":14,"content":["འདི་དག་ནི་སི་མུ་ཨོན་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ་བསྡོམས་པས་ཉིས་ཁྲི་ཉིས་སྟོང་ཉིས་བརྒྱའོ། །"]},{"type":"verse","number":15,"content":["གཱ་རྡུའི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། ཚཱ་ཕོན་ལ་གཏོགས་པ་ཚཱ་ཕོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧ་གིད་ལ་གཏོགས་པ་ཧ་གིད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཤུ་ནེ་ལ་གཏོགས་པ་ཤུ་ནེ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":16,"content":["ཨོ་ཟི་ནེ་ལ་གཏོགས་པ་ཨོ་ཟི་ནེ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཨེ་རི་ལ་གཏོགས་པ་ཨེ་རི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":17,"content":["ཨ་རོད་ལ་གཏོགས་པ་ཨ་རོད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཨར་ཨེ་ལི་ལ་གཏོགས་པ་ཨར་ཨེ་ལི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":18,"content":["འདི་དག་ནི་གཱ་རྡུ་ཡི་བུ་རྒྱུད་ཀྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་བཞི་ཁྲི་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":19,"content":["ཡ་ཧུ་དཱའི་བུ་ནི་ཨེར་དང་ཨོ་ནན་གཉིས་ཡིན། ཨེར་དང་ཨོ་ནན་གཉིས་པོ་ཀ་ན་ཨན་ཡུལ་དུ་ཤི་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":20,"content":["ཡ་ཧུ་དཱའི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། ཤེ་ལཱ་ལ་གཏོགས་པ་ཤེ་ལཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཕེ་རེལ་ཟི་ལ་གཏོགས་པ་ཕེ་རེལ་ཟི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཟེ་རག་ལ་གཏོགས་པ་ཟེ་རག་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":21,"content":["ཕེ་རེལ་ཟི་ཡི་བུ་རྒྱུད་རྣམས་ལས་ཧེས་རོན་ལ་གཏོགས་པ་ཧེས་རོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧ་མུལ་ལ་གཏོགས་པ་ཧ་མུལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་ཡིན།"]},{"type":"verse","number":22,"content":["འདི་དག་ནི་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་བདུན་ཁྲི་དྲུག་སྟོང་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":23,"content":["ཡེས་སི་ཀཱར་གྱི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། ཐོ་ལཱ་ལ་གཏོགས་པ་ཐོ་ལཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཕུ་བཱ་ལ་གཏོགས་པ་ཕུ་བཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":24,"content":["ཡ་ཤུབ་ལ་གཏོགས་པ་ཡ་ཤུབ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཤིམ་རོན་ལ་གཏོགས་པ་ཤིམ་རོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":25,"content":["འདི་དག་ནི་ཡེས་སི་ཀཱར་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་དྲུག་ཁྲི་བཞི་སྟོང་སུམ་བརྒྱའོ། །"]},{"type":"verse","number":26,"content":["ཟེ་བུ་ལུན་གྱི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། སེ་རཱད་ལ་གཏོགས་པ་སེ་རཱད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཨེད་ལོན་ལ་གཏོགས་པ་ཨེད་ལོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཡ་ལཱ་ཨལ་ལ་གཏོགས་པ་ཡ་ལཱ་ཨལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":27,"content":["འདི་དག་ནི་ཟེ་བུ་ལུན་གྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་དྲུག་ཁྲི་ལྔ་བརྒྱའོ། །"]},{"type":"verse","number":28,"content":["ཡོ་སེབ་ཀྱི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་མཱ་ན་ཤེ་དང་ཨེ་ཕཱར་ཡིམ་ཡིན་ནོ། །"]},{"type":"verse","number":29,"content":["མཱ་ན་ཤེའི་བུ་རྒྱུད་རྣམས་ནི་མཱ་ཀིར་ལ་གཏོགས་པ་མཱ་ཀིར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། མཱ་ཀིར་ནས་གིལ་ཨད་སྐྱེས་པ་དང་། གིལ་ཨད་ལ་གཏོགས་པ་གིལ་ཨད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་ཡིན་ནོ། །"]},{"type":"verse","number":30,"content":["གིལ་ཨད་ཀྱི་བུ་རྒྱུད་རྣམས་ནི་འདི་ལྟ་སྟེ། ཨི་ཨེ་ཟིར་ལ་གཏོགས་པ་ཨི་ཨེ་ཟིར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧེ་ལེག་ལ་གཏོགས་པ་ཧེ་ལེག་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":31,"content":["ཨ་སི་རི་ཨེལ་ལ་གཏོགས་པ་ཨ་སི་རི་ཨེལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཤེ་ཀེམ་ལ་གཏོགས་པ་ཤེ་ཀེམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":32,"content":["ཤེ་མི་ད་ལ་གཏོགས་པ་ཤེ་མི་ད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧེ་ཕེར་ལ་གཏོགས་པ་ཧེ་ཕེར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":33,"content":["ཧེ་ཕེར་གྱི་བུ་ཚེ་ལོ་ཕེ་ཧད་ལ་བུ་མེད་ཅིང་བུ་མོ་འབའ་ཞིག་ཡོད་དེ། ཚེ་ལོ་ཕེ་ཧད་ཀྱི་བུ་མོ་རྣམས་ཀྱི་མིང་ནི། མ་ལཱ་དང་། ནོ་ཨ་དང་། ཧོག་ལཱ་དང་། མིལ་ཀཱ་དང་། ཐིར་ཚ་བཅས་ཡིན།"]},{"type":"verse","number":34,"content":["འདི་དག་ནི་མཱ་ན་ཤེའི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་གྲངས་ཀ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་ལྔ་ཁྲི་ཉིས་སྟོང་དང་བདུན་བརྒྱའོ། །"]},{"type":"verse","number":35,"content":["ཨེ་ཕཱར་ཡིམ་གྱི་བུ་རྒྱུད་རྣམས་ནི་འདི་ལྟ་སྟེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཤུ་ཏེ་ལཱ་ལ་གཏོགས་པ་ཤུ་ཏེ་ལཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། པེ་ཀེར་ལ་གཏོགས་པ་པེ་ཀེར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཐ་ཧན་ལ་གཏོགས་པ་ཐ་ཧན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":36,"content":["ཤུ་ཏེ་ལཱ་ཡི་བུ་རྒྱུད་དེ་ཨེ་རན་ལ་གཏོགས་པ་ཨེ་རན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་ཡིན།"]},{"type":"verse","number":37,"content":["འདི་དག་ནི་ཨེ་ཕཱར་ཡིམ་གྱི་བུ་རྒྱུད་ཀྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་སུམ་ཁྲི་ཉིས་སྟོང་ལྔ་བརྒྱའོ། །རང་རང་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་འདི་དག་ནི་ཡོ་སེབ་ཀྱི་བུ་རྒྱུད་རྣམས་ཡིན་ནོ། །"]},{"type":"verse","number":38,"content":["པེན་ཡཱ་མེན་གྱི་བུ་རྒྱུད་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། པེ་ལཱ་ལ་གཏོགས་པ་པེ་ལཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཨ་ཤ༌བེལ་ལ་གཏོགས་པ་ཨ་ཤ༌བེལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཨ་ཧི་རམ་ལ་གཏོགས་པ་ཨ་ཧི་རམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":39,"content":["ཤེ་ཕུ་ཕམ་ལ་གཏོགས་པ་ཤེ་ཕུ་ཕམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧུ་ཕམ་ལ་གཏོགས་པ་ཧུ་ཕམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":40,"content":["པེ་ལཱའི་བུ་རྣམས་ནི་ཨར་དཱ་དང་ནཱ་ཨ་མཱན་ཡིན་ལ། ཨར་དཱ་ལ་གཏོགས་པ་ཨར་དཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ནཱ་ཨ་མཱན་ལ་གཏོགས་པ་ནཱ་ཨ་མཱན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":41,"content":["འདི་དག་ནི་པེན་ཡཱ་མེན་གྱི་བུ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་བཞི་ཁྲི་ལྔ་སྟོང་དྲུག་བརྒྱའོ། །"]},{"type":"verse","number":42,"content":["དཱན་གྱི་བུ་རྒྱུད་རྣམས་ནི་འདི་ལྟ་སྟེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཤུ་ཧམ་ལ་གཏོགས་པ་ཤུ་ཧམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་ཡིན། དེ་ནི་དཱན་གྱི་ཁྱིམ་རྒྱུད་དེ་རང་རང་གི་ཁྱིམ་རྒྱུད་བཞིན་དུའོ། །"]},{"type":"verse","number":43,"content":["ཤུ་ཧམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་ནས་རྩིས་བླངས་པའི་བསྡོམས་གྲངས་ནི་དྲུག་ཁྲི་བཞི་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":44,"content":["ཨ་ཤེར་གྱི་བུ་རྒྱུད་རྣམས་ནི་འདི་ལྟ་སྟེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་ཡིམ་ནཱ་ལ་གཏོགས་པ་ཡིམ་ནཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཡེས་བི་ལ་གཏོགས་པ་ཡེས་བི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། པེ་རེ་ཡཱ་ལ་གཏོགས་པ་པེ་རེ་ཡཱ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":45,"content":["པེ་རེ་ཡཱའི་བུ་རྒྱུད་རྣམས་ནི་ཧེ་བེར་ལ་གཏོགས་པ་ཧེ་བེར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། མཱལ་ཀི་ཨེལ་ལ་གཏོགས་པ་མཱལ་ཀི་ཨེལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":46,"content":["ཨ་ཤེར་གྱི་བུ་མོའི་མིང་ལ་སེ་རཱ་ཞེས་བྱའོ། །"]},{"type":"verse","number":47,"content":["འདི་དག་ནི་ཨ་ཤེར་གྱི་བུ་རྒྱུད་ཀྱི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་ཏེ། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་ཡིན་ལ། བསྡོམས་པས་ལྔ་ཁྲི་སུམ་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":48,"content":["ནཱབ་ཐ་ལིའི་བུ་རྒྱུད་རྣམས་ནི་དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ། ཡཱ་སི་ཨེལ་ལ་གཏོགས་པ་ཡཱ་སི་ཨེལ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། གུ་ནེ་ལ་གཏོགས་པ་གུ་ནེ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་།"]},{"type":"verse","number":49,"content":["ཡེ༌ཚིར་ལ་གཏོགས་པ་ཡེ་ཚིར་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཤིལ་ལེམ་ལ་གཏོགས་པ་ཤིལ་ལེམ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན།"]},{"type":"verse","number":50,"content":["འདི་དག་ནི་ནཱབ་ཐ་ལིའི་ཁྱིམ་རྒྱུད་རྣམས་ཡིན་པ་དང་། དེ་དག་གི་ཁྱིམ་རྒྱུད་བཞིན་དུ་རྩིས་བླངས་པ་བསྡོམས་པས་བཞི་ཁྲི་ལྔ་སྟོང་བཞི་བརྒྱའོ། །"]},{"type":"verse","number":51,"content":["དེ་དག་ནི་ཡེས་ར་ཨེལ་པ་རྣམས་ལས་རྩིས་བླངས་པའི་གྲངས་ཀ་སྟེ། བསྡོམས་པས་དྲུག་འབུམ་ཆིག་སྟོང་བདུན་བརྒྱ་སུམ་ཅུའོ། །"]},{"type":"verse","number":52,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":53,"content":["ཁྱོད་ཀྱིས་མི་རྣམས་ཀྱི་མིང་གི་གྲངས་ཀ་བཞིན་དུ། ཡུལ་དེ་ཁོ་རྣམས་ལ་ས་སྐལ་དུ་བགོ་བཤའ་བརྒྱག་དགོས་པ་དང་།"]},{"type":"verse","number":54,"content":["མི་གྲངས་མང་པོ་ཡོད་པ་ལ་ཁྱོད་ཀྱིས་ས་སྐལ་མང་པོ་བགོ་དགོས་པ་དང་། མི་གྲངས་ཉུང་ཉུང་ཡིན་པ་ལ་ཁྱོད་ཀྱིས་ས་སྐལ་ཉུང་ཉུང་བགོ་དགོས། རྩིས་བླངས་པའི་མི་གྲངས་བཞིན་དུ་ཁྱིམ་རྒྱུད་རེ་རེ་ལ་ས་སྐལ་བགོ་དགོས།"]},{"type":"verse","number":55,"content":["འོན་ཀྱང་། ཡུལ་ནི་རྒྱན་འཕངས་ནས་བགོ་བཤའ་བརྒྱག་དགོས་ལ། དེ་དག་གིས་རང་རང་གི་ཕ་མེས་རྣམས་ཀྱི་ཚོ་པའི་མིང་བཞིན་དུ་ས་སྐལ་ལེན་དགོས།"]},{"type":"verse","number":56,"content":["རྒྱན་བླངས་པ་བཞིན་དུ། མི་གྲངས་མང་ཉུང་ལ་བལྟས་ནས་ས་སྐལ་བགོ་བཤའ་བརྒྱག་དགོས་སོ། །"]},{"type":"verse","number":57,"content":["ཁྱིམ་རྒྱུད་བཞིན་རྩིས་གྲངས་བླངས་པའི་ལེ་ཝི་པ་ནི་འདི་ལྟ་སྟེ། གེར་ཤོན་ལ་གཏོགས་པ་གེར་ཤོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཀོ་ཧད་ལ་གཏོགས་པ་ཀོ་ཧད་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། མཱ་རཱ་རེའེ་ལ་གཏོགས་པ་མཱ་རཱ་རེའེ་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":58,"content":["འདི་དག་ནི་ལེ་ཝི་ཡི་ཁྱིམ་རྒྱུད་རྣམས་ཏེ། ལིབ་ནིས་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཧེབ་རོན་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། མཱ་ལི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། མུ་ཤི་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་དང་། ཀོ་རཱག་པ་རྣམས་ཀྱི་ཁྱིམ་རྒྱུད་བཅས་ཡིན་ནོ། །ཀོ་ཧད་ལས་ཨམ་རམ་སྐྱེས་པའོ། །"]},{"type":"verse","number":59,"content":["ཨམ་རམ་གྱི་ཆུང་མའི་མིང་ལ་ཡོ་ཀེ་བེད་ཟེར་ཞིང་ལེ་ཝིའི་བུ་མོ་ཡིན་ལ་ཨེ་ཅིབ་ཡུལ་དུ་ལེ་ཝི་ལ་སྐྱེས་ཤིང་། ཁོ་མོས་ཨམ་རམ་ལ་ཨ་རོན་དང་མོ་ཤེ། དེ་གཉིས་ཀྱི་ལྕམ་མོ་མིར་ཡམ་བཅས་བཙས་པའོ། །"]},{"type":"verse","number":60,"content":["ཡང་ཨ་རོན་ལས་ནཱ་དབ་དང་། ཨ་བི་ཧུ་དང་། ཨེ་ལི་ཨ་ཟར་དང་། ཨི་ཐ་མཱར་བཅས་སྐྱེས་པ་དང་།"]},{"type":"verse","number":61,"content":["ནཱ་དབ་དང་ཨ་བི་ཧུ་གཉིས་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་བཀའ་འཁྲོལ་མེད་པའི་མེ་ཕུལ་བའི་དུས་སུ་ཤི་བར་གྱུར་ཏོ། །"]},{"type":"verse","number":62,"content":["ལེ་ཝི་པ་རྣམས་ལས་ཟླ་བ་གཅིག་དང་དེའི་ཡན་གྱི་ན་ཚོད་ཟིན་པའི་ཕོ་ཐམས་ཅད་རྩིས་བླངས་པ་བསྡོམས་པས་ཉིས་ཁྲི་སུམ་སྟོང་ཡིན། ཁོ་རྣམས་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་རྩིས་མེད་དེ། གང་ལ་ཞེ་ན། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་ཁྲོད་དུ་ཁོ་རྣམས་ལ་ས་སྐལ་མ་ཐོབ་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":63,"content":["དེ་དག་ནི་མོ་ཤེ་དང་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་གཉིས་ཀྱིས་རྩིས་བླངས་པ་རྣམས་ཡིན་ཏེ། དེ་གཉིས་ཀྱིས་མོ་ཨབ་སྤང་ལྗོངས་སུ། ཡེ་རུ་ཀོའི་ཁ་གཏད་དུ་ཡོར་དན་གཙང་པོའི་འགྲམ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་རྩིས་བླངས་སོ། །"]},{"type":"verse","number":64,"content":["དེ་དག་གི་ཁྲོད་དུ་མོ་ཤེ་དང་མཆོད་དཔོན་ཨ་རོན་གཉིས་ཀྱིས་སི་ནཱ་དབེན་སྟོང་དུ་ཡེས་ར་ཨེལ་པ་རྣམས་རྩིས་ལེན་པའི་དུས་སུ་རྩིས་བླངས་པ་ནི་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":65,"content":["ཅི་ལ་ཞེ་ན། དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་ཀྱི་སྐོར་ལ་སྔར་འདི་སྐད་དུ། དེ་དག་དབེན་སྟོང་དུ་འཆི་ངེས་ཡིན་ཞེས་གསུངས་མྱོང་བའི་ཕྱིར་རོ། །དེ་རྣམས་ལས་ཡེ་ཕུན་ནེའི་བུ་ཀཱ་ལེབ་དང་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་གཉིས་ལས་གཞན་གཅིག་ཀྱང་མ་ལུས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/25.json","previousChapterAudioLinks":{},"numberOfVerses":65}