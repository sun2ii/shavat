{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":27,"content":[{"type":"heading","content":["ཚེ་ལོ་ཕེ་ཧད་ཀྱི་བུ་མོ་རྣམས།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡོ་སེབ་ཀྱི་བུ་མ་ནཱ་ཤེའི་ཁྱིམ་རྒྱུད་རྣམས་ལས། ཚེ་ལོ་ཕེ་ཧད་ཀྱི་བུ་མོ་རྣམས་དེ་དག་གི་དྲུང་དུ་འོངས་པ་དང་། ཚེ་ལོ་ཕེ་ཧད་ནི་ཧེ་ཕེར་གྱི་བུ་དང་། དེ་ནི་གིལ་ཨད་ཀྱི་བུ། དེ་ནི་མཱ་ཀིར་གྱི་བུ། དེ་ནི་མཱ་ན་ཤེའི་བུའོ། །ཁོའི་བུ་མོ་དེ་རྣམས་ཀྱི་མིང་ནི། མ་ལཱ་དང་། ནོ་ཨ་དང་། ཧོག་ལཱ་དང་། མིལ་ཀཱ་དང་། ཐིར་ཚ་བཅས་སོ། །"]},{"type":"verse","number":2,"content":["དེ་དག་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར། མོ་ཤེ་དང་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་དང་འགོ་དཔོན་རྣམས་དང་། མི་ཚོགས་ཡོངས་ཀྱི་མདུན་དུ་འགྲེང་སྟེ་ན་རེ།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་གི་ཕ་ནི་དབེན་སྟོང་དུ་ཤི་བ་དང་། ཁོ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་རྒོལ་བར་མཉམ་དུ་འདུས་པའི་མི་རྣམས་ཀྱི་ཁྲོད་དུ་མེད་ལ། ཀོ་རཱག་གི་ཕྱོགས་ཁག་ལའང་མི་གཏོགས། ཁོ་ནི་རང་གི་སྡིག་པའི་དབང་གིས་ཤི་བ་དང་ཁོ་ལ་བུ་ཡང་མེད་དོ། །"]},{"type":"verse","number":4,"content":["ངེད་ཅག་གི་ཕ་ལ་བུ་མེད་པའི་རྐྱེན་གྱིས་ཁོའི་མིང་རང་གི་ཁྱིམ་རྒྱུད་ལས་མེད་པར་བཟོས་པ་ཅི་ཡིན་ནམ། ངེད་ཅག་གི་ཕ་ཡི་སྤུན་ཟླ་ཚོའི་ཁྲོད་དུ་ང་ཚོ་ལ་བགོ་སྐལ་གནང་བར་མཛོད་ཅེས་ཞུས།"]},{"type":"verse","number":5,"content":["དེ་ནས་མོ་ཤེ་ཡིས་ཁོ་རྣམས་ཀྱི་ཞུ་བ་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཞུས་སོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":7,"content":["ཚེ་ལོ་ཕེ་ཧད་ཀྱི་བུ་མོ་རྣམས་ཀྱིས་སྨྲས་པ་ལུགས་དང་མཐུན་པ་ཡིན། ཁྱོད་ཀྱིས་དེ་དག་གི་ཕ་ཡི་སྤུན་ཟླའི་ཁྲོད་ནས་དེ་དག་ལ་བགོ་སྐལ་སྤྲོད་དགོས། དེ་དག་གི་ཕ་ཡི་བགོ་སྐལ་ཁོ་ཚོ་ལ་སྤྲོད་དགོས་སོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག མི་ཞིག་འཆི་བའི་དུས་སུ་བུ་མེད་པ་ཡིན་ན་མི་དེའི་བགོ་སྐལ་ཁོའི་བུ་མོར་སྤྲོད་དགོས་པ་དང་།"]},{"type":"verse","number":9,"content":["ཁོ་ལ་བུ་མོ་མེད་ན་ཁོའི་བགོ་སྐལ་དེའི་སྤུན་ཟླ་རྣམས་ལ་སྤྲོད་པར་བྱའོ། །"]},{"type":"verse","number":10,"content":["ཁོ་ལ་སྤུན་ཟླ་ཡང་མེད་ན་ཁོའི་བགོ་སྐལ་དེའི་ཕ་ཡི་སྤུན་རྣམས་ལ་སྤྲོད་དགོས།"]},{"type":"verse","number":11,"content":["ཁོའི་ཕ་ལ་སྤུན་ཟླ་མེད་ན་ཁོའི་བགོ་སྐལ་ནི་དེའི་ཁྱིམ་རྒྱུད་ནང་གི་རྩ་བའི་གཉེན་ཉེ་ལ་སྤྲོད་དགོས་ཤིང་། ཁོའི་བགོ་སྐལ་མི་དེར་དབང་བ་ཡིན། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་གནང་བའི་བཀའ་བཞིན་དུ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་ཡིན་ཞེས་སྨྲ་དགོས་པར་གསུངས་སོ། །"]},{"type":"heading","content":["ཡོ་ཤུ་ཨ་ཡིས་མོ་ཤེའི་ལས་འགན་རྒྱུན་འཛིན་བྱས་པ།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཨ་བཱ་རིམ་གྱི་རི་འདི་ལ་ཡར་འགོས་ནས་བདག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྤྲད་པའི་ཡུལ་དེར་ལྟོས་ཤིག"]},{"type":"verse","number":13,"content":["དེར་བལྟས་པའི་རྗེས་སུ་ཁྱོད་ཀྱང་ཁྱོད་ཀྱི་སྤུན་ཨ་རོན་བཞིན་དུ་རང་གི་རིགས་རྒྱུད་ཁྲོད་དུ་འཛོམ་པར་འགྱུར།"]},{"type":"verse","number":14,"content":["ཅི་ལ་ཞེ་ན། ཟིན་བྱ་བའི་དབེན་སྟོང་དུ་མི་ཚོགས་ཀྱིས་ངོ་རྒོལ་བྱས་པའི་དུས་སུ། ཁྱོད་རྣམས་ངའི་བཀའ་དང་འགལ་ཞིང་། ཆུ་འགྲམ་ནས་དེ་དག་གི་མདུན་དུ་ང་དམ་པར་མ་བཀུར་བའི་ཕྱིར་ཡིན་ཞེས་གསུངས། ཆུ་དེ་ནི་ཟིན་བྱ་བའི་དབེན་སྟོང་དུ་ཡོད་ལ། དེ་ནི་ཀཱ་དེའེ་ཤཱ་ཡུལ་གྱི་མེ་རི་བཱའི་ཆུ་རྣམས་ཡིན་ནོ། །"]},{"type":"verse","number":15,"content":["མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འདི་ལྟར།"]},{"type":"verse","number":16,"content":["ལུས་ཅན་ཐམས་ཅད་ཀྱི་སེམས་ཉིད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་མི་ཚོགས་འདི་ལ་བདག་སྐྱོང་བྱེད་མཁན་ཞིག་བསྐོ་བར་མཛོད།"]},{"type":"verse","number":17,"content":["ཁོ་ཚོའི་མདུན་དུ་འགྲོ་འོང་བྱེད་པ་དང་། ཁོ་ཚོ་ཁྲིད་ནས་འགྲོ་འོང་བྱེད་མཁན་ཞིག་དགོས། དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མི་ཚོགས་རྫི་བོ་མེད་པའི་ལུག་དང་འདྲ་བར་མི་འགྱུར་བའི་ཕྱིར་དུའོ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":18,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་ནུན་གྱི་བུ་ཡོ་ཤུ་ཨ་འདེམས་དགོས་ཏེ། ཁོའི་ནང་དུ་ཐུགས་ཉིད་བཞུགས་ལ། ཁྱོད་ཀྱིས་ཁོའི་ལུས་ལ་ལག་པ་ཞོག་ཅིག",{"noteId":9}]},{"type":"verse","number":19,"content":["ཁོ་ནི་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་དང་མི་ཚོགས་ཐམས་ཅད་ཀྱི་མདུན་ནས་འགྲེང་དུ་ཆུག་ལ། དེ་དག་གི་མཐོང་ངོར་ཁོ་ལ་ལས་འགན་སྤྲོད་ཅིག"]},{"type":"verse","number":20,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་མི་ཚོགས་ཡོངས་ཀྱིས་ཁོའི་བཀའ་ལ་མཉན་པའི་ཕྱིར་དུ། ཁྱོད་ཀྱིས་རང་གི་དབང་ཐང་ཆ་ཤས་ཁོ་ལ་ཐོངས་ཤིག་དང་།"]},{"type":"verse","number":21,"content":["ཁོ་རང་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་གྱི་དྲུང་དུ་འགྲེང་ནས་འདུག་པ་དང་། ཨེ་ལི་ཨ་ཟར་གྱིས་ཡོ་ཤུ་ཨའི་ཕྱིར་དཀོན་མཆོག་ཡ་ཝཱེའི་དྲུང་དུ་ཨུའུ་རིམ་ལས་ཐུགས་བརྟག་ཞུ་བར་འགྱུར། ཁོ་དང་ཡེས་ར་ཨེལ་པ་ཐམས་ཅད་དེ། མི་ཚོགས་ཡོངས་ནི་ཨེ་ལི་ཨ་ཟར་གྱི་བཀའ་བཞིན་འགྲོ་འོང་བྱེད་དགོས་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":22,"content":["དེ་ནས་མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་དུ་བསྒྲུབས་པ་དང་། ཁོས་ཡོ་ཤུ་ཨ་ཁྲིད་འོངས་ཏེ་མཆོད་དཔོན་ཨེ་ལི་ཨ་ཟར་དང་མི་ཚོགས་ཡོངས་ཀྱི་མདུན་ནས་འགྲེང་དུ་བཅུག་ཅིང་།"]},{"type":"verse","number":23,"content":["ཁོའི་ལུས་ལ་ཕྱག་གླན་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་བརྒྱུད་ནས་གནང་བའི་བཀའ་བཞིན་དུ་ཁོ་ལ་ལས་འགན་སྤྲད་དོ། །"]}],"footnotes":[{"noteId":9,"caller":"+","text":"འདིར་ལུས་ལ་ལག་པ་ཞོག་ཅིག་ཅེས་པ་ནི་ལས་འགན་བསྐོ་བའི་རྣམ་པ་ཞིག་ཡིན།","reference":{"chapter":27,"verse":18}}]},"thisChapterLink":"/api/bod_ntb/NUM/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}