{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":29,"content":[{"type":"heading","content":["དུང་འབུད་དུས་ཆེན་གྱི་མཆོད་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཟླ་བ་བདུན་པའི་ཉིན་དང་པོར། ཁྱོད་ཅག་ལ་འདུ་འཛོམས་དམ་པ་ཡོད་དགོས་ལ། རྒྱུན་ལྡན་གྱི་ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་། དེ་ནི་ཁྱོད་ཅག་གིས་དུང་འབུད་པའི་ཉིན་མོ་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["ཁྱོད་ཅག་གིས་སྦྱིན་སྲེག་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་གྱི་མཆོད་པ་རུ་འབུལ་དགོས་ཏེ། གླང་ཐུག་གཅིག་དང་། ལུག་ཐུག་གཅིག་དང་། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བདུན་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":3,"content":["དེ་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་ནི་ཕྱེ་བཟང་པོ་སྣུམ་བསྲེས་མ་ཡིན་ལ། གླང་ཐུག་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གསུམ་རེ་དང་། ལུག་ཐུག་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཉིས་རེ་དང་།"]},{"type":"verse","number":4,"content":["ལུ་གུ་བདུན་པོ་དེ་རེ་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཅིག་རེ་འབུལ་དགོས།"]},{"type":"verse","number":5,"content":["ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་ཕུལ་ནས་ཁྱོད་ཅག་གི་སྡིག་པ་བཤག་དགོས།"]},{"type":"verse","number":6,"content":["ཚེས་གཅིག་གི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། ཁྲིམས་སྲོལ་ལྟར་དེ་དང་མཉམ་དུ་ཕུལ་བའི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། དེ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་གྱི་མེ་མཆོད་དུ་འབུལ་བར་བྱའོ། །"]},{"type":"heading","content":["སྡིག་བཤགས་ཉིན་མོའི་མཆོད་པ།"]},{"type":"verse","number":7,"content":["ཟླ་བ་བདུན་པའི་ཚེས་བཅུ་ལ་ཁྱོད་ཅག་གིས་རང་ཉིད་ཁྱད་དུ་བསད་ནས་འདུ་འཛོམས་དམ་པ་རོལ་དགོས་ལ། ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་སྦྱིན་སྲེག་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་གྱི་མཆོད་པར་འབུལ་དགོས་པ་སྟེ། གླང་ཐུག་གཅིག་དང་། ལུག་ཐུག་གཅིག་དང་། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བདུན་བཅས་ཡིན་ནོ། །"]},{"type":"verse","number":9,"content":["དེ་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་ནི་ཕྱེ་བཟང་པོ་སྣུམ་བསྲེས་མ་ཡིན་ལ། གླང་ཐུག་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གསུམ་རེ་དང་། ལུག་ཐུག་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཉིས་རེ་དང་།"]},{"type":"verse","number":10,"content":["ལུ་གུ་བདུན་པོ་དེ་རེ་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཅིག་རེ་འབུལ་དགོས།"]},{"type":"verse","number":11,"content":["སྡིག་པའི་ཕྱིར་དུ་ཕུལ་བའི་སྡིག་བཤགས་མཆོད་པ་དང་། དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པ་རུ་འབུལ་དགོས་སོ། །"]},{"type":"heading","content":["སྤྱིལ་བུའི་དུས་ཆེན་གྱི་མཆོད་པ།"]},{"type":"verse","number":12,"content":["ཡང་ཟླ་བ་བདུན་པའི་ཚེས་བཅོ་ལྔའི་ཉིན་ཁྱོད་ཅག་ལ་འདུ་འཛོམས་དམ་པ་ཡོད་དགོས་ཤིང་། རྒྱུན་ལྡན་གྱི་ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་ལ། དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱིར་ཉིན་བདུན་ལ་དུས་ཆེན་གཏོང་དགོས།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཅག་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་གྱི་མེ་མཆོད་དུ་སྦྱིན་སྲེག་འབུལ་དགོས་པ་སྟེ། གླང་ཐུག་བཅུ་གསུམ་དང་། ལུག་ཐུག་གཉིས་དང་། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་སོ། །"]},{"type":"verse","number":14,"content":["དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་ནི་ཕྱེ་བཟང་པོ་སྣུམ་བསྲེས་མ་ཡིན་ལ། གླང་ཐུག་བཅུ་གསུམ་པོ་དེ་རེ་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གསུམ་རེ་དང་། ལུག་ཐུག་གཉིས་པོ་དེ་རེ་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཉིས་རེ་དང་།"]},{"type":"verse","number":15,"content":["ལུ་གུ་བཅུ་བཞི་པོ་དེ་རེ་རེའི་ཕྱིར་དུ་ཨེ་ཕཱ་བཅུ་ཆ་གཅིག་རེ་འབུལ་དགོས།"]},{"type":"verse","number":16,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":17,"content":["ཉིན་གཉིས་པར་གླང་ཐུག་བཅུ་གཉིས་དང། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":18,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":19,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":20,"content":["ཉིན་གསུམ་པར་གླང་ཐུག་བཅུ་གཅིག་དང་། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":21,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":22,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":23,"content":["ཉིན་བཞི་པར་གླང་ཐུག་བཅུ་དང་། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":24,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":25,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":26,"content":["ཉིན་ལྔ་པར་གླང་ཐུག་དགུ་དང་། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":27,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":28,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":29,"content":["ཉིན་དྲུག་པར་གླང་ཐུག་བརྒྱད་དང་། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":30,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":31,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":32,"content":["ཉིན་བདུན་པར་གླང་ཐུག་བདུན་དང་། ལུག་ཐུག་གཉིས། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བཅུ་བཞི་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":33,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":34,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":35,"content":["ཉིན་བརྒྱད་པར་ཁྱོད་ཅག་ལ་འདུ་འཛོམས་དམ་ནན་ཞིག་ཡོད་དགོས་ལ། རྒྱུན་ལྡན་གྱི་ལས་ཀ་གང་ཡང་བྱེད་མི་རུང་།"]},{"type":"verse","number":36,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ལ་དྲི་ཞིམ་གྱི་མེ་མཆོད་དུ་སྦྱིན་སྲེག་འབུལ་དགོས་པ་སྟེ། གླང་ཐུག་གཅིག་དང་ལུག་ཐུག་གཅིག་དང་། སྐྱོན་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་བདུན་བཅས་འབུལ་དགོས་པར་མ་ཟད།"]},{"type":"verse","number":37,"content":["གླང་ཐུག་དང་ལུག་ཐུག་དང་ལུ་གུ་བཅས་ཀྱི་ཕྱིར་དུ་དེ་དག་གི་གྲངས་ཀ་དང་ཁྲིམས་སྲོལ་བཞིན་དུ། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་འབུལ་དགོས།"]},{"type":"verse","number":38,"content":["དུས་རྒྱུན་གྱི་སྦྱིན་སྲེག་དང་དེའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། དེ་དག་གི་སྐྱེམས་མཆོད་བཅས་ཀྱི་ཕན་ཆོད་ནས། ཡང་ར་ཕོ་གཅིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":39,"content":["མཆོད་པ་འདི་དག་ནི་ཁྱོད་ཅག་གི་དུས་ཆེན་གྱི་སྐབས་སུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་འབུལ་དགོས་པ་སྟེ། དམ་བཅའི་མཆོད་པ་དང་ཡིད་མོས་ཀྱི་མཆོད་པ་དང་། སྦྱིན་སྲེག་གི་མཆོད་པ་དང་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་། སྐྱེམས་མཆོད་དང་། ཞི་བདེའི་མཆོད་པ་བཅས་ཀྱི་ཕན་ཆོད་ནས་ཕུལ་བ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"verse","number":40,"content":["དེ་ནས་མོ་ཤེ་ཡིས་དཀོན་མཆོག་ཡ་ཝཱེས་གནང་བའི་བཀའ་ཐམས་ཅད་དེ་བཞིན་དུ་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་སྨྲས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/28.json","previousChapterAudioLinks":{},"numberOfVerses":40}