{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":6,"content":[{"type":"heading","content":["ནཱ་ཟར་པའི་སྒྲིག་སྲོལ།"]},{"type":"verse","number":1,"content":["དེ་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་དང་། སྐྱེས་པའམ་བུད་མེད་སུ་ཡིན་ཡང་གལ་སྲིད་དམ་བཅའ་ཁྱད་པར་ཅན་ཏེ་ནཱ་ཟར་པའི་དམ་བཅའ་བཞག་ཡོད་ན། སྡོམ་པ་བསྲུངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་དགོས།"]},{"type":"verse","number":3,"content":["རྒུན་ཆང་དང་གར་ཆང་གཅོད་དགོས་ཤིང་། རྒུན་ཆང་གིས་བཟོས་པའི་སྐྱུར་ཆུ་དང་གར་ཆང་གིས་བཟོས་པའི་སྐྱུར་ཆུ་གང་ཡང་སྤྱོད་མི་འོས། རྒུན་འབྲུམ་གྱི་བཅུད་ཁུ་གང་ཡང་འཐུང་མི་རུང་ལ། རྒུན་འབྲུམ་གསར་པའམ་སྐམ་པོ་གང་ཡང་བཟའ་མི་འོས་སོ། །"]},{"type":"verse","number":4,"content":["སྡོམ་པ་སྲུང་བའི་ཉིན་མོ་དག་ལ། རྒུན་ཤིང་ལས་སྨིན་པའི་འབྲུ་གུའམ་ཤུན་པ་གང་ཡང་བཟའ་མི་རུང་ངོ་། །"]},{"type":"verse","number":5,"content":["མི་དེས་དམ་བཅས་ནས་སྡོམ་པ་སྲུང་བའི་ཉིན་མོ་དག་ལ། སྤུ་གྲིས་མགོ་ལ་རེག་མི་རུང་ཞིང་དམ་པ་ཡིན་དགོས་ལ། སྡོམ་པ་བསྲུངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པའི་ཉིན་མོ་དེ་དག་རྫོགས་པའི་བར་དུ་མགོའི་སྐྲ་སྐྱེ་རུ་འཇུག་དགོས།"]},{"type":"verse","number":6,"content":["སྡོམ་པ་བསྲུངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པའི་ཉིན་མོ་དག་ལ་གཤིན་པོའི་བེམ་པོ་དང་ཉེ་བར་བཅར་མི་རུང་ངོ་། །"]},{"type":"verse","number":7,"content":["ཁོའི་ཕ་མ་དང་ཕུ་ནུ་མིང་སྲིང་ཤི་བའི་ཚེ། དེ་དག་གི་རྐྱེན་གྱིས་རང་ཉིད་བཙོག་པར་བཟོ་མི་རུང་སྟེ། སྡོམ་པ་བསྲུངས་ནས་དཀོན་མཆོག་ལ་གཏོགས་པའི་རྟགས་ནི་ཁོའི་མགོ་ལ་ཡོད་པའི་ཕྱིར་རོ། །"]},{"type":"verse","number":8,"content":["སྡོམ་པ་སྲུང་བའི་ཉིན་མོ་དག་ལ་ཁོ་ནི་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་ཤིང་དམ་པ་ཡིན།"]},{"type":"verse","number":9,"content":["གལ་སྲིད་དེའི་གམ་དུ་མི་ཞིག་གློ་བུར་ཤི་ནས། དེས་ཁོའི་དམ་པར་བསྔོས་པའི་མགོ་མི་གཙང་བར་བཟོས་ན། གཙང་སྦྲ་བྱེད་པའི་ཉིན་མོ་སྟེ། ཉིན་བདུན་པ་ལ་ཁོའི་སྐྲ་གཞར་དགོས།"]},{"type":"verse","number":10,"content":["ཉིན་བརྒྱད་པ་ལ་ཁོས་བྱ་ཐི་བ་གཉིས་སམ་ཕུག་རོན་ཆུང་ངུ་གཉིས་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་ཁྱེར་ནས་མཆོད་དཔོན་ལ་སྤྲོད་དགོས།"]},{"type":"verse","number":11,"content":["མཆོད་དཔོན་གྱིས་གཅིག་ནི་སྡིག་བཤགས་མཆོད་པ་དང་། ཅིག་ཤོས་ནི་སྦྱིན་སྲེག་ཏུ་ཕུལ་ནས་གཤིན་པོའི་བེམ་པོའི་རྐྱེན་གྱིས་བཙོག་པར་གྱུར་པའི་སྡིག་པ་བཤག་དགོས་ལ། ཁོས་ཉིན་དེ་ཉིད་དུ་རང་གི་མགོ་དམ་པར་བྱེད་དགོས།"]},{"type":"verse","number":12,"content":["སྡོམ་པ་བསྲུངས་ནས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་གཏོགས་པའི་ཉིན་མོར། ཡང་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་ཞིག་ཁྱེར་ཡོང་ནས་ཉེས་སེལ་མཆོད་པར་འབུལ་དགོས། འོན་ཀྱང་སྡོམ་པ་མི་གཙང་བར་གྱུར་པའི་རྐྱེན་གྱིས། དེའི་སྔར་གྱི་ཉིན་མོ་རྣམས་རྩི་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":13,"content":["ནཱ་ཟར་པ་རྣམས་ཀྱི་བཀའ་ཁྲིམས་ནི་འདི་ལྟ་སྟེ། སྡོམ་པ་སྲུང་མཁན་གྱི་ཉིན་མོ་རྣམས་རྫོགས་པའི་ཉིན་ལ། མི་དེ་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་འཁྲིད་དགོས་ཤིང་།"]},{"type":"verse","number":14,"content":["ཁོས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་འབུལ་དགོས་ཏེ། སྐྱོན་ཅི་ཡང་མེད་པའི་ལོ་གཅིག་ཅན་གྱི་ལུ་གུ་ཕོ་ཞིག་སྦྱིན་སྲེག་ཏུ་འབུལ་བ་དང་། སྐྱོན་ཅི་ཡང་མེད་པའི་མོ་ལུག་ལོ་གཅིག་ཅན་ཞིག་སྡིག་བཤགས་མཆོད་པར་འབུལ་དགོས། སྐྱོན་ཅི་ཡང་མེད་པའི་ལུག་ཐུག་ཅིག་ཞི་བདེའི་མཆོད་པར་འབུལ་བ་དང་།"]},{"type":"verse","number":15,"content":["ཕྱེ་བཟང་པོས་བཟོས་པའི་སྐྱུར་མེད་སྣུམ་བསྲེས་བག་ལེབ་དང་སྐྱུར་མེད་སྣུམ་བྱུགས་བག་ལེབ་སྲབ་མོ་གཟེབ་གང་དང་། དེ་དག་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་བཅས་འབུལ་དགོས་སོ། །"]},{"type":"verse","number":16,"content":["མཆོད་དཔོན་གྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་དེ་དག་འབུལ་བ་དང་། སྡིག་བཤགས་མཆོད་པ་དང་སྦྱིན་སྲེག་ཀྱང་འབུལ་དགོས།"]},{"type":"verse","number":17,"content":["ཡང་མཆོད་དཔོན་གྱིས་ལུག་ཐུག་དེ་དང་སྐྱུར་མེད་བག་ལེབ་ཀྱི་གཟེབ་དེ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཞི་བདེའི་མཆོད་པར་འབུལ་དགོས་པ་དང་། ཁོས་དེ་དང་མཉམ་དུ་འབུལ་བའི་འབྲུ་རིགས་ཀྱི་མཆོད་པ་དང་སྐྱེམས་མཆོད་ཀྱང་འབུལ་བར་བྱའོ། །"]},{"type":"verse","number":18,"content":["ནཱ་ཟར་པས་མཇལ་འཕྲད་གུར་མཆོག་གི་སྒོ་ཁར་རང་གི་སྡོམ་པ་སྲུང་བའི་སྐྲ་བཞར་ནས། དེ་ཞི་བདེའི་མཆོད་པ་འོག་ཏུ་ཡོད་པའི་མེ་ཐོག་ཏུ་འཇོག་དགོས།"]},{"type":"verse","number":19,"content":["ནཱ་ཟར་པས་རང་གི་སྡོམ་པ་སྲུང་བའི་སྐྲ་བཞར་རྗེས། མཆོད་དཔོན་གྱིས་བཙོས་ཟིན་པའི་ལུག་ཐུག་གི་སོག་པ་གཅིག་དང་། ཡང་གཟེབ་ལས་སྐྱུར་མེད་བག་ལེབ་གཅིག་དང་། སྐྱུར་མེད་བག་ལེབ་སྲབ་མོ་གཅིག་བཅས་བླངས་ཏེ་ནཱ་ཟར་པའི་ལག་ཏུ་འཇོག་དགོས།"]},{"type":"verse","number":20,"content":["དེ་ནས་མཆོད་དཔོན་གྱིས་དེ་རྣམས་གཡོབ་མཆོད་དུ་བྱས་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་སྤྱན་སྔར་ཕར་གཡོ་ཚུར་གཡོ་བྱེད་དགོས་པ་དང་། དེ་རྣམས་གཡོབ་མཆོད་དུ་ཕུལ་བའི་བྲང་ཁོག་དང་འདེགས་མཆོད་དུ་ཕུལ་བའི་བརླ་རྐང་དང་བཅས་ཏེ་མཆོད་དཔོན་ལ་དབང་བའི་རྫས་དམ་པ་ཡིན། དེའི་རྗེས་སུ་ནཱ་ཟར་པས་ད་གཟོད་རྒུན་ཆང་འཐུང་ཆོག་པའོ། །"]},{"type":"verse","number":21,"content":["དམ་བཅའ་འཇོག་མཁན་ནཱ་ཟར་པའི་བཀའ་ཁྲིམས་ནི། ནཱ་ཟར་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་ཕུལ་བའི་མཆོད་པ་ནི་ཁོའི་སྡོམ་པ་སྲུང་བའི་དམ་བཅའ་བཞིན་དང་། ཁོའི་ལག་གི་འཛོམས་ཚོད་བཞིན་ཡིན་ཞིང་། ཁོས་ཇི་ལྟར་དམ་བཅས་པ་ཡིན་ན་དེ་ལྟར་སྡོམ་པ་སྲུང་བའི་སྒྲིག་སྲོལ་བཞིན་བསྒྲུབ་དགོས་ཞེས་པ་དེ་ཡིན་ནོ་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["མཆོད་དཔོན་རྣམས་བརྒྱུད་ནས་གནང་བའི་བྱིན་རླབས།"]},{"type":"verse","number":22,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱིས་ཨ་རོན་དང་དེའི་བུ་རྣམས་ལ་འདི་ལྟར། ཁྱོད་ཅག་གིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བྱིན་རླབས་གནང་ནས་དེ་དག་ལ།"]},{"type":"verse","number":24,"content":[{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ལ་བྱིན་རླབས་མཛད་ཅིང་ཁྱོད་རང་བསྲུང་བར་ཤོག","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞལ་མདངས་ཁྱོད་ཀྱི་སྟེང་དུ་སྤྲོས་ཏེ། ཁྱོད་ལ་ཐུགས་རྗེ་གནང་བར་ཤོག","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་ཉིད་ཀྱི་ཞལ་ངོ་ཁྱོད་ལ་བསྟན་ནས་ཁྱོད་ལ་ཞི་བདེ་གནང་བར་ཤོག","poem":1},"ཅེས་སྨྲོས་ཤིག"]},{"type":"verse","number":27,"content":["ཁོ་རྣམས་ཀྱིས་དེ་བཞིན་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་བདག་གི་མིང་བརྗོད་དགོས་པ་དང་། བདག་གིས་ཀྱང་དེ་དག་ལ་བྱིན་གྱིས་བརླབ་པར་བྱའོ་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/5.json","previousChapterAudioLinks":{},"numberOfVerses":27}