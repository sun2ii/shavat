{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"NUM","translationId":"bod_ntb","name":"གྲངས་ཀ","commonName":"གྲངས་ཀ","title":"༄༅། །གྲངས་ཀའི་མདོ།","order":4,"numberOfChapters":36,"sha256":"25f7df9144ea36e63eee6823dcaac195caccf567b2397fba8e6ae35d943db137","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bod_ntb/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":9,"content":[{"type":"heading","content":["པེ་སག་གི་དུས་ཆེན།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ཡེས་ར་ཨེལ་པ་རྣམས་ཨེ་ཅིབ་ཡུལ་ནས་ཐོན་ཏེ་ལོ་གཉིས་པའི་ཟླ་དང་པོ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་སི་ནཱ་དབེན་སྟོང་དུ་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":2,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་གཏན་ལ་ཁེལ་བའི་དུས་སུ་པེ་སག་དུས་ཆེན་བསྲུང་དགོས་ཏེ།"]},{"type":"verse","number":3,"content":["ཟླ་བ་འདིའི་ཚེས་བཅུ་བཞི་པའི་ཉིན་ས་སྲོས་ཀྱི་དུས་སུ། ཁྱོད་ཅག་གིས་གཏན་ལ་ཁེལ་བའི་དུས་སུ་དུས་ཆེན་དེ་བསྲུང་དགོས་ཤིང་། དུས་ཆེན་དེའི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་ཐམས་ཅད་བཞིན་ནོ་ཞེས་བཀའ་གནང་ངོ་། །"]},{"type":"verse","number":4,"content":["དེའི་ཕྱིར་མོ་ཤེ་ཡིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་པེ་སག་གི་དུས་ཆེན་བསྲུང་བར་བསྒོས་ཤིང་།"]},{"type":"verse","number":5,"content":["དེ་དག་གིས་ཟླ་དང་པོའི་ཚེས་བཅུ་བཞིའི་ཉིན་ས་སྲོས་ཀྱི་དུས་སུ། སི་ནཱ་དབེན་སྟོང་དུ་པེ་སག་གི་དུས་ཆེན་བསྲུངས་ཤིང་། དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་ཅི་ལྟར་བཀའ་བསྩལ་པ་བཞིན། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":6,"content":["ཡིན་ནའང་མི་འགའ་ཞིག་གིས་འདས་པོར་རེག་པའི་རྐྱེན་གྱིས་མི་གཙང་བར་གྱུར་ནས། ཉིན་དེར་པེ་སག་གི་དུས་ཆེན་བསྲུང་མ་ནུས་པས། ཁོ་རྣམས་ཉིན་མོ་དེར་མོ་ཤེ་དང་ཨ་རོན་གཉིས་ཀྱི་དྲུང་དུ་ཡོང་བ་དང་།"]},{"type":"verse","number":7,"content":["དེ་དག་གིས་མོ་ཤེ་ལ། འདས་པོར་རེག་པའི་རྐྱེན་གྱིས་ངེད་ཅག་མི་གཙང་བར་གྱུར་ནའང་། ཡེས་ར་ཨེལ་པ་རྣམས་དང་མཉམ་དུ་གཏན་ལ་ཁེལ་བའི་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མཆོད་པ་འབུལ་བར་བཀག་པ་ཅི་ཞེས་ཞུས་པ་ན།"]},{"type":"verse","number":8,"content":["མོ་ཤེ་ཡིས་དེ་དག་ལ་འདི་ལྟར། ཁྱོད་ཅག་གིས་སྒུགས་དང་། ང་རང་སོང་ནས་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་སྐོར་ལ་བཀའ་ཅི་ཞིག་གནང་བར་བལྟའོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་མོ་ཤེ་ལ་འདི་སྐད་དུ།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་ཡེས་ར་ཨེལ་པ་རྣམས་ལ་འདི་ལྟར་སྨྲོས་ཤིག ཁྱོད་ཅག་དང་ཁྱོད་ཅག་གི་བུ་རབས་ཚ་རྒྱུད་ཁྲོད་དུ། སུ་ཞིག་འདས་པོར་རེག་ནས་མི་གཙང་བར་གྱུར་པའམ། ཡང་ན་རྒྱང་རིང་དུ་གནས་སྐོར་ལ་བསྐྱོད་ཀྱང་། དེས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་པེ་སག་གི་དུས་ཆེན་བསྲུང་དགོས་ན།"]},{"type":"verse","number":11,"content":["དེ་དག་གིས་ཟླ་བ་གཉིས་པའི་ཚེས་བཅུ་བཞིའི་ཉིན་ས་སྲོས་ཀྱི་དུས་སུ་པེ་སག་གི་དུས་ཆེན་བསྲུང་དགོས་ལ། དུས་མཉམ་དུ་སྐྱུར་མེད་བག་ལེབ་དང་སྔོ་ཚོད་ཁ་མོ་བཟའ་དགོས།"]},{"type":"verse","number":12,"content":["ཞོགས་པའི་བར་དུ་དེ་ལས་ཅི་ཡང་ལུས་སུ་འཇུག་མི་རུང་། ལུ་གུའི་རུས་པ་རྐང་གཅིག་ཀྱང་གཅོག་མི་རུང་ལ། དེ་དག་གིས་པེ་སག་དུས་ཆེན་གྱི་སྒྲིག་ཁྲིམས་ཐམས་ཅད་བཞིན་དུ་དུས་ཆེན་བསྲུང་དགོས།"]},{"type":"verse","number":13,"content":["འོན་ཀྱང་མི་སུ་ཞིག་གཙང་མ་ཡིན་ཞིང་། གནས་སྐོར་གྱི་ལམ་དུ་ཡང་མེད་ཀྱང་པེ་སག་གི་དུས་ཆེན་བསྲུང་བ་སྣང་མེད་དུ་བསྐྱུར་ན། མི་དེས་གཏན་ལ་ཁེལ་བའི་དུས་སུ་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་པ་མ་ཕུལ་བས། མི་དེས་རང་གི་སྡིག་པ་འཁུར་དགོས་ཤིང་རང་གི་མི་ཚོགས་ལས་འཕུད་དགོས།"]},{"type":"verse","number":14,"content":["གལ་སྲིད་ཕྱི་མི་ཞིག་ཁྱོད་ཅག་གི་ཁྲོད་དུ་གནས་པ་དང་། དཀོན་མཆོག་ཡ་ཝཱེ་ལ་པེ་སག་གི་དུས་ཆེན་བསྲུང་འདོད་ན། དེས་པེ་སག་གི་སྒྲིག་ཁྲིམས་དང་སྲོལ་ཡིག་བཞིན་དུ་བསྲུང་དགོས་པ་སྟེ། བྱེས་པ་དང་གཞིས་སྐྱེས་གང་ཡིན་ཡང་སྒྲིག་ཁྲིམས་ནི་གཅིག་མཚུངས་ཡིན་དགོས་ཞེས་སྨྲ་བར་བཀའ་བསྩལ་ཏོ། །"]},{"type":"heading","content":["དཀོན་མཆོག་གི་སྤྲིན་གྱིས་གུར་མཆོག་བསྐོར་བ།"]},{"type":"verse","number":15,"content":["གུར་མཆོག་སྒྲེང་བའི་ཉིན་མོ་དེར། སྤྲིན་གྱིས་གུར་མཆོག་སྟེ་དཔང་པོའི་གུར་མཆོག་གཡོགས་པ་དང་། མཚན་མོ་ནས་ཞོགས་པའི་བར་དུ་གུར་མཆོག་སྟེང་གི་སྤྲིན་ནི་མེའི་དབྱིབས་དང་མཚུངས་སོ། །"]},{"type":"verse","number":16,"content":["དུས་རྟག་ཏུ་དེ་བཞིན་བྱུང་སྟེ། ཉིན་མོར་གུར་མཆོག་སྤྲིན་གྱིས་གཡོགས་ཤིང་། མཚན་མོར་སྤྲིན་ནི་མེའི་དབྱིབས་དང་མཚུངས་པ་ཡིན།"]},{"type":"verse","number":17,"content":["ནམ་ཞིག་སྤྲིན་དེ་གུར་མཆོག་ནས་བཏེགས་པའི་ཚེ། ཡེས་ར་ཨེལ་པ་རྣམས་ལམ་དུ་ཆས་ཤིང་། སྤྲིན་གང་དུ་བཞུགས་པ་ཡིན་ན་ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་གནས་དེར་སྒར་བཏབ་པའོ། །"]},{"type":"verse","number":18,"content":["ཡེས་ར་ཨེལ་པ་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་ལམ་དུ་ཆས་པ་དང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་སྒར་བཏབ། སྤྲིན་གུར་མཆོག་གི་སྟེང་དུ་དུས་ཡུན་ཅི་ཙམ་ལ་བཞུགས་པ་ཡིན་ན། ཁོ་རྣམས་ཀྱིས་ཀྱང་དེ་ཙམ་ལ་སྒར་བཏབ་ནས་བསྡད་དོ། །"]},{"type":"verse","number":19,"content":["གལ་སྲིད་སྤྲིན་གུར་མཆོག་གི་སྟེང་དུ་ཉིན་མང་པོར་བཞུགས་པའི་ཚེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བརྩིས་ནས་ལམ་དུ་མི་ཆས་པ་ཡིན་ནོ། །"]},{"type":"verse","number":20,"content":["སྐབས་འགར་སྤྲིན་ཉིན་ཁ་ཤས་ཙམ་ལ་གུར་མཆོག་གི་སྟེང་དུ་བཞུགས་པ་དང་། དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་སྒར་བཏབ་ཅིང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་ལམ་དུ་ཆས་པའོ། །"]},{"type":"verse","number":21,"content":["སྐབས་འགར་སྤྲིན་མཚན་མོ་ནས་ཞོགས་པའི་བར་དུ་གནས་པ་དང་། ཞོགས་པར་སྤྲིན་བཏེགས་པ་ཙམ་དུ་ཁོ་རྣམས་ལམ་དུ་ཆས་ཤིང་། སྐབས་འགར་སྤྲིན་ཉིན་མོ་ནས་མཚན་མོའི་བར་དུ་གནས་པ་དང་། སྤྲིན་ཡར་བཏེགས་པའི་ཚེ་དེ་དག་ལམ་དུ་ཆས་པའོ། །"]},{"type":"verse","number":22,"content":["དེ་ནི་ཉིན་གཉིས་སམ་ཟླ་བ་གཅིག་གམ་ཡང་ན་ལོ་གཅིག་གི་རིང་། སྤྲིན་གུར་མཆོག་གི་སྟེང་དུ་བཞུགས་པའི་ཚེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་སྒར་བཏབ་ནས་བསྡད་ཅིང་ལམ་དུ་མ་ཆས་པ་དང་། སྤྲིན་ཡར་བཏེགས་པའི་ཚེ་ཁོ་རྣམས་ལམ་དུ་ཆས་སོ། །"]},{"type":"verse","number":23,"content":["དེ་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་སྒར་བཏབ་པ་དང་། ཡང་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་བཞིན་ལམ་དུ་ཆས་ཤིང་། དེ་དག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་སྟེ་ཁོང་གིས་མོ་ཤེ་བརྒྱུད་ནས་གསུངས་པའི་བཀའ་བརྩིས་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/NUM/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/NUM/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/NUM/8.json","previousChapterAudioLinks":{},"numberOfVerses":23}