{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PHP","translationId":"bod_ntb","name":"ཕི་ལིབ་པི་པ།","commonName":"ཕི་ལིབ་པི་པ།","title":"༄༅། །ཕི་ལིབ་པི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":50,"numberOfChapters":4,"sha256":"c8150c99f2b133c93f863d15f8ee5bed919ddf7bcde400ffc98cc01675b7b050","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PHP/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/PHP/4.json","totalNumberOfVerses":103},"chapter":{"number":3,"content":[{"type":"heading","content":["ཤ་གཟུགས་ཀྱི་ཕུང་བོར་བརྟེན་མི་འོས༌པ།"]},{"type":"verse","number":1,"content":["བདག་གི་སྤུན་ཟླ༌རྣམས། མཐར་ཁྱོད་ཅག་གཙོ་བོ་ལ་བརྟེན་ནས་དགའ་ཞིང་སྤྲོ་བར༌གྱིས། བདག་གིས་ཡང་བསྐྱར་གཏམ་འདི་རྣམས་ཁྱོད་ཅག་ལ་འབྲི་བར་དཀའ་ངལ་མེད༌ལ། ཁྱོད་ཅག་ལ་མཚོན་ན་འོས་ཤིང་འཚམ་པ་ཡིན་ནོ།།"]},{"type":"verse","number":2,"content":["ཁྱོད་རྣམས་ཀྱིས་ཁྱི་སྤྱང་ངན་པ་ལྟ་བུ་དང་ལས་ངན་པ་བྱེད་མཁན། རང་སྣང་ཆེན་པོས་མཚན་སྐྱི་གཅོད་མཁན་དག་ལ་དོགས་ཟོན་བྱོས༌ཤིག"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་ཅག་ནི་དངོས་གནས་མཚན་སྐྱི་གཅོད་པ་དག་ཡིན༌ལ། དཀོན་མཆོག་གི་ཐུགས་ཉིད་ལ་བརྟེན་ནས་བསྙེན་བཀུར་བྱེད༌ཅིང༌། མཱ་ཤི་ཀ་ཡེ་ཤུར་བསྔགས་མཁན་ཡང་ཡིན་པ༌ལས། ཤ་ཁྲག་གི་ཕུང་བོར་བརྟེན་མཁན་མ་ཡིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":4,"content":["དོན་དམ་དུ། ངས་ཀྱང་ཤ་ཁྲག་གི་ཕུང་བོར་བརྟེན་རུང་སྟེ། མི་གཞན་ཞིག་གིས་ཤ་ཁྲག་གི་ཕུང་བོར་བརྟེན་རུང་བར་འདོད༌ན། བདག་ནི་ལྷག་ཏུ་བརྟེན་རུང་ངོ་།།"]},{"type":"verse","number":5,"content":["སྐྱེས་ནས་ཉིན་བརྒྱད་པ་ལ་ངའི་མཚན་སྐྱི་བཅད་ཅིང་། ང་ནི་ཡེས་ར་ཨེལ་གྱི་མི་རིགས་དང༌པེན་ཡཱ་མེན་གྱི་ཚོ་པ་ལའང་གཏོགས༌པ་དང་། ཨིབ་རིའི་མི་རིགས་ནས་མཆེད་པའི་རིགས་རྒྱུད་དངོས་མ་ཡང་ཡིན། བཀའ་ཁྲིམས་ཀྱི་ཕྱོགས་ནས་བཤད༌ན། ང་ནི་ཕ་རུ་ཤི་པའི་གྲུབ་མཐའ་ལ་གཏོགས་པ་ཡིན།"]},{"type":"verse","number":6,"content":["རང་གི་སྤྲོ་སེམས་ཐད་ནས་བཤད༌ན། ང་རང་ནི་ཆོས་ཚོགས་ལ་གནོད་འཚེ་ཆེན་པོ་བྱེད་མཁན་ཡིན་ལ། བཀའ་ཁྲིམས་ཀྱི་བདེན་ལུགས་ལྟར་བཤད༌ན། བདག་ནི་སྐྱོན་གྱི་དྲི་མས་མ་གོས་པ་ཡིན་ནོ།།"]},{"type":"verse","number":7,"content":["འོན༌ཀྱང༌། སྔོན་ཆད་བདག་གིས་ཁེ་ཕན་དུ་བསམས་པ་ཐམས་ཅད་ད་ལྟ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་རྐྱེན་གྱིས་གྱོང་གུད་དུ་མཐོང༌ངོ་།།"]},{"type":"verse","number":8,"content":["དེར་མ་ཟད་ངས་རང་གི་གཙོ་བོ་མཱ་ཤི་ཀ་ཡེ་ཤུ་ཁོང་ཉིད་ངོ་ཤེས༌པ་ནི་མཆོག་ཏུ་གྱུར་བར་བསམས་པས་དོན་གཞན་ཐམས་ཅད་གྱོང་གུད་དུ་བརྩིས་པ་ཡིན་ལ། བདག་ལ་སྐྱབས་མགོན་མཱ་ཤི་ཀ་འཐོབ་པའི་ཕྱིར། ངས་ཁོང་གི་ཆེད་དུ་དོན་གཞན་ཐམས་ཅད་སྤངས་ཤིང་སྙིགས་མར་བརྩིས་པ་དང་།"]},{"type":"verse","number":9,"content":["ང་རང་ཁོང་གི་ནང་དུ་གནས་པ་དང་། རང་ཉིད་ལའང་སྐྱབས་མགོན་མཱ་ཤི་ཀར་དད་པ་ནས་ཡོང་བའི་དྲང་བདེན་དེ་འཐོབ་པར་འགྱུར་ཞིང་། དྲང་བདེན་དེ་ནི་བཀའ་ཁྲིམས་ནས་བྱུང་བ་མ་ཡིན༌པར། དཀོན་མཆོག་ལས་བྱུང་ཞིང་དད་པའི་སྒོ་ནས་འཐོབ་པ་ཡིན་ལ།"]},{"type":"verse","number":10,"content":["དེ་ནི་ངས་སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཁོང་ཉིད་ངོ་ཤེས་པ་དང་། ཁོང་ཉིད་སླར་གསོན་པའི་ནུས་མཐུ་ཆེན་པོའང་རྟོགས་ཤིང༌། ཁོང་གི་སྡུག་བསྔལ་ཡང་མཉམ་དུ་འཁུར་ཐུབ་པ་དང༌། ཁོང་ཉིད་སྐུ་གྲོངས་པ་མིག་དཔེར་བཟུང༌སྟེ།"]},{"type":"verse","number":11,"content":["ང་རང་ཡང་འཆི་བ་ལས་སླར་གསོན་པར་འགྱུར་བའི་ཕྱིར་རོ།།"]},{"type":"heading","content":["དམིགས་ཡུལ་འགྲུབ་པར་བརྩོན༌པ།"]},{"type":"verse","number":12,"content":["བདག་ལ་དོན་དེ་དག་ཐོབ་ཟིན་པ་དང་ཕུལ་ཏུ་བྱུང་བ་ཡིན་ཞེས་པ་མིན༌ཏེ། མཱ་ཤི་ཀ་ཡེ་ཤུས་བདག་ལ་བསྩལ་པའི་དགོངས་དོན་དེར་སྙེག༌ཅིང༌། དོན་དེ་བསྒྲུབ་པའི་ཕྱིར་ངས་ཀྱང་བརྩོན་པ་བྱེད་དོ།།"]},{"type":"verse","number":13,"content":["སྤུན་ཟླ༌རྣམས། ངས་རང་ལ་དོན་དེ་ཐོབ་ཟིན་ཞེས་པ་མིན༌ཏེ། བདག་གིས་དོན་གཅིག་ཁོ་ན་སྒྲུབ་པ་ནི་འདས་པ་བསྐྱུར་ཞིང་མདུན་ལ་བརྩོན༌པ་ཡིན།"]},{"type":"verse","number":14,"content":["དེ་ནི་དཀོན་མཆོག་གིས་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང༌ནས། ཁོང་གིས་ང་རང་ནམ་མཁའི་བྱ་དགའ་ལེན་པར་ཞལ་སྐུལ་གནང་བ་བཞིན་བདག་ཀྱང་དམིགས་འབེན་དེའི་ཕྱོགས་སུ་རྒྱུག་པ་ཡིན་ནོ།།"]},{"type":"verse","number":15,"content":["དེའི༌ཕྱིར། བདག་ཅག་གི་ཁྲོད་ནས་བསམ་ཤེས་རྣམས་ཀྱིས་དེ་ལྟ་བུའི་བསམ་པ་རྟག་ཏུ་བཅང་དགོས༌ཤིང༌། དོན་འདི་དང་བསམ་ཚུལ་མི་མཚུངས་པ་ཡོད༌ནའང༌། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ལ་གསལ་པོར་སྟོན་པར་འགྱུར།"]},{"type":"verse","number":16,"content":["འོན༌ཀྱང༌། བདག་ཅག་ཚད་ག་འདྲ་ཞིག་ལ་སླེབས་ན་ཚད་དེ་བཞིན་དུ་བསྒྲུབ་དགོས༌སོ།།"]},{"type":"verse","number":17,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་རྣམས་ཀྱིས་མཉམ་དུ་ང་རང་མིག་དཔེར་བཟུང༌ཞིང༌། ངེད་རྣམས་མིག་དཔེར་འཛིན་མཁན་དེ་རྣམས་ལའང་མཉམ་འཇོག་བྱ་འོས།"]},{"type":"verse","number":18,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་མང་པོའི་སྤྱོད་སྟངས་ནི་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཤིང་རྒྱ་གྲམ་གྱི་དགྲ་བོ་ཡིན་པའི་ཕྱིར༌རོ།། བདག་གིས་དོན་འདི་ཁྱོད་རྣམས་ལ་ཐེངས་མང་པོར་སྨྲས་མྱོང༌ལ། ད་ལྟ་ཡང་མིག་ལས་མཆི་མ་དང་བཅས་ཏེ་སྨྲས༌པ་ཡིན།"]},{"type":"verse","number":19,"content":["མི་དེ་རྣམས་ཀྱི་མཇུག་འབྲས་ནི་རང་ཉིད་འཇིག་པར་འགྱུར་བ༌དང༌། དེ་རྣམས་ཀྱི་དཀོན་མཆོག་ནི་རང་གི་ལྟོ་བ་ཁོ་ན་ཡིན། དེ་རྣམས་ཀྱིས་རང་གི་ངོ་ཚ་ནི་གཟི་བརྗིད་དུ་བརྩི་ཞིང་འཇིག་རྟེན་གྱི་ལས་ཁོ་ན་བསམས་མོད།"]},{"type":"verse","number":20,"content":["འོན༌ཀྱང༌། བདག་ཅག་ནི་ནམ་མཁའི་ཞིང་ཁམས་ཀྱི་འབངས་མི་ཡིན༌ལ། ཡང་སྐྱབས་མགོན་ཏེ་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་ཕེབས་ཡོང་བར་རེ་བ་ཆེན་པོས་སྒུག༌པ་ཡིན།"]},{"type":"verse","number":21,"content":["ཁོང་གིས་འཇིག་རྟེན་གྱི་དངོས་པོ་ཐམས་ཅད་རང་ཉིད་ཀྱི་དབང་འོག་ཏུ་བསྡུ་ནུས་པའི་མཐུ་རྩལ་ཆེན་པོར་བརྟེན༌ནས། བདག་ཅག་གི་ལུས་པོ་ཐ་མལ་བ་འདིའི་རྣམ་པ་བསྒྱུར༌ཏེ། ཁོང་རང་ཉིད་ཀྱི་གཟི་བརྗིད་ལྡན་པའི་སྐུ་ལུས་དང་མཚུངས་པར་མཛད་ངེས༌སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PHP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PHP/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PHP/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}