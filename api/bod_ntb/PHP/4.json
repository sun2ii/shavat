{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PHP","translationId":"bod_ntb","name":"ཕི་ལིབ་པི་པ།","commonName":"ཕི་ལིབ་པི་པ།","title":"༄༅། །ཕི་ལིབ་པི་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":50,"numberOfChapters":4,"sha256":"c8150c99f2b133c93f863d15f8ee5bed919ddf7bcde400ffc98cc01675b7b050","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PHP/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/PHP/4.json","totalNumberOfVerses":103},"chapter":{"number":4,"content":[{"type":"heading","content":["སྐུལ་མ་གནང༌བ།"]},{"type":"verse","number":1,"content":["དེ་ལྟར་ཡིན་པས། བདག་གི་སྙིང་ནས་བརྩེ་ཞིང་རྟག་ཏུ་དྲན་པའི་སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་ནི་བདག་གི་དགའ་སྤྲོ་དང་གཙུག་རྒྱན་ཡིན། བདག་གི་སྙིང་ནས་བརྩེ་བ༌ལགས། ཁྱོད་རྣམས་ནི་གཙོ་བོ་ལ་བརྟེན་ནས་བརྟན་པོར་གནས་འོས་སོ།།"]},{"type":"verse","number":2,"content":["བདག་གིས་ཨོ་དི་ཡཱ་དང་སིན་ཏི་ཀེ་གཉིས༌ལ། གཙོ་བོའི་ནང་དུ་བློ་སེམས་མཐུན་དགོས་པར་སྐུལ་མ་གནང༌བ་ཡིན།"]},{"type":"verse","number":3,"content":["ངས་བློ་སེམས་དཀར་བའི་ཆོས་གྲོགས་ཁྱོད་ཀྱིས་ཀྱང་སྐྱེས་མ་འདི་གཉིས་ལ་རོགས་རམ་བྱེད་པར་བསྐུལ། རྒྱུ་མཚན་ནི་བདག་གིས་འཕྲིན་བཟང་སྤེལ་བའི་དུས༌སུ། དེ་གཉིས་ཀྱིས་བདག་དང་མཉམ་དུ་དཀའ་སྡུག་མྱངས་པ་དང་། ཡང་ཀཱ་ལེ་མེན་དང་ཆོས་གྲོགས་གཞན་རྣམས་མཉམ་དུའང་དཀའ་སྡུག་མྱངས་པས། ཚེ་སྲོག་གི་གླེགས་བམ་ནང་དུ་མི་དེ་རྣམས་ཀྱི་མིང་ཡང་བཀོད་ཡོད༌དོ།།"]},{"type":"verse","number":4,"content":["ཁྱོད་རྣམས་གཙོ་བོ་ལ་བརྟེན་ནས་རྟག་ཏུ་དགའ་ཞིང་སྤྲོ་བར༌གྱིས། ངས་ཡང་བསྐྱར་ཁྱོད་རྣམས་ལ་དགའ་ཞིང་སྤྲོ་བར་གྱིས་ཞེས་སྨྲས༌པའོ།།"]},{"type":"verse","number":5,"content":["ཁྱོད་རྣམས་ཀྱི་ཁེངས་སྐྱུང་གི་སེམས་དེ་མི་ཀུན་ལ་ཤེས་སུ་འཇུག་དགོས། གཙོ་བོ༌ཉེ་བར་བཞུགས་སོ།།"]},{"type":"verse","number":6,"content":["དོན་གང་ལའང་སེམས་ཁྲལ་མི་བྱ༌བར། དོན་ཐམས་ཅད་ཀྱི་ཆེད་དུ་གསོལ་བ་འདེབས་པ༌དང༌། སྨོན་ལམ་ཞུ༌བ། དྲིན་ལན་བརྗོད་པ་བརྒྱུད་ནས་ཁྱོད་ཅག་གི་དགོས་མཁོ་གང་ཞིག་དཀོན་མཆོག་ལ་ཞུས་དང༌།"]},{"type":"verse","number":7,"content":["མི་ཡི་བློ་ཡུལ་དུ་མི་ཤོང་བའི་དཀོན་མཆོག་གི་ཞི་བདེ་དེས། མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཁྱོད་རྣམས་ཀྱི་སེམས་དང་བསམ་པ་བསྲུང་ངེས༌སོ།།"]},{"type":"verse","number":8,"content":["སྤུན་ཟླ༌རྣམས། མཐར་ཁྱོད་རྣམས་ཀྱིས་བདེན་པ༌དང༌། གུས་པར་འོས༌པ། དྲང༌བདེན། གཙང་མར་གྱུར༌པ། གཅེས་པར་འོས༌པ། སྙན་གྲགས་རྒྱས༌པ། གཤིས་སྤྱོད་ཕུལ་དུ་བྱུང༌བ། བསྟོད་པར་འོས་པ་བཅས་པའི་དོན་གང་ཡིན་ཡང་བསམ་བློ་གཏོང་དགོས་སོ།།"]},{"type":"verse","number":9,"content":["ཁྱོད་རྣམས་ཀྱིས་བདག་ལས་གང་ཞིག་བསླབས་པ་དང་ཐོབ༌པ། གང་ཞིག་མཐོང་བ་དང་ཐོས་པ་ཐམས་ཅད་ལག་ལེན་དུ་འདེབས་པར༌གྱིས་དང་། ཞི་བདེ་གནང་མཁན་དཀོན་མཆོག་ནི་ཁྱོད་རྣམས་དང་མཉམ་དུ་བཞུགས་ངེས༌སོ།།"]},{"type":"heading","content":["དྲིན་ལན་བརྗོད༌པ།"]},{"type":"verse","number":10,"content":["ཁྱོད་རྣམས་ཀྱིས་ད་ལྟའང་བདག་གི་དོན་དུ་སེམས་ཁྲལ་བྱེད་བཞིན༌པས། ང་རང་གཙོ་བོ་ལ་བརྟེན་ནས་སེམས་སུ་དགའ་སྤྲོ་ཚད་མེད་སྐྱེས་སོ།། ཁྱོད་རྣམས་ཀྱིས་སྔར་ནས་བདག་ལ་སེམས་ཁྲལ་བྱས་ཀྱང་གོ་སྐབས་མ་བྱུང༌།"]},{"type":"verse","number":11,"content":["བདག་ལ་དགོས་མཁོ་གང་ཞིག་ཡོད་པའི་རྐྱེན་གྱིས་གཏམ་འདི་སྨྲས་པ་མིན༌ཏེ། བདག་ནི་གནས་ཚུལ་ཅི་འདྲའི་འོག་ཏུའང་རང་བློ་ཚིམ་པར་གོམས་ཡོད་ལ།"]},{"type":"verse","number":12,"content":["བདག་གིས་འབྱོར་བ་མེད་པའི་འཚོ་བ་དང་ལོངས་སྤྱོད་ཕུན་སུམ་ཚོགས་པའི་འཚོ་བ་ཅི་ལྟར་རོལ་དགོས་པ་ཤེས་ཏེ། རང་གི་ལྟོ་བ་འགྲངས་པའམ་ལྟོགས༌པ། རྒྱུ་ནོར་འཛོམས་པའམ་ཕོངས་པ་བཅས་དོན་གང་ཞིག་བྱུང༌ཡང༌། བདག་ནི་གོམས་པར་གྱུར་ཡོད།"]},{"type":"verse","number":13,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བདག་གིས་རང་ལ་ནུས་མཐུ་གནང་མཁན་སྐྱབས་མགོན་ཡེ་ཤུར་བརྟེན་ནས་དོན་ཐམས་ཅད་བསྒྲུབ་ནུས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":14,"content":["འོན༌ཀྱང༌། ཁྱོད་རྣམས་ཀྱིས་བདག་དང་ལྷན་དུ་དཀའ་སྡུག་མྱོང་ཐུབ་པ་ནི་དོན་ལེགས་པོ་ཞིག་ཡིན་ནོ།།"]},{"type":"verse","number":15,"content":["ཕི་ལིབ་པི་པ༌རྣམས། བདག་གིས་ཐོག་མར་འཕྲིན་བཟང་བསྒྲགས་པའི་དུས༌དེར། མ་ཀེ་དོན་ཡཱ་ཡུལ་དང་ཁ་བྲལ་བའི་དུས་སུ། ཁྱོད་ཅག་གི་ཆོས་ཚོགས་ལས༌གཞན། ཆོས་ཚོགས་གང་གིས་ཀྱང་བདག་ལ་འབུལ་བ་མ་གནང་བ་ནི་ཁྱོད་རྣམས་ཀྱིས་ཤེས་སོ།།"]},{"type":"verse","number":16,"content":["ང་རང་ཐེ་སཱ་ལོ་ནེ་ཀེར་ཡོད་པའི་དུས༌སུའང༌། ཁྱོད་རྣམས་ཀྱིས་ཐེངས་འགར་མི་མངགས་ཏེ་ངའི་དགོས་མཁོ་བཞིན་དུ་འབུལ་བ་གནང་མྱོང༌།"]},{"type":"verse","number":17,"content":["ད༌ལྟ་བདག་གིས་འབུལ་བར་དམིགས་པ་མ་ཡིན་པར། ཁྱོད་རྣམས་ཀྱི་ལས་བཟང་པོའི་འབྲས་བུ་རིམ་བཞིན་ཇེ་མང་དུ་འགྱུར༌ཞིང༌། ཁྱོད་ཅག་གི་རྩིས་ཐོའི་སྟེང་དུ་འགོད་རྒྱུ་ཡོད་པར་དམིགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":18,"content":["འོན༌ཀྱང༌། བདག་ལ་ཐམས་ཅད་འཛོམས་ཤིང་ལྷག་མའང་ཡོད་དེ་རང་བློའང་ཚིམས༌པ་ཡིན། བདག་གིས་ཨེ་པབ་རོ་དི་ཡིས་བསྐྱལ་ཡོང་བའི་ཁྱོད་ཅག་གི་འབུལ་བ་བླངས༌ཤིང༌། དེ་ནི་དཀོན་མཆོག་ལ་དྲི་ཞིམ་གྱི་འབུལ་བ་དང་ཐུགས་དགྱེས་པའི་མཆོད་པ་ཕུལ་བ་དང་མཚུངས་སོ།།"]},{"type":"verse","number":19,"content":["བདག་གི་དཀོན་མཆོག་གིས་ཁོང་ཉིད་ཀྱི་ཕུན་སུམ་ཚོགས་པའི་གཟི་བརྗིད་ཇི་བཞིན༌དུ། མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་ཁྱོད་ཅག་གི་དགོས་མཁོ་ཐམས་ཅད་བསྐང་ངེས༌ཡིན།"]},{"type":"verse","number":20,"content":["བདག་ཅག་གི་ཡབ་དཀོན་མཆོག་ལ་ཇི་སྲིད་བར་དུ་བསྟོད་བསྔགས་བརྗོད་པར༌ཤོག ཨ༌མེན།"]},{"type":"heading","content":["མཇུག་མཐའི་འཚམས༌ཞུ།"]},{"type":"verse","number":21,"content":["ཁྱོད་རྣམས་ཀྱིས་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་གི་དད་ལྡན་དམ་པ་ཐམས་ཅད་ལའང་འཚམས་འདྲི་ཞུ་བར་བྱའོ།། བདག་གི་གམ་དུ་ཡོད་པའི་སྤུན་ཟླ་རྣམས་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་ལ་འཚམས་འདྲི༌ཞུའོ།།"]},{"type":"verse","number":22,"content":["འདིར་ཡོད་པའི་དད་ལྡན་དམ་པ་ཐམས་ཅད་ཀྱིས་ཀྱང་ཁྱོད་རྣམས་ལ་འཚམས་འདྲི༌ཞུའོ།། ལྷག་པར་སེ་བཟིར་གྱི་ཕོ་བྲང་ནང་དུ་ཡོད་པ་རྣམས་ཀྱིས་ཀྱང་ཆེད་དུ་ཁྱོད་ཅག་ལ་འཚམས་འདྲི༌ཞུའོ།།"]},{"type":"verse","number":23,"content":["གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཐུགས་རྗེ་ནམ་ཡང་ཁྱོད་ཅག་གི་སེམས་སུ་གནས་པར༌སྨོན།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PHP/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/COL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PHP/3.json","previousChapterAudioLinks":{},"numberOfVerses":23}