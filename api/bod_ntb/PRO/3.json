{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PRO","translationId":"bod_ntb","name":"ལེགས་བཤད།","commonName":"ལེགས་བཤད།","title":"༄༅།།ལེགས་བཤད་ཀྱི༌མདོ།","order":20,"numberOfChapters":31,"sha256":"b9795febc636fe467a3f65fc38dcfaf4c60beb55fe0b5852e623335f70fb2bbf","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bod_ntb/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["ན་གཞོན་རྣམས་ལ་གནང་བའི་བསླབ༌བྱ།"]},{"type":"verse","number":1,"content":["བདག་གི་བུ་ལགས་ང་ཡི་བསླབ་བྱ་བརྗེད་མི༌རུང༌། །ཁྱོད་ཀྱི་སེམས་ཀྱིས་ང་ཡི་བཀའ་རྒྱ་ནན་གྱིས་རྩིས།།"]},{"type":"verse","number":2,"content":["གང་ལ་ཞེ་ན་དེ་དག༌གིས། །ཚེ་རིང་ན་སོ་ཆེ་བ༌དང༌། །ཞི་བདེ་ཁྱོད་ལ་སྣོན་པར༌འགྱུར།།"]},{"type":"verse","number":3,"content":["བྱམས་བརྩེ་དང་ནི་བདེན་པ༌ཉིད། །ཁྱོད་དང་འབྲལ་བར་མི་བྱ༌ཞིང༌། །དེ་གཉིས་རང་གི་སྐེར་བཏགས༌ནས། །སྙིང་གི་བྱང་བུའི་སྟེང་དུ༌ཕྲིས།།"]},{"type":"verse","number":4,"content":["དེ་ནས་དཀོན་མཆོག་དང་ནི་མི་གཉིས༌ཀའི། །སྤྱན་སྔར་ཐུགས་རྗེ་མཚན་སྙན་ཁྱོད་ལ༌འཐོབ།།"]},{"type":"verse","number":5,"content":["ཁྱོད་ཀྱིས་བློ་གཅིག་སེམས་གཅིག༌གིས། །ཡ་ཝཱེ་ཁོང་ལ་བློ་གཏོད༌ཅིག །རང་གི་རིག་པར་མ་བརྟེན༌ཞིག།"]},{"type":"verse","number":6,"content":["རང་ཉིད་འགྲོ་བའི་ལམ་ཀུན༌དུ། །ཁོང་ཉིད་ཁས་ནི་ལེན་པར༌གྱིས། །ཁོང་གིས་ཁྱོད་ཀྱི་བགྲོད་ལམ༌ནི། །བདེ་ཞིང་དྲང་བར་མཛད་ངེས༌ཡིན།།"]},{"type":"verse","number":7,"content":["རང་ཉིད་མཁས་པ་ཡིན་པར་མ་འདོད༌ཅིག །ཡ་ཝཱེ་ལ་ནི་གུས་ཤིང་འཇིགས་པར༌གྱིས། །ངན་པའི་ལས་དང་རིང་དུ་བྲལ་གྱུར༌ཅིག།"]},{"type":"verse","number":8,"content":["དེས་ནི་ཁྱོད་ཀྱི་ལུས་པོ་བདེ་བ༌དང༌། །ཁྱོད་ཀྱི་རུས་ཟུངས་གསོ་བར་འགྱུར་བ༌འོ།།"]},{"type":"verse","number":9,"content":["ཁྱོད་ཀྱིས་རང་གི་རྒྱུ་ནོར༌དང༌། །ལོ་ཏོག་ཀུན་གྱི་ཐོག་ཕུད༌ཀྱིས། །ཡ་ཝཱེ་ལ་ནི་བསྙེན་བཀུར༌གྱིས།།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཁྱོད་ཀྱི་བང་མཛོད་བལྟམ་ངེས་ཤིང་། །རྒུན་ཆང་གསར་པས་འཚིར་གཞོང་གང་བར༌འགྱུར།།"]},{"type":"verse","number":11,"content":["ངའི་བུ་ཡ་ཝཱེའི་འཆུན་འདོམས་ཁྱད་མ་གསོད། །ཁོང་གི་བཀའ་བཀྱོན་ལ་ཡང་སུན་མི༌རུང༌།།"]},{"type":"verse","number":12,"content":["དེ་ནི་གང་གི་ཕྱིར་དུ་ཡིན་ཞེ༌ན། །ཕ་ཡིས་རང་གི་གཅེས་པའི་བུ་ལ༌ནི། །གཤེ་གཤེ་གཏོང་བ་ནང་བཞིན་ཡ་ཝཱེས༌ཀྱང༌། །གཅེས་པ་རྣམས་ལ་བཀའ་བཀྱོན་གནང་ཕྱིར༌རོ།།"]},{"type":"verse","number":13,"content":["ཤེས་རབ་རྙེད་པའི་སྐྱེས་བུ༌དང༌། །བློ་གྲོས་ཐོབ་མཁན་བདེ་ཞིང༌སྐྱིད།།"]},{"type":"verse","number":14,"content":["དེ་ནི་ཅིའི་ཕྱིར་ཡིན་ཞེ༌ན། །ཤེས་རབ་ལས་ཐོབ་ཁེ་སྤོགས༌ནི། །དངུལ་གྱི་ཁེ་སྤོགས་ལས་ཀྱང༌མཆོག །ཁོ་མོ་",{"noteId":0},"ལས་ཐོབ་ཡོང་འབབ༌ནི། །གསེར་གྱི་ཡོང་འབབ་ལས་ཀྱང༌འཕགས།།"]},{"type":"verse","number":15,"content":["པད་མ་ར་ག་ལས་ཀྱང་ཁོ་མོ་རིན་ཐང༌ཆེ། །ཁྱོད་ཀྱིས་གང་འདོད་ཐམས་ཅད་དེ་དང་མཚུངས་ཟླ༌བྲལ།།"]},{"type":"verse","number":16,"content":["ཁོ་མོའི་ཕྱག་གཡས་སྐུ་ཚེ་རིང་བ༌དང༌། ཁོ་མོའི་ཕྱག་གཡོན་རྒྱུ་དང་བཀུར་སྟི༌མངའ།།"]},{"type":"verse","number":17,"content":["ཁོ་མོའི་གཤེགས་ལམ་རྣམས་ནི་དགའ་བདེའི༌ལམ། །ཁོ་མོའི་ཕེབས་ལམ་ཐམས་ཅད་ཞི་བདེ༌ཡིན།།"]},{"type":"verse","number":18,"content":["ཁོ་མོ་དམ་པོར་འཛིན་པ་རྣམས་ལ༌ནི། །ཁོ་མོ་སྲོག་གི་ལྗོན་ཤིང་ཡིན་པ༌དང༌། །ཁོ་མོ་དམ་པོར་འཆིང་བ་ཐམས་ཅད༌བདེ།།"]},{"type":"verse","number":19,"content":["ཡ་ཝཱེས་ཤེས་རབ་ཀྱིས་ནི་ས་གཞིའི་རྨང་བཏིངས་ཤིང་། །མཁྱེན་རབ་ཀྱིས་ནི་ནམ་མཁའ་བརྟན་པོར་མཛད་པ༌ལགས།།"]},{"type":"verse","number":20,"content":["ཁོང་གི་མཁྱེན་པས་རྒྱ་མཚོའི་གཏིང་འོག༌ཕྲལ། །ནམ་མཁའ་ལས་ཀྱང་བདུད་རྩི་འབབ་པ༌ཡིན།།"]},{"type":"verse","number":21,"content":["ངའི་བུ་ཁྱོད་ཀྱིས་ཤེས་རབ་དངོས་མ༌དང༌། །ཤན་འབྱེད་བློ་ནི་ནན་གྱིས་བསྲུངས་ནས༌ནི། །དེ་དག་རང་གི་མཐོང་རྒྱར་འབྲལ་མི༌བྱ།།"]},{"type":"verse","number":22,"content":["དེ་ནས་དེ་དག་ཁྱོད་ཀྱི་ཚེ་སྲོག༌དང༌། །མགུལ་གྱི་རྒྱན་དུ་ཡང་ནི་འགྱུར་ངེས༌ཤིང༌།།"]},{"type":"verse","number":23,"content":["ཁྱོད་རང་ལམ་དུ་བདེ་བར་འགྲོ་བ༌དང༌། །གོམ་པ་ཡང་ནི་འཁྱོར་བར་མི་འགྱུར༌རོ།།"]},{"type":"verse","number":24,"content":["ཁྱོད་རང་སྙེ་བའི་དུས་སུ་འཇིགས་མི༌འགྱུར། །མལ་དུ་ཉལ་དུས་བདེ་བའི་གཉིད་དུ༌ཡུར།།"]},{"type":"verse","number":25,"content":["གློ་བུར་བྱུང་བའི་འཇིགས་པར་མ་སྐྲག༌ཅིག །མི་ངན་རྩ་མེད་གཏོང་དུས་མ་དངངས༌ཤིག།"]},{"type":"verse","number":26,"content":["ཡ་ཝཱེ་ཁོང་ཉིད་ཁྱོད་ཀྱི་བརྟེན་ས༌ཡིན། །ཁྱོད་ཀྱི་རྐང་པ་རྙི་རྒྱར་མི་ཚུད༌ཆེད། །ཁོང་གིས་བསྲུང་བར་འགྱུར་བའི་ཕྱིར་དུ༌ཡིན།།"]},{"type":"verse","number":27,"content":["ཁྱོད་ཀྱི་ལག་པའི་ནང་དུ་དྲིན་བྱེད༌པའི། །དབང་ཡོད་རིང་ལ་གཡོལ་ཐབས་མི་བྱེད༌པར། །རོགས་རམ་མཁོ་བ་རྣམས་ལ་དྲིན་གཟོས༌ཤིག།"]},{"type":"verse","number":28,"content":["ཅི་སྟེ་ཁྱོད་ཀྱི་ལག་ཏུ་ཡོད་དུས༌སུ། །རང་གི་ཁྱིམ་མཚེས་ལ་ནི་ད་སོང༌ཞིག །སང་ཉིན་ཤོག་དང་ངས་ཁྱོད་སྦྱིན་མ༌ཟེར།།"]},{"type":"verse","number":29,"content":["ཁྱིམ་མཚེས་ཁྱོད་རྩར་བདེ་བར་སྡོད་པའི༌ཚེ། །ཇུས་ངན་བཏབ་ནས་དེ་ལ་འཚེ་མི༌རུང༌།།"]},{"type":"verse","number":30,"content":["ཁྱོད་ལ་གནོད་པ་བསྐྱལ་བ་མིན་ན༌ནི། །སུ་ཞིག་ལ་ཡང་དོན་མེད་འཁྲུག་མི༌བྱ།།"]},{"type":"verse","number":31,"content":["གདུག་རྩུབ་ཅན་ལ་ཕྲག་དོག་མ་བསྐྱེད༌ཅིག །དེ་ཡི་ལམ་ནི་གང་ཡང་འདེམས་མི༌རུང༌།།"]},{"type":"verse","number":32,"content":["དེ་ནི་ལོག་ལམ་ཕྱིན་པ༌ལ། །ཡ་ཝཱེ་ཐུགས་ནས་ཞེན་ལོག༌ཅིང༌། །གཞུང་རྒྱུད་དྲང་བའི་མི་རྣམས༌ལ། །ཁོང་གིས་སྙིང་ནས་བརྩེ་ཕྱིར༌རོ།།"]},{"type":"verse","number":33,"content":["མི་ངན་ཁྱིམ་ལ་ཡ་ཝཱེའི་དམོད་པ༌ཐེབས། །དྲང་པོའི་ཁྱིམ་ལ་ཁོང་གིས་བྱིན་རླབས༌གནང༌།།"]},{"type":"verse","number":34,"content":["འཕྱ་མཁན་རྣམས་ལ་ཁོང་གིས་འཕྱ་བར༌མཛད། །འོན་ཀྱང་སྙེམས་ཆུང་མི་ལ་ཐུགས་རྗེས༌གཟིགས།།"]},{"type":"verse","number":35,"content":["ཤེས་རབ་ཅན་ལ་བཀུར་སྟི་མངའ་འགྱུར༌ཡང༌། །གླེན་པ་རྣམས་ནི་ངོ་ཚར་ལྷུང་བར༌འགྱུར།།"]}],"footnotes":[{"noteId":0,"caller":"+","text":"འདིར་ཁོ་མོ་ཞེས་པ་ནི་གོང་གི་ཤེས་རབ་ལ་གོ་བ་དང་། ཞོལ་ནས་འབྱུང་བའི་ཁོ་མོ་ཞེས་པ་ཡང་དེ་བཞིན་ཡིན།","reference":{"chapter":3,"verse":14}}]},"thisChapterLink":"/api/bod_ntb/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}