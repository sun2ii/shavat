{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":100,"content":[{"type":"heading","content":["བསྙེན་བཀུར་ཞུ་བའི་མགུར་མ།"]},{"type":"verse","number":1,"content":["༼གཏང་རག་འབུལ་བའི་གསུང༌མགུར།༽ གནམ་འོག་ཀུན་གྱིས་ཡ་ཝཱེར་དགའ་འབོད༌གྱིས།།"]},{"type":"verse","number":2,"content":["དགའ་སྣང་དང་བཅས་ཡ་ཝཱེར་ཞབས་ཏོག༌སྒྲུབས། །དགའ་སྤྲོའི་མགུར་མ་ལེན་བཞིན་ཁོང་དྲུང༌ཤོག།"]},{"type":"verse","number":3,"content":["ཡ་ཝཱེ་དཀོན་མཆོག་ལགས་པ་ཤེས་གྱུར༌ཅིག །རང་ཅག་ཁོང་གིས་མཛད་ཅིང་ཁོང་ལ༌གཏོགས། །ཁོང་གི་རྩྭ་ཁའི་ལུག་དང་མི་སྡེ་ཡིན།།"]},{"type":"verse","number":4,"content":["བཀའ་དྲིན་དྲན་བཞིན་ཁོང་གི་རྒྱལ་སྒོ༌དང༌། །བསྟོད་པ་དང་བཅས་ཁོང་གི་ཁྱམས་རར༌ཞུགས། །གཏང་རག་འབུལ་ཞིང་ཁོང་གི་མཚན་ལ༌བསྟོད།།"]},{"type":"verse","number":5,"content":["ཡ་ཝཱེ་ཡོངས་སུ་ལེགས་ཤིང་ཁོང་ཉིད༌ཀྱི། །བྱམས་དང་བརྩེ་བ་རྒྱུན་ནས་རྒྱུན་དུ༌གནས། །ཁོང་གི་དྲང་བདེན་མི་རབས་ཀུན་ལ༌གནས།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/99.j