{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":107,"content":[{"type":"heading","content":["བླུས་པའི་འབངས་རྣམས་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེར་གཏང་རག་འབུལ་བ།"]},{"type":"verse","number":1,"content":["ཡ་ཝཱེ་ལེགས་པས་ཁོང་ལ་གཏང་རག༌ཕུལ། །ཁོང་གི་བྱམས་བརྩེ་རྒྱུན་ནས་རྒྱུན་དུ༌གནས།།"]},{"type":"verse","number":2,"content":["དེ་ལྟར་ཡ་ཝཱེས་བླུས་པ་རྣམས་ཀྱིས༌ཞུས། །འབངས་འདི་ཁོང་གིས་དགྲ་ཡི་ལག་ནས༌བསྒྲལ།།"]},{"type":"verse","number":3,"content":["ཤར་ལྷོ་ནུབ་བྱང་ཡུལ་ཕྱོགས་ཀུན་ནས༌བསྡུས།།"]},{"type":"verse","number":4,"content":["ཁོ་ཚོ་ས་སྟོང་ལུང་སྟོང་དག་ཏུ༌ཉུལ། །གནས་སའི་གྲོང་ཁྱེར་གང་ཡང་མ་རྙེད༌པར།།"]},{"type":"verse","number":5,"content":["བཀྲེས་སྐོམ་མྱངས་ནས་སེམས་ཀྱང་རྒུད་པར༌གྱུར།།"]},{"type":"verse","number":6,"content":["སྡུག་བསྔལ་ཁྲོད་དུ་ཡ་ཝཱེར་འོ་དོད༌བོས། །ཁོང་གིས་དེ་རྣམས་དཀའ་སྡུག་དག་ལས༌བསྐྱབས།།"]},{"type":"verse","number":7,"content":["ཁོ་རྣམས་གཞིས་ཆགས་གྲོང་དུ་བསླེབ་པའི༌ཕྱིར། །ཁོང་གིས་དེ་རྣམས་དྲང་པོའི་ལམ་དུ༌ཁྲིད།།"]},{"type":"verse","number":8,"content":["ཡ་ཝཱེའི་བྱམས་བརྩེ་དང་ནི་མི་བུ༌ཚོར། །མཛད་པའི་ངོ་མཚར་དོན་ཕྱིར་བསྟོད་པར༌ཤོག །"]},{"type":"verse","number":9,"content":["ཁོང་གིས་སྐོམ་པའི་མི་རྣམས་ངོམས་མཛད༌ཅིང༌། །བཀྲེས་པ་རྣམས་ཀྱང་བཟང་པོས་ཚིམ་པར༌བཅུག།"]},{"type":"verse","number":10,"content":["འགའ་ཤས་མུན་ནག་འཆི་བའི་སྨག་རུམ༌དུ། །སྡུག་བསྔལ་དང་ནི་ལྕགས་སྒྲོག་གིས་བཅིངས༌ཏེ།།"]},{"type":"verse","number":11,"content":["ཁོ་རྣམས་དཀོན་མཆོག་བཀའ་ལས་འགལ་བ༌དང༌། །བླ་མེད་ཞལ་གདམས་སྣང་མེད་བསྐྱུར་བས༌སོ།།"]},{"type":"verse","number":12,"content":["དེའི་ཕྱིར་ཁོང་གིས་དཀའ་བའི་ལས་ལ༌བརྟེན། །དེ་རྣམས་སེམས་ནི་བཏུལ་ཞིང་སར་འགྱེལ༌ཡང༌། །རོགས་རམ་བྱེད་མཁན་སུ་ཡང་ཡོད་མ་ཡིན།།"]},{"type":"verse","number":13,"content":["སྡུག་བསྔལ་ཁྲོད་དུ་ཡ་ཝཱེར་འོ་དོད༌བོས། །ཁོང་གིས་དེ་རྣམས་དཀའ་སྡུག་དག་ལས༌བསྐྱབས།།"]},{"type":"verse","number":14,"content":["མུན་ནག་དང་ནི་འཆི་བའི་སྨག་རུམ༌ལས། །ཕྱི་རུ་བཏོན་ཞིང་དེ་ཚོའི་སྒྲོག་རྣམས༌བཅད།།"]},{"type":"verse","number":15,"content":["ཡ་ཝཱེའི་བྱམས་བརྩེ་དང་ནི་མི་བུ༌ཚོར། །མཛད་པའི་ངོ་མཚར་དོན་ཕྱིར་བསྟོད་པར༌ཤོག །"]},{"type":"verse","number":16,"content":["ཁོང་གིས་ལི་ཡི་རྒྱ་སྒོ་བཅག་ནས༌ནི། །ལྕགས་ཀྱི་སྒོ་གཏན་རྣམས་ཀྱང་བཅད་ཕྱིར༌རོ།།"]},{"type":"verse","number":17,"content":["གླེན་པ་རྣམས་ཀྱིས་རང་གི་ཉེས་སྐྱོན༌དང༌། །སྡིག་པའི་ལས་ཀྱི་ཕྱིར་དུ་སྡུག་བསྔལ༌མྱོང༌།།"]},{"type":"verse","number":18,"content":["ཁ་ཟས་ཀུན་ལ་ཁོ་རྣམས་སྐྱུག་མེར༌ལངས། །འཆི་བའི་སྒོ་ལ་ཉེ་བར་སླེབས་པ༌དང༌།།"]},{"type":"verse","number":19,"content":["སྡུག་བསྔལ་ཁྲོད་དུ་ཡ་ཝཱེར་འོ་དོད༌བོས། །ཁོང་གིས་དེ་རྣམས་དཀའ་སྡུག་དག་ལས༌བསྐྱབས།།"]},{"type":"verse","number":20,"content":["བཀའ་གསུང་གནང་ནས་དེ་རྣམས་གསོས་པ༌དང༌། །འཆི་བ་ལས་ཀྱང་དེ་རྣམས་བསྒྲལ་བ༌ཡིན།།"]},{"type":"verse","number":21,"content":["ཡ་ཝཱེའི་བྱམས་བརྩེ་དང་ནི་མི་བུ༌ཚོར། །མཛད་པའི་ངོ་མཚར་དོན་ཕྱིར་བསྟོད་པར༌ཤོག།"]},{"type":"verse","number":22,"content":["ཁོང་ལ་གཏང་རག་མཆོད་པར་འབུལ་བ༌དང༌། །སྤྲོ་གླུས་ཁོང་གི་མཛད་འཕྲིན་འཆད་གྱུར༌ཅིག།"]},{"type":"verse","number":23,"content":["འགའ་ཤས་གྲུ་གཟིངས་བསྡད་ནས་རྒྱ་མཚོར༌བསྐྱོད། །ཆུ་ཆེན་སྟེང་ནས་ཉོ་འཚོང་ལས་ལ༌བྲེལ།།"]},{"type":"verse","number":24,"content":["དེ་ཚོས་རྒྱ་མཚོར་ཡ་ཝཱེའི་མཛད་པ༌དང༌། །ཉིད་ཀྱི་ངོ་མཚར་དོན་རྣམས་མཐོང་གྱུར༌ཏེ།།"]},{"type":"verse","number":25,"content":["ཁོང་གིས་བཀའ་ཞིག་བབས་པར་རླུང་དམར༌གཡུགས། །རྒྱ་མཚོའི་རྦ་རླབས་གྱེན་དུ་འཕྱུར་བར༌མཛད།།"]},{"type":"verse","number":26,"content":["དེ་རྣམས་ནམ་མཁར་འཛེགས་ཤིང་གཏིང་ལ༌བབས། །ཉེན་ཚབ་རྐྱེན་གྱིས་དེ་ཚོའི་སྙིང་སྟོབས་ཞུམ།།"]},{"type":"verse","number":27,"content":["ཆང་གིས་བཟི་བའི་མི་ལྟར་འཁྱོར་བ༌དང༌། །ཕར་གཡོ་ཚུར་གཡོ་བྱེད་ཅིང་དེ་དག༌གི །རིག་པ་ཡོད་ཚད་ཕན་ཐོགས་མེད་པར༌གྱུར།།"]},{"type":"verse","number":28,"content":["སྡུག་བསྔལ་ཁྲོད་དུ་ཡ་ཝཱེར་འོ་དོད༌བོས། །ཁོང་གིས་དེ་རྣམས་དཀའ་སྡུག་དག་ལས༌བསྐྱབས།།"]},{"type":"verse","number":29,"content":["ཁོང་གིས་རླུང་དམར་གཡུགས་མཚམས་བཅད་པ༌དང༌། །རྒྱ་མཚོའི་རྦ་རླབས་ཞི་བར་གྱུར་པ༌འོ།།"]},{"type":"verse","number":30,"content":["ཞི་འཇགས་འོངས་པས་ཁོ་རྣམས་དགའ་གྱུར༌ཅིང་། །ཡིད་སྨོན་འཆོར་བའི་གྲུ་ཁར་སྐྱེལ་མ༌མཛད།།"]},{"type":"verse","number":31,"content":["ཡ་ཝཱེའི་བྱམས་བརྩེ་དང་ནི་མི་བུ༌ཚོར། །མཛད་པའི་ངོ་མཚར་དོན་ཕྱིར་བསྟོད་པར༌ཤོག།"]},{"type":"verse","number":32,"content":["དེ་ཚོས་མི་སྡེའི་ཚོགས་ནང་ཁོང་བསྟོད༌ཅིང༌། །རྒན་པའི་ཚོགས་ནང་ཁོང་ལ་བསྔགས་པར༌ཤོག།"]},{"type":"verse","number":33,"content":["ཁོང་གིས་གཙང་པོ་རྣམས་ནི་ཐང་སྟོང༌མཛད། །ཆུ་མིག་རྣམས་ཀྱང་སྐམ་སར་བསྒྱུར་པ༌ཡིན།།"]},{"type":"verse","number":34,"content":["བཅུད་བཟང་ཡུལ་གྱི་མི་རྣམས་ངན་པའི༌ཕྱིར། །ཁོང་གིས་ཡུལ་དེ་བ་ཚྭའི་ཐང་དུ༌མཛད།།"]},{"type":"verse","number":35,"content":["ཁོང་གིས་ཐང་སྟོང་རྫིང་བུར་བསྒྱུར་པ༌དང༌། །སྐམ་ས་ཡང་ནི་ཆུ་མིག་རྣམས་སུ༌མཛད།།"]},{"type":"verse","number":36,"content":["ཁོ་རྣམས་གནས་སའི་གྲོང་ཞིག་བརྩིག་པའི༌ཕྱིར། །ཁོང་གིས་བཀྲེས་པའི་མི་རྣམས་གནས་དེར༌བཀོད།།"]},{"type":"verse","number":37,"content":["ཞིང་རྣམས་རྨོས་ཤིང་རྒུན་ཚལ་བཙུགས་པ༌དང༌། །ལོ་ཡག་སྟོན་ཐོག་དེ་ཚོར་ཐོབ་གྱུར༌ཏོ།།"]},{"type":"verse","number":38,"content":["ཁོང་གིས་དེ་ཚོར་བྱིན་རླབས་གནང་ནས༌ནི། །དེ་ཚོའི་མི་གྲངས་མང་དུ་སྤེལ་བ༌དང༌། །དེ་ཚོའི་སྒོ་ཟོག་ཀྱང་ནི་འཕྲི་མ༌མཛད།།"]},{"type":"verse","number":39,"content":["ཕྱིས་སུ་དེ་རྣམས་གཉའ་གནོན་དཀའ་སྡུག༌དང༌། །སེམས་ཁྲལ་བཅས་ཀྱིས་མི་གྲངས་བྲི་ཞིང༌རྒུད།།"]},{"type":"verse","number":40,"content":["ཁོང་གིས་སྐུ་དྲག་རྣམས་ནི་ངོ་ཚར༌སྦྱར། །དེ་རྣམས་ལམ་མེད་ཐང་སྟོང་རྒྱུ་བར༌མཛད།།"]},{"type":"verse","number":41,"content":["དབུལ་པོ་སྡུག་ལས་བསྒྲལ་ཞིང་མཐོ་སར༌བཞག །དེ་ཚོའི་ཁྱིམ་རྒྱུད་ལུག་ཁྱུ་བཞིན་དུ༌སྤེལ།།"]},{"type":"verse","number":42,"content":["དྲང་པོས་མཐོང་ནས་དགའ་མགུ་ཡི་རངས༌ཤིང༌། །མི་ངན་ཐམས་ཅད་ངག་མེད་ལྐུགས་པར༌ལུས།།"]},{"type":"verse","number":43,"content":["ཤེས་རབ་ཅན་གྱིས་འདི་ལ་མཉམ་འཇོག༌ཅིང༌། །ཡ་ཝཱེའི་བྱམས་བརྩེ་ལ་ནི་བསམ་བློ༌ཐོངས།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}