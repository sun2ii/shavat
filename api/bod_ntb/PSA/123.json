{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":123,"content":[{"type":"heading","content":["གཙོ་བོའི་སྙིང་རྗེ་འཚོལ་བ།"]},{"type":"verse","number":1,"content":["༼ཡར་གནས་མཇལ་དུ་འགྲོ་བའི་མགུར༌མ།༽ ནམ་མཁའི་ཁྲི་ལ་བཞུགས་པའི་གཙོ་བོ༌ལགས། །ང་ཡི་མིག་ཟུང་ཁྱེད་ཀྱི་ཕྱོགས་སུ༌འདེགས།།"]},{"type":"verse","number":2,"content":["གཟིགས་དང་ཞབས་ཕྱིའི་མིག་གིས་བདག་པོའི༌ཕྱག །བྲན་མོའི་མིག་གིས་བདག་མོའི་ཕྱག་ལ༌ལྟ། །དེ་དང་དེ་བཞིན་ང་ཚོའི་མིག་གིས༌ཀྱང༌། །རང་ཅག་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ཚོ༌ལ། །སྙིང་རྗེ་གནང་བའི་བར་དུ་ཁོང་ལ༌བལྟ།།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་སྨད་ར་ཚད་མེད་མྱངས་པས༌ན། །ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ང་ཚོར་སྙིང་རྗེ༌གནོངས། །ཁྱེད་ཀྱིས་ང་ཚོར་སྙིང་རྗེ་གནང་བར༌མཛོད།།"]},{"type":"verse","number":4,"content":["བདེ་བར་གནས་པ་རྣམས་ཀྱིས་འཕྱ་སྨོད༌བྱེད། །ང་རྒྱལ་ཅན་གྱིས་སྨད་ར་ཚད་མེད༌བཏང༌།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerse