{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":125,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེའི་མི་རྣམས་ཀྱི་བདེ་འཇགས།"]},{"type":"verse","number":1,"content":["༼ཡར་གནས་མཇལ་དུ་འགྲོ་བའི་མགུར༌མ།༽ ཡ་ཝཱེར་བློ་གཏད་བཅོལ་བའི་མི་རྣམས༌ནི། །འགྱིང་ངེར་ལངས་པའི་རི་བོ་ཛ་ཡན༌འདྲ།།"]},{"type":"verse","number":2,"content":["ཡེ་རུ་སཱ་ལེམ་རི་ཡིས་བསྐོར་བ༌ལྟར། །ད་ལྟའི་དུས་ནས་ཇི་སྲིད་འཚོ་བའི༌བར། །ཡ་ཝཱེས་ཁོང་གི་འབངས་མི་དེ་བཞིན༌བསྐོར།།"]},{"type":"verse","number":3,"content":["དྲང་པོས་ཉེས་པར་ལག་པ་མི་བརྐྱང༌ཕྱིར། །ངན་པའི་འཁར་བ་དྲང་བདེན་མི་རྣམས༌ཀྱི། །ས་སྐལ་སྟེང་དུ་དུས་རྒྱུན་གནས་མི༌འགྱུར།།"]},{"type":"verse","number":4,"content":["བཟང་པོ་རྣམས་དང་གཞུང་དྲང་མི་རྣམས༌ལ། །ཡ་ཝཱེ་ཁྱེད་ཀྱིས་བཀའ་དྲིན་མཛད་དུ༌གསོལ།།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་འཁྱོག་པོའི་ལམ་ནང་སྐྱོད་པ༌རྣམས། །ཡ་ཝཱེས་སྡིག་སྤྱོད་མཉམ་དུ་འཁྲིད་པར༌འགྱུར། །ཡེས་ར་ཨེལ་སྟེང་ཞི་བདེ་འབབ་པར༌སྨོན།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}