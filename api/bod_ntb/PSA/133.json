{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":133,"content":[{"type":"heading","content":["སྤུན་ཟླ་ཕན་ཚུན་བྱམས་པའི་བསྟོད་པ།"]},{"type":"verse","number":1,"content":["༼ཡར་གནས་མཇལ་དུ་འགྲོ་བའི་དཱ་བིད་ཀྱི་མགུར༌མ།༽ ལྟོས་དང་ཁྱོད་ཅག་སྤུན་ཟླ་རྣམས་ནི་མཐུན་སྒྲིལ༌ངང༌། །མཉམ་དུ་སྡོད་པ་ཇི་འདྲའི་མཛེས་ཤིང་སྐྱིད་པ༌ལ།།"]},{"type":"verse","number":2,"content":["དེ་ནི་ཨ་རོན་མགོ་ལ་རིན་ཆེན་སྣུམ་བྱུགས༌ཏེ། །ཨག་ཚོམ་དང་ནི་གོས་ཀྱི་གོང་བར་བཞུར་བ༌བཞིན།།"]},{"type":"verse","number":3,"content":["ཧེར་མོན་ཟིལ་པ་ཛ་ཡན་རི་ལ་བབས་པ༌བཞིན། །གནས་དེར་ཡ་ཝཱེས་གནང་བའི་བྱིན་རླབས་ལྡན་པ༌སྟེ། །ཟད་མཐའ་མེད་པའི་ཚེ་སྲོག་དེ་ཉིད་མཆིས་ཕྱིར༌རོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}