{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":18,"content":[{"type":"heading","content":["དཱ་བིད་རྣམ་པར་རྒྱལ་བའི་མགུར་མ།"]},{"type":"verse","number":1,"content":["༼དབུ་མཛད་ལ་སྤྲད་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཞབས་ཕྱི་དཱ་བིད་ཀྱི་མགུར་མ༌སྟེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོང་སོ་ལོ་དང་དགྲ་བོ་ཐམས་ཅད་ཀྱི་ལག་ནས་བསྐྱབས་པའི་ཉིན༌མོར། ཁོང་གིས་དཀོན་མཆོག་ཡ་ཝཱེ་ལ་མགུར་འདིའི་ཚིག་རྣམས་ཞུས༌པ།༽ ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ང་ཡི་སྟོབས་ཤུགས༌ལགས། །ང་ཡིས་ཁྱེད་ཉིད་གཅེས་སུ་འཛིན་པ༌འོ།།"]},{"type":"verse","number":2,"content":["ང་ཡི་བྲག་རྡོ་དང་ནི་རི་རྫོང༌དང༌། །ང་ཡི་སྲོག་སྐྱོབ་ཡ་ཝཱེ་ཁོང་ཉིད༌ཡིན། །ང་ཡི་དཀོན་མཆོག་བདག་གི་ཕ་བོང༌ལགས། །ཁོང་ནི་ང་རང་སྐྱབས་སུ་འགྲོ་ས༌ཡིན། །ང་ཡི་ཕུབ་དང་ཐར་པའི་རྭ་དུང་",{"noteId":10},"དང༌། །བདག་གི་བཙན་རྫོང་ཡང་ནི་ཁོང་ལགས༌སོ།།"]},{"type":"verse","number":3,"content":["བསྟོད་པར་འོས་པའི་ཡ་ཝཱེ་ང་ཡིས༌འབོད། །དེ་ནས་ང་རང་དགྲ་བོ་ཀུན་ལས༌ཐར།།"]},{"type":"verse","number":4,"content":["འཆི་བའི་ཐག་པས་ང་ནི་བཅིངས་པ༌དང༌། །འཇོམས་བྱེད་དྲག་བཞུར་ཆུ་བོས་ང་རང༌བསྣུབས།།"]},{"type":"verse","number":5,"content":["གཤིན་པོའི་ཡུལ་གྱི་ཐག་པས་བདག་ནི༌འཁྲིས། །འཆི་བའི་རྙི་རྒྱ་ང་ཡི་སྟེང་དུ༌བབས།།"]},{"type":"verse","number":6,"content":["དཀའ་སྡུག་མྱོང་དུས་བདག་གིས་ཡ་ཝཱེ༌བོས། །རང་གི་དཀོན་མཆོག་ཉིད་ལ་ཆོ་ངེ༌བཏོན། །མཆོད་ཁང་ནང་དུ་བདག་གི་སྐད་གསན༌ཅིང༌། །ཁོང་དྲུང་བོས་པའི་འོ་དོད་སྙན་དུ༌ཆུད།།"]},{"type":"verse","number":7,"content":["དེའི་དུས་ས་གཞི་འགུལ་ཞིང་འདར་བ༌དང༌། །རི་བོ་དག་གི་རྩ་བ་གཡོས་པ༌སྟེ། །ཡ་ཝཱེ་ཁོང་ཉིད་ཁྲོས་པའི་རྐྱེན་ལས༌བྱུང༌།།"]},{"type":"verse","number":8,"content":["ཁོང་གི་ཤངས་ནས་དུ་བ་སྟུག་པོ༌འཕྱུར། །ཁོང་གི་ཞལ་ལས་འཇོམས་བྱེད་མེ་དཔུང་འབར། །ཐ་ན་སོལ་བ་ཡང་ནི་མེ་ལ༌སྦར།།"]},{"type":"verse","number":9,"content":["ཁོང་གིས་ནམ་མཁའ་དཔྱངས་ནས་མར་ཕེབས༌ཤིང༌། །ཁོང་གི་ཞབས་འོག་སྤྲིན་ནག་སྟུག་པོ༌འཁྲིགས།།"]},{"type":"verse","number":10,"content":["ཁོང་ཉིད་ཀེ་རུབ་",{"noteId":11},"ཅིག་ལ་བཅིབས་ནས༌འཕུར། །རླུང་གི་གཤོག་པར་བརྟེན་ནས་ནམ་འཕང༌བཅད།།"]},{"type":"verse","number":11,"content":["ཁོང་གིས་སྨག་རུམ་ཉིད་ཀྱི་ཡིབ་ས༌བྱས། །ཆར་སྤྲིན་ནག་པོ་ཕྱོགས་བཞིའི་ཡོལ་བར༌མཛད།།"]},{"type":"verse","number":12,"content":["ཁོང་གི་ཞལ་ངོའི་མདངས་ཀྱིས་སྤྲིན་ནག༌ཁྲོད། །སེར་བ་དང་ནི་སོལ་མེ་ཐོན་བྱུང༌ངོ༌།།"]},{"type":"verse","number":13,"content":["ཡ་ཝཱེས་ནམ་མཁར་འབྲུག་སྒྲ་ལྡིར་དུ༌བཅུག །བླ་ན་མེད་པ་ཁོང་གི་གསུང་སྐད༌ཀྱིས། །སེར་བ་དང་ནི་སོལ་མེ་བྱུང་བ༌འོ།།"]},{"type":"verse","number":14,"content":["མདའ་མོ་འཕངས་ནས་དགྲ་རྣམས་ཕྱོགས་བཞིར༌གཏོར། །གློག་དམར་ཡང་ཡང་འཁྱུགས་ནས་དེ་རྣམས༌བཅོམ།།"]},{"type":"verse","number":15,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེས་བཀའ་བཀྱོན་གནང་བ༌དང༌། །ཁྱེད་ཀྱི་ཤངས་ལས་ཐོན་པའི་དབུགས་གཅིག༌གིས། །རྒྱ་མཚོའི་མཐིལ་དང་ས་གཞིའི་རྨང་ཡང༌ཕྱུང༌།།"]},{"type":"verse","number":16,"content":["སྟེང་ནས་ཕྱག་ཟུང་བརྐྱངས་ཏེ་ང་ནི༌ཟིན། །གཏིང་ཟབ་ཆུ་ལས་ང་རང་ཡར་དྲངས༌སོ།།"]},{"type":"verse","number":17,"content":["ཁོང་གིས་ང་ནི་དགྲ་བོ་སྟོབས་ཆེན༌དང༌། །ང་ལ་སྡང་བ་རྣམས་ལས་བསྐྱབས་པ༌སྟེ། །རྒྱུ་མཚན་དེ་རྣམས་ང་ལས་སྟོབས་ཆེ༌འོ།།"]},{"type":"verse","number":18,"content":["ཆག་སྒོའི་ཉིན་མོར་ཁོ་རྣམས་ང་ལ༌རུབས། །འོན་ཀྱང་ཡ་ཝཱེ་བདག་གི་སྐྱབས་གནས༌ཡིན།།"]},{"type":"verse","number":19,"content":["ཁོང་གིས་ང་རང་ས་ཁོད་ཡངས་སར༌ཁྲིད། །ཁོང་ནི་བདག་ལ་མཉེས་པས་བདག་ནི༌བསྐྱབས།།"]},{"type":"verse","number":20,"content":["བདག་གི་དྲང་བདེན་བཞིན་དུ་གསོལ་རས་བསྩལ། །ལག་པ་གཙང་བ་ལྟར་དུ་ཨ་ལན་གནང་། །"]},{"type":"verse","number":21,"content":["རྒྱུ་མཚན་བདག་གིས་ཡ་ཝཱེའི་ལམ་རྣམས༌བསྲུངས། །ངན་པར་སྤྱད་ནས་དཀོན་མཆོག་བསྐྱུར་པ༌མེད།།"]},{"type":"verse","number":22,"content":["ཁོང་གི་ཁྲིམས་སྲོལ་ཐམས་ཅད་ངའི་མདུན༌མཆིས། །ཁོང་གི་སྒྲིག་ཁྲིམས་ནམ་ཡང་སྤངས་པ༌མིན།།"]},{"type":"verse","number":23,"content":["ཁོང་གི་ཞལ་དྲུང་ང་རང་སྐྱོན་དང༌བྲལ། །རང་ཉིད་ཉེས་སྐྱོན་རྣམས་ལས་བསྲུངས་པ༌ཡིན།།"]},{"type":"verse","number":24,"content":["དེ་བས་ཡ་ཝཱེས་ང་ཡི་དྲང་བདེན༌དང༌། །ཁོང་གི་སྤྱན་སྔར་ལག་པ་གཙང་བ༌བཞིན། །དེ་དང་མཐུན་པའི་གསོལ་རས་ང་ལ༌གནང༌།།"]},{"type":"verse","number":25,"content":["བྱམས་བརྩེ་ཅན་ལ་ཁྱེད་ཀྱིས་བྱམས་བརྩེས༌སྐྱོང་། །ཉེས་མེད་མི་ལ་ཁྱེད་རང་ཕུལ་བྱུང་ལགས།།"]},{"type":"verse","number":26,"content":["དྭངས་གཙང་མི་ལ་ཁྱེད་ཀྱིས་རྣམ་དག༌མངོན། །གཡོ་སྒྱུ་ཅན་ལ་ཁྱེད་ཀྱིས་མཁས་མཛངས་སྤྱོད།།"]},{"type":"verse","number":27,"content":["ཉམ་ཐག་མི་རྣམས་ཁྱེད་ཀྱིས་སྐྱོབ་ངེས༌ཤིང༌། །དྲེགས་ཉམས་ལྡན་པའི་མིག་རྣམས་དམའ་སར༌དབབ།།"]},{"type":"verse","number":28,"content":["ཀྱེ་ཀྱེ་ང་ཡི་དཀོན་མཆོག༌ཡ་ཝཱེ་ཡིས། །ང་ཡི་སྒྲོན་མེ་སྦར་ཞིང་མུན་པ༌སེལ།།"]},{"type":"verse","number":29,"content":["ཁྱེད་ལ་བརྟེན་ནས་དགྲ་བོའི་དམག་དཔུང་གཏོར། །དཀོན་མཆོག་མཉམ་དུ་ལྕགས་རིར་རྒྱང་མཆོང༌བྱེད།།"]},{"type":"verse","number":30,"content":["དཀོན་མཆོག་ཁོང་གི་ལམ་ནི་རྣམ་དག༌ཡིན། །ཡ་ཝཱེའི་བཀའ་ནི་དྲི་མ་མེད་པ༌ལགས། །སྐྱབས་བཅོལ་རྣམས་ཀྱི་ཕུབ་ནི་ཁོང་ཉིད༌ཡིན།།"]},{"type":"verse","number":31,"content":["ཡ་ཝཱེ་མ་གཏོགས་དཀོན་མཆོག་གཞན་སུ༌ཡོད། །དཀོན་མཆོག་ལས་གཞན་བྲག་རྡོ་སུ་ཡིན༌ནམ།།"]},{"type":"verse","number":32,"content":["ཁོང་གིས་སྟོབས་ཀྱི་སྐ་རགས་ང་ལ༌འཆིང༌། །བདག་གི་སྤྱོད་ལམ་ཕུལ་དུ་བྱུང་བར༌མཛད།།"]},{"type":"verse","number":33,"content":["ཁོང་གིས་བདག་ལ་ཤྭ་མོའི་བདེ་མྱུར༌བསྩལ། །མཐོན་པོའི་གནས་སུ་བརྟན་པོར་ཚུགས་པར༌མཛད།།"]},{"type":"verse","number":34,"content":["འཐབ་མོ་འགྱེད་ལུགས་བདག་གི་ལག་པར༌བསླབ། །དཔུང་པས་ལི་གཞུ་འགུག་ཀྱང་ནུས་པར༌མཛད།།"]},{"type":"verse","number":35,"content":["ཁྱེད་ཀྱི་ཐར་པའི་ཕུབ་ནི་ང་ལ༌གནང༌། །ཉིད་ཀྱི་ཕྱག་གཡས་ཀྱིས་ནི་ང་རང༌སྐྱོར། །ཁྱེད་ཀྱི་ཞི་བས་ང་ནི་ཆེན་པོར༌མཛད།།"]},{"type":"verse","number":36,"content":["གོམ་པ་སྤོ་སའི་ལམ་ནི་ཡངས་པར༌མཛད། །བདག་གི་རྐང་པ་ནམ་ཡང་འདྲེད་མ༌གྱུར།།"]},{"type":"verse","number":37,"content":["བདག་གིས་དགྲ་རྣམས་དེད་ནས་ཟིན་པ༌དང༌། །ཚར་གཅོད་བྱེད་པའི་བར་དུ་ཕྱིར་མ༌ལོག།"]},{"type":"verse","number":38,"content":["ཁོ་རྣམས་ཤིན་ཏུ་རྨས་ཏེ་ལང་མི༌ནུས། །ཐམས་ཅད་བདག་གི་རྐང་འོག་འགྱེལ་བ༌ཡིན།།"]},{"type":"verse","number":39,"content":["འཐབ་ཕྱིར་ང་ལ་སྟོབས་ཀྱི་སྐ་རགས༌བཅིངས། །དགྲ་རུ་ལང་མཁན་ང་ཡི་རྐང་འོག༌བཅུག།"]},{"type":"verse","number":40,"content":["དགྲ་རྣམས་ང་ཡི་མདུན་ནས་འབྲོ་མཛད་པས། །ང་ལ་སྡང་བའི་མི་རྣམས་བཅོམ་པ་ཡིན།།"]},{"type":"verse","number":41,"content":["དེ་ཚོས་ཆོ་ངེ་བཏོན་ཡང་སྐྱོབ་མཁན༌མེད། །ཡ་ཝཱེ་བོས་ཀྱང་ཁོང་གིས་ལན་མ༌གནང༌།།"]},{"type":"verse","number":42,"content":["རླུང་ཁའི་རྡུལ་བཞིན་དེ་རྣམས་ངས་བཏགས༌ཤིང༌། །ལམ་ཁའི་འདམ་རྫབ་ལྟར་དུ་ཕྱི་རུ༌གཡུགས།།"]},{"type":"verse","number":43,"content":["མི་སྡེའི་འཐབ་རྩོད་ལས་ང་ཁྱེད་ཀྱིས༌བསྐྱབས། །མི་རིགས་རྣམས་ཀྱི་མགོན་དུ་ང་རང་མཛད། །རྒྱུས་མེད་མི་སྡེས་ང་ལ་ཞབས་ཕྱི༌སྒྲུབ།།"]},{"type":"verse","number":44,"content":["ཐོས་པ་ཙམ་གྱིས་དེ་ཚོས་ང་ཉན༌ཞིང་། །མཐའ་མི་རྣམས་ནི་ང་ཡི་མདུན་དུ༌འཁུམས།།"]},{"type":"verse","number":45,"content":["ཁོ་རྣམས་ཐམས་ཅད་ཉམས་རྒུད་དུ་གྱུར༌ཅིང༌། །སྐྲག་ནས་འདར་གྱིན་བཙན་རྫོང་དག་ནས༌ཐོན།།"]},{"type":"verse","number":46,"content":["ཡ་ཝཱེ་ཁོང་ཉིད་གཏན་དུ་གསོན་པོར༌བཞུགས། །ང་ཡི་བྲག་རྡོ་བསྟོད་པར་འོས་སོ༌ལོ། །ང་ཡི་སྲོག་སྐྱོབ་ལགས་པའི་དཀོན་མཆོག༌ནི། །ཁོང་ལ་བཀུར་བསྟི་འབྱུང་བར་གྱུར་ཅིག་ཨང་།།"]},{"type":"verse","number":47,"content":["དཀོན་མཆོག་ང་ཡི་དགྲ་ཤ་ལེན་མཁན༌ཡིན། །མི་སྡེ་རྣམས་ནི་ང་ཡི་དབང་དུ༌བཀོད།།"]},{"type":"verse","number":48,"content":["ཁོང་གིས་ང་རང་དགྲ་ལས་ཐར་བར༌མཛད། །བདག་གི་དགྲ་ཟླ་རྣམས་ལས་ཁྱེད་ཀྱིས༌བཏེགས། །གདུག་རྩུབ་ཅན་ལས་ང་ནི་བསྐྱབས་པ༌འོ།།"]},{"type":"verse","number":49,"content":["ཀྱེ་ཀྱེ་ཡ་ཝཱེ་དེའི་ཕྱིར་བདག་གིས༌ནི། །མི་རིགས་རྣམས་ཀྱི་དཀྱིལ་ནས་ཁྱེད་ལ༌བསྔགས། །ཁྱེད་ཀྱི་མཚན་ལ་བསྟོད་པའི་མགུར་མ༌འབུལ།།"]},{"type":"verse","number":50,"content":["ཡ་ཝཱེས་མཆོག་ཏུ་གྱུར་པའི་ཐར་པ༌ནི། །ཁོང་གིས་བསྐོས་པའི་རྒྱལ་པོར་གནང་བ༌དང༌། །སྣུམ་གྱིས་བྱུགས་པར་བྱམས་བརྩེ་དཔག་མེད༌མཛད། །དཱ་བིད་དང་ནི་ཁོང་གི་བུ་རྒྱུད༌རྣམས། །རྒྱུན་ནས་རྒྱུན་དུ་བྱམས་བརྩེས་སྐྱོང་བ༌འོ།།"]}],"footnotes":[{"noteId":10,"caller":"+","text":"འདིར་རྭ་དུང་ཞེས་པ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཐུ་སྟོབས་ལ་གོ་བ༌ཡིན།","reference":{"chapter":18,"verse":2}},{"noteId":11,"caller":"+","text":"ཀེ་རུབ་ཅེས་པ་ནི་དཀོན་མཆོག་གི་ཕོ་ཉའི་རིགས་སུ་གཏོགས་པ་དང་ནུས་པ་ཁྱད་པར་ཅན་ཞིག༌ཡིན།","reference":{"chapter":18,"verse":10}}]},"thisChapterLink":"/api/bod_ntb/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}