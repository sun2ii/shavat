{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"PSA","translationId":"bod_ntb","name":"གསུང༌མགུར།","commonName":"གསུང༌མགུར།","title":"༄༅།།གསུང་མགུར་གྱི༌མདོ།","order":19,"numberOfChapters":150,"sha256":"5241caf84e568c2dc2a7efd5b005dc33eae128f01645fe0f5cc729e8730a0e87","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bod_ntb/PSA/150.json","totalNumberOfVerses":2453},"chapter":{"number":70,"content":[{"type":"heading","content":["དགྲ་རྣམས་ངོ་ཚ་དང་བཅས་ཕམ་པར་རེ་བ།"]},{"type":"verse","number":1,"content":["༼དཱ་བིད་ཀྱི་དྲན་གསོའི་མགུར་མ་དབུ་མཛད་ལ་སྤྲད༌པ།༽ ཀྱེ་ཀྱེ་དཀོན་མཆོག་ང་རང་མྱུར་དུ༌སྐྱོབས། །ཡ་ཝཱེ་མགྱོགས་པོར་ང་ལ་རོགས་རམ༌མཛོད།།"]},{"type":"verse","number":2,"content":["ངའི་སྲོག་གཅོད་ཕྱིར་ང་རང་འཚོལ་མཁན༌རྣམས། །ལྷན་ཅིག་སྐྱེངས་ཤིང་ངོ་ཡང་ནོངས་གྱུར༌ཅིག །ང་ལ་གནོད་པ་འབྱུང་བར་དགའ་བ༌རྣམས། །ངོ་ཚ་དང་བཅས་ཕམ་པར་གྱུར་ཅིག༌གུ།"]},{"type":"verse","number":3,"content":["ང་ལ་ཨ་ཧ་ཨ་ཧ་ཟེར་མཁན༌རྣམས། །རང་གི་ངོ་ཚའི་རྐྱེན་གྱིས་ཕམ་པར༌ཤོག།"]},{"type":"verse","number":4,"content":["ཁྱེད་རང་འཚོལ་མཁན་དགའ་ཞིང་མགུ་བ༌དང༌། །ཁྱེད་ཀྱི་སྐྱབས་ལ་དགའ་བས་དུས་རྒྱུན༌དུ། །དཀོན་མཆོག་བསྟོད་འོས་ཞེས་སུ་སྨྲ་གྱུར༌ཅིག།"]},{"type":"verse","number":5,"content":["འོན་ཀྱང་ང་ནི་དབུལ་ཞིང་ཕོངས་པས༌ན། །དཀོན་མཆོག་ལམ་སེང་ངའི་རྩར་ཕེབས་པར༌མཛོད། །ང་ཡི་རོགས་རམ་དང་ནི་སྲོག་སྐྱོབ༌ཁྱེད། །ཀྱེ་ཀྱེ་ཡ་ཝཱེ་ཐུགས་གཡེལ་མ་མཛད༌ཅིག།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}