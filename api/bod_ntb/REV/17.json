{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"REV","translationId":"bod_ntb","name":"མངོན་པ།","commonName":"མངོན་པ།","title":"༄༅། །མངོན་པའི་མདོ།","order":66,"numberOfChapters":22,"sha256":"745c56df1cbb919f4d49a8997d03800f48f9ab12c1152162e126263a87b42c50","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":17,"content":[{"type":"heading","content":["གཅན་གཟན་ལ་བཞོན་པའི་བུད་མེད།"]},{"type":"verse","number":1,"content":["ཕོར་བ་བདུན་བཟུང་བའི་ཕོ་ཉ་རྣམས་ལས་གཅིག་ཡོང་སྟེ་བདག་ལ་འདི་སྐད་དུ། ཤོག་དང་། ཆུ་མང་པོའི་སྟེང་དུ་སྡོད་པའི་སྨད་འཚོང་མ་ཆེན་མོར་འཕོག་ངེས་པའི་ཉེས་ཆད་དེ་བདག་གིས་ཁྱོད་ལ་སྟོན་པར་བྱའོ།།"]},{"type":"verse","number":2,"content":["ས་སྟེང་གི་རྒྱལ་པོ་རྣམས་ཀྱིས་ཁོ་མོར་ལོག་གཡེམ་བྱས་ཤིང་། ས་སྟེང་དུ་སྡོད་པའི་མི་རྣམས་ཀྱིས་ཁོ་མོའི་ལོག་གཡེམ་གྱི་རྒུན་ཆང་འཐུང་ནས་ར་བཟི་བ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":3,"content":["དེ་ནས་ཕོ་ཉས་ང་རང་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ངང་ནས་དབེན་སྟོང་ཞིག་ཏུ་ཁྲིད་པ་དང་། ངས་བུད་མེད་ཅིག་གཅན་གཟན་དམར་པོ་ཞིག་ལ་བཞོན་ཡོད་པ་མཐོང་ཞིང་། གཅན་གཟན་དེ་ལ་མགོ་བོ་བདུན་དང་རྭ་ཅོ་བཅུ་ཡོད་པ་དང་། ལུས་ཧྲིལ་པོར་སྐུར་འདེབས་ཀྱི་མིང་རྟགས་ཀྱིས་ཁྱབ་འདུག"]},{"type":"verse","number":4,"content":["བུད་མེད་དེས་ལུས་ལ་ཁ་དོག་རྒྱ་སྨུག་དང་དམར་པོ་ཅན་གྱི་གོས་གྱོན་ཞིང་། གསེར་དང་། རིན་པོ་ཆེ། མུ་ཏིག་གི་རྒྱན་ཆ་བཏགས་པ་དང་། ལག་ཏུ་གསེར་གྱི་ཕོར་བ་བཟུང་ཡོད་ལ། ཕོར་བའི་ནང་དུ་སྐྱུག་བྲོ་བའི་དོན་དག་དང་ཁོ་མོས་ལོག་གཡེམ་བྱས་པའི་མི་གཙང་བས་གང་ངོ་།།"]},{"type":"verse","number":5,"content":["ཁོ་མོའི་དཔྲལ་བར་མིང་ལྐོག་གྱུར་པ་ཞིག་བཀོད་ཡོད་དེ། པཱ་པེལ་ལོན་ཆེན་པོ་དང་། འཇིག་རྟེན་གྱི་སྨད་འཚོང་མ། སྐྱུག་བྲོ་བའི་དོན་ཐམས་ཅད་ཀྱི་མ་ཞེས་པའོ།།"]},{"type":"verse","number":6,"content":["ཡང་བུད་མེད་དེས་དད་ལྡན་དམ་པ་རྣམས་ཀྱི་ཁྲག་དང་སྐྱབས་མགོན་ཡེ་ཤུར་བདེན་དཔང་བྱེད་མཁན་རྣམས་ཀྱི་ཁྲག་འཐུང་ནས་ར་བཟི་བ་བདག་གིས་མཐོང་ངོ་།། ངས་ཁོ་མོ་མཐོང་བ་དང་ཡ་མཚན་ཆེན་པོ་སྐྱེས་སོ།།"]},{"type":"verse","number":7,"content":["ཕོ་ཉས་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་ནི་ཅིའི་ཕྱིར་ཡ་མཚན་སྐྱེས་སམ། ངས་བུད་མེད་དེ་དང་ཁོ་མོ་བཞོན་པའི་མགོ་བོ་བདུན་དང་རྭ་ཅོ་བཅུ་ཅན་གྱི་གཅན་གཟན་གྱི་གསང་བ་ཁྱོད་ལ་འཆད་པར་བྱའོ།།"]},{"type":"verse","number":8,"content":["སྔར་ཁྱོད་ཀྱིས་མཐོང་བའི་གཅན་གཟན་དེ་ནི་སྔོན་ཆད་ཡོད་ལ་ད་ལྟ་མེད་དེ། ཕྱིས་སུ་ཞབས་མེད་པའི་དོང་ནས་འཐོན་ངེས་ཤིང་འཇིག་པར་འགྱུར། ཡང་ས་སྟེང་དུ་སྡོད་ཅིང་འཇིག་རྟེན་བཀོད་པའི་ཚུན་ལ་ཚེ་སྲོག་གི་གླེགས་བམ་ནང་དུ་མིང་ཐོ་མ་བཀོད་པ་རྣམས་ཀྱིས། གཅན་གཟན་དེ་མཐོང་བའི་ཚེ་ངོ་མཚར་བར་འགྱུར་ཏེ། ཁོ་རང་སྔོན་ཆད་ཡོད་ལ་ད་ལྟ་མེད་ཀྱང་ཕྱིས་སུ་ཡོང་བར་འགྱུར་བའི་ཕྱིར་རོ༎"]},{"type":"verse","number":9,"content":["འདི་རུ་ཤེས་རབ་ལྡན་པའི་བློ་ཡོད་དེ། མགོ་བོ་བདུན་པོ་ནི་བུད་མེད་སྡོད་སའི་རི་བོ་བདུན་ཡིན་ལ།"]},{"type":"verse","number":10,"content":["དེ་ནི་རྒྱལ་པོ་བདུན་ཡང་ཡིན་ཏེ། རྒྱལ་པོ་ལྔ་ནི་འགྱེལ་ཟིན་པ་དང་། གཅིག་ནི་ད་ལྟ་ཡོད། གཅིག་ནི་ད་དུང་མ་ཡོང་ལ། དེ་ཉིད་ཡོང་ཚེ་རེ་ཞིག་ལ་སྡོད་དགོས།"]},{"type":"verse","number":11,"content":["སྔོན་ཆད་ཡོད་ཅིང་ད་ལྟ་མེད་པའི་གཅན་གཟན་དེ་ནི་ཨང་བརྒྱད་པ་ཡིན་ལ། བདུན་པོ་དེའི་ཡ་གྱལ་དུ་གཏོགས་ཤིང་དེ་ཡང་འཇིག་པར་འགྱུར་རོ།།"]},{"type":"verse","number":12,"content":["ཁྱོད་ཀྱིས་དེ་སྔར་མཐོང་བའི་རྭ་ཅོ་བཅུ་པོ་ནི་རྒྱལ་པོ་བཅུ་ཡིན་ལ། དེ་རྣམས་ལ་རྒྱལ་སྲིད་ད་དུང་ཐོབ་མེད་མོད། འོན་ཀྱང་དེ་རྣམས་ལ་དུས་ཚོད་གཅིག་གི་རིང་ལ་གཅན་གཟན་དེ་དང་མཉམ་དུ་རྒྱལ་པོའི་དབང་འཐོབ་པར་འགྱུར་རོ།།"]},{"type":"verse","number":13,"content":["དེ་རྣམས་ཀྱིས་བློ་སེམས་གཅིག་མཐུན་ངང་ནས་རང་གི་ནུས་མཐུ་དང་དབང་ཐང་ཐམས་ཅད་གཅན་གཟན་དེ་ལ་སྤྲོད་པ་ཡིན།"]},{"type":"verse","number":14,"content":["དེ་རྣམས་ལུ་གུ་དང་འཐབ་ཅིང་། ཁོང་ནི་གཙོ་བོ་རྣམས་ཀྱི་གཙོ་བོ་དང་རྒྱལ་པོ་རྣམས་ཀྱི་རྒྱལ་པོ་ཡིན་པས། དེ་དག་ལས་རྣམ་པར་རྒྱལ་བར་འགྱུར། ལུ་གུ་དང་མཉམ་དུ་ཡོད་པ་ནི་ཞལ་འབོད་ཐོབ་པ་དང་བདམས་པར་མཛད་པ། བློ་སེམས་དཀར་བ་བཅས་རྣམས་ཡིན་ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":15,"content":["ཡང་ཕོ་ཉས་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་མཐོང་བའི་སྨད་འཚོང་མ་སྡོད་པའི་ཆུ་རྣམས་ནི་མི་སྡེ་དང་། མི་ཚོགས། མི་རིགས། སྐད་རིགས་བཅས་ཡིན་ནོ།།"]},{"type":"verse","number":16,"content":["ཁྱོད་ཀྱིས་མཐོང་བའི་རྭ་ཅོ་བཅུ་པོ་དང་གཅན་གཟན་ནི་སྨད་འཚོང་མ་ལ་ངེས་པར་སྡང་སྟེ། ཁོ་མོ་སྟོངས་པར་བྱེད་ཅིང་གཅེར་བུར་བསྐྱུར་བ་དང་། ཡང་ཁོ་མོའི་ཤ་ཟ་བ་དང་ཁོ་མོ་མེར་བསྲེགས་ནས་ཚར་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་རྒྱལ་པོ་རྣམས་ལ་བློ་སེམས་གཅིག་མཐུན་ངང་ཁོང་གི་དགོངས་པ་བཞིན་དུ་སྒྲུབ་པར་མཛད་དེ། ཁོང་གི་བཀའ་རྣམས་འགྲུབ་པའི་བར་དུ། རྒྱལ་པོ་དེ་རྣམས་ཀྱིས་རང་གི་རྒྱལ་སྲིད་གཅན་གཟན་དེ་ལ་སྤྲོད་པར་འགྱུར་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་མཐོང་བའི་བུད་མེད་དེ་ནི་ས་སྟེང་གི་རྒྱལ་པོ་རྣམས་ལ་དབང་བསྒྱུར་བའི་གྲོང་ཁྱེར་ཆེན་པོ་ཡིན་ཞེས་སྨྲས་སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/REV/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/REV/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/REV/16.json","previousChapterAudioLinks":{},"numberOfVerses":18}