{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"REV","translationId":"bod_ntb","name":"མངོན་པ།","commonName":"མངོན་པ།","title":"༄༅། །མངོན་པའི་མདོ།","order":66,"numberOfChapters":22,"sha256":"745c56df1cbb919f4d49a8997d03800f48f9ab12c1152162e126263a87b42c50","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["པཱ་པེལ་ལོན་འཇིག་པ།"]},{"type":"verse","number":1,"content":["དེའི་རྗེས་སུ། བདག་གིས་དབང་ཐང་ཆེན་པོའི་ཕོ་ཉ་གཞན་ཞིག་ནམ་མཁའི་ཞིང་ཁམས་ནས་མར་ཕེབས་པ་མཐོང་ཞིང་། ཁོང་གི་གཟི་བརྗིད་ཆེན་པོའི་གཟི་འོད་ས་གཞི་ཡོངས་ལ་ཁྱབ་བོ།།"]},{"type":"verse","number":2,"content":["ཁོང་གིས་གསུང་སྐད་དྲག་པོས་འདི་སྐད་དུ།",{"text":"འཇིག་པར་གྱུར་ཏོ་པཱ་པེལ་ལོན།།","poem":1},{"lineBreak":true},{"text":"ཆེན་པོ་དེ་ནི་འཇིག་པར་གྱུར།།","poem":1},{"lineBreak":true},{"text":"དེ་ནི་གདོན་གྱི་སྡོད་གནས་དང་།།","poem":1},{"lineBreak":true},{"text":"མི་གཙང་གདོན་དང་བྱེའུ་ཚང་དང་།།","poem":1},{"lineBreak":true},{"text":"མི་གཙང་སྐྱུག་བྲོ་སྣ་ཚོགས་ཀྱི།།","poem":1},{"lineBreak":true},{"text":"གཅན་གཟན་འགྲོ་སའི་གནས་སུ་གྱུར།།","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"རྒྱལ་ཁབ་སོ་སོས་ཁོ་མོ་","poem":1},{"noteId":2},{"text":"ཡི།།","poem":1},{"lineBreak":true},{"text":"གཡེམ་གྱི་འདོད་ཆགས་ཆེན་པོའི་ཆང་།།","poem":1},{"lineBreak":true},{"text":"འཐུང་ཞིང་ས་སྟེང་རྒྱལ་པོ་རྣམས།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོ་ལ་ནི་ལོག་གཡེམ་བྱས།།","poem":1},{"lineBreak":true},{"text":"ས་སྟེང་ཚོང་པ་དག་གིས་ཀྱང་།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོར་ལོག་གཡེམ་བྱས་པའི་ཕྱིར།།","poem":1},{"lineBreak":true},{"text":"ས་སྟེང་ཚོང་པ་ཐམས་ཅད་ནི།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོའི་འདོད་ཡོན་ལོངས་སྤྱོད་ལ།།","poem":1},{"lineBreak":true},{"text":"བརྟེན་པའི་དབང་གིས་འབྱོར་བ་རྒྱས།།","poem":1},"ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":4,"content":["ཡང་བདག་གིས་ནམ་མཁའི་ཞིང་ཁམས་ནས་སྐད་གཞན་ཞིག་གིས་འདི་སྐད་གསུངས་པ་ཐོས་ཏེ།",{"text":"ཀྱེ་ཀྱེ་ང་ཡི་མི་སྡེ་རྣམས།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོ་མཉམ་དུ་སྡིག་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོས་མྱོང་བའི་ཆག་སྒོ་དེ།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ལ་འབྱུང་བར་མི་བྱ་ཕྱིར།།","poem":1},{"lineBreak":true},{"text":"གྲོང་ཁྱེར་དེ་ནས་ཕྱིར་ཐོན་ཤོག །","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ཁོ་མོའི་སྡིག་ཕུང་ནམ་མཁར་གཏུགས༎","poem":1},{"lineBreak":true},{"text":"དཀོན་མཆོག་ཉིད་ཀྱིས་ཁོ་མོ་ཡི།།","poem":1},{"lineBreak":true},{"text":"སྡིག་པ་དག་ནི་ཐུགས་ལ་དྲན།།","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ཁོ་མོས་མི་ལ་ཅི་བྱས་ན།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོ་ལ་ཡང་དེ་ལྟར་བྱ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོས་ཅི་ལྟར་བྱས་པ་ལ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོར་ཡ་ལན་ལྡབ་གཉིས་སྩོལ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོས་བསྡེབས་པའི་ཕོར་བ་ལ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོར་ལྡབ་གཉིས་བསྡེབ་པར་གྱིས།།","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ཁོ་མོས་ཇི་ལྟར་རང་བསྟོད་དང་།།","poem":1},{"lineBreak":true},{"text":"འདོད་ཡོན་ལོངས་སྤྱོད་རྫོགས་པ་བཞིན།།","poem":1},{"lineBreak":true},{"text":"དེ་ལྟར་ཁོ་མོར་མནར་གཅོད་དང་།།","poem":1},{"lineBreak":true},{"text":"མྱ་ངན་ཆེན་པོ་མྱང་བར་གྱིས།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོའི་སེམས་སུ་འདི་བཞིན་དུ།།","poem":1},{"lineBreak":true},{"text":"ང་ནི་བཙུན་མོའི་ཁྲི་ལ་བསྡད།།","poem":1},{"lineBreak":true},{"text":"ཡུགས་མོ་ལ་ནི་མ་ཡིན་ཏེ།།","poem":1},{"lineBreak":true},{"text":"མྱ་ངན་གནས་སུ་མི་ལྷུང་སྙམ།།","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"དེའི་ཕྱིར་ཉིན་གཅིག་དུས་ཡུན་ལ།།","poem":1},{"lineBreak":true},{"text":"འཆི་བ་མྱ་ངན་མུ་གེ་བཅས།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོའི་ཆག་སྒོ་མཉམ་དུ་འབྱུང་།།","poem":1},{"lineBreak":true},{"text":"མེ་ཡིས་ཁོ་མོ་བསྲེག་འགྱུར་ཞིང་།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོར་ཉེས་ཆད་གཅོད་མཁན་ཏེ།།","poem":1},{"lineBreak":true},{"text":"གཙོ་བོ་དཀོན་མཆོག་ཁོང་ཉིད་ལ།།","poem":1},{"lineBreak":true},{"text":"ནུས་མཐུ་ཆེན་པོ་ལྡན་པས་སོ།།","poem":1},"ཞེས་པའོ།།"]},{"type":"verse","number":9,"content":["ཡང་འདི་སྐད་དུ། ཁོ་མོར་ལོག་གཡེམ་བྱེད་ཅིང་མཉམ་དུ་འདོད་ཡོན་ལོངས་སྤྱོད་ལ་རོལ་བའི་ས་སྟེང་གི་རྒྱལ་པོ་རྣམས་ཀྱིས། ཁོ་མོ་མེར་བསྲེག་པའི་དུ་བ་མཐོང་སྟེ་ཁོ་མོའི་ཆེད་དུ་ངུ་ཞིང་མྱ་ངན་བྱེད་པར་འགྱུར་བ་དང་།"]},{"type":"verse","number":10,"content":["ཁོ་མོའི་མནར་གཅོད་ལ་འཇིགས་པས་རྒྱང་རིང་དུ་ལངས་བསྡད་དེ་ན་རེ།",{"text":"ཆག་སྒོ་བྱུང་ངོ་ཆག་སྒོ་བྱུང་།།","poem":1},{"lineBreak":true},{"text":"སྲ་མཁྲེགས་ལྡན་པའི་པཱ་པེལ་ལོན།།","poem":1},{"lineBreak":true},{"text":"གྲོང་ཁྱེར་ཆེན་པོ་ཁྱོད་ཉིད་ལ།།","poem":1},{"lineBreak":true},{"text":"ཆུ་ཚོད་གཅིག་གི་དུས་ཡུན་དུ།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཉེས་ཆད་སླེབས་ཟིན་ཏོ།།","poem":1},"ཞེས་སྨྲས་པའོ།།"]},{"type":"verse","number":11,"content":["ཡང་འདི་སྐད་དུ། ཁོ་རྣམས་ཀྱི་ཚོང་ཟོག་ཉོ་མཁན་མེད་པས། ས་སྟེང་གི་ཚོང་པ་ཡང་ཁོ་མོའི་ཕྱིར་ངུ་ཞིང་མྱ་ངན་བྱེད་པའོ།།"]},{"type":"verse","number":12,"content":["ཚོང་ཟོག་ནི་གསེར་དང་། དངུལ། རིན་པོ་ཆེ། མུ་ཏིག སོ་རས་སྲབ་བུ། རས་རྒྱ་སྨུག དར་སིལ། རས་དམར་པོ། ཤིང་དྲི་ཞིམ་ཅན་སྣ་ཚོགས། བ་སོའི་སྣོད་ཅ་ལག་སྣ་ཚོགས། རིན་ཐང་ཤིན་ཏུ་ཆེ་བའི་ཤིང་དང་ལི། ལྕགས། རྡོ་ཀ་མ་རུའི་སྣོད་ཅ་ལག་སྣ་ཚོགས།"]},{"type":"verse","number":13,"content":["ཤིང་ཚ། བསུང་རྫས། བདུག་སྤོས། གུ་གུལ། སྤོས་དཀར། རྒུན་ཆང་། སྐྱུ་རུ་རའི་འཚིར་སྣུམ། ཕྱེ་ཡག་པོ། གྲོ། བ་གླང་། ལུག རྟ། ཤིང་རྟ། གཡོག་པོ། མིའི་སྲོག་དང་བཅས་སོ།།"]},{"type":"verse","number":14,"content":["ཀྱེ་པཱ་པེལ་ལོན། ཁྱོད་རང་ཞེན་ཆགས་པའི་འབྲས་བུ་ཁྱོད་དང་བྲལ་ཞིང་། ཁྱོད་ཀྱི་རོ་བརྒྱའི་ཟས་མཆོག་དང་ཡིད་དུ་འོང་བའི་དངོས་པོ་དག་ཀྱང་ཁྱོད་ལས་རྩ་མེད་བཏང་བས་ནམ་ཡང་སླར་མཐོང་བར་མི་འགྱུར་རོ།།"]},{"type":"verse","number":15,"content":["ཚོང་རྫས་འདི་རྣམས་འཚོང་མཁན་ཏེ། ཁོ་མོར་བརྟེན་ནས་ཕྱུག་པོར་གྱུར་པའི་ཚོང་པ་རྣམས་ཁོ་མོའི་མནར་གཅོད་ལ་འཇིགས་པའི་རྐྱེན་གྱིས། རྒྱང་རིང་དུ་ལངས་ནས་བསྡད་དེ་ངུ་ཞིང་མྱ་ངན་བྱས་ཏེ་ན་རེ།"]},{"type":"verse","number":16,"content":[{"text":"ཆག་སྒོ་བྱུང་ངོ་ཆག་སྒོ་བྱུང་།།","poem":1},{"lineBreak":true},{"text":"གྲོང་ཁྱེར་ཆེན་པོ་འདི་ལ་བྱུང་།།","poem":1},{"lineBreak":true},{"text":"སོ་རས་སྲབ་བུ་གྱོན་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"ཁ་དོག་རྒྱ་སྨུག་དམར་པོ་ཡི།།","poem":1},{"lineBreak":true},{"text":"གོས་ནི་གྱོན་ཞིང་གསེར་རྒྱན་དང་།།","poem":1},{"lineBreak":true},{"text":"རིན་པོ་ཆེ་དང་མུ་ཏིག་གི །","poem":1},{"lineBreak":true},{"text":"རྒྱན་ཆས་ལེགས་པར་བརྒྱན་པ་འོ།།","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ཆུ་ཚོད་གཅིག་གི་དུས་ཡུན་ལ།།","poem":1},{"lineBreak":true},{"text":"དེ་འདྲའི་འབྱོར་ཕྱུག་ཆེན་པོ་ཞིག །","poem":1},{"lineBreak":true},{"text":"ཅི་ཡང་མེད་པར་གྱུར་པ་འོ།།","poem":1},"ཞེས་སྨྲས་པའོ།། ཡང་འདི་སྐད་དུ། གྲུ་དཔོན་དང་གྲུ་གཟིངས་ལ་བསྡད་ནས་ཕྱོགས་བཞིར་འགྲིམ་མཁན་དང་། གྲུ་པ་དང་། རྒྱ་མཚོར་བརྟེན་ནས་འཚོ་བ་རོལ་མཁན་ཐམས་ཅད་རྒྱང་རིང་དུ་ལངས་ནས་བསྡད་དེ།"]},{"type":"verse","number":18,"content":["ཁོ་མོ་མེ་ལ་བསྲེག་པའི་དུ་བ་མཐོང་ནས་སྐད་ཆེན་པོས་འདི་ལྟར་སྨྲས་པ། གྲོང་ཁྱེར་གང་ཞིག་གྲོང་ཁྱེར་ཆེན་པོ་འདི་དང་བསྡུར་ནུས་སམ་ཞེས་པའོ།།"]},{"type":"verse","number":19,"content":["ཡང་དེ་རྣམས་ཀྱིས་རང་གི་མགོ་ལ་ས་རྡུལ་གཏོར་བ་དང་། ངུ་ཞིང་མྱ་ངན་བྱེད་ཀྱིན་སྐད་ཆེན་པོས།",{"text":"ཆག་སྒོ་བྱུང་ངོ་ཆག་སྒོ་བྱུང་།།","poem":1},{"lineBreak":true},{"text":"གྲོང་ཁྱེར་ཆེན་པོ་འདི་ལ་བྱུང་།།","poem":1},{"lineBreak":true},{"text":"རྒྱ་མཚོར་གྲུ་གཟིངས་ཡོད་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོའི་རིན་པོ་ཆེ་རྣམས་ལ།།","poem":1},{"lineBreak":true},{"text":"བརྟེན་མཁན་ཐམས་ཅད་ཕྱུག་པོར་གྱུར།།","poem":1},{"lineBreak":true},{"text":"ཆུ་ཚོད་གཅིག་གི་དུས་ཡུན་ལ།།","poem":1},{"lineBreak":true},{"text":"ཁོ་མོ་གཞི་ནས་མེད་པར་གྱུར།།","poem":1},"ཞེས་སྨྲས་སོ།།"]},{"type":"verse","number":20,"content":["ཡང་འདི་སྐད་དུ། ཀྱེ་ནམ་མཁའི་ཞིང་ཁམས་དང་། དད་ལྡན་དམ་པ། སྐུ་ཚབ་པ། ལུང་སྟོན་པ་རྣམས། ཁོ་མོའི་དབང་གིས་དགའ་བར་གྱིས། ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ཀྱི་ཆེད་དུ་ཁོ་མོར་ཉེས་ཆད་བཅད་པས་སོ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":21,"content":["ཡང་ཕོ་ཉ་སྟོབས་ཆེན་ཞིག་གིས་རྡོ་ཕ་བོང་རང་འཐག་གི་རྡོ་ཆེན་པོ་དང་འདྲ་བ་ཞིག་ཡར་བཀྱགས་ནས་རྒྱ་མཚོར་འཕངས་ཏེ་འདི་སྐད་དུ།",{"text":"གྲོང་ཁྱེར་ཆེན་པོ་པཱ་པེལ་ལོན།།","poem":1},{"lineBreak":true},{"text":"འདི་བཞིན་ཤུགས་ཀྱིས་གཡུག་པར་ངེས།།","poem":1},{"lineBreak":true},{"text":"སླར་ཡང་མཐོང་བར་མི་འགྱུར་རོ།།","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"རོལ་དབྱངས་ཀྱང་ནི་དཀྲོལ་བ་དང་།།","poem":1},{"lineBreak":true},{"text":"གླུ་གཞས་ཀྱང་ནི་གཏོང་བ་དང་།།","poem":1},{"lineBreak":true},{"text":"གླིང་བུ་ཡང་ནི་འབུད་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"དུང་དཀར་ཡང་ནི་འབུད་པ་བཅས།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཁྲོད་ནས་ཐོས་མི་འགྱུར།།","poem":1},{"lineBreak":true},{"text":"ལས་རིགས་སོ་སོའི་ལག་རྩལ་ཡང་།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཁྲོད་ནས་མཐོང་མི་འགྱུར།།","poem":1},{"lineBreak":true},{"text":"རང་འཐག་སྒྲ་ནི་ཁྱོད་ཀྱི་ཁྲོད།།","poem":1},{"lineBreak":true},{"text":"ནམ་ཡང་ཐོས་པར་མི་འགྱུར་རོ།།","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"སྒྲོན་མེའི་འོད་ནི་ཁྱོད་ཀྱི་ཁྲོད།།","poem":1},{"lineBreak":true},{"text":"ནམ་ཡང་འཕྲོ་བར་མི་འགྱུར་རོ།།","poem":1},{"lineBreak":true},{"text":"མག་པ་བག་མའི་སྐད་སྒྲ་ཡང་།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་ཁྲོད་དུ་ཐོས་མི་འགྱུར།།","poem":1},{"lineBreak":true},{"text":"དེ་ནི་ཁྱོད་ཀྱི་ཚོང་པ་རྣམས།།","poem":1},{"lineBreak":true},{"text":"ས་སྟེང་འདི་ཡི་མི་ཆེན་ཡིན།།","poem":1},{"lineBreak":true},{"text":"འཇིག་རྟེན་རྒྱལ་ཁབ་སོ་སོ་ཡང་།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ཀྱི་སྒྱུ་མས་བསླུས་ཕྱིར་རོ།།","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ལུང་སྟོན་པ་དང་དད་ལྡན་དམ་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"ས་སྟེང་འདི་ནས་བསད་པའི་མི་ཚང་མའི།།","poem":1},{"lineBreak":true},{"text":"ཁྲག་དམར་གྲོང་ཁྱེར་འདི་རུ་རྙེད་པ་ཡིན།།","poem":1},"ཞེས་གསུངས་སོ།།"]}],"footnotes":[{"noteId":2,"caller":"+","text":"འདིར་བརྗོད་པའི་ཁོ་མོ་ཞེས་པ་ནི་གོང་གི་པཱ་པེལ་ལོན་ཞེས་པའི་གྲོང་ཁྱེར་ལ་གོ་དགོས། གཤམ་དུ་འབྱུང་བའང་དེ་བཞིན་ཡིན།","reference":{"chapter":18,"verse":3}}]},"thisChapterLink":"/api/bod_ntb/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}