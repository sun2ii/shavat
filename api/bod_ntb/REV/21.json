{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"REV","translationId":"bod_ntb","name":"མངོན་པ།","commonName":"མངོན་པ།","title":"༄༅། །མངོན་པའི་མདོ།","order":66,"numberOfChapters":22,"sha256":"745c56df1cbb919f4d49a8997d03800f48f9ab12c1152162e126263a87b42c50","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":21,"content":[{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གསར་པ།"]},{"type":"verse","number":1,"content":["ཡང་བདག་གིས་གནམ་ས་གསར་པ་ཞིག་མཐོང་ངོ་།། རྒྱུ་མཚན་གནམ་ས་སྔ་མ་ནི་འདས་ཤིང་རྒྱ་མཚོ་ཡང་མེད་པར་གྱུར་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":2,"content":["ཡང་གྲོང་ཁྱེར་དམ་པ་སྟེ་ཡེ་རུ་སཱ་ལེམ་གསར་པ་ནི་དཀོན་མཆོག་ནས་བྱུང་ཞིང་ནམ་མཁའི་ཞིང་ཁམས་ལས་བབས་པ་བདག་གིས་མཐོང་ངོ་།། དེ་ནི་སྟ་གོན་བྱས་ཚར་བའི་བག་གསར་གྱིས་གཟབ་མཆོར་སྤྲས་ནས་མག་པར་སྒུག་པ་དང་མཚུངས།"]},{"type":"verse","number":3,"content":["དེ་ནས་བདག་གིས་བཞུགས་ཁྲི་ནས་སྐད་ཆེན་པོ་ཞིག་གྲགས་ཡོང་བ་ཐོས་ཤིང་འདི་སྐད་དུ། ལྟོས་དང༌། དཀོན་མཆོག་གི་གུར་མཆོག་ནི་མི་རྣམས་ཀྱི་དབུས་སུ་མཆིས་ཤིང་། ཁོང་མི་རྣམས་དང་མཉམ་དུ་བཞུགས་ཏེ། མི་རྣམས་ཁོང་གི་འབངས་མི་རུ་འགྱུར་བ་དང་། དཀོན་མཆོག་ནི་སྐུ་དངོས་སུ་ཁོ་རྣམས་དང་མཉམ་དུ་བཞུགས་ཤིང་ཁོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡིན་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་གིས་ཁོ་རྣམས་ཀྱི་མིག་ཆུ་ཐམས་ཅད་དབྱི་བར་འགྱུར་ཞིང་། སྔོན་གྱི་དོན་རྣམས་འདས་ཟིན་པས། ད་ནི་འཆི་བ་ཡོད་མི་སྲིད་ལ། མྱ་ངན་དང་། ངུ་འབོད། ཟུག་གཟེར་བཅས་ཀྱང་ཡོད་མི་སྲིད་དོ།།"]},{"type":"verse","number":5,"content":["བཞུགས་ཁྲིའི་སྟེང་དུ་བཞུགས་མཁན་གྱིས་འདི་སྐད་དུ། ལྟོས་དང་། བདག་གིས་ཐམས་ཅད་གསར་དུ་སྐྲུན་པ་ཡིན་ཞེས་དང་། ཡང་འདི་སྐད་དུ། བཀའ་འདི་རྣམས་ནི་ཡིད་རྟོན་རུང་བ་དང་བདེན་པ་ཡིན་པས། ཁྱོད་ཀྱིས་ཡི་གེར་འགོད་པར་བྱའོ་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":6,"content":["ཡང་ཁོང་གིས་བདག་ལ་འདི་སྐད་དུ། ལེགས་པར་གྲུབ་འདུག ང་ནི་ཨལ་ཕཱ་དང་ཨོ་མེ་ཀ་སྟེ། ཐོག་མ་དང་མཐའ་མ་ཡིན་ནོ།། ངས་ཚེ་སྲོག་གི་ཆུ་མིག་ལས་ཁ་སྐོམ་པ་རྣམས་ལ་རིན་མི་དགོས་པར་གནང་བར་ངེས།"]},{"type":"verse","number":7,"content":["རྣམ་པར་རྒྱལ་པ་རྣམས་ལ་དོན་འདི་དག་འཐོབ་པར་འགྱུར་བ་དང་། བདག་ནི་ཁོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡིན་ཞིང་། དེ་རྣམས་ནི་བདག་གི་བུ་ཡིན་པར་འགྱུར་རོ།།"]},{"type":"verse","number":8,"content":["འོན་ཀྱང་། སྡར་མ་དང་། དད་པ་མེད་པ། ཞེན་ལོག་པ། ལག་དམར། ལོག་གཡེམ་པ། སྒྱུ་འཕྲུལ་པ། སྐུ་འདྲར་བརྟེན་མཁན། རྫུན་སྨྲ་མཁན་ཐམས་ཅད་ལ་འཐོབ་པའི་སྐལ་ནི་མུ་ཟི་འབར་བའི་མེ་མཚོ་ནང་དུ་ཡོད་ཅིང་། དེ་ནི་འཆི་བ་ཐེངས་གཉིས་པ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":9,"content":["དེ་ནས་མཐའ་མའི་ཆག་སྒོ་བདུན་གྱིས་གང་བའི་ཕོར་བ་བདུན་བཟུང་ཡོད་པའི་ཕོ་ཉ་བདུན་ལས་གཅིག་ཡོང་སྟེ་བདག་ལ་འདི་སྐད་དུ། ཁྱོད་འདིར་ཤོག་དང་། བདག་གིས་ཁྱོད་ལ་བག་གསར་སྟོན་པར་བྱའོ།། དེ་ནི་ལུ་གུའི་ཆུང་མ་ཡིན་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":10,"content":["དེ་ནས་ཕོ་ཉ་དེས་ང་རང་དམ་པའི་ཐུགས་ཉིད་ཀྱི་ངང་ནས་མཐོ་ཞིང་ཆེ་བའི་རི་ཞིག་ཏུ་ཁྲིད་དེ། དཀོན་མཆོག་ནས་བྱུང་ཞིང་ནམ་མཁའི་ཞིང་ཁམས་ལས་བབས་པའི་གྲོང་ཁྱེར་དམ་པ་ཡེ་རུ་སཱ་ལེམ་བདག་ལ་བསྟན།"]},{"type":"verse","number":11,"content":["གྲོང་ཁྱེར་དེ་ལ་དཀོན་མཆོག་གི་གཟི་བརྗིད་ལྡན་པ་དང་། གྲོང་ཁྱེར་གྱི་གཟི་འོད་ནི་རིན་ཐང་ཆེ་བའི་རྡོ་དང་མཚུངས་ཤིང་གཡང་ཊི་སྔོན་པོ་དང་འདྲ་བ། ཆུ་ཤེལ་ལྟར་དྭངས་པ་ཡིན།"]},{"type":"verse","number":12,"content":["དེ་ལ་མཐོ་ཞིང་ཆེ་བའི་མཁར་གྱང་དང་། མཁར་སྒོ་བཅུ་གཉིས། མཁར་སྒོ་རུ་ཕོ་ཉ་བཅུ་གཉིས་བཅས་མཆིས། མཁར་སྒོའི་སྟེང་དུ་ཡེས་ར་ཨེལ་བུ་རྒྱུད་ཀྱི་ཚོ་པ་བཅུ་གཉིས་པོའི་མིང་བཀོད་ཡོད་དོ།།"]},{"type":"verse","number":13,"content":["ཤར་ཕྱོགས་སུ་མཁར་སྒོ་གསུམ་དང་། བྱང་ཕྱོགས་སུ་མཁར་སྒོ་གསུམ། ལྷོ་ཕྱོགས་སུ་མཁར་སྒོ་གསུམ། ནུབ་ཕྱོགས་སུ་མཁར་སྒོ་གསུམ་བཅས་མཆིས།"]},{"type":"verse","number":14,"content":["གྲོང་ཁྱེར་གྱི་མཁར་གྱང་ལ་རྟིང་རྡོ་བཅུ་གཉིས་ཡོད་ལ། རྟིང་རྡོ་བཅུ་གཉིས་ཀྱི་སྟེང་དུ་ལུ་གུའི་སྐུ་ཚབ་པ་བཅུ་གཉིས་ཀྱི་མིང་བཀོད་ཡོད་དོ།།"]},{"type":"verse","number":15,"content":["བདག་ལ་གཏམ་སྨྲ་མཁན་གྱིས་ཕྱག་ཏུ་གསེར་གྱི་ཐིག་ཤིང་བཟུང་སྟེ་གྲོང་ཁྱེར་དང་། མཁར་སྒོ། མཁར་གྱང་བཅས་ཀྱི་ཚད་ཐིག་འཇལ་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":16,"content":["གྲོང་ཁྱེར་དེ་ནི་གྲུ་བཞི་མ་སྟེ་སྲིད་ཞེང་གཉིས་འདྲའོ།། ཕོ་ཉས་ཕྱག་ཏུ་ཐིག་ཤིང་བཟུང་ནས་གྲོང་ཁྱེར་གྱི་ཚད་ཐིག་འཇལ་བ་ལ་རྒྱང་གྲགས་ཆིག་ཁྲི་ཉིས་སྟོང་ལྷག་ཡིན། སྲིད་ཞེང་མཐོ་གསུམ་འདྲའོ།།"]},{"type":"verse","number":17,"content":["ཡང་ཁོང་གིས་གྲོང་ཁྱེར་གྱི་མཁར་གྱང་གི་ཚད་ཐིག་འཇལ་བ་ལ། མིའི་ཚད་གཞི་བཞིན་ཏེ་ཕོ་ཉའི་ཚད་གཞི་ལྟར་ན་ཁྲུ་བརྒྱ་དང་ཞེ་བཞི་མཆིས།"]},{"type":"verse","number":18,"content":["མཁར་གྱང་ནི་གཡང་ཊི་སྔོན་པོས་བཟོས་ཤིང་། གྲོང་ཁྱེར་ནི་གསེར་སྦྱངས་བཙོ་མས་བཟོས་པ་དང་ཆུ་ཤེལ་ལྟར་དྭངས་ཤིང་གསལ།"]},{"type":"verse","number":19,"content":["མཁར་གྱང་གི་རྟིང་གཞི་ནི་རིན་པོ་ཆེ་སྣ་ཚོགས་ཀྱིས་བརྒྱན་ཞིང་། རྟིང་གཞི་དང་པོ་ནི་གཡང་ཊི་སྔོན་པོ་དང་། གཉིས་པ་ནི་ཨིནྡྲ་ནཱི་ལ། གསུམ་པ་ནི་པད་མ་རཱ་ག བཞི་པ་ནི་མ་རྒད།"]},{"type":"verse","number":20,"content":["ལྔ་པ་ནི་མཆོང་། དྲུག་པ་ནི་པདྨ་རཱ་ག བདུན་པ་ནི་བཻཌཱུརྱ་སུ་ག་ཏ། བརྒྱད་པ་ནི་བཻཌཱུརྱ་ལྗང་སེར། དགུ་པ་ནི་སྤྲིན་རྡོ། བཅུ་པ་ནི་བཻཌཱུརྱ་ལྗང་དཀར། བཅུ་གཅིག་པ་ནི་རྟ་ཀླད་སྨུག་པོ། བཅུ་གཉིས་པ་ནི་མུ་མེན་བཅས་ཡིན།"]},{"type":"verse","number":21,"content":["མཁར་སྒོ་བཅུ་གཉིས་ནི་མུ་ཏིག་བཅུ་གཉིས་ཡིན་ཞིང་། མཁར་སྒོ་རེ་རེ་མུ་ཏིག་རེ་རེས་བཟོས་པ་དང་། གྲོང་ཁྱེར་ནང་གི་སྲང་ལམ་ནི་གསེར་སྦྱངས་བཙོ་མས་བཟོས་པ་དང་ཆུ་ཤེལ་ལྟར་དྭངས་ཤིང་གསལ་ལོ།།"]},{"type":"verse","number":22,"content":["བདག་གིས་གྲོང་ཁྱེར་ནང་དུ་མཆོད་ཁང་ཡོད་པ་མ་མཐོང་ངོ་།། རྒྱུ་མཚན་ནི་གཙོ་བོ་དཀོན་མཆོག་སྟེ་ཀུན་དབང་དེ་ཉིད་དང་ལུ་གུ་ནི་གྲོང་ཁྱེར་གྱི་མཆོད་ཁང་ཡིན་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":23,"content":["དཀོན་མཆོག་གི་གཟི་བརྗིད་ཀྱིས་འོད་ཟེར་འཕྲོ་བ་དང་ལུ་གུ་ནི་གྲོང་ཁྱེར་གྱི་སྒྲོན་མེ་ཡིན་པས། གྲོང་ཁྱེར་ནང་དུ་ཉི་ཟླའི་འོད་ཟེར་མཁོ་བ་མེད།"]},{"type":"verse","number":24,"content":["རྒྱལ་ཁབ་ཐམས་ཅད་ནི་གྲོང་ཁྱེར་གྱི་འོད་ཟེར་ལ་བརྟེན་ནས་སྐྱོད་ཅིང་། ས་སྟེང་གི་རྒྱལ་པོ་ཐམས་ཅད་ཀྱིས་རང་གི་གཟི་བརྗིད་གྲོང་ཁྱེར་དེ་ལ་འབུལ་ངེས་ཡིན།"]},{"type":"verse","number":25,"content":["གྲོང་ཁྱེར་གྱི་མཁར་སྒོ་ནི་ཉིན་མོར་ཅིས་ཀྱང་མི་གཏན་ཏེ། གནས་དེར་མཚན་མོ་མེད་པའི་ཕྱིར་རོ།།"]},{"type":"verse","number":26,"content":["མི་རྣམས་ཀྱིས་རྒྱལ་ཁབ་ཐམས་ཅད་ཀྱི་གཟི་བརྗིད་དང་གུས་བཀུར་བཅས་གྲོང་ཁྱེར་དེ་ལ་འབུལ་ངེས་ཡིན།"]},{"type":"verse","number":27,"content":["མི་གཙང་བའམ། ཡང་ན་ཞེན་ལོག་པ་དང་རྫུན་གྱི་ལས་བྱེད་མཁན་སུ་ཡིན་ཡང་གྲོང་ཁྱེར་དེའི་ནང་དུ་འགྲོ་མི་ནུས་ཏེ། ལུ་གུའི་ཚེ་སྲོག་གི་གླེགས་བམ་ནང་དུ་མིང་ཐོ་བཀོད་ཡོད་པ་ཁོ་ན་དེའི་ནང་དུ་འགྲོ་ནུས་སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/REV/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/REV/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/REV/20.json","previousChapterAudioLinks":{},"numberOfVerses":27}