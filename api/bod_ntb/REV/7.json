{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"REV","translationId":"bod_ntb","name":"མངོན་པ།","commonName":"མངོན་པ།","title":"༄༅། །མངོན་པའི་མདོ།","order":66,"numberOfChapters":22,"sha256":"745c56df1cbb919f4d49a8997d03800f48f9ab12c1152162e126263a87b42c50","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bod_ntb/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"heading","content":["མི་ཆིག་འབུམ་བཞི་ཁྲི་བཞི་སྟོང་ལ་ཐམ་ག་བརྒྱབ་པ།"]},{"type":"verse","number":1,"content":["དོན་དེའི་རྗེས་སུ། ཕོ་ཉ་བཞི་ནི་ས་གཞིའི་ཟུར་བཞི་རུ་བཞེངས་ཡོད་དེ། ས་གཞི་དང་། རྒྱ་མཚོ། ཤིང་སྡོང་བཅས་ཀྱི་སྟེང་དུ་རླུང་མི་གཡུག་པའི་ཕྱིར། ས་སྟེང་གི་ཕྱོགས་བཞིའི་རླུང་དབང་དུ་བསྒྱུར་འདུག་པ་བདག་གིས་མཐོང་ངོ་༎"]},{"type":"verse","number":2,"content":["ཡང་ཕོ་ཉ་གཞན་ཞིག་ཤར་ཕྱོགས་ནས་ཡར་འོངས་ཤིང་གཏན་དུ་གསོན་པོར་བཞུགས་པའི་དཀོན་མཆོག་གི་ཐམ་ག་ཕྱག་ཏུ་ཐོགས་པ་བདག་གིས་མཐོང་། ཕོ་ཉ་དེས་ས་གཞི་དང་རྒྱ་མཚོ་ལ་གནོད་པ་བྱེད་པའི་དབང་ཐོབ་མཁན་གྱི་ཕོ་ཉ་བཞི་པོ་ལ་སྐད་ཆེན་པོས་འདི་སྐད་དུ།"]},{"type":"verse","number":3,"content":["ངེད་ཅག་གིས་རང་རེའི་དཀོན་མཆོག་གི་ཞབས་ཕྱི་པ་རྣམས་ཀྱི་དཔྲལ་བར་ཐམ་ག་བཀོད་རེག་བར་དུ། ཁྱོད་ཅག་གིས་ས་གཞི་དང༌། རྒྱ་མཚོ། ཤིང་སྡོང་དག་ལ་གནོད་འཚེ་མ་བྱེད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":4,"content":["དེ་ནས་བདག་གིས་ཡེས་ར་ཨེལ་བུ་རྒྱུད་ཀྱི་ཚོ་པ་ཐམས་ཅད་ལས་ཐམ་ག་བཀོད་པའི་མི་གྲངས་ཆིག་འབུམ་བཞི་ཁྲི་བཞི་སྟོང་ཡོད་པ་ཐོས་ཤིང་།"]},{"type":"verse","number":5,"content":["དེ་དག་ནི་འདི་ལྟ་སྟེ། ཡ་ཧུ་དཱ་ཚོ་པ་ལས་ཐམ་ག་བཀོད་པའི་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། རུ་བེན་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། གཱ་རྡུ་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་།"]},{"type":"verse","number":6,"content":["ཨ་ཤེར་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། ནཱབ་ཐ་ལི་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། མཱ་ན་ཤེ་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་།"]},{"type":"verse","number":7,"content":["སི་མུ་ཨོན་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། ལེ་ཝི་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། ཡེས་སི་ཀཱར་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང༌།"]},{"type":"verse","number":8,"content":["ཟེ་བུ་ལུན་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། ཡོ་སེབ་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་དང་། པེན་ཡཱ་མེན་ཚོ་པ་ལས་མི་ཆིག་ཁྲི་ཉིས་སྟོང་ཡོད་པ་བཅས་སོ།།"]},{"type":"heading","content":["ལྭ་རིང་དཀར་པོ་གྱོན་པའི་མི་ཚོགས་ཀྱི་སྐོར།"]},{"type":"verse","number":9,"content":["དོན་དེའི་རྗེས་སུ། ཡང་བདག་གིས་ཕར་བལྟས་པ་ན། ལྟོས་དང་། མི་ཤིན་ཏུ་མང་པོ་བགྲང་གིས་མི་ལང་བ་ཞིག་མཐོང་ཞིང་། དེ་རྣམས་ནི་མི་རིགས་སོ་སོ་དང་། ཚོ་པ་སོ་སོ། མི་སྡེ་སོ་སོ། སྐད་རིགས་སོ་སོ་བཅས་ནས་ཐོན་པ་དང་། བཞུགས་ཁྲི་དང་ལུ་གུའི་མདུན་དུ་ཡར་འགྲེང་ཞིང་། ལུས་ལ་ལྭ་རིང་དཀར་པོ་གྱོན་པ་དང་ལག་ཏུ་ཏ་ལའི་ཤིང་གི་ཡལ་ག་བཟུང་སྟེ།"]},{"type":"verse","number":10,"content":["སྐད་ཆེན་པོས་འདི་ལྟར་དུ་སྨྲས་པ།",{"text":"བཞུགས་ཁྲིའི་སྟེང་དུ་བཞུགས་པའི་རང་རེའི་དཀོན་མཆོག་དང་།།","poem":1},{"lineBreak":true},{"text":"ལུ་གུ་ལ་ནི་ཐར་པའི་དབང་དེ་གཏོགས་པ་ལགས།།","poem":1},"ཞེས་པའོ།།"]},{"type":"verse","number":11,"content":["དེ་ནས་ཕོ་ཉ་ཐམས་ཅད་བཞུགས་ཁྲི་དང་། རྒན་པོ་རྣམས། སེམས་ཅན་བཞི་པོ་བཅས་ཀྱི་མཐའ་འཁོར་དུ་ཡར་འགྲེངས་ནས་སྡོད་པ་དང་། ཡང་བཞུགས་ཁྲིའི་མདུན་དུ་ཕྱག་བཙལ་ནས་དཀོན་མཆོག་ལ་འདི་ལྟར་བསྟོད་བསྔགས་བརྗོད་པ་སྟེ།"]},{"type":"verse","number":12,"content":[{"text":"ཨ་མེན་བསྟོད་བསྔགས་གཟི་བརྗིད་མཁྱེན་རབ་དང་།།","poem":1},{"lineBreak":true},{"text":"ཐུགས་རྗེ་བསྙེན་བཀུར་དབང་ཐང་ནུས་མཐུ་བཅས།།","poem":1},{"lineBreak":true},{"text":"ཐམས་ཅད་ཇི་སྲིད་བར་དུ་བདག་ཅག་གི །","poem":1},{"lineBreak":true},{"text":"དཀོན་མཆོག་ཁོང་ལ་ཡོད་པར་གྱུར་ཅིག་ཨང་༎","poem":1},"ཨ་མེན་ཞེས་སོ།།"]},{"type":"verse","number":13,"content":["དེ་ནས་རྒན་པོ་རྣམས་ལས་གཅིག་ན་རེ། ལྭ་རིང་དཀར་པོ་གྱོན་མཁན་འདི་རྣམས་སུ་ཡིན་ནམ། གང་ནས་ཡོང་བ་ཡིན་ནམ་ཞེས་བདག་ལ་དྲིས་པ་ན།"]},{"type":"verse","number":14,"content":["ངས་ཁོང་ལ་འདི་ལྟར་སྨྲས་པ་སྟེ། བདག་པོ་ལགས། ཁྱེད་ཀྱིས་མཁྱེན་ནོ་ཞེས་པ་ལ། ཡང་ཁོང་གིས་འདི་སྐད་དུ། མི་འདི་རྣམས་ནི་དཀའ་སྡུག་ཆེན་པོའི་ཁྲོད་ནས་ཡོང་བ་ཡིན་ཞིང་། ལུ་གུའི་སྐུ་ཁྲག་གིས་ལྭ་རིང་པོ་གཙང་མར་བཀྲུས་ནས་དཀར་པོར་གྱུར་པ་ཡིན།"]},{"type":"verse","number":15,"content":["དེའི་ཕྱིར་ཁོ་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་བཞུགས་ཁྲིའི་མདུན་དང་། ཁོང་གི་མཆོད་ཁང་ནང་དུ་ཉིན་མཚན་མེད་པར་ཁོང་ལ་བསྙེན་བཀུར་ཞུ་བ་དང་། བཞུགས་ཁྲིའི་སྟེང་དུ་བཞུགས་མཁན་གྱིས་མི་དེ་རྣམས་ཀྱི་སྟེང་དུ་རང་ཉིད་ཀྱི་གུར་འགེབས་པར་འགྱུར་ཞིང་།"]},{"type":"verse","number":16,"content":["མི་དེ་རྣམས་ཀྱིས་དུས་ནམ་ཡང་བཀྲེས་སྐོམ་མི་མྱོང་ཞིང་། དེ་རྣམས་ལ་ཉི་ཟེར་དང་ཚ་ཟེར་གང་གིས་ཀྱང་གནོད་འཚེ་བྱེད་པར་མི་འགྱུར་རོ།།"]},{"type":"verse","number":17,"content":["ཅིའི་ཕྱིར་ཞེ་ན། བཞུགས་ཁྲིའི་དཀྱིལ་དུ་བཞུགས་པའི་ལུ་གུས་མི་དེ་རྣམས་འཚོ་སྐྱོང་མཛད་ནས། ཁོ་རྣམས་ཚེ་སྲོག་གི་ཆུ་མིག་རྣམས་ཀྱི་དྲུང་དུ་འཁྲིད་པར་མཛད་པ་དང་། དཀོན་མཆོག་གིས་ཀྱང་ཁོ་རྣམས་ཀྱི་མིག་ཆུ་ཐམས་ཅད་ཕྱི་བར་འགྱུར་ཞེས་སྨྲས་སོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}