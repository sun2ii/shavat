{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":11,"content":[{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་མི་རིགས་འཕྲོ་མ་སྐོར།"]},{"type":"verse","number":1,"content":["བདག་གིས་འདི་ལྟར་སྨྲ་བར་བྱ༌སྟེ། དཀོན་མཆོག་གིས་རང་ཉིད་ཀྱི་མི་རྣམས་སྤངས་སམ་ཞེ༌ན། གཏན་ནས་མ་སྤངས༌ཏེ། ང་རང་ཡང་ཡེས་ར་ཨེལ་གྱི་མི་ཡིན་པ་དང་ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་ཡིན༌ལ། པེན་ཡཱ་མེན་གྱི་ཚོ་པ་ལ་གཏོགས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་གིས་སྔར་ནས་མཁྱེན་པའི་རང་ཉིད་ཀྱི་མི་རྣམས་མ་སྤངས་སོ།། ཁྱོད་ཅག་གིས་གསུང་རབ་ལས་ཨེ་ལི་ཡཱའི་སྐོར་ལ་ཇི་ལྟར་གསུངས་པ་མི་ཤེས༌སམ། ཁོང་གིས་དཀོན་མཆོག་གི་སྤྱན་སྔ་ནས་ཡེས་ར་ཨེལ་པ་རྣམས་འདི་ལྟར་གཏུགས་བཤེར་བྱས་མྱོང་བ༌སྟེ།"]},{"type":"verse","number":3,"content":["གཙོ་བོ༌ལགས། ཁོ་རྣམས་ཀྱིས་ཁྱེད་ཀྱི་ལུང་སྟོན་པ་རྣམས་བསད་པ༌དང༌། ཁྱེད་ཀྱི་མཆོད་ཁྲི་དག་ཀྱང་བཤིགས་ཏེ་ང་རང་གཅིག་པུར༌ལུས། ད་ལྟ་བདག་གི་སྲོག་ཀྱང་ལེན་པར་འདོད་པ་རེད་ཅེས་ཞུས་པ༌ལ།"]},{"type":"verse","number":4,"content":["དཀོན་མཆོག་གིས་ལན་ཇི་ལྟར་བཏབ་བམ་ཞེ༌ན། འདི་སྐད་དུ། ངས་པཱ་ཨལ་ལ་ཕྱག་མ་བཙལ་བའི་མི་བདུན་སྟོང་རང་ཉིད་ཀྱི་དོན་དུ་བསྐྱུར་ཡོད་ཅེས་གསུངས་སོ།།"]},{"type":"verse","number":5,"content":["ད་ལྟའང་དེ་བཞིན་དུ་ཐུགས་རྗེ་ཡིས་བདམས་པ་འཕྲོ་མའང་ཡོད༌པ་ཡིན།"]},{"type":"verse","number":6,"content":["ཐུགས་རྗེ་ལས་བྱུང་བ་ཡིན་ན་མིའི་ལས་ལ་རག་ལས་པ་མིན། དེ་ལྟར་མིན་ཚེ་ཐུགས་རྗེ་ནི་ཐུགས་རྗེ་མ་ཡིན་ནོ།།"]},{"type":"verse","number":7,"content":["དེས་ན་ཅི་ལྟར་ཡིན་ནམ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱིས་བརྩོན་ལེན་བྱས་ཀྱང་མ་ཐོབ༌པར། ཐུགས་རྗེ་ཡིས་བདམས་པའི་མི་དེ་དག་ཁོ་ནར་ཐོབ་པ༌དང༌། གཞན་དག་ནི་སེམས་རྒྱུད་གྱོང་པོར་མཛད་དོ།།"]},{"type":"verse","number":8,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དཀོན་མཆོག་གིས་ནི་དེ་རྣམས༌ལ།།","poem":1},{"lineBreak":true},{"text":"རྨོངས་པའི་བློ་དང་མིག་ལོང༌བ།།","poem":1},{"lineBreak":true},{"text":"རྣ་བས་མི་ཐོས་འོན་པ༌བཅས།།","poem":1},{"lineBreak":true},{"text":"ད་ལྟའི་བར་དུ་འདི་ལྟར༌མཛད།།","poem":1},"ཅེས་བཀོད༌པ་བཞིན༌ནོ།།"]},{"type":"verse","number":9,"content":["དེ་ལ་དཱ་བིད་ཀྱིས་ཀྱང་འདི་སྐད༌དུ།",{"text":"དེ་རྣམས་གསོལ་ལྕོག་དེ་ཚོར་རྙི་རྒྱ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ལྕགས་ཀྱུ་དང་ནི་ས་རུ་འགྱེལ་བ༌ཡི།།","poem":1},{"lineBreak":true},{"text":"བཀག་རྡོར་གྱུར་ཅིང་ངན་འབྲས་ཐོབ་པ་དང་།།","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"དེ་རྣམས་མིག་ནི་ལོང་སྟེ་མི་མཐོང༌ཞིང༌།།","poem":1},{"lineBreak":true},{"text":"རྟག་ཏུ་སྒལ་ཚིགས་སྨད་དུ་བསྒུར་བར༌མཛོད།།","poem":1},"ཅེས་གསུངས༌པའོ།།"]},{"type":"heading","content":["ཡལ་ག་མཐུད་པའི༌དཔེ།"]},{"type":"verse","number":11,"content":["བདག་གིས་འདི་ལྟར་སྨྲ་བར་བྱ༌སྟེ། ཡེས་ར་ཨེལ་པ་རྣམས་ཀྱི་རྐང་པ་འདྲེད་པ་ནི་ས་ལ་འགྱེལ་བའི་ཕྱིར་ཡིན་ནམ་ཞེ༌ན། གཏན་ནས་མིན༌ཏེ། ཁོ་རྣམས་ཀྱི་ཉེས་སྐྱོན་གྱི་དབང་གིས་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་ཐར་པ་འཐོབ་པའི་གོ་སྐབས་བྱུང་བ༌དང༌། ཁོ་རྣམས་ལ་ཕྲག་དོག་བསྐྱེད་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":12,"content":["ཁོ་རྣམས་ཀྱི་ཉེས་སྐྱོན་ནི་འཇིག་རྟེན་ལ་ཐོབ་པའི་ནོར་བུ་དང༌། ཁོ་རྣམས་ཀྱི་གྱོང་གུད་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་ཐོབ་པའི་ནོར་བུ་ཡིན༌ན། ཁོ་རྣམས་ཁ་ཚང་བར་ཡོང་བ་ནི་ལྟ་ཅི༌སྨོས།"]},{"type":"verse","number":13,"content":["ངས་ཁྱོད་ཅག་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་འདི་ལྟར་སྨྲ་བ༌ནི། ང་རང་ཡང་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་ཆེད་དུ་སྐུ་ཚབ་པ་ཡིན༌པས། ངས་རང་གི་ལས་འགན་ལ་བརྩི་འཇོག་བྱེད་པ་ཡིན༌ལ།"]},{"type":"verse","number":14,"content":["ང་དང་ཤ་རུས་གཅིག་པའི་སྤུན་ཟླ་རྣམས་ལ་འགྲན་སེམས་བསྐྱེད་དུ་བཅུག་སྟེ། ཁོ་རྣམས་ལས་མི་ཁ་ཤས་སྐྱོབ་ནུས་ཀྱང་སྲིད།"]},{"type":"verse","number":15,"content":["ཁོ་རྣམས་སྤངས་པ་ནི་འཇིག་རྟེན་གྱི་མི་ཐམས་ཅད་དཀོན་མཆོག་དང་འདུམ་པའི་རྒྱུ་ཡིན༌ན། ཁོ་རྣམས་ཁས་ལེན་པ་ནི་འཆི་བ་ལས་སླར་གསོན་པ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":16,"content":["བག་ཕྱེ་ཐོག་མ་ནི་དམ་པ་ཡིན༌ན་བག་ཕྱེ་ཐམས་ཅད་ཀྱང་དམ་པ་ཡིན། ཤིང་སྡོང་གི་རྩ་བ་དམ་པ་ཡིན༌ན་ཡལ་གའང་དམ་པ་ཡིན་ནོ།།"]},{"type":"verse","number":17,"content":["འོན་ཀྱང་། ཡལ་ག་ཁ་ཤས་བཅད་པ་དང་། དེའི་ཤུལ་དུ་རི་སྐྱེས་སྐྱུ་རུ་ར་ཁྱོད་རང་ནི་ཁོ་རྣམས་དང་མཐུད་པ་དང་། ཁོ་རྣམས་དང་ལྷན་དུ་སྐྱུ་རུ་རའི་ཤིང་གི་རྩ་བའི་བཅུད་བཟང་ཐོབ་པ་ཡིན་ན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ཀྱིས་ཡལ་ག་རྣམས་ལ་ཁ་ཕོ་མ་བྱེད་ཅིག གལ་ཏེ་ཁ་ཕོ་བྱེད་ན། ཁྱོད་རང་རྩ་བར་བརྟེན་པ་ལས་རྩ་བ་ཁྱོད་ལ་བརྟེན་པ་མ་ཡིན་པ་ཤེས་དགོས་སོ།།"]},{"type":"verse","number":19,"content":["ཁྱོད་ན་རེ། ང་རང་དེའི་ཤུལ་དུ་མཐུད་པའི་ཕྱིར་ཡལ་ག་དེ་རྣམས་བཅད་པ་ཡིན་ཟེར་ན།"]},{"type":"verse","number":20,"content":["དེ་ནི་བདེན་པ་ཡིན། ཁོ་རྣམས་ཀྱིས་དད་པ་མ་བྱས་པའི་རྐྱེན་གྱིས་བཅད་པ་དང་། ཁྱོད་ཀྱིས་དད་པ་བྱེད་པའི་དབང་གིས་བརྟན་པོར་ཚུགས་པ་ཡིན་པས། ཁྱོད་ཀྱིས་ང་རྒྱལ་མི་བྱེད་པར་དཀོན་མཆོག་ལ་འཇིགས་པར་གྱིས་ཤིག"]},{"type":"verse","number":21,"content":["དཀོན་མཆོག་གིས་ཡལ་ག་དངོས་མ་དེ་རྣམས་མ་བསྐྱུར་བར་བཅད་པ་ཡིན་ན། ཁྱོད་རང་ཡང་མི་བསྐྱུར་བར་གཅོད་ཀྱང་སྲིད།"]},{"type":"verse","number":22,"content":["ལྟོས་དང་། དཀོན་མཆོག་གི་བྱམས་སྙིང་རྗེ་དང་དྲག་རྩུབ་ནི་འདི་ལྟ་སྟེ། ས་རུ་འགྱེལ་པ་རྣམས་ལ་དྲག་རྩུབ་ཡིན་པ་དང་། ཁྱོད་ནི་རྟག་ཏུ་ཁོང་གི་བྱམས་སྙིང་རྗེའི་ནང་དུ་གནས་ན། ཁྱོད་ལ་བྱམས་སྙིང་རྗེ་ལྡན་པར་འགྱུར། དེ་ལས་ལྡོག་ན་ཁྱོད་རང་ཡང་གཅོད་པར་འགྱུར་རོ།།"]},{"type":"verse","number":23,"content":["གལ་ཏེ། ཡེས་ར་ཨེལ་གྱི་མི་རིགས་ནི་རྟག་ཏུ་དད་པ་མེད་པར་བསྡད་པ་མ་ཡིན་ན། དཀོན་མཆོག་གིས་ཁོ་རྣམས་ཡང་བསྐྱར་མཐུད་ནུས་པས་སྔར་བཞིན་མཐུད་པར་འགྱུར།"]},{"type":"verse","number":24,"content":["ཁྱོད་ནི་རང་བཞིན་གྱི་རི་སྐྱེས་སྐྱུ་རུ་རའི་ཤིང་ལས་བཅད་ནས། རང་བཞིན་ལས་ལྡོག་སྟེ་བདག་གཉེར་བྱེད་པའི་སྐྱུ་རུ་རའི་ཤིང་ལ་མཐུད་པ་ཡིན་ན། ཡལ་ག་དངོས་མ་དེ་ནི་ལྷག་པར་རང་གི་རིགས་ཀྱི་སྐྱུ་རུ་རའི་ཤིང་ལ་མཐུད་ངེས་སོ།།"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་སྐྱོབ་པར་འགྱུར་བའི༌སྐོར།"]},{"type":"verse","number":25,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་གིས་རང་ཉིད་གྲུང་པོ་ཡིན་པར་མི་བསམ་པའི༌ཕྱིར། བདག་གིས་གསང་བ་འདི་ཁྱོད་རྣམས་ལ་ཤེས་སུ་འཇུག་པར་འདོད་དེ། ནང་དུ་ཡོང་བའི་ཕྱི་ཕྱོགས་པའི་གྲངས་ཀ་ཚང་བའི་བར༌དུ། ཡེས་ར་ཨེལ་མི་རིགས་ལས་སྐོར་ཞིག་གི་སེམས་རྒྱུད་གྱོང་པོ་ཡིན༌ནའང་།"]},{"type":"verse","number":26,"content":["ཕྱིས་སུ་ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཐར་བར་འགྱུར་རོ།། དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"ཛ་ཡན་ཡུལ་ནས་སྐྱབས་མགོན་ཕེབས་ངེས༌ཤིང༌།།","poem":1},{"lineBreak":true},{"text":"ཡ་ཀོབ་ཚང་གི་དད་གུས་མེད་པ་བསལ།།","poem":1},"ཞེས༌དང༌། ཡང་ཇི་སྐད༌དུ།"]},{"type":"verse","number":27,"content":[{"text":"བདག་གིས་དེ་དག་སྡིག་པ་བསལ་བའི༌དུས།།","poem":1},{"lineBreak":true},{"text":"དེ་ནི་ཁོ་ཚོའི་བར་གྱི་ཁ་ཆད༌ཡིན།།","poem":1},"ཞེས་བཀོད་པ་བཞིན༌ནོ།།"]},{"type":"verse","number":28,"content":["འཕྲིན་བཟང་གི་གསུང་ཚུལ་ལྟར་སྨྲས༌ན། ཁོ་རྣམས་ནི་ཁྱོད་ཅག་གི་ཕྱིར་དུ་དགྲ་རུ་གྱུར་པ༌དང༌། དཀོན་མཆོག་གིས་བདམས་པའི་གསུང་ཚུལ་ལྟར་སྨྲས༌ན། ཁོ་རྣམས་ནི་མེས་པོ་རྣམས་ཀྱི་ཕྱིར་དུ་གཅེས་སུ་འཛིན༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":29,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གིས་རང་གི་གནང་སྦྱིན་དང་ཞལ་འབོད་མཛད་པ་ནི་ཕྱིར་མི་ལེན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":30,"content":["སྔོན་ཆད་ཁྱོད་ཅག་གིས་དཀོན་མཆོག་གི་བཀའ་ལ་མ་མཉན་ཞིང༌། ད་ལྟ་ཁོ་རྣམས་ཀྱིས་མ་མཉན་པའི་རྐྱེན་གྱིས་ཁྱོད་ཅག་ལ་ཐུགས་རྗེ་གནང་བ༌བཞིན།"]},{"type":"verse","number":31,"content":["དེ་དག་གིས་ཀྱང་ཁོང་གི་བཀའ་ལ་མི་ཉན༌ཞིང༌། ཁྱོད་རྣམས་ལ་ཐུགས་རྗེ་གནང་བའི་རྐྱེན་གྱིས། ཁོ་རྣམས་ལའང་ཐུགས་རྗེ་གནང་བར་འགྱུར་རོ།།"]},{"type":"verse","number":32,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་མི་ཐམས་ཅད་ལ་ཐུགས་རྗེ་གནང་བའི༌ཕྱིར། མི་ཐམས་ཅད་ནི་བཀའ་ལ་མི་ཉན་པའི་གྲས་སུ་བཞག༌པའོ།།"]},{"type":"heading","content":["བསྟོད་བསྔགས་བརྗོད་པ།"]},{"type":"verse","number":33,"content":[{"text":"ཀྱེ་ཀྱེ་བླ་མེད་དཀོན་མཆོག༌གི།","poem":1},{"lineBreak":true},{"text":"མཁྱེན་རབ་དང་ནི་ཡོན་ཏན༌དེ།།","poem":1},{"lineBreak":true},{"text":"ཇི་འདྲའི་ཕུན་སུམ་ཚོགས་པ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"རྒྱ་ནི་ཆེ་ཞིང་གཏིང་ནི་ཟབ།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་དཔྱད་ཁྲ་དཔག་དཀའ༌ཞིང༌།།","poem":1},{"lineBreak":true},{"text":"ཁོང་གི་འཕྲིན་ལས་བསམ་མི་ཁྱབ།།","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"སུ་ཡིས་ཁོང་གི་ཐུགས་རྟོགས༌ཤིང༌།།","poem":1},{"lineBreak":true},{"text":"སུ་ཡིས་ཁོང་ལ་བློ་བཏོན༌ནམ།།","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ཁོང་གིས་མི་ལ་སྐྱིན་ཚབ་གནང་བའི༌ཕྱིར།།","poem":1},{"lineBreak":true},{"text":"སྔོན་དུ་ཁོང་ལ་ཕུལ་བ་སུ་ཡོད་དམ།།","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ཅི་ཡོད་ཐམས་ཅད་ཁོང་ལས་བྱུང་བ༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ཁོང་ལ་བརྟེན་ཅིང་ཁོང་ལ་དབང་བའི༌ཕྱིར།།","poem":1},{"lineBreak":true},{"text":"གཏན་དུ་ཁོང་ལ་བསྟོད་བསྔགས་བརྗོད་པར༌སྨོན།།","poem":1},"ཨ༌མེན།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/10.json","previousChapterAudioLinks":{},"numberOfVerses":36}