{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":14,"content":[{"type":"heading","content":["སྤུན་ཟླའི་དོན་ལ་ཁ་ཚོན་གཅོད་མི་རུང་བའི་སྐོར།"]},{"type":"verse","number":1,"content":["ཁྱོད་ཅག་གིས་དད་སེམས་ཆུང་བ་རྣམས་རང་གི་གྲས་སུ་ལོངས༌དང༌། འོན༌ཀྱང༌། བསམ་ཚུལ་མི་འདྲ་བ་ལ་རྩོད་པ་མ་བྱེད༌ཅིག"]},{"type":"verse","number":2,"content":["མི་ལ་ལ་དངོས་པོ་མཐའ་དག་ཟ་རུང་བར་ཡིད་ཆེས༌ནའང༌། དད་སེམས་ཆུང་བ་རྣམས་ཀྱིས་སྔོ་ཚལ་ལས་གཞན་ཅི་ཡང་མི༌ཟའོ།།"]},{"type":"verse","number":3,"content":["ཅི་ཡང་ཟ་བའི་མི་དག་གིས་མི་ཟ་བའི་མི་ལ་མཐོང་ཆུང་བྱེད་མི་རུང༌ལ། མི་ཟ་བའི་མི་དེ་ཡིས་ཅི་ཡང་ཟ་བའི་མི་ལ་ཁ་ཚོན་ཡང་གཅོད་མི་རུང༌སྟེ། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་སྔར་ནས་མི་དེ་ལ་དགྱེས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":4,"content":["ཁྱོད་ནི་སུ་ཞིག་ཡིན༌འདོད་དམ། ཁྱོད་ཀྱིས་མི་གཞན་གྱི་ཞབས་ཕྱི་པ་ལ་ཁ་ཚོན་གཅོད༌དམ། ཁོ་ནི་བརྟན་པོར་སྡོད་པའམ་ས་རུ་འགྱེལ་ནའང་ཁོ་ལ་བདག་པོ་ཡོད༌པ་དང་། ཁོ་ནི་བརྟན་པོར་སྡོད་སྲིད༌དེ། གཙོ་བོས་ཁོ་རང་བརྟན་པོར་མཛད་ནུས་པས་ཁོ་ནི་བརྟན་པོར་སྡོད་ངེས༌སོ།།"]},{"type":"verse","number":5,"content":["མི་ལ་ལས་ཉིན་མོ་འདི་ནི་ཉིན་མོ་དེ་ལས་ལེགས་པར་འདོད༌ཅིང༌། ཡང་མི་ལ་ལས་ཉིན་མོ་ཐམས་ཅད་གཅིག་མཚུངས་ཡིན་པར་འདོད༌པ་རེད། འོན༌ཀྱང་མི་རེ་རེའི་སེམས་པ་བརྟན་པོ་ཡིན་དགོས།"]},{"type":"verse","number":6,"content":["ཉིན་མོ་སྲུང་མཁན་གྱིས་གཙོ་བོའི་དོན་དུ་སྲུང༌ཞིང༌། ཟས་ཟ་མཁན་གྱིས་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་བ་ཡིན་པས་གཙོ་བོའི་དོན་དུ་ཟ་བ༌དང༌། ཟས་མི་ཟ་བ་དེས་ཀྱང་གཙོ་བོའི་དོན་དུ་མི་ཟ་ཞིང་དཀོན་མཆོག་ལ་བཀའ་དྲིན་ཞུ་བའོ།།"]},{"type":"verse","number":7,"content":["བདག་ཅག་ལས་རང་གི་དོན་དུ་འཚོ་བ་ནི་གཅིག་ཀྱང་མེད༌ལ། རང་གི་དོན་དུ་འཆི་བའང་གཅིག་ཀྱང་མེད།"]},{"type":"verse","number":8,"content":["བདག་ཅག་འཚོ་ན་གཙོ་བོའི་དོན་དུ་འཚོ༌ཞིང༌། ཤི་ནའང་གཙོ་བོའི་དོན་དུ་ཤི་བ་ཡིན༌པས། བདག་ཅག་ནི་ཤི་གསོན་གང་ཡིན་ཡང་གཙོ་བོའི་མི་ཡིན་ནོ།།"]},{"type":"verse","number":9,"content":["དེའི༌ཕྱིར། གསོན་པོ་དང་གཤིན་པོ་གཉིས་ཀྱི་གཙོ་བོར་འགྱུར་བའི༌ཕྱིར། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་སྐུ་གྲོངས་པ་ནས་སླར་གསོན༌པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེས་ན། ཁྱོད་ཀྱིས་ཅིའི་ཕྱིར་སྤུན་ཟླ་ལ་ཁ་ཚོན་གཅོད༌དམ། ཡང་ཅིའི་ཕྱིར་སྤུན་ཟླ་ལ་མཐོང་ཆུང་བྱེད༌དམ། རྒྱུ་མཚན་ནི་བདག་ཅག་ཐམས་ཅད་དཀོན་མཆོག་གི་ལེགས་ཉེས་ཀྱི་ཁྲིམས་ཐག་གཅོད་པའི་བཞུགས་ཁྲིའི་མདུན་དུ་ལངས་ནས་སྡོད་ངེས་སོ།།"]},{"type":"verse","number":11,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"གཙོ་བོ་དཀོན་མཆོག་གིས་ནི་འདི་སྐད༌དུ།།","poem":1},{"lineBreak":true},{"text":"བདག་གིས་རང་གི་ཚེ་སྲོག་དཔངས་བཙུགས་ནས།།","poem":1},{"lineBreak":true},{"text":"དམ་བཅའ་འདི་ལྟར་བཞག་པ་ཡིན་ལགས་ཏེ།།","poem":1},{"lineBreak":true},{"text":"པུས་མོ་ཀུན་གྱིས་བདག་ལ་ཕྱག་འཚལ༌ཞིང༌།།","poem":1},{"lineBreak":true},{"text":"ཀུན་གྱི་ངག་ནས་བདག་ནི་ཁས་ལེན༌བྱེད།།","poem":1},"ཅེས༌བཀོད་པའོ།།"]},{"type":"verse","number":12,"content":["དེའི༌ཕྱིར། བདག་ཅག་མི་རེ་རེས་རང་གི་དོན་རྣམས་དཀོན་མཆོག་གི་དྲུང་དུ་རྒྱུ་མཚན་གསལ་པོར་བཤད་པར་ངེས་སོ།།"]},{"type":"verse","number":13,"content":["དེ་ལྟར་ཡིན་པས། ཕྱིན་ཆད་བདག་ཅག་གིས་ཕན་ཚུན་ལ་ཁ་ཚོན་གཅོད་མི་རུང༌ལ། སུས་ཀྱང་སྤུན་ཟླའི་མདུན་དུ་བཀག་རྒྱའམ་ས་ལ་འགྱེལ་བྱེད་ཀྱི་དངོས་པོ་ཅི་ཡང་མི་འཇོག་པར་སེམས་ཐག་ཆོད༌ཅིག"]},{"type":"verse","number":14,"content":["མི་གཙང་བའི་དངོས་པོ་གཞི་ནས་མེད་པ་ནི་བདག་གིས་གཙོ་བོ་ཡེ་ཤུར་བརྟེན་ནས་ཤེས་ཤིང་དོན་དེར་ཡིད་ཆེས་བརྟན་པོ་ཡོད་དོ།། འོན༌ཀྱང༌། སུ་ཞིག་གིས་དངོས་པོ་གང་ཞིག་མི་གཙང་བར་བསམས༌ན། མི་དེའི་རྐྱེན་གྱིས་དངོས་པོ་དེ་ནི་མི་གཙང་བ་ཡིན།"]},{"type":"verse","number":15,"content":["གལ༌ཏེ། ཁྱོད་ཀྱི་ཁ་ཟས་ཀྱིས་སྤུན་ཟླའི་ཡིད་སྐྱོ་བར་བྱེད༌ན། དེ་ནི་བྱམས་པ་བཞིན་དུ་སྤྱད་པ་སྤྱོད་པ་མ་ཡིན། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་ཁོའི་དོན་དུ་སྐུ་གྲོངས༌པས། ཁྱོད་ཀྱི་ཁ་ཟས་ཀྱིས་སྤུན་ཟླ་དེ་ནི་འཕུང་དུ་འཇུག་མི་རུང་ངོ༌།།"]},{"type":"verse","number":16,"content":["དེའི་ཕྱིར། མི་གཞན་ལ་ཁྱོད་ཀྱི་བཟང་དེར་དམའ་འབེབས་བྱེད་དུ་འཇུག་མི་རུང༌སྟེ།"]},{"type":"verse","number":17,"content":["དཀོན་མཆོག་གི་རྒྱལ་སྲིད་ནི་བཟའ་བཏུང་ལ་བརྟེན་པ་མིན༌པར། དེ་ནི་དྲང༌བདེན་དང་ཞི༌བདེ། དམ་པའི་ཐུགས་ཉིད་ནང་གི་དགའ་སྤྲོ་བཅས་ལ་རག་ལས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":18,"content":["དོན་འདི་ལྟ་བུའི་སྟེང་ནས་སྐྱབས་མགོན་མཱ་ཤི་ཀར་ཞབས་ཕྱི་བྱས་ན། དཀོན་མཆོག་གི་ཐུགས་དགྱེས་ཤིང་མི་རྣམས་ཀྱིས་ཀྱང་ཁས་ལེན་ནོ།།"]},{"type":"verse","number":19,"content":["དེའི༌ཕྱིར། བདག་ཅག་གིས་ངེས་པར་འགྲིག་མཐུན་ཡོང་བ་དང་ཕན་ཚུན་ཡར་བསྐྱེད་པའི་དོན་དེར་བརྩོན་དགོས་པ༌ལས།"]},{"type":"verse","number":20,"content":["ཁ་ཟས་ཀྱི་དབང་གིས་དཀོན་མཆོག་གི་མཛད་འཕྲིན་ལ་གཏོར་བརླག་གཏོང་མི་རུང་ངོ༌།། དངོས་པོ་ཐམས་ཅད་གཙང་བ་ནི་སྨོས་མ་དགོས༌ཀྱང༌། སུ་ཞིག་གིས་ཁ་ཟས་ཀྱི་རྐྱེན་གྱིས་མི་གཞན་སར་འགྱེལ་དུ་འཇུག་པ་ཡིན༌ན། དེ་ནི་ཁོའི་ཉེས་སྐྱོན་ཡིན་ནོ།།"]},{"type":"verse","number":21,"content":["ཡང་ན་ཤ་ཟ་བ་དང་ཆང་འཐུང་བ་སོགས་དོན་གཞན་གང་ཡིན༌ཡང༌། སྤུན་ཟླ་སར་འགྱེལ་དུ་འཇུག་པ་ཡིན༌ན། དོན་དེ་ཐམས་ཅད་སྤང་ན་ལེགས།"]},{"type":"verse","number":22,"content":["ཁྱོད་ལ་ཡོད་པའི་དད་པ་དེ་དཀོན་མཆོག་གི་དྲུང་ནས་སེམས་སུ་ཟུངས༌ཤིག སུས་ཀྱང་རང་ཉིད་ཀྱིས་སྒྲུབ་ཆོག་པར་འདོད་པའི་དོན་གྱི་ཆ༌ནས། རང་གིས་རང་ལ་ཉེས་སྐྱོན་མི་འཛུགས་མཁན་ལ་བྱིན་རླབས་ཐོབ༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":23,"content":["གལ༌ཏེ། དོགས་པ་ཅན་གྱིས་ཟོས་ན། དེ་ནི་དད་པའི་སྒོ་ནས་ཟོས་པ་མ་ཡིན་པས་ཉེས་སྐྱོན་ཡོད་ངེས༌ལ། དད་པ་ལས་བྱུང་བ་མིན་པ་ཐམས་ཅད་ནི་སྡིག་པ་ཡིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/13.json","previousChapterAudioLinks":{},"numberOfVerses":23}