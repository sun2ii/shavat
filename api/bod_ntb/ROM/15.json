{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":15,"content":[{"type":"heading","content":["རང་ཉིད་དགའ་བར་བྱེད་མི་འོས་པའི༌སྐོར།"]},{"type":"verse","number":1,"content":["དེ་ཡང་བདག་ཅག་བརྟན་པོ་རྣམས་ཀྱིས་བརྟན་པོ་མིན་པ་རྣམས་ཀྱི་ཉམས་ཞན་ལ་བཟོད་བསྲན་བྱེད་འོས་པ༌ལས། རང་ཉིད་དགའ་བར་མི༌བྱའོ།།"]},{"type":"verse","number":2,"content":["བདག་ཅག་མི་རེ་རེས་རང་གི་ཁྱིམ་མཚེས་ལ་ཕན་འདོགས་པ་དང་ཡར་སྐྱེད་ཡོང་བའི༌ཕྱིར། ཁྱིམ་མཚེས་དགའ་བར་གྱིས༌ཤིག"]},{"type":"verse","number":3,"content":["ཅིའི་ཕྱིར་ཞེ་ན། སྐྱབས་མགོན་མཱ་ཤི་ཀས་ཀྱང་རང་ཉིད་དགའ་བར་མ་མཛད་པའི་ཕྱིར༌རོ།། དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁྱོད་ལ་དམའ་འབེབས་བྱེད་མཁན་གྱི་སྨྲ་བརྗོད་མཐའ་དག་ནི་བདག་ལ་ཕོག་པ་ཡིན་ཞེས་བཀོད་པ༌བཞིན་ནོ།།"]},{"type":"verse","number":4,"content":["རྒྱུ་མཚན་ནི་སྔོན་ཆད་ཡི་གེར་བཀོད་པ་ཐམས་ཅད་བདག་ཅག་ལ་བསླབ་བྱ་གནང་བའི་ཕྱིར་ཡིན༌ཏེ། བཟོད་པ་དང་གསུང་རབ་ལས་བྱུང་བའི་སེམས་གསོ་བརྒྱུད་ནས་བདག་ཅག་ལ་རེ་བ་ཐོབ་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":5,"content":["དེ་ཡང་བཟོད་པ་དང་སེམས་གསོ་གནང་མཁན་དཀོན་མཆོག་གིས་མཱ་ཤི་ཀ་ཡེ་ཤུ་བཞིན་དུ་ཁྱོད་རྣམས་ཕན་ཚུན་མཐུན་པར་མཛད་པར༌སྨོན།"]},{"type":"verse","number":6,"content":["དེ་ནི་ཁྱོད་ཅག་གིས་ཁ་ཞེ་གཉིས་མེད་སྒོས་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀའི་ཡབ་དཀོན་མཆོག་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":7,"content":["དེའི༌ཕྱིར། སྐྱབས་མགོན་མཱ་ཤི་ཀས་ཁྱོད་རྣམས་བསུས་པ༌བཞིན། ཁྱོད་ཅག་གིས་ཀྱང་ཕན་ཚུན་བསུས་ནས་དཀོན་མཆོག་གི་གཟི་བརྗིད་མངོན་པར༌བྱའོ།།"]},{"type":"verse","number":8,"content":["བདག་གིས་སྨྲ་བར་བྱ༌སྟེ། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ནི་དཀོན་མཆོག་གི་བདེན་པ་ཉིད་ཀྱི༌ཆེད་དུ། མཚན་སྐྱི་བཅད་པ་རྣམས་ལ་ཞབས་ཕྱི་སྒྲུབ་མཁན་དུ་གྱུར་ཅིང་། དེ་ནི་ཕ་མེས་ཡང་མེས་རྣམས་ལ་གནང་བའི་ཞལ་བཞེས་ཀྱི་བཀའ་རྣམས་ལ་བདེན་དཔང་མཛད༌པའི་ཕྱིར་དང་།"]},{"type":"verse","number":9,"content":["ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་ཐུགས་རྗེའི་རྐྱེན་གྱིས་ཁོང་ལ་བསྟོད་བསྔགས་བརྗོད་པའི་ཕྱིར་ཡང་ཡིན་ནོ།། དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"དེ་ཡི་ཕྱིར་ན་བདག་གིས༌ནི།།","poem":1},{"lineBreak":true},{"text":"ཕྱི་ཕྱོགས་པ་ཡི་ནང་ཁུལ༌དུ།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ལ་བསྔགས་བརྗོད་བྱེད་པ་དང་།།","poem":1},{"lineBreak":true},{"text":"ཁྱོད་མཚན་བསྟོད་དབྱངས་འབུལ་བར་བྱ།།","poem":1}]},{"type":"verse","number":10,"content":["ཡང་ཇི་སྐད༌དུ།",{"text":"ཁྱོད་ཅག་ཕྱི་ཕྱོགས་མི་རྣམས༌ནི།།","poem":1},{"lineBreak":true},{"text":"གཙོ་བོ་དཀོན་མཆོག༌ཁོང་ཉིད་ཀྱི།།","poem":1},{"lineBreak":true},{"text":"འབངས་མི་རྣམས་དང་ལྷན་ཅིག༌ཏུ།།","poem":1},{"lineBreak":true},{"text":"དགའ་ཞིང་སྤྲོ་བར་གྱུར་ཅིག༌གུ།།","poem":1}]},{"type":"verse","number":11,"content":["ཡང་ཇི་སྐད༌དུ།",{"text":"ཕྱི་མི་ཚང་མས་གཙོ་བོ༌ལ།།","poem":1},{"lineBreak":true},{"text":"བསྟོད་ཅིང་བསྔགས་པར་འོས་སོ༌ལོ།།","poem":1},{"lineBreak":true},{"text":"མི་རིགས་ཀུན་གྱིས་གཙོ་བོ༌ལ།།","poem":1},{"lineBreak":true},{"text":"བསྟོད་ཅིང་བསྔགས་པར་འོས་སོ༌ལོ།།","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ཡང་ཡེ་ཤ་ཡཱ་ཡིས་འདི་སྐད༌དུ།","poem":1},{"lineBreak":true},{"text":"མ་འོངས་པ་ན་ཡེ་སེ༌ཡི།།","poem":1},{"lineBreak":true},{"text":"རྩ་བ་དེ་ཡིས་ཕྱི་ཕྱོགས༌པར།།","poem":1},{"lineBreak":true},{"text":"དབང་སྒྱུར་བྱེད་ཅིང་དེ་རྣམས༌ཀྱིས།།","poem":1},{"lineBreak":true},{"text":"ཁོང་ལ་རེ་བ་འཛིན་པར༌ངེས།།","poem":1},"ཞེས༌གསུངས་པའོ།།"]},{"type":"verse","number":13,"content":["ཁྱོད་ཅག་ལ་དམ་པའི་ཐུགས་ཉིད་ཀྱི་མཐུ་སྟོབས་བརྒྱུད་ནས་རེ་བ་ཆེན་པོ་འཐོབ་པའི༌ཕྱིར། ད་ནི་རེ་བ་གནང་མཁན་དཀོན་མཆོག་གིས་ཁྱོད་རྣམས་ཀྱི་དད་པ་བརྒྱུད་ནས་ཁྱོད་ཅག་ལ་དགའ་སྤྲོ་དང་ཞི་བདེ་ཕུན་སུམ་ཚོགས་པ་གནང་བར༌སྨོན།"]},{"type":"heading","content":["ཕོལ་ལོལ་ཁོང་ཉིད་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་ཞབས་ཕྱི་པར་གྱུར༌པ།"]},{"type":"verse","number":14,"content":["སྤུན་ཟླ༌རྣམས། ཁྱོད་ཅག་ནི་བཟང་པོས་བལྟམས་ཤིང་། ཤེས་ཡོན་ཀུན་གྱིས་ཁྱབ་པ་དང་། ཕན་ཚུན་ལ་སྐུལ་མའང་གཏོང་ཐུབ་པར་བདག་ལ་ཡིད་ཆེས་བརྟན་པོ་ཡོད༌མོད།"]},{"type":"verse","number":15,"content":["འོན་ཀྱང་ངས་ཁྱོད་ཅག་ལ་དྲན་སྐུལ་བྱེད་པའི༌ཕྱིར། དོན་ཁ་ཤས་ཀྱི་ཆེད་དུ་སྤོབས་པ་བསྐྱེད་ནས་འཕྲིན་ཡིག་འདི་བྲིས་པ༌དང༌། ཁྱད་པར་དཀོན་མཆོག་གིས་ང་རང་ལ་ཐུགས་རྗེ་གནང་བ་བཞིན༌དུ།"]},{"type":"verse","number":16,"content":["མཆོད་དཔོན་ལྟར་དཀོན་མཆོག་གི་འཕྲིན་བཟང་ལ་ཞབས་ཕྱི་བྱས་ནས། བདག་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་དོན་དུ་མཱ་ཤི་ཀ་ཡེ་ཤུའི་ཞབས་ཕྱི་པ་ཡིན་ལ། དེ་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་དམ་པའི་ཐུགས་ཉིད་ཀྱི་སྒོ་ནས་དམ་པར་མཛད༌དེ། དཀོན་མཆོག་ཐུགས་མཉེས་པའི་མཆོད་རྫས་སུ་འགྱུར་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":17,"content":["དེ་བས་དཀོན་མཆོག་གི་མཛད་དོན་སྐོར་གླེང༌ན། མཱ་ཤི་ཀ་ཡེ་ཤུའི་ནང་དུ་བདག་ལ་ངོམ་ཆོག་པ་ཞིག་ཡོད་ལ།"]},{"type":"verse","number":18,"content":["སྐྱབས་མགོན་མཱ་ཤི་ཀས་ང་རང་བརྒྱུད་ནས་མཛད་པའི་དོན་དག་ལས༌གཞན། ངས་ཅི་ཡང་གླེང་མི་ཕོད༌དེ། ཁོང་གིས་ངའི་སྨྲ་བརྗོད་དང་བྱ་སྤྱོད་བརྒྱུད༌ནས།"]},{"type":"verse","number":19,"content":["གྲུབ་རྟགས་དང་ངོ་མཚར་ཅན་གྱི་དོན་རྣམས་ཀྱི་ནུས་མཐུ་དང༌། དམ་པའི་ཐུགས་ཉིད་ཀྱི་ནུས་མཐུའི་སྒོ་ནས། ཕྱི་ཕྱོགས་པ་རྣམས་དཀོན་མཆོག་གི་བཀའ་ལ་བསྟུན་པར་མཛད། ཐ་ན་བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ནས་ཨིལ་ལི་རི་ཀུམ་ཡུལ་བར་དུ་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་འཕྲིན་བཟང་ཡོངས་སུ་བསྒྲགས་སོ།།"]},{"type":"verse","number":20,"content":["ཡང་མི་གཞན་གྱིས་བཙུགས་པའི་རྨང་གཞིའི་སྟེང་དུ་མི་བརྩིག་པའི༌ཕྱིར། བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་མཚན་ཐོས་མ་མྱོང་བའི་ཡུལ་གྲུར་འཕྲིན་བཟང་བསྒྲག་རྒྱུའི་བློ་ཐག་བཅད་པ་ཡིན།"]},{"type":"verse","number":21,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"ཁོང་ལ་རྒྱུས་མེད་རྣམས་ཀྱིས་མཐོང་འགྱུར༌ཞིང༌།།","poem":1},{"lineBreak":true},{"text":"གོ་ཐོས་མེད་པ་རྣམས་ཀྱིས་རྟོགས་པར༌འགྱུར།།","poem":1},"ཞེས་བཀོད་པ་བཞིན༌ནོ།།"]},{"type":"verse","number":22,"content":["ང་རང་ཐེངས་མང་པོར་བཀག་བྱུང་བས། ཁྱོད་ཅག་གི་མདུན་དུ་གཏན་ནས་འགྲོ་མ་ནུས༌སོ།།"]},{"type":"heading","content":["རོ་མཱ་གྲོང་ཁྱེར་དུ་འགྲོ་བའི་འཆར༌གཞི།"]},{"type":"verse","number":23,"content":["འོན་ཀྱང་། ད་ལྟ་ཡུལ་འདི་དག་ཏུ་ང་ལ་ལས་དོན་སྒྲུབ་ས་གཞན་མེད༌དེ། ལོ་དུ་མའི་རིང༌ལ། བདག་ནི་སི་ཕེན་ཡཱ་ཡུལ་དུ་འགྲོ་བའི་དུས་སུ་ཁྱོད་ཅག་གི་མདུན་དུ་ཡོང་འདོད་པ༌དང༌།"]},{"type":"verse","number":24,"content":["ཁྱོད་ཅག་གི་ཡུལ་དེ་བརྒྱུད་ནས་ཁྱོད་རྣམས་ལ་འཕྲད་པར་འགྱུར་བ་དང༌། ཐོག་མར་ཕན་ཚུན་འབྲེལ་འདྲིས་བྱས་ཏེ་ཅུང་ཙམ་ཡིད་ཚིམས༌རྗེས། ཁྱོད་རྣམས་ཀྱིས་ང་རང་ལ་སྐྱེལ་མ་བྱེད་པར་རེ་བ་བྱེད།"]},{"type":"verse","number":25,"content":["འོན༌ཀྱང༌། ད་ནི་ང་རང་ཡེ་རུ་སཱ་ལེམ་དུ་དད་ལྡན་དམ་པ་རྣམས་ལ་རོགས་རམ་བྱེད་དུ༌འགྲོའོ།།"]},{"type":"verse","number":26,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མ་ཀེ་དོན་ཡཱ་དང་ཨ་ཀ་ཡཱ་ཡུལ་གཉིས་ཀྱི་མི་རྣམས་ཀྱིས་ཡེ་རུ་སཱ་ལེམ་དུ་ཡོད་པའི་དད་ལྡན་དམ་པ་རྣམས་ཀྱི་ཁྲོད་ནས་དབུལ་པོ་རྣམས་ལ་སྦྱིན་པ་གཏོང་འདོད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":27,"content":["དེ་ནི་ཁོ་རྣམས་དགའ་བར་གྱུར་པ་སྨོས་མ་དགོས༌ཏེ། དོན་ལ་དེ་ནི་བུ་ལོན་ལྟ་བུའང་ཡིན། ཅིའི་ཕྱིར་ཞེ་ན། ཕྱི་ཕྱོགས་པ་རྣམས་ལ་ཡ་ཧུ་དཱ་པའི་སེམས་ཉིད་ཀྱི་བགོ་སྐལ་བཟང་པོ་ཐོབ་ཡོད༌ན། དེ་ཚོས་ཀྱང་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་འཚོ་བྱེད་ཀྱི་དངོས་པོ་སྦྱིན་པ་གཏོང་འོས་སོ།།"]},{"type":"verse","number":28,"content":["དེའི༌ཕྱིར། བདག་གིས་དོན་འདི་བསྒྲུབས་ཏེ་ཞལ་འདེབས་འདི་ཁོ་རྣམས་ལ་རྩིས་གསལ་པོར་སྤྲད༌རྗེས། ང་རང་ཁྱོད་ཅག་གི་ཡུལ་བརྒྱུད་ནས་སི་ཕེན་ཡཱ་ཡུལ་དུ་འགྲོ་བར༌བྱ།"]},{"type":"verse","number":29,"content":["ང་རང་ཁྱོད་ཅག་གི་ཡུལ་དེར་ཡོང་བའི་དུས༌སུ། སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ཕུན་སུམ་ཚོགས་པའི་བྱིན་རླབས་དང་བཅས་ཏེ་ཡོང་ངེས་པ་ནི་བདག་གིས་ཤེས༌སོ།།"]},{"type":"verse","number":30,"content":["སྤུན་ཟླ༌རྣམས། ངས་བདག་ཅག་གི་གཙོ་བོ་ཡེ་ཤུ་མཱ་ཤི་ཀ་དང་དམ་པའི་ཐུགས་ཉིད་ཀྱི་བྱམས་པར་བརྟེན༌ནས། ཁྱོད་རྣམས་ཀྱིས་བདག་གི་དོན༌དུ། བདག་དང་ལྷན་དུ་དཀོན་མཆོག་ལ་གསོལ་བ་འདེབས་པར་བརྩོན་དགོས་ཞེས་བསྐུལ༌ཏེ།"]},{"type":"verse","number":31,"content":["བདག་ནི་ཡ་ཧུ་དཱའི་ཡུལ་གྱི་བཀའ་ལ་མི་ཉན་པའི་མི་རྣམས་ལས་ཐར་བ༌དང༌། ངས་ཡེ་རུ་སཱ་ལེམ་གྱི་དོན་དུ་བསྡུས་པའི་ཞལ་འདེབས་དེ་དད་ལྡན་དམ་པ་རྣམས་ཀྱིས་དགའ་སྤྲོའི་ངང་ནས་ལེན་པ༌དང༌།"]},{"type":"verse","number":32,"content":["བདག་ནི་དཀོན་མཆོག་གི་ཐུགས་དགོངས་བཞིན༌དུ། དགའ་དགའ་སྤྲོ་སྤྲོའི་ངང་ཁྱོད་ཅག་གི་ཡུལ་དེར་ཡོང་སྟེ། ཁྱོད་རྣམས་དང་མཉམ་དུ་ངལ་གསོ་འཐོབ་པ་བཅས་ཀྱི་ཕྱིར་གསོལ་བ་འདེབས་པར༌གྱིས།"]},{"type":"verse","number":33,"content":["ཞི་བདེ་གནང་མཁན་དཀོན་མཆོག་ནི་ཁྱོད་ཅག་ཐམས་ཅད་དང་མཉམ་དུ་བཞུགས་པར༌སྨོན། ཨ༌མེན།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}