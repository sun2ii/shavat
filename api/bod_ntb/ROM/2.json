{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":2,"content":[{"type":"heading","content":["དཀོན་མཆོག་གིས་ཁྲིམས་ཐག་གཅོད་པར་འགྱུར་བའི་སྐོར།"]},{"type":"verse","number":1,"content":["དེ་བས་ན་མི་ལ་ཁ་ཚོན་གཅོད་མཁན་ཁྱོད་ནི་སུ་ཡིན་ཡང་ཁག་དཀྲི་ས་མེད༌དེ། ཁྱོད་ཀྱིས་དོན་གང་གི་ཆ་ནས་མི་ལ་ཁ་ཚོན་བཅད༌ན། དོན་དེའི་སྟེང་ནས་ཁྱོད་ཀྱིས་རང་གིས་རང་ལའང་ཉེས་ཆད་བཅད༌དོ།། ཅིའི་ཕྱིར་ཞེ་ན། ཁྱོད་ཀྱིས་མི་ལ་ཁ་ཚོན་གཅོད་ནའང་། རང་གི་སྤྱོད་པ་ནི་མི་གཞན་དང་མཚུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":2,"content":["དཀོན་མཆོག་གིས་ལས་དེ་ལྟར་བྱེད་མཁན་ལ་ཁྲིམས་ཐག་གཅོད་པ་ནི་བདེན་པ་དང་མཐུན་པ་བདག་ཅག་གིས་ཤེས༌སོ།།"]},{"type":"verse","number":3,"content":["ཀྱེ་ཧོ། ཁྱོད་ཀྱིས་ལས་དེ་ལྟར་བྱེད་མཁན་ལ་ཁ་ཚོན་བཅད༌ནའང༌། རང་གི་སྤྱོད་པ་ནི་མི་གཞན་དང་མཚུངས༌པས། ཁྱོད་ནི་དཀོན་མཆོག་གི་ཁྲིམས་ཐག་ལས་ཤོར་ཐུབ་པར་འདོད་དམ།"]},{"type":"verse","number":4,"content":["ཡང་ན་ཁྱོད་ཀྱིས་དཀོན་མཆོག་གི་ཐུགས་རྗེ་ཆེན་པོ༌དང༌། བཟོད་སྒོམ། ངང་རྒྱུད་རིང་པོ་བཅས་ལ་མཐོང་ཆུང་བྱེད་པ༌དང༌། ཁོང་གི་ཐུགས་རྗེ་ཡིས་ཁྱོད་ནི་འགྱོད་བཤགས་ཀྱི་ལམ་དུ་ཁྲིད་པའང་མི་ཤེས༌སམ།"]},{"type":"verse","number":5,"content":["འོན༌ཀྱང༌། ཁྱོད་ཀྱིས་རང་གི་རྒྱུད་གྱོང་ཞིང་འགྱོད་བཤགས་མི་བྱེད་པའི་སེམས་རྒྱ་ཡན་དུ་བཏང་བས། དཀོན་མཆོག་གི་ཐུགས་ཁྲོའི་ཉིན་མོའི་ཆེད༌དུ། རང་གིས་རང་ལ་ཐུགས་ཁྲོ་གསོག་པར་བྱེད་ཅིང་། ཉིན་དེར་དཀོན་མཆོག་གི་དྲང་བདེན་གྱི་ཁྲིམས་ཐག་མངོན་པར་འགྱུར་ངེས༌ཤིང༌།"]},{"type":"verse","number":6,"content":["ཁོང་གིས་མི་རེ་རེའི་སྤྱོད་པ་བཞིན་དུ་ལན་གནང་བར་འགྱུར༌ཏེ།"]},{"type":"verse","number":7,"content":["སྙིང་རུས་ལ་བརྟེན་ནས་དོན་ལེགས་པོ་སྒྲུབ་ཅིང༌། གཟི་བརྗིད་དང་བཀུར༌བསྟི། འཇིག་པ་མེད་པ་བཅས་འཚོལ་མཁན་རྣམས་ལ་མཐའ་མེད་པའི་ཚེ་སྲོག་གནང་བར་འགྱུར་མོད།"]},{"type":"verse","number":8,"content":["འོན༌ཀྱང༌། སྒེར་སེམས་བཅངས་ནས་བདེན་པ་ཉིད་ལ་བློ་མི་བསྟུན༌པར། དྲང་བདེན་མ་ཡིན་པར་བློ་བསྟུན་མཁན་རྣམས་ལ་ཐུགས་ཁྲོ་དང་ཁྲོ་གཏུམ་འཕོག་པར་འགྱུར་རོ།།"]},{"type":"verse","number":9,"content":["དེ་ཡང་དཀའ་སྡུག་དང་དཀའ་ངལ་ནི་ངན་པའི་ལས་བྱེད་མཁན་ཐམས་ཅད༌དེ། ཐོག་མར་ཡ་ཧུ་དཱ་པ་དང་ཕྱིས་སུ་གྷི་རིག་པ་རྣམས་ལ་སྦྱོར་བར་འགྱུར༌མོད།"]},{"type":"verse","number":10,"content":["འོན༌ཀྱང༌། གཟི་བརྗིད་དང་བཀུར༌བསྟི། ཞི་བདེ་བཅས་ནི་ལས་བཟང་པོ་བྱེད་མཁན་ཐམས་ཅད༌དེ། ཐོག་མར་ཡ་ཧུ་དཱ་པ་དང་ཕྱིས་སུ་གྷི་རིག་པ་རྣམས་ལ་གནང་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["རྒྱུ་མཚན་ནི་དཀོན་མཆོག་ལ་ཕྱོགས་རིས་མེད་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":12,"content":["བཀའ་ཁྲིམས་མེད་པར་ཉེས་པ་བྱེད་མཁན་ཐམས་ཅད་ནི་བཀའ་ཁྲིམས་དང་བྲལ་ནས་འཇིག་པར་འགྱུར་བ༌དང༌། བཀའ་ཁྲིམས་ཡོད་ཀྱང་ཉེས་པ་བྱེད་མཁན་ཐམས་ཅད་ལ་བཀའ་ཁྲིམས་ལྟར་ཉེས་ཆད་གཅོད་པར་འགྱུར།"]},{"type":"verse","number":13,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གི་དྲུང་ནས་བཀའ་ཁྲིམས་ཐོས་པ་རྣམས་མི་རྣམ་དག་ཏུ་བརྩི་བ་མིན༌ལ། བཀའ་ཁྲིམས་ལྟར་བྱེད་པ་རྣམས་མི་རྣམ་དག་ཏུ་བརྩི་བར་འགྱུར་བའི་ཕྱིར་རོ།།"]},{"type":"verse","number":14,"content":["སྤྱིར་བཀའ་ཁྲིམས་མེད་པའི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་བཀའ་ཁྲིམས་ཀྱི་ནང་དོན་དག་རང་བཞིན་གྱིས་བསྒྲུབས་པ༌ན། མི་དེ་དག་ལ་བཀའ་ཁྲིམས་མེད༌ནའང༌། མི་རང་རང་ནི་རང་ཉིད་ཀྱི་བཀའ་ཁྲིམས་ཡིན་ལ།"]},{"type":"verse","number":15,"content":["མི་དེ་རྣམས་ཀྱིས་རང་གི་སེམས་སུ་བཀའ་ཁྲིམས་ཀྱི་ཕན་ནུས་བརྐོས་ཡོད་པ་མངོན་ཞིང་། ཁོ་རྣམས་ཀྱི་བསམ་པས་རང་ཉིད་ལ་བདེན་དཔང་བྱེད་ཅིང་། ཁོ་རྣམས་ཀྱི་དྲན་པས་སྐབས་འགར་རང་ལ་རང་སྐྱོན་བརྗོད་པ་དང་སྐབས་འགར་རང་ལ་དག་འབུད་བྱེད་པ་ཡིན་ནོ།།"]},{"type":"verse","number":16,"content":["བདག་གིས་སྒྲོག་པའི་འཕྲིན་བཟང༌བཞིན། དཀོན་མཆོག་གིས་མཱ་ཤི་ཀ་ཡེ་ཤུ་བརྒྱུད་ནས་མིའི་རིགས་ཀྱི་གསང་བའི་ལས་ལ་ཁྲིམས་ཐག་གཅོད་པའི་ཉིན་མོར་དེ་ལྟར་མཛད་པར་འགྱུར༌རོ།།"]},{"type":"heading","content":["ཡ་ཧུ་དཱ་པ་དང་བཀའ་ཁྲིམས་ཀྱི༌སྐོར།"]},{"type":"verse","number":17,"content":["ཁྱོད་ཀྱིས་རང་ཉིད་ལ་ཡ་ཧུ་དཱ་པ་ཟེར་བ་དང་བཀའ་ཁྲིམས་ལ་བརྟེན༌ཅིང༌། ངག་ལས་དཀོན་མཆོག་གི་ཕྱོགས་ནས་ཁ་ཕོ་བརྗོད་པ་དང་།"]},{"type":"verse","number":18,"content":["ཁྱོད་ལ་བཀའ་ཁྲིམས་ལས་བསླབ་བྱ་ཐོབ་ཅིང་། དཀོན་མཆོག་གི་དགོངས་པ་ཤེས་ཤིང་ཡིན་མིན་བདེན་རྫུན་ཡང་ཤེས༌པ་དང་།"]},{"type":"verse","number":19,"content":["ཡང་རང་ཉིད་ནི་ལོང་བ་རྣམས་ཀྱི་ལམ་ཁྲིད་པ་དང་། མུན་ནག་ནང་དུ་སྡོད་པའི་མི་རྣམས་ཀྱི་འོད་ཟེར༌དང༌།"]},{"type":"verse","number":20,"content":["བླུན་པོ་དག་གི་སློབ༌དཔོན། བྱིས་པ་རྣམས་ཀྱི་དགེ༌རྒན། བཀའ་ཁྲིམས་ཀྱི་ཐད་ནས་ཤེས་ཡོན་ཕུན་སུམ་ཚོགས་པ་ལྡན་པ་དང་བདེན་པ་ཉིད་ཀྱི་མིག་དཔེ་བཅས་ཡིན་པར་ཡིད་ཆེས་བརྟན་པོ་ཡོད།"]},{"type":"verse","number":21,"content":["དེས་ན། ཁྱོད་ཀྱིས་མི་གཞན་ལ་ཁྲིད་སྟོན་བྱེད་ཀྱང་རང་ལ་ཁྲིད་སྟོན་མི་བྱེད་པ༌ཅི། ཁྱོད་ཀྱིས་མི་གཞན་ལ་རྐུ་མ་བྱེད་ཅེས་སྒྲོག་ཀྱང་རང་གིས་རྐུ་བྱེད་པ༌ཅི།"]},{"type":"verse","number":22,"content":["ཁྱོད་ཀྱིས་མི་གཞན་ལ་ལོག་གཡེམ་མ་བྱེད་ཅེས་སྨྲས་ཀྱང་རང་གིས་ལོག་གཡེམ་བྱེད་པ༌ཅི། ཁྱོད་ནི་ལྷ་སྐུར་ཞེན་པ་ལོག་ཀྱང་ལྷ་ཁང་ལས་དངོས་པོ་རྐུ་བ༌ཅི།"]},{"type":"verse","number":23,"content":["ཁྱོད་ཀྱིས་ངག་ལས་བཀའ་ཁྲིམས་ཀྱི་ཕྱོགས་ནས་ཁ་ཕོ་བརྗོད་ཀྱང་། བཀའ་ཁྲིམས་དང་འགལ་བའི་ལས་བྱས་ནས་དཀོན་མཆོག་ལ་དམའ་འབེབས་བྱེད་པ་ཡིན་ནམ།"]},{"type":"verse","number":24,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཁྱོད་ཅག་གི་རྐྱེན་གྱིས་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱིས་དཀོན་མཆོག་གི་མཚན་ལ་སྐུར་བ་བཏབ་པ་ཡིན་ཞེས༌བཀོད་ཡོད་པ་བཞིན༌ནོ།།"]},{"type":"verse","number":25,"content":["གལ༌ཏེ། ཁྱོད་ཀྱིས་བཀའ་ཁྲིམས་ལྟར་བྱེད་ན་མཚན་སྐྱི་གཅོད་པ་ནི་ཁྱོད་ལ་ཕན་ཐོགས་ཡོད༌ལ། ཁྱོད་ཀྱིས་བཀའ་ཁྲིམས་དང་འགལ་བར་བྱེད་ན། ཁྱོད་ཀྱིས་མཚན་སྐྱི་བཅད་པ་ནི་མཚན་སྐྱི་གཅོད་པ་དངོས་མིན།"]},{"type":"verse","number":26,"content":["དེའི༌ཕྱིར། མཚན་སྐྱི་མ་བཅད་པ་ཞིག་གིས་བཀའ་ཁྲིམས་ཀྱི་ནང་དོན་བསྲུངས༌ན། མི་དེ་ཡིས་མཚན་སྐྱི་མ་བཅད་ནའང་མཚན་སྐྱི་བཅད་པ་ཞིག་ཏུ་བརྩི་བ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":27,"content":["གལ༌ཏེ། མཚན་སྐྱི་མ་བཅད་པ་ཞིག་གིས་བཀའ་ཁྲིམས་བསྲུངས༌ན། ཁྲིམས་ཡིག་ཡོད་པ་དང་མཚན་སྐྱི་གཅོད་པའི་ལུགས་སྲོལ་ཡོད་བཞིན༌དུ། ད་དུང་བཀའ་ཁྲིམས་དང་འགལ་བར་བྱེད་མཁན་ཁྱོད་ལ་མི་དེ་ཡིས་ཁྲིམས་ཐག་གཅོད་པར་འགྱུར་བ་མ་ཡིན༌ནམ།"]},{"type":"verse","number":28,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཕྱིའི་རྣམ་པ་ཡ་ཧུ་དཱ་པ་ཡིན་ན་ཡ་ཧུ་དཱ་པ་དངོས་མིན༌ལ། ཕྱིའི་ལུས་ཕུང་ལ་མཚན་སྐྱི་གཅོད་པ་ནི་མཚན་སྐྱི་བཅད་པ་དངོས་མིན་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":29,"content":["འོན༌ཀྱང༌། ནང་སེམས་ནས་ཡ་ཧུ་དཱ་པ་ཡིན་པ་ནི་ད་གཟོད་ཡ་ཧུ་དཱ་པ་དངོས་ཡིན༌ལ། མཚན་སྐྱི་གཅོད་པའང་ནང་སེམས་དང་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན་པ་ལས་ཁྲིམས་ཡིག་ལ་བརྟེན་པ་མ་ཡིན་པས། མི་དེའི་རིགས་ཀྱི་བསྟོད་པ་ནི་མི་ལས་བྱུང་བ་མ་ཡིན་པར་དཀོན་མཆོག་ནས་བྱུང་བའོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/1.json","previousChapterAudioLinks":{},"numberOfVerses":29}