{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":3,"content":[{"type":"heading","content":["དཀོན་མཆོག་ནི་ཡིད་རྟོན་རུང་བ་ཡིན་པ།"]},{"type":"verse","number":1,"content":["དེས་ན་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་བཟང་ཆ་ཅི་ཡོད་པ༌དང༌། མཚན་སྐྱི་གཅོད་པ་ལ་ཕན་ཡོན་ཅི་ཡོད་ཅེ༌ན།"]},{"type":"verse","number":2,"content":["ཕྱོགས་གང་གི་ཆ་ནས་ཀྱང་ཕན་ནུས་ཆེན་པོ་ཡོད༌དེ། ཕན་ནུས་གཙོ་བོ་ནི་དཀོན་མཆོག་གི་གསུང་མོལ་ཡ་ཧུ་དཱ་པ་རྣམས་ལ་བཅོལ་བ༌དེ་ཡིན་ནོ།།"]},{"type":"verse","number":3,"content":["དཀོན་མཆོག་ལ་དད་པ་མི་བྱེད་པ་འགའ་ཤས་ཡོད་ན་མི་འགྲིག་པ་ཅི་ཡོང་། མི་དེ་རྣམས་ལ་དད་པ་མེད་པའི་རྐྱེན་གྱིས་དཀོན་མཆོག་གི་ལྷག་བསམ་ཡང་མེད་པར་བཟོའམ་ཞེ༌ན།"]},{"type":"verse","number":4,"content":["གཏན་ནས་མི་བཟོ༌སྟེ། དཀོན་མཆོག་ནི་དངོས་གནས་བདེན་པ་ཡིན༌ཞིང་མིའི་རིགས་ཐམས་ཅད་ནི་རྫུན་བཤད་མཁན་ཡིན་པར་ངེས་སོ།། དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"ཁྱེད་ཀྱིས་བཀའ་བཀྱོན་གནང་བའི་དུས།།","poem":1},{"lineBreak":true},{"text":"ལྷག་བསམ་རྣམ་དག་མངོན་པར༌འགྱུར།།","poem":1},{"lineBreak":true},{"text":"ཁྱེད་ལ་ཁ་ཚོན་གཅོད་པའི༌དུས།།","poem":1},{"lineBreak":true},{"text":"ཁྱེད་ནི་རྣམ་པར་རྒྱལ་བར༌འགྱུར།།","poem":1},"ཞེས༌བཀོད་པའོ།།"]},{"type":"verse","number":5,"content":["བདག་གིས་མིའི་བཤད་སྲོལ་ལྟར་སྨྲ་བར་བྱ༌སྟེ། བདག་ཅག་གི་རང་གཤིས་མི་དྲང་བ་འདིས་དཀོན་མཆོག་གི་རྣམ་པར་དག་པ་མངོན་པར་གྱུར༌ན། བདག་ཅག་གིས་ཅི་ལྟར༌སྨྲའམ། ཐུགས་ཁྲོ་འབེབ་པར་མཛད་པའི་དཀོན་མཆོག་ནི་རྣམ་དག་མིན་ནམ་ཞེ་ན།"]},{"type":"verse","number":6,"content":["དེ་ལྟར་གཏན་ནས་སྨྲ་མི་རུང༌། གལ་ཏེ་རྣམ་དག་མིན་ཚེ། དཀོན་མཆོག་གིས་འཇིག་རྟེན་ཡོངས་ལ་ཁྲིམས་ཆད་ཅི་ལྟར་གཅོད༌དམ།"]},{"type":"verse","number":7,"content":["གལ་ཏེ་ངའི་རྫུན་གྱི་སྒོ་ནས་དཀོན་མཆོག་གི་བདེན་པ་ལྷག་ཏུ་མངོན་ཞིང་ཁོང་གི་གཟི་བརྗིད་ཀྱང་འཕེལ་བར་བྱེད༌ན། ཅིའི་ཕྱིར་བདག་ལ་ཉེས་ཅན་བཞིན་དུ་ཉེས་ཆད་གཅོད༌དམ།"]},{"type":"verse","number":8,"content":["ཅིའི་ཕྱིར་ངེད་ཅག་གིས་དོན་བཟང་འབྱུང་བའི་ཕྱིར་དོན་ངན་སྒྲུབ་པ་ཡིན་ཞེས་མི༌སྨྲའམ། དེ་ནི་ཕྲ་མ་བྱེད་མཁན་དུ་མས་ངེད་ཅག་ལ་དེ་ལྟར་སྨྲས་པ་ཡིན༌ལ། མི་དེ་ལྟ་བུ་རྣམས་ལ་ཁྲིམས་ཆད་འཕོག་འོས༌སོ།།"]},{"type":"heading","content":["མི་གཞུང་དྲང་གཅིག་ཀྱང་མེད་པ།"]},{"type":"verse","number":9,"content":["དེས་ན་ཅི་ལྟར་ཡིན་ནམ། བདག་ཅག་ནི་ཁོ་རྣམས་ལས་ཀྱང་བཟང་པོ་ཡིན་ནམ་ཞེ༌ན། གཏན་ནས་མ་ཡིན་ནོ།། རྒྱུ་མཚན་ནི་ངེད་ཅག་གིས་བདེན་དཔང་བྱས་ཟིན༌ཏེ། ཡ་ཧུ་དཱ་པ་དང་གྷི་རིག་པ་ཐམས་ཅད་སྡིག་པའི་འོག་ཏུ་ཡོད་པ་ཡིན།"]},{"type":"verse","number":10,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ།",{"text":"གཞུང་དྲང་མི་ནི་ཡོད་པ་མ་ཡིན་ལ༎","poem":1},{"lineBreak":true},{"text":"དེ་འདྲ་གཅིག་ཀྱང༌ཡོད་པ་མ་ཡིན་ནོ༎","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"གོ་བ་ཡོད་པའི་མི་ནི་གཅིག་ཀྱང་མེད།།","poem":1},{"lineBreak":true},{"text":"དཀོན་མཆོག་འཚོལ༌མཁན་མི་ཡང་གཅིག་ཀྱང་མེད།།","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ཐམས་ཅད་ཁོང་དང་བྲལ་ནས་ལོག་ལམ༌ཞུགས།།","poem":1},{"lineBreak":true},{"text":"དེ་འདྲའི་སྐྱེ་བོ་ཚང་མ་མཁོ་མེད་གྱུར།།","poem":1},{"lineBreak":true},{"text":"ལས་བཟང་སྒྲུབ་མཁན་ཡོད་པ་མ་ཡིན་ལ༎","poem":1},{"lineBreak":true},{"text":"དེ་འདྲ་གཅིག་ཀྱང༌ཡོད་པ་མ་ཡིན་ནོ།།","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"སྐྱེ་བོ་དེ་ཡི་མིད་ཐག་ཕྲ་མོ༌ནི།།","poem":1},{"lineBreak":true},{"text":"སྒོ་ཆེན་ཕྱེ་བའི་དུར་ཁུང་དང༌མཚུངས་ཤིང་།།","poem":1},{"lineBreak":true},{"text":"ལྕེ་ལ་བརྟེན་ནས་གཡོ་སྒྱུའི་སྦྱོར་བ༌སྤེལ།།","poem":1},{"lineBreak":true},{"text":"ཁ་ཡི་ནང་དུ་དུག་སྦྲུལ་རླངས་པ༌འཕྱུར།།","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ངག་ཏུ་སྡིགས་དམོད་དང་ནི་ཚིག་རྩུབ་གང་།།","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"དམར་གསོད་ལས་ལ་རྐང་པ་ཕྱོགས་བཞིར༌བྲེལ།།","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"བརྒྱུགས་ཤུལ་ཀུན་ཏུ་དྲག་རྩུབ་སྡུག་གིས༌ཁྱབ།།","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ཞི་བདེའི་ལམ་ནི་དེ་ཚོས་མི་རྟོགས་ཤིང་།།","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"དེ་ཚོའི་མིག་མདུན་དཀོན་མཆོག་འཇིགས་པ་མེད།།","poem":1},"ཅེས་བཀོད་པའོ།།"]},{"type":"verse","number":19,"content":["དེ་ཡང་བཀའ་ཁྲིམས་ཀྱི་གསུང་མོལ་ཐམས་ཅད་ནི་བཀའ་ཁྲིམས་འོག་ཏུ་གནས་པ་རྣམས་ལ་གསུངས་པ་བདག་ཅག་གིས་ཤེས༌ཤིང་། དེ་ནི་མི་རེ་རེའི་སྨྲ་སྒོ་བཅད་ནས་འཇིག་རྟེན་པ་ཐམས་ཅད་དཀོན་མཆོག་གི་ཉེས་ཁྲིམས་འོག་ཏུ་འཇུག་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":20,"content":["དེ་བས་བཀའ་ཁྲིམས་ནི་མི་ལ་སྡིག་པ་ཤེས་སུ་འཇུག་པའི་ཕྱིར་ཡིན༌པས། མི་སུ་ཡིན་ཡང་བཀའ་ཁྲིམས་ལྟར་བསྒྲུབས༌པ་ལ་བརྟེན་ནས། དཀོན་མཆོག་གི་སྤྱན་སྔར་རྣམ་དག་ཏུ་བརྩི་ཐུབ་པ་གཅིག་ཀྱང་མེད༌དོ།།"]},{"type":"heading","content":["དད་པའི་དབང་གིས་མི་རྣམ་དག་ཏུ་བརྩི༌བ།"]},{"type":"verse","number":21,"content":["འོན་ཀྱང་། ད་ལྟ་དཀོན་མཆོག་གི་རྣམ་པར་དག་པ་ནི་བཀའ་ཁྲིམས་ལ་མི་བརྟེན་པ་གསལ་པོར་མངོན་པ༌དང༌། བཀའ་ཁྲིམས་དང་ལུང་སྟོན་པའི་མདོ་རྣམས་ཀྱིས་ཀྱང་བདེན་དཔང་བྱེད༌དེ།"]},{"type":"verse","number":22,"content":["དཀོན་མཆོག་གི་རྣམ་པར་དག་པ་ནི་ཡེ་ཤུ་མཱ་ཤི་ཀར་དད་པ་བྱས་པ་བརྒྱུད་ནས་ཐོབ་ཅིང་། དད་པ་བྱེད་མཁན་ཐམས་ཅད་ལ་ཁྱད་པར་མེད་པར་གནང༌ངོ་༎"]},{"type":"verse","number":23,"content":["ཅིའི་ཕྱིར་ཞེ་ན། མི་ཐམས་ཅད་ཀྱིས་སྡིག་པ་བྱས་ཏེ་དཀོན་མཆོག་གི་གཟི་བརྗིད་དང་བྲལ༌ནའང༌།"]},{"type":"verse","number":24,"content":["ད་ལྟ་ཁོང་གི་ཐུགས་རྗེའི་རྐྱེན་དང་། མཱ་ཤི་ཀ་ཡེ་ཤུས་བླུས་པ་ལ་བརྟེན་ནས་རིན་མེད་དུ་མི་རྣམ་དག་ཏུ་བརྩིས་པའི་ཕྱིར༌ཡིན།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་གིས་སྐྱབས་མགོན་ཡེ་ཤུའི་སྐུ་ཁྲག་ལ་བརྟེན་ཅིང་མིའི་དད་པ་བརྒྱུད་ནས། སྐྱབས་མགོན་ཡེ་ཤུ་ནི་མིའི་མིག་མདུན་དུ་ཉེས་ཆད་བསལ་བའི་མཆོད་རྫས་སུ་གསལ་པོར་བཤམས་སོ།། དེ་ནི་དཀོན་མཆོག་གི་རྣམ་པར་དག་པ་གསལ་པོར་མངོན༌པའི་ཕྱིར་ཡིན། རྒྱུ་མཚན་ནི་དཀོན་མཆོག་གིས་བཟོད་པ་བསྒོམས་ནས་མིས་སྔར་བྱས་ཀྱི་སྡིག་པར་གུ་ཡངས་གནང་བ་སྟེ།"]},{"type":"verse","number":26,"content":["ད་ལྟ་ཁོང་གི་རྣམ་པར་དག་པ་གསལ་པོར་མངོན་པ་དང་། མི་རྣམས་ལ་ཁོང་ཉིད་ནི་རྣམ་པར་དག་པ་ཡིན་ཞིང༌། སྐྱབས་མགོན་ཡེ་ཤུ་ལ་དད་པ་བྱེད་མཁན་རྣམས་མི་རྣམ་དག་ཏུ་བརྩི་མཁན་ཡང་ཡིན་པ་ཤེས་སུ་འཇུག་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":27,"content":["དེ་འདྲ་ཡིན་ན་རང་གིས་རང་ལ་བསྟོད་འོས་པ་ཅི་ཡོད་དམ་ཞེ༌ན། རང་བསྟོད་བྱ་འོས་པ་ཅི་ཡང་མེད་དོ།། འོ་ན་རང་བསྟོད་བྱ་མི་འོས་པ་ཐབས་གང་ཞིག་ལ་བརྟེན་པ་ཡིན༌ནམ། རང་བྱས་ཀྱི་ལས་ལ་བརྟེན་པའི་ཐབས་བཀོལ་བ་ཡིན་ནམ་ཞེ༌ན། དེ་ཡང་མིན༌ཏེ། དད་པ་ལ་བརྟེན་པའི་ཐབས་བཀོལ་བ་ཡིན།"]},{"type":"verse","number":28,"content":["དེའི༌ཕྱིར། ངེད་ཅག་གིས་མཐའ་གཅིག་ཏུ་ངོས་བཟུང་བ་ནི། མི་རྣམ་དག་ཏུ་བརྩི་བ་ཐམས་ཅད་དད་པ་ལ་བརྟེན་པ་ལས་བཀའ་ཁྲིམས་བརྩི་སྲུང་བྱས་པར་རག་ལས་པ་མ་ཡིན་ནོ།།"]},{"type":"verse","number":29,"content":["དེ་ཡང་དཀོན་མཆོག་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཁོ་ནའི་དཀོན་མཆོག་ཡིན༌ནམ། ཁོང་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་དཀོན་མཆོག་ཀྱང་མ་ཡིན་ནམ་ཞེ༌ན། ཁོང་ནི་ཕྱི་ཕྱོགས་པ་རྣམས་ཀྱི་དཀོན་མཆོག་ཀྱང་ཡིན་ནོ།།"]},{"type":"verse","number":30,"content":["དཀོན་མཆོག་ནི་གཅིག་རང་ཡིན་པས། ཁོང་གིས་མཚན་སྐྱི་བཅད་པ་རྣམས་དད་པའི་དབང་གིས་མི་རྣམ་དག་ཏུ་བརྩི༌ཞིང༌། མཚན་སྐྱི་མ་བཅད་པ་རྣམས་ཀྱང་དད་པའི་དབང་གིས་མི་རྣམ་དག་ཏུ་བརྩི་ངེས༌ཡིན་ནོ།།"]},{"type":"verse","number":31,"content":["དེས་ན་བདག་ཅག་གིས་དད་པ་བརྒྱུད་ནས་བཀའ་ཁྲིམས་མེད་པར་བཟོའམ་ཞེ༌ན། གཏན་ནས་མི་བཟོ་སྟེ། བཀའ་ཁྲིམས་དེ་ལས་ཀྱང་བརྟན་པོར་བྱེད་པ་ཡིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/2.json","previousChapterAudioLinks":{},"numberOfVerses":31}