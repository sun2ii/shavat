{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ROM","translationId":"bod_ntb","name":"རོ་མཱ་པ།","commonName":"རོ་མཱ་པ།","title":"༄༅། །རོ་མཱ་པ་རྣམས་ལ་སྤྲིངས་པའི་འཕྲིན་ཡིག","order":45,"numberOfChapters":16,"sha256":"3468af534923bede580d0276134b638720a978bb7ba583a39359719017b3f4b4","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/bod_ntb/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":9,"content":[{"type":"heading","content":["དཀོན་མཆོག་ལ་ཐག་གིས་གཅོད་པའི་དབང་ཐམས་ཅད་མངའ་བ།"]},{"type":"verse","number":1,"content":["བདག་གིས་སྐྱབས་མགོན་མཱ་ཤི་ཀའི་ནང་དུ་བདེན་གཏམ་བརྗོད་པ་ལས་རྫུན་མི་སྨྲ༌ཞིང༌། བདག་གི་སེམས་ཀྱིས་དམ་པའི་ཐུགས་ཉིད་ལ་བརྟེན་ནས་བདག་ལ་བདེན་དཔང་བྱེད་པ་ཡིན་ཏེ།"]},{"type":"verse","number":2,"content":["བདག་གི་སེམས་སུ་སྡུག་བསྔལ་ཆེ་ཞིང་རྟག་ཏུ༌སྐྱོའོ།།"]},{"type":"verse","number":3,"content":["བདག་དང་རིགས་རྒྱུད་གཅིག་པའི་སྤུན་ཟླའི་དོན༌དུ། རང་ཉིད་ལ་དམོད་པ་ཐེབས་ཞིང་སྐྱབས་མགོན་མཱ་ཤི་ཀ་དང་བྲལ་ནའང་བདག་ལ་འགྱོད་པ་མེད༌དེ།"]},{"type":"verse","number":4,"content":["མི་དེ་རྣམས་ནི་ཡེས་ར་ཨེལ་གྱི་མི་རིགས་ཡིན༌ཞིང༌། བུ་སྐལ་གྱི་མིང་དང་། གཟི༌བརྗིད། ཞལ༌ཆད་རྣམས། བཀའ༌ཁྲིམས་གཏན་ལ་འབེབས་པ། གུས་སྲོལ། ཞལ་བཞེས་ཐམས་ཅད་དེ་དག་གི་ཡིན༌ལ།"]},{"type":"verse","number":5,"content":["མེས་པོ་རྣམས་ཀྱང་དེ་དག་གི་མེས་པོ་ཡིན། ལུས་ཕུང་གི་ཆ་ནས་སྨྲས༌ནའང༌། སྐྱབས་མགོན་མཱ་ཤི་ཀ་ཡང་དེ་རྣམས་ལས་བྱུང༌ཞིང༌། ཁོང་ནི་ཀུན་ལས་བླ་ན་འཕགས་པ་དང་དུས་རྟག་ཏུ་བསྔགས་པར་འོས་པའི་དཀོན་མཆོག་ལགས༌སོ། །ཨ༌མེན།"]},{"type":"verse","number":6,"content":["དེ་ལྟར་སྨྲས་པ་ནི་དཀོན་མཆོག་གི་བཀའ་སྟོང་བར་གྱུར་པ་མ་ཡིན་ནོ།། རྒྱུ་མཚན་ནི་ཡེས་ར་ཨེལ་ནས་སྐྱེས་པ་ཐམས་ཅད་ཡེས་ར་ཨེལ་གྱི་མི་ཡིན་པའི་ངེས་པ་མེད༌ལ།"]},{"type":"verse","number":7,"content":["ཨབ་ར་ཧམ་གྱི་རིགས་རྒྱུད་ཡིན་པ་ཐམས་ཅད་ཀྱང་ཁོང་གི་བུ་ཕྲུག་ཡིན་པར་མ་ངེས་པའི་ཕྱིར༌རོ། །དེ་ལ་ཇི་སྐད༌དུ། ཨི་སཱག་བརྒྱུད་ནས་ཁྱོད་ཀྱི་རིགས་རྒྱུད་ཀྱི་མིང་ཐོན་པར་འགྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":8,"content":["དེ་ནི་ལུས་ཕུང་ལས་སྐྱེས་པའི་བུ་དང་བུ་མོ་རྣམས་དཀོན་མཆོག་གི་བུ་ཕྲུག་མ་ཡིན༌ཞིང༌། ཞལ་བཞེས་ཐོབ་པ་རྣམས་ནི་ད་གཟོད་རིགས་རྒྱུད་དུ་བརྩིས༌པ་ཡིན།"]},{"type":"verse","number":9,"content":["ཅིའི་ཕྱིར་ཞེ་ན། ཞལ་བཞེས་གནང་བའི་བཀའ་ནི་འདི་ལྟ༌སྟེ། སང་ལོའི་དུས་འདི༌ལ་ང་རང་ཡོང་ངེས༌ཤིང༌། སཱ་ར་ལ་བུ་ཞིག་སྐྱེ་བར་འགྱུར་ཞེས་གསུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":10,"content":["གཞན༌ཡང༌། རིབ་ཀཱ་ནི་བདག་ཅག་གི་མེས་པོ་ཨི་སཱག་གཅིག་པུ་ལས་མངལ་ཆགས༌ཏེ།"]},{"type":"verse","number":11,"content":["སྐབས་དེར་བུ་མཚེ་མ་སྐྱེས་མེད་ཅིང་ལས་བཟང་ངན་གང་ཡང་མ་བྱས་པའི་སྔོན་ལ། དཀོན་མཆོག་གིས་བདམས་པར་མཛད་པའི་ཐུགས་དགོངས་མངོན་ཞིང་བརྟན་པོར་གནས་པའི༌ཕྱིར། མིའི་བྱ་སྤྱོད་ལ་འབྲེལ་བ་མེད་ཅིང་མི་ལ་ཞལ་འབོད་གནང་མཁན་དཀོན་མཆོག་ལ་རག་ལས༌པ་ཡིན་ལ།"]},{"type":"verse","number":12,"content":["དཀོན་མཆོག་གིས་རིབ་ཀཱ་ལ་འདི་སྐད༌དུ། མ་འོངས་པར་བུ་ཆེ་བས་བུ་ཆུང་བ་ལ་ཞབས་ཕྱི་བྱེད་པར་འགྱུར་ཞེས་གསུངས་སོ།།"]},{"type":"verse","number":13,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ཡ་ཀོབ་ནི་བདག་གིས་གཅེས་སུ་འཛིན་པ༌དང༌། ཨེ་སཱབ་ནི་བདག་གིས་འཁོན་དུ་འཛིན་པ་ཡིན་ཞེས་བཀོད་ཡོད་པ་བཞིན༌ནོ།།"]},{"type":"verse","number":14,"content":["དེས་ན་ངེད་ཅག་གིས་ཅི་ཞིག་སྨྲའམ། དཀོན་མཆོག་ལ་དྲང་བདེན་མ་ཡིན་པ་ཡོད་དམ་ཞེ༌ན། གཏན་ནས་མེད་དོ།།"]},{"type":"verse","number":15,"content":["ཅིའི་ཕྱིར་ཞེ་ན། དཀོན་མཆོག་གིས་མོ་ཤེ་ལ་འདི་སྐད༌དུ། ངས་སུ་ཞིག་ལ་སྙིང་རྗེ་བར་འདོད་ན་དེ་ལ་སྙིང་རྗེ་བར༌བྱའོ།། ཡང་སུ་ཞིག་ལ་བརྩེ་བར་བསམ་ན་དེ་ལ་བརྩེ་བར་བྱའོ་ཞེས་གསུངས་པས༌སོ།།"]},{"type":"verse","number":16,"content":["དེའི༌ཕྱིར། དོན་དེ་ནི་ཐུགས་རྗེ་གནང་མཁན་དཀོན་མཆོག་ལ་རག་ལས་པ༌ལས། མིའི་འདོད་པའམ་རྩོལ་བ་ལ་རག་མི་ལས་པ་ཡིན།"]},{"type":"verse","number":17,"content":["རྒྱུ་མཚན་ནི་གསུང་རབ་ཀྱི་མདོ༌ལས། ཕཱར་ཨོལ་ལ་འདི་སྐད༌དུ། ཁྱོད་ཀྱི་སྟེང་ནས་བདག་གི་མཐུ་སྟོབས་མངོན་པར་བྱེད༌ཅིང༌། བདག་གི་མིང་ནི་གནམ་འོག་ཀུན་ཏུ་བསྒྲག་པའི་ཕྱིར་བདག་གིས་ཁྱོད་དར་བར་བྱས༌པ་ཡིན་ཞེས་གསུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":18,"content":["དེ་བས༌ན། དཀོན་མཆོག་གིས་སུ་ཞིག་ལ་ཐུགས་རྗེ་གནང་བར་དགོངས་ན་དེ་ལ་ཐུགས་རྗེ་གནང་བ༌དང༌། སུ་ཞིག་གི་སེམས་རྒྱུད་གྱོང་པོར་མཛད་པར་དགོངས༌ན་དེའི་སེམས་རྒྱུད་གྱོང་པོར་མཛད༌པའོ།།"]},{"type":"verse","number":19,"content":["དེ་ལྟར༌ཡིན་ན། དཀོན་མཆོག་གིས་ཅིའི་ཕྱིར་ད་དུང་མི་ལ་སྐྱོན་བརྗོད་གནང་བ་ཡིན༌ནམ། སུ་ཞིག་གིས་ཁོང་གི་ཐུགས་དགོངས་ལ་རྒོལ་ནུས་སམ་ཞེས་ཁྱོད་ཀྱིས་བདག་ལ་སྨྲ་ངེས་པ་ཡིན་ནོ།།"]},{"type":"verse","number":20,"content":["འོན་ཀྱང་། ཁྱོད་ནི་མི་སུ་ཞིག་ཡིན༌འདོད་དམ། ཁྱོད་ཀྱིས་དཀོན་མཆོག་ལ་ཚིག་ལོག་བརྗོད་ནུས༌སམ། དཔེར་ན། བསྐྲུན་པའི་དངོས་པོ་དེས་སྐྲུན་མཁན༌ལ། ཁྱེད་ཀྱིས་ཅིའི་ཕྱིར་ང་རང་འདི་ལྟར་བཟོས་སམ་ཞེས༌སྨྲའམ།"]},{"type":"verse","number":21,"content":["ཡང་ན་རྫ་ཆས་བཟོ་མཁན་གྱིས་འདམ་ཉུང་ཙམ་བླངས་ནས་སྣོད་ཆས་བཟོས་ཏེ་མཆོག་དམན་གང་ཞིག་ཏུ་བཀོལ་བའི་དབང་ཆ་ཁོ་ལ་མེད༌དམ།"]},{"type":"verse","number":22,"content":["འོན་ཀྱང་། དཀོན་མཆོག་གིས་རང་ཉིད་ཀྱི་ཐུགས་ཁྲོ་དང་ནུས་མཐུ་མངོན་པར་དགོངས༌ན། ཐུགས་ཁྲོ་བར་རུང་ཞིང་འཇིག་པར་འགྱུར་བར་སྟ་གོན་མཛད་པའི་སྣོད་ཆས་དག་ལ་ངང་རྒྱུད་རིང་པོས་བཟོད་སྒོམ་ཆེན་པོ་གནང་བ༌དང༌།"]},{"type":"verse","number":23,"content":["ཡང་ཁོང་གིས་ཕུན་སུམ་ཚོགས་པའི་གཟི་བརྗིད་དེ་ནི་ཐུགས་རྗེ་འཐོབ་པར་འགྱུར་བའི་སྣོད་ཆས་དག་གི་སྟེང་དུ་མངོན་པའི་ཕྱིར་དེ་ལྟར་མཛད༌ཅིང༌། ཁོང་གིས་སྔ་མོ་ནས་དེ་དག་གཟི་བརྗིད་ལྡན་པར་འགྱུར་བའི་ཕྱིར་སྟ་གོན་མཛད༌པ་ཡིན་ཏེ།"]},{"type":"verse","number":24,"content":["སྣོད་ཆས་དེ་ནི་དཀོན་མཆོག་གིས་ཡ་ཧུ་དཱ་པ་ཙམ་མ༌ཟད། ཕྱི་ཕྱོགས་ཀྱི་མི་རིགས་དག་ལས་བདག་ཅག་ལ་ཞལ་འབོད་གནང་བ་ཡིན༌པས། དེ་ལ་མི་རུང་བ་ཅི་ཡོད་དམ་ཞེ༌ན།"]},{"type":"verse","number":25,"content":["དཀོན་མཆོག་གིས་ཧོ་ཤེ་ཨ་ཡི་མདོ་ལས་འདི་སྐད༌དུ།",{"text":"གཞི་ནས་བདག་གི་མི་སྡེ་མིན༌པ་རྣམས།།","poem":1},{"lineBreak":true},{"text":"བདག་གི་མི་སྡེ་ཡིན་ཞེས་བདག་གིས༌སྒྲོག །","poem":1},{"lineBreak":true},{"text":"གཞི་ནས་བརྩེ་བ་མེད་པའི་ཁོ་མོ༌ལ།།","poem":1},{"lineBreak":true},{"text":"བདག་གིས་བརྩེ་བས་སྐྱོང་ཞེས་བདག་ནི༌སྨྲ།།","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ཁྱོད་རྣམས་བདག་གི་མི་སྡེ་མ་ཡིན༌ཞེས།།","poem":1},{"lineBreak":true},{"text":"སྔོན་ཆད་ཡུལ་སྡེ་གང་ནས་སྨྲས་གྱུར་ན།།","poem":1},{"lineBreak":true},{"text":"རྟག་བརྟན་དཀོན་མཆོག་ཁོང་གི་བུ་ཡིན༌ཞེས།།","poem":1},{"lineBreak":true},{"text":"མ་འོངས་པར་ཡང་ཡུལ་དེར་དེ་ལྟར༌སྨྲ།།","poem":1},"ཞེས༌པའོ།།"]},{"type":"verse","number":27,"content":["དེ་ཡང་ཡེ་ཤ་ཡཱ་ཡིས་ཡེས་ར་ཨེལ་གྱི་མི་རྣམས་ལ་སྐད་ཆེན་པོས་འདི་སྐད༌དུ། ཡེས་ར་ཨེལ་གྱི་བུ་རྒྱུད་ནི་མཚོ་འགྲམ་གྱི་བྱེ་མ་ལྟར་མང༌ནའང༌། དེ་རྣམས་ལས་ཐར་པ་ཐོབ་མཁན་ནི་ལྷག་འཕྲོ་ཙམ༌ཡིན།"]},{"type":"verse","number":28,"content":["ཅིའི་ཕྱིར་ཞེ་ན། གཙོ་བོས་འཇིག་རྟེན་སྟེང་དུ་རང་ཉིད་ཀྱི་བཀའ་ཡོངས་སུ་རྫོགས་ཤིང་མྱུར་བ་མྱུར་དུ་ལག་བསྟར་མཛད༌ངེས་ཡིན་ཞེས་གསུངས་པའི་ཕྱིར༌རོ།།"]},{"type":"verse","number":29,"content":["དེ་ལ་ཡང་ཡེ་ཤ་ཡཱ་ཡིས་དེ་སྔར་འདི་སྐད༌དུ།",{"text":"དཔུང་ཚོགས་ཀུན་གྱི་གཙོ་བོས་བདག་ཅག༌ལ།།","poem":1},{"lineBreak":true},{"text":"རྒྱུད་ཀྱི་ས་བོན་བསྐྱུར་བ་མ་ཡིན༌ན།།","poem":1},{"lineBreak":true},{"text":"སཱ་དོམ་དང་ནི་གཱ་མོ་ར་ཇི་བཞིན།།","poem":1},{"lineBreak":true},{"text":"བདག་ཅག་ཀྱང་ནི་དེ་བཞིན་གྱུར་པ༌ཡིན།།","poem":1},"ཞེས་གསུངས༌པའོ།།"]},{"type":"heading","content":["ཡེས་ར་ཨེལ་མི་རིགས་ཀྱི་དད༌པ།"]},{"type":"verse","number":30,"content":["དེས་ན་ངེད་ཅག་གིས་ཅི་ཞིག་སྨྲའམ། གཏན་ནས་རྣམ་དག་ལ་བརྩོན་པར་མི་བྱེད་པའི་ཕྱི་ཕྱོགས་པ་རྣམས་ལ་དད་པ་ལས་བྱུང་བའི་རྣམ་དག་ཐོབ༌ཀྱང༌།"]},{"type":"verse","number":31,"content":["ཡེས་ར་ཨེལ་གྱི་མི་རིགས་ཀྱིས་བཀའ་ཁྲིམས་ཀྱི་རྣམ་དག་དེ་ཉིད་བརྩོན་ལེན་བྱས་ནའང་རྣམ་དག་དེ་ཉིད་མ་ཐོབ་བོ།།"]},{"type":"verse","number":32,"content":["རྒྱུ་མཚན་ཅི་ཞེ༌ན། དེ་དག་གིས་དད་པ་ལ་བརྟེན་ནས་བརྩོན་ལེན་མི་བྱེད༌པར། མིའི་ལས་ཁོ་ནར་བརྟེན་ནས་བརྩོན་ལེན་བྱེད་པ་ཡིན༌པས། མི་དེ་རྣམས་ཀྱི་རྐང་པ་ནི་འདྲེད་པའི་རྡོ་དེར་ཐོགས༌པ་ཡིན་ནོ།།"]},{"type":"verse","number":33,"content":["དེ་ལ་གསུང་རབ་ཀྱི་མདོ་ལས་ཇི་སྐད༌དུ། ལྟོས་དང་།",{"text":"བདག་གིས་ཛ་ཡན་ཡུལ་དུ་རྡོ་ཞིག༌བཞག །","poem":1},{"lineBreak":true},{"text":"དེ་ནི་རྐང་པ་འདྲེད་པའི་རྡོ་ཞིག༌དང༌།།","poem":1},{"lineBreak":true},{"text":"ས་ལ་སྒྱེལ་བའི་ཕ་བོང་ཡང་ཡིན་ཏེ།།","poem":1},{"lineBreak":true},{"text":"ཁོང་ལ་བརྟེན་ཅིང་དད་པ་བྱེད་མཁན༌ཀུན།།","poem":1},{"lineBreak":true},{"text":"ཁ་ནི་མི་སྐྱེངས་ངོ་ཡང་མི་གནོང༌ངོ༌།།","poem":1},"ཞེས་བཀོད་པ་བཞིན༌ནོ།།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ROM/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ROM/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ROM/8.json","previousChapterAudioLinks":{},"numberOfVerses":33}