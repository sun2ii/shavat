{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"RUT","translationId":"bod_ntb","name":"རུ་ཐི།","commonName":"རུ་ཐི།","title":"༄༅། །རུ་ཐིའི་མདོ།","order":8,"numberOfChapters":4,"sha256":"fb74a39deff6314bff9e2f08d4a9e77ced2f8a5fd3c127e0fc56c0299c4dd711","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/RUT/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/RUT/4.json","totalNumberOfVerses":85},"chapter":{"number":2,"content":[{"type":"heading","content":["རུ་ཐི་དང་པཱོ་ཨ་ཟི་གཉིས་ཕྲད་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་ནཱ་ཨོ་མུ་ཡི་སྐྱེས་པ་འདས་པོ་ཨེ་ལི་མེ་ལེག་གི་ཤ་ཉེའི་ཁྲོད་དུ་མིང་ལ་པཱོ་ཨ་ཟི་ཞེས་བྱ་བ་ཞིག་ཡོད་དེ། ཁོ་ནི་སྟོབས་འབྱོར་ཅན་ཞིག་ཡིན་ཞིང་ཨེ་ལི་མེ་ལེག་གི་རུས་རྒྱུད་ཀྱང་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["ཡང་ནཱ་ཨོ་མུ་ལ། མོ་ཨབ་ཀྱི་བུད་མེད་རུ་ཐི་ན་རེ། ང་རང་ཞིང་ཁར་འགྲོ་རུ་ཆུག་དང་། སུ་ཞིག་གིས་ང་ལ་ཐུགས་རྗེ་བསྐྱེད་ན་ངས་དེའི་རྗེས་སུ་སྙེ་མ་འཐུ་བར་བྱའོ་ཞེས་ཞུས་པ་ལ། ནཱ་ཨོ་མུ་ཡིས་དེའི་ལན་དུ། ངའི་བུ་མོ། སོང་ཞིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་རུ་ཐི་ཞིང་ཁར་སོང་སྟེ་ཞིང་འབྲེག་མཁན་རྣམས་ཀྱི་རྗེས་ནས་སྙེ་མ་འཐུ་འགོ་བརྩམས་པ་དང་། ཁོ་མོ་ཏག་ཏག་ཨེ་ལི་མེ་ལེག་གི་ཁྱིམ་རྒྱུད་ཡིན་པའི་པཱོ་ཨ་ཟིའི་ཞིང་ནང་དུ་སླེབས་སོ། །"]},{"type":"verse","number":4,"content":["ཡང་ལྟོས་དང་། སྐབས་དེར་པཱོ་ཨ་ཟི་ནི་པེད་ལེ་ཧེམ་ནས་ཕྱིར་སླེབས་མ་ཐག་ཡིན་ལ་ཁོས་ཞིང་འབྲེག་མཁན་རྣམས་ལ་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེ་ཁྱོད་རྣམས་དང་མཉམ་དུ་བཞུགས་པར་སྨོན་ཞེས་སྨྲས་པ་ལ། ཁོ་ཚོ་ན་རེ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱེད་ལ་བྱིན་རླབས་གནང་བར་ཤོག་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":5,"content":["ཡང་པཱོ་ཨ་ཟི་ཡིས་ཞིང་འབྲེག་མཁན་རྣམས་ཀྱི་འགོ་དཔོན་ལ་འདི་ལྟར། གཞོན་ནུ་མ་དེ་ནི་སུ་ཚང་གི་ཡིན་ནམ་ཞེས་དྲིས་པ་ལ།"]},{"type":"verse","number":6,"content":["ཞིང་འབྲེག་མཁན་རྣམས་ཀྱི་འགོ་དཔོན་གྱིས། ཁོ་མོ་ནི་ནཱ་ཨོ་མུ་དང་མཉམ་དུ་ཕྱིར་ལོག་པའི་མོ་ཨབ་ཡུལ་གྱི་གཞོན་ནུ་མ་དེ་ཡིན་ལ།"]},{"type":"verse","number":7,"content":["ཁོ་མོས་ང་ལ། ང་རང་ཞིང་འབྲེག་མཁན་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་ཏེ་ཚར་ཕོན་གྱི་ཤུལ་དུ་སྙེ་མ་འཐུ་རུ་འཇུག་རོགས་གནང་ཞེས་ཞུས་པས། ཁང་པའི་ནང་དུ་ཡུད་ཙམ་ལ་ངལ་གསོ་བྱས་པ་ལས་གཞན། ནངས་སྔ་མོ་ནས་ད་ལྟའི་བར་དུ་འདིར་ཡོད་པ་ཡིན་ཞེས་ཞུས་སོ། །"]},{"type":"verse","number":8,"content":["དེ་ནས་པཱོ་ཨ་ཟི་ཡིས་རུ་ཐི་ལ་འདི་ལྟར། བདག་གི་བུ་མོ་ལགས། ང་ལ་ཉོན་ཅིག མི་གཞན་གྱི་ཞིང་ནང་དུ་སྙེ་མ་འཐུ་བར་མི་འགྲོ་ཞིང་འདི་ནས་ཁ་ཡང་མི་འབྲལ་བར། རྒྱུན་དུ་ངའི་གཞོན་ནུ་མ་རྣམས་དང་མཉམ་དུ་སྡོད་དང་།"]},{"type":"verse","number":9,"content":["ངའི་གཡོག་པོ་རྣམས་ཀྱིས་ཞིང་གང་ཞིག་གི་ནང་དུ་ཞིང་འབྲེག་པ་མཐོང་ན་དེ་རྣམས་ཀྱི་རྗེས་སུ་འབྲོངས་ཤིག ངས་གཡོག་པོ་ཚོར་ཁྱོད་ལ་མི་རེག་པའི་ཕྱིར་བསྒོས་པ་ཡིན། གལ་ཏེ་ཁྱོད་རང་སྐོམ་པའི་ཚེ་གཡོག་པོ་རྣམས་ཀྱིས་ཁུར་ཡོང་བའི་རྫ་སྣོད་ནང་གི་ཆུ་ཐུངས་ཤིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་རུ་ཐི་ཡིས་ཁ་སར་གཏད་ནས་ཁོ་ལ་གུས་ཕྱག་ཕུལ་ཞིང་ན་རེ། བདག་ནི་ཕྱི་ཕྱོགས་པ་ཞིག་ཡིན་པས། ཁྱེད་ཀྱིས་ང་ལ་ཐུགས་རྗེ་དང་གཟིགས་སྐྱོང་གནང་བ་ནི་ཅི་ཞིག་ཡིན་ནམ་ཞེས་ཞུས་པ་དང་།"]},{"type":"verse","number":11,"content":["པཱོ་ཨ་ཟི་ཡིས་ཁོ་མོར་འདི་ལྟར། ཁྱོད་ཀྱི་སྐྱེས་པ་ཚེ་ལས་འདས་པ་ནས་བཟུང་། ཁྱོད་ཀྱིས་རང་གི་སྒྱུག་མོ་ལ་ཅི་ལྟ་བུའི་ལས་བཟང་པོ་རྣམས་བྱས་པ་དང་། ཕ་མ་གཉིས་དང་རང་ཡུལ་ལ་ཁ་བྲལ་ནས་སྔར་ཆ་རྒྱུས་མེད་པའི་མི་རྣམས་ཀྱི་ཁྲོད་དུ་ཡོང་བའི་སྐོར་གཞན་གྱིས་ང་ལ་སྨྲས་བྱུང་།"]},{"type":"verse","number":12,"content":["ཁྱོད་རང་སྐྱབས་བཅོལ་དུ་ཡོང་སའི་",{"noteId":2},"ཡེས་ར་ཨེལ་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས། ཁྱོད་ཀྱིས་དོན་གང་ཞིག་བསྒྲུབས་པ་བཞིན་དུ་ཁྱོད་ལ་ཕུན་སུམ་ཚོགས་པའི་གསོལ་རས་སྩོལ་བར་ཤོག་ཅིག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":13,"content":["དེ་ནས་རུ་ཐི་ན་རེ། བདག་པོ་ལགས། ང་ནི་ཁྱེད་ཀྱི་གཞོན་ནུ་མ་རྣམས་ཀྱི་གཅིག་ལ་མི་དོ་ནའང་ཁྱེད་ཀྱི་བྱམས་བརྩེ་ལྡན་པའི་གཏམ་གྱིས་བདག་ལ་སེམས་གསོ་གནང་བྱུང་། ཁྱེད་ཀྱིས་མུ་མཐུད་དུ་བདག་ལ་ཐུགས་རྗེའི་སྤྱན་གྱིས་གཟིགས་པར་མཛོད་ཅེས་ཞུས་སོ། །"]},{"type":"verse","number":14,"content":["ཁ་ཟས་གསོལ་བའི་དུས་སུ་སླེབས་པ་དང་། པཱོ་ཨ་ཟི་ཡིས་རུ་ཐི་ལ་འདི་ལྟར། ཁྱོད་རང་ཚུར་ཤོག་ལ་བག་ལེབ་རྒུན་ཆང་སྐྱུར་མོའི་ནང་དུ་སྦངས་ཏེ་ཟོ་ཞིག་ཅེས་སྨྲས་པས། རུ་ཐི་ཞིང་འབྲེག་མཁན་རྣམས་ཀྱི་གམ་དུ་བསྡད་ཅིང་། ཁོས་ཁོ་མོ་ལ་ཡོས་སྤྲད་པ་དང་ཁོ་མོས་ཟོས་ནས་འགྲངས་ཤིང་ལྷག་མའང་བྱུང་ངོ་། །"]},{"type":"verse","number":15,"content":["ཁོ་མོ་ཡར་ལངས་ཏེ་སྙེ་མ་འཐུ་འགོ་བརྩམས་པ་དང་། པཱོ་ཨ་ཟི་ཡིས་རང་གི་གཡོག་པོ་རྣམས་ལ་འདི་ལྟར། ཁོ་མོར་ཚར་ཕོན་རྣམས་ལས་སྙེ་མ་འཐུ་རུ་འཇུག་པ་ལས་ངོ་ཚར་གཏོད་མི་རུང་།"]},{"type":"verse","number":16,"content":["དེར་མ་ཟད་ཚར་ཕོན་རྣམས་ལས་སྙེ་མ་ཕྱིར་ཕྱུང་ནས་ཞིང་ནང་དུ་བསྐྱུར་ཏེ་ཁོ་མོར་འཐུ་རུ་འཇུག་པ་ལས་གཤེ་གཤེ་གཏང་མི་རུང་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":17,"content":["དེ་ནས་རུ་ཐི་ཡིས་དགོང་མོའི་བར་དུ་ཞིང་ཁ་ནས་སྙེ་མ་བཏུས་ཏེ་བརྡུངས་པ་ལ། ནས་ཨེ་ཕཱ་གང་ཙམ་ཡོད་པས།"]},{"type":"verse","number":18,"content":["ཁོ་མོས་དེ་ཁུར་ནས་གྲོང་རྡལ་དུ་སོང་སྟེ་རང་གི་སྒྱུག་མོས་ཀྱང་བཏུས་ཟིན་པའི་འབྲུ་རྣམས་མཐོང་། ཡང་ཁོ་མོས་རང་གི་ཁ་ཟས་ལྷག་མ་དེ་བླངས་ནས་སྒྱུག་མོ་ལ་ཕུལ་ཏོ། །"]},{"type":"verse","number":19,"content":["སྒྱུག་མོས་ཁོ་མོ་ལ་འདི་ལྟར། དེ་རིང་ཁྱོད་ཀྱིས་གང་དུ་སྙེ་མ་བཏུས་སམ། ཁྱོད་ཀྱིས་གང་དུ་ལས་ཀ་བྱས་པ་ཡིན་ནམ། ཁྱོད་ལ་གཟིགས་སྐྱོང་མཛད་མཁན་དེར་བྱིན་རླབས་འཐོབ་པར་ཤོག་ཅེས་སྨྲས་པ་ལ། རུ་ཐི་ན་རེ། དེ་རིང་བདག་དང་མཉམ་དུ་ལས་ཀ་བྱེད་པའི་སྐྱེས་པ་དེའི་མིང་ལ་པཱོ་ཨ་ཟི་ཟེར་བ་ཡིན་ནོ་ཞེས་རང་དང་མཉམ་དུ་ལས་ཀ་བྱེད་མཁན་སུ་ཡིན་པའི་སྐོར་སྒྱུག་མོར་སྨྲས་སོ། །"]},{"type":"verse","number":20,"content":["ནཱ་ཨོ་མུ་ཡིས་མནའ་མར་འདི་ལྟར། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་ལ་བྱིན་རླབས་གནང་བར་ཤོག་ཅིག ཁོང་གིས་གསོན་གཤིན་གཉིས་ཀ་དྲིན་གྱིས་སྐྱོང་བ་ནམ་ཡང་རྒྱུན་མ་ཆད་དོ་ཞེས་སྨྲས་ཤིང་། ཡང་མུ་མཐུད་དུ། པཱོ་ཨ་ཟི་ནི་བདག་ཅག་གི་རུས་རྒྱུད་གཅིག་ཡིན་ལ་རང་རེའི་བླུ་མཁན་ཡང་ཡིན་ནོ་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":21,"content":["དེ་ནས་མོ་ཨབ་ཀྱི་བུ་མོ་རུ་ཐི་ན་རེ། ཁོས་ཡང་བདག་ལ་འདི་ལྟར། གཡོག་པོ་རྣམས་ཀྱིས་བདག་གི་ཞིང་བྲེགས་ཚར་བའི་བར་དུ། ཁྱོད་རང་གཡོག་པོ་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་ཏེ་སྙེ་མ་འཐུ་དགོས་ཟེར་ཞེས་སྨྲས་སོ། །"]},{"type":"verse","number":22,"content":["ནཱ་ཨོ་མུ་ཡིས་རང་གི་མནའ་མ་རུ་ཐི་ལ་འདི་ལྟར། ངའི་བུ་མོ་ལགས། ཁྱོད་རང་ཁོའི་གཞོན་ནུ་མ་རྣམས་ཀྱི་རྗེས་སུ་འབྲངས་ནས་སོང་ན་ལེགས་ཤིང་། མི་གཞན་གྱི་ཞིང་བར་དུ་ཁྱོད་ལ་གནོད་འཚེ་འཕོག་སྲིད་དོ་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":23,"content":["དེ་ནས་རུ་ཐི་ནི་ནམ་རྒྱུན་པཱོ་ཨ་ཟི་ཡི་གཞོན་ནུ་མ་རྣམས་དང་འགྲོགས་ཤིང་། ནས་དང་གྲོ་གཉིས་བྲེགས་ཚར་བའི་བར་དུ་སྙེ་མ་བཏུས་པ་དང་། ཁོ་མོ་སྔར་བཞིན་རང་གི་སྒྱུག་མོ་དང་མཉམ་དུ་གནས་སོ། །"]}],"footnotes":[{"noteId":2,"caller":"+","text":"འདིར་སྐྱབས་བཅོལ་དུ་ཡོང་ས་ཞེས་པ་ནི་བདེ་འཇགས་ཡིན་པའི་ཡུལ་ལ་གོ་བ་སྟེ་བྱིའུ་བྱ་མའི་གཤོག་འོག་ཏུ་གནས་པ་ལྟ་བུར་འཇུག","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/bod_ntb/RUT/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/RUT/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/RUT/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}