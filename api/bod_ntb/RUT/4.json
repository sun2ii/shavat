{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"RUT","translationId":"bod_ntb","name":"རུ་ཐི།","commonName":"རུ་ཐི།","title":"༄༅། །རུ་ཐིའི་མདོ།","order":8,"numberOfChapters":4,"sha256":"fb74a39deff6314bff9e2f08d4a9e77ced2f8a5fd3c127e0fc56c0299c4dd711","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/RUT/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bod_ntb/RUT/4.json","totalNumberOfVerses":85},"chapter":{"number":4,"content":[{"type":"heading","content":["པཱོ་ཨ་ཟི་ཡིས་རུ་ཐི་བླུས་པ།"]},{"type":"verse","number":1,"content":["དེ་ཡང་པཱོ་ཨ་ཟི་ཡར་མཁར་གྱི་སྒོ་ཁ་རུ་སོང་ནས་སྡོད་སྐབས། ལྟོས་དང་། ཏན་ཏན་ཁོས་སྔོན་དུ་གླེང་མྱོང་བའི་བླུ་མཁན་དེ་སླེབས་པ་དང་ཁེལ། པཱོ་ཨ་ཟི་ཡིས་འདི་ལྟར། བདག་གི་གྲོགས་པོ་ལགས། ཚུར་ཤོག་ལ་འདིར་སྡོད་དང་ཞེས་སྨྲས་པ་ན། མི་དེས་ཀྱང་ཁོའི་ངག་བཞིན་དུ་བྱས་སོ། །"]},{"type":"verse","number":2,"content":["ཡང་པཱོ་ཨ་ཟི་ཡིས་གྲོང་རྡལ་དེའི་རྒན་པོ་རྣམས་ལས་མི་བཅུ་བདམས་ནས་དེ་དག་ལ་འདི་ལྟར། ཁྱེད་རྣམ་པ་འདིར་བཞུགས་པར་མཛོད་ཅེས་ཞུས་པ་ལ་ཁོ་རྣམས་ཀྱིས་ཀྱང་དེ་ལྟར་བྱས་སོ། །"]},{"type":"verse","number":3,"content":["དེ་ནས་པཱོ་ཨ་ཟི་ཡིས་བླུ་མཁན་དེ་ལ་འདི་ལྟར། མོ་ཨབ་ཡུལ་ནས་ཕྱིར་སླེབས་པའི་ནཱ་ཨོ་མུ་ཡིས་བདག་ཅག་གི་སྤུན་ཟླ་འདས་པོ་ཨེ་ལི་མེ་ལེག་གི་ས་ཞིང་དེ་བཙོང་བར་འདོད་དོ། །"]},{"type":"verse","number":4,"content":["བདག་གི་བསམ་ཚུལ་ལ་ས་ཞིང་དེ་ནི་ཁྱེད་ཀྱིས་ཉོ་རུང་བ་དང་། ཁྱེད་ཀྱི་རྗེས་སུ་བདག་ཡིན་ཞིང་། གཞན་དེ་བཞིན་དུ་བྱ་རུང་བ་སུ་ཡང་ཡོད་པ་མ་ཡིན། ཁྱེད་ཀྱིས་འདིར་བཞུགས་པ་རྣམས་དང་བདག་གི་རིགས་རྒྱུད་ཀྱི་རྒན་པོ་རྣམས་ཀྱི་མདུན་དུ་གསལ་བཤད་བྱས་ཆོག་སྟེ། ཁྱེད་ཀྱི་བླུ་བར་དགོངས་ན་བླུས་ཤིག གལ་ཏེ་མི་བླུ་ན་བདག་གིས་ཤེས་པའི་ཕྱིར་བདག་ལ་སྨྲ་བར་མཛོད་ཅེས་སྨྲས་པ་ན། མི་དེ་ན་རེ། ངས་བླུ་བར་བྱའོ་ཞེས་ལན་སྨྲས་སོ། །"]},{"type":"verse","number":5,"content":["དེ་ནས་པཱོ་ཨ་ཟི་ཡིས་འདི་ལྟར། ཁྱེད་ཀྱིས་ནཱ་ཨོ་མུ་ནས་ས་ཞིང་དེ་ཉོ་བའི་ཉིན་མོར། གཤིན་པོའི་མིང་ནི་ཁོ་རང་གི་ནོར་སྐལ་སྟེང་རྒྱུན་འཛིན་བྱེད་པའི་ཕྱིར་ཁོའི་ཆུང་མ་སྟེ་མོ་ཨབ་ཡུལ་གྱི་རུ་ཐི་ཡང་ཚུར་རང་གིས་ལེན་འོས་པ་ཡིན་ཞེས་སྨྲས་པའོ། །"]},{"type":"verse","number":6,"content":["དེ་ནས་མི་དེ་ན་རེ། དེས་ན་བདག་གི་ནོར་སྐལ་ལ་བར་ཆད་འབྱུང་ཉེན་ཡོད་པས་བདག་གིས་ས་ཞིང་དེ་བླུ་མི་ནུས། ཁྱོད་ཀྱིས་དེ་བླུས་ཤིག ངའི་ཐོབ་སྐལ་དེ་ཁྱོད་རང་གིས་བླུས་ཆོག་ཅེས་སྨྲས་སོ། །"]},{"type":"verse","number":7,"content":["སྔོན་ཆད་ཡེས་ར་ཨེལ་དུ་བླུ་བ་དང་ཡང་ན་ཉོ་ཚོང་བྱེད་པའི་དོན་གང་ཞིག་ཐག་གིས་གཅོད་པའི་སྐབས་སུ། གཅིག་གིས་བསིལ་ལྷམ་ཕུད་ནས་གཞན་པ་དེར་སྤྲོད་ཅིང་། ཡེས་ར་ཨེལ་གྱི་མི་ཐམས་ཅད་ཀྱིས་དེ་བདེན་དཔང་གི་གཏའ་མར་བྱེད་པའོ། །"]},{"type":"verse","number":8,"content":["དེའི་ཕྱིར། མི་དེས་པཱོ་ཨ་ཟི་ལ་འདི་ལྟར། ཁྱོད་ཀྱིས་རང་ལ་ཉོས་ཤིག་ཅེས་སྨྲས་ནས་ཁོས་རང་གི་བསིལ་ལྷམ་ཕུད་པ་རེད།"]},{"type":"verse","number":9,"content":["དེ་ནས་པཱོ་ཨ་ཟི་ཡིས་རྒན་པོ་རྣམས་དང་མི་ཚོགས་ལ་འདི་ལྟར། དེ་རིང་ཁྱེད་རྣམ་པ་ནི་དཔང་པོ་རྣམས་ཡིན་ཏེ། ཨེ་ལི་མེ་ལེག་དང་། ཀིལ་ཡོན། མཱ་ལིན་བཅས་ལ་དབང་བ་ཐམས་ཅད་བདག་གིས་ནཱ་ཨོ་མུ་ཡི་ལག་ནས་བླུས་པ་དང་།"]},{"type":"verse","number":10,"content":["ཡང་གཤིན་པོའི་མིང་ནི་ཁོ་རང་གི་ནོར་སྐལ་སྟེང་རྒྱུན་འཛིན་བྱེད་པ་དང་ཁོའི་མིང་ནི་རང་ཁྱིམ་དང་རང་ཡུལ་ནས་ཡལ་བར་མི་འགྱུར་བའི་ཆེད་དུ། འདས་པོ་མཱ་ལིན་གྱི་ཆུང་མ་སྟེ་མོ་ཨབ་པ་རུ་ཐི་ནི་བདག་གིས་ཆུང་མར་བླངས་པ་ཡིན། ཁྱེད་རྣམ་པས་དེ་རིང་བདེན་དཔང་བྱས་ཆོག་ཅེས་སྨྲས།"]},{"type":"verse","number":11,"content":["དེ་ནས་མཁར་གྱི་སྒོ་ཁ་རུ་སྡོད་པའི་མི་ཚོགས་དང་རྒན་པོ་བཅས་ཐམས་ཅད་ཀྱིས་འདི་ལྟར།",{"text":"ངེད་རྣམས་དོན་འདིའི་བདེན་དཔང་ཡིན་པ་སྟེ། །","poem":1},{"lineBreak":true},{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་ཀྱི་ཁྱིམ་ནང་དུ། །","poem":1},{"lineBreak":true},{"text":"ཡོང་བར་འགྱུར་བའི་བུད་མེད་དེ་ཉིད་ནི། །","poem":1},{"lineBreak":true},{"text":"ཡེས་ར་ཨེལ་གྱི་ཁྱིམ་རྒྱུད་འཛུགས་པ་ཡི། །","poem":1},{"lineBreak":true},{"text":"རཱ་ཧེལ་ལེ་ཨ་གཉིས་བཞིན་མཛད་གྱུར་ཅིག །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་རང་ཨེབ་རཱད་ཡུལ་དུ་དོན་འགྲུབ་ཅིང་། །","poem":1},{"lineBreak":true},{"text":"པེད་ལེ་ཧེམ་དུ་སྙན་གྲགས་རྒྱས་པར་སྨོན། །","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"དཀོན་མཆོག་ཡ་ཝཱེས་གཞོན་ནུ་མ་འདི་བརྒྱུད། །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་ལ་བུ་རྒྱུད་གནང་སྟེ་ཁྱིམ་གཞིས་ནི། །","poem":1},{"lineBreak":true},{"text":"ཡ་ཧུ་དཱ་དང་ཐལ་མཱར་ཁོང་གཉིས་ལས། །","poem":1},{"lineBreak":true},{"text":"སྐྱེས་པའི་བུ་སྟེ་ཕེ་རེལ་ཟི་བྱ་བའི། །","poem":1},{"lineBreak":true},{"text":"ཁྱིམ་གཞིས་ལྟ་བུ་ཡིན་པར་མཛད་དུ་གསོལ། །","poem":1},"ཞེས་བརྗོད་དོ། །"]},{"type":"heading","content":["པཱོ་ཨ་ཟི་ཡིས་རུ་ཐི་རང་གི་ཆུང་མར་བླངས་པ།"]},{"type":"verse","number":13,"content":["དེ་ནས་པཱོ་ཨ་ཟི་ཡིས་རུ་ཐི་རང་གི་ཆུང་མར་བླངས་ཤིང་ཁོ་མོ་དང་མཉམ་དུ་བསྡད་པ་ལ། དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་མོར་མངལ་དང་ལྡན་པར་མཛད་ནས་བུ་ཞིག་སྐྱེས།"]},{"type":"verse","number":14,"content":["བུད་མེད་རྣམས་ཀྱིས་ནཱ་ཨོ་མུ་ལ་འདི་ལྟར།",{"text":"དཀོན་མཆོག་ཡ་ཝཱེ་ཁོང་ཉིད་བསྟོད་འོས་ཏེ། །","poem":1},{"lineBreak":true},{"text":"ཁོང་གིས་ཁྱོད་རང་དེ་རིང་ཉིན་མོ་འདིར། །","poem":1},{"lineBreak":true},{"text":"ཉེ་བའི་བླུ་མཁན་མེད་པར་མ་བསྐྱུར་ཏོ། །","poem":1},{"lineBreak":true},{"text":"ཕྲུ་གུ་འདི་ནི་ཡེས་ར་ཨེལ་པའི་ཁྲོད། །","poem":1},{"lineBreak":true},{"text":"སྙན་གྲགས་ཡོངས་སུ་རྒྱས་པའི་སྨོན་འདུན་ཞུ། །","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"འདི་ནི་ཁྱོད་རང་གཅེས་སུ་འཛིན་པ་ཡི། །","poem":1},{"lineBreak":true},{"text":"མནའ་མ་དེ་ཡིས་བཙས་པའི་བུ་ཡིན་པས། །","poem":1},{"lineBreak":true},{"text":"ཁོས་ནི་ཁྱོད་ཀྱི་སེམས་ཤུགས་ཆེར་བསྐྱེད་ཅིང་། །","poem":1},{"lineBreak":true},{"text":"ཁྱོད་རང་རྒས་དུས་སྙོར་སྐྱོང་བྱེད་ངེས་ཡིན། །","poem":1},{"lineBreak":true},{"text":"འདི་ལྟའི་མནའ་མ་ཁྱོད་ལ་ཡོད་པ་ནི། །","poem":1},{"lineBreak":true},{"text":"བུ་བདུན་ཡོད་པ་ལས་ཀྱང་ཤིན་ཏུ་ལེགས། །","poem":1},"ཞེས་སྨྲས།"]},{"type":"verse","number":16,"content":["དེ་ནས་ནཱ་ཨོ་མུ་ཡིས་ཕྲུ་གུ་པང་དུ་བཟུང་སྟེ་བུ་སྙོར་མ་རུ་གྱུར་ཏོ། །"]},{"type":"verse","number":17,"content":["ཁྱིམ་མཚེས་ཀྱི་བུད་མེད་རྣམས་ན་རེ། ནཱ་ཨོ་མུ་ལ་བུ་ཞིག་སྐྱེས་སོ་ཞེས་སྨྲས་པ་དང་ཁོ་རྣམས་ཀྱིས་ཕྲུ་གུ་དེའི་མིང་ལ་ཨོ་བེད་ཅེས་བཏགས། ཨོ་བེད་ནི་ཡེ་སེ་ཞེས་བྱ་བའི་ཡབ་ཡིན་ཞིང་ཡེ་སེ་ནི་དཱ་བིད་ཅེས་པའི་ཡབ་ཡིན་ནོ། །"]},{"type":"heading","content":["རྒྱལ་པོ་དཱ་བིད་ཀྱི་གདུང་རྒྱུད།"]},{"type":"verse","number":18,"content":["ཕེ་རེལ་ཟིའི་རིགས་རྒྱུད་རྣམས་ནི་གཤམ་གསལ་ལྟར། ཕེ་རེལ་ཟི་ལ་བུ་ཧེས་རོན་ཞེས་བྱ་བ་སྐྱེས་པ་དང་།"]},{"type":"verse","number":19,"content":["ཧེས་རོན་ལ་བུ་རཱམ་ཞེས་བྱ་བ་སྐྱེས་པ་དང་། རཱམ་ལ་བུ་ཨ་མི་ནཱ་དབ་ཅེས་བྱ་བ་སྐྱེས་པ་དང་།"]},{"type":"verse","number":20,"content":["ཨ་མི་ནཱ་དབ་ལ་བུ་ནཱ་སོན་ཞེས་བྱ་བ་སྐྱེས་པ་དང་། ནཱ་སོན་ལ་བུ་སཱལ་མོན་ཞེས་བྱ་བ་སྐྱེས་པ་དང་།"]},{"type":"verse","number":21,"content":["སཱལ་མོན་ལ་བུ་པཱོ་ཨ་ཟི་ཞེས་བྱ་བ་སྐྱེས་པ་དང་། པཱོ་ཨ་ཟི་ལ་བུ་ཨོ་བེད་ཅེས་བྱ་བ་སྐྱེས་པ་དང་།"]},{"type":"verse","number":22,"content":["ཨོ་བེད་ལ་བུ་ཡེ་སེ་ཞེས་བྱ་བ་སྐྱེས་པ་དང་། ཡེ་སེ་ལ་བུ་དཱ་བིད་ཅེས་བྱ་བ་སྐྱེས་པ་ལགས་སོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/RUT/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/1SA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/RUT/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}