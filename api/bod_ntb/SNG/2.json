{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"SNG","translationId":"bod_ntb","name":"སྙན་མགུར།","commonName":"སྙན་མགུར།","title":"༄༅། །རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་སྙན་མགུར།","order":22,"numberOfChapters":8,"sha256":"7806f6c165460baca7b698cc36abe3e4b9e990a039bb999dd0b2744e594fe535","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bod_ntb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["ང་ནི་ཤཱ་རོན་ཡུལ་གྱི་རྒྱ་སེ་དང་། ། ལུང་པའི་ནང་གི་མེ་ཏོག་ཀུ་མུད་ཡིན། །"]},{"type":"verse","number":2,"content":["ཚེར་མའི་ཁྲོད་ཀྱི་མེ་ཏོག་ཀུ་མུད་ལྟར། ། ང་ཡི་སྙིང་སྡུག་བུ་མོ་ཀུན་ལས་མཆོག །"]},{"type":"verse","number":3,"content":["ནགས་ལ་སྐྱེས་པའི་ཀུ་ཤུ་ཤིང་བཞིན་དུ། ། ང་ཡི་དགའ་གྲོགས་སྐྱེས་པའི་ཁྲོད་དུ་ཡོད། ། བདག་ནི་དགའ་ཞིང་ཁོང་གི་གྲིབ་བསིལ་འོག ། བསྡད་དེ་ཁོང་གི་ཤིང་ཏོག་མངར་མོར་རོལ། །"]},{"type":"verse","number":4,"content":["ཁོང་གིས་བདག་ནི་གསོལ་སྟོན་ཁང་ལ་ཁྲིད། ། ང་ཡི་སྟེང་དུ་བརྩེ་བའི་དར་ཆ་བསྒྲེངས། །"]},{"type":"verse","number":5,"content":["བདག་ནི་དུངས་སེམས་དབང་གིས་རབ་གདུངས་པས། ། རྒུན་འབྲུམ་སྐམ་པོས་བདག་ལ་སྟོབས་བཅུག་ནས། ། ཀུ་ཤུས་བདག་གི་སེམས་ལ་བདེ་བ་སྩོལ། །"]},{"type":"verse","number":6,"content":["ཁོང་ཕྱག་གཡོན་པས་བདག་གི་མགོ་བོ་སྐྱོར། ། ཁོང་ཕྱག་གཡས་པས་བདག་གི་ལུས་ཡོངས་འཁྱུད། །"]},{"type":"verse","number":7,"content":["ཀྱེ་ཀྱེ་ཡེ་རུ་སཱ་ལེམ་བུ་མོ་རྣམས། ། ང་ཡི་དགའ་གྲོགས་དགྱེས་ཏེ་མ་བཞེངས་བར། ། ཁྱེད་ཚོས་ཁོང་ཉིད་མནལ་ལས་མི་སློང་ཕྱིར། ། བདག་གིས་དགོ་དང་ཐང་གི་ཡུ་མོ་གཉིས། ། དཔང་དུ་བཙུགས་ནས་ཁྱེད་ཚོར་མནའ་འགེལ་ལོ། །"]},{"type":"heading","content":["ཤོ་ལོ་ཀ་གཉིས་པ།"]},{"type":"verse","number":8,"content":["ང་ཡི་དགའ་གྲོགས་གསུང་སྐད་ལ་ཉོན་དང་། ། ཁོང་ཉིད་རི་དང་ལ་ལུང་བརྒལ་ནས་ནི། ། ཚུར་རོལ་འབྱོན་བཞིན་པ་ལ་ལྟོས་ཤིག་ཀྱེ། །"]},{"type":"verse","number":9,"content":["ང་ཡི་དགའ་གྲོགས་དགོ་དང་ཤྭ་ཕྲུག་འདྲ། ། ལྟོས་ཤིག་ཁོང་ནི་ངེད་ཀྱི་རྩིག་འདབས་སླེབས། ། དཀར་ཁུང་ནང་དུ་བདག་ལ་གཟིགས་པ་དང་། ཤིང་དྲའི་བར་ནས་བདག་ལ་ནན་གྱིས་ལྟ། །"]},{"type":"verse","number":10,"content":["ང་ཡི་དགའ་གྲོགས་བདག་ལ་འདི་སྐད་གསུངས། ། ང་ཡི་སྙིང་སྡུག་བཟང་པོ་བཞིན་བཟང་མ། ། ཡར་ལ་བཞེངས་ཏེ་བདག་དང་མཉམ་དུ་འགྲོ། །"]},{"type":"verse","number":11,"content":["ཅི་ལ་ཟེར་ན་དགུན་དུས་རྫོགས་ཟིན་ལ། ། ཆར་གྱི་དུས་ཀྱང་འདས་ནས་སོང་ཟིན་ཏོ། །"]},{"type":"verse","number":12,"content":["ས་གཞི་ཡོངས་སུ་མེ་ཏོག་རྣམ་པར་བཀྲ། ། བྱིའུས་གསུང་སྙན་སྒྲོག་པའི་དུས་ལ་བབས། ། ང་ཚོའི་ཡུལ་དུ་ཐི་བའི་གསུང་སྐད་ཐོས། །"]},{"type":"verse","number":13,"content":["སེ་ཡབ་ཤིང་གི་ཤིང་ཏོག་རིམ་གྱིས་སྨིན། ། རྒུན་འབྲུམ་མེ་ཏོག་དྲི་ཞིམ་ཕྱོགས་བཞིར་འཐུལ། ། ང་ཡི་སྙིང་སྡུག་ང་ཡི་བཞིན་བཟང་མ། ། ཡར་ལ་བཞེངས་ཏེ་ང་དང་མཉམ་དུ་འགྲོ། །"]},{"type":"verse","number":14,"content":["ཀྱེ་ཀྱེ་ང་ཡི་ཕུག་རོན་ཁྱེད་རང་ནི། ། བྲག་སྲུབ་རི་གཟར་ཕུག་ཏུ་ཡིབ་སྡོད་དེ། ། ཁྱེད་ཀྱི་ཞལ་རས་ང་ལ་སྟོན་པར་མཛོད། ། ཁྱེད་ཀྱི་གསུང་སྐད་ང་ལ་ཐོས་འཇུག་རོགས། ། ཅི་ལ་ཟེར་ན་ཁྱེད་ཀྱི་གསུང་སྐད་སྙན། ། ཁྱེད་ཀྱི་ཞལ་རས་མཛེས་ཤིང་ལྟ་ན་སྡུག །"]},{"type":"verse","number":15,"content":["ང་ཚོའི་རྒུན་འབྲུམ་ཤིང་ལ་མེ་ཏོག་བཞད། ། དེ་བས་ཁྱེད་ཀྱིས་རྒུན་ཚལ་བརླག་པ་ཡི། ། ཝ་མོ་ཝ་ཕྲུག་ང་ཚོའི་དོན་དུ་འཛིན། །"]},{"type":"verse","number":16,"content":["ང་ཡི་དགའ་གྲོགས་ང་ལ་དབང་བ་ལྟར། ། ང་ཡི་ཡོད་ཚད་ཁོང་ལ་དབང་བ་ཡིན། ། ཁོང་གིས་ཀུ་མུད་གསེབ་ནས་ལུག་ཁྱུ་འཚོ། །"]},{"type":"verse","number":17,"content":["ཉི་མ་ནུབ་ནས་བསིལ་རླུང་ལྡང་དུས་སུ། ། ཁྱེད་ནི་དགོ་བ་དང་ནི་ཤྭ་ཕྲུག་ལྟར། ། བེ་ཐེར་རི་ནས་ལོག་ཤོག་ངའི་དགའ་གྲོགས། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}