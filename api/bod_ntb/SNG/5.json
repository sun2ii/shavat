{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"SNG","translationId":"bod_ntb","name":"སྙན་མགུར།","commonName":"སྙན་མགུར།","title":"༄༅། །རྒྱལ་པོ་སོ་ལོ་མོན་གྱི་སྙན་མགུར།","order":22,"numberOfChapters":8,"sha256":"7806f6c165460baca7b698cc36abe3e4b9e990a039bb999dd0b2744e594fe535","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bod_ntb/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ང་ཡི་ལྕམ་དང་བག་མ་ལགས། ། ང་ནི་སྐྱེད་ཚལ་དུ་ཕྱིན་ནས། ། གུ་གུལ་དང་ནི་སྤོས་བསྡུས་ཏེ། ། སྦྲང་ཚང་དང་བཅས་སྦྲང་རྩི་ཟོས། ། རྒུན་ཆང་དང་ནི་འོ་མ་འཐུངས། ། ༼ མཛའ་གྲོགས་རྣམས། ༽ ཀྱེ་ཀྱེ་ང་ཡི་མཛའ་གྲོགས་རྣམས། ། བཟའ་བཏུང་ལ་ནི་རོལ་བར་གནོངས། ། ཀྱེ་ཀྱེ་ང་ཡི་སྙིང་གྲོགས་ལགས། ། རྒུན་ཆང་མང་དུ་བཞེས་རོགས་གནོངས། །"]},{"type":"heading","content":["ཤོ་ལོ་ཀ་བཞི་པ།"]},{"type":"verse","number":2,"content":["ངའི་ལུས་མལ་དུ་ཉལ་ན་ཡང་། ། བདག་སེམས་གཉིད་ལས་སད་ཡོད་དོ། ། དགའ་གྲོགས་ཀྱིས་ནི་སྒོ་རྡུང་བའི། ། སྐད་སྒྲ་ཡང་ནས་ཡང་དུ་ཐོས། ། ༼ མག་གསར། ༽ ང་ཡི་ལྕམ་དང་སྙིང་སྡུག་ལགས། ། ཕུག་རོན་དང་ནི་ཕུལ་བྱུང་ལགས། ། ང་ཡི་མགོ་ལ་ཟིལ་བས་གང་། ། མཚན་མོའི་ཟིལ་བས་སྐྲ་ལོ་བངས། ། ཁྱེད་ཀྱིས་ང་ལ་སྒོ་ཕྱེ་རོགས། །"]},{"type":"verse","number":3,"content":["དེ་ཡི་ལན་དུ་འདི་ལྟར་ཞུས། ། ང་ཡིས་གྱོན་གོས་ཕུད་ཟིན་པས། ། དེ་ནི་ཡང་བསྐྱར་ཇི་ལྟར་གྱོན། ། ང་ཡིས་རྐང་པ་བཀྲུས་ཟིན་པས། ། དེ་ནི་ཇི་ལྟར་བཙོག་པར་བྱ། །"]},{"type":"verse","number":4,"content":["ང་ཡི་དགའ་གྲོགས་ཀྱིས་ནི་ཨི་ཁུང་ལས། ། ཉིད་ཀྱི་ཕྱག་ནི་ནང་དུ་བརྐྱངས་པས་ན། ། ཁོང་གི་དོན་དུ་ང་ལ་སེམས་འགུལ་ཐེབས། །"]},{"type":"verse","number":5,"content":["ང་ཡི་དགའ་གྲོགས་ལ་ནི་སྒོ་འབྱེད་དུ། ། ཡར་ལ་ལངས་དུས་ང་ཡི་ལག་ཟུང་ལས། ། གུ་གུལ་ཐིགས་ཤིང་ང་ཡི་མཛུབ་མོ་ལས། ། གུ་གུལ་དྲི་ཞིམ་སྒོ་གཏན་སྟེང་ལ་ཐིགས། །"]},{"type":"verse","number":6,"content":["ང་ཡིས་དགའ་གྲོགས་ཁོང་ལ་ཕྱེས་པ་ལ། ། ཁོང་ཉིད་ཞལ་ཕྱིར་འཁོར་ནས་གྱེས་ཟིན་ཏོ། ། ཁོང་གི་གསུང་སྐད་ཐོས་དུས་སུ། ། རང་སེམས་རང་ལ་མ་དབང་ངོ་། ། ཁོང་ཉིད་བཙལ་ཡང་རྙེད་མ་བྱུང་། ། ཡང་ཡང་བོས་ཀྱང་ལན་མ་ཐོབ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་གྲོང་ཁྱེར་ནང་འཁོར་བའི། ། བྱ་ར་པ་དང་བདག་ཕྲད་བྱུང་། ། བདག་ལ་བརྡུངས་ནས་རྨས་སུ་བཅུག ། ལྕགས་རིའི་སོ་པ་རྣམས་ཀྱིས་ཀྱང་། ། ང་ཡི་བེར་ཐུལ་བཤུས་ནས་ཁྱེར། །"]},{"type":"verse","number":8,"content":["ཀྱེ་ཀྱེ་ཡེ་རུ་སཱ་ལེམ་གྱི་བུ་མོ། ། བདག་གིས་ཁྱེད་ཚོར་འདི་བཞིན་གདམས་པར་བྱ། ། ཁྱེད་ཚོ་ང་ཡི་དགའ་གྲོགས་དང་ཕྲད་ན། ། ང་ནི་བརྩེ་དུངས་དབང་གིས་གདུང་ཞེས་སྨྲོས། །"]},{"type":"verse","number":9,"content":["ཁྱེད་ཀྱི་དགའ་གྲོགས་གཞན་ལས་ལྷག་པ་ཅི། ། ཀྱེ་ཀྱེ་བུད་མེད་ནང་གི་མཛེས་མའི་མཆོག ། ང་ཚོར་ཡང་ཡང་དེ་འདྲའི་མནའ་འགེལ་བས། ། ཁྱེད་ཀྱི་དགའ་གྲོགས་གཞན་ལས་ལྷག་པ་ཅི། །"]},{"type":"verse","number":10,"content":["ང་ཡི་དགའ་གྲོགས་དཀར་ལ་དམར་མདངས་རྒྱས། ། འཇིག་རྟེན་སྐྱེས་བོ་ཁྲི་ཕྲག་ལས་ཀྱང་མཆོག །"]},{"type":"verse","number":11,"content":["ཁོང་གི་དབུ་ནི་ལྷད་མེད་གསེར་དང་འདྲ། ། སྐྲ་ལོ་འཁྱིལ་ཞིང་ཕོ་རོག་ལྟར་ནག་གོ །"]},{"type":"verse","number":12,"content":["སྤྱན་ནི་གཙང་པོ་འགྲམ་གྱི་ཕུག་རོན་ལྟར། ། འོ་མའི་ཁྲུས་ལ་ཞུགས་ནས་ལེགས་པར་བཀོད། །"]},{"type":"verse","number":13,"content":["མཁུར་ཚོས་གཉིས་ནི་མེ་ཏོག་ར་བའི་ནང་། ། དྲི་ཞིམ་ཕྱོགས་བཞིར་འཐུལ་བའི་མེ་ཏོག་འདྲ། ། མཆུ་སྒྲོས་ཟུང་ནི་མེ་ཏོག་ཀུ་མུད་བཞིན། ། དེ་ལས་གུ་གུལ་རྩི་བཅུད་ཐིགས་པ་ཡིན། །"]},{"type":"verse","number":14,"content":["ཕྱག་ངར་བཻཌཱུརྱས་བརྒྱན་པའི། ། གསེར་གྱི་གདུབ་བུ་དང་མཚུངས་ཞིང་། ། སྐུ་ནི་བ་སོ་ལྷག་གེ་བ། ། དབང་སྔོན་གྱིས་ནི་བརྒྱན་དང་མཚུངས། །"]},{"type":"verse","number":15,"content":["ཞབས་ནི་ཀ་མ་རུ་ཡི་ཀ་བར་མཚུངས། ། ལྷད་མེད་གསེར་གྱི་ཞབས་རའི་སྟེང་དུ་བཞེངས། ། ཁོང་གི་གཟུགས་བརྙན་ལེ་པཱ་ནོན་དང་འདྲ། ། ཐང་ཤིང་ལྟར་དུ་མཛེས་ཤིང་ལྟ་ན་སྡུག །"]},{"type":"verse","number":16,"content":["ཁོང་གི་ཞལ་ནི་རབ་ཏུ་མངར་བ་དང་། ། ཐམས་ཅད་ཡིད་དུ་འོང་བ་ཡིན་ལགས་ཤིང་། ། ཡེ་རུ་སཱ་ལེམ་ཡུལ་གྱི་བུ་མོ་རྣམས། ། དེ་ནི་ང་ཡི་སྙིང་གི་དགའ་གྲོགས་དང་། ། དེ་ནི་ང་ཡི་གྲོགས་ཀྱི་མཆོག་ལགས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}