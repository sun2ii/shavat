{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEC","translationId":"bod_ntb","name":"ཟཱ་ཀར་ཡ།","commonName":"ཟཱ་ཀར་ཡ།","title":"༄༅། །ལུང་སྟོན་པ་ཟཱ་ཀར་ཡའི་མདོ།","order":38,"numberOfChapters":14,"sha256":"b5975db1306aa2516859d53fdcd4e2523973ad7f91d434886dab9da89657808f","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":11,"content":[{"type":"heading","content":["ཕན་ཐོགས་མེད་པའི་ལུག་རྫི་དོར་བ།"]},{"type":"verse","number":1,"content":["ཀྱེ་ལེ་པཱ་ནོན། མེ་ཡིས་ཁྱོད་ཀྱི་ཐང་ཤིང་བསྲེག་པའི་ཆེད་དུ་རང་གི་སྒོ་རྣམས་ཕྱེས་ཤིག"]},{"type":"verse","number":2,"content":["ཀྱེ་གསོམ་ཤིང་ལགས། མྱ་ངན་བྱོས་ཤིག ཅི་ལ་ཞེ་ན། ཐང་ཤིང་རྣམས་འགྱེལ་བ་དང་། རྔམ་བརྗིད་ཆེ་བའི་ལྗོན་ཤིང་རྣམས་བརླགས་སོ། །ཀྱེ་པཱ་ཤན་གྱི་བེ་ཤིང་རྣམས། མྱ་ངན་བྱོས་ཤིག ཅི་ལ་ཞེ་ན། ནགས་ཚལ་སྟུག་པོ་རྣམས་བཅད་པས་སོ། །"]},{"type":"verse","number":3,"content":["ལུག་རྫི་རྣམས་ཀྱིས་མྱ་ངན་འདོན་པའི་སྐད་ལ་ཉོན་ཅིག གང་ལ་ཞེ་ན། དེ་དག་གི་ཡིད་དུ་འོང་བའི་རྩྭ་ཐང་རྣམས་བརླགས་པ་རེད། ཡང་སེང་གེ་དར་མས་ང་རོ་འདོན་པའི་སྒྲ་ལ་ཉོན་ཅིག གང་ལ་ཞེ་ན། ཡོར་དན་གཙང་འགྲམ་གྱི་སྤང་ཐང་ཡིད་དུ་འོང་བ་བརླགས་པས་སོ། །"]},{"type":"verse","number":4,"content":["ང་ཡི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་བཤའ་བར་འགྱུར་བའི་ལུག་ཁྱུ་འདི་འཚོས་ཤིག"]},{"type":"verse","number":5,"content":["ལུག་ཁྱུ་ཉོ་མཁན་དག་གིས་དེ་རྣམས་བཤས་ཀྱང་སྡིག་པར་མི་བརྩི་ཞིང་། ལུག་ཁྱུ་བཙོང་མཁན་དག་ན་རེ། ང་རང་ཕྱུག་པོར་གྱུར་པས་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་བསྟོད་པར་འོས་པ་ཡིན་ཞེས་ལུག་ཁྱུའི་ལུག་རྫི་རྣམས་ཀྱིས་དེ་ལ་སྙིང་རྗེ་མ་བསྐྱེད་དོ། །"]},{"type":"verse","number":6,"content":["དེ་བས་ངས་ཀྱང་ཡུལ་འདིའི་མི་རྣམས་ལ་སྙིང་རྗེ་བར་མི་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས། ལྟོས་དང་། ངས་དེ་དག་རེ་རེ་བཞིན་ཁོའི་ཁྱིམ་མཚེས་དང་རྒྱལ་པོའི་ལག་ཏུ་གཏོད་ཅིང་། དེ་དག་གིས་ཡུལ་འདི་བརླག་པར་བྱེད་པ་དང་། ངས་ཡུལ་འདིའི་མི་རྣམས་ནི་དེ་དག་གི་ལག་ནས་སྐྱོབ་པར་མི་བྱའོ་ཞེས་གསུངས།"]},{"type":"verse","number":7,"content":["དེ་ལྟར་ངས་བཤས་ལུག་ཏུ་བརྩིས་པའི་ལུག་ཁྱུ་ནང་གི་ཉམ་ཐག་རྣམས་འཚོས་པ་དང་། ངས་དབྱུག་པ་གཉིས་བླངས་ནས། གཅིག་གི་མིང་ལ་དྲིན་གྱིས་སྐྱོང་བ་ཞེས་དང་། གཞན་དེ་ལ་ལྷན་འབྲེལ་ཞེས་བཏགས་ཤིང་། དེ་ནས་ངས་ལུག་ཁྱུ་འཚོས་པ་དང་།"]},{"type":"verse","number":8,"content":["ཟླ་བ་གཅིག་གི་ནང་དུ་ངས་ལུག་རྫི་གསུམ་གྱི་སྲོག་བཅད་དེ། ང་སེམས་གཏིང་ནས་ལུག་ཁྱུ་ལ་སུན་སྣང་སྐྱེས་ཤིང་། དེ་དག་ཀྱང་ང་ལ་ཞེན་ཁ་ལོག་པའོ། །"]},{"type":"verse","number":9,"content":["དེ་ནས་ངས་འདི་ལྟར། ད་ནི་ངས་ཁྱོད་རྣམས་འཚོ་བར་མི་བྱ་སྟེ། འཆི་བར་འགྱུར་བ་དེ་འཆི་བར་གྱུར་ཅིག མེད་པར་འགྱུར་བ་དེ་མེད་པར་གྱུར་ཅིག ལྷག་ལུས་རྣམས་ལ་ཕན་ཚུན་གྱི་ཤ་བཟའ་རུ་ཆུག་ཅེས་སྨྲས།"]},{"type":"verse","number":10,"content":["དེ་ནས་མི་རིགས་ཐམས་ཅད་ལ་བཞག་པའི་ཞལ་ཆད་དེ་མེད་པར་བཟོ་བའི་ཆེད་དུ། ངས་རང་གི་དྲིན་གྱིས་སྐྱོང་བ་ཞེས་པའི་དབྱུག་པ་དེ་བླངས་ནས་བཅག་པ་དང་།"]},{"type":"verse","number":11,"content":["ཞལ་ཆད་དེ་ནི་ཉིན་མོ་དེར་སྤངས་པ་ཡིན། དེ་ལྟར་ང་ལ་རེ་ལྟོས་བཅངས་པའི་ལུག་ཁྱུ་ཉམ་ཐག་རྣམས་ཀྱིས་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ཡིན་པ་རྟོགས་པར་གྱུར།"]},{"type":"verse","number":12,"content":["ངས་དེ་དག་ལ་འདི་ལྟར། ཁྱོད་རྣམས་ཀྱིས་ལེགས་པར་འདོད་ན་ང་ལ་ལས་གླ་སྤྲོད་ཅིག དེ་ལྟར་མིན་ཚེ་སྐྱུར་ཞོག་ཅེས་སྨྲས་པ་ལ། དེ་དག་གིས་ངའི་ལས་གླ་རུ་དངུལ་སྲང་སུམ་ཅུ་སྤྲད་བྱུང་།"]},{"type":"verse","number":13,"content":["དུས་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་ཀྱིས་དངུལ་དེ་དག་རྫ་མཁན་ལ་གཡུགས་ཞོག་ཅེས་གསུངས་པ་དང་། དངུལ་དེ་དག་ནི་ཁོ་ཚོས་ང་ལ་འཐོབ་འོས་པར་འདོད་པའི་རིན་མཐོན་པོ་ཡིན་ནོ། །ངས་དངུལ་སྲང་སུམ་ཅུ་དེ་ཁྱེར་ནས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་རྫ་མཁན་ལ་གཡུགས་སོ། །"]},{"type":"verse","number":14,"content":["ཡང་ཡ་ཧུ་དཱ་དང་ཡེས་ར་ཨེལ་གཉིས་ཀྱི་སྤུན་ཟླའི་འབྲེལ་ཐག་གཅོད་པའི་ཆེད་དུ། ངས་མིང་ལ་ལྷན་འབྲེལ་ཞེས་པའི་དབྱུག་པ་གཞན་དེ་བཅག་གོ །"]},{"type":"verse","number":15,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་ང་ལ་འདི་སྐད་དུ། ཁྱོད་སོང་ལ་ཡང་ལུག་རྫི་བླུན་རྨོངས་ཅན་གྱི་དབྱུག་པ་ཁྱེར་ཤོག་ཅིག"]},{"type":"verse","number":16,"content":["གང་ལ་ཞེ་ན། ངས་ཡུལ་འདི་རུ་ལུག་རྫི་ཞིག་དར་བར་བྱ་སྟེ། འཆི་ལ་ཉེ་བ་དེ་དག་ལ་ཁོང་གིས་གཟིགས་སྐྱོང་མི་མཛད་ཅིང་། ཁ་འཐོར་དུ་སོང་བ་དེ་དག་ཁོང་གིས་མི་བཙལ། རྨས་ཕོག་པ་རྣམས་ཁོང་གིས་མི་གསོ། ཤ་ཤེད་ཅན་རྣམས་ཁོང་གིས་མི་འཚོ། ཡིན་ནའང་ཁོང་གིས་ལུག་ཚོན་པོའི་ཤ་བཟའ་ཞིང་། དེ་དག་གི་རྨིག་པ་རྣམས་དབྲལ་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["ལུག་ཁྱུ་དོར་བ་དང་ཕན་མི་ཐོགས་པའི་ལུག་རྫི་དེ་ལ་ཆག་སྒོ་འབྱུང་། དེའི་དཔུང་པ་དང་མིག་གཡས་པའི་ཁར་རལ་གྲི་འཕོག་པར་གྱུར་ཅིག དེའི་དཔུང་པ་ཟུངས་ཟད་ནས་མིག་གཡས་པ་དེ་ཡོངས་སུ་ལོང་བར་གྱུར་ཅིག་ཅེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ZEC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ZEC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEC/10.json","previousChapterAudioLinks":{},"numberOfVerses":17}