{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEC","translationId":"bod_ntb","name":"ཟཱ་ཀར་ཡ།","commonName":"ཟཱ་ཀར་ཡ།","title":"༄༅། །ལུང་སྟོན་པ་ཟཱ་ཀར་ཡའི་མདོ།","order":38,"numberOfChapters":14,"sha256":"b5975db1306aa2516859d53fdcd4e2523973ad7f91d434886dab9da89657808f","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":12,"content":[{"type":"heading","content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རུ་སཱ་ལེམ་བསྲུང་བར་འགྱུར་བ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ལུང་གནང་བ་འདི་ལྟ་སྟེ། འདི་ནི་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེས་ར་ཨེལ་གྱི་སྐོར་ལ་གསུངས་པའི་བཀའ་ཡིན་ཏེ་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་པའོ། །ཁོང་གིས་ནམ་མཁའ་བཏིངས་པ་དང་། ས་གཞིའི་རྨང་རྡོ་བཙུགས་ཏེ། མིའི་ནང་གི་སེམས་ཉིད་བཀོད་པར་མཛད་དོ། །"]},{"type":"verse","number":2,"content":["ལྟོས་དང་། བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ནི་མཐའ་འཁོར་གྱི་མི་སྡེ་ཐམས་ཅད་བཟི་བར་འགྱུར་བའི་ཕོར་བ་རུ་བྱ་སྟེ། ཡེ་རུ་སཱ་ལེམ་མཐའ་ནས་བསྐོར་བའི་ཚེ། ཡ་ཧུ་དཱ་ལའང་རྒོལ་བར་འགྱུར།"]},{"type":"verse","number":3,"content":["ཉིན་མོ་དེར་མི་རིགས་ཐམས་ཅད་ལ་མཚོན་ན་བདག་གིས་ཡེ་རུ་སཱ་ལེམ་ནི་ཤིན་ཏུ་ལྕི་བའི་རྡོ་ལྟ་བུར་བྱས་ནས། དེ་ཡར་འདེགས་མཁན་ཐམས་ཅད་ལ་རྨས་སྐྱོན་ཚབས་ཆེན་འབྱུང་བ་དང་། ས་སྟེང་གི་མི་རིགས་ཐམས་ཅད་ཕྱོགས་གཅིག་ཏུ་འདུས་ནས་ཡེ་རུ་སཱ་ལེམ་ལ་རྒོལ་བར་འགྱུར་རོ། །"]},{"type":"verse","number":4,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ཉིན་མོ་དེར། བདག་གིས་རྟ་ཐམས་ཅད་ལ་བརྒྱབ་ནས་དེ་རྣམས་འདྲོག་ཏུ་འཇུག་པ་དང་། རྟ་ལ་ཞོན་མཁན་རྣམས་ལ་བརྒྱབ་ནས་དེ་རྣམས་སྨྱོ་བར་བྱའོ། །ངས་མིག་ཟུང་ཕྱེས་ནས་ཡ་ཧུ་དཱའི་ཁྱིམ་རྒྱུད་ལ་ལྟ་སྐྱོང་བྱེད་ཅིང་། བདག་གིས་མི་རིགས་ཀུན་གྱི་རྟ་ཐམས་ཅད་ལ་བརྡུངས་ནས་དེ་རྣམས་ལོང་བར་བྱའོ། །"]},{"type":"verse","number":5,"content":["དུས་དེར་ཡ་ཧུ་དཱའི་ཚོ་དཔོན་གྱིས་སེམས་སུ་འདི་ལྟར། ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེ་སྟེ་རང་གི་དཀོན་མཆོག་ལ་བརྟེན་ནས་སྟོབས་ཤུགས་འཛོམས་པ་ཡིན་སྙམ་པའོ། །"]},{"type":"verse","number":6,"content":["ཉིན་མོ་དེ་ལ། བདག་གིས་ཡ་ཧུ་དཱའི་ཚོ་དཔོན་རྣམས་ནི་བུད་ཤིང་གི་དཀྱིལ་དུ་ཡོད་པའི་མེ་ཕོར་དང་། ཚར་ཕོན་ནང་གི་དཔལ་འབར་བཞིན་དུ་བྱ་སྟེ། དེ་དག་གིས་རང་གི་གཡས་གཡོན་དང་མཐའ་འཁོར་དུ་ཡོད་པའི་མི་སྡེ་ཐམས་ཅད་ཁྱུར་མིད་གཏོང་བར་འགྱུར། ཡིན་ནའང་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་རྣམས་ནི་གྲོང་ཁྱེར་ནང་གི་སྔར་གནས་སུ་ཆགས་པར་འགྱུར།"]},{"type":"verse","number":7,"content":["དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་ཀྱི་གཟི་བརྗིད་ནི་ཡ་ཧུ་དཱ་པ་ལས་ཆེ་བར་མི་འགྱུར་བའི་ཆེད་དུ། དཀོན་མཆོག་ཡ་ཝཱེས་ཡ་ཧུ་དཱའི་གུར་རྣམས་སྔོན་ལ་སྐྱོབ་པར་འགྱུར།"]},{"type":"verse","number":8,"content":["ཉིན་མོ་དེ་ལ་དཀོན་མཆོག་ཡ་ཝཱེས་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་བསྲུང་བར་མཛད་ཅིང་། དེ་དག་ཁྲོད་ཀྱི་ཉམ་ཐག་རྣམས་ནི་དཱ་བིད་དང་འདྲ་ཞིང་། དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་ནི་དཀོན་མཆོག་དང་འདྲ་སྟེ། དེ་དག་གི་མདུན་དུ་སྐྱོད་པའི་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕོ་ཉ་དང་འདྲ་བར་འགྱུར།"]},{"type":"verse","number":9,"content":["ཉིན་མོ་དེར་ངས་ཡེ་རུ་སཱ་ལེམ་ལ་རྒོལ་དུ་འོངས་པའི་མི་རིགས་རྣམས་སྲོག་དང་དབྲལ་བར་བྱའོ། །"]},{"type":"heading","content":["མྱ་ངན་ཆེན་པོ།"]},{"type":"verse","number":10,"content":["ཡང་བདག་གིས་དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་ཀྱི་སྟེང་དུ་ཐུགས་རྗེ་དང་སྐྱབས་འཇུག་ཞུ་བའི་སེམས་ཉིད་ལྡུག་པར་བྱ་ཞིང་། དེ་དག་གིས་སྔར་རང་གི་མདུང་གིས་བསྣུན་པ་བདག་ལ་རེ་ལྟོས་བཅངས་ནས། རང་གི་བུ་གཅིག་པོ་ཤོར་བ་བཞིན་དུ་དེའི་དོན་དུ་མྱ་ངན་བྱེད་ཅིང་། ཡང་རང་གི་བུ་སྐྱེས་འགོ་ཤོར་བ་བཞིན་དུ་དེའི་ཆེད་དུ་མྱ་ངན་དྲག་པོ་བྱེད་པར་འགྱུར་རོ། །"]},{"type":"verse","number":11,"content":["ཉིན་མོ་དེར། མེ་གིད་དོ་ཐང་ཆེན་གྱི་ཧ་དད་རིམ་མོན་གྱི་མྱ་ངན་དང་འདྲ་བའི་མྱ་ངན་ཆེན་པོ་ཞིག་ཡེ་རུ་སཱ་ལེམ་དུ་འབྱུང་བར་འགྱུར་ལ།"]},{"type":"verse","number":12,"content":["ས་གཞི་ཐམས་ཅད་ཀྱིས་མྱ་ངན་བྱ་ཞིང་ཁྱིམ་རྒྱུད་རེ་རེས་སོ་སོར་བསྡད་ནས་མྱ་ངན་བྱ་སྟེ། དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་སོ་སོར་སྡོད་པ་དང་། དེའི་བུད་མེད་རྣམས་སོ་སོར་སྡོད་པ་ཡིན། ནཱ་ཐན་གྱི་ཁྱིམ་རྒྱུད་སོ་སོར་སྡོད་པ་དང་། དེའི་བུད་མེད་རྣམས་ཀྱང་སོ་སོར་སྡོད་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ལེ་ཝིའི་ཁྱིམ་རྒྱུད་སོ་སོར་སྡོད་པ་དང་། དེའི་བུད་མེད་རྣམས་སོ་སོར་སྡོད་པ་ཡིན། ཤི་མེ་ཨིའི་ཁྱིམ་རྒྱུད་སོ་སོར་སྡོད་པ་དང་། དེའི་བུད་མེད་རྣམས་ཀྱང་སོ་སོར་སྡོད་པ་ཡིན།"]},{"type":"verse","number":14,"content":["དེ་འཕྲོས་ཁྱིམ་རྒྱུད་རྣམས་ཀྱང་རེ་རེ་བཞིན་སོ་སོར་སྡོད་པ་དང་། དེ་དག་གི་བུད་མེད་རྣམས་ཀྱང་སོ་སོར་སྡོད་པའོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ZEC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ZEC/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}