{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEC","translationId":"bod_ntb","name":"ཟཱ་ཀར་ཡ།","commonName":"ཟཱ་ཀར་ཡ།","title":"༄༅། །ལུང་སྟོན་པ་ཟཱ་ཀར་ཡའི་མདོ།","order":38,"numberOfChapters":14,"sha256":"b5975db1306aa2516859d53fdcd4e2523973ad7f91d434886dab9da89657808f","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["སྐུ་འདྲ་དང་ལུང་སྟོན་པ་རྫུན་མ་རྣམས་མེད་པར་བཟོ་བ།"]},{"type":"verse","number":1,"content":["ཉིན་མོ་དེར་དེ་དག་གི་སྡིག་པ་དང་མི་གཙང་བ་རྣམས་འདག་པའི་ཆེད་དུ། དཱ་བིད་ཀྱི་ཁྱིམ་རྒྱུད་དང་ཡེ་རུ་སཱ་ལེམ་གྱི་ཡུལ་མི་རྣམས་ལ་ཆུ་མིག་ཅིག་བརྡོལ་བར་འགྱུར།"]},{"type":"verse","number":2,"content":["ཉིན་མོ་དེར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་ཏེ། ངས་གནས་འདི་ནས་སྐུ་འདྲའི་མིང་རྣམས་མེད་པར་བྱ་སྟེ། སུས་ཀྱང་དེ་དག་དྲན་པར་མི་འགྱུར་ལ། ཡང་ངས་ལུང་སྟོན་པ་དང་སེམས་ཉིད་མི་གཙང་བ་རྣམས་གནས་འདི་ནས་སྐྲོད་པར་བྱའོ། །"]},{"type":"verse","number":3,"content":["གལ་ཏེ་སུ་ཞིག་གིས་ད་དུང་ལུང་སྟོན་པ་ཡིན་ན། དེའི་ལུས་སྦྱིན་གྱི་ཕ་མ་གཉིས་ཀྱིས་དེ་ལ་འདི་ལྟར། ཁྱོད་ནི་གསོན་མི་འོས་ཏེ། གང་ལ་ཞེ་ན། ཁྱོད་ཀྱིས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཚན་གྱི་སྒོ་ནས་རྫུན་སྨྲས་སོ་ཞེས་སྨྲ་བར་འགྱུར་བ་དང་། དེ་ནས་ཁོས་རྫུན་གྱིས་ལུང་སྟོན་དུས། དེའི་ལུས་སྦྱིན་གྱི་ཕ་མ་གཉིས་ཀྱིས་ཁོ་ལ་བསྣུན་ནས་གསོད་པར་འགྱུར།"]},{"type":"verse","number":4,"content":["ཉིན་མོ་དེར། ལུང་སྟོན་པ་རྫུན་མས་ལུང་སྟོན་དུས་སུ། རེ་རེ་རང་གིས་གླེང་བའི་ཞལ་གཟིགས་ཀྱི་དབང་གིས་ངོ་ཚ་བར་འགྱུར་ལ། ད་ནི་དེ་དག་གིས་པགས་པའི་གྱོན་པ་གྱོན་ནས་མི་ལ་བསླུ་བར་མི་བྱ།"]},{"type":"verse","number":5,"content":["སྐབས་དེར་ཁོས་འདི་ལྟར། ང་ནི་ལུང་སྟོན་པ་ཞིག་མ་ཡིན་ལ་ཞིང་པ་ཞིག་ཡིན་ཏེ། གང་ལ་ཞེ་ན། ང་ནི་ཆུང་དུས་ནས་གཡོག་པོ་བྱེད་དུ་བཙོངས་པའོ་ཞེས་སྨྲ་ངེས་ཡིན།"]},{"type":"verse","number":6,"content":["ཡང་མི་ཞིག་གིས་དེ་ལ་འདི་ལྟར། ཁྱོད་ཀྱི་ལག་པ་གཉིས་ཀྱི་བར་དུ་རྨ་འདི་རྣམས་ཡོད་པ་ཅི་ཡིན་ནམ་ཞེས་དྲིས་ན། དེས་ལན་དུ། འདི་དག་ནི་ང་ལ་གཅེས་པའི་མི་ཡི་ཁྱིམ་དུ་ཕོག་པའི་རྨ་ཡིན་ནོ་ཞེས་སྨྲ་བར་འགྱུར།"]},{"type":"heading","content":["ལུག་རྫི་ལ་བརྡུང་བའི་ལུང་བསྟན།"]},{"type":"verse","number":7,"content":["ཀྱེ་རལ་གྲི་ལགས། ངའི་ལུག་རྫི་དང་ཟླ་གྲོགས་ལ་རྒོལ་བར་གྱིས་ཤིག་ཅེས་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས། ལུག་རྫི་ལ་རྡུང་བརྡེག་བྱོས་དང་ལུག་ཁྱུ་ཁ་འཐོར་དུ་འགྲོ་སྟེ། ངས་ཀྱང་ལག་པ་བརྐྱངས་ནས་ལུ་གུ་ལ་བརྡེག་པར་བྱའོ། །"]},{"type":"verse","number":8,"content":["དེའི་དུས་སུ་ས་གཞི་ཡོངས་ཀྱི་མི་ཡི་གསུམ་ཆ་གཉིས་བསྣུན་ནས་མེད་པར་བྱས་ཏེ་གསུམ་ཆ་གཅིག་ལུས་པར་འགྱུར་རོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་གསུངས་སོ། །"]},{"type":"verse","number":9,"content":["ཡང་བདག་གིས་གསུམ་ཆ་གཅིག་དེར་མེ་བརྒྱུད་ནས་ཚོད་བརྟག་བྱེད་ཅིང་། དངུལ་གྱི་ལྷད་འདོན་པ་བཞིན་ངས་དེ་རྣམས་གཙང་མར་བཟོ་དགོས་ལ། ཡང་གསེར་ལ་བཙོ་སྦྱང་བྱེད་པ་བཞིན་ངས་དེ་རྣམས་ལ་ཚོད་བརྟག་བྱེད་དོ། །དེ་ནས་ཁོ་རྣམས་ཀྱིས་བདག་གི་མིང་ནས་འབོད་ཅིང་བདག་གིས་ཀྱང་ལན་འདེབས་པར་འགྱུར་ལ། འདི་ནི་བདག་གི་འབངས་མི་ཡིན་ཞེས་བདག་གིས་སྨྲ་བ་དང་། དེ་རྣམས་ཀྱིས་ཀྱང་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ང་ཡི་དཀོན་མཆོག་ཡིན་ཞེས་སྨྲ་བར་འགྱུར་རོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}