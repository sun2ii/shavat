{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEC","translationId":"bod_ntb","name":"ཟཱ་ཀར་ཡ།","commonName":"ཟཱ་ཀར་ཡ།","title":"༄༅། །ལུང་སྟོན་པ་ཟཱ་ཀར་ཡའི་མདོ།","order":38,"numberOfChapters":14,"sha256":"b5975db1306aa2516859d53fdcd4e2523973ad7f91d434886dab9da89657808f","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":6,"content":[{"type":"heading","content":["ཤིང་རྟ་བཞི་ཡི་ཞལ་གཟིགས།"]},{"type":"verse","number":1,"content":["ཡང་ངས་མགོ་ཡར་བཀྱགས་ནས་བལྟས་པ་ན། རི་བོ་གཉིས་ཀྱི་བར་ནས་ཤིང་རྟ་བཞི་ཐོན་པ་མཐོང་སྟེ། རི་བོ་དེ་གཉིས་ནི་ལི་ཡི་རི་བོ་ཡིན་ནོ། །"]},{"type":"verse","number":2,"content":["ཤིང་རྟ་དང་པོ་རྟ་རྐྱང་རྐྱང་རྣམས་དང་། ཤིང་རྟ་གཉིས་པ་རྟ་ནག་པོ་རྣམས།"]},{"type":"verse","number":3,"content":["ཤིང་རྟ་གསུམ་པ་རྟ་དཀར་པོ་རྣམས། ཤིང་རྟ་བཞི་པ་རྟ་ཁྲ་ཁྲ་རྣམས་ལ་སྦྲེལ་ཡོད་དེ། རྟ་ཐམས་ཅད་སྟོབས་དང་ལྡན་པ་ཡིན་ནོ། །"]},{"type":"verse","number":4,"content":["དེ་ནས་བདག་གིས་ང་ལ་གསུང་གནང་བའི་ཕོ་ཉ་དེ་ལ་འདི་ལྟར། ང་ཡི་ཇོ་བོ་ལགས། འདི་རྣམས་ཅི་ཞིག་ཡིན་ནམ་ཞེས་ཞུས་པ་ལ།"]},{"type":"verse","number":5,"content":["ཕོ་ཉ་དེས་ང་ལ་འདི་སྐད་དུ། འདི་དག་ནི་གནམ་གྱི་རླུང་བཞི་པོ་ཡིན་ཏེ། ས་གཞི་ཡོངས་ཀྱི་བདག་པོའི་དྲུང་ནས་ཐོན་པ་ཡིན་ཞེས་གསུངས།"]},{"type":"verse","number":6,"content":["རྟ་ནག་པོ་རྣམས་ལ་སྦྲེལ་བའི་ཤིང་རྟ་ཕྱི་རུ་ཐོན་ནས་བྱང་ཕྱོགས་ཡུལ་དུ་བསྐྱོད་ཅིང་། རྟ་དཀར་པོ་རྣམས་ལ་སྦྲེལ་བའི་ཤིང་རྟ་ཕྱི་རུ་ཐོན་ནས་དེའི་རྗེས་སུ་བསྐྱོད་པ་དང་། རྟ་ཁྲ་ཁྲ་རྣམས་ལ་སྦྲེལ་བའི་ཤིང་རྟ་ཕྱི་རུ་ཐོན་ནས་ལྷོ་ཕྱོགས་ཡུལ་དུ་བསྐྱོད་པའོ། །"]},{"type":"verse","number":7,"content":["སྟོབས་དང་ལྡན་པའི་རྟ་འདི་རྣམས་ཕྱི་རུ་ཐོན་ནས་ས་གཞི་ཡོངས་སུ་བསྐྱོད་འདོད་པས། ཕོ་ཉ་དེས་འདི་སྐད་དུ། ཁྱོད་རྣམས་སོང་ནས་ས་གཞི་ཡོངས་སུ་སྐྱོད་ཅིག་ཅེས་གསུངས་པ་ན། དེ་རྣམས་ས་གཞི་ཡོངས་སུ་བསྐྱོད་དོ། །"]},{"type":"verse","number":8,"content":["ཡང་ཁོང་གིས་ང་བོས་ཏེ་འདི་སྐད་དུ། ལྟོས་དང་། ཕྱི་རུ་ཐོན་ནས་བྱང་ཕྱོགས་སུ་བསྐྱོད་པ་དེ་དག་གིས་བྱང་ཕྱོགས་ཡུལ་ནས་བདག་ལ་སེམས་གསོ་བྱས་པ་ཡིན་ཞེས་གསུངས་སོ། །"]},{"type":"heading","content":["ཡོ་ཤུ་ཨའི་མགོ་ལ་གསེར་གྱི་ཅོད་པན་བསྐོན་པ།"]},{"type":"verse","number":9,"content":["དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ང་ལ་བྱུང་ནས་འདི་སྐད་དུ།"]},{"type":"verse","number":10,"content":["ཁྱོད་ཀྱིས་ཧེལ་དཱ་ཨི་དང་ཏོ་བི་ཡཱ། ཡེ་དཱ་ཡ་བཅས་ཀྱི་ལག་ནས་བཙོན་དུ་ཁྲིད་པའི་མི་རྣམས་ཀྱིས་ཕུལ་བའི་གསེར་དངུལ་རྣམས་ལོངས་ཤིག་དང་། དེ་རྣམས་པཱ་པེལ་ལོན་ནས་ཕྱིར་ལོག་གོ །ཁྱོད་དེ་རིང་ཟེ་ཕན་ཡཱའི་བུ་ཡོ་ཤུ་ཨ་ཡི་ཁྱིམ་དུ་སོང་སྟེ།"]},{"type":"verse","number":11,"content":["ཁྱོད་ཀྱིས་གསེར་དངུལ་འདི་དག་གིས་ཅོད་པན་ཞིག་བཟོས་ནས། ཡེ་ཧོ་ཙ་དག་གི་བུ་སྟེ་མཆོད་དཔོན་ཆེན་པོ་ཡོ་ཤུ་ཨའི་མགོ་ལ་སྐོན་ཅིག"]},{"type":"verse","number":12,"content":["དེ་ལ་འདི་ལྟར། དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། ལྟོས་དང་། མིང་ལ་ཡལ་ག་ཞེས་འབོད་པ་དེ་ནི་རང་གི་གནས་སུ་དར་བར་མ་ཟད། དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བཞེང་བར་འགྱུར་ལ།"]},{"type":"verse","number":13,"content":["དེས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བཞེངས་ནས་གཟི་བརྗིད་འཐོབ་པ་དང་། རྒྱལ་ཁྲིར་བཞུགས་ནས་རྒྱལ་སྲིད་སྐྱོང་ཞིང་། ཡང་རང་གི་རྒྱལ་ཁྲིའི་སྟེང་མཆོད་དཔོན་དུ་གྱུར་ནས་དེ་གཉིས་འགྲིག་མཐུན་ངང་གནས་པར་བྱའོ། །"]},{"type":"verse","number":14,"content":["ཅོད་པན་དེ་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་ནང་དུ་ཧེལ་དཱ་ཨི་དང་ཏོ་བི་ཡཱ། ཡེ་དཱ་ཡ། ཟེ་ཕན་ཡཱའི་བུ་ཧེན་བཅས་ལ་དྲན་རྟེན་དུ་སྦྱིན་པར་བྱའོ། །"]},{"type":"verse","number":15,"content":["རྒྱང་རིང་གི་མི་རྣམས་དཀོན་མཆོག་ཡ་ཝཱེའི་མཆོད་ཁང་བཞེང་བར་འོངས་ན། ཁྱོད་ཅག་གིས་ང་ནི་དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་གམ་དུ་མངགས་པ་རྟོགས་པར་འགྱུར་ལ། ཇི་སྟེ་ཁྱོད་ཅག་གིས་ཁྱོད་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ལ་གཟབ་གཟབ་བྱས་ནས་མཉན་ན། དེ་བཞིན་དུ་འགྲུབ་ངེས་ཡིན་ཞེས་གསུངས་སོ། །"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ZEC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ZEC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEC/5.json","previousChapterAudioLinks":{},"numberOfVerses":15}