{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEC","translationId":"bod_ntb","name":"ཟཱ་ཀར་ཡ།","commonName":"ཟཱ་ཀར་ཡ།","title":"༄༅། །ལུང་སྟོན་པ་ཟཱ་ཀར་ཡའི་མདོ།","order":38,"numberOfChapters":14,"sha256":"b5975db1306aa2516859d53fdcd4e2523973ad7f91d434886dab9da89657808f","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bod_ntb/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["ཧད་རག་དང་དཱ་མེ་སེག་གཉིས་ལ་ཉེས་ཆད་གཅོད་པ།"]},{"type":"verse","number":1,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་བཀའ་ལུང་གནང་བ་འདི་ལྟ་སྟེ། དཀོན་མཆོག་ཡ་ཝཱེའི་བཀའ་ནི་ཧད་རག་ཡུལ་གྱི་དཱ་མེ་སེག་ལ་ཆེད་དུ་བྱུང་བ་དང་། འཇིག་རྟེན་མི་རྣམས་དང་ཡེས་ར་ཨེལ་གྱི་ཚོ་པ་ཁག་གི་མིག་གིས་དཀོན་མཆོག་ཡ་ཝཱེའི་ཕྱོགས་སུ་རེ་ལྟོས་བྱེད་པའོ། །"]},{"type":"verse","number":2,"content":["ཡང་དཱ་མེ་སེག་གི་ས་མཚམས་ཀྱི་ཧ་མཱད་དང་། ཐཱར། ཚི་ཏུན་གསུམ་པོ་ཤིན་ཏུ་མཁས་པ་ཡིན་ནའང་དེ་དག་གི་སྟེང་དུ་བྱུང་བ་ཡིན།"]},{"type":"verse","number":3,"content":["ཐཱར་གྱིས་རང་གི་ཆེད་དུ་མཁར་བརྟན་པོ་བརྩིགས་ཏེ། དངུལ་ནི་བྱེ་མ་བཞིན་དུ་སྤུངས་པ་དང་། གསེར་བཙོ་མ་ནི་སྲང་ལམ་གྱི་འདམ་བཞིན་དུ་བསྡུས་སོ། །"]},{"type":"verse","number":4,"content":["ལྟོས་དང་། གཙོ་བོས་དེའི་ཡོད་ཚད་ཕྲོགས་ནས། དེའི་རྒྱ་མཚོའི་སྟེང་གི་སྟོབས་ཤུགས་གཏོར་བ་དང་། དེ་ནི་མེས་ཁྱུར་མིད་གཏོང་བར་འགྱུར།"]},{"type":"verse","number":5,"content":["ཨས་ཀ་ལོན་གྱིས་དེ་མཐོང་ནས་འཇིགས་པ་དང་། གཱ་ཟཱས་དེ་མཐོང་ནས་སྡུག་བསྔལ་ཆེན་པོས་མནར་བར་འགྱུར། ཨེག་རོན་ནི་རེ་བ་ཤོར་ནས་ངོ་ཚ་ཞིང་། གཱ་ཟཱའི་རྒྱལ་རྒྱུད་ཆད་པར་འགྱུར་ལ། ཨ་ཤཱ་ཀེ་ལོན་དུ་འདུག་མཁན་མེད།"]},{"type":"verse","number":6,"content":["དེ་ནས་རྒྱུད་འདྲེས་མ་རྣམས་ཨ་སི་དོད་དུ་གནས་པར་འགྱུར་ལ། ངས་ཕེ་ལེ་ཤེད་པའི་ང་རྒྱལ་མེད་པར་བྱའོ། །"]},{"type":"verse","number":7,"content":["ངས་དེ་དག་ཁ་ནང་གི་ཁྲག་དང་སོ་བར་གྱི་ཞེན་ཁ་ལོག་པའི་རྫས་ཐམས་ཅད་མེད་པར་བྱ་སྟེ། མི་ལྷག་ལུས་རྣམས་ནི་རང་ཅག་གི་དཀོན་མཆོག་ལ་གཏོགས་ཤིང་། དེ་ནི་ཡ་ཧུ་དཱའི་མི་རིགས་ཞིག་དང་འདྲ་བར་འགྱུར་ལ། ཨེག་རོན་ནི་ཡེ་བུ་སི་པ་དང་འདྲ་བར་འགྱུར།"]},{"type":"verse","number":8,"content":["ངས་རང་ཁྱིམ་གྱི་མཐའ་འཁོར་དུ་དམག་སྒར་བཙུགས་ནས་དགྲ་བོའི་དམག་རྣམས་འགྲོ་འོང་བྱེད་དུ་མི་འཇུག་ལ། མི་ལ་གཉའ་གནོན་བྱེད་མཁན་གྱིས་ངའི་མི་རྣམས་ལ་བཙན་གནོན་བྱེད་མི་ནུས། ཅི་ལ་ཞེ་ན། ད་ནི་ངས་དེ་དག་ལ་དངོས་སུ་ལྟ་སྐྱོང་བྱེད་པས་སོ། །"]},{"type":"heading","content":["ཕེབས་པར་འགྱུར་བའི་རྒྱལ་པོ།"]},{"type":"verse","number":9,"content":["ཀྱེ་ཛ་ཡན་ཡུལ་གྱི་བུ་མོ་ལགས། རབ་ཏུ་དགའ་བར་གྱིས་ཤིག ཀྱེ་ཡེ་རུ་སཱ་ལེམ་གྱི་བུ་མོ་ལགས། དགའ་འབོད་བྱོས་དང་། ལྟོས་ཤིག ཁྱོད་ཀྱི་རྒྱལ་པོ་ཁྱོད་ཀྱི་གམ་དུ་ཕེབས་འོང་སྟེ། ཁོང་ནི་དྲང་བདེན་དང་སྐྱོབ་མཁན་དེ་ཉིད་ཡིན་ལ། ཁོང་ནི་ཉམས་ཆུང་གིས་བོང་བུར་བཅིབས་པ་སྟེ་བོང་ཕྲུག་ཅིག་ལ་བཅིབས་པའོ། །"]},{"type":"verse","number":10,"content":["ངས་ཨེ་ཕཱར་ཡིམ་ལས་ཤིང་རྟ་དང་ཡེ་རུ་སཱ་ལེམ་ནས་དམག་རྟ་མེད་པར་བྱ་ཞིང་། དམག་གི་གཞུ་གཅོག་པར་བྱ་སྟེ། ཁོང་གིས་མི་སྡེ་རྣམས་ལ་ཞི་བདེ་བསྒྲག་ཅིང་། ཁོང་གི་སྲིད་དབང་ནི་རྒྱ་མཚོ་འདི་ནས་རྒྱ་མཚོ་གཞན་པའི་བར་དང་། ཕི་རཱད་གཙང་པོ་ནས་ས་མཐའི་བར་དུ་སླེབ་པར་འགྱུར།"]},{"type":"verse","number":11,"content":["ཀྱེ་ཛ་ཡན་ལགས། ཁྱོད་རང་ནི་བདག་གིས་ཁྱོད་ལ་བཞག་པའི་ཞལ་ཆད་ཀྱི་ཁྲག་ལ་བརྟེན་ནས། ངས་ཁྱོད་ཀྱི་བཙོན་པ་རྣམས་ཆུ་མེད་པའི་དོང་ལས་སྒྲོལ་བར་བྱའོ། །"]},{"type":"verse","number":12,"content":["ཀྱེ་ཁྱོད་ཅག་བཙོན་ལ་ཁྲིད་ཀྱང་ད་དུང་རེ་བ་ཡོད་པའི་མི་རྣམས་ལགས། བཙན་རྫོང་གི་ཕྱོགས་སུ་ལོག་ཅིག ངས་ཁྱོད་ལ་ལྡབ་འགྱུར་",{"noteId":3},"གྱིས་ཁ་གསབ་རྒྱག་དགོས་ཞེས་དེ་རིང་ངས་བསྒྲགས་པ་ཡིན།"]},{"type":"verse","number":13,"content":["ངས་ཡ་ཧུ་དཱ་ནི་ངའི་ལག་གི་འཐེན་པའི་གཞུ་དང་། ཨེ་ཕཱར་ཡིམ་ནི་ངའི་གཞུ་ཡི་ནང་གི་མདའ་རུ་བྱའོ། །ཀྱེ་ཛ་ཡན་ལགས། ངས་ཁྱོད་ཀྱི་བུ་རྣམས་ལ་ངར་བསླངས་ནས་གྷི་རི་སི་ཡི་བུ་རྣམས་ལ་རྒོལ་དུ་འགྲོ་བར་བྱ་ཞིང་། ངས་ཁྱོད་རང་དཔའ་བོའི་རལ་གྲི་དང་འདྲ་བར་བྱའོ། །"]},{"type":"verse","number":14,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ཉིད་ཀྱི་མི་རྣམས་ཀྱི་སྟེང་དུ་མངོན་པ་དང་། ཁོང་གི་མདའ་ནི་གློག་འཁྱུག་པ་བཞིན་ཕྱི་རུ་འཐོན་པར་འགྱུར་ལ། གཙོ་བོ་ཡ་ཝཱེས་རྭ་དུང་བུས་ནས་ལྷོ་ཕྱོགས་ཀྱི་དྲག་རླུང་དང་བཅས་ཕེབས་པར་འགྱུར།"]},{"type":"verse","number":15,"content":["དཔུང་ཚོགས་ཀུན་གྱི་དཀོན་མཆོག་ཡ་ཝཱེས་དེ་རྣམས་བསྲུངས་ནས། དེ་རྣམས་ཀྱིས་འུར་རྡོ་འཕངས་ནས་དགྲ་བོ་འདུལ་བ་དང་། དེ་དག་གིས་འཐུང་ནས་ཀུ་ཅོ་སྒྲོག་པ་ནི་ཆང་གིས་བཟི་བའི་མི་དང་འདྲ། དེ་དག་ནི་མཆོད་པ་འབུལ་བྱེད་ཀྱི་ཕོར་བ་དང་མཚུངས་ཏེ་ནང་དུ་ཁྲག་གིས་བཀང་ཡོད་ལ། ཡང་མཆོད་ཁྲིའི་གྲུ་ག་རྣམས་དང་འདྲ་སྟེ་ཁྲག་འགོས་ཡོད་པའོ། །"]},{"type":"verse","number":16,"content":["ཉིན་མོ་དེར། ཁོ་རྣམས་ཀྱི་དཀོན་མཆོག་ཡ་ཝཱེས་ཁོ་རྣམས་སྐྱོབ་ཅིང་། ཁོང་གི་མི་རྣམས་ནི་ལུག་ཁྱུ་བཞིན་དུ་སྐྱོང་བར་འགྱུར། ཅི་ལ་ཞེ་ན། དེ་དག་ནི་ཅོད་པན་སྟེང་གི་རིན་པོ་ཆེ་བཞིན་དུ་ཁོང་གི་ས་གཞི་རུ་འོད་འཕྲོ་བར་འགྱུར།"]},{"type":"verse","number":17,"content":["དེ་དག་ནི་ཅི་འདྲའི་ལེགས་ཤིང་ཅི་འདྲའི་ཡིད་དུ་འོང་བ་ལ་ཨང་། འབྲུ་རིགས་སྣ་ལྔ་དང་རྒུན་ཆང་གསར་པས་ཕོ་མོ་ན་གཞོན་རྣམས་ལ་དཔལ་ཡོན་རྒྱས་པར་བྱའོ། །"]}],"footnotes":[{"noteId":3,"caller":"+","text":"འདིར་ལྡབ་འགྱུར་ཞེས་པ་ནི་ཁོ་རྣམས་ལ་སྔོན་ཆད་གང་དང་ཅི་ཡོད་པ་ལས་ཀྱང་ལྷག་པ་ཞེས་པའི་དོན་ལ་འཇུག","reference":{"chapter":9,"verse":12}}]},"thisChapterLink":"/api/bod_ntb/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}