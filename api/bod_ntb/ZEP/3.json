{"translation":{"id":"bod_ntb","name":"དམ་པའི་གསུང་རབ་བོད་འགྱུར་གསར་མ།","website":"https://ebible.org/Scriptures/details.php?id=bodn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bodn","licenseNotes":null,"shortName":"NTB","englishName":"New Tibetan Bible","language":"bod","textDirection":"ltr","sha256":"0c65309de86589185dfea34868b4d0c73d3c92a31592224c6771dcf31e710245","availableFormats":["json"],"listOfBooksApiLink":"/api/bod_ntb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31053,"languageName":"བོད་སྐད་","languageEnglishName":"Tibetan"},"book":{"id":"ZEP","translationId":"bod_ntb","name":"ཟེ་ཕན་ཡཱ།","commonName":"ཟེ་ཕན་ཡཱ།","title":"༄༅། །ལུང་སྟོན་པ་ཟེ་ཕན་ཡཱའི་མདོ།","order":36,"numberOfChapters":3,"sha256":"32882b520ddff3735358823c38f5fab0a9e155736006f9a8f606c8e9fa790030","firstChapterNumber":1,"firstChapterApiLink":"/api/bod_ntb/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bod_ntb/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["ཡེ་རུ་སཱ་ལེམ་གྱི་སྡིག་པ།"]},{"type":"verse","number":1,"content":["གྱེན་ལོག་དང་མི་གཙང་བ། མི་ལ་གཉའ་གནོན་བྱེད་པ་བཅས་ཀྱི་གྲོང་ཁྱེར་འདི་ལ་ཆག་སྒོ་འབྱུང་།"]},{"type":"verse","number":2,"content":["དེས་བཀའ་ལ་མི་མཉན་ལ། བསླབ་བྱ་དང་དུ་མི་ལེན་ཞིང་། དཀོན་མཆོག་ཡ་ཝཱེར་མི་བརྟེན་ལ། རང་གི་དཀོན་མཆོག་དང་ཉེ་བར་ཡང་མི་བྱའོ། །"]},{"type":"verse","number":3,"content":["གྲོང་ཁྱེར་ནང་གི་འགོ་དཔོན་རྣམས་ནི་ངར་སྐད་སྒྲོག་པའི་སེང་གེ་དང་། གྲོང་ཁྱེར་ནང་གི་ཁྲིམས་དཔོན་རྣམས་ནི་མཚན་མོའི་འཕར་སྤྱང་ཡིན་ཏེ། ཞོགས་པའི་བར་དུ་ཅི་ཡང་ལུས་པར་མི་བྱ།"]},{"type":"verse","number":4,"content":["གྲོང་ཁྱེར་ནང་གི་ལུང་སྟོན་པ་རྣམས་ནི་བླང་དོར་མི་ཤེས་པ་དང་གཡོ་སྒྱུ་ཅན་ཡིན་ལ། གྲོང་ཁྱེར་ནང་གི་མཆོད་དཔོན་རྣམས་ཀྱིས་དམ་པའི་གནས་མི་གཙང་བར་བྱས་ནས་བཀའ་ཁྲིམས་དང་འགལ་བའོ། །"]},{"type":"verse","number":5,"content":["དཀོན་མཆོག་ཡ་ཝཱེ་ནི་གྲོང་ཁྱེར་ནང་དུ་དྲང་བདེན་ཡིན་པས། དྲང་བདེན་མིན་པའི་དོན་ནི་གཏན་ནས་མི་མཛད། ཁོང་གིས་ཞོགས་པ་རེ་རེར་དྲང་བདེན་མངོན་ཞིང་ནམ་ཡང་མཚམས་མ་ཆད། ཡིན་ཡང་དྲང་བདེན་མིན་པའི་མི་ལ་ངོ་ཚ་མེད་དོ། །"]},{"type":"verse","number":6,"content":["ང་ཡ་ཝཱེས་མི་རིགས་ཐམས་ཅད་ཚར་དུ་བཅད་པ་དང་། དེ་དག་གི་ལྕོག་མཁར་རྣམས་གཏོར་བར་གྱུར། ངས་དེ་དག་གི་སྲང་ལམ་རྣམས་སྟོངས་སུ་བཅུག་ཅིང་དེ་བརྒྱུད་ནས་འགྲོ་མཁན་མེད་ལ། དེ་དག་གི་གྲོང་ཁྱེར་སྟོང་བར་བསྐྱུར་ནས་མི་གཅིག་ཀྱང་མེད། དེར་འདུག་མཁན་ཡང་མེད་དོ། །"]},{"type":"verse","number":7,"content":["དེ་ནས་ངས་འདི་སྐད་དུ། ཁྱོད་རང་བདག་ལ་གུས་ཤིང་འཇིགས་པ་དང་བསླབ་བྱ་དང་དུ་བླངས་ན། ཁྱོད་ཀྱི་སྡོད་གནས་ནི་ངས་སྔར་ཐག་གིས་བཅད་པ་བཞིན་ཚར་དུ་མི་གཅོད་ཅེས་སྨྲས་པ་ཡིན། ཡིན་ནའང་ཁྱོད་ཅག་གིས་ཞོགས་པ་སྔ་མོ་ནས་བཟུང་སྒོ་ཀུན་ནས་རང་ཉིད་རང་གིས་བརླག་པ་ཡིན་ནོ། །"]},{"type":"verse","number":8,"content":["ཡང་དཀོན་མཆོག་ཡ་ཝཱེས་འདི་སྐད་དུ། དེ་བས་ཁྱོད་རྣམས་ཀྱིས་ང་ལ་སྒུགས་དང་། ང་ཡར་ལངས་ནས་འཕྲོག་བཅོམ་བྱེད་པའི་ཉིན་དེ་ལ་སྒུགས་དང་། ངས་མི་རིགས་ཐམས་ཅད་དང་ཡུལ་ཁམས་ཀུན་བསྡུ་བར་ཐག་བཅད་དེ། ངའི་ཁོང་ཁྲོ་སྟེ་ཁོང་ཁྲོ་ཆེན་པོ་ནི་ཡོངས་སུ་དེ་དག་གི་སྟེང་དུ་ལྡུག་པར་བྱའོ། །ཅིའི་ཕྱིར་ཞེ་ན། ས་གཞི་ཡོངས་ནི་ངའི་ཞེ་སྡང་གི་མེ་ཡིས་ཁྱུར་མིད་གཏོང་བར་འགྱུར་བས་སོ། །"]},{"type":"verse","number":9,"content":["དེའི་དུས་སུ་མི་སྡེ་ཀུན་ལ་དཀོན་མཆོག་ཡ་ཝཱེའི་མིང་ལ་ཞུ་བ་བྱེད་པ་དང་། བློ་གཅིག་སེམས་གཅིག་གིས་ང་ལ་ཞབས་ཕྱི་བྱེད་དུ་འཇུག་པའི་ཕྱིར། བདག་གིས་མི་སྡེ་ཀུན་ལ་ངག་གཙང་མ་ཞིག་ཡོད་པར་བྱའོ། །"]},{"type":"verse","number":10,"content":["དེ་ནས་བདག་གིས་ཁ་ཐོར་དུ་འགྲོ་རུ་བཅུག་པའི་མི་སྟེ། ང་ལ་གསོལ་བ་འདེབས་པའི་མི་རྣམས་ནི་གུ་ཤ་གཙང་པོའི་ཕ་རོལ་ནས་འོངས་ཏེ། ང་ལ་ཞུ་རྟེན་འབུལ་བར་འགྱུར།"]},{"type":"verse","number":11,"content":["ཉིན་མོ་དེ་སླེབས་ཚེ། ཁྱོད་ནི་བདག་དང་འགལ་བའི་སྡིག་པ་ཀུན་གྱི་ཕྱིར་ངོ་ཚ་མི་དགོས་ཏེ། ཅིའི་ཕྱིར་ཞེ་ན། དུས་དེར་བདག་གིས་ཁྱོད་ཀྱི་ནང་གི་མི་རང་རློམ་ཅན་དང་ང་རྒྱལ་ཆེ་བ་རྣམས་ཚར་དུ་གཅོད་ཅིང་། བདག་གི་རི་བོ་དམ་པའི་སྟེང་དུ་ཁྱོད་ཡང་བསྐྱར་ང་རྒྱལ་སྐྱེ་བར་མི་འགྱུར་རོ། །"]},{"type":"verse","number":12,"content":["ཡིན་ནའང་བདག་གིས་ཁྱོད་ནང་གི་མི་ཁེངས་སྐྱུང་ཅན་དང་སྙེམས་ཆུང་རྣམས་ལུས་པར་བྱ་སྟེ། དེ་དག་ནི་དཀོན་མཆོག་ཡ་ཝཱེའི་མིང་ལ་བརྟེན་པར་འགྱུར།"]},{"type":"verse","number":13,"content":["དེ་ནས་ཡེས་ར་ཨེལ་གྱི་ལྷག་ལུས་རྣམས་ཀྱིས་སྡིག་ཉེས་མི་སྤྱོད་ལ། རྫུན་ཡང་མི་སྨྲ་ཞིང་། ཁོ་ཚོའི་སྨྲ་སྒོར་གཡོ་སྒྱུའི་ལྕེ་ཡང་མེད་པ་དང་། ཁོ་རྣམས་ཀྱིས་བཟའ་བཏུང་སྤྱད་ནས་བདེ་བར་གནས་ཤིང་འཇིགས་སྐུལ་མཁན་མེད་དོ། །"]},{"type":"heading","content":["དགའ་སྤྲོའི་མགུར་གླུ།"]},{"type":"verse","number":14,"content":["ཀྱེ་ཛ་ཡན་གྱི་བུ་མོ། ཁྱོད་རྣམས་ཀྱིས་སྐད་གསང་མཐོན་པོས་མགུར་གླུ་ལོངས་ཤིག ཀྱེ་ཡེས་ར་ཨེལ། ཁྱོད་ཀྱིས་དགའ་འབོད་གྱིས་ཤིག ཀྱེ་ཡེ་རུ་སཱ་ལེམ་གྱི་མི་སྡེ་རྣམས། ཁྱོད་རྣམས་ཀྱི་སེམས་སུ་དགའ་སྤྲོས་ཁེངས་པར་གྱིས་ཤིག"]},{"type":"verse","number":15,"content":["དཀོན་མཆོག་ཡ་ཝཱེས་ཁྱོད་རྣམས་ཀྱི་ཉེས་ཆད་མེད་པར་མཛད་དེ། ཁྱོད་ཅག་གི་དགྲ་རྣམས་ཕྱི་རུ་བསྐྲད་པ་ཡིན། ཀྱེ་ཡེས་ར་ཨེལ་གྱི་རྒྱལ་པོ་ཡ་ཝཱེ་ཁྱོད་ཀྱི་ནང་དུ་བཞུགས་པས། ད་ནི་ཁྱོད་རྣམས་གནོད་འཚེ་ལ་འཇིགས་པར་མི་འགྱུར།"]},{"type":"verse","number":16,"content":["ཉིན་མོ་དེ་སླེབས་ཚེ། མི་ཡིས་ཡེ་རུ་སཱ་ལེམ་ལ་འདི་ལྟར། ཀྱེ་ཛ་ཡན་ལགས། མ་འཇིགས་ཤིག ཁྱོད་ཀྱི་ལག་ཤེད་ཉམས་པར་མ་བྱེད་ཅིག"]},{"type":"verse","number":17,"content":["ཁྱོད་དང་མཉམ་དུ་བཞུགས་པའི་དཀོན་མཆོག་ཡ་ཝཱེ་ནི་ནུས་མཐུ་ཆེན་པོ་ལྡན་པའི་སྐྱབས་མགོན་ལགས་ཏེ། ཁོང་ནི་ཁྱོད་ཀྱི་དབང་གིས་ཐུགས་དགྱེས་པར་འགྱུར་ཞིང་། ཁྱོད་ལ་ཤིན་ཏུ་བྱམས་ཏེ། ཁྱོད་ཀྱི་ཕྱིར་དུ་དགྱེས་ཤིང་མགུར་གསུངས་པ་ཡིན།"]},{"type":"verse","number":18,"content":["ཁྱོད་ལ་གཏོགས་ཤིང་འདུ་ཚོགས་ལ་ཡིད་སྨོན་ཤོར་ནས་ཡིད་སྐྱོ་བ་དང་། ཁྱོད་ཀྱི་ངོ་ཚ་ཁུར་བ་རྣམས་ནི་ངས་བསྡུ་བར་བྱའོ། །"]},{"type":"verse","number":19,"content":["ལྟོས་ཤིག དེའི་དུས་སུ་ངས་ཁྱོད་སྡུག་ལ་གཏད་པའི་མི་རྣམས་ལ་ལན་འཇལ་ཞིང་། རྐང་པ་ཞ་བོ་ཡིན་པའི་མི་རྣམས་བསྐྱབས་ནས་ཕྱིར་བསྐྲད་པའི་མི་རྣམས་བསྡུས་ཏེ། ངས་ས་གཞི་ཡོངས་ནས་ངོ་ཚ་ཐེབས་པའི་མི་རྣམས་ལ་བསྟོད་པ་འཐོབ་པ་དང་མཚན་སྙན་ལྡན་པར་བྱའོ། །"]},{"type":"verse","number":20,"content":["དེའི་དུས་སུ་ངས་ཁྱོད་རྣམས་ཕྱིར་འཁྲིད་འོང་ཞིང་ཁྱོད་རྣམས་མཉམ་དུ་བསྡུས་ནས། ངས་བཙོན་དུ་ཁྲིད་པ་ཁྱོད་རྣམས་ཕྱིར་ལོག་ཏུ་འཇུག་པའི་ཚེ། ས་སྟེང་གི་མི་སྡེ་ཀུན་གྱི་ཁྲོད་དུ་ཁྱོད་རྣམས་ལ་མཚན་སྙན་ལྡན་ཞིང་བསྟོད་པ་འཐོབ་པར་བྱའོ་ཞེས་དཀོན་མཆོག་ཡ་ཝཱེས་གསུངས་སོ།། །།"]}],"footnotes":[]},"thisChapterLink":"/api/bod_ntb/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bod_ntb/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bod_ntb/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}