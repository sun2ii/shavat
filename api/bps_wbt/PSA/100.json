kenen na dnayenyu kenen,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"du too fye sa Amuito Dwata;","poem":1},{"text":"i kakdon landè kgilin kel di landè sen,","poem":2},{"lineBreak":true},{"text":"na gsalig i nimoan di kdee to mdà di muna fa na kel di landè sen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":5}