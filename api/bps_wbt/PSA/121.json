{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":121,"content":[{"type":"heading","content":["I Amuito Dwata too mifat i dad ton"]},{"type":"hebrew_subtitle","content":["Ani satu lingag i dad to salu di Bong Gumnè Dwata."]},{"type":"verse","number":1,"content":[{"text":"Meye agu ditù di dad bulul,","poem":1},{"text":"na snalekgu i ktogu ku tanè gumdà i ktabeng deg.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Én tmabeng deg, dunan i Amugu Dwata,","poem":1},{"text":"i mimò i langit na tanà.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laan faloh ku nun gamsasè ge,","poem":1},{"text":"du i mifat ge là sa kudang.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I mifat bel Israél,","poem":1},{"text":"laan gfilot na laan gkudang.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I Amuito Dwata i mifat ge;","poem":1},{"text":"mnè kenen di safédam du guflidungam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I duh là gamsasè ge di mduh,","poem":1},{"text":"ku demen i bulen di butang.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I Amuito Dwata smafang ge mdà di kdee sasè;","poem":1},{"text":"kanlungan ge fye landè gaslokam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kenen i mifat ge balù nè gusalum, na balù nè gumneam,","poem":1},{"text":"mdà ani kel di landè gusenan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}