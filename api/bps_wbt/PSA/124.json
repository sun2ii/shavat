{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":124,"content":[{"type":"heading","content":["Dwata msen di dad ton"]},{"type":"hebrew_subtitle","content":["Ani satu lingag dad to salu di Bong Gumnè Amuito Dwata, mdà di ku Dabid."]},{"type":"verse","number":1,"content":[{"text":"Ku talà msen gito i Amuito Dwata, tan dé i gukelito?","poem":1},{"text":"Tmimel gamu, bel Israél!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hae, ku talà msen gito i Amuito Dwata,","poem":1},{"text":"di kasfati i dad to dmuen gito,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"tafnatila ito mdà di kadfo i bong kalbutla,","poem":1},{"text":"hae, gambet i lmanaf fanla gito fanlo di mto ito fa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nkel ito dad to samfati gito gambet glumfak ito i bong dunuk,","poem":1},{"text":"na nlimun ito i yéél.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na tamlimas ito di kgal i aloh yéél,","poem":1},{"text":"ku là nsen ito i Amuito Dwata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taman, mlé ito kafye di Amuito Dwata,","poem":1},{"text":"du laan ito faloh di kalmoito di kmal i dad to dmuen gito.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tagalwà ito di agotla, gambet satu anuk di bnas galwà di fawel i to mawel;","poem":1},{"text":"hae, galwà ito du tfò dal i fawella.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I tmabeng gito dunan i Amuito Dwata,","poem":1},{"text":"i mimò i langit na tanà.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}