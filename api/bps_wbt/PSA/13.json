{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":13,"content":[{"type":"heading","content":["I to là gfisan du ftabeng di Dwata"]},{"type":"hebrew_subtitle","content":["Ani satu lingag Dabid."]},{"type":"verse","number":1,"content":[{"text":"Amugu Dwata, tan i klom fa mlifet deg?","poem":1},{"text":"Kel kè di landè sen?","poem":2},{"text":"Kel di kilen kafbayaam deg?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tan i klogu fa tmayud di klidù i nawagu?","poem":1},{"text":"Mlidù nawagu tayud duh di kafsasè i dad to dmuen deg.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amugu Dwata, neyem i kagkahgu na tnabengam agu;","poem":1},{"text":"fuléam di deg i kgalgu du fye là agu fles mati;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"du ku fles agu mati ken manla, “Tagfisanmi kenen,”","poem":1},{"text":"na lehew i dad mlayam deg di kagfisangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kabay smalig agu di kakdom i landè kgilin,","poem":1},{"text":"na too agu lehew du falwaam agu kadang.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amugu Dwata, mlingag agu di ge du mdà di bong kafyem di deg.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}