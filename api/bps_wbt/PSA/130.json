{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":130,"content":[{"type":"heading","content":["Én katlo i to gamsalà ftabeng di Dwata"]},{"type":"hebrew_subtitle","content":["Ani satu lingag i dad to salu di Bong Gumnè i Amuito Dwata."]},{"type":"verse","number":1,"content":[{"text":"Amugu Dwata, di too sè klidù i nawagu,","poem":1},{"text":"tamlo agu di ge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amugu, begam agu fanlinge;","poem":1},{"text":"fanlingem i katlogu ftabeng di ge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amugu, ku galam too neye i kdee gugsalàmi, na laam nlifet,","poem":1},{"text":"simto galwà di kukumam? Landè sa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabay nlifetam sa i salàmi,","poem":1},{"text":"du fye toomi ge nafè na nimen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Toogu fatan i kafalwà Amugu Dwata deg,","poem":1},{"text":"na smalig agu di tnaluan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Smasaw i nawagu fatan i tabeng i Amugu Dwata,","poem":1},{"text":"mdatah fa di to munung di butang fatan i kakwalan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gamu bel Israél, smalig gamu di Amuito Dwata,","poem":1},{"text":"du i kakdon landè kgilin,","poem":2},{"lineBreak":true},{"text":"na fdu di kenen i kagalwà landè gukulangan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na kenen msò i bel Israél di kdee salàla.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}