{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":15,"content":[{"type":"heading","content":["I to gablà mnè di Bong Gumnè Dwata"]},{"type":"hebrew_subtitle","content":["Ani satu lingag Dabid."]},{"type":"verse","number":1,"content":[{"text":"E Amugu Dwata, simto gablà mnè di Bong Gumneam?","poem":1},{"text":"Simto gablà mnè di bulul gumneam?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dunan i to too sikof kimenan i knayeam,","poem":1},{"text":"na matlu i nimoan di kitem;","poem":2},{"lineBreak":true},{"text":"too gsalig i galan man, du i kaglut too mnè di nawan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na laan falmo i dademen to fagu di gmanan;","poem":1},{"text":"laan fansasè i dademen to sgalak,","poem":2},{"lineBreak":true},{"text":"na laan samtugad salék gablà di dademen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Toon knang i sasè to kmagol Dwata,","poem":1},{"text":"bay toon nafè i to nun klikò di Amuito Dwata.","poem":2},{"text":"Toon dnohò i dad tafakangan balù tan i kalima di kdohoan dun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fdem kenen na laan fngà i fdeman.","poem":1},{"lineBreak":true},{"text":"Na déén di gusfala laan banlé salà i to landè salà,","poem":1},{"text":"balù nun to mayè tmaden kenen.","poem":2},{"text":"Na nè i to mimò kdee ani,","poem":1},{"text":"kenen i mnè di ifat Dwata kel di landè sen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}