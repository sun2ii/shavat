{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":23,"content":[{"type":"heading","content":["Dwata mifat dad ton"]},{"type":"hebrew_subtitle","content":["Ani satu lingag Dabid."]},{"type":"verse","number":1,"content":[{"text":"I Amugu Dwata i mifat deg salngad satu to gal mifat bilibili,","poem":1},{"text":"na landè gukulanggu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Salngad satu to mifat bilibili mebe dale di too fye gumtebla na faftudan ale déén,","poem":1},{"text":"na neben ale di tukay yéél too mtiu guminumla,","poem":2},{"lineBreak":true},{"text":"salngad én kifat Dwata deg.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kenen i tamgal deg di klungaygu,","poem":1},{"text":"na galan agu nalak di matlu dalan du fye mgafè i dagitan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na balù magu agu di too gukmifun gambet i fati là agu likò,","poem":1},{"text":"du ge, Dwata, i samnagin deg,","poem":2},{"text":"na ge i kamlung na malak deg,","poem":1},{"text":"taman matgal i nawagu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I dad dmuen deg mite i kdawatam deg du ludukam di munagu bong knaan;","poem":1},{"text":"i kdawatam gambet i to too mgafè.","poem":2},{"text":"Landè gukulanggu na lambés i basugu di afeam deg.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amugu Dwata, gadègu là tlag i kafyem na i kakdom deg di klogu mto,","poem":1},{"text":"na mnè agu kadang di safédam kel di landè sen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}