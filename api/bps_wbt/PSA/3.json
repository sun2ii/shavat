{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":3,"content":[{"type":"heading","content":["I to là likò ku nun dmuen kenen"]},{"type":"hebrew_subtitle","content":["Ani lingag Dabid di kilan mdà di tingaan Absalom."]},{"type":"verse","number":1,"content":[{"text":"E Amugu Dwata, file i dad mnang nawa deg!","poem":1},{"text":"Too dee nan dad mbaling dmuen deg!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dee mangman gablà di deg,","poem":1},{"text":"“Là kenen tnabeng Dwata.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabay ge, Amugu Dwata, ge i klung di glibutgu;","poem":1},{"text":"ge i fulê i dengeggu,","poem":2},{"lineBreak":true},{"text":"na ge fulê i kgal nawagu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tafalbonggu i katlogu di Amugu Dwata du ftabeng agu di kenen,","poem":1},{"text":"na fanlingen agu mdà di bulul gumnean.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taman fakay agu milè na kudang na là agu likò;","poem":1},{"text":"mukat agu na landè gaslokgu, du i Amugu Dwata i munung deg.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na balù nun sfalò libu to dmuen deg di glibutgu,","poem":1},{"text":"là agu likò.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gasil ge, Amugu!","poem":1},{"text":"Falwaam agu Dwatagu!","poem":2},{"text":"Du ge falmo i dad to dmuen deg gambet kasféam i kakim dad lmanaf fan makét,","poem":1},{"text":"na gambet katfoam i kifanla fye landè mgimòla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I kagalwà mdà alò di Amuito Dwata.","poem":1},{"text":"Banlém moon kafye i dad tom.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}