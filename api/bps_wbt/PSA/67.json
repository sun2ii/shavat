{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":67,"content":[{"type":"heading","content":["Kdayen i kafye Dwata"]},{"type":"hebrew_subtitle","content":["Ani satu lingag."]},{"type":"verse","number":1,"content":[{"text":"E Dwata, kandom gami, na blém di gami kafye;","poem":1},{"text":"toom fite i klehewam gami;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"du fye gadè kdee to i knayeam,","poem":1},{"text":"na i dad to di klamang banwe, gadèla i kagalwà mdà di ge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E Dwata, mulà moon ku dnayen ge i dad to;","poem":1},{"text":"i kdee to moon too dmayen ge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Flehew moon i dad to di sahal dad banwe na mlingag di klehewla,","poem":1},{"text":"du i kebem i dad to too matlu na ge i mebe i kdee banwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dnayen ge moon i kdee to, Dwata;","poem":1},{"text":"too ge moon dnayen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na nun kadang bong ulê mdà di tanà du Dwata, kenen i Dwataito,","poem":1},{"text":"na kenen sa i mlé gito kafye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hae, du Dwata sa i mlé kafye,","poem":1},{"text":"taman i kdee to di kdee banwe nun klikòla moon di kenen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":7}