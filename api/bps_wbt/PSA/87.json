{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":87,"content":[{"type":"heading","content":["I kafye na kdatah Sion, én banwe Dwata"]},{"type":"hebrew_subtitle","content":["Ani satu lingag bel Kora"]},{"type":"verse","number":1,"content":[{"text":"Fimò Dwata i syudadan di kenen bulul,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"na balù tan kalbong nawan i dademe banwe gumnè i bel Dyékob,","poem":1},{"text":"too bong fa nawan i syudadan, Sion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Too fye na gamtikeng i dad gman gablà di Sion,","poem":1},{"text":"i syudad Dwata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I dad to gmadè Dwata mdà di dad banwe Idyif na Babilon,","poem":1},{"text":"na mdà di dad banwe Filisya, Tiro, na Itiyofya, fakufan ale di dad to sut di banwe Sion.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na i gman gablà di dad to di banwe Sion,","poem":1},{"text":"“Mdatah to, to ani ku demen to atù, du sut di banwe Sion,”","poem":2},{"lineBreak":true},{"text":"du i Too Mdatah Dwata i mlé kafye knè di dad ton.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Di ksulat Dwata dagit i dad ton,","poem":1},{"text":"fakufan i dagit dad to gmadè kenen di dad to sut di banwen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sayew ale na mlingag, manla,","poem":1},{"text":"“Di Sion gumdà i kdee kafyeito.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":7}