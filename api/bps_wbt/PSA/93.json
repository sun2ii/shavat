{"translation":{"id":"bps_wbt","name":"I tnalù dwata","website":"https://ebible.org/Scriptures/details.php?id=bps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bps","licenseNotes":null,"shortName":"WBT","englishName":"Sarangani Blaan NT","language":"bps","textDirection":"ltr","sha256":"684ab4b2664e05249d8c84cf26f11ca16ce29aece401bd6c88e9a8fa7bf2af3f","availableFormats":["json"],"listOfBooksApiLink":"/api/bps_wbt/books.json","numberOfBooks":33,"totalNumberOfChapters":426,"totalNumberOfVerses":11534,"languageName":"Sarangani Blaan","languageEnglishName":"Sarangani Blaan"},"book":{"id":"PSA","translationId":"bps_wbt","name":"Salmo","commonName":"Salmo","title":"Salmo I Libru Lingag dad Bel Israél","order":19,"numberOfChapters":64,"sha256":"d97232fd03f44dd0c0ad30daf5e8442f89423533655dc886a5a76cff67817c41","firstChapterNumber":1,"firstChapterApiLink":"/api/bps_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bps_wbt/PSA/150.json","totalNumberOfVerses":973},"chapter":{"number":93,"content":[{"type":"heading","content":["Dwata i harì"]},{"type":"verse","number":1,"content":[{"text":"Amugu Dwata i harì! Kamlaweh kenen i bong kdatahan na enegan,","poem":1},{"text":"du toon gfite di kgimoan i banwe;","poem":2},{"text":"too mgagid i gufkahan dun,","poem":1},{"text":"na laan mgingok.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amugu Dwata, ge magot kdee mdà di katbuan;","poem":1},{"text":"na di là fa matbù i kdee, tagnè ge déén.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amugu Dwata, too lamyak i dad mahin;","poem":1},{"text":"i luk i dad malbang lwekla too mgal.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabay Amugu Dwata ditù di langit, too mgal i kagotam i kdee,","poem":1},{"text":"mgal fa di luk i dad malbang yéél,","poem":2},{"lineBreak":true},{"text":"mgal fa di malbang lwek di mahin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kdee gmanam, landè kgumanan;","poem":1},{"text":"na du matlu ge, Amugu Dwata,","poem":2},{"lineBreak":true},{"text":"gablà ku matlu i kdee nimò di Bong Gumneam kel di landè sen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bps_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bps_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bps_wbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}