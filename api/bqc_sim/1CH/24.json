{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"1CH","translationId":"bqc_sim","name":"1 Lada","commonName":"1 Lada","title":"LADA SƐ̃IA","order":13,"numberOfChapters":29,"sha256":"816872e045c685b3302ca7998cd074446265795b22cab7090857ca6ddd4b72bb","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bqc_sim/1CH/29.json","totalNumberOfVerses":920},"chapter":{"number":24,"content":[{"type":"heading","content":["Sa'onaↄ zĩ"]},{"type":"verse","number":1,"content":["Aalona bui gãliↄn kɛ: Aalona nɛgↄ̃ɛↄ tↄ́n kɛ: Nadabu, Abiu, Ɛleazaa ń Itamaao."]},{"type":"verse","number":2,"content":["Nadabu ń Abiuo gàga ń mae wáaɛ,",{"noteId":32},"aai nɛgↄ̃ɛ i sↄ̃o. Ɔ̃ Ɛleazaa ń Itamaao gↄ̃̀ sa'onaↄ ũ."]},{"type":"verse","number":3,"content":["Davidi ń Ɛleazaa bui Zadokio ń Itamaa bui Aimɛlɛkio sa'onaↄ kpaalɛ̀ gã ń gão, aaↄ kↄ̃ gba zɛ́ zĩ yã́ musu."]},{"type":"verse","number":4,"content":["Aa dↄaanaↄ è dasi Ɛleazaa buiↄ guu dɛ Itamaa buiↄ guula, ↄ̃ aa Ɛleazaa bui uabeleↄ sɛ̀ gbɛ̃ↄn gɛ̃o ń mɛ̀ndoo, Itamaa bui uabeleↄ sↄ̃ swaaↄ̃."]},{"type":"verse","number":5,"content":["Aa ń kpaalɛ̀ ń gbɛlaaoɛ an wɛgwasai, asa Ɛleazaa buieↄ ń Itamaa buieↄ dɛ Lua kpɛ́ gbɛ̃zↄ̃ↄↄ ń sa'onkiaↄ ũ ḿpiiɛ."]},{"type":"verse","number":6,"content":["Levii bui lakɛ̃na Semaia, Nɛtanɛli nɛ́ ń tↄ́ dàlau kía ń aà ìwaɛ beeↄ wáaɛ: Sa'onkia Zadoki, Abiataa nɛ́ Aimɛlɛki, sa'ona uabeleↄ ń Levii bui uabeleↄ. Tó wà gbɛ̃́ sɛ̀ Ɛleazaa bui guu do, ↄ̃ wì sɛ Itamaa bui guu do."]},{"type":"verse","number":7,"content":[{"text":"Yoialibu mɛ́ sɛ̃́ia,","poem":1},{"lineBreak":true},{"text":"a plaade Yedaia,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"a àaↄ̃de Aliũ,","poem":1},{"lineBreak":true},{"text":"a síiↄ̃de Seoliũ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"a sↄode Malakia,","poem":1},{"lineBreak":true},{"text":"a soolode Miamɛ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"a soplade Akozi,","poem":1},{"lineBreak":true},{"text":"a swaaↄ̃de Abia,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"a kɛ̃okwide Yesua,","poem":1},{"lineBreak":true},{"text":"a kwide Sekania,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"a kuɛdode Ɛliasibu,","poem":1},{"lineBreak":true},{"text":"a kuɛplade Yakiũ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"a kuɛ'aaↄ̃de Hupa,","poem":1},{"lineBreak":true},{"text":"a gɛ̃o mɛ̀ndosaide Yɛsɛba,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"a gɛ̃ode Bilega,","poem":1},{"lineBreak":true},{"text":"a gɛ̃o ń mɛ̀ndoode Imɛɛ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"a gɛ̃o ń plaode Ezii,","poem":1},{"lineBreak":true},{"text":"a bao plasaide Apisɛsi,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"a bao mɛ̀ndosaide Petaia,","poem":1},{"lineBreak":true},{"text":"a baode Yeezekɛli,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"a bao ń mɛ̀ndoode Yakɛ̃,","poem":1},{"lineBreak":true},{"text":"a bao ń plaode Gamulu,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"a bao ń àaↄ̃ode Delaia,","poem":1},{"lineBreak":true},{"text":"a baasↄo mɛ̀ndosaide Maazia.","poem":1}]},{"type":"verse","number":19,"content":["Lá aali gɛ́ zĩkɛi Dii kpɛ́u aaↄ kↄ̃ gba zɛ́n we, lá Dii Isailiↄ Lua dà an dezi Aalonaɛ a dìlɛwa."]},{"type":"heading","content":["Levii bui kĩniↄ"]},{"type":"verse","number":20,"content":["Levii bui kĩniↄn kɛ: Amlaũ bui Sebuɛli nɛ́ Yedeia."]},{"type":"verse","number":21,"content":["Lɛabia yoa Isia."]},{"type":"verse","number":22,"content":["Isaa bui Selomↄ nɛ́ Yaata."]},{"type":"verse","number":23,"content":["Hɛblↄ̃ nɛgↄ̃ɛↄ tↄ́n kɛ: Yelia, Amalia, Yaaziɛ ń Yekamaũo."]},{"type":"verse","number":24,"content":["Uziɛli bui Mika nɛ́ Samii."]},{"type":"verse","number":25,"content":["Mika dãuna Isia nɛ́ Zakali."]},{"type":"verse","number":26,"content":["Mɛlali nɛgↄ̃ɛↄ Mali ń Musio."]},{"type":"verse","number":27,"content":["Mɛlali bui Yaazia nɛgↄ̃ɛↄ tↄ́n kɛ: Bɛnↄ, Soaũ, Zakuu ń Ibelio."]},{"type":"verse","number":28,"content":["Mali nɛ́ Ɛleazaa i nɛgↄ̃ɛ io."]},{"type":"verse","number":29,"content":["Mali nɛ́ Kisi bui Yelamɛli."]},{"type":"verse","number":30,"content":["Musi nɛgↄ̃ɛↄ tↄ́n kɛ: Mali, Edɛɛ ń Yelimↄo. Levii buiↄn we an dezi buiↄwa."]},{"type":"verse","number":31,"content":["Ampiↄ sↄ̃ aa gbɛlà lá an gbɛ̃́ Aalona buiↄ kɛ̀wa kí Davidi ń Zadokio ń Aimɛlɛkio ń sa'ona uabeleↄ ń Levii bui uabeleↄ wáaɛ. Vĩ̀i buiↄ ń dãuna buiↄ, yã́ doũ wa kɛ̀nɛ́."]}],"footnotes":[{"noteId":32,"caller":"+","text":"24.2 Lev 10.1-2","reference":{"chapter":24,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/1CH/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/1CH/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/1CH/23.json","previousChapterAudioLinks":{},"numberOfVerses":31}