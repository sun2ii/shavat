{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"1CH","translationId":"bqc_sim","name":"1 Lada","commonName":"1 Lada","title":"LADA SƐ̃IA","order":13,"numberOfChapters":29,"sha256":"816872e045c685b3302ca7998cd074446265795b22cab7090857ca6ddd4b72bb","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/bqc_sim/1CH/29.json","totalNumberOfVerses":920},"chapter":{"number":25,"content":[{"type":"heading","content":["Lɛ̀sinaↄ"]},{"type":"verse","number":1,"content":["Davidi ń Isaili kíaↄ mɛ́ Asafa nɛgↄ̃ɛↄ ń Emani nɛgↄ̃ɛↄ ń Yedutu nɛgↄ̃ɛↄ dìlɛ ń zɛ́i aa ãnabikɛkɛ ń mↄↄnaↄ ń domaↄ ń sɛ̃́sɛ̃naↄ. Zĩpikɛnaↄ tↄ́n kɛ:"]},{"type":"verse","number":2,"content":["Asafa nɛgↄ̃ɛↄ tↄ́n kɛ: Zakuu, Yosɛfu, Nɛtania ń Asalɛlao. Asafa mɛ́ aↄ wɛ́tɛ a nɛ́piↄzi, kía sↄ̃ iↄ wɛ́tɛ ń ãnabikɛkɛai."]},{"type":"verse","number":3,"content":["Yedutu nɛgↄ̃ɛↄ sooloɛ: Gedalia, Zeli, Yesaia, Simɛi, Asabia ń Matitiao. An mae Yedutu mɛ́ ìↄ wɛ́tɛńzi, ↄ̃ ìↄ ãnabikɛkɛ ń mↄↄnlɛao, ìↄ Dii sáau kpa àↄ aà táasilɛò."]},{"type":"verse","number":4,"content":["Emani nɛgↄ̃ɛↄ tↄ́n kɛ: Bukia, Matania, Uziɛli, Sebuɛli, Yelemↄ, Anania, Anani, Ɛliata, Gidaleti, Lomantiɛzɛɛ, Maloti, Yↄsebekasa, Otii ń Maazioo."]},{"type":"verse","number":5,"content":["Gbɛ̃́piↄá kí gu'ena Emani nɛgↄ̃ɛↄnɛ ḿpii. Lua lɛgbɛ̃̀ɛ̀ à mɛ̀ á aà gba gbãa, ↄ̃ à aà gbà nɛgↄ̃ɛↄ gɛ̃o mɛ̀ndosai ń nɛnↄɛↄ lↄ àaↄ̃."]},{"type":"verse","number":6,"content":["Gbɛ̃́piↄ ìↄ lɛsi Dii ua ń sɛ̃́sɛ̃naↄ ń domaↄ ń mↄↄnaↄ ḿpiiɛ. An maeↄ Asafa ń Yedutuo ń Emanio mɛ́ aaìↄ wɛ́tɛńzi Lua ua zĩpi guu. Kí sↄ̃ ìↄ wɛ́tɛ ń maepiↄzi."]},{"type":"verse","number":7,"content":["Ampiↄ ń ń gbɛ̃́ pↄ́ aa lɛsia Diiɛ dàda aa dↄ̃ↄ, ampii gbɛ̃ↄn ↄ̀aa do ń basiiↄ̃kwi plasaioɛ (288)."]},{"type":"verse","number":8,"content":["Wà likpà lá aali kↄ̃ gba zɛ́ zĩpi yã́ musuɛ, nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ, yãdanɛdeↄ ń yãdadanaↄ píi."]},{"type":"verse","number":9,"content":["Wà gbɛ̃́piↄ sɛ̀ baade ń a nɛgↄ̃ɛↄ ń a dãunaↄ gbɛ̃ↄn kuɛplaplaɛ:",{"text":"A sɛ̃́ia Asafa nɛ́ Yosɛfu,","poem":1},{"lineBreak":true},{"text":"a plaade Gedalia,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"a àaↄ̃de Zakuu,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"a síiↄ̃de Zeli,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"a sↄode Nɛtania,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"a soolode Bukia,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"a soplade Yesalela,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"a swaaↄ̃de Yesaia,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"a kɛ̃okwide Matania,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"a kwide Simɛi,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"a kuɛdode Azalɛli,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"a kuɛplade Asabia,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"a kuɛ'aaↄ̃de Sebuɛli,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"a gɛ̃o mɛ̀ndosaide Matitia,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"a gɛ̃ode Yelimↄ,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"a gɛ̃o ń mɛ̀ndoode Anania,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"a gɛ̃o ń plaode Yↄsebekasa,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"a bao plasaide Anani,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"a bao mɛ̀ndosaide Maloti,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"a baode Ɛliata,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"a bao ń mɛ̀ndoode Otii,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"a bao ń plaode Gidaleti,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"a bao ń àaↄ̃ode Maazio,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"a baasↄo mɛ̀ndosaide Lomantiɛzɛɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/1CH/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/1CH/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/1CH/24.json","previousChapterAudioLinks":{},"numberOfVerses":31}