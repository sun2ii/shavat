{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"1JN","translationId":"bqc_sim","name":"1 Zãa","commonName":"1 Zãa","title":"ZÃA LÁ SƐ̃IA","order":62,"numberOfChapters":5,"sha256":"006cf8cc34643bb3a45d7b1af1c400ca92253fe42bc501739ba9a899ae18d8eb","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bqc_sim/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Yã́ wɛ̃nide"]},{"type":"verse","number":1,"content":["Gbɛ̃́ pↄ́ kú za asĩnizĩ",{"noteId":0},"wa aà yãmà, wa aà è ń wɛ́o, wa aà gwà, wa ↄkã̀wà, Yã́ wɛ̃nidepi bao wálɛ kpáɛ́."]},{"type":"verse","number":2,"content":["Wɛ̃nidepi bↄ̀ gupuau, wa aà è, aà seeladeↄn wá ũ. Wɛ̃nidepi ku yãa Mae Lua kĩ́iɛ, ↄ̃ à bↄ̀wá.",{"noteId":1},"Aà bao wálɛ kpáɛ́."]},{"type":"verse","number":3,"content":["Yã́ pↄ́ wá mà wá è ↄ̃ wálɛ oɛ́, kɛ́ ápiↄ á lɛ́ e àↄ doũwanↄ, asa wá lɛ́ doũ ń Mae Luaoɛ ń aà Nɛ́ Yesu Kilisipio.",{"noteId":2}]},{"type":"verse","number":4,"content":["Wálɛ yã́ɛ beeↄ oɛ́ kɛ́ wá pↄna e pɛɛwáɛ."]},{"type":"heading","content":["Luaá gupuaɛ"]},{"type":"verse","number":5,"content":["Bao pↄ́ wá màwà wálɛ kpáɛ́n kɛ: Luaá gupuaɛ, gusia ku aà kĩ́io, baa yↄↄ."]},{"type":"verse","number":6,"content":["Tó wa mɛ̀ wá lɛ́ doũaànↄɛ mɛ́ wá kú gusiau, ɛɛ wálɛ tó, wálɛ zĩkɛ sĩanawao."]},{"type":"verse","number":7,"content":["Tó wá kú gupuau lá Lua ku gupuauwa sↄ̃, ↄ̃ wá lɛ́ aↄ doũ, aà Nɛ́ Yesu au ì wá duuna píi wolowá."]},{"type":"verse","number":8,"content":["Tó wa mɛ̀ wá duuna vĩo, wálɛ wázĩa sãsãɛ, wá sĩana vĩo."]},{"type":"verse","number":9,"content":["Tó wa wá duunaↄ ò Luaɛ, Lua dee náai vĩ, ì yãkɛ a zɛ́wa, a wá duunapiↄ kɛ̃́wá, a yãvãi wolowá píi.",{"noteId":3}]},{"type":"verse","number":10,"content":["Tó wa mɛ̀ wi duunakɛo, wa Lua dìlɛ ɛɛde ũɛ, wá aà yã́ kũao."]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 Zãa 1.1","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.2 Zãa 1.14","reference":{"chapter":1,"verse":2}},{"noteId":2,"caller":"+","text":"1.3 Zãa 17.3","reference":{"chapter":1,"verse":3}},{"noteId":3,"caller":"+","text":"1.9 Soũ 32.5","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}