{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"1TI","translationId":"bqc_sim","name":"1 Timↄtee","commonName":"1 Timↄtee","title":"TIMƆTEE LÁ SƐ̃IA","order":54,"numberOfChapters":6,"sha256":"0486407817aed4195c19fb8318cf6e73095ea10a34b59f33f7c18fc497aaddf6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/bqc_sim/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":2,"content":[{"type":"heading","content":["Lousisia"]},{"type":"verse","number":1,"content":["Too, gĩa sɛ̃́ia málɛ lɛdama à wabikɛ gbɛ̃́piiɛ, à zɛ́ gbɛanɛ́, à kulɛkɛnɛ́ Luaɛ ń sáaukpaao."]},{"type":"verse","number":2,"content":["À wabikɛ kíaↄnɛ ń gbãadeↄ píi, kɛ́ wà e wàↄ ku aafia yãkelesai luayãmanaↄ ũ, wá kua iↄ gbia."]},{"type":"verse","number":3,"content":["Bee mɛ́ maa, ì ka Lua wá Suabanagu."]},{"type":"verse","number":4,"content":["A ye gbɛ̃́pii suaba, aai sĩana dↄ̃."]},{"type":"verse","number":5,"content":["Asa Lua mɛ̀ndoɛ, mɛ́ kↄ́ↄ kú mɛ̀ndo Lua ń gbɛ̃nazĩnaↄ zãnguo, ↄ̃n gbɛ̃nazĩna Kilisi Yesu ũ.",{"noteId":3}]},{"type":"verse","number":6,"content":["À azĩa kpà gbɛ̃́pii fĩabobↄ ũ a gↄↄwa, Lua pↄeãpi seela ũ."]},{"type":"verse","number":7,"content":["Ayãmɛto Lua ma dilɛ a kpàwakɛna ũ, a zĩna ũ, mà a zɛ́ sĩande da buipãleↄnɛ.",{"noteId":4},"Sĩana málɛ o, i kɛ ɛɛ no."]},{"type":"verse","number":8,"content":["Má ye gↄ̃ɛↄ lousisi gu ń guo píi, aa ↄsɛ musu",{"noteId":5},"gbãsĩsai, pↄkũma ń lɛkpaao sai."]},{"type":"verse","number":9,"content":["Má ye lↄ nↄɛↄ ńzĩa kɛkɛ a zɛ́wa yↄ̃̀ↄsai zĩamↄnɛ sai. I kɛ ń mì yↄ̃̀ↄde tãao ge vua ń òso nↄamblebↄↄ ge zwã̀a ↄdeↄ no.",{"noteId":6}]},{"type":"verse","number":10,"content":["Aa ńzĩa kɛkɛ ń maakɛao, lá a maa nↄɛ lousisinaↄ kɛwa."]},{"type":"verse","number":11,"content":["Nↄɛↄ yãdada kílikili, aa misiilɛ yã́pii musu."]},{"type":"verse","number":12,"content":["Mili we nↄɛↄ yãdàda gↄ̃ɛↄnɛ ge aaↄ iko vĩmáo, sema aaↄ ku kílikili."]},{"type":"verse","number":13,"content":["Asa Adamu ↄ̃ Lua kɛ̀ sɛ̃́ia, a gbɛa Ɛva.",{"noteId":7}]},{"type":"verse","number":14,"content":["I kɛ Adamu wa sã̀são, nↄɛ wa sã̀sã, à sì duunau.",{"noteId":8}]},{"type":"verse","number":15,"content":["Tó nↄɛ wɛtã̀ ń luanaaikɛao ń yea gbɛ̃́ↄzio ń kuaadoakɛo zĩamↄnɛ sai, ali nɛ'i aafia."]}],"footnotes":[{"noteId":3,"caller":"+","text":"2.5 Zĩn 4.12","reference":{"chapter":2,"verse":5}},{"noteId":4,"caller":"+","text":"2.7 2Tim 1.11","reference":{"chapter":2,"verse":7}},{"noteId":5,"caller":"+","text":"2.8 Bↄa 9.29","reference":{"chapter":2,"verse":8}},{"noteId":6,"caller":"+","text":"2.9 1Piɛ 3.3","reference":{"chapter":2,"verse":9}},{"noteId":7,"caller":"+","text":"2.13 Daa 2.7, 21-22","reference":{"chapter":2,"verse":13}},{"noteId":8,"caller":"+","text":"2.14 Daa 3.1-6","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/bqc_sim/1TI/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/1TI/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/1TI/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}