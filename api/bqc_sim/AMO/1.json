ń ɛ̃́ngoↄɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ an kí Azaeli bɛwa,","poem":1},{"lineBreak":true},{"text":"i kũ aà nɛ́ Bɛnadada kpɛ́ gbãaↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má Damasi bĩ́ibↄlɛ gba gbooɛ,","poem":1},{"lineBreak":true},{"text":"mí Avɛni guzulɛpi kía tↄ̀lↄzↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zↄ̃lɛ báawa Edɛnibɛpi,","poem":1},{"lineBreak":true},{"text":"wi tá ń Sili bùsudeↄ Kii zĩ̀zↄↄ ũ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"Gazadeↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Asa aa ma gbɛ̃́ↄ kũ̀kũ zĩ̀zↄↄ ũ píiɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa ń ná Ɛdↄũↄnɛ ń ↄzĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ Gaza bĩ́iwa,","poem":1},{"lineBreak":true},{"text":"i kũ a kpɛ́ gbãaↄwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má Asedoda kía tↄ̀lↄzↄ̃","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ zↄ̃lɛ báawa Asekelonio.","poem":1},{"lineBreak":true},{"text":"Má ↄsɛ mà Ɛkɛlonideↄ lɛ́,","poem":1},{"lineBreak":true},{"text":"e Filitɛ̃ kↄ̃na pↄ́ gↄ̃̀ weↄ gɛ midɛò.","poem":1},{"lineBreak":true},{"text":"Ma Dii Lua mámɛ má ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"Tiideↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Asa aa ma gbɛ̃́ↄ kũ̀kũ zĩ̀zↄↄ ũ píiɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa ń ná Ɛdↄũↄnɛ ń ↄzĩ.","poem":1},{"lineBreak":true},{"text":"Lɛdoũ pↄ́ aa kɛ̀ńnↄ i dↄńguo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ Tii bĩ́iwa,","poem":1},{"lineBreak":true},{"text":"i kũ a kpɛ́ gbãaↄwa.","poem":1}]},{"type":"verse","number":11,"content":["Ma Dii ma mɛ̀,",{"text":"Ɛdↄũↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Aa pɛ̀lɛ ń daɛↄzi ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"aai gbɛ̃e wɛ̃nagwao.","poem":1},{"lineBreak":true},{"text":"Aa pↄkũmabↄ̀bↄmá zɛzɛsai,","poem":1},{"lineBreak":true},{"text":"an pↄ fɛ̃ańzi i kpálɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ ń bùsu Temaniwa,","poem":1},{"lineBreak":true},{"text":"i kũ a mɛɛwia Bↄzɛla kpɛ́ gbãaↄwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"Amↄniↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Aa Galada bùsu nↄsindeeↄ pùi,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa ye ń bùsu kã́fĩ yã́i.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má tɛsↄ̃ ń mɛɛwia Labawa,","poem":1},{"lineBreak":true},{"text":"i kũ a kpɛ́ gbãaↄwa.","poem":1},{"lineBreak":true},{"text":"Zĩkawii iↄ dↄ,","poem":1},{"lineBreak":true},{"text":"zàa'ĩan gbãa i fɛlɛńgu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"wi tá ń ń kíao zĩ̀zↄ ũ,","poem":1},{"lineBreak":true},{"text":"aàpi ń a ìwaↄ sãnu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 2Kia 15.1-7","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"