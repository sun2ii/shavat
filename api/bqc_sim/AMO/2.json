{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"AMO","translationId":"bqc_sim","name":"Amↄsi","commonName":"Amↄsi","title":"AMƆSI","order":30,"numberOfChapters":9,"sha256":"7b0872011850f8cb5fb266900006f26b38d79b6d6693d86ef6adeb1c57582273","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bqc_sim/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Aa Ɛdↄũↄ kía gɛ kpàsa","poem":1},{"lineBreak":true},{"text":"e aà wáↄ gↄ̃̀ túfu ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ Mↄabuↄwa,","poem":1},{"lineBreak":true},{"text":"i kũ Kelio kpɛ́ gbãaↄwa.","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ gaga zĩ̀ zↄa guuɛ","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ wàlɛ kúkuakɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ mↄ pɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má ń dↄaana tↄ̀lↄzↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"mí aà ìwaↄ dɛdɛaànↄ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Yudaↄ ń Isailiↄ le"]},{"type":"verse","number":4,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"Yudaↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Asa aa gì ma ikoyãiɛ,","poem":1},{"lineBreak":true},{"text":"aaliↄ yã́ pↄ́ má dìlɛↄ kũao.","poem":1},{"lineBreak":true},{"text":"An tã́aↄ mɛ́ ń sãsã,","poem":1},{"lineBreak":true},{"text":"ɛɛde pↄ́ an deziↄ tɛiↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má tó tɛ́ fɛlɛ Yuda bùsuwa,","poem":1},{"lineBreak":true},{"text":"i kũ Yelusalɛũ kpɛ́ gbãaↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"Isailiↄ tàaekɛ̀ gɛ̃n àaↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ beea se,","poem":1},{"lineBreak":true},{"text":"ma pↄ a weemáo.","poem":1},{"lineBreak":true},{"text":"Aaì gbɛ̃maaↄ yía zↄↄ ũ ↄ̃a yã́i,","poem":1},{"lineBreak":true},{"text":"aaì taasideↄ yía kyale fĩaboanɛ yã́i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì ↄ̃zↄ̃ wɛ̃nadeↄwa bùsu'ũfãau,","poem":1},{"lineBreak":true},{"text":"aaì gbãasaideↄ yã́ málɛnɛ́.","poem":1},{"lineBreak":true},{"text":"Nɛ́ ń a maeo aaì gbada wɛ̃́ndia doũwa,","poem":1},{"lineBreak":true},{"text":"aaì ma tↄ́ pↄ́ a kua adoa ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aaì ń wó poo sa'okĩiↄ saɛ píi","poem":1},{"lineBreak":true},{"text":"zwãa pↄ́ aa a tↄ̀ↄmasìmáↄwa.","poem":1},{"lineBreak":true},{"text":"Aaì vɛ̃ɛ lú ń ↄ̃a pↄ́ aa sìmáo","poem":1},{"lineBreak":true},{"text":"aa mi ń tã́akpɛu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mámɛ ma Amↄleↄ kàalɛɛ́ yãa,","poem":1},{"noteId":3},{"lineBreak":true},{"text":"baa kɛ́ aa gbã̀a lán sɛdɛ líↄwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa gbãa lán sɛ̃́ gↄ̃n giiwa.","poem":1},{"lineBreak":true},{"text":"Ma ń kaalɛ píi, nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mámɛ ma bↄánↄ Egipi,","poem":1},{"lineBreak":true},{"text":"ma dↄaaɛ́ guwaiwaiu wɛ̃̀ bla,","poem":1},{"lineBreak":true},{"text":"má tò Amↄleↄ bùsu gↄ̃̀ á pↄ́ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma á nɛ́eↄ dìlɛ ãnabiↄ ũ,","poem":1},{"lineBreak":true},{"text":"má tò á ɛ̀waasoeↄ ńzĩa kpàa.","poem":1},{"noteId":4},{"lineBreak":true},{"text":"Isailiↄ, sĩana málɛ oɛ́o lò?","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A naɛ gbɛ̃́ pↄ́ aa ńzĩa kpàapiↄwa aa vɛ̃ɛmi,","poem":1},{"lineBreak":true},{"text":"á dìlɛ ãnabipiↄnɛ aasu ãnabikɛkɛ lↄo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À ma! Má á kɛ dɛ̃́ↄdɛ̃ↄɛ,","poem":1},{"lineBreak":true},{"text":"lán zugo pↄ́ pↄ́wɛn aso sɛa ì pↄ́ kɛ dɛ̃́ↄdɛ̃ↄwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ kàsakasaↄ bↄkĩi eo,","poem":1},{"lineBreak":true},{"text":"gↄ̃saↄ e bↄ ń gbãa yã́io,","poem":1},{"lineBreak":true},{"text":"nɛgↄ̃naↄ e ńzĩa misio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kàzunaↄ fↄ̃ zɛ gio,","poem":1},{"lineBreak":true},{"text":"bàwãadeↄ e bↄo,","poem":1},{"lineBreak":true},{"text":"sↄ̃deↄ e ńzĩa misio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baa nɛgↄ̃n wↄ́ↄdeↄ","poem":1},{"lineBreak":true},{"text":"aa bàasi ↄgii gↄↄ beeɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"2.9 Iko 3.8-10","reference":{"chapter":2,"verse":9}},{"noteId":4,"caller":"+","text":"2.11 Nao 6.1-8","reference":{"chapter":2,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}