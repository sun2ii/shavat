{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"AMO","translationId":"bqc_sim","name":"Amↄsi","commonName":"Amↄsi","title":"AMƆSI","order":30,"numberOfChapters":9,"sha256":"7b0872011850f8cb5fb266900006f26b38d79b6d6693d86ef6adeb1c57582273","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bqc_sim/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Á Isaili bui pↄ́ ma á bↄ́lɛ Egipi,","poem":1},{"lineBreak":true},{"text":"à swã́kpa à yã́ pↄ́ ma mɛ̀ a á le ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dṹnia buiↄ guu píi ámɛ ma á sɛ́.","poem":1},{"lineBreak":true},{"text":"A yã́i má vãi pↄ́ á kɛ̀ wíɛ́ á musu.","poem":1}]},{"type":"heading","content":["Amↄsi ãnabikɛkɛa bↄ̀ Dii kĩ́iɛ"]},{"type":"verse","number":3,"content":[{"text":"Gbɛ̃ↄn plaↄ ìↄ tɛkↄ̃i kↄ̃yãmasaia?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusu ì pũna dào guu pↄblea esaie?","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄkusi ì pala a tòou nↄ̀ↄkũsaie?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó bãe i zu fíiuo,","poem":1},{"lineBreak":true},{"text":"a e à aà kũe?","poem":1},{"lineBreak":true},{"text":"Tó ba i e pↄ́ kũ̀o,","poem":1},{"lineBreak":true},{"text":"a bilɛe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó wà zĩ̀gãalɛ̀ wɛ̃́lɛu,","poem":1},{"lineBreak":true},{"text":"sↄ̃ lí kɛ̃́ gbɛ̃́ↄguo lé?","poem":1},{"lineBreak":true},{"text":"Tó músi gɛ̃̀ wɛ̃́lɛu,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ tòo lò?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii Lua lí yã́ pↄ́ a zɛòe kɛ","poem":1},{"lineBreak":true},{"text":"oa a zↄ̀blena ãnabiↄnɛ saio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusu pũ̀na,","poem":1},{"lineBreak":true},{"text":"dé vĩa a gí kṹii?","poem":1},{"lineBreak":true},{"text":"Dé Dii Lua a yã'oɛ̀,","poem":1},{"lineBreak":true},{"text":"à gí a kpàwakɛii?","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Isailiↄ le"]},{"type":"verse","number":9,"content":[{"text":"À kpàwakɛ Asedoda kibɛdeↄnɛ","poem":1},{"lineBreak":true},{"text":"ń Egipi kibɛdeↄ à onɛ́,","poem":1},{"lineBreak":true},{"text":"aa kãaa Samali gbɛ̀sĩsĩↄ pↄlɛu,","poem":1},{"lineBreak":true},{"text":"aai gili zↄ̃ↄ pↄ́ gɛ̃̀u e","poem":1},{"lineBreak":true},{"text":"ń gbãa pↄ́ wàlɛ mↄ́ a gbɛ̃́ↄnɛo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"gbãadeↄ yãkɛa a dↄ̀ↄwa dↄ̃o.","poem":1},{"lineBreak":true},{"text":"Aaì gbɛ̃́ↄ wɛtã aa ń taiinkɛ,","poem":1},{"lineBreak":true},{"text":"aaì ń àizɛɛↄ naaa aa taò ń bɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bee yã́i ma Dii Lua ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"ibɛɛↄ mↄ lia á bùsuzi,","poem":1},{"lineBreak":true},{"text":"aa á gbãa midɛ,","poem":1},{"lineBreak":true},{"text":"aai á kibɛ pↄ́ↄ sɛ́lɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"lá sãdãna ì a sã gbá miↄna","poem":1},{"lineBreak":true},{"text":"ge a swã́ miↄna bↄ nↄ̀ↄmusu lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"màa Isaili pↄ́ kú Samaliↄ bↄ kaso,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zↄ̃lɛ ń lii bɛ́lɛbɛlɛwapiↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Dii Lua Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"à swã́kpa à ma,","poem":1},{"lineBreak":true},{"text":"í Yakↄbu buiↄ gbaò laai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó málɛ Isailiↄ tàae wínɛ́ ń musu,","poem":1},{"lineBreak":true},{"text":"má sa'okĩi pↄ́ kú Bɛtɛliↄ kↄ́ba zↄ̃zↄ̃ mà kwɛ tↄↄlɛ,","poem":1},{"lineBreak":true},{"text":"mí sa'okĩipiↄ dúuzↄ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má á guantɛ̃mblekpɛↄ","poem":1},{"lineBreak":true},{"text":"ń á ĩ́ampuublekpɛↄ wíwiɛ,","poem":1},{"lineBreak":true},{"text":"má kpɛ́ pↄ́ a zãblèmá","poem":1},{"lineBreak":true},{"text":"ń wesa swaaopiↄ daaĩɛ,","poem":1},{"lineBreak":true},{"text":"mí a kpɛ́ zↄ̃ↄↄ gboo píi.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}