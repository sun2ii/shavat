{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"AMO","translationId":"bqc_sim","name":"Amↄsi","commonName":"Amↄsi","title":"AMƆSI","order":30,"numberOfChapters":9,"sha256":"7b0872011850f8cb5fb266900006f26b38d79b6d6693d86ef6adeb1c57582273","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bqc_sim/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Wɛ̃nakɛa Isailiↄnɛ"]},{"type":"verse","number":1,"content":[{"text":"Isailiↄ, à yã́ɛ bee ma,","poem":1},{"lineBreak":true},{"text":"málɛ wɛ̃nalɛ daánↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wi Isailiↄ nɛ sↄlↄlↄ yãao,","poem":1},{"lineBreak":true},{"text":"ãma à lɛ̀lɛ sa mɛ́ a fɛlɛ lↄo.","poem":1},{"lineBreak":true},{"text":"Wà aà tò wúlɛa a bùsuu we,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à ↄkaaàzio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma Dii Lua ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ a zĩgↄ̃ↄ bↄ̀lɛ gbɛ̃ↄn ↄ̀aa sↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ↄn basↄo mɛ́ a su.","poem":1},{"lineBreak":true},{"text":"Wɛ̃́lɛ pↄ́ a zĩgↄ̃ↄ bↄ̀lɛ gbɛ̃ↄn basↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ↄn kwi mɛ́ a su.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma Dii málɛ yã́ɛ bee o Isailiↄnɛ:","poem":1},{"lineBreak":true},{"text":"À ma kĩ́i wɛɛlɛ, íↄ ku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ásu gɛ́ lousisii Bɛtɛlio,","poem":1},{"lineBreak":true},{"text":"ásu gɛ́ Giligali sↄ̃o,","poem":1},{"lineBreak":true},{"text":"ásu tↄ̃u Bɛɛsɛbao,","poem":1},{"lineBreak":true},{"text":"asa wa tá ń Giligalideↄ zĩ̀zↄↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ Bɛtɛli a gↄ̃ bɛzia ũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À Dii kĩ́i wɛɛlɛ, íↄ ku.","poem":1},{"lineBreak":true},{"text":"Tó màa no,","poem":1},{"lineBreak":true},{"text":"a mↄ kũ Yosɛfu buiↄwa tɛ́ ũ,","poem":1},{"lineBreak":true},{"text":"a kũ Bɛtɛliwa, gbɛ̃e a fↄ̃ dɛo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I yã́'ĩikpa yãnadeↄwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ i yãkɛa a zɛ́wa málɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii saankifɛ̃nɛnaↄ kɛ̀","poem":1},{"lineBreak":true},{"text":"ń saankonɛandeo.","poem":1},{"noteId":6},{"lineBreak":true},{"text":"Ì to gusia níinii li gudↄa ũ,","poem":1},{"lineBreak":true},{"text":"ì to gu ìↄ si.","poem":1},{"lineBreak":true},{"text":"Ì ísia í kãaa musu,","poem":1},{"lineBreak":true},{"text":"ì to à ma lou ũ bùsu píi guu.","poem":1},{"lineBreak":true},{"text":"Aà tↄ́n Dii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì to kaalɛ bilɛ gbãadeↄwa,","poem":1},{"lineBreak":true},{"text":"ì wɛ̃́lɛ bĩ́ideↄ ásookɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ápiↄ sↄ̃ iliↄ ye sĩan'ona gĩyãio,","poem":1},{"lineBreak":true},{"text":"i za gbɛ̃́ pↄ́ ì bↄbↄ ń vãikɛnaↄgu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá i gbãable wɛ̃nadeↄwa,","poem":1},{"lineBreak":true},{"text":"i pↄ́wɛna símá,","poem":1},{"lineBreak":true},{"text":"á kpɛ́ pↄ́ á bò ń gbɛ̀ ãao,","poem":1},{"lineBreak":true},{"text":"á e zↄ̃lɛ ń guuo,","poem":1},{"lineBreak":true},{"text":"á pↄeã vɛ̃ɛ pↄ́ á bà,","poem":1},{"lineBreak":true},{"text":"á e à a imio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Asa Dii á tàae zↄ̃ↄ dↄ̃","poem":1},{"lineBreak":true},{"text":"ń á duuna pↄ́ lɛ́ vĩoo.","poem":1},{"lineBreak":true},{"text":"I gbɛ̃maaↄ wɛtã,","poem":1},{"lineBreak":true},{"text":"i to gbɛ̃dɛna fĩabo, í aà gbaɛ,","poem":1},{"lineBreak":true},{"text":"i gí taasideↄnɛ ń ń yã́ nao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yã́i tò laaide dãↄ lɛ́ ìↄ kpaaũa tia kɛ́wa,","poem":1},{"lineBreak":true},{"text":"asa gↄↄɛ beeↄ vãiɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À wɛɛlɛ àↄ yãmaakɛ,","poem":1},{"lineBreak":true},{"text":"i kɛ a vãi no,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e àↄ ku,","poem":1},{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de iↄ kúánↄ,","poem":1},{"lineBreak":true},{"text":"lá i o a kúánↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àↄ za yã́ vãiu, íↄ ye a maai,","poem":1},{"lineBreak":true},{"text":"íli yã́gↄ̃gↄ̃ a zɛ́wa yã́kpalɛkɛkĩi.","poem":1},{"lineBreak":true},{"text":"Wìliↄ dↄ̃o, Dii Lua Zĩgↄ̃de a gí Yosɛfu bui kↄ̃naↄ wɛ̃nagwaio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yã́i Dii Lua Zĩgↄ̃de mɛ̀,","poem":1},{"lineBreak":true},{"text":"wa búbuapɛ gãaɛↄ píi,","poem":1},{"lineBreak":true},{"text":"waↄ o zɛ́kpaaↄ guu: Wéee! Wéee!","poem":1},{"lineBreak":true},{"text":"Wa sɛ̃̀wanaↄ sísi aa ↄ́ↄlↄ,","poem":1},{"lineBreak":true},{"text":"wa o gɛ'ↄↄlↄnaↄnɛ aa búbuapɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Búbuapɛa aↄ ku vɛ̃ɛbuↄu píi,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ a pã́ á bùsua.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ò.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Waiyoo gbɛ̃́ pↄ́ lɛ́ Dii gↄↄ nidɛ!","poem":1},{"lineBreak":true},{"text":"Àkɛa álɛ Dii gↄↄpi nidɛi?","poem":1},{"lineBreak":true},{"text":"Gusia gↄↄɛ, i kɛ gupua no.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aↄ dɛ lá gbɛ̃́ lɛ́ bàalɛ nↄ̀ↄmusuɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gɛ̀ kpà wài pãleawa,","poem":1},{"lineBreak":true},{"text":"ge lá à gɛ̀ gɛ̃̀ kpɛ́u à ↄnà gĩwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ mlɛ̃ aà sòwaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii gↄↄpiá gusiaɛ,","poem":1},{"lineBreak":true},{"text":"i kɛ gupua no, gusia níiniiɛ.","poem":1},{"lineBreak":true},{"text":"Baa gupuan beeena aↄ vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má za á dikpɛↄu, má gíiɛ,","poem":1},{"lineBreak":true},{"text":"má ye á kↄ̃kãaapiↄ gĩyãio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Baa tó a sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ òa ń pↄ́wɛntio, má sio.","poem":1},{"lineBreak":true},{"text":"Baa tó a sáaukpa sa'òa ń pↄ́ mɛkpaao,","poem":1},{"lineBreak":true},{"text":"má wɛ́sɛ mà gwao.","poem":1},{"noteId":7}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À gomala ń á lɛ̀sikↄ̃fĩo,","poem":1},{"lineBreak":true},{"text":"má swã́sɛ á mↄↄna ↄ́io.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À to yã́zɛde dagua","poem":1},{"lineBreak":true},{"text":"lán swa gbakakaawa,","poem":1},{"lineBreak":true},{"text":"à tó á yãkɛa a zɛ́wa ligua","poem":1},{"lineBreak":true},{"text":"lán swa pↄ́ a í lí baowa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Isailiↄ, i kɛ mámɛ a sa'òa","poem":1},{"lineBreak":true},{"text":"a ma gba pↄ́ guwaiwaiu wɛ̃̀ blao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tã́a Mↄlↄku kpɛ́ á sɛa","poem":1},{"lineBreak":true},{"text":"ń saana pↄ́ a zɛò taao.","poem":1},{"lineBreak":true},{"text":"Á dii pↄ́ á pì ázĩaɛpiↄ","poem":1},{"noteId":8},{"text":"yã́i","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ↄ̃ má tó wà táánↄ Damasi baale.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Ma tↄ́n Lua Zĩgↄ̃de.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.8 Yob 9.9, 38.32","reference":{"chapter":5,"verse":8}},{"noteId":7,"caller":"+","text":"5.22 Isa 1.11-14","reference":{"chapter":5,"verse":22}},{"noteId":8,"caller":"+","text":"5.26 Zĩn 7.42-43","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/bqc_sim/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}