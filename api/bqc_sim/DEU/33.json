{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"DEU","translationId":"bqc_sim","name":"Ikoyã","commonName":"Ikoyã","title":"IKOYÃ Mↄizi lá sↄode","order":5,"numberOfChapters":34,"sha256":"e988c6fd74b020b92f2a3240985a8047ff814399fc1610623416bf9d662c2165","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/bqc_sim/DEU/34.json","totalNumberOfVerses":954},"chapter":{"number":33,"content":[{"type":"heading","content":["Mↄizi Isaili buiↄ gbaa sa'olɛ"]},{"type":"verse","number":1,"content":["Sa maa pↄ́ Lua gbɛ̃́ Mↄizi ò Isailiↄnɛ e àↄ gɛ́ gain kɛ,"]},{"type":"verse","number":2,"content":["à mɛ̀:",{"text":"Dii bↄ̀ Sinai à mↄ̀wá,","poem":1},{"lineBreak":true},{"text":"aà gawi bìlɛwá za Sei,","poem":1},{"lineBreak":true},{"text":"à pìpiwɛ̃ɛ za Palana gbɛ musu,","poem":1},{"lineBreak":true},{"text":"à bↄ̀ a gbɛ̃́ dasidasiↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"lou lɛ́ pílɛpilɛ aà ↄplaai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii ye a gbɛ̃́ↄzi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an kua ńdoapiↄ ku aà ↄzĩ.","poem":1},{"lineBreak":true},{"text":"Aaì kãaaaàzi wà aà yãma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mↄizi ikoyã dìlɛwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"wá Yakↄbu buiↄ pↄ́ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii mɛ́ gↄ̃̀ wá bui maa kía ũ,","poem":1},{"lineBreak":true},{"text":"kɛ́ wá Isaili bui dↄaanaↄ kↄ̃ kã̀aa.","poem":1}]},{"type":"verse","number":6,"content":["Mↄizi mɛ̀:",{"text":"Lubɛni buiↄ aaↄ kuɛ, aa gao,","poem":1},{"lineBreak":true},{"text":"kási aaↄ dasio.","poem":1}]},{"type":"verse","number":7,"content":["À yã́ɛ bee ò Yuda buiↄ yã́ musu:",{"text":"Dii, Yuda buiↄ wii ma,","poem":1},{"lineBreak":true},{"text":"ní suńnↄ ń gbɛ̃́ↄ guu.","poem":1},{"lineBreak":true},{"text":"Aalɛ gí ń ńzĩao,","poem":1},{"lineBreak":true},{"text":"dↄńlɛ an ibɛɛↄ yã́ musu.","poem":1}]},{"type":"verse","number":8,"content":["Levii buiↄ yã́ musu à mɛ̀:",{"text":"N Tumiũ ń Uliũo kpà n gbɛ̃́ náaideↄwa.","poem":1},{"noteId":137},{"lineBreak":true},{"text":"N ń lɛ́ n ń gwá Masa,","poem":1},{"lineBreak":true},{"text":"n zↄakàńzi Mɛliba í kĩ́i.","poem":1},{"noteId":138}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aai ń de ń ń dao yãdao,","poem":1},{"lineBreak":true},{"text":"aai ń vĩ̀iↄ ń ń dãunaↄ dↄ̃o ge an nɛ́ↄ.","poem":1},{"lineBreak":true},{"text":"Aa n yã́ kũa,","poem":1},{"lineBreak":true},{"text":"aa zɛ̀ ń n bàakuańnↄ yã́o.","poem":1},{"noteId":139}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aaì n yã́ↄ da Yakↄbu buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"aaì n ikoyã da Isailiↄnɛ.","poem":1},{"lineBreak":true},{"text":"Aaì tulaletikatɛa n aɛ,","poem":1},{"lineBreak":true},{"text":"aaì sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ o ń gbagbakĩiwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii, báaadańgu, ní ń gba gbãa,","poem":1},{"lineBreak":true},{"text":"kɛ́ zĩ pↄ́ aalɛ kɛↄ e kangu.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ fɛlɛńnↄↄ lɛ́ ń wówa,","poem":1},{"lineBreak":true},{"text":"ǹ ń zangudeↄ gbɛ̃, aasu fɛlɛ lↄo.","poem":1}]},{"type":"verse","number":12,"content":["Bɛ̃yãmɛɛ buiↄ yã́ musu à mɛ̀:",{"text":"Dii gbɛ̃́ yenzideↄ zↄ̃lɛaaànↄ dↄdↄa.","poem":1},{"lineBreak":true},{"text":"Dii aↄ kàedańzi,","poem":1},{"lineBreak":true},{"text":"aↄ kú ń guu gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":13,"content":["Yosɛfu buiↄ yã́ musu à mɛ̀:",{"text":"Dii báaada ń bùsuu","poem":1},{"lineBreak":true},{"text":"ń fíi maa pↄ́ ì bↄ musu à kpao","poem":1},{"lineBreak":true},{"text":"ń í pↄ́ kálɛa tↄↄlɛ zíɛo","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ń pↄmaa pↄ́ ĩatɛ̃ ì to aa bↄlɛↄ","poem":1},{"lineBreak":true},{"text":"ń pↄmaa pↄ́ ì bↄlɛ mↄ ń mↄoↄ","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ń gbɛ̀sĩsĩ zi musupↄↄ","poem":1},{"lineBreak":true},{"text":"ń sĩ̀sĩ pↄ́ kú za káauↄ pↄmaaↄ","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ń pↄmaa pↄ́ kú tↄↄlɛↄ píi.","poem":1},{"lineBreak":true},{"text":"Yosɛfu buiↄ na ń Lua pↄ́ kú yãa kàelɛuo,","poem":1},{"lineBreak":true},{"text":"ɛ̀fãaipiↄ i su ń miwa,","poem":1},{"lineBreak":true},{"text":"asa Yosɛfu á bɛɛɛdeɛ a gbɛ̃́ↄ guu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aà buiↄ aaↄ zↄ̃ↄkɛ vĩ","poem":1},{"lineBreak":true},{"text":"lán zuswana nɛsana sɛ̃́iawa,","poem":1},{"lineBreak":true},{"text":"aaↄ gbãa vĩ lán zùsɛ̃lɛ kↄ́baↄwa,","poem":1},{"lineBreak":true},{"text":"aa málɛ buiↄzi e dṹnia lɛ́wa.","poem":1},{"lineBreak":true},{"text":"Màa Ɛflaiũ bui aↄ dasi,","poem":1},{"lineBreak":true},{"text":"màa Manase bui aↄ dasi.","poem":1}]},{"type":"verse","number":18,"content":["Zabulↄni buiↄ yã́ musu à mɛ̀:",{"text":"Zabulↄni buiↄ,","poem":1},{"lineBreak":true},{"text":"à pↄnakɛ laa pↄ́ álɛ taↄ guu.","poem":1},{"lineBreak":true},{"text":"Isakaa buiↄ, à pↄnakɛ bɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa gbɛ̃́ↄ sísi Dii gbɛ̀sĩsĩwa,","poem":1},{"lineBreak":true},{"text":"aai samaa'owà we,","poem":1},{"lineBreak":true},{"text":"asa aa àizɛɛ pↄ́ di ísiauↄ ble","poem":1},{"lineBreak":true},{"text":"ń pↄ́ pↄ́ ulɛa bùsu'ũfãa guuↄ.","poem":1}]},{"type":"verse","number":20,"content":["Gada buiↄ yã́ musu à mɛ̀:",{"text":"Wà Gada buiↄ bùsu Kãfĩna sáaukpa!","poem":1},{"lineBreak":true},{"text":"Aaↄ wúlɛa we lán nↄ̀ↄmusuwaɛ,","poem":1},{"lineBreak":true},{"text":"aa gbɛ̃́ↄ taitai ń gã̀sĩↄwa ń ń miↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa tↄↄlɛ sɛ̃́ia sɛ̀ ńzĩa pↄ́ ũ,","poem":1},{"noteId":140},{"lineBreak":true},{"text":"wa gbɛ̃zↄ̃ↄↄ baapi kũanɛ́ we.","poem":1},{"lineBreak":true},{"text":"Kɛ́ Isailiↄ dↄaanaↄ kã̀aa,","poem":1},{"lineBreak":true},{"text":"Gada buiↄ zĩkɛ̀ Dii ikoyã zɛdewa","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ a dìlɛ Isaili bui píiɛo.","poem":1}]},{"type":"verse","number":22,"content":["Dã buiↄ yã́ musu à mɛ̀:",{"text":"Dã buiↄá nↄ̀ↄmusu nɛ́ bↄlↄↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai bↄ Basana bùsuu aa kusimá.","poem":1}]},{"type":"verse","number":23,"content":["Nɛfatali buiↄ yã́ musu à mɛ̀:",{"text":"Nɛfatali buiↄ na ń Diio maamaa,","poem":1},{"lineBreak":true},{"text":"à báaadàńgu à kɛ̀ zài.","poem":1},{"lineBreak":true},{"text":"Ísida ń gɛↄmidↄkĩi oi bùsuo","poem":1},{"lineBreak":true},{"text":"a gↄ̃ ń pↄ́ ũɛ.","poem":1}]},{"type":"verse","number":24,"content":["Asɛɛ buiↄ yã́ musu à mɛ̀:",{"text":"Pↄnadeↄ Asɛɛ buiↄ dɛ bui kĩniↄla,","poem":1},{"lineBreak":true},{"text":"aaↄ naaànↄ dɛ ń gbɛ̃́ↄla,","poem":1},{"lineBreak":true},{"text":"aa ń gbá pípi ń nísio.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa ń bↄlɛ gbã́aↄ pi","poem":1},{"lineBreak":true},{"text":"ń mↄsio ń mↄgotɛ̃o,","poem":1},{"lineBreak":true},{"text":"aaↄ ku dↄdↄaɛ e ń wɛ̃ni lɛ́u.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bui maaↄ, gbɛ̃e muaa ń á Luaoo,","poem":1},{"lineBreak":true},{"text":"ì di luabɛpuana kpɛ musu,","poem":1},{"lineBreak":true},{"text":"ì mↄ dↄiálɛ a zↄ̃ↄkɛ guu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Lua pↄ́ kú za zipi mɛ́ á ulɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"ìↄ ↄliaázi zĩ́lɛ la gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Ì á ibɛɛↄ yáɛ́, ì oɛ́ à ń kaalɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Isailiↄ iↄ ku dↄdↄa ńtɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buipiↄ iↄ ku","poem":1},{"lineBreak":true},{"text":"bùsu pↄ́ pↄ́wɛna ń vɛ̃ɛo diu,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ a mↄ̀sɛ ìↄ bↄ musu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Báaadeↄn á Isailiↄ ũ,","poem":1},{"lineBreak":true},{"text":"asa Dii á suabà.","poem":1},{"lineBreak":true},{"text":"Démɛ kú lááwai?","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ á sɛ̀ngbao ń á dↄnlɛo","poem":1},{"lineBreak":true},{"text":"ń á fɛ̃nda gawideo ũ.","poem":1},{"lineBreak":true},{"text":"Á ibɛɛↄ vlãnauɛ́ á aɛɛ,","poem":1},{"lineBreak":true},{"text":"íↄ bɛ ń bùsu gulɛsĩↄwa.","poem":1}]}],"footnotes":[{"noteId":137,"caller":"+","text":"33.8 Bↄa 28.30","reference":{"chapter":33,"verse":8}},{"noteId":138,"caller":"+","text":"33.8 Bↄa 17.7, Nao 20.13","reference":{"chapter":33,"verse":8}},{"noteId":139,"caller":"+","text":"33.9 Bↄa 32.26-29","reference":{"chapter":33,"verse":9}},{"noteId":140,"caller":"+","text":"33.21 Nao 32.1-5, 31-32","reference":{"chapter":33,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}