{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ECC","translationId":"bqc_sim","name":"Làasoode","commonName":"Làasoode","title":"LÀASOODE","order":21,"numberOfChapters":12,"sha256":"0c4a32b14e6570fdff7c86b113d21b4db9a6a8336a908640455459f6793bdf63","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqc_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["Sↄũkɛ kai"]},{"type":"verse","number":1,"content":[{"text":"Ũsĩn gɛↄ ì to tulalekɛna nísi gĩ ĩ́ikũ,","poem":1},{"lineBreak":true},{"text":"sↄũkɛ yↄↄna ì gbɛ̃́ pↄ́ ↄ̃nↄ ń bɛɛɛo vĩ tↄ́ ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna làasoo ì ta ↄplaai,","poem":1},{"lineBreak":true},{"text":"sↄũ pↄ́ ì ta ↄzɛɛi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baa tó sↄũ bɛ zɛ́u,","poem":1},{"lineBreak":true},{"text":"aà ↄ̃nↄ ìↄ kɛ̃́sãwàɛ,","poem":1},{"lineBreak":true},{"text":"ì to gbɛ̃́pii a mìsaikɛ dↄ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó gbãade pↄ pànzi,","poem":1},{"lineBreak":true},{"text":"ńsu go n tíao.","poem":1},{"lineBreak":true},{"text":"Kua n laaiwa ì láka tàae zↄ̃ↄa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma yãvãie è dṹniau,","poem":1},{"lineBreak":true},{"text":"a dɛ gbãade zãa yã́wa ũɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wì sↄũↄ kpa kpala gbiau dasi,","poem":1},{"lineBreak":true},{"text":"mɛ́ ↄdeↄ ìↄ ku kpala yãfũnau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma zↄↄ è di sↄ̃́ kpɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ wɛ̃́ɛↄ bɛ kɛ̀sɛ lán zↄↄwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ ɛyↄ̃ a zu a guu,","poem":1},{"noteId":10},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ gĩ gboo, mlɛ̃ a aà só.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ gbɛwi, gbɛ a aà kɛ'ĩa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ lipaa, lí a aà kaikɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó mↄo lɛnao, mɛ́ wi a lɛkɛo,","poem":1},{"lineBreak":true},{"text":"sema ǹ gã̀sĩwa bↄbↄwà ń gbãao,","poem":1},{"lineBreak":true},{"text":"ãma ↄ̃nↄ ì to wà zɛ'eɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó mlɛ̃ bↄn'ãa kɛ̀ a kↄ̃̀ↄ'onaɛ à aà sò,","poem":1},{"lineBreak":true},{"text":"a ài vĩ a guu lↄo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna lɛgbɛ'i na,","poem":1},{"lineBreak":true},{"text":"ãma sↄũ lɛ́ ì aà kaalɛɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì na yã'owa sↄũsↄũ,","poem":1},{"lineBreak":true},{"text":"ì a midɛ ń mìsaiyãvãio,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"asa sↄũ ì da yãaɛ.","poem":1},{"lineBreak":true},{"text":"Lá gbɛ̃e yã́ pↄ́ a mↄ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ yã́ pↄ́ a kɛ aà kpɛ oɛ̀i?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sↄũ zĩ ì aà kpasa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ìliↄ wɛ̃́lɛ zɛ́ dↄ̃o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Waiyoo bùsu pↄ́ a kía dɛ ɛ̀waasona ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà ìwaↄ ìↄ blɛ gbɛ̃ kↄↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Násaa bùsu pↄ́ a kíaá kíabuiɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà ìwaↄ ì pↄble a gↄↄwa","poem":1},{"lineBreak":true},{"text":"gbãakãfĩa yã́i, i kɛ idɛkɛa yã́i no.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ màa vĩ,","poem":1},{"lineBreak":true},{"text":"aà kpɛ́ zaↄ ìↄ wozuzuaɛ,","poem":1},{"lineBreak":true},{"text":"tó à ↄkpà a sì, aà kpɛ́ ì ibↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wì blɛ zↄ̃ↄ kɛ pↄnakɛa yã́iɛ,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛmia ì mↄ́ ń yaalↄo,","poem":1},{"lineBreak":true},{"text":"ãma ↄ̃a mɛ́ ì mↄ́ ń a píio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ńsu kía sↄ̃́sↄ̃o, baa n nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"ńsu ↄde kao, baa n kpɛa,","poem":1},{"lineBreak":true},{"text":"asa bã a yã́pi sɛ́lɛ gɛ́ siuinɛ́ɛ.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"10.8 Soũ 7.16, Yaa 26.27","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}