{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ECC","translationId":"bqc_sim","name":"Làasoode","commonName":"Làasoode","title":"LÀASOODE","order":21,"numberOfChapters":12,"sha256":"0c4a32b14e6570fdff7c86b113d21b4db9a6a8336a908640455459f6793bdf63","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqc_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ɔzↄ̃ gbɛ̃́ↄnɛ blɛi,","poem":1},{"lineBreak":true},{"text":"gↄↄewa ńyↄ̃ e lↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Biilɛ gbɛ̃ↄn soplaↄnɛ ge swaaↄ̃,","poem":1},{"lineBreak":true},{"text":"asa ń músi pↄ́ a bùsu le dↄ̃o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó luabɛsiana pà ń ío, ì ma tↄↄlɛ lou ũɛ,","poem":1},{"lineBreak":true},{"text":"tó lí lɛ̀lɛ gukpɛ ge bɛ'aɛn nò,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ à lɛ̀lɛu, we ìↄ wúlɛu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a wɛ́ dↄ ĩ́anai lí pↄ́tↄ̃o,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ luabɛsia gwa lí pↄkɛkɛo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lá ń wɛ̃nibↄkĩi ge nɛ́ daalɛa nɛasakpɛu dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ fↄ̃ ǹ Lua Pↄ́piikɛna yãkɛa dↄ̃o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pↄ́tↄ̃ kↄↄ, ńsu ↄkpa n kùɛ oosio,","poem":1},{"lineBreak":true},{"text":"asa ń dↄ̃ a kpele mɛ́ a kɛ báaa vĩo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ bee yã̀, ge kee yã̀,","poem":1},{"lineBreak":true},{"text":"ge aaↄ maa ḿpii yã̀, ń dↄ̃o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gupua na,","poem":1},{"lineBreak":true},{"text":"mɛ́ wɛsia ĩatɛ̃lɛ ì káńgu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lá gbɛ̃́ wɛ̃ni lɛ́ gɛ́ lɛ́u,","poem":1},{"lineBreak":true},{"text":"aà pↄnakɛu píi.","poem":1},{"lineBreak":true},{"text":"Ń beeo aà làasookɛ gusia gↄↄↄwa,","poem":1},{"lineBreak":true},{"text":"asa aaↄ dasiɛ.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ lɛ́ mↄ́ píi pãɛ.","poem":1}]},{"type":"heading","content":["Lɛdaa ɛ̀waasoↄwa"]},{"type":"verse","number":9,"content":[{"text":"Ɛ̀waaso, pↄnakɛ n ɛ̀waasogↄↄ,","poem":1},{"lineBreak":true},{"text":"to n pↄ kɛ n ɛ̀waasogↄↄwa na.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ n pↄ gbà kɛ,","poem":1},{"lineBreak":true},{"text":"tɛ yã́ pↄ́ kàngui,","poem":1},{"lineBreak":true},{"text":"ãma apii guu ǹyↄ̃ dↄ̃","poem":1},{"lineBreak":true},{"text":"kɛ́ Lua a yã́kpalɛkɛnnↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńsu to n pↄ yao,","poem":1},{"lineBreak":true},{"text":"ǹ n gu'ĩaↄ bↄnla,","poem":1},{"lineBreak":true},{"text":"asa ɛ̀waasokɛ ń mikã siao ì gɛ̃zɛaɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}