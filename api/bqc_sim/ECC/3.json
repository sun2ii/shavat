{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ECC","translationId":"bqc_sim","name":"Làasoode","commonName":"Làasoode","title":"LÀASOODE","order":21,"numberOfChapters":12,"sha256":"0c4a32b14e6570fdff7c86b113d21b4db9a6a8336a908640455459f6793bdf63","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqc_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":3,"content":[{"type":"heading","content":["Yã́pii ń a gↄↄoɛ"]},{"type":"verse","number":1,"content":[{"text":"Yã́pii ń a gↄↄoɛ,","poem":1},{"lineBreak":true},{"text":"bↄↄlɛ píi ń a kɛgↄↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛ'igↄↄ ku, gagↄↄ ku,","poem":1},{"lineBreak":true},{"text":"pↄ́tↄ̃gↄↄ ku, a wolɛgↄↄ ku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛgↄↄ ku, gbã́gbãgↄↄ ku,","poem":1},{"lineBreak":true},{"text":"gboogↄↄ ku, a dↄgↄↄ ku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔↄlↄgↄↄ ku, yaalↄgↄↄ ku,","poem":1},{"lineBreak":true},{"text":"wɛ̃nakɛgↄↄ ku, kↄ̃̀ↄ'ogↄↄ ku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛkↄlɛgↄↄ ku, gbɛkãaagↄↄ ku,","poem":1},{"lineBreak":true},{"text":"bↄ̃̀nↄblegↄↄ ku, a zɛgↄↄ ku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pↄwɛɛlɛgↄↄ ku, a ↄkpaigↄↄ ku,","poem":1},{"lineBreak":true},{"text":"ↄdidia pↄ́wa gↄↄ ku, a gbaɛa gↄↄ ku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pↄ́gakɛ̃gↄↄ ku, a namigↄↄ ku,","poem":1},{"lineBreak":true},{"text":"lɛkpaaũgↄↄ ku, yã'ogↄↄ ku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yenzigↄↄ ku, zangugↄↄ ku,","poem":1},{"lineBreak":true},{"text":"zĩkagↄↄ ku, kálɛa aafia gↄↄ ku.","poem":1}]},{"type":"verse","number":9,"content":["Bↄ́ ài zĩkɛna ì e taasi pↄ́ a kɛ̀wai?"]},{"type":"verse","number":10,"content":["Ma zĩ pↄ́ Lua dà gbɛ̃nazĩnaↄnɛ aa kɛ è."]},{"type":"verse","number":11,"content":["Lua tò pↄ́pii maa a gↄↄwa. À kua gↄↄpii làasoo dà gbɛ̃nazĩna sↄ̃u lↄ, kási a fↄ̃ yã́ pↄ́ Lua lɛ́ kɛ za dṹnia daalɛa e a midɛawa gbadↄ̃o."]},{"type":"verse","number":12,"content":["Má dↄ̃ kɛ́ pↄe maa ń gbɛ̃nazĩnao dɛ aà kua pↄna guu ń maakɛao aà wɛ̃ni lɛ́ulao."]},{"type":"verse","number":13,"content":["Tó gbɛ̃́ lɛ́ pↄble, àlɛ imi, àlɛ a zĩ píi sáaukpa, Lua mɛ́ aà gbà."]},{"type":"verse","number":14,"content":["Má dↄ̃ kɛ́ yã́ pↄ́ Lua lɛ́ kɛ aↄ ku gↄↄpiiɛ. Wa fↄ̃ pↄe kã́fĩuo, mɛ́ wa fↄ̃ pↄe laouo. Lua kɛ̀ màa, kɛ́ wàↄ a vĩa vĩ yã́iɛ."]},{"type":"verse","number":15,"content":["Pↄ́ pↄ́ kú tia ku za zi kↄ̀, mɛ́ pↄ́ pↄ́ aↄ ku zia ku yãa lↄ. Lua ì yã́ pↄ́ kɛ̀ yãaↄ gbɛsisi."]},{"type":"verse","number":16,"content":["Ma yã́ è dṹniau lↄ:",{"text":"Gu pↄ́ dɛ yã́zɛde àↄ kuu,","poem":1},{"lineBreak":true},{"text":"yã́zɛsai mɛ́ kú we,","poem":1},{"lineBreak":true},{"text":"mɛ́ gu pↄ́ dɛ yãmaa àↄ kuu,","poem":1},{"lineBreak":true},{"text":"yãvãi mɛ́ kú we.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má ò mazĩawa:","poem":1},{"lineBreak":true},{"text":"Lua a yã́kpalɛkɛ ń gbɛ̃maaↄ ń gbɛ̃vãiↄ píi,","poem":1},{"lineBreak":true},{"text":"asa yã́pii ń a gↄↄoɛ,","poem":1},{"lineBreak":true},{"text":"bↄↄlɛ píi ń a kɛgↄↄo.","poem":1}]},{"type":"verse","number":18,"content":["Má ò ma sↄ̃ guu lↄ: Gbɛ̃nazĩnaↄ ì kɛ màa, Lua a ń yã́wɛ wɛ̃nɛ́, aai dↄ̃ ńzĩawa wa dɛ lán nↄ̀bↄↄwaɛ."]},{"type":"verse","number":19,"content":["Sĩanaɛ, gbɛ̃nazĩnaↄ ń nↄ̀bↄↄ, gó doũ mɛ́ a ń bua. Lá nↄ̀bↄ ì ga, màa gbɛ̃nazĩna ì ga lↄ, an wea doũɛ. Gbɛ̃nazĩna dɛ nↄ̀bↄlao, asa yã́pii pãɛ."]},{"type":"verse","number":20,"content":["Ampii aaì gɛ́ gudoũ, asa ampii aa bↄ̀ bùsutiuɛ, mɛ́ ampii aa ɛa gↄ̃ bùsutipi ũɛ."]},{"type":"verse","number":21,"content":["Tó gbɛ̃nazĩna nisĩna ì ta musu, nↄ̀bↄ pↄ́ ì ta zĩ́lɛn lò, démɛ dↄ̃i?"]},{"type":"verse","number":22,"content":["A yã́i tò má è yãe maa ń gbɛ̃nazĩnao dɛ aà a zĩ sáaukpalao, asa aà luakpaman we. Démɛ a to aà dↄ̃ yã́ pↄ́ a mↄ aà kpɛi?"]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}