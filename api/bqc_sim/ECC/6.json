{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ECC","translationId":"bqc_sim","name":"Làasoode","commonName":"Làasoode","title":"LÀASOODE","order":21,"numberOfChapters":12,"sha256":"0c4a32b14e6570fdff7c86b113d21b4db9a6a8336a908640455459f6793bdf63","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqc_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Ma vãi è dṹnia guu lↄ, à tↄ̃̀ gbɛ̃nazĩnaↄwa."]},{"type":"verse","number":2,"content":["Lua gbɛ̃́ kà ↄdawa, à aà gbà àizɛɛ ń bɛɛɛo, a pↄ́ pↄ́ dɛ àↄ a ni vĩ píi vĩ, ↄ̃ Lua i to à pↄnakɛ̀òo, gbɛ̃pãle mɛ́ gↄ̃̀ vĩ. Beeá pãɛ, yãvãi pãsĩɛ."]},{"type":"verse","number":3,"content":["Tó gbɛ̃́ nɛ'ì mɛ̀n basↄo mɛ́ à zikũ̀ táotao, baa ń aà gɛ̃gɛ̃akɛo, tó i e pↄnakɛ̀ a guuo, tó à gà mɛ́ aà vĩa kpɛlaao, nɛ́ pↄ́ wa ì gɛ̀ sã̀ↄwà."]},{"type":"verse","number":4,"content":["Asa nɛ́pi mↄ̀ pãɛ, ↄ̃ à tà gusiau, aà tↄ́ gↄ̃̀ balau."]},{"type":"verse","number":5,"content":["Baa kɛ́ i ĩatɛ̃ eo mɛ́ a yãe dↄ̃o, à niɛ è dɛ ↄdepia."]},{"type":"verse","number":6,"content":["A dɛ gbɛ̃́ pↄ́ kú wɛ̃̀ ↄ̀aa kwi pↄnakɛsaila. Aali gɛ́ gudoũ ḿpiio lé?"]},{"type":"verse","number":7,"content":[{"text":"Gbɛ̃nazĩna isima pↄ́ a gà lɛ́ kpá,","poem":1},{"lineBreak":true},{"text":"à pↄ́ e da lɛ́ɛ yã́ɛ,","poem":1},{"lineBreak":true},{"text":"kási aà gbɛɛ lí kã́o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bↄ́ ↄ̃nↄna dɛò sↄũai?","poem":1},{"lineBreak":true},{"text":"Bↄ́ ài yãkɛa a zɛ́wa ì i taasideɛi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pↄnakɛa ń pↄ́ pↄ́ ń vĩo","poem":1},{"lineBreak":true},{"text":"maa dɛ a pãle nidɛaa.","poem":1},{"lineBreak":true},{"text":"Beeá pãɛ lↄ mɛ́ gugiiyaaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ kɛ̀ yãa tↄ́ vĩ kↄ̀,","poem":1},{"lineBreak":true},{"text":"mɛ́ wa dↄ̃ lá gbɛ̃nazĩna dɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩna a fↄ̃ lɛkpaakɛ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ a gbãa dɛalaoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yãbↄlɛ dasi ì yãpã kↄ̃́.","poem":1},{"lineBreak":true},{"text":"Bↄ́ ài bee vĩ gbɛ̃́ɛi?","poem":1}]},{"type":"verse","number":12,"content":["Démɛ dↄ̃ pↄ́ pↄ́ maa ń gbɛ̃nazĩnao aà wɛ̃ni gii kpòona pↄ́ ì gɛ̃ lán uenawa guui? Démɛ a fↄ̃ yã́ pↄ́ a kɛ aà kpɛ dṹnia guu oɛ̀i?"]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}