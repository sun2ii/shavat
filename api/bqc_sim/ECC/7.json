{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ECC","translationId":"bqc_sim","name":"Làasoode","commonName":"Làasoode","title":"LÀASOODE","order":21,"numberOfChapters":12,"sha256":"0c4a32b14e6570fdff7c86b113d21b4db9a6a8336a908640455459f6793bdf63","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqc_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Ɔ̃nↄdaanɛ́"]},{"type":"verse","number":1,"content":[{"text":"Tↄ́ na maa dɛ tulale bɛɛɛdea,","poem":1},{"noteId":8},{"lineBreak":true},{"text":"mɛ́ gagↄↄ maa dɛ igↄↄa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gɛ̃a ua pↄ́ wàlɛ gɛwiipɛu maa","poem":1},{"lineBreak":true},{"text":"dɛ gɛ̃a ua pↄ́ wàlɛ dikpɛkɛula,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃́pii midɛan we,","poem":1},{"lineBreak":true},{"text":"mɛ́ a maa gbɛ̃́ pↄ́ kúↄ yã́pi da.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛ̃nakɛa maa dɛ yáalↄaa,","poem":1},{"lineBreak":true},{"text":"oosisia gbɛa nↄ̀sɛ ì wee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna laai ìↄ ku ua pↄ́ wàlɛ ↄ́ↄlↄuwa.","poem":1},{"lineBreak":true},{"text":"Sↄũ laai ìↄ ku ua pↄ́ wàlɛ pↄnakɛuwaɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna n lelea yãdaa maa dɛ","poem":1},{"lineBreak":true},{"text":"swã́sɛa sↄũ n táasilɛaia,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"asa sↄũↄ yaalↄ dɛ","poem":1},{"lineBreak":true},{"text":"lán kù tɛ́ pũnaa kĩnauwaɛ.","poem":1},{"lineBreak":true},{"text":"Beeá pãɛ lↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbãa mↄa gbɛ̃́ↄnɛ ì to ↄ̃nↄna sↄũkũɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbagusaɛ ì gbɛ̃́ ↄ̃̀ↄkpaɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã́ midɛa maa dɛ a fɛlɛaa,","poem":1},{"lineBreak":true},{"text":"sùuu maa dɛ kàamaia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu to n pↄ lí pa àao,","poem":1},{"noteId":9},{"lineBreak":true},{"text":"asa sↄũ mɛ́ ìↄ pↄfɛ̃ vĩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńsu yãgbɛa ǹ mɛ","poem":1},{"lineBreak":true},{"text":"bↄ́yãi yãagↄↄ maa dɛ tiaaio,","poem":1},{"lineBreak":true},{"text":"asa yãlaa bee taaá ↄ̃nↄyã no.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄá pↄmaaɛ lán túbiwa,","poem":1},{"lineBreak":true},{"text":"a ài vĩ gbɛ̃́ pↄ́ lɛ́ ĩatɛ̃ eↄnɛ píi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄá kpanziɛɛ,","poem":1},{"lineBreak":true},{"text":"lá ↄ̃a dɛ kpanziɛ ũwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ dↄ̃a àin kɛ:","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄnaↄ ↄ̃nↄ ì ń misi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Làasookɛ Lua yãkɛaↄwa.","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ pↄ́ pↄ́ a kɛ̀ kolea pooi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó gↄↄ na mↄ̀ma, pↄnakɛò.","poem":1},{"lineBreak":true},{"text":"Tó gↄↄ vãiɛ sↄ̃, làasookɛ,","poem":1},{"lineBreak":true},{"text":"Lua mɛ́ kɛ̀ píi, kɛ́ gbɛ̃e su àↄ a zia dↄ̃o yã́i.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma wɛ̃ni giiɛ bee guu ma yã́ɛ beeↄ è píi.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃maa è à gà a maakɛa guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma gbɛ̃vãi è àlɛ gɛ̃gɛ̃ a yãvãikɛa guu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ńsu to n maakɛa gɛ̃agɛ̃o,","poem":1},{"lineBreak":true},{"text":"ńsu to n ↄ̃nↄ gɛ̃agɛ̃o.","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ńyↄ̃ yã́yia nzĩawai?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N vãi su gɛ̃agɛ̃o,","poem":1},{"lineBreak":true},{"text":"ńsu ǹyↄ̃ sↄũo.","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ńyↄ̃ ga kpóoi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A maa ǹyↄ̃ yã́ mɛ̀n plapiↄ kũaɛ,","poem":1},{"lineBreak":true},{"text":"ńsu ↄkpaio,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃́ pↄ́ Lua vĩa vĩ ì yã́piↄ zɛ́ e píiɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ ì to ↄ̃nↄna gbãa àↄ dɛ","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ gbãade gbɛ̃ↄn kwiↄla.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa pↄ́ ìↄ yãmaakɛ","poem":1},{"lineBreak":true},{"text":"mɛ́ ìli duunakɛo ku dṹniauo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ńsu swã́sɛ yã́ pↄ́ wàlɛ ozi píio,","poem":1},{"lineBreak":true},{"text":"kɛ́ tó n zĩkɛna lɛ́ n ká, ńsu mao yã́i.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa ń dↄ̃ nzĩawa,","poem":1},{"lineBreak":true},{"text":"kɛ́ mpi sↄ̃ n gbɛ̃́ↄ kà dasi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma wɛtɛ̀ yã́ beeↄi ↄ̃nↄ'ↄ̃nↄ píi,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ má ↄ̃nↄkũ, ↄ̃ à zã̀kũmanↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ kúkĩi zã̀,","poem":1},{"lineBreak":true},{"text":"a asii zↄ̃ↄ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ bↄwài?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma ↄ̃nↄ ń yã́pii mio tàasikà,","poem":1},{"lineBreak":true},{"text":"má yↄ̀ɛ kɛ́ mà e dↄ̃,","poem":1},{"lineBreak":true},{"text":"mí yãvãikɛa dↄ̃ sↄũkɛ ũ,","poem":1},{"lineBreak":true},{"text":"mí sↄũkɛ dↄ̃ mìsaikɛ ũ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Má è nↄɛ pↄ́ dɛ bai ũ,","poem":1},{"lineBreak":true},{"text":"aà sↄ̃á mↄmusunaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà ↄↄá mↄdaonaɛ,","poem":1},{"lineBreak":true},{"text":"aà yã́ ì ma pↄ ya dɛ gaa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a yã́ kà Luagu ì pili nↄɛpiwa,","poem":1},{"lineBreak":true},{"text":"ãma nↄɛpi ì duunkɛna kũɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mámɛmaa Làasoode ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ ma bↄwà gwa.","poem":1},{"lineBreak":true},{"text":"Kɛ́ málɛ yã́ gwa zɛ́zɛ mà e a midↄ̃,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"gↄↄ pↄ́ málɛ wɛɛlɛ málɛ eo,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ɛ bɛɛɛde è mɛ̀ndo gbɛ̃ↄn ↄ̀aa sↄoↄ guu,","poem":1},{"lineBreak":true},{"text":"ãma baa mɛ̀ndo mi nↄɛ bɛɛɛde e ń guuo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ma bↄwàn kɛ:","poem":1},{"lineBreak":true},{"text":"Lua gbɛ̃nazĩnaↄ kɛ̀ nↄ̀sɛpuadeↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa pɛ̀lɛpɛlɛ kↄ̃ni zɛ́u.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"7.1 Yaa 22.1","reference":{"chapter":7,"verse":1}},{"noteId":9,"caller":"+","text":"7.9 Zaa 1.19","reference":{"chapter":7,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}