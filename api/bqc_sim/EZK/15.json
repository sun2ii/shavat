{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"EZK","translationId":"bqc_sim","name":"Ezekiɛli","commonName":"Ezekiɛli","title":"EZEKIƐLI","order":26,"numberOfChapters":48,"sha256":"02316ce83f11c8da0e747ca161da9527573284c7d9c39debab3626ab048f9cbd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bqc_sim/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":15,"content":[{"type":"heading","content":["Yelusalɛũ lɛɛũa ń vɛ̃ɛ yàao"]},{"type":"verse","number":1,"content":["Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":2,"content":["Gbɛ̃nazĩn nɛ́, vɛ̃ɛli líkɛ dɛ líↄla yã̀?"]},{"type":"verse","number":3,"content":["Wì pↄe kɛ ń a lío yã̀? Wì kálo kɛ ń a lío wà pↄ́ loowàe?"]},{"type":"verse","number":4,"content":["Wì kátɛu yàa ũɛ. Tó a vlã́ ń a mio tɛkũ̀ mɛ́ a guo tɛ́ lɛ̀, wa fↄ̃ zĩkɛòe?"]},{"type":"verse","number":5,"content":["Gↄↄ pↄ́ a lɛ́so, wà zĩe kɛ̀òɛ, belenkɛ gↄↄ pↄ́ à tɛ́ lɛ̀ à gↄ̃̀ sín bèebeea?"]},{"type":"verse","number":6,"content":["Ayãmɛto ma Dii Lua ma mɛ̀, lá líↄ guu vɛ̃ɛli má sɛ̀ yàa ũ má kàtɛu, màa má kɛ Yelusalɛũdeↄnɛ."]},{"type":"verse","number":7,"content":["Tó ma fɛlɛńnↄ, baa kɛ́ aa bↄ̀ tɛ́u, tɛ́ mɛ́ a ɛa kṹmá. Tó ma íbɛlɛsɛ̀ńnↄ, áↄ dↄ̃ kɛ́ mámɛmaa Dii."]},{"type":"verse","number":8,"content":["Má tó an bùsu gↄ̃ bɛzia ũɛ, asa aa náaisaiyãkɛ̀mɛɛɛ. Ma Dii mámɛ má ò."]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}