{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"EZK","translationId":"bqc_sim","name":"Ezekiɛli","commonName":"Ezekiɛli","title":"EZEKIƐLI","order":26,"numberOfChapters":48,"sha256":"02316ce83f11c8da0e747ca161da9527573284c7d9c39debab3626ab048f9cbd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bqc_sim/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":19,"content":[{"type":"heading","content":["Wɛ̃nalɛsia Isaili kíaↄnɛ"]},{"type":"verse","number":1,"content":["Wɛ̃nalɛ si Isaili kíaↄ yã́ musu"]},{"type":"verse","number":2,"content":["ǹ mɛ:",{"text":"Á daá nↄ̀ↄmusu daɛ fá!","poem":1},{"lineBreak":true},{"text":"À wùlɛ nↄ̀ↄmusu saↄ zãnguo,","poem":1},{"lineBreak":true},{"text":"à a nɛ́ↄ gwà nↄ̀ↄmusu ɛ̀waasoↄ guu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a nɛ́ do gwà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à kɛ̀ nↄ̀ↄmusu sà bↄlↄ ũ.","poem":1},{"lineBreak":true},{"text":"À pↄ́taitaia dàda,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ gbɛ̃nazĩnsona ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ́ buiↄ aà bao mà,","poem":1},{"lineBreak":true},{"text":"aa ɛyↄ̃̀ɛ̀, ↄ̃ à zù ɛpiu.","poem":1},{"lineBreak":true},{"text":"Aa bakàɛ̀ a níu,","poem":1},{"lineBreak":true},{"text":"aa tàaànↄ Egipi bùsuu.","poem":1},{"noteId":36}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ́ nↄ̀ↄmusu dapi è tãmaa a nɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ aà wɛ́ dↄi mɛ́ mìdɛ we,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ɛ̀a à a nɛ́ do dìlɛ lↄ,","poem":1},{"lineBreak":true},{"text":"à kɛ̀ nↄ̀ↄmusu sà bↄlↄ ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À bɛ̀bɛ ń nↄ̀ↄmusu saↄ","poem":1},{"lineBreak":true},{"text":"nↄ̀ↄmusu sà bↄlↄ ũ.","poem":1},{"lineBreak":true},{"text":"À pↄ́taitaia dàda,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ gbɛ̃nazĩnsona ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À ń kibɛↄ wìwi, à ń wɛ̃́lɛↄ dàaĩ.","poem":1},{"lineBreak":true},{"text":"Sↄ̃ kɛ̃̀ bùsupideↄgu","poem":1},{"lineBreak":true},{"text":"nↄ̀ↄmusupi pũnaama yã́i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃ buiↄ bↄ̀ bùsu pↄ́ liaaiↄ guu,","poem":1},{"lineBreak":true},{"text":"aa mↄ̀ lɛ́lɛiwà.","poem":1},{"lineBreak":true},{"text":"Aa baikpàɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à zù ɛ pↄ́ aa yↄ̃̀ɛ guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wà bakàɛ̀ a níu,","poem":1},{"lineBreak":true},{"text":"wà wáa tã̀ wà aà dàu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wà tàaànↄ Babɛli kíaɛ.","poem":1},{"noteId":37},{"lineBreak":true},{"text":"We wà aà dàu kpɛ́u,","poem":1},{"lineBreak":true},{"text":"kɛ́ wasu aà pũnaa ma","poem":1},{"lineBreak":true},{"text":"Isaili bùsu gbɛ̀sĩsĩↄ sↄ̀ↄu lↄo yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Á da dɛ lán vɛ̃ɛliwa á kaau.","poem":1},{"lineBreak":true},{"text":"Wa aà pɛ̀ swa saɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃naↄ kɛ̃̀kɛ̃,","poem":1},{"lineBreak":true},{"text":"ↄ̃ swa saɛpi tò à nɛ'ì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A gↄ̃napiↄ gbãa kà","poem":1},{"lineBreak":true},{"text":"wà kía gopana kɛò.","poem":1},{"lineBreak":true},{"text":"Lípi lɛsĩ, à gbã̀ zↄ̃̀ luawa,","poem":1},{"lineBreak":true},{"text":"a gbã̀a ń a gↄ̃n dasipiↄ tò wìli kuawào.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃ wa bìlɛ ń pↄfɛ̃o wa nɛ̀.","poem":1},{"lineBreak":true},{"text":"Gukpɛ ĩ́ana tò à giigàga,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a nɛ́ↄ wòlo.","poem":1},{"lineBreak":true},{"text":"A gↄ̃n gbãapiↄ giigàga,","poem":1},{"lineBreak":true},{"text":"ↄ̃ tɛ́ kũ̀wà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tiasa a pɛa gbáauɛ","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ gii isaideu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A gↄ̃n do tɛsɛ̀ à kũ̀ a nɛ́ↄwa.","poem":1},{"lineBreak":true},{"text":"A gↄ̃na pↄ́ a gbãa kà wà kí gopana kɛò kuwà lↄo.","poem":1},"Wɛ̃na yã́ɛ, wàli sí lɛ ũ."]}],"footnotes":[{"noteId":36,"caller":"+","text":"19.4 2Kia 23.33-34","reference":{"chapter":19,"verse":4}},{"noteId":37,"caller":"+","text":"19.9 2Kia 24.15","reference":{"chapter":19,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}