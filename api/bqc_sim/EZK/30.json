{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"EZK","translationId":"bqc_sim","name":"Ezekiɛli","commonName":"Ezekiɛli","title":"EZEKIƐLI","order":26,"numberOfChapters":48,"sha256":"02316ce83f11c8da0e747ca161da9527573284c7d9c39debab3626ab048f9cbd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bqc_sim/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":30,"content":[{"type":"heading","content":["Wɛ̃nakɛa Egipiↄnɛ"]},{"type":"verse","number":1,"content":["Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":2,"content":["Gbɛ̃nazĩn nɛ́, ãnabikɛkɛ ǹ mɛ",{"text":"ma Dii Lua ma mɛ̀","poem":1},{"lineBreak":true},{"text":"wiipɛ ǹ mɛ, agya! A gↄↄ kà!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa gↄↄpi kà kãi,","poem":1},{"lineBreak":true},{"text":"Dii gↄↄpi kãikũ̀.","poem":1},{"lineBreak":true},{"text":"Guduuduu gↄↄɛ!","poem":1},{"lineBreak":true},{"text":"Buiↄ yã'egↄↄɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wa mↄ lɛ́lɛ Egipiↄwa ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"sↄ̃ i kɛ̃ Etiopiↄgu.","poem":1},{"lineBreak":true},{"text":"Tó wà gbɛ̃́ↄ dɛ̀dɛ Egipi,","poem":1},{"lineBreak":true},{"text":"wa aà àizɛɛↄ sɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"wi aà gbãa'ekĩi gboo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Etiopiↄ ń Putiↄ gagańnↄ sãnu zĩu","poem":1},{"lineBreak":true},{"text":"ń Ludiↄ ń Laalubuↄ píi ń Libiiↄ","poem":1},{"lineBreak":true},{"text":"ń bùsude pↄ́ aa lɛdoũkɛ̀ńnↄↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì Egipi gba gbãaↄ lɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"gbãa pↄ́ Egipiↄ ì ĩ́anadãò kↄ a ɛ́.","poem":1},{"lineBreak":true},{"text":"Wa gaga zĩ guu za Midoli e Asuã,","poem":1},{"lineBreak":true},{"text":"ma Dii Lua mámɛ má ò.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An bùsuↄ gↄ̃ bɛzia ũ dɛ bùsu píia,","poem":1},{"lineBreak":true},{"text":"an wɛ̃́lɛ ↄ̃̀ↄkpaa aↄ dɛ wɛ̃́lɛ píia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó ma tɛsↄ̃̀ Egipiwa,","poem":1},{"lineBreak":true},{"text":"an dↄnlɛdeↄ kɛ kɛ́lɛkɛlɛ ḿpiiɛ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dↄ̃ kɛ́ mámɛmaa Dii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má zĩnaↄ gbaɛ ń gó'ilɛnaↄ,","poem":1},{"lineBreak":true},{"text":"aai gili gɛ̃ Etiopi pↄ́ kálɛa dↄdↄaↄgu.","poem":1},{"lineBreak":true},{"text":"Sↄ̃ a kɛ̃́ńgu Egipi yã'egↄↄ.","poem":1},{"lineBreak":true},{"text":"Gↄↄpi lɛ́ mↄɛ fá!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma Dii Lua ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má tó Babɛli kí Nɛbukanɛza","poem":1},{"lineBreak":true},{"text":"Egipi zĩgↄ̃ dasiↄ míↄnzↄ̃.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má mↄaànↄ ń aà zĩgↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"bui pãsĩpiↄ i Egipi dúuzↄ̃.","poem":1},{"lineBreak":true},{"text":"Aa ń fɛ̃ndaↄ wo Egipiↄzi,","poem":1},{"lineBreak":true},{"text":"aai to bùsu pa ń gɛↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má tó a swaↄ í ba,","poem":1},{"lineBreak":true},{"text":"mí bùsupi na gbɛ̃vãipiↄnɛ ń ↄzĩ.","poem":1},{"lineBreak":true},{"text":"Má tó bui zĩ̀loↄ bùsupi ↄ̃̀ↄkpa","poem":1},{"lineBreak":true},{"text":"ń pↄ́ pↄ́ kú a guuↄ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma Dii Lua ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má tã́aↄ midɛ,","poem":1},{"lineBreak":true},{"text":"mí Mɛfisi dii pãpiↄ míↄnzↄ̃.","poem":1},{"lineBreak":true},{"text":"Kíae aↄ ku Egipi lↄo,","poem":1},{"lineBreak":true},{"text":"má tó vĩa Egipiↄ kũ ḿpiiɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má tó Egipi gɛↄmidↄkĩi oi gↄ̃ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"mí tɛsↄ̃ Zoãwa,","poem":1},{"lineBreak":true},{"text":"mí yã́kpalɛkɛ ń Tɛbɛsio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má pↄkũmabↄbↄ","poem":1},{"lineBreak":true},{"text":"Egipi wɛ̃́lɛ bĩ́ide Pelusiwa,","poem":1},{"lineBreak":true},{"text":"mí Tɛbɛsi gbɛ̃́ dasipiↄ tↄ̀lↄzↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má tɛsↄ̃ Egipiwa,","poem":1},{"lineBreak":true},{"text":"Pelusi i luukpa,","poem":1},{"lineBreak":true},{"text":"wi Tɛbɛsi bĩ́i gboo,","poem":1},{"lineBreak":true},{"text":"Mɛfisi i loo fãanɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɛliↄpↄli ń Bubasio ɛ̀waasoↄ gaga zĩ guuɛ,","poem":1},{"lineBreak":true},{"text":"wi tá ń wɛ̃́lɛpideↄ zĩ̀zↄↄ ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó ma Egipiↄ zuu bↄlɛ gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"má ń gbãa pↄ́ aaì ĩ́anadãò kↄ'ɛ.","poem":1},{"lineBreak":true},{"text":"Gu a si Tapanɛsi fãanɛ,","poem":1},{"lineBreak":true},{"text":"lou guduuduu i daa,","poem":1},{"lineBreak":true},{"text":"wi a zↄ̃ɛwiadeↄ kṹkũ zĩ̀zↄↄ ũ,","poem":1},{"lineBreak":true},{"text":"wi táńnↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Màa má yã́kpalɛkɛ ń Egipiↄ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dↄ̃ kɛ́ mámɛmaa Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Wá kua zĩ̀zↄↄ ũ wɛ̃̀ kuɛdode, a mↄ sɛ̃́ia gↄↄ soplade zĩ́ Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":21,"content":[{"text":"Gbɛ̃nazĩn nɛ́, ma Egipiↄ kí Falaↄ̃ↄ gã̀sĩ ɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wi dↄ à gbã̀gbão,","poem":1},{"lineBreak":true},{"text":"wi zwãa yewà à gbãakũ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e fɛ̃nda kũo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A yã́i tò ma Dii Lua ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má ɛa fɛlɛ ń Egipiↄ kí Falaↄ̃ↄoɛ,","poem":1},{"lineBreak":true},{"text":"mí aà gã̀sĩ ɛ́'ɛ pla píi,","poem":1},{"lineBreak":true},{"text":"a gbãa ń a gyãeo,","poem":1},{"lineBreak":true},{"text":"fɛ̃nda i piliwà à lɛ́lɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Má Egipiↄ fãaa buiↄ guu,","poem":1},{"lineBreak":true},{"text":"mí ń fã́ndaiada bùsu ń bùsuo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Má Babɛli kía gba gbãa,","poem":1},{"lineBreak":true},{"text":"mí a fɛ̃nda naɛ̀ a ↄzĩ,","poem":1},{"lineBreak":true},{"text":"mí Falaↄ̃ↄ gã̀sĩ ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"i oi'oikɛ Babɛli kíapi aɛ","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ lɛ́ gawa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma Babɛli kía gba gbãa,","poem":1},{"lineBreak":true},{"text":"Falaↄ̃ↄ ↄ i gↄ̃ dↄ̀lↄlↄ.","poem":1},{"lineBreak":true},{"text":"Tó ma a fɛ̃nda nà Babɛli kíaɛ a ↄzĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a sɛ dↄ Egipiↄ bùsua,","poem":1},{"lineBreak":true},{"text":"aaↄ dↄ̃ sa kɛ́ mámɛmaa Dii.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Má Egipiↄ fãaa buiↄ guu,","poem":1},{"lineBreak":true},{"text":"mí ń fã́ndaiada bùsu ń bùsuo,","poem":1},{"lineBreak":true},{"text":"aaiↄ dↄ̃ kɛ́ mámɛmaa Dii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}