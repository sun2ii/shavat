{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"EZK","translationId":"bqc_sim","name":"Ezekiɛli","commonName":"Ezekiɛli","title":"EZEKIƐLI","order":26,"numberOfChapters":48,"sha256":"02316ce83f11c8da0e747ca161da9527573284c7d9c39debab3626ab048f9cbd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/bqc_sim/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":7,"content":[{"type":"heading","content":["Isailiↄ midɛa kà kãi"]},{"type":"verse","number":1,"content":["Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":2,"content":["Gbɛ̃nazĩn nɛ́, yã́ pↄ́ ma Dii Lua má ò Isaili bùsudeↄnɛn kɛ: Á kua lɛ́ kà! Á bùsu gola síiↄ̃ píi mìdɛ."]},{"type":"verse","number":3,"content":["Á kua lɛ́ kà! Má pↄkũmabↄbↄwáɛ, mí yã́kpalɛkɛánↄ á yãkɛaↄwa, mí yãbɛ̃ɛ pↄ́ á kɛ̀ fĩaboɛ́ píi."]},{"type":"verse","number":4,"content":["Má á wɛ̃nagwao. Má á kɛ̃o. Á yãkɛaↄ fĩa má boɛ́ ń yãbɛ̃ɛ pↄ́ á kɛ̀ↄ, íↄ dↄ̃ kɛ́ mámɛmaa Dii."]},{"type":"verse","number":5,"content":[{"text":"Ma Dii Lua ma mɛ̀ yã́ a á le!","poem":1},{"lineBreak":true},{"text":"Yãzↄ̃ↄ a á le!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Á kua lɛ́ kà! Á kua lɛ́ kà!","poem":1},{"lineBreak":true},{"text":"Yã́pi lɛ́ sↄ̃ázi, à pìlawá kↄ̀!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yã́ zↄ̃̀lɛwáɛ,","poem":1},{"lineBreak":true},{"text":"á gbɛ̃́ pↄ́ á kú bùsuɛ beeuↄ.","poem":1},{"lineBreak":true},{"text":"Á gↄↄ kà kãi, à kà se!","poem":1},{"lineBreak":true},{"text":"Gili gɛ̃̀ńgu gbɛ̀sĩsĩↄ musu,","poem":1},{"lineBreak":true},{"text":"i kɛ pↄna wii aalɛ lɛ́o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tia kɛ́wa má pↄkũmabↄbↄwá,","poem":1},{"lineBreak":true},{"text":"mí palawá ń pↄfɛ̃o.","poem":1},{"lineBreak":true},{"text":"Má yã́kpalɛkɛánↄ á yãkɛaↄwa,","poem":1},{"lineBreak":true},{"text":"mí á yãbɛ̃ɛkɛaↄ fĩaboɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má á wɛ̃nagwao, má á kɛ̃o.","poem":1},{"lineBreak":true},{"text":"Má fĩaboɛ́ á yãbɛ̃ɛkɛaↄwaɛ,","poem":1},{"lineBreak":true},{"text":"íↄ dↄ̃ ma Dii mámɛ ma á wɛtã̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"À gↄↄpi gwa, à kà! Yã́ pìla!","poem":1},{"lineBreak":true},{"text":"À nↄsì yã́ gbãa ũ, ↄ̃ à nɛ'ì wala ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yãpãsĩ fɛ̀lɛ vãikɛnaↄ gbɛ̃go ũ.","poem":1},{"lineBreak":true},{"text":"An gbɛ̃e a bↄo! Bílapi gbɛ̃e a bↄo!","poem":1},{"lineBreak":true},{"text":"Ɔdee a bↄo! An bɛɛɛdee a bↄo!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A gↄↄ kà! À ń lé!","poem":1},{"lineBreak":true},{"text":"Pↄluna su pↄnakɛo,","poem":1},{"lineBreak":true},{"text":"pↄyiana su ↄ́ↄlↄo,","poem":1},{"lineBreak":true},{"text":"asa ma pↄ fɛ̃̀ bílapiziɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pↄyiana a pↄ́ pↄ́ á yìa si lↄo e a wɛ̃ni lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ãnabikɛkɛa bílaɛpi a lɛ́lɛ pão,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a bↄo a tàae yã́i.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wà kuupɛ̀, zĩ̀ sↄu mà píi,","poem":1},{"lineBreak":true},{"text":"kási gbɛ̃e a gɛ́ zĩlauo,","poem":1},{"lineBreak":true},{"text":"asa ma pↄ fɛ̃̀ bílapiziɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zĩ ku bĩ́i kpɛ,","poem":1},{"lineBreak":true},{"text":"gagyã ń nↄanao ku wɛ̃́lɛ guu.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa ku sɛ̃uↄ gaga zĩ guuɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa ku wɛ̃́lɛ guuↄ gaga","poem":1},{"lineBreak":true},{"text":"ń nↄanao ń gagyãoɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"An gbɛ̃́ pↄ́ aa bↄ̀ↄ","poem":1},{"lineBreak":true},{"text":"bàalɛ ta gbɛ̀sĩsĩↄ kĩ́i.","poem":1},{"lineBreak":true},{"text":"Aa ↄ́ↄlↄ lán swadↄↄ felenaↄwa","poem":1},{"lineBreak":true},{"text":"baade zĩa tàae yã́i.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ampii an ↄ a gↄ̃ dↄńziɛ,","poem":1},{"lineBreak":true},{"text":"an kosokũↄ i busa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aai zwã̀nkasaↄ dↄ ń pi,","poem":1},{"lineBreak":true},{"text":"vĩa i ń kṹ.","poem":1},{"lineBreak":true},{"text":"An gɛɛ i gↄ̃ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"aai migbaa lɛ́ ḿpii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa ń ã́nusuↄ kↄ́lɛ zɛaↄ guu,","poem":1},{"lineBreak":true},{"text":"an vuaↄ i gↄ̃nɛ́ pↄ́ gbãlɛaↄ ũ.","poem":1},{"lineBreak":true},{"text":"An ã́nusuↄ ń ń vuaↄ a fↄ̃ ń bↄ Dii pↄfɛ̃gↄↄzĩo.","poem":1},{"lineBreak":true},{"text":"Ɔ̃api a ń nↄana kpálɛo,","poem":1},{"lineBreak":true},{"text":"an gbɛɛ kão,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃mɛ ń dá duunau.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aa ńzĩa sɛ̀ lɛsĩ","poem":1},{"lineBreak":true},{"text":"ń nↄamblebↄ kɛfɛnaↄ yã́i,","poem":1},{"lineBreak":true},{"text":"aa pↄbɛ̃ɛ pↄ́ má ye a gĩyãioↄ pìò.","poem":1},{"lineBreak":true},{"text":"A yã́i má tó à gↄ̃nɛ́ pↄ́ gbãlɛa ũ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Má pↄ́piↄ na bui zĩ̀loↄnɛ ń ↄzĩ","poem":1},{"lineBreak":true},{"text":"aa ń pↄ́ sɛ́lɛɛ.","poem":1},{"lineBreak":true},{"text":"Má kpá dṹnia vãikɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"aa ń pↄ́ naaaɛ, aai a gbãlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má mikpɛlinɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"aai ma gu bɛɛɛde gbãlɛ.","poem":1},{"lineBreak":true},{"text":"Kpã́i wɛliwɛpiↄ gɛ̃u, aai a gbãlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"À mↄgalaↄ pí,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃dɛa di bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ yã́ gbãa kↄ̃̀ wɛ̃́lɛu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Má tó bui vãiↄ mↄ́ ń uaↄ símá,","poem":1},{"lineBreak":true},{"text":"má tó gbãadeↄ zĩasɛa lɛsĩ midɛ,","poem":1},{"lineBreak":true},{"text":"wi ń sa'okĩiↄ gbãlɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó gili gɛ̃̀ńgu, aa aafia wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"kási aa eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Músi a kɛ músi,","poem":1},{"lineBreak":true},{"text":"bao ĩ́i a kɛ bao ĩ́i,","poem":1},{"lineBreak":true},{"text":"aai gbasa kpálɛkɛ ãnabikɛkɛai.","poem":1},{"lineBreak":true},{"text":"Sa'ona a fua ikoyãwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃zↄ̃ↄ a kua lɛdamawa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kí a búbuapɛ,","poem":1},{"lineBreak":true},{"text":"yã́ a di kíanɛwa,","poem":1},{"lineBreak":true},{"text":"táaaↄ ↄ a lualua.","poem":1},{"lineBreak":true},{"text":"Má kɛnɛ́ an yãkɛaↄwaɛ,","poem":1},{"lineBreak":true},{"text":"má yãdańla lá aa dà gbɛ̃́awaɛ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dↄ̃ kɛ́ mámɛmaa Dii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}