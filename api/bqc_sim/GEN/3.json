{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"GEN","translationId":"bqc_sim","name":"Daalɛa","commonName":"Daalɛa","title":"DAALƐA Mↄizi lá sɛ̃́ia","order":1,"numberOfChapters":50,"sha256":"154ef5c299602297f3ff5292d80413f4a89be349ffacc6f69f0dc00e1dd60e5c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bqc_sim/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":3,"content":[{"type":"heading","content":["Gbɛ̃nazĩna kɛ̃akↄ̃wa ń Luao"]},{"type":"verse","number":1,"content":["Mlɛ̃",{"noteId":9},"mɛ́ kↄ̃ni vĩ dɛ sɛ̃̀anↄbↄ pↄ́ Dii Lua kɛ̀ↄla píi, ↄ̃ à nↄɛ là à mɛ̀: Lua mɛ̀ ásu lupi líe bɛ bleoɛa?"]},{"type":"verse","number":2,"content":["Ɔ̃ nↄɛ wè mlɛ̃piwa: Wá fↄ̃ wà lupi libɛ ble,"]},{"type":"verse","number":3,"content":["ãma lí pↄ́ kú lupi guo, Lua mɛ̀ wásu wà a bɛ bleo, wásu ↄkãwà seo, kɛ́ wásu gao yã́i."]},{"type":"verse","number":4,"content":["Ɔ̃ mlɛ̃ òɛ̀: Á ga seo!",{"noteId":10}]},{"type":"verse","number":5,"content":["Lua dↄ̃ tó á blè, á wɛ́ a kɛ̃́, í gↄ̃ láawa, íↄ maa ń vãio dↄ̃."]},{"type":"verse","number":6,"content":["Kɛ́ nↄɛ è lípi bɛ kɛfɛũ mɛ́ a blea aↄ na, a to gbɛ̃́ wɛ́ kɛ̃́, ↄ̃ à a bɛ bò a blè.",{"noteId":11},"A kpà a zã́wa, ↄ̃ a blè sↄ̃.",{"noteId":12}]},{"type":"verse","number":7,"content":["An pla ḿpii an wɛ́ kɛ̃̀, ↄ̃ aa dↄ̃̀ sa kɛ́ wa ku puizi. Ɔ̃ aa goola lá nàmi aa nàńzi."]},{"type":"verse","number":8,"content":["Kɛ́ gↄ̃ɛ ń a nao Dii Lua kĩ́i mà, àlɛ bɛbɛ luu oosiɛlɛ, ↄ̃ aa ùlɛɛ̀ lupi láu."]},{"type":"verse","number":9,"content":["Ɔ̃ Dii Lua lɛzù gↄ̃ɛzi à mɛ̀: Ń kú má ni?"]},{"type":"verse","number":10,"content":["A wèwà à mɛ̀: Kɛ́ ma n kĩ́i mà, ↄ̃ vĩa ma kũ, kɛ́ má kú puizi yã́i, ↄ̃ ma ulɛ."]},{"type":"verse","number":11,"content":["Ɔ̃ Dii Lua aà là à mɛ̀: Démɛ ònɛ ń kú puiziɛi? Lí pↄ́ ma ginɛ ǹ a bɛ ble, ń blè yã̀?"]},{"type":"verse","number":12,"content":["A wèwà à mɛ̀: Nↄɛ pↄ́ ń kpàa àↄ kumanↄ mɛ́ lípi bɛ kpàa, ↄ̃ má blè."]},{"type":"verse","number":13,"content":["Ɔ̃ Dii Lua nↄɛ là à mɛ̀: Bↄ́yãi ń kɛ̀i màai? A wèwà à mɛ̀: Mlɛ̃ mɛ́ ma sãsã, ↄ̃ má blè.",{"noteId":13}]},{"type":"verse","number":14,"content":["Ɔ̃ Dii Lua ò mlɛ̃ɛ:",{"text":"Lá ń kɛ̀ màa, ńyↄ̃ↄ dɛ láaipↄ ũ","poem":1},{"lineBreak":true},{"text":"dɛ pↄtuoↄ ń sɛ̃̀anↄbↄↄla píi,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ táa'o n gbɛɛwaɛ,","poem":1},{"lineBreak":true},{"text":"luutɛ̃ iↄ gɛ̃ n lɛ́u e n wɛ̃ni lɛ́u.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mpi ń nↄɛo, má ĩ́ida á zãnguo,","poem":1},{"lineBreak":true},{"text":"n bui ń aà buio zãnguo.","poem":1},{"lineBreak":true},{"text":"Aà bui a n mi wí,","poem":1},{"noteId":14},{"lineBreak":true},{"text":"mɛ́ ńyↄ̃ aà gbatoe kɛ'ĩa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɔ̃ a ò nↄɛɛ:","poem":1},{"lineBreak":true},{"text":"Má n nↄsia taasi kã́fĩnɛ,","poem":1},{"lineBreak":true},{"text":"níↄ nɛ'i ń wãwão.","poem":1},{"noteId":15},{"lineBreak":true},{"text":"N zã́ ni aliↄ kumaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aↄ iko vĩmaɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃ a ò gↄ̃ɛɛ:","poem":1},{"lineBreak":true},{"text":"Lá n n na yãmà,","poem":1},{"lineBreak":true},{"text":"n lí pↄ́ ma ginɛ ǹ a bɛ ble blè,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ a gↄ̃ láaipↄ ũ n yã́i,","poem":1},{"noteId":16},{"lineBreak":true},{"text":"taasi guu ↄ̃ ńyↄ̃li blɛ eu e n wɛ̃ni lɛ́u.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bua pↄ́ↄ ↄ̃ ńyↄ̃li ble,","poem":1},{"lineBreak":true},{"text":"ali lɛↄ ń lá ṹadeↄ bↄlɛnɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Isimagakpaa guu ↄ̃ ńyↄ̃li blɛbleu,","poem":1},{"noteId":17},{"lineBreak":true},{"text":"e ǹ ɛa ǹ gɛ̃ò tíu,","poem":1},{"lineBreak":true},{"text":"asa wekĩi ma n bↄu.","poem":1},{"lineBreak":true},{"text":"Bùsutin n ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ńyↄ̃ ɛa gↄ̃ bùsutipi ũɛ.","poem":1},{"noteId":18}]},{"type":"verse","number":20,"content":["Adamu",{"noteId":19},"tↄkpà a naɛ Ɛva,",{"noteId":20},"asa gbɛ̃́pii daziɛ."]},{"type":"verse","number":21,"content":["Dii Lua báa ula kɛ̀ Adamuɛ ń a nao a dànɛ́."]},{"type":"verse","number":22,"content":["Ɔ̃ à mɛ̀: Gbɛ̃nazĩna maa ń vãio dↄ̃̀ sa, à gↄ̃̀ láwáwa. Wà giɛ̀ aà lí wɛ̃nide bɛ bo ble, kɛ́ asu àↄ ku gↄↄpiio yã́i.",{"noteId":21}]},{"type":"verse","number":23,"content":["Ɔ̃ Dii Lua aà yà à aà bↄ̀ Edɛni lupi guu. Ɔ̃ Adamu gɛ̀ tↄↄlɛ pↄ́ Lua aà kɛ̀ò zĩkɛ̀."]},{"type":"verse","number":24,"content":["Kɛ́ Dii Lua aà yà, ↄ̃ à malaika gã̀sĩadeↄ kàlɛ Edɛni lupi gukpɛ oi, aaↄ lí wɛ̃nide zɛ́ dↄ̃́a ń fɛ̃nda pↄ́ lɛ́ liasãizↄ̃, a wɛ́tɛ̃ lɛ́ tɛkɛo."]}],"footnotes":[{"noteId":9,"caller":"+","text":"3.1 Zia 12.9, 20.2","reference":{"chapter":3,"verse":1}},{"noteId":10,"caller":"+","text":"3.4 Zãa 8.44","reference":{"chapter":3,"verse":4}},{"noteId":11,"caller":"+","text":"3.6 2Kln 11.3","reference":{"chapter":3,"verse":6}},{"noteId":12,"caller":"+","text":"3.6 Lom 5.12-21","reference":{"chapter":3,"verse":6}},{"noteId":13,"caller":"+","text":"3.13 2Kln 11.3, 1Tim 2.14","reference":{"chapter":3,"verse":13}},{"noteId":14,"caller":"+","text":"3.15 Lom 16.20, Zia 12.17","reference":{"chapter":3,"verse":15}},{"noteId":15,"caller":"+","text":"3.16 1Tim 2.15","reference":{"chapter":3,"verse":16}},{"noteId":16,"caller":"+","text":"3.17 Lom 8.20","reference":{"chapter":3,"verse":17}},{"noteId":17,"caller":"+","text":"3.19 2Tɛs 3.12","reference":{"chapter":3,"verse":19}},{"noteId":18,"caller":"+","text":"3.19 Soũ 90.3","reference":{"chapter":3,"verse":19}},{"noteId":19,"caller":"+","text":"3.20 Bee mɛ̀ gbɛ̃nazĩna.","reference":{"chapter":3,"verse":20}},{"noteId":20,"caller":"+","text":"3.20 Bee mɛ̀ wɛ̃ni.","reference":{"chapter":3,"verse":20}},{"noteId":21,"caller":"+","text":"3.22 Zia 22.14","reference":{"chapter":3,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/GEN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/GEN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/GEN/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}