{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"GEN","translationId":"bqc_sim","name":"Daalɛa","commonName":"Daalɛa","title":"DAALƐA Mↄizi lá sɛ̃́ia","order":1,"numberOfChapters":50,"sha256":"154ef5c299602297f3ff5292d80413f4a89be349ffacc6f69f0dc00e1dd60e5c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bqc_sim/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Yakↄbu sa'olɛkɛa a nɛ́ↄnɛ"]},{"type":"verse","number":1,"content":["Yakↄbu a nɛ́ↄ sìsi, ↄ̃ à mɛ̀: À kãaamazi, mí yã́ pↄ́ a á le gbɛzã oɛ́."]},{"type":"verse","number":2,"content":[{"text":"À kↄ̃ kãaa ma nɛ́ↄ, à swã́kpa,","poem":1},{"lineBreak":true},{"text":"í á mae Isaili yãma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lubɛni ma yoa, ma gbãa,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃sakɛ nɛ́ sɛ̃́ia,","poem":1},{"lineBreak":true},{"text":"n gawi ń n ikoo dɛ ń gbɛ̃́ↄla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń pãsĩ lán ísↄ̃wa,","poem":1},{"lineBreak":true},{"text":"kási ńyↄ̃ↄ dɛńlao,","poem":1},{"lineBreak":true},{"text":"asa n dɛdɛ n da n mae wúlɛkĩia,","poem":1},{"lineBreak":true},{"text":"n gbadà ma nↄↄ dowaɛ.","poem":1},{"noteId":154}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Simɛↄ ń Leviio mɛ́ kↄ̃gbɛ̃ↄ ũ,","poem":1},{"lineBreak":true},{"text":"aa pãsĩ ń fɛ̃ndao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma lɛ́ kú an lɛkpaaĩ guuo,","poem":1},{"lineBreak":true},{"text":"ma bàa kúńnↄo.","poem":1},{"lineBreak":true},{"text":"Asa aa gbɛ̃́ↄ dɛ̀dɛ ń pↄkũmao,","poem":1},{"noteId":155},{"lineBreak":true},{"text":"aa zuↄ kĩzã zↄ̃̀zↄ̃ lán kↄ̃̀ↄ yã́wa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lua láaikɛmá ń pↄkũma zↄ̃ↄ yã́i,","poem":1},{"lineBreak":true},{"text":"aà lɛkɛnɛ́ ń pↄfɛ̃ pãsĩ yã́i.","poem":1},{"lineBreak":true},{"text":"Má ń kɛ̃kↄ̃wa Yakↄbu buiↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"mí ń buiↄ fãaa Isailiↄ guu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuda, n gbɛ̃́ↄ n sáaukpa.","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ n ibɛɛↄ kṹ ń nↄ̀ɛ,","poem":1},{"lineBreak":true},{"text":"n mae nɛ́ↄ kúlɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yuda dɛ lán nↄ̀ↄmusuwa.","poem":1},{"noteId":156},{"lineBreak":true},{"text":"Ma nɛ́pi ì su ń toekao,","poem":1},{"lineBreak":true},{"text":"ì gaɛ ì wúlɛ a tòou.","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ aà vui?","poem":1},{"noteId":157}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kpala a go Yudalao,","poem":1},{"lineBreak":true},{"text":"aà buiↄ mɛ́ aaↄ lípana kũa","poem":1},{"lineBreak":true},{"text":"e kpalade àↄ mↄ́,","poem":1},{"lineBreak":true},{"text":"bui píi i misiilɛɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A a zàa'ĩna dↄ vɛ̃ɛliwa,","poem":1},{"lineBreak":true},{"text":"a a zàa'ĩn nɛ́ ye vɛ̃ɛli maawa.","poem":1},{"lineBreak":true},{"text":"Vɛ̃ɛ aↄ diaàziɛ, iↄ pↄ́ píò,","poem":1},{"lineBreak":true},{"text":"iↄ a ula pí ń vɛ̃ɛbɛ'io.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vɛ̃ɛ a aà wɛ́ tɛ̃akũ,","poem":1},{"lineBreak":true},{"text":"vĩ i aà swaa puakũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zabulↄni aↄ ku ísia saɛ,","poem":1},{"lineBreak":true},{"text":"aà bùsu aↄ dɛ gó'ilɛnadↄdↄkĩi ũ.","poem":1},{"lineBreak":true},{"text":"Aà buiↄ bùsu lɛ́n Sidↄ̃ lɛ́u.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isakaa dɛ lán zàa'ĩn gbãawa,","poem":1},{"lineBreak":true},{"text":"ìↄ wúlɛa asoↄ zãnguo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó aà buiↄ è an kã́mabokĩi maa,","poem":1},{"lineBreak":true},{"text":"mɛ́ an bùsu na,","poem":1},{"lineBreak":true},{"text":"aa koo ń aso zíɛɛ, aai zↄzĩkɛnɛ́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dã a a gbɛ̃́ↄ yã́gↄ̃gↄ̃ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ Isaili buiↄ do ũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dã buiↄ aaↄ dɛ lán mlɛ̃ pↄ́ kú zɛ́ lɛ́wa,","poem":1},{"lineBreak":true},{"text":"lán sↄ̀gbalawa zɛ́wɛwɛna saɛ.","poem":1},{"lineBreak":true},{"text":"Aa sↄ̃́ só a koewa,","poem":1},{"lineBreak":true},{"text":"sↄ̃de i bↄlɛlɛ kpaanla.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii, ma wɛ́ dↄnzi ǹ ma suaba.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gada buiↄ sↄ̃, zĩgↄ̃ↄ ãnamá,","poem":1},{"lineBreak":true},{"text":"kási aali pɛ́lɛńziɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Asɛɛ buiↄ blɛá blɛ nísideɛ,","poem":1},{"lineBreak":true},{"text":"blɛ pↄ́ dɛ kía blɛ maa ũ ↄ̃ aali kɛ ń bùsuu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nɛfatali buiↄ dɛ lán banawa sɛ̃u,","poem":1},{"lineBreak":true},{"text":"aa nɛ́ kɛfɛnaↄ i.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yosɛfu buiↄ dɛ lán lí nɛ'ina pↄ́ kú nibↄna saɛwa,","poem":1},{"lineBreak":true},{"text":"aà gↄ̃naↄ fɛlɛ da gĩa fↄ̀ↄↄ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kàzunaↄ íbɛlɛsɛńnↄ,","poem":1},{"lineBreak":true},{"text":"aa ń yá ń kao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aaↄ ń sá kũa deesai","poem":1},{"lineBreak":true},{"text":"Yakↄbu Lua Gbãade sabai,","poem":1},{"lineBreak":true},{"text":"an ↄ gbãa mɛ́ a gↄ̃i vĩ","poem":1},{"lineBreak":true},{"text":"Isailiↄ Gbɛ pↄ́ ì dↄaanɛ́ yã́i.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N mae Luapi mɛ́ a dↄnlɛ,","poem":1},{"lineBreak":true},{"text":"Gbãapiidepi mɛ́ a báaadangu","poem":1},{"lineBreak":true},{"text":"ń lou'i pↄ́ ì bↄ musuo,","poem":1},{"lineBreak":true},{"text":"ń ɛ̀fãai pↄ́ kálɛa tↄↄlɛ zíɛo.","poem":1},{"lineBreak":true},{"text":"N nↄↄ ń n pↄ́ↄ aaↄ dɛ nɛadeↄ ũɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sa'olɛ pↄ́ n mae n gba","poem":1},{"lineBreak":true},{"text":"zↄ̃ↄ dɛ ma deziↄ pↄ́a,","poem":1},{"lineBreak":true},{"text":"a zↄ̃ↄ dɛ gbɛ̀sĩsĩ ziↄla.","poem":1},{"lineBreak":true},{"text":"Lua to pↄmaaↄ su Yosɛfu miwa,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃mɛ bɛɛɛ vĩ a gbɛ̃́ↄ guu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bɛ̃yãmɛɛ buiↄ aaↄ dɛ","poem":1},{"lineBreak":true},{"text":"lán àwalɛwan pãsĩwa,","poem":1},{"lineBreak":true},{"text":"aa lɛ́lɛ gbɛ̃́ↄwa kↄↄ,","poem":1},{"lineBreak":true},{"text":"aai ń pↄ́ↄ naaa oosi.","poem":1}]},{"type":"verse","number":28,"content":["Isaili bui mɛ̀n kuɛplaↄn we píi. Sa'olɛ pↄ́ an mae ń gbán we, baade ń a pↄ́o."]},{"type":"heading","content":["Yakↄbu gaa ń aà vĩao"]},{"type":"verse","number":29,"content":["Ɔ̃ a ònɛ́: Tó ma ã́nuatò, à ma vĩ ma deziↄ gbɛ̀'ɛ pↄ́ kú Iti bui Ɛfↄ̃nↄ bua guu."]},{"type":"verse","number":30,"content":["Gbɛ̀'ɛpi ku Mapelaɛ, Mamale gukpɛ oi Kanaa bùsuu, bua pↄ́ Ablahaũ lù Iti bui Ɛfↄ̃nↄwa gɛvĩkĩi ũ.",{"noteId":158}]},{"type":"verse","number":31,"content":["We wà Ablahaũ vĩ̀u ń a na Salao.",{"noteId":159},"We wà Izaaki vĩ̀u ń a na Lɛbɛkao.",{"noteId":160},"We ma Lea vĩ̀u."]},{"type":"verse","number":32,"content":["Wà búpi ń a gbɛ̀'ɛo lù Itiↄwaɛ."]},{"type":"verse","number":33,"content":["Kɛ́ Yakↄbu lɛ́pi dìlɛ a nɛ́ↄnɛ a làa, à ɛ̀a wùlɛ, ↄ̃ à gà."]}],"footnotes":[{"noteId":154,"caller":"+","text":"49.4 Daa 35.22","reference":{"chapter":49,"verse":4}},{"noteId":155,"caller":"+","text":"49.6 Daa 34.25","reference":{"chapter":49,"verse":6}},{"noteId":156,"caller":"+","text":"49.9 Zia 5.5","reference":{"chapter":49,"verse":9}},{"noteId":157,"caller":"+","text":"49.9 Nao 24.9","reference":{"chapter":49,"verse":9}},{"noteId":158,"caller":"+","text":"49.30 Daa 23.16-17","reference":{"chapter":49,"verse":30}},{"noteId":159,"caller":"+","text":"49.31 Daa 25.10","reference":{"chapter":49,"verse":31}},{"noteId":160,"caller":"+","text":"49.31 Daa 35.29","reference":{"chapter":49,"verse":31}}]},"thisChapterLink":"/api/bqc_sim/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}