{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HAB","translationId":"bqc_sim","name":"Abaku","commonName":"Abaku","title":"ABAKU","order":35,"numberOfChapters":3,"sha256":"a7492fad9b830dd5c5087b74d898dbbbb12937833ecce9e69e364d5c12d33984","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"heading","content":["Abaku Lua tàae'ea"]},{"type":"verse","number":1,"content":[{"text":"Yã́ pↄ́ ãnabi Abaku èn kɛ:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Málɛ wiilɛma à gɛ̃̀gɛ̃,","poem":1},{"lineBreak":true},{"text":"ńlɛ yãmaao, Dii.","poem":1},{"lineBreak":true},{"text":"Málɛ lɛzunzi yãpãsĩ yã́iɛ,","poem":1},{"lineBreak":true},{"text":"ńlɛ wá suabao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ni to mà vãikɛa ei?","poem":1},{"lineBreak":true},{"text":"Àkɛa niↄ dàakɛa gwai?","poem":1},{"lineBreak":true},{"text":"Kaalɛ ń yãpãsĩↄ ku ma aɛ,","poem":1},{"lineBreak":true},{"text":"sòle ń yãkeleo fɛ̀lɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bee yã́i ikoyã gↄ̃̀ plɛ̀gɛlɛgɛ,","poem":1},{"lineBreak":true},{"text":"wìli zĩkɛ yã́zɛdewao.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃vãiↄ ì koezↄ̃ gbɛ̃maaↄzi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wì yã́zɛde fuangba.","poem":1}]},{"type":"heading","content":["Dii yã́zãsia Abakuwa"]},{"type":"verse","number":5,"content":[{"text":"À buiↄ gwa à gwa, yã́ i diwá,","poem":1},{"lineBreak":true},{"text":"asa málɛ yãkɛ á gↄↄɛ,","poem":1},{"lineBreak":true},{"text":"tó wa sìuɛ́, á sio.","poem":1},{"noteId":0}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À gwa! Málɛ tɛ́kpa Kaladeↄgu.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Bui pãsĩ nↄnwãadepiↄ lɛ́ li dṹniaa píi,","poem":1},{"lineBreak":true},{"text":"aalɛ zↄ̃lɛkĩi pↄ́ dɛ ń pↄ́ ũoↄ símá.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì to vĩa ń kṹ,","poem":1},{"lineBreak":true},{"text":"sↄ̃ ì kɛ̃ gbɛ̃́ↄgu.","poem":1},{"lineBreak":true},{"text":"Aali ikoyãdao,","poem":1},{"lineBreak":true},{"text":"aaì ńzĩa sɛ lɛsĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"An sↄ̃́ↄ wãa dɛ gbɛaanaa,","poem":1},{"lineBreak":true},{"text":"an pãsĩ dɛ àwalɛwan oosiɛlɛa.","poem":1},{"lineBreak":true},{"text":"An sↄ̃deↄ bↄ̀ bùsu zã̀zãu,","poem":1},{"lineBreak":true},{"text":"an sↄ̃́ↄ lɛ́ bàalɛ bìooo,","poem":1},{"lineBreak":true},{"text":"aaì kúu'o su pↄ́ lɛ́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampii aaì zɛ ń pãsĩo,","poem":1},{"lineBreak":true},{"text":"aaì su sãnusãnu lán guwaiwai ĩ́anawa,","poem":1},{"lineBreak":true},{"text":"aaì zĩ̀zↄↄ naaa lán bùsu'ũfãawa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aaì kíaↄ kɛ pↄ́ↄpↄↄ,","poem":1},{"lineBreak":true},{"text":"aaì gbãadeↄ yáalↄ,","poem":1},{"lineBreak":true},{"text":"aaì wɛ̃́lɛ bĩ́ideↄ àlafiikɛ,","poem":1},{"lineBreak":true},{"text":"aaì bùsu kãaa bĩ́izi aa sí.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì gɛ̃ gɛ́ aɛ lán ĩ́anawa.","poem":1},{"lineBreak":true},{"text":"Tàaedeↄnɛ, an gbãa mɛ́ ń lua ũ.","poem":1}]},{"type":"heading","content":["Abaku ɛa Lua tàae'ea"]},{"type":"verse","number":12,"content":[{"text":"Dii, ń kú za káaukaauɛ,","poem":1},{"lineBreak":true},{"text":"ma Lua pↄ́ n kua adoa, wá gao.","poem":1},{"lineBreak":true},{"text":"Dii, n buipi dìlɛ yã́kpalɛkɛawanↄ yã́iɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛsi, n buipi zɛ̀dↄ wá totoa yã́iɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N kua adoa, n gɛ̃ wɛsia vãilɛa,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ fↄ̃ yãvãikɛa gwao.","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi niↄ bↄnkpɛdeↄ gwa ń wɛ́oi?","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃vãiↄ lɛ́ gbɛ̃maaↄ mↄmↄ,","poem":1},{"lineBreak":true},{"text":"bↄ́yãi niↄ nílɛi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N gbɛ̃nazĩna kɛ̀ lán ísia kpↄↄwa,","poem":1},{"lineBreak":true},{"text":"lán pↄ́ kelena pↄ́ aa kía vĩoↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ibɛɛↄ ì ń kṹ ń kokoao,","poem":1},{"lineBreak":true},{"text":"aaì ń gá ń bↄ.","poem":1},{"lineBreak":true},{"text":"Aaì ń kṹ ń sↄo,","poem":1},{"lineBreak":true},{"text":"aaì ń naaa ń ń táaluo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì pↄnakɛ, aaìↄ yáalↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yã́i tò aaì ɛsɛkɛ táaluwa,","poem":1},{"lineBreak":true},{"text":"aaì tulaletikatɛa sↄɛ,","poem":1},{"lineBreak":true},{"text":"asa beeↄ mɛ́ tò aa ku nama guu,","poem":1},{"lineBreak":true},{"text":"aaì pↄ́ níside ble.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aaↄ kpↄ bↄlɛ ń táaluu gↄↄpii yã̀?","poem":1},{"lineBreak":true},{"text":"Aaↄ buiↄ dɛdɛ ń wɛgwasai láasai yã̀?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.5 Zĩn 13.41","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1.6 2Kia 24.2","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}