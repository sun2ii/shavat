"poem":1},{"lineBreak":true},{"text":"we aà gbãa ulɛau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gagyã bɛ aà aɛ,","poem":1},{"lineBreak":true},{"text":"tɛ́lɛpiↄ bɛ aà iau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó à zɛ̀, dṹnia ì zãampapa,","poem":1},{"lineBreak":true},{"text":"tó à wɛtɛ̀i, buiↄ ì kɛ gã̀sĩ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̀sĩsĩ ziↄ kwɛ̀,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩ pↄ́ kú za káauↄ gbòo.","poem":1},{"lineBreak":true},{"text":"Ì yãkɛ lá a kɛ̀ káaukaauwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma Kusã zwã̀akpɛↄ è,","poem":1},{"lineBreak":true},{"text":"wàlɛ taasikɛu,","poem":1},{"lineBreak":true},{"text":"ma Madiã bùsu zwã̀akpɛↄ è,","poem":1},{"lineBreak":true},{"text":"gili gɛ̃̀ńgu we.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, n pↄ pà swaↄzi yã̀?","poem":1},{"lineBreak":true},{"text":"N za fɛ̃̀ swa'ↄnaↄzi nɛe?","poem":1},{"lineBreak":true},{"text":"Kɛ́ ń di n sↄ̃́ↄ kpɛ ń n zĩblesↄ̃goↄ,","poem":1},{"lineBreak":true},{"text":"n mɛ fɛ̃̀ ísiazi yã̀?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N n sá bↄ̀ a bↄ̀ↄu,","poem":1},{"lineBreak":true},{"text":"n mɛ̀ wà mↄ́ ń kaↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n dṹnia pàapaa ń swaↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ n e, aalɛ kↄ̃dɛ,","poem":1},{"lineBreak":true},{"text":"í dàgua, àlɛ gɛ̃,","poem":1},{"lineBreak":true},{"text":"ísi kↄ̃fĩ dↄ,","poem":1},{"lineBreak":true},{"text":"a ikooaↄ lɛ́ fɛlɛ musu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĩatɛ̃ ń mↄvuao zɛ̀ gudoũ musumusu","poem":1},{"lineBreak":true},{"text":"n ka pↄ́ lɛ́ gɛ̃ fìoo tɛkɛa yã́i","poem":1},{"lineBreak":true},{"text":"ń n sↄ̃na pípia yã́o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńlɛ tavaavaa'o dṹniau ń pↄkũmao,","poem":1},{"lineBreak":true},{"text":"ńlɛ buiↄ gbɛ̃ ń kyã̀wãao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N bↄ n mↄ n gbɛ̃́ↄ boi,","poem":1},{"lineBreak":true},{"text":"n mↄ kía pↄ́ ń kpà suabai.","poem":1},{"lineBreak":true},{"text":"N gbɛ̃vãi mi wì,","poem":1},{"lineBreak":true},{"text":"n pↄ́ pìliwà à gↄ̃̀ láilai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɛ́ aà zĩgↄ̃ↄ sìwázi wá fãaai,","poem":1},{"lineBreak":true},{"text":"aalɛ pↄnakɛ yɛ̃̀ɛɛsaide pↄ́ ulɛaↄ blea yã́ musu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n ń dↄaana mi fↄ̃̀ ń azĩa sↄ̃nao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N ↄ̃zↄ̃̀ ísiawa ń n sↄ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"n í zↄ̃ↄpi yà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kɛ́ ma a baomà, sↄ̃ kɛ̃̀magu,","poem":1},{"lineBreak":true},{"text":"a kↄ̃fĩ ma lɛ́baa dèe, ma wá gà,","poem":1},{"lineBreak":true},{"text":"málɛ lualua ma zɛgbɛu.","poem":1},{"lineBreak":true},{"text":"Má mɛna màↄ gↄↄ pↄ́ wa yã́yia gbɛ̃́ pↄ́ lɛ̀lɛwáↄwa dã́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Baa tó kaadↄɛna i nɛsoe kɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ vɛ̃ɛliↄ i nɛ'io,","poem":1},{"lineBreak":true},{"text":"baa tó ku i bↄo,","poem":1},{"lineBreak":true},{"text":"mɛ́ buapↄ́ↄ i kɛo,","poem":1},{"lineBreak":true},{"text":"baa tó sãↄ ku kaau lↄo,","poem":1},{"lineBreak":true},{"text":"mɛ́ zuↄ làa kpàsau,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ń beeo ma pↄ aↄ na Diiwaɛ,","poem":1},{"lineBreak":true},{"text":"má pↄnakɛ ń Lua ma Suabanao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii Lua mɛ́ ma gbãa ũ,","poem":1},{"lineBreak":true},{"text":"ì ma wá nakṹ lán tuewa,","poem":1},{"noteId":4},{"lineBreak":true},{"text":"ì to màↄ bɛ gulɛsĩↄwa.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"3.19 2Sam 22.34, Soũ 18.33","reference":{"chapter":3,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}