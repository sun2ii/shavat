{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HEB","translationId":"bqc_sim","name":"Ɛbɛluↄ","commonName":"Ɛbɛluↄ","title":"ƐBƐLUƆ","order":58,"numberOfChapters":13,"sha256":"f79fd7273a0f5ae4bca31bd2669043e0853dd2b11d6e03d5d95ec1acbbcaf79f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bqc_sim/HEB/13.json","totalNumberOfVerses":300},"chapter":{"number":1,"content":[{"type":"heading","content":["Lua Nɛ́ dɛ malaikaↄla"]},{"type":"verse","number":1,"content":["Lua dↄ̀aa ãnabiↄnɛ yãa dodo dasi, ↄ̃ aa yã́zɛ ò wá deziↄnɛ dasi,"]},{"type":"verse","number":2,"content":["ãma aà Nɛ́ mɛ́ yã'òwɛ̃ɛ gↄↄ gbɛzãɛ beeↄ zĩ́ sa. Nɛ́pi sabai ↄ̃ Lua dṹnia kɛ̀, a dìlɛ ↄ̃mɛ a gↄ̃ pↄ́pii vĩ."]},{"type":"verse","number":3,"content":["Ɔ̃mɛ Lua gawi tɛkɛa ũ, aà kua ũ zálala. Ɔ̃mɛ pↄ́pii kũa ń a yã'oa gbãao. Gbɛ̃́ↄ duunawoloa gbɛa à gɛ̀ zↄ̃̀lɛ musu Zↄ̃ↄde ↄplaai."]},{"type":"verse","number":4,"content":["Lá tↄ́ pↄ́ a blè gbia dɛ malaikaↄ pↄ́a, màa aà zↄ̃ↄ dɛńla lↄ."]},{"type":"verse","number":5,"content":["Lua yã́ɛ bee ò malaikaeɛ yãae?",{"text":"Ma Nɛ́n n ũ, n Maen ma ũ gbã,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"ge mámɛ máↄ dɛ aà Mae ũ,","poem":1},{"lineBreak":true},{"text":"aàpi iↄ dɛ ma Nɛ́ ũ.","poem":1},{"noteId":1}]},{"type":"verse","number":6,"content":["Kɛ́ Lua tò a yoa mↄ̀ dṹnia guu, à mɛ̀ a malaikaↄ kúlɛɛ̀ píi."]},{"type":"verse","number":7,"content":["Malaikaↄ yã́ musu à mɛ̀,",{"text":"i a ìwaↄ li ĩ́ana ũ,","poem":1},{"lineBreak":true},{"text":"i a zĩkɛnapiↄ li tɛ́vua ũ.","poem":1},{"noteId":2}]},{"type":"verse","number":8,"content":["Aà Nɛ́ yã́ musu sↄ̃, à mɛ̀:",{"text":"Lua, ńyↄ̃ↄ zↄ̃lɛa báawa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"niↄ n kíakɛ lípana kũa yã́zɛde ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ń ye maakɛai, ń za vãikɛau.","poem":1},{"lineBreak":true},{"text":"A yã́i tò Lua, n Lua, n kpa kpalau,","poem":1},{"lineBreak":true},{"text":"à pↄna pìsima dɛ n gbɛ̃́ↄla.","poem":1},{"noteId":3}]},{"type":"verse","number":10,"content":["Wa ò lↄ:",{"text":"Dii, n tↄↄlɛ kàlɛ asĩnizĩ,","poem":1},{"lineBreak":true},{"text":"musuá n ↄzĩkɛaɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampii aa gɛ̃, kási ńyↄ̃ↄ kuɛ.","poem":1},{"lineBreak":true},{"text":"Aa zikũ lán pↄkasawa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ní ń koo lán pɛwa,","poem":1},{"lineBreak":true},{"text":"ní ń lilɛ lán pↄkasawa.","poem":1},{"lineBreak":true},{"text":"Mpi sↄ̃ ńyↄ̃ↄ doũ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"n gↄↄ láaa vĩo.","poem":1},{"noteId":4}]},{"type":"verse","number":13,"content":["À yã́ɛ bee ò malaikaeɛ yãae?",{"text":"Zↄ̃lɛ ma ↄplaai","poem":1},{"lineBreak":true},{"text":"e màↄ n ibɛɛↄ kɛnɛ n gbadibↄ ũ.","poem":1},{"noteId":5}]},{"type":"verse","number":14,"content":["Malaikaↄá zĩkɛnaↄnɛ ḿpii, nisĩna pↄ́ Lua ì ń zĩ dↄi gbɛ̃́ pↄ́ aa bↄ ziaↄlɛɛ."]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.5 Soũ 2.7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1.5 2Sam 7.14","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"1.7 Soũ 104.4","reference":{"chapter":1,"verse":7}},{"noteId":3,"caller":"+","text":"1.9 Soũ 45.7-8","reference":{"chapter":1,"verse":9}},{"noteId":4,"caller":"+","text":"1.12 Soũ 102.25-27","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"+","text":"1.13 Soũ 110.1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}