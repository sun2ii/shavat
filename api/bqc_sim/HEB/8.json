{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HEB","translationId":"bqc_sim","name":"Ɛbɛluↄ","commonName":"Ɛbɛluↄ","title":"ƐBƐLUƆ","order":58,"numberOfChapters":13,"sha256":"f79fd7273a0f5ae4bca31bd2669043e0853dd2b11d6e03d5d95ec1acbbcaf79f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bqc_sim/HEB/13.json","totalNumberOfVerses":300},"chapter":{"number":8,"content":[{"type":"heading","content":["Yesu mɛ́ wá Sa'onkia ũ"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ wálɛ o min kɛ: Wá sa'onkia bee taa vĩ zↄ̃lɛa báawa musu Lua Zↄ̃ↄde ↄplaai.",{"noteId":31}]},{"type":"verse","number":2,"content":["Ì zĩkɛ luakukĩi zwã̀akpɛ sĩana pↄ́ Dii dↄ̀u, i kɛ pↄ́ pↄ́ gbɛ̃nazĩnaↄ dↄ̀ no."]},{"type":"verse","number":3,"content":["Lá mↄa ń gbaↄ ń sa'oao yã́i wì sa'onkia píi kpái, a maa aàpi aàↄ pↄ́ vĩ à kpa sↄ̃ɛ."]},{"type":"verse","number":4,"content":["Tó a ku dṹniau, àↄ dɛ sa'ona ũo, asa sa'ona pↄ́ aaì mↄ́ ń gbaↄ lá ikoyã dìlɛwaↄ ku kↄ̀."]},{"type":"verse","number":5,"content":["Zĩ pↄ́ aalɛ kɛá pↄ́ pↄ́ kú musu taaɛ, a zↄzↄnaɛ. A yã́i tò, kɛ́ Mↄizi ye zwã̀akpɛ dↄ, Lua òɛ̀ aà pↄ́ pↄ́ a a taa kɛ̀ɛ̀ gbɛ musu kɛ màa píi.",{"noteId":32}]},{"type":"verse","number":6,"content":["Yesuá Lua bàakuawanↄ kↄ́ↄɛ. Lá Lua bàakuawanↄpi gbia dɛ aà bàa kua ń gbɛ̃́ↄ káaua, zĩ pↄ́ wa dàɛ̀ gbia dɛ sa'onkiapiↄ pↄ́a. Lua bàakuawanↄpi lɛgbɛ̃a dɛ a zia lↄ."]},{"type":"verse","number":7,"content":["Tó Luabaakuańnↄ káaupi papaa yãaɛ, a plaade a zɛkɛo."]},{"type":"verse","number":8,"content":["Kɛ́ Dii Isailiↄ tàae è, à mɛ̀:",{"text":"A gↄↄ lɛ́ mↄ́ kɛ́ má yã́ dafu dilɛ","poem":1},{"lineBreak":true},{"text":"ma bàa kua ń Isailiↄ ń Yudaↄ musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aↄ dɛ lán yã́ pↄ́ má dìlɛ an deziↄnɛ","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ ma ń kṹ ń ↄwa ma ń bↄ́lɛ Egipiwao.","poem":1},{"lineBreak":true},{"text":"Asa aai zɛ ń yã́ pↄ́ má dìlɛnɛ́oo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma ń tó we.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma bàa kua ń Isailiↄ gↄↄ beeↄ gbɛa yã́n kɛ:","poem":1},{"lineBreak":true},{"text":"Má a ikoyãↄ danɛ́ ń nↄ̀sɛ guu,","poem":1},{"lineBreak":true},{"text":"má kɛ̃́ ń sↄ̃wa.","poem":1},{"lineBreak":true},{"text":"Máↄ dɛ ń Lua ũ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dɛ ma gbɛ̃́ↄ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"An gbɛ̃e a yãdada a deeɛo,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e a ma dↄ̃a da a gbɛ̃́ɛo,","poem":1},{"lineBreak":true},{"text":"asa ampii aaↄ ma dↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ píi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má sùuukɛńnↄ ń ń tàaeↄ,","poem":1},{"lineBreak":true},{"text":"má ń duuna yãda lↄo.","poem":1},{"noteId":33}]},{"type":"verse","number":13,"content":["Kɛ́ Lua yã́ dafupi ò, à a káau zibòɛ. Pↄ́ pↄ́ zikũ̀ a í kↄ̀lɛ, a kpaa gui zã̀o."]}],"footnotes":[{"noteId":31,"caller":"+","text":"8.1 Zĩn 2.32-33","reference":{"chapter":8,"verse":1}},{"noteId":32,"caller":"+","text":"8.5 Bↄa 25.40","reference":{"chapter":8,"verse":5}},{"noteId":33,"caller":"+","text":"8.12 Zel 31.31-34","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}