{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":1,"content":[{"type":"heading","content":["Ozee nↄ ń a nɛ́ↄ"]},{"type":"verse","number":1,"content":["Yudaↄ kíaↄ Uzia",{"noteId":0},"ń Yotaũo",{"noteId":1},"ń Aazao",{"noteId":2},"ń Ezekiao",{"noteId":3},"ń Yehoasi nɛ́ Yeloboaũ",{"noteId":4},"Isailiↄ kíao kpalablegↄↄ, Dii yã'ò Beeli nɛ́ Ozeewɛ."]},{"type":"verse","number":2,"content":["Kɛ́ Dii nà yã'oa Ozeeɛwa, a òɛ̀: Gɛ ǹ nↄɛ dↄ́ɛ'ĩide sɛ nↄ ũ, ní gĩnasↄↄnɛↄ si lↄ, asa bùsuɛbeedeↄ ma to we, aalɛ gbãsĩkɛ maamaaɛ."]},{"type":"verse","number":3,"content":["Ɔ̃ à gɛ̀ Diblaiũ nɛ́ Gomɛɛ sɛ̀ nↄ ũ. Ɔ̃ à nↄsìaànↄ, à nɛ'ì gↄ̃ɛ ũ."]},{"type":"verse","number":4,"content":["Dii ò Ozeeɛ: Tↄ́kpaɛ̀ Yezɛlɛɛ, asa má tó gbɛ̃́ pↄ́ wà ń dɛdɛ Yezɛlɛɛↄ",{"noteId":5},"yã́ wí Yehu bɛdeↄ musuɛ tia, mí Isailiↄ kpala midɛ."]},{"type":"verse","number":5,"content":["Gↄↄ bee má Isailiↄ sá ɛ́'ɛ Yezɛlɛɛ guzulɛu."]},{"type":"verse","number":6,"content":["Gomɛɛ nↄsì lↄ, à nɛ'ì nↄɛ ũ, ↄ̃ Dii ò Ozeeɛ: Tↄ́kpaɛ̀ Wɛ́gwaakuo, asa má Isailiↄ wɛgwa lↄo, má sùuukɛńnↄ lↄo."]},{"type":"verse","number":7,"content":["Ãma má Yudaↄ wɛgwa, mí ń suaba. Ma Dii an Lua, mámɛ má ń suaba, i kɛ ń sáo ge ń fɛ̃ndao ge ń zĩo ge ń sↄ̃́ↄ ge ń sↄ̃deↄ no."]},{"type":"verse","number":8,"content":["Kɛ́ à Wɛ́gwaakuo kɛ̃̀ yↄ̃́wa, à nɛ'ì gↄ̃ɛ ũ lↄ."]},{"type":"verse","number":9,"content":["Dii mɛ̀: Tↄ́kpaɛ̀ Magbɛ̃ↄno, asa á dɛ ma gbɛ̃́ↄ ũo mɛ́ má dɛ á Lua ũo."]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 2Kia 14.21","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.1 2Kia 15.32","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"1.1 2Kia 16.1","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"1.1 2Kia 18.1","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"1.1 2Kia 14.23","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"+","text":"1.4 2Kia 10.11","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/HOS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/DAN/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}