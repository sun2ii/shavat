{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"heading","content":["Isailiↄ kpala midɛa"]},{"type":"verse","number":1,"content":["Isailiↄá vɛ̃ɛli ↄtaaɛ yãa,",{"text":"aaì nɛ'i ńzĩaɛ.","poem":1},{"lineBreak":true},{"text":"Lá an nɛ́piↄ kↄ̃̀,","poem":1},{"lineBreak":true},{"text":"màa an sa'okĩiↄ kↄ̃̀.","poem":1},{"lineBreak":true},{"text":"Lá an bùsu maakũ̀,","poem":1},{"lineBreak":true},{"text":"màa aa zãblè ń gbɛ̀ tã́aↄwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mↄafili ń sↄ̃ pà,","poem":1},{"lineBreak":true},{"text":"an tàae a wi ń musuɛ sa.","poem":1},{"lineBreak":true},{"text":"Dii a ń sa'okĩipiↄ gbooɛ,","poem":1},{"lineBreak":true},{"text":"í ń gbɛ̀ tã́apiↄ wíwi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"aai gbasa mɛ: Wá kía vĩo,","poem":1},{"lineBreak":true},{"text":"kɛ́ wá Dii vĩa vĩo yã́i.","poem":1},{"lineBreak":true},{"text":"Baa tó wá kía vĩ,","poem":1},{"lineBreak":true},{"text":"bↄ́ a fↄ̃ wowɛ̃ɛi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì lɛ́ pãↄ gbɛ̃gbɛ̃,","poem":1},{"lineBreak":true},{"text":"aaì ɛɛↄ tóto,","poem":1},{"lineBreak":true},{"text":"aaì lɛdoũↄ kɛkɛńnↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ kↄ̃ káalakɛa ì ligua","poem":1},{"lineBreak":true},{"text":"lán sàpaa dafu kàe nɛ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Samalideↄ mɛ a lua Bɛtavɛ̃ gáae yã́i,","poem":1},{"lineBreak":true},{"text":"wa ↄ́ↄlↄɛ̀, a sa'onaↄ i búbuapɛ.","poem":1},{"lineBreak":true},{"text":"A gawi a midɛ,","poem":1},{"lineBreak":true},{"text":"asa wa símá wà taòɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wa sɛ taò Asili bùsuu falu ũ an kía zↄ̃ↄɛɛ.","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gɛɛ a gↄ̃ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"wí a Isailiↄ kṹ zɛ́ pↄ́ aa sɛ yã́i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Samali bùsu a midɛ,","poem":1},{"lineBreak":true},{"text":"a kía a gɛ̃zɛa","poem":1},{"lineBreak":true},{"text":"lán lí miↄna pↄ́ í lɛ́ sɛ́wa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gulɛsĩ pↄ́ wa bò tã́aↄnɛↄ bãdɛ,","poem":1},{"lineBreak":true},{"text":"asa a dɛ Isailiↄ duuna ũɛ.","poem":1},{"lineBreak":true},{"text":"Lɛↄ ń lá ṹadeↄ fɛlɛ da ń sa'okĩipiↄla,","poem":1},{"lineBreak":true},{"text":"aai o gbɛsiↄnɛ aa lɛ́lɛ simá,","poem":1},{"lineBreak":true},{"text":"aai o sĩ̀sĩↄnɛ aa kúńla.","poem":1},{"noteId":13}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Za gↄↄ pↄ́ Isailiↄ duunakɛ̀ Gibɛa, aa zɛ̀òɛ.","poem":1},{"lineBreak":true},{"text":"Zĩ a yãbɛ̃ɛkɛnapiↄ le Gibɛao lé?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ má yei, má ń swã́gagaɛ,","poem":1},{"lineBreak":true},{"text":"buipãleↄ i mↄ kãaańzi,","poem":1},{"lineBreak":true},{"text":"aai mↄkamá ń duuna lɛɛ pla yã́i.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄá zununuɛ,","poem":1},{"lineBreak":true},{"text":"wà zĩdàɛ̀, a ye ésegbɛ̃ai.","poem":1},{"lineBreak":true},{"text":"Má zuudanɛ́ ń nↄɛ maaɛ,","poem":1},{"lineBreak":true},{"text":"mí tó aa soona gálɛ.","poem":1},{"lineBreak":true},{"text":"Yudaↄ i sapa,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ i gudaaĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À maa tↄ̃́, í kɛkɛ gbɛ̃kɛ ũ.","poem":1},{"lineBreak":true},{"text":"À kpase kɛ̃ wásawasa,","poem":1},{"noteId":14},{"lineBreak":true},{"text":"asa Dii kĩ́i wɛɛlɛa gↄↄ kàɛ,","poem":1},{"lineBreak":true},{"text":"e aàↄ mↄ ɛ̀fãaiↄ pisiiwá.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A vãi tↄ̃̀ á kɛ̀kɛ yãbɛ̃ɛ ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a blɛ mↄafilidepi blè.","poem":1},{"lineBreak":true},{"text":"Kɛ́ a ázĩa gbãa náaikɛ̀,","poem":1},{"lineBreak":true},{"text":"mɛ́ a zɛ ń á zĩgↄ̃ dasiↄ yã́i,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"wa zĩ̀ zↄadↄwá,","poem":1},{"lineBreak":true},{"text":"wa á wɛ̃́lɛ bĩ́ideↄ dúuzↄ̃,","poem":1},{"lineBreak":true},{"text":"lá kí Samana Bɛtaabɛ kàalɛ","poem":1},{"lineBreak":true},{"text":"à nↄɛↄ ń ń nɛ́ↄ wìwi zĩkagↄↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Màa wa kɛɛ́ Bɛtɛlideↄ,","poem":1},{"lineBreak":true},{"text":"asa á vãikɛa kɛ̀ zàiɛ.","poem":1},{"lineBreak":true},{"text":"Tó gu dↄ̀, Isailiↄ kía aↄ ku lↄo.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"10.8 Luk 23.30, Zia 6.16","reference":{"chapter":10,"verse":8}},{"noteId":14,"caller":"+","text":"10.12 Zel 4.3","reference":{"chapter":10,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}