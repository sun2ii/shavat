má.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lá aa gì nↄ̀sɛlilɛi,","poem":1},{"lineBreak":true},{"text":"aa ɛa ta Egipio lé?","poem":1},{"lineBreak":true},{"text":"Asiliↄ mɛ́ aaↄ kiblemá.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fɛ̃nda a tɛkɛ an wɛ̃́lɛↄ guu,","poem":1},{"lineBreak":true},{"text":"wa ń bↄlɛ gbã́aↄ wíwi.","poem":1},{"lineBreak":true},{"text":"Wa ń lɛkpaaĩ gboo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"asa ma gbɛ̃́piↄ bↄ̀ ma kpɛ.","poem":1},{"lineBreak":true},{"text":"Baa tó aalɛ lɛzumazi,","poem":1},{"lineBreak":true},{"text":"ma Musude, má ń gba gbãao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń beeo á Ɛflaiũ buiↄ,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ ↄkpaázio,","poem":1},{"lineBreak":true},{"text":"á Isailiↄ, má fↄ̃ mà á kpámáo.","poem":1},{"lineBreak":true},{"text":"Má fↄ̃ mà kɛɛ́ lá má kɛ̀ Adamaɛwao,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ mà á baa daaa ń Zeboiũoo.","poem":1},{"noteId":16},{"lineBreak":true},{"text":"Ma nↄ̀sɛlìlɛ á yã́ musu,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃nadↄ̃aɛ́ fɛ̀lɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má ɛa Ɛflaiũ buiↄ ásookɛ lↄo,","poem":1},{"lineBreak":true},{"text":"má pↄkũma pãsĩ bↄbↄmáo,","poem":1},{"lineBreak":true},{"text":"asa Luan ma ũ,","poem":1},{"lineBreak":true},{"text":"i kɛ gbɛ̃nazĩnan ma ũo.","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ a kua adoan ma ũ á guu,","poem":1},{"lineBreak":true},{"text":"má mↄ́ á kaalɛio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Má pala lán nↄ̀ↄmusuwa,","poem":1},{"lineBreak":true},{"text":"aai tɛmazi.","poem":1},{"lineBreak":true},{"text":"Tó ma pala,","poem":1},{"lineBreak":true},{"text":"ma nɛ́piↄ bↄ bɛ'aɛ oi,","poem":1},{"lineBreak":true},{"text":"aai mↄ ma kĩ́i ń lualuao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa bↄ Egipi ń lualuao lán bãↄwa.","poem":1},{"lineBreak":true},{"text":"Aa bↄ Asili bùsuu lán felenaↄwa,","poem":1},{"lineBreak":true},{"text":"mí ń kálɛ ń bɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"11.1 Bↄa 4.22, Mat 2.15","reference":{"chapter":11,"verse":1}},{"noteId":16,"caller":"+","text":"11.8 Iko 29.23","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":11}