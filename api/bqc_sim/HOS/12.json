{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["Isailiↄ duunakɛa"]},{"type":"verse","number":1,"content":["Ɛflaiũ buiↄ yãlìamazi,",{"text":"Isailiↄ mↄafilikɛ̀kɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"Yudaↄ lɛ́ pãmɛɛ zɛ́a lↄ","poem":1},{"lineBreak":true},{"text":"baa ma Náaide pↄ́ ma kua adoa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ ì ĩ́ana mↄ́mↄ,","poem":1},{"lineBreak":true},{"text":"aaìↄ kpálɛkɛ ĩ́ampuui,","poem":1},{"lineBreak":true},{"text":"sã́sãyã ń yãpãsĩo ì kↄ̃́ ń guu.","poem":1},{"lineBreak":true},{"text":"Aaì kↄ̃ yãma ń Asiliↄ,","poem":1},{"lineBreak":true},{"text":"aaì gɛ́ Egipi ń nísio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii yãvĩ ń Yudaↄ,","poem":1},{"lineBreak":true},{"text":"a Yakↄbu buiↄ dàa wínɛ́ ń musu,","poem":1},{"lineBreak":true},{"text":"i fĩabonɛ́ ń yãkɛawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yakↄbu dↄ̀ a vĩ̀i gbatoewa a da nɛasakpɛu.","poem":1},{"noteId":17},{"lineBreak":true},{"text":"Kɛ́ à zↄ̃ↄkũ̀, à dɛ̃ɛkà ń Luao,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"à dɛ̃ɛkà ń aà malaikao à dɛ̃ɛnɛ̀,","poem":1},{"noteId":18},{"lineBreak":true},{"text":"à ↄ́ↄlↄ̀ à sùuugbɛ̀awà.","poem":1},{"lineBreak":true},{"text":"À kpàaũaànↄ Bɛtɛli,","poem":1},{"noteId":19},{"lineBreak":true},{"text":"ↄ̃ à yã'òaànↄ we.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aà tↄ́n Dii,","poem":1},{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃deɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ápiↄ sↄ̃, à su á Luawa,","poem":1},{"lineBreak":true},{"text":"àↄ kú ń gbɛ̃kɛo ń yãkɛa a zɛ́wao,","poem":1},{"lineBreak":true},{"text":"á wɛ́ iↄ dↄ á Luazi gↄↄpii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Laatana ìↄ kiloo vãi kũa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃blea mɛ́ ì kɛɛ̀ na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ mɛ̀: Wa kɛ ↄdeↄ ũ,","poem":1},{"lineBreak":true},{"text":"wa gↄ̃ àizɛɛdeↄ ũ.","poem":1},{"lineBreak":true},{"text":"Wá ↄdapi yã́i","poem":1},{"lineBreak":true},{"text":"wa wá yãvãi ge duuna eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mámɛmaa Dii á Lua,","poem":1},{"lineBreak":true},{"text":"ma á bↄ́lɛ Egipiɛ.","poem":1},{"lineBreak":true},{"text":"Má tó à ɛa àↄ ku zwã̀akpɛↄ guu lↄɛ,","poem":1},{"lineBreak":true},{"text":"lá i kɛ dikpɛ zĩ́wa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma yãdà ãnabiↄnɛ,","poem":1},{"lineBreak":true},{"text":"mámɛ má tò aa wɛ́punguↄ è dasi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa yã'ò gbɛ̃́ↄnɛ ń yáasio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lá Galadadeↄ zɛ̀ ń tã́a yã́o,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ pã sĩanaɛ.","poem":1},{"lineBreak":true},{"text":"Lá Giligalideↄ ì sa'o ń zuswanao,","poem":1},{"lineBreak":true},{"text":"an sa'okĩiↄ gↄ̃nɛ́ gbɛ̀zɛↄ ũ bugbɛuɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yakↄbu bàalɛ̀ gɛ̀ Sili bùsuu,","poem":1},{"lineBreak":true},{"text":"Isaili zↄblè we nↄwɛɛlɛa yã́ musu,","poem":1},{"lineBreak":true},{"text":"nↄ yã́ musu ↄ̃ à dã́dãkɛ̀.","poem":1},{"noteId":20}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii tò ãnabi bↄ̀ ń Isailiↄ Egipi,","poem":1},{"noteId":21},{"lineBreak":true},{"text":"ↄ̃ à ń dã́dãkɛ̀ ãnabipi sabai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ Dii pↄ fɛ̀lɛɛ̀ maamaaɛ.","poem":1},{"lineBreak":true},{"text":"Dii a to an gbɛ̃dɛa yã́ wí ń musuɛ,","poem":1},{"lineBreak":true},{"text":"i fĩabonɛ́ sa pↄ́ aa kàagu yã́i.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"12.4 Daa 25.26","reference":{"chapter":12,"verse":4}},{"noteId":18,"caller":"+","text":"12.5 Daa 32.24-26","reference":{"chapter":12,"verse":5}},{"noteId":19,"caller":"+","text":"12.5 Daa 28.10-22","reference":{"chapter":12,"verse":5}},{"noteId":20,"caller":"+","text":"12.13 Daa 29.1-20","reference":{"chapter":12,"verse":13}},{"noteId":21,"caller":"+","text":"12.14 Bↄa 12.50-51","reference":{"chapter":12,"verse":14}}]},"thisChapterLink":"/api/bqc_sim/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":15}