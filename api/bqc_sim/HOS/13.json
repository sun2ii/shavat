{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Dii pↄpaa a gbɛ̃́ↄzi"]},{"type":"verse","number":1,"content":["Kɛ́ Ɛflaiũ buiↄ yã'ò, wà lùalua,",{"text":"aamɛ gbãa Isailiↄ guu.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ aa tàaekɛ̀ Baali yã́ musu,","poem":1},{"lineBreak":true},{"text":"a yã́i an kpala a gai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"An duunkɛa lɛ́ dɛdɛɛ sa,","poem":1},{"lineBreak":true},{"text":"aalɛ ã́nusu kása ńzĩaɛ tã́aↄ ũ.","poem":1},{"lineBreak":true},{"text":"An ↄzĩkɛnaↄ mɛ́ lɛ́ ń diipiↄpi ń ↄ̃nↄ lɛ́u.","poem":1},{"lineBreak":true},{"text":"Wì ń yã'o wì mɛ,","poem":1},{"lineBreak":true},{"text":"aaì sa'o ń gbɛ̃nazĩnao,","poem":1},{"lineBreak":true},{"text":"aaì lɛ́pɛpɛ zugaae taaↄwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yã́i tò aa gↄ̃̀ lán suakpaa kↄↄwa,","poem":1},{"lineBreak":true},{"text":"lán kↄↄkↄↄ fíi pↄ́ ì gɛ̃zɛawa,","poem":1},{"lineBreak":true},{"text":"lán ése ṹa pↄ́ zàa ì sɛ́lɛwa,","poem":1},{"lineBreak":true},{"text":"lán súɛlɛ pↄ́ ì bↄ fɛnɛntiuwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mámɛmaa Dii á Lua pↄ́ á bↄ́lɛ Egipi.","poem":1},{"lineBreak":true},{"text":"Ásu àↄ diie dↄ̃o, ma bàasio.","poem":1},{"lineBreak":true},{"text":"Suabanae kuo, sema mapi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mámɛ ma á gwá guwaiwaiu,","poem":1},{"lineBreak":true},{"text":"ma ↄlìaázi bùsu guwãadeu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ́ ma á dã́dãkɛ̀, a kã.","poem":1},{"lineBreak":true},{"text":"Kɛ́ a kã á làa, a ázĩa sɛ̀ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma yã́ sã̀águ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Too! Má kusiwá lán nↄ̀ↄmusuwaɛ,","poem":1},{"lineBreak":true},{"text":"mí á dã́dã zɛ́u lán gbɛaanawa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má mlɛ̃wá lán wài pↄ́ wà a nɛ́ sɛ̀lɛwaɛ,","poem":1},{"lineBreak":true},{"text":"mí á kùa goaa mà á só lán nↄ̀ↄkusiwa,","poem":1},{"lineBreak":true},{"text":"má á taitai lán maiwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Á Isailiↄ, á kaalɛɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ a bↄ mapi á Dↄnlɛde kpɛ yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Á kía pↄ́ ì á suaba ku máɛ sa?","poem":1},{"lineBreak":true},{"text":"Á wɛ̃́lɛ dↄaana pↄ́ á ònɛ́","poem":1},{"lineBreak":true},{"text":"aa kía kpáɛ́ↄ","poem":1},{"noteId":22},{"text":"ku má ni?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma kía kpàɛ́ ń pↄkũmao,","poem":1},{"noteId":23},{"lineBreak":true},{"text":"ↄ̃ ma aà sìwá ń pↄfɛ̃o.","poem":1},{"noteId":24}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ yãvãiↄ dilɛa,","poem":1},{"lineBreak":true},{"text":"wà ń duuna kà láu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa dɛ lán nɛ́ sↄũwa a igↄↄ,","poem":1},{"lineBreak":true},{"text":"nↄwãwã mↄ̀, ↄ̃ nɛ́pi gì bↄi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má ń bↄ bɛda gbãaue?","poem":1},{"lineBreak":true},{"text":"Má ń sí gawae?","poem":1},{"lineBreak":true},{"text":"Ga, n sɛwɛ kúmáɛ?","poem":1},{"lineBreak":true},{"text":"Bɛda, n gbɛ̃kaalɛbↄ sↄ̃ bɛ?","poem":1},{"noteId":25},{"lineBreak":true},{"text":"Má ń wɛgwao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Baa tó Ɛflaiũ buiↄ kↄ̃̀ ń gbɛ̃́ↄ guu,","poem":1},{"lineBreak":true},{"text":"ĩ́an wãa a bↄ guwaiwaiu à sumáɛ.","poem":1},{"lineBreak":true},{"text":"Nibↄna a giigaga,","poem":1},{"lineBreak":true},{"text":"lↄ̀ↄ'i a ba,","poem":1},{"lineBreak":true},{"text":"wa lɛ́lɛ ń làasiↄwaɛ,","poem":1},{"lineBreak":true},{"text":"wi ń pↄ́ bɛɛɛdeↄ sɛ́lɛ.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"13.10 1Sam 8.5-6","reference":{"chapter":13,"verse":10}},{"noteId":23,"caller":"+","text":"13.11 1Sam 10.17-24","reference":{"chapter":13,"verse":11}},{"noteId":24,"caller":"+","text":"13.11 1Sam 15.26","reference":{"chapter":13,"verse":11}},{"noteId":25,"caller":"+","text":"13.14 1Kln 15.55","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/bqc_sim/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":15}