{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Samalideↄ tàae a wi ń musuɛ,",{"text":"asa aa bↄ̀ ń Lua kpɛɛ.","poem":1},{"lineBreak":true},{"text":"Wa ń kwɛ́ ń fɛ̃ndaoɛ,","poem":1},{"lineBreak":true},{"text":"wi ń nɛ́ↄ wíwi,","poem":1},{"lineBreak":true},{"text":"wi ń nↄsindeeↄ puipui.","poem":1}]},{"type":"heading","content":["Isailiↄ nↄ̀sɛlilɛa"]},{"type":"verse","number":2,"content":[{"text":"Á Isailiↄ, à su Dii á Luawa,","poem":1},{"lineBreak":true},{"text":"á yãvãiↄ mɛ́ tò a kpagua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À su Diiwa, í yãsiuɛ̀ à oɛ̀:","poem":1},{"lineBreak":true},{"text":"Wá yãvãiↄ kɛ̃́wá,","poem":1},{"lineBreak":true},{"text":"gbãakpawázi, wí n sáaukpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asiliↄ fↄ̃ wá bↄo,","poem":1},{"lineBreak":true},{"text":"wá di ń sↄ̃́ↄ kpɛ lↄo.","poem":1},{"lineBreak":true},{"text":"Tã́a pↄ́ wa ń píↄ","poem":1},{"lineBreak":true},{"text":"wá ń sísi wá diiↄ ũ lↄo,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ni tonɛ pↄ́ gwana vĩoↄ wɛgwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má ń gbã́gbã ń ń pↄ̀ↄbↄzãkɛgyão,","poem":1},{"lineBreak":true},{"text":"ma yeańzi a kɛ zài,","poem":1},{"lineBreak":true},{"text":"asa ma pↄ wèemá.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Máↄ dɛ Isailiↄnɛ mↄ̀sɛ ũ,","poem":1},{"lineBreak":true},{"text":"aaiↄ vukɛ,","poem":1},{"lineBreak":true},{"text":"aai zĩ́napɛlɛ lán Libã bùsu líwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa bↄlↄbↄ,","poem":1},{"lineBreak":true},{"text":"aaiↄ gawi vĩ lán kuliwa,","poem":1},{"lineBreak":true},{"text":"an gĩ iↄ na lán sɛdɛ líwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa bɛkpa ma uei,","poem":1},{"lineBreak":true},{"text":"aai bↄlɛ lán pↄ́wɛnawa.","poem":1},{"lineBreak":true},{"text":"Aa vukɛ lán vɛ̃ɛliwa,","poem":1},{"lineBreak":true},{"text":"aai tↄbↄ lán Libã bùsu vɛ̃ɛwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bↄ́ Ɛflaiũ buiↄ kɛ ń tã́aↄ lↄi?","poem":1},{"lineBreak":true},{"text":"Mámɛ má ń wabikɛa sí,","poem":1},{"lineBreak":true},{"text":"míↄ wɛ́tɛńzi.","poem":1},{"lineBreak":true},{"text":"Má dɛ lán pɛ̃li pↄ́ a lá sisiawaɛ,","poem":1},{"lineBreak":true},{"text":"an kã́fĩa a bↄ ma kĩ́iɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Démɛ ↄ̃nↄ vĩi?","poem":1},{"lineBreak":true},{"text":"Aà làasookɛ yã́piwa.","poem":1},{"lineBreak":true},{"text":"Démɛ làasoo vĩi?","poem":1},{"lineBreak":true},{"text":"Aàↄ yã́pi gbadↄ̃.","poem":1},{"lineBreak":true},{"text":"Asa Dii yãkɛaↄ maa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ ìↄ tɛi.","poem":1},{"lineBreak":true},{"text":"Aà yãmansaiↄ sↄ̃ aaì pãalɛɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}