{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ń beeo Isailiↄ aaↄ dasi lán ísialɛ ũfãawaɛ, wa fↄ̃ ń lɛ́ dↄ̃o, wa fↄ̃ ń naoo.",{"noteId":6},"Gu pↄ́ má òunɛ́ ma gbɛ̃́ↄ no, we wa ń sísiu Lua bɛ̃́ɛ nɛ́ↄ."]},{"type":"verse","number":2,"content":["Yudaↄ ń Isailiↄ kãaa ń lɛdoũo, aai dↄaana mɛ̀ndona dilɛ ń pↄ́ ũ. Aa bↄlɛ bùsu ń bùsuo, asa Yezɛlɛɛ gↄↄpi aↄ zↄ̃ↄɛ."]},{"type":"verse","number":3,"content":["À o á gbɛ̃́ↄnɛ, gↄ̃ɛ ń nↄɛo, ma gbɛ̃́ↄn ń ũ, ma ń wɛgwà."]},{"type":"heading","content":["Isailiↄ dɛa Dii nↄ gbãsĩkɛna ũ"]},{"type":"verse","number":4,"content":[{"text":"Isailiↄ, à zↄadↄ á dawa,","poem":1},{"lineBreak":true},{"text":"à zↄadↄwà,","poem":1},{"lineBreak":true},{"text":"asa ma nↄn aà ũ lↄo,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà zã́n ma ũ lↄo.","poem":1},{"lineBreak":true},{"text":"Aà káaluakaa bↄ a wɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"i mikɛ̃ gbãsĩkɛawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó màa no, má pↄ́ piliwàɛ,","poem":1},{"lineBreak":true},{"text":"i gↄ̃ puizi,","poem":1},{"lineBreak":true},{"text":"má tó aà gↄ̃ láilai,","poem":1},{"lineBreak":true},{"text":"lá wà aà ìwaɛ.","poem":1},{"lineBreak":true},{"text":"Má tó aà gↄ̃ gbáa ũɛ,","poem":1},{"lineBreak":true},{"text":"má aà li gugii ũɛ,","poem":1},{"lineBreak":true},{"text":"mí tó aà ga ń imio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má aà nɛ́ↄ wɛgwao,","poem":1},{"lineBreak":true},{"text":"asa gĩnasↄↄnɛↄnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An da dↄ́ɛ'ĩi kɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń nↄsì wisaikɛa guu.","poem":1},{"lineBreak":true},{"text":"À mɛ̀ á gɛ́ a gↄ̃pↄsɛↄwaɛ,","poem":1},{"lineBreak":true},{"text":"aai a gba pↄblea ń ío ń sãkão","poem":1},{"lineBreak":true},{"text":"ń bàabaao ń nísio ń vɛ̃ɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayãmɛto má zɛdɛɛ̀ ń lɛo,","poem":1},{"lineBreak":true},{"text":"má gĩ liaaàzi,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu tɛ a dàaio yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó à sù bↄ̀ pɛ̀lɛ a gↄ̃pↄsɛↄzi sↄ̃,","poem":1},{"lineBreak":true},{"text":"a ń leo,","poem":1},{"lineBreak":true},{"text":"a kpálɛkɛńzi, a ń eo,","poem":1},{"lineBreak":true},{"text":"i mɛ á ɛa ta a gↄ̃ sɛ̃́iawaɛ,","poem":1},{"lineBreak":true},{"text":"asa aà pↄ na yãa dɛ tiaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I dↄ̃ kɛ́ mámɛ ma pↄ́wɛna ń vɛ̃ɛo kpàwao.","poem":1},{"lineBreak":true},{"text":"Ma nísi ń ã́nusuo ń vuao nↄ̀nↄaaɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à a mↄaokɛ̀ Baaliwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yã́i má ɛa mà a pↄ́wɛna síwà","poem":1},{"lineBreak":true},{"text":"ń ma vɛ̃ɛo a kɛkɛgↄↄ","poem":1},{"lineBreak":true},{"text":"ń sãkão ń bàabaa pↄ́ à a puizi ùlɛoo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"mí aà wisaikɛ kaɛ̀ a ↄzĩ","poem":1},{"lineBreak":true},{"text":"aà gↄ̃pↄsɛↄ wáa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e a e à aà bↄ ma ↄzĩo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má aà pↄnakɛa midɛ píiɛ,","poem":1},{"lineBreak":true},{"text":"dikpɛ pↄ́ ì kɛ wɛ̃ ń wɛ̃o pↄ́ↄ","poem":1},{"lineBreak":true},{"text":"ń mↄ dafu pↄ́ↄ ń kã́mabogↄↄ pↄ́ↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má aà vɛ̃ɛliↄ ń aà kaadↄɛnliↄ dɛɛlɛɛ,","poem":1},{"lineBreak":true},{"text":"lí pↄ́ à mɛ̀ a gↄ̃pↄsɛↄ mɛ́ fĩabòòɛpiↄ,","poem":1},{"lineBreak":true},{"text":"mí tó gupi gↄ̃ tàaa ũ, sɛ̃̀anↄbↄↄ i ble.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lá à tulaletikàtɛa tã́aↄnɛ,","poem":1},{"lineBreak":true},{"text":"à azĩa kɛ̀kɛ ń tãanaↄ ń nↄamblebↄↄ,","poem":1},{"lineBreak":true},{"text":"à pɛ̀lɛò a gↄ̃pↄsɛpiↄzi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma yã́ sã̀aàgu,","poem":1},{"lineBreak":true},{"text":"yã́piↄ yã́i má aà wɛtãɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má tó Isailiↄ ma yã́zɛ e,","poem":1},{"lineBreak":true},{"text":"má gɛ́ńnↄ gbáauɛ,","poem":1},{"lineBreak":true},{"text":"mí ń nↄ̀sɛ níninɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"We má ń vɛ̃ɛbuↄ sↄaaunɛ́,","poem":1},{"lineBreak":true},{"text":"mí Akoo guzulɛ","poem":1},{"noteId":7},{"text":"kɛnɛ́ pↄ'ezɛ ũ.","poem":1},{"lineBreak":true},{"text":"Aa ma yãma lá aa mà ń wɛ̃́ndia gↄↄ,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ aa bↄ̀ Egipi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gↄↄbeezĩ aa omɛɛ ń zã́,","poem":1},{"lineBreak":true},{"text":"aa omɛɛ Baali lↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Má tã́aↄ tↄbↄ ń lɛ́u,","poem":1},{"lineBreak":true},{"text":"an tↄ́ aↄ dↄńgu lↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má yãdilɛ pↄ́ↄnɛ píi an yã́ musu,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀anↄbↄↄ ń bãↄ ń pↄ́taa'onkuawaↄ.","poem":1},{"lineBreak":true},{"text":"Má sá ń fɛ̃ndao ń zĩo midɛ an bùsuu,","poem":1},{"lineBreak":true},{"text":"mí tó aaↄ ku we dↄdↄa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Má á kɛ ma nↄ ũ e gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"má á kɛ ma nↄ ũ a zɛ́wa súsuɛ,","poem":1},{"lineBreak":true},{"text":"mí wɛ̃nadↄ̃ɛ́ gbɛ̃kɛ guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má á kɛ ma nↄ ũ ń náaio,","poem":1},{"lineBreak":true},{"text":"íↄ ma dↄ̃ Dii ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gↄↄ bee má swãwɛ̃.","poem":1},{"lineBreak":true},{"text":"Má swã́sɛ musu yã́i,","poem":1},{"lineBreak":true},{"text":"musu i swã́sɛ tↄↄlɛ yã́i,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"tↄↄlɛ i swã́sɛ pↄ́wɛna ń vɛ̃ɛo ń nísio yã́i,","poem":1},{"lineBreak":true},{"text":"aai swã́sɛ bui pↄ́ má tↄ̃̀ yã́i.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Má ń tↄ̃́ ń bùsuu mazĩa pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ ma tↄkpàɛ̀ Wɛ́gwaakuopi,","poem":1},{"lineBreak":true},{"text":"má ń wɛgwa.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ ma tↄkpàɛ̀ Magbɛ̃ↄnopi,","poem":1},{"lineBreak":true},{"text":"má onɛ́ ma gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"aai omɛɛ ń Lua.","poem":1},{"noteId":8}]}],"footnotes":[{"noteId":6,"caller":"+","text":"2.1 Lom 9.26","reference":{"chapter":2,"verse":1}},{"noteId":7,"caller":"+","text":"2.17 Yoz 7.24-26","reference":{"chapter":2,"verse":17}},{"noteId":8,"caller":"+","text":"2.25 Lom 9.25, 1Piɛ 2.10","reference":{"chapter":2,"verse":25}}]},"thisChapterLink":"/api/bqc_sim/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}