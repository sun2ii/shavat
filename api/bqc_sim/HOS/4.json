{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Dii bↄbↄa ń Isailiↄ"]},{"type":"verse","number":1,"content":["Isailiↄ, à ma yãma,",{"text":"asa má yãvĩ ń bùsupideↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e náai vĩo, gbɛ̃e gbɛ̃kɛ vĩo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ma dↄ̃ bùsuɛ bee guuo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́kaa ń ɛɛtoao mɛ́ kú a guu","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃dɛao ń kpã́i'oao ń gbãsĩkɛao.","poem":1},{"lineBreak":true},{"text":"Aaì gbãamↄnɛ́,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃bↄalia zɛzɛa vĩo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yã́i tò bùsupi gↄ̃̀ wɛ̃nannↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú a guuↄ gↄ̃̀ yɛ̃̀ɛɛsai píi.","poem":1},{"lineBreak":true},{"text":"Baa se nↄ̀bↄↄ ń bãↄ ń kpↄↄ lɛ́ gaga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃e su lɛkpaakɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e su zↄakao,","poem":1},{"lineBreak":true},{"text":"asa á sa'onaↄ ámɛ málɛ bↄbↄánↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I gɛ̃nalɛ fãanɛ,","poem":1},{"lineBreak":true},{"text":"á ãnabiↄ sↄ̃ aaì gɛ̃napi lɛ́ánↄ gwã́.","poem":1},{"lineBreak":true},{"text":"A yã́i má á bui midɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ gↄ̃̀ kaalɛa dↄ̃a kɛ̃́sãma yã́i.","poem":1},{"lineBreak":true},{"text":"Lá a gí dↄ̃ai,","poem":1},{"lineBreak":true},{"text":"má gí àↄ dɛ ma gbàgbanaↄ ũɛ.","poem":1},{"lineBreak":true},{"text":"Lá mapi á Lua ikoyã sã̀águ,","poem":1},{"lineBreak":true},{"text":"màa á nɛ́ↄ yã́ a sãmagu sↄ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lá sa'onapiↄ kↄ̃̀,","poem":1},{"lineBreak":true},{"text":"màa an duunkɛamɛɛ kↄ̃̀,","poem":1},{"lineBreak":true},{"text":"aa ma gawi lɛũkpakɛ̀ ń wíyão.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aaì sa pↄ́ ma gbɛ̃́ↄ ò ń duuna yã́i pↄ́ só.","poem":1},{"lineBreak":true},{"text":"A yã́i an yãvãikɛa ì kɛnɛ́ na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sa'onaↄ muaa ń gbɛ̃́piↄɛ.","poem":1},{"lineBreak":true},{"text":"Má ń dàakɛaↄ wínɛ́ ń musuɛ,","poem":1},{"lineBreak":true},{"text":"má fĩabonɛ́ ń yãkɛaↄwaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa pↄble, kási aa kão,","poem":1},{"lineBreak":true},{"text":"aa gbãsĩkɛ, kási aa kã́fĩo,","poem":1},{"lineBreak":true},{"text":"asa aa pãkpàmazi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"aa zɛ̀ ń gbãsĩkɛaoɛ.","poem":1},{"lineBreak":true},{"text":"Vɛ̃ɛ zi ń a dafuo ń mi lìaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Líↄ ↄ̃ aaì gɛ́ yãgbɛaimá,","poem":1},{"lineBreak":true},{"text":"màsokɛna go ì yã'onɛ́.","poem":1},{"lineBreak":true},{"text":"Gbãsĩkɛa mɛ́ ń sãsã,","poem":1},{"lineBreak":true},{"text":"aaì gbãsĩkɛ aa ń Lua to weɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aaì sa'o gbɛ̀sĩsĩↄ musu,","poem":1},{"lineBreak":true},{"text":"aaì tulaletikatɛa sĩ̀sĩↄwa","poem":1},{"lineBreak":true},{"text":"giali ń baalio ń gbɛ̃́nɛlio gbáu,","poem":1},{"lineBreak":true},{"text":"asa a uena ì kɛnɛ́ naɛ.","poem":1},{"lineBreak":true},{"text":"A yã́i tò á nɛnↄɛↄ ì dↄ́ɛ'ĩi kɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ á nɛ́ naↄ ì gbãsĩkɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó á nɛnↄɛↄ dↄ́ɛ'ĩi kɛ̀,","poem":1},{"lineBreak":true},{"text":"mɛ́ á nɛ́ naↄ gbãsĩkɛ̀,","poem":1},{"lineBreak":true},{"text":"má ĩadamáo,","poem":1},{"lineBreak":true},{"text":"asa á gↄ̃ɛↄ ì gɛ na nↄɛ dↄ́ɛ'ĩideↄwaɛ,","poem":1},{"lineBreak":true},{"text":"aaì gɛ́ sa'oi ń tã́akpɛ káaluaↄɛ.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ dↄ̃a vĩo ì kaalɛɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isailiↄ, baa kɛ́ a gbãsĩkɛ̀,","poem":1},{"lineBreak":true},{"text":"Yudaↄ su tàaekɛ màao.","poem":1},{"lineBreak":true},{"text":"Ásu gɛ́ Giligalio,","poem":1},{"lineBreak":true},{"text":"ásu Bɛtavɛ̃ sĩ̀sĩ kũo,","poem":1},{"lineBreak":true},{"text":"ásu lɛgbɛ̃ we à mɛ ń Dii kuaoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Isailiↄ swã́ gbãa lán zununuwaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ mà gɛ́ńnↄ dã́dãkɛkĩi lán sãↄwaa?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ nà tã́aↄwa,","poem":1},{"lineBreak":true},{"text":"wà ń tó we.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó an í gbãa làa, aaì gbãsĩkɛɛ,","poem":1},{"lineBreak":true},{"text":"an dↄaanaↄ ye wisaiyãi à kɛ̀ zài.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zàa a ń sɛ́lɛ taòɛ,","poem":1},{"lineBreak":true},{"text":"an sa'okĩiↄ i widamá.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}