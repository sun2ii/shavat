{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Isailiↄ daa yã́u"]},{"type":"verse","number":1,"content":["Sa'onaↄ, à yã́ɛ bee ma,",{"text":"Isailiↄ, à swã́kpa.","poem":1},{"lineBreak":true},{"text":"Kibɛdeↄ, à swãdↄ yã́i,","poem":1},{"lineBreak":true},{"text":"asa málɛ yãdaálaɛ.","poem":1},{"lineBreak":true},{"text":"A gↄ̃nɛ́ bai ũ Mizipa,","poem":1},{"lineBreak":true},{"text":"a filifilimbakpànɛ́ Taboo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ dↄ̀ↄsaipiↄ kà zã̀ ń gbɛ̃dɛao,","poem":1},{"lineBreak":true},{"text":"mámɛ má ń swã́gaga ḿpii.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mámɛ má Ɛflaiũ buiↄ dↄ̃,","poem":1},{"lineBreak":true},{"text":"Isailipiↄ yã́ ulɛamɛɛo.","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ zɛ̀ ń gbãsĩkɛao saɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ gbãlɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An yãkɛaↄ mɛ́ tò aali su ń Luawao,","poem":1},{"lineBreak":true},{"text":"gbãsĩkɛa kú ń sↄ̃u, aa Dii dↄ̃o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Isailiↄ wala ì ń dayãu,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ ì gɛ̃mbↄlɛ ń duunkɛa guu,","poem":1},{"lineBreak":true},{"text":"Yudaↄ ì gɛ̃mbↄlɛńnↄ sↄ̃ɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaì gɛ́ Dii kĩ́i wɛɛlɛi ń ń sãↄ ń ń zuↄ,","poem":1},{"lineBreak":true},{"text":"kási aali bↄwào, à azĩa gànɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa bↄ̀ Dii kpɛ, ↄ̃ aa naaenɛↄ ì'i.","poem":1},{"lineBreak":true},{"text":"Wa ń kaalɛ saɛ e mↄ do,","poem":1},{"lineBreak":true},{"text":"ampiↄ ń ń buaↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À kuupɛ Gibɛa!","poem":1},{"lineBreak":true},{"text":"À kã̀aepɛ Lama!","poem":1},{"lineBreak":true},{"text":"À zĩ̀gãalɛ Bɛtavɛ̃!","poem":1},{"lineBreak":true},{"text":"À dↄaa Bɛ̃yãmɛɛ buiↄ!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛflaiũ bùsu a gↄ̃ bɛzia ũ an wɛtãgↄↄɛ.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ málɛ o Isaili buiↄnɛ sea vĩo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yudaↄ kíaↄ dɛ lán gbɛ̃́ pↄ́ aaì kↄↄ sɛ sↄ̃oↄwaɛ.","poem":1},{"lineBreak":true},{"text":"Má a pↄkũma bↄbↄmá lán ídaa guawaɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wàlɛ gbãamↄ Ɛflaiũ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"yã́kpalɛ mɛ́ ń ble,","poem":1},{"lineBreak":true},{"text":"asa aa gi tɛ yãpãiɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má dɛ Ɛflaiũ buiↄnɛ lán blɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"má dɛ Yudaↄnɛ mɛkɛmuuna ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kɛ́ Ɛflaiũ buiↄ ń gyãkɛa è,","poem":1},{"lineBreak":true},{"text":"mɛ́ Yudaↄ ń bↄkɛa è,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gɛ̀ Asiliↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"aa gbɛ̃́ↄ zĩ̀ dↄnlɛ gbɛai ń kía zↄ̃ↄwa,","poem":1},{"lineBreak":true},{"text":"kási a fↄ̃ á gbã́gbão,","poem":1},{"lineBreak":true},{"text":"a fↄ̃ tó á bↄↄ láao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asa máↄ dɛ Ɛflaiũ buiↄnɛ lán nↄ̀ↄmusuwaɛ,","poem":1},{"lineBreak":true},{"text":"máↄ dɛ Yudaↄnɛ nↄ̀ↄkusi ũɛ.","poem":1},{"lineBreak":true},{"text":"Má ń taitaiɛ, mí dazɛu,","poem":1},{"lineBreak":true},{"text":"má táńnↄɛ, suabanae aↄ kuo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má dazɛu, mí tá ma kúkĩi,","poem":1},{"lineBreak":true},{"text":"e aaↄ ń tàae dↄ̃, aai ma kĩ́i wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"aai ma aɛya ń yooyea guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}