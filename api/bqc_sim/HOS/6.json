{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Isailiↄ i nↄ̀sɛlilɛo"]},{"type":"verse","number":1,"content":["À mↄ wà ɛa ta Diiwa.",{"text":"Ɔ̃mɛ wá taitai,","poem":1},{"lineBreak":true},{"text":"kási a wá gbã́gbãɛ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ wá kɛ́ ĩa,","poem":1},{"lineBreak":true},{"text":"kási a ɛsɛkɛwàwɛ̃ɛɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gↄↄpla gbɛa a wá lɛ́ ń láo,","poem":1},{"lineBreak":true},{"text":"a gↄↄ àaↄ̃de zĩ́ i wá fɛlɛ,","poem":1},{"lineBreak":true},{"text":"wíↄ kuaànↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wà Dii dↄ̃ wà pɛ́lɛ aà dↄ̃ai.","poem":1},{"lineBreak":true},{"text":"Lá gudↄa sea vĩo, a bↄ mↄ́wá,","poem":1},{"lineBreak":true},{"text":"a mↄ́wá lán káabuan louwa,","poem":1},{"lineBreak":true},{"text":"lán lou gbɛzã pↄ́ ì kwɛ tↄↄlɛwawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ, bↄ́ má kɛánↄi?","poem":1},{"lineBreak":true},{"text":"Yudaↄ, bↄ́ má kɛánↄi?","poem":1},{"lineBreak":true},{"text":"Á yeamazi dɛ lán suawaɛ,","poem":1},{"lineBreak":true},{"text":"lán kↄↄkↄↄ fíi pↄ́ ì gɛ̃zɛawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A yã́i tò ma á zↄ̃́ɛzↄ̃ɛ","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ bↄ̀ ma lɛ́uo,","poem":1},{"lineBreak":true},{"text":"ma á dɛdɛ ń ma ãnabiↄ yã́o.","poem":1},{"lineBreak":true},{"text":"Ma yã́kpalɛkɛaánↄ bↄ̀ lán loupilɛawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛkɛakↄ̃ɛ ↄ̃ má yei,","poem":1},{"lineBreak":true},{"text":"i kɛ ma gbagbaa no.","poem":1},{"noteId":9},{"lineBreak":true},{"text":"Ma dↄ̃a Lua ũ maa dɛ sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa ma bàakuańnↄ yã́ gbòo,","poem":1},{"lineBreak":true},{"text":"aa bↄ ma kpɛ Adama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galada bùsudeↄá yãvãikɛnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃dɛ'au mɛ́ ìↄ tɛ́ ń iau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá gbãamↄnɛdeↄ ì gbɛ̃́ↄ kpákpa,","poem":1},{"lineBreak":true},{"text":"màa sa'on gãliↄ ì kɛ,","poem":1},{"lineBreak":true},{"text":"aaì gbɛ̃́ↄ dɛdɛ Sikɛũ zɛ́u,","poem":1},{"lineBreak":true},{"text":"we aaì dàakɛunɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma yã́ pↄ́ ì dimá è Isailiↄwa,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ ńzĩa kpà gbãsĩkɛawa,","poem":1},{"lineBreak":true},{"text":"Isailiↄ gbãlɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Á Yudaↄ sↄ̃ a ma vãikɛa guu,","poem":1},{"lineBreak":true},{"text":"a ka kɛkɛa!","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"6.6 Mat 9.13, 12.7","reference":{"chapter":6,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}