{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Tó má ye mà su ń ma gbɛ̃́ↄ ń pá ziuɛ,",{"text":"tó má ye mà Isailiↄ gba aafiaɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buipiↄ duuna ì bilɛ,","poem":1},{"lineBreak":true},{"text":"Samalideↄ vãikɛaↄ ì bↄ gupuau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aalɛ e ń yãkɛae dↄmaguo.","poem":1},{"lineBreak":true},{"text":"An dàa kũ̀aamá, málɛ wɛsiɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"An yãvãikɛaↄ ì ka kíagu,","poem":1},{"lineBreak":true},{"text":"an mↄafili ì kɛ dↄaanaↄnɛ na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbãsĩkɛnaↄnɛ ḿpii,","poem":1},{"lineBreak":true},{"text":"an mɛ ìↄ wãa lán pɛ̃ɛkpɛwa.","poem":1},{"lineBreak":true},{"text":"Za pɛ̃ɛtotogↄↄ e a kã́kãgↄↄ","poem":1},{"lineBreak":true},{"text":"pɛ̃ɛkɛna lí a tɛ́ kɛkɛ lↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kía dikpɛgↄↄ vɛ̃ɛ ì tɛ́kpa kíaↄgu,","poem":1},{"lineBreak":true},{"text":"kía i ↄda kↄ̃ ↄu ń gbɛ̃́laanikɛnaↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An mɛ wã̀ ń kↄ̃nio lán pɛ̃ɛkpɛwa,","poem":1},{"lineBreak":true},{"text":"gwã́ an pↄ ì gi àↄ fɛ̃a e gu gɛ̀ dↄ̀o,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì dɛdɛ kↄↄ lán tɛ́lɛpiↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ampii aa wãa lán pɛ̃ɛkpɛwa,","poem":1},{"lineBreak":true},{"text":"aaì bùsu yãgↄ̃gↄ̃naↄ mↄ́mↄ.","poem":1},{"lineBreak":true},{"text":"An kíaↄ ì kwɛ píi,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e lí lɛzumazio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ yãalɛa ń buipãleↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa gↄ̃̀ lán kàagbaala lilɛsaiwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buipãleↄ lɛ́ ń gbãable, aa dↄ̃o,","poem":1},{"lineBreak":true},{"text":"an mikã lɛ́ dadau, aa a fãn vĩo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Isailiↄ wala ì ń dayãu,","poem":1},{"lineBreak":true},{"text":"gia ń beeo aali tá Dii ń Luawao,","poem":1},{"lineBreak":true},{"text":"aali aà kĩ́i wɛɛlɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ dɛ lán felenawaɛ.","poem":1},{"lineBreak":true},{"text":"Sↄũↄnɛ, aa mi vĩo,","poem":1},{"lineBreak":true},{"text":"aaì lɛzu Egipiↄzi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì ɛa gɛ́ Asiliↄwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó aa dàzɛu, má táalu zuńlaɛ,","poem":1},{"lineBreak":true},{"text":"mí ń kwɛ́ lán bãↄwa.","poem":1},{"lineBreak":true},{"text":"Tó aa kã̀aa gudoũ,","poem":1},{"lineBreak":true},{"text":"mí ń wɛtã ń vãikɛa yã́i.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waiyoo ampiↄ, asa aa kɛ̃̀aɛ.","poem":1},{"lineBreak":true},{"text":"Kaalɛ mɛ́ gↄ̃̀nɛ́, asa aa bↄ̀ ma kpɛɛ.","poem":1},{"lineBreak":true},{"text":"Má ye mà ń bo, ↄ̃ aaì ɛɛdↄa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aali wiilɛa ń nↄ̀sɛmɛndooo,","poem":1},{"lineBreak":true},{"text":"aaì wiipɛ ń lii musu.","poem":1},{"lineBreak":true},{"text":"Aaì ńzĩa líli pↄ́wɛna ń vɛ̃ɛo ea yã́i,","poem":1},{"lineBreak":true},{"text":"aaì kɛ̃a.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma ń toto,","poem":1},{"lineBreak":true},{"text":"má tò an gã̀sa gbãakũ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì làasoo vãi kɛ ma musu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma Musude, aali suao,","poem":1},{"lineBreak":true},{"text":"aa dɛ lán sá gia baiwaɛ.","poem":1},{"lineBreak":true},{"text":"Fɛ̃nda mɛ́ a ń kíaↄ kwɛ́ an lɛ́'ɛaa yã́i,","poem":1},{"lineBreak":true},{"text":"Egipiↄ i ń yáalↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}