{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Yã́kpalɛ zↄ̃lɛa pↄ̀ↄbↄzãkɛnaↄwa"]},{"type":"verse","number":1,"content":["Lɛ́pɛ kã̀aewa!",{"text":"Wàlɛ su lɛ́lɛi ma gbɛ̃́ Isailiↄwa lán kúuwa,","poem":1},{"lineBreak":true},{"text":"asa aa ma bàakuańnↄ yã́ gbòo,","poem":1},{"lineBreak":true},{"text":"aa bↄ̀ ma ikoyã kpɛɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isailiↄ ì lɛzumazi wà mɛ:","poem":1},{"lineBreak":true},{"text":"Wá Lua, wá n dↄ̃!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lá Isailiↄ gì yãmaai,","poem":1},{"lineBreak":true},{"text":"ibɛɛ a ń gbɛsɛlɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì kíaↄ kpa ma lɛ́ saiɛ,","poem":1},{"lineBreak":true},{"text":"aaì dↄaanaↄ dilɛ ma dↄ̃a saiɛ.","poem":1},{"lineBreak":true},{"text":"Aaì tã́aↄ pí ńzĩaɛ ń ã́nusuo ń vuao.","poem":1},{"lineBreak":true},{"text":"A yã́i ↄ̃ aa kaalɛi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma gi Samalideↄ zugaaei,","poem":1},{"lineBreak":true},{"text":"ma pↄ pàńzi.","poem":1},{"lineBreak":true},{"text":"Kua gbãlɛsai aↄ ń fu e bↄɛ ni?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isaili ↄzĩkɛna mɛ́ gáaepi kɛ̀,","poem":1},{"lineBreak":true},{"text":"Samalideↄ pↄ́piá Lua no,","poem":1},{"lineBreak":true},{"text":"wa wíwi kɛ́lɛkɛlɛɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĩana aaì tↄ̃́, ↄ̃ ì bↄlɛnɛ́ zàa ũ.","poem":1},{"lineBreak":true},{"text":"Ése i piao, wa e wísilↄo.","poem":1},{"lineBreak":true},{"text":"Baa tó à pìa,","poem":1},{"lineBreak":true},{"text":"buipãleↄ mɛ́ aa mↄ́ ń pↄ́ naaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Isailiↄ gↄ̃̀ pↄbleaↄ ũ,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ lán pↄ́ pↄ́ wa yeiↄwa buiↄ guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa aa gɛ̀ Asiliↄwa,","poem":1},{"lineBreak":true},{"text":"lán sɛ̃̀a zàa'ĩna pↄ́ ìↄ bɛ adowaɛ.","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ ì gbɛ̃na wɛɛlɛ ń pↄ́oɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baa kɛ́ aa gbɛ̃nakpà ń buipãleↄ,","poem":1},{"lineBreak":true},{"text":"má ń naaaɛ sa.","poem":1},{"lineBreak":true},{"text":"Kía zↄ̃ↄ mɛ́ a ↄtↄ̃má,","poem":1},{"lineBreak":true},{"text":"aai na laoawa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ sa'okĩiↄ kↄ̃̀ duunakɛ̃ama yã́i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ sa'okĩipiↄ gↄ̃̀nɛ́ duunkɛzɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma yãkɛ̃̀nɛ́ dasi ma ikoyã ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa dìlɛ yã zĩ̀lo ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aaì ma gbagba, ↄ̃ aaì a nↄ̀ↄ só.","poem":1},{"lineBreak":true},{"text":"Ma Dii ma pↄ namáo,","poem":1},{"lineBreak":true},{"text":"an vãikɛa dↄmagu.","poem":1},{"lineBreak":true},{"text":"Má tó an duuna wi ń musuɛ,","poem":1},{"lineBreak":true},{"text":"aai ɛa ta Egipi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isailiↄ Kɛna yã́ sã̀ńguɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aalɛ ń kibɛↄ kpakpa.","poem":1},{"lineBreak":true},{"text":"Yudaↄ lɛ́ wɛ̃́lɛ bĩ́ideↄ kálɛkalɛ,","poem":1},{"lineBreak":true},{"text":"kási má tɛsↄ̃ wɛ̃́lɛpiↄwaɛ,","poem":1},{"lineBreak":true},{"text":"an kibɛpiↄ i tɛ́kũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}