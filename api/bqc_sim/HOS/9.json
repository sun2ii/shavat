{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"HOS","translationId":"bqc_sim","name":"Ozee","commonName":"Ozee","title":"OZEE","order":28,"numberOfChapters":14,"sha256":"f0e6c5c6365e90abae56fa76202fa1c77346e7ca85f5c139c69c6642a8fad2dd","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Isailiↄ, ásu pↄnakɛo,",{"text":"ásu yáalↄ lán buipãleↄwao,","poem":1},{"lineBreak":true},{"text":"asa a á Lua tò we,","poem":1},{"lineBreak":true},{"text":"a gɛ gbãsĩkɛ̀ tã́a yã́ musuɛ.","poem":1},{"lineBreak":true},{"text":"Pↄ́wɛngbɛ̃kĩi píiu á pↄ ìↄ dↄ tã́agbagba'aseawaɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pↄ́wɛngbɛ̃kĩiↄ ń vɛ̃ɛfɛ̃kĩiↄ fↄ̃ á gwao,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛ dafu a bↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gↄ̃ Dii bùsuuo,","poem":1},{"lineBreak":true},{"text":"aa ɛa ta Egipi,","poem":1},{"lineBreak":true},{"text":"aa ń tɛ̃ ble Asili bùsuu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa e vɛ̃ɛ tↄ̃́lɛ Diiwa weo,","poem":1},{"lineBreak":true},{"text":"an sa'obↄↄ kaaàguo.","poem":1},{"lineBreak":true},{"text":"An blɛpiↄ dɛ lán gɛ'ↄↄlↄnaↄ blɛwaɛ,","poem":1},{"lineBreak":true},{"text":"a blenaↄ gbãlɛɛ.","poem":1},{"lineBreak":true},{"text":"Aa blɛpi mↄaokɛ ńzĩaɛ,","poem":1},{"lineBreak":true},{"text":"aa e gɛò Dii kpɛ́uo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikpɛ pↄ́ Dii dìlɛ a pↄ́ ũↄ,","poem":1},{"lineBreak":true},{"text":"kpelewa aa kɛ gↄↄpiↄ zĩ́i?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gwa, baa tó aa pìli kaalɛwa,","poem":1},{"lineBreak":true},{"text":"Egipiↄ ń gɛ kãaa, Mɛfisideↄ ń vĩ.","poem":1},{"lineBreak":true},{"text":"Lɛaa mɛ́ a kũaa ń ã́nusu pↄ́ bɛɛɛdeↄwa,","poem":1},{"lineBreak":true},{"text":"lɛsikao i kúlɛ ń kpɛ́ↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tↄsimagↄↄ lɛ́ mↄ́,","poem":1},{"noteId":10},{"lineBreak":true},{"text":"fĩabonɛgↄↄ lɛ́ ká!","poem":1},{"lineBreak":true},{"text":"À to Isailiↄ dↄ̃!","poem":1},{"lineBreak":true},{"text":"An duun zↄ̃ↄ ń ĩ́i pↄ́ aa sɛ̀ ń Luao yã́i,","poem":1},{"lineBreak":true},{"text":"aaì ãnabi gwa sↄũ ũɛ,","poem":1},{"lineBreak":true},{"text":"aaì gbɛ̃́ pↄ́ Lua Nisĩna lɛ́ dↄaaɛ dilɛ ĩ́ande ũɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ãnabiá gudↄ̃anaɛ","poem":1},{"lineBreak":true},{"text":"ma Lua gbɛ̃́ Ɛflaiũ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wì filifilimbakpaɛ̀ a táa'ozɛu,","poem":1},{"lineBreak":true},{"text":"wì íbɛlɛsɛaànↄ a Lua kpɛ́u.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa sì yãdↄↄsaiu","poem":1},{"lineBreak":true},{"text":"lá wa kɛ̀ Gibɛa yãawa.","poem":1},{"noteId":11},{"lineBreak":true},{"text":"An vãikɛa dↄ Luagu,","poem":1},{"lineBreak":true},{"text":"a ń duuna wínɛ́ ń musuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma Isailiↄ ea dɛ lán vɛ̃ɛbɛↄ kↄ̃mpaa gbáauwaɛ.","poem":1},{"lineBreak":true},{"text":"Wɛ́sia ń deziↄlɛ dɛ lán kaadↄɛn nɛ́ sɛ̃́ia eawaɛ.","poem":1},{"lineBreak":true},{"text":"Ãma kɛ́ aa kà Baali Peoo,","poem":1},{"lineBreak":true},{"text":"aa ńzĩa kpà tã́awa,","poem":1},{"noteId":12},{"lineBreak":true},{"text":"ↄ̃ aa bɛ̃̀ɛkũ̀ lán pↄ́ pↄ́ aa yeipiwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gawi a gɛ̃zɛa lán bãwaɛ.","poem":1},{"lineBreak":true},{"text":"Nↄsia aↄ kuo, nↄsindee aↄ kuo, nɛ'ia aↄ kuo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baa tó aa nɛ́ gwà, à gbãakũ̀,","poem":1},{"lineBreak":true},{"text":"má tó aa kuawàɛ e gbɛ̃́ↄ gɛ láaò.","poem":1},{"lineBreak":true},{"text":"Waiyoo ampiↄ, tó ma bↄ ń kpɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má è Ɛflaiũ bui nɛ́ↄ gↄ̃̀","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄ pↄ́ toenaↄ ń dadan'aɛkɛwa,","poem":1},{"lineBreak":true},{"text":"aa bↄ̀lɛ ń ń nɛ́ↄ gbɛ̃dɛnaↄnɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ ń gba pↄ́ Dii! Bↄ́ ńyↄ̃ ń gbai?","poem":1},{"lineBreak":true},{"text":"Nɛansakpɛ pↄ́ a nↄ ì gboo ń yↄ̃́ isaioɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"An vãikɛa ku Giligali píi,","poem":1},{"lineBreak":true},{"text":"we ma zauńgu.","poem":1},{"lineBreak":true},{"text":"Má ń yá ma kpɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ an yãkɛaↄ vãi yã́i.","poem":1},{"lineBreak":true},{"text":"Máↄ yeńzi lↄo","poem":1},{"lineBreak":true},{"text":"an kía swã́gbãadeↄ yã́i.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gyã sɛ̀,","poem":1},{"lineBreak":true},{"text":"an zĩ́na imì, aalɛ nɛ'io.","poem":1},{"lineBreak":true},{"text":"Baa tó aa ì,","poem":1},{"lineBreak":true},{"text":"má tó nɛ́ pↄ́ an pↄ dↄwàↄ gagaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma Lua a gíńziɛ,","poem":1},{"lineBreak":true},{"text":"aai liaaliaa buipãleↄ guu,","poem":1},{"lineBreak":true},{"text":"asa aai aà yãmao.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"9.7 Luk 21.22","reference":{"chapter":9,"verse":7}},{"noteId":11,"caller":"+","text":"9.9 Dↄa 19.1-30","reference":{"chapter":9,"verse":9}},{"noteId":12,"caller":"+","text":"9.10 Nao 25.1-5","reference":{"chapter":9,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}