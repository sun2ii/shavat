{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"heading","content":["Isailiↄ swã́gbãakɛa"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ Amↄzu nɛ́ Isaia è Yuda bùsu ń Yelusalɛũo musu Yuda kíaↄ Uzia",{"noteId":0},"ń Yotaũo",{"noteId":1},"ń Aazao",{"noteId":2},"ń Ezekiao",{"noteId":3},"gↄↄn kɛ:"]},{"type":"verse","number":2,"content":[{"text":"Musudeↄ, à yãma!","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú zĩ́lɛↄ, à swã́kpa!","poem":1},{"lineBreak":true},{"text":"Asa ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"ma nɛ́ↄ sì ma ń gwá,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa gìmazi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zu a dii dↄ̃,","poem":1},{"lineBreak":true},{"text":"zàa'ĩna a blɛkalɛkĩi dↄ̃,","poem":1},{"lineBreak":true},{"text":"kási Isailiↄ ye yã́pi dↄ̃a yã́io,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́piↄ líↄ yã́ dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waiyoo bui duunkɛna pi!","poem":1},{"lineBreak":true},{"text":"Tàae kɛ̀ ń musu zↄ̃ↄ!","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩn vãikɛnaↄ! Nɛ́ vlãaↄ!","poem":1},{"lineBreak":true},{"text":"Aa pãkpà Diizi aa mikpɛlìɛ̀,","poem":1},{"lineBreak":true},{"text":"aa sakà Isailiↄ Lua Kuaadoadegu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Á ye aà ɛa á gbɛ̃ yã̀?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi a gi lɛ́ bↄ aà yã́ kpɛi?","poem":1},{"lineBreak":true},{"text":"Mi gyã sɛ̀, sↄ̃ yɛ̃̀ɛɛ làa míↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Za á kɛ̀sɛwa e à gɛ̀ pɛ̀ á miwa,","poem":1},{"lineBreak":true},{"text":"aafia ku gueio,","poem":1},{"lineBreak":true},{"text":"sema bↄ ń flàala iaↄ ń bↄ̀ uusikɛaↄ.","poem":1},{"lineBreak":true},{"text":"Wi ↄtↄ̃ a keewa à ibↄ̀o,","poem":1},{"lineBreak":true},{"text":"wi nísimawà wà zwãa yèwào.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Á bùsu gↄ̃̀ da giiɛ,","poem":1},{"lineBreak":true},{"text":"á wɛ̃́lɛↄ tɛkũ̀.","poem":1},{"lineBreak":true},{"text":"Bui zĩ̀loↄ á buapↄ́ↄ sɛ̀lɛ á wáa,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ da gii kɛ́ aa zĩblèwà yã́i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siↄna mɛ́ gↄ̃̀ ado lán vɛ̃ɛbu kolakpɛwa.","poem":1},{"lineBreak":true},{"text":"À gↄ̃̀ lán pɛ̃n bua yãayãasuwa,","poem":1},{"lineBreak":true},{"text":"lán wɛ̃́lɛ pↄ́ wà koezↄ̃̀iwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɛ́ i kɛ Dii Zĩgↄ̃de wá kↄ̃naeↄ tòwɛ̃ɛo,","poem":1},{"lineBreak":true},{"text":"dↄ̃ wa gↄ̃ lán Sↄdↄũwa,","poem":1},{"lineBreak":true},{"text":"wí bↄ lán Gↄmↄↄwa.","poem":1},{"noteId":4}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À Lua yãma,","poem":1},{"lineBreak":true},{"text":"á kía pↄ́ á yã́ muaa ń Sↄdↄũdeↄ.","poem":1},{"lineBreak":true},{"text":"À swãdↄ wá Lua ikoyãi,","poem":1},{"lineBreak":true},{"text":"á Gↄmↄↄ dendaeↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Sa dasi pↄ́ álɛ oa dɛmɛɛ pↄe ũe?","poem":1},{"lineBreak":true},{"text":"Sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ oaa","poem":1},{"lineBreak":true},{"text":"ń são ń pↄ mɛkpaa nísio ni bↄ̀mala.","poem":1},{"lineBreak":true},{"text":"Gáae ń são ń bleo au lí kamaguo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ́ a mↄ zɛ ma aɛ,","poem":1},{"lineBreak":true},{"text":"démɛ bee gbɛ̀awái?","poem":1},{"lineBreak":true},{"text":"Pↄ́ↄ kìlimpaa ma uapi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ásu ɛa ma gba pↄpã lↄo,","poem":1},{"lineBreak":true},{"text":"má ye á tulaleti gĩyãio.","poem":1},{"lineBreak":true},{"text":"Dikpɛ pↄ́ i kɛ mↄbↄzĩ ń kã́mabogↄↄo,","poem":1},{"lineBreak":true},{"text":"á kↄ̃kãaapiↄ vãiɛ, má fↄ̃o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má za á mↄbↄa dikpɛↄgu","poem":1},{"lineBreak":true},{"text":"ń dikpɛ pↄ́ i kɛↄ píi,","poem":1},{"lineBreak":true},{"text":"ì ma kũ gbãa lán asowaɛ,","poem":1},{"lineBreak":true},{"text":"ma kpasa ń a sɛao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó a ↄsɛ̀ musu a wabikɛ̀a,","poem":1},{"lineBreak":true},{"text":"má a wɛ́ ga zuɛ,","poem":1},{"lineBreak":true},{"text":"baa tó a wabikɛ̀a kↄ̃sↄ̃kↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"má swã́sɛio.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃dɛ'au gↄ̃́kpa á ↄwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À zu'o, í gↄ̃ gbãsĩsai,","poem":1},{"lineBreak":true},{"text":"à yãvãi tó,","poem":1},{"lineBreak":true},{"text":"má ye mà á e ń vãikɛao lↄo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À fɛlɛ zɛ ń maakɛao,","poem":1},{"lineBreak":true},{"text":"íↄ tɛ yã́zɛdekɛai.","poem":1},{"lineBreak":true},{"text":"À gbɛ̃́ pↄ́ wàlɛ gbãamↄnɛ́ↄ dazɛwa,","poem":1},{"lineBreak":true},{"text":"í yãnakpa tonɛ pↄ́ gwana vĩoↄwa,","poem":1},{"lineBreak":true},{"text":"í yã́gↄ̃gↄ̃ gyaa gbɛ̃andoↄnɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À mↄ wà lɛdoũkɛ.","poem":1},{"lineBreak":true},{"text":"Baa tó á duuna gↄ̃̀wá tɛ̃́ɛɛ lán wↄ̃ↄtɛ̃nawa,","poem":1},{"lineBreak":true},{"text":"a gↄ̃wá púuu lán buawaɛ.","poem":1},{"lineBreak":true},{"text":"Baa tó à gↄ̃̀wá tɛ̃́ɛɛ lán gàalulawa,","poem":1},{"lineBreak":true},{"text":"a gↄ̃wá púuu lán sãkãwaɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tó a wei mɛ́ a ma yãmà,","poem":1},{"lineBreak":true},{"text":"áↄ á bùsuɛ bee blɛ maa bleɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tó a gi sↄ̃ mɛ́ a swã́gbãakɛ̀,","poem":1},{"lineBreak":true},{"text":"wa á dɛdɛ ń fɛ̃ndaoɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii ma lɛ́ mɛ́ ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À gwa lá wɛ̃́lɛ pↄ́ náai vĩ yãa gↄ̃̀ káalua ũ sa.","poem":1},{"lineBreak":true},{"text":"Maakɛa ń yã́zɛdeo di a guu yãaɛ,","poem":1},{"lineBreak":true},{"text":"tiasa gbɛ̃dɛnaↄ mɛ́ kↄ̃̀ a guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N ã́nusu tã́nkpakɛ̀,","poem":1},{"lineBreak":true},{"text":"n vɛ̃ɛ maa kɛ̀ íwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N dↄaanaↄ swã́gbãakɛ̀,","poem":1},{"lineBreak":true},{"text":"aa nà kpã́iↄwa.","poem":1},{"lineBreak":true},{"text":"Ampii aa ye gbagusaɛi,","poem":1},{"lineBreak":true},{"text":"aaìↄ kpálɛkɛ gbai.","poem":1},{"lineBreak":true},{"text":"Aali yãnakpa tonɛↄwao,","poem":1},{"lineBreak":true},{"text":"aali lɛda gyaaↄzio.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A yã́i tò ma Dii Zĩgↄ̃de Isailiↄ Lua Gbãade ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Kai ma ibɛɛↄ! Má tↄsiwáɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄ i weewá.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Má ↄdiɛwáɛ sa,","poem":1},{"lineBreak":true},{"text":"mí á baasa lán mↄwa ń kasagbↄ̃o,","poem":1},{"lineBreak":true},{"text":"mí á gbãsĩ wolowá píi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Má tó àↄ dↄaanaↄ vĩ lán yãawa,","poem":1},{"lineBreak":true},{"text":"á lɛdamadeↄ i gↄ̃ ń kua ziwa.","poem":1},{"lineBreak":true},{"text":"Bee gbɛa wi mɛ á wɛ̃́lɛɛ","poem":1},{"lineBreak":true},{"text":"yã́zɛde wɛ̃́lɛ ge náai wɛ̃́lɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Má Siↄnadeↄ bↄ ĩadaama guu,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃́ pↄ́ nↄ̀sɛlìlɛↄ bↄ yã́zɛde yã́i.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Má tàaedeↄ ń duunkɛnaↄ wíwi píiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa pãkpàmaziↄ midɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wí a á kṹ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́nɛli pↄ́ kàágu a sa'òmáↄ yã́i.","poem":1},{"lineBreak":true},{"text":"Á gɛɛ a gↄ̃ kpá á wɛ́iɛ","poem":1},{"lineBreak":true},{"text":"swalu sa'oa pↄ́ a zɛòↄ yã́ musu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Á gↄ̃ lán gbɛ̃́nɛli pↄ́ a lá wòlowa,","poem":1},{"lineBreak":true},{"text":"lán swalu pↄ́ a í làawa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Gↄ̃sa gbãa a gↄ̃ lán sɛ̃̀ giiwa,","poem":1},{"lineBreak":true},{"text":"aà yãkɛa iↄ dɛ tɛkↄna ũ.","poem":1},{"lineBreak":true},{"text":"A tɛ́kũ ń a yãkɛao sãnuɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we à tɛ́pi dɛo.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 2Kia 15.1-7","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.1 2Kia 15.32-38","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"1.1 2Kia 16.1-20","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"1.1 2Kia 18.1-20.21","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"1.9 Daa 19.24, Lom 9.29","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}