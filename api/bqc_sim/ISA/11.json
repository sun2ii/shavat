{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":11,"content":[{"type":"heading","content":["Yɛse gↄ̃na kpalablea"]},{"type":"verse","number":1,"content":[{"text":"Yɛse miↄna a vlãpa a zĩ́nau,","poem":1},{"noteId":25},{"text":"a gↄ̃na a bↄ, i nɛ'i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii Nisĩna aↄ kuwà,","poem":1},{"lineBreak":true},{"text":"a aà gba ↄ̃nↄ ń wɛzɛ̃o,","poem":1},{"lineBreak":true},{"text":"a aà gba gbãa ń lɛdaama zɛ́o,","poem":1},{"lineBreak":true},{"text":"a aà gba dↄ̃a, i to aàↄ Dii vĩa vĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ a aà kã́si.","poem":1},{"lineBreak":true},{"text":"A yã́gↄ̃gↄ̃ gbɛ̃́ↄnɛ lá wɛ́ lɛ́ ewao,","poem":1},{"lineBreak":true},{"text":"a yãkɛkɛnɛ́ lá àlɛ mawao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A yã́kpalɛkɛ taasideↄnɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"a dṹnia wɛ̃nadeↄ yãnakpámá.","poem":1},{"lineBreak":true},{"text":"Aà yã́ a dṹnia gbɛ̃́ↄ gbɛ̃ lán gowa,","poem":1},{"lineBreak":true},{"text":"a vãikɛnaↄ dɛdɛ ń a lɛ́'ĩanao.","poem":1},{"noteId":26}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A yã́zɛde kuluka báa ũ,","poem":1},{"lineBreak":true},{"text":"a náai dↄ a pi asana ũ.","poem":1},{"noteId":27}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Àwalɛwana aↄ ku sãnu ń sãnɛo,","poem":1},{"lineBreak":true},{"text":"gbɛaana a wúlɛ kↄ̃ saɛ ń bleo.","poem":1},{"lineBreak":true},{"text":"Gáaena ń nↄ̀ↄmusuo aa pↄble sãnu,","poem":1},{"lineBreak":true},{"text":"nɛ́fɛ̃nɛna mɛ́ a dↄaanɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zuda ń wàio aaↄ dɛ kↄ̃gbɛ̃ↄ ũ,","poem":1},{"lineBreak":true},{"text":"an nɛ́ↄ wúlɛ gudoũ.","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄkusi a sɛ̃ ble lán zuwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛ́ yↄ̃mina a kↄ̃̀ↄ'o kyã́ ɛlɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ kɛ̃a a ↄgɛ̃ píligonazi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ ì ń kɛ'ĩa ge pↄ́ pↄ́ ì ń dɛ","poem":1},{"lineBreak":true},{"text":"aↄ ku Dii gbɛ̀sĩsĩ pↄ́ a kua adoawao,","poem":1},{"noteId":28},{"lineBreak":true},{"text":"asa Dii dↄ̃a a li dṹniaaɛ,","poem":1},{"lineBreak":true},{"text":"lá í ì dagua ísiaiwa.","poem":1}]},{"type":"verse","number":10,"content":["Zĩbeezĩ Yɛse zĩ́na aↄ dɛ gudↄkↄ̃ɛkĩi ũ buiↄnɛ.",{"noteId":29},"Wa aà kĩ́i wɛɛlɛ mɛ́ aà kúkĩi aↄ gawi vĩ.",{"noteId":30}]},{"type":"verse","number":11,"content":["Zĩbeezĩ Dii a ɛa ↄbↄ a gɛ̃n plaade, i a gbɛ̃́ kↄ̃na pↄ́ gↄ̃̀ↄ bo. Aa bↄ Asili ń Egipio ń Etiopio ń Elaũo ń Babilonio ń Amatao ń ísia gũgũnaↄ."]},{"type":"verse","number":12,"content":[{"text":"A gudↄkↄ̃ɛkĩi dilɛ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"i Isaili zĩ̀zↄↄ kãaa.","poem":1},{"lineBreak":true},{"text":"A Yuda pↄ́ fãaaapiↄ sɛ́lɛ","poem":1},{"lineBreak":true},{"text":"za dṹnia gola síiↄ̃ↄwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ zaańgu a midɛ,","poem":1},{"lineBreak":true},{"text":"aaↄ za Yudaↄgu lↄo.","poem":1},{"lineBreak":true},{"text":"Yudaↄ íbɛlɛ a láa,","poem":1},{"lineBreak":true},{"text":"aa íbɛlɛsɛ ń Ɛflaiũ buiↄ lↄo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa lɛ́lɛ Filitɛ̃ↄ bùsuwa bɛ'aɛ,","poem":1},{"lineBreak":true},{"text":"aa gukpɛdeↄ pↄ́ↄ naaa sãnu.","poem":1},{"lineBreak":true},{"text":"Aa ↄtↄ̃ Ɛdↄũↄ ń Mↄabuↄwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ Amↄniↄ misiilɛnɛ́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii a to Egipi ísialɛ gↄ̃ gii,","poem":1},{"lineBreak":true},{"text":"a ↄmalɛ Uflatai ń a lɛ́'ĩan wãao,","poem":1},{"lineBreak":true},{"text":"i gↄ̃nakɛ̃ lɛɛ sopla,","poem":1},{"lineBreak":true},{"text":"wi buawà ń kyaleo kpaa.","poem":1},{"noteId":31}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A zɛda bↄ a guu a gbɛ̃́ kↄ̃na pↄ́ gↄ̃̀ Asiliↄnɛ,","poem":1},{"lineBreak":true},{"text":"lá a kɛ̀ Isailiↄnɛ gↄↄ pↄ́ aa bↄ̀ Egipiwa.","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"11.1 Zia 5.5, 22.16","reference":{"chapter":11,"verse":1}},{"noteId":26,"caller":"+","text":"11.4 2Tɛs 2.8","reference":{"chapter":11,"verse":4}},{"noteId":27,"caller":"+","text":"11.5 Ɛfɛ 6.14","reference":{"chapter":11,"verse":5}},{"noteId":28,"caller":"+","text":"11.9 Isa 65.25","reference":{"chapter":11,"verse":9}},{"noteId":29,"caller":"+","text":"11.10 Zãa 12.32","reference":{"chapter":11,"verse":10}},{"noteId":30,"caller":"+","text":"11.10 Lom 15.12","reference":{"chapter":11,"verse":10}},{"noteId":31,"caller":"+","text":"11.15 Zia 16.12","reference":{"chapter":11,"verse":15}}]},"thisChapterLink":"/api/bqc_sim/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}