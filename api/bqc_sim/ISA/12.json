{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Dii sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Zĩbeezĩ á o à mɛ:","poem":1},{"lineBreak":true},{"text":"Wa n sáaukɛ̀ Dii!","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ n pↄ pàwázi, n pↄ wèewá,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n wá nↄ̀sɛ nìniwɛ̃ɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lua mɛ́ wá Suabana ũ,","poem":1},{"lineBreak":true},{"text":"wáↄ aà náai vĩɛ, vĩa a wá kũo.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ wá gbãa ũ, aà táasi wi lɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ wá suabà.","poem":1},{"noteId":32}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Á ítↄ ń pↄnao suaba nibↄnaↄi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ á o à mɛ:","poem":1},{"lineBreak":true},{"text":"À Dii sáaukpa à aà sísi,","poem":1},{"lineBreak":true},{"text":"à to buiↄ aà yãkɛaↄ dↄ̃.","poem":1},{"lineBreak":true},{"text":"À onɛ́ Dii mɛ́ tↄbↄ̀ ado.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À lɛsi Diiɛ, asa à tidↄ̀ńlaɛ,","poem":1},{"lineBreak":true},{"text":"à to dṹnia gbɛ̃́pii yã́pi dↄ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ, à wiilɛ à gulakɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua pↄ́ a kua adoa zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a kú á guu.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"12.2 Bↄa 15.2, Soũ 118.14","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}