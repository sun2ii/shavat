{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":13,"content":[{"type":"heading","content":["Babɛli dúuzↄ̃a"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ Amↄzu nɛ́ Isaia è Babɛli musun kɛ:"]},{"type":"verse","number":2,"content":[{"text":"À gilili pɛ́lɛ sĩ̀sĩ wáiwai musu,","poem":1},{"lineBreak":true},{"text":"à kúkua dↄmá à ↄkɛnɛ́","poem":1},{"lineBreak":true},{"text":"aa si Wɛ̃́ɛↄ bↄlɛↄu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma yãdìlɛ ma gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma a gↄ̃sapiↄ sìsi","poem":1},{"lineBreak":true},{"text":"aa mↄ gɛ pↄkũmabↄbↄmámɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aalɛ pↄnakɛ ń ma tidↄańlao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kↄ̃fĩ lòo gbɛ̀sĩsĩↄ musu lán bíla kↄ̃fĩwa,","poem":1},{"lineBreak":true},{"text":"zↄa dↄ buipãleↄ guu lán bui dasiↄ kãaaawa.","poem":1},{"lineBreak":true},{"text":"Dii Zĩgↄ̃de mɛ́ lɛ́ a zĩgↄ̃ↄ kãaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa bↄ̀ bùsu zã̀zãↄu za dṹnia lɛ́wa,","poem":1},{"lineBreak":true},{"text":"Dii ń gbɛ̃́ pↄ́ aaì pↄkũmabↄbↄmáɛpiↄ","poem":1},{"lineBreak":true},{"text":"lɛ́ mↄ́ dṹnia kɛi kɛ́lɛkɛlɛ píi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À búbuapɛ, asa Dii gↄↄ kãikũ̀ɛ,","poem":1},{"lineBreak":true},{"text":"Gbãapiide mɛ́ a ń kaalɛ.","poem":1},{"noteId":33}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A yã́i baade ↄ a gↄ̃ dↄ̀lↄlↄ,","poem":1},{"lineBreak":true},{"text":"sↄ̃ a kɛ̃ gbɛ̃́piigu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gili a gɛ̃ńgu,","poem":1},{"lineBreak":true},{"text":"wãwã ń gu'ↄ̃amáo a tↄ̃́má.","poem":1},{"lineBreak":true},{"text":"Aaↄ pelembo lán nɛ'inawa,","poem":1},{"lineBreak":true},{"text":"yã́ a dimá, an wɛ́ i tã,","poem":1},{"lineBreak":true},{"text":"aaiↄ kↄ̃ gwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gwa! Dii yã́kpalɛkɛgↄↄ lɛ́ mↄ́,","poem":1},{"lineBreak":true},{"text":"aↄ pãsĩ, pↄbↄnniu ń fɛ̃́nkpaao aↄ ku,","poem":1},{"lineBreak":true},{"text":"a dṹnia kɛ kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"i duunkɛnaↄ dɛdɛu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Saan tↄdeↄ ń a kĩniↄ ikɛ lↄo,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃ a siakũ za a bilɛkĩi,","poem":1},{"lineBreak":true},{"text":"mↄvua a gupu lↄo.","poem":1},{"noteId":34}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Má ĩada dṹniawa a vãikɛa yã́i,","poem":1},{"lineBreak":true},{"text":"má gotↄ̃ duunkɛnaↄwa ń tàaeↄ yã́iɛ,","poem":1},{"lineBreak":true},{"text":"má waladeↄ yↄ̃̀ↄkɛa midɛ,","poem":1},{"lineBreak":true},{"text":"má gbɛ̃́ pãsĩↄ ĩ́andãa kpálɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má tó gbɛ̃nazĩnaↄ gↄ̃ kálaũkalaũ lán vua tɛ̃ɛtɛ̃ɛwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩnaↄ gↄ̃ kásakasa lán Ofii vuawa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yã́i tò ma Dii Zĩgↄ̃de má musu dee ma pↄkũma yã́i,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ i lualua za a zĩ́nau ma pↄpaa zↄ̃ↄ gↄↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Baade a ta a gbɛ̃́ↄ guu lán tue pↄ́ wàlɛ wɛwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii a bàalɛ ta a bùsuu lán sã pↄ́ dãna vĩoↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wa gbɛ̃́ pↄ́ wà kpàaũńnↄↄ zↄ̃,","poem":1},{"lineBreak":true},{"text":"wa gbɛ̃́ pↄ́ wà ń kṹↄ dɛdɛ ń fɛ̃ndao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wa ń nɛ́ↄ wíwi ń wáa,","poem":1},{"lineBreak":true},{"text":"wa ń kpɛ́ↄ yↄɛ, wi kɛ ń naↄnɛ ń gbãao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gwa! Má Mɛdɛↄ sóikɛmá.","poem":1},{"lineBreak":true},{"text":"An laai ku ã́nusuwao,","poem":1},{"lineBreak":true},{"text":"an bàa aↄ kú ń vuaoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa ɛ̀waasoↄ dɛdɛ ń kao,","poem":1},{"lineBreak":true},{"text":"aa nɛ́tɛ̃naↄ wɛ̃na boo,","poem":1},{"lineBreak":true},{"text":"aa nɛ́ↄ sósobi vĩo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Babɛliá kpalaↄ mideɛ,","poem":1},{"lineBreak":true},{"text":"Kaladeↄ ĩ́andãbↄ gawideɛ.","poem":1},{"lineBreak":true},{"text":"Ń beeo wa a suumpaɛ","poem":1},{"lineBreak":true},{"text":"lán Sↄdↄũ ń Gↄmↄↄo suumpaawa.","poem":1},{"noteId":35}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aↄ da bɛzia ũ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"waↄ ku we bau lↄo.","poem":1},{"lineBreak":true},{"text":"Laalubue a bòokpa weo,","poem":1},{"lineBreak":true},{"text":"pↄdãnae a i weo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbáa nↄ̀bↄↄ mɛ́ aaↄ kálɛa we,","poem":1},{"lineBreak":true},{"text":"a kpɛ́ↄ gↄ̃ gbɛ̃gbonaↄ tòo ũɛ.","poem":1},{"lineBreak":true},{"text":"Koohũhũnaↄ zↄ̃zↄ̃ we,","poem":1},{"lineBreak":true},{"text":"tã́aↄ i kìlimpau.","poem":1},{"noteId":36}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maiↄ wiilɛ a bĩ́iↄ sↄ̀ↄu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃gbonaↄ gbokɛ a namablekĩiↄu.","poem":1},{"lineBreak":true},{"text":"A gↄↄ kãikũ̀, a gↄↄ ga lↄo.","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"13.6 Yoɛ 1.15","reference":{"chapter":13,"verse":6}},{"noteId":34,"caller":"+","text":"13.10 Mat 24.29, Zia 6.12-13, 8.12","reference":{"chapter":13,"verse":10}},{"noteId":35,"caller":"+","text":"13.19 Daa 19.24","reference":{"chapter":13,"verse":19}},{"noteId":36,"caller":"+","text":"13.21 Zia 18.2","reference":{"chapter":13,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}