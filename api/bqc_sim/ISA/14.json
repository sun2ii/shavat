{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":14,"content":[{"type":"heading","content":["Isailiↄ sua ń pá ziu"]},{"type":"verse","number":1,"content":[{"text":"Dii a Yakↄbu buiↄ wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"a ɛa Isailiↄ si lↄ.","poem":1},{"lineBreak":true},{"text":"A ɛa ń kálɛ ń bùsuu,","poem":1},{"lineBreak":true},{"text":"buipãleↄ namá, aai kãaańnↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buipãleↄ gɛ́ zɛinɛ́ ń gbɛu,","poem":1},{"lineBreak":true},{"text":"Isailiↄ i gↄ̃ ń vĩ ń bùsuu.","poem":1},{"lineBreak":true},{"text":"Aaↄ dɛ ń zĩkɛnaↄ ũ gↄ̃ɛↄ ń nↄɛↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ń vĩ zↄ ũ yãaↄ gↄ̃ ń zↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ń gã lìnɛ́ ń kpɛↄ ↄ̃ aa gbãamↄnɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ ↄ̃ Dii a á gba ĩ́ampakĩi,","poem":1},{"lineBreak":true},{"text":"á taasikɛ lↄo, á liaazↄ̃ lↄo,","poem":1},{"lineBreak":true},{"text":"á zↄzĩ gbãa kɛ lↄo.","poem":1}]},{"type":"heading","content":["Babɛli kía yã́"]},{"type":"verse","number":4,"content":[{"text":"À yãada ń Babɛli kíao à mɛ:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃gãfĩna ku lↄo,","poem":1},{"lineBreak":true},{"text":"aà kãaa mìdɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii vãikɛnaↄ go ɛ̀,","poem":1},{"lineBreak":true},{"text":"à kpalablenapiↄ lípana zↄ̃̀ɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kíapi buiↄ gbɛ̃̀ò ń pↄfɛ̃o yãa ↄzɛsaiɛ,","poem":1},{"lineBreak":true},{"text":"à gbãa dɛnla kɛ̀nɛ́ ń pↄkũmao,","poem":1},{"lineBreak":true},{"text":"i kã́mabo ń ĩadaamáoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bùsu píi gↄ̃̀ niɛniɛ yãkelesai,","poem":1},{"lineBreak":true},{"text":"an gula dↄ sa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pɛ̃liↄ ń Libã bùsu sɛdɛ líↄ pↄ kɛ̀na n yã́ musu, aalɛ mɛ:","poem":1},{"lineBreak":true},{"text":"Za gↄↄ pↄ́ n lɛlɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lí mↄ́ wá zↄ̃i lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bɛda looa n yã́i za zĩ́lɛzĩlɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ mↄ́ dainlɛ.","poem":1},{"lineBreak":true},{"text":"Bui píi kíaↄ lɛ́ fɛlɛ ń kìlau,","poem":1},{"lineBreak":true},{"text":"dṹnia gbɛ̃zↄ̃ↄ gyaadeↄ lɛ́ gbãakpanzi ḿpii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa yã́sɛ ḿpii aa mɛ:","poem":1},{"lineBreak":true},{"text":"Mpi sↄ̃ n kɛwanↄ mùaa yã̀?","poem":1},{"lineBreak":true},{"text":"N gↄ̃ gbãasai láwáwa yã̀?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ĩ́andãa ń n táasi mↄↄna ↄ́o sì bɛdau la,","poem":1},{"lineBreak":true},{"text":"kↄ̀ↄbiiↄ mɛ́ gↄ̃̀ n pɛ ũ,","poem":1},{"lineBreak":true},{"text":"séseↄ mɛ́ n zwãa ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Saan nↄ̀ↄ'imina, gudↄlɛia nɛ́!","poem":1},{"lineBreak":true},{"text":"N bãɛ luabɛ n su zĩ́lɛ fá!","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ n buiↄ kàaũ","poem":1},{"lineBreak":true},{"text":"ↄ̃ wà n nɛ tↄↄlɛ.","poem":1},{"noteId":37}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ń ò n sↄ̃ guu n mɛ̀","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ gbã zↄ̃ luawaɛ,","poem":1},{"noteId":38},{"lineBreak":true},{"text":"ńyↄ̃ n kpala kã́fĩ e a vĩ saanaↄla,","poem":1},{"lineBreak":true},{"text":"ní zↄ̃lɛ diiↄ kↄ̃kãaakɛgbɛ pↄ́ kú gugbãntoo oi musu,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ní dɛdɛ ǹ vĩ luabɛpuanaa,","poem":1},{"lineBreak":true},{"text":"níↄ dɛ lán Musudewaɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɔ̃ n si bɛdau e a nↄnau.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ n e aↄ n gwa soee,","poem":1},{"lineBreak":true},{"text":"i làasookɛ à mɛ:","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ dṹnia lùa yãao lò?","poem":1},{"lineBreak":true},{"text":"Aàpi mɛ́ kpalaↄ gbã̀ɛo lò?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ tò dṹnia gↄ̃̀ guwaiwai ũ,","poem":1},{"lineBreak":true},{"text":"à a mɛɛwiaↄ dɛ̃ↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"ìli a zĩ̀zↄↄ gbaɛ aa tá ń bɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bui píi kíaↄ wúlɛa ń gawio","poem":1},{"lineBreak":true},{"text":"baade a kpɛ́ dↄngubↄ guu,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ↄ̃ wà n vũaa miagbɛsai","poem":1},{"lineBreak":true},{"text":"lán nɛ́ pↄ́ wa ì gɛ ũwa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wà ń zↄ̃zↄ̃ ń fɛ̃ndao","poem":1},{"lineBreak":true},{"text":"wà ń dɛdɛↄ kákaanla.","poem":1},{"lineBreak":true},{"text":"Wà n zu ɛu ń gbɛ̃́piↄɛ,","poem":1},{"lineBreak":true},{"text":"wà ↄ̃zↄ̃̀ n gɛwa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wa n mia kpakↄ̃i ń kíaↄo,","poem":1},{"lineBreak":true},{"text":"asa n n bùsu ↄ̃̀ↄkpàɛ,","poem":1},{"lineBreak":true},{"text":"n n gbɛ̃́ↄ dɛ̀dɛ.","poem":1},{"lineBreak":true},{"text":"Wa vãikɛnapi bui tↄ́ ma bauo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À aà nɛ́ↄ dɛdɛkĩi kɛkɛ","poem":1},{"lineBreak":true},{"text":"duuna pↄ́ an maeↄ kɛ̀ yã́i,","poem":1},{"lineBreak":true},{"text":"kɛ́ aasu gbãakũ aa gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"an wɛ̃́lɛↄ dṹnia pao yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀ má fɛlɛmá,","poem":1},{"lineBreak":true},{"text":"mí Babɛli tↄ́ dɛ ń a gbɛ̃́ kĩnina pↄ́ gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"an nɛ́ↄ ń ń buiↄ píi.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Má wɛ̃́lɛpi kɛ dã̀na ũɛ,","poem":1},{"lineBreak":true},{"text":"kpↄbↄ'ilɛnaↄ kákĩi ũ,","poem":1},{"lineBreak":true},{"text":"mí waa ń mɛ́sɛo mà kaalɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de mámɛ má ò.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Asiliↄ le"]},{"type":"verse","number":24,"content":[{"text":"Ma Dii Zĩgↄ̃de ma lɛgbɛ̃̀ ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Lá ma zɛò a kɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ má dà a zɛkɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Má Asiliↄ wíwi ma bùsuu,","poem":1},{"lineBreak":true},{"text":"má ↄ̃zↄ̃má ma gbɛ̀sĩsĩↄ musu.","poem":1},{"lineBreak":true},{"text":"Má ń zuu bↄlɛɛ́,","poem":1},{"lineBreak":true},{"text":"má ń asoↄ goɛ́ á gã̀u.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lá ma zɛò mà kɛ dṹniau píin we,","poem":1},{"lineBreak":true},{"text":"a yã́i ma ↄ looa bui píila.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de lá ma zɛòn we,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ kpamɛɛi?","poem":1},{"lineBreak":true},{"text":"Ma ↄ dↄa musu,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ siilɛi?","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Filitɛ̃ↄ le"]},{"type":"verse","number":28,"content":["Wɛ̃ pↄ́ kí Aaza gà,",{"noteId":39},"ↄ̃ Lua yã́ɛ bee ò:"]},{"type":"verse","number":29,"content":[{"text":"Filitɛ̃ↄ, ásu pↄnakɛ go pↄ́ á gbɛ̃́ ɛa yã́ musuo.","poem":1},{"lineBreak":true},{"text":"Mlɛ̃pi bui guu ↄ̃ mlɛ̃̀ pãsĩna a bↄu,","poem":1},{"lineBreak":true},{"text":"aà lɛ́ aↄ vãi mɛ́ aↄ wãa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Taaside búubuuↄ dã́dãkɛkĩi maa e,","poem":1},{"lineBreak":true},{"text":"wɛ̃nadeↄ wúlɛ ń laai musu.","poem":1},{"lineBreak":true},{"text":"Ãma má tó á zĩ́na ga ń nↄanaoɛ,","poem":1},{"lineBreak":true},{"text":"mí á gbɛ̃́ kĩnina pↄ́ gↄ̃̀ↄ dɛdɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛdeↄ, à wiilɛ!","poem":1},{"lineBreak":true},{"text":"Uadeↄ, à búbuapɛ!","poem":1},{"lineBreak":true},{"text":"Filitɛ̃ↄ ápii, à kɛ dↄ̃nↄnↄ,","poem":1},{"lineBreak":true},{"text":"asa súɛlɛ dↄ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"zĩgↄ̃ↄ kpaaĩa,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e kɛ̃a a deewao.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kpelewa wa o buiↄ zĩnaↄnɛi?","poem":1},{"lineBreak":true},{"text":"Wa onɛ́ Dii Siↄna kàlɛ,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ wɛ̃nadeↄ ulɛkĩi vĩ a guu.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"14.12 Zia 9.1","reference":{"chapter":14,"verse":12}},{"noteId":38,"caller":"+","text":"14.13 Mat 11.23","reference":{"chapter":14,"verse":13}},{"noteId":39,"caller":"+","text":"14.28 2Kia 16.20","reference":{"chapter":14,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}