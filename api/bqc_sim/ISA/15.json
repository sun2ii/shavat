{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":15,"content":[{"type":"heading","content":["Yã́ pↄ́ a Mↄabuↄ le"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ Lua ò Mↄabuↄ musun kɛ:",{"text":"Mↄabuↄ bùsu wɛ̃́lɛ Ala gbòo,","poem":1},{"lineBreak":true},{"text":"wà a suumpa gwãasĩn doɛ.","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ bùsu wɛ̃́lɛ Kii gbòo,","poem":1},{"lineBreak":true},{"text":"wà a suumpa gwãasĩn doɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dibↄ̃deↄ lɛ́ gɛ́ ↄ́ↄlↄi ń tã́akpɛu ń ń sa'okĩiↄwa.","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ búbua dↄ Nɛbo ń Mɛdebao yã́ musu.","poem":1},{"lineBreak":true},{"text":"Migbaalɛa ḿpii, lɛkãna waa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ ku zɛaↄu, zwã̀nkasaↄ kákaańla,","poem":1},{"lineBreak":true},{"text":"aa ku ua ń gãaɛo,","poem":1},{"lineBreak":true},{"text":"aalɛ ↄ́ↄlↄ, aalɛ pelembo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛsɛbↄ̃deↄ ń Ɛlealedeↄ búbua dↄ,","poem":1},{"lineBreak":true},{"text":"wàlɛ ń lↄↄ ma za Yaaza.","poem":1},{"lineBreak":true},{"text":"A yã́i tò Mↄabu zĩgↄ̃ↄ lɛ́ wiipɛ","poem":1},{"lineBreak":true},{"text":"e an nisĩna nàliwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Málɛ wɛ̃nakɛ Mↄabuↄnɛ ma sↄ̃ guu,","poem":1},{"lineBreak":true},{"text":"an lala'onaↄ lɛ́ tá Zoaa","poem":1},{"lineBreak":true},{"text":"e à gɛ̀ pɛ̀ Egala Selisiawa.","poem":1},{"lineBreak":true},{"text":"Aalɛ Luiti sĩ̀sĩ kṹ ń ↄↄlↄo,","poem":1},{"lineBreak":true},{"text":"aa bɛ Olonaiũ zɛ́u,","poem":1},{"lineBreak":true},{"text":"aalɛ ń wíwia búbuapɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asa Niũliũ í bà, a sɛ̃ gàgaɛ,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀ ísi làa, lá ísi kú lↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa àizɛɛ pↄ́ aa è aa kàlɛↄ sɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ taò swa gbalade baa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Búbua lìgua Mↄabu bùsu zↄ̃lɛu,","poem":1},{"lineBreak":true},{"text":"wà ń ↄↄlↄ mà e à gɛ̀ pɛ̀ Egelaiũwa,","poem":1},{"lineBreak":true},{"text":"wà ń tã̀aapɛapi mà Bɛɛ'ɛliũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dibↄ̃ íↄ gà ń auo,","poem":1},{"lineBreak":true},{"text":"asi má ɛa kpa Dibↄ̃zi lↄɛ.","poem":1},{"lineBreak":true},{"text":"Má nↄ̀ↄmusu gbaɛ Mↄabu lala'onaↄwa","poem":1},{"lineBreak":true},{"text":"ń ń bùsu gbɛ̃́ kĩninaↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}