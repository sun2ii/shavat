poem":1},{"lineBreak":true},{"text":"áↄ gugwa za a kúkĩi kílikili,","poem":1},{"lineBreak":true},{"text":"lá ĩatɛ̃ ìↄ pipi tↄↄlɛwawa,","poem":1},{"lineBreak":true},{"text":"lá lou ìↄ ku masai pↄkɛkɛgↄↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E wàↄ gɛ́ pↄkɛkɛi,","poem":1},{"lineBreak":true},{"text":"e vɛ̃ɛvu àↄ gɛ́ láai a nɛsoenaↄ kã́kã,","poem":1},{"lineBreak":true},{"text":"a a gↄ̃naↄ zↄ̃zↄ̃ ń fɛ̃nkĩnio,","poem":1},{"lineBreak":true},{"text":"a a ↄ pↄ́ a tàↄ ɛ́'ɛ kↄ́lɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wa ń tó gbɛ̀sĩsĩ bãↄ ń wàiↄ blɛ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩ bãↄ saɛ bleńnↄ,","poem":1},{"lineBreak":true},{"text":"wàiↄ i buziɛbleńnↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gↄↄ bee bui gbã̀a mɛ̀ yↄ̀lↄ pↄ́ wì vĩakɛnɛ́ gupiiuↄ,","poem":1},{"lineBreak":true},{"text":"bui pãsĩ pↄ́ aaì ↄ̃zↄ̃ ń ibɛɛↄwa mɛ́ swaↄ ń bùsu zↄ̃̀ɛzↄ̃ɛↄ","poem":1},{"lineBreak":true},{"text":"aa mↄ Dii Zĩgↄ̃de gba pↄ́ Siↄna gbɛ̀sĩsĩ musu,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ aà tↄ́ kuwàpiu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}