{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":2,"content":[{"type":"heading","content":["Dii gbɛ̀sĩsĩ"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ Amↄzu nɛ́ Isaia è Yuda bùsu ń Yelusalɛũo musun kɛ:"]},{"type":"verse","number":2,"content":[{"text":"Gↄↄgbɛzãzĩ Dii kpɛ́ gbɛ̀sĩsĩ","poem":1},{"lineBreak":true},{"text":"a gↄ̃ gbɛ̀sĩsĩↄ mide ũ.","poem":1},{"lineBreak":true},{"text":"Wa sɛ lɛsĩ dɛ sĩ̀sĩↄla,","poem":1},{"lineBreak":true},{"text":"bui píi i siu we.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dasi a gɛ́ we aai mɛ:","poem":1},{"lineBreak":true},{"text":"À mↄ wà Dii gbɛ̀sĩsĩkũ,","poem":1},{"lineBreak":true},{"text":"wà gɛ́ Yakↄbu buiↄ Lua kpɛ́u,","poem":1},{"lineBreak":true},{"text":"i wá da a zɛ́wa, wíↄ bɛu.","poem":1},{"lineBreak":true},{"text":"Dii yãdaanɛ́ a bↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"aà yã́ a bↄ Yelusalɛũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A yã́gↄ̃gↄ̃ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"a yãkɛkɛ dasiↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai ń fɛ̃ndaↄ gbɛ̃gbɛ̃ lilɛ soona ũ,","poem":1},{"lineBreak":true},{"text":"an sↄ̃naↄ sↄ̃ máaso limibobↄ ũ.","poem":1},{"noteId":5},{"lineBreak":true},{"text":"Buie a fɛ̃nda sɛ a deezio,","poem":1},{"lineBreak":true},{"text":"wa zĩkaa dada lↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yakↄbu buiↄ, à mↄ́,","poem":1},{"lineBreak":true},{"text":"wàↄ bɛ Dii gupuau.","poem":1}]},{"type":"heading","content":["Dii yã́kpalɛkɛgↄↄzĩ"]},{"type":"verse","number":6,"content":[{"text":"N n gbɛ̃́ Yakↄbu buiↄ vũ̀aa,","poem":1},{"lineBreak":true},{"text":"asa gukpɛ oi yã́ tↄ̃̀máɛ.","poem":1},{"lineBreak":true},{"text":"Aa ↄdìdi màso yã́wa lán Filitɛ̃ↄwaɛ,","poem":1},{"lineBreak":true},{"text":"aa kↄ̃ ↄ kũ̀ ń buipãleↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ãnusu ń vuao di ń bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"an àizɛɛↄ lɛ́ vĩo.","poem":1},{"lineBreak":true},{"text":"Sↄ̃́ di ń bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"an zĩkasↄ̃goↄ lɛ́ vĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ aa kɛ̀ tã́aↄ ũ di ń bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"aaì kulɛkɛ ń ↄzĩpiↄnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ gↄ̃ suuunnↄ,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃ yɛ̀ɛɛ.","poem":1},{"lineBreak":true},{"text":"Ńsu sùuukɛńnↄo!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bàalɛ Dii zↄ̃ↄkɛ gawi pↄ́ ì to vĩa ń kũɛ,","poem":1},{"lineBreak":true},{"text":"ní sↄlↄ gbɛu, ní ulɛ ɛu.","poem":1},{"noteId":6}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waladeↄ mi a gↄ̃ pɛ́lɛa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ ĩ́andãa a midɛ.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ a tↄbↄ ado gↄↄ beezĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dii Zĩgↄ̃de gↄↄdìlɛ","poem":1},{"lineBreak":true},{"text":"yↄ̃̀ↄdeↄnɛ ń waladeↄ píi","poem":1},{"lineBreak":true},{"text":"ń ĩ́andãna pↄ́ aaì ńzĩa sɛ lɛsĩↄ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Libã bùsu sɛdɛ lí gbã̀a zↄ̃ↄↄ","poem":1},{"lineBreak":true},{"text":"ń Basana bùsu gbɛ̃́nɛliↄ píi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gbɛ̀sĩsĩ misonaↄ","poem":1},{"lineBreak":true},{"text":"ń sĩ̀sĩ lɛsĩlɛsĩↄ píi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kalanga lɛsĩↄ","poem":1},{"lineBreak":true},{"text":"ń bĩ́i gbãaↄ píi,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"gó'ilɛna laatanaↄ","poem":1},{"lineBreak":true},{"text":"ń gó'ilɛna bɛɛɛdeↄ píi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna wala a kpálɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ yↄ̃̀ↄkɛa a busa.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ a tↄbↄ ado gↄↄbeezĩ,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tã́aↄ i gɛ̃lɛ míↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tó Dii fɛ̀lɛ ń dṹnia kpoɛao,","poem":1},{"lineBreak":true},{"text":"wa bàalɛ aà zↄ̃ↄkɛ gawi pↄ́ ì to vĩa ń kũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ ta gbɛ̀'ɛↄ guu ń vukpɛ'ɛↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ aa ń tã́a pↄ́ wa pì ń ã́nusuo ń vuao","poem":1},{"lineBreak":true},{"text":"wà kúlɛnɛ́ kↄ́lɛ ɛ̃́naↄnɛ ń sasiↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tó Dii fɛ̀lɛ ń dṹnia kpoɛao,","poem":1},{"lineBreak":true},{"text":"wa bàalɛ aà zↄ̃ↄkɛ gawi pↄ́ ì to vĩa ń kũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ sↄlↄ gbɛ̀'ɛↄ ń gbɛ̀sↄↄↄ guu.","