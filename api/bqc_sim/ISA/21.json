{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"heading","content":["Yã́ pↄ́ a Babɛli le"]},{"type":"verse","number":1,"content":["Gbáa pↄ́ pãa ísiai yã́.",{"text":"Lá zàa'ĩana ì pã Nɛgɛvɛa,","poem":1},{"lineBreak":true},{"text":"màa wà bↄ̀ bùsu pↄ́ wa a vĩa vĩu,","poem":1},{"lineBreak":true},{"text":"wàlɛ pã guwaiwaia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wɛ́pungu pↄ́ má èpi yã́ pãsĩ.","poem":1},{"lineBreak":true},{"text":"Pↄkaalɛna lɛ́ pↄ́ kaalɛ,","poem":1},{"lineBreak":true},{"text":"zĩbↄnkpɛde lɛ́ bↄ ń kpɛ.","poem":1},{"lineBreak":true},{"text":"Elaũↄ, à lɛ́lɛmá!","poem":1},{"lineBreak":true},{"text":"Mɛdɛↄ, à koezↄ̃ńzi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ má è tò ma lɛ́ gↄ̃̀ kpaaũa,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ má mà ma da bíliu.","poem":1},{"lineBreak":true},{"text":"A wãwã ma kũ gbãa, àlɛ ma wó paa,","poem":1},{"lineBreak":true},{"text":"à fɛ̀lɛmanↄ lá nↄwãwã ì fɛlɛ nↄɛwawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iwãa kà ma pↄa,","poem":1},{"lineBreak":true},{"text":"gili gɛ̃̀magu, málɛ lualua.","poem":1},{"lineBreak":true},{"text":"Oosi mɛ́ ma si,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à mↄ̀mɛɛ ń kpakpanagaao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wàlɛ blɛkalɛ táabũnu musu,","poem":1},{"lineBreak":true},{"text":"wàlɛ pɛ kpálɛkpalɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ pↄble, wàlɛ imi.","poem":1},{"lineBreak":true},{"text":"Zĩgↄ̃ↄ gbɛ̃zↄ̃ↄↄ,","poem":1},{"lineBreak":true},{"text":"à fɛlɛ à á gↄ̃kɛbↄↄ sɛ́lɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ Dii òmɛɛn kɛ:","poem":1},{"lineBreak":true},{"text":"Gɛ ǹ gbɛ̃́ dilɛ gugwakĩi,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ a è i o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó à sↄ̃́ↄ è kpaaĩa plapla,","poem":1},{"lineBreak":true},{"text":"aalɛ zĩkagoↄ gá","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ↄ didia zàa'ĩnaↄ kpɛ ń yiongoↄ,","poem":1},{"lineBreak":true},{"text":"aàↄ kú ń laaio maamaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃ gugwanapi wiilɛ̀ à mɛ̀: Dii,","poem":1},{"lineBreak":true},{"text":"miↄ zɛ ma gugwakĩi lá gu lɛ́ dↄɛ,","poem":1},{"lineBreak":true},{"text":"miↄ ku ma limusudakĩi gwã́ ń gwã́o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gwa! Sↄ̃́ kpaaĩa plapla gode lɛ́ mↄ́.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ godepi mɛ̀: À gà! Babɛli gà!","poem":1},{"noteId":40},{"lineBreak":true},{"text":"A diiↄ kálɛa tↄↄlɛ wíwia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ wà á gbɛ̃́ lán pↄ́wɛnawaↄ,","poem":1},{"lineBreak":true},{"text":"ma yã́ pↄ́ má mà Dii Zĩgↄ̃de Isailiↄ Luawa òɛ́.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Ɛdↄũↄ le"]},{"type":"verse","number":11,"content":[{"text":"Duma yã́.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e lɛ́ lɛzumazi za Sei à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gudↄ̃ana, gusia kà kpelewai?","poem":1},{"lineBreak":true},{"text":"Gudↄ̃ana, gusia kà kpelewai?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃ gudↄ̃ana òɛ̀: Gu lɛ́ mↄ́ dↄiɛ,","poem":1},{"lineBreak":true},{"text":"kási gu a gi àↄ siaɛ.","poem":1},{"lineBreak":true},{"text":"Tó ń ye yãlaɛ, la, ní ɛa su lↄ.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a wi Laalubuↄ musu"]},{"type":"verse","number":13,"content":[{"text":"Laalubuↄ yã́.","poem":1},{"lineBreak":true},{"text":"Á Dedã kyaama pↄ́ ì bòokpa Laalubuↄ bùsu likpɛnauↄ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"à gɛ́ dai imidɛnaↄlɛ ń ío.","poem":1},{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á kú Tema bùsuuↄ,","poem":1},{"lineBreak":true},{"text":"à gɛ́ dai lala'onaↄlɛ ń pↄbleao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Asa aalɛ bàalɛ fɛ̃ndaɛɛ,","poem":1},{"lineBreak":true},{"text":"fɛ̃nda wɛ́tɛ̃ ń sákãao ń zĩ̀ pãsĩoɛ.","poem":1}]},{"type":"verse","number":16,"content":["Dii òmɛɛ à mɛ̀: Wɛ̃̀ do lɛ́u lán gbɛ̀wina zĩgↄↄ lɛdilɛawa, Kedaaↄ gawi a láa."]},{"type":"verse","number":17,"content":["Kedaa gↄ̃sa kadeↄ bↄ dasio. Dii Isailiↄ Lua mɛ́ ò."]}],"footnotes":[{"noteId":40,"caller":"+","text":"21.9 Zia 14.8, 18.2","reference":{"chapter":21,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}