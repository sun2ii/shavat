{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":22,"content":[{"type":"heading","content":["Yã́ pↄ́ a Yelusalɛũdeↄ le"]},{"type":"verse","number":1,"content":["Wɛ́pungu'ea guzulɛu yã́.",{"text":"Bↄ́mɛ á lé a dɛdɛ á kpɛ́ musu píii?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛ súu gbãade gbɛ̃́ↄ!","poem":1},{"lineBreak":true},{"text":"Wɛ̃́lɛ pↄna kↄ̃fĩde gbɛ̃́ↄ!","poem":1},{"lineBreak":true},{"text":"I kɛ fɛ̃nda mɛ́ á gbɛ̃́ↄ dɛ̀dɛo,","poem":1},{"lineBreak":true},{"text":"aai gaga zĩ guuo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Á dↄaanaↄ kpàkↄ̃ɛ aa bàalɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wà ń naaa, wà ń kũkũ kazusai.","poem":1},{"lineBreak":true},{"text":"Wà á gbɛ̃́ pↄ́ wà ń éↄ kũ̀kũ,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ aa bàalɛ̀ tà zã̀zã.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ayãmɛto ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À gomala, à to mà ↄ́ↄlↄ wɛ̃nannↄ.","poem":1},{"lineBreak":true},{"text":"Ásu wɛɛlɛ ma nↄ̀sɛ nínimɛɛ","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ pↄ́ gàgaↄ yã́ musuo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de gↄↄdìlɛ.","poem":1},{"lineBreak":true},{"text":"Zↄa ń ↄ̃zↄ̃amáo ń gilio","poem":1},{"lineBreak":true},{"text":"aↄ ku Wɛ́pungu'ea Guzulɛu","poem":1},{"lineBreak":true},{"text":"ń bĩ́igbooao ń wiilɛa gbɛ̀sĩsĩ musuo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Elaũↄ ń gbàlaↄ sɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ mↄ́ ń sↄ̃deↄ ń sↄ̃́godeↄ.","poem":1},{"lineBreak":true},{"text":"Kiiↄ ń sɛ̀ngbaoↄ sɛ̀ lɛ́ dↄdↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sↄ̃́goↄ di á guzulɛ táaedeↄu,","poem":1},{"lineBreak":true},{"text":"sↄ̃deↄ zɛzɛ á wɛ̃́lɛ bĩ́ibↄlɛↄu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yudaↄ gia ń ńzĩao zɛvĩ lↄo.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ zĩ́ bee sa a á zĩkabↄↄ wɛ̀ɛlɛ","poem":1},{"lineBreak":true},{"text":"kpɛ́ pↄ́ wì mɛ Líkpɛ Kpɛ́u.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Á è Davidi wɛ̃́lɛ bĩ́i gufooↄ dasi,","poem":1},{"lineBreak":true},{"text":"a i kũ̀sũa dì íkalɛkĩi pↄ́ kú zĩ́lɛ guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A Yelusalɛũ kpɛ́ↄ nào,","poem":1},{"lineBreak":true},{"text":"a kpɛ́eↄ gbòo à a bĩ́i tàtaò.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A íkalɛkĩipi kɛ̀ wɛ̃́lɛ guu","poem":1},{"lineBreak":true},{"text":"íkalɛkĩi zi plaade ũ,","poem":1},{"lineBreak":true},{"text":"ãma i wɛdↄ Lua pↄ́ mↄ̀ ń yã́piozio,","poem":1},{"lineBreak":true},{"text":"i Lua pↄ́ yã́pi dìlɛ za zi yãdao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩ́ bee Dii Lua Zĩgↄ̃de á sisi","poem":1},{"lineBreak":true},{"text":"à ↄ́ↄlↄ, à búbuapɛ, à á mi wa,","poem":1},{"lineBreak":true},{"text":"í zwã̀nkasa kákaála,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ↄ̃ á kú pↄnakɛa guu ń yaalↄo.","poem":1},{"lineBreak":true},{"text":"A zuↄ ń sãↄ dɛ̀dɛ,","poem":1},{"lineBreak":true},{"text":"álɛ nↄ̀ↄ só, álɛ vɛ̃ɛmi,","poem":1},{"lineBreak":true},{"text":"álɛ mɛ: Wà pↄble, wà imi,","poem":1},{"lineBreak":true},{"text":"asa wá ga ziaɛ.","poem":1},{"noteId":41}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii Zĩgↄ̃de kã̀mɛɛ ma swã́wa à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Á duunapi kɛ̃awá vĩo e à gɛ gaò.","poem":1},{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de mɛ́ ò.","poem":1}]},{"type":"heading","content":["Kibɛ ziia Sɛbena"]},{"type":"verse","number":15,"content":[{"text":"Yã́ pↄ́ Dii Lua Zĩgↄ̃de òn kɛ:","poem":1},{"lineBreak":true},{"text":"Fɛlɛ gɛ o kibɛ ziia Sɛbenaɛ:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bↄ́ ń vĩ lai? Dé ń vĩ la","poem":1},{"lineBreak":true},{"text":"ↄ̃ ńlɛ mia'ɛ sↄ nzĩaɛ la,","poem":1},{"lineBreak":true},{"text":"ńlɛ gbɛsi yↄ̃́ musumusu n vĩkĩi ũi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Laaika gↄ̃sa!","poem":1},{"lineBreak":true},{"text":"Dii a n kũ n zu!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A n koo lán banↄↄwa,","poem":1},{"lineBreak":true},{"text":"i ń gbeembo e bùsu yàasau.","poem":1},{"lineBreak":true},{"text":"We ńyↄ̃ gau,","poem":1},{"lineBreak":true},{"text":"n sↄ̃́go gawideↄ i gↄ̃ we.","poem":1},{"lineBreak":true},{"text":"N dii ua kpɛbↄnan n ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Má n bↄ zĩuɛ,","poem":1},{"lineBreak":true},{"text":"má n kɛ̃ n gweawaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má a zↄ̀blena","poem":1},{"lineBreak":true},{"text":"Ilikia nɛ́ Ɛliakiũ sísi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"mí n ula daɛ̀, mí n asana dↄɛ̀,","poem":1},{"lineBreak":true},{"text":"mí n kpala kpawà aàↄ kũa,","poem":1},{"lineBreak":true},{"text":"iↄ dɛ Yelusalɛũdeↄ mae ũ","poem":1},{"lineBreak":true},{"text":"ń Yudaↄ píi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má Davidi bɛ kili daɛ̀ a gã̀u,","poem":1},{"lineBreak":true},{"text":"a zɛwɛ̃, gbɛ̃e a fↄ̃ tao,","poem":1},{"lineBreak":true},{"text":"a zɛta, gbɛ̃e a fↄ̃ wɛ̃o.","poem":1},{"noteId":42}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Má aà pɛ kálo ũ gĩ̀ gbãawa,","poem":1},{"lineBreak":true},{"text":"aà zↄ̃lɛkĩi aↄ maa,","poem":1},{"lineBreak":true},{"text":"i aà de bɛdeↄ kpɛla.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ãma aà de bɛdeↄ a loowà ḿpii,","poem":1},{"lineBreak":true},{"text":"an nɛ́ↄ ń ń buiↄ ń ń ta keleↄ píi,","poem":1},{"lineBreak":true},{"text":"sɛa dodãbↄↄ e olaↄwa.","poem":1}]},{"type":"verse","number":25,"content":["Dii Zĩgↄ̃de mɛ̀, zĩ́ bee kálo pↄ́ wa pɛ̀ gĩ̀ gbãawapi a fu, a kaso lɛ́lɛ, aso pↄ́ loowàↄ i wíwi. Dii mɛ́ ò."]}],"footnotes":[{"noteId":41,"caller":"+","text":"22.13 1Kln 15.32","reference":{"chapter":22,"verse":13}},{"noteId":42,"caller":"+","text":"22.22 Zia 3.7","reference":{"chapter":22,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}