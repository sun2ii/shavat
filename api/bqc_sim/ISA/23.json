{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":23,"content":[{"type":"heading","content":["Yã́ pↄ́ a Tiideↄ le23.0 Mat 11.21-22"]},{"type":"verse","number":1,"content":[{"text":"Tii yã́. Ísia gó'ilɛnadeↄ,","poem":1},{"lineBreak":true},{"text":"à ↄ́ↄlↄ, asa Tii gↄ̃̀ yàaaɛ,","poem":1},{"lineBreak":true},{"text":"kpɛ́e i gↄ̃ lↄo, godↄkĩi kú lↄo.","poem":1},{"lineBreak":true},{"text":"Sipi bùsudeↄ mɛ́ baopi kpànɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À kɛ kílikili ísialɛdeↄ","poem":1},{"lineBreak":true},{"text":"ń Sidↄ̃ laatana pↄ́ aa kã̀ ísiatagɛnaↄ musuↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bua pↄ́ kú Niili saɛ mɛ́ Tiideↄ pↄ'ekĩi ũ.","poem":1},{"lineBreak":true},{"text":"We aaì pↄ́wɛna lúluu wà buaò í zↄ̃ↄwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Tii gↄ̃̀ buiↄ ɛlɛblekĩi ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sidↄ̃deↄ ń ísia gũgũna wɛ̃́lɛ bĩ́ideↄ,","poem":1},{"lineBreak":true},{"text":"á gɛɛ a gↄ̃ kpá á wɛ́iɛ, asa ísia mɛ̀:","poem":1},{"lineBreak":true},{"text":"Mi nↄwãwãkɛo, mi nɛ'io,","poem":1},{"lineBreak":true},{"text":"mi nɛgↄ̃ɛ gwao, mi nɛnↄɛ tòlokɛo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó Egipiↄ Tiideↄ baopi mà,","poem":1},{"lineBreak":true},{"text":"aa bã̀abãabo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À bua ta Taasisi,","poem":1},{"lineBreak":true},{"text":"à ↄ́ↄlↄ á ísialɛdeↄ!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Á wɛ̃́lɛ pↄnade pↄ́ kálɛa za zin weo lò?","poem":1},{"lineBreak":true},{"text":"Wɛ̃́lɛpi gbɛ̃eↄ mɛ́ fã̀aa","poem":1},{"lineBreak":true},{"text":"aa gɛ̀ zↄ̃̀lɛ bùsu zã̀zãↄuo lò?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tiideↄ gbɛ̃́ↄ kpà kpalau yãa,","poem":1},{"lineBreak":true},{"text":"an laatanaↄá kíaↄnɛ,","poem":1},{"lineBreak":true},{"text":"an pↄyianaↄ tↄbↄ̀ dṹniau.","poem":1},{"lineBreak":true},{"text":"Démɛ dìlɛ yã́pi Tii lei?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de mɛ́ dìlɛ","poem":1},{"lineBreak":true},{"text":"à ĩ́andãnapiↄ gawi kↄ'ɛ,","poem":1},{"lineBreak":true},{"text":"i gbɛ̃́ pↄ́ aa tↄbↄ̀ dṹniaupiↄ busa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taasisiↄ, à dagua lán Niili í paawa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à kpáɛ́ lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii ↄlòo ísiaa,","poem":1},{"lineBreak":true},{"text":"a tò bùsu pↄ́ kú a saɛↄ lùalua.","poem":1},{"lineBreak":true},{"text":"À yãdìlɛ Kanaa bùsu yã́ musu,","poem":1},{"lineBreak":true},{"text":"à mɛ̀ wà a wɛ̃́lɛ bĩ́ideↄ dɛɛlɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À mɛ̀: Sidↄ̃ wɛ̃́lɛ","poem":1},{"lineBreak":true},{"text":"pↄ́ gbɛ̃e i zĩblema yãao,","poem":1},{"lineBreak":true},{"text":"wà lɛ̀lɛma ń gbãao saɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ e ĩ́anadã lↄo.","poem":1},{"lineBreak":true},{"text":"Tó a fɛlɛ bua íwa e Sipi bùsuu,","poem":1},{"lineBreak":true},{"text":"baa wekĩi á ĩ́ampakĩi eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À bùsupi gwa,","poem":1},{"lineBreak":true},{"text":"Babiloniↄ tò à gↄ̃̀ gbɛ̃gbonaↄ tòo ũ,","poem":1},{"lineBreak":true},{"text":"i kɛ Asiliↄ no.","poem":1},{"lineBreak":true},{"text":"Aa gbà lɛsĩ dà wa kpàaĩ ń a bĩ́iↄ,","poem":1},{"lineBreak":true},{"text":"aa a kpɛ́ maaↄ dɛ̀ɛlɛ,","poem":1},{"lineBreak":true},{"text":"gupi gↄ̃̀ yáiyai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ísia gó'ilɛnadeↄ, à ↄ́ↄlↄ,","poem":1},{"lineBreak":true},{"text":"asa á wɛ̃́lɛ gbãa gↄ̃̀ yàaaɛ.","poem":1}]},{"type":"verse","number":15,"content":["Gↄↄ bee Tii yã́ a sã gbɛ̃́ↄgu wɛ̃̀ bàaↄ̃kwi lán kía wɛ̃̀ dasilɛwa. Tó wɛ̃̀ bàaↄ̃kwipi làa, lá wa ò lɛ pↄ́ wa dà ń káaluao guuwa, màa aↄ dɛ ń Tiio wà mɛ̀:"]},{"type":"verse","number":16,"content":[{"text":"Káalua pↄ́ gbɛ̃e lɛ́ mↄma lↄo,","poem":1},{"lineBreak":true},{"text":"ǹ n mↄↄna sɛ da wɛ̃́lɛa.","poem":1},{"lineBreak":true},{"text":"Lɛ maamaa, ní lɛↄ siò dasidasi,","poem":1},{"lineBreak":true},{"text":"kɛ́ n yã́ e dↄ gbɛ̃́ↄgu yã́i.","poem":1}]},{"type":"verse","number":17,"content":["Wɛ̃̀ bàaↄ̃kwipi gbɛa Dii a ɛa aɛdↄ Tiiwa. Tii a ɛa na a laataawa, i káaluaka ń dṹnia bùsuↄ píi."]},{"type":"verse","number":18,"content":["Aà zĩa yíaa ài aↄ dɛ Dii pↄ́ ũɛ. Wa àipi dilɛo, wa ulɛo, aↄ dɛ Dii sìsinaↄ pↄ́ ũɛ, kɛ́ aa e pↄble maamaa, aai pↄkasa ↄdeↄ lú."]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}