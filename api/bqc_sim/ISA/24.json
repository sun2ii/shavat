{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["Yã́ pↄ́ a dṹnia le"]},{"type":"verse","number":1,"content":[{"text":"Gwa! Dii a dṹnia to da pã, a a dɛɛlɛmpaɛ.","poem":1},{"lineBreak":true},{"text":"A tↄↄlɛ fĩaa, i a gbɛ̃́ↄ fãaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lá aↄ dɛ ń gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń sa'onaↄ.","poem":1},{"lineBreak":true},{"text":"Lá aↄ dɛ ń zↄ̀ↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń ń diiↄ.","poem":1},{"lineBreak":true},{"text":"Lá aↄ dɛ ń nɛnↄɛnaↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń ń daↄ.","poem":1},{"lineBreak":true},{"text":"Lá aↄ dɛ ń pↄlunaↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń pↄyianaↄ.","poem":1},{"lineBreak":true},{"text":"Lá aↄ dɛ ń pↄsɛ̃anaↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń pↄdeↄ.","poem":1},{"lineBreak":true},{"text":"Lá aↄ dɛ ń fĩasɛnaↄ,","poem":1},{"lineBreak":true},{"text":"màa aↄ dɛ ń fĩadeↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dṹnia da pã láilai ↄ̃̀ↄkpaa.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ yã́pi ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dṹnia gↄ̃̀ wɛ̃nannↄ sìtiũ!","poem":1},{"lineBreak":true},{"text":"Tↄↄlɛ gↄ̃̀ ↄↄↄnnↄ búɛbuɛ!","poem":1},{"lineBreak":true},{"text":"Dṹnia gbɛ̃́ gbiaↄ gↄ̃̀ yɛ̃̀ɛɛsai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dṹnia ↄ̃̀ↄkpà a gbɛ̃́ pↄ́ kúuↄ yã́i,","poem":1},{"lineBreak":true},{"text":"asa aa pã̀ Dii ikoyãa,","poem":1},{"lineBreak":true},{"text":"aa bↄ̀ yã́ pↄ́ a dìlɛↄ kpɛɛ,","poem":1},{"lineBreak":true},{"text":"aa aà bàakuańnↄ gↄↄpii yã́ gbòo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ayãmɛto dṹnia gↄ̃̀ láaipↄ ũ,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃́ↄ ń tàaeↄ gbɛ'è.","poem":1},{"lineBreak":true},{"text":"Ayãmɛto dṹnia gbɛ̃́ↄ tɛkũ̀,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ gↄ̃̀ↄ dasio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vɛ̃ɛ dafu lɛ́ fɛ̃́ tùuu,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛliↄ giigàga,","poem":1},{"lineBreak":true},{"text":"pↄnakɛnaↄ lɛ́ we zàũzaũ ḿpii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pↄna gã̀a'ↄ kɛ̀ kílikili,","poem":1},{"lineBreak":true},{"text":"kↄ̃̀ↄ'onaↄ kↄ̃fĩ nì,","poem":1},{"lineBreak":true},{"text":"pↄna mↄↄna kɛ̀ kyↄ̃́!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wàlɛ vɛ̃ɛmi ń lɛtɛ̃o lↄo,","poem":1},{"lineBreak":true},{"text":"wɛ̃ kĩ̀sãkũ̀ a minaↄ lɛ́u.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛ gↄ̃̀ da pã,","poem":1},{"lineBreak":true},{"text":"ua lɛ́ↄ kàka píi, gbɛ̃e lɛ́ gɛ̃ lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zↄa dↄ gãaɛ vɛ̃ɛsai yã́i,","poem":1},{"lineBreak":true},{"text":"yaalↄ lì oosisi ũ míↄ,","poem":1},{"lineBreak":true},{"text":"pↄna gò dṹniaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛ gↄ̃̀ kaaũa,","poem":1},{"lineBreak":true},{"text":"a bↄlɛↄ kɛ̀ kɛ́lɛkɛlɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Màa aↄ dɛ bui píiɛ dṹnia guu.","poem":1},{"lineBreak":true},{"text":"Aↄ dɛ lán kukɛawa,","poem":1},{"lineBreak":true},{"text":"lá wà kpa kↄ̃nwɛ̀ wa làawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gbɛ̃eↄ lɛ́ wii gbãa lɛ́,","poem":1},{"lineBreak":true},{"text":"aalɛ gulakɛ,","poem":1},{"lineBreak":true},{"text":"bɛ'aɛdeↄ wiidↄ Dii zↄ̃ↄkɛ yã́ musu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A yã́i gukpɛdeↄ, à Dii táasilɛ,","poem":1},{"lineBreak":true},{"text":"ísiabaadeↄ à Dii Isailiↄ Lua tↄbↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wálɛ lɛ ma dↄ za dṹnia lɛ́wa","poem":1},{"lineBreak":true},{"text":"wàlɛ mɛ: Gbɛ̃maa kɛfɛna!","poem":1},{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀: Waiyoo mapi!","poem":1},{"lineBreak":true},{"text":"Ma kaalɛn kɛ́waa?","poem":1},{"lineBreak":true},{"text":"Ma kaalɛn kɛ́waa?","poem":1},{"lineBreak":true},{"text":"Zĩ̀bↄnkpɛdeↄ bↄ̀ ń kpɛ,","poem":1},{"lineBreak":true},{"text":"náaisaideↄ náaisaiyãkɛ̀nɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gili ń ɛo ń baio lɛ́ á dã́ dṹnia gbɛ̃́ↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ bàalɛ gili súuɛ a zu ɛpi guuɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ bai a gbɛ̃́ pↄ́ bↄ̀ ɛpi guu kṹ.","poem":1},{"lineBreak":true},{"text":"Lou pↄ̀ↄfↄ̃̀, dṹnia dèe e a zĩ́nau.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tↄↄlɛ pàa à wì,","poem":1},{"lineBreak":true},{"text":"dṹnia dèe gbã́ugbãu!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dṹnia lɛ́ kɛ tàlaatalaa","poem":1},{"lineBreak":true},{"text":"lán wɛ̃dɛnawa,","poem":1},{"lineBreak":true},{"text":"àlɛ kɛ dɛ̀gɛɛdɛgɛɛ","poem":1},{"lineBreak":true},{"text":"lán gbà lɛsĩwa.","poem":1},{"lineBreak":true},{"text":"Aà tàae gbia mɛ́ tↄ̃̀wà,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛlɛ, a e fɛlɛ lↄo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gↄↄ bee Dii a ĩada malaika gbãadeↄwa musu","poem":1},{"lineBreak":true},{"text":"ń dṹnia kíaↄ zĩ́lɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A ń naaa ń ká ɛ̀ zòolou,","poem":1},{"lineBreak":true},{"text":"a gbatańlɛ lán dakpɛunaↄwa,","poem":1},{"lineBreak":true},{"text":"tó à gↄↄplakɛ̀, i yã́gↄ̃gↄ̃ńnↄ.","poem":1},{"noteId":43}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wí a mↄvua kṹ,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃ gɛɛ a gↄ̃ kpa a wɛ́i,","poem":1},{"lineBreak":true},{"text":"asa Dii Zĩgↄ̃de mɛ́ a kible Yelusalɛũ,","poem":1},{"lineBreak":true},{"text":"a tↄbↄ Siↄna gbɛ musu gbɛ̃zↄ̃ↄↄ wáa.","poem":1}]}],"footnotes":[{"noteId":43,"caller":"+","text":"24.22 Zia 20.3","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}