{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":25,"content":[{"type":"heading","content":["Dii sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Dii, ma Luan n ũ, má n kpɛla, má n tↄbↄ,","poem":1},{"lineBreak":true},{"text":"asa ń náai vĩ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"n yãbↄnsaɛ pↄ́ n zɛò za zi kɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N mɛɛwia kɛ̀ gbɛ̀zɛ ũ,","poem":1},{"lineBreak":true},{"text":"n wɛ̃́lɛ bĩ́ide dɛ̀ɛlɛ.","poem":1},{"lineBreak":true},{"text":"Buipãleↄ wɛ̃́lɛ bĩ́ide dɛ wɛ̃́lɛ ũ lↄo,","poem":1},{"lineBreak":true},{"text":"mɛ́ wa ɛa kálɛ bau lↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayãmɛto bui gbãaↄ n kpɛla,","poem":1},{"lineBreak":true},{"text":"bui pãsĩↄ aaↄ n vĩa vĩ ń wɛ̃́lɛu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń dɛ aafia'ekĩi ũ yɛ̃̀ɛɛsaideↄnɛ,","poem":1},{"lineBreak":true},{"text":"ń dɛ ulɛkĩi ũ wɛ̃nadeↄnɛ ń yooyeau.","poem":1},{"lineBreak":true},{"text":"Ń dɛ mikpakĩi ũ lou zã́,","poem":1},{"lineBreak":true},{"text":"ń dɛ uena ũ ĩatɛ̃ zã́,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃́ pãsĩↄ lɛ́'ĩana dɛ","poem":1},{"lineBreak":true},{"text":"lán lou gĩgbɛ̃awaɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"aa dɛ lán ĩatɛ̃ pusuwa guwaiwaiu.","poem":1},{"lineBreak":true},{"text":"Ni buipãlepiↄ zↄa midɛ,","poem":1},{"lineBreak":true},{"text":"lá lou ue ì ĩatɛ̃ pusu kpálɛwa.","poem":1},{"lineBreak":true},{"text":"Màa gbɛ̃́ pãsĩpiↄ kúkua ì zɛ kyↄ̃́!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii Zĩgↄ̃de a dikpɛ blɛ kɛ bui píiɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩɛ bee musu ń blɛ asaao","poem":1},{"lineBreak":true},{"text":"ń nↄ̀ↄ nísideo ń vɛ̃ɛ maa kↄↄsↄkɛao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩɛ bee musu ↄ̃","poem":1},{"lineBreak":true},{"text":"a sálana pↄ́ kú bui píi wɛ́a bãdɛ,","poem":1},{"lineBreak":true},{"text":"zwãa pↄ́ kú bùsu píi gbɛ̃́ↄlapi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A ga midɛ, aↄ ku lↄo,","poem":1},{"noteId":44},{"lineBreak":true},{"text":"a wɛ́'i gogo gbɛ̃́piiɛ,","poem":1},{"noteId":45},{"lineBreak":true},{"text":"a wibↄ a gbɛ̃́ↄnɛ dṹnia guu píi.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gↄↄ bee wa mɛ: Wá Luan kɛ,","poem":1},{"lineBreak":true},{"text":"wa wɛdↄ̀aàzi, ↄ̃ à wá suabà.","poem":1},{"lineBreak":true},{"text":"Diin kɛ, wá wɛ́ dↄaàzi.","poem":1},{"lineBreak":true},{"text":"Wà pↄnakɛ wà yáalↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à wá suabà yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii ↄ aↄ ku gbɛ̀sĩsĩɛ beea,","poem":1},{"lineBreak":true},{"text":"ãma a ↄ̃zↄ̃ Mↄabuↄwa,","poem":1},{"lineBreak":true},{"text":"lá wì ↄ̃zↄ̃ sɛ̃wa zùgbↄ̃uwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa ↄkɛ a guu","poem":1},{"lineBreak":true},{"text":"lá kpáa'ona ì íliwa.","poem":1},{"lineBreak":true},{"text":"Baa ń ń ↄkɛapio,","poem":1},{"lineBreak":true},{"text":"Dii a ń ĩ́andãa kↄ'ɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A ń bĩ́i gbãa lɛsĩↄ gboo,","poem":1},{"lineBreak":true},{"text":"a pã́lɛ zĩ́lɛ à daaĩ ń bùsutio.","poem":1}]}],"footnotes":[{"noteId":44,"caller":"+","text":"25.8 1Kln 15.54","reference":{"chapter":25,"verse":8}},{"noteId":45,"caller":"+","text":"25.8 Zia 7.17, 21.4","reference":{"chapter":25,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}