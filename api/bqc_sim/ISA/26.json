{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":26,"content":[{"type":"heading","content":["Dii náaikɛnaↄ lɛ"]},{"type":"verse","number":1,"content":[{"text":"Gↄↄ bee wa lɛɛ bee si Yuda bùsuu wà mɛ:","poem":1},{"lineBreak":true},{"text":"Wá wɛ̃́lɛ gbãa vĩ,","poem":1},{"lineBreak":true},{"text":"Lua ì to a bĩ́i ń a zɛgikĩiↄ wá suaba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À bĩ́ibↄlɛↄ wɛ̃, bui maa i gɛ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaliↄ Dii náai vĩↄ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aà sↄ̃ ìↄ dilɛa","poem":1},{"lineBreak":true},{"text":"ↄ̃ ni aà nↄ̀sɛ daɛ̀ doũ wásawasa,","poem":1},{"lineBreak":true},{"text":"kɛ́ a n náai vĩ yã́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àↄ Dii náai vĩ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ gbɛsi pↄ́ ìↄ ku gↄↄpii ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́ pↄ́ aaì bɛkpa musuↄ kwɛ́,","poem":1},{"lineBreak":true},{"text":"ì wɛ̃́lɛ pↄ́ kálɛa lɛsĩↄ bãɛ","poem":1},{"lineBreak":true},{"text":"à pã́lɛ zĩ́lɛ à daaĩ ń bùsutio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Taasideↄ ↄ̃zↄ̃wà,","poem":1},{"lineBreak":true},{"text":"wɛ̃nadeↄ kɛ̀sɛ tↄ̃wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nↄ̀sɛpuadeↄ zɛ́ ìↄ pooa,","poem":1},{"lineBreak":true},{"text":"ni gbɛ̃maaↄ kua kɛkɛnɛ́ wásawasa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ao Dii, wá kú ń yã́ pↄ́ n zɛòo zɛ́u,","poem":1},{"lineBreak":true},{"text":"wá wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"n tↄ́ ń n yã́ dↄawáguo wá kãsì.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi n nidɛ gwãasĩna,","poem":1},{"lineBreak":true},{"text":"tó gu dↄ̀, mi n kĩ́i wɛɛlɛ.","poem":1},{"lineBreak":true},{"text":"Tó n yã́kpalɛkɛ̀ ń dṹniao,","poem":1},{"lineBreak":true},{"text":"zĩ́lɛdeↄ ì yã́zɛde dada.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baa tó wà sùuukɛ̀ ń gbɛ̃vãio,","poem":1},{"lineBreak":true},{"text":"ìli zɛ́ súsu sɛo.","poem":1},{"lineBreak":true},{"text":"Vãi ì fɛlɛò dↄ̀ↄdeↄ bùsuu,","poem":1},{"lineBreak":true},{"text":"ìli Dii zↄ̃ↄkɛ yãdao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii, n ↄ looańla,","poem":1},{"lineBreak":true},{"text":"kási aali eo,","poem":1},{"lineBreak":true},{"text":"to aa ãia pↄ́ ń vĩ ń n gbɛ̃́ↄ e,","poem":1},{"lineBreak":true},{"text":"wí i ń kṹ.","poem":1},{"lineBreak":true},{"text":"To tɛ́ pↄ́ ń dìlɛ ń ibɛɛↄnɛ kṹmá.","poem":1},{"noteId":46}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii, ni wá gba aafia,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ wá kɛ̀ píi, ḿmɛ ń kɛ̀wɛ̃ɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii wá Lua,","poem":1},{"lineBreak":true},{"text":"dii pãleↄ gbãablèwá,","poem":1},{"lineBreak":true},{"text":"ń beeo ḿmɛ wi n tↄbↄ ado.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa gàga aa ku lↄo,","poem":1},{"lineBreak":true},{"text":"an gɛↄ lí vuo,","poem":1},{"lineBreak":true},{"text":"asa n ĩadàmá n ń mìdɛ,","poem":1},{"lineBreak":true},{"text":"ń tò an yã́ dↄ gbɛ̃egu lↄo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N wá bui kↄ̃̀, Dii, n wá bui kↄ̃̀,","poem":1},{"lineBreak":true},{"text":"n nzĩa tↄbↄ̀,","poem":1},{"lineBreak":true},{"text":"ń tò wá bùsu zↄ̃lɛↄ ↄtà píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aa n kĩ́i wɛ̀ɛlɛ ń yooyea guu,","poem":1},{"lineBreak":true},{"text":"Dii, kɛ́ n ń toto,","poem":1},{"lineBreak":true},{"text":"aa wabikɛ̀ma wɛ̃nannↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lá nↄsindee pↄ́ kà nɛ'ia ì dɛ̃ɛka,","poem":1},{"lineBreak":true},{"text":"ì wiilɛ wãwã guu,","poem":1},{"lineBreak":true},{"text":"màa wá kú n aɛ yãa, Dii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wa nↄsì wa dɛ̃ɛkà,","poem":1},{"lineBreak":true},{"text":"ń beeo wa nɛ'ì ĩ́ana ũɛ.","poem":1},{"lineBreak":true},{"text":"Wi e wà dṹnia bↄ̀o,","poem":1},{"lineBreak":true},{"text":"wi nɛ́ↄ i aaↄ ku tↄↄlɛo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ gàↄ vu, aaiↄ ku,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú tɛ̃́ɛnauↄ bↄ gau, aai gulakɛ.","poem":1},{"lineBreak":true},{"text":"N mↄ̀sɛ a pↄ́ fɛlɛ lán kↄↄ fíiwa,","poem":1},{"lineBreak":true},{"text":"gɛ pↄ́ kú tↄↄlɛ guuↄ i bↄlɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ, à fɛlɛ gɛ̃ á kpɛ́u,","poem":1},{"lineBreak":true},{"text":"í zɛtaálɛ à ulɛ gĩa yↄↄ","poem":1},{"lineBreak":true},{"text":"e aà pↄkũma gɛ̃zɛa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gwa! Dii bↄ̀ a kúkĩi,","poem":1},{"lineBreak":true},{"text":"àlɛ mↄ́ dṹnia gbɛ̃́ↄ tàae wiinɛ́ ń musu.","poem":1},{"lineBreak":true},{"text":"Tↄↄlɛ a gbɛ̃́ pↄ́ wà ń dɛdɛↄ ulɛ lↄo,","poem":1},{"lineBreak":true},{"text":"a bↄ ń gbɛ̃́piↄ auo gupuauɛ.","poem":1}]}],"footnotes":[{"noteId":46,"caller":"+","text":"26.11 Ɛbɛ 10.27","reference":{"chapter":26,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}