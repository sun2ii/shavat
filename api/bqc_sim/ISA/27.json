k":true},{"text":"mà tɛsↄ̃má míↄ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sema aa ma sí ń ulɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"aai kɛmanↄ na,","poem":1},{"lineBreak":true},{"text":"ao, aai kɛmanↄ na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gↄↄewa Yakↄbu buiↄ zĩ́napɛlɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ bↄlↄbↄ, aai vukɛ,","poem":1},{"lineBreak":true},{"text":"an libɛↄ i li dṹniaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii ń gbɛ̃́ lá à bui pↄ́ ń gbɛ̃́ↄ gbɛ̃̀wae?","poem":1},{"lineBreak":true},{"text":"Dii ń dɛdɛ lá à gbɛ̃́ pↄ́ ń dɛdɛↄ dɛ̀dɛwae?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii a yã́kpalɛkɛńnↄ,","poem":1},{"lineBreak":true},{"text":"i ń yá ń gbaɛ.","poem":1},{"lineBreak":true},{"text":"A bↄ ń a ĩ́an pãsĩo gukpɛ oi,","poem":1},{"lineBreak":true},{"text":"i ń sɛ́lɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bee a láka Yakↄbu buiↄ tàaeↄla.","poem":1},{"lineBreak":true},{"text":"An duunakɛ̃ama gbɛn kɛ:","poem":1},{"lineBreak":true},{"text":"Aa ń sa'okĩi gbɛↄ wíwi kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aali pↄ́ wa pɛ̀ tã́a ũↄ","poem":1},{"lineBreak":true},{"text":"ń ń tulaletikatɛakĩiↄ zↄ̃zↄ̃ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wɛ̃́lɛ bĩ́ide gↄ̃̀ bɛzĩ ũ adoa,","poem":1},{"lineBreak":true},{"text":"a dɛ gu pↄ́ wà pãkpài ũ lán gbáa wáiwaiwa.","poem":1},{"lineBreak":true},{"text":"Wekĩi zuↄ ì pↄbleu, aai wúlɛu,","poem":1},{"lineBreak":true},{"text":"aai a líↄ suumpa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó a gↄ̃naↄ gàga,","poem":1},{"lineBreak":true},{"text":"nↄɛↄ mↄ ɛ́'ɛ wa tɛ́kaò.","poem":1},{"lineBreak":true},{"text":"Wɛ̃́lɛpideↄ nↄ̀sɛ vĩo,","poem":1},{"lineBreak":true},{"text":"a yã́i tò an Kɛna a ń wɛ̃nagwao,","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ ń ikàsa a sùuukɛńnↄo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gↄↄ bee Dii a a pↄ́wɛna gbɛ̃","poem":1},{"lineBreak":true},{"text":"za Uflata pↄ́ a í lí zↄ̃ɛoi","poem":1},{"lineBreak":true},{"text":"e à gɛ pɛ Egipi zɛ́ swawa,","poem":1},{"lineBreak":true},{"text":"i á Isailiↄ pɛɛlɛ dodo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gↄↄ bee wa kã̀ae zↄ̃ↄ pɛ́,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ vũ̀aa Asili bùsuuↄ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ lala'ò tà Egipi bùsuuↄ","poem":1},{"lineBreak":true},{"text":"aai ɛa su kúlɛ Diiɛ Yelusalɛũ","poem":1},{"lineBreak":true},{"text":"a gbɛ̀sĩsĩ pↄ́ a kua adoa musu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}