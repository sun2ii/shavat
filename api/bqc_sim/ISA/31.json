{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":31,"content":[{"type":"heading","content":["Waiyoo gbɛ̃́ pↄ́ aa sↄ̃kpàlɛ Egipiↄziↄ"]},{"type":"verse","number":1,"content":[{"text":"Waiyoo gbɛ̃́ pↄ́ aaì gɛ́ dↄnlɛ wɛɛlɛi Egipi,","poem":1},{"lineBreak":true},{"text":"aaì gbãa'e ń sↄ̃́ↄwa,","poem":1},{"lineBreak":true},{"text":"aaì ń zĩkasↄ̃go dasiↄ náaikɛ","poem":1},{"lineBreak":true},{"text":"ń ń sↄ̃de pↄ́ lɛ́ vĩoↄ.","poem":1},{"lineBreak":true},{"text":"Aali wɛ́pɛ Isailiↄ Lua pↄ́ a kua adoawao,","poem":1},{"lineBreak":true},{"text":"aali Dii kĩ́i wɛɛlɛo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kási aàpi sↄ̃ a zĩka'ↄ̃nↄ vĩ,","poem":1},{"lineBreak":true},{"text":"ì yã́yiamá, mɛ́ ìli lɛlilɛo.","poem":1},{"lineBreak":true},{"text":"A fɛlɛ gbɛ̃vãiↄwa","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ aaì dↄ vãikɛnapiↄlɛↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egipiↄá Lua no, gbɛ̃nazĩnaↄnɛ!","poem":1},{"lineBreak":true},{"text":"An sↄ̃́ↄá Lua Nisĩna no, pↄ́ audeↄnɛ!","poem":1},{"lineBreak":true},{"text":"Tó Dii ↄ lòońla,","poem":1},{"lineBreak":true},{"text":"an dↄnlɛdeↄ gɛ̃mbↄlɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aalɛ dↄńlɛↄ lɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"aa midɛ sãnu ḿpii.","poem":1}]},{"type":"verse","number":4,"content":["Dii yã́ɛ bee òmɛɛ à mɛ̀:",{"text":"Tó nↄ̀ↄmusu lɛ́ hɛ̃̀ɛkɛ a pↄbleawa,","poem":1},{"lineBreak":true},{"text":"mɛ́ wà pↄdãnaↄ kã̀aaaàzi dasi,","poem":1},{"lineBreak":true},{"text":"lá an wiidↄawà vĩa a aà kũo,","poem":1},{"lineBreak":true},{"text":"mɛ́ an zↄa a aà kãdɛo,","poem":1},{"lineBreak":true},{"text":"màa Dii Zĩgↄ̃de a pila zĩkai","poem":1},{"lineBreak":true},{"text":"Siↄna gbɛwa ń a sĩ̀sĩↄnaↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lá bã ìↄ gí ń a nɛ́ↄ,","poem":1},{"lineBreak":true},{"text":"màa Dii a gí ń Yelusalɛũo.","poem":1},{"lineBreak":true},{"text":"A giò, a aà suaba,","poem":1},{"lineBreak":true},{"text":"a maaàla, a aà bↄ.","poem":1}]},{"type":"verse","number":6,"content":["Isailiↄ, à ɛa zɛ ń Lua pↄ́ a bↄ aà yã́u pãsĩpãsĩo sa."]},{"type":"verse","number":7,"content":["Asa gↄↄ bee á baade a gí tã́a pↄ́ a pì azĩaɛ ń ã́nusuo ń vuaozi."]},{"type":"verse","number":8,"content":[{"text":"Wa Asiliↄ kwɛ́ ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"i kɛ gbɛ̃nazĩna no.","poem":1},{"lineBreak":true},{"text":"Fɛ̃nda pↄ́ dɛ gↄ̃ɛ pↄ́ ũo mɛ́ a ń dɛdɛ.","poem":1},{"lineBreak":true},{"text":"Aa wí ń bao fɛ̃ndapi lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"wi zↄzĩda ń ɛ̀waasoↄnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vĩa a ń kía kṹ à gↄ̀ↄgↄↄbo,","poem":1},{"lineBreak":true},{"text":"iwãa a ká ń dↄaanaↄ pↄa,","poem":1},{"lineBreak":true},{"text":"aai ń dàlapoo to daa we.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ yã́pi ò.","poem":1},{"lineBreak":true},{"text":"Aà tɛ́ dↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"aà kĩna ku Yelusalɛũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}