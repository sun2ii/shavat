{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":32,"content":[{"type":"heading","content":["Kía maa kpala"]},{"type":"verse","number":1,"content":[{"text":"Gwa! Kíae a kpalable ń yã́zɛdeo,","poem":1},{"lineBreak":true},{"text":"aà ìwaↄ kible a zɛ́wa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"An baade aↄ dɛ ulɛkĩi ũ zàa'ĩanaɛ,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ mikpakĩi ũ lou zã́,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ swa ide ũ gbáau,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ gbɛsi zↄ̃ↄ uede ũ gugiiu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛbiibiinaↄ wɛ́ a kɛ̃ sa,","poem":1},{"lineBreak":true},{"text":"swãkpanaↄ yãma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nↄnwãadeↄ ↄ̃nↄkũ aa yã́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"bebedeↄ yã'o sa káukau iwesasai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wa mɛ sↄũɛ bɛɛɛde lↄo,","poem":1},{"lineBreak":true},{"text":"wa mɛ kↄ̃nideɛ gbɛ̃maa lↄo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asa sↄũ ì yãfaasai o,","poem":1},{"lineBreak":true},{"text":"aà làasoo ìↄ ku yãvãiwa.","poem":1},{"lineBreak":true},{"text":"Ìli zĩkɛ Lua yã́wao,","poem":1},{"lineBreak":true},{"text":"ì Dii seela bɛ̃̀ɛ kɛnɛ́.","poem":1},{"lineBreak":true},{"text":"Ì nↄandɛnaↄ to gii,","poem":1},{"lineBreak":true},{"text":"ì imidɛnaↄ to isai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kↄ̃nide yãkɛaↄ vãi,","poem":1},{"lineBreak":true},{"text":"ì vãikpaaĩ ń taasideↄ","poem":1},{"lineBreak":true},{"text":"à ń ↄ̃̀ↄkpa ń mↄafilio,","poem":1},{"lineBreak":true},{"text":"i wɛ̃nadepiↄ yã́ málɛnɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛɛɛde ì yã́zɛde yá,","poem":1},{"lineBreak":true},{"text":"yã́ bɛɛɛde ↄ̃ ì zɛò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Á nↄɛ namablenaↄ,","poem":1},{"lineBreak":true},{"text":"à fɛlɛ swãdↄmazi,","poem":1},{"lineBreak":true},{"text":"á nↄɛ pↄ́ á kú niɛniɛↄ,","poem":1},{"lineBreak":true},{"text":"à ma yãma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Á nↄɛ pↄ́ á kú niɛniɛↄ","poem":1},{"lineBreak":true},{"text":"á gↄ̃ ń bílio zii maa'i,","poem":1},{"lineBreak":true},{"text":"asa vɛ̃ɛkↄzↄ̃zↄ̃a aↄ kuo,","poem":1},{"lineBreak":true},{"text":"ésekɛkɛa a kɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Á nↄɛ pↄ́ álɛ namableↄ,","poem":1},{"lineBreak":true},{"text":"à lualua ń sↄ̃̀deedeeo.","poem":1},{"lineBreak":true},{"text":"Á nↄɛ pↄ́ á kú niɛniɛↄ,","poem":1},{"lineBreak":true},{"text":"à kpakpanaga.","poem":1},{"lineBreak":true},{"text":"À á pↄ́ↄ wolowá píi,","poem":1},{"lineBreak":true},{"text":"í zwã̀nkasaↄ dↄ á pi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À ázĩa gbɛ̃gbɛ̃, í búbuapɛ","poem":1},{"lineBreak":true},{"text":"á bua maaↄ ń á vɛ̃ɛ nɛ'inaↄ yã́i.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À ↄ́ↄlↄ ma gbɛ̃́ↄ bùsu yã́i,","poem":1},{"lineBreak":true},{"text":"asa lɛaa ń lɛsikaoo bↄ̀lɛu.","poem":1},{"lineBreak":true},{"text":"À ↄ́ↄlↄ á ua pↄnadeↄ","poem":1},{"lineBreak":true},{"text":"ń á wɛ̃́lɛ naɛ beeo yã́i.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kibɛ a gↄ̃ da pã,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ súude a gↄ̃ bɛzia ũ.","poem":1},{"lineBreak":true},{"text":"A sĩ̀sĩ gudↄ̃akĩi aↄ da wáiwai gↄↄpii","poem":1},{"lineBreak":true},{"text":"zàa'ĩnaↄ pↄnakɛkĩi ũɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ↄ dã́dãkɛkĩi ũ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"e Lua àↄ gɛ́ a Nisĩna pisiiwá bↄa za musu,","poem":1},{"lineBreak":true},{"text":"gbáa i gbasa gↄ̃ gutaaede ũ,","poem":1},{"lineBreak":true},{"text":"gutaaede sↄ̃ dào ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yã́zɛde a kible gbáapiu,","poem":1},{"lineBreak":true},{"text":"maakɛa aↄ ku gutaaedepiu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yã́zɛdepi a aafia inɛ́,","poem":1},{"lineBreak":true},{"text":"maakɛa gbɛ aↄ dɛ kua dↄdↄa ń sↄ̃daadoũo ũ gↄↄpii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ aaↄ ku ua aafiadeu,","poem":1},{"lineBreak":true},{"text":"an bɛ aↄ niɛ,","poem":1},{"lineBreak":true},{"text":"aa kã́mabou nama guu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa tó lougbɛ likpɛ ↄ̃̀ↄkpà,","poem":1},{"lineBreak":true},{"text":"mɛ́ wà wɛ̃́lɛ dɛɛlɛmpà wa dàaĩ,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"áↄ dɛ pↄnadeↄ ũ,","poem":1},{"lineBreak":true},{"text":"áↄ pↄtↄ̃tↄ̃ swa píi saɛ,","poem":1},{"lineBreak":true},{"text":"á zuↄ ń á zàa'ĩnaↄ dɛ̀ɛpookĩi e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}