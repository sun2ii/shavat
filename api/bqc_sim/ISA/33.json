{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":33,"content":[{"type":"heading","content":["Yelusalɛũ suabaa yã́"]},{"type":"verse","number":1,"content":[{"text":"Waiyoo gbɛ̃'ↄ̃ↄkpana,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ pↄ́ wi n ↄ̃̀ↄkpa yãao!","poem":1},{"lineBreak":true},{"text":"Waiyoo zĩbↄnkpɛde,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ pↄ́ wi bↄ n kpɛ yãao!","poem":1},{"lineBreak":true},{"text":"Tó n gbɛ̃́ ↄ̃̀ↄkpà ń làa,","poem":1},{"lineBreak":true},{"text":"wa n ↄ̃̀ↄkpa sↄ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Tó n bↄ gbɛ̃́ↄ kpɛ ń làa,","poem":1},{"lineBreak":true},{"text":"wa bↄ n kpɛ sↄ̃ɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii, wá wɛgwa, wálɛ sↄ̃́anzi.","poem":1},{"lineBreak":true},{"text":"Ǹyↄ̃ dↄwálɛ lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"ní wá suaba wá taasikɛgↄↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó n kolokɛ̀kɛ, wì lɛ́kↄ̃waɛ","poem":1},{"lineBreak":true},{"text":"tó n fɛlɛ, buiↄ ì fãaaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ ń pↄ́ↄwa","poem":1},{"lineBreak":true},{"text":"lá kwaↄ ì lɛ́lɛ buapↄ́ↄwawa,","poem":1},{"lineBreak":true},{"text":"wa ń pↄ́ↄ símá","poem":1},{"lineBreak":true},{"text":"lá kwasutɛ̃ↄ ì kɛnɛ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii sáa kuo, asa a ku musu,","poem":1},{"lineBreak":true},{"text":"a to yã́zɛde ń maakɛao li Siↄnaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii aↄ dɛ ń zĩ́mpɛlɛ ũ gↄↄ bee,","poem":1},{"lineBreak":true},{"text":"aafia ń ↄ̃nↄo ń dↄ̃ao aↄ diɛ.","poem":1},{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ ì mↄ́ ń àizɛɛpio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwa! Gↄ̃sa gbãaↄ wiidↄ gãaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ wà ń zĩ́ awakpaipiↄ lɛ́ ↄ́ↄlↄ wɛ̃nannↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zɛdaↄ lɛ́ sɛ́ lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lɛ́ gu baa vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"lɛdoũ ku lↄo, wàlɛ saka seelaↄu,","poem":1},{"lineBreak":true},{"text":"wa kↄ̃ bɛɛɛ dↄ̃ lↄo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bùsu lɛ́ wɛ̃nakɛ, à gↄ̃̀ zeesai,","poem":1},{"lineBreak":true},{"text":"Libã gↄ̃̀ ń wío, à mùakũ̀.","poem":1},{"lineBreak":true},{"text":"Salↄna guzulɛ gↄ̃̀ lán gbáawa,","poem":1},{"lineBreak":true},{"text":"Basana ń Kaamɛlio gↄ̃̀ gii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma Dii ma mɛ̀ má fɛlɛ sa,","poem":1},{"lineBreak":true},{"text":"má a gbãa ↄlↄnɛ́, mí tↄbↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A nↄsì sɛ̃pisa ũ,","poem":1},{"lineBreak":true},{"text":"a nɛ'ì sɛ̃̀ giina ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄbↄa ma níu dɛ tɛ́ pↄ́ a kṹwá ũɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ tɛ́kũ aa gↄ̃ túfu ũ","poem":1},{"lineBreak":true},{"text":"lán kàelɛ zↄ̃zↄ̃a pↄ́ wà tɛsↄ̃̀wàwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á kú zã̀zãↄ,","poem":1},{"lineBreak":true},{"text":"à yã́ pↄ́ má kɛ̀ ma,","poem":1},{"lineBreak":true},{"text":"á gbɛ̃́ pↄ́ á kú kãiↄ,","poem":1},{"lineBreak":true},{"text":"àↄ ma gↄ̃sakɛ dↄ̃.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gili gɛ̃̀ Siↄna duunkɛnaↄgu,","poem":1},{"lineBreak":true},{"text":"luayãdansaipiↄ lɛ́ kpakpanaga.","poem":1},{"lineBreak":true},{"text":"Wá démɛ a fↄ̃ àↄ kú ń tɛ́ pↄkaalɛnaoi?","poem":1},{"lineBreak":true},{"text":"Wá démɛ a fↄ̃ àↄ kú ń tɛ́ gasaipioi?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"mɛ́ ì yãmaa o,","poem":1},{"lineBreak":true},{"text":"a za gbɛ̃ble'aigu,","poem":1},{"lineBreak":true},{"text":"mɛ́ ì ↄbↄlɛ gbagusaɛ yã́u,","poem":1},{"lineBreak":true},{"text":"ìli swã́sɛ gbɛ̃dɛyãio,","poem":1},{"lineBreak":true},{"text":"mɛ́ ìliↄ ye à wɛsi vãilɛo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ aↄ ku aafia musu,","poem":1},{"lineBreak":true},{"text":"aà ulɛkĩi aↄ gbãa gbɛ̀sↄↄu.","poem":1},{"lineBreak":true},{"text":"Ali pↄblea e we,","poem":1},{"lineBreak":true},{"text":"mɛ́ í a kɛ̃́sãwào.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ńyↄ̃ wɛsi kía kɛfɛnkɛlɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ bùsu e kãaa yàasa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ làasookɛ gili pↄ́ kɛ̀ yãawa n sↄ̃ guu, ní mɛ:","poem":1},{"lineBreak":true},{"text":"Naokɛna ku máɛ la?","poem":1},{"lineBreak":true},{"text":"Ɔsina ku máɛ la?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì dↄ̃ nao ku máɛ la?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ gbɛ̃́ pↄ́ aaì yã'o ń ↄopiↄ e lↄo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ gbɛ̃́ pↄ́ nili ń buiyã maopiↄ yã'o ma lↄo,","poem":1},{"lineBreak":true},{"text":"bui zĩ̀lo pↄ́ ń ń yã́ gbadↄ̃opiↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Siↄna pↄ́ wì dikpɛkɛu gwa,","poem":1},{"lineBreak":true},{"text":"wɛsi Yelusalɛũlɛ,","poem":1},{"lineBreak":true},{"text":"a ku aafia zwã̀akpɛ pↄ́ wa sↄ̃òo ũ.","poem":1},{"lineBreak":true},{"text":"Wa a lipɛlɛↄ wúlɛ bauo,","poem":1},{"lineBreak":true},{"text":"mɛ́ a bae a kɛ̃o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wekĩi Dii a a zↄ̃ↄkɛ ↄlↄwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ swadaↄ ń swa'ↄnaↄ diu.","poem":1},{"lineBreak":true},{"text":"Gó'ilɛnaↄ táa'o ípiao,","poem":1},{"lineBreak":true},{"text":"baa a zↄ̃ↄ a bua swapiↄwao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa Dii mɛ́ wá Dↄaana ũ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ wá Gbãade ũ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ wá Kía ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a wá suaba.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N zwã̀akpɛ baↄ pòlo dɛ̀gɛdɛgɛ,","poem":1},{"lineBreak":true},{"text":"n kↄ̃kũliↄ pɛ́lɛa gbãa lↄo,","poem":1},{"lineBreak":true},{"text":"a zwãa dↄao.","poem":1},{"lineBreak":true},{"text":"Bee gbɛa ↄ̃ wa zĩ̀ ài zↄ̃ↄ biilɛkↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"baa ɛɛↄ pↄ́ sɛ́lɛ maamaa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú wee a mɛ álɛ gyãkɛo,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛpideↄ duuna kɛ̃̀má.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}