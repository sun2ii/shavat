{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":34,"content":[{"type":"heading","content":["Yã́kpalɛkɛa ń dṹniao Ɛdↄũ"]},{"type":"verse","number":1,"content":[{"text":"Bui ń buio à sↄ̃ kãi à yãma,","poem":1},{"lineBreak":true},{"text":"bùsu píi gbɛ̃́ↄ à swã́kpa,","poem":1},{"lineBreak":true},{"text":"dṹnia ń gbɛ̃́ pↄ́ kú a guuↄ à yãma,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ ń pↄ́ pↄ́ bↄ̀lɛwàↄ píi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asa Dii pↄ pà bui píizi,","poem":1},{"lineBreak":true},{"text":"à fɛ̃̀ ń ń zĩgↄ̃ↄ.","poem":1},{"lineBreak":true},{"text":"A ń dɛdɛ, i ń míↄnzↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa gbɛ̃́ pↄ́ wà ń dɛdɛↄ kↄ́lɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ ń au mi, an gɛↄ gĩdↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Saanaↄ yↄ musu píi,","poem":1},{"lineBreak":true},{"text":"luabɛ a koo lán pɛwa,","poem":1},{"lineBreak":true},{"text":"musupↄↄ wolo lán vɛ̃ɛlaↄwa,","poem":1},{"lineBreak":true},{"text":"aa kwɛ lán kaadↄɛnlaↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii fɛ̃nda gà ń auo musu.","poem":1},{"lineBreak":true},{"text":"Gwa! Àlɛ su Ɛdↄũwa yã́kpalɛkɛi,","poem":1},{"noteId":55},{"lineBreak":true},{"text":"àlɛ mↄ́ pilai gbɛ̃́ pↄ́ àlɛ ń míↄnzↄ̃piↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii fɛ̃nda tã̀ ń ble ń são auo,","poem":1},{"lineBreak":true},{"text":"sãsa gòle nísi ìwà,","poem":1},{"lineBreak":true},{"text":"asa Dii sa'oa vĩ Bↄzɛla,","poem":1},{"lineBreak":true},{"text":"aà pↄ́ kòlokpakpaa dasi Ɛdↄũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An zùsɛ̃lɛↄ ń ń zuswanaↄ kwɛ́ńnↄ sãnu","poem":1},{"lineBreak":true},{"text":"ń ń gbãadeↄ píi,","poem":1},{"lineBreak":true},{"text":"an bùsu i ga ń auo,","poem":1},{"lineBreak":true},{"text":"nísi i i ń tↄↄlɛwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa Dii tↄsimagↄↄɛ,","poem":1},{"lineBreak":true},{"text":"aà ĩadama wɛ̃̀ɛ yã́sia ń Siↄnao yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛdↄũ swaↄ li kↄtaa ũ,","poem":1},{"lineBreak":true},{"text":"a bùsuti a li ĩatɛ̃gbↄ̃ ũ,","poem":1},{"lineBreak":true},{"text":"an bùsu i gↄ̃ lán kↄtaa tɛ́wa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aↄ gaa vĩo fãanɛ ń gwãasĩnao,","poem":1},{"lineBreak":true},{"text":"a súɛlɛ aↄ dↄ gↄↄpiiɛ.","poem":1},{"noteId":56},{"lineBreak":true},{"text":"Wɛ̃ ń wɛ̃o aↄ da wáiwaiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a a baa vĩ lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gáuↄ ń kpↄbↄ'ilɛnaↄ kɛ ń kúkĩi ũ,","poem":1},{"lineBreak":true},{"text":"koohũhũnaↄ ń gbagbaaↄ sakpɛda we.","poem":1},{"lineBreak":true},{"text":"Dii a guyↄ̃bↄ poowà, i gↄ̃ da pã,","poem":1},{"lineBreak":true},{"text":"a gwa ń gĩsusugwabao, i gↄ̃ gii.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kía buiↄ ku wà ń kpá kpalau lↄo,","poem":1},{"lineBreak":true},{"text":"an dↄaanaↄ gɛ̃lɛ míↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kàelɛↄ ń lɛaaↄ kúlɛ ń kpɛ́ gbãaↄwa,","poem":1},{"lineBreak":true},{"text":"lɛsikao ń gàagaao a da ń zɛgikĩiↄla.","poem":1},{"lineBreak":true},{"text":"Aↄ dɛ gbɛ̃gbonaↄ tòo ũ, kooↄ bɛ ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Àwalɛwanaↄ ń maiↄ kpaaũ we,","poem":1},{"lineBreak":true},{"text":"tã́aↄ fↄkpakpakↄ̃wa,","poem":1},{"lineBreak":true},{"text":"babayↄ̃ɛↄ zↄ̃lɛkĩi eu, aaↄ kálɛu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bãso a sakpɛ da we à gbedau,","poem":1},{"lineBreak":true},{"text":"a nɛpipi, i ń kãaa a zíɛ.","poem":1},{"lineBreak":true},{"text":"Yãamusuↄ kↄ̃ nↄnↄaau,","poem":1},{"lineBreak":true},{"text":"sa ìↄ tɛ a nai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À wɛɛlɛ Dii taala guu,","poem":1},{"lineBreak":true},{"text":"à a kyokɛ,","poem":1},{"lineBreak":true},{"text":"an kee a kɛ̃́são,","poem":1},{"lineBreak":true},{"text":"a dae a kua a sawao,","poem":1},{"lineBreak":true},{"text":"asa aà lɛ́ mɛ́ ò,","poem":1},{"lineBreak":true},{"text":"aà Nisĩna mɛ́ a ń kãaa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ń baa kpàmá,","poem":1},{"lineBreak":true},{"text":"à ↄdↄ̀ ń baadeɛ a kúkĩiwa.","poem":1},{"lineBreak":true},{"text":"A gↄ̃ ń pↄ́ ũ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aaↄ ka a guu wɛ̃ ń wɛ̃o.","poem":1}]}],"footnotes":[{"noteId":55,"caller":"+","text":"34.5 Isa 63.1, Mal 1.4","reference":{"chapter":34,"verse":5}},{"noteId":56,"caller":"+","text":"34.10 Zia 14.11, 19.3","reference":{"chapter":34,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}