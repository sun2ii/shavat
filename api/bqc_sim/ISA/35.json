gwa! Á Lua lɛ́ mↄ́ tↄsiiɛ́,","poem":1},{"lineBreak":true},{"text":"àlɛ mↄ́ fĩaboinɛ́, i á suaba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vĩ̀aↄ wɛ́ a kɛ̃́,","poem":1},{"lineBreak":true},{"text":"swãdoↄ swã́ a wɛ̃,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ɛɛↄ vĩvĩ lán banawa,","poem":1},{"lineBreak":true},{"text":"lɛ́nanaalɛadeↄ gulakɛ,","poem":1},{"noteId":58},{"lineBreak":true},{"text":"asa gbáa a pũna ń ío,","poem":1},{"lineBreak":true},{"text":"gugii a li swa ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tↄↄlɛ wãa a li íkalɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"gugii a gↄ̃ nibↄna ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃gbonaↄ kálɛkĩi a vↄ̃́ ń wáao ń swamↄeo bↄlɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wa zɛda bↄ we,","poem":1},{"lineBreak":true},{"text":"wa mɛ zɛ́piɛ zɛ́ pↄ́ a kua adoa.","poem":1},{"lineBreak":true},{"text":"Gbã̀lɛnaↄ sɛo,","poem":1},{"lineBreak":true},{"text":"sↄũ a bɛbɛ kpa a ãao,","poem":1},{"lineBreak":true},{"text":"zɛ́pi aↄ dɛ a sɛnaↄ pↄ́ ũɛ ńtɛ̃ɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusu aↄ ku weo, wàie a sↄ̃io,","poem":1},{"lineBreak":true},{"text":"wa wɛsi wàilɛ weo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ Lua ń suabàↄ mɛ́ aaↄ bɛ we,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ Dii ń bópiↄ ɛa su,","poem":1},{"lineBreak":true},{"text":"aa gɛ̃ Siↄna ń kúkuakɛao,","poem":1},{"lineBreak":true},{"text":"pↄna láasai kú ń musu,","poem":1},{"lineBreak":true},{"text":"pↄna ń yaalↄo gɛ̃ńzi,","poem":1},{"lineBreak":true},{"text":"pↄsia ń wɛ̃nao gɛ̃zɛa.","poem":1}]}],"footnotes":[{"noteId":57,"caller":"+","text":"35.3 Ɛbɛ 12.12","reference":{"chapter":35,"verse":3}},{"noteId":58,"caller":"+","text":"35.6 Mat 11.5","reference":{"chapter":35,"ver