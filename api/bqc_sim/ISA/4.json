{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Zĩbeezĩ nↄɛ gbɛ̃ↄn soplaↄ gↄ̃ɛ mɛ̀ndo sikↄ̃wa aa mɛ:","poem":1},{"lineBreak":true},{"text":"Wáↄ wázĩa gwa,","poem":1},{"lineBreak":true},{"text":"wíↄ pↄkasa kɛ wázĩaɛ.","poem":1},{"lineBreak":true},{"text":"Wibↄwɛ̃ɛ, n tↄ́ iↄ kuwá.","poem":1}]},{"type":"heading","content":["Vlã́ pↄ́ Dii a to à pá"]},{"type":"verse","number":2,"content":[{"text":"Zĩbeezĩ Dii a to Isailiↄ vlãpa,","poem":1},{"lineBreak":true},{"text":"aↄ maa mɛ́ aↄ gawi vĩ.","poem":1},{"lineBreak":true},{"text":"An bùsu pↄ́ↄ aↄ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"a Isaili kↄ̃naↄ ka bɛɛɛ ń gawiowa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa gↄ̃ Siↄnaↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaↄ ku Yelusalɛũpiↄ,","poem":1},{"lineBreak":true},{"text":"waↄ o gbɛ̃́ pↄ́ wà ń tↄ́ kɛ̃̀ wɛ̃ni taalaupiↄnɛ Lua gbɛ̃́ↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii a Siↄna nↄɛↄ ã́ma wolomá,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃dɛ'au wolo Yelusalɛũdepiↄwa.","poem":1},{"lineBreak":true},{"text":"Tó à yã́kpalɛkɛ̀ńnↄ ń tɛ́o màa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"a tɛlu kúlɛ Siↄna gbɛ̀sĩsĩ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ kãaaa weↄwa píi fãanɛ,","poem":1},{"lineBreak":true},{"text":"i tɛ́lɛpiↄ gupua kúlɛwà gwãasĩna,","poem":1},{"lineBreak":true},{"text":"asa Dii gawi mɛ́ a kúlɛwà píi.","poem":1},{"noteId":7}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ dɛ mikpakĩi ũ fãanɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à uena dańla ĩatɛ̃ gbãa yã́i.","poem":1},{"lineBreak":true},{"text":"Aↄ dɛ yekĩi ũ lↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ wà e ulɛu zàa'ĩana ń louoɛ yã́i.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"4.5 Bↄa 13.21, 24.16","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}