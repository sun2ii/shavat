{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":40,"content":[{"type":"heading","content":["Lua gbɛ̃́ↄ nↄ̀sɛninianɛ"]},{"type":"verse","number":1,"content":[{"text":"Á Lua mɛ̀:","poem":1},{"lineBreak":true},{"text":"À ma gbɛ̃́ↄ nↄ̀sɛ níninɛ́,","poem":1},{"lineBreak":true},{"text":"à ń nↄ̀sɛ níninɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À yã́ nana o Yelusalɛũdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"à onɛ́ an zↄzĩ làa,","poem":1},{"lineBreak":true},{"text":"an tàae wì ń musu kↄ̀,","poem":1},{"lineBreak":true},{"text":"aa ń duuna fĩabò Diiɛ lɛɛ pla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kpàwakɛna lↄↄ ma dↄ, àlɛ mɛ:","poem":1},{"lineBreak":true},{"text":"À zɛkɛkɛ Diiɛ gbáau,","poem":1},{"lineBreak":true},{"text":"à zɛda poo wá Luaɛ sɛ̃u.","poem":1},{"noteId":63}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guzulɛ píi a tata,","poem":1},{"lineBreak":true},{"text":"gbɛ̀ lɛsĩↄ ń sĩ̀sĩↄ daaĩ píi,","poem":1},{"lineBreak":true},{"text":"gutoũtoũↄ kpaaĩ,","poem":1},{"lineBreak":true},{"text":"gusĩsĩdeↄ gↄ̃ gusalalaↄ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii gawi a bↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii a wɛsiɛ sãnusãnu.","poem":1},{"noteId":64},{"lineBreak":true},{"text":"Dii lɛ́ mɛ́ ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma lↄↄ mà dↄ à mɛ̀: Kpàwakɛ!","poem":1},{"lineBreak":true},{"text":"Ma mɛ̀: Mà kpàwakɛ mà o kpelewai?","poem":1},{"lineBreak":true},{"text":"À mɛ̀: Gbɛ̃nazĩna píi dɛ lán sɛ̃waɛ,","poem":1},{"lineBreak":true},{"text":"an kɛfɛnkɛ dɛ lán sɛ̃vuwaɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sɛ̃ ì gaga, a vú ì kwɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ́ Dii ì ĩ́anapɛwà yã́i.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ dɛ lán sɛ̃wa sĩanaɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɛ̃ ì gaga, a vú ì kwɛ́,","poem":1},{"lineBreak":true},{"text":"wá Lua sↄ̃, aà yã́ ìↄ ku gↄↄpiiɛ.","poem":1},{"noteId":65}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Siↄna baonakpana,","poem":1},{"lineBreak":true},{"text":"dɛdɛ gbɛ̀sĩsĩ lɛsĩwa, lɛda ía.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ baonakpana,","poem":1},{"lineBreak":true},{"text":"yã'o gbã́ugbãu vĩasai,","poem":1},{"lineBreak":true},{"text":"o Yuda wɛ̃́lɛdeↄnɛ: Á Lua kɛ!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À gwa! Dii Lua lɛ́ mↄ́ ń ikoo,","poem":1},{"lineBreak":true},{"text":"àlɛ mↄ́ kiblei ń gã̀sa gbãao.","poem":1},{"lineBreak":true},{"text":"À gwa! A a asea kũa,","poem":1},{"noteId":66},{"lineBreak":true},{"text":"a a zĩ ài kpán'aɛkɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì a pↄ́ↄ dã lán sãdãnawa,","poem":1},{"noteId":67},{"lineBreak":true},{"text":"ì a sãnɛↄ sↄlↄ a ↄu,","poem":1},{"lineBreak":true},{"text":"ì ń kpá a kùɛ,","poem":1},{"lineBreak":true},{"text":"ì a nɛadeↄ tàlakpa.","poem":1}]},{"type":"heading","content":["Dii dɛa pↄ́piia"]},{"type":"verse","number":12,"content":[{"text":"Démɛ ísia í yↄ̃̀ a ↄ guui?","poem":1},{"lineBreak":true},{"text":"Démɛ luabɛ yↄ̃̀ ń ↄtãoi?","poem":1},{"lineBreak":true},{"text":"Démɛ dṹnia bùsuti kà zaau píii?","poem":1},{"lineBreak":true},{"text":"Démɛ gbɛ̀sĩsĩↄ dì kiloowai?","poem":1},{"lineBreak":true},{"text":"Démɛ sĩ̀sĩↄ gbia yↄ̃̀i?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Démɛ Dii làasoo dↄ̃i?","poem":1},{"lineBreak":true},{"text":"Démɛ yãdàɛ̀ à lɛdàwài?","poem":1},{"noteId":68}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dé Dii yãkpàlɛ aà gɛ̃zĩ aà lɛdawai?","poem":1},{"lineBreak":true},{"text":"Démɛ aà dà zɛ́ súsuwai?","poem":1},{"lineBreak":true},{"text":"Démɛ dↄ̃a kã̀fĩɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ ↄ̃nↄ dàɛ̀i?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bui píi dɛɛ̀ lán itona pↄ́ tↄ̃̀ soo guuwaɛ,","poem":1},{"lineBreak":true},{"text":"lán luutɛ̃ pↄ́ kpá kiloowawa,","poem":1},{"lineBreak":true},{"text":"ísia gũgũnaↄ gbia dɛɛ̀ lán gbɛ́tiwaɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Libã likpɛ i ka Dii gbagbayaa ũo,","poem":1},{"lineBreak":true},{"text":"a nↄ̀bↄↄ i ka wà sa'oowào.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bui píi dɛɛ̀ yãfũnnↄɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ ń gwa fooonnↄɛ,","poem":1},{"lineBreak":true},{"text":"aa dɛɛ̀ pↄe ũo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dé á Lua lɛɛũòi?","poem":1},{"lineBreak":true},{"text":"Bↄ́ á mɛ a muaaòi?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tã́a sↄ̃, ↄzĩkɛna mɛ́ ì pí,","poem":1},{"lineBreak":true},{"text":"ↄ̃ sia ì vua í lɛ́wà,","poem":1},{"lineBreak":true},{"text":"ì ã́nusu yàbaa kɛ daɛ̀.","poem":1},{"noteId":69}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a ↄ lɛ́ a kpɛ leo","poem":1},{"lineBreak":true},{"text":"ì lí pↄ́ lí vlão sɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì li'ãn gↄ̃ide wɛɛlɛ","poem":1},{"lineBreak":true},{"text":"aà tã́a pɛ́lɛɛ, kɛ́ asu lɛ́lɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Á dↄ̃o lé? I mao lé?","poem":1},{"lineBreak":true},{"text":"Wi oɛ́ za asĩnizĩo lé?","poem":1},{"lineBreak":true},{"text":"I dṹniakalɛgↄↄ yãmao lé?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A zↄ̃lɛa bàlumaa dṹnia musu,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃́ↄ dɛɛ̀ lán kwaↄwaɛ.","poem":1},{"lineBreak":true},{"text":"Ì musu poo lán zwã̀akpɛwa a bɛ ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ì to kpalablenaↄ gↄ̃ fooonnↄ,","poem":1},{"lineBreak":true},{"text":"ì dṹnia dↄaanaↄ sↄaa aa gↄ̃ kpɛɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wà ń dílɛn lò,","poem":1},{"lineBreak":true},{"text":"wà ń kpán lò,","poem":1},{"lineBreak":true},{"text":"an zĩ́na gɛ̃̀ tíun lò,","poem":1},{"lineBreak":true},{"text":"tó à ĩ́anapɛ̀má, aaì giigagaɛ,","poem":1},{"lineBreak":true},{"text":"zàa i ń sɛ́ lán sɛ̃̀ keleↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Lua pↄ́ a kua adoa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Dé á ma lɛɛũòi?","poem":1},{"lineBreak":true},{"text":"Dé álɛ e wá sáai?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"À wɛ́sɛ musu gwa.","poem":1},{"lineBreak":true},{"text":"Démɛ pↄ beeↄ kɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ ì to aa bilɛ ń dasilɛu","poem":1},{"lineBreak":true},{"text":"à ń baade sísi a tↄ́wai?","poem":1},{"lineBreak":true},{"text":"Aà iko zↄ̃ↄ ń aà gbãa pãsĩo","poem":1},{"lineBreak":true},{"text":"mɛ́ tò a keeli kɛ̃́são.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yakↄbu buiↄ, bↄ́yãi i mɛ Dii á zɛ́ dↄ̃o ni?","poem":1},{"lineBreak":true},{"text":"Isailiↄ, àkɛa álɛ o á Lua á yã́ fãn vĩo ni?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Á dↄ̃o lé? I mao lé?","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ Lua bɛ̃́ɛ ũ, dṹnialɛdana ũ.","poem":1},{"lineBreak":true},{"text":"Ìli kpasao, ìli fuo,","poem":1},{"lineBreak":true},{"text":"mɛ́ wa fↄ̃ aà ↄ̃nↄ lɛ́ dↄ̃o.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ì gbãa kã́fĩ gbɛ̃́ pↄ́ kpàsaↄnɛ,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ pↄ́ gↄ̃̀ dↄ̀lↄlↄↄ gba yɛ̃̀ɛɛ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ɛ̀waasoↄ ì kpasa aa fu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ gbãaↄ ì gɛ̃mbↄlɛ aa lɛ́lɛ,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an wɛ́ dↄ Diiziↄ sↄ̃,","poem":1},{"lineBreak":true},{"text":"an gbãa ìↄ dɛdɛɛ.","poem":1},{"lineBreak":true},{"text":"Aa fɛlɛ ń gbãao lán kúuwa,","poem":1},{"lineBreak":true},{"text":"aa bàalɛ aa kpasao,","poem":1},{"lineBreak":true},{"text":"aa táa'o aa fuo.","poem":1}]}],"footnotes":[{"noteId":63,"caller":"+","text":"40.3 Mat 3.3, Maa 1.3, Zãa 1.23","reference":{"chapter":40,"verse":3}},{"noteId":64,"caller":"+","text":"40.5 Luk 3.4-6","reference":{"chapter":40,"verse":5}},{"noteId":65,"caller":"+","text":"40.8 1Piɛ 1.24-25","reference":{"chapter":40,"verse":8}},{"noteId":66,"caller":"+","text":"40.10 Zia 22.12","reference":{"chapter":40,"verse":10}},{"noteId":67,"caller":"+","text":"40.11 Eze 34.15, Zãa 10.11","reference":{"chapter":40,"verse":11}},{"noteId":68,"caller":"+","text":"40.13 Lom 11.34, 1Kln 2.16","reference":{"chapter":40,"verse":13}},{"noteId":69,"caller":"+","text":"40.19 Zĩn 17.29","reference":{"chapter":40,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}