{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":44,"content":[{"type":"heading","content":["Lua diikɛ dɛ tã́aↄla"]},{"type":"verse","number":1,"content":[{"text":"Tiasa Yakↄbu bui ma zↄ̀blenaↄ,","poem":1},{"lineBreak":true},{"text":"Isaili ma yenzideↄ, à ma yãma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Dii á Dↄnlɛde pↄ́ á kɛ́","poem":1},{"lineBreak":true},{"text":"ma á ikàsa nɛasakpɛu ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Yakↄbu bui ma zↄ̀blenaↄ","poem":1},{"lineBreak":true},{"text":"á bui maa pↄ́ má sɛ̀ↄ,","poem":1},{"lineBreak":true},{"text":"ásu to vĩa á kũo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa má í pisi gu'isaiɛ,","poem":1},{"lineBreak":true},{"text":"má tó í da tↄↄlɛ giia,","poem":1},{"lineBreak":true},{"text":"má a Nisĩna pisi á buiↄwa,","poem":1},{"lineBreak":true},{"text":"má báaada á sↄ̃kpaɛↄgu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa fɛlɛ lán sɛ̃̀bↄlↄwa,","poem":1},{"lineBreak":true},{"text":"aa ↄtá lán swagbalawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ bee a mɛ Dii pↄ́n a ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃do a Yakↄbu tↄ́ ble,","poem":1},{"lineBreak":true},{"text":"ado a kɛ̃ a ↄwa, Dii pↄ́,","poem":1},{"lineBreak":true},{"text":"ado a Isaili tↄ́ sɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma Dii Zĩgↄ̃de Isailiↄ Kía","poem":1},{"lineBreak":true},{"text":"an Bona, ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"mámɛ má Dↄaana ń Gↄ̃zãnao ũ,","poem":1},{"noteId":75},{"lineBreak":true},{"text":"ma bàasio diie kuo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Démɛ kàmawai?","poem":1},{"lineBreak":true},{"text":"Aà lɛ́si, aà yã'o.","poem":1},{"lineBreak":true},{"text":"Aà yã́ pↄ́ lɛ́ mↄ́ dau siumɛɛ káau,","poem":1},{"lineBreak":true},{"text":"aà yã́ pↄ́ a su kɛ o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ásu to vĩa á kũo, ásu gilikɛo.","poem":1},{"lineBreak":true},{"text":"Mi a kpàwakɛɛ́, á mà za káauo lé?","poem":1},{"lineBreak":true},{"text":"Ámɛ á ma seeladeↄ ũ.","poem":1},{"lineBreak":true},{"text":"Diie ku lↄ ma bàasie?","poem":1},{"lineBreak":true},{"text":"Má gbɛsi pãle dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tã́apinaↄá pↄe no,","poem":1},{"lineBreak":true},{"text":"an zĩ pↄ́ ń pↄ dↄwàↄ ài vĩo.","poem":1},{"lineBreak":true},{"text":"An seelamaakɛnaↄá vĩ̀aↄnɛ,","poem":1},{"lineBreak":true},{"text":"an yãdↄ̃sai a widamá.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ tã́a pì a kɛ̀ dii ũ,","poem":1},{"lineBreak":true},{"text":"a àikɛɛ̀o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wí a gbɛ̃́ pↄ́ lɛ́ zↄblenɛ́ↄ kṹ píi,","poem":1},{"lineBreak":true},{"text":"asa an pinaↄá gbɛ̃nazĩnaↄnɛ.","poem":1},{"lineBreak":true},{"text":"Aa kãaa ḿpii aa bↄ gupuau,","poem":1},{"lineBreak":true},{"text":"mí gili gɛ̃ńgu, mí widamá sãnu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sia ì mↄ da tɛ́u,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃gbɛ̃ ń masanao,","poem":1},{"lineBreak":true},{"text":"ìpi tã́a ũ ń a gã̀sa gbãao.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ nↄana ì aà dɛ, aà gbãa ì busa,","poem":1},{"lineBreak":true},{"text":"tó i í e mìo, aà yɛ̃̀ɛɛ ì láa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Li'ãna ì ba yↄ̃ líwa,","poem":1},{"lineBreak":true},{"text":"ì a dↄ̀ↄda ń pↄ́ ia boolodabↄo,","poem":1},{"lineBreak":true},{"text":"ì a seelakɛ ń sĩsĩↄnao,","poem":1},{"lineBreak":true},{"text":"ì a tɛ̃ɛkɛ ń kpásagↄ̃nao.","poem":1},{"lineBreak":true},{"text":"Ì ã́ lán gbɛ̃nazĩnawa kɛfɛũkɛfɛũ,","poem":1},{"lineBreak":true},{"text":"kɛ́ àↄ ku a kpɛ́u tã́a ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wì sɛdɛ lí ge giali","poem":1},{"lineBreak":true},{"text":"ge gbɛ̃́nɛli zↄ̃ likpɛu ń pↄeãwa,","poem":1},{"lineBreak":true},{"text":"ge pɛ̃li pↄ́ wa bà, lou tò à zↄ̃ↄkũ̀.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lí dɛ gbɛ̃nazĩnaↄnɛ yàa ũ.","poem":1},{"lineBreak":true},{"text":"Wì sɛ wà tɛ́kpakpaò,","poem":1},{"lineBreak":true},{"text":"wì tɛ́kaò wà pɛ̃ɛkɛò lↄ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ wì ã tã́a ũ wàↄ kúlɛɛ̀,","poem":1},{"lineBreak":true},{"text":"wì aà kɛ dii ũ wà misiilɛɛ̀ lↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wì a kĩni kátɛu wà blɛkɛò,","poem":1},{"lineBreak":true},{"text":"wì nↄ̀ↄ kpaò tɛ́a wà so wà kã́.","poem":1},{"lineBreak":true},{"text":"Wì tɛ́kpakpaò lↄ wà mɛ:","poem":1},{"lineBreak":true},{"text":"Ũhũu! Ma tɛ́ è sa, ma mɛ kɛ̀ lↄ̀ↄlↄↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃ ì a kĩni kɛ tã́a ũ a dii ũ,","poem":1},{"lineBreak":true},{"text":"ì kúlɛɛ̀, ì misiilɛɛ̀,","poem":1},{"lineBreak":true},{"text":"ì wabikɛwà ì mɛ:","poem":1},{"lineBreak":true},{"text":"Ma suaba, asa ma diin n ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa ↄ̃nↄ vĩo, aali yãmao,","poem":1},{"lineBreak":true},{"text":"wà ↄkùnɛ́ ń wɛ́waɛ, aalɛ gu'eo,","poem":1},{"lineBreak":true},{"text":"wà ń nↄ̀sɛ lìaa, ↄ̃ aa gↄ̃̀ faasai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aali làasookɛo, aa ↄ̃nↄo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ aa a kĩni kàtɛu,","poem":1},{"lineBreak":true},{"text":"aa pɛ̃ɛkɛ̀ a yↄ̃wa,","poem":1},{"lineBreak":true},{"text":"aa nↄ̀ↄ kpàò tɛ́a aa sò,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa tã́a kɛ̀ ń a kĩnio,","poem":1},{"lineBreak":true},{"text":"aa misìilɛli pↄ́ aa zↄ̃̀ɛ,","poem":1},{"lineBreak":true},{"text":"aali yã́pi wàaipao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aalɛ kã́wã wɛɛlɛ tawa lɛ́'iuɛ,","poem":1},{"lineBreak":true},{"text":"an sↄ̃̀ mↄafilide ì ń sã́sã.","poem":1},{"lineBreak":true},{"text":"Aa fↄ̃ ńzĩa misi aa mɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ wa kũaá pↄ́ ɛgɛnaɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yakↄbu buiↄ, à to yã́ beeↄ dↄágu,","poem":1},{"lineBreak":true},{"text":"asa ma zↄ̀blenaↄn á ũ, Isailiↄ.","poem":1},{"lineBreak":true},{"text":"Ma á kɛ́, ma zↄ̀blenaↄn á ũ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ, á yã́ a sãmaguo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma á tàaeↄ bãdɛ̀,","poem":1},{"lineBreak":true},{"text":"aa tà lán louwa,","poem":1},{"lineBreak":true},{"text":"á duuna gɛ̃̀zɛa lán suawa.","poem":1},{"lineBreak":true},{"text":"À ɛa sua, asa ma á bó.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Luabɛdeↄ, à gulakɛ, asa Dii kɛ̀,","poem":1},{"lineBreak":true},{"text":"zĩ́lɛdeↄ, à kúkuakɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ à vĩvĩ ń wiitɛ̃nao,","poem":1},{"lineBreak":true},{"text":"likpɛ ń a líↄ píi,","poem":1},{"lineBreak":true},{"text":"asa Dii Yakↄbu buiↄ bò,","poem":1},{"lineBreak":true},{"text":"à tↄbↄ̀ Isailiↄ yã́ musu.","poem":1}]},{"type":"heading","content":["Yelusalɛũ zia vua"]},{"type":"verse","number":24,"content":[{"text":"Ma Dii á Bona pↄ́ ma á ikàsa nɛasakpɛu, ma mɛ̀","poem":1},{"lineBreak":true},{"text":"mámɛmaa Dii, ma pↄ́pii kɛ̀,","poem":1},{"lineBreak":true},{"text":"ma musu kpàlɛ mado,","poem":1},{"lineBreak":true},{"text":"ma dṹnia kàlɛ ń mazĩa ↄo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mi ãnabi ɛgɛnaↄ seela pã́lɛ,","poem":1},{"lineBreak":true},{"text":"mi to màsokɛnaↄ gↄ̃ láanipↄ ũ,","poem":1},{"lineBreak":true},{"text":"mi to ↄ̃nↄnaↄ kpɛkpa,","poem":1},{"lineBreak":true},{"text":"mi ń dↄ̃a liaanɛ́.","poem":1},{"noteId":76}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mi a zↄ̀blenaↄ yã́ sɛ́ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"mi to ma ìwaↄ lɛdama zĩkɛ,","poem":1},{"lineBreak":true},{"text":"má ò Yelusalɛũ zia a vu,","poem":1},{"lineBreak":true},{"text":"wi ɛa Yuda wɛ̃́lɛↄ kálɛ,","poem":1},{"lineBreak":true},{"text":"wi ń kpɛ́ gbooaↄ kɛkɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mi o ísiɛ aà ba,","poem":1},{"lineBreak":true},{"text":"mi o swaↄnɛ aa gↄ̃ gii.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Má ò Kilusi yã́ musu,","poem":1},{"lineBreak":true},{"text":"àↄ dɛ ma sãdãna ũ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à ma pↄeã kɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"i o Yelusalɛũ yã́ musu,","poem":1},{"lineBreak":true},{"text":"wa ɛa kálɛ, wi ma kpɛ́ dↄ.","poem":1},{"noteId":77}]}],"footnotes":[{"noteId":75,"caller":"+","text":"44.6 Isa 48.12, Zia 1.17, 22.13","reference":{"chapter":44,"verse":6}},{"noteId":76,"caller":"+","text":"44.25 1Kln 1.20","reference":{"chapter":44,"verse":25}},{"noteId":77,"caller":"+","text":"44.28 Ɛza 1.2","reference":{"chapter":44,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}