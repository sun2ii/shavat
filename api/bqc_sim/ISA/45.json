{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":45,"content":[{"type":"heading","content":["Dii Kilusi kpaa kpalau"]},{"type":"verse","number":1,"content":[{"text":"Ma Dii ma Kilusi kpà kpalau,","poem":1},{"lineBreak":true},{"text":"ma aà kũ̀ a ↄplaawa.","poem":1},{"lineBreak":true},{"text":"Má buiↄ nɛɛ̀,","poem":1},{"lineBreak":true},{"text":"i ń kíaↄ asana polo ń pi,","poem":1},{"lineBreak":true},{"text":"má zɛwɛ̃ɛ̀, bĩ́ibↄlɛↄ aaↄ tataaɛ̀o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má òɛ̀: Mámɛ má dↄaanɛ,","poem":1},{"lineBreak":true},{"text":"má gbɛ̀sĩsĩↄ daaĩnɛ,","poem":1},{"lineBreak":true},{"text":"má bĩ́ibↄlɛ gba pↄ́ wa pì ń mↄgotɛ̃ↄ gboo,","poem":1},{"lineBreak":true},{"text":"má mↄ̀ gbã́aↄ zↄ̃ɛzↄ̃ɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má n gba gusↄↄ pↄ́ ↄdeↄ ń àizɛɛ pↄ́ ulɛaↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹ e dↄ̃ mámɛmaa Dii,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua pↄ́ n sisi n tↄ́wa ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma lɛzùnzi n tↄ́wa","poem":1},{"lineBreak":true},{"text":"ma zↄ̀blena Yakↄbu buiↄ yã́i,","poem":1},{"lineBreak":true},{"text":"Isaili pↄ́ ma ń sɛ́ↄ yã́i.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ ń ma dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ma tↄ́ gbia kpànɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mámɛmaa Dii, a pãle kuo,","poem":1},{"lineBreak":true},{"text":"ma bàasio diie kuo.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ ń ma dↄ̃o, má n gba gbãa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kɛ́ wà e dↄ̃ za ĩatɛ̃bilɛkĩi","poem":1},{"lineBreak":true},{"text":"e a gɛ̃kpɛukĩi ma bàasio gbɛ̃e kuo.","poem":1},{"lineBreak":true},{"text":"Mámɛmaa Dii, a pãle kuo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gupua íkasanan ma ũ,","poem":1},{"lineBreak":true},{"text":"gusiakũnan ma ũ,","poem":1},{"lineBreak":true},{"text":"aafiakpamaden ma ũ","poem":1},{"lineBreak":true},{"text":"mɛ́ yã́yiamaden ma ũ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ mi beeↄ kɛ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Musu, mↄ̀sɛ gbaɛ,","poem":1},{"lineBreak":true},{"text":"luabɛ, to lou kwɛ yã́zɛde ũ.","poem":1},{"lineBreak":true},{"text":"Tↄↄlɛ, wɛ̃aa, gbɛ̃́ↄ suabaa i bↄlɛ,","poem":1},{"lineBreak":true},{"text":"i zↄ̃ↄkũ ń yã́zɛdeo sãnu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má dìlɛ màa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Waiyoo gbɛ̃́ pↄ́ lɛ́ a Kɛna lɛ́wɛ,","poem":1},{"lineBreak":true},{"text":"oo kaso pↄ́ kálɛ tↄↄlɛↄ don aà ũ.","poem":1},{"lineBreak":true},{"text":"Gĩ ì o a tòtonaɛ: Bↄ́ ńlɛ kɛia?","poem":1},{"noteId":78},{"lineBreak":true},{"text":"N pↄkɛa a onɛ ń ↄ vĩoa?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waiyoo gbɛ̃́ pↄ́ ò a maeɛ:","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi n ma kai dṹniawa kɛ́wai?","poem":1},{"lineBreak":true},{"text":"Waiyoo gbɛ̃́ pↄ́ ò a daɛ:","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi n ma ii kɛ́wai?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma Dii á Isailiↄ Kɛna,","poem":1},{"lineBreak":true},{"text":"á Lua pↄ́ ma kua adoa, ma mɛ̀","poem":1},{"lineBreak":true},{"text":"ámɛ á ma lala zia yã́ musua?","poem":1},{"lineBreak":true},{"text":"Ámɛ á yãdilɛmɛɛ ma nɛ́ↄ","poem":1},{"lineBreak":true},{"text":"ge ma pↄkɛaↄ yã́ musua?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mámɛ ma tↄↄlɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃nazĩna kàlɛwà,","poem":1},{"lineBreak":true},{"text":"ma ↄ mɛ́ musu kpàlɛ,","poem":1},{"lineBreak":true},{"text":"ma yãdìlɛdilɛ a pↄ́ↄnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mámɛ má Kilusi vu iu yã́zɛde yã́i,","poem":1},{"lineBreak":true},{"text":"má zɛpooɛ̀ gupiiu súsu.","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ a ma gbɛ̃́ zĩ̀zↄↄ gbaɛ","poem":1},{"lineBreak":true},{"text":"aa ma wɛ̃́lɛ vu.","poem":1},{"lineBreak":true},{"text":"A bee kɛ ài'ea ge gbagusaɛ yã́io.","poem":1},{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Egipiↄ zĩ ài ń Etiopiↄ ɛlɛ àio","poem":1},{"lineBreak":true},{"text":"a gↄ̃ á pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ Seba bui gbã̀aↄ bua su á kĩ́i","poem":1},{"lineBreak":true},{"text":"mↄdaona gala kpákpaa.","poem":1},{"lineBreak":true},{"text":"Aa kúlɛɛ́ aa awakpaɛ́ aa mɛ:","poem":1},{"lineBreak":true},{"text":"Lua kúánↄ fá, dii pãle kuo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lua pↄ́ wa aà asii dↄ̃on n ũ fá,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua ń Suabanan n ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wí a tã́apinaↄ kṹ ḿpii,","poem":1},{"lineBreak":true},{"text":"an gɛɛ a gↄ̃ kpá ń wɛ́i.","poem":1},{"lineBreak":true},{"text":"Aa kpɛkpa sãnu ḿpii mipɛlɛa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii a Isailiↄ suaba,","poem":1},{"lineBreak":true},{"text":"an suabaa aↄ láaa vĩo.","poem":1},{"lineBreak":true},{"text":"Wí a á kṹ bauo,","poem":1},{"lineBreak":true},{"text":"á gɛɛ a gↄ̃ kpá á wɛ́i bauo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"mámɛ ma musu kɛ̀,","poem":1},{"lineBreak":true},{"text":"mámɛ má Lua ũ.","poem":1},{"lineBreak":true},{"text":"Ma dṹnia ikàsa má kɛ̀,","poem":1},{"lineBreak":true},{"text":"mámɛmaa Kalɛna ũ.","poem":1},{"lineBreak":true},{"text":"Mi dṹnia kɛ àↄ da pão,","poem":1},{"lineBreak":true},{"text":"má kɛ̀kɛ kɛ́ wàↄ ku a guuɛ.","poem":1},{"lineBreak":true},{"text":"Mámɛmaa Dii, a pãle kuo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mi yã'o asii guu ge tↄↄlɛ nↄnauo,","poem":1},{"lineBreak":true},{"text":"mi o Yakↄbu buiↄnɛ aa ma wɛɛlɛ pão.","poem":1},{"lineBreak":true},{"text":"Ma Dii mi yã'o a zɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"sĩana kpàwa mi kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Á buipãle pↄ́ a gulɛ̀","poem":1},{"lineBreak":true},{"text":"a á bùsu tò weↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ kↄ̃ kãaa, í sↄ̃ kãi.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aali tã́a kũaↄ yãe dↄ̃o,","poem":1},{"lineBreak":true},{"text":"aaì wabikɛ dii pↄ́ a ń suabaowa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À lɛkpaaĩ à mↄ á yã'o gupuau.","poem":1},{"lineBreak":true},{"text":"Démɛ dↄ̀aa yã́pi ò za káaui?","poem":1},{"lineBreak":true},{"text":"Démɛ bↄ̀ò za zii?","poem":1},{"lineBreak":true},{"text":"Mapi Dii nolo?","poem":1},{"lineBreak":true},{"text":"Luae kuo, ma bàasio.","poem":1},{"lineBreak":true},{"text":"Lua maa suabanae kuo, sema mapi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Á gbɛ̃́ pↄ́ á kú za tↄↄlɛ lɛ́waↄ,","poem":1},{"lineBreak":true},{"text":"à sua, mí á suaba,","poem":1},{"lineBreak":true},{"text":"asa mámɛ má Lua ũ, a pãle kuo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma lɛgbɛ̃̀ ń mazĩa tↄ́o,","poem":1},{"lineBreak":true},{"text":"yã́zɛde bↄ̀ ma lɛ́u, a gbooa vĩo,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀: Gbɛ̃́pii a kúlɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"aa ma luakɛ dↄ̃.","poem":1},{"noteId":79}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wa o ma yã́ musu:","poem":1},{"lineBreak":true},{"text":"Yã́zɛde ń gbãao ku Dii kĩ́iɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ fɛ̃̀maziↄ mↄ ma kĩ́i vlãnaa ń pↄ̀ↄu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Isaili bui píi a bↄ maa Dii sabai,","poem":1},{"lineBreak":true},{"text":"aai ĩ́anadã aà yã́ musu.","poem":1}]}],"footnotes":[{"noteId":78,"caller":"+","text":"45.9 Lom 9.20","reference":{"chapter":45,"verse":9}},{"noteId":79,"caller":"+","text":"45.23 Lom 14.11, Flp 2.10-11","reference":{"chapter":45,"verse":23}}]},"thisChapterLink":"/api/bqc_sim/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}