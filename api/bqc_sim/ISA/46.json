{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":46,"content":[{"type":"heading","content":["Babɛli diiↄ kↄ̃'ea ń Luao"]},{"type":"verse","number":1,"content":[{"text":"Bɛli lɛ́ su zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"Nɛbo lɛ́ naalɛ,","poem":1},{"lineBreak":true},{"text":"an tã́a pↄ́ zuↄ sɛapiↄá asoɛ,","poem":1},{"lineBreak":true},{"text":"aa kpàsa ń a sɛao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zupiↄ lɛ́ naalɛ, aalɛ su zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ fu asowa sãnusãnu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ tã́apiↄ lɛ́ gɛ̃zɛa zĩ̀zↄↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yakↄbu buiↄ, à ma yãma!","poem":1},{"lineBreak":true},{"text":"Isaili kↄ̃na pↄ́ má á sɛa za nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"má á zↄ̃a ma gã̀u za nɛasakpɛupiↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E à gɛ zikũò máↄ ku kɛ́waɛ.","poem":1},{"lineBreak":true},{"text":"E á mikã gɛ può máↄ á kũaɛ.","poem":1},{"lineBreak":true},{"text":"Mámɛ ma á kɛ́, mámɛ máↄ á sɛa,","poem":1},{"lineBreak":true},{"text":"mámɛ máↄ á kũa, mɛ́ má á bↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dé álɛ e ma muaaòi?","poem":1},{"lineBreak":true},{"text":"Dé álɛ e wá sáai?","poem":1},{"lineBreak":true},{"text":"Dé álɛ e wá doũ, álɛ ma lɛɛũòi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ ì vua bↄ ń sↄ̃̀ↄu,","poem":1},{"lineBreak":true},{"text":"ge aaì ã́nusu yↄ̃ kiloowa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì a zĩ da siaɛ aà tã́apionɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì kúlɛɛ̀ aa misiilɛɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì sɛ da ń gã̀u aa taò,","poem":1},{"lineBreak":true},{"text":"aaì dilɛ a pɛ́lɛkĩi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì gↄ̃ zɛa we, ìli go a tíao.","poem":1},{"lineBreak":true},{"text":"Tó wà lɛzùi, ìli weo,","poem":1},{"lineBreak":true},{"text":"ìli ń yã'ↄ̃ma bↄnɛ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À làasookɛ yã́ɛ beewa,","poem":1},{"lineBreak":true},{"text":"íↄ kũa á sↄ̃u, swã́gbãadeↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À làasookɛ yãzi káauↄwa,","poem":1},{"lineBreak":true},{"text":"asa mámɛ má Lua ũ, a pãle kuo.","poem":1},{"lineBreak":true},{"text":"Mámɛ má Lua ũ, diie muaamanↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mi dↄaa yã́ zã̀ kpàwakɛ za káau,","poem":1},{"lineBreak":true},{"text":"mi yã́ pↄ́ a su mↄ o e àↄ gɛ́ kái.","poem":1},{"lineBreak":true},{"text":"Mi mɛ yã́ pↄ́ ma zɛò a kɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ má yei píi, má kɛɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má lɛzu bãsoi gukpɛ oi,","poem":1},{"lineBreak":true},{"text":"má gbɛ̃́pi sísi za bùsu zã̀zãu aà yã́ pↄ́ málɛ yá kɛ.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ má ò má bↄò saɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ma zɛò má kɛɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á swã́gbãade pↄ́ álɛ e á zĩblea zã̀ↄ,","poem":1},{"lineBreak":true},{"text":"à ma yãma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma zĩblea gↄↄ zã̀o, à kãikũ̀,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ suabaa a gↄↄ ga lↄo.","poem":1},{"lineBreak":true},{"text":"Má tó Siↄna zĩble,","poem":1},{"lineBreak":true},{"text":"má a gawi pisi Isailiↄwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}