{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"heading","content":["Babɛli dúuzↄ̃a"]},{"type":"verse","number":1,"content":[{"text":"Babɛli wɛ̃́lɛ lɛ́so, pila zↄ̃lɛ bùsuu,","poem":1},{"lineBreak":true},{"text":"á Kaladeↄ, à zↄ̃lɛ zĩ́lɛ kpalabaasai.","poem":1},{"lineBreak":true},{"text":"Wa oɛ́ mɛ̀zãɛ ge mɛniɛnadeↄ lↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À á pↄ́kummusu go á mia,","poem":1},{"lineBreak":true},{"text":"í gbɛnɛ sɛ wísilↄ.","poem":1},{"lineBreak":true},{"text":"À zwãa kuluka á gbala tɛ̃a bↄ,","poem":1},{"lineBreak":true},{"text":"í gɛ̃ íu à bua swaↄwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa á puizi e, á asii a bↄ gupuau.","poem":1},{"lineBreak":true},{"text":"Má tↄsiwá, má á gbɛ̃e tɛ̃boo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wá Bona tↄ́n Dii Zĩgↄ̃de,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua pↄ́ a kua adoa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii ò Babɛlideↄnɛ:","poem":1},{"lineBreak":true},{"text":"À gɛ́ gusiau, í zↄ̃lɛ kílikili.","poem":1},{"lineBreak":true},{"text":"Wa oɛ́ kpalaↄ mide lↄo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma pↄ pà gbɛ̃́ pↄ́ dɛ ma pↄ́ ũↄzi,","poem":1},{"lineBreak":true},{"text":"má tò wà ma gbɛ̃́piↄ kpɛ è.","poem":1},{"lineBreak":true},{"text":"Ma ń kpama, ↄ̃ ni ń wɛ̃nagwao.","poem":1},{"lineBreak":true},{"text":"Baa maezↄ̃ↄↄ, n zuu gbia dànɛ́ à tↄ̃̀má.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N mɛ̀ n kpalablea aↄ gɛ́ gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Ń yã́piↄ kũa n nↄ̀sɛ guuo,","poem":1},{"lineBreak":true},{"text":"ni làasookɛ yã́piↄ midɛawao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yã́ɛ bee ma sa lalaside.","poem":1},{"lineBreak":true},{"text":"Ń zↄ̃lɛa báawa dↄdↄa,","poem":1},{"lineBreak":true},{"text":"n mɛ̀ n bàasio gbɛ̃e kuo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ gyaable bauo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ nɛga wɛ̃nakɛo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yã́ɛ bee a ń le píi gↄↄ do kóũ,","poem":1},{"lineBreak":true},{"text":"nɛgaga ń gyaableao.","poem":1},{"noteId":80},{"lineBreak":true},{"text":"Baa ń n gbɛ̃kↄↄlɛkɛa zↄ̃ↄo","poem":1},{"lineBreak":true},{"text":"ń n pↄdama pãsĩo,","poem":1},{"lineBreak":true},{"text":"yã́pi a ń le, aↄ fòona vĩo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ń n yãvãikɛ náai vĩ,","poem":1},{"lineBreak":true},{"text":"n mɛ̀ gbɛ̃e lɛ́ n eo.","poem":1},{"lineBreak":true},{"text":"N ↄ̃nↄ ń n dↄ̃ao n mi lìaa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ni o n nↄ̀sɛu n bàasio gbɛ̃e kuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Músi a gɛ̃nzi,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ a yↄ̀ↄ dↄ̃ ǹ kɛo.","poem":1},{"lineBreak":true},{"text":"Kìsia a n le, aↄ kɛkɛa vĩo,","poem":1},{"lineBreak":true},{"text":"ásoo pↄ́ ń a fãn vĩo a n le lɛzasai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wɛtã ǹyↄ̃ gɛ́ ń n pↄdaamáo ń n gbɛ̃kↄↄlɛkɛa","poem":1},{"lineBreak":true},{"text":"pↄ́ dɛ n ↄzĩ ũ za n nɛ́fɛ̃nɛn zĩ́o.","poem":1},{"lineBreak":true},{"text":"Tó a fↄ̃ àikɛnɛ bɛ!","poem":1},{"lineBreak":true},{"text":"Tó a fↄ̃ to ǹ vĩadadańzi bɛ!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N nzĩa kpàsa ń yãgbɛaama dasio.","poem":1},{"lineBreak":true},{"text":"To musu tàasikanaↄ ń saanyãdↄ̃naↄ","poem":1},{"lineBreak":true},{"text":"ń mↄ àsi baokpanaↄ sunɛ ń ń yã́o,","poem":1},{"lineBreak":true},{"text":"aa n suaba ń yã́ pↄ́ lɛ́ mↄmao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa dɛ lán sɛ̃̀ giiwa, tɛ́ a kṹmá,","poem":1},{"lineBreak":true},{"text":"aa ńzĩa si tɛ́vua gbãawao.","poem":1},{"lineBreak":true},{"text":"Tɛ́ pↄ́ wa kpakpa no,","poem":1},{"lineBreak":true},{"text":"tɛ́ pↄ́ wa zↄ̃lɛ a saɛ no.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Màa gbɛ̃́ pↄ́ tɛ́tɛnzi za n nɛ́fɛ̃nɛn zĩ́","poem":1},{"lineBreak":true},{"text":"n nzĩa kpàsa ń yã́iↄ gↄ̃.","poem":1},{"lineBreak":true},{"text":"Aa fãaa aaↄ liaazↄ̃,","poem":1},{"lineBreak":true},{"text":"an kee a fↄ̃ n bↄo.","poem":1}]}],"footnotes":[{"noteId":80,"caller":"+","text":"47.9 Zia 18.7-8","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}