{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":48,"content":[{"type":"heading","content":["Dii mɛ́ zia yã́ dↄ̃"]},{"type":"verse","number":1,"content":[{"text":"Yakↄbu buiↄ, à yã́ɛ bee ma.","poem":1},{"lineBreak":true},{"text":"Isaili tↄ́ kúwá, a bↄ Yuda au guu.","poem":1},{"lineBreak":true},{"text":"I lɛgbɛ̃ ń Dii tↄ́o,","poem":1},{"lineBreak":true},{"text":"i Isailiↄ Lua sísi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ili kɛ a zɛ́wa ń náaioo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I mɛ Lua wɛ̃́lɛdeↄn á ũ,","poem":1},{"lineBreak":true},{"text":"á sↄ̃ kpálɛa Isailiↄ Luazi,","poem":1},{"lineBreak":true},{"text":"aà tↄ́n Dii Zĩgↄ̃de.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma dↄaa yãzi káauↄ ò,","poem":1},{"lineBreak":true},{"text":"ma a kpàwakɛ̀ ń ma lɛ́o,","poem":1},{"lineBreak":true},{"text":"ma bↄ ń yã́o kã́ndo, ↄ̃ yã́piↄ kɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa má dↄ̃ kɛ́ á swã́ gbãa,","poem":1},{"lineBreak":true},{"text":"á waa gbãa lán sↄ̃́wa,","poem":1},{"lineBreak":true},{"text":"mɛ́ á kùa gbãa lán mↄgotɛ̃wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ayãmɛto ma dↄaa má òɛ́ za káau,","poem":1},{"lineBreak":true},{"text":"ma a kpàwakɛ̀ɛ́ e àↄ gɛ́ mↄ́i,","poem":1},{"lineBreak":true},{"text":"kɛ́ ásu mɛ á tã́aↄ mɛ́ kɛ̀o,","poem":1},{"lineBreak":true},{"text":"ge á pↄ́ ãaↄ ń á pↄ́ kásaaↄ mɛ́ dìlɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yã́piↄ mà. Gwa! À kɛ̀ píi.","poem":1},{"lineBreak":true},{"text":"Á ye dↄ̃ noa?","poem":1},{"lineBreak":true},{"text":"Za gbã má yã́ dafu kpàwakɛɛ́,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ulɛaɛ́, á dↄ̃o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma bↄò gbãɛ, yãzi no.","poem":1},{"lineBreak":true},{"text":"Gbã bàasio, i ma yãao,","poem":1},{"lineBreak":true},{"text":"kɛ́ ásu o á dↄ̃ yãaɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I mao, á dↄ̃o, á swã́ dↄi za zio.","poem":1},{"lineBreak":true},{"text":"Asa má á dↄ̃ náaisaideↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"za á igↄↄ wì mɛɛ́ Wúuuɛ!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma tↄ́ yã́i ↄ̃ ma a pↄkũma tò kpaa ĩ́i,","poem":1},{"lineBreak":true},{"text":"ma táasilɛa yã́i ma azĩa zùukɛ̀i,","poem":1},{"lineBreak":true},{"text":"kɛ́ másu á míↄnzↄ̃o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gwa! Ma á baasa,","poem":1},{"lineBreak":true},{"text":"i kɛ ń tɛ́o lán ã́nusuwa no.","poem":1},{"lineBreak":true},{"text":"Ma á maa wɛ̀ɛlɛ ń taasikɛao,","poem":1},{"lineBreak":true},{"text":"i kɛ mua tɛ́ guu no.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma bee kɛ̀ mazĩa yã́i.","poem":1},{"lineBreak":true},{"text":"Má tó wà ma tↄ́ ↄ̃̀ↄkpaa?","poem":1},{"lineBreak":true},{"text":"Má we wà ma bɛɛɛ dↄ̃ dii pãleɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yakↄbu buiↄ, à ma yãma,","poem":1},{"lineBreak":true},{"text":"á Isaili pↄ́ ma á sisiↄ.","poem":1},{"lineBreak":true},{"text":"Mámɛmaa ũ.","poem":1},{"lineBreak":true},{"text":"Mámɛ má Dↄaana ũ,","poem":1},{"lineBreak":true},{"text":"mámɛ má Gↄ̃zãna ũ lↄ.","poem":1},{"noteId":81}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma ↄ mɛ́ dṹnia kàlɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄplaa mɛ́ musu kpàlɛ.","poem":1},{"lineBreak":true},{"text":"Tó ma ń sisi, aaì fɛlɛ sãnusãnu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À mↄ ápii, à yãma!","poem":1},{"lineBreak":true},{"text":"Tã́aↄ kpele mɛ́ yã́piↄ ò yãai?","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃na mɛ́ a yã́ pↄ́ málɛ yá kɛ Babɛliɛ,","poem":1},{"lineBreak":true},{"text":"a ↄtↄ̃ Babiloniↄwa ń gbãao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mámɛ ma yã'ò ma aà sìsi,","poem":1},{"lineBreak":true},{"text":"má mↄaànↄ mɛ́ aà tá a kɛ na.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À sↄ̃mazi à yã́ɛ bee ma:","poem":1},{"lineBreak":true},{"text":"Za a daalɛgↄↄ mi yãe o asii guuo,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ à kɛ̀, má kú we.","poem":1},{"lineBreak":true},{"text":"Dii Lua ń ma Nisĩnao aa ma zĩ à mɛ̀:","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma Dii á Isailiↄ Lua á Bona","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ mámɛmaa Dii á Lua,","poem":1},{"lineBreak":true},{"text":"mi yã́ kã́fĩade daɛ́,","poem":1},{"lineBreak":true},{"text":"mi á da zɛ́ pↄ́ dɛ à sɛwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó a laaidↄ̀ ma yãdanɛↄwa yãa,","poem":1},{"lineBreak":true},{"text":"dↄ̃ á kua aↄ na lán swawa,","poem":1},{"lineBreak":true},{"text":"á maakɛa aↄ kpálɛa vĩo lán ísia idãazĩwa,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"á nɛ́ↄ dasikũ lán ũfãawa,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ a bↄ á plɛuↄ aaↄ dasi lán gbɛ̀kↄsↄwa.","poem":1},{"lineBreak":true},{"text":"An tↄ́ a ga bauo, a láa ma kĩ́io.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"À bↄlɛ Babɛli,","poem":1},{"noteId":82},{"lineBreak":true},{"text":"à bàalɛ Babiloniↄnɛ!","poem":1},{"lineBreak":true},{"text":"À yã́pi kpàwakɛ ń gulakɛao,","poem":1},{"lineBreak":true},{"text":"à yã́pi baokpa e dṹnia lɛ́wa,","poem":1},{"lineBreak":true},{"text":"í o Dii a zↄ̀blena Yakↄbu buiↄ bò.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À gɛ̃̀ńnↄ guyaaau, imi i ń dɛo,","poem":1},{"lineBreak":true},{"text":"a tò í bↄ̀nɛ́ gbɛsiu.","poem":1},{"lineBreak":true},{"text":"À gbɛpi pàa, ↄ̃ í bↄ̀ lɛ́ bàalɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Vãikɛnaↄ aaↄ aafiao.","poem":1}]}],"footnotes":[{"noteId":81,"caller":"+","text":"48.12 Isa 44.6, Zia 1.17, 22.13","reference":{"chapter":48,"verse":12}},{"noteId":82,"caller":"+","text":"48.20 Zia 18.4","reference":{"chapter":48,"verse":20}}]},"thisChapterLink":"/api/bqc_sim/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}