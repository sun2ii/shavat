{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ a mɛ̀ ma á da yà,","poem":1},{"lineBreak":true},{"text":"aà gínzila kú má ni?","poem":1},{"lineBreak":true},{"text":"Ma fĩade kpele ma á yíawài?","poem":1},{"lineBreak":true},{"text":"Aawo! Á duuna yã́i ma á yiai,","poem":1},{"lineBreak":true},{"text":"á tàaeↄ yã́i ma á da yài.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kɛ́ ma mↄ, bↄ́yãi mi gbɛ̃e eo ni?","poem":1},{"lineBreak":true},{"text":"Kɛ́ ma lɛzùázi,","poem":1},{"lineBreak":true},{"text":"àkɛa á gbɛ̃e i weao ni?","poem":1},{"lineBreak":true},{"text":"Ma ↄ kɛ̀ geseũ a fↄ̃ á bↄo yã̀?","poem":1},{"lineBreak":true},{"text":"Má gbãa vĩ mà á bo noa?","poem":1},{"lineBreak":true},{"text":"Ma ísia lèle, ↄ̃ gugii bↄ̀,","poem":1},{"lineBreak":true},{"text":"má tò swa gↄ̃̀ lán gbáawa.","poem":1},{"lineBreak":true},{"text":"A kpↄↄ gàga isai yã́i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa yaikɛ̀ kɛ́ í kuo yã́i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi to gu si gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"mi zwã̀a sia da musuɛ.","poem":1}]},{"type":"heading","content":["Dii zↄ̀blena lɛ̀ àaↄ̃de"]},{"type":"verse","number":4,"content":[{"text":"Dii Lua ma gba lɛ́ mà yãdaonɛ́","poem":1},{"lineBreak":true},{"text":"mà yã́ pↄ́ ì gbɛ̃́ pↄ́ bùsaↄ gba sↄ̃ o.","poem":1},{"lineBreak":true},{"text":"Ìↄ ma vu lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"ì ma swã́ nakṹ,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà yãma lán yãdadana pↄ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii Lua ma swã́ wɛ̃̀,","poem":1},{"lineBreak":true},{"text":"mi zazakũo, mi pↄ̀ↄbↄzãkɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma a kpɛ tò lia gbɛ̃́ pↄ́ aalɛ ma gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma a gɛɛ tò dↄa gbɛ̃́ pↄ́ aalɛ a kã́ woloↄnɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ́ aalɛ ma sↄ̃sↄ̃, aalɛ lɛ́'ikákaa,","poem":1},{"lineBreak":true},{"text":"mi a wɛ́ ga ma sↄ̃òo.","poem":1},{"noteId":89}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma gɛɛ a gↄ̃ kpa ma wɛ́io,","poem":1},{"lineBreak":true},{"text":"kɛ́ Dii Lua lɛ́ dↄmalɛ yã́i.","poem":1},{"lineBreak":true},{"text":"A yã́i ma aɛ dↄ súsu lán gbɛsiwa,","poem":1},{"lineBreak":true},{"text":"má dↄ̃ kɛ́ wí a ma kũo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua ma yãnakpamade kumanↄ kãi.","poem":1},{"lineBreak":true},{"text":"Démɛ a bↄbↄmanↄi?","poem":1},{"lineBreak":true},{"text":"Wà aɛdↄkↄ̃wa!","poem":1},{"lineBreak":true},{"text":"Démɛ ma káalakɛna ũi?","poem":1},{"lineBreak":true},{"text":"Aà sↄ̃ kãi!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii Lua mɛ́ ì dↄmalɛ,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ yãdamalai?","poem":1},{"noteId":90},{"lineBreak":true},{"text":"Ampii aa kɛ yáiyai lán pↄkasawa,","poem":1},{"lineBreak":true},{"text":"kↄ̀ↄↄ mɛ́ a ń sóso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Á démɛ Dii vĩa vĩ","poem":1},{"lineBreak":true},{"text":"ì aà zↄ̀blena yãmai?","poem":1},{"lineBreak":true},{"text":"Tó a bɛ gusiau filia í sai,","poem":1},{"lineBreak":true},{"text":"aà Dii náaikɛ,","poem":1},{"lineBreak":true},{"text":"i sↄ̃kpalɛ a Luazi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À ma, á gbɛ̃́ pↄ́ i tɛ́ka ázĩaɛ","poem":1},{"lineBreak":true},{"text":"i sɛ̃̀ tɛ́ dↄↄ,","poem":1},{"lineBreak":true},{"text":"à gɛ àↄ bɛ á tɛ́pi vuai","poem":1},{"lineBreak":true},{"text":"ge sɛ̃ pↄ́ a tɛsↄ̃̀wà gupuai.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ a bↄ ma ↄzĩ à á len kɛ:","poem":1},{"lineBreak":true},{"text":"Áↄ wúlɛa gu wãwãdeu!","poem":1}]}],"footnotes":[{"noteId":89,"caller":"+","text":"50.6 Maa 14.65","reference":{"chapter":50,"verse":6}},{"noteId":90,"caller":"+","text":"50.9 Lom 8.33-34","reference":{"chapter":50,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}