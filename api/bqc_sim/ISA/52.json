{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Vu iu, vu iu Siↄna!","poem":1},{"lineBreak":true},{"text":"Gbãa da ula ũ!","poem":1},{"lineBreak":true},{"text":"Lua wɛ̃́lɛ Yelusalɛũ,","poem":1},{"lineBreak":true},{"text":"ǹ n pↄkasa í gbiaↄ da,","poem":1},{"lineBreak":true},{"text":"gyafↄↄdeↄ ń gbãlɛnaↄ gɛ̃ ń guu lↄo.","poem":1},{"noteId":92}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yelusalɛũ, bùsu woloma,","poem":1},{"lineBreak":true},{"text":"fɛlɛ zↄ̃lɛ n báawa.","poem":1},{"lineBreak":true},{"text":"Nɛnↄn zĩ̀zↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"mↄdaona polo n nↄɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asa ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ma á kpámá pã,","poem":1},{"lineBreak":true},{"text":"mɛ́ má á bo ↄ̃asai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa ma Dii Lua ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ zↄblè Egipi káau,","poem":1},{"lineBreak":true},{"text":"a gbɛa sa Asiliↄ gbãamↄ̀nɛ́.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Kɛ́ bee dɛ kpelewa sa ni?","poem":1},{"lineBreak":true},{"text":"Asa wà ma gbɛ̃́ↄ sɛ̀lɛ pã,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an gbãamↄnɛdeↄ ìↄ tidↄńla,","poem":1},{"lineBreak":true},{"text":"aaìↄ ma tↄbɛ̃ɛsi gↄↄpii.","poem":1},{"noteId":93}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yã́i tò má tó ma gbɛ̃́ↄ ma dↄ̃.","poem":1},{"lineBreak":true},{"text":"Gↄↄ bee aaↄ dↄ̃ kɛ́ mámɛ ma dↄaa yã́pi ò.","poem":1},{"lineBreak":true},{"text":"Ao, mámɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baonakpana gbapɛlɛa gbɛ̀sĩsĩ musu maa fá!","poem":1},{"noteId":94},{"lineBreak":true},{"text":"Àlɛ aafia kpàwakɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ baonakpa Siↄnadeↄnɛ.","poem":1},{"lineBreak":true},{"text":"Àlɛ suabayã'ònɛ́,","poem":1},{"lineBreak":true},{"text":"àlɛ mɛ an Lua mɛ́ lɛ́ kible.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A gudↄ̃anaↄ wiidↄ,","poem":1},{"lineBreak":true},{"text":"aalɛ kúkuakɛ sãnusãnu,","poem":1},{"lineBreak":true},{"text":"asa aa wɛsì Dii ɛa sua Siↄnalɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yelusalɛũ ziadeↄ,","poem":1},{"lineBreak":true},{"text":"à pũna ń gulakɛao sãnusãnu,","poem":1},{"lineBreak":true},{"text":"asa Dii Yelusalɛũ bò,","poem":1},{"lineBreak":true},{"text":"à a gbɛ̃́ↄ nↄ̀sɛ nìninɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua a a gã̀sa pↄ́ a kua adoa gbãa ↄlↄ bui píiɛ,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛlɛdeↄ e píi lá wá Lua a a gbɛ̃́ↄ suaba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"À fɛlɛ, à fɛlɛ, à bↄ we,","poem":1},{"lineBreak":true},{"text":"ásu ↄkã pↄ́ gbãlɛawao.","poem":1},{"noteId":95},{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á Dii kpɛ́ pↄ́ↄ sɛa,","poem":1},{"lineBreak":true},{"text":"à bↄlɛu, íↄ ku gbãlɛsai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á bↄlɛ ń leeleoo,","poem":1},{"lineBreak":true},{"text":"á tá ń bàalɛaoo,","poem":1},{"lineBreak":true},{"text":"asa Dii Isailiↄ Lua a zɛmikũɛ́,","poem":1},{"lineBreak":true},{"text":"i ɛa àↄ tɛ́ á kpɛ.","poem":1}]},{"type":"heading","content":["Dii zↄ̀blena lɛ̀ síiↄ̃de"]},{"type":"verse","number":13,"content":[{"text":"Gwa! Ma zↄ̀blena a gwea e,","poem":1},{"lineBreak":true},{"text":"wa aà kã́fĩ, wa aà sɛ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"aↄ fuańla musumusu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aà oa ↄ̃̀ↄkpà, a dɛ oa ũ lↄo,","poem":1},{"lineBreak":true},{"text":"aà mɛ lìlɛ, a dɛ mɛ ũ lↄo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aà yã́pi dìmá.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Màa aà yã́ a ɛa bↄ bui dasiↄ saɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ kíaↄ lɛ́ a gↄ̃ kpaaũa aà aɛ,","poem":1},{"lineBreak":true},{"text":"asa aa yã́ pↄ́ wi onɛ́ yãao e,","poem":1},{"lineBreak":true},{"text":"aa yã́ pↄ́ aai ma yãao zɛ́ dↄ̃.","poem":1},{"noteId":96}]}],"footnotes":[{"noteId":92,"caller":"+","text":"52.1 Zia 21.2, 27","reference":{"chapter":52,"verse":1}},{"noteId":93,"caller":"+","text":"52.5 Lom 2.24","reference":{"chapter":52,"verse":5}},{"noteId":94,"caller":"+","text":"52.7 Lom 10.15","reference":{"chapter":52,"verse":7}},{"noteId":95,"caller":"+","text":"52.11 2Kln 6.17","reference":{"chapter":52,"verse":11}},{"noteId":96,"caller":"+","text":"52.15 Lom 15.21","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/bqc_sim/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}