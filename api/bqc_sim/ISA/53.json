{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Démɛ bao pↄ́ wá mà sìi?","poem":1},{"noteId":97},{"lineBreak":true},{"text":"Démɛ Dii gbãa asiipi dↄ̃̀i?","poem":1},{"noteId":98}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aà zↄ̀blena fɛ̀lɛ aà aɛ lán lí vlãpaawa,","poem":1},{"lineBreak":true},{"text":"lán lizĩna pↄ́ fù tↄↄlɛ giiu à bↄlↄbↄ̀wa.","poem":1},{"lineBreak":true},{"text":"Aà kákaa ge aà zɛa maa i ka à gbɛ̃́ wɛ́ bleo,","poem":1},{"lineBreak":true},{"text":"aà kɛfɛnkɛ i ka wà wɛ́tɛaàzio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wà sakàaàgu wà bã̀nɛbↄ̀ɛ̀.","poem":1},{"lineBreak":true},{"text":"Pↄsiadeɛ, a gyãeↄ dↄ́ɛ dↄ̃,","poem":1},{"lineBreak":true},{"text":"a dɛ lán gbɛ̃́ pↄ́ wa ye wɛsiɛowa.","poem":1},{"lineBreak":true},{"text":"Wa sakàaàgu, wi aà yãdao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kási wá gyãↄ ↄ̃ a sɛa,","poem":1},{"lineBreak":true},{"text":"à wá wãwãↄ dì a miwa.","poem":1},{"noteId":99},{"lineBreak":true},{"text":"Ɔ̃ wa aà dìlɛ gbɛ̃́ pↄ́ Lua aà gbɛ̃̀ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ Lua ↄkↄlↄmpàɛ̀ à widàwà ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wà aà zↄ̃̀ wá tàaeↄ yã́i,","poem":1},{"lineBreak":true},{"text":"wà aà kɛ̀'ĩa wá yãvãiↄ yã́i.","poem":1},{"lineBreak":true},{"text":"Ĩa pↄ́ wa dàwàpi wá gbá aafia,","poem":1},{"lineBreak":true},{"text":"aà flàala iaↄ mɛ́ wá gbãgbã.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wa sãsã wápii lán sãↄwa,","poem":1},{"noteId":100},{"lineBreak":true},{"text":"baade azĩa zɛ́ sɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Dii wápii vãikɛa dìɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wà aà wɛtã̀ wà widàwà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ i lɛwɛ̃aao lán sã pↄ́ wàlɛ gɛ́ a kòlokpaiwa,","poem":1},{"noteId":101},{"lineBreak":true},{"text":"a nílɛ kpɛ̃́ lán sã pↄ́ wàlɛ a kãkɛ̃ɛlɛwa.","poem":1},{"noteId":102}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wà aà kũ̀ ń gbãao,","poem":1},{"lineBreak":true},{"text":"wà yã́kpalɛkɛ̀aànↄ.","poem":1},{"lineBreak":true},{"text":"Wà aà bↄ̀ dṹniau ma gbɛ̃́ↄ tàae yã́i,","poem":1},{"lineBreak":true},{"text":"wà aà dɛ̀ an gbɛ̃go pↄ́ lɛ́ ń dã́ ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú aà gↄↄↄ,","poem":1},{"lineBreak":true},{"text":"an démɛ yã́pi làasookɛ̀i?","poem":1},{"noteId":103}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Baa kɛ́ i yãpãsĩkɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ wi ma à ɛɛtòo,","poem":1},{"noteId":104},{"lineBreak":true},{"text":"wà aà mia kpàkↄ̃i ń dàakɛnaↄ,","poem":1},{"noteId":105},{"lineBreak":true},{"text":"ↄ̃ wà aà vĩ̀ ↄde miau.","poem":1},{"noteId":106}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"À kà Diigu à aà kɛ'ĩa aà taasikɛ.","poem":1},{"noteId":107},{"lineBreak":true},{"text":"Lá à azĩa kɛ̀ tàae awakpabↄ ũ,","poem":1},{"lineBreak":true},{"text":"a buikɛ, aà wɛ̃ni a gbã̀akũ,","poem":1},{"lineBreak":true},{"text":"Dii pↄeã i bↄↄlɛkɛ aà sabai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà taasikɛa gbɛa a ɛa àↄ wɛ̃ni vĩ,","poem":1},{"lineBreak":true},{"text":"i a namable.","poem":1},{"lineBreak":true},{"text":"Ma zↄ̀blen maapi a to yã́ bↄ ń gbɛ̃́ↄ na dasi,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa aà dↄ̃ yã́i,","poem":1},{"lineBreak":true},{"text":"asa a ń yãvãi di a miwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yã́i má aà baa daaa ń gbɛ̃zↄ̃ↄↄ,","poem":1},{"lineBreak":true},{"text":"a zĩ̀ ài kpaalɛ ń gbãadeↄ,","poem":1},{"lineBreak":true},{"text":"asa à gì a wɛ̃nii e à gɛ̀ gàò,","poem":1},{"lineBreak":true},{"text":"wà aà gwà doũ ń dàakɛnaↄ.","poem":1},{"noteId":108},{"lineBreak":true},{"text":"À gbɛ̃ dasiↄ duuna sɛ̀,","poem":1},{"noteId":109},{"lineBreak":true},{"text":"à kulɛkɛ̀ Luaɛ tàaedeↄnɛ.","poem":1},{"noteId":110}]}],"footnotes":[{"noteId":97,"caller":"+","text":"53.1 Lom 10.16","reference":{"chapter":53,"verse":1}},{"noteId":98,"caller":"+","text":"53.1 Zãa 12.38","reference":{"chapter":53,"verse":1}},{"noteId":99,"caller":"+","text":"53.4 Mat 8.17","reference":{"chapter":53,"verse":4}},{"noteId":100,"caller":"+","text":"53.6 1Piɛ 2.24-25","reference":{"chapter":53,"verse":6}},{"noteId":101,"caller":"+","text":"53.7 Zia 5.6","reference":{"chapter":53,"verse":7}},{"noteId":102,"caller":"+","text":"53.7 Maa 14.61, 1Piɛ 2.23","reference":{"chapter":53,"verse":7}},{"noteId":103,"caller":"+","text":"53.8 Zĩn 8.32-33","reference":{"chapter":53,"verse":8}},{"noteId":104,"caller":"+","text":"53.9 1Piɛ 2.22","reference":{"chapter":53,"verse":9}},{"noteId":105,"caller":"+","text":"53.9 Luk 23.33","reference":{"chapter":53,"verse":9}},{"noteId":106,"caller":"+","text":"53.9 Mat 27.57-60","reference":{"chapter":53,"verse":9}},{"noteId":107,"caller":"+","text":"53.10 Zĩn 2.23","reference":{"chapter":53,"verse":10}},{"noteId":108,"caller":"+","text":"53.12 Luk 22.37","reference":{"chapter":53,"verse":12}},{"noteId":109,"caller":"+","text":"53.12 Ɛbɛ 9.28","reference":{"chapter":53,"verse":12}},{"noteId":110,"caller":"+","text":"53.12 Lom 8.34","reference":{"chapter":53,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}