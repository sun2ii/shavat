{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":54,"content":[{"type":"heading","content":["Yelusalɛũ dafu"]},{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"n fĩi pↄ́ ni nɛ'io,","poem":1},{"lineBreak":true},{"text":"koo pũna ń pↄna wiio.","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ ni nↄwãwãkɛo, gulakɛ.","poem":1},{"lineBreak":true},{"text":"Asa n gbɛ̃́ pↄ́ n gↄ̃ pãkpànzi,","poem":1},{"lineBreak":true},{"text":"n nɛ dasi aↄ dɛ nↄɛ pↄ́ a gↄ̃ aɛdↄ̀wà pↄ́a.","poem":1},{"noteId":111}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ n zwã̀akpɛ gu kã́fĩ,","poem":1},{"lineBreak":true},{"text":"ǹ a zwãa yàasa kṹ,","poem":1},{"lineBreak":true},{"text":"ǹ a ba gbã̀akũ,","poem":1},{"lineBreak":true},{"text":"ǹ a líↄ pɛ́lɛ gíũgiũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa ńyↄ̃ ↄta ↄplaai ń zɛɛo,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ↄ buiↄ bùsu símá,","poem":1},{"lineBreak":true},{"text":"aai zↄ̃lɛ ń wɛ̃́lɛ ziaↄu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ńsu vĩakɛo, asa wí a n kũo.","poem":1},{"lineBreak":true},{"text":"Ńsu widɛo, n gɛɛ a gↄ̃ kpa n wɛ́io.","poem":1},{"lineBreak":true},{"text":"N ɛ̀waasogↄↄ wíyã a sãngu,","poem":1},{"lineBreak":true},{"text":"n gyaable ń gɛɛo kpánwɛi yã́ a dↄngu lↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asa mapi n Kɛna mámɛ má n gↄ̃ ũ,","poem":1},{"lineBreak":true},{"text":"ma tↄ́n Dii Zĩgↄ̃de!","poem":1},{"lineBreak":true},{"text":"Ma Isailiↄ Bona, an Lua,","poem":1},{"lineBreak":true},{"text":"ma kua adoaɛ,","poem":1},{"lineBreak":true},{"text":"wì mɛmɛɛ dṹnia píi Lua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má n gbɛsi","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ wà pãkpài aà pↄ yàwa.","poem":1},{"lineBreak":true},{"text":"Mapi n Lua má ɛa n kṹ","poem":1},{"lineBreak":true},{"text":"lán ɛ̀waaso nↄkpama pↄ́ à gìiwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma n to we yãa yↄↄ gĩaɛ,","poem":1},{"lineBreak":true},{"text":"ãma má ɛa n si ma sùuu zↄ̃ↄ yã́i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ́ ma pↄ fɛ̃̀, ma bↄ n kpɛ gↄↄpla,","poem":1},{"lineBreak":true},{"text":"ãma má wɛ̃nadↄ̃nɛ gbɛ̃kɛ láasai musu.","poem":1},{"lineBreak":true},{"text":"Ma Dii n Bona mámɛ má ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá ma lɛgbɛ̃̀ Nↄee gↄↄ,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ í a da dṹniaa lↄo,","poem":1},{"noteId":112},{"lineBreak":true},{"text":"màa ma lɛgbɛ̃̀ gbã lↄ,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ ma pↄ a fɛ̃nzi mà n lele lↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̀sĩsĩↄ làa mɛ́ sĩ̀sĩↄ gbòo,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃kɛa láa n kĩ́io,","poem":1},{"lineBreak":true},{"text":"ma bàakuannↄ aafia yã́ a gbooo.","poem":1},{"lineBreak":true},{"text":"Ma Dii n wɛ̃nadↄ̃nɛde mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wɛ̃́lɛ wɛ̃nade pↄ́ zàa'ĩana ì a suumpapa,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃e i n nↄ̀sɛ nínio,","poem":1},{"lineBreak":true},{"text":"má ɛa n kálɛ ń tiikↄazio,","poem":1},{"lineBreak":true},{"text":"má n ɛ̃ daalɛ safiiwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má n bĩ́i misonaↄ kɛ ń lubiio,","poem":1},{"lineBreak":true},{"text":"má n bĩ́ibↄlɛↄ kɛ ń gbɛdiio,","poem":1},{"lineBreak":true},{"text":"má n bĩ́iↄ bo ń gbɛ̀ bɛɛɛdeↄ.","poem":1},{"noteId":113}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Dii, má yãda n gbɛ̃́ↄnɛ píi,","poem":1},{"noteId":114},{"lineBreak":true},{"text":"n nɛ́ↄ aafia aↄ zↄ̃ↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yã́zɛde a n gba gbãa,","poem":1},{"lineBreak":true},{"text":"gbãamↄa gbɛ̃́ↄnɛ a zã̀ kũnnↄ.","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ↄ pↄe vĩa vĩo,","poem":1},{"lineBreak":true},{"text":"gili a gɛ̃nguo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó wà lɛ̀lɛma, bee i bↄ ma kĩ́io,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ̀lɛma a mikpama.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gwa! Mámɛ ma sia kɛ̀,","poem":1},{"lineBreak":true},{"text":"ì tɛ́vu ń bↄ̀ↄo,","poem":1},{"lineBreak":true},{"text":"aà ↄzĩn gↄ̃kɛbↄpia ũ.","poem":1},{"lineBreak":true},{"text":"Mámɛ ma gbɛ̃kaalɛna kɛ̀ lↄ","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ↄ dɛdɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gↄ̃kɛbↄ pↄ́ wa kɛ̀ n yã́i a àikɛo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ bↄ̀bↄnnↄ, n yã́ a zↄ̃lɛwà.","poem":1},{"lineBreak":true},{"text":"Ma zↄ̀blenaↄ baan we,","poem":1},{"lineBreak":true},{"text":"má tó aa zĩble.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[{"noteId":111,"caller":"+","text":"54.1 Gal 4.27","reference":{"chapter":54,"verse":1}},{"noteId":112,"caller":"+","text":"54.9 Daa 9.11","reference":{"chapter":54,"verse":9}},{"noteId":113,"caller":"+","text":"54.12 Zia 21.18-21","reference":{"chapter":54,"verse":12}},{"noteId":114,"caller":"+","text":"54.13 Zãa 6.45","reference":{"chapter":54,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}