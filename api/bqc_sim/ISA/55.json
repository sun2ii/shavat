{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":55,"content":[{"type":"heading","content":["Dii kĩ́i wɛɛlɛa a gↄↄwa"]},{"type":"verse","number":1,"content":[{"text":"Hee! Á gbɛ̃́ pↄ́ imi lɛ́ á dɛↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ í kĩ́i ápii!","poem":1},{"noteId":115},{"lineBreak":true},{"text":"Baa tó á ↄ̃a vĩo, à mↄ pↄble.","poem":1},{"lineBreak":true},{"text":"À mↄ vɛ̃ɛ ń vĩo mi ↄ̃asai, fĩabosai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àkɛa álɛ ↄ̃a dɛ pↄ́ pↄ́ dɛ blɛ ũo musui?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi álɛ zĩ ài dɛ pↄ́ pↄ́li ń kã́o yã́ii?","poem":1},{"lineBreak":true},{"text":"À ma yãma sa à pↄmaa ble,","poem":1},{"lineBreak":true},{"text":"á pↄ i kɛ na a nísiwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À swã́kpa ma!","poem":1},{"lineBreak":true},{"text":"À mↄ ma kĩ́i kɛ́ à e àↄ ku.","poem":1},{"lineBreak":true},{"text":"Ma bàa aↄ kúánↄ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃kɛ seasai pↄ́ má kɛ̀ Davidiɛ yã́pi.","poem":1},{"noteId":116}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gwa! Ma aà dìlɛ seelade ũ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma aà kɛ̀ gbɛ̃́ↄ dↄaana ũ, an kía ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ bui pↄ́ ń dↄ̃oↄ sísi,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ ń dↄ̃opiↄ bàalɛ mↄ n kĩ́i","poem":1},{"lineBreak":true},{"text":"ma Dii Isailiↄ Lua pↄ́ a kua adoa yã́i,","poem":1},{"lineBreak":true},{"text":"asa ma gawi pìsima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À Dii kĩ́i wɛɛlɛ aà egↄↄ,","poem":1},{"lineBreak":true},{"text":"à aà sísi gↄↄ pↄ́ a kãiánↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vãikɛna a zɛ́ tó,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi ↄkpa a làasooi.","poem":1},{"lineBreak":true},{"text":"Aà zɛ ń Diio, i aà wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"wá Luapi i sùuukɛaànↄ maamaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"á làasoo muaa ń ma làasoooo,","poem":1},{"lineBreak":true},{"text":"á yãkɛa muaa ń ma yãkɛaoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá musu ń zĩ́lɛo lɛsĩ dɛ ń kↄ̃o,","poem":1},{"lineBreak":true},{"text":"màa ma yãkɛa lɛsĩ dɛ á yãkɛaa,","poem":1},{"lineBreak":true},{"text":"màa ma làasoo dɛ á làasooa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lá lou ń mↄ̀sɛo ì bↄ za musu,","poem":1},{"lineBreak":true},{"text":"mɛ́ ìli ɛa we tↄↄlɛninisaio,","poem":1},{"lineBreak":true},{"text":"ì to pↄ́ bↄlɛwà à nɛ'i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì buikɛ pↄtↄ̃naɛ,","poem":1},{"lineBreak":true},{"text":"ì blɛkɛ pↄblenaɛ,","poem":1},{"noteId":117}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"màa yã́ pↄ́ bↄ̀ ma lɛ́u dɛ.","poem":1},{"lineBreak":true},{"text":"A lɛ́lɛ pã ma pↄeã kɛsaio,","poem":1},{"lineBreak":true},{"text":"ma yã'o kpã́sãa tá aↄ na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Asa á bↄlɛ ń pↄnao,","poem":1},{"lineBreak":true},{"text":"wa dↄaaɛ́ ń aafiao,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ ń sĩ̀sĩↄ koo pũna ń gulao á aɛ,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀ali píi a ↄtaalɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pɛ̃liↄ bↄlɛ lɛaaↄ gbɛu,","poem":1},{"lineBreak":true},{"text":"gbɛ́liↄ bↄlɛ lɛsikaoↄ gbɛu.","poem":1},{"lineBreak":true},{"text":"Bee aↄ ma tↄbↄ","poem":1},{"lineBreak":true},{"text":"seela láasai pↄ́ a súuli kpálɛo ũ.","poem":1}]}],"footnotes":[{"noteId":115,"caller":"+","text":"55.1 Zia 21.6, 22.17","reference":{"chapter":55,"verse":1}},{"noteId":116,"caller":"+","text":"55.3 Zĩn 13.34","reference":{"chapter":55,"verse":3}},{"noteId":117,"caller":"+","text":"55.10 2Kln 9.10","reference":{"chapter":55,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}