{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":56,"content":[{"type":"heading","content":["Bui píi suabaa"]},{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À zɛ ń yã́zɛdeo,","poem":1},{"lineBreak":true},{"text":"í yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"asa ma sↄu mà ń á suabaao,","poem":1},{"lineBreak":true},{"text":"má làa ń á bↄa maao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ lɛ́ bee kɛ","poem":1},{"lineBreak":true},{"text":"a yã́pi kũa ũ.","poem":1},{"lineBreak":true},{"text":"Ìli kã́mabogↄↄ pↄ́ má dìlɛ gbãlɛo,","poem":1},{"lineBreak":true},{"text":"à ↄbↄ̀lɛ vãi píiu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buipãle pↄ́ nàa su o","poem":1},{"lineBreak":true},{"text":"má we à gɛ̃ ma gbɛ̃́ↄ guuoo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a lɛ wia su mɛ","poem":1},{"lineBreak":true},{"text":"lí giin a ũo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃́ pↄ́ wà ń lɛ wìↄ ma kã́mabogↄↄ yãdà,","poem":1},{"lineBreak":true},{"text":"tó aa zɛ̀ ń ma pↄeão,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa ma bàakuańnↄ yã́ kũa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"má ↄgbɛkɛnɛ́ ma kpɛ́u,","poem":1},{"lineBreak":true},{"text":"an maa aↄ dɛ nɛgↄ̃ɛↄ ń nɛnↄɛↄla,","poem":1},{"lineBreak":true},{"text":"má ń tↄ́ na kɛ̃ a gĩↄwa,","poem":1},{"lineBreak":true},{"text":"tↄ́pi aↄ láaa vĩo, a ga bauo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buipãle pↄ́ aa nàa aa zĩkɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"aa ye ma tↄ́i aa zↄblemɛɛↄ,","poem":1},{"lineBreak":true},{"text":"aali kã́mabogↄↄ pↄ́ má dìlɛ gbãlɛo,","poem":1},{"lineBreak":true},{"text":"aa ma bàakuańnↄ yã́ kũaↄ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"má gɛ́ńnↄ ma sĩ̀sĩ pↄ́ a kua adoa musu,","poem":1},{"lineBreak":true},{"text":"má tó an pↄ kɛ na ma sísikpɛu.","poem":1},{"lineBreak":true},{"text":"Má ń sa pↄ́ aaì o ma gbagbakĩiↄ sí","poem":1},{"lineBreak":true},{"text":"ń sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũↄ,","poem":1},{"lineBreak":true},{"text":"asa wa mɛ ma kpɛ́ɛ bui píi lousisikpɛ.","poem":1},{"noteId":118}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma Dii Lua pↄ́ mi Isaili zĩ̀zↄↄ kãaa ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má ɛa gbɛ̃́ↄ kãaa kã́fĩ gbɛ̃́ pↄ́ kã̀aaↄ guu.","poem":1}]},{"type":"heading","content":["Lua yã́kpalɛkɛa ń ãnabi vãiↄ"]},{"type":"verse","number":9,"content":[{"text":"Sɛ̃̀a nↄ̀bↄↄ píi, à mↄ pↄble","poem":1},{"lineBreak":true},{"text":"ń lákpɛ nↄ̀bↄↄ píi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Isaili gudↄ̃anaↄá vĩ̀aↄnɛ píi,","poem":1},{"lineBreak":true},{"text":"aa a kee gbáɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ lɛ́nanaalɛaↄnɛ, aali gbokɛ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"aaìↄ wúlɛa ń nana'oao, aa ye ii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃ asiadeↄnɛ, blɛ lí mↄ́máo,","poem":1},{"lineBreak":true},{"text":"dↄaana pↄ́ yãe dↄ̃oↄnɛ.","poem":1},{"lineBreak":true},{"text":"An baade a pↄeã zɛ́ sɛ̀,","poem":1},{"lineBreak":true},{"text":"an baade zĩa mì mɛ̀ndo ài àlɛ wɛɛlɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aaì okↄ̃ɛ: À mↄ wà vɛ̃ɛ wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"wà í gbãa mi wà a dɛ kɛ.","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ mↄ̀ ń gbão a mↄ́ ń ziao,","poem":1},{"lineBreak":true},{"text":"iↄ dɛ gbã pↄ́ɛ beea maamaa.","poem":1}]}],"footnotes":[{"noteId":118,"caller":"+","text":"56.7 Mat 21.13","reference":{"chapter":56,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}