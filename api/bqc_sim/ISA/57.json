{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Gbɛ̃maaↄ lɛ́ midɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a yã́ lɛ́ kã̀ada gbɛ̃elao.","poem":1},{"lineBreak":true},{"text":"Wà luayãmanaↄ sɛ̀lɛ lɛ́ táńnↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃e làasoo i kawào.","poem":1},{"lineBreak":true},{"text":"Lua lɛ́ gbɛ̃́ maapiↄ si músi pↄ́ lɛ́ mↄ́wa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zɛmaasɛnapiↄ lɛ́ gↄ̃ ń aafiao,","poem":1},{"lineBreak":true},{"text":"aa kã́mabo ń wúlɛkĩiↄwa miau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ápiↄ sↄ̃, à mↄ la á màsokɛn nɛ́ↄ!","poem":1},{"lineBreak":true},{"text":"Gbãsĩde ń káaluao buiↄn á ũ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dé álɛ a láanikɛi?","poem":1},{"lineBreak":true},{"text":"Dé álɛ á lɛ́ yàasa ɛlɛwà","poem":1},{"lineBreak":true},{"text":"álɛ á lɛ́na bↄɛ̀i?","poem":1},{"lineBreak":true},{"text":"Á tàae nɛ́ↄ! Á bui mↄafilideↄ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Á mɛ ì lua tã́ai lí gbɛ̃̀nɛↄ gbáu","poem":1},{"lineBreak":true},{"text":"ń ligↄ̃n yàasaↄ píi.","poem":1},{"lineBreak":true},{"text":"I sa'o ń á nɛ́ↄ swai","poem":1},{"lineBreak":true},{"text":"ń gbɛ̀ lookpaaↄ zíɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A zɛ ń swa gbɛ̀ pↄ́lↄpↄlↄↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ á baa ũ.","poem":1},{"lineBreak":true},{"text":"Ao, ampiↄ a itↄ̃̀lɛmá,","poem":1},{"lineBreak":true},{"text":"a ń gbá pↄ́wɛnti.","poem":1},{"lineBreak":true},{"text":"Lá màaɛ, má gí tↄsiiwáe?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A dↄɛ'ĩikɛkĩi kɛ̀kɛ sĩ̀sĩ lɛsĩ musu,","poem":1},{"lineBreak":true},{"text":"wekĩi i dɛdɛ gɛ sa'ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I á zeeↄ pɛ́lɛ kpɛ́ kpɛɛlɛli saɛ.","poem":1},{"lineBreak":true},{"text":"A pãkpàmazi,","poem":1},{"lineBreak":true},{"text":"a á zwãa wòlowá,","poem":1},{"lineBreak":true},{"text":"a dɛdɛ a da á wúlɛkĩi yàasaa.","poem":1},{"lineBreak":true},{"text":"A lɛdoũkɛ̀ ń á yenzideↄ,","poem":1},{"lineBreak":true},{"text":"a wulɛńnↄ, a ↄlìa ń plɛi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A nísi gbɛ̃̀wá,","poem":1},{"lineBreak":true},{"text":"a fɛlɛ ń kibɛgɛtao,","poem":1},{"lineBreak":true},{"text":"a tulalelɛ̀ maamaa.","poem":1},{"lineBreak":true},{"text":"A a zĩnaↄ zĩ̀ bùsu zã̀zãu,","poem":1},{"lineBreak":true},{"text":"a ázĩa bùsa e bɛdau.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A ázĩa kpàsa ń tá dasi oao,","poem":1},{"lineBreak":true},{"text":"i dↄ̃ kɛ́ a zɛ́ kuoo.","poem":1},{"lineBreak":true},{"text":"A ázĩa lɛ̀ ń láo, ↄ̃ á yɛ̃̀ɛɛ i láao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dé álɛ bílikɛwà álɛ vĩakɛɛ̀","poem":1},{"lineBreak":true},{"text":"ↄ̃ a fɛlɛ ń mↄafilioi?","poem":1},{"lineBreak":true},{"text":"Ma yã́ i dↄáguo,","poem":1},{"lineBreak":true},{"text":"i ma yãda á sↄ̃uo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ ma nilɛ à gɛ̃̀gɛ̃ yã́i","poem":1},{"lineBreak":true},{"text":"álɛ vĩakɛmɛɛoa?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má á yãnakpaa ázĩawa ń á yãkɛao ɛɛkaɛ́ á ↄzĩ,","poem":1},{"lineBreak":true},{"text":"a kã́fĩakɛɛ́o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó a wɛ̃na wii lɛ̀,","poem":1},{"lineBreak":true},{"text":"á zĩadↄ̃abↄ pↄ́ á kã̀aaↄ á bↄ mɛ̀!","poem":1},{"lineBreak":true},{"text":"Aa gɛ̃ ń ĩ́anao píi,","poem":1},{"lineBreak":true},{"text":"baa lɛ́'ĩana a ń sɛ́lɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ nàmazi mɛ́ a bùsu túbible,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a gↄ̃ ma gbɛ̀sĩsĩ pↄ́ a kua adoa vĩ.","poem":1}]},{"type":"heading","content":["Lua gbɛ̃́ↄ gbã́gbãa"]},{"type":"verse","number":14,"content":[{"text":"Dii mɛ̀: À zɛ́kpa! À zɛ́kpa!","poem":1},{"lineBreak":true},{"text":"Àli miↄnaↄ bibi!","poem":1},{"lineBreak":true},{"text":"À pↄ́ pↄ́ wa gɛ̃nalɛwà gága ma gbɛ̃́ↄ zɛ́u!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Asa ma Lua Musude má dɛńla,","poem":1},{"lineBreak":true},{"text":"má kú gↄↄpii mɛ́ ma tↄ́ kua adoa.","poem":1},{"lineBreak":true},{"text":"Ma mɛ̀: Ma bɛ ku gulɛsĩ pↄ́ a kua adoau,","poem":1},{"lineBreak":true},{"text":"má kú lↄ ń nↄ̀sɛniɛ sùuudeo.","poem":1},{"lineBreak":true},{"text":"Mi sùuudeↄ gba wɛ̃ni dafu,","poem":1},{"lineBreak":true},{"text":"mi nↄ̀sɛniɛdeↄ gba sↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Máↄ yã́gagańnↄ láasaio,","poem":1},{"lineBreak":true},{"text":"ma pↄ aↄ paańzi gↄↄpiio.","poem":1},{"lineBreak":true},{"text":"Tó màaɛ, ma pↄkɛaↄ yɛ̃̀ɛɛ a láa,","poem":1},{"lineBreak":true},{"text":"an ĩ́an wɛ̃nide pↄ́ bↄ̀ ma kĩ́i a gɛ̃zɛa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"An gbɛ̃ble'ai tàae mɛ́ ma pↄ fɛ̃̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma ń gbɛ̃́ ma ulɛnɛ́ ń pↄkpɛ̃nɛo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa gì bↄ̀ ma kpɛ,","poem":1},{"lineBreak":true},{"text":"aa ń pↄeã zɛ́ sɛ̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa kɛ́ ma ń yãkɛaↄ è màa,","poem":1},{"lineBreak":true},{"text":"má ń gbã́gbã, má ń tàlakpa,","poem":1},{"lineBreak":true},{"text":"má ń sↄ̃ níninɛ́ vlɛ̃́vlɛ̃.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Má tó ma sáaukpaa aↄ dↄ ↄↄlↄnapiↄ lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ma Dii ma mɛ̀ má aafia kpá","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú zã̀ↄ ń gbɛ̃́ pↄ́ kú kãiↄwa,","poem":1},{"noteId":119},{"lineBreak":true},{"text":"mí ń gbã́gbã.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ dɛ lán ísia í pãpãakↄ̃wawa.","poem":1},{"lineBreak":true},{"text":"A í líↄ ku kílikilio,","poem":1},{"lineBreak":true},{"text":"a ikooaↄ ì fɛlɛ ń pɛ̀lɛao ń gbãsĩo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ aaↄ aafiao.","poem":1}]}],"footnotes":[{"noteId":119,"caller":"+","text":"57.19 Ɛfɛ 2.17","reference":{"chapter":57,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}