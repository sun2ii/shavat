zɛ ń yãpão, aaìↄ ɛɛto.","poem":1},{"lineBreak":true},{"text":"Aaì nↄsi yãkele ũ,","poem":1},{"lineBreak":true},{"text":"aaì nɛ'i gudɛ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaì mlɛ̃̀ gbe pipi,","poem":1},{"lineBreak":true},{"text":"aaì dã̀nsaba tã́.","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃́ ń gbe blè, a gaɛ,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃́ wì sↄ̃, kyã́ a bↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An bapiↄ lí pↄkasa kɛo,","poem":1},{"lineBreak":true},{"text":"an ↄzĩpiↄ lí pↄ́ nańzio.","poem":1},{"lineBreak":true},{"text":"An yãkɛaↄá gudɛɛ,","poem":1},{"lineBreak":true},{"text":"aa ↄdìdi yãpãsĩwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An kɛ̀sɛ lɛɛũ ń vãikɛao,","poem":1},{"lineBreak":true},{"text":"aaì yãesaide dɛ àannↄ.","poem":1},{"lineBreak":true},{"text":"Gudɛlaasoo aaìↄ kɛ,","poem":1},{"lineBreak":true},{"text":"aaì ásoo ń músio kpáńzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa aafia zɛ́ dↄ̃o,","poem":1},{"noteId":121},{"lineBreak":true},{"text":"yã́ dↄ̀ↄde kú ń tufauo.","poem":1},{"lineBreak":true},{"text":"Aaì zɛ́ kolekolea da,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ bɛuↄ líↄ aafia dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A yã́i tò yã́zɛde zã̀kũwanↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ yãmaa i wá leo.","poem":1},{"lineBreak":true},{"text":"Gupua wá wɛ́ dↄi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gusia wa su è,","poem":1},{"lineBreak":true},{"text":"gukɛ̃a wá mɛ wã̀i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gubeebee wá bɛu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wi ↄdↄ gĩi lán vĩ̀aↄwa,","poem":1},{"lineBreak":true},{"text":"wi ↄmalɛmalɛ lán wɛsaideↄwa,","poem":1},{"lineBreak":true},{"text":"wi gɛ̃nalɛ fãanɛ lán guluuluuiwa.","poem":1},{"lineBreak":true},{"text":"Wá gbãa fá,","poem":1},{"lineBreak":true},{"text":"ń beeo wá dɛ lán gɛↄwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wi wiilɛ lán wàiↄwa,","poem":1},{"lineBreak":true},{"text":"wi ↄ́ↄlↄ wɛ̃nannↄ lán felenaↄwa.","poem":1},{"lineBreak":true},{"text":"Wá wɛ́ ìↄ dↄ yã́zɛdei, wili eo,","poem":1},{"lineBreak":true},{"text":"wá mɛ wã̀ wà wá suaba, a zã̀wanↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asa wá tàaeↄ kↄ̃̀nɛ,","poem":1},{"lineBreak":true},{"text":"wá duuna wá dá yã́u.","poem":1},{"lineBreak":true},{"text":"Wá tàaeↄ zↄ̃̀lɛwá,","poem":1},{"lineBreak":true},{"text":"wá wá yãkɛaↄ dↄ̃ sa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wa bↄ Dii kpɛ wa mↄafilikɛ̀ɛ̀,","poem":1},{"lineBreak":true},{"text":"wa gi wá Luazi,","poem":1},{"lineBreak":true},{"text":"yãkpaanla ń kĩ́iwãio ì dↄaawɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Ɛɛ kↄ̃̀ wá sↄ̃ guu, àlɛ bↄlɛ wá lɛ́u.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Màa yã́zɛde pↄ̀ↄbↄzãkɛ̀,","poem":1},{"lineBreak":true},{"text":"maakɛa zɛa kãaa,","poem":1},{"lineBreak":true},{"text":"sĩana gɛ̃mbↄlɛ gãaɛ,","poem":1},{"lineBreak":true},{"text":"yã́ dↄ̀ↄde kùa gɛ̃kĩiwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sĩana gbɛzãkpà,","poem":1},{"lineBreak":true},{"text":"wì ↄ̃zↄ̃ gbɛ̃́ pↄ́ kɛ̃̀ vãiwawa.","poem":1},{"lineBreak":true},{"text":"Dii wɛkpàlɛ gwà, à kɛ̀ɛ̀ ĩ́i,","poem":1},{"lineBreak":true},{"text":"asa yã́zɛde kuo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A è gbɛ̃́ maae kuo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ yãkɛkɛnae kuo, à dìwà.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ à suabazɛ bↄ̀ ń a gↄ̃sagbãakɛo,","poem":1},{"lineBreak":true},{"text":"à gbãa'è a maakɛawa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À maakɛa dà mↄ̀ ula ũ,","poem":1},{"noteId":122},{"lineBreak":true},{"text":"à suabaa kpà mↄ̀ fùa ũ,","poem":1},{"noteId":123},{"lineBreak":true},{"text":"à tↄsima dà pↄkasaↄ ũ,","poem":1},{"lineBreak":true},{"text":"à ãiapãsĩ kàkaala ulada ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A fĩabo gbɛ̃́ↄnɛ ń yãkɛawa,","poem":1},{"lineBreak":true},{"text":"a pↄkũmabↄbↄ a ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"a tↄsi a wɛ̀lɛↄwa,","poem":1},{"lineBreak":true},{"text":"i asea kɛ ísiabaadeↄnɛ a zɛ́wa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bɛ'aɛdeↄ vĩakɛ Dii tↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"gukpɛdeↄ aà gawi da gbia,","poem":1},{"lineBreak":true},{"text":"asa a mↄ́ lán í gufↄ̃awa,","poem":1},{"lineBreak":true},{"text":"lán í pↄ́ Dii lɛ́'ĩana lɛ́ ↄzↄ̃iwa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yakↄbu buiↄ Bona a mↄ Siↄna","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ mikɛ̃̀ ń duunaↄwaↄ kĩ́i.","poem":1},{"noteId":124},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"ma bàakuańnↄ yã́n kɛ:","poem":1},{"lineBreak":true},{"text":"Ma Nisĩna pↄ́ kúwá","poem":1},{"lineBreak":true},{"text":"ń ma yã́ pↄ́ má dàɛ́ á lɛ́uo","poem":1},{"lineBreak":true},{"text":"a bↄ á lɛ́uo ge á nɛ́ↄ ge á tↄũnaↄ","poem":1},{"lineBreak":true},{"text":"za gbã e gↄↄpii.","poem":1}]}],"footnotes":[{"noteId":121,"caller":"+","text":"59.8 Lom 3.15-17","reference":{"chapter":59,"verse":8}},{"noteId":122,"caller":"+","text":"59.17 Ɛfɛ 6.14","reference":{"chapter":59,"verse":17}},{"noteId":123,"caller":"+","text":"59.17 Ɛfɛ 6.17, 1Tɛs 5.8","reference":{"chapter":59,"verse":17}},{"noteId":124,"caller":"+","text":"59.20 Lom 11.26"