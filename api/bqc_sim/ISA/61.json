{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":61,"content":[{"type":"heading","content":["Dii ɛ̀fãaigↄↄ"]},{"type":"verse","number":1,"content":[{"text":"Dii Lua Nisĩna kua,","poem":1},{"lineBreak":true},{"text":"à ma sɛ mà baonakpa taasideↄnɛ,","poem":1},{"noteId":128},{"lineBreak":true},{"text":"à ma zĩ mà pↄsiadeↄ gba sↄ̃","poem":1},{"lineBreak":true},{"text":"mà zĩ̀zↄↄ gↄ̃a wɛ̃́ɛↄ ũ ń dakpɛunaↄ gbaɛao kpàwakɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mà Dii gbɛ̃kɛkɛnɛgↄↄ","poem":1},{"noteId":129},{"lineBreak":true},{"text":"ń wá Lua tↄsimagↄↄo onɛ́,","poem":1},{"lineBreak":true},{"text":"pↄsiadeↄ nↄ̀sɛ i níni píi.","poem":1},{"noteId":130}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À ma zĩ mà fùakpa Siↄna ↄↄlↄnaↄnɛ túfu gbɛu,","poem":1},{"lineBreak":true},{"text":"mà pↄna nísi dↄↄmá an gbãsĩkpaa gbɛu,","poem":1},{"lineBreak":true},{"text":"mà táasilɛa pↄkasa danɛ́ an kãgaa gbɛu.","poem":1},{"lineBreak":true},{"text":"Aaↄ maa, wiↄ mɛnɛ́","poem":1},{"lineBreak":true},{"text":"lí pↄ́ Dii bà azĩa tↄbↄa yã́iↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aa bɛzia sà zizi vu,","poem":1},{"lineBreak":true},{"text":"aa pↄ́ pↄ́ wà a dɛɛlɛmpà yãaↄ kɛkɛ,","poem":1},{"lineBreak":true},{"text":"aa ɛa wɛ̃́lɛ pↄ́ gↄ̃̀ da wáiwai za káauↄ kálɛ lↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bui zĩ̀loↄ á pↄ́ↄ dã́dãɛ́,","poem":1},{"lineBreak":true},{"text":"buipãleↄ á bua ń á vɛ̃ɛbuↄ sɛ̃waɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ápiↄ sↄ̃, wa mɛɛ́ Dii gbàgbanaↄ,","poem":1},{"lineBreak":true},{"text":"wa á sísi wá Lua zĩkɛnaↄ.","poem":1},{"lineBreak":true},{"text":"Á buiↄ àizɛɛble,","poem":1},{"lineBreak":true},{"text":"á ĩ́anadã ń ń pↄmaaↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ asea e lɛɛ pla","poem":1},{"lineBreak":true},{"text":"wí pↄ́ wa dàmá gbɛu,","poem":1},{"lineBreak":true},{"text":"aa pↄnakɛ ń ń baao","poem":1},{"lineBreak":true},{"text":"an gɛɛkpanwɛia gbɛu.","poem":1},{"lineBreak":true},{"text":"Aa gↄ̃ bùsu lɛɛ pla vĩ,","poem":1},{"lineBreak":true},{"text":"pↄna láasai aↄ dɛ ń pↄ́ ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ma Dii, yã́zɛde mɛ́ ì kamagu,","poem":1},{"lineBreak":true},{"text":"má za pↄ́siama ń gbãableamáogu.","poem":1},{"lineBreak":true},{"text":"Má ń asea kpámá ń náaio,","poem":1},{"lineBreak":true},{"text":"ma bàa aↄ kúńnↄ gↄↄpii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waↄ ń buiↄ dↄ̃ dṹniau,","poem":1},{"lineBreak":true},{"text":"an nɛ́ↄ tↄbↄ bui píi kĩ́i,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ń é píi i dↄ̃ kɛ́","poem":1},{"lineBreak":true},{"text":"aa dɛ gbɛ̃́ pↄ́ ma báaadàńguↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mi pↄnakɛ ń Diio maamaa,","poem":1},{"lineBreak":true},{"text":"ma pↄ na ma Luawa,","poem":1},{"lineBreak":true},{"text":"asa à suabaa nàmazi pↄkasa ũ,","poem":1},{"lineBreak":true},{"text":"à bↄa maa dàmɛɛ ula ũ,","poem":1},{"lineBreak":true},{"text":"lán nↄsɛna pↄ́ kákakɛ̀wa,","poem":1},{"lineBreak":true},{"text":"lá aà nↄ pↄ́ a zãblebↄↄ fĩ̀wawa.","poem":1},{"noteId":131}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá tↄↄlɛ ì to pↄ́ bↄlɛwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ bua ì to pↄ́wɛna fɛlɛ,","poem":1},{"lineBreak":true},{"text":"màa Dii Lua a to yã́zɛde ligua,","poem":1},{"lineBreak":true},{"text":"a to wà ma táasilɛ bui píi wáa.","poem":1}]}],"footnotes":[{"noteId":128,"caller":"+","text":"61.1 Mat 11.5, Luk 7.22","reference":{"chapter":61,"verse":1}},{"noteId":129,"caller":"+","text":"61.2 Luk 4.18-19","reference":{"chapter":61,"verse":2}},{"noteId":130,"caller":"+","text":"61.2 Mat 5.4","reference":{"chapter":61,"verse":2}},{"noteId":131,"caller":"+","text":"61.10 Zia 21.2","reference":{"chapter":61,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}