{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":62,"content":[{"type":"heading","content":["Yelusalɛũ dafu"]},{"type":"verse","number":1,"content":[{"text":"Siↄna yã́i máↄ nílɛao,","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ yã́i ma lɛ́ a gↄ̃ kpaaũao","poem":1},{"lineBreak":true},{"text":"e a gɛ bↄò maa lá gu ì dↄwa,","poem":1},{"lineBreak":true},{"text":"e a suabaa gɛ àↄ pípi lán sɛ̃tɛwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buiↄ n bↄa maa e,","poem":1},{"lineBreak":true},{"text":"kíaↄ wɛsi n gawilɛ ḿpii.","poem":1},{"lineBreak":true},{"text":"Wa tↄ́ dafu pↄ́ a bↄ Dii lɛ́u kpánɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ↄ dɛ lán tulu gawidewa Dii ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ dɛ kíafua ũ á Lua ↄlau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wa mɛnɛ Bɛzia bau lↄo,","poem":1},{"lineBreak":true},{"text":"wa n bùsu sísi Guwaiwai bau lↄo.","poem":1},{"lineBreak":true},{"text":"Waↄ mɛnɛ Mapↄeãwɛ̃lɛ,","poem":1},{"lineBreak":true},{"text":"n bùsu sↄ̃ Nↄzãe,","poem":1},{"lineBreak":true},{"text":"asa Dii pↄ aↄ dↄma,","poem":1},{"lineBreak":true},{"text":"mɛ́ n bùsu a zãkɛaànↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lá ɛ̀waaso ì wɛ̃́ndia sɛ́,","poem":1},{"lineBreak":true},{"text":"màa n Kɛna a n sɛ́.","poem":1},{"lineBreak":true},{"text":"Lá nↄsɛna ì pↄnakɛ ń a nↄo,","poem":1},{"lineBreak":true},{"text":"màa n Lua a pↄnakɛnnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yelusalɛũ, ma gudↄ̃anaↄ dilɛ n bĩ́iↄ musu,","poem":1},{"lineBreak":true},{"text":"aaↄ nílɛao fãanɛ ń gwãasĩnao píi.","poem":1},{"lineBreak":true},{"text":"Á Dii sìsinaↄ, ásu kã́maboo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"àↄ zɛaàzi e a gɛ Yelusalɛũ kálɛ,","poem":1},{"lineBreak":true},{"text":"i aà kɛ wɛ̃́lɛ pↄ́ dṹnia àↄ aà táasilɛ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii ladà ń ↄlɛlɛao,","poem":1},{"lineBreak":true},{"text":"a ò ń a gã̀sa gbãa dↄao à mɛ̀","poem":1},{"lineBreak":true},{"text":"á á blɛwɛ kpá á ibɛɛↄwa bau lↄo,","poem":1},{"lineBreak":true},{"text":"buipãleↄ vɛ̃ɛ pↄ́ a a zĩkɛ̀ mi lↄo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kɛ̀kɛnaↄ ble, aai ma táasilɛ,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛkↄzↄ̃zↄ̃naↄ mi ma kpɛ́ kpɛɛlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"À bↄlɛ! À bↄlɛ wɛ̃́nkpɛ!","poem":1},{"lineBreak":true},{"text":"À zɛkɛkɛ gbɛ̃́ↄnɛ!","poem":1},{"lineBreak":true},{"text":"À kpá! À zɛda kpá! À gbɛↄ gágau,","poem":1},{"lineBreak":true},{"text":"í gudↄkↄ̃ɛkĩi dilɛ buiↄnɛ!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gwa! Dii kpàwakɛ̀ e dṹnia lɛ́wa:","poem":1},{"lineBreak":true},{"text":"O Siↄnaɛ aà Suabana lɛ́ mↄ́.","poem":1},{"lineBreak":true},{"text":"Gwa! A a asea kũa","poem":1},{"lineBreak":true},{"text":"mɛ́ a a zĩ ài kpán'aɛkɛa.","poem":1},{"noteId":132}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wa mɛnɛ́ Lua gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ Dii ń bóↄ.","poem":1},{"lineBreak":true},{"text":"Wa mɛnɛ Wa'ↄliai, Bɛzianlↄo.","poem":1}]}],"footnotes":[{"noteId":132,"caller":"+","text":"62.11 Isa 40.10, Zia 22.12","reference":{"chapter":62,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}