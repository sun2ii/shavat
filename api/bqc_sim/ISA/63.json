{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":63,"content":[{"type":"heading","content":["Dii tↄsimagↄↄ"]},{"type":"verse","number":1,"content":[{"text":"Démɛ bↄ̀ Ɛdↄũ bùsuu, àlɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"à bↄ̀ Bↄzɛla, aà pↄkasaↄ tã̀ keei?","poem":1},{"noteId":133},{"lineBreak":true},{"text":"Démɛ lɛ́ gↄ̃sagↄ̃sa táa'o ń gbãa zↄ̃ↄo,","poem":1},{"lineBreak":true},{"text":"a ula gawide daa keei?","poem":1},{"lineBreak":true},{"text":"Mámɛ, málɛ zĩblea kpàwakɛ,","poem":1},{"lineBreak":true},{"text":"má gbɛ̃́ↄ suabaa gbãa vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bↄ́yãi n ula ń n pↄkasaↄ tã̀","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ ↄ̃zↄ̃̀ vɛ̃ɛfɛ̃kĩiu pↄ́wai?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma ↄ̃zↄ̃̀ vɛ̃ɛfɛ̃kĩiu mado,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e kumanↄo, baa do.","poem":1},{"lineBreak":true},{"text":"Ma ↄ̃zↄ̃̀ buiↄwa ń pↄkũmao,","poem":1},{"lineBreak":true},{"text":"ma kɛ̀sɛ tↄ̃̀má ma pↄfɛ̃ yã́i.","poem":1},{"lineBreak":true},{"text":"An au fã̀fã ma pↄkasaↄwa,","poem":1},{"noteId":134},{"lineBreak":true},{"text":"ma ula gbãsĩkpà píi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa má tↄsimagↄↄ kũa ma sↄ̃u,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ bogↄↄ kà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma gugwàgwa, gbɛ̃e ku à dↄmalɛo,","poem":1},{"lineBreak":true},{"text":"yã́ dìa kɛ́ gbɛ̃e ku à ma gba gbãao.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ ma zĩblè ń mazĩa gã̀sa gbãao,","poem":1},{"lineBreak":true},{"text":"ma pↄkũma mɛ́ ma gba gbãa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ↄ̃zↄ̃̀ buiↄwa ń pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"má tò ma pↄkũma í zↄ̃̀lɛmá,","poem":1},{"lineBreak":true},{"text":"ma ń au kↄ̀lɛ zĩ́lɛ.","poem":1}]},{"type":"heading","content":["Dii gbɛ̃kɛ galikɛa"]},{"type":"verse","number":7,"content":[{"text":"Má Dii gbɛ̃kɛ galikɛ ń aà táasilɛao,","poem":1},{"lineBreak":true},{"text":"asa à yã́pii kɛ̀wɛ̃ɛ wá gwaa guu,","poem":1},{"lineBreak":true},{"text":"à yãmaa dasi kɛ̀ wá Isailiↄnɛ gbɛ̃kɛ guu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À mɛ̀: Aa dɛ ma gbɛ̃́ↄ ũ,","poem":1},{"lineBreak":true},{"text":"aa mↄafiliyã kɛmɛɛo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ ń Suabana ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A dↄ̃ńnↄ ń taasikɛa guu píi,","poem":1},{"lineBreak":true},{"text":"aà aɛ malaika ń suabà,","poem":1},{"lineBreak":true},{"text":"à ń bó kɛ́ a yeńzi à ń wɛ̃nagwà yã́i.","poem":1},{"lineBreak":true},{"text":"A ń sɛa za yãayãa a ń kũa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kási aa bↄ̀ aà kpɛ,","poem":1},{"lineBreak":true},{"text":"aa aà Nisĩna pↄ yàɛ̀.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ à mikpɛdↄ̀nɛ́ à gↄ̃̀ ń ibɛɛ ũ,","poem":1},{"lineBreak":true},{"text":"à zĩkàńnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɔ̃ Mↄizi gↄↄ yã́ dↄ̀ aà gbɛ̃́ↄgu aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ bùa ń a kpàsa dã̀dãnao ísiawa,","poem":1},{"lineBreak":true},{"text":"à a Nisĩna dàńgu ku má ni?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À a gã̀sa gawide pòo Mↄizi ↄplaai,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à í zↄ̃̀ɛ ń aɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à tↄbↄ e gↄↄpii yã́i.","poem":1},{"noteId":135}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À gɛ̃̀ńnↄ í títiu, aai gɛ̃mbↄlɛo","poem":1},{"lineBreak":true},{"text":"lán sↄ̃́ pↄ́ lɛ́ bàalɛ guwaiwaiuwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɔ̃ Dii Nisĩna ń gbá ĩ́ampakĩi,","poem":1},{"lineBreak":true},{"text":"lán zu pↄ́ wà gɛ̀ńnↄ swadↄↄiↄwa.","poem":1},{"lineBreak":true},{"text":"Màa n dↄaanɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ́ n e tↄbↄ yã́i.","poem":1}]},{"type":"heading","content":["Suabaa wii"]},{"type":"verse","number":15,"content":[{"text":"Kua za musu wɛ́kpalɛ ǹ gwa,","poem":1},{"lineBreak":true},{"text":"kua za n gulɛsĩ gawide pↄ́ a kua adoau.","poem":1},{"lineBreak":true},{"text":"N pãsĩ ń n nɛgↄ̃nkɛo tↄ́n lá?","poem":1},{"lineBreak":true},{"text":"N gi wɛ̃na ń sósobio kɛiwɛ̃ɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baa tó Ablahaũ wá dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń wá Mae ũ.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ wá yã́ i dↄ Isailiguo,","poem":1},{"lineBreak":true},{"text":"Dii, ḿmɛ ń wá Mae ũ,","poem":1},{"lineBreak":true},{"text":"n tↄ́n wá Bona za zi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii, bↄ́yãi ń tò wa zã n zɛ́wai?","poem":1},{"lineBreak":true},{"text":"Àkɛa n wá swã́ gbãakũ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wá n vĩa vĩo ni?","poem":1},{"lineBreak":true},{"text":"Ɛa su wápi n zↄ̀blenaↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ń sɛ̀ buiↄn wá ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ bùsu pↄ́ ń kpàwá vĩ gↄↄpla,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wá ibɛɛↄ mↄ̀ ↄ̃zↄ̃̀ n kpɛ́wa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wá dɛ lán gbɛ̃́ pↄ́ ń iko vĩmáoↄwa à gɛ̃̀gɛ̃,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ n tↄ́ kúmáoↄwa.","poem":1},{"lineBreak":true},{"text":"Kai! Tó n musu wɛ̃̀ n pila,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ lualua n aɛ.","poem":1}]}],"footnotes":[{"noteId":133,"caller":"+","text":"63.1 Isa 34.5-8","reference":{"chapter":63,"verse":1}},{"noteId":134,"caller":"+","text":"63.3 Zia 14.19, 19.13, 15","reference":{"chapter":63,"verse":3}},{"noteId":135,"caller":"+","text":"63.12 Bↄa 14.21","reference":{"chapter":63,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}