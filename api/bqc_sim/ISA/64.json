{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Ńyↄ̃ↄ dɛ lán tɛ́ pↄ́ kũ̀ yàa giiwa","poem":1},{"lineBreak":true},{"text":"a tò ípiwa,","poem":1},{"lineBreak":true},{"text":"n ibɛɛↄ i n tↄ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"buiↄ i gilikɛ n aɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asa kɛ́ n pila yãa,","poem":1},{"lineBreak":true},{"text":"n dabudabu pↄ́ wá a fãn vĩo kɛ̀,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ lùalua n aɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii pↄ́ ì yãkɛ gbɛ̃́ pↄ́ an wɛ́ dↄaàziↄnɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ì kɛ n bàasio, wi e yãa gueio.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e swã́ i mao, gbɛ̃e i wɛsiɛo.","poem":1},{"noteId":136}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ni zɛ ń gbɛ̃́ pↄ́ n yã́li sãaàguoo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì yãkɛ a zɛ́wa ń pↄnao.","poem":1},{"lineBreak":true},{"text":"Ãma kɛ́ wa duunakɛ̀, n fɛ̃wázi,","poem":1},{"lineBreak":true},{"text":"wá kuò à gɛ̃̀gɛ̃, kpelewa wá bↄui?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wápii, wa gↄ̃ gbãlɛa,","poem":1},{"lineBreak":true},{"text":"wá maakɛaↄ píi dɛ lán bↄlↄwa.","poem":1},{"lineBreak":true},{"text":"Wápii wálɛ i'o lán lí láwa,","poem":1},{"lineBreak":true},{"text":"wá yãvãikɛa a gɛ̃wanↄ zɛ́a lán ĩ́anawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃e lɛ́ n sisi lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e i fɛlɛ lɛ́ zɛzɛnzi lↄo,","poem":1},{"lineBreak":true},{"text":"asa n n wɛ́ gàwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"n wá kpá wá yãvãiↄla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kási ḿmɛ ń wá Mae ũ Dii,","poem":1},{"lineBreak":true},{"text":"gĩn wá ũ, wá bonan n ũ,","poem":1},{"lineBreak":true},{"text":"n ↄgbɛn wá ũ wápii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, n pↄ su pawázi à gɛ̃agɛ̃o,","poem":1},{"lineBreak":true},{"text":"wá yãvãiↄ su àↄ dↄngu gↄↄpiio.","poem":1},{"lineBreak":true},{"text":"Wá wɛgwa, n gbɛ̃́ↄn wá ũ wápii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N wɛ̃́lɛↄ gↄ̃̀ gbáa ũ,","poem":1},{"lineBreak":true},{"text":"baa Siↄna gↄ̃̀ gbáa ũ,","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ gↄ̃̀ guwaiwai ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N kpɛ́ gawide pↄ́ a kua adoa","poem":1},{"lineBreak":true},{"text":"pↄ́ wá deziↄ n táasilɛ̀u tɛkũ̀,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ wá pↄ dↄwàↄ ↄ̃̀ↄkpà píi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ↄ yã́ beeↄ gwa, ní gí yãe kɛia?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ↄ nílɛ kpɛ̃́, ní ↄtↄ̃ↄlɛwá à gɛ̃agɛ̃̀a?","poem":1}]}],"footnotes":[{"noteId":136,"caller":"+","text":"64.3 1Kln 2.9","reference":{"chapter":64,"verse":3}}]},"thisChapterLink":"/api/bqc_sim/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}