{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ISA","translationId":"bqc_sim","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1f599109c4a9a62fd5eefc95b87c6a8dda8ac7d2caeb5ee8f574fabb224ff06e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/bqc_sim/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":9,"content":[{"type":"heading","content":["Wà nɛ'ìwɛ̃ɛ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃́ pↄ́ aa ku gusiauↄ gupua zↄ̃ↄ è,","poem":1},{"lineBreak":true},{"text":"gu dↄ̀ bùsu pↄ́ kú ga lɛ́zĩ deↄnɛ.","poem":1},{"noteId":20}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ń tò an pↄ kɛ̀na zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"n ń gbá pↄna maamaa.","poem":1},{"lineBreak":true},{"text":"Aalɛ pↄnakɛ n aɛ","poem":1},{"lineBreak":true},{"text":"lá wì kɛ pↄkɛkɛgↄↄwa,","poem":1},{"lineBreak":true},{"text":"lá aalɛ zĩblea pↄ́ kpaalɛwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa n zuu pↄ́ wa dànɛ́ ń gã̀u","poem":1},{"lineBreak":true},{"text":"ń go pↄ́ wàlɛ ń gbɛ̃òo ɛ̀'ɛ.","poem":1},{"lineBreak":true},{"text":"N ń wɛtãnapiↄ fù","poem":1},{"lineBreak":true},{"text":"lá ń kɛ̀ Madiãↄnɛ yãawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩgↄ̃ kyaleↄ ń ń ula pↄ́ au gↄ̃́kpawàↄ,","poem":1},{"lineBreak":true},{"text":"wa kátɛu à tɛ́kũ yàa ũɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asa wà nɛ'ìwɛ̃ɛɛ,","poem":1},{"lineBreak":true},{"text":"wà wá gbá nɛgↄ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Lua kíakɛmi dìɛ̀,","poem":1},{"noteId":21},{"lineBreak":true},{"text":"wàli oɛ̀ Lɛdamade Bↄnsaɛde, Lua Gbãade,","poem":1},{"lineBreak":true},{"text":"Mae Gↄↄpiide,","poem":1},{"noteId":22},{"text":"Aafia Kía.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aà kpala zↄ̃ↄ ń a aafiao aↄ lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"aↄ zↄ̃lɛa báawa Davidi kpalau.","poem":1},{"noteId":23},{"lineBreak":true},{"text":"Aà kpala zĩ́napɛlɛa aↄ gbãa,","poem":1},{"lineBreak":true},{"text":"aↄ yã́gↄ̃gↄ̃ wásawasa a zɛ́wa gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de ãia mɛ́ a mↄ́ ń beeo.","poem":1}]},{"type":"heading","content":["Dii pↄpaa Isailiↄzi"]},{"type":"verse","number":7,"content":[{"text":"Dii yã'o kpã̀sã Yakↄbu buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"yã́pi a wi Isailiↄ musuɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Samalideↄ ń Ɛflaiũ buiↄ yã́pi ma.","poem":1},{"lineBreak":true},{"text":"Aa wala ń kàamaio vĩ aa mɛ̀:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kpɛ́ pↄ́ wa dↄ̀ ń bilikiↄ kwɛ̀,","poem":1},{"lineBreak":true},{"text":"wá bo ń gbɛoɛ sa.","poem":1},{"lineBreak":true},{"text":"Wà wá kaadↄɛnliↄ zↄ̃̀zↄ̃,","poem":1},{"lineBreak":true},{"text":"sɛdɛ líↄ wá pɛ́ ń gɛ̃ɛ ũ sa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔ̃ Dii ń ibɛɛↄ kã̀fĩ,","poem":1},{"lineBreak":true},{"text":"à ń wɛ̀lɛↄ sóikɛ̀má.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siliↄ bↄ̀ gukpɛ oi,","poem":1},{"lineBreak":true},{"text":"Filitɛ̃ↄ bↄ̀ bɛ'aɛ oi,","poem":1},{"lineBreak":true},{"text":"aa Isailiↄ sↄ̃̀sↄ̃ ń lɛ́ pai.","poem":1},{"lineBreak":true},{"text":"Ń beeo píi Dii pↄkũma a kpálɛo,","poem":1},{"lineBreak":true},{"text":"aà ↄ aↄ looańlaɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Isailiↄ i ɛa sù ń tòtonawao,","poem":1},{"lineBreak":true},{"text":"aai Dii Zĩgↄ̃de kĩ́i wɛɛlɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yã́i tò Dii a Isailiↄ mi zↄ̃ ń ń vlã́o píi,","poem":1},{"lineBreak":true},{"text":"a ń zaliↄ ń ń kɛfuↄ zↄ̃zↄ̃ gↄↄ do kóũɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃zↄ̃ↄↄ ń gbɛ̃́ pↄ́ aaì ń mi da íaↄ mɛ́ mipi ũ,","poem":1},{"lineBreak":true},{"text":"ãnabi ɛgɛnaↄ mɛ́ vlã́pi ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ dↄaanaↄ lɛ́ ń sãsãɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gbɛ̃́ pↄ́ tɛ́ńziↄ lɛ́ midɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yã́i an ɛ̀waasoↄ i ka Diiguo,","poem":1},{"lineBreak":true},{"text":"an tonɛↄ ń ń gyaaↄ i kɛɛ̀ wɛ̃naũo,","poem":1},{"lineBreak":true},{"text":"asa luayãdansai vãikɛnaↄn ń ũ,","poem":1},{"lineBreak":true},{"text":"yãdↄↄsai mɛ́ ìↄ dↄ ń lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ń beeo píi aà pↄkũma a kpálɛo,","poem":1},{"lineBreak":true},{"text":"aà ↄ aↄ looańlaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yãvãi ì fɛlɛmá lán tɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì kũ lɛaa ń lɛsikaoowa,","poem":1},{"lineBreak":true},{"text":"ì da dào ń likpɛↄla,","poem":1},{"lineBreak":true},{"text":"a lu iↄ súɛlɛ búuna bↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de kpɛ̃nɛmuu a to bùsupi tɛ́sɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩnaↄ mɛ́ aaↄ dɛ tɛ́pi yàa ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a a dee wɛ̃nagwao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wa pↄ́ li ↄplaai,","poem":1},{"lineBreak":true},{"text":"nↄana a gi àↄ ń dɛɛ.","poem":1},{"lineBreak":true},{"text":"Wa pↄble ↄzɛɛi, kási wa kão,","poem":1},{"lineBreak":true},{"text":"baade a a gbɛ̃́dee sóso.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Manase buiↄ kɛ Ɛflaiũ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ kɛ Manase buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"ampii aai kɛ Yudaↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ń beeo píi aà pↄkũma a kpálɛo,","poem":1},{"lineBreak":true},{"text":"aà ↄ aↄ looańlaɛ.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"9.1 Mat 4.15-16, Luk 1.79","reference":{"chapter":9,"verse":1}},{"noteId":21,"caller":"+","text":"9.5 Mat 28.18","reference":{"chapter":9,"verse":5}},{"noteId":22,"caller":"+","text":"9.5 Zãa 14.9-10","reference":{"chapter":9,"verse":5}},{"noteId":23,"caller":"+","text":"9.6 Luk 1.32-33","reference":{"chapter":9,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}