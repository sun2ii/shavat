{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JDG","translationId":"bqc_sim","name":"Dↄaanaↄ","commonName":"Dↄaanaↄ","title":"DƆAANAƆ","order":7,"numberOfChapters":21,"sha256":"63a16be25d624c06994745a8fe8ad23a3296340e92bb46740a958cf24256cb9c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/bqc_sim/JDG/21.json","totalNumberOfVerses":617},"chapter":{"number":5,"content":[{"type":"heading","content":["Lɛ pↄ́ Debolaa dà"]},{"type":"verse","number":1,"content":["Zĩbeezĩ Debolaa ń Abinↄaũ nɛ́ Balakuo lɛɛ bee sì:"]},{"type":"verse","number":2,"content":[{"text":"Kɛ́ Isaili dↄaanaↄ bↄ̀ dↄ̀aa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ kĩniↄ tɛ́ńzi teasisai.","poem":1},{"lineBreak":true},{"text":"À Dii sáaukpa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kíaↄ, à yã́ɛ bee ma!","poem":1},{"lineBreak":true},{"text":"Gbãadeↄ, à swã́kpa!","poem":1},{"lineBreak":true},{"text":"Má lɛsi Dii yã́ musu,","poem":1},{"lineBreak":true},{"text":"má Dii Isailiↄ Lua táasilɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ́ Dii bↄ̀ Sei gbɛ musu,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ lùalua,","poem":1},{"lineBreak":true},{"text":"kɛ́ àlɛ pã Ɛdↄũↄ bùsupia,","poem":1},{"lineBreak":true},{"text":"loupↄↄ fↄ̃̀, lou mà maamaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ dèedee Dii aɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua pↄ́ bↄ̀ mↄ̀má Sinaipi.","poem":1},{"noteId":12}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anata nɛ́ Samɛgaa gↄↄ, Yaeli gↄↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lí zɛda sɛ lↄo,","poem":1},{"lineBreak":true},{"text":"zɛ́wɛwɛna ↄ̃ wɛ̃́lɛgɛna ì sɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kíaↄ lɛ́ midɛ Isaili bùsuu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma Debolaa ma gↄ̃ Isailiↄ da ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ́ aa zɛ̀ ń dii dafuↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ zĩ kↄ̃ kũ̀ wɛ̃́lɛ bĩ́ibↄlɛu.","poem":1},{"lineBreak":true},{"text":"Baa gbɛ̃ↄn ↄ̀aasↄsↄo lɛɛ bla (40.000) guu","poem":1},{"lineBreak":true},{"text":"gbɛ̃e sɛ̀ngbao ge sↄ̃na vĩo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma pↄ dↄ Isailiↄ dↄaanaↄwa","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ tɛ́ńzi teasisaiↄ.","poem":1},{"lineBreak":true},{"text":"À Dii sáaukpa!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á di zàa'ĩn pua kpɛↄ","poem":1},{"lineBreak":true},{"text":"á gbɛ̃́ pↄ́ á zↄ̃lɛ tɛfɛniwapiↄ","poem":1},{"lineBreak":true},{"text":"ń á gbɛ̃́ pↄ́ á bɛ kɛ̀sɛↄ, à a yã'o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kãaaa ítↄkĩiↄ zↄa dↄ,","poem":1},{"lineBreak":true},{"text":"aa Dii maakɛaↄ dàu lɛ́ siunɛ́,","poem":1},{"lineBreak":true},{"text":"Isailiↄ kíaↄ zĩblè,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Dii gbɛ̃́ↄ sù ń wɛ̃́lɛↄ guu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fɛlɛ Debolaa! Fɛlɛ!","poem":1},{"lineBreak":true},{"text":"Fɛlɛ lɛsi! Fɛlɛ!","poem":1},{"lineBreak":true},{"text":"Abinↄaũ nɛ́ Balaku,","poem":1},{"lineBreak":true},{"text":"fɛlɛ dↄaa n zĩ̀zↄↄnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃ gbɛ̃́ pↄ́ gↄ̃̀ↄ bↄ̀ mↄ̀ kíaↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"Dii gbɛ̃́ↄ mↄ̀ ma kĩ́i ń nɛgↄ̃naↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛflaiũ bui pↄ́ aa Amalɛki buiↄ fùↄ","poem":1},{"lineBreak":true},{"text":"ń Bɛ̃yãmɛɛ buieↄ tɛnzi.","poem":1},{"lineBreak":true},{"text":"Makii buieↄ dɛ dↄaanaↄ ũ,","poem":1},{"lineBreak":true},{"text":"Zabulↄni buieↄ gopana kũa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isakaa bui kíaↄ kú ń Debolaao,","poem":1},{"lineBreak":true},{"text":"Isakaa buiↄ kú ń Balakuo,","poem":1},{"lineBreak":true},{"text":"aa sìaànↄ gusalalau.","poem":1},{"lineBreak":true},{"text":"Lubɛni bui gãliↄ seakɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Àkɛa a gↄ̃ kĩnaↄ saɛ,","poem":1},{"lineBreak":true},{"text":"álɛ kulɛpɛa sãↄnɛ mai?","poem":1},{"lineBreak":true},{"text":"Lubɛni bui gãliↄ seakɛ̀ maamaaɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Galada bùsudeↄ gↄ̃̀ Yuudɛ̃ baale.","poem":1},{"lineBreak":true},{"text":"Àkɛa Dã buiↄ zɛ̀ ń ń gó'ilɛnaↄi?","poem":1},{"lineBreak":true},{"text":"Asɛɛ buiↄ zↄ̃lɛ ísialɛ,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ ń godↄkĩiↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zabulↄni buiↄ fɛ̃na wò,","poem":1},{"lineBreak":true},{"text":"aa a kpɛ́ vũ̀aa,","poem":1},{"lineBreak":true},{"text":"Nɛfatali buiↄ kɛ̀ gulɛsĩↄu màa lↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kanaa bùsu kíaↄ mↄ̀,","poem":1},{"lineBreak":true},{"text":"aa zĩkà Taanaki Mɛgido swa saɛ,","poem":1},{"lineBreak":true},{"text":"kási aai àizɛɛ sɛ́lɛ tàòo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Za musu saanaↄ zĩkà,","poem":1},{"lineBreak":true},{"text":"aa bↄ̀ ń zɛ́u, aa zĩkà ń Siselao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kisↄ̃ swa zipi tàńnↄ.","poem":1},{"lineBreak":true},{"text":"Má gɛ́ aɛ, mí gɛ́ ń gbãao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sↄ̃́ gbãaↄ lɛ́ bàalɛ,","poem":1},{"lineBreak":true},{"text":"an kɛ̀sɛ kↄ̃fĩ dↄ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii Malaika mɛ̀: À Mɛlozu ká,","poem":1},{"lineBreak":true},{"text":"à lɛkɛ Mɛlozudeↄnɛ maamaa,","poem":1},{"lineBreak":true},{"text":"asa aai mↄ dↄ̀ Diilɛo,","poem":1},{"lineBreak":true},{"text":"aai dↄ Dii nɛgↄ̃naↄlɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nↄɛ báaaden Ɛbɛɛ na Yaeli ũ,","poem":1},{"lineBreak":true},{"text":"Keni bui nↄɛpi báaa vĩ zwã̀akpɛdeↄ guu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sisela í gbɛ̀awà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à vĩ kpàwà,","poem":1},{"lineBreak":true},{"text":"à vĩfãai kpàwà ta ↄde guu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"À ↄbↄ̀ zwã̀akpɛ kálo sɛ̀,","poem":1},{"lineBreak":true},{"text":"à masana kũ̀ ń a ↄplaao,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à Sisela lɛ̀ò à aà mi wì,","poem":1},{"lineBreak":true},{"text":"à aà swãgɛ̃zĩ fↄ̃̀ à aà tↄ̀lↄzↄ̃̀.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sisela gofanlɛ à lɛ̀lɛ aà gbá saɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ wúlɛa we.","poem":1},{"lineBreak":true},{"text":"À gofanlɛ à lɛ̀lɛ aà gbá saɛ,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ à gofanlɛ à lɛ̀lɛu, we à gàu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sisela da wɛkpàlɛ fɛnɛntiu,","poem":1},{"lineBreak":true},{"text":"à wiilɛ̀ fɛnɛnti mↄↄ fòou à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi aà sↄ̃́go kpɛ́ e tiai?","poem":1},{"lineBreak":true},{"text":"Àkɛa aà gbɛ̃́ↄ sↄ̃́goↄ kↄ̃fĩ dↄo ni?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aà nↄɛ zĩkɛna ↄ̃nↄnaↄ lɛ́ oɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a tɛ́ ń lɛgbɛi láasai à mɛ̀:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aalɛ pↄ́ↄ naaaɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ kpaalɛkↄ̃ɛɛ,","poem":1},{"lineBreak":true},{"text":"baade ń a wɛ̃́ndiao mɛ̀ndodo ge plapla.","poem":1},{"lineBreak":true},{"text":"Aalɛ zwã̀a wɛdeↄ naaa Siselaɛɛ,","poem":1},{"lineBreak":true},{"text":"zwã̀a wɛde wɛ̃̀sãdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"pↄlↄgãu pↄ́ wà ba kɛ̃̀wàↄɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Dii, to n ibɛɛↄ ga màa ḿpii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa yenziↄ gbãa iↄ dɛdɛ","poem":1},{"lineBreak":true},{"text":"lán ĩatɛ̃ dɛdɛawa.","poem":1},"Ɔ̃ an bùsu gↄ̃̀ dↄdↄa e wɛ̃̀ bla."]}],"footnotes":[{"noteId":12,"caller":"+","text":"5.5 Bↄa 19.18","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}