{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":10,"content":[{"type":"heading","content":["Lua lɛɛũa ń tã́aↄ"]},{"type":"verse","number":1,"content":[{"text":"Isailiↄ, à yã́ pↄ́ Dii lɛ́ oɛ́ ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À mɛ̀ ásu buipãleↄ ↄlɛsɛ","poem":1},{"lineBreak":true},{"text":"à bílikɛ seela pↄ́ ì bↄ musuwao.","poem":1},{"lineBreak":true},{"text":"Ásu to vĩa lí á kṹ láńwao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa buipãleↄ fɛlɛkaayãá yãpãɛ.","poem":1},{"lineBreak":true},{"text":"Aaì lizↄ̃ sɛ̃u,","poem":1},{"lineBreak":true},{"text":"ↄ̃ sia ì ã́nɛ́ ń kpásagↄ̃nao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wì zãblewà ń ã́nusuo ń vuao,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wì kusa pápawà ń masanao,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu àↄ zĩazĩao yã́i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tã́apiↄ lí yã'oo,","poem":1},{"lineBreak":true},{"text":"aa dɛ lán bua bãyabↄↄwaɛ.","poem":1},{"lineBreak":true},{"text":"Aali táa'oo, wì ń sɛɛ.","poem":1},{"lineBreak":true},{"text":"Ásu vĩakɛnɛ́o,","poem":1},{"lineBreak":true},{"text":"aali fↄ̃ vãie kɛ̀nɛ́o,","poem":1},{"lineBreak":true},{"text":"mɛ́ aali fↄ̃ yãmaae kɛ̀nɛ́ sↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii, gbɛ̃e muaannↄo, ń zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"n tↄbↄ̀ n gbãa yã́ musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bui píi Kía, démɛ n vĩa vĩo ni?","poem":1},{"noteId":22},{"lineBreak":true},{"text":"Ao, a maannↄ màaɛ.","poem":1},{"lineBreak":true},{"text":"Bui píi ↄ̃nↄnaↄ ń ń kpaladeↄ guu","poem":1},{"lineBreak":true},{"text":"gbɛ̃e muaannↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa doũ ḿpiiɛ,","poem":1},{"lineBreak":true},{"text":"sↄũↄnɛ, aa mi vĩo,","poem":1},{"lineBreak":true},{"text":"lí'ãaↄnɛ, aa fↄ̃ lɛdamáe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wì ã́nusu gbɛ̃gbɛ̃a pↄ́ wà bↄ̀ò Taasisi","poem":1},{"lineBreak":true},{"text":"ń vua pↄ́ wà bↄ̀ò Ufaza kúlɛwà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wì ula búuna ń a gàaluladeo káka","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ sia ń vuazĩkɛnao kɛ̀piɛ.","poem":1},{"lineBreak":true},{"text":"Gↄ̃ideↄ ↄzĩↄnɛ píi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii mɛ́ Lua sĩande ũ,","poem":1},{"lineBreak":true},{"text":"aàpi mɛ́ ìↄ ku gↄↄpii Kía ũ.","poem":1},{"lineBreak":true},{"text":"Tó aà pↄ fɛ̃̀, tↄↄlɛ ì lualuaɛ,","poem":1},{"lineBreak":true},{"text":"buie a fↄ̃ zɛ aa aà pↄkũma dão.","poem":1}]},{"type":"verse","number":11,"content":["À o buipiↄnɛ à mɛ dii pↄ́ aamɛ aa musu ń zĩ́lɛo kɛ̀opiↄ aa midɛ dṹniauɛ, aaↄ ku gueio."]},{"type":"verse","number":12,"content":[{"text":"Dii mɛ́ dṹnia kɛ̀ ń a gbãao,","poem":1},{"lineBreak":true},{"text":"à tↄↄlɛ kàlɛ ń a ↄ̃nↄo,","poem":1},{"lineBreak":true},{"text":"à musu kpàlɛ ń a wɛzɛ̃o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó Dii pũ̀na,","poem":1},{"lineBreak":true},{"text":"í pↄ́ kú musu ì kↄ̃fĩkɛɛ,","poem":1},{"lineBreak":true},{"text":"lou ì sisi za dṹnia lɛ́wa.","poem":1},{"lineBreak":true},{"text":"Dii ì bↄ ń ĩ́anao a làasiu,","poem":1},{"lineBreak":true},{"text":"lou i ma ń pílɛao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ sↄũ, aa yãe dↄ̃o,","poem":1},{"lineBreak":true},{"text":"siaↄ gɛɛ a gↄ̃ kpá ń wɛ́i","poem":1},{"lineBreak":true},{"text":"tã́a pↄ́ aa pìↄ yã́ musu.","poem":1},{"lineBreak":true},{"text":"Pↄ́ ɛgɛnaↄnɛ, aa wɛ̃ni vĩo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pↄ́ gianaↄnɛ, láanipↄↄnɛ.","poem":1},{"lineBreak":true},{"text":"Yã́kpalɛkɛgↄↄzĩ aa midɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii pↄ́ dɛ Yakↄbu buiↄ baa ũ muaańnↄo,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃mɛ pↄ́pii kɛ̀","poem":1},{"lineBreak":true},{"text":"ń Isaili pↄ́ à ń sɛ́ a pↄ́ ũↄ.","poem":1},{"lineBreak":true},{"text":"Aà tↄ́n Dii Zĩgↄ̃de.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Á gbɛ̃́ pↄ́ wà koezↄ̃̀áziↄ,","poem":1},{"lineBreak":true},{"text":"à á pↄ́ↄ ye bↄò á bùsuu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asa ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"tia kɛ́wa má bùsuɛ bee gbɛ̃́ↄ zuzu lán gbɛwaɛ.","poem":1},{"lineBreak":true},{"text":"Má ń ásookɛɛ, wi ń kṹkũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waiyoo wápiↄ, kɛ́ wá wíwia yã́i.","poem":1},{"lineBreak":true},{"text":"Wá bↄá bↄ̀kↄↄɛ.","poem":1},{"lineBreak":true},{"text":"Wálɛ e yãa wá gyãpi bleɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wà wá zwã̀akpɛↄ kwɛ̀kwɛ,","poem":1},{"lineBreak":true},{"text":"wà a baↄ kɛ̃̀kɛ̃.","poem":1},{"lineBreak":true},{"text":"Wá nɛ́ↄ gɛ̃̀zɛa, aa ku lↄo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e ku à zwã̀akpɛ dↄwɛ̃ɛ lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à a zwãaↄ kpálɛo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wá dↄaanaↄá sↄũↄnɛ,","poem":1},{"lineBreak":true},{"text":"aali yãgbɛa Diiwao.","poem":1},{"lineBreak":true},{"text":"A yã́i tò an yãe lí bↄ maao,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an gbɛ̃́ↄ fã̀aa píi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À ma, wàlɛ mↄ́ baokpai,","poem":1},{"lineBreak":true},{"text":"kↄ̃fĩ zↄ̃ↄ dↄ gugbãntoo oi bùsuu.","poem":1},{"lineBreak":true},{"text":"Wàlɛ mↄ́ Yuda wɛ̃́lɛↄ dɛ̃ↄnzↄ̃i,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛpiↄ i gↄ̃ gbɛ̃gbonaↄ tòo ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dii, má dↄ̃ kɛ́ gbɛ̃nazĩna kua dɛ aàzĩa yã́ ũo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a fↄ̃ zɛpoo azĩaɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dii, ma toto a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"i kɛ ń pↄkũmao no.","poem":1},{"lineBreak":true},{"text":"Ńsu ma lao mà gↄ̃ tɛ̃nɛɛo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Pↄfɛ̃ bↄbↄ bui pↄ́ aa n dↄ̃oↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aali n sísiopiↄ,","poem":1},{"lineBreak":true},{"text":"asa aa Yakↄbu buiↄ mↄ̀mↄɛ,","poem":1},{"lineBreak":true},{"text":"aa ń mↄmↄ bɛ̃̀ɛ,","poem":1},{"lineBreak":true},{"text":"aa ń bùsu ↄ̃̀ↄkpà.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"10.7 Zia 15.4","reference":{"chapter":10,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}