{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":13,"content":[{"type":"heading","content":["Sàana yã́"]},{"type":"verse","number":1,"content":["Dii òmɛɛ mà gɛ sàana lu mà ye, ãma másuli pío."]},{"type":"verse","number":2,"content":["Ɔ̃ ma sàana lù lá a òwa má yè."]},{"type":"verse","number":3,"content":["Dii yã'oamɛɛ gɛ̃n plaade à mɛ̀"]},{"type":"verse","number":4,"content":["mà sàana pↄ́ má lù má yèpi sɛ gɛò Uflatai, mí ulɛ gbɛ̀sↄↄu we."]},{"type":"verse","number":5,"content":["Ɔ̃ ma gɛ má ùlɛ Uflatai lá a òmɛɛwa."]},{"type":"verse","number":6,"content":["Gↄↄpla gbɛa Dii ɛ̀a yã'òmɛɛ à mɛ̀ mà fɛlɛ gɛ́ Uflatai, mí sàana pↄ́ a òmɛɛ mà ulɛ we sɛ suò."]},{"type":"verse","number":7,"content":["Ɔ̃ ma ɛa gɛ Uflatai, ma sàanapi bↄ̀ gu pↄ́ má ùlɛu, ↄ̃ má è a ↄ̃̀ↄkpà, a keekɛa kɛ lↄo."]},{"type":"verse","number":8,"content":["Ɔ̃ Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":9,"content":["Ma Dii ma mɛ̀, beewa má kɛ Yudaↄ ĩ́andãa ń Yelusalɛũdeↄ ĩ́andãa zↄ̃ↄoɛ."]},{"type":"verse","number":10,"content":["Gbɛ̃vãipiↄ gì ma yãmaiɛ, swã́gbãa kɛ̀má zↄ̃ↄ, ↄ̃ aa tɛ̀ dii pãleↄzi aa zↄblènɛ́ aa kùlɛnɛ́. Aaↄ dɛ lán sàanapiwaɛ, a keekɛa kɛ lↄo."]},{"type":"verse","number":11,"content":["Lá wì sàana nańzi, màa ma Isailiↄ ń Yudaↄ nàmazi, kɛ́ aaↄ dɛ ma gbɛ̃́ↄ ũ, aaↄ ma tↄbↄ, aaↄ ma táasilɛ, aaiↄ ma kpɛla, ↄ̃ aa gì ma yãmai."]},{"type":"heading","content":["Vɛ̃ɛ tùu yã́"]},{"type":"verse","number":12,"content":["Onɛ́ ma Dii ma mɛ̀, wa vɛ̃ɛ ka tùuↄ guu à pa píi. Tó aa ònɛ wa dↄ̃ kɛ́ vɛ̃ɛ a tùu pa,"]},{"type":"verse","number":13,"content":["ní onɛ́ ma Dii ma mɛ̀, má vɛ̃ɛ káka bùsupideↄnɛ e à zↄ̃ ń lↄↄwa ḿpiiɛ, sɛa za kía pↄ́ zↄ̃lɛa Davidi kpalauↄwa ń sa'onaↄ ń ãnabiↄ ń Yelusalɛũdeↄ píi,"]},{"type":"verse","number":14,"content":["mí ń pãpãkↄ̃wa aa wíwi, maeↄ ń ń nɛ́ↄ píi. Ma Dii mámɛ má ò. Má ń dɛdɛɛ, má ń bↄo, má sùuukɛńnↄo, má ń wɛ̃nagwao."]},{"type":"heading","content":["Gbɛaana a fↄ̃ à a wɛ̃̀sã lilɛe?"]},{"type":"verse","number":15,"content":[{"text":"À swã́kpa yãma!","poem":1},{"lineBreak":true},{"text":"Ásu ázĩa sɛ lɛsĩo,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ lɛ́ yã'o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À bɛɛɛ dↄ̃ Dii á Luaɛ","poem":1},{"lineBreak":true},{"text":"e àↄ gɛ́ gusia kúlɛiwá,","poem":1},{"lineBreak":true},{"text":"à gɛ̃mbↄlɛ guluuluui gusĩsĩdeu.","poem":1},{"lineBreak":true},{"text":"Á wɛ́ dↄ gupuai,","poem":1},{"lineBreak":true},{"text":"kási gusia zↄ̃ↄ ↄ̃ a kũaawá,","poem":1},{"lineBreak":true},{"text":"i gusia pãsĩ kúála.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tó i yã́pi mao,","poem":1},{"lineBreak":true},{"text":"á wala a to mà gɛ wiipɛ gusaɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́'i i kwɛ maamaa","poem":1},{"lineBreak":true},{"text":"kɛ́ wa Dii kpàsa gbɛ̃́ↄ kṹkũ yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O kíaɛ ń a dao aa zↄ̃lɛ zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ an kíafua gawideↄ gògo yã́i.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɛgɛvɛ bùsu wɛ̃́lɛ gbaↄ aaↄ tataaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we à wɛ̃o.","poem":1},{"lineBreak":true},{"text":"Wa Yudaↄ naaa táńnↄ zↄↄ ũ píiɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yelusalɛũ, wɛzu ǹ gwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ bↄ̀lɛ gugbãntoo oi, aalɛ mↄ́.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ Lua nànɛ n ↄzĩↄ ku máɛ?","poem":1},{"lineBreak":true},{"text":"N kpàsa gbɛ̃́ gawidepiↄ!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bui pↄ́ n gbɛ̃nakpàńnↄↄ,","poem":1},{"lineBreak":true},{"text":"tó Dii tò aa fɛ̀lɛnnↄ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ mɛa ni?","poem":1},{"lineBreak":true},{"text":"Wãwã a ń le lán nɛ'inawaɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tó n mɛ̀ àkɛa yã́ɛ taa n lei?","poem":1},{"lineBreak":true},{"text":"N tàaeↄ yã́i ↄ̃ wà n zwãa pìliima","poem":1},{"lineBreak":true},{"text":"wà gbãamↄ̀nɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Etiopi gbɛ̃́ a fↄ̃ à a mɛbaa lilɛe?","poem":1},{"lineBreak":true},{"text":"Gbɛaana a fↄ̃ à a wɛ̃̀sã lilɛe?","poem":1},{"lineBreak":true},{"text":"Á Yelusalɛũdeↄ sↄ̃,","poem":1},{"lineBreak":true},{"text":"vãi dↄ́ɛkɛ̀ánↄ, á fↄ̃ maakɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Má á fãaa","poem":1},{"lineBreak":true},{"text":"lán sɛ̃ pↄ́ ĩ́ana sɛ̀lɛ gbáauwaɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Á zian we,","poem":1},{"lineBreak":true},{"text":"baa pↄ́ má dìlɛɛ́n we.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò,","poem":1},{"lineBreak":true},{"text":"asa ma yã́ sã̀águɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a ɛɛ náaikɛ̀.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tↄ̀ↄ, má n zwãa lɛ́ kánɛ n miaɛ,","poem":1},{"lineBreak":true},{"text":"wi n puizi e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ma yãbɛ̃ɛ pↄ́ á kɛ̀ sĩ̀sĩↄ musu è,","poem":1},{"lineBreak":true},{"text":"n gbãsĩkɛa ń n wiilɛa gↄ̃ↄzio","poem":1},{"lineBreak":true},{"text":"ń n káaluakaa tã́aↄ yã́ musuo.","poem":1},{"lineBreak":true},{"text":"Waiyoo Yelusalɛũ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ gbãlɛa e bↄɛ ni?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}