pàapaa, lou i ma gueio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Baa tue da ì a nɛ́ tó weɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ sɛ̃ kuo yã́i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a zàa'ĩnaↄ zɛ sĩ̀sĩ wáiwaiↄ musu,","poem":1},{"lineBreak":true},{"text":"aalɛ we hɛ̀hɛhɛhɛ lán gbɛ̃gbonaↄwa,","poem":1},{"lineBreak":true},{"text":"an wɛ́ tà loũloũ sɛ̃sai yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baa kɛ́ wá tàaeↄ wá dá yã́u,","poem":1},{"lineBreak":true},{"text":"dↄwálɛ n tↄ́ yã́i.","poem":1},{"lineBreak":true},{"text":"Wá pↄ̀ↄbↄzãkɛa kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"wa duunakɛ̀nɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ Isailiↄ wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"an wɛtãgↄↄ Suabana,","poem":1},{"lineBreak":true},{"text":"àkɛa n gↄ̃wɛ̃ɛ lán nibↄ ge gɛ̃zɛa","poem":1},{"lineBreak":true},{"text":"pↄ́ mↄ̀ ì wá bùsuu gↄↄ dowai?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ń dɛ lán gbɛ̃́ pↄ́ yã́ dìwà","poem":1},{"lineBreak":true},{"text":"ge nɛgↄ̃na pↄ́ a fↄ̃ ń suabaowai?","poem":1},{"lineBreak":true},{"text":"Dii, ń kú wá guu,","poem":1},{"lineBreak":true},{"text":"wìↄ wá sisi n tↄ́wa,","poem":1},{"lineBreak":true},{"text":"ńsu pãkpawázio.","poem":1}]},{"type":"verse","number":10,"content":["Yã́ pↄ́ Dii ò gbɛ̃́piↄ yã́ musun kɛ:",{"text":"Aa ye liaaliaai maamaaɛ,","poem":1},{"lineBreak":true},{"text":"aali zↄ̃lɛ ń zíwao,","poem":1},{"lineBreak":true},{"text":"an yã́ lí ká Diiguo.","poem":1},{"lineBreak":true},{"text":"An tàaeↄ a dↄaàgu sa,","poem":1},{"lineBreak":true},{"text":"i ĩadamá an duuna yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Ɔ̃ Dii òmɛɛ: Ńsu gbɛ̃́piↄ aafia wabikɛao."]},{"type":"verse","number":12,"content":["Baa tó aa lɛyè, má ń wabikɛa sio. Baa tó aa sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ òa ń pↄ́wɛntio, má síńnↄo. Má ń midɛ ń zĩo ń nↄanao ń gagyãoɛ."]},{"type":"verse","number":13,"content":["Ɔ̃ ma mɛ̀: Á'a Dii Lua! Ãnabiↄ mɛ́ i onɛ́ aa wɛsi zĩlɛo, nↄana a ń dɛo. Aaì mɛ ńyↄ̃ ń gba aafia gↄↄpii guɛ beeuɛ."]},{"type":"verse","number":14,"content":["Ɔ̃ Dii òmɛɛ: Ãnabipiↄ lɛ́ ãnabikɛkɛ ń ɛɛo ń ma tↄ́oɛ. Mi ń zĩo, mi yãdilɛnɛ́o, mɛ́ mi yãe onɛ́o. Ãnabikɛ pↄ́ aalɛ kɛɛ́á wɛ́pungu ɛgɛna ń màso bɛɛɛsaio ń làasoo kpaanlao yã́ɛ."]},{"type":"verse","number":15,"content":["A yã́i tò yã́ pↄ́ ma Dii má ò ãnabi pↄ́ mi ń zĩo, mɛ́ aalɛ ãnabikɛkɛ ń ma tↄ́opiↄ musun kɛ: Aalɛ mɛ zĩ ge nↄana a gɛ̃ ń bùsuuo, kási sↄ̃ zĩ ń nↄanao mɛ́ a ń dɛdɛ,"]},{"type":"verse","number":16,"content":["wi gbɛ̃́ pↄ́ aalɛ ãnabikɛkɛnɛ́ↄ zuzu Yelusalɛũ gãaɛↄ nↄana ń zĩpio yã́i. Gbɛ̃e aↄ ku à ń vĩo ge ń nↄɛↄ ge ń nɛ́ↄ. Má ń vãikɛapi wínɛ́ ń musuɛ."]},{"type":"verse","number":17,"content":["Yã́ɛ bee onɛ́:",{"text":"To mà wɛ́'ikau,","poem":1},{"lineBreak":true},{"text":"má kã́mabo gwãasĩna ge fãanɛo.","poem":1},{"lineBreak":true},{"text":"Asa ma gbɛ̃́ↄ wíwia maamaaɛ,","poem":1},{"lineBreak":true},{"text":"wà ń kɛ́ ĩa à kɛ̀ zài.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó ma gɛ sɛ̃saou,","poem":1},{"lineBreak":true},{"text":"mi gbɛ̃́ pↄ́ wà ń dɛdɛↄ gɛ e kálɛa.","poem":1},{"lineBreak":true},{"text":"Tó ma gɛ̃ wɛ̃́lɛ guu,","poem":1},{"lineBreak":true},{"text":"mi gbɛ̃́ pↄ́ lɛ́ gyãkɛkɛ nↄana yã́iↄ e.","poem":1},{"lineBreak":true},{"text":"Ãnabiↄ ń sa'onaↄ ìↄ liaaliaa ḿpii,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e a bùsu dↄ̃ lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"N gi Yudaↄzi fĩ́afĩa yã̀?","poem":1},{"lineBreak":true},{"text":"N pↄ bↄ̀ Siↄnagu yã̀?","poem":1},{"lineBreak":true},{"text":"Àkɛa n wá wɛtã̀,","poem":1},{"lineBreak":true},{"text":"gbã́gbãa kuo ni?","poem":1},{"lineBreak":true},{"text":"Wá wɛ́ dↄ aafiai,","poem":1},{"lineBreak":true},{"text":"kási yãmaae kuo.","poem":1},{"lineBreak":true},{"text":"Wá wɛ́ dↄ gbã́gbãai,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gili guu wá kúu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii, wa wá vãikɛa dↄ̃̀","poem":1},{"lineBreak":true},{"text":"ń tàae pↄ́ wá deziↄ kɛ̀o.","poem":1},{"lineBreak":true},{"text":"Wa duunakɛ̀nɛɛ fá!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ńsu sakáwáguo n tↄ́ yã́i,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ n kpalabaa gawide bↄlↄboo.","poem":1},{"lineBreak":true},{"text":"N bàakuawanↄ yã́ su sãnguo,","poem":1},{"lineBreak":true},{"text":"ńsu gbooo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Buipãleↄ tã́aↄ ì to lou mae?","poem":1},{"lineBreak":true},{"text":"Luabɛ ì to lou ma ń azĩaoa?","poem":1},{"lineBreak":true},{"text":"Aawo Dii wá Lua, ḿmɛ ni tó,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wá wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ni yã́piↄ kɛ píi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}