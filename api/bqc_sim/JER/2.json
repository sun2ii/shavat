{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":2,"content":[{"type":"heading","content":["Isailiↄ bↄa Dii kpɛ"]},{"type":"verse","number":1,"content":["Dii yã'òmɛɛ à mɛ̀:"]},{"type":"verse","number":2,"content":["Gɛ ǹ yã́ɛ bee kpàwakɛ Yelusalɛũdeↄ swã́u.",{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"á wɛ̃ndiagↄↄ gbɛ̃kɛ pↄ́ á vĩmanↄ dↄmagu","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ á yemazi ma nↄ dafu ũ.","poem":1},{"lineBreak":true},{"text":"Gↄↄ bee á tɛmazi guwaiwaiu,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ wi pↄ́tↄ̃uo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa ku ma mɛ̀ndo yã́iɛ,","poem":1},{"lineBreak":true},{"text":"aamɛ ma buapↄ́ káauↄ ũ.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ ń mↄmↄↄ tàae è,","poem":1},{"lineBreak":true},{"text":"ↄ̃ músi ń lé.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À swã́sɛ ma yã́i, á Isailiↄ,","poem":1},{"lineBreak":true},{"text":"á Yakↄbu buiↄ píi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"tàae kpele á deziↄ èa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa zã̀kũmanↄi?","poem":1},{"lineBreak":true},{"text":"Aa tɛ̀ tã́aↄzi, ↄ̃ aa gì ↄi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ń bↄ́lɛ Egipi ma dↄaanɛ́ guwaiwaiu","poem":1},{"lineBreak":true},{"text":"ń sɛ̃gbão ń bùsu tↄ̃ↄ'ɛdeo","poem":1},{"lineBreak":true},{"text":"ń bùsu iminadeo ń gusisi pãsĩo,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ gbɛ̃e lí a baa vĩo mɛ́ gbɛ̃e líↄ kuuo,","poem":1},{"lineBreak":true},{"text":"kási aai ma gbɛao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma suńnↄ tↄↄlɛ táaedeu la,","poem":1},{"lineBreak":true},{"text":"aaliↄ a libɛↄ ble ń a pↄmaaↄ.","poem":1},{"lineBreak":true},{"text":"Kɛ́ aa kà, aa ma bùsu gbãlɛ̀,","poem":1},{"lineBreak":true},{"text":"aa tò à gↄ̃̀ pↄ́ pↄ́ má yeio ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"An sa'onaↄ i ma dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ma ikoyãdanɛdeↄ i ma dↄ̃o,","poem":1},{"lineBreak":true},{"text":"an dↄaanaↄ bↄ̀ ma kpɛ,","poem":1},{"lineBreak":true},{"text":"an ãnabiↄ ãnabikɛkɛ̀ ń Baali gbãao,","poem":1},{"lineBreak":true},{"text":"aa tɛ̀ pↄ́ pↄ́ lí kã́fĩakɛnɛ́oↄzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A yã́i má mↄ́ ń á yã́o sↄ̃,","poem":1},{"lineBreak":true},{"text":"mɛ́ má mↄ́ ń á nɛ́ↄ ń á tↄũnaↄ yã́o.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À bua ísiawa e Sipi bùsuu à gwa.","poem":1},{"lineBreak":true},{"text":"À gbɛ̃́ zĩ Kedaa bùsuu à a yã́ tàasika,","poem":1},{"lineBreak":true},{"text":"í gwa tó yã́ɛ bee taa kɛ̀ we yãa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Buie a diiↄ lìlɛ yãae?","poem":1},{"lineBreak":true},{"text":"Kási an tã́apiↄá Lua no.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ má dɛ Lua gawide ũ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ ma lɛũkpakɛ̀","poem":1},{"lineBreak":true},{"text":"ń pↄ́ pↄ́ lí kã́fĩakɛnɛ́oↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á musudeↄ, à to yã́pi diwá,","poem":1},{"lineBreak":true},{"text":"á mɛ i seenata à gↄ̃ sã̀iii.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asa ma gbɛ̃́ↄ duunakɛ̀ lɛɛ plaɛ.","poem":1},{"lineBreak":true},{"text":"Mámɛ má nibↄna í wɛ̃nide ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa ma to we,","poem":1},{"lineBreak":true},{"text":"aa gɛ̀ wà biaↄ yↄ̃̀ ńzĩaɛ,","poem":1},{"lineBreak":true},{"text":"bia tɛfɛɛna pↄ́ aa fↄ̃ í dilɛoↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Isailiↄá zↄↄnɛe?","poem":1},{"lineBreak":true},{"text":"Wà ń í zↄble guu nɛe?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi aa gↄ̃̀ pↄvĩaↄ ũ sai?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusuↄ pàlamá aa pũ̀namá,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa ń bùsu yàa,","poem":1},{"lineBreak":true},{"text":"an wɛ̃́lɛↄ tɛkũ̀, gbɛ̃e ku we lↄo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɛfisideↄ ń Tapanɛsideↄ ń mi wànɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ámɛ a yã́pi ì ázĩaɛo lò?","poem":1},{"lineBreak":true},{"text":"Ma Dii á Lua, kɛ́ má zɛmikũaɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a ma to we.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bↄ́yãi álɛ gɛ́ Egipi Sioo í miii?","poem":1},{"lineBreak":true},{"text":"Àkɛa álɛ gɛ́ Asili Uflata í miii?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Á vãikɛa a wi á musuɛ,","poem":1},{"lineBreak":true},{"text":"á pↄ̀ↄbↄzãkɛa a wɛ́tɛ̃a iɛ́.","poem":1},{"lineBreak":true},{"text":"À làasookɛ, í dↄ̃ kɛ́","poem":1},{"lineBreak":true},{"text":"á bↄa ma Dii á Lua kpɛ vãi,","poem":1},{"lineBreak":true},{"text":"mɛ́ á kua vĩakɛamɛɛ sai ĩ́i.","poem":1},{"lineBreak":true},{"text":"Ma Dii Lua Zĩgↄ̃de mámɛ má ò.","poem":1}]},{"type":"heading","content":["Isailiↄ dɛa nↄ náaisai ũ"]},{"type":"verse","number":20,"content":[{"text":"A ma zuu gbòo á nↄɛ à gɛ̃̀gɛ̃,","poem":1},{"lineBreak":true},{"text":"a ma baↄ kɛ̃̀kɛ̃,","poem":1},{"lineBreak":true},{"text":"a mɛ̀ á zↄblemɛɛo.","poem":1},{"lineBreak":true},{"text":"Sĩana guu i gbãsĩkɛ sĩ̀sĩ lɛsĩ píi musu","poem":1},{"lineBreak":true},{"text":"ń lí yɛ̀lɛlɛↄ píi gbáuo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma á bá vɛ̃ɛli maa náaide ũɛ.","poem":1},{"lineBreak":true},{"text":"Kpelewa a kɛ̃a,","poem":1},{"lineBreak":true},{"text":"a gↄ̃ vɛ̃ɛli bↄlɛnzĩaɛ ũi?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Baa tó a zu'ò ń saoo","poem":1},{"lineBreak":true},{"text":"ń mↄsↄnao maamaa,","poem":1},{"lineBreak":true},{"text":"á tàae tèbateba a láamɛɛo.","poem":1},{"lineBreak":true},{"text":"Ma Dii Lua mámɛ má ò.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kpelewa á fↄ̃ o i gbãlɛo,","poem":1},{"lineBreak":true},{"text":"i kɛ Baaliↄnɛ kɛ̀kɛo ni?","poem":1},{"lineBreak":true},{"text":"À yã́ pↄ́ á kɛ̀ swadↄↄiↄ gwa,","poem":1},{"lineBreak":true},{"text":"à làasookɛ á yãkɛapiↄwa.","poem":1},{"lineBreak":true},{"text":"I gɛ́ le à su la,","poem":1},{"lineBreak":true},{"text":"lán yiongo núnu pↄ́ a mɛ fɛ̀lɛwa,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"lán sɛ̃̀a zàa'ĩn da pↄ́ dↄ́ɛkɛ̀ ń gbáao,","poem":1},{"lineBreak":true},{"text":"àlɛ gↄ̃ ĩ́ana sɛsɛwa.","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ à aà lɛ́ liaa gↄↄ pↄ́ aà mɛ fɛ̀lɛi?","poem":1},{"lineBreak":true},{"text":"Zàa'ĩn sa pↄ́ lɛ́ aà wɛɛlɛↄ kpasao,","poem":1},{"lineBreak":true},{"text":"aa aà e a gↄↄwaɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ásu àↄ kpálɛkɛńzi","poem":1},{"lineBreak":true},{"text":"e á kyale gɛ́ yaa á gbáu,","poem":1},{"lineBreak":true},{"text":"á kòlo giigagao.","poem":1},{"lineBreak":true},{"text":"Ń beeo a mɛ̀ a zɛkɛo,","poem":1},{"lineBreak":true},{"text":"wá ye dii zĩ̀loↄziɛ,","poem":1},{"lineBreak":true},{"text":"sema wà gɛ́má.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lá wí ì kpã́i kṹ, tó wà bↄ̀wà,","poem":1},{"lineBreak":true},{"text":"màa wa wida Isailiↄwa,","poem":1},{"lineBreak":true},{"text":"an kíaↄ ń ń gbãadeↄ","poem":1},{"lineBreak":true},{"text":"ń ń sa'onaↄ ń ń ãnabiↄ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aaì o líɛ: Wá maen n ũ,","poem":1},{"lineBreak":true},{"text":"aaì o gbɛɛ: Ḿmɛ n wá í.","poem":1},{"lineBreak":true},{"text":"Aa bↄ̀ ma kpɛ, aai zɛmanↄo.","poem":1},{"lineBreak":true},{"text":"Gↄↄ pↄ́ taasi ń lé,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì mɛ mà fɛlɛ mà ń suaba.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Dii pↄ́ á kɛ̀ ázĩaɛↄ ku máɛ?","poem":1},{"lineBreak":true},{"text":"Aa fɛlɛ á taasikɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"tó aa fↄ̃ á suaba!","poem":1},{"lineBreak":true},{"text":"Asa á Yudaↄ,","poem":1},{"lineBreak":true},{"text":"á diiↄ dasi kà á wɛ̃́lɛↄwa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bↄ́yãi álɛ zↄakaimazii?","poem":1},{"lineBreak":true},{"text":"Ápii a bↄ ma kpɛɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma ĩadà á deziↄwa pãɛ,","poem":1},{"lineBreak":true},{"text":"aai totoapi yãdao.","poem":1},{"lineBreak":true},{"text":"Aa lɛ̀lɛ ń ãnabiↄwa","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄmusu pↄkaalɛnawa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Á gbãgbɛ̃ↄ, à wɛ́tɛ ma yã́i.","poem":1},{"lineBreak":true},{"text":"Ma gↄ̃ Isailiↄnɛ gbáa","poem":1},{"lineBreak":true},{"text":"ge gubeebee ũ yã̀?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ma gbɛ̃́piↄ ì mɛ","poem":1},{"lineBreak":true},{"text":"waↄ ń bɛbɛa kɛɛ,","poem":1},{"lineBreak":true},{"text":"wa mↄ ma kĩ́i lↄo ni?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nↄamblebↄ yã́ a fↄ̃ sã wɛ̃́ndiague?","poem":1},{"lineBreak":true},{"text":"Zãkɛzĩ pↄ́ↄ yã́ a fↄ̃ sã nↄ dafugue?","poem":1},{"lineBreak":true},{"text":"Kási ma yã́ sã̀ ma gbɛ̃́ↄgu","poem":1},{"lineBreak":true},{"text":"à gↄↄplakɛ̀.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Á yenzi ɛsɛ vĩɛ fá!","poem":1},{"lineBreak":true},{"text":"Baa káalua sà zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"á á yãkɛa dadaɛ̀.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Wì taaside yãesaide au e á pↄkasaↄwa,","poem":1},{"lineBreak":true},{"text":"i kɛ a ń lé á kpɛ́u,","poem":1},{"lineBreak":true},{"text":"aalɛ á pↄ́ↄ sɛ́lɛn sↄ̃o.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Gia ń beeo i mɛ á yãe vĩo,","poem":1},{"lineBreak":true},{"text":"ma pↄ a paázio.","poem":1},{"lineBreak":true},{"text":"Lá a mɛ̀ i duunakɛo,","poem":1},{"lineBreak":true},{"text":"má yã́kpalɛkɛánↄɛ.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Bↄ́yãi iↄ liaaliaa à á yãkɛa lilɛi?","poem":1},{"lineBreak":true},{"text":"Egipiↄ widawá,","poem":1},{"lineBreak":true},{"text":"lá Asiliↄ kɛ̀ɛ́wa.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Á bↄ we à su ń ↄo dia á musuɛ,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃́ pↄ́ álɛ ń náaikɛpiↄ,","poem":1},{"lineBreak":true},{"text":"ma gińziɛ, á dↄnlɛ emáo.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}