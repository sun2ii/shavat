{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":30,"content":[{"type":"heading","content":["Isailiↄ sua ń pá ziu"]},{"type":"verse","number":1,"content":["Dii yã'ò Zelemiiɛ à mɛ̀:"]},{"type":"verse","number":2,"content":["Ma Dii Isailiↄ Lua ma mɛ̀, yã́ pↄ́ má ònɛ píi kɛ̃́ lá guu."]},{"type":"verse","number":3,"content":["Ma Dii ma mɛ̀, gwa, gↄↄe a mↄ́ kɛ́ má a gbɛ̃́ Isailiↄ ń Yudaↄ bↄ zĩ̀zↄkɛu, mí suńnↄ bùsu pↄ́ má kpà ń deziↄwa aa gↄ̃ vĩ guu. Ma Dii mámɛ má ò."]},{"type":"verse","number":4,"content":["Yã́ pↄ́ Dii ò Isailiↄ ń Yudaↄ musun kɛ, à mɛ̀:"]},{"type":"verse","number":5,"content":[{"text":"Ma Dii ma mɛ̀, à vĩa wii ma dↄ!","poem":1},{"lineBreak":true},{"text":"Sↄ̃kɛ̃ngu wiiɛ, aafia wii no.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À gbɛ̃e la à ma,","poem":1},{"lineBreak":true},{"text":"gↄ̃ɛ mɛ́ ì kúlɛ nɛ'ia?","poem":1},{"lineBreak":true},{"text":"Àkɛa ma nɛgↄ̃naↄ è,","poem":1},{"lineBreak":true},{"text":"an oa fɛ̃́nkpaa píi,","poem":1},{"lineBreak":true},{"text":"aalɛ ↄ fĩfĩ ń gbɛɛwa","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ'iwai?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waiyoo, asa gↄↄpi taasi vĩ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"gↄↄe aↄ muaaòo.","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ taasigↄↄɛ,","poem":1},{"lineBreak":true},{"text":"ãma aa bↄu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"gↄↄ bee má zuu ɛ́'ɛnɛ́ ń nↄɛ,","poem":1},{"lineBreak":true},{"text":"mí ń mↄdaonaↄ kɛ̃́kɛ̃nɛ́.","poem":1},{"lineBreak":true},{"text":"Aa zↄble bui zĩ̀loↄnɛ lↄo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ma Dii ń Lua, mámɛ aa zↄblemɛɛ,","poem":1},{"lineBreak":true},{"text":"ń ń kí Davidi bui pↄ́ má dilɛnɛ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Á Yakↄbu bui ma zↄ̀blenaↄ,","poem":1},{"lineBreak":true},{"text":"ásu to vĩa á kũo,","poem":1},{"lineBreak":true},{"text":"á Isailiↄ, ásu bílikɛo.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Asa mapi má á bↄlɛ za guzãzãuɛ,","poem":1},{"lineBreak":true},{"text":"mí á buiↄ bↄlɛ ń zↄblebusuu.","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ ɛa aaↄ ku dↄdↄa nana,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a to vĩa ń kṹ lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má kúánↄ á suabaa yã́iɛ.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ málɛ á fãaa ń guuↄ,","poem":1},{"lineBreak":true},{"text":"baa tó ma ń mìdɛ píi,","poem":1},{"lineBreak":true},{"text":"má á midɛ míↄmiↄo.","poem":1},{"lineBreak":true},{"text":"Má á toto a zɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"má we à bↄ swã́gagasaio.","poem":1},{"noteId":57}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asa ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"á bↄá bↄ̀kↄↄɛ,","poem":1},{"lineBreak":true},{"text":"á kɛa'ĩa uusikɛ̀.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃e ku à kulɛkɛmɛɛ á yã́ musuo,","poem":1},{"lineBreak":true},{"text":"á bↄ a ɛsɛ mao, a láaa vĩo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Á yã́ sã̀ á yenzideↄgu,","poem":1},{"lineBreak":true},{"text":"aa yeázi lↄo,","poem":1},{"lineBreak":true},{"text":"asa ma á lɛ́ lán á ibɛɛwaɛ,","poem":1},{"lineBreak":true},{"text":"ma á toto lán gbɛ̃́ pãsĩwaɛ,","poem":1},{"lineBreak":true},{"text":"asa á tàaeↄ zↄ̃ↄɛ,","poem":1},{"lineBreak":true},{"text":"á duuna tìisi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ásu wiilɛ á bↄ̀kↄↄ wãwã yã́ musuo.","poem":1},{"lineBreak":true},{"text":"Á tàae zↄ̃ↄ ń á duuna tìisio yã́i","poem":1},{"lineBreak":true},{"text":"ma yã́ beeↄ kɛ̀iɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wa á tàitainaↄ taitai píiɛ,","poem":1},{"lineBreak":true},{"text":"wi tá ń á ibɛɛↄ zĩ̀zↄↄ ũ píi.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa á pↄ́ↄ nàaaↄ gↄ̃ pↄ́ naaaaↄ ũ sↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa á pↄ́ↄ sɛ̀lɛↄ gↄ̃ pↄ́ sɛ́lɛaↄ ũɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má ɛa á gba aafia,","poem":1},{"lineBreak":true},{"text":"má tó á bↄ láa,","poem":1},{"lineBreak":true},{"text":"kɛ́ wìↄ oɛ́ pↄ́ vũaaaↄ,","poem":1},{"lineBreak":true},{"text":"Siↄnade pↄ́ gbɛ̃e yeńzioↄ yã́i.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Má su ń Yakↄbu buiↄ ń pá ziu,","poem":1},{"lineBreak":true},{"text":"má ń wɛ̃nagwa aa su ń gbɛu.","poem":1},{"lineBreak":true},{"text":"Aa ń mɛɛwia zia vu,","poem":1},{"lineBreak":true},{"text":"aai ɛa kibɛ kpá lá a ziwa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wa sáaukpaa mamá ń pↄna súuo.","poem":1},{"lineBreak":true},{"text":"Má tó aa dasikũɛ, aa lao lↄo,","poem":1},{"lineBreak":true},{"text":"má ń kpɛlaɛ, wa ń kpɛbↄ lↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aaↄ dɛ lán káauwa,","poem":1},{"lineBreak":true},{"text":"aaↄ zɛdↄamɛɛ ḿpiiɛ,","poem":1},{"lineBreak":true},{"text":"mí ĩada gbɛ̃́ pↄ́ gbãamↄ̀nɛ́ↄwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"An gbɛ̃e mɛ́ aↄ dɛ ń dↄaana ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ nɛblè ń guu mɛ́ aↄ dɛ ń kía ũ.","poem":1},{"lineBreak":true},{"text":"Má tó aà sↄ̃mazi aàↄ kumanↄ kãi.","poem":1},{"lineBreak":true},{"text":"Tó màa no, démɛ a fↄ̃ gi a wɛ̃nii à sↄ̃mazii?","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa gↄ̃ ma gbɛ̃́ↄ ũ,","poem":1},{"lineBreak":true},{"text":"mí gↄ̃ ń Lua ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma pↄfɛ̃ a fɛlɛ lán zàa'ĩanawaɛ,","poem":1},{"lineBreak":true},{"text":"i su vãikɛnaↄ miwa lán zàalolowa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ma pↄkũma pãsĩ a weeo,","poem":1},{"lineBreak":true},{"text":"sema ma yã́ pↄ́ ma zɛò ma sↄ̃u kɛ̀.","poem":1},{"lineBreak":true},{"text":"Gↄↄgbɛzãzĩ á yã́pi gbadↄ̃.","poem":1}]}],"footnotes":[{"noteId":57,"caller":"+","text":"30.11 Zel 46.27-28","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}