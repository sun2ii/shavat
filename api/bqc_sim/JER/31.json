{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"gↄↄ bee máↄ dɛ Isailiↄ Lua ũ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dɛ ma gbɛ̃́ↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má maakɛ gbɛ̃́ pↄ́ bↄ̀ fɛ̃nda lɛ́zĩↄnɛ gbáau,","poem":1},{"lineBreak":true},{"text":"má gɛ́ Isailipiↄ gbai ĩ́ampakĩi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii bↄ̀ mↄ̀wá za kãaa à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ma yeaázi láaa vĩo,","poem":1},{"lineBreak":true},{"text":"a yã́i ma á gálɛ ń gbɛ̃kɛo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Má ɛa á zɛdↄ, íↄ zɛdↄa.","poem":1},{"lineBreak":true},{"text":"Á Isaili nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"á ɛa á sɛ̃́sɛ̃naↄ sɛ lↄ,","poem":1},{"lineBreak":true},{"text":"í bↄlɛ gɛ̃ò pↄnakɛnaↄ ↄ̃wãu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Á ɛa vɛ̃ɛliↄ ba Samali sĩ̀sĩↄ pↄlɛu,","poem":1},{"lineBreak":true},{"text":"mɛ́ a banaↄ mɛ́ aa a bɛ mↄaokɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gↄↄe a mↄ́ kɛ́ gudↄ̃anaↄ lɛ́ gbãa zu Ɛflaiũ gbɛ̀sĩsĩ musu aa mɛ:","poem":1},{"lineBreak":true},{"text":"À fɛlɛ wà gɛ́ Siↄna Dii wá Lua kĩ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"à lɛsi Yakↄbu buiↄnɛ ń pↄnao,","poem":1},{"lineBreak":true},{"text":"à gulakɛ buiↄ mide yã́ musu.","poem":1},{"lineBreak":true},{"text":"À to wà ma táasilɛa ma dↄ, í mɛ:","poem":1},{"lineBreak":true},{"text":"Dii, ǹ n gbɛ̃́ Isaili kↄ̃naↄ suaba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má bↄńnↄ gugbãntoo oi bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"mí ń kãaa za dṹnia lɛ́wa.","poem":1},{"lineBreak":true},{"text":"Vĩ̀aↄ ń ɛɛↄ ń nↄsindeeↄ aaↄ kú ń guu","poem":1},{"lineBreak":true},{"text":"ń nↄɛ pↄ́ kúlɛa ń nↄwãwãoↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ bílapiↄ su la dasidasi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"aa su ń wɛ́'io ń awakpaamɛɛo.","poem":1},{"lineBreak":true},{"text":"Máↄ dↄaanɛ́ swa saɛ","poem":1},{"lineBreak":true},{"text":"zɛ́ sàlala pↄ́ aa gɛ̃mbↄlɛuo guu,","poem":1},{"lineBreak":true},{"text":"asa Isailiↄ maen ma ũ,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buipiá ma nɛgↄ̃ɛ sɛ̃́iaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Á buipãleↄ, à ma yãma,","poem":1},{"lineBreak":true},{"text":"í a kpàwakɛ ísiabaazãzãdeↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ ma Isailiↄ fã̀aa,","poem":1},{"lineBreak":true},{"text":"má ɛa mà ń kãaa lↄɛ,","poem":1},{"lineBreak":true},{"text":"mí a kpàsa sãpiↄ dↄ̃́a lán sãdãnawa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa má Yakↄbu buiↄ bo,","poem":1},{"lineBreak":true},{"text":"má ń bↄ gbɛ̃́ pↄ́ an gbãa dɛńlaↄ ↄzĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa mↄ gulakɛ Siↄna sĩ̀sĩ musu,","poem":1},{"lineBreak":true},{"text":"aa pↄnakɛ ń ɛ̀fãai pↄ́ má kɛ̀nɛ́o,","poem":1},{"lineBreak":true},{"text":"pↄ́wɛna ń vɛ̃ɛo ń nísio","poem":1},{"lineBreak":true},{"text":"ń pↄtuo nɛ'iao yã́i.","poem":1},{"lineBreak":true},{"text":"Aaↄ dɛ lán swalu idewa,","poem":1},{"lineBreak":true},{"text":"an yɛ̃̀ɛɛ a kɛ̃́sãmá lↄo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wɛ̃́ndiaↄ pↄnakɛ, aaↄ ↄ̃wã","poem":1},{"lineBreak":true},{"text":"ń ɛ̀waasoↄ ń maezↄ̃ↄↄ píi.","poem":1},{"lineBreak":true},{"text":"Má ń ↄↄlↄ lilɛ pↄna ũ,","poem":1},{"lineBreak":true},{"text":"mí ń nↄ̀sɛ níninɛ́,","poem":1},{"lineBreak":true},{"text":"an nↄ̀sɛyaa gbɛu má nↄ̀sɛna danɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má tó blɛ níside fɛ̃ sa'onaↄzi,","poem":1},{"lineBreak":true},{"text":"má tó blɛ maa àↄ di ma gbɛ̃́ↄzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"wàlɛ wii ma dↄ Lama,","poem":1},{"lineBreak":true},{"text":"wàlɛ búbuapɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ ↄ́ↄlↄ wɛ̃nannↄ.","poem":1},{"lineBreak":true},{"text":"Lasɛli mɛ́ lɛ́ a nɛ́ↄ ↄ́ↄlↄ,","poem":1},{"lineBreak":true},{"text":"à gì awamai,","poem":1},{"lineBreak":true},{"text":"kɛ́ aà nɛ́ↄ ku lↄo yã́i.","poem":1},{"noteId":58}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"ásu ↄ́ↄlↄ lↄo,","poem":1},{"lineBreak":true},{"text":"ásu to wɛ́'i bↄwá lↄo,","poem":1},{"lineBreak":true},{"text":"asa má á taasi ài kpáwáɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Á buiↄ bↄlɛ ń ibɛɛↄ bùsuu aa su.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À wɛ́ dↄ á ziai,","poem":1},{"lineBreak":true},{"text":"asa á buiↄ su ń bùsuuɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ma Ɛflaiũ buiↄ wɛ̃nakɛa mà aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Wá dɛ lán gáae pↄ́ zĩ dↄ́ɛ dↄ̃owa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n wá swãgàga maamaa.","poem":1},{"lineBreak":true},{"text":"Wá gbɛsi, wí su,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń wá Lua ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wa bↄ n kpɛ, ↄ̃ wa nↄ̀sɛlìlɛ,","poem":1},{"lineBreak":true},{"text":"wá wɛ́kɛ̃a gbɛa wa wázĩa gbɛ̃̀gbɛ̃.","poem":1},{"lineBreak":true},{"text":"Wí wá kṹ wá ɛ̀waasogↄↄ yã́ musu,","poem":1},{"lineBreak":true},{"text":"wá gɛɛ gↄ̃̀ kpá wá wɛ́i.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄá ma nɛ́ yenzideↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄ dↄmáo lé?","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ miↄ ń lele an yã́ↄ yã́i mↄ̀ↄmↄↄ,","poem":1},{"lineBreak":true},{"text":"an yã́ lí sãmaguo.","poem":1},{"lineBreak":true},{"text":"A yã́i ma pↄ i bↄ ń guuo,","poem":1},{"lineBreak":true},{"text":"má wɛ̃nadↄ̃nɛ́ maamaa.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À lípɛlɛpɛlɛ á zɛ́u seela ũ,","poem":1},{"lineBreak":true},{"text":"à tó á sↄ̃ àↄ ku zɛ́ pↄ́ á bɛupiwa.","poem":1},{"lineBreak":true},{"text":"Isaili lɛ́so, su n wɛ̃́lɛↄ guu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nɛnↄɛ pↄ̀ↄbↄzãkɛna,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ liaaliaa e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Ma Dii má yã́ dafu dilɛ dṹniau,","poem":1},{"lineBreak":true},{"text":"nↄɛpi mɛ́ aↄ ↄlia a gↄ̃i sa.","poem":1}]},{"type":"verse","number":23,"content":["Ma Dii Zĩgↄ̃de Isailiↄ Lua ma mɛ̀, tó ma suńnↄ ń pá ziu, gbɛ̃́ pↄ́ kú Yuda bùsuuↄ ń a wɛ̃́lɛdeↄ mɛ: Dii báaada a sĩ̀sĩ pↄ́ a kua adoau, gu pↄ́ yã́zɛde kuu."]},{"type":"verse","number":24,"content":["Wa zↄ̃lɛ Yuda bùsuu ń a wɛ̃́lɛↄ, sɛ̃̀wanaↄ ń dã́dãkɛnaↄ píi."]},{"type":"verse","number":25,"content":["Asa má gbɛ̃́ pↄ́ imi ń yɛ̃̀ɛɛ sìmáↄ gba í, mí tó gbɛ̃́ pↄ́ nↄana ń gbãa sìmáↄ kã́."]},{"type":"verse","number":26,"content":["Gↄↄ bee ↄ̃ wɛ́pungu pↄ́ málɛ e wèea. Kɛ́ ma gugwà, yã́ pↄ́ má è i guupi na."]},{"type":"heading","content":["Dii bàa ɛa kua ń Isailiↄ"]},{"type":"verse","number":27,"content":["Ma Dii ma mɛ̀ gↄↄe a mↄ́ kɛ́ má tó gbɛ̃nazĩnaↄ ń pↄtuoↄ gupa Isaili ń Yuda bùsuo."]},{"type":"verse","number":28,"content":["Lá ma wɛdↄ̀nɛ́ yãa, ma ń fuangba, ma ń gboo, ma ń pisabò, ma yãyìamá, màa má wɛ́tɛńzi sa, má ń zɛdↄ, má ń gba gbãa. Ma Dii mámɛ má ò."]},{"type":"verse","number":29,"content":["Gↄↄ bee aa mɛ maeↄ vɛ̃ɛbɛ kũ̀ma blè ↄ̃ nɛ́ↄ swaa fɛ̃́nkpào,",{"noteId":59}]},{"type":"verse","number":30,"content":["asa baade a ga a duuna yã́iɛ. Gbɛ̃́ pↄ́ vɛ̃ɛbɛ kũ̀ma blè swaa mɛ́ a fɛ̃́nkpa."]},{"type":"verse","number":31,"content":["Ma Dii ma mɛ̀, a gↄↄ a mↄ́ kɛ́ ma bàa a ɛa àↄ kú ń Isailiↄ ń Yudaↄ dafu.",{"noteId":60}]},{"type":"verse","number":32,"content":["Ma bàa aↄ kúńnↄ lá a kú ń ń deziↄ gↄↄ pↄ́ ma ń kṹ ń ↄwa ma ń bↄ́lɛ Egipiwao. Asa baa kɛ́ má dɛ ń zã́ ũ, aa ma bàakuańnↄ yã́ gbòoɛ. Ma Dii mámɛ má ò."]},{"type":"verse","number":33,"content":["Lá ma bàa aↄ kú ń Isailiↄ gↄↄ bee gbɛan kɛ.",{"text":"Má a ikoyã danɛ́ ń nↄ̀sɛ guu,","poem":1},{"lineBreak":true},{"text":"má kɛ̃́ ń sↄ̃wa.","poem":1},{"lineBreak":true},{"text":"Máↄ dɛ ń Lua ũ,","poem":1},{"lineBreak":true},{"text":"aaiↄ dɛ ma gbɛ̃́ↄ ũ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"An gbɛ̃e a yãdada a deeɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a ma dↄ̃a da a gbɛ̃́ɛo,","poem":1},{"lineBreak":true},{"text":"asa ampii aaↄ ma dↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ píi.","poem":1},{"lineBreak":true},{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má ń tàaeↄ kɛ̃́má,","poem":1},{"lineBreak":true},{"text":"má ń duuna yãda lↄo.","poem":1},{"noteId":61}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"mámɛ ma ĩatɛ̃ dìlɛ à gupu fãanɛ,","poem":1},{"lineBreak":true},{"text":"ma mↄvua ń saanaↄ pɛ̀pɛ aa gupu gwã́,","poem":1},{"lineBreak":true},{"text":"mi to ísia fɛlɛ, a ikooaↄ pũna,","poem":1},{"lineBreak":true},{"text":"ma tↄ́n Dii Zĩgↄ̃de.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Mɛ́ i kɛ pↄ́piↄ gòmalao,","poem":1},{"lineBreak":true},{"text":"Isaili bui a midɛmɛɛ bauo.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"mɛ́ i kɛ wà musu yↄ̃̀","poem":1},{"lineBreak":true},{"text":"wà dṹnia zĩ́mpɛlɛↄ asii dↄ̃̀o,","poem":1},{"lineBreak":true},{"text":"má gí Isaili buiↄzi píi","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ aa kɛ̀ yã́io.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":38,"content":["Ma Dii ma mɛ̀ gↄↄe a mↄ́ kɛ́ wa ɛa wɛ̃́lɛpi kálɛmɛɛ sɛa za Ananɛli kalangawa e Gola Bↄlɛu."]},{"type":"verse","number":39,"content":["Za we wa ba poo gɛò Galebu sĩ̀sĩwa, wi liaa gɛò Goai."]},{"type":"verse","number":40,"content":["Guzulɛ pↄ́ dɛ gɛvĩkĩi ń nísigbↄ̃kↄlɛkĩio ũ ń bua pↄ́ kú we e za Sedↄ̃ swaiↄ e Sↄ̃́ Bↄlɛu gukpɛ oi, apii aↄ dɛ ma pↄ́ ũɛ. Wa wɛ̃́lɛpi wi lↄo, wa gboo bauo."]}],"footnotes":[{"noteId":58,"caller":"+","text":"31.15 Daa 35.16-19, Mat 2.18","reference":{"chapter":31,"verse":15}},{"noteId":59,"caller":"+","text":"31.29 Eze 18.2","reference":{"chapter":31,"verse":29}},{"noteId":60,"caller":"+","text":"31.31 Mat 26.28, 1Kln 11.25, 2Kln 3.6","reference":{"chapter":31,"verse":31}},{"noteId":61,"caller":"+","text":"31.34 Ɛbɛ 8.8-12, 10.16-17","reference":{"chapter":31,"verse":34}}]},"thisChapterLink":"/api/bqc_sim/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}