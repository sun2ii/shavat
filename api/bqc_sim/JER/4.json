{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀, á Isailiↄ, tó á sua, à sua.","poem":1},{"lineBreak":true},{"text":"Tó a ↄzↄ̃̀ á pↄ́ pↄ́ má zauↄi,","poem":1},{"lineBreak":true},{"text":"mɛ́ álɛ liaaliaa lↄo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"tó a lɛgbɛ̃̀ ń ma kuao kã́ukãu ń sĩanao,","poem":1},{"lineBreak":true},{"text":"buipãleↄ báaadakↄ̃u ń ma tↄ́o,","poem":1},{"lineBreak":true},{"text":"aai ĩ́anadã ma yã́ musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Yã́ pↄ́ Dii ò Yelusalɛũdeↄ ń Yudaↄnɛn kɛ:",{"text":"Á Yelusalɛũdeↄ ń Yudaↄ píi,","poem":1},{"lineBreak":true},{"text":"à kpase kɛ̃ wásawasa,","poem":1},{"lineBreak":true},{"text":"ásu pↄ́tↄ̃ lɛuo.","poem":1},{"noteId":4}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À tↄ̃zↄ̃ á sↄ̃̀ gbãsĩwoloa ũ,","poem":1},{"lineBreak":true},{"text":"í gↄ̃ ma pↄ́ ũ wásawasa.","poem":1},{"lineBreak":true},{"text":"Tó màan sↄ̃o,","poem":1},{"lineBreak":true},{"text":"má a pↄkũmabↄbↄwáɛ","poem":1},{"lineBreak":true},{"text":"lán tɛ́ pↄ́ gbɛ̃e a fↄ̃ dɛowa","poem":1},{"lineBreak":true},{"text":"yãvãi pↄ́ á kɛ̀ yã́i.","poem":1}]},{"type":"heading","content":["Zĩgↄ̃ↄ bↄa gugbãntoo oi"]},{"type":"verse","number":5,"content":[{"text":"À kpàwakɛ Yudaↄnɛ,","poem":1},{"lineBreak":true},{"text":"à o Yelusalɛũdeↄnɛ:","poem":1},{"lineBreak":true},{"text":"À kuupɛ á bùsuu,","poem":1},{"lineBreak":true},{"text":"à wiilɛ ń lↄↄ gbãtɛ̃o","poem":1},{"lineBreak":true},{"text":"à onɛ́ aa kãaa,","poem":1},{"lineBreak":true},{"text":"aai bàalɛ ta wɛ̃́lɛ bĩ́ideↄu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À gudↄkↄ̃ɛkĩi dilɛ Siↄna,","poem":1},{"lineBreak":true},{"text":"wí mↄ́ ulɛ we, ásu zɛzɛo,","poem":1},{"lineBreak":true},{"text":"asa má tó kìsia zↄ̃ↄ ń pↄ́ ↄ̃̀ↄnɛkɛao bↄ gugbãntoo oiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nↄ̀ↄmusu fɛ̀lɛ bↄ̀ a tòou,","poem":1},{"lineBreak":true},{"text":"buiↄ kàalɛnapi dàzɛu.","poem":1},{"lineBreak":true},{"text":"À gò a tía,","poem":1},{"lineBreak":true},{"text":"àlɛ gɛ́ á bùsu kɛi kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"á wɛ̃́lɛↄ i gↄ̃ bɛziaↄ ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A yã́i tò à zwã̀nkasaↄ kákaála,","poem":1},{"lineBreak":true},{"text":"à ↄ́ↄlↄ à búbuapɛ,","poem":1},{"lineBreak":true},{"text":"asa Dii pↄfɛ̃awázi zↄ̃ↄ, i kpálɛo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ sↄ̃ a kɛ̃ kía ń a ìwaↄgu,","poem":1},{"lineBreak":true},{"text":"yã́pi i di sa'onaↄwa,","poem":1},{"lineBreak":true},{"text":"ãnabiↄ lɛ́ i gↄ̃ kpaaũa.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Ɔ̃ ma mɛ̀: Á'a Dii Lua! N ↄ̃nↄkɛ̀ Yelusalɛũdeↄnɛɛ ń gbɛ̃́ɛ beeↄ píi. Kɛ́ n mɛ̀ aaↄ ku aafiaɛ,",{"noteId":5},"ↄ̃ fɛ̃nda mɛ́ aↄ wiilɛ ń miwaa?"]},{"type":"verse","number":11,"content":["Gↄↄ bee Dii a o Yelusalɛũdeↄnɛ ń gbɛ̃́ɛ beeↄ píi, à mɛ ĩ́an wãa a bↄ gbáau sĩ̀sĩ wáiwaiↄ musu à mↄ lɛ́lɛ a gbɛ̃́ↄwa. I kɛ ĩ́ana pↄ́ wì pↄ́ fã́i a gbãsĩ bↄlɛ no,"]},{"type":"verse","number":12,"content":["ĩ́ana pↄ́ á gbaɛmá gbãa aↄ dɛ beea, yã́kpalɛ á kɛńnↄ sa."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gwa! Àlɛ mↄ́ lán lousisiawa,","poem":1},{"lineBreak":true},{"text":"aà zĩkasↄ̃goↄ dɛ lán zàawa,","poem":1},{"lineBreak":true},{"text":"aà sↄ̃́ↄ wãa dɛ kúuↄla.","poem":1},{"lineBreak":true},{"text":"Waiyoo wápiↄ! Wa kaalɛɛ sa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yelusalɛũdeↄ, à á sↄ̃ pípi,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e bↄ aafia.","poem":1},{"lineBreak":true},{"text":"Áↄ kú ń á làasoo vãio e bↄɛ ni?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wàlɛ a baokpa Dã buiↄ bùsuu,","poem":1},{"lineBreak":true},{"text":"wàlɛ músi kpàwakɛ Ɛflaiũ buiↄ bùsu sĩ̀sĩdeu:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À o buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"í a kpàwakɛ Yelusalɛũdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"ibɛɛↄ bↄ̀ bùsu zã̀zãu, aalɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"aalɛ kúkua dↄ Yudaↄ wɛ̃́lɛↄwa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"aalɛ liai lán masedãnaↄwa,","poem":1},{"lineBreak":true},{"text":"asa Yudaↄ bↄ̀ ma kpɛɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Á dàa ń á yãkɛaↄ mɛ́ bee ìɛ́.","poem":1},{"lineBreak":true},{"text":"Á ĩadaman we. A pãsĩ!","poem":1},{"lineBreak":true},{"text":"Àlɛ ĩadawá e á sↄ̃u.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ ↄ̃̀ↄkpà! Ma nↄ̀sɛ ↄ̃̀ↄkpà!","poem":1},{"lineBreak":true},{"text":"Ma nↄ̀sɛ lɛ́ pusu bↄ, sↄ̃ kɛ̃̀magu,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ màↄ nílɛo.","poem":1},{"lineBreak":true},{"text":"Ma kuu'ↄ mà dↄ ń kúkuakɛao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wíwia lɛ́ kɛ wíwia,","poem":1},{"lineBreak":true},{"text":"bùsu gↄ̃̀ da wàuu gupiiu.","poem":1},{"lineBreak":true},{"text":"Wá zwã̀akpɛↄ wìwi kã́ndo,","poem":1},{"lineBreak":true},{"text":"wá zwãaↄ yàa gↄ̃̀ↄgↄ̃ↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Máↄ dàlapooↄ gwa e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Máↄ kuu'ↄpi ma dↄ e bↄɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dii mɛ̀ a gbɛ̃́ↄ mi vĩo, aa a dↄ̃o,","poem":1},{"lineBreak":true},{"text":"nɛ́ sↄũↄnɛ, aa yãe gbáɛo.","poem":1},{"lineBreak":true},{"text":"Vãi ↄ̃nↄ ↄ̃ aa dↄ̃, aa maakɛa dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ma zĩ́lɛ gwà,","poem":1},{"lineBreak":true},{"text":"má è da pã, a kɛkɛao.","poem":1},{"lineBreak":true},{"text":"Ma musu gwà, má è a gupua vĩo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ma gbɛ̀sĩsĩↄ gwà,","poem":1},{"lineBreak":true},{"text":"mà è aalɛ lualua,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄ sↄ̃ aalɛ deedee píi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma gugwà, mi gbɛ̃e eo,","poem":1},{"lineBreak":true},{"text":"baa bãↄ aa ń taa kɛ̀ píiɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma gugwà, ↄ̃ má è","poem":1},{"lineBreak":true},{"text":"bùsu táaede gↄ̃̀ gbáa ũ,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛↄ wìwi píi Dii aɛ","poem":1},{"lineBreak":true},{"text":"aà pↄkũma pãsĩ yã́i.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Asa Dii mɛ̀","poem":1},{"lineBreak":true},{"text":"bùsu a ↄ̃̀ↄkpa píiɛ,","poem":1},{"lineBreak":true},{"text":"ń beeo á kaalɛ míↄmiↄo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ayãmɛto tↄↄlɛ a búbuapɛ,","poem":1},{"lineBreak":true},{"text":"musu i siakũ,","poem":1},{"lineBreak":true},{"text":"asa Dii yã'ò, a a nↄ̀sɛ suumpao,","poem":1},{"lineBreak":true},{"text":"à yãdìlɛ kↄ̀, a ɛa kpɛo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛdeↄ lɛ́ tílɛ píi,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa sↄ̃deↄ ń kàzunaↄ kↄ̃fĩ mà yã́i.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃eↄ lɛ́ si dào guu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃eↄ dɛ̀dɛ lɛ́ sↄlↄ gbɛ̀sↄↄu.","poem":1},{"lineBreak":true},{"text":"Wɛ̃́lɛↄ gↄ̃̀ bɛziaↄ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku we lↄo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yelusalɛũ, bↄ́ ńlɛ kɛi?","poem":1},{"lineBreak":true},{"text":"Àkɛa n zwã̀a tɛ̃a yè,","poem":1},{"lineBreak":true},{"text":"n vua nↄamblebↄↄ dà, n kio kài?","poem":1},{"lineBreak":true},{"text":"N nzĩa kɛ̀kɛ pãɛ!","poem":1},{"lineBreak":true},{"text":"N gↄ̃pↄsɛↄ gìnziɛ,","poem":1},{"lineBreak":true},{"text":"aa ye n wɛ̃ni bↄɛ sa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ma wii mà lán nɛ'iwãwã wiiwa,","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ́ sɛ̃́ia iwa.","poem":1},{"lineBreak":true},{"text":"Siↄna wiiɛ, àlɛ we fòo, fòo,","poem":1},{"lineBreak":true},{"text":"à ↄpòo à mɛ̀: Waiyoo mapi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃dɛnaↄ ↄdìɛa, má kú ga lɛ́zĩɛ.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"4.3 Oze 10.12","reference":{"chapter":4,"verse":3}},{"noteId":5,"caller":"+","text":"4.10 Zel 6.13-14, 14.13, 23.16-17","reference":{"chapter":4,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}