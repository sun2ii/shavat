{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":45,"content":[{"type":"heading","content":["Baluku yã́"]},{"type":"verse","number":1,"content":["Nɛlia nɛ́ Baluku yã́ pↄ́ ãnabi Zelemii òɛ kɛ̃̀ láu. A gbɛa ↄ̃ Zelemii yã́ bee òɛ̀ Yudaↄ kí Yoakiũ, Yosia nɛ́ kpalablea wɛ̃̀ síiↄ̃de guu."]},{"type":"verse","number":2,"content":["Dii Isailiↄ Lua mɛ́ yã́pi ònɛ Baluku."]},{"type":"verse","number":3,"content":["Ni mɛ waiyoo mpi, Dii yã'ĩa kã̀fĩnɛ n yã'ↄ̃mauɛ, ńlɛ aaukɛ e n kpasa, ńlɛ ĩ́ampakĩi eo."]},{"type":"verse","number":4,"content":["Dii mɛ̀ mà onɛ á pↄ́ pↄ́ á bò wíwi, í pↄ́ pↄ́ á tↄ̃̀ wolɛ, baa bùsu bṹu guu."]},{"type":"verse","number":5,"content":["Yãzↄ̃ↄↄ ńlɛ wɛɛlɛ nzĩaɛa? Ńsu wɛɛlɛo, asa Diipi mɛ̀ á yãmↄ gbɛ̃́piiɛ, ãma gu pↄ́ n gɛu píi, á n misiɛ. Dii mɛ́ ò."]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/44.json","previousChapterAudio