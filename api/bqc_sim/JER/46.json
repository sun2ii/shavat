{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":46,"content":[{"type":"heading","content":["Yã́ pↄ́ a Egipiↄ le"]},{"type":"verse","number":1,"content":["Dii yã'ò ãnabi Zelemiiɛ buiↄ yã́ musu à mɛ̀:"]},{"type":"verse","number":2,"content":["Egipi pↄ́n la. Yã́ pↄ́ Dii ò Egipiↄ kí Falaↄ̃ↄ Nɛko zĩgↄ̃ↄ musun kɛ, gↄↄ pↄ́ Babɛli kí Nɛbukanɛza zĩblèmá Uflatai Kaakemi saɛ, Yudaↄ kí Yoakiũ, Yosia nɛ́ kpalablea wɛ̃̀ síiↄ̃de guu."]},{"type":"verse","number":3,"content":[{"text":"À á sɛ̀ngbaoↄ kɛkɛ,","poem":1},{"lineBreak":true},{"text":"a zↄ̃ↄ ń a nɛ́nao,","poem":1},{"lineBreak":true},{"text":"í gɛ́ zĩu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À ã̀asĩna ká sↄ̃́ↄnɛ, í di ń kpɛ.","poem":1},{"lineBreak":true},{"text":"À mↄ̀ fùaↄ kpákpa, í zɛ dↄ̀ↄdↄↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ̀ ulaↄ dada, í á sↄ̃naↄ lɛkɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bↄ́ málɛ e wei?","poem":1},{"lineBreak":true},{"text":"Má è vĩa ń zĩgↄ̃ↄ kũ̀,","poem":1},{"lineBreak":true},{"text":"aalɛ pↄ̀ↄbↄzãkɛ,","poem":1},{"lineBreak":true},{"text":"wà zĩblèmá, aalɛ tílɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ ń kpɛ gwao, vĩa pↄ́ↄ liaańzi.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ò.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ kàsakasa i e bàalɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ gbãa i e bↄ̀o.","poem":1},{"lineBreak":true},{"text":"Aalɛ gɛ̃mbↄlɛ, aalɛ kwɛ́","poem":1},{"lineBreak":true},{"text":"Uflata saɛ gugbãntoo oi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Deↄ mɛ́ lɛ́ fɛlɛ lán Niiliwa kee,","poem":1},{"lineBreak":true},{"text":"aalɛ zãampapa lán í zↄ̃ↄwai?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Egipiↄnɛ! Aalɛ fɛlɛ lán Niiliwa,","poem":1},{"lineBreak":true},{"text":"aalɛ zãampapa lán í zↄ̃ↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ mɛ: Wá fɛlɛ da dṹniaaɛ,","poem":1},{"lineBreak":true},{"text":"wí wɛ̃́lɛↄ míↄnzↄ̃ ń gbɛ̃́ pↄ́ kúuↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sↄ̃deↄ, à dazɛu!","poem":1},{"lineBreak":true},{"text":"Zĩkasↄ̃godeↄ, à gofĩ sↄũsↄũ!","poem":1},{"lineBreak":true},{"text":"Zĩgↄ̃ↄ, à bↄ ń táo!","poem":1},{"lineBreak":true},{"text":"Etiopiↄ ń Libiiↄ sɛ̀ngbao kũa,","poem":1},{"lineBreak":true},{"text":"Ludiↄ sá kũa, aalɛ kã́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gↄↄpiá Dii Lua Zĩgↄ̃de pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"tↄsia aà ibɛɛↄwa gↄↄɛ.","poem":1},{"lineBreak":true},{"text":"Fɛ̃nda a yɛ̃́mɛmińgu à tã ń auo,","poem":1},{"lineBreak":true},{"text":"asa Dii Lua Zĩgↄ̃de sa'oa vĩ","poem":1},{"lineBreak":true},{"text":"Uflata saɛ gugbãntoo oi bùsuuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Egipiↄ, à gɛ bↄ̀ ɛsɛ wɛɛlɛ Galada!","poem":1},{"lineBreak":true},{"text":"Ń beeo á ɛsɛkɛkɛ pãɛ,","poem":1},{"lineBreak":true},{"text":"á gyã a kɛ̃́wáo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buiↄ ma lá wà widàwá,","poem":1},{"lineBreak":true},{"text":"á pelemboa wii a li dṹniaa.","poem":1},{"lineBreak":true},{"text":"Á gↄ̃saↄ kpákpakↄ̃a,","poem":1},{"lineBreak":true},{"text":"aai kwɛ sikↄ̃a.","poem":1}]},{"type":"verse","number":13,"content":["Yã́ pↄ́ Dii ò ãnabi Zelemiiɛ Babɛli kí Nɛbukanɛza mↄa lɛ́lɛi Egipiwa musun kɛ:"]},{"type":"verse","number":14,"content":[{"text":"À yã́ɛ bee o Egipiↄnɛ,","poem":1},{"lineBreak":true},{"text":"à a kpàwakɛ Midoli ń Mɛfisio ń Tapanɛsio.","poem":1},{"lineBreak":true},{"text":"À onɛ́ aa sↄukɛ aa zĩ'ↄpoo,","poem":1},{"lineBreak":true},{"text":"asa zĩ lɛ́ ń saɛdeↄ bleɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bↄ́yãi á nɛgↄ̃naↄ wúlɛai?","poem":1},{"lineBreak":true},{"text":"Aai fↄ̃ fɛ̀lɛo, Dii mɛ́ ń nɛ́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa gɛ̃nalɛlɛ aa kpákpakↄ̃a,","poem":1},{"lineBreak":true},{"text":"aa mɛ, fɛlɛ wà ta wá gbɛ̃́ↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"wà bàalɛ gbãamↄnɛdeↄ fɛ̃ndaɛ,","poem":1},{"lineBreak":true},{"text":"wà ta wázĩa bùsuu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À tↄ́kpa Egipiↄ kí Falaↄ̃ↄɛ,","poem":1},{"lineBreak":true},{"text":"Zↄade pↄ́ à azĩa gↄ̃́ikɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lá á Taboo dↄ̃ gbɛ̀sĩsĩ ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ á Kaamɛli dↄ̃ ísia saɛ,","poem":1},{"lineBreak":true},{"text":"ń ma kuao, màa á ibɛɛ mↄa sea vĩo.","poem":1},{"lineBreak":true},{"text":"Ma Kía pↄ́ ma tↄ́n Dii Zĩgↄ̃de mámɛ má ò.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Á Egipiↄ, à á pↄ́ↄ naaa.","poem":1},{"lineBreak":true},{"text":"Wa á kṹkũ wà táánↄɛ.","poem":1},{"lineBreak":true},{"text":"Wa tɛsↄ̃ Mɛfisiwa à gↄ̃ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Egipi dɛ lán zununu kɛfɛnawaɛ.","poem":1},{"lineBreak":true},{"text":"Fìona a bↄ gugbãntoo oi, i mↄ pɛwà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zĩgↄ̃ pↄ́ Egipiↄ fĩabònɛ́ↄ","poem":1},{"lineBreak":true},{"text":"dɛ lán zunɛbↄlↄ mɛkpaaↄwaɛ.","poem":1},{"lineBreak":true},{"text":"Aa kpɛkpa, aai tílɛ sãnu,","poem":1},{"lineBreak":true},{"text":"aa fↄ̃ zɛ gio,","poem":1},{"lineBreak":true},{"text":"asa yãmↄnɛgↄↄ mɛ́ kà,","poem":1},{"lineBreak":true},{"text":"an ĩadamagↄↄ mɛ́ pìla.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Egipiↄ bà kpã́i lɛ́ lán mlɛ̃wa,","poem":1},{"lineBreak":true},{"text":"an ibɛɛↄ lɛ́lɛmá ń gbãao,","poem":1},{"lineBreak":true},{"text":"aa sumá ń mↄoↄ lán yàawɛnaↄwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ Egipi zĩgↄ̃ↄ kpa","poem":1},{"lineBreak":true},{"text":"lán líkpɛ sisi pↄ́ wa fↄ̃ gɛ̃uowa,","poem":1},{"lineBreak":true},{"text":"wa ń kwɛ́ɛ.","poem":1},{"lineBreak":true},{"text":"Asa an ibɛɛpiↄ dasi dɛ kwaↄla,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ ń naoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wa Egipiↄ na gugbãntoodepiↄnɛ ń ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"wi widamá.","poem":1}]},{"type":"verse","number":25,"content":["Ma Dii Zĩgↄ̃de Isailiↄ Lua ma mɛ̀ má Tɛbɛsi tã́a Amↄni wɛtã ń Falaↄ̃ↄo ń Egipiↄ ń ń tã́a kĩniↄ ń ń kíaↄ. Má Falaↄ̃ↄ ń gbɛ̃́ pↄ́ aa aà náai vĩↄ wɛtã,"]},{"type":"verse","number":26,"content":["mí ń na Babɛli kí Nɛbukanɛza ń aà zↄ̀blena pↄ́ aalɛ ń wɛↄnɛ ń ↄzĩ. A gbɛa wa ɛa wàↄ ku we lán yãawa. Ma Dii mámɛ má ò."]},{"type":"verse","number":27,"content":[{"text":"Ma zↄ̀blena Yakↄbu buiↄ,","poem":1},{"lineBreak":true},{"text":"ásu to vĩa á kũo.","poem":1},{"lineBreak":true},{"text":"Isailiↄ, ásu bílikɛo,","poem":1},{"lineBreak":true},{"text":"asa má á bↄ bùsu zã̀zãu,","poem":1},{"lineBreak":true},{"text":"á buiↄ ↄ̃ má ń sí zↄblewa.","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ ɛa aaↄ ku kílikili dↄdↄa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a to vĩa ń kũo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ma zↄ̀blena Yakↄbu buiↄ,","poem":1},{"lineBreak":true},{"text":"ásu vĩakɛo, asa má kúánↄɛ.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ ma ↄzↄ̃̀ázi ń guuↄ","poem":1},{"lineBreak":true},{"text":"baa tó ma buipiↄ míↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"má á míↄnzↄ̃o.","poem":1},{"lineBreak":true},{"text":"Ãma á bↄ pão fá!","poem":1},{"noteId":75},{"lineBreak":true},{"text":"Má á swã́gaga a zɛ́waɛ.","poem":1}]}],"footnotes":[{"noteId":75,"caller":"+","text":"46.28 Zel 30.10-11","reference":{"chapter":46,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}