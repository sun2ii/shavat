{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":47,"content":[{"type":"heading","content":["Yã́ pↄ́ a Filitɛ̃ↄ le"]},{"type":"verse","number":1,"content":["Dii yã'ò ãnabi Zelemiiɛ Filitɛ̃ↄ musu e Falaↄ̃ↄ àↄ gɛ́ lɛ́lɛi Gazawa à mɛ̀:"]},{"type":"verse","number":2,"content":["Dii mɛ̀:",{"text":"Í bↄ̀ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"àlɛ su lán swa paawa.","poem":1},{"lineBreak":true},{"text":"Ípi dà bùsua ń pↄ́ pↄ́ kú a guuↄ,","poem":1},{"lineBreak":true},{"text":"à dà wɛ̃́lɛↄla ń gbɛ̃́ pↄ́ kúuↄ píi.","poem":1},{"lineBreak":true},{"text":"Wàlɛ wiilɛ,","poem":1},{"lineBreak":true},{"text":"bùsudeↄ lɛ́ búbuapɛ ḿpii,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ibɛɛↄ sↄ̃́ gbãa bàalɛkↄ̃fĩ yã́i","poem":1},{"lineBreak":true},{"text":"ń sↄ̃́goↄ wuluu tↄↄlɛlualuaa yã́io.","poem":1},{"lineBreak":true},{"text":"Maeↄ ɛa su ń nɛ́ↄ sɛ́lɛio,","poem":1},{"lineBreak":true},{"text":"kɛ́ an gã̀sĩ gↄ̃̀ dↄ̀lↄlↄ yã́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Filitɛ̃ↄ kɛa kɛ́lɛkɛlɛ gↄↄ mɛ́ kà,","poem":1},{"lineBreak":true},{"text":"wa gbɛ̃́ pↄ́ aaì dↄ Tiideↄ ń Sidↄ̃deↄlɛ kↄ̃napiↄ míↄnzↄ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ a Filitɛ̃ↄ ásookɛ,","poem":1},{"lineBreak":true},{"text":"i Kɛlɛti bùsude pↄ́ gↄ̃̀piↄ dɛ̃ↄnzↄ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gazadeↄ ń mi bò,","poem":1},{"lineBreak":true},{"text":"Asekelonideↄ lɛ́ gↄ̃̀ kpaaũa.","poem":1},{"lineBreak":true},{"text":"Gusalala gbɛ̃́ kↄ̃naↄ,","poem":1},{"lineBreak":true},{"text":"áↄ ázĩa lili e bↄɛ ni?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Á'a Dii fɛ̃nda, ńyↄ̃ zɛwɛ̃ɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Sↄlↄ n kpɛ́u! Kã́ma bo! Zɛ màa lɛ!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii mɛ́ fɛ̃ndapi dàu, kpelewa a kɛ à zɛi?","poem":1},{"lineBreak":true},{"text":"A dìlɛ fɛ̃ndapiɛ aà yɛ̃́mɛmi Asekelonideↄ ń ísialɛdeↄguɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}