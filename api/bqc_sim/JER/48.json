{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":48,"content":[{"type":"heading","content":["Yã́ pↄ́ a Mↄabuↄ le"]},{"type":"verse","number":1,"content":["Dii Zĩgↄ̃de Isailiↄ Lua yã'ò Mↄabuↄ musu à mɛ̀:",{"text":"Waiyoo, wà Nɛbo ásookɛ̀.","poem":1},{"lineBreak":true},{"text":"Wà Kiliataiũ sì wà a gbɛ̃́ↄ kũ̀kũ,","poem":1},{"lineBreak":true},{"text":"wà ń mɛɛwiadeↄ kũ̀, aa gↄ̃̀ bíli guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mↄabuↄ ĩ́andãa vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"wà lɛkpàaĩńzi Ɛsɛbↄ̃ wà mɛ̀:","poem":1},{"lineBreak":true},{"text":"À mↄ wà gɛ buipi dúuzↄ̃.","poem":1},{"lineBreak":true},{"text":"Á Madɛmɛdeↄ sↄ̃ á lɛ́ a gↄ̃ kpaaũaɛ,","poem":1},{"lineBreak":true},{"text":"wi pɛ́wá ń fɛ̃ndao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Olonaiũdeↄ wii ma dↄ:","poem":1},{"lineBreak":true},{"text":"Wà wá dɛ̃ↄnzↄ̃! Wà wá kɛ́ dúuduu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wà Mↄabuↄ dúuzↄ̃̀,","poem":1},{"lineBreak":true},{"text":"an nɛ́fɛ̃nɛnaↄ ↄↄlↄ ma dↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aalɛ wiipɛ, aalɛ Luiti sĩ̀sĩ kṹ,","poem":1},{"lineBreak":true},{"text":"aalɛ búbuapɛ, aa pìla lɛ́ gɛ́ Olonaiũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À bàalɛ! À ázĩa mibↄkĩi wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"íↄ ku gbáau lán sɛ̃̀a zàa'ĩnawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lá a á yãkɛaↄ ń á àizɛɛↄ náaikɛ̀,","poem":1},{"lineBreak":true},{"text":"a yã́i wa á kṹkũi,","poem":1},{"lineBreak":true},{"text":"wi táánↄ bùsu pãleu ń á kíaↄ","poem":1},{"lineBreak":true},{"text":"ń á tã́a Kɛmↄsio ń a gbàgbanaↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gudɛna a lɛ́lɛ á wɛ̃́lɛwa píiɛ,","poem":1},{"lineBreak":true},{"text":"á wɛ̃́lɛe a bↄo.","poem":1},{"lineBreak":true},{"text":"Wa guzulɛ ↄ̃̀ↄkpaɛ,","poem":1},{"lineBreak":true},{"text":"wi gusalala dúuzↄ̃,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À gã̀sĩaↄ kpa Mↄabuↄwa","poem":1},{"lineBreak":true},{"text":"aa vua taò,","poem":1},{"lineBreak":true},{"text":"asa an wɛ̃́lɛↄ gↄ̃ bɛziaↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku a kee guu lↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì zĩkɛ Diiɛ ń zígbiaoá láaipↄɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ gì gbɛ̃dɛi ń a fɛ̃ndaoá láaipↄɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mↄabuↄ ku dↄdↄa za ń ɛ̀waasogↄↄ,","poem":1},{"lineBreak":true},{"text":"aa zↄ̃lɛaɛ mɛ̀tɛɛɛ lán wɛ̃wa dàa guu.","poem":1},{"lineBreak":true},{"text":"Wi ń lilɛ wà ń ká dàa pãleu yãao,","poem":1},{"lineBreak":true},{"text":"wi ń bↄlɛ wà tàńnↄ bùsu pãleuo.","poem":1},{"lineBreak":true},{"text":"Aa na e tiaɛ, an gĩ i lilɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yã́i ma Dii ma mɛ̀ a gↄↄ lɛ́ mↄ́","poem":1},{"lineBreak":true},{"text":"kɛ́ mà dàalɛkulɛnaↄ zĩmá,","poem":1},{"lineBreak":true},{"text":"aai ń dàapiↄ lɛ́ kúlɛ aa ń bↄlɛu,","poem":1},{"lineBreak":true},{"text":"aai gbasa ń dàapiↄ wíwi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wí a Mↄabuↄ kũ Kɛmↄsi yã́ musuɛ,","poem":1},{"lineBreak":true},{"text":"lá wí Isailiↄ kũ̀ Bɛtɛli pↄ́ aa aà náaikɛ̀ yã́ musuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mↄabuↄ, kpelewa á e o","poem":1},{"lineBreak":true},{"text":"nɛgↄ̃n zĩ̀kan gbãaↄn á ũi?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wa si Mↄabuↄ wɛ̃́lɛↄu wà ń dɛ̃ↄnzↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"an ɛ̀waaso maaↄ i gaga gbɛ̃dɛdɛa guu.","poem":1},{"lineBreak":true},{"text":"Kía mɛ́ ò, aà tↄ́n Dii Zĩgↄ̃de.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mↄabuↄ kɛa kɛ́lɛkɛlɛ kãikũ̀,","poem":1},{"lineBreak":true},{"text":"wa yã́yiamá zɛzɛsaiɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á bui pↄ́ á liaańziↄ","poem":1},{"lineBreak":true},{"text":"ń á gbɛ̃́ pↄ́ a ń tↄ́ màↄ píi","poem":1},{"lineBreak":true},{"text":"à ázĩa gbɛ̃gbɛ̃ ń yã́i,","poem":1},{"lineBreak":true},{"text":"í mɛ an gopana gbãa làa,","poem":1},{"lineBreak":true},{"text":"an kpala gawi kↄ'ɛ̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dibↄ̃deↄ à á kúkĩi gawide to we,","poem":1},{"lineBreak":true},{"text":"í pila zↄ̃lɛ bùsuu.","poem":1},{"lineBreak":true},{"text":"Asa Mↄabuↄ kàalɛnaↄ lɛ́ mↄ́ lɛ́lɛiwá,","poem":1},{"lineBreak":true},{"text":"aa á wɛ̃́lɛ bĩ́ideↄ gbooɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aloeedeↄ, à zɛ zɛ́ saɛ àↄ gudã,","poem":1},{"lineBreak":true},{"text":"íↄ gↄ̃ɛ ń nↄɛ pↄ́ aalɛ kↄ̀sↄ fãↄ la","poem":1},{"lineBreak":true},{"text":"àↄ mɛ, à kɛ̀ kpelewa ni?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wí Mↄabuↄ kũ̀, wà ń dúuzↄ̃̀ɛ.","poem":1},{"lineBreak":true},{"text":"À wiilɛ! À búbuapɛ,","poem":1},{"lineBreak":true},{"text":"í onɛ́ Aanↄ saɛ we,","poem":1},{"lineBreak":true},{"text":"wà Mↄabuↄ míↄnzↄ̃ɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lua yã́kpalɛkɛ̀ ń gusalaladepiↄɛ,","poem":1},{"lineBreak":true},{"text":"Olonadeↄ ń Yazadeↄ ń Mɛfaadeↄ","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ń Dibↄ̃deↄ ń Nɛbodeↄ ń Bɛdiblataiũdeↄ","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ń Kiliataiũdeↄ ń Bɛgamuludeↄ ń Bɛmɛonadeↄ","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ń Keliodeↄ ń Bↄzɛladeↄ","poem":1},{"lineBreak":true},{"text":"ń Mↄabu bùsu wɛ̃́lɛↄ píi,","poem":1},{"lineBreak":true},{"text":"a pↄ́ pↄ́ kú kãiↄ ń a pↄ́ pↄ́ kú zã̀ↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wà Mↄabuↄ gbãa kↄ'ɛ̀,","poem":1},{"lineBreak":true},{"text":"wà ń gã̀sa wìwi.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mↄabuↄ kuabìi Diiwaɛ.","poem":1},{"lineBreak":true},{"text":"À íkakanɛ́,","poem":1},{"lineBreak":true},{"text":"aa lɛ́lɛ ń pisi guu blàtau,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃ láanipↄ ũ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I Isailiↄ láanikɛ yãa nolo?","poem":1},{"lineBreak":true},{"text":"Tó álɛ ń yã'o,","poem":1},{"lineBreak":true},{"text":"iliↄ mikɛnɛ́ déũdeũ","poem":1},{"lineBreak":true},{"text":"lán kpã́i wa kũ̀wao lé?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mↄabuↄ, à á wɛ̃́lɛↄ to we,","poem":1},{"lineBreak":true},{"text":"í gɛ àↄ ku gbɛtↄↄu","poem":1},{"lineBreak":true},{"text":"lán bã pↄ́ ì nɛ́ da wewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Wa Mↄabuↄ yↄ̃̀ↄ yãmà,","poem":1},{"lineBreak":true},{"text":"an kàamai ń ń zazao kɛ̀ zài.","poem":1},{"lineBreak":true},{"text":"Aa zĩasɛa lɛsĩ ń ĩ́andão vĩ,","poem":1},{"lineBreak":true},{"text":"wala mɛ́ lɛ́ ń ɛ́ ń sↄ̃ guu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má ńzĩa sɛa lɛsĩ dↄ̃, kási pãɛ,","poem":1},{"lineBreak":true},{"text":"an yãbↄlɛ lí gbɛsuo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ayãmɛto málɛ ↄ́ↄlↄ Mↄabuↄnɛ,","poem":1},{"lineBreak":true},{"text":"málɛ wiipɛ ń yã́ musu,","poem":1},{"lineBreak":true},{"text":"málɛ búbuapɛ Kilalɛsɛdeↄnɛ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Málɛ ↄ́ↄlↄ Sibema vɛ̃ɛbuↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma wiipi dɛ lán Yazɛɛdeↄ pↄ́wa.","poem":1},{"lineBreak":true},{"text":"Sibema gↄ̃na ↄtà yãa e ísialɛi","poem":1},{"lineBreak":true},{"text":"e à gɛ̀ kà Yazɛɛwa.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ gbɛ̃kaalɛna mↄ̀ lɛ̀lɛ","poem":1},{"lineBreak":true},{"text":"a vɛ̃ɛ kↄ́ pↄ́ màↄwa.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wà pↄna ń yaalↄo bↄ̀","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ kaaↄu ń ń buaↄ.","poem":1},{"lineBreak":true},{"text":"Má tò vɛ̃ɛ lɛ́ bↄ a fɛ̃kĩi lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lɛ́ ↄ̃zↄ̃ vɛ̃ɛwa ń wiio lↄo.","poem":1},{"lineBreak":true},{"text":"Wii dↄ, kási pↄna wii no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"An wii dↄ za Ɛsɛbↄ̃ e Ɛleale ń Yaazao,","poem":1},{"lineBreak":true},{"text":"za Zoaa e à gɛ̀ pɛ̀ Olonaiũ ń Egala Selisiaowa,","poem":1},{"lineBreak":true},{"text":"asa baa Niũliũ í bà lↄɛ se.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aaì sa'o gulɛsĩↄwa,","poem":1},{"lineBreak":true},{"text":"aaì tulaletikatɛa ń diiↄnɛↄ,","poem":1},{"lineBreak":true},{"text":"má ń midɛ Mↄabu bùsuuɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"A yã́i ma nↄ̀sɛ lɛ́ ↄ́ↄlↄ lán kulɛ'ↄwa Mↄabuↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ lɛ́ ↄ́ↄlↄ lán kulɛ'ↄ wà Kilalɛsɛdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"asa an àizɛɛ pↄ́ aa nàaaↄ gɛ̃̀zɛaɛ.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"An baade migbaa lɛ̀,","poem":1},{"lineBreak":true},{"text":"aa ń lɛkãna wà,","poem":1},{"lineBreak":true},{"text":"aa ń ↄↄ lìli ḿpii,","poem":1},{"lineBreak":true},{"text":"aa zwã̀nkasaↄ dↄ̀dↄ ń pi.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Mↄabuↄ lɛ́ búbuapɛ","poem":1},{"lineBreak":true},{"text":"ń kpɛ́ↄ musu píi ń ń gãaɛↄ píi,","poem":1},{"lineBreak":true},{"text":"asa ma ń wiwi","poem":1},{"lineBreak":true},{"text":"lán ta pↄ́ gbɛ̃e yeiowaɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Bíli Mↄabuↄ kũ̀, ↄ̃ aalɛ wiipɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ kpɛkpa ń wío.","poem":1},{"lineBreak":true},{"text":"Mↄabuↄ gↄ̃̀ láanipↄ ũ,","poem":1},{"lineBreak":true},{"text":"sↄ̃kɛ̃ngu pↄ́ ũ gbɛ̃́ pↄ́ liaańziↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À gwa, wàlɛ yàakpa Mↄabuↄla,","poem":1},{"lineBreak":true},{"text":"wà kúu'ò lɛ́ sumá.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ Keliowa,","poem":1},{"lineBreak":true},{"text":"wa wɛ̃́lɛ bĩ́ideↄ sí.","poem":1},{"lineBreak":true},{"text":"Zĩ́ bee sↄ̃ a kɛ̃ Mↄabu nɛgↄ̃naↄgu","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ'i wãwãkɛwa.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Wa Mↄabuↄ míↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"an bui aↄ ku lↄo,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa kuabìia yã́i.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀, Mↄabuↄ,","poem":1},{"lineBreak":true},{"text":"yãpãsĩ ń ɛo ń baio lɛ́ á dã́.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ bàalɛ yãpãsĩpiɛↄ zu ɛuɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ bai a gbɛ̃́ pↄ́ bↄ̀ ɛpi guuↄ kṹ,","poem":1},{"lineBreak":true},{"text":"asa má tó Mↄabuↄ wɛtãgↄↄ kaɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Òlo'olobonaↄ yɛ̃̀ɛɛ làa,","poem":1},{"lineBreak":true},{"text":"aalɛ mikpakĩi wɛɛlɛ Ɛsɛbↄ̃ uei,","poem":1},{"lineBreak":true},{"text":"ↄ̃ tɛ́ fɛ̀lɛ Ɛsɛbↄ̃,","poem":1},{"lineBreak":true},{"text":"tɛ́lɛpiↄ bↄ̀ kí Siↄ̃ wɛ̃́lɛpiu,","poem":1},{"lineBreak":true},{"text":"àlɛ kṹ Mↄabuↄ miwa,","poem":1},{"lineBreak":true},{"text":"àlɛ kṹ zↄakanapiↄ dↄ́wa.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Waiyoo á Mↄabuↄ!","poem":1},{"lineBreak":true},{"text":"Kɛmↄsi gbàgbanaↄ mìdɛ!","poem":1},{"lineBreak":true},{"text":"Wà á nɛgↄ̃ɛↄ kũ̀kũ zĩ̀zↄↄ ũ,","poem":1},{"lineBreak":true},{"text":"wà á nɛnↄɛↄ nàaa wà tàńnↄ.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀ gↄↄgbɛzãzĩ","poem":1},{"lineBreak":true},{"text":"má su ń Mↄabuↄ ń pá ziu.","poem":1},{"lineBreak":true},{"text":"Lá yã́ a zↄ̃lɛ Mↄabuↄwan we.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}