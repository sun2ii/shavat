{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":49,"content":[{"type":"heading","content":["Yã́ pↄ́ a Amↄniↄ le"]},{"type":"verse","number":1,"content":[{"text":"Amↄniↄ yã́ musu Dii mɛ̀:","poem":1},{"lineBreak":true},{"text":"Isailiↄ nɛgↄ̃ɛↄ vĩo lé?","poem":1},{"lineBreak":true},{"text":"Aa túbiblenaↄ vĩo lé?","poem":1},{"lineBreak":true},{"text":"Àkɛa tã́a Mↄlↄku gↄ̃̀ Gada bùsu vĩi?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi aà gbàgbanaↄ ku a wɛ̃́lɛↄui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"a gↄↄ lɛ́ mↄ́ kɛ́ má kúkua dↄ","poem":1},{"lineBreak":true},{"text":"Amↄniↄ mɛɛwia Labawa,","poem":1},{"lineBreak":true},{"text":"i gↄ̃ bɛzia ũ.","poem":1},{"lineBreak":true},{"text":"Isailiↄ i tɛsↄ̃ a zↄ̃ɛwiaↄwa,","poem":1},{"lineBreak":true},{"text":"aai gbɛ̃́ pↄ́ ń yá yãapiↄ ya sↄ̃.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛsɛbↄ̃deↄ, à wiilɛ,","poem":1},{"lineBreak":true},{"text":"asa Ai kàalɛɛ.","poem":1},{"lineBreak":true},{"text":"Labadeↄ, à búbuapɛ,","poem":1},{"lineBreak":true},{"text":"í zwã̀nkasaↄ kákaála,","poem":1},{"lineBreak":true},{"text":"í ázĩa gbɛ̃gbɛ̃,","poem":1},{"lineBreak":true},{"text":"à bã̀abãabo á wɛ̃́lɛ bĩ́idepiu,","poem":1},{"lineBreak":true},{"text":"asa wa Mↄlↄku sɛ́lɛ taò sãnu","poem":1},{"lineBreak":true},{"text":"ń a gbàgbanaↄ ń ń kíaↄɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bↄ́yãi álɛ ĩ́anadã","poem":1},{"lineBreak":true},{"text":"á guzulɛ táaedeↄ yã́ musui?","poem":1},{"lineBreak":true},{"text":"Pↄ̀ↄbↄzãkɛnaↄ, i á àizɛɛ náaikɛ","poem":1},{"lineBreak":true},{"text":"à mɛ: Deↄ mɛ́ aa fↄ̃ lɛ́lɛwái?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Dii Lua Zĩgↄ̃de,","poem":1},{"lineBreak":true},{"text":"má tó bui pↄ́ liaaáziↄ gili gɛ̃águɛ,","poem":1},{"lineBreak":true},{"text":"aai pɛ́wá ápii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à á gbɛ̃́ pↄ́ fãaaaↄ kãaao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛzã má su ń Amↄniↄ ń pá ziu,","poem":1},{"lineBreak":true},{"text":"ma Dii mámɛ má ò.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Ɛdↄũↄ le"]},{"type":"verse","number":7,"content":[{"text":"Ɛdↄũↄ yã́ musu Dii Zĩgↄ̃de mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄnae ku Temani lↄo lé?","poem":1},{"lineBreak":true},{"text":"Laaideↄ lɛdama làa yã̀?","poem":1},{"lineBreak":true},{"text":"An ↄ̃nↄ gɛ̃̀zɛa yã̀?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dedãdeↄ, à ɛa ń bao,","poem":1},{"lineBreak":true},{"text":"í gɛ ulɛ gbɛ̀'ɛↄ guu,","poem":1},{"lineBreak":true},{"text":"asa má tó á Esau buiↄ yã'e","poem":1},{"lineBreak":true},{"text":"á wɛtãgↄↄpiɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó vɛ̃ɛkↄzↄ̃zↄ̃naↄ mɛ́ mↄ̀ sì á vɛ̃ɛbuↄu,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛ kↄ̃na ↄ̃ aa tóɛ́o lò?","poem":1},{"lineBreak":true},{"text":"Tó kpã́iↄ mɛ́ gɛ̃̀ázi gwã́ sↄ̃,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ an pↄ́ dↄwà ↄ̃ aa sɛ adoo lò?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ má Esauↄ pↄ́ↄ pilimá píiɛ,","poem":1},{"lineBreak":true},{"text":"má bↄmá ń ulɛkĩiↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"aa naalɛkĩi e guei lↄo.","poem":1},{"lineBreak":true},{"text":"An nɛ́ↄ ń ń daɛↄ ń ń gbɛ̃́deeↄ gaga,","poem":1},{"lineBreak":true},{"text":"an bui aↄ ku lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À tonɛ pↄ́ gwana vĩoↄ to we,","poem":1},{"lineBreak":true},{"text":"má ↄliańzi.","poem":1},{"lineBreak":true},{"text":"Á gyaa gbɛ̃andoↄ i ma náaikɛ lↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃́ pↄ́ aai ka ma pↄkũma í miaoↄ sù wa mì,","poem":1},{"lineBreak":true},{"text":"ápiↄ sↄ̃ á bↄ pãe?","poem":1},{"lineBreak":true},{"text":"Á bↄ pão, á mi sↄ̃ɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Dii má sì ń mazĩao,","poem":1},{"lineBreak":true},{"text":"Bↄzɛla a gↄ̃ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"iↄ da gii lán gbáawa.","poem":1},{"lineBreak":true},{"text":"Aↄ dɛ láanipↄ ũ, láaipↄ ũ,","poem":1},{"lineBreak":true},{"text":"a zↄ̃ɛwiaↄ iↄ da gii gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ma baomà Diiwa,","poem":1},{"lineBreak":true},{"text":"wà zĩnae zĩ̀ buiↄwa aà onɛ́,","poem":1},{"lineBreak":true},{"text":"aa kↄ̃ kãaa aa gɛ lɛ́lɛwá,","poem":1},{"lineBreak":true},{"text":"aa fɛlɛ gɛ́ zĩkaiánↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À ma! Má tó à gↄ̃ kpɛɛ buiↄ guu,","poem":1},{"lineBreak":true},{"text":"wìliↄ sakaágu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Á nↄ̀sɛ pãsĩ ń á kàamaio mɛ́ á sãsã.","poem":1},{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ a gbɛ kɛ̀ á kpɛ́ ũ,","poem":1},{"lineBreak":true},{"text":"á zↄ̃lɛa gbɛ̀sĩsĩ musu,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ a á sakpɛ dà musumusu lán baɛwa,","poem":1},{"lineBreak":true},{"text":"má á bãɛɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɛdↄũ bùsu a gↄ̃ wáiwai,","poem":1},{"lineBreak":true},{"text":"yã́pi i di gbɛ̃́ pↄ́ lɛ́ gɛ̃ weↄwa,","poem":1},{"lineBreak":true},{"text":"aaiↄ a láanikɛ wɛ́tɛ̃a pↄ́ wà mↄ̀ɛ̀ yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aↄ dɛ lán Sↄdↄũ ń Gↄmↄↄo","poem":1},{"noteId":76},{"lineBreak":true},{"text":"ń wɛ̃́lɛ pↄ́ kú ń saɛↄ míↄnzↄ̃awaɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e a zↄ̃lɛ weo, baa do.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lá nↄ̀ↄmusu ì bↄ Yuudɛ̃ dàou","poem":1},{"lineBreak":true},{"text":"à gɛ̀ bualoũ àizɛɛdeu,","poem":1},{"lineBreak":true},{"text":"màa má Ɛdↄũↄ ya mà ń bↄlɛ ń bùsuu gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"mí gbɛ̃́ pↄ́ má sɛ̀ dilɛ we.","poem":1},{"lineBreak":true},{"text":"Démɛ muaamanↄi?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ ma gbɛa a yã́ii?","poem":1},{"lineBreak":true},{"text":"Dↄaana kpele mɛ́ a fↄ̃ zɛ gimɛɛi?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ayãmɛto à yã́ pↄ́ Dii zɛ̀ò à kɛ Ɛdↄũↄnɛ ma","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ a dìlɛ Temanideↄ musuo.","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄmusupi a ń nɛ́ↄ naaa taò lán sãↄwaɛ,","poem":1},{"lineBreak":true},{"text":"i ń bualoũpi dɛ̃ↄnzↄ̃ ń yã́i.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"An kwɛa a tↄↄlɛ lualua,","poem":1},{"lineBreak":true},{"text":"wa ń wii ma e Ísia Tɛ̃ai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À ma! Ibɛɛ a fɛlɛ kúu'omá,","poem":1},{"lineBreak":true},{"text":"i a gã̀sĩa poo Bↄzɛla.","poem":1},{"lineBreak":true},{"text":"Gↄↄ bee sↄ̃ a kɛ̃ Ɛdↄũ nɛgↄ̃naↄgu","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ'i wãwãkɛwa.","poem":1}]},{"type":"heading","content":["Yã́ pↄ́ a Damasi le"]},{"type":"verse","number":23,"content":[{"text":"Damasi yã́.","poem":1},{"lineBreak":true},{"text":"Amatadeↄ ń Aapadadeↄ gɛɛ gↄ̃̀ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa bao ĩ́i mà yã́i.","poem":1},{"lineBreak":true},{"text":"An sↄ̃ zɛa tɛɛɛo lán ísia íwa,","poem":1},{"lineBreak":true},{"text":"an nↄ̀sɛ daa doũo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Damasideↄ kúsu kwɛ̀,","poem":1},{"lineBreak":true},{"text":"aalɛ olo'olobo,","poem":1},{"lineBreak":true},{"text":"aa lɛ̀kↄ̃wa ń bao.","poem":1},{"lineBreak":true},{"text":"Pↄsia ń wãwão tↄ̃̀má,","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ'ìwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bↄ́yãi aai bↄlɛ wà wɛ̃́lɛ tↄdepi tò weo ni?","poem":1},{"lineBreak":true},{"text":"Mɛɛwia pↄnadepi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛpi ɛ̀waasoↄ kwɛ a zɛaↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"wi a zĩgↄ̃ↄ dɛdɛ zĩbeezĩ píi.","poem":1},{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de mámɛ má ò.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Má tɛsↄ̃ Damasi bĩ́iↄwa,","poem":1},{"lineBreak":true},{"text":"kí Bɛnadada zɛgikĩi i tɛ́kũ.","poem":1}]},{"type":"heading","content":["Kedaaↄ ń Azoo bùsudeↄ"]},{"type":"verse","number":28,"content":["Kedaaↄ ń Azoo bùsu pↄ́ Babɛli kí Nɛbukanɛza lɛ̀lɛmáↄ yã́ musu Dii mɛ̀:",{"text":"À fɛlɛ gɛ́ lɛ́lɛi Kedaaↄwa,","poem":1},{"lineBreak":true},{"text":"í gukpɛdepiↄ dɛ̃ↄnzↄ̃.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wa ń zwã̀akpɛↄ ń ń pↄtuoↄ símá,","poem":1},{"lineBreak":true},{"text":"wi tá ń ń zwãa pↄ́ aaì da ń kpɛ́uↄ","poem":1},{"lineBreak":true},{"text":"ń ń yiongoↄ ń ń pↄ́ↄ píi.","poem":1},{"lineBreak":true},{"text":"Wi wiidↄmá: Vĩa pↄ́ↄ liaaázi!","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Azoo bùsudeↄ, à bàalɛ fãaa,","poem":1},{"lineBreak":true},{"text":"í gɛ ulɛ gbɛ̀'ɛↄ guu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Babɛli kí Nɛbukanɛza yãsɛ̀ánↄ,","poem":1},{"lineBreak":true},{"text":"à lɛkpàaĩázi ń gbɛ̃́ↄ à mɛ̀:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"À gɛ lɛ́lɛ bui pↄ́ kálɛa dↄdↄa,","poem":1},{"lineBreak":true},{"text":"aalɛ ńzĩa náaikɛↄwa.","poem":1},{"lineBreak":true},{"text":"An wɛ̃́lɛↄ gbaↄ ń gbã́aↄ vĩo,","poem":1},{"lineBreak":true},{"text":"aamɛ ká we ńtɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wa ń yiongoↄ naaa,","poem":1},{"lineBreak":true},{"text":"wi tá ń ń zuↄ dasidasi.","poem":1},{"lineBreak":true},{"text":"An gbɛ̃́ pↄ́ aaì mizↄ̃iↄ,","poem":1},{"lineBreak":true},{"text":"má tó yã́ bↄ gupiiu à ń le,","poem":1},{"lineBreak":true},{"text":"mí ń fãaa dṹnia gola síiↄ̃u.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Azoo bùsu a gↄ̃ gbɛ̃gbonaↄ tòo ũɛ,","poem":1},{"lineBreak":true},{"text":"iↄ da wáiwai gↄↄpii.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e aↄ ku we lↄo, baa do.","poem":1}]},{"type":"heading","content":["Elaũ bùsu"]},{"type":"verse","number":34,"content":["Dii yã'ò ãnabi Zelemiiɛ Elaũ bùsu yã́ musu Yudaↄ kí Zedekia kpalablea daalɛgↄↄ à mɛ̀:"]},{"type":"verse","number":35,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má Elaũↄ sá ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"asa sápi ↄ̃ aalɛ gbãa'ewà.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Má dṹnia gola síiↄ̃ ĩ́ana gbaɛmá,","poem":1},{"lineBreak":true},{"text":"mí ń fãaa gupiiu.","poem":1},{"lineBreak":true},{"text":"Bùsue ku kɛ́ an lala'onaↄ gí tauio.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Má Elaũↄ kãdɛ ń ibɛɛ pↄ́ aalɛ ń wɛↄnɛ,","poem":1},{"lineBreak":true},{"text":"mí yã́yiamá ń pↄfɛ̃ pãsĩo.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Má pɛ́má ń fɛ̃ndao","poem":1},{"lineBreak":true},{"text":"e mà gɛ ń midɛɛ.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Má Elaũↄ kía ń ń dↄaanaↄ dɛdɛɛ,","poem":1},{"lineBreak":true},{"text":"mí a kpalabaa kpálɛ an bùsuu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Gbɛzã má su ń Elaũↄ ń pá ziu","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]}],"footnotes":[{"noteId":76,"caller":"+","text":"49.18 Daa 19.24-25","reference":{"chapter":49,"verse":18}}]},"thisChapterLink":"/api/bqc_sim/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}