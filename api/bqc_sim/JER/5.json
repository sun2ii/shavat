{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":5,"content":[{"type":"heading","content":["Gbɛ̃e maao"]},{"type":"verse","number":1,"content":[{"text":"À Yelusalɛũ zɛaↄ kɛɛlɛ à gwa,","poem":1},{"lineBreak":true},{"text":"à wɛɛlɛ a gãaɛↄu à e dↄ̃.","poem":1},{"lineBreak":true},{"text":"Tó yãmaakɛn sĩanwɛɛlɛnae ku we,","poem":1},{"lineBreak":true},{"text":"má sùuukɛ ń wɛ̃́lɛpio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baa kɛ́ aaì mɛ Dii ku,","poem":1},{"lineBreak":true},{"text":"ń beeo aaì lɛgbɛ̃ ń mↄafilioɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii, sĩana ↄ̃ ńlɛ wɛɛlɛmáo lò?","poem":1},{"lineBreak":true},{"text":"N ń gbɛ̃́, i ↄ̃máo,","poem":1},{"lineBreak":true},{"text":"n ń kɛ́ búɛbuɛ, ↄ̃ aa gì totoapi mai.","poem":1},{"lineBreak":true},{"text":"An swã́ gbãakũ̀ lán gbɛwa,","poem":1},{"lineBreak":true},{"text":"aa gì nↄ̀sɛlilɛi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀ taasideↄnɛ, aa mi vĩo,","poem":1},{"lineBreak":true},{"text":"aa Dii yãkɛaↄ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"aa dↄ̃ yã́ pↄ́ ń Lua lɛ́ yáńnↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má gɛ́ mà yã'o maezↄ̃ↄↄnɛɛ,","poem":1},{"lineBreak":true},{"text":"aa Dii yãkɛaↄ dↄ̃o lé?","poem":1},{"lineBreak":true},{"text":"Aa dↄ̃ yã́ pↄ́ ń Lua lɛ́ yáńnↄo lé?","poem":1},{"lineBreak":true},{"text":"Kási gbɛ̃́piↄ sↄ̃ aa n zuu bↄ̀ńla,","poem":1},{"lineBreak":true},{"text":"aa n baↄ kɛ̃̀kɛ̃máɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ayãmɛto nↄ̀ↄmusu a bↄ lákpɛu à kusimá,","poem":1},{"lineBreak":true},{"text":"àwalɛwana a bↄ gbáau à ń dɛdɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛaana a naalɛnɛ́ wɛ̃́nkpɛ,","poem":1},{"lineBreak":true},{"text":"i gbɛ̃́ pↄ́ bↄ̀ↄ taitai,","poem":1},{"lineBreak":true},{"text":"asa an tàaeↄ dasikũ̀,","poem":1},{"lineBreak":true},{"text":"an pↄ̀ↄbↄzãkɛa kɛ̀ zài.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yelusalɛũ, má sùuukɛnnↄe?","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́ↄ pãkpàmaziɛ,","poem":1},{"lineBreak":true},{"text":"aaì yã́si ń tã́aↄɛ, i kɛ mámɛo.","poem":1},{"lineBreak":true},{"text":"Má tò pↄ́ mↄ̀má,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa sì káalua kpɛ́u aa gbãsĩkɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sↄ̃sa kãa pↄ́ an mɛ fɛlɛaↄnɛ,","poem":1},{"lineBreak":true},{"text":"an baade ì lua a gbɛ̃́dee nↄi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má ĩadamá yã́pi yã́io lé?","poem":1},{"lineBreak":true},{"text":"Má tↄsi buipi taawao lé?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"À gɛ ma vɛ̃ɛbu","poem":1},{"noteId":6},{"text":"dúuzↄ̃,","poem":1},{"lineBreak":true},{"text":"ãma ásu dɛɛlɛ píio.","poem":1},{"lineBreak":true},{"text":"À a gↄ̃naↄ zↄ̃zↄ̃,","poem":1},{"lineBreak":true},{"text":"asa gↄ̃napiↄá ma pↄ́ no.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isailiↄ ń Yudaↄ bↄ̀ ma kpɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aa Dii ɛɛbò aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Màa no, vãie a wá leo.","poem":1},{"lineBreak":true},{"text":"Wá kↄ̃'e ń zĩo ge ń nↄanaoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ãnabiↄ lɛ́ lɛ́'ĩana gbaɛ,","poem":1},{"lineBreak":true},{"text":"Dii yã́ aalɛ oo.","poem":1},{"lineBreak":true},{"text":"Aamɛ aa ń pↄ́ e ńzĩawa we.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ayãmɛto ma Dii Lua Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"lá màa gbɛ̃́piↄ ònɛ,","poem":1},{"lineBreak":true},{"text":"má a yã́ sóso kánɛ ń lɛ́u tɛ́ ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́piↄ iↄ dɛ yàa pↄ́ tɛ́pi a kũwà ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isailiↄ, ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"má bui pↄ́ kú zã̀zã sóikɛwáɛ,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ kú za zi mɛ́ aↄ ku gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ ili ń yãmao","poem":1},{"lineBreak":true},{"text":"mɛ́ á ń yã'oa dↄ̃o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"An gbàlaↄ ì ga inɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"ampii gↄ̃sa gbãaↄnɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa pↄ́ pↄ́ á kɛ̀kɛↄ ń á blɛↄ naaa,","poem":1},{"lineBreak":true},{"text":"aai á nɛgↄ̃ɛↄ ń á nɛnↄɛↄ sɛ́lɛ.","poem":1},{"lineBreak":true},{"text":"Aa á zuↄ ń á sãↄ ń á bleↄ naaa,","poem":1},{"lineBreak":true},{"text":"aai á vɛ̃ɛbɛↄ ń á kaadↄɛmbɛↄ sɛ́lɛ.","poem":1},{"lineBreak":true},{"text":"Aa á wɛ̃́lɛ bĩ́ide pↄ́ álɛ a náaikɛↄ dɛ̃ↄnzↄ̃ ń ń zĩkabↄↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Ma Dii ma mɛ̀, baa gↄↄ bee má á kɛ kɛ́lɛkɛlɛo."]},{"type":"verse","number":19,"content":["Tó wà n la, bↄ́yãi ma Dii ń Lua má kɛ̀inɛ́ màa píii, ní onɛ́, lá aa pãkpàmazi aa zↄblè dii zĩ̀loↄnɛ ńzĩa bùsuu, màa aa zↄble bui zĩ̀loↄnɛ bùsu zĩ̀lou sↄ̃."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"À yã́ɛ bee o Yakↄbu buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"í a kpàwakɛ Yudaↄnɛ à mɛ:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sↄũ nↄ̀sɛsaideↄ, à yãma,","poem":1},{"lineBreak":true},{"text":"á wɛ́ vĩ, ili gu'eo,","poem":1},{"lineBreak":true},{"text":"á swã́ vĩ, ili yãmao.","poem":1},{"noteId":7}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I kũ à vĩakɛmɛɛo lé?","poem":1},{"lineBreak":true},{"text":"I kũ à lualua ma aɛo lé?","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ málɛ á la.","poem":1},{"lineBreak":true},{"text":"Ma bùsu'ũfãa kàlɛ ísia zↄ̃lɛ ũ,","poem":1},{"lineBreak":true},{"text":"kↄↄ pↄ́ ma dàɛ̀n we,","poem":1},{"lineBreak":true},{"text":"a í a fↄ̃ à a baa vĩ bauo.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ a í ì zãampapa,","poem":1},{"lineBreak":true},{"text":"ìli fↄ̃ à a baa vĩ̀o.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ a ikooaↄ ì kↄ̃fĩkɛ,","poem":1},{"lineBreak":true},{"text":"ìli fↄ̃ à a baa vĩ̀o.","poem":1},{"noteId":8}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ swã́ gbãa, aa fɛ̀lɛmanↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa pã̀alɛmɛɛ aa gɛ̃̀zɛa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Baa kɛ́ mi lou manɛ́ a gↄↄwa","poem":1},{"lineBreak":true},{"text":"za káabuana e à gɛ́ bↄlɛi,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma pↄkɛkɛgↄↄ dìlɛnɛ́,","poem":1},{"lineBreak":true},{"text":"aali okↄ̃ɛ wà vĩakɛ ma Dii ń Luaɛo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Á vãikɛa mɛ́ kpà pↄ́piↄnɛ,","poem":1},{"lineBreak":true},{"text":"á duuna mɛ́ gìɛ́ à maa e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ ku ma gbɛ̃́ↄ guu,","poem":1},{"lineBreak":true},{"text":"aaì ń wɛ lán fíikpanaↄwa,","poem":1},{"lineBreak":true},{"text":"aaì baikpá gbɛ̃́ↄnɛ kɛ́ aa e wà ń kṹ yã́i.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Lá bã ìↄ ka bãwɛna bãkabↄ pai,","poem":1},{"lineBreak":true},{"text":"màa mↄafili ń ua pà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì kɛ ↄdeↄ ũ wà gbãakũ,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"aaì kã́, an mɛ iↄ tɛkɛ.","poem":1},{"lineBreak":true},{"text":"An vãikɛa gɛ̃agɛ̃̀,","poem":1},{"lineBreak":true},{"text":"aali yã́si ń nɛtonɛↄ, yã́ e bↄńnↄ nao.","poem":1},{"lineBreak":true},{"text":"Aali zɛ ń pↄesaideↄ aa ń yãnakpàmáo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má ĩadamá yã́pi yã́io lé?","poem":1},{"lineBreak":true},{"text":"Má tↄsi buipi taawao lé?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ wa ye a gĩyãio","poem":1},{"lineBreak":true},{"text":"wì vĩakɛɛ̀ kↄ̃̀ ń bùsuu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ãnabiↄ ì ãnabikɛkɛ ń ɛɛo,","poem":1},{"lineBreak":true},{"text":"sa'onaↄ zĩa yã́ mɛ́ ì dↄaanɛ́.","poem":1},{"lineBreak":true},{"text":"Màa ma gbɛ̃́ↄ yei,","poem":1},{"lineBreak":true},{"text":"ãma kpelewa aa kɛ zã́i?","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.10 Isa 5.7","reference":{"chapter":5,"verse":10}},{"noteId":7,"caller":"+","text":"5.21 Isa 6.9-10, Eze 12.2, Maa 8.18","reference":{"chapter":5,"verse":21}},{"noteId":8,"caller":"+","text":"5.22 Yob 38.8-11","reference":{"chapter":5,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}