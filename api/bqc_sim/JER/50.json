{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":50,"content":[{"type":"heading","content":["Babɛli dúuzↄ̃a"]},{"type":"verse","number":1,"content":["Yã́ pↄ́ Dii dà ãnabi Zelemiiɛ a ò Babɛli ń Babiloni bùsuo yã́ musun kɛ:"]},{"type":"verse","number":2,"content":[{"text":"À baoɛ bee kpa buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"à dàlapoo da, í kpàwakɛ,","poem":1},{"lineBreak":true},{"text":"ásu yãe ulɛnɛ́o,","poem":1},{"lineBreak":true},{"text":"à mɛ wà Babɛli sì,","poem":1},{"lineBreak":true},{"text":"an tã́a Bɛli gɛɛ gↄ̃̀ kpa a wɛ́i,","poem":1},{"lineBreak":true},{"text":"an tã́a Mɛlodaki gↄ̃̀ zɛ yɛ̀ɛɛ.","poem":1},{"lineBreak":true},{"text":"An pↄ́ pↄ́ aa pì dii ũↄ gↄ̃̀ ń wío,","poem":1},{"lineBreak":true},{"text":"vĩa ń tã́apiↄ kũ̀ píi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gugbãntoo oi bui mɛ́ lɛ̀lɛwà,","poem":1},{"lineBreak":true},{"text":"aa a bùsu kɛ̀ yáiyai.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e ku we lↄo,","poem":1},{"lineBreak":true},{"text":"baa nↄ̀bↄↄ se, aa bàalɛ̀ bↄ̀lɛuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma Dii ma mɛ̀","poem":1},{"lineBreak":true},{"text":"zĩbeezĩ Isailiↄ ń Yudaↄ su sãnu,","poem":1},{"lineBreak":true},{"text":"aa ma Dii ń Lua kĩ́i wɛɛlɛ ń ↄↄlↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa Siↄna zɛ́ gbɛa, aai mipɛwà,","poem":1},{"lineBreak":true},{"text":"aai naa, ma bàa iↄ kúńnↄ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"a yã́ a sã́ńguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma gbɛ̃́ↄ dɛ lán sã sã́sãaↄwaɛ,","poem":1},{"lineBreak":true},{"text":"an dↄaanaↄ mɛ́ tò aa lìaaliaa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa pↄ̀ↄbↄzãkɛ̀mɛɛ gbɛ̀sĩsĩↄ musu.","poem":1},{"lineBreak":true},{"text":"Aa gɛ̀ gbɛ̀sĩsĩ musu le,","poem":1},{"lineBreak":true},{"text":"aa sù sĩ̀sĩ musu la,","poem":1},{"lineBreak":true},{"text":"e aa gɛ̀ zã̀ ń kúkĩiwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ bↄ̀máↄ ń mↄmↄ.","poem":1},{"lineBreak":true},{"text":"An ibɛɛpiↄ mɛ̀ wa tàae vĩo,","poem":1},{"lineBreak":true},{"text":"asa aa duunakɛ̀ Diiɛɛ.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ń kaa sĩande","poem":1},{"lineBreak":true},{"text":"pↄ́ an deziↄ wɛ́ dↄi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À bↄlɛ Babɛli,","poem":1},{"noteId":77},{"lineBreak":true},{"text":"à Babiloni bùsu to we.","poem":1},{"lineBreak":true},{"text":"Àↄ dɛ lán blesana","poem":1},{"lineBreak":true},{"text":"pↄ́ dↄaaa kpàsa pↄ́ↄnɛↄwaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa má bui zↄ̃ↄↄ kãaa gugbãntoo oi bùsuu,","poem":1},{"lineBreak":true},{"text":"mí ń sóikɛ aa gɛ lɛ́lɛ Babɛliwaɛ.","poem":1},{"lineBreak":true},{"text":"Bↄa we aa gɛ́ zĩ'ↄpooi, aai sí.","poem":1},{"lineBreak":true},{"text":"An kaↄ dɛ lán nɛgↄ̃n ↄnade pↄ́ aali su asioↄwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa Babiloni bùsu pↄ́ↄ naaa,","poem":1},{"lineBreak":true},{"text":"pↄsɛlɛnapiↄ i kã́.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Á gbɛ̃́ pↄ́ i ma gbɛ̃́ↄ pↄ́ↄ naaaↄ,","poem":1},{"lineBreak":true},{"text":"lá álɛ tidↄńla, álɛ pↄnakɛ ń ń pↄ́ↄ,","poem":1},{"lineBreak":true},{"text":"lá álɛ vĩvĩ lán zununu pↄ́ lɛ́ pↄ́wɛnagbɛ̃wa,","poem":1},{"lineBreak":true},{"text":"lá álɛ wiilɛ lán sↄ̃saↄwa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"wí a á da kũ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"nↄɛ pↄ́ á í gɛɛ a gↄ̃ kpa a wɛ́i.","poem":1},{"lineBreak":true},{"text":"Aà buiↄ i gↄ̃ kpɛɛ buiↄ guu,","poem":1},{"lineBreak":true},{"text":"aà bùsu i gↄ̃ gbáa gii wáiwai ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃e aↄ ku weo ma pↄfɛ̃ yã́i,","poem":1},{"lineBreak":true},{"text":"a gↄ̃ da yàaa píiɛ.","poem":1},{"lineBreak":true},{"text":"Yã́pi a di gbɛ̃́ pↄ́ lɛ́ dↄ Babɛliziↄwa píi,","poem":1},{"lineBreak":true},{"text":"aaiↄ lɛsuikɛwà ĩa pↄ́ wa dàwà yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kàzunaↄ à zĩ'ↄpoo Babɛlizi,","poem":1},{"lineBreak":true},{"text":"ásu á kaↄ wɛgwao, à ↄzↄ̃i,","poem":1},{"lineBreak":true},{"text":"asa à duunakɛ̀ Diiɛɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À kúkua dↄwà gupiiu!","poem":1},{"lineBreak":true},{"text":"À mikpàmá sa,","poem":1},{"lineBreak":true},{"text":"a bĩ́iↄ kwɛ̀, a gĩↄ gbòo.","poem":1},{"lineBreak":true},{"text":"Lá Dii mɛ́ lɛ́ tↄsiwà,","poem":1},{"lineBreak":true},{"text":"à tↄsiwà,","poem":1},{"lineBreak":true},{"text":"à kɛɛ̀ lá à kɛ̀nɛ́wa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À pↄtↄ̃naↄ míↄnzↄ̃ Babɛli ń pↄkɛkɛnaↄ.","poem":1},{"lineBreak":true},{"text":"Baade bↄlɛ tá a gbɛ̃́ↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii bàalɛ ta a bùsuu,","poem":1},{"lineBreak":true},{"text":"gbãamↄnɛdeↄ ń ń fɛ̃ndao yã́i.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Isailiↄ dɛ lán sã pↄ́ fãaaaↄwa,","poem":1},{"lineBreak":true},{"text":"nↄ̀ↄmusuↄ mɛ́ sìńgu.","poem":1},{"lineBreak":true},{"text":"Asiliↄ kía mɛ́ ń mↄmↄ káau,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Babɛli kí Nɛbukanɛza ń kɛ́ kɛ́lɛkɛlɛ gbɛzã.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ayãmɛto ma Dii Zĩgↄ̃de Isailiↄ Lua ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má Babɛli kía ń a bùsudeↄ wɛtã","poem":1},{"lineBreak":true},{"text":"lá ma Asiliↄ kía wɛtã̀waɛ,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"mí su ń Isailiↄ ń dã́dãkɛkĩi.","poem":1},{"lineBreak":true},{"text":"Aa pↄble Kaamɛli ń Basanao,","poem":1},{"lineBreak":true},{"text":"aai kã Ɛflaiũ ń Galada sĩ̀sĩↄ musu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"gↄↄ bee wa sãa wɛɛlɛ Isailiↄwa, wa eo,","poem":1},{"lineBreak":true},{"text":"wa kpálɛkɛ Yudaↄ duunai, wa bↄwào,","poem":1},{"lineBreak":true},{"text":"asa má gbɛ̃́ pↄ́ ma ń bↄ́piↄ duuna kɛ̃́máɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À lɛ́lɛ Mɛlataiũ bùsuwa,","poem":1},{"lineBreak":true},{"text":"í Pekodiↄ dɛdɛ à ń míↄnzↄ̃.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"À yã́ pↄ́ má dìlɛɛ́ kɛ píi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zĩkakↄ̃fĩ ma dↄ bùsupiu,","poem":1},{"lineBreak":true},{"text":"a wíwia zↄ̃ↄ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Masana pↄ́ dṹnia wìwi píi yãa gwa wíwia sa sↄ̃e!","poem":1},{"lineBreak":true},{"text":"Babɛlipi gↄ̃̀ sↄ̃kɛ̃ngu pↄ́ ũ bui píiɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dii baikpànɛ Babɛli,","poem":1},{"lineBreak":true},{"text":"ń a yã́ dↄ̃o, ↄ̃ à n kũ.","poem":1},{"lineBreak":true},{"text":"Wà zãmakɛ̀nɛ wà ↄdìɛma,","poem":1},{"lineBreak":true},{"text":"asa n sòlekɛ̀ ń Diioɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de a làasi zɛ́ wɛ̃̀,","poem":1},{"lineBreak":true},{"text":"à bↄ̀ ń a pↄfɛ̃ gↄ̃kɛbↄↄ,","poem":1},{"lineBreak":true},{"text":"asa a zĩ vĩ Babiloni bùsuu à gɛ́ kɛiɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"À bↄlɛ gupiiu à mↄ lɛ́lɛwà,","poem":1},{"lineBreak":true},{"text":"í a dↄ̃ↄ wɛ̃wɛ̃,","poem":1},{"lineBreak":true},{"text":"í a pↄ́ↄ kãaa zùuuzuuu,","poem":1},{"lineBreak":true},{"text":"í a míↄnzↄ̃, a kee su gↄ̃o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"À ń swanaↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"à ń kòlokpakpa!","poem":1},{"lineBreak":true},{"text":"Waiyoo ampiↄ,","poem":1},{"lineBreak":true},{"text":"asa an wɛtãgↄↄ mɛ́ kà.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À gbɛ̃́ pↄ́ bàalɛ̀ bↄ̀ Babiloni bùsuu,","poem":1},{"lineBreak":true},{"text":"aa sù Siↄnaↄ yãma, aalɛ mɛ,","poem":1},{"lineBreak":true},{"text":"Dii ń Lua tↄsìmá a kpɛ́ yã́ musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"À kàzunaↄ kãaa Babɛlizi,","poem":1},{"lineBreak":true},{"text":"sadepiↄ i bòokpa wà liai.","poem":1},{"lineBreak":true},{"text":"A gbɛ̃e su bↄo.","poem":1},{"lineBreak":true},{"text":"À fĩaboɛ̀ aà yãkɛawa,","poem":1},{"lineBreak":true},{"text":"à kɛɛ̀ lá a kɛ̀nɛ́wa píi,","poem":1},{"noteId":78},{"lineBreak":true},{"text":"asa à kuabìiaɛ,","poem":1},{"lineBreak":true},{"text":"à bã̀nkũ̀ ma Isailiↄ Lua pↄ́ ma kua adoawaɛ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"A yã́i tò a ɛ̀waasoↄ kwɛ a zɛaↄu,","poem":1},{"lineBreak":true},{"text":"a zĩgↄ̃ↄ gaga zĩbeezĩ ḿpiiɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ma, ma íbɛlɛsɛ̀nnↄ kàamaide.","poem":1},{"lineBreak":true},{"text":"Ma Dii Lua Zĩgↄ̃de mámɛ má ò,","poem":1},{"lineBreak":true},{"text":"asa gↄↄ pↄ́ má dìlɛ mà n wɛtãwà mɛ́ kà.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kàamaide a gɛ̃mbↄlɛ à lɛ́lɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e ku à ↄkaaàzio.","poem":1},{"lineBreak":true},{"text":"Má tɛsↄ̃ aà zↄ̃ɛwiaↄwaɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ liaiↄ i tɛ́kũ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"wà gbãamↄ̀ Isailiↄnɛ ń Yudaↄ píi.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ tàńnↄ zĩ̀zↄↄ ũↄ ń kũa,","poem":1},{"lineBreak":true},{"text":"aa gì ń gbaɛi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ãma an Bona gbãa vĩ,","poem":1},{"lineBreak":true},{"text":"aà tↄ́n Dii Zĩgↄ̃de.","poem":1},{"lineBreak":true},{"text":"A zɛńnↄ, i to an bùsu ĩ́ampa,","poem":1},{"lineBreak":true},{"text":"i gili gɛ̃ Babɛlideↄgu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Wa lɛ́lɛ Babiloniↄwa ń fɛ̃ndaoɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Wa lɛ́lɛ Babɛlideↄwa","poem":1},{"lineBreak":true},{"text":"ń a dↄaanaↄ ń a ↄ̃nↄnaↄ.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ ãnabi ɛgɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"wi ń dↄ̃ sↄũↄ ũ.","poem":1},{"lineBreak":true},{"text":"Wa lɛ́lɛ nɛgↄ̃naↄwa,","poem":1},{"lineBreak":true},{"text":"an nisĩna i na líwa.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ ń sↄ̃́ↄ ń ń zĩkasↄ̃goↄwa","poem":1},{"lineBreak":true},{"text":"ń bui pↄ́ lɛ́ zɛńnↄↄ,","poem":1},{"lineBreak":true},{"text":"aai gↄ̃ lán nↄɛↄwa.","poem":1},{"lineBreak":true},{"text":"Wa lɛ́lɛ ń làasiↄwa,","poem":1},{"lineBreak":true},{"text":"wí ń pↄ́ↄ naaa.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ ń swaↄwa, a í i ba,","poem":1},{"lineBreak":true},{"text":"asa tã́aↄ di ń bùsuuɛ.","poem":1},{"lineBreak":true},{"text":"Pↄvãipiↄ mɛ́ tò aa gↄ̃̀ mìsai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Gbɛ̃gbonaↄ ń maiↄ mɛ́ aaↄ kálɛa we,","poem":1},{"lineBreak":true},{"text":"koohũhũnaↄ iↄ zↄ̃zↄ̃u.","poem":1},{"lineBreak":true},{"text":"Aↄ da bɛzia ũ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we bau lↄo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Lá Lua Sↄdↄũ ń Gↄmↄↄo suumpà","poem":1},{"noteId":79},{"lineBreak":true},{"text":"ń wɛ̃́lɛ pↄ́ kú ń saɛↄ,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃e aↄ ku Babɛli lↄo, baa do.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Gwa! Zĩgↄ̃ↄ bↄ̀ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"bui zↄ̃ↄ ń ń kíaↄ fɛ̀lɛ dasidasi","poem":1},{"lineBreak":true},{"text":"za dṹnia lɛ́wa, aalɛ mↄ́.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Aa sáↄ ń sↄ̃naↄ kṹkũa,","poem":1},{"lineBreak":true},{"text":"aa pãsĩ, sósobisaideↄnɛ.","poem":1},{"lineBreak":true},{"text":"Aa di sↄ̃́ↄ kpɛ,","poem":1},{"lineBreak":true},{"text":"an kĩ́a dↄ lán ísia kↄ̃fĩwa,","poem":1},{"lineBreak":true},{"text":"aalɛ mↄ́ zĩ'ↄpooińzi, Babɛli.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Kɛ́ Babɛli kía ń bao mà,","poem":1},{"lineBreak":true},{"text":"a dↄ̃ kɛ́ yã́ gìwaɛ, ↄ̃ à gↄ̃̀ dↄ̀lↄlↄ,","poem":1},{"lineBreak":true},{"text":"wãwã aà kũ̀ lán nɛ'iwãwãwa.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Lá nↄ̀ↄmusu ì bↄ Yuudɛ̃ dàou","poem":1},{"lineBreak":true},{"text":"à gɛ́ bualoũ àizɛɛdeu,","poem":1},{"lineBreak":true},{"text":"màa má Babɛlideↄ ya","poem":1},{"lineBreak":true},{"text":"mà ń bↄlɛ ń bùsuu gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"mí gbɛ̃́ pↄ́ má sɛ̀ dilɛ we.","poem":1},{"lineBreak":true},{"text":"Démɛ muaamanↄi?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ ma la a yã́ii?","poem":1},{"lineBreak":true},{"text":"Dↄaana kpele mɛ́ a fↄ̃ zɛ gimɛɛi?","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Ayãmɛto à yã́ pↄ́ Dii zɛ̀ò","poem":1},{"lineBreak":true},{"text":"à kɛ Babɛlideↄnɛ ma","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ a dìlɛ Babiloniↄ musuo.","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄmusupi a ń nɛ́ↄ naaa taò lán sãↄwaɛ,","poem":1},{"lineBreak":true},{"text":"i ń bualoũpi dɛ̃ↄnzↄ̃ ń yã́i.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Babɛlideↄ kṹkũa kↄ̃fĩ a tↄↄlɛ lualua,","poem":1},{"lineBreak":true},{"text":"bui píi a ń wii maɛ.","poem":1}]}],"footnotes":[{"noteId":77,"caller":"+","text":"50.8 Zia 18.4","reference":{"chapter":50,"verse":8}},{"noteId":78,"caller":"+","text":"50.29 Zia 18.6","reference":{"chapter":50,"verse":29}},{"noteId":79,"caller":"+","text":"50.40 Daa 19.24-25","reference":{"chapter":50,"verse":40}}]},"thisChapterLink":"/api/bqc_sim/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}