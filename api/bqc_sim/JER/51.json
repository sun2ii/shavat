{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Ma Dii ma mɛ̀, má tó ĩ́an pↄkaalɛna fɛlɛ,","poem":1},{"lineBreak":true},{"text":"i Babɛlideↄ sɛ́lɛ ń Babiloniↄ píi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má bui zĩ̀loↄ gbaɛ Babɛliwa,","poem":1},{"lineBreak":true},{"text":"aa bↄ gupiiu,","poem":1},{"lineBreak":true},{"text":"aai lɛ́lɛwà yã́yiawagↄↄ,","poem":1},{"lineBreak":true},{"text":"aai ń fã́fã e an bùsu gↄ̃ da gii.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ásu to an kàzunaↄ ń sá kã́o,","poem":1},{"lineBreak":true},{"text":"ásu to aa ń mↄ̀ ulaↄ dao.","poem":1},{"lineBreak":true},{"text":"Ásu ń ɛ̀waasoↄ wɛ̃nagwao,","poem":1},{"lineBreak":true},{"text":"à ń zĩgↄ̃ↄ míↄnzↄ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa kwɛ gɛↄ ũ Babiloni bùsuu,","poem":1},{"lineBreak":true},{"text":"wa ń zↄ̃zↄ̃ aa lɛ́lɛ a zɛaↄu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Isailiↄ ń Yudaↄá gyaaↄ no,","poem":1},{"lineBreak":true},{"text":"Dii Zĩgↄ̃de ń Lua i pãkpańzio,","poem":1},{"lineBreak":true},{"text":"asa tàae pↄ́ wa kɛ̀ Isailiↄ Lua","poem":1},{"lineBreak":true},{"text":"pↄ́ a kua adoaɛ Babiloni bùsuu kɛ̀ zài.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À bàalɛ bↄlɛ Babɛli,","poem":1},{"lineBreak":true},{"text":"á baade i a mibↄkĩi wɛɛlɛ.","poem":1},{"lineBreak":true},{"text":"Ásu to à gaga wɛ̃́lɛpi tàae yã́io.","poem":1},{"lineBreak":true},{"text":"Dii tↄsimagↄↄ mɛ́ pìla,","poem":1},{"lineBreak":true},{"text":"a fĩabonɛ́ a zɛ́waɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Babɛli dɛ lán vua imibↄwa Dii ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"a tò dṹnia bui píi a igbɛ̃̀ kã̀.","poem":1},{"noteId":80},{"lineBreak":true},{"text":"Buiↄ a vɛ̃ɛ mì, ↄ̃ aa gↄ̃̀ mìsai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Babɛli a kwɛ́ kã́ndoɛ, i ga.","poem":1},{"lineBreak":true},{"text":"À ↄ́ↄlↄɛ̀, í ɛsɛ maɛ̀ aà bↄwa.","poem":1},{"lineBreak":true},{"text":"Wìliↄ dↄ̃o, a gí gbã́gbãia?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wa ɛsɛ màma Babɛliwa, i gbã́gbão.","poem":1},{"lineBreak":true},{"text":"Wà aà to we sa,","poem":1},{"lineBreak":true},{"text":"wá baade a taa kɛ a bùsuu,","poem":1},{"lineBreak":true},{"text":"asa aà tàae luabɛpuana lè,","poem":1},{"lineBreak":true},{"text":"à gbã̀ zↄ̃̀ luawaɛ.","poem":1},{"noteId":81}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii tò yã́ bↄ̀wanↄ na.","poem":1},{"lineBreak":true},{"text":"À mↄ wà gɛ́ yã́ pↄ́ Dii wá Lua kɛ̀ dau siuinɛ́ Siↄna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"À á kaↄ lɛ́ kɛkɛ,","poem":1},{"lineBreak":true},{"text":"í á sɛ̀ngbaoↄ sɛ́lɛ!","poem":1},{"lineBreak":true},{"text":"Dii Mɛdɛ kíaↄ sóikɛ̀ Babɛliwa,","poem":1},{"lineBreak":true},{"text":"asa à zɛ̀ ń aà kaalɛaoɛ,","poem":1},{"lineBreak":true},{"text":"i tↄsiwà a kpɛ́ yã́ musu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À dàlapoo sɛ à mipɛò Babɛli bĩ́iwa.","poem":1},{"lineBreak":true},{"text":"À zĩgↄ̃ↄ gba gbãa,","poem":1},{"lineBreak":true},{"text":"í gudↄ̃anaↄ gbaɛ aa gɛ́ ń kúkĩi!","poem":1},{"lineBreak":true},{"text":"À gbɛ̃́ↄ zɛzɛ aa bↄnsaɛ kɛnɛ́!","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ Dii zɛ̀ò a kɛɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ àlɛ yá Babɛlideↄ yã́ musupi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ń kálɛ swa zↄ̃ↄ saɛ,","poem":1},{"noteId":82},{"lineBreak":true},{"text":"àizɛɛ tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"ń beeo n ka kaalɛa sa,","poem":1},{"lineBreak":true},{"text":"n ↄvãi'ea lɛ́ kà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de sì ń azĩao à mɛ̀","poem":1},{"lineBreak":true},{"text":"má tó wà li Babɛlia lán kwaↄwa,","poem":1},{"lineBreak":true},{"text":"wi kúkua dↄwà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dii mɛ́ tↄↄlɛ kɛ̀ ń azĩa gbãao,","poem":1},{"lineBreak":true},{"text":"à dṹnia kàlɛ ń azĩa ↄ̃nↄo,","poem":1},{"lineBreak":true},{"text":"à musu kpàlɛ ń azĩa wɛzɛ̃o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó Dii pũ̀na,","poem":1},{"lineBreak":true},{"text":"í pↄ́ kú musu ì kↄ̃fĩkɛ,","poem":1},{"lineBreak":true},{"text":"ì to lou sisi za dṹnia lɛ́wa.","poem":1},{"lineBreak":true},{"text":"Dii ì bↄ ń ĩ́anao a làasiu,","poem":1},{"lineBreak":true},{"text":"ì to lou ma ń pílɛao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ sↄũ, aa yãe dↄ̃o,","poem":1},{"lineBreak":true},{"text":"siaↄ gɛɛ a gↄ̃ kpá ń wɛ́i","poem":1},{"lineBreak":true},{"text":"tã́a pↄ́ aa pìↄ yã́ musu.","poem":1},{"lineBreak":true},{"text":"Pↄ́ ɛgɛnaↄnɛ, aa wɛ̃ni vĩo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pↄ́ gianaↄnɛ, láanipↄↄnɛ,","poem":1},{"lineBreak":true},{"text":"yã́kpalɛkɛgↄↄzĩ aa midɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii pↄ́ dɛ Yakↄbu buiↄ baa ũ muaańnↄo,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃mɛ pↄ́pii kɛ̀","poem":1},{"lineBreak":true},{"text":"ń bui pↄ́ à ń sɛ́ a pↄ́ ũↄ.","poem":1},{"lineBreak":true},{"text":"Aà tↄ́n Dii Zĩgↄ̃de.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Babɛli, ń dɛ ma gbɛ̃́wiwibↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃kɛbↄn n ũ.","poem":1},{"lineBreak":true},{"text":"Mi n sɛ mà buiↄ wíwiò,","poem":1},{"lineBreak":true},{"text":"mi ń kpalaↄ midɛnnↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mi sↄ̃́ↄ ń ń dikpɛnaↄ wíwinnↄ","poem":1},{"lineBreak":true},{"text":"ń zĩkasↄ̃goↄ ń sↄ̃́godeↄ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mi gↄ̃ɛↄ ń nↄɛↄ wíwinnↄ,","poem":1},{"lineBreak":true},{"text":"nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ɛ̀waasoↄ ń wɛ̃́ndiaↄ píi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mi sãdãnaↄ ń ń sãↄ wíwinnↄ,","poem":1},{"lineBreak":true},{"text":"zↄ̃ɛↄ ń ń zù zĩkɛnaↄ,","poem":1},{"lineBreak":true},{"text":"dↄaanaↄ ń gbãadeↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Má fĩabo Babɛlideↄnɛ","poem":1},{"lineBreak":true},{"text":"ń Babiloniↄ píi á wáa","poem":1},{"lineBreak":true},{"text":"vãi pↄ́ aa kɛ̀ Siↄnaɛ yã́i.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Gbɛ̀sĩsĩ bùsudɛna,","poem":1},{"lineBreak":true},{"text":"ni dṹnia bṹu ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma fɛlɛnnↄ sa.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1},{"lineBreak":true},{"text":"Má ↄkàa kpanzi","poem":1},{"lineBreak":true},{"text":"mà n zu yãtɛ̃uɛ,","poem":1},{"lineBreak":true},{"text":"ní gↄ̃ lán gbɛ̀sĩsĩ tɛ́kũawa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wa n gbɛe sɛ kpɛdↄgbɛↄ mide ũ","poem":1},{"lineBreak":true},{"text":"ge ɛ̃daalɛgbɛ ũo,","poem":1},{"lineBreak":true},{"text":"asa ńyↄ̃ↄ dɛ bɛzia ũ gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"À gudↄkↄ̃ɛkĩi dilɛ dṹniau,","poem":1},{"lineBreak":true},{"text":"à zĩ̀ kuupɛ bùsu ń bùsuo.","poem":1},{"lineBreak":true},{"text":"À gbãbↄ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"aa gɛ́ lɛ́lɛi Babɛliwa,","poem":1},{"lineBreak":true},{"text":"Alalata kía ń Mini kíao","poem":1},{"lineBreak":true},{"text":"ń Asɛnazi kíao sóikɛwà,","poem":1},{"lineBreak":true},{"text":"í zĩgↄ̃ badeↄ dilɛ aa gɛ́ lɛ́lɛiwà,","poem":1},{"lineBreak":true},{"text":"í sↄ̃deↄ gbaɛwà lán kwasutɛ̃ↄwa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À gbãbↄ buiↄnɛ aa gɛ́wà ń zĩo,","poem":1},{"lineBreak":true},{"text":"Mɛdɛ kíaↄ ń ń dↄaanaↄ ń ń gbãadeↄ","poem":1},{"lineBreak":true},{"text":"ń bùsu pↄ́ aalɛ kiblewàↄ gbɛ̃́ↄ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dṹnia lɛ́ dee, àlɛ pelembo,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ Dii lɛ́ yá ń Babɛlio gi kuɛ.","poem":1},{"lineBreak":true},{"text":"A to Babiloni bùsu gↄ̃ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we lↄo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Babɛli nɛgↄ̃naↄ fù zĩwa,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ ye ń zɛgikĩiↄu.","poem":1},{"lineBreak":true},{"text":"An yɛ̃̀ɛɛ làa aa gↄ̃̀ lán nↄɛↄwaɛ.","poem":1},{"lineBreak":true},{"text":"Wà tɛsↄ̃̀ ń bɛↄwa,","poem":1},{"lineBreak":true},{"text":"wà ń bↄlɛ gbã́aↄ ɛ̀'ɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Zĩnaↄ lɛ́ dadakↄ̃lɛ,","poem":1},{"lineBreak":true},{"text":"baokpanaↄ tɛkↄ̃i,","poem":1},{"lineBreak":true},{"text":"aalɛ gɛ́ baokpai Babɛli kíaɛ,","poem":1},{"lineBreak":true},{"text":"aa oɛ̀ wà aà wɛ̃́lɛ bũu sìwà,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"wà swabuakĩiↄ sì,","poem":1},{"lineBreak":true},{"text":"wà tɛsↄ̃̀ dã̀naↄwa,","poem":1},{"lineBreak":true},{"text":"gili gɛ̃̀ zĩgↄ̃ↄgu píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ma Dii Zĩgↄ̃de Isailiↄ Lua ma mɛ̀","poem":1},{"lineBreak":true},{"text":"Babɛli kɛkɛgↄↄ kà,","poem":1},{"lineBreak":true},{"text":"a dɛ lán pↄ́wɛna pↄ́ wa kàlɛ zɛu,","poem":1},{"lineBreak":true},{"text":"wàlɛ go kɛɛ̀waɛ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Babɛli kí Nɛbukanɛza wá taitai,","poem":1},{"lineBreak":true},{"text":"à wá kɛ́ kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"à wá tó lán dàa giiwa.","poem":1},{"lineBreak":true},{"text":"À wá mↄmↄ lán kwãsawa,","poem":1},{"lineBreak":true},{"text":"à kã̀ pã́upãu ń wá pↄ́ maaↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ↄzↄ̃̀wázi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ mɛ̀","poem":1},{"lineBreak":true},{"text":"gbãa pↄ́ Babɛlideↄ mↄ̀nɛ́ aa ń só,","poem":1},{"lineBreak":true},{"text":"to a yã́ wí ń musu.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũdeↄ mɛ̀","poem":1},{"lineBreak":true},{"text":"ń bↄ́ↄ'i pↄ́ Babiloniↄ mì,","poem":1},{"lineBreak":true},{"text":"to aa a gbɛ'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"A yã́i ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"À ma! Má zɛánↄ, mí tↄsiɛ́.","poem":1},{"lineBreak":true},{"text":"Má tó an swada í ba,","poem":1},{"lineBreak":true},{"text":"má tó an nibↄnaↄ gↄ̃ gii.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Babɛli a gↄ̃ gbɛ̀zɛ ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃gbonaↄ tòo ũ, sↄ̃kɛ̃ngu pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"láanipↄ ũ, gbɛ̃e aↄ ku weo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Babɛlidepiↄ pũna sãnusãnu lán nↄ̀ↄmusuwa,","poem":1},{"lineBreak":true},{"text":"aa ↄ́ↄlↄ lán nↄ̀ↄmusu nɛ́ↄwa.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ an mɛ wã̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ má mↄ́nɛ́ ń í gbãao,","poem":1},{"lineBreak":true},{"text":"mí kákanɛ́, aai gↄ̃ dↄ̀ↄsai,","poem":1},{"noteId":83},{"lineBreak":true},{"text":"aaiↄ i'o vusai gↄↄpii.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Má ń pã́lɛ lán sãnɛbↄlↄ","poem":1},{"lineBreak":true},{"text":"pↄ́ wàlɛ mↄ́ ń kòlokpaiↄwa,","poem":1},{"lineBreak":true},{"text":"lán sãsakaoↄ ge blesanaↄwa.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Wa lɛ́lɛ Babɛliwaɛ fá!","poem":1},{"lineBreak":true},{"text":"Wa dṹnia wɛ̃́lɛ tↄdepi siɛ,","poem":1},{"lineBreak":true},{"text":"Babɛlipi i gↄ̃ sↄ̃kɛ̃ngu pↄ́ ũ buiↄnɛ.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ísia a da Babɛliaɛ,","poem":1},{"lineBreak":true},{"text":"a ikooa kↄ̃fĩdeↄ lɛ́lɛwà.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Aà zↄ̃ɛwiaↄ gↄ̃ bɛziaↄ ũ,","poem":1},{"lineBreak":true},{"text":"aà bùsu i gↄ̃ gbáa gii ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e aↄ ku weo, gbɛ̃e a pãao.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Má fɛlɛ ń Bɛlio Babɛli,","poem":1},{"lineBreak":true},{"text":"mí tó aà pↄ́ pↄ́ a mↄ̀mↄↄ pisipisi.","poem":1},{"lineBreak":true},{"text":"Buiↄ siu we lↄo, aà bĩ́iↄ kwɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"À bↄlɛ a guu ma gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"baade azĩa mibↄkĩi wɛɛlɛ","poem":1},{"lineBreak":true},{"text":"ma pↄkũma pãsĩ yã́i.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Tó a bùsupi baoe mà,","poem":1},{"lineBreak":true},{"text":"ásu to sↄ̃ kɛ̃́águo,","poem":1},{"lineBreak":true},{"text":"ásu to vĩa á kũo.","poem":1},{"lineBreak":true},{"text":"Yãpãsĩ a fɛlɛ bùsupiu,","poem":1},{"lineBreak":true},{"text":"kpaladeↄ fɛlɛ ń kↄ̃o.","poem":1},{"lineBreak":true},{"text":"Á yã́pi feena ma wɛ̃a,","poem":1},{"lineBreak":true},{"text":"í a feena ma zii.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Asa a gↄↄ lɛ́ mↄ́","poem":1},{"lineBreak":true},{"text":"kɛ́ má fɛlɛ ń Babɛli tã́aↄ.","poem":1},{"lineBreak":true},{"text":"A gbɛ̃́ↄ kwɛ gɛↄ ũ a guu,","poem":1},{"lineBreak":true},{"text":"bùsupideↄ gɛɛ i gↄ̃ kpá ń wɛ́i.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Luabɛdeↄ ń zĩ́lɛdeↄ gulakɛ","poem":1},{"lineBreak":true},{"text":"Babɛli yã́ musu ḿpii,","poem":1},{"noteId":84},{"lineBreak":true},{"text":"asa bùsudɛnaↄ bↄ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"aa mↄ lɛ́lɛwàɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Lá Babɛlideↄ gbɛ̃́ↄ dɛ̀dɛ dṹnia guu dasi,","poem":1},{"lineBreak":true},{"text":"Babɛlipi a wiɛ sa","poem":1},{"lineBreak":true},{"text":"Isaili pↄ́ aa ń dɛdɛↄ yã́ musu.","poem":1},{"noteId":85}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Á Isaili pↄ́ a bↄ an fɛ̃nda lɛ́zĩↄ,","poem":1},{"lineBreak":true},{"text":"à bↄ we, ásu zɛzɛ weo.","poem":1},{"lineBreak":true},{"text":"À to Dii yã́ dↄágu za zã̀zã we,","poem":1},{"lineBreak":true},{"text":"í Yelusalɛũ yãda á sↄ̃u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"Wà yã́ lìwɛ̃ɛ, ↄ̃ wí wá kṹ,","poem":1},{"lineBreak":true},{"text":"bui zĩ̀loↄ gɛ̃̀ Dii kpɛ́u e aà kúkĩi,","poem":1},{"lineBreak":true},{"text":"wá gɛɛ gↄ̃̀ kpá wá wɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Ma Dii ma mɛ̀, a gↄↄ lɛ́ mↄ́","poem":1},{"lineBreak":true},{"text":"kɛ́ má fɛlɛ ń Babɛli tã́aↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kɛ̀'ĩa Babiloni bùsu bũu guuↄ aaↄ aaukɛ.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Baa tó Babɛli gbã̀ zↄ̃̀ luawa,","poem":1},{"lineBreak":true},{"text":"mɛ́ à a bĩ́i lɛsĩ gbãa kã̀fĩ,","poem":1},{"lineBreak":true},{"text":"ma bùsudɛnaↄ gbaɛ aa gɛ lɛ́lɛwàɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Babɛlideↄ wii ma dↄ,","poem":1},{"lineBreak":true},{"text":"Babiloni bùsu wíwia zↄ̃ↄ.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Asa Dii a Babɛli dúuzↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"i to aà súu zↄ̃ↄ midɛ.","poem":1},{"lineBreak":true},{"text":"Zĩgↄ̃ↄ lɛ́lɛwà lán ikooaↄwa,","poem":1},{"lineBreak":true},{"text":"an zↄa iↄ dↄ lán isukaawa.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Bùsudɛnaↄ mↄ lɛ́lɛ Babɛliwa,","poem":1},{"lineBreak":true},{"text":"aai aà nɛgↄ̃naↄ kṹkũ,","poem":1},{"lineBreak":true},{"text":"aai ń sáↄ ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"asa ma Dii mi tↄsimá","poem":1},{"lineBreak":true},{"text":"mà fĩabonɛ́ a zɛ́waɛ.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Má íkaka aà kíaↄnɛ","poem":1},{"lineBreak":true},{"text":"ń aà ↄ̃nↄnaↄ ń aà dↄaanaↄ","poem":1},{"lineBreak":true},{"text":"ń aà gbãadeↄ ń aà nɛgↄ̃naↄ,","poem":1},{"lineBreak":true},{"text":"aaiↄ i'o vusai gↄↄpii.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀","poem":1},{"lineBreak":true},{"text":"wa aà bĩ́i gèele daaĩ,","poem":1},{"lineBreak":true},{"text":"wa tɛsↄ̃ aà bↄlɛ lɛsĩↄwa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ ì ĩada ńzĩawa pãɛ,","poem":1},{"lineBreak":true},{"text":"buiↄ isimagakpaa gbɛ a gↄ̃ tɛ́ pↄ́ ũɛ.","poem":1}]},{"type":"heading","content":["Gɛa ń Zelemii taalao Babɛli"]},{"type":"verse","number":59,"content":["Nɛlia nɛ́ Selaia, Maasea tↄũna gɛ̀ Babɛli ń Yudaↄ kí Zedekiao kíapi kpalablea wɛ̃̀ síiↄ̃de guu. Selaiapi mɛ́ kía bòokpakĩi dↄaana ũ. Yã́ pↄ́ Zelemii dàɛ̀n kɛ."]},{"type":"verse","number":60,"content":["Zelemii yãvãi pↄ́ a Babɛli lepiↄ kɛ̃̀ taala guu píi,"]},{"type":"verse","number":61,"content":["ↄ̃ a ò Selaiaɛ: Tó n ka Babɛli, wɛtã ǹ láɛ bee kyokɛnɛ́ píi,"]},{"type":"verse","number":62,"content":["ní mɛ, Dii mɛ́ ò á guɛ bee míↄnzↄ̃ɛ, gbɛ̃e ge pↄtuoe aↄ ku a guu lↄo. Aↄ da bɛzia ũ gↄↄpiiɛ."]},{"type":"verse","number":63,"content":["Tó n lápi kyokɛ̀ ń làa, ba yewà ǹ naaa ń gbɛo, ní zu Uflata guoguo,"]},{"type":"verse","number":64,"content":["ní mɛ, màa Babɛli a kpálɛ fusai",{"noteId":86},"yã́ pↄ́ Dii yìawà yã́i.",{"lineBreak":true},"Zelemii yã́ lɛ́n we."]}],"footnotes":[{"noteId":80,"caller":"+","text":"51.7 Zia 17.2-4, 18.3","reference":{"chapter":51,"verse":7}},{"noteId":81,"caller":"+","text":"51.9 Zia 18.5","reference":{"chapter":51,"verse":9}},{"noteId":82,"caller":"+","text":"51.13 Zia 17.1","reference":{"chapter":51,"verse":13}},{"noteId":83,"caller":"+","text":"51.39 Dan 5.1","reference":{"chapter":51,"verse":39}},{"noteId":84,"caller":"+","text":"51.48 Zia 18.20","reference":{"chapter":51,"verse":48}},{"noteId":85,"caller":"+","text":"51.49 Zia 18.24","reference":{"chapter":51,"verse":49}},{"noteId":86,"caller":"+","text":"51.64 Zia 18.21","reference":{"chapter":51,"verse":64}}]},"thisChapterLink":"/api/bqc_sim/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}