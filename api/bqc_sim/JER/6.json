{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":6,"content":[{"type":"heading","content":["Koezↄ̃a Yelusalɛũi"]},{"type":"verse","number":1,"content":[{"text":"Bɛ̃yãmɛɛ buiↄ, à bↄlɛ Yelusalɛũ,","poem":1},{"lineBreak":true},{"text":"í gɛ́ mikpakĩi wɛɛlɛi!","poem":1},{"lineBreak":true},{"text":"À kuupɛ Tekoa!","poem":1},{"lineBreak":true},{"text":"À to súɛlɛ fɛlɛ Bɛtakɛlɛũ seela ũ.","poem":1},{"lineBreak":true},{"text":"Kìsia lɛ́ bↄ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"kaalɛ zↄ̃ↄ looaála.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má Siↄna midɛ,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ wì mɛ a kɛfɛũ mɛ́ a maa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zĩgↄ̃ↄ mↄ bòokpa liai,","poem":1},{"lineBreak":true},{"text":"lán sãdãnaↄ ń ń sãↄwa,","poem":1},{"lineBreak":true},{"text":"baade ń a gbɛ̃́ↄ a bòou.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"À sↄukɛ wà si Siↄna ń zĩo,","poem":1},{"lineBreak":true},{"text":"à fɛlɛ wà gɛ lɛ́lɛmá ĩatɛ̃ gbãa zã́.","poem":1},{"lineBreak":true},{"text":"Agya! Ĩatɛ̃'aua pìla,","poem":1},{"lineBreak":true},{"text":"gu lɛ́ gɛ̃kↄ̃u kↄ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À fɛlɛ wà gɛ lɛ́lɛmá gwãasĩna,","poem":1},{"lineBreak":true},{"text":"wí gu pↄ́ dɛ aa zɛ giu wíwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À lizↄ̃zↄ̃,","poem":1},{"lineBreak":true},{"text":"í bùsu kálɛ Yelusalɛũ bĩ́i saɛ.","poem":1},{"lineBreak":true},{"text":"À ĩada wɛ̃́lɛpiwa,","poem":1},{"lineBreak":true},{"text":"asa gbãamↄakↄ̃ɛ mɛ́ kↄ̃̀u.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lá í ìↄ di lↄ̀ↄu,","poem":1},{"lineBreak":true},{"text":"màa yãvãi di wɛ̃́lɛpiu.","poem":1},{"lineBreak":true},{"text":"Taiina ń yãpãsĩo zↄa dↄu,","poem":1},{"lineBreak":true},{"text":"mi e aà gyã ń aà bↄo làa ziio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yelusalɛũdeↄ, à ma lɛdama ma,","poem":1},{"lineBreak":true},{"text":"kɛ́ másu kɛ̃́wáo yã́i.","poem":1},{"lineBreak":true},{"text":"Tó màan sↄ̃o, má á bùsu dɛ̃ↄnzↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku a guu lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Wa Isaili pↄ́ gↄ̃̀ↄ kↄ̃nwɛ,","poem":1},{"lineBreak":true},{"text":"lá wì vɛ̃ɛ kↄ̃nwɛwa.","poem":1},{"lineBreak":true},{"text":"Wa ɛa a gbɛsisi,","poem":1},{"lineBreak":true},{"text":"lá wì pↄ́ gbɛsisiwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dé má yã'oɛ̀ mà aà gba laaii?","poem":1},{"lineBreak":true},{"text":"Démɛ a mamɛɛi?","poem":1},{"lineBreak":true},{"text":"An swã́ wɛ̃ao, aa fↄ̃ yãmao,","poem":1},{"lineBreak":true},{"text":"Dii yã́ ì kɛnɛ́ ĩ́iɛ,","poem":1},{"lineBreak":true},{"text":"ìli káńguo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii pↄkũma dɛ̀dɛa,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ màↄ kṹkũa lↄo.","poem":1},{"lineBreak":true},{"text":"Pↄkũmapi bↄbↄ nɛ́ↄwa gãaɛ","poem":1},{"lineBreak":true},{"text":"ń ɛ̀waaso pↄ́ kãaaa gudoũↄ.","poem":1},{"lineBreak":true},{"text":"To wà gↄ̃ɛ ń a nↄo kũ sãnu","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ zikũ̀ táotaoↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"tó ma ↄ lòo bùsuɛbeedeↄla,","poem":1},{"lineBreak":true},{"text":"má ń bɛↄ na gbɛ̃pãleↄnɛ ń ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"ń ń buaↄ ń ń nↄɛↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ píi ↄvãi'enaↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ãnabiↄ ń sa'onaↄ píi aaìↄ gbɛ̃́ↄ sãsãɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aaì ɛsɛ ma ma gbɛ̃́ↄ bↄwa","poem":1},{"lineBreak":true},{"text":"lá a dɛ pↄe ũowa.","poem":1},{"lineBreak":true},{"text":"Aaì mɛ, aafia ku, aafia ku,","poem":1},{"lineBreak":true},{"text":"kási aafia ku we sↄ̃o.","poem":1},{"noteId":9}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yãbɛ̃ɛ pↄ́ aa kɛ̀ ì kɛnɛ́ wí ũe?","poem":1},{"lineBreak":true},{"text":"Aawo! Ìli kɛnɛ́ wí ũo,","poem":1},{"lineBreak":true},{"text":"an gɛɛ lí gↄ̃ kpá ń wɛ́io.","poem":1},{"lineBreak":true},{"text":"A yã́i aa ta gbɛ̃́ pↄ́ gɛ̀ gɛ́kĩiↄ guu,","poem":1},{"lineBreak":true},{"text":"aa kwɛ gↄↄ pↄ́ málɛ ĩadamá.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À zɛ zɛ́kpaau à a zɛ́ káauↄ gwa,","poem":1},{"lineBreak":true},{"text":"í a pↄ́ pↄ́ maa gbɛa àↄ bɛu,","poem":1},{"lineBreak":true},{"text":"á sↄ̃ i níni.","poem":1},{"noteId":10},{"lineBreak":true},{"text":"Ɔ̃ a mɛ̀ áↄ bɛuo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma gudↄ̃anaↄ","poem":1},{"noteId":11},{"text":"dìlɛɛ́,","poem":1},{"lineBreak":true},{"text":"má òɛ́ àli swãdↄ an kuupɛai,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a mɛ̀ á swãdↄio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ayãmɛto buipãleↄ, à yãma,","poem":1},{"lineBreak":true},{"text":"í yã́ pↄ́ a ma gbɛ̃́ↄ le dↄ̃!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dṹnia gbɛ̃́ↄ, à yãma,","poem":1},{"lineBreak":true},{"text":"málɛ mↄ́ gbɛ̃́piↄ ásookɛi.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ aalɛ yáↄ gbɛn we,","poem":1},{"lineBreak":true},{"text":"asa aai swãdↄ ma yã́io,","poem":1},{"lineBreak":true},{"text":"aa gì ma ikoyãiɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Seba tulaleti dɛmɛɛ pↄe ũo,","poem":1},{"lineBreak":true},{"text":"ge kanɛli fee gĩnana pↄ́ bↄ̀ bùsu zã̀zãu.","poem":1},{"lineBreak":true},{"text":"Mili sa pↄ́ i oa i a pↄ́ kátɛu à tɛ́kũ sio,","poem":1},{"lineBreak":true},{"text":"á sa'oaa lí kamaguo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ayãmɛto ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má gbɛ pↄ́ gbɛ̃́ↄ ì gɛ̃mbↄlɛwàↄ kálɛ gbɛ̃́piↄnɛ ń aɛ,","poem":1},{"lineBreak":true},{"text":"maeↄ ń ń nɛ́ↄ, gbɛ̃́ ń a gbɛ̃́o","poem":1},{"lineBreak":true},{"text":"aai kpákpaa ḿpii aa gaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gugbãntoo oi bùsudeↄ gwa,","poem":1},{"lineBreak":true},{"text":"aa fɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"bui zↄ̃ↄpiↄ lɛ́ bↄ za dṹnia lɛ́wa,","poem":1},{"lineBreak":true},{"text":"aalɛ mↄ́.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aa sáↄ ń sↄ̃naↄ kṹkũa,","poem":1},{"lineBreak":true},{"text":"aa pãsĩ, aali gbɛ̃e wɛ̃nagwao.","poem":1},{"lineBreak":true},{"text":"An kↄ̃fĩ ìↄ dↄ lán ísia kↄ̃fĩwa,","poem":1},{"lineBreak":true},{"text":"aa didi sↄ̃́ kpɛ, aa zĩ'ↄpòo,","poem":1},{"lineBreak":true},{"text":"aalɛ mↄ́ lɛ́lɛiwá, Siↄnadeↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Wa ń bao mà,","poem":1},{"lineBreak":true},{"text":"wá ↄ gↄ̃̀ dↄwázi.","poem":1},{"lineBreak":true},{"text":"Yã'ↄ̃ma wá kṹ gbãa,","poem":1},{"lineBreak":true},{"text":"wálɛ wãwãma lán nɛ'inawa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ásu gɛ́ buao,","poem":1},{"lineBreak":true},{"text":"ásu àↄ bɛ zɛ́uo,","poem":1},{"lineBreak":true},{"text":"asa ibɛɛↄ ń fɛ̃ndaↄ kṹkũaɛ,","poem":1},{"lineBreak":true},{"text":"vĩa pↄ́ↄ liaaázi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ, à zwã̀nkasaↄ dↄdↄ á pi,","poem":1},{"lineBreak":true},{"text":"í gbeembo túfu guu.","poem":1},{"lineBreak":true},{"text":"À ↄ́ↄlↄ lán nɛ́ mɛ̀ndona gaamáwa,","poem":1},{"lineBreak":true},{"text":"à búbuapɛ pãsĩpãsĩ,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃kaalɛna a mↄ́wá kã́ndoɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ma n dilɛ mↄ̀baasana ũɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ mɛ́ gbɛ̀ mↄde ũ.","poem":1},{"lineBreak":true},{"text":"Ǹ ń yãkɛaↄ yↄ̃, ní ń dàa dↄ̃.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Swã́yãmansaideↄnɛ ḿpii,","poem":1},{"lineBreak":true},{"text":"aaìↄ bɛbɛ wàↄ yãdↄdↄmáɛ.","poem":1},{"lineBreak":true},{"text":"Aa fèe lán mↄgotɛ̃ ge mↄsiwaɛ,","poem":1},{"lineBreak":true},{"text":"yãkpaanlakɛnaↄnɛ ḿpii.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sia lɛ́ tɛ́vu,","poem":1},{"lineBreak":true},{"text":"kɛ́ mↄ̀gbↄ̃ e láa tɛ́piu,","poem":1},{"lineBreak":true},{"text":"kási àlɛ mↄ baasa pãɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ lɛ́ kɛ̃́ gbɛ̃maawao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wì onɛ́ ã́nusu giana,","poem":1},{"lineBreak":true},{"text":"asa Dii gìńziɛ.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"6.14 Eze 13.10","reference":{"chapter":6,"verse":14}},{"noteId":10,"caller":"+","text":"6.16 Mat 11.29","reference":{"chapter":6,"verse":16}},{"noteId":11,"caller":"+","text":"6.17 Oze 9.8","reference":{"chapter":6,"verse":17}}]},"thisChapterLink":"/api/bqc_sim/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}