{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Ma Dii ma mɛ̀, gↄↄ bee wa Yuda kíaↄ gɛwa bↄlɛ miau ń a gbãadeↄ ń a sa'onaↄ ń a ãnabiↄ ń Yelusalɛũdeↄ píi."]},{"type":"verse","number":2,"content":["Wa ↄliu ĩatɛ̃i ń mↄvuao ń saana pↄ́ aa yeńzi aa zↄblènɛ́ aa tɛ̀ńzi aa yãgbɛ̀amá aa kùlɛnɛ́ↄ. Wa sɛ́lɛ vĩo, aa gↄ̃ kálɛa tↄↄlɛ lán pↄtuo gbↄ̃waɛ."]},{"type":"verse","number":3,"content":["Gu pↄ́ má ↄzↄ̃u bui vãipizi píi, an gbɛ̃́ pↄ́ gↄ̃̀piↄ ga sí ń kuawaɛ. Ma Dii Zĩgↄ̃de mámɛ má ò."]},{"type":"heading","content":["Duuna ń yã́ pↄ́ ì inɛ́o"]},{"type":"verse","number":4,"content":[{"text":"Onɛ́ ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃́ lɛ̀lɛ, ìli fɛlɛo lé?","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃́ zã̀ zɛ́wa, ìli ɛao lé?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bↄ́yãi Yelusalɛũdeↄ ì zãmɛɛ yã́wai?","poem":1},{"lineBreak":true},{"text":"Àkɛa gbɛ̃́piↄ mikpɛ ìↄ dↄamɛɛi?","poem":1},{"lineBreak":true},{"text":"Mↄafili ↄ̃ aa zɛ̀ò, aa gì suia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma swãkpà má mà,","poem":1},{"lineBreak":true},{"text":"aali yã́zɛde oo,","poem":1},{"lineBreak":true},{"text":"mɛ́ an gbɛ̃e líↄ ku déndↄ̃mɛɛ guu","poem":1},{"lineBreak":true},{"text":"à mɛ: Bↄ́yãi ma vãiɛ taa kɛ̀o.","poem":1},{"lineBreak":true},{"text":"Ampii aaì tɛ́ ń tufaiɛ,","poem":1},{"lineBreak":true},{"text":"lán sↄ̃́ pↄ́ lɛ́ si zĩlauwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa wàaliana ì fɛlɛ a gↄↄwaɛ,","poem":1},{"lineBreak":true},{"text":"felena ń luakibãnao ń yaabɛɛo","poem":1},{"lineBreak":true},{"text":"aaìↄ gↄↄ pↄ́ dɛ wa ɛa suwà dↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"kási ma gbɛ̃́ↄ ma yãdilɛnɛ dↄ̃o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kpelewa á e o ↄ̃nↄnaↄn á ũ,","poem":1},{"lineBreak":true},{"text":"ámɛ á Dii ikoyã kũai?","poem":1},{"lineBreak":true},{"text":"Yãdanɛde ɛgɛnaↄ a bↄↄlɛkɛ̀ɛ́ kpaanlaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wí a ↄ̃nↄnapiↄ kũɛ,","poem":1},{"lineBreak":true},{"text":"aa bílikɛ, aai zu bai guu.","poem":1},{"lineBreak":true},{"text":"Aa gì ma yã́iɛ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄ kpeletaa buin wei?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A yã́i má ń nↄɛↄ kpa gbɛ̃pãleↄwa,","poem":1},{"lineBreak":true},{"text":"an buaↄ i gↄ̃ dãↄnɛ.","poem":1},{"lineBreak":true},{"text":"Nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ píi ↄvãi'enaↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ãnabiↄ ń sa'onaↄá gbɛ̃sãsãnaↄnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì ɛsɛ má ma gbɛ̃́ↄ bↄwa,","poem":1},{"lineBreak":true},{"text":"lá a dɛ pↄe ũowa.","poem":1},{"lineBreak":true},{"text":"Aaì mɛ, aafia ku, aafia ku,","poem":1},{"lineBreak":true},{"text":"kási aafia ku we sↄ̃o.","poem":1},{"noteId":17}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yãbɛ̃ɛ pↄ́ aa kɛ̀ ì kɛnɛ́ wí ũe?","poem":1},{"lineBreak":true},{"text":"Aawo, ìli kɛnɛ́ wí ũo,","poem":1},{"lineBreak":true},{"text":"an gɛɛ lí gↄ̃ kpá ń wɛ́io.","poem":1},{"lineBreak":true},{"text":"A yã́i aa ta gbɛ̃́ pↄ́ gɛ̀ gɛ́kĩiↄ guu,","poem":1},{"lineBreak":true},{"text":"aa kwɛ gↄↄ pↄ́ málɛ ĩadamá.","poem":1},{"lineBreak":true},{"text":"Má Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má ń buapↄ́ↄ símáɛ.","poem":1},{"lineBreak":true},{"text":"Vɛ̃ɛ a kɛo,","poem":1},{"lineBreak":true},{"text":"kaadↄɛna a nɛ'io,","poem":1},{"noteId":18},{"lineBreak":true},{"text":"baa lá a giigaga.","poem":1},{"lineBreak":true},{"text":"Wa pↄ́ pↄ́ má kpàmáↄ símá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bↄ́yãi wá kálɛa lai?","poem":1},{"lineBreak":true},{"text":"Wà kãaa wà ta wɛ̃́lɛ bĩ́ideↄu,","poem":1},{"lineBreak":true},{"text":"wíↄ ga dã we,","poem":1},{"lineBreak":true},{"text":"asa Dii wá Lua dìlɛ wà gagaɛ.","poem":1},{"lineBreak":true},{"text":"À kona í kpàwá wà mi,","poem":1},{"lineBreak":true},{"text":"kɛ́ wa duunakɛ̀ɛ yã́i.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wá wɛ́ dↄ aafiai,","poem":1},{"lineBreak":true},{"text":"kási yãmaae kuo.","poem":1},{"lineBreak":true},{"text":"Wa gbã́gbãgↄↄ dã̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wá nisĩna nà líwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sↄ̃́ↄ lɛ́ pↄbↄ ń níu Dã buiↄ bùsuu,","poem":1},{"lineBreak":true},{"text":"bùsupi lɛ́ lualua sↄ̃saↄ ↄ́ↄlↄa yã́i.","poem":1},{"lineBreak":true},{"text":"Wà mↄ̀ bùsu ↄ̃̀ↄkpai ń pↄ́ pↄ́ kúuↄ,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ ń gbɛ̃́ pↄ́ aa ku a guuↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má mlɛ̃̀ pãsĩnaↄ gbaɛwá aa á sósoɛ,","poem":1},{"lineBreak":true},{"text":"mlɛ̃piↄ lí ɛsɛdeↄ yãmao.","poem":1},{"lineBreak":true},{"text":"Má Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ma Gbɛ̃nↄsɛninina, ma pↄ siakũ̀,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ ↄ̃̀ↄkpà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ wii ma dↄ","poem":1},{"lineBreak":true},{"text":"za bùsu zã̀zãu aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Dii ku Siↄnao lé?","poem":1},{"lineBreak":true},{"text":"Siↄna Kíapi ku we lↄo lé?","poem":1},{"lineBreak":true},{"text":"Bↄ́mɛ tò aa ma pↄ fɛ̀lɛmɛɛ ń ń tã́aↄi?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi aa ma zafɛ̃̀mɛɛ ń dii zĩ̀lo pãↄi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wà pↄ́ kɛ̀kɛ kↄ̀, saɛ gɛ̃̀,","poem":1},{"lineBreak":true},{"text":"wápiↄ sↄ̃, wi wá suabao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lá ma gbɛ̃́ↄ wíwia, màa má wíwia,","poem":1},{"lineBreak":true},{"text":"ma oosìsi, iwãa kà ma pↄa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bↄ̀ ɛsɛ ku Galada bùsuuo lé?","poem":1},{"lineBreak":true},{"text":"Lòotoo ku weo lé?","poem":1},{"lineBreak":true},{"text":"Àkɛa ma gbɛ̃́ↄ bↄ i láao ni?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tó ma miá íɛ yãa,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma wɛ́á nibↄnaɛ lé,","poem":1},{"lineBreak":true},{"text":"dↄ̃ má wɛ́'i lɛ́ kwɛ́ fãanɛ ń gwãasĩnao","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ pↄ́ wa ń dɛdɛↄ yã́ musu.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"8.11 Eze 13.10","reference":{"chapter":8,"verse":11}},{"noteId":18,"caller":"+","text":"8.13 Mat 21.19","reference":{"chapter":8,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}