{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JER","translationId":"bqc_sim","name":"Zelemii","commonName":"Zelemii","title":"ZELEMII","order":24,"numberOfChapters":52,"sha256":"3823c9ee3cf59f1a972fe9c5838ed31b2c740377262b2d27c5a9c1f28b47ebed","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/bqc_sim/JER/52.json","totalNumberOfVerses":1360},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Tó má pilakĩi vĩ gbáau yãaɛ lé,","poem":1},{"lineBreak":true},{"text":"má a gbɛ̃́ↄ to we mà gɛ́ weɛ,","poem":1},{"lineBreak":true},{"text":"asa gbãsĩkɛnaↄnɛ ḿpii,","poem":1},{"lineBreak":true},{"text":"náaisaideↄ gãliɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aaì lɛ́sakã aa ɛgɛ zuò,","poem":1},{"lineBreak":true},{"text":"aaliↄ gbãa ń bùsuu ń náaiyãoo.","poem":1},{"lineBreak":true},{"text":"Aaìↄ vãikɛ wàↄ gɛɛ, aa ma dↄ̃o.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Á baade laaika a gbɛ̃nai,","poem":1},{"lineBreak":true},{"text":"ásu à a daɛ náaikɛo,","poem":1},{"lineBreak":true},{"text":"asa daɛ píiá gbɛ̃sãsãnaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃naↄ ì kↄ̃ peɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃na ń gbɛ̃nao aaì ↄ̃nↄkɛkↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"aali sĩana'okↄ̃ɛo.","poem":1},{"lineBreak":true},{"text":"An lɛ́ dↄ́ɛkɛ̀ ń ɛɛo,","poem":1},{"lineBreak":true},{"text":"aaì tàaekɛkↄ̃ɛ e wà kpàsa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń kú mↄafilideↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"mↄafilipi mɛ́ tò aa gì ma dↄ̃i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yã́i tò ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má ń baasa mà gwaɛ.","poem":1},{"lineBreak":true},{"text":"Bↄ́ má kɛ ma gbɛ̃́ↄnɛ","poem":1},{"lineBreak":true},{"text":"an vãipi yã́ musu lↄi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An lɛ́naá kagbaɛ,","poem":1},{"lineBreak":true},{"text":"mↄafili mɛ́ ìↄ dↄ ń lɛ́u.","poem":1},{"lineBreak":true},{"text":"Na'onwaaↄnɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ yaalↄma ba da ń bↄ̀ↄuↄnɛ.","poem":1},{"noteId":19}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã́ bee yã́i má ĩadamáo lé?","poem":1},{"lineBreak":true},{"text":"Má tↄsi buipi taawao lé?","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Má ↄ́ↄlↄ mà búbuapɛ sĩ̀sĩↄnɛ,","poem":1},{"lineBreak":true},{"text":"má wɛ̃nalɛ si dã́dãkɛkĩiↄnɛ.","poem":1},{"lineBreak":true},{"text":"À sɛ̃kù, gbɛ̃e lɛ́ a baa vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"wìli zù ↄↄlↄ ma we lↄo.","poem":1},{"lineBreak":true},{"text":"Bãↄ ń nↄ̀bↄↄ gɛ̃̀zɛa píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Má tó Yelusalɛũ gↄ̃ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃gbonaↄ tòo ũ.","poem":1},{"lineBreak":true},{"text":"Mí Yuda bùsu wɛ̃́lɛↄ dɛ̃ↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e aↄ ku we lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dé ↄ̃nↄ mɛ́ kà yã́pi gbadↄ̃ai?","poem":1},{"lineBreak":true},{"text":"Dé Dii yãdàɛ̀ aà a bↄↄlɛkɛi?","poem":1},{"lineBreak":true},{"text":"Àkɛa bùsu gↄ̃̀ gii lán gbáawa,","poem":1},{"lineBreak":true},{"text":"à gà, gbɛ̃e lɛ́ a baa vĩ lↄo ni?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa pãkpà ma ikoyã pↄ́ má dìlɛnɛ́i yã́iɛ,","poem":1},{"lineBreak":true},{"text":"aai ma yã́pi mao, aai zĩkɛwào.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"An swã́gbãa mɛ́ dↄ̀aanɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa tɛ tã́aↄzi lá ń maeↄ dànɛ́wa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A yã́i ma Dii Zĩgↄ̃de Isailiↄ Lua ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má gↄ̃i kpámá aa soɛ,","poem":1},{"lineBreak":true},{"text":"mí kona í kpámá aa mi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má ń fãaa buiↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ ampiↄ ń ń maeↄ dↄ̃ yãaoↄ.","poem":1},{"lineBreak":true},{"text":"Mí tó wà pɛ́má ń fɛ̃ndao","poem":1},{"lineBreak":true},{"text":"e wà gɛ̀ ń mìdɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"À yã́pi da,","poem":1},{"lineBreak":true},{"text":"í gɛ nↄɛ gɛ'ↄↄlↄnaↄ sísi,","poem":1},{"lineBreak":true},{"text":"í gbɛ̃́ↄ zĩ nↄɛ wɛ̃nalɛdↄ̃naↄwa aa mↄ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aai mↄ búbuapɛɛ́,","poem":1},{"lineBreak":true},{"text":"á wɛ́ i ibↄ e à kwɛ́.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wà ↄↄlↄ mà dↄ Siↄna, wàlɛ mɛ,","poem":1},{"lineBreak":true},{"text":"wa ↄ̃̀ↄkpàɛ fá, wí wá kṹ maamaaɛ.","poem":1},{"lineBreak":true},{"text":"Wálɛ wá bùsu to we,","poem":1},{"lineBreak":true},{"text":"asa wà wá uaↄ dúuzↄ̃̀ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nↄɛↄ, à Dii yãma sa,","poem":1},{"lineBreak":true},{"text":"à swã́kpa yã́ pↄ́ lɛ́ bↄ aà lɛ́ui.","poem":1},{"lineBreak":true},{"text":"À ↄↄlↄ dada á nɛnↄɛↄnɛ,","poem":1},{"lineBreak":true},{"text":"í wɛ̃nalɛ dadakↄ̃ɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Asa gaga gɛ̃̀ wá fɛnɛntiↄuɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à sì wá zɛgikĩiↄu.","poem":1},{"lineBreak":true},{"text":"Gapi wá nɛ́ↄ dɛ̀dɛ zɛaↄ guu,","poem":1},{"lineBreak":true},{"text":"à wá ɛ̀waasoↄ mìdɛ gãaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Onɛ́ ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩn gɛↄ gↄ̃ kpálɛ sɛ̃u lán pↄtuo gbↄ̃wa,","poem":1},{"lineBreak":true},{"text":"lán ése pↄ́ wa kɛ̃̀ kálɛa gbɛ̃e i mↄ sɛ́lɛowa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄna su ĩ́anadã a ↄ̃nↄyã musuo,","poem":1},{"lineBreak":true},{"text":"gↄ̃gbãa su yↄ̃̀ↄkɛ a gↄ̃sakɛ yã́io,","poem":1},{"lineBreak":true},{"text":"ↄde su azĩa sɛ lɛsĩ a ↄda yã́io.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ ye ĩ́anadã,","poem":1},{"lineBreak":true},{"text":"aà dã kɛ́ a wɛ́ kɛ̃̀ a ma dↄ̃ yã́i.","poem":1},{"noteId":20},{"lineBreak":true},{"text":"A dↄ̃ kɛ́ má gbɛ̃kɛ vĩ,","poem":1},{"lineBreak":true},{"text":"mi yãmaakɛ dṹniau a zɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"asa yã́ beeↄ mɛ́ ì kamagu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mamɛ má ò.","poem":1}]},{"type":"verse","number":24,"content":["Ma Dii ma mɛ̀ a gↄↄ a mↄ́ kɛ́ má ĩada gbɛ̃́ pↄ́ aa tↄ̃zↄ̃̀ↄwa,"]},{"type":"verse","number":25,"content":["Egipiↄ ń Yudaↄ ń Ɛdↄũↄ ń Amↄniↄ ń Mↄabuↄ ń gbɛ̃́ pↄ́ aa ku guwaiwaiu aaì ń kã̀kãmↄ kɛ̃ɛlɛↄ.",{"noteId":21},"Asa buipiↄ ń Isailiↄ píi, gyafↄↄdeↄnɛ ń sↄ̃u."]}],"footnotes":[{"noteId":19,"caller":"+","text":"9.7 Soũ 28.3","reference":{"chapter":9,"verse":7}},{"noteId":20,"caller":"+","text":"9.23 1Kln 1.31, 2Kln 2.17","reference":{"chapter":9,"verse":23}},{"noteId":21,"caller":"+","text":"9.25 Lev 19.27","reference":{"chapter":9,"verse":25}}]},"thisChapterLink":"/api/bqc_sim/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":25}