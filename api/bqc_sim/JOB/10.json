{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":10,"content":[{"type":"heading","content":["Ma dɛa yã́i Lua tò wà ma ii"]},{"type":"verse","number":1,"content":["Ma kpasa ń ma wɛ̃nio,",{"text":"má yã́ pↄ́ má kũa o sa.","poem":1},{"lineBreak":true},{"text":"Pↄsia guu má yãbↄlɛ sa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má o Luaɛ: Ńsu yãdamalao.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ ń èa omɛɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbãamↄa mapi n ↄgbɛɛ kàngu yã̀?","poem":1},{"lineBreak":true},{"text":"N bↄ ma kpɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n zɛ ń gbɛ̃vãiↄ lɛkpaaĩaoa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wá wɛ́ doũ yã̀?","poem":1},{"lineBreak":true},{"text":"Gudoũ ni e ń gbɛ̃nazĩnaoa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N wɛ̃ni geseũ lán wá pↄ́wa yã̀?","poem":1},{"lineBreak":true},{"text":"N kua muaa ń wá gbɛ̃nazĩnaↄ yã̀?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lá ń dↄ̃̀ tàaeden ma ũo,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃e ku aà ma bↄ n ↄzĩo,","poem":1},{"lineBreak":true},{"text":"a yã́i n kpálɛkɛ̀ ma yãvãiↄi,","poem":1},{"lineBreak":true},{"text":"n ma duuna tàasikàa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N ma ikàsa ń nzĩa ↄo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ńyↄ̃ ɛa ǹ ma tↄ̀lↄzↄ̃ saa?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛ́ n ma kɛ ń bɛ̀lɛo, a yã́ dↄngu.","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ ɛa ǹ ma kɛ bùsuti ũ lↄ yã̀?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ni ma kása nↄ'itɛ̃na ũ lán vĩ'ipuwao lé?","poem":1},{"lineBreak":true},{"text":"Ni to ma i lán vĩ iawao lé?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N báa ń bàasio dàmala,","poem":1},{"lineBreak":true},{"text":"n ma wáↄ pɛ̀pɛkↄ̃wa ń kĩↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N gbɛ̃kɛ guu n ma gba wɛ̃ni,","poem":1},{"lineBreak":true},{"text":"n ma dↄ̃a, n ↄkù ma nisĩnala.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma n làasoo dↄ̃̀ sa,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ulɛa n sↄ̃un kɛ:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó ma duunakɛ̀, niↄ wɛ́tɛmazi,","poem":1},{"lineBreak":true},{"text":"nili tó ma bↄ pã ma tàaeↄ yã́ musuo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waiyoo mapi, tó tàaeden ma ũ.","poem":1},{"lineBreak":true},{"text":"Baa tó ma yã́ na, má fↄ̃ mida íao,","poem":1},{"lineBreak":true},{"text":"asa wí ma kũ, taasi ma kũ gbãa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ma su midà ía,","poem":1},{"lineBreak":true},{"text":"ni lↄↄlɛmazi lán nↄ̀ↄmusuwa,","poem":1},{"lineBreak":true},{"text":"ní ɛa ǹ n gbãa bↄnsaɛ mↄmɛɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ní ma kpakↄ̃a ń seelade pãleↄ,","poem":1},{"lineBreak":true},{"text":"n pↄfɛ̃amazi i kã́fĩ,","poem":1},{"lineBreak":true},{"text":"ní tó yã'ĩa ma le mↄ̀ↄmↄↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bↄ́yãi n ma bↄ ma da gbɛɛui?","poem":1},{"lineBreak":true},{"text":"A maa yãa mà kɛsaiɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ gbɛ̃e su wɛsimalɛo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A maa màↄ ku yãao.","poem":1},{"lineBreak":true},{"text":"A maa yãa ma bↄa nɛasakpɛu","poem":1},{"lineBreak":true},{"text":"wàↄ ma da mia'ɛu gↄ̃̀ↄɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gↄↄ yↄↄna pↄ́ gↄ̃̀mɛɛ a láa tia.","poem":1},{"lineBreak":true},{"text":"Gomala, ma pↄ e kɛ na, baa yↄↄ","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"e màↄ gɛ́ gɛ́i gɛ́kĩi,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ gugɛ̃akↄ̃u ń gusiao kuu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gupi sì níinii lán gwã́wa,","poem":1},{"lineBreak":true},{"text":"pↄe ku we zɛ́zɛo,","poem":1},{"lineBreak":true},{"text":"wɛɛdo mɛ́ a fãanɛ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}