{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":11,"content":[{"type":"heading","content":["Nↄ̀sɛwɛ̃ Luaɛ!"]},{"type":"verse","number":1,"content":["Ɔ̃ Naama gbɛ̃́ Zofaa yãsɛ̀ à mɛ̀:"]},{"type":"verse","number":2,"content":["Aà yã́ dasi, wá wewào lé?",{"text":"Yãbↄlɛnapi a bↄ maa yã̀?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yãpã oa a gbɛ̃́ↄ lɛ́ kũa?","poem":1},{"lineBreak":true},{"text":"N yãyaaabↄ̀lɛ, ↄ̃ wa zↄadↄmaoa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N mɛ̀ n yãdanɛ sãa vĩo,","poem":1},{"lineBreak":true},{"text":"ń kú Luaɛ tàaesai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó Lua yã'ò lé,","poem":1},{"lineBreak":true},{"text":"a n ɛɛboɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A ↄ̃nↄ asii bↄↄlɛkɛnɛ,","poem":1},{"lineBreak":true},{"text":"asa Lua ↄ̃nↄ zↄ̃ↄ dɛwála.","poem":1},{"lineBreak":true},{"text":"Ń dↄ̃ Lua lɛ́ ĩadama n vãi lɛ́u nɛe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ńyↄ̃ fↄ̃ ǹ Lua asii dↄ̃a?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ bↄ Gbãapiide zↄ̃ↄkɛ lɛ́wae?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A lɛsĩ dɛ luabɛa, ńyↄ̃ kɛ kpelewa ni?","poem":1},{"lineBreak":true},{"text":"A zã dɛ bɛdaa, ńyↄ̃ fↄ̃ ǹ dↄ̃e?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A zↄ̃ↄ dɛ tↄↄlɛa, a lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"a yàasa dɛ ísiaa maamaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó à mↄ̀ gbɛ̃́ kũ̀ a dàkpɛu,","poem":1},{"lineBreak":true},{"text":"mɛ́ àlɛ yã́kpalɛkɛaànↄ,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ gii?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A mↄafilideↄ dↄ̃ fá!","poem":1},{"lineBreak":true},{"text":"Tó à vãikɛa è, ìli a yãdao lé?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lá zàa'ĩna lí nɛ'i gbɛ̃nazĩna ũo,","poem":1},{"lineBreak":true},{"text":"màa nↄ̀sɛsaide lí ↄ̃nↄkũo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tó n n nↄ̀sɛ wɛ̃̀ Luaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n ↄsɛ̀ musu wabikɛa guu,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"tó n nzĩa gà duunaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ yãvãi i zↄ̃lɛkĩi e n bɛo,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"n mi aↄ daa ía sãasaiɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ zɛdↄ vĩasai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N taasi yã́ i sãngu,","poem":1},{"lineBreak":true},{"text":"a dↄangu iↄ dɛ lán í gɛ̃a zɛ́awa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N kua i tɛkɛ dɛ fãanɛ ĩatɛ̃a,","poem":1},{"lineBreak":true},{"text":"gusia pↄ́ ń kúu i pu lán gudↄawa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N sↄ̃ aↄ dilɛa, n nↄ̀sɛ iↄ daa doũ,","poem":1},{"lineBreak":true},{"text":"n laai aↄ kpalɛa, níↄ i'o ń a nao kau.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ↄli nzĩau,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e yã́ a iwãa ka n pↄao,","poem":1},{"lineBreak":true},{"text":"baade a wɛɛlɛ àↄ nannↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ yiongo lɛ́baa dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"aa bↄkĩi eo, yã́ pↄ́ gↄ̃̀nɛ́ mɛ́ ga ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}