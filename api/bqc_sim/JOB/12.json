{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":12,"content":[{"type":"heading","content":["Lua mɛ́ gbãa vĩ"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu yãsɛ̀ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Sĩanaɛ, ámɛ a maa gbɛ̃́ↄnɛ sa lá!","poem":1},{"lineBreak":true},{"text":"Ɔ̃ álɛ e tó a ga, ↄ̃nↄ mìdɛn we.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ má nↄ̀sɛ vĩ lááwaɛ,","poem":1},{"lineBreak":true},{"text":"má kɛ̃́sãaázio,","poem":1},{"lineBreak":true},{"text":"démɛ a fu yã́ pↄ́ álɛ oↄwai?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ ma lɛzù Luazi a wèa,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ pↄ́ yáalↄa ũ ma gbɛ̃naↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ ma yã́ na mɛ́ má tàae vĩo,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ pↄ́ yáalↄa ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa ku niɛniɛↄ","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ pↄ́ músi ń léↄ gwa pãɛ,","poem":1},{"lineBreak":true},{"text":"aaì saka gbɛ̃́ pↄ́ kpàguaↄgu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃blenaↄ sↄ̃ aaìↄ zↄ̃lɛa ń bɛ ń laaiwa,","poem":1},{"lineBreak":true},{"text":"lualɛwɛna pↄ́ an gbãa dɛ ń lua ũpiↄ ìↄ ku dↄdↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À gɛ nↄ̀bↄↄ la, aai yãdaɛ́,","poem":1},{"lineBreak":true},{"text":"à gbɛa bãↄwa, aai oɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À yã'o ń tↄↄlɛo, i ↄ̃nↄ daɛ́,","poem":1},{"lineBreak":true},{"text":"à to kpↄↄ sɛ́lɛ siuɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pↄ́piↄ píi, an kpele mɛ́ gí dↄ̃i","poem":1},{"lineBreak":true},{"text":"kɛ́ Lua mɛ́ pↄ́pii kɛ̀ ń a gbãaoi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pↄ́pii wɛ̃ni ku aà ↄzĩɛ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́pii nisĩnao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá lɛ́na ì pↄ́ í dↄ̃,","poem":1},{"lineBreak":true},{"text":"màa swã́ ì yã́ dↄ̃kↄ̃ɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ ziↄ mɛ́ ↄ̃nↄ vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ wɛ̃ kɛ̀ↄ wɛ́ mɛ́ zɛ̃a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɔ̃nↄ ń gbãaoá Lua pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"lɛdama ń wɛzɛ̃o ì bↄ aà kĩ́iɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì pↄ́ gboo, wìli fↄ̃ kɛ̀kɛo,","poem":1},{"lineBreak":true},{"text":"ì zɛtańlɛ, wìli fↄ̃ wɛ̃̀o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì lou zɛ, gu i giigaga,","poem":1},{"lineBreak":true},{"text":"ì to loupↄↄ fↄ̃, tↄↄlɛ i foofↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aàpi mɛ́ iko vĩ ń dɛnlao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃sãsãnaↄ ń gbɛ̃́ sã́sãaↄ ku aà ↄzĩ ḿpiiɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ì to lɛdamadeↄ ta kyalesai,","poem":1},{"lineBreak":true},{"text":"ì to yã́kpalɛkɛnaↄ gↄ̃ mìsaideↄ ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ì gala pↄ́ kíaↄ kpà gbɛ̃́ↄnɛ polo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì bɛlɛona ye kíapiↄnɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ì to sa'onaↄ ta kyalesai,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ pↄ́ an zĩ́na pɛ̀lɛↄ fuangba.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ì to náaideↄ lɛ́ gↄ̃ kpaaũa,","poem":1},{"lineBreak":true},{"text":"ì yã́zɛdↄ̃a si maezↄ̃ↄↄwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ì saikɛ kpalablenaↄwa,","poem":1},{"lineBreak":true},{"text":"ì nɛgↄ̃naↄ gↄ̃kɛbↄↄ polomá.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ì asiiyã pↄ́ kú gusiau biiwànɛ́,","poem":1},{"lineBreak":true},{"text":"ì bↄ ń yã́ pↄ́ wa a gbadↄ̃oo gupuau.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ì to buiↄ tↄbↄ, ↄ̃ ì ń midɛ,","poem":1},{"lineBreak":true},{"text":"ì to aa ligua, ↄ̃ ì ń fãaa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ì to dṹnia dↄaanaↄ gↄ̃ mìsai,","poem":1},{"lineBreak":true},{"text":"ì to aa sã́sã gugii zɛsaideu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aaìↄ ↄmalɛmalɛ gusiau filiasai,","poem":1},{"lineBreak":true},{"text":"aaìↄ tàlaatalaabo lán idɛnaↄwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}