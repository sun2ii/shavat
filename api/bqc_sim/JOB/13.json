{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":13,"content":[{"type":"heading","content":["Yobu ye yã'o ń Luao"]},{"type":"verse","number":1,"content":[{"text":"Ma wɛ́ yã́piↄ è píi,","poem":1},{"lineBreak":true},{"text":"ma swã́ mà ↄ̃ má dↄ̃̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lá á dↄ̃a vĩ, màa má dↄ̃a vĩ sↄ̃,","poem":1},{"lineBreak":true},{"text":"i kɛ má kɛ̃́sãaázi no.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ãma Gbãapiide ↄ̃ má ye mà yã'oɛ̀ sa,","poem":1},{"lineBreak":true},{"text":"má ye gɛ́ ń ma yã́o Luawaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ápiↄ sↄ̃ i ɛɛ liamazi,","poem":1},{"lineBreak":true},{"text":"gyãegwan giaↄn á ũ ápii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó á lɛ́ kpaaũa yãa lé,","poem":1},{"lineBreak":true},{"text":"wa á dilɛ ↄ̃nↄnaↄ ũɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ma yã́zɛ ma,","poem":1},{"lineBreak":true},{"text":"à swã́sɛ ma yã́zãsiawái.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yã́zɛsai ↄ̃ á o Lua gɛ̃ɛ ũa?","poem":1},{"lineBreak":true},{"text":"Sã́sãyã ↄ̃ á o Lua gbɛua?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Á yãnakpa Luawa yã̀?","poem":1},{"lineBreak":true},{"text":"Á yã́siaànↄ yã̀?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó à wɛtɛ̀ á yã́i, a bↄánↄ nae?","poem":1},{"lineBreak":true},{"text":"Á dↄ́ɛwà lá wì dↄ́ɛ gbɛ̃nazĩnawawa yã̀?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó álɛ yãnakpawà a gbadↄ̃sai,","poem":1},{"lineBreak":true},{"text":"a á swã́gagaɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà zↄ̃ↄkɛ a kã̀adaálao lé?","poem":1},{"lineBreak":true},{"text":"Vĩakɛaɛ̀ a tↄ̃́wáo lé?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á yã'onɛↄá túfuɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a giiyèoaá pɛ̀lɛaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"À nílɛmɛɛ mà yã'o,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a ma le aà ma le.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bↄ́yãi má azĩa pa swaai?","poem":1},{"lineBreak":true},{"text":"Máↄ a wɛ̃ni naa ma ↄzĩ yã̀?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gwa, a ye ma dɛɛ, ma wɛ́ dↄ pↄei lↄo.","poem":1},{"lineBreak":true},{"text":"Ń beeo má gí ń mazĩao aà aɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bee a ma bↄ,","poem":1},{"lineBreak":true},{"text":"asa aà yãdansaiↄ we mↄ zɛ aà aɛo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À laaidↄ ma yã́wa maamaa,","poem":1},{"lineBreak":true},{"text":"à swã́sɛmazi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma yã́ pↄ́ má o zɛ́ kàlɛ,","poem":1},{"lineBreak":true},{"text":"má dↄ̃ kɛ́ ma yã́ naɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ bↄbↄmanↄi?","poem":1},{"lineBreak":true},{"text":"Tó wa fↄ̃, má nílɛɛ, mí ga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lua, yã́ mɛ̀n plaɛ beeↄ kɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"má ulɛnɛo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹ n ↄ goa,","poem":1},{"lineBreak":true},{"text":"ńsu to iwãakampↄa kã̀adamalao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bee gbɛa lɛzumazi, mí mↄ́,","poem":1},{"lineBreak":true},{"text":"ma gba zɛ́ mà yã'o, ní yã́zãsia.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma yãvãiↄ ń ma tàaeↄ kà ũmai?","poem":1},{"lineBreak":true},{"text":"To mà a tàae ń ma duunao dↄ̃.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Àkɛa ńlɛ nzĩa ulɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"ńlɛ ma dilɛ n ibɛɛ ũi?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lakɛɛ pↄ́ lɛ́ ĩ́ansɛ ↄ̃ ń ye wíwia?","poem":1},{"lineBreak":true},{"text":"Sɛ̃̀ gii ↄ̃ ń ye ɛ́'ɛa?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ni yã́'ĩikpaa,","poem":1},{"lineBreak":true},{"text":"ni ma ɛ̀waasogↄↄ duuna wi ma musu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ni ma daliu,","poem":1},{"lineBreak":true},{"text":"ni ma táa'oa lɛ́ damɛɛ,","poem":1},{"lineBreak":true},{"text":"ni wɛ́tɛ ma yãvãiↄi píi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma gↄ̃ lán pↄ́ vlãa pↄ́ lì àlɛ lɛ́lɛlɛlɛwa,","poem":1},{"lineBreak":true},{"text":"lán pↄkasa pↄ́ blɛↄ lɛ́ blewa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}