{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":14,"content":[{"type":"heading","content":["Gbɛ̃nazĩna kua wɛ̃naũ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃nazĩna ì bↄ nↄɛ kĩ́iɛ,","poem":1},{"lineBreak":true},{"text":"aà wɛ̃ni kuluũ, ìliↄ ku yãkelesaio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ì pia lán lávuwa, ì giigaga,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃zɛa lán uenawa, ìli gɛ̃gɛ̃o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ bee taa ↄ̃ ńyↄ̃ wɛdↄɛ̀","poem":1},{"lineBreak":true},{"text":"ǹ yã́kpalɛkɛaànↄa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ gbãlɛa a fↄ̃ nɛ́ gbãlɛsai io,","poem":1},{"lineBreak":true},{"text":"baa do.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N gbɛ̃nazĩna gↄↄ dìlɛɛ̀,","poem":1},{"lineBreak":true},{"text":"aà mↄ dasilɛ dɛ n yã́ ũɛ,","poem":1},{"lineBreak":true},{"text":"n aà wɛ̃ lɛ́ dàɛ̀, a fↄ̃ vĩao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wɛwowà ǹ aà to we,","poem":1},{"lineBreak":true},{"text":"e aà gↄↄ pa lán gbɛ̀winawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baa lí ì saasɛ,","poem":1},{"lineBreak":true},{"text":"asa tó wa zↄ̃̀, ì ɛa vlãpaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a vlã̀ dafupi lí golɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa tó a zĩ́na zikũ̀ tↄↄlɛ guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ a miↄna gà tɛ̃́ɛnau,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tó à í gĩmà, a bↄlɛɛ,","poem":1},{"lineBreak":true},{"text":"a gↄ̃nakɛ̃ lán lí pↄ́ wa bàwaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ gà sↄ̃, ìↄ wúlɛa tèlele,","poem":1},{"lineBreak":true},{"text":"ì tá, ìliↄ ku lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá ísida'i ì lao,","poem":1},{"lineBreak":true},{"text":"mɛ́ swa'i ì ba à gɛ̃zɛa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"màa gbɛ̃nazĩna ì wúlɛ, ìli fɛlɛ lↄo.","poem":1},{"lineBreak":true},{"text":"E luabɛ gɛ àↄ kuo, a vuo,","poem":1},{"lineBreak":true},{"text":"a vu ń ipioo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ma ulɛ bɛdauo lé?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ ↄkumala e n pↄ wèeao lé?","poem":1},{"lineBreak":true},{"text":"Gↄↄ dilɛmɛɛ we, ma yã́ i gbasa dↄngu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tó gbɛ̃́ gà, a ɛa àↄ kua?","poem":1},{"lineBreak":true},{"text":"Tó màaɛ, ma wɛ́ aↄ dↄ ma vuai","poem":1},{"lineBreak":true},{"text":"ma dɛ̃ɛkaa guu gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ lɛzumazi, mí wema,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ n pↄkɛa ea nidɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tia ńlɛ wɛ́tɛ ma yãkɛaↄi,","poem":1},{"lineBreak":true},{"text":"gↄↄ bee ńyↄ̃ ma duuna yãda lↄo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ma tàaeↄ ka bↄ̀ↄu, ní ye ǹ dilɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ kã́n'ↄ lɛ́ ma vãikɛapiↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lá gbɛ̀sĩsĩ ì gboo à yↄ́ↄlɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ sĩ̀sĩ musu gbɛ̀ gbɛ̃̀nɛ ì sↄ̃,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"lá swa'i ì gbɛ yↄↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ í ì bùsu sɛ́lɛ taò,","poem":1},{"lineBreak":true},{"text":"màa ni to tãmaa gbɛ̃nazĩna nɛ́.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ni gbãamↄɛ̀, ↄ̃ ì tá, ìli su lↄo,","poem":1},{"lineBreak":true},{"text":"ni to aà ã́nuato, aà wɛ́ ì lilɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tó aà nɛ́ↄ gↄ̃̀ gbɛ̃́ gbiaↄ ũ, a mao,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃́ yãfũnaↄnɛ sↄ̃, aↄ dↄ̃o.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wãwã ↄ̃ aↄ ma ado,","poem":1},{"lineBreak":true},{"text":"aàzĩa ↄ́ ↄ̃ aↄ dↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}