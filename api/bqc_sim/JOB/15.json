{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":15,"content":[{"type":"heading","content":["Vãikɛna lí bↄ pão"]},{"type":"verse","number":1,"content":["Ɔ̃ Temani gbɛ̃́ Ɛlifaza wèwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Ɔ̃nↄna a yãpã gii bee taa oa?","poem":1},{"lineBreak":true},{"text":"A lɛ́ ɛlɛ yã́ↄ bↄlɛwà yã̀?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A lɛkpaakɛ yã́ àisai musua?","poem":1},{"lineBreak":true},{"text":"A yã́ kã́fĩasai oa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpi sↄ̃ ńlɛ vĩakɛa Luaɛ bãdɛ sa,","poem":1},{"lineBreak":true},{"text":"ńlɛ kpá gbɛ̃́ↄnɛ aa làasookɛwà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vãi pↄ́ ń kũa mɛ́ dↄ n lɛ́u,","poem":1},{"lineBreak":true},{"text":"kↄ̃nide lɛ́ mɛ́ dↄma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N lɛ́ mɛ́ n dayãu, i kɛ mámɛo,","poem":1},{"lineBreak":true},{"text":"n lɛ́ mɛ́ n kalikɛ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gbɛ̃nazĩn sɛ̃́ian n ũa?","poem":1},{"lineBreak":true},{"text":"Wà n i e wàↄ gɛ́ gbɛ̀sĩsĩↄ kɛia?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N Lua lɛkpaaĩa ń a gbɛ̃́ↄ màa?","poem":1},{"lineBreak":true},{"text":"Ḿmɛ ń ↄ̃nↄ vĩ ndoa?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yã́ kpele ń dↄ̃ mɛ́ wá dↄ̃o ni?","poem":1},{"lineBreak":true},{"text":"N wɛzɛ̃ dɛwála yã̀?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃zↄ̃ↄↄ ń mikãpuadeↄ kúwanↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an zↄ̃ↄ dɛ n maelaↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lua ye n nↄ̀sɛ níninɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à kɛ̀nɛ fɛ̃́nɛũa?","poem":1},{"lineBreak":true},{"text":"Wálɛ yã'onɛ busɛbusɛo lé?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bↄ́mɛ n sↄ̃ blèi?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ńlɛ wá gwa ń wɛpãsĩoi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N pↄ paa Luazi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ yã́ dasi ì bↄlɛ n lɛ́u.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bↄ́n gbɛ̃nazĩna ũ kɛ́ àↄ ku gbãlɛsaii?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ nↄɛ aà ì aↄ maaa?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lá Lua ì a malaikaↄ náaikɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà bɛ i kɛɛ̀ gbãlɛsaio,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"wa gbɛ̃nazĩna pↄ́ o lↄe?","poem":1},{"lineBreak":true},{"text":"A bɛ̃̀ɛ, a ↄ̃̀ↄkpaa, ì yãvãi mi lán íwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Má yã'onɛ, swã́sɛi!","poem":1},{"lineBreak":true},{"text":"Má yã́ pↄ́ ma swã́ mà sɛ́lɛ mà siunɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄnaↄ mɛ́ bↄ̀ ń yã́pio,","poem":1},{"lineBreak":true},{"text":"aai yã́ pↄ́ an deziↄ ò kee ulɛwɛ̃ɛo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aamɛ ń bùsu vĩ ńtɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"zĩ̀loe i zↄ̃lɛ ń guuo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ìↄ ku dɛ̃ɛu e a wɛ̃ni lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pãsĩ gↄↄ lɛ́ kuɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kↄ̃fĩ iwãakampↄade ìↄ dↄ aà swã́u,","poem":1},{"lineBreak":true},{"text":"aà aafia gↄↄ gbãamↄnɛdeↄ ì lɛ́lɛwà.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A ɛa bↄa gusiau náai vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"dɛa ń fɛ̃ndao mɛ́ lɛ́ aà dã́.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ìↄ liaaliaa, ìↄ mɛ blɛ ku má ni?","poem":1},{"lineBreak":true},{"text":"A dↄ̃ kɛ́ a kua bɛda gusiau kãikũ̀.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Taasi ń yeelɛao ìↄ aà vĩakũ,","poem":1},{"lineBreak":true},{"text":"a daaàla lán kía pↄ́ a lɛ́lɛama sↄu màwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Asa à ↄsɛ̀ Luaziɛ,","poem":1},{"lineBreak":true},{"text":"à kuabìi Gbãapiidewaɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"À sùwà ń waakĩba bↄbↄawào","poem":1},{"lineBreak":true},{"text":"ń a sɛ̀ngbao gèele kↄdeo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Baa kɛ́ aà oa nísi bↄa,","poem":1},{"lineBreak":true},{"text":"mɛ́ a mɛkpaa, aà gbↄ̃u lɛ̀ɛlɛ,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"a zↄ̃lɛ uazĩ pↄ́ wìli gɛ̃uoↄ guu,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ wa wì, a kpɛ́ↄ gↄ̃̀ wɛ̀ɛwɛɛↄu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aà àizɛɛ a gↄↄplakɛo,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ ↄde ũo,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ a vĩoↄ ligua lↄo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"A e bↄ gusiauo,","poem":1},{"lineBreak":true},{"text":"tɛ́lɛpiↄ a aà vlãpaa sãsã,","poem":1},{"lineBreak":true},{"text":"Lua lɛ́'ĩana i aà sɛ gɛò zɛ́a.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Asu pↄ́ gia náaikɛ à azĩa sã́são,","poem":1},{"lineBreak":true},{"text":"asa pↄ́ gia mɛ́ aↄ aà asea ũ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yã́pi a aà le e aà gↄↄ àↄ gɛ́ pai,","poem":1},{"lineBreak":true},{"text":"aà gↄ̃naↄ e ↄtao.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"A gↄ̃ lán kuli pↄ́ a vú wòlowaɛ,","poem":1},{"lineBreak":true},{"text":"lán vɛ̃ɛli pↄ́ a nɛsoena wòlowa.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Luayãdansaiↄ gãli a báaa kɛo,","poem":1},{"lineBreak":true},{"text":"tɛ́ a kũ gbagusaɛdanaↄ kpɛ́wa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Aaì yãkele nↄsi, aaì nɛ'i yã'ĩa ũ,","poem":1},{"lineBreak":true},{"text":"mↄafili mɛ́ ì bↄ ń nɛasakpɛu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}