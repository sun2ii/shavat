{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":16,"content":[{"type":"heading","content":["Má seelade vĩ luabɛ"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Ma yã́ bee taa mà à dasikũ̀,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄsɛnininaↄn á ũ wea?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Á zɛ á lɛ́'ĩanagbaaɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Bↄ́ yã́ mɛ́ lɛ́ ↄ̃wá, ↄ̃ álɛ yã́zãsiai?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ámɛ á kú ma kuawa yãa,","poem":1},{"lineBreak":true},{"text":"má yã'o lááwa sↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"mí á dɛ ń yã'oo,","poem":1},{"lineBreak":true},{"text":"mí a mi kɛɛ́ déũdeũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kási ma yã́ a á gbãa kã́fĩɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"ma lɛdama a á nↄ̀sɛ níniɛ́ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tó málɛ yã'o, ma wãwã a láao,","poem":1},{"lineBreak":true},{"text":"tó má nílɛ sↄ̃, a kpálɛe?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lua, ń tò ma gↄ̃ gbãasai sa,","poem":1},{"lineBreak":true},{"text":"n ma gbɛ̃́ↄ dɛ̃ↄnzↄ̃ píi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń tò ma gↄ̃ yooyea seela ũ,","poem":1},{"lineBreak":true},{"text":"ma ibabaa gↄ̃̀mɛɛ seela bɛ̃̀ɛ ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua ì fɛlɛmanↄ ń pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"ì ma zↄ̃ɛzↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ a swaa lↄlↄmɛɛkↄ̃wa,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛpi ì wɛbiibiia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wì lɛ́'ɛ'ɛa, wì yãzↄ̃zↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"wì ma sãnkɛkɛ, wì fɛlɛmanↄ píi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lua ma na faasaideↄnɛ ń ↄzĩ,","poem":1},{"lineBreak":true},{"text":"à ma zu gbɛ̃vãiↄ ↄu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma a kuanankɛ kílikiliɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à mↄ̀ yãyìaa.","poem":1},{"lineBreak":true},{"text":"À ma kũ ma waa kpɛ","poem":1},{"lineBreak":true},{"text":"à ma pã pↄ́wa,","poem":1},{"lineBreak":true},{"text":"à ma kɛ a pↄdɛa ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aà kàzunaↄ lìamazi,","poem":1},{"lineBreak":true},{"text":"à ma papaò ma pↄawa ma wɛ̃nagwasai,","poem":1},{"lineBreak":true},{"text":"ma sɛtɛ̃na wì, a í lɛ́ fã́ɛ tↄↄlɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ìↄ pũnaa ń pↄkũmao mↄ̀ↄmↄↄ,","poem":1},{"lineBreak":true},{"text":"ì sↄ̃́ daa lá nɛgↄ̃na ì kɛwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ma zwã̀nkasaↄ nàminami má kàkamala,","poem":1},{"lineBreak":true},{"text":"ma a mi sↄ̀lↄ bùsuu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma ↄ́ↄlↄ̀ e ma wɛ́ wò,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ tà loũloũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kási ma ↄ ku yãpãsĩe guuo,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma wabikɛa Luawa mↄafili vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bùsu, ńsu ka ma auao,","poem":1},{"lineBreak":true},{"text":"ma wii su kpálɛo.","poem":1},{"noteId":12}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa tia má seelade vĩ luabɛ,","poem":1},{"lineBreak":true},{"text":"ma zɛnnↄde ku musu we.","poem":1},{"noteId":13}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃napi mɛ́ ma kↄ́ↄ ũ","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ málɛ wɛ́'i bↄ Luaɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A zɛmanↄ Lua aɛ,","poem":1},{"lineBreak":true},{"text":"lá gbɛ̃́ ì zɛ ń a gbɛ̃naowa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa ma gɛa gɛ́kĩi wɛ̃ i gↄ̃ bílao,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ wìli gɛ́u wà sù lↄopi.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"16.18 Daa 4.10","reference":{"chapter":16,"verse":18}},{"noteId":13,"caller":"+","text":"16.19 Yob 19.25","reference":{"chapter":16,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}