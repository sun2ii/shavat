{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":17,"content":[{"type":"heading","content":["Yobu wɛ́ dↄ pↄei lↄo"]},{"type":"verse","number":1,"content":[{"text":"Ma nisĩna lɛ́ gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"ma gↄↄ lɛ́ mↄ pai,","poem":1},{"lineBreak":true},{"text":"mia'ɛ lɛ́ ma dã́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́laanikɛnaↄ kálɛmazi,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ ì ma lɛwɛnapiↄ e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lua, ǹyↄ̃ dɛ ma kↄ́ↄ ũ.","poem":1},{"lineBreak":true},{"text":"N bàasio, démɛ a zɛmanↄi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lá ń tò aa gↄ̃̀ nↄ̀sɛsaideↄ ũ,","poem":1},{"lineBreak":true},{"text":"ńsu to aa tidↄmalao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì a gbɛ̃na kpámá pↄ́ yã́i,","poem":1},{"lineBreak":true},{"text":"aà nɛ́ↄ wɛ́ aↄ dↄ pↄ́i e an wɛ́ woɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lua tò gbɛ̃́ↄ yãadàmanↄ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ gbɛ̃́ pↄ́ wì lɛ́'ikakawà ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pↄsia tò ma wɛ́ lɛ́ gu'e lↄo,","poem":1},{"lineBreak":true},{"text":"ma guↄ gↄ̃̀ záazaannↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma yã́ dì gbɛ̃maaↄwa,","poem":1},{"lineBreak":true},{"text":"tàaesaideↄ nↄ̀sɛ fɛ̀lɛ luayãmansaiↄ yã́ musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa a gɛ àↄ kú ń a yãkɛaↄ,","poem":1},{"lineBreak":true},{"text":"yãesaide gbãa aↄ dɛdɛɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ápiↄ sↄ̃ à ɛa na yã́wa lↄ ápii,","poem":1},{"lineBreak":true},{"text":"mi á gbɛ̃e e ↄ̃nↄna ũo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ma gↄↄ pà,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ma a zɛ́ kàlɛ kɛ̀ fama,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ma pↄ dↄmápiↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aaìↄ e gwãasĩnaá fãanɛɛ,","poem":1},{"lineBreak":true},{"text":"tó gu lɛ́ gɛ̃kↄ̃u,","poem":1},{"lineBreak":true},{"text":"aaì mɛ guwɛ lɛ́ kɛ̃ɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó bɛda ↄ̃ ma wɛ́ dↄi,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma a pɛ kpàlɛ gusiau,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"tó má ò mia'ɛ mɛ́ ma de ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ má ò kↄ̀ↄↄ mɛ́ ma da ń ma dãeↄ ũ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"bↄ́ ma wɛ́ aↄ dↄi lↄi?","poem":1},{"lineBreak":true},{"text":"Wa ma e ń gweao lↄi?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tãmaa aↄ ma nɛ e bɛdau nɛe?","poem":1},{"lineBreak":true},{"text":"Wá si tɛ̃́ɛnau sãnu yã̀?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}