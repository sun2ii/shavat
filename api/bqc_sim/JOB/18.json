{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":18,"content":[{"type":"heading","content":["Bai ì vãikɛna kṹ"]},{"type":"verse","number":1,"content":["Ɔ̃ Sua gbɛ̃́ Bilidada yã́zãsìwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Ńyↄ̃ n yã́ midɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Su n laaiwa, wí gbasa faaibo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ńlɛ wá gwa lán pↄtuoↄwai?","poem":1},{"lineBreak":true},{"text":"N wá dílɛ sↄũↄ ũ yã̀?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ ni to n pↄfɛ̃ nzĩa taitaiɛ,","poem":1},{"lineBreak":true},{"text":"dṹnia a gↄ̃ bɛzia ũ n yã́i nɛe?","poem":1},{"lineBreak":true},{"text":"Gbɛsi a sↄ̃ n yã́ musu nɛe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gbɛ̃vãi gupua ì láa,","poem":1},{"lineBreak":true},{"text":"aà tɛ́vua ì midɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aà kpɛ́ gupua ì li gusia ũ,","poem":1},{"lineBreak":true},{"text":"filia pↄ́ kú aà saɛ ì ga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aà táa'oa ń sↄ̃o dilɛa ì gↄ̃ sea tá ũ,","poem":1},{"lineBreak":true},{"text":"aà yã́zɛkalɛa ì aà fuangba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aà tá ì aà kpa baia,","poem":1},{"lineBreak":true},{"text":"aà gbá ì si balɛtãu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mↄ ì aà kũ a kɛ̀sɛwoũ lɛ́u,","poem":1},{"lineBreak":true},{"text":"baipi ì kúlɛwà búlu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ba kpaa aà aɛ tↄↄlɛu,","poem":1},{"lineBreak":true},{"text":"kúsɛ lɛ́ aà dã a táa'ozɛu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kìsia ì koezↄ̃aàzi,","poem":1},{"lineBreak":true},{"text":"àlɛ aà gbɛsɛlɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nↄana ì aà gbãa kↄ'ɛ,","poem":1},{"lineBreak":true},{"text":"músi ìↄ aà kpaa gua dã́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì aà mɛ̀ gueↄ ble,","poem":1},{"lineBreak":true},{"text":"gagyã ì aà mɛguↄ yↄ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wì aà ga wà bↄ kpɛ́ pↄ́ a kuu aafiau,","poem":1},{"lineBreak":true},{"text":"wì aà gálɛ gɛò pↄ́ pↄ́ ì to vĩa ń kṹↄ mideɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aà kpɛ́ gↄ̃̀ gii,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃gbↄ̃ lì aà uaa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aà zĩ́naↄ i giigaga tíu,","poem":1},{"lineBreak":true},{"text":"aà gↄ̃naↄ i imi musu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aà yã́ i sã́ńgu dṹniau,","poem":1},{"lineBreak":true},{"text":"aà tↄ́ i midɛ tↄↄlɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wi aà ya gupuau wà aà kpa gusiau,","poem":1},{"lineBreak":true},{"text":"wi ↄzↄ̃aàzi aà ã́nuato.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A nɛ́ ge buie to a gbɛ̃́ↄ guuo,","poem":1},{"lineBreak":true},{"text":"aà bɛ gbɛ̃e a bↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ aà lè dì bɛ'aɛdeↄwa,","poem":1},{"lineBreak":true},{"text":"gukpɛdeↄ kãsì aà yã́ musu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ì faasaide ua len we,","poem":1},{"lineBreak":true},{"text":"luadↄ̃nsai gwean we.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}