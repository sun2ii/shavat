{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":19,"content":[{"type":"heading","content":["Ma mìsina a mↄ gbɛzã"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu wèwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"E gↄↄ ũma áↄ ĩadaa","poem":1},{"lineBreak":true},{"text":"àↄ ma nↄ̀sɛ ↄ̃̀ↄkpamɛɛi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ma sↄ̃sↄ̃ à kɛ̀ gɛ̃n kwi sa,","poem":1},{"lineBreak":true},{"text":"i ma taiinkɛ, wí lí á kũo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ma sãsã sĩana,","poem":1},{"lineBreak":true},{"text":"ma tàae dɛ mazĩa yã́ ũɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó a gi lɛ́ ázĩa maabo dɛmala,","poem":1},{"lineBreak":true},{"text":"mɛ́ álɛ ma duuna kamɛɛ ma ↄzĩ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"àↄ dↄ̃ kɛ́ Lua mɛ́ ma yã́ fuangba,","poem":1},{"lineBreak":true},{"text":"à filifilimbakpàmɛɛ à ma kũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mi a taiinakɛa ↄ́ↄlↄ, gbɛ̃e lí weao,","poem":1},{"lineBreak":true},{"text":"mi suaba wiilɛ, yã́zɛde kuo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua zɛzↄ̃̀mɛɛ, dↄikĩi kuo,","poem":1},{"lineBreak":true},{"text":"à gusia dà ma zɛ́a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À ma kpɛbↄ̀,","poem":1},{"lineBreak":true},{"text":"à ma fùa gò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì ma dɛɛlɛmpa gupiiu e mà láa,","poem":1},{"lineBreak":true},{"text":"ì to tãmaa ma nɛ lán lí bilɛawa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì a pↄkũmabↄbↄa,","poem":1},{"lineBreak":true},{"text":"ì ma gwa a ibɛɛↄ do ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aà zĩgↄ̃ↄ ì sↄ̃mazi sãnu,","poem":1},{"lineBreak":true},{"text":"aaì koezↄ̃mazi, aaì bòokpa lia ma kpɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"A tò ma gbɛ̃́ↄ lí kãaamanↄ lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ma dↄ̃ↄ lɛzↄ̃ tàmalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma daɛↄ fùa,","poem":1},{"lineBreak":true},{"text":"ma yã́ sã̀ ma gbɛ̃naↄgu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ nibↄ ũ ma bɛ zĩkɛnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃nɛ́ lán bui zĩ̀lowa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ma a ziia sìsi, ìli wea lↄo,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ ma awakpàɛ̀, à bↄ̀ ma lɛ́wa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma lɛ́'ĩana ì kɛ ma naɛ gbↄ̃ↄ gĩ ũɛ,","poem":1},{"lineBreak":true},{"text":"ma vĩ̀iↄ ń ma dãunaↄ yemazi lↄo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa nɛgↄ̃ɛnaↄ ì sakamagu,","poem":1},{"lineBreak":true},{"text":"tó málɛ mↄ́, aaìↄ ma kɛ pↄ́ↄpↄↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma kpàasiaↄ ye ma gĩyãio,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ yenzideↄ bↄ̀ ma kpɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ wá ń báao ũ,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ lɛɛ mà gaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À ma wɛ̃nagwa ma gbɛ̃naↄ,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃nagwa, asa Lua ↄtↄ̃̀aɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bↄ́yãi i pɛ́lɛmazi lán Luawai?","poem":1},{"lineBreak":true},{"text":"Ili kpasa ń ma kɛ̃́kɛ̃akↄ̃ɛoa?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Má ye wà ma yã́ↄ kɛ̃́,","poem":1},{"lineBreak":true},{"text":"má ye wà dalau.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wà kɛ̃ gbɛwa ń lákɛ̃bↄo,","poem":1},{"lineBreak":true},{"text":"wi bɛↄma kpálɛu àↄ ku gↄↄpii.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mapi, má dↄ̃ kɛ́ ma mìsina ku,","poem":1},{"lineBreak":true},{"text":"a fɛlɛ zɛ tↄↄlɛ gbɛzã.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma bↄa sↄuɛ bee gbɛa,","poem":1},{"lineBreak":true},{"text":"má wɛsi Lualɛ mɛsai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Má wɛsiaàlɛ mazĩa,","poem":1},{"lineBreak":true},{"text":"mazĩa wɛ́ɛ, i kɛ gbɛ̃pãle no.","poem":1},{"lineBreak":true},{"text":"Málɛ a nidɛ ma nↄ̀sɛ guu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A mɛ̀ kpelewa á kɛ à kãaamazi,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e yã́pi sã́asã ma ma lɛ́u.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À vĩakɛ fɛ̃ndaɛ.","poem":1},{"lineBreak":true},{"text":"Lua a pↄkũmabↄbↄò vãikɛnaↄwaɛ,","poem":1},{"lineBreak":true},{"text":"í dↄ̃ kɛ́ yã́kpalɛ lɛ́ á dã́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}