{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":20,"content":[{"type":"heading","content":["Vãikɛna ì yã'ↄ̃ma e"]},{"type":"verse","number":1,"content":["Ɔ̃ Naama gbɛ̃́ Zofaa yã́zãsìwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Yã́ pↄ́ ń ò ↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"ma mɛ wã̀ mà wema.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma lele n ma kpɛbↄ̀,","poem":1},{"lineBreak":true},{"text":"má wema ma wɛzɛ̃ guu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń dↄ̃ lá a dɛ za zio lé?","poem":1},{"lineBreak":true},{"text":"Za gↄↄ pↄ́ Lua gbɛ̃nazĩna kɛ̀ dṹniau,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"vãikɛna kúkuakɛa lí gɛ̃gɛ̃o,","poem":1},{"lineBreak":true},{"text":"luayãdansai pↄnakɛaá gↄↄpla yã́ɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baa tó aà ĩ́andãa zↄ̃̀ luawa,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà mi kã̀ luabɛpuanawa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"a gɛ̃zɛa lá azĩa bĩ́ikpɛwaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa aà è yãaↄ mɛ:","poem":1},{"lineBreak":true},{"text":"A ku má ni?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A sãalɛ lán nanawa, wa aà e lↄo,","poem":1},{"lineBreak":true},{"text":"a gɛ̃lɛ lán wɛ́pungu'eawaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wɛsìaàlɛ yãaↄ aà e lↄo,","poem":1},{"lineBreak":true},{"text":"aà bɛdeↄ aà wɛ́pa lↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ awakpa taasideↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai aà àizɛɛ sↄaanɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà ɛ̀waasogↄↄ gbãa pↄ́ a vĩ yãa","poem":1},{"lineBreak":true},{"text":"a gɛ̃aànↄ tɛ̃́ɛnau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Baa kɛ́ yãvãi ìↄ na aà lɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ìↄ ulɛa aà lɛ́na zíɛ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"baa kɛ́ à gì ↄkpaii,","poem":1},{"lineBreak":true},{"text":"mɛ́ ìↄ dↄ aà lɛ́u,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"blɛ pↄ́ a blè a li aà nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"i gↄ̃ aà mɛu mlɛ̃̀ sɛwɛ ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A blɛ níside pↄ́ a gbɛ̃̀ pisi,","poem":1},{"lineBreak":true},{"text":"Lua mɛ́ a to à bↄlɛ aà gbɛɛu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ àlɛ mi a gↄ̃ɛ̀ mlɛ̃̀ sɛwɛ ũ,","poem":1},{"lineBreak":true},{"text":"i aà dɛ lán sↄ̀gbala swaawa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zↄ́ ń vĩfãaio aↄ diaàzi lán íwa","poem":1},{"lineBreak":true},{"text":"lá aà wɛ́ dↄiwao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A pↄ́ pↄ́ á sìmáↄ sↄaanɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"a e pↄnakɛ ń a laata'aioo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Asa à gbãamↄ̀ taasideↄnɛ à ń tó giiɛ,","poem":1},{"lineBreak":true},{"text":"à ń kpɛ́ↄ sìmá, ↄ̃mɛ dↄ̀ sↄ̃o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aà yea pↄ́i lí to à ĩ́ampakĩi èo,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ aà pↄ dↄwàpiↄ lí aà bↄo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À pↄ́pii è, pↄe kpɛ́ lↄo,","poem":1},{"lineBreak":true},{"text":"ń beeo aà nama a la ń lao leo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aà pↄdekɛ guu a gↄ̃ yooyeaɛ,","poem":1},{"lineBreak":true},{"text":"ń aà ↄniɛkɛo taasi a ↄgbagoɛ̀ɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ à kã̀ a làa,","poem":1},{"lineBreak":true},{"text":"Lua a pↄkũmabↄbↄwà pãsĩpãsĩ,","poem":1},{"lineBreak":true},{"text":"a wɛ́tɛ̃amↄɛ̀, i dↄ̃ a mɛwa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Baa kɛ́ à bàalɛ̀ mↄsi gↄ̃kɛbↄɛ,","poem":1},{"lineBreak":true},{"text":"mↄgotɛ̃ ka mɛ́ a aà pá.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A kapi wo a kpɛsɛa,","poem":1},{"lineBreak":true},{"text":"i kà lɛ́ tɛkɛapi wo a pↄawa,","poem":1},{"lineBreak":true},{"text":"ga vĩa i aà kṹ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gusia yã́ i aà àizɛɛ le,","poem":1},{"lineBreak":true},{"text":"tɛ́ pↄ́ gbɛ̃e mɛ́ kào i kũwà,","poem":1},{"lineBreak":true},{"text":"tɛ́pi i pↄ́ pↄ́ gↄ̃̀ aà kpɛ́uↄ sãsã.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Luabɛdeↄ aa aà tàaeↄ bↄ gupuau,","poem":1},{"lineBreak":true},{"text":"zĩ́lɛdeↄ bↄ aà kpɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aà bɛpↄↄ gusikɛ píi,","poem":1},{"lineBreak":true},{"text":"aa gɛ̃lɛ luapↄkũmagↄↄ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Fĩa pↄ́ Lua a boɛ̀n we,","poem":1},{"lineBreak":true},{"text":"baa pↄ́ gbɛ̃vãi ì e Lua kĩ́in we.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}