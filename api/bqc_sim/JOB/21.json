{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":21,"content":[{"type":"heading","content":["Vãikɛna ì namable"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"À swã́kpa à ma yãma,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a ma nↄ̀sɛ nínimɛɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À mɛnakɛmɛɛ mà yã'o,","poem":1},{"lineBreak":true},{"text":"ma yã'oa gbɛa í ma àlafiikɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kɛ gbɛ̃nazĩna málɛ zↄakaio.","poem":1},{"lineBreak":true},{"text":"Ma pↄyaa zɛvĩo lé?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À ma gwa, yã́pi i diwá,","poem":1},{"lineBreak":true},{"text":"í ↄku á lɛ́wa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó ma làasookɛ̀ ma yã́wa,","poem":1},{"lineBreak":true},{"text":"gili ì gɛ̃magu, mi lualua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Àkɛa vãikɛnaↄ ìↄ ku,","poem":1},{"lineBreak":true},{"text":"aaì zi kṹ, an gbãa ìↄ kã́fĩi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"An nɛ́ↄ ì zĩ́napɛlɛ ń wáa,","poem":1},{"lineBreak":true},{"text":"aaì wɛsi ń buiↄ gbãakũalɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"An bɛdeↄ ìↄ ku aafia,","poem":1},{"lineBreak":true},{"text":"vĩa lí ń kũo, Lua lí gotↄ̃máo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"An gáaeↄ ì ku zudaↄwa, aali fuao,","poem":1},{"lineBreak":true},{"text":"an zudapiↄ lí nↄbↄlɛo, aaì nɛ'i.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì ń nɛ́ↄ gbaɛ kↄ̃̀ↄ'oi lán sã kpàsawa,","poem":1},{"lineBreak":true},{"text":"an nɛ́fɛ̃nɛnaↄ ì vĩvĩ lán blenɛↄwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aaì lɛsi ń gã̀ao ń mↄↄnao,","poem":1},{"lineBreak":true},{"text":"aaì kↄ̃̀ↄ'o ń kulɛpɛao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aaì zikũ ń namao,","poem":1},{"lineBreak":true},{"text":"aaì ta bɛdau niɛniɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kási aaì o Luaɛ: Gowála,","poem":1},{"lineBreak":true},{"text":"wá ye wàↄ bɛ n zɛ́uo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Démɛ Gbãapiide ũ wà zↄbleɛ̀i?","poem":1},{"lineBreak":true},{"text":"Tó wa kulɛkɛ̀ɛ̀, bↄ́ ài wá ei?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kási an nama lɛ́ bↄ ń kĩ́io.","poem":1},{"lineBreak":true},{"text":"A yã́i mi gbɛ̃vãiↄ lɛdama bee sio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ filia ì gamá mↄ̀ↄmↄↄe?","poem":1},{"lineBreak":true},{"text":"Lua pↄkũma lí tó músi ń lé dasio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ĩana ì ń sɛ́lɛ lán ése ṹawae?","poem":1},{"lineBreak":true},{"text":"Zàa'ĩana ì ń waa lán sɛ̃wae?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lua ì vãi pↄ́ gbɛ̃́ kɛ̀ wi aà nɛ́ↄ musuɛ.","poem":1},{"lineBreak":true},{"text":"Lua fĩabo adeɛ gↄ̃̀ↄ, aà dↄ̃!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aà wɛsi azĩa ↄ̃̀ↄkpaalɛ!","poem":1},{"lineBreak":true},{"text":"Gbãapiide pↄkũma imibↄ dↄɛ̀ aà mi!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ a aà bɛdeↄ le aà gaa gbɛa,","poem":1},{"lineBreak":true},{"text":"ìli a kã̀akɛo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lá Lua ì yã́gↄ̃gↄ̃ musudeↄnɛ,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ yãdaɛ̀e?","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Gbɛ̃eↄ ì ga ń àizɛɛ zↄ̃ↄo,","poem":1},{"lineBreak":true},{"text":"aa namablè bɛ́lɛbɛlɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Vĩ ìↄ di, an taↄ pai yɛlɛlɛ,","poem":1},{"lineBreak":true},{"text":"an wá ìↄ gbãa, aaìↄ mɛkpaa maamaa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ì ga ń nↄ̀sɛyaao,","poem":1},{"lineBreak":true},{"text":"zaa aa ku, aai pↄmaa e wa blèo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aaì wúlɛ gudoũ tɛ̃́ɛnauɛ,","poem":1},{"lineBreak":true},{"text":"aaì kↄ̀ↄka ḿpla ḿpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Á èa? Má á làasooↄ dↄ̃","poem":1},{"lineBreak":true},{"text":"ń kↄ̃ni pↄ́ álɛ kɛmɛɛo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Asa i mɛ: Gbɛ̃zↄ̃ↄ bɛ kú má saɛ?","poem":1},{"lineBreak":true},{"text":"Vãikɛnaↄ ua gↄ̃̀ bɛzia ũ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ili yãlala wɛ̃́lɛgɛnaↄwao lé?","poem":1},{"lineBreak":true},{"text":"Á yã́ pↄ́ aaì o fãn vĩo lé?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ì bↄ músikɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"pↄe lí aà le taasikɛgↄↄo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Démɛ ì zↄadↄwài?","poem":1},{"lineBreak":true},{"text":"Démɛ ì fĩaboɛ̀ aà yãkɛawai?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wì aà sɛ wà gɛò gɛvĩkĩi,","poem":1},{"lineBreak":true},{"text":"wì itɛ̃kɛ aà mia dↄngubↄwa.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Swa saɛ bùsukↄ̃ↄtɛ̃ↄ ì kɛɛ̀ na,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii tɛaàzi we, mɛ́ wì dↄaaɛ̀ dasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Á fↄ̃ ma nↄ̀sɛ níni ń á yãpãoe?","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ álɛ weaá zĩbↄnkpɛ yã́ɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}