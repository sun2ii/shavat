{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":22,"content":[{"type":"heading","content":["Yobu tàae vĩ"]},{"type":"verse","number":1,"content":["Ɔ̃ Temani gbɛ̃́ Ɛlifaza mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Gbɛ̃nazĩna a fↄ̃ àↄ ài vĩ Luaɛe?","poem":1},{"lineBreak":true},{"text":"Baa ↄ̃nↄde kã́fĩa vĩɛ̀e?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baa tó n yã́ na,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ fↄ̃ ǹ Gbãapiide pↄ kɛ nae?","poem":1},{"lineBreak":true},{"text":"Baa tó ń kú tàaesai,","poem":1},{"lineBreak":true},{"text":"bↄ́ ài a vĩ Luaɛi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ńlɛ e àlɛ zↄadↄma àlɛ bↄbↄnnↄ","poem":1},{"lineBreak":true},{"text":"kɛ́ ń dɛ aà yãmana ũ yã́i nɛe?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N vãikɛa zↄ̃ↄo lé?","poem":1},{"lineBreak":true},{"text":"N duuna lɛ́ vĩo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tↄ̀ↄmasì n gbɛ̃́ↄwa pã,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ↄ pↄkasaↄ wòlomá, aa gↄ̃̀ puizi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni í kpá yɛ̃̀ɛɛsaideↄwa aa mìo,","poem":1},{"lineBreak":true},{"text":"n nↄandɛnaↄ tɛ̃̀ blɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń gbãade ũ, ń tↄↄlɛ vĩ,","poem":1},{"lineBreak":true},{"text":"ń dɛ n bùsu bɛɛɛde ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɔ̃ n gyaa gbɛ̃andoↄ yà ↄgii,","poem":1},{"lineBreak":true},{"text":"n tonɛ pↄ́ gwana vĩoↄ gbãa mìdɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bee yã́i músi dasi n le,","poem":1},{"lineBreak":true},{"text":"ásoo kɛ̀ma kã́ndo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yã́i gu sìma, ńlɛ gu'eo,","poem":1},{"lineBreak":true},{"text":"í kũ̀aama à dànla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lua ku musu a bɛo lé?","poem":1},{"lineBreak":true},{"text":"Saanaↄ pɛ́kĩi gwa, lá à zã̀!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃ ńlɛ o: Bↄ́ Lua dↄ̃i?","poem":1},{"lineBreak":true},{"text":"Kua luabɛpuana kpɛle a fↄ̃ yã́gↄ̃gↄ̃wɛ̃ɛe?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lousisia kpaaɛ̀, àlɛ wá eo,","poem":1},{"lineBreak":true},{"text":"ìↄ bɛ musumusu weɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zɛ́ pↄ́ gbɛ̃vãiↄ bɛu à gɛ̃̀gɛ̃","poem":1},{"lineBreak":true},{"text":"ↄ̃ ń ye ǹ sɛ sↄ̃a?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wà gɛ̃̀ńnↄ zɛ́a kpóo,","poem":1},{"lineBreak":true},{"text":"í dàńla à tà ń ń zĩ́mpɛlɛo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa ò Luaɛ: Gowála!","poem":1},{"lineBreak":true},{"text":"Bↄ́ Gbãapiide a kɛwɛ̃ɛi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kási ↄ̃mɛ ń ká pↄmaawa ń ua.","poem":1},{"lineBreak":true},{"text":"Mi gbɛ̃vãiↄ lɛdama bee sio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maaↄ yã́ pↄ́ ń lé è, an pↄ ì kɛ na,","poem":1},{"lineBreak":true},{"text":"tàaesaideↄ ì ń láanikɛ aaì mɛ:","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wá ibɛɛↄ mìdɛ bɛ!","poem":1},{"lineBreak":true},{"text":"Tɛ́ kũ̀ pↄ́ pↄ́ dińziↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Misiilɛ Luaɛ, níↄ naaànↄ,","poem":1},{"lineBreak":true},{"text":"ní gbasa nama e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ àlɛ onɛ ma,","poem":1},{"lineBreak":true},{"text":"ní da n sↄ̃u.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tó n ɛa n su Gbãapiidewa,","poem":1},{"lineBreak":true},{"text":"mɛ́ ń tò vãi kɛ̃̀ n uawa zã̀,","poem":1},{"lineBreak":true},{"text":"a ń zɛdↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó n n mↄ̀ bɛɛɛdeↄ kↄ̀lɛ bùsuu,","poem":1},{"lineBreak":true},{"text":"mɛ́ n n vua maaↄ vũ̀aa swa'ɛ gbɛↄ guu,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbãapiide a gↄ̃ n mↄ̀ bɛɛɛde ũ,","poem":1},{"lineBreak":true},{"text":"aↄ dɛnɛ n pↄeã ã́nusu ũ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N pↄ i gbasa kɛ na Gbãapiidewa,","poem":1},{"lineBreak":true},{"text":"n wɛ́ iↄ pɛ Luawa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ní wabikɛwà, i sinnↄ,","poem":1},{"lineBreak":true},{"text":"ní lɛ́gbã pↄ́ ń dↄ̀wà fĩabo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ n zɛò i zɛkɛɛ,","poem":1},{"lineBreak":true},{"text":"n zɛ́ i pu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lua ì ĩ́andãnaↄ fu,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ pↄ́ an mi gↄ̃̀ pɛ́lɛaↄ suaba.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Baa tàaede, Lua a aà misi.","poem":1},{"lineBreak":true},{"text":"A n misi n ↄbↄlɛa vãi guu yã́i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}