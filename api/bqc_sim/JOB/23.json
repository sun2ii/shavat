{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":23,"content":[{"type":"heading","content":["Yobu yea kↄ̃'ea ń Luaoi"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Baa e tia málɛ yã́kũtɛ̃ka wɛ̃nannↄ,","poem":1},{"lineBreak":true},{"text":"Lua ↄtↄ̃̀a gbã́ugbãu, málɛ aaukɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó má dↄ̃ gu pↄ́ má aà eu,","poem":1},{"lineBreak":true},{"text":"dↄ̃ ma gɛ aà kĩ́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Má a yã́ↄ dↄdↄɛ̀,","poem":1},{"lineBreak":true},{"text":"má lɛkpaakɛaànↄ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mí ma lá a wea,","poem":1},{"lineBreak":true},{"text":"míↄ yã́ pↄ́ a omɛɛ tàasi kũa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A sòlekɛmanↄ a gbãa pua lɛ́u nɛe?","poem":1},{"lineBreak":true},{"text":"Aawo! A íbɛlɛsɛmanↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wekĩi gbɛ̃maa a e yã'ouɛ̀,","poem":1},{"lineBreak":true},{"text":"ma yã́kpalɛkɛnapi i ma kɛ̃ e gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó ma gɛ gukpɛ oi, a ku weo,","poem":1},{"lineBreak":true},{"text":"tó bɛ'aɛɛ sↄ̃, mili aà e weo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó àlɛ zĩkɛ gugbãntoo oi, mili wɛsiaàlɛo,","poem":1},{"lineBreak":true},{"text":"tó à lìlɛ gɛↄmidↄkĩi oi, mili aà wɛ́pao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ãma a zɛ́ pↄ́ má sɛ̀ dↄ̃,","poem":1},{"lineBreak":true},{"text":"tó à ma yↄ̃, má bↄ lán vuawaɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma aà kɛ̀sɛ kũ̀,","poem":1},{"lineBreak":true},{"text":"ma aà zɛ́ sɛ̀, mi lilɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi bↄ aà yãdilɛaↄ kpɛo,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ bↄ̀ aà lɛ́u kɛ̀mɛɛ na dɛ ma pↄbleaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"A ku ado, démɛ a fↄ̃ zɛ giɛ̀i?","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ kàaàgu ↄ̃ ì kɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A zĩkɛ yã́ pↄ́ a dìlɛmɛɛwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ a yã́ↄ kũa a nↄ̀sɛu dasi lↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bee yã́i gili ì gɛ̃magu aà aɛ,","poem":1},{"lineBreak":true},{"text":"tó ma làasookɛ̀wà, iwãa ì ka ma pↄaɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lua ma kãdɛ̀,","poem":1},{"lineBreak":true},{"text":"Gbãapiide vĩadàdamazi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gusia kù ma wɛ́a,","poem":1},{"lineBreak":true},{"text":"ãma i to ma nilɛo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}