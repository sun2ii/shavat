{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":24,"content":[{"type":"heading","content":["Lua ì vãikɛnaↄ to we"]},{"type":"verse","number":1,"content":[{"text":"Bↄ́yãi Gbãapiide ĩadamagↄↄ dilɛao ni?","poem":1},{"lineBreak":true},{"text":"Gↄↄpi lí ká aà dↄ̃naↄnɛo bɛ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ ì kↄↄↄ sɛ wà sↄ̃ò,","poem":1},{"lineBreak":true},{"text":"aaì pↄtuoↄ kpã́i'o aaↄ dã́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aaì tonɛ pↄ́ gwana vĩo zàa'ĩna síwà,","poem":1},{"lineBreak":true},{"text":"aaì gyaa gbɛ̃ando zu tↄ̀ↄmasi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì yɛ̃̀ɛɛsaideↄ yá zɛ́u,","poem":1},{"lineBreak":true},{"text":"ↄ̃ bùsu taasideↄ ì ńzĩa kpagui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Taasidepiↄ ì bɛbɛbɛbɛ sɛ̃u","poem":1},{"lineBreak":true},{"text":"lán sɛ̃̀a zàa'ĩnaↄwa,","poem":1},{"lineBreak":true},{"text":"aaìↄ blɛ wɛɛlɛwɛɛlɛ ń laaio,","poem":1},{"lineBreak":true},{"text":"aaìↄ blɛ kpálɛkɛ sɛ̃u ń nɛ́ↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaì tàaa kɛ̃ bugbɛ ziu,","poem":1},{"lineBreak":true},{"text":"aaì vɛ̃ɛ kↄ̃nwɛ gbɛ̃vãiↄ vɛ̃ɛbuu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì i bṹu kɛ́ aa pↄkasa vĩo yã́i,","poem":1},{"lineBreak":true},{"text":"aa zwãa vĩ wà kúńla tó ĩ́ana bↄ̀lɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lou ì ń gbɛ̃ gbɛ̀sĩsĩ musu,","poem":1},{"lineBreak":true},{"text":"aa ulɛkĩi vĩo, ↄ̃ aaì na gbɛwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wì nɛ́ desai sí a dawa,","poem":1},{"lineBreak":true},{"text":"wì taaside nɛ́ sí tↄ̀ↄma ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa pↄkasaↄ vĩo, ↄ̃ aaìↄ bɛ bṹu,","poem":1},{"lineBreak":true},{"text":"ń ń pↄ́ bàaa sɛ́sɛanɛ́kɛo, nↄa ì ń dɛɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaìↄ nísi zↄ̃nɛ́ ń kaau,","poem":1},{"lineBreak":true},{"text":"aaìↄ ↄ̃zↄ̃nɛ́ vɛ̃ɛwa,","poem":1},{"lineBreak":true},{"text":"kási imi ìↄ ń dɛɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ gaↄ lɛ́ aaukɛ wɛ̃́lɛu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kɛ̀'ĩaↄ lɛ́ wiilɛ,","poem":1},{"lineBreak":true},{"text":"kási Lua lí gbɛ̃e tàae eo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gbɛ̃eↄ ku aa ye gupua yã́io,","poem":1},{"lineBreak":true},{"text":"aa a gbadↄ̃o, aai a zɛ́ sɛo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛna ì fɛlɛ gufɛ̃nɛ,","poem":1},{"lineBreak":true},{"text":"ì wɛ̃nadeↄ ń taasideↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ gusia yeyewa lán kpã́iwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbãsĩkɛna ìↄ gubeebee dãɛ,","poem":1},{"lineBreak":true},{"text":"ìliↄ e gbɛ̃e a a eo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì pↄ́ku a oaa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ ì kpɛ́ gboo gusiai,","poem":1},{"lineBreak":true},{"text":"aaì ńzĩa sↄlↄ kpɛ́u fãanɛ,","poem":1},{"lineBreak":true},{"text":"aa gupua dↄ̃o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gusia níinii mɛ́ ń fãanɛ ũ,","poem":1},{"lineBreak":true},{"text":"aa kↄ̃ dↄ̃̀ ń gwãasĩn pↄ́ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Aa gbiao lán í fùlawa,","poem":1},{"lineBreak":true},{"text":"wà lɛkɛ̀ ń tↄↄlɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aali ń vɛ̃ɛbu kↄↄ sɛ lↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lá tↄↄlɛ gii ì imi guantɛ̃na,","poem":1},{"lineBreak":true},{"text":"màa bɛda ì duunkɛnaↄ mↄ́mↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"An yã́ ì sã́ ń da'iaↄgu,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ kↄ̀ↄↄ blɛ ũ.","poem":1},{"lineBreak":true},{"text":"Faasaidepiↄ yã́ lí dↄ gbɛ̃egu lↄo,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ kálɛa lán yàamiↄnaↄwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ ì fĩiↄ pↄ́ↄ símá,","poem":1},{"lineBreak":true},{"text":"aali yãmaakɛ gyaa gbɛ̃andoↄnɛo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lua ì gbɛ̃vãipiↄ gálɛ táńnↄ ń a gbãao,","poem":1},{"lineBreak":true},{"text":"baa tó aa zɛ̀dↄ, an kua náai vĩo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ì to aaↄ dↄdↄa aaↄ ńzĩa náai vĩ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ìↄ wɛ́tɛ an yãkɛaↄzi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aaì tↄbↄ gↄↄpla, ↄ̃ aaì sãalɛ,","poem":1},{"lineBreak":true},{"text":"aaì wulɛ ga lán gbɛ̃́piiwa,","poem":1},{"lineBreak":true},{"text":"aaì mipɛlɛ lán ése sáowa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó màan sↄ̃o, démɛ a ma ɛɛboi?","poem":1},{"lineBreak":true},{"text":"Démɛ a yã́ pↄ́ má ò dilɛ pãi?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}