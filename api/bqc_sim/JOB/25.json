o lↄe?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}