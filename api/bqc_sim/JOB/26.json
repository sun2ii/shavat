{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":26,"content":[{"type":"heading","content":["Yobu dↄ̃ Luaá Gbãapiideɛ"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"N dↄ yɛ̃̀ɛɛsaidelɛn wee?","poem":1},{"lineBreak":true},{"text":"N ↄdà gbãasaidewan wea?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N lɛdà ↄ̃nↄsaidewan wee?","poem":1},{"lineBreak":true},{"text":"N bↄ ń wɛzɛ̃ zↄ̃ↄon wee?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yã́pi ò ń dé gbãao ni?","poem":1},{"lineBreak":true},{"text":"Démɛ dↄ̀aanɛ n yã́ bee òi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gyaadeↄ lɛ́ pelembo","poem":1},{"lineBreak":true},{"text":"ísia ń pↄ́ pↄ́ kú a guuↄ zíɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛda yãe ulɛa Luaɛo,","poem":1},{"lineBreak":true},{"text":"pↄe daaɛ̀ gɛↄbɛlao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì gugbãntoo musu kpálɛ bàlumaa,","poem":1},{"lineBreak":true},{"text":"a tò dṹnia gola síiↄ̃ looa pↄewao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ì í ye a bɛ puanau.","poem":1},{"lineBreak":true},{"text":"Ń ípi gbiakɛo luabɛpuanapi lí pũnao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì pↄ́ku mↄvuala,","poem":1},{"lineBreak":true},{"text":"ì luabɛsiana na azĩai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À iadà ísiaɛ gu'ea lɛ́ zɛlɛu,","poem":1},{"lineBreak":true},{"text":"a dɛ kↄↄ ũ gupua ń gusiao zãnguo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó Lua pũ̀na, gu ì dee,","poem":1},{"lineBreak":true},{"text":"tó à kã̀a, ì bↄ ń saɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À ísia yà ń a gbãao,","poem":1},{"lineBreak":true},{"text":"à kwãsa wìwi ń a dↄ̃ao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A tò gu wèe ń a lɛ́'ĩanao,","poem":1},{"lineBreak":true},{"text":"à mlɛ̃̀ kↄ̃̀nikↄ̃ni bàwãade zↄ̃̀ɛ ń ↄo.","poem":1},{"noteId":14}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aà yãkɛaeↄn we,","poem":1},{"lineBreak":true},{"text":"a yↄↄna wálɛ ma we.","poem":1},{"lineBreak":true},{"text":"Wá fↄ̃ wà aà gↄ̃sakɛyãↄ gbadↄ̃ píio.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"26.13 Isa 27.1","reference":{"chapter":26,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}