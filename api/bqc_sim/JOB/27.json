{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":27,"content":[{"type":"heading","content":["Yobu yãnakpaa azĩawa"]},{"type":"verse","number":1,"content":["Yobu ɛ̀a pɛ̀ a yã́lɛ lↄ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Lua ku! À gì yãnakpáia,","poem":1},{"lineBreak":true},{"text":"Gbãapiidepi tò ma pↄ yà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ Lua ĩ́an wɛ̃nide ku ma mɛu,","poem":1},{"lineBreak":true},{"text":"e ma wɛ̃ni lɛ́u,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"yãfaasai a bↄ ma lɛ́uo,","poem":1},{"lineBreak":true},{"text":"máↄ mↄafili vĩo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kai! Má o á yã́ mɛ́ kú bauo.","poem":1},{"lineBreak":true},{"text":"E mà gɛ gaò má zɛ ń ma yãnakɛoɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma maakɛ ↄ̃ ma zɛò, má bↄ a kpɛo,","poem":1},{"lineBreak":true},{"text":"ma làasoo a ma dayãuo e ma wɛ̃ni lɛ́u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lua to gbɛ̃́ pↄ́ íbɛlɛsɛ̀manↄ gↄ̃ lán gbɛ̃vãiwa,","poem":1},{"lineBreak":true},{"text":"aà to gbɛ̃́ pↄ́ fɛ̀lɛmanↄ gↄ̃ lán faasaidewa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó Lua tò a yãmansai ã́nuatò,","poem":1},{"lineBreak":true},{"text":"bↄ́ aà wɛ́ aↄ dↄii?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua a swã́sɛ aà wiilɛai","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ wɛ́tɛ̃a aà lèe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà pↄ a kɛ na Gbãapiidewae?","poem":1},{"lineBreak":true},{"text":"Aↄ Lua sisi mↄ̀ↄmↄↄe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má Lua gbãa yã́ bↄↄlɛkɛɛ́,","poem":1},{"lineBreak":true},{"text":"má Gbãapiide yãkɛae ulɛɛ́o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ápii á è lá a dɛ.","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi álɛ yãpã bↄlɛi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Baa pↄ́ Lua dìlɛ gbɛ̃́ pãsĩɛn kɛ,","poem":1},{"lineBreak":true},{"text":"zia pↄ́ Gbãapiide dìlɛ gbɛ̃vãiɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Baa tó aà nɛ́ↄ dasi,","poem":1},{"lineBreak":true},{"text":"wa ń dɛdɛ ń fɛ̃ndaoɛ,","poem":1},{"lineBreak":true},{"text":"blɛ ali mↄ́ aà buiↄwao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gagyã a aà nɛ́ pↄ́ gↄ̃̀ aà kpɛↄ sɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"aà gyaaↄ nɛ́piↄ ga ↄ́ↄlↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baa tó à ã́nusu kã̀aaazi lán bùsuwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ à pↄkasa nↄ̀nↄaaazi lán bɛ̀lɛ zɛwa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"gbɛ̃maaↄ mɛ́ aa aà pↄ́piↄ da,","poem":1},{"lineBreak":true},{"text":"yãesaideↄ mɛ́ aa aà ã́nusupiↄ kpaalɛkↄ̃ɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kpɛ́ pↄ́ a dↄ̀ dɛ lán dã̀nsakpɛwaɛ,","poem":1},{"lineBreak":true},{"text":"lán gudↄ̃ana kolakpɛwa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A wúlɛ ↄde ũ, ãma a fɛlɛ lↄo,","poem":1},{"lineBreak":true},{"text":"tó aà wɛ́ wɛ̃̀, a e á kú ã́nuau lↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ ì to vĩa ń kṹↄ daaàla lán íwa,","poem":1},{"lineBreak":true},{"text":"zàa gwãasĩna a aà sɛ́.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gukpɛ ĩ́ana a aà sɛ gɛ̃ò zɛ́a,","poem":1},{"lineBreak":true},{"text":"i aà go a tía.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lua a kakpálɛwà aà wɛ̃nagwasai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãipi i tílɛ àↄ bↄ Lua ↄzĩ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wì ↄtaakãaawà,","poem":1},{"lineBreak":true},{"text":"wìↄ fionadadawà e aà go a tía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}