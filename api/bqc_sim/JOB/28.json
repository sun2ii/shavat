{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":28,"content":[{"type":"heading","content":["Ɔ̃nↄ sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Ãnusuyↄ̃kĩi kú,","poem":1},{"lineBreak":true},{"text":"vuabaasakĩi kú lↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wì mↄsi bↄ tↄↄlɛu,","poem":1},{"lineBreak":true},{"text":"wì mↄgotɛ̃ bↄ gbɛu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ì gusia yá,","poem":1},{"lineBreak":true},{"text":"ì tↄↄlɛ yↄɛ e a lɛ́ lɛ́u,","poem":1},{"lineBreak":true},{"text":"ì gbɛ pↄ́ kú gusia níiniiu wɛɛlɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wì ɛyↄ̃ tↄↄlɛ nↄnau wà zɛbↄ we,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ gbɛ̃e lí bɛbɛ à kauo.","poem":1},{"lineBreak":true},{"text":"Ba wì loowà wà gɛ̃ò ɛpiu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Blɛ ì bↄlɛ tↄↄlɛwaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gbɛ̃nazĩna ì tↄↄlɛ títiu lilɛ","poem":1},{"lineBreak":true},{"text":"lá tɛ́ ì pↄ́ lilɛwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Safii ku a gbɛↄ guu,","poem":1},{"lineBreak":true},{"text":"vua ku a bùsuti guu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bã nↄ̀ↄsonaↄ a zɛ́ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"bleaa lí wɛsi zɛ́pilɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a nↄ̀bↄ tↄdeↄ lí zɛ́pi sɛo,","poem":1},{"lineBreak":true},{"text":"nↄ̀ↄmusuↄ lí bɛbɛuo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ì gbɛkão wíwi we,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̀sĩsĩↄ zĩ́lɛ sↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì zɛ́ da gbɛu we,","poem":1},{"lineBreak":true},{"text":"ì wɛsi gupi pↄ́ bɛɛɛdeↄlɛ píi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì zɛzↄ̃ swa'iɛ,","poem":1},{"lineBreak":true},{"text":"ì bↄ ń pↄ́ pↄ́ ulɛaↄ gupuau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɔ̃nↄ sↄ̃, wì e má ni?","poem":1},{"lineBreak":true},{"text":"Dↄ̃a kúkĩin mái?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna a bɛɛɛ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"wìli e dṹnia guuo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ísi ì mɛ á vĩo,","poem":1},{"lineBreak":true},{"text":"ísia ì mɛ a ku a kĩ́io.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wa fↄ̃ lú ń vua maaoo,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ a lɛũkpakɛ ń ã́nusuoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A bɛɛɛ dɛ Ofii bùsu vuaa","poem":1},{"lineBreak":true},{"text":"ge safii gbɛ bɛɛɛde ge onisi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wa fↄ̃ lɛɛũ ń vuao ge bĩsãgbɛo,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ a fĩabo ń vua tɛ̃ɛtɛ̃ɛ pↄ́oo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wa ↄpua ge gbɛdii yã'o lↄe?","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄkũa bɛɛɛ dɛ òsowɛɛlɛaa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wa fↄ̃ lɛɛũ ń Etiopi bùsu topazaoo,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ lú ń vua maaoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɔ̃nↄ ì bↄ má ni?","poem":1},{"lineBreak":true},{"text":"Wɛzɛ̃ kúkĩin mái?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A ulɛa pↄ́piiɛ,","poem":1},{"lineBreak":true},{"text":"baa bã pↄ́ ì vua musu lí a wɛ́pao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kaalɛ ń gao ì mɛ,","poem":1},{"lineBreak":true},{"text":"wá swã́ a feena màɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lua mɛ́ a zɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"aàpi mɛ́ a kúkĩi dↄ̃.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Asa ì gugwa e dṹnia lɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"ì pↄ́ pↄ́ kú zĩ́lɛ e píi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kɛ́ Lua gbãa dìlɛ ĩ́anaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ à ísia í lɛ́ dàɛ̀,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"kɛ́ à lou ikoyã dìlɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ à zɛbↄ̀ loupilɛaɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"zĩbeezĩ à ↄ̃nↄ laai gwà à a maabò,","poem":1},{"lineBreak":true},{"text":"a dìlɛ, ↄ̃ à a sáaukpà.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ɔ̃ a ò gbɛ̃nazĩnaↄnɛ:","poem":1},{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ ì mↄ́ ń ↄ̃nↄo,","poem":1},{"lineBreak":true},{"text":"mikɛ̃a yãvãiwa mɛ́ ì ń wɛ́ kɛ̃́.","poem":1},{"noteId":15}]}],"footnotes":[{"noteId":15,"caller":"+","text":"28.28 Soũ 111.10, Yaa 1.7, 9.10","reference":{"chapter":28,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}