{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":29,"content":[{"type":"heading","content":["Yobuá bɛɛɛdeɛ yãa"]},{"type":"verse","number":1,"content":["Yobu ɛ̀a pɛ̀ a yã́lɛ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Tó má e màↄ ku ma kua yãa","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ Lua lɛ́ ma dↄ̃́awa lé!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gↄↄ bee aà filia ìↄ dia ma mi'aɛwaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ miↄ bɛ aa gupuau gwã́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má kú ma gↄↄ soplawa,","poem":1},{"lineBreak":true},{"text":"Lua gbɛ̃naↄn wá ũ ma ua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gↄↄ bee Gbãapiide kumanↄɛ,","poem":1},{"lineBreak":true},{"text":"ma nɛ́ↄ liaamazi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gↄↄ bee vĩ dimaziɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma gu gbɛde ku bↄ̀, nísi dìɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tó ma gɛ wɛ̃́lɛ bĩ́ibↄlɛu,","poem":1},{"lineBreak":true},{"text":"ge ma zↄ̃lɛkĩi kũ̀ gãaɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"tó málɛ mↄ́, ɛ̀waasoↄ ì gubↄmɛɛɛ,","poem":1},{"lineBreak":true},{"text":"maezↄ̃ↄↄ ì fɛlɛ aaↄ zɛaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃zↄ̃ↄↄ ì kɛ kyↄ̃́,","poem":1},{"lineBreak":true},{"text":"aaì ↄku ń lɛ́wa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dↄaanaↄ yã'o ì busa,","poem":1},{"lineBreak":true},{"text":"an lɛ́ ì gↄ̃ kpaaũa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃́ pↄ́ swãsɛ̀ ma yã́i ì ma tↄnasi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ wɛsìmalɛ ì ma sáaukpa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Asa ma taaside pↄ́ wiilɛ̀ mìsi","poem":1},{"lineBreak":true},{"text":"ń tonɛo ń gbɛ̃́ pↄ́ ↄdamade vĩoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú ga lɛ́zĩ samaa'òmɛɛ,","poem":1},{"lineBreak":true},{"text":"má tò gyaa gbɛ̃ando guladↄ̀a.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma yãkɛa a zɛ́wa dà pↄkasa ũ,","poem":1},{"lineBreak":true},{"text":"maakɛa dɛmɛɛ ulada ũ fùa ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Vĩ̀aↄ wɛ́n ma ũ,","poem":1},{"lineBreak":true},{"text":"ɛɛↄ gbán ma ũ,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"taaside maen ma ũ.","poem":1},{"lineBreak":true},{"text":"Kɛ́ wàlɛ yã́gↄ̃gↄ̃ ń nibↄo, ma lɛdau.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma faasaideↄ kãnkãnaↄ ɛ̀'ɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ pↄ́ kpá aà lɛ́zĩ gà má bↄ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ɔ̃ ma mɛ̀ ma gↄↄ aↄ dasi lán ũfãawaɛ,","poem":1},{"lineBreak":true},{"text":"mí ga niɛ guu ma bɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma zĩ́na a í le,","poem":1},{"lineBreak":true},{"text":"fíi iↄ kpa ma gↄ̃naↄwa gwã́.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma gawi aↄ diadiɛ,","poem":1},{"lineBreak":true},{"text":"ma sá iↄ naa ma ↄzĩ dafudafu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Wì zɛ wà swãdↄ ma yã́i,","poem":1},{"lineBreak":true},{"text":"wì kɛ kílikili wà ma lɛdama ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma yã'oa gbɛa gbɛ̃e lí yã'o lↄo,","poem":1},{"lineBreak":true},{"text":"ma yã́ mɛ́ ì tↄ̃́má.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"An wɛ́ ìↄ dↄmazi lá an wɛ́ ìↄ dↄ louziwa,","poem":1},{"lineBreak":true},{"text":"aaìↄ lua ma yã́i lá wìↄ lua káabuan louziwa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó ma yamↄsɛkpàmá, ì bↄ ń saɛ,","poem":1},{"lineBreak":true},{"text":"ma oa weeama ì kɛnɛ́ na,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lí fↄ̃ tò ma oosìsio.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma zɛmikũ̀nɛ́,","poem":1},{"lineBreak":true},{"text":"má kú ń guu dↄaana ũ.","poem":1},{"lineBreak":true},{"text":"Má dɛ pↄsiadeↄ nↄ̀sɛninina ũ","poem":1},{"lineBreak":true},{"text":"lá kía ìↄ kú ń a ìwaↄwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}