{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":3,"content":[{"type":"heading","content":["Yobu sakaa a igↄↄu"]},{"type":"verse","number":1,"content":["Bee gbɛa Yobu yãsɛ̀ à sakà a igↄↄu"]},{"type":"verse","number":2,"content":["à mɛ̀:"]},{"type":"verse","number":3,"content":[{"text":"To ma igↄↄ bãdɛ","poem":1},{"lineBreak":true},{"text":"gwãasĩna pↄ́ wà mɛ̀ wà ma iupi.","poem":1},{"noteId":3}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To gↄↄpi li gusia ũ.","poem":1},{"lineBreak":true},{"text":"Kua musu Lua su a yãdao,","poem":1},{"lineBreak":true},{"text":"asu to gupuuo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To gusia níinii kũaa gↄↄpiwa,","poem":1},{"lineBreak":true},{"text":"to luabɛsiana kúlɛwà,","poem":1},{"lineBreak":true},{"text":"to gusia gèele daala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gwãasĩnapi sↄ̃, aà siakũ maamaa,","poem":1},{"lineBreak":true},{"text":"wasu da wɛ̃̀ gↄↄ guu lↄo,","poem":1},{"lineBreak":true},{"text":"wasu nao mↄ gↄↄ guuo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To gwãasĩnapi fĩikũ,","poem":1},{"lineBreak":true},{"text":"gula su àↄ dↄ gↄↄ beeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pↄdamade pↄ́ aali tó ĩatɛ̃ gupuoↄ","poem":1},{"lineBreak":true},{"text":"láaizĩ gↄↄpiwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"To a gudↄlɛia saanaↄ siakũ,","poem":1},{"lineBreak":true},{"text":"wi gudↄa dã pã, gu a kɛ̃o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa gↄↄpi i ma da nɛasakpɛ zɛ́ tamɛɛo,","poem":1},{"lineBreak":true},{"text":"a tò ma wɛsì taasilɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Àkɛa wi ma i gɛ ũ yãao ni?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi mi bↄ gbɛɛu mà ta gↄ̃̀ↄo ni?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Àkɛa wà ma kpa gbáai?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi wà yↄ̃́ kpàa má mìi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó ma ga yãa, dↄ̃ má kú kílikili,","poem":1},{"lineBreak":true},{"text":"dↄ̃ ma i'ò ma kã́mabò","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ń kíaↄ ń dṹnia lɛdamade","poem":1},{"lineBreak":true},{"text":"pↄ́ aa kpɛ́ ziↄ kɛ̀kɛ dↄ̀ ńzĩaɛↄ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kía pↄ́ aa vua kã̀aańziↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa ã́nusu kà ń kpɛ́ paiↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A maa yãa wà ma vĩ lán nↄbↄlɛawa,","poem":1},{"lineBreak":true},{"text":"lán nɛ́ pↄ́ mↄ̀ gɛ̀, i dṹnia eowa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wekĩi vãikɛnaↄ ì ń zↄa tóu,","poem":1},{"lineBreak":true},{"text":"mɛ́ yɛ̃̀ɛɛsaideↄ ì kã́mabou.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zĩ̀zↄↄ ì ĩ́ampakĩi e we,","poem":1},{"lineBreak":true},{"text":"aali ń wɛtãnaↄ lↄↄ ma lↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbãadeↄ ń táaaↄ ku we píi,","poem":1},{"lineBreak":true},{"text":"mɛ́ zↄ líↄ dɛ a dii pↄ́ ũ we lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bↄ́yãi Lua ì gupu wɛ̃nadeↄnɛ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ an nↄ̀sɛ ↄ̃̀ↄkpaaↄi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aai wɛɛlɛ ga mↄ́ ń sɛ́, ìli mↄo,","poem":1},{"noteId":4},{"lineBreak":true},{"text":"aaì kpálɛkɛi dɛ lá wì kɛ ↄdaila.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tó aa gɛ̃̀ tɛ̃́ɛnau, an pↄ ì kɛ na,","poem":1},{"lineBreak":true},{"text":"an nↄ̀sɛ ì yáalↄ maamaa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ dↄ̃ gu pↄ́ á kúuon ma ũ,","poem":1},{"lineBreak":true},{"text":"Lua kaa lìamazi gupiiu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wea zàũzaũ mɛ́ ma pↄblea ũ,","poem":1},{"lineBreak":true},{"text":"ma aaukɛa ì bↄlɛ ma lɛ́u lán íwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ má a vĩa vĩ mɛ́ ma le,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ ma kã́ gìi mɛ́ pìlaa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Má kú niɛo, má kú kílikilio.","poem":1},{"lineBreak":true},{"text":"Mi e kã́mabòo, gili mɛ́ gɛ̃̀magu.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"3.3 Zel 20.14","reference":{"chapter":3,"verse":3}},{"noteId":4,"caller":"+","text":"3.21 Zia 9.6","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLin