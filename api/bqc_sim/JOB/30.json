{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":30,"content":[{"type":"heading","content":["Yobuá bɛɛɛsaideɛ sa"]},{"type":"verse","number":1,"content":[{"text":"Tiasa ma gↄ̃ pↄ́ yáalↄa ũ gbɛ̃́ pↄ́ aai kamawaoↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an maeↄ bɛɛɛ i ka aa yãalɛ ń ma gbɛ̃ↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bↄ́ gbɛ̃́piↄ wòmɛɛi?","poem":1},{"lineBreak":true},{"text":"Aa yɛ̃̀ɛɛ vĩ lↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa gↄ̃̀ kóũkoũnnↄ nↄana ń pↄ́kɛ̃sãmao yã́i,","poem":1},{"lineBreak":true},{"text":"aaì blɛ wɛɛlɛwɛɛlɛ gugiiu,","poem":1},{"lineBreak":true},{"text":"aaì i gugbaigbaiu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì libɛↄ wɛɛlɛ sɛ̃u,","poem":1},{"lineBreak":true},{"text":"lízĩna mɛ́ ń pↄblea ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wà ń yá ń gbɛ̃́ↄ guuɛ,","poem":1},{"lineBreak":true},{"text":"wà wiidↄ̀má lá wì kɛ kpã́iɛwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaìↄ ku swa gbã́oↄ guu","poem":1},{"lineBreak":true},{"text":"ń tↄↄlɛ ɛↄ ń gbɛ̀'ɛↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An wii ìↄ dↄ lákpɛu,","poem":1},{"lineBreak":true},{"text":"aaì fĩfĩkↄ̃wa sɛ̃ zíɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃pãↄnɛ, tↄsaideↄnɛ,","poem":1},{"lineBreak":true},{"text":"wà ń yá ń bùsuuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tiasa ma yã́ mɛ́ gↄ̃̀nɛ́ lɛ ũ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃nɛ́ láanipↄ ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa ye ma gĩyãio, aaì bↄmɛɛ zã̀,","poem":1},{"lineBreak":true},{"text":"an lɛ́'ikaaa líↄ kpaagui vĩo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Za gↄↄ pↄ́ Lua ma sá ìlo à ma busa,","poem":1},{"lineBreak":true},{"text":"aaìↄ ma yã'o ma wáaɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãipiↄ fɛ̀lɛmanↄ ma ↄplaai,","poem":1},{"lineBreak":true},{"text":"aaìↄ gbá zↄ̃zↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"ma kaaũa zɛ́ ↄ̃ aaìↄ wɛɛlɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aaì zɛzↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"aaì dɛ̃ɛka wà e ma bↄlia,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e bàa kú ń dↄamalɛoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa gufↄ̃̀ wàu, aalɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"aa dↄ̀dↄkↄ̃wa gu pↄ́ aa yàapiu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sↄ̃ kɛ̃̀magu, ma bɛɛɛ gɛ̃̀zɛa ń ĩ́anao,","poem":1},{"lineBreak":true},{"text":"ma kuana sã̀alɛ lán luabɛpuanawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tiasa ma wɛ̃ni lɛ́ gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"ma si wɛ́tɛ̃au sa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wãwã ìↄ ma wá wí gwãasĩna,","poem":1},{"lineBreak":true},{"text":"wãwãpi ìↄ swaa kĩkĩa kã́mabosai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lua ma pↄkasa kã̀aa a kũ̀ gbã́ugbãu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma ulatao lɛ́ ma kòlo wí.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"À ma zu bɛ̀lɛau,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán bùsuti ge túfuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lua, mi wiilɛnzi, nili weao,","poem":1},{"lineBreak":true},{"text":"mi fɛlɛ zɛ, wɛ́ ni ma gwaò.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ni liaamanↄ pãsĩpãsĩ,","poem":1},{"lineBreak":true},{"text":"ni fɛlɛmanↄ ń n gã̀sa gbãao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ni ma sɛ ǹ ma gbaɛ ĩ́anau,","poem":1},{"lineBreak":true},{"text":"ni to ma sãalɛ zàa'ĩanau.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Má dↄ̃ kɛ́ ńyↄ̃ ma kpa gaiɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́pii bɛɛ!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wìwi lí ↄdↄnzio lé?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ sì wɛ́tɛ̃au ì wiilɛnziɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mi ↄ́ↄlↄ gbɛ̃́ pↄ́ yã́ ń léↄnɛo lé?","poem":1},{"lineBreak":true},{"text":"Mi pↄsia kɛ wɛ̃nadeↄnɛo lé?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kɛ́ ma wɛ́ dↄ maai, ↄ̃ ma vãi è.","poem":1},{"lineBreak":true},{"text":"Málɛ gupua dã́, ↄ̃ gusia mↄ̀a.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ líↄ daa doũo,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ̃a miↄ e'e lá gu lɛ́ dↄ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Miↄ bɛ sínkpaũkpaũ,","poem":1},{"lineBreak":true},{"text":"i kɛ ĩatɛ̃ yã́i no.","poem":1},{"lineBreak":true},{"text":"Mi fɛlɛ zɛ bíla guu mà wiilɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ kↄ̃gbɛ̃ ũ ń gbɛ̃gbonaↄ,","poem":1},{"lineBreak":true},{"text":"taataaↄ gbɛ̃nan ma ũ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma mɛbaa siakũ̀, àlɛ bↄ sↄu,","poem":1},{"lineBreak":true},{"text":"ma mɛ lɛ́ pí, àlɛ pusu bↄ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ma mↄↄna gↄ̃̀ pↄsiakɛbↄ ũ,","poem":1},{"lineBreak":true},{"text":"ma kulɛ'ↄ dàkↄ̃i ń ↄↄlↄnaↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}