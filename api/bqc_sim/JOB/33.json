{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":33,"content":[{"type":"heading","content":["Lua ì gbɛ̃nazĩna gba laai"]},{"type":"verse","number":1,"content":[{"text":"Ma yãma sa Yobu,","poem":1},{"lineBreak":true},{"text":"swã́kpa ma yã'oai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa, ma bↄ ń yã́o sa,","poem":1},{"lineBreak":true},{"text":"a dↄ ma lɛ́u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma yã́ↄ lɛ́ bↄ ma nↄ̀sɛmaa guuɛ,","poem":1},{"lineBreak":true},{"text":"málɛ yã́ pↄ́ má dↄ̃ o ń nↄ̀sɛmɛndoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lua Nisĩna ma kɛ,","poem":1},{"lineBreak":true},{"text":"Gbãapiide lɛ́'ĩanapi ma gba wɛ̃ni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó ńyↄ̃ fↄ̃́, yãwea,","poem":1},{"lineBreak":true},{"text":"sↄukɛ, ní yã́zãsia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má kɛ́, má doũnnↄ Luaɛɛ,","poem":1},{"lineBreak":true},{"text":"à gĩtↄ̀ à ma kɛò sↄ̃ɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ńsu vĩakɛmɛɛo,","poem":1},{"lineBreak":true},{"text":"má ↄtↄ̃ma gbãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ń ò ma swã́ mà,","poem":1},{"lineBreak":true},{"text":"má mà n yã'ò n mɛ̀,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ń tàae vĩo, ń zɛ̃a,","poem":1},{"lineBreak":true},{"text":"ń kú gbãsĩsai, ń yãvãi vĩo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔ̃ Lua íbɛlɛsɛ̀nnↄ,","poem":1},{"lineBreak":true},{"text":"à n dilɛ a wɛ̀lɛ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì galakpanɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ n tàasika n yãkɛa píi guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Málɛ onɛ, n yã́ bee nao,","poem":1},{"lineBreak":true},{"text":"asa Lua zↄ̃ↄ dɛ gbɛ̃nazĩnaa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ńlɛ zↄadↄ Luawa","poem":1},{"lineBreak":true},{"text":"kɛ́ ìli yã́zãsi gbɛ̃nazĩnawao ni?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lua ì yã'o gɛ̃n doɛ,","poem":1},{"lineBreak":true},{"text":"ìli a gbɛsisio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì yã'onɛ́ wɛ́pungu'ea ge nana guu gwã́,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ i niazĩde kpà gbɛ̃́ↄla,","poem":1},{"lineBreak":true},{"text":"aalɛ ipi o ń wúlɛkĩi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɔ̃ ì yã'o ń swã́u,","poem":1},{"lineBreak":true},{"text":"ì to vĩa ń kṹ ń ĩadama yã́o,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kɛ́ gbɛ̃́ↄ e mikɛ̃ yãvãiwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ aasu ĩ́anadão.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ì gínɛ́ màa aa ta miau,","poem":1},{"lineBreak":true},{"text":"ì kpánɛ́ wà ń dɛdɛ ń fɛ̃ndao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́ toto ń wawãwão aà wúlɛkĩi,","poem":1},{"lineBreak":true},{"text":"ì ĩakpaaàzi kã́mabosai,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ↄ̃ pↄblea ì kɛɛ̀ bↄlↄ ũ,","poem":1},{"lineBreak":true},{"text":"ìliↄ ye a pↄeã blɛi seo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aà mɛ ì ibaba,","poem":1},{"lineBreak":true},{"text":"aà wá pↄ́ ulɛa yãa ì bↄ gupuau sa,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"e aà wɛ̃ni kãikũ ń miao,","poem":1},{"lineBreak":true},{"text":"àlɛ sↄ̃ malaika gbɛ̃dɛnaↄzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ń beeo tó a malaika vĩ kↄ́ↄ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ dɛ gbɛ̃ↄn ↄ̀aa sↄoↄla,","poem":1},{"lineBreak":true},{"text":"a yã́ pↄ́ zɛvĩ ↄlↄɛ̀,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"i sùuukɛaànↄ à onɛ́:","poem":1},{"lineBreak":true},{"text":"Ásu to aà ta miauo,","poem":1},{"lineBreak":true},{"text":"ma aà misia zɛ́ è.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aà mɛ i dafukũ lán nɛ́tɛ̃nawa,","poem":1},{"lineBreak":true},{"text":"iↄ tɛkɛ lán ɛ̀waasowa,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"i wabikɛ Luawa, i kɛaànↄ na.","poem":1},{"lineBreak":true},{"text":"Tó a è Lua a wɛgwà, a kúkuakɛ,","poem":1},{"lineBreak":true},{"text":"Lua i ɛa to aàↄ naanↄ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A gɛ́ gbɛ̃́ↄ kĩ́i, i mɛ:","poem":1},{"lineBreak":true},{"text":"Ma duunakɛ̀ ma yã́zɛde fuangbà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Lua i a fĩabomɛɛo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À ma mìsi, mi ta miauo,","poem":1},{"lineBreak":true},{"text":"málɛ pↄnakɛ aà gupuau sa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ń èa? Lua ì yã́ beeↄ kɛ píi,","poem":1},{"lineBreak":true},{"text":"ì kɛ gbɛ̃́ɛ gɛ̃n pla, baa gɛ̃n àaↄ̃.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ì aà si gawa,","poem":1},{"lineBreak":true},{"text":"kɛ́ gupua wɛ̃nide e biiwà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Swã́kpa ǹ ma yãma, Yobu,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ n lɛ́ kpaaũ, mapi má yã'o.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tó ń yã'oa vĩ sↄ̃, o,","poem":1},{"lineBreak":true},{"text":"asa má ye mà yãnakpama.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tó ń vĩ sↄ̃o, ma yãma.","poem":1},{"lineBreak":true},{"text":"Nílɛ mà ↄ̃nↄ danɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}