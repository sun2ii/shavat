{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":34,"content":[{"type":"heading","content":["Ɛlihu Yobu tàae'ea"]},{"type":"verse","number":1,"content":["Ɛlihu pɛ̀ a yã́lɛ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Á ↄ̃nↄnaↄ, à ma yãma!","poem":1},{"lineBreak":true},{"text":"Á yãdↄ̃naↄ, à swã́kpa à ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa swã́ ì yã́ dↄ̃kↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"lá lɛ́ ì blɛ dↄ̃kↄ̃ɛwaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wà zɛ ń yã́zɛdeo,","poem":1},{"lineBreak":true},{"text":"wíↄ yãmaa dↄ̃ wá zãnguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yobu lɛ́ mɛ á tàae vĩo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Lua lɛ́ gí a yãnakpáiwà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À mɛ̀ ń a yã́ nao,","poem":1},{"lineBreak":true},{"text":"Lua lɛ́ a dilɛ ɛɛde ũɛ,","poem":1},{"lineBreak":true},{"text":"ń a tàaesaidekɛo a bↄá fↄ̃naɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Démɛ kú lán Yobuwa","poem":1},{"lineBreak":true},{"text":"dↄ́ɛa ń Luao ìↄ dɛ aà imia ũi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À gbɛ̃kpà ń duunkɛnaↄ,","poem":1},{"lineBreak":true},{"text":"à bɛ̀bɛ ń vãikɛnaↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa ì mɛ̀","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ wɛɛlɛa a yã́ ká Luagu ài vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Á nↄ̀sɛdeↄ, à ma yãma!","poem":1},{"lineBreak":true},{"text":"Yãdↄↄsai i kↄ̃'e ń Luaoo,","poem":1},{"lineBreak":true},{"text":"Gbãapiide lí yãvãikɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì fĩabo baadeɛ a yãkɛawaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii zĩa yã́ ↄ̃ ì wiɛ̀ a musu.","poem":1},{"noteId":16}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua lí yãdↄↄsai kɛo fá!","poem":1},{"lineBreak":true},{"text":"Gbãapiide lí yã́zɛde fuangbao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Démɛ aà dìlɛ dṹnia kía ũi?","poem":1},{"lineBreak":true},{"text":"Démɛ dṹnia bṹu nàɛ̀ aà ↄzĩi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó à zɛ̀ò","poem":1},{"lineBreak":true},{"text":"à nisĩna ń ĩ́an wɛ̃nideo si baadewa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"gbɛ̃́pii a gaga gↄ̃̀ↄɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩna i ɛa gɛ̃ tíu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yobu, tó n ↄ̃nↄ kà, yã́ɛ bee ma,","poem":1},{"lineBreak":true},{"text":"swã́sɛ ma yã́i.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye yã́zɛdeio a kɛ dↄaana ũe?","poem":1},{"lineBreak":true},{"text":"Lua zↄ̃ↄ mɛ́ a maa, ↄ̃ ńyↄ̃ yãdaaàlaa?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Luapi ì o kíaↄnɛ, pↄ́ giaↄ,","poem":1},{"lineBreak":true},{"text":"ì o kíabuiↄnɛ, gbɛ̃vãiↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ìli kíaↄ dilɛ ńdoao,","poem":1},{"lineBreak":true},{"text":"ìli zɛ ń ↄdeↄ à bↄ̀ taasideↄ kpɛo,","poem":1},{"lineBreak":true},{"text":"asa ampiiá aà pↄkɛaↄnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aaì gaga kã́ndo wɛɛdo,","poem":1},{"lineBreak":true},{"text":"aaì gbãsĩlɛ aa gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"zɛdeↄ ì ã́nuato gbɛ̃nazĩna ↄ sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lua ì wɛ́tɛ gbɛ̃nazĩnaↄ yãkɛai,","poem":1},{"lineBreak":true},{"text":"lá aalɛ gbásɛ, ìↄ e píiɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gusia ge gusisie ku","poem":1},{"lineBreak":true},{"text":"kɛ́ vãikɛna ulɛuɛ̀o.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lua lí gbɛ̃́ lala yã́i","poem":1},{"lineBreak":true},{"text":"à gbasa yãdaaàlao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ì zɛdeↄ wíwi yã́gↄ̃gↄ̃ańnↄ sai,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì gbɛ̃pãleↄ dilɛ ń gbɛu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kɛ́ ìↄ ń yãkɛaↄ e yã́i,","poem":1},{"lineBreak":true},{"text":"ì ń fuangba gwãasĩna à ń wíwi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ì ń wɛtã ń vãi yã́i gupuau,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"kɛ́ aa bↄ̀ aà yã́ kpɛ,","poem":1},{"lineBreak":true},{"text":"aai laaidↄ aà yã́wao yã́i.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aa tò pↄesaideↄ wii Lua lè,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à wɛ̃nadepiↄ wii mà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Lua nílɛa kpɛ̃́, démɛ a fↄ̃ aà tàae ei?","poem":1},{"lineBreak":true},{"text":"À azĩa kpàgui, démɛ a bↄwài?","poem":1},{"lineBreak":true},{"text":"A iko vĩ bui píiwa ń baadeo,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"kɛ́ luayãdansai su kpalable,","poem":1},{"lineBreak":true},{"text":"i kↄ̃nikɛ gbɛ̃́ↄnɛo yã́i.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ ò Luaɛ tàaeden a ũ,","poem":1},{"lineBreak":true},{"text":"á yãdↄↄsai kɛ lↄo,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"yã́ pↄ́ á dↄ̃o Lua dadaɛ,","poem":1},{"lineBreak":true},{"text":"tó a duunakɛ̀ yãaɛ, á kɛ lↄo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lua a ĩadawà yã̀?","poem":1},{"lineBreak":true},{"text":"N Lua tàae è, ń è kpelewa ni?","poem":1},{"lineBreak":true},{"text":"Lá ńlɛ e, o, n yã́ɛ, i kɛ mámɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Nↄ̀sɛdeↄ òmɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna pↄ́ aa ma yãmàↄ mɛ̀,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yobu lɛ́ yã́ pↄ́ á dↄ̃o o,","poem":1},{"lineBreak":true},{"text":"aà yã'oa dↄ̀ↄ vĩo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Yobu ĩadama aↄ gɛɛ,","poem":1},{"lineBreak":true},{"text":"asa àlɛ yã́zãsi lán gbɛ̃vãiwaɛ.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Àlɛ tàae kã́fĩ duunaa,","poem":1},{"lineBreak":true},{"text":"àlɛ ↄtaalɛ wá guu,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛnakasa Luaɛ.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"34.11 Soũ 62.13","reference":{"chapter":34,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}