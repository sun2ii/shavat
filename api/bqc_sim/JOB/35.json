{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":35,"content":[{"type":"heading","content":["Yobu zↄadↄa Luawaá pãɛ"]},{"type":"verse","number":1,"content":["Ɛlihu ɛ̀a pɛ̀ a yã́lɛ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Kɛ́ n mɛ̀ Lua a yãnakpama,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n ɛa n mɛ̀ bↄ́ ài kua duunasai vĩi,","poem":1},{"lineBreak":true},{"text":"ge bↄ́ má sɛ́lɛ a guui,","poem":1},{"lineBreak":true},{"text":"ńlɛ e yã́ pↄ́ ń bɛopi maa yã̀?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpi ń n gbɛ̃́ↄ, má yã́zãsiwá.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɛ́sɛ ǹ luabɛ gwa,","poem":1},{"lineBreak":true},{"text":"gwa lá luabɛpuana zã̀nnↄ mɛ̀!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó n duunakɛ̀, bↄ́ a wo Luawai?","poem":1},{"lineBreak":true},{"text":"Tó n tàae lɛ́ diadi, bↄ́ a biwài?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó ń kú n dↄ̀ↄwa, bↄ́ ńlɛ aà gbai?","poem":1},{"lineBreak":true},{"text":"Bↄ́ àlɛ emai?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N gbɛ̃́deeↄ ↄ̃ n vãikɛa ì pↄ́ womá,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃nazĩn deeↄ ↄ̃ n maakɛa ì àikɛnɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gbãamↄanɛ́ pãsĩ ì to wà wiilɛ","poem":1},{"lineBreak":true},{"text":"wà mɛ wá sí gbɛ̃́ taiinkɛnaↄwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ãma an gbɛ̃e lí mɛ Lua a Kɛna ku máɛo.","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ ì to wàↄ lɛtɛ̃ dↄ gwã́,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ì yãdawɛ̃ɛ dɛ nↄ̀bↄↄla,","poem":1},{"lineBreak":true},{"text":"ì wá gba ↄ̃nↄ dɛ bãↄla.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó wà wiilɛ̀wà, ìli yãmamáo,","poem":1},{"lineBreak":true},{"text":"kɛ́ gbɛ̃vãipiↄ ìↄ dↄ́ɛwà yã́i.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wii pãɛ! Lua lí swã́sɛio,","poem":1},{"lineBreak":true},{"text":"Gbãapiide lí ń yãdao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Baa kɛ́ n mɛ̀ ni wɛsiaàlɛo,","poem":1},{"lineBreak":true},{"text":"n yã́ aà kĩ́i lè, sↄ̃́aaàzi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɛ́ àlɛ pↄkũmabↄbↄmá tia kɛ́wao","poem":1},{"lineBreak":true},{"text":"ↄ̃ ńlɛ e àlɛ tàae pↄ́ wa kɛ̀ↄ yãdaoɛa?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Beewa Yobu yãpã ò,","poem":1},{"lineBreak":true},{"text":"à yã́ pↄ́ á a gbadↄ̃o bↄ̀lɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":15}