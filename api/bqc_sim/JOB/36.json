{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":36,"content":[{"type":"heading","content":["Wi taasikɛ wá bↄa maa yã́iɛ"]},{"type":"verse","number":1,"content":["Ɛlihu ɛ̀a pɛ̀ a yã́lɛ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Mɛnakɛ yↄↄ, mí ɛa onɛ","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ tò Lua yã́ mɛ́ kú.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mí bↄnɛ ń ma dↄ̃a pↄ́ i bↄ kãioo,","poem":1},{"lineBreak":true},{"text":"mí yãnakpa ma Kɛnawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ dↄ̃ sã́asã kɛ́ ma yã́ ɛɛ vĩo,","poem":1},{"lineBreak":true},{"text":"ma ↄ̃nↄpaɛmade má kunnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lua zↄ̃ↄ, kási ìli saka gbɛ̃eguo,","poem":1},{"lineBreak":true},{"text":"a zↄ̃ↄ, yã́ pↄ́ à zɛ̀ò lilɛa vĩo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ìli gbɛ̃vãi to aàↄ kuo,","poem":1},{"lineBreak":true},{"text":"ì yã́gↄ̃gↄ̃ wɛ̃nadeↄnɛ a zɛ́waɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aà wɛ́ lí go gbɛ̃maaↄwao,","poem":1},{"lineBreak":true},{"text":"ì ń kpá kpalau ń kíaↄ sãnu,","poem":1},{"lineBreak":true},{"text":"ì to aaↄ kible gↄↄpii, aai tↄbↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó wà gbɛ̃́ↄ yèye ń mↄdaonaↄ,","poem":1},{"lineBreak":true},{"text":"tó wà wɛ́tɛ̃a ba kã̀nɛ́,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua ì yã́ pↄ́ aa kɛ̀ↄ onɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aai dↄ̃ kɛ́ wà dↄ̀ɛwà, wà tàaekɛ̀ɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì ń swã́ busanɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa e yãma yã́i,","poem":1},{"lineBreak":true},{"text":"ì dilɛnɛ́ aa mikɛ̃ yãvãiwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó aa aà yãmà mɛ́ aa zↄblèɛ̀,","poem":1},{"lineBreak":true},{"text":"aa láa maa, aai ká ń gↄↄwa ń namao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó aa gì mai,","poem":1},{"lineBreak":true},{"text":"wa ń dɛdɛ ń fɛ̃ndaoɛ,","poem":1},{"lineBreak":true},{"text":"aa kpagua dↄ̃a kɛ̃́sãma yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Luayãdansaiↄ ìↄ ĩ́ikũa ń sↄ̃u,","poem":1},{"lineBreak":true},{"text":"baa tó Lua ń yé ń mↄdaonaↄ,","poem":1},{"lineBreak":true},{"text":"aali awakpaɛ̀o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aaì ɛɛ wà gaga ń ɛ̀waasogↄↄ","poem":1},{"lineBreak":true},{"text":"lán gↄ̃ɛ káaluaↄ gaawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lua ì to wɛ̃na gbɛ̃́ le kɛ́ à aà bↄ yã́iɛ,","poem":1},{"lineBreak":true},{"text":"ì to wà gbãamↄ gbɛ̃́ɛ, kɛ́ aà swã́ e busa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Màa àlɛ n sisi à n bↄ n yooyeau,","poem":1},{"lineBreak":true},{"text":"i gɛnnↄ dɛ̀ɛpookĩi, ní gↄ̃ nzĩaɛ dↄdↄa,","poem":1},{"lineBreak":true},{"text":"n táabũnu aↄ fòona vĩo ń blɛ maaↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lua tàae'ea lán gbɛ̃vãiwa lɛ́ í sima,","poem":1},{"lineBreak":true},{"text":"n aà tàae è, ↄ̃ àlɛ n swãgaga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Laaika kɛ́ àizɛɛ su n wɛ́ bleo,","poem":1},{"lineBreak":true},{"text":"ńsu to gbagusaɛ zↄ̃ↄ n làasoo liaao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N wiilɛa a fↄ̃ n bↄ taasiue?","poem":1},{"lineBreak":true},{"text":"Baa ń dɛ̃ɛ sa pↄ́ ńlɛ kao píi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ńsu gwãasĩna nidɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩna ã́nuatoa gↄↄpi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Laaika zɛa ń vãioi,","poem":1},{"lineBreak":true},{"text":"asa wãwãpi n le kɛ́ ǹ kɛ̃ vãiwa yã́iɛ.","poem":1}]},{"type":"heading","content":["Lua mɛ́ gbãa vĩ"]},{"type":"verse","number":22,"content":[{"text":"Lua dɛ pↄ́piia a gbãa yã́i.","poem":1},{"lineBreak":true},{"text":"Démɛ yãdanɛde ũ laaàwai?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Démɛ aà yãkɛaↄ zɛ́ kàlɛɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ oɛ̀ à vãikɛ̀i?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"To aà zĩ maaboa àↄ dↄngu,","poem":1},{"lineBreak":true},{"text":"aà yã́ pↄ́ wà lɛdàò wì sipiↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃́pii wɛsì aà pↄkɛapiↄlɛ,","poem":1},{"lineBreak":true},{"text":"baade lɛ́ gwa kãaa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lua dɛ pↄ́piia,","poem":1},{"lineBreak":true},{"text":"aà zↄ̃ↄkɛ dɛ wá dↄ̃ala,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ wà aà wɛ̃ dↄdↄ wà a lɛ́ dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ì í pusu gálɛ suowa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì to à ma lou ũ à ɛa ta swai.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ì to lou sisi à kwɛ","poem":1},{"lineBreak":true},{"text":"à í zↄ̃ↄ bↄ gbɛ̃nazĩnaↄnɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Démɛ lousisia daa gua yáasi dↄ̃i?","poem":1},{"lineBreak":true},{"text":"Démɛ aà kↄ̃fĩ gbãa bↄkĩi gbadↄ̃i?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gwa! Ì to loupilɛa dagua,","poem":1},{"lineBreak":true},{"text":"a gupua ì kúlɛ ísiaa e títiu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ì kibleò bui píiwa,","poem":1},{"lineBreak":true},{"text":"ì blɛ kpaomá àↄ dińzi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"A loupilɛa naa a ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì pↄ́ pↄ́ a yei aà suwà oɛ̀.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aà kↄ̃fĩ ìↄ aà baokpa,","poem":1},{"lineBreak":true},{"text":"baa pↄtuoↄ ì dↄ̃ kɛ́ à kà kãi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}