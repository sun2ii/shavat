{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"Zàa'ĩana ì to sↄ̃ kɛ̃magu,","poem":1},{"lineBreak":true},{"text":"ìↄ vĩ kpòkpokpo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À swã́kpa à aà lↄↄ ma, àlɛ pũna,","poem":1},{"lineBreak":true},{"text":"louvĩa lɛ́ bↄ aà lɛ́u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ì loupilɛa gbaɛ musu gupiiu,","poem":1},{"lineBreak":true},{"text":"ì pílɛpilɛ e dṹnia lɛ́wa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A gbɛa ì pala gbã́ugbãu,","poem":1},{"lineBreak":true},{"text":"ì pũna ń a zↄ̃ↄkɛ lↄↄo.","poem":1},{"lineBreak":true},{"text":"Tó aà lↄↄ dↄ, ìli a pílɛa zùukɛo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lua pũnaaá yãbↄnsaɛɛ,","poem":1},{"lineBreak":true},{"text":"ì yãzↄ̃ↄkɛ, wá fↄ̃ a gbadↄ̃o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ì o lougbɛɛ aà kwɛ dṹniau,","poem":1},{"lineBreak":true},{"text":"ì o louɛ aà ma ń gbãao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì tó gbɛ̃́pii go azĩa gĩa,","poem":1},{"lineBreak":true},{"text":"kɛ́ baade e dↄ̃ ámɛ álɛ zĩkɛ we.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a nↄ̀bↄↄ ì tá ń tòou,","poem":1},{"lineBreak":true},{"text":"aaↄ ye ń ulɛkĩi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zàa'ĩana ì bↄ a kpɛ́u,","poem":1},{"lineBreak":true},{"text":"ì to ĩ́an niɛ bↄlɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua lɛ́'ĩanapi ì to í i,","poem":1},{"lineBreak":true},{"text":"í pↄ́ kálɛ nài i gↄ̃ lán lougbɛwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ì í aso di luabɛpuanaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì to lou àↄ pílɛpilɛ a guu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lousisia ìↄ bilɛbilɛkↄ̃u lá a dìlɛɛ̀wa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì da dṹniaa píi lá a òwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì mↄ́ ń a píio gotↄ̃ama ũ","poem":1},{"lineBreak":true},{"text":"ge tↄↄlɛ nínia gbɛ̃kɛkɛaɛ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yã́ɛ bee ma Yobu,","poem":1},{"lineBreak":true},{"text":"zɛ ǹ Lua dabudabuↄ gwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ń dↄ̃ lá Lua ì yãdilɛ pↄ́piↄnɛa?","poem":1},{"lineBreak":true},{"text":"Ń dↄ̃ lá ì to lou pílɛa?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ń dↄ̃ lá lousisia ìↄ looa musua?","poem":1},{"lineBreak":true},{"text":"Lua dↄ̃apaɛmade mɛ́ dabudabupi kɛ̀.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ niↄ yↄ n pↄkasaↄ guu,","poem":1},{"lineBreak":true},{"text":"tó guantɛ̃na lɛ́ mɛ'ↄ̃ tↄↄlɛwa,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ńyↄ̃ fↄ̃ ↄli musuu laaàwaa?","poem":1},{"lineBreak":true},{"text":"Luabɛpi gbãaɛ lán mↄ̀ díiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yã́ pↄ́ wá o Luaɛ dawɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"Wá yã́zɛkalɛa dↄ̃o wá wɛ́sia yã́i.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wa oɛ̀ má ye mà yã'oɛ̀ yã̀?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e a we o wà a dɛ tiaa?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ĩana fɛ̀lɛ luabɛpuana yà,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃ bↄ̀ musu sa, wɛ́ lɛ́ dↄwào,","poem":1},{"lineBreak":true},{"text":"a gbãa kɛ̀ zài.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Luabɛtɛ̃ana bↄ̀ gugbãntoo oi,","poem":1},{"lineBreak":true},{"text":"à gawi zↄ̃ↄ dà Luaɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wá fↄ̃ Gbãapiide leo,","poem":1},{"lineBreak":true},{"text":"aà iko zↄ̃ↄ, ìↄ yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"ìli yã́zɛde fuangbao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ayãmɛto gbɛ̃nazĩna ì vĩakɛɛ̀,","poem":1},{"lineBreak":true},{"text":"asa ìli ↄ̃nↄnaↄ yãdao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}