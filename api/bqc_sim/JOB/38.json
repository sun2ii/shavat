{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":38,"content":[{"type":"heading","content":["Dii yã́zãsia Yobuwa"]},{"type":"verse","number":1,"content":["Ɔ̃ Dii yã́zãsì Yobuwa zàa'ĩana guu à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Démɛ lɛ́ ↄ̃nↄ ↄ̃̀ↄkpa","poem":1},{"lineBreak":true},{"text":"ń yãfaasai oaoi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sↄukɛ lán gↄ̃sawa,","poem":1},{"lineBreak":true},{"text":"má n la yã́i, ní wea.","poem":1}]},{"type":"heading","content":["Lua mɛ́ dṹnia kɛ̀"]},{"type":"verse","number":4,"content":[{"text":"Kɛ́ ma dṹnia kàlɛ, ń kú má ni?","poem":1},{"lineBreak":true},{"text":"Tó ń a dↄ̃a vĩ, omɛɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Démɛ a kↄↄlɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ ba yↄ̃̀wài? Ń dↄ̃ nolo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wà a gbá pɛ̀lɛ bↄ́wa ni?","poem":1},{"lineBreak":true},{"text":"Démɛ a ɛ̃ dàalɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"gↄↄ pↄ́ gudↄlɛia saanaↄ lɛ́ gulakɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ luabɛ gbãadeↄ","poem":1},{"noteId":17},{"text":"kúkua dↄ píii?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ́ ísia bↄ̀ a da gbɛɛu,","poem":1},{"lineBreak":true},{"text":"démɛ kaa lìai à a zùukɛ̀i?","poem":1},{"noteId":18}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma luabɛpuana dàɛ̀ pↄkasa ũ,","poem":1},{"lineBreak":true},{"text":"ma sua fĩ̀wà ulada ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma a zɛkĩi lɛ́ dàɛ̀,","poem":1},{"lineBreak":true},{"text":"ma zɛtàɛ̀ ma gbã́a dàu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má òɛ̀: Nìli mↄ́ la, ńsu vĩao,","poem":1},{"lineBreak":true},{"text":"n ikooa zↄ̃ↄↄ zɛ la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N yãdìlɛ kↄↄɛ yãae?","poem":1},{"lineBreak":true},{"text":"N bↄkĩi ↄ̀lↄ gudↄaɛa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gudↄa ì dṹnia kṹ a gola síiↄ̃wa,","poem":1},{"lineBreak":true},{"text":"ì vãikɛnaↄ kpoɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì dṹnia lilɛ lán oo pↄ́ wà seelakɛ̀wàwa,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄ ì bↄ gupuau lán ula kpóũkpoũna kɛawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì gi vãikɛnaↄnɛ aa ń gusiayã kɛ,","poem":1},{"lineBreak":true},{"text":"ì ń ↄ pↄ́ aa sɛ̀ musu ɛ́'ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"N gɛ e za ísia nibↄnaↄ kĩ́ia?","poem":1},{"lineBreak":true},{"text":"N bɛbɛ ísipi nↄnau yãae?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wà ga gãmↄ ↄ̀lↄnɛa?","poem":1},{"lineBreak":true},{"text":"N bɛda bĩ́ibↄlɛↄ èa?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N dṹnia yàasa lɛ́ tàasikàa?","poem":1},{"lineBreak":true},{"text":"Tó ń yã́ beeↄ dↄ̃ píi, omɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gupua bɛn mái?","poem":1},{"lineBreak":true},{"text":"Ń gusiakukĩi dↄ̃e?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ gɛ́ńnↄ ń bùsuua?","poem":1},{"lineBreak":true},{"text":"Ń ń bɛ zɛ́ dↄ̃o lé?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ń dↄ̃, asa wà n i gↄↄ bee nolo?","poem":1},{"lineBreak":true},{"text":"N wɛ̃ lɛ́ vĩo nolo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"N gɛ̃ làasi pↄ́ ma guniɛ kàlɛua?","poem":1},{"lineBreak":true},{"text":"N ma lougbɛ dↄ̃ èa?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Miↄ kũa taasikɛgↄↄ pↄ́ ũɛ,","poem":1},{"lineBreak":true},{"text":"mi gbaɛ zĩkagↄↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gupua ì ligua kpelewa ni?","poem":1},{"lineBreak":true},{"text":"Ĩana ì bↄ à li tↄↄlɛa kpelewa ni?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Démɛ ì loukwɛa dazɛwai?","poem":1},{"lineBreak":true},{"text":"Démɛ ì zɛbↄ loupilɛaɛi?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ì to lou ma tↄↄlɛ pↄ́ gbɛ̃e kuou,","poem":1},{"lineBreak":true},{"text":"baa sɛ̃gbãu gu pↄ́ gbɛ̃nazĩna vĩo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ì bɛzia ń tàaao níni,","poem":1},{"lineBreak":true},{"text":"ì to sɛ̃ bↄlɛ we.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lou de'ia vĩe?","poem":1},{"lineBreak":true},{"text":"Démɛ dɛ sua pↄ́ ì kpa mae ũi?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dé nɛasakpɛ lougbɛ ì bↄui?","poem":1},{"lineBreak":true},{"text":"Démɛ ì fíi i, ↄ̃ i gbasa kpai?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Démɛ ì to í fee lán gbɛwa","poem":1},{"lineBreak":true},{"text":"à to ísia musu gbãakũi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ńyↄ̃ fↄ̃ saana pↄ́ kãaaoↄ kãaaa?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ Saan kífɛ̃nɛnaↄ kɛ̃kↄ̃waa?","poem":1},{"noteId":19}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ Saan nↄ̀ↄ'imina bilɛ a gↄↄwaa?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ bↄ ń Saan ko nɛadeo ń a nɛ́ↄa?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ń musupↄↄ ikoyã dↄ̃a?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ ǹ ń kpá kpalau tↄↄlɛa?","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ lɛzu louzi à sisi","poem":1},{"lineBreak":true},{"text":"à ibↄ à n gbɛ̃a?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ni loupilɛaↄ gbaɛ aa dazɛu nɛe?","poem":1},{"lineBreak":true},{"text":"Aaì mↄ onɛ wa làa yã̀?","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Démɛ ↄ̃nↄ dà kpↄbↄ'ilɛnaɛi?","poem":1},{"lineBreak":true},{"text":"Démɛ dↄ̃a kpà kosawai?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Dé ↄ̃nↄ mɛ́ kà à lounaaↄ naoi?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ musu olaↄ yɛɛlɛi?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Tó a ibↄ̀lɛ, bùsu giina ì gↄ̃ bɛ̀lɛ ũ,","poem":1},{"lineBreak":true},{"text":"bùsukↄ̃ↄtɛ̃ↄ ì nanakↄ̃wa.","poem":1}]},{"type":"heading","content":["Lua mɛ́ nↄ̀bↄↄ kɛ̀"]},{"type":"verse","number":39,"content":[{"text":"Gↄↄ pↄ́ nↄ̀ↄmusuↄ naalɛa ń tòou,","poem":1},{"lineBreak":true},{"text":"ge aalɛ nↄ̀ↄ kpakpa dào guu,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ni toekanɛ́a?","poem":1},{"lineBreak":true},{"text":"Ḿmɛ ni to an nɛ́ↄ kãaa?","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Tó gbagbaa nɛ́ↄ lɛ́ liaaliaa,","poem":1},{"lineBreak":true},{"text":"aalɛ lɛzumazi blɛkɛ̃sãama yã́i,","poem":1},{"lineBreak":true},{"text":"démɛ ì pↄblea kpámái?","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"38.7 Yob 1.6","reference":{"chapter":38,"verse":7}},{"noteId":18,"caller":"+","text":"38.8 Zel 5.22","reference":{"chapter":38,"verse":8}},{"noteId":19,"caller":"+","text":"38.31 Amↄ 5.8","reference":{"chapter":38,"verse":31}}]},"thisChapterLink":"/api/bqc_sim/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":40}