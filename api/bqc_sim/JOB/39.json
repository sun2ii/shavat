{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Ń tue nɛ'igↄↄ dↄ̃e?","poem":1},{"lineBreak":true},{"text":"N bana è gↄↄ pↄ́ àlɛ nɛ'ia?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ni ń nↄ mↄ dↄdↄe?","poem":1},{"lineBreak":true},{"text":"Ni ń nɛ'igↄↄ dↄ̃e?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aaì kúlɛ aa nɛ'iɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an nɛ'iwãwã ì kpálɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An nɛ́ↄ ì gbãakũ sɛ̃u, aaì pɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"aaì gɛ̃zɛa, aali su ń daↄwa lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Démɛ tò sɛ̃̀a zàa'ĩna gↄ̃̀ azĩaɛi?","poem":1},{"lineBreak":true},{"text":"Démɛ aà pòlo gbàɛi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma sɛ̃sao dìlɛɛ̀ aà bɛ ũɛ,","poem":1},{"lineBreak":true},{"text":"ma tↄↄlɛ wiside kɛ̀ɛ̀ aà kúkĩi ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì wɛ̃́lɛ súu kɛ pↄ́ↄpↄↄɛ,","poem":1},{"lineBreak":true},{"text":"ìli gbãamↄnɛdeↄ zↄa mao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ìↄ sĩ̀sĩↄ kɛɛlɛ àↄ sɛ̃ wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ kpálɛkɛ pↄ́ ísinaↄi píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zùsɛ̃lɛ a we zĩkɛnɛe?","poem":1},{"lineBreak":true},{"text":"A we i n tàaakalɛkĩie?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ba dↄwà aà sa panɛe?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ zuudaɛ̀ aà kpase kɛ̃nɛe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ aà náaikɛ aà gbãa zↄ̃ↄ yã́ie?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ wei ǹ n zĩ toɛ̀e?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ aà náaikɛ,","poem":1},{"lineBreak":true},{"text":"aà n pↄ́wɛna sɛ́sɛ suonɛ zɛue?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Taataa ì a gã̀sĩa poo ń pↄnao,","poem":1},{"lineBreak":true},{"text":"a muaa ń wàaliana gã̀sĩa kã́oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì gbeda zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"ì to ũfãa gbepiↄ wã à pipi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɛ́ wa su kɛ̀sɛpɛlɛwà à wíwi,","poem":1},{"lineBreak":true},{"text":"ge sɛ̃̀anↄbↄↄ ↄ̃zↄ̃wà líↄ dↄaàguo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ìↄ pãsĩ ń a nɛ́ↄ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ dↄ̃ se aàzĩa nɛ́ↄ no,","poem":1},{"lineBreak":true},{"text":"zĩ pã kɛa lí kɛɛ̀ yãe ũo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Asa mi aà gba ↄ̃nↄo,","poem":1},{"lineBreak":true},{"text":"mi aà baa da faadeↄ guuo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ãma tó à pòo à bↄ̀ ń bao,","poem":1},{"lineBreak":true},{"text":"ì sↄ̃́ kɛ̃ɛ, ↄ̃ ì sↄ̃́pi dikpɛna yáalↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ḿmɛ ni to sↄ̃́ àↄ gbãaa?","poem":1},{"lineBreak":true},{"text":"Ḿmɛ n bã́ngasa pɛ̀pɛɛ̀ aà waawaa?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ḿmɛ ni to aàↄ vĩvĩ lán kwawaa?","poem":1},{"lineBreak":true},{"text":"Aà pↄbↄa a níu kↄ̃fĩ ì to vĩa ń kṹ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ì a gbá pã́lɛpãlɛ guzulɛu,","poem":1},{"lineBreak":true},{"text":"ì pↄnakɛ a gbãa yã́ musu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì gɛ́ dai zĩgↄ̃ↄlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ì pↄ́ pↄ́ wì vĩakɛɛ̀ yáalↄɛ,","poem":1},{"lineBreak":true},{"text":"sↄ̃ lí kɛ̃aàguo,","poem":1},{"lineBreak":true},{"text":"ìli pↄ̀ↄbↄzãkɛ fɛ̃ndaɛo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ka ìↄ kↄ̃fĩkɛ gbàlau aà musu,","poem":1},{"lineBreak":true},{"text":"sↄ̃mpɛpɛɛ ń sↄ̃n gésedeo ì tɛkɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó wà zĩ̀mↄ pɛ̀,","poem":1},{"lineBreak":true},{"text":"ìliↄ azĩa dakĩi dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ìↄ tↄↄlɛ gbɛ̃ ìↄ vĩvĩ,","poem":1},{"lineBreak":true},{"text":"ìↄ kɛ sɛ̀ɛsɛɛsɛɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó wà kuupɛ̀,","poem":1},{"lineBreak":true},{"text":"ì pↄbↄ a níu à mɛ̀ ɛ̃hɛ̃ɛ!","poem":1},{"lineBreak":true},{"text":"Ìↄ zĩ ĩ́anasɛsɛ za zã̀zã","poem":1},{"lineBreak":true},{"text":"ń dↄaanaↄ kↄ̃fĩ gbãao ń kúkuakɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"N ↄ̃nↄ mɛ́ tò bleaa ì vua","poem":1},{"lineBreak":true},{"text":"à a gã̀sĩa poo à gɛ́ gɛↄmidↄkĩi oia?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń dìlɛ yãamusuɛ","poem":1},{"lineBreak":true},{"text":"aàli yàakpa, i a sakpɛ da musua?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ìↄ ku gbɛ musu, we ì iu,","poem":1},{"lineBreak":true},{"text":"ì pɛ gbɛ̀ misonawa a aafia'ekĩi ũ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Za we ìↄ pↄblea gwagwau,","poem":1},{"lineBreak":true},{"text":"ì pↄ́ↄ wɛ́pa kãaa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Au mɛ́ aà nɛ́ↄ pↄblea ũ,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ pↄgɛ kuu, ìↄ ku weɛ.","poem":1},{"noteId":20}]}],"footnotes":[{"noteId":20,"caller":"+","text":"39.30 Mat 24.28, Luk 17.37","reference":{"chapter":39,"verse":30}}]},"thisChapterLink":"/api/bqc_sim/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}