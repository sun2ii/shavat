{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":4,"content":[{"type":"heading","content":["Gbɛ̃́ pↄ́ Lua ì aà toto mɛ́ báaa vĩ"]},{"type":"verse","number":1,"content":["Ɔ̃ Temani gbɛ̃́ Ɛlifaza yã́zãsìwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Tó gbɛ̃́ wↄ́ↄ fↄ̃̀ yã'ònɛ, ńyↄ̃ mɛnaòoa?","poem":1},{"lineBreak":true},{"text":"Asa ma lɛ́ a fↄ̃ àↄ kpaaũao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwa, n lɛdà gbɛ̃́ↄwa dasi,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ pↄ́ an yɛ̃̀ɛɛ làaↄ gbà sↄ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yã́ gbɛ̃́ pↄ́ lɛ́ fuↄ sɛ̀ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ pↄ́ naalɛaↄ gbà gbãa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ́ yã́ n le sa sↄ̃, ńlɛ fu,","poem":1},{"lineBreak":true},{"text":"kɛ́ à n le, ↄ̃ bíli n kũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N vĩakɛa Luaɛ lí tó n mi àↄ daa íao lé?","poem":1},{"lineBreak":true},{"text":"N kua tàaesai lí tó n nↄ̀sɛ àↄ daa doũo lé?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Làasookɛ!","poem":1},{"lineBreak":true},{"text":"Démɛ i yãe kɛo, ↄ̃ à mìdɛi?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃maa ku má ↄ̃ wà aà suumpai?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ vãi sa pà à yãkele tↄ̃̀wà,","poem":1},{"lineBreak":true},{"text":"málɛ e bee mɛ́ ì bↄlɛɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua lɛ́'ĩana ì aà midɛ,","poem":1},{"lineBreak":true},{"text":"aà pↄbↄa a níu ì aà tↄ̀lↄzↄ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà kãaa lán nↄ̀ↄmusuwa lɛ́ ì ká,","poem":1},{"lineBreak":true},{"text":"Lua ì aà swaa ɛ́'ɛɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì ga lán nↄ̀ↄmusu pↄ́ nↄ̀ↄ wɛ̀ɛlɛ kùawàwa,","poem":1},{"lineBreak":true},{"text":"aà nɛ́ↄ i fãaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yã́kpãina mↄ̀a ĩ́ana guu,","poem":1},{"lineBreak":true},{"text":"yã́pi feena gɛ̃̀ ma swã́u,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"gↄↄ pↄ́ málɛ nana yàaa o gwãasĩna,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ izↄ̃ↄ daa gbɛ̃́ↄla.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vĩa ma kũ, málɛ lualua,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ bṹu lɛ́ dee.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĩana ma oa pà,","poem":1},{"lineBreak":true},{"text":"ma mɛkã fɛ̀lɛ sĩ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À zɛ̀, mi a taa dↄ̃o,","poem":1},{"lineBreak":true},{"text":"pↄ́pi ku ma aɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma aà lↄↄ kpã́ina mà à mɛ̀:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna yã́ aↄ na Luaɛe?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ àↄ zɛ̃a a Kɛna aɛi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lá Lua lí a malaikaↄ náaikɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ ì a zↄ̀blenapiↄ tàae e,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"wa wá gbɛ̃́ pↄ́ wá mɛ dɛ gĩ̀ kpɛ́ ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ wá daalɛa dɛ bùsu giina ũ,","poem":1},{"noteId":5},{"lineBreak":true},{"text":"wì wá suumpa lán kitolowa pↄ́ oa?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Za kↄↄ e oosi gbɛ̃́ↄ ì gaga,","poem":1},{"lineBreak":true},{"text":"aaì sãalɛ e gↄↄpii, wìli ń fãnkɛo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lua ì ń kpɛ́pi gbapɛlɛ wolɛnɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì ga ↄ̃nↄkũsai.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"4.19 Daa 2.7, 3.19","reference":{"chapter":4,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}