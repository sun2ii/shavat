{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":40,"content":[{"type":"heading","content":["Gbɛ̃nazĩna lí fↄ̃ Lua bɛ̃̀ɛbòo"]},{"type":"verse","number":1,"content":["Ɔ̃ Dii ɛ̀a ò Yobuɛ:"]},{"type":"verse","number":2,"content":[{"text":"Ma Gbãapiide,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ma tàae e ǹ ma gba laaia?","poem":1},{"lineBreak":true},{"text":"Luabɛ̃ɛbona, yã́zãsia sa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Ɔ̃ Yobu wèwà à mɛ̀:"]},{"type":"verse","number":4,"content":[{"text":"Má pↄe ũo, kpelewa má wemai?","poem":1},{"lineBreak":true},{"text":"Sema mà ↄku ma lɛ́wa bàasio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma yã'ò gɛ̃n doɛ, má ɛa o lↄo,","poem":1},{"lineBreak":true},{"text":"má ò gɛ̃n pla se, má a zã́si lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Ɔ̃ Dii ɛ̀a yã'ò Yobuɛ zàa'ĩana guu à mɛ̀:"]},{"type":"verse","number":7,"content":[{"text":"Sↄukɛ lán gↄ̃sawa,","poem":1},{"lineBreak":true},{"text":"má yãlalama, ní wea.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ láka ma yãkɛa a zɛ́waa yã̀?","poem":1},{"lineBreak":true},{"text":"Ń ye ǹ yã́'ĩikpaa, n yãna bↄ yã̀?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gã̀sa gbãa kàmawaa?","poem":1},{"lineBreak":true},{"text":"N lↄↄ a fↄ̃ gu dee lamawaa?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zↄ̃ↄkɛ ń kíakɛo da nↄamblebↄↄ ũ,","poem":1},{"lineBreak":true},{"text":"gawi ń bɛɛɛo da ulada ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ n pↄfɛ̃bↄbↄmá,","poem":1},{"lineBreak":true},{"text":"waladeↄ gwa ń wɛpãsĩo, widamá.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waladeↄ gwa ń wɛpãsĩo, ní ń lao,","poem":1},{"lineBreak":true},{"text":"ↄ̃zↄ̃má gu pↄ́ aa kuu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ní ń vĩlɛ tɛ̃́ɛnau píi,","poem":1},{"lineBreak":true},{"text":"ní pↄ́ fĩ ń oawa miau,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mí gbasa mà n sáaukpa,","poem":1},{"lineBreak":true},{"text":"kɛ́ n fↄ̃ n zĩblè ń n ↄplaao yã́i.","poem":1}]},{"type":"heading","content":["Dalagↄ̃ↄ"]},{"type":"verse","number":15,"content":[{"text":"Dalagↄ̃ↄ gwa,","poem":1},{"lineBreak":true},{"text":"mámɛ ma aà kɛ̀ lá ma n kɛwa.","poem":1},{"lineBreak":true},{"text":"Ì sɛ̃ ble lán zuwaɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aà yɛ̃̀ɛɛ ku aà wokpɛɛ,","poem":1},{"lineBreak":true},{"text":"aà gbãa ku aà kutɛlɛnawaɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ì a vlã́ poo lán sɛdɛ líwa,","poem":1},{"lineBreak":true},{"text":"aà gbala kĩ dɛ lán bataɛawaɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aà wáↄ dɛ lán mↄgotɛ̃wa,","poem":1},{"lineBreak":true},{"text":"aà mɛguↄ dɛ lán mↄ̀ gowa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aà zↄ̃ↄ mɛ́ dɛ pↄ́ bɛ̃́ɛ pↄ́ má kɛ̀ↄla,","poem":1},{"lineBreak":true},{"text":"mapi aà Kɛna ma fɛ̃nda kɛ̀ɛ̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ mɛ́ aà blɛ'ekĩi ũ,","poem":1},{"lineBreak":true},{"text":"we sɛ̃̀anↄbↄↄ ì kↄ̃̀ↄ'ou píi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ì wúlɛ íu kↄ̀lↄwɛɛ zíɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ ye feeu dã̀na guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kↄ̀lↄwɛɛ ue ì daaàla,","poem":1},{"lineBreak":true},{"text":"swagbalalaↄ ì kákaaàla.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Baa tó swa gbakàka, ìli leelekɛo,","poem":1},{"lineBreak":true},{"text":"tó Yuudɛ̃ isukaa lɛ́ aà lɛ́ lé, ìli deeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ńlɛ e wa fↄ̃ wà aà wɛ́ wíwi, wi aà kũ nɛe?","poem":1},{"lineBreak":true},{"text":"Ńlɛ e wa e kↄ̃nikɛɛ̀, wi aà ní fↄ̃́ yã̀?","poem":1}]},{"type":"heading","content":["Kwãsa"]},{"type":"verse","number":25,"content":[{"text":"Ńyↄ̃ fↄ̃ kwãsa kṹ ń kokoao ǹ gálɛ ǹ bↄòe?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ ba dↄ aà lɛ́nawae?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ bà lɛɛna ká aà níue?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ ǹ aà lɛtã zíɛ fↄ̃́ ń kúlaoe?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A awakpakpanɛe?","poem":1},{"lineBreak":true},{"text":"A yã́ nana onɛe?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A lɛdoũkɛnnↄ","poem":1},{"lineBreak":true},{"text":"ǹ a sɛ n zↄ ũ e a wɛ̃ni lɛ́u nɛe?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ kↄ̃̀ↄ'oò lá wì o ń bãowae?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ ba dↄwà ǹ kpa n nɛnↄɛnaↄwae?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Laatanaↄ kwãsapi tↄɛmáe?","poem":1},{"lineBreak":true},{"text":"Laayianaↄ aa aà tↄ̃nↄnakɛkↄ̃ɛe?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ ǹ aà pápa ń saao ǹ aà báa fↄ̃́e?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ ǹ aà mi kɛ yáiyai ń sↄ̃naoe?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wɛɛlɛ ↄkãwà ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Dɛ̃ɛpi a sãnguo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ si a sìawa lↄo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":32}