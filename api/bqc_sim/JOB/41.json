{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Tó ńlɛ e ńyↄ̃ aà kũɛ,","poem":1},{"lineBreak":true},{"text":"ńlɛ nzĩa sãsãɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛsìaàlɛ, ńyↄ̃ gↄ̃ zɛ sã̀iiɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lá gbɛ̃e wↄ́ↄ i ka à to aà go a tíao,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ zɛ ma aɛ sↄ̃i?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ ma le à o ma fĩaboɛi?","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ kú dṹniau píiá ma pↄ́ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Má gí kwãsapi gbáↄ yã'oio","poem":1},{"lineBreak":true},{"text":"ge aà gↄ̃sakɛ ge aà kɛfɛnkɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ à aà tɛɛ woloi?","poem":1},{"lineBreak":true},{"text":"Démɛ a we ã̀asĩna kaɛ̀i?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Démɛ a we à aà lɛ́ wɛ̃aai?","poem":1},{"lineBreak":true},{"text":"Aà swaa aà lɛ́ pà mɛ́ a kai vĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aà tɛɛ dɛ lán sɛ̀ngbaoↄwa aà kpɛsɛa,","poem":1},{"lineBreak":true},{"text":"a daaĩa sàlala fòonasai dↄ̀ↄdↄↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aà tɛɛpiↄ nanaakↄ̃waɛ,","poem":1},{"lineBreak":true},{"text":"baa ĩ́ana lí gɛ̃kĩi euo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa pɛ́pɛakↄ̃wa gíũgiũɛ,","poem":1},{"lineBreak":true},{"text":"aa kɛ̃aaakↄ̃wa vĩo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó à nisã̀, gu ì puɛ,","poem":1},{"lineBreak":true},{"text":"aà wɛ́ dɛ lán ĩatɛ̃ bilɛa kↄↄkↄↄwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɛ́vua ì pípi aà lɛ́u,","poem":1},{"lineBreak":true},{"text":"tɛkↄna ìↄ bↄlɛu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Súɛlɛ ìↄ bↄlɛ aà níu","poem":1},{"lineBreak":true},{"text":"lán lá ísi tɛ́ pↄ́ wà oo dìwà súɛlɛwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aà lɛ́'ĩana ì to sĩsĩↄna tɛ́sɛ,","poem":1},{"lineBreak":true},{"text":"tɛ́lɛpiↄ ì bↄ aà lɛ́u.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aà gbãa ku aà waauɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kpàaũaànↄ píi ì tolootolooboɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aà báasi ì didikↄ̃a,","poem":1},{"lineBreak":true},{"text":"ì nawà gbã́ugbãu, ìli deeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aà kùa gbãa lán gbɛwa,","poem":1},{"lineBreak":true},{"text":"lán wísilↄgbɛdawa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tó à fɛ̀lɛ, sↄ̃ ì kɛ̃ nɛgↄ̃naↄguɛ,","poem":1},{"lineBreak":true},{"text":"aaì kpákpakↄ̃a aaìↄ kua gɛ́kĩiwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fɛ̃nda pↄ́ wa lɛ̀ò píi, ìli bↄwào","poem":1},{"lineBreak":true},{"text":"ge sↄ̃na ge ka ge saa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ì mↄsi dilɛ lán gàwatonawaɛ,","poem":1},{"lineBreak":true},{"text":"mↄgotɛ̃ ìↄ dɛɛ̀ lán lí mùaawa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ìli bàalɛ kaɛo,","poem":1},{"lineBreak":true},{"text":"gbɛma gbɛ ìↄ dɛɛ̀ lán ésemisinawaɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ìↄ go gwa lán sɛ̃̀ giiwaɛ,","poem":1},{"lineBreak":true},{"text":"sↄ̃na kↄ̃fĩ ìↄ dɛɛ̀ yaalↄyã ũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Aà gbɛɛ tɛɛ dɛ lán zàkologbawaɛ,","poem":1},{"lineBreak":true},{"text":"a ia ìↄ tɛ bɛ̀lɛau lán zusoon guwibↄwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ì í bilɛ títiu lán í piaoouwa,","poem":1},{"lineBreak":true},{"text":"ì ísipi ya lán nísi ikpaawa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Í seena ìↄ tɛ aà kpɛɛ,","poem":1},{"lineBreak":true},{"text":"ísipi ì ya aà kpɛ púuu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aà sáa kú dṹnia guuo,","poem":1},{"lineBreak":true},{"text":"ma pↄkɛaↄ guu ↄ̃mɛ vĩa vĩo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ì pↄ́ pↄ́ aalɛ e wa kaↄ dilɛ pãɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ nↄ̀ↄ tↄdeↄ kía ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":26}