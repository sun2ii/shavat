{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Lɛzu sa ǹ ma, tó gbɛ̃e a wema.",{"text":"Malaika kpele ńyↄ̃ liliwài?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sↄũ ì ga a yã́kũańnↄ yã́i,","poem":1},{"lineBreak":true},{"text":"mìsaide ì kpagua a wɛdↄanɛ yã́i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má è sↄũ zĩ́napɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ zĩ́napi yↄ̀ kã́ndo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ kɛ̃̀ aafia zɛ́wa,","poem":1},{"lineBreak":true},{"text":"wì ń yã́ málɛnɛ́ yã́kpalɛkɛkĩi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lí zɛńnↄo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nↄandɛnaↄ aà buapↄↄ blè,","poem":1},{"lineBreak":true},{"text":"baa pↄ́ pↄ́ à lɛkaa lìai,","poem":1},{"lineBreak":true},{"text":"imidɛnaↄ lùa aà àizɛɛi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yã'ĩa lí bↄlɛ bùsuwao,","poem":1},{"lineBreak":true},{"text":"yã'ↄ̃ma lí bↄlɛ tↄↄlɛwao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kási lá tɛkↄna gɛa musu sea vĩo,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃́ pↄ́ wa ì píi ì yã'ĩa e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó mámɛ sↄ̃, má gbɛa Luawa,","poem":1},{"lineBreak":true},{"text":"mí a yã́ kpálɛ aà gɛ̃zĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì yãzↄ̃ↄ pↄ́ wa fↄ̃ a gbadↄ̃o kɛ,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ aà yãbↄnsaɛkɛaↄ lɛ́ dↄ̃o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì to lou ma dṹniau,","poem":1},{"lineBreak":true},{"text":"ì to a í dagua sɛ̃saou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́ kpɛɛnaↄ sɛ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"ì oosisinaↄ da pↄnau.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ì yã́ pↄ́ kↄ̃nideↄ lɛ́ yá gboo,","poem":1},{"lineBreak":true},{"text":"kɛ́ an ↄ su àↄ báaa vĩo yã́i.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì ↄ̃nↄnaↄ kṹ ń kↄ̃nikɛa guu,","poem":1},{"noteId":6},{"lineBreak":true},{"text":"ì to yãfuangbanaↄ lɛdama kɛ pã.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gu ìↄ sianɛ́ fãanɛ,","poem":1},{"lineBreak":true},{"text":"aaì ↄmalɛmalɛ ĩatɛ̃ gbãa zã́ lán gwã́wa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì taasideↄ bↄ ga lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ gbãamↄnɛdeↄ ↄzĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ayãmɛto gbãasaideↄ wɛ́ aↄ dↄaàzi,","poem":1},{"lineBreak":true},{"text":"yãkpaanlakɛnaↄ i kɛ kyↄ̃́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ Lua ì aà toto ũ.","poem":1},{"lineBreak":true},{"text":"Tó Gbãapiide lɛ́ n swãgaga, ńsu gio.","poem":1},{"noteId":7}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asa ì gbɛ̃́ kɛ'ĩa, ↄ̃ ì aà bↄ gwa,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ wíwi, ↄ̃ ì aà gbã́gbã.","poem":1},{"noteId":8}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A n bↄ taasiu gɛ̃n soolo,","poem":1},{"lineBreak":true},{"text":"baa tó a dɛa, a n nɛo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A n si gawa nↄana gↄↄ,","poem":1},{"lineBreak":true},{"text":"a n bↄ fɛ̃nda lɛ́zĩ zĩlau.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii a kàedanzi kɛ́ wasu yãdↄmao yã́i.","poem":1},{"lineBreak":true},{"text":"Tó músi mↄ̀, vĩa a n kũo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ músi ń nↄanao yáalↄ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ vĩakɛ wàiↄnɛo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asa á kↄ̃ yãma ń gbɛↄ, n bú a gbɛ kao,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ na ń sɛ̃̀anↄbↄↄ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"níↄ dↄ̃ kɛ́ n ua aↄ na.","poem":1},{"lineBreak":true},{"text":"Tó n gɛ n kpàsau, pↄe a kɛ̃́são.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ dↄ̃ kɛ́ n nɛ́ↄ aaↄ dasi,","poem":1},{"lineBreak":true},{"text":"n buiↄ ligua lán sɛ̃wa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ zikũɛ, ní gbasa ga","poem":1},{"lineBreak":true},{"text":"lán ése pↄ́ wa kɛ̃̀ a gↄↄwawa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kɛ́ wa ↄlì yã́piu, lá wá èn we.","poem":1},{"lineBreak":true},{"text":"Yã́pi sí, ní dↄ̃ nzĩa yã́ ũ.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.13 1Kln 3.19","reference":{"chapter":5,"verse":13}},{"noteId":7,"caller":"+","text":"5.17 Yaa 3.11, Ɛbɛ 12.5","reference":{"chapter":5,"verse":17}},{"noteId":8,"caller":"+","text":"5.18 Oze 6.1","reference":{"chapter":5,"verse":18}}]},"thisChapterLink":"/api/bqc_sim/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}