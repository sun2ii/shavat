{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":6,"content":[{"type":"heading","content":["Yobu zↄadↄa a gbɛ̃nawa"]},{"type":"verse","number":1,"content":["Yobu yã́zãsìwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Tó wa fↄ̃ zaada ma yã'ↄ̃mau wà yↄ̃,","poem":1},{"lineBreak":true},{"text":"tó wa fↄ̃ músi pↄ́ ma le yↄ̃ lé,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a gbia aↄ dɛ ísialɛ ũfãala.","poem":1},{"lineBreak":true},{"text":"A yã́i tò ma yãyaaa'ò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbãapiide kaↄ ma kũ,","poem":1},{"lineBreak":true},{"text":"a sɛwɛ lɛ́ taalɛ ma nisĩnau.","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ Lua ì ĩadaomáↄ lìamazi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó zàa'ĩna sɛ̃ è lɛ́ ble, ì wiilɛe?","poem":1},{"lineBreak":true},{"text":"Tó zu lɛ́ pɛ̀lɛ tàaau, ì ↄ́ↄlↄe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wì pↄ́ sùusuu ble wisisaie?","poem":1},{"lineBreak":true},{"text":"Kogbepuana í ìↄ nae?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma nisĩna ye blɛ bee taaio,","poem":1},{"lineBreak":true},{"text":"ì to ma gua àↄ ye kpaaaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó ma yã́ pↄ́ má gbɛ̀a è lé!","poem":1},{"lineBreak":true},{"text":"Lua ma ka yã́ pↄ́ ma wɛ́ dↄipiwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua ma suumpa lé!","poem":1},{"lineBreak":true},{"text":"Aà ↄtↄ̃a aà ma gyawi!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ i gbasa níni,","poem":1},{"lineBreak":true},{"text":"ma pↄ iↄ na,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ ma wãwã gi ku,","poem":1},{"lineBreak":true},{"text":"asa mi lelekpa Lua pↄ́ a kua adoazio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma yɛ̃̀ɛɛ kà mà gi màↄ kue?","poem":1},{"lineBreak":true},{"text":"Ma wɛ̃ni gↄ̃a kà mà mɛnakɛe?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma gbãa kà gbɛwa yã̀?","poem":1},{"lineBreak":true},{"text":"Ma mɛ á mↄgotɛ̃ yã̀?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má fↄ̃ kaakaanakɛ lↄo,","poem":1},{"lineBreak":true},{"text":"wà ma bↄa maa zɛ́ tà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"À kũ̀ pↄsiade gbɛ̃naↄ gbɛ̃kɛkɛɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu vĩakɛa Gbãapiideɛ too yã́i.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ náai dɛ lán swa pↄ́ a í ì bawa,","poem":1},{"lineBreak":true},{"text":"lán swa'ↄna pↄ́ a í ì gɛ̃zɛawa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ì pa buziɛ, a í ì kɛ dùuduu","poem":1},{"lineBreak":true},{"text":"lougbɛ ń nɛɛzio yↄa yã́i,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ↄ̃ a í ì ba saɛ, a ɛ ì tɛ́kũ,","poem":1},{"lineBreak":true},{"text":"a í ì sãalɛ ĩatɛ̃ gbãa zã́.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tágɛnaↄ ì kɛ̃ zɛ́wa,","poem":1},{"lineBreak":true},{"text":"aaì si guwaiwaiu aa ga we.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tema tagɛnaↄ ì í wɛɛlɛ swapiu,","poem":1},{"lineBreak":true},{"text":"Seba laatanaↄ wɛ́ ìↄ dↄ ípizi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tó aa kà, an gɛɛ ì gↄ̃ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"aa í'ea náai vĩ we, ↄ̃ tãmaa ń nɛ́.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Màa ápiↄ sↄ̃, mi pↄe ewáo,","poem":1},{"lineBreak":true},{"text":"kɛ́ a yãpãsĩ pↄ́ ma le è, vĩa á kṹ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma pↄe gbɛ̀awá yã̀?","poem":1},{"lineBreak":true},{"text":"Má òɛ́ à ma gba pↄ́ á gbãa lɛ́u yã̀?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ à ma bↄ ibɛɛↄ ↄzĩ yã̀?","poem":1},{"lineBreak":true},{"text":"Má òɛ́ à ma si gbɛ̃́ pãsĩↄwae?","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"À yã́ pↄ́ ma zãwà ↄlↄmɛɛ,","poem":1},{"lineBreak":true},{"text":"í ma wɛ́ kɛ̃́mɛɛ, mí nílɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yã́zɛde oanɛ́ mɛ́ zɛvĩ,","poem":1},{"lineBreak":true},{"text":"ãma ma bɛ̃̀ɛ pↄ́ á bò zɛvĩo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Á ye yáasi pↄ́ má kɛ̀ↄ bɛ̃̀ɛbo yã̀?","poem":1},{"lineBreak":true},{"text":"I tãmaasaide yã́ gwa yãbↄlɛ ũ yã̀?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Á líkpa nɛtonɛ sɛa yã́ musu,","poem":1},{"lineBreak":true},{"text":"á á gbɛ̃na kpámá ↄda'ea yã́i.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Á yã́ na, à lili à ma gwa.","poem":1},{"lineBreak":true},{"text":"Ma wɛ́ aↄ pɛ á wɛ́u, míↄ ɛɛtoɛ́a?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À suɛ! Ásu ma yã́ gwa koleao.","poem":1},{"lineBreak":true},{"text":"À ɛa làasookɛ, ma yã́ mɛ́ zɛvĩ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma lɛdà yãkpaanlau yãae?","poem":1},{"lineBreak":true},{"text":"Má yãvãi dↄ̃ noa?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}