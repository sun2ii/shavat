{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":7,"content":[{"type":"heading","content":["Yobu zↄadↄa Luawa"]},{"type":"verse","number":1,"content":["Gbɛ̃nazĩna kua dṹniauá dɛ̃ɛɛ.",{"text":"Aà kua dɛ lán gbɛ̀wina kuawaɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"lán zↄ pↄ́ lɛ́ ue nidɛ kuawa,","poem":1},{"lineBreak":true},{"text":"ge gbɛ̀wina pↄ́ a wɛ́ ìↄ dↄ a aseai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma luakpama mɛ́ kua pã ũ mↄ ń mↄo,","poem":1},{"lineBreak":true},{"text":"Lua ma da taasiu gwã́ ń gwã́o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ma wulɛ, mi mɛ má fɛlɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Gwãasĩna ìↄ gbã̀a, miↄ pelembo e gu gɛ dↄò.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kↄ̀ↄ ń bↄtɛɛo fĩ̀fĩ ma mɛwa,","poem":1},{"lineBreak":true},{"text":"ma mɛbaa kàsaakũ̀, ìↄ ibↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma gↄↄↄ ìↄ gɛ̃ ń bao lán zwã̀atãna kↄↄzuawa,","poem":1},{"lineBreak":true},{"text":"ìↄ gɛ̃zɛa wɛdↄa pↄ́i sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lua, dↄ̃ kɛ́ ma wɛ̃ni dɛ lán lɛ́'ĩanawaɛ,","poem":1},{"lineBreak":true},{"text":"má aafiaʼe bau lↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lá ńlɛ ma e, ńyↄ̃ ma e lↄo.","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ wɛ́kpalɛmazi, kási máↄ ku lↄo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá luabɛpuana ì gusikɛ à gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃́ pↄ́ tà bɛdau lí fɛlɛo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ìli ɛa su a bɛ lↄo,","poem":1},{"lineBreak":true},{"text":"aà yã́ lí dↄ aà bɛdeↄgu lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ayãmɛto má a lɛ́ kpaaũo,","poem":1},{"lineBreak":true},{"text":"má yã'o ma yeelɛa guu,","poem":1},{"lineBreak":true},{"text":"má zↄaka ma nↄ̀sɛ ↄ̃̀ↄkpaa yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ísia ge kpↄ̀ gbɛ̃̀nɛn ma ũ","poem":1},{"lineBreak":true},{"text":"kɛ́ ni ma dↄ̃́aa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó ma mɛ̀ ma lii a ma sↄ̃ dadoũ,","poem":1},{"lineBreak":true},{"text":"ge ma wúlɛbↄ a ma nↄ̀sɛ nínimɛɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ↄ̃ ni to vĩa ma kũ nana guu,","poem":1},{"lineBreak":true},{"text":"ni to gili gɛ̃magu wɛ́pungu'eau.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma waa fĩa a kɛmɛɛ na dɛ kɛ́ beea,","poem":1},{"lineBreak":true},{"text":"ga maamɛɛ dɛ ma wãwãɛ beea.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mi saka ma wɛ̃nigu,","poem":1},{"lineBreak":true},{"text":"má ye màↄ ku gↄↄpiio.","poem":1},{"lineBreak":true},{"text":"Ma tó tɛɛɛ, asa ma kua ku pↄe lɛ́io.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bↄ́n gbɛ̃nazĩna ũ kɛ́ niↄ aà kã́fĩ,","poem":1},{"lineBreak":true},{"text":"niↄ làasookɛ aà yã́wai?","poem":1},{"noteId":9}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Niↄ aà tàasika lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"niↄ aà lɛ ǹ aà gwa gↄↄpii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ n wɛ́ woa baa yↄↄ","poem":1},{"lineBreak":true},{"text":"mà e lɛ́'i mↄ́ yá?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma duunakɛ̀ yã̀? Bↄ́ má kɛ̀nɛi?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩngwana, àkɛa n ma kɛ n pↄdɛa ũi?","poem":1},{"lineBreak":true},{"text":"Ma gↄ̃nɛ aso ũ yã̀?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bↄ́yãi nili ma tàaeↄ kɛ̃a","poem":1},{"lineBreak":true},{"text":"ǹ ma duuna woloao ni?","poem":1},{"lineBreak":true},{"text":"Asa má gɛ̃ tɛ̃́ɛnau tia, máↄ ku lↄo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ kpálɛkɛmazi, ńyↄ̃ ma eo.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"7.17 Soũ 8.4, 144.3","reference":{"chapter":7,"verse":17}}]},"thisChapterLink":"/api/bqc_sim/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}