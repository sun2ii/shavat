{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":8,"content":[{"type":"heading","content":["Baade ì a tàae gbɛ'eɛ"]},{"type":"verse","number":1,"content":["Ɔ̃ Sua gbɛ̃́ Bilidada yã́zãsìwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Ńyↄ̃ↄ yã́ bee taa o e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Ńlɛ yãbↄlɛ bùuu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lua ì yã́zɛde fuangbaa?","poem":1},{"lineBreak":true},{"text":"Gbãapiide ì yãmaa bãdɛa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lá n nɛ́ↄ duunakɛ̀ɛ̀,","poem":1},{"lineBreak":true},{"text":"a tò aa ń tàaeↄ gbɛ'è.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó n Lua kĩ́i wɛ̀ɛlɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n sùuugbɛ̀a Gbãapiidepiwa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"tó ń gbãsĩ vĩo mɛ́ ń maa,","poem":1},{"lineBreak":true},{"text":"baa e tia a fɛlɛ n wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"i n bɛ yã́ gↄ̃́gↄ̃nɛ a zɛ́wa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N gwea káau a kɛnɛ pↄe ũo,","poem":1},{"lineBreak":true},{"text":"n gwea gbɛzã aↄ kã́fĩa vĩ maamaaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gbɛ̃́ ziↄ la,","poem":1},{"lineBreak":true},{"text":"ní ↄ̃nↄ pↄ́ an deziↄ kpálɛkɛ̀i dↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa nɛ́ zĩ́anaↄn wá ũ, wá yãe dↄ̃o,","poem":1},{"lineBreak":true},{"text":"wá kua dṹniau ì gɛ̃zɛa lán uenawaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ zipiↄ yã́ a n wɛ́ kɛ̃o lé?","poem":1},{"lineBreak":true},{"text":"Aa ń nↄ̀sɛ guu yã'onɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛfu ì kɛ maa dã̀nasaie?","poem":1},{"lineBreak":true},{"text":"Fee ì zↄ̃ↄkũ isaia?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó wi zↄ̃o, baa ń a lá'isikɛo,","poem":1},{"lineBreak":true},{"text":"a lá ì giigaga àa dɛ sɛ̃ↄla píi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Màa a dɛ ń gbɛ̃́ pↄ́ Lua yã́ sã̀aàguo,","poem":1},{"lineBreak":true},{"text":"beewa tãmaa a luayãdansai nɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sↄuba nian do ↄ̃ ì a náaikɛ,","poem":1},{"lineBreak":true},{"text":"dã̀nsaba ↄ̃ ì gbãa'ewà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì sↄ̃kpalɛ bapizi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ bapi lí fↄ̃ aà kũ̀o.","poem":1},{"lineBreak":true},{"text":"Ì didi bapiwa, ↄ̃ bapi ì fua.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A gↄ̃naↄ ì dagua káau","poem":1},{"lineBreak":true},{"text":"lán lí pↄ́ ìↄ í vĩ ĩatɛ̃ gbãaiwa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ↄ̃ a zĩ́naↄ ì fĩakↄ̃i gu gbɛdeu,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃ gbɛↄu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó wa ga wòlɛ a pɛ́kĩi,","poem":1},{"lineBreak":true},{"text":"gupi ì lelekpaaàzi à mɛ:","poem":1},{"lineBreak":true},{"text":"Má n dↄ̃ yãao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zɛ́ pↄ́ a sɛ̀pi pↄna lɛ́n we,","poem":1},{"lineBreak":true},{"text":"ↄ̃ pↄpãleↄ ì bↄlɛ tↄↄlɛpiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lua lí gí tàaesaidezio fá,","poem":1},{"lineBreak":true},{"text":"mɛ́ ìli vãikɛnaↄ gba gbãao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A to ǹ yáalↄ tia,","poem":1},{"lineBreak":true},{"text":"ní kúkuakɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A wida n zangudeↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãipiↄ bɛ a gↄ̃ bɛzia ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}