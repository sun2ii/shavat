{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOB","translationId":"bqc_sim","name":"Yobu","commonName":"Yobu","title":"YOBU","order":18,"numberOfChapters":42,"sha256":"a186e346eda5c0c1640e023d85e480515b4f3e97a2d034a02821d5124637e2b6","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqc_sim/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":9,"content":[{"type":"heading","content":["Lua gbãa dɛmala"]},{"type":"verse","number":1,"content":["Ɔ̃ Yobu mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Sĩanaɛ, má dↄ̃ màa.","poem":1},{"lineBreak":true},{"text":"Kpelewa gbɛ̃nazĩna yã́ aↄ na Luaɛi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ ye lɛkpaakɛaànↄ,","poem":1},{"lineBreak":true},{"text":"yã́ mɛ̀n ↄ̀aa sↄo guu a fↄ̃ mɛ̀ndo zã́siwào.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aà ↄ̃nↄ kɛ̀ zài mɛ́ aà gbãa zↄ̃ↄ.","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ giɛ̀, ade i bↄ aafiai?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ì gbɛ̀sĩsĩↄ sↄ̃, aaliↄ dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ì ń fuangba ń pↄkũmao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ì tↄↄlɛ lualua à sↄ̃,","poem":1},{"lineBreak":true},{"text":"ì to a gbapɛlɛↄ zĩazĩa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì yã'o ĩatɛ̃ɛ, ↄ̃ ì gí bilɛi,","poem":1},{"lineBreak":true},{"text":"ì pↄ́ku saanaↄla.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ musu kpàlɛ ado,","poem":1},{"lineBreak":true},{"text":"ì táa'o ísia ikooaↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À saanaↄ kɛ̀ gudoũ,","poem":1},{"lineBreak":true},{"text":"Kífɛ̃nɛna ń Ko nɛadeo","poem":1},{"noteId":10},{"lineBreak":true},{"text":"ń pↄ́ pↄ́ kú gɛↄmidↄkĩi oiↄ píi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì yãzↄ̃ↄkɛ, wìli fↄ̃ dↄ̃̀o,","poem":1},{"lineBreak":true},{"text":"ì yãbↄnsaɛↄ kɛ, a lɛ́ vĩo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì gɛ̃mala, mili aà eo,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃zɛa, mili aà wɛ́pao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ì pↄ́ símá, démɛ a fↄ̃ giɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ oɛ̀, bↄ́ ńlɛ kɛ màaii?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lua lí to a pↄkũma kpàlɛo,","poem":1},{"lineBreak":true},{"text":"baa Ílɛnↄbↄ zↄ̃ↄ","poem":1},{"noteId":11},{"text":"dↄnlɛdeↄ vlãnàuɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mapi sↄ̃ má fↄ̃ yã́zãsiwàe?","poem":1},{"lineBreak":true},{"text":"Má fↄ̃ lɛkpaakɛaànↄe?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Baa tó ma yã́ na,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ wewào.","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ ma yã́kpalɛkɛna ũ,","poem":1},{"lineBreak":true},{"text":"sema mà sùuugbɛawà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ma lɛzùaàzi mɛ́ a wèa,","poem":1},{"lineBreak":true},{"text":"a yãmaae? Mi sio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ì ma gbɛ̃gbɛ̃ yã́ yↄↄna yã́iɛ,","poem":1},{"lineBreak":true},{"text":"ì ma kɛ'ĩa kpɛ́lɛkpɛlɛ pã.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ìli tó ma wekĩi eo,","poem":1},{"lineBreak":true},{"text":"ì ma tó ń nↄ̀sɛpusuoɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tó gbãa yã́ɛ, aàpi mɛ́ zↄ̃ↄ.","poem":1},{"lineBreak":true},{"text":"Tó yã́gↄ̃gↄ̃aɛ sↄ̃, démɛ a aà sísii?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tó ma mɛ̀ ma yã́ mɛ́ na,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ a yãdamalaɛ.","poem":1},{"lineBreak":true},{"text":"Tó ma mɛ̀ má tàae vĩo,","poem":1},{"lineBreak":true},{"text":"a ma ɛɛboɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Má tàae vĩoa? A yãe vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"mi saka mazĩa wɛ̃niu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yã doũɛ, asa lá málɛ o,","poem":1},{"lineBreak":true},{"text":"ì tàaesaideↄ ń gbɛ̃vãiↄ midɛ píi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tó yã́ mↄ̀ ga ìnɛ́ kã́ndo,","poem":1},{"lineBreak":true},{"text":"ì tàaesaideↄ láanikɛ ń yã'ea guu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó bùsu gↄ̃̀ gbɛ̃vãiↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ì pↄ́ku yã́kpalɛkɛnaↄ wɛ́aɛ.","poem":1},{"lineBreak":true},{"text":"Tó aàpi no, dé ni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ma gↄↄↄ gɛ̃a wãa dɛ bàalɛnala,","poem":1},{"lineBreak":true},{"text":"aalɛ tá ń bao, a kee nao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aalɛ gu baa vĩ lán kɛfu gó'ilɛnawa,","poem":1},{"lineBreak":true},{"text":"lán kúu sua pↄ́wawa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Baa tó ma mɛ̀ má yã́ pↄ́ má kũa bↄ ma nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"mí a oa wee mà yákpãinadↄ,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ma wãwã a iwãa ka ma pↄaɛ.","poem":1},{"lineBreak":true},{"text":"Má dↄ̃ kɛ́ ńyↄ̃ to yã́ bↄmanↄ nao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lá wàlɛ ma gwa tàaede ũ,","poem":1},{"lineBreak":true},{"text":"bↄ́yãi má ĩada mazĩawa pã lↄi?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Baa tó ma zu'ò ń mↄsↄnao,","poem":1},{"lineBreak":true},{"text":"ge ma a ↄ pìpi ń kasagbↄ̃o,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ńyↄ̃ ma zu ɛ̀ pɛ̀lɛadeuɛ.","poem":1},{"lineBreak":true},{"text":"Baa ma pↄkasaↄ aaↄ ye ma gĩyãio.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"A dɛ gbɛ̃nazĩna ũ lamawao.","poem":1},{"lineBreak":true},{"text":"Má fↄ̃ yã́zãsiwà","poem":1},{"lineBreak":true},{"text":"wà gbasa gɛ́ yã́kpalɛkɛkĩi sãnuo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃e kú wá kↄ́ↄ ũ,","poem":1},{"lineBreak":true},{"text":"aↄ iko vĩwá wá gbɛ̃ↄn pla wápii,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"i aà go'ↄ zɛ lé,","poem":1},{"lineBreak":true},{"text":"vĩa zↄ̃ↄ pↄ́ málɛ kɛɛ̀ a gɛ́ aɛ lↄo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Má vĩakɛɛ̀ lↄo, míↄ yã'o,","poem":1},{"lineBreak":true},{"text":"asa má dↄ̃ mazĩawa,","poem":1},{"lineBreak":true},{"text":"má dɛ lá wàlɛ ewao.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"9.9 Amↄ 5.8","reference":{"chapter":9,"verse":9}},{"noteId":11,"caller":"+","text":"9.13 Isa 30.7","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}