{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOL","translationId":"bqc_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"fb8288c0ce38d312e48b20b16442f5ddd69c2717644a6a09e43192ae5fe60c1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqc_sim/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Kaalɛgↄↄ pↄ́ Dii dìlɛ"]},{"type":"verse","number":1,"content":["Dii yã'oa Petuɛ nɛ́ Yoɛliɛn kɛ."]},{"type":"verse","number":2,"content":[{"text":"Mae zↄ̃ↄↄ, à yã́ɛ bee ma!","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú bùsuu laↄ píi, à swã́kpa!","poem":1},{"lineBreak":true},{"text":"Yã́ɛ bee taa kɛ̀ á gↄↄ","poem":1},{"lineBreak":true},{"text":"ge á deziↄ gↄↄe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À dau siu á nɛ́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai o ń nɛ́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"an nɛ́ↄ i o ń nɛ́ↄnɛ lↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pↄ́ pↄ́ kwasutɛ̃ↄ tò","poem":1},{"lineBreak":true},{"text":"sɛ̃sɛwɛkwaↄ sò.","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ sɛ̃sɛwɛkwaↄ tò","poem":1},{"lineBreak":true},{"text":"kwa búunaↄ sò.","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ kwa búunaↄ tò","poem":1},{"lineBreak":true},{"text":"kwa keleↄ sò.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À vu iu idɛnaↄ, í ↄ́ↄlↄ!","poem":1},{"lineBreak":true},{"text":"À búbuapɛ vɛ̃ɛminaↄ ápii","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛ dafu yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa wa wò á lɛ́waɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buie lɛ̀lɛ ma bùsuwa,","poem":1},{"lineBreak":true},{"text":"aa gbãa mɛ́ an dasi lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"an swaa dɛ lán nↄ̀ↄmusu swaawa,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"an kãnkãnaↄ dɛ lán nↄ̀ↄkusi kãnkãnawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa ma vɛ̃ɛliↄ ↄ̃̀ↄkpà,","poem":1},{"lineBreak":true},{"text":"aa ma kaadↄɛnliↄ kɛ̀ kɛ́lɛkɛlɛ.","poem":1},{"lineBreak":true},{"text":"Aa a tɛɛ wòlo kↄ̀lɛ,","poem":1},{"lineBreak":true},{"text":"a gↄ̃na gↄ̃̀ kpá púuu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À búbuapɛ lán wɛ̃́ndia pↄ́ lɛ́ a gↄ̃kpama gaa ↄ́ↄlↄ","poem":1},{"lineBreak":true},{"text":"à zwã̀nkasa kàkaalawa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pↄ́wɛna ń vɛ̃ɛ gbao zↄ̃̀ɛ Lua kpɛ́u,","poem":1},{"lineBreak":true},{"text":"sa'on Dii gbàgbanaↄ lɛ́ ↄ́ↄlↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bua músikɛ̀,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ gↄ̃̀ wɛ̃nannↄ,","poem":1},{"lineBreak":true},{"text":"pↄ́wɛna ásookɛ̀,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛbɛ í vĩo,","poem":1},{"lineBreak":true},{"text":"ku i bↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zↄ̃ɛↄ, à ↄku á wɛ́wa,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛbudeↄ, à búbuapɛ.","poem":1},{"lineBreak":true},{"text":"À ↄ́ↄlↄ mase ń éseo yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa bua pↄkɛkɛa i zɛkɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vɛ̃ɛliↄ i'ò,","poem":1},{"lineBreak":true},{"text":"kaadↄɛnliↄ lá dↄ̀ńzi","poem":1},{"lineBreak":true},{"text":"ń gbɛafuↄ ń daminaↄ ń maoↄ.","poem":1},{"lineBreak":true},{"text":"Sɛ̃̀a líↄ giigàga píi,","poem":1},{"lineBreak":true},{"text":"pↄna làa gbɛ̃nazĩnaↄwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sa'onaↄ, à zwã̀nkasa kákaála","poem":1},{"lineBreak":true},{"text":"à bala bↄ sↄu,","poem":1},{"lineBreak":true},{"text":"Lua gbagbakĩi zĩkɛnaↄ,","poem":1},{"lineBreak":true},{"text":"à búbuapɛ.","poem":1},{"lineBreak":true},{"text":"Ma Lua gbàgbanaↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ i la ń zwã̀nkasaↄ daa,","poem":1},{"lineBreak":true},{"text":"asa pↄ́wɛna ń vɛ̃ɛ gbao lɛ́ gɛ́ á Lua kpɛ́u lↄo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À lɛye dilɛ Lua pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃́ↄ kãaa,","poem":1},{"lineBreak":true},{"text":"à maezↄ̃ↄↄ sísi","poem":1},{"lineBreak":true},{"text":"ń á bùsudeↄ píi","poem":1},{"lineBreak":true},{"text":"aa mↄ wiilɛ Dii á Luawa a kpɛ́u.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Agya! Asa Dii gↄↄ kãikũ̀,","poem":1},{"lineBreak":true},{"text":"kaalɛgↄↄ pↄ́ Gbãapiide dìlɛ lɛ́ mↄ́.","poem":1},{"noteId":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pↄblea i láa wá wáao lé?","poem":1},{"lineBreak":true},{"text":"Pↄna ń yaalↄo mìdɛ wá Lua kpɛ́u.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pↄ́wɛna gↄ̃̀ koosiinnↄ bùsukↄ̃ↄtɛ̃u,","poem":1},{"lineBreak":true},{"text":"dↄ̃ↄ gↄ̃̀ yáiyai, gbaↄ gbòo,","poem":1},{"lineBreak":true},{"text":"asa pↄ́wɛna gìɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zuↄ wii gↄ̃̀ dↄ, asa sɛ̃ kuo,","poem":1},{"lineBreak":true},{"text":"kpàsaↄ bílikɛ̀ gɛ́kĩiwa.","poem":1},{"lineBreak":true},{"text":"Baa pↄtuo nɛ́naↄ lɛ́ ĩamaɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii, málɛ lɛzunzi,","poem":1},{"lineBreak":true},{"text":"asa dã́dãkɛkĩiↄ tɛkũ̀ɛ,","poem":1},{"lineBreak":true},{"text":"tɛ́lɛpiↄ sɛ̃sao líↄ sã̀sã píi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Baa sɛ̃̀anↄbↄↄ, n ni lɛ́ ń dɛ,","poem":1},{"lineBreak":true},{"text":"asa swadↄↄↄ gↄ̃̀ gii píiɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ an pↄblekĩiↄ tɛkũ̀.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.6 Zia 9.8","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"+","text":"1.15 Isa 13.6","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/bqc_sim/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}