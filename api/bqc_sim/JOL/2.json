{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOL","translationId":"bqc_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"fb8288c0ce38d312e48b20b16442f5ddd69c2717644a6a09e43192ae5fe60c1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqc_sim/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Zĩgↄ̃ↄ lɛɛũa ń kwaↄ"]},{"type":"verse","number":1,"content":[{"text":"À kuupɛ Siↄna,","poem":1},{"lineBreak":true},{"text":"à zĩ̀gãalɛ Dii gbɛ̀sĩsĩ musu.","poem":1},{"lineBreak":true},{"text":"Bùsudeↄ píi, à gilikɛ,","poem":1},{"lineBreak":true},{"text":"asa Dii gↄↄ lɛ́ mↄ́, à kãikũ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gubeebeegↄↄɛ, gu a siakũ.","poem":1},{"lineBreak":true},{"text":"Lou guduuduu gↄↄɛ.","poem":1},{"lineBreak":true},{"text":"Zĩgↄ̃ dasiↄ lɛ́ li gbɛ̀sĩsĩↄla","poem":1},{"lineBreak":true},{"text":"lán gudↄawa.","poem":1},{"lineBreak":true},{"text":"An gbãa taa sáa i bↄ yãao","poem":1},{"lineBreak":true},{"text":"mɛ́ a bↄ bau lↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛ́ lɛ́ kṹ ń aɛ, tɛ́lɛpiↄ dↄ ń kpɛ.","poem":1},{"lineBreak":true},{"text":"Bùsu kálɛ ń aɛ lán Edɛni swaluwa,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ ń iau lán gbáa wáiwaiwa,","poem":1},{"lineBreak":true},{"text":"pↄe i e pìlimáo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An aɛ bↄ̀ lán sↄ̃́wa,","poem":1},{"lineBreak":true},{"text":"aalɛ bàalɛ lán zĩkasↄ̃ wàiↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An kↄ̃fĩ dↄ lán zĩkasↄ̃goↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ sòo zↄ̃ gbɛ̀sĩsĩ misonaa.","poem":1},{"lineBreak":true},{"text":"An kĩ́i dↄ lán tɛ́ kũa sɛ̃saowawa","poem":1},{"lineBreak":true},{"text":"lán zĩgↄ̃ dasi pↄ́ aalɛ zĩ'ↄpooↄwa.","poem":1},{"noteId":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ́ buiↄ wɛsìńlɛ,","poem":1},{"lineBreak":true},{"text":"aa olo'olobò aa oosìsi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aalɛ siu ń bao lán gↄ̃saↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ vĩ gĩa lán zĩgↄ̃ↄwa.","poem":1},{"lineBreak":true},{"text":"Baade lɛ́ táa'o a aɛdↄawaɛ,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e i zã a ↄwao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aalɛ gã̀sazↄ̃kↄ̃ɛo,","poem":1},{"lineBreak":true},{"text":"aa mipɛ̀ ń aɛ,","poem":1},{"lineBreak":true},{"text":"aalɛ kuadi ń ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"an zĩkabↄↄ lɛ́ kpánɛ́o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aalɛ si wɛ̃́lɛ guu,","poem":1},{"lineBreak":true},{"text":"aalɛ bàalɛ bĩ́i musu,","poem":1},{"lineBreak":true},{"text":"aalɛ dɛdɛ kpɛ́ↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ gɛ̃ fɛnɛntiↄ guu lán kpã́iↄwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tↄↄlɛ lɛ́ lualua ń aɛ,","poem":1},{"lineBreak":true},{"text":"musupↄↄ lɛ́ deedee,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃ ń mↄvuao lɛ́ siakũ,","poem":1},{"lineBreak":true},{"text":"saanaↄ lɛ́ gↄ̃ tɛkɛsai.","poem":1},{"noteId":3}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii dↄaa a zĩgↄ̃ↄnɛ ń lↄↄ gbãao.","poem":1},{"lineBreak":true},{"text":"Aà ìwaↄ dasi maamaaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ zĩkɛ aà yã́wapiↄ gbãa.","poem":1},{"lineBreak":true},{"text":"Dii gↄↄpi zↄ̃ↄ, a to vĩa ń kṹ.","poem":1},{"lineBreak":true},{"text":"Démɛ a e bↄui?","poem":1},{"noteId":4}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii mɛ̀: Baa tia kɛ́wa,","poem":1},{"lineBreak":true},{"text":"à su ma kĩ́i ń nↄ̀sɛmɛndoo","poem":1},{"lineBreak":true},{"text":"ń lɛyeo ń ↄↄlↄo ń búbuapɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"À nↄ̀sɛlilɛ,","poem":1},{"lineBreak":true},{"text":"i kɛ á pↄkasaↄ no.","poem":1},{"lineBreak":true},{"text":"À su Dii á Lua kĩ́i,","poem":1},{"lineBreak":true},{"text":"asa a sùuu ń sósobio vĩ,","poem":1},{"lineBreak":true},{"text":"aà pↄ lí pa kpaao.","poem":1},{"lineBreak":true},{"text":"A gbɛ̃kɛ vĩ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ì ĩa pↄ́ a dìlɛ à damá bↄ a nↄ̀sɛɛɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wìliↄ dↄ̃o tó a wɛ̃nadↄ̃wɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"i wá tó ń báaao,","poem":1},{"lineBreak":true},{"text":"wí gbadaɛ̀ ń pↄ́wɛnao ń vɛ̃ɛo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À kuupɛ Siↄna,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃́ↄ sísi,","poem":1},{"lineBreak":true},{"text":"í lɛye dilɛ Lua pↄ́ ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À gbɛ̃́ↄ kãaa à gbãbↄnɛ́.","poem":1},{"lineBreak":true},{"text":"À maezↄ̃ↄↄ naaa à nɛ́ↄ kãaa,","poem":1},{"lineBreak":true},{"text":"baa a yↄ̃minaↄ.","poem":1},{"lineBreak":true},{"text":"O nↄsɛnaɛ aà bↄ a kpɛ́u,","poem":1},{"lineBreak":true},{"text":"aà nↄ dafu i bↄ kpɛa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"To sa'ona pↄ́ lɛ́ Dii gbagbaↄ ↄ́ↄlↄ","poem":1},{"lineBreak":true},{"text":"aà kpɛ́ kpɛɛlɛ ń aà gbagbakĩio zãnguo.","poem":1},{"lineBreak":true},{"text":"Aa mɛ: Dii, ǹ n gbɛ̃́ↄ wɛgwa,","poem":1},{"lineBreak":true},{"text":"ńsu to n bui gↄ̃ láanipↄ ũo,","poem":1},{"lineBreak":true},{"text":"ńsu to buipãleↄ yãadańnↄo.","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi buiↄ mɛ wá Lua kú má niɛi?","poem":1}]},{"type":"heading","content":["Dii zɛa ń a gbɛ̃́ↄ"]},{"type":"verse","number":18,"content":[{"text":"Dii nↄ̀sɛ a fɛlɛ a bùsu yã́ musu,","poem":1},{"lineBreak":true},{"text":"i a gbɛ̃́ↄ wɛ̃nagwa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A wemá à mɛ:","poem":1},{"lineBreak":true},{"text":"Málɛ pↄ́wɛna ń vɛ̃ɛo ń nísio kpã́sãɛ́,","poem":1},{"lineBreak":true},{"text":"íↄ kãa pã́upãu.","poem":1},{"lineBreak":true},{"text":"Má á kɛ láanipↄ ũ buiↄnɛ bau lↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Má gugbãntoodeↄ yáɛ́ zã̀zã,","poem":1},{"lineBreak":true},{"text":"má ↄzↄ̃ńzi mà ń kpá gbáa wáiwai guuɛ.","poem":1},{"lineBreak":true},{"text":"Má ń dↄaanaↄ zu Ísida Wisideu,","poem":1},{"lineBreak":true},{"text":"mí ń gbɛzãdeↄ zu bɛ'aɛ ísiau.","poem":1},{"lineBreak":true},{"text":"Aa yaikɛ, an gĩ iↄ dↄ we,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ aa kɛ̀ɛ́ píi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tↄↄlɛ, ńsu vĩakɛo!","poem":1},{"lineBreak":true},{"text":"Pↄnakɛ! Yáalↄ!","poem":1},{"lineBreak":true},{"text":"Asa ma Dii ma yãzↄ̃ↄkɛ̀.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a nↄ̀bↄↄ, ásu vĩakɛo,","poem":1},{"lineBreak":true},{"text":"asa sɛ̃ lɛ́ kùsi kpálɛ.","poem":1},{"lineBreak":true},{"text":"Líↄ lɛ́ nɛ'i,","poem":1},{"lineBreak":true},{"text":"kaadↄɛna ń vɛ̃ɛo lɛ́ ń asea kɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ, à pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"à yáalↄ Dii á Luawa.","poem":1},{"lineBreak":true},{"text":"Àlɛ á gba zuↄ lou kã́fĩa yã́iɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ lou maɛ́ lán yãawaɛ.","poem":1},{"lineBreak":true},{"text":"A daalɛ a gↄↄwa, i bↄlɛi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pↄ́wɛna a nↄnↄaa a gbɛ̃zɛↄu,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛ ń nísio kákĩiↄ pa yɛlɛlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Pↄ́ pↄ́ kwaↄ blè wɛ̃ ń wɛ̃o,","poem":1},{"lineBreak":true},{"text":"sɛ̃sɛwɛkwaↄ ń kwasutɛ̃ↄ","poem":1},{"lineBreak":true},{"text":"ń kwa búunaↄ ń kwa keleↄ,","poem":1},{"lineBreak":true},{"text":"ma zĩgↄ̃ dasi pↄ́ ma gbaɛwápiↄ,","poem":1},{"lineBreak":true},{"text":"má a fĩaboɛ́.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Á pↄble lá á yeiwa à kã́,","poem":1},{"lineBreak":true},{"text":"í ma Dii á Lua táasilɛ,","poem":1},{"lineBreak":true},{"text":"asa ma yãbↄnsaɛkɛ̀ɛ́ɛ.","poem":1},{"lineBreak":true},{"text":"Wí a ma gbɛ̃́ↄ kũ bau lↄo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Á Isailiↄ íↄ dↄ̃ sa","poem":1},{"lineBreak":true},{"text":"kɛ́ ma Dii á Lua má kú á guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ dii pãle kuo.","poem":1},{"lineBreak":true},{"text":"Wí a ma gbɛ̃́ↄ kũ bau lↄo.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"2.5 Zia 9.7-9","reference":{"chapter":2,"verse":5}},{"noteId":3,"caller":"+","text":"2.10 Zia 8.12","reference":{"chapter":2,"verse":10}},{"noteId":4,"caller":"+","text":"2.11 Mal 3.2, Zia 6.17","reference":{"chapter":2,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":27}