{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOL","translationId":"bqc_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"fb8288c0ce38d312e48b20b16442f5ddd69c2717644a6a09e43192ae5fe60c1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqc_sim/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Dii a Nisĩna pisia a gbɛ̃́ↄwa"]},{"type":"verse","number":1,"content":[{"text":"Gↄↄ bee gbɛa má a Nisĩna pisi bui píiɛ,","poem":1},{"lineBreak":true},{"text":"á nɛgↄ̃ɛↄ ń á nɛnↄɛↄ i ãnabikɛkɛ,","poem":1},{"lineBreak":true},{"text":"á maezↄ̃ↄↄ i yã́ↄ e iu,","poem":1},{"lineBreak":true},{"text":"á ɛ̀waasoↄ i wɛ́pungu'e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gↄↄbeezĩ má a Nisĩna pisimá,","poem":1},{"lineBreak":true},{"text":"baa ma zↄ̀blenaↄ, gↄ̃ɛↄ ń nↄɛↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má yãbↄnsaɛↄ kɛ musu ń zĩ́lɛo,","poem":1},{"lineBreak":true},{"text":"au ń tɛ́o ń tɛluo aↄ ku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ĩatɛ̃ a siakũ,","poem":1},{"lineBreak":true},{"text":"mↄvua a tã lán auwa","poem":1},{"lineBreak":true},{"text":"e Dii mↄgↄↄ zↄ̃ↄ pↄ́ a to vĩa ń kṹ àↄ ká.","poem":1},{"noteId":5}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii sìsinaↄ bↄ píi,","poem":1},{"noteId":6},{"lineBreak":true},{"text":"asa suabaa aↄ ku Yelusalɛũ","poem":1},{"lineBreak":true},{"text":"Siↄna gbɛ̀sĩsĩ musu lá Dii òwaɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ bↄ̀piↄ aaↄ dɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ Dii ń sisiↄ ũɛ.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"3.4 Mat 24.29, Maa 13.24-25, Luk 21.25, Zia 6.12-13","reference":{"chapter":3,"verse":4}},{"noteId":6,"caller":"+","text":"3.5 Zĩn 2.17-21, Lom 10.13","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}