{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JOL","translationId":"bqc_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"fb8288c0ce38d312e48b20b16442f5ddd69c2717644a6a09e43192ae5fe60c1c","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqc_sim/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":4,"content":[{"type":"heading","content":["Dii yã́kpalɛkɛa ń buiↄ"]},{"type":"verse","number":1,"content":[{"text":"Gwa! Gↄↄ bee, zĩbeezĩ,","poem":1},{"lineBreak":true},{"text":"tó ma Yelusalɛũdeↄ ń Yudaↄ píi dìlɛ ń pá ziu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"má buiↄ kãaa píi","poem":1},{"lineBreak":true},{"text":"mà pilańnↄ yã́kpalɛkɛguzulɛu.","poem":1},{"lineBreak":true},{"text":"We má yã́kpalɛkɛuńnↄ","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ Isailiↄ ń ma bùsuo yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa aa ma gbɛ̃́ↄ fã̀aa dṹniau,","poem":1},{"lineBreak":true},{"text":"aa ma bùsupi kpaalɛ̀kↄ̃ɛɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa tɛ́lɛpà aa ma gbɛ̃́ↄ kpaalɛ̀okↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"aa ma nɛgↄ̃ɛↄ ń ma nɛnↄɛↄ yìa,","poem":1},{"lineBreak":true},{"text":"aa káaluakà aa vɛ̃ɛmì ń a ↄ̃ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tiideↄ ń Sidↄ̃deↄ","poem":1},{"noteId":7},{"lineBreak":true},{"text":"ń Filitɛ̃ bùsu zↄ̃lɛdeↄ píi,","poem":1},{"lineBreak":true},{"text":"á ye sɛmanↄ kpelewa ni?","poem":1},{"lineBreak":true},{"text":"Álɛ yã́ pↄ́ má kɛ̀ɛ́ fĩabomɛɛ yã̀?","poem":1},{"lineBreak":true},{"text":"Tó álɛ a fĩabomɛɛ,","poem":1},{"lineBreak":true},{"text":"má tó a wi á musu kã́ndo gↄ̃̀ↄɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asa a ma ã́nusu ń ma vuao sɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"a ma pↄmaa bɛɛɛdeↄ sɛ̀lɛ a taò","poem":1},{"lineBreak":true},{"text":"á kàlɛ á tã́akpɛↄ guuɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A Yelusalɛũdeↄ ń Yudaↄ píi yìa Gɛlɛkiↄwa,","poem":1},{"lineBreak":true},{"text":"kɛ́ à ń kɛ̃́ ń bùsuwa zã̀ yã́i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gwa! Má ń vu iu,","poem":1},{"lineBreak":true},{"text":"aai fɛlɛ gu pↄ́ a ń yiau,","poem":1},{"lineBreak":true},{"text":"mí yã́ pↄ́ á kɛ̀nɛ́pi wíɛ́ á musu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má á nɛgↄ̃ɛↄ ń á nɛnↄɛↄ yía Yudaↄwa,","poem":1},{"lineBreak":true},{"text":"aai ń yía Seba pↄ́ kú zã̀ↄwa.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yã́ɛ bee kpàwakɛ buiↄnɛ:","poem":1},{"lineBreak":true},{"text":"À zĩ̀ sↄukɛ à nɛgↄ̃naↄ vu iu,","poem":1},{"lineBreak":true},{"text":"í tó zĩgↄ̃ↄ fɛlɛ sↄ̃ kãi ḿpii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À á soonaↄpi fɛ̃ndaↄ ũ,","poem":1},{"lineBreak":true},{"text":"à á máaso limibobↄↄ lilɛ sↄ̃naↄ ũ.","poem":1},{"noteId":8},{"lineBreak":true},{"text":"Gbãasaide o gↄ̃san a ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bui píi, à bↄ gupiiu,","poem":1},{"lineBreak":true},{"text":"à mↄ kãaa we kpakpa.","poem":1},{"lineBreak":true},{"text":"Dii, pilamá ń n nɛgↄ̃naↄ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buiↄ vu iu,","poem":1},{"lineBreak":true},{"text":"aai gɛ́ yã́kpalɛkɛguzulɛu,","poem":1},{"lineBreak":true},{"text":"asa we má zↄ̃lɛu","poem":1},{"lineBreak":true},{"text":"mà yã́kpalɛkɛ ń gupii buiↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"An vãikɛa kɛ̀ zài!","poem":1},{"lineBreak":true},{"text":"Kↄma ká pↄ́i ǹ kɛ̃́,","poem":1},{"lineBreak":true},{"text":"asa à mà à kà kɛkɛaɛ.","poem":1},{"noteId":9},{"lineBreak":true},{"text":"À mↄ ↄ̃zↄ̃ vɛ̃ɛwa a fɛ̃kĩiu,","poem":1},{"lineBreak":true},{"text":"asa à pàɛ,","poem":1},{"noteId":10},{"text":"vɛ̃ɛkakĩiↄ pà yɛlɛlɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wa ku we dasidasi yã́kpalɛ midɛguzulɛu,","poem":1},{"lineBreak":true},{"text":"asa Dii yã́kpalɛkɛgↄↄ kãikũ̀","poem":1},{"lineBreak":true},{"text":"yã́kpalɛ midɛguzulɛuɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĩatɛ̃ ń mↄvuao a siakũ,","poem":1},{"lineBreak":true},{"text":"saanaↄ tɛkɛ lↄo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii a bↄ Siↄna ń kãaao,","poem":1},{"lineBreak":true},{"text":"a bↄ Yelusalɛũ ń lↄↄ gbãao.","poem":1},{"lineBreak":true},{"text":"Musu ń zĩ́lɛo a lualua,","poem":1},{"lineBreak":true},{"text":"ãma Dii aↄ dɛ ulɛkĩi ũ a gbɛ̃́ↄnɛɛ,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ aafia'ekĩi ũ Isailiↄnɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Íↄ dↄ̃ sa kɛ́ ma Dii á Lua,","poem":1},{"lineBreak":true},{"text":"má kú Siↄna musu, ma gbɛ pↄ́ a kua adoapi.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"buipãleↄ si wɛ̃́lɛpiu bau lↄo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gↄↄ bee gbɛ̀sĩsĩↄ vɛ̃ɛbɛ a kwɛ́,","poem":1},{"lineBreak":true},{"text":"mɛ́ sĩ̀sĩↄ pↄtuoↄ vĩ aↄ diɛ.","poem":1},{"lineBreak":true},{"text":"Yuda bùsu swadↄↄe í a zↄ̃ɛo.","poem":1},{"lineBreak":true},{"text":"Nibↄna a bↄ Dii kpɛ́u à bàalɛ,","poem":1},{"lineBreak":true},{"text":"i mↄ̀sɛpisi lɛpusia guzulɛu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Egipi a gↄ̃ gbáa gii ũ,","poem":1},{"lineBreak":true},{"text":"Ɛdↄũ a gↄ̃ guwaiwai ũ","poem":1},{"lineBreak":true},{"text":"yãpãsĩ pↄ́ aa kɛ̀ Yudaↄnɛ yã́i,","poem":1},{"lineBreak":true},{"text":"asa aa yãesaidepiↄ dɛ̀dɛ ń bùsuuɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yuda bùsu aↄ kálɛa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"wiↄ ku Yelusalɛũ wɛ̃ ń wɛ̃o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tↄ pↄ́ mi sínɛ́ yãao ↄ̃ má sínɛ́ sa.","poem":1},{"lineBreak":true},{"text":"Ma Dii, míↄ ku Siↄna.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"4.4 Isa 23.1-18, Mat 11.21-22","reference":{"chapter":4,"verse":4}},{"noteId":8,"caller":"+","text":"4.10 Isa 2.4","reference":{"chapter":4,"verse":10}},{"noteId":9,"caller":"+","text":"4.13 Zia 14.15","reference":{"chapter":4,"verse":13}},{"noteId":10,"caller":"+","text":"4.13 Zia 14.20, 19.15","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/JOL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}