{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"JON","translationId":"bqc_sim","name":"Yonasi","commonName":"Yonasi","title":"YONASI","order":32,"numberOfChapters":4,"sha256":"de908ad0cb931b7f25bef0810b35d5c2051ff3cf2390dd2060075975990b503d","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqc_sim/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yonasi wabikɛa kpↄ gbɛɛu"]},{"type":"verse","number":1,"content":["Dii tò kpↄ̀ gbɛ̃̀nɛ mↄ̀ Yonasi mↄ̀,",{"noteId":1},"ↄ̃ à kɛ̀ kpↄpi gbɛɛu fãanɛ àaↄ̃ gwãasĩn àaↄ̃."]},{"type":"verse","number":2,"content":["Kua kpↄpi gbɛɛu Yonasi wabikɛ̀ Dii a Luawa à mɛ̀:"]},{"type":"verse","number":3,"content":[{"text":"Ma lɛzù Diizi ma yooyea guu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a wèa,","poem":1},{"lineBreak":true},{"text":"kua bɛda nↄnau ma wiilɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma yãmà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ma zu ísia í títiu","poem":1},{"lineBreak":true},{"text":"e za a nↄnau,","poem":1},{"lineBreak":true},{"text":"ísↄ̃ dɛ̀dɛa ń ikooaↄ,","poem":1},{"lineBreak":true},{"text":"n idãazĩↄ táa'ò ma mia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ ma yã́ kú n sↄ̃u lↄo,","poem":1},{"lineBreak":true},{"text":"kási má ɛa wɛsi n kpɛ́ pↄ́ a kua adoalɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Í ma kũ ma nↄɛ,","poem":1},{"lineBreak":true},{"text":"ísi ma mↄ,","poem":1},{"lineBreak":true},{"text":"wáa fĩ̀a ma mii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma kpalɛ e gbɛ̀sĩsĩↄ zĩ́nau,","poem":1},{"lineBreak":true},{"text":"dṹnia zɛ́ pↄ́ wɛ̃a vĩo tàmalɛ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ n ma bↄ gbã́ou,","poem":1},{"lineBreak":true},{"text":"n ma mìsi, Dii ma Lua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ́ má ye ã́nuatoi,","poem":1},{"lineBreak":true},{"text":"Dii, n yã́ dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma wabikɛ̀ma,","poem":1},{"lineBreak":true},{"text":"à n le za n kpɛ́ pↄ́ a kua adoau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ tã́a gbagbaↄ aa kɛ báaa vĩo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ãma mapi, má sa'oma ń sáaukpaao,","poem":1},{"lineBreak":true},{"text":"má lɛ́ pↄ́ má kɛ̀ma fĩabo.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ì ń suaba.","poem":1}]},{"type":"verse","number":11,"content":["Dii yã'ò kpↄpiɛ, ↄ̃ à Yonasi pìsi sĩ̀sĩa."]}],"footnotes":[{"noteId":1,"caller":"+","text":"2.1 Mat 12.40","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}