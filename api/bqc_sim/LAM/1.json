{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"LAM","translationId":"bqc_sim","name":"Wɛ̃nalɛ","commonName":"Wɛ̃nalɛ","title":"WƐ̃NALƐ","order":25,"numberOfChapters":5,"sha256":"a27bc254bf776119f5f4f4abb56bcffd35335dbe87fa671cca93835c775f12b5","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bqc_sim/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Wɛ̃nakɛa Siↄnaɛ"]},{"type":"verse","number":1,"content":[{"text":"Wɛ̃́lɛ pↄ́ wa diu yãa gↄ̃̀ da gii sa bɛ!","poem":1},{"lineBreak":true},{"text":"À tↄbↄ̀ buiↄ guu yãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ lán gyaa gbɛ̃andowa.","poem":1},{"lineBreak":true},{"text":"À iko vĩ bùsuↄwa yãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gↄ̃̀ zĩ̀zↄ ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ìↄ búbuapɛ gwã́,","poem":1},{"lineBreak":true},{"text":"aà oa ì ya ń wɛ́'io.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ yeaàzi yãaↄ,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e lɛ́ aà nↄ̀sɛ niniɛ̀o.","poem":1},{"lineBreak":true},{"text":"Aà gbɛ̃napiↄ zĩbↄnkpɛkɛ̀ɛ̀,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ aà ibɛɛↄ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yudaↄ ku zĩ gbãau ń taasio,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wà tàńnↄ zĩ̀zↄↄ ũ.","poem":1},{"lineBreak":true},{"text":"Aa ku buipãleↄ guu,","poem":1},{"lineBreak":true},{"text":"aali ĩ́ampakĩi eo.","poem":1},{"lineBreak":true},{"text":"An kua wɛ́tɛ̃apiu","poem":1},{"lineBreak":true},{"text":"an ĩadamadeↄ mↄ̀ lɛ̀lɛmá ḿpii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siↄna zɛ́ↄ gà píi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lɛ́ sɛ́ à mↄ dikpɛkɛi lↄo.","poem":1},{"lineBreak":true},{"text":"A bĩ́ibↄlɛↄ gↄ̃̀ da gii,","poem":1},{"lineBreak":true},{"text":"a sa'onaↄ lɛ́ aaukɛ,","poem":1},{"lineBreak":true},{"text":"a wɛ̃́ndiaↄ ku pↄsiau,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛpi ĩ́ikũ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aà ibɛɛↄ mɛ́ gↄ̃̀ aà vĩ,","poem":1},{"lineBreak":true},{"text":"aà wɛ̀lɛpiↄ kálɛa dↄdↄa.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ mↄ̀ ń pↄsia beeo","poem":1},{"lineBreak":true},{"text":"tàae zↄ̃ↄ pↄ́ Siↄnapi kɛ̀ yã́i.","poem":1},{"lineBreak":true},{"text":"Aà ibɛɛↄ a gbɛ̃́ↄ kpán'aɛkɛ̀","poem":1},{"lineBreak":true},{"text":"aa tàńnↄ zĩ̀zↄↄ ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siↄna gawi làa píi.","poem":1},{"lineBreak":true},{"text":"A kíaↄ gↄ̃̀ lán tue pↄ́ kùa sɛ̃wawa.","poem":1},{"lineBreak":true},{"text":"Aa yɛ̃̀ɛɛ vĩo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa bàalɛ̀ ń yanaↄnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ lìaaliaa wɛ́tɛ̃a guu,","poem":1},{"lineBreak":true},{"text":"aalɛ ń pↄ́ maaↄ bɛɛkɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ́ aalɛ gɛ̃ ń ibɛɛↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"aai gbɛ̃e e à ↄdàmáo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ Yelusalɛũ ibɛɛↄ aà wíwia è,","poem":1},{"lineBreak":true},{"text":"aa aà yáalↄ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yelusalɛũ duuna zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"bee yã́ mɛ́ tò à gbãlɛ̀.","poem":1},{"lineBreak":true},{"text":"Aà kpɛlanaↄ lɛ́ aà kpɛbↄ sa","poem":1},{"lineBreak":true},{"text":"kɛ́ aa aà puizi è yã́i.","poem":1},{"lineBreak":true},{"text":"Aàzĩawa àlɛ aaukɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ a mi pãpãu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aà gbãsĩ kú aà zwãawa,","poem":1},{"lineBreak":true},{"text":"i yã́ pↄ́ a a le dao.","poem":1},{"lineBreak":true},{"text":"Aà lɛ́lɛapi bↄ̀ gbɛ̃́ↄ saɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e i waiyookɛɛ̀o.","poem":1},{"lineBreak":true},{"text":"Ma taasi gwa Dii,","poem":1},{"lineBreak":true},{"text":"asa ma ibɛɛↄ lɛ́ yↄ̃̀ↄ kɛaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà ibɛɛↄ ↄpɛ̀lɛ aà àizɛɛↄwa.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ n ginɛ́ aa gɛ̃ n gbɛ̃́ↄ kↄ̃kãaauↄ,","poem":1},{"lineBreak":true},{"text":"a è buipiↄ gɛ̃̀ n kpɛ́u.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà gbɛ̃́ↄ lɛ́ aaukɛ ḿpii,","poem":1},{"lineBreak":true},{"text":"aalɛ pↄblea wɛɛlɛ.","poem":1},{"lineBreak":true},{"text":"Aalɛ ń àizɛɛↄ lɛũkpakɛ","poem":1},{"lineBreak":true},{"text":"ń pↄbleao wɛ̃ni badↄa yã́i.","poem":1},{"lineBreak":true},{"text":"Wɛ́sɛ ǹ gwa Dii,","poem":1},{"lineBreak":true},{"text":"wàlɛ ma kɛ pↄ́ↄpↄↄɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ álɛ gɛ̃ laↄ,","poem":1},{"lineBreak":true},{"text":"ma yã́ lɛ́ kɛɛ́ yãe ũo lé?","poem":1},{"lineBreak":true},{"text":"À wɛ́sɛ à gwa tó yã'ↄ̃mae kà","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ wa kpàmaziɛwa.","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ kpàmazi a pↄkũma pãsĩ bↄbↄaa gↄↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kua za musu à tɛ́ gbàɛa wawãwã ũ.","poem":1},{"lineBreak":true},{"text":"À ba kpàmɛɛ ma táa'ozɛu,","poem":1},{"lineBreak":true},{"text":"à ma sↄaa.","poem":1},{"lineBreak":true},{"text":"À ma kɛ bɛzia ũ,","poem":1},{"lineBreak":true},{"text":"à ma to ń aafiasaio gↄↄpii.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii ma tàaeↄ kàkↄ̃u,","poem":1},{"lineBreak":true},{"text":"a tã̀ zuu ũ.","poem":1},{"lineBreak":true},{"text":"A dàmɛɛ ma nↄɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma gbãa bùsa.","poem":1},{"lineBreak":true},{"text":"À ma gbɛ̃́ↄ nà gbɛ̃́ pↄ́ aa fↄ̃ ń fuoↄnɛ ń ↄzĩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii sakà nɛgↄ̃na pↄ́ kú ma guuↄgu.","poem":1},{"lineBreak":true},{"text":"À gbɛ̃́ↄ kã̀aamazi,","poem":1},{"lineBreak":true},{"text":"aa ma ɛ̀waasoↄ kɛ̀ kɛ́lɛkɛlɛ.","poem":1},{"lineBreak":true},{"text":"Ma Yudaↄ mɛɛwia lɛ́so,","poem":1},{"lineBreak":true},{"text":"Dii ↄ̃zↄ̃̀a a vɛ̃ɛfɛ̃kĩiu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bee ↄ́ ↄ̃ málɛ dↄ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́'i lɛ́ kwɛ́.","poem":1},{"lineBreak":true},{"text":"Nↄ̀sɛninina kumanↄ kãio,","poem":1},{"lineBreak":true},{"text":"wàlɛ wɛɛlɛ ma nisĩna suo.","poem":1},{"lineBreak":true},{"text":"Ma nɛ́ↄ gↄ̃̀ gii,","poem":1},{"lineBreak":true},{"text":"asa ibɛɛ gbãamↄ̀mɛɛɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma Siↄna, ma ↄkpà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gbɛ̃e ku à ma nↄ̀sɛ nínimɛɛo.","poem":1},{"lineBreak":true},{"text":"Bui pↄ́ liaa Yakↄbu buiↄziↄ","poem":1},{"lineBreak":true},{"text":"ↄ̃ Dii dìlɛ aa gↄ̃ ń ibɛɛↄ ũ.","poem":1},{"lineBreak":true},{"text":"Ma Yelusalɛũ ma gↄ̃ ibɛɛpiↄnɛ lán pↄ́ gbãlɛawa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii yã́ naɛ,","poem":1},{"lineBreak":true},{"text":"asa ma bↄ aà yã́ kpɛɛ.","poem":1},{"lineBreak":true},{"text":"Bui píi à swã́kpa,","poem":1},{"lineBreak":true},{"text":"í ma yã'ↄ̃ma ma.","poem":1},{"lineBreak":true},{"text":"Wà tà ń ma wɛ̃́ndiaↄ ń ma ɛ̀waasoↄ zĩ̀zↄↄ ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma lɛzù bui pↄ́ yemaziↄzi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa zĩbↄnkpɛkɛ̀mɛɛ.","poem":1},{"lineBreak":true},{"text":"Ma sa'onaↄ ń ma gbɛ̃zↄ̃ↄↄ kɛ̀sai ma zɛaↄ guu,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ aalɛ blɛ wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"aa ń wɛ̃ni ba dↄò.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii, ma taasikɛa gwa,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ lɛ́ tɛ́kũ.","poem":1},{"lineBreak":true},{"text":"Ma túlu yà,","poem":1},{"lineBreak":true},{"text":"asa ma pã n yã́a maamaaɛ.","poem":1},{"lineBreak":true},{"text":"Zĩ ma gbɛ̃́ↄ blè gãaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ gaga ku ua.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wà ma aaukɛa mà,","poem":1},{"lineBreak":true},{"text":"kási má nↄ̀sɛninina vĩo.","poem":1},{"lineBreak":true},{"text":"Ma ibɛɛↄ ma taasikɛa bao mà,","poem":1},{"lineBreak":true},{"text":"aalɛ pↄnakɛ ń yã́ pↄ́ ń kɛ̀mɛɛo.","poem":1},{"lineBreak":true},{"text":"To gↄↄ pↄ́ n a yã'ò ká,","poem":1},{"lineBreak":true},{"text":"aai gↄ̃mawa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ǹ ń vãikɛa bↄnɛ́ gupuau,","poem":1},{"lineBreak":true},{"text":"ní kɛnɛ́ lá ń kɛ̀mɛɛwa ma tàae yã́i.","poem":1},{"lineBreak":true},{"text":"Ma aaukɛa zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ma sↄ̃ yɛ̃̀ɛɛ vĩ lↄo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}