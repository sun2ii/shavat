{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"LAM","translationId":"bqc_sim","name":"Wɛ̃nalɛ","commonName":"Wɛ̃nalɛ","title":"WƐ̃NALƐ","order":25,"numberOfChapters":5,"sha256":"a27bc254bf776119f5f4f4abb56bcffd35335dbe87fa671cca93835c775f12b5","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bqc_sim/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Ĩa pↄ́ Dii dà Siↄnawa"]},{"type":"verse","number":1,"content":[{"text":"Gwa lá Dii pↄkũma kù Siↄnaa lán suawa.","poem":1},{"lineBreak":true},{"text":"À Isailiↄ bɛɛɛ pↄ́ zↄ̃̀ luawa pã̀lɛ zĩ́lɛ.","poem":1},{"lineBreak":true},{"text":"I a gbadibↄpi yãda a pↄfɛ̃gↄↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii Yakↄbu buiↄ kpɛ́ↄ dàaĩ ń wɛ̃nagwasai,","poem":1},{"lineBreak":true},{"text":"à Yudaↄ mɛɛwia zɛgikĩiↄ kwɛ̀ a pↄfɛ̃ guu,","poem":1},{"lineBreak":true},{"text":"à kɛ̀sɛ tↄ̃̀ a kíaↄ ń ń kpalaowa zĩ́lɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aà pↄkũma pãsĩ guu à Isailiↄ gbãa kↄ'ɛ̀.","poem":1},{"lineBreak":true},{"text":"À a ↄbↄ̀lɛ ń yã́u an ibɛɛↄ wáa.","poem":1},{"lineBreak":true},{"text":"À kũ̀ Yakↄbu buiↄwa tɛ́ ũ ń pↄ́ pↄ́ liaiↄ píi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À sagòlɛ lán ibɛɛwa,","poem":1},{"lineBreak":true},{"text":"à ↄkà sáu.","poem":1},{"lineBreak":true},{"text":"À gbɛ̃́ pↄ́ kɛ̀ɛ maa yãaↄ dɛ̀dɛ píi","poem":1},{"lineBreak":true},{"text":"lán wɛ̀lɛwa.","poem":1},{"lineBreak":true},{"text":"À a pↄkũma pìpi Siↄnawa","poem":1},{"lineBreak":true},{"text":"lán tɛ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii gↄ̃̀ lán ibɛɛwa,","poem":1},{"lineBreak":true},{"text":"a kɛ̀ Isailiↄnɛ sàabu.","poem":1},{"lineBreak":true},{"text":"À ń kibɛↄ dàaĩ,","poem":1},{"lineBreak":true},{"text":"à ń wɛ̃́lɛ bĩ́ideↄ kwɛ̀.","poem":1},{"lineBreak":true},{"text":"A tò búbua ń wɛ̃na wiio kã̀fĩ Yudaↄ mɛɛwiau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À a kpɛ́ gbòo à gↄ̃̀ lán kaawa,","poem":1},{"lineBreak":true},{"text":"à a gbɛ̃́ↄ kãaakĩipi wìwi.","poem":1},{"lineBreak":true},{"text":"Dii tò dikpɛ ń kã́mabogↄↄo yã́ dↄ Siↄnadeↄgu lↄo.","poem":1},{"lineBreak":true},{"text":"Aà zafɛ̃a zↄ̃ↄ guu i kía ń sa'onaↄ gwa pↄe ũo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii gì a gbagbakĩizi,","poem":1},{"lineBreak":true},{"text":"à pãkpà a kpɛ́i.","poem":1},{"lineBreak":true},{"text":"À kibɛ kpɛ́ gbãaↄ nà ibɛɛↄnɛ ń ↄzĩ.","poem":1},{"lineBreak":true},{"text":"Aa kúkuakɛ̀ Dii kpɛ́u","poem":1},{"lineBreak":true},{"text":"lá wì kɛ dikpɛ zĩ́wa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii zɛ̀ ń Siↄna bĩ́i gbooaoɛ.","poem":1},{"lineBreak":true},{"text":"À ba yↄ̃̀wà, i gí ↄtↄ̃iwào.","poem":1},{"lineBreak":true},{"text":"A tò a bĩ́iↄ lɛ́ pìa, aa gↄ̃̀ kɛ̀lɛkɛlɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bↄlɛ gbaↄ vĩ̀lɛ tↄↄlɛu,","poem":1},{"lineBreak":true},{"text":"a gbã́aↄ ɛ̀'ɛ kpéekpee.","poem":1},{"lineBreak":true},{"text":"A kía ń a nɛ́ↄ gↄ̃̀ buipãleↄ guu,","poem":1},{"lineBreak":true},{"text":"wa ikoyã kũa lↄo.","poem":1},{"lineBreak":true},{"text":"A ãnabiↄ lí yã́ pↄ́ bↄ̀ Dii kĩ́i e lↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siↄna gbɛ̃zↄ̃ↄↄ zↄ̃lɛa zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"an lɛ́ kpaaũa.","poem":1},{"lineBreak":true},{"text":"Aa bùsukà ń miu,","poem":1},{"lineBreak":true},{"text":"aa zwã̀nkasaↄ kàkańla.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ wɛ̃́ndiaↄ mi gↄ̃̀ pɛ́lɛa zĩ́lɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma wɛ́ lɛ́ wo ń ↄↄlↄo,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ lɛ́ tɛ́kũ.","poem":1},{"lineBreak":true},{"text":"Ma pↄ yà dúuduu ma gbɛ̃́ↄ dɛdɛa yã́i.","poem":1},{"lineBreak":true},{"text":"Nɛ́fɛ̃nɛnaↄ ń nɛ́tɛ̃naↄ kálɛ ma gãaɛↄ yɛ̃̀ɛɛsai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ aalɛ lɛ́lɛ gãaɛ","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ kɛ̀'ĩaↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ ń daↄ la aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Wá pↄblea ń imiao e má ni?","poem":1},{"lineBreak":true},{"text":"An wɛ̃ni lɛ́ gɛ̃zɛa ń daↄ kùɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yelusalɛũ, má onɛ kpelewa ni?","poem":1},{"lineBreak":true},{"text":"Bↄ́ má n lɛɛũòi?","poem":1},{"lineBreak":true},{"text":"Mɛɛwia lɛ́so Siↄna, bↄ́ má mɛ n muaaò","poem":1},{"lineBreak":true},{"text":"mà ń nↄ̀sɛ níninɛi?","poem":1},{"lineBreak":true},{"text":"N bↄ̀ ɛ zã̀ lán ísia ɛwa,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ n gbã́gbãi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N ãnabiↄ yãpã gii ènɛ.","poem":1},{"lineBreak":true},{"text":"Aai n yãvãi bↄnɛ gupuau aa n kɛ̃ zↄblewao.","poem":1},{"lineBreak":true},{"text":"Yãpã gii pↄ́ aa ènɛ n sãsã.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ gɛ̃ↄ píi aaìↄ ↄtaalɛ,","poem":1},{"lineBreak":true},{"text":"aaìↄ lɛsuikɛma Yelusalɛũ,","poem":1},{"lineBreak":true},{"text":"aaìↄ mikɛnɛ déũdeũ.","poem":1},{"lineBreak":true},{"text":"Aaì mɛ, wɛ̃́lɛ pↄ́ a kɛfɛna kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"dṹnia píi pↄnakɛbↄpin wee?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N ibɛɛↄ lɛ́ lɛdↄma píi,","poem":1},{"lineBreak":true},{"text":"aalɛ lɛsuikɛma.","poem":1},{"lineBreak":true},{"text":"Aalɛ swaa biima,","poem":1},{"lineBreak":true},{"text":"aalɛ mɛ wá dàaĩ,","poem":1},{"lineBreak":true},{"text":"wá wɛ́ dↄ gↄↄpizi yãaɛ,","poem":1},{"lineBreak":true},{"text":"wa wɛsìɛ sa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii kɛ̀ lá à zɛ̀owa,","poem":1},{"lineBreak":true},{"text":"à yã́ pↄ́ a dìlɛ za zi pàpa.","poem":1},{"lineBreak":true},{"text":"À n kwɛ n wɛ̃nagwasai.","poem":1},{"lineBreak":true},{"text":"A tò ibɛɛↄ pↄnakɛ̀ n musu,","poem":1},{"lineBreak":true},{"text":"à n wɛ̀lɛↄ gbà gbãa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Siↄna, to n bĩ́i wiilɛ Diizi ń nↄ̀sɛo,","poem":1},{"lineBreak":true},{"text":"to n wɛ́'i àↄ bàalɛ lán swa'iwa fãanɛ ń gwãasĩnao.","poem":1},{"lineBreak":true},{"text":"Ńsu kã́maboo,","poem":1},{"lineBreak":true},{"text":"ńsu to n wɛ́ ĩ́ampao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fɛlɛ wii kau gwã́ gudↄ̃anaↄ kↄ̃ lɛũkpakɛgↄↄ.","poem":1},{"lineBreak":true},{"text":"Ǹ n sↄ̃ wɛ̃ Diiɛ,","poem":1},{"lineBreak":true},{"text":"ní ↄdↄaàzi n nɛ́ pↄ́ lɛ́ ga ń nↄanao zɛauↄ wɛ̃ni yã́i.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii, gwa ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Dé n yã́ bee taa kɛ̀ɛ̀ yãai?","poem":1},{"lineBreak":true},{"text":"Nↄɛↄ ń nɛ́ pↄ́ aa ń í aa ń kuɛↄ soa maan wea?","poem":1},{"lineBreak":true},{"text":"Sa'onaↄ ń ãnabiↄ dɛdɛa n kpɛ́u maan wea?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ gɛↄ gↄ̃̀ kálɛa zɛau luutɛ̃u.","poem":1},{"lineBreak":true},{"text":"Wà ma ɛ̀waasoↄ ń ma wɛ̃́ndiaↄ dɛ̀dɛ ń fɛ̃ndao.","poem":1},{"lineBreak":true},{"text":"N ń dɛdɛ n pↄfɛ̃gↄↄ,","poem":1},{"lineBreak":true},{"text":"n ń kaalɛ ń wɛ̃nagwasai.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lá ni gbɛ̃́ↄ kãaa dikpɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"màa ń tò yãpãsĩ lìamazi.","poem":1},{"lineBreak":true},{"text":"N pↄkũmagↄↄ gbɛ̃e i pilimao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e i e bↄ̀o.","poem":1},{"lineBreak":true},{"text":"Ma ibɛɛↄ gbɛ̃́ pↄ́ ma ń gwá ma ń kuɛↄ mìdɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}