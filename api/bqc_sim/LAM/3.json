{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"LAM","translationId":"bqc_sim","name":"Wɛ̃nalɛ","commonName":"Wɛ̃nalɛ","title":"WƐ̃NALƐ","order":25,"numberOfChapters":5,"sha256":"a27bc254bf776119f5f4f4abb56bcffd35335dbe87fa671cca93835c775f12b5","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bqc_sim/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Wɛdↄa nↄ̀sɛniniai Dii kĩ́i"]},{"type":"verse","number":1,"content":[{"text":"Má dɛ gbɛ̃́ pↄ́ Dii pↄkũma gotↄ̃̀wà à taasi è ũɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À ma ya à ma kpa gusiauɛ,","poem":1},{"lineBreak":true},{"text":"i kɛ gupuau no.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mámɛ ìↄ ↄtↄ̃a gↄↄpii,","poem":1},{"lineBreak":true},{"text":"a láaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tò ma mɛ ibàba,","poem":1},{"lineBreak":true},{"text":"à ma wáↄ wìwi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À kona ń mɛkɛmuunao lìamazi lán bĩ́iwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tò ma ye gusiau","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ gà à gɛ̃̀gɛ̃ↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À gĩ lìamazi, má fↄ̃ bↄo,","poem":1},{"lineBreak":true},{"text":"à mↄ̀ gala gbiaↄ kpàmɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma wiilɛ̀, ma suabalɛ zùaàzi,","poem":1},{"lineBreak":true},{"text":"kási i swã́sɛmazio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À gĩbò ń gbɛ̀ gbɛ̃̀nɛↄ,","poem":1},{"lineBreak":true},{"text":"a pã̀ ma zɛ́a a dɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À gↄ̃̀mɛɛ lán gbɛaana pↄ́ naalɛa","poem":1},{"lineBreak":true},{"text":"ge nↄ̀ↄmusu pↄ́ ye láuwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À zɛ́ sìa, à ma taitai,","poem":1},{"lineBreak":true},{"text":"à ma ↄ̃̀ↄkpà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À a ka kpà sáa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma dilɛ pↄ́ pↄ́ á pá ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À a gbàla kaↄ tↄ̃̀ ma baluwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ ma gbɛ̃́ↄnɛ pↄ́ yáalↄa ũ,","poem":1},{"lineBreak":true},{"text":"aa lɛdàmanↄ ḿpii.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À blɛ kĩ̀sã ò'omɛɛ,","poem":1},{"lineBreak":true},{"text":"à ma kaka ń gↄ̃io.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À gbɛ̀kↄsↄ kpàa, ma swaa ɛ̀'ɛ,","poem":1},{"lineBreak":true},{"text":"à ↄ̃zↄ̃̀a tufua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À ma kɛ̃ aafiawa,","poem":1},{"lineBreak":true},{"text":"má dↄ̃ bↄ́ wì mɛ nama lↄo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀, ma gↄ̃ yɛ̃̀ɛɛsai,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ dↄ Diizi lↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma liaaliaaa wɛ́tɛ̃a guu dↄmagu,","poem":1},{"lineBreak":true},{"text":"a dɛmɛɛ gↄ̃i ń konao ũ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yã́pi ìↄ dↄamagu maamaaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma kúsu kwɛ̀.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ìↄ dↄmagu","poem":1},{"lineBreak":true},{"text":"ì to ma nↄ̀sɛ àↄ daa doũn kɛ:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃kɛ mɛ́ tò wi midɛo,","poem":1},{"lineBreak":true},{"text":"aà wɛ̃nadↄ̃anɛ lí láao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aà yeańzi ìↄ dafu lá gu lɛ́ dↄɛ,","poem":1},{"lineBreak":true},{"text":"a náai vĩ zↄ̃ↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ma mɛ̀, Dii mɛ́ ma baa ũ,","poem":1},{"lineBreak":true},{"text":"a yã́i má sↄ̃́aaàzi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dii maa gbɛ̃́ pↄ́ an wɛ́ dↄaàziↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aalɛ aà kĩ́i wɛɛlɛↄ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wɛdↄa Diizi zↄasai à ń suaba mɛ́ maa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A maa gbɛ̃́ taasi fↄ̃ a ɛ̀waasogↄↄɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aà zↄ̃lɛ ado kílikili,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ aà dàu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aà a mipɛlɛ bùsuu,","poem":1},{"lineBreak":true},{"text":"iↄ wɛdↄaàzi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aà a gɛɛ dↄ gbɛ̃́ pↄ́ ye a sãnkɛɛ,","poem":1},{"lineBreak":true},{"text":"i to wí a kṹ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Asa Dii lí gí gbɛ̃́i à aà tò we gↄↄpiio.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Baa tó à aà dà taasiu,","poem":1},{"lineBreak":true},{"text":"ì aà wɛ̃nagwaɛ a gbɛ̃kɛ zↄ̃ↄ lɛ́u.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dii lí gbɛ̃́ swã́gaga ń pↄnaoo,","poem":1},{"lineBreak":true},{"text":"ìli aà da taasiu pão.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tó wàlɛ ↄ̃zↄ̃ zĩ̀zↄↄwa dṹnia guu guei,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"tó wàlɛ ń yã́ málɛnɛ́ Lua Musude kpɛ́ kpɛɛlɛ,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"tó wàlɛ yã́kpalɛkɛ gbɛ̃́ↄnɛ kolea,","poem":1},{"lineBreak":true},{"text":"Diipi lɛ́ eo lé?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ mɛ á kɛ, i kɛ,","poem":1},{"lineBreak":true},{"text":"tó Dii i a zɛbↄɛ̀o ni?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Vãi ń maao ì gbɛ̃́ le Lua Musude lɛ́ saia?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩn bɛ̃́ɛ nɛ́ zɛ́ vĩ à zↄaka a duuna ĩadama yã́ musuo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Wà wɛ́tɛ wá kuai wà gwa maamaa,","poem":1},{"lineBreak":true},{"text":"wí ɛa su Diiwa.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Wà ↄdↄ Luazi musu ń nↄ̀sɛmɛndoo, wí mɛ:","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Wa duunakɛ̀, wa swã́gbãakɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ni sùuukɛwanↄo.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"N pↄkũma kàkanla, n pɛwá,","poem":1},{"lineBreak":true},{"text":"n wá dɛdɛ wá wɛ̃nagwasai.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"N sↄlↄ luabɛpuanau,","poem":1},{"lineBreak":true},{"text":"kɛ́ ńsu wá wabikɛa mao yã́i.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"N wá dílɛ ukↄlↄ ge bìsa ũ buipãleↄ guu.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Wá ibɛɛↄ swaa bìiwá ḿpii.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Vĩa ń zua baiuo mɛ́ gↄ̃̀wɛ̃ɛ","poem":1},{"lineBreak":true},{"text":"ń músio ń kaalɛao.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Ma wɛ́'i lɛ́ bàalɛ lán swa'iwa","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ tↄ̀lↄzↄ̃a yã́i.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Ma wɛ́'i aↄ kwɛ zɛsaiɛ,","poem":1},{"lineBreak":true},{"text":"aↄ kã́maboa vĩo,","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"e Dii gɛ wɛzu zĩ́lɛ à e.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ma wɛ̃́lɛ nↄɛↄ lè,","poem":1},{"lineBreak":true},{"text":"kɛ́ ma wɛsìɛ, ma nↄ̀sɛ ↄ̃̀ↄkpà.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa íbɛlɛsɛ̀manↄ pãↄ","poem":1},{"lineBreak":true},{"text":"lɛ́ ma wɛ lán bãwaɛ.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Aa ye ma wɛ̃ni bↄlia ɛu,","poem":1},{"lineBreak":true},{"text":"aa ma papa ń gbɛo.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Í dàmala,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma mɛ̀ ma gaɛ sa.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Kua za ɛ̀ títiu we","poem":1},{"lineBreak":true},{"text":"ma lɛzùnzi, Dii.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Kɛ́ ma suaba wiilɛ̀, ń mà,","poem":1},{"lineBreak":true},{"text":"ni swã́kpa ma yã́ao.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Kɛ́ ma lɛzùnzi, n sↄ̃mazi,","poem":1},{"lineBreak":true},{"text":"n mɛ̀ másu vĩakɛo.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Dii, n zɛmanↄ yã́kpalɛu,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃ni sì.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Ń è lá wà ma yã́ màlɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n yãnakpàa, Dii.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"Ń è lá aa ye tↄsia","poem":1},{"lineBreak":true},{"text":"ń vãi pↄ́ aa a lɛkpàaĩmazio píi.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Dii, ń mà lá aa ma sↄ̃sↄ̃","poem":1},{"lineBreak":true},{"text":"ń vãi pↄ́ aa a lɛkpàaĩmazio píi.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Ma ibɛɛpiↄ ìↄ lɛ́pɛ kↄ̃ swã́u,","poem":1},{"lineBreak":true},{"text":"aaìↄ lɛkpaaĩmazi gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"Ǹ ń zↄ̃lɛa gwa ń ń fɛlɛao,","poem":1},{"lineBreak":true},{"text":"ma tↄ́ mɛ́ gↄ̃̀ ń lɛ ũ.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Dii, fĩabonɛ́ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"kɛnɛ́ an yãkɛa lɛ́u.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"To an swã́ gbãakũ,","poem":1},{"lineBreak":true},{"text":"ní láaizĩmá.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Pɛ́má ń pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"ní ń tↄ̀lↄzↄ̃ dṹniau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}