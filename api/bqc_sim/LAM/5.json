{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"LAM","translationId":"bqc_sim","name":"Wɛ̃nalɛ","commonName":"Wɛ̃nalɛ","title":"WƐ̃NALƐ","order":25,"numberOfChapters":5,"sha256":"a27bc254bf776119f5f4f4abb56bcffd35335dbe87fa671cca93835c775f12b5","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/bqc_sim/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Wabikɛa kua ĩadamau"]},{"type":"verse","number":1,"content":[{"text":"Dii, to yã́ pↄ́ wá lé dↄngu!","poem":1},{"lineBreak":true},{"text":"Gwa ǹ gwa lá wà widàwá.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buipãleↄ mɛ́ gↄ̃̀ wá bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"zĩ̀loↄ mɛ́ kú wá kpɛ́ↄ guu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ nɛtonɛↄ ũ desai,","poem":1},{"lineBreak":true},{"text":"wá daↄ gↄ̃̀ gyaaↄ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Í pↄ́ wá vĩ, wi luɛ wà gbasa mi,","poem":1},{"lineBreak":true},{"text":"baa wázĩa yàa wi ↄ̃abↄ wà luɛ sa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wá ibɛɛↄ looawála,","poem":1},{"lineBreak":true},{"text":"wa kpasa, wi ĩ́ampakĩi eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wa ↄdↄ̀ Egipiↄ ń Asiliↄzi","poem":1},{"lineBreak":true},{"text":"kɛ́ wà blɛ e à mↄ́wá yã́i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wá maeↄ duunakɛ̀, aa ku lↄo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an tàaeↄ lɛ́ wí wá musu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zↄↄ mɛ́ lɛ́ kiblewá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à wá bↄ ń ↄzĩo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wi blɛ wɛɛlɛ kai guuɛ","poem":1},{"lineBreak":true},{"text":"gbãamↄnɛde pↄ́ kú sɛ̃uↄ yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wá báa wã̀ lán oo pↄ́ ditɛawa,","poem":1},{"lineBreak":true},{"text":"nↄana mↄ̀ ń mɛ̀wãa pãsĩo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wà gbãamↄ̀ wɛ̃́ndiaↄnɛ Siↄna","poem":1},{"lineBreak":true},{"text":"ń wá Yudaↄ wɛ̃́lɛↄ guuo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wà kíaↄ yèye ń ↄↄwa wà ń loo,","poem":1},{"lineBreak":true},{"text":"wi bɛɛɛ dↄ̃ maezↄ̃ↄↄnɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wì wísilↄgbɛ di ɛ̀waasoↄnɛ,","poem":1},{"lineBreak":true},{"text":"nɛgↄ̃ɛnaↄ lɛ́ fu yàabaaawa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃zↄ̃ↄↄ lí kãaa gãaɛ lↄo,","poem":1},{"lineBreak":true},{"text":"ɛ̀waasoↄ kã́mabò ń lɛsiao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wá pↄna làa,","poem":1},{"lineBreak":true},{"text":"wá ↄ̃wãa gↄ̃̀ búbuapɛa ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wá fùa gò wá miwa à lɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"waiyoo wápiↄ, wa duunakɛ̀.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bee yã́ mɛ́ tò wá pↄ yà,","poem":1},{"lineBreak":true},{"text":"yã́ beeↄ yã́i wá wɛ́ sìsi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Siↄna gbɛ̀sĩsĩ gↄ̃̀ bɛzia ũɛ,","poem":1},{"lineBreak":true},{"text":"we gbɛ̃gbonaↄ ì kìlimpau.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mpi Dii, niↄ kible gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"n zↄ̃lɛa báawa láaa vĩo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bↄ́yãi wá yã́ ìↄ sãangui?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ wá vũaa e wá wɛ̃ni lɛ́u yã̀?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii, to wà suma, wí su.","poem":1},{"lineBreak":true},{"text":"To wà ɛa su wá pá ziu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ge n giwázi fĩ́afĩa yã̀?","poem":1},{"lineBreak":true},{"text":"N pↄ fɛ̃̀wázi dúuduu yã̀?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}