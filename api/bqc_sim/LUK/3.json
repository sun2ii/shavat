{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"LUK","translationId":"bqc_sim","name":"Luku","commonName":"Luku","title":"LUKU","order":42,"numberOfChapters":24,"sha256":"72b7fb9e46cbd6097f724421bd673316ef5a2411c4a31c03840e392d0b0fc58e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bqc_sim/LUK/24.json","totalNumberOfVerses":1148},"chapter":{"number":3,"content":[{"type":"heading","content":["Zãa Da'ilɛna waasokpaa"]},{"type":"verse","number":1,"content":["Sezaa Tibelia kpalablea wɛ̃̀ gɛ̃ode guu Pↄ̃nsi Pilati mɛ́ Yude bùsu gbɛ̃zↄ̃ↄ ũ, Elodi lɛ́ kible Galile, aà dãuna Filipi lɛ́ kible Itule bùsu ń Takↄni bùsuowa, mɛ́ Lisania lɛ́ kible Abilɛni bùsuwa."]},{"type":"verse","number":2,"content":["Anasi ń Kaaifao mɛ́ sa'onkiaↄ ũ. Gↄↄ bee ↄ̃ Lua yã'ò Zakali nɛ́ Zãaɛ gbáau."]},{"type":"verse","number":3,"content":["Ɔ̃ à fɛ̀lɛ lɛ́ bɛbɛ Yuudɛ̃ baale ń baalao píi, àlɛ waasokɛ gbɛ̃́ↄnɛ. A ònɛ́ aa nↄ̀sɛlilɛ aa da'ilɛkɛ, Lua i ń duuna kɛ̃́má."]},{"type":"verse","number":4,"content":["Màa yã́ pↄ́ ãnabi Isaia ò a lá guu kɛ̀ à mɛ̀:",{"text":"Kpàwakɛna lↄↄ ma dↄ gbáau,","poem":1},{"lineBreak":true},{"text":"àlɛ mɛ à zɛkɛkɛ Diiɛ,","poem":1},{"lineBreak":true},{"text":"à zɛ́wɛwɛnaↄ pooɛ̀ súsu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guzulɛ píi a tata,","poem":1},{"lineBreak":true},{"text":"gbɛ̀ lɛsĩↄ ń sĩ̀sĩↄ daaĩ píi.","poem":1},{"lineBreak":true},{"text":"Zɛ́ koleaↄ poo súsu,","poem":1},{"lineBreak":true},{"text":"zɛ́ tòũtoũↄ daaĩ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbɛ̃́pii i e lá Lua ì ń suaba.","poem":1},{"noteId":17}]},{"type":"verse","number":7,"content":["Bíla ìↄ mↄ aà kĩ́i da'ilɛkɛi, ↄ̃ ì onɛ́: Gbɛ̃nazĩn píligonaↄ! Démɛ lɛdàwá à bàasi pↄkũma pↄ́ Lua a bↄbↄmáɛi?"]},{"type":"verse","number":8,"content":["À nↄ̀sɛlilɛa yã́ kɛ, wi dↄ̃ kɛ́ a lilɛ. Kɛ́ Ablahaũ dɛ á dezi ũ, ásu dilɛ bee mɛ́ a á bↄo. Málɛ oɛ́, Lua a fↄ̃ gbɛɛ beeↄ kɛ Ablahaũ buiↄ ũ."]},{"type":"verse","number":9,"content":["Mↄo dilɛa líↄzi kↄ̀. Lí pↄ́ lɛ́ nɛ́ maa io, wa zↄ̃ zu tɛ́uɛ."]},{"type":"verse","number":10,"content":["Bíla aà là: Tó màaɛ, wá kɛ kpelewa ni?"]},{"type":"verse","number":11,"content":["A wèmá à mɛ̀: Gbɛ̃́ pↄ́ ula vĩ mɛ̀n pla, aà ado kpa gbɛ̃́ pↄ́ vĩowa. Gbɛ̃́ pↄ́ pↄblea vĩ, aà kɛ màa lↄ."]},{"type":"verse","number":12,"content":["Ɔsinaↄ mↄ̀ da'ilɛkɛi, ↄ̃ aa aà là aa mɛ̀: Mɛtulu, wá kɛ kpelewa ni?"]},{"type":"verse","number":13,"content":["A wèmá à mɛ̀: Ásu ↄ̃asimá dɛ lá wa dìlɛlao."]},{"type":"verse","number":14,"content":["Sosaↄ aà là aa mɛ̀: Wápiↄ sↄ̃ wá kɛa ni? A ònɛ́: Ásu gbãamↄ gbɛ̃́ↄnɛ à ń bleo. À zɛ ń fĩa pↄ́ wì boɛ́o."]},{"type":"verse","number":15,"content":["Gbɛ̃́ↄ pↄna lɛ́ dɛdɛ. Gbɛ̃́pii lɛ́ làasookɛ a nↄ̀sɛ guu Zãa yã́wa, tó aↄ dɛ Mɛsii ũ."]},{"type":"verse","number":16,"content":["Zãa ònɛ́ píi à mɛ̀: Mi á da'ilɛkɛ ń íoɛ, ãma gbɛ̃e lɛ́ mↄ́, aà iko dɛmala, mi ka mà aà sabala bↄbↄɛ̀o. Ɔ̃mɛ a á da'ilɛkɛ ń Lua Nisĩnao ń tɛ́o.",{"noteId":18}]},{"type":"verse","number":17,"content":["A gbaana kũa à pↄ́ fãò, i pↄ́wɛna ká a dↄ̃u, i a sào ka tɛ́ gasai guu."]},{"type":"verse","number":18,"content":["Zãa baonakpaanɛ́ guu, à nàɛmá ń yãpãleↄ dasi."]},{"type":"verse","number":19,"content":["Kɛ́ à yã́ pↄ́ kí Elodi kɛ̀ a dãuna na Elodia yã́ musu ń vãi pãle pↄ́ a kɛ̀ↄ bↄ̀ɛ̀ gupuau píi,"]},{"type":"verse","number":20,"content":["ↄ̃ Elodi ɛ̀a yãvãikɛ̀ lↄ, à Zãa dàkpɛu."]},{"type":"verse","number":21,"content":["Kɛ́ Zãa lɛ́ gbɛ̃́ↄ da'ilɛkɛ píi, à Yesu da'ilɛkɛ̀ sↄ̃. Gↄↄ pↄ́ Yesu lɛ́ wabikɛ, luabɛ wɛ̃̀aa,"]},{"type":"verse","number":22,"content":["ↄ̃ Lua Nisĩna sù lán felenawa à dìɛ̀. Ɔ̃ wà yã'o mà bↄa luabɛ à mɛ̀: Ma Nɛ́n n ũ, má yenzi, ma pↄ kɛ̀ma na.",{"noteId":19}]},{"type":"heading","content":["Bui pↄ́ Yesu bↄ̀ ń guuↄ"]},{"type":"verse","number":23,"content":["Gↄↄ pↄ́ Yesu a zĩ dàalɛ, a wɛ̃̀ baakwi taa vĩ. Wàlɛ e Yosɛfu nɛ́ɛ.",{"text":"Yosɛfupi sↄ̃ Heli nɛ́ɛ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Helipi sↄ̃ Mata nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Matapi sↄ̃ Levii nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Leviipi sↄ̃ Mɛlɛki nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Mɛlɛkipi sↄ̃ Yana nɛ́ɛ,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yanapi sↄ̃ Yosɛfu nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Yosɛfupi sↄ̃ Matatia nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Matatiapi sↄ̃ Amↄsi nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Amↄsipi sↄ̃ Nauũ nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Nauũpi sↄ̃ Ɛsɛli nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Ɛsɛlipi sↄ̃ Nage nɛ́ɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagepi sↄ̃ Maatu nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Maatupi sↄ̃ Matatia nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Matatiapi sↄ̃ Sɛmɛi nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Sɛmɛipi sↄ̃ Yosɛku nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Yosɛkupi sↄ̃ Yoda nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Yodapi sↄ̃ Yohanani nɛ́ɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yohananipi sↄ̃ Lesa nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Lesapi sↄ̃ Zolobabɛli nɛ́