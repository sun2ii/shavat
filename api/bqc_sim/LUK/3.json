rue},{"text":"Sɛtipi sↄ̃ Adamu nɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"Adamupi sↄ̃ Lua nɛ́ɛ.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"3.6 Isa 40.3-5","reference":{"chapter":3,"verse":6}},{"noteId":18,"caller":"+","text":"3.16 Zĩn 2.3-4","reference":{"chapter":3,"verse":16}},{"noteId":19,"caller":"+","text":"3.22 Soũ 2.7, Isa 42.1","reference":{"chapter":3,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}