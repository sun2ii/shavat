{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Yã́kpalɛkɛa ń Samalideↄ ń Yelusalɛũdeↄ"]},{"type":"verse","number":1,"content":["Dii yã'ò Mↄlɛsɛ gbɛ̃́ Miseɛ Yudaↄ kíaↄ Yotaũ",{"noteId":0},"ń Aazao",{"noteId":1},"ń Ezekiao",{"noteId":2},"gↄↄ. Yã́ pↄ́ ku Samali ń Yelusalɛũowa ↄ̃ Dii òɛ̀ à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Bui píi, à swã́kpa,","poem":1},{"lineBreak":true},{"text":"dṹnia ń gbɛ̃́ pↄ́ kú a guuↄ,","poem":1},{"lineBreak":true},{"text":"à ma yãma ápii.","poem":1},{"lineBreak":true},{"text":"Dii Lua lɛ́ bↄbↄánↄ","poem":1},{"lineBreak":true},{"text":"za a bɛ pↄ́ a kua adoau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwa! Dii bↄ̀ a kúkĩi,","poem":1},{"lineBreak":true},{"text":"à pìla, àlɛ táa'o dṹnia gulɛsĩↄwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ lɛ́ yↄ́ aà zíɛ","poem":1},{"lineBreak":true},{"text":"lán zↄsa pↄ́ kú tɛ́ saɛwa.","poem":1},{"lineBreak":true},{"text":"Aalɛ bàalɛ lán í pↄ́ lɛ́ pila sĩ̀sĩwawa,","poem":1},{"lineBreak":true},{"text":"mɛ́ guzulɛↄ lɛ́ wɛ̃aa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bee a kɛ píi Yakↄbu buiↄ tàae ń Yudaↄ duunao yã́iɛ.","poem":1},{"lineBreak":true},{"text":"Bↄ́mɛ Yakↄbu buiↄ tàae ũi?","poem":1},{"lineBreak":true},{"text":"An mɛɛwia Samali tã́aↄ nolo?","poem":1},{"lineBreak":true},{"text":"Yudaↄ tã́agbagbakĩi kú má ni?","poem":1},{"lineBreak":true},{"text":"An mɛɛwia Yelusalɛũ nolo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bee yã́i má tó Samali gↄ̃ bɛzia ũ,","poem":1},{"lineBreak":true},{"text":"iↄ dɛ gu pↄ́ wa vɛ̃ɛbu kɛu ũ.","poem":1},{"lineBreak":true},{"text":"Má a gbɛↄ kↄ́lɛ guzulɛu,","poem":1},{"lineBreak":true},{"text":"mí a ɛ̃daalɛkĩiↄ bↄ gupuau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wa a tã́aↄ wíwi píiɛ,","poem":1},{"lineBreak":true},{"text":"wi tɛsↄ̃ gba pↄ́ wà mↄ̀ò ń kpɛ́uↄwa.","poem":1},{"lineBreak":true},{"text":"Má aà diipiↄ dúuzↄ̃ píiɛ.","poem":1},{"lineBreak":true},{"text":"Lá wà gbapiↄ kã̀aa káaluaↄ asea ũ,","poem":1},{"lineBreak":true},{"text":"wa taò à ɛa gↄ̃ káaluaↄ asea ũ lↄɛ.","poem":1}]},{"type":"verse","number":8,"content":["Ɔ̃ Mise mɛ̀:",{"text":"A yã́i tò má ↄ́ↄlↄ, má búbuapɛ,","poem":1},{"lineBreak":true},{"text":"máↄ bɛ bṹu kyalesai.","poem":1},{"lineBreak":true},{"text":"Má wiilɛ lán gbɛ̃gbonawa,","poem":1},{"lineBreak":true},{"text":"má ↄ́ↄlↄ lán koowa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"An bↄ gↄ̃̀ bↄ̀kↄↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"à ma gbɛ̃́ Yudaↄ lè","poem":1},{"lineBreak":true},{"text":"e Yelusalɛũ bĩ́ibↄlɛu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ásu o Gatadeↄnɛo,","poem":1},{"lineBreak":true},{"text":"ásu ↄ́ↄlↄ Akooo.","poem":1},{"lineBreak":true},{"text":"À gbeembo bùsuu Bɛtafla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Safiideↄ, à gɛ̃zɛa bṹu ń wío.","poem":1},{"lineBreak":true},{"text":"Zaanadeↄ bↄlɛ á gwaio,","poem":1},{"lineBreak":true},{"text":"Bɛtɛsɛlideↄ lɛ́ ↄ́ↄlↄ,","poem":1},{"lineBreak":true},{"text":"aa ń gba zɛkĩio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Malodeↄ lɛ́ kↄ̃dɛ aafia'eai,","poem":1},{"lineBreak":true},{"text":"asa Dii vãi zĩ̀máɛ","poem":1},{"lineBreak":true},{"text":"e Yelusalɛũ bĩ́ibↄlɛu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lakisideↄ, à godↄ sↄ̃́ↄnɛ.","poem":1},{"lineBreak":true},{"text":"Ámɛ á tò Siↄnadeↄ nà duunkɛawa,","poem":1},{"lineBreak":true},{"text":"á wɛ̃́lɛu ↄ̃ Isailiↄ tàaekɛ̀u káau.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A yã́i tò á kɛ̃́kↄ̃wa ń Mↄlɛsɛgatadeↄ.","poem":1},{"lineBreak":true},{"text":"Akazibudeↄ aaↄ dɛ Isailiↄ kíaↄnɛ yiongo lɛ́baa ũɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Malesadeↄ, Dii a mↄ́wá ń gbãamↄnɛdeo,","poem":1},{"lineBreak":true},{"text":"Isaili bɛɛɛdeↄ gɛ gɛ̃ Adulaũ gbɛ̀'ɛu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À á mi bo, í a gbáa lɛ́,","poem":1},{"lineBreak":true},{"text":"à ↄ́ↄlↄ á nɛ́ yenzideↄ musu.","poem":1},{"lineBreak":true},{"text":"À á mi kɛ gbáigbai lán yãamusuwa,","poem":1},{"lineBreak":true},{"text":"asa wàlɛ ń kũkũ zĩ̀zↄↄ ũɛ.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 2Kia 15.32","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.1 2Kia 16.1","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"1.1 2Kia 18.1","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}