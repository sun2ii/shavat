{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Yã́ pↄ́ a ↄde gbãamↄnɛdeↄ le"]},{"type":"verse","number":1,"content":["Waiyoo yãbɛ̃ɛ lɛkpaaĩnaↄ,",{"text":"gbɛ̃́ pↄ́ aaì vãi làasookɛ ń lii musuↄ!","poem":1},{"lineBreak":true},{"text":"Tó gu dↄ̀, aaì zĩkɛwà,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa a zɛ́ vĩ yã́i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aaì lua buai aa símá,","poem":1},{"lineBreak":true},{"text":"aaì wɛdↄ kpɛ́i aa kɛ ń pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Aaì gbãamↄ gbɛ̃́ɛ,","poem":1},{"lineBreak":true},{"text":"aa aà bɛ ge aà túbi síwà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayãmɛto ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má dìlɛ mà yã́yia gbɛ̃́ɛ beeↄwa,","poem":1},{"lineBreak":true},{"text":"aa e bↄuo.","poem":1},{"lineBreak":true},{"text":"Aa táa'o ń mio daa ía lↄo,","poem":1},{"lineBreak":true},{"text":"asa wɛ́tɛ̃agↄↄɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gↄↄ bee wa yãadańnↄ,","poem":1},{"lineBreak":true},{"text":"an yã́ i gↄ̃ wɛ̃nalɛ ũ wa mɛ:","poem":1},{"lineBreak":true},{"text":"Wà wá ásookɛ̀,","poem":1},{"lineBreak":true},{"text":"wà wá gbɛ̃́ↄ bùsu sìmá,","poem":1},{"lineBreak":true},{"text":"wàlɛ wá bugbɛↄ kpaalɛkↄ̃ɛ ń luayãdↄ̃nsaiↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A yã́i áↄ gbɛ̃e vĩ Dii gbɛ̃́ↄ kↄ̃kãaau","poem":1},{"lineBreak":true},{"text":"à bùsu kpaalɛ ń gbɛlaaoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ãnabi ɛgɛnaↄ yãbↄ̀lɛ aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"Wasu ãnabikɛkɛ yã́ bee musuo,","poem":1},{"lineBreak":true},{"text":"wí a wá kũo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yakↄbu buiↄ, màa álɛ oa?","poem":1},{"lineBreak":true},{"text":"Dii pↄ ì pa kpaa yã̀?","poem":1},{"lineBreak":true},{"text":"Aà yãkɛan wea?","poem":1},"Dii mɛ̀:",{"text":"Ma yã́ líↄ maa gbɛ̃́ pↄ́ ì yãkɛ a zɛ́waɛo lé?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I fɛlɛ ń ma gbɛ̃́ↄ lán ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"i gbɛ̃́ pↄ́ yãe daaoↄ ulaↄ símá,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ aalɛ su ń zĩlaoↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I ma gbɛ̃́ nↄɛↄ ya ń bɛ maau,","poem":1},{"lineBreak":true},{"text":"i ń nɛ́ↄ kɛ̃ ma gawiwa gↄↄpii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À fɛlɛ tá! Á zↄ̃lɛkĩin lao.","poem":1},{"lineBreak":true},{"text":"Bùsuɛ bee gbãlɛ̀,","poem":1},{"lineBreak":true},{"text":"à ↄ̃̀ↄkpà à kaalɛgyã sɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó mↄafilide mↄ̀ ɛɛtò à mɛ̀","poem":1},{"lineBreak":true},{"text":"á àsi maa o vɛ̃ɛ ń wɛ̃o yã́ musu,","poem":1},{"lineBreak":true},{"text":"ãnabi bee taa gbɛ̃́ɛ beeↄ ìↄ yei.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yakↄbu buiↄ, má á naaa píiɛ,","poem":1},{"lineBreak":true},{"text":"má Isaili kↄ̃naↄ kakↄ̃u.","poem":1},{"lineBreak":true},{"text":"Má ń kãaa lán sã pↄ́ kú kaauↄwa,","poem":1},{"lineBreak":true},{"text":"an dã́dãkɛkĩi súu aↄ dↄ ń dasi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gbɛ̃́ pↄ́ zɛwɛ̃̀nɛ́ a dↄaanɛ́,","poem":1},{"lineBreak":true},{"text":"aa bĩ́ibↄlɛ gboo, aai bↄlɛu.","poem":1},{"lineBreak":true},{"text":"An kía mɛ́ a dↄaanɛ́,","poem":1},{"lineBreak":true},{"text":"ma Dii má zɛmikũnɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}