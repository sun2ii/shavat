{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Isaili dↄaanaↄ lelea"]},{"type":"verse","number":1,"content":["Ɔ̃ ma ɛa ma mɛ̀:",{"text":"À swã́kpa á Yakↄbu bui kíaↄ,","poem":1},{"lineBreak":true},{"text":"á Isaili kpalablenaↄ!","poem":1},{"lineBreak":true},{"text":"I kũ àↄ yã́zɛde dↄ̃o lé?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Á za maau, á ye vãizi,","poem":1},{"lineBreak":true},{"text":"i ma gbɛ̃́ↄ báa bo,","poem":1},{"lineBreak":true},{"text":"i ń báasi wolo ń wáwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ń mɛbaasi só,","poem":1},{"lineBreak":true},{"text":"i ń báa wolo ń mɛwa,","poem":1},{"lineBreak":true},{"text":"i ń wáↄ wíwi,","poem":1},{"lineBreak":true},{"text":"i ń nↄ̀ↄ fùukɛ dàau,","poem":1},{"lineBreak":true},{"text":"i tↄɛtↄɛ ka do'oou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó aa wiilɛ̀a sa, má wemáo.","poem":1},{"lineBreak":true},{"text":"Gↄↄ bee má wɛsɛ mà ń kĩ́i gwao","poem":1},{"lineBreak":true},{"text":"yãvãi pↄ́ aa kɛ̀ yã́i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ Dii òn kɛ, à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ãnabi pↄ́ aaì ma gbɛ̃́ↄ sã́sãↄ,","poem":1},{"lineBreak":true},{"text":"tó aa pↄ́ è aa sò,","poem":1},{"lineBreak":true},{"text":"aaì mɛ aafia aↄ ku.","poem":1},{"lineBreak":true},{"text":"Tó aai pↄ́ e aa dà lɛ́ɛo sↄ̃,","poem":1},{"lineBreak":true},{"text":"aaì mɛ aa zĩ̀ sↄukɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yã́i tò gwãasĩna a kúlɛwá,","poem":1},{"lineBreak":true},{"text":"wɛ́pungu'ea aↄ kuo.","poem":1},{"lineBreak":true},{"text":"Gusia a daálaɛ,","poem":1},{"lineBreak":true},{"text":"màsokɛa aↄ ku lↄo.","poem":1},{"lineBreak":true},{"text":"Ĩatɛ̃ a gɛ̃ ãnabipiↄnɛ kpɛ́u,","poem":1},{"lineBreak":true},{"text":"fãanɛ aↄ sianɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wí a gu'enaↄ kṹ,","poem":1},{"lineBreak":true},{"text":"màsokɛnaↄ gɛɛ a gↄ̃ kpá ń wɛ́i.","poem":1},{"lineBreak":true},{"text":"Ampii aa ↄku ń lɛ́wa,","poem":1},{"lineBreak":true},{"text":"kɛ́ málɛ wemáo yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mapi sↄ̃, gbãa mↄ̀a","poem":1},{"lineBreak":true},{"text":"Dii Nisĩna pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Yã́zɛde dɛ̀dɛa ń ikoo","poem":1},{"lineBreak":true},{"text":"kɛ́ mà Yakↄbu buiↄ tàaeↄ onɛ́,","poem":1},{"lineBreak":true},{"text":"mà to Isailiↄ ń duuna dↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À yã́pi ma á Yakↄbu bui kíaↄ,","poem":1},{"lineBreak":true},{"text":"á Isaili kpalablenaↄ!","poem":1},{"lineBreak":true},{"text":"Á ye yã́zɛde gĩyãio,","poem":1},{"lineBreak":true},{"text":"i yã́ pↄ́ zɛvĩ fuangbaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I Siↄna kã́fĩ ń gbɛ̃dɛao,","poem":1},{"lineBreak":true},{"text":"i to Yelusalɛũ zↄ̃ↄkũ ń yãdↄↄsaio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A kíaↄ ì yã́gↄ̃gↄ̃ gbagusaɛ yã́i,","poem":1},{"lineBreak":true},{"text":"a sa'onaↄ ì yãdadanɛ́ ài'ea yã́i,","poem":1},{"lineBreak":true},{"text":"a ãnabiↄ ì màsokɛ ↄ̃a yã́i.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ aaì Dii tↄ́ sɛ́ aa mɛ:","poem":1},{"lineBreak":true},{"text":"Dii kú wá guuo lé?","poem":1},{"lineBreak":true},{"text":"Yã́ a wá leo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yã́i wa Siↄna sa pa bugbɛ ũɛ,","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ i gↄ̃ bɛzia ũ,","poem":1},{"lineBreak":true},{"text":"Lua kpɛ́ sĩ̀sĩ i gↄ̃ sĩ̀sĩ líkpɛde ũ.","poem":1},{"noteId":3}]}],"footnotes":[{"noteId":3,"caller":"+","text":"3.12 Zel 26.18","reference":{"chapter":3,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}