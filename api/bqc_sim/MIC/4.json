{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Dii gbɛ̀sĩsĩ"]},{"type":"verse","number":1,"content":["Gↄↄgbɛzãzĩ",{"text":"gbɛ̀sĩsĩ pↄ́ Dii kpɛ́ kuwà","poem":1},{"lineBreak":true},{"text":"a gↄ̃ gbɛ̀sĩsĩↄ mide ũ.","poem":1},{"lineBreak":true},{"text":"Wa sɛ lɛsĩ dɛ sĩ̀sĩↄla,","poem":1},{"lineBreak":true},{"text":"bui píi i siu we.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buiↄ gɛ́ we dasi, aai mɛ:","poem":1},{"lineBreak":true},{"text":"À mↄ wà dɛdɛ Dii gbɛ̀sĩsĩwa,","poem":1},{"lineBreak":true},{"text":"wí gɛ́ Yakↄbu buiↄ Lua kpɛ́u,","poem":1},{"lineBreak":true},{"text":"i wá da a zɛ́wa, wíↄ bɛu.","poem":1},{"lineBreak":true},{"text":"Dii ikoyã a bↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"aà yã́ a bↄ Yelusalɛũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yã́gↄ̃gↄ̃ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"a yãkɛkɛ bùsu zã̀zã pↄ́ gbãa vĩↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai ń fɛ̃ndaↄ gbɛ̃gbɛ̃ aa lilɛ soona ũ,","poem":1},{"lineBreak":true},{"text":"aai ń sↄ̃naↄ lilɛ máaso limibobↄ ũ.","poem":1},{"noteId":4},{"lineBreak":true},{"text":"Buie a fɛ̃nda sɛ a deezio,","poem":1},{"lineBreak":true},{"text":"wa zĩkaa dada lↄo.","poem":1},{"noteId":5}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baade a zↄ̃lɛ a vɛ̃ɛli","poem":1},{"lineBreak":true},{"text":"ń a kaadↄɛnlio gbáu,","poem":1},{"noteId":6},{"lineBreak":true},{"text":"gbɛ̃e a vĩadadańzi lↄo,","poem":1},{"lineBreak":true},{"text":"asa Dii Zĩgↄ̃de lɛ́ mɛ́ ò.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bui píi ìↄ kú ń ń tã́a tↄ́o,","poem":1},{"lineBreak":true},{"text":"wápiↄ sↄ̃, Dii wá Lua tↄ́ wáↄ kuò gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Dii mɛ̀:",{"text":"Gↄↄ bee má a gbɛ̃́ tↄ̃̀ↄlɛnaↄ kãaa,","poem":1},{"lineBreak":true},{"text":"má a gbɛ̃́ pↄ́ ma ĩadàmá ma ń yápiↄ naaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Má a gbɛ̃́ pↄ́ lɛ́ tↄ̃ↄlɛpiↄ kɛ ma gbɛ̃́ kↄ̃naↄ ũ,","poem":1},{"lineBreak":true},{"text":"má a gbɛ̃́ pↄ́ wà tàńnↄ zã̀piↄ kɛ bui gbãa ũ.","poem":1},{"lineBreak":true},{"text":"Za gↄↄ bee máↄ kiblemá","poem":1},{"lineBreak":true},{"text":"Siↄna gbɛ̀sĩsĩ musu e gↄↄpii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siↄna gbɛ̀sĩsĩá ma kpàsa dã́dãkɛgbaɛ,","poem":1},{"lineBreak":true},{"text":"aà kpala káau a ɛa suwà,","poem":1},{"lineBreak":true},{"text":"wiↄ kible Yelusalɛũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bↄ́yãi álɛ búbuapɛi?","poem":1},{"lineBreak":true},{"text":"Kɛ́ á kía vĩo yã́i yã̀?","poem":1},{"lineBreak":true},{"text":"Á lɛdamade kuo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wãwã á kṹ lán nɛ'iwãwãwaa?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ, à fĩaafĩaa ń wãwão","poem":1},{"lineBreak":true},{"text":"lán nↄɛ pↄ́ lɛ́ nɛ'iwa,","poem":1},{"lineBreak":true},{"text":"asa á bↄlɛ á wɛ̃́lɛ guu","poem":1},{"lineBreak":true},{"text":"à kálɛ sɛ̃uɛ, í tá Babɛli.","poem":1},{"lineBreak":true},{"text":"We Dii a á misiu,","poem":1},{"lineBreak":true},{"text":"we a á bↄu á ibɛɛↄ ↄzĩ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tia kɛ́wa buiↄ kãaaaázi,","poem":1},{"lineBreak":true},{"text":"aa mɛ̀ wa Siↄna ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"wiↄ gwa wàↄ pↄnakɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa Dii làasoo dↄ̃o,","poem":1},{"lineBreak":true},{"text":"aa yã́ pↄ́ àlɛ yá gbadↄ̃o,","poem":1},{"lineBreak":true},{"text":"asa à ń kãaa lán pↄ́ bàaawa pↄ́wɛngbɛ̃zɛuɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ, à fɛlɛ pↄgbɛ̃!","poem":1},{"lineBreak":true},{"text":"Má tó àↄ gbãa","poem":1},{"lineBreak":true},{"text":"lán zu pↄ́ a kↄ́ba dɛ mↄ ũ","poem":1},{"lineBreak":true},{"text":"mɛ́ a swɛ dɛ mↄgotɛ̃ ũwaɛ,","poem":1},{"lineBreak":true},{"text":"í bui dasipiↄ úlↄ.","poem":1},{"lineBreak":true},{"text":"Á ń pↄ́ pↄ́ aa è gbɛ̃blea guu kpaa,","poem":1},{"lineBreak":true},{"text":"an àizɛɛↄ i gↄ̃ mapi ma dṹnia Dii pↄ́ ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛ bĩ́ideↄ, à á zĩgↄ̃ↄ kãaa,","poem":1},{"lineBreak":true},{"text":"asa wà koezↄ̃̀áziɛ.","poem":1},{"lineBreak":true},{"text":"Wa Isailiↄ dↄaana lɛ́ ń goo a gɛɛwa.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"4.3 Yoɛ 4.10","reference":{"chapter":4,"verse":3}},{"noteId":5,"caller":"+","text":"4.3 Isa 2.2-4","reference":{"chapter":4,"verse":3}},{"noteId":6,"caller":"+","text":"4.4 Zkl 3.10","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":14}