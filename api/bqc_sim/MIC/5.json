{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Isailiↄ kía a bↄ Bɛtɛlɛũ"]},{"type":"verse","number":1,"content":["Bɛtɛlɛũ Ɛflata ń kɛ̃́sãa Yuda bùsu wɛ̃́lɛↄzi,",{"text":"ãma n guu gbɛ̃e a bↄu,","poem":1},{"lineBreak":true},{"text":"iↄ dɛmɛɛ Isailiↄ kía ũ.","poem":1},{"noteId":7},{"lineBreak":true},{"text":"Ɔ̃mɛ kú za káaukaau,","poem":1},{"lineBreak":true},{"text":"aà fɛlɛa ku à gɛ̃̀gɛ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ayãmɛto Isailiↄ aaↄ ku vũaaa","poem":1},{"lineBreak":true},{"text":"e gↄↄ pↄ́ nɛ'ina a gɛ nɛ́pi iò,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ kĩniↄ i su ń Isailiↄ sãnu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A fɛlɛ ń dã́dãkɛ ń Dii gbãao","poem":1},{"lineBreak":true},{"text":"ń Dii a Lua zↄ̃ↄkɛo.","poem":1},{"lineBreak":true},{"text":"Aà zↄ̃ↄkɛ a ligua e dṹnia lɛ́wa,","poem":1},{"lineBreak":true},{"text":"aaiↄ ku niɛ guu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ aↄ dɛ ń aafia ũ.","poem":1},{"lineBreak":true},{"text":"Tó Asiliↄ sì wá bùsuu,","poem":1},{"lineBreak":true},{"text":"tó aa ↄ̃zↄ̃̀ wá wɛ̃́lɛ bĩ́ideↄwa,","poem":1},{"lineBreak":true},{"text":"wá tó dↄaana gbɛ̃ↄn soplaↄ fɛlɛńnↄ,","poem":1},{"lineBreak":true},{"text":"kíapiↄ ka se swaaↄ̃.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa kible Asili bùsuwa ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"aa gbãable Niũlodi","poem":1},{"noteId":8},{"text":"bùsupiwa","poem":1},{"lineBreak":true},{"text":"ń fɛ̃ndao woa a kpɛ́u.","poem":1},{"lineBreak":true},{"text":"Tó Asiliↄ sìwágu","poem":1},{"lineBreak":true},{"text":"mɛ́ aa ↄ̃zↄ̃̀ wá bùsuwa,","poem":1},{"lineBreak":true},{"text":"kíapi mɛ́ a wá bↄ ń ↄzĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yakↄbu bui kↄ̃naↄ ku buiↄ guu","poem":1},{"lineBreak":true},{"text":"lán fíi pↄ́ bↄ̀ Dii kĩ́i kpaawa,","poem":1},{"lineBreak":true},{"text":"ìli sↄ̃́a gbɛ̃nazĩnazio,","poem":1},{"lineBreak":true},{"text":"lán lou'i pↄ́ fã̀fã sɛ̃wawa,","poem":1},{"lineBreak":true},{"text":"ìli gbɛ̃e dão.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yakↄbu bui kↄ̃naↄ aaↄ ku buiↄ guu,","poem":1},{"lineBreak":true},{"text":"bùsu pↄ́ aaↄ ku a guuↄ aaↄ dasi,","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄmusu kua líkpɛ nↄ̀bↄↄ guu","poem":1},{"lineBreak":true},{"text":"ge nↄ̀ↄkusi kua sã kaauwa.","poem":1},{"lineBreak":true},{"text":"Gↄↄ pↄ́ àlɛ pãa,","poem":1},{"lineBreak":true},{"text":"ì kusimá à ń taitai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à ń bↄ aà ↄzĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Á ↄloo á ibɛɛↄla,","poem":1},{"lineBreak":true},{"text":"í á wɛ̀lɛpiↄ dɛdɛ píi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"gↄↄ bee má á sↄ̃́ↄ midɛ á guu,","poem":1},{"lineBreak":true},{"text":"mí á sↄ̃́goↄ wíwi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Má á bùsu wɛ̃́lɛↄ dɛ̃ↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"mí a zɛgikĩiↄ kwɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má á gbɛ̃kↄↄlɛkɛnaↄ bãdɛ,","poem":1},{"lineBreak":true},{"text":"pↄdamadeↄ aaↄ kú á guu lↄo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má tã́a pↄ́ á ã̀ↄ ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"má gbɛ pↄ́ á pɛ̀lɛↄ wíwi,","poem":1},{"lineBreak":true},{"text":"á kúlɛ á pↄkɛapiↄnɛ lↄo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má Asetaati líↄ wolɛwolɛ,","poem":1},{"lineBreak":true},{"text":"mí á wɛ̃́lɛↄ yaa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bui pↄ́ aai ma yãmaoↄ sↄ̃,","poem":1},{"lineBreak":true},{"text":"má tↄsimá ń pↄkũmao ń kyã̀wãaoɛ.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"5.1 Mat 2.6, Zãa 7.42","reference":{"chapter":5,"verse":1}},{"noteId":8,"caller":"+","text":"5.5 Daa 10.8-11","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}