{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Dii bↄbↄa ń Isailiↄ"]},{"type":"verse","number":1,"content":["À swã́kpa yã́ pↄ́ Dii òi!",{"text":"À mɛ̀ mà fɛlɛ zɛ,","poem":1},{"lineBreak":true},{"text":"mà bↄ ń yã́o gbɛ̀sĩsĩↄ wáa,","poem":1},{"lineBreak":true},{"text":"mà to sĩ̀sĩↄ ma lↄↄ ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ, à yã́ pↄ́ Dii lɛ́ bↄo ma!","poem":1},{"lineBreak":true},{"text":"Dṹnia zĩ́na pↄ́ ìↄ ku gↄↄpiiↄ","poem":1},{"lineBreak":true},{"text":"à swã́kpa!","poem":1},{"lineBreak":true},{"text":"Asa Dii lɛ́ bↄbↄ ń a gbɛ̃́ↄɛ,","poem":1},{"lineBreak":true},{"text":"a yãvĩ ń Isailiↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ↄ, bↄ́ má kɛ̀ɛ́i?","poem":1},{"lineBreak":true},{"text":"Bↄ́ má kɛ̀ a kpasamanↄi?","poem":1},{"lineBreak":true},{"text":"À omɛɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma á bↄ́lɛ Egipi,","poem":1},{"noteId":9},{"lineBreak":true},{"text":"ma á bↄ́ zↄbleu,","poem":1},{"lineBreak":true},{"text":"Ma Mↄizi","poem":1},{"noteId":10},{"text":"zĩ̀ à dↄ̀aaɛ́","poem":1},{"lineBreak":true},{"text":"ń Aalonao ń Miliaũo.","poem":1},{"noteId":11}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vãi pↄ́ Mↄabuↄ kí Balaki dìlɛ à kɛɛ́","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ Bɛↄↄ nɛ́ Balaaũ","poem":1},{"noteId":12},{"text":"wèwào,","poem":1},{"lineBreak":true},{"text":"à to à dↄágu ma gbɛ̃́ↄ.","poem":1},{"lineBreak":true},{"text":"Ma dↄaaɛ́ sɛa za Sitiũ","poem":1},{"lineBreak":true},{"text":"e a gɛ ka Giligali,","poem":1},{"noteId":13},{"lineBreak":true},{"text":"kɛ́ à e ma maakɛaↄ dↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bↄ́ má gɛ zɛò Dii aɛi?","poem":1},{"lineBreak":true},{"text":"Bↄ́ má kúlɛò Lua Musudeɛi?","poem":1},{"lineBreak":true},{"text":"Má gɛ zɛ aà aɛ ń gáae wɛ̃donao yã̀?","poem":1},{"lineBreak":true},{"text":"Má sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ oowà yã̀?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A sãsa mɛ̀n ↄ̀aa sↄo si yã̀,","poem":1},{"lineBreak":true},{"text":"ge nísi ta mɛ̀n ↄ̀aasↄsↄo lɛɛ kwi?","poem":1},{"lineBreak":true},{"text":"Má a nɛgↄ̃ɛ sɛ̃́ia kpá ma tàae fĩabobↄ ũ yã̀?","poem":1},{"lineBreak":true},{"text":"Má nɛ́ pↄ́ bↄ̀ ma plɛu kpa ma duuna awakpabↄ ũ yã̀?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna, wà yã́ pↄ́ maa ònɛ.","poem":1},{"lineBreak":true},{"text":"Yã́ kpele Dii lɛ́ gbɛamai?","poem":1},{"lineBreak":true},{"text":"Yãkɛ a zɛ́wa, níↄ ye gbɛ̃kɛkɛai.","poem":1},{"lineBreak":true},{"text":"Ǹ nzĩa busa, ní tɛ́ Luazi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À Dii lↄↄ ma dↄ,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛzu mɛɛwiadeↄzi.","poem":1},{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ ↄ̃nↄ ũ.","poem":1},{"lineBreak":true},{"text":"À go pↄ́ a á gbɛ̃ gwa,","poem":1},{"lineBreak":true},{"text":"í Lua pↄ́ dìlɛ yãma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔvãi ku vãikɛnaↄ ua e tia","poem":1},{"lineBreak":true},{"text":"ń zaa mↄafilide pↄ́ dɛ láaipↄ ũo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kiloo gbɛ̃blebↄ vĩ","poem":1},{"lineBreak":true},{"text":"a gbiayↄ̃bↄ vãiↄ kũa,","poem":1},{"lineBreak":true},{"text":"má aà bↄ maa nɛe?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɛɛwiaɛ bee ↄdeↄ pãsĩ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a gbɛ̃́ kĩniↄ ì ɛɛtoto,","poem":1},{"lineBreak":true},{"text":"mↄafiliyã mɛ́ kú ń lɛ́u.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ayãmɛto ma na á dɛdɛawa,","poem":1},{"lineBreak":true},{"text":"málɛ á ásookɛ á duuna yã́i.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Á pↄble, kási á kã́o,","poem":1},{"lineBreak":true},{"text":"á nↄ̀sɛ a gↄ̃ da giiɛ.","poem":1},{"lineBreak":true},{"text":"Á pↄ́ dilɛ kũ̀sũa ũ, a gↄↄplakɛo,","poem":1},{"lineBreak":true},{"text":"asa má á kũ̀sũapi kpa zĩ̀blenaↄwaɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Á pↄ́tↄ̃, kási á kɛkɛo.","poem":1},{"lineBreak":true},{"text":"Á nísi kɛ, kási á a mↄaokɛo.","poem":1},{"lineBreak":true},{"text":"Á vɛ̃ɛ dafu kɛ, kási á a imio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Á Ɔmɛli","poem":1},{"noteId":14},{"text":"yã'onɛ kũa","poem":1},{"lineBreak":true},{"text":"ń Ahabu","poem":1},{"noteId":15},{"text":"bɛdeↄ yãkɛaↄ píi,","poem":1},{"lineBreak":true},{"text":"a ń ↄlɛsɛ̀.","poem":1},{"lineBreak":true},{"text":"A yã́i tò má á dúuzↄ̃,","poem":1},{"lineBreak":true},{"text":"mí tó wà á mɛɛwiadeↄ láanikɛ,","poem":1},{"lineBreak":true},{"text":"í gↄ̃ bui píiɛ gbɛ̃́ sↄ̃́sↄ̃bↄ ũ.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"6.4 Bↄa 12.50-51","reference":{"chapter":6,"verse":4}},{"noteId":10,"caller":"+","text":"6.4 Bↄa 4.10-16","reference":{"chapter":6,"verse":4}},{"noteId":11,"caller":"+","text":"6.4 Bↄa 15.20","reference":{"chapter":6,"verse":4}},{"noteId":12,"caller":"+","text":"6.5 Nao 22.2-24.25","reference":{"chapter":6,"verse":5}},{"noteId":13,"caller":"+","text":"6.5 Yoz 3.1-4.19","reference":{"chapter":6,"verse":5}},{"noteId":14,"caller":"+","text":"6.16 1Kia 16.21","reference":{"chapter":6,"verse":16}},{"noteId":15,"caller":"+","text":"6.16 1Kia 16.29, 21.25-26","reference":{"chapter":6,"verse":16}}]},"thisChapterLink":"/api/bqc_sim/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}