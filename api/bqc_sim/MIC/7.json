{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"MIC","translationId":"bqc_sim","name":"Mise","commonName":"Mise","title":"MISE","order":33,"numberOfChapters":7,"sha256":"a03e50f23c1df90e17dbcf6bc59d9d9aa98d676a9d47eef5bc22d3a302d49944","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/bqc_sim/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Isailiↄ fɛlɛa"]},{"type":"verse","number":1,"content":["Waiyoo mapi!",{"text":"Má dɛ lán gbɛ̃́ pↄ́ lɛ́ libɛ","poem":1},{"lineBreak":true},{"text":"ge vɛ̃ɛbɛ kↄ̃nwɛwaɛ.","poem":1},{"lineBreak":true},{"text":"Vɛ̃ɛ kↄ́ ge kaadↄɛn sɛ̃́ia pↄ́ mi a nidɛ ku lↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luayãmanaↄ làa dṹniau,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ ku gbɛ̃nazĩnaↄ guu lↄo.","poem":1},{"lineBreak":true},{"text":"Ampii aaì gbɛ̃́ dã́dã aa dɛ,","poem":1},{"lineBreak":true},{"text":"baade lɛ́ a gbɛ̃́dee wɛ ń táaluo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa vãikɛa gↄ̃i vĩ ↄplaa ń zɛɛo.","poem":1},{"lineBreak":true},{"text":"Kía ì pↄ́ gbɛa,","poem":1},{"lineBreak":true},{"text":"yã́kpalɛkɛna ì gbagusaɛsi,","poem":1},{"lineBreak":true},{"text":"gbãade ì azĩa pↄeã dilɛnɛ́,","poem":1},{"lineBreak":true},{"text":"ampii aaì gbɛ̃́ wɛtãò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An gbɛ̃maaↄ dɛ lán lɛaawa,","poem":1},{"lineBreak":true},{"text":"an dendaeↄ pãsĩ dɛ lɛsikaoa.","poem":1},{"lineBreak":true},{"text":"An ĩadamagↄↄ pↄ́ ń gudↄ̃anaↄ a yã'ò kà,","poem":1},{"lineBreak":true},{"text":"an bã̀abãabogↄↄ pìla se.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n gbɛ̃́dee náaikɛo,","poem":1},{"lineBreak":true},{"text":"ńsu ǹyↄ̃ daa n kwàasi gã̀uwao.","poem":1},{"lineBreak":true},{"text":"Laaika yã́ pↄ́ ńyↄ̃ o nↄɛ pↄ́ kpá ń kùɛɛzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛgↄ̃ɛ a a mae kpɛbↄ,","poem":1},{"lineBreak":true},{"text":"nɛnↄɛ a fɛlɛ ń a dao,","poem":1},{"lineBreak":true},{"text":"nↄzãe a bↄ a zãda kpɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ bɛdeↄ gↄ̃ aà ibɛɛↄ ũ.","poem":1},{"noteId":16}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ ma wɛ́ aↄ dↄ Diizi,","poem":1},{"lineBreak":true},{"text":"má Lua ma Suabanapi dã́.","poem":1},{"lineBreak":true},{"text":"Ma Lua a ma yãma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wá ibɛɛↄ su pↄnakɛ wá yã́ musuo.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ wa lɛlɛ, wá fɛlɛɛ.","poem":1},{"lineBreak":true},{"text":"Baa tó wá kálɛa gusiau,","poem":1},{"lineBreak":true},{"text":"Dii a gupuwɛ̃ɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá wa duunakɛ̀ Diiɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ a pↄkũma bↄbↄwá","poem":1},{"lineBreak":true},{"text":"e àↄ gɛ́ yã́siiwanↄ,","poem":1},{"lineBreak":true},{"text":"i to yã́ bↄwanↄ na.","poem":1},{"lineBreak":true},{"text":"A wá da gupuau,","poem":1},{"lineBreak":true},{"text":"a wá suaba, wí wɛ́siɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó wá ibɛɛↄ è, wí a ń kṹ.","poem":1},{"lineBreak":true},{"text":"Wá ibɛɛpiↄ òwɛ̃ɛ yãa","poem":1},{"lineBreak":true},{"text":"aa mɛ̀ Dii wá Lua ku máɛ?","poem":1},{"lineBreak":true},{"text":"Wa ↄ̃zↄ̃má lán pɛ̀lɛawa gãaɛ,","poem":1},{"lineBreak":true},{"text":"wí wɛ́siɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siↄna bĩ́ibogↄↄ a ká,","poem":1},{"lineBreak":true},{"text":"gↄↄ bee a kálɛa a yàasa kṹ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gↄↄ bee gbɛ̃́ↄ bↄ Asili ń Egipi wɛ̃́lɛↄ guu,","poem":1},{"lineBreak":true},{"text":"aa bↄ za Egipi ń Uflatao,","poem":1},{"lineBreak":true},{"text":"za ísia baale ń baalao,","poem":1},{"lineBreak":true},{"text":"za gbɛ̀sĩsĩ kpɛle ń kpɛlao,","poem":1},{"lineBreak":true},{"text":"aai mↄ we.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dṹnia a gↄ̃ yàaa","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú a guuↄ yãkɛaↄ gbɛ ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii, ǹ ń gbɛ̃́ↄ dã́dãkɛ ń n gopanao,","poem":1},{"lineBreak":true},{"text":"n kpàsa sãpiↄ aaiↄ kú ńtɛ̃ɛ Kaamɛli líkpɛu,","poem":1},{"lineBreak":true},{"text":"aai pↄble Basana ń Galadao dã́dãkɛkĩi maau lán yãawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ yãbↄnsaɛↄ kɛnɛ́,","poem":1},{"lineBreak":true},{"text":"lá ń kɛ̀ gↄↄ pↄ́ n bↄńnↄ Egipiwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Buipãleↄ e,","poem":1},{"lineBreak":true},{"text":"wí i ń kṹ ń nɛgↄ̃nkɛyã musu.","poem":1},{"lineBreak":true},{"text":"Aa ↄku ń lɛ́wa,","poem":1},{"lineBreak":true},{"text":"an swã́ iↄ kɛ weũu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa bùsu ble lán mlɛ̃wa,","poem":1},{"lineBreak":true},{"text":"lán pↄ́taa'onkuawaↄwa.","poem":1},{"lineBreak":true},{"text":"Aa bↄ ń ulɛkĩiↄ guu,","poem":1},{"lineBreak":true},{"text":"aa mↄ Dii wá Luawa ń lualuao.","poem":1},{"lineBreak":true},{"text":"N vĩa a ń kṹ, sↄ̃ i kɛ̃́ńgu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lua, démɛ muaannↄi?","poem":1},{"lineBreak":true},{"text":"Ni n gbɛ̃́ kↄ̃naↄ duuna kɛ̃́má,","poem":1},{"lineBreak":true},{"text":"ni sùuukɛńnↄ ń ń tàaeↄ.","poem":1},{"lineBreak":true},{"text":"N pↄ líↄ paa gↄↄpiio,","poem":1},{"lineBreak":true},{"text":"gbɛ̃kɛkɛanɛ́ mɛ́ ì kangu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ɛa wá wɛ̃nagwa lↄ,","poem":1},{"lineBreak":true},{"text":"ní ↄ̃zↄ̃ wá yãvãiↄwa,","poem":1},{"lineBreak":true},{"text":"ní wá duuna zu ísia í títiu píi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ náaiyã kɛ Yakↄbu buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ gbɛ̃kɛkɛ Ablahaũ buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"lá ń a lɛgbɛ̃̀ wá dezipiↄnɛ za káauwa.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"7.6 Mat 10.35-36, Luk 12.53","reference":{"chapter":7,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}