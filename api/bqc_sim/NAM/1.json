{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"NAM","translationId":"bqc_sim","name":"Nauũ","commonName":"Nauũ","title":"NAUŨ","order":34,"numberOfChapters":3,"sha256":"aa6c4dce5a66ce3647780ad28a9baa3a8a1456566c0eeb1ad2de25cb7a2ebd64","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"heading","content":["Dii pↄpaa Ninivadeↄzi"]},{"type":"verse","number":1,"content":["Niniva",{"noteId":0},"yã́ pↄ́ Ɛlekosi gbɛ̃́ Nauũ è taalan kɛ:"]},{"type":"verse","number":2,"content":[{"text":"Dii nↄ̀sɛ ì fɛlɛ à tↄsimá,","poem":1},{"lineBreak":true},{"text":"Dii ì tↄsimá, pↄfɛ̃den aà ũ,","poem":1},{"lineBreak":true},{"text":"Dii ì tↄsi a ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"ìↄ fɛ̃a a wɛ̀lɛↄzi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii pↄ lí pa kpaao,","poem":1},{"lineBreak":true},{"text":"a gbãa vĩ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ìli tó tàaede bↄ̀ pão.","poem":1},{"lineBreak":true},{"text":"Dii ku zàa'ĩana ń zàao guu,","poem":1},{"lineBreak":true},{"text":"luabɛpuana dɛ aà kɛ̀sɛ luutɛ̃ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ì ísia lele, gugii i bↄ,","poem":1},{"lineBreak":true},{"text":"ì to swa píi í ba,","poem":1},{"lineBreak":true},{"text":"Basana ń Kaamɛlio i gↄ̃ wɛ̃nannↄ,","poem":1},{"lineBreak":true},{"text":"Libã bùsu sɛdɛ lá bↄlↄↄ i giigaga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ ì deedee Dii aɛ,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄ ì yↄ́,","poem":1},{"lineBreak":true},{"text":"dṹnia ì lualua aà yã́i,","poem":1},{"lineBreak":true},{"text":"tↄↄlɛ ń pↄ́ pↄ́ kuwàↄ píi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ gí aà kpɛ̃nɛmuuii?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ àↄ zɛa","poem":1},{"lineBreak":true},{"text":"aà pↄkũma pãsĩ bↄbↄmagↄↄi?","poem":1},{"lineBreak":true},{"text":"Aà pↄfɛ̃ ì bↄ lán tɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"gbɛsiↄ i wi aà aɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii maa,","poem":1},{"lineBreak":true},{"text":"a dɛ mikpakĩi ũ wɛ́tɛ̃agↄↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ nàaàziↄ ↄ̃ a ń yã́ dↄ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A a wɛ̀lɛↄ midɛ ń idaaguao,","poem":1},{"lineBreak":true},{"text":"a a ibɛɛpiↄ ya ń kpá gusiau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lɛ́ kpele aalɛ kpaaĩ Diizii?","poem":1},{"lineBreak":true},{"text":"A a midɛ,","poem":1},{"lineBreak":true},{"text":"aa wɛ́tɛ̃amↄɛ́ gɛ̃n plao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa igbɛ̃ aa kã́, aai gↄ̃ ye lɛu,","poem":1},{"lineBreak":true},{"text":"tɛ́ i kṹmá míↄmiↄ lán sɛ̃̀ giiwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niniva gbɛ̃e lɛ́ lɛ́ gia da gbɛ̃́ↄwa,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛkpaaĩ ń gbɛ̃́ↄ Diizi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Baa tó an zĩgↄ̃ↄ mↄ̀ ń dasilɛu,","poem":1},{"lineBreak":true},{"text":"wa ń kwɛ́ɛ, aai sãalɛ.","poem":1},{"lineBreak":true},{"text":"Baa kɛ́ ma á swãgàga yãa,","poem":1},{"lineBreak":true},{"text":"má gága lↄo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má zuu pↄ́ aa dàɛ́ gboo,","poem":1},{"lineBreak":true},{"text":"má mↄ pↄ́ aa kàwá kɛ̃́kɛ̃.","poem":1}]},{"type":"verse","number":14,"content":["Yã́ pↄ́ ma Dii má ò Niniva yã́ musun kɛ:",{"text":"N gbɛ̃e a gↄ̃ n tↄ́ aↄ kuwà lↄo.","poem":1},{"lineBreak":true},{"text":"Má pↄ́ ãaↄ ń pↄ́ kásaa pↄ́ kú n tã́akpɛuↄ wíwi,","poem":1},{"lineBreak":true},{"text":"mí mia'ɛ yↄ̃nɛ, asa wɛ̃́lɛ gian n ũ.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 Sof 2.13-15","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}