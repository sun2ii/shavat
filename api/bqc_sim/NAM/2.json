{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"NAM","translationId":"bqc_sim","name":"Nauũ","commonName":"Nauũ","title":"NAUŨ","order":34,"numberOfChapters":3,"sha256":"aa6c4dce5a66ce3647780ad28a9baa3a8a1456566c0eeb1ad2de25cb7a2ebd64","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Zĩblea Ninivawa"]},{"type":"verse","number":1,"content":[{"text":"Baonakpana gwa bɛ sĩ̀sĩ musu,","poem":1},{"lineBreak":true},{"text":"àlɛ aafia kpàwakɛ.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Yudaↄ, àli á dikpɛↄ kɛ,","poem":1},{"lineBreak":true},{"text":"àli lɛ́ pↄ́ á kɛ̀ Diiwaↄ fĩaboɛ̀.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃kaalɛnapiↄ ɛa lɛ́lɛwá lↄo,","poem":1},{"lineBreak":true},{"text":"wà ń mìdɛ ḿpii.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ninivadeↄ, wàlɛ mↄ́ lɛ́lɛiwá.","poem":1},{"lineBreak":true},{"text":"À á bĩ́i dↄ̃́a, íↄ zɛ́ gwa!","poem":1},{"lineBreak":true},{"text":"À tepɛ, í zɛ gíũgiũ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii a ɛa Yakↄbu buiↄ gawi kpámá,","poem":1},{"lineBreak":true},{"text":"lá Isailipiↄ vĩ yãawaɛ.","poem":1},{"lineBreak":true},{"text":"Asa gbɛ̃waanaↄ mↄ̀ ń bùsu wàaɛ,","poem":1},{"lineBreak":true},{"text":"aa ń vɛ̃ɛbuↄ dɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An zĩgↄ̃ gbãaↄ sɛ̀ngbaoↄ tã̀,","poem":1},{"lineBreak":true},{"text":"nɛgↄ̃napiↄ ula tɛ̃a zóizoiↄ daa,","poem":1},{"lineBreak":true},{"text":"an sↄ̃́go mↄↄ lɛ́ pípi,","poem":1},{"lineBreak":true},{"text":"aa ku sↄu guu,","poem":1},{"lineBreak":true},{"text":"aalɛ ń sↄ̃naↄ gbãɛgbãɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa sì wɛ̃́lɛpi zɛau ń ń sↄ̃́goↄ bàzaao,","poem":1},{"lineBreak":true},{"text":"aalɛ kɛ gãaɛ kìlikili.","poem":1},{"lineBreak":true},{"text":"Aalɛ gɛ̃ bìoobioo lán sɛ̃tɛwa,","poem":1},{"lineBreak":true},{"text":"aa wãa lán loupilɛawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wà zĩgↄ̃ sĩanaↄ sìsi,","poem":1},{"lineBreak":true},{"text":"aalɛ wã, aalɛ kpakpagua,","poem":1},{"lineBreak":true},{"text":"aa mipɛ̀ bĩ́iwa ń wãao,","poem":1},{"lineBreak":true},{"text":"aalɛ ń sɛ̀ngbaoↄ pɛ́lɛpɛlɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa bĩ́ibↄlɛↄ wɛ̃̀wɛ̃,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ swa pã̀u wɛ̃́lɛpia,","poem":1},{"lineBreak":true},{"text":"aa kibɛ kwɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wà tà ń Niniva kí nao zĩ̀zↄ ũ,","poem":1},{"lineBreak":true},{"text":"aà zↄnↄɛnaↄ lɛ́ ↄ́ↄlↄ lán felenguuluↄwa,","poem":1},{"lineBreak":true},{"text":"aalɛ ńzĩa gbɛ̃gbɛ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ninivapi gↄ̃̀ lán íkalɛkĩiwa.","poem":1},{"lineBreak":true},{"text":"A gbɛ̃́ↄ lɛ́ gɛ̃zɛa lán íwa.","poem":1},{"lineBreak":true},{"text":"Wàlɛ onɛ́: À zɛ! À zɛ!","poem":1},{"lineBreak":true},{"text":"Ãma gbɛ̃e i ɛao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À ã́nusu sɛ́lɛ! À vua naaa!","poem":1},{"lineBreak":true},{"text":"Àizɛɛ diuɛ ń pↄ́ bɛɛɛdeↄ píi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wà pↄ́ↄ nàaa, wà pↄ́ↄ sɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ gↄ̃̀ da gii.","poem":1},{"lineBreak":true},{"text":"Sↄ̃ kɛ̃̀ gbɛ̃́ↄgu,","poem":1},{"lineBreak":true},{"text":"an gbázĩna lɛ́ lua,","poem":1},{"lineBreak":true},{"text":"an mɛ zɛa lↄo,","poem":1},{"lineBreak":true},{"text":"an baade oosìsi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusupiↄ tòo gɛ̀ máɛ?","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄmusu nɛ́ↄ pↄblekĩipi ku má ni?","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄmusu sa ń dao ìↄ bɛbɛ we yãa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e yã́ lí ń nɛ́ↄ vĩakũo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusu sapi nↄ̀ↄ kũ̀ a nɛ́ↄnɛ yãa,","poem":1},{"lineBreak":true},{"text":"à nↄ̀ↄ ɛ̀ a naↄnɛ, à mↄ̀má.","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄ pↄ́ a tàitaiↄ ka aà tòo pai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má fɛlɛnnↄ,","poem":1},{"lineBreak":true},{"text":"má n sↄ̃́goↄ kpasa, a súɛlɛ iↄ dↄ,","poem":1},{"lineBreak":true},{"text":"wi n nɛ́piↄ dɛdɛ ń fɛ̃ndao.","poem":1},{"lineBreak":true},{"text":"Má pↄ́ pↄ́ ń sìmáↄ kaalɛ,","poem":1},{"lineBreak":true},{"text":"wa n zĩnaↄ yã'o ma lↄo.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"2.1 Isa 52.7","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}