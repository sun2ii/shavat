{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"NAM","translationId":"bqc_sim","name":"Nauũ","commonName":"Nauũ","title":"NAUŨ","order":34,"numberOfChapters":3,"sha256":"aa6c4dce5a66ce3647780ad28a9baa3a8a1456566c0eeb1ad2de25cb7a2ebd64","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Waiyoo Niniva"]},{"type":"verse","number":1,"content":[{"text":"Waiyoo gbɛ̃dɛnaↄ wɛ̃́lɛ!","poem":1},{"lineBreak":true},{"text":"Ìliↄ ku gbɛ̃taitaisaio.","poem":1},{"lineBreak":true},{"text":"Mↄafili pàɛwà ń pↄ́ pↄ́ wa sìmáↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Flã̀ kↄ̃fĩ ń sↄ̃́go gbá kↄ̃fĩo ma dↄ!","poem":1},{"lineBreak":true},{"text":"Sↄ̃́ↄ lɛ́ bàalɛ, an góↄ lɛ́ vĩvĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zĩgↄ̃ sↄ̃deↄ lɛ́ suwà,","poem":1},{"lineBreak":true},{"text":"an fɛ̃nda wɛ́tɛ̃ lɛ́ pipi,","poem":1},{"lineBreak":true},{"text":"an sↄ̃naↄ lɛ́ tɛkɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wà ń paɛpaɛↄ dasi,","poem":1},{"lineBreak":true},{"text":"gɛↄ gↄ̃̀ kpálɛ, wa fↄ̃ dↄdↄo.","poem":1},{"lineBreak":true},{"text":"Wàlɛ kpakpa gɛↄla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Káaluapi lɛnakasaanɛ́ yã́iɛ.","poem":1},{"lineBreak":true},{"text":"Aà kákaa maa, ì kpáńzi,","poem":1},{"lineBreak":true},{"text":"à buiↄ kà zↄbleu ń lɛnakasaanɛ́o,","poem":1},{"lineBreak":true},{"text":"à ń ↄ̃̀ↄkpà a gbɛ̃kↄↄlɛkɛa guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"má fɛlɛnnↄ,","poem":1},{"lineBreak":true},{"text":"má n zwãa sɛ kanɛ n mia,","poem":1},{"lineBreak":true},{"text":"mí tó buiↄ n puizi e,","poem":1},{"lineBreak":true},{"text":"mí n asii ↄlↄ an kíaↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má n pápa ń pↄ́ gĩ vãio,","poem":1},{"lineBreak":true},{"text":"mí n kɛ pↄ́ↄpↄↄ,","poem":1},{"lineBreak":true},{"text":"mí tó gbɛ̃́pii wɛfĩma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wɛsìnlɛↄ bàalɛnɛ","poem":1},{"lineBreak":true},{"text":"aai mɛ: Niniva gↄ̃̀ da fↄ̃̀ii.","poem":1},{"lineBreak":true},{"text":"Démɛ a wɛ̃nakɛ a yã́ musui?","poem":1},{"lineBreak":true},{"text":"Má wá nↄ̀sɛnininaↄ euɛ̀i?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N maa dɛ Tɛbɛsi pↄ́ kálɛa Niili saɛa yã̀?","poem":1},{"lineBreak":true},{"text":"Swapi í mɛ́ kàedài a bĩ́i ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Etiopiↄ ń Egipiↄ mɛ́ wɛ̃́lɛpi wá ũ,","poem":1},{"lineBreak":true},{"text":"a gbãa lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"Putiↄ ń Libiiↄ ku a zɛnnↄdeↄ guuɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kási wà tà ń Tɛbɛsideↄ zĩ̀zↄↄ ũ,","poem":1},{"lineBreak":true},{"text":"wà ń nɛ́ↄ wìwi zɛ́kpaaↄ guu píiɛ.","poem":1},{"lineBreak":true},{"text":"Wà likpà an bɛɛɛdeↄ sɛa yã́ musu,","poem":1},{"lineBreak":true},{"text":"wà mↄkà an gbɛ̃zↄ̃ↄↄwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Á Ninivadeↄ sↄ̃,","poem":1},{"lineBreak":true},{"text":"ma pↄkũmabↄbↄma í a zↄ̃lɛwáɛ,","poem":1},{"lineBreak":true},{"text":"í gↄ̃ sãalɛa,","poem":1},{"lineBreak":true},{"text":"íↄ mikpakĩi wɛɛlɛ á ibɛɛↄ yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á zɛgikĩiↄ gↄ̃ lán libɛ pↄ́ màwaɛ.","poem":1},{"lineBreak":true},{"text":"Tó wa zĩ̀a, aa kwɛ a blenaↄnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gwa! Á zĩgↄ̃ↄ dɛ lán nↄɛↄwaɛ,","poem":1},{"lineBreak":true},{"text":"á wɛ̃́lɛↄ bĩ́ibↄlɛↄ wɛ̃a á wɛ̀lɛↄnɛ dàii.","poem":1},{"lineBreak":true},{"text":"Tɛ́ lɛ́ kṹ bↄlɛpiↄ gbã́aↄwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À ítↄtↄ kálɛ, asa wa á kákaɛ.","poem":1},{"lineBreak":true},{"text":"À gɛ̃ bɛ̀lɛu, í ↄ̃zↄ̃wà!","poem":1},{"lineBreak":true},{"text":"À bilikibↄò, í á bĩ́i gbãa kã́fĩ!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tɛ́ a gi kṹwá weɛ,","poem":1},{"lineBreak":true},{"text":"wi á dɛdɛ ń fɛ̃ndao.","poem":1},{"lineBreak":true},{"text":"Wa á kaalɛ kwasutɛ̃ↄ pↄblea ũɛ.","poem":1},{"lineBreak":true},{"text":"À kↄ̃ lán kwaↄwa!","poem":1},{"lineBreak":true},{"text":"À gusisi lán kwasutɛ̃ↄwa!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Á laatanaↄ dasikũ̀ lán saanaↄwa,","poem":1},{"lineBreak":true},{"text":"aaì gbɛ̃ble, aaì gɛ̃zɛa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á gudↄ̃anaↄ dɛ lán kwasutɛ̃ↄwa,","poem":1},{"lineBreak":true},{"text":"á zĩ̀kan dↄaanaↄ dasi lán kwaↄwa,","poem":1},{"lineBreak":true},{"text":"aa kpa bĩ́iwa niɛniɛ.","poem":1},{"lineBreak":true},{"text":"Tó ĩatɛ̃ bìlɛ, aaì gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"wìliↄ ń tákĩi dↄ̃o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asiliↄ kía,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ↄ dↄaanaↄ i'ò,","poem":1},{"lineBreak":true},{"text":"n zĩgↄ̃ↄ gbɛ̃zↄ̃ↄↄ gàga.","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́ↄ fãaaa sĩ̀sĩↄ musu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à ń kãaao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wíwia pↄ wà n wiwi ɛsɛ vĩo,","poem":1},{"lineBreak":true},{"text":"n bↄpi láaa vĩo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ n bao mà","poem":1},{"lineBreak":true},{"text":"ali ↄtaalɛ n yã́ musuɛ,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃e i gí n pãsĩ kpálɛsai mai a mɛwao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}