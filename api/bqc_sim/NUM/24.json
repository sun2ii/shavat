{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"NUM","translationId":"bqc_sim","name":"Naokɛa","commonName":"Naokɛa","title":"NAOKƐA Mↄizi lá síiↄ̃de","order":4,"numberOfChapters":36,"sha256":"3e577a90f929499d095b24c3a275fadc1bd03c480b4b5ef3a4ce92ca1bfd28ee","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/bqc_sim/NUM/36.json","totalNumberOfVerses":1191},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Kɛ́ Balaaũ è samaa'oa Isailiↄnɛ kà Diigu, i gɛ́ màsokɛi lↄo, ↄ̃ à aɛdↄ̀ guwaiwaiwa."]},{"type":"verse","number":2,"content":["Kɛ́ à wɛzù, ↄ̃ à Isailiↄ è kálɛa ń buiwa. Lua Nisĩna dìɛ̀,"]},{"type":"verse","number":3,"content":["ↄ̃ à yã́ pↄ́ á è ò à mɛ̀:",{"text":"Bɛↄↄ nɛ́ Balaaũ yã́n kɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ pↄ́ ma wɛ́ zɛ̃a, ma yã́n kɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ mi Lua yãma, ma yã́n kɛ:","poem":1},{"lineBreak":true},{"text":"Ma Gbãapiide wɛ́pungu è,","poem":1},{"lineBreak":true},{"text":"má kúlɛa, ma wɛ́ kɛ̃a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yakↄbuↄ bòokpaa maa fá!","poem":1},{"lineBreak":true},{"text":"Isaili zwã̀akpɛↄ kɛfɛũ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa kálɛa lán swadↄↄↄwa,","poem":1},{"lineBreak":true},{"text":"lán swaluↄwa.","poem":1},{"lineBreak":true},{"text":"Aa dɛ lán zà lí pↄ́ Dii bàↄwa,","poem":1},{"lineBreak":true},{"text":"lán sɛdɛ lí pↄ́ kú í saɛↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Í ali ń olaↄ pa yɛlɛlɛɛ,","poem":1},{"lineBreak":true},{"text":"aali pↄ́tↄ̃ tↄↄlɛ mↄ̀sɛdewaɛ.","poem":1},{"lineBreak":true},{"text":"An kía gbãa aↄ dɛ Agagala,","poem":1},{"lineBreak":true},{"text":"an kpala a tↄbↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua ń bↄ́lɛ Egipi,","poem":1},{"lineBreak":true},{"text":"aa gbãa vĩ lán zùsɛ̃lɛwa.","poem":1},{"lineBreak":true},{"text":"Aaì zĩble bui pↄ́ íbɛlɛsɛ̀ńnↄↄwa,","poem":1},{"lineBreak":true},{"text":"aaì ń wáↄ wíwi, aaì ń pápa ń kaↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aaì gaɛ, aaì wúlɛ lán nↄ̀ↄmusuwa,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ ń vui?","poem":1},{"noteId":35},{"lineBreak":true},{"text":"Lua báaada gbɛ̃́ pↄ́ aa samaa'onɛ́ↄgu,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ pↄ́ aa savãi'onɛ́ↄ ká.","poem":1},{"noteId":36}]},{"type":"verse","number":10,"content":["Balaki pↄ pà Balaaũzi, à ↄtona dↄ̀wà à mɛ̀: Ma ibɛɛↄ kaa yã́i ma n sisii, ↄ̃ n samaa'ònɛ́ gɛ̃n àaↄ̃a?"]},{"type":"verse","number":11,"content":["Ta n bɛ gↄ̃̀ↄ. Ma mɛ̀ yãa má n kpɛlaɛ, ↄ̃ Dii gìnɛ ǹ asea e."]},{"type":"verse","number":12,"content":["Balaaũ òɛ̀: Má ò gbɛ̃́ pↄ́ n ń zĩ́aↄnɛɛ fá!"]},{"type":"verse","number":13,"content":["Ma mɛ̀, baa tó n ã́nusu ń vua pↄ́ kú n bɛo kpàa píi, má bↄ Dii yã́ kpɛ mà yãkɛ ń mazĩaoo, a maa ge a vãi. Yã́ pↄ́ Dii a omɛɛ ↄ̃ má o."]},{"type":"verse","number":14,"content":["Málɛ tá ma gbɛ̃́ↄ kĩ́i sa. Mↄ mà onɛ lá gbɛ̃́piↄ kɛ n gbɛ̃́ↄnɛ zia."]},{"type":"heading","content":["Balaaũ yã́ síiↄ̃de pↄ́ a è oa"]},{"type":"verse","number":15,"content":["Ɔ̃ Balaaũ yã́ pↄ́ á è ò à mɛ̀:",{"text":"Bɛↄↄ nɛ́ Balaaũ yã́n kɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ pↄ́ ma wɛ́ zɛ̃a yã́n kɛ:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ mi Lua yãma, ma yã́n kɛ:","poem":1},{"lineBreak":true},{"text":"Má Lua Musude pↄeã dↄ̃.","poem":1},{"lineBreak":true},{"text":"Ma Gbãapiide wɛ́pungu è,","poem":1},{"lineBreak":true},{"text":"má kúlɛa, ma wɛ́ kɛ̃a.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Málɛ Isailiↄ e, i kɛ tia no,","poem":1},{"lineBreak":true},{"text":"málɛ ń gwa, a gↄↄ i ka gĩao.","poem":1},{"lineBreak":true},{"text":"Saana a bↄ Yakↄbu buiↄ guu,","poem":1},{"lineBreak":true},{"text":"kpalablena a bↄ Isailiↄ guu,","poem":1},{"lineBreak":true},{"text":"i Mↄabuↄ mi wíwi,","poem":1},{"lineBreak":true},{"text":"i zↄakanapiↄ dↄ́ fↄ̃́fↄ̃.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɛdↄũ bùsu a gↄ̃ aà pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"aà ibɛɛ Sei bùsu a gↄ̃ aà pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ gbãa iↄ kã́fĩɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yakↄbu buie a kiblemá,","poem":1},{"lineBreak":true},{"text":"a mɛɛwiade pↄ́ bↄ̀ↄ kaalɛ.","poem":1}]},{"type":"verse","number":20,"content":["Balaaũ Amalɛki buiↄ è, ↄ̃ à yã́ pↄ́ á è ò à mɛ̀:",{"text":"Amalɛki buiↄá buiↄ mideɛ,","poem":1},{"lineBreak":true},{"text":"kási aa kaalɛ zia.","poem":1}]},{"type":"verse","number":21,"content":["Kɛ́ Balaaũ Keniↄ è, ↄ̃ à yã́ pↄ́ á è ò à mɛ̀:",{"text":"Á kúkĩi gbãa gíũgiũ,","poem":1},{"lineBreak":true},{"text":"á sakpɛ kú gbɛ musu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ń beeo wa á kaalɛɛ,","poem":1},{"lineBreak":true},{"text":"Asiliↄ mɛ́ aa á kṹkũ zĩ̀zↄↄ ũ.","poem":1}]},{"type":"verse","number":23,"content":["Balaaũ yã́ pↄ́ á è ò lↄ à mɛ̀:",{"text":"Wàlɛ kↄ̃ kãaa gugbãntoo oi,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"gó'ilɛnaↄ lɛ́ bↄ Sipi bùsuu,","poem":1},{"lineBreak":true},{"text":"aa zĩble Asiliↄ ń Ɛbɛluↄwa,","poem":1},{"lineBreak":true},{"text":"kási ampiↄ kaalɛ sↄ̃ɛ.","poem":1}]},{"type":"verse","number":25,"content":["Balaaũ fɛ̀lɛ tà a bɛ, ↄ̃ Balaki dàzɛu sↄ̃."]}],"footnotes":[{"noteId":35,"caller":"+","text":"24.9 Daa 49.9","reference":{"chapter":24,"verse":9}},{"noteId":36,"caller":"+","text":"24.9 Daa 12.3","reference":{"chapter":24,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}