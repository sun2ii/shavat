{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"heading","content":["Yã́ pↄ́ a yã́i wì yáasikɛi"]},{"type":"verse","number":1,"content":[{"text":"Yáasi pↄ́ Davidi nɛ́ Salomↄↄ,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Isailiↄ kía kɛ̀,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kɛ́ gbɛ̃́ↄ e ↄ̃nↄkũ, aaↄ laai vĩ,","poem":1},{"lineBreak":true},{"text":"aai dↄ̃ayã dada,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"aai gↄ̃ wɛzɛ̃n làasoodeↄ ũ,","poem":1},{"lineBreak":true},{"text":"maakɛa ń yã́zɛdeo ń náaio yã́ musu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yáasipiↄ ì nↄ̀sɛdoũde gba laai,","poem":1},{"lineBreak":true},{"text":"ì to ɛ̀waaso àↄ ku a dↄ̀ↄwa ń dↄ̃ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laaide i ma, aà yãdadaa i gɛ́ aɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛde i lɛdama e a guu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"i yáasi ń yãlɛɛũanɛo midↄ̃","poem":1},{"lineBreak":true},{"text":"ń ↄ̃nↄdeↄ yã'oao ń ń faai yã́ↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ dↄ̃a zĩ́na ũ,","poem":1},{"noteId":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì saka ↄ̃nↄ ń yãdadaaoguá sↄũɛ.","poem":1}]},{"type":"heading","content":["Laaikaa gbɛ̃vãiↄ kↄ̃nii"]},{"type":"verse","number":8,"content":[{"text":"Ma nɛ́, nìli n mae yã'onɛ ma,","poem":1},{"lineBreak":true},{"text":"ńsu pãkpa n da lɛdamaio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aↄ dɛ fùa kɛfɛna ũ n miwa,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ yàbaa ũ n nↄɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tó duunkɛnaↄ lɛ́ kↄ̃nikɛnɛ,","poem":1},{"lineBreak":true},{"text":"ńsu weio, ma nɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì mɛ:","poem":1},{"lineBreak":true},{"text":"Mↄ wà gɛ gbɛ̃́ↄ dã́dã wà ń dɛdɛ,","poem":1},{"lineBreak":true},{"text":"wà yãesaideↄ kpákpa wà ń kṹkũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wà ń mↄ́mↄ bɛ̃̀ɛ lá mia ì kɛwa,","poem":1},{"lineBreak":true},{"text":"wà ń mↄ́ ĩ́i lá bɛda ì kɛwa,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"wí pↄ́ ↄde bui píi e,","poem":1},{"lineBreak":true},{"text":"wá kpɛ́ↄ i pa ń pↄ́ pↄ́ wá nàaapiↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mↄ wà wá baa daaa,","poem":1},{"lineBreak":true},{"text":"wápii, wá mↄkpɛ iↄ doũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma nɛ́, ńsu gɛ́ńnↄo,","poem":1},{"lineBreak":true},{"text":"ńsu zɛ́sɛńnↄo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Asa an kɛ̀sɛ lɛɛũ ń vãikɛaoɛ,","poem":1},{"lineBreak":true},{"text":"aa wãa ń gbɛ̃dɛao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bakpaa bãↄ wáaá pãɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aalɛ baikpá ńzĩaɛɛ,","poem":1},{"lineBreak":true},{"text":"an tòe mɛ́ a ń pui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɔvãi'enaↄ zian we ḿpii,","poem":1},{"lineBreak":true},{"text":"an luaa pↄ́i mɛ́ ì ń wɛ̃ni bↄ.","poem":1}]},{"type":"heading","content":["Ɔ̃nↄ gbɛ̃́sisia"]},{"type":"verse","number":20,"content":[{"text":"Ɔ̃nↄ lɛ́ wiilɛ gãaɛ,","poem":1},{"lineBreak":true},{"text":"aà lɛ́ dↄ zɛau.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ì lɛzu zɛ́ pↄ́ wìli láauo miwa,","poem":1},{"lineBreak":true},{"text":"ì kpàwakɛ wɛ̃́lɛ bĩ́ibↄlɛↄ guu à mɛ:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄsaideↄ, áↄ kú ń ↄ̃nↄsaio e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Ma láanikɛnaↄ, á zɛ ma láanikɛaɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Sↄũↄ, áↄ za dↄ̃agu e bↄɛɛ?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tó a ma lɛdama mà yãa,","poem":1},{"lineBreak":true},{"text":"dↄ̃ ma a nisĩna pìsiwá,","poem":1},{"lineBreak":true},{"text":"mí tó àↄ ma làasoo vĩ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lá ma á sisi, a gi swã́kpai,","poem":1},{"lineBreak":true},{"text":"ma ↄ pòoɛ́, á gbɛ̃e laai i kawào,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"lá a ma lɛdama kpà swã́a píi,","poem":1},{"lineBreak":true},{"text":"i we laai pↄ́ ma á gbáio,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"tó músi á lé, má á yáalↄɛ,","poem":1},{"lineBreak":true},{"text":"tó yã́ á lé, má á láanikɛɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"baa tó yã́ á lé lán zàa'ĩanawa,","poem":1},{"lineBreak":true},{"text":"mɛ́ músi á lé lán zàalolowa,","poem":1},{"lineBreak":true},{"text":"mɛ́ taasi ń yã'ↄ̃mao gɛ̃̀ázi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gↄↄ bee á gbasa lɛzumazi,","poem":1},{"lineBreak":true},{"text":"kási má weo,","poem":1},{"lineBreak":true},{"text":"á ma kĩ́i wɛɛlɛ, kási á ma eo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Asa á za dↄ̃auɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ i zɛ ń vĩakɛa Diiɛoo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"I we ma lɛdamaio,","poem":1},{"lineBreak":true},{"text":"a sakà laai pↄ́ ma á gbáuɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Á á dàa gbɛ'e,","poem":1},{"lineBreak":true},{"text":"yãvãi pↄ́ a zɛò a wi á musu.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gia ↄ̃nↄi ì ↄ̃nↄsaideↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"làasoosai ì sↄũↄ tↄ̀lↄzↄ̃.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ma yã́ kũa sↄ̃ aↄ dↄdↄa,","poem":1},{"lineBreak":true},{"text":"aↄ ku niɛ musu vãi kã̀akɛsaiɛ.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 1Kia 5.12","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.7 Yob 28.28, Soũ 111.10","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}