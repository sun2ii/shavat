{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"heading","content":["Salomↄↄ yáasiↄ"]},{"type":"verse","number":1,"content":[{"text":"Nɛ́ ↄ̃nↄna ì to a mae pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"nɛ́ sↄũ ì a da pↄ yaɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔvãi lí àikɛo,","poem":1},{"lineBreak":true},{"text":"yãkɛa a zɛ́wa ì ń sí gawa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii lí to nↄana gbɛ̃maa dɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ ì vãikɛnaↄ tɛ̃́ ń pↄeã pↄ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pↄewosai ì to wà taasikɛ,","poem":1},{"lineBreak":true},{"text":"zĩkɛa ↄplapla mɛ́ ì to wà kɛ pↄde ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɛ́ pↄ́ blɛ gba dↄ̀ saɛá nɛ́ laaideɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ pↄ́ ì i'o pↄkɛkɛgↄↄ wí dↄ̃o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa mi ìↄ báaa vĩ,","poem":1},{"lineBreak":true},{"text":"ãma yãpãsĩ mɛ́ vãikɛna lɛ́ pà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa lí ga ń a tↄ́oo,","poem":1},{"lineBreak":true},{"text":"vãikɛna tↄ́ ì midɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna ì zĩkɛ yãdilɛnɛↄwa,","poem":1},{"lineBreak":true},{"text":"yãbↄlɛna ì azĩa nɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãkɛ a zɛ́wa ku dↄdↄa,","poem":1},{"lineBreak":true},{"text":"yãbɛ̃ɛkɛna yã́ a bↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃gwaa ń wɛ́ vãio ì mↄ́ ń yã́o,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ gbaa laai ì íbɛlɛmidɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa lɛ́á nibↄna wɛ̃nideɛ,","poem":1},{"lineBreak":true},{"text":"yãpãsĩ mɛ́ vãikɛna lɛ́ pà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zaakↄ̃u ì sòle da,","poem":1},{"lineBreak":true},{"text":"yeakↄ̃i ì láka tàae píia.","poem":1},{"noteId":13}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄyã ìↄ dↄ laaide lɛ́u,","poem":1},{"lineBreak":true},{"text":"flã mɛ́ ↄ̃nↄkɛ̃sãmade pↄ́ ũ a kpɛsɛa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna ìↄ dↄ̃a kũ̀sũa dia,","poem":1},{"lineBreak":true},{"text":"laaisaide lɛ́ ì aà dayãu àa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɔde àizɛɛ ìↄ dɛɛ̀ wɛ̃́lɛ bĩ́ide ũ,","poem":1},{"lineBreak":true},{"text":"wɛ̃nade taasikɛa mɛ́ aà midɛa ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa asea ì mↄɛ̀ ń wɛ̃nio,","poem":1},{"lineBreak":true},{"text":"vãikɛna ài ì ĩadama iɛ̀.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì lɛdama ma wɛ̃ni zɛ́ sɛ̀,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì totoa dilɛ pã zã̀ zɛ́wa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ za gbɛ̃́u mɛ́ a ye wa dↄ̃o ɛɛdeɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃'ↄ̃ↄkpanaá sↄũɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Duuna a gíↄ kui yã́ dasi bↄlɛa guuo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì a lɛ́ fↄ̃́á laaideɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa lɛ́naá ã́nusu maaɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛna nↄ̀sɛ gbiao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa yã'oa ì ń dazɛwa dasi,","poem":1},{"lineBreak":true},{"text":"laaisaide ì ga ↄ̃nↄkɛ̃sãma guuɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii báaadaańgu ì ń kɛ ↄde ũ,","poem":1},{"lineBreak":true},{"text":"zĩkɛa ń taasio lí pↄe kã́fĩo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dàakɛa dɛ sↄũɛ kↄ̃̀ↄ yã́ ũɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄkũa mɛ́ ì kɛ laaideɛ na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ vãikɛna lɛ́ a vĩakɛ mɛ́ a aà le,","poem":1},{"lineBreak":true},{"text":"Lua a gbɛ̃maa pↄeã pↄ́ kpawà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó ĩ́ana kàka à gɛ̃̀,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ aaↄ ku lↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa zĩ́na mɛ́ ìↄ pɛ́lɛa gↄↄpii.","poem":1},{"noteId":14}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lá lɛmuu kũ̀ma ì kɛ swaaɛ,","poem":1},{"lineBreak":true},{"text":"lá súɛlɛ ì kɛ wɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"màa zígbiade dɛ gbɛ̃́ pↄ́ aa aà zĩↄnɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ ì wɛ̃ni gbã̀a kã́fĩ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ sↄ̃, an wɛ̃ni a kulunkũ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ wɛ́ ìↄ dↄ pↄnai,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ sↄ̃, tãmaa a ń nɛ́ɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dii zɛ́ mɛ́ mikpakĩi ũ gbɛ̃maaↄnɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ sↄ̃, Dii ì ń kaalɛɛ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa a fu bauo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi sↄ̃ a zↄ̃lɛkĩi e dṹniauo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ ì bↄ gbɛ̃maa lɛ́u,","poem":1},{"lineBreak":true},{"text":"lɛvãide sↄ̃, wa aà lɛ́na zↄ̃ɛɛ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa yã́ pↄ́ kũ̀ wà onɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"yãbɛ̃ɛ ìↄ dↄ gbɛ̃vãi lɛ́u.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"10.12 1Kln 13.7, Zaa 5.20, 1Piɛ 4.8","reference":{"chapter":10,"verse":12}},{"noteId":14,"caller":"+","text":"10.25 Mat 7.24-27","reference":{"chapter":10,"verse":25}}]},"thisChapterLink":"/api/bqc_sim/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}