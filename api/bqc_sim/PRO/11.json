{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Dii za pↄ́yↄ̃a ń mↄafiliogu,","poem":1},{"lineBreak":true},{"text":"kiloolɛa a zɛ́wa ì kaaàgu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zĩa sɛa lɛsĩ ì mↄ́ ń wío,","poem":1},{"lineBreak":true},{"text":"zĩabusaa mɛ́ ↄ̃nↄyã ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa nↄ̀sɛpua ì aà dazɛwa,","poem":1},{"lineBreak":true},{"text":"náaisaide nↄ̀sɛ bɛ̃̀ɛ ì aà ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àizɛɛ ài vĩ yã́kpalɛkɛgↄↄzĩo,","poem":1},{"lineBreak":true},{"text":"yãkɛa a zɛ́wa mɛ́ ì ń sí gawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tàaesaide maakɛa ì zɛpooɛ̀,","poem":1},{"lineBreak":true},{"text":"vãikɛna yãvãikɛa ì aà nɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛpuade maakɛa ì aà bↄ,","poem":1},{"lineBreak":true},{"text":"náaisaide pↄnidɛa ì aà kṹ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃vãi gà, aà tãmaa ì midɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ à wɛdↄ̀i a wɛ̃nigↄↄ ì láa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì bↄ taasiu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gbɛ̃vãi ì gɛ̃u aà gɛ̃ɛ ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luayãdansai lɛ́ ì aà gbɛ̃́dee ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"ãma dↄ̃a ì gbɛ̃maa bↄu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maaↄ ku namau, wɛ̃́lɛ ìↄ naɛ,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃vãiↄ gàga, wì gulakɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wɛ̃́lɛ ì kã́fĩ nↄ̀sɛpuadeↄ sabai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ lɛ́ ì wɛ̃́lɛ dɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄkɛ̃sãmade ì saka a gbɛ̃́deegu,","poem":1},{"lineBreak":true},{"text":"laaide ì a lɛ́ fↄ̃́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃pena ì bↄ ń dãↄ asiio gupuau,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ náaide ì pↄ́ kúlɛwà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dↄaanasaikɛ ì to gbɛ̃́ↄ fu,","poem":1},{"lineBreak":true},{"text":"yãkɛkɛn dasiↄ ì to wà zĩble.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó n gbɛ̃pãle fĩa dì ń miwa, taasi n kaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ mibↄ̀lɛu ì gↄ̃ a laaiwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbãamↄnɛde ìↄ àizɛɛ vĩ,","poem":1},{"lineBreak":true},{"text":"ãma nↄɛ nↄ̀sɛmaade ìↄ gbianɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sùuude ì maa i azĩaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pãsĩ ì azĩa kpa ĩai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi zĩ ài líↄ báaa vĩo,","poem":1},{"lineBreak":true},{"text":"yãmaatↄ̃na ì ài sĩana e.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kua maa sĩana ì ń ká wɛ̃niwa,","poem":1},{"lineBreak":true},{"text":"tɛa vãizi ì mↄ́ ń gao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii ye nↄ̀sɛvãide gĩyãio,","poem":1},{"lineBreak":true},{"text":"tàaesaide yã́ ì kaaàgu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sĩana guu gbɛ̃vãiↄ bↄ pão,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ mɛ́ aa bↄ aafia.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lá vua tãana dɛ sàwakusana níu,","poem":1},{"lineBreak":true},{"text":"màa nↄ kɛfɛn ↄ̃nↄsaide dɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ pↄeã ì ń ká namawa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ tãmaa ì ń nɛ́.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ↄ pòo ì kã́fĩa e dɛ a zia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ gì pↄ́ pↄ́ dɛ à kpa kpái, pↄ́ ì kɛ̃́sãwà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩn báaade àↄ ku namau,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì ń gba niɛ a niɛ e sↄ̃.","poem":1},{"noteId":15}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wì gbɛ̃́ pↄ́ ì pↄ́wɛna ↄ̃a na dã kaɛ,","poem":1},{"lineBreak":true},{"text":"wì sa na o gbɛ̃́ pↄ́ ì yíamáɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì maa wɛɛlɛ aↄ na ń gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì vãi wɛɛlɛ, vãi a aà le.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì a àizɛɛ náaikɛ a lɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa a bↄlↄbↄ lán lí láwa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ yã'ì a uaɛ a gↄ̃ gii,","poem":1},{"lineBreak":true},{"text":"sↄũ a gↄ̃ ↄ̃nↄna zↄ ũ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa yãkɛa gbɛá lí wɛ̃nideɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna ì gbɛ̃́ e.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Lá Lua ì fĩabo gbɛ̃maaɛ dṹniau,","poem":1},{"lineBreak":true},{"text":"wa vãikɛna ń duunkɛnao pↄ́ o lↄe?","poem":1},{"noteId":16}]}],"footnotes":[{"noteId":15,"caller":"+","text":"11.25 Mat 10.42","reference":{"chapter":11,"verse":25}},{"noteId":16,"caller":"+","text":"11.31 1Piɛ 4.18","reference":{"chapter":11,"verse":31}}]},"thisChapterLink":"/api/bqc_sim/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}