{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Gbɛ̃́ pↄ́ lɛdama ì kɛɛ̀ na ye dↄ̃ai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ totoa ì kɛɛ̀ ĩ́i mi vĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii ì gbɛ̃maa wɛgwa,","poem":1},{"lineBreak":true},{"text":"ãma ì yãda làasoovãidea.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vãikɛa lí gbɛ̃e zɛdↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa zĩ́na sↄ̃ deea vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nↄ maa dɛ a zã́ɛ lán fùawa,","poem":1},{"lineBreak":true},{"text":"nↄ widamade dɛɛ̀ mɛkɛmuuna ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ ìↄ yã́zɛde yá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ lɛdama mↄafili vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ yã́á gbɛ̃wɛa yã́ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ lɛ́ ì ń bↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wì gbɛ̃vãiↄ fuangba, aai midɛ,","poem":1},{"lineBreak":true},{"text":"ãma gbɛ̃maaↄ ua ìↄ ku.","poem":1},{"noteId":17}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wì gbɛ̃́ tↄbↄ aà ↄ̃nↄ lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"faasaide sↄ̃, wì sakauɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ kpɛɛ pↄ́ ì a zĩkɛ maannↄ","poem":1},{"lineBreak":true},{"text":"dɛ zĩadilɛngbia pↄ́ blɛ ì kɛ̃́sãwàla.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa a pↄtuoↄ gwaa dↄ̃,","poem":1},{"lineBreak":true},{"text":"ãma gbɛ̃vãiↄ sósobi pãsĩ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zↄ̃ɛ ãiade ìↄ kãa,","poem":1},{"lineBreak":true},{"text":"gugiiyana sↄ̃, ↄ̃nↄ ì kɛ̃́sãwaɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ì ↄvãi nidɛ,","poem":1},{"lineBreak":true},{"text":"kási gbɛ̃maa zĩ́na mɛ́ ìↄ mↄ̀sɛ vĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi lɛ́ vãi ì aà kṹ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa sↄ̃ ì bↄ yãkeleu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛ́ maa ì ń ká pↄmaawa,","poem":1},{"lineBreak":true},{"text":"zĩ pↄ́ gbɛ̃́ kɛ̀ ài a suwà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sↄũ yãkɛa ì kɛɛ̀ maa,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna sↄ̃ ì lɛdama ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sↄũ ì to wà a pↄfɛ̃ dↄ̃wa gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"laaide sↄ̃ ìli sↄ̃́sↄ̃a dao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sĩan'ona ì yã́zɛde o,","poem":1},{"lineBreak":true},{"text":"seelade vãi yã́ ìↄ mↄafili vĩ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yãbↄlɛna yã́ ì gbɛ̃́ sↄ̃ zↄ̃ lán fɛ̃nawa,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna lɛgbɛ'i ì mↄ́ ń aafiao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sĩana pↄ́ wa ò ìↄ zɛdↄa,","poem":1},{"lineBreak":true},{"text":"ɛgɛ sↄ̃ ì gɛ̃zɛa lán wɛdɛawa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mↄafili kú vãi wàaipanaↄ sↄ̃u,","poem":1},{"lineBreak":true},{"text":"gbɛ̃'aafiawɛɛlɛnaↄ mɛ́ pↄna vĩ.","poem":1},{"noteId":18}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Vãie lí gbɛ̃maa leo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ sↄ̃, taasi ì dańla.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii ye ɛɛde gĩyãio,","poem":1},{"lineBreak":true},{"text":"aà pↄ ìↄ na sĩandewa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Laaide ìↄ a dↄ̃a kũa a sↄ̃u,","poem":1},{"lineBreak":true},{"text":"sↄũ ì yãfaasai kpàwakɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Zĩkɛa ↄplapla ì to gbɛ̃́ kible,","poem":1},{"lineBreak":true},{"text":"màa ì gbɛ̃́ da zↄbleu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kua bíli guu ì gbɛ̃́ kúsu kwɛ́,","poem":1},{"lineBreak":true},{"text":"yãna'oanɛ ì ń pↄ kɛ na.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì a gbɛ̃na dazɛwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ yãkɛa ì ń sã́sã.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Màade lí nↄ̀ↄ sãsã maamaao,","poem":1},{"lineBreak":true},{"text":"ãiade ì laaidↄ a pↄ́ↄwa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kua yã́zɛde zɛ́u wɛ̃ni vĩ,","poem":1},{"lineBreak":true},{"text":"zɛ́pi sɛa lí ń kpá gaio.","poem":1},{"noteId":19}]}],"footnotes":[{"noteId":17,"caller":"+","text":"12.7 Mat 7.24-27","reference":{"chapter":12,"verse":7}},{"noteId":18,"caller":"+","text":"12.20 Mat 5.9","reference":{"chapter":12,"verse":20}},{"noteId":19,"caller":"+","text":"12.28 Lom 6.23","reference":{"chapter":12,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}