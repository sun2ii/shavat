{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Nɛ́ ↄ̃nↄde ì a mae lɛdama ma,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́laanikɛna gbaa laai lí tↄ̃wào.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɛgbɛ'i na ì gbɛ̃́ ká pↄmaawa,","poem":1},{"lineBreak":true},{"text":"náaisaide ì ble a pãsĩ guuɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì a lɛ́ fↄ̃́ ì a wɛ̃ni dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ a lɛ́ lí kuo ì azĩa ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Màade lí pↄ́ pↄ́ á yei eo,","poem":1},{"lineBreak":true},{"text":"ãiade mɛ́ ì namable.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa za mↄafiliyãu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi ì widamá ì ń kpɛbↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yãmaakɛa ì zɛmaasɛna misi,","poem":1},{"lineBreak":true},{"text":"dàakɛa ì duunkɛna fuangba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ì ńzĩa dilɛ ↄde ũ,","poem":1},{"lineBreak":true},{"text":"kási aaliↄ pↄe vĩ sↄ̃o,","poem":1},{"lineBreak":true},{"text":"gbɛ̃eↄ ì ńzĩa dilɛ taaside ũ,","poem":1},{"lineBreak":true},{"text":"kási aaìↄ pↄ́ vĩ zↄ̃ↄ.","poem":1},{"noteId":20}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔde ì azĩa bo ń a àizɛɛo,","poem":1},{"lineBreak":true},{"text":"taaside sↄ̃ ìli wɛ́tɛ̃abiima eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ gupua aↄ pipi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ filia a gamá.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zĩa sɛa lɛsĩ mɛ́ ì sòle da,","poem":1},{"lineBreak":true},{"text":"lɛdamamaa mɛ́ ì to wà ↄ̃nↄkũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔvãi lí gɛ́ aɛo,","poem":1},{"lineBreak":true},{"text":"ↄ̃a'ea isima guu mɛ́ ì kↄ̃́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wɛdↄa pↄ́i gɛ̃gɛ̃a ì ń sↄ̃ ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"pↄeã ea ì mↄ́ ń wɛ̃ni dafuo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì fionada yã́wa a yã'e,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì gbɛ̃́ yã'onɛ ma a ài'e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna yãdanɛá nibↄna wɛ̃nideɛ,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ ga lɛ́zĩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɛzɛ̃ gbãa ì to wàↄ nańnↄ,","poem":1},{"lineBreak":true},{"text":"ãma náaisaideↄ zɛ́ pãsĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Laaideↄ ì yãkɛ ń dↄ̃ao,","poem":1},{"lineBreak":true},{"text":"sↄũ ì a faasaikɛ fãaa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zĩna vãi ì zu taasiu,","poem":1},{"lineBreak":true},{"text":"ìwa náaide ì su aafia.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gia totoai ì mↄ́ ń taasio ń wío,","poem":1},{"lineBreak":true},{"text":"lɛdamamaa ì ń kpɛla.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pↄ́nidɛa ea ì ń pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"ↄ̃ sↄũ ye kɛ̃a vãikɛawa gĩyãio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ tɛ́ ↄ̃nↄnaↄzi ì ↄ̃nↄkũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kãaaa ń sↄũↄ ì vãikũ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Taasi ìↄ tɛ duunkɛnaↄzi,","poem":1},{"lineBreak":true},{"text":"nama mɛ́ gbɛ̃maaↄ ài ũ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì túbito a tↄũnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"duunkɛna sↄ̃, aà àizɛɛ a gↄ̃ gbɛ̃maaɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Taaside bua ì blɛkɛ maamaa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ yãfuangbanaↄ ì to aà kuawà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lí a nɛ́ gbɛ̃o zaaàguɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye a nɛ́i ì aà toto a gↄↄwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì pↄble à kã́,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ nↄ̀sɛ ìↄ da gii.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"13.7 Luk 12.21, 33","reference":{"chapter":13,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}