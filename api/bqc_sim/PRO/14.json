{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Nↄɛ ↄ̃nↄde ì ua kálɛ,","poem":1},{"lineBreak":true},{"text":"a faasaide sↄ̃ ì ua fãaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãkɛ a zɛ́wa Dii vĩa vĩ,","poem":1},{"lineBreak":true},{"text":"zɛkoleasɛna ì sakaaàgu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Faasaide lɛ́ mɛ́ aà gbɛ̃bↄ ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna yã'oa ì aà bↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó zu kuo, gba ìↄ da giiɛ,","poem":1},{"lineBreak":true},{"text":"wì ài zↄ̃ↄ e ń zuↄ gbãao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Seelade sĩande lí ɛɛtoo,","poem":1},{"lineBreak":true},{"text":"seelade vãi yã́ ìↄ mↄafili vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Láanide ì kpálɛkɛ ↄ̃nↄi à kuawà,","poem":1},{"lineBreak":true},{"text":"laaide yãdↄ̃aá faaiɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɛ̃ sↄũwa zã̀zã,","poem":1},{"lineBreak":true},{"text":"asa ńyↄ̃ dↄ̃a ewào.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ ì to laaide làasookɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"sↄũ faasaikɛ ì aà sã́sã.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Faasaideↄ ì saka tàae kulɛkɛau,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ ìↄ na ń kↄ̃o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baade azĩa yã'ↄ̃ma dↄ̃,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃́ pↄnaá gbɛ̃pãle pↄ́ no.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ ua a midɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ bɛ a ↄta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zɛ́ kú ì kɛ gbɛ̃́ↄnɛ maa,","poem":1},{"lineBreak":true},{"text":"ãma a midɛkĩiá gaɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Baa yaalↄ guu nↄ̀sɛ ì ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"pↄna ku ì midɛ ń pↄsiao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pↄ̀ↄbↄzãkɛna yãkɛa ì wi aà musu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa ì a yãkɛa gbɛ'e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Làasoosaide ì yã́pii siɛ,","poem":1},{"lineBreak":true},{"text":"laaide lí yã́ náaikɛ làasookɛsaio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna vãikɛa vĩa vĩ, ì ɛ̃ɛ̀,","poem":1},{"lineBreak":true},{"text":"sↄũ ì azĩa náai vĩ, ìↄ wãa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pↄkũmade ì yã́ yãfũna kɛ,","poem":1},{"lineBreak":true},{"text":"kↄ̃nide ì to wà zaagu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄkɛ̃sãmade ì gↄ̃ faasai,","poem":1},{"lineBreak":true},{"text":"laaideↄ ì dↄ̃a kpa fùa ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ misiilɛ gbɛ̃maaↄnɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ kúlɛ nↄ̀sɛpuadeↄ kpɛɛlɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Baa taaside gbɛ̃́dee ì zaaàgu,","poem":1},{"lineBreak":true},{"text":"ãma ↄde gbɛ̃naↄ ìↄ dasi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sakaa n gbɛ̃́deeguá duunaɛ.","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ ì wɛ̃nadↄ̃ taasideↄnɛ ũ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Vãi wàaipanaↄ sã́sãao lé?","poem":1},{"lineBreak":true},{"text":"Maa wàaipanaↄ sùuu vĩ ń náaio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mɛkpaa zĩwa ìↄ ài vĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ yãbↄlɛ ì ń kɛ̃́sã.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄnaↄ àizɛɛ ì gↄ̃ ń gawi ũ,","poem":1},{"lineBreak":true},{"text":"sↄũↄ faasaikɛ ì ń gↄ̃ faasai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Seelade sĩande ì gbɛ̃́ misi,","poem":1},{"lineBreak":true},{"text":"a ɛɛde yã́ mↄafili vĩ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛá gbãa'ekĩi náaideɛ,","poem":1},{"lineBreak":true},{"text":"a dɛ misikĩi ũ ade nɛ́ↄnɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛá nibↄna wɛ̃nideɛ,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ ga lɛ́zĩ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tó kía gbɛ̃́ↄ dasi, ìↄ gawi vĩ,","poem":1},{"lineBreak":true},{"text":"bùsugbɛ̃saikɛá kpalablena músiɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a pↄ lí pa kpaao wɛ́ kɛ̃a,","poem":1},{"lineBreak":true},{"text":"pↄkũmade ì a yãfũkɛ sɛ lɛsĩ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sↄ̃daadoũ mɛ́ mɛ aafia ũ,","poem":1},{"lineBreak":true},{"text":"wɛdↄanɛ ì mɛkɛmuuna zĩmá.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wɛ̃nade wɛtãna ì aà Kɛna kpɛbↄ,","poem":1},{"lineBreak":true},{"text":"taaside wɛgwana ì aà Kɛna kpɛla.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tó yã́ vãikɛna lè, ì aà nɛɛ,","poem":1},{"lineBreak":true},{"text":"baa tó gbɛ̃maa gà, a ulɛkĩi vĩ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ ì zↄ̃lɛkĩi e wɛzɛ̃na nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"ãma wìli e sↄũwao.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yã́zɛde ì bui sɛ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"duuna ì wida gbɛ̃́ↄwa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Zↄ̀blen laaide yã́ ì ka kíagu,","poem":1},{"lineBreak":true},{"text":"ãma ì a pↄkũmabↄbↄ a gianawa.","poem":1},{"noteId":21}]}],"footnotes":[{"noteId":21,"caller":"+","text":"14.35 Mat 24.45","reference":{"chapter":14,"verse":35}}]},"thisChapterLink":"/api/bqc_sim/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}