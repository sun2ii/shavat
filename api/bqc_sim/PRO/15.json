{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Yãwea dↄ̃ ì pↄkũma kpálɛ,","poem":1},{"lineBreak":true},{"text":"yã́'ĩi ì ń pↄ fɛlɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna yã'oa ì to dↄ̃a káńgu,","poem":1},{"lineBreak":true},{"text":"sↄũ lɛ́ sↄ̃, yãfaasai ìↄ bↄlɛu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii wɛ́ kú gupiiu,","poem":1},{"lineBreak":true},{"text":"ìↄ gbɛ̃vãiↄ ń gbɛ̃maaↄ tàasika.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛ níniyã ì ń gba wɛ̃ni dafu,","poem":1},{"lineBreak":true},{"text":"yãkpaanla ì ń kãdɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Faasaide ì saka a mae totoau,","poem":1},{"lineBreak":true},{"text":"lɛdamamana sↄ̃ ìↄ laai vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ua ìↄ àizɛɛ zↄ̃ↄ vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi pↄ́ↄ ìↄ yãkele vĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna lɛ́ ì dↄ̃a fã́ɛ,","poem":1},{"lineBreak":true},{"text":"sↄũↄ sↄ̃ aa nↄ̀sɛ vĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii ye gbɛ̃vãiↄ sa'oa gĩyãio,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa wabikɛa mɛ́ ì kaaàgu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii za gbɛ̃vãi yãkɛau,","poem":1},{"lineBreak":true},{"text":"a ye gbɛ̃́ pↄ́ tɛ́ yã́zɛdeiↄzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Totoa pãsĩá gbɛ̃́ pↄ́ pã̀zɛa pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye lɛdamaio sↄ̃ gɛ̀kↄↄɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá Dii bɛda ń tɛ́o yã́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"wa gbɛ̃nazĩna sↄ̃ yã'o lↄe?","poem":1},{"noteId":22}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Láanide líↄ ye wà a gba laaio,","poem":1},{"lineBreak":true},{"text":"ìli gɛ́ ↄ̃nↄnaↄ kĩ́io.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛna ì oa tɛkɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛ ↄ̃̀ↄkpaa ì ń kúsu kwɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Làasoode ì dↄ̃a wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"sↄũ ì yãfaasai mↄ́mↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gↄↄpii ìↄ ĩ́i wɛ̃nadeɛɛ,","poem":1},{"lineBreak":true},{"text":"pↄnade ìↄ ku dikpɛ guu láasai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pↄvĩa yↄↄna vĩakɛa Diiɛ guu","poem":1},{"lineBreak":true},{"text":"maa dɛ àizɛɛ zↄ̃ↄ kũa gili guua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dò sau blea yeakↄ̃i guu","poem":1},{"lineBreak":true},{"text":"maa dɛ nↄ̀ↄ níside soa ń zaakↄ̃uoa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pↄkũmade ì sòle da,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛniɛde ì zↄa midɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Màade zɛ́ ìↄ dɛɛ̀ lɛkaa ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa zɛ́ ìↄ daaĩaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nɛ́ ↄ̃nↄde ì to a mae pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩn sↄũ ì saka a dau.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yãfaasai ì kɛ ↄ̃nↄkɛ̃sãmadeɛ na,","poem":1},{"lineBreak":true},{"text":"làasoode ì zɛ́sɛ súsu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lɛkpaaĩsai ì yã́ gboo,","poem":1},{"lineBreak":true},{"text":"lɛdamade dasiↄ ì to à kɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yãwea dↄ̃ ì a òna pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"yã'oa a gↄↄwa ìↄ na fá!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wɛ̃ni zɛ́ ì gɛ́ ń laaideↄ musu,","poem":1},{"lineBreak":true},{"text":"kɛ́ aasu si bɛdauo yã́i.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dii ì káakuna ua wí,","poem":1},{"lineBreak":true},{"text":"ì to gyaa kↄↄↄ ku a gbɛu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dii za làasoo vãiu,","poem":1},{"lineBreak":true},{"text":"yãna'oa gbãsĩ vĩɛ̀o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gbɛ̃wɛtãna ì ĩada a uawa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ za gbagusaɛu aↄ ku aafia.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì làasookɛ yã́zãsiawa,","poem":1},{"lineBreak":true},{"text":"yãvãi ì bↄlɛ gbɛ̃vãiↄ lɛ́u gↄ̃̀ↄ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dii zã̀ ń gbɛ̃vãiↄ,","poem":1},{"lineBreak":true},{"text":"ì swã́kpa gbɛ̃maaↄ wabikɛai.","poem":1},{"noteId":23}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Oa weea ì ń pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"baona ì ń wá wee.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì swãdↄ aafia lɛdamai","poem":1},{"lineBreak":true},{"text":"aↄ bele ũ ↄ̃nↄnaↄ guuɛ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ gì totoai za azĩau,","poem":1},{"lineBreak":true},{"text":"lɛdamamana mɛ́ ì gↄ̃ nↄ̀sɛde ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ ì ↄ̃nↄ danɛ́,","poem":1},{"lineBreak":true},{"text":"zĩabusaa mɛ́ ì mↄ́ ń bɛɛɛo.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"15.11 Zãa 2.25","reference":{"chapter":15,"verse":11}},{"noteId":23,"caller":"+","text":"15.29 Zãa 9.31","reference":{"chapter":15,"verse":29}}]},"thisChapterLink":"/api/bqc_sim/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}