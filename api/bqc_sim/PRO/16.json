{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Gbɛ̃nazĩna ì yã́sɛ,","poem":1},{"lineBreak":true},{"text":"ãma a midɛa ì bↄ Dii lɛ́uɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baade ì a yãkɛa e maaɛ,","poem":1},{"lineBreak":true},{"text":"ãma Dii mɛ́ ìↄ ń pↄeã dↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ n yã́ kpálɛ Dii gɛ̃zĩ,","poem":1},{"lineBreak":true},{"text":"n pↄeã i zɛkɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii pↄ́pii kɛ̀ a pↄeã yã́iɛ,","poem":1},{"lineBreak":true},{"text":"baa vãikɛnaↄ dɛ ĩadamagↄↄ pↄ́ ũɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii ye ĩ́andãnaↄ gĩyãio,","poem":1},{"lineBreak":true},{"text":"sĩana guu aa bↄ pão.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ ń náaio ì láka tàaea,","poem":1},{"lineBreak":true},{"text":"vĩakɛa Diiɛ ì ń ɛ̃ vãiɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ yãkɛaↄ kà Diigu,","poem":1},{"lineBreak":true},{"text":"ì to se aà ibɛɛↄ kɛaànↄ na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pↄ́ yↄↄna ea maakɛa guu","poem":1},{"lineBreak":true},{"text":"maa dɛ ↄvãi'ea zↄ̃ↄla.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ì zɛ́ pↄ́ á sɛ́ làasookɛ,","poem":1},{"lineBreak":true},{"text":"ãma Dii mɛ́ ì aà kɛ̀sɛ dↄdↄɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lá kía mɛ́ ì yãdilɛ Lua gɛ̃ɛ ũ,","poem":1},{"lineBreak":true},{"text":"a maa aà yã́ bↄ yã́zɛde kpɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaa maa ń kiloo lɛa súsuoá Dii pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"a zã nɛ́na ń a gbɛ̃̀nɛo píi aà pↄkɛaɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wìliↄ ye kía vãikɛna gĩyãio,","poem":1},{"lineBreak":true},{"text":"wì kpala zĩ́napɛlɛ yã́zɛde musuɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yã́zɛde'ona ì ka kíagu,","poem":1},{"lineBreak":true},{"text":"ìↄ ye sĩan'onai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kía pↄkũmaá ga zĩnaɛ,","poem":1},{"lineBreak":true},{"text":"ãma ↄ̃nↄna ì a tɛdɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kía oa weea ìↄ aafia vĩ,","poem":1},{"lineBreak":true},{"text":"aà nakɛnɛá káabuan louɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄkũa maa dɛ vuala zã̀,","poem":1},{"lineBreak":true},{"text":"gↄ̃a laaide ũ bɛɛɛ dɛ ã́nusu maaa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì zɛ́ pↄ́ ì ɛ̃ vãiɛ sɛ́,","poem":1},{"lineBreak":true},{"text":"zĩakũadↄ̃na ì a wɛ̃ni dↄ̃́a.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ĩandãa ì mↄ́ ń lɛ́lɛao,","poem":1},{"lineBreak":true},{"text":"zĩasɛa lɛsĩ ì mↄ́ ń ɛɛao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zĩabusaa taasideↄ guu","poem":1},{"lineBreak":true},{"text":"maa dɛ baadaaa ń ĩ́andãnaↄla.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì laaidↄ yã́wa ì maa e,","poem":1},{"lineBreak":true},{"text":"Dii náaikɛna mɛ́ ìↄ pↄna vĩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ nↄ̀sɛ pàɛ ↄ̃ wì mɛɛ̀ wɛzɛ̃na,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ a lɛ́ na, wì aà yãdↄ̃a zɛ́ e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Laai dɛ wɛ̃ni mi ũ gbɛ̃́ pↄ́ vĩↄnɛ,","poem":1},{"lineBreak":true},{"text":"faasaideↄ yãfaasai ì ń gbɛ̃.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna làasoo ì pisi aà lɛ́wa,","poem":1},{"lineBreak":true},{"text":"aà lɛ́ ì to wà aà yãdↄ̃a zɛ́ e.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yãna'oaá zↄsapunaɛ,","poem":1},{"lineBreak":true},{"text":"a na nↄ̀sɛu, mɛ́ ì mɛ gba aafia.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Zɛ́ kú ì kɛ gbɛ̃́ↄnɛ maa,","poem":1},{"lineBreak":true},{"text":"ãma a midɛkĩiá gaɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sɛ̃̀wana nↄ̀sɛ ì aà dazĩu,","poem":1},{"lineBreak":true},{"text":"asa nↄana ì tɛ́kpaaàguɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gbɛ̃pã ì vãikpaaĩńnↄ,","poem":1},{"lineBreak":true},{"text":"yãvãi ìↄ dↄ aà lɛ́u.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ dↄ̀ↄsai ì sòle da,","poem":1},{"lineBreak":true},{"text":"gbɛ̃pena ì gbɛ̃naↄ kɛ̃aa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pãsĩ ì kↄ̃nikɛ a gbɛ̃́deeɛ,","poem":1},{"lineBreak":true},{"text":"ì aà da zɛ́ vãiwa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ wɛ'i'o làasoo vãi vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ lɛsuikɛ zɛ̀ ń vãioɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mikã puaá fùa í gbiaɛ,","poem":1},{"lineBreak":true},{"text":"maakɛa mɛ́ ì ń káwà.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛniɛde maa dɛ zĩgↄ̃a,","poem":1},{"lineBreak":true},{"text":"zĩakũadↄ̃na maa dɛ wɛ̃́lɛsinala.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wì yãkɛkɛa gbɛa ń gbɛo,","poem":1},{"lineBreak":true},{"text":"ãma a bↄↄlɛ ì bↄ Dii kĩ́iɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}