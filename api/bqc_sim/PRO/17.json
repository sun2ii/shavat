{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Pɛ̃ɛ miↄn giina soa yãkelesai","poem":1},{"lineBreak":true},{"text":"maa dɛ nↄ̀ↄgbɛ̃a ua sòledeula.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zↄ̀ laaide ìↄ iko vĩ nɛ́ giawaɛ,","poem":1},{"lineBreak":true},{"text":"aà baa aↄ ku ua túbi guu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wì ã́nusu ń vuao baasa,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ì wá sↄ̃ tàasika.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi swã́ ìↄ na ń yãdↄↄsaio,","poem":1},{"lineBreak":true},{"text":"ɛɛde laai ìↄ ku lɛkpɛdaamáwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì taaside kɛ pↄ́ↄpↄↄ lɛ́ saka aà Kɛnaguɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì gbɛ̃́ yáalↄ músiwa a bↄ pão.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tↄũnaↄ mɛ́ ń deziↄ gawi ũ,","poem":1},{"lineBreak":true},{"text":"maeↄ mɛ́ ń nɛ́ↄ ĩ́andãbↄ ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yã́zɛde oa lí kↄ̃si ń sↄũoo,","poem":1},{"lineBreak":true},{"text":"màa ɛɛ lí kↄ̃si ń bɛɛɛde lɛ́oo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbagusaɛ dɛ zĩakɛkɛa ũ a danaɛ,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ à lìliu píi aà tá ìↄ naɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lakà tàae pↄ́ wa kɛ̀ɛ̀la ye wàↄ yeaziɛ,","poem":1},{"lineBreak":true},{"text":"yãzifɛlɛna sↄ̃ ì gbɛ̃kɛ bↄaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna gbaa laai ì tↄ̃wà","poem":1},{"lineBreak":true},{"text":"dɛ sↄũ gbɛ̃a gɛ̃n basↄola.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yãvãi mɛ́ ì dↄaa swã́gbãadeɛ,","poem":1},{"lineBreak":true},{"text":"wa zĩna sósobisaide gbaɛwà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kpaaũa ń wài pↄ́ wà a nɛ́ sɛ̀lɛo","poem":1},{"lineBreak":true},{"text":"sã̀ↄ dɛ kpaaũa ń sↄũo a mìsaikɛula.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maa fĩabò ń vãio,","poem":1},{"lineBreak":true},{"text":"vãi a kɛ̃ aà uawao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛkpaadaa dɛ lán ízɛwɛ̃awaɛ,","poem":1},{"lineBreak":true},{"text":"go we e sòle àↄ gɛ́ fɛlɛi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yãnakpaa tàaedewa ń yãdaa yãesaidelao,","poem":1},{"lineBreak":true},{"text":"Dii za yã́ beeↄu píiɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bↄ́ ài sↄũ ↄ̃adɛa a kyodↄ̃a yã́i vĩi?","poem":1},{"lineBreak":true},{"text":"Asa a nↄ̀sɛ vĩo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃naↄ ìↄ yekↄ̃i gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"vĩ̀i ń dãunaↄ ku dↄ̃a kↄ̃ɛ yã́iɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mìsaide ì a gbɛ̃do fĩa di a miwa,","poem":1},{"lineBreak":true},{"text":"ì kpɛ́gaausí a gbɛ̃́deeɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye sòlei ye duunaiɛ,","poem":1},{"lineBreak":true},{"text":"yã́gbãa'ona ì músi'i azĩaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Làasookpaanlade lí maa eo,","poem":1},{"lineBreak":true},{"text":"lɛfↄlↄde ì lɛ́lɛ da taasiu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sↄũ'ina pↄ ìↄ siaɛ,","poem":1},{"lineBreak":true},{"text":"faasaide mae pↄ líↄ nao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛnaá ɛsɛ maaɛ,","poem":1},{"lineBreak":true},{"text":"pↄsia ì ń ibaba.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vãikɛna ì gbagusaɛ sↄlↄ a ulau","poem":1},{"lineBreak":true},{"text":"kɛ́ à e yã́zɛde bãdɛò yã́iɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Laaide ì wɛbii ↄ̃nↄwa,","poem":1},{"lineBreak":true},{"text":"ãma sↄũ wɛ́pɛkĩi ìↄ zã̀ɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nɛ́ sↄũ ì a mae pↄ ya,","poem":1},{"lineBreak":true},{"text":"ì a da'ia nↄ̀sɛ ↄ̃̀ↄkpaɛ̀.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A maa wà yãesaide yíao,","poem":1},{"lineBreak":true},{"text":"bɛɛɛde gbɛ̃a a nↄ̀sɛmaa yã́i zɛvĩo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì a lɛ́ fↄ̃́ dↄ̃a vĩ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛniɛde ìↄ laai vĩ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Baa sↄũ, tó à a lɛ́ fↄ̃̀, wì aà dilɛ ↄ̃nↄna ũɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì a lɛ́ kúá laaideɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}