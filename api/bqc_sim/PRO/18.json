{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Zĩa pↄeã mɛ́ ì dↄaa gbɛ̃́ pↄ́ ì kɛ̃́máɛ,","poem":1},{"lineBreak":true},{"text":"ì fɛ̃́ńzi lɛdama píi musu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sↄũ lí pↄnakɛ wɛzɛ̃ yã́ musuo,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ dɛ̀dɛwà ↄ̃ ì o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vãikɛa ì mↄ́ ń sakanguoɛ,","poem":1},{"lineBreak":true},{"text":"kpɛbↄyã ì láani inɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna lɛgbɛ dɛ lán ísiwaɛ,","poem":1},{"lineBreak":true},{"text":"lán swa'i bàalɛa ge ↄ̃nↄ lↄ̀ↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛa vãikɛnaɛ kɛ̀kɛ","poem":1},{"lineBreak":true},{"text":"ge yãkɛkɛa yãesaideɛ ↄkpɛai maao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sↄũ lɛ́ ì aà da sòleu,","poem":1},{"lineBreak":true},{"text":"aà yã'oa ì aà kpa gbɛ̃ai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sↄũ lɛ́ ì aà ↄ̃̀ↄkpa,","poem":1},{"lineBreak":true},{"text":"aà yã'oa ì aà kũ lán baiwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃pena yã́ ì kɛnɛ́ lán zↄ́wa,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃ lɛ́u dↄ̃̀ↄ e nↄ̀sɛ kpɛau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì pãkpa a zĩiá músi dãunaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii tↄ́á ulɛkĩi lɛsĩɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa ì bàalɛ à azĩa yeu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔde àizɛɛ ìↄ dɛɛ̀ wɛ̃́lɛ kàede ũ,","poem":1},{"lineBreak":true},{"text":"a dɛɛ̀ bĩ́i pↄ́ wa fↄ̃ dɛdɛwào ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩasɛa lɛsĩ ì mↄ́ gbɛ̃́ɛ ń lɛ́lɛaoɛ,","poem":1},{"lineBreak":true},{"text":"zĩabusaa ì mↄ́ ń bɛɛɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yã́zãsi yãmasai,","poem":1},{"lineBreak":true},{"text":"mìsaikɛ ń kpɛbↄao mɛ́ ì gↄ̃ɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sↄ̃dilɛa ì gbɛ̃́ gba gbãa gyãpɛwa,","poem":1},{"lineBreak":true},{"text":"ãma démɛ a pↄsia fↄ̃i?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɛzɛ̃na ì yãdada a sↄ̃u,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna swã́ ìↄ dↄ dↄ̃ai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gba pↄ́ gbɛ̃́ dà ì zɛkɛkɛɛ̀,","poem":1},{"lineBreak":true},{"text":"ì zɛwɛ̃ɛ̀ gbɛ̃zↄ̃ↄↄ kĩ́i.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ dↄ̀aa a yã'ò, wì aà yã́zɛ e,","poem":1},{"lineBreak":true},{"text":"e aà ibɛɛ àↄ gɛ́ aà pↄ́ oi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yãkɛkɛa gbɛaa Diiwa ń gbɛo","poem":1},{"lineBreak":true},{"text":"ì sòle midɛ, ì gↄ̃gbãaↄ yoaa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Daɛ pↄ́ wà tàaekɛ̀ɛ̀ yã́ ìↄ gbãa lán bĩ́iwaɛ,","poem":1},{"lineBreak":true},{"text":"aà sòle dɛ lán zɛ́kakaa ń lɛowaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yã'oa ì gbɛ̃́ ká kãawa,","poem":1},{"lineBreak":true},{"text":"aà lɛgbɛ'i ì to pↄ́ mↄ́wà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ga ń wɛ̃nio ku lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye yã'oai a a gbɛ'e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ nↄ è pↄmaa è,","poem":1},{"lineBreak":true},{"text":"báaa bee bↄ̀ Dii kĩ́iɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Taaside ì yã'o wɛ̃nawɛ̃na,","poem":1},{"lineBreak":true},{"text":"ↄde ì yã́zãsi gbã́ugbãu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃na yàaa ì yãvãi inɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃naeↄ ku aaìↄ nańnↄ dɛ ua gbɛ̃́a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}