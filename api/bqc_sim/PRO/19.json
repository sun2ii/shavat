{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Kua taaside tàaesaide ũ","poem":1},{"lineBreak":true},{"text":"maa dɛ kua sↄũ yãvãi'ona ũla.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ãia vĩa yã́zɛdↄ̃sai maao,","poem":1},{"lineBreak":true},{"text":"wãa zↄ̃ↄ ì ń zã zɛ́waɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna faasaikɛ ì zɛ́ ↄ̃̀ↄkpaɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì Dii tàae e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àizɛɛ ì to wà gbɛ̃na e dasi,","poem":1},{"lineBreak":true},{"text":"taaside gbɛ̃na ì kɛ̃wàɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Seelade vãi a bↄ pão,","poem":1},{"lineBreak":true},{"text":"ɛɛde a gí wɛ́tɛ̃a eio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ daside ì kpalablena tↄnasi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́pii ìↄ ye gbadana àↄ dɛ a gbɛ̃́ ũɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Taaside daɛↄ ì aà vũaaɛ,","poem":1},{"lineBreak":true},{"text":"wa aà gbɛ̃naↄ kɛ̃awà o lↄo.","poem":1},{"lineBreak":true},{"text":"Tó a wɛ̀ɛlɛ yã'ońnↄ, ìli ń e bɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ ↄ̃nↄkũ ye azĩaiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye dↄ̃ai ì maa e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Seelade vãi a bↄ pão,","poem":1},{"lineBreak":true},{"text":"ɛɛde a midɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lá namablea lí kↄ̃si ń sↄũoo,","poem":1},{"lineBreak":true},{"text":"màa i kũ zↄ àↄ kible wɛ̃́ɛↄwao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wɛzɛ̃na pↄ lí pa kpaao,","poem":1},{"lineBreak":true},{"text":"lákaa tàaea mɛ́ aà ĩ́andãbↄ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kía zↄakaaá nↄ̀ↄmusu pũnaaɛ,","poem":1},{"lineBreak":true},{"text":"aà nakɛnɛá mↄ̀sɛpisia sɛ̃waɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛ́ sↄũ dɛ a mae ↄ̃̀ↄkpana ũɛ,","poem":1},{"lineBreak":true},{"text":"nↄ sòlede dɛ lán ítↄ̃tↄ̃a zɛsaiwaɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wì ua ń a àizɛɛo e mae túbi ũɛ,","poem":1},{"lineBreak":true},{"text":"ãma nↄ laaide ea ì bↄ Dii kĩ́iɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zígbiakɛ ì ń da i zↄ̃ↄ'oau,","poem":1},{"lineBreak":true},{"text":"nↄana ì màade dɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ìↄ yãdilɛnɛ kũa aↄ aafiaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì saka a kuau a ga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wɛ̃nadↄ̃̀ taasideɛ pↄ́ sɛ̃̀a Diiɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a aà yãkɛaↄ fĩaboɛ̀.","poem":1},{"noteId":24}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ n nɛ́ toto a gↄↄwa,","poem":1},{"lineBreak":true},{"text":"ãma ńsu to a gɛ̃agɛ̃ e à gao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wa ↄ̃a zↄ̃ pↄkũmadeɛ aà fĩabo,","poem":1},{"lineBreak":true},{"text":"tó n aà bò, aà boa aↄ lɛ́ vĩo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lɛdama ma, totoa yãda,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹ e ǹ ↄ̃nↄkũ zã́ yã́i.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Làasoo ku gbɛ̃nazĩna nↄ̀sɛu dasi,","poem":1},{"lineBreak":true},{"text":"ãma yã́ pↄ́ Dii zɛ̀ò mɛ́ a kɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛkɛanɛde mɛ́ ì ka gbɛ̃́ↄgu,","poem":1},{"lineBreak":true},{"text":"kua taaside ũ maa dɛ kua ɛɛde ũa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ ì mↄ́ ń wɛ̃nio,","poem":1},{"lineBreak":true},{"text":"ade ì i kãa, vãi lí aà leo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Màade ì ↄgɛ̃ tau","poem":1},{"lineBreak":true},{"text":"à fua blɛli gɛò a lɛ́ kĩ́i.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Láanide gbɛ̃, mìsaide ì gↄ̃ laai vĩ.","poem":1},{"lineBreak":true},{"text":"Wɛzɛ̃na gba laai, ì yãdada.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nɛ́ pↄ́ ì a mae gbɛ̃ mɛ́ ì a da yáá nɛ́ gia pↄ́ ì widamáɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ma nɛ́, tó n kã́mabò ń lɛdamamaao,","poem":1},{"lineBreak":true},{"text":"n pãalɛ yãdↄ̃aɛn we.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Seelade pã ì yã́zɛde láanikɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛna ì yã́'ĩi mↄ́mↄ bɛ̃̀ɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Go looa gbɛ̃́laanikɛnaↄla,","poem":1},{"lineBreak":true},{"text":"gbɛ̃aá sↄũↄ pↄ́ɛ ń kpɛsɛa.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"19.17 Mat 25.40","reference":{"chapter":19,"verse":17}}]},"thisChapterLink":"/api/bqc_sim/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}