{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["Tɛa ↄ̃nↄi ài"]},{"type":"verse","number":1,"content":[{"text":"Ma nɛ́, tó n ma yã́ sì,","poem":1},{"lineBreak":true},{"text":"mɛ́ n ma yãdilɛaↄ kũa n sↄ̃u,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"tó ńlɛ swãdↄ ↄ̃nↄyãi,","poem":1},{"lineBreak":true},{"text":"mɛ́ n sↄ̃ kpà a dadaawa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tó n lɛzù laaizi,","poem":1},{"lineBreak":true},{"text":"mɛ́ n wiilɛ̀ yãdadaai,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tó n kpálɛkɛ̀i ã́nusu ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n wɛ̀ɛlɛ àizɛɛ ulɛa ũ,","poem":1},{"noteId":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ńyↄ̃ vĩakɛa Diiɛ midↄ̃ sa,","poem":1},{"lineBreak":true},{"text":"ní Lua dↄ̃a e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asa Dii mɛ́ ì ń gba ↄ̃nↄ,","poem":1},{"lineBreak":true},{"text":"dadaa ń dↄ̃ao ì bↄ aà kĩ́iɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A kã́fĩa zɛ́ kũa gbɛ̃maaↄnɛ,","poem":1},{"lineBreak":true},{"text":"a dɛ sɛ̀ngbao ũ tàaesaideↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ì ↄlia gbɛ̃maaↄzi ń táa'oau,","poem":1},{"lineBreak":true},{"text":"ì a yãmanaↄ dↄ̃́a ń yã́ píi kɛa guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ńyↄ̃ yã́zɛde dↄ̃ sa ń yã́ dↄ̀ↄdeo","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ zɛvĩo ń maa píi zɛ́o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa ↄ̃nↄ a mↄma,","poem":1},{"lineBreak":true},{"text":"mɛ́ dↄ̃a a n kã́si.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kua ń laaio a n dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"yã́zɛdↄ̃a a ↄlianzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A n bↄ gbɛ̃vãiↄ zɛ́u","poem":1},{"lineBreak":true},{"text":"ń yãbɛ̃ɛkɛnaↄ ↄzĩo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ pã̀alɛ yãmaa zɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"aa gusia zɛ́ sɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aaì pↄnakɛ ń vãikɛao,","poem":1},{"lineBreak":true},{"text":"aaì vĩ aaↄ kɛ̃aa ń yãbɛ̃ɛ faasaio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"An kɛkɛá faa vĩo,","poem":1},{"lineBreak":true},{"text":"aaìↄ yãkɛ ń kↄ̃nioɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔ̃nↄpi a n bↄ káalua ↄzĩ,","poem":1},{"lineBreak":true},{"text":"a n si nↄɛ pãle yã́ nana oanɛwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nↄɛpi pãkpà a nɛnↄn gↄ̃i,","poem":1},{"lineBreak":true},{"text":"à a Lua bàa kuaanↄ yã́ gbòo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aà bɛ ì mipɛńnↄ gawaɛ,","poem":1},{"lineBreak":true},{"text":"aà kpɛ́ zɛ́ ì táńnↄ bɛdau.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ gɛ̃̀aàzi lí nↄ̀sɛlilɛo,","poem":1},{"lineBreak":true},{"text":"ìli wɛ̃ni zɛ́ le lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɔ̃nↄpi a n da gbɛ̃maaↄ zɛ́wa,","poem":1},{"lineBreak":true},{"text":"níↄ dↄ̀ↄdeↄ zɛ́ kũa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Asa nↄ̀sɛpuadeↄ mɛ́ aa gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"tàaesaideↄ mɛ́ aaↄ ku a guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ sↄ̃, wa ń yá ń bↄlɛuɛ,","poem":1},{"lineBreak":true},{"text":"wa náaisaideↄ kpoɛuɛ.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"2.4 Mat 13.44","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}