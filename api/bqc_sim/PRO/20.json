{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Vɛ̃ɛ ì to wà gↄ̃ láanipↄ ũ,","poem":1},{"lineBreak":true},{"text":"í gbãa ì ń da yãbↄlɛu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ tò à a dɛ ↄ̃nↄ vĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kía palaaá nↄ̀ↄmusu pũnaaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aà pↄ fɛ̃̀ɛ̀ azĩa kpà gaiɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lɛdaa lɛkpaau sai ì to wàↄ bɛɛɛ vĩ,","poem":1},{"lineBreak":true},{"text":"faasaideↄ ìↄ kãa ḿpiiɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Màade lí sapa a gↄↄo,","poem":1},{"lineBreak":true},{"text":"tó à gɛ̀ bua pↄkɛkɛgↄↄ, ìli pↄe eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna sↄ̃ yã́ dɛ lán ísiwaɛ,","poem":1},{"lineBreak":true},{"text":"wɛzɛ̃na mɛ́ a tↄa dↄ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ daside ì a gbɛ̃kɛkɛanɛ́ yã'o,","poem":1},{"lineBreak":true},{"text":"ãma bↄa gbɛ̃́ náaidewa zĩ'ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãkɛ a zɛ́wa mɛ́ maa,","poem":1},{"lineBreak":true},{"text":"báaaden nɛ́ pↄ́ à gà à ń tóↄ ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kía zↄ̃lɛa a yã́kpalɛkɛkĩi","poem":1},{"lineBreak":true},{"text":"ì vãi píi dↄ̃ a wɛ́ guu à plɛkↄ̃u.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ o a nↄ̀sɛ yãe vĩo","poem":1},{"lineBreak":true},{"text":"á kú duunasai wásawasaɛi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiloolɛa vãi ń gbɛ̃blezaao,","poem":1},{"lineBreak":true},{"text":"Dii za beeↄu píiɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa kↄ̃̀ↄ'oa guu wì dↄ̃ nɛ́wa,","poem":1},{"lineBreak":true},{"text":"tó aà yãkɛa maa mɛ́ a dↄ̀ↄ vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Swã́ pↄ́ wì yãmaò ń wɛ́ pↄ́ wì gu'eoo","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ń kɛ́ píi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó ń ye ii, ńyↄ̃ gↄ̃ taaside ũɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛ́ i vĩo, blɛ a mↄma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pↄluna ì mɛ: I ka màao! I ka màao!","poem":1},{"lineBreak":true},{"text":"Tó à kàò aɛ, ì azĩa sáaukpa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Vua saio, òso diɛ,","poem":1},{"lineBreak":true},{"text":"ãma bↄa yãfaade'onawa àao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ nibↄ fĩa dì a miwa,","poem":1},{"lineBreak":true},{"text":"ǹ aà ula si ǹyↄ̃ kũa tↄ̀ↄma ũ gbɛ̃́pi gɛ̃ɛ ũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dìidiina pↄblea ìↄ nanɛ́,","poem":1},{"lineBreak":true},{"text":"gbɛzã sa ì gↄ̃ lɛ́u lán gbɛ̀kↄsↄwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zɛ ń yã́o lɛdama musu,","poem":1},{"lineBreak":true},{"text":"yã́ gwa maamaa, ní gbasa zĩka.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃pena ìↄ bɛ ń dãↄ asiioɛ,","poem":1},{"lineBreak":true},{"text":"ńsu yãalɛ ń yãbↄlɛn zↄ̃ↄdeoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a de ge a da kà,","poem":1},{"lineBreak":true},{"text":"aà filia a gawà gusia níiniiuɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Túbiblea káau taasidↄ̃sai","poem":1},{"lineBreak":true},{"text":"líↄ báaa vĩ gbɛzão.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ńsu vãi tↄsia làasookɛo.","poem":1},{"lineBreak":true},{"text":"Sↄ̃́a Diizi à n suaba.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii za kiloolɛa vãiuɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃blezaa lí kaaàguo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dii mɛ́ ì gbɛ̃nazĩna kɛ̀sɛ dↄdↄ.","poem":1},{"lineBreak":true},{"text":"Kpelewa gbɛ̃́ a yã́ pↄ́ a kɛ zɛ́ dↄ̃i?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wã lɛgbɛ̃a Luaɛ kai vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛzã ńyↄ̃ làasookɛ lɛ́ pↄ́ ń kɛ̀wàpiwa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kía ↄ̃nↄna ì gbɛ̃vãiↄ plɛ","poem":1},{"lineBreak":true},{"text":"à ń ká gbɛu à ń kɛ kɛ́lɛkɛlɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dii filia ì gbɛ̃nazĩna làasoo pu,","poem":1},{"lineBreak":true},{"text":"ì aà nↄ̀sɛkpɛaↄ tàasika píi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ ń náaio mɛ́ kía dↄ̃̀anaↄ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃kɛkɛa ì aà kpala zɛdↄ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ɛ̀waasoↄ gbãa mɛ́ ń ĩ́andãbↄ ũ,","poem":1},{"lineBreak":true},{"text":"maezↄ̃ↄↄ mikã pua mɛ́ ń gawi ũ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃a pↄ́ ì gɛ̃ńgu ì vãi wolomá,","poem":1},{"lineBreak":true},{"text":"flã'ↄ̃ama ì gɛ̃ e za nↄ̀sɛkpɛau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}