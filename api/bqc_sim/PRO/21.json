{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Kía nↄ̀sɛ ku Dii ↄzĩ lán ízɛwaɛ,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ a yei ↄ̃ ì aà liliu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baade ìↄ e a yãkɛa maaɛ,","poem":1},{"lineBreak":true},{"text":"ãma Dii mɛ́ ìↄ ń nↄ̀sɛ dↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maakɛa ń yãkɛa a zɛ́wao","poem":1},{"lineBreak":true},{"text":"ì ka Diigu dɛ sa'oawàa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩasɛa lɛsĩ ń ĩ́andão","poem":1},{"lineBreak":true},{"text":"ì vãikɛnaↄ duuna bↄ gupuau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ãiade làasoo ì aà ka namawa,","poem":1},{"lineBreak":true},{"text":"nↄnwãade ì si pↄ́kɛ̃sãmau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àizɛɛ pↄ́ gbɛ̃́ è ɛɛtoa guu","poem":1},{"lineBreak":true},{"text":"a gɛ̃ ń ĩ́anaoɛ, aàpi i ga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ pãsĩkɛa a táńnↄ,","poem":1},{"lineBreak":true},{"text":"asa aali we yã́zɛdekɛ̀o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tàaede yãkɛa líↄ dↄ̀ↄ vĩo,","poem":1},{"lineBreak":true},{"text":"yãesaide yãkɛa ìↄ wásawasaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia gↄ̃u zã́u maa dɛ","poem":1},{"lineBreak":true},{"text":"kua kpɛ́u sãnu ń nↄ sòledeola.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vãikɛna sↄ̃ ìↄ ku vãiwaɛ,","poem":1},{"lineBreak":true},{"text":"ìli a gbɛ̃́ wɛ̃nagwao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó wà ĩadà gbɛ̃́laanikɛnawa, mìsaide ì ↄ̃nↄkũɛ,","poem":1},{"lineBreak":true},{"text":"tó wà ↄ̃nↄna gbà laai, aà dↄ̃a ì kã́fĩɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua maa, ì vãikɛna bɛ tàasika,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì vãikɛnaↄ fuangba taasiu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ i swã́kpa wɛ̃nade wiiio,","poem":1},{"lineBreak":true},{"text":"aàpi a wiilɛ sↄ̃, gbɛ̃e a wewào.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbadaa asii guu ì pↄkũma kpálɛ,","poem":1},{"lineBreak":true},{"text":"gbagusaɛ sↄlↄa ulau ì pↄfɛ̃ midɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yã́gↄ̃gↄ̃a a zɛ́wa ì gbɛ̃maa pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"ãma ì iwãa ka vãikɛna pↄaɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ pã̀alɛ wɛ́kɛ̃a zɛ́ɛ","poem":1},{"lineBreak":true},{"text":"a ta gyaadeↄ kãaauɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye pↄnakɛai a gↄ̃ pↄ́kɛ̃sãma guuɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye vɛ̃ɛi ń blɛ nísideo a kɛ ↄde ũo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ mɛ́ gbɛ̃maaↄ awakpabↄ ũ,","poem":1},{"lineBreak":true},{"text":"wa ĩada náaisaideↄwa nↄ̀sɛpuadeↄ gbɛu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zↄ̃lɛa sɛ̃gbãu maa dɛ","poem":1},{"lineBreak":true},{"text":"zↄ̃lɛa ń nↄ sòlede kpɛ̃nɛdeola.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Blɛ maa ń nísio ìↄ kálɛ ↄ̃nↄna bɛ,","poem":1},{"lineBreak":true},{"text":"ãma sↄũ ì a pↄ́ mↄ́mↄ gↄ̃̀ↄɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yã́zɛde ń gbɛ̃kɛo wɛɛlɛ","poem":1},{"lineBreak":true},{"text":"ì wɛ̃ni ń yã́ nao ń bɛɛɛo e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna ì si gↄ̃gbãaↄzi ń wɛ̃́lɛu,","poem":1},{"lineBreak":true},{"text":"ì gbãa pↄ́ aalɛ a náaikɛ gboo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a lɛ́ fↄ̃̀ à a lɛ́na zùukɛ̀,","poem":1},{"lineBreak":true},{"text":"ade kɛ́sɛɛkɛ a wɛ̃niɛɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ wala ń yↄ̃̀ↄo vĩ tↄ́n gbɛ̃́laanikɛna,","poem":1},{"lineBreak":true},{"text":"ì yãkɛ ń zaza zↄ̃ↄoɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Màade pↄeã ì aà kpa gai","poem":1},{"lineBreak":true},{"text":"kɛ́ à ↄkpà a sì yã́i.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ìↄ ku pↄnidɛau gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa sↄ̃ ì gbada, ìli gio.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dii ye gbɛ̃vãi a gbagbaa gĩyãio,","poem":1},{"lineBreak":true},{"text":"atɛ̃sa tó àlɛ sapi o ń mↄafilio.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Seelade vãi a midɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì gbɛ̃́ yãma yã́ aↄ ku.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi wɛ́ ìↄ pãsĩɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuade ì wɛ́tɛ a yãkɛai.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄ ge wɛzɛ̃ ge lɛdama,","poem":1},{"lineBreak":true},{"text":"an kee a fↄ̃ pã Dii pↄeãlao.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wì sↄ̃́ sↄukɛ zĩkaa yã́iɛ,","poem":1},{"lineBreak":true},{"text":"ãma Dii mɛ́ zĩblea yã́ dↄ̃.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}