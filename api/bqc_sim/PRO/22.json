{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Tↄ́ na dɛ àizɛɛa,","poem":1},{"lineBreak":true},{"text":"na ń gbɛ̃́ↄ dɛ vua ń ã́nusuola.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔde ń taasideo zĩ́na doũɛ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ń kɛ́ píi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laaide ì dↄaa vãi e, ↄ̃ ì ulɛɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄsaide ì gi àↄ gɛ́, ↄ̃ ì wɛ́tɛ̃a e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩabusaa vĩakɛa Diiɛ guu gbɛ","poem":1},{"lineBreak":true},{"text":"mɛ́ àizɛɛ ń bɛɛɛo ń wɛ̃nio ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lɛ ń baio ku gbɛ̃́ dↄ̀ↄsai zɛ́u,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye aafiai ì kɛ̃́má.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ̀waasona da zɛ́ pↄ́ dɛ aà sɛwa,","poem":1},{"lineBreak":true},{"text":"tó à zↄ̃ↄkũ̀, a bↄuo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔde ì gbãamↄ taasideɛ,","poem":1},{"lineBreak":true},{"text":"pↄsɛ̃ana ì zↄble pↄdeɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ vãi tↄ̃̀ a yã'e a kɛkɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"aà pãsĩkɛgo a aà gbɛ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua a báaada gbɛ̃́ pↄ́ gbɛ̃kɛ vĩgu","poem":1},{"lineBreak":true},{"text":"kɛ́ ì blɛli taasideↄnɛ yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Láanide yá, sòle i midɛ,","poem":1},{"lineBreak":true},{"text":"yãkele ń wío i láa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛpuade pↄ́ a lɛgbɛ'i na,","poem":1},{"noteId":25},{"lineBreak":true},{"text":"ↄ̃mɛ aↄ dɛ kía gbɛ̃na ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii ìↄ wɛ́tɛ dↄ̃ai,","poem":1},{"lineBreak":true},{"text":"ì mↄafilide ɛɛkaɛ̀ a ↄzĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Màade ì mɛ nↄ̀ↄmusu ku bàasi,","poem":1},{"lineBreak":true},{"text":"a ma dɛ gãaɛɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Káalua lɛ́á ɛ̀ zòoloɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ Dii láaizĩ̀wà ì lɛ́lɛ dau.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Faasaiyã ìↄ dↄ nɛ́ↄ sↄ̃wa,","poem":1},{"lineBreak":true},{"text":"totoa ń flão a to aa kɛ̃wà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbãasaide wɛtãa ì aà kã́fĩ,","poem":1},{"lineBreak":true},{"text":"ↄde gbaa pↄ́ ì aà kɛ̃́sã.","poem":1}]},{"type":"heading","content":["Ɔ̃nↄnaↄ lɛdama"]},{"type":"verse","number":17,"content":[{"text":"Swã́kpa ǹ ↄ̃nↄnaↄ yã'onɛ ma,","poem":1},{"lineBreak":true},{"text":"ǹ n nↄ̀sɛ wɛ̃ ma yãdanɛɛ,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"asa a maa ǹyↄ̃ kũa n sↄ̃ guuɛ,","poem":1},{"lineBreak":true},{"text":"iↄ dↄ n lɛ́u.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa mpi, málɛ yãdanɛ gbã,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹyↄ̃ Dii náai vĩɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma yã'onɛ kɛ̃̀nɛ mɛ̀n baakwi,","poem":1},{"lineBreak":true},{"text":"yã́piↄ lɛdama ń dↄ̃ao vĩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Málɛ yã́ pↄ́ sĩana vĩ danɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹ e ǹ yã́zãsimá a zɛ́waɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ńsu gbãasaide ble aà gbãasaikɛ yã́io,","poem":1},{"lineBreak":true},{"text":"ńsu gbãamↄ wɛ̃nadeɛ yã́kpalɛkɛkĩio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asa Dii a yã́sińnↄɛ,","poem":1},{"lineBreak":true},{"text":"i gbɛ̃́ pↄ́ lɛ́ ń wɛtãↄ wɛtã.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ńsu gbɛ̃́kpa ń pↄkũmadeoo,","poem":1},{"lineBreak":true},{"text":"ńsu bɛbɛ ń pↄfɛ̃deoo,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"kɛ́ ńsu ǹ aà dàa sɛ́lɛ","poem":1},{"lineBreak":true},{"text":"ǹ nzĩa kpa yã́io yã́i.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ńsu gbɛ̃pãle fĩa di n miwao,","poem":1},{"lineBreak":true},{"text":"ńsu kpɛ́gaausíɛ̀o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tó ń pↄe vĩ ǹ fĩaboòo,","poem":1},{"lineBreak":true},{"text":"wa n wúlɛbↄ sɛ n zíɛɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ńsu kↄↄ baa vĩo,","poem":1},{"lineBreak":true},{"text":"n deziↄ mɛ́ dà za zi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ń gbɛ̃́ pↄ́ gↄ̃i vĩ a ↄzĩ guu dↄ̃a?","poem":1},{"lineBreak":true},{"text":"Ade a zĩkɛ kíaↄnɛɛ, ì kɛ táaaↄ a kɛnɛ́o.","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"22.11 Mat 5.8","reference":{"chapter":22,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}