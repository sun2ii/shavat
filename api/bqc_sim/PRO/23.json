{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Tó n mↄ pↄblei ń gbãadeo,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ dↄ̃ gbɛ̃́ pↄ́ kú n aɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó asiaden n ũ,","poem":1},{"lineBreak":true},{"text":"fɛ̃na da n kòlowa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ńsu to aà pↄ́ níside n wɛ́ bleo,","poem":1},{"lineBreak":true},{"text":"asa blɛpiá kokoazuanɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ńsu ĩada nzĩawa ↄ zↄ̃ↄ ea yã́io,","poem":1},{"lineBreak":true},{"text":"ǹ nzĩa ↄ̃nↄ tó.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wì wɛ́lɛ ↄ̃awaɛ ↄ̃ ì gɛ̃zɛa,","poem":1},{"lineBreak":true},{"text":"ì gã̀sĩa bↄ ì vua lán yãamusuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ńsu bĩide blɛ bleo,","poem":1},{"lineBreak":true},{"text":"ńsu to aà pↄ́ níside n wɛ́ bleo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"asa ìↄ a ↄ̃a nao a nↄ̀sɛuɛ.","poem":1},{"lineBreak":true},{"text":"Ì onɛ ǹ pↄble ǹ imi, ãma aà pↄ dↄmao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ a miↄna pↄ́ ń blè pisiɛ,","poem":1},{"lineBreak":true},{"text":"aà sáau pↄ́ ń kpà i kɛ pã.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ńsu yã'o sↄũ swã́uo,","poem":1},{"lineBreak":true},{"text":"asa a sakanɛ n ↄ̃nↄyãuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ńsu kↄↄ baa vĩo,","poem":1},{"lineBreak":true},{"text":"ńsu nɛtonɛↄ bú lɛ ǹ ka n pↄ́uo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa an Zɛnnↄde gbãa,","poem":1},{"lineBreak":true},{"text":"a bↄ n kpɛɛ, i yã́sińnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lɛdama da n sↄ̃u,","poem":1},{"lineBreak":true},{"text":"swã́sɛ dↄ̃ayãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ńsu gí n nɛ́ totoio.","poem":1},{"lineBreak":true},{"text":"Tó ń gbɛ̃̀ ń flão, a gao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ aà gbɛ̃ ń flão,","poem":1},{"lineBreak":true},{"text":"ǹ aà bↄ ga lɛ́zĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ma nɛ́, tó n nↄ̀sɛ paaa,","poem":1},{"lineBreak":true},{"text":"ma pↄna a kɛ zài.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó yã́zɛde lɛ́ bↄ n lɛ́u,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ a yáalↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ńsu duunkɛnaↄ gwea nidɛo,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ Dii vĩa vĩ gↄↄpii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asa ńyↄ̃ↄ zia vĩɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ tãmaa a n nɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ma nɛ́, ma yãma, ní ↄ̃nↄkũ,","poem":1},{"lineBreak":true},{"text":"to n laai àↄ ku yã́zɛdekɛawa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ńsu yãalɛ ń wɛ̃dɛnaↄo,","poem":1},{"lineBreak":true},{"text":"ńsu ǹyↄ̃ ku lɛ́'udeↄ guuo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Asa wɛ̃dɛna ń lɛ́'udeo ì gↄ̃ puaɛ,","poem":1},{"lineBreak":true},{"text":"an mɛkɛmuuna ì ń da zwã̀nkasa yeauɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ǹ n de'ia yãma,","poem":1},{"lineBreak":true},{"text":"tó n da zikũ̀, ńsu sakaaàguo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ sĩana yá, ńsu zɛɛ̀o,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄ ń yãdanɛo ń wɛzɛ̃o wɛɛlɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa mae pↄ ìↄ na maamaaɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna de'ia mikpɛ ìↄ tɛ́vuɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"To n de ń n dao pↄ àↄ nama,","poem":1},{"lineBreak":true},{"text":"to n da'ia yáalↄma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ma nɛ́, ǹ n nↄ̀sɛ wɛ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ ma yãkɛai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Asa káaluaá ɛ̀ zòoloɛ,","poem":1},{"lineBreak":true},{"text":"nↄɛ dↄ́ɛ'ĩideá tↄ̃ↄ kpaolonaɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́ kpákpa lán kpã́iwɛliwɛwa,","poem":1},{"lineBreak":true},{"text":"ì to gↄ̃ɛ daside gↄ̃ náaisaiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Dé wì waiyookɛɛ̀i?","poem":1},{"lineBreak":true},{"text":"Dé wì ó'o kɛɛ̀i?","poem":1},{"lineBreak":true},{"text":"Démɛ lɛkpaa vĩi?","poem":1},{"lineBreak":true},{"text":"Démɛ zↄa vĩi?","poem":1},{"lineBreak":true},{"text":"Démɛ ì kɛ'ĩa pãi?","poem":1},{"lineBreak":true},{"text":"Dé wɛ́ mɛ́ tɛ̃ai?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aaì sɛ̀ɛ dɛ wɛ̃ tùui,","poem":1},{"lineBreak":true},{"text":"aaì gɛ́ kpálɛkɛi vɛ̃ɛ yãalɛaiↄnɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ńsu wɛbii vɛ̃ɛwa a tɛ̃akɛ n wɛ́ bleo,","poem":1},{"lineBreak":true},{"text":"asa ìↄ pipi kɛɛona guuɛ, mɛ́ a gɛ̃a lɛ́u ìↄ na.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gbɛzã a swaa kĩma lán mlɛ̃waɛ,","poem":1},{"lineBreak":true},{"text":"i n gbã à n kũ lán píligonawa.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ wɛsi pↄ́ pↄ́ ni e yãaolɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ làasoo kpaanlakɛ n sↄ̃u.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ↄ dɛ lán gbɛ̃́ pↄ́ wúlɛa gó guu ísiaawa,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ kú gó zwã̀a misonaawa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ mɛ: Wà ma gbɛ̃, i ↄ̃ao,","poem":1},{"lineBreak":true},{"text":"wà ma kɛ búubuu, mi a wãwãmao.","poem":1},{"lineBreak":true},{"text":"Bↄɛ ma wɛ́ a wee mà í wɛɛlɛ mi lↄi?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}