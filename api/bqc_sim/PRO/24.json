{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Ńsu lua gbɛ̃vãiↄ gweaio,","poem":1},{"lineBreak":true},{"text":"ńsu yãalɛańnↄ nidɛ seo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yã́ gbãa làasoo mɛ́ ìↄ kú ń sↄ̃u,","poem":1},{"lineBreak":true},{"text":"yãkele mɛ́ ìↄ dↄ ń lɛ́u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɔ̃nↄ wì uakpaò,","poem":1},{"lineBreak":true},{"text":"wɛzɛ̃ ì to àↄ báaa vĩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dↄ̃a ↄ̃ wì pↄ́ kaò làasiↄ pai","poem":1},{"lineBreak":true},{"text":"ń àizɛɛ maa gawideo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɔ̃nↄna gbãa ìↄ kã́fĩɛ,","poem":1},{"lineBreak":true},{"text":"dↄ̃na iko ìↄ dɛdɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zĩgbasɛlɛa ì to wà fↄ̃ wà zĩka,","poem":1},{"lineBreak":true},{"text":"tó yãkɛkɛnaↄ dasi, ì to wà zĩble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɔ̃nↄ lɛsĩ dɛ faasaidea,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ kↄ̃kãaa guu aà lɛ́ ìↄ kpaaũaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gbɛ̃́ pↄ́ ìↄ vãikɛanɛ́ làasoo vĩ","poem":1},{"lineBreak":true},{"text":"ↄ̃ wì mɛ kↄ̃nide.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yãfaasai wàaipaaá duunaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e líↄ ye gbɛ̃́laanikɛna gĩyãio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tó n nzĩa bùsa taasiɛ,","poem":1},{"lineBreak":true},{"text":"n yɛ̃̀ɛɛ mɛ́ bílao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃́ pↄ́ aa mipɛ̀ gawaↄ suaba,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa sòo lɛ́ si kaalɛ guuↄ misi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó n mɛ̀: Ó'o, wá dↄ̃ yãao fá,","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ nↄ̀sɛ guu yã́ dↄ̃ a eo lé?","poem":1},{"lineBreak":true},{"text":"N wɛ̃ni Dↄ̃̀ana a yã́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"a fĩabo baadeɛ a yãkɛawaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma nɛ́, zↄ́ ble, asa a naɛ,","poem":1},{"lineBreak":true},{"text":"zↄsapuna ì kɛ lɛ́ɛ na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Màa ↄ̃nↄ ì kɛ gbɛ̃́ɛ na a nↄ̀sɛu.","poem":1},{"lineBreak":true},{"text":"Tó n ↄ̃nↄkũ̀, ńyↄ̃ↄ zia vĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ tãmaa a n nɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dàade, ńsu gbɛ̃maa ua kpákpao,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ aà pↄ́ↄ waawà a bɛo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃maa lɛ̀lɛ gɛ̃n sopla, ì ɛa fɛlɛɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ sↄ̃, músi ì to aa fu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tó n ibɛɛ lɛ̀lɛ, ńsu pↄnakɛo,","poem":1},{"lineBreak":true},{"text":"tó à fù, ńsu tidↄaàlao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó Dii è màa, a kɛɛ̀ nao,","poem":1},{"lineBreak":true},{"text":"aà pↄkũma a wee n ibɛɛpiwaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ńsu to gbɛ̃vãiↄ yã́ n kũ gbãao,","poem":1},{"lineBreak":true},{"text":"ńsu lua vãikɛnaↄ gweaio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃vãi líↄ zia vĩo,","poem":1},{"lineBreak":true},{"text":"Lua a vãikɛnaↄ tɛdɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma nɛ́, vĩakɛ Diiɛ ń kíao,","poem":1},{"noteId":26},{"lineBreak":true},{"text":"ńsu gbɛ̃́kpa ń gbɛ̃́ pↄ́ bↄ̀ ń kpɛↄo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa yã́ a ń le kã́ndoɛ.","poem":1},{"lineBreak":true},{"text":"Démɛ dↄ̃ lá wa ń ásookɛi?","poem":1}]},{"type":"heading","content":["Ɔ̃nↄnaↄ yã́n kɛ lↄ"]},{"type":"verse","number":23,"content":[{"text":"Ɔ̃nↄnaↄ yã́n kɛ lↄ:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃bↄbↄa'ↄsi yã́kpalɛ guu maao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãnakpa tàaedewa,","poem":1},{"lineBreak":true},{"text":"wa savãi'oɛ̀, buiↄ i ↄlɛlɛɛ̀.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yã́'ĩikpawà aↄ maa e,","poem":1},{"lineBreak":true},{"text":"Lua a báaadaaàgu maamaaɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì yãwe gbɛ̃́wa wásawasa","poem":1},{"lineBreak":true},{"text":"lɛ́ lɛ́pɛwàɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ɔlia n buai a zĩↄ láa,","poem":1},{"lineBreak":true},{"text":"ní gbasa kpɛdↄ sa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ńsu bↄbↄ ń n gbɛ̃́deeo pão,","poem":1},{"lineBreak":true},{"text":"ńsu to n lɛ́ gbɛ̃́ↄ sã́são.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ńsu mɛ: Má kɛɛ̀ lá a kɛ̀mɛɛwaɛo,","poem":1},{"lineBreak":true},{"text":"ge má fĩaboɛ̀ a yãkɛawaɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ma pã màade bua,","poem":1},{"lineBreak":true},{"text":"ma dↄ ↄ̃nↄkɛ̃sãmade vɛ̃ɛbui,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ↄ̃ má è lɛ bↄ̀lɛ dàgua píi,","poem":1},{"lineBreak":true},{"text":"à sɛ̃kù, gĩ pↄ́ a bò ń gbɛo kwɛ̀.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ma yã́pi gwà, ma làasookɛ̀wà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ yã́ pↄ́ má èpi yãdàdamɛɛ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tó n mɛ̀: Má i'o yↄↄ, má kã́mabo yↄↄ,","poem":1},{"lineBreak":true},{"text":"má wúlɛ yↄↄ ↄkpaa ma kùɛ,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"pↄtaasi a n zãmakɛ lán kpã́iwa,","poem":1},{"lineBreak":true},{"text":"pↄ́ nↄana i mↄma lán gↄ̃kɛbↄdewa.","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"24.21 1Piɛ 2.17","reference":{"chapter":24,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}