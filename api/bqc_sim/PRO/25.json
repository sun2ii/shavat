{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":25,"content":[{"type":"heading","content":["Salomↄↄ yáasi pãleↄ"]},{"type":"verse","number":1,"content":["Salomↄↄ yáasi pↄ́ Yudaↄ kí Ezekia gbɛ̃́ↄ è aa kɛ̃̀ↄn kɛ:"]},{"type":"verse","number":2,"content":[{"text":"Lua gawi vĩ kɛ́ à yã́ ulɛ,","poem":1},{"lineBreak":true},{"text":"kíaↄ gawi vĩ kɛ́ aa yã́ tàasika.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Luabɛ lɛsĩ lɛ́ ń tↄↄlɛ gèele lɛ́o","poem":1},{"lineBreak":true},{"text":"ń kía làasooo tàasikaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ãnusu gbãsĩ bↄlɛ,","poem":1},{"lineBreak":true},{"text":"ã́nusuzĩkɛna i pↄmaa piò.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ bↄlɛ kía ìwaↄ guu,","poem":1},{"lineBreak":true},{"text":"aà kpala i zɛdↄ yã́zɛde musu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ńsu ǹ nzĩa dilɛ gbia kía aɛo,","poem":1},{"lineBreak":true},{"text":"ńsu zɛ gbɛ̃zↄ̃ↄ gbɛuo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa aà oanɛ, mↄ aɛ la, maa dɛ","poem":1},{"lineBreak":true},{"text":"aà n dilɛ kɛ̃́sãa gbɛ̃́ gbiaↄ aɛa.","poem":1},{"noteId":27}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ n wɛ́ è ńsu ǹyↄ̃ wã ń a gↄ̃́gↄ̃aoo.","poem":1},{"lineBreak":true},{"text":"Tó wà yɛlɛdìnɛ, bↄ́ ńyↄ̃ kɛ gbɛzãi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ńlɛ yã́gↄ̃gↄ̃ ń n gbɛ̃́deeo,","poem":1},{"lineBreak":true},{"text":"ńsu bↄ ń gbɛ̃pãle asiioo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó à su mà, a widamaɛ,","poem":1},{"lineBreak":true},{"text":"n tↄ́ ĩ́i a láa lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yã́na'oa a gↄↄwa kɛfɛũ","poem":1},{"lineBreak":true},{"text":"lán mao tɛ̃a pↄ́ da ã́nusu tauwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄna lɛdama maa gbɛ̃́ pↄ́ nↄ̀sɛ vĩɛ","poem":1},{"lineBreak":true},{"text":"lán vua nↄamblebↄwaɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lá í niɛ ìↄ dɛ pↄkɛkɛnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"màa zĩna náaide dɛ gbɛ̃́ pↄ́ aa aà zĩↄnɛ,","poem":1},{"lineBreak":true},{"text":"ì ń nↄ̀sɛ níninɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì gbadaa lɛgbɛ̃ mɛ́ ìli dao","poem":1},{"lineBreak":true},{"text":"dɛ lán lou pↄ́ sìsi à ĩ́ana kàka i maowaɛ.","poem":1},{"noteId":28}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛnakɛa ì to kía ń yã́zɛ e,","poem":1},{"lineBreak":true},{"text":"kpálɛa yã́i ì tó ń yã́ ble.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó n zↄ́ è, ble n lɛ́ lɛ́u,","poem":1},{"lineBreak":true},{"text":"kɛ́ ńsu ble zↄ̃ↄ ǹ pisio yã́i.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n gbɛ̃́dee bɛ zɛ́ sↄo,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu kpasannↄ à zanguo yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ yãdↄa a gbɛ̃́deewa","poem":1},{"lineBreak":true},{"text":"dɛ lá à aà kɛ̀'ĩa ń goo ge fɛ̃nda ge ń kaowaɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sↄ̃kpalɛa náaisaidezi taasikɛgↄↄ","poem":1},{"lineBreak":true},{"text":"dɛ lán swaa gyãe ge gbá kↄ̃̀ↄwaɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Pↄna lɛsia pↄsiadeɛ","poem":1},{"lineBreak":true},{"text":"dɛ lán ulawoloama ĩ́ampuu","poem":1},{"lineBreak":true},{"text":"ge yↄ̃una kaa bↄwawaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tó nↄa lɛ́ n ibɛɛ dɛ, blɛ kpawà,","poem":1},{"lineBreak":true},{"text":"tó imiɛ sↄ̃, ǹ aà gba í,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"asa ńlɛ aà ↄ kaɛ̀ a lɛ́un we,","poem":1},{"noteId":29},{"lineBreak":true},{"text":"mɛ́ Dii a fĩabonɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lá gukpɛ ĩ́ana ì mↄ́ ń louo,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃pea ì mↄ́ ń oa fɛ̃́nkpaao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ia gↄ̃u zãu maa","poem":1},{"lineBreak":true},{"text":"dɛ kua kpɛ́u sãnu ń nↄ sòledeola.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Baona bↄa bùsu zã̀zãu","poem":1},{"lineBreak":true},{"text":"dɛ lán í niɛ kpaa gbɛ̃́ pↄ́ a yɛ̃̀ɛɛ làawawaɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa pↄ́ misìilɛ vãikɛnaɛ","poem":1},{"lineBreak":true},{"text":"dɛ lán nibↄna pↄ́ a í yàwaɛ,","poem":1},{"lineBreak":true},{"text":"lán lↄ̀ↄ pↄ́ a í ↄ̃̀ↄkpàwa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Zↄblea gɛ̃agɛ̃a maao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ azĩa kpɛlaa gbiao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ azĩa kũa dↄ̃o","poem":1},{"lineBreak":true},{"text":"dɛ lán wɛ̃́lɛ pↄ́ a bĩ́i gbooawaɛ.","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"25.7 Luk 14.8-10","reference":{"chapter":25,"verse":7}},{"noteId":28,"caller":"+","text":"25.14 Yud 12","reference":{"chapter":25,"verse":14}},{"noteId":29,"caller":"+","text":"25.22 Lom 12.20","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}