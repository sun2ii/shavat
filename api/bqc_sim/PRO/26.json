{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Lá lougbɛkwɛa saɛ","poem":1},{"lineBreak":true},{"text":"ge loumaa pↄkɛkɛgↄↄ lí zɛkɛo,","poem":1},{"lineBreak":true},{"text":"màa gawi lí kↄ̃si ń sↄũoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lá gòlegolena ń luakitɛlɛnao","poem":1},{"lineBreak":true},{"text":"ìↄ vuavua, ìↄ gɛ́ la, ìↄ ta le,","poem":1},{"lineBreak":true},{"text":"màa ↄlɛlɛa gbɛ̃́ɛ pã a pↄe zↄ̃wào.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Flãá sↄ̃́ pↄ́ɛ, kpíá zàa'ĩna pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"sↄũ pↄ́ mɛ́ go ũ a kpɛsɛa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ńsu yã́zãsi sↄũwa a faasaikɛwao,","poem":1},{"lineBreak":true},{"text":"kɛ́ ńsu gↄ̃aàwao yã́i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yã́zãsi sↄũwa a faasaikɛwa,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu azĩa gwa ↄ̃nↄna ũo yã́i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó n lɛdì sↄũɛ,","poem":1},{"lineBreak":true},{"text":"n nzĩa ↄ̃̀ↄkpàɛ, n yã'ì nzĩaɛɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yáasi pↄ́ dↄ sↄũ lɛ́u","poem":1},{"lineBreak":true},{"text":"dɛ lán ɛɛ gbá pↄ́ lɛ́ gbãɛwaɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sↄũ kpɛlaa","poem":1},{"lineBreak":true},{"text":"dɛ lán gbɛdaa gbɛmauwaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yáasi pↄ́ dↄ sↄũ lɛ́u","poem":1},{"lineBreak":true},{"text":"dɛ lán lɛ naa wɛ̃dɛna ↄzĩwaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sↄũ ge gbɛ̃pãpã daazĩu","poem":1},{"lineBreak":true},{"text":"dɛ lán toekana pↄ́pii gbã́awaɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sↄũ ɛaa a yãfaasaikɛawa lↄ","poem":1},{"lineBreak":true},{"text":"dɛ lán gbɛ̃ pↄ́ ɛ̀a a pisi blèwaɛ.","poem":1},{"noteId":30}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ azĩa dìlɛ ↄ̃nↄna ũ èa?","poem":1},{"lineBreak":true},{"text":"Sↄũ sã̀ↄwà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Màade ì mɛ: Nↄ̀ↄmusu ku zɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"wài pãsĩ bɛ zɛau.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lá gba ìↄ lili a lilibↄu,","poem":1},{"lineBreak":true},{"text":"màa màade ìↄ lilɛlilɛ a wúlɛkĩi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Màade ì ↄsi tau,","poem":1},{"lineBreak":true},{"text":"aà blɛli gɛò a lɛ́ kĩ́i ì kɛwà ĩa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Màade ìↄ e a ↄ̃nↄ","poem":1},{"lineBreak":true},{"text":"dɛ yãwendↄ̃na gbɛ̃ↄn soplaↄla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Vĩ pɛ́lɛa dãↄ lɛkpaau","poem":1},{"lineBreak":true},{"text":"dɛ bàasi gbɛ̃ kũa a vlã́wa ũɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a gbɛ̃́dee sã̀sã ↄ̃ à gbàsa oɛ̀: Málɛ faaiboɛ","poem":1},{"lineBreak":true},{"text":"dɛ lán wɛkɛyiode pↄ́ lɛ́ kà tɛde ń kagbao fã́ńguwaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tó yàa kuo, tɛ́ ì gaɛ,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃pena kuo, sòle ì láaɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lá sĩsĩ ì kɛ tɛyↄ̃ɛ, lá yàa ì kɛ tɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"màa lɛkpaade ì sòle da.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃pena yã́ ì kɛnɛ́ lán zↄ́wa,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃ lɛ́u dↄ̃̀ↄ e nↄ̀sɛkpɛau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nↄ̀sɛpãsĩde pↄ́ ì yã́ nana onɛ́","poem":1},{"lineBreak":true},{"text":"dɛ lán lo pↄ́ wà ã́nusu'i lɛ̀wàwaɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ìↄ zańgu ì azĩa kɛkɛ ń lɛ́oɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́sãsãa làasoo mɛ́ kú aà sↄ̃u.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó yã́ nana bↄ̀ aà lɛ́u, ńsu sio,","poem":1},{"lineBreak":true},{"text":"asa yãvãi mɛ̀n sopla mɛ́ kú aà sↄ̃u.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tó à a zaa gbɛ̃́ↄu ùlɛ mↄafili guu,","poem":1},{"lineBreak":true},{"text":"aà vãi ì bↄ gupuau bíla wáa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Gbɛ̃́ pↄ́ ɛyↄ̃̀nɛ́ a zu a guuɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ gbɛ gbeembò, gbɛpi a si adewa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ɛɛde za gbɛ̃́ pↄ́ ì ń ↄ̃̀ↄkpaↄgu,","poem":1},{"lineBreak":true},{"text":"kↄ̃nide ì gbɛ̃́ kpá lɛ́lɛai.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"26.11 2Piɛ 2.22","reference":{"chapter":26,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}