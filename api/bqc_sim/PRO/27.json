{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Ńsu ĩ́anadã zia yã́ musuo,","poem":1},{"lineBreak":true},{"text":"asa ń dↄ̃ yã́ pↄ́ zia a io.","poem":1},{"noteId":31}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"To wà n sáaukpa, ńsu ǹ nzĩa sáaukpao.","poem":1},{"lineBreak":true},{"text":"To à bↄ gbɛ̃pãleↄ lɛ́u, asu bↄ n lɛ́uo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ gbia, ũfãaá asoɛ,","poem":1},{"lineBreak":true},{"text":"kási sↄũ ĩadama ì tↄ̃́má dɛ beea.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pↄkũma pãsĩ, pↄfɛ̃ ì dańla,","poem":1},{"lineBreak":true},{"text":"démɛ a nↄ̀sɛgↄ̃a fↄ̃ sↄ̃i?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ gbaa laai bíla wáa maa","poem":1},{"lineBreak":true},{"text":"dɛ yea gbɛ̃́zi yãe oaɛ̀ saia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃na yã'ↄ̃ma kpaańzi náai vĩ,","poem":1},{"lineBreak":true},{"text":"ibɛɛ lɛ́pɛama mↄafili vĩ.","poem":1},{"noteId":32}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kãa ì zazakũ zↄ́waɛ,","poem":1},{"lineBreak":true},{"text":"ãma nↄandɛna pↄ́ kĩ̀sã dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gbɛ̃́ pↄ́ kɛ̃̀ a uawa àlɛ bɛbɛbɛbɛ","poem":1},{"lineBreak":true},{"text":"dɛ lán bã pↄ́ sã̀sã a sakpɛwawaɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nísi gĩnana ń tulaletio ì ń pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"lɛdaakↄ̃wa ń nↄ̀sɛmɛndoo ì gbɛ̃naↄ kɛ na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n gbɛ̃na vũaao ge n mae gbɛ̃na.","poem":1},{"lineBreak":true},{"text":"Tó yã́ n le, ńsu gɛ́ n vĩ̀i ge n dãuna bɛo.","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́dee pↄ́ kú kãi maa dɛ n bɛ gbɛ̃́ pↄ́ kú zã̀a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma nɛ́, ǹyↄ̃ ↄ̃nↄ, ma pↄ i kɛma na,","poem":1},{"lineBreak":true},{"text":"mí e yã́zãsi ma sↄ̃̀sↄ̃naↄwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Laaide ì dↄaa vãi e ↄ̃ ì ulɛɛ̀,","poem":1},{"lineBreak":true},{"text":"làasoosaide ì gi àↄ gɛ́ ↄ̃ ì yã'e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ nibↄ fĩa dì a miwa, ǹ aà ula sí,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ kũa tↄ̀ↄma ũ gbɛ̃́pi gɛ̃ɛ ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó n lɛdà ía n samaa'ò n gbɛ̃́deeɛ kↄↄkↄↄ,","poem":1},{"lineBreak":true},{"text":"wa dilɛ savãi ũɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nↄ sòlede muaa","poem":1},{"lineBreak":true},{"text":"ń í pↄ́ lɛ́ tↄ̃tↄ̃ zɛsai lou zã́oɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aà zùukɛaá ĩ́ana zùukɛaɛ,","poem":1},{"lineBreak":true},{"text":"ade lɛ́ í ↄkũkpaɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lá mↄↄ ì kↄ̃ lɛkɛ,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃nazĩna ì a gbɛ̃́dee kɛkɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó n laaidↄ̀ lí nɛ'inawa, ńyↄ̃ a nɛ́ ble,","poem":1},{"lineBreak":true},{"text":"tó n ↄlìa n diizi, a n kpɛla.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lá gbɛ̃́ ì a oa e í guu,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃́ ì a nↄ̀sɛ dↄ̃ a yãkɛawa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lá gɛↄ lí mↄ́ bɛda ń tɛ́owao,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃́ wɛ́ yea pↄ́i lí mↄ́wào.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wì ã́nusu ń vuao maa dↄ̃ a baasaa guuɛ,","poem":1},{"lineBreak":true},{"text":"màa wì gbɛ̃́ bɛɛɛ dↄ̃ aà tↄbↄa guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Baa tó n faasaide kà góu","poem":1},{"lineBreak":true},{"text":"ńlɛ aà sabo ń pↄ́wɛnao sãnu,","poem":1},{"lineBreak":true},{"text":"aà faasaikɛ a kɛ̃wào.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nìliↄ n pↄtuoↄ kua dↄ̃ maamaa,","poem":1},{"lineBreak":true},{"text":"laaidↄ n kpàsa pↄ́ↄwa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Asa àizɛɛ líↄ ku gↄↄpiio,","poem":1},{"lineBreak":true},{"text":"mɛ́ gawi líↄ gɛ́ wɛ̃ ń wɛ̃oo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sɛ̃ ì láa, a dafu ì bↄlɛ,","poem":1},{"lineBreak":true},{"text":"ni a tàaa kpá pↄ́ↄnɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ni pↄkasa kɛ ń n sãↄ kã́o,","poem":1},{"lineBreak":true},{"text":"ni bú lú ń n blè ↄ̃ao,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ń bleↄ vĩ iↄ dinzi n pↄblea ũ,","poem":1},{"lineBreak":true},{"text":"ni n uadeↄ ń n nↄɛ zĩkɛnaↄ gwaò.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"27.1 Zaa 4.13-16","reference":{"chapter":27,"verse":1}},{"noteId":32,"caller":"+","text":"27.6 Luk 22.47-48","reference":{"chapter":27,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}