{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Gbɛ̃́ pↄ́ wa gbà laai maamaa mɛ́ aà swã́ gì gbãa,","poem":1},{"lineBreak":true},{"text":"kaaũ a gɛ̃aàzi kã́ndoɛ, a fɛlɛ lↄo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maaↄ lìgua, gbɛ̃́ↄ pↄ ìↄ naɛ,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃vãi ku kpalau, wì aaukɛɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye ↄ̃nↄi ì a mae pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"káaluaↄ bɛ zɛsɛna ì a ↄ̃a dɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kía ì a bùsu zɛdↄ yã́zɛde musu,","poem":1},{"lineBreak":true},{"text":"a gbagusaɛsina sↄ̃ ì a bùsu dɛɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ lɛna kɛ a gbɛ̃́deeɛ","poem":1},{"lineBreak":true},{"text":"lɛ́ ba kpa azĩaɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi tàaekɛa ì aà kũ bai ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa gula ìↄ dↄ ń pↄnao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ì laaidↄ yɛ̃̀ɛɛsaideɛ a yã́gↄ̃gↄ̃awa,","poem":1},{"lineBreak":true},{"text":"vãikɛna sↄ̃ ìli aà kã̀akɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́laanikɛnaↄ ì wɛ̃́lɛ wã,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄnaↄ ì gbɛ̃́ↄ nↄ̀sɛ níninɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ↄ̃nↄna gɛ̀ yã́kpalɛkɛi ń sↄũo,","poem":1},{"lineBreak":true},{"text":"sↄũpi pↄ pà yã̀, àlɛ yáalↄ yã̀,","poem":1},{"lineBreak":true},{"text":"aà lɛ́ lí kpaaũo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛnaↄ ìↄ za tàaesaideguɛ,","poem":1},{"lineBreak":true},{"text":"aaìↄ gbɛ̃maaↄ wɛɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sↄũ pↄkũma ì pisi aà wɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄna sↄ̃ ì a nↄ̀sɛ suumpaɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó gbãade lɛ́ swã́sɛ ɛɛyãi,","poem":1},{"lineBreak":true},{"text":"aà ìwaↄ ì gↄ̃ vãikɛnaↄ ũ píiɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Taaside ń ĩadamadeo an yã́ɛ bee doũɛ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ tò an wɛ́ lɛ́ gu'e ḿpii.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kía pↄ́ ì yã́kpalɛkɛ taasideↄnɛ ń sĩanao,","poem":1},{"lineBreak":true},{"text":"aà kpala zĩ́napɛlɛa ìↄ gbãa gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Totoa ń flão ì to gbɛ̃́ ↄ̃nↄkũ,","poem":1},{"lineBreak":true},{"text":"nɛ́ pↄ́ wa tò azĩaɛ ì wida a dawaɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó vãikɛnaↄ lìgua, tàaekɛa ì kↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"ãma gbɛ̃maaↄ aa ń lɛ́lɛa e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ n nɛ́ toto, i n nↄ̀sɛ danɛ doũ,","poem":1},{"lineBreak":true},{"text":"a to n nↄ̀sɛ àↄ yáalↄwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gu pↄ́ Lua yã́ kúuo wìliↄ ńzĩa kũa dↄ̃o.","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ aà ikoyã kũa ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wìli zↄ toto ń lɛ́oo.","poem":1},{"lineBreak":true},{"text":"Baa tó a mà, a zĩkɛwào.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ ì wã àↄ yã'o èa?","poem":1},{"lineBreak":true},{"text":"Sↄũ sã̀ↄwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zↄ pↄ́ wa zàza za a ɛ̀waasogↄↄ,","poem":1},{"lineBreak":true},{"text":"a gↄ̃ gulu ũ gbɛzãɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pↄkũmade ì sòle da,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛyãfũnde ì duunakɛ maamaaɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ĩandãa ì ń busaɛ,","poem":1},{"lineBreak":true},{"text":"zĩabusaa mɛ́ ì ń kã́fĩ.","poem":1},{"noteId":35}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ ble ń kpã́io za azĩauɛ,","poem":1},{"lineBreak":true},{"text":"ì mɛ á sì ń Luao, ↄ̃ ìli we òo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Vĩakɛa gbɛ̃nazĩnaɛá baiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ Dii náaikɛ mi aↄ daa ía.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ daside ìↄ ye gbãade zɛńnↄɛ,","poem":1},{"lineBreak":true},{"text":"ãma yã́kpalɛkɛa ń gbɛ̃́ↄá Dii yã́ɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa ye gbɛ̃́ dↄ̀ↄsai gĩyãio,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi sↄ̃ ìliↄ ye nↄ̀sɛpuade yãkɛaio.","poem":1}]}],"footnotes":[{"noteId":35,"caller":"+","text":"29.23 Mat 23.12","reference":{"chapter":29,"verse":23}}]},"thisChapterLink":"/api/bqc_sim/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}