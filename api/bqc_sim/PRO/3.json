{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["Dii náaikɛa ì ↄ̃nↄ inɛ́"]},{"type":"verse","number":1,"content":[{"text":"Ma nɛ́, ńsu to ma yãdanɛ sãnguo,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ yã́ pↄ́ má dìlɛnɛↄ kũa n sↄ̃u.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asa a n ka wɛ̃ni gbã̀awa,","poem":1},{"lineBreak":true},{"text":"a aafia kã́fĩnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ ń náaio su kɛ̃mao,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ daa yàbaa ũ,","poem":1},{"lineBreak":true},{"text":"kɛ̃ n sↄ̃wa lá wì kɛ̃ lákɛ̃kĩiwawa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n tↄ́ iↄ na,","poem":1},{"lineBreak":true},{"text":"níↄ maa Luaɛ ń gbɛ̃nazĩnaↄ.","poem":1},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii náaikɛ ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"ńsu gbãa'e nzĩa ↄ̃nↄwao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ aà dↄ̃ n yã́ píi kɛa guu,","poem":1},{"lineBreak":true},{"text":"i zɛpoonɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ńsu ǹ nzĩa gwa ↄ̃nↄna ũo,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ Dii vĩa vĩ, ní kɛ̃́ vãiwa.","poem":1},{"noteId":4}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bee aↄ dɛ n mɛ aafia ɛsɛ ũ,","poem":1},{"lineBreak":true},{"text":"a n wá gba gbãa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii kpɛla ń n àizɛɛo","poem":1},{"lineBreak":true},{"text":"ń n buapↄ́ káauↄ píi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"pↄ́wɛnaↄ i bi bↄ n dↄ̃u,","poem":1},{"lineBreak":true},{"text":"n selaↄ i pa yɛlɛlɛ ń vɛ̃ɛ dafuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma nɛ́, tó Dii n toto, ńsu dilɛ pão,","poem":1},{"lineBreak":true},{"text":"tó à n gba laai, ńsu to à kɛnɛ ĩ́io.","poem":1},{"noteId":5}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃́ pↄ́ Dii yei ↄ̃ ì dazɛwa,","poem":1},{"lineBreak":true},{"text":"lá mae ì kɛ a nɛ́ pↄ́ kɛ̀ɛ maaɛwawa.","poem":1},{"noteId":6}]},{"type":"heading","content":["Ɔ̃nↄ ài"]},{"type":"verse","number":13,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ ↄ̃nↄ le kũ̀","poem":1},{"lineBreak":true},{"text":"mɛ́ dↄ̃a pàɛ̀ ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asa a ài vĩ dɛ ã́nusua,","poem":1},{"lineBreak":true},{"text":"ì kã́fĩakɛnɛ́ dɛ vuaa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A bɛɛɛ vĩ dɛ òsoa,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ a ni kumaↄ kee i kawào.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wɛ̃ni gbã̀a ku aà ↄplaau,","poem":1},{"lineBreak":true},{"text":"àizɛɛ ń gawio ku aà ↄzɛɛu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aà yã́ↄ kɛkɛá na,","poem":1},{"lineBreak":true},{"text":"aà zɛ́ píi aafia vĩ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A dɛ lí wɛ̃nide ũ gbɛ̃́ pↄ́ kũaↄnɛ,","poem":1},{"lineBreak":true},{"text":"báaadeↄn gbɛ̃́ pↄ́ sìↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dii gↄ̃ikɛ guu à tↄↄlɛ kàlɛ,","poem":1},{"lineBreak":true},{"text":"aà ↄ̃nↄ guu à musu kɛ̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ísia ɛ bↄ̀ a dↄ̃a guu,","poem":1},{"lineBreak":true},{"text":"a tò luabɛpuana mↄ̀sɛ vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ma nɛ́, ǹyↄ̃ wɛzɛ̃ ń ↄ̃nↄo vĩ,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ wɛvĩao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aↄ dɛ n nisĩna wɛ̃ni ũ,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ yàbaa ũ n nↄɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ↄ bɛ n laaiwa,","poem":1},{"lineBreak":true},{"text":"pↄe a kpàlikpanɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó n wulɛ, vĩa a n kũo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ wúlɛ i'o na.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ kai vĩakɛo,","poem":1},{"lineBreak":true},{"text":"ge músi pↄ́ ì vãikɛnaↄ le kã́ndo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Asa Dii aↄ dɛ n mikpakĩi ũ,","poem":1},{"lineBreak":true},{"text":"a n gbá vĩ kaia.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tó n ↄ lɛ́ n kpɛ le,","poem":1},{"lineBreak":true},{"text":"ńsu gí maakɛi gbɛ̃́ pↄ́ kũ̀ ǹ kɛɛ̀ɛo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tó n dↄnlɛ zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"ńsu o n gbɛ̃́deeɛ aà gɛ́ e ziao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"N gbɛ̃́dee pↄ́ kú n saɛ dↄdↄa,","poem":1},{"lineBreak":true},{"text":"ńsu lɛkpaaĩaàzi ń gbɛ̃eoo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ i yãe kɛnɛo,","poem":1},{"lineBreak":true},{"text":"ńsu lɛkpaakɛaànↄ pão.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ńsu gbãamↄnɛdeↄ kua nidɛo,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ ń kɛae kɛo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Asa Dii ye kↄ̃nideↄ gĩyãio,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuadeↄ ↄ̃ ì kɛ a kpàasiaↄ ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dii ì láaizĩ gbɛ̃vãiↄ uawa,","poem":1},{"lineBreak":true},{"text":"ì báaada gbɛ̃maaↄ bɛu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́laanikɛnaↄ láanikɛ,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃kɛ vĩ ń zĩabusanaↄ.","poem":1},{"noteId":7}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄde a bɛɛɛ e,","poem":1},{"lineBreak":true},{"text":"sↄũ sↄ̃ ì wida azĩawa.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"3.4 Luk 2.52","reference":{"chapter":3,"verse":4}},{"noteId":4,"caller":"+","text":"3.7 Lom 12.16","reference":{"chapter":3,"verse":7}},{"noteId":5,"caller":"+","text":"3.11 Yob 5.17","reference":{"chapter":3,"verse":11}},{"noteId":6,"caller":"+","text":"3.12 Ɛbɛ 12.5-6, Zia 3.19","reference":{"chapter":3,"verse":12}},{"noteId":7,"caller":"+","text":"3.34 Zaa 4.6, 1Piɛ 5.5","reference":{"chapter":3,"verse":34}}]},"thisChapterLink":"/api/bqc_sim/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}