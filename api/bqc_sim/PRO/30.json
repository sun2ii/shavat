{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":30,"content":[{"type":"heading","content":["Aguu yã'oa"]},{"type":"verse","number":1,"content":["Yakɛ nɛ́ Aguu yã'oa.",{"text":"Ma kpasa Lua, ma kpasa dúuduu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"asa ma sↄũkɛ dɛ dãↄla,","poem":1},{"lineBreak":true},{"text":"má gbɛ̃nazĩna wɛzɛ̃ vĩo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi ↄ̃nↄ dadao,","poem":1},{"lineBreak":true},{"text":"mɛ́ má Lua dↄ̃a vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Démɛ gɛ̀ luabɛ yãa à sùi?","poem":1},{"lineBreak":true},{"text":"Démɛ ĩ́ana kã̀aa kũ̀ a ↄzĩi?","poem":1},{"lineBreak":true},{"text":"Démɛ lou yè a pↄkasaui?","poem":1},{"lineBreak":true},{"text":"Démɛ tↄↄlɛ lɛ́ dài?","poem":1},{"lineBreak":true},{"text":"Aà tↄ́n lai? Aà nɛ́ tↄ́n lai?","poem":1},{"lineBreak":true},{"text":"Tó ń dↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lua yã́ↄ pípia píiɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ dɛ sɛ̀ngbao ũ gbɛ̃́ pↄ́ nàaàziɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ńsu yãe kã́fĩ aà yã́ guuo,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu ń ɛɛkanɛ ń ↄzĩo yã́i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yã́ mɛ̀n pla málɛ gbɛama Dii,","poem":1},{"lineBreak":true},{"text":"ńsu giomɛɛ e màↄ gao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma kɛ̃ yãpã oa ń ɛɛtoaowa.","poem":1},{"lineBreak":true},{"text":"Nìli ma gba blɛ ma lɛ́ lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ńsu ma da taasi ge ↄdekɛuo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kɛ́ pↄ́ su àↄ dimazi","poem":1},{"lineBreak":true},{"text":"mà lelekpanzi mà mɛ,","poem":1},{"lineBreak":true},{"text":"démɛ Lua ũio,","poem":1},{"lineBreak":true},{"text":"mɛ́ kɛ́ taasi su ma kũ mà kpã́i'o","poem":1},{"lineBreak":true},{"text":"mà n tↄ́ ↄ̃̀ↄkpao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ńsu yãdↄ zↄwa a dii kĩ́io,","poem":1},{"lineBreak":true},{"text":"kɛ́ asu n ka, à wi n musuo yã́i.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ku, aaì ń mae kaɛ,","poem":1},{"lineBreak":true},{"text":"aali samaa'o ń daɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ku aaliↄ e wa gbãsĩo,","poem":1},{"lineBreak":true},{"text":"kási an ã́makɛ i kɛ̃́máo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ku an wɛ́pɛkĩi zã̀,","poem":1},{"lineBreak":true},{"text":"aaì ń mi ga da ía.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ku an swaaá fɛ̃ndaɛ,","poem":1},{"lineBreak":true},{"text":"an kãnkãnaá fɛ̃naɛ,","poem":1},{"lineBreak":true},{"text":"aaì dṹnia taasideↄ ń gbɛ̃nazĩn wɛ̃nadeↄ taitaiò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Too nɛnↄɛnaↄ vĩ mɛ̀n pla,","poem":1},{"lineBreak":true},{"text":"aaì mɛ: Wá gba, wá gba.","poem":1},{"lineBreak":true},{"text":"Pↄ́ mɛ̀n àaↄ̃ ku aali kã́o,","poem":1},{"lineBreak":true},{"text":"à kà síiↄ̃ se, aali mɛ pↄ́ mↄ̀máo:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɛda ń nɛasakpɛ giio","poem":1},{"lineBreak":true},{"text":"ń tↄↄlɛo asa í lí mↄ́wào","poem":1},{"lineBreak":true},{"text":"ń tɛ́o asa ìli mɛ a kã ziio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wɛ́ pↄ́ nɛ́ ì a mae láanikɛò mɛ́ ì sakaò a dau,","poem":1},{"lineBreak":true},{"text":"swa'ɛ gbagbaaↄ mɛ́ aa aà wɛ́pi bↄ,","poem":1},{"lineBreak":true},{"text":"yãamusuↄ i gbasa aa aà gɛ ble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yã́ mɛ̀n àaↄ̃ ku aa dɛ ma dↄ̃ala,","poem":1},{"lineBreak":true},{"text":"à kà síiↄ̃ se kɛ́ má ń midↄ̃o:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zɛ́ pↄ́ yãamusu ìↄ bɛò musu,","poem":1},{"lineBreak":true},{"text":"zɛ́ pↄ́ mlɛ̃ ìↄ táa'oò gbɛsɛɛnaa,","poem":1},{"lineBreak":true},{"text":"zɛ́ pↄ́ gó'ilɛna ìↄ bɛò ísia guo","poem":1},{"lineBreak":true},{"text":"ń zɛ́ pↄ́ gↄ̃ɛ ìↄ yeò wɛ̃́ndiazio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nↄɛ dↄ́ɛ'ĩide yãkɛan kɛ:","poem":1},{"lineBreak":true},{"text":"Ì pↄble, ì ↄma a lɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì mɛ i vãikɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yã́ mɛ̀n àaↄ̃ ì tↄ̃ tↄↄlɛwa à lualua,","poem":1},{"lineBreak":true},{"text":"à kà síiↄ̃ se a yã́piↄ fↄ̃o:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zↄ kpalablea,","poem":1},{"lineBreak":true},{"text":"sↄũ pↄble kãa,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"nↄɛ pↄ́ wa zau zãkɛa,","poem":1},{"lineBreak":true},{"text":"zↄ̀ wɛ̃́ndia gↄ̃a a dii zã́ nↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Pↄ́ nɛ́naↄ ku tↄↄlɛ mɛ̀n síiↄ̃,","poem":1},{"lineBreak":true},{"text":"kási aa ↄ̃nↄ vĩ maamaaɛ:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bↄↄnaↄ dɛ pↄ́ gbãaↄ ũo,","poem":1},{"lineBreak":true},{"text":"kási aaì blɛ kũ̀sũa di saɛɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɛ̃n'ui'uinaↄ dɛ pↄzↄ̃ↄↄ ũo,","poem":1},{"lineBreak":true},{"text":"kási aaì bɛkpa gbɛ̀sↄↄuɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kwaↄ líↄ kía vĩo,","poem":1},{"lineBreak":true},{"text":"kási aaì bↄlɛ zɛ́zɛ gã ń gãoɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fↄ̃ zↄ̃ kṹ ń ↄo,","poem":1},{"lineBreak":true},{"text":"kási ì e gɛ na kía kpɛ́ saaiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Pↄ́ mɛ̀n àaↄ̃ ku an bɛa maa,","poem":1},{"lineBreak":true},{"text":"à kà síiↄ̃ se an táa'oa kɛfɛũ:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusu pↄ́ dɛ gↄ̃sa ũ nↄ̀bↄↄ guu,","poem":1},{"lineBreak":true},{"text":"ìli pↄ̀ↄbↄzãkɛ pↄeɛo","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ń kosa pↄ́ toe bↄo ń blesan giio","poem":1},{"lineBreak":true},{"text":"ń kía pↄ́ kú a zĩgↄ̃ↄ aɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tó n sↄũyã kɛ̀ zĩasɛa lɛsĩ guu","poem":1},{"lineBreak":true},{"text":"ge tó n vãi làasookɛ̀, ↄku n lɛ́wa,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"asa lá wì vĩ disaa í fɛ̃́ à gↄ̃ wàagase ũ,","poem":1},{"lineBreak":true},{"text":"ge lá wì ní kṹ wà fĩ à aubↄ,","poem":1},{"lineBreak":true},{"text":"màa gbɛ̃́ↄ pↄfɛ̃anɛ ì sòleda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}