{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":31,"content":[{"type":"heading","content":["Kí Lemuɛli yã́"]},{"type":"verse","number":1,"content":["Kí Lemuɛli da lɛdàwà à mɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Kpelewaɛ, ma nɛ́? Bↄɛ́, ma nɛ'ia?","poem":1},{"lineBreak":true},{"text":"Àkɛaɛ, nɛ́ pↄ́ ma a lɛkɛ̀ Luawa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n wo dɛ nↄɛↄ kĩ́io,","poem":1},{"lineBreak":true},{"text":"ńsu zɛ́ pↄ́ ì kíaↄ ↄ̃̀ↄkpa sɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lemuɛli, vɛ̃ɛá kíaↄ pↄmia no,","poem":1},{"lineBreak":true},{"text":"í gbãaá kpalablenaↄ pↄmia no,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kɛ́ aasu mi ikoyãↄ sã́ńgu,","poem":1},{"lineBreak":true},{"text":"aai yã́gↄ̃gↄ̃ taasideↄnɛ faasaio yã́i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À í gbãa kpa gbɛ̃́ pↄ́ lɛ́ mↄ́ gaiↄwa,","poem":1},{"lineBreak":true},{"text":"à vɛ̃ɛ kpa pↄsiadeↄwa","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"aa mi, an taasi i sã́ńgu,","poem":1},{"lineBreak":true},{"text":"an yã'ↄ̃ma aↄ dↄńgu lↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã'o gbɛ̃́ pↄ́ a lɛ́ lɛ́ bebeka gɛ̃ɛ ũ,","poem":1},{"lineBreak":true},{"text":"yã́gↄ̃gↄ̃ gbɛ̃́ pↄ́ aalɛ sãalɛↄnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu ǹyↄ̃ nílɛo, yã́kpalɛkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"taasideↄ ń wɛ̃nadeↄ yãnakpámá.","poem":1}]},{"type":"heading","content":["Nↄ ãiade"]},{"type":"verse","number":10,"content":[{"text":"Démɛ a nↄ ãiade ei?","poem":1},{"lineBreak":true},{"text":"Aà bɛɛɛ dɛ òsoↄla zã̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà zã́ ìↄ aà náai vĩ ń nↄ̀sɛmɛndooɛ,","poem":1},{"lineBreak":true},{"text":"pↄmaae lí kɛ̃́sãwào.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maa ìↄ kɛ a zã́ɛ, i kɛ vãi no","poem":1},{"lineBreak":true},{"text":"e a wɛ̃ni lɛ́u.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì sãkã ń buao wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"ì a ↄzĩ kɛ ń pↄnao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì gɛ́ blɛ sɛ́i zã̀","poem":1},{"lineBreak":true},{"text":"lán gó'ilɛna laatanawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì fɛlɛ gufɛ̃nɛ à blɛkɛ a uadeↄnɛ,","poem":1},{"lineBreak":true},{"text":"ì zĩ kpaalɛ a wɛ̃́ndiaↄnɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ì tↄↄlɛ maa wɛɛlɛ lú,","poem":1},{"lineBreak":true},{"text":"ì vɛ̃ɛliↄ pɛ́pɛu ń azĩa bↄ̀ↄ ↄ̃ao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ì gbãa dↄ a pi asana ũ,","poem":1},{"lineBreak":true},{"text":"ì gã̀sĩwa bↄbↄ a zĩwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ìↄ dↄ̃ kɛ́ á ɛlɛ e,","poem":1},{"lineBreak":true},{"text":"aà filia ìↄ dↄ gwã́.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aà ↄ ìↄ pooa àↄ bunkapa kũa,","poem":1},{"lineBreak":true},{"text":"ìↄ kɛ̀ɛ ↄ̃wã ń a ↄnɛo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ì ↄ poo wɛ̃nadeↄnɛ,","poem":1},{"lineBreak":true},{"text":"ì ↄlia taasideↄzi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ìli ĩ́ampuu vĩakɛ a bɛdeↄ yã́ musuo,","poem":1},{"lineBreak":true},{"text":"asa aà uadeↄ ì ula didikↄ̃aɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ì zwã̀a wúlɛbↄↄ tã azĩa,","poem":1},{"lineBreak":true},{"text":"aà pↄkasaↄá bàabaa ń zwã̀a gàaluladeↄnɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aà zã́ ì tↄbↄ faaibokĩi,","poem":1},{"lineBreak":true},{"text":"ìↄ zↄ̃lɛ gudoũ ń bùsu gbɛ̃zↄ̃ↄↄ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nↄɛpi ì pↄlↄgãu kɛ àↄ yía,","poem":1},{"lineBreak":true},{"text":"ì pↄlↄna tã à kpa laatanaↄwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ìↄ gbãa ń gawio daa a pↄkasa ũ,","poem":1},{"lineBreak":true},{"text":"aà kua zia yã́ lí iwãa ka aà pↄao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄyã ìↄ dↄ aà lɛ́u,","poem":1},{"lineBreak":true},{"text":"ì yãdanɛ́ ń nↄ̀sɛmaao.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ì wɛ́tɛ a ua yãkɛai,","poem":1},{"lineBreak":true},{"text":"ìli zígbiakɛ à gbasa àↄ pↄbleo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ ì fɛlɛ aa samaa'oɛ̀,","poem":1},{"lineBreak":true},{"text":"aà zã́ ì aà sáaukpa ì mɛ:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nↄɛ daside ãiavĩ fá,","poem":1},{"lineBreak":true},{"text":"ãma ḿmɛ ń dɛńla píi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kákaa maa líↄ náai vĩo,","poem":1},{"lineBreak":true},{"text":"kɛfɛnkɛ ì gɛ̃zɛaɛ,","poem":1},{"lineBreak":true},{"text":"nↄɛ pↄ́ Dii vĩa vĩ ↄ̃ wì aà sáaukpa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"À aà sáaukpa zĩ pↄ́ a kɛ̀ yã́ musu,","poem":1},{"lineBreak":true},{"text":"í aà táasilɛ aà yãkɛa musu gãaɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}