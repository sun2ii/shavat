{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["Gbɛ̃zↄ̃ↄ lɛdama"]},{"type":"verse","number":1,"content":[{"text":"Ma nɛ́ↄ, à gbɛ̃zↄ̃ↄ lɛdama ma,","poem":1},{"lineBreak":true},{"text":"à á laai kpálɛ kɛ́ à e àↄ dↄ̃a vĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dↄ̃a súsu málɛ daɛ́,","poem":1},{"lineBreak":true},{"text":"ásu pãkpa ma yãdanɛio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ́ má kú nɛ́ ũ ma mae ↄzĩ,","poem":1},{"lineBreak":true},{"text":"má busɛ ma da nɛ́ mɛ̀ndona ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma mae yãdàmɛɛ à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ǹyↄ̃ ma yã́ kũa n sↄ̃u,","poem":1},{"lineBreak":true},{"text":"ma yãdilɛnɛↄ da, n kua iↄ na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄkũ, ǹyↄ̃ dↄ̃a vĩ,","poem":1},{"lineBreak":true},{"text":"asu sãngu ǹ pãalɛ ma yã́ɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ńsu pãkpa ↄ̃nↄio, a n dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ yeaàzi, a ↄkunla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄkũ, ↄ̃mɛ yã́pii mi ũ,","poem":1},{"lineBreak":true},{"text":"dↄ̃a wɛɛlɛ ń àizɛɛ pↄ́ ń vĩ píio.","poem":1},{"noteId":8}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ aà kṹ gbã́ugbãu, a n kã́fĩ,","poem":1},{"lineBreak":true},{"text":"didiwà ↄplapla, a n kpɛla.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aↄ dɛ fùa maa ũ n miwa,","poem":1},{"lineBreak":true},{"text":"àↄ dɛnɛ kíafua gawide ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma nɛ́, swã́kpa ma yã́i,","poem":1},{"lineBreak":true},{"text":"yã́pi da, n wɛ̃ni aↄ gbã̀a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma ↄ̃nↄ zɛ́ ↄ̀lↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma n da yãmaa zɛ́wa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ńlɛ táa'ou, pↄe a kpanɛo,","poem":1},{"lineBreak":true},{"text":"tó ńlɛ bàalɛu, ńyↄ̃ gɛ̃nalɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ ma lɛdama kũa, ńsu gbaɛo,","poem":1},{"lineBreak":true},{"text":"didiwà gbãa, asa ↄ̃mɛ n wɛ̃ni ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ńsu vãikɛnaↄ zɛ́ sɛo,","poem":1},{"lineBreak":true},{"text":"ńsu tɛ gbɛ̃vãiↄ zɛ́io.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛ̃nɛ́, ńsu namáo,","poem":1},{"lineBreak":true},{"text":"kɛ̃́má, ǹ n gɛa kɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó aai vãi e kɛ̀o, aali i'oo,","poem":1},{"lineBreak":true},{"text":"tó aai gbɛ̃́ e kàaũo, i lí gɛ̃ ń wɛ́uo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Asa vãikɛa mɛ́ ń pↄblea ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ wɛtãa mɛ́ ń imia ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ zɛ́ dɛ lán gudↄlɛiawa,","poem":1},{"lineBreak":true},{"text":"a gupua ìↄ dɛdɛ lán ĩatɛ̃ dɛdɛawa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ zɛ́ dɛ lán gusia níiniiwa,","poem":1},{"noteId":9},{"lineBreak":true},{"text":"aali pↄ́ pↄ́ tò wàlɛ gɛ̃nalɛ dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma nɛ́, laaidↄ yã́piↄwa,","poem":1},{"lineBreak":true},{"text":"swã́sɛ ma yã'onɛi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ńsu kpá swã́ao,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ kũa n sↄ̃u.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa a dɛ wɛ̃ni ũ gbɛ̃́ pↄ́ le kũ̀ↄnɛ,","poem":1},{"lineBreak":true},{"text":"a dɛ mɛ̀ bṹu aafia ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Azaiasa laaidↄ n sↄ̃ yã́wa,","poem":1},{"lineBreak":true},{"text":"asa wɛ̃ni zĩ́na bↄ̀ sↄ̃ kĩ́iɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bↄ yãbɛ̃ɛ'oau,","poem":1},{"lineBreak":true},{"text":"mikɛ̃ yãkpaanla'oawa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wɛdↄ n aɛ,","poem":1},{"lineBreak":true},{"text":"gugwa n kuu súsu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Zɛ́ sɛ́ súsu,","poem":1},{"lineBreak":true},{"text":"n yãkɛaↄ píi a bↄ maa.","poem":1},{"noteId":10}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ńsu yɛɛlɛ ↄplaai ge zɛɛio,","poem":1},{"lineBreak":true},{"text":"ńsu gbápɛlɛ vãi zɛ́uo.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"4.7 Mat 13.44-46","reference":{"chapter":4,"verse":7}},{"noteId":9,"caller":"+","text":"4.19 1Zãa 2.11","reference":{"chapter":4,"verse":19}},{"noteId":10,"caller":"+","text":"4.26 Ɛbɛ 12.13","reference":{"chapter":4,"verse":26}}]},"thisChapterLink":"/api/bqc_sim/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}