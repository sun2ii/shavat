{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["Laaikaa káaluai"]},{"type":"verse","number":1,"content":[{"text":"Ma nɛ́, laaidↄ ma ↄ̃nↄwa,","poem":1},{"lineBreak":true},{"text":"swã́kpa ǹ ma wɛzɛ̃ yãma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kɛ́ ǹ e ǹyↄ̃ ku n dↄ̀ↄwa,","poem":1},{"lineBreak":true},{"text":"dↄ̃a iↄ ku n lɛ́u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Káalua lɛgbɛ'i ìↄ na lán zↄ́wa,","poem":1},{"lineBreak":true},{"text":"ì ń gálɛ ń lɛ́ nao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ãma gbɛzã ì kɛnɛ́ ĩ́i lán gↄ̃iwa,","poem":1},{"lineBreak":true},{"text":"ì ń zↄ̃ lán fɛ̃nda lɛna kpɛplawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aà zɛ́ ì mipɛńnↄ gawa,","poem":1},{"lineBreak":true},{"text":"ì si ń gbɛ̃́ pↄ́ tɛaziↄ bɛdau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ìli làasookɛ wɛ̃ni zɛ́wao,","poem":1},{"lineBreak":true},{"text":"a dↄ̃ a zã zɛ́piwao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma nɛ́, swã́sɛ ma yã́i sa,","poem":1},{"lineBreak":true},{"text":"ńsu gi ma lɛdamaio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pãalɛ nↄɛ bee taaɛ zã̀,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ aà bɛ gãaɛ baa vĩo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n gbãakpa gbɛ̃pãlewao,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ n wɛ̃ni kpa gbɛ̃́ pãsĩwao,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"kɛ́ n àizɛɛↄ su gↄ̃ dãↄnɛo,","poem":1},{"lineBreak":true},{"text":"mɛ́ n zĩ ài su gↄ̃ ua pãledeↄnɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ aaukɛ n gↄↄ vlã́wa,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ibaba, n yɛ̃̀ɛɛ a láa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ní mɛ: Ma gi lɛdamai fá!","poem":1},{"lineBreak":true},{"text":"Ma sakaa totoau mɛ́ tò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mi lɛdamadeↄ yã'onɛ mao,","poem":1},{"lineBreak":true},{"text":"mi swã́sɛ ma yãdanɛdeↄzio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma gↄ̃a wɛ̃na pↄ́ ũ míↄmiↄ","poem":1},{"lineBreak":true},{"text":"kɛ́ dṹnia ma e zã̀o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ǹ nzĩa ola imi,","poem":1},{"lineBreak":true},{"text":"zɛ ń nzĩa lↄ̀ↄ'io.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N nibↄna ibↄlɛa bàasi maae?","poem":1},{"lineBreak":true},{"text":"N í gufↄ̃ bↄa gãaɛ zɛvĩo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"To àↄ dɛ n na pↄ́ ũ ado,","poem":1},{"lineBreak":true},{"text":"asu àↄ dɛ gbɛ̃e pↄ́ ũo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"To Lua báaada n biapiu,","poem":1},{"lineBreak":true},{"text":"pↄnakɛ ń n ɛ̀waasogↄↄ nↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N tue báasɛ̃de! N zↄ̃́tɛ̃n kɛfɛna!","poem":1},{"lineBreak":true},{"text":"To bↄ̃̀nↄbleaaànↄ lí kangu gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ní aà báasɛ̃ nidɛ lá gu lɛ́ dↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma nɛ́, bↄ́yãi ńyↄ̃ nↄ pãle nidɛi?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ńyↄ̃ bↄ̃̀nↄble ń nↄ pↄsɛoi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩnaↄ yãkɛae ulɛa Diiɛo,","poem":1},{"lineBreak":true},{"text":"ìↄ zɛ́ pↄ́ aa sɛ̀ dↄ̃ píi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Vãikɛna tàae ì aà kṹ,","poem":1},{"lineBreak":true},{"text":"aà duuna ì ba zuɛ̀.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aà lɛdamamasai a aà kpa gai,","poem":1},{"lineBreak":true},{"text":"aà sↄũkɛ zↄ̃ↄ a aà sã́sã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}