{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["Fĩa ń màao ń gbɛ̃nazĩn pão yã́"]},{"type":"verse","number":1,"content":[{"text":"Ma nɛ́, tó n n gbɛ̃do fĩa dì n miwa,","poem":1},{"lineBreak":true},{"text":"tó n kpɛ́gaausì gbɛ̃́ɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"tó n lɛ́ n kalikɛ̃̀,","poem":1},{"lineBreak":true},{"text":"tó n yã'oa n dayãu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"lá ńyↄ̃ kɛn la ma nɛ́: Lɛbↄ yã́piu,","poem":1},{"lineBreak":true},{"text":"asa n na n gbɛ̃do ↄzĩɛ.","poem":1},{"lineBreak":true},{"text":"Gɛ ǹyↄ̃ zɛzɛ n gbɛ̃dopizi,","poem":1},{"lineBreak":true},{"text":"awakpaɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ńsu to i gɛ̃ n wɛ́uo,","poem":1},{"lineBreak":true},{"text":"ńsu to n wɛ́baa gbiakũo,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ǹ nzĩa siwà","poem":1},{"lineBreak":true},{"text":"lá tue ì ń kɛ̃́wa,","poem":1},{"lineBreak":true},{"text":"lá bã ì bↄ fíikpana ↄuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zígbiade, gɛ́ bↄↄna gwai,","poem":1},{"lineBreak":true},{"text":"ní aà yãkɛa tàasika, ńyↄ̃ ↄ̃nↄkũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A dↄaana vĩo,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃zↄ̃ↄ ge dii vĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ì blɛ kũ̀sũa di saɛ,","poem":1},{"lineBreak":true},{"text":"ì a pↄblea kãaa pↄkɛkɛgↄↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Màade, ńyↄ̃ↄ wúlɛa e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Bↄɛ ńyↄ̃ vu ń ioi?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ni kã́mabo yↄↄ, ni i'o yↄↄ,","poem":1},{"lineBreak":true},{"text":"ni wúlɛ yↄↄ ↄkpaa n kùɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pↄ́ taasi a gɛ̃nzi lán kpã́iwɛliwɛwa,","poem":1},{"lineBreak":true},{"text":"nↄana a mↄma lán gbɛ̃́ pↄ́ gↄ̃kɛbↄ kũawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃nazĩn pãá gbɛ̃vãiɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ bɛbɛ ń ɛɛo dↄ a lɛ́u.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì yã'o ń wɛ́o ń ↄo,","poem":1},{"lineBreak":true},{"text":"ì seelakɛnɛ́ ń gbáo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mↄafili mɛ́ aà nↄ̀sɛ pà,","poem":1},{"lineBreak":true},{"text":"vãi wàai ↄ̃ ìↄ pa gↄↄpii.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bee yã́i músi a mↄwà lɛzasai,","poem":1},{"lineBreak":true},{"text":"kaaũ a gɛ̃aàzi kã́ndo, aↄ fɛlɛa vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yã́ mɛ̀n soolo ku kɛ́ Dii zau,","poem":1},{"lineBreak":true},{"text":"à kà se sopla kɛ́ a ye a gĩyãio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Káakua, ɛɛtoa, yãesaidedɛa,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"yãpãsĩ wàaipaa, wãa ń vãio,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"seelade ɛɛtoa ń daɛↄ pɛãaao.","poem":1}]},{"type":"heading","content":["Laaikaa gbãsĩkɛai"]},{"type":"verse","number":20,"content":[{"text":"Ma nɛ́, ǹyↄ̃ n mae yãdilɛaↄ kũa,","poem":1},{"lineBreak":true},{"text":"ńsu pãkpa n da yãdanɛio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ kũa n sↄ̃u gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ǹyↄ̃ daa yàbaa ũ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A dↄaanɛ n táa'oa guu,","poem":1},{"lineBreak":true},{"text":"a n dↄ̃́a n wúlɛa guu.","poem":1},{"lineBreak":true},{"text":"Tó n vu, ali lɛdama.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asa yãdilɛapiↄá filiaɛ,","poem":1},{"lineBreak":true},{"text":"yãdanɛpiá gupuaɛ,","poem":1},{"lineBreak":true},{"text":"lɛdama ń leleaoá zɛ́ wɛ̃nideɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A n si nↄɛ vãiwa,","poem":1},{"lineBreak":true},{"text":"a n bↄ nↄɛ pãle yã́ nana oanɛu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ńsu ǹ aà kɛfɛnkɛ nidɛo,","poem":1},{"lineBreak":true},{"text":"ńsu to aà gↄ̃gwawɛ n kũo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Káalua ì ń gↄ̃ gii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃pãle nↄ yã́ sↄ̃ ì ń bɛɛɛ midɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ tɛsɛ dà a pↄlɛu,","poem":1},{"lineBreak":true},{"text":"aà pↄkasa a gí tɛ́kũie?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ kɛ̀sɛpɛ̀lɛ tɛyↄ̃wa,","poem":1},{"lineBreak":true},{"text":"a na aà gbáwao lé?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Màaɛ ń gbɛ̃́ pↄ́ gɛ̃̀ a gbɛ̃́dee nↄ yã́uo,","poem":1},{"lineBreak":true},{"text":"asa tó à ↄnàwà, a bↄ pão.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tó nↄa lɛ́ gbɛ̃dɛ, tó à kpã́i'ò,","poem":1},{"lineBreak":true},{"text":"wì a yã́ dilɛ pãe?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tó wà aà kũ̀, a fĩabo lɛɛ sopla,","poem":1},{"lineBreak":true},{"text":"i pↄ́ pↄ́ a vĩ a ua kpa píi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ì wúlɛ ń pãle nↄo làasoo vĩo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì bee kɛ lɛ́ azĩa ↄ̃̀ↄkpaɛ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Gbɛ̃a gbãa ń kpɛbↄao mɛ́ aà baa ũ,","poem":1},{"lineBreak":true},{"text":"aà tↄ́ ĩ́i a kɛ̃wào.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Asa íbɛlɛ a aà zã́ nↄ̀sɛ fɛlɛ,","poem":1},{"lineBreak":true},{"text":"i tↄsiwà aà wɛ̃nagwasai.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"A awakpabↄe sio,","poem":1},{"lineBreak":true},{"text":"baa tó à gba zↄ̃ↄ dàɛ̀, a weio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}