ext":"Má zɛa ma kpɛ́ fɛnɛntiu,","poem":1},{"lineBreak":true},{"text":"málɛ bàasi gwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma gↄ̃gbãanaeↄ è, ↄ̃nↄ i panɛ́o,","poem":1},{"lineBreak":true},{"text":"ɛ̀waasoe kú ń guu, a làasoo vĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àlɛ liaaliaa gãaɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ waaloũkɛkɛ nↄɛezi,","poem":1},{"lineBreak":true},{"text":"àlɛ aà bɛ gãaɛ baa vĩvĩ","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"za oosiɛlɛ gukãaaa e gwã́,","poem":1},{"lineBreak":true},{"text":"e gu gɛ̀ siakũ̀ maamaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔ̃ nↄɛpi bↄ̀ mↄ̀ dàaàlɛ ń kↄ̃nio,","poem":1},{"lineBreak":true},{"text":"à ↄmà azĩawa lán káaluawa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A lɛ́ vĩ mɛ́ zĩapↄeãkɛnaɛ,","poem":1},{"lineBreak":true},{"text":"aà pↄ̀ↄ lí pɛ́ bɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩeↄ ìↄ ku zɛau, zĩeↄ gãaɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ zɛ́kpaa yeyewa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃ à ɛ̀waasopi kũ̀ à lɛpɛ̀wà,","poem":1},{"lineBreak":true},{"text":"à aà gwà ń wɛgaalimao à mɛ̀:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sáaukpasa'oa kua yãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma lɛ́ pↄ́ má kɛ̀pi fĩabò gbã.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N kↄ̃'ea yã́i ma bↄi,","poem":1},{"lineBreak":true},{"text":"málɛ n wɛɛlɛ, ma n e kɛ sↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma kũ̀ntu kpà ma liia","poem":1},{"lineBreak":true},{"text":"ń Egipi bùsu zwã̀a wɛ́ kɛfɛnao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma tulale fã̀ɛ ma wúlɛkĩia,","poem":1},{"lineBreak":true},{"text":"wa kɛ̀ ń lí'ↄ gĩnanaↄ ń litɛɛↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mↄ wà bↄ̃̀nↄble e gu gɛ dↄò,","poem":1},{"lineBreak":true},{"text":"wà wá pↄeã kɛ à mↄ́wá.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Asa ma zã́ kú bɛo,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ à gɛ̀u zã̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ↄbaaa yè gɛ̀ò,","poem":1},{"lineBreak":true},{"text":"e aàↄ gɛ́ sui mↄ a ↄsikɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À aà sↄ̃ blè ń yã́ dasi kálɛaɛo,","poem":1},{"lineBreak":true},{"text":"à gãnàwà ń yã́ nana oaɛ̀o.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɔ̃ à bↄ̀ tɛaàzi gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"lán zu pↄ́ wàlɛ gɛ́ a kòlokpaiwa,","poem":1},{"lineBreak":true},{"text":"lán tue pↄ́ lɛ́ gbápɛlɛ bauwa,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"lán bã pↄ́ wã̀ sì fíiuwa.","poem":1},{"lineBreak":true},{"text":"I dↄ̃ kɛ́ a azĩa kpà gaiɛo,","poem":1},{"lineBreak":true},{"text":"e ka gɛ̀ aà sↄ̃ kũ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tiasa ma nɛ́ↄ, à ma yãma,","poem":1},{"lineBreak":true},{"text":"à laaidↄ yã́ pↄ́ lɛ́ bↄ ma lɛ́uwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ńsu to n làasoo ta aà kĩ́io,","poem":1},{"lineBreak":true},{"text":"ńsu pãzɛa ǹ gɛ̃ aà yã́uo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ à ń nɛ́ à ń ↄ̃̀ↄkpàↄ dasi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ à ń kaaũpiↄ lɛ́ vĩo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aà bɛá bɛda zɛ́kpaaɛ,","poem":1},{"lineBreak":true},{"text":"ì sińnↄ ga kpɛ kpɛauɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}