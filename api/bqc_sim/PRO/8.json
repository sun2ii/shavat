{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["Ɔ̃nↄ gbɛ̃́sisia"]},{"type":"verse","number":1,"content":[{"text":"Ɔ̃nↄ lɛ́ lɛzuwázi fá!","poem":1},{"lineBreak":true},{"text":"Wɛzɛ̃ lɛ́ wá sisiaↄ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A ku sĩ̀sĩ musu zɛ́ gɛɛwa,","poem":1},{"lineBreak":true},{"text":"a zɛa zɛnankpaau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ku wɛ̃́lɛ bĩ́ibↄlɛↄ saɛ,","poem":1},{"lineBreak":true},{"text":"aà lↄↄ dↄ bↄlɛ gbaↄ kĩ́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ, ámɛ málɛ á sisi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩnaↄ, málɛ lɛzuázi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niazĩdeↄ, à wɛɛlɛ àↄ laai vĩ,","poem":1},{"lineBreak":true},{"text":"làasoosaideↄ, à to àↄ nↄ̀sɛ vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À swã́kpa, asa yã́ gbia má oɛ́,","poem":1},{"lineBreak":true},{"text":"yã́ dↄ̀ↄde a bↄ ma lɛ́u.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa ma lɛ́ ì sĩana'o,","poem":1},{"lineBreak":true},{"text":"má ye vãi gĩyãio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ dↄ ma lɛ́uↄ maa,","poem":1},{"lineBreak":true},{"text":"a kee faasai ge kpaanlao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa sĩana vĩ laaideɛ píiɛ,","poem":1},{"lineBreak":true},{"text":"aa zɛvĩ gbɛ̃́ pↄ́ ↄ̃nↄkũ̀ↄnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À ma lɛdama sɛ́ dɛ ã́nusua,","poem":1},{"lineBreak":true},{"text":"à dↄ̃a sɛ dɛ vua kɛfɛnaa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa ↄ̃nↄ bɛɛɛ dɛ òsoↄla,","poem":1},{"lineBreak":true},{"text":"pↄ́ pↄ́ a ni kúwáe i kawào.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mapi má ↄ̃nↄ, má laai vĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ má yãkɛa a zɛ́wa dↄ̃a kũa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ zaa vãigu ũ.","poem":1},{"lineBreak":true},{"text":"Má za zĩasɛa lɛsĩ ń ĩ́andãao","poem":1},{"lineBreak":true},{"text":"ń zɛa ń vãio ń yãkpaanla'oaogu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛdama ń yãkɛkɛa dↄ̃aoá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"mámɛ má wɛzɛ̃ ũ,","poem":1},{"lineBreak":true},{"text":"ma kĩ́i gbãa ì bↄu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kíaↄ ì kpalable ma sabaiɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ kpalablenaↄ ì yã́zɛde dilɛò.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbãadeↄ ì ikokɛ ma sabaiɛ","poem":1},{"lineBreak":true},{"text":"ń dṹnia kpaladeↄ píi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má ye gbɛ̃́ pↄ́ yemaziↄzi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ ma wɛɛlɛↄ mɛ́ aa ma e.","poem":1},{"noteId":11}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Àizɛɛ ń gawio ku ma ↄzĩ","poem":1},{"lineBreak":true},{"text":"ń ↄda kã́fĩadeo ń namao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɛ́ pↄ́ mi inɛ́ maa dɛ vua sĩanaa,","poem":1},{"lineBreak":true},{"text":"kã́fĩa pↄ́ mi kɛnɛ́ dɛ ã́nusu maaa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Má bɛ yã́ dↄ̀ↄde zɛ́u,","poem":1},{"lineBreak":true},{"text":"mi táa'o zɛ́ súsu guu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mi gbɛ̃́ pↄ́ yemaziↄ gba àizɛɛ,","poem":1},{"lineBreak":true},{"text":"an làasiↄ i pa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dii ma kũa za a zĩ daalɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"e àↄ gɛ́ yã́ pↄ́ a kɛ̀ za káauↄ kɛi.","poem":1},{"noteId":12}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À ma dilɛ za asĩnizĩɛ,","poem":1},{"lineBreak":true},{"text":"za a daalɛgↄↄ, dↄ̃ i dṹnia kɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À ma i zadↄ̃ ísia kuo,","poem":1},{"lineBreak":true},{"text":"nibↄnae ku gↄↄ beeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"À ma i sĩ̀sĩↄ ãa,","poem":1},{"lineBreak":true},{"text":"e àↄ gɛ́ gbɛ̀sĩsĩↄ zĩ́napɛlɛi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"e àↄ gɛ́ dṹnia kálɛi,","poem":1},{"lineBreak":true},{"text":"ge sɛ̃sao ge bùsu wɛ́n do.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kɛ́ àlɛ pↄ́ pↄ́ kú musuↄ kɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ àlɛ bàluma da ísiaa,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"kɛ́ àlɛ lou na musu,","poem":1},{"lineBreak":true},{"text":"kɛ́ àlɛ ísia í zɛ́ fↄ̃,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"kɛ́ àlɛ kↄↄ da ísiaɛ,","poem":1},{"lineBreak":true},{"text":"a í su a baa vĩo,","poem":1},{"lineBreak":true},{"text":"kɛ́ àlɛ tↄↄlɛ zĩ́napɛlɛ,","poem":1},{"lineBreak":true},{"text":"má kú weɛ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Má kú aà saɛ zĩpi ziia ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄ ìↄ nawà lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"miↄ pↄnakɛ aà aɛ gↄↄpii.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Miↄ kↄ̃̀ↄ'o aà dṹniaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩnaↄ dɛ ma pↄnakɛbↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tiasa ma nɛ́ↄ, à ma yãma.","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ ma yãkɛaↄ kũa ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"À lɛdama ma, í ↄ̃nↄkũ,","poem":1},{"lineBreak":true},{"text":"ásu niazĩkpaio.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ lɛ́ ma yãma","poem":1},{"lineBreak":true},{"text":"ìↄ ma dã ma kpɛɛlɛ ũ,","poem":1},{"lineBreak":true},{"text":"ìↄ taamalɛ gↄↄpii.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃́ pↄ́ ma e wɛ̃ni èɛ,","poem":1},{"lineBreak":true},{"text":"aↄ na ń Diio.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kùaa vãi ì azĩaɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zamaguↄ, ga ↄ̃ aa yei.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"8.17 Mat 7.7-8","reference":{"chapter":8,"verse":17}},{"noteId":12,"caller":"+","text":"8.22 Daa 1.1, Zãa 1.1-3, Zia 3.14","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/bqc_sim/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}