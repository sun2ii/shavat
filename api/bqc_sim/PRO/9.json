{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PRO","translationId":"bqc_sim","name":"Yáasiↄ","commonName":"Yáasiↄ","title":"YÁASIƆ","order":20,"numberOfChapters":31,"sha256":"d92edf809a0012337b083850bbcace746b94728b6d0082a952b57ea953cd4b0f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqc_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["Ɔ̃nↄ ń sↄũkɛo"]},{"type":"verse","number":1,"content":[{"text":"Ɔ̃nↄ a kpɛ́ dↄ̀,","poem":1},{"lineBreak":true},{"text":"à a gbapɛlɛↄ ã̀ mɛ̀n sopla a pɛ̀lɛpɛlɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À nↄ̀ↄ dɛ̀ à vɛ̃ɛ kɛ̀kɛ,","poem":1},{"lineBreak":true},{"text":"à blɛↄ sↄukɛ̀ a kàlɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a wɛ̃́ndia zĩkɛnaↄ zĩ̀,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛzu wɛ̃́lɛ sĩ̀sĩ misonaa à mɛ̀:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ nↄ̀sɛ vĩoↄ à ɛa mↄ kɛ!","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄkɛ̃sãmadeↄ málɛ oɛ́,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"à mↄ blɛblemanↄ,","poem":1},{"lineBreak":true},{"text":"í vɛ̃ɛ pↄ́ má kɛ̀kɛ mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À sↄũkɛ tó, íↄ aafia,","poem":1},{"lineBreak":true},{"text":"í táa'o wɛ́kɛ̃a zɛ́u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gbɛ̃́ pↄ́ lɛ́ lɛda gbɛ̃́laanikɛnawa","poem":1},{"lineBreak":true},{"text":"ì gↄ̃ sↄ̃́sↄ̃ɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ vãikɛna dazɛwa","poem":1},{"lineBreak":true},{"text":"ì gↄ̃ tàaeɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ńsu gbɛ̃́laanikɛna dazɛwao,","poem":1},{"lineBreak":true},{"text":"asa a ĩ́isɛnnↄɛ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄna dazɛwa, iↄ yenzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yãda ↄ̃nↄnaɛ, aà ↄ̃nↄ i dɛdɛ,","poem":1},{"lineBreak":true},{"text":"yã'o gbɛ̃maaɛ, aà dↄ̃a i kã́fĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vĩakɛa Diiɛ mɛ́ ↄ̃nↄ daalɛa ũ,","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ a kua adoa dↄ̃a mɛ́ wɛ́kɛ̃a ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa ńyↄ̃ gɛ̃gɛ̃ ma sabai,","poem":1},{"lineBreak":true},{"text":"n wɛ̃ni a gbã̀akũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ń ↄ̃nↄ, nzĩaɛɛ,","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃'awiambↄnan n ũ, n mi musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mìsaikɛ dɛ lán nↄɛ lɛdewaɛ,","poem":1},{"lineBreak":true},{"text":"a sↄũ mɛ́ a yãe dↄ̃o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì zↄ̃lɛ kìlau a kpɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"aà kpɛ́ kú wɛ̃́lɛ sĩ̀sĩ musu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ì lɛzu gbɛ̃́ pↄ́ lɛ́ gɛ̃ↄzi,","poem":1},{"lineBreak":true},{"text":"ì o gbɛ̃́ pↄ́ zɛ́ kũa súsuↄnɛ:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Làasoosaide, ɛa mↄ kɛ!","poem":1},{"lineBreak":true},{"text":"Ɔ̃nↄkɛ̃sãmade, málɛ onɛ,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"í kpã́i mia ìↄ na,","poem":1},{"lineBreak":true},{"text":"blɛblea asii guuá zↄ́ɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gↄ̃ɛpi dↄ̃ kɛ́ gↄ̃a gyaade ũ zɛ́n weo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ à ń sisiↄ sì bɛda gbã́ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}