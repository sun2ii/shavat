:true},{"text":"Beewa gbɛ̃vãiↄ bↄ maa yã́kpalɛkɛgↄↄzĩo,","poem":1},{"lineBreak":true},{"text":"duunkɛnaↄ zɛ gbɛ̃maaↄ saɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii ì zɛmikũ gbɛ̃maaↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ sↄ̃, an zɛ́ mipɛ̀ kaalɛwa.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.3 Zel 17.8","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/bqc_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}