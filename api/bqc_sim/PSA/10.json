{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":10,"content":[{"type":"heading","content":["Lua yã́gↄ̃gↄ̃a ń gbɛ̃́ↄ wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Dii, bↄ́yãi ń zɛa zã̀zãi?","poem":1},{"lineBreak":true},{"text":"Àkɛa ni ulɛnɛ́ taasikɛgↄↄzĩi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ì gbãasaide wɛ wala guu,","poem":1},{"lineBreak":true},{"text":"ì kↄ̃nikɛɛ̀, ì aà kṹ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ì a pↄnidɛaↄ ĩ́anadã,","poem":1},{"lineBreak":true},{"text":"ì bĩide sáaukpa, ì Dii tↄbɛ̃ɛsi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi wala mɛ́ tò ìli Dii aɛyao,","poem":1},{"lineBreak":true},{"text":"a Lua làasoo vĩo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ì kɛ píi ì bↄɛ̀ maaɛ,","poem":1},{"lineBreak":true},{"text":"ì azĩa kã́fĩ, ìli n ikoyã dao,","poem":1},{"lineBreak":true},{"text":"ì lɛsuikɛ a ibɛɛↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ì mɛ á kpaguao,","poem":1},{"lineBreak":true},{"text":"áↄ ku pↄnau taasikɛsai gↄↄpiiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɛɛ ìↄ dↄ aà lɛ́u","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́kaao ń yãpãsĩo,","poem":1},{"lineBreak":true},{"text":"yãdↄnwɛia ń yãvãio mɛ́ aà lɛ́ pà.","poem":1},{"noteId":10}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ì naalɛ yãesaideɛ wɛ̃́nkpɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e aà dɛ asii guu,","poem":1},{"lineBreak":true},{"text":"ì mi'ĩide kpákpa gusaɛna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì naalɛ gbɛ̃́ↄnɛ asii guu lán nↄ̀ↄmusuwa,","poem":1},{"lineBreak":true},{"text":"ì naalɛ lákpɛu à e yɛ̃̀ɛɛsaide kṹ.","poem":1},{"lineBreak":true},{"text":"Tó à aà kũ̀, ì aà gálɛ ń a bao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ a le a kũ̀ gↄ̃̀ wúlɛa yɛ̃̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"gbãa mɛ́ aà nɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãipi ì mɛ Lua a yã́ fãn vĩo,","poem":1},{"lineBreak":true},{"text":"ì ↄku a wɛ́waɛ, ìli gu'eo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dii, fɛlɛ mↄ́ ń n gbãao,","poem":1},{"lineBreak":true},{"text":"Lua, ǹyↄ̃ yɛ̃̀ɛɛsaideↄ fãnkɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lua, bↄ́yãi gbɛ̃vãi ì dↄ́ɛnnↄi?","poem":1},{"lineBreak":true},{"text":"Ì o a sↄ̃ guu ńyↄ̃ ĩadawao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ń beeo ni e sã́asã,","poem":1},{"lineBreak":true},{"text":"ni gbɛ̃́ↄ yã'ↄ̃ma ń ń pↄsiao yãda,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹ e ↄdaumá.","poem":1},{"lineBreak":true},{"text":"Yɛ̃̀ɛɛsaide ì azĩa kpama,","poem":1},{"lineBreak":true},{"text":"tonɛ pↄ́ gwana vĩo dↄnlɛden n ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi ń gbɛ̃́ pãsĩo gã̀sĩ ɛ́nɛ́,","poem":1},{"lineBreak":true},{"text":"an vãi pↄ́ aalɛ e wa dↄ̃o wí ń musu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii ìↄ kible gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aà yãdansaiↄ midɛ aà bùsuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dii ì yɛ̃̀ɛɛsaideↄ wabikɛa ma,","poem":1},{"lineBreak":true},{"text":"ì ń gba sↄ̃, ì swãdↄ ń yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ì zɛ ń tonɛ pↄ́ gwana vĩoↄ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ wàlɛ ĩadamáↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ gbɛ̃nazĩna pↄ́ dɛ bùsuti ũ su to sↄ̃ kɛ̃́ńgu lↄo yã́i.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"10.7 Lom 3.14","reference":{"chapter":10,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}