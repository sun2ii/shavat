{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":101,"content":[{"type":"heading","content":["Kía lɛgbɛ̃a a kiblea yã́ musu"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Má lɛsi gbɛ̃kɛ ń yã́zɛdeo musu,","poem":1},{"lineBreak":true},{"text":"má soũ dannↄ, Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Má laaidↄ kua tàaesaiwa,","poem":1},{"lineBreak":true},{"text":"bↄɛ ńyↄ̃ mↄai?","poem":1},{"lineBreak":true},{"text":"Máↄ ku ma ua ń nↄ̀sɛpuao,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"má pↄvãi dↄ ma wɛ́io.","poem":1},{"lineBreak":true},{"text":"Má za yãdↄↄsaikɛau, a naao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Má yãdↄↄsai fↄ̃o,","poem":1},{"lineBreak":true},{"text":"ma bàa aↄ kú ń yãvãioo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má gbɛ̃́ pↄ́ ì a gbɛ̃́dee pe suumpaɛ,","poem":1},{"lineBreak":true},{"text":"má yↄ̃̀ↄdeↄ ń ĩ́andãnaↄ fↄ̃o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma wɛ́ dↄ ma bùsu náaideↄzi aaↄ kumanↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ìↄ bɛ tàaesai mɛ́ aↄ dɛ ma zĩkɛna ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Má we gbɛ̃sãsãna àↄ ku ma bɛo,","poem":1},{"lineBreak":true},{"text":"má tó mↄafilide àↄ ku ma saɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Máↄ a bùsu gbɛ̃vãiↄ suumpa lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"máↄ vãikɛnaↄ midɛ Dii wɛ̃́lɛ guuɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}