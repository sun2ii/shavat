{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":102,"content":[{"type":"heading","content":["Yɛ̃̀ɛɛsaide wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Wɛ̃nade yɛ̃̀ɛɛsaide pↄ́ lɛ́ a yã'ↄ̃maↄ bↄlɛ Diiɛ wabikɛa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, ma wabikɛa ma,","poem":1},{"lineBreak":true},{"text":"to ma wiilɛama ká.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ńsu bↄ ma kpɛ ma taasikɛgↄↄo,","poem":1},{"lineBreak":true},{"text":"swã́kpamazi.","poem":1},{"lineBreak":true},{"text":"Tó ma lɛzùnzi, wea kpakpa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"asa ma gↄↄ lɛ́ gɛ̃ lán súɛlɛwaɛ,","poem":1},{"noteId":126},{"lineBreak":true},{"text":"ma mɛ lɛ́ pusu bↄ lán tɛyↄ̃wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma sↄ̃ lɛ́ wo,","poem":1},{"lineBreak":true},{"text":"málɛ ibaba lán sɛ̃wa,","poem":1},{"lineBreak":true},{"text":"blɛblea yã́ lí dↄmagu mà bleo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma aaukɛa mɛ́ tò","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ wákambaau ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma gↄ̃ lán gbáa gbaonawa,","poem":1},{"lineBreak":true},{"text":"lán bɛzia koowa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I lí gɛ̃ ma wɛ́uo","poem":1},{"lineBreak":true},{"text":"lán bã mɛ̀ndona pↄ́ pɛ́ kpɛ́ musuwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma ibɛɛↄ ìↄ ma sↄ̃sↄ̃ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ma láanikɛnaↄ ì gbɛ̃́ ká ń ma tↄ́o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Túfu mi ble blɛ ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́'i ì ka ma imia guu","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"n pↄkũma ń n kpɛ̃nɛo yã́i,","poem":1},{"lineBreak":true},{"text":"asa n ma sɛ n ma pãlɛɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma wɛ̃ni lɛ́ gɛ̃zɛa lán uenawa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ málɛ giigaga lán sɛ̃wa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mpi Dii, ń zↄ̃lɛa báawa gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ dɛ tↄde ũɛ e wá buiwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ fɛlɛ wɛ̃nadↄ̃ Siↄnaɛ,","poem":1},{"lineBreak":true},{"text":"asa n sùuukɛaaànↄ gↄↄ kà sa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aà gbɛↄ kɛ̀ n zↄ̀blenaↄnɛ maa,","poem":1},{"lineBreak":true},{"text":"aà daaĩa ìↄ kɛwɛ̃ɛ wɛ̃naɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bui píi a vĩakɛnɛ, Dii,","poem":1},{"lineBreak":true},{"text":"dṹnia kíaↄ gawi dↄ̃nɛ ḿpii.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Asa Dii a ɛa Siↄna kálɛ lↄ,","poem":1},{"lineBreak":true},{"text":"i bↄ mↄ́má we ń gawio.","poem":1},{"noteId":127}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A gbɛ̃́ pↄ́ gↄ̃̀ yↄ́ↄyↄↄↄ wabikɛa sí,","poem":1},{"lineBreak":true},{"text":"a ń wiilɛawa kpa swã́ao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wa yã́pi kɛ̃ ziadeↄ yã́iɛ,","poem":1},{"noteId":128},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kuopiↄ i Dii táasilɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii wɛkpàlɛ zĩ́lɛ za a kúkĩi,","poem":1},{"lineBreak":true},{"text":"kua za musu à wɛzù tↄↄlɛ,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"kɛ́ à e gbɛ̃́ↄ zↄblewii ma,","poem":1},{"lineBreak":true},{"text":"i ń bↄ ga lɛ́zĩ yã́i,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"wi Dii tↄbↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"wi aà táasilɛ Yelusalɛũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gↄↄ bee bùsu píi gbɛ̃́ↄ kãaa we,","poem":1},{"lineBreak":true},{"text":"bùsu píi gbɛ̃́ↄ mↄ misiilɛiɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kua ma sápaagↄↄ à ma busa,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃ni kulun kṹ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀: Ma Lua,","poem":1},{"lineBreak":true},{"text":"ńsu ma sɛ kpóoo,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ bee, n wɛ̃ni láaa vĩo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N tↄↄlɛ kàlɛ za asĩnizĩ,","poem":1},{"lineBreak":true},{"text":"musuá n ↄzĩkɛaɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ampii a gɛ̃, ãma ńyↄ̃ↄ kuɛ.","poem":1},{"lineBreak":true},{"text":"Aa zikũ lán pↄkasawa píiɛ,","poem":1},{"noteId":129},{"lineBreak":true},{"text":"ńyↄ̃ ń lilɛ lán ulawa aa gɛ̃lɛ.","poem":1},{"noteId":130}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mpi sↄ̃ ńyↄ̃ↄ doũ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"n gↄↄ láaa vĩo.","poem":1},{"noteId":131}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"N zↄ̀blenaↄ nɛ́ↄ zɛdↄ,","poem":1},{"lineBreak":true},{"text":"an buiↄ aaↄ ku n aɛ.","poem":1}]}],"footnotes":[{"noteId":126,"caller":"+","text":"102.4 Zaa 4.14","reference":{"chapter":102,"verse":4}},{"noteId":127,"caller":"+","text":"102.17 Isa 60.1-2","reference":{"chapter":102,"verse":17}},{"noteId":128,"caller":"+","text":"102.19 1Kln 10.11","reference":{"chapter":102,"verse":19}},{"noteId":129,"caller":"+","text":"102.27 Isa 51.6","reference":{"chapter":102,"verse":27}},{"noteId":130,"caller":"+","text":"102.27 Zia 20.11, 21.1","reference":{"chapter":102,"verse":27}},{"noteId":131,"caller":"+","text":"102.28 Ɛbɛ 1.10-12, 13.8","reference":{"chapter":102,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":29}