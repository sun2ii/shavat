{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":103,"content":[{"type":"heading","content":["Lua gbɛ̃kɛ"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Má Dii sáaukpa,","poem":1},{"lineBreak":true},{"text":"má aà tↄ́ pↄ́ kú adoa bↄ ń nↄ̀sɛmɛndoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má Dii sáaukpa,","poem":1},{"lineBreak":true},{"text":"aà maakɛae a sãmaguo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ì sùuukɛmanↄ ń ma tàaeↄ píi,","poem":1},{"lineBreak":true},{"text":"ì ma gbã́gbã ń ma gyãↄ píi.","poem":1},{"noteId":132}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ì ma bↄ ga lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"ì maakɛmɛɛ a gbɛ̃kɛ guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ì to pↄmaaↄ mↄa,","poem":1},{"lineBreak":true},{"text":"mí ɛa su ɛ̀waaso ũ lán kúuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii ì yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì to yã́ bↄ ń gbɛ̃́ pↄ́ wàlɛ gbãamↄnɛ́ↄnɛ na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A tò Mↄizi a pↄeã dↄ̃̀,","poem":1},{"lineBreak":true},{"text":"à a yãkɛaↄ ↄ̀lↄ Isailiↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii sùuu vĩ ń sósobio,","poem":1},{"lineBreak":true},{"text":"aà pↄ́ lí pa kpaao,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃kɛ vĩ maamaaɛ.","poem":1},{"noteId":133}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ìliↄ zↄadↄmá láasaio,","poem":1},{"lineBreak":true},{"text":"aà pↄ líↄ fɛ̃a gↄↄpiio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ìli yãkɛwɛ̃ɛ wá duunawao,","poem":1},{"lineBreak":true},{"text":"ìli ĩadawá wá vãikɛawao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá luabɛ lɛsĩ dɛ ń tↄↄlɛo,","poem":1},{"lineBreak":true},{"text":"màa a gbɛ̃kɛ vĩ zↄ̃ↄ ń a vĩakɛnaↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lá gukpɛ zã̀ kↄ̃ɛ ń bɛ'aɛo,","poem":1},{"lineBreak":true},{"text":"màa ì wá tàaeↄ kɛ̃́wá.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lá mae ì a nɛ́ↄ wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"màa Dii ì wɛ̃nadↄ̃ a vĩakɛnaↄnɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"asa a wá kɛbↄ dↄ̃,","poem":1},{"lineBreak":true},{"text":"wá dɛa bùsuti ũ dↄaàgu.","poem":1},{"noteId":134}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gbɛ̃nazĩna wɛ̃ni dɛ lán sɛ̃waɛ,","poem":1},{"lineBreak":true},{"text":"ìↄ gawi vĩ gↄↄpla lán lávuwaɛ.","poem":1},{"noteId":135}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ĩ́anapɛ̀wà, ì gɛ̃lɛɛ,","poem":1},{"lineBreak":true},{"text":"a kúkĩi líↄ dↄ gbɛ̃egu lↄo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii ìↄ gbɛ̃kɛ vĩ ń a vĩakɛnaↄ","poem":1},{"lineBreak":true},{"text":"za asĩnizĩ e gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ì maakɛ ń nɛ́ↄnɛ ń ń tↄũnaↄ,","poem":1},{"noteId":136}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zɛ̀ ń aà bàakuańnↄ yã́o","poem":1},{"lineBreak":true},{"text":"aa yã́ pↄ́ a dìlɛↄ kũaↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dii a kpalabaa kpàlɛ musu,","poem":1},{"lineBreak":true},{"text":"a iko vĩ gbɛ̃́piiwa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À Dii sáaukpa aà malaikaↄ,","poem":1},{"lineBreak":true},{"text":"ikode pↄ́ i aà yã'onɛ ma à zĩkɛwàↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À Dii sáaukpa, aà ìwaↄ píi,","poem":1},{"lineBreak":true},{"text":"aà zĩkɛna pↄ́ i aà pↄeã kɛↄ.","poem":1},{"noteId":137}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À Dii sáaukpa, aà pↄkɛaↄ píi","poem":1},{"lineBreak":true},{"text":"gu pↄ́ àlɛ kibleuↄ píi.","poem":1},{"lineBreak":true},{"text":"Má Dii sáaukpa.","poem":1}]}],"footnotes":[{"noteId":132,"caller":"+","text":"103.3 Bↄa 15.26","reference":{"chapter":103,"verse":3}},{"noteId":133,"caller":"+","text":"103.8 Bↄa 34.6, Yon 4.2, Yoɛ 2.13, Zaa 5.11","reference":{"chapter":103,"verse":8}},{"noteId":134,"caller":"+","text":"103.14 Daa 3.19","reference":{"chapter":103,"verse":14}},{"noteId":135,"caller":"+","text":"103.15 Isa 40.6-7, 1Piɛ 1.24, Zaa 1.10-11","reference":{"chapter":103,"verse":15}},{"noteId":136,"caller":"+","text":"103.17 Bↄa 20.6","reference":{"chapter":103,"verse":17}},{"noteId":137,"caller":"+","text":"103.21 Luk 2.13","reference":{"chapter":103,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/