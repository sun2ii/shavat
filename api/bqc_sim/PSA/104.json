{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":104,"content":[{"type":"heading","content":["Dii Pↄ́piikɛna táasilɛa"]},{"type":"verse","number":1,"content":[{"text":"Má Dii sáaukpa.","poem":1},{"lineBreak":true},{"text":"Dii ma Lua, ń zↄ̃ↄ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"ń gawi daa pↄkasa ũ, àlɛ tɛkɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"gupua fĩfĩama zwãa ũ.","poem":1},{"lineBreak":true},{"text":"N musu kpàlɛ lán pɛwa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"n bɛkpà lousisiaa.","poem":1},{"lineBreak":true},{"text":"N luabɛpuana kɛ̀ ń sↄ̃́go ũ,","poem":1},{"lineBreak":true},{"text":"niↄ bɛ ń ĩ́anao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ni ĩ́ana gbaɛ n zĩnaↄ ũ,","poem":1},{"lineBreak":true},{"text":"ni tɛ́ zĩ n zĩkɛnaↄ ũ.","poem":1},{"noteId":138}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N dṹnia kàlɛ, n a zĩ́napɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"a deea vĩ bauo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ísia lɛ̀aàla pↄkasa ũ,","poem":1},{"noteId":139},{"lineBreak":true},{"text":"í kù gbɛ̀sĩsĩↄla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N ípi lèle ↄ̃ à bàasi,","poem":1},{"noteId":140},{"lineBreak":true},{"text":"n pũnawà ↄ̃ gili gɛ̃̀u.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ lɛsĩ kũ̀, gusalalaↄ ɛɛnkũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ í tà gu pↄ́ ń dìlɛɛ̀u.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N kↄↄ dà ípiɛ, a e vĩao,","poem":1},{"lineBreak":true},{"text":"a e ɛa da tↄↄlɛa bau lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ń tò nibↄnaↄ ì í pisi swa'ↄnaↄu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a í ìↄ bàalɛ gbɛ̀sĩsĩↄ zãnguo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a pↄ́pii ìↄ a imi,","poem":1},{"lineBreak":true},{"text":"a í ì sɛ̃̀a zàa'ĩnaↄ imi bↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bãↄ ìↄ ka swapiↄ saɛ,","poem":1},{"lineBreak":true},{"text":"aaìↄ pɛa a dào guu, an wii ìↄ dↄu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Za n bɛ ni lou gbaɛ gbɛ̀sĩsĩↄwa,","poem":1},{"lineBreak":true},{"text":"n zĩ gbɛ ì dṹnia kã́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ni to sɛ̃ bↄlɛ pↄtuoↄnɛ,","poem":1},{"noteId":141},{"lineBreak":true},{"text":"ni blɛ bui kpa sɛ̃̀wanaↄwa.","poem":1},{"lineBreak":true},{"text":"Ni blɛ bↄlɛ tↄↄlɛ, aai ble.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Vɛ̃ɛ pↄ́ ì ń pↄ kɛ na","poem":1},{"lineBreak":true},{"text":"ń nísi pↄ́ ì ń lɛkpɛ yↄo","poem":1},{"lineBreak":true},{"text":"ń blɛ pↄ́ ì ń gba gbãao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii líↄ ì mↄ̀sɛ e maamaa,","poem":1},{"lineBreak":true},{"text":"sɛdɛ lí pↄ́ a bà Libãpiↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"We bãↄ ì sakpɛdadau,","poem":1},{"lineBreak":true},{"text":"wàalianaↄ ì bɛkpa pɛ̃li láu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩ lɛsĩↄ dɛ tueↄ kúkĩi ũ,","poem":1},{"lineBreak":true},{"text":"gbɛtↄↄↄ dɛ ɛ̃́n'ui'uinaↄ ulɛkĩi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"N mↄvua kɛ̀ gↄↄ tàasikabↄ ũ","poem":1},{"noteId":142},{"lineBreak":true},{"text":"ń ĩatɛ̃ pↄ́ a gɛ̃a kpɛ́u gↄↄ dↄ̃o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ni to gu si, ↄ̃ gwãasĩna ì kɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ lákpɛ pↄ́ↄ ì fɛlɛ ń táo píi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nↄ̀ↄmusuↄ ì ↄ́ↄlↄ maafɛi,","poem":1},{"lineBreak":true},{"text":"aaì pↄblea wɛɛlɛ Luawa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tó ĩatɛ̃ bìlɛ, aaì lↄ̀ↄ gá,","poem":1},{"lineBreak":true},{"text":"aaì ta wúlɛi ń tòou.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ì bↄ gɛ́ zĩkɛi,","poem":1},{"lineBreak":true},{"text":"ìↄ yãma azĩawa e oosi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dii, n yãkɛaↄ dasi fá!","poem":1},{"lineBreak":true},{"text":"Apii bↄ̀ n ↄ̃nↄ guuɛ.","poem":1},{"lineBreak":true},{"text":"Dṹnia pà ń pↄ́ pↄ́ ń kɛ̀ↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ísia ku, a zↄ̃ↄ mɛ́ a yàasa,","poem":1},{"lineBreak":true},{"text":"pↄ́ bɛ̃́ɛ pↄ́ kú a guuↄ lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"a nɛ́na a zↄ̃ↄ píi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gó'ilɛnaↄ ìↄ bɛu","poem":1},{"lineBreak":true},{"text":"ń kwãsa pↄ́ ń kɛ̀ à kↄ̃̀ↄ'ouo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pↄ́piↄ wɛ́ dↄnzi ḿpii,","poem":1},{"lineBreak":true},{"text":"kɛ́ ǹ blɛ kpámá a gↄↄwa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ni kpámá, aaì sɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"ni ↄ poonɛ́ ↄ̃ pↄmaaↄ ì ń kã́.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tó n mikpɛlìnɛ́, bíli ì ń kũɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛ̃ni sìmá,","poem":1},{"lineBreak":true},{"text":"aaì ga aa ɛa ta tɛ̃́ɛnauɛ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tó n n Nisĩna gbàɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ bɛ̃́ɛↄ ì bↄ,","poem":1},{"lineBreak":true},{"text":"ni to tↄↄlɛ ɛa dafukũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Dii gawipi aↄ ku gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"Dii pↄ i kɛ na a yãkɛaↄwa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ì dṹnia gwa ↄ̃ dṹnia ì lua,","poem":1},{"lineBreak":true},{"text":"ì ↄkã gbɛ̀sĩsĩↄwa ↄ̃ súɛlɛ ì bↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Má lɛsi Diiɛ e ma wɛ̃ni lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"má a Lua táasilɛ e ma kua lɛ́uɛ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"To ma làasoo kangu,","poem":1},{"lineBreak":true},{"text":"mí pↄnakɛnnↄ, Dii.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"To duunkɛnaↄ midɛ dṹnia guu,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ su aaↄ ku lↄo.","poem":1},{"lineBreak":true},{"text":"Má Dii sáaukpa.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":138,"caller":"+","text":"104.4 Ɛbɛ 1.7","reference":{"chapter":104,"verse":4}},{"noteId":139,"caller":"+","text":"104.6 Daa 1.1-2","reference":{"chapter":104,"verse":6}},{"noteId":140,"caller":"+","text":"104.7 Daa 1.9","reference":{"chapter":104,"verse":7}},{"noteId":141,"caller":"+","text":"104.14 Daa 1.11","reference":{"chapter":104,"verse":14}},{"noteId":142,"caller":"+","text":"104.19 Daa 1.14","reference":{"chapter":104,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}