{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":105,"content":[{"type":"heading","content":["Lua a gbɛ̃́ↄ suabaa"]},{"type":"verse","number":1,"content":[{"text":"À Dii sáaukpa, í lɛ́mawà,","poem":1},{"lineBreak":true},{"text":"à to bui píi aà yãkɛaↄ dↄ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛsi, í aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"à aà yãbↄnsaɛkɛaↄ galikɛ píi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À ĩ́anadã ń Dii tↄ́ pↄ́ kú adoao.","poem":1},{"lineBreak":true},{"text":"Á Dii kĩ́i wɛ̀ɛlɛnaↄ à pↄnakɛ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"à gɛ Dii le à gbãa gbɛawà,","poem":1},{"lineBreak":true},{"text":"íↄ aà aɛya gↄↄpii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À to yãbↄnsaɛ pↄ́ a kɛ̀ↄ dↄágu,","poem":1},{"lineBreak":true},{"text":"aà dabudabukɛaↄ ń ikoyã pↄ́ a òↄ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"á Dii zↄ̀blena Ablahaũ buiↄ,","poem":1},{"lineBreak":true},{"text":"á Yakↄbu bui pↄ́ à á sɛ́ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii mɛ́ wá Lua ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ì yãdilɛ gbɛ̃́piiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aà bàakuawanↄ yã́ lí sãaaguo,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a òpi aↄ kuɛ e wá buiwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aà bàa kú ń Ablahaũo,","poem":1},{"noteId":143},{"lineBreak":true},{"text":"à ɛ̀a à a lɛgbɛ̃̀ Izaakiɛ lↄ.","poem":1},{"noteId":144}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà bàa ɛ̀a kú ń Yakↄbuo iko ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a kú ń Isailiↄ e gↄↄpii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À mɛ̀ á Kanaa bùsu kpámá,","poem":1},{"lineBreak":true},{"text":"aↄ dɛ pↄ́ pↄ́ aa sɛ kpaalɛ guu ũ.","poem":1},{"noteId":145}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gↄↄ bee aa dasio, wìli ń yãdao,","poem":1},{"lineBreak":true},{"text":"aa ku Kanaa bùsuu bↄ̀mↄↄ ũɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aaìↄ liaaliaa bui ń buioↄ guu,","poem":1},{"lineBreak":true},{"text":"aaìↄ bɛbɛ bùsu ń bùsuo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I we wà ń wɛtã̀o,","poem":1},{"lineBreak":true},{"text":"à kíaↄ lèle an yã́ musu à mɛ̀","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"aasu ↄkã gbɛ̃́ pↄ́ a ń sɛ́piↄwao,","poem":1},{"lineBreak":true},{"text":"aasu ĩada a ãnabipiↄwao.","poem":1},{"noteId":146}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔ̃ a tò nↄana kà bùsupiu,","poem":1},{"lineBreak":true},{"text":"a tò an kũ̀sũa làa píi.","poem":1},{"noteId":147}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃ à Yosɛfu gbàɛ à dↄ̀aanɛ́,","poem":1},{"lineBreak":true},{"text":"wà aà yìa zↄ ũ.","poem":1},{"noteId":148}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wà mↄkà aà gbáwa,","poem":1},{"lineBreak":true},{"text":"wà mↄ dↄ̀ aà nↄɛ","poem":1},{"noteId":149}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"e yã́ pↄ́ à dↄ̀aa ò gɛ̀ kɛ̀ò,","poem":1},{"lineBreak":true},{"text":"ↄ̃ yã́ pↄ́ Dii dàɛ̀ tò yã́ bↄ̀aànↄ na.","poem":1},{"noteId":150}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kɛ́ kía gbɛ̃́ zĩ̀, ↄ̃ wà aà gbàɛ,","poem":1},{"lineBreak":true},{"text":"bùsu gbɛ̃zↄ̃ↄpi aà kɛ̃̀.","poem":1},{"noteId":151}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À aà dìlɛ a bùsu dↄaana ũ,","poem":1},{"lineBreak":true},{"text":"a tò aàↄ iko vĩ a àizɛɛↄwa píi.","poem":1},{"noteId":152}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yosɛfu aà kíaↄ tòto a pↄeãwa,","poem":1},{"lineBreak":true},{"text":"à ↄ̃nↄ dà aà ìwaↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɔ̃ Yakↄbu buiↄ mↄ̀ Egipi,","poem":1},{"noteId":153},{"lineBreak":true},{"text":"Isailiↄ ku nibↄↄ ũ Haũ buiↄ bùsuu.","poem":1},{"noteId":154}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dii tò a gbɛ̃́ↄ kↄ̃̀ we maamaa,","poem":1},{"lineBreak":true},{"text":"a tò aa dasikũ̀ dɛ ń ibɛɛↄla.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɔ̃ à ń ibɛɛpiↄ swãfɛ̃̀, ↄ̃ aa zà aà gbɛ̃́piↄu,","poem":1},{"lineBreak":true},{"text":"aa ↄ̃nↄsↄpɛ̀lɛ aà zↄ̀blenapiↄnɛ.","poem":1},{"noteId":155}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"À a zↄ̀blena Mↄizi zĩ̀má","poem":1},{"noteId":156},{"lineBreak":true},{"text":"ń Aalona pↄ́ a sɛ̀o.","poem":1},{"noteId":157}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aa yãkɛ̀ Egipiↄnɛ seela ũ,","poem":1},{"lineBreak":true},{"text":"aa dabudabukɛ̀ Haũ buipiↄ bùsuu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À gusia gbàɛmá, gu sì ń bùsuu,","poem":1},{"noteId":158},{"lineBreak":true},{"text":"kɛ́ aa gì aà yãmai yã́i.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À ń swa'i lìlɛ à gↄ̃̀ au ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a kpↄↄ gàga.","poem":1},{"noteId":159}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Blↄↄ lì ń bùsua","poem":1},{"lineBreak":true},{"text":"ń ń gbãadeↄ wúlɛkĩiↄ píi.","poem":1},{"noteId":160}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"À yã'ò ↄ̃ ũsĩnaↄ kàńgu,","poem":1},{"noteId":161},{"lineBreak":true},{"text":"gã́i kàńgu e an bùsu lɛ́ lɛ́u píi.","poem":1},{"noteId":162}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"À lougbɛ kàńgu lou ũ,","poem":1},{"lineBreak":true},{"text":"loupilɛa lì ń bùsua gupiiu.","poem":1},{"noteId":163}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"À ń vɛ̃ɛliↄ ɛ̀'ɛ ń ń kaadↄɛnliↄ,","poem":1},{"lineBreak":true},{"text":"à ń bùsu líↄ kɛ̀ kɛ́lɛkɛlɛ píi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"À yã'ò ↄ̃ kwaↄ kàńgu,","poem":1},{"lineBreak":true},{"text":"kwasutɛ̃ↄ kà, aa lɛ́ vĩo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Aa ń bùsu sɛ̃ ń láo nɛ̀,","poem":1},{"lineBreak":true},{"text":"aa ń buapↄ́ↄ blè píi.","poem":1},{"noteId":164}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"À ń bùsu nɛgↄ̃ɛ sɛ̃́iaↄ dɛ̀dɛ píi,","poem":1},{"lineBreak":true},{"text":"nɛ́ woode pↄ́ aa ń í ń ɛ̀waasogↄↄpiↄ.","poem":1},{"noteId":165}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"À bↄ̀lɛ ń a gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"aa ã́nusu ń vuao kũa,","poem":1},{"lineBreak":true},{"text":"an bui gbɛ̃e i gɛ̃nalɛ zɛ́uo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kɛ́ aa bↄ̀lɛ, Egipiↄ pↄ kɛ̀na,","poem":1},{"lineBreak":true},{"text":"kɛ́ vĩa ń kṹ Isailiↄ yã́ musu yã́i.","poem":1},{"noteId":166}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"À tɛlu pɛ̀lɛ kpà a gbɛ̃́ↄzi,","poem":1},{"lineBreak":true},{"text":"à kɛ̀ tɛ́ ũ gwã́, à gupùnɛ́.","poem":1},{"noteId":167}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Aa wabikɛ̀wà, ↄ̃ à mↄ̀nɛ́ ń bùuↄ,","poem":1},{"lineBreak":true},{"text":"à musu blɛ kpàmá aa kã̀.","poem":1},{"noteId":168}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"À gbɛsi pàa, ↄ̃ í bↄ̀u,","poem":1},{"noteId":169},{"lineBreak":true},{"text":"ípi bàalɛ̀ guwaiwaiu we lán swawa.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Asa lɛ́ pↄ́ a gbɛ̃̀ yã́ dↄaàguɛ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a ò a zↄ̀blena Ablahaũɛpi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"À bↄ̀ ń a gbɛ̃́ↄ, aalɛ pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ a sɛ̀piↄ guladↄ.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"À buipãleↄ bùsu kpàmá,","poem":1},{"noteId":170},{"lineBreak":true},{"text":"zĩ pↄ́ gbɛ̃́piↄ kɛ̀ↄ ài gↄ̃̀nɛ́.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Bee kɛ̀ píi kɛ́ aa e wàↄ a yãdilɛaↄ kũa,","poem":1},{"lineBreak":true},{"text":"aai a ikoyãↄ da.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":143,"caller":"+","text":"105.9 Daa 12.7, 17.8","reference":{"chapter":105,"verse":9}},{"noteId":144,"caller":"+","text":"105.9 Daa 26.3","reference":{"chapter":105,"verse":9}},{"noteId":145,"caller":