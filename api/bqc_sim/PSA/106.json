{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":106,"content":[{"type":"heading","content":["Isailiↄ ń duunaↄ oa Luaɛ"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"À Dii sáaukpa, asa a maa,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Démɛ a fↄ̃ Dii yãzↄ̃ↄkɛaↄ oi?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ à aà táasilɛ píii?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ aaìↄ yãmaa kũa","poem":1},{"lineBreak":true},{"text":"aaìↄ yãkɛ a zɛ́wa gↄↄpiiↄ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ńlɛ na kɛ n gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma yã́ aↄ dↄngu, Dii.","poem":1},{"lineBreak":true},{"text":"Tó ńlɛ ń suaba, ma wɛgwa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kɛ́ ma baa e àↄ ku n gbɛ̃́ↄ namau,","poem":1},{"lineBreak":true},{"text":"mí pↄnakɛ ń bui pↄ́ ń sɛ̀ↄ,","poem":1},{"lineBreak":true},{"text":"mí ń táasilɛ n gbɛ̃́piↄ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wa duunakɛ̀ lán wá deziↄwa,","poem":1},{"lineBreak":true},{"text":"wa tàaekɛ̀ wa yãvãikɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɛ́ wá deziↄ ku Egipi,","poem":1},{"lineBreak":true},{"text":"aai Dii dabudabukɛaↄ yãdao,","poem":1},{"lineBreak":true},{"text":"yãmaa dasi pↄ́ a kɛ̀nɛ́ↄ sã̀ńguɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa swã́gbãakɛ̀ Ísia Tɛ̃a saɛ.","poem":1},{"noteId":171}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń beeo à ń suabà a tↄ́ yã́i,","poem":1},{"lineBreak":true},{"text":"kɛ́ wà e a gbãa dↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À gbãamↄ̀ Ísia Tɛ̃aɛ ↄ̃ gugii bↄ̀,","poem":1},{"lineBreak":true},{"text":"à sìńnↄ a ɛu, aa bùawà guwaiwai ũ.","poem":1},{"noteId":172}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À ń bↄ́ ń ibɛɛↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"à ń sí ń zangudeↄ gbãawa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Í dà ń wɛ̀lɛpiↄla,","poem":1},{"lineBreak":true},{"text":"baa an gbɛ̃́ mɛ̀ndo i bↄo.","poem":1},{"noteId":173}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa yã́ pↄ́ a ò sì,","poem":1},{"lineBreak":true},{"text":"aa aà táasilɛ̀.","poem":1},{"noteId":174}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɔ̃ aà yãkɛaↄ sã̀ńgu gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"aai aà dã aà lɛdamáo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aalɛ ń pↄblea bɛɛkɛ guwaiwaiu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa Dii lɛwɛ sɛ̃gbãu we.","poem":1},{"noteId":175}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À pↄ́ pↄ́ aa gbɛ̀awa kpàmá,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à mɛ'ibabagyã zĩ̀má.","poem":1},{"noteId":176}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aa ĩ́isɛ̀ ń Mↄizio bòou","poem":1},{"lineBreak":true},{"text":"ń Aalona pↄ́ Dii aà dìlɛo.","poem":1},{"noteId":177}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tↄↄlɛ wɛ̃̀aa à Datani mↄ̀,","poem":1},{"lineBreak":true},{"text":"à kũ̀aa Abilaũ ń a gbɛ̃́ↄwa.","poem":1},{"noteId":178}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tɛ́ sù an ìwaↄwa,","poem":1},{"lineBreak":true},{"text":"tɛ́vua kùlɛ gbɛ̃vãipiↄwa.","poem":1},{"noteId":179}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aa mↄ pì Olebu lán gáaenawa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa kùlɛ ń dii pↄ́ aa kàsapiɛ.","poem":1},{"noteId":180}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aa Lua gawide lɛũkpakɛ̀","poem":1},{"lineBreak":true},{"text":"ń zù sɛ̃̀sona taao.","poem":1},{"noteId":181}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lua ń suabà ↄ̃ aà yã́ sã̀ńgu.","poem":1},{"lineBreak":true},{"text":"À yãzↄ̃ↄkɛ̀nɛ́ Egipi,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"à dabudabuↄ kɛ̀ Haũ buiↄ bùsuu,","poem":1},{"lineBreak":true},{"text":"à yã́ pↄ́ ì to vĩa ń kṹ kɛ̀ Ísia Tɛ̃ai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À mɛ̀ á a gbɛ̃́piↄ midɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aà gbɛ̃́ Mↄizi aà zùukɛ̀,","poem":1},{"lineBreak":true},{"text":"a tò aà pↄ wèe, ↄ̃ i ń midɛo.","poem":1},{"noteId":182}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Aa pãkpà ń pↄeã bùsui,","poem":1},{"lineBreak":true},{"text":"aa gì Dii yã́ síi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa yã́kũtɛ̃kà ń zwã̀akpɛↄ guu,","poem":1},{"lineBreak":true},{"text":"aai swã́sɛ Dii yã́io.","poem":1},{"noteId":183}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɔ̃ à ↄlɛ̀lɛnɛ́ à mɛ̀","poem":1},{"lineBreak":true},{"text":"á tó aa kwɛ guwaiwaiuɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"á tó an buiↄ lɛ́lɛ buiↄ guu,","poem":1},{"lineBreak":true},{"text":"í ń fãaa bùsu ń bùsuo.","poem":1},{"noteId":184}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Aa nà tã́a Peoowa,","poem":1},{"lineBreak":true},{"text":"aa pↄ́ pↄ́ wà sa'òò pↄgɛↄwa sò.","poem":1},{"noteId":185}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"An yãkɛaↄ Dii pↄ fɛ̃̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gaga gɛ̃̀ńgu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Finɛasi fɛ̀lɛ yã́pi tɛdɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gagapi zɛ̀nɛ́.","poem":1},{"noteId":186}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ɔ̃ Dii tò yã́ bↄ̀aànↄ na,","poem":1},{"lineBreak":true},{"text":"aà bàa kuaànↄ e aà buiwa.","poem":1},{"noteId":187}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Aa Dii zafɛ̃̀ Mɛliba í kĩ́i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Mↄizi yã'ì azĩaɛ an yã́i.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Asa aa aà nↄ̀sɛ ↄ̃̀ↄkpàɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à yã'ò làasoosai.","poem":1},{"noteId":188}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Aai bùsupideↄ kɛ kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"lá Dii dìlɛnɛ́wao.","poem":1},{"noteId":189}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Aa gↄ̃̀ kↄ̃gbɛ̃ↄ ũ ń buipiↄ,","poem":1},{"lineBreak":true},{"text":"aa ń ↄlɛsɛ̀.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Aa zↄblè ń diiↄnɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ yã́pi ń sↄ̃ blè.","poem":1},{"noteId":190}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Aa ń nɛgↄ̃ɛnaↄ dɛ̀dɛ sa'obↄ ũ,","poem":1},{"lineBreak":true},{"text":"aa sa'ò tã́aↄwa ń ń nɛnↄɛnaↄ.","poem":1},{"noteId":191}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Aa yãesaideↄ kòlokpakpa,","poem":1},{"lineBreak":true},{"text":"an nɛgↄ̃ɛↄ ń ń nɛnↄɛpiↄ.","poem":1},{"lineBreak":true},{"text":"Aa sa'òńnↄ Kanaa bùsu tã́aↄwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an bùsupi gbãlɛ̀.","poem":1},{"noteId":192}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"An yãkɛaↄ mɛ́ tò aa gbãlɛ̀,","poem":1},{"lineBreak":true},{"text":"an dàaↄ tò aa gↄ̃̀ Luaɛ káaluaↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Ɔ̃ Dii pↄkũmabↄ̀bↄmá,","poem":1},{"lineBreak":true},{"text":"a ye gbɛ̃́ pↄ́ a ń sɛ́piↄ gĩyãi lↄo.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"À ń kpá buiↄwa,","poem":1},{"lineBreak":true},{"text":"an zangudepiↄ ikokɛ̀má.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"An ibɛɛↄ wɛ́tɛ̃amↄ̀nɛ́,","poem":1},{"lineBreak":true},{"text":"aa ↄtↄ̃̀ↄlɛmá.","poem":1},{"noteId":193}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ìↄ ń bↄ mↄ̀ↄmↄↄ,","poem":1},{"lineBreak":true},{"text":"ãma aa zɛ̀ ń ń swã́gbãaoɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ an duuna dàńla.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Tó à ń wii mà,","poem":1},{"lineBreak":true},{"text":"ì taasi dↄ̃nɛ́ɛ.","poem":1},{"noteId":194}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Aà bàakuańnↄ yã́ i sãaàguo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à nↄ̀sɛlìlɛ a gbɛ̃kɛ zↄ̃ↄ guu.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"A tò gbɛ̃́ pↄ́ aa ń kũkũ zĩ̀zↄↄ ũↄ wɛ̃nadↄ̃̀nɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Dii wá Lua, wá suaba!","poem":1},{"lineBreak":true},{"text":"Wá bↄlɛ buiↄ guu, ní wá kãaa,","poem":1},{"lineBreak":true},{"text":"wí n tↄ́ pↄ́ kú adoa bↄ,","poem":1},{"lineBreak":true},{"text":"wí ĩ́anadã ń n táasilɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Wà Dii, Isailiↄ Lua sáaukpa","poem":1},{"lineBreak":true},{"text":"za asĩnizĩ e gↄↄpii!","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́pii mɛ, ãmi!","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":171,"caller":"+","text":"106.7 Bↄa 14.10-12","reference":{"chapter":106,"verse":7}},{"noteId":172,"caller":"+","text":"106.9 Bↄa 14.21-22","reference":{"chapter":106,"verse":9}},{"noteId":173,"caller":"+","text":"106.11 Bↄa 14.21-22","reference":{"chapter":106,"verse":11}},{"noteId":174,"caller":"+","text":"106.12 Bↄa 15.1","reference":{"chapter":106,"verse":12}},{"noteId":175,"caller":"+","text":"106.14 Nao 11.4-6","reference":{"chapter":106,"verse":14}},{"noteId":176,"caller":"+","text":"106.15 Nao 11.31-33","reference":{"chapter":106,"verse":15}},{"noteId":177,"caller":"+","text":"106.16 Nao 16.1-3","reference":{"chapter":106,"verse":16}},{"noteId":178,"caller":"+","text":"106.17 Nao 16.31-33","reference":{"chapter":106,"verse":17}},{"noteId":179,"caller":"+","text":"106.18 Nao 16.35","reference":{"chapter":106,"verse":18}},{"noteId":180,"caller":"+","text":"106.19 Bↄa 32.1-6","reference":{"chapter":106,"verse":19}},{"noteId":181,"caller":"+","text":"106.20 Lom 1.23","reference":{"chapter":106,"verse":20}},{"noteId":182,"caller":"+","text":"106.23 Bↄa 32.10-14","reference":{"chapter":106,"verse":23}},{"noteId":183,"caller":"+","text":"106.25 Nao 14.1-4","reference":{"chapter":106,"verse":25}},{"noteId":184,"caller":"+","text":"106.27 Nao 14.26-35","reference":{"chapter":106,"verse":27}},{"n