{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":107,"content":[{"type":"heading","content":["Lua sáaukpaa aà maa yã́i"]},{"type":"verse","number":1,"content":[{"text":"À Dii sáaukpa, asa a maa,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ Dii ń bóↄ o màa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ à ń bↄ́ ń ibɛɛↄ ↄzĩↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À ń bↄ́ bùsu ń bùsuo à ń kãaa","poem":1},{"lineBreak":true},{"text":"za gukpɛ oi ń bɛ'aɛ oio,","poem":1},{"lineBreak":true},{"text":"za gugbãntoo oi ń gɛↄmidↄkĩi oio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"An gbɛ̃eↄ bɛ sã́sãa guwaiwaiu ń sɛ̃gbão,","poem":1},{"noteId":195},{"lineBreak":true},{"text":"aai wɛ̃́lɛ pↄ́ aa zↄ̃lɛu zɛ́ dↄ̃o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nↄana ń imio lɛ́ ń dɛ,","poem":1},{"lineBreak":true},{"text":"an wɛ̃ni gↄ̃̀ lɛɛnnↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa wiilɛ̀ Diizi ń taasikɛau,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń bↄ́ ń wɛ́tɛ̃a guu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À ń dá zɛ́ súsuwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa kà wɛ̃́lɛ pↄ́ aa zↄ̃lɛu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa Dii sáaukpa aà gbɛ̃kɛ yã́i","poem":1},{"lineBreak":true},{"text":"ń yãbↄnsaɛ pↄ́ ì kɛnɛ́o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa ì imidɛnaↄ kòlo níninɛ́,","poem":1},{"lineBreak":true},{"text":"ì pↄmaa kpa nↄandɛnaↄwa aa kã́.","poem":1},{"noteId":196}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"An gbɛ̃eↄ ku gusiau ga lɛ́zĩ,","poem":1},{"noteId":197},{"lineBreak":true},{"text":"aalɛ taasikɛ yea ń mↄdaonao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa aa gì Lua yãmai,","poem":1},{"lineBreak":true},{"text":"aa sakà Musude lɛdamauɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A tò wà ń busa ń zĩ gbãao,","poem":1},{"lineBreak":true},{"text":"aalɛ lɛ́ gálɛ, gbɛ̃e ku à dↄńlɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa wiilɛ̀ Diizi ń taasikɛa guu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń bↄ́ ń wɛ́tɛ̃api guu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À ń bↄ́ gusiau ń gao lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"à ń mↄdaonapiↄ kɛ̃̀kɛ̃má.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa Dii sáaukpa aà gbɛ̃kɛ yã́i,","poem":1},{"lineBreak":true},{"text":"ń yãbↄnsaɛ pↄ́ ì kɛnɛ́o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Asa ì bĩ́ibↄlɛ gba pↄ́ wa pì ń mↄgotɛ̃o gbooɛ,","poem":1},{"lineBreak":true},{"text":"ì mↄsi gbãa zɛ́kakabↄↄ ɛ́'ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"An gbɛ̃eↄ lìaa ń swã́gbãa yã́i,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ suuunnↄ ń tàaeↄ yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa ye pↄblea gĩyãio,","poem":1},{"lineBreak":true},{"text":"aa kà gaa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa wiilɛ̀ Diizi ń taasikɛau,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń bↄ́ ń wɛ́tɛ̃api guu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aà lɛ́kpãsã ń gbãgbã,","poem":1},{"noteId":198},{"lineBreak":true},{"text":"à ń sí mia'ɛwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa Dii sáaukpa aà gbɛ̃kɛ yã́i,","poem":1},{"lineBreak":true},{"text":"ń yãbↄnsaɛ pↄ́ ì kɛnɛ́o.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa sáaukpa sa'owa,","poem":1},{"lineBreak":true},{"text":"aai aà yãkɛaↄ galikɛ ń gulakɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"An gbɛ̃eↄ gɛ̃̀ gó'ilɛnaↄu,","poem":1},{"lineBreak":true},{"text":"aa dàzɛu ísiaa,","poem":1},{"lineBreak":true},{"text":"aaìↄ bɛ í zↄ̃ↄpia aaↄ gɛ́ laatai.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃́piↄ Dii yãkɛaↄ è,","poem":1},{"lineBreak":true},{"text":"ń yãbↄnsaɛ pↄ́ ì kɛ í guoↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"À yã'ò ↄ̃ zàa'ĩan gbãa kàka,","poem":1},{"lineBreak":true},{"text":"ísia fɛ̀lɛ ń bútɛ̃mbaao.","poem":1},{"noteId":199}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aa gɛ̀ musu aa sù zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"kua kaipi lɛ́zĩ sↄ̃ kɛ̃̀ńgu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aa dèedee,","poem":1},{"lineBreak":true},{"text":"aa tàlaatalaabò lán wɛ̃dɛnawa,","poem":1},{"lineBreak":true},{"text":"an ílɛ'ↄ̃nↄ mìdɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aa wiilɛ̀ Diizi ń taasikɛau,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń bↄ́ ń wɛ́tɛ̃api guu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À ĩ́an gbãa zɛ̀ à gↄ̃̀ ĩ́an fɛɛɛna ũ,","poem":1},{"lineBreak":true},{"text":"à í zùukɛ̀ à kɛ̀ kílikili.","poem":1},{"noteId":200}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kɛ́ gu nìni gↄ̃̀ↄ, an pↄ kɛ̀na,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à gɛ̀ńnↄ godↄkĩi pↄ́ aalɛ yáu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aa Dii sáaukpa aà gbɛ̃kɛ yã́i,","poem":1},{"lineBreak":true},{"text":"ń yãbↄnsaɛ pↄ́ ì kɛnɛ́o.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Aa aà tↄbↄ balu guu,","poem":1},{"lineBreak":true},{"text":"aa aà táasilɛ dↄaanaↄ kãaa guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"À swaↄ zↄ̃̀ɛ à gↄ̃̀ gugii ũ,","poem":1},{"noteId":201},{"lineBreak":true},{"text":"a tò nibↄnaↄ gↄ̃̀ tↄↄlɛ inidɛnaↄ ũ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"À tↄↄlɛ báaade lìlɛ gu wiside ũ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zↄ̃lɛuↄ vãi yã́i.","poem":1},{"noteId":202}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"À guwaiwai lìlɛ dã̀na ũ,","poem":1},{"lineBreak":true},{"text":"a tò gugii gↄ̃̀ nibↄna ũ.","poem":1},{"noteId":203}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"À nↄandɛnaↄ dìlɛ we,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa wɛ̃́lɛ kàlɛ aa zↄ̃̀lɛu.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Aa buapↄ́ↄ tↄ̃̀ aa vɛ̃ɛliↄ bà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à nɛ'ìnɛ́ maamaa.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"À báaadàńgu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa dasikũ̀ à kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"i to an pↄtuoↄ làoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ɔ̃ à ń láo lↄ, aa gↄ̃̀ yↄↄnnↄ","poem":1},{"lineBreak":true},{"text":"gbãamↄanɛ́ ń músio ń pↄsiao yã́i.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Lua ì saikɛ kpalablenaↄwa,","poem":1},{"lineBreak":true},{"text":"ì to aa liaaliaa gugii pↄ́ zɛvĩo guu.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ì wɛ̃nadeↄ bↄ taasiu à ń sɛ́ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"ì to an uadeↄ dasikũ.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maaↄ è, aaì pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ sↄ̃ aaì ń lɛ́ kpaaũ.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛde laaidↄ yã́piↄwa,","poem":1},{"lineBreak":true},{"text":"i Dii gbɛ̃kɛ gwa lá a dɛ.","poem":1}]}],"footnotes":[{"noteId":195,"caller":"+","text":"107.4 Nao 14.33","reference":{"chapter":107,"verse":4}},{"noteId":196,"caller":"+","text":"107.9 Luk 1.53","reference":{"chapter":107,"verse":9}},{"noteId":197,"caller":"+","text":"107.10 Luk 1.79","reference":{"chapter":107,"verse":10}},{"noteId":198,"caller":"+","text":"107.20 Luk 7.7","reference":{"chapter":107,"verse":20}},{"noteId":199,"caller":"+","text":"107.25 Yon 1.4","reference":{"chapter":107,"verse":25}},{"noteId":200,"caller":"+","text":"107.29 Luk 8.24","reference":{"chapter":107,"verse":29}},{"noteId":201,"caller":"+","text":"107.33 Yoz 3.13","reference":{"chapter":107,"verse":33}},{"noteId":202,"caller":"+","text":"107.34 Daa 13.10, 19.24-26","reference":{"chapter":107,"verse":34}},{"noteId":203,"caller":"+","text":"107.35 Bↄa 17.6","re