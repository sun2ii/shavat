{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":108,"content":[{"type":"heading","content":["Lua mɛ́ ì to wà zĩble"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true},{"noteId":204}]},{"type":"verse","number":2,"content":[{"text":"Ma sↄ̃ dilɛa, Lua,","poem":1},{"lineBreak":true},{"text":"má lɛsi mà ń táasilɛ ń nↄ̀sɛmɛndoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma mↄↄna ń ma domao, vu!","poem":1},{"lineBreak":true},{"text":"Mí gbãakpa gudↄazi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii, má ń sáaukpa buiↄ guu,","poem":1},{"lineBreak":true},{"text":"má ń táasilɛ gbɛ̃́ↄnɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asa n gbɛ̃kɛ zↄ̃ↄ zↄ̃̀maɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n náai zↄ̃̀ luabɛpuanawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lua, tↄbↄ e à zↄ̃ma,","poem":1},{"lineBreak":true},{"text":"to n gawi li dṹniaa píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wea, wá suaba ń n gã̀sa gbãao,","poem":1},{"lineBreak":true},{"text":"kɛ́ wápiↄ n gbɛ̃́ yenzideↄ e bↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua yã'ò za a kúkĩi à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má Sikɛũ kpaalɛ ń tidↄanlaoɛ,","poem":1},{"lineBreak":true},{"text":"mí Suko guzulɛ kpámá.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Galada bùsuá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"Manase buiↄ bùsuá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ bùsuá ma mↄ̀ fùaɛ,","poem":1},{"lineBreak":true},{"text":"Yuda bùsuá ma lípanaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mↄabuↄ bùsuá ma zion zu'obↄɛ,","poem":1},{"lineBreak":true},{"text":"mi a kyale kálɛ Ɛdↄũↄ bùsuwa,","poem":1},{"lineBreak":true},{"text":"mi kúkua dↄ Filitɛ̃ↄ bùsuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Démɛ a gɛ̃manↄ wɛ̃́lɛ bĩ́ideui?","poem":1},{"lineBreak":true},{"text":"Démɛ a dↄaamɛɛ e Ɛdↄũↄ bùsuui?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua, mɛ́ i kɛ n gbɛ̃́ pↄ́ n wá vũaa","poem":1},{"lineBreak":true},{"text":"nili bↄ ń wá zĩgↄ̃ↄ lↄo bàasio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔdawá wá ibɛɛↄ yã́i,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃nazĩna gbɛ̃suabaaá pãɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wá zĩble ń Lua gbãao,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a ↄ̃zↄ̃ wá ibɛɛↄwa.","poem":1}]}],"footnotes":[{"noteId":204,"caller":"+","text":"108.1 Soũ 57.8-12, 60.7-14","reference":{"chapter":108,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}