{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":109,"content":[{"type":"heading","content":["Sa bɛ̃̀ɛ oa ibɛɛɛ"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Lua, ḿmɛ mi n táasilɛ,","poem":1},{"lineBreak":true},{"text":"ńsu ǹyↄ̃ nílɛao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃vãi bↄnkpɛdeↄ ì ma yaa,","poem":1},{"lineBreak":true},{"text":"aaì lɛkↄↄlɛkamazi ń ɛɛo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aaì liamazi ń yã́'ĩio,","poem":1},{"lineBreak":true},{"text":"aaì sòlekɛmanↄ pↄewiwinɛsai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì ma yeańzi fĩabomɛɛ ń yãdↄmao,","poem":1},{"lineBreak":true},{"text":"mapi sↄ̃ miↄ wabikɛma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaì maa fĩabomɛɛ ń vãio,","poem":1},{"lineBreak":true},{"text":"ma yeańzi sↄ̃ ń zaamaguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gbɛ̃vãi sóikɛ ń dↄaanawa,","poem":1},{"lineBreak":true},{"text":"ǹ aà na gudɛnaɛ a ↄzĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To yã́kpalɛ bↄaànↄ vãi,","poem":1},{"lineBreak":true},{"text":"to aà wabikɛa yã'iɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aà wɛ̃ni su àↄ gbã̀ao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃pãle i zↄ̃lɛ aà gbɛu.","poem":1},{"noteId":205}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ gↄ̃ desai,","poem":1},{"lineBreak":true},{"text":"aà na i gↄ̃ gyaa ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ gↄ̃ lìaanaↄ ũ aaↄ baakɛ,","poem":1},{"lineBreak":true},{"text":"aaↄ pↄ́ wɛɛlɛwɛɛlɛ pↄ́kↄlɛkĩi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà fĩade aà pↄ́ↄ naaa píi,","poem":1},{"lineBreak":true},{"text":"buipãleↄ aà zĩ ài siwà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃e su gbɛ̃kɛkɛɛ̀o,","poem":1},{"lineBreak":true},{"text":"wasu wɛ̃nadↄ̃ aà nɛ́ pↄ́ a tòↄnɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aà buiↄ midɛ,","poem":1},{"lineBreak":true},{"text":"an tↄ́ ga gbɛ̃́ pↄ́ lɛ́ fɛlɛↄ guu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aà deziↄ vãikɛa yã́ dↄngu, Dii,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ aà da duuna kɛ̃wà bauo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"An duuna aↄ dↄngu gↄↄpii, Dii,","poem":1},{"lineBreak":true},{"text":"an yã́ i sã gbɛ̃́ↄgu dṹniau,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"kɛ́ ìli làasookɛ gbɛ̃kɛwao yã́i,","poem":1},{"lineBreak":true},{"text":"ì ĩada taasideↄ ń wɛ̃nadeↄ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ an kã́ gàↄwa e aa ga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A ye savãi'oa gbɛ̃́ɛi,","poem":1},{"lineBreak":true},{"text":"to à wi aà musu.","poem":1},{"lineBreak":true},{"text":"Sa maa oa gbɛ̃́ɛ lí kaaàguo,","poem":1},{"lineBreak":true},{"text":"a kɛ báaa vĩ sↄ̃o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À lɛkɛanɛ́ ula dà,","poem":1},{"lineBreak":true},{"text":"à gɛ̃̀ aà nↄ̀sɛu lán íwa,","poem":1},{"lineBreak":true},{"text":"à tàalɛaàgu lán nísiwa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Àↄ fĩwà gↄↄpii zwãa ũɛ,","poem":1},{"lineBreak":true},{"text":"iↄ dↄ aàpi asana ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dii fĩabo ma yãdↄmadeↄnɛ màa","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ aaì vãi o ma musuↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dii Gbãapiide, ma wɛgwa n tↄ́ yã́i,","poem":1},{"lineBreak":true},{"text":"ma bↄ n maa ń n gbɛ̃kɛo yã́i.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa taaside wɛ̃naden ma ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄ yà dúuduu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Málɛ sãalɛ lán oosi uenawa,","poem":1},{"lineBreak":true},{"text":"málɛ gɛ̃zɛa lán ĩ́ana kwasɛawa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɛye tò ma gbá lɛ́ sɛ́ lↄo,","poem":1},{"lineBreak":true},{"text":"ma fɛ̃fɛ̃ e ma gↄ̃ wákambaau ũ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma gↄ̃nɛ́ pↄ́sↄ̃sↄ̃a ũ,","poem":1},{"lineBreak":true},{"text":"aaì ma gwa aa mikɛ déũdeũ.","poem":1},{"noteId":206}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Dↄmalɛ Dii ma Lua,","poem":1},{"lineBreak":true},{"text":"ma suaba n gbɛ̃kɛ yã́i,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"aai dↄ̃ kɛ́ n ↄdàa,","poem":1},{"lineBreak":true},{"text":"kɛ́ ḿmɛ ń kɛ̀mɛɛ, Dii.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tó aa ma ka, ńyↄ̃ báaadamagu,","poem":1},{"lineBreak":true},{"text":"tó aa fɛ̀lɛmanↄ, wí a ń kṹ,","poem":1},{"lineBreak":true},{"text":"mapi n zↄ̀blena mí pↄnakɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tↄ́ ĩ́i a gↄ̃ ma yãdↄmadeↄnɛ ula ũ,","poem":1},{"lineBreak":true},{"text":"aa wida ńzĩawa lán gomusuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Má Dii sáaukpa ń lↄↄ gbãao,","poem":1},{"lineBreak":true},{"text":"má aà táasilɛ balu guu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Asa ì zɛ ń wɛ̃nadeↄɛ,","poem":1},{"lineBreak":true},{"text":"ì ń sí gbɛ̃́ pↄ́ lɛ́ yãdańlaↄwa.","poem":1}]}],"footnotes":[{"noteId":205,"caller":"+","text":"109.8 Zĩn 1.20","reference":{"chapter":109,"verse":8}},{"noteId":206,"caller":"+","text":"109.25 Mat 27.39","reference":{"chapter":109,"verse":25}}]},"thisChapterLink":"/api/bqc_sim/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}