}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii ì gbɛ̃maaↄ tàasika,","poem":1},{"lineBreak":true},{"text":"ãma a za vãikɛnaↄgu","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ yãpãsĩ ì kɛnɛ́ naↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tɛyↄ̃ ń ĩatɛ̃gbↄ̃o kwɛ vãikɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"ĩ́an wãa mɛ́ aↄ dɛ ń baa ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa Dii ì yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"yãkɛa a zɛ́wa ì kɛɛ̀ na,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ wɛsiaàlɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}