"type":"verse","number":5,"content":[{"text":"Dii ku n ↄplaai,","poem":1},{"lineBreak":true},{"text":"a kíaↄ míↄnzↄ̃ a pↄfɛ̃gↄↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tↄsi buiↄwa, an gɛↄ gupa,","poem":1},{"lineBreak":true},{"text":"a dṹnia bṹu kíaↄ míↄnzↄ̃,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"i swa'i mi zɛ́ lɛ́.","poem":1},{"lineBreak":true},{"text":"Bee yã́ mɛ́ tò aà mi aↄ daa ía.","poem":1}]}],"footnotes":[{"noteId":207,"caller":"+","text":"110.1 Mat 22.44, Zĩn 2.34-35, 1Kln 15.25, Ɛfɛ 1.20-22, Ɛbɛ 1.13, 8.1, 10.12-13","reference":{"chapter":110,"verse":1}},{"noteId":208,"caller":"+","text":"110.4 Ɛbɛ 5.6, 6.20, 7.17, 21","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}