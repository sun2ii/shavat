{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":111,"content":[{"type":"heading","content":["Dii tↄbↄa"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"Má Dii sáaukpa ń nↄ̀sɛmɛndoo","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃maaↄ sãnu balu guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii yãkɛaↄ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ à kàńguↄ ì a wàaipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aà yãkɛaↄ bɛɛɛ ń gawio vĩ,","poem":1},{"lineBreak":true},{"text":"aà yãkɛa a zɛ́wa láaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii tò a yãbↄnsaɛkɛaↄ dↄ̀wágu,","poem":1},{"lineBreak":true},{"text":"a sùuu ń sósobio vĩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ì blɛ kpa a vĩakɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"aà bàakuańnↄ yã́ lí sãaaguo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À a gbãa ↄ̀lↄ a gbɛ̃́ↄnɛ yãkɛa guu,","poem":1},{"lineBreak":true},{"text":"à buipãleↄ bùsuↄ kpàmá.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ a kɛ̀ↄ náai vĩ mɛ́ a zɛvĩ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a dìlɛↄ sĩana vĩ píiɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã́piↄ zĩ́naↄ pɛ́lɛa gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ì yãkɛ a zɛ́wa náai guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À suabana zĩ̀ à a gbɛ̃́ↄ bò,","poem":1},{"lineBreak":true},{"text":"aà bàa kúńnↄ gↄↄpii.","poem":1},{"lineBreak":true},{"text":"Aà tↄ́ kua adoa mɛ́ ì to vĩa ń kṹ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vĩakɛa Diiɛ mɛ́ ↄ̃nↄ zĩ́na ũ,","poem":1},{"noteId":209},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì vĩakɛɛ̀ wɛzɛ̃ gbãa.","poem":1},{"lineBreak":true},{"text":"Aà táasilɛa aↄ láaa vĩo.","poem":1}]}],"footnotes":[{"noteId":209,"caller":"+","text":"111.10 Yaa 1.7, 9.10","reference":{"chapter":111,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}