{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":112,"content":[{"type":"heading","content":["Gbɛ̃́ pↄ́ Dii vĩa vĩ"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ Dii vĩa vĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ Diipi yãdilɛaↄ ì kaaàgu ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aà nɛ́ↄ gↄ̃ gbãadeↄ ũ ń bùsuu,","poem":1},{"lineBreak":true},{"text":"asa nↄ̀sɛpuade buiↄá báaadeↄnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pↄ́mↄama ń àizɛɛo di aà bɛɛ,","poem":1},{"lineBreak":true},{"text":"aà yãkɛa a zɛ́wa láaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baa gusiau gu ì pu gbɛ̃maaↄnɛɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuade pↄ́ sùuu ń sósobio vĩↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ gbɛ̃kɛ vĩ ì pↄ́ sɛ̃anɛ́,","poem":1},{"lineBreak":true},{"text":"ì a yã́ↄ kɛ a zɛ́wa, yã́ ì bↄɛ̀ maaɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃maa lí fu bauo,","poem":1},{"lineBreak":true},{"text":"aà yã́ aↄ dↄńguɛ gↄↄpii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bao ĩ́i lí aà vĩakũo,","poem":1},{"lineBreak":true},{"text":"aà sↄ̃ ìↄ dilɛa, ìↄ Dii náai vĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aà sↄ̃ lí vĩo, vĩa lí aà kũo,","poem":1},{"lineBreak":true},{"text":"e à gɛ tidↄò a ibɛɛↄla.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì pↄ́ fã́ɛ taasideↄnɛ,","poem":1},{"lineBreak":true},{"text":"aà yãkɛa a zɛ́wa láaa vĩo.","poem":1},{"noteId":210},{"lineBreak":true},{"text":"Aà mi ìↄ daa ía ń gawioɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãi líↄ ye aà ea yã́io,","poem":1},{"lineBreak":true},{"text":"ì lɛ́sakãaàzi, ì lↄ̀ↄ gá.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ vãikɛna wɛ́ dↄi ì midɛwàɛ.","poem":1}]}],"footnotes":[{"noteId":210,"caller":"+","text":"112.9 2Kln 9.9","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}