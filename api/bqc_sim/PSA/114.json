{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":114,"content":[{"type":"heading","content":["Gɛ̃amusu dikpɛ lɛ"]},{"type":"verse","number":1,"content":[{"text":"Kɛ́ Isailiↄ bↄ̀ Egipi,","poem":1},{"lineBreak":true},{"text":"kɛ́ Yakↄbu buiↄ bↄ̀ bui zĩ̀loↄ guu,","poem":1},{"noteId":211}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuda bùsu gↄ̃̀ Dii kúkĩi ũ,","poem":1},{"lineBreak":true},{"text":"Isaili bùsu gↄ̃̀ aà kiblekĩi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ísia Tɛ̃a è ↄ̃ à bàalɛ̀,","poem":1},{"noteId":212},{"lineBreak":true},{"text":"Yuudɛ̃ í kpɛkpà.","poem":1},{"noteId":213}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ vĩ̀vĩ lán sãↄwa,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄ ↄyaayè lán bleↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ísia, bↄ́mɛ n le n bàalɛ̀i?","poem":1},{"lineBreak":true},{"text":"Yuudɛ̃, àkɛa n kpɛkpài?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ, bↄ́yãi a vĩvĩ lán sãↄwai?","poem":1},{"lineBreak":true},{"text":"Sĩ̀sĩↄ, àkɛa a ↄyaayè lán bleↄwai?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dṹnia, lualua Dii mↄa guu,","poem":1},{"lineBreak":true},{"text":"dee Yakↄbu Luapi aɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À gbɛsi kɛ̀ ibↄkĩi ũ,","poem":1},{"noteId":214},{"lineBreak":true},{"text":"à gbɛkão lìlɛ nibↄna ũ.","poem":1}]}],"footnotes":[{"noteId":211,"caller":"+","text":"114.1 Bↄa 12.51","reference":{"chapter":114,"verse":1}},{"noteId":212,"caller":"+","text":"114.3 Bↄa 14.21","reference":{"chapter":114,"verse":3}},{"noteId":213,"caller":"+","text":"114.3 Yoz 3.16","reference":{"chapter":114,"verse":3}},{"noteId":214,"caller":"+","text":"114.8 Bↄa 17.1-6, Nao 20.10-11","reference":{"chapter":114,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}